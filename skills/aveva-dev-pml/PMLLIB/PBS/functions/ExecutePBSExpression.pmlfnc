--
--  Description:     Executes given PML expression and passes result to PMLExchange C# object
--
----------------------------------------------------------------------

import 'PBSCore'
handle any
endhandle

define function !!executePBSExpression(!command is STRING)

  using namespace 'PBSCore'

  var !objects $!command

  !exchange = object PMLEXCHANGE()
  !exchange.setarray(!objects)

endfunction
