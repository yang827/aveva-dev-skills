--
--  Description:     Executes PML function with given name and attributes string and passes result to PMLExchange C# object
--
----------------------------------------------------------------------

import 'PBSCore'
handle any
endhandle

define function !!executePBSFunction(!funcName is STRING)

  using namespace 'PBSCore'

  !objects = $!funcName

  !exchange = object PMLEXCHANGE()
  !exchange.setarray(!objects)

endfunction
