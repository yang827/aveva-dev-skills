--
--  Description:     Returns diagrams containing given schematic or engineering item
--
----------------------------------------------------------------------

define function !!getPIDs(!refno is DBREF) is ARRAY

!objects = ARRAY()
!item = !refno

if(!item.type eq 'ENGITE') then
   !item = !item.schlnk
endif

if (NOT(BADREF(!item)) ) then

   !attributes = !item.psatts
   !obj = ARRAY()

   if (NOT(!attributes.find('SCBREF').empty())) then
		!obj = !item.scbref
   elseif( NOT(!attributes.find('DIAREF').empty())) then
		!obj = !item.diaref
   endif

   do !var values !obj

    if( !var.type eq 'SCIND' ) then
        !diag = !var.owner.owner
    else
		!diag = !var
	endif
	
	!diagName = STRING(!diag)

	if(!objects.find(!diagName).empty()) then
	    !objects.append(!diagName)
	endif

   enddo

endif

return !objects

endfunction
