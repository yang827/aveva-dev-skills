--
--  Description:     Returns engineering classes with descriptions
--
----------------------------------------------------------------------

define function !!getEngineeringClasses() is ARRAY

  !classes = ARRAY()
  !texts = ARRAY()

	-- Collect all UDET based on ENGITE
	var !engineeringClasses coll all UDET where basetype eq 'ENGITE'
	
	-- Loop through the collection
	do !val values !engineeringClasses
		
		-- We do not want to see Nozzles in the list, so make an exception for them
		if (!val.dbref().name ne '/NOZZTAG') then
			-- Append names of the engineering UDET in first array
			!classes.append( ':' + !val.dbref().namn )
			-- Append description of the engineering UDETs in second array
			!texts.append( !val.dbref().desc )
		endif
	
	enddo
	
  !result = ARRAY()

  -- First, append all names into result array
  !result.append(!classes)
  -- Secondly, append all descriptions into result array
  !result.append(!texts)


  return !result

endfunction
