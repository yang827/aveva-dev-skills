--
--  Description:     Returns items of given type and belonging to given system
--
----------------------------------------------------------------------

define function !!getItemsForSystem(!type is STRING, !system is STRING) is ARRAY

!whereText = ''

if( unset(!system) or !system eq '' or !system eq 'unset' or !system eq 'nulref' ) then
   !whereText = 'unset(SCSYSF) or SCSYSF[1] eq nulref or badref(SCSYSF[1])'
else
   !whereText = 'SCSYSF[1] eq $!system'
endif	

var !items collect all $!type where $!whereText

return !items

endfunction
