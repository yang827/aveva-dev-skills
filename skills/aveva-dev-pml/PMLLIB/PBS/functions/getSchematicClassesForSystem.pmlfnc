--
--  Description:     Returns schematic classes for items belonging to given system
--
----------------------------------------------------------------------

define function !!getSchematicClassesForSystem(!refno is STRING) is ARRAY

  !classes = ARRAY()
  !texts = ARRAY()
  !resultClasses = ARRAY()
  !resultTexts = ARRAY()

  !classes.append('SCEQUI')
  !texts.append('Equipment')
  !classes.append('SCPLIN')
  !texts.append('Pipelines')
  !classes.append('SCOINS')
  !texts.append('Offline instruments')
  !classes.append('SCHVAC')
  !texts.append('Hvac lines')
  !classes.append('SCILIN')
  !texts.append('Instrumentation lines')
  !classes.append('SCCAB')
  !texts.append('Cables')
  !classes.append('SCMCAB')
  !texts.append('Multi-cables')
  !classes.append('SCACTU')
  !texts.append('Actuators')
  !classes.append('SCAREA')
  !texts.append('Area shapes')
  !classes.append('SCLOOP')
  !texts.append('Instrumentation loops')
  !classes.append('SCDIAG')
  !texts.append('Diagrams')
  !classes.append('SCTEMP')
  !texts.append('Templates')
  !classes.append('SCSTEN')
  !texts.append('Stencils')
  !classes.append('SCTUB')
  !texts.append('Tubes')
  !classes.append('SCVALV')
  !texts.append('Valves')
  !classes.append('SCINST')
  !texts.append('Instruments')

  -- Loop through the collection
  do !index indices !classes
		
    !whereText = ''

    if( unset(!refno) or !refno eq '' or !refno eq 'unset' or !refno eq 'nulref' ) then
       !whereText = 'unset(SCSYSF) or SCSYSF[1] eq nulref or badref(SCSYSF[1])'
    else
       !whereText = 'SCSYSF[1] eq $!refno'
    endif			

    var !items coll all $!classes[$!index] where $!whereText

    if( not(!items.empty()) ) then

       !resultClasses.append( !classes[!index] )
       !resultTexts.append( !texts[!index] )

    endif
	
  enddo
	
  !result = ARRAY()

  -- First, append all names into result array
  !result.append(!resultClasses)
  -- Secondly, append all descriptions into result array
  !result.append(!resultTexts)


  return !result

endfunction
