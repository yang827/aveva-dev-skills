--
--  Description:     Returns available systems and nulref of given type
--
----------------------------------------------------------------------

define function !!getSystemsWithNulref() is ARRAY

    var !objects collect all SYSGRP
    !names = ARRAY()
    !namesSorted = ARRAY()

    do !val values !objects

	!name = !val.dbRef().FLNN
	!names.append(!name)
	!namesSorted.append(!name)

    enddo

    !namesSorted.sort()
    !refNumbersSorted = ARRAY()

    do !strVal values !namesSorted

	!object = !objects[!names.findFirst(!strVal)]
	!refNumbersSorted.append(!object)

    enddo

    !refNumbersSorted.append('')
    !namesSorted.append('Unassigned items')

    !result = ARRAY()
    !result.append(!refNumbersSorted)
    !result.append(!namesSorted)

    return !result

endfunction
