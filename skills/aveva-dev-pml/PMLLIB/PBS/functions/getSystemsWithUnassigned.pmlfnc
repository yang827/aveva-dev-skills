--
--  Description:     Returns available systems and nulref with given presentation name
--
----------------------------------------------------------------------

define function !!getSystemsWithUnassigned(!unassignedName is STRING) is ARRAY

    !result = !!getSystemsWithNulref()
    !index = !result[2].size()

    !result[2][$!index] = !unassignedName

    return !result

endfunction
