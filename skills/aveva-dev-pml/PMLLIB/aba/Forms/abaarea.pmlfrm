--
--
-- Description: Define Area List(s) (idlists).
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaArea()                        -                   Constructor method
--  cancel()                         -                   Cancel the form
--  clear()                          -                   Clear relevant data arrays
--  deleteArea()                     -                   Delete an area (IDLI)
--  getIdlists()                     -                   Get all areas (IDLI)
--  init()                           -                   Method to initialize the form
--  insert()                         -                   Create a new area (IDLI)
--  netAfterSelectChange(ARRAY)      -                   Callback on grid control after select change
--  netPopup(ARRAY)                  -                   Pop-up for grid control
--  numbers(ARRAY)                   -                   Set all volume gadgets
--  replace()                        -                   Reset the attributes of the selected area (IDLI)
--  select()                         -                   Set all gadgets for the selected area (IDLI)
--  setActive()                      -                   Set gadget active status
--  setBySize(REAL,REAL,REAL,REAL)   -                   Sets the "distance" field to show difference between from-to
--  setDefaults()                    -                   Set Default setting
--  setName()                        -                   Check the validity of the entered name
--  setSize(REAL,REAL,REAL)          -
--  setSize(REAL,REAL,STRING)        -
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!abaArea

  title |ABA Area Definition|
  init |!this.init()|
  cancelcall |!this.cancel()|

  path down

  frame .action |Edit / Create Area|

    path down
    text   .name at x1 y1 |Name       | call |!this.setName()|    width 42 name
    text   .desc          |Description|                           width 42 is STRING
    option .library       |Library    | call |!this.getIdlists()| width 40

    frame .threed |3-D position| at x 1

      -- From coordinates
      paragraph .from text 'From'
      option .o1 call |!this.setSize(!this.t1.val,!this.t4.val,7)| width 5
      option .o2 call |!this.setSize(!this.t2.val,!this.t5.val,8)| width 5
      option .o3 call |!this.setSize(!this.t3.val,!this.t6.val,9)| width 5
      text .t1 at xmax.o1+.2 ymin.o1 call |!this.setSize(!this.t1.val,!this.t4.val,7)| width 10 is REAL format !!abaAreaFormat
      text .t2 at            ymin.o2 call |!this.setSize(!this.t2.val,!this.t5.val,8)| width 10 is REAL format !!abaAreaFormat
      text .t3 at            ymin.o3 call |!this.setSize(!this.t3.val,!this.t6.val,9)| width 10 is REAL format !!abaAreaFormat

      -- To coordinates
      paragraph .to at xmax.t1+2 ymin.from text 'To  '
      option .o4 at xmax.t1+2 ymin.t1 call |!this.setSize(!this.t1.val,!this.t4.val,7)| width 5
      option .o5 call |!this.setSize(!this.t2.val,!this.t5.val,8)| width 5
      option .o6 call |!this.setSize(!this.t3.val,!this.t6.val,9)| width 5
      text .t4 at xmax.o4+.2 ymin.o4 call |!this.setSize(!this.t1.val,!this.t4.val,7)| width 10 is REAL format !!abaAreaFormat
      text .t5 at            ymin.o5 call |!this.setSize(!this.t2.val,!this.t5.val,8)| width 10 is REAL format !!abaAreaFormat
      text .t6 at            ymin.o6 call |!this.setSize(!this.t3.val,!this.t6.val,9)| width 10 is REAL format !!abaAreaFormat

      -- Axis size
      paragraph .dist at xmax.t6+2 ymin.from text 'Distance'
      text .t7 at xmax.t6+2 ymin.t4 call |!this.setBySize(!this.t1.val,!this.t4.val,7,!this.t7.val)| width 10 is real format !!abaAreaFormat
      text .t8 at           ymin.t5 call |!this.setBySize(!this.t2.val,!this.t5.val,8,!this.t8.val)| width 10 is real format !!abaAreaFormat
      text .t9 at           ymin.t6 call |!this.setBySize(!this.t3.val,!this.t6.val,9,!this.t9.val)| width 10 is real format !!abaAreaFormat

      button .setby | Set by Model Items ...| at x16 ymax+0.5 call |show !!abaAreaByVol centre xr .5 yr .5|

     exit

   exit

  hdist 4
  button .inserta  |   Add   |  at x9 ymax.threed+0.9 call |!this.insert()|

  path right
  button .replace  | Replace |  call |!this.replace()|
  button .delete   | Remove |   call |!this.deleteArea()|

  hdist 1
  path down

  frame .outer 'Areas' at x0

    container .netFrame nobox pmlNetControl 'NET' width 56 height 8

  exit

  -- Members
  member .mode     is STRING
  member .fromHere is DBREF
  member .headings is ARRAY
  member .areas    is ARRAY
  member .rowSet   is ARRAY

  -- My .net control
  using namespace 'Aveva.Pdms.Presentation'
  member .displayCtrl  is NETGRIDCONTROL

exit

------------------------------------------------------------------------
--
-- Method:      .abaArea()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .abaArea()

  -- Initialise variables
  !!abaAreaFormat    = !!distanceFmt
  !!abaAreaFormat.dp = 0

  -- Define pop-up menu
  !menu = !this.newMenu('defPopUp')
    !menu.add('callback', 'Remove', '!this.deleteArea()')

  -- Create instance of .net control
  using namespace 'Aveva.Pdms.Presentation'
  !this.displayCtrl = object NETGRIDCONTROL()

  -- Add PML event handlers to .net control
  !this.displayCtrl.addEventHandler('afterSelectChange', !this, 'netAfterSelectChange')
  !this.displayCtrl.addEventHandler('onPopup', !this, 'netPopup')

  -- Add .net control to PML container
  !this.netFrame.control = !this.displayCtrl.handle()

  -- Set grid visual attributes
  !this.displayCtrl.columnExcelFilter(false)
  !this.displayCtrl.outlookGroupStyle(false)
  !this.displayCtrl.fixedRows(false)
  !this.displayCtrl.gridHeight(1000.0)
  !this.displayCtrl.editableGrid(false)
  !this.displayCtrl.singleRowSelection(true)
  !this.displayCtrl.columnExcelFilter(false)
  !this.displayCtrl.fixedHeaders(false)
  !this.displayCtrl.headerSort(true)
  !this.displayCtrl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Name')
  !this.headings.append('Description')

endmethod
-- End of method definition for .abaArea()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Read the current coordinate system
  VAR !coordinate COORDINATE

  -- Populate the coordinate gadgets
  -- For ENU
  if (!coordinate.eq('ENU')) then

    -- N/S axis
    !dtext[1] = 'North'
    !dtext[2] = 'South'
    !rtext[1] = 'N'
    !rtext[2] = 'S'

    -- From
    !this.o1.dtext = !dtext
    !this.o1.rtext = !rtext

    -- To
    !this.o4.dtext = !dtext
    !this.o4.rtext = !rtext

    -- E/W axis
    !dtext[1] = 'East '
    !dtext[2] = 'West '
    !rtext[1] = 'E'
    !rtext[2] = 'W'

    -- From
    !this.o2.dtext = !dtext
    !this.o2.rtext = !rtext

    -- To
    !this.o5.dtext = !dtext
    !this.o5.rtext = !rtext

    -- U/D axis
    !dtext[1] = 'Up   '
    !dtext[2] = 'Down '
    !rtext[1] = 'U'
    !rtext[2] = 'D'

    -- From
    !this.o3.dtext = !dtext
    !this.o3.rtext = !rtext

    -- To
    !this.o6.dtext = !dtext
    !this.o6.rtext = !rtext

  -- For XYZ
  else

    -- Y/-Y axis
    !dtext[1] = 'Y'
    !dtext[2] = '-Y'
    !rtext[1] = 'N'
    !rtext[2] = 'S'

    -- From
    !this.o1.dtext = !dtext
    !this.o1.rtext = !rtext

    -- To
    !this.o4.dtext = !dtext
    !this.o4.rtext = !rtext

    -- X/-X axis
    !dtext[1] = 'X'
    !dtext[2] = '-X'
    !rtext[1] = 'E'
    !rtext[2] = 'W'

    -- From
    !this.o2.dtext = !dtext
    !this.o2.rtext = !rtext

    -- To
    !this.o5.dtext = !dtext
    !this.o5.rtext = !rtext

    -- Z/-Z axis
    !dtext[1] = 'Z'
    !dtext[2] = '-Z'
    !rtext[1] = 'U'
    !rtext[2] = 'D'

    -- From
    !this.o3.dtext = !dtext
    !this.o3.rtext = !rtext

    -- To
    !this.o6.dtext = !dtext
    !this.o6.rtext = !rtext

  endif

  !!abaareaformat    = !!distanceFmt
  !!abaareaformat.dp = 0
  !list              = !!abaDefaults.alib.val.dbref()
  !this.fromHere     = !!ce
  !libyData          = array()

  !!abaProcess.visible(FALSE)

  VAR !liby COLL ALL DLLB WITH SPPURP EQ 'ABAR' FOR $!list
  if !liby.size().eq(0) then
    !!alert.error('No Libraries found - Use Create Area Liby to Create one')
    return
  endif

  VAR !allNames EVAL NAME FOR ALL FROM !liby
  VAR !allFunc EVAL FUNCTION FOR ALL FROM !liby

  -- Build and compose the dtext array
  !width    = !allNames.width()
  do !index index !allNames

    !func = !allNames[!index].dbref().function.dbref().function
      handle any
        !func = !allNames[!index].dbref().function
          handle any
            !func = 'unset'
          endhandle
      endhandle

    VAR !line COMPOSE |$!allNames[$!index]| WIDTH $!width SPACES 2 |$!func|

    !libyData.append(!line[1])

  enddo

  -- Set name and description to default null
  !this.name.val = ''
  !this.desc.val = ''

  -- Populate the library gadget
  !this.library.dtext = !libyData
  !this.library.rtext = !liby

  -- Clear any grid selection
  !this.displayCtrl.clearRowSelection()

  -- Find all areas and populate the grid control
  !this.getIdlists()

  -- Set gadget active status
  !this.setActive()

endmethod
-- End of method .init()

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------
define method .cancel()

  !!abaArea.hide()
  !!abaProcess.visible(TRUE)
  !!ce = !This.FromHere

  -- Savework, and unclaim all that's been claimed during use.
  SAVEWORK
  UNCLAIM ALL

endmethod
-- End of method .cancel()

------------------------------------------------------------------------
--
-- Method:      .clear()
--
-- Description: Clear relevant data arrays
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Clear the grid
  !this.displayCtrl.clearGrid()

  -- Clear all data
  !this.areas.clear()
  !this.rowSet.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      .deleteArea()
--
-- Description: Delete an area (IDLI)
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteArea()

  -- Get selected idli
  !idliRefe = !this.areas[!this.displayCtrl.getSelectedRowTags()[1].real()]

  -- Check with the user
  !answer = !!alert.confirm('Are you sure you want to delete ' & !idliRefe.name & '?')
  if (!answer.eq ('YES')) then
    !!ce = !idliRefe
    DELETE IDLI
  endif

  -- Reinitialise the form
  !this.init()

endmethod
-- End of method .deleteArea()

------------------------------------------------------------------------
--
-- Method:      .getIdlists()
--
-- Description: Get all areas (IDLI)
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getIdlists()

  -- Initialise variables
  !names    = ARRAY()

  -- Clear the grid and data object
  !this.clear()

  -- Initialise gadgets
  !this.setDefaults()

  -- Get selected library
  !libyString = !this.library.selection()

  -- Get all areas
  VAR !allIdli COLL ALL IDLI FOR $!libyString

  -- Build grid data
  do !idli val !allIdli

    -- Initialise variables
    !idliRefe = !idli.dbref()
    !idliName = !idliRefe.flnm
    !idliFunc = !idliRefe.func
    !rowData  = ARRAY()

    -- Build row data
    !rowData.append(!idliName)
    !rowData.append(!idliFunc)

    -- Store data
    !this.areas.append(!idliRefe)
    !names.append(!idliName)

    -- Add row data to row set array
    !this.rowSet.append(!rowData)

  enddo

  -- Sort the drawings by name
  !sorted = !names.sortedIndices()
  !this.areas.reindex(!sorted)
  !this.rowSet.reindex(!sorted)

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.displayCtrl.bindToDataSource(object NETDATASOURCE('Areas', !this.headings, !this.rowSet, '^Name'))

  -- Populate the remaining gadgets
  !this.displayCtrl.selectRow(1)

  -- Set gadget active status
  !this.setActive()

endmethod
-- End of method .getIdlists()

------------------------------------------------------------------------
--
-- Method:      .insert()
--
-- Description: Create a new area (IDLI)
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insert()

  -- Access the dllb library
  !!ce = !this.library.selection().dbref()

  -- Create a new dllb
  NEW IDLI $!this.name.val
    handle(41,12)
      !!alert.error('An element of this name already exists. Please rename and try again.')
      DELETE DLLB
      return
    endhandle

  SpPURP ABAR

  -- Description
  if (!this.desc.val.set()) then
    !!ce.function = !this.desc.val
  endif

  -- Limits
  !from = !this.o1.selection() & !this.t1.val & ' ' & !this.o2.selection() & !this.t2.val  & ' ' & !this.o3.selection() & !this.t3.val
  !to   = !this.o4.selection() & !this.t4.val & ' ' & !this.o5.selection() & !this.t5.val  & ' ' & !this.o6.selection() & !this.t6.val
  LIMITS $!from TO $!to

  !idliRefe = !!ce

  -- Find all Libraries and populate the grid control
  !this.getIdlists()

  -- Set gadget active status
  !this.setActive()

  -- Select the modified idli
  !this.displayCtrl.selectRow(!this.areas.findFirst(!idliRefe))

endmethod
-- End of method .insert()

------------------------------------------------------------------------
--
-- Method:      .netAfterSelectChange()
--
-- Description: Callback on grid control after select change
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelectChange(!array is ARRAY)

  -- Select the library function
  if (!this.displayCtrl.getSelectedRowTags().set()) then
    !this.select()
  endif

endmethod
-- End of method definition for .netAfterSelectChange()

------------------------------------------------------------------------
--
-- Method:      .netPopup()
--
-- Description: Pop-up for grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopup(!array is ARRAY)

  -- Show the pop-up
   !this.netFrame.popup = !this.defPopUp
   !this.netFrame.showPopup(!array[0], !array[1])

endmethod
-- End of method definition for .netPopup()

------------------------------------------------------------------------
--
-- Method:      .numbers(ARRAY)
--
-- Description: Set all volume gadgets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .numbers(!vol is ARRAY)

  if (!vol[1] lt 0) then
    !this.o2.val = 2
    !this.t2.val = !vol[1].abs()
  else
    !this.o2.val = 1
    !this.t2.val = !vol[1]
  endif

  if (!vol[2] lt 0) then
    !this.o1.val = 2
    !this.t1.val = !vol[2].abs()
  else
    !this.o1.val = 1
    !this.t1.val = !vol[2]
  endif

  if (!vol[3] lt 0) then
    !this.o3.val = 2
    !this.t3.val = !vol[3].abs()
  else
    !this.o3.val = 1
    !this.t3.val = !vol[3]
  endif

  if (!vol[4] lt 0) then
    !this.o5.val = 2
    !this.t5.val = !vol[4].abs()
  else
    !this.o5.val = 1
    !this.t5.val = !vol[4]
  endif

  if (!vol[5] lt 0) then
    !this.o4.val = 2
    !this.t4.val = !vol[5].abs()
  else
    !this.o4.val = 1
    !this.t4.val = !vol[5]
  endif

  if (!vol[6] lt 0) then
    !this.o6.val = 2
    !this.t6.val = !vol[6].abs()
  else
    !this.o6.val = 1
    !this.t6.val = !vol[6]
  endif

endmethod
-- End of method definition for .numbers(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .replace()
--
-- Description: Reset the attributes of the selected area (IDLI)
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .replace()

  -- Check for anything to replace
  if (!this.displayCtrl.getselectedrows().unset()) then
    return
  endif

  -- Access the selected dllb
  !!ce = !this.areas[!this.displayCtrl.getSelectedRowTags()[1].real()]

  -- Rename the idli & set the attributes
  if (!this.name.val.substring(1,1).eq('/')) then
    NAME  $!<this.name.val>
  endif

  SPPURP ABAR

  -- Description
  if (!this.desc.val.set()) then
     !!ce.function = !this.desc.val
  endif

  -- Limits
  !from = !this.o1.selection() & !this.t1.val & ' ' & !this.o2.selection() & !this.t2.val  & ' ' & !this.o3.selection() & !this.t3.val
  !to   = !this.o4.selection() & !this.t4.val & ' ' & !this.o5.selection() & !this.t5.val  & ' ' & !this.o6.selection() & !this.t6.val
  LIMITS $!from TO $!to

  !idliRefe = !!ce

  -- Find all Libraries and populate the grid control
  !this.getIdlists()

  -- Select the modified idli
  !this.displayCtrl.selectRow(!this.areas.findFirst(!idliRefe))

endmethod
-- End of method definition for .replace()

------------------------------------------------------------------------
--
-- Method:      .select()
--
-- Description: Set all gadgets for the selected area (IDLI)
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .select()

  -- Test for any selected
  if (!this.displayCtrl.getRows().set()) then

    -- Get the selected area dllb
    !idliRefe    = !this.areas[!this.displayCtrl.getSelectedRowTags()[1].real()]
    !description = !idliRefe.function
    !volume      = !idliRefe.limits

    -- Populate gadgets
    -- Name
    !this.name.val = !idliRefe.flnm

    -- Description
    if (!description.eq('')) then
      !this.desc.val = 'unset'
    else
      !this.desc.val = !description
    endif

    -- Volume
    if (!volume.size().neq(6)) then

      do !index from 1 to 6
        !volume[!index] = !index
      enddo

      -- Modify the idli to have minimum limits
      !!ce = !idliRefe
      LIMITS N0 E0 U0 TO N10 E10 U10
      SAME

    endif

    -- Set the volume gadgets
    !this.numbers(!volume)
    !this.setSize(!this.t1.val, !this.t4.val, 7)
    !this.setSize(!this.t2.val, !this.t5.val, 8)
    !this.setSize(!this.t3.val, !this.t6.val, 9)

  -- There are no idli elements
  else

    -- Initialise gadgets
    !this..setDefaults()

  endif

endmethod
-- End of method .select()

------------------------------------------------------------------------
--
-- Method:      .setActive()
--
-- Description: Set gadget active status
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------
define method .setActive()

  -- Test for any selected area libraries
  if (!this.displayCtrl.getRows().set()) then
    !this.replace.active = true
    !this.delete.active  = true
  else
    !this.replace.active = false
    !this.delete.active  = false
  endif

endmethod
-- End of method definition for .setActive()

------------------------------------------------------------------------
--
-- Method:      .setDefaults()
--
-- Description: Set Default setting
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDefaults()

  -- Set name and description blank
  !this.name.val = ''
  !this.desc.val = ''

  -- Set volumes gadgets to a valid limits box
  -- Min
  !this.t1.val = 0
  !this.t2.val = 0
  !this.t3.val = 0

  -- Max
  !this.t4.val = 10
  !this.t5.val = 10
  !this.t6.val = 10

  -- Distances
  !this.t7.val = 10
  !this.t8.val = 10
  !this.t9.val = 10

endmethod
-- End of method definition for .setDefaults()

------------------------------------------------------------------------
--
-- Method:      .setName()
--
-- Description: Check the validity of the entered name
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setName()

  -- Trim any leading or trailing blanks
  !entered = !this.name.val.trim('LR')

  -- Check for leading slash character
  if (!entered.substring(1,1).eq('/')) then
    !fullName    = !entered

  -- Add a leading slash character
  else
    !fullName    = '/' & !entered
    !this.name.val = !fullName
  endif

  -- Check name exists
  VAR !exists EXIST $!fullName
  if (!exists.eq('TRUEA')) then
    !!alert.error('An element of this name already exists. Please try again.')
    !this.name.setFocus()
    return
  endif

endmethod
-- End of method .setName()

------------------------------------------------------------------------
--
-- Method:      .setBySize(REAL,REAL,REAL,REAL)
--
-- Description: Sets the "distance" field to show difference between from-to
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setBySize(!no1 is REAL, !no2 is REAL, !gadget is REAL, !distance is REAL)


  -- Initialise variables
  !numb1    = !no1
  !numb2    = !no2
  !fromNum  = !gadget - 6
  !toNum    = !gadget - 3
  !fWidget  = '!this.o' & !fromNum & '.val'
  !fSet     = $!fWidget
  !tWidget  = '!this.o' & !toNum & '.val'
  !tSet     = $!tWidget
  !vfWidget = '!this.t' & !fromNum & '.val'
  !vfSet    = $!fwidget
  !vtWidget = '!this.t' & !toNum & '.val'
  !vtSet    = $!tWidget

  !val = $!vtWidget$N.real() - $!vfWidget$N.real()
  !val = $!vtWidget$N.real() - $!vfWidget$N.real()

  if (!fSet eq 1) then
    !result = $!vfWidget + !distance
  else
    !result = $!vfWidget - !distance
  endif

  if (!result lt 0) then
    $!tWidget = 1
    $!vtWidget = !result.abs()
  else
    $!tWidget = $!fwidget
    $!vtWidget = !result
  endif

endmethod
-- End of method .setBySize(REAL,REAL,REAL,REAL)

------------------------------------------------------------------------
--
-- Method:      .setBySize(REAL,REAL,REAL)
--
-- Description: Sets the "distance" field to show difference between from-to
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSize(!no1 is REAL, !no2 is REAL, !gadget is REAL)

  -- Initialise variables
  !numb1   = !no1
  !numb2   = !no2
  !fromNum = !gadget - 6
  !toNum   = !gadget - 3
  !fWidget = '!this.o' & !fromNum & '.val'
  !fSet    = $!fWidget
  !tWidget = '!tHis.o' & !toNum & '.val'
  !tSet    = $!tWidget

  -- Test for unset values
  if (!no1.unset()) then
    !widget = '!this.t' & !fromNum & '.val'
    $!widget = 0
    !no1 = 0
  endif

  if (!no2.unset()) then
    !widget = '!this.t' & !toNum & '.val'
    $!widget = 0
    !no1 = 0
  endif

  if (!fSet eq 2) then
    !numb1 = -1 * !no1
  endif

  if (!tSet eq 2) then
    !numb2 = -1 * !no2
  endif

  !dist = !numb2-!numb1

  if (!numb2.lt(!numb1) and !this.shown()) then
    !!alert.error('Maximum Value is Less than Minimum')
  endif

  !widget = '!this.t' & !gadget & '.val'
  $!widget = !dist

endmethod
-- End of method .setSize(REAL,REAL,REAL)

------------------------------------------------------------------------
--
-- Method:      .setBySize(REAL,REAL,STRING)
--
-- Description: Changes the "to" field if the distance field is changed
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSize(!no1 is REAL, !no2 is REAL, !gadget is STRING)

  !dist = !no2-!no1

  if (!no2.lt(!no1) and !this.shown()) then
    !!alert.error('Maximum Value is Less than Minimum')
  endif

  !widget = '!this.' & !gadget & '.val'
  $!widget = !dist

endmethod
-- End of method .setSize(REAL,REAL,STRING)
