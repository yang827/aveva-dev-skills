--   Module:
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 May 1999
--
--
-- Description: Define Area Limits by Design Element Volumes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addMember()                      -
--  calcVol(STRING)                  -
--  closed()                         -
--  compare(ARRAY,ARRAY)             ARRAY
--  init()                           -                   Method to initialise the form
--  jump()                           -
--  member()                         -
--  navigate()                       -
--  remMember(REAL)                  -
--  setvol()                         -
--  strng()                          -
--  wipe()                           -
-- Members
--   [Name]           [Description]
--    cdcMember        True if the standard members list is shown
------------------------------------------------------------------------
--
------------------------------------------------------------------------

setup form !!abaAreaByVol
title |Set Area by Selecting Model Items|
init |!this.init()|

  path down

-- Define Members/selection Areas
-- ------------------------------

  frame .selection | selection Volume | at x0

    para .members text |Design Members|
    button .prev at ymax pixmap height 12 width 9 call |PREVIOUS|

    path right
    text .strng at xmax ymin+0.03 call |!this.strng()| width 20 STRING

    button .next at xmax+0.01 ymin.prev pixmap height 12 width 9 call |NEXT|

    selector .dbList at xmin.members ymax+0.2 call |!this.member()| width 23 length 15 database auto

    option .goto | Goto | at xmin ymax+0.2 call |!this.navigate()| width 12

    button .add at xmax.dbList+1.2 y5 pixmap call |!this.addMember()|

    path down
    button .rem pixmap call |!this.remMember(!this.choice.val)|

    para .chosen at xmax.add-1.2 ymin.members text |Selected Elements|

    path down
    list .choice at ymin.strng single width 23 height 17

    halign right
    button .clear | Clear | at ymin.goto call |!this.wipe()|

    path left
    button .access | Goto Selected | at xmin.choice ymin call |!this.jump()|

  exit

  !dtext[1] = |Owner|
  !dtext[2] = |First|
  !dtext[3] = |Last|
  !dtext[4] = |First member|
  !dtext[5] = |Last member|
  !dtext[6] = |Old CE|
  !rtext[1] = |OWNE|
  !rtext[2] = |FIRST|
  !rtext[3] = |LAST|
  !rtext[4] = |FIRST MEM|
  !rtext[5] = |LAST MEM|
  !rtext[6] = |SAME|
  !this.goto.dtext = !dtext
  !this.goto.rtext = !rtext

  !this.clear.active = false
  !this.access.active = false

-- Volume Box Coordinate Display
-- -----------------------------

  frame .volume | Current Volume of Selected Elements | at xmin.selection ymax.selection+0.1

    path right

    paragraph .from at xmin.dbList+1.5 ymax+0.2 text 'From'
    paragraph .fn   at xmax.from+2 ymin width 2 lines 1
    paragraph .fnc  at width 13 lines 1
    paragraph .fe   at xmax+1 width 2 lines 1
    paragraph .fec  at width 13 lines 1
    paragraph .fu   at xmax+1 width 2 lines 1
    paragraph .fuc  at width 13 lines 1

    paragraph .to   at xmin.from ymax-0.2 text 'To '
    paragraph .tn   at xmin.fn ymin width 2 lines 1
    paragraph .tnc  at width 13 lines 1
    paragraph .te   at xmax+1 width 2 lines 1
    paragraph .tec  at width 13 lines 1
    paragraph .tu   at xmax+1 width 2 lines 1
    paragraph .tuc  at width 13 lines 1

  exit

-- Action buttons
-- --------------

  button .ok     |  OK  | at x0 ymax+0.4 call |!this.setvol()|

  path right
  button .cancel |Cancel| at xmax form-size call |!this.closed()| Cancel

-- Members
-- -------
  member .cdcMember  is BOOLEAN
  member .vol        is ARRAY
  member .volInMM    is ARRAY
  member .worldRefe  is DBREF
  member .coordinate is STRING

  -- Pixmaps
  !this.prev.addPixmap(!!PML.getPathName('leftarrow9x12.png'))
  !this.next.addPixmap(!!PML.getPathName('rightarrow9x12.png'))
  !this.add.addPixmap(!!PML.getPathName('rightarrow16.png'))
  !this.rem.addPixmap(!!PML.getPathName('leftarrow16.png'))

exit

-- End of form definition

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Read the current coordinate system
  VAR !coordinate COORDINATE
  !this.coordinate = !coordinate

  -- Default volume coordinates
  -- For ENU
  if (!coordinate.eq('ENU')) then
    !this.fn.val = 'N'
    !this.fe.val = 'E'
    !this.fu.val = 'U'
    !this.tn.val = 'N'
    !this.te.val = 'E'
    !this.tu.val = 'U'

  -- For XYZ
  else
    !this.fn.val = 'Y'
    !this.fe.val = 'X'
    !this.fu.val = 'Z'
    !this.tn.val = 'Y'
    !this.te.val = 'X'
    !this.tu.val = 'Z'
  endif

  !this.fnc.val = '0'
  !this.fec.val = '0'
  !this.fuc.val = '0'
  !this.tnc.val = '0'
  !this.tec.val = '0'
  !this.tuc.val = '0'

  -- Get db data
  !dbType = DBTYPE

  -- Force switch to design db
  if (!dbType.eq('PADD')) then

    -- Navigate to design world
    SWITCH

    if (!!ce.type.eq('WORL')) then
      !this.worldRefe = !!ce
    endif

  endif

  -- Test for members list shown
  -- PDMS11.3 change, Neale Morris, 28/03/2001
  !formObj = !!cdcMember
  if (!formObj.shown()) then
    !this.cdcMember = true
    !formObj.hide()
  else
    !this.cdcMember = false
  endif

   -- Calculate volume
   !this.calcVol('ADD')

endmethod
-- End of method .init()

--------------------------------------------------------------------
define method .member()
--------------------------------------------------------------------
-- Called on member list pick

   -- Test for world
   if (!this.dbList.selection().eq('/*')) then

     -- Maintain access to Design db
     END OF SITE
     handle any
       -- In case at TPWL
       END OF TPWL
          handle any
            if (!this.worldRefe.badref().not()) then
              !!ce = !this.worldRefe
            else
              WORLD
            endif
          endhandle
     endhandle

   else
     !!ce = !this.dbList.selection().dbref()
   endif

endmethod

--------------------------------------------------------------------
define method .strng()
--------------------------------------------------------------------
-- Called on user string enter

  -- Add slash if required
  !strng = !this.strng.val
  !prfx = !strng.trim().substring(1,1)
  if (!prfx.neq('/')) then
    !strng = '/' & !strng
  endif

  -- Test is element exists
  if (!strng.dbref().badref()) then
    !!alert.error('Cannot navigate to ' & !strng)
    return
  else
    !!ce = !strng.dbref()
  endif

  -- Clear gadget
  !this.strng.clear()

endmethod

--------------------------------------------------------------------
define method .closed()
--------------------------------------------------------------------
-- Called when form is closed

   -- Hide this form
   !this.hide()

   -- Check for need to show real members list
   -- PDMS11.3 change, Neale Morris, 28/03/2001
   !formObj = !!cdcMember
   if (!this.cdcMember) then
     !formObj.show()
   endif

   -- Get db data
   !dbType = dbtype

   -- Force navigation to Draft db
   if (!dbType.neq('PADD')) then
     SWITCH
   endif

endmethod

--------------------------------------------------------------------
define method .addMember()
--------------------------------------------------------------------
-- Called when element is chosen

   -- Test for world
   if (!this.dbList.selection().eq('/*')) then
     return
   endif

   -- Read current list contents
   !curDtext = !this.choice.dtext
   !curRtext = !this.choice.rtext

   -- Build name
   !elemRefe = !this.dbList.selection().dbref()
   !displayName = !elemRefe.type & ' ' & !elemRefe.flnn

   -- Before we add the chosen element check that it has a volume
   !vol = !elemRefe.wvol
   if (!vol.empty()) then
     !!alert.warning('The chosen element does not have any volume!')
     return
   endif

   -- Add selection
   !curDtext.append(!displayName)
   !this.choice.dtext = !curDtext.unique()
   !curRtext.append(!this.dbList.selection('RTEXT'))
   !this.choice.rtext = !curRtext.unique()

   -- Select latest added choice
   !this.choice.select('RTEXT',!this.dbList.selection('RTEXT'))

   -- Calculate volume
   !this.calcVol('ADD')

   -- Gadget visibility
   !this.clear.active = true
   !this.access.active = true

endmethod

--------------------------------------------------------------------
define method .remMember(!real is REAL)
--------------------------------------------------------------------
-- Called when element is rejected

   if (!real ne 0) then
     !curDtext = !this.choice.dtext
     !curRtext = !this.choice.rtext

     !curDtext.remove(!this.choice.val)
     !curRtext.remove(!this.choice.val)

     !this.choice.dtext = !curDtext
     !this.choice.rtext = !curRtext

   endif

   -- Recalculate volume
   !this.calcVol('REM')

   -- Gadget visibility
   if (!this.choice.rtext.empty()) then

     !this.clear.active = false
     !this.access.active = false

   endif

endmethod

--------------------------------------------------------------------
define method .calcVol(!option is STRING)
--------------------------------------------------------------------

  -- Initialise variables
  !units = object COMUNITS(TRUE)
  !distIndex = !units.getDimensionIndex('DIST')

  -- Read current selected choice
  !curRtext = !this.choice.selection()

  -- Read all selection
  !allRtext = !this.choice.rtext

  -- Test for no chosen elements
  if (!this.choice.val.eq(0)) then

    -- Reset coords to zero
    do !c from 1 to 6
      !vol[!c] = 0
    enddo

  elseif (!this.choice.dtext.size().eq(1)) then

    -- Volume must be equal to the only element
    !vol = !curRtext.dbref().wvol

  else

    -- Test against the current displayed volume for add element
    -- Calculate volume of total selected for remove element
    -- This makes it faster since are adding more than removing
    if (!option.eq('ADD')) then

      -- Read current volume in MM
      !vol[1] = !this.volInMM[1]
      !vol[2] = !this.volInMM[2]
      !vol[3] = !this.volInMM[3]
      !vol[4] = !this.volInMM[4]
      !vol[5] = !this.volInMM[5]
      !vol[6] = !this.volInMM[6]

      -- Read element world volume
      !elemVol = !curRtext.dbref().wvol

      -- Compare element volume with current
      !vol = !this.compare(!vol,!elemVol)

    else

      -- Use first element for volume and compare rest to it
      !vol = !allRtext[1].dbref().wvol

      do !ind ind !allRtext

        skip if (!ind.eq(1))

        -- Read element world volume
        !elemVol = !allRtext[!ind].dbref().wvol

        -- Compare element volume with current
        !vol = !this.compare(!vol,!elemVol)

      enddo

    endif


  endif

  -- Store coordinate values
  !this.volInMM[1] = !vol[1].abs()
  !this.volInMM[2] = !vol[2].abs()
  !this.volInMM[3] = !vol[3].abs()
  !this.volInMM[4] = !vol[4].abs()
  !this.volInMM[5] = !vol[5].abs()
  !this.volInMM[6] = !vol[6].abs()

  -- Test for feet & inches
  if (!units.savedUnits[!distIndex] eq 'mm') then

    -- Set decimal places
    !!distanceFmt.dp = 0

  endif

  -- Update displayed coordinates
  if (!vol[1].lt(0)) then
    if (!this.coordinate.eq('ENU')) then
      !this.fe.val = 'W'
    else
      !this.fe.val = '-X'
    endif
  else
    if (!this.coordinate.eq('ENU')) then
      !this.fe.val = 'E'
    else
      !this.fe.val = 'X'
    endif
  endif

  if (!vol[2].lt(0)) then
    if (!this.coordinate.eq('ENU')) then
      !this.fn.val = 'S'
    else
      !this.fn.val = '-Y'
    endif
  else
    if (!this.coordinate.eq('ENU')) then
      !this.fn.val = 'N'
    else
      !this.fn.val = 'Y'
    endif
  endif

  if (!vol[3].lt(0)) then
    if (!this.coordinate.eq('ENU')) then
      !this.fu.val = 'D'
    else
      !this.fu.val = '-Z'
    endif
  else
    if (!this.coordinate.eq('ENU')) then
      !this.fu.val = 'U'
    else
      !this.fu.val = 'Z'
    endif
  endif

  if (!vol[4].lt(0)) then
    if (!this.coordinate.eq('ENU')) then
      !this.te.val = 'W'
    else
      !this.te.val = '-X'
    endif
  else
    if (!this.coordinate.eq('ENU')) then
      !this.te.val = 'E'
    else
      !this.te.val = 'X'
    endif
  endif

  if (!vol[5].lt(0)) then
    if (!this.coordinate.eq('ENU')) then
      !this.tn.val = 'S'
    else
      !this.tn.val = '-Y'
    endif
  else
    if (!this.coordinate.eq('ENU')) then
      !this.tn.val = 'N'
    else
      !this.tn.val = 'Y'
    endif
  endif

  if (!vol[6].lt(0)) then
    if (!this.coordinate.eq('ENU')) then
      !this.tu.val = 'D'
    else
      !this.tu.val = '-Z'
    endif
  else
    if (!this.coordinate.eq('ENU')) then
      !this.tu.val = 'U'
    else
      !this.tu.val = 'Z'
    endif
  endif

  -- Set form volume display gadget
  !this.fec.val = !vol[1].abs().string(!!distanceFmt)
  !this.fnc.val = !vol[2].abs().string(!!distanceFmt)
  !this.fuc.val = !vol[3].abs().string(!!distanceFmt)
  !this.tec.val = !vol[4].abs().string(!!distanceFmt)
  !this.tnc.val = !vol[5].abs().string(!!distanceFmt)
  !this.tuc.val = !vol[6].abs().string(!!distanceFmt)

  -- Store volume for later calculations
  !this.vol = !vol

endmethod

--------------------------------------------------------------------
define method .compare(!array1 is ARRAY, !array2 is ARRAY) is ARRAY
--------------------------------------------------------------------

  -- Make comparison
  do !count from 1 to 3
    if (!array2[!count].lt(!array1[!count])) then
      !array1[!count] = !array2[!count]
    endif
  enddo
  do !count from 4 to 6
    if (!array2[!count].gt(!array1[!count])) then
      !array1[!count] = !array2[!count]
      endif
  enddo

  return !array1

endmethod

--------------------------------------------------------------------
define method .navigate()
--------------------------------------------------------------------

  -- Do option
  !navi = !this.goto.selection()
  $!navi

endmethod

--------------------------------------------------------------------
define method .jump()
--------------------------------------------------------------------

  -- Navigate to selected item unless nothing selected
  if (!this.choice.val.gt(0)) then
    !!ce = !this.choice.selection().dbref()
  endif

endmethod

--------------------------------------------------------------------
define method .wipe()
--------------------------------------------------------------------

  -- Clear list
  !this.choice.clear()

  -- Recalculate volume
  !this.calcVol('ADD')

  -- Gadget visibility
  !this.clear.active = false
  !this.access.active = false


endmethod

--------------------------------------------------------------------
define method .setvol()
--------------------------------------------------------------------
-- Called on OK

  -- Initialise variables
  !nerr = ''
  !eerr = ''
  !uerr = ''
  !errors = 0

  -- Check that there is any volume to add
  if (!this.vol.empty()) then
    hide !!abaAreaByVol
    return
  endif

  -- Check that the volume is valid for draft
  -- ie that the volume box has sides longer than zero
  !elen = !this.vol[1] - !this.vol[4]
  !nlen = !this.vol[2] - !this.vol[5]
  !ulen = !this.vol[3] - !this.vol[6]

  if (!nlen.abs().int().eq(0)) then
    !nerr = ' N-S side,'
    !errors = !errors + 1
  endif
  if (!elen.abs().int().eq(0)) then
    !eerr = ' E-W side,'
    !errors = !errors + 1
  endif
  if (!ulen.abs().int().eq(0)) then
    !uerr = ' U-D side,'
    !errors = !errors + 1
  endif

  -- Make error
  if (!errors ne 0) then
    if (!errors.eq(1)) then
      !word = ' is'
    else
      !word = ' are'
    endif

    !allerr = !nerr & !eerr & !uerr
    !!alert.error('The volume is not valid; the' & !allerr & !word & ' zero')
    return
  endif

  -- Set area form option gadgets
  !!abaArea.o1.select('RTEXT',!this.fn.val.replace('-Y','S').replace('Y','N'))
  !!abaArea.o2.select('RTEXT',!this.fe.val.replace('-X','W').replace('X','E'))
  !!abaArea.o3.select('RTEXT',!this.fu.val.replace('-Z','D').replace('Z','U'))
  !!abaArea.o4.select('RTEXT',!this.tn.val.replace('-Y','S').replace('Y','N'))
  !!abaArea.o5.select('RTEXT',!this.te.val.replace('-X','W').replace('X','E'))
  !!abaArea.o6.select('RTEXT',!this.tu.val.replace('-Z','D').replace('Z','U'))

  -- Set area form coord gadgets
  !!abaArea.t1.val = !this.vol[2].abs()
  !!abaArea.t2.val = !this.vol[1].abs()
  !!abaArea.t3.val = !this.vol[3].abs()
  !!abaArea.t4.val = !this.vol[5].abs()
  !!abaArea.t5.val = !this.vol[4].abs()
  !!abaArea.t6.val = !this.vol[6].abs()

  -- Calculate area form distances
  !!abaArea.setSize(!!abaArea.t1.val,!!abaArea.t4.val,7)
  !!abaArea.setSize(!!abaArea.t2.val,!!abaArea.t5.val,8)
  !!abaArea.setSize(!!abaArea.t3.val,!!abaArea.t6.val,9)

  -- Close this form
  !this.closed()

endmethod
