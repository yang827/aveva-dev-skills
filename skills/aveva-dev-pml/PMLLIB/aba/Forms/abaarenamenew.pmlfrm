--
-- File:            abaarenamenew.pmlfrm
--   Type:          Form Definition
--   Group:
--   Keyword:
--   Module:
--   Replaces:
--
-- Author:          Tony Martin
-- Created:         12 May 2002
--
-- Description:
-- form to set individual drawing names
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkname()                      -                   Check the entered name
--  init()                           -                   Method to initialize the form
--  setDrwg(ABADRAWING)              -                   Set the drawing to be renamed from the passed object
--  setName()                        -                   Set the name in the main process form
--
setup form !!abaARenameNew blocking

  title 'Rename Drawing'
  init '!this.init()'

  frame .frame 'Drawing Data'

    para .templateP at x1   y0.7 text 'Template:'
    para .template  at xmax ymin width 60 lines 1

    para .areaP at xmin.templateP ymax text 'Area:'
    para .area at xmin.template   ymin width 60 lines 1

    para .nameP   at xmin.areaP    ymax text 'Name:'
    text .name '' at xmin.template ymin call '!this.checkName()' width 60 is STRING

  exit

  button .ok ' OK ' at x0 ymax+0.2 call '!this.setName()' ok

  button .cancel 'Cancel' at xmax form-size ymin cancel

  member .drawing is ABADRAWING

exit

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Set attributes for the drawing being renamed
  -- Template name
  !this.template.val = !this.drawing.template.flnn

  -- Area name
  !this.area.val     = !this.drawing.area.flnn

  -- Drawing name
  !this.name.val     = !this.drawing.drwgName

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .checkname()
--
-- Description: Check the entered name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkname()

  -- Remove all occurrences of the space character
  !this.name.val = !this.name.val.replace(' ','')

  -- Test for a missing leading slash
  if (!this.name.val.substring(1,1).neq('/')) then

   !this.name.val = '/' & !this.name.val

  endif

  -- Remember the name we start with
  !startingName = !this.drawing.drwgName

  !test = !this.name.val.dbref()
    handle any

      -- Test for the same name
      if (!this.name.val.eq(!startingName)) then
         !!alert.error('The entered name is the same as the name already given to the drawing')

      -- Test to see if the name is defined in the list of old drawings
      elseif (!!abaProcess.getAllDrwgNames().findfirst(!this.name.val).set()) then

         !!alert.error('The entered name has already been used in the process lists')
         !this.init()

      endif

    elsehandle none

      !!alert.error('The name has already been defined!')
      !this.init()

    endhandle

endmethod
-- End of method .checkname()

------------------------------------------------------------------------
--
-- Method:      .setDrwg(ABADRAWING)
--
-- Description: Set the drawing to be renamed from the passed object
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ABADRAWING  Drawing object
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDrwg(!abaDrawing is ABADRAWING)

  !this.drawing = !abaDrawing

endmethod
-- End of method .setDrwg(ABADRAWING)

-----------------------------------------------------------------------
--
-- Method:      .setName()
--
-- Description: Set the name in the main process form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setName()

  !!abaProcess.replaceName('NEW', !this.name.val)

endmethod
-- End of method definition for .setName()
