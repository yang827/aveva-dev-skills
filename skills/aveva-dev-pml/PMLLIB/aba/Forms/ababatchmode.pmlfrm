--
-- File:            ababatchmode.pmlfrm
--   Type:          Form Definition
-- Author:          Tony Martin
-- Created:         25th March 1999
--
--
-- Description:
-- Write a batch file for later processing of drawings
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaBatchMode()                   -                   Constructor method
--  addDrawingList(ARRAY)            ARRAY               Adds list of drawings to the log file, for this batch run
--  browser()                        -                   Show standard browser
--  cancel()                         -                   Cancel this form
--  getEnvironment()                 -                   Build a file to hold the current environment variables
--  getGtaskData()                   ARRAY               Gets global task data and sets up object definition
--  init()                           -                   initialises the batch form
--  openBatFiles()                   -                   Opens Batch files for this run of processing drawings
--  setFolder(FILE)                  -                   Set the passed directory
--  writeBatFile()                   -                   Gets project data for batch macro to function
--  writeBatMacro(STRING)            -                   Gets drawing data for batch macro to function
------------------------------------------------------------------------
setup form !!abaBatchMode

  !this.formTitle     = 'Write a Batch Macro'
  !this.callback      = '!this.init()'
  !this.cancelCall    = '!this.cancel()'
  !this.quitCall      = '!this.cancel()'

  text     .batchDir 'Batch File Directory' at xmin ymax+0.2 width 32 scroll 90 STRING

  button   .browse   at xmax+1 ymin+0.1 pixmap width 16 height 16

  textpane .dataPane at xmin.batchDir ymax+0.1 'Process Details' width 60 hei 16

  button   .write    at xmin.batchDir ymax+0.3  'Write Batch File'

  button   .cancel   at xmax form-size ymin  'Cancel'

  member .newDrawings is ARRAY
  member .oldDrawings is ARRAY
  member .regi        is DBREF
  member .processType is STRING
  member .bat         is FILE
  member .maclog      is FILE
  member .mac         is FILE
  member .log         is FILE
  member .evar        is FILE
  member .pType       is STRING
  member .written     is BOOLEAN
  member .directory   is FILE

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      .abaBatchMode()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .abaBatchMode()

  -- Pixmaps
  !this.browse.addPixmap(!!pml.getPathName('folder.png'))

  -- Form callbacks
  !this.batchDir.callback = '!this.openBatFiles()'
  !this.browse.callback   = '!this.browser()'
  !this.write.callback    = '!this.writeBatFile()'
  !this.cancel.callback   = '!this.cancel()'

endmethod
-- End of method definition for .abaBatchMode()

------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: initialises the batch form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  !this.written = false

  -- Get update,regen info
  !this.pType        = !!abaProcess.setupProcess(!!abaProcess.numbering.val)

  -- Get list of existing drawings to process
  !this.oldDrawings  =  !!abaProcess.oldDrawings

  -- Get list of new drawings to process
  !this.newDrawings  =  !!abaProcess.newDrawings

  -- Set path gadget to default setting
  !this.batchDir.val = !!abaDefaults.batPath

  -- Store the batch folder in this form member
  !this.directory    = object FILE(!!abaDefaults.batPath)

  -- Go and get file names
  !this.openBatFiles()

endmethod
-- End of method definition for init()

------------------------------------------------------------------------
--
-- Method:      .addDrawingList(ARRAY)
--
-- Description: Adds list of drawings to the log file, for this batch run
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addDrawingList(!list is ARRAY) is ARRAY

  -- Initialise variables
  !num   = !list.size()
  !drawl = ARRAY()

  -- Start logging process
  !drawl.append(|!desc = 'ABA Log File - Processing ' & $!num & ' Drawings'|)
  !drawl.append(|!numdesc[2] = '                    ' & !desc|)
  !drawl.append(|!numdesc[1] = '                    ' & !!abalogging.makeString(!desc,'=')|)
  !drawl.append(|!numdesc[3] = '                    ' & !!abalogging.makeString(!desc,'=')|)
  !drawl.append(|!numdesc[4] = ' '|)

  !count = 4

  do !x values !list

    !drawing  = !x.template.owner.name
    !template = name of $!x.template
    !area     = name of $!x.area
    !area     = !area.after('/')
    !count    = !count + 1

    !drawl.append(|!numdesc[$!count] = 'Entry for Drawing $!drawing-$!area ($!x.template,$!x.area)'|)

   enddo

   !count = !count + 1
   !drawl.append(|!numdesc[$!count] = 'End of Process List'|)

   !count = !count + 1
   !drawl.append(|!numdesc[$!count] = ' '|)

   !count = !count + 1
   !drawl.append(|!!abalogging.addToLog(!numdesc)|)

   return !drawl

endmethod
-- End of method definition for .addDrawingList(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .browser()
--
-- Description: Show standard browser
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browser()

  import 'PMLFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !folderBrowser = object PMLFOLDERBROWSER()

  -- Show the folder browser
  !folderBrowser.show('Select Output Folder',true)

  -- Use the selected folder
  !this.setFolder(object FILE(!folderBrowser.selectedPath()))

endmethod
-- End of method .browser()

------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  if (!this.written.not()) then

    if (!!alert.confirm('You have not yet written the batch file - Do you want to cancel') eq 'YES') then
      hide !!abaBatchMode
      !!abaProcess.show()

    endif

  else
    hide !!abaBatchMode

  endif

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      .getEnvironment()
--
-- Description: Build a file to hold the current environment variables
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getEnvironment()

  -- This is the original call to a supplied executable to extract the evars
  --  var !exe file /%PDMSUI%/batFiles/getenv.exe
  --  syscom '$!exe $!this.evar'

  -- Import the evars addin
  import 'pmlnetutilities'
    handle (1000,0)
      -- Assembly already loaded
    endhandle

  using namespace 'aveva.pdms.pmlNet'

  -- Build file pathname
  !folderPath = !this.directory.fullName() & '\' & !this.evar.entry()

  -- Execute the addin to extract the evars
  !evars = object PDMSEVARS()
  !evars.writetofile(!folderPath)

endmethod
-- End of method definition for .getEnvironment()

------------------------------------------------------------------------
--
-- Method:      .getGtaskData()
--
-- Description: Gets global task data and sets up object definition
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getGtaskData() is ARRAY

  -- Initialise variables
  !return = ARRAY()

  -- For each task in the process form task list
  do !x value !!abaProcessTask.taskList.taskArray

    -- Build the task object
    !return.append('!task = object abatask(' & '|' & !x.name  & '|,|' & !x.description & '|,|' & !x.execute & '| )')

    -- Add the task parameters to the object
    do !index ind !x.paramVal
      !return.append('!task.addparam(|' & !x.paramDesc[!index] & '|,|' & !x.paramVal[!index] & '|)')
    enddo

    -- Build the task list
    !return.append('!taskList.append(!task)')

  enddo

  return !return

endmethod
-- End of method definition for .getGtaskData()

------------------------------------------------------------------------
--
-- Method:      .openBatFiles()
--
-- Description: Opens Batch files for this run of processing drawings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .openBatFiles()

  -- Initialise variables
  !directory = object FILE(!this.batchDir.val)

  -- Check the entered directory name for validity
  if (!directory.exists().not()) then

    -- Ask the user, but only if the form is shown
    -- This handles any MDS call that does not show the form
    if (!this.shown()) then

      -- Output message
      !answer = !!alert.confirm('The output folder ' & !directory.string() & ' does not exist. Would you like it to be created for you?')

    else

      -- Create the folder automatically
      !answer = 'YES'

    endif

    -- Create the folder
    if (!answer.eq('YES')) then

      -- Test for the file name being an evar
      if (!directory.string().match('%').neq(0)) then

        -- Remove all %
        !directoryString = !directory.string().replace('%','')

        -- Get evar full path
        VAR !folderPath EVAR $!directoryString

      else

        !folderPath = !this.directory.directory().fullName() & '\' & !this.directory.entry()

      endif

      SYSCOM 'mkdir "$!folderPath"'

    -- Return to the original value
    else

      !this.batchDir.val = !this.directory.name()
      return

    endif

  endif

  -- Make filename from date & time
  !dt = object DATETIME()

  if (!dt.minute() lt 10) then
    !minute = '0' & !dt.minute()
  else
    !minute = !dt.minute()
  endif

  -- Reduce the length of characters in the batch macro. The output is now month as a number
  -- i.e 1-12 instead of a string and the year is now 02 instead of 2002
  !name    = 'Aba_' & !dt.date() & '-' & !dt.monthstring() & '-' & !dt.year().string().after('20') & '_' & !dt.hour() & '-' & !minute & '-' & !dt.second()

  !batPath = object FILE(!this.batchDir.val)
    handle any
      !!alert.error('Batch Path Directory Invalid')
      return
    endhandle

  !logpath = object FILE(!!abaDefaults.logpath)
    handle any
      !!alert.error('Logfile Path Directory Invalid')
      return
    endhandle

  !bat  = !this.batchDir.val & !!slash & !name & '.bat'
  !evar = !this.batchDir.val & !!slash & !name & 'evar.bat'

  -- Remove the batchDir env variable from the command line input
  !mac    = !this.batchDir.val & !!slash & !name & '.mac'
  !maclog = !this.batchDir.val & !!slash & !name & '.log'
  !log    = !!abaDefaults.logpath & !!slash & !name & '.log'

  !this.bat  = object FILE(!bat)
  !this.evar = object FILE(!evar)
  !fullPath  = !this.bat.pathName() & !!slash & !this.bat.entry()
    handle (41,319)
      -- ERROR - Cannot access file or directory
      !!alert.error('Invalid Batch Directory - Please Reinput')
      return
    endhandle

   !this.mac    = object FILE(!mac)
   !this.maclog = object FILE(!maclog)
   !this.log    = object FILE(!log)

   !fullPath    = !this.log.pathName() & !!slash & !this.log.entry()
     handle (41,319)
       -- ERROR - Cannot access file or directory
       !!alert.error('Invalid Log File Directory in ABA Defaults')
       return
     endhandle

   !text[1] =   'File Locations'
   !text.append('==============')
   !text.append(' ')
   !text.append('Batch file Directory is ' & !batPath.fullName())
   !text.append('Log File Directory is   ' & !logpath.fullName())
   !text.append(' ')
   !text.append('File names')
   !text.append('==========')
   !text.append(' ')
   !text.append('Batch file is  ' & !name & '.bat' )
   !text.append('Environment file is  '  & !name & 'evar.bat' )
   !text.append('Batch Macro is ' & !name & '.mac' )
   !text.append('Log File is    ' & !name & '.log' )
   !text.append(' ')

   !number = !this.newDrawings.size() + !this.oldDrawings.size()

   !text.append('Number of drawings to be processed = ' & !number)

   !this.dataPane.val = !text

   !this.dataPane.seteditable(false)

endmethod
-- End of method definition for .openBatFiles()

------------------------------------------------------------------------
--
-- Method:      .setFolder(FILE)
--
-- Description: Set the passed directory
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Directory returned from the browser
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFolder(!directory is FILE)

  -- Set gadget to the selected folder name
  !this.batchDir.val = !directory.fullName()

  -- Reset the stored output directory
  !this.directory = !directory

  -- Reset the output files
  !this.bat.file(!directory.fullName() & '\' & !this.bat.entry())
  !this.evar.file(!directory.fullName() & '\' & !this.evar.entry())
  !this.mac.file(!directory.fullName() & '\' & !this.mac.entry())
  !this.maclog.file(!directory.fullName() & '\' & !this.maclog.entry())

endmethod
-- End of method definition for .setFolder(FILE)

------------------------------------------------------------------------
--
-- Method:      .writeBatFile()
--
-- Description: Gets project data for batch macro to function
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeBatFile()

  !sess = session

  do !a values !sess
    if (!a.iscurrent)then
      !mdb = !a.mdb().name
      break
    endif
  enddo

  !password = !!abaDefaults.string
  !username = !!abaDefaults.ustring
  !proj     = CURRENT PROJECT

  -- build array
  !header = ARRAY()
  !header.append('$@echo off')
  !header.append('Rem Batch file to run ABA Drawings')
  !header.append('setlocal')

  -- Go get all current PDMS enviroment variable settings.
  if (!!abaProcess.defaults) then
    !this.getEnvironment()
    VAR !file FILE /$!this.evar
    !header.append('call $!file')
  endif

  -- The length of the line to start monitor cannot be longer than 119 characters
  !executeLine = '%monexe%\mon logfile ' & !this.maclog.entry() & ' tty ' & !proj.code() & ' ' & !username & '/' & !password & ' $$m"' & !this.mac.entry() & '"'
  !length      = !executeLine.length()

  if !length.gt(119) then
    !!alert.error('The batch file contains a line which is over 119 characters long. The command line will not accept this line, Batch file creation aborted!.')
    return
  endif

  if !!abaProcess.defaults.not() then
    return
  endif

  !header.append(!executeLine)

  !this.bat.writefile('over',!header)
  !this.writeBatMacro(!mdb)
  !this.written = true
  !!abaBatchMode.hide()

  !!alert.message('The File ' & !this.bat & ' has been written')

  -- Open Windows Explorer view of the directory containing the batch files
  !command = 'explorer /root,"' & !this.directory.fullName() & '"'
  SYSCOM '$!command'

endmethod
-- End of method definition for .writeBatchFile()

------------------------------------------------------------------------
--
-- Method:      .writeBatMacro(STRING)
--
-- Description: Gets drawing data for batch macro to function
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeBatMacro(!mdb is STRING)

   -- Initialise variables
   !macroData = ARRAY()
   !moduleObj = object MODULE()

   !units = object COMUNITS(TRUE)
   !distIndex = !units.getDimensionIndex('DIST')
   !boreIndex = !units.getDimensionIndex('BORE')

   !macroData.append('!!abalogging = object ABALOGGING(|' & '$!this.log' & '|)')
   !macroData.append('!!coords     = object COORDSTRANSFER()')

   -- create log file
   !macroData.append(!mdb)
   !macroData.append(!moduleObj.appName)
   !macroData.append('trace off')

   !macroData.append(|-- Define Global variables for units.|)
   !macroData.append(|UNITS $!units.savedUnits[$!distIndex] DIST $!units.savedUnits[$!boreIndex] BORE|)
   !macroData.append(|!!setGlobalFormats()|)

   -- set the appware defaults files for batch mode
   !macroData.append(|!!abadradefaults('%pdmsui%/DFLTS/DRA-PENS')|)
   !macroData.append(|!!abadradefaults('%pdmsui%/DFLTS/PDMS-COLOURS')|)
   !macroData.append(|!!abadradefaults('%pdmsui%/DFLTS/DRA-GEN-LINDEF')|)

   -- set up autonumbering
   !macroData.append(|-- Define Global variables for Auto-Numbering.|)
   !macroData.append(|!!comDefineGlobal(object RULESTORE())|)
   !macroData.append(|!!comDefineGlobal(object NAMOPT())|)
   !macroData.append(|!!batchMode = TRUE|)
   !macroData.append(|!!batchParam[1] = '$!!abaDefaults.defaultsFile.val'|)
   !macroData.append(|!!batchParam[2] = '$!!tmpfile'|)
   !macroData.append(|-- Define DrawingObject list for Log File.|)

   !list = !this.newDrawings
   !list.appendArray(!this.oldDrawings)

   !macroData.appendArray(!this.addDrawingList(!list))
   !macroData.append(|onerror continue|)

   -- Initialise variables
   !macroData.append(|!drawingList = ARRAY()|)
   !macroData.append(|!taskList = ARRAY()|)
   !total = !this.newDrawings.size() + !this.oldDrawings.size()

   -- Set drawings to be processed
   !count = 0
   do !x values !this.newDrawings
       !count = !count + 1
       !macroData.append(|!logline[1] = 'Processing Drawing ($!count of $!total)'|)
       !macroData.append(|!logline[2] = '---------------------------------------------------------------------------------'|)
       !macroData.append(|!!abalogging.addToLog(!logline)|)
       !template = !x.template
       !area = !x.area
       !macroData.append('!newDrg = object ABADRAWING(|' &!x.drwgName & '|,=0/0,' & !x.template & ',' & !x.area & ',' & !this.regi $
       & ',|' & !this.pType & '|)' )

       -- Add processed drwg to the drawing list array
       !macroData.append(|!drawingList.append(!newDrg)|)
       !macroData.append(|!logline[1] = 'Drawing ($!count of $!total) Processed'|)
       !macroData.append(|!logline[2] = '---------------------------------------------------------------------------------'|)
       !macroData.append(|!!abalogging.addToLog(!logline)|)

   enddo

   do !x values !this.oldDrawings
       !count = !count + 1
       !macroData.append(|!logline[1] = 'Processing Drawing ($!count of $!total)'|)
       !macroData.append(|!logline[2] = '---------------------------------------------------------------------------------'|)
       !macroData.append(|!!abalogging.addToLog(!logline)|)
       !template = !x.template
       !area = !x.area
       if !this.regi.unset() then
       !macroData.append('!newDrg = object ABADRAWING(|' & !x.drwgName & '|,' & !x.drwg & ',' & !x.template & ',' & !x.area & ',' & '=0/0' $
       & ',|' & !this.pType & '|)' )
       else
        !macroData.append('!newDrg = object ABADRAWING(|' & !x.drwgName & '|,' & !x.drwg & ',' & !x.template & ',' & !x.area & ',' & !this.regi $
       & ',|' & !this.pType & '|)' )
       endif
       -- Add processed drwg to the drawing list array
       !macroData.append(|!logline[1] = 'Drawing ($!count of $!total) Processed'|)
       !macroData.append(|!logline[2] = '---------------------------------------------------------------------------------'|)
       !macroData.append(|!!abalogging.addToLog(!logline)|)
       !macroData.append(|!drawingList.append(!newDrg)|)
   enddo

   -- Set global tasks
   if (defined(!!abaProcessTask.taskList.taskArray[1])) then

     -- Get the task data
     !macroData.appendArray(!this.getGtaskData())

     -- Run the global tasks
     !macroData.append('!newDrg.abaProcessTask(!taskList,!drawingList)')

   endif

   VAR !computer EVAR COMPUTERNAME

   -- Tidy up
   !macroData.append('savework')
   !macroData.append(|syscom 'net send $!computer Your batch job has finished'|)
   !macroData.append('finish')
   !this.mac.writefile('over',!macroData)

endmethod
-- End of method definition for .writeBatMacro(STRING)
