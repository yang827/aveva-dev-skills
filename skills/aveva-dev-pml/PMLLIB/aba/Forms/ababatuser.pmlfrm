------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  browser()                        -                   Show standard browser
--  init()                           -                   Method to initilize the form
--  setuser()                        -                   Set the defaults settings
------------------------------------------------------------------------

setup form !!abaBatUser

  title 'Batch Username and Password'
  init '!this.init()'

  path down
  text .startbat  'Setup Batch File' width 23 is string

  button .browse 'Browse...' at xmax+1 ymin call |!this.browser()|

  text .username at xmin .startbat '       User Name' width 23 is string

  text .password '       Password ' width 23 noecho is string

  button .ok     '  OK  ' at ymax +.3 call '!this.setuser()' ok
  button .cancel 'Cancel' at xmax form -size ymin cancel

  member .file is FILE

exit

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initilize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  !this.startbat.val = !!abadefaults.startbat
  !this.username.val = !!abadefaults.ustring
  !this.password.val = !!abadefaults.string

  !this.file = object FILE(!this.startbat.val)

endmethod
-- End of method .init()

-----------------------------------------------------------------------
--
-- Method:      .browser()
--
-- Description: Show standard browser
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browser()

  import 'pmlFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !browser         = object PMLFILEBROWSER('OPEN')
  !directory       = !this.file.directory().fullname()
  !seedFile        = !this.file.entry()
  !title           = 'Select Batch File'
  !extensionString = 'bat files (*.bat)|*.bat'

  -- Show Browser
  !browser.show(!directory, !seedFile, !title, false ,!extensionString , 2)

  -- Test for no returned file name
  if (!browser.file().neq('')) then

    !this.file.file(!browser.file())
    !this.startbat.val = !this.file.fullname()

  endif

endmethod
-- End of method .browser()


------------------------------------------------------------------------
--
-- Method:      .setuser()
--
-- Description: Set the defaults settings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setuser()

  !!abadefaults.startbat = !this.startbat.val
  !!abadefaults.ustring  = !this.username.val
  !!abadefaults.string  = !this.password.val

endmethod
-- End of method .setuser()
