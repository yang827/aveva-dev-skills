--
-- Description: List of available drawings for Modification.
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaBrowseSheet()                 -                   Constructor method
--  afterSelectChange(ARRAY)         -                   Callback on grid control after select change of the options grid
--  cancel()                         -
--  filter()                         -
--  goto(string)                     -
--  init()                           -
--  sheetsPopUp(ARRAY)               -                   Pop-up for the choice grid control
--  showSheet(string)                -
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!abaBrowseSheet

  title |ABA Browse Sheets |
  init |!this.init()|
  cancelcall |!this.cancel()|

  bar
    add 'File' .file
    add ' Browse '     .viewmenu
  exit

  menu .viewmenu
    add 'Stored LogFiles'      |!!abaTemplate('FILES','BROWSE')|
  exit

  menu .file
    add 'Re-Load' '!this.init()'
    add 'Close' '!this.cancel()'
  exit

  option .abaClass ' ABA Discipline '  call '!this.init()'width 19
   !!setAbaDrwgTypes(!this.abaClass)

  path down
  container .sheetsGrid nobox pmlNetControl 'NET' at xmin ymax width 60 height 15

  -- Support Filter Gadget
  frame .fFilter | Selection Filter |
    text .filter || at xmin+1 ymax call |!this.init()| width 57 scroll 256 is STRING
  exit

  button .cancel 'Cancel' at x25 ymax.ffilter+0.5 call |!this.cancel()|

  -- Declare the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  member .sheetsControl is NETGRIDCONTROL

  member .headings  is ARRAY
  member .allSheets is ARRAY

  member .mode      is STRING
  member .select    is ARRAY
  member .drawing   is STRING
  member .selOpt    is STRING
  member .selFunc   is STRING

  !this.drawing = 'NONE'

exit

------------------------------------------------------------------------
--
-- Method:      .abaBrowseSheet()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .abaBrowseSheet()

  -- Define pop-up menu
  if ($!!CDADMIN) then
    !menu = !this.newMenu('sheetsPopUp')
      !menu.add('callback', 'Modify Template View(s)', |!this.goto('SHEET')|,'SHEET')
      !menu.add('callback', 'Modify Template Sheet', |!this.goto('SHTMPL')|,'SHTMPL')
      !menu.add('callback', 'Modify Template Drawing', |!this.goto('DRTMPL')|, 'DRTMPL')
  endif

  -- Create instances of the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  !this.sheetsControl = object NETGRIDCONTROL()

  -- Add .net control to the containers
  !this.sheetsGrid.control = !this.sheetsControl.handle()

  -- Add PML event handlers to .net controls
  if ($!!CDADMIN) then
    !this.sheetsControl.addEventHandler('onPopup', !this, 'sheetsPopUp')
  endif
  !this.sheetsControl.addEventHandler('afterSelectChange', !this, 'afterSelectChange')

  -- Set grid visual attributes
  !this.sheetsControl.columnExcelFilter(false)
  !this.sheetsControl.outlookGroupStyle(false)
  !this.sheetsControl.fixedRows(false)
  !this.sheetsControl.gridHeight(1000.0)
  !this.sheetsControl.editableGrid(false)
  !this.sheetsControl.singleRowSelection(true)
  !this.sheetsControl.columnExcelFilter(false)
  !this.sheetsControl.fixedHeaders(false)
  !this.sheetsControl.headerSort(true)
  !this.sheetsControl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Name')
  !this.headings.append('Description')
  !this.headings.append('Template')
  !this.headings.append('Area')

endmethod
-- End of method definition for .abaBrowseSheet()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- initialise variables
  !savePos = !!ce
  !rowSet  = ARRAY()
  !this.allSheets.clear()

  -- The filter is unset so set it to *
  if !this.filter.val.eq('') then
    !this.filter.val = '*'
  endif

  if !this.shown().not() then

    -- Allow drawing function selection
    !this.abaClass.select('DTEXT',!!abaProcess.selOpt)

  endif

  !this.selOpt  = !this.abaClass.selection('DTEXT')
  !this.selFunc = !this.abaClass.selection('RTEXT')

  -- Get all available sheets
  if !this.abaClass.selection('DTEXT') eq 'All' then

    VAR !allSheets COLL ALL SHEE WITH SPPURP EQ 'ABAT'
    !this.formtitle = 'ABA Browse Sheets ( All Drawings )'

  else

    !this.formtitle = 'ABA Browse Sheets ( ' & !this.selOpt & ' )'

    VAR !allSheets COLL ALL SHEE WITH FUNC OF OWNER  EQ '$!this.selFunc' AND SPPURP EQ 'ABAT'
    VAR !allSheets APPEND COLL ALL SHEE WITH FUNC OF OWNER  EQ '$!this.selOpt' AND SPPURP EQ 'ABAT'

    !allSheets.unique()

  endif

  VAR !allNames EVAL NAME FOR ALL FROM !allSheets

  -- Sort drawing templates by name
  !allSheets.reindex(!allNames.sortedIndices())

  -- Build the row data set
  do !sheet val !allSheets

    -- Initialise variables
    !sheetRefe = !sheet.dbref()
    !rowData    = ARRAY()

    skip if (!sheetRefe.name.matchwild(!this.filter.val).not())

    -- Build row data
    !rowData.append(!sheetRefe.owne.flnn)
    !rowData.append(!sheetRefe.title)

    -- Test for valid link reference
    if (!sheetRefe.linkref.badref()) then
      !rowData.append('Bad Reference')
    else
      !rowData.append(!sheetRefe.linkref.flnn)
    endif

    -- Test for valid area reference
    if (!sheetRefe.darref.badref()) then
      !rowData.append('Bad Reference')
    else
      !rowData.append(!sheetRefe.darref.flnn)
    endif

    -- Add row data to row set array
    !rowSet.append(!rowData)

    -- Store drtmpl reference
    !this.allSheets.append(!sheetRefe)

  enddo

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.sheetsControl.bindToDataSource(object NETDATASOURCE('Sheets', !this.headings, !rowSet, '^Name'))

  PROMPT ''

  -- Select and display the first or the passed sheet
  if (!this.drawing eq 'NONE') then
    !this.sheetsControl.selectRow(1)

  else
    !this.sheetsControl.selectRow(!this.allSheets.findFirst(!this.drawing.dbref()))

  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .afterSelectChange(ARRAY)
--
-- Description: Callback on grid control after select change of the options grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .afterSelectChange(!array is ARRAY)

  -- Select the drtmpl
  if (!this.sheetsControl.getSelectedRowTags().set()) then

    -- Get the selected sheet reference as a string
    !sheetStrg = !this.allSheets[!this.sheetsControl.getSelectedRowTags()[1].real()].refe.string()

    -- Display the sheet
    !!abaAddGraphElem(!sheetStrg)
      handle any
      endhandle

    -- Store this one
    !this.drawing = !sheetStrg

  endif

endmethod
-- End of method definition for .afterSelectChange(ARRAY)

------------------------------------------------------------------------
define method .goto(!choice is string)

  -- Get the selected sheet
  !sheeRefe = !this.allSheets[!this.sheetsControl.getSelectedRowTags()[1].real()]

  -- For a sheet
  if (!choice.eq('SHEET')) then

    -- Test for valid linkref
    if (!sheeRefe.owne.linkref.badref()) then
      !!alert.error('The drawing ' & !sheeRefe.owne.flnm & ' has a bad link reference. Please contact your System Administrator.')

    else

      -- Access the template and modify the views
      !!ce = !sheeRefe.owne.linkref
      !!abaTemplate('VIEW','MODIFY')

    endif

  elseif (!choice.eq('SHTMPL')) then

    -- Test for valid linkref
    if (!sheeRefe.linkref.badref()) then
      !!alert.error('The sheet ' & !sheeRefe.flnm & ' has a bad link reference. Please contact your System Administrator.')

    else

      -- Access the sheet template for modification
      !!ce = !sheeRefe.linkref
      !!abaTemplate('SHEET','MODIFY')

    endif

  elseif (!Choice eq 'DRTMPL') then

    -- Test for valid linkref
    if (!sheeRefe.linkref.badref()) then
      !!alert.error('The sheet ' & !sheeRefe.flnm & ' has a bad link reference. Please contact your System Administrator.')

    else

      -- Access the drawing template for modification
      !!ce = !sheeRefe.linkref.owne
      !!abaTemplate('DRAWING','MODIFY')

    endif

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .sheetsPopUp()
--
-- Description: Pop-up for the choice grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sheetsPopUp(!array is ARRAY)

  -- Show the pop-up
   !this.sheetsGrid.popup = !this.sheetsPopUp
   !this.sheetsGrid.showPopup(!array[0], !array[1])

endmethod
-- End of method definition for .sheetsPopUp()

------------------------------------------------------------------------
define method .showSheet(!Selection is string)

   if (!selection ne 'desc') then
   var !sh coll all shee for $!Selection
   handle (2,107)
     -- Undefined reference =16409/11246
     !this.init()
     !sel = !this.SheetList.selection('RTEXT')
     var !sh coll all shee for $!sel
   endhandle
   !!abaAddGraphElem(!sh[1])
   !!ce = !sh[1].dbref()
   endif

endmethod

------------------------------------------------------------------------
define method .filter()

   !match = '*$!this.filter.val*'

   if (!name.matchwild(!match).not()) then
    return
   endif

endmethod

------------------------------------------------------------------------
define method .cancel()

  !!abaBrowseSheet.hide()

  if (!this.mode eq 'POP') then
    show !!abaProcess
  endif

endmethod
------------------------------------------------------------------------
