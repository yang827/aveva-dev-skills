--   Module:
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         14 June 1999
--
--
-- Description:
-- Create OVERlayer layers to represent the areas
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form settings
--  callCreateStraight(ARRAY,STRING,STRING) -
--  callLayePurp()                   -
--  cursorPosition(BOOLEAN)          -
--  getCentre(DBREF)                 POSITION            Get centre position of the passed outline
--  init()                           -                   Method to initialise the form
--  setDefXYPosition()               -
-- Members
--   [Name]           [Description]
--    overRefe         OVERlayer reference
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

setup form !!abaBuildKeyplan

  !this.initcall = '!this.init()'
  title |Add Hatched Areas to an Overlay|

  path right

  button .currElem at x0.5 y0.2 | CE | call |!this.init()|
  para   .nameText text |Name |
  para   .dbPos width 30 lines 1

  -- Body
  frame .selection |Select Hatching Pens| at x0 ymax+0.2

    para .pNlpn at text |Note line| width 10
    !!draColStyle.setup('NLPN', 1, '')

    para .pFpen at xmin.pNlpn ymax+0.2 text |Hatch pattern| width 10
    !!draColStyle.setup('FPEN', 1, '')

  exit

  path down

  frame .posFrame |Select Text Attributes|

    text .text |Text| width 28 scroll 50 is STRING

    para .posTxt   at xmax+3 ymin text 'Position'

    text .xPos |X| at xmax-2 ymin call '!this.cursorPosition(false)' width 8 is REAL format !!distanceFmt

    text .yPos |Y| at xmax+1 ymin call '!this.cursorPosition(false)' width 8 is REAL format !!distanceFmt

    button .cursor |Cursor...| at xmax+1.5 ymin call |!this.cursorPosition(true)|

    para .pTpen at xmin.text ymax.text-0.5 text '' width 1
    !!draColStyle.setup('TPEN', 1, '')

    para _textf at xmax+2 ymin text 'Font' width 4

    path right
    CALLDRG FFONTS !!abaDrtmplAtt

    para .cheiTxt at xmax+3 ymin text 'Height'
    text .chei at xmax-1 ymin width 4 is REAL format !!distanceFmt

  exit

  frame .dirFrame |Keyplan View Direction| at xmax+1 ymin  width 35 height 3.65

    option .direction |Direction| at xmin+1 width 6

    para .explain at xmin+1 ymax+0.2 text 'The hashed areas will be built orthogonal to this direction of view' width 30 lines 2

  exit

  -- Actions
  button .apply   | Apply | at x0 ymax+0.5 call |!this.apply()|
  button .dismiss |Dismiss| at xmax form-size cancel

  -- Members
  member .overRefe   is DBREF
  member .coordinate is STRING

-- End of form definition
exit

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Read the current coordinate system
  VAR !coordinate COORDINATE
  !this.coordinate = !coordinate

  -- Test current element for OVER
  OVER
    handle (2,111)
      return error 12 'Must be at OVER or below to build the keyplan'
    elsehandle none
      VIEW 1
        handle (2,113)
          -- List exhausted
          !!alert.warning('The overlay does not contain a VIEW. Please create one and try again.')
          return
        elsehandle none
          !vDir = !!ce.dir.string().before(' WRT')
          OWNE
        endhandle
    endhandle

  -- Set OVER name in gadget
  !this.dbPos.val    = !!ce.flnm
  !this.overRefe     = !!ce
  !this.text.val     = 'This Drawing'
  !this.setDefXYPosition()

  -- Manage colour & style setup
  !!draColStyle.onInit()
  !!draColStyle.updateGadgets('TPEN')
  !!draColStyle.updateGadgets('NLPN')
  !!draColStyle.updateGadgets('FPEN')
  !!draColStyle.loadUserStyles()
  !!draColStyle.setColour('TPEN', 1)
  !!draColStyle.setColour('NLPN', 1)
  !!draColStyle.setStyle('NLPN', 'Solid')
  !!draColStyle.setColour('FPEN', 1)
  !!draColStyle.setStyle('FPEN', 'Off')

  -- Initialise Font gadget _FONT
  $M "%PDMSUI%/DRA/GEN/IFONTS" FONT

  -- Character height
  !this.chei.val = 3mm

  -- Build direction
  -- For ENU
  if (!coordinate.eq('ENU')) then
    !dtext[1] = 'East'
    !dtext[2] = 'West'
    !dtext[3] = 'North'
    !dtext[4] = 'South'
    !dtext[5] = 'Down'
    !rtext[1] = 'E'
    !rtext[2] = 'W'
    !rtext[3] = 'N'
    !rtext[4] = 'S'
    !rtext[5] = 'D'
    !this.direction.dtext = !dtext
    !this.direction.rtext = !rtext

  -- For XYZ
  else
    !dtext[1] = 'X'
    !dtext[2] = '-X'
    !dtext[3] = 'Y'
    !dtext[4] = '-Y'
    !dtext[5] = '-Z'
    !this.direction.dtext = !dtext
 endif

 -- Attempt to select the current view direction
 if (!this.direction.rtext.find(!vDir).set()) then
   !this.direction.select('RTEXT', !vDir)
 else
   !this.direction.val = 5
 endif

endmethod
-- End of method .init()

------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Apply form settings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- Initialise variables
  !!draColStyle.formName = !this.name()

  -- Get units
  !units = object COMUNITS(TRUE)
  !distIndex = !units.getDimensionIndex('DIST')
  onerror golabel /reset
  if (!units.savedUnits[!distIndex] eq 'in' or !units.savedUnits[!distIndex] eq 'FINC' or !units.savedUnits[!distIndex] eq 'ft') then
    units mm dist units mm bore
  endif

  -- Read pen choices
  !rTPEN = !!draColStyle.getData('TPEN')
  !rNLPN = !!draColStyle.getData('NLPN')
  !rFPEN = !!draColStyle.getData('FPEN')

  -- Run layer build, with arguments for NLColour, NLStyle, FColour, Fstyle
  !allOutl = !!abaBuildKeyplan(!this.overRefe, !rNLPN[2], !rNLPN[3], !rFPEN[2], !rFPEN[3], !this.direction.selection())

  if (!rFPEN[3].eq('OFF')) then

    OVER
    !units.restoreSavedBoreDist()

    return

  else

    -- Run Layer purpose method
    !this.callLayePurp()

    -- Run Creation of straights method
    !this.callCreateStraight(!allOutl, !rTPEN[2], !rNLPN[3])

  endif

  label /reset
  !units.restoreSavedBoreDist()

endmethod
-- End of method .apply()

--------------------------------------------------------------------
define method .callLayePurp()
--------------------------------------------------------------------

  --Method to add layer purposes for keyplans
  !p[1]='A'
  !p[2]='B'
  !p[3]='C'
  !p[4]='D'
  !p[5]='E'
  !p[6]='F'
  !p[7]='G'
  !p[8]='H'
  !p[9]='I'
  !p[10]='J'
  !p[11]='K'
  !p[12]='L'
  !p[13]='M'
  !p[14]='N'
  !p[15]='O'
  !p[16]='P'
  !p[17]='Q'
  !p[18]='R'
  !p[19]='S'
  !p[20]='T'
  !p[21]='U'
  !p[22]='V'
  !p[23]='W'
  !p[24]='X'
  !p[25]='Y'
  !p[26]='Z'

  --Build layer purpose array
  !purp = ARRAY()
   do !h index !p
    do !j index !p
      do !i index !p
       !a = !p[1] & !p[!h] & !p[!j] & !p[!i]
       !purp.append(!a)
      enddo
    enddo
   enddo

  --Apply Layer purpose to layers
  !!ce = !this.overRefe
  VIEW 1
  VAR !coll COLL ALL LAYE FOR CE
  do !lay value !coll
    $!lay
    PURP unset
  enddo

  do !k index !coll
    laye $!k
    PURP $!purp[$!k]
  enddo

  !!ce = !this.overRefe

endmethod

--------------------------------------------------------------------
define method .callCreateStraight(!allOutl is ARRAY, !colour is STRING, !style is STRING)
--------------------------------------------------------------------

  --Run this after keyplan LAYERS have been created to
  --add straights from the texp 'THIS DRAWING' to centre of each area OUTLINE
  !this.overRefe

  VIEW 1
  !adeg = adeg
  VAR !viewDirL VIEWDIR L
  !vreg = VREGION

  OWNE
  !xPosS    = !this.xPos.val
  !yPosS    = !this.yPos.val
  !xPosL    = !vreg[1] + 10mm
  !noteName = !this.overRefe.name & '/NOTE1'

  !!ce = !noteName.dbref()
    handle any
    elsehandle none
      DELETE NOTE
    endhandle

  NEW NOTE $!noteName
  !note  = !!ce

  NEW TEXP AT X $!xPosS Y $!yPosS
  BTEXT '#< $!this.text'
  CHEI $!<this.chei>
  TXCOLO $!colour
  !texp = !!ce

  -- Calculate the difference between the text chei and lhei, to find the text underline position
  !underline  = !!ce.chei - !!ce.lhei

  -- Process each outline
  do !outlRefe values !allOutl

    !!ce     = !outlRefe
    !outlPos = !this.getCentre(!outlRefe)

    !lineStart = 'X ' & !texp.ptrf.xypo.east & ' Y ' & !texp.ptrf.xypo.north
    !lineEnd   = !outlPos.string().before(' WRT')

    NEW STRA FPT $!lineStart TPT POS $!lineEnd
     NLColour $!colour
     NLStyle $!style

    -- Move the from point to match the text underline position
    FPT BY Y $!underline

  enddo

  !!ce = !note

  -- Place & Position North arrow
  if (!this.direction.val.eq(5)) then

    !yPosSymb = !vreg[4] - ((!vreg[4] - !vreg[2]) / 2)

    NEW SYMB AT X $!xPosL mm y $!yPosSymb mm

    TMRF /DRA/MAS/SYMBOLS/GEN/MISC/P-NARR
      handle (64,836)
        -- The referenced template and the SYMB element have incompatible font settings
        TMRF /TT/DRA/MAS/SYMBOLS/GEN/MISC/P-NARR
      elsehandle any
        -- Undefined name
        !!alert.error(!!error.text)
        return
      endhandle

    XYSC 0.5 0.5
    ADEG $!adeg

    if (!viewDirL.eq ('N') or !viewDirL.eq('S')) then
      BY X15mm
      BY Y45mm
    endif

  endif

  !!ce = !this.overRefe

endmethod


------------------------------------------------------------------------
--
-- Method:      .getCentre(DBREF)
--
-- Description: Get centre position of the passed outline
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1          DBREF       The OUTL to be processed
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getCentre(!box is DBREF) is POSITION

  -- Initialise variables
  !vrtxPoint1 = !box.mem[1].ptrf
  !vrtxPoint2 = !box.mem[3].ptrf
  !line       = object LINE()

  -- Build line for diagonal of the OUTL
  -- Start
  if (!vrtxPoint1.type.eq('WPOS')) then
    !line.startPosition = !vrtxPoint1.pos
  else
    !line.startPosition = !vrtxPoint1.xypo
  endif

  -- End
  if (!vrtxPoint2.type.eq('WPOS')) then
    !line.endPosition = !vrtxPoint2.pos
  else
    !line.endPosition = !vrtxPoint2.xypo
  endif

  -- Return line midpoint which equals the OUTL centre
  return !line.proportion(0.5)

endmethod
-- End of method .apply()

--------------------------------------------------------------------------------------------
define method .cursorPosition(!type is BOOLEAN)

  -- its a cursor position
  if !type then
    prompt off
    prompt load escape |Identify point where text is to be created|
    var !pos SHPO @
    handle (61,528)
      -- exit from sub-mode
       prompt on
       return
    elsehandle (64,409)
      -- outside sheet limits
       prompt on
       return error 1 |Text block NOTE position lies outside sheet boundary!!|
    endhandle
     prompt on
     !newpos = !pos.position(!!distanceFmt)
     !this.xPos.val = !newpos.east
     !this.yPos.val = !newpos.north
  endif

  --Check if Texp exists. If it does Move it
  !noteName = !this.overRefe.name  & '/NOTE1'
  !!ce = !noteName.dbref()
    handle any
      return
    elsehandle None
      TEXP1
      !btex = BTEX
      !this.text.val = !btex
      if Matchwild(!btex,'*This Drawing*') then
        !xPosS = !this.xPos.val
        !yPosS = !this.yPos.val
        AT X $!xPosS Y $!yPosS
      endif
    endhandle

endmethod

-----------------------------------------------------------
define method .setDefXYPosition()

  VIEW 1
  !vreg = VREGION

  OWNE

  !xPosS = !vreg[3] - 40mm
  !yPosS = !vreg[2] + 5mm

  !this.xPos.val = !xPosS
  !this.yPos.val = !yPosS

  !noteName = !this.overRefe.name  & '/NOTE1'

  !!ce = !noteName.dbref()
    handle any
      return
    elsehandle None
      TEXP1
      !btex = BTEX
      !this.text.val = !btex
      if (matchwild(!btex,'*This Drawing*')) then
        !this.xPos.val = !!ce.ptrf.xyPos.east
        !this.yPos.val = !!ce.ptrf.xyPos.north
      endif
    endhandle

  !!ce = !this.overRefe

endmethod
