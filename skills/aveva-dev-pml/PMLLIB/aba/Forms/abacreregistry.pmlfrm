--
--
-- Description:
-- Create the hierarchy for the appware to function
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  create()                         -
--  deptName()                       -
--  init()                           -
--  setField()                       -
------------------------------------------------------------------------

setup form !!abaCreRegistry blocking
--blocking
title |Create Aba Hierarchy|
init |!this.init()|

-- Selection Area
-- --------------

  frame .dtbs | Departments | at x0

    path down
    list .dbs at x1 y1 call |!this.setField()| single width 25 height 5
    text .dept 'DEPT' call |!this.deptname()| width 23 string
    para .slash text 'REGI'
    path right
    text .regi '/' width 21 string

  exit

-- Action buttons
-- --------------

  path right
  button .ok     | Apply | at x0 ymax.dtbs+0.5 call |!this.create()| ok
  button .cancel |Dismiss| at xmax form-size cancel

-- End of form definition
member .registry is string
exit

--------------------------------------------------------------------------------------------------------
define method .setField()
--------------------------------------------------------------------------------------------------------
--
   !this.dept.val = !this.dbs.selection()
--
endmethod

--------------------------------------------------------------------------------------------------------
define method .init()
--------------------------------------------------------------------------------------------------------

  -- Set the Registry name from Process Form.

  !this.regi.val = !this.registry

  -- Initialise variables
  !draftDbs = array()

  -- Read current session
  !session = current session
  !mdb  = !session.mdb()
  !dbs  = !mdb.current()
  !mode = !mdb.mode()

  -- Get all draft db's open in RW
  do !index ind !dbs

    -- Look for draft type
    !db = !dbs[!index]
    if (!db.type.upCase().eq('PADD') and !db.foreign.upCase().eq('LOCAL') and !mode[!index].eq('RW')) then

      !draftDbs.append(!dbs[!index].name)

    endif

  enddo

-- Now make a list of all available departments with ReadWrite access
     !deptList = array()
     var !allDepts coll all dept
     do !x index !allDepts
        $!allDepts[$!x]
        var !dbn dbname
        !num = !draftDbs.findFirst(!dbn)
        if (!num ne 0) then
            -- Check to see if DDL version is of correct one.
            var !ver ddl
            !verspl = !ver.split()
            !mark = !verspl.findfirst('Mark')
            !markno = !verspl[!mark.real() + 1].real()
            handle any
              skip
            endhandle
            if !markno ge 112 then
              !deptlist.append(!allDepts[!x].dbref().name)
            endif
        endif
     enddo

  -- Populate list gadget
  if (!DeptList.size() ne 0) then
      !this.dbs.dtext = !DeptList
      !this.dept.val  = !this.dbs.selection()
  else
      !!alert.error('No Valid Database Version Available')
  endif

endmethod

--------------------------------------------------------------------------------------------------------
define method .deptName()
--------------------------------------------------------------------------------------------------------
     if (!this.dept.val.substring(1,1) eq '/') then
     !element = !this.dept.val
     else
     !element = '/' & !this.dept.val
     endif

     $!element
     handle (2,109)
       -- Undefined name /ABA_Department
       /*
       NEW DEPT $!element
         handle (41,8)
              --  Cannot create a DEPT at this level.
              /*
              NEW DEPT $!element
         endhandle
     elsehandle NONE
     if (!!ce.type.upcase().neq('DEPT')) then
         !!alert.error('Element name $!this.dept.val is not a department')
         !this.dept.setfocus()
         return
     endif
     endhandle
     !this.dept.val = !element

endmethod

--------------------------------------------------------------------------------------------------------
define method .create()
--------------------------------------------------------------------------------------------------------

  -- Find the point world within the selected db
  -- This is too ensure that the liby is created at the highest level

  -- Position ones self at the department.
     $!this.dept.val

  -- Create the registry at this level.
     NEW REGI /$!this.regi.val
  -- Create the elements defined in the defaults file
     !!abaprocess.Reginame = !!ce
  -- Rerun the process form OK action.
     !!abaProcess.Run('ALL')

endmethod
