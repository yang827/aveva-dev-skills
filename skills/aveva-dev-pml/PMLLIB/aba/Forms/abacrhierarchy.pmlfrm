--
-- Description:
-- Create the hierarchy for the appware to function
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  create()                         -
--  init()                           -
------------------------------------------------------------------------

setup form !!abaCrHierarchy
--blocking
title |Create Aba Hierarchy|
init |!this.init()|

-- Selection Area
-- --------------

  frame .dtbs | Databases | at x0

    list .dbs at x1 y1 single width 25 height 5

  exit

-- Action buttons
-- --------------

  path right
  button .ok     | Apply | at x0 ymax.dtbs+0.5 call |!this.create()| ok
  button .cancel |Dismiss| at xmax form-size cancel

  -- Font to be used when creating the hierarchy
  member .setFont  is STRING

-- End of form definition
exit

--------------------------------------------------------------------------------------------------------
define method .init()
--------------------------------------------------------------------------------------------------------

  -- Initialise variables
  !draftDbs = ARRAY()

  -- Read current session
  !session = current session
  !mdb = !session.mdb()
  !dbs = !mdb.current()
  !mode = !mdb.mode()

  -- Get all draft db's open in RW
  do !index ind !dbs

    -- Look for draft type
    !db = !dbs[!index]
    if (!db.type.upCase().eq('PADD') and !db.foreign.upCase().eq('LOCAL') and !mode[!index].eq('RW')) then

      !draftDbs.append(!dbs[!index].name)

    endif

  enddo

  -- Populate list gadget
  !this.dbs.dtext = !draftDbs
  !this.dbs.rtext = !draftDbs

endmethod

--------------------------------------------------------------------------------------------------------
define method .create()
--------------------------------------------------------------------------------------------------------

  -- Initialise variables
  !sylbExist   = false
  !tasklbExist = false
  !fontValue   = !this.setFont

  -- Find the point world within the selected db
  -- This is too ensure that the liby is created at the highest level
  !world = /*
  !!ce = !world
  do !count from 1 to !world.mcount

    !!ce = !world
    $!count
    !currElem = !!ce
    var !dbName dbname
    if (!dbName.eq(!this.dbs.selection('RTEXT')) and !currElem.type.upCase().eq('PTWL')) then

      -- We are positioned at the correct point
      break

    endif

  enddo

  -- Create the elements defined in the defaults file
  NEW LIBY $!!abaDefaults.alib.val
    handle (41,12)
      delete DLLB
      !!ce = !!abaDefaults.alib.val.dbref()
    endhandle
  SpPURP ABAR
  FONT $!fontValue
    handle any
    endhandle

  NEW LIBY $!!abaDefaults.libr.val
    handle (41,12)
      delete LIBY
      !!ce = !!abaDefaults.libr.val.dbref()
    endhandle
  SpPURP ABAT
    handle (41,232)
      delete LIBY
      !!alert.error('The database is not of the correct version in which to create the libraries - See your System Administrator')
      return
    endhandle
  FONT $!fontValue
    handle any
    endhandle

  NEW DRTMLB $!!abaDefaults.dlib.val
    handle (41,12)
      delete DRTMLB
      !!ce = !!abaDefaults.dlib.val.dbref()
    endhandle
  SpPURP ABAT

  NEW DLLB $!!abaDefaults.disl.val
    handle (41,12)
      delete DLLB
      !!ce = !!abaDefaults.disl.val.dbref()
    endhandle
  SpPURP ABAT

  NEW SHLB $!!abaDefaults.keyp.val
    handle (41,12)
      delete SHLB
      !!ce = !!abaDefaults.keyp.val.dbref()
    endhandle
  SpPURP ABAT

  NEW SYLB $!!abaDefaults.symb.val
    handle (41,12)
      delete SYLB
      !!ce = !!abaDefaults.symb.val.dbref()
      !sylbExist = true
    endhandle
  SpPURP ABAT

  -- Load default symbols for this application
  if (not !sylbExist) then
    !!abaLoadSymbols(!fontValue)
  endif

  NEW TRLB $!!abaDefaults.labl.val
    handle (41,12)
      delete TRLB
      !!ce = !!abaDefaults.labl.val.dbref()
    endhandle
  SpPURP ABAT

  NEW TASKLB $!!abaDefaults.task.val
    handle (41,12)
      delete TASKLB
      !!ce = !!abaDefaults.task.val.dbref()
      !tasklbExist = true
    endhandle
  SpPURP ABAT

  -- Load default tasks for this application
  if (not !tasklbExist) then
    !!abaLoadTasks()
  endif

  -- Return to liby
  LIBY

  -- Set defaults form create button focus
  !!abaDefaults.create.active = FALSE
  --Set the gadget status colours
  !!abaDefaults.validateGadgets()

  -- Reload process form since will have failed on INIT with non-existent libraries
  pml reload form !!abaProcess

endmethod
