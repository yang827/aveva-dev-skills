--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -
--  init()                           -
--  setatts()                        -

setup form !!abacrtrst
init '!this.init()'
Title 'Create Tag Rule Set'
path down
text .Name 'Name        ' width 50 name
text .desc 'Description ' width 50 is string
button .apply  ' Apply ' call '!this.setatts()' ok
button .cancel 'Dismiss' at xmax form - size ymin call |!this.cancel()| cancel
member .element is dbref
member .mode is boolean
exit

--------------------------------------------------------------
define method .init()
--------------------------------------------------------------
  if(!this.mode.not())then
    !this.element = !!abatagrules.trst.selection('rtext').dbref()
    $!this.element
    !this.name.val = name
    !this.desc.val = func
    !this.formTitle = !this.FormTitle.replace('Create','Modify')
  else
    !this.formTitle = !this.FormTitle.replace('Modify','Create')

  $!!abadefaults.labl.val
  new trst
  !this.element = !!ce.ref
  same
  do !a from 1
    !name = !!ce.name &  '/trst'  & !a
    var !test exists $!name
    if(!test.match('TRUE')gt 0)then
       skip
    else
       break
    endif
  enddo
  !this.name.val = !name
  !this.desc.val = 'unset'
 endif
endmethod

-----------------------------------------------------------------
define method .setatts()
-----------------------------------------------------------------
  $!this.element
  !newName = !this.name.val
  if(!newName.subString(1,1) neq '/') then
      !newName = '/' & !this.name.val
  endif
  if(!this.element.name neq !newName)then
   name $!newName
  endif
  SpPURP ABAT
--BC Mod Check For Desc unset
  if(!this.desc.val.unset()) then
    !!Alert.error ('You must set a Description')
    !this.cancel()
    show !!abacrtrst
  else
    func |$!this.desc.val|
    endif
  !!abatagrules.init()
endmethod

define method .cancel()
  if(!this.mode.not())then
   return
  else
    $!this.element
    delete trst
  !!abatagrules.init()
  endif
endmethod
