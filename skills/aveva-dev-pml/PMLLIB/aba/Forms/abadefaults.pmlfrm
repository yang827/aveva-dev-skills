--
-- File:            abaDefaults.pmlfrm
--   Type:          Form Definition
--   Group:
--     Keyword:
--   Module:
--   Replaces:
--
-- Author:          Martin Wright
-- Created:         12 May 1999
--
--
-- Description:
-- Set Aba defaults
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaDefaults()                    -                   Constructor method
--  checkName(GADGET,STRING)         -
--  checkName(STRING)                -
--  entry()                          -
--  fileList()                       -
--  fixedWidthString(STRING,STRING)  STRING
--  getdefaults()                    BOOLEAN
--  hierarchy()                      -
--  init()                           -                   Method to initilize the form
--  loadDefaults()                   -
--  readDefaults()                   -
--  resetGadget()                    -
--  save(STRING,FORM)                -
--  saveGadget()                     -
--  saveSection(ARRAY,STRING)        ARRAY
--  setDefault(GADGET,STRING)        -
--  setFont(STRING)                  -                   Create the batch macro
--  validategadgets()                -                   set the button colours for the ce buttons
--  writeEntry()                     -
--
setup form !!abaDefaults at xr .5 yr .5

  title 'ABA Defaults'
  init '!this.init()'
  !this.initcall = |!this.init()|
  cancelcall |!this.save('CLOSE',!!abaDefaults)|

  -- Get true-type fonts max width
  if (defined(!!fontManager)) then
    !fontWidth = !!fontManager.ttfFace.width()
  else
    !fontWidth = 12
  endif

  path down

  bar
   add 'File' .filemenu
  exit

  menu .filemenu
    add 'Load Tasks'          |!!abaTasks.load()|
    add 'Save Defaults'       |!this.save('SAVE',!!abaDefaults)|
    add 'Save Defaults As...' |!this.save('NEWNAME',!!abaDefaults)|
    add separator
    add 'Close'               |!this.save('CLOSE',!!abaDefaults)|
  exit

  button .deffile ' Defaults File  ' call '!this.loadDefaults()' at x1 y0

  text .defaultsFile '' call |!this.readDefaults()|  at xmax.deffile + 1 y0 width 43 name

  button .defload 'Load' call '!this.readDefaults()' at xmax.defaultsFile + 1 ymin.defaultsFile

  frame .desc 'Hierarchy Positioning' at x 0 y 1.0

    text .libr   '       Library ' call |!this.checkName(!this.libr.val)| at y 1 width 38 name

    path right
    button .ce1 'CE' call '!this.setDefault(!this.libr,|LIBY|)'
    para .type1 text 'LIBY'
    text .dlib  at xmin.libr ymax '      Template ' call |!this.checkName(!this.dlib,'LIBY,DRTMLB')| width 38 name
    button .ce2 'CE' call '!this.setDefault(!this.dlib,|LIBY,DRTMLB|)'
    para .type2 text 'LIBY,DRTMLB'
    text .alib  at xmin.dlib ymax '          Area ' call |!this.checkName(!this.alib,'LIBY')| width 38 name
    button .ce3 'CE' call '!this.setDefault(!this.alib,|LIBY|)'
    para .type3 text 'LIBY'
    text .disl at xmin.dlib ymax         'Classification ' call |!this.checkName(!this.disl,'DLLB')| width 38 name
    button .ce4 'CE' call '!this.setDefault(!this.disl,|DLLB|)'
    para .type4 text 'DLLB'
    text .keyp at xmin.dlib ymax        '      Keyplans ' call |!this.checkName(!this.keyp,'SHLB')| width 38 name
    button .ce5 'CE' call '!this.setDefault(!this.keyp,|SHLB|)'
    para .type5 text 'SHLB'
    text .symb at xmin.dlib ymax        '       Symbols ' call |!this.checkName(!this.symb,'SYLB')| width 38 name
    button .ce6 'CE' call '!this.setDefault(!this.symb,|SYLB|)'
    para .type6 text 'SYLB'
    text .labl at xmin.dlib ymax         '     Labelling ' call |!this.checkName(!this.labl,'TRLB')| width 38 name
    button .ce7 'CE' call '!this.setDefault(!this.labl,|TRLB|)'
    para .type7 text 'TRLB'
    text .task at xmin.dlib ymax         '         Tasks ' call |!this.checkName(!this.task,'TASKLB')| width 38 name
    button .ce8 'CE' call '!this.setDefault(!this.task,|TASKLB|)'
    para .type8 text 'TASKLB'

    para .crtxt  at xmin.task ymax+0.5 text 'Create Hierarchy'
    button .create at xmax.crtxt-4 ymin.crtxt-0.1 pixmap width 25 height 25 call |!this.hierarchy()|

    -- Font selection
    rtoggle .fontOPT1 |Standard | at xmax+3 ymin.crtxt  call |!this.setFont('NATIVE')|
    rtoggle .fontOPT2 |True-Type| at xmax ymin        call |!this.setFont('TRUETYPE')|

    option  .fonts at xmax ymin width $!fontWidth

    button .batch 'Batch User...' at x20    ymax+0.5 call |show !!abaBatUser cen xr .5 yr .6|
    button .input 'Input File...' at xmax+5 ymin     call |!this.fileList()|

  exit

  path down
  frame .logframe 'Logging/Batch Output'
    text   .logf  'Logfile Location   ' call |!this.logPath = !this.logf.val !this.changed = true| width 51 name
    text   .batf  'Batchfile Location ' call |!this.batPath = !this.batf.val !this.changed = true| width 51 name
  exit

  -- Pixmaps
  !this.create.addPixmap(!!pml.getPathName('trafficlight_red.png'),!!pml.getPathName('trafficlight_red.png'),!!pml.getPathName('trafficlight_green.png'))

  member .logPath      is STRING
  member .batPath      is STRING
  member .ustring      is STRING
  member .string       is STRING
  member .startbat     is STRING
  member .autonumber   is STRING
  member .gadgetValue  is ARRAY
  member .defString    is STRING
  member .file         is FILE

  -- Set flag for ending PDMS session because defaults have changed.
  member .changed      is BOOLEAN

  !this.defaultsFile.val = '%PDMSDFLTS%/DRA-ABA-DEFAULTS'
  !this.defString        = '   1'
  !this.ustring          = 'unset'
  !this.string           = 'unset'
  !this.startbat         = 'unset'

exit


------------------------------------------------------------------------
--
-- Method:      .abaDefaults()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .abaDefaults()

  -- Initialise variables
  !fontRtext = ARRAY()

  -- Read Aba entry default
  !this.entry()

  -- Set true-type fonts
  if (defined(!!fontManager)) then

    -- Get font descriptions
    !fontDtext = !!fontManager.ttfFace

    -- Values
    do !fontId val !!fontManager.ttfId
      !fontRtext.append(!fontId.string())
    enddo

  else

    -- No fonts defined
    !fontDtext[1] = 'None Defined'
    !fontRtext[1] = 'NONE'

  endif

  !this.fonts.dtext = !fontDtext
  !this.fonts.rtext = !fontRtext

endmethod
-- End of method definition for .abaDefaults()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Test for an existing defaults file
  if (!this.file.exists().not()) then
    !!alert.error('The AB ADP defaults file ' & !this.file.fullname() & ' does not exist. Please contact your System Administrator.')
    return
  endif

  -- Reload defaults after they have been changed
  !this.readDefaults()

  -- Make sure the !!abaFileList form has been loaded
  if (undefined(!!abaFileList)) then
    loadform !!abaFileList
  endif

  -- Initialise variables
  !notExist = 0
  !module   = object MODULE()

  -- Look for any non-existing default libraries
  !this.validategadgets()

  -- Load forms
  !shown = !!abaTasks.shown()
    handle (2,751)
      -- Variable !!abaTasks does not exist
      pml load form !!abaTasks
    endhandle

   !shown = !!abaBatUser.shown()
    handle (2,751)
      -- Variable does not exist
      pml load form !!abaBatUser
    endhandle

  -- Select true-type font
  if (!this.create.active) then

    -- Test for true-type fonts
    if (!this.fonts.selection().eq('NONE')) then
      !this.fontOPT1.val = true
      !this.setFont('NATIVE')
    else

      -- Check for defaults set-up i.e. MARINE True-Type while PDMS Native
      if (!module.product.eq('PDMS')) then
        !this.fontOPT1.val = true
        !this.setFont('NATIVE')
      else
        !this.fontOPT2.val = true
        !this.setFont('TRUETYPE')
      endif

    endif

  else

    !libyRefe = !this.libr.val.dbref()
      handle (2,109)
        -- Undefined name
      elsehandle none

        if (!this.fonts.rtext.findFirst(!libyRefe.font.string()).unset()) then
          !this.fontOPT1.val = true
        else
          !this.fontOPT2.val = true
          !this.fonts.select('RTEXT',!libyRefe.font.string())
        endif

      endhandle

    !this.setFont('OFF')

  endif

endmethod
-- End of method definition for .init()

--------------------------------------------------------------------------------------------------------
define method .checkName(!gadget is GADGET,!libtype is STRING)

  !!ce = !gadget.val.dbref()
  handle any
    !!alert.error('Element $!gadget.val does not exist')
  elsehandle none
   !this.setDefault(!gadget,!libtype)
  endhandle
  !this.validategadgets()
endmethod

--------------------------------------------------------------------------------------------------------
define method .checkName(!element is STRING)

  -- The check will have to be for all elements on the form and not just the passed element

  !allExists = true

  -- Gadgets to check are:-
  -- .libr
  -- .dlib
  -- .alib
  -- .disl
  -- .keyp
  -- .symb
  -- .labl
  -- .task

  var !exist exist $!!abaDefaults.libr.val
  if (!exist.upCase().eq('FALSEA')) then
    !allExists = false
  endif
  var !exist exist $!!abaDefaults.dlib.val
  if (!exist.upCase().eq('FALSEA')) then
    !allExists = false
  endif
  var !exist exist $!!abaDefaults.alib.val
  if (!exist.upCase().eq('FALSEA')) then
    !allExists = false
  endif
  var !exist exist $!!abaDefaults.disl.val
  if (!exist.upCase().eq('FALSEA')) then
    !allExists = false
  endif
  var !exist exist $!!abaDefaults.keyp.val
  if (!exist.upCase().eq('FALSEA')) then
    !allExists = false
  endif
  var !exist exist $!!abaDefaults.symb.val
  if (!exist.upCase().eq('FALSEA')) then
    !allExists = false
  endif
  var !exist exist $!!abaDefaults.labl.val
  if (!exist.upCase().eq('FALSEA')) then
    !allExists = false
  endif
  var !exist exist $!!abaDefaults.task.val
  if (!exist.upCase().eq('FALSEA')) then
    !allExists = false
  endif

  if !allExists.not() then
    !this.create.active = true
  else
    !this.create.active = false
  endif


  -- Test for existing element
  -- var !exist exist $!element
  -- if (!exist.upCase().eq('TRUEA')) then
    -- !this.create.active = false
  -- else
    -- !this.create.active = true
  -- endif

  -- Set form as changed
  !this.changed = true

  -- Save gadget values in member
  !this.saveGadget()

endmethod

--------------------------------------------------------------------------------------------------------
define method .entry()

  -- Search for aba entry file
  !file = object FILE('%PDMSUSER%/aba_defaults')

  if (!file.exists()) then

    !this.file = object FILE(!file.readFile()[2])

    -- Check read file exists
    if (!this.file.exists().not()) then

      !this.file = object FILE('%PDMSDFLTS%/DRA-ABA-DEFAULTS')

    endif

  else

    !this.file = object FILE('%PDMSDFLTS%/DRA-ABA-DEFAULTS')

  endif

  -- Set gadget
  !this.defaultsFile.val = !this.file.string()

  -- Load defaults file
  !this.readDefaults()

endmethod

--------------------------------------------------------------------------------------------------------
define method .fileList()

  !!abaFileList.dirName.val = '%PDMSABADATA%'
  !!abaFileList.whereFrom   = 'PDMSABADATA'
  !!abaFileList.font        = !this.fonts.selection()

  show !!abaFileList cen xr .5 yr .5

endmethod

--------------------------------------------------------------------------------------------------------
define method .fixedWidthString(!input is STRING,!separator is STRING) is STRING

  !sizes = ARRAY()
  !temp = ARRAY()
  !split = !input.split()

  do !a from 1 to !split().size()

    !temp.clear()
    do !x from 1 to !input.size()

      !temp.append(!input[!a])

    enddo

    !sizes[!a] = !temp.width()

  enddo

endmethod

--------------------------------------------------------------------------------------------------------
define method .getdefaults()is BOOLEAN

  !deffile  = '%PDMSDFLTS%/DRA-ABA-DEFAULTS'
  !file     = '%PDMSDFLTS%/VPD' &  !deffile.after('/').substring(4,4) & !deffile.after('/').substring(1,1) & 'P'
  !file = 'h.yx6JJY;4#jOO81086839705'
  !testfile = !file.substring(15,!this.defString).not()

  if !testfile then
    !!messagefile.warning(43,292)
    return error 7 noalert
  else
    return true
  endif

endmethod

--------------------------------------------------------------------------------------------------------
define method .hierarchy()

  -- Pass information about the selected font to the file list form
  -- Zero signifies that the PDMS native fonts will be used when loading the library data
  -- Any other value is the True Type font number
  if (!this.fontOPT1.val) then
    !!abaCrHierarchy.setFont  = '1'
  else
    !!abaCrHierarchy.setFont  = !this.fonts.selection()
  endif

  -- Test for existing library
  var !exist exist $!this.libr.val
  if (!exist.upCase().eq('TRUEA')) then

    $!this.libr.val

    -- Attempt to create the hierarchy
    !!abaCrHierarchy.init()
    !!abaCrHierarchy.create()

  else

    -- Choose in which db to create library
    show !!abaCrHierarchy

  endif

  -- Set gadgets inactive
  !this.setFont('OFF')

endmethod

--------------------------------------------------------------------------------------------------------
define method .loadDefaults()

  !!abaFileList.whereFrom   = 'PDMSDFLTS'
  !!abaFileList.dirName.val = '%PDMSDFLTS%'
  !!abaFileList.show()

endmethod

--------------------------------------------------------------------------------------------------------
define method .readDefaults()

  -- Load defaults from file
  !!abaDefaultsFile = !this.file.readFile()
    handle (160,9)
      !!alert.error('The specified defaults file does not exist')
      !this.gadgetValue[1] = !this.defaultsFile.val
      !this.defaultsFile.setfocus()
      return
    endhandle

  !start = !!abaDefaultsFile.findFirst('-- Section 1')
  !end   = !!abaDefaultsFile.findFirst('-- End Section 1')

  do !x from !start + 1 to !end - 1

    -- Set defaults form gadget
    $!!abaDefaultsFile[$!x]

    -- Set defaults form create button focus
    -- depending on an existing top-level library
    if (!x.eq(!start + 1)) then
      var !exist exist $!!abaDefaults.libr.val
      if (!exist.upCase().eq('TRUEA')) then
        !!abaDefaults.create.active = false
      else
        !!abaDefaults.create.active = true
      endif
    endif

  enddo

-- Set the db hierarchy position of the AutoNumber task, and parameters.
  !this.defString = !this.defString.replace('2','1')
-- should only be one entry
  !start = !!abaDefaultsFile.findFirst('-- Section 4')
  !end   = !!abaDefaultsFile.findFirst('-- End Section 4')
  !diff  = !end - !start

  if (!diff ne 2) then
      !!alert.error('Problem with section 4 of defaults file')
  else
      !this.autonumber = !!abaDefaultsFile.from(!start,!end)[2]
  endif

  -- Set batch data to members
  !this.logPath  = !this.logf.val
  !this.batPath  = !this.batf.val

  -- Write entry file
  !this.writeEntry()

  -- Save gadget values in form member
  !this.saveGadget()

endmethod

--------------------------------------------------------------------------------------------------------
define method .resetGadget()

  -- Reset gadget values to form member settings

  !this.defaultsFile.val = !this.gadgetValue[1]
  !this.libr.val         = !this.gadgetValue[2]
  !this.dlib.val         = !this.gadgetValue[3]
  !this.alib.val         = !this.gadgetValue[4]
  !this.disl.val         = !this.gadgetValue[5]
  !this.keyp.val         = !this.gadgetValue[6]
  !this.symb.val         = !this.gadgetValue[7]
  !this.labl.val         = !this.gadgetValue[8]
  !this.task.val         = !this.gadgetValue[9]
  !this.logf.val         = !this.gadgetValue[10]
  !this.batf.val         = !this.gadgetValue[11]

endmethod

--------------------------------------------------------------------------------------------------------
define method .save(!save is STRING,!gadget is FORM)

  -- This method is used for both abaDefaults and abaTasks forms.

  -- Initialise variables
  !savedef = ARRAY()
  !ans = 'Normal'

  -- Check if closing abaDefaults/abaTasks status of changed flag, save if necessary.
  if (!save eq 'CLOSE' and !this.changed eq TRUE) then

    !ans = !!alert.question('Defaults have changed... Save before closing')

    if (!ans eq 'YES') then
      !this.save('SAVE',!!abaDefaults)
    elseif (!ans eq 'NO') then
      !gadget.hide()
      !this.changed = FALSE
    else
      return
    endif

    !!abaFileList.dirName.val = '%PDMSDFLTS%'
    !!abaFileList.action.val = 'Apply Action'
    !!abaFileList.edit.active = True
    !!abaFileList.selection.active = False

  elseif (!save eq 'SAVE' or !save eq 'NEWNAME') then

    !saveAll = false

    do !x values !!abaDefaultsFile

      if (!x.substring(1,2) eq '--' or !saveAll) then

        !savedef.append(!x)

        -- General default file/name section.
        if (!x.match('-- Section 1') ne 0) then

          !savedef.append(|!!abaDefaults.libr.val = '| & !!abaDefaults.libr.val & |'|)
          !savedef.append(|!!abaDefaults.dlib.val = '| & !!abaDefaults.dlib.val & |'|)
          !savedef.append(|!!abaDefaults.alib.val = '| & !!abaDefaults.alib.val & |'|)
          !savedef.append(|!!abaDefaults.disl.val = '| & !!abaDefaults.disl.val & |'|)
          !savedef.append(|!!abaDefaults.keyp.val = '| & !!abaDefaults.keyp.val & |'|)
          !savedef.append(|!!abaDefaults.symb.val = '| & !!abaDefaults.symb.val & |'|)
          !savedef.append(|!!abaDefaults.labl.val = '| & !!abaDefaults.labl.val & |'|)
          !savedef.append(|!!abaDefaults.task.val = '| & !!abaDefaults.task.val & |'|)
          !savedef.append(|!!abaDefaults.logf.val = '| & !!abaDefaults.logf.val & |'|)
          !savedef.append(|!!abaDefaults.batf.val = '| & !!abaDefaults.batf.val & |'|)
          !savedef.append(|!!abaDefaults.logPath  = '| & !!abaDefaults.logf.val & |'|)
          !savedef.append(|!!abaDefaults.batPath  = '| & !!abaDefaults.batf.val & |'|)
          !savedef.append(|!!abaDefaults.ustring  = '| & !!abaDefaults.ustring  & |'|)
          !savedef.append(|!!abaDefaults.string   = '| & !!abaDefaults.string   & |'|)
          !savedef.append(|!!abaDefaults.startbat = '| & !!abaDefaults.startbat & |'|)

        endif

      endif

      -- The rest
      if (!x.match('-- Section 2') ne 0) then
        !saveAll = true
      endif

    enddo

    !!abaDefaults.changed = FALSE

    if (!save eq 'SAVE') then
      !file = object FILE(!!abaDefaults.defaultsFile.val)
      !file.writeFile('over',!savedef)

    else

      !!abaFileList.dirName.val      = '%PDMSDFLTS%'
      !!abaFileList.action.val       = 'Save as File'
      !!abaFileList.selection.active = true
      !!abaFileList.edit.active      = false
      !!abaFileList.whereFrom        = 'abaDefaults'
      !!abaFileList.text             = !savedef
      !!abaFileList.ok.tag           = '  OK  '
      !!abaFileList.dismiss.tag      = 'Cancel'

      show !!abaFileList

    endif

    -- Write entry file
    !this.writeEntry()

  endif

  if (!save eq 'CLOSE') then

    hide !!$!gadget

    -- Reset the gadgets to the input values
    !this.resetGadget()

  endif

endmethod

--------------------------------------------------------------------------------------------------------
define method .saveGadget()

  -- This method saves the gadget values into a form member gadgetValue
  -- This is to overcome the cancel call which resets them to their original state
  -- We happen to use the values just about everywhere, so we need them

  !this.gadgetValue[1] = !this.defaultsFile.val
  !this.gadgetValue[2] = !this.libr.val
  !this.gadgetValue[3] = !this.dlib.val
  !this.gadgetValue[4] = !this.alib.val
  !this.gadgetValue[5] = !this.disl.val
  !this.gadgetValue[6] = !this.keyp.val
  !this.gadgetValue[7] = !this.symb.val
  !this.gadgetValue[8] = !this.labl.val
  !this.gadgetValue[9] = !this.task.val
  !this.gadgetValue[10] = !this.logf.val
  !this.gadgetValue[11] = !this.batf.val

endmethod

--------------------------------------------------------------------------------------------------------
define method .saveSection(!gadget is ARRAY,!which is STRING) is ARRAY

  if (!which eq 'v') then

    !task = 'View'

  elseif (!which eq 'd') then

    !task = 'Draw'

  else

    !task = 'Global'

  endif

  !array = ARRAY()

  do !x index !gadget

    !a = (|!!abaTasks.| & !task & |Tasks.append(object ABATASK ('| & $
    !gadget[!x].name & |','| & !gadget[!x].description & |','| &  !gadget[!x].execute & |'))|)

    !array.append(!a)

    -- Output the Parameters and Descriptions for each one that exists.
    !array.appendArray(!gadget[!x].getParam())

  enddo

  return !array

endmethod

--------------------------------------------------------------------------------------------------------
define method .setDefault(!gadget is GADGET,!type is STRING)

  -- Check if element type matches the requirement
  if (!type.match(!!ce.type).gt(0)) then
    !gadget.val = !!ce.name
  else
    !newtype = !type.replace(',',' or ')
    !!alert.error(!gadget.tag.trim() & ' should be a ' & !newtype & ' element')
  endif

  !this.checkName('check')
  !this.validategadgets()
endmethod

-----------------------------------------------------------------------
--
-- Method:      .setFont(STRING)
--
-- Description: Create the batch macro
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      NATIVE   native PDMS font
--                           TRUETYPE true-type font
--                           OFF
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFont(!type is STRING)

  -- Make all gadgets active
  !this.fontOPT1.active = true
  !this.fontOPT2.active = true

  -- Set true-type option active status
  if (!type.eq('NATIVE')) then
    !this.fonts.active = false
  elseif (!type.eq('TRUETYPE')) then
    !this.fonts.active = true
  else
    !this.fontOPT1.active = false
    !this.fontOPT2.active = false
    !this.fonts.active    = false
  endif

endmethod
-- End of method .setFont(STRING)

--------------------------------------------------------------------------------------------------------
define method .writeEntry()

  -- Write aba entry file
  !file = object FILE('%PDMSUSER%/aba_defaults')

  !lines[1] = '-- Aba entry default'
  !lines[2] = !!abaDefaults.defaultsFile.val

  !file.writeFile('OVERWRITE',!lines)

endmethod
-----------------------------------------------------------------------
--
-- Method:      .validategadgets()
--
-- Description: set the button colours for the ce buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .validategadgets()

  !notExist = 0
  -- Look for any non-existing default libraries
  !libraries[1] = !this.libr
  !libraries[2] = !this.dlib
  !libraries[3] = !this.alib
  !libraries[4] = !this.disl
  !libraries[5] = !this.keyp
  !libraries[6] = !this.symb
  !libraries[7] = !this.labl
  !libraries[8] = !this.task
  !buttons[1]   = !this.ce1
  !buttons[2]   = !this.ce2
  !buttons[3]   = !this.ce3
  !buttons[4]   = !this.ce4
  !buttons[5]   = !this.ce5
  !buttons[6]   = !this.ce6
  !buttons[7]   = !this.ce7
  !buttons[8]   = !this.ce8


  do !library index !libraries

    -- Test if library exists
    var !exist exist $!libraries[$!library].val

    if (!exist.upCase().eq('FALSEA')) then
      !notExist = !notExist + 1
      !buttons[!library].background = 27
    else
      !buttons[!library].background = 5
    endif

  enddo

    -- Set defaults form create button focus
  if (!notExist.neq(0)) then
    !!abaDefaults.create.active = true
  else
    !!abaDefaults.create.active = false
  endif

endmethod
