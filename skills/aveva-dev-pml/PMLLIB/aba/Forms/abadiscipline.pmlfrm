--
-- Description: define Disciplines for templates.
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activateCE()                     -
--  addCe()                          -
--  cancel()                         -
--  check()                          -
--  deleteDiscp()                    -
--  editAdde(REAL)                   -
--  init()                           -
--  insert(BOOLEAN)                  -
--  replace()                        -
--  selRule()                        -
--  select()                         -
--  setname()                        -
--
------------------------------------------------------------------------
setup form !!abadiscipline
------------------------------------------------------------------------
   title |ABA Classification Definition |
   init |!this.init()|
   cancelcall |!this.cancel()|

-- Selection area
   frame .action |Edit / Create Classification|

      path down

       text .name           |Name        | tagwidth 8 call |!this.setname()| at y 1.2 width 40 name
       text .description    |Description | tagwidth 8 width 40 is STRING
       text .rule           |Criteria    | tagwidth 8 call |!this.check()| width 40 is STRING
       path right
       button .addCe |  CE  | call |!this.addCe()|

       path down
       option .addeEdit at xmax-size ymax+0.5 |Action| tagwidth 5 call |!this.editAdde(!this.addeEdit.val)| width 13
       option .addRem at xmin-2-size ymin |Type| tagwidth 4 width 7

       hdist 2
       rgroup .addType | Criteria Type | at xmin form+1.4 ymin-0.4 call |!this.activateCE()| horizontal
         add Tag 'Rule'
         add tag 'Element'
       exit

       list .rlist at ymax+0.3 call |!this.selRule()| width 56 hei 8


     hdist 4
     button .insert  |   Add   | at x 12 ymax.rlist +0.5 call |!this.insert(true)|
     path right
     button .replace | Replace | at xmax.insert+3       call |!this.replace()|
     button .delete  | Remove | at xmax.replace+3       call |!this.deleteDiscp()|
     hdist 1
exit
     path down
     frame .frule 'Current Classifications' at xmin ymax+0.5
        list .dlist call |!this.select()| width 56 hei 8
     exit


     menu .pop1
-- why do we need the next 2 options here? (removed MJT P-19846)
--      !this.pop1.add ('CALLBACK','   Add   ',|!this.insert(true)|)
--      !this.pop1.add ('CALLBACK',' Replace ',|!this.replace()|)
      !this.pop1.add ('CALLBACK',' Remove ',|!this.deleteDiscp()|)
      !this.dlist.setpopup(!this.pop1)

     menu .pop2
-- why do we need the next 2 options here? (removed MJT P-19846)
--      !this.pop2.add ('CALLBACK','   Add   ',|!this.editAdde(1)|)
--      !this.pop2.add ('CALLBACK',' Replace ',|!this.editAdde(2)|)
      !this.pop2.add ('CALLBACK',' Remove ',|!this.editAdde(3)|)
      !this.rlist.setpopup(!this.pop2)

-- Member
  member .check is REAL
  member .fromHere is DBREF
  member .mode is STRING
  member .selection is REAL

-- Form data
  !dtext[1] = 'Add Criteria'
  !dtext[2] = 'Replace Criteria'
  !dtext[3] = 'Remove Criteria'
  !this.addeEdit.dtext = !dtext

  !add[1] = |Add|
  !add[2] = |Remove|
  !this.addRem.dtext = !add
  !this.selection = 0
  !this.addCe.active = FALSE

  !this.rlist.setHeadings( |Criteria List| )
  !this.dlist.setHeadings( |Descriptions| )

------------------------------------------------------------------------
define method .init()
------------------------------------------------------------------------

  !!abaProcess.visible(FALSE)
  !list = !!abadefaults.disl.val.dbref()
  !this.fromHere = !!ce

  $!list

  var !coll coll all idli for $!list
  var !name eval name for all from !coll
  var !desc eval function for all from !coll
  !sorted = !desc.sortedindices()
  !this.dlist.dtext = !desc.reindex(!sorted)
  !this.dlist.rtext = !coll.reindex(!sorted)

  if (!this.selection NE 0) then
    !this.dlist.val = !this.selection
  endif
   handle (2,759)
   endhandle

  !this.select()

endmethod

------------------------------------------------------------------------
define method .activateCE()
------------------------------------------------------------------------

      if (!this.addType.val EQ 1) then
          !this.addCe.active = FALSE
      else
          !this.addCe.active = TRUE
      endif

endmethod

------------------------------------------------------------------------
define method .addCe()
------------------------------------------------------------------------

     var !ddl split ddl
     if (!ddl[1] NE 'PADD') then
     !this.rule.val = !!ce.name
     else
         !!alert.warning('DRAFT Elements Cannot Be Added - Switching DB')
         sw
     endif

endmethod

------------------------------------------------------------------------
define method .select()
------------------------------------------------------------------------

  -- Check for number of classifications
  !this.check = !this.dlist.dtext.size()
  if (!this.check NE 0 ) then

    !ref = !this.dlist.selection().dbref()
      handle any
        !this.description.val = 'Unset'
        !this.rule.val = 'Unset'
        !this.name.val = 'Unset'
        !this.rlist.clear()
      endhandle

		$!ref
		 handle any

		 elsehandle none
-- --+-----------------------

    !this.description.val = !ref.function
		 handle any
			 !this.description.val = 'Unset'
		 endhandle
    !this.name.val = !ref.name
		 handle any
				!this.name.val = 'Unset'
		 endhandle

    -- Get all adde reme elements
    var !memb coll mem of $!ref
    var !crit eval criteria for all from !memb
    var !idname eval idname for all from !memb

    -- Build display array
    !display = ARRAY()
    do !index index !memb

      if (!memb[!index].dbref().type.upCase().eq('ADDE')) then
        if !crit[!index] eq 'unset' then
          !display.append('ADD' & !idname[!index])
        else
          !display.append('ADD' & !crit[!index])
        endif
      else
        if !crit[!index] eq 'unset' then
          !display.append('REM' & !idname[!index])
        else
          !display.append('REM' & !crit[!index])
        endif
      endif

    enddo

    -- Populate list gadget
    !this.rlist.dtext = !display

    if (defined(!crit[1]))then
      !this.rule.val = !crit[1].trim()

      if (!memb[1].dbref().type.upCase().eq('ADDE')) then
        !this.addRem.val = 1
      else
        !this.addRem.val = 2
      endif

      if (!crit[1].trim().subString(1,1).eq('/') or !crit[1].trim().subString(1,1).eq('=')) then
        !this.addType.val = 2
      else
        !this.addType.val = 1
      endif
    else
      !this.rule.val = 'Unset'
    endif

-- --+-----------------------
		 endhandle

  endif

 	!this.selection = !this.dlist.val
endmethod

------------------------------------------------------------------------
define method .setname()
------------------------------------------------------------------------

  -- Check if name exists
  !s = !!checkname(!this.name.val,|new|)

  -- Action
  if (unset(!s)) then

    !this.name.val = |Unset|
    !this.name.setfocus()

    -- Clear other gadgets
    !this.rule.clear()
    !this.rlist.clear()
    !this.description.val = ''
    !this.addRem.val = 1
    !this.addeEdit.val = 1
    !this.addeEdit.active = false
    !this.addType.val = 1
    !this.dlist.val = 1

  else
    !this.name.val = !s
  endif

endmethod

------------------------------------------------------------------------
define method .insert(!mode is BOOLEAN)
------------------------------------------------------------------------
-- first make sure we have a criterion:
	if(!this.rlist.dtext.size() neq 0 )then

  if (!this.check NE 0 ) then

    !ref = !this.dlist.selection().dbref()
     handle any
       !ref = !!abadefaults.disl.val.dbref()
       !mode = true
     endhandle

    $!ref
    if (!mode.not())then
      prev
       handle (2,113)
        end
       endhandle
    endif
  endif

  $!!abadefaults.disl.val

  NEW IDLI $!this.name.val
   handle(41,12)
    	!!alert.error('Name already defined')
    	DELETE IDLI
    !this.name.setfocus()
    return
   endhandle

 		if( !this.description.val.empty() )then
 			!this.description.val = !this.name.val.subString(2)
 		endif 	
  FUNCTION |$!this.description.val|
  SpPURPOSE ABAT
  !newRefe = !!ce

  -- Make ADDE list
  do !crit ind !this.rlist.dtext
    !criteria = !this.rlist.dtext[!crit].subString(5)
    !type = !this.rlist.dtext[!crit].subString(1,3) & 'E'
    NEW $!type
    criteria $!criteria
     handle (2,556)
       -- ALL cannot be used with this command as too many items will be selected
       !!alert.error('ALL cannot be used with this command as too many items will be selected')
       IDLI
       DELETE IDLI
     endhandle
  enddo

  !this.init()
  !this.dlist.select('RTEXT',!newRefe.string())
   	 handle any
	 	 endhandle
  !this.select()

	else
		!!alert.error('No criteria defined')
	endif

endmethod

------------------------------------------------------------------------
define method .deleteDiscp()
------------------------------------------------------------------------
  if (!this.selection NE 0) then

   !ref = !this.dlist.selection().dbref()
   !name = !ref.name

   !ans = !!alert.confirm('Ok to delete $!ref.name')
   if(!ans eq 'YES')then
     $!ref
      DELETE IDLI
   endif

  	!this.selection = 0

    !this.init()
  endif
endmethod


------------------------------------------------------------------------
define method .replace()
------------------------------------------------------------------------
-- first make sure we have a criterion:
	if(!this.rlist.dtext.size() neq 0 )then

  -- Access selected classification (IDLI)
  !!ce = !this.dlist.selection().dbref()

 		if( !this.description.val.empty() )then
   		!this.description.val = !this.name.val.subString(2)
 		endif
  FUNCTION |$!this.description.val|
  SpPURPOSE ABAT
    handle(41,12)
    endhandle

  -- Rename
  if (!this.name.val.neq(!!ce.flnm)) then
    NAME $!this.name.val
  endif

  -- Delete all addes
  DELETE IDLI MEM

  -- Make new ADDE elements
  do !crit ind !this.rlist.dtext
    !criteria = !this.rlist.dtext[!crit].subString(5)
    !type = !this.rlist.dtext[!crit].subString(1,3) & 'E'
    NEW $!type
    criteria $!criteria
      handle any
        !!alert.error('Invalid rule - check syntax for rule no.$!crit')
        DELETE ADDE
        skip
      endhandle
  enddo

  !this.selection = !this.dlist.val
  !this.init()

	else
		!!alert.error('No criteria defined')
	endif

endmethod

------------------------------------------------------------------------
define method .editAdde(!mode is REAL)
------------------------------------------------------------------------

  -- Initialise variables
  !whichOne = !this.rlist.val
  !current = !this.rlist.dtext

  -- Insert
  if (!mode EQ 1) then
    !current.append(!this.addRem.selection().upCase().subString(1,3) & ' ' & !this.rule.val)

  -- Replace
  elseif (!mode EQ 2) then
    !current[!whichOne] = !this.addRem.selection().upCase().subString(1,3) & ' ' & !this.rule.val

  -- Delete (if possible)
  elseif( !whichOne GT 0 )then
    !current.remove(!whichOne)
  endif

  -- Reset gadget
  !this.rlist.dtext = !current

endmethod

-------------------------------------------------------------
define method .cancel()
-------------------------------------------------------------

  !!abadiscipline.hide()
  !!abaProcess.visible(TRUE)
  !!ce = !this.fromHere

  -- Savework and release all that's been claimed out.
  savework
  unclaim all

endmethod

------------------------------------------------------------------------
define method .selRule()
------------------------------------------------------------------------

  -- Initialise variables
  !criteria = !this.rlist.selection('RTEXT').subString(5)
  !type = !this.rlist.selection('RTEXT').subString(1,3)
  !firstChar = !criteria.trim().subString(1,1)

  -- Populate rule gadget with selection
  !this.rule.val = !criteria.trim()

  -- Select other gadget settings
  if (!type.eq('ADD')) then
    !this.addRem.val = 1
  else
    !this.addRem.val = 2
  endif

  if (!firstChar.eq('/') or !firstChar.eq('=')) then
    !this.addType.val = 2
  else
    !this.addType.val = 1
  endif

  !this.activateCE()

endmethod

------------------------------------------------------------------------
define method .check()
------------------------------------------------------------------------
-- Run when a rule or an element name is input as criteria

  -- Initialise variables
  !expression = !this.rule.val

  -- Check for validity
  if (!this.addType.val.eq(1)) then

    -- Test expression by collecting it
    var !unusedTry coll $!expression
     handle any
       !!alert.error(|Invalid expression - check criteria syntax|)
     endhandle

  else

    -- Check for rule syntax by looking for spaces
    if (!expression.match(' ').neq(0)) then

      !!alert.error('Error in given design element name')

    else

      -- Check if name exists
      !result = !!checkname(!expression,'EXIST')

      -- Send back result to make sure name includes the slash
      if (!result.set()) then
        !this.rule.val = !result
      endif

    endif

  endif

  -- Set add/edit active
  !this.addeEdit.active = true

endmethod
