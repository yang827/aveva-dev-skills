--   Replaces:
--
-- Author:          Martin Wright
-- Created:         17 March 1999
--
--
-- Description: List of available drawings for Modification.
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaDrawingList()                 -                   Constructor method
--  afterSelectChange(ARRAY)         -                   Callback on grid control after select change of the options grid
--  getAllDrtmpl()                   -                   Get all drawing templates
--  init()                           -                   Method to initialize the form
--  select()                         -
--  selectDrg()                      -                   Using the selected drawing template, show the drtmpl form
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!abaDrawingList

  title |ABA Template Drawing List|
  init |!this.init()|

  para .title at x0 y0 text |Template Drawings|

  container .drgGrid nobox pmlNetControl 'NET' at xmin ymin+0.6 width 60 height 12

  -- Declare the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  member .drgControl is NETGRIDCONTROL

  member .headings   is ARRAY
  member .allDrtmpl  is ARRAY

exit

------------------------------------------------------------------------
--
-- Method:      .abaDrawingList()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------------------------------
define method .abaDrawingList()

  -- Create instances of the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  !this.drgControl = object NETGRIDCONTROL()

  -- Add .net control to the container
  !this.drgGrid.control = !this.drgControl.handle()

  -- Add PML event handlers to .net control
  !this.drgControl.addEventHandler('afterSelectChange', !this, 'afterSelectChange')

  -- Set grid visual attributes
  !this.drgControl.columnExcelFilter(false)
  !this.drgControl.outlookGroupStyle(false)
  !this.drgControl.fixedRows(false)
  !this.drgControl.gridHeight(1000.0)
  !this.drgControl.editableGrid(false)
  !this.drgControl.singleRowSelection(true)
  !this.drgControl.columnExcelFilter(false)
  !this.drgControl.fixedHeaders(false)
  !this.drgControl.headerSort(true)
  !this.drgControl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Name')
  !this.headings.append('Title')

endmethod
-- End of method definition for .abaDrawingList()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Clear data array
  !this.allDrtmpl.clear()

  -- Clear the grid
  !this.drgControl.clearGrid()

  -- Get all drawing templates and populate the grid
  !this.getAllDrtmpl()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .afterSelectChange(ARRAY)
--
-- Description: Callback on grid control after select change of the options grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .afterSelectChange(!array is ARRAY)

  -- Select the drtmpl
  if (!this.drgControl.getSelectedRowTags().set()) then
    !this.selectDrg()
  endif

endmethod
-- End of method definition for .afterSelectChange(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .getAllDrtmpl()
--
-- Description: Get all drawing templates
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAllDrtmpl()

  -- initialise variables
  !rowSet = ARRAY()

  -- Get all drawing template
  VAR !allDrtmpl COLLECT ALL DRTMPL FOR $!!abaDefaults.dlib.val
  VAR !allNames EVAL NAME FOR ALL FROM !allDrtmpl

  -- Sort drawing templates by name
  !allDrtmpl.reindex(!allNames.sortedIndices())

  -- Build the row data set
  do !drtmpl val !allDrtmpl

    -- Initialise variables
    !drtmplRefe = !drtmpl.dbref()
    !rowData    = ARRAY()

    -- Build row data
    !rowData.append(!drtmplRefe.name)
    !rowData.append(!drtmplRefe.title)

    -- Add row data to row set array
    !rowSet.append(!rowData)

    -- Store drtmpl reference
    !this.allDrtmpl.append(!drtmplRefe)

  enddo

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.drgControl.bindToDataSource(object NETDATASOURCE('Drtmpl', !this.headings, !rowSet, '^Name'))

endmethod
-- End of method .getAllDrtmpl()

------------------------------------------------------------------------
define method .select()

  !!ce = !this.allDrtmpl[!this.drgControl.getSelectedRowTags()[1].real()]
  CALLIBM XELEMSEL

endmethod

------------------------------------------------------------------------
--
-- Method:      .selectDrg()
--
-- Description: Using the selected drawing template, show the drtmpl form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectDrg()

  -- Hide this form
  hide !!abaDrawingList

  -- Set drawing template form parameters
  !!abaTemplateDrg.drtmpl = !this.allDrtmpl[!this.drgControl.getSelectedRowTags()[1].real()]
  !!abaTemplateDrg.mode   = 'MODIFY'

  -- Show the drawing template form
  show !!abaTemplateDrg centred xr 0.5 yr 0.2

endmethod
-- End of method .selectDrg()
