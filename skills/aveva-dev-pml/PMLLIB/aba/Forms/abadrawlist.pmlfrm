------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaDrawList()                    -                   Constructor method
--  add()                            -
--  cancel()                         -
--  choicePopup(ARRAY)               -                   Pop-up for the choice grid control
--  clear(STRING)                    -                   Clear relevant data arrays
--  getAllDisc()                     -                   Get all available disciplines
--  getDisc()                        -                   Get the chosen disciplines
--  init()                           -
--  optionsPopup(ARRAY)              -                   Pop-up for the options grid control
--  parseDisc()                      -                   Parse the disciplines for the relevant grids
--  remove()                         -
--  selectAll(STRING)                -
--  setdislist()                     -
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!abaDrawList

  title 'Add Drawing Item Lists'
  init |!this.init()|
  cancelcall |!this.cancel()|

  path down

  frame .class |Classifications| at xmin ymax
    container .optionsGrid nobox pmlNetControl 'NET' at x0.7 ymax-0.4 width 51 height 8
  exit

  button .replace  | Add |   at x 15           call |!this.add()|
  path right
  button .insert  | Remove | at xmax.replace+7 call |!this.remove()|

  path down
  frame .list |Classification List (Current View)|  at x 0
    container .choiceGrid nobox pmlNetControl 'NET' at x0.7 ymax-0.4 width 51 height 8
  exit

  button .apply   '  OK  ' at xmin ymax+.3 call '!this.setDisList()'
  button .Dismiss 'Cancel' at xmax form -size ymin call '!this.cancel()' cancel

  -- Declare the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  member .optionsControl is NETGRIDCONTROL
  member .choiceControl  is NETGRIDCONTROL

  -- Members
  member .ce            is DBREF
  member .headings      is ARRAY
  member .allRefes      is ARRAY
  member .optionsRefes  is ARRAY
  member .choiceRefes   is ARRAY

exit

------------------------------------------------------------------------
--
-- Method:      .abaDrawList()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .abaDrawList()

  -- Define pop-up menu
  !menu = !this.newMenu('optionsPopUp')
    !menu.add('callback', 'Add', |!this.add()|,'ADD')
    !menu.add('separator')
    !menu.add('callback', 'Select All', |!this.selectAll('OPTIONS')|,'ALL')
    !menu.add('callback', 'Clear Selection', |!this.optionsControl.clearRowSelection()|, 'CLEAR')

  !menu = !this.newMenu('choicePopUp')
    !menu.add('callback', 'Remove', |!this.remove()|,'REMOVE')
    !menu.add('separator')
    !menu.add('callback', 'Select All', |!this.selectAll('CHOICE')|,'ALL')
    !menu.add('callback', 'Clear Selection', |!this.choiceControl.clearRowSelection()|, 'CLEAR')

  -- Create instances of the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  !this.optionsControl = object NETGRIDCONTROL()
  !this.choiceControl  = object NETGRIDCONTROL()

  -- Add .net control to the containers
  !this.optionsGrid.control = !this.optionsControl.handle()
  !this.choiceGrid.control  = !this.choiceControl.handle()

  -- Add PML event handlers to .net controls
  !this.optionsControl.addEventHandler('onPopup', !this, 'optionsPopup')
  !this.choiceControl.addEventHandler('onPopup', !this, 'choicePopup')

  -- Set grid visual attributes
  !this.optionsControl.columnExcelFilter(false)
  !this.optionsControl.outlookGroupStyle(false)
  !this.optionsControl.fixedRows(false)
  !this.optionsControl.gridHeight(1000.0)
  !this.optionsControl.editableGrid(false)
  !this.optionsControl.singleRowSelection(false)
  !this.optionsControl.columnExcelFilter(false)
  !this.optionsControl.fixedHeaders(false)
  !this.optionsControl.headerSort(true)
  !this.optionsControl.columnSummaries(false)
  !this.choiceControl.columnExcelFilter(false)
  !this.choiceControl.outlookGroupStyle(false)
  !this.choiceControl.fixedRows(false)
  !this.choiceControl.gridHeight(1000.0)
  !this.choiceControl.editableGrid(false)
  !this.choiceControl.singleRowSelection(false)
  !this.choiceControl.columnExcelFilter(false)
  !this.choiceControl.fixedHeaders(false)
  !this.choiceControl.headerSort(true)
  !this.choiceControl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Classification')
  !this.headings.append('Name')

endmethod
-- End of method definition for .abaDrawList()

------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !this.ce = !!ce

  -- Clear data arrays and grids
  !this.clear('ALL')

  -- Get all available disciplines
  !this.getAllDisc()

  -- Get chosen disciplines
  !this.getDisc()

  -- Populate the grids for the current view
  !this.parseDisc()

endmethod

------------------------------------------------------------------------
define method .add()

  -- Get all selected rows
  !selectedRows = !this.optionsControl.getSelectedRowTags()

  -- For any selected disciplines
  if (!selectedRows.set()) then

    -- For each row
    do !row val !selectedRows

     -- Add the entry to the chosen array
     !this.choiceRefes.append(!this.optionsRefes[!row.real()])

    enddo

    -- Refresh the grids
    !this.parseDisc()

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .choicePopup()
--
-- Description: Pop-up for the choice grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .choicePopup(!array is ARRAY)

  -- Show the pop-up
   !this.choiceGrid.popup = !this.choicePopUp
   !this.choiceGrid.showPopup(!array[0], !array[1])

endmethod
-- End of method definition for .choicePopup()

------------------------------------------------------------------------
define method .cancel()

  hide !!abaDrawList

  !!ce = !this.ce

endMethod

------------------------------------------------------------------------
--
-- Method:      .clear(STRING)
--
-- Description: Clear relevant data arrays
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      What to clear ALL or GRIDS
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear(!what is STRING)

  -- Clear ALL
  if (!what.eq('ALL')) then

    -- Clear all data array
    !this.allRefes.clear()

    -- Clear choice data arrays
    !this.choiceRefes.clear()

  endif

  -- Clear options data arrays
  !this.optionsRefes.clear()

  -- Clear the grids
  !this.optionsControl.clearGrid()
  !this.choiceControl.clearGrid()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      .getAllDisc()
--
-- Description: Get all available disciplines
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAllDisc()

  -- Get defaults library location of all disciplines
  !this.allRefes = !!abaDefaults.disl.val.dbref().mem

  -- Test for any disciplines
  if (!this.allRefes.unset() or !this.allRefes.empty()) then
    !!alert.error('The AB ADP Library ' & !!abaDefaults.disl.val.dbref().flnm & ' is empty. Please contact your System Administrator.')
    return
  endif

  -- Initialise variables
  !optionsNames  = ARRAY()

  -- Sort all disciplines by name
  do !idliRefe val !this.allRefes
    !optionsNames.append(!idliRefe.name.after('/'))
  enddo
  !sorted = !optionsNames.sortedIndices()
  !this.allrefes.reindex(!sorted)

endmethod
-- End of method definition for .getAllDisc()

------------------------------------------------------------------------
--
-- Method:      .getDisc()
--
-- Description: Get the chosen disciplines
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDisc()

  -- Initialise variables
  !badRefs      = false

  -- Get view currently being modified
  !viewRefe = !!abaUserView.viewName

  -- Test for a valid drawlist
  if (!viewRefe.idln.badref()) then
    !!alert.error('The view being modified ' & !viewRefe.flnm & ' does not have a valid IDLN.')
    return
  endif

  -- Clear the grids
  !this.choiceControl.clearGrid()

  -- Get all currently chosen disciplines
  VAR !allIdli EVAL IDNM FOR ALL ADDE FOR IDLN OF $!viewRefe

  -- Build the array for the options grid
  do !idli val !allIdli

    -- Test for bad reference
    if (!idli.dbref().badref()) then
      !badRefs = true
      skip
    endif

    -- Store choice idli
    !this.choiceRefes.append(!idli.dbref())

  enddo

  -- Clean the view drawlist for empty or bad references
  if (!badRefs) then

    !answer = !!alert.question('The IDLN of view ' & !viewRefe.flnm & ' contains bad references. Would you like them to be cleared?')

    if (!answer.eq('YES')) then

      !ce = !!ce

      !!ce = !viewRefe.idln

      DELETE NULL IDLI
        handle any
        endhandle

      if (!ce.badref().not()) then
        !!ce = !ce
      endif

    endif

  endif

endmethod
-- End of method definition for .getDisc()

------------------------------------------------------------------------
--
-- Method:      .optionsPopup()
--
-- Description: Pop-up for the options grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .optionsPopup(!array is ARRAY)

  -- Show the pop-up
   !this.optionsGrid.popup = !this.optionsPopUp
   !this.optionsGrid.showPopup(!array[0], !array[1])

endmethod
-- End of method definition for .optionsPopup()

------------------------------------------------------------------------
--
-- Method:      .parseDisc()
--
-- Description: Parse the disciplines for the relevant grids
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .parseDisc()

  -- Initialise variables
  !optionsRowSet = ARRAY()
  !choiceRowSet  = ARRAY()

  -- Clear the data arrays and grids
  !this.clear('GRIDS')

  -- Build the array for the options grid
  do !idliRefe val !this.allRefes.difference(!this.choiceRefes)

    -- Initialise variables
    !rowData  = ARRAY()

    -- Store option idli
    !this.optionsRefes.append(!idliRefe)

    -- Build row data
    !rowData.append(!idliRefe.func)
    !rowData.append(!idliRefe.name.after('/'))

    -- Add row data to row set array
    !optionsRowSet.append(!rowData)

  enddo

  -- Build the chosen tasks array for the choice grid
  do !idliRefe val !this.choiceRefes

    -- Initialise variables
    !rowData  = ARRAY()

    -- Build row data
    !rowData.append(!idliRefe.func)
    !rowData.append(!idliRefe.name.after('/'))

    -- Add row data to row set array
    !choiceRowSet.append(!rowData)

  enddo

  -- Set the grids
  using namespace 'Aveva.Pdms.Presentation'
  !this.optionsControl.bindToDataSource(object NETDATASOURCE('Options', !this.headings, !optionsRowSet, '^Classification'))
  !this.choiceControl.bindToDataSource(object NETDATASOURCE('Options', !this.headings, !choiceRowSet, '^Classification'))

endmethod
-- End of method .parseDisc()

------------------------------------------------------------------------
define method .remove()

  -- Get all selected rows
  !selectedRows = !this.choiceControl.getSelectedRowTags()

  -- For any selected disciplines
  if (!selectedRows.set()) then

    -- For each row
    do !row val !selectedRows

     -- Remove the entry from the chosen array
     !this.choiceRefes.remove(!row.real())

    enddo

    -- Refresh the grids
    !this.parseDisc()

  endif


endmethod

------------------------------------------------------------------------
define method .selectAll(!what is STRING)

  if (!what.eq('OPTIONS')) then

    do !row from 1 to !this.optionsControl.getRows().size()
      !this.optionsControl.selectRow(!row)
    enddo

  else

    do !row from 1 to !this.choiceControl.getRows().size()
      !this.choiceControl.selectRow(!row)
    enddo

  endif



endMethod

------------------------------------------------------------------------
define method .setdislist()

-- Set all discipline types to the view layer ?/Discipline under a SLAB
-- setting the tmrf to point to the originating TXTM as defined in the
-- LALB in the template area used for disciplines.

-- Go around the list contained in the "current" list gadget, and add a
-- SLAB as above.

  !this.ce = !!abaUserView.viewName
  !!ce     = !this.ce

  -- Attempt to fix any idln reference problems
  !viewRefe = !!ce
  if (!viewRefe.idln.badRef()) then

    -- Test if dllb and idli exists
    !dllbName = !viewRefe.flnm & '/IDLIST'
    !idliName = !dllbName & '/IDLI'
    VAR !existDllb EXIST $!dllbName
    VAR !existIdli EXIST $!idliName

    -- Create necessary elements
    if (!existDllb.eq('FALSEA')) then

      -- Create the dllb & idli
      LIBY 1 OF DRWG
      NEW DLLB $!dllbName
       SpPurp ABAT

      NEW IDLI $!idliName
       SpPurp ABAT

      NEW ADDE

      IDLI
    elseif (!existIdli.eq('FALSEA')) then

      -- Create the idli
      DLLB $!dllbName

      NEW IDLI $!idliName
       SpPurp ABAT

      NEW ADDE

      IDLI

    else

      -- Set the idln to the idli
      IDLN $!idliName
      GOTO IDLN

    endif

  else

    GOTO IDLN

  endif

  -- First off delete all existing idli mem
  DELETE IDLI MEM

  -- Now build new list based on choice entries.

  do !idliRefe value !this.choiceRefes
    NEW ADDE IDNA $!idliRefe
  enddo

  hide !!abaDrawList

  !!ce = !this.ce

  !!abaUserView.isModified()

endmethod
