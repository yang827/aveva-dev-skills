-- File:            abadrtmplatt.pmlfrm
--   Type:          Form Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        <module>
--   Replaces:
--
-- Author:          Tony Martin
-- Created:         25th March 1999
--
--
-- Description:
-- <description>
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaDrTmplAtt()                   -                   Constructor method
--  apply()                          -                   Apply form settings
--  backOption()                     -                   Set backing sheet gadgets
--  getBacks()                       -                   Get backing sheets
--  getCirl()                        -                   Get circulation lists
--  getHatch()                       -                   Get hatching rules
--  getRule()                        -                   Get representation rules
--  init()                           -                   Form initialisation
--  nullChk()                        -                   Reset the original form settings
--  reset()                          -                   Reset the original form settings
--  selBackType(REAL)                -                   Select the backing sheet type
--  setBackingSheet()                -                   Set the backing sheet
--  setSize(STRING)                  -                   Set the sheet size
--
------------------------------------------------------------------------
setup form !!abaDrTmplAtt

  -- Initialise variables
  !gWidth    = 43
  !textwidth = !gWidth + 2
  !pfWidth   = !gWidth + 13

  -- Set form parameters
  title |Drawing Template Attributes|
  init |!this.init()|

    !uFrameWidth = 33.5

  -- Drawing Template name
  text .dbPos at x0.5 |Name| tagwidth 5 width 50 string
  path down

  -- Tab set
  frame .tabset TABSET 'tabset' anchor all

    -- Tab 1: Size, Backing Sheet and Units
    frame .page1 |Size & Units| dock fill

      -- Paper size
      para .pSize at x0.5 ymax text |Paper Size:|
      text .xSize |Width | at x1   ymax+0.2 tagwidth 5 call |!this.setSize('USIZE')| width 10 is REAL format !!distanceFMT
      path right
      text .ySize |Height| at xmax+0.5 ymin tagwidth 5 call |!this.setSize('USIZE')| width 10 is REAL format !!distanceFMT
      option .stdSiz       at xmax+0.5 ymin call |!this.setSize('STDSIZ')| width 10
      path down

      -- Backing sheet
      frame .bTag |Backing Sheet| at x0.5 ymax+1
        vdist 0.1
        rtoggle .bsOPT1 |Unset|  at x1 ymax-0.1   call |!this.backOption()|
        rtoggle .bsOPT2 |Reference|               call |!this.backOption()|
        rtoggle .bsOPT3 |Filename |               call |!this.backOption()|
        option  .bsrf at x13 ymin.bsOpt2+0.1      call |!this.backOption()| width $!gWidth
        text    .bsfn at xmin ymin_bsOPT3+0.1     call |!this.backOption()| width $!textwidth string
      exit

      -- Units
      frame .frUnits ' Units ' at xmax.bTag+0.5 y0.2 width $!uFrameWidth

        option .dUnits |Distance | at x1 ymin+0.8 tagwidth 7 width 17

        option .bUnits at xmin.dUnits ymax.dUnits+0.2 |Bore     | tagwidth 7 width 17

      exit

      -- Precision settingsymax.frUnits+0.2
      frame .frPrec ' Precision ' at xmin.frUnits ymin.bTag width $!uFrameWidth

        para .pcumeTlab  at x1 y0.9 text |Metric| width 8
        para .pcumeTlab1 at xmin.pcumeTlab ymax text |(dpls)| width 8
        text .pcumeTtxt  at xmin.pcumeTlab ymax+0.2 width 5 is REAL

        para .pcuimDlab  at xmax.pcumeTlab ymin.pcumeTlab text |Imperial| width 8
        para .pcuimDlab1 at xmin.pcuimDlab ymax text |(dpls)| width 8
        text .pcuimDtxt  at xmin.pcuimDlab ymax+0.2 width 5 is REAL

        para .pcuimFlab  at xmax.pcuimDlab ymin.pcumeTlab text |Fractions| width 8
        para .pcuimFlab1 at xmin.pcuimFlab ymax text |(ths)| width 8
        text .pcuimFtxt  at xmin.pcuimFlab ymax+0.2 width 5 is REAL

        para .pcuanGlab at xmax.pcuimFlab ymin_pcumeTlab text |Angles| width 8
        option .pcuanGopt at xmin.pcuanGlab ymax call |CALLDRG UUCODSEL $<_CDRLAYATT$> ANGOPTCALL| width 4

        text .pcuanGtxt at xmin.pcuanGopt ymin.pcuimFtxt width 6 is REAL

      exit
    exit

    -- Tab 2: Intelligent Text settings
    frame .page2 |Intelligent Text| at 0 0 dock Fill
      CALLDRG UITSMARINE ABADRTMPLATT SETUP $!pfWidth
    exit

    -- Tab 3: Pens
    frame .page3 |Pens| at 0 0 dock fill

      para .pTPEN text 'Text' width 10
      path right

      !!draColStyle.setup('TPEN', 1, '')

      para _textf at xmax+1 text |Font| width 4
      hdist 0

      CALLDRG FFONTS !!ABADRTMPLATT

      !gtab[1] = 'NLPN|Note line'
      !gtab[2] = 'LLPN|Leader line'
      !gtab[3] = 'LFPN|Label frame'
      !gtab[4] = 'PLPN|Projection line'
      !gtab[5] = 'DLPN|Dimension line'
      !gtab[6] = 'FPEN|Hatch pattern'

      do !s values !gtab
        !sTab = !s.split('|')
        !root  = !sTab[1]
        !title = !sTab[2]
        para .p$!root at xmin_pTPEN ymax+0.2 text |$!title| width 10
        !!draColStyle.setup(!root, 1, '')
      enddo

      path down
    exit

    -- Tab 4: Miscellaneous
    frame .page4 |Miscellaneous| at 0 0 dock Fill

      -- Null text
      text .nulltxt |Null text:| at x0.5 ymin+0.4 call |!this.nullChk()| tagwidth 15 width 12 is STRING
      path down
      vdis 0.3

      -- Terminators
      option .dterm |Dimension terminator| tagwidth 15 width 10
      option .lterm |Leader Terminator| tagwidth 15 width 10

      -- References
      option .rrsf  |Ruleset Reference|    tagwidth 15 WIDTH $!gWidth
      option .hrsf  |Hatching Ruleset Ref| tagwidth 15 WIDTH $!gWidth
      option .clrf  |Circulation list|     tagwidth 15 WIDTH $!gWidth

    exit

  exit

  -- Actions
  button .apply at x0.5 ymax+0.2 | Apply |
  path right
  hdist 30
  button .reset  | Reset | reset
  button .dismiss at xmax_tabset-size ymin | Dismiss | cancel

  member .drTmpl      is DBREF
  member .sizeSetting is STRING
  member .backSetting is STRING

exit

------------------------------------------------------------------------
--
-- Method:      .abaDrTmplAtt()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .abaDrTmplAtt()

  -- Form callbacks
  !this.apply.callback  = '!this.apply()'
  !this.reset.callback  = '!this.reset()'

  -- Populate option gadgets
  !dtext[1] = |Feet & Inches USA|
  !dtext[2] = |Feet & Inches|
  !dtext[3] = |Inches|
  !dtext[4] = |Inches USA|
  !dtext[5] = |Inches PDMS|
  !dtext[6] = |Millimetres|
  !dtext[7] = |Centimetres|
  !dtext[8] = |Metres|
  !rtext[1] = |FINCH USA|
  !rtext[2] = |FINCH|
  !rtext[3] = |INCH|
  !rtext[4] = |INCH USA|
  !rtext[5] = |INCH PDMS|
  !rtext[6] = |MM|
  !rtext[7] = |CM|
  !rtext[8] = |METRE|
  !this.dUnits.dtext = !dtext
  !this.dUnits.rtext = !rtext

  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext[1] = |Inches|
  !dtext[2] = |Inches USA|
  !dtext[3] = |Inches PDMS|
  !dtext[4] = |Millimetres|
  !dtext[5] = |Centimetres|
  !dtext[6] = |Metres|
  !rtext[1] = |INCH|
  !rtext[2] = |INCH USA|
  !rtext[3] = |INCH PDMS|
  !rtext[4] = |MM|
  !rtext[5] = |CM|
  !rtext[6] = |METRE|
  !this.bUnits.dtext = !dtext
  !this.bUnits.rtext = !rtext

  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext[1] = |Dpls|
  !dtext[2] = |Deg |
  !dtext[3] = |Min |
  !dtext[4] = |Sec |
  !rtext[1] = |DPLS|
  !rtext[2] = |DEGREES|
  !rtext[3] = |MINUTES|
  !rtext[4] = |SECONDS|
  !this.pcuanGopt.dtext = !dtext
  !this.pcuanGopt.rtext = !rtext

  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext[1] = |Off|
  !dtext[2] = |Arrows|
  !dtext[3] = |Dots|
  !dtext[4] = |Obliques|
  !rtext[1] = |OFF|
  !rtext[2] = |ARROWS|
  !rtext[3] = |DOT|
  !rtext[4] = |OBLIQUES|
  !this.dterm.dtext = !dtext
  !this.dterm.rtext = !rtext
  !this.lterm.dtext = !dtext
  !this.lterm.rtext = !rtext

  -- Set gadget status
  !this.dbPos.setEditable(false)

endmethod
-- End of method definition for .abaDrTmplAtt()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Form initialisation
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !this.drTmpl = !!abaTemplateDrg.drTmpl

  -- Set name
  !this.dbPos.val = !this.drTmpl.flnm

  -- Set paper size gadgets
  !!abaPaperSizes(!this.stdSiz)

  -- Select paper size
  !this.xSize.val = !this.drTmpl.size[1]
  !this.ySize.val = !this.drTmpl.size[2]
  !this.stdSiz.select('RTEXT',!this.drTmpl.size[1] & ' ' & !this.drTmpl.size[2])
    handle (61,567)
      !this.stdSiz.select('RTEXT',' ')
    endhandle

  -- Store original size
  !this.sizeSetting = !this.xSize.val & ' ' & !this.ySize.val

  -- Set the backing sheet gadgets
  !this.setBackingSheet()

  -- Bore and Distance units
  var !dUnits split ucodd of $!this.drTmpl
  !this.dUnits.select('RTEXT',!dUnits[1].upCase())
    handle any
      !!alert.error('Unable to select correct distance units')
    endhandle

  var !bUnits split ucodb of $!this.drTmpl
  !this.bUnits.select('RTEXT',!bUnits[1].upCase())
    handle any
      !!alert.error('Unable to select correct bore units')
    endhandle

  -- Precision
  var !pCodeM split PCODM
  var !pCodeI split PCODI
  var !pCodeF split PCODF
  var !pCodeA split PCODA

  !this.pcumettxt.val = !pCodeM[3].real()
  !this.pcuimdtxt.val = !pCodeI[3].real()
  !this.pcuimftxt.val = !pCodeF[3].real()

  !pChk = !pCodeA[3].upCase()
  if (!pChk.eq('DEGREES') or !pChk.eq('MINUTES') or !pChk.eq('SECONDS')) then
    !this.pcuangopt.select('RTEXT',!pChk)
    !this.pcuangtxt.active = false
  else
    !this.pcuangopt.select('RTEXT','DPLS')
    !this.pcuangtxt.active = true
    !this.pcuangtxt.val = !pChk.real()
  endif

  -- Load grid data
  $M "%PDMSUI%/DRA/GEN/UITSMARINE" ABADRTMPLATT INIT
  $M "%PDMSUI%/DRA/GEN/UITSMARINE" ABADRTMPLATT CALLBACK

  -- Manage colour & style setup
  !!draColStyle.onInit()
  !!draColStyle.updateGadgets('TPEN')
  !!draColStyle.updateGadgets('NLPN')
  !!draColStyle.updateGadgets('LLPN')
  !!draColStyle.updateGadgets('LFPN')
  !!draColStyle.updateGadgets('PLPN')
  !!draColStyle.updateGadgets('DLPN')
  !!draColStyle.updateGadgets('FPEN')
  !!draColStyle.loadUserStyles()
  !!draColStyle.setColour('TPEN', !this.drTmpl.txconu)
  !!draColStyle.setColour('NLPN', !this.drTmpl.nlconu)
  !!draColStyle.setStyle('NLPN', !this.drTmpl.nlstyl)
  !!draColStyle.setColour('LLPN', !this.drTmpl.llconu)
  !!draColStyle.setStyle('LLPN', !this.drTmpl.llstyl)
  !!draColStyle.setColour('LFPN', !this.drTmpl.lfconu)
  !!draColStyle.setStyle('LFPN', !this.drTmpl.lfstyl)
  !!draColStyle.setColour('PLPN', !this.drTmpl.plconu)
  !!draColStyle.setStyle('PLPN', !this.drTmpl.plstyl)
  !!draColStyle.setColour('DLPN', !this.drTmpl.dlconu)
  !!draColStyle.setStyle('DLPN', !this.drTmpl.dlstyl)
  !!draColStyle.setColour('FPEN', !this.drTmpl.fconum)
  !!draColStyle.setStyle('FPEN', !this.drTmpl.fstyle)

  -- Initialise Font gadget _FONT
  $M "%PDMSUI%/DRA/GEN/IFONTS" FONT

  -- Null text
  if (!this.drTmpl.ntext.eq('')) then
    !this.nulltxt.val = 'unset'
  else
    !this.nulltxt.val = !this.drTmpl.ntext
  endif

  -- Dimension terminator
  !this.dterm.select('RTEXT',!this.drtmpl.dterm.upCase())

  -- Leader line terminator
  !this.lterm.select('RTEXT',!this.drtmpl.lterm.upCase())

  -- Representation ruleset
  !this.getRule()

  -- Populate the representation rule set gadget
  if (!this.drtmpl.rrsf.badref().not()) then
    !this.rrsf.select('RTEXT',!this.drtmpl.rrsf.string())
      handle any
      endhandle
  endif

  -- Hatching rule
  !this.getHatch()

  -- Populate the hatch rule set gadget
  if (!this.drtmpl.hrsf.badref().not()) then
    !this.hrsf.select('RTEXT',!this.drtmpl.hrsf.string())
      handle any
      endhandle
  endif

  -- Get circulation lists
  !this.getCirl()

  -- Populate the circulation list gadget
  if (!this.drtmpl.crsf.badref().not()) then
    !this.clrf.select('RTEXT',!this.drtmpl.crsf.string())
      handle any
      endhandle
  endif

endmethod
-- End of method .init()

------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Apply form settings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- Set size
  SIZE $!this.xSize $!this.ySize

  -- Set backing sheet
  BSRF $!this.bsrf
  BSFN $!this.bsfn

  -- Access the drawing template
  !!ce = !this.drtmpl

  -- Set inits
  UCOD $!this.dUnits DIST $!this.bUnits BORE
   handle any
   endhandle

  -- Set precision
  PCODE LINEAR MM TO $!this.pcumettxt DPLS
  PCODE LINEAR INCHES TO $!this.pcuimdtxt DPLS
  PCODE LINEAR FRACTIONS TO $!this.pcuimftxt THS

  if(!this.pcuangopt.selection('RTEXT').eq('DPLS')) then
    PCODE ANGLES TO $!this.pcuangtxt DPLS
  else
    PCODE ANGLES TO $!this.pcuangopt
  endif

  -- Intelligent text
  $M "%PDMSUI%/DRA/GEN/UITSMARINE" ABADRTMPLATT APPLY

  -- Pens
  !rTPEN = !!draColStyle.getData('TPEN')
  !rNLPN = !!draColStyle.getData('NLPN')
  !rLLPN = !!draColStyle.getData('LLPN')
  !rLFPN = !!draColStyle.getData('LFPN')
  !rPLPN = !!draColStyle.getData('PLPN')
  !rDLPN = !!draColStyle.getData('DLPN')
  !rFPEN = !!draColStyle.getData('FPEN')

  if( !rTPEN[1] and !rNLPN[1] and !rLLPN[1] and !rLFPN[1] and !rPLPN[1] and !rDLPN[1] and !rFPEN[1] ) then
    TXCOLO $!rTPEN[2]
    NLCOLO $!rNLPN[2]
    NLSTYL $!rNLPN[3]
    LLCOLO $!rLLPN[2]
    LLSTYL $!rLLPN[3]
    LFCOLO $!rLFPN[2]
    LFSTYL $!rLFPN[3]
    PLCOLO $!rPLPN[2]
    PLSTYL $!rPLPN[3]
    DLCOLO $!rDLPN[2]
    DLSTYL $!rDLPN[3]
    FCOLOU $!rFPEN[2]
    FSTYLE $!rFPEN[3]
  else
    !!alert.warning(|Error setting drawing's colour and style attributes!|)
  endif

  -- Font
  !font = !this.font.selection()
  if( !font.empty() ) then
    !rText = !this.font.rText
    if( set(!rText.findFirst('*TTF')) ) then
      !font = !!fontManager.firstTTFid.string()
    else
      !font = '1'
    endif
  endif

  FONT $!font
    handle (64,831)
      !!alert.warning('TrueType fonts are incompatible with the other settings. The font has not been set!')
    elsehandle (64,832)
      !!alert.warning('PDMS fonts are incompatible with the other settings. The font has not been set!')
    elsehandle any
      -- Element probably does not have FONT attribute
    endhandle

  -- Null text
  NTEXT |$!this.nulltxt|

  -- Terminators
  DTERM $!this.dterm
  LTERM $!this.lterm

  -- Representation ruleset
  RRSF $!this.rrsf
    handle any
      !!alert.warning('Unknown error in setting the representation ruleset.')
    endhandle

  -- Hatching Ruleset
  HRSF $!this.hrsf
    handle any
      !!alert.warning('Unknown error in setting the hatching ruleset.')
    endhandle

  -- Circulation list
  CLRF $!this.clrf
    handle any
      !!alert.warning('Unknown error in setting the circulation ruleset.')
    endhandle

endmethod
-- End of method .apply()

------------------------------------------------------------------------
--
-- Method:      .backOption()
--
-- Description: Set backing sheet gadgets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .backOption()

  -- Access the DRTMPL
  !!ce = !this.drtmpl

  -- Unset
  if (!this.bsOPT1.val) then

    !this.selBackType(1)

    BSRF =0/0

  elseif (!this.bsOPT2.val) then

    !bsrf = !this.bsrf.selection('RTEXT')

    !this.selBackType(2)

    BSRF $!bsrf
      handle (64,837)
        -- Cannot set backing sheet reference to BACKINGSHEET, as it has incompatible font settings
        !!alert.error('The chosen sheet is not valid as it contains incompatible font setting.')
        !this.bsrf.select('DTEXT','unset')
      endhandle

  else

    !bsfn = !this.bsfn.val

    !this.selBackType(3)

    if (!bsfn.neq('unset')) then

      BSFN $!bsfn
        handle (64,417)

          -- Cannot open Plotfile
          !!alert.error('Cannot find entered plotfile. The backing sheet remains unset.')
          BSFN UNSET

          -- Reset the gadget
          !this.bsfn.val    = 'unset'

        elsehandle(64,145)

          -- Plotfile is of the wrong size to use
          !!alert.error('The entered plotfile size does not match the ' & !!ce.type & '. The backing sheet remains unset.')
          BSFN UNSET

          -- Reset the gadget
          !this.bsfn.val    = 'unset'

        endhandle

    endif

  endif

endmethod
-- End of method .backOption()

------------------------------------------------------------------------
--
-- Method:      .getBacks()
--
-- Description: Get backing sheets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getBacks()

  -- Initialise variables
  !backRefs = ARRAY()
  !backName = ARRAY()

  -- Add an unset option
  !backName.append('unset')
  !backRefs.append('=0/0')

  -- Read the selected size
  !size = !this.stdSiz.selection('RTEXT')

  -- Get all available backing sheets
  VAR !allBacks COLL ALL BACK

  -- Extract backing sheet data with the same size as this sheet
  do !back val !allBacks

    !backRefe  = !back.dbref()
    !sizeArray = !backRefe.size
    !backSize  = !sizeArray[1] & ' ' & !sizeArray[2]

    if (!backSize.eq(!size)) then
      !backName.append(!backRefe.flnm)
      !backRefs.append(!backRefe.string())
    endif

  enddo

  -- Set backing sheet gadgets
  !this.bsrf.dtext = !backName
  !this.bsrf.rtext = !backRefs

endmethod
-- End of method .getBacks()

------------------------------------------------------------------------
--
-- Method:      .getCirl()
--
-- Description: Get circulation lists
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getCirl()

  -- Try the standard appware setup
  !cirlLocation = !!cdrUdflts.clrf.val.dbref()
    handle (2,109)
      -- Undefined name
    endhandle

  -- Get all cirl available
  if (!cirlLocation.badref()) then

    VAR !allCirls COLL ALL CIRL

  -- Get all cirl for set location
  else

    VAR !allCirls COLL ALL CIRL FOR $!cirlLocation

  endif

  -- Get names
  var !allNames EVAL NAME FOR ALL FROM !allCirls

  -- Add unset option
  !allCirls.insert(1,'=0/0')
  !allNames.insert(1,'unset')

  -- Populate the gadget
  !this.clrf.dtext = !allNames
  !this.clrf.rtext = !allCirls

endmethod
-- End of method .getCirl()

------------------------------------------------------------------------
--
-- Method:      .getHatch()
--
-- Description: Get hatching rules
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getHatch()

  -- Try the standard appware setup
  !hrstLocation = !!cdrUdflts.hrsf.val.dbref()
    handle (2,109)
      -- Undefined name
    endhandle

  -- Get all hrst available
  if (!hrstLocation.badref()) then

    VAR !allHrst COLL ALL HRST

  -- Get all hrst for set location
  else

    VAR !allHrst COLL ALL HRST FOR $!hrstLocation

  endif

  -- Get names
  var !allNames EVAL NAME FOR ALL FROM !allHrst

  -- Add unset option
  !allHrst.insert(1,'=0/0')
  !allNames.insert(1,'unset')

  -- Populate the gadget
  !this.hrsf.dtext = !allNames
  !this.hrsf.rtext = !allHrst

endmethod
-- End of method .getHatch()

------------------------------------------------------------------------
--
-- Method:      .getRule()
--
-- Description: Get representation rules
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getRule()

  -- Try the standard appware setup
  !rrstLocation = !!cdrUdflts.rrsf.val.dbref()
    handle (2,109)
      -- Undefined name
    endhandle

  -- Get all rrst available
  if (!rrstLocation.badref()) then

    VAR !allRrst COLL ALL RRST

  -- Get all rrst for set location
  else

    VAR !allRrst COLL ALL RRST FOR $!rrstLocation

  endif

  -- Get names
  var !allNames EVAL NAME FOR ALL FROM !allRrst

  -- Add unset option
  !allRrst.insert(1,'=0/0')
  !allNames.insert(1,'unset')

  -- Populate the gadget
  !this.rrsf.dtext = !allNames
  !this.rrsf.rtext = !allRrst

endmethod
-- End of method .getRule()

------------------------------------------------------------------------
--
-- Method:      .nullChk()
--
-- Description: Reset the original form settings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .nullChk()

  -- Set null text
  if (!this.nulltxt.val.length().gt(12)) then
    !!alert.error ('Maximum text length is 12 characters')
  endif

endmethod
-- End of method .nullChk()

------------------------------------------------------------------------
--
-- Method:      .reset()
--
-- Description: Reset the original form settings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reset()

  -- Access the drawing template
  !!ce = !this.drtmpl

  -- Reset the size and backing sheet, since these were set directly when chosen
  SIZE $!<this.sizeSetting>
  $!<this.backSetting>

  -- Reset all gadgets
  !this.init()

endmethod
-- End of method .reset()

------------------------------------------------------------------------
--
-- Method:      .setBackingSheet()
--
-- Description: Set the backing sheet
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setBackingSheet()

  -- Get all backing sheets
  !this.getBacks()

  -- No backing sheet
  if (!this.drTmpl.bsrf.unset() and !this.drTmpl.bsfn.eq('')) then

    -- Select the Unset toggle option
    !this.selBackType(1)

    -- Store this setting
    !this.backSetting = 'BSRF =0/0 BSFN UNSET'

  else

    -- Backing sheet reference
    if (!this.drTmpl.bsrf.badref().not()) then

      -- Select the Reference toggle option & choose the relevant BACK
      !this.selBackType(2)
      !this.bsrf.select('RTEXT',!this.drTmpl.bsrf.string())

      -- Store this setting
      !this.backSetting = 'BSRF ' & !this.drTmpl.bsrf

    -- Backing sheet from file
    else

      -- Select the Filename toggle option & set the value
      !this.selBackType(3)
      !this.bsfn.val = !this.drTmpl.bsfn

      -- Store this setting
      !this.backSetting = 'BSFN ' & !this.drTmpl.bsfn

    endif

  endif

endmethod
-- End of method .setBackingSheet()

------------------------------------------------------------------------
--
-- Method:      .selBackType(REAL)
--
-- Description: Select the backing sheet type
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        radio toggle gadget to be selected
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selBackType(!number is REAL)

  -- Set relevant radio gadget
  if (!number.eq(1)) then

    !this.bsOPT1.val = true

    !this.bsrf.select('DTEXT','unset')
    !this.bsfn.val    = 'unset'

    !this.bsrf.active = false
    !this.bsfn.active = false

  elseif (!number.eq(2)) then

    !this.bsOPT2.val = true
    !this.bsfn.val    = 'unset'

    !this.bsrf.active = true
    !this.bsfn.active = false

  elseif (!number.eq(3)) then

    !this.bsOPT3.val = true

    !this.bsrf.select('DTEXT','unset')

    !this.bsrf.active = false
    !this.bsfn.active = true

  endif

endmethod
-- End of method .selBackType(REAL)

------------------------------------------------------------------------
--
-- Method:      .setSize(STRING)
--
-- Description: Set the sheet size
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      USIZE  when the value is user defined
--                           STDSIZ when the value is system defined
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSize(!option is STRING)

  -- Access the DRTMPL
  !!ce = !this.drtmpl

  -- Set standard size
  if (!option.eq('STDSIZ')) then

    if (!this.stdSiz.selection('RTEXT').neq(' ')) then

      -- Set unstandard gadgets
      !this.xSize.val = !this.stdSiz.selection('rtext').split()[1].real()
      !this.ySize.val = !this.stdSiz.selection('rtext').split()[2].real()

      -- Set drwg
      !size = !this.stdSiz.selection('RTEXT')
      SIZE $!size
        handle (64,358)
          -- Illegal paper size
          !!alert.error('Given size is not a legal paper size')
          return
        endhandle

    else
      return
    endif

  else

    -- Set Unstandard size
    SIZE $!this.xSize.val $!this.ySize.val
      handle (64,358)
        -- Illegal paper size
        !!alert.error('Given size is not a legal paper size')
        return
      endhandle

    -- Select standard size if possible
    !this.stdSiz.select('RTEXT',!this.drTmpl.size[1] & ' ' & !this.drTmpl.size[2])
      handle (61,567)
       !this.stdSiz.select('RTEXT',' ')
      endhandle

  endif

  -- Reset the backing sheet gadgets
  !this.getBacks()

  -- Reselect the backing sheet if necessary
  !this.backOption()

endmethod
-- End of method .setSize(STRING)
