--
-- Description: List of available drawings for Modification.
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -
--  init()                           -
--  setDrwg(STRING)                  -
--
------------------------------------------------------------------------
setup form !!abaDrwgList
------------------------------------------------------------------------
   title |ABA Template Sheet List|
   init |!this.init()|
   cancelcall |!this.cancel()|

   List .DrwgList |Template Sheets| call |!this.SetDrwg(!this.DrwgList.selection('RTEXT'))| columns width 40 hei 12
    !h[1] =  'Name'
    !h[2] = 'Title'
   !this.Drwglist.setheadings(!h)
member .MODE is STRING
exit

------------------------------------------------------------------------
define method .init()
------------------------------------------------------------------------
--
   !savePos = !!ce
   !dtext = array()
   !rtext = array()
   var !a collect all drwg for $!!abaDefaults.dlib.val
   var !b eval name for all from !a
   do !x values !b
      !!ce = !x.dbref()
      --!size = !this.drwglist.tag.match('Desc') - 3
      !dtext.append(!x & '	' & !!ce.title)
      !rtext.append(!x)
   enddo

   !!ce = !savePos
   !a = !dtext.sortedindices()

   !this.DrwgList.Dtext = !dtext.reindex(!a)
   !this.DrwgList.Rtext = !rtext.reindex(!a)

endMethod

------------------------------------------------------------------------
define method .setDrwg(!Selection is STRING)
------------------------------------------------------------------------

  !!abaDrwgList.Hide()

endMethod

------------------------------------------------------------------------
define method .cancel()
------------------------------------------------------------------------

  !!abaDrwgList.hide()
  !!abaProcess.visible()

endMethod
