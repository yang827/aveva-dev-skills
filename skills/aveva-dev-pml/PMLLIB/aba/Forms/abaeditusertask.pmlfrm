-- File:            abaEditAreaDef
--   Type:          Form Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        <module>
--   Replaces:
--
-- Author:          Martin Wright
-- Created:         12 Mar 1999
--
--
-- Description:
-- <description>
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  SaveViewTask(ABATASK,REAL)       -
--  ViewParams(REAL)                 -
--  checkForSpaces(STRING)           -                   <Saves View Task After Edit Has Occurred.>
--  init()                           -
------------------------------------------------------------------------

setup form !!abaEditUserTask blocking
Title 'Task Modification'
init '!this.init()'
path down
text .name   |Name       | call |!this.checkForSpaces(!this.name.val)| width 25 is STRING
text .desc   |Description| call || width 35 is STRING
text .oper   |Function   | call || width 18 is STRING
list .params |Parameter           Description | call |!This.ViewParams(!This.Params.val)| Width 44 height 6
path down
button .ok      '  OK  ' call |!this.saveViewTask(!this.task,!This.Number)| OK
path right
button .dismiss 'Cancel' at xmax form-size call |kill !!abaeditusertask| CANCEL

member .Task is ABATASK
member .Number is REAL

!this.name.setEditable(FALSE)
!this.desc.setEditable(FALSE)
!this.oper.setEditable(FALSE)

exit
-- End of form definition


------------------------------------------------------------------------
define method .init()
------------------------------------------------------------------------
--
loadform !!abaModifyTask
--
            !this.ok.tag = ' OK '
            !this.name.val = !this.task.Name
            !this.desc.val = !this.task.Description
            !this.oper.val = !this.task.Execute
--
            !dtext = ARRAY()
--
            do !x values !this.task.getParam()
               !dtext.append(!x)
            enddo
--
            !!abaEditUserTask.Params.Dtext = !dtext

            !!abaEditUserTask.Params.Rtext = !dtext
--
endmethod
-- End of method definition for abaEditViewTask


------------------------------------------------------------------------
define method .ViewParams(!pos is REAL)
------------------------------------------------------------------------
-- Method for viewing the parameters for the viewing tasks available.
-- Index is index from viewtasks array.
--
   !!abaModifyTask.Number = !pos
   !!abaModifyTask.Task = !This.Task
   show !!abaModifyTask
--
--
endmethod
-- End of method definition for .viewParams



------------------------------------------------------------------------
define method .SaveViewTask(!a is ABATASK,!b is REAL)
------------------------------------------------------------------------
--
      !!abaDefaults.viewtasks.replaceTask(!a,!b)
--

endmethod

------------------------------------------------------------------------
--
-- Method:      checkForSpaces()
--
-- Description: <Saves View Task After Edit Has Occurred.>
--
-- Method Type: <Procedure/Function>
--
------------------------------------------------------------------------
define method .checkForSpaces(!a is STRING)
------------------------------------------------------------------------

if (!a.split().size() NE 1) then
    !!alert.error('No Spaces allowed in Task name - re-enter')
endif

endmethod
