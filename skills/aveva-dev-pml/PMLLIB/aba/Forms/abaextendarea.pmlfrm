--
-- Form to set the view cdlimits attribute to a value for extending
-- the applied aba area
-----------------------------------------------------------
setup form !!abaextendarea
  init '!this.init()'
  title 'Extend Area Settings'
  text .value 'Extend Area By' width 12 is real
  path down

  button .ok 'OK' call '!this.ok()' ok
  button .cancel 'Cancel' at xmax form - size ymin cancel
  member .ViewName is dbref

exit
-----------------------------------------------------------
define method .init()

  !this.value.val = !this.viewname.:cdlimits.real()
  handle any
  !this.value.val = 0
  endhandle

endmethod
-----------------------------------------------------------
define method .ok()

   !this.viewname.:cdlimits = !this.value.val.string()

endmethod

-----------------------------------------------------------
