--
-- Description:
-- Main process form, controls the collection of data for subsequent processing of
-- list of drawing elements, objects.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaFileList()                    -
--  apply(STRING)                    -
--  cancel()                         -
--  doCommand()                      -
--  fileRead(STRING)                 -
--  filesCall()                      -
--  homeDir()                        -
--  init()                           -
--  makeCmnd()                       -
--  osCommand()                      -
--  remove()                         -
--  reset()                          -
--  reverseSort()                    -
--  subDirs()                        -
--  toggleChk(STRING)                -
--  topDir()                         -
--
------------------------------------------------------------------------
setup form !!abaFileList

  init |!this.init()|
  cancelcall |!this.cancel()|

  title 'Area ADP File Browser'

  path right

  para .cwd at 0 0 text 'Current Directory'
  button .home 'Home Directory' at x 43 CallBack '!this.homeDir()'

  path down

  text .dirName callback '!this.topDir()' at x 0 width 58 is STRING
  list .subDirs 'Sub Directories' callBack '!this.subDirs()' width 57 hei 6
  list .files   'Files' CallBack '!this.filesCall()' width 57 hei 9

  para .action at x1 ymax.files+0.2 text 'Apply Action'
  text .selection '' at xmax.action-2 ymin.action width 47 is STRING

  rgroup .edit '' frame horizontal at xmin ymax+0.2
    add tag 'Load..'   select 'Load'   call ||
    add tag 'Edit..'   select 'Edit'   call ||
    add tag 'Delete..' select 'Delete' call ||
  exit

  button .ok ' Apply ' at x0 ymax call '!this.apply(!this.edit.selection())'

  path right

  button .dismiss 'Dismiss' at xmax form-size Ymin call |!this.cancel()| cancel

  menu .pop1
    !this.pop1.add ('CALLBACK','Reverse Sort',|!this.reverseSort()|)
    !this.files.setpopup(!this.pop1)

  !this.dirName.val = !!abaDefaults.logpath
    handle any
      !this.dirName.val = 'c:\'
    endhandle

  member .text      is ARRAY
  member .mode      is BOOLEAN
  member .whereFrom is STRING
  member .font      is STRING

exit

-- ======================================================
define method .abaFileList()
-- ======================================================

  !!machine = 'NT'
  !!slash ='\'
  !!mkdir = 'mkdir'
  !!rm = 'del'
  !!set = 'set'
  !!setoptions1 = '| findstr /I /V "Path"'
  !!tmpdir = '%TEMP%'
  !!tmpFile = '%TEMP%\tmplog'
  !!editor = |notepad|

endmethod

-- ======================================================
define method .reverseSort()
-- ======================================================

  !temp = !this.files.dText
  !this.files.dText = !temp.invert()

endmethod

-- ======================================================
define method .cancel()
-- ======================================================

  !this.mode = FALSE
  if (!this.whereFrom eq 'PROCESS') then
      if (!!abaProcess.shown().not()) then
          show !!abaProcess
      endif
  endif
  !!abaFileList.ok.tag      = ' Apply '
  !!abaFileList.dismiss.tag = 'Dismiss'

endmethod

-- ======================================================
define method .osCommand()
-- ======================================================

  !a = !this.os.selection()
  $!a

endmethod

-- ======================================================
define method .init()
-- ======================================================
  !file = object FILE(!this.dirName.val)
  if (!file.exists() ne TRUE) then
     !!alert.message('Directory $!this.dirName.val Not Found -- Reset to "."')
     !this.dirName.val = '.'
     !this.init()
  else
    !this.dirName.val = !file.fullName()
    !subDirs = !file.subDirs()
    !a[1] = '..'
    do !x values !subDirs
      !a.append(!x.fullName())
    enddo
    !this.subDirs.dText = !a
    !b = ARRAY()
    !files = !file.files()
    do !x values !files
      !b.append(!x.entry())
    enddo
    if (!this.whereFrom.eq('PDMSABADATA')) then
      !this.files.dText = !b.sort()
    else
      !this.files.dText = !b.sort().invert()
    endif
  endif
$(
   !this.files.callback = '!this.fileRead(|FALSE|)'

   if (!this.mode eq TRUE) then
       !this.ok.active = FALSE
   else
       !this.ok.active = TRUE
   endif
$)

endmethod

-- ======================================================
define method .filesCall()
-- ======================================================

  if (!this.whereFrom eq 'PDMSDFLTS') then
    !this.selection.val = !this.files.selection('DTEXT')
  endif

endmethod

$( TL: Commented out, as it seems to be unused and contains references
       to missing form members!!!
-- ======================================================
define method .toggleChk(!button is STRING)
-- ======================================================

  !this.readFile.active = TRUE
  if ( !button eq 'Edit' and !this.editorNot.val eq TRUE) then
    if ( !this.editorNot.val eq TRUE ) then
      !this.readorNot.val = False
      !this.readFile.active = FALSE
    elseif ( !this.editorNot.val eq FALSE ) then
       !this.readorNot.val = True
    endif

  elseif ( !button eq 'Read' and !this.readorNot.val eq TRUE) then
    if ( !this.readorNot.val eq TRUE ) then
      !this.editorNot.val = False
      !this.readFile.active = FALSE
    elseif ( !this.readorNot.val eq FALSE ) then
      !this.editorNot.val = True
    endif
  endif

endmethod
$)

-- ======================================================
define method .subDirs()
-- ======================================================

  if (!this.subDirs.val eq 1) then
    !input = object FILE(!this.dirName.val)
    !this.dirName.val = !input.directory().fullName()
  else
    !this.dirName.val = !this.subDirs.dText[!this.subDirs.val]
  endif
  !this.init()

endmethod

-- ======================================================
define method .homeDir()
-- ======================================================
  !this.dirName.val = '.'
  !this.init()
endmethod

-- ======================================================
define method .topDir()
-- ======================================================
  !this.init()
endmethod

-- ======================================================
define method .apply(!action is STRING)
-- ======================================================

  if( !this.whereFrom.eq('ABADEFAULTS') ) then

    if (unset(!this.selection.val)) then
      !!alert.error('No "Save as" Filename Specified')
    else
      !fname = !this.dirName.val & !!slash & !this.selection.val
      !file = object FILE(!fname)
      !file.writeFile('over',!this.text)
      !!abaFileList.action.val = 'Apply Action'
      !!abaFileList.selection.active = False
      !!abaFileList.edit.active = True
      !!abaFileList.selection.val = ''
      !!abaFileList.ok.tag      = ' Apply '
      !!abaFileList.dismiss.tag = 'Dismiss'
      !!abaFileList.hide()
    endif

  else

    !f = object FILE(!this.dirName.val & !!slash & !this.files.dText[!this.files.val])
    if( !action.eq('Delete') ) then
      !a = !!alert.question('OK to remove $!f')
      if( !a.eq('YES') ) then
        !f.deleteFile()
      endif
      !this.init()
      return
    endif

    !this.text = !f.readFile(100000)
    handle any
      !!alert.warning('File Error Has Occurred - Contact your system Administrator')
      return
    endhandle

    golabel /$!action

    label /Load
    if( !this.whereFrom.eq('PDMSABADATA') ) then

      -- Run the selected macro passing the selected font
      $M "$!f" $!<this.font>

    elseif( !this.whereFrom.eq('PDMSDFLTS') ) then

      -- Check if selected files is a Area Based ADP defaults file
      !cFile = object FILE(!!abaFileList.dirName.val + '\' + !!abaFileList.files.selection())
      !cFileContents = !cFile.readFile()
      handle (160,9)
        !!alert.error('The specified defaults file does not exist')
        return
      endhandle

      !start = !cFileContents.findFirst('-- Section 1')
      !end   = !cFileContents.findFirst('-- End Section 1')

      if( !start.unset() or !end.unset() ) then
        !!alert.error('The specified file is not a Area Based ADP defaults file!.')
        return
      endif

      !!abaDefaults.defaultsfile.val = !!abaFileList.dirName.val + '\' + !!abaFileList.files.selection()
      !!abaDefaults.file             = object FILE(!!abaDefaults.defaultsfile.val)
      !!abaDefaults.init()
      !!abaFileList.hide()

    elseif (!this.whereFrom eq 'PROCESS') then

      !!abaFileList.hide()
      if( !!abaProcess.shown().not() ) then
        show !!abaProcess cen xr .5 yr .5
      endif
      !!abaProcess.loadLogFile(!this.dirName.val & !!slash & !this.files.selection())

    endif

    return

  endif

  label /Edit

  SYSCOM |$!!editor $!f &|
  handle ANY
  endhandle

  return

  label /Read

  -- !this.reset.active = True
  !this.files.dText = !f.readFile()

  return

endmethod
$( TL: Commented out, as it seems to be unused and contains references
       to missing form members!!!
-- ======================================================
define method .fileRead(!choice is STRING)
-- ======================================================
--
  if ( !!machine eq 'NT' ) then
    !sep = '\'
  else
    !sep = '/'
  endif
  !f = object FILE(!this.dirName.val & !sep & !this.files.dText[!this.files.val])

  !this.text = !f.readFile()
  handle any
    !!alert.warning('File Error Has Occurred, try another file')
    return
  endhandle

-- q var !choice !this.editorNot.val !this.readorNot.val

  if( !choice.eq('TRUE') and !this.whereFrom.eq('PDMSABADATA') ) then
    $M "$!f"
    return
  endif

  if( !choice.neq('TRUE') ) then
     if ( !choice eq 'READ' or !choice eq 'EDIT' ) then
       !this.fileRead(|FALSE|)
       return
     endif
  elseif ( !choice eq 'TRUE') then
    !this.editorNot.val = FALSE
    !this.readorNot.val = FALSE
    !!abaFileList.hide()
    !!abaProcess.loadLogFile(!this.dirName.val & !!slash & !this.files.selection())
  endif

  if ( !choice.eq('READ') or !this.readorNot.val eq TRUE ) then
    !this.files.dText = !this.text
-- PDMS11.3 change, Neale Morris, 30/03/2001
        -- !this.reset.active = TRUE

  elseif ( !this.editorNot.val eq TRUE or !choice.eq('EDIT') ) then

    if (!!machine eq 'NT') then
--         $P Windows NT
--         $P $!f
      syscom |C:\WINNT\system32\notepad.exe $!f &|

    elseif (!!machine eq 'HP-UX') then
--         $P Hewlett Packard
      syscom |textedit $!f &|

    elseif (!!machine eq 'IRIX') then
--         $P Silicon Graphics
      syscom |jot $!f &|
    endif

  endif
endmethod
$)
-- ======================================================
define method .reset()
-- ======================================================
  !a = ARRAY()
  !fff = !!tmpdir & !!slash & 'fff'
  !file = object FILE(!fff)
  !file.writeFile('OVERWRITE',!this.files.dText)
  !this.init()
  !this.reset.active = FALSE
endmethod


-- ======================================================
define method .remove()
-- ======================================================
  !file = !this.dirName.val & '\' & !this.files.selection()
  !a = !!alert.question('OK to remove $!file')
  if( !a.eq('YES') ) then
    syscom '$!!rm $!file'
  endif
  !this.init()
endmethod

-- ======================================================
define method .makeCmnd()
-- ======================================================
  if (!!fileList.files.selection() eq '.. (Back One)') then
    !a = !!saveString.split()
    !n = (!a.size() - 1)
    !newString = ''
    do !x from 1 to !n
      !newString = !a[!x] + ' '
    enddo
    !!fileList.command.val = !newString
    !!fileList.makeQlist(!newString)
  else
    !!fileList.command.val = !!fileList.command.val + !!fileList.files.selection() + ' '
    !!fileList.makeQlist(!!fileList.command.val)
  endif
  !!saveString = !!fileList.command.val
endmethod

-- ======================================================
define method .doCommand()
-- ======================================================
  !commandTxt = !!fileList.command.val
  !!fileList.command.val = ''
  $!commandTxt
endmethod
