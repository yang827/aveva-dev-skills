--
--
-- Description:
-- Select font
-- PDMS11.3 change, Neale Morris, 28/03/2001
-- This form is a modified copy of and hence based on standard appware form _CDRFONTSEL
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -
--  ok()                             -
--  view()                           -
------------------------------------------------------------------------

setup form !!abaFontSelect
title |Text Font Selector|
init |!this.init()|

  path down

  -- Feedback view
  -- PDMS11.3 change, Neale Morris, 28/03/2001
  var !exist exist $_CDRDRAFTAIDS_FONTSEL
   if (!exist.upCase().eq('TRUEA')) then

     view .feedback at x0.5 y0.2 AREA
       width 40 aspect 1
       setcolour 15
       cursor nocursor
       borders off
     exit

   endif

  option .fontName call |!this.view()| width 12


  path right

  option .fontThk call |!this.view()| width 4


  option .fontSlant call |!this.view()| width 7

  button .ok at xmin.fontName ymax.fontThk |  OK  | call |!this.ok()|  OK
  button .cancel at xmin.fontSlant         |Cancel| CANCEL

  -- Read Cadcentre fonts
  do !count index !!CDFONTS
    !countTen = !count * 10
    !dtext[!count] = !!CDFONTS[!count]
    !rtext[!count] = !countTen.string()
  enddo
  !this.fontName.dtext = !dtext
  !this.fontName.rtext = !rtext

  -- Set thickness
  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext[1] = |Thin|
  !dtext[2] = |Bold|
  !rtext[1] = |1|
  !rtext[2] = |4|
  !this.fontThk.dtext = !dtext
  !this.fontThk.rtext = !rtext

  -- Set slant
  !dtext[1] = |Upright|
  !dtext[2] = |Forward|
  !dtext[3] = |Reverse|
  !rtext[1] = |0|
  !rtext[2] = |1|
  !rtext[3] = |2|
  !this.fontSlant.dtext = !dtext
  !this.fontSlant.rtext = !rtext

exit

------------------------------------------------------------------------
define method .init()
------------------------------------------------------------------------

  -- Add sheet to view
  -- PDMS11.3 change, Neale Morris, 28/03/2001
  edit view !!abaFontSelect.feedback AREA put $_CDRDRAFTAIDS_FONTSEL
  !box[1] = 3
  !box[2] = 3
  !box[3] = 48
  !box[4] = 50
  !this.feedback.limits = !box

  -- Finf current font from drawing template form
  if (!!abaDrTmplAtt.font.selection('RTEXT').eq('')) then
    !font = 1
  else
    !font = !!abaDrTmplAtt.font.rtext[1].real()
    if (!font.eq(1) or !font.eq(2) or !font.eq(3) or !font.eq(4)) then
      !fontF = !font * 10
      !fontSelect = 10
      !fontN = 1
    else
      !fontF = !font / 10
      !fontSelect = !fontF.int() * 10
      !fontN = !font - !fontSelect
    endif
  endif

  -- Select font & attributes
  !this.fontName.select('RTEXT',!fontSelect.string())

  if (!fontN.eq(1) or !fontN.eq(2) or !fontN.eq(3)) then
    !this.fontThk.select('DTEXT','Thin')
  else
    !this.fontThk.select('DTEXT','Bold')
  endif

  if (!fontN.eq(1) or !fontN.eq(4)) then
    !this.fontSlant.select('DTEXT','Upright')
  elseif (!fontN.eq(2) or !fontN.eq(5)) then
    !this.fontSlant.select('DTEXT','Forward')
  else
    !this.fontSlant.select('DTEXT','Reverse')
  endif

  -- Reset view limits
  !this.view()

endmethod

------------------------------------------------------------------------
define method .view()
------------------------------------------------------------------------

  -- Calculate distance to next font
  !fontF = (!this.fontName.selection('RTEXT').real() / 10) - 1
  !fontN = !this.fontThk.selection('RTEXT').real() + !this.fontSlant.selection('RTEXT').real()
  !xDist = 50 * ((!fontF * 6) + (!fontN - 1))

  -- Read current units & set to mm
  !units = object COMUNITS(TRUE)
  units mm dist

  -- Set view limits
  !box[1] = 3 + !xDist
  !box[2] = 3
  !box[3] = 48 + !xDist
  !box[4] = 50
  !this.feedback.limits = !box

  -- Reset units
  !units.restoreSavedBoreDist()

endmethod

------------------------------------------------------------------------
define method .ok()
------------------------------------------------------------------------

  -- Determine font description
  !fontDesc = !this.fontName.selection('DTEXT') & ' ' &  !this.fontThk.selection('DTEXT') & ' ' & !this.fontSlant.selection('DTEXT')
  !fontNum = !this.fontName.selection('RTEXT').real() + !this.fontThk.selection('RTEXT').real() + !this.fontSlant.selection('RTEXT').real()

  -- Set drawing template attributes form font gadget
  !!abaDrTmplAtt.font.clear()
  !dtext[1] = !fontDesc
  !dtext[2] = 'Selected...'
  !rtext[1] = !fontNum.string()
  !rtext[2] = 'SELECT'
  !!abaDrTmplAtt.font.dtext = !dtext
  !!abaDrTmplAtt.font.rtext = !rtext

  -- Select this setting
  !!abaDrTmplAtt.font.select('DTEXT',!fontDesc)

endmethod
