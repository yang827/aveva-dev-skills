--
------------------------------------------------------------------------

setup form !!abakeyplan blocking

  title |Choose options|
  init |!this.init()|

-- Define Members/Selection Areas
-- ------------------------------

  frame .options | Options | at x0

    path down
    option .keys |Keyplans | at x1 y1 width 28

    text .posX |Position X | at ymax+0.7           width 12 is REAL format !!distanceFMT
    text .posY |Y |          at xmax.posX+0.5 ymin width 12 is REAL format !!distanceFMT

-- Future
--    button .curs at xmax.posY+1 ymin.posY-0.2 pixmap height 20 width 20 call |!this.setPos|

    text .angl |Angle:| at xmin.keys ymax+0.7 width 5 is REAL

    text .scaX |Scale X:| at xmax.angl+5   ymin width 5 NUM
    text .scaY |Y:|       at xmax.scaX+0.2 ymin width 5 NUM

  exit

-- Action buttons
-- --------------

  path right
  button .ok     | Apply | at x0 ymax.options+0.25 call |!this.apply()| ok
  button .cancel |Dismiss| at xmax.options-8.3 cancel

  -- Pixmaps
--  !this.curs.addPixmap(!!PML.getPathName('cursor.png'))

  -- Members
  member .task     is ABATASK
  member .taskName is STRING
  member .form     is FORM

-- End of form definition
exit

--------------------------------------------------------------------
define method .init()
--------------------------------------------------------------------
-- Called when form is shown

   -- Get all available keyplans
   var !keyRefs coll all over wi SpPurp eq 'ABAT' for $!!abadefaults.libr.val
   var !names eval name nopref for all from !keyRefs
   !this.keys.dtext = !names
   !this.keys.rtext = !keyRefs

   -- Make current value selections
   !param = !this.task.paramVal

   !this.keys.select('DTEXT',!param[1])
     handle any
       !this.keys.select('RTEXT',!param[1])
         handle any
         endhandle
     endhandle

   -- Position gadgets
   !this.posX.val = !param[2].real()
   !this.posY.val = !param[3].real()

   -- Remaining gadgets
   !this.angl.val = !param[4].real()
   !this.scaX.val = !param[5].trim()
   !this.scaY.val = !param[5].trim()

   -- Read and store task name
   !this.taskname = !this.task.name

   -- Set form title
   !this.formTitle = !this.taskName

endmethod

--------------------------------------------------------------------
define method .setPos()
--------------------------------------------------------------------
-- Called when a cursor option is pressed (Future)

   -- Initialise variables
   !ce = !!ce

   -- Return to hierarchy position
   !!ce = !ce

endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------
-- Called when apply is pressed

   -- Build parameters array
   !parameters[1] = !this.keys.selection('RTEXT').dbref()
   !parameters[2] = !this.posX.val
   !parameters[3] = !this.posY.val
   !parameters[4] = !this.angl.val
   !parameters[5] = !this.scaX.val & ' ' !this.scaY.val

   -- Reset the task object
   !this.task.paramVal = !parameters

   -- Transfer the modified task back to the calling form
   !this.form.receiveTask(!this.task)

endmethod
