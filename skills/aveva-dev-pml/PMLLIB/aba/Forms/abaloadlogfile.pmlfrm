--  ===========                      ======              ===========
--  Browse()                         -
--  abaLoadLogFile()                 -
--  cancel()                         -
--  init()                           -
--
------------------------------------------------------------------------
setup form !!abaLoadLogFile
------------------------------------------------------------------------
   title |ABA Log File List|
   init |!this.init()|
   cancelcall |!this.cancel()|

   para .path at y 0.2 text 'Log File Location:'
   path down
   text .location call |!this.init()| at ymax.path width 50 is STRING
   path right
   button .browse 'Browse' call |!this.browse()|
   path down
   List .ViewList |Log Files| call |!this.SetView(!this.ViewList.selection('RTEXT'))| at x 0 width 57 hei 12

member .MODE is STRING
exit

------------------------------------------------------------------------
define method .abaLoadLogFile()
------------------------------------------------------------------------
--
   !this.init()
--
endMethod

------------------------------------------------------------------------
define method .init()
------------------------------------------------------------------------
--
   !dtext = array()
   !rtext = array()

-- Make up list of log files stored in defaults file position

   !path = object file (!!abaDefaults.LogPath)
   !this.location.val = !!abaDefaults.LogPath
   !files = !path.files()
   do !x values !files
      !dtext.append(!x.entry())
   enddo

   !this.ViewList.Dtext = !dtext
--   !this.ViewList.Rtext = !rtext

--
endMethod

------------------------------------------------------------------------
define method .Browse()
------------------------------------------------------------------------
--
     show !!abafilelist
--
endMethod

------------------------------------------------------------------------
define method .cancel()
------------------------------------------------------------------------
--
       !!abaLoadLogFile.hide()
       !!abaProcess.visible()
--
endMethod
