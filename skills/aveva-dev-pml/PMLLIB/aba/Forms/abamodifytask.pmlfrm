-- Created:         15 Mar 1999
--
--
-- Description:
-- <description>
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  deleteTask(REAL)                 -
--  init()                           -
--  saveViewTask(STRING,STRING)      -
------------------------------------------------------------------------

setup form !!abaModifytask blocking

  title 'Parameter Modification'
  init '!this.init()'

  path down

  text .descr |Description | call || width 35 is STRING
  text .value |Value       | call || width 18 is STRING

  button .ok      '  OK  ' call |!this.saveViewTask(!this.descr.val,!this.value.val)| OK

  path right
  hdist 15

  button .delete  'Delete Param' call |!this.deleteTask(!!abaeditViewTask.params.val)|
  button .dismiss 'Cancel' at xmax form-size call || CANCEL

  member .task   is ABATASK
  member .number is REAL
  member .mode   is STRING

exit
-- End of form definition


------------------------------------------------------------------------
--
-- Method:      methodName(<argument type>)
--
-- Description: <method Description>
--
-- Method Type: <Procedure/Function>
--
------------------------------------------------------------------------
define method .init()
------------------------------------------------------------------------
--
    if (!This.mode EQ 'ADD') then
        !This.formTitle = 'Add New Parameter'
        !This.descr.val = ''
        !This.value.val = ''
        !This.delete.active = FALSE
    else
        !This.formTitle = 'Parameter Modification'
        !This.descr.val = !this.task.getParam(!this.Number)[1]
        !This.value.val = !this.task.getParam(!this.Number)[2]
        !This.delete.active = TRUE
    endif
--
endmethod
-- End of method definition for abamodifyTask


------------------------------------------------------------------------
define method .deleteTask(!Value is REAL)
------------------------------------------------------------------------
--
        if (!!alert.question('Delete current Parameter') EQ 'YES') then
            !!abaEditViewTask.Task.deleteParam(!Value)
            !!abaEditViewTask.init()
            hide !!abaModifyTask
        endif
--
-- Set flag for ending PDMS session because defaults have changed.
     !!abaDefaults.Changed = TRUE
--
endmethod

------------------------------------------------------------------------
define method .saveViewTask(!Desc is STRING,!Value is STRING)
------------------------------------------------------------------------
--
     if (!This.mode EQ 'ADD') then
         !!abaEditViewTask.Task.addParam(!This.Descr.Val,!This.Value.Val)
         !!abaEditViewTask.init()
         !This.Mode = 'MODIFY'
     else
         !!abaEditViewTask.Task.putParam(!This.Number,!This.Descr.Val,!This.Value.Val)
         !!abaEditViewTask.init()
         !!abaEditViewTask.params.val = !This.Number
     endif
--
-- Set flag for ending PDMS session because defaults have changed.
     !!abaDefaults.Changed = TRUE
--
endmethod
-- End of method definition for abamodifyTask
