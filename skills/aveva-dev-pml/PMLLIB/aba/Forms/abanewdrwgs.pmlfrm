------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaNewDrwgs()                    -                   Constructor method
--  addSelection(STRING)             -                   Build the new and old drawing lists as a set of abadrawing objects
--  areaSelect(GADGET)               -                   Select the areas based on the selected task discipline
--  areasPopup(ARRAY)                -                   Pop-up for the areas grid control
--  cancel()                         -                   Close this form
--  checkName(STRING)                REAL
--  clear()                          -                   Clear relevant data arrays
--  drtmplPopup(ARRAY)               -                   Pop-up for the drtmpl grid control
--  getAreaList(GADGET)              -                   Populate the area select gadget
--  getDrawings(GADGET)              -
--  init()                           -                   Method to initialize the form
--  mds(DBREF,ARRAY)                 -                   Set the form with mds data
--  selectAll(STRING)                -                   Select all grid entries
--  setName(DBREF,DBREF)             STRING              Create a valid name
--
import 'GridControl'
  handle any
  endhandle

setup form !!abaNewDrwgs

  title 'ABA New Drawing List'
  init '!this.init()'
  cancelcall |!this.cancel()|

  para .desc at x0.5 y0.2 text 'Create New Drawings'

  option .areaSelect 'Areas: ' at x27 ymin call '!this.areaSelect(!!abaDefaults.alib)' width 30

  frame .fDtypes 'Drawing Templates' at x 0 ymax+0.1

    container .drtmplGrid nobox pmlNetControl 'NET' at x0.5 ymin+0.5 width 32 height 12

  exit

  path right

  frame .fAreas 'Design Areas'

    container .areasGrid nobox pmlNetControl 'NET' at x0.5 ymin+0.5 width 32 height 12

  exit

  path down

  button .naming  ' Drawing Names... '   at x0 call |show !!abaNameSelect|

  button .ok at x 1 ' Apply ' at xmin ymax.naming+0.3 callback |!this.addSelection('APPEND')| APPLY

  path right

  button .dismiss   'Dismiss' at Xmax form - size call |!this.cancel()| cancel

  -- Members
  member .oldDrawings   is ARRAY
  member .newDrawings   is ARRAY
  member .existing      is BOOLEAN
  member .errorList     is ARRAY
  member .selOpt        is STRING
  member .selFunc       is STRING

  member .allShtmpl     is ARRAY
  member .allAreas      is ARRAY

  -- Declare the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  member .drtmplControl is NETGRIDCONTROL
  member .areasControl  is NETGRIDCONTROL

  member .headings      is ARRAY

exit

------------------------------------------------------------------------
--
-- Method:      .abaNewDrwgs()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------------------------------
define method .abaNewDrwgs()

  -- Define the pop-up menus
  -- Drawing Template
  !menu = !this.newMenu('drtmplPopUp')
    !menu.add('callback', 'Select All', |!this.selectAll('DRTMPL')|,'SELECT')
    !menu.add('callback', 'Clear Selection', |!this.drtmplControl.clearRowSelection()|, 'CLEAR')

  -- Areas
  !menu = !this.newMenu('areasPopUp')
    !menu.add('callback', 'Select All', |!this.selectAll('AREAS')|,'SELECT')
    !menu.add('callback', 'Clear Selection', |!this.areasControl.clearRowSelection()|, 'CLEAR')
    !menu.add('separator')
    !menu.add('callback','Add Selection to List', |!this.addSelection('APPEND')|, 'ADD')
    !menu.add('callback','Replace List With Selection', |!this.addSelection('REPLACE')|, 'REPLACE')

  -- Create instances of the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  !this.drtmplControl = object NETGRIDCONTROL()
  !this.areasControl  = object NETGRIDCONTROL()

  -- Add .net control to the containers
  !this.drtmplGrid.control = !this.drtmplControl.handle()
  !this.areasGrid.control  = !this.areasControl.handle()

  -- Add PML event handlers to .net controls
  !this.drtmplControl.addEventHandler('onPopup', !this, 'drtmplPopup')
  !this.areasControl.addEventHandler('onPopup', !this, 'areasPopup')

  -- Set grid visual attributes
  !this.drtmplControl.columnExcelFilter(false)
  !this.drtmplControl.outlookGroupStyle(false)
  !this.drtmplControl.fixedRows(false)
  !this.drtmplControl.gridHeight(1000.0)
  !this.drtmplControl.editableGrid(false)
  !this.drtmplControl.singleRowSelection(false)
  !this.drtmplControl.columnExcelFilter(false)
  !this.drtmplControl.fixedHeaders(false)
  !this.drtmplControl.headerSort(true)
  !this.drtmplControl.columnSummaries(false)
  !this.areasControl.columnExcelFilter(false)
  !this.areasControl.outlookGroupStyle(false)
  !this.areasControl.fixedRows(false)
  !this.areasControl.gridHeight(1000.0)
  !this.areasControl.editableGrid(false)
  !this.areasControl.singleRowSelection(false)
  !this.areasControl.columnExcelFilter(false)
  !this.areasControl.fixedHeaders(false)
  !this.areasControl.headerSort(true)
  !this.areasControl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Name')
  !this.headings.append('Description')

endmethod
-- End of method definition for .abaNewDrwgs()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !list = ARRAY()

  -- Clear the grids and data arrays
  !this.clear()

  -- Get all existing drawing templates
  !this.getDrawings(!!abaDefaults.dlib)

  -- Populate the area select gadget
  !this.getAreaList(!!abaDefaults.alib)

  -- Attempt to select the discipline as stored in the process form
  !this.areaSelect.select('DTEXT',!!abaProcess.selOpt)
    handle (61,567)
      -- cannot find matching text
    endhandle

  -- Get all areas
  !this.areaSelect(!!abaDefaults.alib)

  -- Set form title to include the selected discipline
  !this.formtitle = |ABA New Drawing List ( | & !this.areaSelect.selection('DTEXT') & | )|

  -- Access the drawing template library
--  !!ce = !!abaDefaults.dlib.val.dbref()

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .addSelection(STRING)
--
-- Description: Build the new and old drawing lists as a set of abadrawing objects
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addSelection(!list is STRING)

  -- Check for replacing the current drtmpl and area lists
  if (!list.eq('REPLACE')) then

    -- Clear the abaprocess form
    !!abaProcess.newDrawings.clear()
    !!abaProcess.oldDrawings.clear()

  endif

  -- Check that both a template and an area has been selected
  if (!this.drtmplControl.getSelectedRowTags().empty() and !this.areasControl.getSelectedRowTags().empty()) then

    !!alert.error('Please select a Drawing Template and an Area!')
    return

  elseif (!this.drtmplControl.getselectedrowtags().empty()) then

    !!alert.error('Please select a Drawing Template!')
    return

  elseif (!this.areasControl.getselectedrowtags().empty()) then

    !!alert.error('Please select an Area!')
    return

  endif

  -- Clear the current drawing list
  !this.oldDrawings.clear()
  !this.newDrawings.clear()

  -- Cycle round all drawing templates and find all associated used areas.
  do !tempIndex values !this.drtmplControl.getselectedrowtags()

    -- Deal with each drawing making reference to template
    do !areaIndex values !this.areasControl.getselectedrowtags()

      -- Add attributes to drawings object.
      !tempRef = !this.allShtmpl[!tempIndex.real()]
      !areaRef = !this.allAreas[!areaIndex.real()]

      VAR !tse SPLIT TSEARCH LINKREF $!tempRef DARREF $!areaRef

      -- take care of the existing drawings by adding them directly to the old drawings list
      if (defined(!tse)) then

        !this.oldDrawings.append(object ABADRAWING(!tse[1].dbref()))
        skip

      endif

      !template = !tempRef.owne.flnm
      !area     = !areaRef.flnn

      -- Go and set the name according to the current settings
      !drgname =  !this.setName(!tempRef, !areaRef)

      -- TM addition to make addentry take a drawing name
      !this.newDrawings.append(object ABADRAWING(!drgname, !tempref, !arearef))

    enddo

  enddo

  -- Check for duplicate names in the current list
  -- Check to see if the item already exists in the process list
  do !inList values !!abaProcess.newDrawings

    do !drawing index !this.newdrawings

      if (!this.newDrawings[!drawing].template.eq(!inList.template) and !this.newDrawings[!drawing].area.eq(!inlist.area)) then

         !this.newDrawings.deletefrom(!drawing,1)

      elseif (!this.newDrawings[!drawing].drwgName.eq(!inList.drwgName)) then

         !!alert.error('Duplicate drawing names - Reset to Default')
         !this.newdrawings[!drawing].drwgName = !this.newdrawings[!drawing].template.flnm & '-' & !this.newdrawings[!drawing].area.flnn

      endif

    enddo

  enddo

  !this.newdrawings.compress()

  !!abaProcess.newDrawings.appendArray(!this.newDrawings)

   do !inList values !!abaProcess.oldDrawings

     do !drawing index !this.oldDrawings

      if (!this.oldDrawings[!drawing].template.eq(!inList.template) and !this.oldDrawings[!drawing].area.eq(!inList.area)) then

         !this.oldDrawings.deleteFrom(!drawing,1)

      endif

    enddo

  enddo

  !this.newDrawings.compress()

  !!abaProcess.oldDrawings.appendArray(!this.oldDrawings)

  !this.oldDrawings.compress()

  !!abaProcess.display()

endmethod
-- End of method definition for .addSelection(STRING)

------------------------------------------------------------------------
--
-- Method:      .areasPopup()
--
-- Description: Pop-up for the areas grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .areasPopup(!array is ARRAY)

  -- Set and show the pop-up
  !this.areasGrid.popup = !this.areasPopUp
  !this.areasGrid.showPopup(!array[0], !array[1])

endmethod
-- End of method definition for .areasPopup()


-----------------------------------------------------------------------
--
-- Method:      .areaSelect(GADGET)
--
-- Description: Select the areas based on the selected task discipline
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget on the abaDefaults form referencing the relevant library
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .areaSelect(!gadget is GADGET)

  -- Initialise variables
  !rowSet = ARRAY()
  !this.allAreas.clear()

  -- Get all areas
  -- All
  if (!this.areaSelect.selection('DTEXT').eq('All')) then

     VAR !allAreas COLL ALL IDLI FOR $!gadget

  -- Selection
  else

     !areaLib  = !this.areaSelect.selection('RTEXT')

     if (!arealib.eq('')) then
       return
     endif

     VAR !allAreas COLL ALL IDLI FOR $!areaLib

  endif

  -- Get the name of all found area idlis
  VAR !allNames EVAL NAMN FOR ALL FROM !allAreas

  -- Sort idli by name
  !allAreas.reindex(!allNames.sortedIndices())

  -- For each found area idli
  do !idli values !allAreas

    -- Initialise variables
    !idliRefe = !idli.dbref()
    !rowData  = ARRAY()

    -- Store the found area idli
    !this.allAreas.append(!idliRefe)

    -- Build row data
    !rowData.append(!idliRefe.flnn)
    !rowData.append(!idliRefe.func)

    -- Add row data to row set array
    !rowSet.append(!rowData)

  enddo

  -- Set the grids
  using namespace 'Aveva.Pdms.Presentation'
  !this.areasControl.bindToDataSource(object NETDATASOURCE('Areas', !this.headings, !rowSet, '^Name'))

  -- Set form title to include the selected discipline
  !this.formtitle = |ABA New Drawing List ( | & !this.areaSelect.selection('DTEXT') & | )|

endmethod
-- End of method definition for .areaSelect(GADGET)

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Close this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  !!abaNewDrwgs.hide()

endmethod
-- End of method definition for .cancel()

-----------------------------------------------------------------------
--
-- Method:      .checkName(STRING) is REAL
--
-- Description: Check if a name has been used already in the DB or drawing lists
--              This is used by external naming tasks and returns 0 1 or 2
--                0 for a new name which can be used
--                1 for an existing database name
--                2 for an item about to be created
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkName(!name is STRING) is REAL

  -- First check name in PDMS
  !test = !name.dbref()
  handle any

    -- it can't find the name in the db - now check the list of current drawing objects in the process form
    do !inlist values !!abaprocess.newdrawings
      if !inlist.DrwgName eq !name then
        return 2
      endif
    enddo

    do !drawing values !!abaprocess.newdrawings
       if !drawing.DrwgName eq !name then
         return 3
       endif
    enddo

    do !drawing values !!abaprocess.olddrawings
       if !drawing.DrwgName eq !name then
         return 3
       endif
    enddo

    do !drawing values !this.newdrawings
       if !drawing.DrwgName eq !name then
         return 2
       endif
    enddo

    do !drawing values !this.olddrawings
       if !drawing.DrwgName eq !name then
         return 2
       endif
    enddo

    -- it can't find the name at all, so its ok to use it
    return 0

  elsehandle none

    -- its a database element already
    return 1

  endhandle

endmethod
-- End of method definition for .checkName(STRING) is REAL

------------------------------------------------------------------------
--
-- Method:      .clear()
--
-- Description: Clear relevant data arrays
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Clear the grid
  !this.drtmplControl.clearGrid()
  !this.areasControl.clearGrid()

  -- Clear all data
  !this.oldDrawings.clear()
  !this.newDrawings.clear()
  !this.allShtmpl.clear()
  !this.allAreas.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      .drtmplPopup()
--
-- Description: Pop-up for the drtmpl grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drtmplPopup(!array is ARRAY)

  -- Set and show the pop-up
  !this.drtmplGrid.popup = !this.drtmplPopUp
  !this.drtmplGrid.showPopup(!array[0], !array[1])

endmethod
-- End of method definition for .drtmplPopup()

-----------------------------------------------------------------------
--
-- Method:      .getAreaList(GADGET)
--
-- Description: Populate the area select gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAreaList(!gadget is GADGET)

  -- Initialise variables
  !rowSet = ARRAY()

  -- Get all areas
  VAR !disciplines COLL ALL DLLB FOR $!gadget
    handle(2,109)
      -- undefined area liby
      return error 12 'Cannot find ABA area LIBY $!gadget - Check ABA defaults file'
    endhandle

  -- Test for no areas
  if (!disciplines.size().eq(0)) then
    !!alert.error('There are not any areas defined')
    return
  endif

  -- Get all area descriptions
  VAR !func EVAL FUNC FOR ALL FROM !disciplines

  -- Built gadget arrays
  do !a index !disciplines

    !dtext[!a] = !func[!a]
    !rtext[!a] = !disciplines[!a]

  enddo

  -- Add an ALL option
  !dtext.insert(1,'All')
  !rtext.insert(1,'All')

  -- Populate the area gadget
  !this.areaSelect.dtext = !dtext
  !this.areaSelect.rtext = !rtext

endmethod
-- End of method definition for .getAreaList(GADGET)

-----------------------------------------------------------------------
--
-- Method:      .getDrawings(GADGET)
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDrawings(!gadget is GADGET)

  -- Initialise variables
  !rowSet = ARRAY()

  -- Get all drTmpl templates
  if (!!abaProcess.selopt.eq('All')) then

    VAR !allDrTmpl COLL ALL DRTMPL FOR $!gadget

  else

    VAR !allDrTmpl COLL ALL DRTMPL WITH FUNC EQ '$!!abaProcess.selFunc' FOR $!gadget
    VAR !allDrTmpl APPEND COLL ALL DRTMPL WITH FUNC EQ '$!!abaProcess.selOpt' FOR $!gadget

    !allDrTmpl.unique()

  endif

  -- Get names for all found drtmpl
  VAR !allNames EVAL NAME FOR ALL FROM !allDrTmpl

  -- Sort drtmpl by name
  !allDrTmpl.reindex(!allNames.sortedIndices())

  -- For each found drtmpl get all sheet templates
  do !drtmpl val !allDrTmpl

    -- Initialise variables
    !drtmplRefe = !drtmpl.dbref()
    !rowData    = ARRAY()

    -- Get all sheet templates
    VAR !allShtmpl COLL ALL SHTMPL WI FUNC EQ 'Master' FOR $!drTmpl

    -- Test for no found shtmpl
    skip if (!allShtmpl.unset() or !allShTmpl.empty())

    -- Store the found shtmpl
    !this.allShtmpl.append(!allShtmpl[1].dbref())

    -- Build row data
    !rowData.append(!drtmplRefe.flnn)
    !rowData.append(!drtmplRefe.titl)

    -- Add row data to row set array
    !rowSet.append(!rowData)

  enddo

  -- Set the grids
  using namespace 'Aveva.Pdms.Presentation'
  !this.drtmplControl.bindToDataSource(object NETDATASOURCE('Drtmpl', !this.headings, !rowSet, '^Name'))

  -- Stop prompt
  prompt dismiss

endmethod
-- End of method definition for .getDrawings(GADGET)

-----------------------------------------------------------------------
--
-- Method:      .mds(DBREF,ARRAY)
--
-- Description: Set the form with mds data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      DBREF        The shtmpl to be used for the new drawings
--    2   R      ARRAY        The DBREFs of the areas to be processed
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mds(!shtmplRefe is DBREF, !allAreas is ARRAY)

  -- Select the passed template
  !this.drtmplControl.selectRow(!this.allShtmpl.findfirst(!shtmplRefe))

  -- Select the passed areas
  do !areaRefe val !allAreas
    !this.areasControl.selectRow(!this.allAreas.findfirst(!areaRefe))
  enddo

  -- Add the selected items to the main process form
  !this.addSelection('APPEND')

endmethod
-- End of method definition for .mds(DBREF,ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .selectAll(NETGRIDCONTROL)
--
-- Description: Select all grid entries
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      STRING      The control gadget to select
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectAll(!control is STRING)

  -- Get grid
  if (!control.eq('DRTMPL')) then

    -- For each grid row
    do !row from 1 to !this.drtmplControl.getRows().size()
      !this.drtmplControl.selectRow(!row)
    enddo

  else

    -- For each grid row
    do !row from 1 to !this.areasControl.getRows().size()
      !this.areasControl.selectRow(!row)
    enddo

  endif


endMethod
-- End of method definition for .selectAll(NETGRIDCONTROL)

-----------------------------------------------------------------------
--
-- Method:      .setName(DBREF,DBREF,STRING)
--
-- Description: Create a valid name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setName(!template is DBREF, !area is DBREF) is STRING

  -- If the default naming method is used, formulate the name as default
  -- we are using default drawing numbering
  if (!!abaNameSelect.numbering.val.eq(1)) then

    -- Need to check that the default name does not exist as another element type
    !return = !template.owner.flnm & '-' & !area.flnn

    -- Check to see if the name is in use
    !test = !this.checkname(!return)

    if !test eq 1 then

      -- The drawing exists as a database element
      !oldname = !return

      do !a

        !return = !return & '/' & !a

        if !this.checkname(!return) eq 0 then
          !!alert.error('Default name ' & !oldname & ' has already been used. The name is being reset to ' & !return)
          break
        endif

      enddo

    endif

  -- Check to see if the name has been used anywhere before
  -- We are using a drawing name task
  elseif (!!abaNameSelect.numbering.val.eq(2)) then

    !function  = '!!' & !!abaNameSelect.tasklist.task.execute

    !!abaNameSelect.tasklist.getTask(!!abaNameSelect.choice.val)

    !params = !!abaNameSelect.taskList.task.getParamvals()

    !params.insert(1,!template.string())
    !params.insert(2,!area.string())

    !return = $!function(!params)
      handle any

        !!alert.error('Error in Drawing name user function - Default Name used')

        !return = !template.owner.flnm & '-' & !area.flnn

        if !this.checkname(!return) eq 1 then

          -- Its a name in the database
          !oldname = !return

          do !a

            !return = !return & '/' & !a

            if !this.checkname(!return) eq 0 then
              !!alert.error('Default name ' & !oldname & ' has already been used. The name is being reset to ' & !return)
              break
            endif

          enddo

        endif

      endhandle

    if !return eq '' then

      !return = !template.owner.flnm & '-' & !area.flnn

      if !this.checkname(!return) eq 1 then $* it exists already

        !oldname = !return

        do !a

          !return = !return & '/' & !a

          if !this.checkname(!return) eq 0 then
            !!alert.error('Default name ' & !oldname & ' has already been used. The name is being reset to ' & !return)
            break
          endif

        enddo

      endif

    endif

  endif

  return !return

endmethod
-- End of method definition for .setName(DBREF,DBREF,STRING)
