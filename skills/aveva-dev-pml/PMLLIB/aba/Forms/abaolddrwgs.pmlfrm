------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaOldDrwgs()                    -                   Constructor method
--  cancel()                         -
--  clear()                          -                   Clear relevant data arrays
--  display()                        -                   Method to initialise the form
--  drgPopUp(ARRAY)                  -                   Pop-up for the grid control
--  init()                           BOOLEAN             Method to initialise the form
--  mds(ARRAY)                       -                   Set the form with mds data
--  processList()                    -                   Add the selected drawings to the main process form
--  selectAll()                      -                   Select all grid entries
--
import 'GridControl'
  handle any
  endhandle

setup form !!abaOldDrwgs

  title 'ABA Drawing list'
  init '!this.init()'
  cancelcall |!this.cancel()|

  para .desc at x25 text 'Modify Existing Drawings'

  para .title at x0 ymax-0.5 text |Drawings|

  container .drgGrid nobox pmlNetControl 'NET' at xmin ymin+0.6 width 70 height 15

  button .ok at x 1 '  OK  ' at xmin ymax+0.2 callback |!this.processList()| OK

  path right
  button .dismiss   'Cancel' at Xmax form - size call |!this.cancel()| cancel

  -- Declare the grid controls
  using namespace 'Aveva.pdms.presentation'
  member .drgControl is NETGRIDCONTROL

  member .headings    is ARRAY
  member .allSheets   is ARRAY
  member .drawingList is ARRAY
  member .existing    is BOOLEAN
  member .errorList   is BOOLEAN

exit

------------------------------------------------------------------------
--
-- Method:      .abaOldDrwgs()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .abaOldDrwgs()

  -- Initialise variables
  !this.errorList  = false

  -- Define pop-up menu
  !menu = !this.newMenu('drgPopUp')
    !menu.add('callback', 'Select All', |!this.selectAll()|,'SELECT')
    !menu.add('callback', 'Clear Selection', |!this.drgControl.clearRowSelection()|, 'CLEAR')

  -- Create instances of the grid controls
  using namespace 'Aveva.pdms.presentation'
  !this.drgControl = object NETGRIDCONTROL()

  -- Add .net control to the container
  !this.drgGrid.control = !this.drgControl.handle()

  -- Add PML event handlers to .net controls
  !this.drgControl.addEventHandler('onPopup', !this, 'drgPopUp')

  -- Set grid visual attributes
  !this.drgControl.columnExcelFilter(false)
  !this.drgControl.outlookGroupStyle(false)
  !this.drgControl.fixedRows(false)
  !this.drgControl.gridHeight(1000.0)
  !this.drgControl.editableGrid(false)
  !this.drgControl.singleRowSelection(false)
  !this.drgControl.columnExcelFilter(false)
  !this.drgControl.fixedHeaders(false)
  !this.drgControl.headerSort(true)
  !this.drgControl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Drawing Name')
  !this.headings.append('Template')
  !this.headings.append('Description')
  !this.headings.append('Area Name')
  !this.headings.append('Area Desc')
  !this.headings.append('Variant')

endmethod
-- End of method definition for .abaOldDrwgs()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init() is BOOLEAN

  -- Initialise variables
  !err       = FALSE
  !errors    = 0
  !errorsLog = ARRAY()

  -- Clear data arrays and grid
  !this.clear()

  -- Collect all drawing templates.
  if (!!abaProcess.selOpt.eq('All')) then

    !this.formtitle = 'ABA Drawing list ( All Drawings )'
    VAR !allDrtmpl COLL ALL DRTMPL WITH SPPURP EQ 'ABAT'

  else

    !this.formtitle = 'ABA Drawing list ( ' & !!abaProcess.selOpt & ' )'
    VAR !allDrtmpl COLL ALL DRTMPL WITH FUNC EQ '$!!abaProcess.selfunc' AND SPPURP EQ 'ABAT'

  endif

  -- Evaluate list for names.
  --VAR !tmplNames EVAL NAME FOR ALL FROM !allDrtmpl

  -- Cycle round all drtmpl (Drawing Templates) and find all associated used drawings.
  do !drtmpl values !allDrtmpl

    -- Initialise variables
    --!drtmplRefe = !drtmpl.dbref()
    !allDwrgs   = ARRAY()
    !allShts    = ARRAY()

    -- Deal with each drawing making reference to template.

    VAR !allDwrgs SPLIT TSEARCH LINKREF $!drtmpl

    do !drwg values !allDwrgs

      -- Initialise variables
      --!drwgRefe = !drwg.dbref()

      -- Deal with each sheet for template.
      skip if (undefined(!drwg))

      -- Add attributes to drawings object.
      VAR !allShts COLL ALL SHEE FOR $!drwg

      do !sheet values !allShts

        -- Initialise variables
        !sheetRefe = !sheet.dbref()

        -- Gather data
        -- DRWG name
        --!name = !drwgRefe.flnn

        -- DRTMPL name
        --!template = !drtmplRefe.flnn
        --!tempDesc = !drtmplRefe.title

        -- Area
        if (!sheetRefe.darref.badref()) then

          !area = 'Bad reference'
          !err  = TRUE
          !errorsLog.append('Drawing ' & !sheetRefe.flnn & '(' & name of $!sheet & ')' & ' Has failed with invalid references')

          !!alert.error('The sheet ' & !sheetRefe.flnn & ' has a invalid area and has been ignored')
          skip

          --else
          --!areaRef  = !sheetRefe.darref
          --!areaDesc = !areaRef.func
        endif

        -- SHTMPL
        if (!sheetRefe.linkref.badref()) then
          !area = 'Bad reference'
          --else
          --!shTmrf  = !sheetRefe.linkref
          --!tempRef = !shTmrf
        endif

        !drawing = object ABADRAWING(!sheetRefe)
          handle any

            -- Current drawing has invalid references, maybe now an invalid drawing.
            !err = TRUE
          !errorsLog.append('The sheet ' & !sheetRefe.flnn & ' has failed with invalid references')

          elsehandle none

          !this.drawingList.append(!drawing)

          endhandle

        if (!err) then
          !errors = !errors + 1
          !err    = FALSE
        endif

      enddo

    enddo

  enddo

  -- Output errors message if any drawings have failed to be loaded.
  if (!errors.eq(0)) then
    !this.errorList = FALSE

  else

    if (!!alert.question('Total of $!errors Drawing(s) have failed to load, See list? ') eq 'YES') then

      loadform !!abaErrorList

      !!abaErrorList.list.dtext = !errorsLog.unique()
      !this.errorList           = TRUE

    endif

  endif

  !this.display()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .clear()
--
-- Description: Clear relevant data arrays
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Clear the grid
  !this.drgControl.clearGrid()

  -- Clear all data
  !this.allSheets.clear()
  !this.drawingList.clear()

endmethod
-- End of method definition for .clear()

-----------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display()

  -- initialise variables
  !rowSet = ARRAY()

  -- Sort drawing templates by name
--  !allDrtmpl.reindex(!allNames.sortedIndices())

  -- Build the row data set
  do !drwgObj val !this.drawingList

    -- Initialise variables
    !rowData    = ARRAY()


    -- Build row data
    !rowData.append(!drwgObj.drwg.namn)
    !rowData.append(!drwgObj.template.namn)
    !rowData.append(!drwgObj.tempDesc)
    !rowData.append(!drwgObj.area.namn)
    !rowData.append(!drwgObj.areaDesc)
    !rowData.append(!drwgObj.variant)

    -- Add row data to row set array
    !rowSet.append(!rowData)

    -- Store sheet reference
    !this.allSheets.append(!drwgObj.sheet)

  enddo

  -- Set list
  using namespace 'Aveva.pdms.presentation'
  !this.drgControl.bindToDataSource(object NETDATASOURCE('Drtmpl', !this.headings, !rowSet, '^Name'))

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      .drgPopUp()
--
-- Description: Pop-up for the grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drgPopUp(!array is ARRAY)

  -- Show the pop-up
  !this.drgGrid.popup = !this.drgPopUp
  !this.drgGrid.showPopup(!array[0], !array[1])

endmethod
-- End of method definition for .drgPopUp()
----------------------------------------------------------------------
define method .cancel()

  !!abaOldDrwgs.hide()
  !!abaProcess.visible(TRUE)

endmethod

-----------------------------------------------------------------------
--
-- Method:      .mds(ARRAY)
--
-- Description: Set the form with mds data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        The STRING names of the existing drawings to be processed
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mds(!allDrwgNames is ARRAY)

  -- Load all existing drawings
  --!this.init()

  -- Get all existing drawing names as string
  !extractNames      = object BLOCK('!this.allSheets[!evalIndex].owne.name')
  !existDrwgNames = !this.allSheets.evaluate(!extractNames)

  -- Make certain of unique drawings. Is this necessary?
  !existDrwgNames.unique()

  -- For all existing drawings
  do !drwgName val !allDrwgNames

    -- Select the passed sheet in the grid
    !this.drgControl.selectRow(!existDrwgNames.findfirst(!drwgName))

  enddo

  -- Add the selected items to the main process form
  !this.processList()

endmethod
-- End of method definition for .mds(DBREF,ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .processList()
--
-- Description: Add the selected drawings to the main process form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .processList()

  -- Add the selected drawings to the abadrawings list
  -- Compile a list of selected items
  !newList       = !this.drgControl.getSelectedRowTags()
  !selectedDrwgs = ARRAY()

  do !numStrg values !newList
    !selectedDrwgs.append(!this.drawingList[!numStrg.real()])
  enddo

  do !inlist values !!abaProcess.oldDrawings

    do !drawing index !selectedDrwgs

      if (!selectedDrwgs[!drawing].template.eq(!inlist.template) and !selectedDrwgs[!drawing].area.eq(!inlist.area)) then
        !selectedDrwgs.deleteFrom(!drawing,1)
      endif

    enddo

  enddo

  !this.drawingList.compress()

  !!abaProcess.oldDrawings.appendarray(!selectedDrwgs)
  !!abaProcess.display()

  -- Call process methods to setup processType gadget.
  !!abaProcess.setupProcess()

  !!abaProcess.show     = true
  !!abaProcess.template = false

  !!abaProcess.visible(true)

  prompt ''

endmethod
-- End of method definition for .processList()

-----------------------------------------------------------------------
--
-- Method:      .selectAll()
--
-- Description: Select all grid entries
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectAll()

  -- For each grid row
  do !row from 1 to !this.drgControl.getRows().size()
      !this.drgControl.selectRow(!row)
  enddo

endmethod
-- End of method definition for .selectAll()
