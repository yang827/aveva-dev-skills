--   Type:          Function Definition
--   Group:
--     Keyword:
--   Module:
--   Replaces:
--
-- Author:          Martin Wright
-- Created:         5 March 1999
--
--
-- Description:
-- Select which process tasks to run during the drawing process
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addTask(STRING)                  -                   Add a selected task from the options list to the choice list
--  cancel()                         -                   Actions when closing this form
--  init()                           -                   Method to initialize the form
--  modifyTask(STRING)               -                   Call the form to enable the task parameters to be modified
--  receiveTask(ABATASK)             -                   Receive the modified task object from the modifying form
--  removeTask(REAL)                 -                   Remove the selected task from the choice list
--  selectTask()                     -                   Store the currently selected tasks
--
------------------------------------------------------------------------
setup form !!abaProcessTask

  title 'Process Drawings Control Tasks'
  init |!This.init()|
  cancelcall |!This.Cancel()|

  path down

  frame .taskMod '' at x 0

    para .tasks text 'Tasks Available'
    list .options at ymin.tasks + 1 width 23 height 6

    path right
    button .add '' at y 1.5 pixmap call '!this.addTask(!this.options.selection())'

    path down
    button .rem ''     pixmap call '!this.removeTask(!this.choice.val)'

    path right
    para .chosen at ymin.tasks text 'Tasks Selected'

    path down
    list .choice at xmax.add - 1 ymin.options call |!this.selectTask()| width 23 height 6

    button .dismiss 'Dismiss' at xmin .options call |!this.cancel()|

    path right
    button .modify 'Modify Task' at xmin.choice call |!this.modifyTask(!this.choice.selection('DTEXT'))|

  exit

  -- Pixmaps
  !this.rem.addPixmap(!!PML.getPathName('leftarrow16.png'))
  !this.add.addPixmap(!!PML.getPathName('rightarrow16.png'))

  member .drawingList is ARRAY
  member .allTaskList is ABATASKLIST
  member .taskList    is ABATASKLIST
  member .task        is ABATASK
  member .mode        is STRING

exit

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !dlist = ARRAY()

  -- Get all global tasks from the task form
  if (defined(!!abaTasks)) then

    !!abaTasks.init()

    !this.allTaskList.taskArray = !!abaTasks.globalTasks.taskArray

  else

    !this.allTaskList.getLibraryTasks('DRAWING')

  endif

  -- For each task in the list get its name
  do !taskObj values !this.allTaskList.taskArray
    !dlist.append(!taskObj.name.substring(2))
  enddo

  -- Populate the options list
  !this.options.dtext = !dlist

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .addTask(STRING)
--
-- Description: Add a selected task from the options list to the choice list
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addTask(!string is STRING)

  !curDtext = !this.choice.dtext

  if (!curDtext.size() eq 0 or !curDtext.find(!string).size() eq 0) then

    !curDtext.append(!this.options.selection('DTEXT'))

    !this.choice.dtext = !curDtext
    !this.choice.val   = !curDtext.size()

    !this.task = !this.allTaskList.taskArray[!this.options.val]
    !this.taskList.taskArray.append(!this.task)

    !this.options.val = !this.options.val + 1
      handle (61,620)
        -- F&M: Value is invalid, at bottom of list
        !this.options.val = 1
      endhandle

    !!abaProcess.setTaskStatus()

  endif

endmethod
-- End of method .addTask(STRING)

------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Actions when closing this form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  kill !!editUserTask

  !!abaProcessTask.hide()

  !!abaProcess.visible()

endmethod
-- End of method .cancel()

------------------------------------------------------------------------
--
-- Method:      .modifyTask(STRING)
--
-- Description: Call the form to enable the task parameters to be modified
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyTask(!taskName is STRING)

  if (!taskName.eq('')) then

    !!alert.warning('No tasks Available for Modification')
    return

  else

    !!abaBuildEditForm(!this.task,'PROCESS')
    show !!editUserTask

  endif

endmethod
-- End of method .modifyTask(STRING)

------------------------------------------------------------------------
--
-- Method:      .receiveTask(ABATASK)
--
-- Description: Receive the modified task object from the modifying form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .receiveTask(!task is ABATASK)

  -- initialize variables
  !form = !!abaProcessTask

  -- Replace this task
  !form.task = !task

  -- Find the task in the task list array
  do !position ind !form.allTaskList.taskArray

    !task = !form.allTaskList.taskArray[!position]

    break if (!task.name.eq(!form.task.name))

  enddo

  !form.allTaskList.taskArray[!position] = !form.task

  -- Replace the selected task in the choice grid
  !form.taskList.taskArray[!form.choice.val] = !form.task

endmethod
-- End of method .receiveTask(ABATASK)

------------------------------------------------------------------------
--
-- Method:      .removeTask(REAL)
--
-- Description: Remove the selected task from the choice list
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeTask(!rowNumber is REAL)

  if (!rowNumber.neq(0)) then

    !this.tasklist.taskArray.remove(!rowNumber)

    !curDtext = !this.choice.dtext

    !curDtext.remove(!rowNumber)

    !this.choice.dtext = !curDtext

  endif

  !!abaProcess.setTaskStatus()

endmethod
-- End of method .removeTask(REAL)

------------------------------------------------------------------------
--
-- Method:      .selectTask()
--
-- Description: Store the currently selected tasks
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectTask()

  !this.task = !this.taskList.taskArray[!this.choice.val]

endmethod
-- End of method .selectTask()
