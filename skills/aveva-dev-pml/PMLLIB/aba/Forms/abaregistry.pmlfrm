-- File:            abaregistry
--   Type:          Form Definition
--   Group:         draft
--     Keyword:     ABA
--   Module:        DRAFT
--   Replaces:
--
-- Author:          MpW
-- Created:         19 March 1999
--
--
-- Description:
-- Displays a list of REGI elements for selection
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaRegistry()                    -                   Constructor method
--  cancel()                         -                   Close this form
--  filterOut()                      -                   Filter out un-wanted registry names, to tidy up choice selection.
--  getRegi()                        -                   Get all available registries
--  init()                           -                   Method to initialize the form
--  setRegiName()                    -
--  toggleChk()                      -                   Toggle check
--
------------------------------------------------------------------------
setup form !!abaRegistry

  title 'Registry List'
  !this.callback      = '!this.init()'
  !this.cancelCall    = '!this.cancel()'
  !this.quitCall      = '!this.cancel()'

  frame .frame1 |Available Registries|

    toggle .filTog '' at ymax

    text .filter 'Filter' at xmax ymin width 15 is STRING

    list .regiList '' at x1 ymax+0.2 single width 30 hei 20

  exit

  -- All available and writable registries
  member .allRegi is ARRAY

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      .abaRegistry()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .abaRegistry()

  -- Form callbacks
  !this.filTog.callback    = '!this.toggleChk()'
  !this.filter.callback    = '!this.filterOut()'
  !this.regiList.callback  = '!this.setRegiName()'

  -- Set filter off
  !this.filTog.val = false

endmethod
-- End of method definition for .abaRegistry()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Get all available registries
  !this.getRegi()

  -- Filter the list as required
  !this.filterOut()

endmethod
-- End of method .init()

------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Close this form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  !this.hide()

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      .filterOut()
--
-- Description: Filter out un-wanted registry names, to tidy up choice selection.
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .filterOut()

  -- If filtering is required
  if (!this.filtog.val and !this.filter.val.neq('')) then

    -- Initialise variables
    !allNames = ARRAY()

    -- For each filter word
    do !word values !this.filter.val.split()

      -- Scan the available registries
      do !regiRefe values !this.allRegi

        -- If the filter word matches the registry name
        if (!regiRefe.name.upcase().match(!word.upcase()).eq(0)) then

          -- Add this registry for display
          !allNames.append(!regiRefe.name)

        endif

      enddo

    enddo

  -- No filtering
  else

    -- Display all available registries
    !extractName = object BLOCK('!this.allRegi[!evalIndex].name')
    !allNames    = !this.allRegi.evaluate(!extractName)

  endif

  -- Populate the list
  !this.regiList.dtext = !allNames

  !this.filter.setfocus()

endmethod

------------------------------------------------------------------------
--
-- Method:      .getRegi()
--
-- Description: Get all available registries
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getRegi()

  -- Initialise variables
  !this.allRegi.clear()

  -- Find all registries
  VAR !allRegi COLL ALL REGI

  -- Eliminate those without Write access
  do !regi values !allRegi

    -- initialize variables
    !regirefe = !regi.dbref()

    -- For a registry that is writable
    if (!regiRefe.dbwrite) then

      -- Store in the form member
      !this.allRegi.append(!regiRefe)

    else

      -- Build message string
      !message = 'The REGI ' & !regiRefe.fullname & ' is READ only and has been ignored.'

      -- Report to the command line that the eliminated regis is unwritable
      WRITE '$!message'

    endif

  enddo

endmethod
-- End of method definition for .getRegi()

------------------------------------------------------------------------
define method .setRegiName()

  !!abaProcess.useRegName.val = !this.regiList.selection()
  !!abaprocess.regiName       = !this.regiList.selection().dbref()

  !this.hide()

endmethod
-- End of method definition for .setRegiName()

------------------------------------------------------------------------
--
-- Method:      .toggleChk()
--
-- Description: Toggle check
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toggleChk()

  -- Filter the registries only when filter is set
  if (!this.filter.val.neq('')) then

    !this.filterOut()

  endif

endmethod
-- End of method definition for .toggleChk()
