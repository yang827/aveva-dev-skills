--
-- Description: Define Area (idlists).
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaSelectArea()                  -                   Constructor method
--  afterSelectChange(ARRAY)         -                   Callback on grid control after select change of the grid
--  init()                           -                   Method to initialize the form
--  setlimits()                      -
--  settype()                        -
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!abaSelectArea

  title |Select Keyplan Area|
  init |!this.init()|

  path down

  para .title at x0 y0 text |Areas|

  container .areasGrid nobox pmlNetControl 'NET' at xmin ymax-0.4 width 51 height 8

  rgroup .area horizontal
    add tag 'Use Area Limits'  call |!this.setType()|
    add tag 'Auto Limits'      call |!this.setType()|
  exit

  button .apply   | Apply | call |!this.setLimits()| ok

  path right
  button .dismiss |Dismiss| at xmax form-size call || cancel

  -- Declare the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  member .areasControl is NETGRIDCONTROL

  -- Members
  member .headings is ARRAY
  member .allIdli  is ARRAY
  member .idliRefe is DBREF

exit

------------------------------------------------------------------------
--
-- Method:      .abaSelectArea()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .abaSelectArea()

  -- Create instances of the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  !this.areasControl = object NETGRIDCONTROL()

  -- Add .net control to the containers
  !this.areasGrid.control = !this.areasControl.handle()

  -- Add PML event handlers to .net controls
  !this.areasControl.addEventHandler('afterSelectChange', !this, 'afterSelectChange')

  -- Set grid visual attributes
  !this.areasControl.columnExcelFilter(false)
  !this.areasControl.outlookGroupStyle(false)
  !this.areasControl.fixedRows(false)
  !this.areasControl.gridHeight(1000.0)
  !this.areasControl.editableGrid(false)
  !this.areasControl.singleRowSelection(true)
  !this.areasControl.columnExcelFilter(false)
  !this.areasControl.fixedHeaders(false)
  !this.areasControl.headerSort(true)
  !this.areasControl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Name')
  !this.headings.append('Description')

endmethod
-- End of method definition for .abaSelectArea()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !rowSet  = ARRAY()
  !this.allIdli.clear()

  -- Get area library
  !list = !!abadefaults.alib.val.dbref()

  -- Get all area idli
  VAR !allIdli COLL ALL IDLI FOR $!list
  VAR !allNames EVAL NAME FOR ALL FROM !allIdli

  -- Sort areas by name
  !allIdli.reindex(!allNames.sortedIndices())

  -- Build the row data set
  do !idli val !allIdli

    -- Initialise variables
    !idliRefe = !idli.dbref()
    !rowData  = ARRAY()

    -- Build row data
    !rowData.append(!idliRefe.flnn)
    !rowData.append(!idliRefe.func)

    -- Add row data to row set array
    !rowSet.append(!rowData)

    -- Store idli reference
    !this.allIdli.append(!idliRefe)

  enddo

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.areasControl.bindToDataSource(object NETDATASOURCE('Areas', !this.headings, !rowSet, '^Name'))

  -- Get the area name for the view currently being modified
  !areaName = !!abaUserView.viewName.idln.function

  -- If the area has a name, select it from the grid
  if (!areaName.eq('').not()) then

    !this.areasControl.selectRow(!this.allIdli.findFirst(!areaName.dbref()))
    !this.area.val = 1

  else

    !this.area.val = 2

  endif

  !this.setType()

  !!abaUserView.saved = FALSE

endmethod

------------------------------------------------------------------------
--
-- Method:      .afterSelectChange(ARRAY)
--
-- Description: Callback on grid control after select change of the grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .afterSelectChange(!array is ARRAY)

  -- Select the drtmpl
  if (!this.areasControl.getSelectedRowTags().set()) then

    -- Store the selected area
    !this.idliRefe = !this.allIdli[!this.areasControl.getSelectedRowTags()[1].real()]

  endif

endmethod
-- End of method definition for .afterSelectChange(ARRAY)

-------------------------------------------------------------
define method .settype()

  if(!this.area.val eq 2)then
    !this.areasGrid.active = false

  else
    !this.areasGrid.active = true

  endif

endmethod

-------------------------------------------------------------
define method .setlimits()

  -- Store hierarchy location
  !save = !!ce

  -- Access the idli of the view currently being modified
  IDLI $!!abaUserView.viewName.idln

  -- For auto limits
  if (!this.area.val.eq(2)) then

    LIMI UNSET
    FUNCTION UNSET

  -- For area limits
  else

   !desc = !this.idliRefe.name
   !limi = !this.idliRefe.limi

   FUNCTION |$!desc|
   LIMITS E $!limi[1] N $!limi[2] U $!limi[3] TO E $!limi[4] N $!limi[5] U $!limi[6]

  endif

  -- Mark user view form as saved
  !!abaUserView.saved = TRUE

  -- return to original ce
  !!ce = !save

endmethod
