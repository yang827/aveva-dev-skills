-- Created:         17 March 1999
--
--
-- Description: Set text template for rule.
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addlib()                         -
--  init()                           -
--  movece()                         -
--  select()                         -
--
------------------------------------------------------------------------
setup form !!abaselectlabel
 Title 'Select Label Template'
 track 'PADDCE' callback '!this.movece()'
 init '!this.init()'
 path down
 para .libtext  text 'Label Libraries'
 option .libys  call '!this.addlib()' width 50
 list .tempname call '!this.select()' width 50 hei 12
 view .sliby at xmin.tempname ymax.tempname area
  width 50 hei 15
 exit
 button .apply  ' Apply ' call |!!abatagrules.template.val = !this.tempname.selection('dtext')| ok
 path right
-- button .limits 'Reset View Limits' call |!this.addlib()|
 button .cancel 'Cancel' at xmax form -size ymin cancel

 menu .pop1
      !this.pop1.add ('CALLBACK','Reset View Limits',|!this.addlib()|)
      !this.sliby.setpopup(!this.pop1)


exit

define method .init()

   var !elist coll all (lalb sylb)
   var !name eval name for all from !elist
   !this.libys.dtext = !name
   !this.libys.rtext = !elist
   $!!abatagrules.template.val
   handle any
   elsehandle none
     !this.libys.select('rtext',!!ce.owner.ref.string())
       handle any
       endhandle
   endhandle
   !this.addlib()

endmethod

define method .addlib()

   edit view !!abaselectlabel.sliby area
     put $!this.libys
   Exit
   var !list coll all (txtm sytm) for $!this.libys
   var !name eval name for all from !list
   !this.tempname.dtext = !name
   !this.tempname.rtext = !list
   !this.tempname.select('rtext',!!ce.ref.string())
   handle any
   elsehandle none
      unenhance all
      refresh $!this.sliby
      enhance ce
      highlight ce
   endhandle
endmethod

define method .select()

  $!this.tempname
  !this.addlib()

endmethod

define method .movece()

   textm
   handle any
   elsehandle none
     !this.tempname.select('dtext',!!ce.name)
     !this.select()
     return
   endhandle

   sytm
   handle any
   elsehandle none
     !this.tempname.select('dtext',!!ce.name)
     !this.select()
   endhandle

endmethod
