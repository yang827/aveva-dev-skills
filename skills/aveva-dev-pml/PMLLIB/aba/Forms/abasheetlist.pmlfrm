-- Created:         17 March 1999
--
--
-- Description: List of available drawings for Modification.
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaSheetList()                   -                   Constructor method
--  afterSelectChange(ARRAY)         -                   Callback on grid control after select change of the options grid
--  cancel()                         -
--  init()                           -                   Method to initialize the form
--  selectSheet()                    -                   Using the selected sheet, show the sheet form
--  setSheet(string)                 -
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!abaSheetList

  title |ABA Template Sheet List|
  init |!this.init()|
  cancelcall |!this.cancel()|

  para .title at x0 y0 text |Template Sheets|
  container .sheetGrid nobox pmlNetControl 'NET' at xmin ymin+0.6 width 60 height 12

  -- Declare the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  member .sheetControl is NETGRIDCONTROL

  member .headings  is ARRAY
  member .allSheets is ARRAY
  member .mode      is STRING

exit
------------------------------------------------------------------------
--
-- Method:      .abaSheetList()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------------------------------
define method .abaSheetList()

  -- Create instances of the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  !this.sheetControl = object NETGRIDCONTROL()

  -- Add .net control to the container
  !this.sheetGrid.control = !this.sheetControl.handle()

  -- Add PML event handlers to .net control
  !this.sheetControl.addEventHandler('afterSelectChange', !this, 'afterSelectChange')

  -- Set grid visual attributes
  !this.sheetControl.columnExcelFilter(false)
  !this.sheetControl.outlookGroupStyle(false)
  !this.sheetControl.fixedRows(false)
  !this.sheetControl.gridHeight(1000.0)
  !this.sheetControl.editableGrid(false)
  !this.sheetControl.singleRowSelection(true)
  !this.sheetControl.columnExcelFilter(false)
  !this.sheetControl.fixedHeaders(false)
  !this.sheetControl.headerSort(true)
  !this.sheetControl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Name')
  !this.headings.append('Title')
  !this.headings.append('Function')

endmethod
-- End of method definition for .abaSheetList()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !rowSet  = ARRAY()

  -- Get all sheets
  VAR !allSheets COLLECT ALL SHTMPL FOR $!!abaDefaults.dlib.val
  VAR !allNames EVAL NAME FOR ALL FROM !allSheets

  -- Sort all sheets by name
  !allSheets.reindex(!allNames.sortedIndices())

  -- Build the row data set
  do !sheet val !allSheets

    -- Initialise variables
    !sheetRefe = !sheet.dbref()
    !rowData   = ARRAY()

    -- Build row data
    !rowData.append(!sheetRefe.name)
    !rowData.append(!sheetRefe.title)
    !rowData.append(!sheetRefe.func)

    -- Add row data to row set array
    !rowSet.append(!rowData)

    -- Store view reference
    !this.allSheets.append(!sheetRefe)

  enddo

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.sheetControl.bindToDataSource(object NETDATASOURCE('Sheets', !this.headings, !rowSet, '^Name'))

  prompt ''

endmethod

------------------------------------------------------------------------
--
-- Method:      .afterSelectChange(ARRAY)
--
-- Description: Callback on grid control after select change of the options grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .afterSelectChange(!array is ARRAY)

  -- Select the drtmpl
  if (!this.sheetControl.getSelectedRowTags().set()) then
    !this.selectSheet()
  endif

endmethod
-- End of method definition for .afterSelectChange(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .selectSheet()
--
-- Description: Using the selected sheet, show the sheet form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectSheet()

  -- Access the selected view
  !!ce = !this.allSheets[!this.sheetControl.getSelectedRowTags()[1].real()]

  -- Hide this form
  !!abaSheetList.hide()

  -- Set forms
  show !!abaUserView cen xr 0.5 yr 0.4
  !!abaUserView.runInit()
  !!abaUserView.Mode = !this.mode

endmethod
-- End of method .selectSheet()

------------------------------------------------------------------------
define method .setSheet(!Selection is string)

  !!abaSheetList.Hide()
  show !!abaTemplateSht
  !!abaUserView.Mode = !This.mode
  !!ce = !this.SheetList.selection('RTEXT').dbref()

  show !!abaUserView cen xr .5 yr .4
  !!abaUserView.runInit()

endmethod

------------------------------------------------------------------------
define method .cancel()

  !!abaSheetList.hide()
  !!abaProcess.visible()

endmethod
