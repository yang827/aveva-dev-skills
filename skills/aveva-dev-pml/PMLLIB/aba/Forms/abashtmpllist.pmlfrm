--   Type:          Form Definition
--   Group:
--     Keyword:
--   Module:
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         05 July 1999
--
--
-- Description: Display all drawing template sheets for picking
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaShTmplList()                  -                   Constructor method
--  afterSelectChange(ARRAY)         -                   Callback on grid control after select change of the options grid
--  getAllShtmpl()                   -                   Get all drawing templates
--  init()                           -                   Method to initialize the form
--  select()                         -
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!abaShTmplList

  title |ABA Template Sheet List|
  init |!this.init()|
  cancelcall |!this.cancel()|

  -- Selection Area
  para .title at x0 y0 text |Template Sheets|

  container .shtGrid nobox pmlNetControl 'NET' at xmin ymin+0.6 width 60 height 12

  -- Declare the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  member .shtControl is NETGRIDCONTROL

  -- Members
  member .headings  is ARRAY
  member .allShtmpl is ARRAY
  member .drTmpl    is DBREF
  member .mode      is STRING

-- End of form definition
exit

------------------------------------------------------------------------
--
-- Method:      .abaShTmplList()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------------------------------
define method .abaShTmplList()

  -- Create instances of the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  !this.shtControl = object NETGRIDCONTROL()

  -- Add .net control to the container
  !this.shtGrid.control = !this.shtControl.handle()

  -- Add PML event handlers to .net control
  !this.shtControl.addEventHandler('afterSelectChange', !this, 'afterSelectChange')

  -- Set grid visual attributes
  !this.shtControl.columnExcelFilter(false)
  !this.shtControl.outlookGroupStyle(false)
  !this.shtControl.fixedRows(false)
  !this.shtControl.gridHeight(1000.0)
  !this.shtControl.editableGrid(false)
  !this.shtControl.singleRowSelection(true)
  !this.shtControl.columnExcelFilter(false)
  !this.shtControl.fixedHeaders(false)
  !this.shtControl.headerSort(true)
  !this.shtControl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Name')
  !this.headings.append('Title')
  !this.headings.append('Function')

endmethod
-- End of method definition for .abaShTmplList()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Clear data array
  !this.allShtmpl.clear()

  -- Clear the grid
  !this.shtControl.clearGrid()

  -- Get all drawing templates and populate the grid
  !this.getAllShtmpl()

endmethod

------------------------------------------------------------------------
--
-- Method:      .afterSelectChange(ARRAY)
--
-- Description: Callback on grid control after select change of the options grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .afterSelectChange(!array is ARRAY)

  -- Select the drtmpl
  if (!this.shtControl.getSelectedRowTags().set()) then
    !this.select()
  endif

endmethod
-- End of method definition for .afterSelectChange(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .getAllShtmpl()
--
-- Description: Get all drawing templates
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAllShtmpl()

  -- Initialise variables
  !rowSet = ARRAY()

  -- Test for collection type
  if (!this.mode.eq('ALL')) then

   -- Get all sheets for template library
    VAR !allShtmpl COLLECT ALL SHTMPL FOR $!!abaDefaults.dlib.val

  else

    -- Get drawing template
    !drTmpl = !!abaTemplateDrg.name.val.dbref()
      handle any
        pml load form !!abaTemplateDrg
        !drTmpl = !!abaTemplateDrg.name.val.dbref()
      endhandle

    -- Get all sheets for current drawing template
    VAR !allShtmpl COLLECT ALL SHTMPL FOR $!drTmpl

  endif

  -- Build the row data set
  do !shtmpl val !allShtmpl

    -- Initialise variables
    !shtmplRefe = !shtmpl.dbref()
    !rowData    = ARRAY()

    -- Build row data
    !rowData.append(!shtmplRefe.name)
    !rowData.append(!shtmplRefe.title)
    !rowData.append(!shtmplRefe.func)

    -- Add row data to row set array
    !rowSet.append(!rowData)

    -- Store drtmpl reference
    !this.allShtmpl.append(!shtmplRefe)

  enddo

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.shtControl.bindToDataSource(object NETDATASOURCE('Tasks', !this.headings, !rowSet, '^Name'))

endmethod
-- End of method .getAllShtmpl()

------------------------------------------------------------------------
define method .select()

  -- Access the chosen sheet template
  !!ce = !this.allShtmpl[!this.shtControl.getSelectedRowTags()[1].real()]

  -- Close this form & show the sheet form
  hide !!abaShTmplList

  !!abaTemplateSht.drTmpl = !!ce.owne
  !!abaTemplateSht.mode   = 'MODIFY'

  show !!abaTemplateSht centred xr 0.3 yr 0.3

endmethod
