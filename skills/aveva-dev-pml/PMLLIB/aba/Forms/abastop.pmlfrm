--
-- File:            abastop.pmlfrm
--   Type:          Form Definition
--   Group:         AB_ADP application
--     Keyword:     ABA
--   Module:        Draft
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Wed Mar 4 18:10:24 GMT 1998
--
--
-- Description:
--
-- Cancel button on form to stop a process. By showing this form and
-- checking a status flag via F&M during a process you can stop the
-- code doing anything further. Example;
--
--     show !!abaStop
--     !!abaStop.setText1('Press Cancel to abort processing')
--
--     do !X
--
--       ...code...
--
--       if (!!fmsys.interrupt()) then
--         !!alert.warning('Processing aborted')
--         break
--       endif
--     enddo
--
--     hide !!stop
--
-- It is not expected that Cancel means undo anything already done, just stop.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  setText(STRING,REAL)             -
--
------------------------------------------------------------------------
setup form !!abaStop

  !this.formTitle     = 'Process Status'
  !this.iconTitle     = ''
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.3.8.2 $ '

  -- Body of form definition
path down
  para   .stopText1  at x1 y1   width 60 lines 1
  para   .stopText2             width 60 lines 1

frame .para ''
  para   .stopText3            text |        Press Cancel to stop the Process|  width 60 lines 1
  button .stopButton |Cancel| at x22
exit

exit
-- End of form definition

-----------------------------------------------------------------------
--
-- Method:      !setText(STRING,REAL)
--
-- Description:
--
-- Sets the text above the Cancel (stop) button.
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .setText(!text is STRING,!which is REAL)

  if (!!abaStop.shown().not()) then
    return
  endif

  !btext = |!!abastop.stoptext| & !which
  $!<btext>.val = !text

  refresh $!<btext>
  refresh !!abaStop.stopButton

endmethod
-- End of method definition for .setText(STRING,REAL)
