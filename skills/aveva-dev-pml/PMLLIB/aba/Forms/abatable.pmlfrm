--
--
-- Description: Modify table function parameters
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  init()                           -
-- Members
--   [Name]           [Description]
--   taskname          Name of this task
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

setup form !!abatable blocking
  title |Choose options|
  init |!this.init()|


-- Define Members/Selection Areas
-- ------------------------------

  frame .options | Options | at x0

    path down
    option .build   |Build Direction    | at x1 y1 width 10

    option .disc   |Discipline to fill | width 28

    option .header |Header Template    | width 28
    option .entry  |Entry Template     | width 28
    option .last   |Lastentry Template | width 28

  exit

-- Action buttons
-- --------------

  path right
  button .ok     | Apply | at x0 ymax.last+0.7 call |!this.apply()| ok
  button .cancel |Dismiss| at xmax.last-7.3 cancel


  -- Members
  member .task     is ABATASK
  member .taskName is STRING
  member .form     is FORM

-- End of form definition
exit

--------------------------------------------------------------------
define method .init()
--------------------------------------------------------------------
-- Called when form is shown

  -- Set build gadget
  !dtext[1] = 'Vertical'
  !dtext[2] = 'Horizontal'
  !rtext[1] = 'V'
  !rtext[2] = 'H'
  !this.build.dtext = !dtext
  !this.build.rtext = !rtext

  -- Get all available disciplines
  VAR !idli COLL ALL IDLI WI SPPURP EQ 'ABAT' FOR $!!abadefaults.disl.val
  VAR !names EVAL NAME FOR ALL FROM !idli
  !this.disc.dtext = !names
  !this.disc.rtext = !idli

  -- Get all available symbols
  VAR !sytm COLL ALL SYTM FOR $!!abadefaults.symb.val
  VAR !names EVAL NAME FOR ALL FROM !sytm
  !this.header.dtext = !names
  !this.header.rtext = !sytm
  !this.entry.dtext  = !names
  !this.entry.rtext  = !sytm
  !this.last.dtext   = !names
  !this.last.rtext   = !sytm

  -- Make current value selections
  !param = !this.task.paramVal

  !this.build.select('RTEXT',!param[1])
    handle any
      !this.build.select('RTEXT',!param[1])
        handle any
        endhandle
    endhandle

  !this.disc.select('DTEXT',!param[2])
    handle any
      !this.disc.select('RTEXT',!param[2])
        handle any
        endhandle
    endhandle

  !this.header.select('DTEXT',!param[3])
    handle any
      !this.header.select('RTEXT',!param[3])
        handle any
        endhandle
    endhandle

  !this.entry.select('DTEXT',!param[4])
    handle any
      !this.entry.select('RTEXT',!param[4])
        handle any
        endhandle
    endhandle

  !this.last.select('DTEXT',!param[5])
    handle any
      !this.last.select('RTEXT',!param[5])
        handle any
        endhandle
    endhandle

   -- Read and store task name
   !this.taskname = !this.task.name

   -- Set form title
   !this.formTitle = !this.taskName

endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------
-- Called when apply is pressed

   -- Build parameters array
   !parameters[1] = !this.build.selection('RTEXT')
   !parameters[2] = !this.disc.selection('RTEXT')
   !parameters[3] = !this.header.selection('RTEXT')
   !parameters[4] = !this.entry.selection('RTEXT')
   !parameters[5] = !this.last.selection('RTEXT')

   -- Reset the task object
   !this.task.paramVal = !parameters

   -- Transfer the modified task back to the calling form
   !this.form.receiveTask(!this.task)

endmethod
