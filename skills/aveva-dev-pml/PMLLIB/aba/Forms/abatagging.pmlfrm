------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  buildruleset()                   -
--  cancel()                         -
--  getexistrules()                  -
--  init()                           -
--  insert()                         -
--  remove()                         -
--  setrules()                       -
--  swapdesc(string)                 -
--
------------------------------------------------------------------------
setup form !!abatagging

   title |Add Tag rule Lists |
   init |!this.init()|
   cancelcall |!this.cancel()|

   path down
   frame .rstframe 'Tag Rule Sets '
     option .trst at ymin+1 call '!this.setrules()'  width 54
     para .rules at xmin ymax+.4 text |Tag Rules|
     list .dlist at ymin+1 call || multiple width 54 hei 8
   exit
     button .inserta | Add | at x17 ymax.rstframe+.5 call |!this.insert()|
     path right
     button .delete  | Remove | call |!this.remove()| at xmax.inserta+7

   frame .tlist 'Tag Rule List (Current View)' at x0 ymax.inserta+.5
     path down
     list .clist at x1 y1 call || multiple width 54 hei 8
   exit
   button .apply  '  OK  ' at x0 call '!this.buildruleset()' ok
   button .cancel 'Cancel' at xmax form -size ymin call |!this.cancel()| cancel

  menu .pop1
    !this.pop1.add ('CALLBACK','Select All',|!this.dlist.select('RTEXT',!this.dlist.rtext)|)
    !this.pop1.add ('CALLBACK','Clear Selection',|!this.dlist.clearSelection()|)
    !this.pop1.add ('SEPARATOR')
    !this.pop1.add ('CALLBACK','List by Descriptions',|!this.swapdesc('desc')|)
    !this.pop1.add ('CALLBACK','List by Names',|!this.swapdesc('name')|)
    !this.trst.setpopup(!this.pop1)
    !this.dlist.setpopup(!this.pop1)

  menu .pop2
    !this.pop2.add ('CALLBACK','Select All',|!this.clist.select('RTEXT',!this.clist.rtext)|)
    !this.pop2.add ('CALLBACK','Clear Selection',|!this.clist.clearSelection()|)
    !this.clist.setpopup(!this.pop2)

  member .mode     is STRING
  member .viewName is DBREF
  member .vflag    is BOOLEAN
  member .ce       is DBREF

  !this.vflag = false

exit
-- End of form definition

------------------------------------------------------------------------
define method .init()
------------------------------------------------------------------------
-- This method initialises the form gadgets by first of all finding the default
-- tag library and collecting all of the available tags into a tag ruleset and then
-- tag rules this populates the two list gadgets.
  !this.ce = !!ce
  loadform !!abacrtrst
  !this.clist.clear()
  !list = !!abadefaults.labl.val.dbref()
  handle(2,813)
    return error 55 'No default tag Library defined - Edit defaults and try Again'
  endhandle
  $!list
  var !TrstList coll all trst for $!list
  var !TrstName eval name for all from !TrstList
  var !trstdesc eval func for all from !TrstList
  If(!TrstList.empty().not())then
     if(!this.vflag)then
       !this.trst.dtext = !TrstName
     else
       !this.trst.dtext = !TrstDesc
     endif
     !this.trst.rtext = !TrstList
     !tsel = !this.Trst.selection()
     var !coll coll all tagr for $!tsel
     var !name eval name for all from !coll
     var !desc eval func for all from !coll
       if(!this.vflag)then
       !this.dlist.dtext = !Name
     else
       !this.dlist.dtext = !Desc
     endif
     !this.dlist.rtext = !coll
  else
    !x[1] = 'Unset'
    !this.trst.dtext = !x
    !this.dlist.dtext = !x
  endif
  !this.getexistrules()

endmethod

------------------------------------------------------------------------
Define method .select()
------------------------------------------------------------------------
$(
  -- Single selection method
  !ref = !This.clist.selection().dbref()
  handle any
    return
  endhandle
  !this.trst.select('rtext',!ref.owner.string())
  handle any
  endhandle
  !this.setrules()
  !this.clist.select('rtext',!ref.string())
  handle any
  endhandle
$)

  -- Multiple selection method
  -- Force selection of first current tag rule
  if(!this.clist.rtext.empty()) then
    return
  endif

  if (defined(!this.clist.rtext[1])) then
    !this.clist.select('RTEXT',!this.clist.rtext[1])
  endif

  -- Initialise variables
  !tagr = !this.clist.selection('RTEXT')

  -- Attempt to select owning tag rule set
  if (!tagr[1].eq('unset')) then
    !!alert.error('A tagrule link reference is unset. Please rebuild all tagrules')
    return
  endif

  if (not badref(!tagr[1].dbref())) then

    -- Select
    !this.trst.select('RTEXT',!tagr[1].dbref().owner.string())

  else
    return
  endif

  -- Get all tag rules for the selected tag rule set
  !this.setRules()

  -- Select the current list entries
  !dRtext = !this.dlist.rtext
  !cRtext = !this.clist.rtext
  do !dRefe val !dRtext

    do !cRefe val !cRtext

      if (!cRefe.eq(!dRefe)) then

        !this.dlist.select('RTEXT',!dRefe)
        !this.clist.select('RTEXT',!dRefe)
        skip

      endif

    enddo

  enddo

endmethod

------------------------------------------------------------------------
define method .insert()
------------------------------------------------------------------------
$(
  -- Single selection method
  !dtex = !this.dlist.dtext
  !rtex = !this.dlist.rtext
  !cdtex = !this.clist.dtext
  !crtex = !this.clist.rtext
------------**********************************************---------------

  !selection = !this.clist.val
-- this is where insert before after should go
-- use insert on !selection instead of append

------------**********************************************--------------

  if(!this.clist.dtext.find(!this.dlist.selection('dtext')).unset())Then
    !cdtex.append(!this.dlist.selection('dtext'))
    !crtex.append(!this.dlist.selection('rtext'))
  else
    return
  endif
  !this.clist.dtext = !cdtex
  !this.clist.rtext = !crtex
  !this.select()
$)

  -- Multiple selection method

  -- Initialise variables
  !dDtext = !this.dlist.selection('DTEXT')
  !dRtext = !this.dlist.selection('RTEXT')
  !cDtext = !this.clist.dtext
  !cRtext = !this.clist.rtext

  -- For each drawlist selected
  do !index ind !dDtext

    -- Test if already added to  current view list
    if (!cDtext.find(!dDtext[!index]).unset()) then

      -- Add to current arrays
      !cDtext.append(!dDtext[!index])
      !cRtext.append(!dRtext[!index])

    endif

  enddo

  -- Set list gadget
  !this.clist.dtext = !cDtext
  !this.clist.rtext = !cRtext

endmethod

------------------------------------------------------------------------
define method .remove()
------------------------------------------------------------------------
$(
  -- Single selection method
  -- For anything to remove
  if (!this.clist.val.neq(0)) then
    !dtex = !this.clist.dtext
    !rtex = !this.clist.rtext
    !dtex.remove(!this.clist.val)
    !rtex.remove(!this.clist.val)
    !this.clist.dtext = !dtex
    !this.clist.rtext = !rtex
  endif
$)

  -- Multiple selection method

  -- Initialise variables
  !cDtext = !this.clist.dtext
  !cRtext = !this.clist.rtext
  !sDtext = !this.clist.selection('DTEXT')
  !sRtext = !this.clist.selection('RTEXT')

  -- Set list gadget
  !this.clist.dtext = !cDtext.difference(!sDtext)
  !this.clist.rtext = !cRtext.difference(!sRtext)

endmethod



------------------------------------------------------------------------
define method .setrules()
------------------------------------------------------------------------

  !tsel = !this.Trst.selection()
  if (!tsel.eq('Unset')) then
    !!alert.error('There are not any tagrules to choose from')
    return
  endif

  var !coll coll all tagr for $!tsel
  var !name eval name for all from !coll
  var !desc eval func for all from !coll

  if (!this.vflag) then
    !this.dlist.dtext = !Name
  else
    !this.dlist.dtext = !Desc
  endif
  !this.dlist.rtext = !coll

  !this.clist.clearSelection()

endmethod

------------------------------------------------------------------------
define method .swapdesc(!d is string)
------------------------------------------------------------------------

  if (!d eq 'name')then
     !this.vflag = true
  else
   !this.vflag = false
  endif
  !this.init()

endmethod


------------------------------------------------------------------------
define method .buildruleset()
------------------------------------------------------------------------

$!this.viewname
var !coll coll all layer with SpPURP eq 'TAGA' for ce
$!coll[1]
handle any
  !!alert.error('No tag layer defined for this view')
  return
elsehandle none
  goto trsf
  handle(2,106)
    DRTMPL
    liby1
    $!!abauserview.viewname/tagrules
    handle any
      new trlb $!!abauserview.viewname.name/tagrules
    endhandle
  endhandle
endhandle
  trst 1
handle any
  new trst $!!abauserview.viewname.name/tagrules/trst1
endhandle

do !s index !this.clist.rtext

  !func = !this.clist.rtext[$!s].dbref().func
  !purp = !this.clist.rtext[!s].dbref().sppurp

  TAGR $!s
   handle any
     NEW TAGR
   endhandle

  COPY $!this.clist.rtext[$!s]
  SpPURP $!purp
  FUNC '$!func'
  LINKREF $!this.clist.rtext[$!s]
    handle (2,822)
    endhandle

enddo

trst
!refname = name
if(!!ce.mcount() gt !this.clist.dtext.size())then
  do !s from !this.clist.dtext.size() + 1 to !!ce.mcount()
    last mem
    delete tagr
  enddo
endif

$!coll[1]
trsf $!refname

       !!ce = !this.ce
       !!abauserview.isModified()

endmethod

------------------------------------------------------------------------
define method .getexistrules()
------------------------------------------------------------------------

$!this.viewname
var !coll coll all layer with SpPURP eq 'TAGA' for ce
$!coll[1]
handle any
  !!alert.error('No tag layer defined for this view')
  return
elsehandle none
  GOTO TRSF
  handle(2,106)
   return
  endhandle
endhandle
-- we are now at the tag rule set for the view
!trname = !!ce
label /startagain
var !rules coll all tagr for $!trname

do !list values !rules
  $!list
  if(!list.dbref().func.unset())then
   delete tagr
   golabel /startagain
  endif
enddo

  -- Read the description and the original copied library tagrule
  var !desc eval func for all from !rules
  var !refe eval refe of linkref for all from !rules
  handle (2,107)
    -- Unable to find reference, might be that the tag rule has been deleted.
    var !linkref FUNCTION
    var !criteria CRITERIA
     !reply = !!alert.error('Tag rule "$!linkref/$!criteria" not present - reselect')
     return
  endhandle

  -- Put read data into form
  if (!this.vflag)then
    !this.clist.dtext = !refe
  else
    !this.clist.dtext = !desc
  endif
  !this.clist.rtext = !refe

  !this.select()

endmethod

------------------------------------------------------------------------
define method .cancel()
------------------------------------------------------------------------
--
       hide !!abaTagging
       !!ce = !this.ce
--
endMethod
