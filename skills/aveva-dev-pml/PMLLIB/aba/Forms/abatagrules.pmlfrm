------------------------------------------------------------------------
setup form !!abatagrules
------------------------------------------------------------------------
   title |ABA Tag rule Definition |
   init |!this.init()|
   cancelcall |!this.cancel()|

   path down
   frame.rstframe 'Tag Rule Sets ' at y .5
   option .trst at ymin+1 call '!this.setrules()'  width 54
   button .create at xmin ymax 'Create Tag Rule Set...' call '!!abacrtrst.mode = true
   show !!abacrtrst'
   button .modify at xmax+4 ymin 'Modify Tag Rule Set...' call '!!abacrtrst.mode = false
   show !!abacrtrst'
   exit
   frame .action at xmin ymax + 1 |Edit / Create Tag Rule|

     path down
     text .name at x 1 ymax +.5 |Name | call |!this.setname()| width 51 name
     text .rule                            |Rule | width 51 is STRING
     text .desc at x 1 ymax +.5 |Description | call || width 44 is string
     text .template                        |Label Template | width 41  name
     button.setTemplate |Select Label Template ...| at xmin + 15 ymax call 'Show !!abaselectlabel'

   exit

   path right
   hdist 4
   button .inserta  |   Add   | at x10 ymax+1 call |!this.insert(true)|
   button .replace  | Replace | call |!this.replace()|
   button .delete   | Remove | call |!this.Deletediscp()|

   path down
   frame .tlist 'Tag rules' at x 0 ymax.inserta + .5
     list .dlist at ymin+1 call |!this.select()| width 51 hei 8
   exit

   menu .pop1
      !this.pop1.add ('CALLBACK','Sort By Name',|!this.swapdesc('name')|)
      !this.pop1.add ('CALLBACK','Sort By Desc',|!this.swapdesc('desc')|)
      !this.dlist.setpopup(!this.pop1)

   member .ce is DBREF
   member .vflag is boolean

   !this.vflag = true

exit

------------------------------------------------------------------------
define method .init()
------------------------------------------------------------------------
-- This method initialises the form gadgets by first of all finding the default
-- tag library and collecting all of the available tags into a tag ruleset and then
-- tag rules this populates the two list gadgets.
  loadform !!abacrtrst
  !list = !!abadefaults.labl.val.dbref()
  handle(2,109)
    !!alert.error('No default tag Library defined - Edit defaults and try Again')
    return
  endhandle
  !this.ce = !!ce
  $!list
  var !TrstList coll all trst for $!list
  var !TrstName eval name for all from !TrstList
  var !trstdesc eval function for all from !TrstList
  If(!TrstList.empty().not())then
     if(!this.vflag)then
       !this.trst.dtext = !TrstName
     else
       !this.trst.dtext = !TrstDesc
     endif
     !this.trst.rtext = !TrstList
     !tsel = !this.Trst.selection()
     var !coll coll all tagr for $!tsel
     var !name eval name for all from !coll
     var !desc eval function for all From !coll
    if(!this.vflag)then
       !this.dlist.dtext = !Name
     else
       !this.dlist.dtext = !Desc
     endif
     !this.dlist.rtext = !coll
     !this.select()
  else
    !x[1] = 'Unset'
    !this.trst.dtext = !x
    !this.dlist.dtext = !x
   endif

endmethod

------------------------------------------------------------------------
Define method .select()
------------------------------------------------------------------------

  !ref = !This.dlist.selection().dbref()
  if(!ref.unset())then
    !this.template.val = 'Unset'
    !this.rule.val = 'Unset'
    !this.name.val = 'Unset'
    !this.desc.val = 'Unset'
    return
  else
     !this.template.val = !ref.tmrf.name
     handle any
      !this.template.val = 'Unset'
     endhandle
     var !crit criteria of $!ref
     !this.rule.val = !crit
     !this.name.val = !ref.name
     if(!ref.function ne '')then
        !this.desc.val = !ref.function
     else
        !this.desc.val = 'Unset'
     endif
  endif
endmethod

------------------------------------------------------------------------
define method .setname()
------------------------------------------------------------------------
!s = !!checkname(!this.name.val,|new|)
if (unset(!s)) then
    !this.name.val = |Unset|
    !this.name.setfocus()
else
    !this.name.val = !s
endif

endmethod

------------------------------------------------------------------------
define method .insert(!mode is boolean)
------------------------------------------------------------------------

   !liby = !this.trst.selection().dbref()
   $!liby
   handle any
     !!alert.error('Cannot go to rule set')
     return
   endhandle
   !ref = !This.dlist.selection().dbref()
   handle any
     !ref = !!abadefaults.disl.val.dbref()
     !mode = true
   endhandle
   if(!ref.set())then
     $!ref
     if (!mode.not())then
      prev
      handle (2,113)
        end
      endhandle
     endif
   endif
   if(!this.name.val.upcase() eq 'UNSET')then
     !!alert.error('Tagrule must be named - Tag Rule creation ignored')
     return
   endif
   new tagr $!this.name.val
   handle(41,12)
    !!alert.error('Name already Defined')
    delete tagr
    return
   endhandle
   !s = !!abatagrules.template.val.dbref()
   handle(2,813)
   elsehandle none
      tmrf $!s
   endhandle
   if(!this.rule.val.upcase() neq 'UNSET')then
     criteria $!this.rule.val
   endif
   if(!this.desc.val.upcase() neq 'UNSET')then
     function  |$!this.desc.val|
   endif
     SpPURP ABAT

   !this.setrules()

Endmethod

------------------------------------------------------------------------
Define method .deletediscp()
------------------------------------------------------------------------

   !ref = !This.dlist.selection().dbref()
   !name = !ref.name
   !ans = !!alert.confirm('Ok to delete $!ref.name')
   if(!ans eq 'YES')then
     $!ref
     delete tagr
   endif
   !this.setrules()
endmethod

------------------------------------------------------------------------
Define method .replace()
------------------------------------------------------------------------

  !ref = !This.dlist.selection().dbref()
  $!ref
  !s = !!abatagrules.template.val.dbref()
   handle(2,813)
   elsehandle none
      tmrf $!s
   endhandle
   name  $!this.name.val
   handle(41,12)
   endhandle
   if(!this.rule.val.upcase() neq 'UNSET')then
     criteria $!this.rule.val
     handle(47,15)
      !!alert.error(|Cannot set Rule - Please modify and try again|)
     endhandle
   endif
   if(!this.desc.val.upcase() neq 'UNSET')then
     function  |$!this.desc.val|
   endif
  !this.setrules()
endmethod

------------------------------------------------------------------------
define method .setrules()
------------------------------------------------------------------------

     !tsel = !this.Trst.selection()
     var !coll coll all tagr for $!tsel
     var !name eval name for all from !coll
     var !desc eval function for all from !coll
    if(!this.vflag)then
       !this.dlist.dtext = !Name
     else
       !this.dlist.dtext = !Desc
     endif
     !this.dlist.rtext = !coll
     !this.select()

endmethod

------------------------------------------------------------------------
define method .swapdesc(!d is string)
------------------------------------------------------------------------

if (!d eq 'name')then
   !this.vflag = true
else
   !this.vflag = false
endif

!this.init()

endmethod

-------------------------------------------------------------
define method .cancel()
-------------------------------------------------------------

     !!abaTagRules.hide()
     !!abaProcess.visible(TRUE)
     !!ce = !this.ce

  -- Savework and release all that's been claimed out.
  savework
  unclaim all

endMethod
