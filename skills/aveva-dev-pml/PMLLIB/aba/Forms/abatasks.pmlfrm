--   Type:          Function Definition
--   Group:
--     Keyword:
--   Module:
--   Replaces:
--
-- Author:          Martin Wright
-- Created:         5 March 1999
--
--
-- Description: Define and modify ABA Tasks.
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaTasks()                       -                   Constructor method
--  action(STRING)                   -                   Set form depending upon type of Task
--  cancel()                         -
--  checkForSpaces(STRING)           -
--  checkName(STRING)                BOOLEAN
--  clear()                          -                   Clear relevant data arrays
--  clearGadgets()                   -                   Clear all gadgets
--  editAdde(REAL)                   -                   UNUSED?
--  findEntry(STRING)                REAL                Find an entry in the grid
--  include(STRING)                  -                   Add a new task to the list
--  init()                           -                   Method to initilize the form
--  load()                           -                   Load all tasks
--  modifyValue()                    -                   Modify the parameter value
--  netAfterSelectChange(ARRAY)      -                   Callback on grid control after select change
--  netPopup(ARRAY)                  -                   Pop-up for grid control
--  parameters()                     -                   Sets parameter gadgets
--  refreshLists()                   -                   Refreshes all gadgets
--  remove(STRING)                   -                   Delete a parameter or a task
--  replace(STRING)                  -                   Add a new task to the list
--  save()                           -                   Saves the form settings to database
--  select()                         -                   Set all gadgets for the selected area (IDLI)
--  setActive()                      -                   Set gadget active status
--  setTask(ABATASK,STRING,STRING)   -                   Sets TASK definition
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!abaTasks

  title 'ABA Task Definition'
  !this.initcall = |!this.init()|
  cancelcall |!this.cancel()|

  path down
  bar
    add 'File' .filemenu
  exit

  menu .filemenu
   add 'Load Tasks'   |!this.load()|
   add 'Save Tasks'   |!this.save()|
   add separator
   add 'Close'        |!this.cancel()|
  exit

  rgroup .act 'Task Types' frame horizontal at x 1 y0

    add tag 'View    ' select 'viewTasks' call |!this.action('VIEW')|
    add tag 'Drawing ' select 'drawTasks' call |!this.action('DRAW')|
    add tag 'Process ' select 'globTasks' call |!this.action('GLOB')|
    add tag 'Naming  ' select 'nameTasks' call |!this.action('NAME')|

  exit

  frame .control 'Tasks Definition' at x .5 width 50

    hdist 1
    path down
    text .name |Name       | call |!this.name.val = !!checkName(!this.name.val, 'NEW') !this.incTask.active = true  | at ymax width 42 is STRING
    text .desc |Description| call |!this.changed = true| width 42 is STRING
    text .oper |Function   | call |!this.changed = true| width 42 is STRING

    frame .params |Task Parameters| at x 1 ymax.oper + 0.5

      text   .parameterD |Description|  at y 1                 call |!this.changed = true|               width 18 is STRING
      text   .parameterV |      Value|                         call |!this.modifyValue()|                width 18 is STRING
      option .obType     |Object type | at xmax-size ymax+0.2  call |!this.changed = true|               width 9
      option .addeEdit                  at xmax-size ymax+0.43 call |!this.editAdde(!this.addeEdit.val)| width 10

      list   .paramList  ||  call |!this.parameters()| at xmax.parameterD + 1 ymin.parameterD width 20 height 6

    exit

  exit

  hdist 4
  button .incTask |   Add   | at x 11 ymax.control + .5 call |!this.include('TASK')|

  path right
  button .repTask | Replace |                           call |!this.replace('TASK')|
  button .remTask | Remove |                            call |!this.remove('TASK')|

  hdist 1
  path down

  frame .vTaskFrame 'Tasks' at x .5

    container .netFrame nobox pmlNetControl 'NET' width 56 height 8

  exit

     menu .pop1
      !this.pop1.add ('CALLBACK','Add',|!this.include('PARAM')|)
      !this.pop1.add ('CALLBACK','Replace',|!this.replace('PARAM')|)
      !this.pop1.add ('CALLBACK','Remove',|!this.remove('PARAM')|)
      !this.paramList.setpopup(!this.pop1)

  -- Form data
  !dText[1] = 'Add'
  !dText[2] = 'Replace'
  !dText[3] = 'Remove'
  !this.addeEdit.dtext = !dtext

  !dtext[1] = 'Real'
  !dtext[2] = 'String'
  !dtext[3] = 'Distance'
  !dtext[4] = 'Boolean'
  !rtext[1] = 'REAL'
  !rtext[2] = 'STRING'
  !rtext[3] = 'DSTNCE'
  !rtext[4] = 'BOLEAN'
  !this.obType.dtext = !dtext
  !this.obType.rtext = !rtext

  member .task         is ABATASK
  member .number       is REAL
  member .mode         is STRING

  member .viewTasks    is ABATASKLIST
  member .drawTasks    is ABATASKLIST
  member .globalTasks  is ABATASKLIST
  member .nameTasks    is ABATASKLIST
  member .taskGadget    is STRING

  member .changed      is BOOLEAN
  member .deleted      is ARRAY

  member .fromHere     is DBREF

  member .headings     is ARRAY
  member .tasks        is ARRAY
  member .rowSet       is ARRAY

  -- My .net control
  using namespace 'Aveva.Pdms.Presentation'
  member .displayCtrl  is NETGRIDCONTROL

  -- Parameters Heading
  !h[1] = 'Parameters'
  !this.paramList.setheadings(!h)

exit

------------------------------------------------------------------------
--
-- Method:      .abaTasks()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------------------------------
define method .abaTasks()

  -- Define pop-up menu
  !menu = !this.newMenu('defPopUp')
    !menu.add('callback', 'Remove', |!this.remove('TASK')|)

  -- Create instance of .net control
  using namespace 'Aveva.Pdms.Presentation'
  !this.displayCtrl = object NETGRIDCONTROL()

  -- Add PML event handlers to .net control
  !this.displayCtrl.addEventHandler('afterSelectChange', !this, 'netAfterSelectChange')
  !this.displayCtrl.addEventHandler('onPopup', !this, 'netPopup')

  -- Add .net control to PML container
  !this.netFrame.control = !this.displayCtrl.handle()

  -- Set grid visual attributes
  !this.displayCtrl.columnExcelFilter(false)
  !this.displayCtrl.outlookGroupStyle(false)
  !this.displayCtrl.fixedRows(false)
  !this.displayCtrl.gridHeight(1000.0)
  !this.displayCtrl.editableGrid(false)
  !this.displayCtrl.singleRowSelection(true)
  !this.displayCtrl.columnExcelFilter(false)
  !this.displayCtrl.fixedHeaders(false)
  !this.displayCtrl.headerSort(true)
  !this.displayCtrl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Name')
  !this.headings.append('Description')

endmethod
-- End of method definition for .abaTasks()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initilize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Store hierarchy position
  !this.fromHere = !!ce

  -- Clear any grid selection
  !this.displayCtrl.clearRowSelection()

  -- Load tasks
  !this.load()

  -- Set view tasks as default.
  !this.act.val = 1
  !this.action('VIEW')

  -- Select tasks
  !this.select()

  -- Set gadget active status
  !this.setActive()

  -- Set form unmodified
  !this.changed = false

endmethod
-- End of method .init()

------------------------------------------------------------------------
--
-- Method:      .action(STRING)
--
-- Description: Set form depending upon type of Task
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .action(!input is STRING)

  -- Initialise variables
  !rowSet = ARRAY()

  -- Extract the relevant task data
  if (!input.eq('VIEW')) then

    -- Get relevant task array
    !allTaskObj     = !this.viewTasks.taskArray
    !this.taskGadget = '!!abaTasks.viewTasks'

  elseif (!input.eq('DRAW')) then
    !allTaskObj     = !this.drawTasks.taskArray
    !this.taskGadget = '!!abaTasks.drawTasks'

  elseif (!input.eq('GLOB')) then
    !allTaskObj     = !this.globalTasks.taskArray
    !this.taskGadget = '!!abaTasks.globalTasks'

  else
    !allTaskObj     = !this.nameTasks.taskArray
    !this.taskGadget = '!!abaTasks.nameTasks'
  endif

  -- Build the row data set
  do !taskObj val !allTaskObj

    -- Initialise variables
    !rowData  = ARRAY()

    -- Build row data
    !rowData.append(!taskObj.name)
    !rowData.append(!taskObj.description)

    -- Add row data to row set array
    !rowSet.append(!rowData)

  enddo

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.displayCtrl.bindToDataSource(object NETDATASOURCE('Tasks', !this.headings, !rowSet, '^Name'))

  -- Populate the remaining gadgets by selecting the first element in the grid
  -- This will trigger the method .netAfterSelectChange()
  !this.displayCtrl.selectRow(1)

endmethod
-- End of method .action(STRING)

--------------------------------------------------------------------------------------------------------
define method .cancel()

  -- Initialise variables
  !ans = 'NONE'

  -- Ask when form has been changed
  if (!this.changed eq TRUE) then
    !ans = !!alert.question('   Defaults/Tasks have been modified        OK to save ?')
    if (!ans eq 'YES') then
      !this.save()
    endif
  endif

  -- Action
  if (!ans.neq('CANCEL')) then

    -- Clear members
    !this.changed = false
    !this.deleted = array()

    -- Hide form
    hide !!abaTasks

  endif

  !!ce = !this.fromHere
  handle any
    -- In case we have deleted the thing we were at
  endhandle

  -- Savework and release all that's been claimed out.
  SAVEWORK
  UNCLAIM ALL

endmethod
-- End of method .cancel()

------------------------------------------------------------------------
define method .checkForSpaces(!a is STRING)

  -- Test for spaces
  if (!a.split().size() ne 1) then
    !!alert.error('No Spaces allowed in Task name - re-enter')
    !this.name.setFocus()
  endif

  -- Set form as changed
  !this.changed = true

endmethod
-- End of method .checkForSpaces(STRING)

--------------------------------------------------------------------------------------------------------
define method .checkName(!name is STRING) is BOOLEAN

  -- Initialise variables
  !a[1] = !this.viewTasks
  !a[2] = !this.drawTasks
  !a[3] = !this.globalTasks
  !a[4] = !this.nameTasks

  do !b values !a

    do !c values !b.taskarray

      if !c.name eq !name then
       return true
      endif

    enddo

  enddo

  return false

endmethod
-- End of method .checkName(STRING)

------------------------------------------------------------------------
--
-- Method:      .clear()
--
-- Description: Clear relevant data arrays
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Clear the grid
  !this.displayCtrl.clearGrid()

  -- Clear all data
  !this.viewTasks.clear()
  !this.drawTasks.clear()
  !this.globalTasks.clear()
  !this.nameTasks.clear()
  !this.tasks.clear()
  !this.rowSet.clear()

  -- Reset the current task
  !this.task = object ABATASK()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      .clearGadgets()
--
-- Description: Clear all gadgets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearGadgets()

  -- Clear all gadgets
  !this.name.clear()
  !this.desc.clear()
  !this.oper.clear()
  !this.paramList.clear()
  !this.parameterD.clear()
  !this.parameterV.clear()

  -- Reset option gadgets
  !this.obType.val   = 1
  !this.addeEdit.val = 1

endmethod
-- End of method definition for .clearGadgets()

------------------------------------------------------------------------
--
-- Method:      .editAdde(REAL)
--
-- Description: UNUSED?
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .editAdde(!choice is REAL)

  -- Add parameter
  if (!choice eq 1) then
    !this.include('PARAM')

  -- Replace parameter
  elseif (!choice eq 2) then
    !this.replace('PARAM')

  -- Delete parameter
  else
    !this.remove('PARAM')

  endif

endmethod
-- End of method .editAdde(REAL)

------------------------------------------------------------------------
--
-- Method:      .findEntry(STRING)
--
-- Description: Find an entry in the grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The string to find
--
-- Return:
--   [Data Type] [Description]
--    REAL        Index of found string
--
------------------------------------------------------------------------
define method .findEntry(!what is STRING) is REAL

  -- Initialise variables
  !allRows = !this.displayCtrl.getRows()

  -- Search all grid entries
  do !index ind !allRows

    -- Initialise variables
    !row = !allRows[!index]

    -- Look for the passed string in the row array
    if (!row.findFirst(!what).set()) then
      return !index
    endif

  enddo

  return 0

endmethod
-- End of method definition for .findEntry(STRING)

------------------------------------------------------------------------
--
-- Method:      .include(STRING)
--
-- Description: Add a new task to the list
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      What type of thing to add PARAM or TASK
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .include(!what is STRING)

  -- Initiliase variables
  !newName = !this.name.val

  -- Test for an entered name
  if (!this.name.val.unset()) then
    !!alert.error('Please enter a valid name and try again.')
    return
  endif

  -- Test for unset description
  if (!this.desc.val.unset()) then
    !this.desc.val = 'No Description'
  endif

  -- Set flag for saving after changes have been made.
  !this.changed = true

  -- Add a new parameter
  if (!what.eq('PARAM')) then

    -- Check for a task to add to
    if (!this.displayctrl.getRows().unset()) then
      !!alert.error('There is no Task to add parameters to. Please create a Task and try again.')
      return
    endif

    -- Intitialise variables
    !desc = !this.parameterD.val

    -- Get parameter value depending on units
    if (!this.obType.selection().upCase().eq('DSTNCE')) then
      !value = !this.parameterV.val.real(!!distanceFmt).string()
    else
      !value = !this.parameterV.val
    endif

    -- Add new parameter to existing task
    !this.task.addParam(!this.parameterD.val, !value, !this.obType.selection())
    $!<this.taskGadget>.replaceTask(!this.task, !this.displayctrl.getSelectedRowTags()[1].real())

    -- Refresh the parameters list
    !this.select()

    -- Select the new parameter in the list
    !this.paramList.select('DTEXT', !desc)
    !this.parameters()

  -- Add a new task
  else

    -- Check the name for validity
    if !this.checkname(!this.name.val)then
      !!alert.error('The task name has already been used. Please change it and try again.')
      return
    endif

    -- Add new Task to existing task array
    $!<this.taskGadget>.append(object ABATASK (!this.name.val, !this.desc.val, !this.oper.val, object DBREF()))

    -- Refresh the grid
    !this.refreshLists()

    -- Select the entry just added
    !this.displayCtrl.selectRow(!this.findEntry(!newName))

  endif

endmethod
-- End of method definition for .include(STRING)

------------------------------------------------------------------------
--
-- Method:      .load()
--
-- Description: Load all tasks
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .load()

  -- Initialise variables
  !this.clear()

  -- Read the task library
  !this.viewTasks.getLibraryTasks('VIEW')
  !this.drawTasks.getLibraryTasks('DRAWING')
  !this.globalTasks.getLibraryTasks('PROCESS')
  !this.nameTasks.getLibraryTasks('NAMING')

endmethod
-- End of method .load()

------------------------------------------------------------------------
--
-- Method:      .modifyValue()
--
-- Description: Modify the parameter value
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyValue()

  -- Only modify for existing not new
  if (!this.paramList.dtext.size().neq(0)) then

    -- Initialise variables
    !units = object COMUNITS(TRUE)
    !parameters = !this.paramList.rtext
    !purpose = !this.task.purpose[!this.paramlist.val]

    -- Mark the form as changed
    !this.changed = true

    -- Replace the parameter value held in the relevant parameter list rtext
    if (!this.obType.selection().upCase().eq('DSTNCE')) then
      !parameters[!this.paramList.val] = !this.parameterv.val.real(!!distanceFmt).string('D6')
    else
      !parameters[!this.paramList.val] = !this.parameterv.val
    endif

    -- Reset gadget rtext
    !this.paramList.rtext = !parameters

  endif

endmethod
-- End of method .modifyValue()

------------------------------------------------------------------------
--
-- Method:      .netAfterSelectChange()
--
-- Description: Callback on grid control after select change
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelectChange(!array is ARRAY)

  -- Select the library function
  if (!this.displayCtrl.getSelectedRowTags().set()) then
    !this.select()

  -- Clear all gadgets & current task
  else
    !this.clearGadgets()
    !this.task = object ABATASK()

  endif

endmethod
-- End of method definition for .netAfterSelectChange()

------------------------------------------------------------------------
--
-- Method:      .netPopup()
--
-- Description: Pop-up for grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopup(!array is ARRAY)

  -- Show the pop-up
   !this.netFrame.popup = !this.defPopUp
   !this.netFrame.showPopup(!array[0], !array[1])

endmethod
-- End of method definition for .netPopup()

------------------------------------------------------------------------
--
-- Method:      .parameters()
--
-- Description: Sets parameter gadgets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .parameters()

  -- Set parameter description and value
  if (!this.paramList.dtext.size() eq 0) then

     !this.parameterD.val = ''
     !this.parameterV.val = ''

  else

    -- Initialise variables
    !purpose = !this.task.purpose[!this.paramList.val]

    -- Set parameter description gadget
    !this.parameterD.val = !this.task.paramDesc[!this.paramList.val]
      handle any
        return
      elsehandle none

        -- Set parameter object type
        !this.obType.select('RTEXT',!this.task.purpose[!this.paramList.val])
          handle (61,567)
            !this.obType.select('RTEXT','STRING')
          endhandle

        -- Set parameter value gadget allowing for parameter type
        if (!this.obType.selection().upCase().eq('DSTNCE')) then
          !this.parameterV.val = !this.task.paramVal[!this.paramList.val].real().string(!!distanceFmt)
        else
          !this.parameterV.val = !this.task.paramVal[!this.paramList.val]
        endif

      endhandle

  endif

endmethod
-- End of method .parameters()

------------------------------------------------------------------------
--
-- Method:      .refreshLists()
--
-- Description: Refreshes all gadgets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refreshLists()

  if (!this.act.val eq 1) then
    !this.action('VIEW')

  elseif (!this.act.val eq 2) then
    !this.action('DRAW')

  elseif (!this.act.val eq 3) then
    !this.action('GLOB')

  else
    !this.action('NAME')

  endif

endmethod
-- End of method .refreshLists()

------------------------------------------------------------------------
--
-- Method:      .remove(STRING)
--
-- Description: Delete a parameter or a task
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      PARAMeter or TASK to delete
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remove(!what is STRING)

  -- initialise variables
  !taskPosition = !this.displayctrl.getSelectedRowTags()[1].real()

  -- Set flag for saving after changes have been made.
  !this.changed = true

  -- Delete Parameter
  if (!What eq 'PARAM') then

    if (!!alert.question('Are you sure you wish to delete the current Parameter') eq 'YES') then

      -- Remove the object parameter
      !this.task.deleteParam(!this.paramList.val)

      -- Reset task object list to reflect change
      $!<this.taskGadget>.taskArray[!taskPosition].paramVal  = !this.task.paramVal
      $!<this.taskGadget>.taskArray[!taskPosition].paramDesc = !this.task.paramDesc
      $!<this.taskGadget>.taskArray[!taskPosition].purpose   = !this.task.purpose

      -- Refresh the display
      !this.select()

    endif

  -- Delete Task
  else

    if (!!alert.question('Are you sure you wish to delete the current Task') eq 'YES') then

      -- Store task to be deleted
      !this.deleted.append(!this.task.source)

      !this.task.name        = !this.name.val
      !this.task.description = !this.desc.val
      !this.task.execute     = !this.oper.val

      $!<this.taskGadget>.deleteTask(!taskPosition)

      -- Remember previous list entry
      !pos = !taskPosition - 1

      -- Refresh the form
      !this.refreshLists()

      -- Select the previous list entry
      if (!pos.neq(0)) then
        !this.displayctrl.selectRow(!pos)
      endif

    endif

  endif

endmethod
-- End of method .remove(STRING)

------------------------------------------------------------------------
--
-- Method:      .replace(STRING)
--
-- Description: Add a new task to the list
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      What type of thing to add PARAM or TASK
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .replace(!what is STRING)

  -- Remember current parameter description
  !desc = !this.parameterD.val

  -- Replace either a Parameter then the complete task.
  -- Set flag for saving after changes have been made.
  !this.changed = true

  if (!what.eq('PARAM')) then
    !this.task.putParam(!this.paramList.val, !this.parameterD.val, !this.paramList.rtext[!this.paramList.val], !this.obType.selection())
  endif

  !this.task.name        = !this.name.val
  !this.task.description = !this.desc.val
  !this.task.execute     = !this.oper.val

  $!<this.taskGadget>.replaceTask(!this.task, !this.displayctrl.getSelectedRowTags()[1].real())

  !this.refreshLists()

  -- Reselect original position in parameter list
  !this.paramList.select('DTEXT', !desc)
    handle (61,567)
    endhandle
  !this.parameters()

endmethod
-- End of method definition for .replace(STRING)

------------------------------------------------------------------------
--
-- Method:      .save()
--
-- Description: Saves the form settings to database
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .save()

  -- Initialise variables
  !ce           = !!ce
  !taskLibyRefe = !!abadefaults.task.val.dbref()

  -- Get all form tasks by group
  !allTasks[1] = !this.globalTasks.taskArray
  !allTasks[2] = !this.drawTasks.taskArray
  !allTasks[3] = !this.viewTasks.taskArray
  !allTasks[4] = !this.nameTasks.taskArray

  !purpose[1] = 'ABAG'
  !purpose[2] = 'ABAS'
  !purpose[3] = 'ABAV'
  !purpose[4] = 'ABAN'

  -- For each type of task
  do !index index !allTasks

    -- Initialise count
    !count = 0

    -- For each set of task objects
    do !task value !allTasks[!index]

      -- Initialise variables
     !count = !count + 1
     -- !taskName = !taskPartName[!index] & !count
      !taskname = !task.name
      -- Create or modify the task
      if (not !task.source.badref()) then

        -- Source task element exists so just set attributes
        !!ce = !task.source
        !this.setTask(!task,!taskName,!purpose[!index])

      else

        NEW TASK
        !newTaskRefe = !!ce

        -- Set attributes
        !this.setTask(!task,!taskName,!purpose[!index])

        -- Set object source
        if (!index.eq(1)) then
          !this.globalTasks.taskArray[!count].source = !newTaskRefe
        elseif (!index.eq(2)) then
          !this.drawTasks.taskArray[!count].source = !newTaskRefe
        elseif (!index.eq(3)) then
          !this.viewTasks.taskArray[!count].source = !newTaskRefe
        else
          !this.nameTasks.taskArray[!count].source = !newTaskRefe
        endif

        !this.task.source = !newTaskRefe

      endif

    enddo

  enddo

  -- Delete any removed tasks
  do !index index !this.deleted

    if (not !this.deleted[!index].badRef()) then
      !!ce = !this.deleted[!index]
      delete TASK
    endif

  enddo

  -- Set form as unchanged
  !this.changed = false
  !this.deleted = array()

  --  Refresh the forms that display tasks
  !!abaTemplateSht.setDrawTasks()
    handle (2,751)
    endhandle

  !!abaUserView.setViewTasks()
    handle (2,751)
    endhandle

  -- Return to hierarchy position
  !!ce = !ce
    handle any
    endhandle

endmethod
-- End of method .save()

------------------------------------------------------------------------
--
-- Method:      .select()
--
-- Description: Set all gadgets for the selected area (IDLI)
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .select()

  -- Test for any selected
  if (!this.displayCtrl.getRows().set()) then

    -- Read the selected task position in the grid
    !position = !this.displayCtrl.getSelectedRowTags()[1].real()

    -- Get the selected area task
    if (!this.act.selection().upcase().eq('VIEWTASKS')) then

      -- Get the relevant task object from the relevant task list object
      !taskObj = !this.viewTasks.taskArray[!position]

    elseif (!this.act.selection().upcase().eq('DRAWTASKS')) then
      !taskObj = !this.drawTasks.taskArray[!position]

    elseif (!this.act.selection().upcase().eq('GLOBTASKS')) then
      !taskObj = !this.globalTasks.taskArray[!position]

    else
      !taskObj = !this.nameTasks.taskArray[!position]

    endif

    -- Store this task
    !this.task = !taskObj

    -- Populate the task gadgets
    -- Name
    !this.name.val = !taskObj.name

    -- Description
    !description = !taskObj.description
    if (!description.eq('')) then
      !this.desc.val = 'unset'
    else
      !this.desc.val = !description
    endif

    -- PML Function
    !PMLFunction = !taskObj.execute
    if (!PMLFunction.eq('')) then
      !this.oper.val = 'unset'
    else
      !this.oper.val = !PMLFunction
    endif

    -- Populate the parameters list gadget
    !this.paramList.dtext = !taskObj.paramDesc
    !this.paramList.rtext = !taskObj.paramVal

    -- Display the relevant parameter
    !this.parameters()

  endif

endmethod
-- End of method .select()

------------------------------------------------------------------------
--
-- Method:      .setActive()
--
-- Description: Set gadget active status
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------
define method .setActive()

  -- Test for any selected area libraries
  if (!this.displayCtrl.getRows().set()) then
    !this.repTask.active = true
    !this.remTask.active = true
  else
    !this.repTask.active = false
    !this.remTask.active = false
  endif

endmethod
-- End of method definition for .setActive()

------------------------------------------------------------------------
--
-- Method:      .setTask(ABATASK,STRING,STRING)
--
-- Description: Sets TASK definition
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ABATASK     Task object
--    2   R      STRING      Task name
--    3   R      STRING      Task purpose
--
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------
define method .setTask(!task is ABATASK, !taskName is STRING, !purpose is STRING)

  -- Initialise variables
  !allPara  = !task.paramDesc
  !allPVal  = !task.paramVal
  !allPurp  = !task.purpose
  !taskFunc = !task.name.after('/') & ';;' & !task.description
  !taskPml  = !task.execute

  -- Set attributes
  if !!ce.name neq !taskName then
   NAME $!taskName
   handle any
   endhandle
  endif

  SpPURP $!purpose
  FUNCTION |$!taskFunc|
  PMLFUNCTION |$!taskPml|

  -- Overwrite parameters
  delete TASK MEM

  do !index index !allPara

    -- Initialise variables
    !tpVal = !allPVal[!index]
    !func = !allPara[!index]
    !tkparaPurp = !allPurp[!index]

    NEW TKPARA
      TPVALUE |$!tpVal|
      SpPURP $!tkparaPurp
      FUNCTION |$!func|

  enddo

endmethod
-- End of method .setTask(ABATASK,STRING,STRING)
