--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abatemplatedrg()                 -
--  cancelCall()                     -                   <initialises the form
--  checkName(STRING)                STRING
--  init()                           -
--  okCall()                         -
------------------------------------------------------------------------
setup form !!abatemplatedrg

  title |ABA Template Drawing|
  icontitle |ABA DRTMPL|
  !this.initcall = |!this.init()|

  path down
  text .name |Template Name| call |!this.name.val = !this.checkName(!this.name.val)| width 40 name
  text .desc |Description  | width 40 is STRING
  text .date |Date         | width 11 is STRING
  text .auth |Drawn By     | width 15 is STRING

  button .attributes at xmax+4 ymin | Attributes... | call |show !!abaDrTmplAtt|

  option .purp |Function     | at xmin.auth call || width 21

  button .apply at xmin .auth ymax+0.3   |  OK  | ok
  button .cancel at xmax form -size ymin |Cancel| cancel

  !this.okCall       = |!this.okCall()|
  !this.cancelCall   = |!this.cancelCall()|

  member .drtmpl   is DBREF
  member .sheet    is DBREF
  member .calender is STRING
  member .mode     is STRING

exit

-- End of form definition

------------------------------------------------------------------------
define method .abatemplatedrg()
------------------------------------------------------------------------

         var !unusedExist exist $!!abaDefaults.task.val
         handle (2,109)
           --  Undefined name /fred
           -- No task library exists, create from function call if available
           !numbers = !!abaNumberingCode()
           !this.purp.dtext = !numbers[1]
           !this.purp.rtext = !numbers[2]
         elsehandle NONE
           -- Look in Task Library for autoNumbering Task/Parameters.
           var !num coll all tkpara for $!!abaDefaults.autoNumber
            handle (2,109)
              -- Does not exist
              !purpd[1] = 'MultiDiscipline (Z)'
              !purpr[1] = 'Z'
            elsehandle NONE
               do !x index !num
                  !funcd[!x] = function of $!num[$!x]
                  if (!funcd[!x].match(';') eq 0) then
                      !purpd[!x] = !funcd[!x]
                  else
                      !purpd[!x] = !funcd[!x].split(';')[1]
                  endif
                  !tkPara = tkpara of $!num[$!x]
                  !purpr[!x] = !tkPara.string()
               enddo
            endhandle
           !this.purp.dtext = !purpd
           !this.purp.rtext = !purpr
         endhandle

         loadform !!abaTemplateSht

endmethod

------------------------------------------------------------------------
define method .init()
------------------------------------------------------------------------

-- ====================== C R E A T E ============================
 if (!this.mode eq 'CREATE') then

-- Navigate to the directory stated in top field of defaults form.
-- Entry one in the defaults form.
   $!!abaDefaults.dlib.val

-- Clear description field on popup.
   !this.desc.val = ''

-- Collect all drtmlb's at this level, (Should only be one) navigate to first one in list.
   var !drtmlb coll all drtmlb for ce
   $!drtmlb[1]
   handle (2,752)
     -- Array element 1 does not exist
     -- No drawing templates library exists, create one
     NEW DRTMLB
     !name = !!abaDefaults.dlib.val & '/' & !!ce.order
     name $!name
     handle (41,12)
     endhandle

   endhandle

-- Collect all drg no.s add one and use this as default drg number.
   !this.drtmpl = !!ce
   NEW DRTMPL
   handle any
     return error 1 |$!!error.text|
   endhandle
   !this.drtmpl = !!ce
   SpPURP ABAT

   do !count
--     name /$!prefix$!count
     name /TMPL$!count
     handle(41,12)
       skip
     elsehandle none
       !this.name.val = !!ce.name
       break
     endhandle
   enddo
--
-- Store current date ready for use if OKed...
-- -------------------------------------------
   !today = object DATETIME()
   !this.date.val = !today.date() & ' ' & !today.monthstring().substring(1,3) & ' ' & !today.year()
--
-- Get user name at this time.
-- ---------------------------
   !sess = session ce
   do !x values !sess
      if (!x.iscurrent) then
          !this.auth.val = !x.name
          break
      endif
   enddo

-- ====================== M O D I F Y ============================
 else
   !this.name.val = !this.drtmpl.name
   !this.date.val = !this.drtmpl.date
   !this.desc.val = !this.drtmpl.title
   !this.auth.val = !this.drtmpl.author

 endif

 !this.abatemplatedrg()

-- Select existing func if possible
   !purpSetting = !this.drtmpl.function.dbref().name
   handle any  $* its text not a refno
     !purpSetting = !this.drtmpl.function
     !this.purp.select('DTEXT',!purpSetting)
     handle any
       !this.purp.val = 1
     endhandle
   elsehandle none
     !this.purp.select('RTEXT',!purpSetting)
       handle any
        !this.purp.val = 1
       endhandle
    endhandle

 -- Navigate to the chosen drawing template
 !!ce = !this.drtmpl

endmethod


------------------------------------------------------------------------
define method .okCall()
------------------------------------------------------------------------
--
  -- Initialise variables
    !!abaProcess.template = TRUE
    !drtmpl = !this.drtmpl
    !!abaTemplateSht.drtmpl = !drtmpl

  -- Set drawing template data
    $!this.name.val
    title |$!this.desc.val|
    Date  |$!this.date.val|
    Auth  |$!this.auth.val|
    !select = !this.purp.selection('DTEXT')
    Function |$!select|

  -- Call sheet template form
    if (!this.mode eq 'CREATE') then
      !!abaTemplateSht.mode = 'CREATE'
      !!abaTemplateSht.fromDrawing = TRUE
      show !!abaTemplateSht at XR 0.3 YR 0.3
    else
      !!abaTemplateSht.mode = 'MODIFY'
      !!abaTemplateSht.fromDrawing = TRUE

    -- Test for number of sheets
      var !sheets coll all shtmpl for $!drtmpl
      if (!sheets.size().eq(0)) then
        !!abaTemplateSht.mode = 'CREATE'
        show !!abaTemplateSht at XR 0.5 YR 0.3
        !!abaTemplateSht.mode = 'MODIFY'
      elseif (!sheets.size().gt(1)) then
        show !!abaShTmplList centred xr 0.5 yr 0.3
      else
        SHTMPL 1
        show !!abaTemplateSht at XR 0.5 YR 0.3
      endif
    endif
--
endmethod
-- End of method definition for .okCall()
------------------------------------------------------------------------
--
-- Method:      .cancelCall()
--
-- Description: <initialises the form
--
-- Method Type: <Procedure/Function>
--

------------------------------------------------------------------------
define method .cancelCall()
------------------------------------------------------------------------
--

 if (!this.mode eq 'CREATE') then
   $!this.drtmpl
   delete DRTMPL
   !!abaTemplateSht.fromDrawing = FALSE
   !!abaProcess.template = FALSE
   !!abaProcess.visible(TRUE)
 endif
--
endmethod
-- End of method definition for .cancelCall()

------------------------------------------------------------------------
define method .checkName(!name is STRING) is STRING
------------------------------------------------------------------------
--
      if (!name.substring(1,1) ne '/') then
      !string = '/' & !name
      else
      !string = !name
      endif
--
--      $!string
      !unusedGetRef = !string.dbref()
      handle (2,109)
        -- Undefined Name.
        name $!string
        !this.name.val = !!ce.name
      elsehandle none
        !!alert.error('Drawing Name Already Exists - Try Another Name')
        !this.name.setFocus()
      endhandle

      return !string
--
endmethod
