--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaUserView()                    -                   Constructor method
--  addTask()                        -                   Remove a task from the available list and add it to the selected list
--  apply(STRING)                    -
--  cancel()                         -
--  ce()                             -                   Set form for the current view
--  choiceAfterSelectChange(ARRAY)   -                   Callback on grid control after select change of the choice grid
--  choicePopUp(ARRAY)               -                   Pop-up for the choice grid control
--  clear(STRING)                    -                   Clear relevant data arrays
--  copy()                           -
--  copyLiby(DBREF)                  ARRAY
--  createView()                     BOOLEAN
--  cursorCall(STRING)               -
--  deleteView()                     -
--  findEntry(STRING)                REAL                Find an entry in the choice grid
--  getTasks()                       -
--  init()                           -                   Initialise this form
--  isModified()                     -
--  modifyTask()                     -                   Modify the selected task from the choice grid
--  modifyTask(STRING,STRING)        -
--  move(STRING)                     -                   Move the selected entry in choice grid list order
--  optionsAfterSelectChange(ARRAY)  -                   Callback on grid control after select change of the options grid
--  parseTasks()                     -                   Parse the tasks for the relevant grids
--  receiveTask(ABATASK)             -                   Receive the modified task object from the modifying form
--  removeTask()                     -                   Remove a task from the selected list and add it to the available list
--  runInit()                        -
--  scaleSelection(STRING)           -
--  setApplyFalse()                  -
--  setApplyTrue()                   -
--  setDir()                         -
--  setScale(REAL)                   -
--  setTask()                        -
--  setTask(STRING,REAL)             -                   Parse the tasks for the relevant grids
--  setView(STRING)                  -
--  setViewFromList()                -
--  setViewTasks()                   -
--  showExtendArea()                 -
--  showTagging()                    -
--  viewType(STRING)                 -
--  visibility(STRING)               -
--  what()                           -
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!abaUserView

  title |ABA Template View|
  init |!this.init()|
  iconti |ABA VIEW|
  cancelcall |!this.cancel()|

  bar
    add |Frame|    _FRAME
  exit

  menu .create
     add |Create New View| |!!abaTemplate('VIEW','CREATE')|
  exit

  menu .delete
     add |Delete Current View| |!this.deleteView()|
  exit

  menu _VIEW
    add |On/Off|   |!this.visibility('VIEW')|
    add |Centre|   menu _CENTRE
-- PDMS11.3 change, Neale Morris, 28/03/2001
    add |Offset...| |$$_USERDATA
show _CDRDESOFF|
  exit

  menu _CENTRE
    add |Identify|        |$$_USERDATA
CALLDRG MVTHPOS ID NORESET|
    add |Cursor|        |$$_USERDATA
CALLDRG MVTHPOS CURS NORESET|
    add |By Cursor|        |$$_USERDATA
CALLDRG MVTHPOS CURSBY NORESET|
-- PDMS11.3 change, Neale Morris, 28/03/2001
    add |Explicit...|   |$$_USERDATA
SHOW _CDRVTHPOS|
  exit

  menu _FRAME
    add |On/Off|         |!this.visibility('FRAME')|
    add |Size|           menu _SIZE
    add |Copy Size|      menu _CSIZE
    add |Position|       menu _POSN
    add |Align|          menu _ALIGN
  exit

  menu _SIZE
    add |Cursor|         |!this.cursorCall('FRAME_SIZE_CURS')|
-- PDMS11.3 change, Neale Morris, 28/03/2001
    add |Explicit...|    |$$!this.viewName
                          $$_USERDATA
                          show _CDRFRAMESIZE|
  exit

  menu _CSIZE
-- PDMS11.3 change, Neale Morris, 28/03/2001
    add |Width|          |CALLIBM UVIEWFRAME _CDRMUVIEW COPY_SIZE WIDTH|
    add |Height|         |CALLIBM UVIEWFRAME _CDRMUVIEW COPY_SIZE HEIGHT|
    add |Width & Height| |CALLIBM UVIEWFRAME _CDRMUVIEW COPY_SIZE WIDHEI|
  exit

  menu _POSN
    add |Cursor|         menu _POSNCURS
-- PDMS11.3 change, Neale Morris, 28/03/2001
    add |Explicit...|    |$$_USERDATA
                          show _CDRFRAMECTR|
  exit

  menu _POSNCURS
    add |By |            |!this.cursorCall('FRAME_POS BY')|
    add |Centre |        |!this.cursorCall('FRAME_POS C')|
    add |Top Left|       |!this.cursorCall('FRAME_POS TL')|
    add |Top Right|      |!this.cursorCall('FRAME_POS TR')|
    add |Bottom Left|    |!this.cursorCall('FRAME_POS BL')|
    add |Bottom Right|   |!this.cursorCall('FRAME_POS BR')|
  exit

  menu _ALIGN
-- PDMS11.3 change, Neale Morris, 28/03/2001
    add |Centre Vert|    |$$!this.viewName
                          CALLIBM UVIEWFRAME _CDRMUVIEW FRAME_ALIGN C V|
    add |Centre Horiz|   |$$!this.viewName
                          CALLIBM UVIEWFRAME _CDRMUVIEW FRAME_ALIGN C H|
    add |Top|            |$$!this.viewName
                          CALLIBM UVIEWFRAME _CDRMUVIEW FRAME_ALIGN T|
    add |Bottom|         |$$!this.viewName
                          CALLIBM UVIEWFRAME _CDRMUVIEW FRAME_ALIGN B|
    add |Left|           |$$!this.viewName
                          CALLIBM UVIEWFRAME _CDRMUVIEW FRAME_ALIGN L|
    add |Right|          |$$!this.viewName
                          CALLIBM UVIEWFRAME _CDRMUVIEW FRAME_ALIGN R|
  exit

-- ====================== Start of Form Definition ======================

  button .ce |CE| call |!this.ce()|

  option .vList ' ' at xmax ymin call |!this.setViewFromList()| width 20

  text _title AT x0 ymax+0.5 |Title       | call |!this.setApplyTrue()| width 30 string

  option _type   |Type        | call |!this.setApplyTrue()| at x0 ymax+0.2 width 21
  var list _type pairs |Universal Hidden Line| |UNIVERSAL HLINE|
                       |Global Hidden Line|    |GLOBAL HLINE|
                       |Local Hidden Line|     |LOCAL HLINE|
                       |Modelled Wireline|     |MWIRELINE|
                       |Wireline Hidden Line|    |WIREHLINE|
                       |Wireline|                |WIRELINE|
  exit

  option _smode  |Section Mode| at xmin ymax call |!this.setApplyTrue()| width 31
  var list _smode pairs |Standard| |Standard| |Omit Fractional Pipe Components| |Omit Fractional Pcomponents|
  exit

  option .rrsf   |Style       | at x0 ymax+0.2 call |!this.setApplyTrue()| width 40

  path down

  text .direction at x 0 |Direction   | call |!this.what()| Width 14 string

  path right
  option .dirOption call |!this.setDir()| width 7

  path down

  frame .scaleing 'Scale Selection' at x 0
    path right
    option .scaleChoice call |!this.setScale(!this.scaleChoice.val)| at y1 width 15
    option .scaleType at xmax.scaleChoice+1 y 1 call |!this.scaleSelection(!this.scaleType.selection())| width 15
    option .scaleValue call |!this.what()| Width 15
    button .what at xmax.scaleValue+1 ymin.scaleValue-0.05 pixmap height 21 width 15 call |!!abaWhat(!this.viewName)|
  exit

  path down

  frame .frameatts 'View Settings' at x 0

    path down
    hdist 5

    -- PDMS11.3 change, Neale Morris, 28/03/2001
    button _attrib   |Attributes...| at x 1 y 1 call |!this.setApplyTrue()
$$!this.viewName
show _CDRVIEWATT|

    path right

    button .drawList |Draw List...|  call |!this.setApplyTrue()
show !!abaDrawList cen xr 0.5 yr 0.5|

    button .tagging  |Tagging...|    call |!this.setApplyTrue()
!this.showTagging()|

    --  button .override |Extend Area...| call |!this.setApplyTrue() !this.showExtendArea()|

    hdist 1
    para .viewFunction at x 1 ymax.tagging + .75 text 'View Function'

    path right

    rgroup .viewType frame horizontal at ymin.viewFunction - .15
      add tag 'Area'    select 'AREA'    call |!this.viewType('Area')|
      add tag 'Keyplan' select 'KEYPLAN' call |!this.viewType('Keyplan')|
      add tag 'User'    select 'USER'    call |!this.viewType('User')|
    exit

    button .keyArea 'Keyplan Area...' at xmax.viewType+1.4 ymin.viewType + .20 call |show !!abaSelectArea|

  exit

  hdist 1

-- Define Task selection/Modification Areas.
-- -----------------------------------------

  path down

  frame .taskMod '' at x 0

    para .tasks text 'Tasks Available'

    container .optionsGrid nobox pmlNetControl 'NET' at x0.6 ymax-0.4 width 29 height 7

    button .add '' at xmax.optionsGrid+0.1 y3 pixmap call '!this.addTask()'

    path down
    button .rem '' pixmap call '!this.removeTask()'

    para .chosen at xmax.add+10 ymin.tasks text 'Selected'

    container .choiceGrid nobox pmlNetControl 'NET' at xmax.add-1.8 ymin.optionsGrid width 29 height 7

    button .modify 'Modify Task' at xmin call |!this.modifyTask()|

  exit

  path right
  hdist 20

  button .apply  | Apply | AT X0 ymax+0.5 call |!this.apply('APPLY')| apply
  -- para .app at xmax.apply text |<- View Details Not Applied|
  button .cancel |Dismiss| at xmax form-size call |!this.cancel()| cancel

  button .copy    |Copy|   at xmax form-size  ymin.ce call |!this.copy()|
  button .remove  |Remove| at xmin.copy-9  ymin.ce call |!this.deleteView()|
  button .addvw   |Create New| at xmin.remove-13 ymin.ce call |!!abaTemplate('VIEW','CREATE')|

  -- Pixmaps
  !this.rem.addPixmap(!!PML.getPathName('leftarrow16.png'))
  !this.add.addPixmap(!!PML.getPathName('rightarrow16.png'))
  !this.what.addPixmap(!!PML.getPathName('question.png'))

  -- Members
  member .allTaskList     is ABATASKLIST
  member .optionsTaskList is ABATASKLIST
  member .choiceTaskList  is ABATASKLIST

  member .deleteView is BOOLEAN
  member .mode       is STRING
  member .viewName   is DBREF

  member .taskList   is ABATASKLIST
  member .task       is ABATASK
  member .number     is REAL

  member .modified   is BOOLEAN
  member .origStyle  is STRING
  member .editStyle  is STRING
  member .origColour is STRING
  member .editColour is STRING
  member .dllb       is DBREF
  member .pllb       is DBREF
  member .trlb       is DBREF
  member .lfra       is BOOLEAN
  member .saved      is BOOLEAN

  -- Declare the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  member .optionsControl is NETGRIDCONTROL
  member .choiceControl  is NETGRIDCONTROL

  member .headings is ARRAY

  !this.saved          = true
  !this.keyArea.active = false
  !this.deleteView     = false
  !this.modified       = false
  !this.origStyle      = 'Solid'
  !this.editStyle      = 'LDashedThick'
  !this.origColour     = 'Grey'
  !this.editColour     = 'Orange'

-- End of form definition
exit

------------------------------------------------------------------------
--
-- Method:      .abaUserView()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .abaUserView()

  -- Define pop-up menu
  !menu = !this.newMenu('choicePopUp')
    !menu.add('callback', 'Move Up', |!this.move('UP')|,'UP')
    !menu.add('callback', 'Move Down', |!this.move('DOWN')|, 'DOWN')

  -- Read the current coordinate system
  VAR !coordinate COORDINATE

  -- Setup scale menu defaults.
  !scType[1]              = 'Metric'
  !scType[2]              = 'Architectural'
  !scType[3]              = 'Engineering'
  !scReturn[1]            = 'MET'
  !scReturn[2]            = 'ARC'
  !scReturn[3]            = 'ENG'
  !this.scaleType.dText   = !scType
  !this.scaleType.rText   = !scReturn
  !scaCho[1]              = 'Maximum'
  !scaCho[2]              = 'Nearest'
  -- --------------------------
  -- !scaCho[3] = 'Fit Labels'
  -- !scaCho[4] = 'Specific'
  -- Future -------------------
  !scaCho[3]              = 'Specific'
  !this.scaleChoice.dText = !scaCho

  !this.scaleSelection('MET')

  -- Direction
  -- For ENU
  if (!coordinate.eq('ENU')) then

    !dirOpt[1]  = 'North'
    !dirOpt[2]  = 'South'
    !dirOpt[3]  = 'East'
    !dirOpt[4]  = 'West'
    !dirOpt[5]  = 'Up'
    !dirOpt[6]  = 'Down'
    !dirOpt[7]  = 'Iso 1'
    !dirOpt[8]  = 'Iso 2'
    !dirOpt[9]  = 'Iso 3'
    !dirOpt[10] = 'Iso 4'
    !dirOpt[11] = 'Derived'
    !this.dirOption.dText = !dirOpt
    !this.direction.val = 'D'
    !this.dirOption.val = !dirOpt[5]
    !dirOpt[1]  = 'N'
    !dirOpt[2]  = 'S'
    !dirOpt[3]  = 'E'
    !dirOpt[4]  = 'W'
    !dirOpt[5]  = 'U'
    !dirOpt[6]  = 'D'
    !dirOpt[7]  = 'W 45 S 35.26 D'
    !dirOpt[8]  = 'W 45 N 35.26 D'
    !dirOpt[9]  = 'E 45 N 35.26 D'
    !dirOpt[10] = 'E 45 S 35.26 D'
    !dirOpt[11] = ''
    !this.dirOption.rText = !dirOpt

  -- For XYZ
  else

    !dirOpt[1]  = 'Y'
    !dirOpt[2]  = '-Y'
    !dirOpt[3]  = 'X'
    !dirOpt[4]  = '-X'
    !dirOpt[5]  = 'Z'
    !dirOpt[6]  = '-Z'
    !dirOpt[7]  = 'Iso 1'
    !dirOpt[8]  = 'Iso 2'
    !dirOpt[9]  = 'Iso 3'
    !dirOpt[10] = 'Iso 4'
    !dirOpt[11] = 'Derived'
    !this.dirOption.dText = !dirOpt
    !this.direction.val = 'D'
    !this.dirOption.val = !dirOpt[5]
    !dirOpt[7]  = '-X 45 -Y 35.26 -Z'
    !dirOpt[8]  = '-X 45 Y 35.26 -Z'
    !dirOpt[9]  = 'X 45 Y 35.26 -Z'
    !dirOpt[10] = 'X 45 -Y 35.26 -Z'
    !dirOpt[11] = ''
    !this.dirOption.rText = !dirOpt

  endif

  -- Set Styles
  VAR !styles COLLECT ALL RRST
  VAR !styleNames EVAL NAME FOR ALL FROM !styles
  !temp[1] = 'Nulref'
  !temp.appendArray(!styleNames)
  !this.rrsf.dText = !temp

  -- Load forms modifyTask,abaViewList ready for use.
  loadform !!abaModifyTask
  loadform !!abaViewList

  -- Create instances of the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  !this.optionsControl = object NETGRIDCONTROL()
  !this.choiceControl  = object NETGRIDCONTROL()

  -- Add .net control to the containers
  !this.optionsGrid.control = !this.optionsControl.handle()
  !this.choiceGrid.control  = !this.choiceControl.handle()

  -- Add PML event handlers to .net controls
  !this.optionsControl.addEventHandler('afterSelectChange', !this, 'optionsAfterSelectChange')
  !this.choiceControl.addEventHandler('afterSelectChange', !this, 'choiceAfterSelectChange')
  !this.choiceControl.addEventHandler('onPopup', !this, 'choicePopup')

  -- Set grid visual attributes
  !this.optionsControl.columnExcelFilter(false)
  !this.optionsControl.outlookGroupStyle(false)
  !this.optionsControl.fixedRows(false)
  !this.optionsControl.gridHeight(1000.0)
  !this.optionsControl.editableGrid(false)
  !this.optionsControl.singleRowSelection(true)
  !this.optionsControl.columnExcelFilter(false)
  !this.optionsControl.fixedHeaders(false)
  !this.optionsControl.headerSort(true)
  !this.optionsControl.columnSummaries(false)
  !this.choiceControl.columnExcelFilter(false)
  !this.choiceControl.outlookGroupStyle(false)
  !this.choiceControl.fixedRows(false)
  !this.choiceControl.gridHeight(1000.0)
  !this.choiceControl.editableGrid(false)
  !this.choiceControl.singleRowSelection(true)
  !this.choiceControl.columnExcelFilter(false)
  !this.choiceControl.fixedHeaders(false)
  !this.choiceControl.headerSort(true)
  !this.choiceControl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Name')
  !this.headings.append('Description')

endmethod
-- End of method definition for .abaUserView()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise this form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Clear task data
  !this.allTaskList.clear()

  -- Get all available tasks
  !this.allTaskList.getLibraryTasks('VIEW')

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .addTask()
--
-- Description: Remove a task from the available list and add it to the selected list
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addTask()

  -- Check for any selected entry
  if (!this.optionsControl.getSelectedRows().set()) then

    -- Selected row
    !rowNumber = !this.optionsControl.getSelectedRowTags()[1].real()
    !taskName  = !this.optionsControl.getSelectedRows()[1][1]

    -- Move the selected options task from the options list array to the choice list array
    !this.choiceTaskList.taskArray.append(!this.optionsTaskList.taskArray[!rowNumber])
    !this.optionsTaskList.taskArray.remove(!rowNumber)

    -- Add the relevant tasks row data to each grid
    !this.parseTasks()

    -- Select the added task in the choice grid
    !this.choiceControl.selectRow(!this.findEntry(!taskName))

    -- Activate the apply button
    !this.setApplyTrue()

  endif

endmethod
-- End of method .addTask()

-----------------------------------------------------------------------------
define method .apply(!type is STRING)

-- Apply button code..... sets all appropriate view settings for template view.

  !this.setApplyFalse()

  -- Test that the drawlist is not empty
  if (!this.viewName.idln.members.empty()) then
    !!alert.warning('The view drawlist does not contain anything to draw')
    return
  endif

  -- Warning for existing drawings
  if (!this.deleteView) then
    !!alert.warning('Any drawing that has been previously generated with this template, must be regenerated to see this new view')
  endif

  !this.saved      = TRUE
  !this.modified   = FALSE
  !this.deleteView = FALSE
  !!ce             = !this.viewName

  -- Set name of view..
  !name = !this.vList.dText[!this.vList.val]

  if (!!ce.name ne !name) then
    NAME $!name
  endif

  -- Set type of view.
  -- Get the current views VTYPE
  !a = !this.type.selection()
  vtype $!a

  title |$!this.title.val|

  -- Set the Section Mode.
  !a = !this.smode.selection()
  smode $!a

  -- Set the Style Setting.
  !a = !this.rrsf.selection()
  rrsf $!a

  -- Set the Direction.
  !viewDir = !!coords.enuDir(!this.direction.val)
  DIRECTION $!viewDir
    handle any
      !!alert.error('There is a problem with the View Direction')
    endhandle

  -- Set View Type
  if (!this.viewType.val eq 1) then
    SPPURP ABAT
  elseif (!this.viewType.val eq 2) then
    SPPURP ABAK
  elseif (!this.viewType.val eq 3) then
    SPPURP USER
  endif

  -- Set scale (whether it is used later or not)
  !vsca = !this.scaleValue.selection('RTEXT')
  VSCA $!vsca

  -- Set function of view to hold the choice & type setting
  !func = !this.scaleChoice.selection('RTEXT')
  !purp = !this.scaleType.selection('RTEXT')
  FUNCTION '$!func $!purp'

  -- Set the tasks applied to this view.
  !this.getTasks()

  -- Hide form
  if (!type eq 'OK') then
    !!abaUserView.hide()
    NLStyle $!<this.origStyle>
    NLColour $!<this.origColour>
    LFRA $!this.lfra
  endif

  -- Set copy button active now that the view is set
  !this.copy.active = true

endmethod
-- End of method definition for .apply()

-------------------------------------------------------------------------------
define method .cancel()

  -- Check that there is a view
  if (!this.viewName.badref()) then
    return
  endif

  -- Reset view frame
  !!ce = !this.viewName
   NLStyle $!<this.origStyle>
   NLColour $!<this.origColour>
   LFRA $!this.lfra

  -- Test if view should be deleted
  if (!this.deleteView and !this.mode.eq('CREATE')) then

    DELETE VIEW

    !this.deleteView = FALSE

    !ce = !!ce

    -- Delete library elements
    !!ce = !this.dllb
    delete DLLB

    !!ce = !this.pllb
    delete PLLB

    !!ce = !this.trlb
    delete TRLB

    !!ce = !ce

  endif

  !!abaProcess.visible()

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      .ce()
--
-- Description: Set form for the current view
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ce()

  -- Get view data
  !this.setView('MODIFY')

  -- Populate the gadgets
  !this.runInit()

endmethod
-- End of method definition for .ce()

------------------------------------------------------------------------
--
-- Method:      .choiceAfterSelectChange(ARRAY)
--
-- Description: Callback on grid control after select change of the choice grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .choiceAfterSelectChange(!array is ARRAY)

  -- Select the task
  if (!this.choiceControl.getSelectedRowTags().set()) then

    -- Clear any options selection
    !this.optionsControl.clearRowSelection()

    -- Set task
    !this.setTask('CHOICE', !array[0][1].real())

  -- Clear current task
  else
    !this.task = object ABATASK()

  endif

endmethod
-- End of method definition for .choiceAfterSelectChange(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .choicePopUp()
--
-- Description: Pop-up for the choice grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .choicePopUp(!array is ARRAY)

  -- Get selected row number
  !selectedNumber = !this.choiceControl.getSelectedRowTags()[1].real()

  -- Test for only one entry
  if (!selectedNumber.eq(1) and !this.choiceControl.getRows().size().eq(1)) then

    -- Prevent any moves
    !this.choicePopUp.setFieldProperty('UP','ACTIVE',false)
    !this.choicePopUp.setFieldProperty('DOWN','ACTIVE',false)

  -- Test for first entry
  elseif (!selectedNumber.eq(1)) then

    -- Prevent any move up
    !this.choicePopUp.setFieldProperty('UP','ACTIVE',false)
    !this.choicePopUp.setFieldProperty('DOWN','ACTIVE',true)

  -- Test for last entry
  elseif (!selectedNumber.eq(!this.choiceTaskList.taskArray.size())) then

    -- Prevent any move down
    !this.choicePopUp.setFieldProperty('UP','ACTIVE',true)
    !this.choicePopUp.setFieldProperty('DOWN','ACTIVE',false)

  else

    -- Allow all moves
    !this.choicePopUp.setFieldProperty('UP','ACTIVE',true)
    !this.choicePopUp.setFieldProperty('DOWN','ACTIVE',true)

  endif

  -- Show the pop-up
   !this.choiceGrid.popup = !this.choicePopUp
   !this.choiceGrid.showPopup(!array[0], !array[1])

endmethod
-- End of method definition for .choicePopUp()

------------------------------------------------------------------------
--
-- Method:      .clear(STRING)
--
-- Description: Clear relevant data arrays
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      What to clear ALL or GRIDS
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear(!what is STRING)

  -- Clear ALL
  if (!what.eq('ALL')) then

    -- Clear task data
    !this.optionsTaskList.clear()
    !this.choiceTaskList.clear()

  endif

  -- Clear the grids
  !this.optionsControl.clearGrid()
  !this.choiceControl.clearGrid()

  -- Reset the current task
  !this.task = object ABATASK()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
define method .copy()

  -- Initialise variables
  !sheetName = !this.viewName.owne.flnm
  !oldRefe = !this.viewName
  !oldName = !oldRefe.flnm
  !oldSpPurp = !oldRefe.spPURP

  -- Reset old view nlpn
  !!ce = !this.viewName
  NLStyle $!<this.origStyle>
  NLColour $!<this.origColour>

  -- Determine next name
  do !count

    -- For safety
    break if (!count.eq(100))

    -- Build view name
    !newName = !sheetName & '/V' & !count

    -- Test for view
    var !exist exist $!newName
    if (!exist.eq('FALSEA')) then
      !lastName = !sheetName & '/V' & (!count - 1)
      break
    endif

  enddo

  -- Access last view in list
  !!ce = !lastName.dbRef()

  -- Make a copy of the current displayed view
  NEW VIEW $!newName COPY $!oldName RENAME $!oldName $!newName
   SpPURP $!oldSpPurp
  !viewRefe = !!ce

  -- Run round all view members and set the sppurp attribute
  --  !this.scan(!viewRefe, !oldRefe)

  -- Make copy of library elements & set references
  !references = !this.copyLiby(!viewRefe)

  -- Initialise form
  !this.setView('MODIFY')

  -- Store data in form members
  !this.viewName = !viewRefe
  !this.dllb = !references[1]
  !this.pllb = !references[2]
  !this.trlb = !references[3]

  -- Set form mode as create so cancel will delete if not saved
  !this.mode = 'CREATE'
  !this.deleteView = true

  -- Set copy button inactive since the copy view has not been saved
  !this.copy.active = false

endmethod
-- End of method definition for .copy()

------------------------------------------------------------------------
define method .copyLiby(!viewRefe is DBREF) is ARRAY

  -- Initialise variables
  !drTmplRefe = !viewRefe.owne.owne
  !viewName = !viewRefe.flnm
  !dllbName = !viewName & '/IDLIST'
  !idliName = !viewName & '/IDLIST/IDLI'
  !pllbName = !viewName & '/PLANES'
  !trlbName = !viewName & '/TAGLIB'
  !trstName = !viewName & '/TAGLIB/TAGS'
  !oldDllb = !viewRefe.idln.owne.flnm
  var !libys coll all liby for $!drTmplRefe
  !references = ARRAY()

  -- Find layer tag rule reference
  var !layers coll all laye wi SpPURP eq 'TAGA' for $!viewRefe
  if (undefined(!layers[1])) then
    !!alert.error('Cannot complete the copy of the sheet template since VIEW $!viewName does not contain any layers')
    !references.append('FAIL')
    return !references
  endif
  var !trsf eval trsf for $!layers[1]
  !oldTrlb = !trsf[1].dbRef().owne.flnm

  -- Access library & copy the drawlist and tag rules
  !!ce = !libys[1].dbRef()

  -- Idlist
  var !exist exist $!dllbName
  if (!exist.eq('FALSEA')) then

    NEW DLLB $!dllbName COPY $!oldDllb RENAME $!oldDllb $!dllbName
    SpPURP ABAT
    -- !newDllb = !!ce

    -- Set member sppurp
    -- !this.scan(!newDllb, !oldDllb.dbRef())

    -- Return to dllb
    -- !!ce = !newDllb

  else
    !!ce = !dllbName.dbRef()
  endif
  !references.append(!!ce)

  FIRST IDLI
    handle (2,113)

      !idliName = !dllbName & '/IDLI'
      !oldIdli = IDLI 1 OF $!oldDllb
      NEW IDLI $!idliName COPY $!oldIdli
      SpPURP ABAT
      -- !newIdli = !!ce

      -- Set sppurp on all idli
      -- !this.scan(!newIdli, !oldIdli)

      -- Return to idli
      -- !!ce = !newIdli

    endhandle
  !idliRefe = !!ce

  -- Planes
  var !exist exist $!pllbName
  if (!exist.eq('FALSEA')) then
    NEW PLLB $!pllbName
    SpPurp ABAT
  else
    !!ce = !pllbName.dbRef()
  endif
  !references.append(!!ce)

  -- Tag rules
  var !exist exist $!trlbName
  if (!exist.eq('FALSEA')) then

    NEW TRLB $!trlbName COPY $!oldTrlb RENAME $!oldTrlb $!trlbName
    SpPURP ABAT
    -- !newTrlb = !!ce

    -- Set member sppurp
    -- !this.scan(!newTrlb, !oldTrlb.dbRef())

    -- Return to trlb
    -- !!ce = !newTrlb

  else
    !!ce = !trlbName.dbRef()
  endif
  !references.append(!!ce)

  FIRST TRST
    handle (2,113)

      !trstName = !trlbName & '/TAGS'
      !oldTrst = TRST 1 OF $!oldTrlb
      NEW TRST $!trstName COPY $!oldTrst
      SpPURP ABAT
      -- !newTrst = !!ce

      -- Set sppurp on all tagrules
      -- !this.scan(!newTrst, !oldTrst)

      -- Return to trst
      -- !!ce = !newTrst

    endhandle
  !trstRefe = !!ce

  -- Access view & set idln
  !!ce = !viewRefe
  IDLN $!idliRefe

  -- Access tag laye & set trsf
  !!ce = !layers[1].dbRef()
  TRSF $!trstRefe

  -- Return to view
  !!ce = !viewRefe

  -- Pass references of created liby elements
  return !references

endmethod
-- End of method definition for .copyLiby(DBREF)

-----------------------------------------------------------------------------
define method .createView() is BOOLEAN

  -- Set copy button inactive until apply is used and view is set
  !this.copy.active = false

  -- For a create mode
  if (!this.mode.eq('CREATE')) then

    NEW VIEW
      handle (41,8)
        !!alert.error('Cannot create a VIEW at this level.')
        return false
      endhandle

    -- Give the view it's name
    var !name name of owner
    do !x
      NAME $!name/V$!x
        handle (41,12)
        elsehandle none
          break
        endhandle
    enddo

    -- Set attributes
    !title = title of owner
    title |$!title|
    !size = !!ce.size
    !sizeX = !size[1] / 2
    !sizeY = !size[2] / 2
    size $!sizeX $!sizeY

  endif

-- View Type
     SpPURP ABAT
     Lframe True

-- Create Layer Sub-Structure for ABA

          !name = name
          NEW LAYER NAME $!name/Tasks       SpPURP ABAT
          lvis false

          NEW LAYER NAME $!name/USER_Dims   SpPURP DIMA  PURP DIMA
          NEW LAYER NAME $!name/USER_Labs   SpPURP LABA  PURP LABA
          NEW LAYER NAME $!name/USER_Notes  SpPURP NOTA  PURP LABB
          NEW LAYER NAME $!name/USER_Tags   SpPURP TAGA  PURP TAGA

-- Return to View above current layer.
          View
          !vName = name

-- Create PLANES PLLB for Current View in Owning LIBY
          !dName = name of owner of owner
          !type = type of owner of owner
          if (!type eq 'DRTMPL') then
              !!ce = $!dName/LIBY
              NEW DLLB name $!vName/IDLIST
                handle (41,12)
                  delete DLLB
                elsehandle none
                  SpPurp ABAT
                  !this.dllb = !!ce
                  NEW IDLI name $!vName/IDLIST/IDLI
                   SpPurp ABAT
                endhandle

              NEW PLLB name $!vName/PLANES
                handle (41,12)
                  delete PLLB
                elsehandle none
                  SpPurp ABAT
                  !this.pllb = !!ce
                endhandle

              NEW TRLB name $!vName/TAGLIB
                handle (41,12)
                  delete TRLB
                elsehandle none
                  SpPurp ABAT
                  !this.trlb = !!ce
                  NEW TRST name $!vName/TAGLIB/TAGS
                   SpPurp ABAT
                endhandle
          else
              !!alert.error('Position in Structure Has Been Lost')
          endif

-- Return to Current View in Structure.
          $!vName/USER_Tags
          TRSF $!vName/TAGLIB/TAGS
          $!vName
          IDLN $!vName/IDLIST/IDLI
   return true

endmethod
-- End of method definition for .createView()

-------------------------------------------------------------------------------
define method .cursorCall(!option is STRING)

  -- Hide view form so user can see the drawing
  hide !!abaUserView

  -- Access the view
  !!ce = !this.viewName

  -- Make the command call
-- PDMS11.3 change, Neale Morris, 28/03/2001
  $M "%PDMSUI%/DRA/CLIB/UVIEWFRAME" _CDRMUVIEW $!option

  -- Show the view form
  show !!abaUserView

endmethod
-- End of method definition for .cursorCall(STRING)

-------------------------------------------------------------------------------
define method .deleteView()

-- Delete current view showing, then re-run init to show available views.
   !save = !!ce
   !type = !!ce.type
   !name = !!ce.flnm

   -- Prompt to confirm delete
   !answer = !!alert.confirm('Are you sure you want to delete $!type $!name')
   if (!answer.eq('NO')) then
     return
   endif

   goto IDLN
   goto owner
   !liby[1] = name of ce
   !liby[2] = !liby[1].replace('IDLIST','PLANES')
   !liby[3] = !liby[1].replace('IDLIST','TAGLIB')
   do !lib values !liby
      $!lib
      delete $!!ce.type
   enddo

   $!save
   delete $!!ce.type
   !viewNumber = !this.vList.val
   if (!viewNumber eq !this.vList.dText.size()) then
     !zero = !viewNumber - 1
     if (!zero.eq(0)) then
       hide !!abaUserView
       !!abaTemplate('SHEET','MODIFY')
       !!abaTemplateSht.mode = 'CREATE'
       !this.viewName = object DBREF()
       return
     else
       !this.vList.val = !viewNumber - 1
     endif
   else
       !this.vList.val = !viewNumber + 1

   endif

   -- Reset form
   if (!!ce.mcount.gt(0)) then
     --<RM> P-39536 03/08/11 when a view is deleted the shttmpl becomes the current element so we need to make sure the view current view is selected before
     --we update the form gadgets - start
     if !!ce.type.neq('VIEW') then
       view $!this.vList.val
       handle ANY
         return
       endhandle
     endif
     --<RM> P-39536 03/08/11 when a view is deleted the shttmpl becomes the current element so we need to make sure the view current view is selected before
     --we update the form gadgets - end
     !this.viewName = !!ce
     !this.setViewFromList()
   endif

endmethod
-- End of method definition for .deleteView()

------------------------------------------------------------------------
--
-- Method:      .findEntry(STRING)
--
-- Description: Find an entry in the choice grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      The string to find
--
-- Return:
--   [Data Type] [Description]
--    REAL        Index of found string
--
------------------------------------------------------------------------
define method .findEntry(!what is STRING) is REAL

  -- Initialise variables
  !allRows = !this.choiceControl.getRows()

  -- Search all grid entries
  do !index ind !allRows

    -- Initialise variables
    !row = !allRows[!index]

    -- Look for the passed string in the row array
    if (!row.findFirst(!what).set()) then
      return !index
    endif

  enddo

  return 0

endmethod
-- End of method definition for .findEntry(STRING)

-----------------------------------------------------------------------------
define method .getTasks()

  -- Initialise variables
  !allNames = ARRAY()

  VAR !taskLayer COLLECT ALL LAYE WITH SPPURP EQ 'ABAT' FOR CE
  if (!taskLayer.size() gt 1) then
    !!alert.error('Too many Task Layers Exist - Contact Admin')
    return
  elseif (!taskLayer.size() eq 0) then
    !!alert.error('No Layers Exist with SPPURP = ABAT - Contact Admin')
    return
  endif

  !!ce = !taskLayer[1].dbRef()

  -- Add the slashes to the displayed names
  do !name val !this.choiceControl.getColumn(1)
    if (!name.substring(1,1).neq('/')) then
      !allNames.append('/' & !name)
    else
      !allNames.append(!name)
    endif
  enddo

  -- Set the tasks applied to this sheet.
  !this.choiceTaskList.writeTaskData(!allNames,'VIEW')

  VIEW

endmethod
-- End of method definition for .getTasks(STRING)

-----------------------------------------------------------------------------
define method .isModified()

  !!abaUserView.saved = FALSE

endmethod
-- End of method definition for .isModified()

------------------------------------------------------------------------
--
-- Method:      .modifyTask()
--
-- Description: Modify the selected task from the choice grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyTask()

  -- Test for any selected task
  if (!this.choiceControl.getSelectedRows().set()) then

    -- Attempt to find a form that matches the task
    !taskForm = '!!' & !this.task.execute

    -- If the form is not defined then attempt to load it
    if (undefined($!taskForm)) then

      pml load form $!taskForm

      if (undefined($!taskForm)) then

        -- Build a form to allow the user to modify the task parameters
        !!abaBuildEditForm(!this.task,'VIEW')

        !taskForm = '!!editUserTask'

      endif

    endif

    -- Set the form member to the selected task
    !form      = $!taskForm
    !form.task = !this.task
    !form.form = !this

    -- Show the form
    !form.show('CEN', 0.5, 0.5)

  endif

endmethod
-- End of method .modifyTask()

-----------------------------------------------------------------------------
define method .modifyTask(!dText is STRING, !dummyRText is STRING)

-- Get task form name
  !taskForm = '!!' & !this.task.execute

-- Show task form
  kill $!taskForm
  show $!taskForm centre xr 0.5 yr 0.5
   handle (61,123)
     -- F&M: Form ... not found
     !!abaBuildEditForm(!this.taskList,!dText,'VIEW')
   endhandle

endmethod
-- End of method definition for .modifyTask(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      .move(STRING)
--
-- Description: Move the selected entry in choice grid list order
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Direction of move UP or DOWN
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .move(!direction is STRING)

  -- Initialise variables
  !taskName = !this.task.name
  !sorted   = ARRAY()

  -- Get selected row number
  !selectedNumber = !this.choiceControl.getSelectedRowTags()[1].real()

  -- Created sorted indices array
  do !count from 1 to !this.choiceTaskList.taskArray.size()

    -- Move UP one level in the list order
    if (!direction.eq('UP')) then

      -- Test for the position of the entry immediately before the selected entry
      if (!count.eq(!selectedNumber - 1)) then
        !sorted.append(!count + 1)

      -- Test for the position of the selected entry
      elseif (!count.eq(!selectedNumber)) then
        !sorted.append(!count - 1)

      else
        !sorted.append(!count)

      endif

    -- Move DOWN one level in the list order
    else

      -- Test for the position of the selected entry
      if (!count.eq(!selectedNumber)) then
        !sorted.append(!count + 1)

      -- Test for the position of the entry immediately after the selected entry
      elseif (!count.eq(!selectedNumber + 1)) then
        !sorted.append(!count - 1)

      else
        !sorted.append(!count)

      endif

    endif

  enddo

  -- Sort the choice task array
  !this.choiceTaskList.taskArray.reIndex(!sorted)

  -- Clear the choice grid and associated data
  !this.choiceControl.clearGrid()
  !this.choiceRowSet.clear()

  -- Reset the choice grid
  do !taskObj val !this.choiceTaskList.taskArray

    -- Initialise variables
    !rowData  = ARRAY()

    -- Build row data
    !rowData.append(!taskObj.name.after('/'))
    !rowData.append(!taskObj.description)

    -- Add row data to row set array
    !this.choiceRowSet.append(!rowData)

  enddo

  -- Set the grids
  using namespace 'Aveva.Pdms.Presentation'
  !this.choiceControl.bindToDataSource(object NETDATASOURCE('Options', !this.headings, !this.choiceRowSet, '^Name'))

  -- Reselect the moved entry
  !this.choiceControl.selectRow(!this.findEntry(!taskName))

endmethod
-- End of method definition for .move(STRING)

------------------------------------------------------------------------
--
-- Method:      .optionsAfterSelectChange(ARRAY)
--
-- Description: Callback on grid control after select change of the options grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .optionsAfterSelectChange(!array is ARRAY)

  -- Select the task
  if (!this.optionsControl.getSelectedRowTags().set()) then
    !this.setTask('OPTIONS', !array[0][1].real())

    -- Clear any choice selection
    !this.choiceControl.clearRowSelection()

    -- Set task
    !this.setTask('OPTIONS', !array[0][1].real())

  -- Clear current task
  else
    !this.task = object ABATASK()

  endif

endmethod
-- End of method definition for .optionsAfterSelectChange(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .parseTasks()
--
-- Description: Parse the tasks for the relevant grids
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .parseTasks()

  -- Initialise variables
  !optionsRowSet = ARRAY()
  !choiceRowSet  = ARRAY()

  -- Clear the grids
  !this.clear('GRIDS')

  -- Build the not chosen tasks array for the options grid
  do !taskObj val !this.optionsTaskList.taskArray

    -- Initialise variables
    !rowData  = ARRAY()

    -- Build row data
    !rowData.append(!taskObj.name.after('/'))
    !rowData.append(!taskObj.description)

    -- Add row data to row set array
    !optionsRowSet.append(!rowData)

  enddo

  -- Build the chosen tasks array for the choice grid
  do !taskObj val !this.choiceTaskList.taskArray

    -- Initialise variables
    !rowData  = ARRAY()

    -- Build row data
    !rowData.append(!taskObj.name.after('/'))
    !rowData.append(!taskObj.description)

    -- Add row data to row set array
    !choiceRowSet.append(!rowData)

  enddo

  -- Set the grids
  using namespace 'Aveva.Pdms.Presentation'
  !this.optionsControl.bindToDataSource(object NETDATASOURCE('Options', !this.headings, !optionsRowSet, '^Name'))
  !this.choiceControl.bindToDataSource(object NETDATASOURCE('Options', !this.headings, !choiceRowSet, '^Name'))

endmethod
-- End of method .parseTasks()

------------------------------------------------------------------------
--
-- Method:      .receiveTask(ABATASK)
--
-- Description: Receive the modified task object from the modifying form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .receiveTask(!task is ABATASK)

  -- Replace this task
  !this.task = !task

  -- Find the task in the task list array
  do !position ind !this.allTaskList.taskArray

    !task = !this.allTaskList.taskArray[!position]

    break if (!task.name.eq(!this.task.name))

  enddo

  !this.allTaskList.taskArray[!position] = !this.task

  -- Replace the selected task in the choice grid
  !this.choiceTaskList.taskArray[!this.choiceControl.getSelectedRowTags()[1].real()] = !this.task

  -- Make the apply button active
  !this.setApplyTrue()

endmethod
-- End of method .receiveTask(ABATASK)

------------------------------------------------------------------------
--
-- Method:      .removeTask()
--
-- Description: Remove a task from the selected list and add it to the available list
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeTask()

  -- Check for any selected entry
  if (!this.choiceControl.getSelectedRows().set()) then

    -- Selected row
    !rowNumber = !this.choiceControl.getSelectedRowTags()[1].real()
    !taskName  = !this.choiceControl.getSelectedRows()[1][1]

    -- Move the selected options task from the choice list array to the options list array
    !this.optionsTaskList.taskArray.append(!this.choiceTaskList.taskArray[!rowNumber])
    !this.choiceTaskList.taskArray.remove(!rowNumber)

    -- Add the relevant tasks row data to each grid
    !this.parseTasks()

    -- Select the added task in the choice grid
    !this.optionsControl.selectRow(!this.findEntry(!taskName))

    -- Activate the apply button
    !this.setApplyTrue()

  endif

endmethod
-- End of method .removeTask()

--------------------------------------------------------------------
define method .runInit()

  -- Clear all relevant arrays
  !this.clear('ALL')

  -- Check to see if current position in hierarchy is ABA admin area, and
  -- is set to a view, if not then present abaViewList for selection of a given view.

  -- Check to see if we are changing view, set nlpn back to 1
  if (!!ce.type.eq('VIEW') and !!ce.nlStyle.eq(!this.editStyle)) then

    if (!this.origStyle.unset()) then
      !this.origStyle = 'Solid'
    endif
    if (!this.origColour.unset()) then
      !this.origStyle = 'Grey'
    endif

    NLStyle $!<this.origStyle>
      handle (64,508)
        -- VIEW /TMPL3/S1/V1: Failed to find segment - picture may require Update
        update picture
        NLStyle $!<this.origStyle>
      endhandle

    NLColour $!<this.origColour>
    LFRA $!this.lfra

   endif

   -- Look for view
   !this.setView(!this.mode)

   -- Get the names of all the tasks in the current view
   !chosenNameArray = !this.choiceTaskList.getListNames()

   -- Find the not selected tasks
   do !taskObj val !this.allTaskList.taskArray

     -- Skip if the task is already chosen
     skip if (!chosenNameArray.findFirst(!taskObj.name.upCase()).set())

     -- Add not chosen task to the options array
     !this.optionsTaskList.taskArray.append(!taskObj)

   enddo

  -- Add the relevant tasks row data to each grid
  !this.parseTasks()

   -- Grey out scale selection for maximum
   !this.setScale(!this.scaleChoice.val)
   !this.modified = TRUE
   !this.saved = TRUE
   !this.apply.active = False

   -- Set copy button active
   if (!this.mode.eq('MODIFY')) then
     !this.copy.active = true
   endif

endmethod
-- End of method definition for .runInit()

--------------------------------------------------------------------
define method .scaleSelection(!type is STRING)

-- Initialise variables
   !scDtext = ARRAY()
   !scRtext = ARRAY()

-- Read permitted scales from  defaults file section 2
   !file = object FILE(!!abaDefaults.defaultsFile.val)
   !defaultText = !file.readfile()
   !start = !defaultText.findFirst('-- Section 2') + 1
   !end   = !defaultText.findFirst('-- End Section 2')
   !range = !end - !start
   !scales = !defaultText.from(!start,!range)

-- Extract relevant bits for form gadget
   do !x values !scales
     if (!x.match(!type).neq(0)) then
       !split = !x.split('\')
       !scDtext.append(!split[3])
       !scRtext.append(!split[5].split(',')[1])
     endif
   enddo

   !this.scaleValue.dText = !scDtext
   !this.scaleValue.rText = !scRtext

   -- Check for displayed limits information form
   !this.what()

endmethod

-------------------------------------------------------------------------------
define method .setApplyFalse()

  !this.saved        = true
  !this.apply.active = False

endmethod

-------------------------------------------------------------------------------
define method .setApplyTrue()

  !this.saved        = false
  !this.apply.active = True

endmethod

-----------------------------------------------------------------------------
define method .setDir()

  -- Set direction gadget
  !this.direction.val = !this.dirOption.selection()

  -- Check for displayed limits information form
  !this.what()

endmethod

-----------------------------------------------------------------------------
define method .setScale(!choice is REAL)

       !!abaUserView.setApplyTrue()
-- Called when scale set is selected
-- 1 = Maximum; 2 = Nearest; 3 = Specific

   -- Make certain options active/inactive
   -- Scale value & limit information
   if (!choice.eq(3)) then
     !this.scaleValue.active = TRUE
     !this.what.active = TRUE
   else
     !this.scaleValue.active = FALSE
     !this.what.active = FALSE
   endif

   -- Scale type
   if (!choice.eq(1)) then
     !this.scaleType.active = FALSE
   else
     !this.scaleType.active = TRUE
   endif

   -- Check for displayed limits information form
   !this.what()

endmethod

-----------------------------------------------------------------------------
define method .setTask()

  -- Reset the task to the current selection i.e. number 1
  !this.taskList.getTask(!this.choice.selection('RTEXT'))

endmethod

------------------------------------------------------------------------
--
-- Method:      .setTask(STRING,ARRAY)
--
-- Description: Parse the tasks for the relevant grids
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Which grid is being selected OPTIONS or CHOICE
--    2   R      REAL        The row being selected
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTask(!gridName is STRING, !rowNumber is REAL)

  -- For the Options grid
  if (!gridName.eq('OPTIONS')) then

    -- Reset the task to the current selection
    !this.task = !this.optionsTaskList.taskArray[!rowNumber]

  -- For the Choice grid
  else

    -- Reset the task to the current selection
    !this.task = !this.choiceTaskList.taskArray[!rowNumber]

  endif

endmethod
-- End of method .setTask(STRING,ARRAY)

-----------------------------------------------------------------------------
define method .setView(!mode is STRING)

  -- Check stored view exists and has had it's frame reset
  if (!this.viewName.unset().not()) then

    VAR !exist EXIST $!this.viewName
    if (!exist.upCase().eq('TRUEA')) then

      !ce  = !!ce
      !!ce = !this.viewName

      -- Reset the view frame to the original setting
      if (!!ce.nlStyle.eq(!this.editStyle)) then

        NLStyle $!<this.origStyle>
        NLColour $!<this.origColour>
        LFRA $!this.lfra

      endif

      !!ce = !ce

    endif

  endif

  !this.mode = !mode

  VIEW
   handle (2,111)

     -- Handle case when "NOT" at a current view.
     VAR !check COLLECT ALL VIEW FOR CE

     -- Handle the "MODIFY" case and when/if there are no views present.
     if (!mode eq 'MODIFY' AND !check.size() eq 0) then
       !!alert.error('No Views Available for Modification')
       return

     -- When only one view found, use it
     elseif (!mode.eq('MODIFY') and !check.size().eq(1)) then

       !!ce = !check[1].dbRef()
       !this.viewName = !!ce

       -- Handle the "CREATE" case and when/if there are no views present.
       if (!mode eq 'CREATE') then

         !this.title.val = !!ce.owner.title

         if (!this.createView().not()) then
           return
         endif

       endif

     elseif (!mode eq 'MODIFY' and !check.size() ne 0) then

       -- Get user to select a view
       show !!abaViewList centred xr 0.5 yr 0.5
       !!abaViewList.mode = !mode
       !!abaViewList.setupList()

       return

     elseif (!mode eq 'CREATE') then

       if(!this.createView().not())then
         return
       endif

     endif

   elsehandle none

     -- Use this view
     !this.viewName = !!ce

     -- Handle the "CREATE" case and when/if there are no views present.
     if (!mode eq 'CREATE') then

       !this.title.val = !!ce.owner.title

       if(!this.createView().not())then
         return
       endif

     endif

   endhandle

   -- Test for case when chosen view does not have any members
   if (!this.viewName.unset().not()) then

     if (!this.viewName.mcount.eq(0)) then
       handle(2,202)

         -- Create the view hierarchy
         !this.mode = 'CREATE HIERARCHY'

         !this.createView()

         !this.mode = 'MODIFY'

       endhandle

       endif

   endif

-- ----------------------------------------------------------------
-- Now create/modify the current view

   !save = !!ce
   GOTO OWNER
   !!abaAddGraphElem('ce')
   !!ce = !save
   !this.origStyle  = !!ce.nlStyle
   !this.origColour = !!ce.nlColour
   !this.lfra = !!ce.lfra
   NLStyle $!<this.editStyle>
     handle (64,508)
       -- Failed to find segment - picture may require Update
       UPDATE PICTURE
       NLStyle $!<this.editStyle>
     endhandle
   NLColour $!<this.editColour>
   LFRA TRUE

-- Make view list from current hierarchy.
   VAR !viewList COLL ALL VIEW FOR OWNER OF CE
   VAR !viewNameList EVAL NAME FOR ALL FROM !viewList
   !this.vList.dText = !viewNameList
   !this.vList.rText = !viewList
   !this.vList.val = !this.vList.dText.find(!!ce.name)[1]

-- Store view data in form members
   !dllbName = !this.vList.selection('DTEXT') & '/IDLIST'
   !pllbName = !this.vList.selection('DTEXT') & '/PLANES'
   !trlbName = !this.vList.selection('DTEXT') & '/TAGLIB'
   !this.dllb = !dllbName.dbRef()
     handle (2,109)
     endhandle
   !this.pllb = !pllbName.dbRef()
     handle (2,109)
     endhandle
   !this.trlb = !trlbName.dbRef()
     handle (2,109)
     endhandle

-- Set NAME of current element.
   !this.viewName = !!ce
-- !this.name.val = !!ce.name
--
-- Set the TITLE of the current view selected.
   !this.title.val = !!ce.title
--
-- Get the current views VTYPE
--   !ceVType = !!ce.vType.upCase()
   !this.type.select('Rtext', !!ce.vType.upCase())
--
-- Get the current views SMODE
   if (!!ce.smode eq 'Standard') then
       !this.smode.val = 1
   elseif (!!ce.smode eq 'Omit Fractional Pcomponents') then
       !this.smode.val = 2
   endif
--
-- Get the current views STYLE setting
   !rrsf = !!ce.rrsf.name
   handle(2,202)
     !!alert.error('Cannot find Representation Style - (RRSF)')
   elsehandle(2,754)
     !this.rrsf.val = !this.rrsf.dText[1]
   elsehandle none
     !this.rrsf.val = !this.rrsf.dText.find(!rrsf)[1]
   endhandle

  -- Get the current views Direction
  !this.direction.val = !!ce.direction.string().before('WRT').replace('44','').trim()

  -- Set the view type (In function)
  !this.keyArea.active = FALSE

  if (!!ce.spPURP eq 'ABAT') then
    !this.viewType.val = 1
  elseif (!!ce.spPURP eq 'ABAK') then
    !this.keyArea.active = TRUE
    !this.viewType.val = 2
  else
    !this.viewType.val = 3
  endif

  -- Select the view direction
  !this.dirOption.select('RTEXT',!this.direction.val)
    handle (61,567)
      -- F&M: Cannot find required field in list/menu
      !this.dirOption.val = !this.dirOption.rText.size()
    endhandle

-- Get the current views Scale Selection

  -- Initialise variables
  !func = !this.vList.selection().dbRef().func.split()
  !vsca = !this.vList.selection().dbRef().vsca

-- Find scale entry in rtext of gadget, or set to 1.0
   do !x index !this.scaleValue.rText
      if (!this.scaleValue.rText[!x].real() eq !vsca) then
          !vscale = !x
          break
      else
          !vscale = 1
      endif
   enddo

  -- Select gadget values
  if (!func.set()) then
    !this.scaleChoice.select('RTEXT',!func[1])
    !this.scaleType.select('RTEXT',!func[2])
    !this.scaleValue.val = !vscale
  endif

  -- Go off and collect all assigned "tasks" for this view.
  !this.choiceTaskList.clear()
  !this.choiceTaskList.readTempTask(!this.viewName)

  -- Return Members list back to View...
  VIEW

endmethod

-----------------------------------------------------------------------------
define method .setViewFromList()

  !this.setApplyFalse()

  !!ce = !this.vList.rText[!this.vList.val].dbRef()

  !this.setView('MODIFY')

  -- Populate the gadgets
  !this.runInit()
endmethod

--------------------------------------------------------------------
define method .setViewTasks()

  -- Reset the tasks
  !this.allTaskList.getLibraryTasks('VIEW')

endmethod

-------------------------------------------------------------------------------
define method .showTagging()

  --
  !!abaTagging.viewName = !this.viewName
    handle (2,765)
      -- Cannot get member VIEWNAME from non-existent object
      loadform !!abaTagging
      !!abaTagging.viewName = !this.viewName
    endhandle

  show !!abaTagging cen xr 0.5 yr 0.5

endmethod

-------------------------------------------------------------------------------
define method .showExtendArea()

  --
  !!abaExtendArea.viewName = !this.viewName
    handle (2,765)
      -- Cannot get member VIEWNAME from non-existent object
      loadform !!abaExtendArea
      !!abaExtendArea.viewName = !this.viewName
    endhandle

  show !!abaExtendArea cen xr 0.5 yr 0.5

endmethod

-------------------------------------------------------------------------------
define method .viewType(!button is STRING)

  --
     !!abaUserView.setApplyTrue()
     if (!button eq 'Area') then
         !this.keyArea.active = FALSE
     elseif (!button eq 'Keyplan') then
         !this.keyArea.active = TRUE
     else
         !this.keyArea.active = FALSE
     endif

endmethod
-- End of method definition for .viewType(STRING)

------------------------------------------------------------------------
define method .visibility(!type is STRING)

  -- Initialise variables
  !ce = !!ce

  -- Access View
  !!ce = !this.viewName

  -- Switch on/off
  if (!type.eq('VIEW')) then

    -- Read visibility
    !visible = !this.viewName.lvis

    -- Set visibility
    if (!visible) then
      LVIS FALSE
    else
      LVIS TRUE
    endif

  else

    -- Read visibility
    !visible = !this.viewName.lfra

    -- Set visibility
    if (!visible) then
      LFRA FALSE
      !this.lfra = false
    else
      LFRA TRUE
      !this.lfra = true
    endif

  endif

  -- Return to hierarchy position
  !!ce = !ce

endmethod
-- End of method definition for .visibility(STRING)

-----------------------------------------------------------------------------
define method .what()

  !this.setApplyTrue()

  -- Check for displayed limits information form
  if (not defined(!!abaWhat)) then

    -- Load limit information form
    pml load form !!abaWhat

  endif

  if (!!abaWhat.shown()) then

    -- Refresh form with new data
    !!abaWhat(!this.viewName)

  endif

endmethod
-- End of method definition for .what()
