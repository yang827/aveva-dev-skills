--
--
-- Description: Modify sheet template used as a variant
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  getData()                        -
--  init()                           -                   Method to initialize the form
--  setvariant()                     -
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
setup form !!abaVariant blocking

  title |Modify Sheet Variant|
  init |!this.init()|

  path down

  -- Define Members/Selection Areas
  para   .text at x1 y0 text |Drawings|
  option .drwgs || at xmin ymax call |!this.getData()| width 25

  list .list |Template Variants| at xmin ymax+0.5 call |!this.setvariant()| single width 25 height 10

  -- Action buttons
  button .apply   | Apply | at x0 ymax+0.4 call |!this.apply()|

  path right
  button .dismiss |Dismiss| at xmax form-size cancel

  -- Members
  member .drawings is ARRAY
  member .select   is DBREF
  member .original is DBREF

exit
-- End of form definition

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !drwgNames = array()
  !this.drawings.clear()

  -- Get the selected rows in the process form old drawings grid
  !list = !!abaprocess.oldControl.getSelectedRowTags()

  if !list.unset() then
    !!alert.error('No Drawings Selected')
    !this.hide()
    return
  endif

  do !a values !list

   !this.drawings.append(!!abaprocess.olddrawings[!a.real()])
   !drwgnames.append(!this.drawings[!this.drawings.size()].drwg.name)

  enddo

  -- Initialise variables
  !drawings = !this.drawings
  !selDrwg  = !this.select


  -- Add all drawings to gadget
  !sorted = !drwgNames.sortedindices()
  !drwgNames.reIndex(!sorted)
  !this.drawings.ReIndex(!sorted)
  !this.drwgs.dtext = !drwgNames

  -- Get data
  !this.getData()

endmethod
-- End of method definition for .init()

--------------------------------------------------------------------
define method .getData()

  -- Initialise variables
  !this.list.clear()

  !drwg = !this.drawings[!this.drwgs.val].drwg
  !drTmpl = !this.drawings[!this.drwgs.val].template.owner
  var !shTmpl coll all shtmpl for $!drTMPL
  var !shTmplFunc eval func for all from !shTmpl
  var !shTmplTitl eval titl for all from !shTmpl
  !dtext = array()
  !rtext = array()

  -- Build display array
  !w1 = !shTmplFunc.width()
  !w2 = !shTmplTitl.width()

  do !index ind !shTmpl

    var !text compose |$!shTmplFunc[$!index]|  width $!w1 Left spaces 2 $
                      |$!shTmplTitl[$!index]|
    !dtext.append(!text[1])

    !rtext.append(!shTmpl[!index].dbref().string())

  enddo

  -- Populate the list
  !this.list.dtext = !dtext
  !this.list.rtext = !rtext

  -- Select relevant set variant
  !this.list.select('RTEXT',!this.drawings[!this.drwgs.val].template.string())

  -- Store set sheet template as shown by process form
 !this.original = !this.drawings[!this.drwgs.val].template
 !this.list.select('RTEXT',!this.original.string())

endmethod

--------------------------------------------------------------------
define method .apply()

-- Called on apply

  do !a values !this.drawings
    !!abaprocess.replacedrawing(!a)
  enddo

  !!abaprocess.display()

endmethod

-------------------------------------------------------------------------
define method .setvariant()

   !oldtemplate = !this.drawings[!this.drwgs.val].template
   !newtemplate = !this.list.selection('rtext').dbref()
   !this.drawings[!this.drwgs.val].template = !newtemplate
   if !newtemplate eq !oldtemplate then
     !!alert.error('Drawing already uses this template')
   else
     !!alert.message('Template modified - Drawing will be regenerated')
   endif
   !func = !newtemplate.func
   if (!func.eq('Master')) then
       !this.drawings[!this.drwgs.val].variant = 'M '
   else
       !this.drawings[!this.drwgs.val].variant = 'V' & !func.after('Variant ')
   endif

endmethod
-------------------------------------------------------------------------
