--
--
-- Description: List of available drawings for Modification.
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaViewList()                    -                   Constructor method
--  afterSelectChange(ARRAY)         -                   Callback on grid control after select change of the options grid
--  cancel()                         -
--  selectView()                     -                   Using the selected view, show the view form
--  setView(DBREF)                   -
--  setView(STRING)                  -
--  setupList()                      ARRAY
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!abaViewList

  title |ABA Template View List|
  cancelcall |!this.cancel()|

  para .title at x0 y0 text |Template Views|
  container .viewGrid nobox pmlNetControl 'NET' at xmin ymin+0.6 width 60 height 12

  -- Declare the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  member .viewControl is NETGRIDCONTROL

  member .headings is ARRAY
  member .allViews is ARRAY

  member .mode     is STRING
  member .formCall is STRING
  member .view     is STRING

exit

------------------------------------------------------------------------
--
-- Method:      .abaViewList()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------------------------------
define method .abaViewList()

  -- Create instances of the grid controls
  using namespace 'Aveva.Pdms.Presentation'
  !this.viewControl = object NETGRIDCONTROL()

  -- Add .net control to the container
  !this.viewGrid.control = !this.viewControl.handle()

  -- Add PML event handlers to .net control
  !this.viewControl.addEventHandler('afterSelectChange', !this, 'afterSelectChange')

  -- Set grid visual attributes
  !this.viewControl.columnExcelFilter(false)
  !this.viewControl.outlookGroupStyle(false)
  !this.viewControl.fixedRows(false)
  !this.viewControl.gridHeight(1000.0)
  !this.viewControl.editableGrid(false)
  !this.viewControl.singleRowSelection(true)
  !this.viewControl.columnExcelFilter(false)
  !this.viewControl.fixedHeaders(false)
  !this.viewControl.headerSort(true)
  !this.viewControl.columnSummaries(false)

  -- Set grid control headings
  !this.headings.append('Name')
  !this.headings.append('Description')

endmethod
-- End of method definition for .abaViewList()

------------------------------------------------------------------------
--
-- Method:      .afterSelectChange(ARRAY)
--
-- Description: Callback on grid control after select change of the options grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .afterSelectChange(!array is ARRAY)

  -- Select the drtmpl
  if (!this.viewControl.getSelectedRowTags().set()) then
    !this.selectView()
  endif

endmethod
-- End of method definition for .afterSelectChange(ARRAY)

------------------------------------------------------------------------
define method .setupList() is ARRAY

  -- Initialise variables
  !this.allViews.clear()
  !savePos = !!ce
  !dtext   = ARRAY()
  !rtext   = ARRAY()
  !rowSet  = ARRAY()

  -- Attempt to access a view element from the current position in the hierarchy
  VIEW
   handle (2,111)
     -- Cannot access element type VIEW from the level of WORLD /*
     if (!!ce.type.upcase().eq('SHTMPL')) then

       VAR !allViews COLLECT ALL VIEW FOR CE

       if (undefined(!allViews[1])) then
         !!alert.error('Selected sheet template does not contain any Views')
         !array[1] = 'FAIL'
         return !array
       endif

       !this.view = !allViews[1].string()

     elseif (!!ce.type.upcase().eq('DRTMPL')) then

       VAR !allViews COLLECT ALL VIEW FOR CE

       !this.view = !allViews[1].string()

     else

       VAR !allViews COLLECT ALL VIEW FOR $!!abaDefaults.dlib.val

       !this.view = 'ALL'

     endif

   elsehandle none

     if (!!ce.owner.type.upcase().eq('SHTMPL')) then

       VAR !allViews COLLECT ALL VIEW FOR OWNER OF CE

       !this.view = !!ce.ref.string()

     else

       VAR !allViews COLLECT ALL VIEW FOR $!!abaDefaults.dlib.val

       !this.view = 'ALL'

     endif

   endhandle

   VAR !allNames EVAL NAME FOR ALL FROM !allViews

  -- Build the row data set
  do !view val !allViews

    -- Initialise variables
    !viewRefe = !view.dbref()
    !rowData  = ARRAY()

    -- Build row data
    !rowData.append(!viewRefe.name)
    !rowData.append(!viewRefe.title)

    -- Add row data to row set array
    !rowSet.append(!rowData)

    -- Store view reference
    !this.allViews.append(!viewRefe)

  enddo

  -- Sort by name
  !sorted = !allNames.sortedIndices()

  !rowSet.reindex(!sorted)
  !this.allViews.reindex(!sorted)

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.viewControl.bindToDataSource(object NETDATASOURCE('Views', !this.headings, !rowSet, '^Name'))

  return !allNames.sort()

endmethod

------------------------------------------------------------------------
define method .setView(!selection is DBREF)

  !!ce = !selection

  if (!this.formCall.eq('VIEW')) then

    !!abaUserView.mode     = !this.mode
    !!abaUserView.viewName = !selection

    show !!abaUserView cen xr 0.5 yr 0.4

    !!abaUserView.runInit()

  else

    !!abaTagging.mode     = !this.mode
    !!abaTagging.viewName = !selection

    show !!abaTagging cen xr 0.5 yr 0.4

  endif

  !!abaViewList.hide()

endmethod

------------------------------------------------------------------------
--
-- Method:      .selectView()
--
-- Description: Using the selected view, show the view form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectView()

  -- Get selected row number
  !rowNumb = !this.viewControl.getSelectedRowTags()[1].real()

  -- Access the selected view
  !!ce = !this.allViews[!rowNumb]

  -- Set view form parameters
  if (!this.formCall.eq('VIEW')) then

    !!abaUserView.mode     = !this.mode
    !!abaUserView.viewName = !this.allViews[!rowNumb]
    show !!abaUserView cen xr 0.5 yr 0.4
    !!abaUserView.runInit()

  else

    !!abaTagging.mode     = !this.mode
    !!abaTagging.viewName = !!ce
    show !!abaTagging cen xr 0.5 yr 0.4

  endif

  -- Hide this form
  !this.hide()

endmethod
-- End of method .selectView()

------------------------------------------------------------------------
define method .setView(!selection is STRING)

  !!ce = !selection.dbref()

  !!abaViewList.hide()

  if (!this.formCall eq 'VIEW') then

    !!abaUserView.mode     = !this.mode
    !!abaUserView.viewName = !selection.dbref()

    show !!abaUserView cen xr 0.5 yr 0.4

    !!abaUserView.runInit()

  else

    !!abaTagging.mode     = !this.mode
    !!abaTagging.viewName = !selection.dbref()

    show !!abaTagging cen xr 0.5 yr 0.4

  endif

endmethod

------------------------------------------------------------------------
define method .cancel()

  !!abaViewList.hide()
  !!abaProcess.visible()

endmethod
