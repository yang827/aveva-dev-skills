--
-- Description: Display information about the view limits
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

setup form !!abaWhat
title |Limit Information|

  frame .text | The Maximum 3D box | at x0

    para .ewT at x1   y1   text |East-West:  |
    para .nsT at xmin ymax text |North-South:|
    para .udT at xmin ymax text |Up-Down:    |

    para .EW at xmax.ewT+1 ymin.ewT width 12 lines 1
    para .NS at xmax.nsT+1 ymin.nsT width 12 lines 1
    para .UD at xmax.udT+1 ymin.udT width 12 lines 1

  exit

exit

-- End of form definition
