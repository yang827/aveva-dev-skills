--
--
-- Description:
-- Create a plotfile of all sheets
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs

--
------------------------------------------------------------------------
define function !!abaAddGraphElem(!element is string)

  -- Initialise variables
  !type = !element.dbref().type
  !name = !element.dbref().flnm

  -- Set main display fields
  -- PDMS11.3 Change, Neale Morris, 28/03/2001

  VAR !!CDRCADCGA1.N1ADDTYPE '$!type'
  VAR !!CDRCADCGA1.N1ADDNAME '$!name'

  -- Add element into the main display area
  edit !!CDRCADCGA1.N1 AREA
    put $!element
      handle (64,510)
        -- SHTMPL /TMPL3/S1: Failed to open picture file (FNF:File not found).  Use UPDATE PICTURE command.
      endhandle
  exit

  !!CDRCADCGA1.formtitle = 'Main Display  ' & !element.dbref().namn

endfunction
