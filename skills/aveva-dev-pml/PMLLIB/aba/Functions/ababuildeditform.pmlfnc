--     Keyword:     ABA
--   Module:        Draft
--   Replaces:
--
-- Author:          Martin Wright
-- Created:         25 May 1999
--
--
-- Description:
--              Create form to edit a task parameter, builds form with relevant
--              fields for description, and parameter value.
--
-- LIMITATIONS
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ABATASK     Supplied current task
--    2    R     STRING      The task type PROCESS, DRAWING, VIEW
--
-- ASSUMPTIONS
--
--
-----------------------------------------------------------------------------------------
define function !!abaBuildEditForm(!taskObj is ABATASK, !type is STRING)

  -- Initialise variables
  !size  = !taskObj.paramDesc.width()
  !size1 = !taskObj.paramVal.width() + 10

  -- Check for any parameters
  if (!taskObj.paramDesc.size().eq(0)) then
    !!alert.warning('The Task ' & !taskObj.name & 'does not have any parameters to modify')
    return
  endif

  kill !!editUserTask

  -- Build form
  setup form !!editUserTask

    path down
    title '$!taskObj.name'

    frame .frame ''

      do !index index !taskObj.paramDesc

        -- Form gadget name
        !gadgetName     = '.a' & !index
        !gadgetValue    = !gadgetName & '.val'
        !gadgetString   = '!this' & !gadgetValue & '.string()'
        !gadgetDistance = '!this' & !gadgetValue & |.string().real(!!distanceFMT).string('D6')|

        -- Compose the gadget description
        VAR !a COMPOSE '$!taskObj.paramDesc[$!index]' WIDTH $!size RIGHT SPACE 1

        -- Text gadget
        if (!taskObj.purpose[!index].eq('DSTNCE')) then

          -- Create & set gadget
          text $!gadgetName |$!a[1]| at x 1 call |!this.task.paramVal[$!index] = $!gadgetDistance| width $!size1 is REAL format !!distanceFMT
          !this$!gadgetValue = !taskObj.paramVal[!index].real()

        elseif (!taskObj.purpose[!index].eq('REAL')) then

          -- Create & set gadget
          text $!gadgetName |$!a[1]| at x 1 call |!this.task.paramVal[$!index] = $!gadgetString| width $!size1 is REAL
          !this$!gadgetValue = !taskObj.paramVal[!index].real()

        elseif (!taskObj.purpose[!index].eq('BOLEAN')) then

          -- Create & set gadget
          text $!gadgetName |$!a[1]| at x 1 call |!this.task.paramVal[$!index] = $!gadgetString| width $!size1 is BOOLEAN
          !this$!gadgetValue = !taskObj.paramVal[!index].boolean()

        else

          -- Create & set gadget
          text $!gadgetName |$!a[1]| at x 1 call |!this.task.paramVal[$!index] = $!gadgetString| width $!size1 is STRING
          !this$!gadgetValue = !taskObj.paramVal[!index]

        endif

      enddo

    exit

    button .ok     '  OK  ' at x 1 call |!this.form.receiveTask(!this.task)| OK
    path right
    button .cancel 'Cancel' at xmax form-size CANCEL

    member .form is FORM
    member .task is ABATASK
    member .type is STRING

    !this.task = !taskObj
    !this.type = !type

  exit

endfunction
