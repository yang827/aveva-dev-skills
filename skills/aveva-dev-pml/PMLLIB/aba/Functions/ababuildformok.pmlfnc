--
-- Author:          Steve Wilson
-- Created:         03 June 1999
--
--
-- Description:
-- Call back for the OK button on the form editUserTask
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     FORM        Calling form
--    2    R     REAL        Size of task list array
--    3    R     STRING      Type of task
--
------------------------------------------------------------------------
define function !!abaBuildFormOk(!form is FORM,!taskObj is ABATASKLIST,!type is string)

  if (!type.eq('PROCESS')) then
    !!abaProcessTask.taskList.setTaskString(!form,!taskObj)
  elseif (!type.eq('SHEE')) then
    !!abaTemplateSht.taskList.setTaskString(!form,!taskObj)
  elseif (!type.eq('VIEW')) then
    !!abaUserView.taskList.setTaskString(!form,!taskObj)
  elseif !type.eq('NAME') then
    !!abaNameselect.taskList.setTaskString(!form,!taskObj)
  endif

  -- Set calling form apply button active
  !!abaUserView.apply.active = true
    handle any
    endhandle

endfunction
