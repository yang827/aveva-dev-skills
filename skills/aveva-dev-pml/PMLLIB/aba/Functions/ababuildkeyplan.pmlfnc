--
-- File:            ababuildkeyplan.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         03 June 1999
--
--
-- Description:
-- Create overlay layers to represent the areas
--
-- A layer is created under the specified OVER for each of the areas
-- previously defined in the area library.
--
-- ASSUMPTION: North or Y is always UP the page, and we do not ever look UP
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       OVERlayer reference
--    2    R     STRING      Line Colour
--    3    R     STRING      Line Style
--    4    R     STRING      Hatching Colour
--    5    R     STRING      Hatching Style
--    6    R     STRING      Direction of view on the keyplan
--                           Default is D or -Z
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       DBREFs of the created OUTL elements
--
------------------------------------------------------------------------
define function !!abaBuildKeyplan(!overRefe is DBREF, !nlColour is STRING, !nlStyle is STRING, !fColour is STRING, !fStyle is STRING, !look is STRING) is ARRAY

  -- Initialise variables
  !outlRefes = ARRAY()

  -- Access the overlay
  !!ce = !overRefe
    handle (2,109)
      !!alert.error('Cannot find the specified OVERlay')
      return
    endhandle

  -- Get in position
  VAR !views COLL ALL VIEW WI SPPURP eq 'ABAK' FOR CE
  if (!views.empty()) then
    !!alert.error('The overlay must contain a set-up view to build the keyplan')
    return
  else
    !!ce = !views[1].dbref()
  endif

  -- Test for existing layers
  VAR !layers COLL ALL LAYE WI NTEXT EQ 'ABA' FOR $!views[1]
  if (!layers.set()) then
    !overWrite = !!alert.confirm('This overlay already contains AB ADP keyplan layers. Overwrite them?')
    if (!overWrite.upCase().eq('YES')) then
      do !laye val !layers
        !!ce= !laye.dbref()
        delete LAYE
      enddo
    else
      return
    endif
  endif

  -- Test for defaults
  if (undefined(!!abaDefaults.alib.val)) then
    pml load form !!abaDefaults
  endif

  -- Get all areas
  VAR !areas COLL ALL IDLI WI SPPURP EQ 'ABAR' FOR $!!abaDefaults.alib.val

  -- Build layers
  do !index ind !areas

    -- Initialise variables
    !func = !areas[!index].dbref().flnn

    -- Do not create an area for the keyplan idli
    skip if (!areas[!index].dbref().func.upCase().match('KEYPLAN').neq(0))

    -- Make layer name
    !layeName = !overRefe.name & ':' & !areas[!index].dbref().flnn

    -- Get area limits
    !abaView = object ABAVIEW()
    !abaView.abaview(!areas[!index].dbref())
    !minPos = !abaView.startpos
    !maxPos = !abaview.endpos

    -- Create laye
    NEW LAYE $!layeName
     BLNK FALSE

    -- Store area name
    NTEXT 'ABA'
    Func '$!func'

    NEW VNOT
    NEW OUTL
     NLColour $!nlColour
     NLStyle $!nlStyle
     FColour $!fColour
     FStyle $!fStyle

    !outlRefes.append(!!ce)

    -- Determine vertices depending upon the keyplan direction
    if (!look.eq('D') or !look.eq('-Z')) then
      NEW VRTX ORIGIN E $!<minPos.east> N $!<minPos.north> U 0
      NEW VRTX ORIGIN E $!<minPos.east> N $!<maxPos.north> U 0
      NEW VRTX ORIGIN E $!<maxPos.east> N $!<maxPos.north> U 0
      NEW VRTX ORIGIN E $!<maxPos.east> N $!<minPos.north> U 0
    elseif (!look.eq('E') or !look.eq('X')) then
      NEW VRTX ORIGIN E 0 N $!<maxPos.north> U $!<minPos.up>
      NEW VRTX ORIGIN E 0 N $!<maxPos.north> U $!<maxPos.up>
      NEW VRTX ORIGIN E 0 N $!<minPos.north> U $!<maxPos.up>
      NEW VRTX ORIGIN E 0 N $!<minPos.north> U $!<minPos.up>
    elseif (!look.eq('W') or !look.eq('-X')) then
      NEW VRTX ORIGIN E 0 N $!<minPos.north> U $!<minPos.up>
      NEW VRTX ORIGIN E 0 N $!<minPos.north> U $!<maxPos.up>
      NEW VRTX ORIGIN E 0 N $!<maxPos.north> U $!<maxPos.up>
      NEW VRTX ORIGIN E 0 N $!<maxPos.north> U $!<minPos.up>
    elseif (!look.eq('N') or !look.eq('Y')) then
      NEW VRTX ORIGIN E $!<minPos.east> N 0 U $!<minPos.up>
      NEW VRTX ORIGIN E $!<minPos.east> N 0 U $!<maxPos.up>
      NEW VRTX ORIGIN E $!<maxPos.east> N 0 U $!<maxPos.up>
      NEW VRTX ORIGIN E $!<maxPos.east> N 0 U $!<minPos.up>
    elseif (!look.eq('S') or !look.eq('-Y')) then
      NEW VRTX ORIGIN E $!<maxPos.east> N 0 U $!<minPos.up>
      NEW VRTX ORIGIN E $!<maxPos.east> N 0 U $!<maxPos.up>
      NEW VRTX ORIGIN E $!<minPos.east> N 0 U $!<maxPos.up>
      NEW VRTX ORIGIN E $!<minPos.east> N 0 U $!<minPos.up>
    endif

    NEW VRTX SPAN TO CLOSE

  enddo

  -- Return to over
  !!ce = !overRefe

  return !outlRefes

endfunction
