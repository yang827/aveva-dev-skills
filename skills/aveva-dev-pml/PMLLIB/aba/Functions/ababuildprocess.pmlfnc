define function !!ababuildprocess()
--
-- Collect all disciplines
   var !disc coll all IDLI for $!!abaDefaults.disl.val
   var !discn eval namn for all from !disc
--q var !discn
--
-- Collect all Areas
   var !area coll all IDLI for $!!abaDefaults.alib.val
   var !arean eval namn for all from !area
--q var !arean
--
setup form !!ProcessList
title 'ABA Process Criteria'
--
frame .fdisc 'Disciplines'
--
$(
path down
     do !x index !discn
        !gadget = '.disc' & !x
        Toggle $!<gadget> |$!discn[$!x]| Call '!This.DiscChk(|!x|)'
     enddo
--
exit
--
!cols = !areas.size() / !disc.size()
--
frame .farea 'Areas' at xmax.fdisc ymin.fdisc
   do !a from 1 to !cols
     do !x index !arean
            !gadget = '.area' & !x
            Toggle $!<gadget> |$!arean[$!x]| Call '!This.AreaChk(|!x|)'
     enddo
   enddo
exit
$)
--
--
$(
      if (!param[2][!x].upcase() EQ 'ON' or !param[2][!x].upcase() EQ 'YES') then
          para $!<gadget>p text |$!a[1]|
          path right
          Rgroup $!Gadget frame horizontal at ymin $!<gadget>p - .2
          add tag 'on '
          add tag 'off'
          exit
                if (!param[2][!x].upcase() EQ 'ON') then
                    !this$!<Gadget>.val = 1
                else
                    !this$!<Gadget>.val = 2
                endif
          path down
      else
--
          text $!gadget |$!a[1]| at x 1 width $!size1 is string
          !gadval = !gadget & '.val'
          !this$!gadval = !param[2][!x]
--      endif
$)
--
--
button .ok ' OK ' at x 1 Call |!!alert.warning('I must get this working!')| OK
Path Right
Button .Cancel 'Cancel' at xmax form-size CANCEL
exit

show !!processList at XR 2 YR 2


endfunction

define method .DiscCheck()

endMethod

---------------------------------------------------------------
define method .AreaCheck()
---------------------------------------------------------------

endMethod
