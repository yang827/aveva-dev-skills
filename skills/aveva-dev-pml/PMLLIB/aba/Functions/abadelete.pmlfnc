--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         03 June 1999
--
--
-- Description:
-- Delete template hierarchy
--
-------------------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Element to delete
--    2    R     STRING      Type of delete
--                                CE for current element
--                                MEMBERS for members of current element
--
-------------------------------------------------------------------------------------

define function !!abaDelete(!elemRefe is DBREF,!delType is STRING)

  -- Initialise variables
  !!ce = !elemRefe
  !reference = !elemRefe
  !elemType = !elemRefe.type.upCase()
  !elemName = !elemRefe.flnm
  !delLiby = true

  -- Confirm deletion
  if (!delType.eq('CE')) then

    !answer = !!alert.confirm('Are you sure you want to delete $!elemType $!elemName?')
    if (!answer.upCase().neq('YES')) then
      return
    endif

  endif

  -- Get drawing template
  DRTMPL
    handle any
      !!alert.error('Cannot access the drawing template that is/owns the element to be deleted')
      return
    endhandle

  -- Drawing template
  if (!elemType.eq('DRTMPL')) then

    if (!delType.eq('CE')) then

      DELETE DRTMPL

    else

      DELETE DRTMPL MEM

    endif

  else

    -- Test for view members delete
    if (!elemType.eq('VIEW') and !delType.eq('MEMBERS')) then

      -- Do not delete the associated libraries
      !delLiby = false

    endif

    -- Delete any associated libraries
    if (!delLiby) then

      var !allLiby coll all (CLLB DLLB RPLB PLLB TRLB SYLB ISOLB LALB SHLB DRTMLB TASKLB) wi (matchWild(name,'*$!elemName*')) for ce
      do !liby val !allLiby

        -- Delete liby
        !!ce = !liby.dbref()
        !libyType = !!ce.type
        DELETE $!libyType

      enddo

    endif

    -- Delete the element/members
    !!ce = !reference
    if (!delType.eq('CE')) then

      DELETE $!elemType

    else

      DELETE $!elemType MEM

    endif

  endif

endfunction
