--
-- File:            abadradefaults.pmlfnc
--   Type:          Function Definition
-- Author:          Tony Martin
-- Created:         31 July 2002
--
-- Description:
-- Loads Standard draft files DRA-PENS DRA-GEN-LINDEF PDMS-COLOURS

----------------------------------------------------------------------------
define function !!abadradefaults(!macfile is string)
----------------------------------------------------------------------------
--

!file = object file(!macfile)
!lines = !file.readfile()
handle any
  !!abalogging.error('Error in loading $!file')
  return
endhandle

!linecount = 0
do !command values !lines
  !linecount = !linecount + 1
  !command.trim()
  if !command.match('#').eq(1) or !command.upcase().match('DEVPEN').gt(0) or !Command.upcase().match('COLOUR CONTROL FILE').gt(0) then
    skip
  else
    $!command
    handle any
     !!abalogging.error('Error in line $!linecount of $!file')
    endhandle
  endif
enddo

endfunction
------------------------------------------------------------------
