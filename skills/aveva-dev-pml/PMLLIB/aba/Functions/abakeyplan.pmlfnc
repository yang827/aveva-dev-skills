--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         03 June 1999
--
--
-- Description:
-- Create a keyplan on the sheet
--
-- Methodology:
-- This method uses an OLAY element at the SHEE.
-- The referenced OVER will have been setup by the Administrator to
-- included any design graphics, and layers that own OUTL elements to
-- represent all of the areas available in the area library.
--
-- There is a function abaBuildKeyplan which automates the creation of
-- the area layers, called via menu option;
--       Create> Area ADP Library...>Keyplan Layers...
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs
--                            1 = Over name
--                            2 = X Position on the page
--                            3 = Y Position on the page
--                            4 = Angle
--                            5 = Scale
--
-- ASSUMPTIONS:
-- That the SHEE is the current element
-- The scaling ratio is 1
------------------------------------------------------------------------
define function !!abaKeyplan(!arguments is array)

  -- Initialise variables
  !sheeRefe = !!ce
  !osrf = !arguments[1]
  !opos = 'X' & !arguments[2] & ' Y' & !arguments[3]
  !oang = !arguments[4]
  !xysc = !arguments[5] & ' ' & !arguments[5]

  -- Check for existing over
  var !exist exist $!osrf
  if (!exist.eq('FALSEA')) then

    !!abalogging.error('      Cannot find OVER $!osrf')
    return

  endif

  -- Get the area idli name
  var !darRef darRef of $!sheeRefe
  !area = !darRef.dbref().flnn

  -- Make overlay name
  !olayName = !sheeRefe.name & '/Keyplan'

  -- Create overlay
  var !exist exist $!olayName
  if (!exist.eq('TRUEA')) then

    !!ce = !olayName.dbref()

  else

    NEW OLAY $!olayName

  endif

  -- Set attributes
  OSRF $!osrf
  OPOS $!opos
  OANG $!oang
  XYSC $!xysc

  -- Set layer visibility
--  !search = '*' & !area & '*'
  var !layers coll all laye wi func eq '$!area' for $!osrf
  if undefined(!layers[1]) then

    !!abalogging.error('      Cannot find layer for area $!area')
    return

  else

    !order = !layers[1].dbref().sequence
    OSLV $!order DESI

  endif

  -- Return to shee
  !!ce = !sheeRefe

endfunction
