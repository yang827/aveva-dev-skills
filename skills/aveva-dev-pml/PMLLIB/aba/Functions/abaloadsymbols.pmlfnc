--
--
-- Description: Load default symbols for this application
--
--------------------------------------------------------------------------------------------------------
define function !!abaLoadSymbols(!fontValue is STRING)

  -- Test for existing
  var !exist exist /Aba/north_arrow
  if (!exist.eq('TRUEA')) then
    return
  endif

  TOLERANCE 0.001

  -- Allow for units
   if (!!isImperialLength('DIST')) then
     if (!fontValue.eq('1')) then
       !file = object file('%PDMSDFLTS%/DRA-ABA-IMPERIAL-SYMBOLS')
     else
       !file = object file('%PDMSDFLTS%/DRA-ABA-IMPERIAL-SYMBOLS-TT')
     endif
   else
     if (!fontValue.eq('1')) then
       !file = object file('%PDMSDFLTS%/DRA-ABA-METRIC-SYMBOLS')
     else
       !file = object file('%PDMSDFLTS%/DRA-ABA-METRIC-SYMBOLS-TT')
     endif
   endif

  -- Load the symbols
  !tasks = !file.readfile()
  do !line val !tasks
    skip if (!line.match('--').neq(0))
    $!line
      handle (64,832)
        -- Native Wigwam fonts cannot be used here
      endhandle
  enddo

endfunction
