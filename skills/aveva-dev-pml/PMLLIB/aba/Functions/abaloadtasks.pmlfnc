--
--
-- Description: Load default tasks for this application
--
--------------------------------------------------------------------------------------------------------
define function !!abaLoadTasks()

  -- Test for existing
  var !exist exist /Aba/AutoNumber
  if (!exist.eq('TRUEA')) then
    return
  endif

  -- Allow for units
   if (!!isImperialLength('DIST')) then
     !file = object file('%PDMSDFLTS%/DRA-ABA-IMPERIAL-TASKS')
   else
     !file = object file('%PDMSDFLTS%/DRA-ABA-METRIC-TASKS')
   endif

   -- Load the tasks
   !tasks = !file.readfile()
   do !line val !tasks
     skip if (!line.match('--').neq(0))
     $!line
   enddo

endfunction
