--   Replaces:
--
-- Author:          Martin Wright
-- Created:         06 July 1999
--
--
-- Description:
--              Supplied with an array from a list gadget, it separates each
-- string from the array into two strings separated at the character supplied.
--

----------------------------------------------------------------------------
define function !!abaMake2Pair(!Input is array,!Separator is string) is array
----------------------------------------------------------------------------
--
-- Method to take an Array (!Input), separated by !separator, and is split the first and second
-- strings, separated at the separator, the second string will be at column +2 characters away from
-- the first string, based on the width of the string. Returns the
-- resultant array.
--
  !sblock = object block('!input[!evalindex].split(!separator)[1]')
  !eblock = object block('!input[!evalindex].split(!separator)[2]')
  !start = !input.evaluate(!sblock)
  !end = !input.evaluate(!eblock)
  !size = !start.width() + 2
  !final = array()
  do !x index !start
      var !line compose |$!start[$!x]| width $!size '$!end[$!x]'
      !start[!x] = !line[1]
  enddo
return !start

--
endfunction
-- End of function definition
