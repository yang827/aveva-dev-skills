--   Replaces:
--
-- Author:          Martin Wright
-- Created:         03 June 1999
--
--
-- Description:
-- Method to take a string variable (!Input), separated by !separator, and is split into two
-- strings, separated at the separator, the second string will be at column !size. Returns the
-- resultant string.
--
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Input string
--    2    R     STRING      separator character
--    3    R     REAL        size in characters of first part of string
--
------------------------------------------------------------------------
--------------------------------------------------------------------------------------------------------
define function !!abaMake2Strings(!Input is string,!Separator is string,!Size is real) is string
--------------------------------------------------------------------------------------------------------
!a = !Input.split(!Separator)
  if (!a[1].length() lt !Size) then
     var !line compose '$!a[1]' width $!size
     !a[1] = !line[1].replace(' ','.')
  else
     !a[1] = !a[1].substring(1,!size)
  endif
 !string = !a[1] & !a[2]
  return !string

endfunction
