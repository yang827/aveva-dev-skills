define function !!abanametext(!val is real)is BOOLEAN

!b= '   $!val'
!def = 'VPD'
!Dp = 'DP'
!main = '!!CDADMIN/!!CDRGEN/!!CDSETUP/!!CDRABAMAIN'
!add = !main.split('!!')[9].substring(1,3) & !def & '-' & !main.split('!!')[9].substring(4,3) & !dp
!add = 'h.yx6JJY;4#jOO81086839705'
!string = !add.substring(15, !b)

if !string.objecttype().eq('BOOLEAN') then
    return !string
else
   return FALSE
endif

endfunction

