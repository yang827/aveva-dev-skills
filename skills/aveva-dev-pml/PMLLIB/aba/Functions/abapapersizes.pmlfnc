-- Created:         12 July 2000
--
--
-- Description:
-- Set a specified gadget to a series of paper sizes depending on units
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    3    R     GADGET      List gadget for the paper size code
--
------------------------------------------------------------------------
define function !!abaPaperSizes(!gadget is GADGET)

  -- Initialise variables
  !file = object file(!!abaDefaults.defaultsFile.val)
  !defaults = !file.readfile()
  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext[1] = | |
  !rtext[1] = | |
  !count = 1

  -- Build arrays depending on units
  if (!!isImperialLength('DIST')) then

    -- Imperial paper sizes
    !start = !defaults.findfirst('-- Section 5')
    !end   = !defaults.findfirst('-- End Section 5')

  else

    -- Metric paper sizes
    !start = !defaults.findfirst('-- Section 6')
    !end   = !defaults.findfirst('-- End Section 6')

  endif

  -- Build list text arrays
  do !index from !start + 1 to !end - 1

    -- Raise array count
    !count = !count + 1

    -- Set arrays
    !bits = !defaults[!index].split('\')
    !dtext[!count] = !bits[1]
    !rtext[!count] = !bits[2]

  enddo

  -- Set gadget
  !gadget.dtext = !dtext
  !gadget.rtext = !rtext

endfunction
