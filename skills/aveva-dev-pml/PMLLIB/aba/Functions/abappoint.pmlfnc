-- File:            abappoint.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         14 May 1999
--
--
-- Description:
-- Test given element for ppoints within the current view
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
--    2    R     DBREF       world
--    3    R     ARRAY       box limits
--
------------------------------------------------------------------------
define function !!abaPpoint(!element is DBREF, !world is DBREF, !boxLimits is ARRAY) is BOOLEAN

  -- Initialise variables
  !inside = false
  !pPoint = 0
  !min = object POSITION ('E' & !boxLimits[1] & ' N' & !boxLimits[2] & ' U' & !boxLimits[3])
  !max = object POSITION ('E' & !boxLimits[4] & ' N' & !boxLimits[5] & ' U' & !boxLimits[6])

  -- Look for ppoints
  !ptre = !element.ptre
    handle (2,201)

       -- No attribute ptre i.e. is a primitive
       !pPointNumbers = ARRAY()
       do !count from 1 to 6
         var !pp pos p$!count of $!element
           handle (2,360)
             break
           endhandle
         !pPointNumbers.append(!count.string())
       enddo

    elsehandle none

      -- Catalogue ppoints
      var !pPointNumbers eval numb for all (PTCA PTAX PTMI) for ptre of $!element
        handle (2,223)
        endhandle

    endhandle

  -- For each ppoint
  do !number val !pPointNumbers

    -- Test for inside the limits box
    !pos = !element.ppos[$!number].wrt(!world)
      handle (2,201)
        break
      endhandle

    !lessThanMin = (!pos.east.lt(!min.east) or !pos.north.lt(!min.north) or !pos.up.lt(!min.up))
    !moreThanMax = (!pos.east.gt(!max.east) or !pos.north.gt(!max.north) or !pos.up.gt(!max.up))

    if (not !lessThanMin and not !moreThanMax) then

      !inside = true
      !pPoint = !number.real()
      break

    endif

  enddo

  -- Test for inside
  if (!inside) then

    ON P$!pPoint of $!element

  endif

  return !inside

endfunction
