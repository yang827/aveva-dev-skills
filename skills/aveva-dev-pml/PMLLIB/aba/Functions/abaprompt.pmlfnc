-- Author:          Martin Wright
-- Created:         03 June 1999
--
--
-- Description: Replaces normal pdms prompt functionality, but has added
--              use for when in batch mode
--              Need the ability to skip over prompt, when in batch mode.
--
--------------------------------------------------------------------------------------------------------
define function !!abaprompt(!string is STRING,!which is REAL)

  prompt |$!string|
  handle (61,115)
  elsehandle NONE
    -- Put in for Batch Mode
   !!abastop.setText(!string,!which)
  endhandle

endFunction
