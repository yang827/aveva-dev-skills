--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         03 June 1999
--
--
-- Description:
-- Sort a passed array and apply the sort to a list gadget
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET       List gadget name
--    2    R     ARRAY        Array to be sorted
--
------------------------------------------------------------------------
define function !!abaSortArray(!gadget is GADGET,!array is ARRAY)

  -- Initialise variables
  !form = !gadget.owner()

  -- Test for zero entries
  if (!gadget.dtext.empty()) then

    !!alert.error('There is nothing to sort')

    if (!form.name().eq('ABAPROCESS')) then
      if (!gadget.name().eq('OLDDRGS')) then
        !form.old = object ABADRAWINGS()
      else
        !form.new = object ABADRAWINGS()
      endif
    else
      !form.drawingList = object ABADRAWINGS()
    endif

    return
  endif

  -- Sort array
  !listOrder = !array.sortedindices()

  -- Apply to dtext
  !dtext = !gadget.dtext.reindex(!listOrder)
  !rtext = !gadget.rtext.reindex(!listOrder)

  -- Set list gadget
  !gadget.clear()
  !gadget.dtext = !dtext
  !gadget.rtext = !rtext

  -- Apply to form ABADRAWINGS object members
  if (!form.name().eq('ABAPROCESS')) then

    if (!gadget.name().eq('OLDDRGS')) then

      !form.old.variant.reindex(!listOrder)
      !form.old.areaRef.reindex(!listOrder)
      !form.old.area.reindex(!listOrder)
      !form.old.name.reindex(!listOrder)
      !form.old.drTmpl.reindex(!listOrder)
      !form.old.tempDesc.reindex(!listOrder)
      !form.old.exists.reindex(!listOrder)
      !form.old.nameType.reindex(!listOrder)
      !form.old.template.reindex(!listOrder)
      !form.old.tempRef.reindex(!listOrder)
      !form.old.areaDesc.reindex(!listOrder)

    else

      !form.new.variant.reindex(!listOrder)
      !form.new.areaRef.reindex(!listOrder)
      !form.new.area.reindex(!listOrder)
      !form.new.name.reindex(!listOrder)
      !form.new.drTmpl.reindex(!listOrder)
      !form.new.tempDesc.reindex(!listOrder)
      !form.new.exists.reindex(!listOrder)
      !form.new.nameType.reindex(!listOrder)
      !form.new.template.reindex(!listOrder)
      !form.new.tempRef.reindex(!listOrder)
      !form.new.areaDesc.reindex(!listOrder)

    endif

    -- Rebuild Process drawing list of ABADRAWING objects to match the sorted array
    !!abaProcess.buildDrawList()

  else

    !form.drawingList.variant.reindex(!listOrder)
    !form.drawingList.areaRef.reindex(!listOrder)
    !form.drawingList.area.reindex(!listOrder)
    !form.drawingList.name.reindex(!listOrder)
    !form.drawingList.drTmpl.reindex(!listOrder)
    !form.drawingList.tempDesc.reindex(!listOrder)
    !form.drawingList.exists.reindex(!listOrder)
    !form.drawingList.nameType.reindex(!listOrder)
    !form.drawingList.template.reindex(!listOrder)
    !form.drawingList.tempRef.reindex(!listOrder)
    !form.drawingList.areaDesc.reindex(!listOrder)

  endif

endfunction
-
