-- File:            abaSortLists
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        <module>
--   Replaces:
--
-- Author:          MPW
-- Created:         22 March 1999 14:00
--
--
-- Description:
--              Takes the Dtext,Rtext of supplied gadget and sorts by either
--              Name or Description, then sets the supplied gadgets Dtext and
--              Rtext to the sorted list directly.
--
------------------------------------------------------------------------

define function !!abaSortLists(!Gadget is GADGET,!Type is STRING)
--
!List = ARRAY()
!Temp = ARRAY()
--
   if (!Type EQ 'ALPH') then
       !list = !Gadget.dtext.sortedindices()
   elseif (!Type EQ 'DESC') then
       do !x values !Gadget.dtext
--
          if (!x.split().size() GT 1) then
              !z = ''
              do !y from 2 to !x.split().size()
              !z = !z & ' ' & (!x.split()[!y])
              enddo
              !Temp.append(!z)
          else
          !Temp.append('Z')
          endif
--
       enddo
          !list = !Temp.sortedindices()
   endif
--
       !dtext = !Gadget.dtext.reindex(!list)
       !rtext = !Gadget.rtext.reindex(!list)
       !Gadget.dtext = !dtext
       !Gadget.rtext = !rtext
--
endfunction
-- End of function definition
