--   Replaces:
--
-- Author:          <mpw>
-- Created:         9 March 1999
--
--
-- Description:
-- Function to control the popping up of the forms involved in the creation
-- and modification of templates, includes drwgs, sheets, views, and other
-- library items, such as Areas, Labelling etc.
--
------------------------------------------------------------------------
define function !!abaTemplate(!Gadget is string,!Type is string)

  -- Preload necessary forms
  if (undefined(!!abaProcess)) then
    pml load form !!abaProcess
  endif

  if (undefined(!!abaDefaults)) then
    pml load form !!abaDefaults
  endif

  if (undefined(!!abaMainForm)) then
    pml load form !!abaMainForm
  endif

  if (undefined(!!abaFileList)) then
    pml load form !!abaFileList
  endif

  if (undefined(!!abaTasks)) then
    pml load form !!abaTasks
  endif

  if (undefined(!!abaArea.mode)) then
    pml load form !!abaArea
  endif

  if (undefined(!!abaUserView.mode)) then
    if (!gadget.eq('AREA') and !type.eq('CREATE')) then
      -- P-41535 Do not open the User View form
    else
      pml load form !!abaUserView
    endif
  endif

  if (undefined(!!abaShTmplList.mode)) then
    pml load form !!abaShTmplList
  endif

--
-- Popup forms that don't have reason for Create/Modify
-- ====================================================
--
   if (!Gadget eq 'NUMBERING') then
       !!namopt.edit()
       !!namOptEdit.formtitle = 'Number Settings'
       pml load form !!namoptrulesedit
       !!namoptrulesedit.formtitle = 'Auto-Numbering Rules'
   endif

   if (!Gadget eq 'FILES') then
       !!abaFileList.mode = TRUE
       !!abaFileList.edit.val = 2
       !!abaFileList.WhereFrom = !Type
       show !!abaFileList centred xr 0.5 yr 0.5
   endif

   if (!Gadget eq 'AREALIB') then
       !!abaAreaLib.mode = !Type
       handle (2,765)
         -- Cannot get member MODE from non-existent object
         pml load form !!abaAreaLib
         !!abaAreaLib.mode = !Type
       endhandle
       show !!abaAreaLib centred xr 0.5 yr 0.5
   endif

   if (!Gadget eq 'AREA') then
       !!abaArea.mode = !Type
       handle (2,765)
         -- Cannot get member MODE from non-existent object
         pml load form !!abaArea
         !!abaArea.mode = !Type
       endhandle
       show !!abaArea centred xr 0.5 yr 0.5
   endif


   if (!Gadget eq 'CLASSIFY') then
       !!abaDiscipline.mode = !Type
       handle (2,765)
         -- Cannot get member MODE from non-existent object
         pml load form !!abaDiscipline
         !!abaDiscipline.mode = !Type
       endhandle
       show !!abaDiscipline centred xr 0.5 yr 0.5
   endif

   if (!Gadget eq 'TASK') then
       !!abaTasks.mode = !Type
       handle (2,765)
         -- Cannot get member MODE from non-existent object
         pml load form !!abaTask
         !!abaTasks.mode = !Type
       endhandle
       show !!abaTasks centred xr 0.5 yr 0.5
   endif

   if (!Gadget eq 'LABELLING') then

       show !!abaTagRules centred xr 0.5 yr 0.5
   endif

-- ===================================================
--                     C R E A T E
-- ===================================================

   if (!Type eq 'CREATE') then
     -- abauserView
     -- ==============
     if (!Gadget eq 'VIEW') then

       -- Test whether the view form is already in create mode
       if (!!abaUserView.mode.eq('MODIFY') and !!abaUserView.deleteView and not !!abaUserView.saved) then
         !!alert.message('Cannot create a new view, until this view has been saved by pressing the Apply button')
         return
       endif

         !!abaUserView.Mode = !Type
       handle (2,765)
         -- Cannot get member MODE from non-existent object
         loadform !!abauserview
         !!abaUserView.Mode = !Type
       endhandle
         !!abaUserView.deleteView = TRUE
-- Check to see if a view can be created here, a) because its the
-- place, and b) = because we are at the correct location in the hierarchy.
            !!abasheetlist.mode = !type
         handle (2,765)
           -- Cannot get member MODE from non-existent object. Form not loaded.
           loadform !!abaSheetList
           !!abasheetlist.mode = !type
         endhandle
            !!abasheetlist.mode = !type

               -- Valid REGI name, continue with view creation.
               view

               handle (2,111)

                 --  Cannot access element type at this level, can't be at view
                 -- Must be at a regi, Put sheet list up.
                 show !!abaSheetList cen xr 0.5 yr 0.2

               elsehandle NONE

                 if (!!abauserview.shown()) then
                     hide !!abauserview
                 endif

                 -- At the right level,must be in a drawing, create view
                 show !!abauserview cen xr 0.5 yr 0.4
                 !!abaUserView.runInit()

               endhandle

     -- abaTemplateDrg
     -- ==============
     elseif (!Gadget eq 'DRAWING') then
         !!abaTemplateDrg.mode = !Type
       handle (2,765)
         -- Cannot get member MODE from non-existent object
         pml load form !!abaTemplateDrg
         !!abaTemplateDrg.mode = !Type
       endhandle
         show !!abaTemplateDrg cen xr 0.5 yr 0.5
--
     endif

-- ===================================================
--                     M O D I F Y
-- ===================================================
  else $* type is 'MODIFY'

     -- Form abaUserView
     if (!Gadget eq 'VIEW') then

       !save = !!ce
       !!abaUserView.Mode = !type
         handle (2,765)
           -- Cannot get member MODE from non-existent object
           loadform !!abauserview
           !!abaUserView.mode = !type
         endhandle

         !!abaViewList.mode = !type

       -- Check to see if user is already at a valid view
       !!abaViewList.formCall = 'VIEW'
       !listOfVews            = !!abaViewlist.setupList()

       if (!listOfVews[1].eq('FAIL')) then
         return
       endif

       if (!!abaViewList.view eq 'ALL') then
         show !!abaViewList centred xr 0.5 yr 0.4
       else
         !!abaViewList.setView(!!abaViewList.view.dbref())
       endif

    -- Form abaTemplateDrg
    elseif (!Gadget eq 'DRAWING') then

      !!abaTemplateDrg.mode = !Type
        handle (2,765)
          -- Cannot get member MODE from non-existent object
          pml load form !!abaTemplateDrg
          !!abaTemplateDrg.mode = !Type
        endhandle

      -- Check to see if user is already at a valid drawing
      DRTMPL
         handle (2,111)
           -- Cannot access element type DRTMPL from the level of REGISTRY
           show !!abaDrawingList centred xr 0.5 yr 0.2

         elsehandle None
          -- Check that the current drawing is one from the graphical reports area.
          var !col coll all DRTMPL for $!!abaDefaults.dlib.val
          !f = !col.find(!!ce.ref.string())
          if !f.size().neq(0) then
              !!abaTemplateDrg.Drtmpl = !!ce
              show !!abaTemplateDrg centred xr 0.5 yr 0.2
          else
              show !!abaDrawingList centred xr 0.5 yr 0.2
          endif
         endhandle

    -- abaTemplateSht
    -- ==============
    elseif (!Gadget eq 'SHEET') then

      -- Load sheet template form
      loadform !!abaTemplateSht
      !!abaTemplateSht.mode = !Type

      -- Test for ce is a template or below
      SHTMPL
        handle (2,111)
          -- Cannot access element type SHTMPL
        endhandle

      if (!!ce.type.upCase().eq('DRTMPL')) then

        -- Test for more than one sheet
        var !sheets coll all shtmpl for ce
        if (!sheets.size().eq(1)) then

          -- Access first and only sheet
          !!ce = !sheets[1].dbref()

          -- Show sheet template form
          !!abaTemplateSht.drTmpl = !!ce.owne
          !!abaTemplateSht.mode = 'MODIFY'
          show !!abaTemplateSht centred xr 0.5 yr 0.3

        else

          -- Load sheet template list form
          !!abaShTmplList.drTmpl = !!ce
          !!abaShTmplList.mode   = 'CE'
          show !!abaShTmplList centred xr 0.5 yr 0.3

        endif

      elseif (!!ce.type.upCase().eq('SHTMPL')) then

        -- Show sheet template form
        !!abaTemplateSht.drTmpl = !!ce.owne
        !!abaTemplateSht.shTmpl = !!ce
        !!abaTemplateSht.mode = 'MODIFY'
        show !!abaTemplateSht centred xr 0.5 yr 0.3

      else

        -- Load sheet template list form
        !!abaShTmplList.mode = 'ALL'
        show !!abaShTmplList centred xr 0.5 yr 0.3

      endif

    endif

  endif

endfunction
-- End of function definition
