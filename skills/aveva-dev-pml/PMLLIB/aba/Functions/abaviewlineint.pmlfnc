-- File:            abaviewlineint.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         15 February 2000
--
--
-- Description:
-- Determine, if any, the intersection between a given line and the view limits
-- Returns a position for an intersection on any view side in 2D coordinate values
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       view limits as REAL values
--    2    R     LINE        line to test for intersect
--
------------------------------------------------------------------------
define function !!abaViewLineInt(!box is ARRAY, !line is LINE) is ARRAY

  -- Initialise variables
  !intersect[1] = true
  !onT = false
  !onB = false
  !onL = false
  !onR = false

  -- Make line object for each view side
  !posTL = object position ('E' & !box[1] & ' N' & !box[5] & ' U' & !box[3])
  !posTR = object position ('E' & !box[4] & ' N' & !box[5] & ' U' & !box[3])
  !posBL = object position ('E' & !box[1] & ' N' & !box[2] & ' U' & !box[3])
  !posBR = object position ('E' & !box[4] & ' N' & !box[2] & ' U' & !box[3])

  !sideT = object line (!posTL,!posTR)
  !sideB = object line (!posBL,!posBR)
  !sideL = object line (!posTL,!posBL)
  !sideR = object line (!posTR,!posBR)

  -- Test for intersection of given line and each side
  !intT = !sideT.intersection(!line)
    handle (2,870)
      !intT = object position()
    endhandle
  !intB = !sideB.intersection(!line)
    handle (2,870)
      !intB = object position()
    endhandle
  !intL = !sideL.intersection(!line)
    handle (2,870)
      !intL = object position()
    endhandle
  !intR = !sideR.intersection(!line)
    handle (2,870)
      !intR = object position()
    endhandle

  -- Test that intersection is on bounded side line
  if (!intT.east.unset().not()) then
    if (!intT.east.geq(!posTL.east) and !intT.east.leq(!posTR.east)) then
      !onT = true
      !intersect[1] = true
      !threeD = !intT.string().before(' WRT')
    endif
  endif
  if (!intB.east.unset().not()) then
    if (!intB.east.geq(!posBL.east) and !intB.east.leq(!posBR.east)) then
      !onB = true
      !intersect[1] = true
      !threeD = !intB.string().before(' WRT')
    endif
  endif
  if (!intL.north.unset().not()) then
    if (!intL.north.geq(!posBL.north) and !intL.north.leq(!posTL.north)) then
      !onL = true
      !intersect[1] = true
      !threeD = !intL.string().before(' WRT')
    endif
  endif
  if (!intR.north.unset().not()) then
    if (!intR.north.geq(!posBR.north) and !intR.north.leq(!posTR.north)) then
      !onR = true
      !intersect[1] = true
      !threeD = !intR.string().before(' WRT')
    endif
  endif

  -- Turn 3D position into 2D
  if (!intersect[1]) then
    var !twoD shpos of $!threeD
    !intersect[2] = !twoD.split()[2].real()
    !intersect[3] = !twoD.split()[4].real()
  endif

  return !intersect

endfunction
