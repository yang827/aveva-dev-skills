--
-- Author:          Steve Wilson
-- Created:         03 June 1999
--
--
-- Description:
-- Provide feedback information about the limits of a new template view
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       View reference
--
------------------------------------------------------------------------
define function !!abaWhat(!viewRefe is DBREF)

  -- Get current distance units
  !units = object COMUNITS(TRUE)

  -- Metric
  if (!!isImperialLength('DIST').not()) then
    !tag = 'mm'

  -- Imperial
  else
    !tag = ''
  endif

  -- Check scale choice is specific
  if (!!abaUserView.scaleChoice.selection('RTEXT').upCase().neq('SPECIFIC')) then
    if (!!abaWhat.shown()) then
      hide !!abaWhat
    endif
    return
  endif

  -- Initialise variables
  !ce = !!ce
  !origScale = !viewRefe.vsca
  !origDir = !!coords.enuDir(!viewRefe.dir.string().before(' WRT'))
  !scale = !!abaUserView.scaleValue.selection('RTEXT')
  !direction = !!coords.enuDir(!!abaUserView.direction.val)

  -- Access view
  !!ce = !viewRefe

  -- Set view scale & direction
  VSCA $!scale
  DIR $!direction

  -- Get limits
  !limits = !viewRefe.vlim
    handle (2,640188)
      !!alert.message('Can only provide information for orthogonal views')
      if (!!abaWhat.shown()) then
        hide !!abaWhat
      endif
      return
    endhandle

  -- Calculate limits
  !ewLimits = !limits[4] - !limits[1]
  !nsLimits = !limits[5] - !limits[2]
  !udLimits = !limits[6] - !limits[3]


  -- Output box size
  !!abaWhat.ew.val = !ewLimits.string(!!distanceFMT) & !tag
  !!abaWhat.ns.val = !nsLimits.string(!!distanceFMT) & !tag
  !!abaWhat.ud.val = !udLimits.string(!!distanceFMT) & !tag

  -- Reset scale & direction
  VSCA $!origScale
  DIR $!origDir

  -- Return to hierarchy position
  !!ce = !ce

  -- Show form
  show !!abaWhat

endmethod
