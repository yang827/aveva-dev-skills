--Macro:   XGDPDRWG                                $Revision: 1.4 $
--Author:  Chris Brown
--
--
--Macro Generic Type: Execution
--
------------------------------------------------------------------------
--
--
--Create/Modify ADP GDP DRWG
--Arguments:
--  1 - CREATE/MODIFY
--Global Arguments:
--Returns:
--
--
define function !!abaxgdpdrwg(!MODE is STRING)

$* validate argument
if (|$!MODE| eq |unset|) then
  return error 1 |Invalid call to macro XGDPDRWG|
endif

if (|$!MODE| eq |CREATE|) then

  var !REF REF
  $* attempt to navigate to DRWG
  DRWG
  handle any
    $* attempt to navigate to REGI
    REGI
    handle any
      -- cannot navigate to REGI from current level
      return error 1 |You must be at REGI level or lower to create a DRWG...|
    endhandle
    var !REF REF
  endhandle

  $* FCREATE will create DRWG
  CALLIBM FCREATE DRWG NO $<SHOW _cdrGDPDRWG AT XR 0 YR 0$> $!REF

$* Modify mode
else

  $* show GDP modification form
  show _cdrGDPDRWG

endif


return $* >>>>>>>>>> End of Code XGDPDRWG <<<<<<<<<<

endfunction
