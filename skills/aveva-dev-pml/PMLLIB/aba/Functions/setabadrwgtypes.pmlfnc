--
-- File:            setabadrwgtypes.pmlfnc
--   Type:          Function Definition
-- Author:          Tony Martin
-- Created:         17 Sept 2001
--
-- Description: Set a list of drawing types according to the template function
--
--
------------------------------------------------------------------------
define function !!setabadrwgtypes(!gad is gadget)
!new = array()
!desc = array()
var !drwgs coll all drtmpl for $!!abadefaults.dlib.val
handle any $* does not exist
 golabel /missed
endhandle
var !functions eval function for all from !drwgs
!functions.unique()
!!banops = !!cdauto
handle any
 !!banops = false
 !!cdauto = false
endhandle
do !a values !functions
  !func = !a.dbref()   $* test if its an old style reference
  handle any
    !desc.append(!a)   $* if its not a reference then add the text
    !new.append(!a)
  elsehandle none
    !desc.append(!func.function)
    handle any
      skip
    endhandle
    !new.append(!func.string())
  endhandle

enddo
-- loop through the list and make sure that there are no duplicates

label /missed
!desc.insert(1,'All')
!new.insert(1,!!abadefaults.dlib.val)
handle any
 !new.insert(1,'unset')
endhandle
!gad.dtext = !desc
!gad.rtext = !new


endfunction
