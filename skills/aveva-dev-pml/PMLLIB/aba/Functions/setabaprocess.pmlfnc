--
-- function to set the abaprocess search types for drawing templates
-- used every time the user selects the aba discipline on the Fsystem form
--
----------------------------------------------------------------------------
define function !!setabaprocess(!abaclass is gadget)

  !!abaprocess.selopt = !abaclass.selection('DTEXT')
  !!abaprocess.selfunc = !abaclass.selection('RTEXT')

endfunction
