define object abaDRAWINGS

member .Name     is array $*
member .refno    is array  $* array of refnos for existing drawings
member .NameType is array
member .Template is array
member .Area     is array
member .TempDesc is array
member .TempRef  is array
member .AreaDesc is array
member .AreaRef  is array
member .Variant  is array
member .DrTmpl   is array
member .Exists   is array
member .DrgTitle is array

endobject

-----------------------------------------------------------------------------
define method .addentry()
-----------------------------------------------------------------------------

!this.name.clear()

!this.nametype.clear()
!this.template.clear()
!this.area.clear()
!this.tempdesc.clear()
!this.tempref.clear()
!this.AreaDesc.clear()
!this.AreaRef.clear()
!this.Exists.clear()
!this.variant.clear()
!this.drTmpl.clear()
!this.DrgTitle.clear()
!this.refno.clear()

endmethod

-----------------------------------------------------------------------------
define method .addentry(!a is string,!b is string,!c is string,!d is string,!e is dbref,!f is string,!g is dbref)
-----------------------------------------------------------------------------

-- As addEntry with ALL arguments, but is used by "NEW DRAWINGS" selection, so drawing
-- number is checked, and added to appropriate list as necessary.
-- The method may seem spurious but is designed to use references and not NAMES
  !func = !e.func

  -- Combine template name and area name as default name.
  -- !combo = !b & |-| & !c.substring(2)
  -- !a = !combo
  -- tm bit
  !combo = !b & |-| & !c.substring(2)
  if (!combo eq !a) then
    !this.NameType.append(|combo|)
  else
    !this.NameType.append(|number|)
  endif
--end of tm bit
  -- Search for all drawings that have used the DRTMPL
  -- Returns string e.g. '/TMPL1-pa15 /TMPL1-pa12'
  var !drgs split tsearch linkRef $!b
  !refno = =0/0
  -- PDMS11.3 Change, Neale Morris, 28/03/2001
  if (defined(!drgs)) then

    -- Drawing exists in some form, check further
    -- Returns string e.g. '/TMPL1'
    var !drtmrf linkRef of $!drgs[1]

    -- Search for all AREAS that been used with above template
    -- Returns array of strings e.g. [1] '=99/1234'  [2] '=99/1235'
    var !allSheets split tsearch darref $!c
    !names = array()

  -- PDMS11.3 Change, Neale Morris, 28/03/2001
  -- 11.3 now return a undefined variable and not array 1 as unset
    if (defined(!allSheets)) then

      do !sheet values !allSheets

        -- Get actual referenced sheet template (SHTMPL) & area (IDLI)
        var !shTmpl linkRef of $!sheet
        var !area darref of $!sheet

        -- Test for the passed combination
        if (!shTmpl.match(!drtmrf).neq(0) and !area.eq(!c)) then

          -- PDMS11.3 Change, Neale Morris, 28/03/2001
          -- 11.3 now return a array variable and not a single string
          -- Get actual drawing using the combination
          var !drg tsearch linkRef $!shTmpl darref $!area
          -- !a = name of owner of $!drg[1]
          var !shTmrf linkRef of $!drg[1]
          !e = !shTmrf.dbref()
          !func = !drg[1].dbref().func
          !exists = TRUE
          !refno = !drg[1].dbref()
          -- Nothing more required as have found the passed combination
          break

        else
          !exists = FALSE
        endif

     enddo

   else
       !exists = FALSE
   endif

  else
     !exists = FALSE
  endif

  -- Add all current entries into object.
  !this.name.append(!a)
  !this.refno.append(!refno)
  !this.template.append(!b)
  !this.area.append(!c)
  !this.tempdesc.append(!d)
  !this.tempref.append(!e)
  !this.AreaDesc.append(!f)
  !this.AreaRef.append(!g)
  !this.exists.append(!exists)
  !this.drTmpl.append(!e.owne)
  !this.DrgTitle.append('no title yet')

  -- Determine variant text
  if (!func.eq('Master')) then
    !this.variant.append('M ')
  else
    !this.variant.append('V' & !func.after('Variant '))
  endif

endmethod

-----------------------------------------------------------------------------
define method .addce(!ce is dbref)
-----------------------------------------------------------------------------
-- As addEntry with ALL arguments, but is used to add current element, or single drawing.
-- Drawing number is checked, and added to appropriate list as necessary.
-- a = Name of entry
-- b = Template name ie: T001
-- c = Area name ie: pa14
-- d = Template description.
-- e = Template reference.
-- f = Area Description.
-- g = Area Reference.

-- Check to see if current element is a valid drwg to add.

   if (!ce.type ne 'DRWG') then
       !!Alert.Warning('Current Element Type is $!ce.type not DRWG')
       return
   else
       !purpose = sppurp of $!ce
       if (!purpose ne 'ABAT') then
           return
       endif
   endif
   !refno = !!ce
   !a = name of $!ce
   var !b linkRef of $!ce
   var !col coll all shee for $!ce
   !sht = !col[1]
     handle (2,752)
       -- Array element 1 does not exist
       !!abaProcess.errorlist.append(name of $!ce)
       return
     endhandle
   var !c darref of $!sht
   var !d title of $!b
     handle (47,15)
       --  CP: Syntax error
       !!abaProcess.errorlist.append(name of $!ce)
       return
     endhandle
   var !shTmrf linkRef of $!sht
   var !e ref of $!shTmrf
   var !f function of $!c
   var !g ref of $!c
   !func = !sht.dbref().func

-- Combine template name and area name as default name.
    !combo = !b & |-| & !c.substring(2)

if (!combo eq !a) then
    !this.NameType.append(|combo|)
else
    !this.NameType.append(|number|)
endif

-- Add all current entries into object.

!this.name.append(!a)
!this.refno.append(!refno)
!this.template.append(!b)
!this.area.append(!c)
!this.tempdesc.append(!d)
!this.tempref.append(!e)
!this.AreaDesc.append(!f)
!this.AreaRef.append(!g)
!this.Exists.append(TRUE)
!this.DrgTitle.append('no title yet')
--!this.drTmpl.append(!e.owne)

  -- Determine variant text
  if (!func.eq('Master')) then
    !this.variant.append('M ')
  else
    !this.variant.append('V' & !func.after('Variant '))
  endif

endmethod
-- method to return an array of data based on the input object
-----------------------------------------------------------------------------
define method .getList(!list is ABADRAWINGS) is array
-----------------------------------------------------------------------------

     -- Initialise variables
     !entries = !list.name.size()
     !w1 = !list.name.width()
     !w2 = !this.template.width()
     !w3 = !this.variant.width()
     !w4 = !this.tempdesc.width()
     !w5 = !this.area.width()
     !w6 = !this.areadesc.width()
     !dtext1 = array()
     !rtext1 = array()
     !dtext2 = array()
     !rtext2 = array()
     !field1 = array()
     !field2 = array()
     !field3 = array()
     !field4 = array()
     !field5 = array()
     !field6 = array()

     do !x from 1 to !entries

       var !line compose |$!this.name[$!x]|      width $!w1 Left spaces 2 $
                         |$!this.template[$!x]|  width $!w2 Left spaces 2 $
                         |$!this.variant[$!x]|   width $!w3 Left spaces 2 $
                         |$!this.tempdesc[$!x]|  width $!w4 Left spaces 2 $
                         |$!this.Area[$!x]|      width $!w5 Left spaces 2 $
                         |$!this.AreaDesc[$!x]|  width $!w6 Left spaces 2

       if (!this.Exists[!x] eq TRUE) then

         -- Add to Existing Drawings List.
         !dtext1.append(!line[1])
         !rtext1.append(!this.tempref[!x] & |,| & !this.arearef[!x] & |,| & !this.name[!x]& |,| & !this.refno[!x])
       else
         -- Add to NON-Existing Drawings List.
         !dtext2.append(!line[1])
         !rtext2.append(!this.tempref[!x] & |,| & !this.arearef[!x] & |,| & !this.name[!x]& |,| & !this.refno[!x])
       endif

     enddo

     !return[1] = !dtext1  $* array of detail text of existing drawings
     !return[2] = !rtext1  $* array of replacement text of existing drawings
     !return[3] = !dtext2  $* array of detail text of new drawings
     !return[4] = !rtext2  $* array of replacement text of new drawings

     return !return

endmethod
