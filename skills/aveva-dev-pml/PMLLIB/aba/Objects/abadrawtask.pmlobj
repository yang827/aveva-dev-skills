define object ABADRAWTASK

  member .Name is STRING
  member .Description is STRING
  member .Execute is STRING
  member .Paramdesc is array
  member .ParamVal is array

endobject

------------------------------------------------------------------------
define method .ABADRAWTASK(!Name is STRING,!Description is STRING,!Execute is STRING)
------------------------------------------------------------------------

  !this.Name = !Name
  !this.Description = !Description
  !this.Execute = !Execute

endmethod

------------------------------------------------------------------------
define method .addparam(!desc is string,!val is string)
------------------------------------------------------------------------

  !this.paramdesc.append(!desc)
  !this.paramval.append(!val)

endmethod
