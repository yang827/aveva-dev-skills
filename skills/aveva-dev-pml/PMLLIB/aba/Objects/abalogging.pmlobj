-- Description:
-- Logging Object controls how info supplied is written to log file, also handles admin functions
-- of opening and closing files.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abalogging()                     -
--  abalogging(string)               -
--  addDrawingList(array)            -
--  addToLog(array)                  -
--  alphaEnd()                       -
--  alphaStart()                     -
--  closeLogFile()                   -
--  error(string)                    -
--  error(string,dbref)              -
--  makeString(string,string)        string
--  openLogFile()                    -
--  prompt(string)                   -
--  prompt(string,real)              -
--  warning(string)                  -
------------------------------------------------------------------------

-- ==================================================
define object abaLogging
-- ==================================================

member .file is string

endobject

-- ====================================
define method .abalogging()
-- ====================================



-- ====================================
endmethod
-- ====================================

-- ====================================
define method .abalogging(!file is string)
-- ====================================

  !!abalogFile = object file(!file)
  !this.file = !file

-- ====================================
endmethod
-- ====================================


-- ====================================
define method .warning(!string is string)
-- ====================================
-- Output alert error when debon flag set to true - online debugging.
--
if (!!debon eq TRUE) then
    !!alert.warning(!string)
endif
handle (2,751)
  -- Variable !!DEBON does not exist
endhandle

-- Add Error String to Logging File
!Entry[1] = !string
!Entry[2] = ' '
!this.addToLog(!Entry)

endmethod

-- ====================================
define method .error(!string is string)
-- ====================================
-- Output alert error when debon flag set to true - online debugging.
--
if (!!debon eq TRUE) then
    !!alert.error(!string)
endif
handle (2,751)
  -- Variable !!DEBON does not exist
endhandle

-- Add Error String to Logging File
!Entry[1] = !string
!Entry[2] = ' '
!this.addToLog(!Entry)

endmethod

-- ==================================================
define method .prompt(!string is string,!Num is real)
-- ==================================================
-- Output prompt message.
--
!!abaprompt(!string,!Num)
handle any
-- Put in for Batch Mode.
endhandle

prompt |$!String|
handle any
-- Put in for Batch Mode.
endhandle

!array[1] = !string
!this.addToLog(!array)

endmethod

-- ====================================
define method .prompt(!string is string)
-- ====================================
-- Output prompt message.
--
prompt |$!String|
  handle any
  -- Put in for Batch Mode
  endhandle
!array[1] = !string
!this.addToLog(!array)

endmethod

-- ==================================================
define method .error(!string is string,!ref is dbref)
-- ==================================================
-- Output alert error when debon flag set to true - online debugging.
--
if (!!debon eq TRUE) then
    !!alert.error(!string)
endif
handle (2,751)
  -- Variable !!DEBON does not exist
endhandle

-- Add Error String to Logging File
!name = name of $!ref
!Entry[1] = !string & ' (' & !name & ') ' & 'Ref ' & !ref
!Entry[2] = ' '
!this.addToLog(!Entry)

endmethod

-- ====================================
define method .alphaStart()
-- ====================================
-- Start to log information given by alpha log info.
--
alpha log /$!!tmpFile over
handle (61,275)
  -- Already using log file - Found in abaFileList Form
  alpha log end
  alpha log /$!!tmpFile over
endhandle
--
endmethod

-- ====================================
define method .alphaEnd()
-- ====================================
-- End Alpha log and add contents to current log file less some unwanted messages

  -- Terminate alpha log
  alpha log end
  handle (61,278)
    -- No log file in use.
    -- Put in for Batch Mode
  endhandle

  -- Read alpha log file
  if (!!BatchMode eq TRUE) then $* no alpha logging done because its in the log file
     -- !file = object file (!!batchParam[2])
     return
  else
      !file = object file (!!tmpFile)
  endif

  !filer = !file.readFile(1000000)

  -- Remove unwanted messages
  !remaining = array()
  !remaining.append('')
  !remaining.append(' Draft run-time warnings:')
  !remaining.append('')
  do !text value !filer

    skip if (!text.eq(''))
    skip if (!text.match('update drawing if necessary').neq(0))
    skip if (!text.match('Updating Design graphics').neq(0))
    skip if (!text.match('the specified point lies outside the VIEW').neq(0))
    skip if (!text.match('Catalogue error').neq(0))
    skip if (!text.match('Owning catalog').neq(0))
    skip if (!text.match('Data not accessible for codeword').neq(0))
    skip if (!text.match('Null text string for this codeword').neq(0))
    !remaining.append(!text.replace('Warning:',''))
  enddo

  -- Add array to log file
  !this.addToLog(!remaining)

endmethod

-- ==================================================
define method .openLogFile()
-- ==================================================
-- Opens log file for this run of processing drawings, could be used for
-- later use when running the same list again.
--
-- Make filename from date & time
   !dt = object datetime()

   if (!dt.minute() lt 10) then
       !minute = '0' & !dt.minute()
   else
       !minute = !dt.minute()
   endif

   !name = 'Aba_' & !dt.date() & '-' & !dt.monthString() & '-' & !dt.year().string().after('20') & '_' $
                  & !dt.hour() & '-' & !minute & '-' & !dt.second()

$(
-- Used for debug purposes, removed this line for release.
 !name = 'debug'
$)
   !this.file = !!abaDefaults.logPath & !!slash & !name & '.log'
$(
   !clear[1] = ''
   !!abalogfile.writefile('overwrite',!clear)
   handle (2,751)
     -- Variable !!ABALOGFILE does not exist
   endhandle
$)
   !!abalogFile = object file(!this.file)
   !fullPath = !!abalogFile.pathName() & !!slash & !!abalogFile.entry()
   handle (41,319)
     -- ERROR - Cannot access file or directory
     loadform !!abafileList
     syscom |!!mkdir $!!abaDefaults.logPath|
     !!abalogFile = object file(!this.file)
   endhandle
            !drawl = array()
            !strng = 'Log File = ' & !fullPath
            !drawl.append('              ' & !this.makeString(!strng,'='))
            !drawl.append('              ' & !strng)
            !drawl.append('              ' & !this.makeString(!strng,'='))
            !drawl.append(' ')
            !this.addtoLog(!drawl)
endmethod

-- ==================================================
define method .closeLogFile()
-- ==================================================
--
         !!abaLogFile.Close()
         handle(2,751)
         endhandle
--
endmethod

-- ==================================================
define method .addToLog(!array is array)
-- ==================================================
--
         !!abaLogFile.WriteFile('APPEND',!array)
         handle(2,751)
         endhandle
--
endmethod

-- ==================================================
define method .addDrawingList(!array is array)
-- ==================================================
--
       !drawl = array()

  do !x values !array
--     !drawl.append(!x.string())
    !template = name of $!x.template
    !area = name of $!x.area
    !tempRefe = !x.template.owner.string()
    !areaRefe     = !x.area.string()
    !drawl.append('Entry for Drawing ' & !x.drwgname & ' (' & !tempRefe & ',' & !areaRefe & ')')
    !drawl.append(' ')
   enddo

      !drawl.append('End of Process List')
      !drawl.append(' ')
      !this.addtoLog(!drawl)
--
endmethod

-- ==================================================
define method .makeString(!Input is string,!char is string) is string
-- ==================================================
-- Returns a string of "chars" to the length of line given in !input
   !length = !input.length()
   var !st compose ' ' width $!length
   !new = !st[1].replace(' ',!char)
   return !new
--
endmethod
