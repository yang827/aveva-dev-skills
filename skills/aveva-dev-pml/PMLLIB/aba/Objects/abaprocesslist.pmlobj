--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaProcessList(STRING,STRING,STRING,STRING,STRING,DBREF,DBREF) -
define object ABAPROCESSLIST

  member .drawingNo   is STRING
  member .template    is STRING
  member .tempDesc    is STRING
  member .area        is STRING
  member .areaDesc    is STRING
  member .tempDb      is DBREF
  member .areaDb      is DBREF

endobject
-- End of object definition for ABAPROCESSLIST

------------------------------------------------------------------------
define method .abaProcessList(!dNo is STRING,!te is STRING,!td is STRING,!aa is STRING,!ad is STRING,!tb is DBREF, !ab is DBREF)
------------------------------------------------------------------------

  !this.drawingNo = !dNo
  !this.template  = !te
  !this.tempDesc  = !td
  !this.area      = !aa
  !this.areaDesc  = !ad
  !this.tempDb    = !tb
  !this.areaDb    = !ab

endmethod
-- End of method definition for  STRING,STRING,STRING,STRING,STRING,DBREF,DBREF
