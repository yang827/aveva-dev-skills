------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaSetTask(DBREF)                -                   Read passed task element
--  abatask(dbref)                   -
--  abatask(string,string,string)    -
--  abatask(string,string,string,dbref) -
--  addparam(string,string,string)   -
--  deleteparam(real)                -
--  getparam()                       array
--  getparam(real)                   array
--  getparamvals()                   array
--  putparam(real,string,string,string) -
define object ABATASK

  member .source      is DBREF
  member .name        is STRING
  member .description is STRING
  member .execute     is STRING
  member .function    is STRING
  member .paramDesc   is ARRAY
  member .paramVal    is ARRAY
  member .purpose     is ARRAY

endobject

------------------------------------------------------------------------
--
-- Method:      .abaSetTask(DBREF)
--
-- Description: Read passed task element
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .abaSetTask(!taskRefe is DBREF)

  -- Store task attribute data
  !this.source      = !taskRefe
  !this.name        = !taskRefe.flnm
  !this.description = !taskRefe.func.split(';')[3]
  !this.execute     = !taskRefe.pmlFunc
  !this.function    = !taskRefe.func

  -- Read task parameters
  VAR !allTkpara COLL ALL TKPARA FOR $!taskRefe

  do !tkpara value !allTkpara

    -- Initialise variables
    !tkParaRefe = !tkpara.dbref()

    -- Store parameter attributes
    !this.paramDesc.append(!tkParaRefe.func)
    !this.paramVal.append(!tkParaRefe.tpvalue)
    !this.purpose.append(!tkParaRefe.sppurp)

  enddo

endmethod
-- End of method definition for .abaSetTask(DBREF)

---------------------------------------------------------------------------------------------------
define method .abatask(!name is string,!description is string,!execute is string,!source is dbref)
---------------------------------------------------------------------------------------------------

  !this.name        = !name
  !this.description = !description
  !this.execute     = !execute
  !this.source      = !source
  !this.function    = !this.name & ';;' & !this.description

endmethod

---------------------------------------------------------------------------------------------------
define method .abatask(!name is string,!description is string,!execute is string)
---------------------------------------------------------------------------------------------------

  !this.name        = !name
  !this.description = !description
  !this.execute     = !execute
  !this.function    = !this.name & ';;' & !this.description

endmethod

-- method for taking an existing dbref and making it an abatask object
---------------------------------------------------------------------------------------------------
define method .abatask(!oldtask is dbref)
---------------------------------------------------------------------------------------------------
   -- fix for converting old task types to new

   if !oldtask.function.match(';;').gt(0) then $* its new format

     if (!oldtask.function.substring(1,1).eq('/')) then
       !this.name        = !oldtask.function.before(';;')
     else
       !this.name        = '/' & !oldtask.function.before(';;')
     endif

     !this.description = !oldtask.function.after(';;')

   else

     !this.name        = '/' & !oldtask.function.split('/')[2]
     !this.description = !oldtask.function.split('/')[3]

   endif

   !this.execute     = !oldtask.PMLfunction
   !this.function    = !this.name.substring(2) & ';;' & !this.description

   var !param coll all tkpara for $!oldtask
   do !z values !param
      !this.paramdesc.append(!z.dbref().function)
      !this.paramval.append (!z.dbref().Tpvalue)
      !this.purpose.append (!z.dbref().sppurp)
   enddo


endmethod
---------------------------------------------------------------------------------------------------

-----------------------------------------------------------------------------
define method .addparam(!desc is string,!val is string,!purp is string)
-----------------------------------------------------------------------------

  !this.paramdesc.append(!desc)
  !this.paramval.append(!val)
  !this.purpose.append(!purp)

endmethod

-----------------------------------------------------------------------------
-----------------------------------------------------------------------------
define method .getparam() is array
-----------------------------------------------------------------------------

  !ret = array()

  do !a index !this.paramdesc
    !ret.append(!this.paramdesc[!a] & ',' & !this.paramval[!a])
  enddo

  return !ret

endmethod

-----------------------------------------------------------------------------


define method .getparamvals() is array
-----------------------------------------------------------------------------

  !ret = array()

  do !a index !this.paramdesc
    !ret.append(!this.paramval[!a])
  enddo

  return !ret

endmethod

-----------------------------------------------------------------------------
define method .getparam(!number is real) is array
-----------------------------------------------------------------------------

  !ret = array()
  !ret[1] = !this.paramdesc[!number]
  !ret[2] = !this.paramval[!number]

  return !ret

endmethod

-----------------------------------------------------------------------------
define method .putparam(!number is real,!desc is string,!val is string,!purp is string)
-----------------------------------------------------------------------------

 !this.paramdesc[!number] = !desc
 !this.paramval[!number] = !val
 !this.purpose[!number] = !purp

endmethod

-----------------------------------------------------------------------------
define method .deleteparam(!number is real)
-----------------------------------------------------------------------------

  -- Delete the passed index for all parameter arrays
  !this.paramdesc.remove(!number)
  !this.paramval.remove(!number)
  !this.purpose.remove(!number)

endmethod
