------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaTaskList()                    -
--  abaTaskList(ABATASK)             -
--  abaTaskList(ARRAY)               -
--  addparam(STRING,STRING,STRING)   -
--  append(ABATASK)                  -
--  applytasks(DBREF)                -
--  clear()                          -
--  copyStanTask(ABATASK)            -
--  deleteTask(STRING)               -
--  deletetask(REAL)                 -
--  getLibraryTasks(STRING)          -                   Get all tasks from the main library
--  getListNames()                   ARRAY               Get the name for all tasks in the list
--  getListRtext()                   array
--  getlistdtext()                   array
--  getparam(REAL)                   ARRAY
--  getparam(STRING)                 ARRAY
--  gettask(STRING)                  ABATASK
--  gettask(real)                    ABATASK
--  gettasklist()                    ARRAY
--  readTempTask(DBREF)              -
--  replacetask(ABATASK,REAL)        -
--  setTaskString(FORM,ABATASKLIST)  -
--  setparameters(STRING,ARRAY)      -
--  validatetask(STRING)             BOOLEAN
--  writeTaskData(ARRAY,STRING)      -
--
------------------------------------------------------------------------
define object ABATASKLIST

   member .task      is ABATASK
   member .taskArray is ARRAY
   member .position  is REAL
   member .paramNum  is REAL

endobject

-----------------------------------------------------------------------------
define method .abaTaskList()

  !this.task     = object ABATASK()
  !this.position = 0
  !this.paramNum = 0

endmethod

-----------------------------------------------------------------------------
define method .abaTaskList(!single is ABATASK)

  !this.task     = !single
  !this.position = 0
  !this.paramNum = 0

endmethod

-----------------------------------------------------------------------------
define method .abaTaskList(!multiple is ARRAY)

  !this.taskArray = !multiple
  !this.position  = 0
  !this.paramNum  = 0

endmethod

-----------------------------------------------------------------------------
define method .clear()

  !this.taskArray.clear()

  !temp      = object ABATASK()
  !this.task = !temp

endmethod

-----------------------------------------------------------------------------
-- Method .addparam
-- adds a parameter to the last member of the taskarray. It is used by the
-- defaults form to build a task from the defaults file
-----------------------------------------------------------------------------
define method .addparam(!desc is STRING, !val is STRING, !purp is STRING)

  !this.task.addParam(!desc, !val, !purp)

  !this.taskArray[!this.taskArray.size()]  = !this.task

endmethod

-----------------------------------------------------------------------------
define method .copyStanTask(!task is ABATASK)

  !this.taskarray.append(!task)

endmethod

-----------------------------------------------------------------------------
-- method .append
-- used to append a task to the taskarray of the current tasklist object
-----------------------------------------------------------------------------
define method .append(!task is ABATASK)

  !this.taskArray.append(!task)

  !this.task = !task

endmethod

-----------------------------------------------------------------------------
-- method .replacetask
-- used to overwrite a task at a set position in the taskarray
-- The position needs to be established by using the gettask method
-----------------------------------------------------------------------------
define method .replacetask(!task is ABATASK, !position is REAL)

  !this.taskArray[!position] = !task

  !this.task     = !task
  !this.position = !position

endmethod

-----------------------------------------------------------------------------
define method .readTempTask(!ref is DBREF)

  if (!ref.type eq 'SHTMPL') then
    !taskpurp = 'ABAS'
  elseif (!ref.Type eq 'SHEE') then
    !taskpurp = 'ABAS'
  elseif (!ref.Type eq 'VIEW') then
    !taskpurp = 'ABAV'
  else
    !taskpurp = 'ABAG'
  endif

  !startRef = !ref

  !!abaPrompt('Collecting Tasks for Current Element Hierarchy',2)

  VAR !layelist COLLECT ALL TASK WITH SPPURP EQ '$!taskpurp' FOR CE

  !count = 0
  !size  = !layelist.size()

  do !x values !layelist

    !count = !count + 1

    !!abaprompt('Dealing with $!count tasks of $!size',2)

    !!ce = !x.dbref()

    VAR !tasklist COLLECT ALL TASK WITH SPPURP EQ '$!taskpurp' FOR CE

    do !y values !tasklist

      -- Takes you to the TASK element
      !task = object ABATASK(!y.dbref())
      !this.taskarray.append(!task)

    enddo

  enddo

  !this.position = 1
  !this.task     = !this.taskarray[1]
   handle(2,752)
   endhandle

  !!ce = !startRef

  !!abaprompt('',2)

endmethod

-----------------------------------------------------------------------------
define method .setparameters(!label is STRING, !param is ARRAY)

  !task                           = !this.getTask(!label)
  !task.paramVal                  = !param
  !this.taskArray[!this.position] = !task
  !this.task                      = !task

endmethod

-----------------------------------------------------------------------------
define method .writeTaskData(!list is ARRAY, !type is STRING)

-- Writes task parameter data to task element under the tasks layer

  if (!type eq 'SHTMPL') then
    !taskpurp = 'ABAS'
    !cmnd = 'SHTMPL'
    !taskaddr = 'STask'
  elseif (!Type eq 'VIEW') then
    !taskpurp = 'ABAV'
    !cmnd = 'LAYER'
    !taskaddr = 'VTask'
  else
    !taskpurp = 'ABAG'
    !cmnd = 'LAYER'
    !taskaddr = 'GTask'
  endif

  -- String will either be SHEET or VIEW depending on current tasks
  -- Collect all existing "tasks" and delete them
  VAR !exist COLLECT ALL TASK WITH SPPURP EQ '$!taskpurp' FOR CE

  do !x value !exist
    !!ce = !x.dbref()
    DELETE TASK
  enddo

  do !number index !list

    if(!this.validatetask(!list[!number]))then

      -- Build object
      !taskObj = !this.getTask(!list[!number])
        handle 678
          skip
        endhandle

      -- Get into correct hierarchy position
      $!cmnd

      -- Make name
      if (!type.upCase().eq('SHTMPL')) then
        !taskName = !!ce.name & '/' & !taskAddr & !number
      else
        !taskName = !!ce.owner.name & '/' & !taskAddr & !number
      endif

      NEW TASK $!taskName
      SpPURP $!taskpurp

      -- !function = !taskobj.name & '/' & !taskobj.description
      FUNCTION |$!taskobj.function|
      PMLFunction |$!taskobj.execute|

      do !count index !taskobj.paramVal
        NEW TKPARA tpvalue |$!taskobj.paramVal[$!count]|
        FUNCTION |$!taskobj.paramDesc[$!count]|
        SpPURP $!taskobj.purpose[$!count]
      enddo

    endif

  enddo

  if (!type eq 'SHTMPL') then
    SHTMPL
  else
    VIEW
  endif

endmethod

-----------------------------------------------------------------------------
define method .setTaskString(!form is FORM, !taskObj is ABATASKLIST)

-- Reads data from the view task modification form and sets the parameters
-- Writes back to temporary object

  -- Initialise variables
  !array = array()

  -- Build array of form parameters
  do !count from 1 to !taskObj.task.paramDesc.size()

    -- Form gadget value extract string
    !gadgetValue = !form.name() & '.a' & !count & '.val'

    -- Allow for units
    if (!taskObj.task.purpose[!count].eq('DSTNCE')) then

      !value = !!$!gadgetValue
      !array.append(!value.string().real(!!distanceFMT).string('D6'))

    elseif (!taskObj.task.purpose[!count].eq('REAL')) then

      !value = !!$!gadgetValue
      !array.append(!value.string())

    else
      !array.append(!!$!gadgetValue)
    endif

  enddo

  -- Set the object parameters
  !this.setParameters(!form.formtitle, !array)

endmethod

-----------------------------------------------------------------------------
define method .gettask(!label is STRING) is ABATASK

  do !x index !this.taskarray

    if (!this.taskarray[!x].name eq !label) then

      !this.position = !x
      !this.task     = !this.taskarray[!x]

      return !this.taskarray[!x]

    endif

 enddo

 return error 678 'Cannot match Task to current list - press cancel and reload application'

endmethod

-----------------------------------------------------------------------------
define method .gettask(!number is real) is ABATASK

   if(defined(!this.taskarray[!number]))then
     !this.position = !number
     !this.task = !this.taskarray[!number]
     return !this.taskarray[!number]
   else
     !!alert.error('The template contains tasks that do not exist in the library. Please contact your System Administrator')
     return
   endif

endmethod

-----------------------------------------------------------------------------
define method .gettasklist() is ARRAY

  !array = ARRAY()

  do !x values !this.taskarray
    !array.append(!x.function)
  enddo

  return !array

endmethod

-----------------------------------------------------------------------------
define method .validatetask(!label is STRING) is BOOLEAN

  do !x values !this.taskarray

    if(!x.name eq !label)then

      return true

    endif

  enddo

  return false

endmethod

-----------------------------------------------------------------------------
define method .deleteTask(!label is STRING)

  !x = !this.getTask(!label)

  !this.deleteTask(!this.position)

endmethod

-----------------------------------------------------------------------------
define method .deletetask(!number is REAL)

  !this.taskarray[!number].delete()

  !this.taskArray.compress()

endmethod

-----------------------------------------------------------------------------
define method .getparam(!label is STRING) is ARRAY

  !array    = ARRAY()
  !task     = !this.getTask(!label)
  !array[1] = !task.paramDesc
  !array[2] = !task.paramVal

  return !array

endmethod

-----------------------------------------------------------------------------
define method .getparam(!number is REAL) is ARRAY

  !array    = ARRAY()
  !task     = !this.getTask(!number)
  !array[1] = !task.paramDesc
  !array[2] = !task.paramVal

  return !array

endmethod

---------------------------------------------------------------------------------
define method .applytasks(!elem is DBREF)

  -- Method to get tasks from passed level and apply the actions
  -- Get the tasks
  !view = !elem
  !!abaPrompt('Read tasks from ' & !elem.type,2)
  !this.readtemptask(!elem)
  if(!this.taskarray.size() eq 0) then
    !!abaLogging.error('    No tasks defined for this ' & !elem.type, !elem)
    return
  endif

  !units = object COMUNITS(TRUE)
  do !x values !this.taskarray

   !testForInterrupt = !!FMSYS.interrupt()
      handle any
      elsehandle NONE
        if (!!FMSYS.INTERRUPT()) then
          break
        endif
      endhandle

  !desc[1] = |    Executing function '| & !x.execute & |' for task '| & !x.name & |'|
  !updatestart = object datetime()
  !desc[2] = |Starting at $!updatestart|
  !!abaLogging.addToLog(!desc)
      !!abaPrompt('Executing $!x.execute (task $!x.name)',2)
      !!ce = !view
      !fname = '!!' & !x.execute
      onerror continue
      $!fname(!x.paramval)
      handle any
        !!abaLogging.error('      Error in executing function $!x.execute for task $!x.name')
      endhandle
      !units.restoreSavedBoreDist()
      onerror return
   enddo

endmethod

-----------------------------------------------------------------------------
define method .getlistdtext() is array

  !viewdtext = array()
   do !x values !this.taskarray
      if !x.description.unset() then
         !x.description = ' '
      endif
      !viewdtext.append(!x.name.after('/') & '  ' & !x.description)
   enddo

   !return = !viewdtext

   return !return

endmethod

-----------------------------------------------------------------------------
define method .getListRtext() is array
!viewrtext = array()

    do !x values !this.taskarray
      !viewrtext.append(!x.name)
    enddo
    return !viewrtext

endmethod

------------------------------------------------------------------------
--
-- Method:      .getListNames()
--
-- Description: Get the name for all tasks in the list
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       The Function String
--
-------------------------------------------------------------
define method .getListNames() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- For each task in the list
  do !taskObj values !this.taskArray
    !array.append(!taskObj.name.upcase())
  enddo

  -- Return
  return !array

endmethod
-- End of method definition for .getListNames()

------------------------------------------------------------------------
--
-- Method:      .getLibraryTasks(STRING)
--
-- Description: Get all tasks from the main library
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Task type VIEW, PROCESS, DRAWING, NAMING
--
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------
define method .getLibraryTasks(!type is STRING)

  -- Test for the main task library
  VAR !exists EXISTS $!!abaDefaults.task.val
  if (!exists.eq('FALSEA')) then
    return
  endif

  -- Get all tasks of a particular type
  if (!type.eq('VIEW')) then
    VAR !allTasks COLL ALL TASK WI SPPURP EQ 'ABAV' FOR $!!abaDefaults.task.val
  elseif (!type.eq('PROCESS')) then
    VAR !allTasks COLL ALL TASK WI SPPURP EQ 'ABAG' FOR $!!abaDefaults.task.val
  elseif (!type.eq('DRAWING')) then
    VAR !allTasks COLL ALL TASK WI SPPURP EQ 'ABAS' FOR $!!abaDefaults.task.val
  else
    VAR !allTasks COLL ALL TASK WI SPPURP EQ 'ABAN' FOR $!!abaDefaults.task.val
  endif

  -- Extract task data
  do !task value !allTasks
    !taskObj = object ABATASK()
    !taskObj.abaSetTask(!task.dbref())
    !this.taskArray.append(!taskObj)
  enddo

endmethod
-- End of method definition for .getLibraryTasks(STRING)
