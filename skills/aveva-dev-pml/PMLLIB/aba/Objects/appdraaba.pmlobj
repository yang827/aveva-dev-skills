--
------------------------------------------------------------------------
define method .graphMenu()

  !menu = object APPMENU('mbGraphics')

  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

endmethod
-- End of method definition for .graphMenu()

-----------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryMenu()

  !menu = object APPMENU('mbQuery')

  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

endmethod
-- End of method definition for .queryMenu()

-----------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()

  !menu = object APPMENU('mbSettings')

  !menu.add('SEPARATOR')

  !menu.add('FORM', |General ADP Defaults...|, 'cdrADPDFLTS', 'GeneralADPDefaults')

  if !!cdauto then
     !menu.add('CALLBACK', |Area Based ADP Defaults...|, |show !!abaDefaults centred xr .5 yr .5|, 'AreaBasedADPDefaults')
  endif

  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

endmethod
-- End of method definition for .settingsMenu()

-----------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()

  !menu = object APPMENU('mbUtils')

  !menu.add('SEPARATOR')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |General ADP Toolbars|, 'GDPTOOLS', 'GeneralADPToolbars')

  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

endmethod
-- End of method definition for .utilsMenu()

-----------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()

  frame .abaToolbar toolbar 'ABA Toolbar'
    option .abaClass 'ABA Discipline ' at xmin ymin+0.1 call '!!setAbaProcess(!this.abaClass)'width 19
  exit

  !applications[1] = 'ADPCORE'
  !applications[2] = 'LIBMABA'

  !!appTbarCntrl.addToolbar('abaToolbar', !applications)

endmethod
-- End of method definition for .toolbars()

-----------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()

  !menu = object APPMENU('MBCREATE')
  !menu.add('MENU', |Copy|, 'MBCOPY', 'Copy')
  !menu.add('CALLBACK', |Layer...|, |CALLIBM FCREATE LAYE NO $<$>|, 'Layer')
  !menu.add('CALLBACK', |Note...|, |CALLDRG XCRNOTE|, 'Note')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Department...|, |CALLDRG XDEPT CREATE|, 'Department')
  !menu.add('CALLBACK', |Registry...|, |CALLDRG XREGI CREATE|, 'Registry')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |General ADP|, 'ADPCREATE', 'GeneralADP')
  if !!cdauto then
     !menu.add('CALLBACK', |Area ADP Drawings...|, |loadform !!abaProcess !!abaProcess.init()|, 'AreaADPDrawings')
  endif
  !menu.add('FORM', |Hanger & Support Drawings...|, 'CDRBATSUB', 'HangerSupportDrawings')
  !menu.add('CALLBACK', |Steelwork Detailing...|, |show !!adpsteel|, 'SteelworkDetailing')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  !menu = object APPMENU('GDPTOOLS')
  !menu.add('CALLBACK', |Dimensioning...|, |CALLDRD INITSHOW _cdrGDPDMTOOL|, 'Dimensioning')
  !menu.add('CALLBACK', |Labelling...|, |CALLDRS INITSHOW _cdrGDPLBTOOL|, 'Labelling')
  !menu.add('FORM', |Equipment Centres...|, 'cdrGDPEQTOOL', 'EquipmentCentres')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  !menu = object APPMENU('ADPCREATE')
  !menu.add('CALLBACK', |Drawing...|, |CALLADPG XGDPDRWG CREATE|, 'Drawing')
  !menu.add('CALLBACK', |Sheet...|, |CALLADPG XGDPSHEET CREATE|, 'Sheet')
  !menu.add('CALLBACK', |View...|, |CALLADPG XGDPVIEW CREATE|, 'View')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  !menu = object APPMENU('MBCOPY')
  !menu.add('CALLBACK', |CE...|, |var !!CDCOPYTYPE 'CE'
  show _CDRTLCOPY|, 'CE')
  !menu.add('CALLBACK', |Identified...|, |var !!CDCOPYTYPE 'Identify'
  show _CDRTLCOPY|, 'Identified')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Drawing...|, |var !!CDCOPYTYPE 'DRWG'
  show _CDRTLCOPY|, 'Drawing')
  !menu.add('CALLBACK', |Sheet...|, |var !!CDCOPYTYPE 'SHEE'
  show _CDRTLCOPY|, 'Sheet')
  !menu.add('CALLBACK', |Sheet Note...|, |var !!CDCOPYTYPE 'NOTE'
  show _CDRTLCOPY|, 'SheetNote')
  !menu.add('CALLBACK', |View...|, |var !!CDCOPYTYPE 'VIEW'
  show _CDRTLCOPY|, 'View')
  !menu.add('CALLBACK', |Layer...|, |var !!CDCOPYTYPE 'LAYE'
  show _CDRTLCOPY|, 'Layer')
  !menu.add('CALLBACK', |Layer Note...|, |var !!CDCOPYTYPE 'VNOT'
  show _CDRTLCOPY|, 'LayerNote')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  !menu = object APPMENU('MBMODIFY')
  !menu.add('FORM', |Name...|, 'CDRNAME', 'Name')
  !menu.add('MENU', |Layer|, 'MBMLAYER', 'Layer')
  !menu.add('MENU', |Note|, 'MBMNOTE', 'Note')
  !menu.add('MENU', |Hierarchy|, 'MBHIERARCHY', 'Hierarchy')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Department...|, 'CDRDEPTATT', 'Department')
  !menu.add('FORM', |Registry...|, 'CDRREGIATT', 'Registry')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |General ADP|, 'ADPMODIFY', 'GeneralADP')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  !menu = object APPMENU('ADPMODIFY')
  !menu.add('CALLBACK', |Drawing...|, |CALLADPG XGDPDRWG MODIFY|, 'Drawing')
  !menu.add('CALLBACK', |Sheet...|, |CALLADPG XGDPSHEET MODIFY|, 'Sheet')
  !menu.add('CALLBACK', |View...|, |CALLADPG XGDPVIEW MODIFY|, 'View')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  !menu = object APPMENU('UPDATE')
  !menu.add('FORM', |General ADP Views...|, 'cdrBATUPDT', 'GeneralADPViews')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  !menu = object APPMENU('MBMLAYER')
  !menu.add('FORM', |Definition...|, 'CDRLAYER', 'Definition')
  !menu.add('CALLBACK', |Attributes...|, |CALLDRG XLAYATT NOFORM|, 'Attributes')
  !menu.add('FORM', |Members...|, 'CDRLAYMEM', 'Members')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  !menu = object APPMENU('MBMNOTE')
  !menu.add('CALLBACK', |Sheet...|, |CALLDRG XMNOTE MODIFY NOTE SHEET|, 'Sheet')
  !menu.add('CALLBACK', |Layer...|, |CALLDRG XMNOTE MODIFY VNOT LAYE|, 'Layer')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  !menu = object APPMENU('MBHIERARCHY')
  !menu.add('FORM', |Reorder...|, 'CDRREORDER', 'Reorder')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  !menu = object APPMENU('MBDELETE')
  !menu.add('CALLBACK', |CE|, |CALLDRG MDELCE|, 'CE')
  !menu.add('CALLBACK', |Members|, |CALLDRG MDELMEM|, 'Members')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Owner|, |OWNER
  CALLDRG MDELCE|, 'Owner')
  !menu.add('CALLBACK', |Owner Members|, |OWNER
  CALLDRG MDELMEM|, 'OwnerMembers')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  !menu = object APPMENU('viewMenu')
  !menu.add('CALLBACK', 'Existing Area ADP Drawings...', |!tmp = array() !!abaprocess.browse(!tmp,'NONE')|, 'ExistingDrawings')
  !menu.add('CALLBACK', 'Stored Area ADP LogFiles...', |!!abaTemplate('FILES','BAR')|, 'StoredLogFiles')
--  !menu.add('CALLBACK', 'Show Version...', |!!abaProcess.ShowVersion()|, 'ShowVersion')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

endmethod
-- End of method definition for .menus()

-----------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()

  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.menus()

endmethod
-----------------------------------------------------------------------------------
-- End of method definition for .modifyMenus()
