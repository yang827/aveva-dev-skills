--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  barMenu()                        -
--  displayMenu()                    -
--  graphMenu()                      -
--  menus()                          -
--  modifyForm()                     -
--  modifyMenus()                    -
--  queryMenu()                      -
--  settingsMenu()                   -
--  toolbars()                       -
--  utilsMenu()                      -
--
------------------------------------------------------------------------
define object APPDRAABA

endobject
-- End of object definition for appDraAba

-----------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()

  !this.toolbars()

endmethod
-- End of method definition for .modifyForm()

-----------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()

  !bmenu = object APPBARMENU()

  !bmenu.add(|Create|, 'MBCREATE')
  !bmenu.add(|Modify|, 'MBMODIFY')
  !bmenu.add(|Delete|, 'MBDELETE')

  if !!cdauto then
    !bmenu.add(|Browse|, 'viewMenu')
  endif

  !bmenu.add(|Update|, 'UPDATE')

  !!appMenuCntrl.addBarMenu(!bmenu, 'ADPCORE')

endmethod
-- End of method definition for .barMenu()

-----------------------------------------------------------------------
--
-- Method:      .displayMenu()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayMenu()

  !menu = object APPMENU('mbDisplay')

  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

endmethod
-- End of method definition for .displayMenu()

-----------------------------------------------------------------------
--
-- Method:      .graphMenu()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
