define object APPDRALIBMABA

endobject

-------------------------------------------------------------------------------
define method .APPDRALIBMABA()

  !!cdauto =  !!abanametext( 1 )

endmethod

-------------------------------------------------------------------------------
define method .modifyForm()

  !this.toolbars()

endmethod

-------------------------------------------------------------------------------
define method .barMenu()

  !bmenu = object APPBARMENU()

  !bmenu.add(|Create|, 'MBCREATE')
  !bmenu.add(|Modify|, 'MBMODIFY')
  !bmenu.add(|Delete|, 'MBDELETE')
  !bmenu.add(|Browse|, 'viewMenu')

  !!appMenuCntrl.addBarMenu(!bmenu, 'ADPCORE' )
  !!appMenuCntrl.addBarMenu(!bmenu, 'LIBMABA' )

endmethod

-------------------------------------------------------------------------------
define method .displayMenu()

  !menu = object APPMENU('mbDisplay')

  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

endmethod

-------------------------------------------------------------------------------
define method .graphMenu()

  !menu = object APPMENU('mbGraphics')

  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

endmethod

-------------------------------------------------------------------------------
define method .queryMenu()

  !menu = object APPMENU('mbQuery')

  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

endmethod

-----------------------------------------------------------------------------------
define method .settingsMenu()

  !menu = object APPMENU('mbSettings')

  !menu.add('SEPARATOR')

  if !!cdauto then
     !menu.add('CALLBACK', |Area Based ADP Defaults...|, |show !!abaDefaults centred xr .5 yr .5|, 'AreaBasedADPDefaults')
  endif

  !!appMenuCntrl.addMenu(!menu, 'LIBMABA' )
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE' )

endmethod

-----------------------------------------------------------------------------------
define method .utilsMenu()

  !menu = object APPMENU('mbUtils')

  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

endmethod


-------------------------------------------------------------------------------
define method .toolbars()

  frame .libmabaToolbar toolbar 'ABA Toolbar'
    option .ABAclass 'ABA Discipline ' at xmin ymin+0.1 call '!!setabaprocess(!this.abaclass)'width 19
  exit

  !applications[1] = 'ADPCORE'
  !applications[2] = 'LIBMABA'

  !!appTbarCntrl.addToolbar('libmabaToolbar', !applications )

endmethod

-------------------------------------------------------------------------------
define method .menus()

  !menu = object APPMENU('MBCREATE')

  !menu.add('MENU', |Note|, 'MBCNOTE', 'Note')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Library...|, |CALLIBM FCREATE LIBY NO|, 'Library')
  !menu.add('CALLBACK', |Sheet Library...|, |CALLIBM FCREATE SHLB NO $<show _CDRSHLB$>|, 'SheetLibrary')
  !menu.add('CALLBACK', |Backing Sheet...|, |CALLIBM FCREATE BACK NO $<show _CDRBSHEE$>|, 'BackingSheet')
  !menu.add('CALLBACK', |Overlay Sheet...|, |CALLIBM FCREATE OVER NO $<show _CDROSHEE$>|, 'OverlaySheet')
  !menu.add('MENU', |View|, 'MBVIEW', 'View')

  if !!cdauto then
    !menu.add('SEPARATOR')
    !menu.add('CALLBACK', |Area ADP Drawings...|, |loadform !!abaProcess !!abaProcess.init()|, 'AreaADPDrawings')
  endif

  !!appMenuCntrl.addMenu(!menu, 'ADPCORE' )
  !menu.add('MENU', |Area ADP Library|, 'ABACREATE', 'AreaADPLibrary')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA' )

  !menu = object APPMENU('MBCNOTE')
  !menu.add('CALLBACK', |Back/Over/ShtTmpl...|, |CALLDRG XMNOTE CREATE NOTE BACK OVER SHTMPL|, 'BackOverShtTmpl')
  !menu.add('CALLBACK', |Layer...|, |CALLDRG XMNOTE CREATE VNOT LAYE|, 'Layer')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('MBVIEW')
  !menu.add('CALLBACK', |Limits-defined...|, |CALLDRG XVIEW CREATE ORTHO|, 'Limitsdefined')
  !menu.add('CALLBACK', |User Defined...|, |CALLDRG XVIEW CREATE USER|, 'UserDefined')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('ABACREATE')
  !menu.add('CALLBACK', |Area Library... |, |!!abatemplate('AREALIB','MODIFY')|, 'AreaLibrary')
  !menu.add('CALLBACK', |Area...|, |!!abatemplate('AREA','CREATE')|, 'Area')
  !menu.add('CALLBACK', |Classification...|, |!!abatemplate('CLASSIFY','CREATE')|, 'Classification')
  !menu.add('CALLBACK', |Task...|, |!!abatemplate('TASK','CREATE')|, 'Task')
  !menu.add('CALLBACK', |Labelling...|, |!!abatemplate('LABELLING','CREATE')|, 'Labelling')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Template Drawing...|, |!!abatemplate('DRAWING','CREATE')|, 'TemplateDrawing')
  !menu.add('CALLBACK', |Template View...|, |!!abatemplate('VIEW','CREATE')|, 'TemplateView')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Keyplan Layers...|, |show !!abaBuildKeyplan|, 'KeyplanLayers')
  !menu.add('CALLBACK', |Auto-Number Rules|, |!!abatemplate('NUMBERING','EDIT')|, 'AutoNumberRules')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('MBMODIFY')
  !menu.add('FORM', |Name...|, 'CDRNAME', 'Name')
  !menu.add('MENU', |Note|, 'MBMNOTE', 'Note')
  !menu.add('MENU', |Hierarchy|, 'MBHIERARCHY', 'Hierarchy')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Library...|, 'CDRLIBATT', 'Library')
  !menu.add('MENU', |Sheet Library|, 'MBSHLB', 'SheetLibrary')
  !menu.add('MENU', |Backing Sheet|, 'MBBSHEE', 'BackingSheet')
  !menu.add('MENU', |Overlay Sheet|, 'MBOSHEE', 'OverlaySheet')
  !menu.add('MENU', |View|, 'MBMVIEW', 'View')
  if !!cdauto then
    !menu.add('SEPARATOR')
    !menu.add('MENU', |Area ADP Library|, 'ABAMODIFY', 'AreaADPLibrary')
  endif
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('MBMNOTE')
  !menu.add('CALLBACK', |Back/Over/ShtTmpl...|, |CALLDRG XMNOTE MODIFY NOTE BACK OVER SHTMPL|, 'BackOverShtTmpl')
  !menu.add('CALLBACK', |Layer...|, |CALLDRG XMNOTE MODIFY VNOT LAYE|, 'Layer')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('MBSHLB')
  !menu.add('FORM', |Definition...|, 'CDRSHLB', 'Definition')
  !menu.add('FORM', |Attributes...|, 'CDRSHLBAT', 'Attributes')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('MBBSHEE')
  !menu.add('FORM', |Definition...|, 'CDRBSHEE', 'Definition')
  !menu.add('FORM', |Attributes...|, 'CDRBSHEEAT', 'Attributes')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('MBOSHEE')
  !menu.add('FORM', |Definition...|, 'CDROSHEE', 'Definition')
  !menu.add('FORM', |Attributes...|, 'CDROSHEEAT', 'Attributes')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('MBMVIEW')
  !menu.add('CALLBACK', |Limits-defined...|, |CALLDRG XVIEW MODIFY ORTHO|, 'Limitsdefined')
  !menu.add('CALLBACK', |User Defined...|, |CALLDRG XVIEW MODIFY USER|, 'UserDefined')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('ABAMODIFY')
  !menu.add('CALLBACK', |Area Library... |, |!!abatemplate('AREALIB','MODIFY')|, 'AreaLibrary')
  !menu.add('CALLBACK', |Area...|, |!!abatemplate('AREA','MODIFY')|, 'Area')
  !menu.add('CALLBACK', |Classification...|, |!!abatemplate('CLASSIFY','MODIFY')|, 'Classification')
  !menu.add('CALLBACK', |Task...|, |!!abatemplate('TASK','MODIFY')|, 'Task')
  !menu.add('CALLBACK', |Labelling...|, |!!abatemplate('LABELLING','MODIFY')|, 'Labelling')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Template Drawing...|, |!!abatemplate('DRAWING','MODIFY')|, 'TemplateDrawing')
  !menu.add('CALLBACK', |Template Sheet...|, |!!abatemplate('SHEET','MODIFY')|, 'TemplateSheet')
  !menu.add('CALLBACK', |Template View...|, |!!abatemplate('VIEW','MODIFY')|, 'TemplateView')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Auto-Number Rules|, |!!namopt.edit()
  !!namOptEdit.formtitle = 'Number Settings'
  pml load form !!namoptrulesedit
  !!namoptrulesedit.formtitle = 'Auto-Numbering Rules'|, 'AutoNumberRules')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('MBHIERARCHY')
  !menu.add('FORM', |Reorder...|, 'CDRREORDER', 'Reorder')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('MBDELETE')
  !menu.add('CALLBACK', |CE|, |CALLDRG MDELCE|, 'CE')
  !menu.add('CALLBACK', |Members|, |CALLDRG MDELMEM|, 'Members')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Owner|, |OWNER
  CALLDRG MDELCE|, 'Owner')
  !menu.add('CALLBACK', |Owner Members|, |OWNER
  CALLDRG MDELMEM|, 'OwnerMembers')
  !menu.add('SEPARATOR')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Group Members|, |CALLDRG XDELETEN|, 'GroupMembers')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA')

  !menu = object APPMENU('viewMenu')
  !menu.add('CALLBACK', 'Existing Area ADP Drawings...', |!tmp = array() !!abaprocess.browse(!tmp,'NONE')|, 'ExistingDrawings')
  !menu.add('CALLBACK', 'Stored Area ADP LogFiles...', |!!abaTemplate('FILES','BAR')|, 'StoredLogFiles')
--  !menu.add('CALLBACK', 'Show Version...', |!!abaProcess.ShowVersion()|, 'ShowVersion')
  !!appMenuCntrl.addMenu(!menu, 'LIBMABA' )
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE' )

endmethod

-------------------------------------------------------------------------------
define method .modifyMenus()

   if !!cdauto.not() then
    return
   endif

  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.menus()

endmethod
