-- Author:          Tony Martin
-- Created:         Date 11 March 2002 Time 11:16
-- function to return a name for a drawing
-- Parameters
-- Param 1 is the template dbref
-- Param 2 is the area dbref
-- param 3 is the Drawing prefix
-- param 4 is the Drawing sequence start
-- param 5 is the Drawing Suffix
-- param 6 is the delimiter between the bits
-- params 1 and 2 are inserted automatically by ABA
-- This task simply tests to see if the drawing name has been used already
-- if it comes across an unused drawing number it gets used
-- Note: there is a special method inside the aba newdrawings form which
--       checks the drawing name against the list of drawings to be created
--       as well ast those which exist in PDMS
--       This should be used if you are building a list of numbers
--       it is called by !test = !!acanewdrwgs.checkname(!namestring)
--       if the name does not exist in the list or PDMS then the method returns 0
--       If it exists in PDMS, it returns 1
--       if it exist in the list to be built, it returns 2
------------------------------------------------------------------------------
-- Revision 0 28-03-2002
------------------------------------------------------------------------------
define function !!SetDrawingName(!params is array)is string

  !namestring = ''
  !template = !params[1].dbref().flnn
  !area = !params[2].dbref().flnn
  !prefix = !params[3]
  if !prefix.match('/').neq(1) then
    !prefix = '/' & !prefix
  endif
  !sequence = !params[4].real()
  !suffix = !params[5]
  !delimiter = !params[6]
  -- if there is no suffix then get rid of the extra delimiter
  if !suffix eq '' then
    !final = ''
  else
    !final = !delimiter & !suffix
  endif
  do !num from !Sequence to !sequence + 5000
    !namestring = !prefix  & !delimiter & !num & !final
    -- check to see if the name exists in the DB or in the list
    if !!abanewdrwgs.checkname(!namestring) eq 0 then
       return !namestring
       break
    endif
  enddo

endfunction
