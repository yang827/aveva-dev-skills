setup form !!abaArrange blocking

  title |Choose options|
  init |!this.init()|
  !this.quitcall = |!this.closed()|


-- Define Members/Selection Areas
-- ------------------------------

  frame .options | Options | at x0

    path right

    para .sides at x1 y1.5 text |Sides:|
    button .left  at xmax+5 ymin      pixmap height 16 width 16 call |!this.side('left',!this.left)|
    button .up    at xmax   ymin-0.4  pixmap height 16 width 16 call |!this.side('up',!this.up)|
    button .down  at xmin   ymax      pixmap height 16 width 16 call |!this.side('down',!this.down)|
    button .right at xmax   ymin.left pixmap height 16 width 16 call |!this.side('right',!this.right)|

    para .margint at xmin.sides ymax+0.75 text |Margin:|
    text .margin at xmax.margint-1 ymin.margint width 6 is REAL format !!distanceFMT
--    para .marginmm at xmax.margin+0.1 text |mm|

    para .gapt at xmin.sides ymax+0.75 text |Min Gap between labels:|
    text .gap at xmax.gapt-5 ymin.gapt width 6 is real format !!distanceFMT
--    para .gapmm at xmax.gap+0.1 text |mm|

  exit

-- Feedback view
-- -------------
  view .feedback at xmax.options+0.5 y0.2 AREA
    height 7 aspect 1
    setcolour 15
    cursor nocursor
    borders off
  exit

-- Action buttons
-- --------------

  path right
  button .ok     | Apply | at x0 ymax.options+0.25 call |!this.apply()| ok
  button .cancel |Dismiss| at xmax.options-10.5 call |!this.closed()| cancel

  -- Pixmaps
  !this.up.addPixmap(!!PML.getPathName('viewusideoff.png'))
  !this.down.addPixmap(!!PML.getPathName('viewdsideoff.png'))
  !this.left.addPixmap(!!PML.getPathName('viewlsideoff.png'))
  !this.right.addPixmap(!!PML.getPathName('viewrsideoff.png'))

  -- Members
  member .feedbackDept is DBREF
  member .feedbackName is STRING
  member .taskName     is STRING
  member .task         is ABATASK
  member .form         is FORM

  -- Set feedback name
  !this.feedbackName = '/Aba/abaArrange/feedback'

-- End of form definition
exit

--------------------------------------------------------------------
define method .init()
--------------------------------------------------------------------
-- Called when form is shown

   -- Initialise variables
   !ce = !!ce

   -- Get first site
   SW
   !siteRefe = site 1 of world
   SW

   -- Create feedback drawing
   var !exist exist $!this.feedbackName/dept
   if (!exist.eq('FALSEA')) then

     NEW DEPT $!this.feedbackName/dept
     !this.feedbackDept = !!ce

     NEW REGI $!this.feedbackName/regi

     NEW DRWG $!this.feedbackName/drwg

     NEW SHEE $!this.feedbackName
      SIZE 100 100

     --set the drawing type
     !!setmarptype(!!ce, 32)

     NEW NOTE
     NEW RECT
       XLEN 50  YLEN 50  NLSTYLE Solid NLCOLOUR Orange
       ORIGIN CENTRE X50 Y50

     NEW RECT
       XLEN 60  YLEN 60  NLSTYLE Dashed NLCOLOUR Red

     NEW VIEW
      SIZE 50 50
      FRA OFF

     NEW LAYE
     NEW LDIM
      DPOS X77 Y75  DIR N

      NEW DPOI
       POS E27 N30 U0  OSHT 0
      NEW DPOI
       POS E26 N25 U0  DTOF 12 -9  DMTX 'MARGIN'  DTCH 5

     NEW LAYE $!this.feedbackName/up
      CHEI 3  LSHA AV  GBOX 0  ALIG HB  JUST L LLSTYLE Solid LLCOLOUR Green LFSTYLE Solid LFCOLOUR Green
      if (!this.task.paramval[1].upCase().neq('ON')) then
        LVIS FALSE
      endif

     NEW GLAB BTEX '       ' on $!siteRefe
       AT X33 Y80  ADEG 90  BPOF -17 29.99
     NEW GLAB COPY PREV BY X17  BPOF 0 29.99
     NEW GLAB COPY PREV BY X17  BPOF 17 29.99

     NEW LAYE $!this.feedbackName/down
      CHEI 3  LSHA AV  GBOX 0  ALIG HB  JUST R  LLSTYLE Solid LLCOLOUR Green LFSTYLE Solid LFCOLOUR Green
      if (!this.task.paramval[2].upCase().neq('ON')) then
        LVIS FALSE
      endif

     NEW GLAB BTEX '       ' on $!siteRefe
       AT X33 Y20  ADEG 90  BPOF -17 -29.99
     NEW GLAB COPY PREV BY X17  BPOF 0 -29.99
     NEW GLAB COPY PREV BY X17  BPOF 17 -29.99

     NEW LAYE $!this.feedbackName/left
      CHEI 3  LSHA AH  GBOX 0  ALIG HB  JUST R  LLSTYLE Solid LLCOLOUR Green LFSTYLE Solid LFCOLOUR Green
      if (!this.task.paramval[3].upCase().neq('ON')) then
        LVIS FALSE
      endif

     NEW GLAB BTEX '       ' on $!siteRefe
       AT X20 Y33  ADEG 0  BPOF -29.99 -17
     NEW GLAB COPY PREV BY Y17  BPOF 0 29.99
     NEW GLAB COPY PREV BY Y17  BPOF -29.99 17

     NEW LAYE $!this.feedbackName/right
      CHEI 3  LSHA AH  GBOX 0  ALIG HB  JUST L  LLSTYLE Solid LLCOLOUR Green LFSTYLE Solid LFCOLOUR Green
      if (!this.task.paramval[4].upCase().neq('ON')) then
        LVIS FALSE
      endif

     NEW GLAB BTEX '       ' on $!siteRefe
       AT X80 Y33  ADEG 0  BPOF 29.99 -17
     NEW GLAB COPY PREV BY Y17  BPOF 0 29.99
     NEW GLAB COPY PREV BY Y17  BPOF 29.99 17

   else

     -- Attempt to delete existing dept
     !dept = !this.feedbackName & '/dept'
     !this.feedbackDept = !dept.dbref()

   endif

   -- Add sheet to view
   edit view !!abaArrange.feedback AREA put $!this.feedbackName

   -- Read and store task name
   !this.taskname = !this.task.name

   -- Set side defaults
   !this.up.val    = false
   !this.down.val  = false
   !this.left.val  = false
   !this.right.val = false
   if (!this.task.paramVal[1].boolean()) then
     !this.up.addPixmap(!!PML.getPathName('viewusideon.png'))
     !this.up.val = true
   endif
   if (!this.task.paramVal[2].boolean()) then
     !this.down.addPixmap(!!PML.getPathName('viewdsideon.png'))
     !this.down.val = true
   endif
   if (!this.task.paramVal[3].boolean()) then
     !this.left.addPixmap(!!PML.getPathName('viewlsideon.png'))
     !this.left.val = true
   endif
   if (!this.task.paramVal[4].boolean()) then
     !this.right.addPixmap(!!PML.getPathName('viewrsideon.png'))
     !this.right.val = true
   endif

   -- Distance defaults
   !this.margin.val = !this.task.paramval[5].real(!!distanceFMT)
     handle any
       !this.margin.val = !this.task.paramval[5]
     endhandle

   !this.gap.val = !this.task.paramval[6].real(!!distanceFMT)
     handle any
       !this.gap.val = !this.task.paramval[6]
     endhandle

   -- Set form title
   !this.formTitle = !this.taskName

   -- Return to hierarchy position
   !!ce = !ce

endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------
-- Called when apply is pressed

   -- Initialise variables
   !ce = !!ce

   -- Build parameters array
   !parameters[1] = 'Off'
   !parameters[2] = 'Off'
   !parameters[3] = 'Off'
   !parameters[4] = 'Off'
   if (!this.up.val) then
     !parameters[1] = 'On'
   endif
   if (!this.down.val) then
     !parameters[2] = 'On'
   endif
   if (!this.left.val) then
     !parameters[3] = 'On'
   endif
   if (!this.right.val) then
     !parameters[4] = 'On'
   endif

   -- Distance parameters
   !parameters[5] = !this.margin.val
   !parameters[6] = !this.gap.val

   -- Reset the task object
   !this.task.paramVal = !parameters

   -- Transfer the modified task back to the calling form
   !this.form.receiveTask(!this.task)

   -- Delete feedback drawing
   !this.closed()

   -- Return to hierarchy position
   !!ce = !ce
     handle (2,822)
     endhandle

   -- Set calling form apply button active
   !this.form.apply.active = true

endmethod

--------------------------------------------------------------------
define method .closed()
--------------------------------------------------------------------
-- Called when form is closed

   -- Initialise variables
   !ce = !!ce

   -- Check for feedback drawing
   if (not !this.feedbackDept.badref()) then
     !!ce = !this.feedbackDept
     delete DEPT
       handle any
       endhandle

   endif

   -- Hide this form
   !this.hide()

   -- Return to hierarchy position
   !!ce = !ce
     handle (2,822)
     endhandle

endmethod

--------------------------------------------------------------------
define method .side(!which is string, !gadget is gadget)
--------------------------------------------------------------------
-- Called when a side toggle is pressed

  -- Initialise variables
  !ce       = !!ce
  !laye     = !this.feedbackName & '/' & !which
  !layeRefe = !laye.dbref()

  -- Access laye
  !!ce = !layeRefe

  -- Set layer visibility
  if (!gadget.val) then

     -- Set layer visibility on
     LVIS TRUE

     -- Switch gadget on
     if (!which.eq('up')) then
       !this.up.addPixmap(!!PML.getPathName('viewusideon.png'))
       !this.up.val = true
     elseif (!which.eq('down')) then
       !this.down.addPixmap(!!PML.getPathName('viewdsideon.png'))
       !this.down.val = true
     elseif (!which.eq('left')) then
       !this.left.addPixmap(!!PML.getPathName('viewlsideon.png'))
       !this.left.val = true
     else
       !this.right.addPixmap(!!PML.getPathName('viewrsideon.png'))
       !this.right.val = true
     endif

   else

     -- Set layer visibility off
     LVIS FALSE

     -- Switch gadget off
     if (!which.eq('up')) then
       !this.up.addPixmap(!!PML.getPathName('viewusideoff.png'))
       !this.up.val = false
     elseif (!which.eq('down')) then
       !this.down.addPixmap(!!PML.getPathName('viewdsideoff.png'))
       !this.down.val = false
     elseif (!which.eq('left')) then
       !this.left.addPixmap(!!PML.getPathName('viewlsideoff.png'))
       !this.left.val = false
     else
       !this.right.addPixmap(!!PML.getPathName('viewrsideoff.png'))
       !this.right.val = false
     endif

   endif


   -- Refresh view
   REFRESH !!abaArrange.feedback

   -- Return to hierarchy position
   !!ce = !ce

endmethod
