--
-- File:            abahyperplant.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         02 September 1999
--
--
-- Description:
-- Create hyperplant files for the processed drawings
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs
--                           1 = Output pathname (directory)
--
--    2    R     ARRAY       Array of ABADRAWING objects
--
------------------------------------------------------------------------
define function !!abaHyperPlant(!arguments is ARRAY, !drawingList is ARRAY)

  -- Initialise variables
  !ceRefe = !!ce
  !outDir = !arguments[1]
  !sheetsFile = '\pdms_dsheet.out'
  !itemsFile = '\pdms_item_to_dsheet.out'
  !worldRefe = /*
  !deLim = '~'
  !sheetsData = ARRAY()
  !itemsData = ARRAY()

  -- Test for existing output directory
  !directory = object file(!outDir)
  if (!directory.exists().not()) then

    -- Error in output directory
    !!abalogging.error('      Output directory does not exist')
    return

  endif

  -- Test for evar used in pathname
  if (!outDir.match('%').neq(0)) then
    !pathName = !outDir.replace('%','/%',1,1)
  else
    !pathName = !outDir
  endif

  -- Cycle though the produced drawings
  do !drawing val !drawingList

    -- Get all sheets for this drwg
    var !allShee append coll all shee for $!drawing.drwg

  enddo

  -- Process each shee
  do !index ind !allShee

    -- Initialise variables
    !plotFile = '/dra' & !index & '.plt'
    !hitFile = '/dra' & !index & '.hit'
    !hitData = ARRAY()

    -- Get sheet data
    !sheeRefe = !allShee[!index].dbref()
    !sheeName = !sheeRefe.flnm
    !sheeTitle = !sheeRefe.titl

    -- Create the plotfile
    PLOT $!sheeRefe $!pathName$!plotFile OVER
      handle any

        -- Error with shee element
        !!abalogging.error('      Cannot generate the plotfile for sheet $!sheeName')
        return

      endhandle

    -- Get all tag layers
    var !allLaye coll all laye wi (matchwild(attrib SpPURP,'*TAG*')) for $!sheeRefe
    do !laye val !allLaye

      -- Access laye so can use draft commands to extract 2d positions
      !!ce = !laye.dbref()

      -- Get all tag labels
      var !allTag coll all (slab glab) for $!laye

      -- Get label data
      do !tag val !allTag

        -- Initialise variables
        !tagRefe = !tag.dbref()
        !ddnm = !tagRefe.ddnm
        !ddnmType = !ddnm.type.upCase()

        -- For a label with a valid ddnm
        if (!ddnm.badref().not()) then

          -- Get tag position wrt sheet
          if (!tagRefe.oset) then

            -- Get sheet position as a combination of ddnm position and label offset
            var !shPos split SHPO of $!ddnm
            !xPos = !shPos[2].real() + !tagRefe.xypo.east
            !yPos = !shPos[4].real() + !tagRefe.xypo.north

          else

            -- Get sheet position of label
            !xPos = !tagRefe.xypo.east
            !yPos = !tagRefe.xypo.north

          endif

          -- Test ddnm elements for valid hyperplant elements
          if (!ddnm.owne.type.upCase().eq('BRAN') or !ddnmType.eq('BRAN') or !ddnmType.eq('PIPE') $
              or !ddnmType.eq('EQUI') or !ddnmType.eq('ZONE') or !ddnmType.eq('SITE')) then

            -- This is a item which should be in HyperPlant db
            !refeString = !ddnm.string()
            !hitData.append(!xPos & ' ' & !yPos & ' ' & !ddnm.string() & | '| & !ddnm.flnm & |'|)

          elseif (!ddnm.owne.type.upCase().eq('EQUI')) then

            -- Get equi as design element
            !refeString = !ddnm.owne.string()
            !hitData.append(!xPos & ' ' & !yPos & ' ' & !ddnm.owne.string() & | '| & !ddnm.owne.flnm & |'|)

          elseif (!ddnm.owne.type.upCase().eq('SUBE')) then

            -- Get equi as design element
            !refeString = !ddnm.owne.owne.string()
            !hitData.append(!xPos & ' ' & !yPos & ' ' & !ddnm.owne.owne.string() & | '| & !ddnm.owne.owne.flnm & |'|)

          endif

          -- Add to array holding which item on this sheet
          !itemsData.append(!refeString & !deLim & !index & !deLim)


        endif
      enddo

    enddo

    -- Create the hit file
    !outFile = object file(!outDir & !hitFile)
    !outFile.writeFile('OVERWRITE',!hitData)
    !outFile.close()

    -- Add to array the sheet data
    !sheetsData.append(!index & !deLim & !sheeName & !deLim & !sheeTitle & !deLim & !plotFile & !deLim & !hitFile & !deLim)

  enddo

  -- Create the sheets file
  !outFile = object file(!outDir & !sheetsFile)
  !outFile.writeFile('OVERWRITE',!sheetsData)
  !outFile.close()

  -- Create the items file
  !outFile = object file(!outDir & !itemsFile)
  !outFile.writeFile('OVERWRITE',!itemsData)
  !outFile.close()

  -- Return to the original hierarchal position
  !!ce = !ceRefe

endfunction
