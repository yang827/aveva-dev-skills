-- File:            abameasure.pmlfnc
--   Type:          Function Definition
--   Group:         draft
--     Keyword:     ABA
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         03 June 1999
--
--
-- Description:
-- Add ruler marks to the limits of the view
--
-------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs
--                            1 = Spacing between marks, in mm
--                            2 = Intermediate spacings, in mm
--                            3 = Length of main mark lines, in mm
--                            4 = Line Style
--                            5 = Line Colour
--
-- ASSUMPTIONS:
-- That the VIEW is the current element
--
-------------------------------------------------------------------------
define function !!abaMeasure(!arguments is array)

  -- Initialise variables
  !viewRefe   = !!ce
  !viewDir    = !viewRefe.dir.string().before(' WRT')
  !mainSpace  = !arguments[1].real()
  !inSpace    = !arguments[2].real()
  !mainLength = !arguments[3].real()
  !nlStyle    = !arguments[4]
  !nlColour   = !arguments[5]

  -- Set intermediate length
  !intLength = !mainLength / 2

  -- Check for no intermediates
  if (!inSpace.eq(0)) then
    !inSpace = !mainSpace
  endif

  -- Calculate number of intermediates per main space
  !numbInt = !mainSpace / !inSpace

  -- Test for non-orthogonal views
  if (!viewDir.length().gt(1)) then
    !!abaLogging.error('      Cannot put measure lines around non-orthogonal views')
    return
  endif

  -- Get area limits
  !abaView = object ABAVIEW()
  !abaView.abaview(!viewRefe.idln,!viewRefe)
  !minPos = !abaView.startpos
  !maxPos = !abaview.endpos

  -- Calculate sides limits depending on view direction
  if (!viewRefe.dir.east.eq(1) or !viewRefe.dir.east.eq(-1)) then
    !xMin = !minPos.north
    !xMax = !maxPos.north
    !yMin = !minPos.up
    !yMax = !maxPos.up
    !originX = !viewRefe.thpo.north
    !originY = !viewRefe.thpo.up
  elseif (!viewRefe.dir.north.eq(1) or !viewRefe.dir.north.eq(-1)) then
    !xMin = !minPos.east
    !xMax = !maxPos.east
    !yMin = !minPos.up
    !yMax = !maxPos.up
    !originX = !viewRefe.thpo.east
    !originY = !viewRefe.thpo.up
  else
    !xMin = !minPos.east
    !xMax = !maxPos.east
    !yMin = !minPos.north
    !yMax = !maxPos.north
    !originX = !viewRefe.thpo.east
    !originY = !viewRefe.thpo.north
  endif

  -- Get into position in hierarchy by finding any existing layer
  var !measLaye coll all laye wi SpPURP eq 'MEAS' for $!viewRefe
  if (!measLaye.empty()) then

    -- Create the laye
    !!ce = !viewrefe
    !layeName = !viewRefe.flnm & '/Measure'
    NEW LAYE $!layeName
    SpPURP MEAS  PURP ADSM

  else

    -- Access the existing laye and delete all existing elements
    !!ce = !measLaye[1].dbref()
    delete LAYE MEM

  endif
  !layeRefe = !!ce

  -- Make vnote name and create
  !vnotName = !viewRefe.flnm & '/MeasureLine'
  NEW VNOT $!vnotName
   BLNK FALSE

  -- Build a rectangle to represent the view limits
  if (not !viewRefe.lfra) then

    NEW RECT
      ORIGIN CENTRE  NLSTYLE $!nlStyle NLCOLOUR $!nlColour
      XLEN $!viewRefe.size[1]  YLEN $!viewRefe.size[2]

  endif

  -- Calculate start and end coordinates for both x and y axis
  !xMainStart = (int(!xMin / !mainSpace) * !mainSpace)
  if (!xMainStart.lt(!xMin)) then
    !xMainStart = !xMainStart + !mainSpace
  endif

  !xIntStart = (int(!xMin / !inSpace) * !inSpace)
  !xIntEnd = (int(!xMax / !inSpace) * !inSpace)
  if (!xIntStart.lt(!xMin)) then
    !xIntStart = !xIntStart + !inSpace
  endif
  if (!xIntEnd.gt(!xMax)) then
    !xIntEnd = !xIntEnd - !inSpace
  endif

  !yMainStart = (int(!yMin / !mainSpace) * !mainSpace)
  if (!yMainStart.lt(!yMin)) then
    !yMainStart = !yMainStart + !mainSpace
  endif

  !yIntStart = (int(!yMin / !inSpace) * !inSpace)
  !yIntEnd = (int(!yMax / !inSpace) * !inSpace)
  if (!yIntStart.lt(!yMin)) then
    !yIntStart = !yIntStart + !inSpace
  endif
  if (!yIntEnd.gt(!yMax)) then
    !yIntEnd = !yIntEnd - !inSpace
  endif

  -- Build lines
  !count = 0
  do !coord from !xIntStart to !xIntEnd by !inSpace

    -- Raise count for main coordinate
    !count = !count + 1
    if (!coord.eq (!xMainStart) or !count.eq(!numbInt.int())) then
      !length = !mainLength
      !count = 0
    else
      !length = !intLength
    endif

    -- Top side
    NEW STRA
     if (!viewRefe.dir.east.eq(1) or !viewRefe.dir.east.eq(-1)) then
       FPT E 0 N $!coord U $!yMax
     elseif (!viewRefe.dir.north.eq(1) or !viewRefe.dir.north.eq(-1)) then
       FPT E $!coord N 0  U $!yMax
     elseif (!viewRefe.dir.up.eq(1) or !viewRefe.dir.up.eq(-1)) then
       FPT E $!coord N $!yMax U 0
     endif
     if (!viewRefe.dir.east.eq(1) or !viewRefe.dir.north.eq(-1) or !viewRefe.dir.up.eq(1)) then
       !adeg = -90
     else
       !adeg = 90
     endif
     LENGTH $!length  ADEG $!adeg  NLSTYLE $!nlStyle NLCOLOUR $!nlColour

    -- Bottom side
    NEW STRA
     if (!viewRefe.dir.east.eq(1) or !viewRefe.dir.east.eq(-1)) then
       FPT E 0 N $!coord U $!yMin
     elseif (!viewRefe.dir.north.eq(1) or !viewRefe.dir.north.eq(-1)) then
       FPT E $!coord N 0  U $!yMin
     elseif (!viewRefe.dir.up.eq(1) or !viewRefe.dir.up.eq(-1)) then
       FPT E $!coord N $!yMin U 0
     endif
     if (!viewRefe.dir.east.eq(1) or !viewRefe.dir.north.eq(-1) or !viewRefe.dir.up.eq(1)) then
       !adeg = 90
     else
       !adeg = -90
     endif
     LENGTH $!length  ADEG $!adeg  NLSTYLE $!nlStyle NLCOLOUR $!nlColour

  enddo

  !count = 0
  do !coord from !yIntStart to !yIntEnd by !inSpace

    -- Raise count for main coordinate
    !count = !count + 1
    if (!coord.eq (!yMainStart) or !count.eq(!numbInt.int())) then
      !length = !mainLength
      !count = 0
    else
      !length = !intLength
    endif

    -- Left side
    NEW STRA
     if (!viewRefe.dir.east.eq(1) or !viewRefe.dir.east.eq(-1)) then
       FPT E 0 N $!xMin U $!coord
     elseif (!viewRefe.dir.north.eq(1) or !viewRefe.dir.north.eq(-1)) then
       FPT E $!xMin N 0 U $!coord
     elseif (!viewRefe.dir.up.eq(1) or !viewRefe.dir.up.eq(-1)) then
       FPT E $!xMin N $!coord  U 0
     endif
     if (!viewRefe.dir.east.eq(1) or !viewRefe.dir.north.eq(-1) or !viewRefe.dir.up.eq(1)) then
       !adeg = 0
     else
       !adeg = 180
     endif
     LENGTH $!length  ADEG $!adeg  NLSTYLE $!nlStyle NLCOLOUR $!nlColour



    -- Right side
    NEW STRA
     if (!viewRefe.dir.east.eq(1) or !viewRefe.dir.east.eq(-1)) then
       FPT E 0 N $!xMax U $!coord
     elseif (!viewRefe.dir.north.eq(1) or !viewRefe.dir.north.eq(-1)) then
       FPT E $!xMax N 0 U $!coord
     elseif (!viewRefe.dir.up.eq(1) or !viewRefe.dir.up.eq(-1)) then
       FPT E $!xMax N $!coord  U 0
     endif
     if (!viewRefe.dir.east.eq(1) or !viewRefe.dir.north.eq(-1) or !viewRefe.dir.up.eq(1)) then
       !adeg = 180
     else
       !adeg = 0
     endif
     LENGTH $!length  ADEG $!adeg  NLSTYLE $!nlStyle NLCOLOUR $!nlColour

  enddo

  -- Return to view
  !!ce = !viewRefe

endfunction
