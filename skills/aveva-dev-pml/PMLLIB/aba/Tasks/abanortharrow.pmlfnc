--     Keyword:     ABA
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         10 June 1999
--
--
-- Description:
-- Create a north arrow to indicate view north direction on page

-- METHODOLOGY:
-- Currently only added to orthogonal views
--
-- If a reserved area is present then the symbol is placed at the centre.
-- A reserved area is a RECT element under a view VNOT with LVIS false
-- Otherwise, the symbol is placed at the view top-left corner
--
-------------------------------------------------------------------------
--
-- ASSUMPTIONS:
-- That the VIEW is the current element
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     REAL       Scale Factor
--
--
-------------------------------------------------------------------------
define function !!abaNorthArrow(!Parameters is ARRAY)

  -- Initialise variables
  !viewRefe = !!ce
  !sheeRefe = !viewRefe.owne
  !drwgRefe = !viewRefe.owne.owne
  !adeg     = !viewRefe.adeg
  var !viewDir append viewdir U
  var !viewDir append viewdir D
  var !viewDir append viewdir L
  var !viewDir append viewdir R
  !add = false
  !Scale = !Parameters[1]

  -- Get symbol template from defaults file section 3
  if (!!BatchMode EQ TRUE) then
      !file = object FILE(!!BatchParam[1])
  else
      !file = object FILE(!!abaDefaults.DefaultsFile.val)
  endif

  !defaultText = !file.readfile()
  !start = !defaultText.findfirst('-- Section 3') + 1
  !end   = !defaultText.findfirst('-- End Section 3')
  !range = !end - !start
  !lines = !defaultText.from(!start,!range)
  !symbNames = ARRAY()
  do !string val !lines
    skip if (!string.match('--').neq(0))
    !symbNames.append(!string)
  enddo
  !template = !symbNames[5]

  -- Look for the 3D world North direction
  do !index ind !viewDir

    if (!viewDir[!index].eq('N')) then

      -- Set to add arrow
      !add = true
      skip

    endif

  enddo

  -- Look for isometric views
  if (not !add) then

    -- Get view directions
    !vUp = !viewRefe.dir.up
    !vEast = !viewRefe.dir.east
    !vNorth = !viewRefe.dir.north

    -- Isometric
    if (!vUp.lt(0) and !vEast.lt(0) and !vNorth.lt(0)) then

      -- Set to add isometric arrow
      !add = true
      !template = !template & 'Iso1'

    elseif (!vUp.lt(0) and !vEast.lt(0) and !vNorth.gt(0)) then

      -- Set to add isometric arrow
      !add = true
      !template = !template & 'Iso2'

    elseif (!vUp.lt(0) and !vEast.gt(0) and !vNorth.gt(0)) then

      -- Set to add isometric arrow
      !add = true
      !template = !template & 'Iso3'

    elseif (!vUp.lt(0) and !vEast.gt(0) and !vNorth.lt(0)) then

      -- Set to add isometric arrow
      !add = true
      !template = !template & 'Iso4'

    endif

  endif

  -- Add arrow
  if (!add) then

    -- Get view reserved area
    var !rect coll all rect wi (matchwild(attrib name,('*n_arrow*'))) for $!viewRefe
    if (!rect.empty()) then

      -- Calculate a default position at view top-left corner
      !topLeftX = !viewRefe.xypo.east - !viewRefe.size[1] / 2
      !topLeftY = !viewRefe.xypo.north + !viewRefe.size[2] / 2
      !rectPos = object position ('E' & !topLeftX & ' N' & !topLeftY & ' U0')

      -- Inform that a default position has been used
      !!abaLogging.error('      No north arrow reserved area found - default position used')

    else

      !rectPos = !rect[1].dbref().ptrf.xypo

    endif

    -- Get into position in hierarchy by finding any existing layer
    var !narrLaye coll all laye wi SpPURP eq 'NARR' for $!viewRefe
    if (!narrLaye.empty()) then

      -- Create the laye
      !!ce = !viewRefe
      !layeName = !viewRefe.flnm & '/NorthArrow'
      NEW LAYE $!layeName
      SpPURP NARR  PURP ADSN

    else

      -- Access the existing laye and delete all existing elements
      !!ce = !narrLaye[1].dbref()
      DELETE LAYE MEM

    endif

    -- Make vnote name and create symbol
    !vnotName = !viewRefe.flnm & '/NArrSymbol'
    NEW VNOT $!vnotName

    -- Calculate position on page wrt view
    !origin = 'X' & !rectPos.east & ' Y' & !rectPos.north

    -- Create the symbol
    NEW SYMB

     TMRF $!template
     ADEG $!adeg
     ORIGIN $!origin
     XYSCALE $!Scale $!Scale

  else

    !!abalogging.error('Cannot create a north arrow since the view direction is unsuitable')

  endif

endfunction
