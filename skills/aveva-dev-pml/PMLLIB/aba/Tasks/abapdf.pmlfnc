--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 June 1999
--
--
-- Description:
-- Create a pdf formatted file of all sheets
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs
--                            1 = Output file destination pathname
--
--    2    R     ARRAY       Array of sheets DBREF
--
------------------------------------------------------------------------
define function !!abaPdf(!arguments is ARRAY, !sheetList is ARRAY)

  -- Initialise variables
  !outputFolder = object FILE(!arguments[1])
  !dateTime     = object DATETIME()

  -- Get folder path name
  !folderPath = !outputFolder.fullName()

  -- Ensure that the destination folder exists
  if (!outputFolder.exists().not()) then

    -- Create the folder
    SYSCOM 'mkdir "$!folderPath"'

    -- Output message to .log file
    !!abalogging.error('      The output directory did not exist, hence it has been created')

  endif

  -- Build time stamp
  !dateStamp = !dateTime.date() & !dateTime.month() & !dateTime.year().string().substring(3)

  -- For each sheet
  do !sheetRefe val !sheetList

    -- Build plotfile path name
    !sheetName     = !sheetRefe.flnn.replace('\','_').replace('/','_').replace('.','_')
    !pdfPathName   = !folderPath & '\' & !sheetName & '_' & !dateStamp & '.pdf'

    -- Plot sheet, whilst converting any white colours to black
    PLOT $!sheetRefe PDF /$!pdfPathName 'COL COLOURPLUS' OVERWRITE

  enddo

endfunction
