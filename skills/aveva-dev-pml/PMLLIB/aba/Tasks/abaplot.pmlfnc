-- File:            abaplot.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 June 1999
--
--
-- Description:
-- Create a plotfile of all sheets
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs
--                            1 = DXF or PDMS format
--                            2 = Output file destination pathname
--                            3 = Cutmarks, On or Off
--                            4 = Border width, Off or value >1
--                            5 = Frame On or Off
--                            6 = Overwrite any existing plotfile, On or Off
--
--    2    R     ARRAY       Array of ABADRAWING objects
--
------------------------------------------------------------------------
define function !!abaPlot(!arguments is ARRAY, !drawingList is ARRAY)

  -- Initialise variables
  if (!arguments[1].upCase().eq('PDMS')) then
    !format = ''
  else
    !format = !arguments[1]
  endif
  !pathName = !arguments[2]
  !cutm = !arguments[3]
  if (!arguments[4].upCase().eq('OFF')) then
    !border = ''
  else
    !border = 'BORD $!arguments[4]'
  endif
  if (!arguments[5].upCase().eq('OFF')) then
    !frame = ''
  else
    if (!arguments[4].upCase().eq('OFF')) then
      !frame = ''
    else
      !frame = 'FRAME'
    endif
  endif
  if (!arguments[6].upCase().eq('OFF')) then
    !overWrite = false
  else
    !overWrite = true
  endif

  -- Test for existing output directory
  !outDir = object file(!pathName)
  if (not !outDir.exists()) then

    -- Create output directory
    !!abalogging.error('      Output directory does not exist')
------------------------------------------------------------------------
-- THIS HAS BEEN CAUSING A SIGNAL 11 TRAPPED
--    !!abalogging.error('      Output directory does not exist - creating directory')
--    !osPath = !outDir.pathName() & '\' & !outDir.entry()
--    syscom 'mkdir $!osPath'
------------------------------------------------------------------------
    return
  endif

  -- Make log file header for plotting function
  !directory = object file(!pathName)
  !fullPath = !directory.pathName() & '\' & !directory.entry()
  !!abaLogging.prompt('_______________________________________________')
  !!abaLogging.prompt('')
  !!abaLogging.prompt(' Plotting all drawings produced during the run')
  !!abaLogging.prompt(' To directory $!fullPath ...')
  !!abaLogging.prompt('_______________________________________________')
  !!abaLogging.prompt(' ')

  -- Test pathName
  if (not !directory.exists()) then
    !logText = 'The destination directory ' & !pathName & ' does not exist'
    !!abaLogging.error(!logText)
    return
  endif

  -- Test for evar used in pathname
  if (!pathName.match('%').neq(0)) then
    !fullPathName = !pathName.replace('%','/%',1,1)
  else
    !fullPathName = !pathName
  endif

  -- Cycle though the produced drawings
  do !drawing val !drawingList

    -- Test for no drawings
    if (!drawing.drwg.unset()) then
      !!abaLogging.error('No Valid Drawings Exist')
      return
    endif

    -- Get all sheets for each drawing and plot each one
    var !sheets coll all shee for $!drawing.drwg
    do !shee val !sheets

      -- Form plotfile name
      !sheeName = !shee.dbref().flnn
      !plotFile = '/' & !sheeName.replace('/','_').replace('.','_').replace('*','_') & '.plt'

      -- Test for existing file
      !fullFileName = !pathName & !plotFile
      !file = object file(!fullFileName)

      if (not !file.exists()) then

        -- Make plotfile
        PLOT $!shee $!format $!fullPathName$!plotFile CUT $!cutm $!border $!frame
        !logText = 'Sheet ' & !sheeName & ' plotted ....'

      elseif (!file.exists() and !overWrite) then

        -- Make plotfile
        PLOT $!shee $!format $!fullPathName$!plotFile CUT $!cutm $!border $!frame OVER
        !logText = 'Sheet ' & !sheeName & ' plotted ....'

      else

        !logText = 'Cannot create plotfile as a file ' & !plotFile & ' already exists'

      endif

      -- Send log file message
      !!abaLogging.prompt(!logText)

    enddo

  enddo

  -- Final line in log file
  !!abaLogging.prompt(' ')

endfunction
