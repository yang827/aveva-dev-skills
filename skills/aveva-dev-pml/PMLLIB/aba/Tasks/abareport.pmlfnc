--
-- Author:          Steve Wilson
-- Created:         10 June 1999
--
--
-- Description:
-- Create report of labelled design element within the sheet
--
-- METHODOLOGY:
-- This is a generic report generator that uses it's own defaults file
-- DRA-ABA-REPORT-DATA
--
-- The file has three parts;
--           1 = pml extraction of required data
--           2 = the header
--           3 = the report body using variables set in part 1
--
-- This function merely uses this data to produce a report body entry
-- for each label found on the drawing.
-- The example used can be imported to Excel.
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs
--                            1 = Input data extraction file
--                            2 = Output pathname (directory)
--                            3 = Output file name prefix
--                                Final name will be <name prefix>_<drwg name>_<date stamp>.txt
--                            4 = APPEND to output file, true or false
--
------------------------------------------------------------------------
-- ASSUMPTION:
-- That the current element is SHEE
------------------------------------------------------------------------

define function !!abaReport(!arguments is ARRAY)

  -- Initialise variables
  !shee = !!ce
  !inFile = object file(!arguments[1])
  !outPath = !arguments[2]
  !outName = !arguments[3]
  !append = !arguments[4]
  !inText = !inFile.readFile()
  !dateTime = object datetime()
  !data = ARRAY()

  -- Test for existing output directory
  !outDir = object file(!outPath)
  if (not !outDir.exists()) then

    -- Create output directory
    !!abalogging.error('      Output directory does not exist')
------------------------------------------------------------------------
-- THIS HAS BEEN CAUSING A SIGNAL 11 TRAPPED
--    !!abalogging.error('      Output directory does not exist - creating directory')
--    !osPath = !outDir.pathName() & '\' & !outDir.entry()
--    syscom 'mkdir $!osPath'
------------------------------------------------------------------------
    return
  endif

  -- Form drawing name
  !drwgName = !shee.owne.flnn.replace('/','-').replace('\','-').replace('.','-')

  -- Read start & end of parts of file
  !codeStart = !inText.findFirst('-- Code') + 1
  !codeEnd =  !inText.findFirst('-- Header') - 1
  !hdrString[1] = !inText[(!inText.findFirst('-- Header') + 1)]
  !dataString[1] = !inText[(!inText.findFirst('-- Data') + 1)]

  -- Form full output file name
  !fileName = !outPath & '/' & !outName & '_' & !drwgName & '_' & !dateTime.date() & !dateTime.month() & !dateTime.year() & '.txt'
  !outFile = object file(!fileName)

  -- Determine write or append to output file
  if (!outFile.exists()) then
    if (!append.boolean()) then
      !openType = 'APPEND'
    else
      !openType = 'OVERWRITE'
    endif
  else
    !openType = 'OVERWRITE'
  endif

  -- Get all tag layers
  var !allLaye coll all laye wi (matchwild(attrib SpPURP,'*TAG*')) for $!shee

  -- Get all tag labels
  do !laye val !allLaye
    var !allTag append coll all (slab glab) for $!laye
  enddo

  -- Get data
  do !tag val !allTag

    -- Initialise variables
    !tagRefe = !tag.dbref()
    !tagType = !tag.dbref().type.upCase()

    -- Access label
    !!ce = !tagRefe

    -- Test for text template not as origin of slab text
    if (!tagType.eq('SLAB')) then
      skip if (!tagRefe.tmrf.type.upCase().neq('TXTM'))
    endif

    -- Run code
    do !number from !codeStart to !codeEnd
      $!inText[$!number]
    enddo

    -- Get data
    !data.append($!dataString[1])

  enddo

  -- Sort data
  !data.sort()

  -- Write report header
  !outFile.writeFile(!openType,!hdrString)

  -- Write report body
  !outFile.writeFile('APPEND',!data)

  -- Close files
  !outFile.close()

  -- Return to sheet
  !!ce = !shee

endfunction
