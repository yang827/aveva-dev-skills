-- Author:          Steve Wilson
-- Created:         10 June 1999
--
--
-- Description:
-- Create report for all sheets
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs
--                            1 = Input data extraction file
--                            2 = Output pathname (directory)
--                            3 = Output file name prefix
--                                Final name will be <name prefix>_<drwg name>_<date stamp>.txt
--                            4 = APPEND to output file, true or false
--
--    2    R     ARRAY       Array of ABADRAWING objects
--
------------------------------------------------------------------------

define function !!abaReportAll(!arguments is ARRAY, !drawingList is ARRAY)

  -- Initialise variables
  !ceRefe = !!ce

  -- Cycle though the produced drawings
  do !drawing val !drawingList

    -- Get all sheets for this drwg
    var !allShee coll all shee for $!drawing.drwg

    -- Make a report for each shee
    do !shee val !allShee

      -- Access the shee and call the report function
      !!ce = !shee.dbref()
      !!abaReport(!arguments)

    enddo

  enddo

  -- Return to the hierarchal position
  !!ce = !ceRefe

endfunction
