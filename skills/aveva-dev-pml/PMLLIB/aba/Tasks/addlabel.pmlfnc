define function !!addlabel(!params is array)
 -- Parameter 1 is the text to be output
 -- Parameter 2 is the position
 -- Parameter 3 is the font
 -- Parameter 4 is the text height
 -- current element is the sheet

 !name = !!ce.name & '/LABELS'

 -- set the note name and test if it exists already
 !!ce = !name.dbref()
 handle none
   delete note
   new note $!name
 elsehandle any
   new note $!name
 endhandle
 new texp
 btext '$!params[1]'
 xypos $!params[2]
 font  $!params[3]
 chei  $!params[4]
endfunction
