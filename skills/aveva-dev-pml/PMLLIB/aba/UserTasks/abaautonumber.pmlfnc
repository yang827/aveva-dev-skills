-- File:            abaAutoNumberingcode.pmlfnc
--   Type:          Function Definition
--   Group:         draft
--     Keyword:     ABA
--   Module:        Draft
--   Replaces:
--
-- Author:          Martin Wright
-- Created:         12 July 1999
--
--
-- Description:
-- Function returns a string to so that the auto numbering function can build
-- up the correct number format from the auto-number PDMS function.
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs
--                            1 = Dtext for drawing function gadget.
--                            2 = Rtext for drawing function gadget.
--
-- ASSUMPTIONS
-- The current element should be the DRWG to be processed
--
--  |C050-CC-| + !!abaAutoNumber() + |-ZE| + |-4| + !INDEX + |-01|
------------------------------------------------------------------------
define function !!abaAutoNumber(!type is STRING) is STRING
------------------------------------------------------------------------

  if (!type EQ 'discipline') then

      !func = function of ce

      if (!func.substring(1,1) EQ '=') then
          !funcref = !func
      elseif !func.split().size().eq(1) then
          var !Tkpara coll all Tkpara for $!!abadefaults.task.val
          var !Tpval eval tpval for all from !Tkpara
          !funcref = !Tpval[1]
      else
          !funcref = tpvalue of tkpara of $!func
      endif

      handle (2,107)
         -- Undefined reference
         !name = name of ce
         !desc[1] = 'Numbering Code Has Been Deleted for $!name - See Your System Administrator'
         !!abalogging.addtoLog(!desc)
         !return = '_'
      elseHandle NONE

      !return = !funcref
      endHandle

  else
    !return = 'ZE'
  endif

  return !return

endfunction
--
