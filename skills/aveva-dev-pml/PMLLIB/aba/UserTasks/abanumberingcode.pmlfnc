--
-- Author:          Martin Wright
-- Created:         12 July 1999
--
--
-- Description:
-- Function returns an array to populate gadget for deciding how/what numbering
-- format user will get if selecting different discipline types, will be used
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs
--                            1 = Dtext for drawing function gadget.
--                            2 = Rtext for drawing function gadget.
--
-- ASSUMPTIONS
-- The current element must be the VIEW to be processed
--
------------------------------------------------------------------------
define function !!abaNumberingCode() is ARRAY
------------------------------------------------------------------------

   !purpd[1] = 'MultiDiscipline (Z)'
   !purpd[2] = 'Piping/Layout (L)'
   !purpd[3] = 'Structural (N)'
   !purpd[4] = 'Electrical (E)'
   !purpd[5] = 'Process (P)'
   !purpr[1] = 'Z'
   !purpr[2] = 'L'
   !purpr[3] = 'N'
   !purpr[4] = 'E'
   !purpr[5] = 'P'

   !numdef[1] = !purpd
   !numdef[2] = !purpr

return !numdef

endfunction
