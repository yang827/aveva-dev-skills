--
-- File:            margrids.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         03 June 1999
--
--
-- Description:
-- Create gridlines
--
-- ASSUMPTIONS: The CE is the VIEW
--
-------------------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs                -- For testing
--                            1 = X-Axis Increment            !arguments[1]  = '1'
--                            2 = Y-Axis Increment            !arguments[2]  = '1'
--                            3 = Z-Axis Increment            !arguments[3]  = '1'
--                            4 = X-Axis Line Style           !arguments[4]  = 'dotted'
--                            5 = Y-Axis Line Style           !arguments[5]  = 'dashed'
--                            6 = Z-Axis Line Style           !arguments[6]  = 'ldashed'
--                            7 = X-Axis Colour               !arguments[7]  = '1'
--                            8 = Y-Axis Colour               !arguments[8]  = '2'
--                            9 = Z-Axis Colour               !arguments[9]  = '3'
--                           10 = Tag Visibility              !arguments[10] = 'On'
--                           11 = Tag Colour                  !arguments[11] = '2'
--                           12 = Tag Character Height        !arguments[12] = '2'
--                           13 = X-Axis Baseline Word        !arguments[13] = 'X0'
--                           14 = Y-Axis Baseline Word        !arguments[14] = 'Y0'
--                           15 = Z-Axis Baseline Word        !arguments[15] = 'Z0'
--
-------------------------------------------------------------------------------------
define function !!marGrids(!arguments is ARRAY)

  -- Initialise variables
  !viewRefe = !!ce
  !vLimits  = !viewRefe.vlimits
  !vDirStrg = !viewRefe.dir.string().before(' WRT')
  !xIncre   = !arguments[1].real()
  !yIncre   = !arguments[2].real()
  !zIncre   = !arguments[3].real()
  !xNlStyle = !arguments[4]
  !yNlStyle = !arguments[5]
  !zNlStyle = !arguments[6]
  !xNlCol   = !arguments[7]
  !yNlCol   = !arguments[8]
  !zNlCol   = !arguments[9]
  !tagsOn   = !arguments[10].trim('lr').upcase().eq('ON')
  !tagCol   = !arguments[11]
  !tagChei  = !arguments[12]
  !gridObj  = object GPHSHIPGRID()

  -- Get into position in hierarchy by finding any existing layer
  VAR !gridLaye COLL ALL LAYE WI SPPURP EQ 'GRIDLN' FOR $!viewRefe
  if (!gridLaye.empty()) then

    -- Create the laye
    !!ce = !viewRefe
    !layeName = !viewRefe.flnm & '/GridLines'

    NEW LAYE $!layeName
    SPPURP GRIDLN  PURP GRID

  else

    -- Access the existing laye and delete all existing elements
    !!ce      = !gridLaye[1].dbref()
    !layeName = !!ce.flnm

    DELETE LAYE MEM

  endif

  -- Test for plan view
  if (!viewRefe.planv) then

    -- The plane is XY
    !vnotName = !layeName & '/XY'
    !xArray   = !gridObj.grid.xOffset
    !xIdArray = !gridObj.grid.xId
    !xStep    = !xIncre
    !yArray   = !gridObj.grid.yOffset
    !yStep    = !yIncre
    !yIdArray = !gridObj.grid.yId
    !xMinLim  = !vLimits[1]
    !xMaxLim  = !vLimits[4]
    !yMinLim  = !vLimits[2]
    !yMaxLim  = !vLimits[5]
    !xBase    = !arguments[13]
    !yBase    = !arguments[14]
    !xFpt     = 'E $$!coordVal N $$!yMinLim U 0'
    !xTpt     = 'E $$!coordVal N $$!yMaxLim U 0'
    !yFpt     = 'E $$!xMaxLim  N $$!coordVal U 0'
    !yTpt     = 'E $$!xMinLim  N $$!coordVal U 0'
    !xFptBase = 'E 0 N $$!yMinLim U 0'
    !xTptBase = 'E 0 N $$!yMaxLim U 0'
    !yFptBase = 'E $$!xMaxLim N 0 U 0'
    !yTptBase = 'E $$!xMinLim N 0 U 0'
    !xStyle   = !xNlStyle
    !yStyle   = !yNlStyle
    !xColour  = !xNlCol
    !yColour  = !yNlCol

  elseif (!viewRefe.elevv) then

    -- Test for looking in the Y axis
    if (!vDirStrg.eq('Y') or !vDirStrg.eq('-Y')) then

      -- The plane is XZ
      !vnotName = !layeName & '/XZ'
      !xArray   = !gridObj.grid.xOffset
      !xIdArray = !gridObj.grid.xId
      !xStep    = !xIncre
      !yArray   = !gridObj.grid.zOffset
      !yStep    = !zIncre
      !yIdArray = !gridObj.grid.zId
      !xMinLim  = !vLimits[1]
      !xMaxLim  = !vLimits[4]
      !yMinLim  = !vLimits[3]
      !yMaxLim  = !vLimits[6]
      !xBase    = !arguments[13]
      !yBase    = !arguments[15]
      !xFpt     = 'E $$!coordVal N 0 U $$!yMinLim'
      !xTpt     = 'E $$!coordVal N 0 U $$!yMaxLim'
      !yFpt     = 'E $$!xMaxLim  N 0 U $$!coordVal'
      !yTpt     = 'E $$!xMinLim  N 0 U $$!coordVal'
      !xFptBase = 'E 0 N 0 U $$!yMinLim'
      !xTptBase = 'E 0 N 0 U $$!yMaxLim'
      !yFptBase = 'E $$!xMaxLim N 0 U 0'
      !yTptBase = 'E $$!xMinLim N 0 U 0'
      !xStyle   = !xNlStyle
      !yStyle   = !zNlStyle
      !xColour  = !xNlCol
      !yColour  = !zNlCol

      -- Test for whether the baseline is within the limits
      if (!vLimits[1].lt(0) and !vLimits[4].gt(0)) then
        !baseLine = true
      endif

    -- We are looking in the X axis
    else

      -- The plane is YZ
      !vnotName = !layeName & '/YZ'
      !xArray   = !gridObj.grid.yOffset
      !xIdArray = !gridObj.grid.yId
      !xStep    = !yIncre
      !yArray   = !gridObj.grid.zOffset
      !yStep    = !zIncre
      !yIdArray = !gridObj.grid.zId
      !xMinLim  = !vLimits[2]
      !xMaxLim  = !vLimits[5]
      !yMinLim  = !vLimits[3]
      !yMaxLim  = !vLimits[6]
      !xBase    = !arguments[14]
      !yBase    = !arguments[15]
      !xFpt     = 'E 0 N $$!coordVal U $$!yMinLim'
      !xTpt     = 'E 0 N $$!coordVal U $$!yMaxLim'
      !yFpt     = 'E 0 N $$!xMinLim  U $$!coordVal'
      !yTpt     = 'E 0 N $$!xMaxLim  U $$!coordVal'
      !xFptBase = 'E 0 N 0 U $$!yMinLim'
      !xTptBase = 'E 0 N 0 U $$!yMaxLim'
      !yFptBase = 'E 0 N $$!xMaxLim U 0'
      !yTptBase = 'E 0 N $$!xMinLim U 0'
      !xStyle   = !yNlStyle
      !yStyle   = !zNlStyle
      !xColour  = !yNlCol
      !yColour  = !zNlCol

    endif

  -- Not an orthogonal view
  else

    -- Output a log file message
    !!abaLogging.error('      Gridlines have not been created since the view is not orthogonal')

    -- Done
    return

  endif

  -- Create the view note
  NEW VNOT $!vnotName

  -- Build the grid lines
  -- Paper X axis
  do !index from 1 to !xArray.size() by !xStep

    -- Get the x axis coordinate and identifier
    !coordVal = !xArray[!index]
    !tagValue = !xIdArray[!index].string()

    -- Test for unset index
    skip if (!coordVal.unset())

    -- Test for within the view limits
    skip if (!coordVal.leq(!xMinLim) or !coordVal.geq(!xMaxLim))

    -- Ignore coordinate zero as will always be drawn as the baseline below
    skip if (!coordVal.eq(0))

    -- Create the line
    NEW STRA  FPT $!xFpt  TPT $!xTpt
      NLSTYLE $!xStyle NLCOLOUR $!xColour

    -- Create the tag at the end of the line
    -- There is no need to specify a location as the default is the last 2D point i.e. the end of line
    if (!tagsOn) then

      NEW TEXP
        BTEX '$!tagValue'  CHEI $!tagChei  TXCOLOUR $!tagCol  JUST R  ALIG BB

    endif

  enddo

  -- Paper Y axis
  do !index from 1 to !yArray.size() by !yStep

    -- Get the y axis coordinate and identifier
    !coordVal = !yArray[!index]
    !tagValue = !yIdArray[!index].string()

    -- Test for unset index
    skip if (!coordVal.unset())

    -- Test for within the view limits
    skip if (!coordVal.leq(!yMinLim) or !coordVal.geq(!yMaxLim))

    -- Ignore coordinate zero as will always be drawn as the baseline below
    skip if (!coordVal.eq(0))

    -- Create the line
    NEW STRA  FPT $!yFpt  TPT $!yTpt
      NLSTYLE $!yStyle NLCOLOUR $!yColour

    -- Create the tag at the end of the line
    if (!tagsOn) then

      NEW TEXP
        BTEX '$!tagValue'  CHEI $!tagChei  TXCOLOUR $!tagCol  JUST R  ALIG BB

    endif

  enddo

  -- Draw the baselines if within the limits
  if (!xMinLim.lt(0) and !xMaxLim.gt(0)) then

    NEW STRA  FPT $!xFptBase  TPT $!xTptBase
      NLSTYLE CHAINEDMEDIUM NLCOLOUR 7

    NEW TEXP
      BTEX '$!xBase'  CHEI $!tagChei  TXCOLOUR $!tagCol  JUST R  ALIG BB

  endif

  if (!yMinLim.lt(0) and !yMaxLim.gt(0)) then

    NEW STRA  FPT $!yFptBase  TPT $!yTptBase
      NLSTYLE CHAINEDMEDIUM NLCOLOUR 7

    NEW TEXP
      BTEX '$!yBase'  CHEI $!tagChei  TXCOLOUR $!tagCol  JUST R  ALIG BB

  endif

  -- Return to the view
  !!ce = !viewRefe

endfunction
