-- File:            samequicldimn.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 July 2000
--
--
-- Description:
-- Create dimensions between equipment centrelines
-------------------------------------------------------------------------
--
-- LIMITATIONS:
-- Currently only added for orthogonal views, although will produce results with errors
-- Does not currently check for any coincident DPPTs
-- Does not currently use PLTX for equipment names
--
-------------------------------------------------------------------------
--
-- ASSUMPTIONS:
-- That the VIEW is the current element
-- That the idli for equipment has the function set to 'equipment'
--
-------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of string arguments
--                           Argument 1 to 4 are the sides for placing dimensions
--                                    1 = Top; 2 = Bottom; 3 = Left; 4 = Right
--                           Argument 5 is the distance from the view limits to the dimension line
--                           Argument 6 is dimension text character height
--                           Argument 7 is dimension text colour
-- CURRENTLY NOT USED
--                           Argument 8 is projectionline text character height
--                           Argument 9 is projectionline text pen
--
------------------------------------------------------------------------
define function !!samEquiCLDimn(!arguments is ARRAY)

  -- Initialise variables
  !viewRefe = !!ce
  !adeg     = !viewRefe.adeg
  !rcode    = !viewRefe.rcode
  !margin   = !arguments[5].real(!!distanceFMT)
  !dtch     = !arguments[6]
  !dtpen    = !arguments[7]
--  !ptch  = !arguments[8]
--  !ptpen = !arguments[9]
  var !viewDir append viewdir U
  var !viewDir append viewdir R
  !side[1]   = ARRAY()
  !side[2]   = ARRAY()
  !side[3]   = ARRAY()
  !side[4]   = ARRAY()
  !inside[1] = ARRAY()
  !inside[2] = ARRAY()
  !inside[3] = ARRAY()
  !inside[4] = ARRAY()
  !numbSides = 0

  -- Set side switches
  do !numb from 1 to 4
    if (!arguments[!numb].upCase().eq('ON')) then
      !sides[!numb] = true
      !numbSides = !numbSides + 1
    else
      !sides[!numb] = false
    endif
  enddo

  -- Check for no selected sides
  if (!numbSides.eq(0)) then
    !!abaLogging.error('      Cannot build dimensions - No sides have been selected')
    return
  endif

  -- Get view limits
  -- This is intentionally as a string, since saves formatting into sequence suitable for the collect command
   !idliRefe = !viewRefe.idln
   var !limits limits of $!idliRefe
   !limits = !limits.after('From ')

  -- Get view limits on page
  var !vReg split VREG of $!viewRefe
  !xMin = !vReg[3].real(!!distanceFMT)
  !xMax = !vReg[8].real(!!distanceFMT)
  !yMin = !vReg[5].real(!!distanceFMT)
  !yMax = !vReg[10].real(!!distanceFMT)

  -- Calculate view limits positions for start and end of dimension strings
  var !TL enupos of X $!xMin Y $!yMax
  var !TR enupos of X $!xMax Y $!yMax
  var !BL enupos of X $!xMin Y $!yMin
  var !BR enupos of X $!xMax Y $!yMin

  -- Calculate dimension page positions
  !UDpos = 'X' & !xMin & ' Y' & (!yMax + !margin)
  !DDpos = 'X' & !xMin & ' Y' & (!yMin - !margin)
  !LDpos = 'X' & (!xMin - !margin) & ' Y' & !yMax
  !RDpos = 'X' & (!xMax + !margin) & ' Y' & !yMax

  -- Get all drawn equipment from the referenced idli and place them in the side arrays
  -- Remember that in Aba that the View idln holds the limits and references an idli that holds the drawlist rule
  -- Do not need to consider any REME rules since the result would not be drawn and we are only scanning what is drawn
  var !allViewAdde coll all adde for $!idliRefe
  do !viewAdde val !allViewAdde

    -- Initialise variables
    !ruleIdliRefe = !viewAdde.dbref().idnm

    -- Test that the found adde references an equipment discipline idli
    skip if (!ruleIdliRefe.func.upCase().match('EQUIPMENT').eq(0))

    -- Get each equipment idli adde element rule
    var !allAdde coll all adde for $!ruleIdliRefe
    do !adde val !allAdde

      -- Read criteria as string to retain format
      var !criteria criteria of $!adde

      -- Get all rule defined elements and check position wrt view limits
      var !defElem VSCAN FOR $!criteria within $!limits
      do !string val !defElem

        -- Extract equipment reference from the result
        !bits = !string.split()

        -- Group equipment into sides for dimensioning
        var !vSide split VSIDE OF $!bits[2]

        -- Allow for rcode
        if (!rcode.upCase().eq('DOWN')) then
          !UIndex = 2
          !DIndex = 1
          !LIndex = 4
          !RIndex = 3
        elseif (!rcode.upCase().eq('LEFT')) then
          !UIndex = 3
          !DIndex = 4
          !LIndex = 2
          !RIndex = 1
        elseif (!rcode.upCase().eq('RIGHT')) then
          !UIndex = 4
          !DIndex = 3
          !LIndex = 1
          !RIndex = 2
        else
          !UIndex = 1
          !DIndex = 2
          !LIndex = 3
          !RIndex = 4
        endif

        -- Test for inside/outside
        if (!vSide[3].upCase().eq('INSIDE')) then
          !in = true
        else
          !in = false
        endif

        -- First side
        if (!vSide[1].upCase().eq('UP')) then
          !side[!UIndex].append(!bits[2].dbref())
          !inside[!UIndex].append(!in)
        elseif (!vSide[1].upCase().eq('DOWN')) then
          !side[!DIndex].append(!bits[2].dbref())
          !inside[!DIndex].append(!in)
        elseif (!vSide[1].upCase().eq('LEFT')) then
          !side[!LIndex].append(!bits[2].dbref())
          !inside[!LIndex].append(!in)
        else
          !side[!RIndex].append(!bits[2].dbref())
          !inside[!RIndex].append(!in)
        endif

        -- Second side
        if (!vSide[2].upCase().eq('UP')) then
          !side[!UIndex].append(!bits[2].dbref())
          !inside[!UIndex].append(!in)
        elseif (!vSide[2].upCase().eq('DOWN')) then
          !side[!DIndex].append(!bits[2].dbref())
          !inside[!DIndex].append(!in)
        elseif (!vSide[2].upCase().eq('LEFT')) then
          !side[!LIndex].append(!bits[2].dbref())
          !inside[!LIndex].append(!in)
        else
          !side[!RIndex].append(!bits[2].dbref())
          !inside[!RIndex].append(!in)
        endif

      enddo

    enddo

  enddo

  -- Get into position in hierarchy by finding any existing layer
  var !dimnLaye coll all laye wi SpPURP eq 'DIMN' for $!viewRefe
  if (!dimnLaye.empty()) then

    -- Create the laye
    !!ce = !viewRefe
    !layeName = !viewRefe.flnm & '/Dimensions'
    NEW LAYE $!layeName
    SpPURP DIMN  PURP DIME

  else

    -- Access the existing laye and delete all existing elements
    !!ce = !dimnLaye[1].dbref()
    DELETE LAYE MEM

  endif

  -- Process each side
  do !count from 1 to 4

    -- Test for side switch
    skip if (!sides[!count].not())

    -- Initialise variables
    if (!count.eq(1)) then
      !start = !TL
      !finish = !TR
      !direction = !viewDir[2]
      !dpos = !UDpos
    elseif (!count.eq(2)) then
      !start = !BL
      !finish = !BR
      !direction = !viewDir[2]
      !dpos = !DDpos
    elseif (!count.eq(3)) then
      !start = !BL
      !finish = !TL
      !direction = !viewDir[1]
      !dpos = !LDpos
    else
      !start = !BR
      !finish = !TR
      !direction = !viewDir[1]
      !dpos = !RDpos
    endif

    -- Dimension to view limits
    NEW LDIM
     DPOS $!dpos
     DIR $!direction
     DTCH $!dtch  DTCOLOUR $!dtpen
--     PTCH $!ptch  PTPEN $!ptpen
     !ldimRefe = !!ce
     !layeOsht = !!ce.osht

     NEW DPOI POS $!start
     NEW DPOI POS $!finish

    -- Dimension to each equipment
    do !index ind !side[!count]

      -- Initialise variables
      !equiRefe = !side[!count][!index]
      !inOut = !inside[!count][!index]
      !create = true
      !plcl = 0
      var !osht delete
      !osht = 'default'

      -- Check if this point is outside of the view
      if (!inOut.not()) then


        -- Get equipment 2D position
        var !equiPos split shpos of $!equiRefe

        -- Calculate plcl
        if (!count.eq(1)) then

          -- Check if between the dimension ends
          if (!equiPos[2].real(!!distanceFMT).lt(!xMax) and !equiPos[2].real(!!distanceFMT).gt(!xMin)) then

            -- Test whether position is inside or outside of the dimension line position
            if ( !equiPos[4].real(!!distanceFMT).gt(!yMax + !margin) ) then
              !plcl = !equiPos[4].real(!!distanceFMT) - !yMax - !margin - !layeOsht
              !osht.delete()
              !osht = !margin
            else
              !plcl = !yMax - !equiPos[4].real(!!distanceFMT)
            endif

          else
            !create = false
          endif

        elseif (!count.eq(2)) then
          if (!equiPos[2].real(!!distanceFMT).lt(!xMax) and !equiPos[2].real(!!distanceFMT).gt(!xMin)) then
            if (!equiPos[4].real(!!distanceFMT).lt(!yMin - !margin)) then
              !plcl = !yMin - !equiPos[4].real(!!distanceFMT) - !margin - !layeOsht
              !osht.delete()
              !osht = !margin
            else
              !plcl = !equiPos[4].real(!!distanceFMT) - !yMin
            endif
          else
            !create = false
          endif
        elseif (!count.eq(3)) then
          if (!equiPos[4].real(!!distanceFMT).lt(!yMax) and !equiPos[4].real(!!distanceFMT).gt(!yMin)) then
            if (!equiPos[2].real(!!distanceFMT).lt(!xMin - !margin)) then
              !plcl = !xMin - !equiPos[2].real(!!distanceFMT) - !margin - !layeOsht
              !osht.delete()
              !osht = !margin
            else
              !plcl = !equiPos[2].real(!!distanceFMT) - !xMin
            endif
          else
            !create = false
          endif
        else
          if (!equiPos[4].real(!!distanceFMT).lt(!yMax) and !equiPos[4].real(!!distanceFMT).gt(!yMin)) then
            if (!equiPos[2].real(!!distanceFMT).gt(!xMax + !margin)) then
              !plcl = !equiPos[2].real(!!distanceFMT) - !xMax - !margin - !layeOsht
              !osht.delete()
              !osht = !margin
            else
              !plcl = !xMax - !equiPos[2].real(!!distanceFMT)
            endif
           else
            !create = false
          endif
        endif

      endif

      -- Create dimension point
      if (!create) then

        NEW DPPT ON $!equiRefe
         PLCL $!plcl
         OSHT $!osht

      endif

    enddo

    -- Dimension to gridlines if they exist
    if (!count.eq(1) or !count.eq(3)) then

      var !upGridLaye coll all laye wi SpPURP eq 'GRIDT' for $!viewRefe
      if (!upGridLaye.empty().not()) then

        -- Initialise variables
        !arg[1] = !margin
        !arg[2] = !dtch
        !arg[3] = !dtpen
        !arg[4] = !viewRefe
        if (!count.eq(1)) then
          !arg[5] = 1
        else
          !arg[5] = 2
        endif

        -- Create dppts
        !!samGridDimn(!arg)

      endif
    endif

    -- Sort the dimension
    SORT DIM

    -- If the gridlines dimensions exist, check last points at each end of the dimensions are to equipment
    -- If not then delete the first and last gridline dimension points since they will exist twice
    if (!count.eq(1) or !count.eq(3)) then

      -- Initialise variables
      if (!count.eq(1)) then
        !ldimNumb = 1
      else
        !ldimNumb = 2
      endif

      var !gridDimnLaye coll all laye wi SpPURP eq 'GDIM' for $!viewRefe
      if (!gridDimnLaye.empty().not()) then

        -- Look for the first and last dppt
        var !allDppt coll all dppt for $!ldimRefe

        !firstDppt = !allDppt[1].dbref()
        !lastDppt = !allDppt[!allDppt.size()].dbref()

        if (!firstDppt.ddnm.type.upCase().neq('EQUI')) then

          -- Delete the first dpoi of the gridline dimension
          DPOI 1 OF LDIM $!ldimNumb OF $!gridDimnLaye[1]
          DELETE DPOI
          !!ce = !ldimRefe

        endif

        if (!lastDppt.ddnm.type.upCase().neq('EQUI')) then

          -- Delete the first dpoi of the gridline dimension
          LAST MEM OF LDIM $!ldimNumb OF $!gridDimnLaye[1]
          if (!!ce.type.upCase().eq('DPOI')) then
            DELETE DPOI
          endif
          !!ce = !ldimRefe

        endif

      endif

    endif

  enddo

endfunction
