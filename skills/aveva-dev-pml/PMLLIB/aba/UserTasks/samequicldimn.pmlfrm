--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  closed()                         -
--  init()                           -
--  side(STRING,BOOLEAN)             -
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

setup form !!samequicldimn blocking

  title |Choose options|
  init |!this.init()|

-- Define Members/Selection Areas
-- ------------------------------

  frame .options | Options | at x0

    path right

    para .sides at x1 y1.5 text |Sides:|
    toggle .up at xmax+2 ymin-0.3 pixmap height 28 width 28 call |!this.side('up',!this.up.val)|
    toggle .down at xmax+1 pixmap height 28 width 28 call |!this.side('down',!this.down.val)|
    toggle .left at xmax+1 pixmap height 28 width 28 call |!this.side('left',!this.left.val)|
    toggle .right at xmax+1 pixmap height 28 width 28 call |!this.side('right',!this.right.val)|

    para .margint at xmin.sides ymax+0.75 text |Margin:|
    text .margin at xmax.margint ymin.margint width 11 is REAL format !!distanceFMT

    para .dtcht  at xmin.sides ymax+0.25 text |Dimension Text Height:|
    text .dtch at xmax.dtcht ymin.dtcht width 11 is REAL format !!distanceFMT

    para .dtpent at xmin.sides ymax+0.25 text |Dimension Text Colour:|
    text .dtpen at xmax.dtpent ymin.dtpent width 11 is REAL

  exit

-- Feedback view
-- -------------
  view .feedback at xmax.options+0.5 y0.2 AREA
    height 7 aspect 1
    setcolour 15
    cursor nocursor
    borders off
  exit

-- Action buttons
-- --------------

  path right
  button .ok     | Apply | at x0 ymax.options+0.25 call |!this.apply()| ok
  button .cancel |Dismiss| at xmax.options-10.5 call |!this.closed()| cancel

  -- Pixmaps
  !this.up.addPixmap(!!PML.getPathName('viewusideoff.png'),!!PML.getPathName('viewusideon.png'),'')
  !this.down.addPixmap(!!PML.getPathName('viewdsideoff.png'),!!PML.getPathName('viewdsideon.png'),'')
  !this.left.addPixmap(!!PML.getPathName('viewlsideoff.png'),!!PML.getPathName('viewlsideon.png'),'')
  !this.right.addPixmap(!!PML.getPathName('viewrsideoff.png'),!!PML.getPathName('viewrsideon.png'),'')

  -- Members
  member .feedbackDept is DBREF
  member .feedbackName is STRING
  member .taskName     is STRING
  member .task         is ABATASK
  member .form         is FORM

  -- Set feedback name
  !this.feedbackName = '/Aba/samequicldimn/feedback'

-- End of form definition
exit

--------------------------------------------------------------------
define method .init()
--------------------------------------------------------------------
-- Called when form is shown

   -- Initialise variables
   !ce = !!ce

   -- Get first site
   SW
   !siteRefe = site 1 of world
   SW

   -- Create feedback drawing
   var !exist exist $!this.feedbackName/dept
   if (!exist.eq('FALSEA')) then

     NEW DEPT $!this.feedbackName/dept
     !this.feedbackDept = !!ce

     NEW REGI $!this.feedbackName/regi

     NEW DRWG $!this.feedbackName/drwg

     NEW SHEE $!this.feedbackName
      SIZE 100 100

     --set the drawing type
     !!setmarptype(!!ce, 32)

     NEW NOTE
     NEW RECT
       XLEN 50  YLEN 50  NLSTYLE Solid NLCOLOUR Orange
       ORIGIN CENTRE X50 Y50

     NEW RECT
       XLEN 80  YLEN 80  NLSTYLE Dashed NLCOLOUR Red

     NEW VIEW
      SIZE 50 50
      FRA OFF

     NEW LAYE
     NEW LDIM
      DPOS X75 Y80  DIR E
      NEW DPOI
       POS E25 N26 U0  OSHT 0  PLCL 3
      NEW DPOI
       POS E40 N26 U0  DTOF 5 6  DMTX 'MARGIN'  DTCH 5  DTANG HORI

     NEW LAYE $!this.feedbackName/up
      CHEI 3  LSHA AV  GBOX 0  ALIG HB  JUST L  LLSTYLE Solid LLCOLOUR Green LFSTYLE Solid LFCOLOUR Green TXCOLOUR Red
      if (!this.task.paramval[1].upCase().neq('ON')) then
        LVIS FALSE
      endif

     NEW LDIM
      DPOS X50 Y90  DIR E  DTCH 2  DLSTYLE Solid DLCOLOUR Blue PLSTYLE Solid PLCOLOUR Green
      NEW DPOI  POS W25 N26 U0
      NEW DPOI  POS E0  N26 U0
      NEW DPOI  POS E25 N26 U0


     NEW LAYE $!this.feedbackName/down
      CHEI 3  LSHA AV  GBOX 0  ALIG HB  JUST R  LLSTYLE Solid LLCOLOUR Green LFSTYLE Solid LFCOLOUR Green TXCOLOUR Red
      if (!this.task.paramval[2].upCase().neq('ON')) then
        LVIS FALSE
      endif

     NEW LDIM
      DPOS X50 Y10  DIR E  DTCH 2  DLSTYLE Solid DLCOLOUR Blue PLSTYLE Solid PLCOLOUR Green
      NEW DPOI  POS W25 S26 U0
      NEW DPOI  POS E0  S26  U0
      NEW DPOI  POS E25 S26 U0

     NEW LAYE $!this.feedbackName/left
      CHEI 3  LSHA AH  GBOX 0  ALIG HB  JUST R  LLSTYLE Solid LLCOLOUR Green LFSTYLE Solid LFCOLOUR Green TXCOLOUR Red
      if (!this.task.paramval[3].upCase().neq('ON')) then
        LVIS FALSE
      endif

     NEW LDIM
      DPOS X10 Y50  DIR N  DTCH 2  DLSTYLE Solid DLCOLOUR Blue PLSTYLE Solid PLCOLOUR Green
      NEW DPOI  POS W26 S25 U0
      NEW DPOI  POS W26 N0  U0
      NEW DPOI  POS W26 N25 U0

     NEW LAYE $!this.feedbackName/right
      CHEI 3  LSHA AH  GBOX 0  ALIG HB  JUST L  LLSTYLE Solid LLCOLOUR Green LFSTYLE Solid LFCOLOUR Green TXCOLOUR Red
      if (!this.task.paramval[4].upCase().neq('ON')) then
        LVIS FALSE
      endif

     NEW LDIM
      DPOS X90 Y50  DIR N  DTCH 2  DLSTYLE Solid DLCOLOUR Blue PLSTYLE Solid PLCOLOUR Green
      NEW DPOI  POS E26 S25 U0
      NEW DPOI  POS E26 N0  U0
      NEW DPOI  POS E26 N25 U0

   else

     -- Attempt to delete existing dept
     !dept = !this.feedbackName & '/dept'
     !this.feedbackDept = !dept.dbref()

   endif

   -- Add sheet to view
   edit view !!samequicldimn.feedback AREA put $!this.feedbackName

   -- Read and store task name
   !this.taskName = !this.task.name

   -- Set defaults
   !this.up.val    = true
   !this.down.val  = true
   !this.left.val  = true
   !this.right.val = true
   !this.up.val    = false
   !this.down.val  = false
   !this.left.val  = false
   !this.right.val = false
   !this.up.val    = !this.task.paramval[1].boolean()
   !this.down.val  = !this.task.paramval[2].boolean()
   !this.left.val  = !this.task.paramval[3].boolean()
   !this.right.val = !this.task.paramval[4].boolean()

   -- Distance defaults
   !this.margin.val = !this.task.paramval[5].real()
   !this.dtch.val = !this.task.paramval[6].real()

   -- Remaining gadgets
   !this.dtpen.val = !this.task.paramval[7].real()

   -- Set form title
   !this.formTitle = !this.taskName

   -- Return to hierarchy position
   !!ce = !ce

endmethod

--------------------------------------------------------------------
define method .side(!which is STRING, !true is BOOLEAN)
--------------------------------------------------------------------
-- Called when a side toggle is pressed

   -- Initialise variables
   !ce = !!ce
   !laye = !this.feedbackName & '/' & !which
   !layeRefe = !laye.dbref()

   -- Access laye and switch visibility
   !!ce = !layeRefe
   if (!true) then
     LVIS TRUE
   else
     LVIS FALSE
   endif

   -- Test for all switched off
   var !lvis eval lvis for all laye for $!this.feedbackName
   if (not !lvis[1].boolean() and not !lvis[2].boolean() and not !lvis[3].boolean() and not !lvis[4].boolean()) then

     -- Switch next laye on
     NEXT LAYE
      handle (2,113)
        FIRST LAYE
      endhandle

     LVIS TRUE

     -- Switch gadget on
     !order = !!ce.sequence
     if (!order.eq(1)) then
       !this.up.val = true
     elseif (!order.eq(2)) then
       !this.down.val = true
     elseif (!order.eq(3)) then
       !this.left.val = true
     else
       !this.right.val = true
     endif

     !!samequicldimn.hide()
     !!samequicldimn.show()

   endif

   -- Refresh view
   REFRESH !!samequicldimn.feedback

   -- Return to hierarchy position
   !!ce = !ce

endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------
-- Called when apply is pressed

   -- Initialise variables
   !ce = !!ce

   -- Build parameters array
   !parameters[1] = 'Off'
   !parameters[2] = 'Off'
   !parameters[3] = 'Off'
   !parameters[4] = 'Off'
   if (!this.up.val) then
     !parameters[1] = 'On'
   endif
   if (!this.down.val) then
     !parameters[2] = 'On'
   endif
   if (!this.left.val) then
     !parameters[3] = 'On'
   endif
   if (!this.right.val) then
     !parameters[4] = 'On'
   endif

   -- Distance parameters
   !parameters[5] = !this.margin.val
   !parameters[6] = !this.dtch.val

   -- Remaining parameters
   !parameters[7] = !this.dtpen.val

   -- Reset the task object
   !this.task.paramVal = !parameters

   -- Transfer the modified task back to the calling form
   !this.form.receiveTask(!this.task)

   -- Delete feeedback drawing
   !this.closed()

   -- Return to hierarchy position
   !!ce = !ce
     handle (2,822)
     endhandle

   -- Set calling form apply button active
   !!abauserview.apply.active = true

endmethod

--------------------------------------------------------------------
define method .closed()
--------------------------------------------------------------------
-- Called when form is closed

   -- Initialise variables
   !ce = !!ce

   -- Check for feedback drawing
   if (not !this.feedbackDept.badref()) then
     !!ce = !this.feedbackDept
     DELETE DEPT
       handle any
       endhandle

   endif

   -- Hide this form
   !this.hide()

   -- Return to hierarchy position
   !!ce = !ce
     handle (2,822)
     endhandle

endmethod
