--
-- File:            samgriddimn.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 July 2000
--
--
-- Description:
-- Create dimensions between gridlines
-------------------------------------------------------------------------
--
-- LIMITATIONS:
-- Currently only added to orthogonal views
-- Does not create a dimension if the grids symbols do not exist
--
-------------------------------------------------------------------------
--
-- ASSUMPTIONS:
-- That the VIEW is the current element
--
-------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of string arguments
--                           Argument 1 is the distance from the view limits to the dimension line
--                           Argument 2 is dimension text character height
--                           Argument 3 is dimension text colour
--                           Argument 4 is to allow a separate call to this function to create the DPPTs only
--                                      passes the view dbref
--                           Argument 5 is to allow a separate call to this function to create the DPPTs only
--                                      passes which group to create
--
------------------------------------------------------------------------
define function !!samGridDimn(!arguments is ARRAY)

  -- Initialise variables
  if (undefined(!arguments[4])) then
    !viewRefe = !!ce
  else
    !viewRefe = !arguments[4]
  endif
  !adeg   = !viewRefe.adeg
  !rcode  = !viewRefe.rcode
  !margin = !arguments[1].real()
  !dtch   = !arguments[2]
  !dtpen  = !arguments[3]
  VAR !viewDir APPEND VIEWDIR U
  VAR !viewDir APPEND VIEWDIR R


  -- Check for no gridline symbols
  var !ULaye coll all laye wi SpPURP eq 'GRIDT' for $!viewRefe
  var !LLaye coll all laye wi SpPURP eq 'GRIDL' for $!viewRefe
  if (!ULaye.empty() and !LLaye.empty() ) then
    !!abaLogging.error('      Cannot build dimensions - The gridlines do not exist')
    return
  endif

  -- Get view limits
  -- This is intentionally as a string, since saves formatting into sequence suitable for the collect command
  !idliRefe = !viewRefe.idln
  var !limits limits of $!idliRefe
  !limits = !limits.after('From ')

  -- Get view limits on page
  var !vReg split VREG of $!viewRefe
  !xMin = !vReg[3].real(!!distanceFMT)
  !xMax = !vReg[8].real(!!distanceFMT)
  !yMin = !vReg[5].real(!!distanceFMT)
  !yMax = !vReg[10].real(!!distanceFMT)

  -- Calculate view limits positions for start and end of dimension strings
  var !TL enupos of X $!xMin Y $!yMax
  var !TR enupos of X $!xMax Y $!yMax
  var !BL enupos of X $!xMin Y $!yMin

  -- Calculate dimension page positions
  !UDpos = 'X' & !xMin & ' Y' & (!yMax + !margin)
  !LDpos = 'X' & (!xMin - !margin) & ' Y' & !yMax

  -- Get into position in hierarchy by finding any existing layer
  if (undefined(!arguments[4])) then

    var !dimnLaye coll all laye wi SpPURP eq 'GDIM' for $!viewRefe
    if (!dimnLaye.empty()) then

      -- Create the laye
      !!ce = !viewRefe
      !layeName = !viewRefe.flnm & '/Grid_dimensions'
      NEW LAYE $!layeName
      SpPURP GDIM  PURP DIMG

    else

      -- Access the existing laye and delete all existing elements
      !!ce = !dimnLaye[1].dbref()
      DELETE LAYE MEM

    endif

  endif

  -- Process each side
  do !count from 1 to 2

    -- Test for which group to create during a separate call
    if (defined(!arguments[5])) then
      skip if (!count.neq(!arguments[5]))
    endif

    -- Initialise variables
    if (!count.eq(1)) then
      var !allSymb coll all (slab glab) for $!ULaye[1]
      !start = !TL
      !finish = !TR
      !direction = !viewDir[2]
      !dpos = !UDpos
    else
      var !allSymb coll all (slab glab) for $!LLaye[1]
      !start = !BL
      !finish = !TL
      !direction = !viewDir[1]
      !dpos = !LDpos
    endif

    -- Dimension to view limits
    if (undefined(!arguments[4])) then

      -- Create dimension
      NEW LDIM
       DPOS $!dpos
       DIR $!direction
       DTCH $!dtch  DTCOLOUR $!dtpen
       NEW DPOI POS $!start
       NEW DPOI POS $!finish

    endif

    -- Dimension to each gridline ddnm
    do !symb val !allSymb

      -- Initialise variables
      !ddnmRefe = !symb.dbref().ddnm
      !apof = !symb.dbref().apof

      -- Create dimension point
      NEW DPPT ON $!ddnmRefe
       OSHT 0

      -- Set projectionline clearance to relevant apof of symbol
      if (!apof[1].neq(0)) then
        !plcl = !apof[1].real().abs()
        PLCL $!plcl
      else
        !plcl = !apof[2].real().abs()
        PLCL $!plcl
      endif

    enddo

    -- Sort the dimension
    SORT DIM

  enddo

endfunction
