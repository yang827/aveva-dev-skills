-- File:            samkeyplan.pmlfnc
--   Type:          Function Definition
--   Group:         draft
--     Keyword:     ABA
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         03 June 1999
--
--
-- Description:
-- A method of hatching a keyplan
--
-- Methodology:
-- The keyplan is defined as a VIEW element with sppurp set to ABAK
-- The hatched area is simply a OUTL element created under a VNOT
-- that represents the drawing limits.
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of STRINGs
--                            1 = Line Style
--                            2 = Line Colour
--                            3 = Hatching Style
--                            4 = Hatching Colour
--
-- ASSUMPTIONS
-- The current element must be the VIEW to be processed
--
------------------------------------------------------------------------
define function !!samKeyPlan(!arguments is ARRAY)

   -- Initialise variables
   !viewRefe = !!ce
   !lstyle = !arguments[1]
   !lColor = !arguments[2]
   !fstyle = !arguments[3]
   !fColor = !arguments[4]

   -- Get all view with area limits
   VAR !areaView coll ALL VIEW WI SPPURP EQ 'ABAT' FOR $!viewRefe.owne

   -- Get area limits from any of the found views as they are all the same
   !abaView = object ABAVIEW()
   !abaView.abaview(!areaView[1].dbref().idln)
   !minPos = !abaView.startpos
   !maxPos = !abaview.endpos

   -- Find and process any keyplan views
   VAR !views COLLECT ALL VIEW WITH SPPURP EQ 'ABAK' FOR $!viewRefe.owner
   do !index ind !views

     -- Initialise variables
     !layeName = !views[!index].dbref().name & '/KeyplanHatch'

     -- Access view
     !!ce = !views[!index].dbref()

     -- Create hierarchy
     var !exist exist $!layeName
     if (!exist.eq('FALSEA')) then
       NEW LAYE $!layeName
       SpPURP KEYP  PURP KEYP
     else
       !!ce = !layeName.dbref()
       DELETE LAYE MEM
     endif

     NEW VNOT
      BLNK FALSE

     NEW OUTL
       NLStyle $!lstyle
       NLColour $!lColor
       FStyle $!fstyle
       FColour $!fColor

     NEW VRTX at E $!minPos.east N $!minPos.north U 0
     NEW VRTX at E $!minPos.east N $!maxPos.north U 0
     NEW VRTX at E $!maxPos.east N $!maxPos.north U 0
     NEW VRTX at E $!maxPos.east N $!minPos.north U 0
     NEW VRTX SPAN TO CLOSE

  enddo

  -- Return to view
  !!ce = !viewRefe

endfunction
