-- File:            samscale.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 July 2000
--
--
-- Description:
-- Create a scale on the View
-------------------------------------------------------------------------
--
-- ASSUMPTIONS:
-- That the VIEW is the current element
--
-------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of string arguments
--                           Argument 1 is the character separating the ratio
--                           Argument 2 is the text character height
--                           Argument 3 is the text pen
--                           Argument 4 is the text font
--                           Argument 5 is the text alignment
--                           Argument 6 is the text justification
--                           Argument 7 is the X position on the page
--                           Argument 8 is the Y position on the page
--
------------------------------------------------------------------------
define function !!samScale(!arguments is ARRAY)

  -- Initialise variables
  !viewRefe = !!ce
  !separator = !arguments[1]
  !tch = !arguments[2]
  !tpen = !arguments[3]
  !font = !arguments[4]
  !alig = !arguments[5]
  !just = !arguments[6]
  !xPos = !arguments[7]
  !yPos = !arguments[8]

  -- Calculate and set scale ratio
  !ratio = 1 / !viewRefe.vsca
  VRAT 1 $!ratio

  -- Get into position in hierarchy by finding any existing layer
  var !allLaye coll all laye wi SpPURP eq 'SCALE' for $!viewRefe
  if (!allLaye.empty()) then

    -- Create the laye
    !!ce = !viewRefe
    !layeName = !viewRefe.flnm & '/Scale'
    NEW LAYE $!layeName
    SpPURP SCALE

  else

    -- Access the existing laye and delete all existing elements
    !!ce = !allLaye[1].dbref()
    DELETE LAYE MEM

  endif

  -- Create text element
  NEW VNOT
  NEW TEXP
    CHEI $!tch  TPEN $!tpen  FONT $!font  ALIG $!alig  JUST $!just
    ORIGIN X $!xPos Y $!yPos
    BTEX '#VRAT[1]<FR VIEW>$!separator#VRAT[2]<FR VIEW>'

endfunction
