--
-- Description:
--    Main form for ceiling definitions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accCeilingDefinition()           -                   Constructor
--  backToMainRoomDesignTasks()      -                   Switching to Main Room Design Tasks
--  ceilingCreate()                  -                   Create Ceiling
--  ceilingGeometry(BOOLEAN)         -                   Switch to geometry modification pane
--  ceilingGeometry(DBREF)           -
--  ceilingGrid()                    -                   Ceiling grid gadget
--  ceilingList()                    -                   Update the list of ceilings
--  ceilingModGeometry()             -                   Switch to geometry modification pane for current element
--  ceilingModify()                  BOOLEAN             Modify Ceiling
--  ceilingModify(DBREF)             BOOLEAN             Setup to modify ceiling
--  ceilingThickness(GADGET,STRING)  -                   Set Physical Ceiling Thickness
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  create()                         -                   Create element
--  createCeiling(BOOLEAN)           -                   Display ceiling pane in create mode
--  deleteCeiling()                  -                   Delete CEILING
--  dummy()                          -                   Dummy method for unset
--  elevation()                      -                   Set elevation of level
--  exampleWarning1()                -
--  geometry()                       -                   Define geometry for element
--  geometryUpdate(SHAPEDEFINITION)  -                   Update with returned data
--  hAngle(GADGET,STRING)            -                   Set horizontal angle
--  height(GADGET,STRING)            -                   Set height of element
--  initialise()                     -                   Initialise form.
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  modify()                         -                   Modify (write modified values to DB)
--  modifyCeiling(BOOLEAN)           -                   Display ceiling pane in modify mode
--  modifyGeometry()                 -                   Modify geometry
--  nAngle(GADGET,STRING)            -                   Set angle from owners Y axis
--  offset()                         -                   Set the xyOffset of element
--  offset(EDGPOSITIONDATA)          -                   Map picked position to ceiling offset
--  physicalCeiling()                -                   Thickness of physical ceiling gadget
--  pickOffset()                     -                   Setup EDG pick event for picking position
--  refresh()                        -                   Refresh form from navigator.
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  select(ARRAY)                    -                   Select from list of ceilings
--  selectMaterial()                 -
--  setMaterial(STRING)              -
--  updateAttributes()               -                   Update gadgets with object data
--  updateData()                     -                   Update current data with gadget values
--  updateSelectedMaterial()         -
--  useOwnersGeometry()              -                   Use owning boundary definition (if there is one)
--  warning(ARRAY,STRING)            -                   Set warning task and message with default "Continue"
--  warning(ARRAY,STRING,STRING)     -                   Set warning task and message
--  warningDone()                    -                   Exit warning
--

setup form !!accCeilingDefinition dialog docking right

  !this.formTitle     = 'Ceiling Definition'
  !this.iconTitle     = 'Ceiling'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.definition.tidy()'
  !this.killingCall   = '!this.definition.tidy()'
  !this.formRevision  = ' $Revision$ '

  -- Current hierarchy
  paragraph .currentOwner                     anchor top + left + right         at x0.5                   ymax                width 30 lines 1

  -- Main Task Pane
  frame .mainTaskPane panel                   anchor top + left + right         at x0                     ymax.currentOwner

    paragraph .ceilingSelect                                                    at xmin                   ymax+0.2            text 'Select Ceiling'
    -- List of ceilings
    container .ceilingList PMLNetCONTROL 'NET'  anchor left + right + top       at x2                     ymax+0.2            width 30 lines 8

    -- Create options
    paragraph .createTasks                                                      at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskL1                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtCrt         linkLabel 'Ceiling'                                   at x2                     ymax                callback '!this.ceilingCreate()'

    -- Modify options
    paragraph .modifyTasks                                                      at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskL2                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtMod         linkLabel 'Ceiling Definition'                        at x2                     ymax                callback '!this.ceilingModify()'
    button .mtGeom        linkLabel 'Ceiling Geometry'                          at xmin                   ymax                callback '!this.ceilingGeometry(!this.element)'

    -- Delete options
    paragraph .deleteTasks                                                      at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskL4                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtDel         linkLabel 'Delete Ceiling'                            at x2                     ymax                callback '!this.deleteCeiling()'

    paragraph .blTskBackMainIcon1            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain1     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit

  -- Ceiling creation/modification pane
  frame .editPane panel                             anchor top + left + right   at x0                     ymax.currentOwner

    paragraph .editTitle                            anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .editLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Gadgetry definition for creation
    text .dbName  'Name:'  tagwidth 9               anchor top + left + right   at x2                     ymax+0.2            callback '!this.checkName(!this.dbName, !this.definition.name)' width 20 is STRING
    path down
    halign right
    text .dbDescription 'Description:' tagwidth 9   anchor top + left + right                                                 callback '' width 20 is STRING
    text .dbFunction 'Function:'       tagwidth 9   anchor top + left + right                                                 callback '' width 20 is STRING
    numericinput .dbNumber 'Number:'   tagwidth 9   anchor top + left           at xmin                   ymax+0.2            callback '' range 0 10000 ndp 0 width 4

    -- Positioning
    paragraph .location                             anchor top + left + right   at x0.5                   ymax+0.2            text 'Location:' width 28 lines 1
    line .editLine2                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Angle from Y axis
    numericinput .nAngle 'Angle from OWNER Y axis:'  tagwidth 21 anchor t + l    at x2                     ymax+0.2            callback '!this.nAngle('  range 180 -180 ndp 0 width 4

    -- Angle from horizontal
    numericinput .hAngle 'Angle from horizontal:'   tagwidth 21 anchor t + l    at xmin                   ymax+0.2            callback '!this.hAngle('  range 90 -90 ndp 0 width 4

    -- Ceiling height
    text .clnHeight 'Ceiling height:'  tagwidth 11  anchor top + left           at x2                     ymax+0.5            callback '!this.elevation()' width 14  is REAL format !!distanceFmt

    -- XY Offset of floor from building origin
    button .offset linkLabel 'Ceiling Offset'       anchor top + left + right   at x2                     ymax+0.2            callback '!this.pickOffset()' width 20
    text .xOffset   'X:'                            anchor top + left + right   at xmin+4                 ymax                callback '!this.offset()' width 21 is REAL format !!distanceFmt
    text .yOffset   'Y:'                            anchor top + left + right   at xmin                   ymax+0.2            callback '!this.offset()' width 21 is REAL format !!distanceFmt

    -- Defaults
    frame .criteria FoldUpPanel 'Design Criteria' anchor top + left + right     at x0                     ymax+0.5            width 32

      -- Colour scheme
      combo .colSchema 'Colour Schema:' tagwidth 11 anchor t + l                at x0.5                   ymax+0.5            width 13

      -- Fire rating
      combo .fireRating 'Fire rating:'  tagwidth 11 anchor t + l                at x0.5                   ymax+0.5            width 13

    exit

    -- Defaults
    frame .defaults FoldUpPanel 'Defaults'          anchor top + left + right   at x0                     ymax+0.5            width 32

      combo .clnType 'Ceiling Type:'           tagwidth 10 anchor t + l         at xmin                   ymax+0.5            width 13
      combo .clnCode 'Ceiling Code:'           tagwidth 10 anchor t + l         at xmin                   ymax+0.2            width 13

    exit

    -- Modification data specific to a ceiling
    frame .modPane panel                            anchor top + left + right   at x0                     ymax+0.5

      -- Accept Changes
      paragraph .modAcceptIcon                      anchor top + left           at x0                     ymax+0.2            pixmap width 16 height 16
      button .modAccept  linkLabel 'Accept Changes' anchor top + left           at xmax+0.5               ymin                callback '!this.modify()' width 10

      -- Discard Changes
      paragraph .modDiscardIcon                     anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
      button .modDiscard linkLabel 'Discard Changes' anchor top + right         at xmax+0.5               ymin                callback '!this.ceilingModify()' width 10

      paragraph .modBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      button .modMain   linkLabel   'Back to main ceiling tasks'                at xmax+1                 ymin                callback '!this.mainTasks(true)'

    paragraph .blTskBackMainIcon2            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain2     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20


    exit

    -- Creation data specific to a ceiling
    frame .crtPane panel                            anchor top + left + right   at xmin.modPane           ymin.modPane

      paragraph .createGeometry                     anchor top + left + right   at x0.5                   ymax                text 'Geometry' width 28 lines 1
      line .editLine3                               anchor top + left + right   at xmin                   ymax                horizontal width 32

      -- Define geometry definition method
      text .clnVoid 'Void height:' tagwidth 10      anchor top + left + right   at x2                     ymax+0.2            callback '!this.height(' width 19 is REAL format !!distanceFmt

      -- Define geometry
      toggle .crtShapeO 'Use owning ELEMENT geometry' tagwidth 28 anchor t + l + r  at xmin               ymax+0.2            callback '!this.useOwnersGeometry()'
      button .crtShape linkLabel  'Define ceiling geometry:' anchor t + l + r   at xmin                   ymax+0.2            callback '!this.geometry()' width 28
      paragrap .crtShapeDef                         anchor top + left + right   at xmin+2                 ymax                width 28 lines 1

      -- Create Floor/Ceiling
      paragraph .createOptions                      anchor top + left + right   at x0.5                   ymax+0.5            text 'Create options' width 28 lines 1
      line .editLine4                               anchor top + left + right   at xmin                   ymax                horizontal width 32

      toggle .crtCeilingGrid 'Create ceiling grid'      tagwidth 24     anchor t + l      at x2         ymax                callback '!this.ceilingGrid()'
      toggle .crtPhysCeiling 'Create Physical Ceiling'  tagwidth 24     anchor t + l      at x2         ymax                callback '!this.physicalCeiling()'
      text   .clnThick      'Thickness:'                tagwidth 10     anchor t + l      at x2         ymax+0.2            callback '!this.ceilingThickness(' width 19 is REAL format !!distanceFmt
      button .selMaterial linkLabel  'Material...'                      anchor t + l      at xmin       ymax+0.2            callback '!this.selectMaterial()' width 9
      para   .clnMaterial                                               anchor t + l      at xmax+0.5   ymin                text 'Nulref'     width 20

      -- Create ceiling
      paragraph .crtAcceptIcon                      anchor top + left           at x0                     ymax+0.2            pixmap width 16 height 16
      button .crtAccept linkLabel 'Create Ceiling'  anchor top + left           at xmax+1                 ymin+0.1            callback '!this.create()' width 12

      paragraph .crtBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .crtMain   linkLabel 'Back to main ceiling tasks'                  at xmax+1                 ymin                callback '!this.mainTasks(true)'

    paragraph .blTskBackMainIcon3            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain3     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20


    exit

  exit

  -- Modify geometrical information
  frame .modGeometry panel                          anchor top + left + right   at x0                     ymax.currentOwner

    paragraph .geomTitle                            anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .geomLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Define geometry definition method
    text .gClnVoid 'Ceiling Void:' tagwidth 10      anchor top + left + right   at x2                     ymax+0.2            callback '!this.height(' width 19 is REAL format !!distanceFmt
    button .mtModGeom     linkLabel 'Ceiling Geometry Definition'               at x2                     ymax                callback '!this.ceilingModGeometry()'

    -- Accept Changes
    paragraph .gModAcceptIcon                       anchor top + left           at x0                     ymax+0.2            pixmap width 16 height 16
    button .gModAccept  linkLabel 'Accept Changes'  anchor top + left           at xmax+0.5               ymin                callback '!this.modifyGeometry()' width 10

    -- Discard Changes
    paragraph .gModDiscardIcon                      anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
    button .gModDiscard linkLabel 'Discard Changes' anchor top + right          at xmax+0.5               ymin                callback '!this.ceilingGeometry(!this.element)' width 10

    paragraph .gModBackIcon                         anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .gModMain   linkLabel  'Back to main ceiling tasks'                  at xmax+1                 ymin                callback '!this.mainTasks(true)'

    paragraph .blTskBackMainIcon4            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain4     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20


  exit

  -- Warning Task Pane
  frame .warningPane panel                    anchor top + left + right         at x0                     ymax.currentOwner

    paragraph .warningHeader                                                    at x0                     ymax                text 'Warning'
    line .warningLine                         anchor top + left + right         at x0                     ymax                horizontal width 32
    paragraph .warningIcon                    anchor left + top                 at x0.5                   ymax+0.2            pixmap width 32 heigh 32
    paragraph .warning                        anchor left + right + top         at xmax+2                 ymin                width 26 lines 6
    button    .warningDone linkLabel 'Continue' anchor left + top               at x0.5                   ymax                callback '!this.warningDone()' width 28

  exit

  -- Form Members

  -- Alternative text for owning element type
  member .ownerAltText    is STRING

  -- Owning element
  member .owningElement   is DBREF
  member .ownerType       is STRING

  -- Current Element (ceiling)
  member .element         is DBREF
  member .definition      is DBECEILING

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK
  member .refreshTask     is BLOCK

  -- Warning action
  member .warningAction   is BLOCK

  -- Undo for form
  member .undo            is UNDOABLE

  -- EDG Description
  member .edgDescription  is STRING

  -- Aid Numbers
  member .aidAxes         is REAL
  member .outerBoundary   is REAL
  member .innerBoundaries is REAL

  -- Grid control
  using namespace 'Aveva.Pdms.Presentation'
  member .contentGrid       is NETGRIDCONTROL

  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
  --!!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accCeilingDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accCeilingDefinition()

  -- Set form to autoScroll
  !this.autoScroll              = true

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!this.dummy()')
  !this.refreshTask             = object BLOCK('!this.dummy()')

  -- Collapse fold-up panels
  !this.defaults.expanded       = false
  !this.criteria.expanded       = false

  -- Set events for numeric gadgets
  !this.nAngle.modifiedEvents   = true
  !this.hAngle.modifiedEvents   = true

  -- Load information from Configuration
  !this.refreshConfig()

 -- Initialise task panes
  !this.mainTasks(true)
  !this.createCeiling(false)
  !this.modifyCeiling(false)
  !this.warningPane.visible     = false

  -- Set "Back" icon
  !backIcon                     = !!pml.getpathname('back.png')
  !this.crtBackIcon.addPixmap(!backIcon)
  !this.modBackIcon.addPixmap(!backIcon)
  !this.gModBackIcon.addPixmap(!backIcon)

  !this.blTskBackMainIcon1.addPixmap(!backIcon)
  !this.blTskBackMainIcon2.addPixmap(!backIcon)
  !this.blTskBackMainIcon3.addPixmap(!backIcon)
  !this.blTskBackMainIcon4.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getpathname('create.png')
  !this.crtAcceptIcon.addPixmap(!createIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getpathname('accept.png')
  !this.modAcceptIcon.addPixmap(!acceptIcon)
  !this.gModAcceptIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getpathname('discard.png')
  !this.modDiscardIcon.addPixmap(!discardIcon)
  !this.gModDiscardIcon.addPixmap(!discardIcon)

  -- Set "Warning" icon
  !warningIcon                  = !!pml.getpathname('exclamation-32.png')
  !this.warningIcon.addPixmap(!warningIcon)

  -- EDG Description
  !this.edgDescription    = 'Accommodation Ceiling Definition'

  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- Add .Net control to PML container for contents
  !this.contentGrid             = object NETGRIDCONTROL()
  !this.ceilingList.control     = !this.contentGrid.handle()

  -- Events handled
  !this.contentGrid.addeventhandler('afterSelectChange', !this, 'select')

  -- Load information from Configuration
  !this.contentGrid.columnExcelFilter(false)
  !this.contentGrid.outlookGroupStyle(false)
  !this.contentGrid.columnSummaries(false)
  !this.contentGrid.fixedHeaders(false)
  !this.contentGrid.fixedRows(false)
  !this.contentGrid.singleRowSelection(true)


  -- Assign aid numbers for form
  !this.aidAxes           = !!aidNumbers.add('Ceiling - Axes')
  !this.outerBoundary     = !!aidNumbers.add('Ceiling - OuterBoundary')
  !this.innerBoundaries   = !!aidNumbers.add('Ceiling - InnerBoundaries')

  -- Populate combo with defaults
  !this.colSchema.dtext   = !!accConfig.colourSchemes()
  !this.fireRating.dtext  = !!accConfig.fireRatings()
  !this.clnType.dtext     = !!accConfig.ceilingTypes()
  !this.clnCode.dtext     = !!accConfig.ceilingCodes()

  -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dummy
--
-- Description: Dummy method for unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dummy()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Get current element
  !element                = !!accNavigator.currentSelection()

  -- If element is unset, then initialise form with limited actions
  if(!element.unset()) then
    !this.owningElement         = object DBREF()
    !this.currentOwner.val      = 'No active element selected'

    !this.mtMod.active          = FALSE
    !this.mtGeom.active         = FALSE
    !this.mtDel.active          = FALSE

  -- Initialise form with relevant actions
  else

    -- Set owner where layout data is to be stored
    !this.owningElement         = !element
    !this.ownerType             = !this.owningElement.type
    --!this.ownerAltText          = !!accConfig.attribute(!this.ownerType)
    !this.currentOwner.val      = 'Active element: ' & !this.owningElement.namn


    -- Update Grid with list of ceilings
    !this.ceilingList()

  endif
  !this.clnThick.val = 0

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh form from navigator.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh task
  if(!this.shown()) then
    !this.initialise()
    !this.refreshTask.evaluate()
    !this.definition.tidy()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Ceiling Tasks
  !this.createTasks.val         = 'Create'
  !this.modifyTasks.val         = 'Modify'
  !this.deleteTasks.val         = 'Delete'

  -- Ceiling Editing Tags
  !this.nAngle.tag              = 'Angle from Y axis:'

  -- get the latest configuration information
  !this.colSchema.dtext   = !!accConfig.colourSchemes()
  !this.fireRating.dtext  = !!accConfig.fireRatings()
  !this.clnType.dtext     = !!accConfig.ceilingTypes()
  !this.clnCode.dtext     = !!accConfig.ceilingCodes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.mainTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.mainTasks(false)')
    !this.refreshTask         = object BLOCK('!this.dummy()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Main Ceiling Tasks'

  endif

  -- Show/hide task pane
  !this.mainTaskPane.visible = !active

  -- show/hide gadgets for physical ceiling thickness and material
  !this.physicalCeiling()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createCeiling
--
-- Description: Display ceiling pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createCeiling(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.createCeiling(false)')
    !this.refreshTask         = object BLOCK('!this.ceilingCreate()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Create Ceiling'

    -- Manage create/modify panels
    !this.modPane.visible     = false
    !this.crtPane.visible     = true
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyCeiling
--
-- Description: Display ceiling pane in modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyCeiling(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.modifyCeiling(false)')
    !this.refreshTask         = object BLOCK('!this.ceilingModify()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Ceiling'

    -- Manage create/modify panels
    !this.modPane.visible     = true
    !this.crtPane.visible     = false
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      ceilingList
--
-- Description: Update the list of ceilings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingList()

  -- Collect ceilings
  !contents = object ACCCOLLECTCONTENTS()

  -- Get ceiling for
  if(!contents.scope(!!accNavigator.currentSelection())) then
    !ceilings = !contents.collectAllOfType('CEILIN')

    -- Headings
    !headings     = ARRAY()
    !headings.append('Name')
    !headings.append('Description')
    !headings.append('Owner')

    -- Build tables
    !table        = ARRAY()

    do !ceiling values !ceilings
      !table.append(!ceiling.name)

    enddo

    -- Load grid
    using namespace 'Aveva.Pdms.Presentation'
    !nds          = object NETDATASOURCE('CeilingGrids', !headings, !table)
    !this.contentGrid.bindToDataSource(!nds)

    if (!table.size() lt 1) then
      !this.mtMod.active          = FALSE
      !this.mtGeom.active         = FALSE
      !this.mtDel.active          = FALSE
    else
      !this.contentGrid.selectRow(1)
    endif

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      ceilingCreate
--
-- Description: Create Ceiling
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingCreate()

  -- Initialise Variables

  -- Set definition
  !this.definition            = object DBECEILING()
  !this.definition.initialise(!this.owningElement)
  handle (2,754)
    !this.mtCrt.active = FALSE
    return FALSE
  endhandle

  -- Edit panel title
  !this.editTitle.val         = 'New ceiling for ' & !this.owningElement.namn
  !this.crtShapeDef.val       = 'None currently defined'

  -- Populate form with default information (where possible)
  if(!this.owningElement.attributes().findFirst('ClnHeight').set()) then
    !clnHeight                = !this.owningElement.clnHeight
  elseif (!this.owningElement.attributes().findFirst('DClnHeight').set()) then
    !clnHeight                = !this.owningElement.dClnHeight
  elseif (!this.owningElement.attributes().findFirst('Heidefault').set()) then
    !clnHeight                = !this.owningElement.heiDefault
  else
    !clnHeight                = 0
  endif
  !this.definition.elevation(!clnHeight)

  -- Set numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Copy owning shape
  !this.useOwnersGeometry()

  -- Update gadgets
  !this.updateAttributes()

  -- Setup panes
  !this.createCeiling(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      ceilingModify
--
-- Description: Setup to modify ceiling
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Ceiling to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .ceilingModify() is BOOLEAN

  -- Check CEILING has been passed
  if(!this.element.fulltype.neq('CEILIN')) then
    !!error.text            = 'Element "' & !this.element.namn & '" is not a Ceiling.'
    return false
  endif

  -- Set definition
  !this.definition          = object DBECEILING(!this.element)

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Edit panel title
  !this.editTitle.val       = 'Modify Ceiling: ' & !this.element.namn

  -- Update gadgets
  !this.updateAttributes()

  -- Setup panes
  !this.modifyCeiling(true)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      ceilingModify
--
-- Description: Setup to modify ceiling
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Ceiling to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .ceilingModify(!element is DBREF) is BOOLEAN

  -- Check CEILING has been passed
  if(!element.fulltype.neq('CEILIN')) then
    !!error.text            = 'Element "' & !element.namn & '" is not a Ceiling.'
    return false
  endif

  -- Load current element
  !this.element             = !element

  -- Set definition
  !this.definition          = object DBECEILING(!element)

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Edit panel title
  !this.editTitle.val       = 'Modify Ceiling: ' & !this.element.namn

  -- Update gadgets
  !this.updateAttributes()

  -- Setup panes
  !this.modifyCeiling(true)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      ceilingModGeometry
--
-- Description: Modify geometry for ceiling (needs to pass current geometry to shape editor)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingModGeometry()

  -- use the accProfileEdit function
  if(defined(!!dbeProfileEdit)) then
    !!dbeProfileEdit.close()
  endif

  -- Check if there is a boundary defined
  if(!this.definition.outerLoop.set()) then
  --  !boundary           = !!dtbMemberOfType(!this.element,'LOOP',1)
    !!accProfileEdit(!this.element)
  else
    !this.geometry()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      ceilingGeometry
--
-- Description: Setup to modify geometry for specified element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingGeometry(!element is DBREF )

  if(!element.fulltype.neq('CEILIN')) then
    !!error.text            = 'Element "' & !element.namn & '" is not a Ceiling.'
    return false
  endif

  -- Load current Ceiling
  !this.element                   = !element

  -- Set definition
  !this.definition          = object DBECEILING(!this.element)

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Edit panel title
  !this.geomTitle.val       = 'Modify Ceiling: ' & !this.element.namn

  -- Update attributes
  !this.gClnVoid.val        = !this.definition.clnVoid

  -- Display pane
  !this.ceilingGeometry(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      ceilingGeometry
--
-- Description: Switch to geometry modification pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingGeometry(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.modGeometry

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.ceilingGeometry(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Ceiling Geometry'

    -- Draw
    !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.modGeometry.visible   = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateAttributes
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAttributes()

  -- Set values of gadgets from DBECEILING object
  !this.dbName.val        = !this.definition.name
  !this.dbDescription.val = !this.definition.description
  !this.dbFunction.val    = !this.definition.function
  !this.dbNumber.val      = !this.definition.number
  !this.nAngle.val        = !this.definition.nAngle
  !this.hAngle.val        = !this.definition.hAngle
  !this.xOffset.val       = !this.definition.xyOffset[1]
  !this.yOffset.val       = !this.definition.xyOffset[2]
  !this.clnVoid.val       = !this.definition.clnVoid
  !this.clnHeight.val     = !this.definition.clnHeight

  if(!this.definition.clnMaterial.badref().not()) then
    !this.clnMaterial.val   = !this.definition.clnMaterial.namn
  else
    !this.clnMaterial.val   = 'Nulref'
  endif

  if ((!this.definition.colSchema.set()) and (!this.definition.colSchema.neq(''))) then
    do !i indices !this.colSchema.dtext
      if (!this.colSchema.dtext[!i] eq !this.definition.colSchema) then
        !this.colSchema.select('dtext' , !this.colSchema.dtext[!i])
      endif
    enddo
  else
    !this.colSchema.clearSelection()
  endif

  if ((!this.definition.fireRating.set()) and (!this.definition.fireRating.neq(''))) then
    do !i indices !this.fireRating.dtext
      if (!this.fireRating.dtext[!i] eq !this.definition.fireRating) then
        !this.fireRating.select('dtext' , !this.fireRating.dtext[!i])
      endif
    enddo
  else
    !this.fireRating.clearSelection()
  endif

  if ((!this.definition.clnType.set()) and (!this.definition.clnType.neq(''))) then
    do !i indices !this.clnType.dtext
      if (!this.clnType.dtext[!i] eq !this.definition.clnType) then
        !this.clnType.select('dtext' , !this.clnType.dtext[!i])
      endif
    enddo
  else
    !this.clnType.clearSelection()
  endif

  if ((!this.definition.clnCode.set()) and (!this.definition.clnCode.neq(''))) then
    do !i indices !this.clnCode.dtext
      if (!this.clnCode.dtext[!i] eq !this.definition.clnCode) then
        !this.clnCode.select('dtext' , !this.clnCode.dtext[!i])
      endif
    enddo
  else
    !this.clnCode.clearSelection()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateData
--
-- Description: Update current data with gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateData()

  -- Initialise Variables
  if(!this.dbName.val.set()) then
    !this.definition.name         = !this.dbName.val
  endif

  !this.definition.description    = !this.dbDescription.val
  !this.definition.function       = !this.dbFunction.val
  !this.definition.number         = !this.dbNumber.val
  !this.definition.clnHeight      = !this.clnHeight.val
  !this.definition.clnVoid        = !this.clnVoid.val
  !this.definition.clnThick       = !this.clnThick.val

  !material = !this.clnMaterial.val
  if(!material.set() and !material.lowcase().neq('nulref') ) then
    !clnMaterial  = object DBREF('/' + !material)
    !this.definition.clnMaterial    = !clnMaterial
  endif

 --modified to get the user desired input
  !this.definition.colSchema      = !this.colSchema.displaytext()
  !this.definition.fireRating     = !this.fireRating.displaytext()
  !this.definition.clnType        = !this.clnType.displaytext()
  !this.definition.clnCode        = !this.clnCode.displaytext()

endmethod

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create()

 -- Check shape is defined, otherwise do not allow creation
 if !this.definition.outerLoop.area().eq(0) then
   !!alert.warning('Ceiling geometry must be defined before ceiling is created')
 else
  -- Reference Element
  !reference  = !!ce

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created ceiling')
  !this.undo.add()

  -- Navigate to Level
  !!ce                  = !this.owningElement

  -- Get detailing group
  !detailGroup    = !!accDetailGroup(!this.owningElement, 'CLN', 'Ceiling definitions')
  if(!detailGroup.unset()) then
    !!alert.warning('"temp" - ' & !!error.text)
    return
  endif

  -- Navigate to detail group
  !!ce            = !detailGroup

  -- Create new element
  if(!this.definition.create()) then
    !this.element = !this.definition.dbelement

    -- Define basic of Ceiling
    !ceilingBasics  = object ACCCEILINGBASICS(!this.definition)
    !ceilingBasics.defineCeilingGrid(!this.crtCeilingGrid.val)
    !ceilingBasics.definePhysicalCeiling(!this.crtPhysCeiling.val)

    -- Create basics
    !ceilingBasics.create()

    -- Switch to modify pane
    !this.ceilingModify()

    -- Refresh Content navigator
    !!acccontentnavigator.refresh()
    handle (2,751)
    endhandle

  -- Failed creating element
  else
    !!alert.warning(!!error.text)
  endif

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Return to original element
  !!ce        = !reference

  -- Refresh Ceiling List
  !this.ceilingList()
 endif
endmethod

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.element.namn & ')')
  !this.undo.add()

  -- Modify Ceiling
  if(!this.definition.modify().not())then
    !!alert.warning(!!error.text)
  endif

  -- Redraw graphical aids to update tag
  !this.definition.draw()
  !this.ceilingList()

  -- Refresh Content navigator
  !!acccontentnavigator.refresh()
  handle (2,751)
  endhandle

  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      modifyGeometry
--
-- Description: Modify geometry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyGeometry()

  !this.definition.clnVoid = !this.gClnVoid.val

  !this.element.position = !this.definition.outerLoop.position
  handle(2,795)
    !this.definition.tidy()
    !this.ceilingList()
    !this.mainTasks(TRUE)
    return FALSE
  endhandle

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.element.namn & ')')
  !this.undo.add()

  -- Modify Ceiling
  !this.definition.modify()

  -- Update any rules on the area definition
  RULE EXECUTE ALL ON ALL AEXTR FOR $!<this.element>
  handle ANY
  endhandle

  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      geometry
--
-- Description: Define geometry for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometry()

  -- Define data to pass to shape definition form
  !plane  = !this.definition.plane
  !shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)

  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form for return to bBlock creation
  -- Information for form is:
  --   Calling form
  --   Form title
  --   Apply tag (Test for "apply" button)
  --   Action on completion, method name only, method must be in format
  --      .methodName(<SHAPEDEFINITION>)
  --   Default shape, should be at least pos and ori of the plane the
  --   shape is to be mapped onto.
  !!shapeDefinitionEditor.setup(!this, 'Define Ceiling Boundary', 'Define Ceiling Boundary', 'geometryUpdate', !shape)

endmethod

------------------------------------------------------------------------
--
-- Method:      geometryUpdate
--
-- Description: Update with returned data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometryUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  !this.crtShapeDef.val       = !shapeDefinition.description

  !this.definition.position(!shapeDefinition.profile.position)
  !this.definition.outerLoop  = !shapeDefinition.profile
  !this.definition.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:      useOwnersGeometry
--
-- Description: Use owning boundary definition (if there is one)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useOwnersGeometry()

  -- Get gadget setting
  !useOwner             = !this.crtShapeO.val

  -- Make shape definition inactive
  !this.crtShape.active = !useOwner.not()

  -- Get owning geometry
  if(!useOwner) then

    -- Check if there is a boundary defined
    !boundary = BNDLIN 1 OF $!<this.owningElement>
    -- No boundary to use
    handle ANY
    -- Use owning boundary
    elsehandle NONE
      !plane    = !this.definition.plane
      !profile  = object PROFILE(LOOP 1 of $!<boundary> )
      !newShape = object SHAPEMODIFIER()
      !profile  = !newShape.intersect(!profile, !plane)

      -- Modify definition profile
      !shape      = object SHAPEDEFINITION(!plane.position, !plane.orientation)
      !shape.description  = 'Derived from owner'
      !shape.profile      = !profile
      !this.geometryUpdate(!shape)

    endhandle

 endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message with default "Continue"
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Done"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING)
  !this.warning(!message, !action, 'Continue')
endmethod
-- End of method

