define method .ceilingThickness(!gadget is GADGET, !select is STRING)
  !this.definition.ceilingThickness(!gadget.val)
  refresh
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Continue"
--    3   R      STRING      "Continue" text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING, !continue is STRING)

  -- Switch warning pane
  !this.currentPane.visible   = false
  !this.warningPane.visible   = true

  -- Concatenate message into a single line
  !display    = ''
  do !i indices !message
    !display  = !display & ' ' & !message[!i]
  enddo

  -- Display message
  !this.warning.val           = !display.trim()
  !this.warningDone.tag       = !continue

  -- Set "Continue" action (If the action is dependent on other criteria
  -- e.g. being in the correct position in the hierarchy, then the
  -- active state of the "Done" button needs to be managed.
  !this.warningAction         = object BLOCK(!action)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warningDone
--
-- Description: Exit warning
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warningDone()

  -- Hide warning pane
  !this.warningPane.visible   = false

  -- Execute action
  !this.warningAction.evaluate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      exampleWarning
--
-- Description: Example of how to use a warning with an action
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exampleWarning1()

  -- Define message to be displayed
  !message[1] = 'This is the message that is to be displayed in the '
  !message[2] = 'warning pane. The message can be up to 132 Characters'
  !message[3] = 'long.'
  !this.warning(!message, '!this.firstTaskPane(true)', !this.ftpWarningMsg.val)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteCeiling
--
-- Description: Delete CEILING
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteCeiling()

  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.element).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  endif
  -- Update list of ceiling following deletion
  !this.ceilingList()

  -- Refresh Content navigator
  !!acccontentnavigator.refresh()
  handle (2,751)
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select from list of ceilings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!dummyPassedArray is ARRAY)

  -- Initialise Variable
  !row                      = !this.contentGrid.getSelectedRows()

  if (!row.size() gt 0) then

    !this.element           = !row.first()[1].dbRef()
    handle ANY
      !this.ceilingList()
      return FALSE
    endhandle

    !!ce  = !this.element

    !this.mtCrt.active      = TRUE
    !this.mtMod.active      = TRUE
    !this.mtGeom.active     = TRUE
    !this.mtDel.active      = TRUE

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      physicalCeiling
--
-- Description: Thickness of physical ceiling gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .physicalCeiling()

 if !this.crtPhysCeiling.val then
 	 !this.crtCeilingGrid.val = FALSE
   !this.clnThick.visible    = true
   !this.selMaterial.visible = true
   !this.clnMaterial.visible = true
 else
   !this.clnThick.visible   = false
   !this.selMaterial.visible = false
   !this.clnMaterial.visible = false
 endif

endmethod
------------------------------------------------------------------------
--
-- Method:      ceilingGrid
--
-- Description: Ceiling grid gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ceilingGrid()

   if !this.crtCeilingGrid.val then
 	   !this.crtPhysCeiling.val = FALSE
 	   !this.clnThick.visible   = false
     !this.selMaterial.visible = false
     !this.clnMaterial.visible = false
   endif

endmethod
------------------------------------------------------------------------
--
-- Method:        selectMaterial
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectMaterial()

  -- Define form if required
  if(undefined(!!accInsurqMaterials)) then
    pml reload form !!accInsurqMaterials
  endif

  -- Setup form
  !action = '!!' & !this.name() & '.setMaterial(!material)'
  if(!this.definition.clnMaterial.badref()) then
    !materialString = 'NULREF'
  else
    !materialString = !this.definition.clnMaterial.namn
  endif

  !!accInsurqMaterials.setup(!materialString, !action)
  show !!accInsurqMaterials

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      setMaterial
--
-- Description: sets the material in the ceiling definition
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMaterial(!material is STRING )

  !matref = !material.dbRef()
  handle ANY
    !this.definition.clnMaterial = object DBREF()
  elsehandle none
    !this.definition.clnMaterial = !matref
  endhandle

  !this.updateSelectedMaterial()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        updateSelectedMaterial
--
-- Description:   updates the selected material to the form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateSelectedMaterial()

  if !this.definition.clnMaterial.set() then
    !this.clnMaterial.val    = !this.definition.clnMaterial.namn
  else
    !this.clnMaterial.val    = 'Nulref'
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      backToMainRoomDesignTasks
--
-- Description: Switching to Main Room Design Tasks
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backToMainRoomDesignTasks()

  !this.mainTasks(true)
  --!this.hide()
  !!accTaskManager.active('accDetail')
endmethod
-- End of method definition

------------------------------------------------------------------------
