--
--  Description:     Ceiling Fitting definition form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accCeilingFittings()             -                   Constructor
--  backToMainRoomDesignTasks()      -                   Switching to Main Room Design Tasks
--  ceilingGridList()                -                   Update the list of ceilings
--  ceilingList()                    -                   Update the list of ceilings
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  checkType()                      -                   Check selected fitting type and act accordingly
--  chooseTile(GADGET,STRING)        -                   Choose Tile from 3D View
--  clearFields()                    -                   Clear fields on creating a fitting
--  create()                         -                   Create fitting of selected type
--  createFitting(BOOLEAN)           -                   Display fitting pane in create mode
--  drawFitting(GADGET)              -                   Draw the position and orientation of the current fitting
--  dummy()                          -                   Dummy method for unset
--  findFitting(STRING)              -                   Use the stChooseSelection form to find the fitting
--  fittingCreate()                  -                   Create Grid
--  fittingDelete()                  -
--  fittingModify()                  -                   Modify Grid
--  fittingTasks(BOOLEAN)            -                   Set main tasks
--  getFittings()                    -                   Retrieves a list of all the current fittings in a grid
--  getGridCells()                   -                   Retrieve a list of cell IDs from the ceiling grid object
--  getGridLines()                   -                   Retrieve a list of gridlines in the X and Y directions
--  initialise()                     -                   Initialise form.
--  modify()                         -                   Modify fitting definition
--  modify(DBREF)                    -                   Modify a defined fitting
--  modifyFitt(BOOLEAN)              -                   Display fitting pane in modify mode
--  placement(GADGET,STRING)         -                   Open callback which alters the create pane
--  refresh()                        -                   Refresh form from navigator.
--  rotateFitting(GADGET,STRING)     -                   Rotate the currently selected fitting
--  selectFitting()                  -                   Sets the current fitting for deletion or modification
--  selectGrid(ARRAY)                -                   Set up form and centre view on selected ceiling grid
--  setSpref(STRING)                 -                   Set the Fitting Spref textbox value
--  tagCell(GADGET,STRING)           -                   Tag derived cell information
--  tagFitting(GADGET,STRING)        -                   Tag derived fitting information
--  tagLine(GADGET,STRING)           -                   Tag derived line information
--  tidy()                           -                   Tidy aid graphics
--  updateGadgets(STRING)            -                   Update relevant gadgets with detail information
--  updateLines(EDGPOSITIONDATA,STRING) -
--  updateTile(DBREF,STRING)         -                   Update form with data on chosen tile
--

setup form !!accCeilingFittings dialog dock right

  -- Form details
  !this.formTitle    = 'Ceiling Grid'
  !this.icontitle    = ''
  !this.callback     = '!this.initialise()'
  !this.cancelCall   = ''
  !this.formrevision = ''

  -- Current hierarchy
  paragraph   .currentOwner                                  anchor top + left + right      at x0.5        ymax                width 30 lines 1
  combo       .currOwnList 'Current Ceiling:' tagwidth 12    anchor top + left + right      at xmin        ymax+0.5            callback '!this.ceilingGridList()'      width 13

  frame       .fittingTaskPane panel                         anchor top + left + right      at x0          ymax

    -- List of Ceiling Grids
    paragraph .chooseGrid                                    anchor left + right + top      at xmin        ymax+0.5            text 'Select Grid:' width 30 lines 1
    container .ceilingList PMLNetCONTROL 'NET'               anchor left + right + top      at xmin        ymax+0.2            width 30 lines 8

    -- Create options
    paragraph .fittingTasks                                                                 at x0.5        ymax+1.5            text 'Fitting Tasks'
    line      .mainTaskL1                                    anchor top + left + right      at xmin        ymax                horizontal width 30

    button    .mtCrtFitt     linkLabel 'Create Fitting'                                     at x2          ymax                callback '!this.fittingCreate()'

    -- Current Fittings
    paragraph .existingFittings                                                             at x0.5        ymax+0.2            text 'Existing Fittings'
    line      .mainTasksL2                                   anchor top + left + right      at x2          ymax                horizontal width 30
    combo     .currFitt     'Choose Fitting:' tagwidth 10    anchor top + left + right      at xmin        ymax+0.2            callback '!this.selectFitting()' width 10
    button    .mtModFitt     linkLabel 'Modify Fitting'                                     at x2.5        ymax+0.5            callback '!this.modifyFitt(TRUE)'
    button    .mtDelFitt     linkLabel 'Delete Fitting'                                     at xmin        ymax+0.2            callback '!this.fittingDelete()'
    line      .mainTasksL3                                   anchor top + left + right      at x2          ymax                horizontal width 30
    paragraph .supTaskBackIcon                anchor top + left                             at x0          ymax+0.5            pixmap width 15 height 15
    button    .blTskMain     linkLabel 'Return to main tasks'                               at xmax+1      ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit

  frame       .createFittPane panel                          anchor top + left + right      at xmin.fittingTaskPane            ymax.currentOwner

    -- Create options
    paragraph .fittingSection                                                               at x0.5        ymax+0.5            text 'Fitting Details'
    line      .fittTaskL1                                    anchor top + left + right      at xmin        ymax                horizontal width 30

    -- Fitting Type
    combo     .fittingType 'Fitting Type:' tagwidth 12       anchor top + left + right      at xmin        ymax+0.5            callback '!this.checkType()'width 10

    -- Find Fitting
    paragraph .findFittIcon                                  anchor top + left             at x0.5        ymax+0.5            pixmap width 16 height 15
    button    .findFitt       linkLabel 'Select Ceiling Fitting Specification...'       anchor top + left            at xmax+.5    ymin                callback '!this.findFitting(!this.fittingType.selection())'

    text      .fittSpre    'Specification:'        tagwidth 12       anchor top + left + right      at x0.5        ymax+0.2            width 13 is STRING


    -- Create options
    paragraph .attribSection                                                                at x0.5        ymax+0.5            text 'Set Attributes'
    line      .fittTaskL2                                    anchor top + left + right      at xmin        ymax                horizontal width 30

    text      .fittName    'Name:'             tagwidth 12   anchor top + left + right      at x0.5        ymax+0.2            callback '!this.checkName(' width 13 is STRING
    text      .fittDesc    'Description:'      tagwidth 12   anchor top + left + right      at xmin        ymax+0.2            width 13 is STRING

    text      .infoText   'Info Text:'         tagwidth 12   anchor top + left + right      at xmin        ymax+0.2            width 13 is STRING
    text      .opTemp     'Operational Temp:'  tagwidth 12   anchor top + left + right      at xmin        ymin.infoText       width 13 is REAL  format !!temperatureFmt
    text      .fitHazard  'Hazard:'            tagwidth 12   anchor top + left + right      at xmin        ymin.infoText       width 13 is STRING
    text      .elRating   'Electrical Rating:' tagwidth 12   anchor top + left + right      at xmin        ymax+0.2            width 13 is REAL


    -- Fitting Positioning
    frame     .placeRGroup 'Fitting Placement'               anchor top + left + right      at xmin        ymax+0.2            width  30

      rToggle .rad1   'Relative to Grid Cell'  tagwidth 15   anchor top + left + right      at xmin+0.2    ymax+0.2            callback '!this.placement('
      rToggle .rad2   'Relative to Grid Line'  tagwidth 15   anchor top + left + right      at xmin+0.2    ymax+0.2            callback '!this.placement('

      button  .chooseTile linkLabel 'Pick Position'          anchor top + left + right      at xmin+0.2    ymax+0.2            callback '!this.chooseTile(' width 10


      combo   .cellX    'Cell ID:'   tagwidth 10             anchor top + left + right      at x2          ymax+0.2            callback '!this.tagCell(' width 8
      toggle  .replaceTile 'Replace Tile?' tagwidth 10       anchor top + left + right      at xmin        ymax+0.2

      combo   .lineX    'X Line:'   tagwidth 12              anchor top + left + right      at xmin.cellX  ymin.cellX          callback '!this.tagLine(' width 8
      combo   .lineY    'Y Line:'   tagwidth 12              anchor top + left + right      at xmin        ymax+0.2            callback '!this.tagLine(' width 8

    exit

    frame     .positionFrame 'Fitting Position'              anchor top + left + right      at xmin        ymax+0.2            width 30

      text    .xOffset  'X Offset: ' tagwidth 12             anchor top + left + right      at x0.5        ymax+0.2            callback '!this.tagFitting(' width 13 is REAL format !!distanceFmt
      text    .yOffset  'Y Offset: ' tagwidth 12             anchor top + left + right      at x0.5        ymax+0.2            callback '!this.tagFitting(' width 13 is REAL format !!distanceFmt

      numericinput .fittRotate 'Angle From Y:' tagwidth 12 anchor top + left + right    at xmin        ymax+0.2            callback '!this.rotateFitting(' range 180 -180 ndp 0 value 0 width 5

    exit

    -- Create Fitting
    paragraph .createFittIcon                                anchor top + left             at xmin        ymax+0.2            pixmap width 16 height 15
    button    .createFitt     linkLabel 'Create Fitting'     anchor top + left             at xmax+0.5    ymin                callback '!this.create()' width 10

    paragraph .dtBackIcon                                    anchor top + left              at x0          ymax+0.5            pixmap width 15 height 15
    button    .dtMain   linkLabel   'Back to Fitting tasks'                                 at xmax+1      ymin                callback '!this.fittingTasks(true)'

  exit

  frame       .modifyFittPane panel                          anchor top + left + right      at xmin.fittingTaskPane            ymax.currentOwner

    -- Create options
    paragraph .modFittSect                                                                  at x0.5        ymax+0.5            text 'Fitting Details'
    line      .modFittL1                                     anchor top + left + right      at xmin        ymax                horizontal width 30

    text      .modName    'Name:'              tagwidth 12   anchor top + left + right      at x0.5        ymax+0.2            callback '!this.checkName(' width 13 is STRING
    text      .modDesc    'Desc:'              tagwidth 12   anchor top + left + right      at xmin        ymax+0.2            width 13 is STRING

    text      .modInfo    'Info Text:'         tagwidth 12   anchor top + left + right      at xmin        ymax+0.2            width 13 is STRING
    text      .modOpTemp  'Operational Temp:'  tagwidth 12   anchor top + left + right      at xmin        ymin.modInfo        width 13 is REAL
    text      .modHazard  'Hazard:'            tagwidth 12   anchor top + left + right      at xmin        ymin.modInfo        width 13 is STRING
    text      .modElRate  'Electrical Rating:' tagwidth 12   anchor top + left + right      at xmin        ymax+0.2            width 13 is REAL

    -- Fitting Type
    combo     .modFittingType 'Fitting Type:'  tagwidth 12   anchor top + left + right      at xmin        ymax+0.5            callback '!this.checkType()'width 10

    paragraph .findModFittIcon                               anchor top + left             at x0.5        ymax+0.5            pixmap width 16 height 15
    button    .findModFitt    linkLabel 'Select Ceiling Fitting Specification...'       anchor top + left             at xmax+0.5    ymin                callback '!this.findFitting(!this.modFittingType.selection())'

    text      .fittModSpre    'Specification:'         tagwidth 12   anchor top + left + right      at x0.5        ymax+0.2            width 13 is STRING


    frame     .modPosFrame 'Fitting Position'                anchor top + left + right      at xmin        ymax+0.2            width 30

      button  .modCellPos linklabel 'Pick Position:'         anchor top + left + right      at x2          ymax+0.2            callback '!this.chooseTile(' width 10

      combo   .modCellX    'Cell ID:'          tagwidth 10   anchor top + left + right      at x2          ymax+0.2            callback '!this.tagCell(' width 8
      toggle  .modReplaceTile 'Replace Tile?'  tagwidth 10   anchor top + left + right      at xmin        ymax+0.2

      combo   .modLineX    'X Line:'           tagwidth 10   anchor top + left + right  at xmin.modCellX   ymin.modCellX       callback '!this.tagLine(' width 8
      combo   .modLineY    'Y Line:'           tagwidth 10   anchor top + left + right      at xmin        ymax+0.2            callback '!this.tagLine(' width 8

      text    .modXOffset  'X Offset: '        tagwidth 10   anchor top + left + right      at x2          ymax+0.5            callback '!this.tagFitting(' width 13 is REAL format !!distanceFmt
      text    .modYOffset  'Y Offset: '        tagwidth 10   anchor top + left + right      at x2          ymax+0.2            callback '!this.tagFitting(' width 13 is REAL format !!distanceFmt

      numericinput .modFittRotate 'Angle From Y:' tagwidth 10 anchor top + left + right    at xmin        ymax+0.2            callback '!this.rotateFitting(' range 180 -180 ndp 0 value 0 width 5

    exit

    -- Accept Changes
    paragraph .acceptIcon                                    anchor top + left              at x0          ymax+0.5            pixmap width 15 height 15
    button    .modAccept  linkLabel 'Accept Changes'         anchor top + left              at xmax+0.5    ymin                callback '!this.modify()' width 10

    -- Discard Changes
    paragraph .discardIcon                                   anchor top + right             at xmax+4      ymin                pixmap width 15 height 15
    button    .modDiscard linkLabel 'Discard Changes'        anchor top + right             at xmax+0.5    ymin                callback '!this.fittingTasks(true)' width 10

    paragraph .backIcon                                      anchor top + left              at x0          ymax+0.5            pixmap width 15 height 15
    button    .fittMain   linkLabel   'Back to Fitting tasks'                               at xmax+1      ymin                callback '!this.fittingTasks(true)'

  exit

   -- Form members

  -- Current active element
  member .owner             is DBREF

  -- Current active elements
  member .element           is DBREF

  -- Current Ceiling
  member .currentCeiling    is DBREF
  member .currTile          is DBREF

  -- Grid Element
  member .gridElement       is DBREF
  member .ceilingGrid       is RECTANGULARGRID
  member .gridIntersections is ARRAY

  -- Ceiling Grids
  member .ceilings          is ARRAY

  -- Current Fitting
  member .currentFitting    is DBREF
  member .fittingOri        is ORIENTATION

  -- Undo for form
  member .undo              is UNDOABLE

  -- Current Task Pane within Form
  member .currentPane       is GADGET
  member .currentTask       is BLOCK
  member .refreshTask       is BLOCK

  -- EDG Description
  member .edgDescription    is STRING

  -- Aid graphics
  member .aidNumber         is REAL

  -- Owning element
  member .ownerType       is STRING

  -- Grid control
  using namespace 'Aveva.Pdms.Presentation'
  member .contentGrid       is NETGRIDCONTROL


exit

------------------------------------------------------------------------
--
-- Method:      accCeilingFittings
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--

define method .accCeilingFittings()

  -- Cancel Callback
  !this.cancelCall              = '!this.tidy()'

  -- Set form to auto-scroll
  !this.autoScroll              = true

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!this.dummy()')

 -- Initialise task panes
  !this.fittingTasks(TRUE)
  !this.createFitting(FALSE)
  !this.modifyFitt(FALSE)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getpathname('accept.png')
  !this.acceptIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getpathname('discard.png')
  !this.discardIcon.addPixmap(!discardIcon)

  -- Set "Back" icon
  !backIcon                     = !!pml.getpathname('back.png')
  !this.dtBackIcon.addPixmap(!backIcon)
  !this.backIcon.addPixmap(!backIcon)
  !this.supTaskBackIcon.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getpathname('create.png')
  !this.createFittIcon.addPixmap(!createIcon)

  -- Set "Search" icon
  !searchIcon                   = !!pml.getpathname('ng_zoomtodrawlist.png')
  !this.findFittIcon.addPixmap(!searchIcon)
  !this.findModFittIcon.addPixmap(!searchIcon)

  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- Add .Net control to PML container for contents
  !this.contentGrid             = object NETGRIDCONTROL()
  !this.ceilingList.control     = !this.contentGrid.handle()

  -- Events handled
  !this.contentGrid.addeventhandler('afterSelectChange', !this, 'selectGrid')
  !this.fittRotate.modifiedEvents   = true
  !this.modFittRotate.modifiedEvents   = true

  -- Load information from Configuration
  !this.contentGrid.columnExcelFilter(false)
  !this.contentGrid.outlookGroupStyle(false)
  !this.contentGrid.columnSummaries(false)
  !this.contentGrid.fixedHeaders(false)
  !this.contentGrid.fixedRows(false)
  !this.contentGrid.singleRowSelection(true)

  -- Aid graphics

  !this.aidNumber = !!aidNumbers.add('Ceiling grid, grid tags')

  -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

  -- Hide advanced options
  !this.infoText.visible  = FALSE
  !this.opTemp.visible    = FALSE
  !this.fitHazard.visible = FALSE
  !this.elRating.visible  = FALSE
  !this.fittSpre.active   = FALSE
  !this.cellX.active      = FALSE
  !this.modCellX.active   = FALSE
  !this.modReplaceTile.active   = FALSE
  !this.mtCrtFitt.active  = FALSE
  !this.mtModFitt.active  = FALSE
  !this.mtDelFitt.active  = FALSE

  -- Set EDG Description
  !this.edgDescription    = 'Pick Fitting Position'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dummy
--
-- Description: Dummy method for unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dummy()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  !element = !!accNavigator.currentSelection()

  if(!element.unset()) then
    !this.owner             = object DBREF()
    !this.currentOwner.val  = 'No active element selected'

  else
    -- Set owner where layout data is to be stored
    !this.owner               = !element
    !this.ownerType           = !this.owner.type
    !this.currentOwner.val    = 'Active element: ' & !this.owner.namn

    !this.ceilingList()

  endif

  !fitTypes = ARRAY()
  !fitTypes.append('HVAC Fitting')
  !fitTypes.append('Fire Protection')
  !fitTypes.append('Info')
  !fitTypes.append('Electrical Fitting')


  !this.fittingType.dtext = !fitTypes
  !this.modFittingType.dtext = !fitTypes

  !this.mtCrtFitt.active = FALSE
  !this.mtModFitt.active = FALSE
  !this.mtDelFitt.active = FALSE

  !this.rad1.val = TRUE
  !this.placement(!this.rad1,'')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      ceilingList
--
-- Description: Update the list of ceilings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingList()

  -- Collect ceilings
  !contents = object ACCCOLLECTCONTENTS()

  -- Get ceiling for
  if(!contents.scope(!!accNavigator.currentSelection())) then
    !ceilings = !contents.collectAllOfType('CEILING')

    -- Headings
    !headings     = ARRAY()
    !headings.append('Name')
    !headings.append('Owner')

    -- Build tables
    !table        = ARRAY()

    do !ceiling values !ceilings
      !table.append(!ceiling.name)

    enddo

    -- Load grid
    !this.currOwnList.dtext = !table

    !this.ceilingGridList()

    --!emptyArray = object ARRAY()
    --!this.selectGrid(!emptyArray)

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .ceilingGridList()
--
-- Description: Update the list of ceilings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingGridList()

  -- Collect ceiling grids
  !contents = object ACCCOLLECTCONTENTS()
  !mainOwner = object DBREF()

  !this.owner = !this.currOwnList.displaytext().dbref()
  handle ANY
    !this.ceilingList()
    return FALSE
  endhandle

  -- Get ceiling for
  if(!contents.scope(!this.owner)) then

    !ceilingGrids = !contents.collectAllOfType('CLNPNGRID')

    -- Headings
    !headings     = ARRAY()
    !headings.append('Name')
    !headings.append('Owner')

    -- Build tables
    !table        = ARRAY()

    do !ceilingGrid values !ceilingGrids
      skip if (!ceilingGrid.owner neq !this.owner)
      !tableEntry = ARRAY()
      !tableEntry.append(!ceilingGrid.name)
      !mainOwner = !ceilingGrid.owner
      if(!ceilingGrid.owner.isNamed) then
        !tableEntry.append('[' & !mainOwner.fulltype & '] ' & !mainOwner.namn)
      else
        !tableEntry.append(!mainOwner.fulltype)
      endif
      !table.append(!tableEntry)
    enddo

    !this.mtCrtFitt.active = FALSE
    !this.mtModFitt.active = FALSE
    !this.mtDelFitt.active = FALSE
    !this.currFitt.clear()

    -- Load grid
    using namespace 'Aveva.Pdms.Presentation'
    !nds          = object NETDATASOURCE('CeilingGrids', !headings, !table)
    !this.contentGrid.bindToDataSource(!nds)

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      fittingTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fittingTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.fittingTaskPane

    !this.updateGadgets('CLEAR')

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.fittingTasks(false)')
    !this.refreshTask         = object BLOCK('!this.dummy()')

     -- Change form title to reflect the active pane
    !this.formTitle           = 'Ceiling Fitting Tasks'


  endif

  -- Show/hide task pane
  !this.fittingTaskPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createFitting
--
-- Description: Display fitting pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createFitting(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.createFittPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.createFitting(false)')
    !this.refreshTask         = object BLOCK('!this.fittingCreate()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Create Ceiling Fitting'

    !this.ceilingList.active  = FALSE

    !this.currOwnList.visible = FALSE

    !this.checkType()

    !this.getGridCells()
    !this.getGridLines()

    !this.rad1.val = TRUE
    !this.placement(!this.rad1,'')
    !this.tagCell(!this.cellX, 'DUMMY')

    !this.fittRotate.val = 0
    !this.rotateFitting(!this.fittRotate, 'DUMMY')

  -- Actions when task pane is made inactive
  else
    !this.ceilingList.active  = TRUE
    !this.currOwnList.visible = TRUE

    !this.getFittings()
  endif

    -- Show/hide task pane
  !this.createFittPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyFitt
--
-- Description: Display fitting pane in modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyFitt(!active is BOOLEAN)


  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.modifyFittPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.modifyFitt(false)')
    !this.refreshTask         = object BLOCK('!this.fittingModify()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Ceiling Fitting'

    !this.ceilingList.active  = FALSE

    !this.currOwnList.visible = FALSE

  -- Actions when task pane is made inactive
  else
    !this.ceilingList.active  = TRUE
    !this.currOwnList.visible = TRUE
    !this.getFittings()
    !this.selectFitting()
  endif

    -- Show/hide task pane
  !this.modifyFittPane.visible      = !active
  if (!this.currentFitting.set()) then
  	if (!this.currentFitting.type.eq('HVACFI')) then
    	!this.modFittingType.val = 1
    elseif (!this.currentFitting.type.eq('FPFITT')) then
    	!this.modFittingType.val = 2
    elseif (!this.currentFitting.type.eq('INFITT')) then
    	!this.modFittingType.val = 3
    elseif (!this.currentFitting.type.eq('ELFITT')) then
    	!this.modFittingType.val = 4
    endif
    if ( !this.currentFitting.spref.unset().not() and !this.currentFitting.spref.badref().not() ) then
    !this.fittModSpre.val = !this.currentFitting.spref.name
    endif
    !this.fittModSpre.active = false
    !this.fittingOri = !this.currentFitting.orientation
  else
    -- do nothing
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fittingCreate
--
-- Description: Create Grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fittingCreate()


  -- Set the owning element
  !this.owner       = !this.currOwnList.displaytext().dbref()

  -- Setup panes
  !this.createFitting(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fittingModify()
--
-- Description: Modify Grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fittingModify()

  -- Set the owning element
  !this.owner       = !this.currOwnList.displaytext().dbref()

  -- Setup panes
  !this.modifyFitting(TRUE)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create fitting of selected type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create()

  --!!ce = !this.currTile

  -- Element not modifiable
  if(!!dbRefUpdatable(!this.gridElement).not()) then
    !!alert.warning(!!error.text)
    return false
  endif

  if ((!this.fittSpre.val.set()) and (!this.fittSpre.val neq '')) then
  else
    !!alert.warning('Please set a valid SPREF')
    return FALSE
  endif

    -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Create Fitting')
  !this.undo.add()

  !!ce = !this.gridElement

    !collection  = object COLLECTION()
    !collection.scope(!this.gridElement)
    !collection.type('CLNCGR')

    if (!collection.results().size() eq 0) then
      NEW CLNCGR
    else
      !!ce = !collection.results()[1]
    endif

    if (!this.rad1.val) then

      if (!this.replaceTile.val) then

        !refElement = !!ce
        if !this.currTile.set() then
          !!ce = !this.currTile
          DELETE CLNTIL
        endif

        !!ce = !refElement

        NEW CGRDCP
        !element = !!ce

        !cellIDs = !this.cellX.displaytext().split()

        !newCellIDs = object ARRAY()

        do !i indices !cellIDs
          !newCellIDs.append(!cellIDs[!i].real())
        enddo
        !element.cellID = !newCellIDs

      elseif (!this.replaceTile.val eq FALSE) then
      	
        if !this.currTile.set() then
          !!ce = !this.currTile
        endif
      endif

    elseif (!this.rad2.val) then
      NEW CGRDLP
      !element = !!ce

      !element.grdLID[2] = !this.lineX.displaytext().real()
      !element.grdLID[1] = !this.lineY.displaytext().real()
    else
      return FALSE
    endif



  if (!this.fittingType.selection() eq 'HVAC Fitting') then

    NEW HVACFI

    !element = !!ce

    !element.spref = !this.fittSpre.val.dbref()
    !element.description = !this.fittDesc.val
    if (!this.opTemp.val.set()) then
      !element.optemperature = !this.opTemp.val
    endif

  elseif (!this.fittingType.selection() eq 'Info') then

    NEW INFITT

    !element = !!ce

    !element.spref       = !this.fittSpre.val.dbref()
    !element.description = !this.fittDesc.val
    !element.infoText    = !this.infoText.val

  elseif (!this.fittingType.selection() eq 'Fire Protection') then

    NEW FPFITT

    !element = !!ce

    !element.spref = !this.fittSpre.val.dbref()
    !element.description = !this.fittDesc.val
    !element.hazard = !this.fitHazard.val

  elseif (!this.fittingType.selection() eq 'Electrical Fitting') then

    NEW ELFITT

    !element = !!ce

    !element.spref = !this.fittSpre.val.dbref()
    !element.description = !this.fittDesc.val
    if (!this.opTemp.val.set()) then
      !element.optemperature = !this.opTemp.val
    endif
    if (!this.elRating.val.set()) then
      !element.elRating = !this.elRating.val
    endif

  endif


  if ( !this.fittName.val.unset().not() ) then
    !name                = !this.fittName.val.trim()
    if(!name.neq('')) then
      !name              = '/' & !name
      !element.name      = !name
    endif
  endif

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(FALSE)
    endif

    !fittPos = !element.position
    !fittPos.east = !fittPos.east + !this.xOffset.val
    !fittPos.north = !fittPos.north + !this.yOffset.val
    !element.position = !fittPos


  -- Set orientation of fitting
  !element.orientation = !this.fittingOri

    -- Set end mark for UNDO
    !this.undo.endUndoable()

  !this.getFittings()
  -- unset name so if another fitting is created, it won't have the same name
  !this.fittName.val = ''

  !this.tidy()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify fitting definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()

  -- Element not modifiable
  if(!!dbRefUpdatable(!this.currentFitting).not()) then
    !!alert.warning(!!error.text)
    return false
  endif
  	
    if (!this.modFittingType.selection().eq('HVAC Fitting')) then
    !!ce = !this.currentFitting
    CHANGETYPE TO HVACFI
    handle (2,707)
    endhandle
  elseif (!this.modFittingType.selection().eq('Info')) then
    !!ce = !this.currentFitting
    CHANGETYPE TO INFITT
    handle (2,707)
    endhandle
  elseif (!this.modFittingType.selection().eq('Electrical Fitting')) then
    !!ce = !this.currentFitting
    CHANGETYPE TO ELFITT
    handle (2,707)
    endhandle
    elseif (!this.modFittingType.selection().eq('Fire Protection')) then
    !!ce = !this.currentFitting
    CHANGETYPE TO FPFITT
    handle (2,707)
    endhandle
  endif
  if (!this.fittModSpre.val.set()) then
    !this.currentFitting.spref   = !this.fittModSpre.val.dbref()
  else
    !!ce = !this.currentFitting
    spref nulref
    endif

    -- Name the fitting
    if(!this.modName.val.set()) then
      !name                       = !this.modName.val.trim()
      if(!name.neq('')) then
        !name                     = '/' & !name
        !this.currentFitting.name      = !name
        handle ANY
          !this.getFittings()
          !this.fittingTasks(TRUE)
          return FALSE
        endhandle
      endif
    endif

    !this.currentFitting.description   = !this.modDesc.val
    handle ANY
      !this.getFittings()
      !this.fittingTasks(TRUE)
      return FALSE
    endhandle

    if (!this.currentFitting.fulltype.eq('FPFITTING')) then
    !this.currentFitting.hazard        = !this.modHazard.val
    endif
    -- Position offset
    !pos = !this.currentFitting.position
    !pos.east = !this.modXOffset.val
    !pos.north = !this.modYOffset.val

    !this.currentFitting.position = !pos

  if (!this.currentFitting.fulltype.eq('HVACFITTING') or !this.currentFitting.fulltype.eq('ELFITTING')) then
    if (!this.modOpTemp.val.set()) then
      !this.currentFitting.optemperature = !this.modOpTemp.val
    endif
  endif

    if (!this.currentFitting.fulltype.eq('INFITTING')) then
    !this.currentFitting.infoText      = !this.modInfo.val
  endif

  -- Set orientation of fitting
  !this.currentFitting.orientation = !this.fittingOri

  if (!this.currentFitting.owner.fulltype eq 'CLNTIL' or !this.currentFitting.owner.fulltype eq 'CGRDCP') then
  	
  	!oldID = !this.currentFitting.owner.cellID
  	
    !cellIDs = !this.modCellX.displaytext().split()

    !newCellIDs = object ARRAY()

    do !i indices !cellIDs
      !newCellIDs.append(!cellIDs[!i].real())
    enddo

    if (!oldID neq !newCellIDs) then
    	!this.currentFitting.owner.cellID = !newCellIDs
    	!this.currTile.cellID = !oldID
    endif
    if (!this.modReplaceTile.val) then
      if (!this.currentFitting.owner.fulltype eq 'CLNTIL' ) then
        !!ce = !this.currentFitting.owner
        !oldOwner = !this.currentFitting.owner
        NEW CGRDCP COPY LIKE PREV
        INCLUDE $!this.currentFitting
        $!oldOwner
        DELETE CLNTIL
        !this.modReplaceTile.tag = 'Restore Tile?'
        !this.modReplaceTile.val = FALSE
        !this.fittingOri = !this.currentFitting.orientation
      elseif (!this.currentFitting.owner.fulltype eq 'CGRDCP' ) then
        !!ce = !this.currentFitting.owner
        !oldOwner = !this.currentFitting.owner
	NEW CLNTIL COPY LIKE PREV
        -- get SPRE for new tile from one of its neighbours
        !collection  = object COLLECTION()
        !collection.scope(!this.gridElement)
        !collection.type('CLNTIL')
        !collection.filter( object EXPRESSION( 'SPREF NEQ NULREF' ) )
        if (!collection.results().size() ge 1) then
          !!ce.spre = !collection.results()[1].spre
        endif
        INCLUDE $!this.currentFitting
        $!oldOwner
        DELETE CGRDCP
        !this.modReplaceTile.tag = 'Remove Tile?'
        !this.modReplaceTile.val = FALSE
        !this.fittingOri = !this.currentFitting.orientation
      endif
    endif

  elseif (!this.currentFitting.owner.fulltype eq 'CGRDLP') then

    !this.currentFitting.owner.grdLID[2] = !this.modLineX.displaytext().real()
    !this.currentFitting.owner.grdLID[1] = !this.modLineY.displaytext().real()

  endif

  !this.tidy()

  --!this.getFittings()
  --!this.fittingTasks(TRUE)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify a defined fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      DBREF     Modify Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify(!modElement is DBREF)

  !this.currentFitting = !modElement
  !this.gridElement = !modElement.owner.owner.owner

  !this.ceilingGrid = object RECTANGULARGRID(!this.gridElement)

  !!ce = !this.currentFitting

  !this.updateGadgets('CLEAR')

  if (!this.currentFitting.fulltype eq 'FPFITTING') then
    !this.updateGadgets('FP')
  elseif (!this.currentFitting.fulltype eq 'HVACFITTING') then
    !this.updateGadgets('HVAC')
  elseif (!this.currentFitting.fulltype eq 'INFITTING') then
    !this.updateGadgets('INFO')
  elseif (!this.currentFitting.fulltype eq 'ELFITTING') then
    !this.updateGadgets('EL')
  endif

  !this.getGridCells()
  !this.getGridLines()

  if (!this.currentFitting.owner.fulltype eq 'CGRDLP') then
    !this.modCellX.visible = FALSE
    !this.modReplaceTile.visible = FALSE
    !this.modLineX.visible = TRUE
    !this.modLineY.visible = TRUE
    !this.modCellPos.active = TRUE

    !this.modLineX.select('dtext', !this.currentFitting.owner.grdLID[2].string())
    !this.modLineY.select('dtext', !this.currentFitting.owner.grdLID[1].string())

  elseif (!this.currentFitting.owner.fulltype eq 'CLNTIL' or !this.currentFitting.owner.fulltype eq 'CGRDCP') then
    !this.modCellX.visible = TRUE
    !this.modCellX.active  = TRUE
    !this.modReplaceTile.visible = TRUE
    !this.modReplaceTile.active = TRUE
    !this.modLineX.visible = FALSE
    !this.modLineY.visible = FALSE
    !this.modCellPos.active = TRUE

    !cellID  = !this.currentFitting.owner.cellID
    !stringID = !cellID[1].string() & ' ' & !cellID[2].string()

    !this.modCellX.select('dtext', !stringID)
    if (!this.currentFitting.owner.fulltype eq 'CLNTIL' ) then
      !this.modReplaceTile.tag = 'Remove Tile?'
    elseif (!this.currentFitting.owner.fulltype eq 'CGRDCP' ) then
      !this.modReplaceTile.tag = 'Restore Tile?'
    endif
  endif

  !this.modifyFitt(TRUE)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fittingDelete
--
-- Description: Delete fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fittingDelete()

  !owner = !this.currentFitting.owner
  if (!owner.fulltype eq 'CLNTIL') then
  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.currentFitting).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  endif
  endif

  if (!owner.fulltype neq 'CLNTIL') then
    -- Replace the CGRDCP with a CLNTIL
    if (!owner.fulltype eq 'CGRDCP') then

      -- Get the grid cell id off the fitting owner
      !cellID = !owner.cellID
      !group = !owner.owner

      -- Get a spref for the tile
      !!ce = !group
      CLNTIL 1
      !refTile = !!ce
      !tileSpref = !refTile.spref

      -- Create the new tile
      !!ce = !group
      NEW CLNTIL
      !element = !!ce
      !element.spref = !tileSpref
      !element.cellID = !cellID
    endif

    -- Delete fitting owner
   if(!owner.fulltype.neq('CLNCGR'))then
    if (!!accDeleteManager.deleteElement(!owner).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
    endif
  else
    if (!!accDeleteManager.deleteElement(!this.currentFitting).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
    endif
  endif

  endif

  !this.tidy()
  !this.getFittings()
  !this.selectFitting()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh form from navigator.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh task
  if(!this.shown()) then
    !this.initialise()
    !this.refreshTask.evaluate()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectGrid
--
-- Description: Set up form and centre view on selected ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectGrid(!dummyPassedArray is ARRAY)

  !this.tidy()

  !elements = object ARRAY()

  !elements = !this.contentGrid.getSelectedRows()

  if (!elements.size() ge 1) then

    !this.gridElement = !elements[1][1].dbref()
    !this.ceilingGrid = object RECTANGULARGRID(!this.gridElement)

    !gridPos = !this.gridElement.position

    !this.tidy()
    if (!this.gridElement.isNamed) then
      !name = !this.gridElement.namn
      AID TEXT NUMBER $!<this.aidNumber> '$!name' At $!<gridPos>
    else
      AID TEXT NUMBER $!<this.aidNumber> 'Grid Position' At $!<gridPos>
    endif

    !!ce = !this.gridElement

    !collection  = object COLLECTION()
    !collection.scope(!this.gridElement)
    !collection.type('CLNCGR')

    if (!collection.results().size() eq 0) then
      !this.mtCrtFitt.active = FALSE
      !this.mtDelFitt.active = FALSE
      !this.mtModFitt.active = FALSE

      !this.currFitt.dtext = object ARRAY()
      !this.currFitt.rtext = object ARRAY()
    else
      !this.mtCrtFitt.active = TRUE
      !this.getFittings()
    endif
  else
    !this.mtDelFitt.active = FALSE
    !this.mtModFitt.active = FALSE

    !this.currFitt.dtext = object ARRAY()
    !this.currFitt.rtext = object ARRAY()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getFittings
--
-- Description: Retrieves a list of all the current fittings in a grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getFittings()

  if (!this.gridElement.set()) then
    !collection = object COLLECTION()
    !collection.scope(!this.gridElement)
    !collection.addtype('ELFITT')
    !collection.addtype('HVACFI')
    !collection.addtype('INFITT')
    !collection.addtype('FPFITT')

    !fittDbrefs    = object ARRAY()
    !fittNames     = object ARRAY()

    if (!collection.results().size() ge 1) then
      !fittingsArray = !collection.results()

      do !fitt values !fittingsArray
	-- truncate name if elements are unnamed
        !fittNames.append(!fitt.fullname.string().before ( ' of CEILIN ' ))
        !fittDbrefs.append(!fitt.string())
      enddo

      if (!fittNames.size() eq 0) then
        !this.mtDelFitt.active = FALSE
        !this.mtModFitt.active = FALSE
      endif

    else
      !this.mtDelFitt.active = FALSE
      !this.mtModFitt.active = FALSE
    endif

    !this.currFitt.dtext = !fittNames
    !this.currFitt.rtext = !fittDbrefs
    !this.currentFitting = !fittDbrefs.first().dbref()
    handle (2,752)
    !this.currentFitting = object DBREF()
    endhandle
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getGridCells
--
-- Description: Retrieve a list of cell IDs from the ceiling grid object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Returns:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getGridCells()

  !cells  = !this.ceilingGrid.listofTrimmedCells()
  !cells.appendArray(!this.ceilingGrid.listofUntrimmedCells())

  !cellIDs = object ARRAY()

  do !i indices !cells
    !cellIDs[!i] = !cells[!i][1] & ' ' & !cells[!i][2]
  enddo

  !this.cellX.dtext = !cellIDs.sort()
  !this.modCellX.dtext = !cellIDs.sort()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getGridLines
--
-- Description: Retrieve a list of gridlines in the X and Y directions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Returns:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getGridLines()

  !xLines = !this.ceilingGrid.xGridLines()
  !yLines = !this.ceilingGrid.yGridLines()

  !currXLines = object ARRAY()
  do !i indices !xLines
    !currXLines[!i] = !xLines[!i][1].string()
  enddo

  !currYLines = object ARRAY()
  do !j indices !yLines
    !currYLines[!j] = !yLines[!j][1].string()
  enddo
  !this.lineX.dtext = !currXLines
  !this.lineY.dtext = !currYLines

  !this.modLineX.dtext = !currXLines
  !this.modLineY.dtext = !currYLines

  !this.gridIntersections = ARRAY()

  do !i indices !xLines

    do !j from 2 to !xLines[!i].size()

    !xline       = !xLines[!i][!j]

      do !k indices !yLines

        do !l from 2 to !yLines[!k].size()
          !yline = !yLines[!k][!l]

          !lineArray = ARRAY()
          !lineArray.append(!xline.intersection(!yline))
          !lineArray.append(!xLines[!i][1].string())
          !lineArray.append(!yLines[!k][1].string())
          !this.gridIntersections.append(!lineArray)
        enddo
      enddo
    enddo
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectFitting
--
-- Description: Sets the current fitting for deletion or modification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectFitting()

  !this.tidy()
  !this.currentFitting = !this.currFitt.selection().dbref()
  handle ANY
    !this.getFittings()
    return FALSE
  endhandle

  if (!this.currentFitting.set()) then
  !!ce = !this.currentFitting

  if (!this.currentFitting.fulltype eq 'FPFITTING') then
    !this.updateGadgets('FP')
  elseif (!this.currentFitting.fulltype eq 'HVACFITTING') then
    !this.updateGadgets('HVAC')
  elseif (!this.currentFitting.fulltype eq 'INFITTING') then
    !this.updateGadgets('INFO')
  elseif (!this.currentFitting.fulltype eq 'ELFITTING') then
    !this.updateGadgets('EL')
  endif

  !this.fittingOri = !this.currentFitting.orientation

  !this.getGridCells()
  !this.getGridLines()

  if (!this.currentFitting.owner.fulltype eq 'CGRDLP') then
    !this.modCellX.visible = FALSE
    !this.modReplaceTile.visible = FALSE
    !this.modLineX.visible = TRUE
    !this.modLineY.visible = TRUE
    !this.modCellPos.active = TRUE

    !this.modLineX.select('dtext', !this.currentFitting.owner.grdLID[2].string())
    !this.modLineY.select('dtext', !this.currentFitting.owner.grdLID[1].string())

  elseif (!this.currentFitting.owner.fulltype eq 'CLNTIL' or !this.currentFitting.owner.fulltype eq 'CGRDCP') then
    !this.modCellX.visible = TRUE
    !this.modCellX.active  = TRUE
    !this.modReplaceTile.visible = TRUE
    !this.modReplaceTile.active = TRUE
    !this.modLineX.visible = FALSE
    !this.modLineY.visible = FALSE
    !this.modCellPos.active = TRUE

    !cellID  = !this.currentFitting.owner.cellID
    !stringID = !cellID[1].string() & ' ' & !cellID[2].string()

    !this.modCellX.select('dtext', !stringID)
    if (!this.currentFitting.owner.fulltype eq 'CLNTIL' ) then
      !this.modReplaceTile.tag = 'Remove Tile?'
    elseif (!this.currentFitting.owner.fulltype eq 'CGRDCP' ) then
      !this.modReplaceTile.tag = 'Restore Tile?'
    endif

  endif

  !this.mtModFitt.active = TRUE
  !this.mtDelFitt.active = TRUE

  if (!this.currentFitting.isNamed) then
    !name  = !this.currentFitting.namn
  else
    !name  = 'Fitting'
  endif

  !pos = !this.currentFitting.position

  AID TEXT NUMBER $!<this.aidNumber> '$!name' At $!<pos>
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Update relevant gadgets with detail information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     Detail Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets(!detailType is STRING)

  -- Boxes to be updated according to fitting type
  if (!detailType eq 'HVAC') then

    if (!this.currentFitting.isNamed) then
      !this.modName.val    =  !this.currentFitting.namn
    else
      !this.modName.val    = ''
    endif
    !this.modDesc.val = !this.currentFitting.description

    !this.modOpTemp.val = !this.currentFitting.optemperature

    !this.modInfo.visible   = FALSE
    !this.modOpTemp.visible = TRUE
    !this.modHazard.visible = FALSE
    !this.modElRate.visible = FALSE

    -- Position controls
    !this.modXOffset.val  = !this.currentFitting.position.east
    !this.modYOffset.val  = !this.currentFitting.position.north

    -- Get North angle from orientation wrt reference plane
    !orientation            = !this.currentFitting.orientation
    if (!this.currentFitting.own.type.eq('CLNCGR')) then
      !plane                  = object PLANE(!this.currentFitting.owner.own.position, !this.currentFitting.own.owner.orientation)
    else
      !plane                  = object PLANE(!this.currentFitting.owner.position, !this.currentFitting.owner.orientation)
    endif
    !cAngles                = object COMPOUNDANGLES()
    !angles                 = !cAngles.angles(!orientation, !plane)

    !this.modFittRotate.val = !angles[1] * -1

    -- Get North angle from orientation wrt reference plane
    !orientation            = !this.currentFitting.orientation
    if (!this.currentFitting.own.type.eq('CLNCGR')) then
      !plane                  = object PLANE(!this.currentFitting.owner.own.position, !this.currentFitting.own.owner.orientation)
    else
      !plane                  = object PLANE(!this.currentFitting.owner.position, !this.currentFitting.owner.orientation)
    endif
    !cAngles                = object COMPOUNDANGLES()
    !angles                 = !cAngles.angles(!orientation, !plane)

    !this.modFittRotate.val = !angles[1] * -1

  elseif (!detailType eq 'FP') then

    if (!this.currentFitting.isNamed) then
      !this.modName.val    =  !this.currentFitting.namn
    else
      !this.modName.val    = ''
    endif
    !this.modDesc.val = !this.currentFitting.description
    !this.modHazard.val = !this.currentFitting.hazard

    !this.modInfo.visible   = FALSE
    !this.modOpTemp.visible = FALSE
    !this.modHazard.visible = TRUE
    !this.modElRate.visible = FALSE

    -- Position controls
    !this.modXOffset.val  = !this.currentFitting.position.east
    !this.modYOffset.val  = !this.currentFitting.position.north

    -- Get North angle from orientation wrt reference plane
    !orientation            = !this.currentFitting.orientation
    if (!this.currentFitting.own.type.eq('CLNCGR')) then
      !plane                  = object PLANE(!this.currentFitting.owner.owner.position, !this.currentFitting.owner.owner.orientation)
    else
      !plane                  = object PLANE(!this.currentFitting.owner.position, !this.currentFitting.owner.orientation)
    endif
    !cAngles                = object COMPOUNDANGLES()
    !angles                 = !cAngles.angles(!orientation, !plane)

    !this.modFittRotate.val = !angles[1] * -1

  elseif (!detailType eq 'INFO') then

    if (!this.currentFitting.isNamed) then
      !this.modName.val    =  !this.currentFitting.namn
    else
      !this.modName.val    = ''
    endif
    !this.modDesc.val = !this.currentFitting.description

    !this.modInfo.val   = !this.currentFitting.infoText

    !this.modInfo.visible   = TRUE
    !this.modOpTemp.visible = FALSE
    !this.modHazard.visible = FALSE
    !this.modElRate.visible = FALSE

    -- Position controls
    !this.modXOffset.val  = !this.currentFitting.position.east
    !this.modYOffset.val  = !this.currentFitting.position.north

    -- Get North angle from orientation wrt reference plane
    !orientation            = !this.currentFitting.orientation
    if (!this.currentFitting.own.type.eq('CLNCGR')) then
      !plane                  = object PLANE(!this.currentFitting.owner.owner.position, !this.currentFitting.owner.owner.orientation)
    else
      !plane                  = object PLANE(!this.currentFitting.owner.position, !this.currentFitting.owner.orientation)
    endif
    !cAngles                = object COMPOUNDANGLES()
    !angles                 = !cAngles.angles(!orientation, !plane)

    !this.modFittRotate.val = !angles[1] * -1

  elseif (!detailType eq 'EL') then

    if (!this.currentFitting.isNamed) then
      !this.modName.val    =  !this.currentFitting.namn
    else
      !this.modName.val    = ''
    endif
    !this.modDesc.val = !this.currentFitting.description
    !this.modOpTemp.val  = !this.currentFitting.optemperature
    !this.modElRate.val  = !this.currentFitting.elRating

    !this.modInfo.visible   = FALSE
    !this.modOpTemp.visible = TRUE
    !this.modHazard.visible = FALSE
    !this.modElRate.visible = TRUE

    -- Position controls
    !this.modXOffset.val  = !this.currentFitting.position.east
    !this.modYOffset.val  = !this.currentFitting.position.north

    -- Get North angle from orientation wrt reference plane
    !orientation            = !this.currentFitting.orientation
    if (!this.currentFitting.own.type.eq('CLNCGR')) then
      !plane                  = object PLANE(!this.currentFitting.owner.owner.position, !this.currentFitting.owner.owner.orientation)
    else
      !plane                  = object PLANE(!this.currentFitting.owner.position, !this.currentFitting.owner.orientation)
    endif
    !cAngles                = object COMPOUNDANGLES()
    !angles                 = !cAngles.angles(!orientation, !plane)

    !this.modFittRotate.val = !angles[1] * -1

  elseif (!detailType eq 'CLEAR') then

    !this.fittName.val   = ''
    !this.fittDesc.val   = ''
    !this.opTemp.clear()
    !this.fittSpre.val   = ''
    !this.infoText.val   = ''
    !this.fitHazard.val  = ''
    !this.elRating.clear()
    !this.modName.val    = ''
    !this.modDesc.val    = ''
    !this.modOpTemp.clear()
    !this.modHazard.val  = ''
    !this.modInfo.val    = ''
    !this.modElRate.clear()
    !this.modXOffset.val = 0
    !this.modYOffset.val = 0
    !this.xOffset.val = 0
    !this.yOffset.val = 0
    !this.modFittRotate.val = 0

  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      findFitting
--
-- Description: Use the stChooseSelection form to find the fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .findFitting(!fittingType is STRING)

  !!stchoosedata.cleardata()

  !!stchoosedata.settitle(!fittingType)

  if (!fittingType eq 'HVAC Fitting') then
    !!stchoosedata.setdata('ROOM', 'HVFI')
  elseif (!fittingType eq 'Fire Protection') then
    !!stchoosedata.setdata('ROOM', 'FPFI')
  elseif (!fittingType eq 'Info') then
    !!stchoosedata.setdata('ROOM', 'INFI')
  elseif (!fittingType eq 'Electrical Fitting') then
    !!stchoosedata.setdata('ROOM', 'ELFI')
  endif

  !!stchoosedata.setTable()

  show !!stChooseSelection

  !!stChooseSelection.action = object BLOCK('!!' & !this.name() & '.setSpref(!this.selectedItem.name.string())')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setSpref
--
-- Description: Set the Fitting Spref textbox value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     Fitting Name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpref(!fittingName is STRING)

  !this.fittSpre.val = !fittingName
  !this.fittModSpre.val = !fittingName

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkType
--
-- Description: Check selected fitting type and act accordingly
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkType()

  if (!this.fittingType.selection() eq 'HVAC Fitting') then
   !this.infoText.visible  = FALSE
   !this.opTemp.visible    = TRUE
   !this.opTemp.val        = 0.0
   !this.fitHazard.visible = FALSE
   !this.elRating.visible  = FALSE
  elseif (!this.fittingType.selection() eq 'Info') then
   !this.infoText.visible  = TRUE
   !this.opTemp.visible    = FALSE
   !this.fitHazard.visible = FALSE
   !this.elRating.visible  = FALSE
  elseif (!this.fittingType.selection() eq 'Fire Protection') then
   !this.infoText.visible  = FALSE
   !this.opTemp.visible    = FALSE
   !this.fitHazard.visible = TRUE
   !this.elRating.visible  = FALSE
  elseif (!this.fittingType.selection() eq 'Electrical Fitting') then
   !this.infoText.visible  = FALSE
   !this.opTemp.visible    = TRUE
   !this.opTemp.val        = 0.0
   !this.fitHazard.visible = FALSE
   !this.elRating.visible  = TRUE
   !this.elRating.val      = 0.0
  endif
  if defined (!!stChooseSelection) then
    if(!!stChooseSelection.shown())then
      !!stChooseSelection.hide()
      !this.findFitting(!this.fittingType.selection())
    endif
  endif
  -- Empty any previous SPREF value
  !this.fittSpre.clear()
  !this.fittModSpre.clear()
  if !this.modFittingType.selection() eq 'HVAC Fitting' then
   !this.modOpTemp.visible  = TRUE
   !this.modInfo.visible    = FALSE
   !this.modHazard.visible  = FALSE
   !this.modElRate.visible  = FALSE
  elseif !this.modFittingType.selection() eq 'Info' then
   !this.modInfo.visible    = TRUE
   !this.modHazard.visible  = FALSE
   !this.modElRate.visible  = FALSE
   !this.modOpTemp.visible  = FALSE
  elseif !this.modFittingType.selection() eq 'Fire Protection' then
   !this.modInfo.visible    = FALSE
   !this.modHazard.visible  = TRUE
   !this.modElRate.visible  = FALSE
   !this.modOpTemp.visible  = FALSE
  elseif !this.modFittingType.selection() eq 'Electrical Fitting' then
   !this.modInfo.visible   = FALSE
   !this.modHazard.visible  = FALSE
   !this.modElRate.visible  = TRUE
   !this.modOpTemp.visible  = TRUE
  endif

  -- Empty any previous SPREF value
  !this.fittSpre.val = 'Unset'

endmethod

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- If gadget name is unnamed, then do nothing.
  if(!gadget.val.eq('')) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clearFields
--
-- Description: Clear fields on creating a fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearFields()

  !this.currentTile.val = ''
  !this.fittSpre.val = ''
  !this.fittName.val = ''
  !this.fittDesc.val = ''
  !this.infoText.val = ''
  !this.opTemp.clear()
  !this.fitHazard.clear()
  !this.elRating.clear()

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      placement
--
-- Description: Open callback which alters the create pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------

define method .placement(!gadget is GADGET, !dummyString is STRING)

  !this.tidy()

  if (!gadget eq !this.rad1 ) then
    !this.cellX.visible = TRUE
    !this.cellX.active  = TRUE
    !this.replaceTile.visible = TRUE
    !this.lineX.visible = FALSE
    !this.lineY.visible = FALSE
  elseif (!gadget eq !this.rad2) then
    !this.cellX.visible = FALSE
    !this.replaceTile.visible = FALSE
    !this.lineX.visible = TRUE
    !this.lineY.visible = TRUE
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:     tagLine
--
-- Description: Tag derived line information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagLine(!gadget is GADGET, !dummyString is STRING)

    !this.tidy()

    if (!gadget eq !this.lineX or !gadget eq !this.lineY) then
      !lineXID = !this.lineX.displaytext().real()
      handle ANY
        !this.lineX.clearSelection()
        !!alert.warning('Please input a valid number')
        return FALSE
      endhandle
      !lineYID = !this.lineY.displaytext().real()
      handle ANY
        !this.lineY.clearSelection()
        !!alert.warning('Please input a valid number')
        return FALSE
      endhandle
    elseif (!gadget eq !this.modLineX or !gadget eq !this.modLineY) then
      !lineXID = !this.modLineX.displaytext().real()
      handle ANY
        !this.modLineX.clearSelection()
        !!alert.warning('Please input a valid number')
        return FALSE
      endhandle
      !lineYID = !this.modLineY.displaytext().real()
      handle ANY
        !this.modLineY.clearSelection()
        !!alert.warning('Please input a valid number')
        return FALSE
      endhandle
    endif


    !lineX = !this.ceilingGrid.xGridLines(!lineXID)[1]
    handle ANY
      !gadget.clearSelection()
      !!alert.warning('Please input a valid number from the list')
      return FALSE
    endhandle
    !lineY = !this.ceilingGrid.yGridLines(!lineYID)[1]
    handle ANY
      !gadget.clearSelection()
      !!alert.warning('Please input a valid number from the list')
      return FALSE
    endhandle

    !tagPosition  = !lineX.intersection(!lineY)

    if (!gadget eq !this.lineX or !gadget eq !this.lineY) then

      if (!this.xOffset.val.set()) then
        !tagPosition.east = !tagPosition.east + !this.xOffset.val
      endif

      if (!this.yOffset.val.set()) then
        !tagPosition.north = !tagPosition.north + !this.yOffset.val
      endif

    elseif (!gadget eq !this.modLineX or !gadget eq !this.modLineY) then
      if (!this.modXOffset.val.set()) then
        !tagPosition.east = !tagPosition.east + !this.modXOffset.val
      endif

      if (!this.modYOffset.val.set()) then
        !tagPosition.north = !tagPosition.north + !this.modYOffset.val
      endif
    endif

    AID TEXT NUMBER $!<this.aidNumber> 'T:$!lineXID:$!lineYID' AT $!<tagPosition>

    !plane                  = object PLANE(!this.gridElement.position, !this.gridElement.orientation)


    if (!gadget eq !this.lineX or !gadget eq !this.lineY) then
      !rotateGadget = !this.fittRotate
    else
      !rotateGadget = !this.modFittRotate
    endif
    -- Display Angle direction
    !direction            = !plane.orientation.yDir()
    AID ARROW NUMBER $!<this.aidNumber> AT $!tagPosition DIRECTION $!<direction> HEIGHT 500mm PROPORTION 0.1

    -- Angle from North
    if(!rotateGadget.val.neq(0)) then

      if(!rotateGadget.val.lt(0)) then
        !sense        = false
      else
        !sense        = true
      endif
      !arc            = object ARC(!tagPosition, Y is N, 90, 90 - !rotateGadget.val, 500mm, !sense)
      !anglePoint     = !arc.anglePosition(90 - !rotateGadget.val)
      !direction      = !arc.angleDirection(!arc.endAngle)

      AID ARROW NUMBER $!<this.aidNumber> AT $!tagPosition DIRECTION $!direction HEIGHT 500mm

      AID TEXT NUMBER $!<this.aidNumber> '$!rotateGadget.val' AT $!anglePoint
    endif


endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:     tagCell
--
-- Description: Tag derived Cell information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagCell(!gadget is GADGET, !mode is STRING)


    if ( !mode eq 'UNSELECT' ) then
       return
    endif

    !this.tidy()

    !collectTile  = object COLLECTION()
    !collectTile.scope(!this.gridElement)
    !collectTile.addtype('CLNTIL')
    !collectTile.addtype('CGRDCP')
    -- search collection of tiles to find the one with the matching cellID
    do !tile values !collectTile.results()
       !stringID =  !tile.cellID[1].string() & ' ' &  !tile.cellID[2].string()
       if ( !stringID eq !gadget.displaytext() ) then
         !this.currTile = !tile
         !tagPosition  = !tile.position

         if (!gadget eq !this.cellX ) then

           if (!this.xOffset.val.set()) then
             !tagPosition.east = !tagPosition.east + !this.xOffset.val
           endif

           if (!this.yOffset.val.set()) then
             !tagPosition.north = !tagPosition.north + !this.yOffset.val
           endif

         elseif (!gadget eq !this.modCellX ) then
           if (!this.modXOffset.val.set()) then
             !tagPosition.east = !tagPosition.east + !this.modXOffset.val
           endif

           if (!this.modYOffset.val.set()) then
             !tagPosition.north = !tagPosition.north + !this.modYOffset.val
           endif
         endif

         AID TEXT NUMBER $!<this.aidNumber> 'T:$!stringID' AT $!<tagPosition>

         !plane                  = object PLANE(!this.gridElement.position, !this.gridElement.orientation)


         if (!gadget eq !this.cellX) then
           !rotateGadget = !this.fittRotate
         else
           !rotateGadget = !this.modFittRotate
         endif
         -- Display Angle direction
         !direction            = !plane.orientation.yDir()
         AID ARROW NUMBER $!<this.aidNumber> AT $!tagPosition DIRECTION $!<direction> HEIGHT 500mm PROPORTION 0.1

         -- Angle from North
         if(!rotateGadget.val.neq(0)) then

           if(!rotateGadget.val.lt(0)) then
             !sense        = false
           else
             !sense        = true
           endif
           !arc            = object ARC(!tagPosition, Y is N, 90, 90 - !rotateGadget.val, 500mm, !sense)
           !anglePoint     = !arc.anglePosition(90 - !rotateGadget.val)
           !direction      = !arc.angleDirection(!arc.endAngle)

           AID ARROW NUMBER $!<this.aidNumber> AT $!tagPosition DIRECTION $!direction HEIGHT 500mm

           AID TEXT NUMBER $!<this.aidNumber> '$!rotateGadget.val' AT $!anglePoint
         endif
         return
       endif
    enddo
    -- cellID not found
    !!alert.warning('Please input a valid cell ID')
    return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     tagFitting
--
-- Description: Tag derived fitting information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagFitting(!gadget is GADGET, !dummyString is STRING)

  if ((!gadget neq !this.modXOffset) and (!gadget neq !this.modYOffset)) then
    if (!this.rad1.val) then
      !this.tagCell(!this.cellX, 'DUMMY')
    elseif (!this.rad2.val) then
      !this.tagLine(!this.lineY, 'DUMMY')
    endif
  else
    if (!this.currentFitting.owner.fulltype eq 'CLNTIL' or !this.currentFitting.owner.fulltype eq 'CGRDCP') then
      !this.tagCell(!this.modCellX, 'DUMMY')
    elseif (!this.currentFitting.owner.fulltype eq 'CGRDLP') then
      !this.tagLine(!this.modLineX, 'DUMMY')
    endif

  endif


endmethod

------------------------------------------------------------------------
--
-- Method:      chooseTile
--
-- Description: Choose Tile from 3D View
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .chooseTile(!gadget is GADGET, !dummyPassedString is STRING)

  -- Initialise Variables
  !prompt               = 'Pick Ceiling tile'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = TRUE
  -- Set up callback according to whether the user is creating or modifying a fitting
  if (!gadget eq !this.chooseTile) then

    -- Fitting positioned according to cell
    if (!this.rad1.val) then
      !packet.action        =  '!!' & !this.name() & '.updateTile(!this.return[1].item, |CREATE|)'
    -- Fitting positioned according to grid lines
    elseif (!this.rad2.val) then
      !packet.action        =  '!!' & !this.name() & '.updateLines(!this.return[1], |CREATE|)'
    endif

  elseif (!gadget eq !this.modCellPos) then

    -- Fitting positioned according to cell
    if (!this.currentFitting.owner.fulltype eq 'CLNTIL' or !this.currentFitting.owner.fulltype eq 'CGRDCP') then
      !packet.action        =  '!!' & !this.name() & '.updateTile(!this.return[1].item, |MODIFY|)'
    -- Fitting positioned according to grid lines
    elseif (!this.currentFitting.owner.fulltype eq 'CGRDLP') then
      !packet.action        =  '!!' & !this.name() & '.updateLines(!this.return[1], |MODIFY|)'
    endif

  endif


  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateTile
--
-- Description: Update form with data on chosen tile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateTile(!tile is DBREF, !mode is STRING)

  !this.tidy()

  if(!tile.fulltype.neq('CLNTIL') or (!tile.owner.owner neq !this.gridElement)) then
    !!error.text            = 'Element "' & !tile.namn & '" is not a valid Ceiling Tile.'
    return false
  endif

  !this.currTile = !tile
  !!ce = !tile

  !cellID = !this.currTile.cellID

  !stringID = !cellID[1] & ' ' & !cellID[2]

  !tagPosition = !this.currTile.position

  if (!mode eq 'CREATE') then
    !this.cellX.select('dtext', !stringID)
    --!this.tagCell(!this.cellX, 'DUMMY')

     if (!this.xOffset.val.set()) then
        !tagPosition.east = !tagPosition.east + !this.xOffset.val
     endif

     if (!this.yOffset.val.set()) then
       !tagPosition.north = !tagPosition.north + !this.yOffset.val
     endif
  else
    !this.modCellX.select('dtext', !stringID)
    --!this.tagCell(!this.modCellX, 'DUMMY')

    if (!this.modXOffset.val.set()) then
      !tagPosition.east = !tagPosition.east + !this.modXOffset.val
    endif

    if (!this.modYOffset.val.set()) then
      !tagPosition.north = !tagPosition.north + !this.modYOffset.val
    endif
  endif

  AID TEXT NUMBER $!<this.aidNumber> 'T:$!cellID[1]:$!cellID[2]' AT $!<tagPosition>



endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateLine
--
-- Description: Update the form to the nearest intersection of lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateLines(!data is EDGPOSITIONDATA, !mode is STRING)

  !this.tidy()

  !pickedPosition = !data.position

  !distanceFrom = 0

  !closestIntersect = ARRAY()

  do !i indices !this.gridIntersections

    !intersectPos = !this.gridIntersections[!i][1]


    if (!i eq 1) then
      !distanceFrom = !intersectPos.distance(!pickedPosition)
      !closestIntersect = ARRAY()
      !closestIntersect.append(!this.gridIntersections[!i][2])
      !closestIntersect.append(!this.gridIntersections[!i][3])
    else
      !distance = !intersectPos.distance(!pickedPosition)

      if (!distance lt !distanceFrom) then
        !distanceFrom = !distance
        !closestIntersect = ARRAY()
        !closestIntersect.append(!this.gridIntersections[!i][2])
        !closestIntersect.append(!this.gridIntersections[!i][3])
      endif
    endif

  enddo

  if (!mode eq 'CREATE') then
    !this.lineX.select('dtext', !closestIntersect[1])
    !this.lineY.select('dtext', !closestIntersect[2])
    !this.tagLine(!this.lineX, 'DUMMY')
  else
    !this.modLineX.select('dtext', !closestIntersect[1])
    !this.modLineY.select('dtext', !closestIntersect[2])
    !this.tagLine(!this.modLineX, 'DUMMY')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  AID CLEAR ALL $!<this.aidNumber>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotateFitting
--
-- Description: Rotate the currently selected fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotateFitting(!gadget is GADGET, !dummyString is STRING)

  !orientation            = object ORIENTATION('Y is Y ' & !gadget.val & ' X and Z is Z')

  --!this.currentFitting.orientation = !orientation
  !this.fittingOri = !orientation

  !this.drawFitting(!gadget)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawFitting
--
-- Description: Draw the position and orientation of the current fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawFitting(!gadget is GADGET)

    !this.tidy()

    if (!gadget eq !this.modFittRotate) then
      if (!this.currentFitting.owner.fulltype eq 'CLNTIL' or !this.currentFitting.owner.fulltype eq 'CGRDCP') then

        !this.tagCell(!this.modCellX, 'DUMMY')

      else

        !this.tagLine(!this.modLineX, 'DUMMY')

      endif
    else
      if (!this.rad1.val) then

        !this.tagCell(!this.cellX, 'DUMMY')

      else

        !this.tagLine(!this.lineX, 'DUMMY')

      endif
    endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      backToMainRoomDesignTasks
--
-- Description: Switching to Main Room Design Tasks
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backToMainRoomDesignTasks()

  !this.fittingTasks(true)
  --!this.hide()
  !!accTaskManager.active('accDetail')
endmethod
-- End of method definition
