--
-- Method:      gridCreate
--
-- Description: Create Grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridCreate()

  -- Set the owning element
  !this.owner       = !this.currOwnList.displaytext().dbRef()

  -- Initialise Variables
  !this.definition            = object CEILINGGRIDPLANER()
  !this.definition.initialise(!this.owner)
  !ceiling  = object DBECEILING(!this.owner)
  !this.definition.innerLoops = !ceiling.innerLoops

  -- Set the aid numbers
  !this.definition.aidNumbers(!this.aidInner, !this.aidOuter, !this.aidNumber)

  -- Copy owning shape
  !this.useOwnersGeometry()

  -- Update gadgets
  !this.updateGadgets()

  -- Setup panes
  !this.createGrid(true)

endmethod
