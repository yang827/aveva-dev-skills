------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh form from navigator.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh task
  --if(!this.shown()) and (!this.currentPane eq !this.detailPane) then
  if(!this.shown()) and (!this.currentPane eq !this.mainTaskPane) then	
    !this.initialise()
    !this.refreshTask.evaluate()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Ceiling Tasks
  !this.gridCreateTasks.val         = 'Create'
  !this.gridModifyTasks.val         = 'Modify'
  !this.gridCopyTasks.val           = 'Copy'

  -- Ceiling Editing Tags
  !this.nAngle.tag              = 'Angle from Y axis:'

  -- get the latest configuration information
  !this.colSchema.dtext   = !!accConfig.colourSchemes()
  !this.fireRating.dtext  = !!accConfig.fireRatings()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  !element = !!accNavigator.currentSelection()


  if(!element.unset()) then
    !this.owner             = object DBREF()
    !this.currentOwner.val  = 'No active element selected'

  else
    -- Set owner where layout data is to be stored
    !this.owner               = !element
    !this.ownerType           = !this.owner.type
    !this.currentOwner.val    = 'Active element: ' & !this.owner.namn
    !this.boundOffset = 0mm
    !this.latLength.val       = !!accConfig.latticeProfile

    if(!!isImperialLength('DIST')) then
      !this.bndOffset.val       = 0in
    else
      !this.bndOffset.val       = 0mm
    endif

    !this.ceilingList()

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!element is DBREF)

  -- Element changed
  if(!element.set()) then
    !this.owner           = !element
    !this.currentOwner.val      = 'Active element: ' & !this.owner.namn

    -- Update ceiling list
    !this.ceilingList()

  !this.mainTasks(TRUE)

  !this.latCross.active      = FALSE
  !this.latEdge.active       = FALSE
  !this.detTileSPRF.active   = FALSE

  !this.mtModDef.active      = FALSE
  !this.mtModGeom.active     = FALSE
  !this.mtModLayout.active   = FALSE
  !this.mtModDetail.active   = FALSE
  !this.mtModProfiles.active = FALSE
  !this.mtDelGrid.active     = FALSE
  !this.mtDelLattice.active  = FALSE
  !this.mtDelTile.active     = FALSE
  !this.mtCopyProf.active    = FALSE

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      ceilingList
--
-- Description: Update the list of ceilings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingList()

  -- Collect ceilings
  !contents = object ACCCOLLECTCONTENTS()

  -- Get ceiling for
  if(!contents.scope(!!accNavigator.currentSelection())) then
    !ceilings = !contents.collectAllOfType('CEILIN')

    -- Headings
    !headings     = ARRAY()
    !headings.append('Name')
    !headings.append('Description')
    !headings.append('Owner')

    -- Build tables
    !table        = ARRAY()

    do !ceiling values !ceilings
      !table.append(!ceiling.name)
    enddo

    if (!ceilings.empty()) then
      !this.contentGrid.clearGrid()

      !this.mtCrtGrid.active = FALSE
      !this.mtCrtProfs.active = FALSE
    else
      !this.mtCrtGrid.active = TRUE
    endif


    -- Load grid
    !this.currOwnList.dtext = !table

    !this.ceilingGridList()

  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      .ceilingGridList()
--
-- Description: Update the list of ceilings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingGridList()

  -- Collect ceiling grids
  !contents       = object COLLECTION()
  !contents.addType('CLNPNG')

  !mainOwner = object DBREF()

  !this.owner = !this.currOwnList.displaytext().dbRef()
  handle ANY
    !this.ceilingList()
    return FALSE
  endhandle

  if (!this.owner.set()) then
  !ceilingPos = !this.owner.position
  !this.tidy()
  AID TEXT NUMBER $!<this.aidNumber> 'Ceiling Origin' At $!<ceilingPos>

  -- Get ceiling grids
    !contents.scope(!this.owner)
    !ceilingGrids    = !contents.results()

    -- Headings
    !headings     = ARRAY()
    !headings.append('Name')
    !headings.append('Description')
    !headings.append('Owner')

    -- Build tables
    !table        = ARRAY()

    do !ceilingGrid values !ceilingGrids
      !tableEntry = ARRAY()
      !tableEntry.append(!ceilingGrid.name)
      !tableEntry.append(!ceilingGrid.description)
      !mainOwner = !ceilingGrid.owner
      if(!ceilingGrid.owner.isNamed) then
        !tableEntry.append('[' & !mainOwner.fulltype & '] ' & !mainOwner.namn)
      else
        !tableEntry.append(!mainOwner.fulltype)
      endif
      !table.append(!tableEntry)
    enddo

    -- Load grid
    using namespace 'Aveva.Pdms.Presentation'
    !nds          = object NETDATASOURCE('CeilingGrids', !headings, !table)
    !this.contentGrid.bindToDataSource(!nds)

    if (!table.size() eq 0) then

      !this.mtModDef.active     = FALSE
      !this.mtModGeom.active    = FALSE
      !this.mtModLayout.active  = FALSE
      !this.mtModDetail.active  = FALSE
      !this.mtDelGrid.active    = FALSE
      !this.mtDelLattice.active = FALSE
      !this.mtDelTile.active    = FALSE

    endif

  endif



endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getProfiles
--
-- Description: Retrieve all of the lattice profiles on a ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getProfiles()

    !profileCollect = object COLLECTION()
    !profileCollect.scope(!this.element)
    !profileCollect.filter(object EXPRESSION('PURP eq ''PRFL'''))
    !profileCollect.type('CLNLATTICE')

    !profiles = !profileCollect.results()
    !table = object ARRAY()

    if (!profiles.size() gt 0) then

      !gensecs = !profiles[1].members

      do !i indices !gensecs
        !tableEntry = object ARRAY()
        !tableEntry.append(!gensecs[!i].name)
        !mainOwner = !gensecs[!i].owner
        if (!gensecs[!i].owner.isNamed) then
          !tableEntry.append('[' & !mainOwner.fulltype & '] ' & !mainOwner.namn)
        else
          !tableEntry.append(!mainOwner.fulltype)
        endif
        !table.append(!tableEntry)
      enddo

      !this.mtCopyProf.active = TRUE
      !this.mtModProfiles.active = TRUE
    else
      !this.mtCopyProf.active = FALSE
      !this.mtModProfiles.active = FALSE
    endif


    -- Headings
    !headings     = ARRAY()
    !headings.append('Name')
    !headings.append('Owner')

    -- Load grid
    using namespace 'Aveva.Pdms.Presentation'
    !nds          = object NETDATASOURCE('CeilingProfiles', !headings, !table)
    !this.profileGrid.bindToDataSource(!nds)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select from list of ceilings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!dummyPassedArray is ARRAY)

  !this.definition.new = TRUE

    -- Tidy any graphics
  !this.tidy()

  -- Initialise Variable
  !row                      = !this.contentGrid.getSelectedRows()

  if (!this.checkElement(!row)) then

    !this.mtModDef.active      = TRUE
    !this.mtModGeom.active     = TRUE
    !this.mtModLayout.active   = TRUE
    !this.mtModDetail.active   = TRUE
    !this.mtModProfiles.active = TRUE
    !this.mtDelGrid.active     = TRUE
    !this.mtCrtProfs.active    = TRUE

  else

    !this.mtModDef.active      = FALSE
    !this.mtModGeom.active     = FALSE
    !this.mtModLayout.active   = FALSE
    !this.mtModDetail.active   = FALSE
    !this.mtModProfiles.active = FALSE
    !this.mtCopyProf.active    = FALSE
    !this.mtDelGrid.active     = FALSE
    !this.mtDelLattice.active  = FALSE
    !this.mtDelTile.active     = FALSE
    !this.mtCrtProfs.active    = FALSE

  endif

  if (!row.size() gt 0) then

    !element                 = !row.first()[1].dbRef()
    handle ANY
    elsehandle NONE

      --!!ce  = !element



      !this.element = !element

      !this.owner = !this.element.owner

      !this.definition = object CEILINGGRIDPLANER(!this.element)
      !this.definition.initialise(!this.owner)

      !orientation = !this.element.orientation

      !nAngle = !orientation.ydir().wrt(WORLD).north.acos()
      !hAngle = !orientation.alpha

      !this.definition.modifyMode = FALSE
      !this.definition.dynamicUpdate = FALSE
      !this.definition.angles ( !nAngle, !hAngle )

      !this.definition.clnHeight = !this.element.grdposition.up
      !this.definition.xyOffset = !this.element.gXYOffset

      !position = !this.element.position

      -- Set aid numbers for ceiling
      !this.definition.aidNumbers(!this.aidInner, !this.aidOuter, !this.aidNumber)

      !this.definition.draw()

      !this.updateGadgets()

      !this.getProfiles()

      -- activate the Delete Lattice button?
      !collection = object COLLECTION()
      !collection.scope(!this.element)
      !collection.filter(object EXPRESSION('PURP eq ''PRFL'''))
      !collection.type('CLNLAT')
      !lattices   = !collection.results()
      if(!lattices.empty().not()) then
        !this.mtDelLattice.active = TRUE
      else
        !this.mtDelLattice.active = FALSE
      endif

      -- activate the Delete Tile button?
      !collection = object COLLECTION()
      !collection.scope(!this.element)
      !collection.type('CLNTIL')
      !tiles   = !collection.results()
      if(!tiles.empty().not()) then
        !this.mtDelTile.active = TRUE
      else
        !this.mtDelTile.active = FALSE
      endif

    endhandle

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      selectProfile
--
-- Description: Select from list of ceiling profiles
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectProfile(!dummyPassedArray is ARRAY)

  -- Clear the graphical aids
  AID CLEAR ALL $!this.aidNumberPrfStart
  AID CLEAR ALL $!this.aidNumberPrfEnd

  -- Initialise Variable
  !row                      = !this.profileGrid.getSelectedRows()

  if (!row.size() gt 0) then

    !element                 = !row.first()[1].dbRef()
    handle ANY
      !this.getProfiles()
      return false

    elsehandle NONE
      -- make the accept changes button active
      if (!row.size() eq 1) then
         !this.poAccept.active = true
      else
         !this.poAccept.active = false
      endif

      !this.currentProfile     = !element

    !bndLins = object COLLECTION()
    !bndLins.scope(!this.element)
    !bndLins.type('BNDLIN')
    !boundLin = !bndLins.results()

    !outerBoundary = !boundLin[1].members[1]

      !this.modProElev.val     = !element.position.up

      !this.modStartX.val   = !element.poss.east
      !this.modStartY.val   = !element.poss.north

      !this.modEndX.val   = !element.pose.east
      !this.modEndY.val   = !element.pose.north

      AID TEXT NUMBER $!<this.aidNumberPrfStart> 'START' At $!<element.poss>
      AID TEXT NUMBER $!<this.aidNumberPrfEnd> 'END' At $!<element.pose>

    endhandle

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      outerBoundCheck
--
-- Description: Setup form according to outer boundary check
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .outerBoundCheck()

  !outerBound = !this.crtOuterBnd.val

  if (!outerBound) then
    !this.startPosPan.expanded = FALSE
    !this.endPosPan.expanded = FALSE
    !this.startPosPan.active   = FALSE
    !this.endPosPan.active   = FALSE
    !this.proDraw.active      = FALSE
    !this.proCreate.active    = FALSE
  else
    !this.startPosPan.expanded = TRUE
    !this.endPosPan.expanded = TRUE
    !this.startPosPan.active   = TRUE
    !this.endPosPan.active   = TRUE
    !this.proDraw.active      = TRUE
    !this.proCreate.active    = TRUE
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkElement
--
-- Description: Check whether there is a valid selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkElement(!row is ARRAY) is BOOLEAN

    !ceilingGrids   = !row
    !retVal = FALSE

    if (!ceilingGrids.size() gt 0) then
      !grid      = !ceilingGrids.first()[1].dbRef()
      handle ANY
        !this.ceilingGridList()
        return FALSE
      endhandle
      if (!grid.badref().not()) then
        !retVal = TRUE
      else
        !retVal = FALSE
      endif
    else
      !retVal   = FALSE
    endif

    return !retVal

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.mainTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.mainTasks(false)')
    !this.refreshTask         = object BLOCK('!this.dummy()')

     -- Change form title to reflect the active pane
    !this.formTitle           = 'Main Ceiling Grid Tasks'


  endif

  -- Show/hide task pane
  !this.mainTaskPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createGrid
--
-- Description: Display ceiling grid pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createGrid(!active is BOOLEAN)

  !this.definition.tidy()

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.createGrid(false)')
    !this.refreshTask         = object BLOCK('!this.gridCreate()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Create Ceiling Grid'

    -- Manage create/modify panels
    !this.modPane.visible     = FALSE
    !this.crtPane.visible     = TRUE

    !this.ceilingList.active  = FALSE


  -- Actions when task pane is made inactive
  else
    !this.ceilingList.active  = TRUE
    !this.definition.tidy()
  endif

    -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createProfile
--
-- Description: Display ceiling profile pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createProfile(!active is BOOLEAN)

  -- Make task pane active
  if (!active) then

    !this.currentPane         = !this.crtProfile

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.createProfile(FALSE)')
    !this.refreshTask         = object BLOCK('!this.profileCreate()')

    !this.ceilingList.active  = FALSE

    !this.formTitle           = 'Create Lattice Profile'

  -- Actions when task pane is made inactive
  else
    !this.ceilingList.active  = TRUE
    !this.tidy()

    -- Clear old line values
    !this.profileSPREF.clear()
    !this.proLength.val = !!accConfig.latticeProfile
    !this.proEle.val = 0
    !this.crtStartX.val = 0
    !this.crtStartY.val = 0
    !this.crtEndX.val   = 0
    !this.crtEndY.val   = 0
    !this.lineList.selectallrows()
    !this.lineList.deleteSelectedRows()
    !this.proAccept.active = FALSE

  endif

  -- Show/hide task pane
  !this.crtProfile.visible    = !active

endmethod
-- End of method


