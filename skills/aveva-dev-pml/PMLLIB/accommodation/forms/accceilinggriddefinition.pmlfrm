------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Load for with passed ceiling grid element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Ceiling grid to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid element
--
------------------------------------------------------------------------

define method .modify(!passedElement is DBREF) is BOOLEAN

  -- Initialise Variables
  !element      = !passedElement

  -- If element is not a ceiling grid then see if one of the parents
  -- is a ceiling grid
  if(!element.type.neq('CLNPNG')) then

    !ownerTypes = !element.ahlist
    !index      = !ownerTypes.findFirst('CLNPNG')
    if(!index.set()) then
      !element  = !element.ownLst[!index]
    else
      !!error.text  = 'Element ' & !element & ' is not a ceiling grid.'
      return false
    endif
  endif

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Modify Ceiling Grid')
  !this.undo.add()

  !this.element = !element

  !this.owner = !this.element.owner

  !this.definition = object CEILINGGRIDPLANER(!this.element)
  !this.definition.initialise(!this.owner)

  !orientation = !this.element.orientation

  !this.definition.nAngle = !orientation.ydir().wrt(WORLD).north.acos()
  !this.definition.hAngle = !orientation.alpha

  !this.definition.modifyMode = FALSE
  !this.definition.dynamicUpdate = FALSE

  !this.definition.clnHeight = !this.element.grdposition.up
  !this.definition.xyOffset = !this.element.gXYOffset

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  !position = !this.element.position

  -- Set aid numbers for ceiling
  !this.definition.aidNumbers(!this.aidInner, !this.aidOuter, !this.aidNumber)

  !this.definition.draw()

  -- Update gadgets
  !this.updateGadgets()

  -- Switch to modify pane
  !this.modifyGrid(TRUE)

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Updating a currently existing CLNPNG element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify(!gadget is GADGET, !dummySelect is STRING) is BOOLEAN

  if (!gadget eq !this.loAccept) then

    !contents = object ACCCOLLECTCONTENTS()

    !this.element.gAngle = !this.gAngle.val
    handle(2,795)
        !this.tidy()
        !this.ceilingList()
        !this.ceilingGridList()
        !this.mainTasks(TRUE)
        return FALSE
    endhandle

    -- Define UNDO Information
    !this.undo  = object UNDOABLE()

    !this.undo.description('Modify Ceiling Grid')
    !this.undo.add()

    !this.element.gXYOffset[1] = !this.gXOffset.val
    !this.element.gXYOffset[2] = !this.gYOffset.val

    if(!this.gXSpacing.val.leq(0) or !this.gYSpacing.val.leq(0)) then
      !!alert.error('Grid spacing for X and Y must be a positive values')
      return FALSE
    endif

    if (!this.gXSpacing2.val.set()) then
      if(!this.gXSpacing2.val.lt(0)) then
        !!alert.error('Grid spacing for X must be a positive value')
        return FALSE
      endif
    else
      !this.gXSpacing2.val = 0
    endif

    if(!this.gYSpacing2.val.set()) then
      if(!this.gYSpacing2.val.lt(0)) then
        !!alert.error('Grid spacing for Y must be a positive value')
        return FALSE
      endif
    else
      !this.gYSpacing2.val = 0
    endif

    !this.element.grdXSpacing[1] = !this.gXSpacing.val
    if(!this.gXSpacing2.val.set() and !this.gXSpacing2.val gt 0) then
      !this.element.grdXSpacing[2] = !this.gXSpacing2.val
    endif
    !this.element.grdYSpacing[1] = !this.gYSpacing.val
    !this.tileXSpacing.val       = !this.gXSpacing.val
    !this.tileYSpacing.val       = !this.gYSpacing.val
    if(!this.gYSpacing2.val.set() and !this.gYSpacing2.val gt 0) then
      !this.element.grdYSpacing[2] = !this.gYSpacing2.val
    endif
    --!this.updateGadgets()
    !this.mainTasks(TRUE)

  elseif (!gadget eq !this.modAccept) then
    if(!this.dbName.val.unset())then
    	!this.dbName.val    = ''
    endif
    !name                       = !this.dbName.val.trim()
    if(!name.neq('')) then
      !name                     = '/' & !name
      !this.element.name      = !name

      handle(2,795)
        !this.tidy()
        !this.ceilingList()
        !this.ceilingGridList()
        !this.mainTasks(TRUE)
        return FALSE
      endhandle
    endif

  !this.element.description    = !this.dbDescription.val
  !this.ceilingGridList()
      handle(2,795)
        !this.tidy()
        !this.ceilingList()
        !this.ceilingGridList()
        !this.mainTasks(TRUE)
        return FALSE
      endhandle

  !function = !this.dbFunction.val
  !this.element.function       = !function
  !this.element.number         = !this.dbNumber.val

  !this.element.colSchema      = !this.colSchema.displaytext()
  !this.element.fireRating     = !this.fireRating.displaytext()

  if (!this.tileThk.val.set()) then
    !this.element.dcTilThk       = !this.tileThk.val
  endif

  if (!this.knuckle.val.set()) then
    !this.element.knuckl         = !this.knuckle.val
  endif

  !this.definition.modifyMode  = TRUE

  !this.element.position       = !this.definition.ceilingGrid.position().wrt(!this.owner)
  !this.element.orientation    = !this.definition.ceilingGrid.orientation().wrt(!this.owner)

  !this.mainTasks(TRUE)

  elseif (!gadget eq !this.goAccept) then

    !!ce = !this.element
    handle(2,795)
      !this.tidy()
      !this.ceilingList()
      !this.ceilingGridList()
      !this.mainTasks(TRUE)
      return FALSE
    endhandle

    !bndLins = object COLLECTION()
    !bndLins.scope(!this.element)
    !bndLins.type('BNDLIN')

    !boundLin = !bndLins.results()

    !!ce = !boundLin[1].members[1]

    !newProfile = !this.definition.ceilingGrid.outerBoundary()

    !newProfile.dbWrite(CE)
    handle (2,785)
    endhandle

    !this.mainTasks(TRUE)

  elseif (!gadget eq !this.poAccept) then

    !!ce = !this.currentProfile
    handle ANY
      !this.getProfiles()
      return FALSE
    endhandle

    !profStartPos = !this.currentProfile.poss
    !profStartPos.east  = !this.modStartX.val
    !profStartPos.north = !this.modStartY.val
    !profStartPos.up    = !this.modProElev.val
    !this.currentProfile.poss = !profStartPos

    !profEndPos   = !this.currentProfile.pose
    !profEndPos.east  = !this.modEndX.val
    !profEndPos.north = !this.modEndY.val
    !profEndPos.up    = !this.modProElev.val
    !this.currentProfile.pose = !profEndPos

    -- update any attached hangers
    !this.updateHangers()

    -- Set end mark for UNDO
    !this.undo.endUndoable()

    !this.tidy()

  endif

  -- Refresh Content navigator
  !!acccontentnavigator.refresh()
  handle (2,751)
  endhandle

  return TRUE

endmethod

-- End of Method


------------------------------------------------------------------------
--
-- Method:      updateHangers
--
-- Description: Update position of hangers connected to a profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateHangers()

    !col = object COLLECTION()
    !col.scope(!this.currentProfile)
    !col.type('FIXING')
    !colResult = !col.results()
    if !colResult.set().not() then
       return
    endif
    do !fixing values !colResult
       !hanger = !fixing.cref
       !oldPosition = !hanger.hpos
       handle any
         break
       endhandle
       !hanger.hpos = !fixing.pos
       !newPosition = !hanger.hpos
       !distance = !oldPosition.distance(!newPosition)
       !direction = !oldPosition.direction(!newPosition)
       !tailPosition = !hanger.tpos
       !hanger.tpos = !tailPosition.offset(!direction, !distance )
       !hangerMembers = !hanger.members
       do !i indices !hangerMembers
         !oldMemberPosition = !hangerMembers[!i].pos
         !hangerMembers[!i].pos = !oldMemberPosition.offset(!direction, !distance )
       enddo
    enddo

endmethod

-- End of Method

------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  -- New or old grid definition
  !new  = !this.definition.new

  -- Update name
  if(!new.not()) then
    if(!this.element.isNamed) then
      !this.dbName.val        = !this.element.namn
    else
      !this.dbName.val        = ''
    endif

    -- Description
    !this.dbDescription.val   = !this.element.description
    -- Function
    if(!this.element.function.set()) then
      !this.dbFunction.val  = !this.element.function
    endif

    -- Number
    !this.dbNumber.val        = !this.element.number

    -- Get orientation and get nAngle and hAngle from it
    !orientation              = !this.element.orientation

    -- Get North and Horizontal angles from orientation wrt reference plane
    !plane                  = object PLANE(!this.owner.position, !this.owner.orientation)
    !cAngles                = object COMPOUNDANGLES()
    !angles                 = !cAngles.angles(!orientation, !plane)

    --!this.nAngle.val        = !this.definition.nAngle
    !this.nAngle.val        = !angles[1]
    !this.nAngle(!this.nAngle,'')
    !this.hAngle.val        = !angles[2]
    !this.hAngle(!this.hAngle,'')
    !this.clnHeight.val     = !this.element.grdposition.up
    -- Get position
    !position               = !this.element.position

    !this.xOffset.val       = !position.east
    !this.yOffset.val       = !position.north

    -- Design criteria of ceiling grid
    !this.knuckle.val       = !this.element.knuckl
    !this.tileThk.val       = !this.element.dcTilThk

    !this.mtCrtProfs.active = TRUE

    !this.colSchema.select('dtext', !this.element.colSchema)
    handle (61,567)
    endhandle
    !this.fireRating.select('dtext', !this.element.fireRating)
    handle (61,567)
    endhandle

    !boundary = !this.bndOffset.val
    !boundarySelect = !this.boundCh.val
    if(!this.boundOffset.neq(!boundary) or !this.boundaryType.neq(!boundarySelect))then
    	!this.bndOffset.val = !this.boundOffset
    	!this.boundCh.val   = !this.boundaryType
    	handle(61,620)
      endhandle
    else
      !this.bndOffset.val = 0
      !this.boundCh.val   = 1
    endif

  else

    !this.dbName.val          = !this.definition.name
    !this.dbDescription.val   = !this.definition.description
    !this.dbNumber.val        = !this.definition.number
    !this.dbFunction.val      = !this.definition.function
    !this.nAngle.val          = !this.definition.nAngle
    !this.hAngle.val          = !this.definition.hAngle
    !this.xOffset.val         = !this.definition.xyOffset[1]
    !this.yOffset.val         = !this.definition.xyOffset[2]


  endif

  -- Grid Angle
  !this.gAngle.val      = !this.definition.ceilingGrid.gridAngle()

  -- Grid Offset
  !xyOffset             = !this.definition.ceilingGrid.gridXYPosition()
  !this.gXOffset.val    = !xyOffset.x
  !this.gYOffset.val    = !xyOffset.y

  -- Grid Spacings
  !xSpacings            = !this.definition.ceilingGrid.gridXSpacings()
  --!xList                = ''
  --do !i indices !xSpacings
  --  !xList              = !xList & ' ' & !xSpacings[!i]
  --enddo
  if(!xSpacings.empty().not())then
  	if(defined(!xSpacings[1]) and !xSpacings[1].neq(0))then
  		!this.gXSpacing.val   = object REAL(!xSpacings[1].string(),!!distanceFmt)
  	endif
  	if(defined(!xSpacings[2]) and !this.gXSpacing2.val.neq(0))then
  		!this.gXSpacing2.val  = object REAL(!xSpacings[2].string(),!!distanceFmt)
  	elseif(defined(!xSpacings[2]) and !this.gXSpacing2.val.unset())then
  		!this.gXSpacing2.val = object REAL()
  	endif
    !this.tileXSpacing.val= !xSpacings.sort().last()
  endif
  !ySpacings            = !this.definition.ceilingGrid.gridYSpacings()
  --!yList                = ''
  --do !i indices !ySpacings
  --  !yList              = !yList & ' ' & !ySpacings[!i]
  --enddo
  if(!ySpacings.empty().not())then
  	if(defined(!ySpacings[1]) and !ySpacings[1].neq(0))then
    	!this.gYSpacing.val   = object REAL(!ySpacings[1].string(),!!distanceFmt)
  	endif
  	--if(defined(!ySpacings[2]) and !ySpacings[2].neq(0))then
  	if (defined(!ySpacings[2]) and !this.gYSpacing2.val.neq(0)) then
  		!this.gYSpacing2.val  = object REAL(!ySpacings[2].string(),!!distanceFmt)
  	elseif(defined(!ySpacings[2]) and !this.gYSpacing2.val.unset())then
  		!this.gYSpacing2.val = object REAL()
  	endif
    !this.tileYSpacing.val= !ySpacings.sort().last()
  endif

  -- Set the number of trimmed and untrimmed tiles in the grid

  !trimmed        = !this.definition.ceilingGrid.numberOfTrimmedCells()
  !untrimmed      = !this.definition.ceilingGrid.numberOfUntrimmedCells()

  !this.trimmedTiles.val    = !trimmed
  !this.untrimmedTiles.val  = !untrimmed

  !this.latCross.val        = ''
  !this.latEdge.val         = ''
  !this.detTileSPRF.val     = ''
  !this.createTiles.active = FALSE

  -- Set the boundary offset back to zero
  --!this.bndOffset.val       = 0

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gridAngle
--
-- Description: Change grid angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridAngle(!gadget is GADGET, !dummyString is STRING)

  !this.definition.gridAngle(!this.gAngle.val)

  !this.trimmedTiles.val    = !this.definition.ceilingGrid.numberOfTrimmedCells()
  !this.untrimmedTiles.val  = !this.definition.ceilingGrid.numberOfUntrimmedCells()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gridSpacing
--
-- Description: Change grid spacing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridSpacing()

  -- Initialise Variables
  !xSpacing[1] = !this.gXSpacing.val
  if(!this.gXSpacing2.val.neq(0))then
  	!xSpacing[2] = !this.gXSpacing2.val
  elseif(!this.gXSpacing2.val.unset())then
  	!xSpacing[2] = 0
  endif
  !ySpacing[1] = !this.gYSpacing.val
  if(!this.gYSpacing2.val.neq(0))then
  	!ySpacing[2] = !this.gYSpacing2.val
  elseif(!this.gYSpacing2.val.unset())then
  	!ySpacing[2] = 0
  endif

  !this.definition.gridSpacings(!xSpacing, !ySpacing)

  !this.trimmedTiles.val    = !this.definition.ceilingGrid.numberOfTrimmedCells()
  !this.untrimmedTiles.val  = !this.definition.ceilingGrid.numberOfUntrimmedCells()

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Change grid spacing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------

define method .create()

  -- Check shape is defined, otherwise do not allow creation
 if !this.definition.outerLoop.area().eq(0) then
   !!alert.warning('Ceiling grid geometry must be defined before ceiling grid is created')
 else

  -- Make sure that the owner is a ceiling
  !this.owner = !this.currOwnList.displaytext().dbRef()

  -- Reference Element
  !reference = !!ce

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created Ceiling Grid')
  !this.undo.add()

  -- Navigate to Level
  !!ce        = !this.owner

  -- Create new element
  if(!this.definition.createGrid()) then

    !this.element = !this.definition.dbElement

    -- Set the aid numbers

    !ceilingGrid = !!ce

    if(!this.definition.outerLoop.set()) then
      NEW BNDLIN
      !boundary         = !!ce
      !!ce.description  = 'Ceiling Grid Boundary'

      -- Name element
      if(!ceilingGrid.isNamed) then
        call !!autoNameCe(false)
      endif

      -- Name element
      if(!this.element.isNamed) then
        call !!autoNameCe(false)
      endif
      NEW LOOP

      !this.definition.outerLoop.dbWrite(CE)

    endif

    if (!this.definition.innerLoops.set()) then
      !innerLoops = !this.definition.innerLoops
      do !i indices !innerLoops
         NEW LOOP
         !innerLoops[!i].dbWrite(CE)
      enddo
    endif

    --deleting physical ceiling(PANE) if already present
    if !this.element.owner.type.eq('CEILIN') then
    	!col = object COLLECTION()
    	!col.scope(!this.element.own)
    	!col.type('PANE')
    	!colResult = !col.results()
    	if !colResult.set() then
    	   	  !conf = !!alert.confirm('Physical Ceiling will be deleted before creating Ceiling Grid.Do you want to delete?')
    	   	  if !conf.eq('YES') then
    	   	    !!ce = !colResult[1]
    	   	    delete PANE
    	   	  endif
    	endif
    endif

    !this.definition.ceilingGrid   = object RECTANGULARGRID(!this.definition.dbElement)

    !this.definition.new = FALSE

    !this.definition.draw()

  -- Failed creating element
  else
    !!alert.warning(!!error.text)
  endif

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Return to original element
  !!ce      = !reference

  -- Update the gadgets on the form
  !this.updateGadgets()

  -- Refresh the list of ceiling grids
  !this.ceilingGridList()

  -- Switch to modify pane
  !this.layoutGrid(TRUE)

  -- Draw the newly created grid
  !this.definition.draw()

endif

endmethod

------------------------------------------------------------------------
--
-- Method:      latticeCreate
--
-- Description: Create lattice on the current Ceiling Grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .latticeCreate()

  if (!this.latLength.val.unset() or !this.latLength.val.leq(0)) then
  	!!alert.message('Enter valid standard length')
  	return
  endif

  if (!this.latCross.val.dbRef().badref() ) then
  	!!alert.message('Enter valid Lattice Cross')
  	return
  endif

  if (!this.latEdge.val.dbRef().badref() ) then
  	!!alert.message('Enter valid Lattice Edge')
  	return
  endif

  if (!this.definition.set()) then
    !this.definition.latticeCross(!this.latCross.val.dbRef())
    !this.definition.latticeEdge(!this.latEdge.val.dbRef())
    !this.definition.maxProfLength = !this.latLength.val
    if (!this.definition.createLattice(!this.crtXLine.val, !this.crtYLine.val, !this.crtBndry.val)) then
      !this.mtDelLattice.active = TRUE
    endif
  else
    !!alert.warning('No Ceiling Grid defined, cannot create Lattice')
  endif

  !this.mainTasks(TRUE)
  !this.getProfiles()

endmethod

-- End of Method

------------------------------------------------------------------------
--
-- Method:      deleteGrid
--
-- Description: Delete CLNPNG
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteGrid()

  --should set current ceiling to delete here (from navigator for other element types)
  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.element).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
    !this.tidy()
  endif

  !this.ceilingGridList()

  !this.contentGrid.selectRow(1)
  -- Refresh Content navigator
  !!acccontentnavigator.refresh()
  handle (2,751)
  endhandle
endmethod



------------------------------------------------------------------------
--
-- Method:      deleteLattice
--
-- Description: Delete CLNLAT
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteLattice()

  --should set current ceiling to delete here (from navigator for other element types)
  -- Delete CLNLAT 1 of current element

  -- Get lattices
  !collection = object COLLECTION()
  !collection.scope(!this.element)
  !collection.filter(object EXPRESSION('PURP eq ''PRFL'''))
  !collection.type('CLNLAT')
  !lattices   = !collection.results()

  -- If there is no lattice element - no nothing
  if(!lattices.empty().not()) then
    if(!!accDeleteManager.deleteElement(!lattices.first()).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
      !this.tidy()
    endif
  endif
  -- if element is deleted then grey out button
  !lattices   = !collection.results()
  if(!lattices.empty()) then
    !this.mtDelLattice.active  = FALSE
  endif
endmethod



------------------------------------------------------------------------
--
-- Method:      deleteTiles
--
-- Description: Delete CLNTIL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteTiles()

  --should set current ceiling to delete here (from navigator for other element types)
  -- Delete all CLNTIL owned by current element

  -- Get tiles
  !collection = object COLLECTION()
  !collection.scope(!this.element)
  !collection.type('CLNTIL')
  !tiles   = !collection.results()

  -- If there is no tiles - no nothing
  if(!tiles.empty().not()) then
    if(!!accDeleteManager.deleteElements(!tiles).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
      !this.tidy()
    endif
  endif
  -- if tiles are deleted then grey out button
  !tiles   = !collection.results()
  if(!tiles.empty()) then
    !this.mtDelTile.active  = FALSE
  endif
endmethod


------------------------------------------------------------------------
--
-- Method:      updateData
--
-- Description: Update current data with gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateData()

  -- Initialise Variables
  if(!this.dbName.val.set()) then
    !this.definition.name         = !this.dbName.val
  endif

  !this.definition.description    = !this.dbDescription.val

  !this.definition.function = !this.dbFunction.val

  --!function = !this.dbFunction.val
  --!this.definition.function       = object STRING(!function)

  !this.definition.number         = !this.dbNumber.val

  if(!!isImperialLength('DIST')) then
    !this.definition.xSpacings      = 24in
    !this.definition.ySpacings      = 24in
  else
    !this.definition.xSpacings      = 600mm
    !this.definition.ySpacings      = 600mm
  endif

  if(!this.nAngle.val.set()) then
    !this.definition.nAngle = !this.nAngle.val
  else
    !this.definition.nAngle = 0
  endif

  if(!this.hAngle.val.set()) then
    !this.definition.hAngle = !this.hAngle.val
  else
    !this.definition.hAngle = 0
  endif

 --modified to get the user desired input
  !this.definition.colSchema      = !this.colSchema.displaytext()
  !this.definition.fireRating     = !this.fireRating.displaytext()
  !this.definition.knuckledTiles  = !this.knuckle.val
  !this.definition.tileThick      = !this.tileThk.val

endmethod

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkRef
--
-- Description: Check that the given DBREF is valid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkRef(!gadget is GADGET, !select is STRING)

  if (!gadget eq !this.detTileSPRF) then
    !this.createTiles.active = FALSE
    !crtBTN = !this.createTiles
  elseif (!gadget eq !this.profileSPREF) then
    !this.proAccept.active = FALSE
    !crtBTN = !this.proAccept
  else
    !this.createLattice.active = FALSE
    !crtBTN = !this.createLattice
  endif

  !inputRef = !gadget.val.dbRef()
  handle any
    !!alert.warning('Invalid Reference')
    !gadget.clear()
    return
  endhandle

  if (!inputRef.badref() or !inputRef.nulref()) then
    !!alert.warning('Invalid Reference')
    !gadget.clear()
    return
  endif

  if ( !inputRef.type neq 'SPCO' and  !inputRef.type neq 'SPRF' and  !inputRef.type neq 'GPART' and  !inputRef.type neq 'TABITE' ) then
    !!alert.warning('Wrong element type')
    !gadget.clear()
    return
  endif

  !crtBTN.active = TRUE

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      height
--
-- Description: Set height of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .height(!gadget is GADGET, !select is STRING)
  !this.definition.height(!gadget.val)
  refresh
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      geometry
--
-- Description: Define geometry for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometry()

  -- Define data to pass to shape definition form
  !plane  = !this.definition.plane
  !shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)

  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form for return to ceiling grid creation
  -- Information for form is:
  --   Calling form
  --   Form title
  --   Apply tag (Test for "apply" button)
  --   Action on completion, method name only, method must be in format
  --      .methodName(<SHAPEDEFINITION>)
  --   Default shape, should be at least pos and ori of the plane the
  --   shape is to be mapped onto.
  !!shapeDefinitionEditor.setup(!this, 'Define Ceiling Grid Boundary', 'Define Boundary', 'geometryUpdate', !shape)

endmethod

------------------------------------------------------------------------
--
-- Method:      geometryUpdate
--
-- Description: Update with returned data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometryUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  !this.crtShapeDef.val       = !shapeDefinition.description

  !this.definition.position(!shapeDefinition.profile.position)
  !this.definition.outerLoop  = !shapeDefinition.profile

  !this.definition.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: Set elevation of level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elevation()
  !this.definition.elevation(!this.clnHeight.val)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickOffset()

  --!this.gOffset.active = FALSE

  -- Initialise Variables
  !prompt               = 'Pick ceiling origin'
  !packet               = object EDGPACKET()
  !packet.pickpacket.stdPosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.offset(!this.return[1])'

  --!packet.definePosition(!prompt)

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickStart
--
-- Description: Setup EDG pick event for picking start position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickStart(!mode is STRING)

  -- Initialise variables
  !prompt               = 'Pick start of support profile'
  !packet               = object EDGPACKET()
  !packet.pickpacket.stdPosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  if(!mode.eq('CREATE')) then
    !packet.action        = '!!' & !this.name() & '.linePosition(|CREATE|, |START|,!this.return[1])'
  elseif(!mode.eq('MODIFY')) then
    !packet.action        = '!!' & !this.name() & '.linePosition(|MODIFY|, |START|,!this.return[1])'
  endif

  !packet.escape        = ''
  --!packet.definePosition(!prompt)

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickEnd
--
-- Description: Setup EDG pick event for picking end position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickEnd(!mode is STRING)

  -- Initialise variables
  !prompt               = 'Pick end of support profile'
  !packet               = object EDGPACKET()
  !packet.pickpacket.stdPosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  if(!mode.eq('CREATE')) then
    !packet.action        = '!!' & !this.name() & '.linePosition(|CREATE|, |END|,!this.return[1])'
  elseif(!mode.eq('MODIFY')) then
    !packet.action        = '!!' & !this.name() & '.linePosition(|MODIFY|, |END|,!this.return[1])'
  endif

  !packet.escape        = ''
  --!packet.definePosition(!prompt)

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      linePosition
--
-- Description: Load the position, relative to the outer boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     HEAD or TAIL
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .linePosition(!mode is STRING, !type is STRING, !data is EDGPOSITIONDATA)

  if(!mode.eq('CREATE')) then

    !startXPosGadget  = !this.crtStartX
    !startYPosGadget  = !this.crtStartY
    !endXPosGadget    = !this.crtEndX
    !endYPosGadget    = !this.crtEndY

  elseif(!mode.eq('MODIFY')) then

    !startXPosGadget  = !this.modStartX
    !startYPosGadget  = !this.modStartY
    !endXPosGadget    = !this.modEndX
    !endYPosGadget    = !this.modEndY

  endif

  !bndLins = object COLLECTION()
  !bndLins.scope(!this.element)
  !bndLins.type('BNDLIN')

  !boundLin = !bndLins.results()

  !outerBoundary = !boundLin[1].members[1]

  -- Position returned by pick
  !pickedPos    = !data.position.wrt(!outerBoundary)
  !pickedPos.up = 0

  if (!type eq 'START') then
    !startXPosGadget.val = !pickedPos.east
    !startYPosGadget.val = !pickedPos.north
    AID CLEAR ALL $!<this.aidNumberPrfStart>
    AID TEXT NUMBER $!<this.aidNumberPrfStart> 'START' At $!<pickedPos>

  elseif (!type eq 'END') then
    !endXPosGadget.val = !pickedPos.east
    !endYPosGadget.val = !pickedPos.north
    AID CLEAR ALL $!<this.aidNumberPrfEnd>
    AID TEXT NUMBER $!<this.aidNumberPrfEnd> 'END' At $!<pickedPos>
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyProfilePosition
--
-- Description: modifies profile start and end position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyProfilePosition(!profileEnd is STRING, !dir is STRING,!gadgetVal is REAL )

  if(!this.currentProfile.unset()) then
    return
  elseif(!this.currentProfile.position.unset()) then
    !this.currentProfile.poss = E0
    !this.currentProfile.pose = E0
  endif

  if(!profileEnd.eq('START')) then

    !profileStartPos  = !this.currentProfile.poss
    !profileStartPos.$!<dir> = !gadgetVal
    AID CLEAR ALL $!<this.aidNumberPrfStart>
    AID TEXT NUMBER $!<this.aidNumberPrfStart>  'START' At $!<profileStartPos>

  elseif(!profileEnd.eq('END')) then

    !profileEndPos  = !this.currentProfile.pose
    !profileEndPos.$!<dir> = !gadgetVal
    AID CLEAR ALL $!<this.aidNumberPrfEnd>
    AID TEXT NUMBER $!<this.aidNumberPrfEnd>    'END'   At $!<profileEndPos>

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createProfilePos
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createProfilePos(!gadget is GADGET, !action is STRING)

  if(!gadget.val.unset()) then
    !gadget.val = 0
  endif

  !profileStartPos  = object POSITION('E0 N0 U0')
  !profileEndPos    = object POSITION('E0 N0 U0')

  !bndLins = object COLLECTION()
  !bndLins.scope(!this.element)
  !bndLins.type('BNDLIN')

  !boundLin = !bndLins.results()

  !outerBoundary = !boundLin[1].members[1]

  if(!gadget.name().match('CRTSTART').gt(0) ) then

    !east   = !this.crtStartX.val
    !north  = !this.crtStartY.val
    !up     = !this.proEle.val
    !profileStartPos  = object POSITION('E $!east N $!north U $!up wrt $!outerBoundary')

    AID CLEAR ALL $!<this.aidNumberPrfStart>
    AID TEXT NUMBER $!<this.aidNumberPrfStart>  'START' At $!<profileStartPos>

  elseif(!gadget.name().match('CRTEND').gt(0) ) then
    !east   = !this.crtEndX.val
    !north  = !this.crtEndY.val
    !up     = !this.proEle.val
    !profileEndPos  = object POSITION('E $!east N $!north U $!up wrt $!outerBoundary')

    AID CLEAR ALL $!<this.aidNumberPrfEnd>
    AID TEXT NUMBER $!<this.aidNumberPrfEnd>    'END'   At $!<profileEndPos>
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyProfilePos
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyProfilePos(!gadget is GADGET, !action is STRING)

  if(!gadget.val.unset()) then
    !gadget.val = 0
  endif

  if(!this.currentProfile.unset()) then
    return
  elseif(!this.currentProfile.position.unset()) then
    !this.currentProfile.poss = E0
    !this.currentProfile.pose = E0
  endif

  !profileStartPos  = !this.currentProfile.poss
  !profileEndPos    = !this.currentProfile.pose

  if(!gadget.name().match('MODSTART').gt(0) ) then
    !profileStartPos.east   = !this.modStartX.val
    !profileStartPos.north  = !this.modStartY.val

    AID CLEAR ALL $!<this.aidNumberPrfStart>
    AID TEXT NUMBER $!<this.aidNumberPrfStart>  'START' At $!<profileStartPos>

  elseif(!gadget.name().match('MODEND').gt(0) ) then
    !profileEndPos.east   = !this.modEndX.val
    !profileEndPos.north  = !this.modEndY.val

    AID CLEAR ALL $!<this.aidNumberPrfEnd>
    AID TEXT NUMBER $!<this.aidNumberPrfEnd>    'END'   At $!<profileEndPos>
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      drawProfileLine
--
-- Description: Draws the aid line for the support profile being modelled
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Returns:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawProfileLine()

  !this.tidy()

  !!ce = !this.element

  !bndLins = object COLLECTION()
  !bndLins.scope(!this.element)
  !bndLins.type('BNDLIN')

  !boundLin = !bndLins.results()

  !outerBoundary = !boundLin[1].members[1]

  !startPos        = object POSITION()
  !startPos.origin = !outerBoundary
  !startPos.east   = !this.crtStartX.val
  !startPos.north  = !this.crtStartY.val
  !startPos.up     = !this.proEle.val

  !endPos          = object POSITION()
  !endPos.origin   = !outerBoundary
  !endPos.east     = !this.crtEndX.val
  !endPos.north    = !this.crtEndY.val
  !endPos.up       = !this.proEle.val

  !profileLine     = object LINE(!startPos, !endPos)
  !profileLine.draw(!this.aidNumber, 1, 4)
  -- handle errors due to null lines
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addProfile
--
-- Description: Add the details of the current line to the list gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addProfile()

  if (!this.profileSPREF.val.unset()) then
    !!alert.warning('Profile SPREF not set.')
    return FALSE
  endif

  !bndLins = object COLLECTION()
  !bndLins.scope(!this.element)
  !bndLins.type('BNDLIN')

  !boundLin = !bndLins.results()

  !outerBoundary = !boundLin[1].members[1]
  -- get the elevation from the outer boundary
  --!outerBoundaryElev  = !outerBoundary.position.up

  !lineDetails = object ARRAY()
  !lineDetails.append(!this.profileSPREF.val)
  !lineDetails.append(!this.proLength.val.string(!!distanceFmt))

  !startPos        = object POSITION()
  !startPos.origin = !outerBoundary
  --!startPos.origin = world
  !startPos.east   = !this.crtStartX.val
  !startPos.north  = !this.crtStartY.val
  !startPos.up     = !this.proEle.val

  if (!startPos.unset()) then
    !!alert.warning('Profile Start Position not defined.')
    return
  endif

  !endPos          = object POSITION()
  !endPos.origin   = !outerBoundary
  --!endPos.origin   = world
  !endPos.east     = !this.crtEndX.val
  !endPos.north    = !this.crtEndY.val
  !endPos.up       = !this.proEle.val

  if (!endPos.unset()) then
    !!alert.warning('Profile End Position not defined.')
    return
  endif

  if(!startPos.eq(!endPos)) then
    !!alert.warning('Profile Start and End Position are same')
    return
  endif

  !lineDetails.append(!startPos.string())
  !lineDetails.append(!endPos.string())

  !this.lineList.addRow(!lineDetails)

  -- Clear old line values
  !this.crtStartX.val = 0
  !this.crtStartY.val = 0
  !this.crtEndX.val   = 0
  !this.crtEndY.val   = 0

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createLatticeProfs
--
-- Description: Loops through the profile list and creates them all
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createLatticeProfs()

  -- check if spec is set for the profile
  -- check only when creating profiles using grid outer boundary
  if (!this.crtOuterBnd.val) then
    if(!this.profileSPREF.val.unset()) then
      !!alert.warning('Profile SPREF not set.')
      return
    else
      !prfSpref = object DBREF(!this.profileSPREF.val)
      handle ANY
        !prfSpref = object DBREF('/' & !this.profileSPREF.val)
        handle ANY
          !!alert.warning('Entered value is not a valid SPREF element')
          return
        endhandle
      endhandle
    endif
  endif

  if(!this.crtOuterBnd.val.not()) then
    -- get the line details from the list
    !lines = !this.lineList.getRows()
    if(!lines.size() eq 0) then
      !!alert.warning('No Profiles added to the list.')
      return
    endif
  endif

  -- Get lattices
  !collection = object COLLECTION()
  !collection.scope(!this.element)
  !collection.filter(object EXPRESSION('PURP eq ''PRFL'''))
  !collection.type('CLNLAT')
  !lattices   = !collection.results()

  -- If there is no lattice element, then create one
  if(!lattices.empty()) then
    !!ce      = !this.element
    NEW CLNLAT
    PURP PRFL
  -- Existing lattice
  else
    !!ce      = !lattices.first()
  endif

  !outerBound = !this.crtOuterBnd.val

  -- creating profiles using the outer boundary of the grid
  if (!outerBound) then

    !outerBoundary = !this.definition.ceilingGrid.outerBoundary()

    !edges = !outerBoundary.edges()

    !arcs = object ARRAY()

    do !i indices !edges

      if (!edges[!i].objecttype() eq 'LINE') then

        break if (!edges[!i].startposition eq !edges[!i].endPosition)

        !lineLength = !edges[!i].length()

        if (!this.proLength.val gt 0) then
          !maxLength = !this.proLength.val
        else
          !maxLength = 2000mm
        endif

        -- Standard size functionality
        if (!lineLength lt !maxLength) then

          NEW GENSEC

          !!ce.spref    = !this.profileSPREF.val.dbRef()
          !!ce.position = !edges[!i].startposition
          NEW SPINE
          NEW POINSP
          NEW POINSP
          !!ce.position = !edges[!i].endPosition
          GENSEC
          DRNS PERP DRNE PERP
        else

          !startDist = 0
          !startPoint = object POINTVECTOR(!edges[!i].startposition, !edges[!i].direction())

          do

            break if (!startDist ge !lineLength)

            !firstPoint = !startPoint.offset(!startDist)

            !endDistance = !lineLength - !startDist

            if (!endDistance le !maxLength) then
              !endPoint = !edges[!i].endPosition
            else
              !endPoint = !firstPoint.offset(!maxLength).position
            endif

            NEW GENSEC

            !!ce.spref = !this.profileSPREF.val.dbRef()
            !!ce.position = !firstPoint.position

            NEW SPINE
            NEW POINSP
            NEW POINSP

            !!ce.position = !endPoint

            GENSEC
            DRNS PERP DRNE PERP

            !startDist = !startDist + !maxLength

          enddo

        endif

      else
        !arcs.append(!edges[!i])
      endif

    enddo

    do !k indices !arcs

      !maxLength = !this.proLength.val

      !arcLen = !arcs[!k].length()

      if (!arcLen gt !maxLength) then
        !startChord = !maxLength
        !startAngle = !arcs[!k].startAngle
        !endAngle   = !arcs[!k].endAngle

        !firstArc = !arcs[!k]

        !distanceLeft = !arcLen

        do

          break if (!startChord ge !arcLen)

          !newArc = !firstArc.chord(!startChord)

          !newArc.startAngle = !startAngle

          !arcArr = object ARRAY()
          !arcArr.append(!newArc)
          !arcSet = object PROFILE(!outerBoundary.position, !outerBoundary.orientation, !arcArr)

          NEW GENSEC
          !!ce.spref = !this.profileSPREF.val.dbRef()
          !pos = !!ce.position
          !pos.up = !this.proEle.val
          !!ce.position = !pos
          NEW SPINE
          !arcSet.dbWrite(ce)

          !startAngle = !newArc.endAngle

          !distanceLeft = !arcLen - !startChord

          if (!distanceLeft le !maxLength) then
            !finalArc = object ARC(!arcs[!k].position, !arcs[!k].orientation, !startAngle, !endAngle, !arcs[!k].radius, TRUE)

            !arcArr = object ARRAY()
            !arcArr.append(!finalArc)
            !arcSet = object PROFILE(!outerBoundary.position, !outerBoundary.orientation, !arcArr)

            NEW GENSEC
            !!ce.spref = !this.profileSPREF.val.dbRef()
            !pos = !!ce.position
            !pos.up = !this.proEle.val
            !!ce.position = !pos
            NEW SPINE
            !arcSet.dbWrite(ce)
          endif

          !startChord = !startChord + !maxLength

        enddo

      else

        !arcArr = object ARRAY()
        !arcArr.append(!arcs[!k])

        !arcSet = object PROFILE(!outerBoundary.position, !outerBoundary.orientation, !arcArr)

        NEW GENSEC
        !!ce.spref = !this.profileSPREF.val.dbRef()
        !pos = !!ce.position
        !pos.up = !this.proEle.val
        !!ce.position = !pos
        NEW SPINE
        !arcSet.dbWrite(ce)

      endif
    enddo


    !this.crtOuterBnd.val = FALSE

  -- creating profiles from the data in the profile list
  else
    -- Array of arrays of line details
    !lines = !this.lineList.getRows()
    if(!lines.size() eq 0) then
      !!alert.error('No Profiles added to the list.')
      return
    endif

      -- Create lattice elements for each line listed
      do !i indices !lines

        !currLine = object LINE(!lines[!i][3].position(), !lines[!i][4].position())
        !lineLength = !currLine.length()

        !test = object REAL(!lines[!i][2],!!distanceFmt)
        if (  !test gt 0 ) then
          !maxLength =  !test
          !profileCreated = FALSE
        else
          NEW GENSEC

          !!ce.spref    = !lines[!i][1].dbRef()
          !!ce.position = !lines[!i][3].position()
          NEW SPINE
          NEW POINSP
          NEW POINSP
          !!ce.position = !lines[!i][4].position()
          GENSEC
          DRNS PERP DRNE PERP

          !profileCreated = TRUE

          !this.lineList.selectallrows()
          !this.lineList.deleteSelectedRows()
          !this.outerBoundCheck()

        endif

        -- Standard size functionality
        if (!profileCreated.not()) then
          if (!lineLength lt !maxLength) then

            NEW GENSEC

            !!ce.spref    = !lines[!i][1].dbRef()
            !!ce.position = !lines[!i][3].position()
            NEW SPINE
            NEW POINSP
            NEW POINSP
            !!ce.position = !lines[!i][4].position()
            GENSEC
            DRNS PERP DRNE PERP

          else

            !startDist = 0
            !startPoint = object POINTVECTOR(!lines[!i][3].position(), !currLine.direction())

            do

              break if (!startDist ge !lineLength)

              !firstPoint = !startPoint.offset(!startDist)

              !endDistance = !lineLength - !startDist

              if (!endDistance le !maxLength) then
                !endPoint = !lines[!i][4].position()
              else
                !endPoint = !firstPoint.offset(!maxLength).position
              endif

              NEW GENSEC

              !!ce.spref = !lines[!i][1].dbRef()
              !!ce.position = !firstPoint.position

              NEW SPINE
              NEW POINSP
              NEW POINSP

              !!ce.position = !endPoint

              GENSEC
              DRNS PERP DRNE PERP

              !startDist = !startDist + !maxLength

            enddo

          endif
        endif

      enddo

  endif

  !this.lineList.selectallrows()
  !this.lineList.deleteSelectedRows()
  !this.outerBoundCheck()

  !this.getProfiles()

  !this.mtDelLattice.active = TRUE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offsetProfile
--
-- Description: Create a copy of the selected profile with the passed offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetProfile()

  if(!this.currentProf.val.set()) then
  !!ce = !this.currentProf.val.dbRef()
  else
    !!alert.message('Profile to be copied is not set')
    return
  endif

  NEW GENSEC

  !name                       = !this.newProfName.val.trim()
  if(!name.neq('')) then
    !name                     = '/' & !name
    !!ce.name      = !name
  endif

  if (!this.eastOffset.val.set()) then
    !eastOff = !this.eastOffset.val
  else
    !eastOff = 0
  endif

  if (!this.northOffset.val.set()) then
    !northOff = !this.northOffset.val
  else
    !northOff = 0
  endif

  COPY PREVIOUS

  BY NORTH $!<northOff> EAST $!<eastOff>


endmethod

------------------------------------------------------------------------
--
-- Method:      chooseProfile
--
-- Description: Update form with data on chosen profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .chooseProf()

  !profile = !!ce
  if(!profile.fulltype.neq('GENSEC')) then
    --!!error.text            = 'Element "' & !profile.namn & '" is not a GENSEC.'
    !!alert.warning('Element "' & !profile.namn & '" is not a GENSEC.')
     return false
  endif

  !this.currentProf.val = !profile.name

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Set xyOffset of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!gadget is GADGET, !select is STRING)

  if (!gadget eq !this.gXOffset) then
    !this.definition.gridOffset(!this.gXOffset.val, !this.gYOffset.val)

  elseif (!gadget eq !this.gYOffset) then
    !this.definition.gridOffset(!this.gXOffset.val, !this.gYOffset.val)
  else
    !this.definition.xyOffset(!this.xOffset.val, !this.yOffset.val)
  endif

  -- Update trimmed tile gadgets
  !this.trimmedTiles.val    = !this.definition.ceilingGrid.numberOfTrimmedCells()
  !this.untrimmedTiles.val  = !this.definition.ceilingGrid.numberOfUntrimmedCells()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to ceiling offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

  !this.gOffset.active = TRUE
  if  (!this.currentPane  eq !this.layoutPane ) then

    -- Initialise Variables
    !this.definition.gridOffset(!data.position)

    -- Update gadget
    !xyOffset             = !this.definition.ceilingGrid.gridXYPosition()
    !this.gXOffset.val    = !xyOffset.x
    !this.gYOffset.val    = !xyOffset.y

    !this.trimmedTiles.val    = !this.definition.ceilingGrid.numberOfTrimmedCells()
    !this.untrimmedTiles.val  = !this.definition.ceilingGrid.numberOfUntrimmedCells()

  else

    -- Initialise Variables
    !this.definition.xyOffset(!data.position)

    -- Update gadget
    !this.xOffset.val = !this.definition.xyOffset[1]
    !this.yOffset.val = !this.definition.xyOffset[2]

  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundOffset
--
-- Description: Alter the outer boundary by a given offset
--
-- Method Type: Function/Procedure
-- Arguments:
--    [#] [R/RW] [Data Type] [Description]
--     1    R       REAL         Offset
-- Return:
--    [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundOffset(!offset is REAL)

  -- outer
  if ( !this.boundCh.val eq 1 ) then
     !this.definition.offsetOuterBoundary(!offset)
  -- inner
  elseif ( !this.boundCh.val eq 2 ) then
     !this.definition.offsetInnerBoundaries(-!offset)
  -- all
  elseif ( !this.boundCh.val eq 3 ) then
     !this.definition.offsetBoundaries(!offset)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useOwnersGeometry
--
-- Description: Use owning boundary definition (if there is one)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useOwnersGeometry()

  -- Get gadget setting
  !useOwner             = !this.crtShapeO.val

  -- Make shape definition inactive
  !this.crtShape.active = !useOwner.not()

  -- Get owning geometry
  if(!useOwner) then

    -- Check if there is a boundary defined
    !boundary = BNDLIN 1 OF $!<this.owner>
    -- No boundary to use
    handle ANY
    -- Use owning boundary
    elsehandle NONE
      !plane    = !this.definition.plane
      !profile  = object PROFILE(LOOP 1 of $!<boundary> )
      !newShape = object SHAPEMODIFIER()
      !profile  = !newShape.intersect(!profile, !plane)

      -- Modify definition profile
      !shape      = object SHAPEDEFINITION(!plane.position, !plane.orientation)
      !shape.description  = 'Derived from owner'
      !shape.profile      = !profile
      !this.geometryUpdate(!shape)

    endhandle

 endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      nAngle
--
-- Description: Set angle from owners Y Axis
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nAngle(!gadget is GADGET, !select is STRING)

  -- transform to world nAngle
  !orientation = !this.element.orientation

  !nAngle = !orientation.ydir().wrt(WORLD).north.acos()
  !nAngleLocal = !orientation.ydir().north.acos()
  !this.definition.nAngle(!gadget.val + !nAngle - !nAngleLocal )
  refresh
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hAngle
--
-- Description: Set horizontal angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hAngle(!gadget is GADGET, !select is STRING)
  !this.definition.hAngle(!gadget.val)
  refresh
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      catalogueSearch
--
-- Description: Choosing catalogue elements for Ceiling Tiles and Lattice Cross/Edges
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------

define method .catalogueSearch(!gadget is GADGET, !dummyString is STRING)

  if (!gadget eq !this.searchTiles) then

    !!stchoosedata.cleardata()

    !!stchoosedata.settitle('Ceiling Tiles')

    !!stchoosedata.setdata('ROOM','CLTI')

    !!stchoosedata.questions[1] = 'TYPE'
    !!stchoosedata.questions[2] = 'WIDT'
    !!stchoosedata.questions[3] = 'LENG'
    !!stchoosedata.answers[1]   = 'Ceiling Tile'
    !!stchoosedata.answers[2]   = !this.tileXSpacing.val
    !!stchoosedata.answers[3]   = !this.tileYSpacing.val

    !!stchoosedata.setTable()

    show !!stchooseselection

    !!stchooseselection.action = object BLOCK('!!' & !this.name() & '.setTileSpref(!this.selectedItem.name.string())')

  elseif (!gadget eq !this.searchProfile) then

    !profileData = object PROFILECATALOGUEDATA()

    !plineList   = ARRAY()

    -- Selection form title
    !title              = 'Select Lattice Profiles'

    -- Action to be carried out
    !action             = '!!' & !this.name() & '.latticeResult(|Profile|,!this.profile.catref.name)'

    -- Setup object for profile selection
    !profileSelection   = object PROFILESELECTION(!title, !action)

    !profileSelection.profileData(!profileData)
    !profileSelection.defaultPlines(!plineList)

    -- Display profile selection form
    !profileSelection.show()

    if (!!sectionprofileselection.specList.dtext.findFirst('Lattice Profiles').set().not()) then
      !!sectionprofileselection.selectSpecification()
    else
      !!sectionprofileselection.specList.select('dtext' , 'Lattice Profiles')
      !!sectionprofileselection.selectSpecification()
    endif

  elseif (!gadget eq !this.searchLattice) then

    !profileData = object PROFILECATALOGUEDATA()

    !plineList   = ARRAY()

    -- Selection form title
    !title              = 'Select Lattice Profiles'

    -- Action to be carried out
    !action             = '!!' & !this.name() & '.latticeResult(|Lattice Cross|,!this.profile.catref.name)'

    -- Setup object for profile selection
    !profileSelection   = object PROFILESELECTION(!title, !action)

    !profileSelection.profileData(!profileData)
    !profileSelection.defaultPlines(!plineList)

    -- Display profile selection form
    !profileSelection.show()

    if (!!sectionprofileselection.specList.dtext.findFirst('Lattice Profiles').set().not()) then
      !!sectionprofileselection.selectSpecification()
    else
      !!sectionprofileselection.specList.select('dtext' , 'Lattice Profiles')
      !!sectionprofileselection.selectSpecification()
    endif

  elseif (!gadget eq !this.searchBound) then

    !profileData = object PROFILECATALOGUEDATA()

    !plineList   = ARRAY()

    -- Selection form title
    !title              = 'Select Lattice Profiles'

    -- Action to be carried out
    !action             = '!!' & !this.name() & '.latticeResult(|Lattice Edge|,!this.profile.catref.name)'

    -- Setup object for profile selection
    !profileSelection   = object PROFILESELECTION(!title, !action)

    !profileSelection.profileData(!profileData)
    !profileSelection.defaultPlines(!plineList)

    -- Display profile selection form
    !profileSelection.show()

    if (!!sectionprofileselection.specList.dtext.findFirst('Lattice Profiles').set().not()) then
      !!sectionprofileselection.selectSpecification()
    else
      !!sectionprofileselection.specList.select('dtext' , 'Lattice Profiles')
      !!sectionprofileselection.selectSpecification()
    endif

  endif

endmethod

-- End of method

-------------------------------------------------------------------------
--
-- Method:      setTileSpref
--
-- Description: Set the value of the Tile Spref textbox with the passed
--              SPREF value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING      Name of Fitting
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------

define method .setTileSpref(!fittingName is STRING)

  !this.detTileSPRF.val = !fittingName
    !this.createTiles.active = TRUE

endmethod

-------------------------------------------------------------------------
--
-- Method:      latticeResult
--
-- Description: Check the Gtype and destination of a selected profile
--              and then load the value to the appropriate gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING      GTYPE of Profile
--    2    R      STRING      Name of Profile
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------

define method .latticeResult(!gType is STRING, !profileName is STRING)

  if (!gType eq 'Lattice Cross') then
    !this.latCross.val = !profileName
    !!sectionprofileselection.hide()
  elseif (!gType eq 'Lattice Edge') then
    !this.latEdge.val = !profileName
    !!sectionprofileselection.hide()
  elseif (!gType eq 'Profile') then
    !this.profileSPREF.val = !profileName
    !!sectionprofileselection.hide()
    !this.proAccept.active = TRUE
  endif

endmethod

-------------------------------------------------------------------------
--
-- Method:      createTiles
--
-- Description: Creates a set of Ceiling Tiles for the Ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       SPREF of CEILING TILE
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------

define method .createTiles(!cellType is DBREF)

  if(!cellType.badref()) then
  	!!alert.message('Enter a valid specification reference')
  	return
  endif

  !this.definition.cellXsize = !this.tileXSpacing.val
  !this.definition.cellYsize = !this.tileYSpacing.val
  !this.definition.createTiles(!cellType)
  !this.mtDelTile.active  = TRUE

endmethod

-- End of Method

------------------------------------------------------------------------
--
-- Method:      backToMainRoomDesignTasks
--
-- Description: Switching to Main Room Design Tasks
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backToMainRoomDesignTasks()

  !this.mainTasks(true)
  --!this.hide()
  !!accTaskManager.active('accDetail')
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      locateFromTree
--
-- Description: Locate current element in navigator
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locateFromTree()


  -- Determine the owning element type
  !reference    = !!ce
  if(!reference.type.eq('GENSEC')) then
     if(!reference.owner.type.eq('CLNLAT')) then
        if(!reference.owner.owner eq !this.element ) then
           !this.currentProfile = !reference
	   !elementList[1]   = !reference.string()
	   !elementList[2]   = 'CLNLATTICE'
           !rows = !this.profileGrid.getRows()
           !index = !rows.findFirst(!elementList)
           if(!index.unset()) then
    	       !index = 0
           endif
           !this.profileGrid.clearRowselection()
           !this.profileGrid.selectRow(!index)
           handle ANY
             !this.profileGrid.selectRow(0)
             handle ANY
             endhandle
           endhandle
        endif
     endif
  endif

endmethod
-- End of method definition
