--
-- File:            accceilinggriddefinition.pmlfrm
--   Type:          Form Definition
--   Group:         Room Design
--
--     Keyword:     Ceiling Grid
--   Module:        design
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Sun Feb 26 00:00:00 BST 2007
--
--
-- Description:
--   Ceiling grid definition form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accCeilingGridDefinition()       -                   Constructor
--  addProfile()                     -                   Add the details of the current line to the list gadget
--  backToMainRoomDesignTasks()      -                   Switching to Main Room Design Tasks
--  boundOffset(REAL)                -                   Alter the outer boundary by a given offset
--  catalogueSearch(GADGET,STRING)   -                   Choosing catalogue elements for Ceiling Tiles and Lattice Cross/Edges
--  ceilingGridList()                -                   Update the list of ceilings
--  ceilingList()                    -                   Update the list of ceilings
--  checkElement(ARRAY)              BOOLEAN             Check whether there is a valid selected element
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  checkRef(GADGET,STRING)          -                   Check that the given DBREF is valid
--  chooseProf()                     -
--  copyProfile(BOOLEAN)             -                   Display copy profile pane
--  create()                         -                   Change grid spacing
--  createGrid(BOOLEAN)              -                   Display ceiling grid pane in create mode
--  createLatticeProfs()             -                   Loops through the profile list and creates them all
--  createProfile(BOOLEAN)           -                   Display ceiling profile pane
--  createProfilePos(GADGET,STRING)  -
--  createTiles(DBREF)               -                   Creates a set of Ceiling Tile elements for the selected Ceiling grid
--  deleteGrid()                     -
--  deleteLattice()                  -                   Delete CLNLAT
--  deleteTiles()                    -                   Delete CLNTIL
--  detailGrid(BOOLEAN)              -                   Display detail pane for ceiling gird
--  drawProfileLine()                -                   Draws the aid line for the support profile being modelled
--  dummy()                          -                   Dummy method for unset
--  elevation()                      -                   Set elevation of level
--  geomGrid(BOOLEAN)                -                   Switch to Grid Geometry Pane
--  geometry()                       -                   Define geometry for element
--  geometryUpdate(SHAPEDEFINITION)  -                   Update with returned data
--  getProfiles()                    -                   Retrieve all of the lattice profiles on a ceiling grid
--  gridAngle(GADGET,STRING)         -                   Change grid angle
--  gridControlOnPopup(ARRAY)        -
--  gridCreate()                     -                   Create Grid
--  gridDetail()                     -                   Detail Grid
--  gridGeometry()                   -                   Geometry Grid
--  gridLayout()                     -                   Layout Grid
--  gridModify()                     -                   Modify Grid
--  gridSpacing()                    -                   Change grid spacing
--  hAngle(GADGET,STRING)            -                   Set horizontal angle
--  height(GADGET,STRING)            -                   Set height of element
--  initialise()                     -                   Initialise form.
--  initialise(DBREF)                -                   Initialise form.
--  latticeCreate()                  -                   Create lattice on the current Ceiling Grid
--  latticeResult(STRING,STRING)     -                   Check the Gtype and destination of a selected profile
--  layoutGrid(BOOLEAN)              -                   Display layout pane ceiling gird
--  linePosition(STRING,STRING,EDGPOSITIONDATA) -                   Load the position, relative to the outer boundary
--  locateFromTree()                 -                   Locate current element in navigator
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  modify(DBREF)                    BOOLEAN             Load for with passed ceiling grid element
--  modify(GADGET,STRING)            BOOLEAN             Updating a currently existing CLNPNG element
--  modifyGrid(BOOLEAN)              -                   Display ceiling grid pane in modify mode
--  modifyProfile(BOOLEAN)           -                   Display ceiling profile pane in modify mode
--  modifyProfilePos(GADGET,STRING)  -
--  modifyProfilePosition(STRING,STRING,REAL) -
--  nAngle(GADGET,STRING)            -                   Set angle from owners Y axis
--  offset(EDGPOSITIONDATA)          -                   Map picked position to ceiling offset
--  offset(GADGET,STRING)            -                   Set xyOffset of element
--  offsetProfile()                  -                   Create a copy of the selected profile with the passed offset
--  onRemoveProfileClicked()         -
--  outerBoundCheck()                -                   Setup form according to outer boundary check
--  pickEnd(STRING)                  -                   Setup EDG pick event for picking end position
--  pickOffset()                     -                   Setup EDG pick event for picking position
--  pickStart(STRING)                -                   Setup EDG pick event for picking start position
--  profileCopy()                    -                   Copy Support Profiles
--  profileCreate()                  -                   Create Support Profiles
--  profileModify()                  -                   Modify Profile
--  refresh()                        -                   Refresh form from navigator.
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  select(ARRAY)                    -                   Select from list of ceilings
--  selectProfile(ARRAY)             -                   Select from list of ceiling profiles
--  setTileSpref(STRING)             -                   Set the value of the Tile Spref textbox with the passed
--  tidy()                           -                   Tidy aid graphics
--  updateData()                     -                   Update current data with gadget values
--  updateGadgets()                  -                   Update gadgets with object data
--  updateHangers()                  -                   Update position of hangers connected to a profile
--  useOwnersGeometry()              -                   Use owning boundary definition (if there is one)
--

-- Import DLL

setup form !!accCeilingGridDefinition dialog dock right

  -- Form details
  !this.formTitle    = 'Ceiling Grid'
  !this.icontitle    = ''
  !this.callback     = '!this.initialise()'
  !this.cancelCall   = '!this.tidy()'
  !this.formrevision = ''

  -- Current hierarchy
  paragraph .currentOwner                     anchor top + left + right         at x0.5                   ymax                width 30 lines 1
  combo     .currOwnList  'Current Ceiling:'  tagwidth 12 anchor top + left + right    at xmin            ymax+0.5            callback '!this.ceilingGridList()'      width 13

  -- Main Task Pane
  frame .mainTaskPane panel                   anchor top + left + right         at x0                     ymax

    paragraph .gridSelect                                                       at xmin                   ymax+0.5            text 'Select Grid'
    -- List of ceiling grids
    container .ceilingList PMLNetCONTROL 'NET'  anchor left + right + top       at xmin                   ymax+0.2            width 30 lines 8

    -- Create options
    paragraph .gridCreateTasks                                                  at x0.5                   ymax                text 'Create'
    line .mainTaskL1                          anchor top + left + right         at xmin                   ymax                horizontal width 30
    button .mtCrtGrid     linkLabel 'Ceiling Grid'                              at x2                     ymax                callback '!this.gridCreate()'
    button .mtCrtProfs    linkLabel 'Lattice Profile'                           at xmin                   ymax                callback '!this.profileCreate()'

    -- Modify options
    paragraph .gridModifyTasks                                                  at x0.5                   ymax+0.5            text 'Modify'
    line   .mainTaskL2                        anchor top + left + right         at xmin                   ymax                horizontal width 30
    button .mtModDef      linkLabel 'Grid Definition'                           at x2                     ymax                callback '!this.gridModify()'
    button .mtModGeom     linkLabel 'Grid Geometry'                             at xmin                   ymax                callback '!this.gridGeometry()'
    button .mtModLayout   linkLabel 'Grid Layout'                               at xmin                   ymax                callback '!this.gridLayout()'
    button .mtModDetail   linkLabel 'Grid Detail'                               at xmin                   ymax                callback '!this.gridDetail()'
    button .mtModProfiles linkLabel 'Lattice Profile'                           at xmin                   ymax                callback '!this.profileModify()'

    -- Copy options
    paragraph .gridCopyTasks                                                    at x0.5                   ymax+0.5            text 'Copy'
    line .mainTaskL3                          anchor top + left + right         at xmin                   ymax                horizontal width 30
    button .mtCopyProf    linkLabel 'Copy Profile'                              at x2                     ymax                callback '!this.profileCopy()'

    -- Delete options
    paragraph .gridDeleteTasks                                                  at x0.5                   ymax+0.5            text 'Delete'
    line      .mainTaskL4                     anchor top + left + right         at xmin                   ymax                horizontal width 30
    button    .mtDelGrid  linkLabel 'Delete ceiling grid'                       at x2                     ymax                callback '!this.deleteGrid()'
    button    .mtDelLattice  linkLabel 'Delete ceiling lattice'                 at x2                     ymax                callback '!this.deleteLattice()'
    button    .mtDelTile  linkLabel 'Delete ceiling tiles'                      at x2                     ymax                callback '!this.deleteTiles()'

    paragraph .blTskBackMainIcon1            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain1     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit

  -- Grid creation/modification pane
  frame .editPane panel                             anchor top + left + right   at xmin.mainTaskPane      ymin.currOwnList

    paragraph .editTitle                            anchor top + left + right   at x0.5                   ymax                text 'Basic Attributes:' width 30 lines 1
    line .editLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Gadgetry definition for creation
    text .dbName  'Name:'  tagwidth 9               anchor top + left + right   at x2                     ymax+0.2            callback '!this.checkName(!this.dbName, !this.definition.name)' width 20 is STRING
    path down
    halign right
    text .dbDescription 'Description:' tagwidth 9   anchor top + left + right                                                 callback '' width 20 is STRING
    text .dbFunction    'Function:' tagwidth 9      anchor top + left + right   at xmin                   ymax+0.2            callback '' width 20 is STRING
    numericinput .dbNumber 'Number:'  tagwidth 9    anchor top + left           at xmin                   ymax+0.2            callback '' range 0 10000 ndp 0 width 4

    -- Positioning
    paragraph .location                             anchor top + left + right   at x0.5                   ymax+0.2            text 'Location:' width 28 lines 1
    line .editLine2                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Angle from Y Axis
    numericinput .nAngle 'Angle from ceiling Y axis:' tagwidth 20 anchor t + l   at x2                     ymax+0.2            callback '!this.nAngle('  range 180 -180 ndp 0 value 0 width 4

    -- Angle from horizontal
    numericinput .hAngle 'Angle from horizontal:'   tagwidth 20 anchor t + l    at xmin                   ymax+0.2            callback '!this.hAngle('  range 90 -90 ndp 0 value 0 width 4

    -- Ceiling height
    text .clnHeight 'Height from ceiling:' tagwidth 13 anchor top + left + right at x2                    ymax+0.5            callback '!this.elevation()' width 16  is REAL format !!distanceFmt

    -- XY Offset of floor from building origin
    button .offset linkLabel 'Offset from ceiling'  anchor top + left + right   at x2                     ymax+0.2            callback '!this.pickOffset()' width 20
    text .xOffset   'X:'                            anchor top + left + right   at xmin+4                 ymax                callback '!this.offset(' width 22 is REAL format !!distanceFmt
    text .yOffset   'Y:'                            anchor top + left + right   at xmin                   ymax+0.2            callback '!this.offset(' width 22 is REAL format !!distanceFmt


    -- Defaults
    frame .criteria FoldUpPanel 'Design Criteria' anchor top + left + right     at x0                     ymax+0.5            width 32

      -- Ceiling height
      text .tileThk 'Default tile thickness:' tagwidth 15 anchor top + left     at x0.5                   ymax+0.5            width 11  is REAL format !!distanceFmt

      -- Knuckled tiles
      toggle .knuckle  'Knuckled ceiling tiles'     anchor t + l                at x2                     ymax+0.5

      -- Colour scheme
      combo .colSchema 'Colour Schema:' tagwidth 11 anchor t + l                at x0.5                   ymax+0.5            width 13

      -- Fire rating
      combo .fireRating 'Fire rating:'  tagwidth 11 anchor t + l                at x0.5                   ymax+0.5            width 13

    exit

    -- Modification data specific to a Grid
    frame .modPane panel                            anchor top + left + right   at x0                     ymax+0.5

      -- Accept Changes
      paragraph .modAcceptIcon                      anchor top + left           at x0                     ymax+0.2            pixmap width 15 height 15
      button .modAccept  linkLabel 'Accept Changes' anchor top + left           at xmax+0.5               ymin                callback '!this.modify(' width 10

      -- Discard Changes
      paragraph .modDiscardIcon                     anchor top + right          at xmax+4                 ymin                pixmap width 15 height 15
      button .modDiscard linkLabel 'Discard Changes' anchor top + right         at xmax+0.5               ymin                callback '!this.updateGadgets()!this.mainTasks(true)' width 10

      paragraph .modBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      button .modMain   linkLabel   'Back to main grid tasks'                   at xmax+1                 ymin                callback '!this.updateGadgets()!this.mainTasks(true)'

      paragraph .blTskBackMainIcon2            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
      button .blTskMain2     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

    exit

    -- Creation data specific to a Grid
    frame .crtPane panel                            anchor top + left + right   at xmin.modPane           ymin.modPane

      paragraph .createGeometry                     anchor top + left + right   at x0.5                   ymax                text 'Geometry' width 28 lines 1
      line .editLine3                               anchor top + left + right   at xmin                   ymax                horizontal width 30

      -- Define geometry
      toggle .crtShapeO 'Use owning ELEMENT geometry' tagwidth 28 anchor t + l + r  at xmin               ymax+0.2            callback '!this.useOwnersGeometry()'
      button .crtShape linkLabel  'Define grid geometry:' anchor t + l + r    at xmin                   ymax+0.2            callback '!this.geometry()' width 28
      paragrap .crtShapeDef                         anchor top + left + right   at xmin+2                 ymax                width 28 lines 1

      -- Create Room
      paragraph .crtAcceptIcon                      anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      button .crtAccept linkLabel 'Create grid'     anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.create()' width 12

      paragraph .crtBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      button .crtMain   linkLabel 'Back to main grid tasks'                     at xmax+1                 ymin                callback '!this.mainTasks(true)'

      paragraph .blTskBackMainIcon3            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
      button .blTskMain3     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

    exit

  exit

  -- Support Profile Create

  frame .crtProfile panel                           anchor top + left + right   at xmin.mainTaskPane      ymax.currOwnList

     -- Search Lattice
    paragraph .proSearchIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button    .searchProfile  linkLabel 'Select Profile Specification...' anchor top + left     at xmax+0.5               ymin                callback '!this.catalogueSearch('

    text      .profileSPREF   'Specification:'  tagwidth 9  anchor top + left + right   at x2                     ymax+0.2            callback '!this.checkRef(' width 15 is STRING

    -- Gadgetry definition for creation
    path down
    halign right
    numericinput .proEle 'Elevation:' tagwidth 9    anchor top + left + right   at xmin                   ymax+0.2            callback '' range 0 300 ndp 0 width 5
    text      .proLength 'Length:'    tagwidth 9    anchor top + left + right   at xmin                   ymax+0.2            width 10 is REAL format !!distanceFmt

    toggle .crtOuterBnd 'Outer Boundary' tagwidth 9 anchor top + left           at xmin                   ymax+0.2            callback '!this.outerBoundCheck()'

    -- Pick Start Pos
    frame .startPosPan FoldUpPanel 'Start Position'   anchor top + left + right   at x1                     ymax+0.5            width 30
      button .startPick linkLabel 'Pick start position' anchor top + left + right   at x2                     ymax                callback '!this.pickStart(''CREATE'')' width 20

    var !coordinate coordinate
    if(!coordinate.eq('XYZ')) then
      !posX = |X:|
      !posY = |Y:|
    else
      !posX = |X:|
      !posY = |Y:|
    endif

      text   .crtStartX    |$!posX|   tagwidth 5              anchor top + left + right   at xmin                   ymax+0.2          callback '!this.createProfilePos('  width 10 is REAL format !!distanceFmt
      text   .crtStartY    |$!posY|  tagwidth 5              anchor top + left + right   at xmin                   ymax+0.1          callback '!this.createProfilePos('  width 10 is REAL format !!distanceFmt
    exit

    -- Pick End Pos
    frame .endPosPan FoldUpPanel 'End Position'   anchor top + left + right   at x1                     ymax+0.5            width 30
      button .endPick linkLabel 'Pick end position' anchor top + left + right   at x2                     ymax                callback '!this.pickEnd(''CREATE'')' width 20
      text   .crtEndX    'X:'   tagwidth 5              anchor top + left + right   at xmin                   ymax+0.2            callback '!this.createProfilePos(' width 10 is REAL format !!distanceFmt
      text   .crtEndY    'Y:'   tagwidth 5              anchor top + left + right   at xmin                   ymax+0.1            callback '!this.createProfilePos(' width 10 is REAL format !!distanceFmt
    exit

    -- Preview Line
    paragraph .proDrawIcon                          anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .proDraw linkLabel 'Draw Line'           anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.drawProfileLine()' width 12

    paragraph .proAddIcon                           anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .proCreate   linkLabel 'Add Profile to List'                         at xmax+1                 ymin                callback '!this.addProfile()' width 12

    -- List of Lines
    paragraph .linesLabel                           anchor top + left + right   at x0                     ymax+0.5            text 'Lines Added' width 15 lines 1
    line   .proLine3                                anchor top + left + right   at xmin                   ymax                horizontal width 30

    container .lineListCont PMLNetCONTROL 'NET'     anchor left + right + top   at xmin                   ymax+0.2            width 30 lines 8

    -- Create Profiles

    paragraph .proAcceptIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .proAccept linkLabel 'Create Profiles'   anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.createLatticeProfs()' width 12

    paragraph .proBackIcon                          anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .proMain   linkLabel 'Back to main grid tasks'                       at xmax+1                 ymin                callback '!this.mainTasks(true)'

    paragraph .blTskBackMainIcon4            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain4     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit

  -- Grid Layout
  frame .layoutPane panel                           anchor top + left + right   at xmin.mainTaskPane      ymax.currOwnList

    paragraph .layoutText                           anchor top + left + right   at x0.5                   ymax                text 'Layout' width 28 lines 1
    line .layoutLine1                               anchor top + left + right   at xmin                   ymax                horizontal width 30

    -- Grid Angle
    numericinput .gAngle 'Grid angle:' tagwidth 8   anchor top + left           at x2                     ymax+0.2            callback '!this.gridAngle('  range 90 -90 ndp 0 width 4

    -- Grid Offset
    button .gOffset linkLabel 'Grid Offset...'      anchor top + left + right   at x2                     ymax+0.2            callback '!this.pickOffset()' width 20
    text .gXOffset   'X:'                           anchor top + left + right   at xmin+4                 ymax                callback '!this.offset(' width 21 is REAL format !!distanceFmt
    text .gYOffset   'Y:'                           anchor top + left + right   at xmin                   ymax+0.2            callback '!this.offset(' width 21 is REAL format !!distanceFmt

    paragraph .loSpacing                            anchor top + left + right   at x2                     ymax+0.2            text 'Grid Spacing'
    text .gXSpacing 'X:'                            anchor top + left + right   at xmin+4                 ymax                callback '!this.gridSpacing()' width 9 is REAL format !!distanceFmt
    text .gXSpacing2 ''                             anchor top + left + right   at xmax+2                 ymin                callback '!this.gridSpacing()' width 9 is REAL format !!distanceFmt
    text .gYSpacing 'Y:'                            anchor top + left + right   at xmin.gXSpacing         ymax+0.2            callback '!this.gridSpacing()' width 9 is REAL format !!distanceFmt
    text .gYSpacing2 ''                             anchor top + left + right   at xmin.gXSpacing2        ymin            callback '!this.gridSpacing()' width 9 is REAL format !!distanceFmt

        -- Modify options
    paragraph .tilingCount                                                      at x0.5                   ymax+0.5            text 'Tile Count'
    line .layoutLine                                anchor top + left + right   at xmin                   ymax                horizontal width 30
    text .trimmedTiles   'Trimmed:  '               anchor top + left + right   at xmin+2                 ymax+0.2            width 8 is REAL
    text .untrimmedTiles 'Untrimmed:'               anchor top + left + right   at xmin                   ymax+0.2            width 8 is REAL

    -- Accept Changes
    paragraph .loAcceptIcon                         anchor top + left           at x0                     ymax+1              pixmap width 16 height 16
    button .loAccept  linkLabel 'Accept Changes'    anchor top + left           at xmax+0.5               ymin                callback '!this.modify(' width 10

    -- Discard Changes
    paragraph .loDiscardIcon                        anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
    button .loDiscard linkLabel 'Discard Changes'   anchor top + right          at xmax+0.5               ymin                callback '!this.updateGadgets()!this.mainTasks(true)' width 10

    paragraph .loBackIcon                           anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .loMain   linkLabel  'Back to main grid tasks'                       at xmax+1                 ymin                callback '!this.updateGadgets()!this.mainTasks(true)'

    paragraph .blTskBackMainIcon5            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain5     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20


  exit

  -- Grid Geometry
  frame .geomPane   panel                           anchor top + left + right   at xmin.mainTaskPane      ymax.currOwnList

    paragraph .geomText                             anchor top + left + right   at x0.5                   ymax                text 'Grid Boundary Geometry' width 28 lines 1
    line      .geomLine1                            anchor top + left + right   at xmin                   ymax                horizontal width 30

    -- Set Boundary offset
    text .bndOffset         'Boundary Offset:' tagwidth 12 anchor top + left    at x0.5                   ymax+0.5            callback '!this.boundOffset(!this.bndOffset.val)' width 15  is REAL format !!distanceFmt

    -- Select Boundary to modify
    combo .boundCh 'Select Boundaries:' tagwidth 12 anchor t + l                at x0.5                   ymax+0.5            width 13

    -- Accept Changes
    paragraph .goAcceptIcon                         anchor top + left           at x0                     ymax+1              pixmap width 16 height 16
    button .goAccept  linkLabel 'Accept Changes'    anchor top + left           at xmax+0.5               ymin                callback '!this.modify(' width 10

    -- Discard Changes
    paragraph .goDiscardIcon                        anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
    button .goDiscard linkLabel 'Discard Changes'   anchor top + right          at xmax+0.5               ymin                callback '!this.updateGadgets()!this.mainTasks(true)' width 10

    paragraph .goBackIcon                           anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .goMain   linkLabel  'Back to main grid tasks'                       at xmax+1                 ymin                callback '!this.updateGadgets()!this.mainTasks(true)'

    paragraph .blTskBackMainIcon6            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain6     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit


  -- Grid Detailing
  frame .detailPane panel                           anchor top + left + right   at xmin.mainTaskPane      ymax.currOwnList

    frame .detCriteria FoldUpPanel 'Tile Criteria'        anchor top + left + right   at x0                   ymax+0.5          width 32

      text    .tileXSpacing 'X Length: '  tagwidth 9      anchor top + left + right   at xmin                 ymax+0.2          width 14 is  REAL format !!distanceFmt
      text    .tileYSpacing 'Y Length: '  tagwidth 9      anchor top + left + right   at xmin                 ymax+0.2          width 14 is  REAL format !!distanceFmt

      -- Ceiling height
      text    .detTileSPRF  'Specification:'      tagwidth 9      anchor top + left + right   at xmin                 ymax+0.2          callback '!this.checkRef(' width 14  is STRING

    exit

    -- Search Tiles
    paragraph .dtSearchIcon                               anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button    .searchTiles  linkLabel 'Select Tile Specification...'      anchor top + left           at xmax+0.5               ymin                callback '!this.catalogueSearch(' width 18

    -- Search Lattice
    paragraph .tilCreateIcon                              anchor top + right          at xmax                   ymin                pixmap width 15 height 15
    button    .createTiles  linkLabel 'Create Tiles'      anchor top + right          at xmax+0.5               ymin                callback '!this.createTiles(!this.detTileSPRF.val.dbRef())'

    frame    .ltCriteria FoldUpPanel 'Lattice Design'     anchor top + left + right   at x0                     ymax+0.5            width 32

      -- Lattice Cross
      text    .latCross   'Lattice Cross'   tagwidth 9    anchor top + left  + right  at x0.5                   ymax+0.5            callback '!this.checkRef(' width 14 is STRING
      button  .searchLattice                              anchor top  + right         at xmax.latCross+0.5      ymin.latCross       pixmap callback '!this.catalogueSearch(' width 10

      -- Lattice Edge
      text    .latEdge    'Lattice Edge '   tagwidth 9    anchor top + left + right   at x0.5                   ymax.latCross+0.2   callback '!this.checkRef(' width 14 is STRING
      button  .searchBound                                anchor top + right          at xmax.latEdge+0.5       ymin.latEdge        pixmap callback '!this.catalogueSearch(' width 10

      text    .latLength  'Std. Length'     tagwidth 9    anchor top + left + right   at x0.5                   ymax.latEdge+0.2    width 14 is REAL format !!distanceFmt

      toggle  .crtXLine 'X Lines' tagwidth 9             anchor top + left            at x2                     ymax+0.5
      toggle  .crtYLine 'Y Lines' tagwidth 9             anchor top + left            at x2                     ymax
      toggle  .crtBndry 'Boundary' tagwidth 9            anchor top + left            at x2                     ymax

    exit

    -- Search Lattice
    --paragraph .latSearchIcon                              anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15


    -- Create Lattice
    paragraph .latCreateIcon                              anchor top + left           at xmin                   ymax+0.5            pixmap width 15 height 15
    button    .createLattice  linkLabel 'Create Lattice'  anchor top + left           at xmax+0.5               ymin                callback '!this.latticeCreate()' width 10

    paragraph .dtBackIcon                                 anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .dtMain   linkLabel   'Back to main grid tasks'                            at xmax+1                 ymin                callback '!this.updateGadgets()!this.mainTasks(true)'

    paragraph .blTskBackMainIcon7            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain7     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit

  -- Copy Profile with Offset Pane
  frame .copyProfilePane  panel                           anchor top + left + right   at xmin.mainTaskPane        ymax.currOwnList

    line      .copyLine1                                  anchor top + left + right   at xmin                   ymax                horizontal width 30

    -- Current Tile
    text      .currentProf  'Current Profile' tagwidth 12 anchor top + left + right   at x0.5                   ymax+0.2            width 15 is STRING
    button    .chooseCE     'CE'                          anchor top + left + right   at xmax.currentProf       ymin.currentProf    callback '!this.chooseProf()'

    text      .newProfName  'Profile Name'  tagwidth 12   anchor top + left + right   at x0.5                   ymax+0.2            callback '!this.checkName(' width 15 is STRING

    -- New Profile Positioning

    var !coordinate coordinate
    if(!coordinate.eq('XYZ')) then
      !posX = |X Offset:|
      !posY = |Y Offset:|
    else
      !posX = |E Offset:|
      !posY = |N Offset:|
    endif

    text    .eastOffset |$!posX|        tagwidth 12   anchor top + left           at xmin                   ymax+0.2            width 14 is REAL format !!distanceFmt
    text    .northOffset |$!posY|       tagwidth 12   anchor top + left           at xmin                   ymax+0.2            width 14 is REAL format !!distanceFmt

    paragraph .proCopyIcon                                anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button    .proCopy linkLabel 'Copy Profile'           anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.offsetProfile()' width 12

    paragraph .cpyBackIcon                                anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button    .cpyMain   linkLabel 'Back to main grid tasks'                          at xmax+1                 ymin                callback '!this.mainTasks(true)'

    paragraph .blTskBackMainIcon8            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain8     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit

  -- Modify Profile pane
  frame .modProfilePane panel                             anchor top + left + right   at xmin.mainTaskPane      ymax.currOwnList

    paragraph  .profileTitle                              anchor top + left + right   at xmin                   ymax+0.2            text 'Select Profile' width 30 lines 1
    line    .profileLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 30
    -- List of ceiling profiles
    container .profileList PMLNetCONTROL 'NET'            anchor left + right + top   at xmin                   ymax+0.2            width 30 lines 8

    paragraph  .profileAtts                               anchor top + left + right   at xmin                   ymax+0.2            text 'Profile Attributes' width 30 lines 1
    line    .profileLine2                                 anchor top + left + right   at xmin                   ymax                horizontal width 30

    text    .modProElev 'Elevation: '     tagwidth 9      anchor top + left + right   at xmin                   ymax+0.2            width 10 is REAL format !!distanceFmt


    -- Pick Start Pos
    frame     .modStartPan FoldUpPanel 'Start Position'     anchor top + left + right   at x1                     ymax+0.5            width 30
      button  .modStartPick linkLabel 'Pick start position' anchor top + left + right   at x2                     ymax                callback '!this.pickStart(''MODIFY'')' width 20
      text    .modStartX  'X: '      tagwidth 5      anchor top + left + right   at x2                     ymax+0.2            callback '!this.modifyProfilePos(' width 10 is REAL format !!distanceFmt
      text    .modStartY 'Y: '      tagwidth 5      anchor top + left + right   at x2                     ymax+0.2             callback '!this.modifyProfilePos(' width 10 is REAL format !!distanceFmt
    exit

    -- Pick End Pos
    frame     .modEndPan FoldUpPanel 'End Position'     anchor top + left + right   at x1                     ymax+0.5            width 30
      button  .modEndPick linkLabel 'Pick end position' anchor top + left + right   at x2                     ymax                callback '!this.pickEnd(''MODIFY'')' width 20
      text    .modEndX  'X: '       tagwidth 5      anchor top + left + right   at xmin                   ymax+0.2           callback '!this.modifyProfilePos('  width 10 is REAL format !!distanceFmt
      text    .modEndY 'Y: '       tagwidth 5      anchor top + left + right   at xmin                   ymax+0.2            callback '!this.modifyProfilePos(' width 10 is REAL format !!distanceFmt
    exit

    -- Accept Changes
    paragraph .poAcceptIcon                         anchor top + left           at x0                     ymax+1              pixmap width 16 height 16
    button .poAccept  linkLabel 'Accept Changes'    anchor top + left           at xmax+0.5               ymin                callback '!this.modify(' width 10

    -- Discard Changes
    paragraph .poDiscardIcon                        anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
    button .poDiscard linkLabel 'Discard Changes'   anchor top + right          at xmax+0.5               ymin                callback '!this.updateGadgets()!this.mainTasks(true)' width 10

    paragraph .poBackIcon                           anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .poMain   linkLabel  'Back to main grid tasks'                       at xmax+1                 ymin                callback '!this.updateGadgets()!this.mainTasks(true)'

    paragraph .blTskBackMainIcon9            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain9     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit

	menu .popupMenu
    !this.popupMenu.add( 'callback', 'Delete Selected Profiles', '!this.onRemoveProfileClicked()' , 'popupDelete' )
    !this.popupMenu.add( 'callback', 'Locate in Tree',    '!!ce = !this.currentProfile',      'profileInTree')
    !this.popupMenu.add( 'callback', 'Locate from Tree',  '!this.locateFromTree()',         'profileFromTree')

  -- Form members

  -- Current active element
  member .owner             is DBREF

  -- Current active elements
  member .element           is DBREF

  -- Current Ceiling
  member .currentCeiling    is DBREF
  member .currentProfile    is DBREF

  -- Ceiling Grid definition
  member .definition        is CEILINGGRIDPLANER

  -- Grid Element
  member .gridElement       is DBREF

  -- Ceiling Grids
  member .ceilings          is ARRAY

  -- Undo for form
  member .undo              is UNDOABLE

  -- Current Task Pane within Form
  member .currentPane       is GADGET
  member .currentTask       is BLOCK
  member .refreshTask       is BLOCK

  -- EDG Description
  member .edgDescription    is STRING

  -- Aid graphics
  member .aidInner          is REAL
  member .aidOuter          is REAL
  member .aidNumber         is REAL
  -- Aid number for Profile Start position
  member .aidNumberPrfStart is REAL
  -- Aid number for Profile End position
  member .aidNumberPrfEnd   is REAL

  -- Alternative text for owning element type
  member .ownerAltText    is STRING
  member .boundOffset     is REAL
  member .boundaryType    is REAL

  -- Owning element
  member .ownerType       is STRING

  -- Grid control
  using namespace 'Aveva.Pdms.Presentation'
  member .contentGrid       is NETGRIDCONTROL
  member .lineList          is NETGRIDCONTROL
  member .profileGrid       is NETGRIDCONTROL
  member .supProfGrid       is NETGRIDCONTROL

exit

------------------------------------------------------------------------
--
-- Method:      accCeilingGridDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accCeilingGridDefinition()

  -- Cancel Callback
  !this.cancelCall              = '!this.tidy()'

  !this.edgDescription  = 'PickPosition'

  -- Set form to auto-scroll
  !this.autoScroll              = true

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!this.dummy()')

  -- Collapse fold-up panels
  !this.criteria.expanded       = false

  -- Set events for numeric gadgets
  !this.nAngle.modifiedEvents   = true
  !this.hAngle.modifiedEvents   = true
  !this.gAngle.modifiedEvents   = true

  -- Load information from Configuration
  !this.refreshConfig()

 -- Initialise task panes
  !this.mainTasks(TRUE)
  !this.createGrid(FALSE)
  !this.createProfile(FALSE)
  !this.modifyGrid(FALSE)
  !this.layoutGrid(FALSE)
  !this.detailGrid(FALSE)
  !this.geomGrid(FALSE)
  !this.copyProfile(FALSE)
  !this.modifyProfile(FALSE)


  -- Set Specification to Unset
  !this.profileSPREF.val = 'Unset'
  !this.profileSPREF.active = false
  !this.detTileSPRF.active = false


  -- Set "Back" icon
  !backIcon                     = !!pml.getpathname('back.png')
  !this.crtBackIcon.addPixmap(!backIcon)
  !this.modBackIcon.addPixmap(!backIcon)
  !this.loBackIcon.addPixmap(!backIcon)
  !this.goBackIcon.addPixmap(!backIcon)
  !this.dtBackIcon.addPixmap(!backIcon)
  !this.proBackIcon.addPixmap(!backIcon)
  !this.cpyBackIcon.addPixmap(!backIcon)
  !this.poBackIcon.addPixmap(!backIcon)

  !this.blTskBackMainIcon1.addPixmap(!backIcon)
  !this.blTskBackMainIcon2.addPixmap(!backIcon)
  !this.blTskBackMainIcon3.addPixmap(!backIcon)
  !this.blTskBackMainIcon4.addPixmap(!backIcon)
  !this.blTskBackMainIcon5.addPixmap(!backIcon)
  !this.blTskBackMainIcon6.addPixmap(!backIcon)
  !this.blTskBackMainIcon7.addPixmap(!backIcon)
  !this.blTskBackMainIcon8.addPixmap(!backIcon)
  !this.blTskBackMainIcon9.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getpathname('create.png')
  !this.crtAcceptIcon.addPixmap(!createIcon)
  !this.proAcceptIcon.addPixmap(!createIcon)
  !this.latCreateIcon.addPixmap(!createIcon)
  !this.tilCreateIcon.addPixmap(!createIcon)
  !this.proCopyIcon.addPixmap(!createIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getpathname('accept.png')
  !this.modAcceptIcon.addPixmap(!acceptIcon)
  !this.loAcceptIcon.addPixmap(!acceptIcon)
  !this.goAcceptIcon.addPixmap(!acceptIcon)
  !this.poAcceptIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getpathname('discard.png')
  !this.modDiscardIcon.addPixmap(!discardIcon)
  !this.loDiscardIcon.addPixmap(!discardIcon)
  !this.goDiscardIcon.addPixmap(!discardIcon)
  !this.poDiscardIcon.addPixmap(!discardIcon)

  -- Set "Draw" icon
  !drawIcon                     = !!pml.getpathname('linepntpnt24.png')
  !this.proDrawIcon.addPixmap(!drawIcon)

  -- Set "Add" icon
  !addIcon                      = !!pml.getpathname('draft_t_023.png')
  !this.proAddIcon.addPixmap(!addIcon)

  -- Set "Search" icon
  !searchIcon                   = !!pml.getpathname('ng_zoomtodrawlist.png')
  !this.dtSearchIcon.addPixmap(!searchIcon)
  !this.proSearchIcon.addPixmap(!searchIcon)
  !this.searchLattice.addPixmap(!searchIcon)
  !this.searchBound.addPixmap(!searchIcon)

  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- Add .Net control to PML container for contents
  !this.contentGrid             = object NETGRIDCONTROL()
  !this.ceilingList.control     = !this.contentGrid.handle()

  using namespace 'Aveva.Pdms.Presentation'
  !this.lineList                = object NETGRIDCONTROL()
  !this.lineListCont.control    = !this.lineList.handle()

  using namespace 'Aveva.Pdms.Presentation'
  !this.profileGrid             = object NETGRIDCONTROL()
  !this.profileList.control     = !this.profileGrid.handle()
  !this.profileGrid.addeventhandler('OnPopup', !this, 'gridControlOnPopup')

  -- Events handled
  !this.contentGrid.addeventhandler('afterSelectChange', !this, 'select')
  !this.profileGrid.addeventhandler('afterSelectChange', !this, 'selectProfile')

  -- Load information from Configuration
  !this.contentGrid.columnExcelFilter(FALSE)
  !this.lineList.columnExcelFilter(FALSE)
  !this.profileGrid.columnExcelFilter(FALSE)

  !this.contentGrid.outlookGroupStyle(FALSE)
  !this.lineList.outlookGroupStyle(FALSE)
  !this.profileGrid.outlookGroupStyle(FALSE)

  !this.contentGrid.columnSummaries(FALSE)
  !this.lineList.columnSummaries(FALSE)
  !this.profileGrid.columnSummaries(FALSE)

  !this.contentGrid.fixedHeaders(FALSE)
  !this.lineList.fixedHeaders(FALSE)
  !this.profileGrid.fixedHeaders(FALSE)

  !this.contentGrid.fixedRows(FALSE)
  !this.lineList.fixedRows(FALSE)
  !this.profileGrid.fixedRows(FALSE)

  !this.contentGrid.singleRowSelection(TRUE)
  !this.lineList.singleRowSelection(FALSE)
  !this.profileGrid.singleRowSelection(FALSE)

  -- Aid graphics
  !this.aidInner  = !!aidNumbers.add('Ceiling grid, inner boundaries')
  !this.aidOuter  = !!aidNumbers.add('Ceiling grid, outer boundary')
  !this.aidNumber = !!aidNumbers.add('Ceiling grid, grid tags')
  !this.aidNumberPrfStart = !!aidNumbers.add('Start')
  !this.aidNumberPrfEnd   = !!aidNumbers.add('End')

  -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

  -- Set content of boundary offset combo box
  !boundTypes = object ARRAY()
  !boundTypes.append('Outer')
  !boundTypes.append('Inner')
  !boundTypes.append('All')

  !this.boundCh.dtext = !boundTypes

  -- Set headings for profile list gadget
  !headings = object ARRAY()
  !headings.append('SPREF')
  !headings.append('Max Length')
  !headings.append('Start Pos')
  !headings.append('End Pos')

  !table = object ARRAY()
  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds          = object NETDATASOURCE('CeilingGrids', !headings, !table)
  !this.lineList.bindToDataSource(!nds)

  !this.mtCrtProfs.active = FALSE
  !this.mtModDef.active = FALSE
  !this.mtModGeom.active = FALSE
  !this.mtModLayout.active = FALSE
  !this.mtModDetail.active = FALSE
  !this.mtModProfiles.active = FALSE
  !this.mtCopyProf.active = FALSE
  !this.mtDelGrid.active = FALSE
  !this.mtDelLattice.active = FALSE
  !this.mtDelTile.active = FALSE

endmethod
-- End of method
------------------------------------------------------------------------

define method .gridControlOnPopup(!data is ARRAY)

  -- grey out "locate in tree" option when multiple profiles selected
  if (!this.profileGrid.getSelectedRows().size() eq 1 ) then
      !this.popupMenu.setFieldProperty('profileInTree','ACTIVE',TRUE)
      !this.popupMenu.setFieldProperty('profileFromTree','ACTIVE',TRUE)
  else
      !this.popupMenu.setFieldProperty('profileInTree','ACTIVE',FALSE)
      !this.popupMenu.setFieldProperty('profileFromTree','ACTIVE',FALSE)
  endif

  !this.profileList.popup = !this.popupMenu
  !this.profileList.showPopup(!data[0], !data[1])
endmethod
------------------------------------------------------------------------

define method .onRemoveProfileClicked()

  !rows                      = !this.profileGrid.getSelectedRows()

  -- delete selected profiles
  if (!rows.size() gt 0) then
   do !i indices !rows
     !array[!i]                 = !rows[!i][1].dbRef()
   enddo
   if(!!accDeleteManager.deleteElements(!array).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
   else
    -- Clear the graphical aids
    AID CLEAR ALL $!this.aidNumberPrfStart
    AID CLEAR ALL $!this.aidNumberPrfEnd

    !this.getProfiles()
    -- Setup panes
    !this.modifyProfile(TRUE)
   endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- remove edg events from the system
  !!edgCntrl.remove(!this.edgDescription)

  !this.definition.tidy()

  AID CLEAR ALL $!<this.aidNumberPrfStart>
  AID CLEAR ALL $!<this.aidNumberPrfEnd>

endmethod
-- End of method

