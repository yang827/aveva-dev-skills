    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.copyProfile(FALSE)')
    !this.refreshTask         = object BLOCK('!this.profileCopy()')

    !this.ceilingList.active  = FALSE
    !this.currentProf.active  = FALSE

    !this.formTitle           = 'Copy Lattice Profile'

  -- Actions when task pane is made inactive
  else
    !this.currentProf.clear()
    !this.eastOffset.val = 0
    !this.northOffset.val = 0

    !this.ceilingList.active  = TRUE
    !this.tidy()
  endif

  -- Show/hide task pane
  !this.copyProfilePane.visible    = !active

endmethod
