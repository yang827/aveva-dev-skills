-- End of method
------------------------------------------------------------------------
--
-- Method:      pickTileEdge
--
-- Description: Setup EDG pick event for picking tile edge
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW][Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickTileEdge()

  !this.tidy()
  !this.tileIntersects.clear()
  !this.pickTile.active = FALSE
  !this.hangCreate.active = FALSE
  !this.hangMain.active = FALSE
  -- Initialise variables
  !prompt               = 'Pick edge of Ceiling Tiles <esc> to exit'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = FALSE
  !packet.pickPacket.picks[1].stdGraphics('')
  !packet.close         = '!!' & !this.name() & '.tileEdge()'
  !packet.action        = '!!' & !this.name() & '.tileEdgePos(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tileEdgePos
--
-- Description: Load the pline of the picked tile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tileEdgePos(!data is ANY)

  --!this.tidy()

  if !data.item.typ.neq('CLNTIL') then
  	!!alert.warning('Please pick the edge of a Ceiling Tile, within the selected Ceiling Grid.')
    return
  else
    --!this.pickTile.active = TRUE

    !ceilingGrid = object RECTANGULARGRID(!this.currentGrid)

    !tileLines = !ceilingGrid.cellProfile(!data.item.cellID[1],!data.item.cellID[2])[1].edges()
    --!tileProfile = !this.tileProfile(!data.item)
    --!tileProfile = !ceilingGrid.cellProfile(!data.item.cellID[1], !data.item.cellID[2])[1]

    !line = !data.line

    do !tLine values !tileLines
      !parallelLine = !tLine
      break if (!line.direction() eq !parallelLine.direction())
      handle ANY
        !!alert.warning('Please pick the edge of a Ceiling Tile, within the selected Ceiling Grid.')
        return
      endhandle
    enddo

    !line = !line.overlap(!parallelLine)

    !this.hangTileEdge.val = 'Selected Tile: ' & !data.item.namn

    -- Get all of the gensecs in the current grid
    !gensecList = object COLLECTION()
    !gensecList.scope(!this.currentGrid)
    !gensecList.type('GENSEC')
    !expression     = object EXPRESSION()
    !expressionText = '(purp of owner eq |PRFL|)'
    !expression.expression(!expressionText)
    !gensecList.filter(!expression)

    !gensecs = !gensecList.results()

    -- Get profiles of all the gensecs in the current grid
    !profiles = ARRAY()
    do !i indices !gensecs
      !!ce = !gensecs[!i]
      LAST SPINE
      !genPro = object PROFILE(!!ce)
      !profiles.append(!genPro)
    enddo

    -- Get intersections of pline with profiles of gensecs
    !intersections = ARRAY()
    do !p indices !profiles
      !ints = !profiles[!p].intersections(!line).unique()
      do !j indices !ints
        --If intersection found already, then make it a hanger position (below line to only produce
        --intersection point if tile edge and grid-cell edge coincide)
        --skip if (!tileProfile.onProfile(!ints[!j]) eq FALSE)
        !gensecInters  = ARRAY()
        !gensecInters.append(!ints[!j])
        !gensecInters.append(!gensecs[!p])
        !intersections.append(!gensecInters)
      enddo
    enddo

    do !it indices !intersections
      !pos = !intersections[!it][1]
      AID TEXT NUMBER $!<this.aidNumber> 'Int' At $!<pos>
    enddo

    --!this.tileIntersects = !intersections
    !this.tileIntersects.appendarray(!intersections)
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tileEdge
--
-- Description: Load the pline of the picked tile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tileEdge()

  --Hanger positions are stored, set gadgets back to active true

  !this.pickTile.active = TRUE
  !this.hangCreate.active = TRUE
  !this.hangMain.active = TRUE

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      supportPickClose
--
-- Description: Get gadgets into correct state following pick support
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .supportPickClose()

  --Set gadgets back to active true

  !this.headPick.active = TRUE
  !this.headPick2.active = TRUE
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tileProfile
--
-- Description: Returns a profile of the current tile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       DBREF     Passed Tile
-- Return:
--   [Data Type] [Description]
--     PROFILE    Tile's Profile
--
------------------------------------------------------------------------

define method .tileProfile(!tileRef is DBREF) is PROFILE

  !tileVolume   = object LOCALVOLUME(!tileRef, !tileRef)

  !tileBox      = !tileVolume.box()

  -- Generate the corner information of the tile
  !corner1      = !tileVolume.from
  !corner2      = !tileVolume.to
  !corner3      = !corner1
  !corner3.east = !corner3.east * -1
  !corner4      = !corner2
  !corner4.east = !corner4.east * -1

  -- Create lines forming the rectangular profile
  !line1 = object LINE(!corner1, !corner3)
  !line2 = object LINE(!corner1, !corner4)
  !line3 = object LINE(!corner2, !corner3)
  !line4 = object LINE(!corner2, !corner4)

  !profileLines = ARRAY()
  !profileLines.append(!line1)
  !profileLines.append(!line2)
  !profileLines.append(!line3)
  !profileLines.append(!line4)

  -- Create the profile
  !tileProf = object PROFILE(!tileBox.position, !tileBox.orientation, !profileLines)

  return !tileProf

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      linePosition
--
-- Description: Load the position, relative to the outer boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .linePosition(!data is EDGPOSITIONDATA)

  !pickedPos = !data.position

  !this.tidy()

  --!this.headPick.active = TRUE

  !!ce = !this.currentGrid

  !bndLins = object COLLECTION()
  !bndLins.scope(!this.currentGrid)
  !bndLins.type('BNDLIN')

  !boundLin = !bndLins.results()

  !outerBoundary = !boundLin[1].members[1]

  -- Position returned by pick

  --!pickedPos = !data.position

  -- Position with reference to boundary line
  !wrtPos    = !pickedPos.wrt(!outerBoundary)
  !wrtPos.up = 0

  AID TEXT NUMBER $!<this.aidNumber> 'HEAD' At $!<wrtPos>

  !this.headX.val = !wrtPos.east.real()
  !this.headY.val = !wrtPos.north.real()
  !this.modSupX.val = !wrtPos.east.real()
  !this.modSupY.val = !wrtPos.north.real()
  !this.modSupZ.val = !wrtPos.up.real()
endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      linePosition
--
-- Description: Mark the position of the new Ceiling Support
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       REAL      EAST Value
--    2    R       REAL      NORTH Value
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------

define method .linePosition(!east is REAL, !north is REAL)

  !this.tidy()

  !bndLins = object COLLECTION()
  !bndLins.scope(!this.currentGrid)
  !bndLins.type('BNDLIN')

  !boundLin = !bndLins.results()

  !outerBoundary = !boundLin[1].members[1]

  !position = object POSITION()
  !position.east = !east
  !position.north = !north
  !position.up  = 0mm
  !position.origin = !outerBoundary

  AID TEXT NUMBER $!<this.aidNumber> 'HEAD' At $!<position>



endmethod

----------------------------------------------------------------------
--
-- Method:      profileSearch
--
-- Description: Choose support profile from selection form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------

define method .profileSearch()


    !profileData = object PROFILECATALOGUEDATA()

    !plineList   = ARRAY()

    -- Selection form title
    !title              = 'Select Support Profile'

    -- Action to be carried out
    !action             = '!!' & !this.name() & '.profileResult(!this.profile.catref.name)'

    -- Setup object for profile selection
    !profileSelection   = object PROFILESELECTION(!title, !action)

    !profileSelection.profileData(!profileData)
    !profileSelection.defaultPlines(!plineList)

    -- Display profile selection form
    !profileSelection.show()

    if (!!sectionprofileselection.specList.dtext.findFirst('Lattice Profiles').set().not()) then
      !!sectionprofileselection.selectSpecification()
    else
      !!sectionprofileselection.specList.select('dtext' , 'Lattice Profiles')
      !!sectionprofileselection.selectSpecification()
    endif


endmethod

-- End of method

----------------------------------------------------------------------
--
-- Method:      findHanger
--
-- Description: Choose hanger from selection form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------

define method .findHanger()

  !!stchoosedata.cleardata()

  !!stchoosedata.settitle('Ceiling Hangers')

  !!stchoosedata.setdata('ROOM', 'HANG')

  !!stchoosedata.setTable()

  show !!stChooseSelection

  !!stChooseSelection.action = object BLOCK('!!' & !this.name() & '.setSpref(!this.selectedItem.name.string())')

endmethod

------------------------------------------------------------------------
--
-- Method:      setSpref
--
-- Description: Set the Fitting Spref textbox value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     Fitting Name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpref(!hangerName is STRING)

  !this.supportSPREF.val = !hangerName

endmethod



----------------------------------------------------------------------
--
-- Method:      findModifyHanger
--
-- Description: Choose SPREF from selection form for existing hanger
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
----------------------------------------------------------------------

define method .findModifyHanger()

  !!stchoosedata.cleardata()

  !!stchoosedata.settitle('Ceiling Hangers')

  !!stchoosedata.setdata('ROOM', 'HANG')

  !!stchoosedata.setTable()

  show !!stChooseSelection

  !!stChooseSelection.action = object BLOCK('!!' & !this.name() & '.setModifySpref(!this.selectedItem.name.string())')

endmethod

------------------------------------------------------------------------
--
-- Method:      setModifySpref
--
-- Description: Set the existing hanger Spref textbox value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     Fitting Name
-- Return:
