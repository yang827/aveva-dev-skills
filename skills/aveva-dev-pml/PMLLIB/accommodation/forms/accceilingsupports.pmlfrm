------------------------------------------------------------------------

define method .pickHead2()

  !this.headPick2.active = FALSE

  -- Initialise variables
  !prompt               = 'Pick start of support profile'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = TRUE
  !packet.close         = '!!' & !this.name() & '.supportPickClose()'
