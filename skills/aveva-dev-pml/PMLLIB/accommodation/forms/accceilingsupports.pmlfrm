------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select from list of ceilings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!dummyPassedArray is ARRAY)

  -- Initialise Variable
  !row                      = !this.contentGrid.getSelectedRows()

  if (!row.size() gt 0) then

    !element                 = !row.first()[1].dbRef()
    handle ANY
      !this.ceilingGridList()
    elsehandle NONE
    !!ce  = !element

      !this.currentGrid = !element

      !this.currentCeiling = !this.currentGrid.owner

      !gridPos = !this.currentGrid.position

      !this.tidy()
      if (!this.currentGrid.isNamed) then
        !name = !this.currentGrid.namn
        AID TEXT NUMBER $!<this.aidNumber> '$!name' At $!<gridPos>
      else
        AID TEXT NUMBER $!<this.aidNumber> 'Grid Position' At $!<gridPos>
      endif

      !this.mtCrtProfs.active  = TRUE
      !this.mtCrtHanger.active = TRUE

      !collection = object COLLECTION()
      !collection.scope(!this.currentGrid)
      !collection.type('REST')
      !restraintCollection   = !collection.results()

  -- If there is no Restraint element - no nothing
      if(!restraintCollection.empty()) then
        !this.mtModHang.active   = FALSE
        !this.mtDelHanger.active = FALSE
      else
        !this.mtModHang.active   = TRUE
        !this.mtDelHanger.active = TRUE
      endif

      -- Get Supports
      !collection = object COLLECTION()
      !collection.scope(!this.currentGrid)
      !collection.filter(object EXPRESSION('PURP eq ''SUPP'''))
      !collection.type('CLNLAT')
      !supportCollection   = !collection.results()

      -- If there is no Restraint element - no nothing
      if(!supportCollection.empty()) then
        !this.mtDelSupport.active = FALSE
        !this.mtModSupp.active   = FALSE
      else
        !this.mtDelSupport.active = TRUE
        !this.mtModSupp.active   = TRUE
      endif

      !this.getProfiles()
    endhandle

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      getProfiles
--
-- Description: Retrieve all of the lattice profiles on a ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getProfiles()

    !profileCollect = object COLLECTION()
    !profileCollect.scope(!this.currentGrid)
    !profileCollect.filter(object EXPRESSION('PURP eq ''PRFL'''))
    !profileCollect.type('CLNLATTICE')

    !profiles = !profileCollect.results()
    !table = object ARRAY()

    if (!profiles.size() gt 0) then

      !gensecs = !profiles[1].members

      do !i indices !gensecs

      skip if (!gensecs[!i].members[1].members.size() gt 2)
        !tableEntry = object ARRAY()
        !tableEntry.append(!gensecs[!i].name)
        !mainOwner = !gensecs[!i].owner
        if (!gensecs[!i].owner.isNamed) then
          !tableEntry.append('[' & !mainOwner.fulltype & '] ' & !mainOwner.namn)
        else
          !tableEntry.append(!mainOwner.fulltype)
        endif
        !table.append(!tableEntry)
      enddo
      !this.hangCreate.active = TRUE

    elseif (!profiles.empty()) then
      !this.hangCreate.active = FALSE

    endif


    -- Headings
    !headings     = ARRAY()
    !headings.append('Name')
    !headings.append('Owner')

    -- Load grid

    using namespace 'Aveva.Pdms.Presentation'
    !nds          = object NETDATASOURCE('LatticeProfiles', !headings, !table)
    !this.hangerGrid.bindToDataSource(!nds)



endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSupports
--
-- Description: Retrieve all of the support profiles on a ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getSupports()

    !profileCollect = object COLLECTION()
    !profileCollect.scope(!this.currentGrid)
    !profileCollect.filter(object EXPRESSION('PURP eq ''SUPP'''))
    !profileCollect.type('CLNLATTICE')

    !profiles = !profileCollect.results()
    !table = object ARRAY()

    if (!profiles.size() gt 0) then

      !gensecs = !profiles[1].members

      do !i indices !gensecs
        !tableEntry = object ARRAY()
        !tableEntry.append(!gensecs[!i].name)
        --!mainOwner  = !gensecs[!i].owner.fullname
        --!tableEntry.append(!mainOwner)
        !table.append(!tableEntry)
      enddo
      !this.supAccept.active = TRUE
      !this.supDiscard.active = TRUE
    elseif (!profiles.empty()) then
      !this.supAccept.active = FALSE
      !this.supDiscard.active = FALSE
    endif

    -- Headings
    !headings     = ARRAY()
    !headings.append('Name')

    !this.supports.setHeadings(!headings)
    !this.supports.setRows(!table)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getHangers
--
-- Description: Retrieve all of the hangers on a ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getHangers()

    !restCollect = object COLLECTION()
    !restCollect.scope(!this.currentGrid)
    !restCollect.type('REST')

    !rests = !restCollect.results()
    !table = object ARRAY()

    if (!rests.size() gt 0) then

      !hangers = !rests[1].members

      do !i indices !hangers
        !tableEntry = object ARRAY()
        !tableEntry.append(!hangers[!i].fullname)
        !table.append(!tableEntry)
      enddo
      !this.hanAccept.active = TRUE
      !this.hanDiscard.active = TRUE
    elseif (!rests.empty()) then
      !this.hanAccept.active = FALSE
      !this.hanDiscard.active = FALSE
    endif

    -- Headings
    !headings     = ARRAY()
    !headings.append('Name')

    !this.hangers.setHeadings(!headings)
    !this.hangers.setRows(!table)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectProfile
--
-- Description: Select from list of ceiling profiles
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      ARRAY      Returned array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectProfile(!dummyPassedArray is ARRAY)

  !this.tidy()

  -- Initialise Variable
  !rows                      = !this.hangerGrid.getSelectedRows()

  if (!rows.size() gt 0) then
    -- Clear current profiles array
    !this.currentProfiles = ARRAY()
    -- Loop through rows and add to current profiles
    do !i values !rows
      !this.currentProfiles.append(!i[1].dbRef())
      !this.markProfileEnds(!i[1].dbRef())
    enddo

    --!this.currentProfile = !row.first()[1].dbRef()
    --!!ce = !this.currentProfile

    --!this.markProfileEnds()

  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      markProfileEnds
--
-- Description: Mark the start and end point of the selected GENSEC
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .markProfileEnds()

  !this.tidy()

  !profileStart = !this.currentProfile.position

  SPINE 1

  POINSP LAST

  !profileEnd = !!ce.position

  if (!profileEnd.near(!profileStart,1mm)) then
    AID TEXT NUMBER $!<this.aidNumber> 'Start' At $!<profileStart>
  else
    AID TEXT NUMBER $!<this.aidNumber> 'Start' At $!<profileStart>
    AID TEXT NUMBER $!<this.aidNumber> 'End'   At $!<profileEnd>
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      markProfileEnds
--
-- Description: Mark the start and end point of the selected GENSEC
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .markProfileEnds(!profile is DBREF)

  --!this.tidy()

  --!profileStart = !this.currentProfile.position
  !profileStart = !profile.position

  !ref = !!ce
  !!ce = !profile

  SPINE 1

  POINSP LAST

  !profileEnd = !!ce.position

  !!ce = !ref


  if (!profileEnd.near(!profileStart,1mm)) then
    AID TEXT NUMBER $!<this.aidNumber> 'Start' At $!<profileStart>
  else
    AID TEXT NUMBER $!<this.aidNumber> 'Start' At $!<profileStart>
    AID TEXT NUMBER $!<this.aidNumber> 'End'   At $!<profileEnd>
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createHangars
--
-- Description: Creates hangers along the selected Gensec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createHangers()

  !this.tidy()

  !this.undo = object UNDOABLE()
  !this.undo.description('Created Hangers')
  !this.undo.add()

  -- Loop over all selected profiles
  do !selectedProfile values !this.currentProfiles

    -- Set reference for gensec
    --!selectedProfile = !this.currentProfile

    -- User entered variables


    !name = !!checkName(!this.supportSPREF.val, 'OLD')
    if(!name.unset()) then
      !this.supportSPREF.val = 'Unset'
      return
    else
      if (!this.supportSPREF.val.unset() or !this.supportSPREF.val.eq('Unset') or !this.supportSPREF.val.dbRef().type.neq('TABITE')) then
      	!!alert.message('Enter a valid SPREF.')
      	return
      endif
    endif

    if ((!this.hangSpace.val.set()) and (!this.hangSpace.val ge 50mm)) then
      !spacing = !this.hangSpace.val
    else
      !spacing = 500mm
    endif

    --if ((!this.hangHeight.val.set()) and (!this.hangHeight.val gt 50mm)) then
    --  !height = !this.hangHeight.val
    --else
    if (!this.supportSPREF.val.set()) then
      !height = !this.supportSPREF.val.dbRef().prtref.catref.para[1]
    else
      !height = 300mm
    endif
    --endif

    -- Hangers to be created at the intersection points
    if (!this.hangIntersect.val) then

      -- Intersections of with the selected profile
      if (!this.ppInts.val) then

        if (!selectedProfile.set().not()) then
          !!alert.warning('No profile selected!')
          return FALSE
        endif

        !spineCollect = object COLLECTION()
        !spineCollect.scope(!selectedProfile)
        !spineCollect.type('SPINE')
        !spines = !spineCollect.results()

        !profile = object PROFILE(!spines.last())
        !ceilingGrid = object RECTANGULARGRID(!this.currentGrid)

        !xLines = !ceilingGrid.xGridLines()
        !yLines = !ceilingGrid.yGridLines()

        !intersections = ARRAY()

        -- Get intersections with xLines
        do !i indices !xLines
          do !j from 2 to !xLines[!i].size()
            !line         = !xLines[!i][!j]
            if (!profile.intersections(!line).size() gt 0) then
              !intersections.append(!profile.intersections(!line))
            endif
          enddo
        enddo
        -- Get intersections with yLines
        do !k indices !yLines
         do !l from 2 to !yLines[!k].size()
           !line       = !yLines[!k][!l]
           if (!profile.intersections(!line).size() gt 0) then
             !intersections.append(!profile.intersections(!line))
           endif
         enddo
        enddo

       -- Create hangers at the positions of the intersections
       --!this.undo = object UNDOABLE()
       --!this.undo.description('Created Hangers')
       --!this.undo.add()

       do !m indices !intersections
        do !n indices !intersections[!m]
          skip if (!this.checkHangerPoint(!intersections[!m][!n]))

          !section =  object LINE(!selectedProfile.position, !intersections[!m][!n])
          !zdist = !section.length()

          -- Create fixing at specified zdistance
          !this.createHanger(!selectedProfile, !zdist, !height)
         enddo
       enddo

      -- !this.undo.endUndoable()
      elseif (!this.tpInts.val) then

       -- Create hangers at the positions of the intersections
       --!this.undo = object UNDOABLE()
       --!this.undo.description('Created Hangers')
       ---!this.undo.add()

        do !i indices !this.tileIntersects

          !position = !this.tileIntersects[!i][1]
          !gensec   = !this.tileIntersects[!i][2]

          !section =  object LINE(!gensec.position, !position)
          !zdist = !section.length()

          skip if (!this.checkHangerPoint(!position))

          -- Create fixing at specified zdistance
          !this.createHanger(!gensec, !zdist, !height)

        enddo

        --!this.undo.endUndoable()

      endif

    -- Hangers created at a defined spacing along the selected GENSEC
    else

      if (!selectedProfile.set().not()) then
        !!alert.warning('No profile selected!')
        return FALSE
      endif

      !spineCollect = object COLLECTION()
      !spineCollect.scope(!selectedProfile)
      !spineCollect.type('SPINE')
      !spines = !spineCollect.results()
      !spinePoints = !spines.last().members

      !totalLineLen = 0

      do !j indices !spinePoints
        break if (!j eq !spinePoints.size())

        !cPoint = !spinePoints[!j]
        !k = !j + 1
        !nPoint = !spinePoints[!k]

        !cPos = !cPoint.position
        !nPos = !nPoint.position

        !gensecLine = object LINE(!cPos, !nPos)
        !lineLength = !gensecLine.length()

        !totalLineLen = !totalLineLen + !lineLength
      enddo

      !i = !spacing

      --!this.undo = object UNDOABLE()

      --!this.undo.description('Created Hangers')
      --!this.undo.add()
      do
        -- Create fixings along the gensec at the specified spacing
        break if (!i gt (!totalLineLen - 100mm))
        !this.createHanger(!selectedProfile, !i, !height)

        !i = !i + !spacing
      enddo
      --!this.undo.endUndoable()
    endif

  enddo

  !this.undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createHanger
--
-- Description: Create a single hanger at the defined point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       DBREF    Profile to attach hanger to
--    2    R       REAL     Distance along profile
--    3    R       REAL     Height of hanger
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createHanger(!profile is DBREF, !zdistance is REAL, !height is REAL)

  !!ce = !profile

  -- Create fixing at specified zdistance
  NEW JLDAT
  !element = !!ce
  !element.zdistance = !zdistance

  NEW PLDAT
  !element = !!ce
  !element.posline = 'NA'

  NEW FIXING
  !fixing = !!ce

  -- Create Hangar to attach to fixing
  !!ce = !this.currentGrid

  !restCollect = object COLLECTION()
  !restCollect.scope(!!ce)
  !restCollect.type('REST')

  !rests = !restCollect.results()

  -- If there is no restraint element, then create one
  if(!rests.empty()) then
    !!ce      = !this.currentGrid
    NEW REST
  -- Existing REST element
  else
    !!ce      = !rests.first()
  endif

  NEW HANG
  !element = !!ce
  !element.href = !fixing
  !element.hspec = !this.supportSPREF.val.dbRef().own.own
  !element.hpos = !fixing.position
  !element.hdir = object DIRECTION('U WRT WORLD')

  !hpos = !element.hpos
  !hpos.up = !height

  !element.tpos = !hpos

  NEW SCLA
  !hangElement = !!ce
  !hangElement.spref = !this.supportSPREF.val.dbRef()
  --if()then
  --  !hangElement.ori   = Z is -Z
  --endif
  !hangElement.pos   = !fixing.position

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkHangerPoint
--
-- Description: Check to see if a hanger with given position exists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     POSITION    Position to be checked
-- Return:
--   [Data Type] [Description]
--     BOOLEAN    Position exists?
--
------------------------------------------------------------------------

define method .checkHangerPoint(!checkPos is POSITION) is BOOLEAN

  !!ce = !this.currentGrid

  REST 1
  handle (2,113)
    return FALSE
  endhandle

  !hangerGroup = !!ce

  !hangers = !hangerGroup.members

  !hangerExist = FALSE

  do !i indices !hangers

    !hangerPos = !hangers[!i].hpos.wrt(WORLD)

    if (!hangerPos eq !checkPos) then
      !hangerExist = TRUE
    elseif (!checkPos.near(!hangerPos, 20mm)) then
      !hangerExist = TRUE
    endif

  enddo

  return !hangerExist

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickHead
--
-- Description: Setup EDG pick event for picking start position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickHead()

  !this.headPick.active = FALSE

  -- Initialise variables
  !prompt               = 'Pick start of support profile'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = TRUE
  !packet.close         = '!!' & !this.name() & '.supportPickClose()'
  !packet.action        = '!!' & !this.name() & '.linePosition(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      pickHead
--
-- Description: Setup EDG pick event for picking start position
--
-- Method Type: Function/Procedure
