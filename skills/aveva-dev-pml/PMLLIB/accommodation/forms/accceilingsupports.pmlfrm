--
--  Description:     Ceiling Supports definition form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accCeilingSupports()             -
--  backToMainRoomDesignTasks()      -                   Switching to Main Room Design Tasks
--  ceilingGridList()                -                   Update the list of ceilings
--  ceilingList()                    -                   Update the list of ceilings
--  checkHangerPoint(POSITION)       BOOLEAN             Check to see if a hanger with given position exists
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  checkZDist()                     BOOLEAN             Check that the entered zdist does not exceed the
--  clearFields()                    -                   Removes all the old data from the form
--  createHanger(BOOLEAN)            -                   Display ceiling hanger pane
--  createHanger(DBREF,REAL,REAL)    -                   Create a single hanger at the defined point
--  createHangers()                  -
--  createSuppProfile()              -                   Loops through the profile list and creates them all
--  createSupport(BOOLEAN)           -                   Display ceiling support pane
--  deleteHanger()                   -                   Delete Hangers
--  deleteSupport()                  -                   Delete Support
--  dummy()                          -                   Dummy method for unset
--  findHanger()                     -                   Choose hanger from selection form
--  findModifyHanger()               -                   Choose SPREF from selection form for existing hanger
--  getHangers()                     -                   Retrieve all of the hangers on a ceiling grid
--  getProfiles()                    -                   Retrieve all of the lattice profiles on a ceiling grid
--  getSupports()                    -                   Retrieve all of the support profiles on a ceiling grid
--  hangerCreate()                   -                   Create Hangers
--  hangerModify()                   -                   Modify Hangers
--  hangerModify(DBREF)              -                   Modify Hangers
--  initialise()                     -                   Initialise form.
--  initialise(DBREF)                -                   Initialise form.
--  intersectionPane(GADGET,STRING)  -                   Show/hide the intersection frame
--  intersections(GADGET,STRING)     -                   Modify the intersection pane layout according to selection
--  linePosition(EDGPOSITIONDATA)    -                   Load the position, relative to the outer boundary
--  linePosition(REAL,REAL)          -                   Mark the position of the new Ceiling Support
--  listSelectionChanged(GADGET,STRING) -                   Selection change callback on list
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  markProfileEnds()                -                   Mark the start and end point of the selected GENSEC
--  markProfileEnds(DBREF)           -                   Mark the start and end point of the selected GENSEC
--  modify(GADGET,STRING)            -                   Updating a support or hanger element
--  modifyHanger(BOOLEAN)            -                   Display hanger modification pane
--  modifySupport(BOOLEAN)           -                   Display support modification pane
--  onRemoveClicked(DBREF,GADGET)    -                   Delete hanger/support from popup menu
--  pickHead()                       -                   Setup EDG pick event for picking start position
--  pickHead2()                      -                   Setup EDG pick event for picking start position
--  pickTileEdge()                   -                   Setup EDG pick event for picking tile edge
--  profileResult(STRING)            -                   Check the Gtype of a selected profile
--  profileSearch()                  -                   Choose support profile from selection form
--  refresh()                        -                   Refresh form from navigator.
--  select(ARRAY)                    -                   Select from list of ceilings
--  selectProfile(ARRAY)             -                   Select from list of ceiling profiles
--  setModifySpref(STRING)           -                   Set the existing hanger Spref textbox value
--  setSpref(STRING)                 -                   Set the Fitting Spref textbox value
--  supportCreate()                  -                   Create Support Profiles
--  supportModify()                  -                   Modify Supports
--  supportModify(DBREF)             -                   Modify Supports
--  supportPickClose()               -                   Get gadgets into correct state following pick support
--  tidy()                           -                   Tidy aid graphics
--  tileEdge()                       -                   Load the pline of the picked tile
--  tileEdgePos(ANY)                 -
--  tileProfile(DBREF)               PROFILE             Returns a profile of the current tile
--
setup form !!accCeilingSupports dialog dock right

  -- Current hierarchy
  paragraph .currentOwner                     anchor top + left + right         at x0.5                   ymax                width 30 lines 1
  combo     .currOwnList  'Current Ceiling:'  tagwidth 12 anchor top + left + right    at xmin            ymax+0.5            callback '!this.ceilingGridList()'      width 13


-- Main Task Pane
  frame .mainTaskPane panel                   anchor top + left + right         at x0                     ymax

    paragraph .gridSelect                                                       at xmin                   ymax+0.5            text 'Select Grid'
    -- List of ceiling grids
    container .ceilingList PMLNetCONTROL 'NET'  anchor left + right + top       at xmin                   ymax+0.2            width 30 lines 8

    -- Create options
    paragraph .gridCreateTasks                                                  at x0.5                   ymax+0.5            text 'Create'
    line .mainTaskL1                          anchor top + left + right         at xmin                   ymax                horizontal width 30
    button .mtCrtProfs    linkLabel 'Support Profile'                           at x2                     ymax                callback '!this.supportCreate()'
    button .mtCrtHanger   linkLabel 'Hangers'                                   at xmin                   ymax                callback '!this.hangerCreate()'

    -- Modify options
    paragraph .gridModifyTasks                                                  at x0.5                   ymax+0.5            text 'Modify'
    line   .mainTaskL2                        anchor top + left + right         at xmin                   ymax                horizontal width 30
    button .mtModSupp     linkLabel 'Supports'                                  at x2                     ymax                callback '!this.supportModify()'
    button .mtModHang     linkLabel 'Hangers'                                   at xmin                   ymax                callback '!this.hangerModify()'

    -- Delete options
    paragraph .gridDeleteTasks                                                  at x0.5                   ymax+0.5            text 'Delete'
    line      .mainTaskL3                     anchor top + left + right         at xmin                   ymax                horizontal width 30
    button    .mtDelSupport  linkLabel 'Supports'                               at x2                     ymax                callback '!this.deleteSupport()'
    button    .mtDelHanger  linkLabel 'Hangers'                                 at x2                     ymax                callback '!this.deleteHanger()'

    line   .mainTaskL4                        anchor top + left + right         at xmin                   ymax                horizontal width 30
    paragraph .supTaskBackIcon                anchor top + left                 at x0                     ymax+0.5            pixmap width 15 height 15
    button .blTskMain     linkLabel 'Return to main tasks'                      at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20


  exit

  frame .crtSupport panel                           anchor top + left + right   at xmin.mainTaskPane      ymax.currOwnList

     -- Search Lattice
    paragraph .supSearchIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button    .searchProfile  linkLabel 'Select Profile Specification...' anchor top + left     at xmax+0.5               ymin                callback '!this.profileSearch()'

    text      .profileSPREF   'Specification:'  tagwidth 9  anchor top + left + right   at x2                     ymax+0.2            width 15 is STRING

    -- Gadgetry definition for creation
    text .proName  'Name:'  tagwidth 9              anchor top + left + right   at x2                     ymax+0.2            callback '!this.checkName(' width 15 is STRING
    path down
    halign right
    text .proHeig 'Height:' tagwidth 9              anchor top + left + right   at xmin                   ymax+0.2            callback '' width 15 is REAL format !!distanceFmt

    -- Pick Head
    frame .headPosPan foldUpPanel 'Head Position'   anchor top + left + right   at x1                     ymax+0.5            width 30
    button .headPick linkLabel 'Pick Head Position' anchor top + left + right   at x2                     ymax                callback '!this.pickHead()' width 20
    text   .headX    'X:'   tagwidth 5              anchor top + left + right   at xmin                   ymax+0.2            callback '!this.linePosition(!this.headX.val, !this.headY.val)' width 15 is REAL format !!distanceFmt
    text   .headY    'Y:'   tagwidth 5              anchor top + left + right   at xmin                   ymax+0.1            callback '!this.linePosition(!this.headX.val, !this.headY.val)' width 15 is REAL format !!distanceFmt
    exit

    -- Create Profiles
    paragraph .supCrtIcon                           anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .supCreate linkLabel 'Create Profile'    anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.createSuppProfile()' width 12

    paragraph .supBackIcon                          anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .supMain   linkLabel 'Back to support tasks'                         at xmax+1                 ymin                callback '!this.mainTasks(true)'


  exit

  -- Supports and Hangars pane
  frame .crtHanger panel                            anchor top + left + right   at xmin.mainTaskPane      ymax.currOwnList

    paragraph .hangPrompt                           anchor top + left           at x0                     ymax+0.2            text 'Choose Profile'
    -- List of ceiling profiles
    container .hangerList PMLNetCONTROL 'NET'       anchor left + right + top   at xmin                   ymax+0.2            width 30 lines 8

    paragraph .hangSearchIcon                       anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button    .searchSup  linkLabel 'Select Hanger Specification...'  anchor top + left           at xmax+0.5               ymin                callback '!this.findHanger()'

    text      .supportSPREF   'Specification:'  tagwidth 9  anchor top + left + right   at x2                     ymax+0.2            width 15 is STRING

    -- Gadgetry definition for creation
    path down
    halign right
    text      .hangSpace  'Spacing:' tagwidth 9     anchor top + left + right   at xmin                   ymax+0.2            width 15 is REAL format !!distanceFmt

    toggle    .hangIntersect 'At Intersections'     anchor top + left + right   at xmin                   ymax+0.2            callback '!this.intersectionPane('

    frame     .intersectGroup                       anchor top + left + right   at x0.5                   ymax+0.2            width 20

      rToggle .ppInts 'Profile Intersections'       tagwidth 15  anchor top + left + right                at xmin+0.2         ymax+0.2 callback '!this.intersections('
      rToggle .tpInts 'Tile-Profile Intersections'  tagwidth 15  anchor top + left + right                at xmin             ymax+0.2 callback '!this.intersections('
      button  .pickTile linkLabel 'Pick Tile Edge'  anchor top + left + right   at xmin+0.2               ymax+0.2            callback '!this.pickTileEdge()' width 10
      paragraph .hangTileEdge                       anchor top + left           at x2                     ymax+0.2            width 20

    exit
    paragraph .hangCrtIcon                          anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .hangCreate linkLabel 'Create Hangers'   anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.createHangers()' width 12

    paragraph .hangBackIcon                         anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .hangMain  linkLabel 'Back to support tasks'                         at xmax+1                 ymin                callback '!this.mainTasks(true)'

  exit

  -- Mod Supports Profile
  frame .modSupport panel                           anchor top + left + right   at xmin.mainTaskPane      ymax.currOwnList

    -- List of supports

    list      .supports 'Select Support'            anchor top + left + right   at x2                     ymax+0.2            callback '!this.listSelectionChanged(' SINGLE width 25 length 5

    text      .supportName    'Name:'  tagwidth 9   anchor top + left + right   at xmin                   ymax+0.2            width 15 is STRING
    text      .supportHeight 'Height:' tagwidth 9   anchor top + left + right   at xmin                   ymax+0.2            width 15  is REAL format !!distanceFmt

    -- Pick Head
    frame .modPosPan foldUpPanel 'Position'         anchor top + left + right   at x1                     ymax+0.5            width 20
    button .headPick2 linkLabel  'Pick Head Position' anchor top + left + right at xmin                   ymax+.25            callback '!this.pickHead2()' width 20
    text   .modSupX    'X:'   tagwidth 5            anchor top + left + right   at xmin                   ymax+0.2            callback '!this.linePosition(!this.modSupX.val, !this.modSupY.val)' width 15 is REAL format !!distanceFmt
    text   .modSupY    'Y:'   tagwidth 5            anchor top + left + right   at xmin                   ymax+0.1            callback '!this.linePosition(!this.modSupX.val, !this.modSupY.val)' width 15 is REAL format !!distanceFmt
    text   .modSupZ    'Z:'   tagwidth 5            anchor top + left + right   at xmin                   ymax+0.1            width 15 is REAL format !!distanceFmt
    exit

          -- Accept Changes
    paragraph .supAcceptIcon                        anchor top + left           at x0                     ymax+0.2            pixmap width 15 height 15
    button .supAccept  linkLabel 'Accept Changes'   anchor top + left           at xmax+0.5               ymin                callback '!this.modify(' width 10

      -- Discard Changes
    paragraph .supDiscardIcon                       anchor top + right          at xmax+4                 ymin                pixmap width 15 height 15
    button .supDiscard linkLabel 'Discard Changes'  anchor top + right          at xmax+0.5               ymin                callback '!this.mainTasks(true)' width 10

    paragraph .supModBackIcon                       anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .supModMain   linkLabel   'Back to support tasks'                    at xmax+1                 ymin                callback '!this.mainTasks(true)'


  exit

  -- Mod Supports Profile
  frame .modHanger panel                            anchor top + left + right   at xmin.mainTaskPane      ymax.currOwnList

    -- List of supports

    list      .hangers 'Select Hanger'              anchor top + left + right   at x2                     ymax+0.2            callback '!this.listSelectionChanged(' SINGLE width 25 length 8

    text      .hangerName     'Name:'  tagwidth 9   anchor top + left + right   at xmin                   ymax+0.5            width 15 is STRING

    paragraph .modHangSearchIcon                    anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button    .modSearchHanger linkLabel 'Select Hanger Specification...' anchor top + left  at xmax+0.5  ymin                callback '!this.findModifyHanger()'

    text      .modHangerSPREF 'Specification:'  tagwidth 9  anchor top + left + right   at x2             ymax+0.2            width 15 is STRING

    text      .hangerHeight  'Height:' tagwidth 9   anchor top + left + right   at xmin                   ymax+0.2            width 15  is REAL format !!distanceFmt

    text      .hangerZDist 'Distance:' tagwidth 9   anchor top + left + right   at xmin                   ymax+0.5            callback '!this.checkZDist()' width 15 is REAL format !!distanceFmt

          -- Accept Changes
    paragraph .hanAcceptIcon                        anchor top + left           at x0                     ymax+0.2            pixmap width 15 height 15
    button .hanAccept  linkLabel 'Accept Changes'   anchor top + left           at xmax+0.5               ymin                callback '!this.modify(' width 10

      -- Discard Changes
    paragraph .hanDiscardIcon                       anchor top + right          at xmax+4                 ymin                pixmap width 15 height 15
    button .hanDiscard linkLabel 'Discard Changes'  anchor top + right          at xmax+0.5               ymin                callback '!this.mainTasks(true)' width 10

    paragraph .hanModBackIcon                       anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .hanModMain   linkLabel   'Back to support tasks'                    at xmax+1                 ymin                callback '!this.mainTasks(true)'


  exit

	menu .supportsPopupMenu
    !this.supportsPopupMenu.add( 'callback', 'Delete Selected Support', '!this.onRemoveClicked(!this.currentSupport, !this.supports )' )

    !this.supports.setPopup (  !this.supportsPopupMenu )

	menu .hangersPopupMenu
    !this.hangersPopupMenu.add( 'callback', 'Delete Selected Hanger', '!this.onRemoveClicked(!this.currentHanger, !this.hangers )' )

    !this.hangers.setPopup (  !this.hangersPopupMenu )

  -- Form members

  -- Current Ceiling
  member .currentCeiling    is DBREF
  member .currentGrid       is DBREF
  member .currentProfile    is DBREF
  member .currentProfiles   is ARRAY
  member .currentSupport    is DBREF
  member .currentHanger     is DBREF
  member .tileIntersects    is ARRAY

  -- Undo for form
  member .undo              is UNDOABLE

  -- Current Task Pane within Form
  member .currentPane       is GADGET
  member .currentTask       is BLOCK
  member .refreshTask       is BLOCK

  -- EDG Description
  member .edgDescription    is STRING

  -- Aid graphics
  member .aidInner          is REAL
  member .aidOuter          is REAL
  member .aidNumber         is REAL

  -- Alternative text for owning element type
  member .ownerAltText    is STRING

  -- Owning element
  member .ownerType       is STRING

  -- Grid control
  using namespace 'Aveva.Pdms.Presentation'
  member .contentGrid      is NETGRIDCONTROL
  member .hangerGrid       is NETGRIDCONTROL

exit

------------------------------------------------------------------------
--
-- Method:      accCeilingGridSupports
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--

define method .accCeilingSupports()

  -- Cancel Callback
  !this.cancelCall              = '!this.tidy()'

  -- Set form to auto-scroll
  !this.autoScroll              = true

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!this.dummy()')


 -- Initialise task panes
  !this.mainTasks(TRUE)
  !this.createHanger(FALSE)
  !this.createSupport(FALSE)
  !this.modifySupport(FALSE)
  --!this.modifyHanger(FALSE)

  -- Set "Back" icon
  !backIcon                     = !!pml.getpathname('back.png')
  !this.hangBackIcon.addPixmap(!backIcon)
  !this.supBackIcon.addPixmap(!backIcon)
  !this.supModBackIcon.addPixmap(!backIcon)
  !this.hanModBackIcon.addPixmap(!backIcon)
  !this.supTaskBackIcon.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getpathname('create.png')
  !this.hangCrtIcon.addPixmap(!createIcon)
  !this.supCrtIcon.addPixmap(!createIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getpathname('accept.png')
  !this.supAcceptIcon.addPixmap(!acceptIcon)
  !this.hanAcceptIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getpathname('discard.png')
  !this.supDiscardIcon.addPixmap(!discardIcon)
  !this.hanDiscardIcon.addPixmap(!discardIcon)

  -- Set "Search" icon
  !searchIcon                   = !!pml.getpathname('ng_zoomtodrawlist.png')
  !this.hangSearchIcon.addPixmap(!searchIcon)
  !this.modHangSearchIcon.addPixmap(!searchIcon)
  !this.supSearchIcon.addPixmap(!searchIcon)


  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- Add .Net control to PML container for contents
  !this.contentGrid             = object NETGRIDCONTROL()
  !this.ceilingList.control     = !this.contentGrid.handle()

  using namespace 'Aveva.Pdms.Presentation'
  !this.hangerGrid             = object NETGRIDCONTROL()
  !this.hangerList.control     = !this.hangerGrid.handle()

  -- Events handled
  !this.contentGrid.addeventhandler('afterSelectChange', !this, 'select')
  !this.hangerGrid.addeventhandler('afterSelectChange', !this, 'selectProfile')

  -- Load information from Configuration
  !this.contentGrid.columnExcelFilter(FALSE)
  !this.hangerGrid.columnExcelFilter(FALSE)

  !this.contentGrid.outlookGroupStyle(FALSE)
  !this.hangerGrid.outlookGroupStyle(FALSE)

  !this.contentGrid.columnSummaries(FALSE)
  !this.hangerGrid.columnSummaries(FALSE)

  !this.contentGrid.fixedHeaders(FALSE)
  !this.hangerGrid.fixedHeaders(FALSE)

  !this.contentGrid.fixedRows(FALSE)
  !this.hangerGrid.fixedRows(FALSE)

  !this.contentGrid.singleRowSelection(TRUE)
  !this.hangerGrid.singleRowSelection(FALSE)

  -- Aid graphics
  !this.aidNumber = !!aidNumbers.add('Ceiling grid profiles')

  -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

  !this.initialise()


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  !element = !!accNavigator.currentSelection()

  if(!element.unset()) then
    !this.currentCeiling    = object DBREF()
    !this.currentOwner.val  = 'No active element selected'

  else
    -- Set owner where layout data is to be stored
    !this.currentCeiling      = !element
    !this.ownerType           = !this.currentCeiling.type
    !this.currentOwner.val    = 'Active element: ' & !this.currentCeiling.namn
    !this.ceilingList()

  endif

  !this.mtCrtProfs.active = FALSE
  !this.mtCrtHanger.active = FALSE
  !this.mtModSupp.active  = FALSE
  !this.mtModHang.active = FALSE
  !this.mtDelSupport.active = FALSE
  !this.mtDelHanger.active = FALSE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!element is DBREF)

  -- Element changed
  if(!element.set()) then
    !this.currentCeiling        = !element
    !this.currentOwner.val      = 'Active element: ' & !this.currentCeiling.namn

    -- Update ceiling list
    !this.ceilingList()

  !this.mainTasks(TRUE)

  !this.mtCrtProfs.active = FALSE
  !this.mtCrtHanger.active = FALSE
  !this.mtModSupp.active  = FALSE
  !this.mtModHang.active = FALSE
  !this.mtDelSupport.active = FALSE
  !this.mtDelHanger.active = FALSE


  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dummy
--
-- Description: Dummy method for unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dummy()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh form from navigator.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh task
  if(!this.shown()) then
    !this.initialise()
    !this.refreshTask.evaluate()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clearFields
--
-- Description: Removes all the old data from the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearFields()

  !this.proName.val = ''
  !this.proHeig.val = 0
  !this.profileSPREF.active = FALSE
  !this.supportSPREF.active = FALSE
  !this.profileSPREF.val = 'Unset'
  !this.supportSPREF.val = 'Unset'
  !this.headX.val = 0
  !this.headY.val = 0
  !this.hangSpace.val = 50
  --!this.hangHeight.val = 0
  !this.supportName.val = ''
  !this.supportHeight.val = 0
  !this.modSupX.val = 0
  !this.modSupY.val = 0
  !this.modSupZ.val = 0
  !this.hangerName.val = ''
  !this.modHangerSPREF.val = ''
  !this.hangerHeight.val = 0
  !this.hangerZDist.val = 0

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      ceilingList
--
-- Description: Update the list of ceilings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingList()

  -- Collect ceilings
  !contents = object ACCCOLLECTCONTENTS()

  -- Get ceiling for
  if(!contents.scope(!!accNavigator.currentSelection())) then
    !ceilings = !contents.collectAllOfType('CEILIN')

    -- Headings
    !headings     = ARRAY()
    !headings.append('Name')
    !headings.append('Description')
    !headings.append('Owner')

    -- Build tables
    !table        = ARRAY()

    do !ceiling values !ceilings
      !table.append(!ceiling.name)

    enddo

    if (!ceilings.empty()) then
      !this.contentGrid.clearGrid()

      !this.mtCrtProfs.active = FALSE
      !this.mtCrtHanger.active = FALSE
      !this.mtModSupp.active  = FALSE
      !this.mtModHang.active = FALSE
      !this.mtDelSupport.active = FALSE
      !this.mtDelHanger.active = FALSE
    endif

    -- Load grid
    !this.currOwnList.dtext = !table

    !this.ceilingGridList()

  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      .ceilingGridList()
--
-- Description: Update the list of ceilings grids
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingGridList()

  -- Collect ceiling grids
  !contents = object ACCCOLLECTCONTENTS()
  !mainOwner = object DBREF()

  !this.currentCeiling = !this.currOwnList.displaytext().dbRef()
  handle ANY
    !this.ceilingList()
    return FALSE
  endhandle

  -- Get ceiling for
  if(!contents.scope(!this.currentCeiling)) then

    !ceilingGrids = !contents.collectAllOfType('CLNPNGRID')

    -- Headings
    !headings     = ARRAY()
    !headings.append('Name')
    !headings.append('Description')
    !headings.append('Owner')

    -- Build tables
    !table        = ARRAY()

    do !ceilingGrid values !ceilingGrids
      skip if (!ceilingGrid.owner neq !this.currentCeiling)
      !tableEntry = ARRAY()
      !tableEntry.append(!ceilingGrid.name)
      !tableEntry.append(!ceilingGrid.description)
      !mainOwner = !ceilingGrid.owner
      if(!ceilingGrid.owner.isNamed) then
        !tableEntry.append('[' & !mainOwner.fulltype & '] ' & !mainOwner.namn)
      else
        !tableEntry.append(!mainOwner.fulltype)
      endif
      !table.append(!tableEntry)
    enddo

    -- Load grid
    using namespace 'Aveva.Pdms.Presentation'
    !nds          = object NETDATASOURCE('CeilingGrids', !headings, !table)
    !this.contentGrid.bindToDataSource(!nds)

    --if (!table.empty()) then
      !this.mtCrtProfs.active = FALSE
      !this.mtCrtHanger.active = FALSE
      !this.mtModSupp.active  = FALSE
      !this.mtModHang.active = FALSE
      !this.mtDelSupport.active = FALSE
      !this.mtDelHanger.active = FALSE
    --endif

  endif



endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.mainTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.mainTasks(false)')
    !this.refreshTask         = object BLOCK('!this.dummy()')

     -- Change form title to reflect the active pane
    !this.formTitle           = 'Ceiling Support Tasks'

    !this.initialise()

  endif

  -- Show/hide task pane
  !this.mainTaskPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createHanger
--
-- Description: Display ceiling hanger pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createHanger(!active is BOOLEAN)

  -- Make task pane active
  if (!active) then

    !this.currentPane         = !this.crtHanger

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.createHanger(FALSE)')
    !this.refreshTask         = object BLOCK('!this.hangerCreate()')

    !this.ceilingList.active  = FALSE

    !this.formTitle           = 'Create Hangers'
    -- Force form layout defaults
    !this.intersectionPane(!this.hangIntersect, |DUMMY|)
    !this.ppInts.val = TRUE
    !this.intersections(!this.ppInts, |DUMMY|)

  -- Actions when task pane is made inactive
  else
    !this.ceilingList.active  = TRUE
    !this.tidy()
    !this.clearFields()
  endif

  -- Show/hide task pane
  !this.crtHanger.visible    = !active
  !this.hangSpace.active     = TRUE
endmethod
-- End of method

