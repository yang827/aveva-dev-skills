--
------------------------------------------------------------------------

define method .setModifySpref(!hangerName is STRING)

  !this.modHangerSPREF.val = !hangerName

-- update height as well
  !this.hangerHeight.val = !hangerName.dbRef().prtref.catref.para[1]

endmethod


-------------------------------------------------------------------------
--
-- Method:      profileResult
--
-- Description: Check the Gtype of a selected profile
--              and then load the value to the appropriate gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    2    R      STRING      Name of Profile
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------

define method .profileResult(!profileName is STRING)

    !this.profileSPREF.val = !profileName
    !!sectionprofileselection.hide()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createSuppProfile
--
-- Description: Loops through the profile list and creates them all
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createSuppProfile()

  -- Get lattices
  !collection = object COLLECTION()
  !collection.scope(!this.currentGrid)
  !collection.filter(object EXPRESSION('PURP eq ''SUPP'''))
  !collection.type('CLNLAT')
  !lattices   = !collection.results()

  if ((!this.profileSPREF.val.set().not()) or (!this.profileSPREF.val eq 'Unset')) then
    !!alert.warning('Enter a valid SPREF')
    return FALSE
  endif

  !this.undo = object UNDOABLE()

  !this.undo.description('Created Support')
  !this.undo.add()
  -- If there is no lattice element, then create one
  if(!lattices.empty()) then
    !!ce      = !this.currentGrid
    NEW CLNLAT
    PURP SUPP
  -- Existing lattice
  else
    !!ce      = !lattices.first()
  endif

  !bndLins = object COLLECTION()
  !bndLins.scope(!this.currentGrid)
  !bndLins.type('BNDLIN')

  !boundLin = !bndLins.results()

  !outerBoundary = !boundLin[1].members[1]

  NEW GENSEC

  !name                       = !this.proName.val.trim()
  if(!name.neq('')) then
    !name                     = '/' & !name
    !!ce.name      = !name
  endif

  !!ce.spref    = !this.profileSPREF.val.dbRef()

  !profilePos = object POSITION()
  !profilePos.origin = !outerBoundary
  !profilePos.east   = !this.headX.val
  !profilePos.north  = !this.headY.val
  !profilePos.up     = 0mm

  !!ce.position = !profilePos
  NEW SPINE
  !!ce.yDirection = object DIRECTION('X')
  NEW POINSP
  NEW POINSP

  if ((!this.proHeig.val.set()) and (!this.proHeig.val gt 50mm)) then
    !height = !this.proHeig.val
  else
    !height = 200mm
  endif
  !profilePos.up = !height

  !!ce.position = !profilePos
  GENSEC
  DRNS PERP DRNE PERP

  !this.undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  AID CLEAR ALL $!<this.aidNumber>

  !!edgCntrl.escape()

  --!this.pickTile.active = TRUE
  !this.hangCreate.active = TRUE
  !this.hangMain.active = TRUE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      listSelectionChanged
--
-- Description: Selection change callback on list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------

define method .listSelectionChanged(!gadget is GADGET, !action is STRING)

  if (!gadget eq !this.supports) then

    if (!action eq 'SELECT') then
      !this.currentSupport    = !this.supports.dtext[!this.supports.val].dbRef()
      handle ANY
        !this.getSupports()
        return FALSE
      endhandle
      !!ce = !this.currentSupport
      if (!this.currentSupport.isNamed) then
        !this.supportName.val   = !this.currentSupport.namn
      else
        !this.supportName.val = ''
      endif
      !this.supportHeight.val = !this.currentSupport.members[1].members.last().position.up

      !this.modSupX.val = !this.currentSupport.position.east
      !this.modSupY.val = !this.currentSupport.position.north
      !this.modSupZ.val = !this.currentSupport.position.up
    endif

  elseif (!gadget eq !this.hangers) then

    if (!action eq 'SELECT') then
      !this.currentHanger    = !this.hangers.dtext[!this.hangers.val].dbRef()
      handle ANY
        !this.getHangers()
        return FALSE
      endhandle

      !!ce = !this.currentHanger
      if (!this.currentHanger.isNamed) then
        !this.hangerName.val   = !this.currentHanger.namn
      else
        !this.hangerName.val = ''
      endif
      !this.hangerHeight.val = !this.currentHanger.tpos.up
      !this.modHangerSPREF.val = !this.currentHanger.members[1].spref.name

      !jlDat = !this.currentHanger.href.owner.owner
      handle ANY
        !this.hangerZDist.val  = 0.0
      elsehandle NONE
        !zdist = !jlDat.zdist
        !this.hangerZDist.val  = !zdist
      endhandle
    endif

  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Updating a support or hanger element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify(!gadget is GADGET, !dummySelect is STRING)

  if (!gadget eq !this.hanAccept) AND (!this.currentHanger.unset().not()) then

     !name                       = !this.hangerName.val.trim()
     if(!name.neq('')) then
        !name                     = '/' & !name
        !this.currentHanger.name      = !name
     endif

     !jlDat   = !this.currentHanger.href.owner.owner
     !fixing  = !this.currentHanger.href

     !jlDat.zdistance = !this.hangerZDist.val

     !this.currentHanger.hpos = !fixing.position

     !tpos = !fixing.position
     !tpos.up = !this.hangerHeight.val

     !this.currentHanger.tpos = !tpos
     !this.currentHanger.members[1].spref = !this.modHangerSPREF.val.dbRef()

     !this.getHangers()

  elseif (!gadget eq !this.supAccept) AND (!this.currentSupport.unset().not())then

     !name                       = !this.supportName.val.trim()
     if(!name.neq('')) then
        !name                     = '/' & !name
        !this.currentSupport.name      = !name
     endif

    !endSpine  = !this.currentSupport.members[1].members.last()
    !endSpoint = !endSpine.position

    !endSpoint.up = !this.supportHeight.val

    !endSpine.position = !endSpoint

    !pos = !this.currentSupport.position
    !pos.east  = !this.modSupX.val
    !pos.north = !this.modSupY.val
    !pos.up    = !this.modSupZ.val


    !this.currentSupport.position = !pos

    !this.getSupports()

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: checkZDist
--
-- Description: Check that the entered zdist does not exceed the
--              length of the gensec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkZDist() is BOOLEAN

  !selectedProfile = !this.currentHanger.href.owner.owner.owner
  handle ANY
    return TRUE
  endhandle

  !!ce = !selectedProfile

  !spineCollect = object COLLECTION()
  !spineCollect.scope(!!ce)
  !spineCollect.type('SPINE')

  !spines = !spineCollect.results()

  !spinePoints = !spines.last().members

  !totalLineLen = 0

  do !j indices !spinePoints

      break if (!j eq !spinePoints.size())

      !cPoint = !spinePoints[!j]
      !k = !j + 1
      !nPoint = !spinePoints[!k]

      !cPos = !cPoint.position
      !nPos = !nPoint.position

      !gensecLine = object LINE(!cPos, !nPos)

      !lineLength = !gensecLine.length()

      !totalLineLen = !totalLineLen + !lineLength
  enddo

  if (!this.hangerZDist.val ge !totalLineLen) then
    !!alert.warning('Entered distance exceeds length of owning profile!')
    !this.hangerZDist.val = !this.currentHanger.href.owner.owner.zdist
    return FALSE
  else
    return TRUE
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method: intersectionPane
--
-- Description: Show/hide the intersection frame
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .intersectionPane(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val) then
    !this.intersectGroup.visible = TRUE
    !this.hangSpace.active       = FALSE
  else
    !this.intersectGroup.visible = FALSE
    !this.hangSpace.active       = TRUE
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: intersections
--
-- Description: Modify the intersection pane layout according to selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .intersections(!gadget is GADGET, !dummyString is STRING)

  if (!gadget eq !this.ppInts) then
    !this.pickTile.active = FALSE
    !this.hangTileEdge.val = ''
  elseif (!gadget eq !this.tpInts) then
    !this.pickTile.active = TRUE
    !this.hangTileEdge.val = 'Selected Tile: '
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      backToMainRoomDesignTasks
--
-- Description: Switching to Main Room Design Tasks
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backToMainRoomDesignTasks()

  !this.mainTasks(true)
  --!this.hide()
  !!accTaskManager.active('accDetail')
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteHanger
--
-- Description: Delete Restraint
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteHanger()

  --should set current ceiling to delete here (from navigator for other element types)
  -- Delete Restraint 1 of current element

  -- Get Hangers
  !collection = object COLLECTION()
  !collection.scope(!this.currentGrid)
  !collection.type('REST')
  !restraintCollection   = !collection.results()

  -- If there is no Restraint element - no nothing
  if(!restraintCollection.empty().not()) then
    if(!!accDeleteManager.deleteElement(!restraintCollection.first()).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
      !this.tidy()
    endif
  endif
  -- if element is deleted then grey out button
  !restraintCollection   = !collection.results()
  if(!restraintCollection.empty()) then
    !this.mtDelHanger.active  = FALSE
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      deleteSupport
--
-- Description: Delete Restraint
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteSupport()

  --should set current ceiling to delete here (from navigator for other element types)
  -- Delete CLNLAT 1 of current element

  -- Get Supports
  !collection = object COLLECTION()
  !collection.scope(!this.currentGrid)
  !collection.filter(object EXPRESSION('PURP eq ''SUPP'''))
  !collection.type('CLNLAT')
  !supportCollection   = !collection.results()

  -- If there is no Restraint element - no nothing
  if(!supportCollection.empty().not()) then
    if(!!accDeleteManager.deleteElement(!supportCollection.first()).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
      !this.tidy()
    endif
  endif
  -- if element is deleted then grey out button
  !supportCollection   = !collection.results()
  if(!supportCollection.empty()) then
    !this.mtDelSupport.active  = FALSE
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      onRemoveClicked
--
-- Description: Delete hanger/support from popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .onRemoveClicked(!deleteRef is DBREF, !elementList is GADGET)

   if(!!accDeleteManager.deleteElement(!deleteRef).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
   endif

  !this.listSelectionChanged(!elementList, 'SELECT')

endmethod

------------------------------------------------------------------------
