--
--
-- Description: Set the clnheight of Accommodation elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accClnHeight()                   -                   Constructor
--  close()                          -
--  draw()                           -                   Setup EDG pick event for picking position
--  elevwrt(DBREF)                   REAL
--  initialise()                     -
--  offset(EDGPOSITIONDATA)          -                   Map picked position to room offset
--  pickOffset()                     -                   Define EDG event to pick position
--  refreshConfig()                  -
--  setup(DBREF)                     BOOLEAN
--  tidy()                           -
--  update()                         -
--  updateElement()                  -
--  updateGadgets()                  -
--  updateWorldElevGadget()          -
--


 setup form !!accClnHeight

  !this.formTitle     = 'Ceiling Height'
  !this.iconTitle     = 'Ceiling Height'
  !this.callback      = '!this.initialise()'
  !this.quitcall      = '!this.tidy()'
  !this.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
  button .selectElement linkLabel 'Element:'              anchor top + left           at x0.5   ymin                    callback '!this.initialise()' width 6
  paragraph .namepara                                     anchor top + left + right   at xmax   ymin                                                  width 20 lines 1

  button .clnheightbtn linkLabel 'Pick Ceiling Height...' anchor top + left + right   at x0.5   ymax+0.2                callback '!this.pickOffset()' width 20

  -- clnheight of element with respect to owner
  text   .clnheightTxt    'Ceiling Height:'               anchor top + left + right   at x2     ymax                    callback '!this.update()'     width 15 is REAL format !!distanceFmt
  paragraph .wrtpara                        anchor top + left           at x2                 ymax+0.2          width 25
  paragraph .wrtworldtxt                    anchor top + left           at x2                 ymax+0.2          width 20
  path down
    toggle.cascade 'Cascade to ceiling'
  -- Apply button
   button .acceptBtn   'Accept'                           anchor top + left           at x0.5   ymax+0.2                callback '!this.updateElement()'width 5

  -- Dismiss Room
   button .discardBtn  'Dismiss'                          anchor top + right          at xmax.clnheightTxt-size    ymin callback '!this.close()'       width 5

  -- Form Members
  -- Current Element
  member .element         is DBREF

   -- clnheight Values
   member .accClnHeight   is REAL

  -- Plane of element
  member .plane           is PLANE

  -- Attribute data
  member .attributeData   is DBEATTRIBSEARCH

  member .aidNumber       is REAL

  member .owner           is DBREF

 exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accClnHeight
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .accClnHeight()

   !this.wrtworldtxt.val         = 'Elevation wrt World:   '
   !this.attributeData = object DBEATTRIBSEARCH(object DBREF() , 'ClnHeight' , object ARRAY())

  -- Get aid number
  !this.aidNumber   = !!aidNumbers.add('clnheight display')

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)



endmethod

------------------------------------------------------------------------
--
-- Method:initialise
--
-- Description:Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--  element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.setup(!!ce)

endmethod

------------------------------------------------------------------------
--
-- Method:  setup
--
-- Description: Setup form for passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if element is valid
--
------------------------------------------------------------------------

define method .setup(!passedElement is DBREF) is BOOLEAN

  !element         = !this.attributeData.element(!passedElement)

  if (!element.unset() ) then
      !!alert.warning('Element doesn''t have an Ceiling Height attribute.')
      return FALSE
  endif

  -- Element being modified
  !this.element = !element

 if (!this.element.type.eq('ROOM'))then
      !this.cascade.active = true
 else
       !this.cascade.active = false
 endif

 !owner                = !element.owner

 -- Owing element type
  !description          = !this.attributeData.description  & '  from  ' & !!accConfig.typeDescription(!owner.type)
  !this.wrtpara.val     = !description

  -- get the Ceiling Height value of the Element being modified
  !this.accClnHeight     = !element.clnheight

  -- Update input gadgets with values
  !this.namepara.val     = !element.flnn

  -- Update input gadgets
  !this.updateGadgets()

  -- Tag element
  !this.draw()

  -- Return
  return TRUE

endmethod

------------------------------------------------------------------------
--
-- Method:    update
--
-- Description: Sets the clnheight of the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- set Ceilingheight value
  !this.accClnHeight = !this.clnheightTxt.val
  !this.draw()
  !this.updateWorldElevGadget()
endmethod
------------------------------------------------------------------------
--
-- Method:    updateGadgets
--
-- Description: Update gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  -- Initialise Variables
  !this.clnheightTxt.val = !this.accClnHeight

  !this.updateWorldElevGadget()

  if (!!dbrefUpdatable(!this.element).not() )  then
      $P $!!error.text
      !this.acceptBtn.active = FALSE
  else
      !this.acceptBtn.active = TRUE
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      updateworldelevgadget
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateWorldElevGadget()

 -- update  gadgets  related to world
 !elevWorld         = !this.elevwrt(world)
 !this.wrtworldtxt.val = 'Elevation wrt World:   ' & !elevWorld.string()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:   elevwrt()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elevwrt(!relativeRef is DBREF) is REAL

  !position    = !this.element.position
  !position.up = !this.accClnHeight
  !position    = !position.wrt(!relativeRef )

  return !position.up

endmethod


------------------------------------------------------------------------
--
-- Method: close
--
-- Description: Close form  after clearing the aids
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()
 -- clear the aids
  !this.tidy()

  !this.hide()
endmethod
------------------------------------------------------------------------
--
-- Method: tidy
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()
  AID CLEAR ALL $!<this.aidNumber>
  handle ANY
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      updateelement
--
-- Description: Update element with modified values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateElement()

--mark for undo option
!clnheightMark = object UNDOABLE()
  !undoDesc = 'Modify Ceilingheight of $!this.namepara.val'

  !clnheightMark.description(!undoDesc)
  !clnheightMark.add()
--
if(!this.cascade.val) then

  !oldclnheight = !this.element.clnheight
  !this.element.clnheight   = !oldclnheight + (!this.accClnHeight - !oldclnheight)

      !collection = object collection()
      !collection.scope(room)
      !collection.type('ceiling')
      !newelement = !collection.results()

   if (!newelement.size() gt 1) then

     do !i value !newelement
        !this.element = !newelement[!i]
        -- Update Ceiling Height
        !oldclnheight = !this.element.clnheight
        !this.element.clnheight   = !oldclnheight + (!this.accClnHeight - !oldclnheight)
     enddo

   else
       !this.element = !newelement[1]
       -- Update Ceiling Height
       !oldclnheight = !this.element.clnheight
       !this.element.clnheight   = !oldclnheight + (!this.accClnHeight - !oldclnheight)
   endif
else

   !this.element.clnheight   = !this.accClnHeight

endif
--for undo option
  !clnheightMark.endundoable()
endmethod

------------------------------------------------------------------------
--
-- Method:      draw()
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draw()

  -- Remove aid graphics
  !this.tidy()

  !position       = !this.element.position
  !position.up    = !this.accClnHeight

  if(!this.accClnHeight.neq(0)) then
    AID ARROW NUMBER $!<this.aidNumber> at $!position DIRECTION U HEIGHT 1000mm
    AID TEXT  NUMBER $!<this.aidNumber> '$!this.accClnHeight'at $!position
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Define EDG event to pick position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- method not used  will be used in case any EDG pick is necessary
define method .pickOffset()

  -- Initialise Variables
  !prompt               = 'Pick Ceiling height position'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Modify Ceiling Height'
  !packet.remove        = true
  !packet.action        = '!!' & !this.name() & '.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to room offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

 !elePosition  = !this.element.position
 !pickPosition = !data.position.wrt(!elePosition.origin)

 !this.accClnHeight = !pickPosition.up

 -- draw the aids
 !this.draw()

  -- Update the gadgets
 !this.updateGadgets()

endmethod
-- End of method offset
-----------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  !description          = 'Relative to ' & !!accConfig.typeDescription(!this.owner.type)
  !this.wrtpara.val     = !description

endmethod

-- End of method
