--
--
-- Description:
-- Accommodation Configuration settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accConfigEdit()                  -                   Constructor
--  display()                        -
--  restoreConfig()                  -
--  updateConfig()                   -
--  updateposControl(STRING)         -
--


  -- Body of form definition

import 'PositionControl'
handle ANY
endhandle

setup form !!accConfigEdit  resizeable

  !this.formTitle     = 'Configuration'
  !this.iconTitle     = 'Configuration'
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.0 $ '

  !grid                       = object SHIPGRID()
  !gridDefined                = !grid.position.set()
  -- Body of form definition

  frame .mainFrame tabset  at x1 y1 anchor t+l+r width 1 hei 3
  -- Positioning Gadgets
     frame .elemDescFrame 'Alternate description' anchor t+l+r
       text .bblocktxt 'BBLOCK' at x1 ymax+0.5 width 25 Scroll 77 is STRING
       text .bleveltxt 'BLEVEL' at x1 ymax+0.5 width 25 Scroll 77 is STRING
       text .roomtxt   'ROOM  ' at x1 ymax+0.5 width 25 Scroll 77 is STRING
     exit

     frame .navigationFrame 'Navigation'
       toggle .columnExcelFilterTgl  'Allow column filtering  '  at x1 ymax+0.5
       toggle .outlookGroupStyleTgl  'Allow column grouping   '  at x1 ymax+0.5
       toggle .columnSummariesTgl    'Display column summaries'  at x1 ymax+0.5
       toggle .labelVisibilityTgl    'Display total row count '  at x1 ymax+0.5
     exit

  -- Only populate the grid data if a ship reference grid is available
  if(!gridDefined) then
     frame .positionFrame  'Position'
        frame .positionControl panel  at xmin ymax anchor t+l+r width 41 hei 5
          container .netPositionFrame PMLNetCONTROL 'NET' dock fill
        exit
     exit
  endif
  exit

  button    .applyButton   linklabel 'Apply'                   anchor l+t  at x3   ymax.mainFrame  callback |!this.updateConfig()|
  button    .restoreButton linklabel 'Restore System Defaults' anchor l+t  at xmax ymax.mainFrame  callback |!this.restoreConfig()|

  -- Form Members
  using namespace 'Aveva.Pdms.Presentation'

  if(!gridDefined) then
  -- PMLNet Position control
    member .posControl    is POSITIONCONTROL
  endif

  member .configuration is ACCCONFIG

exit

------------------------------------------------------------------------
--
-- Method:      .accConfigEdit()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accConfigEdit()



  !this.initcall   = '!this.display()'

  if ( defined (!this.posControl)  ) then
     !this.updateposControl(!this.configuration.positionFormat.upcase())
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateposControl(!positionFormat is STRING)


  !grid            = object SHIPGRID()

   ------------------Setup for position control-----------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  --Create new instance of position control
  !this.posControl            = object POSITIONCONTROL()

  -- Only populate the grid data if a ship reference grid is available


    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]

    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.posControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    --!this.posControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.posControl.heading('World Position')

    !this.posControl.gridFormat()

  !this.netPositionFrame.control = !this.posControl.handle()

  !currentPosition = !!ce.position
  handle (2,201)
   !currentPosition = E 0 N 0 U 0
  endhandle

  !easting    = !currentPosition.east
  !northing   = !currentPosition.north
  !elevation  = !currentPosition.up

  !this.posControl.xyz(!easting,!northing,!elevation)
 if (!positionFormat.eq('GRID') ) then
  !this.posControl.gridFormat()
 elseif (!positionFormat.eq('XYZ')) then
   !this.posControl.xyzFormat()
 else
  !this.posControl.enuFormat()
 endif



endmethod
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display()

  -- Display alternate descriptions
  !this.bblocktxt.val  = !this.configuration.bblock
  !this.bleveltxt.val  = !this.configuration.blevel
  !this.roomtxt.val    = !this.configuration.room

  --Display the navigation control objects
  !this.columnExcelFilterTgl.val = !this.configuration.navigator.columnExcelFilter
  !this.outlookGroupStyleTgl.val = !this.configuration.navigator.outlookGroupStyle
  !this.columnSummariesTgl.val   = !this.configuration.navigator.columnSummaries
  !this.labelVisibilityTgl.val   = !this.configuration.navigator.labelVisibility

  -- add pos control values
  --!posControlStr = '!this.' & !this.configuration.positionFormat & 'format'
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateConfig()

  -- Store alternate descriptions
    !this.configuration.bblock =   !this.bblocktxt.val
    !this.configuration.blevel =   !this.bleveltxt.val
    !this.configuration.room   =   !this.roomtxt.val

  --Store the navigation control objects
  !this.configuration.navigator.columnExcelFilter = !this.columnExcelFilterTgl.val
  !this.configuration.navigator.outlookGroupStyle = !this.outlookGroupStyleTgl.val
  !this.configuration.navigator.columnSummaries   = !this.columnSummariesTgl.val
  !this.configuration.navigator.labelVisibility   = !this.labelVisibilityTgl.val

  -- add pos control values Soma
  !this.configuration.positionFormat = !this.posControl.format()
  -- add an action to refresh the displayed forms

  -- store the information in a file
  !this.configuration.writeFile()


endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .restoreConfig()

 !this.configuration.setDefaults()
 !this.display()

endmethod
-- End of method
