--
--
-- Description:
--  Accommodation Configuration settings, used to maintain the global
--  configuration object for accommodation, !!accConfig
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accConfigSettings()              -                   Constructor
--  compressPane(GADGET)             ARRAY
--  discardChanges()                 -                   Restore Config settings
--  display()                        -
--  loadConfig()                     -
--  positionControl()                -
--  restoreConfig()                  -
--  setPositionFormat(STRING)        STRING
--  updateConfig()                   -
--


  -- Body of form definition

 import 'PositionControl'
handle ANY
endhandle

 setup form !!accConfigSettings dialog dock right

  !this.formTitle     = 'Room Design Configuration'
  !this.iconTitle     = 'Configuration'
  !this.callback      = '!this.loadConfig()'
  !this.formRevision  = ' $Revision: 1.0 $ '

 -- Body of form definition

  frame .mainFrame tabset  anchor all at x0 y0
                      --
  -- Positioning Gadgets
    frame .elemDescFrame 'Description'                                                      at x0.5               y1
      paragraph .altDescHelpPara1                         anchor left + right + top         at x0.5               ymax              width 30 lines 2
      paragraph .altDescHelpPara2                         anchor left + right + top         at x0.5               ymax              width 30 lines 1
      text .bblockTxt 'BBLOCK'   tagwidth 8               anchor left + right + top         at x2                 ymax+0.2          width 20 is STRING
      text .blevelTxt 'BLEVEL'   tagwidth 8               anchor left + right + top         at xmin               ymax+0.2          width 20 is STRING
      text .roomTxt   'ROOM  '   tagwidth 8               anchor left + right + top         at xmin               ymax+0.2          width 20 is STRING
    exit

    frame .navigationFrame 'Navigator'                                                      at x0.5               y1
      paragraph .naviHelpPara                             anchor left + right + top         at x0.5               ymax              width 30 lines 2
      toggle .columnExcelFilterTgl  'Allow column filtering'    anchor l + r + t            at x3                 ymax
      toggle .outlookGroupStyleTgl  'Allow column grouping '    anchor l + r + t            at xmin               ymax+0.2
      toggle .columnSummariesTgl    'Display column summaries'  anchor l + r + t            at xmin               ymax+0.2
      toggle .labelVisibilityTgl    'Display total row count'   anchor l + r + t            at xmin               ymax+0.2
    exit

    frame .positionFrame  'Positioning'                                                     at x0.5               y1
      paragraph .posiHelpPara                             anchor left + right + top         at x0.5               ymax              width 32 lines 2
      frame .positionControl panel                                                          at xmin               ymax              anchor t+l+r width 32 height 5
        container .netPositionFrame PMLNetCONTROL  'NET' dock fill
      exit
    exit

    frame .roomDfltsFrame  'Dimensional'                                                    at x0.5               y1
      paragraph .dimDefaultPara                           anchor left + right + top         at x0.5               ymax              width 30 lines 2

      -- Room attributes
      paragraph .roomAttributes                       anchor top + left + right             at xmin               ymax+0.5          text 'Room:' width 28 lines 1
      line .geomLine1                                 anchor top + left + right             at xmin               ymax              horizontal width 32
      text .dDoorSillTxt    'Door Sill Height'    tagwidth 13 anchor left + right + top     at x2                 ymax+0.5          width 14 is REAL format !!distancefmt
      text .dWindowSillTxt  'Window Sill Height'  tagwidth 13 anchor left + right + top     at xmin               ymax+0.2          width 14 is REAL format !!distancefmt


      text .flrHeightTxt    'Floor Height'        tagwidth 13 anchor left + right + top     at xmin               ymax+0.5          width 14 is REAL format !!distancefmt

      text .clnHeightTxt    'Ceiling Height '     tagwidth 13 anchor left + right + top     at xmin               ymax+0.5          width 14 is REAL format !!distancefmt

      -- Stair Well attributes
      paragraph .stairWellAttributes                  anchor top + left + right             at xmin               ymax+0.5          text 'Stair Well:' width 28 lines 1
      line .geomLine2                                 anchor top + left + right             at xmin               ymax              horizontal width 32
      text .headRoomTxt     'Head Room'           tagwidth 13 anchor left + right + top     at xmin               ymax+0.5          width 14 is REAL format !!distancefmt
      text .headClearTxt    'Head Clearance'      tagwidth 13 anchor left + right + top     at xmin               ymax+0.5          width 14 is REAL format !!distancefmt
      text .clearWidthTxt   'Clearance Width'     tagwidth 13 anchor left + right + top     at xmin               ymax+0.5          width 14 is REAL format !!distancefmt

    exit

    frame .roomInfoFrame  'Reference Lists'                                                 at x0.5               y1
      paragraph .refListsPara                             anchor left + right + top         at x0.5               ymax              width 30 lines 2
      path down
      vdist 0.5

      frame .colourSchCntrl    FoldUpPanel |Colour Schemes|   anchor left + right + top
        textpane .colourSchemesPane                           anchor left + right + top     at xmin               ymax            width 30 heig 8
      exit

      frame .fireRatingsCntrl  FoldUpPanel |Fire Ratings|     anchor left + right + top
        textpane .fireRatingsPane                             anchor left + right + top     at xmin               ymax            width 30 heig 8
      exit

      frame .hazardTypesCntrl  FoldUpPanel  |Hazard Types|    anchor left + right + top
        textpane .hazardTypesPane                             anchor left + right + top     at xmin               ymax            width 30 heig 8
      exit

      frame .ceilingCntrl FoldUpPanel |Ceiling Information|   anchor left + right + top
        textpane .ceilingCodesPane  'Codes'                   anchor left + top           at xmin               ymax            width 10 heig 8
        textpane .ceilingTypesPane  'Types'                   anchor left + right + top   at xmax               ymin            width 20 heig 8
      exit

      frame .floorCntrl  FoldUpPanel  |Floor Information|     anchor left + right + top
        textpane .floorCodesPane    'Codes'                   anchor left + top           at xmin               ymax            width 10 heig 8
        textpane .floorTypesPane    'Types'                   anchor left + right + top   at xmax               ymin            width 20 heig 8
      exit

    exit

    frame .roomLengthsFrame  'Default Lengths'                                                 at x0.5               y1
      paragraph .lenthsPara                             anchor left + right + top         at x0.5               ymax              width 30 lines 2
      path down
      vdist 0.5
      line .lengthLine1                                 anchor top + left + right             at xmin               ymax              horizontal width 32
      text .latticeProfile    'Lattice Profile'    tagwidth 13 anchor left + right + top     at x2                 ymax+0.5          width 14 is REAL format !!distancefmt
      text .panelProfile      'Panel Profile'    tagwidth 13 anchor left + right + top     at x2                 ymax+0.5          width 14 is REAL format !!distancefmt

    exit

  exit

  paragraph .applyPara                                         anchor l+b  at x0.5           ymax+0.5        pixmap width 16 height 16
  button    .applyButton   linklabel 'Apply Changes'           anchor l+b  at xmax+0.5       ymin            callback |!this.updateConfig()| width 10


  -- Discard Changes

  button .discardButton linkLabel 'Discard Changes'            anchor r+b  at xmax form-size ymin.applyPara      callback '!this.discardChanges()' width 10
  paragraph .discardPara                                       anchor r+b  at xmin-3         ymin                pixmap width 16 height 16

  button    .restoreButton linklabel 'Restore System Defaults' anchor l+b  at x0.5 ymax+0.5  callback |!this.restoreConfig()| width 15
  -- Form member
  using namespace 'Aveva.Pdms.Presentation'

  -- PMLNet Position control
  member .posControl    is POSITIONCONTROL

  -- Accommodation configuration object
  member .configuration is ACCCONFIG

  -- Grid format available (as object doesn't know whether a reference
  -- grid is available, the form has to handle this)
  member .gridFormat    is BOOLEAN

 exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accConfigSettings
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accConfigSettings()

  -- Define information text for the panes
  !this.altDescHelpPara1.val         = 'Alternative descriptions for major Accommodation elements displayed on the forms for the application'
  !this.altDescHelpPara2.val         = '(default if unset)'

  !this.naviHelpPara.val            = 'Extended column functionality for the element table in the Navigator form.'
  !this.posiHelpPara.val            = 'Default display format for positioning inputs.'
  !this.dimDefaultPara.val          = 'Dimensional defaults for accommodation elements.'
  !this.lenthsPara.val              = 'Default lengths for accommodation elements.'
  !this.refListsPara.val            = 'List of permissible text/descriptions used within accommodation application.'

  -- Collapse all fold up frames
  !this.colourSchCntrl.expanded     = FALSE
  !this.fireRatingsCntrl.expanded   = FALSE
  !this.hazardTypesCntrl.expanded   = FALSE
  !this.ceilingCntrl.expanded       = FALSE
  !this.floorCntrl.expanded         = FALSE

  -- Load positioning control
  !this.positionControl()

  --attach a pixmap to the Apply button
  !this.applyPara.addpixmap(!!pml.getpathname('accept.png'))
    !this.discardPara.addpixmap(!!pml.getpathname('discard.png'))

endmethod

-- End of method definition for accConfigSettings

------------------------------------------------------------------------
--
-- Method: loadConfig
--
-- Description: Load current config settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadConfig()

  -- Load config from global variable
  !this.configuration = !!accConfig

  -- Update gadgets with current values
  !this.display()

endmethod

-- End of method definition for accConfigSettings

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Display the current config values in the form Gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display()

  -- Display alternate descriptions
  !this.bblockTxt.val             = !this.configuration.bblock
  !this.blevelTxt.val             = !this.configuration.blevel
  !this.roomTxt.val               = !this.configuration.room

  --Display the navigation control objects
  !this.columnExcelFilterTgl.val  = !this.configuration.navigator.columnExcelFilter
  !this.outlookGroupStyleTgl.val  = !this.configuration.navigator.outlookGroupStyle
  !this.columnSummariesTgl.val    = !this.configuration.navigator.columnSummaries
  !this.labelVisibilityTgl.val    = !this.configuration.navigator.labelVisibility

  -- Set position control form to current settings
  !this.setPositionFormat(!this.configuration.positionFormat)

  -- Populate with reference position
  -- var !units units
  -- if(!units.part(3).matchwild('*INC*')) then
  --   !this.posControl.xyz(400in, 80in, 120in)
  -- else
  --   !this.posControl.xyz(10000mm, 2000mm, 3000mm)
  -- endif

  -- Set the position for current settings
  !dfltPos = ARRAY()
  !dfltPos[0] = !this.configuration.bpos[0]
  !dfltPos[1] = !this.configuration.bpos[1]
  !dfltPos[2] = !this.configuration.bpos[2]
  !this.posControl.xyz($!dfltPos[0],$!dfltPos[1],$!dfltPos[2])
  --!this.posControl.xyz(1000mm,1000mm,0mm)


  --Display the Room attribute values
  !this.dDoorSillTxt.val          =   !this.configuration.dDoorSill
  !this.dWindowSillTxt.val        =   !this.configuration.dWindowSill
  !this.flrHeightTxt.val          =   !this.configuration.flrHeight
  !this.clnHeightTxt.val          =   !this.configuration.clnHeight
  !this.headRoomTxt.val           =   !this.configuration.headRoom
  !this.headClearTxt.val          =   !this.configuration.headClear
  !this.clearWidthTxt.val         =   !this.configuration.clearWidth
  !this.latticeProfile.val        =   !this.configuration.latticeProfile
  !this.panelProfile.val          =   !this.configuration.panelProfile

  --Display the Room attribute values
  !this.colourSchemesPane.val     =   !this.configuration.colourSchemes
  !this.fireRatingsPane.val       =   !this.configuration.fireRatings
  !this.hazardTypesPane.val       =   !this.configuration.hazardTypes
  !this.ceilingCodesPane.val      =   !this.configuration.ceilingCodes
  !this.ceilingTypesPane.val      =   !this.configuration.ceilingTypes
  !this.floorCodesPane.val        =   !this.configuration.floorCodes
  !this.floorTypesPane.val        =   !this.configuration.floorTypes

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:  positionControl
--
-- Description: Load form with position control for the project
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionControl()

  -- Initialise Variables
  using namespace 'Aveva.Pdms.Presentation'

  --Create new instance of position control
  !this.posControl          = object POSITIONCONTROL()

  --Load ship grid data
  !grid                     = object SHIPGRID()
  !this.gridFormat          = !grid.position.set()

  -- Only populate the grid data if a ship reference grid is available
  if(!this.gridFormat) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.posControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    --!this.posControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
  else
    !this.posControl.gridVisible(false)
  endif

  -- Set position column heading
  !this.posControl.heading('World Position')

  !this.netPositionFrame.control = !this.posControl.handle()

endmethod
------------------------------------------------------------------------
--
-- Method:      setPositionFormat
--
-- Description: Sets the positioning control form to reflect the passed format
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPositionFormat(!passedFormat is STRING) is STRING

  -- Initialise Variables
  !format = !passedFormat.upcase()

  --# We need to check that if GRID is passed that the .gridFormat is
  --# available, if not, we revert to the standard ENU format and return it

  -- Set to XYZ format
  if(!format.eq('XYZ')) then
    !this.posControl.xyzFormat()

  -- Set to ENU format
  elseif (!format.eq('ENU')) then
    !this.posControl.enuFormat()

  -- Set to Grid format
  elseif (!format.eq('GRID')) then
    if (!this.gridFormat) then
        !this.posControl.gridFormat()
    else
         !this.posControl.enuFormat()
         !format = 'ENU'
    endif
  endif

  -- Return format
  return !format

endmethod

------------------------------------------------------------------------
--
-- Method: updateConfig
--
-- Description: update Config settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateConfig()

  -- Store alternate descriptions
  !this.configuration.bblock          =   !this.bblockTxt.val
  !this.configuration.blevel          =   !this.blevelTxt.val
  !this.configuration.room            =   !this.roomTxt.val

  -- Store the navigation control objects
  !this.configuration.navigator.columnExcelFilter = !this.columnExcelFilterTgl.val
  !this.configuration.navigator.outlookGroupStyle = !this.outlookGroupStyleTgl.val
  !this.configuration.navigator.columnSummaries   = !this.columnSummariesTgl.val
  !this.configuration.navigator.labelVisibility   = !this.labelVisibilityTgl.val

  -- storing the position control format
  !this.configuration.positionFormat  = !this.posControl.format()
  !this.configuration.bpos            = !this.posControl.xyz()

  !this.configuration.dDoorSill       = !this.dDoorSillTxt.val
  !this.configuration.dWindowSill     = !this.dWindowSillTxt.val
  !this.configuration.flrHeight       = !this.flrHeightTxt.val
  !this.configuration.clnHeight       = !this.clnHeightTxt.val
  !this.configuration.headRoom        = !this.headRoomTxt.val
  !this.configuration.headClear       = !this.headClearTxt.val
  !this.configuration.clearWidth      = !this.clearWidthTxt.val

  !this.configuration.colourSchemes   =  !this.compressPane(!this.colourSchemesPane)
  !this.configuration.fireRatings     =  !this.compressPane(!this.fireRatingsPane)
  !this.configuration.hazardTypes     =  !this.compressPane(!this.hazardTypesPane)
  !this.configuration.ceilingCodes    =  !this.compressPane(!this.ceilingCodesPane)
  !this.configuration.ceilingTypes    =  !this.compressPane(!this.ceilingTypesPane)
  !this.configuration.floorCodes      =  !this.compressPane(!this.floorCodesPane)
  !this.configuration.floorTypes      =  !this.compressPane(!this.floorTypesPane)

  !this.configuration.latticeProfile  = !this.latticeProfile.val
  !this.configuration.panelProfile    = !this.panelProfile.val

  !this.latticeProfile.val        =   !this.configuration.latticeProfile
  !this.panelProfile.val          =   !this.configuration.panelProfile

  -- Update config global variable
  !!accConfig = !this.configuration

  -- store the information in a file
  !!accConfig.writeFile()

  -- Run control update
  !!accControl.refresh(!this)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method: restoreConfig
--
-- Description: Restore Config settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .restoreConfig()

  --# The restore should really reload the global instance of the object,
  --# the configurable defaults of the system should really be held in a file
  --# the defaults of the system, should be held within the constructor
  --# methods of the object

  if (!!alert.confirm('Restore all Room Design configuration system defaults?')) eq 'NO' then

  else

    !!accConfig.setDefaults()
    !!accConfig.writeFile()
    !this.configuration = !!accConfig

    --  !this.configuration.setDefaults()
    !this.display()

  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method: discardChanges
--
-- Description: Restore Config settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .discardChanges()

  --# The restore should really reload the global instance of the object,
  --# the configurable defaults of the system should really be held in a file
  --# the defaults of the system, should be held within the constructor
  --# methods of the object

 !this.configuration = !!accConfig

--  !this.configuration.setDefaults()
 !this.display()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      compressPane
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .compressPane(!pane is GADGET) is ARRAY

  -- Initialise Variables
  !displayText  = !pane.val

  -- Remove duplicates from list
  !displayText.unique()

  -- Remove null entry
  !index        = !displayText.findFirst('')
  if(!index.set()) then
    !displayText.remove(!index)
  endif

  -- Remove "unset" entry
  !index        = !displayText.findFirst('unset')
  if(!index.set()) then
    !displayText.remove(!index)
  endif

  -- Update gadget and return information
  !pane.val     = !displayText
  return !displayText

endmethod
