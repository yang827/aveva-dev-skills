--
--
-- Description:
--   Form for showing list of elements and the error associated with them
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accContentNavigator()            -
--  collectContents(DBREF)           -
--  copy()                           -
--  create()                         -                   Show creation panel/for for selected element
--  delete()                         -                   Perform appropriate delete action for selected element
--  displayContents(ARRAY)           -
--  initialise()                     -                   Initialise form
--  listAll()                        -                   List all/direct contents
--  modify()                         -
--  popup(ARRAY)                     -                   Pop-up callback
--  popupMenus()                     -                   Setup popup menus.
--  refresh()                        -                   Refresh the list
--  select(ARRAY)                    -                   Select BBLOCK from grid
--

import 'GridControl'
handle any
endhandle

setup form !!accContentNavigator dialog docking right


  !this.formTitle     = 'Room Design Content Navigator'
  !this.iconTitle     = 'Room Design Content Navigator'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision$ '

  option  .listAll  'List'   tagwidth 3           anchor top + left           at x0.5                   ymax                callback '!this.listAll()' width 10
  paragraph .titlepara                            anchor top + left + right  at xmax+0.5               ymin                width 16 lines 1

  -- PML Container to host grid control for BBLOCKs
  frame .contentFrame panel            anchor all                             at x0.5                   ymax
    container .contents PMLNetCONTROL 'NET' dock fill
    list .contentDummy                 anchor all                             at x0.5                   y0.5                callback '' columns height 20 width 32
  exit

  -- Form members

  -- List of elements
  --member .elements          is ARRAY

  -- Selected element
  member .currentElement      is DBREF

  -- owning DETGRP
  member .currentOwner        is DBREF

  -- Grid control
  using namespace 'Aveva.Pdms.Presentation'
  member .contentGrid         is NETGRIDCONTROL

  -- Element contents
  member .allContents         is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      acccontentnavigator
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accContentNavigator()

  -- Initialise Variables
  !this.allContents       = true

  !display[1]             = 'all contents'
  !display[2]             = 'direct contents'
  !replace[1]             = 'all'
  !replace[2]             = 'direct'
  !this.listAll.dtext     = !display
  !this.listAll.rtext     = !replace

  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- Add .Net control to PML container for BBLOCKs
  !this.contentGrid       = object NETGRIDCONTROL()
  !this.contents.control  = !this.contentGrid.handle()

  -- Events handled
  !this.contentGrid.addEventHandler('onPopup',           !this, 'popup')
  !this.contentGrid.addEventHandler('afterSelectChange', !this, 'select')

  -- Load information from Configuration
  !this.contentGrid.columnExcelFilter(true)
  !this.contentGrid.outlookGroupStyle(true)
  !this.contentGrid.columnSummaries(FALSE)
  !this.contentGrid.fixedHeaders(false)
  !this.contentGrid.fixedRows(false)
  !this.contentGrid.singleRowSelection(true)

  -- Setup popup-menus
  !this.popupMenus()

    -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()
  if(!this.shown()) then
    !this.initialise()
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  !this.collectContents(!!accNavigator.currentElement)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      listAll
--
-- Description: List all/direct contents
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .listAll()

  -- Select
  if(!this.listAll.selection().eq('all')) then
    !this.allContents = true
  else
    !this.allContents = false
  endif

  -- Re-initialise form
  !this.initialise()

endmethod

------------------------------------------------------------------------
--
-- Method:      displayContents
--
-- Description: Display form with passed errors
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Form title
--    2   R      ARRAY       2D Array [1] Element [2] Message
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayContents(!elements is ARRAY)

  -- Headings
  !headings     = ARRAY()
  !headings.append('Name')
  !headings.append('Type')
  !headings.append('Description')
  if(!this.allContents) then
    !headings.append('Owner Type')
    !headings.append('Owner')
  endif

  -- Initialise Table
  !table = ARRAY()
  !tableEntry = ARRAY()

  -- Define table
  do !i values !elements
    !tableEntry[1] = !i.namn
    !tableEntry[2] = !i.fulltype
    !tableEntry[3] = !i.description
    if(!this.allContents) then
      !tableEntry[4] = !i.owner.owner.fulltype
      !tableEntry[5] = !i.owner.owner.namn
    endif

    !table.append(!tableEntry)
  enddo

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  --!nds                  = object NETDATASOURCE('BBlocks', !attributes, !dbNames)
  !nds            = object NETDATASOURCE('Errors', !headings, !table)
  !this.contentGrid.bindToDataSource(!nds)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      popupMenus
--
-- Description: Setup popup menus.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .popupMenus()

  -- Initialise Variables

  -- Popup Menus for errors Grid
  !popup = !this.newMenu('popupDefault')

  !popup.add('callback', 'Create',            '!this.create()',           'bblockCreate')
  !popup.add('callback', 'Modify',            '!this.modify()',           'bblockModify')
  --!popup.add('callback', 'Copy',              '!this.copy()',             'bblockCopy')
  !popup.add('separator')
  !popup.add('callback', 'Delete',            '!this.delete()',           'bblockDelete')

  !this.contents.popup   = !popup

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      popup
--
-- Description: Pop-up callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .popup(!a is ARRAY)

  -- make menu active if something to delete or modify
  if ( !this.currentOwner.mcount.gt(0) ) then
     !this.contents.popup.setActive ( 'Delete', true )
     !this.contents.popup.setActive ( 'Modify', true )
   else
     !this.contents.popup.setActive ( 'Delete', false )
     !this.contents.popup.setActive ( 'Modify', false )
   endif
  !this.contents.showPopup(!a[0], !a[1])
endmethod

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Show creation panel/for for selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create()
  !elementType = !this.currentElement.type
  handle ANY
    if ( !this.currentOwner.desc.upcase().match('WALL').gt(0) ) then
      !!accCreateElement('CTWALL', !this.currentOwner)
    elseif ( !this.currentOwner.desc.upcase().match('INFO').gt(0) ) then
      !!accCreateElement('INFITT', !this.currentOwner)
    elseif ( !this.currentOwner.desc.upcase().match('FLOOR').gt(0) ) then
      !!accCreateElement('FLRCOV', !this.currentOwner)
    elseif ( !this.currentOwner.desc.upcase().match('INSULATION').gt(0) ) then
      !!accCreateElement('INSURQ', !this.currentOwner)
    elseif ( !this.currentOwner.desc.upcase().match('CEILING').gt(0) ) then
      !!accCreateElement('CEILIN', !this.currentOwner)
    elseif ( !this.currentOwner.desc.upcase().match('FIXTURES').gt(0) ) then
      !!accCreateElement('FIXTUR', !this.currentOwner)
    elseif ( !this.currentOwner.desc.upcase().match('FURNITURE').gt(0) ) then
      !!accCreateElement('FURNIT', !this.currentOwner)
    elseif ( !this.currentOwner.desc.upcase().match('FIRE').gt(0) ) then
      !!accCreateElement('FPFITT', !this.currentOwner)
    elseif ( !this.currentOwner.desc.upcase().match('HVAC').gt(0) ) then
      !!accCreateElement('HVACFI', !this.currentOwner)
    elseif ( !this.currentOwner.desc.upcase().match('ELECTRICAL').gt(0) ) then
      !!accCreateElement('ELFITT', !this.currentOwner)
    else
      !!alert.error('No element selected')
    endif
  elsehandle NONE
    !elementOwn = !this.currentElement.own
    !!accCreateElement(!elementType, !elementOwn)
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      delete
--
-- Description: Perform appropriate delete action for selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .delete()

  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.currentElement).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  endif
  !this.refresh()
endmethod

------------------------------------------------------------------------
--
-- Method:      Modify
--
-- Description: Show modification panel/for for selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()
  !!accModifyElement(!this.currentElement)
endmethod

------------------------------------------------------------------------
--
-- Method:      Copy
--
-- Description: Perform appropriate copy action for selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copy()

  -- Display copy form
  !!accTaskManager.active('accCopyManager')

  -- Add selected element to copy manager
  !!copyManager.add(!this.currentElement)

endmethod

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select BBLOCK from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!dummyPassedArray is ARRAY)

  -- Initialise Variable
  !elementSelected               = !this.contentGrid.getSelectedRows()
		
  -- No Element selected
  if(!elementSelected.unset()) then
    !element          = object DBREF()

  -- Element in Content navigator list
  else

    !element               = object DBREF(!elementSelected[1][1])
    handle any
    	!element               = object DBREF('/' + !elementSelected[1][1])
    	handle (2,109)
    		!element        = object DBREF()
    	endhandle
    endhandle

  endif
    !this.currentElement    = !element

  -- Run control update
  !!accControl.refresh(!this)

endmethod

------------------------------------------------------------------------
--
-- Method:      collectContents
--
-- Description: Collect and display contents of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to collect from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .collectContents(!element is DBREF)

  !this.currentOwner    = !element
  -- Define collection object
  !collectObject            = object ACCCOLLECTCONTENTS()

  --  Set scope of scan
  if(!collectObject.scope(!element)) then

    -- Collect all contents
    if(!this.allContents) then
      !this.titlepara.val   = 'of ' & !element.namn & ' only'
      !elements             = !collectObject.collectAllContents()

    -- Collect only contents directly owned
    else
      !this.titlepara.val   = 'of ' & !element.namn
      !elements             = !collectObject.collectDirectContents()
    endif

    -- Display contents
    !this.displayContents(!elements)

  endif

endmethod
