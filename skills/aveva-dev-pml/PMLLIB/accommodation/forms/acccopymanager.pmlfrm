--
--
-- Description:
--    Copy manager for the accommodation application.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accCopyManager()                 -                   Constructor
--  copyXYZPane(BOOLEAN)             -                   Copy offset task pane
--  displayList()                    -                   Display elements
--  exampleWarning1()                -
--  graphicSelection()               -                   Load graphic selection into copy list
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  updateList()                     -                   Refresh copy list with copy data
--  warning(ARRAY,STRING)            -                   Set warning task and message with default "Continue"
--  warning(ARRAY,STRING,STRING)     -                   Set warning task and message
--  warningDone()                    -                   Exit warning
--

setup form !!accCopyManager dialog docking right

  !this.formTitle     = 'Copy Manager'
  !this.iconTitle     = 'Copy'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision$ '

  -- List of element in copy buffer.
  list .elementList 'Elements to copy'        anchor top + left + right         at x0                     y0                  columns width 30 lines 10
  path down
  halign right
  button .elementFilter 'Filter list' linkLabel anchor top + right                                                            width 5
  button .gphSelection  'Graphic selection' linklabel anchor top + left         at xmin.elementList       ymin                callback '!this.graphicSelection()'

  line .line                                  anchor top + left + right         at x0                     ymax                horizontal width 32

  -- Main Task Pane
  frame .mainTaskPane panel                   anchor all                        at xmin.elementList       ymax.elementFilter

    -- Header for task pane
    paragraph .mainTaskH1                     anchor top + left + right         at x0                     ymax                text 'Standard Copying Tasks'
    line .mainTaskL1                          anchor top + left + right         at x0                     ymax                horizontal width 32
    button .mainCopyXYZ     linkLabel 'Offset'                                  at x2                     ymax                callback '!this.copyXYZPane(true)' width 28
    button .mainCopyLiner   linkLabel 'Linear'                                  at x2                     ymax                callback '' width 28
    button .mainCopyRotate  linkLabel 'Rotate'                                  at x2                     ymax                callback '' width 28
    button .mainCopyMirror  linkLabel 'Mirror copy'                             at x2                     ymax                callback '' width 28

    paragraph .mainTaskH2                     anchor top + left + right         at x0                     ymax                width 32 lines 1
    line .mainTaskL2                          anchor top + left + right         at x0                     ymax                horizontal width 32
    button .mainBBPlace     linkLabel 'Placement'                               at x2                     ymax                callback '' width 28
    button .mainBBFloors    linkLabel 'Between floors'                          at x2                     ymax                callback '' width 28

  exit

  -- Copy XYZ Task Pane
  frame .copyXYZPane panel                    anchor all                        at xmin.elementList       ymax.elementFilter

     -- Header for task pane
    paragraph .copyXYZh1                      anchor top + left + right         at x0                     ymax                text 'Offset Copy'
    line .copyXYZL1                           anchor top + left + right         at x0                     ymax                horizontal width 32

    -- Number of copies
    numericinput .copyXYZnumber 'No Copies'   tagwidth 8 anchor top + left      at x3                     ymax+0.2            callback ''         range 1 100 ndp 0 width 4

    -- Offset information
    text .copyXYZx 'Offset X' tagwidth 6      anchor top + left + right         at x5                     ymax+0.2            width 20 is REAL format !!fmtDistance
    text .copyXYZy 'Y'                        anchor top + left + right                                                       width 20 is REAL format !!fmtDistance
    text .copyXYZz 'Z'                        anchor top + left + right                                                       width 20 is REAL format !!fmtDistance

    -- Preview copies
    path down
    halign right
    button .copyXYZpreview linkLabel 'Preview copies' anchor top + right                                                      callback '' width 9

    -- Apply Changes
    paragraph .copyApplyIcon                  anchor top + left                 at x0                     ymin                pixmap width 16 height 16
    button .copyApply   linkLabel 'Create copies' anchor top + left             at xmax+0.5               ymin                callback '' width 12



    paragraph .copyXYZMainIcon                anchor top + left                 at x0                     ymax+0.5            pixmap width 16 height 16
    button .copyXYZMain linkLabel 'Return to main tasks'                        at xmax+1                 ymin                callback '!this.mainTasks(true)'

  exit

  -- Warning Task Pane
  frame .warningPane panel                    anchor all                        at xmin.elementList       ymax.elementFilter

    paragraph .warningHeader                                                    at x0                     ymax                text 'Warning'
    line .warningLine                         anchor top + left + right         at x0                     ymax                horizontal width 32
    paragraph .warningIcon                    anchor left + top                 at x0.5                   ymax+0.2            pixmap width 32 heigh 32
    paragraph .warning                        anchor left + right + top         at xmax+2                 ymin                width 26 lines 6
    button    .warningDone linkLabel 'Continue' anchor left + top               at x0.5                   ymax                callback '!this.warningDone()' width 28

  exit

  -- Form members
  member .copyList        is ARRAY

  -- List of elements copied
  member .copiedList      is ARRAY

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK

  -- Warning action
  member .warningAction   is BLOCK

  -- Undo for form
  member .undo            is UNDOABLE

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accCopyManager
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accCopyManager()

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('$$p')

  -- Register form with config
  --!!accConfig.registerForm(!this)

  -- Register with copy manager
  !!copyManager.registerForm(!this, 'updateList')

  -- Initialise task panes
  !this.mainTasks(true)
  !this.copyXYZPane(false)
  !this.warningPane.visible     = false

  -- Set "Back" icon
  !backIcon                     = !!pml.getPathname('back.png')
  !this.copyXYZMainIcon.addPixmap(!backIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getPathname('accept.png')
  !this.copyApplyIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  --!discardIcon                  = !!pml.getPathname('discard.png')
  --!this.tlModDiscardIcon.addPixmap(!discardIcon)

  -- Set "Warning" icon
  !warningIcon                  = !!pml.getPathname('exclamation-32.png')
  !this.warningIcon.addPixmap(!warningIcon)

  -- Load information from Configuration
  !this.refreshConfig()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Headings
  !this.mainTaskH2.val          = 'Special ' & !!accConfig.typeDescription ( 'ROOM' ) & ' Copying Tasks'
  !this.mainBBFloors.tag        = 'Between ' & !!accConfig.typeDescription ( 'BLEVEL' )

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateList
--
-- Description: Refresh copy list with copy data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateList()

  -- Initialise Variables
  !this.copyList    = !!copyManager.elements()

  -- Display elements in form list
  !this.displayList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      displayList
--
-- Description: Display elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayList()

  -- Columns
  !exprRef              = object EXPRESSION()
  !exprRef.expression('FLNN')
  !columns[1]           = object COLUMN(!exprRef, false, false, 'Refno')
  !exprType             = object EXPRESSION()
  !exprType.attributeExpression('FULLTYPE')
  !columns[2]           = object COLUMN(!exprType, false, false, 'Type')

  -- Build Scan elements and list
  !table                = object TABLE()
  !table.columns(!columns)
  !table.primaryKey(!this.copyList)

  -- Evaluate table
  !table.evaluate()

  -- Output
  !headings[1]          = 'Name'
  !headings[2]          = 'Type'
  !this.elementList.setHeadings(!headings)
  !dataTable[1]         = !table.column('Refno')
  !dataTable[2]         = !table.column('Type')
  !this.elementList.setColumns(!dataTable)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      graphicSelection
--
-- Description: Load graphic selection into copy list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .graphicSelection()

  -- Get current graphic selection
  !selection  = object SELECTION()
  !selection.getCurrent()
  !!copyManager.add(!selection)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.mainTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.mainTasks(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Main Task Pane'

  endif

  -- Show/hide task pane
  !this.mainTaskPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copyXYZPane
--
-- Description: Copy offset task pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyXYZPane(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.copyXYZPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.copyXYZPane(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Copy Offset'

  -- Actions when task pane is made inactive
  else

  endif

  -- Show/hide task pane
  !this.copyXYZPane.visible   = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message with default "Continue"
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Done"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING)
  !this.warning(!message, !action, 'Continue')
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Continue"
--    3   R      STRING      "Continue" text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING, !continue is STRING)

  -- Switch warning pane
  !this.currentPane.visible   = false
  !this.warningPane.visible   = true

  -- Concatenate message into a single line
  !display    = ''
  do !i indices !message
    !display  = !display & ' ' & !message[!i]
  enddo

  -- Display message
  !this.warning.val           = !display.trim()
  !this.warningDone.tag       = !continue

  -- Set "Continue" action (If the action is dependent on other criteria
  -- e.g. being in the correct position in the hierarchy, then the
  -- active state of the "Done" button needs to be managed.
  !this.warningAction         = object BLOCK(!action)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warningDone
--
-- Description: Exit warning
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warningDone()

  -- Hide warning pane
  !this.warningPane.visible   = false

  -- Execute action
  !this.warningAction.evaluate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      exampleWarning
--
-- Description: Example of how to use a warning with an action
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exampleWarning1()

  -- Define message to be displayed
  !message[1] = 'This is the message that is to be displayed in the '
  !message[2] = 'warning pane. The message can be up to 132 Characters'
  !message[3] = 'long.'
  !this.warning(!message, '!this.firstTaskPane(true)', !this.ftpWarningMsg.val)

endmethod
-- End of method definition
