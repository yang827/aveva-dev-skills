------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickOffset()

  -- Initialise Variables
  !prompt               = 'Pick ' & !this.altText & ' origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        updateFrame
--
-- Description:   update the grid with room data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateFrame()

  if(!this.copyOptions.val.eq(1)) then

    -- populate list with standard rooms from assembly templates
    !this.frRoomAssemblies.visible  = true
    !this.frExistingRooms.visible   = false

    -- Define Grid control
    -- Grid name
    !gridName = ' '

    using namespace  'Aveva.Pdms.Presentation'

    !mainGridElements = object ARRAY()

    -- Collect application data world with purp ROOM
    !dataWorldCollection      = object COLLECTION()
    !dataWorldCollection.type(|APPLDW|)

    !expression = object EXPRESSION()
    !expressionText = ' purp eq |ROOM| '
    !expression.expression(!expressionText)
    !dataWorldCollection.filter(!expression)

    !appDataWorld = !dataWorldCollection.results()

    if(!appDataWorld.set()) then
      -- Collect room elements from assembly world
      !roomCollection      = object COLLECTION()
      !roomCollection.scope(!appDataWorld)
      !roomCollection.type(|ROOM|)
      !rooms = !roomCollection.results()
      if(!rooms.set()) then
        do !i indices !rooms
          -- Space Type (Room Category) from attribute Function
          !mainGridElements[!i][1]  = !rooms[!i].func

          -- Room Type (Class) from attribute ROOMTY/PE
          !mainGridElements[!i][2]  = !rooms[!i].roomty
          handle ANY
            -- attribute is not yet created
          endhandle

          -- Occupancy Type from attribute OCCTYPE
          !mainGridElements[!i][3]  = !rooms[!i].occType

          -- Name of the existing room
          !mainGridElements[!i][4]  = !rooms[!i].namn
        enddo
      endif
    endif

    !netMainDataSource = object NETDATASOURCE(!gridName, !this.gridHeadings, !mainGridElements)
    !this.netMainAssyGrid.bindToDataSource(!netMainDataSource)
    !this.netGridRoomAssemblies.control = !this.netMainAssyGrid.handle()

    !this.netMainAssyGrid.addEventHandler('AfterSelectChange', !this, 'createFromAssemblies')

    !this.netMainAssyGrid.columnExcelFilter(true)
    !this.netMainAssyGrid.outlookGroupStyle(false)
    !this.netMainAssyGrid.fixedHeaders(true)
    !this.netMainAssyGrid.fixedRows(false)
    !this.netMainAssyGrid.gridHeight(100.0)
    !this.netMainAssyGrid.singleRowSelection(true)

  elseif(!this.copyOptions.val.eq(2)) then

    -- populate list with standard rooms from existing rooms
    !this.frRoomAssemblies.visible  = false
    !this.frExistingRooms.visible   = true

    -- Grid name
    !gridName = ' '

    using namespace  'Aveva.Pdms.Presentation'
    -- create instance of .net control
    !this.netMainGridExistingRooms = object NETGRIDCONTROL()

    !mainGridElements2  = object ARRAY()

    -- Collect application data world with purp ROOM
    !collection      = object COLLECTION()
    !collection.type( |ROOM| )

    !expression = object EXPRESSION()
    !expressionText = '( type of owner eq |BLEVEL| )'
    !expression.expression(!expressionText)
    !collection.filter(!expression)

    !rooms = !collection.results()
    if(!rooms.set()) then
       do !i indices !rooms
         -- Space Type (Room Category) from attribute Function
         !mainGridElements2[!i][1]  = !rooms[!i].func

         -- Room Type (Class) from attribute ROOMTY/PE
         !mainGridElements2[!i][2]  = !rooms[!i].roomty
         handle ANY
           -- attribute is not yet created
         endhandle

         -- Occupancy Type from attribute OCCTYPE
         !mainGridElements2[!i][3]  = !rooms[!i].occType

         -- Name of the existing room
         !mainGridElements2[!i][4]  = !rooms[!i].namn
       enddo
    endif

    !netMainDataSource2 = object NETDATASOURCE(!gridName, !this.gridHeadings, !mainGridElements2)
    !this.netMainGridExistingRooms.bindToDataSource(!netMainDataSource2)
    !this.netGridExistingRooms.control = !this.netMainGridExistingRooms.handle()

    !this.netMainGridExistingRooms.addEventHandler('AfterSelectChange', !this, 'createFromExistingRooms')

    !this.netMainGridExistingRooms.columnExcelFilter(true)
    !this.netMainGridExistingRooms.outlookGroupStyle(false)
    !this.netMainGridExistingRooms.fixedHeaders(true)
    !this.netMainGridExistingRooms.fixedRows(false)
    !this.netMainGridExistingRooms.gridHeight(100.0)
    !this.netMainGridExistingRooms.singleRowSelection(true)

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      selectRoomType
--
-- Description: Display room type selection form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectRoomType()

  -- Define form if required
  if(undefined(!!accRoomTypes)) then
    pml reload form !!accRoomTypes
  endif

  -- Setup form
  !action = '!!' & !this.name() & '.setRoomType(!function, !roomType, !occType, !colSchema, !fireRating, !dClnCode, !dClnType, !dFlrCode, !dFlrType)'
  !!accRoomTypes.setup(!this.definition.function, !this.definition.roomType, !this.definition.occType, !this.definition.colSchema, !this.definition.fireRating, !this.definition.dClnCode, !this.definition.dClnType, !this.definition.dFlrCode, !this.definition.dFlrType, !action)
  show !!accRoomTypes

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setRoomType
--
-- Description: Display room type selection form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setRoomType(!function is STRING, !roomType is STRING, !occType is STRING, !colSchema is STRING, !fireRating is STRING, !dClnCode is STRING, !dClnType is STRING, !dFlrCode is STRING, !dFlrType is STRING)

  -- Define form if required
  !this.definition.function = !function
  !this.definition.roomType = !roomType
  !this.definition.occType  = !occType

  if(!this.colSchema.dtext.findFirst(!colSchema).set()) then
    !this.definition.colSchema    = !colSchema
  endif

  if(!this.fireRating.dtext.findFirst(!fireRating).set()) then
    !this.definition.fireRating    = !fireRating
  endif

  if(!this.dClnType.dtext.findFirst(!dClnType).set()) then
    !this.definition.dClnType    = !dClnType
  endif

  if(!this.dClnCode.dtext.findFirst(!dClnCode).set()) then
    !this.definition.dClnCode   = !dClnCode
  endif

  if(!this.dFlrType.dtext.findFirst(!dFlrType).set()) then
    !this.definition.dFlrType    = !dFlrType
  endif

  if(!this.dFlrCode.dtext.findFirst(!dFlrCode).set()) then
    !this.definition.dFlrCode    = !dFlrCode
  endif

  -- Set description to be same as occupancy type, can then be modified by user
  !this.definition.description = !occType

  -- Update Room Type
  !this.updateRoomTypeAttributes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateRoomTypeAttributes
--
-- Description: Update room type gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRoomTypeAttributes()

  if(!this.definition.function.set()) then
    !this.dbFunction.val  = !this.definition.function
  else
    !this.dbFunction.val  = 'unset'
  endif

  if(!this.definition.roomType.set()) then
    !this.dbRoomType.val  = !this.definition.roomType
  else
    !this.dbRoomType.val  = 'unset'
  endif

  if(!this.definition.occType.set()) then
    !this.dbOccType.val   = !this.definition.occType
  else
    !this.dbOccType.val   = 'unset'
  endif

  if(!this.definition.colSchema.set()) then
    if(!this.colSchema.dtext.findFirst(!this.definition.colSchema).set()) then
      !this.colSchema.val    = !this.definition.colSchema
    endif
  endif

  if(!this.definition.fireRating.set()) then
    if(!this.fireRating.dtext.findFirst(!this.definition.fireRating).set()) then
      !this.fireRating.val    = !this.definition.fireRating
    endif
  endif

  if(!this.definition.dClnType.set()) then
    if(!this.dClnType.dtext.findFirst(!this.definition.dClnType).set()) then
      !this.dClnType.val    = !this.definition.dClnType
    endif
  endif

  if(!this.definition.dClnCode.set()) then
    if(!this.dClnCode.dtext.findFirst(!this.definition.dClnCode).set()) then
      !this.dClnCode.val    = !this.definition.dClnCode
    endif
  endif

  if(!this.definition.dFlrType.set()) then
    if(!this.dFlrType.dtext.findFirst(!this.definition.dFlrType).set()) then
      !this.dFlrType.val    = !this.definition.dFlrType
    endif
  endif

  if(!this.definition.dFlrCode.set()) then
    if(!this.dFlrCode.dtext.findFirst(!this.definition.dFlrCode).set()) then
      !this.dFlrCode.val    = !this.definition.dFlrCode
    endif
  endif

  !this.dbDescription.val = !this.definition.description

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:          validateTextGadgets
--
-- Description:     validate the value entered in the text gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateTextGadgets(!gadget is GADGET, !oldValue is REAL )

  if(!gadget.val.unset()) then
    !gadget.val = !oldValue
    !gadget.refresh()

  elseif(!gadget.name().match('HEIGHT').gt(0)) then
    if(!gadget.val.lt(0)) then
      !tag  = !gadget.tag.replace(':','')
      !!alert.error('$!tag cannot be less than zero')
      !gadget.val = !oldValue
      !gadget.refresh()
      return
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
