--
--
-- Description:
--    Form to create standard rooms copying from Assembly and existing rooms
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accCreStdRoom()                  -                   Constructor
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  create()                         -                   Create element
--  createFromAssemblies(ARRAY)      -                   main grid callback
--  createFromExistingRooms(ARRAY)   -                   main grid callback
--  elevation()                      -                   Set elevation of level
--  getAttributes(DBREF)             -
--  nAngle(GADGET,STRING)            -                   Set orientation of ROOM with respect to BLEVEL element
--  offset()                         -                   Set xy offset of element
--  offset(EDGPOSITIONDATA)          -                   Map picked position to room offset
--  pickOffset()                     -                   Setup EDG pick event for picking position
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  selectRoomType()                 -                   Display room type selection form
--  setRoomType(STRING,STRING,STRING,STRING,STRING,STRING,STRING,STRING,STRING) -                   Display room type selection form
--  setup()                          -                   Set up form
--  updateData()                     -                   Update current data with gadget values
--  updateFrame()                    -
--  updateGadgets()                  -                   Update gadgets with object data
--  updateRoomTypeAttributes()       -                   Update room type gadgets with object data
--  validateTextGadgets(GADGET,REAL) -
--

import 'GridControl'
handle any
endhandle

setup form !!accCreStdRoom dialog docking right

  !this.formTitle     = 'Create Standard Room'
  !this.iconTitle     = 'StdRoom'
  !this.callback      = '!this.setup()'
  !this.formRevision  = ' $Revision$ '
  !this.cancelCall   = '!this.definition.tidy()'

  -- frame for selecting the copy option
  frame     .copyOptions    'Copy Room from '                                  at x0         ymin+0.2                                      width 34
   rtoggle  .copyFromTmpl    |Assembly|                          anchor T+L    at x1.5       ymax         states '' 'ASSEMBLY'
   rtoggle  .copyExisting    |Existing Room|                     anchor T+L    at x15        ymin         states '' 'EXISTING'
  exit

  -- Room creation/modification pane
  frame         .editPane             panel                      anchor T+L    at x0         ymax+0.2

    -- Start of net grid frame
    frame       .frRoomAssemblies     panel                      anchor T+L    at x0         y0
      para      .paAssembly                                                    at x0         y0             text 'Select Assembly'          width 32
      line      .lnAssembly                                                    at x0         ymax-0.2       HORIZONTAL                      width 34
      -- PML Container to host .net control
      container .netGridRoomAssemblies NOBOX PMLNetControl 'NET'               at x0         ymax                                           width 34 hei 8
    exit
    -- End of net grid frame

    -- Start of net grid frame
    frame       .frExistingRooms            panel                anchor T+L    at x0         y0
      para      .paExistingRooms                                               at x0         y0             text 'Select Pre-defined Room'  width 32
      line      .lnExistingRooms                                               at x0         ymax-0.2       HORIZONTAL                      width 34
      -- PML Container to host .net control
      container .netGridExistingRooms NOBOX PMLNetControl 'NET'                at x0         ymax                                           width 34 hei 8
    exit
    -- End of net grid frame

    -- Gadgetry definition for creation
    text         .dbName  'Name:'                   tagwidth 9   anchor T+L    at x2         ymax+0.2                                       width 20 is STRING
    path down
    halign right
    text         .dbDescription 'Description:'      tagwidth 9   anchor T+L                                                                 width 20 is STRING
    numericinput .dbNumber      'Number:'           tagwidth 9   anchor T+L    at xmin       ymax+0.2       range 0 10000 ndp 0             width 4

    -- Room Type
    button    .roomTypeSelect linkLabel 'Room Type...'           anchor T+L    at x0.5       ymax+0.2       callback '!this.selectRoomType()'
    line      .editLine1a                                        anchor T+L    at xmin       ymax           HORIZONTAL                        width 32
    paragraph .dbFunctionTag                                     anchor T+L    at x2         ymax+0.2                                         width  9 lines 1
    paragraph .dbFunction                                        anchor T+L    at xmax       ymin                                             width 20 lines 1
    paragraph .dbRoomTypeTag                                     anchor T+L    at x2         ymax                                             width  9 lines 1
    paragraph .dbRoomType                                        anchor T+L    at xmax       ymin                                             width 20 lines 1
    paragraph .dbOccTypeTag                                      anchor T+L    at x2         ymax                                             width  9 lines 1
    paragraph .dbOccType                                         anchor T+L    at xmax       ymin                                             width 20 lines 1

    -- Positioning
    paragraph .location                                          anchor T+L    at x0.5       ymax+0.2       text 'Location:'                  width 28 lines 1
    line      .editLine2                                         anchor T+L    at xmin       ymax           HORIZONTAL                        width 32

    -- Angle from Y axis
    numericinput .nAngle 'Angle from BLEVEL Y axis:' tagwidth 23  anchor T+L    at x2         ymax+0.2       callback '!this.nAngle('  range 180 -180 ndp 0 width 4

    -- Floor height
    text .flrHeight 'Floor height:'                 tagwidth 11  anchor T+L    at x2         ymax+0.5       callback '!this.elevation()' width 14  is REAL format !!distanceFmt
    path down
    halign right
    -- Ceiling height
    text .clnHeight 'Ceiling height:'               tagwidth 11  anchor T+L                                 width 14  is REAL format !!distanceFmt

    -- XY Offset of floor from building origin
    button  .offset linkLabel 'ROOM Offset'                      anchor T+L    at x2         ymax+0.2       callback '!this.pickOffset()' width 20
    text    .xOffset   'X:'                                      anchor T+L    at xmin+4     ymax           callback '!this.offset()' width 21 is REAL format !!distanceFmt
    text    .yOffset   'Y:'                                      anchor T+L    at xmin       ymax+0.2       callback '!this.offset()' width 21 is REAL format !!distanceFmt

    -- Defaults
    frame .criteria foldUpPanel 'Design Criteria'                anchor T+L    at x0         ymax+0.5       width 32

      -- Occupancy
      paragraph .occupancyTag                                    anchor T+L    at x0.5       ymax           width 20 lines 1

      numericinput .occupancy 'Number:'             tagwidth 8   anchor T+L    at xmin       ymax+0.2       range 0 1000 ndp 0 width 6

      -- Colour scheme
      combo .colSchema 'Colour Schema:'             tagwidth 11  anchor T+L    at x0.5       ymax+0.5       width 13

      -- Lighting
      text .lighting 'Lighting:'                    tagwidth 11  anchor T+L    at x0.5       ymax+0.5       width 13 is REAL
      -- Air change rate
      text .airChangeRate 'Air change rate:'        tagwidth 11  anchor T+L    at x0.5       ymax+0.5       width 13 is REAL
      -- Fire rating
      combo .fireRating 'Fire rating:'              tagwidth 11  anchor T+L    at x0.5       ymax+0.5       width 13

    exit

    -- Environment Information
    frame .environment foldUpPanel 'Environment Settings'        anchor T+L    at x0         ymax+0.5       width 32

      paragraph .ambTag                                          anchor T+L    at x11.5      ymax           text 'Design'
      paragraph .maxTag                                          anchor T+L    at xmax+1.5   ymin           text 'Min'
      paragraph .minTag                                          anchor T+L    at xmax+3     ymin           text 'Max '

      text .temperature 'Temperature:'              tagwidth 10  anchor T+L    at x1         ymax-0.1       width 5 is REAL format !!integerFmt
      text .minTemp                                              anchor T+L    at xmax+0.5   ymin           width 5 is REAL format !!integerFmt
      text .maxTemp                                              anchor T+L    at xmax+0.5   ymin           width 5 is REAL format !!integerFmt

      text .pressure 'Pressure:'                    tagwidth 10  anchor T+L    at x1         ymax+0.2       width 5 is REAL format !!realFmt
      text .minPressure                                          anchor T+L    at xmax+0.5   ymin           width 5 is REAL format !!realFmt
      text .maxPressure                                          anchor T+L    at xmax+0.5   ymin           width 5 is REAL format !!realFmt

      text .humidity 'Humidity:'                    tagwidth 10  anchor T+L    at x1         ymax+0.2       width 5 is REAL format !!realFmt
      text .minHumidity                                          anchor T+L    at xmax+0.5   ymin           width 5 is REAL format !!realFmt
      text .maxHumidity                                          anchor T+L    at xmax+0.5   ymin           width 5 is REAL format !!realFmt

      paragraph .waterTag                                        anchor T+L    at x1         ymax+0.2       text 'Water Depth'
      text      .maxWater                                        anchor T+L    at x24        ymin           width 5 is REAL format !!realFmt

      toggle .waterTight 'ROOM is water tight'      tagwidth 24  anchor T+L    at x4         ymax+0.5
      toggle .gasTight   'ROOM is gas tight'        tagwidth 24  anchor T+L    at xmin       ymax
    exit

    -- Defaults
    frame   .defaults foldUpPanel 'Defaults'                     anchor T+L    at x0         ymax+0.5       width 32

      text  .dDoorSill 'Door Sill above Floor:'     tagwidth 17  anchor T+L    at x1         ymax           width 11 is REAL format !!distanceFmt
      text  .dWinSill  'Window Sill above Floor:'   tagwidth 17  anchor T+L    at xmin       ymax+0.2       width 11 is REAL format !!distanceFmt

      combo .dClnType 'Ceiling Type:'               tagwidth 10  anchor T+L    at xmin       ymax+0.5       width 13
      combo .dClnCode 'Ceiling Code:'               tagwidth 10  anchor T+L    at xmin       ymax+0.2       width 13

      combo .dFlrType 'Floor Type:'                 tagwidth 10  anchor T+L    at xmin       ymax+0.5       width 13
      combo .dFlrCode 'Floor Code:'                 tagwidth 10  anchor T+L    at xmin       ymax+0.2       width 13

    exit

    -- Create Room
    paragraph .crtAcceptIcon                                     anchor T+L    at x0         ymax+0.5       pixmap width 16 height 16
    button    .crtAccept linkLabel 'Create'                      anchor T+L    at xmax+0.5   ymin+0.1       callback '!this.create()' width 12

  exit

  -- Warning Task Pane
  frame       .warningPane panel                                 anchor T+L    at x0         y0

    paragraph .warningHeader                                                   at x0         ymax           text 'Warning'
    line      .warningLine                                       anchor T+L    at x0         ymax           horizontal width 32
    paragraph .warningIcon                                       anchor T+L    at x0.5       ymax+0.2       pixmap width 32 heigh 32
    paragraph .warning                                           anchor T+L    at xmax+2     ymin           width 26 lines 6
    button    .warningDone linkLabel 'Continue'                  anchor T+L    at x0.5       ymax           callback '!this.warningDone()' width 28

  exit

  -- Form Members

  -- Alternative text for element type
  member .altText         is STRING

  -- Owning element
  member .owner           is DBEBLEVEL
  member .owningElement   is DBREF

  -- Current Element(Room)
  member .element         is DBREF
  member .baseElement     is DBREF
  member .definition      is DBEROOM

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK

  -- Warning action
  member .warningAction   is BLOCK

  -- Undo for form
  member .undo            is UNDOABLE

  -- EDG Description
  member .edgDescription  is STRING

  -- Aid Numbers
  member .aidAxes         is REAL
  member .outerBoundary   is REAL
  member .innerBoundaries is REAL

  -- .net Grid control object
  using namespace 'Aveva.Pdms.Presentation'
  member .netMainAssyGrid             is NETGRIDCONTROL
  member .netMainGridExistingRooms    is NETGRIDCONTROL

  member  .gridHeadings   is ARRAY

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accCreStdRoom
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accCreStdRoom()

  -- Set form to auto scroll
  !this.autoScroll              = true

  -- callbacks to the gadgets
  -- Copy option callback
  !this.copyOptions.callback = '!this.updateFrame()'
  -- Name validation callback
  !this.dbName.callback      =  '!this.checkName(!this.dbName, !this.definition.name)'

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!this.dummy()')

  -- Collapse fold up panels
  !this.defaults.expanded       = false
  !this.criteria.expanded       = false
  !this.environment.expanded    = false

  -- Set events for numeric gadgets
  !this.nAngle.modifiedEvents   = true

  -- Load information from Configuration
  !this.refreshConfig()

  -- Initialise task panes
  !this.warningPane.visible     = false

  !this.frExistingRooms.visible = false

  -- Create Icons
  !createIcon                   = !!pml.getPathName('create.png')
  !this.crtAcceptIcon.addPixmap(!createIcon)

  -- Set "Warning" icon
  !warningIcon                    = !!pml.getPathName('exclamation-32.png')
  !this.warningIcon.addPixmap(!warningIcon)

  -- EDG Description
  !this.edgDescription    = 'Accommodation Room Definition'

  -- validate the text gadgets
  !this.flrHeight.validateCall     = '!this.validateTextGadgets(!this.flrHeight,!this.definition.flrHeight)'
  !this.clnHeight.validateCall     = '!this.validateTextGadgets(!this.clnHeight,!this.definition.clnHeight)'
  !this.xOffset.validateCall       = '!this.validateTextGadgets(!this.xOffset,!this.definition.xyOffset[1])'
  !this.yOffset.validateCall       = '!this.validateTextGadgets(!this.yOffset,!this.definition.xyOffset[2])'
  !this.lighting.validateCall      = '!this.validateTextGadgets(!this.lighting,!this.definition.lighting)'
  !this.airChangeRate.validateCall = '!this.validateTextGadgets(!this.airChangeRate,!this.definition.airChangeRate)'
  !this.dDoorSill.validateCall     = '!this.validateTextGadgets(!this.dDoorSill,!this.definition.dDoorSill)'
  !this.dWinSill.validateCall      = '!this.validateTextGadgets(!this.dWinSill,!this.definition.dWinSill)'

  !this.temperature.validateCall   = '!this.validateTextGadgets(!this.temperature,!this.definition.temperature)'
  !this.minTemp.validateCall       = '!this.validateTextGadgets(!this.minTemp,!this.definition.minTemp)'
  !this.maxTemp.validateCall       = '!this.validateTextGadgets(!this.maxTemp,!this.definition.maxTemp)'

  !this.pressure.validateCall      = '!this.validateTextGadgets(!this.pressure,!this.definition.pressure)'
  !this.minPressure.validateCall   = '!this.validateTextGadgets(!this.minPressure,!this.definition.minPressure)'
  !this.maxPressure.validateCall   = '!this.validateTextGadgets(!this.maxPressure,!this.definition.maxPressure)'

  !this.humidity.validateCall      = '!this.validateTextGadgets(!this.humidity,!this.definition.humidity)'
  !this.minHumidity.validateCall   = '!this.validateTextGadgets(!this.minHumidity,!this.definition.minHumidity)'
  !this.maxHumidity.validateCall   = '!this.validateTextGadgets(!this.maxHumidity,!this.definition.maxHumidity)'

  !this.maxWater.validateCall      = '!this.validateTextGadgets(!this.maxWater,!this.definition.maxWater)'

  -- Assign aid numbers for form
  !this.aidAxes           = !!aidNumbers.add('Room Definition - Axes')
  !this.outerBoundary     = !!aidNumbers.add('Room Definition - OuterBoundary')
  !this.innerBoundaries   = !!aidNumbers.add('Room Definition - InnerBoundaries')

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Define Grid control
  -- Grid name
  !gridName = ' '

  -- Headings for Grid Columns
  !this.gridHeadings = ARRAY()
  !this.gridHeadings.append('Space Type')
  !this.gridHeadings.append('Room Type')
  !this.gridHeadings.append('Occupancy Type')
  !this.gridHeadings.append('Name')

  using namespace  'Aveva.Pdms.Presentation'

  -- create instance of .net control
  !this.netMainAssyGrid = object NETGRIDCONTROL()

  !mainGridElements  = object ARRAY()
  !netMainDataSource = object NETDATASOURCE(!gridName, !this.gridHeadings, !mainGridElements)
  !this.netMainAssyGrid.bindToDataSource(!netMainDataSource)
  !this.netGridRoomAssemblies.control = !this.netMainAssyGrid.handle()

  -- Populate combo with defaults
  !this.colSchema.dtext   = !!accConfig.colourSchemes()
  !this.fireRating.dtext  = !!accConfig.fireRatings()
  !this.dClnType.dtext    = !!accConfig.ceilingTypes()
  !this.dClnCode.dtext    = !!accConfig.ceilingCodes()
  !this.dFlrType.dtext    = !!accConfig.floorTypes()
  !this.dFlrCode.dtext    = !!accConfig.floorCodes()

  -- initialise the gadgets with the default values
  !this.updateGadgets()

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Set form members for when form title changes in other methods
  !this.altText                 = !!accConfig.typeDescription ( 'ROOM' )

  -- Replacement Text (set using configuration information)
  !roomRText                    = !this.altText
  !levelRText                   = !!accConfig.typeDescription ( 'BLEVEL' )

  -- Room Editing Tags
  !this.nAngle.tag              = 'Angle from ' & !levelRText & ' Y axis:'
  !this.offset.tag              = !roomRText & ' Offset...'

  !this.occupancyTag.val        = !roomRText & ' Occupancy:'

  !this.waterTight.tag          = ' ' & !roomRText & ' is water tight'
  !this.gasTight.tag            = ' ' & !roomRText & ' is gas tight'

  -- Room Create tags
  !this.crtAccept.tag           = 'Create ' & !roomRText

  -- Room Type Tags
  !this.dbFunctionTag.val       = 'Function:'
  !this.dbRoomTypeTag.val       = 'Room Type:'
  !this.dbOccTypeTag.val        = 'Occupancy:'

  --update the Combo boxes as well
  !this.colSchema.dtext   = !!accConfig.colourSchemes()
  !this.fireRating.dtext  = !!accConfig.fireRatings()
  !this.dClnType.dtext    = !!accConfig.ceilingTypes()
  !this.dClnCode.dtext    = !!accConfig.ceilingCodes()
  !this.dFlrType.dtext    = !!accConfig.floorTypes()
  !this.dFlrCode.dtext    = !!accConfig.floorCodes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Set up form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  if(!!accNavigator.blevel().badref())then
    !!alert.warning('The active Floor Elevation Element in Room Design Navigator may be deleted or not selected. Can not create room.')
    return
  endif

  !this.owner          = object DBEBLEVEL(!!accNavigator.blevel())
  !this.owningElement  = !!accNavigator.blevel()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createFromAssemblies
--
-- Description: create standard room from assemblies
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createFromAssemblies(!dummy is ARRAY)

  !selectedRow = !this.netMainAssyGrid.getSelectedRows()
  if(!selectedRow.unset()) then
    return
  endif
  !baseElementName = !selectedRow[1][4]

  if(!baseElementName.substring(1,1).eq('=')) then
    !this.baseElement  = object DBREF(!baseElementName)
  else
    !this.baseElement  = object DBREF('/' + !baseElementName)
  endif

  !this.owner                 = object DBEBLEVEL(!!accNavigator.blevel())
  !this.definition.dbeRoom()
  !this.definition.dbElement  = !this.baseElement

  -- Get attributes from the assembly room element
  !this.getAttributes(!this.baseElement)

  -- set the gadget values with the assembly room element attributes
  !this.updateGadgets()

  -- Frame of reference
  !this.definition.wrt             = !this.owner.dbElement
  !this.definition.plane           = object PLANE(!this.definition.wrt.position, !this.definition.wrt.orientation)
  !this.definition.referencePlane  = object PLANE(!this.definition.wrt.position, !this.definition.wrt.orientation)

  -- Boundary Line Information
  -- Get first BNDLIN of the ROOM
  !boundary           = !!dtbMemberOfType(!this.baseElement,'BNDLIN',1)

  if(!boundary.set()) then
    !this.definition.roomare     = !boundary.bndare
    !this.definition.outline     = object DBEBNDLIN(!boundary)
    !this.definition.outerLoop   = !this.definition.outline.outerLoop
    !this.definition.innerLoops  = !this.definition.outline.innerLoops
  endif

  !this.definition.nAngle(!this.nAngle.val)

  -- Element plane
  !this.definition.position(!this.definition.xyOffset, !this.definition.flrHeight)

  -- Volume Information
  -- if area reference is set record it
  if(!this.definition.dbElement.areaRef.set()) then
    !this.definition.areaRef   = !this.definition.dbElement.areaRef
  endif

  !this.definition.roomvol     = !this.definition.dbElement.nvol

endmethod
--End of method definition .createFromAssemblies()

---------------------------------------------------------------------------
--
-- Method:      createFromExistingRooms
--
-- Description: create standard room from existing room
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createFromExistingRooms(!dummy is ARRAY)

  !selectedRow = !this.netMainGridExistingRooms.getSelectedRows()
  if(!selectedRow.unset()) then
    return
  endif

  !name = !selectedRow[1][4]
  if(!name.substring(1,1).eq('=')) then
    !this.baseElement  = object DBREF(!name)
  else
    !this.baseElement  = object DBREF('/' + !name)
  endif

  !this.owner                 = object DBEBLEVEL(!!accNavigator.blevel())
  !this.definition.dbeRoom()
  !this.definition.dbElement  = !this.baseElement

  -- Get attributes from the assembly room element
  !this.getAttributes(!this.baseElement)

  -- set the gadget values with the assembly room element attributes
  !this.updateGadgets()

  -- Frame of reference
  !this.definition.wrt             = !this.owner.dbElement
  !this.definition.plane           = object PLANE(!this.definition.wrt.position, !this.definition.wrt.orientation)
  !this.definition.referencePlane  = object PLANE(!this.definition.wrt.position, !this.definition.wrt.orientation)

  -- Boundary Line Information
  -- Get first BNDLIN of the ROOM
  !boundary           = !!dtbMemberOfType(!this.baseElement,'BNDLIN',1)

  if(!boundary.set()) then
    !this.definition.roomare     = !boundary.bndare
    !this.definition.outline     = object DBEBNDLIN(!boundary)
    !this.definition.outerLoop   = !this.definition.outline.outerLoop
    !this.definition.innerLoops  = !this.definition.outline.innerLoops
  endif

  !this.definition.nAngle(!this.nAngle.val)

  -- Element plane
  !this.definition.position(!this.definition.xyOffset, !this.definition.flrHeight)

  -- Volume Information
  -- if area reference is set record it
  if(!this.definition.dbElement.areaRef.set()) then
    !this.definition.areaRef   = !this.definition.dbElement.areaRef
  endif

  !this.definition.roomvol     = !this.definition.dbElement.nvol

endmethod
--End of method definition .createFromExistingRooms()

---------------------------------------------------------------------------
--
-- Method:        getAttributes
--
-- Description:   gets attributes of the passed element and set to the object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getAttributes(!element is DBREF )

  -- Get attributes of the assembly room element
  !this.definition.description   = !element.description
  !this.definition.function      = !element.function
  !this.definition.roomType      = !element.roomType
  !this.definition.occType       = !element.occType

  !this.definition.purpose       = !element.purpose
  !this.definition.number        = !element.number
  !this.definition.area          = !element.area
  !this.definition.nAngle        = !element.nAngle
  !this.definition.flrHeight     = !element.flrHeight
  !this.definition.xyOffset      = !element.xyOffset
  !this.definition.labOff        = !element.labOff
  !this.definition.clnHeight     = !element.clnHeight

  -- Design Criteria
  !this.definition.colSchema     = !element.colSchema
  !this.definition.fireRating    = !element.fireRating
  !this.definition.lighting      = !element.lighting
  !this.definition.occupancy     = !element.occupancy
  !this.definition.maxArea       = !element.maxArea
  !this.definition.minArea       = !element.minArea
  !this.definition.maxVolume     = !element.maxVolume
  !this.definition.minVolume     = !element.minVolume
  !this.definition.airChangeRate = !element.airChangeRate

  -- Environment
  !this.definition.temperature   = !element.temperature
  !this.definition.maxTemp       = !element.maxTemp
  !this.definition.minTemp       = !element.minTemp
  !this.definition.pressure      = !element.pressure
  !this.definition.maxPressure   = !element.maxPressure
  !this.definition.minPressure   = !element.minPressure
  !this.definition.humidity      = !element.humidity
  !this.definition.maxHumidity   = !element.maxHumidity
  !this.definition.minHumidity   = !element.minHumidity
  !this.definition.gasTight      = !element.gasTight
  !this.definition.waterTight    = !element.waterTight
  !this.definition.maxWater      = !element.maxWater

  -- Defaults
  !this.definition.defaultHeight = !element.heiDefault
  !this.definition.dClnCode      = !element.dClnCode
  !this.definition.dClnType      = !element.dClnType
  !this.definition.dDoorSill     = !element.dDoorSill
  !this.definition.dWinSill      = !element.dWinSill
  !this.definition.dFlrCode      = !element.dFlrCode
  !this.definition.dFlrType      = !element.dFlrType

endmethod
-- End of method definition

------------------------------------------------------------------------

--
-- Method:      updateGadgets
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  -- Set values of gadgets from Room object
  --!this.dbName.val        = !this.definition.name
  !this.dbDescription.val = !this.definition.description
  !this.dbNumber.val      = !this.definition.number

  -- set room type attributes (Function, room type and occupancy type)
  !this.updateRoomTypeAttributes()

  !this.nAngle.val        = !this.definition.nAngle
  !this.xOffset.val       = !this.definition.xyOffset[1]
  !this.yOffset.val       = !this.definition.xyOffset[2]

  !this.flrHeight.val     = !this.definition.flrHeight
  !this.clnHeight.val     = !this.definition.clnHeight

  !this.occupancy.val     = !this.definition.occupancy

  if(!this.definition.colSchema.set()) then
    if(!this.colSchema.dtext.findFirst(!this.definition.colSchema).set()) then
      !this.colSchema.val    = !this.definition.colSchema
    endif
  endif

  !this.lighting.val      = !this.definition.lighting
  !this.airChangeRate.val = !this.definition.airChangeRate

  if(!this.definition.fireRating.set()) then
    if(!this.fireRating.dtext.findFirst(!this.definition.fireRating).set()) then
      !this.fireRating.val    = !this.definition.fireRating
    endif
  endif

  !this.temperature.val   = !this.definition.temperature
  !this.minTemp.val       = !this.definition.minTemp
  !this.maxTemp.val       = !this.definition.maxTemp
  !this.pressure.val      = !this.definition.pressure
  !this.minPressure.val   = !this.definition.minPressure
  !this.maxPressure.val   = !this.definition.maxPressure
  !this.humidity.val      = !this.definition.humidity
  !this.minHumidity.val   = !this.definition.minHumidity
  !this.maxHumidity.val   = !this.definition.maxHumidity
  !this.maxWater.val      = !this.definition.maxWater
  !this.waterTight.val    = !this.definition.waterTight
  !this.gasTight.val      = !this.definition.gasTight
  !this.dDoorSill.val     = !this.definition.dDoorSill
  !this.dWinSill.val      = !this.definition.dWinSill

  if(!this.definition.dClnType.set()) then
    if(!this.dClnType.dtext.findFirst(!this.definition.dClnType).set()) then
      !this.dClnType.val    = !this.definition.dClnType
    endif
  endif

  if(!this.definition.dClnCode.set()) then
    if(!this.dClnCode.dtext.findFirst(!this.definition.dClnCode).set()) then
      !this.dClnCode.val    = !this.definition.dClnCode
    endif
  endif

  if(!this.definition.dFlrType.set()) then
    if(!this.dFlrType.dtext.findFirst(!this.definition.dFlrType).set()) then
      !this.dFlrType.val    = !this.definition.dFlrType
    endif
  endif

  if(!this.definition.dFlrCode.set()) then
    if(!this.dFlrCode.dtext.findFirst(!this.definition.dFlrCode).set()) then
      !this.dFlrCode.val    = !this.definition.dFlrCode
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateData
--
-- Description: Update current data with gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateData()

  -- Initialise Variables
  if(!this.dbName.val.set()) then
    !this.definition.name         = !this.dbName.val
  endif

  !this.definition.description    = !this.dbDescription.val
  !this.definition.number         = !this.dbNumber.val

  !this.definition.function       = !this.dbFunction.val
  !this.definition.roomType       = !this.dbRoomType.val
  !this.definition.occType        = !this.dbOccType.val

  !this.definition.flrHeight      = !this.flrHeight.val
  !this.definition.clnHeight      = !this.clnHeight.val
  !this.definition.occupancy      = !this.occupancy.val
  !this.definition.colSchema      = !this.colSchema.displaytext()
  !this.definition.lighting       = !this.lighting.val
  !this.definition.airChangeRate  = !this.airChangeRate.val
  !this.definition.fireRating     = !this.fireRating.displaytext()
  !this.definition.temperature    = !this.temperature.val
  !this.definition.minTemp        = !this.minTemp.val
  !this.definition.maxTemp        = !this.maxTemp.val
  !this.definition.pressure       = !this.pressure.val
  !this.definition.minPressure    = !this.minPressure.val
  !this.definition.maxPressure    = !this.maxPressure.val
  !this.definition.humidity       = !this.humidity.val
  !this.definition.minHumidity    = !this.minHumidity.val
  !this.definition.maxHumidity    = !this.maxHumidity.val
  !this.definition.maxWater       = !this.maxWater.val
  !this.definition.waterTight     = !this.waterTight.val
  !this.definition.gasTight       = !this.gasTight.val
  !this.definition.dDoorSill      = !this.dDoorSill.val
  !this.definition.dWinSill       = !this.dWinSill.val
  !this.definition.dClnType       = !this.dClnType.displaytext()
  !this.definition.dClnCode       = !this.dClnCode.displaytext()
  !this.definition.dFlrType       = !this.dFlrType.displaytext()
  !this.definition.dFlrCode       = !this.dFlrCode.displaytext()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create()

  -- Reference Element
  !reference  = !!ce

  if(!!accNavigator.blevel().badref())then
    !!alert.warning('The active Floor Elevation Element in Room Design Navigator may be deleted or not selected. Can not create room.')
    return
  endif
 	!roomDesignExist   = object MDRLICENCEMANAGER()
  !status = !roomDesignExist.getLicence('ROOMDESIGN')
  !error = !roomDesignExist.lastError()
  if (!status lt 0) then
  	!!alert.error('$!error')
  	return
 	else

  if(!this.owningElement.unset()) then
    !this.owner          = object DBEBLEVEL(!!accNavigator.blevel())
    !this.owningElement  = !!accNavigator.blevel()
  endif

  -- Navigate to Level
  !!ce                  = !this.owningElement

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created ' & !this.altText)
  !this.undo.add()

  if( !this.copyOptions.val.eq(1) ) then
    if(!this.netMainAssyGrid.getSelectedRows().unset()) then
      !!alert.warning('Select a Standard Room to be copied from Assembly')
      return
    else
      NEW ROOM COPY $!<this.baseElement>
      handle ANY
        !!alert.warning(!!error.text)
        return
      endhandle
    endif

  elseif( !this.copyOptions.val.eq(2) ) then
    if(!this.netMainGridExistingRooms.getSelectedRows().unset()) then
      !!alert.warning('Select a Room to be copied from Existing Room list')
      return
    else
      NEW ROOM COPY $!<this.baseElement>
      handle ANY
        !!alert.warning(!!error.text)
        return
      endhandle
    endif
  endif

  !this.element = !!ce

  -- Update Block Attributes
  !this.updateData()

  -- Update element data
  !this.definition.dbElement = !!ce

  -- Refresh navigator, this should be handled by the navigator itself
  !!accNavigator.reloadRooms(!this.element)

  !this.definition.modify()
  -- hide this form and switch to Room modify form
  !this.hide()
  !this.definition.tidy()

  -- Switch to modify pane
  !!accModifyElement(!this.element)

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Return to original element
  !!ce        = !reference
  handle ANY
  endhandle
endif
endmethod
-- End of method

