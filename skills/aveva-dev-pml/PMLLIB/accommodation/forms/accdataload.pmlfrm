--
-- Description:
--   For for loading in multiple accommodation elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accDataLoad()                    -                   Constructor
--  change(ARRAY)                    -                   Change
--  csvTable(FILE,ARRAY)             ARRAY               Load CSV file into a table
--  elementName(DBREF,STRING)        STRING              Return usable name from passed string
--  emptyRow(ARRAY)                  ARRAY               Empty row of attributes
--  headings(ARRAY)                  ARRAY               Get the heading descriptions from the attributes
--  initialise()                     -
--  initialise(STRING)               -                   Initialise form with passed type
--  initialiseBBlock()               -                   Initialise BBlock
--  initialiseBLevel()               -                   Initialise BLevel
--  initialiseRoom()                 -                   Initialise Room
--  insertBBlockRow()                -                   Insert new entry in to BBlock list
--  insertBLevelRow()                -                   Insert new entry in to BLevel list
--  loadBBlockCSV(STRING)            -                   Load BBlock CSV file
--  loadBLevelCSV(STRING)            -                   Load BLevel CSV file
--  loadRoomCSV()                    -                   Load Room CSV file
--  navigateBBlock()                 -                   Navigate to selected bblock
--  popupBBlock(ARRAY)               -                   Pop-up callback for BBlocks
--  popupBLevel(ARRAY)               -                   Pop-up callback for BLevels
--  select(ARRAY)                    -                   Select
--  setupBBlock(BOOLEAN)             -                   Setup form for BBLOCK data loading
--  setupBLevel(BOOLEAN)             -                   Setup form for BLEVEL data loading
--  setupRoom(BOOLEAN)               -                   Setup form for ROOM data loading
--  test()                           -                   Test object
--  update(ARRAY)                    -                   Update
--  updateBBlocks()                  -                   Update DB with BBlocks
--  updateBLevels()                  -                   Update DB with BBlocks
--  updateDB(STRING,ARRAY,ARRAY,ARRAY,ARRAY,DBREF) -                   Update DB with table
--  updateRooms()                    -                   Update DB with Rooms
--  verifyBBlockData()               -                   Verifies the data in the grid against the database
--  verifyBLevelData()               -                   Verifies the data in the grid against the database
--  verifyRoomData()                 -                   Verifies the data in the grid against the database
--

import 'GridControl'
handle any
endhandle

setup form !!accDataLoad document

  -- Setup accommodation configuration (should be in the initialisation of
  -- the application, rather than in a form definition)
  !!accConfig()

  -- Replacement Texts for Element types
  member .bblockRText is STRING
  member .blevelRText is STRING
  member .roomRText   is STRING

  -- Replacement Text (needs to be set using configuration information)
  !this.bblockRText             = !!accConfig.typeDescription ( 'BBLOCK' )
  !this.blevelRText             = !!accConfig.typeDescription ( 'BLEVEL' )
  !this.roomRText               = !!accConfig.typeDescription ( 'ROOM' )

  !this.formTitle     = 'Loader'
  !this.iconTitle     = 'Loader'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision$ '


  -- PML Container to host grid control for BBLOCKs
  frame .bBlockFrame panel            anchor all                    at x0.5                     ymax
    container .bblocks PMLNetCONTROL 'NET' dock fill
    list .bBlockDummy                 anchor all                    at x0.5                     y0.5                callback '' columns height 20 width 36
  exit

  -- PML Container to host grid control for BLEVELs
  frame .blevelFrame panel            anchor all                    at x0.5                     ymin
    container .blevels PMLNetCONTROL 'NET' dock fill
    list .blevelDummy                 anchor all                    at x0.5                     y0.5                callback '' columns height 20 width 36
  exit

  -- PML Container to host grid control for ROOMs
  frame .roomFrame panel              anchor all                    at x0.5                     ymin
    container .rooms   PMLNetCONTROL 'NET' dock fill
    list .bRoomDummy                  anchor all                    at x0.5                     y0.5                callback '' columns height 20 width 36
  exit

  -- Form members

  -- Current active elements
  member .bblock            is DBREF
  member .blevel            is DBREF
  member .room              is DBREF

  -- Setup Type BBLOCK, BLEVEL or ROOM
  member .setupType         is STRING

  -- Current Task
  member .currentTask       is BLOCK

  -- Grid data headings
  member .bblockHeadings    is ARRAY
  member .blevelHeadings    is ARRAY
  member .roomHeadings      is ARRAY

  -- Grid attribute information
  member .bblockAttributes  is ARRAY
  member .bblockAttTypes    is ARRAY
  member .blevelAttributes  is ARRAY
  member .blevelAttTypes    is ARRAY
  member .roomAttributes    is ARRAY
  member .roomAttTypes      is ARRAY

  -- Table Data
  member .bblockTable       is ARRAY
  member .blevelTable       is ARRAY
  member .roomTable         is ARRAY

  -- Undo for creation
  member .undo              is UNDOABLE

  -- Grid control
  using namespace 'Aveva.Pdms.Presentation'
  member .bblockGrid        is NETGRIDCONTROL
  member .blevelGrid        is NETGRIDCONTROL
  member .roomGrid          is NETGRIDCONTROL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accDataLoad
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accDataLoad()

  -- Initialise Variables
  !this.setupType             = 'BBLOCK'
  !this.maximised             = true

  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  ----------------------------------------------------------------------
  -- Add .Net control to PML container for BBLOCKs
  !this.bblockGrid            = object NETGRIDCONTROL()
  !this.bblocks.control       = !this.bblockGrid.handle()

  -- Events handled
  !this.bblockGrid.addEventHandler('onPopup', !this, 'popupBBlock')
  !this.bblockGrid.addEventHandler('afterSelectChange', !this, 'select')
  !this.bblockGrid.addEventHandler('beforeCellUpdate', !this, 'update')
  !this.bblockGrid.addEventHandler('afterCellUpdate', !this, 'change')

  -- Control configuration
  !this.bblockGrid.columnExcelFilter(false)
  !this.bblockGrid.outlookGroupStyle(false)
  !this.bblockGrid.fixedHeaders(false)
  !this.bblockGrid.fixedRows(true)
  !this.bblockGrid.outlookGroupStyle(false)
  !this.bblockGrid.columnSummaries(false)
  !this.bblockGrid.singleRowSelection(true)
  !this.bblockGrid.editableGrid(true)

  -- BBlock Attribute Data
  !this.bblockAttributes.append('NAME')
  !this.bblockAttTypes.append('NAME')
  !this.bblockAttributes.append('DESC')
  !this.bblockAttTypes.append('STRING')
  !this.bblockAttributes.append('AREA')
  !this.bblockAttTypes.append('INTEGER')
  !this.bblockAttributes.append('NUMBER')
  !this.bblockAttTypes.append('INTEGER')
  !this.bblockAttributes.append('FUNCTION')
  !this.bblockAttTypes.append('STRING')
  !this.bblockAttributes.append('PURPOSE')
  !this.bblockAttTypes.append('WORD')

  !this.bblockHeadings  = !this.headings(!this.bblockAttributes)

  -- BBlock Initialise
  !this.initialiseBBlock()

  -- Input masks for Area, Number and Purpose
  !this.bblockGrid.setColumnMask(3, 'nnnn')
  !this.bblockGrid.setColumnMask(4, 'nnnn')
  !this.bblockGrid.setColumnMask(6, '>aaaa')

  ----------------------------------------------------------------------
  -- Add .Net control to PML container for BBLOCKs
  !this.blevelGrid            = object NETGRIDCONTROL()
  !this.blevels.control       = !this.blevelGrid.handle()

  -- Events handled
  !this.blevelGrid.addEventHandler('onPopup', !this, 'popupBLevel')
  !this.blevelGrid.addEventHandler('afterSelectChange', !this, 'select')
  !this.blevelGrid.addEventHandler('beforeCellUpdate', !this, 'update')
  !this.blevelGrid.addEventHandler('afterCellUpdate', !this, 'change')

  -- Control configuration
  !this.blevelGrid.columnExcelFilter(false)
  !this.blevelGrid.outlookGroupStyle(false)
  !this.blevelGrid.fixedHeaders(false)
  !this.blevelGrid.fixedRows(true)
  !this.blevelGrid.outlookGroupStyle(false)
  !this.blevelGrid.columnSummaries(false)
  !this.blevelGrid.singleRowSelection(true)
  !this.blevelGrid.editableGrid(true)

  -- Blevel Attribute Data
  !this.blevelAttributes.append('NAME')
  !this.blevelAttTypes.append('NAME')
  !this.blevelAttributes.append('DESC')
  !this.blevelAttTypes.append('STRING')
  !this.blevelAttributes.append('ELEVATION')
  !this.blevelAttTypes.append('DISTANCE')
  !this.blevelAttributes.append('AREA')
  !this.blevelAttTypes.append('INTEGER')
  !this.blevelAttributes.append('NUMBER')
  !this.blevelAttTypes.append('INTEGER')
  !this.blevelAttributes.append('FUNCTION')
  !this.blevelAttTypes.append('STRING')
  !this.blevelAttributes.append('PURPOSE')
  !this.blevelAttTypes.append('WORD')
  !this.blevelAttributes.append('DFLRHEIGHT')
  !this.blevelAttTypes.append('DISTANCE')
  !this.blevelAttributes.append('DCLNHEIGHT')
  !this.blevelAttTypes.append('DISTANCE')

  !this.blevelHeadings  = !this.headings(!this.blevelAttributes)

  -- BLevel Initialise
  !this.initialiseBLevel()

  -- Input masks for Area, Number and Purpose
  !this.blevelGrid.setColumnMask(4, 'nnnn')
  !this.blevelGrid.setColumnMask(5, 'nnnn')
  !this.blevelGrid.setColumnMask(7, '>aaaa')

  ----------------------------------------------------------------------
  -- Add .Net control to PML container for BBLOCKs
  !this.roomGrid              = object NETGRIDCONTROL()
  !this.rooms.control       = !this.roomGrid.handle()

  -- Events handled
  !this.roomGrid.addEventHandler('onPopup', !this, 'popupRoom')
  !this.roomGrid.addEventHandler('afterSelectChange', !this, 'select')
  !this.roomGrid.addEventHandler('beforeCellUpdate', !this, 'update')
  !this.roomGrid.addEventHandler('afterCellUpdate', !this, 'change')

  -- Control configuration
  !this.roomGrid.columnExcelFilter(false)
  !this.roomGrid.outlookGroupStyle(false)
  !this.roomGrid.fixedHeaders(false)
  !this.roomGrid.fixedRows(true)
  !this.roomGrid.outlookGroupStyle(false)
  !this.roomGrid.columnSummaries(false)
  !this.roomGrid.singleRowSelection(true)
  !this.roomGrid.editableGrid(true)

  -- Room Attribute Data
  !this.roomAttributes.append('NAME')
  !this.roomAttTypes.append('NAME')
  !this.roomAttributes.append('DESC')
  !this.roomAttTypes.append('STRING')
  !this.roomAttributes.append('FUNCTION')
  !this.roomAttTypes.append('STRING')
  !this.roomAttributes.append('PURPOSE')
  !this.roomAttTypes.append('WORD')
  !this.roomAttributes.append('AREA')
  !this.roomAttTypes.append('INTEGER')
  !this.roomAttributes.append('NUMBER')
  !this.roomAttTypes.append('INTEGER')
  !this.roomAttributes.append('OCCTYPE')
  !this.roomAttTypes.append('STRING')
  !this.roomAttributes.append('COLSCHEMA')
  !this.roomAttTypes.append('STRING')
  !this.roomAttributes.append('OCCUPANCY')
  !this.roomAttTypes.append('INTEGER')
  !this.roomAttributes.append('FIRERATING')
  !this.roomAttTypes.append('STRING')
  !this.roomAttributes.append('FLRHEIGHT')
  !this.roomAttTypes.append('REAL')
  !this.roomAttributes.append('CLNHEIGHT')
  !this.roomAttTypes.append('REAL')

  !this.roomHeadings    = !this.headings(!this.roomAttributes)

  -- Room Initialise
  !this.initialiseRoom()

  -- Input masks for Area, Number and Purpose
  !this.roomGrid.setColumnMask(5, 'nnnn')
  !this.roomGrid.setColumnMask(6, 'nnnn')
  !this.roomGrid.setColumnMask(4, '>aaaa')
  !this.roomGrid.setColumnMask(9, 'nnnn')

  -- Define permissible list of occupancy types
  -- This should be loaded from the defaults system

  -- Popup Menus for BBLCOK Grid
  !popup                = !this.newMenu('popupBBlock')
  !popup.add('callback', 'Insert',          '!this.insertBBlockRow()',  'BBlockInsert')
  !popup.add('callback', 'Remove',          '!this.removeBBlockRow()',  'BBlockRemove')
  !popup.add('callback', 'Clear',           '!this.initialiseBBlock()', 'BBlockInitialise')
  !popup.add('separator')
  !popup.add('callback', 'Locate in Tree',  '!this.navigateBBlock()',   'BBlockCE')
  !this.bblocks.popup   = !popup

  -- Popup Menus for BBLCOK Grid
  !popup                = !this.newMenu('popupBLevel')
  !popup.add('callback', 'Insert',          '!this.insertBLevelRow()',  'BLevelInsert')
  !popup.add('callback', 'Remove',          '!this.removeBLevelRow()',  'BLevelRemove')
  !popup.add('callback', 'Clear',           '!this.initialiseBLevel()', 'BLevelInitialise')
  !popup.add('separator')
  !popup.add('callback', 'Locate in Tree',  '!this.navigateBLevel()',   'BLevelCE')
  !this.blevels.popup   = !popup

  -- Popup Menus for ROOM Grid
  !popup                = !this.newMenu('popupRoom')
  !popup.add('callback', 'Insert',          '!this.insertRoomRow()',  'RoomInsert')
  !popup.add('callback', 'Remove',          '!this.removeRoomRow()',  'RoomRemove')
  !popup.add('callback', 'Clear',           '!this.initialiseRoom()', 'RoomInitialise')
  !popup.add('separator')
  !popup.add('callback', 'Locate in Tree',  '!this.navigateRoom()',   'RoomCE')
  !this.blevels.popup   = !popup

  -- Panel Management
  !this.currentTask         = object BLOCK('!this.test()')
  !this.setupBBlock(true)
  !this.blevelFrame.visible = false
  !this.roomFrame.visible   = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      headings
--
-- Description: Get the heading descriptions from the attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .headings(!attributes is ARRAY) is ARRAY

  -- Initialise Variables
  !headings = ARRAY()

  do !i indices !attributes
    var !attdef ATTDEF $!<attributes[$!<i>]> QTXT
    !headings[!i] = !attdef[1]
  enddo

  return !headings

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadBBlockCSV
--
-- Description: Load BBlock CSV file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadBBlockCSV(!fileName is STRING)

  -- Initialise Variables
  !headings     = !this.bblockHeadings
  --!file         = object FILE('%PDMSUSER%\buildings.csv')
  !file         = object FILE(!fileName)

  -- Get CSV data as table
  !table        = !this.csvTable(!file, !headings)

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds          = object NETDATASOURCE('BBlock', !headings, !table, '')
  !this.bblockGrid.bindToDataSource(!nds)

  -- Make name column uneditable
  !this.bblockGrid.setEditableColumn(1, false)

  -- Verify Data
  !this.verifyBBlockData()

endmethod
-- End of method

------------------------------------------------------------------------
