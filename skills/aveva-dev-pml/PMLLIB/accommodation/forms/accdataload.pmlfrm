  -- Load grid
  !nds          = object NETDATASOURCE('Blevels', !headings, !table, '')
  !this.blevelGrid.bindToDataSource(!nds)

  -- Reselect new row
  !newIndex[1]  = !index + 1
  !this.blevelGrid.setSelectedRowTags(!newIndex)

  -- Verify Data
  !this.verifyBLevelData()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      elementName
--
-- Description: Return usable name from passed string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elementName(!element is DBREF, !passedName is STRING) is STRING

  -- Unnamed
  if(!passedName.empty()) then
    return STRING()
  endif

  -- Remove leading slash if there is one
  !name     = !passedName.trim('L','/')

  -- If name start with a "*" then use passed elements name as a root
  if(!name.substring(1,1).eq('*')) then
    if(!element.isNamed) then
      !name = !element.namn & !name.substring(2)
    endif
  endif

  -- Suffix with /
  !name = '/' & !name

  -- Return name
  return !name

endmethod
-- End of method

