-- End of method

------------------------------------------------------------------------
--
-- Method:      csvTable
--
-- Description: Load CSV file into a table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .csvTable(!file is FILE, !tableHeadings is ARRAY) is ARRAY

  -- Initialise Variables
  !table        = ARRAY()

  -- Read file
  -- !records      = !file.readFile()


  !csvfileData     = object COMSPREADSHEETLOADER()
--  !csvfileData.setDatasource(!file)
--  !csvfileData.loadDatasource()
  !csvfileData.loadDatasource(!file)
  !headings  = !csvfileData.getHeadings()

  do !i indices !headings
     !headings[!i] = !headings[!i].upcase()
  enddo

  -- Get header information
  --!headings     = !records[1].upcase().split(',')

  -- Determine which CSV column relates to which table column
  do !i indices !tableHeadings
    !index      = !headings.findFirst(!tableHeadings[!i].upcase())
    !hIndex[!i] = !index
  enddo

  !dataRows         = !csvfileData.getRows()

  -- Build Table
  do !i from 1 to !dataRows.size()
   -- !data       = !records[!i].split(',')
    do !j indices !hIndex
      if(!hIndex[!j].unset()) then
        !table[!i][!j]  = ''
      else
        !table[!i][!j]  = !dataRows[!i][!hIndex[!j]]
      endif
    enddo
  enddo

  -- Return table
  return !table

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setupBBlock
--
-- Description: Setup form for BBLOCK data loading
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupBBlock(!active is BOOLEAN)

  -- Make load pane active
  if(!active) then
    !this.currentTask.evaluate()
    handle ANY
    endhandle
    !this.currentTask           = object BLOCK('!this.setupBBlock(false)')
    !this.formTitle             = !this.bblockRText & ' Bulk Input'
  endif

  -- Show/hide task pane
  !this.bBlockFrame.visible     = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setupBLevel
--
-- Description: Setup form for BLEVEL data loading
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupBLevel(!active is BOOLEAN)

  -- Make load pane active
  if(!active) then
    !this.currentTask.evaluate()
    !this.currentTask           = object BLOCK('!this.setupBLevel(false)')
    !this.formTitle             = !this.blevelRText & ' Bulk Input'

    -- Get current block
    !this.bblock                = !!accNavigator.bblock()
  endif

  -- Show/hide task pane
  !this.blevelFrame.visible     = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setupRoom
--
-- Description: Setup form for ROOM data loading
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupRoom(!active is BOOLEAN)

  -- Make load pane active
  if(!active) then
    !this.currentTask.evaluate()
    !this.currentTask           = object BLOCK('!this.setupRoom(false)')
    !this.formTitle             = !this.roomRText & ' Bulk Input'

    -- Get current block and level
    !this.bblock                = !!accNavigator.bblock()
    !this.blevel                = !!accNavigator.blevel()
  endif

  -- Show/hide task pane
  !this.roomFrame.visible       = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateBBlocks
--
-- Description: Update DB with BBlocks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateBBlocks()

  -- Initialise Variables
  !reference  = !!ce
  !table      = !this.bblockGrid.getRows()
  !attributes = !this.bblockAttributes
  !attTypes   = !this.bblockAttTypes
  !existing   = !this.bblockTable
  !type       = !this.bblockRText

  -- Define UNDO Information
  !this.undo.description('Update from table (' & !type & ')')
  !this.undo.add()

  -- Update DB
  !this.updateDB('BBLOCK', !existing, !attributes, !attTypes, !table, World)

  -- End of undo block
  !this.undo.endUndoable()

  -- Verify Data
  !this.verifyBBlockData()

  -- Update navigator (this should NOT be done from here, but the
  -- navigator should monitor for changes)
  !!accNavigator.reloadBBlocks()

  -- Return to original position
  !!ce  = !reference

endmethod

------------------------------------------------------------------------
--
-- Method:      updateBLevels
--
-- Description: Update DB with BBlocks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateBLevels()

  -- Initialise Variables
  !reference  = !!ce
  !table      = !this.blevelGrid.getRows()
  !attributes = !this.blevelAttributes
  !attTypes   = !this.blevelAttTypes
  !existing   = !this.blevelTable
  !type       = !this.blevelRText

  -- Define UNDO Information
  !this.undo.description('Update from table (' & !type & ')')
  !this.undo.add()

  -- Update DB
  !this.updateDB('BLEVEL', !existing, !attributes, !attTypes, !table, !this.bblock)

  -- End of undo block
  !this.undo.endUndoable()

  -- Verify Data
  !this.verifyBLevelData()

  -- Update navigator (this should NOT be done from here, but the
  -- navigator should monitor for changes)
  !!accNavigator.reloadBLevels()

  -- Return to original position
  !!ce  = !reference

endmethod

------------------------------------------------------------------------
--
-- Method:      updateRooms
--
-- Description: Update DB with Rooms
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRooms()

  -- Initialise Variables
  !reference  = !!ce
  !table      = !this.roomGrid.getRows()
  !attributes = !this.roomAttributes
  !attTypes   = !this.roomAttTypes
  !existing   = !this.roomTable
  !type       = !this.roomRText

  -- Define UNDO Information
  !this.undo.description('Update from table (' & !type & ')')
  !this.undo.add()

  -- Update DB
  !this.updateDB('ROOM', !existing, !attributes, !attTypes, !table, !this.blevel)

  -- End of undo block
  !this.undo.endUndoable()

  -- Verify Data
  !this.verifyRoomData()

  -- Update navigator (this should NOT be done from here, but the
  -- navigator should monitor for changes)
  !!accNavigator.reloadRooms()

  -- Return to original position
  !!ce  = !reference

endmethod

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: Update DB with table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateDB(!type is STRING, !elements is ARRAY, !attributes is ARRAY, !attTypes is ARRAY, !table is ARRAY, !parent is DBREF)

  -- Initialise Variables
  !!ce  = !parent

  -- Loop through the entries
  do !i indices !elements

    -- Update existing elements
    if(!elements[!i].set()) then
      !!ce  = !elements[!i]

    -- Create new elements
    else
      if(!!ce.owner.neq(!parent)) then
        !!ce  = !parent
      endif
      NEW $!<type>
      if(!table[!i][1].empty().not()) then
        !name = !this.elementName(!parent, !table[!i][1])
        NAME $!<name>
      endif
    endif

    -- Update attributes
    -- Loop through attributes of element and set data
    do !j indices !table[!i]

      -- String or Word
      if(!attTypes[!j] inset('STRING','WORD')) then
        !string   = !table[!i][!j].trim('LMR', '_')
        handle ANY
        endhandle
        !!ce.attribute(!attributes[!j]) = !string
        handle ANY
          --q var !i !j !table[!i][!j] !string
        endhandle

      -- Real or Integer
      elseif (!attTypes[!j] inset('REAL','INTEGER','DISTANCE')) then
        !realStr  = !table[!i][!j].trim('LMR', '_')
        handle ANY
        endhandle
        !!ce.attribute(!attributes[!j]) = !realStr.real()
        handle ANY
        endhandle

      endif

    enddo

  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      popupBBlock
--
-- Description: Pop-up callback for BBlocks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .popupBBlock(!passedArray is ARRAY)

  -- Initialise Variables
  !index      = !this.bblockGrid.getSelectedRowTags()[1].real()
  if(!this.bblockTable.set()) then
    !exists   = !this.bblockTable[!index].set()
  else
    !exists   = false
  endif
  !this.popupBBlock.setFieldProperty('BBlockCE', 'ACTIVE', !exists)
  !this.bblocks.showPopup(!passedArray[0], !passedArray[1])
endmethod

