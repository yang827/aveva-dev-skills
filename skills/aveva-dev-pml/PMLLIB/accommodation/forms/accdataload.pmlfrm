endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadRoomCSV
--
-- Description: Load Room CSV file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadRoomCSV()

  -- Initialise Variables
  !headings     = !this.roomHeadings
  !file         = object FILE(!fileName)
  -- !file         = object FILE('%PDMSUSER%\rooms.csv')

  -- Get CSV data as table
  !table        = !this.csvTable(!file, !headings)

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds          = object NETDATASOURCE('Room', !headings, !table, '')
  !this.roomGrid.bindToDataSource(!nds)

  -- Make name column uneditable
  !this.roomGrid.setEditableColumn(1, false)

  -- Verify Data
