------------------------------------------------------------------------
--
-- Method:      insertBBlockRow
--
-- Description: Insert new entry in to BBlock list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertBBlockRow()

  -- Initialise Variable
  !attributes   = !this.bblockAttributes
  !headings     = !this.bblockHeadings
  !index        = !this.bblockGrid.getSelectedRowTags()[1].real()

  -- Get all rows of list
  !table        = !this.bblockGrid.getRows()

  -- Get empty row
  !data         = !this.emptyRow(!attributes)

  -- Insert new row
  !table.insert(!index + 1, !data)

  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- Load grid
  !nds          = object NETDATASOURCE('BBlocks', !headings, !table, '')
  !this.bblockGrid.bindToDataSource(!nds)

  -- Reselect new row
  !newIndex[1]  = !index + 1
  !this.bblockGrid.setSelectedRowTags(!newIndex)

  -- Verify Data
  !this.verifyBBlockData()

endmethod
-- End of method

