------------------------------------------------------------------------
--
-- Method:      verifyBBlockData
--
-- Description: Verifies the data in the grid against the database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .verifyBBlockData()

  -- Initialise Variables
  !existsIcon   = !!pml.getpathname('exclamation16x16.png')
  !equalIcon    = !!pml.getpathname('equals16x16.png')
  !notEqualIcon = !!pml.getpathname('notequal16x16.png')
  !this.bblockTable.clear()

  -- Get current table data
  !table        = !this.bblockGrid.getRows()

  -- Process the data
  do !i indices !table
    !gi   = !i - 1

    -- Check name
    !name                   = !this.elementName(!this.bblock, !table[!i][1])
    !id                     = $!<name>

    -- New entry
    handle ANY
      !this.bblockTable[!i]  = object DBREF()

    -- Existing entry
    elsehandle NONE
      !this.bblockTable[!i]  = !id

      --!this.bblockGrid.setRowColor(!gi, 'Gold')
      !this.bblockGrid.setCellImage(!gi, 1, !existsIcon)

      -- Check attributes against current value
      do !j indices !this.bblockAttributes
        skip if(!j.eq(1))
        if(!id.attribute(!this.bblockAttributes[!j]).string().eq(!table[!i][!j])) then
          !this.bblockGrid.setCellImage(!gi, !j, !equalIcon)
        else
          !this.bblockGrid.setCellImage(!gi, !j, !notEqualIcon)
        endif

      enddo

    endhandle

  enddo


endmethod
-- End of method

