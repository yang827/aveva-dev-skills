------------------------------------------------------------------------
--
-- Method:      initialiseBBlock
--
-- Description: Initialise BBlock
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise for Room
  if(!this.setupType.eq('ROOM')) then
    !this.initialiseRoom()

  -- Initialise for BLevel
  elseif (!this.setupType.eq('BLEVEL')) then
    !this.initialiseBLevel()

  -- Initialise for BBlock (default)
  else
    !this.setupType = 'BBLOCK'
    !this.initialiseBBlock()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form with passed type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!type is STRING)
  !this.setupType = !type.upcase()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialiseBBlock
--
-- Description: Initialise BBlock
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialiseBBlock()

  -- Initialise Variable
  !this.bblockTable.clear()
  !this.setupBBlock(true)

  -- Get empty row
  !data[1]     = !this.emptyRow(!this.bblockAttributes)

  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- Load grid
  !nds = object NETDATASOURCE('Blevels', !this.bblockHeadings, !data, '')
  !this.bblockGrid.bindToDataSource(!nds)

  -- Make name column editable
  !this.bblockGrid.setEditableColumn(1, true)

endmethod
-- End of method

