------------------------------------------------------------------------
--
-- Method:      updateRoomList
--
-- Description: Update room list with room
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRoomList()

  -- Initialise Variables

  -- Attributes
  !attributes             = ARRAY()
  !attributes.append('NAME')
  !attributes.append('Number')
  !attributes.append('Description')

  !roomCollection         = object COLLECTION()
  !roomCollection.addType('ROOM')
  --!roomAttributes         = !attributes

  -- Get all levels
  !roomCollection.scope(!this.owner)
  !roomCollection.filter(object EXPRESSION('MCOUNT eq 0'))
  !myCollection           = !roomCollection.results()
  !block                  = object BLOCK('!myCollection[!evalIndex].string()')
  !dbNames                = !myCollection.evaluate(!block)

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds                = object NETDATASOURCE('Rooms', !attributes, !dbNames)
  !this.roomGrid.bindToDataSource(!nds)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectRoom
--
-- Description: Select ROOM from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectRoom(!dummyPassedArray is ARRAY)

  -- Initialise Variable
  !elements               = !this.roomGrid.getSelectedRowTags()

  -- Tidy
  !this.tidy()
  !!edgCntrl.remove(!this.edgDescription)

  -- Return if there are no elements
  if(!elements.empty()) then

    -- Make picking options inactive
    !this.roomEDGPick.active  = false
    !this.roomEDGpos.active   = false
    return
  endif

  -- Set default room
  !this.currentRoom       = !elements[1].dbref()
  !this.roomDefinition    = object DBEROOM(!this.currentRoom)
  !this.owner             = !this.currentRoom.owner
  !this.currentOwner.val  = 'Active element: ' & !this.owner.namn

  -- Set reference plane
  !this.plane             = object PLANE(!this.owner.position, !this.owner.orientation)
  !this.roomPlane         = object PLANE(!this.currentRoom.position, !this.currentRoom.orientation)


  -- Make create button inactive
  !this.rDcrt.active      = false

  -- Load defaults
  !flrHeight              = !this.roomDefinition.flrHeight
  !clnHeight              = !this.roomDefinition.clnHeight
  !defHeight              = !this.roomDefinition.defaultHeight

  -- Floor Height
  if(!this.currentRoom.flrHeight.neq(0)) then
    !flrHeight            = !this.currentRoom.flrHeight
  elseif (!this.owner.dFlrHeight.neq(0)) then
    !flrHeight            = !this.owner.dFlrHeight
  else
    !flrHeight            = !!accConfig.flrHeight
  endif
  !this.roomDefinition.elevation(!flrHeight)
  !this.rmFlrHeight.val   = !flrHeight

  -- Ceiling Height
  if(!this.currentRoom.clnHeight.neq(0)) then
    !clnHeight            = !this.currentRoom.clnHeight
  elseif (!this.owner.dClnHeight.neq(0)) then
    !clnHeight            = !this.owner.dClnHeightt
  else
    !clnHeight            = !!accConfig.clnHeight
  endif
  !this.roomDefinition.clnHeight  = !clnHeight
  !this.rmClnHeight.val           = !clnHeight

  -- Default Height
  if(!this.currentRoom.heiDefault.neq(0)) then
    !defHeight            = !this.currentRoom.heiDefault
  elseif (!this.owner.heiDefault.neq(0)) then
    !defHeight            = !this.owner.heiDefault
  endif
  !this.roomDefinition.height(!defHeight)
  !this.rmDHeight.val     = !defHeight

  -- Make picking options active
  !this.roomEDGPick.active  = true
  !this.roomEDGpos.active   = true

  -- Tag Room
  !position               = !this.currentRoom.labPosition
  AID TEXT NUMBER $!<this.aidNumber> '$!this.currentRoom.namn' AT $!<position>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      wallDetailGroup
--
-- Description: Get detail group for walls, create if one doesn't exist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallDetailGroup() is DBREF
  return !this.detailGroup('WALL', 'Wall definitions')
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      wallDetailGroup
--
-- Description: Get detail group for passed type, create if one doesn't exist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Detail group purpose
--    2   R      STRING      Description text for new group
-- Return:
--   [Data Type] [Description]
--    DBREF       Detail group
--
------------------------------------------------------------------------

define method .detailGroup(!purpose is STRING, !description is STRING) is DBREF

  !reference          = !!ce
  !owner              = !this.owner

  -- Check if element can own or is owned by a DETGRP
  !otypes             = !this.owner.ahlist
  !otypes.append(!this.owner.type)
  !ownList            = !this.owner.ownlst
  !ownList.append(!this.owner)
  !oIndex             = !otypes.findFirst('DETGRP')

  -- Return detail group if of correct purpose
  if(!oIndex.set()) then
    if(!ownList[!oIndex].purpose.eq(!purpose)) then
      return !ownList[!oIndex]
    endif

    -- If element is DETGRP, then set owner to its owne
    if(!owner.type.eq('DETGRP')) then
      !owner          = !owner.owner
    endif
  endif

  -- Get detail groups of element
  var !detailGroups collect members of $!<owner> with (TYPE eq 'DETGRP' and PURP eq '$!purpose')

  -- Create detail group
  if(!detailGroups.unset()) then
    !!ce              = !this.owner
    NEW DETGRP
    !detailGroup      = !!ce
    !!ce.description  = !description
    !!ce.purpose      = !purpose

    if(!!ce.owner.isNamed) then
      call !!autoNameCe(false)
    endif
    !!ce              = !reference
  else
    !detailGroup      = !detailGroups.first().dbref()
  endif

  -- Return
  return !detailGroup

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roomEDGPick
--
-- Description: Define room from EDG Picking
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomEDGPick()

  -- Initialise Variables
  !this.pickedPoints.clear()
  !this.pickedData.clear()
  !this.paths.clear()
  !this.tidy()

  -- Define event packet
  !prompt               = 'Pick graphics, <esc> to exit'
  !packet               = object EDGPACKET()
  !packet.pickPacket.stdGraphic(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.close         = '!!' & !this.name() & '.roomFromPoints()'
  !packet.action        = '!!' & !this.name() & '.derivePathFromPicks(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

