------------------------------------------------------------------------
--
-- Method:      roomFromPoints
--
-- Description: Define room using picked points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomFromPoints()

  -- Define wall path
  !this.paths.clear()

  -- Define
  if(!this.pickedPoints.empty().not()) then
    !profile    = object PROFILE(!this.pickedPoints.first(), !this.plane.orientation, !this.pickedPoints)
    !profile    = !profile.close()

    -- New origin of room
    !this.roomDefinition.xyOffset(!profile.position)

    -- Reposition profile about new room origin
    !profile.position = !this.roomDefinition.plane.position

    -- Draw room
    !this.tidy()
    aid clear all $!this.aidNumber
    aid text number $!this.aidNumber '$!this.roomDefinition.name' at $!profile.position
    !profile.draw(!this.aidBoundary, 1, 5)

    -- Add
    !this.paths.append(!profile)

  endif

  -- Make create button active
  !this.rDcrt.active  = true

endmethod
-- End of method

