------------------------------------------------------------------------
--
-- Method:      wallFromPoints
--
-- Description: Define wall using picked points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallFromPoints()

  -- Define wall path
  if(!this.pickedPoints.empty().not()) then
    !profile  = object PROFILE(!this.pickedPoints.first(), !this.plane.orientation, !this.pickedPoints)
    !this.paths.append(!profile)
  endif

  -- Make create button active
  !this.wDcrt.active  = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      wallsFromSelection
--
-- Description: Define walls from graphical selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallsFromSelection()

  -- Tidy graphics
  !this.tidy()

  -- Set wall create gadgets
  !this.wDcrt.active  = true

  -- Initialise Variables
  !lines              = ARRAY()
  !reference          = !!ce
  !!ce                = !this.owner
  !this.paths.clear()

  -- Get selected draws to convert into walls
  !selection          = object SELECTION()
  !selection.getCurrent()

  -- Get draws from graphical selection
  !elements           = !selection.getSelection()

  -- Build new selection
  !selection.clear()
  do !i indices !elements
    !type             = !elements[!i].type
    if(!type inset('DRAW','FLRCOV','BNDLIN')) then
      !lines.append(!elements[!i])
      !selection.add(!elements[!i])
    endif
  enddo
  !selection.setCurrent()

  -- Reference plane
  !plane              = !this.plane

  -- Loop through lines and generate profiles from them
  do !i indices !lines
    !type             = !lines[!i].type
    if(!type.eq('DRAW')) then
      !loop           = !lines[!i]
    elseif (!type inset('FLRCOV', 'BNDLIN')) then
      !loop           = loop 1 of $!<lines[$!<i>]>
    endif

    -- Extract profile
    !profile          = object PROFILE(!loop)

    -- Map profile on to reference plane
    !edges            = !profile.edges()
    !newEdges         = ARRAY()

    -- Loop through edges
    do !j indices !edges
      if(!edges[!j].objectType().eq('LINE')) then
        !line         = !edges[!j].projected(!plane)
        !newEdges.append(!line)
      else
        !newEdges.append(!edges[!j])
      endif
    enddo

    -- Define new profile
    !position         = !plane.near(!lines[!i].position)
    !newProfile       = object PROFILE(!position, !plane.orientation, !newEdges)
    !newProfile.draw(!this.aidBoundary, 2, 4)

    -- Save path
    !this.paths.append(!newProfile)

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      derivePathFromPicks
--
-- Description: Derive closed path from picks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .derivePathFromPicks(!data is EDGPICKDATA)

  -- Clear graphics
  AID CLEAR ALL $!<this.aidBoundary>

  -- Initialise Variables
  !plane      = !this.plane

  -- Primary object type
  !type       = !data.primaryObject

  -- Extract graphic element from pick and map on to the plane
  -- Graphic line picked
  if(!type.eq('EDGE')) then
    !line     = !data.lines[1].line(!data.lines[2])
    !dData    = !line.projected(!plane)

  -- Graphic surface picked
  elseif (!type.eq('FACET')) then
    !points   = !data.facets
    !points.unique()
    !iPlane   = !points[1].plane(!points[2], !points[3])
    !dData    = !plane.intersection(!iPlane)

  -- Graphics point picked
  elseif (!type.eq('VERTEX')) then
    !dData    = !plane.near(!data.vertices.first())
  endif

  -- Data type (position or line)
  !dType      = !dData.objectType()

  -- If there is no previous picked data, then save the information
  if(!this.pickedData.empty()) then

    -- Add derived position to list of picked points
    if(!dType.eq('POSITION')) then
      !this.pickedPoints.append(!dData)
    endif

  -- Previous element defined
  else

    -- Get previous element from picked data
    !previous = !this.pickedData.last()
    !pType    = !previous.objectType()

    -- Determine the point on the boundary from derived type and previous

    -- Derived data is a POSITION
    if(!dType.eq('POSITION')) then
      !position     = !dData

      -- Previous is line (map point onto line)
      if(!pType.eq('LINE')) then
        !position   = !previous.near(!position)
      endif

    -- Derived Data is a LINE
    else

      -- Previous is LINE (get intersection)
      if(!pType.eq('LINE')) then
        !position   = !previous.intersection(!dData)

      -- Previous is POSITION (map point onto line)
      else
        !position   = !dData.near(!previous)
      endif

    endif

    -- Add position to list of picked points
    !this.pickedPoints.append(!position)

  endif

  -- Add derived data to picked data
  !this.pickedData.append(!dData)

  -- Draw path
  !this.drawPath()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      derivePathFromPoints
--
-- Description: Get position data and map onto working plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .derivePathFromPoints(!data is EDGPOSITIONDATA)

  -- Initialise Variables
  !plane    = !this.plane
  !position = !plane.near(!data.position)
  !this.pickedPoints.append(!position)

  -- Draw path
  !this.drawPath()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawPath
--
-- Description: Draw path
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawPath()

  -- Tidy
  !this.tidy()

  -- Initialise Variables
  !index  = !this.pickedPoints.size()

  -- Draw boundary
  if(!index.gt(0)) then
    !position   = !this.pickedPoints[1]
    AID TEXT NUMBER $!<this.aidNumber> 'Origin'   AT $!position
    do !i from 2 to !index
      !position = !this.pickedPoints[!i]
      AID TEXT NUMBER $!<this.aidNumber> '$!i' AT $!position
    enddo
    -- More than one point
    if(!index.gt(1)) then
      !profile    = object PROFILE(!this.plane.position, !this.plane.orientation, !this.pickedPoints)
      if(!this.closedPath) then
        !profile.close()
      endif
      !profile.draw(!this.aidBoundary, 2, 4)
    endif
  endif

  -- Draw last pick if a line
  if(!this.pickedData.empty().not()) then
    !pickedData     = !this.pickedData.last()
    if(!pickedData.objectType().eq('LINE')) then
      !line         = !pickedData
      !xlength      = !line.length()
      !ylength      = 1mm
      !zlength      = 100mm
      !orientation  = object ORIENTATION('X is ' & !line.direction())
      !position     = !line.proportion(0.5)

      AID BOX NUMBER $!<this.aidBoundary> POSITION $!<position> ORIENTATION $!<orientation>  XLENGTH $!<xlength> YLENGTH $!<ylength> ZLENGTH $!<zlength> FILLED ON
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createRoomGeometry
--
-- Description: Create room definitions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createRoomGeometry()

  -- Initialise Variables
  !profile      = !this.paths.first()

  -- Reference Element
  !reference  = !!ce

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created ' & !this.roomRText & ' geometry')
  !this.undo.add()

  -- Navigate to Level
  !!ce                  = !this.currentRoom

  -- Modify Room
  !this.roomDefinition.outerBoundary(!profile)
  !this.roomDefinition.modify()

  -- Define basic of room
  !roomBasics           = object ACCROOMBASICS(!this.roomDefinition)
  !roomBasics.defineCeiling(!this.crtCeiling.val)
  !roomBasics.defineCeilingGrid(!this.crtCeilingGrid.val)
  !roomBasics.defineFloor(!this.crtFloor.val)

  -- Create basics
  !roomBasics.create()

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Reload rooms
  !this.updateRoomList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createWallPaths
--
-- Description: Define walls paths
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createWallPaths()

  -- Initialise Variables
  !reference          = !!ce

  -- Set wall create gadgets
  !this.wDcrt.active  = false

  -- Define UNDO Information
  !this.undo          = object UNDOABLE()

  !this.undo.description('Created wall paths')
  !this.undo.add()

  -- Wall detail group
  !detailGroup      = !this.wallDetailGroup()
  !!ce              = !detailGroup

  -- Move to wall
  do !path values !this.paths
    NEW CTWALL
    !wall             = !!ce
    !wall.height      = !this.wDHeight.val
    !wall.wThickness  = !this.wDThickness.val
    !!ce.position     = !path.position
    NEW HATTA
    NEW TATTA
    NEW RPATH
    !edges          = !path.edges()
    !from           = !edges[1].startPosition
    NEW POINTR
    !!ce.position   = !from
    do !i indices !edges
      !to           = !edges[!i].endPosition
      NEW POINTR
      !!ce.position = !to
    enddo
  enddo

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Tidy
  !this.tidy()

  -- Return to original element
  !!ce    = !reference

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Continue"
--    3   R      STRING      "Continue" text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING, !continue is STRING)

  -- Switch warning pane
  !this.currentPane.visible   = false
  !this.warningPane.visible   = true

  -- Concatenate message into a single line
  !display    = ''
  do !i indices !message
    !display  = !display & ' ' & !message[!i]
  enddo

  -- Display message
  !this.warning.val           = !display.trim()
  !this.warningDone.tag       = !continue

  -- Set "Continue" action (If the action is dependent on other criteria
  -- e.g. being in the correct position in the hierarchy, then the
  -- active state of the "Done" button needs to be managed.
  !this.warningAction         = object BLOCK(!action)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warningDone
--
-- Description: Exit warning
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warningDone()

  -- Hide warning pane
  !this.warningPane.visible   = false

  -- Execute action
  !this.warningAction.evaluate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      exampleWarning
--
-- Description: Example of how to use a warning with an action
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exampleWarning1()

  -- Define message to be displayed
  !message[1] = 'This is the message that is to be displayed in the '
  !message[2] = 'warning pane. The message can be up to 132 Characters'
  !message[3] = 'long.'
  !this.warning(!message, '!this.firstTaskPane(true)', !this.ftpWarningMsg.val)

endmethod
-- End of method definition
