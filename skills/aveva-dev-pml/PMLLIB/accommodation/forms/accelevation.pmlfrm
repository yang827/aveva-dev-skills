--
--
-- Description: Set the elevation of Accommodation elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accElevation()                   -
--  close()                          -
--  draw()                           -                   Setup EDG pick event for picking position
--  elevUpdate()                     -
--  elevwrt(DBREF)                   REAL
--  initialise()                     -
--  offset(EDGPOSITIONDATA)          -                   Map picked position to room offset
--  pickOffset()                     -                   Define EDG event to pick position
--  refreshConfig()                  -
--  setElevation()                   -                   Update element with modified values
--  setup(DBREF)                     -
--  tidy()                           -
--  updateGadgets()                  -
--  updateWorldElevGadget()          -
--


 setup form !!accElevation

  !this.formTitle     = 'Modify Elevation'
  !this.iconTitle     = 'Elevation'
  !this.callback      = '!this.initialise()'
  !this.quitcall      = '!this.tidy()'
  !this.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
  button .selectElement linkLabel 'Element:'  anchor top + left       at x0.5                 ymin                    callback '!this.initialise()' width 6
  paragraph .namepara                     anchor top + left + right   at xmax                 ymin                    width 20 lines 1

  -- Elevation   of floor from building origin
  button .offset linkLabel 'Pick Elevation...' anchor top + left + right at x0.5                 ymax+0.2          callback '!this.pickOffset()'     width 20
  text .elevRel   'Elevation'               anchor top + left + right   at x2                 ymax              callback '!this.elevUpdate()' width 21 is REAL format !!distanceFmt
  paragraph .wrtpara                        anchor top + left           at x2                 ymax+0.2          width 25
  paragraph .wrtworldtxt                    anchor top + left           at x2                 ymax+0.2          width 20

  -- Apply button
  button .acceptBtn  'Apply'    anchor top + left           at x0.5     ymax+0.2                                  callback '!this.setElevation()' width 5

  -- Create Room
  button .discardBtn 'Dismiss'  anchor top + right          at xmax.elevRel-size    ymin                                      callback '!this.close()'  width 5

  -- Form Members
  -- Current Element
  member .element         is DBREF

  -- Elevation attribute of the element
  member .elevattr      is STRING

  -- Elevation Values
  member .elevation       is REAL

  member .owner           is DBREF

  member .aidNumber       is REAL

  -- Attribute data
  member .attributeData   is DBEATTRIBSEARCH

 exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accelevation
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .accElevation()

  !this.wrtworldtxt.val         = 'Elevation wrt World:   '

  -- Get aid number
  !this.aidNumber   = !!aidNumbers.add('Accommodation Elevation display')

  !elevAtts[1]          = 'FlrHeight'
  !elevAtts[2]          = 'ClnHeight'
  !elevAtts[3]          = 'Position'

  !this.attributeData = object DBEATTRIBSEARCH(object DBREF() , 'Elevation' , !elevAtts)

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

endmethod

------------------------------------------------------------------------
--
-- Method:initialise
--
-- Description:Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--  element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  !this.setup(!!CE)

endmethod

------------------------------------------------------------------------
--
-- Method:setup
--
-- Description:Initialisation values relative to the passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--  element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setup(!passedElement is DBREF)

  !element         = !this.attributeData.element(!!CE)

  if (!element.unset() ) then
      !!alert.warning('Element doesn''t have an Elevation or position attribute.')
       return
  endif

 !this.element   = !element
 !this.elevattr  = !this.attributeData.attribute

  -- set the form gadget values
  --!this.formTitle       = !this.attributeData.description
  !this.namepara.val    = !element.flnn

  -- Set element to modify
  !owner                = !element.owner

  -- Get owning frame of reference
  do
    !position = !owner.position
    handle ANY
      !owner    = !owner.owner
      handle ANY
        !!alert.warning('Unable to form frame of reference of element ' & !element.namn)
        return
      endhandle
    elsehandle NONE
      break
    endhandle
  enddo

  !this.owner = !owner

  -- Owing element type
  !description          = !this.attributeData.description  & '  from  ' & !!accConfig.typeDescription(!owner.type)
  !this.wrtpara.val     = !description

  -- Get the elevation
  if(!this.elevattr.set() and !this.elevattr.neq('Position') ) then
    !this.elevation      = !element.attribute(!this.elevattr)

  -- Get the elevation from Position
  else
    !this.elevation       = !this.element.pos.up
  endif

  -- Update input gadgets with values
  !this.updateGadgets()

  -- Tag element
  !this.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:    elevUpdate
--
-- Description: Sets the xyOffset of the element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [DescripTion]
--
------------------------------------------------------------------------

define method .elevUpdate()

  -- Initialise Variables
  !this.elevation  =  !this.elevRel.val

   -- update the world coordinate gadget
  !this.updateWorldElevGadget()

  -- Draw
  !this.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:   elevwrt()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elevwrt(!relativeRef is DBREF) is REAL

  !position    = !this.element.position
  !position.up = !this.elevation
  !position    = !position.wrt(!relativeRef )

  return !position.up

endmethod

 ------------------------------------------------------------------------
--
-- Method:      draw()
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draw()

  -- Remove aid graphics
  !this.tidy()

  !position       = !this.element.position
  !position.up    = !this.elevation

  AID ARROW NUMBER $!<this.aidNumber> AT $!position DIRECTION up HEIGHT 1000mm PROPORTION 0.1
  AID TEXT NUMBER $!<this.aidNumber> '$!this.elevation' AT $!position

endmethod

------------------------------------------------------------------------
--
-- Method: close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()
  !this.tidy()
  !this.hide()
endmethod

------------------------------------------------------------------------
--
-- Method: tidy
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()
  AID CLEAR ALL $!<this.aidNumber>
  handle ANY
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      setElevation
--
-- Description: Update element with modified values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setElevation()

--mark for undo option
  !elevationMark = object UNDOABLE()
  !undoDesc = 'Modify Elevation of $!this.namepara.val'

  !elevationMark.description(!undoDesc)
  !elevationMark.add()

  -- Update Elevation
  if(!this.elevattr.set() and !this.elevattr.neq('Position') ) then
    !this.element.attribute(!this.elevattr)   = !this.elevation

  -- Update position
  else
     --Get position
     !position                 = !this.element.position
     !position.up              = !this.elevation

     -- Modify position
     !this.element.position          = !position

  endif

--for undo option
  !elevationMark.endundoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Define EDG event to pick position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickOffset()

  -- Initialise Variables
  -- use the alttext here
  !prompt               = 'Pick Elevation'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Modify Elevation'
  !packet.remove        = true
  !packet.action        = '!!accElevation.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to room offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

  -- Map position onto plane
  if(!this.elevattr.set() and !this.elevattr.neq('Position') ) then
    -- should we do a calculation here to match the actual
     !this.elevation   = !data.position.up
  else
    !this.elevation    = !data.position.wrt(!this.owner).up
  endif

  !this.updateGadgets()

  !this.draw()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updategadgets
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  -- update input gadgets
  !this.elevRel.val     = !this.elevation

  !this.updateWorldElevGadget()

  if (!!dbrefUpdatable(!this.element).not() )  then
      $P $!!error.text
      !this.acceptBtn.active = FALSE
  else
      !this.acceptBtn.active = TRUE
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateworldelevgadget
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateWorldElevGadget()

 -- update  gadgets  related to world
 !elevWorld         = !this.elevwrt(world)
 !this.wrtworldtxt.val = 'Elevation wrt World:   ' & !elevWorld.string()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  !description          = 'Relative to ' & !!accConfig.typeDescription(!this.owner.type)
  !this.wrtpara.val     = !description

endmethod

-- End of method
