--
--     Keyword:     Display errors
--   Module:        design
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Wed Oct 04 00:00:00 BST 2006
--
--
-- Description:
--   Form for showing list of elements and the error associated with them
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accErrorDisplay()                -                   Constructor
--  errors(STRING,ARRAY)             -                   Display form with passed errors
--  popup(ARRAY)                     -                   Pop-up callback
--  popupMenus()                     -                   Setup popup menus.
--  select(ARRAY)                    -                   Select element with error from grid
--

import 'GridControl'
handle any
endhandle

setup form !!accErrorDisplay dialog docking right


  !this.formTitle     = 'Errors'
  !this.iconTitle     = 'Errors'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision$ '

  -- PML Container to host grid control for BBLOCKs
  frame .errorFrame panel            anchor all                    at x0.5                     ymax
    container .errors PMLNetCONTROL 'NET' dock fill
    list .bBlockDummy                 anchor all                  at x0.5                     y0.5                callback '' columns height 20 width 32
  exit

  -- Form members

  -- Errors list (2D array [1] Element, [2] Message)
  member .errorList         is ARRAY

  -- List of elements
  member .elements          is ARRAY

  -- Selected element
  member .errorElement      is DBREF

  -- Grid control
  using namespace 'Aveva.Pdms.Presentation'
  member .errorGrid         is NETGRIDCONTROL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accErrorDisplay
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accErrorDisplay()

  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- Add .Net control to PML container for BBLOCKs
  !this.errorGrid            = object NETGRIDCONTROL()
  !this.errors.control       = !this.errorGrid.handle()

  -- Events handled
  !this.errorGrid.addEventHandler('onPopup',           !this, 'popups')
  !this.errorGrid.addEventHandler('afterSelectChange', !this, 'select')

  -- Load information from Configuration
  !this.errorGrid.columnExcelFilter(FALSE)
  !this.errorGrid.outlookGroupStyle(FALSE)
  !this.errorGrid.columnSummaries(FALSE)
  !this.errorGrid.fixedHeaders(false)
  !this.errorGrid.fixedRows(false)
  !this.errorGrid.singleRowSelection(true)

  -- Setup popup-menus
  !this.popupMenus()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      errors
--
-- Description: Display form with passed errors
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Form title
--    2   R      ARRAY       2D Array [1] Element [2] Message
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .errors(!title is STRING, !errorList is ARRAY)

  -- Initialise Elements
  !this.formTitle = !title
  !this.errorList = !errorList
  !this.elements.clear()
  !table          = ARRAY()

  !headings       = ARRAY()
  !headings.append('Element')
  !headings.append('Error Message')

  -- Define table
  do !errorEntry values !this.errorList
    !tableEntry[1] = !errorEntry[1].namn
    !tableEntry[2] = !errorEntry[2]
    !this.elements.append(!errorEntry[1])
    !table.append(!tableEntry)
  enddo

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds            = object NETDATASOURCE('Errors', !headings, !table)
  !this.errorGrid.bindToDataSource(!nds)

  -- Display form
  !this.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      popupMenus
--
-- Description: Setup popup menus.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .popupMenus()

  -- Initialise Variables

  -- Popup Menus for errors Grid
  !popup = !this.newMenu('popupDefault')

  !popup.add('callback', 'Locate in Tree',    '!!ce = !this.errorElement',      'errorelementInTree')

  !this.errors.popup   = !popup

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      popup
--
-- Description: Pop-up callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .popup(!a is ARRAY)
  !this.errors.showPopup(!a[0], !a[1])
endmethod

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select element with error from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!passedArray is ARRAY)

  if(!passedArray.unset()) then
    return
  endif
  !index    = !passedArray[0][1].real()
  !element  = !this.elements[!index]
  !!ce      = !element

endmethod
