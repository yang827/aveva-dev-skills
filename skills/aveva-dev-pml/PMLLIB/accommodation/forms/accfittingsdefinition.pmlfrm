------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- fitting Tasks
  !this.createTasks.val         = 'Create'
  !this.modifyTasks.val         = 'Modify'
  !this.copyTasks.val           = 'Copy'
  !this.deleteTasks.val         = 'Delete'

    -- Grid defaults
  !columnExcelFilter            = !!accConfig.navigator.columnExcelFilter
  !outlookGroupStyle            = !!accConfig.navigator.outlookGroupStyle
  !columnSummaries              = !!accConfig.navigator.columnSummaries
  !labelVisibility              = !!accConfig.navigator.labelVisibility

   -- Control configuration (Rooms)
  !this.wallGrid.columnExcelFilter(!columnExcelFilter)
  !this.wallGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.wallGrid.columnSummaries(!columnSummaries)
  !this.wallGrid.fixedHeaders(false)
  !this.wallGrid.fixedRows(false)
  !this.wallGrid.singleRowSelection(false)
  !this.wallGrid.setLabelVisibility(!labelVisibility)

  !this.fittingGrid.columnExcelFilter(!columnExcelFilter)
  !this.fittingGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.fittingGrid.columnSummaries(!columnSummaries)
  !this.fittingGrid.fixedHeaders(false)
  !this.fittingGrid.fixedRows(false)
  !this.fittingGrid.singleRowSelection(false)
  !this.fittingGrid.setLabelVisibility(!labelVisibility)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- navigate to the required pane
  if !this.mainTaskPane.visible then
    -- go back to the main menu form
    !this.tidy()
    handle ANY
    endhandle
    !!acctaskmanager.active('accDetail')
  elseif !this.fittings.visible then
    -- go back to main panel
    !this.showMainPanel(!active)
  elseif !this.editPane.visible then
    -- if the discard linkLabel is visible then changes have been made so bring up an accept/cancel button to confirm what the
    -- user wants to do with the changes
    if !this.modDiscard.active then
      !answer = !!alert.question('Changes have been made to this item, do you wish to apply them before navigating away from this pane?')

      if !answer.eq('YES') then
        !task = object BLOCK(!this.crtAccept.callback)
        !task.evaluate()
      elseif !answer.eq('NO') then
        !this.discard()
      else
        -- do nothing
        return
      endif

    endif

    -- go back to fitting panel
    !this.showFittingPanel(!active)
    !this.useActiveFittings()
  else
    -- Show main task pane by default
    !this.showMainPanel(!active)
  endif

endmethod
-- End of method
