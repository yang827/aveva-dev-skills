--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createFitting(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then
  else
    !this.tidy()
  endif

  -- Show/hide task pane
  !this.showEditPanel(TRUE)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      modifyFitting
--
-- Description: Display fitting pane in modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyFitting(!active is BOOLEAN)

return
  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

    -- Change form title to reflect the active pane
    --!this.formTitle           = 'Modify fitting'

    -- select the list of current fittings
    !this.wall = !this.wallGrid.getselectedrowtags()


    !collection     = object COLLECTION()
    !collection.addType('DOOR')
    !collection.addType('WINDOW')
    !collection.scope($!this.wall[1])
    !this.fittingList  = !collection.results()

    -- Define selection
    !selection      = object SELECTION()
    do !wall values !this.fittingList
      !selection.add(!wall)
    enddo

    -- Attributes
    !attributes     = ARRAY()
    !attributes.append('NAME')

    if(!this.fittingList.empty().not()) then
      !block                  = object BLOCK('!this.fittingList[!evalIndex].string()')
      !dbNames                = !this.fittingList.evaluate(!block)
      !this.fittingNames      = !dbNames
      using namespace 'Aveva.Pdms.Presentation'
      !nds                = object NETDATASOURCE('Walls', !attributes, !dbNames)
      !this.fittingGrid.bindToDataSource(!nds)
      !this.fittingGrid.setSelectedRowTags(!this.fittingNames)
    endif

    !this.draw()
    !this.aidLines()

    -- Actions when task pane is made inactive
  else
    !this.tidy()
  endif

  -- Show/hide task pane
  -- !this.editPane.visible      = !active

endmethod
-- End of method

