--
--
-- Description:
--    Main form for fitting definitions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accfittingsdefinition()          -                   Constructor
--  aidLines()                       -                   Modify (modify the current element in the fitting list)
--  angle()                          -
--  angle(GADGET,STRING)             -
--  applyRotation(REAL)              -
--  checkElementSet()                -
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  checkWord(GADGET)                -
--  copyFitting()                    -                   copy the selected fitting
--  create()                         -                   Create element
--  create(STRING)                   -                   create Fittings
--  createFitting(BOOLEAN)           -                   Display fitting pane in create mode
--  currentElemPick(DBREF)           -                   set the picked element as ce so that the useActiveWalls method can pick it up and populate the walls list.
--  deleteFitting()                  -                   Delete fitting
--  discard()                        -                   discard any changes
--  draw()                           -
--  dummy()                          -                   Dummy method for unset
--  fittingCreate()                  -                   Create fitting
--  fittingModify()                  BOOLEAN             Modify fitting
--  fittingModify(DBREF)             BOOLEAN             Setup to modify fitting
--  fittingTasks(BOOLEAN)            -
--  generatePosition(EDGPOSITIONDATA) -
--  getCentreTransform(DBREF,STRING) ARRAY               gets transform alpha, beta and gamma angles to be applied to a default orientation such that
--  getJustification()               DIRECTION
--  getRotation()                    -                   get the rotation of fitting
--  graphicalPick(EDGPICKDATA)       -                   set the picked element as ce so that the useActiveWalls method can pick it up and populate the walls list.
--  initialise()                     -                   Initialise form.
--  initialisePositionControl()      -                   Position control initialised in a separate method to
--  lockPosition(GADGET,STRING)      -                   method for ensuring the user can't lock both positions
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  managedHoleCreate()              BOOLEAN             Create a hole in the hole management system by
--  modify()                         -                   Modify (write modified values to DB)
--  modify(BOOLEAN)                  -                   Display modify pane
--  modify(STRING)                   -                   Modify Fittings
--  modifyFitting(BOOLEAN)           -                   Display fitting pane in modify mode
--  modifySelection()                -
--  offset()                         -                   Set xyOffset of element
--  offset(EDGPOSITIONDATA)          -                   Map picked position to fitting offset
--  pickElement()                    -                   Setup EDG pick event for picking a wall or room element
--  pickOffset()                     -                   Setup EDG pick event for picking position
--  pickPenetrated()                 -                   Set EDG to pick penetrated items
--  pickPenetratedEvent(EDGPICKDATA) -                   EDG callback for penetrated item pick
--  pickPosition()                   -                   pick the position of the new opening
--  position(EDGPOSITIONDATA)        -                   Set Fitting position to picked position
--  positionOption()                 -                   Position option to choose explicit or relative
--  refresh()                        -                   Refresh form from navigator.
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  selectFitting(ARRAY)             -
--  selectFitting(DBREF)             -
--  selectSpec()                     -                   Selecting spec
--  selectWall()                     -                   Select Wall from grid
--  selectWall(ARRAY)                -                   Select Wall from grid
--  setExtraAtts()                   -
--  setJustification()               -
--  setLevel()                       -                   sets the level at which the fitting will sit
--  setPosition()                    -                   set position
--  setRotation(GADGET,STRING)       -
--  setSpec()                        -                   Set spec
--  setupExtraTags(STRING)           -
--  setupLevels()                    -                   sets up levels so that you can justify room fittings to the floor covering levels
--  showEditPanel(BOOLEAN)           -
--  showFittingPanel(BOOLEAN)        -
--  showMainPanel(BOOLEAN)           -
--  tidy()                           -                   Tidy graphics
--  tidyManagedHole()                -
--  tidyWalls()                      -                   Tidy walls
--  updateAttributes()               -                   Update gadgets with object data
--  updateData()                     -                   Update current data with gadget values
--  updateFittingList()              -                   Get walls from graphic selection
--  updateGadgets()                  -
--  updateNumeric(GADGET,STRING)     -
--  updatePenetrated(ARRAY)          -                   Update penetrated items list and highlight penetrated items
--  updateWallList()                 -                   Get walls from graphic selection
--  useActiveFittings()              -                   Get walls from current active element
--  useActiveWalls()                 -                   Get walls from current active element
--  useSelectedWalls()               -                   Get walls from graphic selection
--

import 'PositionControl'
handle ANY
endhandle

setup form !!accfittingsdefinition dialog docking right

  !this.formTitle     = 'Furniture, Fittings and Fixtures - Storage Areas'
  !this.iconTitle     = 'fitting'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.tidy()'
  !this.formRevision  = ' $Revision$ '

  -- Current hierarchy
  paragraph .currentOwner                     anchor top + left + right         at x0.5           ymax                width 37 lines 1

  -- Main Task Pane

   frame .mainTaskPane panel                  anchor top + left + right         at x0             ymax.currentOwner

    -- Walls
    paragraph .wallModListTag                 anchor top + left + right         at x0.5           ymax                text 'Available element storage areas'
    line .wallModL1                           anchor top + left + right         at xmin           ymax                horizontal width 37

    -- List of walls to modify
    container .walls PMLNetCONTROL 'NET'      anchor top + left + right         at x0             ymax                width 37 height 8

    -- Populate list of walls
    --button .wmSelection linkLabel 'Graphical selection'   anchor t + l + r      at x2             ymax+0.5            callback '!this.pickElement()'  width 16
    button .wmSelection linkLabel 'Graphical selection'   anchor t + l + r      at x2             ymax+0.5            callback '!this.useSelectedWalls()'  width 16
    button .wmActive    linkLabel 'Current Element'       anchor t + l + r      at xmin           ymax                callback '!this.currentElemPick(!!ce)'  width 16

    -- Create options
    paragraph .wallselection                                                    at x0.5           ymax      text 'Select Element to modify'
    line .mainTaskL1 anchor top + left + right                                  at xmin           ymax                horizontal width 37
    button .mtCrt    linkLabel 'Edit Selected Element'                          at x2             ymax        callback '!this.checkElementSet()'
    line .mainTaskL1a anchor top + left + right                                 at x0.5           ymax                horizontal width 37

    paragraph .editBackIcon                   anchor top + left                 at x0             ymax+0.5            pixmap width 16 height 16
    button .crtedit   linkLabel 'Return to main tasks'                          at xmax+1         ymin                callback '!this.mainTasks(true)'

  exit

  frame .fittingTaskPane panel                anchor top + left + right         at x0             ymax.currentOwner

    -- Walls
    paragraph .fittingModListTag              anchor top + left + right         at x0.5           ymax                  text 'List of fittings'
    line .fittingModL1                        anchor top + left + right         at xmin           ymax                  horizontal width 37

    -- List of fittings to modify
    container .fittings PMLNetCONTROL 'NET'    anchor top + left + right         at x0             ymax                width 37 height 8

    -- Populate list of walls
    --button .omSelection linkLabel 'Graphical selection'   anchor t + l + r      at x2             ymax+0.5            callback '!this.useSelectedWalls()'  width 16
    button .omActive    linkLabel 'Current Element'       anchor t + l + r      at x2               ymax+0.5                callback '!this.selectFitting(!!ce)'  width 16

    -- Create options
    paragraph .createTasks                                                      at x0.5           ymax                width 35 lines 1
    line .oTaskL1                          anchor top + left + right         at xmin               ymax               horizontal width 37
    button .ftCrtElFitt     linkLabel 'Electrical Fittings'                     at x2                     ymax                callback |!this.create('ELFITT')|
    button .ftCrtInfitt     linkLabel 'Information Fittings'                    at x2                     ymax                callback |!this.create('INFITT')|
    button .ftCrtHvacFi     linkLabel 'HVAC Fittings'                           at x2                     ymax                callback |!this.create('HVACFI')|
    button .ftCrtFPFitt     linkLabel 'Fire Protection Fittings'                at x2                     ymax                callback |!this.create('FPFITT')|
    button .ftCrtFurnit     linkLabel 'Furniture'                               at x2                     ymax                callback |!this.create('FURNIT')|
    button .ftCrtFixtur     linkLabel 'Fixture'                                 at x2                     ymax                callback |!this.create('FIXTUR')|
    button .htCrt           linkLabel 'Managed Hole'                            at x2                     ymax                callback |!this.managedHoleCreate()|

    -- Modify options
    paragraph .modifyTasks                                                      at x0.5           ymax+0.5            width 35 lines 1
    line .mainTaskL2                          anchor top + left + right         at xmin           ymax                horizontal width 37
    button .ftModElFitt     linkLabel 'Modify Element'                     at x2                     ymax                callback |!this.modifySelection()|

    -- Copy options
    paragraph .copyTasks                                                        at x0.5           ymax+0.5            width 35 lines 1
    line .mainTaskL3                          anchor top + left + right         at xmin           ymax                horizontal width 37
    button .mtCopy        linkLabel 'Copy Element'                              at x2             ymax                callback |!this.copyFitting()|

    -- Delete options
    paragraph .deleteTasks                                                      at x0.5           ymax+0.5            width 35 lines 1
    line .mainTaskL4                          anchor top + left + right         at xmin           ymax                horizontal width 37
    button .ftDelElFitt     linkLabel 'Delete Element'                     at x2                     ymax                callback |!this.deleteFitting()|

    paragraph .wallBackIcon                        anchor top + left           at x0             ymax+0.5            pixmap width 16 height 16
    button .walledit   linkLabel 'Back to storage area selection'                  at xmax+1         ymin                callback '!this.showMainPanel(true)'

  exit


  --  creation/modification pane
  frame .editPane panel                             anchor top + left + right   at x0                     ymax.currentOwner

    paragraph .editTitle                            anchor top + left + right   at x0.5                   ymax                width 35 lines 1
    line .editLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 37

    frame .atts FoldUpPanel 'Default attributes' anchor l+t+r   at x0.5   ymax+0.2     width 37 heig 4
      -- Gadgetry definition for creation
      text .dbName  'Name:'  tagwidth 12               anchor top + left + right   at x1                                         callback |!this.checkName(!this.dbName, 'new')| width 22 is STRING
      path down
      text .dbDescription 'Description:' tagwidth 12   anchor top + left + right                                                 callback '!this.updateGadgets()' width 22 is STRING
      text .dbFunction 'Function:'       tagwidth 12   anchor top + left + right                                                 callback '!this.updateGadgets()' width 22 is STRING
      text .dbPurpose  'Purpose:'        tagwidth 12   anchor top + left + right                                                 callback '!this.checkWord( !this.dbPurpose )' width 22 is STRING
      numericinput .dbnumber 'Number:'   tagwidth 12   anchor top + left           at xmin                   ymax+0.2            callback '!this.updateNumeric(' range 0 10000 ndp 0 width 4
    exit

    frame .extraAtts FoldUpPanel 'Type specific attributes' anchor l+t+r   at x0.5   ymax+0.2     width 37 heig 3
      text .extraAtt1 '' tagwidth 12   anchor top + left + right                                                                 callback '!this.setExtraAtts()' width 22 is STRING
      text .extraAtt2 '' tagwidth 12   anchor top + left + right                                                                 callback '!this.setExtraAtts()' width 22 is STRING  format !!temperatureFmt
    exit

    paragraph .spec                                 anchor top + left + right   at x0.5                   ymax+0.2            text 'Specification:' width 33 lines 1
    line .editLine2                                 anchor top + left + right   at xmin                   ymax                horizontal width 37
    paragraph .selectedSpec                         anchor top + left + right   at xmin                   ymax                width 35 lines 1
    paragraph .specPix                              anchor top + left + right   at xmin                   ymax                pixmap width 15 height 15
    button .specSelect  linkLabel  'Select Specification'  anchor top + left + right   at xmax+.5         ymin                width 35 lines 1

    -- Positioning
    frame .position      'Location'                  anchor top + left + right   at x0.5                  ymax+0.2            width 37 lines 1
      rtoggle .explicit   tagwidth 10 'Explicit Position'
      path right
      rtoggle .relative   tagwidth 10 'Relative Position'
      button .pickPosition linkLabel 'Position...'    anchor top + left + right   at x2                   ymax           callback '!this.pickPosition()' width 10
      frame .expliPosition      'Explicit Position'     anchor top + left + right   at x0.5               ymax+0.2 width 36 height 6
        path down
        vdist 0.3
        container .editPosNetFrame PMLNetCONTROL 'NET'   at x1 ymin+1 anchor t+l+r width 33 hei 5
      exit

      frame .relPosition        'Relative Position'     anchor top + left + right   at x0.5                     ymin.expliPosition width 36 height 6
         -- Angle from North
        --numericinput .nAngle 'Angle from North:'  tagwidth 21 anchor t + l    at x2                     ymax+0.2            callback '!this.nAngle('  range 180 -180 ndp 0 width 4

        -- XY Offset of floor from building origin
        --button .offset linkLabel 'Offset'       anchor top + left + right   at x2                     ymax+0.2            callback '!this.pickOffset()' width 20
        text .xOffset   'X Distance:' tagwid 10   anchor top + left + right   at xmin+1               ymin+1                callback '!this.offset()' width 9 is REAL format !!distanceFmt
        toggle .xLock tagwid 4 'Lock'               anchor top + right   at xmax+0.5 ymin                                                                callback '!this.lockPosition('
        text .yOffset   'Y Distance:' tagwid 10   anchor top + left + right   at xmin.xOffset           ymax+0.2            callback '!this.offset()' width 9 is REAL format !!distanceFmt
        toggle .yLock tagwid 4 'Lock'               anchor top + right   at xmax+0.5 ymin                                                                callback '!this.lockPosition('
      exit

      option .justification 'Wall Justification'    tagwid 14 anchor top + left + right   at x1       ymax.expliPosition+0.2                  callback '!this.setRotation(' width 18
      option .level 'Fitting Level '      tagwid 14 anchor top + left + right   at x1       ymax.expliPosition+0.2                  callback '!this.setLevel()' width 18
      numericinput .angle   'Rotate Fitting'        tagwidth 14 anchor t + l    at x1                 ymax+0.2            callback '!this.setRotation('  range 180 -180 ndp 0 width 4

    exit
    -- Create Fittings
    paragraph .crtAcceptIcon                        anchor top + left           at x0                   ymax+0.5            pixmap width 16 height 16
    button .crtAccept linkLabel   'Create'          anchor top + left           at xmax+0.5             ymin+0.1            callback '!this.create()' width 12

    -- Discard Changes
    paragraph .modDiscardIcon                       anchor top + right          at xmax+4               ymin                pixmap width 16 height 16
    button .modDiscard linkLabel 'Discard Changes'  anchor top + right          at xmax+1                ymin                callback '!this.discard()' width 10

    paragraph .crtBackIcon                          anchor top + left           at x0                   ymax+0.5            pixmap width 15 height 15
    button .crtMain   linkLabel                                                 at xmax+1               ymin                callback '!this.mainTasks(true)' width 20

  exit

  -- Form Members
  using namespace 'Aveva.Pdms.Presentation'

  member .fittingPosition is POSITIONCONTROL

  -- Alternative text for owning element type
  member .ownerAltText    is STRING

  -- Owning element
  member .owningelement   is DBREF
  member .ownerType       is STRING
  member .workingElement  is DBREF
  member .workingFitting  is DBREF

  -- Current Element (fitting)
  member .element         is DBREF
  member .definition      is DBEFITTING
  member .elementType     is STRING
  member .mode            is STRING

  -- member to store any data held in additional fields for object specific attributes
  member .extraText1      is STRING
  member .extraText2      is STRING

   -- Walls for modification
  member .wall            is ARRAY
  member .wallList        is ARRAY
  member .wallNames       is ARRAY
  member .fittingList     is ARRAY
  member .fittingNames    is ARRAY
  member .posRef          is DBREF

  using namespace 'Aveva.Pdms.Presentation'
  member .wallGrid        is NETGRIDCONTROL
  using namespace 'Aveva.Pdms.Presentation'
  member .fittingGrid     is NETGRIDCONTROL

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK
  member .refreshTask     is BLOCK

  -- Undo for form
  member .undo            is UNDOABLE

  -- EDG Description
  member .edgDescription  is STRING

  -- Aid Numbers
  member .aidAxes         is REAL
  member .aidLines        is REAL
  member .aidText         is REAL
  member .aidBox         is REAL


  member .workingElementAid is REAL
  member .workingFittingAid is REAL

  member .orientation is ORIENTATION

  -- level stores the floor Covering or ceiling item that is used to position a fitting in a room
  member .fittingLevel is DBREF

  -- hole management members
  member .managedHoleProfile  is HMHOLEFROMPROFILE
  member .enhancePenetrated   is ARRAY

  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
  --!!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accfittingsdefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accfittingsdefinition()

  !this.initialise()

  -- Set form to auto-scroll
  !this.autoScroll              = true

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!this.dummy()')
  !this.refreshTask             = object BLOCK('!this.dummy()')

  -- Collapse foldUp panels
  --!this.defaults.expanded       = false
  --!this.criteria.expanded       = false

  -- Set events for numeric gadgets
  !this.angle.modifiedEvents   = TRUE
  !this.dbnumber.modifiedEvents   = true
  --!this.hAngle.modifiedEvents   = TRUE

   -- Add .Net control to PML container for Walls
   using namespace 'Aveva.Pdms.Presentation'
  !this.wallGrid              = object NETGRIDCONTROL()
  !this.walls.control         = !this.wallGrid.handle()
  --!this.wallGrid.addEventHandler('onPopup',           !this, 'popupRoom')
  !this.wallGrid.addEventHandler('afterSelectChange', !this, 'selectWall')
  !this.wallGrid.singleRowSelection(TRUE)
  -- Add .Net control to PML container for Walls
   using namespace 'Aveva.Pdms.Presentation'
  !this.fittingGrid              = object NETGRIDCONTROL()
  !this.fittings.control         = !this.fittingGrid.handle()
  --!this.wallGrid.addEventHandler('onPopup',           !this, 'popupRoom')
  !this.fittingGrid.addEventHandler('afterSelectChange', !this, 'selectFitting')
  !this.fittingGrid.singleRowSelection(TRUE)

  -- Load information from Configuration
  !this.refreshConfig()

 -- Initialise task panes
  !this.mainTasks(true)
  !this.createFitting(false)
  !this.modifyFitting(false)

  -- Set "Back" icon
  !backIcon                     = !!pml.getPathName('back.png')
  !this.crtBackIcon.addPixmap(!backIcon)
  --!this.modBackIcon.addPixmap(!backIcon)
  !this.editBackIcon.addPixmap(!backIcon)
  !this.wallBackIcon.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getPathName('create.png')
  !this.crtAcceptIcon.addPixmap(!createIcon)

  -- Set "Accept" icon
  --!acceptIcon                   = !!pml.getPathName('accept.png')

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getPathName('discard.png')
  !this.modDiscardIcon.addPixmap(!discardIcon)

  -- Set "Spec Select" icon
  !searchIcon                   = !!pml.getPathName('ng_zoomtodrawlist.png')
  !this.specPix.addPixmap(!searchIcon)

  -- EDG Description
  !this.edgDescription    = 'Accommodation fitting Definition'

  !this.position.val = 2
  !this.positionOption()

  -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  --!!accControl.register('accNavigator', !action)

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

  --****START POSITION CONTROL SECTION****--
  -- Load ship grid data for use with positioning controls (may be this should be a function?)
  !grid                     = object SHIPGRID()
  !gridDefined              = !grid.position.set()

  -- Only populate the grid data is available
  if(!gridDefined) then
    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo
  endif

  -------------------- Setup for position control ----------------------
  -- Declare namespace where position control exists - in a separate method
  -- to avoid a bug when using more than one namespace
  !this.initialisePositionControl()

  -- Set grid data (should put all control grid setups in here
  if(!gridDefined) then
    !this.fittingPosition.gridData(!xGridData,!yGridData,!zGridData)
    !this.fittingPosition.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
  else
    !this.fittingPosition.gridVisible(false)
  endif

  -- Assign action to be taken when position is changed
  !this.fittingPosition.changeAction('!!accfittingsdefinition.setPosition()')

  -- Initialise Gadgets
  !this.fittingPosition.forceXYZ(0,0,0)

  -- Add PMLNet control to PML frame
  !this.editPosNetFrame.control  = !this.fittingPosition.handle()

  -- Set position control to be show in the correct form
  -- Add all control into this block
  var !coordinate coordinate
  if(!gridDefined.and(!coordinate.eq('XYZ'))) then
    !this.fittingPosition.gridFormat()
  else
    !this.fittingPosition.enuFormat()
  endif

  --****END POSITION CONTROL SECTION****--

  -- setup the justifications option gadget
  !this.justification.add('LEFT')
  !this.justification.add('RIGHT')
  !this.justification.add('CENTRE - DIRECTION LEFT')
  !this.justification.add('CENTRE - DIRECTION RIGHT')
  !this.justification.val = 1

  -- setup the floor level option gadget
  !this.level.add('DEFAULT')
  !this.level.val = 1

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialisePositionControl
--
-- Description: Position control initialised in a separate method to
--              avoid a core name space problem
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialisePositionControl()
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- Modify BBLOCK position
  !this.fittingPosition          = object POSITIONCONTROL()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showMainPanel
--
-- Description: Show main panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showMainPanel(!action is BOOLEAN)

  !this.mainTaskPane    .visible = !action
  !this.walls           .visible = !action
  !this.fittings        .visible = !action.not()
  !this.fittingTaskPane .visible = !action.not()
  !this.editPane        .visible = !action.not()

  !this.wallGrid.allgridevents(TRUE)
  !this.fittingGrid.allgridevents(FALSE)

  !this.wallGrid.clearRowSelection()
  !this.mtCrt.active = FALSE
$(
  if !action then
    !this.useActiveWalls()
  endif

  !this.wallGrid.getrows().unset()
  handle ANY
    return
  endhandle

  -- if the list of fittings is unset for the current working element then disable the modify, copy and delete linkLabels
  if !this.wallGrid.getrows().unset() then
    !this.ftModElFitt.active = FALSE
    !this.mtCopy.active = FALSE
    !this.ftDelElFitt.active = FALSE
  else
    !this.ftModElFitt.active = TRUE
    !this.mtCopy.active = TRUE
    !this.ftDelElFitt.active = TRUE
    if !this.workingElement.unset() then
      !this.wallGrid.clearRowSelection()
      !this.wallGrid.selectRow(1)
    else
      -- select the stored working fitting
      !wallList = !this.wallGrid.getrows()
  if !this.wallGrid.set() then
    if !this.wallGrid.getrows().size().eq(1) then
      -- select the one row as it is the only one you can operate on
      !this.wallGrid.selectRow(1)
    endif
  endif
  !this.formTitle = 'Furniture, Fittings and Fixtures - Storage Areas'
  !this.currentOwner.val      = 'Storage Area: ' & !this.workingElement.namn
  handle ANY
    !this.currentOwner.val      = 'No storage area selected'
  endhandle
      !row = -1
      do !i from 1 to !wallList.size()
        !bool = !wallList[!i][1].dbref().eq(!this.workingElement)
        handle ANY
          skip
        endhandle
        if !bool then
          !row = !i
          break
        endif
      enddo

      if !row.neq(-1) then
        !this.wallGrid.clearRowSelection()
        !this.wallGrid.selectRow(!row)
      else
        !this.wallGrid.clearRowSelection()
        !this.wallGrid.selectRow(1)
      endif
    endif
  endif
$)
endmethod

define method .checkElementSet()
  if !this.workingElement.unset() then
    !!alert.warning('Please select a storage area to proceed')
    return
  else
    !this.showFittingPanel(TRUE)
  endif
endmethod

define method .showFittingPanel(!action is BOOLEAN)

  !this.mainTaskPane    .visible = !action.not()
  !this.walls           .visible = !action.not()
  !this.editPane        .visible = !action.not()
  !this.fittings        .visible = !action
  !this.fittingTaskPane .visible = !action

  !this.wallGrid.allgridevents(FALSE)
  !this.fittingGrid.allgridevents(TRUE)

  if !action then
    !this.useActiveFittings()
  endif

  !this.fittingGrid.clearRowSelection()
  -- if the list of fittings is unset for the current working element then disable the modify, copy and delete linkLabels
  if !this.fittingGrid.getrows().unset() then
    !this.ftModElFitt.active = FALSE
    !this.mtCopy.active = FALSE
    !this.ftDelElFitt.active = FALSE
  else
    !this.ftModElFitt.active = FALSE
    !this.mtCopy.active = FALSE
    !this.ftDelElFitt.active = FALSE

    if !this.fittingGrid.getrows().size().eq(1) then
      -- select the one row as it is the only one you can operate on
      !this.fittingGrid.selectRow(1)
    endif
  endif

  !this.formTitle = 'Furniture, Fittings and Fixtures - Element Tasks'
  !this.currentOwner.val      = 'Storage Area: ' & !this.workingElement.namn
  handle ANY
    !this.currentOwner.val      = 'No storage area selected'
  endhandle
        --!this.fittingGrid.clearRowSelection()
        --!this.fittingGrid.selectRow(!row)
        --!this.fittingGrid.clearRowSelection()
        --!this.fittingGrid.selectRow(1)

endmethod


define method .showEditPanel(!action is BOOLEAN)

  -- set up extra attribute text fields
  !this.setupExtraTags(!this.elementType)
  handle ANY
    !this.extraAtts.visible = FALSE
    !this.extraAtts.expanded = FALSE
  endhandle

  !this.mainTaskPane    .visible = !action.not()
  !this.walls           .visible = !action.not()
  !this.fittings        .visible = !action.not()
  !this.fittingTaskPane .visible = !action.not()
  !this.editPane        .visible = !action

  !this.wallGrid.allgridevents(FALSE)
  !this.fittingGrid.allgridevents(FALSE)

  !type = !this.workingElement.type
  handle ANY
    !type = 'NONE'
  endhandle

  if !type.eq('CTWALL') then
    !this.explicit.active = FALSE
    !this.relative.active = FALSE
    !this.justification.visible = TRUE
    !this.level.visible = FALSE
  else
    !this.explicit.active = TRUE
    !this.relative.active = TRUE
    !this.justification.visible = FALSE
    !this.level.visible = TRUE
    !this.setupLevels()
  endif
  --if we are in the marine application then set the x/y offset tags to u and v respectively
  !app = !!module().modkey
  handle ANY
    !app = 'none'
  endhandle

  if !app.upcase().eq('MARODES') then
    !this.xOffset.tag = 'U:'
    !this.yOffset.tag = 'V:'
  else
    !this.xOffset.tag = 'X:'
    !this.yOffset.tag = 'Y:'
  endif

  !this.formTitle = 'Furniture, Fittings and Fixtures - ' + !this.mode + ' ' + !this.elementType
  handle ANY
    !this.formTitle = 'Furniture, Fittings and Fixtures'
  endhandle

  !this.currentOwner.val      = 'Storage Area: ' & !this.workingElement.namn
  handle ANY
    !this.currentOwner.val      = 'No storage area selected'
  endhandle

endmethod

