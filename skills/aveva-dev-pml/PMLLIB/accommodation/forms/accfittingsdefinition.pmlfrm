------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -------------------------------------------
  -----------TEMPORARY-----------------------
  -------------------------------------------
  -- hide explicit and relative toggles -----
  -- ----------------------------------------
       !this.explicit.visible = FALSE
       !this.relative.visible = FALSE
  -------------------------------------------
  -----------TEMPORARY-----------------------
  -------------------------------------------

  -- setup some aid-line numbers
  if !this.workingElementAid.unset() then
    !this.workingElementAid = !!aidNumbers.add('working element number')
  endif
  if !this.workingFittingAid.unset() then
    !this.workingFittingAid = !!aidNumbers.add('working fitting number')
  endif
  if !this.aidAxes.unset() then
    !this.aidAxes   = !!aidNumbers.add('fitting - Axes')
  endif
  if !this.aidLines.unset() then
    !this.aidLines  = !!aidNumbers.add('fitting - lines')
  endif
  if !this.aidText.unset() then
    !this.aidText   = !!aidNumbers.add('fitting - Text')
  endif
  if !this.aidBox.unset() then
    !this.aidBox    = !!aidNumbers.add('fitting - Box')
  endif

  -- Get current element
  !element                = !!accNavigator.currentSelection()

  -- If element is unset, then initialise form with limited actions
  if(!element.unset()) then
    !this.owningelement         = object DBREF()
    !this.currentOwner.val      = 'No storage area selected'

  -- Initialise form with relevant actions
  else
    -- Set owner where layout data is to be stored
    !this.owningelement         = !element
    --!this.owner                 = !element
    !this.ownerType             = !this.owningelement.type
    --!this.ownerAltText          = !!accConfig.attribute(!this.ownerType)
    !this.currentOwner.val      = 'Storage Area: ' & !this.workingElement.namn
    handle ANY
      !this.currentOwner.val      = 'No storage area selected'
    endhandle
  endif

  !this.showMainPanel(TRUE)

  !this.angle.val = 0

  -- Setup panes
  !this.specSelect.callback = |!this.selectSpec()|

  !this.extraText1 = ''
  !this.extraText2 = ''

endmethod
-- End of method

