-- End of method

------------------------------------------------------------------------
--
-- Method:      fittingModify
--
-- Description: Modify fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fittingModify() is BOOLEAN

!!alert.error('not yet implemented')


  return

  do !i indices !this.owningelement.members
    !element  = !this.owningelement.members[!i]
    !fitting = fitting 1 of $!element
    handle ANY
      skip
    elsehandle NONE
      break
    endhandle
  enddo

  -- No fitting found
  if(undefined(!fitting)) then
    return false
  endif

  -- Display modify pane
  return !this.fittingModify(!fitting)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fittingModify
--
-- Description: Setup to modify fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       fitting to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .fittingModify(!element is DBREF) is BOOLEAN

  -- Check fitting has been passed
  if(!element.fulltype.neq('INFITTING') and !element.fulltype.neq('ELFITTING') and !element.fulltype.neq('HVACFITTING') and !element.fulltype.neq('FPFITTING')) then
    !!error.text            = 'Element "' & !element.namn & '" is not a fitting.'
    return false
  endif

  -- Load current element
  !this.element             = !element

  -- Set definition
  !this.definition          = object DBEFITTING(!element)

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.aidLines, !this.aidText, !this.aidBox)

  -- Edit panel title
  !this.editTitle.val       = 'Modify fitting: ' & !this.element.namn

  -- Update gadgets
  !this.updateAttributes()

  -- Setup panes
  !this.modifyFitting(true)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateAttributes
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAttributes()

  -- Set values of gadgets from DBEFITTING object
  !this.dbName.val        = !this.definition.name
  !this.dbDescription.val = !this.definition.description
  !this.dbFunction.val    = !this.definition.function
  !this.dbPurpose.val    = !this.definition.purpose
  !this.dbnumber.val      = !this.definition.number
  !this.posRef            = !this.definition.posRef
  -- try to ensure that the locking works to retain numbers
  if !this.yLock.val.and(!this.yOffset.set()).not() then
    !this.yOffset.val       = !this.definition.xyOffset[2]
  endif
  if !this.xLock.val.and(!this.xOffset.set()).not() then
     !this.xOffset.val       = !this.definition.xyOffset[1]
  endif
  --!this.xOffset.val       = !this.definition.xyOffset[1]
  --!this.yOffset.val       = !this.definition.xyOffset[2]

  -- update in any additional object specific data attributes
  !this.extraText1        = !this.definition.extraText1
  !this.extraAtt1.val     = !this.extraText1
  !this.extraText2        = !this.definition.extraText2
  !this.extraAtt2.val     = !this.extraText2

  !pos = !this.definition.position

  !this.fittingPosition.xyz(!pos[1],!pos[2],!pos[3])

  !dtext = !this.justification.dtext
  do !i from 1 to !dtext.size()

    if !this.definition.justification.eq('CENT') then
      -- try and find the orientation i.e. centre left or centre right
      !zdir = !this.definition.orientation.zdir().wrt( /* )

      -- get the wall zdir
      !ref = !!ce
      !!ce = !this.posRef
      handle ANY
        return
      endhandle

      -- check to see if we have a hole
      if !!ce.type.eq('WLOPEN') then
        !!ce = !!ce.posRef
      endif

      !point1 = !!ce
      next
      !point2 = !!ce
      !fittingOri = !this.definition.getWallZdir(!point1, !point2)
      !wallZdir = !fittingOri[3]

      !!ce = !ref

      if !zdir.eq(!wallZdir) then
        !text = 'CENTRE - DIRECTION RIGHT'
      else
        !text = 'CENTRE - DIRECTION LEFT'
      endif

      if !text.eq(!dtext[!i]) then
        !this.justification.val = !i
        break
      endif

    elseif !this.definition.justification.eq(!dtext[!i]) then
      !this.justification.val = !i
      break
    endif

  enddo

  !fittingLevel = !this.definition.fittingLevel
  !this.setupLevels()
  if !this.level.rtext.size().gt(1) then
    do !i from 2 to !this.level.rtext.size()
      !match = 'NONE'
      if !this.level.rtext[!i].dbref().position.up.eq(!fittingLevel) then
        !match = !i.string()
        !this.level.val = !i
        break
      endif
    enddo
  else
    !match = 'NONE'
  endif

  if !match.eq('NONE') then
    !this.level.val = 1
  endif

  !this.fittingLevel = !this.level.selection('Rtext').dbref()

  -- populate the rotation gadget
  !this.getRotation()
  handle ANY
  endhandle

  -- get the current spec from the component
  !this.selectedSpec.val = !this.definition.spref.name.string()
  handle ANY
  endhandle


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateData
--
-- Description: Update current data with gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateData()

  -- Initialise Variables
  if(!this.dbName.val.set()) then
    !this.definition.name         = !this.dbName.val
  endif

  !this.definition.description    = !this.dbDescription.val
  !this.definition.function       = !this.dbFunction.val
  !this.definition.number         = !this.dbnumber.val
  !this.definition.purpose        = !this.dbPurpose.val

  -- add in any additional object specific data attributes
  !this.definition.extraText1     = !this.extraText1
  !this.definition.extraText2     = !this.extraText2

  if (!this.selectedSpec.val eq 'Specification: Unset') then
    !this.definition.spref        = object DBREF()
  else
    if (!this.selectedSpec.val.substring(1,1) eq '/') then
      !specString = !this.selectedSpec.val
    else
      !specString = '/' & !this.selectedSpec.val
    endif
    !specDBRef  = !specString.dbref()
    !this.definition.spref = !specDBRef
    handle ANY
      !!alert.error('Unable to find the fitting reference')
      !this.definition.spref        = object DBREF()
    endhandle
  endif
  !this.definition.posRef         = !this.posRef
  handle ANY
    !this.definition.posRef       = object DBREF()
  endhandle

  -- update positional data
  !positionArray       = !this.fittingPosition.xyz()
  !pos[1]  = !positionArray[0]
  !pos[2] = !positionArray[1]
  !pos[3]    = !positionArray[2]
  !this.definition.position = !pos

  -- x and y offsets
  !offsets = object ARRAY()
  !offsets.append(!this.xOffset.val)
  !offsets.append(!this.yOffset.val)
  !this.definition.xyOffset = !offsets
  !this.definition.justification = !this.justification.selection()
  !this.definition.orientation = !this.orientation

  if !this.workingElement.type.eq('CTWALL') then
    if !this.definition.dbelement.unset().not() then
      !poseRefType = !this.dbelement.owner.posRef.type
      handle ANY
        !poseRefType = ''
      endhandle
      if !poseRefType.empty().not() then
        if !this.definition.dbelement.own.posRef.type.eq('WLOPEN') then
          !this.definition.opening = !this.definition.dbelement.own.posRef
        endif
      endif
    endif
  endif

  !this.definition.fittingLevel = !this.fittingLevel.position.up
  handle ANY
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create()

  -- if the component selection has not been set then don't continue
  if !this.selectedSpec.val.unset() OR !this.selectedSpec.val.eq('Specification: Unset')  then
    !!alert.warning('please select a specification for this component')
    return
  endif

  -- Reference Element
  !reference  = !!ce

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created fitting')
  !this.undo.add()

  -- Navigate to Level
  !!ce = !this.workingElement
  if !this.workingElement.type.neq('CTWALL') then

    -- Get detailing group
    if !this.elementType.eq('INFITT') then
      !detailGroup    = !!accDetailGroup(!this.workingElement, 'INFI', 'information fittings')
    elseif !this.elementType.eq('FPFITT') then
      !detailGroup    = !!accDetailGroup(!this.workingElement, 'FPFI', 'fire protection fittings')
    elseif !this.elementType.eq('HVACFI') then
      !detailGroup    = !!accDetailGroup(!this.workingElement, 'HVFI', 'HVAC fittings')
    elseif !this.elementType.eq('ELFITT') then
      !detailGroup    = !!accDetailGroup(!this.workingElement, 'ELFI', 'electrical fittings')
    elseif !this.elementType.eq('FURNIT') then
      !detailGroup    = !!accDetailGroup(!this.workingElement, 'FURN', 'furniture')
    elseif !this.elementType.eq('FIXTUR') then
      !detailGroup    = !!accDetailGroup(!this.workingElement, 'FIXT', 'fixtures')
    endif

    if(!detailGroup.unset()) then
      !!alert.warning('"temp" - ' & !!error.text)
      return
    endif

    -- Navigate to detail group
    !!ce = !detailGroup

    -- Create new element
    if(!this.definition.create()) then
      !this.element = !this.definition.dbelement
      !this.modify(!this.element.type)
      --update the fittings list
      !this.useActiveFittings()

    -- Failed creating element
    else
      !!alert.warning(!!error.text)
    endif

    -- Return to original element
    !!ce        = !reference

  else

    -- Get detailing group
    if !this.elementType.eq('INFITT') then
      !wallFeat    = !!accWallFeat(!this.workingElement, 'INFI', 'information fittings')
    elseif !this.elementType.eq('FPFITT') then
      !wallFeat    = !!accWallFeat(!this.workingElement, 'FPFI', 'fire protection fittings')
    elseif !this.elementType.eq('HVACFI') then
      !wallFeat   = !!accWallFeat(!this.workingElement, 'HVFI', 'HVAC fittings')
    elseif !this.elementType.eq('ELFITT') then
      !wallFeat    = !!accWallFeat(!this.workingElement, 'ELFI', 'electrical fittings')
    elseif !this.elementType.eq('FURNIT') then
      !wallFeat    = !!accWallFeat(!this.workingElement, 'FURN', 'furniture')
    elseif !this.elementType.eq('FIXTUR') then
      !wallFeat    = !!accWallFeat(!this.workingElement, 'FIXT', 'fixtures')
    endif

    -- Create new element
    if(!this.definition.createWallFitt(!wallFeat)) then
      !this.workingFitting = !this.definition.dbelement
      !this.element = !this.definition.dbelement
      !this.modify(!this.element.type)
      -- Failed creating element
    else
      !!alert.warning(!!error.text)
    endif

  endif

  !this.formTitle = 'Furniture, Fittings and Fixtures - ' + !this.mode + ' ' + !this.elementType
  !this.updateAttributes()
  !this.updateData()

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Return to original element
  !!ce        = !reference

endmethod

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()

  !this.undo.add()
  !this.updateData()
  -- Modify Fitting
  if(!this.definition.modify().not())then
    !!alert.warning(!!error.text)
  endif

  !this.crtAccept.active = FALSE
  !this.crtAcceptIcon.active = FALSE
  !this.modDiscardIcon.active = FALSE
  !this.modDiscard.active     = FALSE

  !this.tidy()

  -- Redraw graphical aids to update tag
  !this.aidLines()
  -- Refresh Content navigator
  !!acccontentnavigator.refresh()
  handle (2,751)
  endhandle
  -- Set end mark for UNDO
  !this.undo.endUndoable()
  !this.updateAttributes()

endmethod

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Set xyOffset of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset()

  -- APPLY POSITION DIRECT TO FITTING SO THAT WE CAN SEE WHERE IT WILL END UP --
  -- DO NOT HOWEVER UPDATE THE DEFINITION OF THE OBJECT BECAUSE THIS IS STORING THE --
  -- CURRENT POSITION OF THE FITTING SO THAT WE CAN RESTORE THE POSITION ON USER CANCEL --
  -- check to see if we have a hole

  -- x and y offsets
  !zdist = !this.xOffset.val
  !vdist = !this.yOffset.val

  if !this.definition.dbelement.unset().not() then
    if !this.workingElement.type.eq('CTWALL') then
      if !this.definition.posRef.type.eq('WLOPEN') then
        !this.definition.posRef.zdist = !zdist
        !this.definition.dbelement.owner.zdist = 0
        !this.definition.dbelement.owner.vdist = !vdist
      else
        !this.definition.dbelement.owner.zdist = !zdist
        !this.definition.dbelement.owner.vdist = !vdist
      endif
    else
      !offset = object ARRAY()
      !offset.append(!zdist)
      !offset.append(!vdist)
      !elevation = !this.level.selection('Rtext')
      !pos = !this.definition.position(!offset, !elevation.dbref().position.wrt( /* ).up)
      !this.definition.dbelement.position = !pos
    endif
  else
    !this.updateData()
  endif
  !this.draw()
  !this.aidLines()

  !this.updateGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      nAngle
--
-- Description: Set angle from owners North
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .angle(!gadget is GADGET, !select is STRING)

  !!ce = !this.posRef
  handle ANY
    return
  endhandle

  -- check to see if we have a hole
  if !!ce.type.eq('WLOPEN') then
    !!ce = !!ce.posRef
  endif

  !point1 = !!ce
  next
  !point2 = !!ce
  !fittingOri = !this.definition.getWallZdir(!point1, !point2)

  !x = !fittingOri[1]
  handle ANY
    return
  elsehandle NONE
    !y = !fittingOri[2]
    !z = !fittingOri[3]
  endhandle

  if !this.justification.selection().eq('LEFT') or !this.justification.selection().eq('CENTRE - DIRECTION LEFT') then
    --flip the zdir if the justification is on the opposite wall face
    !x = !x.opposite()
    !z = !z.opposite()
  endif
  !angle = !this.angle.val
  if !angle.real().lt(0) then
    !sense = FALSE
  else
    !sense = TRUE
  endif
  !oriString = 'x is ' & !x.string().before('WRT') & ' and y is ' & !y.string().before('WRT')
  !arc = object ARC(!point1.position, !oriString.orientation(), 0, 0 + $!angle, 750mm, !sense)
  handle ANY
  endhandle
  !direction      = !arc.angleDirection(!arc.endAngle)
  handle ANY
    !direction = !x
  endhandle

  -- Convert angle into an orientation
  --!orientation            = object ORIENTATION('Y is N ' & !this.nAngle & ' W ' & !this.hAngle & ' U ')
  !oriString = 'x is ' & !direction.string()  & ' and z is ' & !z.string().before('WRT')

  !orientation = object ORIENTATION(!oriString)

  !this.orientation = !orientation
  !this.updateData()
  !this.draw()

  !this.aidLines()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Angle
--
-- Description: Set angle from owners North
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .angle()

  !!ce = !this.posRef
  handle ANY
    return
  endhandle

  -- check to see if we have a hole
  if !!ce.type.eq('WLOPEN') then
    !!ce = !!ce.posRef
  endif

  !point1 = !!ce
  next
  !point2 = !!ce
  !fittingOri = !this.definition.getWallZdir(!point1, !point2)

  !x = !fittingOri[1]
  handle ANY
    return
  elsehandle NONE
    !y = !fittingOri[2]
    !z = !fittingOri[3]
  endhandle

  if !this.justification.selection().eq('LEFT') or !this.justification.selection().eq('CENTRE - DIRECTION LEFT') then
    --flip the zdir if the justification is on the opposite wall face
    !x = !x.opposite()
    !z = !z.opposite()
  endif
  !angle = !this.angle.val
  if !angle.real().lt(0) then
    !sense = FALSE
  else
    !sense = TRUE
  endif
  !oriString = 'x is ' & !x.string().before('WRT') & ' and y is ' & !y.string().before('WRT')
  !arc = object ARC(!point1.position, !oriString.orientation(), 0, 0 + $!angle, 750mm, !sense)
  handle ANY
  endhandle
  !direction      = !arc.angleDirection(!arc.endAngle)
  handle ANY
    !direction = !x
  endhandle

  -- Convert angle into an orientation
  --!orientation            = object ORIENTATION('Y is N ' & !this.nAngle & ' W ' & !this.hAngle & ' U ')
  !oriString = 'x is ' & !direction.string()  & ' and z is ' & !z.string().before('WRT')

  !orientation = object ORIENTATION(!oriString)
  !this.orientation = !orientation
  !this.updateData()
  !this.draw()
  !this.aidLines()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickOffset()

  -- Initialise Variables
  !prompt               = 'Pick fitting origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to fitting offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

  -- Initialise Variables
  !this.definition.xyOffset(!data.position)

  -- Update gadget
  !this.xOffset.val = !this.definition.xyOffset[1]
  !this.yOffset.val = !this.definition.xyOffset[2]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteFitting
--
-- Description: Delete fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteFitting()

  !deleteArray = object ARRAY()

  !element = !this.workingFitting
  handle ANY
    !!alert.warning('please select a valid fitting from the above list to delete')
    return
  elsehandle NONE
    if !element.unset() then
      !!alert.warning('please select a valid fitting from the above list to delete')
      return
    endif
  endhandle
  if !element.owner.type.eq('DETGRP') then
    -- just delete the fitting
    --!!ce = !element
    !deleteArray.append(!element)
    $(
    !type = !element.type
    delete $!type
    $)
  elseif !element.owner.type.eq('WLFITT') then
    !posRef = !element.owner.posRef
    if !posRef.unset() then
      -- just delete the wall fitting
      --!!ce = !element.owner
      --delete wall fitting
      !deleteArray.append(!element.owner)
    else
      if !posRef.type.eq('WLOPEN') then
        --we need to delete the wall fitting and the wall opening
        --!!ce = !posRef
        --delete wall opening
        --!!ce = !element.owner
        --delete wall fitting
        !deleteArray.append(!posRef)
        !deleteArray.append(!element.owner)
      else
        -- just delete the wall fitting
        --!!ce = !element.owner
        --delete wall fitting
        !deleteArray.append(!element.owner)
      endif
    endif
  endif

  if(!!accDeleteManager.deleteElements(!deleteArray).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
    return
  else
    -- update the fittings list
    !this.useActiveFittings()
    -- Refresh Content navigator
    !!acccontentnavigator.refresh()
    handle (2,751)
    endhandle
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      useSelectedWalls
--
-- Description: Get walls from graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useSelectedWalls()

  -- Unenhance walls
  !this.tidyWalls()

  -- Tidy graphics
  !this.tidy()

  -- Clear grid
  !this.wallGrid.clearGrid()

  -- Initialise Variables
  !this.wallList.clear()
  !this.wallNames.clear()

  -- Get selected draws to convert into walls
  !selection          = object SELECTION()
  !selection.getCurrent()

  -- Get draws from graphical selection
  !elements = !selection.getSelection()

  -- Build new selection
  !selection.clear()

  -- in order to pick up rooms we have to look for the graphical items a room can own and then go up through the
  -- ownerList to find the room
  !items = object ARRAY()
  var !world ref of /*
  !worldRef = !world.dbref()
  do !i indices !elements
    !type = !elements[!i].type
     if(!type.eq('CTWALL')) then
      !items.append(!elements[!i])
    elseif(!type.eq('AREADE')) or (!type.eq('BNDLIN')) or (!type.eq('FLRCOV')) or (!type.eq('INSURQ')) then
      !elem = !elements[!i].owner
      do
        if !elem.type.eq('ROOM') then
          !items.append(!elem)
          break
        elseif !elem.eq(!worldRef) then
          break
        else
          !elem = !elem.owner
        endif
      enddo
    endif
  enddo

  !list = !items.unique()
  do !i indices !list
    !this.wallList.append(!list[!i])
  enddo

  -- Highlight selection
  --!selection.setCurrent()

  -- Update grid
  !this.updateWallList()
  !this.useActiveFittings()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useActiveWalls
--
-- Description: Get walls from current active element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useActiveWalls()

  -- Unenhance walls
  !this.tidyWalls()

  -- Tidy graphics
  !this.tidy()

  -- Clear grid
  !this.wallGrid.clearGrid()
  -- Initialise Variables
  !this.wallList.clear()
  !this.wallNames.clear()
  !groups = ARRAY()

  !type = !this.owningelement.type
  handle ANY
    -- if the owning element type is unset it will cause an error
    -- so set type to null so we can pick up BBLOCK level
    !type = 'null'
  endhandle

  -- Collect all walls for current active element
  if !type.eq('ROOM') then
    --include the current room in the list so we can create fittings for it and collect all those
    --detail groups that contain CTWALLS so that we can create fittings at wall level
    !groups.append(!this.owningelement)
    do !member values !this.owningelement.members
      if(!member.type.eq('DETGRP')) then
        !groups.append(!member)
      endif
    enddo
    if(!groups.empty().not()) then
      !collection     = object COLLECTION()
      !collection.addType('ROOM')
      !collection.addType('CTWALL')
      !collection.scope(!groups)
      !this.wallList.clear()
      !this.wallList.append(!this.owningelement)
      !this.wallList.appendarray(!collection.results())
    endif
  elseif !type.eq('BLEVEL') then
    --include all rooms within the BLEVEL hierarchy list so we can create fittings for them and collect all the standalone CTWALLS under detail groups
    --under the BLEVEL also
    -- we must be at BBLOCK level just collect any CTWALLS under detail groups so we can apply fittings to them
    !groups.append(!this.owningelement)
    do !member values !this.owningelement.members
      if(!member.type.eq('DETGRP')) then
        !groups.append(!member)
      endif
    enddo
    if(!groups.empty().not()) then
      !collection     = object COLLECTION()
      !collection.addType('ROOM')
      !collection.addType('CTWALL')
      !collection.scope(!groups)
      !this.wallList  = !collection.results()
    endif
  elseif !type.eq('CTWALL') then
    --append the wall to the list
    !groups.append(!this.owningelement)
    do !member values !this.owningelement.members
      if(!member.type.eq('DETGRP')) then
        !groups.append(!member)
      endif
    enddo
    if(!groups.empty().not()) then
      !collection     = object COLLECTION()
      !collection.addType('ROOM')
      !collection.addType('CTWALL')
      !collection.scope(!groups)
      !this.wallList  = !collection.results()
    endif
  else
    -- we must be at BBLOCK level just collect any CTWALLS under detail groups so we can apply fittings to them
    do !member values !this.owningelement.members
      if(!member.type.eq('DETGRP')) then
        !groups.append(!member)
      endif
    enddo
    if(!groups.empty().not()) then
      !collection     = object COLLECTION()
      !collection.addType('ROOM')
      !collection.addType('CTWALL')
      !collection.scope(!groups)
      !this.wallList  = !collection.results()
    endif
  endif

  -- Update grid
  !this.updateWallList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useActiveFittings
--
-- Description: Get walls from current active element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useActiveFittings()

  -- Unenhance walls
  !this.tidyWalls()

  -- Tidy graphics
  !this.tidy()

  -- Clear grid
  !this.fittingGrid.clearGrid()
  -- Initialise Variables
  !this.fittingList.clear()
  !this.fittingNames.clear()
  !groups = ARRAY()

  -- Collect all walls for current active element
  if !this.workingElement.unset() then
    !this.workingElement = !this.owningelement
  endif

  if !this.workingElement.type.eq('CTWALL') then

    -- Get DETGRP of active element
    do !member values !this.workingElement.members
      if(!member.type.eq('DETGRP')) then
        !groups.append(!member)
      elseif(!member.type.eq('WLFEAT')) then
        do !wallFeature values !member.members
          if (!wallFeature.type.eq('WLFITT')) then
            !groups.append(!wallFeature)
          endif
        enddo
      endif
    enddo

  else

    -- Get DETGRP of active element
    do !member values !this.workingElement.members
      if(!member.type.eq('DETGRP')) then
        -- if we have a CTWALL under a detail group for this room (or level) then omit it because
        -- the wall appears in the wall list previously and wall members should not appear in a room list
        !ctWallCount = 0
        do !memberVal values !member.members
          if !memberVal.type.eq('CTWALL') then
            !ctWallCount = !ctWallCount + 1
          endif
        enddo
        if !ctWallCount.eq(0) then
          !groups.append(!member)
        endif
      endif
    enddo

  endif

  if(!groups.empty().not()) then
    !collection     = object COLLECTION()
    !collection.addType('ELFITT')
    !collection.addType('HVACFI')
    !collection.addType('FPFITT')
    !collection.addType('INFITT')
    !collection.addType('FURNIT')
    !collection.addType('FIXTUR')

    -- don't include ceiling fittings etc. as they are handled elsewhere
    --!collection.filter(object EXPRESSION('OSTYPE EQ |DETGRP|'))
    !collection.filter(object EXPRESSION('TYPE OF OWN NEQ |CLNTIL|'))

    !collection.scope(!groups)
    !this.fittingList.clear()
    !this.fittingList = !collection.results()
  endif

  -- Update grid
  !this.updateFittingList()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      tidyWalls
--
-- Description: Tidy walls
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyWalls()

  -- Get current list
  !element = !this.fittingGrid.getSelectedRows()[1][1]
  handle ANY
    return
  endhandle
  unenhance $!element
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()
  -- Remove aid graphics
  AID CLEAR ALL $!<this.aidAxes>
  handle ANY
  endhandle
  AID CLEAR text $!<this.aidText>
  handle ANY
  endhandle
  AID CLEAR line $!<this.aidLines>
  handle ANY
  endhandle
  AID CLEAR cyli $!<this.aidLines>
  handle ANY
  endhandle
  AID CLEAR sphere $!<this.aidLines>
  handle ANY
  endhandle
  AID CLEAR box $!<this.aidBox>
  handle ANY
  endhandle
  AID CLEAR text $!<this.workingElementAid>
  handle ANY
  endhandle
  AID CLEAR text $!<this.workingFittingAid>
  handle ANY
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateWallList
--
-- Description: Get walls from graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateWallList()

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('NAME')
  !attributes.append('TYPE')

  -- Load grid
  if !this.wallList.empty().not() then

    !block                  = object BLOCK('!this.wallList[!evalIndex].string()')
    !dbNames                = !this.wallList.evaluate(!block)
    !this.wallNames         = !dbNames

    using namespace 'Aveva.Pdms.Presentation'
    !nds                = object NETDATASOURCE('Walls', !attributes, !dbNames)

    !this.wallGrid.bindToDataSource(!nds)
    !this.wallGrid.setSelectedRowTags(!this.wallNames)
  else
    !this.workingElement = object DBREF()
  endif

  !this.wallGrid.clearRowSelection()
  if !this.wallGrid.getrows().size().eq(1) then
    !this.wallGrid.selectRow(1)
    !this.mtCrt.active = TRUE
    !this.aidLines()
    handle ANY
    endhandle
  else
    !this.mtCrt.active = FALSE
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateFittingList
--
-- Description: Get walls from graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateFittingList()

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('NAME')
  !attributes.append('TYPE')

  -- Load grid
  if(!this.fittingList.empty().not()) then
    !block                  = object BLOCK('!this.fittingList[!evalIndex].string()')
    !dbNames                = !this.fittingList.evaluate(!block)
    !this.fittingNames      = !dbNames

    using namespace 'Aveva.Pdms.Presentation'
    !nds                = object NETDATASOURCE('fittings', !attributes, !dbNames)
    !this.fittingGrid.bindToDataSource(!nds)
    !this.fittingGrid.setSelectedRowTags(!this.fittingNames)
  else
    !this.workingFitting = object DBREF()
  endif

  !this.fittingGrid.clearRowSelection()
  !this.ftModElFitt.active = FALSE
  !this.mtCopy.active = FALSE
  !this.ftDelElFitt.active = FALSE


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectWall
--
-- Description: Select Wall from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectWall(!passedArray is ARRAY)

  !this.workingElement = !passedArray[0]
  handle ANY
    !this.workingElement = !passedArray[0][1].dbref()
    handle ANY
      !this.workingElement = object DBREF()
    endhandle
  endhandle

  -- Initialise Variable
  unenhance all
  handle ANY
  endhandle
  --enhance $!this.workingElement colour red

  !this.aidLines()
  handle ANY
  endhandle

  !this.mtCrt.active = TRUE
  !this.currentOwner.val      = 'Storage Area: ' & !this.workingElement.namn
  handle ANY
    !this.currentOwner.val      = 'No storage area selected'
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectWall
--
-- Description: Select Wall from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectWall()

  !rows = !this.wallGrid.getSelectedRows()
  !this.workingElement = !rows[1][1].dbref()
  -- Initialise Variable
  enhance $!this.workingElement colour red

  !this.aidLines()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectFitting
--
-- Description: Select fitting from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectFitting(!passedArray is ARRAY)

  --remove highlighting from wallGrid items
  !workingElement = !this.workingElement
  unenhance $!workingElement
  handle ANY
  endhandle

  !rows = !this.fittingGrid.getrows()
  do !i from 1 to !rows.size()
    !name = !rows[!i][1]
    unenhance $!name
    handle ANY
    endhandle
  enddo

  !this.workingFitting = !passedArray[0]
  handle ANY
    !this.workingFitting = !passedArray[0][1].dbref()
    handle ANY
      !this.workingFitting = object DBREF()
    endhandle
  endhandle

  !this.aidLines()
  handle ANY
  endhandle

  !this.ftModElFitt.active = TRUE
  !this.mtCopy.active = TRUE
  !this.ftDelElFitt.active = TRUE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectFitting
--
-- Description: Select fitting from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectFitting(!element is DBREF)

  --remove highlighting from wallGrid items
  !workingElement = !this.workingElement
  unenhance $!workingElement
  handle ANY
  endhandle

  !rowNum = -1
  !rows = !this.fittingGrid.getrows()
  do !i from 1 to !rows.size()
    !name = !rows[!i][1]
    if !name.dbref().name.eq(!element.name) then
      !rowNum = !i
    endif
    unenhance $!name
    handle ANY
    endhandle
  enddo

  if !rowNum.eq(-1) then
    if !this.fittingGrid.getrows().size().eq(1) then
      !this.fittingGrid.selectRow(1)
    else
      !this.fittingGrid.clearRowSelection()
    endif
    !!alert.warning('selected element can not be located in the current storage area')
    !this.aidLines()
    handle ANY
    endhandle
    return
  endif

  !this.fittingGrid.clearRowSelection()
  !this.fittingGrid.selectRow(!rowNum)

  !this.workingFitting = !element

  !this.aidLines()
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    --!gadget.val   = STRING()
    !gadget.val   = ''
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

  !this.updateGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkWord
--
-- Description: Check word is valid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkWord(!gadget is GADGET )

  -- Initialise Variables
  !name        = !gadget.val

  -- Check that the input string is a WORD
  !check       = !!admChkWord(!name)
  if (!check.not()) then
    if (!this.element.set()) then
      !gadget.val  = !this.element.purp
    else
      !gadget.val  = |unset|
    endif
    !!alert.error('Attribute must be alphabetical.')
    return false
  endif

  !this.updateGadgets()

endmethod

------------------------------------------------------------------------
--
-- Method:      selectSpec
--
-- Description: Selecting spec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectSpec()

  if !this.elementType.eq('FPFITT') then
    !type = 'FPFI'
  elseif !this.elementType.eq('ELFITT') then
    !type = 'ELFI'
  elseif !this.elementType.eq('INFITT') then
    !type = 'INFI'
  elseif !this.elementType.eq('HVACFI') then
    !type = 'HVFI'
  elseif !this.elementType.eq('FURNIT') then
    !type = 'FURN'
  elseif !this.elementType.eq('FIXTUR') then
    !type = 'FIXT'
  endif

  !!stChooseData.cleardata()
  !!stChooseData.settitle(!this.elementType)
  !!stChooseData.setdata('ROOM', !type)
  show !!stChoose
  !!stChoose.frCreate.visible = false
  !!stChoose.bnApply.callback   = '!!accfittingsdefinition.setSpec()'

endmethod

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: create Fittings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING      Element to be created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!elementType is STRING)

  !this.elementType          = !elementType
  !oriAtts[1] = 'Orientation'
  !oriAtts[2] = 'Position'

  -- Set up attribute data
  !attributeData = object DBEATTRIBSEARCH(object DBREF(), 'NAngle', !oriAtts)
  !element         = !attributeData.element(!this.owningelement)
  !this.definition            = object DBEFITTING()
  !this.definition.initialise(!element)
  !this.selectedSpec.val = 'Specification: Unset'

  -- Edit panel title
  !this.editTitle.val         = 'Attributes '
  !this.position.callback     = '!this.positionOption()'
  !this.crtAccept.tag         = ' Create  ' & !elementType
  !this.crtAccept.callback    = '!this.create()'
  !this.crtMain.tag           = 'Back to Main Tasks'
  !this.mode                  = 'Create'
  !this.modDiscardIcon.active = false
  !this.modDiscard.active     = false

  if (!elementType eq 'ELFITT') then
    !this.specSelect.tag      = 'Select Electrical Fitting Specification...'
  elseif (!elementType eq 'INFITT') then
    !this.specSelect.tag      = 'Select Information Fitting Specification...'
  elseif (!elementType eq 'HVACFI') then
    !this.specSelect.tag      = 'Select HVAC Fitting Specification...'
  elseif (!elementType eq 'FPFITT') then
    !this.specSelect.tag      = 'Select Fire Protection Fitting Specification...'
  elseif (!elementType eq 'FURNIT') then
    !this.specSelect.tag      = 'Select Furniture Specification...'
  elseif (!elementType eq 'FIXTUR') then
    !this.specSelect.tag      = 'Select Fixture Specification...'
  endif

   -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.aidLines, !this.aidText, !this.aidBox)
  !this.updateAttributes()

  -- Setup panes
  !this.createFitting(true)

    -- Create Icons
  !this.crtAcceptIcon.addPixmap(!!pml.getPathName('create.png'))

   -- Setup panes
  !this.specSelect.callback = |!this.selectSpec()|

  -- clear the posRef member
  !this.posRef = object DBREF()

  -- if the workingElement type is a CTWALL then find the first RPATH RPOINT and set it as this in case the user doesn't pick a position
  -- before pressing the create button
  if !this.workingElement.type.eq('CTWALL') then
    var !posRef mem 1 of RPATH 1 of $!this.workingElement
    !this.posRef = !posRef.dbref()
  endif


endmethod

-----------------------------------------------------------------------
--
-- Method:      setSpec
--
-- Description: Set spec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING      Element to be created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpec()

  -- select the item name to be used from the current row
  !spec = !!stChoose.getSelection()
  !this.selectedSpec.val = !spec.namn
  !!stChoose.hide()
  !this.setJustification()
  handle ANY
  endhandle
  !this.updateGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      positionOption
--
-- Description: Position option to choose explicit or relative
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .positionOption()

  !indx =  !this.position.val
  !selection = !this.position.rtoggle(!indx)
  if(!selection.tag.upcase().matchwild('*EXPLICIT*'))then
   !this.expliPosition.visible = true
   !this.relPosition.visible = false
  else
   !this.expliPosition.visible = false
   !this.relPosition.visible = true
  endif

  if(!this.mode.set())then
   if(!this.mode.upcase() eq 'MODIFY')then
     !this.modify(!this.elementType)
     !this.draw()
     !this.aidLines()
   endif
  endif

endmethod

-----------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set Fitting position to picked position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!data is EDGPOSITIONDATA)
  -- Initialise Variables
  !position = !data.position.wrt(World)

  if !this.xLock.val.not() then
    !this.xOffset.val = !position.wrt( !this.workingElement ).east.nint()
  endif

  if !this.yLock.val.not() then
    !this.yOffset.val = !position.wrt( !this.workingElement ).north.nint()
  endif

  --!this.xOffset.val = !position.wrt( !this.workingElement ).east.nint()
  --!this.yOffset.val = !position.wrt( !this.workingElement ).north.nint()

  !this.offset()

  -- Update pos control gadget
  --!this.fittingPosition.xyz(!position.east, !position.north, !position.up)
  --set position of Fitting from pos control values
  --!this.setPosition()

endmethod

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: set position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setPosition()

    -- Initialise Variables

  --get array of positions from positioning control
  !positionArray       = !this.fittingPosition.xyz()

  --set position object with positions, wrt world
  !position       = object POSITION()
  !position.east  = !positionArray[0]
  !position.north = !positionArray[1]
  !position.up    = !positionArray[2]
  !position.origin = /*

   -- Set position of reference plane
  !this.definition.plane.position  = !position
  -- Update db element
  if(!this.definition.dynamicUpdate.or(!this.definition.modifyMode)) then
    !this.definition.dbelement.position    = !this.definition.plane.position
    !this.definition.dbelement.orientation = !this.definition.plane.orientation

  -- Redraw element aid graphics
  else
    !pos[1] = !positionArray[0]
    !pos[2] = !positionArray[1]
    !pos[3] = !positionArray[2]
    !this.definition.position         = !pos
  endif

  !this.updateData()
  if !this.definition.dbelement.unset().not() then
    !this.draw()
  else
    !this.definition.draw()
  endif
  !this.aidLines()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify Fittings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING      Element Type to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify(!element is STRING)

  if !element.unset() then
    !!alert.warning('No fitting selected for modification')
    return
  endif

  !!ce = !this.element

  if(!!ce.type neq !element.substring(1,6).upcase())then
    !!alert.warning('Not in $!element hierarchy')
    return
  endif

  -- Set definition
  !this.element = !!ce
  !this.definition          = object DBEFITTING(!this.element)

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.aidLines, !this.aidText, !this.aidBox)

  -- Edit panel title
  !this.editTitle.val        = 'Attributes '
  !this.position.callback    = '!this.positionOption()'
  !this.crtAccept.tag        = 'Accept Changes'
  !this.modDiscard.tag       = 'Discard Changes'
  !this.crtAccept.callback   = '!this.modify()'
  !this.crtMain.tag          = 'Back to Main Tasks'
  !this.elementType          = !element
  !this.mode                 = 'Modify'
  if (!element eq 'ELFITT') then
    !this.specSelect.tag      = 'Select Electrical Fitting Specification...'
  elseif (!element eq 'INFITT') then
    !this.specSelect.tag      = 'Select Information Fitting Specification...'
  elseif (!element eq 'HVACFI') then
    !this.specSelect.tag      = 'Select HVAC Fitting Specification...'
  elseif (!element eq 'FPFITT') then
    !this.specSelect.tag      = 'Select Fire Protection Fitting Specification...'
  elseif (!element eq 'FURNIT') then
    !this.specSelect.tag      = 'Select Furniture Specification...'
  elseif (!element eq 'FIXTUR') then
    !this.specSelect.tag      = 'Select Fixture Specification...'
  endif

      -- Create Icons
  !this.crtAcceptIcon.addPixmap(!!pml.getPathName('accept.png'))
  !this.crtAcceptIcon.active  = FALSE
  !this.modDiscardIcon.active = FALSE
  !this.modDiscard.active     = FALSE
  !this.crtAccept.active      = FALSE

  -- Update gadgets
  !this.updateAttributes()

  -- Setup panes
  !this.modify(true)
  !this.specSelect.callback = |!this.selectSpec()|

endmethod

-----------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Display modify pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify(!active is BOOLEAN)

 -- Make task pane active
  if(!active) then
    -- Set current pane
    !this.currentPane         = !this.editPane

    -- Change form title to reflect the active pane
    --!this.formTitle           = 'Modify $!this.elementType'
  else
    !this.tidy()
  endif

  --- Show/hide task pane
  --!this.showEditPanel(TRUE)

endmethod

------------------------------------------------------------------------
--
-- Method:      modifySelection
--
-- Description: Modify (modify the current element in the fitting list)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifySelection()

  !element = !this.workingFitting
  handle ANY
    !!alert.warning('please select a valid fitting from the above list to modify')
    return
  elsehandle NONE
    if !element.unset() then
      !!alert.warning('please select a valid fitting from the above list to modify')
      return
    endif
  endhandle

  -- Update Block Attributes
  --!this.updateData()

  -- Define UNDO Information
  --!this.undo.description('Modified (' & !this.element.namn & ')')
  !this.undo.add()

  -- Modify fitting
  !!ce = !this.workingFitting
  handle ANY
    !fitt = !this.fittingGrid.getSelectedRows()
    !this.workingFitting = !fitt[1][1].dbref()
  endhandle
  !this.element = !!ce
  !this.elementType = !!ce.type

  if !this.editPane.visible.not() then
    !this.showEditPanel(TRUE)
    !this.definition = object DBEFITTING(!this.workingFitting)
    !this.xLock.val = FALSE
    !this.yLock.val = FALSE
    !this.xOffset.active = TRUE
    !this.yOffset.active = TRUE
  endif

  !this.modify(!this.elementType)

  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      aidLines()
--
-- Description: Modify (modify the current element in the fitting list)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidLines()

  unenhance all


  -- tidy any existing aidLines
  !workingElementAid = !this.workingElementAid
  !workingFittingAid = !this.workingFittingAid
  aid clear text $!workingElementAid
  handle ANY
  endhandle
  aid clear text $!workingFittingAid
  handle ANY
  endhandle

  --put a text descriptor at the working element
  if !this.workingElement.unset().not() then
    !workingElement = !this.workingElement
    !name = !workingElement.fullname
    !pos = !workingElement.position.wrt( /* )
    aid text num $!this.workingElementAid '$!name' at $!pos
    handle ANY
    endhandle
    enhance $!this.workingElement colour red
  endif

  if !this.definition.dbelement.unset().not() then
    !workingFitting = !this.workingFitting
    if( !workingFitting.isNamed ) then
      !name = !workingFitting.namn
    else
      !name = 'Fitting'
    endif
    !pos = !workingFitting.position.wrt( /* )
    aid text num $!this.workingFittingAid '$!name' at $!pos
    handle ANY
    endhandle
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      pickElement
--
-- Description: Setup EDG pick event for picking a wall or room element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickElement()

  -- Initialise Variables
  !prompt               = 'Pick active element'
  !packet               = object EDGPACKET()
  !packet.elementPick(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = '!!accfittingsdefinition.graphicalPick(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      graphicalPick
--
-- Description: set the picked element as ce so that the useActiveWalls method can pick it up and populate the walls list.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .graphicalPick(!data is EDGPICKDATA)

  !pick = !data.item
  !this.currentElemPick(!pick)

endmethod

------------------------------------------------------------------------
--
-- Method:      currentElemPick
--
-- Description: set the picked element as ce so that the useActiveWalls method can pick it up and populate the walls list.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .currentElemPick(!pick is DBREF)

  var !world ref of /*
  !worldRef = !world.dbref()

  -- find the nearest owning ROOM,BLEVEL OR BBLOCK so we can set the navigator to point to the correct element.
  !elem = !pick
  do
    !type = !elem.type
    handle ANY
      !elem = !elem.owner
      handle ANY
        return
      endhandle
      skip
    endhandle
    if !type.eq('ROOM') or !type.eq('BLEVEL') or !type.eq('BBLOCK') or !type.eq('CTWALL') then
      !activeElem = !elem
      break
    elseif !elem.eq(!worldRef) then
      return
    else
      !elem = !elem.owner
    endif
  enddo

  !this.owningelement = !activeElem
  !this.useActiveWalls()
  !this.useActiveFittings()

  !type = !pick.type
  if (((!type.eq('HVACFI')) or (!type.eq('INFITT')) or (!type.eq('ELFITT')) or (!type.eq('FPFITT')) or (!type.eq('FURNIT')) or (!type.eq('FIXTUR')))) then
    -- try and navigate to the picked element in the fitting list
    !this.selectFitting(!pick)
  else
    !this.workingFitting = object DBREF()
  endif



endmethod

------------------------------------------------------------------------
--
-- Method:     pickPosition
--
-- Description: pick the position of the new opening
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickPosition()

  if !this.workingElement.type.neq('CTWALL') then

    -- Define EDG positional pick for room fittings
    !prompt               = 'Pick position'
    !packet               = object EDGPACKET()
    !packet.definePosition(!prompt)
    !packet.description   = 'Fittings position pick'
    !packet.remove        = true
    !packet.action        =  '!!' & !this.name() & '.position(!this.return[1])'

  else

    -- Initialise Variables
    !prompt               = 'Pick position'
    !packet               = object EDGPACKET()
    !packet.definePosition(!prompt)
    !packet.description   = !this.edgDescription
    !packet.remove        = TRUE
    !packet.action        =  '!!' & !this.name() & '.generatePosition(!this.return[1])'

  endif

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:     generatePosition
--
-- Description: Position pick EDG callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generatePosition(!data is EDGPOSITIONDATA)

  !reference = !!ce

  -- go and get the appropriate path
  !wall = !this.workingElement
  var !wallRpath RPATH 1 of $!wall
  handle any
    !!alert.warning('Cannot find an RPATH for selected wall')
    return
  endhandle
  !path = !wallRpath.dbref()
  !polyLine = object PMLPOLYLINE(!path)

  -- Initialise Variables
  !actualPosition             = !data.position.wrt(World)

  !rpathIntersect    = !polyLine.near(!actualPosition)
  if !rpathIntersect.unset() then
    return
  endif

  !rpath = object RPATHPOSITIONING(!path)
  !rpath.setPositionNear(!rpathIntersect, FALSE)
  !this.posRef            = !rpath.referencePoint
  !zdist                  = !rpath.zdistance

  !plane = object PLANE()
  !plane.position = !actualPosition
  !ori = Z is D wrt world
  !plane.orientation = !ori
  !distance = !rpathIntersect.distance(!plane)
  --  Position when offset
  !originPosition  = !rpathIntersect.offset(U wrt World, !distance)
  !vdist                = !rpathIntersect.distance(!originPosition )

  !position = !actualPosition

  -- get the two RPATH points that the picked point lie between
  !point1 = !this.posRef
  !!ce = !point1
  next
  handle any
    -- handle closed walls
    first
  endhandle

  !point2 = !!ce

  -- get the orientation of the fitting
  !this.definition.fittingOri = !this.definition.getWallZdir(!point1, !point2)

  -- Update pos control gadget
  !this.fittingPosition.xyz(!position.east, !position.north, !position.up)

  -- update the zdist and vdist
  --!this.xOffset.val = !zdist
  --!this.yOffset.val = !vdist

  if !this.xLock.val.not() then
    !this.xOffset.val = !zdist
  endif

  if !this.yLock.val.not() then
    !this.yOffset.val = !vdist
  endif
  -- APPLY POSITION DIRECT TO FITTING SO THAT WE CAN SEE WHERE IT WILL END UP --
  -- DO NOT HOWEVER UPDATE THE DEFINITION OF THE OBJECT BECAUSE THIS IS STORING THE --
  -- CURRENT POSITION OF THE FITTING SO THAT WE CAN RESTORE THE POSITION ON USER CANCEL --
  -- check to see if we have a hole

 if !this.definition.dbelement.set() then
    if !this.definition.dbelement.owner.type.eq('WLFITT') then
      if !this.definition.dbelement.owner.posRef.type.eq('WLOPEN') then
        !this.definition.dbelement.owner.posRef.posRef = !this.posRef
        !this.definition.dbelement.owner.posRef.zdist  = !this.xOffset.val
        !this.definition.dbelement.owner.posRef.vdist  = !this.yOffset.val
        !this.definition.dbelement.owner.zdist         = 0
        !this.definition.dbelement.owner.vdist         = !this.yOffset.val
      else
        !this.definition.dbelement.owner.posRef  = !this.posRef
        !this.definition.dbelement.owner.zdist   = !this.xOffset.val
        !this.definition.dbelement.owner.vdist   = !this.yOffset.val
      endif
    else
      !this.definition.dbelement.owner.posRef = !this.posRef
      !this.definition.dbelement.owner.zdist  = !this.xOffset.val
      !this.definition.dbelement.owner.vdist  = !this.yOffset.val
    endif
  else
    !this.updateData()
  endif
  !this.draw()
  !this.aidLines()

  !this.updateGadgets()
  !!ce = !reference

endmethod

------------------------------------------------------------------------
--
-- Method:     updateGadgets
--
-- Description: Update form gadgets state
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateGadgets()

  if !this.definition.dbelement.unset().not() then
    !this.crtAccept.tag            = 'Accept Changes'
    !this.modDiscard.tag           = 'Discard Changes'
    !this.crtAcceptIcon.active    = TRUE
    !this.crtAccept.active        = TRUE
    !this.modDiscardIcon.active   = TRUE
    !this.modDiscard.active       = TRUE
  else
    !this.crtAccept.tag            = ' Create  ' & !this.elementType
    !this.modDiscard.tag           = 'Discard Changes'
    !this.crtAcceptIcon.active    = TRUE
    !this.crtAccept.active        = TRUE
    !this.modDiscardIcon.active   = FALSE
    !this.modDiscard.active      = FALSE
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:     updateNumeric
--
-- Description: Numeric gadget callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateNumeric(!gadget is GADGET, !dummyVal is STRING)

  !this.updateGadgets()

endmethod

------------------------------------------------------------------------
--
-- Method:     setJustification
--
-- Description: Set fitting justification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setJustification()

  !ref = !!ce
  !this.applyRotation(!this.angle.val)
  -- get the orientation of the fitting
  !!ce = !this.posRef
  handle ANY
    return
  endhandle

  -- check to see if we have a hole
  if !!ce.type.eq('WLOPEN') then
    !!ce = !!ce.posRef
  endif

  !point1 = !!ce
  next
  handle any
    -- handle closed walls
    first
  endhandle

  !point2 = !!ce

  !fittingOri = !this.definition.getWallZdir(!point1, !point2)

  !x = !fittingOri[1]
  handle ANY
  elsehandle NONE
    !z = !fittingOri[3]
    handle ANY
      return
    elsehandle NONE
      if !this.justification.selection().eq('LEFT') or !this.justification.selection().eq('CENTRE - DIRECTION LEFT') then
        --flip the zdir if the justification is on the opposite wall face
        !z = !z.opposite()
      endif
      --!oriString = 'x is ' + !x.string() + ' and Z is ' + !z.string()
      --!this.definition.dbelement.orientation = !oriString.orientation()
      --handle ANY
      --endhandle
    endhandle
  endhandle

  -- APPLY POSITION DIRECT TO FITTING SO THAT WE CAN SEE WHERE IT WILL END UP --
  -- DO NOT HOWEVER UPDATE THE DEFINITION OF THE OBJECT BECAUSE THIS IS STORING THE --
  -- CURRENT POSITION OF THE FITTING SO THAT WE CAN RESTORE THE POSITION ON USER CANCEL --
  -- check to see if we have a hole

  if !this.definition.dbelement.unset().not() then
    !this.definition.dbelement.owner.wjusl = !this.justification.selection()
    --!this.definition.dbelement.orientation = !oriString.orientation()
    !ori = !this.definition.dbelement.orientation.string().before('and Z is')
    !ori = !ori + ' and Z is ' + !z.string()
    !this.definition.dbelement.orientation = !ori.orientation()
    !this.orientation = !this.definition.dbelement.orientation.wrt( /* )
  else
    !this.updateData()
  endif
  !this.draw()
  handle ANY
  endhandle
  !this.aidLines()

  !this.updateGadgets()

  -- modify the orientation to take the rotation angle into account
  --!this.angle()

  !!ce = !ref

endmethod

------------------------------------------------------------------------
--
-- Method:      getJustification
--
-- Description: returns the justification z direction that corresponds to the face of the wall that the wall fitting is justified to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .getJustification() is DIRECTION

  !ref = !!ce
  -- get the orientation of the fitting
  !!ce = !this.posRef
  handle ANY
    return
  endhandle

  -- check to see if we have a hole
  if !!ce.type.eq('WLOPEN') then
    !!ce = !!ce.posRef
  endif

  !point1 = !!ce
  next
  !point2 = !!ce

  !fittingOri = !this.definition.getWallZdir(!point1, !point2)

  !z = !fittingOri[3]
  if !this.justification.selection().eq('LEFT') or !this.justification.selection().eq('CENTRE - DIRECTION LEFT') then
    --flip the zdir if the justification is on the opposite wall face
    !z = !z.opposite()
  endif

  !!ce = !ref
  return !z

endmethod

------------------------------------------------------------------------
--
-- Method:      getRotation
--
-- Description: get the rotation of fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .getRotation()

  -- the rotation is the angle of y from default
  if !this.definition.dbelement.owner.type.eq('WLFITT') then

    !ori = !this.definition.dbelement.orientation
    !ydir = !ori.ydir()
    !defaultYdir = object DIRECTION('Z WRT WORLD')
    -- get angle from vertical up
    !angle = !defaultYdir.angle(!ydir)
    -- set angle positive or negative according to CW or CCW rotation
    !normal = !ydir.cross(!defaultYdir)
    handle any
    elsehandle none
      if( !normal.angle(!ori.zdir()) gt 90 ) then
        !angle = !angle * -1
      endif
    endhandle
    !this.angle.val = !angle
    handle ANY
    endhandle

  else

    -- get the room orientation

    !roomOri = !this.workingElement.orientation.wrt( /* )
    !roomXdir = !roomOri.xdir()
    !ori = !this.definition.dbelement.orientation.wrt( /* )
    !xdir = !ori.xdir()

    !number = !roomXdir.angle(!xdir)
    handle ANY
      !number = 0
    endhandle

    !dotX = !ori.xdir().dot(!roomOri.ydir())
    !dotY = !ori.ydir().dot(!roomOri.xdir())
    if !dotX.lt(!dotY) then
      -- we have a negative 0 to 180
      !number = !number * -1
    else
      -- the number is ok don't alter it
    endif

    !this.angle.val = !number
    handle ANY
    endhandle

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      setRotation
--
-- Description: set the inset of a door or wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .setRotation(!gadget is GADGET, !select is STRING)

  -- sets the position based on an offset
  --!this.setJustification()
  !this.applyRotation(!this.angle.val)
  handle ANY
    !unset = !this.definition.dbelement.unset()
    handle ANY
      !unset = TRUE
    endhandle
    if !unset then
      !this.definition.draw()
    else
      return
    endif
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      applyRotation
--
-- Description: set the rotation of a fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .applyRotation(!val is REAL)


  -- basic orientation is this
  -- Orientation Y is U and Z is E
  -- minus orientation moves anticlockwise
  -- positive orientation moves clockwise
  -- Convert angle into an orientation
  if !this.definition.dbelement.owner.type.eq('WLFITT') then
    !this.definition.dbelement.owner.wjusl = !this.justification.selection()
    !newValue     = !val
    !wrt          = !this.definition.dbelement.owner.string()
    !orientation  = object ORIENTATION('Y is U ' & !newValue & 'w WRT ' & !wrt & ' and Z is N WRT ' & !wrt )
    if !this.justification.selection().eq('CENTRE - DIRECTION LEFT') then
      -- get the transform values to adjust the central fitting orientation so that it matches the LEFT orientation
      !leftOriTransform = !this.getCentreTransform(!this.definition.dbelement.owner, 'LEFT')
      -- apply transform to the original orientation
      !orientation.alpha = !orientation.alpha + !leftOriTransform[1]
      !orientation.beta = !orientation.beta + !leftOriTransform[2]
      !orientation.gamma = !orientation.gamma + !leftOriTransform[3]
    elseif !this.justification.selection().eq('CENTRE - DIRECTION RIGHT') then
      -- get the transform values to adjust the central fitting orientation so that it matches the RIGHT orientation
      !rightOriTransform = !this.getCentreTransform(!this.definition.dbelement.owner, 'RIGHT')
      -- apply transform to the original orientation
      !orientation.alpha = !orientation.alpha + !rightOriTransform[1]
      !orientation.beta = !orientation.beta + !rightOriTransform[2]
      !orientation.gamma = !orientation.gamma + !rightOriTransform[3]
    endif

    -- APPLY ROTATION DIRECT TO FITTING SO THAT WE CAN SEE WHERE IT WILL END UP --
    -- DO NOT HOWEVER UPDATE THE DEFINITION OF THE OBJECT BECAUSE THIS IS STORING THE --
    -- CURRENT POSITION OF THE FITTING SO THAT WE CAN RESTORE THE POSITION ON USER CANCEL --
    !this.definition.dbelement.orientation = !orientation
    !this.orientation = !this.definition.dbelement.orientation

  else
    -- get the room orientation
    !ori = !this.workingElement.orientation
    !z = !ori.zdir()
    !x = !ori.xdir()
    !y = !ori.ydir()

    if !this.fittingLevel.type.eq('CEILIN') then
      -- set the z orientation so that the fitting is pointing towards the floor
      !z = !z.opposite()
    endif

    !newVal = !val * -1
    !orientation  = object ORIENTATION('Y is ' & !y.string().before('WRT') & ' ' & !newVal & ' ' & !x.string() & ' and Z is ' & !z.string())
    !this.definition.dbelement.orientation = !orientation
    !this.orientation = !this.definition.dbelement.orientation
  endif
  !this.updateGadgets()

endmethod

------------------------------------------------------------------------
--
-- Method:      discard()
--
-- Description: discard any changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .discard()

  -- reinstate position and orientation and then re-load the element
  if !this.workingElement.type.eq('CTWALL') then
    !this.definition.dbelement.own.wJusLine = !this.definition.justification
  endif
  !this.orientation = !this.definition.orientation
  if !this.orientation.unset().not() then
    !this.definition.dbelement.orientation = !this.orientation
  endif
  !zdist = !this.definition.xyOffset[1]
  !vdist = !this.definition.xyOffset[2]

  if !this.workingElement.type.eq('CTWALL') then
    -- check to see if we have a hole
    if !this.definition.dbelement.own.posRef.type.eq('WLOPEN') then
      !this.definition.dbelement.owner.posRef.zdist = !zdist
      !this.definition.dbelement.owner.posRef.vdist = !vdist
      !this.definition.dbelement.owner.zdist = 0
      !this.definition.dbelement.owner.vdist = !vdist
    else
      !this.definition.dbelement.owner.zdist = !zdist
      !this.definition.dbelement.owner.vdist = !vdist
    endif
  else
    !offset = object ARRAY()
    !offset.append(!zdist)
    !offset.append(!vdist)
    !roomElevation = !this.workingElement.position.wrt( /* ).up
    !elevation = !roomElevation + !this.definition.fittingLevel
    !pos = !this.definition.position(!offset, !elevation)
    !this.definition.dbelement.position = !pos
  endif

  !this.definition = object DBEFITTING(!this.definition.dbelement)

  !this.crtAccept.active = FALSE
  !this.crtAcceptIcon.active = FALSE
  !this.modDiscardIcon.active = FALSE
  !this.modDiscard.active     = FALSE
  !this.updateAttributes()

  !this.tidy()

endmethod

------------------------------------------------------------------------
--
-- Method:      setupLevels()
--
-- Description: sets up levels so that you can justify room fittings to the floor covering levels
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .setupLevels()

  if !this.workingElement.unset() then
    return
  endif

  !error1 = 0
  !error1 = 0
  -- collect up any floor coverings and ceilings so that we can populate the option gadget
  var !floorCover collect all FLRCOV for $!this.workingElement
  handle ANY
    !floorCover = object ARRAY()
  endhandle
  var !ceiling collect all CEILIN for $!this.workingElement
  handle ANY
    !ceiling = object ARRAY()
  endhandle

  !rtext = object ARRAY()
  !rtext.append(!this.workingElement.name)
  !rtext.appendarray(!floorCover)
  !rtext.appendarray(!ceiling)
  !rtext = !rtext.unique()

  !dtext = object ARRAY()
  !dtext.append('DEFAULT')
  do !i from 2 to !rtext.size()
    !name = !rtext[!i].dbref().fullname.before ( ' of ROOM ' )
    !dtext.append(!name)
  enddo

  !this.level.dtext = !dtext
  !this.level.rtext = !rtext

endmethod

------------------------------------------------------------------------
--
-- Method:      setLevel()
--
-- Description: sets the level at which the fitting will sit
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .setLevel()

  !ref = !!ce

  if !this.definition.dbelement.unset().not() then

    !currentOri = !this.definition.dbelement.orientation
    handle ANY
      return
    endhandle
    !x = !currentOri.wrt( /* ).xdir()
    !y = !currentOri.wrt( /* ).ydir()

    !this.fittingLevel = !this.level.selection('Rtext').dbref()
    !worldLevel = !this.fittingLevel.position.wrt( /* ).up
    !position = !this.definition.dbelement.position.wrt( /* )
    handle ANY
      -- the fitting has not yet been created so do nothing
    elsehandle NONE
      !position.up = !worldLevel
      !this.definition.dbelement.position = !position
      !orientation = !this.fittingLevel.orientation.wrt( /* )
      !z = !orientation.zdir()
      !!ce = !this.definition.dbelement
      if !this.fittingLevel.type.eq('CEILIN') then
        -- set the z orientation so that the fitting is pointing towards the floor
        !z = !z.opposite()
      endif

      !newOri = 'Y is ' & !y.string() & ' and Z is ' & !z.string()
      ori $!newOri
      !this.orientation = !newOri.orientation()
    endhandle

  else

    -- the dbelement has not yet been set so we need to store the level in the object so that we can update it when the dbelement is created
    !this.fittingLevel = !this.level.selection('Rtext').dbref()

    -- get the working element orientation
    !orientation = !this.workingElement.orientation.wrt( /* )
    !x = !orientation.xdir()
    !y = !orientation.ydir()
    !z = !orientation.zdir()
    if !this.fittingLevel.type.eq('CEILIN') then
      -- set the z orientation so that the fitting is pointing towards the floor
      !z = !z.opposite()
    endif

    !newOri = 'Y is ' & !y.string() & ' and Z is ' & !z.string()
    !this.orientation = !newOri.orientation()
  endif

  !this.updateData()
  !this.draw()
  !this.updateGadgets()

  !!ce = !ref

endmethod

------------------------------------------------------------------------
--
-- Method:      copyFitting()
--
-- Description: copy the selected fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .copyFitting()

  !element = !this.workingFitting
  handle ANY
    !!alert.warning('please select a valid fitting from the above list to copy')
    return
  elsehandle NONE
    if !element.unset() then
      !!alert.warning('please select a valid fitting from the above list to copy')
      return
    endif
  endhandle
  if !element.owner.type.eq('DETGRP') then
    -- just copy the fitting where it is
    !!ce = !element
    !type = !element.type
    new $!type copy prev
    !newFitting = !!ce
  elseif !element.owner.type.eq('WLFITT') then
    !posRef = !element.owner.posRef
    if !posRef.unset() then
      -- just copy the fitting where it is
      !!ce = !element.owner
      new WLFITT copy prev
      !newWallFitting = !!ce
      !newFitting = !!ce.members[1]
    else
      if !posRef.type.eq('WLOPEN') then
        --we need to delete the wall fitting and the wall opening
        !!ce = !posRef
        new WLOPEN copy prev
        !newPosRef = !!ce
        !!ce = !element.owner
        new WLFITT copy prev
        posRef $!newPosRef
        !newWallFitting = !!ce
        !newFitting = !!ce.members[1]
      else
        -- just copy the fitting where it is
        !!ce = !element.owner
        new WLFITT copy prev
        !newWallFitting = !!ce
        !newFitting = !!ce.members[1]
      endif
    endif
  endif

  -- update the fittings list
  !this.useActiveFittings()

  -- select the new fitting in the list and modify it
  !this.selectFitting(!newFitting)
  !this.modifySelection()
endmethod

------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: draw aidLines for the current element selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .draw()

  -- Remove current graphics
  !this.tidy()
  -- draw aid graphics for current element or for definition object
  if !this.definition.dbelement.unset().not() then
    !tempDefinition = object DBEFITTING(!this.definition.dbelement)
    !tempDefinition.aidNumbers(!this.aidAxes, !this.aidLines, !this.aidText, !this.aidBox)
  else
    !tempDefinition = !this.definition
  endif
  !tempDefinition.draw()
  handle any
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      managedHoleCreate
--
-- Description: Create a hole in the hole management system by
--              projecting the selected opening onto a selected
--              penetrated element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       opening to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .managedHoleCreate() is BOOLEAN

  -- Load current element
  !element             = !this.workingFitting
  if !element.unset() then
     !!alert.error('No element selected')
     return false
  endif

  !this.enhancePenetrated = ARRAY()
  -- invoke hole definition tool
  !this.managedHoleProfile = object HMHOLEFROMPROFILE()
  !profile = !this.managedHoleProfile.setPenetrating(!element)
  if( !profile.unset() ) then
    !!alert.error('Cannot make a managed hole because the selected opening has no hole boundary definition')
    return false
  endif

  !this.pickPenetrated()

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .pickPenetrated()
--
-- Description: Set EDG to pick penetrated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .pickPenetrated()

  -- Define packet for penetrated items
  !packet                = object EDGPACKET()
  !packet.pickPacket.stdGraphic('Pick penetrated object or ESC to exit')
  !packet.description    = 'Pick Penetrated item'
  !packet.priority       = 3
  !packet.action         = '!!' & !this.name() & '.pickPenetratedEvent(!this.return[1])'
  !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE inset(|PANE|,|HPLATE|,|CPLATE|)'
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Add to system
  !!edgCntrl.add(!packet)

endmethod

----------------------------------------------------------------------
--
-- Method:      .pickPenetratedEvent()
--
-- Description: EDG callback for penetrated item pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .pickPenetratedEvent(!data is EDGPICKDATA)

  !positionData          = !data.positionData()

  -- get pick position and plane
  if(!positionData.line.set()) then
    !position = !positionData.line.intersection(!positionData.pointVector)
    !plane    = object PLANE()
  elseif (!positionData.plane.set()) then
    !position = !positionData.pointVector.intersection(!positionData.plane)
    !plane    = !positionData.plane
  elseif (!positionData.position.set()) then
    !position = !positionData.position.wrt( /* )
    !plane    = object PLANE()
  endif

  -- set the penetrated element and check that it is valid
  !this.managedHoleProfile.setPenetrated(!data.item, !position, !plane)
  !penetrated = !this.managedHoleProfile.getPenetrated()
  if( !penetrated.empty() ) then
    !this.tidyManagedHole()
    !!alert.error('Selected item is not valid for creating Managed Holes')
    return
  endif

  -- graphical feedback
  !this.updatePenetrated(!penetrated)

  if(!!alert.confirm('OK to create a managed hole in the selected item').eq('YES')) then

    -- Define UNDO
    !undoManagedHole  = object UNDOABLE()

    !undoManagedHole.description('Create Managed Hole (PROF)')
    !undoManagedHole.add()

    -- create virtual hole
    !error   = ''
    !virtualHole = !this.managedHoleProfile.createVirtualFixing()
    handle any
      !error = !!error.text
    elsehandle none
      -- create managed hole association
      !this.managedHoleProfile.createManagedHole()
      handle any
        !error    = !!error.text
        -- clean up virtual hole
        if( not badref(!virtualHole) ) then
          !saveCE = !!ce
          !!ce    = !virtualHole
          DELETE FRMW
          handle any
          endhandle
          !!ce    = !saveCE
          handle any
          endhandle
        endif
      endhandle
    endhandle
    if( !error.empty().not() ) then
      !error = 'Cannot create Managed Hole: ' + !error
      !!alert.error(!error)
    endif

    !undoManagedHole.endUndoable()

  endif

  !this.tidyManagedHole()

endmethod

------------------------------------------------------------------------
--
-- Method:      .updatePenetrated()
--
-- Description: Update penetrated items list and highlight penetrated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .updatePenetrated(!penetratedItems is ARRAY)

  !oldList                = !this.enhancePenetrated
  !this.enhancePenetrated = ARRAY()

  -- unenhance old list
  UNENHANCE ALL FROM !oldList

  !item = !penetratedItems[1]

  -- to avoid bug where HPANEL cannot be highlighted
  if( !item.hardType eq 'HPANEL' ) then
    var !temp COLL ALL HPLATE FOR $!item
    !this.enhancePenetrated.appendarray(!temp)
  elseif( !item.hardType eq 'CPANEL' ) then
    var !temp COLL ALL CPLATE FOR $!item
    !this.enhancePenetrated.appendarray(!temp)
  else
    !this.enhancePenetrated.append(!item.string())
  endif

  -- enhance new list
  !enhance = !this.enhancePenetrated
  ENHANCE ALL FROM !enhance COL 16

endmethod

------------------------------------------------------------------------
-- Method:      tidyManagedHole()
--              cleanup hole management data
------------------------------------------------------------------------
define method .tidyManagedHole()

  !enhanceList = !this.enhancePenetrated
  UNENHANCE ALL FROM !enhanceList

  -- Remove applications events from system
  !!edgCntrl.remove('Pick Penetrated')

endmethod

------------------------------------------------------------------------
-- Method:      setExtraAtts()
--              sets up the tags for any extra element attributes, if there are none then it will
--              hide the extraAtts fold up panel
------------------------------------------------------------------------
define method .setupExtraTags(!type is STRING)

  -- set panel to be visible as default
  !this.extraAtts.visible = TRUE
  !this.extraAtts.expanded = TRUE

  if !type.eq('ELFITT') then
    !this.extraAtt1.tag = 'Rating:'
    !this.extraAtt2.tag = 'Operational Temp:'
    !this.extraAtt1.val = '0'
    !this.extraAtt2.val = '0'
    !this.extraAtt2.visible = TRUE
  elseif !type.eq('HVACFI') then
    !this.extraAtt2.tag = 'Operational Temp:'
    !this.extraAtt2.val = '0'
    !this.extraAtt1.visible = FALSE
  elseif !type.eq('INFITT') then
    !this.extraAtt1.tag = 'Signage Text:'
    !this.extraAtt1.val = ''
    !this.extraAtt2.visible = FALSE
  elseif !type.eq('FPFITT') then
    !this.extraAtt1.tag = 'Hazard:'
    !this.extraAtt1.val = ''
    !this.extraAtt2.visible = FALSE
  else
    !this.extraAtt1.tag = ''
    !this.extraAtt2.tag = ''
    !this.extraAtts.visible = FALSE
    !this.extraAtts.expanded = FALSE
    !this.extraAtt1.val = ''
    !this.extraAtt2.val = ''
  endif

endmethod

------------------------------------------------------------------------
-- Method:      setExtraAtts()
--              sets any fitting specific attributes (for instance ELFITTS have an elRating attribute and the others do not)
------------------------------------------------------------------------
define method .setExtraAtts()

  !type = !this.elementType
  !text1 = !this.extraAtt1.val
  !text2 = !this.extraAtt2.val

  -- if the element type is an ELFITT or HVACFITTING then perform a check on the value being entered as we require a real number to be input.
  if !type.eq('ELFITT') or !type.eq('HVACFI') then
    !unusedFirstCheck = !text1.real()
    handle ANY
      !!alert.warning('Please enter a valid real number for this attribute')
      !this.extraText1        = !this.definition.extraText1
      !this.extraAtt1.val     = !this.extraText1
      return
    endhandle

    !unusedSecondCheck = !text2.real()
    handle ANY
      !!alert.warning('Please enter a valid real number for this attribute')
      !this.extraText2        = !this.definition.extraText2
      !this.extraAtt2.val     = !this.extraText2
      return
    endhandle
  endif

  !type = !this.elementType
  if !type.eq('ELFITT') or !type.eq('HVACFI') or !type.eq('INFITT') or !type.eq('FPFITT') then
    !this.extraText1 = !text1
  else
    !this.extraText1 = ''
  endif

  if !type.eq('ELFITT') or !type.eq('HVACFI') or !type.eq('INFITT') or !type.eq('FPFITT') then
    !this.extraText2 = !text2
  else
    !this.extraText2 = ''
  endif

  !this.updateGadgets()

endmethod
------------------------------------------------------------------------
--
-- Method:      .lockPosition
--
-- Description: method for ensuring the user can't lock both positions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .lockPosition( !gadget is GADGET, !select is STRING)

  if !select.eq('SELECT') then
    if !gadget.eq(!this.yLock).and(!this.xLock.val) then
       !this.xLock.val = FALSE
       !this.xOffset.active = TRUE
    elseif  !gadget.eq(!this.xLock).and(!this.yLock.val) then
       !this.yLock.val = FALSE
       !this.yOffset.active = TRUE
    endif

    if !gadget.eq(!this.yLock) then
      if !gadget.val.eq(TRUE) then
        !this.yOffset.active = FALSE
      else
        !this.yOffset.active = TRUE
      endif
    else
      if !gadget.val.eq(TRUE) then
        !this.xOffset.active = FALSE
      else
        !this.xOffset.active = TRUE
      endif
    endif
  else
    if !gadget.eq(!this.yLock) then
      if !gadget.val.eq(TRUE) then
        !this.yOffset.active = FALSE
      else
        !this.yOffset.active = TRUE
      endif
    else
      if !gadget.val.eq(TRUE) then
        !this.xOffset.active = FALSE
      else
        !this.xOffset.active = TRUE
      endif
    endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .getCentreTransform
--
-- Description: gets transform alpha, beta and gamma angles to be applied to a default orientation such that
--              a wall fitting that is justified centrally can be orientated towards the left or right wall justification direction of the
--              ctwall. At the moment wall fittings that are justified centrally (without this transform) are drawn perpendicularly to the wall.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       DBREF       the dbref of the owning wall fitting element to which a fitting belongs
--    2   R       STRING      a string 'LEFT' or 'RIGHT' which describes which side of the wall we wish the fitting to point out towards
-- Return:
--   [Data Type] [Description]
--    ARRAY       the return array contains three elements representing alpha, beta and gamma angle transform values at [0], [1] and [2] respectively
------------------------------------------------------------------------
define method .getCentreTransform(!wlfitt is DBREF, !line is STRING) is ARRAY

  -- save the current element
  !current = !!ce

  -- goto the current wall fitting level and get the posref attribute
  !!ce = !wlfitt
  !posRef = !!ce.posRef

  -- now create a new proxy wlfitt element and get positions for the central justification and the jusline provided in !line
  NEW WLFITT
  posref $!posRef
  wJusLine CENT
  !ori1 = !!ce.orientation.wrt( /* )
  handle any
    DELETE WLFITT
    !!ce = !current
    return
  endhandle
  wJusLine $!line
  !ori2 = !!ce.orientation.wrt( /* )
  handle any
    DELETE WLFITT
    !!ce = !current
    return
  endhandle

  !transformxyz[1] = !ori2.alpha - !ori1.alpha
  !transformxyz[2] = !ori2.beta - !ori1.beta
  !transformxyz[3] = !ori2.gamma - !ori1.gamma

  -- delete the proxy wlfitt element
  DELETE WLFITT

  -- restore the current element
  !!ce = !current

  -- return the direction of the centre point out to the appropriate left or right hand side of the wall.
  -- this allows us to orientate the fitting correctly when we have a central wall justification
  --!direction = !pos1.direction(!pos2)

  return !transformxyz

endmethod
