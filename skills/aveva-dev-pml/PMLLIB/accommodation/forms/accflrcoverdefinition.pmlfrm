------------------------------------------------------------------------
--
-- Method:      flrCoverCreate
--
-- Description: Create Floor Covering
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flrCoverCreate()

  -- Initialise Variables

  -- Set definition
  !this.definition            = object DBEFLRCOVER()
  !this.definition.initialise(!this.owningElement)

  -- Edit panel title
  !this.editTitle.val         = 'New floor covering for ' & !this.owningElement.namn
  !this.crtShapeDef.val       = 'None currently defined'

  !attribSearch = object DBEATTRIBSEARCH()
  !attribute = 'FlrHeight'
  !arrayOfAlternatives = ARRAY()
  !arrayOfAlternatives.append('FlrHeight')
  !arrayOfAlternatives.append('DFlRHeight')

  !attribSearch.dbeAttribSearch(!this.owningElement,!attribute,!arrayOfAlternatives)

  !element = !attribSearch.element()

  if !attribSearch.attribute.unset().not() then
    !newAction = '!flrCoverHeight = !element.' & !attribSearch.attribute
    $!newAction
  else
    -- default to config
    !flrCoverHeight = !!accConfig.flrHeight
  endif

  !this.definition.elevation(0)

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Copy owning shape
  !this.useOwnersGeometry()

  -- Update gadgets
  !this.updateAttributes()

  -- Setup panes
  !this.createFlrCover(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      flrCoverModify
--
-- Description: Modify Floor Covering
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flrCoverModify() is BOOLEAN


  -- Find the ceiling of the current element
  do !i indices !this.owningElement.members
    !element  = !this.owningElement.members[!i]
    !flrCover = FLRCOV 1 of $!element
    handle ANY
      skip
    elsehandle NONE
      break
    endhandle
  enddo

  -- No floor covering found
  if(undefined(!flrCover)) then
    return false
  endif

  -- Display modify pane
  return !this.flrCoverModify(!flrCover)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      flrCoverModify
--
-- Description: Setup to modify floor covering
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Floor covering to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .flrCoverModify(!element is DBREF) is BOOLEAN

  -- Check FLRCOV has been passed
  if(!element.fulltype.neq('FLRCOV')) then
    !!error.text            = 'Element "' & !element.namn & '" is not a Floor Covering.'
    return false
  endif

  -- Load current Floor Cover
  !this.element             = !element

  -- Set definition
  !this.definition          = object DBEFLRCOVER(!element)

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Edit panel title
  !this.editTitle.val       = 'Modify Floor Covering: ' & !this.element.namn

  -- Update gadgets
  !this.updateAttributes()

  -- Setup panes
  !this.modifyFlrCover(true)

  return true

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      flrLayerCreate
--
-- Description: Create a floor layer for a passed covering
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Floor covering to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .flrLayerCreate(!element is DBREF) is BOOLEAN

  -- Check FLRCOV has been passed
  if(!element.fulltype.neq('FLRCOV')) then
    !!error.text            = 'Element "' & !element.namn & '" is not a Floor Covering.'
    return false
  endif

  -- Load current Floor Cover
  !this.element             = !element

  -- Create a layer (default values)
  --set default values in object definition for floor layer
  !this.layerDefinition          = object DBEFLRLAYER()
  !this.layerDefinition.setdefaults()

  -- override defaults to create a layer with thickness = remaining floor height
  -- If floor height already used then leave default value and warn the user
  !roomType[1] = 'ROOM'
  !room        = !!dtbOwnerOfTypes(!this.element,!roomType)
  if( !room.unset() ) then
    do !owner values !this.element.ownlst
      if(!owner.type.eq('BLEVEL'))then
      	 !roomFloorHeight = !owner.dflrHeight      	
      endif
    enddo
  else
    !roomFloorHeight = !room.flrHeight
  endif

  if(defined(!roomFloorHeight)) then
    !remainingThickness = !roomFloorHeight - !this.element.flcsth
  endif

  if(defined(!remainingThickness)) then
    if( !remainingThickness gt 0 ) then
      if( !remainingThickness lt !this.layerDefinition.fllthk ) then
        -- override default if default is greater than remaining gap
        !this.layerDefinition.fllthk = !remainingThickness
      endif
    else
      if(!!alert.confirm('The thickness of Floor layer exceeds the floor level elevation. Do you want to proceed with this thickness?').boolean().not())then
        !this.layerthickness.val = !this.layerDefinition.fllthk
        return
      endif
    endif
  endif

  !reference = !!ce

  if !this.arrayOfLayers.size().neq(0) then
    !!ce = !this.arrayOfLayers[!this.arrayOfLayers.size()]
  else
    !!ce = !element
  endif

    -- Create new element (default floor layer)
  if(!this.layerDefinition.create()) then

    !this.layerElement = !this.layerDefinition.dbelement
    !this.arrayOfLayers.append(!this.layerDefinition.dbelement)

  -- Failed creating element
  else
    !!alert.warning(!!error.text)
  endif

  !!ce = !reference

  -- Setup panes (switch to floor layer definition pane - may already be there though)
  !this.defineFlrLayer(true)

  return true

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      flrLayerModify
--
-- Description: Modify existing floor layers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .flrLayerModify() is BOOLEAN

    -- Set definition
  !this.definition            = object DBEFLRCOVER()
  !this.definition.initialise(!this.owningElement)

  -- Reference Element
  !reference  = !!ce

  -- Update Block Attributes
  !this.updateData()

  -- Navigate to Level
  !!ce                  = !this.owningElement

  !this.element = !this.definition.dbelement
  if !this.element.unset() then
    return false
  endif

  --Clear array of floor layers
  !this.arrayOfLayers = ARRAY()

  --set default values in object definition for floor layer
  !this.layerDefinition          = object DBEFLRLAYER()
  !this.layerDefinition.setdefaults()

  !reference = !!ce

  if !this.arrayOfLayers.size().neq(0) then
    !!ce = !this.arrayOfLayers[!this.arrayOfLayers.size()]
  else
    !!ce = !this.element
  endif

  !!ce = !reference

  -- Setup panes (switch to floor layer definition pane - may already be there though)
  !this.defineFlrLayer(true)

  return true

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      flrCoverGeometry
--
-- Description: Switch to geometry modification pane for current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flrCoverGeometry()

  do !i indices !this.owningElement.members
    !element  = !this.owningElement.members[!i]
    !flrCover = FLRCOV 1 of $!element
    handle ANY
      skip
    elsehandle NONE
      break
    endhandle
  enddo

  -- No floor covering found
  if(undefined(!flrCover)) then
    return false
  endif

  -- Display modify pane
  !this.flrCoverGeometry(!flrCover)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      flrCoverGeometry
--
-- Description: Switch to geometry modification pane for specified element
--
