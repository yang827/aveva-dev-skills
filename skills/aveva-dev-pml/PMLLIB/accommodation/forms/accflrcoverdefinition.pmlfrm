endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      useActiveFlrCovs
--
-- Description: Get floor coverings from current active element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useActiveFlrCovs()

  -- Clear grid
  !this.flrCovGrid.clearGrid()

  -- Initialise Variables
  !this.flrCovList.clear()
  !this.flrCovNames.clear()
  !groups = ARRAY()

  -- Collect all walls for current active element
  -- Get DETGRP of active element
  if(!this.owningElement.unset().not() or !this.owningElement.badref().not()) then
  do !member values !this.owningElement.members
    if(!member.type.eq('DETGRP')) then
      !groups.append(!member)
    endif
  enddo
  endif

  -- Collect walls from groups owned by the active element
  if(!groups.empty().not()) then
    !collection     = object COLLECTION()
    !collection.addType('FLRCOV')
    !collection.scope(!groups)
    !this.flrCovList  = !collection.results()

    -- Define selection
    !selection      = object SELECTION()
    do !flrCov values !this.flrCovList
      !selection.add(!flrCov)
    enddo

    -- Highlight selection
    !selection.setCurrent()

  endif

  -- Update grid
  !this.updateFlrCovList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateFlrCovList
--
-- Description: Update grid of floor coverings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateFlrCovList()

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('NAME')
  --!attributes.append('InsuType')
  --!attributes.append('DINThickness')
  --!attributes.append('Justification')

  -- Load grid
  if(!this.flrCovList.empty().not()) then
    !block                  = object BLOCK('!this.flrCovList[!evalIndex].string()')
    !dbNames                = !this.flrCovList.evaluate(!block)
    !this.flrCovNames         = !dbNames
    using namespace 'Aveva.Pdms.Presentation'
    !nds                = object NETDATASOURCE('Floor Coverings', !attributes, !dbNames)
    !this.flrCovGrid.bindToDataSource(!nds)

    !selected = ARRAY()
    !selected.append(!this.flrCovNames[1])
    !this.flrCovGrid.setSelectedRowTags(!selected)
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      selectFlrCov
--
-- Description: Select Floor Covering from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectFlrCov(!dummyArray is ARRAY)

  -- Unenhance walls
  !this.tidyFlrCovs()

  -- Initialise Variable
  !elements = !this.flrCovGrid.getSelectedRowTags()
  !this.mtMod.active          = !elements.empty().not()
  !this.mtModLayers.active    = !elements.empty().not()
  !this.mtDel.active          = !elements.empty().not()
  !list     = !this.flrCovNames
  enhance all from !elements colour red

  !this.crtCamberFlr.active  = true
  !this.modCamberFlr.active  = true
  !this.delCamberFlr.active  = false

  if(!this.flrCovGrid.getSelectedRows().set()) then
    !this.element = !this.flrCovGrid.getSelectedRows()[1][1].dbref()
  else
    !this.element = object DBREF()
  endif

  if(!this.element.set()) then
    !coll = object COLLECTION()
    !coll.scope(!this.element)
    --!coll.type('FCUTPL')
    !expression = object EXPRESSION('type eq ''FCUTPL'' ')
    !coll.filter(!expression)

    if(!coll.results().unset().not()) then
      !this.element  = !coll.results()[1]
      !this.delCamberFlr.active  = true
    endif
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      tidyFlrCovs
--
-- Description: Tidy floor coverings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyFlrCovs()

  -- Get current list
  !list = !this.flrCovNames
  unenhance all from !list

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      flrCovModifySelection
--
-- Description: Modify Selected Floor Covering
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flrCovModifySelection()

  if !this.flrCovGrid.getSelectedRows().unset().not() then
    !element = !this.flrCovGrid.getSelectedRows()[1][1].dbref()
  else
    !element = object DBREF()
  endif

  if !element.unset().not() then

    !this.element = !element
    !this.flrCoverModify(!this.element)

  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      deleteSelectedFlrCov
--
-- Description: Delete Selected Floor Covering
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteSelectedFlrCov()

  --should set current floor covering t to delete here (from navigator for other element types)

  if !this.flrCovGrid.getSelectedRows().unset().not() then
    !element = !this.flrCovGrid.getSelectedRows()[1][1].dbref()
  else
    !element = object DBREF()
  endif

  if !element.unset().not() then

    !this.element = !element
    -- Delete current element
    if(!!accDeleteManager.deleteElement(!this.element).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
    endif

    !this.updateFlrCovList()
    -- Refresh Content navigator
    !!acccontentnavigator.refresh()
    handle (2,751)
    endhandle
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      flrLayerModify
--
-- Description: Modify existing floor layers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .flrLayerModify(!element is DBREF) is BOOLEAN

  --Check FLRCOV has been passed
  if(!element.fulltype.neq('FLRCOV')) then
    !!error.text            = 'Element "' & !element.namn & '" is not a Floor Covering.'
    return false
  endif

  -- Set definition
  !this.definition            = object DBEFLRCOVER(!element)

  -- Reference Element
  !reference  = !!ce

  -- Update Block Attributes
  !this.updateData()

  -- Navigate to Level
  !!ce                  = !this.owningElement

  !this.element = !this.definition.dbelement

  if !this.element.unset() then
    return FALSE
  endif

  --Clear array of floor layers
  !this.arrayOfLayers = ARRAY()

  --set default values in object definition for floor layer
  !this.layerDefinition          = object DBEFLRLAYER()
  !this.layerDefinition.setdefaults()

  !reference = !!ce

  if !this.arrayOfLayers.size().neq(0) then
    !!ce = !this.arrayOfLayers[!this.arrayOfLayers.size()]
  else
    !!ce = !this.element
  endif

  !!ce = !reference

  -- Setup panes (switch to floor layer definition pane - may already be there though)
  !this.defineFlrLayer(true)

  return true

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      flrLayerModifySelection
--
-- Description: Modify Selected Floor Covering
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flrLayerModifySelection()

  if !this.flrCovGrid.getSelectedRows().unset().not() then
    !element = !this.flrCovGrid.getSelectedRows()[1][1].dbref()
  else
    !element = object DBREF()
  endif

  if !element.unset().not() then

    !this.element = !element
    !this.flrLayerModify(!this.element)

  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      camberPlaneDefinition
--
-- Description: defines plane for camber fill cut plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .camberPlaneDefinition()

  -- remove any previously defined plane
  !this.removePlane()

  -- make the create and modify camber fill cut plane links inactive
  !this.camberModify.active = false

  if(!this.planeOption.selection() eq 'GPHPICK') then

     !packet                = object EDGPACKET()
     -- Set Data
     !packet.description    = 'Make picked plane/grid current active plane'
     !packet.action         = '!!' + !this.name() + '.setPlane(!this.return[1])'
     !packet.remove         = true
     !packet.pickPacket.stdAny('Pick graphics to define plane')
     !packet.pickPacket.picks[1].prompt         = STRING()
     !packet.pickPacket.picks[1].pick.cursor    = 'DOUBLECROSS'
     !packet.pickPacket.picks[1].pick.stdGraphics()
     !packet.pickPacket.picks[1].pick.input[1]  = 'PKEY eq ''rubbish'''
     !packet.pickPacket.picks[1].pick.input[2]  = 'NUMB eq -99'
     !packet.pickPacket.picks[1].pick.input[6]  = 'FACET EDGE'
     !packet.pickPacket.picks[1].pick.input[10] = /*
     !packet.pickPacket.picks[1].pick.input[11] = 'PKOWNER'
     -- Set Common Data
     !packet.key            = 'planePacket'
     !packet.priority       = 2
     !packet.type           = 'edgPlane'

     -- Add Packet to edg system
     !!edgCntrl.add(!packet)

  elseif(!this.planeOption.selection() eq 'ELEMENT') then

     !!edgCntrl.remove('Standard element pick')
     !packet = object EDGPACKET()
     !packet.description = 'Standard element pick'
     !packet.pickPacket.stdElement('Pick an element to define a plane')
     !packet.remove = true
     !packet.pickPacket.picks[1].pick.modifiable = FALSE
     !packet.action = '!!' + !this.name() + '.dbPlane(!this.return[1].item)'

     !!edgCntrl.add(!packet)

  elseif(!this.planeOption.selection() eq 'DERIVED') then

     !!edgCntrl.remove('Plane Through 3 Positions')
     -- Derive plane by three points
     !packet                = object EDGPACKET()
     !packet.definePlane('3pnts')
     !packet.remove         = true
     !packet.input[1]       = 'PLANE'
     !packet.action         = '!!' + !this.name() + '.plane3Pnts(!this.return[1])'
     !packet.type           = 'aidConstructors'

     -- Add into EDG packet
     !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:        flipPlane
--
-- Description:   flips the plane direction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flipPlane()

  -- check if the plane is set
  if(!this.plane.plane.unset()) then
    return
  endif

  !planeDir = !this.plane.plane.orientation.wrt( /* )
  !planeZdir  = !planeDir.zDir()
  !flipDir    = !planeZdir.opposite()
  !this.plane.plane.orientation = Z is $!<flipDir>
  !this.planeDirection.val  = !flipDir.string()

  !this.planeDisplay()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      camberFillCreate
--
-- Description: creates camber fill cut plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .camberFillCreate()

  -- return if no floor cover is selected in the list
  -- this is just a double check
  if(!this.flrCovGrid.getSelectedRows().unset()) then
    !!alert.message('No Floor Covering is selected in the list')
    return
  endif

  -- Name of the current floor cover element
  !this.element = !this.flrCovGrid.getSelectedRows()[1][1].dbref()
  !this.flrCoverElement.val = 'Selected Floor Cover: ' + !this.element.flnn

  -- Update the Plane direction and position
  !elementOri   = !this.element.orientation.wrt(world)
  handle ANY
    !elementOri = Z is U wrt /*
  endhandle
  !zDir         = !elementOri.zDir()
  !planeNormal  = !zDir.opposite()

  !this.plane.plane.orientation = Z is $!<planeNormal>
  !this.planeDirection.val      = !planeNormal.string()

  !planePos = !this.element.position.wrt(world)
  !this.netPosControl.xyz(!planePos.east, !planePos.north, !planePos.up)
  !this.plane.plane.position    = !planePos

  -- set up camber definition pane
  !this.createCamberFill(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      camberFillModify
--
-- Description: modifies camber fill cut plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .camberFillModify()

  -- return if no floor cover is selected in the list
  -- this is just a double check
  if(!this.flrCovGrid.getSelectedRows().unset()) then
    !!alert.message('No Floor Covering is selected in the list')
    return
  endif

  -- floor cover element selected
  !this.element = !this.flrCovGrid.getSelectedRows()[1][1].dbref()

  -- Name of the current floor cover element
  !this.flrCoverElement.val = 'Selected Floor Cover: ' + !this.element.flnn
  !coll = object COLLECTION()
  !coll.scope(!this.element)
  !coll.type('FCUTPL')

  if(!coll.results().unset()) then
    !this.delCamberFlr.active = false
    !this.planeOptPara.active = true
    !this.planeOption.active = true
    !this.planeSize.active = true
    !this.planeFill.active = true
    !this.flipPlane.active = true
    !this.planePos.active = true
    !this.coNetPosition.active = true
    !this.camberModify.active = false
    !this.cutPlaneList.clear()
    -- !!alert.error('Selected Floor Cover elements do not have a cut plane to modify')
--    return
  else
    !this.delCamberFlr.active = true
    !this.planeOptPara.active = true
    !this.planeOption.active = true
    !this.planeSize.active = true
    !this.planeFill.active = true
    !this.flipPlane.active = true
    !this.planePos.active = true
    !this.coNetPosition.active = true
    !this.camberModify.active = true
  endif

    !headings = ARRAY()
    !headings.append('Description')
    !headings.append('Position')
    !headings.append('Direction')
    !this.cutPlaneList.setheadings(!headings)

    !this.arrayOfCutPlanes = !coll.results()
    -- cutplane list array
    !rowData = ARRAY()
    do !cutPlane values !this.arrayOfCutPlanes
      !aRow = ARRAY()
      !aRow.append(!cutPlane.desc)
      !aRow.append(!cutPlane.pos.string(!!distanceFmt))
      !aRow.append(!cutPlane.cutp.string())
      !rowData.append(!aRow)
    enddo

    !this.cutPlaneList.setrows(!rowData)

  -- cut plane element
    !x = !this.arrayOfCutPlanes.findfirst(!this.cutPlaneElement)
    if !x.set() then
      !this.cutPlaneList.val = !x
    else
      !this.cutPlaneElement  = !coll.results()[1]
      handle any
      endhandle
    endif

    -- Update the Plane direction and position
    !this.updateCutPlaneAttributes()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      camberFillDelete
--
-- Description: deletes camber fill cut plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .camberFillDelete()

  -- check if any floor cover element is selected
  if(!this.flrCovGrid.getSelectedRows().set()) then


      -- Delete cut plane element
      if(!!accDeleteManager.deleteElement(!this.cutPlaneElement).not()) then
        !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
        return
      endif

    !this.crtCamberFlr.active = true
    !this.modCamberFlr.active = false
    !this.camberFillModify()

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createCutPlane
--
-- Description: creates the cut plane element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createCutPlane()

  -- navigate to the floor covering
  !!ce  = !this.element

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()
  !this.undo.description('Created Camber/Sheer Plane')
  !this.undo.add()

  NEW FCUTPL
  handle ANY
    -- cannot create element
    !!alert.error('Cannot create cut plane')
    return
  elsehandle NONE
  endhandle

  -- set the created cut plane FCUTPL as the form element
  !this.element = !!ce
  !!ce.pos  = !this.plane.plane.position
  !!ce.cutp = !this.plane.plane.orientation.zDir()
  !!ce.desc = !this.cutPlaneDescription.val

  !this.formTitle = 'Camber/Sheer Plane Definition'

  !this.undo.endUndoable()
  !this.camberFillModify()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyCutPlane
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyCutPlane()

  !reference  = !!ce

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()
  !this.undo.description('Modify Camber/Sheer Plane')
  !this.undo.add()

  !!ce  = !this.cutPlaneElement
  handle ANY
    -- cannot access element. must have been deleted
  elsehandle NONE
    !!ce.pos  = !this.plane.plane.position
    !!ce.cutp = !this.plane.plane.orientation.zDir()
    !!ce.desc = !this.cutPlaneDescription.val
  endhandle

  !this.undo.endUndoable()
  !this.camberFillModify()

  !!ce  = !reference

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      removePlane
--
-- Description: Removes the previously defined plane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removePlane()

   -- remove the previously defined plane
   if(!this.plane.plane.set()) then
      !!aidNumbers.remove(!this.planeNumber)
      !this.plane = object GPHPLANE()
      !this.planeNumber = object REAL()
   endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      clearEdgStack
--
-- Description: clears existing edg controls
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearEdgStack()

    -- remove edg control for defining plane by picking standard element
    !!edgCntrl.remove('Standard element pick')

    -- remove edg control for defining plane through 3 points
    !!edgCntrl.remove('Plane Through 3 Positions')

    -- remove edg control for defining plane position
    !!edgCntrl.remove('Camber Fill Plane')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPlane
--
-- Description: set plane (from pickPlane EDG pick method)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPlane(!pickData is EDGPICKDATA)

    -- If there are no facets, then we can't derive a plane
    if(!pickData.facetCount gt 0) then

      -- Derived plane from picked plane
      !plane    = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[3])
      -- Try 4th facet
      handle any
        !plane  = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[4])
      endhandle

      !plane.position = !plane.intersection(!pickData.pickLine)
      --!plane.position = !pickData.item.pos.wrt(world)

      !this.plane.plane = !plane

      -- display the plane with the defined settings
      !this.planeDisplay()

      -- set the value of plane attribute gadgets
      !this.setPlaneAttributes()

    else
       !!alert.error('Unable to derive plane from picked element.')
    endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      dbPlane
--
-- Description: Creates plane from picked db planar element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       picked db planar element to create a plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbPlane(!pickedElement is DBREF)

  if(!pickedElement.unset()) then
     return
  endif

  !plane       = object PLANE(!pickedElement.pos,!pickedElement.ori)
  !this.plane  = object GPHPLANE(!plane)

  -- display the plane with the defined settings
  !this.planeDisplay()

  -- set the value of plane attribute gadgets
  !this.setPlaneAttributes()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updatePlanePos
--
-- Description: update the position and orientation of the plane when using edg picks in explicit mode
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updatePlanePos(!data is EDGPOSITIONDATA)

  !pos = !data.position.wrt(World)
  handle ANY
    !pos  = E0 N0 U0
  endhandle

  !!gphPlaneEdit.position.setAction('!!gphPlaneEdit.preview()')
  !!gphPlaneEdit.position.position(!pos)

  !plane = object PLANE(!pos, Y is N)

  !!gphPlaneEdit.orientation.setAction('!!gphPlaneEdit.preview()')
  !!gphPlaneEdit.orientation.orientation(!plane.orientation)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyPlanePos
--
-- Description: update the position of the plane using edg picks
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyPlanePos(!data is EDGPOSITIONDATA)

  !pickedPos = !data.position.wrt(World)
  handle ANY
    !pickedPos  = E0 N0 U0
  endhandle

  !this.netPosControl.xyz(!pickedPos.east, !pickedPos.north, !pickedPos.up)

  !this.modifyPlane('MODIFYPOS')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      planeDisplay
--
-- Description: Sets/Modifies the plane display settings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .planeDisplay()

  -- set the graphical plane display settings
  !this.plane.description = 'Camber Fill plane'
  !this.plane.detail      = true
  !this.plane.tag         = true

  -- set the fill status of the graphical plane
  if(!this.planeFill.val )then
     !this.plane.filled(true)
  else
     !this.plane.filled(false)
  endif

  -- set the size of the graphical plane
  !size = !this.planeSize.val

  !this.plane.x = !size
  !this.plane.y = !size

  if(!this.planeNumber.set()) then
     !!aidNumbers.replace(!this.planeNumber,!this.plane)
  else
    !this.planeNumber = !!aidNumbers.add(!this.plane)
  endif

  -- make the create and modify camber fill cut plane links inactive
  if(!this.cutPlaneElement.badref() or !this.cutPlaneElement.unset()) then
    !this.camberModify.active = false
  else
    !this.camberModify.active = true
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyPlane
--
-- Description: Modifies the defined plane position & orientation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     Option to modify the plane definition
--                          MODIFYDEF - modify plane definition
--                          MODIFYPOS - modify plane position
--                          SIZE/FILL - modify plane size & fill
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyPlane(!modifyOption is STRING)

  if(!modifyOption eq 'MODIFYDEF') then

     if(!this.planeNumber.unset())then
        !!alert.error('No split plane defined.')
        return
     endif

     !aidItem   = !!aidNumbers.get(!this.planeNumber)

     -- Edit aid element
     !aidItem.edit(!this.planeNumber)
     handle (2,765)
     elsehandle ANY
       !!alert.error('Unable to find edit method for "' & !!aidNumbers.numbers[!this.planeNumber].objectType() & '"')
     endhandle

  elseif(!modifyOption eq 'MODIFYPOS') then
     !east  = !this.netPosControl.xyz()[0].string() + 'mm'
     !north = !this.netPosControl.xyz()[1].string() + 'mm'
     !up    = !this.netPosControl.xyz()[2].string() + 'mm'

     !planePos  = East $!<east> North $!<north> Up $!<up>
     !this.plane.plane.position = !planePos

     !planeDir = object DIRECTION(!this.planeDirection.val)
     !this.plane.plane.orientation = Z is $!<planeDir>

     -- set the plane display settings
     !this.planeDisplay()

  elseif(!modifyOption eq 'MODIFYDIR') then
     if(!this.planeNumber.unset())then
        --!!alert.error('No cut plane defined.')
        --return
        !this.modifyPlane('MODIFYPOS')
     endif

    if(!this.plane.plane.set()) then
      !planeDir = object DIRECTION(!this.planeDirection.val)
      !this.plane.plane.orientation = Z is $!<planeDir>

      -- set the plane display settings
      !this.planeDisplay()

    endif

  else

    if(!modifyOption eq 'SIZE') then
      if(!this.planeSize.val.unset()) then
        !!alert.error('Plane Size cannot be unset')
        !this.planeSize.val  = 5000mm
      elseif(!this.planeSize.val lt 0) then
        !!alert.error('Plane Size cannot be a negative value')
        !this.planeSize.val  = abs(!this.planeSize.val)
      elseif(!this.planeSize.val eq 0) then
        !!alert.error('Plane Size cannot be zero')
        !this.planeSize.val  = 5000mm
      endif
    endif

    if(!this.plane.plane.set()) then
      -- set the plane display settings
       !this.planeDisplay()
    endif

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      plane3Pnts
--
-- Description: Defines plane by 3 picks
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE      GPHPLANE object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plane3Pnts(!plane is PLANE)

  !this.plane.plane = !plane

  -- set the plane display settings
  !this.planeDisplay()

  -- set the value of plane attribute gadgets
  !this.setPlaneAttributes()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPlaneAttributes
--
-- Description: sets value for the plane attribute gadgets
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPlaneAttributes()

  -- set the value for plane direction
  !planeDir     = !this.plane.plane.orientation.wrt(world).zDir()
  !planeDirStr  = !planeDir.string()
  !this.planeDirection.val = !planeDirStr

  -- set the value for plane position
  !planePos = !this.plane.plane.position.wrt(world)
  !this.netPosControl.xyz(!planePos.east, !planePos.north, !planePos.up)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validateDirection
--
-- Description: validates the entered value for a valid direction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateDirection()

  !planeDir = object DIRECTION(!this.planeDirection.val)
  handle (2,813)
    !!alert.error('Entered value is not a valid direction. Setting it to default direction.')
    !planeDir  = U
  elsehandle ANY
    !planeDir = U
--elsehandle NONE
--  if(!planeDir.up.eq(0)) then
--    !!alert.error('Cut plane direction should have up component')
--    !planeDir = U
--  endif
  endhandle

  !planeDirStr  = !planeDir.string()
  !this.planeDirection.val = !planeDirStr

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      positionControl
--
-- Description: initialises the position control gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionControl()

  -- Implementation of positional control
  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of position control
  !this.netPosControl = object POSITIONCONTROL()

  -- Load ship grid data
  !grid         = object SHIPGRID()
  !gridDefined  = !grid.position.set()

  -- Only populate the grid data if a ship reference grid is available
  if(!gridDefined) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.netPosControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    !this.netPosControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.netPosControl.heading('World Position')

  else
    var !coordinate coordinate
    if(!coordinate.eq('ENU'))then
      !this.netPosControl.enuFormat()
    else
      !this.netPosControl.xyzFormat()
    endif

    !this.netPosControl.gridVisible(false)
  endif
  -- End of code for Implementing positional control

  !this.netPosControl.changeAction('!!accFlrCoverDefinition.modifyPlane(''MODIFYPOS'')')

   -- Add PMLNet control to PML frame
  !this.coNetPosition.control = !this.netPosControl.handle()

  -- set position to default E0N0U0
  !this.netPosControl.xyz(0,0,0)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pickPlanePos
--
-- Description: defines edg packet for picking plane position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPlanePos()

  !!edgCntrl.remove('Camber Fill Plane')

  -- define packet
  !prompt               = 'Camber/Sheer Plane Position'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Camber Fill Plane'
  !packet.remove        = true
  !packet.action        = '!!accFlrCoverDefinition.modifyPlanePos(!this.return[1])'
  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      closeForm
--
-- Description: closes the form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .closeForm()

  -- remove any cut plane defined
  !this.removePlane()

  -- tidy
  !this.definition.tidy()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:        backToFlrCovTasks
--
-- Description:   navigates to the main floor covering tasks from camber fill tasks
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backToFlrCovTasks()

  !emptyArray = object ARRAY()
  -- select the floor cover from the list
  !this.selectFlrCov(!emptyArray)

  -- display the main tasks pane
  !this.mainTasks(true)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        accUnitsFormats
--
-- Description:   Set unit global format objects specific to room design
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accUnitsFormats()

  -- Convert area units to inch and metric units to metres
  -- set up area and volume formats
  !!accAreaFmt = !!areaFmt
  !!accVolFmt  = !!volumeFmt

  if( !!isImperialLength('DIST') ) then
    -- set square inch format
    !!accAreaFmt.dp    = 0
    !!accAreaFmt.units = 'inch'
    !!accAreaFmt.label = ' sq in'
    -- set cubic inch format
    !!accVolFmt.dp     = 0
    !!accVolFmt.units  = 'inch'
    !!accVolFmt.label  = ' cu in'
  else
    -- set square metre format
    !!accAreaFmt.dp    = 3
    !!accAreaFmt.units = 'metre'
    !!accAreaFmt.label = ' sq metre'
    -- set cubic metre format
    !!accVolFmt.dp     = 3
    !!accVolFmt.units  = 'metre'
    !!accVolFmt.label  = ' cu metre'
  endif

endmethod
-- End of method definition
