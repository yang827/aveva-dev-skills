------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickOffset()

  -- Initialise Variables
  !prompt               = 'Pick floor covering origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to floor covering offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

  -- Initialise Variables
  !this.definition.xyOffset(!data.position)

  -- Update gadget
  !this.xOffset.val = !this.definition.xyOffset[1]
  !this.yOffset.val = !this.definition.xyOffset[2]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Continue"
--    3   R      STRING      "Continue" text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING, !continue is STRING)

  -- Switch warning pane
  !this.currentPane.visible   = false
  !this.warningPane.visible   = true

  -- Concatenate message into a single line
  !display    = ''
  do !i indices !message
    !display  = !display & ' ' & !message[!i]
  enddo

  -- Display message
  !this.warning.val           = !display.trim()
  !this.warningDone.tag       = !continue

  -- Set "Continue" action (If the action is dependent on other criteria
  -- e.g. being in the correct position in the hierarchy, then the
  -- active state of the "Done" button needs to be managed.
  !this.warningAction         = object BLOCK(!action)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warningDone
--
-- Description: Exit warning
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warningDone()

  -- Hide warning pane
  !this.warningPane.visible   = false

  -- Execute action
  !this.warningAction.evaluate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      exampleWarning
--
-- Description: Example of how to use a warning with an action
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exampleWarning1()

  -- Define message to be displayed
  !message[1] = 'This is the message that is to be displayed in the '
  !message[2] = 'warning pane. The message can be up to 132 characters'
  !message[3] = 'long.'
  !this.warning(!message, '!this.firstTaskPane(true)', !this.ftpWarningMsg.val)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteFlrCover
--
-- Description: Delete FLRCOV
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteFlrCover()

  --should set current floor covering to delete here (from navigator for other element types)

  -- Set definition
  !this.definition            = object DBEFLRCOVER()
  !this.definition.initialise(!this.owningElement)
  !this.element = !this.definition.dbelement

  if !this.element.unset().not() then
  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.element).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
    else
      !this.element = object DBREF()
    endif
  endif

  !this.updateMainTaskGadgets()

endmethod
------------------------------------------------------------------------
--
-- Method:      deleteFlrLayer
--
-- Description: Delete FLRLAY
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteFlrLayer()

  --should set current floor covering to delete here (from navigator for other element types)

  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.layerElement).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  endif

  --reload floor layer pane
   !this.layerElement = !this.arrayOfLayers[1]
  !this.defineFlrLayer(TRUE)
  !this.updateLayerAttributes()


endmethod
-- End of method definition

