------------------------------------------------------------------------
--
-- Method:      flrCoverGeometry
--
-- Description: Switch to geometry modification pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flrCoverGeometry(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.modGeometry

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.flrCoverGeometry(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Floor Covering Geometry'

    -- Draw
    !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.modGeometry.visible   = !active

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      flrCovModGeometry
--
-- Description: Modify geometry for FLRCOV (needs to pass current geometry to shape editor)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flrCovModGeometry()

  -- use the accProfileEdit function
  if(defined(!!dbeProfileEdit)) then
    !!dbeProfileEdit.close()
  endif

  -- Check if there is a boundary defined
  if(!this.definition.outerLoop.set()) then
    !boundary           = !!dtbMemberOfType(!this.element,'LOOP',1)
    !!accProfileEdit(!boundary)
  else
    !this.geometry()
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      flrLayerDefinition
--
-- Description: Switch to geometry modification pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineFlrLayer(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Edit panel title
    !this.definelayerTitle.val         = 'Floor layers of ' & !this.element.namn

    --Set matref list dtext
    !this.layerMaterial.dtext = !this.layerDefinition.matrefArray

    -- Set current pane
    !this.currentPane         = !this.floorLayer

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.defineFlrLayer(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Floor Layer Definition'

    --Update list in floor layer form
    --could/should be done in layer object?

    !headings = ARRAY()
    !headings.append('Description')
    !headings.append('Thickness')
    !headings.append('Material')
    !this.layerList.setheadings(!headings)

    -- Collect all layers required
    !collection         = object COLLECTION()
    !collection.scope(!this.element)
    !collection.type('FLRLAY')
    !flrLayers      = !collection.results()

    !this.arrayOfLayers = !flrLayers

    --set current layer to this.layerElement in list (if poss - otherwise just set first layer)

    !x = !flrLayers.findfirst(!this.layerElement)
    -- floor layers list array
    !rowData = ARRAY()
    do !flrLayer values !flrLayers
      !aRow = ARRAY()
      !aRow.append(!flrLayer.description)
      !aRow.append(!flrLayer.fllthk.string(!!distanceFmt))
      if !flrLayer.matref.unset().not() then
        !aRow.append(!flrLayer.matref.name)
      endif
      !rowData.append(!aRow)
    enddo

    !this.layerList.setrows(!rowData)

    !this.layerDelete.active = true
    !this.layerApply.active = true
    !this.layerDescription.active = true
    !this.layerthickness.active = true
    !this.layerMaterial.active = true
    !this.layerFflext.active = true
    !this.layerMatwidth.active = true
    !this.layerMatlength.active = true
    !this.layerMatover.active = true
    if !x.set() then
      !this.layerList.val = !x
      !this.layerDefinition = object DBEFLRLAYER(!this.layerElement)
    else
      if !flrLayers.size().neq(0) then
         !this.layerElement = !flrLayers[1]
      else
	 -- no floor layers so de-activate delete & modify attribute buttons
         !this.layerElement = object DBREF()
         !this.layerDelete.active = false
         !this.layerApply.active = false
         !this.layerDescription.active = false
         !this.layerthickness.active = false
         !this.layerMaterial.active = false
         !this.layerFflext.active = false
         !this.layerMatwidth.active = false
         !this.layerMatlength.active = false
         !this.layerMatover.active = false
      endif
    endif

    -- if one or less floor layer then cannot reorder
    !this.layerUpButton.active = true
    !this.layerDownButton.active = true
    if !flrLayers.size().leq(1) then
      !this.layerUpButton.active = false
      !this.layerDownButton.active = false
    endif

    !this.updateLayerAttributes()

  endif

  -- Show/hide task pane
  !this.floorLayer.visible   = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      layerUp
--
-- Description: Move floor layer up in list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .layerUp()

  --check not first in list
  if !this.layerList.val.neq(1) then
    --if not, subtract 1 to index and insert
    !oneToMove = !this.arrayOfLayers[!this.layerList.val]
    !this.arrayOfLayers.remove(!this.layerList.val)
    !insertNumber = !this.layerList.val - 1
    !this.arrayOfLayers.insert(!insertNumber,!oneToMove)

    --reorder in DB
    !ref = !!ce
    !!ce = !this.element
    !numberToMove = !this.layerList.val
    !numberToMoveBefore = !this.layerList.val - 1
    reorder $!numberToMove before $!numberToMoveBefore

    !!ce = !ref

    !this.defineFlrLayer(TRUE)
   endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      layerDown
--
-- Description: Move floor layer down in list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .layerDown()

  --check not last in list
  if !this.layerList.val.neq(!this.layerList.dtext.size()) then
    --if not, subtract 1 to index and insert
    !oneToMove = !this.arrayOfLayers[!this.layerList.val]
    !this.arrayOfLayers.remove(!this.layerList.val)
    !insertNumber = !this.layerList.val + 1
    !this.arrayOfLayers.insert(!insertNumber,!oneToMove)

    --reorder in DB
    !ref = !!ce
    !!ce = !this.element
    !numberToMove = !this.layerList.val
    !numberToMoveAfter = !this.layerList.val + 1
    reorder $!numberToMove after $!numberToMoveAfter

    !!ce = !ref

    !this.defineFlrLayer(TRUE)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateAttributes
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAttributes()

  -- Set values of gadgets from DBEFLRCOVER object
  !this.dbName.val        = !this.definition.name
  !this.dbDescription.val = !this.definition.description
  !this.dbFunction.val    = !this.definition.function
  !this.dbNumber.val      = !this.definition.number
  !this.nAngle.val        = !this.definition.nAngle
  !this.hAngle.val        = !this.definition.hAngle

  !this.flrCoverHeight.val = !this.definition.flrHeight

  !this.xOffset.val       = !this.definition.xyOffset[1]
  !this.yOffset.val       = !this.definition.xyOffset[2]

  if !this.colSchema.dtext.findfirst(!this.definition.colSchema).unset().not() then
    !this.colSchema.val = !this.colSchema.dtext.findfirst(!this.definition.colSchema)
  else
    !this.colSchema.val = 1
  endif

  if !this.fireRating.dtext.findfirst(!this.definition.fireRating).unset().not() then
    !this.fireRating.val = !this.fireRating.dtext.findfirst(!this.definition.fireRating)
  else
    !this.fireRating.val = 1
  endif

  if !this.flrCoverType.dtext.findfirst(!this.definition.flrType).unset().not() then
    !this.flrCoverType.val = !this.flrCoverType.dtext.findfirst(!this.definition.flrType)
  else
    !this.flrCoverType.val = 1
  endif

  if !this.flrCoverCode.dtext.findfirst(!this.definition.flrCode).unset().not() then
    !this.flrCoverCode.val = !this.flrCoverCode.dtext.findfirst(!this.definition.flrCode)
  else
    !this.flrCoverCode.val = 1
  endif

  !this.flcare.val        =  !this.definition.flcare
  !this.nvol.val          =  !this.definition.nvol

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateData
--
-- Description: Update current data with gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateData()

  -- Initialise Variables
  if(!this.dbName.val.set()) then
    !this.definition.name         = !this.dbName.val
  endif

  !this.definition.description    = !this.dbDescription.val
  !this.definition.function       = !this.dbFunction.val
  !this.definition.number         = !this.dbNumber.val
  !this.definition.colSchema      = !this.colSchema.selection()
  !this.definition.fireRating     = !this.fireRating.selection()
  !this.definition.flrType        = !this.flrCoverType.selection()
  !this.definition.flrCode        = !this.flrCoverCode.selection()

endmethod
------------------------------------------------------------------------
--
-- Method:      updateLayerData
--
-- Description: Update current data with gadget values + write to db
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateLayerData()

  -- Initialise Variables
  !this.layerDefinition.description    = !this.layerDescription.val
  !this.layerDefinition.fllthk         = !this.layerthickness.val

  !this.layerDefinition.fflext    = !this.layerFflext.val

  if !this.layerMaterial.dtext[!this.layerMaterial.val].neq('None') then
    !this.layerDefinition.matref          = !this.layerMaterial.dtext[!this.layerMaterial.val].dbref()
  else
    !this.layerDefinition.matref = object DBREF()
  endif

  !this.layerDefinition.matlength = !this.layerMatlength.val
  !this.layerDefinition.matwidth  = !this.layerMatwidth.val
  !this.layerDefinition.matover   =  !this.layerMatover.val

endmethod
------------------------------------------------------------------------
--
-- Method:      updateLayerFromListSelection
--
-- Description: Update current data with gadget values + write to db
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateLayerFromListSelection()

  -- update from list selection
  !index = !this.layerList.val
  --select layer from number in list
  !this.layerElement = !this.arrayOfLayers[!index]
  !this.defineFlrLayer(TRUE)
  !this.updateLayerAttributes()

endmethod
------------------------------------------------------------------------
--
-- Method:      updateCutPlaneFromListSelection
--
-- Description: Update current data with gadget values + write to db
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateCutPlaneFromListSelection()

  -- update from list selection
  !index = !this.cutPlaneList.val
  --select layer from number in list
  !this.cutPlaneElement = !this.arrayOfCutPlanes[!index]
  !this.defineFlrLayer(TRUE)
  !this.updateCutPlaneAttributes()
  !this.modifyPlane('MODIFYPOS')

endmethod
------------------------------------------------------------------------
--
-- Method:      updateCutPlaneAttributes
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateCutPlaneAttributes()



  -- set up camber definition pane
  !this.modifyCamberFill(true)

  -- Update the Plane direction and position
  !planeDir = !this.cutPlaneElement.cutp.wrt( /* )
  handle ANY
  endhandle
  !this.plane.plane.orientation = Z is $!<planeDir>
  handle (47,15) ANY
    !planeDir  = Z wrt /*
    !this.plane.plane.orientation = Z is U wrt /*
  endhandle
  !this.planeDirection.val  = !planeDir.string()

  !planePos = !this.cutPlaneElement.position.wrt(world)
  handle ANY
    !planePos  = E0 N0 U0
  endhandle
  !this.netPosControl.xyz(!planePos.east, !planePos.north, !planePos.up)
  !this.plane.plane.position    = !planePos
  !this.cutPlaneDescription.val = !this.cutPlaneElement.desc
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateLayerAttributes
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateLayerAttributes()

  -- Set values of gadgets from DBEFLRLAYER object
  !this.layerDescription.val = !this.layerDefinition.description
  !this.layerthickness.val = !this.layerDefinition.fllthk

  if !this.layerDefinition.matref.unset().not() then
    if !this.layerMaterial.dtext.findfirst(!this.layerDefinition.matref.name).unset().not() then
      !this.layerMaterial.val = !this.layerMaterial.dtext.findfirst(!this.layerDefinition.matref.name)
    else
      !this.layerMaterial.val = 1
    endif
  else
    !this.layerMaterial.val = 1
  endif

  !this.layerFflext.val = !this.layerDefinition.fflext
  !this.layerMatlength.val = !this.layerDefinition.matlength
  !this.layerMatwidth.val = !this.layerDefinition.matwidth
  !this.layerMatover.val = !this.layerDefinition.matover

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create()

  -- Check shape is defined, otherwise do not allow creation
  if !this.definition.outerLoop.area().eq(0) then
    !!alert.warning('Floor covering geometry must be defined before floor covering is created')
  else

  -- Reference Element
  !reference  = !!ce

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
    !this.undo  = object UNDOABLE()

  !this.undo.description('Created floor covering')
  !this.undo.add()

  -- Navigate to Level
  !!ce                  = !this.owningElement

  -- Get detailing group
  !detailGroup    = !!accDetailGroup(!this.owningElement, 'FLR', 'Floor Covering definitions')
  if(!detailGroup.unset()) then
    !!alert.warning('"temp" - ' & !!error.text)
    return
  endif

  -- Navigate to detail group
  !!ce            = !detailGroup

  -- Create new element
  if(!this.definition.create()) then

    !this.element = !this.definition.dbelement

    --Create 1 default floor layer here

    --Clear array of floor layers
    !this.arrayOfLayers = ARRAY()

    -- Switch to floor layers pane
    !this.flrLayerCreate(!this.element)

  -- Failed creating element
  else
    !!alert.warning(!!error.text)
  endif

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Return to original element
  !!ce        = !reference
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.element.namn & ')')
  !this.undo.add()

  -- Modify Floor Covering
  if(!this.definition.modify().not())then
    !!alert.warning(!!error.text)
  endif
  -- Redraw graphical aids to update tag
  !this.definition.draw()
  -- Refresh Content navigator
  !!acccontentnavigator.refresh()
  handle (2,751)
  endhandle
  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod
------------------------------------------------------------------------
--
-- Method:      modifyFlrLayer
--
-- Description: Modify current floor layer (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyFlrLayer()

  if(!this.layerElement.badref() or !this.layerElement.unset()) then
    return
  endif

  -- Update Layer Attributes (layer object from gadget values)
  !this.updateLayerData()

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.layerElement.namn & ')')
  !this.undo.add()

  -- Modify Floor Layer
  if(!this.layerDefinition.modify().not())then
    !!alert.warning(!!error.text)
    handle ANY
    endhandle
  endif

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  !this.defineFlrLayer(TRUE)

endmethod

------------------------------------------------------------------------
--
-- Method:      geometry
--
-- Description: Define geometry for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometry()

  -- Define data to pass to shape definition form
  !plane  = !this.definition.plane
  !shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)

  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form
  -- Information for form is:
  --   Arg 1: Calling form,
  --   Arg 2: Form title
  --   Arg 3: Apply button tag (Test for "apply" button)
  --   Arg 4: Action on completion, method name only, method must be in format .methodName(<SHAPEDEFINITION>)
  --   Arg 5: Default shape, should be at least pos and ori of the plane the shape is to be mapped onto.
  !!shapeDefinitionEditor.setup(!this, 'Define Floor Covering Boundary', 'Define Boundary', 'geometryUpdate', !shape)

endmethod
------------------------------------------------------------------------
--
-- Method:      modGeometry
--
-- Description: Define geometry for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modGeometry()

  -- Define data to pass to shape definition form
  !plane  = !this.definition.plane

  !shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)

  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form
  -- Information for form is:
  --   Arg 1: Calling form,
  --   Arg 2: Form title
  --   Arg 3: Apply button tag (Test for "apply" button)
  --   Arg 4: Action on completion, method name only, method must be in format .methodName(<SHAPEDEFINITION>)
  --   Arg 5: Default shape, should be at least pos and ori of the plane the shape is to be mapped onto.
  !!shapeDefinitionEditor.setup(!this, 'Define Floor Covering Boundary', 'Define Boundary', 'modGeometryUpdate', !shape)

endmethod
------------------------------------------------------------------------
--
-- Method:      geometryUpdate
--
-- Description: Update with returned data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometryUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  !this.crtShapeDef.val       = !shapeDefinition.description

  !this.definition.position(!shapeDefinition.profile.position)
  !this.definition.outerLoop  = !shapeDefinition.profile
  !this.definition.draw()

endmethod
------------------------------------------------------------------------
--
-- Method:      modGeometryUpdate
--
-- Description: Update with returned data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modGeometryUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  !this.modShapeDef.val       = !shapeDefinition.description

  !this.definition.position(!shapeDefinition.profile.position)
  !this.definition.outerLoop  = !shapeDefinition.profile
  !this.definition.draw()

endmethod
------------------------------------------------------------------------
--
-- Method:      useOwnersGeometry
--
-- Description: Use owning boundary definition (if there is one)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useOwnersGeometry()

  -- Get gadget setting
  !useOwner             = !this.crtShapeO.val

  -- Make shape definition inactive
  !this.crtShape.active = !useOwner.not()

  -- Get owning geometry
  if(!useOwner) then

    -- Check if there is a boundary defined
    !boundary = BNDLIN 1 OF $!<this.owningElement>
    -- No boundary to use
    handle ANY
    -- Use owning boundary
    elsehandle NONE
      !plane    = !this.definition.plane
      !profile  = object PROFILE(LOOP 1 of $!<boundary> )
      !newShape = object SHAPEMODIFIER()
      !profile  = !newShape.intersect(!profile, !plane)

      -- Modify definition profile
      !shape      = object SHAPEDEFINITION(!plane.position, !plane.orientation)
      !shape.description  = 'Derived from owner'
      !shape.profile      = !profile
      !this.geometryUpdate(!shape)

    endhandle

 endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      validateThick
--
-- Description: Validation for Thickness
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateThick()

  !layers = !this.layerList.val
  if(!layers.eq(0)) then
    return
  endif

if(!this.layerthickness.val.real().set())then
  if(!this.layerthickness.val.leq(0))then
  	!!alert.message('Thickness should be greater than 0. Enter a valid thickness.')
  	return
  endif

  -- selected floor layer thickness
  !currentLayerThk = !this.arrayOfLayers[!layers].fllthk
  -- layer thickness = floor cover thickness - current layer thickness + entered thickness
  !layerThick      = !this.element.flcsth - !currentLayerThk + !this.layerthickness.val

  !roomType[1] = 'ROOM'
  !room        = !!dtbOwnerOfTypes(!this.element,!roomType)

  if( !room.unset() ) then
    -- get the floor height from BLEVEL
    !roomFloorHeight = -999.0
    do !owner values !this.element.ownlst
      if(!owner.type.eq('BLEVEL'))then
      	 !roomFloorHeight = !owner.dflrHeight
      endif
    enddo
    -- FLRCOV may be owned by a BBLOCK so no Floor Height to check
    if( !roomFloorHeight.eq(-999.0))then
      return
    endif
    !flrHeightStr = 'Floor level'
  else
    -- get the floor height from ROOM
    !roomFloorHeight = !room.flrHeight
    !flrHeightStr = 'Room'
  endif

  if(!layerThick.gt(!roomFloorHeight))then
    if(!!alert.confirm('The thickness of Floor layers exceeds the $!flrHeightStr height. Do you want to proceed with this thickness?').boolean().not())then
      !this.layerthickness.val = !this.layerDefinition.fllthk
    endif
  endif
else
  !!alert.message('Enter a valid thickness')
  return
endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message with default "Continue"
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Done"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING)
  !this.warning(!message, !action, 'Continue')
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: Set elevation of level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elevation()
  !this.definition.elevation(!this.flrCoverHeight.val)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Set xy offset of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset()
  !this.definition.xyOffset(!this.xOffset.val, !this.yOffset.val)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      nAngle
--
-- Description: Set angle from owners Y axis
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nAngle(!gadget is GADGET, !select is STRING)
