--
-- File:            accflrcoverdefinition.pmlfrm
--   Type:          Form Definition
--   Group:         Accommodation
--
--     Keyword:     Floor Covering Definition
--   Module:        Design
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Sun Feb 4 20:00:00 GMT 2007
--
--
-- Description:
--    Main form for floor covering (FLRCOV) definitions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accFlrCoverDefinition()          -                   Constructor
--  accUnitsFormats()                -                   Set unit global format objects specific to room design
--  backToFlrCovTasks()              -                   navigates to the main floor covering tasks from camber fill tasks
--  backToMainRoomDesignTasks()      -                   Switching to Main Room Design Tasks
--  camberFillCreate()               -
--  camberFillDelete()               -                   deletes camber fill cut plane
--  camberFillModify()               -
--  camberPlaneDefinition()          -
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  clearEdgStack()                  -                   clears existing edg controls
--  closeForm()                      -
--  create()                         -                   Create element
--  createCamberFill(BOOLEAN)        -
--  createCutPlane()                 -
--  createFlrCover(BOOLEAN)          -
--  dbPlane(DBREF)                   -                   Creates plane from picked db planar element
--  defineFlrLayer(BOOLEAN)          -
--  deleteFlrCover()                 -
--  deleteFlrLayer()                 -
--  deleteSelectedFlrCov()           -                   Delete Selected Floor Covering
--  dummy()                          -                   Dummy method for unset
--  elevation()                      -                   Set elevation of level
--  exampleWarning1()                -
--  flipPlane()                      -                   flips the plane direction
--  flrCovModGeometry()              -                   Switch to geometry modification pane for current element
--  flrCovModifySelection()          -                   Modify Selected Floor Covering
--  flrCoverCreate()                 -                   Create Floor Covering
--  flrCoverGeometry()               -                   Switch to geometry modification pane for current element
--  flrCoverGeometry(BOOLEAN)        -                   Switch to geometry modification pane
--  flrCoverGeometry(DBREF)          -                   Switch to floor layer definition pane for specified element
--  flrCoverModify()                 BOOLEAN             Modify Floor Covering
--  flrCoverModify(DBREF)            BOOLEAN             Setup to modify floor covering
--  flrLayerCreate(DBREF)            BOOLEAN
--  flrLayerDefinition(DBREF)        -
--  flrLayerModify()                 BOOLEAN             Modify existing floor layers
--  flrLayerModify(DBREF)            BOOLEAN             Modify existing floor layers
--  flrLayerModifySelection()        -                   Modify Selected Floor Covering
--  geometry()                       -                   Define geometry for element
--  geometryUpdate(SHAPEDEFINITION)  -                   Update with returned data
--  hAngle(GADGET,STRING)            -                   Set horizontal angle
--  height(GADGET,STRING)            -                   Set height of element
--  initialise()                     -                   Initialise form.
--  layerDown()                      -                   Move floor layer down in list
--  layerUp()                        -                   Move floor layer up in list
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  modGeometry()                    -
--  modGeometryUpdate(SHAPEDEFINITION) -                   Update with returned data
--  modify()                         -                   Modify (write modified values to DB)
--  modifyCamberFill(BOOLEAN)        -
--  modifyCutPlane()                 -
--  modifyFlrCover(BOOLEAN)          -                   Display floor covering pane in modify mode
--  modifyFlrLayer()                 -                   Modify current floor layer (write modified values to DB)
--  modifyPlane(STRING)              -                   Modifies the defined plane position & orientation
--  modifyPlanePos(EDGPOSITIONDATA)  -                   update the position of the plane using edg picks
--  nAngle(GADGET,STRING)            -                   Set angle from owners Y axis
--  offset()                         -                   Set xy offset of element
--  offset(EDGPOSITIONDATA)          -                   Map picked position to floor covering offset
--  pickOffset()                     -                   Setup EDG pick event for picking position
--  pickPlanePos()                   -
--  plane3Pnts(PLANE)                -
--  planeDisplay()                   -                   Sets/Modifies the plane display settings
--  positionControl()                -
--  refresh()                        -                   Refresh form from navigator.
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  removePlane()                    -                   Removes the previously defined plane
--  selectFlrCov(ARRAY)              -                   Select Floor Covering from grid
--  setPlane(EDGPICKDATA)            -                   set plane (from pickPlane EDG pick method)
--  setPlaneAttributes()             -                   sets value for the plane attribute gadgets
--  tidyFlrCovs()                    -                   Tidy floor coverings
--  updateAttributes()               -                   Update gadgets with object data
--  updateCutPlaneAttributes()       -                   Update gadgets with object data
--  updateCutPlaneFromListSelection() -                   Update current data with gadget values + write to db
--  updateData()                     -                   Update current data with gadget values
--  updateFlrCovList()               -                   Update grid of floor coverings
--  updateLayerAttributes()          -                   Update gadgets with object data
--  updateLayerData()                -                   Update current data with gadget values + write to db
--  updateLayerFromListSelection()   -                   Update current data with gadget values + write to db
--  updateMainTaskGadgets()          -                   updateMainTaskGadgets
--  updatePlanePos(EDGPOSITIONDATA)  -                   update the position and orientation of the plane when using edg picks in explicit mode
--  useActiveFlrCovs()               -                   Get floor coverings from current active element
--  useOwnersGeometry()              -                   Use owning boundary definition (if there is one)
--  validateDirection()              -                   validate if the entered value is a valid direction
--  validateThick()                  -                   Validation for Thickness
--  warning(ARRAY,STRING)            -                   Set warning task and message with default "Continue"
--  warning(ARRAY,STRING,STRING)     -                   Set warning task and message
--  warningDone()                    -                   Exit warning
--
import 'GridControl'
handle any
endhandle

import 'PositionControl'
handle any
endhandle

setup form !!accFlrCoverDefinition dialog docking right

  !this.formTitle     = 'Floor Covering Definition'
  !this.iconTitle     = 'Floor Covering'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.closeForm()'
  !this.killingCall   = '!this.closeForm()'
  !this.formRevision  = ' $Revision$ '

  -- Current hierarchy
  paragraph .currentOwner                     anchor top + left + right         at x0.5                   ymax                width 30 lines 1

  -- Main Task Pane
  frame .mainTaskPane panel                   anchor top + left + right         at x0                     ymax.currentOwner

    -- Floor coverings
    paragraph .flrCovListTag                 anchor top + left + right         at x0.5                   ymax                text 'List of Floor Coverings'
    line .flrCovL1                           anchor top + left + right         at xmin                   ymax                horizontal width 32

    -- List of floor coverings to modify
    container .flrCovs PMLNetCONTROL 'NET'      anchor top + left + right         at x0                     ymax                width 32 height 8

    -- Populate list of floor coverings
    button .flrCovsActive    linkLabel 'Current Element'            anchor top + left + right         at x2     ymax+0.5            callback '!this.useActiveFlrCovs()'  width 26

    -- Create options
    paragraph .createTasks                                                      at x0.5                   ymax                width 30 lines 1
    line .mainTaskL1                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtCrt         linkLabel 'Floor Covering'                            at x2                     ymax                callback '!this.flrCoverCreate()'


    -- Modify options
    paragraph .modifyTasks                                                      at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskL2                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtMod         linkLabel 'Floor Covering Definition'                 at x2                     ymax                callback '!this.flrCovModifySelection()'
    button .mtModGeom     linkLabel 'Floor Covering Geometry'                   at x2                     ymax                callback '!this.flrCovModGeometry()'
    button .mtModLayers        linkLabel 'Floor Layers'                         at xmin                   ymax                callback '!this.flrLayerModifySelection()'

    button    .modCamberFlr  linkLabel 'Camber/Sheer Planes'                     at x2                     ymax                callback '!this.camberFillModify()'

    -- Delete options
    paragraph .deleteTasks                                                      at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskL4                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtDel         linkLabel 'Delete Floor Covering'                     at x2                     ymax                callback '!this.deleteSelectedFlrCov()'

 --   button    .delCamberFlr  linkLabel 'Camber/Sheer Plane'                     at x2                     ymax                callback '!this.camberFillDelete()'

    paragraph .blTskBackMainIcon1            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain1     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit
  -- End of mainTaskPane

  -- Floor Covering creation/modification pane
  frame .editPane panel                             anchor top + left + right   at x0                     ymax.currentOwner

    paragraph .editTitle                            anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .editLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Gadgetry definition for creation
    text .dbName  'Name:'  tagwidth 9               anchor top + left + right   at x2                     ymax+0.2            callback '!this.checkName(!this.dbName, !this.definition.name)' width 20 is STRING
    path down
    halign right
    text .dbDescription 'Description:' tagwidth 9   anchor top + left + right                                                 callback '' width 20 is STRING
    text .dbFunction 'Function:'       tagwidth 9   anchor top + left + right                                                 callback '' width 20 is STRING
    numericinput .dbNumber 'Number:'   tagwidth 9   anchor top + left           at xmin                   ymax+0.2            callback '' range 0 10000 ndp 0 width 4

    -- Positioning
    paragraph .location                             anchor top + left + right   at x0.5                   ymax+0.2            text 'Location:' width 28 lines 1
    line .editLine2                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Angle from Y axis
    numericinput .nAngle 'Angle from OWNER Y axis:'  tagwidth 21 anchor t + l    at x2                     ymax+0.2            callback '!this.nAngle('  range 180 -180 ndp 0 width 4

    -- Angle from horizontal
    numericinput .hAngle 'Angle from horizontal:'   tagwidth 21 anchor t + l    at xmin                   ymax+0.2            callback '!this.hAngle('  range 90 -90 ndp 0 width 4

    -- Floor Covering height
    text .flrCoverHeight 'Offset above owning element:'  tagwidth 19  anchor top + left+right           at x2                     ymax+0.5            callback '!this.elevation()' width 10  is REAL format !!distanceFmt

    -- XY Offset of floor from building origin
    paragraph .offset             anchor top + left + right            at x2                   ymax+0.2                text 'Floor Covering Offset:'
    text .xOffset   'X:'                            anchor top + left + right   at xmin+5                 ymax                callback '!this.offset()' width 21 is REAL format !!distanceFmt
    text .yOffset   'Y:'                            anchor top + left + right   at xmin                   ymax+0.2            callback '!this.offset()' width 21 is REAL format !!distanceFmt

    -- Defaults
    frame .criteria FoldUpPanel 'Design Criteria' anchor top + left + right     at x0                     ymax+0.5            width 32

      -- Colour scheme
      combo .colSchema 'Colour Schema:' tagwidth 11 anchor t + l                at x0.5                   ymax+0.5            width 13

      -- Fire rating
      combo .fireRating 'Fire rating:'  tagwidth 11 anchor t + l                at x0.5                   ymax+0.5            width 13

    exit

    -- Defaults
    frame .defaults FoldUpPanel 'Defaults'          anchor top + left + right   at x0                     ymax+0.5            width 32

      combo .flrCoverType 'Floor Covering Type:'           tagwidth 16 anchor t + l         at xmin                   ymax+0.5            width 8
      combo .flrCoverCode 'Floor Covering Code:'           tagwidth 16 anchor t + l         at xmin                   ymax+0.2            width 8

    exit

    -- Modification data specific to a floor covering
    frame .modPane panel                            anchor top + left + right   at x0                     ymax

      -- Information
      frame .information FoldUpPanel 'Information'           anchor top + left + right   at x0                     ymax+0.5            width 32
        text .flcare   'Area:'    tagwidth 16               anchor top + left + right   at x0.5                   ymax                 width 11 is REAL format !!accAreaFmt
        text .nvol     'Volume:'  tagwidth 16               anchor top + left + right   at x0.5                   ymax+0.5             width 11 is REAL format !!accVolFmt
      exit

      -- Accept Changes
      paragraph .modAcceptIcon                      anchor top + left           at x0                     ymax+0.2            pixmap width 16 height 16
      button .modAccept  linkLabel 'Accept Changes' anchor top + left           at xmax+0.5               ymin                callback '!this.modify()' width 10

      -- Discard Changes
      paragraph .modDiscardIcon                     anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
      button .modDiscard linkLabel 'Discard Changes' anchor top + right         at xmax+0.5               ymin                callback '!this.flrCoverModify(!this.element)' width 10

      paragraph .modBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      button .modMain   linkLabel   'Back to main Floor Covering tasks'                at xmax+1                 ymin                callback '!this.mainTasks(true)' width 24

      paragraph .blTskBackMainIcon2            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
      button .blTskMain2     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

    exit

    -- Creation data specific to a floor covering
    frame .crtPane panel                            anchor top + left + right   at xmin.modPane           ymin.modPane

      paragraph .createGeometry                     anchor top + left + right   at x0.5                   ymax                text 'Geometry' width 28 lines 1
      line .editLine3                               anchor top + left + right   at xmin                   ymax                horizontal width 32

      -- Define geometry
      toggle .crtShapeO 'Use owning ELEMENT geometry' tagwidth 26 anchor t + l + r  at xmin               ymax+0.2            callback '!this.useOwnersGeometry()'
      button .crtShape linkLabel  'Define Floor Covering geometry:' anchor t + l + r   at xmin                   ymax+0.2            callback '!this.geometry()' width 28
      paragrap .crtShapeDef                         anchor top + left + right   at xmin+2                 ymax                width 28 lines 1

      -- Create floor covering
      paragraph .crtAcceptIcon                      anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .crtAccept linkLabel 'Create Floor Covering'  anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.create()'

      paragraph .crtBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .crtMain   linkLabel 'Back to main Floor Covering tasks'                  at xmax+1                 ymin                callback '!this.mainTasks(true)' width 24

      paragraph .blTskBackMainIcon3            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
      button .blTskMain3     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

    exit

  exit
  -- End of editPane

  frame       .camberFillPane   panel                                               anchor top + left + right at x0         ymax.currentOwner

    paragraph .flrCoverElement                                                      anchor top + left         at x0.5       ymin                                                          width 30 lines 1
    paragraph .camberFillListTag                                                    anchor top + left + right at x0.5       ymax                text 'List of Cut Planes'
    line .camberFillLine0                                                           anchor top + left + right at xmin       ymax                horizontal width 32

    list      .cutPlaneList                                                        anchor T+L+R               at x0.5         ymax+0.2           callback '!this.updateCutPlaneFromListSelection()'  columns  width 30 hei 7
    -- Allows the user to define the plane created in the graphical canvas
    text .cutPlaneDescription 'Description:' tagwidth 10                            anchor top + left + right at x0.5       ymax +0.2           width 19 is STRING
    paragraph .planeOptPara                                                         anchor top + left         at x0.5       ymax+0.5            text 'Define Plane'                           width 9
    option    .planeOption                                                          anchor top + left         at xmax+3     ymin                                                              width 13

    -- Plane definition  attributes
    paragraph .planeAttrib                                                          anchor top + left         at x0.5       ymax+0.5            text 'Plane Definition Attributes'            width 30 lines 1
    line      .camberFillLine1                                                      anchor top + left         at xmin       ymax-0.1            horizontal width 32
    -- Plane size
    text      .planeSize        tagwidth 10   'Plane Size'                          anchor top + left         at x1         ymax+0.5            width 12.5 is REAL format !!distanceFmt

    -- Plane fill
    toggle    .planeFill                      | Fill|                               anchor top + left         at xmax+1.0   ymin                states |off| |on|

    -- Plane Direction and Position
    text      .planeDirection   tagwidth 10   'Plane Direction '                    anchor top + left         at x1         ymax+0.5            callback '!this.modifyPlane(''MODIFYDIR'')'   width 12.5 is STRING
    button    .flipPlane        linklabel     'Flip Plane'                          anchor top + left         at xmax+0.5   ymin                callback '!this.flipPlane()'      width 5

    button    .planePos         linklabel     'Pick Position'                       anchor top + left         at x1         ymax+0.5            callback '!this.pickPlanePos()'      width 8

    container .coNetPosition    PMLNetCONTROL 'NET'                                 anchor top + left         at x1         ymax+0.1                                                          width 32  height 4

    -- Create camber fill cutplane
    paragraph .camberAcceptIcon                                                     anchor top + left         at x0         ymax+0.5            pixmap                                        width 16 height 16

    -- Modify camber fill cutplane
    button    .camberModify     linkLabel     'Accept Changes'                      anchor top + left         at xmax+1   ymin            callback '!this.modifyCutPlane()' width 22
    paragraph .cutPlanecreateIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button    .crtCamberFlr  linkLabel 'Create New Camber/Sheer Plane'                  anchor top + left         at xmax+1    ymin                callback '!this.createCutPlane()'
    paragraph .cutPlaneDeleteIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button    .delCamberFlr  linkLabel 'Delete Camber/Sheer Plane'                   anchor top + left   at xmax+1    ymin                callback '!this.camberFillDelete()'

    paragraph .camberBackIcon                                                       anchor top + left         at x0         ymax+0.5            pixmap                                        width 16 height 16
    button    .camberMain       linkLabel     'Back to main Floor Covering tasks'   anchor top + left         at xmax+1     ymin                callback '!this.backToFlrCovTasks()'              width 24

    paragraph .blTskBackMainIcon5                                                   anchor top + left         at x0         ymax+0.5            pixmap                                        width 15 height 15
    button    .blTskMain5       linkLabel     'Return to main tasks'                anchor top + left         at xmax+1     ymin                callback '!this.backToMainRoomDesignTasks()'  width 20

  exit
  --End of camberFillPane

    -- Floor layer definition
  frame .floorLayer panel                          anchor top + left + right   at x0                     ymax.currentOwner

    paragraph .definelayerTitle                           anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .layerLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    list      .layerList                                                        anchor T+L+R   at x2         ymax+0.2                       callback '!this.updateLayerFromListSelection()'  columns  width 24 hei 7

    button    .layerUpButton                                                    anchor T+R     at xmax+0.2   ymin+1.5              pixmap   callback '!this.layerUp()'                       width 16 height 16
    button    .layerDownButton                                                  anchor T+R     at xmin       ymax                  pixmap   callback '!this.layerDown()'                     width 16 height 16

   text .layerDescription 'Description:' tagwidth 10      anchor top + left + right   at x2                     ymax .layerList +0.2   width 19 is STRING
   text .layerthickness 'Thickness:' tagwidth 10      anchor top + left + right   at x2                     ymax+0.2            callback '!this.validateThick()' width 19 is REAL format !!distanceFmt
   option .layerMaterial  'Material:'    tagwidth 10      anchor top + left + right   at x2                     ymax+0.3               width 17

    frame .layerattributes FoldUpPanel 'Material Information' anchor top + left + right     at x0                     ymax+0.5            width 30
      text .layerFflext     'Edge Extension:'    tagwidth 14      anchor top + left + right   at x2          ymax+0.2            callback '' width 15 is REAL format !!distanceFmt
      text .layerMatwidth   'Material Width:'    tagwidth 14      anchor top + left + right   at x2          ymax+0.2            callback '' width 15 is REAL format !!distanceFmt
      text .layerMatlength  'Material Length:'   tagwidth 14      anchor top + left + right   at x2          ymax+0.2            callback '' width 15 is REAL format !!distanceFmt
      text .layerMatover    'Material overlap:'  tagwidth 14      anchor top + left + right   at x2          ymax+0.2            callback '' width 15 is REAL format !!distanceFmt
    exit

    paragraph .layerApplyIcon              anchor top + left             at x0                     ymax+0.2            pixmap width 16 height 16
    button .layerApply  linkLabel 'Apply Changes' anchor top + left      at xmax+1               ymin                callback '!this.modifyFlrLayer()' width 10

    paragraph .layercreateIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .layerCreate   linkLabel   'Create new layer'                at xmax+1                 ymin                callback '!this.flrLayerCreate(!this.element)'

    paragraph .layerDeleteIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .layerDelete   linkLabel   'Delete layer'                at xmax+1                 ymin                callback '!this.deleteFlrLayer()'

    paragraph .layerBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .layerMain   linkLabel   'Back to main Floor Covering tasks'                at xmax+1                 ymin                callback '!this.mainTasks(true)' width 24

    paragraph .blTskBackMainIcon4            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain4     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit
  -- End of floorLayer

  -- Form Members
  using namespace 'Aveva.Pdms.Presentation'

  -- Alternative text for owning element type
  member .ownerAltText    is STRING

  -- Owning element
  member .owningElement   is DBREF
  member .ownerType       is STRING

  -- Current Element (floor covering)
  member .element         is DBREF
  member .definition      is DBEFLRCOVER

  member .layerElement    is DBREF
  member .cutPlaneElement    is DBREF

  -- Floor coverings for modification
  member .flrCovList        is ARRAY
  member .flrCovNames       is ARRAY

  member .arrayOfLayers is ARRAY
  member .arrayOfCutPlanes is ARRAY

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK
  member .refreshTask     is BLOCK

  -- Warning action
  member .warningAction   is BLOCK

  -- Undo for form
  member .undo            is UNDOABLE

  -- EDG Description
  member .edgDescription  is STRING

  -- Aid Numbers
  member .aidAxes         is REAL
  member .outerBoundary   is REAL
  member .innerBoundaries is REAL
  member .layerDefinition is DBEFLRLAYER

  -- Floor coverings grid
  using namespace 'Aveva.Pdms.Presentation'
  member .flrCovGrid        is NETGRIDCONTROL

  -- Camber Fill Plane Position control
  member .netPosControl        is POSITIONCONTROL

  -- Graphical Plane for camber fill definition
  member .plane                 is GPHPLANE

  -- Stores the aid number registered for the GPHPLANE
  member .planeNumber           is REAL

  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
  --!!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accFlrCoverDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accFlrCoverDefinition()

  -- Set form to auto scroll
  !this.autoScroll              = true

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!this.dummy()')
  !this.refreshTask             = object BLOCK('!this.dummy()')

  -- Collapse FoldUp panels
  !this.defaults.expanded       = FALSE
  !this.criteria.expanded       = FALSE
  !this.layerattributes.expanded = FALSE
  !this.information.expanded = FALSE

  !this.flcare.editable = FALSE
  !this.nvol.editable   = FALSE

  -- Set events for numeric gadgets
  !this.nAngle.modifiedEvents   = true
  !this.hAngle.modifiedEvents   = TRUE

 -- Initialise task panes
  !this.mainTasks(true)
  !this.createFlrCover(false)
  !this.modifyFlrCover(false)
  !this.defineFlrLayer(false)
  !this.createCamberFill(false)

  -- Set "Back" icon
  !backIcon                     = !!pml.getpathname('back.png')
  !this.crtBackIcon.addPixmap(!backIcon)
  !this.modBackIcon.addPixmap(!backIcon)
  !this.layerBackIcon.addPixmap(!backIcon)
  !this.camberBackIcon.addPixmap(!backIcon)

  !this.blTskBackMainIcon1.addPixmap(!backIcon)
  !this.blTskBackMainIcon2.addPixmap(!backIcon)
  !this.blTskBackMainIcon3.addPixmap(!backIcon)
  !this.blTskBackMainIcon4.addPixmap(!backIcon)
  !this.blTskBackMainIcon5.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getpathname('create.png')
  !this.crtAcceptIcon.addPixmap(!createIcon)
  !this.layercreateIcon.addPixmap(!createIcon)
  !this.cutPlanecreateIcon.addPixmap(!createIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getpathname('accept.png')
  !this.modAcceptIcon.addPixmap(!acceptIcon)
  !this.layerApplyIcon.addPixmap(!acceptIcon)
  !this.camberAcceptIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getpathname('discard.png')
  !this.modDiscardIcon.addPixmap(!discardIcon)

  -- Set "Delete" icon
  !layerDeleteIcon                  = !!pml.getpathname('deletece16.png')
  !this.layerDeleteIcon.addPixmap(!layerDeleteIcon)
  !this.cutPlaneDeleteIcon.addPixmap(!layerDeleteIcon)

  -- Set "Up arrow" icon
  !upArrowIcon                  = !!pml.getpathname('uparrow16.png')
  !this.layerUpButton.addPixmap(!upArrowIcon)

  -- Set "Down arrow" icon

  !downArrowIcon                  = !!pml.getpathname('downarrow16.png')
  !this.layerDownButton.addPixmap(!downArrowIcon)

  -- Add .Net control to PML container for floor coverings
  using namespace 'Aveva.Pdms.Presentation'
  !this.flrCovGrid              = object NETGRIDCONTROL()
  !this.flrCovs.control         = !this.flrCovGrid.handle()
  !this.flrCovGrid.addEventHandler('afterSelectChange', !this, 'selectFlrCov')

  -- EDG Description
  !this.edgDescription    = 'Accommodation Floor Covering Definition'

  -- Assign aid numbers for form
  !this.aidAxes           = !!aidNumbers.add('Floor Covering - Axes')
  !this.outerBoundary     = !!aidNumbers.add('Floor Covering - OuterBoundary')
  !this.innerBoundaries   = !!aidNumbers.add('Floor Covering - InnerBoundaries')

  -- Populate combo with defaults
  !this.colSchema.dtext   = !!accConfig.colourSchemes()
  !this.fireRating.dtext  = !!accConfig.fireRatings()
  !this.flrCoverType.dtext     = !!accConfig.floorTypes()
  !this.flrCoverCode.dtext     = !!accConfig.floorCodes()

  -- Populate material (matref) combo with default
  !dtext = ARRAY()
  !c = 'None'
  !dtext.append(!c)
  !this.layerMaterial.dtext = !dtext

  -- initialise the PMLNet Position controls
  !this.positionControl()

  -- validate the plane direction
  !this.planeDirection.validateCall  = '!this.validateDirection()'

  -- callback for camber fill definition plane
  !this.planeSize.callback          = '!this.modifyPlane( |SIZE| )'
  !this.planeFill.callback          = '!this.modifyPlane( |FILL| )'

  -- Option for Plane definition for Cut Plane for Camber/Sheer
  !planeDef[1]  = 'Graphical Pick'
  !planeDef[2]  = 'Element'
  !planeDef[3]  = 'Derived by 3 Points'
  !this.planeOption.dtext  = !planeDef

  !planeDefRtext[1]  = 'GPHPICK'
  !planeDefRtext[2]  = 'ELEMENT'
  !planeDefRtext[3]  = 'DERIVED'
  !this.planeOption.rtext  = !planeDefRtext

  !this.planeOption.callback =  '!this.camberPlaneDefinition()'

  -- Load aid constructors, if they haven't already been loaded
  if(undefined(!!aidConstructors)) then
    !aidConstructors = object AIDCONSTRUCTORS()
    !aidConstructors.globalInstance()
  endif

  -- Load information from Configuration
  !this.refreshConfig()

  -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

endmethod
-- End of method

