--
-- Method:      dummy
--
-- Description: Dummy method for unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dummy()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Get current element
  !element                = !!accNavigator.currentSelection()

  -- If element is unset, then initialise form with limited actions
  if(!element.unset() or !element.badref()) then
    !this.owningElement         = object DBREF()
    !this.currentOwner.val      = 'No active element selected'

  -- Initialise form with relevant actions
  else
    -- Set owner where layout data is to be stored
    !this.owningElement         = !element
    !this.ownerType             = !this.owningElement.type
    --!this.ownerAltText          = !!accConfig.attribute(!this.ownerType)
    !this.currentOwner.val      = 'Active element: ' & !this.owningElement.namn

    !this.flrCovsActive.tag          = 'Select ' & !this.owningElement.namn & ' floor coverings'

    !ownerType = !!accConfig.typeDescription(!this.ownerType)
    !this.flrCoverHeight.tag    = 'Offset above ' & !ownerType & ':'
  endif

  !elements                   = !this.flrCovGrid.getSelectedRowTags()
  !this.mtMod.active          = !elements.empty().not()
  !this.mtModLayers.active    = !elements.empty().not()
  !this.mtDel.active          = !elements.empty().not()
  !this.useActiveFlrCovs()

  -- Unit Conversions for Area and Volume
  !this.accUnitsFormats()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh form from navigator.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh task
  if(!this.shown()) then
    !this.initialise()
    !this.refreshTask.evaluate()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Floor Covering Tasks
  !this.createTasks.val         = 'Create'
  !this.modifyTasks.val         = 'Modify'
  --!this.copyTasks.val           = 'Copy'
  !this.deleteTasks.val         = 'Delete'

  -- Floor Covering Tags
  !this.nAngle.tag              = 'Angle from Y axis:'

  -- Populate combo with defaults
  !this.colSchema.dtext   = !!accConfig.colourSchemes()
  !this.fireRating.dtext  = !!accConfig.fireRatings()
  !this.flrCoverType.dtext     = !!accConfig.floorTypes()
  !this.flrCoverCode.dtext     = !!accConfig.floorCodes()

    -- Grid defaults
  !columnExcelFilter            = !!accConfig.navigator.columnExcelFilter
  !outlookGroupStyle            = !!accConfig.navigator.outlookGroupStyle
  !columnSummaries              = !!accConfig.navigator.columnSummaries
  !labelVisibility              = !!accConfig.navigator.labelVisibility

  -- Control configuration (Rooms)
  !this.flrCovGrid.columnExcelFilter(!columnExcelFilter)
  !this.flrCovGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.flrCovGrid.columnSummaries(!columnSummaries)
  !this.flrCovGrid.fixedHeaders(false)
  !this.flrCovGrid.fixedRows(false)
  !this.flrCovGrid.singleRowSelection(true)
  !this.flrCovGrid.setLabelVisibility(!labelVisibility)

  -- make the camber fill plane links inactive
  !this.crtCamberFlr.active = false
  !this.modCamberFlr.active = false
  !this.delCamberFlr.active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.mainTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.mainTasks(false)')
    !this.refreshTask         = object BLOCK('!this.dummy()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Main Floor Covering Tasks'

  endif

  !this.updateMainTaskGadgets()

  -- Show/hide task pane
  !this.mainTaskPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createFlrCover
--
-- Description: Display floor covering pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createFlrCover(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.createFlrCover(false)')
    !this.refreshTask         = object BLOCK('!this.flrCoverCreate()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Create Floor Covering'

    -- Manage create/modify panels
    !this.modPane.visible     = false
    !this.crtPane.visible     = true
    !this.camberFillPane.visible  = false

    !this.definition.draw()

    !this.crtShapeO.val = false
    !this.crtShape.active = true


  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

