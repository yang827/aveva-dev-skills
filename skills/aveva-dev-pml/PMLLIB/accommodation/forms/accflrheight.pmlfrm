--
-- File:            accflrheight.pmlfrm
--   Type:          Form Definition
--   Group:         Accommodation Application
--     Keyword:
--   Module:        Accommodation
--   Replaces:
--
-- Author:          G.Somasundaram
-- Created:         15/05/2007 10:45
--
--
-- Description: Set the flrheight of Accommodation elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accFlrHeight()                   -                   Constructor
--  close()                          -
--  draw()                           -                   Setup EDG pick event for picking position
--  elevwrt(DBREF)                   REAL
--  initialise()                     -
--  offset(EDGPOSITIONDATA)          -
--  pickOffset()                     -                   Define EDG event to pick position
--  setup(DBREF)                     BOOLEAN
--  tidy()                           -
--  update()                         -
--  updateElement()                  -                   Update element with modified values
--  updateGadgets()                  -
--  updateWorldElevGadget()          -
--


 setup form !!accFlrHeight

  !this.formTitle     = 'Floor Height'
  !this.iconTitle     = 'Flrheight'
  !this.callback      = '!this.initialise()'
  !this.quitcall      = '!this.tidy()'
  !this.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
  button .selectElement linkLabel 'Element:'            anchor top + left           at x0.5   ymin            callback '!this.initialise()' width 6
  paragraph .namepara                                   anchor top + left + right   at xmax   ymin                                           width 20 lines 1

  button .flrheightbtn linkLabel 'Pick Floor Height...' anchor top + left + right   at x0.5   ymax+0.2        callback '!this.pickOffset()' width 20

  -- flrheight of element with respect to owner`
  text   .flrheightTxt    'Floor Height:'               anchor top + left + right   at x2   ymax            callback '!this.update()' width 17 is REAL format !!distanceFmt
  paragraph .wrtworldtxt                                anchor top + left           at x2   ymax+0.2          width 20

  -- Apply button
  button .acceptBtn  'Apply'                            anchor top + left           at x0.5   ymax+0.2        callback '!this.updateElement()' width 5

  -- Dismiss button
  button .discardBtn  'Dismiss'                         anchor top + right          at xmax.flrheightTxt-size ymin callback '!this.close()'  width 5

  -- Form Members
  -- Current Element
  member .element         is DBREF

  -- flrheight Values
  member .accFlrHeight        is REAL

   -- Plane of element
  member .plane           is PLANE

   -- Attribute data
  member .attributeData   is DBEATTRIBSEARCH

  member .aidNumber       is REAL

 exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accFlrHeight
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .accFlrHeight()
  !this.wrtworldtxt.val         = 'Elevation wrt World:   '

  !this.attributeData = object DBEATTRIBSEARCH(object DBREF() , 'FlrHeight' , object ARRAY())

  -- Get aid number
  !this.aidNumber   = !!aidNumbers.add('FlrHeight display')

endmethod

------------------------------------------------------------------------
--
-- Method:initialise
--
-- Description:Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--  element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.setup(!!ce)

endmethod
------------------------------------------------------------------------
--
-- Method:  setup
--
-- Description: Setup form for passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if element is valid
--
------------------------------------------------------------------------

define method .setup(!passedElement is DBREF) is BOOLEAN


  !element         = !this.attributeData.element(!passedElement)

  if (!element.unset() ) then
     !!alert.warning('Element doesn''t have an Floor Height attribute.')
     return FALSE
  endif

  -- Element being modified
  !this.element         = !element

    -- get the Floor Height value of the Element being modified
  !this.accFlrHeight         = !element.flrheight

  -- Update input gadgets with values
  !this.namepara.val    = !element.flnn

  -- Update input gadgets
  !this.updateGadgets()

  !this.updateGadgets()
 -- Tag element
  !this.draw()

 -- Return
  return TRUE

endmethod

------------------------------------------------------------------------
--
-- Method:    update
--
-- Description: Sets the flrheight of the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- Initialise Variables
  !this.accFlrHeight = !this.flrheightTxt.val

  -- update the world coordinate gadget
  !this.updateWorldElevGadget()

  !this.draw()

endmethod
------------------------------------------------------------------------
--
-- Method:    updateGadgets
--
-- Description: Update gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  -- Initialise Variables
  !this.flrheightTxt.val = !this.accFlrHeight

  -- update the world coordinate gadget
  !this.updateWorldElevGadget()

  if (!!dbrefUpdatable(!this.element).not() )  then
      $P $!!error.text
      !this.acceptBtn.active = FALSE
  else
      !this.acceptBtn.active = TRUE
  endif

endmethod
------------------------------------------------------------------------
--
-- Method: close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.tidy()
  !this.hide()
endmethod

------------------------------------------------------------------------
--
-- Method: tidy
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()
  AID CLEAR ALL $!<this.aidNumber>
  handle ANY
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      updateElement
--
-- Description: Update element with modified values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateElement()

--mark for undo option
  !flrheightMark = object UNDOABLE()
  !undoDesc = 'Modify floorheight of $!this.element.namn'
  --q var !undoDesc
  !flrheightMark.description(!undoDesc)
  !flrheightMark.add()

  -- Update Ceiling Height
  !this.element.flrheight   = !this.accFlrHeight

  --for undo option
  !flrheightMark.endundoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      draw()
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draw()

  -- Remove aid graphics
  !this.tidy()

  !position       = !this.element.position
  !position.up    = !this.accFlrHeight

 if(!this.accFlrHeight.neq(0)) then
    AID ARROW NUMBER $!<this.aidNumber> AT $!position DIRECTION U HEIGHT 1000mm
    AID TEXT NUMBER  $!<this.aidNumber> '$!this.accFlrHeight'at $!position
 endif

endmethod

------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Define EDG event to pick position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- method not used  will be used in case any EDG pick is necessary
define method .pickOffset()

  -- Initialise Variables
  !prompt               = 'Pick Floor height position'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Modify Floor Height'
  !packet.remove        = true
  !packet.action        = '!!' & !this.name() & '.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

 !elePosition  = !this.element.position
 !pickPosition = !data.position.wrt(!elePosition.origin)

 !this.accFlrHeight = !pickPosition.up

 -- draw the aids
 !this.draw()

  -- Update the gadgets
 !this.updateGadgets()

endmethod
-- End of method offset
-----------------------------------------------------------------------
--
-- Method:      updateworldelevgadget
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateWorldElevGadget()

 -- update  gadgets  related to world
 !elevWorld         = !this.elevwrt(world)
 !this.wrtworldtxt.val = 'Elevation wrt World:   ' & !elevWorld.string()

endmethod
-- End of method
--------------------------------------------------------------------------
-- Method:   elevwrt()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elevwrt(!relativeRef is DBREF) is REAL

  !position    = !this.element.position
  !position.up = !this.accFlrHeight
  !position    = !position.wrt(!relativeRef )

  return !position.up

endmethod
