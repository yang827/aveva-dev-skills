------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickOffset()

  -- Initialise Variables
  !prompt               = 'Pick insulation requirement origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Continue"
--    3   R      STRING      "Continue" text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING, !continue is STRING)

  -- Switch warning pane
  !this.currentPane.visible   = false
  !this.warningPane.visible   = true

  -- Concatenate message into a single line
  !display    = ''
  do !i indices !message
    !display  = !display & ' ' & !message[!i]
  enddo

  -- Display message
  !this.warning.val           = !display.trim()
  !this.warningDone.tag       = !continue

  -- Set "Continue" action (If the action is dependent on other criteria
  -- e.g. being in the correct positioning   in the hierarchy, then the
  -- active state of the "Done" button needs to be managed.
  !this.warningAction         = object BLOCK(!action)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warningDone
--
-- Description: Exit warning
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warningDone()

  -- Hide warning pane
  !this.warningPane.visible   = false

  -- Execute action
  !this.warningAction.evaluate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      exampleWarning
--
-- Description: Example of how to use a warning with an action
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exampleWarning1()

  -- Define message to be displayed
  !message[1] = 'This is the message that is to be displayed in the '
  !message[2] = 'warning pane. The message can be up to 132 characters'
  !message[3] = 'long.'
  !this.warning(!message, '!this.firstTaskPane(true)', !this.ftpWarningMsg.val)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteInsurq
--
-- Description: Delete Insulation Requirement
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteInsurq()

  --should set current insulation requirement to delete here (from navigator for other element types)

  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.element).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      deleteSelectedInsurq
--
-- Description: Delete Selected Insulation Requirement
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteSelectedInsurq()

  --should set current insulation requirement to delete here (from navigator for other element types)

  if !this.insurqGrid.getSelectedRows().unset().not() then
    !element = !this.insurqGrid.getSelectedRows()[1][1].dbref()
  else
    !element = object DBREF()
  endif

  if !element.unset().not() then

    !this.element = !element
    -- Delete current element
    if(!!accDeleteManager.deleteElement(!this.element).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
    endif

    !this.useActiveInsurqs()
    !selectedRows = !this.insurqGrid.getSelectedRows()
    if (!selectedRows.set()) then
      !element = !selectedRows[1][1].dbref()
      !this.element = !element

      -- close the loop editor
      if(defined(!!dbeProfileEdit) and !!dbeProfileEdit.shown()) then
        !!dbeProfileEdit.close()
      endif

    endif

    -- Refresh Content navigator
    !!acccontentnavigator.refresh()
    handle (2,751)
    endhandle

  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      pickPlane
--
-- Description: pick plane (EDG pick)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPlane()
  -- Based on edgworkingplane.pmlfrm
   -- Initialise Variables

  !packet                = object EDGPACKET()
  -- Set Data
  !packet.description    = 'Make picked plane/grid current active plane'
  !packet.action         = '!!accInsurqDefinition.setPlane(!this.return[1])'
  !packet.remove         = true
  !packet.pickPacket.stdAny('Pick plane/grid to be made "Active"')
  !packet.pickPacket.picks[1].prompt         = STRING()
  !packet.pickPacket.picks[1].pick.cursor    = 'DOUBLECROSS'
  !packet.pickPacket.picks[1].pick.stdGraphics()
  !packet.pickPacket.picks[1].pick.input[1]  = 'PKEY eq ''rubbish'''
  !packet.pickPacket.picks[1].pick.input[2]  = 'NUMB eq -99'
  !packet.pickPacket.picks[1].pick.input[6]  = 'FACET EDGE'
  !packet.pickPacket.picks[1].pick.input[10] = /*
  !packet.pickPacket.picks[1].pick.input[11] = 'PKOWNER'
  -- Set Common Data
  !packet.key            = 'planePacket'
  !packet.priority       = 2
  !packet.type           = 'edgPlane'

  -- Add Packet to edg system
  !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------
--
-- Method:      setPlane
--
-- Description: set plane (from pickPlane EDG pick method)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPlane(!pickData is EDGPICKDATA)

    -- If there are no facets, then we can't derive a plane
    if(!pickData.facetCount gt 0) then

      -- Derived plane from picked plane
      !plane    = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[3])
      -- Try 4th facet
      handle any
        !plane  = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[4])
      endhandle

      !plane.position = !plane.intersection(!pickData.pickLine)
      --!plane.position = !pickData.item.pos.wrt(world)

      !this.definition.plane = !plane
      !this.definition.referenceplane = !plane

      -- This needs looking at; offset position of INSURQ relative to owner

--!this.definition.position(!pickData.item.pos.wrt(world))
      !this.definition.position(!plane.position)
      !this.definition.draw()

      --do gadgets
      --!this.updateAttributes()

      --update plane and re-draw (how?)
      --position of plane - how to deal with this?
      --definition has plane and reference plane...
      --!this.definition.elevation(!this.insurqHeight.val)

    else
       !!alert.error('Unable to derive plane from picked element.')
    endif

endmethod
------------------------------------------------------------------------
--
-- Method:      selectInsurq
--
-- Description: Select Insulation Requirement from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectInsurq(!dummyArray is ARRAY)

  -- Unenhance walls
  !this.tidyInsurqs()

  -- Initialise Variable
  !elements = !this.insurqGrid.getSelectedRowTags()
  !list     = !this.insurqNames
  enhance all from !elements colour red

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      tidyInsurqs
--
-- Description: Tidy insulation requirements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyInsurqs()

  -- Get current list
  !list = !this.insurqNames
  unenhance all from !list

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      insurqHeight
--
-- Description: Set height of insurq
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insurqHeight(!gadget is GADGET, !select is STRING)

  -- Initialise Variables
  !this.definition.height(!gadget.val)
  refresh

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:        selectMaterial
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectMaterial()

  -- Define form if required
  if(undefined(!!accInsurqMaterials)) then
    pml reload form !!accInsurqMaterials
  endif

  -- Setup form
  !action = '!!' & !this.name() & '.setMaterial(!material)'
  if(!this.definition.matref.badref()) then
    !materialString = 'None'
  else
    !materialString = !this.definition.matref.namn
  endif

  !!accInsurqMaterials.setup(!materialString, !action)
  show !!accInsurqMaterials

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setMaterial
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMaterial(!material is STRING )

  !matref = !material.dbref()
  handle ANY
    !this.definition.matref = object DBREF()
  elsehandle none
    !this.definition.matref = !matref
  endhandle

  !this.updateInsuMaterial()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        updateInsuMaterial
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateInsuMaterial()

  if !this.definition.matref.set() then
    !this.insurqCode.val    = !this.definition.matref.namn
  else
    !this.insurqCode.val    = 'None'
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      backToMainRoomDesignTasks
--
-- Description: Switching to Main Room Design Tasks
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backToMainRoomDesignTasks()

  !this.mainTasks(true)
  --!this.hide()
  !!accTaskManager.active('accDetail')
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        accUnitsFormats
--
-- Description:   Set unit global format objects specific to room design
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accUnitsFormats()

  -- Convert area units to inch and metric units to metres
  -- set up area and volume formats
  !!accAreaFmt = !!areaFmt
  !!accVolFmt  = !!volumeFmt

  if( !!isImperialLength('DIST') ) then
    -- set square inch format
    !!accAreaFmt.dp    = 0
    !!accAreaFmt.units = 'inch'
    !!accAreaFmt.label = ' sq in'
    -- set cubic inch format
    !!accVolFmt.dp     = 0
    !!accVolFmt.units  = 'inch'
    !!accVolFmt.label  = ' cu in'
  else
    -- set square metre format
    !!accAreaFmt.dp    = 3
    !!accAreaFmt.units = 'metre'
    !!accAreaFmt.label = ' sq metre'
    -- set cubic metre format
    !!accVolFmt.dp     = 3
    !!accVolFmt.units  = 'metre'
    !!accVolFmt.label  = ' cu metre'
  endif

endmethod
-- End of method definition
