-- File:            accinsurqdefinition.pmlfrm
--   Type:          Form Definition
--   Group:         Accommodation
--
--     Keyword:     Insulation Requirement Definition
--   Module:        Design
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Sun Feb 4 20:00:00 GMT 2007
--
--
-- Description:
--    Main form for insulation requirement (FLRCOV) definitions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accInsurqDefinition()            -                   Constructor
--  accUnitsFormats()                -                   Set unit global format objects specific to room design
--  backToMainRoomDesignTasks()      -                   Switching to Main Room Design Tasks
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  create()                         -                   Create element
--  createInsurq(BOOLEAN)            -                   Display insulation requirement pane in create mode
--  deleteInsurq()                   -
--  deleteSelectedInsurq()           -                   Delete Selected Insulation Requirement
--  dummy()                          -                   Dummy method for unset
--  exampleWarning1()                -
--  geometry()                       -                   Define geometry for element
--  geometryUpdate(SHAPEDEFINITION)  -                   Update with returned data
--  hAngle(GADGET,STRING)            -                   Set horizontal angle
--  height(GADGET,STRING)            -                   Set height of element
--  initialise()                     -                   Initialise form.
--  insurqCreate()                   -                   Create Insulation Requirement
--  insurqGeometry()                 -                   Switch to geometry modification pane for current element
--  insurqGeometry(BOOLEAN)          -                   Switch to geometry modification pane
--  insurqGeometry(DBREF)            -                   Switch to geometry modification pane for specified element
--  insurqHeight(GADGET,STRING)      -                   Set height of insurq
--  insurqModGeometry()              -                   Modify geometry for INSURQ (needs to pass current geometry to shape editor)
--  insurqModify()                   BOOLEAN             Modify Insulation Requirement
--  insurqModify(DBREF)              BOOLEAN             Setup to modify insulation requirement
--  insurqModifySelection()          -                   Modify Selected Insulation Requirement
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  modGeometry()                    -
--  modGeometryUpdate(SHAPEDEFINITION) -                   Update with returned data
--  modify()                         -                   Modify (write modified values to DB)
--  modifyInsurq(BOOLEAN)            -                   Display insulation requirement pane in modify mode
--  pickOffset()                     -                   Setup EDG pick event for picking position
--  pickPlane()                      -                   pick plane (EDG pick)
--  refresh()                        -                   Refresh form from navigator.
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  selectInsurq(ARRAY)              -                   Select Insulation Requirement from grid
--  selectMaterial()                 -
--  setMaterial(STRING)              -
--  setPlane(EDGPICKDATA)            -                   set plane (from pickPlane EDG pick method)
--  setTaskActive()                  -                   Set task buttons active state
--  tidyInsurqs()                    -                   Tidy insulation requirements
--  updateAttributes()               -                   Update gadgets with object data
--  updateData()                     -                   Update current data with gadget values
--  updateInsuMaterial()             -
--  updateInsurqList()               -                   Update grid of insulation requirements
--  useActiveInsurqs()               -                   Get insurqs from current active element
--  useOwnersGeometry()              -                   Use owning boundary definition (if there is one)
--  warning(ARRAY,STRING)            -                   Set warning task and message with default "Continue"
--  warning(ARRAY,STRING,STRING)     -                   Set warning task and message
--  warningDone()                    -                   Exit warning
--
import 'GridControl'
handle any
endhandle
setup form !!accInsurqDefinition dialog docking right

  !this.formTitle     = 'Insulation Requirement Definition'
  !this.iconTitle     = 'Insulation Requirement'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.definition.tidy()'
  !this.formRevision  = ' $Revision$ '

  -- Current hierarchy
  paragraph .currentOwner                     anchor top + left + right         at x0.5                   ymax                width 30 lines 1

  -- Main Task Pane
  frame .mainTaskPane panel                   anchor top + left + right         at x0                     ymax.currentOwner

    -- Insulation requirements
    paragraph .insurqListTag                 anchor top + left + right         at x0.5                   ymax                text 'List of Insulation Requirements'
    line .insurqL1                           anchor top + left + right         at xmin                   ymax                horizontal width 32

    -- List of insulation requirements to modify
    container .insurqs PMLNetCONTROL 'NET'      anchor top + left + right         at x0                     ymax                width 32 height 8

    -- Populate list of insulation requirements
    button .insActive    linkLabel 'Current Element'       anchor t + l + r      at x2                     ymax+0.5                 callback '!this.useActiveInsurqs()'  width 26

    -- Create options
    paragraph .createTasks                                                      at x0.5                   ymax                width 30 lines 1
    line .mainTaskL1                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtCrt         linkLabel 'Insulation Requirement'                                   at x2                     ymax                callback '!this.insurqCreate()' width 18

    -- Modify options
    paragraph .modifyTasks                                                      at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskL2                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtMod         linkLabel 'Insulation Requirement Definition'                        at x2                     ymax                callback '!this.insurqModifySelection()' width 20
    button .mtModGeom     linkLabel 'Insulation Requirement Geometry'                           at x2                     ymax                callback '!this.insurqModGeometry()' width 20

    -- Delete options
    paragraph .deleteTasks                                                      at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskL4                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtDel         linkLabel 'Delete Insulation Requirement'                            at x2                     ymax                callback '!this.deleteSelectedInsurq()' width 20

    paragraph .blTskBackMainIcon1            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain1     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20


  exit

  -- Insulation Requirement creation/modification pane
  frame .editPane panel                             anchor top + left + right   at x0                     ymax.currentOwner

    paragraph .editTitle                            anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .editLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Gadgetry definition for creation
    text .dbName  'Name:'  tagwidth 9               anchor top + left + right   at x2                     ymax+0.2            callback '!this.checkName(!this.dbName, !this.definition.name)' width 20 is STRING
    path down
    halign right
    text .dbDescription 'Description:' tagwidth 9   anchor top + left + right                                                 callback '' width 20 is STRING
    text .dbFunction 'Function:'       tagwidth 9   anchor top + left + right                                                 callback '' width 20 is STRING

    -- Positioning
    paragraph .location                             anchor top + left + right   at x0.5                   ymax+0.2            text 'Location:' width 28 lines 1
    line .editLine2                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Insulation Requirement height
    text .insurqEnvelope 'Envelope height:'  tagwidth 15  anchor top + left           at x2                     ymax+0.5           callback '!this.insurqHeight(' width 11  is REAL format !!distanceFmt

    -- Defaults
    frame .criteria FoldUpPanel 'Design Criteria' anchor top + left + right     at x0                     ymax+0.5            width 32

      text .pindensity   'Pin density:'        tagwidth 16              anchor top + left + right   at x0.5                   ymax+0.2            callback '' width 11 is REAL

      -- Fire rating
      combo .fireRating 'Fire rating:'  tagwidth 16 anchor t + l + r                at x0.5                   ymax+0.2            width 8.7

      text .fireResistance   'Fire resistance:'        tagwidth 16              anchor top + left + right   at xmin                   ymax+0.2            callback '' width 11 is REAL

      combo .insurqType 'Insulation Spec:'           tagwidth 16 anchor t + l + r        at xmin                   ymax+0.2            width 8.7

      button .matlSelect linkLabel  'Material...'   anchor top + left + right   at xmin                  ymax+0.2            callback '!this.selectMaterial()' width 8
      --line .editLine4                               anchor top + left + right   at x0.5                   ymax                horizontal width 32
      --para .insurqCode                at xmax+7                   ymin      text 'None'     width 15
      para .insurqCode                at xmin                   ymax      text 'None'     width 30

      text .defaultThickness   'Default thickness:'        tagwidth 16              anchor top + left + right   at x0.5                  ymax+0.2            callback '' width 11 is REAL format !!distanceFmt

    exit


    -- Modification data specific to a insulation requirement
    frame .modPane panel                            anchor top + left + right   at x0                     ymax+0.5

      -- Information
      frame .information FoldUpPanel 'Information'           anchor top + left + right   at x0                     ymax          width 32

        text .insare   'Area:'         tagwidth 16         anchor top + left + right   at x0.5                   ymax                 width 11 is REAL format !!accAreaFmt

        text .numpins   'Number of pins:'         tagwidth 16         anchor top + left + right   at x0.5                   ymax+0.2                 width 11 is REAL

      exit

      -- Accept Changes
      paragraph .modAcceptIcon                      anchor top + left           at x0                     ymax+0.2            pixmap width 16 height 16
      button .modAccept  linkLabel 'Accept Changes' anchor top + left           at xmax+0.5               ymin                callback '!this.modify()' width 10

      -- Discard Changes
      paragraph .modDiscardIcon                     anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
      button .modDiscard linkLabel 'Discard Changes' anchor top + right         at xmax+0.5               ymin                callback '!this.insurqModify(!this.element)' width 10

      paragraph .modBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      button .modMain   linkLabel   'Back to main Insulation Requirement tasks'                at xmax+1                 ymin                callback '!this.mainTasks(true)' width 16

    exit

    -- Creation data specific to a insulation requirement
    frame .crtPane panel                            anchor top + left + right   at xmin.modPane           ymin.modPane

      button .pickPlane linkLabel 'Set plane from graphics'       anchor top + left + right   at x2                     ymax            callback '!this.pickPlane()' width 20

      paragraph .createGeometry                     anchor top + left + right   at x0.5                   ymax+0.2                text 'Geometry' width 28 lines 1
      line .editLine3                               anchor top + left + right   at xmin                   ymax                horizontal width 32

      -- Define geometry
      toggle .crtShapeO 'Use owning ELEMENT geometry' tagwidth 28 anchor t + l + r  at xmin               ymax+0.2            callback '!this.useOwnersGeometry()'
      button .crtShape linkLabel  'Define Insulation Requirement geometry:' anchor t + l + r   at xmin                   ymax+0.2            callback '!this.geometry()' width 28
      paragrap .crtShapeDef                         anchor top + left + right   at xmin+2                 ymax                width 28 lines 1

      -- Create insulation requirement
      paragraph .crtAcceptIcon                      anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .crtAccept linkLabel 'Create Insulation Requirement'  anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.create()' width 20

      paragraph .crtBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .crtMain   linkLabel 'Back to main Insulation Requirement tasks'                  at xmax+1                 ymin                callback '!this.mainTasks(true)' width 26

    exit

  exit

  -- Modify geometrical information
  frame .modGeometry panel                          anchor top + left + right   at x0                     ymax.currentOwner

    paragraph .geomTitle                            anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .geomLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Define geometry definition method
    --text .gClnVoid 'Ceiling Void:' tagwidth 10      anchor top + left + right   at x2                     ymax+0.2            callback '!this.height(' width 19 is REAL format !!distanceFmt

    -- Define geometry
    button .bbGModShape linkLabel  'Define Insulation Requirement geometry:' anchor t + l + r at xmin             ymax+0.2            callback '!this.modGeometry()' width 28
    paragraph .modShapeDef           anchor top + left + right              at xmin+2                   ymax                width 28 lines 1

    -- Accept Changes
    paragraph .gModAcceptIcon                       anchor top + left           at x0                     ymax+0.2            pixmap width 16 height 16
    button .gModAccept  linkLabel 'Accept Changes'  anchor top + left           at xmax+0.5               ymin                callback '!this.modify()' width 10

    -- Discard Changes
    paragraph .gModDiscardIcon                      anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
    button .gModDiscard linkLabel 'Discard Changes' anchor top + right          at xmax+0.5               ymin                callback '!this.insurqGeometry(!this.element)' width 10

    paragraph .gModBackIcon                         anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .gModMain   linkLabel   'Back to main Insulation Requirement tasks'                 at xmax+1          ymin                callback '!this.mainTasks(true)' width 10

  exit

  -- Warning Task Pane
  --frame .warningPane panel                    anchor top + left + right         at x0                     ymax.currentOwner

    --paragraph .warningHeader                                                    at x0                     ymax                text 'Warning'
    --line .warningLine                         anchor top + left + right         at x0                     ymax                horizontal width 32
    --paragraph .warningIcon                    anchor left + top                 at x0.5                   ymax+0.2            pixmap width 32 heigh 32
    --paragraph .warning                        anchor left + right + top         at xmax+2                 ymin                width 26 lines 6
    --button    .warningDone linkLabel 'Continue' anchor left + top               at x0.5                   ymax                callback '!this.warningDone()' width 28

  --exit

  -- Form Members

  -- Alternative text for owning element type
  member .ownerAltText    is STRING

  -- Owning element
  member .owningElement   is DBREF
  member .ownerType       is STRING

  -- Current Element (insurq)
  member .element         is DBREF
  member .definition      is DBEINSURQ
  member .test is STRING

  -- Insulation requirements for modification
  member .insurqList        is ARRAY
  member .insurqNames       is ARRAY

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK
  member .refreshTask     is BLOCK

  -- Warning action
  member .warningAction   is BLOCK

  -- Undo for form
  member .undo            is UNDOABLE

  -- EDG Description
  member .edgDescription  is STRING

  -- Aid Numbers
  member .aidAxes         is REAL
  member .outerBoundary   is REAL
  member .innerBoundaries is REAL

  -- Insulation requirement grid
  using namespace 'Aveva.Pdms.Presentation'
  member .insurqGrid        is NETGRIDCONTROL

  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
  --!!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accInsurqDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accInsurqDefinition()

  -- Set form to auto scroll
  !this.autoScroll              = true

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!this.dummy()')
  !this.refreshTask             = object BLOCK('!this.dummy()')

  -- Collapse fold up panels
  --!this.defaults.expanded       = false
  !this.criteria.expanded       = FALSE
  !this.information.expanded    = FALSE

  !this.insare.editable = FALSE
  !this.numpins.editable = FALSE

  -- Set events for numeric gadgets
  --!this.nAngle.modifiedEvents   = true
  --!this.hAngle.modifiedEvents   = true

  -- Load information from Configuration
  --!this.refreshConfig()

 -- Initialise task panes
  !this.mainTasks(true)
  !this.createInsurq(false)
  !this.modifyInsurq(false)
  !this.modGeometry.visible = FALSE
  --!this.warningPane.visible     = false

  -- Set "Back" icon
  !backIcon                     = !!pml.getPathName('back.png')
  !this.crtBackIcon.addPixmap(!backIcon)
  !this.modBackIcon.addPixmap(!backIcon)
  !this.gModBackIcon.addPixmap(!backIcon)
  --!this.layerBackIcon.addPixmap(!backIcon)
  !this.blTskBackMainIcon1.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getPathName('create.png')
  !this.crtAcceptIcon.addPixmap(!createIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getPathName('accept.png')
  !this.modAcceptIcon.addPixmap(!acceptIcon)
  !this.gModAcceptIcon.addPixmap(!acceptIcon)
  --!this.layerApplyIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getPathName('discard.png')
  !this.modDiscardIcon.addPixmap(!discardIcon)
  !this.gModDiscardIcon.addPixmap(!discardIcon)

  -- Set "Warning" icon
  --!warningIcon                  = !!pml.getPathName('exclamation-32.png')
  --!this.warningIcon.addPixmap(!warningIcon)

  -- Set "Up arrow" icon

  --!upArrowIcon                  = !!pml.getPathName('uparrow16.png')
  --!this.layerUpButton.addPixmap(!upArrowIcon)

  -- Set "Down arrow" icon

  --!downArrowIcon                  = !!pml.getPathName('downarrow16.png')
  --!this.layerDownButton.addPixmap(!downArrowIcon)


  -- Add .Net control to PML container for insulation requirements
  using namespace 'Aveva.Pdms.Presentation'
  !this.insurqGrid              = object NETGRIDCONTROL()
  !this.insurqs.control         = !this.insurqGrid.handle()
  --!this.wallGrid.addEventHandler('onPopup',           !this, 'popupRoom')
  !this.insurqGrid.addEventHandler('afterSelectChange', !this, 'selectInsurq')

  -- EDG Description
  !this.edgDescription    = 'Accommodation Insulation Requirement Definition'

  -- Assign aid numbers for form
  !this.aidAxes           = !!aidNumbers.add('Insulation Requirement - Axes')
  !this.outerBoundary     = !!aidNumbers.add('Insulation Requirement - OuterBoundary')
  !this.innerBoundaries   = !!aidNumbers.add('Insulation Requirement - InnerBoundaries')

  -- Populate combo with defaults
  !this.fireRating.dtext  = !!accConfig.fireRatings()

  -- Load information from Configuration
  !this.refreshConfig()
  -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dummy
--
-- Description: Dummy method for unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dummy()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Get current element
  !element                = !!accNavigator.currentSelection()

  !this.setTaskActive()

  -- If element is unset, then initialise form with limited actions
  if(!element.unset()) then
    !this.owningElement         = object DBREF()
    !this.currentOwner.val      = 'No active element selected'

  -- Initialise form with relevant actions
  else

    -- Set owner where layout data is to be stored
    !this.owningElement         = !element
    !this.ownerType             = !this.owningElement.type
    --!this.ownerAltText          = !!accConfig.attribute(!this.ownerType)
    !this.currentOwner.val      = 'Active element: ' & !this.owningElement.namn
    !this.insActive.tag          = 'Select ' & !this.owningElement.namn & ' insulation requirements'
    --!ownerType = !!accConfig.typeDescription(!this.ownerType)
    --!this.insurqHeight.tag    = 'Offset above ' & !ownerType & ':'

  endif

  -- Unit Conversions for Area and Volume
  !this.accUnitsFormats()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh form from navigator.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh task
  if(!this.shown()) then
    !this.initialise()
    !this.refreshTask.evaluate()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setTaskActive
--
-- Description: Set task buttons active state
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setTaskActive()

  !active = !this.insurqGrid.getRows().set()
  !this.mtMod.active = !active
  !this.mtModGeom.active = !active
  !this.mtDel.active = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Insulation Requirement Tasks
  !this.createTasks.val         = 'Create'
  !this.modifyTasks.val         = 'Modify'
  --!this.copyTasks.val           = 'Copy'
  !this.deleteTasks.val         = 'Delete'

  -- Insulation Requirement Tags
  --!this.nAngle.tag              = 'Angle from North:'

  -- Grid defaults
  !columnExcelFilter            = !!accConfig.navigator.columnExcelFilter
  !outlookGroupStyle            = !!accConfig.navigator.outlookGroupStyle
  !columnSummaries              = !!accConfig.navigator.columnSummaries
  !labelVisibility              = !!accConfig.navigator.labelVisibility

  -- Control configuration (Rooms)
  !this.insurqGrid.columnExcelFilter(!columnExcelFilter)
  !this.insurqGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.insurqGrid.columnSummaries(!columnSummaries)
  !this.insurqGrid.fixedHeaders(false)
  !this.insurqGrid.fixedRows(false)
  !this.insurqGrid.singleRowSelection(true)
  !this.insurqGrid.setLabelVisibility(!labelVisibility)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.mainTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.mainTasks(false)')
    !this.refreshTask         = object BLOCK('!this.dummy()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Main Insulation Requirement Tasks'

  endif

  -- Show/hide task pane
  !this.mainTaskPane.visible = !active
  !this.updateInsurqList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createInsurq
--
-- Description: Display insulation requirement pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createInsurq(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.createInsurq(false)')
    !this.refreshTask         = object BLOCK('!this.insurqCreate()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Create Insulation Requirement'

    -- Manage create/modify panels
    !this.modPane.visible     = false
    !this.crtPane.visible     = true
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyInsurq
--
-- Description: Display insulation requirement pane in modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyInsurq(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.modifyInsurq(false)')
    !this.refreshTask         = object BLOCK('!this.insurqModify()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Insulation Requirement'

    -- Manage create/modify panels
    !this.modPane.visible     = true
    !this.crtPane.visible     = false
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insurqCreate
--
-- Description: Create Insulation Requirement
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insurqCreate()

  -- Initialise Variables

  -- Set definition
  !this.definition            = object DBEINSURQ()
  !this.definition.initialise(!this.owningElement)

  --Load insulation specs into definition (object)
  !this.definition.loadSpecifications()

  !this.insurqType.dtext = !this.definition.insuTypes
  !this.insurqType.rtext = !this.definition.insuRefs

  -- Edit panel title
  !this.editTitle.val         = 'New insulation requirement for ' & !this.owningElement.namn
  !this.crtShapeDef.val       = 'None currently defined'

  -- Default elevation to 0 offset from owner for now
  !this.definition.elevation(0)

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Copy owning shape
  !this.useOwnersGeometry()

  -- Update gadgets
  !this.updateAttributes()

  -- Setup panes
  !this.createInsurq(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insurqModify
--
-- Description: Modify Insulation Requirement
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insurqModify() is BOOLEAN

  -- Find the insurq of the current element
  do !i indices !this.owningElement.members
    !element  = !this.owningElement.members[!i]
    !insurq = INSURQ 1 of $!element
    handle ANY
      skip
    elsehandle NONE
      break
    endhandle
  enddo

  -- No insulation requirement found
  if(undefined(!insurq)) then
    return false
  endif

  -- Display modify pane
  return !this.insurqModify(!insurq)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      insurqModifySelection
--
-- Description: Modify Selected Insulation Requirement
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insurqModifySelection()

  if !this.insurqGrid.getSelectedRows().unset().not() then
    !element = !this.insurqGrid.getSelectedRows()[1][1].dbref()
  else
    !element = object DBREF()
  endif

  if !element.unset().not() then

    !this.element = !element
    !this.insurqModify(!this.element)

  endif


endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      insurqModify
--
-- Description: Setup to modify insulation requirement
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Insulation Requirement to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .insurqModify(!element is DBREF) is BOOLEAN

  -- Check INSURQ has been passed
  if(!element.fulltype.neq('INSURQ')) then
    !!error.text            = 'Element "' & !element.namn & '" is not a Insulation Requirement.'
    return false
  endif

  -- Load current BBlock
  !this.element             = !element

  -- Set definition
  !this.definition          = object DBEINSURQ(!element)

  --Load insulation specs into definition (object)
  !this.definition.loadSpecifications()

  !this.insurqType.dtext = !this.definition.insuTypes
  !this.insurqType.rtext = !this.definition.insuRefs

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Edit panel title
  !this.editTitle.val       = 'Modify Insulation Requirement: ' & !this.element.namn

  -- Update gadgets
  !this.updateAttributes()

  -- Setup panes
  !this.modifyInsurq(true)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insurqGeometry
--
-- Description: Switch to geometry modification pane for current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insurqGeometry()

  do !i indices !this.owningElement.members
    !element  = !this.owningElement.members[!i]
    !insurq = INSURQ 1 of $!element
    handle ANY
      skip
    elsehandle NONE
      break
    endhandle
  enddo


  -- No insulation requirement found
  if(undefined(!insurq)) then
    return false
  endif

  -- Display modify pane
  !this.insurqGeometry(!insurq)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insurqGeometry
--
-- Description: Switch to geometry modification pane for specified element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insurqGeometry(!element is DBREF)

  -- Get room info
  !this.element             = !element

  -- Set definition
  !this.definition          = object DBEINSURQ(!element)

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Edit panel title
  !this.geomTitle.val       = 'Modify Insulation Requirement: ' & !this.element.namn

  -- Update attributes
  --!this.gClnVoid.val        = !this.definition.clnVoid

  -- Display pane
  !this.insurqGeometry(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insurqGeometry
--
-- Description: Switch to geometry modification pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insurqGeometry(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.modGeometry

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.insurqGeometry(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Insulation Requirement Geometry'

    -- Draw
    !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.modGeometry.visible   = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateAttributes
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAttributes()

  -- Set values of gadgets from BBlock object
  !this.dbName.val        = !this.definition.name
  !this.dbDescription.val = !this.definition.description
  !this.dbFunction.val    = !this.definition.function

  !this.insurqEnvelope.val = !this.definition.heiDefault

  !this.pindensity.val = !this.definition.pindensity

  !this.fireRating.val = !this.definition.fireRating
  handle ANY
    -- if the list is empty or value not in the list
  endhandle

  !this.fireResistance.val    = !this.definition.fireResistance

  if !this.definition.ispec.set() then
    !this.insurqType.val    = !this.definition.ispec.namn
  else
    !this.insurqType.select('DTEXT','None')
  endif

  if !this.definition.matref.set() then
    !this.insurqCode.val    = !this.definition.matref.namn
  else
    !this.insurqCode.val    = 'None'
  endif

  !this.defaultThickness.val = !this.definition.dInThickness

  !this.insare.val        =  !this.definition.insare
  !this.numpins.val       =  !this.definition.numpins

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateData
--
-- Description: Update current data with gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateData()

  -- Initialise Variables
  if(!this.dbName.val.set()) then
    !this.definition.name         = !this.dbName.val
  endif

  !this.definition.description    = !this.dbDescription.val
  !this.definition.function       = !this.dbFunction.val

  !this.definition.heiDefault = !this.insurqEnvelope.val

  !this.definition.fireRating     = !this.fireRating.selection()
  !this.definition.fireResistance = !this.fireResistance.val

  if !this.insurqType.rtext[!this.insurqType.val].dbref().unset().not() then
    !this.definition.ispec          = !this.insurqType.rtext[!this.insurqType.val].dbref()
  else
    !this.definition.ispec = object DBREF()
  endif

  !this.definition.pindensity = !this.pindensity.val

  !this.definition.dInThickness = !this.defaultThickness.val

endmethod
------------------------------------------------------------------------
--
-- Method:      useActiveInsurqs
--
-- Description: Get insurqs from current active element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useActiveInsurqs()

  -- Clear grid
  !this.insurqGrid.clearGrid()

  -- Initialise Variables
  !this.insurqList.clear()
  !this.insurqNames.clear()
  !groups = ARRAY()

  -- Collect all insurqs for current active element

  -- Get DETGRP of active element
  do !member values !this.owningElement.members
    if(!member.type.eq('DETGRP') or !member.type.eq('INSURQ')) then
      !groups.append(!member)
    endif
  enddo

  -- Collect insurqs from groups owned by the active element
  if(!groups.empty().not()) then
    !collection     = object COLLECTION()
    !collection.addType('INSURQ')
    !collection.scope(!groups)
    !this.insurqList  = !collection.results()

    -- Define selection
    !selection      = object SELECTION()
    do !insurq values !this.insurqList
      !selection.add(!insurq)
    enddo

    -- Highlight selection
    !selection.setCurrent()

  endif

  -- Update grid
  !this.updateInsurqList()
  !this.setTaskActive()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateInsurqList
--
-- Description: Update grid of insulation requirements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateInsurqList()

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('NAME')
  !attributes.append('InsuType')
  !attributes.append('DINThickness')
  --!attributes.append('Justification')

  -- Load grid
  if(!this.insurqList.empty().not()) then
    !block                  = object BLOCK('!this.insurqList[!evalIndex].string()')
    !dbNames                = !this.insurqList.evaluate(!block)
    !this.insurqNames         = !dbNames
    using namespace 'Aveva.Pdms.Presentation'
    !nds                = object NETDATASOURCE('Insulation Requirements', !attributes, !dbNames)
    !this.insurqGrid.bindToDataSource(!nds)

    !selected = ARRAY()
    !selected.append(!this.insurqNames[1])
    --!this.insurqGrid.setSelectedRowTags(!this.insurqNames[1])
    !this.insurqGrid.setSelectedRowTags(!selected)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create()

 -- Check shape is defined, otherwise do not allow creation
 if !this.definition.outerLoop.area().eq(0) then
   !!alert.warning('Insulation requirement geometry must be defined before insulation requirement is created')
 else

  -- Reference Element
  !reference  = !!ce

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created insulation requirement')
  !this.undo.add()

  -- Navigate to Level
  !!ce                  = !this.owningElement

  -- Get detailing group
  !detailGroup    = !!accDetailGroup(!this.owningElement, 'INS', 'Insulation Requirement definitions')
  if(!detailGroup.unset()) then
    !!alert.warning('"temp" - ' & !!error.text)
    return
  endif

  -- Navigate to detail group
  !!ce            = !detailGroup

  -- Create new element
  if(!this.definition.create()) then

    !this.element = !this.definition.dbelement

    -- Switch to modify pane
    !this.insurqModify(!this.element)

  -- Failed creating element
  else
    !!alert.warning(!!error.text)
  endif

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Return to original element
  !!ce        = !reference

 endif
endmethod

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.element.namn & ')')
  !this.undo.add()

  -- Modify Insulation Requirement
  if(!this.definition.modify().not())then
    !!alert.warning(!!error.text)
  endif

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  !this.insurqModify(!this.element)
  -- Refresh Content navigator
  !!acccontentnavigator.refresh()
  handle (2,751)
  endhandle

  --!this.definition          = object DBEINSURQ(!this.element)
  --!this.definition.draw()
  --!this.updateAttributes()

endmethod


------------------------------------------------------------------------
--
-- Method:      geometry
--
-- Description: Define geometry for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometry()

  -- Define data to pass to shape definition form
  !plane  = !this.definition.plane
  !shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)

  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form for return to insurq creation
  -- Information for form is:
  --   Calling form
  --   Form title
  --   Apply tag (Test for "apply" button)
  --   Action on completion, method name only, method must be in format
  --      .methodName(<SHAPEDEFINITION>)
  --   Default shape, should be at least pos and ori of the plane the
  --   shape is to be mapped onto.
  !!shapeDefinitionEditor.setup(!this, 'Define Insulation Requirement Boundary', 'Define Boundary', 'geometryUpdate', !shape)

endmethod
------------------------------------------------------------------------
--
-- Method:      modGeometry
--
-- Description: Define geometry for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modGeometry()

  -- Define data to pass to shape definition form
  !plane  = !this.definition.plane

  !shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)

  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

endmethod

------------------------------------------------------------------------
--
-- Method:      insurqModGeometry
--
-- Description: Modify geometry for INSURQ (needs to pass current geometry to shape editor)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insurqModGeometry()

  if !this.insurqGrid.getSelectedRows().unset().not() then
    !element = !this.insurqGrid.getSelectedRows()[1][1].dbref()
  else
    !element = object DBREF()
  endif

  if !element.unset().not() then

    !this.element = !element

    -- use the accProfileEdit function
    if(defined(!!dbeProfileEdit) and !!dbeProfileEdit.shown()) then
      !!dbeProfileEdit.close()
    endif

    -- Check if there is a boundary defined
    if(!this.definition.outerLoop.set()) then
      !boundary           = !!dtbMemberOfType(!this.element,'LOOP',1)
      !!accProfileEdit(!boundary)
    else
      !this.insurqGeometry()
    endif

  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      geometryUpdate
--
-- Description: Update with returned data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometryUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  !this.crtShapeDef.val       = !shapeDefinition.description

  !this.definition.position(!shapeDefinition.profile.position)
  !this.definition.outerLoop  = !shapeDefinition.profile
  !this.definition.draw()

endmethod
------------------------------------------------------------------------
--
-- Method:      modGeometryUpdate
--
-- Description: Update with returned data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modGeometryUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  !this.modShapeDef.val       = !shapeDefinition.description

  !this.definition.position(!shapeDefinition.profile.position)
  !this.definition.outerLoop  = !shapeDefinition.profile
  !this.definition.draw()

endmethod
------------------------------------------------------------------------
--
-- Method:      useOwnersGeometry
--
-- Description: Use owning boundary definition (if there is one)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useOwnersGeometry()

  -- Get gadget setting
  !useOwner             = !this.crtShapeO.val

  -- Make shape definition inactive
  !this.crtShape.active = !useOwner.not()

  -- Get owning geometry
  if(!useOwner) then

    -- Check if there is a boundary defined
    !boundary = BNDLIN 1 OF $!<this.owningElement>
    -- No boundary to use
    handle ANY
    -- Use owning boundary
    elsehandle NONE
      !plane    = !this.definition.plane
      !profile  = object PROFILE(LOOP 1 of $!<boundary> )
      !newShape = object SHAPEMODIFIER()
      !profile  = !newShape.intersect(!profile, !plane)

      -- Modify definition profile
      !shape      = object SHAPEDEFINITION(!plane.position, !plane.orientation)
      !shape.description  = 'Derived from owner'
      !shape.profile      = !profile
      !this.geometryUpdate(!shape)

    endhandle

 endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message with default "Continue"
