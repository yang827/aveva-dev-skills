--
--
-- Description:
--   Form for selecting insulation requirement materials
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accInsurqMaterials()             -
--  selectTableEntry()               -                   Set up table from current information
--  setMaterial()                    -                   Get information
--  setup(STRING,STRING)             -                   Setup information from passed data
--

-- Import DLL

setup form !!accInsurqMaterials resize

  -- Form details
  !this.formTitle    = 'Materials'
  !this.icontitle    = ''
  !this.callback     = ''
  !this.formrevision = ''

  -- List of room designs
  frame .materialListFrame panel            anchor all                    at x0.5                     ymax
    container .materialList PMLNetCONTROL 'NET' dock fill width 60 lines 10
  exit

  -- Set
  button .dismiss 'Dismiss'   anchor right + bottom         at xmax-size              ymax+0.2          callback '!this.hide()'         width 6
  button .apply 'Apply'       anchor left + bottom          at x0.5                   ymin              callback '!this.setMaterial()'  width 6

  -- Form variables
  using namespace 'Aveva.Pdms.Presentation'
  member .materialGrid    is NETGRIDCONTROL

  -- Default information
  member .material        is DBREF

  -- Action on form
  member .action          is BLOCK

exit

------------------------------------------------------------------------
--
-- Method:      accInsurqMaterials
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accInsurqMaterials()

  -- collect materials from material world in properties db
  --!collection = object COLLECTION()
  --!collection.scope( /* )
  --!collection.addType('SOLI')
  --!materials  = !collection.results()
  -- PML 2 collection is not working for this collection
  var !mats collect all SOLI
  !materials  = !mats.evaluate(object BLOCK('!mats[!evalIndex].dbref()'))
  !materials  = !materials.unique().compress()

  !materialGridElements  = object ARRAY()

  do !i indices !materials

    !materialGridElements[!i][1]  = !materials[!i].owner.namn
    !materialGridElements[!i][2]  = !materials[!i].namn
    !materialGridElements[!i][3]  = !materials[!i].desc

  enddo

  !headings = ARRAY()
  !headings.append('Material World')
  !headings.append('Name')
  !headings.append('Description')

  !gridName = 'Materials'
  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  !this.materialGrid            = object NETGRIDCONTROL()
  !this.materialList.control    = !this.materialGrid.handle()
  !netDataSource = object NETDATASOURCE(!gridName, !headings, !materialGridElements)
  !this.materialGrid.bindToDataSource(!netDataSource)

  -- Configure grid layout
  !this.materialGrid.outlookGroupStyle(false)
  !this.materialGrid.singleRowSelection(true)
  !this.materialGrid.columnExcelFilter(true)
  !this.materialGrid.columnSummaries(false)
  !this.materialGrid.setLabelVisibility(false)
  !this.materialGrid.selectRow(1)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup information from passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!material is STRING, !action is STRING)

  !matref = object DBREF(!material)
  handle ANY
    !this.material =  object DBREF()
  elsehandle NONE
    !this.material  = !matref
  endhandle

  -- Set values
  !this.action    = object BLOCK(!action)

  -- Select entry
  !this.selectTableEntry()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectTableEntry
--
-- Description: Set up table from current information
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectTableEntry()

  -- Define data to find in grid
  if(!this.material.unset()) then
    return
  endif

  !data[1]  = !this.material.owner.flnn
  !data[2]  = !this.material.flnn
  !data[3]  = !this.material.desc

  -- Find row in grid
  !row      = !this.materialGrid.getRows().findFirst(!data)
  if(!row.set()) then
    !this.materialGrid.selectRow(!row)
  else
    !this.materialGrid.clearRowSelection()
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setMaterial
--
-- Description: Get information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMaterial()

  -- Get selected row
  !material = '/' + !this.materialGrid.getSelectedRows()[1][2].trim()

  -- Set current setting
  --!owner        = !data[1].trim()
  --!material     = '/' + !data[2].trim()
  --!description  = !data[3].trim()

  if(!material.set()) then
    !this.material    = !material.dbref()
  else
    !this.material    = object DBREF()
  endif

  -- Carry out set action
  if(!this.action.set()) then
    !this.action.evaluate()
  endif

endmethod
-- End of method
