--
-- File:            acclaboffset.pmlfrm
--   Type:          Form Definition
--   Group:         Accommodation Application
--     Keyword:
--   Module:        Accommodation
--   Replaces:
--
-- Author:          G.Somasundaram
-- Created:         24/05/2007 16:16
--
--
-- Description: Set the laboffset of Accommodation elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accLabOffset()                   -                   Constructor
--  close()                          -
--  draw()                           -                   Draw/Tag element using offset
--  initialise()                     -
--  offset(EDGPOSITIONDATA)          -                   Map picked position to room offset
--  pickOffset()                     -                   Define EDG event to pick position
--  position()                       -
--  setup(DBREF)                     BOOLEAN
--  tidy()                           -
--  update()                         -
--  updateElement()                  -                   Update element with modified values
--  updateGadgets()                  -
--


 setup form !!accLabOffset

  !this.formTitle     = 'LABOFFSET'
  !this.iconTitle     = 'laboffset'
  !this.callback      = '!this.initialise()'
  !this.quitcall      = '!this.tidy()'
  !this.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
  button .selectElement linkLabel 'Element:'  anchor top + left       at x0.5                 ymin                    callback '!this.initialise()' width 6
  paragraph .namepara                     anchor top + left + right   at xmax                 ymin                    width 20 lines 1

  --  laboffset of floor from building origin
  button .offset linkLabel 'Pick XY Offset...' anchor t + l + r       at x0.5                 ymax+0.2                callback '!this.pickOffset()'     width 20
  text .xOffset   'X:'                    anchor top + left + right   at x2                   ymax                    callback '!this.update()' width 21 is REAL format !!distanceFmt
  text .yOffset   'Y:'                    anchor top + left + right   at xmin                 ymax+0.2                callback '!this.update()' width 21 is REAL format !!distanceFmt
  text .zOffset   'Z:'                    anchor top + left + right   at xmin                 ymax+0.2                callback '!this.update()' width 21 is REAL format !!distanceFmt

  -- Apply button
  button .acceptBtn   'Apply'             anchor top + left           at x0.5                 ymax+0.5                callback '!this.updateElement()'  width 6
  -- Dismiss button
  button .discardBtn  'Dismiss'           anchor top + right          at xmax.zOffset-size    ymin                    callback '!this.close()'          width 6

  -- Form Members
  -- Current Element
  member .element             is DBREF

  -- Attribute data
  member .attributeData       is DBEATTRIBSEARCH

  -- Label position
  member .position            is POSITION

  -- Plane of element offset relates to
  member .plane               is PLANE

  -- LabOffset Values
  member .labOffset           is ARRAY

  -- aidnumbers to display graphics
  member .aidNumber           is REAL

 exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accLabOffset
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .accLabOffset()

  -- Set up attribute data
  !this.attributeData = object DBEATTRIBSEARCH(object DBREF(), 'LabOffset', object ARRAY())

  -- Get aid number
  !this.aidNumber     = !!aidNumbers.add('LabOffset display')

endmethod

------------------------------------------------------------------------
--
-- Method:    initialise
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.setup(!!ce)

endmethod

------------------------------------------------------------------------
--
-- Method:  setup
--
-- Description: Setup form with passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is successful
--
------------------------------------------------------------------------

define method .setup(!passedElement is DBREF) is BOOLEAN

  -- Tidy aid graphics
  !this.tidy()

  -- Set element to modify
  !element            = !this.attributeData.element(!passedElement)
  if(!element.unset()) then
    !!alert.error('Element doesn''t have an LabOffset attribute.')
    return false
  endif

  if (!!dbrefUpdatable(!element).not() )  then
      !!alert.error(!!error.text)
      return FALSE
  endif

  -- Element being modified
  !this.element       = !element
  !this.namepara.val  = !this.element.flnn

  -- Get the LabOffset as a ARRAY
  !this.labOffset     = !this.element.labOffset

  -- Define plane of element
  !this.plane         = object PLANE(!this.element.position, !this.element.orientation)

  -- Label position
  !this.position      = !this.element.labPosition.wrt(World)

  -- Update input gadgets with values
  !this.updateGadgets()

  -- Return
  return true

endmethod

------------------------------------------------------------------------
--
-- Method:    update
--
-- Description: Update position with info from gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- Initialise Variables
  !this.labOffset[1]  = !this.xOffset.val
  !this.labOffset[2]  = !this.yOffset.val
  !this.labOffset[3]  = !this.zOffset.val

  -- Derive position
  !this.position()

  -- Draw
  !this.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:    updateGadgets
--
-- Description: Update gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  -- Initialise Variables
  !this.xOffset.val = !this.labOffset[1]
  !this.yOffset.val = !this.labOffset[2]
  !this.zOffset.val = !this.labOffset[3]

  -- Draw
  !this.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:      draw()
--
-- Description: Draw/Tag element using offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draw()

  -- Remove aid graphics
  !this.tidy()

  -- Get element data
  if(!this.element.isNamed) then
    !name         = !this.element.namn
  else
    !name         = !!accConfig.typeDescription(!this.element.type)
  endif

  -- Tag at label offset
   AID TEXT NUMBER $!<this.aidNumber> '$!name' AT $!<this.position>

endmethod

------------------------------------------------------------------------
--
-- Method: close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()
  !this.tidy()
  !this.hide()
endmethod

------------------------------------------------------------------------
--
-- Method: tidy
--
-- Description: Tidy up graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()
  AID CLEAR ALL $!<this.aidNumber>
  handle ANY
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      updateElement
--
-- Description: Update element with modified values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateElement()

  -- Update labOffset
  !this.element.labOffset   = !this.labOffset

endmethod

------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Define EDG event to pick position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickOffset()

  -- Initialise Variables
  -- use the alttext here
  !prompt               = 'Pick LabOffset position'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Modify laboffset'
  !packet.remove        = true
  !packet.action        = '!!' & !this.name() & '.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to room offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

  -- Map position onto plane
  !position           = !data.position
  !xyOffset           = !this.plane.xyOffset(!position)
  !this.labOffset[1]  = !xyOffset.x
  !this.labOffset[2]  = !xyOffset.y

  -- Derive position
  !this.position()

  -- Update
  !this.updateGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:    position
--
-- Description: Update position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position()

  -- Derive position from offset
  !xyPosition         = object XYPOSITION(!this.labOffset[1], !this.labOffset[2])
  !position           = !this.plane.threeDPosition(!xyPosition)

  -- Offset position from plane
  !position           = !position.offset(!this.plane.direction(), !this.labOffset[3])
  !this.position      = !position

endmethod
