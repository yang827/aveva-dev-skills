--
-- Description:
--    Main form for layout
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accLayout()                      -                   Constructor
--  afterSelectChange(ARRAY)         -
--  backToMainRoomDesignTasks()      -                   Switching to Main Room Design Tasks
--  backToWallDefinitionTasks()      -
--  beforeUpdateWallCell(ARRAY)      -
--  cancel()                         -                   form cancel/close callback
--  createRoomGeometry()             -                   Create room definitions
--  createWallPaths()                -                   Define walls paths
--  createWallPoint()                -
--  deleteSelectedWall()             -                   delete the selected CTWALL
--  derivePathFromPicks(EDGPICKDATA,EDGPACKET) -                   Derive closed path from picks
--  derivePathFromPoints(EDGPOSITIONDATA,EDGPACKET) -                   Get position data and map onto working plane
--  drawPath()                       -                   Draw path
--  dummy()                          -                   Dummy method for unset
--  exampleWarning1()                -
--  initWallPositionFrame()          -
--  initialise()                     -                   Initialise form.
--  insertPoints(EDGPOSITIONDATA)    -                   inserting new point with the picked position
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  modifyPoints(EDGPOSITIONDATA)    -                   Modify the position of the Vertex
--  modifySelectedWallPoint(EDGPOSITIONDATA) -
--  modifyWalls()                    -                   Modify walls from selection list
--  offsetWallPtPos(GADGET,STRING)   -
--  openingDefinition()              -                   Switch to opening definition
--  pickPosition()                   -
--  rePickPosition()                 -
--  refresh()                        -                   Refresh form from navigator.
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  removeWallPoint()                -                   Remove selected point
--  returnPosition(STRING)           POSITION
--  roomDefinitionTasks(BOOLEAN)     -                   Switch to room definition task pane
--  roomEDGPick()                    -                   Define room from EDG Picking
--  roomEDGPoints()                  -                   Define room from EDG positioning
--  roomFromPoints()                 -                   Define room using picked points
--  selectRoom(ARRAY)                -                   Select room from grid
--  selectWall(ARRAY)                -                   Select Wall from grid
--  setNumericGadgetState(BOOLEAN,ARRAY) -
--  setWallPos()                     -
--  strwellDefinition()              -                   Switch to floor covering definition
--  tidy()                           -                   Tidy graphics
--  tidyWalls()                      -                   Tidy walls
--  updateRoomList()                 -                   Update room list with room
--  updateWallGrid()                 -
--  updateWallList()                 -                   Get walls from graphic selection
--  updateWallPosControl(EDGPOSITIONDATA) -
--  useActiveWalls()                 -                   Get walls from current active element
--  useSelectedWalls()               -                   Get walls from graphic selection
--  wallDefinitionTasks(BOOLEAN)     -                   Switch to wall definition task pane
--  wallDetailDefinition()           -                   Switch to wall detail definition
--  wallDetailGroup()                DBREF               Get detail group for walls, create if one doesn't exist
--  wallEDGPick()                    -                   Define walls from EDG Picking
--  wallEDGPoints()                  -                   Define walls from EDG positioning
--  wallFromPoints()                 -                   Define wall using picked points
--  wallInsertPoint()                -                   Inserting new vertex
--  wallLayoutComplete()             -
--  wallModificationTasks(BOOLEAN)   -                   Switch to wall modification task pane
--  wallPositionTasks(BOOLEAN)       -
--  wallRePick()                     -                   Redefine vertex from EDG Picking
--  wallRemovePoint()                -                   Remove point
--  wallsFromSelection()             -                   Define walls from graphical selection
--  warning(ARRAY,STRING,STRING)     -                   Set warning task and message
--  warningDone()                    -                   Exit warning
--

import 'GridControl'
handle any
endhandle

import 'PositionControl'
handle any
endhandle

setup form !!accLayout dialog docking right

  !this.formTitle     = 'Layout'
  !this.iconTitle     = 'Layout'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.cancel()'
  !this.killingCall   = '!this.cancel()'
  !this.formRevision  = ' $Revision$ '

  -- Current hierarchy
  paragraph .currentOwner                                            anchor t + l + r   at x0.5    ymax                width 30 lines 1

  -- Main Task Pane
  frame .mainTaskPane panel                                          anchor t + l + r   at x0      ymax.currentOwner

    -- Create options
    paragraph .createTasks                                                              at x0.5   ymax      width 30 lines 1
    line      .mainTaskL1                                            anchor t + l + r   at xmin   ymax      horizontal width 32
    button    .mtCrtWalls    linkLabel 'Walls'                       anchor t + l + r   at x2     ymax      callback '!this.wallDefinitionTasks(true)'
    button    .mtCrtOpenings linkLabel 'Doors and Windows'           anchor t + l + r   at xmin   ymax      callback '!this.openingDefinition()'
    button    .mtCrtMRooms   linkLabel 'Geometry for defined Rooms'  anchor t + l + r   at xmin   ymax      callback '!this.roomDefinitionTasks(true)'
    button    .mtCrtStrWells linkLabel 'Stairwell'                   anchor t + l + r   at xmin   ymax      callback '!this.strwellDefinition()'

    -- Modify options
    paragraph .modifyTasks                                           anchor t + l + r   at x0.5   ymax+0.5  width 30 lines 1
    line      .mainTaskL2                                            anchor t + l + r   at xmin   ymax      horizontal width 32
    button    .mtModWalls    linkLabel 'Walls'                       anchor t + l + r   at x2     ymax      callback '!this.wallModificationTasks(true)'

    -- Delete options
    paragraph .deleteTasks                                                              at x.5    ymax      width 30 lines 1
    line      .mainTaskL3                                            anchor t + l + r   at xmin   ymax      horizontal width 32
    button    .mtDelWalls    linklabel 'Delete Selected Wall'        anchor t + l + r   at x2     ymax      callback '!this.deleteSelectedWall()'

    paragraph .blTaskBackMainIcon1                                   anchor t + l       at x0     ymax+0.5  pixmap width 15 height 15
    button .blTaskMain1     linkLabel 'Return to main tasks'                            at xmax+1 ymin      callback '!this.backToMainRoomDesignTasks()' width 20

  exit

  -- Wall definition methods
  frame   .wallDefPane panel                                                          anchor t + l + r   at x0      ymax.currentOwner

    -- Basic wall types
    paragraph .wallDefDataTag                                                         anchor t + l + r   at x0.5    ymax          text 'Basic Wall Attributes'
    line      .wallDefL1                                                              anchor t + l + r   at xmin    ymax          horizontal                                    width 32
    text      .wDThickness              tagwidth 11   'Thickness:'                    anchor t + l + r   at x2      ymax+0.2                                                    width 17  is REAL format !!distanceFmt
    text      .wDHeight                 tagwidth 11   'Height:'                       anchor t + l + r   at x2      ymax+0.2                                                    width 17  is REAL format !!distanceFmt

    option    .wDJustif                 tagwidth 11   'Justification:'                anchor t + l + r   at xmin    ymax+0.2                                                    width 8

    -- Methods for defining walls
    paragraph .wallDefTag                                                             anchor t + l + r   at x0.5    ymax+0.5      text 'Wall definition methods'
    line      .wallDefL2                                                              anchor t + l + r   at xmin    ymax          horizontal                                    width 32
    button    .wallDerived              linkLabel     'Derive from selection'         anchor t + l + r   at x2      ymax          callback '!this.wallsFromSelection()'         width 16
    button    .wallEDGPos               linkLabel     'Define points'                 anchor t + l + r   at xmin    ymax          callback '!this.wallEDGPoints()'              width 16
    button    .wallEDGPick              linkLabel     'Derive from graphics'          anchor t + l + r   at xmin    ymax          callback '!this.wallEDGPick()'                width 16
    button    .wallExplicitPos          linkLabel     'Define points explicitly'      anchor t + l + r   at xmin    ymax          callback '!this.wallPositionTasks(true)'      width 16

    -- Methods to redefine/insert/remove the vertices
    paragraph .vertexDefTag                                                           anchor t + l + r   at x0.5    ymax+0.5      text 'Modify Points'
    line      .wallDefL3                                                              anchor t + l + r   at xmin    ymax          horizontal                                    width 32

    button    .wallRePick               linkLabel     'Re-Pick Point:'                anchor t + l + r   at x2      ymax          callback '!this.wallRePick()'                 width 16
    numeric   .nuVertices                                                             anchor t + l + r   at xmax+2  ymin                                                        width 5
    button    .wallInsert               linkLabel     'Insert point after'            anchor t + l + r   at x2      ymax          callback '!this.wallInsertPoint()'            width 16
    numeric   .nuInsertVertices                                                       anchor t + l + r   at xmax+2  ymin                                                        width 5
    button    .wallRemove               linkLabel     'Remove point:'                 anchor t + l + r   at x2      ymax          callback '!this.wallRemovePoint()'            width 16
    numeric   .nuRemVertices                                                          anchor t + l + r   at xmax+2  ymin                                                        width 5

    paragraph .wDCrtIcon                                                              anchor t + l       at x0.5    ymax+0.5      pixmap                                        width 15 height 15
    button    .wDcrt                    linklabel     'Create wall'                   anchor t + l       at xmax+1  ymin          callback '!this.createWallPaths()'            width 8

    -- Return to main pane
    paragraph .wallDefBackIcon                                                        anchor t + l       at x0      ymax+0.5      pixmap                                        width 15 height 15
    button    .wallDefBack              linkLabel     'Back to layout tasks'          anchor t + l + r   at xmax+1  ymin          callback '!this.mainTasks(true)'              width 20

    --Return to detail pane
    paragraph .wallDetDefBackIcon                                                        anchor t + l       at x0      ymax+0.5      pixmap                                        width 15 height 15
    button    .wallDetDefBack              linkLabel     'Back to detail tasks'     anchor t + l + r   at xmax+1  ymin          callback '!this.wallDetailDefinition()'              width 20

    paragraph .blTaskBackMainIcon2                                                     anchor t + l       at x0      ymax+0.5      pixmap                                        width 15 height 15
    button    .blTaskMain2               linkLabel     'Return to main tasks'                             at xmax+1  ymin          callback '!this.backToMainRoomDesignTasks()'  width 20

  exit

  -- Wall definition by defining points explicitly
  frame .wallExplicitPositionPane       panel                                         anchor t + l + r   at x0      y1

    -- grid container for listing the created points
    frame       .frWallPoints                         'Wall definition points'        anchor t + l       at x0      ymin
      container .coWallDefPoints  NOBOX PMLNetCONTROL 'NET'                           anchor t + l       at x1      ymax                                                     width 32 height 6
      button    .lkWallRePosPoint       linkLabel     'Re-position point'             anchor t + l       at x2      ymax+0.1   callback '!this.rePickPosition()'             width 15
      button    .lkWallRemPoint         linkLabel     'Remove point'                  anchor t + l       at x2      ymax+0.1   callback '!this.removeWallPoint()'            width 15
    exit

    -- Explicit Position
    paragraph   .paExplicitPos                                                        anchor t + l       at x0      ymax+0.5   text 'Explicit Position'
    line        .lnExplicitPos                                                        anchor t + l       at xmin    ymax       horizontal                                    width 33
    button      .lkWallPosition         linklabel     'Pick position'                                    at x1      ymax+0.1   callback '!this.pickPosition()'               width 10
    container   .coWallPosCntrl         PMLNetCONTROL 'NET'                           anchor t + l       at x1      ymax+0.1                                                 width 32 height 5

    -- Offset from previous Point
    paragraph   .paOffset                                                             anchor t + l       at x0      ymax+0.5   text 'Offset from selected point'             width 30
    line        .lnOffset                                                             anchor t + l       at xmin    ymax       horizontal                                    width 33
    text        .txWallPtDir            tagwidth 11   'Direction:'                    anchor t + l       at x2      ymax+0.1   callback '!this.offsetWallPtPos('             width 15 is DIRECTION format !!distanceFmt
    text        .txWallPtDist           tagwidth 11   'Distance:'                     anchor t + l       at x2      ymax+0.1   callback '!this.offsetWallPtPos('             width 15 is REAL      format !!distanceFmt

    -- Create Point
    button      .lkWallCrtPoint         linkLabel     'Create point'                  anchor t + l       at x0.5    ymax+1     callback '!this.createWallPoint()'            width 15

    button      .lkLayoutComplete       linkLabel     'Layout complete'               anchor t + l       at x0.5    ymax+0.5   callback '!this.wallLayoutComplete()'       width 15

    -- Return to main pane
    paragraph   .paWallDefBackIcon                                                    anchor t + l       at x0      ymax+0.5   pixmap                                        width 15 height 15
    button      .lkWallDefBack          linkLabel     'Back to wall definition tasks' anchor t + l       at xmax+1  ymin       callback '!this.backToWallDefinitionTasks()'    width 20

  exit

  -- Wall modification methods
  frame         .wallModPane  panel                  anchor t + l + r         at x0                     ymax.currentOwner

    -- Walls
    paragraph   .wallModListTag               anchor t + l + r         at x0.5                   ymax                text 'List of Walls'
    line        .wallModL1                         anchor t + l + r         at xmin                   ymax                horizontal width 32

    -- List of walls to modify
    container   .walls                  PMLNetCONTROL 'NET'      anchor t + l + r         at x0                     ymax                width 32 height 8

    -- Populate list of walls
    button      .wmSelection            linkLabel 'Graphical selection'   anchor t + l       at x2                     ymax+0.5            callback '!this.useSelectedWalls()'  width 16
    button      .wmActive               linkLabel 'Current Element'       anchor t + l       at xmin                   ymax                callback '!this.useActiveWalls()'  width 18

    -- Basic wall types
    paragraph   .wallModDataTag                     anchor t + l + r         at x0.5                   ymax+0.5            text 'Basic Wall Attributes'
    line        .wallModL2                               anchor t + l + r         at xmin                   ymax                horizontal width 32

    text        .wMThickness            tagwidth 11 'Thickness:'      anchor t + l + r    at x2                     ymax+0.2            width 17  is REAL format !!distanceFmt
    text        .wMHeight               tagwidth 11 'Height:'         anchor t + l + r    at x2                     ymax+0.2            width 17  is REAL format !!distanceFmt

    option      .wMJustif               tagwidth 11 'Justification:'  anchor t + l + r     at xmin                   ymax+0.2            width 8

    toggle      .wMCloseFlag            tagwidth 24 'Close Wall'      anchor t + l + r     at xmin                   ymax+0.2

    paragraph   .wmModIcon                              anchor top + left             at x0.5                   ymax+0.5            pixmap width 15 height 15
    button      .wmMod                  linklabel   'Apply changes to walls'  anchor top + left   at xmax+1                 ymin                callback '!this.modifyWalls()' width 20

    -- Return to main pane
    paragraph   .wallModBackIcon                       anchor top + left              at x0                     ymax+0.5            pixmap width 15 height 15
    button      .wallModBack            linkLabel   'Back to layout tasks' anchor t + l + r at xmax+1                 ymin                callback '!this.mainTasks(true)' width 20

    -- Return to detail pane
    paragraph   .wallDetModBackIcon                       anchor top + left              at x0                     ymax+0.5            pixmap width 15 height 15
    button      .wallDetModBack            linkLabel   'Back to detail tasks' anchor t + l + r at xmax+1                 ymin                callback '!this.wallDetailDefinition()' width 20

    paragraph   .blTaskBackMainIcon3                  anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button      .blTaskMain3             linkLabel     'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit

  -- Room definition methods
  frame .roomTaskPane panel                                                    anchor t + l + r   at x0      ymax.currentOwner

    -- Basic wall types
    paragraph .roomListTag                                                     anchor t + l + r   at x0.5    ymax                width 30 lines 1
    line      .roomTaskL1                                                      anchor t + l + r   at xmin    ymax                horizontal width 32

    -- List of rooms within floor level
    container .rooms                    PMLNetCONTROL 'NET'                    anchor t + l + r   at x0      ymax                width 32 height 8

    -- Room attributes
    paragraph .roomDataTag                                                                        at x0.5    ymax+0.5            width 30 lines 1
    line      .roomTaskL2                                                      anchor t + l + r   at xmin    ymax                horizontal width 32
    text      .rmFlrHeight              tagwidth 12   'Floor Height:'          anchor t + l + r   at x2      ymax+0.2            callback '!this.roomDefinition.elevation(!this.rmFlrHeight.val)' width 14  is REAL format !!distanceFmt
    text      .rmClnHeight              tagwidth 12   'Ceiling Height:'        anchor t + l + r   at xmin    ymax+0.2            callback '!this.roomDefinition.clnHeight = !this.fmClnHeight.val' width 14  is REAL format !!distanceFmt
    text      .rmDHeight                tagwidth 12   'Default height:'        anchor t + l + r   at xmin    ymax+0.2            callback '!this.roomDefinition.height(!this.rmDHeight.val)'     width 14 is REAL format !!distanceFmt

    paragraph .roomACrtTag                                                     anchor t + l + r   at x0.5    ymax+0.5            text 'Auto Create'
    line      .roomTaskL3                                                      anchor t + l + r   at xmin    ymax                horizontal width 32
    toggle    .crtCeiling               tagwidth 24   'Create ceiling'         anchor t + l + r   at x4      ymax                callback '!this.crtCeilingGrid.active = !this.crtCeiling.val'
    toggle    .crtCeilingGrid           tagwidth 24   'Create ceiling grid'    anchor t + l + r   at x6      ymax
    toggle    .crtFloor                 tagwidth 24   'Create floor covering'  anchor t + l + r   at x4      ymax+0.2

    -- Methods for defining rooms
    paragraph .roomDefTag                                                      anchor t + l + r   at x0.5    ymax+0.5            width 30 lines 1
    line      .roomTaskL4                                                      anchor t + l + r   at xmin    ymax                horizontal width 32
    button    .roomEDGPos               linkLabel     'Define points'          anchor t + l + r   at x2      ymax                callback '!this.roomEDGPoints()'  width 16
    button    .roomEDGPick              linkLabel     'Derive from graphics'   anchor t + l + r   at xmin    ymax                callback '!this.roomEDGPick()'    width 16

    paragraph .rDcrtIcon                                                       anchor top + left  at x0.5    ymax+1.5            pixmap width 15 height 15
    button    .rDcrt                    linklabel     'Create Room'            anchor top + left  at xmax+1  ymin                callback '!this.createRoomGeometry()' width 20

    -- Return to main pane
    paragraph .roomBackIcon                                                    anchor top + left  at x0      ymax+0.5            pixmap width 15 height 15
    button    .roomBack                 linkLabel     'Back to layout tasks'   anchor t + l + r   at xmax+1  ymin                callback '!this.mainTasks(true)' width 20

    paragraph .blTaskBackMainIcon4                                              anchor top + left  at x0      ymax+0.5            pixmap width 15 height 15
    button    .blTaskMain4               linkLabel     'Return to main tasks'                      at xmax+1  ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit

  -- Warning Task Pane
  frame   .warningPane panel                                                   anchor t + l + r   at x0      y0

    paragraph .warningHeader                                                   anchor t + l + r   at x0      ymax                text 'Warning'
    line      .warningLine                                                     anchor t + l + r   at x0      ymax                horizontal width 32
    paragraph .warningIcon                                                     anchor left + top  at x0.5    ymax+0.2            pixmap width 32 heigh 32
    paragraph .warning                                                         anchor t + l + r   at xmax+2  ymin                width 26 lines 6
    button    .warningDone              linkLabel     'Continue'               anchor left + top  at x0.5    ymax                callback '!this.warningDone()' width 28

  exit

  -- Form Members

  -- Current active element
  member .owner           is DBREF

  -- Alternative text for element type
  member .bblockRText     is STRING
  member .blevelRText     is STRING
  member .roomRText       is STRING

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK
  member .refreshTask     is BLOCK

  -- Room information
  member .currentRoom     is DBREF

  -- Walls for modification
  member .wallList        is ARRAY
  member .wallNames       is ARRAY

  -- Picked points
  member .pickedPoints    is ARRAY
  member .closedWalls     is ARRAY
  member .pickedData      is ARRAY

  -- Closed Path
  member .closedPath      is BOOLEAN

  -- List Paths (array of profile objects)
  member .paths           is ARRAY

  -- Reference plane
  member .plane           is PLANE
  member .roomPlane       is PLANE

  -- Room information
  member .roomDefinition  is DBEROOM

  -- Warning action
  member .warningAction   is BLOCK

  -- Undo for form
  member .undo            is UNDOABLE

  -- EDG Description
  member .edgDescription  is STRING

  -- Aid Numbers
  member .aidNumber       is REAL
  member .aidBoundary     is REAL

  -- aid number for picked wall point
  member  .wallDefPointAidNum  is REAL

  using namespace 'Aveva.Pdms.Presentation'
  -- Room grid
  member  .roomGrid               is NETGRIDCONTROL

  -- Wall Grid
  member  .wallGrid               is NETGRIDCONTROL

  -- Wall definition Points Grid
  member  .neWallDefPointsGrid    is NETGRIDCONTROL

  -- Wall Position Control
  member  .neWallPosCntrl         is POSITIONCONTROL

  -- Wall Explicit points
  member  .wallExplicitPoints     is ARRAY

  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
  --!!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accLayout
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accLayout()

  -- Setup gadgets
  -- Wall definition - needed before grid definition
  !dtext                        = ARRAY()
  !rtext                        = ARRAY()
  !dtext.append('Left')
  !rtext.append('LEFT')
  !dtext.append('Centre')
  !rtext.append('CENT')
  !dtext.append('Right')
  !rtext.append('RIGH')
  !this.wDJustif.dtext          = !dtext
  !this.wDJustif.rtext          = !rtext
  !this.wDJustif.val            = 2
  !this.wMJustif.dtext          = !dtext
  !this.wMJustif.rtext          = !rtext
  !this.wMJustif.val            = 2

  -- Set form to auto scroll
  !this.autoScroll            = true

  -- Setup dummy default task
  !this.currentTask           = object BLOCK('!this.dummy()')

  -- Closed path default
  !this.closedPath            = false

  -- Add .Net control to PML container for Room
  using namespace 'Aveva.Pdms.Presentation'

  !this.roomGrid              = object NETGRIDCONTROL()
  !this.rooms.control         = !this.roomGrid.handle()
  --!this.roomGrid.addEventHandler('onPopup',           !this, 'popupRoom')
  !this.roomGrid.addEventHandler('afterSelectChange', !this, 'selectRoom')

  -- Add .Net control to PML container for Walls
  !this.wallGrid              = object NETGRIDCONTROL()
  !this.walls.control         = !this.wallGrid.handle()
  --!this.wallGrid.addEventHandler('onPopup',           !this, 'popupRoom')
  !this.wallGrid.addEventHandler('afterSelectChange', !this, 'selectWall')

  -- Add .Net control to PML container for Wall Positions
  !this.neWallDefPointsGrid     = object NETGRIDCONTROL()
  !this.coWallDefPoints.control = !this.neWallDefPointsGrid.handle()

  -- add PML event handlers to .Net control
  !this.neWallDefPointsGrid.addEventHandler('beforeCellUpdate',  !this, 'beforeUpdateWallCell')
  --!this.neWallDefPointsGrid.addEventHandler('afterCellUpdate',   !this, 'afterUpdateWallCell')
  !this.neWallDefPointsGrid.addEventHandler('afterSelectChange', !this, 'afterSelectChange')

  !gridHeading  = ARRAY()
  !gridHeading.append('Point')
  !gridHeading.append('Position')
  !gridHeading.append('Elevation')

  !points = ARRAY()
  !nds    = object NETDATASOURCE('WallPoints', !gridHeading, !points)
  !this.neWallDefPointsGrid.bindToDataSource(!nds)

  --Implementation of positional control
  --Create new instance of position control
  !this.neWallPosCntrl        = object POSITIONCONTROL()

  --Load ship grid data
  !grid                       = object SHIPGRID()
  !gridDefined                = !grid.position.set()

  -- Only populate the grid data if a ship reference grid is available
  if(!gridDefined) then

    do !i indices !grid.xID
      !xGridData[!i][1]       = !grid.xID[!i]
      !xGridData[!i][2]       = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]       = !grid.yID[!i]
      !yGridData[!i][2]       = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]       = !grid.zID[!i]
      !zGridData[!i][2]       = !grid.zOffset[!i]
    enddo

    -- Initialise as grid control and Specify tags
    !this.neWallPosCntrl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.neWallPosCntrl.heading('World Position')
    !this.neWallPosCntrl.gridFormat()

  else
    var !coordinate coordinate
    if(!coordinate.eq('ENU'))then
      !this.neWallPosCntrl.enuFormat()
    else
      !this.neWallPosCntrl.xyzFormat()
    endif
    !this.neWallPosCntrl.gridVisible(false)
  endif

    -- Set grid data
    !this.neWallPosCntrl.gridData(!xGridData,!yGridData,!zGridData)

   -- Add PMLNet control to PML frame
  !this.coWallPosCntrl.control  = !this.neWallPosCntrl.handle()
  !this.neWallPosCntrl.changeAction('!!accLayout.setWallPos()')

  -- End of codes for Implementing positional control

  -- Make the offset distance options inactive
  !this.lkWallRePosPoint.active = false
  !this.lkWallRemPoint.active   = false
  !this.txWallPtDir.active    = false
  !this.txWallPtDist.active   = false
  !this.txWallPtDir.val       = X
  !this.txWallPtDist.val      = 0
  !this.crtCeilingGrid.active = false

  -- Load information from Configuration
  !this.refreshConfig()

  -- Initialise task panes
  !this.mainTasks(true)
  !this.wallDefinitionTasks(false)
  !this.wallModificationTasks(false)
  !this.roomDefinitionTasks(false)
  !this.wallPositionTasks(false)
  !this.warningPane.visible     = false

  -- Set "Back" icon
  !backIcon                     = !!pml.getPathName('back.png')
  !this.wallDefBackIcon.addPixmap(!backIcon)
  !this.wallDetDefBackIcon.addPixmap(!backIcon)
  !this.wallModBackIcon.addPixmap(!backIcon)
  !this.wallDetModBackIcon.addPixmap(!backIcon)
  !this.roomBackIcon.addPixmap(!backIcon)

  !this.paWallDefBackIcon.addPixmap(!backIcon)
  --!this.paWallLayoutBackIcon.addPixmap(!backIcon)
  --!this.paBlTaskBackMainIcon2.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getPathName('create.png')
  !this.wDCrtIcon.addPixmap(!createIcon)
  !this.rDcrtIcon.addPixmap(!createIcon)
  !this.blTaskBackMainIcon1.addPixmap(!backIcon)
  !this.blTaskBackMainIcon2.addPixmap(!backIcon)
  !this.blTaskBackMainIcon3.addPixmap(!backIcon)
  !this.blTaskBackMainIcon4.addPixmap(!backIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getPathName('accept.png')
  !this.wmModIcon.addPixmap(!acceptIcon)
  --!this.acceptIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  --!discardIcon                  = !!pml.getPathName('discard.png')
  --!this.discardIcon.addPixmap(!discardIcon)

  -- Setup gadgets
  if (!!isImperialLength('DIST')) then
    -- Get from config
    !this.wDHeight.val            = 6'6
    !this.wMHeight.val            = 6'6

    -- Get from config
    !this.wDThickness.val         = 2in
    !this.wMThickness.val         = 2in
  else
    -- Get from config
    !this.wDHeight.val            = 2000mm
    !this.wMHeight.val            = 2000mm

    -- Get from config
    !this.wDThickness.val         = 50mm
    !this.wMThickness.val         = 50mm
  endif

  -- Set "Warning" icon
  !warningIcon                  = !!pml.getPathName('exclamation-32.png')
  !this.warningIcon.addPixmap(!warningIcon)

  -- EDG Description
  !this.edgDescription    = 'Accommodation Layout'

  -- Assign aid numbers for form
  !this.aidNumber         = !!aidNumbers.add('Layout')
  !this.aidBoundary       = !!aidNumbers.add('Layout - Boundary')

  -- assign aid number for wall definition pick point
  !this.wallDefPointAidNum  = !!aidNumbers.add('Picked Wall Point')

  -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Get current element
  !element                = !!accNavigator.currentSelection()

  -- If element is unset, then initialise form with limited actions
  if(!element.unset() or !element.badref()) then
    !this.currentOwner.val      = 'No active element selected'

    !this.mtCrtWalls.active     = false
    !this.mtCrtOpenings.active  = false
    !this.mtCrtMRooms.active    = false
    !this.mtCrtStrWells.active  = false
    !this.mtModWalls.active     = false

  -- Initialise form with relevant actions
  else
    -- Set owner where layout data is to be stored
    !this.owner                 = !element
    !this.currentOwner.val      = 'Active element: ' & !this.owner.namn
    !this.wmActive.tag          = 'Select ' & !this.owner.namn & ' walls'

    -- Set task active
    !this.mtCrtWalls.active     = true
    !this.mtCrtOpenings.active  = true
    !this.mtCrtMRooms.active    = !this.owner.fullType.eq('BLEVEL')
    !this.mtCrtStrWells.active  = true
    !this.mtModWalls.active     = true

  endif

  !this.nuVertices.active        = !this.pickedPoints.empty().not()
  !this.nuInsertVertices.active  = !this.pickedPoints.empty().not()
  !this.nuRemVertices.active     = !this.pickedPoints.empty().not()
  !this.wallRePick.active        = !this.pickedPoints.empty().not()
  !this.wallInsert.active        = !this.pickedPoints.empty().not()
  !this.wallRemove.active        = !this.pickedPoints.empty().not()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh form from navigator.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh task
  if(!this.shown()) then
    !this.initialise()
    !this.refreshTask.evaluate()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Set form members for when form title changes in other methods
  !this.bblockRText             = !!accConfig.typeDescription ( 'BBLOCK' )
  !this.blevelRText             = !!accConfig.typeDescription ( 'BLEVEL' )
  !this.roomRText               = !!accConfig.typeDescription ( 'ROOM' )

  -- Main Headings
  !this.createTasks.val         = 'Create'
  !this.modifyTasks.val         = 'Modify'
  --!this.copyTasks.val           = 'Copy'
  !this.deleteTasks.val         = 'Delete'

  !this.mtCrtMRooms.tag         = 'Geometry for defined ' & !this.roomRText

  -- Room tags
  !this.roomListTag.val         = !this.roomRText & ' with no geometry/details'
  !this.roomDataTag.val         = 'Basic ' & !this.roomRText & ' Attributes'
  !this.roomDefTag.val          = !this.roomRText & ' definition methods'

  !this.rDcrt.tag               = 'Create ' & !this.roomRText & ' Geometry'

  -- Grid defaults
  !columnExcelFilter            = !!accConfig.navigator.columnExcelFilter
  !outlookGroupStyle            = !!accConfig.navigator.outlookGroupStyle
  !columnSummaries              = !!accConfig.navigator.columnSummaries
  !labelVisibility              = !!accConfig.navigator.labelVisibility

  -- Control configuration (Rooms)
  !this.roomGrid.columnExcelFilter(!columnExcelFilter)
  !this.roomGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.roomGrid.columnSummaries(!columnSummaries)
  !this.roomGrid.fixedHeaders(false)
  !this.roomGrid.fixedRows(false)
  !this.roomGrid.singleRowSelection(true)
  !this.roomGrid.setLabelVisibility(!labelVisibility)

  -- Control configuration (Walls)
  !this.wallGrid.columnExcelFilter(!columnExcelFilter)
  !this.wallGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.wallGrid.columnSummaries(!columnSummaries)
  !this.wallGrid.fixedHeaders(false)
  !this.wallGrid.fixedRows(false)
  !this.wallGrid.singleRowSelection(false)
  !this.wallGrid.setLabelVisibility(!labelVisibility)

  -- Control configuration (Wall Positions)
  !this.neWallDefPointsGrid.columnExcelFilter(!columnExcelFilter)
  !this.neWallDefPointsGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.neWallDefPointsGrid.columnSummaries(!columnSummaries)
  !this.neWallDefPointsGrid.fixedHeaders(false)
  !this.neWallDefPointsGrid.fixedRows(true)
  !this.neWallDefPointsGrid.singleRowSelection(true)
  !this.neWallDefPointsGrid.setLabelVisibility(!labelVisibility)
  !this.neWallDefPointsGrid.editableGrid(true)
  !this.neWallDefPointsGrid.setEditableColumn(1,false)
  !this.neWallDefPointsGrid.setEditableColumn(3,false)
  --!this.neWallDefPointsGrid.rowAddDeleteGrid(true)

  if (!this.refreshTask.string().eq('!this.roomDefinitionTasks(true)') ) then
      !this.formTitle = 'Geometry Definition for ' & !this.roomRText  & 's'
  endif

  --update position control
  !posFormat = !!accConfig.positionformat

  -- Set to XYZ format
  if(!posFormat.eq('XYZ')) then
    !this.neWallPosCntrl.xyzFormat()

  -- Set to ENU format
  elseif (!posFormat.eq('ENU')) then
    !this.neWallPosCntrl.enuFormat()

  -- Set to Grid format
  elseif (!posFormat.eq('GRID')) then
    !this.neWallPosCntrl.gridFormat()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:        cancel
--
-- Description:   form cancel/close callback
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  -- Tidy
  !this.tidy()
  !!edgCntrl.remove(!this.edgDescription)

  -- remove wall definition point aid
  !!aidNumbers.remove(!this.wallDefPointAidNum)
  !this.wallDefPointAidNum  = REAL()

  -- initialise members
  !this.pickedPoints.clear()
  !this.wallExplicitPoints.clear()

  !this.pickedData.clear()
  !this.paths.clear()
  !this.closedWalls.clear()

endmethod
-- End of method definition

------------------------------------------------------------------------

--
-- Method:      dummy
--
-- Description: Dummy method for unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dummy()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  AID CLEAR ALL $!<this.aidNumber>
  AID CLEAR ALL $!<this.aidBoundary>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidyWalls
--
-- Description: Tidy walls
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyWalls()

  -- Get current list
  !list = !this.wallNames
  unenhance all from !list

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.mainTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.mainTasks(false)')
    !this.refreshTask         = object BLOCK('!this.dummy()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Main Layout Tasks'

  endif

  -- Show/hide task pane
  !this.mainTaskPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      wallDefinitionTasks
--
-- Description: Switch to wall definition task pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch task pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallDefinitionTasks(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Check that active element can own wall directly or own a DETGRP
    !element  = !this.owner
    if(!element.badref())then
      return
    endif
    !list     = !element.list
    !list.append(!element.type)
    -- Can not create a wall beneath this element
    !crtWall  = !list.findFirst('WALL').set().or(!list.findFirst('DETGRP').set())

    !this.wallDefPane.active  = !crtWall

    -- -- Tidy
    -- !this.tidy()
    -- !!edgCntrl.remove(!this.edgDescription)

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.wallDefinitionTasks(false)')
    !this.refreshTask         = object BLOCK('!this.wallDefinitionTasks(true)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Wall Definition Tasks'

    -- Update current owner tag
    if(!crtWall) then
      !this.currentOwner.val  = 'Wall definition for ' & !this.owner.namn
    else
      !this.currentOwner.val  = 'Unable able to create walls beneath ' & !this.owner.namn
    endif

    -- Get defaults for wall
    !type                     = !this.owner.type

    if(!type.eq('DETGRP')) then
      !element                = !this.owner.owner
    else
      !element                = !this.owner
    endif
    !height                   = !this.wDHeight.val
    if(!type.eq('ROOM')) then
      !height                 = !element.clnHeight
    elseif (!type.eq('BLEVEL')) then
      !height                 = !element.dClnHeight
    elseif (!type inset('BBLOCK')) then
      !height                 = !element.heiDefault
    endif
    !this.wDHeight.val        = !height

    -- Set reference plane
    !this.plane               = object PLANE(!element.position, !element.orientation)

    -- Make create button inactive
    !this.wDcrt.active        = false

    -- Open path
    !this.closedPath          = false

  -- Actions when task pane is made inactive
  else
    !this.tidy()
    !!edgCntrl.remove(!this.edgDescription)
  endif

  -- Show/hide task pane
  !this.wallDefPane.visible   = !active

  if(!this.wallExplicitPoints.unset()) then

     -- Initialise Variables
    !this.pickedPoints.clear()
    !this.pickedData.clear()
    !this.paths.clear()
    !this.closedWalls.clear()

    -- Tidy
    !this.tidy()
    !!edgCntrl.remove(!this.edgDescription)

    !range[1] = 0
    !range[2] = 1
    !range[3] = 1
    !this.setNumericGadgetState(!this.pickedPoints.empty().not(), !range)

  else
    !this.wDcrt.active  = true
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      wallModificationTasks
--
-- Description: Switch to wall modification task pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch task pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallModificationTasks(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Tidy
    !this.tidy()

    !!edgCntrl.remove(!this.edgDescription)

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.wallModificationTasks(false)')
    !this.refreshTask         = object BLOCK('!this.wallModificationTasks(true)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Wall Modification Tasks'

  -- Actions when task pane is made inactive
  else
    !this.tidyWalls()
    !this.tidy()
    !!edgCntrl.remove(!this.edgDescription)
  endif

  -- Show/hide task pane
  !this.wallModPane.visible   = !active
  !this.updateWallList()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roomDefinitionTasks
--
-- Description: Switch to room definition task pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch task pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomDefinitionTasks(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Tidy
    !this.tidy()
    !!edgCntrl.remove(!this.edgDescription)

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.roomDefinitionTasks(false)')
    !this.refreshTask         = object BLOCK('!this.roomDefinitionTasks(true)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Geometry Definition for ' & !this.roomRText  & 's'

    -- Set reference plane
    !this.plane               = object PLANE(!this.owner.position, !this.owner.orientation)

    -- Make create button inactive
    !this.rDcrt.active        = false

    -- Open path
    !this.closedPath          = true

    -- Make picking options inactive
    !this.roomEDGPick.active  = false
    !this.roomEDGPos.active   = false

    -- Populate list of rooms
    !this.updateRoomList()

  -- Actions when task pane is made inactive
  else
    !this.tidy()
    !!edgCntrl.remove(!this.edgDescription)
  endif

  -- Show/hide task pane
  !this.roomTaskPane.visible  = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateRoomList
--
-- Description: Update room list with room
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRoomList()

  -- Initialise Variables

  -- Attributes
  !attributes             = ARRAY()
  !attributes.append('NAME')
  !attributes.append('Number')
  !attributes.append('Description')

  !roomCollection         = object COLLECTION()
  !roomCollection.addType('ROOM')

  -- Get all levels
  !roomCollection.scope(!this.owner)
  !roomCollection.filter(object EXPRESSION('MCOUNT eq 0'))
  !myCollection           = !roomCollection.results()
  !block                  = object BLOCK('!myCollection[!evalIndex].string()')
  !dbNames                = !myCollection.evaluate(!block)

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds                = object NETDATASOURCE('Rooms', !attributes, !dbNames)
  !this.roomGrid.bindToDataSource(!nds)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectWall
--
-- Description: Select Wall from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectWall(!passedArray is ARRAY)

  -- Unenhance walls
  !this.tidyWalls()

  -- Initialise Variable
  !elements = !this.wallGrid.getSelectedRowTags()
  !list     = !this.wallNames
  if(!this.wallGrid.getSelectedRows().empty())then
    !this.wMThickness.val = 0
    !this.wMHeight.val    = 0
    !this.wMJustif.val    = 1
    !this.wMCloseFlag.val    = false
  else
    !this.wMThickness.val  = !this.wallGrid.getSelectedRows()[1][2].real()
    !this.wMHeight.val     = !this.wallGrid.getSelectedRows()[1][3].real()
    !this.wMJustif.select('RTEXT',!this.wallGrid.getSelectedRows()[1][4])
    !this.wMCloseFlag.val    = !this.wallGrid.getSelectedRows()[1][5].boolean()
    handle ANY
    endhandle
  endif
  enhance all from !elements colour red

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectRoom
--
-- Description: Select ROOM from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectRoom(!passedArray is ARRAY)

  -- Initialise Variable
  !elements               = !this.roomGrid.getSelectedRowTags()

  -- Tidy
  !this.tidy()
  !!edgCntrl.remove(!this.edgDescription)

  -- Return if there are no elements
  if(!elements.empty()) then

    -- Make picking options inactive
    !this.roomEDGPick.active  = false
    !this.roomEDGPos.active   = false
    return
  endif

  -- Set default room
  !this.currentRoom       = !elements[1].dbref()
  !this.roomDefinition    = object DBEROOM(!this.currentRoom)
  !this.owner             = !this.currentRoom.owner
  !this.currentOwner.val  = 'Active element: ' & !this.owner.namn

  -- Set reference plane
  !this.plane             = object PLANE(!this.owner.position, !this.owner.orientation)
  !this.roomPlane         = object PLANE(!this.currentRoom.position, !this.currentRoom.orientation)


  -- Make create button inactive
  !this.rDcrt.active      = false

  -- Load defaults
  !floorHeight                = !this.roomDefinition.flrHeight
  !ceilingHeight              = !this.roomDefinition.clnHeight
  !defaultHeight              = !this.roomDefinition.defaultHeight

  -- Floor Height
  if(!this.currentRoom.flrHeight.neq(0)) then
    !floorHeight            = !this.currentRoom.flrHeight
  elseif (!this.owner.dFlrHeight.neq(0)) then
    !floorHeight            = !this.owner.dFlrHeight
  else
    !floorHeight            = !!accConfig.flrHeight
  endif
  !this.roomDefinition.elevation(!floorHeight)
  !this.rmFlrHeight.val   = !floorHeight

  -- Ceiling Height
  if(!this.currentRoom.clnHeight.neq(0)) then
    !ceilingHeight            = !this.currentRoom.clnHeight
  elseif (!this.owner.dClnHeight.neq(0)) then
    !ceilingHeight            = !this.owner.dClnHeight
  else
    !ceilingHeight            = !!accConfig.clnHeight
  endif
  !this.roomDefinition.clnHeight  = !ceilingHeight
  !this.rmClnHeight.val           = !ceilingHeight

  -- Default Height
  if(!this.currentRoom.heiDefault.neq(0)) then
    !defaultHeight            = !this.currentRoom.heiDefault
  elseif (!this.owner.heiDefault.neq(0)) then
    !defaultHeight            = !this.owner.heiDefault
  endif
  !this.roomDefinition.height(!defaultHeight)
  !this.rmDHeight.val     = !defaultHeight

  -- Make picking options active
  !this.roomEDGPick.active  = true
  !this.roomEDGPos.active   = true

  -- Tag Room
  !position               = !this.currentRoom.labPosition
  AID TEXT NUMBER $!<this.aidNumber> '$!this.currentRoom.namn' AT $!<position>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      wallDetailGroup
--
-- Description: Get detail group for walls, create if one doesn't exist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallDetailGroup() is DBREF
  return !!accDetailGroup(!this.owner, 'WALL', 'Wall definitions')
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roomEDGPick
--
-- Description: Define room from EDG Picking
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomEDGPick()

  -- Initialise Variables
  !this.pickedPoints.clear()
  !this.pickedData.clear()
  !this.paths.clear()
  !this.tidy()

  -- Define event packet
  !prompt               = 'Pick graphics, <esc> to exit'
  !packet               = object EDGPACKET()
  !packet.pickPacket.stdGraphic(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.close         = '!!' & !this.name() & '.roomFromPoints()'
  !packet.action        = '!!' & !this.name() & '.derivePathFromPicks(!this.return[1], !this)'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roomEDGPoints
--
-- Description: Define room from EDG positioning
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomEDGPoints()

  -- Initialise Variables
  !this.pickedPoints.clear()
  !this.pickedData.clear()
  !this.paths.clear()
  !this.tidy()

  -- Define event packet
  !prompt               = 'Pick position, <esc> to exit'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.close         = '!!' & !this.name() & '.roomFromPoints()'
  !packet.action        = '!!' & !this.name() & '.derivePathFromPoints(!this.return[1], !this)'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roomFromPoints
--
-- Description: Define room using picked points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomFromPoints()

  -- Define wall path
  !this.paths.clear()

  -- Define
  if(!this.pickedPoints.empty().not()) then
    !profile    = object PROFILE(!this.pickedPoints.first(), !this.plane.orientation, !this.pickedPoints)
    !profile    = !profile.close()

    -- New origin of room
    !this.roomDefinition.xyOffset(!profile.position)

    -- Reposition profile about new room origin
    !profile.position = !this.roomDefinition.plane.position

    -- Draw room
    !this.tidy()
    aid text number $!this.aidNumber '$!this.roomDefinition.name' at $!profile.position
    !profile.draw(!this.aidBoundary, 1, 5)

    -- Add
    !this.paths.append(!profile)

  endif

  -- Make create button active
  !this.rDcrt.active  = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      wallEDGPick
--
-- Description: Define walls from EDG Picking
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallEDGPick()

  -- Initialise Variables
  !this.pickedPoints.clear()
  !this.pickedData.clear()
  !this.paths.clear()
  !this.closedWalls.clear()
  !this.tidy()

  -- Define event packet
  !prompt               = 'Pick graphics, <esc> to exit'
  !packet               = object EDGPACKET()
  !packet.pickPacket.stdGraphic(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.close         = '!!' & !this.name() & '.wallFromPoints()'
  !packet.action        = '!!' & !this.name() & '.derivePathFromPicks(!this.return[1], !this)'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setNumericGadgetState
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setNumericGadgetState(!active is BOOLEAN, !range is ARRAY)

  if(!range.set()) then
    !this.nuVertices.range         = !range
    !this.nuInsertVertices.range   = !range
    !this.nuRemVertices.range      = !range

  else
     !this.nuVertices.val          = 0
     !this.nuInsertVertices.val    = 0
     !this.nuRemVertices.val       = 0
  endif

  !this.nuVertices.active          = !active
  !this.nuInsertVertices.active    = !active
  !this.nuRemVertices.active       = !active
  !this.wallRePick.active          = !active
  !this.wallInsert.active          = !active
  !this.wallRemove.active          = !active

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      wallRePick
--
-- Description: Redefine vertex from EDG Picking
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallRePick()

  -- Define event packet
  !prompt               = 'Re Pick position of vertex $!this.nuVertices.val'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = '!!' & !this.name() & '.modifyPoints(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      wallInsertPoint
--
-- Description: Inserting new vertex
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallInsertPoint()


  -- Define event packet
  !prompt               = 'Pick position for the new vertex'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  --!packet.close         = '!!' & !this.name() & '.wallFromPoints()'
  !packet.action        = '!!' & !this.name() & '.insertPoints(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      wallEDGPoints
--
-- Description: Define walls from EDG positioning
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallEDGPoints()

  -- Initialise Variables
  !this.pickedPoints.clear()
  !this.pickedData.clear()
  !this.paths.clear()
  !this.closedWalls.clear()
  !this.tidy()

  -- Define event packet
  !prompt               = 'Pick position, <esc> to exit'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.close         = '!!' & !this.name() & '.wallFromPoints()'
  !packet.action        = '!!' & !this.name() & '.derivePathFromPoints(!this.return[1], !this)'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyPoints
--
-- Description: Modify the position of the Vertex
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyPoints(!data is EDGPOSITIONDATA)

   -- Initialise Variables
  !plane    = !this.plane
  !position = !plane.near(!data.position)
  !vertex  = !this.nuVertices.val
  !this.pickedPoints[!vertex] = !position
  !this.paths.clear()
  !this.closedWalls.clear()
  !this.drawPath()
  !this.wallFromPoints()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      insertPoints
--
-- Description: inserting new point with the picked position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertPoints(!data is EDGPOSITIONDATA)

  -- Initialise Variables
  !plane    = !this.plane
  !position = !plane.near(!data.position)
  !vertex  = !this.nuInsertVertices.val
  !this.pickedPoints.insert(!vertex + 1,!position)
  !this.paths.clear()
  !this.closedWalls.clear()
  !this.drawPath()
  !this.wallFromPoints()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      wallRemovePoint
--
-- Description: Remove point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallRemovePoint()

  !vertex  = !this.nuRemVertices.val
  !this.pickedPoints.remove(!vertex)
  !this.paths.clear()
  !this.closedWalls.clear()
  !this.drawPath()
  !this.wallFromPoints()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      wallFromPoints
--
-- Description: Define wall using picked points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallFromPoints()

  -- Remove duplicates
  -- If the first point is the same as the last and the array has more than 2 members set the closedWalls flag
  -- to set the CLOSEF attribute on the CTWALL. this will ensure that we can have a closed CTWALL loop.
  if !this.pickedPoints[1].eq(!this.pickedPoints[!this.pickedPoints.size()]) and !this.pickedPoints.size().gt(2) then
    !this.pickedPoints.unique()
    !this.closedWalls.append( TRUE )
  else
    !this.pickedPoints.unique()
    !this.closedWalls.append( FALSE )
  endif

  -- Define wall path
  if(!this.pickedPoints.size().gt(1)) then
    !profile  = object PROFILE(!this.pickedPoints.first(), !this.plane.orientation, !this.pickedPoints)
    !this.paths.append(!profile)

  -- Try and derive wall from picked data
  elseif (!this.pickedData.size().eq(1)) then

    if(!this.pickedData[1].objectType().eq('LINE')) then
      !this.pickedPoints.clear()
      !this.pickedPoints.append(!this.pickedData[1].startPosition)
      !this.pickedPoints.append(!this.pickedData[1].endPosition)
      !profile  = object PROFILE(!this.pickedPoints.first(), !this.plane.orientation, !this.pickedPoints)
      !this.paths.append(!profile)
    endif

  endif

  -- Draw wall
  if(defined(!profile)) then

    --!profile.draw(!this.aidBoundary, 1, 5)

    -- Make create button active
    !this.wDcrt.active  = true

    !range[1] = 1
    !range[2] = !this.pickedPoints.size()
    !range[3] = 1

    !this.setNumericGadgetState(true, !range)

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      wallsFromSelection
--
-- Description: Define walls from graphical selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallsFromSelection()

  -- Tidy graphics
  !this.tidy()

  -- Set wall create gadgets
  !this.wDcrt.active  = true

  -- Initialise Variables
  !lines              = ARRAY()
  !reference          = !!ce
  --!!ce                = !this.owner
  !this.paths.clear()
  !this.closedWalls.clear()

  -- Get selected draws to convert into walls
  !selection          = object SELECTION()
  !selection.getCurrent()
  -- Get draws from graphical selection
  !elements           = !selection.getSelection()

  -- when we are in 'navigate to element' mode the a selection can not be made so we force the
  -- selection to be made from the current element level
  if !elements.unset() then
    !elements = object ARRAY()
    !elements[1] = !reference
  endif

  -- Build new selection
  !selection.clear()
  do !i indices !elements
    !type             = !elements[!i].type
    if(!type inset('DRAW')) then
      !lines.append(!elements[!i])
      !selection.add(!elements[!i])
    elseif (!type inset('BNDLIN')) then
      --make sure the BNDLIN belongs directly to a room or a DETGRP
      --if !elements[!i].owner.type.eq('DETGRP') or !elements[!i].owner.type.eq('ROOM') then
        !lines.append(!elements[!i])
        !selection.add(!elements[!i])
      --endif
    endif
  enddo

  -- if current selection is unset then we know we are looking at current element level
  -- if the current element type is a REFDAT find any corresponding DRAW elements underneath
  -- if the current element type is a room then find the boundary line underneath it
  -- if the current element type is an area definition then goto the owning room and find the boundary line underneath it
  if !selection.getSelection().unset() then
    if !elements[1].type.eq('REFDAT') then
      var !draw collect all draw for $!elements[1]
      do !j indices !draw
        !lines.append(!draw[!j].dbref())
        !selection.add(!draw[!j].dbref())
      enddo
    elseif !elements[1].type.eq('ROOM') then
      !!ce = !elements[1]
      BNDLIN 1
      handle any
      elsehandle none
        !lines.append(!!ce)
        !selection.add(!!ce)
      endhandle
    elseif !elements[1].type.eq('FLRCOV') then
      !!ce = !elements[1]
      !lines.append(!!ce)
      !selection.add(!!ce)
    elseif !elements[1].type.eq('AREADE') then
      !!ce = !elements[1]
      owner
      BNDLIN 1
      handle any
      elsehandle none
        !lines.append(!!ce)
        !selection.add(!!ce)
      endhandle
    endif
  endif
  !selection.setCurrent()

  -- Reference plane
  !plane              = !this.plane

  -- Loop through lines and generate profiles from them
  do !i indices !lines
    !type             = !lines[!i].type
    if(!type.eq('DRAW')) then
      !loop           = !lines[!i]
    elseif (!type inset('FLRCOV', 'BNDLIN')) then
      !loop           = loop 1 of $!<lines[$!<i>]>
    endif

    -- Extract profile
    !profile          = object PROFILE(!loop)

    -- Map profile on to reference plane
    !edges            = !profile.edges()
    !newEdges         = ARRAY()

    -- Loop through edges
    do !j indices !edges
      if(!edges[!j].objectType().eq('LINE')) then
        !line         = !edges[!j].projected(!plane)
        !newEdges.append(!line)
      else
        !newEdges.append(!edges[!j])
      endif
    enddo

    -- Define new profile
    !position         = !plane.near(!lines[!i].position)
    !newProfile       = object PROFILE(!position, !plane.orientation, !newEdges)
    !newProfile.draw(!this.aidBoundary, 2, 4)

    -- Save path
    !this.paths.append(!newProfile)
    !this.closedWalls.append( TRUE )
  enddo

  if(!this.paths.empty())then
    !!alert.warning('The current Selection is not valid. Please select valid Boundary lines, Floor coverings, REFDAT or Draw elements.')
    !this.wDcrt.active = false
  endif

  !selection.clear()
  !selection.setCurrent()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      derivePathFromPicks
--
-- Description: Derive closed path from picks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .derivePathFromPicks(!data is EDGPICKDATA, !packet is EDGPACKET)

  -- Clear graphics
  AID CLEAR ALL $!<this.aidBoundary>

  -- Initialise Variables
  !plane      = !this.plane

  -- Primary object type
  !type       = !data.primaryObject

  -- Extract graphic element from pick and map on to the plane
  -- Graphic line picked
  if(!type.eq('EDGE')) then
    !line     = !data.lines[1].line(!data.lines[2])
    !projectedLine    = !line.projected(!plane)
    -- vertical line?
    if ( !projectedLine.length() lt 0.1 ) then
       !dData = !projectedLine.startPosition
    else
       !dData = !projectedLine
    endif

  -- Graphic surface picked
  elseif (!type.eq('FACET')) then
    !points   = !data.facets
    !points.unique()
    !iPlane   = !points[1].plane(!points[2], !points[3])
    !dData    = !plane.intersection(!iPlane)

    -- Map facet points on plane
    do !i indices !points
      !pointPos[!i] = !plane.near(!points[!i])
    enddo
    !pointPos.unique()

    -- Construct a line from the picks
    !dData    = !pointPos[1].line(!pointPos[2])

    --# Determine max length of line
    do !i from 3 to !pointPos.size()
    enddo

  -- Graphics point picked
  elseif (!type.eq('VERTEX')) then
    !dData    = !plane.near(!data.vertices.first())
  endif

  -- Data type (position or line)
  !dType      = !dData.objectType()

  -- If there is no previous picked data, then save the information
  if(!this.pickedData.empty()) then

    -- Add derived position to list of picked points
    if(!dType.eq('POSITION')) then
      !this.pickedPoints.append(!dData)
    endif

  -- Previous element defined
  else

    -- Get previous element from picked data
    !previous = !this.pickedData.last()
    !pType    = !previous.objectType()

    -- Determine the point on the boundary from derived type and previous

    -- Derived data is a POSITION
    if(!dType.eq('POSITION')) then
      !position     = !dData

      -- Previous is line (map point onto line)
      if(!pType.eq('LINE')) then
        !position   = !previous.near(!position)
      endif

    -- Derived Data is a LINE
    else

      -- Previous is LINE (get intersection)
      if(!pType.eq('LINE')) then
        !position   = !previous.intersection(!dData)

      -- Previous is POSITION (map point onto line)
      else
        !position   = !dData.near(!previous)
      endif

    endif

    -- Add position to list of picked points only if the position is not the same as the last one
    if !this.pickedPoints.size().neq(0) then
      if !position.neq(!this.pickedPoints[!this.pickedPoints.size()]) then
        !this.pickedPoints.append(!position)
      endif
    else
      !this.pickedPoints.append(!position)
    endif
  endif

  -- Add derived data to picked data
  !this.pickedData.append(!dData)

  -- Draw path
  !this.drawPath()

  -- if we are picking the last point in a rectangular room then end the picking process
  if !this.pickedPoints[1].eq(!this.pickedPoints[!this.pickedPoints.size()]) and !this.pickedPoints.size().gt(2) then
    !packet.remove = true
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      derivePathFromPoints
--
-- Description: Get position data and map onto working plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .derivePathFromPoints(!data is EDGPOSITIONDATA, !packet is EDGPACKET)

  -- Initialise Variables
  !plane    = !this.plane
  !position = !plane.near(!data.position)

  -- Add position to list of picked points only if the position is not the same as the last one
  if !this.pickedPoints.size().neq(0) then
    if !position.neq(!this.pickedPoints[!this.pickedPoints.size()]) then
      !this.pickedPoints.append(!position)
    endif
  else
    !this.pickedPoints.append(!position)
  endif

  -- Draw path
  !this.drawPath()

  -- if we are picking the last point in a rectangular room then end the picking process
  if !this.pickedPoints[1].eq(!this.pickedPoints[!this.pickedPoints.size()]) and !this.pickedPoints.size().gt(2) then
    !packet.remove = true
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawPath
--
-- Description: Draw path
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawPath()

  -- Tidy
  !this.tidy()

  -- Initialise Variables
  !index  = !this.pickedPoints.size()
  -- Draw boundary
  if(!index.gt(0)) then
    !position   = !this.pickedPoints[1]
    AID TEXT NUMBER $!<this.aidNumber> 'Origin'   AT $!position
    do !i from 2 to !index
      !position = !this.pickedPoints[!i]
      AID TEXT NUMBER $!<this.aidNumber> '$!i' AT $!position
    enddo

    -- More than one point
    if(!index.gt(1)) then
      !profile    = object PROFILE(!this.plane.position, !this.plane.orientation, !this.pickedPoints)
      if(!this.closedPath) then
        !profile.close()
      endif
      !profile.draw(!this.aidBoundary, 2, 4)
    endif
  endif

  -- Draw last pick if a line
  if(!this.pickedData.empty().not()) then
    !pickedData     = !this.pickedData.last()
    if(!pickedData.objectType().eq('LINE')) then
      !line         = !pickedData
      !xlength      = !line.length()
      !ylength      = 1mm
      !zlength      = 100mm
      !orientation  = object ORIENTATION('X is ' & !line.direction())
      !position     = !line.proportion(0.5)

      AID BOX NUMBER $!<this.aidBoundary> POSITION $!<position> ORIENTATION $!<orientation>  XLENGTH $!<xlength> YLENGTH $!<ylength> ZLENGTH $!<zlength> FILLED ON
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createRoomGeometry
--
-- Description: Create room definitions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createRoomGeometry()

  -- Initialise Variables
  !profile      = !this.paths.first()

  -- Reference Element
  !reference  = !!ce

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created ' & !this.roomRText & ' geometry')
  !this.undo.add()

  -- Navigate to Level
  !!ce                  = !this.currentRoom

  -- Modify Room
  !this.roomDefinition.outerBoundary(!profile)
  !this.roomDefinition.modify()

  -- Define basic of room
  !roomBasics           = object ACCROOMBASICS(!this.roomDefinition)
  !roomBasics.defineCeiling(!this.crtCeiling.val)
  !roomBasics.defineCeilingGrid(!this.crtCeilingGrid.val)
  !roomBasics.defineFloor(!this.crtFloor.val)

  -- Create basics
  !roomBasics.create()

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Reload rooms
  !this.updateRoomList()

  -- reset buttons until a new room is selected

  -- Make create button inactive
  !this.rDcrt.active        = false

  -- Make picking options inactive
  !this.roomEDGPick.active  = false
  !this.roomEDGPos.active   = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createWallPaths
--
-- Description: Define walls paths
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createWallPaths()

  -- Initialise Variables
  !reference          = !!ce

  -- Set wall create gadgets
  !this.wDcrt.active  = false

  !range[1] = 0
  !range[2] = 1
  !range[3] = 1

  !this.setNumericGadgetState(false, !range)

  -- Define UNDO Information
  !this.undo          = object UNDOABLE()

  !this.undo.description('Created wall paths')
  !this.undo.add()

  -- Wall detail group
  !detailGroup      = !this.wallDetailGroup()
  !!ce              = !detailGroup

  -- Move to wall
  do !iPath indices !this.paths
    !path = !this.paths[!iPath]
    NEW CTWALL

    !wall             = !!ce
    !wall.height      = !this.wDHeight.val
    !wall.wThickness  = !this.wDThickness.val
    !wall.wJusLine    = !this.wDJustif.selection()
    !wall.closeFlag   = !this.closedWalls[!iPath]
    !!ce.position     = !path.position
    NEW HATTA
    NEW TATTA
    NEW RPATH
    !edges          = !path.edges()
    if !edges.size().eq(1) AND !edges[1].objectType().eq('ARC') then
      if !edges[1].startangle.eq(0) AND !edges[1].endangle.eq(360) then
        -- Special case for circular wall
        !arc = !edges[1]
        !endPoint = !arc.angleposition(180)
        !startPoint = !arc.angleposition(!arc.startangle)
        NEW POINTR
        !firstPoint = !!ce
        !firstPoint.position = !startPoint

        NEW CURVE
        !curve = !!ce
        !curve.radius = !arc.radius
        !curve.position = !arc.position

        !oriZ = !arc.orientation.zdir()
        if !arc.sense.eq(TRUE) then
          !oriZ = !oriZ.opposite()
        endif
        Zdirection $!oriZ

        NEW POINTR
        !nextPoint = !!ce
        !nextPoint.position = !endPoint
        !centrePoint = !arc.angleposition(90)
        !curve.cpos = !centrePoint
        !curve.curType = 'CENT'

        NEW CURVE
        !curve = !!ce
        !curve.radius = !arc.radius
        !curve.position = !arc.position

        !oriZ = !arc.orientation.zdir()
        if !arc.sense.eq(TRUE) then
          !oriZ = !oriZ.opposite()
        endif
        Zdirection $!oriZ

        NEW POINTR
        !nextPoint = !!ce
        !nextPoint.position = !startPoint
        !centrePoint = !arc.angleposition(270)
        !curve.cpos = !centrePoint
        !curve.curType = 'CENT'
      else
      	!from           = !edges[1].startPosition
        NEW POINTR
        !firstPoint = !!ce
        !!ce.position   = !from
        do !i indices !edges
          if !edges[!i].objectType().eq('ARC') then
            NEW CURVE
            !curve = !!ce
            !curve.radius = !edges[!i].radius
            !curve.position = !edges[!i].position
            !arc = !edges[!i]
            !oriZ = !arc.orientation.zdir()
            if !arc.sense.eq(TRUE) then
              !oriZ = !oriZ.opposite()
            endif
            Zdirection $!oriZ
            !endPoint = !arc.angleposition(!arc.endangle)
            !startPoint = !arc.angleposition(!arc.startangle)
            if !i.eq(1) then
              -- if the first point in the list is a curve then we need to position the first POINTR correctly with respect to the arc start and end
              !firstPoint.position = !startPoint
            endif
            NEW POINTR
            !nextPoint = !!ce
            !nextPoint.position = !endPoint
            !centrePoint = !arc.angleposition(!arc.startangle + ((!arc.endangle - !arc.startangle) / 2))
            !curve.cpos = !centrePoint
            !curve.curType = 'CENT'
            skip
          endif
          !to           = !edges[!i].endPosition
          NEW POINTR
          !!ce.position = !to
        enddo
      endif
    else
      !from           = !edges[1].startPosition
      NEW POINTR
      !firstPoint = !!ce
      !!ce.position   = !from
      do !i indices !edges
        if !edges[!i].objectType().eq('ARC') then
          NEW CURVE
          !curve = !!ce
          !curve.radius = !edges[!i].radius
          !curve.position = !edges[!i].position
          !arc = !edges[!i]
          !oriZ = !arc.orientation.zdir()
          if !arc.sense.eq(TRUE) then
            !oriZ = !oriZ.opposite()
          endif
          Zdirection $!oriZ
          !endPoint = !arc.angleposition(!arc.endangle)
          !startPoint = !arc.angleposition(!arc.startangle)
          if !i.eq(1) then
            -- if the first point in the list is a curve then we need to position the first POINTR correctly with respect to the arc start and end
            !firstPoint.position = !startPoint
          endif
          NEW POINTR
          !nextPoint = !!ce
          !nextPoint.position = !endPoint
          !centrePoint = !arc.angleposition(!arc.startangle + ((!arc.endangle - !arc.startangle) / 2))
          !curve.cpos = !centrePoint
          !curve.curType = 'CENT'
          skip
        endif
        !to           = !edges[!i].endPosition
	if ( !i eq !edges.size() ) then
	
	   if ( !to eq !from ) then
	      skip
	   endif
	endif
        NEW POINTR
        !!ce.position = !to
      enddo
    endif


  enddo

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Tidy
  !this.tidy()
  -- clear the points
  !this.pickedPoints.clear()

  -- Return to original element
  !!ce    = !reference
  --!this.wallModificationTasks(true)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useActiveWalls
--
-- Description: Get walls from current active element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useActiveWalls()

  -- Unenhance walls
  !this.tidyWalls()

  -- Tidy graphics
  !this.tidy()

  -- Clear grid
  !this.wallGrid.clearGrid()

  -- Initialise Variables
  !this.wallList.clear()
  !this.wallNames.clear()
  !groups = ARRAY()

  -- Collect all walls for current active element

  -- Get DETGRP of active element
  do !member values !this.owner.members
    if(!member.type.eq('DETGRP')) then
      !groups.append(!member)
    endif
  enddo

  -- Collect walls from groups owned by the active element
  if(!groups.empty().not()) then
    !collection     = object COLLECTION()
    !collection.addType('CTWALL')
    !collection.scope(!groups)
    !this.wallList  = !collection.results()

    -- Define selection
    !selection      = object SELECTION()
    do !wall values !this.wallList
      !selection.add(!wall)
    enddo

    -- Highlight selection
    !selection.setCurrent()

  endif

  -- Update grid
  !this.updateWallList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useSelectedWalls
--
-- Description: Get walls from graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useSelectedWalls()

  -- Unenhance walls
  !this.tidyWalls()

  -- Tidy graphics
  !this.tidy()

  -- Clear grid
  !this.wallGrid.clearGrid()

  -- Initialise Variables
  !this.wallList.clear()
  !this.wallNames.clear()

  -- Get selected draws to convert into walls
  !selection          = object SELECTION()
  !selection.getCurrent()

  -- Get draws from graphical selection
  !elements           = !selection.getSelection()

  -- Build new selection
  !selection.clear()
  do !i indices !elements
    !type             = !elements[!i].type
    if(!type.eq('CTWALL')) then
      !selection.add(!elements[!i])
      !this.wallList.append(!elements[!i])
    endif
  enddo

  -- Highlight selection
  !selection.setCurrent()

  -- Update grid
  !this.updateWallList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateWallList
--
-- Description: Get walls from graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateWallList()

  -- Removing deleted walls from wallList
  !wallList  = object ARRAY()
  do !walls values !this.wallList
    if(!walls.badref().not())then
      !wallList.append(!walls)
    endif
  enddo
  !this.wallList  = object ARRAY()
  !this.wallList  = !wallList
  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('NAME')
  !attributes.append('WThickness')
  !attributes.append('Height')
  !attributes.append('wJusLine')
  !attributes.append('closeFlag')
  -- Load grid
  if(!this.wallList.empty().not()) then
    !block                  = object BLOCK('!this.wallList[!evalIndex].string()')
    !dbNames                = !this.wallList.evaluate(!block)
    !this.wallNames         = !dbNames
    using namespace 'Aveva.Pdms.Presentation'
    !nds                = object NETDATASOURCE('Walls', !attributes, !dbNames)
    !this.wallGrid.bindToDataSource(!nds)
    !this.wallGrid.setSelectedRowTags(!this.wallNames)
  else
    !dbName            = object ARRAY()
    if(!!ce.type.eq('CTWALL'))then
      !dbName.append(!!ce.string())
    else
      !level   = !!ce.dbdep - 1
      !owner = !!ce
      do from 1 to !level
        if(!owner.type eq 'CTWALL')then
          !dbName.append(!owner.string())
        endif
        !owner = !owner.owner
      enddo
    endif
    using namespace 'Aveva.Pdms.Presentation'
    !nds                = object NETDATASOURCE('Walls', !attributes, !dbName)
    !this.wallGrid.bindToDataSource(!nds)
    !this.wallGrid.setSelectedRowTags(!dbName)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyWalls
--
-- Description: Modify walls from selection list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyWalls()

  -- Initialise Variables
  !elements = !this.wallGrid.getSelectedRowTags()

  -- Define UNDO Information
  !this.undo          = object UNDOABLE()

  !this.undo.description('Modify wall basics')
  !this.undo.add()

  -- Loop through selected walls and modify them
  do !element values !elements
    !wall             = !element.dbref()
    !wall.height      = !this.wMHeight.val
    !wall.wThickness  = !this.wMThickness.val
    !wall.wJusLine    = !this.wMJustif.selection()
    !wall.closeFlag   = !this.wMCloseFlag.val
  enddo

  !this.updateWallList()

  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Continue"
--    3   R      STRING      "Continue" text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING, !continue is STRING)

  -- Switch warning pane
  !this.currentPane.visible   = false
  !this.warningPane.visible   = true

  -- Concatenate message into a single line
  !display    = ''
  do !i indices !message
    !display  = !display & ' ' & !message[!i]
  enddo

  -- Display message
  !this.warning.val           = !display.trim()
  !this.warningDone.tag       = !continue

  -- Set "Continue" action (If the action is dependent on other criteria
  -- e.g. being in the correct position in the hierarchy, then the
  -- active state of the "Done" button needs to be managed.
  !this.warningAction         = object BLOCK(!action)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warningDone
--
-- Description: Exit warning
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warningDone()

  -- Hide warning pane
  !this.warningPane.visible   = false

  -- Execute action
  !this.warningAction.evaluate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      exampleWarning
--
-- Description: Example of how to use a warning with an action
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exampleWarning1()

  -- Define message to be displayed
  !message[1] = 'This is the message that is to be displayed in the '
  !message[2] = 'warning pane. The message can be up to 132 Characters'
  !message[3] = 'long.'
  !this.warning(!message, '!this.firstTaskPane(true)', !this.ftpWarningMsg.val)

endmethod
-- End of method definition

