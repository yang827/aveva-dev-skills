------------------------------------------------------------------------
--
-- Method:        wallPositionTasks
--
-- Description:   Switch to wall explicit position definition task pane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallPositionTasks(!active is BOOLEAN )

    if(!active) then

      !this.wallExplicitPositionPane.visible = !active

      -- Tidy
      !this.tidy()
      !!edgCntrl.remove(!this.edgDescription)

      ---- Run action for current pane
      !this.currentTask.evaluate()

      ---- Defined action to be carried out on closing pane
      !this.currentTask         = object BLOCK('!this.wallPositionTasks(false)')
      !this.refreshTask         = object BLOCK('!this.wallPositionTasks(true)')

      -- Change form title to reflect the active pane
      !this.formTitle           = 'Wall Definition by Explicit points'

      -- Initialise the members storing the wall definition vertices
      !this.wallExplicitPoints.clear()
      !this.pickedPoints.clear()

      !this.initWallPositionFrame()

    endif

    !this.wallExplicitPositionPane.visible = !active

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initWallPositionFrame
--
-- Description: Initialise the wall definition by explicit points pane
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initWallPositionFrame()

  -- Initialise the grid control
  !this.updateWallGrid()

  -- Initialise the position control
  !floorElev  = !this.plane.position.up
  !this.neWallPosCntrl.forcexyz(0,0,!floorElev)
  !this.neWallPosCntrl.zlock(true)

  -- Make the offset distance and direction gadgets inactive
  !this.txWallPtDir.active    = false
  !this.txWallPtDist.active   = false

  -- Initialise the offset distance and direction gadgets
  !this.txWallPtDir.val       = X
  !this.txWallPtDist.val      = 0

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createWallPoint
--
-- Description:   Creates the wall definition point
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createWallPoint()

  !east   = !this.neWallPosCntrl.xyz()[0]
  !north  = !this.neWallPosCntrl.xyz()[1]
  !elev   = !this.neWallPosCntrl.xyz()[2]

  -- change the elevation if it is different from floor elevation
  !elev  = !this.plane.position.up
  !pos    = object POSITION('E $!east N $!north U $!elev')

  -- get the nearest position from the plane
  !pos  = !this.plane.near(!pos)

  if(!this.pickedPoints.size() eq 1) then
    if(!this.pickedPoints[1] eq !pos) then
      !!alert.message('Wall point is in the same position as the first point')
      !this.updateWallGrid()
      return
    endif
  elseif(!this.pickedPoints.size() ge 2) then
    if(!this.pickedPoints.findFirst(!pos).set() and !pos neq !this.pickedPoints[1]) then
      !!alert.message('Cannot have Wall points at the same position.')
      !this.updateWallGrid()
      return
    elseif(!this.pickedPoints.find(!pos).set() and !this.pickedPoints.find(!pos).size() gt 1) then
      !!alert.message('Cannot have Wall points at the same position.')
      !this.updateWallGrid()
      return
    endif
  endif

  !selectedRow  = !this.neWallDefPointsGrid.getSelectedRows()
  if(!selectedRow.set()) then
    !index  = !selectedRow[1][1].real()
    !this.pickedPoints.insert(!index + 1, !pos)
  else
    !this.pickedPoints.append(!pos)
  endif

  -- clear aid for picked wall point
  !!aidNumbers.hide(!this.wallDefPointAidNum)

  -- update the grid with the wall point data
  !this.updateWallGrid()

  -- clear the array of profile objects
  !this.paths.clear()

  -- draw the path of the wall using the points defined
  !this.drawPath()

  -- update the picked points array and numeric gadget with the wall points
  !this.wallFromPoints()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateWallGrid
--
-- Description:   updates the wall points grid control
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateWallGrid()

  !gridHeading  = ARRAY()
  !gridHeading.append('Point')
  !gridHeading.append('Position')
  !gridHeading.append('Elevation')

  !posFmt     = !!distanceFmt
  !posFmt.dp  = 0

  !this.wallExplicitPoints.clear()
  do !n indices !this.pickedPoints
    !eastPos  = !this.pickedPoints[!n].east.string(!posFmt)
    !northPos = !this.pickedPoints[!n].north.string(!posFmt)
    !upPos    = !this.pickedPoints[!n].up.string(!posFmt)

    var !coordinate coordinate
    if(!coordinate.eq('XYZ')) then
      !posStr = |X $!eastPos Y $!northPos|
    else
      !posStr = |E $!eastPos N $!northPos|
    endif

    --!posStr = !this.pickedPoints[!n].string(!posFmt)
    !this.wallExplicitPoints[!n][1] = !n
    !this.wallExplicitPoints[!n][2] = !posStr
    !this.wallExplicitPoints[!n][3] = !upPos
  enddo

  using namespace  'Aveva.Pdms.Presentation'

  !nds = object NETDATASOURCE('Wall Points', !gridHeading, !this.wallExplicitPoints)
  !this.neWallDefPointsGrid.bindToDataSource(!nds)

  !this.lkWallRePosPoint.active = false
  !this.lkWallRemPoint.active   = false
  !this.txWallPtDir.active      = false
  !this.txWallPtDist.active     = false

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pickPosition
--
-- Description:   EDG pick for wall definition point
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPosition()

  -- define packet
  !prompt               = 'Pick Position'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = '!!' & !this.name() & '.updateWallPosControl(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateWallPosControl
--
-- Description:   fills the position control with the picked position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateWallPosControl(!data is EDGPOSITIONDATA)


  !tempPosition   = !this.plane.near(!data.position)

  !pickedPosition = !tempPosition
  -- Update position control gadget with the picked position
  !this.neWallPosCntrl.xyz(!pickedPosition.east, !pickedPosition.north, !pickedPosition.up)

  -- display aid at picked wall point
  if(!this.wallDefPointAidNum.set()) then
    !!aidNumbers.hide(!this.wallDefPointAidNum)
  else
    !this.wallDefPointAidNum = !!aidNumbers.add('Picked Wall Point')
  endif

  -- get the position back from the control as the xyz may be locked
  !east   = !this.neWallPosCntrl.xyz()[0]
  !north  = !this.neWallPosCntrl.xyz()[1]
  !elev   = !this.neWallPosCntrl.xyz()[2]

  !pos  = object POSITION('E $!east N $!north U $!elev')

  -- get the nearest position from the plane
  !pos  = !this.plane.near(!pos)

  AID TEXT  NUMBER $!<this.wallDefPointAidNum> '<Wall Point>' AT $!<pos>

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      rePickPosition
--
-- Description:   EDG Pick to reposition the created wall definition point
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rePickPosition()

  -- define packet
  !prompt               = 'Pick Position to re-position the selected vertex'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = '!!' & !this.name() & '.modifySelectedWallPoint(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifySelectedWallPoint
--
-- Description:   Updates the Grid control data with the modified point position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifySelectedWallPoint(!data is EDGPOSITIONDATA)

  -- This is a redundant check. Can be removed after testing
  -- Check if any row is selected
  !selectedRow  = !this.neWallDefPointsGrid.getSelectedRows()
  if(!selectedRow.unset()) then
    return
  endif

  !posFmt         = !!distanceFmt
  !posFmt.dp      = 0

  !newPos      = !this.plane.near(!data.position)
  --!newPosStr   = !newPos.string(!posFmt)

  -- Update position control gadget with the picked position
  --* using namespace  'Aveva.Pdms.Presentation'
  !rowNo   = !selectedRow[1][1].real()
  --* !this.neWallDefPointsGrid.setCellValue(!rowNo,2,!newPosStr)

  -- update the array with the new position
  !this.pickedPoints[!rowNo]           = !newPos
  --!this.wallExplicitPoints[!rowNo][2]  = !newPosStr
  !this.updateWallGrid()

  !this.paths.clear()
  !this.drawPath()

  !this.wallFromPoints()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      removeWallPoint
--
-- Description: Remove selected point
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeWallPoint()

  -- Check if any row is selected
  !selectedRow  = !this.neWallDefPointsGrid.getSelectedRows()
  if(!selectedRow.unset()) then
    return
  endif

  !rowIndex = !this.neWallDefPointsGrid.getSelectedRowTags()[1].real()
  !this.pickedPoints.remove(!rowIndex)
  handle ANY
  endhandle
  !this.pickedPoints.compress()

  !this.updateWallGrid()

  !this.paths.clear()
  !this.drawPath()

  !this.wallFromPoints()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      offsetWallPtPos
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetWallPtPos(!gadget is GADGET, !dummyAction is STRING)

  -- Check if any row is selected
  !selectedRow  = !this.neWallDefPointsGrid.getSelectedRows()
  if(!selectedRow.unset()) then
    return
  endif

  if(!gadget.name().eq('TXWALLPTDIR') and !gadget.val.dot(up).neq(0)) then
     !!alert.message('Cannot offset wall point in the elevation')
     !this.txWallPtDir.val = E
    return
  endif

  !pointIndex   = !selectedRow[1][1]
  !selectedPos  = !this.pickedPoints[$!pointIndex]
  !oldPos       = !selectedPos

  --!oldPosStr   = !selectedRow[1][2]
  --!oldPos = object POSITION(!oldPosStr)

  !offsetDir  = !this.txWallPtDir.val
  !offsetDist = !this.txWallPtDist.val

  !newPos = !oldPos.offset(!offsetDir, !offsetDist)
  !newPos = !this.plane.near(!newPos)

  -- update the position control with the new position
  !this.neWallPosCntrl.xyz(!newPos.east, !newPos.north, !newPos.up)

  -- display aid at picked wall point
  if(!this.wallDefPointAidNum.set()) then
    !!aidNumbers.hide(!this.wallDefPointAidNum)
  else
    !this.wallDefPointAidNum = !!aidNumbers.add('Picked Wall Point')
  endif

  AID TEXT  NUMBER $!<this.wallDefPointAidNum> '<Wall Point>' AT $!<newPos>

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      afterSelectChange
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .afterSelectChange(!selectionArray is ARRAY)

  -- make the gadgets for managing the points active/inactive
  if(!selectionArray.unset()) then
    !this.lkWallRePosPoint.active = false
    !this.lkWallRemPoint.active   = false
    !this.txWallPtDir.active      = false
    !this.txWallPtDist.active     = false
  else
    !this.lkWallRePosPoint.active = true
    !this.lkWallRemPoint.active   = true
    !this.txWallPtDir.active      = true
    !this.txWallPtDist.active     = true

    -- set the selected position in position control
    !selectedRow  = !this.neWallDefPointsGrid.getSelectedRows()
    !pointIndex = !selectedRow[1][1]

    !selectedPos  = !this.pickedPoints[$!pointIndex]
    handle ANY
      -- duplicate point must have been removed from the array
      -- allow the user to edit this value
      return
    endhandle

    !pos  = !selectedPos.wrt( WORLD )

    !this.neWallPosCntrl.zlock(true)
    !this.neWallPosCntrl.xyz(!pos.east, !pos.north, !pos.up)
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      beforeUpdateWallCell
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .beforeUpdateWallCell(!rowData is ARRAY)

  !newPos   = !this.returnPosition(!rowData[0])
  --!newPos = object POSITION(!rowData[0])
  handle ANY
    !!alert.message('Not a valid position')
    !rowData[3] = false
    return
  endhandle

  !newPos = !this.plane.near(!newPos)

  !index  = !rowData[1].real()
  !this.pickedPoints[!index]  = !newPos

  !posFmt         = !!distanceFmt
  !posFmt.dp      = 0

  !newPosStr   = !newPos.string(!posFmt)
  !this.wallExplicitPoints[!index][2] = !newPosStr

  !this.paths.clear()
  !this.drawPath()

  !this.wallFromPoints()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      wallLayoutComplete
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallLayoutComplete()

   !this.initWallPositionFrame()

   !!aidNumbers.remove(!this.wallDefPointAidNum)

   !this.wallDefinitionTasks(true)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      backToWallDefinitionTasks
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backToWallDefinitionTasks()

  -- initialise the frame
  !this.initWallPositionFrame()

  !this.wallExplicitPoints.clear()

  !!aidNumbers.remove(!this.wallDefPointAidNum)

  -- back to wall definition tasks frame
  !this.wallDefinitionTasks(true)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setWallPos
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setWallPos()

  !east   = !this.neWallPosCntrl.xyz()[0]
  !north  = !this.neWallPosCntrl.xyz()[1]
  !elev   = !this.neWallPosCntrl.xyz()[2]

  -- change the elevation if it is different from floor elevation
  !elev  = !this.plane.position.up

  !pos  = object POSITION('E $!east N $!north U $!elev')

  !this.neWallPosCntrl.xyz(!pos.east, !pos.north, !pos.up)
  !this.neWallPosCntrl.zlock(true)

  -- display aid at picked wall point
  if(!this.wallDefPointAidNum.set()) then
    !!aidNumbers.hide(!this.wallDefPointAidNum)
  else
    !this.wallDefPointAidNum = !!aidNumbers.add('Picked Wall Point')
  endif

  AID TEXT  NUMBER $!<this.wallDefPointAidNum> '<Wall Point>' AT $!<pos>

endmethod
 -- End of method definition

------------------------------------------------------------------------
--
-- Method:      strwellDefinition
--
-- Description: Switch to floor covering definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strwellDefinition()
  !!accTaskManager.active('accStrwellDefinition')
  !!accStrwellDefinition.strwellCreate()
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      returnPosition
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .returnPosition(!passedPosStr is STRING ) is POSITION

    !pos  = object POSITION(!passedPosStr)
    handle ANY
      -- handle the feet & inches format (3' - 3.3/8)
      !posStr = !passedPosStr.replace(' -','-').replace('- ','-')
      !pos    = object POSITION(!posStr)
      handle ANY
        -- handle the feet & inches format (3' - 3.3/8")
        !posStr = !posStr.replace('"','in')
        !pos    = object POSITION(!posStr)
        handle ANY
          -- handle the feet & inches format (E 3ft 3 3/8in N 6ft 4 3/14in)
          -- handling the east (X) component
          !eastStr1 = !posStr.before('in').trim()
          !eastStr2 = !eastStr1.after('ft').trim()
          !eastStr3 = !eastStr2.replace(' ', '.')
          !eastStr4 = !eastStr1.replace(!eastStr2,!eastStr3)
          !eastStr5 = !eastStr4.replace('ft ','''-')

          -- handling the north (Y) component
          !northStr1 = !posStr.after('in').trim()
          !northStr2 = !northStr1.after('ft').trim()
          !northStr3 = !northStr2.replace(' ', '.')
          !northStr4 = !northStr1.replace(!northStr2,!northStr3)
          !northStr5 = !northStr4.replace('ft ','''-')
          !northStr6 = !northStr5.replace('in','')

          !newPosStr = !eastStr5 + '  ' + !northStr6
          --!newPosStr  = !posStr.before('in').replace('ft ','ft-').after('ft-').before('ft')
          --!newPosStr  = !newPosStr.replace(' ','.').replace('in','')
          --!newPosStr  = !newPosStr.before('in').after('ft-')
          !pos    = object POSITION(!newPosStr)
        endhandle
      endhandle
    endhandle

    return !pos

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteSelectedWall()
--
-- Description: delete the selected CTWALL
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteSelectedWall()

  !element = !!ce
  -- Delete current element
  if (!element.type neq 'CTWALL') then
    !!alert.error('Navigate to a wall element and try again')
    return
  else
    if(!!accDeleteManager.deleteElement(!element).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
    endif
  endif

endmethod
