  -- Initialise Variables

  -- Make task pane active
  if(!active) then
    !this.currentTask.evaluate()
    !this.currentTask           = object BLOCK('!this.blevelTasks(false)')
    !this.refreshTask           = object BLOCK('!this.blevelTasks(true)')
    !this.formTitle             = !this.blevelRText & ' Tasks'

  -- Make task pane inactive
  else
    --# Hiding BLEVEL - any actions that need to be performed on making the task pane inactive
  endif

  -- Show task pane
  !this.blevelTaskPane.visible  = !active
  !this.updateGadgets()
