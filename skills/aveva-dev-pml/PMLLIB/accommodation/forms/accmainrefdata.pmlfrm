  -- Initialise Variable
  !this.bbGModhapeDef.val       = !shapeDefinition.description

  -- Update bblock geometry
  !this.bblockGeomUpdate(!shapeDefinition)

endmethod

------------------------------------------------------------------------
--
-- Method:      bblockGeomUpdate
--
-- Description: Update with bblock geometry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .bblockGeomUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  !this.currentBBlock.position(!shapeDefinition.profile.position)
  !this.currentBBlock.outerLoop = !shapeDefinition.profile
  !this.currentBBlock.draw()

  --update position control gadget with new origin position
  !position                     = !this.currentBBlock.position.wrt(World)
  !this.bbPosition.xyz(!position.east, !position.north, !position.up)

endmethod

