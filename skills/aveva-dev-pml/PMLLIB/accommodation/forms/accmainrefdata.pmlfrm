------------------------------------------------------------------------

define method .selectTasks(!type is STRING)

  -- Initialise Variables

  -- Element type of selected/ce element
  --!type = !!ce.type

  if(!type.eq('BBLOCK')) then
    !this.bblockTasks(true)
  elseif (!type.eq('BLEVEL')) then
    !this.blevelTasks(true)
  endif

