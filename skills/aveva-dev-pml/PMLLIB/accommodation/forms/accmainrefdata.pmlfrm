------------------------------------------------------------------------
--
-- Method:      setBBPosition
--
-- Description:
--   Set new position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setBBPosition()

  -- Initialise Variables

  --get array of positions from positioning control
  !posArray       = !this.bbPosition.xyz()

  --set position object with positions, wrt world
  !east  = !posArray[0]
  !north = !posArray[1]
  !up    = !posArray[2]

  !position   = object POSITION('E $!east N $!north U $!up wrt /*')

  --set current bblock object position to position object
  !this.currentBBlock.position(!position)

endmethod
-- End of method

