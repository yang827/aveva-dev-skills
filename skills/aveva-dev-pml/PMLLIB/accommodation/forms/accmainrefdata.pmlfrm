------------------------------------------------------------------------
--
-- Method:      multiCreateTasks
--
-- Description: Set BBLOCK tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .multiCreateTasks(!active is BOOLEAN, !type is STRING)

  -- Initialise Variables
  if(undefined(!!accDataLoad) and !active) then
    pml reload form !!accDataLoad
  endif

  -- Make task pane active
  if(!active) then
    !this.currentTask.evaluate()
    !currentTask                    = '!this.multiCreateTasks(false,''' & !type & ''')'
    !this.currentTask               = object BLOCK(!currentTask)
    !this.refreshTask               = object BLOCK('!this.mainTasks(TRUE)')
    !this.formTitle                 = 'Multi Create Tasks'

    -- Multiple building block creation
    if(!type.eq('BBLOCK')) then
      !this.formTitle               = 'Multi Create - ' & !this.bblockRText
      !this.mCSVName.val            = '%PDMSUSER%\buildings.csv'
      !this.mCrtTskCSV.callback     = '!!accDataLoad.loadBBlockCSV(!this.mCSVName.val)'
      !this.mCrtTskUpd.callback     = '!!accDataLoad.updateBBlocks()'
      !this.mCrtTskVfy.callback     = '!!accDataLoad.verifyBBlockData()'

    -- Multiple level creation
    elseif (!type.eq('BLEVEL')) then
      !this.formTitle               = 'Multi Create - ' & !this.blevelRText
      !this.mCSVName.val            = '%PDMSUSER%\levels.csv'
      !this.mCrtTskCSV.callback     = '!!accDataLoad.loadBLevelCSV(!this.mCSVName.val)'
      !this.mCrtTskUpd.callback     = '!!accDataLoad.updateBLevels()'
      !this.mCrtTskVfy.callback     = '!!accDataLoad.verifyBLevelData()'

    -- Multiple room creation
    elseif (!type.eq('ROOM')) then
      !this.formTitle               = 'Multi Create - ' & !this.roomRText
      !this.mCSVName.val            = '%PDMSUSER%\rooms.csv'
      !this.mCrtTskCSV.callback     = '!!accDataLoad.loadRoomCSV(!this.mCSVName.val)'
      !this.mCrtTskUpd.callback     = '!!accDataLoad.updateRooms()'
      !this.mCrtTskVfy.callback     = '!!accDataLoad.verifyRoomData()'

    endif

    -- Show data load form
    !!accDataLoad.initialise(!type)
    SHOW !!accDataLoad

  -- Hide data load form
  else
    if(defined(!!accDataLoad)) then
      HIDE !!accDataLoad
    endif

  endif

  -- Show/Hide task pane
  !this.multiCrtPane.visible  = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      bblockDefinitionPane
--
-- Description: BBLOCK create tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .bblockDefinitionPane(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then
    !this.currentTask.evaluate()
    !this.currentTask           = object BLOCK('!this.bblockDefinitionPane(false)')
    !this.refreshTask           = object BLOCK('!this.bblockDefinitionPane(true)')
    !this.currentBBlock.draw()

  -- Make task pane inactive
  else
    !this.currentBBlock.tidy()
  endif

  -- Show task pane
  !this.bblockEditPane.visible  = !active

endmethod
-- End of method

