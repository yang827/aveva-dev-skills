------------------------------------------------------------------------
--
-- Method:      bblockGeometryUpdate
--
-- Description: Update with returned data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .bblockGeometryUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  !this.bblockCrtShapeDef.val   = !shapeDefinition.description

  -- Update bblock geometry
  !this.bblockGeomUpdate(!shapeDefinition)

endmethod

