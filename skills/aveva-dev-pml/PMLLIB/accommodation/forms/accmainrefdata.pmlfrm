------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Set form members for when form title changes in other methods
  !this.bblockRText             = !!accConfig.typeDescription ( 'BBLOCK' )
  !this.blevelRText             = !!accConfig.typeDescription ( 'BLEVEL' )
  !this.roomRText               = !!accConfig.typeDescription ( 'ROOM' )

  -- Replacement Text (set using configuration information)
  !bblockRText                  = !this.bblockRText
  !blevelRText                  = !this.blevelRText
  !roomRText                    = !this.roomRText

  -- BBlock Tasks
  !this.bblockTaskCrt.val       = 'Create'
  !this.bblockTaskMod.val       = 'Modify'
  !this.bblockTaskDelete.val    = 'Delete'

  -- BLevel Tasks
  !this.blevelTaskCrt.val       = 'Create'
  !this.blevelTaskMod.val       = 'Modify'
  !this.blevelTaskDeletes.val   = 'Delete'
  !this.blDelBLevel.tag         = 'Delete ' & !blevelRText

  --
  !this.bblockTaskSel.tag       = !bblockRText & ' Tasks'
  !this.blevelTaskSel.tag       = !blevelRText & ' Tasks'
  !this.roomTaskSel.tag         = !roomRText & ' Tasks'

  -- BBlock tags
  !this.bblockCrtShape.tag      = 'Define ' & !bblockRText & ' geometry:'
  !this.bbCrtAcceptBB.tag       = 'Create ' & !bblockRText
  !this.bbModBackBB.tag         = 'Back to ' & !bblockRText & ' tasks'
  !this.bbCrtBackBB.tag         = 'Back to ' & !bblockRText & ' tasks'

  -- BLevel tags
  !this.blevelCrtShape.tag      = 'Define ' & !blevelRText & ' geometry:'
  !this.blCrtAcceptBL.tag       = 'Create ' & !blevelRText
  !this.blCrtBackBL.tag         = 'Back to ' & !blevelRText & ' tasks'
  !this.blCrtBackBB.tag         = 'Back to ' & !bblockRText & ' tasks'
  !this.blModBackBL.tag         = 'Back to ' & !blevelRText & ' tasks'
  !this.blModBackBB.tag         = 'Back to ' & !bblockRText & ' tasks'

  !this.blevelNAngle.tag        = 'Angle from ' & !bblockRText & ' Y axis:'
  !this.blXYLocation.val        = 'XY Offset from ' & !bblockRText
  !this.blevelCrtShapeO.tag     = 'Use owning ' & !bblockRText & ' geometry'

  -- BBlock Tasks
  !this.bbCrtBBlock.tag           = !bblockRText
  !this.bbCrtBLevel.tag           = !blevelRText

  !this.bbModBBlock.tag         = !bblockRText & ' Definition'
  !this.bbGeomBBlock.tag        = !bblockRText & ' Geometry'

  !this.bbDelBBlock.tag         = !bblockRText

  -- BLevel Tasks
  !this.blCrtBLevel.tag         = !blevelRText

  !this.blModBLevel.tag         = !blevelRText & ' Definition'
  !this.blGeomBLevel.tag        = !blevelRText & ' Geometry'

  !this.blTskBBlock.tag         = 'Back to ' & !bblockRText & ' tasks'

  !this.bbGBackBB.tag           = 'Back to ' & !bblockRText & ' tasks'
  !this.blGModMain.tag          = 'Back to ' & !blevelRText & ' tasks'

  -- Layout tags
  !this.layoutTaskSel.tag       = 'Layout Tasks'

  --update position control
  !posFormat = !!accConfig.positionformat

  -- Set to XYZ format
  if(!posFormat.eq('XYZ')) then
    !this.bbPosition.xyzFormat()

  -- Set to ENU format
  elseif (!posFormat.eq('ENU')) then
    !this.bbPosition.enuFormat()

  -- Set to Grid format
  -- no need to Check for grid again
  elseif (!posFormat.eq('GRID')) then
        !this.bbPosition.gridFormat()
  endif


endmethod
-- End of method

