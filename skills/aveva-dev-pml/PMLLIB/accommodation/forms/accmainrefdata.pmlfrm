------------------------------------------------------------------------
--
-- Method:      showBrowser
--
-- Description: Show browser
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showBrowser()
import 'pmlfilebrowser'
handle ANY
endhandle

  -- Define file browser
  using namespace 'Aveva.Pdms.Presentation'
  !browser        = object PMLFILEBROWSER('OPEN')

  -- Initial directory
  !pathname       = '%PDMSUSER%'
  -- Initial filename
  !filename       = ''
  -- Form title
  !title          = 'Open CSV/Excel file'
  -- Exists flag (only allows existing filenames to be given)
  !exists         = true
  -- File filters
  !filters        = 'CSV files (*.csv)|*.csv|Excel files (*.xls)|*.xls|Excel or CSV files (*.xls, *.csv)|*.xls;*.csv'
  -- Filter index (which of the defined filters are selected by default)
  !fIndex         = 3

  -- Show file browser
  !browser.show(!pathname, !filename, !title, !exists, !filters, !fIndex)

  -- Selected file
  if (!browser.file().empty().not() ) then
    !this.mCSVName.val  = !browser.file()
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      fileValidate
--
-- Description: validate the file name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fileValidate( !fileVal is GADGET, !action is STRING )
  if( !fileVal.val.empty() ) then
     return error 1 'File Name should not be empty'
  else
       if (!fileVal.val.upcase().after('.').neq('CSV') or !fileVal.val.upcase().after('.').neq('XLS')) then
            return error 2 'File should be of type CSV or XLS'
       else
            !spreadSheet = object FILE(!fileVal.val)
            if (!spreadSheet.exists().not() ) then
                return error 3 'File does not exist'
            endif
      endif
  endif
endmethod
------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: updateGadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()
  !this.blevelTaskSel.active  = !!accNavigator.bblock().badref().not()
  !this.roomTaskSel.active    = !!accNavigator.blevel().badref().not()
  !this.layoutTaskSel.active  = !!accNavigator.bblock().badref().not()
  !this.visTaskSel.active     = !!accNavigator.bblock().badref().not()
  !this.bbCrtBLevel.active    = !!accNavigator.bblock().badref().not()
  !this.bbModBBlock.active    = !!accNavigator.bblock().badref().not()
  !this.bbGeomBBlock.active   = !!accNavigator.bblock().badref().not()
  !this.bbDelBBlock.active    = !!accNavigator.bblock().badref().not()

  !this.blCrtBLevel.active    = !!accNavigator.bblock().badref().not()
  !this.blModBLevel.active    = !!accNavigator.blevel().badref().not()
  !this.blGeomBLevel.active   = !!accNavigator.blevel().badref().not()
  !this.blDelBLevel.active    = !!accNavigator.blevel().badref().not()

endmethod
------------------------------------------------------------------------
--
-- Method:      pickPosition
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPosition()

  -- Initialise Variables
  !prompt               = 'Pick position'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'bblock position pick'
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.position(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method
-----------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set bblock to picked position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!data is EDGPOSITIONDATA)

  -- Initialise Variables

  !position = !data.position.wrt(World)

  -- Update pos control gadget

  !this.bbPosition.xyz(!position.east, !position.north, !position.up)

  --set position of bblock from pos control values
  !this.setBBPosition()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:          validateTextGadgets
--
-- Description:     validate the value entered in the text gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateTextGadgets(!gadget is GADGET, !oldValue is REAL )

  if(!gadget.val.unset()) then
    !gadget.val = !oldValue
    !gadget.refresh()

  elseif(!gadget.name().match('HEIGHT').gt(0)) then
    if(!gadget.val.lt(0)) then
      !tag  = !gadget.tag.replace(':','')
      !!alert.error('$!tag cannot be less than zero')
      !gadget.val = !oldValue
      !gadget.refresh()
      return
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:          .licenceCheck
--
-- Description:     checks for a valid Room design licence
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if Invalid Seat
------------------------------------------------------------------------
define method .licenceCheck() is BOOLEAN
	!bool = FALSE
 	!roomDesignExist   = object MDRLICENCEMANAGER()
  !status = !roomDesignExist.getLicence('ROOMDESIGN')
  !error = !roomDesignExist.lastError()
  if (!status lt 0) then
  	!!alert.error('$!error')
  	!bool = TRUE
 	endif
 	return !bool
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        accUnitsFormats
--
-- Description:   Set unit global format objects specific to room design
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accUnitsFormats()

  -- Convert area units to inch and metric units to metres
  -- set up area and volume formats
  !!accAreaFmt = !!areaFmt
  !!accVolFmt  = !!volumeFmt

  if( !!isImperialLength('DIST') ) then
    -- set square inch format
    !!accAreaFmt.dp    = 0
    !!accAreaFmt.units = 'inch'
    !!accAreaFmt.label = ' sq in'
    -- set cubic inch format
    !!accVolFmt.dp     = 0
    !!accVolFmt.units  = 'inch'
    !!accVolFmt.label  = ' cu in'
  else
    -- set square metre format
    !!accAreaFmt.dp    = 3
    !!accAreaFmt.units = 'metre'
    !!accAreaFmt.label = ' sq metre'
    -- set cubic metre format
    !!accVolFmt.dp     = 3
    !!accVolFmt.units  = 'metre'
    !!accVolFmt.label  = ' cu metre'
  endif

endmethod
-- End of method definition
