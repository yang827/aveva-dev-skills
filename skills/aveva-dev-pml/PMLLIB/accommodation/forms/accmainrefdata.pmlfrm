  -- Make task pane active
  if(!active) then

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.bblockMGeometry(false)')
    !this.refreshTask         = object BLOCK('!this.bblockMGeometry(true)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify ' & !this.bblockRText & ' Geometry'

    -- Draw
    !this.currentBBlock.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)
    !this.currentBBlock.draw()

  -- Actions when task pane is made inactive
  else
    !this.currentBBlock.tidy()
  endif

  -- Show/hide task pane
  !this.bbModGeometry.visible = !active

