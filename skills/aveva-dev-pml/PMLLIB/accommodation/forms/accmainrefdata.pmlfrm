------------------------------------------------------------------------
--
-- Method:      blevelCreate
--
-- Description: Setup blevel to create a blevel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .blevelCreate()

  -- Initialise Variables
  !this.bblock                    = !!accNavigator.bblock()
  if(!this.bblock.badref())then
    !!alert.warning('The active BBlock Selection in the room design navigator is invalid. Can not Create Floor elevation.')
    !this.mainTasks(true)
    return
  endif
  !this.currentBBlock             = object DBEBBLOCK(!this.bblock)
  !this.currentBLevel             = object DBEBLEVEL()
  !this.currentBLevel.initialise(!this.bblock)

  -- Form title
  !this.formTitle                 = 'Create ' & !this.blevelRText

  -- Edit panel title
  !this.blEditTitle.val           = 'New ' & !this.blevelRText & ' for ' & !this.currentBBlock.dbElement.namn
  !this.blevelCrtShapeDef.val     = 'None currently defined'

  -- Set aid numbers
  !this.currentBLevel.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  !this.currentBLevel.dFlrHeight  = !!accConfig.flrHeight
  !this.currentBLevel.dClnHeight  = !!accConfig.clnHeight

  -- Update BBlock gadgets
  !this.updateBLevelAttributes()

  -- Show creation panel
  !this.blevelCrtPane.visible     = true
  !this.blevelModPane.visible     = false

  -- Set defaults
  !this.shapeflag                 = false

  -- Set BLevel copy owning shape
  !this.useBBlockGeometry()

  -- Set edit pane
  !this.blevelDefinitionPane(true)

endmethod
-- End of method

