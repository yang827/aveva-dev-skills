------------------------------------------------------------------------

define method .updateBLevelData()

  -- Initialise Variables
  if(!this.blevelName.val.set()) then
    !this.currentBLevel.name      = !this.blevelName.val
  endif

  !this.currentBLevel.description = !this.blevelDescription.val
  !this.currentBLevel.function    = !this.blevelFunction.val
  !this.currentBLevel.area        = !this.blevelArea.val
  !this.currentBLevel.dFlrHeight  = !this.blevelFlrHeight.val
  !this.currentBLevel.dClnHeight  = !this.blevelClnHeight.val

endmethod

------------------------------------------------------------------------
--
-- Method:      bblockGeometry
--
-- Description: Define geometry for BBLOCK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .bblockGeometry()

  -- Define data to pass to shape definition form
  !plane  = !this.currentBBlock.plane
  !shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)

  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form for return to bblock creation
  -- Information for form is:
  --   Calling form
  --   Form title
  --   Apply tag (Test for "apply" button)
  --   Action on completion, method name only, method must be in format
  --      .methodName(<SHAPEDEFINITION>)
  --   Default shape, should be at least pos and ori of the plane the
  --   shape is to be mapped onto.
  !!shapeDefinitionEditor.setup(!this, 'Define ' & !this.bblockRText & ' Boundary', 'Define Boundary', 'bblockGeometryUpdate', !shape)

endmethod

------------------------------------------------------------------------
--
-- Method:      bblockModGeometry
--
-- Description: Modify geometry for BBLOCK (needs to pass current geometry to shape editor)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .bblockModGeometry()

  -- Define data to pass to shape definition form
  --!plane  = !this.currentBBlock.plane
  --!shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)
  --
  ---- Show the form
  --!!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form for return to bblock creation
  -- Information for form is:
  --   Calling form
  --   Form title
  --   Apply tag (Test for "apply" button)
  --   Action on completion, method name only, method must be in format
  --      .methodName(<SHAPEDEFINITION>)
  --   Default shape, should be at least pos and ori of the plane the
  --   shape is to be mapped onto.
  --!!shapeDefinitionEditor.setup(!this, 'Define Building Block Boundary', 'Define Boundary', 'bblockModGeometryUpdate', !shape)

  -- use the accProfileEdit function
  if(defined(!!dbeProfileEdit)) then
    !!dbeProfileEdit.close()
  endif

  -- Check if there is a boundary defined
  if(!this.currentBBlock.outerLoop.set()) then
  !!accProfileEdit(!this.bblock)
  else
    !this.bblockGeometry()
  endif

endmethod
