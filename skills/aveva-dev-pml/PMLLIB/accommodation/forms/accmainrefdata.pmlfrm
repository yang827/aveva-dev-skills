------------------------------------------------------------------------
--
-- Method:      useBBlockGeometry
--
-- Description: Use owning boundary definition (if there is one)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useBBlockGeometry()

  -- Get gadget setting
  !useOwner                       =!this.blevelCrtShapeO.val

  -- Make shape definition inactive
  !this.blevelCrtShape.active     = !useOwner.not()

  -- Get owning geometry
  if(!useOwner) then

    -- Check if there is a boundary defined
    if(!this.currentBBlock.outerLoop.set()) then
      !plane          = !this.currentBLevel.plane
      !profile        = object PROFILE(!plane.position, !plane.orientation, !this.currentBBlock.outerLoop.edges())
      !shape          = object SHAPEDEFINITION(!plane.position, !plane.orientation)
      !shape.description  = 'Derived from owning ' & !this.bblockRText
      !shape.profile      = !profile
      !this.blevelGeometryUpdate(!shape)
    endif
  else
    !this.currentBLevel.tidy()
  endif

endmethod
-- End of method

