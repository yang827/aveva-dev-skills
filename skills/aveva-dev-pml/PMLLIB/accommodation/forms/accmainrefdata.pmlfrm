--
-- File:            accmainrefdata.pmlfrm
--   Type:          Form Definition
--   Group:         Accommodation Application
--
--     Keyword:     Main Reference
--   Module:        design
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Wed Oct 25 00:00:00 BST 2006
--
--
-- Description:
--   Main Reference Data task pane
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accMainRefData()                 -                   Constructor
--  accUnitsFormats()                -                   Set unit global format objects specific to room design
--  bblockCreate()                   -                   Setup BBLOCK edit form to create a new BBLOCK
--  bblockDefinitionPane(BOOLEAN)    -                   BBLOCK create tasks
--  bblockDelete()                   -
--  bblockDeleteTasks(BOOLEAN)       -                   BBLOCK delete tasks
--  bblockGeomUpdate(SHAPEDEFINITION) -                   Update with BBLOCK geometry
--  bblockGeometry()                 -                   Define geometry for BBLOCK
--  bblockGeometryUpdate(SHAPEDEFINITION) -                   Update with returned data
--  bblockHeight(GADGET,STRING)      -                   Set height of BBLOCK element
--  bblockMGeometry()                -                   Switch to geometry modification pane for current element
--  bblockMGeometry(BOOLEAN)         -                   Switch to geometry modification pane
--  bblockMGeometry(DBREF)           -                   Switch to geometry modification pane for specified element
--  bblockModGeometry()              -                   Modify geometry for BBLOCK (needs to pass current geometry to shape editor)
--  bblockModGeometryUpdate(SHAPEDEFINITION) -                   Update with returned data
--  bblockModify()                   BOOLEAN             Setup BBLOCK edit form to modify a bblock from current navigator
--  bblockModify(DBREF)              BOOLEAN             Setup BBLOCK edit form to modify a bblock
--  bblockNAngle(GADGET,STRING)      -                   Set rotate of BBLOCK element
--  bblockTasks(BOOLEAN)             -                   Set BBLOCK tasks
--  blevelCreate()                   -                   Setup blevel edit form to create a blevel
--  blevelCreateTasks(BOOLEAN)       -                   BLEVEL create tasks
--  blevelDefinitionPane(BOOLEAN)    -                   BLEVEL create tasks
--  blevelElevation()                -                   Set elevation of level
--  blevelGeomUpdate(SHAPEDEFINITION) -                   Update with blevel geometry
--  blevelGeometry()                 -                   Define geometry for BLevel
--  blevelGeometryUpdate(SHAPEDEFINITION) -                   Update with returned data
--  blevelHeight(GADGET,STRING)      -                   Set height of blevel element
--  blevelMGeometry()                -                   Switch to geometry modification pane for current element
--  blevelMGeometry(BOOLEAN)         -                   Switch to geometry modification pane
--  blevelMGeometry(DBREF)           -                   Switch to geometry modification pane for specified element
--  blevelModGeometry()              -                   Modify geometry for BLEVEL (needs to pass current geometry to shape editor)
--  blevelModGeometryUpdate(SHAPEDEFINITION) -                   Update with returned data
--  blevelModify()                   BOOLEAN             Setup blevel edit form to modify a blevel from current navigator
--  blevelModify(DBREF)              BOOLEAN             Setup blevel edit form to modify a blevel
--  blevelModifyTasks(BOOLEAN)       -                   BLEVEL edit tasks
--  blevelNAngle(GADGET,STRING)      -                   Set rotate of blevel element
--  blevelOffset()                   -                   Set xyoffset of level
--  blevelTasks(BOOLEAN)             -                   Set BLEVEL tasks
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  createBBlock()                   -
--  createBLevel()                   -                   Create BLEVEL
--  deleteBBlock()                   -
--  deleteBLevel()                   -
--  dummy()                          -                   Dummy method for unset
--  fileValidate(GADGET,STRING)      -
--  initialise()                     -                   Initialise form.
--  licenceCheck()                   BOOLEAN             checks for a valid Room design licence
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  modifyBBlock()                   -                   Modify BBLOCK (write modified values to DB)
--  modifyBLevel()                   -                   Modify BLEVEL (write modified values to DB)
--  modifyGeomBBlock()               -                   Modify BBLOCK Geometry (write modified values to DB)
--  modifyGeomBLevel()               -                   Modify BLEVEL Geometry (write modified values to DB)
--  multiCreateTasks(BOOLEAN,STRING) -                   Set BBLOCK tasks
--  pickPosition()                   -                   Setup EDG pick event for picking position
--  position(EDGPOSITIONDATA)        -                   Set bblock to picked position
--  refresh()                        -                   Refresh form from navigator.
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  selectTasks(STRING)              -                   Select tasks for element
--  setBBPosition()                  -                   Set new position
--  showBrowser()                    -                   Show browser
--  taskPaneLayout()                 -                   Switch to layout task pane
--  taskPanelRoom()                  -                   Switch to room definition
--  tidy()                           -                   Tidy graphics
--  track()                          -                   Track
--  undoAction(STRING)               -                   Action to be carried out on an undo
--  updateBBlockAttributes()         -                   Update BBlock gadgets with object data
--  updateBBlockData()               -                   Update current BBlock data with data
--  updateBLevelAttributes()         -                   Update BLevel gadgets with object data
--  updateBLevelData()               -
--  updateGadgets()                  -                   updateGadgets
--  useBBlockGeometry()              -                   Use owning boundary definition (if there is one)
--  validateTextGadgets(GADGET,REAL) -
--
------------------------------------------------------------------------

-- Import DLL
import 'PositionControl'
handle ANY
endhandle

setup form !!accMainRefData dialog docking right

  --track 'DBCHANGED' call '!this.track()'
  --track 'DESICE'    call '!this.track()'

  !this.formTitle     = 'Room Design Main Data'
  !this.iconTitle     = 'Acc Data'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.tidy()'
  !this.formRevision  = ' $Revision$ '
  !this.autoScroll    = true

  -- Current hierarchy
  paragraph .currentOwner                   anchor top + left + right         at x0.5                   ymax                width 30 lines 1

  -- Main Task Panel
  frame .mainTaskPane panel                 anchor top + left + right         at x0                     ymax.currentOwner

    paragraph .mainTaskHeader               anchor top + left + right         at x0.5                   ymax                width 30 lines 1
    line .mainTaskPaneL1                    anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .bblockTaskSel   linkLabel 'Building Block Tasks'                  at x2                     ymax                callback '!this.selectTasks(|BBLOCK|)'
    button .blevelTaskSel   linkLabel 'Floor Elevation Tasks'                 at xmin                   ymax                callback '!this.selectTasks(|BLEVEL|)'

    paragraph .layoutTasks                                                    at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskPaneL2                    anchor top + left + right         at xmin                   ymax                horizontal width 32

    button .layoutTaskSel   linkLabel 'Layout (Rooms & Corridors)'            at x2                     ymax                callback '!this.taskPaneLayout()'
    button .roomTaskSel     linkLabel 'ROOM Definition'                       at xmin                   ymax                callback '!this.taskPanelRoom()'
    --button .refTaskSel      linkLabel 'Reference Data'                        at xmin                   ymax

    paragraph .supportingTasks                                                at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskPaneL3                    anchor top + left + right         at xmin                   ymax                horizontal width 32

    button .visTaskSel      linkLabel 'Visualization'                         at x2                     ymax                callback 'show !!accViewSetup'
    --button .copyTaskSel     linkLabel 'Copying'                               at xmin                   ymax
    --button .reportTaskSel   linkLabel 'Standard Reports'                      at xmin                   ymax

  exit

  -- BBLOCK Task Panel
  frame .bblockTaskPane panel               anchor top + left + right         at x0                     ymax.currentOwner

    -- Create options
    paragraph .bblockTaskCrt                                                  at x0.5                   ymax                width 30 lines 1
    line .bblockTaskPaneL1                  anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .bbCrtBBlock   linkLabel 'BBLOCK       '                           at x2                     ymax                callback '!this.bblockCreate()'
    --button .bbCrtMBBlock  linkLabel 'Multiple BBLOCKs'                        at xmin                   ymax                callback '!this.multiCreateTasks(true,''BBLOCK'')'
    button .bbCrtBLevel   linkLabel 'BLEVEL       '                           at xmin                   ymax                callback '!this.blevelCreate()'
    --button .bbCrtMBLevel  linkLabel 'Multiple BLEVEL'                         at xmin                   ymax                callback '!this.multiCreateTasks(true,''BLEVEL'')'

    -- Modify options
    paragraph .bblockTaskMod                                                  at x0.5                   ymax+0.5            width 30 lines 1
    line .bblockTaskPaneL2                  anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .bbModBBlock   linkLabel 'BBLOCK Definition'                       at x2                     ymax                callback '!this.bblockModify()'
    button .bbGeomBBlock  linkLabel 'BBLOCK Geometry'                         at xmin                   ymax                callback '!this.bblockMGeometry()'

    -- Action options
    paragraph .bblockTaskDelete                                               at x0.5                   ymax+0.5            width 30 lines 1
    line .bblockTaskPaneL3                  anchor top + left + right         at xmin                   ymax                horizontal width 32

    --button .bbCopyBBlock  linkLabel 'Copy BBLOCK'                             at x2                     ymax                callback '!this.copy(!this.bblock)'
    button .bbDelBBlock   linkLabel 'Delete BBLOCK'                           at x2                     ymax                callback '!this.deleteBBlock()'

    paragraph .bbCrtBackIcon                anchor top + left                 at x0.5                   ymax+0.5            pixmap width 15 height 15
    button .bbTskMain     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.mainTasks(true)'

  exit

  -- BLEVEL Task Panel
  frame .blevelTaskPane panel               anchor top + left + right         at x0                     ymax.currentOwner

    -- Create options
    paragraph .blevelTaskCrt                                                  at x0.5                   ymax                width 30 lines 1
    line .blevelTaskPaneL1                  anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .blCrtBLevel   linkLabel 'BLEVEL       '                           at x2                     ymax                callback '!this.blevelCreate()' width 20
    --button .blCrtMBLevel  linkLabel 'Multiple BLEVELs'                        at xmin                   ymax                callback '!this.multiCreateTasks(true,''BLEVEL'')' width 20
    --button .blCrtMRoom    linkLabel 'Multiple ROOMs'                          at xmin                   ymax                callback '!this.multiCreateTasks(true,''ROOM'')' width 20

    -- Modify options
    paragraph .blevelTaskMod                                                  at x0.5                   ymax+0.5            width 30 lines 1
    line .blevelTaskPaneL2                  anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .blModBLevel   linkLabel 'BLEVEL Definition'                       at x2                     ymax                callback '!this.blevelModify()' width 20
    button .blGeomBLevel  linkLabel 'BLEVEL Geometry'                         at xmin                   ymax                callback '!this.blevelMGeometry()' width 20

    -- Action options
    paragraph .blevelTaskDeletes                                              at x0.5                   ymax+0.5            width 30 lines 1
    line .blevelTaskPaneL3                  anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .blDelBLevel   linkLabel 'Delete BLEVEL   '                        at x2                     ymax                callback '!this.deleteBLevel()' width 20
    --button .blCopyBLevel  linkLabel 'Copy BLEVEL  '                           at x2                     ymax                callback '!this.copy(!this.blevel)'

    paragraph .blTskBackBBIcon              anchor top + left                 at x0                     ymax+0.5            pixmap width 15 height 15
    button .blTskBBlock   linkLabel 'Back to Building Block tasks'            at xmax+1                 ymin                callback '!this.bblockTasks(true)' width 20
    paragraph .blTskBackMainIcon            anchor top + left                 at x0                     ymax                pixmap width 15 height 15
    button .blTskMain     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.mainTasks(true)' width 20

  exit

  -- Multiple creation pane for elements
  frame .multiCrtPane panel                 anchor top + left + right         at x0                     ymax.currentOwner

    paragraph .mCrtTitle                    anchor top + left + right         at x0.5                   ymax                text 'Actions'
    line .mCrtPaneL1                        anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mCrtTskCSV   linkLabel 'Load CSV file'                            at x2                     ymax+0.2            callback '!!accDataLoad.loadBBlockCSV()' width 8
    text .mCSVName                          anchor top + left + right         at xmax+0.5               ymin                callback '' width 16  is STRING
    button .mCSVBrowse                      anchor top + right                at xmax+0.5               ymin                callback '' pixmap width 16 height 16
    button .mCrtTskUpd   linkLabel 'Update DB with table Data'                at x2                     ymax+0.1            callback '!!accDataLoad.updateBBlocks()'
    button .mCrtTskVfy   linkLabel 'Verify table Data'                        at x2                     ymax                callback '!!accDataLoad.verifyBBlockData()'

    paragraph .mCrtBackIcon                 anchor top + left                 at x0                     ymax+0.5            pixmap width 15 height 15
    button .mCrtTsk      linkLabel 'Return to Building Block tasks'           at xmax+1                 ymin                callback '!this.bblockTasks(true)'

  exit

  -- BBLOCK Definition
  frame .bblockEditPane panel               anchor top + left + right         at x0                     ymax.currentOwner

    paragraph .bbEditTitle                  anchor top + left + right         at x0.5                   ymax                width 30 lines 1
    line .bblockEditPaneL1                  anchor top + left + right         at xmin                   ymax                horizontal width 32
    text .bblockName  'Name:'  tagwidth 9   anchor top + left + right         at x2                     ymax+0.2            callback '!this.checkName(!this.bblockName, !this.currentBBlock.name)' width 20 is STRING
    path down
    halign right
    text .bblockDescription 'Description:'  tagwidth 9 anchor top + left + right                                            callback '' width 20 is STRING
    text .bblockFunction    'Function:'     tagwidth 9 anchor top + left + right                                            callback '' width 20 is STRING
    numericinput .bblockArea 'Area:'        tagwidth 9 anchor top + left      at xmin                   ymax+0.2            callback '' range 0 10000 ndp 0 width 4

    -- Positioning
    paragraph .bbLocation                   anchor top + left + right         at x0.5                   ymax+0.2            text 'Location:'
    line .bblockEditPaneL2                  anchor top + left + right         at xmin                   ymax                horizontal width 32

    -- Angle from Y axis
    numericinput .bblockNAngle 'Angle from Y axis:' tagwidth 12 anchor top + left  at x2                 ymax+0.2            callback '!this.bblockNAngle('  range 180 -180 ndp 0 width 4

    -- Create a frame to hold PMLNet Positioning Control
    --paragraph .bbPositionTag             anchor top + left + right            at x0.5                   ymax                text 'Position:'
    button .pickPosition linkLabel 'Position...'    anchor top + left + right   at x2                     ymax           callback '!this.pickPosition()' width 10
    frame .bbPositionControl panel   anchor top + left + right                at x0                     ymax                width 32 heig 5
      container .bbEditPosNetFrame PMLNetCONTROL 'NET' dock fill
    exit

    -- Modification data specific to a bblock
    frame .bblockModPane panel                anchor top + left + right       at x0                     ymax

      -- Information
      frame .bblockInformation FoldUpPanel 'Information'           anchor top + left + right   at x0                     ymax           width 32

        text .bblockare   'Area:'    tagwidth 16               anchor top + left + right   at x0.5                   ymax                 width 11 is REAL format !!accAreaFmt
        text .bblockvol   'Volume:'  tagwidth 16             anchor top + left + right   at x0.5                     ymax+0.5             width 11 is REAL format !!accVolFmt
      exit

      -- Apply Changes
      paragraph .bbModAcceptBBIcon              anchor top + left             at x0                     ymax+0.2            pixmap width 16 height 16
      button .bbModAcceptBB  linkLabel 'Apply Changes' anchor top + left      at xmax+0.5               ymin                callback '!this.modifyBBlock()' width 10

      -- Discard Changes
      paragraph .bbModDiscardBBIcon             anchor top + right            at xmax+4                 ymin                pixmap width 16 height 16
      button .bbModDiscardBB linkLabel 'Discard Changes' anchor top + right   at xmax+0.5               ymin                callback '!this.bblockModify()' width 10

      paragraph .bbModBackBBIcon             anchor top + left                at x0                     ymax+0.5            pixmap width 15 height 15
      button .bbModBackBB linkLabel  'Return to Building Block tasks'         at xmax+1                 ymin                callback '!this.bblockTasks(true)'

    exit

    -- Creation data specific to a BBlock
    frame .bblockCrtPane panel              anchor top + left + right         at xmin.bblockModPane     ymin.bblockModPane

      paragraph .bblockCrtGeom              anchor top + left + right         at x0.5                   ymax                text 'Geometry'
      line .bblockEditPaneL3                anchor top + left + right         at xmin                   ymax                horizontal width 32

      -- Define geometry definition method
      text .bblockHeight 'Default height:' tagwidth 10 anchor t + l + r       at x2                     ymax+0.2            callback '!this.bblockHeight(' width 19 is REAL format !!distanceFmt

      -- Define geometry
      button .bblockCrtShape linkLabel  'Define BBLOCK geometry:' anchor t + l + r at xmin              ymax+0.2            callback '!this.bblockGeometry()' width 28
      paragraph .bblockCrtShapeDef           anchor top + left + right        at xmin+2                 ymax                width 28 lines 1

      -- Create BBlock
      paragraph .bbCrtAcceptBBIcon              anchor top + left             at x0                     ymax+0.5            pixmap width 16 height 16
      button .bbCrtAcceptBB  linkLabel 'Create' anchor top + left             at xmax+0.5               ymin                callback '!this.createBBlock()' width 20

      -- Return to BBLOCK tasks
      paragraph .bbCrtBackBBIcon              anchor top + left               at x0                     ymax+0.5            pixmap width 15 height 15
      button .bbCrtBackBB  linkLabel 'Back to Building Block tasks'           at xmax+1                 ymin                callback '!this.bblockTasks(true)'

    exit

  exit

  -- Modify BBLOCK geometrical information
  frame .bbModGeometry panel                        anchor top + left + right   at x0                     ymax.currentOwner

    paragraph .bbGeomTitle                          anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .bbGeomLine1                               anchor top + left + right   at xmin                   ymax                horizontal width 32

      -- Define geometry definition method
      text .bbGHeight 'Default height:' tagwidth 10 anchor top + left + right   at x2                     ymax+0.2            callback '!this.bblockHeight(' width 19 is REAL format !!distanceFmt

      -- Define geometry
      button .bbGModShape linkLabel  'Modify BBLOCK geometry:' anchor t + l + r at xmin                   ymax+0.2            callback '!this.bblockModGeometry()' width 28
      --button .bbGModShape linkLabel  'Modify BBLOCK geometry:' anchor t + l + r at xmin                   ymax+0.2            callback '!!dbeLoopEdit(!!ce,|AEXTR|)' width 28
      paragraph .bbGModhapeDef           anchor top + left + right              at xmin+2                 ymax                width 28 lines 1

      -- Accept Changes
      paragraph .bbGModAcceptIcon                      anchor top + left        at x0                     ymax+0.2            pixmap width 16 height 16
      button .bbGModAccept  linkLabel 'Accept Changes' anchor top + left        at xmax+0.5               ymin                callback '!this.modifyGeomBBlock()' width 10

      -- Discard Changes
      paragraph .bbGModDiscardIcon                      anchor top + right      at xmax+4                 ymin                pixmap width 16 height 16
      button .bbGModDiscard linkLabel 'Discard Changes' anchor top + right      at xmax+0.5               ymin                callback '!this.bblockMGeometry(!this.bblock)' width 10

      paragraph .bbGModBackIcon                         anchor top + left       at x0                     ymax+0.5            pixmap width 15 height 15
      button .bbGModMain   linkLabel   'Back to Building Block tasks'           at xmax+1                 ymin                callback '!this.bblockTasks(true)'

  exit

  -- BLevel Definition
  frame .blevelEditPane panel               anchor top + left + right         at x0                     ymax.currentOwner

    paragraph .blEditTitle                  anchor top + left + right         at x0.5                   ymax                width 30 lines 1
    line .blevelEditPaneL1                  anchor top + left + right         at xmin                   ymax                horizontal width 32
    text .blevelName  'Name:'  tagwidth 9   anchor top + left + right         at x2                     ymax+0.2            callback '!this.checkName(!this.blevelName, !this.currentBLevel.name)' width 20 is STRING
    path down
    halign right
    text .blevelDescription 'Description:'  tagwidth 9 anchor top + left + right                                            callback '' width 20 is STRING
    text .blevelFunction    'Function:'     tagwidth 9 anchor top + left + right                                            callback '' width 20 is STRING
    numericinput .blevelArea 'Area:'        tagwidth 9 anchor top + left      at xmin                   ymax+0.2            callback '' range 0 10000 ndp 0 width 4

    -- Positioning
    paragraph .blLocation                   anchor top + left + right         at x0.5                   ymax+0.2            text 'Location:'
    line .blevelEditPaneL2                  anchor top + left + right         at xmin                   ymax                horizontal width 32

    -- Angle from Y axis
    numericinput .blevelNAngle 'Angle from BBLOCK Y axis:' tagwidth 22 anchor top + left  at x2          ymax+0.2            callback '!this.blevelNAngle('  range 180 -180 ndp 0 width 4

    -- Elevation
    text .blevelElevation 'Elevation:'        anchor top + left + right       at xmin                   ymax+0.4            callback '!this.blevelElevation()' width 17 is REAL format !!distanceFmt

    -- XY Offset of floor from building origin
    paragraph .blXYLocation                   anchor top + left + right       at xmin                   ymax+0.2            width 30 lines 1
    text .blevelXOffset   'X:'                anchor top + left + right       at xmin+8                 ymax                callback '!this.blevelOffset()' width 17 is REAL format !!distanceFmt
    text .blevelYOffset   'Y:'                anchor top + left + right       at xmin                   ymax+0.2            callback '!this.blevelOffset()' width 17 is REAL format !!distanceFmt

    -- Defaults
    frame .blevelDefaults FoldUpPanel 'Defaults'  anchor top + left + right   at x0.5                   ymax+0.5

      text .blevelFlrHeight 'Floor Height:'   tagwidth 10 anchor t + l + r    at x2                     ymax+0.2            width 17 is REAL format !!distanceFmt
      text .blevelClnHeight 'Ceiling Height:' tagwidth 10 anchor t + l + r    at xmin                   ymax+0.2            width 17 is REAL format !!distanceFmt

    exit

    -- Modification data specific to a blevel
    frame .blevelModPane panel                anchor top + left + right       at x0                     ymax

      -- Information
      frame .blevelInformation FoldUpPanel 'Information'           anchor top + left + right   at x0.5                     ymax

        text .blevelare   'Area:'    tagwidth 10              anchor top + left + right   at x2                  ymax                 width 17 is REAL format !!accAreaFmt
        text .blevelvol   'Volume:'  tagwidth 10              anchor top + left + right   at x2                     ymax+0.5        width 17 is REAL format !!accVolFmt
      exit

      -- Apply Changes
      paragraph .blModAcceptBLIcon              anchor top + left             at x0                     ymax+0.2            pixmap width 16 height 16
      button .blModAcceptBL  linkLabel 'Apply Changes' anchor top + left      at xmax+0.5               ymin                callback '!this.modifyBLevel()' width 10

      -- Discard Changes
      paragraph .blModDiscardBLIcon             anchor top + right            at xmax+4                 ymin                pixmap width 16 height 16
      button .blModDiscardBL linkLabel 'Discard Changes' anchor top + right   at xmax+0.5               ymin                callback '!this.blevelModify()' width 10

      paragraph .blModBackBLIcon            anchor top + left                 at x0                     ymax+0.5            pixmap width 15 height 15
      button .blModBackBL linkLabel  'Back to Floor Elevation tasks'          at xmax+1                 ymin                callback '!this.blevelTasks(true)'
      paragraph .blModBackBBIcon             anchor top + left                at x0                     ymax+0.2            pixmap width 15 height 15
      button .blModBackBB linkLabel  'Back to Building Block tasks'           at xmax+1                 ymin                callback '!this.bblockTasks(true)'

    exit

    -- Creation data specific to a BBlock
    frame .blevelCrtPane panel              anchor top + left + right         at xmin.blevelModPane     ymin.blevelModPane

      paragraph .blevelCrtGeom              anchor top + left + right         at x0.5                   ymax                text 'Geometry'
      line .blevelEditPaneL3                anchor top + left + right         at xmin                   ymax                horizontal width 32

      -- Define geometry definition method
      text .blevelHeight 'Default height:' tagwidth 10 anchor top + left + right at x2                  ymax+0.2            callback '!this.blevelHeight(' width 19 is REAL format !!distanceFmt

      -- Define geometry
      toggle .blevelCrtShapeO 'Use owning BBLOCK geometry' tagwidth 28 anchor t + l + r   at xmin       ymax+0.2            callback '!this.useBBlockGeometry()'
      button .blevelCrtShape linkLabel 'Define BBLOCK geometry:' anchor top + left + right at xmin      ymax+0.2            callback '!this.blevelGeometry()' width 28
      paragraph .blevelCrtShapeDef          anchor top + left + right         at xmin+2                 ymax                width 28 lines 1

      -- Create BBlock
      paragraph .blCrtAcceptBLIcon              anchor top + left             at x0                     ymax+0.5            pixmap width 16 height 16
      button .blCrtAcceptBL  linkLabel 'Create' anchor top + left             at xmax+0.5               ymin                callback '!this.createBLevel()' width 20

      -- Return to BBLOCK tasks
      paragraph .blCrtBackBLIcon            anchor top + left                 at x0                     ymax+0.5            pixmap width 15 height 15
      button .blCrtBackBL linkLabel  'Return to Floor Elevation tasks'        at xmax+1                 ymin                callback '!this.blevelTasks(true)'
      paragraph .blCrtBackBBIcon            anchor top + left                 at x0                     ymax+0.2            pixmap width 15 height 15
      button .blCrtBackBB linkLabel  'Return to Building Block tasks'         at xmax+1                 ymin                callback '!this.bblockTasks(true)'

    exit

  exit

  -- Modify BLEVEL geometrical information
  frame .blModGeometry panel                        anchor top + left + right   at x0                     ymax.currentOwner

    paragraph .blGeomTitle                          anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .blGeomLine1                               anchor top + left + right   at xmin                   ymax                horizontal width 32

      -- Define geometry definition method
      text .blGHeight 'Default height:' tagwidth 10 anchor top + left + right   at x2                     ymax+0.2            callback '!this.blevelHeight(' width 19 is REAL format !!distanceFmt

      -- Define geometry
      button .blGModShape linkLabel  'Modify BLEVEL geometry:' anchor t + l + r at xmin                   ymax+0.2            callback '!this.blevelModGeometry()' width 28
      paragraph .blGModhapeDef           anchor top + left + right              at xmin+2                 ymax                width 28 lines 1

      -- Accept Changes
      paragraph .blGModAcceptIcon                      anchor top + left        at x0                     ymax+0.2            pixmap width 16 height 16
      button .blGModAccept  linkLabel 'Accept Changes' anchor top + left        at xmax+0.5               ymin                callback '!this.modifyGeomBLevel()' width 10

      -- Discard Changes
      paragraph .blGModDiscardIcon                      anchor top + right      at xmax+4                 ymin                pixmap width 16 height 16
--    button .blGModDiscard linkLabel 'Discard Changes' anchor top + right      at xmax+0.5               ymin                callback '!this.blevelMGeometry(!this.element)' width 10
      button .blGModDiscard linkLabel 'Discard Changes' anchor top + right      at xmax+0.5               ymin                callback '!this.blevelMGeometry(!this.bblock)' width 10

      paragraph .blGModBackIcon                         anchor top + left       at x0                     ymax+0.5            pixmap width 15 height 15
      button .blGModMain   linkLabel   'Back to Floor Elevation tasks'          at xmax+1                 ymin                callback '!this.blevelTasks(true)'

      -- Return to BBLOCK tasks
      paragraph .bbGBackBBIcon              anchor top + left               at x0                     ymax+0.5            pixmap width 15 height 15
      button .bbGBackBB  linkLabel 'Back to Building Block tasks'                   at xmax+1                 ymin                callback '!this.bblockTasks(true)'


  exit


  -- Form Members
  using namespace 'Aveva.Pdms.Presentation'

  -- Position
  member .bbPosition      is POSITIONCONTROL

  -- Current active element
  member .owner           is DBREF

  -- Active Elements (should be the relevant elements Mike has defined)
  member .bblock          is DBREF
  member .blevel          is DBREF

  -- Current Task
  member .currentTask     is BLOCK
  member .refreshTask     is BLOCK

  --Current bblock object
  member .currentBBlock   is DBEBBLOCK

  --Current blevel object
  member .currentBLevel   is DBEBLEVEL

  --Flag for BBLOCK shape has been set or not
  member .shapeflag       is BOOLEAN
  --owning BBLOCK set in as member for BLEVEL creation

  member .owningbblock    is DBREF

  -- Undo for form
  member .undo            is UNDOABLE

  -- Replacement Texts for Element types
  member .bblockRText     is STRING
  member .blevelRText     is STRING
  member .roomRText       is STRING

  -- Aid Numbers
  member .aidAxes         is REAL
  member .outerBoundary   is REAL
  member .innerBoundaries is REAL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accMainRefData
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accMainRefData()

  !this.shapeflag = FALSE

  -- Claps panel
  !this.blevelDefaults.expanded         = false

  -- Set events for numeric gadgets
  !this.bblockNAngle.modifiedEvents     = true
  !this.blevelNAngle.modifiedEvents     = true

  !this.bblockInformation.expanded = FALSE
  !this.blevelInformation.expanded = FALSE

  !this.bblockare.editable = FALSE
  !this.blevelare.editable = FALSE

  !this.bblockvol.editable = FALSE
  !this.blevelvol.editable = FALSE

  -- Header Texts
  !this.mainTaskHeader.val              = 'Main Administration Elements'
  !this.layoutTasks.val                 = 'Layout Tasks'
  !this.supportingTasks.val             = 'Supporting Tasks'

  -- Back Icons
  !backIcon                     = !!pml.getpathname('back.png')
  !this.bbCrtBackIcon.addpixmap(!backIcon)
  !this.mCrtBackIcon.addpixmap(!backIcon)
  !this.blTskBackBBIcon.addpixmap(!backIcon)
  !this.blTskBackMainIcon.addpixmap(!backIcon)
  !this.bbCrtBackBBIcon.addpixmap(!backIcon)
  !this.blCrtBackBBIcon.addpixmap(!backIcon)
  !this.blCrtBackBLIcon.addpixmap(!backIcon)
  !this.bbModBackBBIcon.addpixmap(!backIcon)
  !this.blModBackBBIcon.addpixmap(!backIcon)
  !this.blModBackBLIcon.addpixmap(!backIcon)
  !this.bbGModBackIcon.addpixmap(!backIcon)
  !this.blGModBackIcon.addpixmap(!backIcon)
  !this.bbGBackBBIcon.addpixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getpathname('create.png')
  !this.bbCrtAcceptBBIcon.addpixmap(!createIcon)
  !this.blCrtAcceptBLIcon.addpixmap(!createIcon)

  -- Accept Icons
  !acceptIcon                   = !!pml.getpathname('accept.png')
  !this.bbModAcceptBBIcon.addpixmap(!acceptIcon)
  !this.blModAcceptBLIcon.addpixmap(!acceptIcon)
  !this.bbGModAcceptIcon.addpixmap(!acceptIcon)
  !this.blGModAcceptIcon.addpixmap(!acceptIcon)

  -- Discard Icons
  !discardIcon                  = !!pml.getpathname('discard.png')
  !this.bbModDiscardBBIcon.addpixmap(!discardIcon)
  !this.blModDiscardBLIcon.addpixmap(!discardIcon)
  !this.bbGModDiscardIcon.addpixmap(!discardIcon)
  !this.blGModDiscardIcon.addpixmap(!discardIcon)

  -- validate the text gadgets
  -- validating text gadgets for BLEVEL
  !this.blevelXOffset.validateCall    = '!this.validateTextGadgets(!this.blevelXOffset,!this.currentBLevel.xyOffset[1])'
  !this.blevelYOffset.validateCall    = '!this.validateTextGadgets(!this.blevelYOffset,!this.currentBLevel.xyOffset[2])'
  !this.blevelElevation.validateCall  = '!this.validateTextGadgets(!this.blevelElevation,!this.currentBLevel.elevation)'
  !this.blevelFlrHeight.validateCall  = '!this.validateTextGadgets(!this.blevelFlrHeight,!this.currentBLevel.dFlrHeight)'
  !this.blevelClnHeight.validateCall  = '!this.validateTextGadgets(!this.blevelClnHeight,!this.currentBLevel.dClnHeight)'

  !this.blevelHeight.validateCall     = '!this.validateTextGadgets(!this.blevelHeight,!this.currentBLevel.defaultHeight)'
  !this.blGHeight.validateCall        = '!this.validateTextGadgets(!this.blGHeight,!this.currentBLevel.defaultHeight)'

  -- validating text gadgets for BBLOCK
  !this.bblockHeight.validateCall     = '!this.validateTextGadgets(!this.bblockHeight,!this.currentBBlock.defaultHeight)'
  !this.bbGHeight.validateCall        = '!this.validateTextGadgets(!this.bbGHeight,!this.currentBBlock.defaultHeight)'

  -- Browser Icons
  !browserIcon                  = !!pml.getpathname('openbrowser.png')
  !this.mCSVBrowse.addpixmap(!browserIcon)

  --validate call for File
  !this.mCSVName.validateCall = '!this.fileValidate('

  -- Load ship grid data for use with positioning controls (may be this should be a function?)
  !grid                     = object SHIPGRID()
  !gridDefined              = !grid.position.set()

  -- Only populate the grid data is available
  if(!gridDefined) then
    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo
  endif

  -------------------- Setup for position control ----------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- Modify BBLOCK position
  !this.bbPosition          = object POSITIONCONTROL()

  -- Set grid data (should put all control grid setups in here
  if(!gridDefined) then
    !this.bbPosition.gridData(!xGridData,!yGridData,!zGridData)
    !this.bbPosition.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
  else
    !this.bbPosition.gridVisible(false)
  endif

  -- Assign action to be taken when position is changed
  !this.bbPosition.changeAction('!!accMainRefData.setBBPosition()')

  -- Initialise Gadgets
  !this.bbPosition.forceXYZ(0,0,0)

  -- Add PMLNet control to PML frame
  !this.bbEditPosNetFrame.control  = !this.bbPosition.handle()

  -- Set position control to be show in the correct form
  -- Add all control into this block
  var !coordinate coordinate
  if(!gridDefined.and(!coordinate.eq('XYZ'))) then
    !this.bbPosition.gridFormat()
  else
    !this.bbPosition.enuFormat()
  endif

  -- Set grid data (should put all control grid setups in here
  if(!gridDefined) then
    !this.bbPosition.gridData(!xGridData,!yGridData,!zGridData)
    !this.bbPosition.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
  endif

  -- Set position column heading
  !this.bbPosition.heading('World Position')

  -- Assign action to be taken when position is changed
  !this.bbPosition.changeAction('!!accMainRefData.setBBPosition()')

  -- Initialise Gadgets
  !this.bbPosition.forceXYZ(0,0,0)

  -- Set position control to be show in the correct form
  -- Add all control into this block
  var !coordinate coordinate
  if(!gridDefined.and(!coordinate.eq('XYZ'))) then
    !this.bbPosition.gridFormat()
  else
    !this.bbPosition.enuFormat()
  endif

  -- Set BLevel copy owning shape
  !this.useBBlockGeometry()

-----------------------------------------

  -- Task Management
  !this.currentTask           = object BLOCK('!this.dummy()')
  !this.refreshTask           = object BLOCK('!this.dummy()')

  -- Setup form initialise task panes into their default state
  !this.mainTasks(true)
  !this.bblockTasks(false)
  !this.blevelTasks(false)
  !this.multiCreateTasks(false, 'BBLOCK')
  !this.bblockDefinitionPane(false)
  !this.bblockMGeometry(false)
  !this.blevelModifyTasks(false)
  !this.blevelCreateTasks(false)
  !this.blevelMGeometry(false)

  -- Load information from Configuration
  !this.refreshConfig()

  -- Assign aid numbers for form
  !this.aidAxes         = !!aidNumbers.add('Main Ref Data - Axes')
  !this.outerBoundary   = !!aidNumbers.add('Main Ref Data - OuterBoundary')
  !this.innerBoundaries = !!aidNumbers.add('Main Ref Data - InnerBoundaries')

  -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

  -- Register refresh with config settings form
  !action = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Get current element
  !element                = !!accNavigator.currentSelection()

  -- If element is unset, then initialise form with limited actions
  if(!element.unset() or !element.badref()) then
    !this.owner                 = object DBREF()
    !this.currentOwner.val      = 'No active element selected'

  -- Initialise form with relevant actions
  else

    -- Set owner where layout data is to be stored
    !this.owner                 = !element
    !this.currentOwner.val      = 'Active element: ' & !this.owner.namn

  endif

  -- Unit Conversions for Area and Volume
  !this.accUnitsFormats()

  -- Update gadgets to track Navigator
  !this.updateGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh form from navigator.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh task
  if(!this.shown()) then
    !this.initialise()
    !this.refreshTask.evaluate()
  endif

endmethod
-- End of method

