--
-- Method:      undoAction
--
-- Description: Action to be carried out on an undo
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .undoAction(!action is STRING)

  -- If form is shown, then update gadgetry
  if(!this.shown()) then

    -- Run action for undo
    !block  = object BLOCK(!action)
    !block.evaluate()
    !!accNavigator.reloadBBlocks()

  endif

endmethod

