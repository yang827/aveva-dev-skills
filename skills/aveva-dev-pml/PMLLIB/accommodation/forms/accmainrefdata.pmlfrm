------------------------------------------------------------------------
--
-- Method:      blevelModify
--
-- Description: Setup BLevel edit form to modify a BLevel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
---   1   R      DBREF       BLevel to modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .blevelModify(!element is DBREF) is BOOLEAN

  -- Check BLevel has been passed
  if(!element.badref()) then
    !!error.text                  = 'Element is no longer valid.'
    !!alert.warning(!!error.text)
    !this.blModAcceptBL.active  = false
    !this.blModDiscardBL.active  = false
    return false
  endif
  if(!element.fulltype.neq('BLEVEL')) then
    !!error.text                  = 'Element "' & !element.namn & '" is not a BLEVEL.'
    return false
  endif
  !this.blModAcceptBL.active  = true
  !this.blModDiscardBL.active  = true

  -- Load current BLevel
  !this.blevel                    = !element
  !this.currentBLevel             = object DBEBLEVEL(!this.blevel)

  -- Set aid numbers
  !this.currentBLevel.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Form title
  !this.formTitle                 = 'Modify ' & !this.blevelRText

  -- Edit panel title
  !this.blEditTitle.val           = !this.blevelRText & ': ' & !this.blevel.namn

  -- Update BLevel gadgets
  !this.updateBLevelAttributes()

  -- Show creation panel
  !this.blevelCrtPane.visible     = false
  !this.blevelModPane.visible     = true

  -- Set edit pane
  !this.blevelDefinitionPane(true)

  return true

endmethod
