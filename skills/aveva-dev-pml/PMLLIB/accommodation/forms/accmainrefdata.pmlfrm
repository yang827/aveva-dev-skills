------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
    -- update the form titles
    if ( !gadget.eq(!this.bblockName)) then
      !this.bbEditTitle.val           = !this.bblockRText & ': ' & !name
      if ( !this.owner.eq(!this.bblock)) then
        !this.currentOwner.val      = 'Active element: ' & !name
      endif
      -- Refresh navigator, this should be handled by the navigator itself
      if ( !this.bblock.unset().not()) then
         !!accNavigator.reloadBBlocks(!this.bblock)
      endif
    else
      !this.blEditTitle.val           = !this.blevelRText & ': ' & !name
      if ( !this.owner.eq(!this.blevel)) then
        !this.currentOwner.val      = 'Active element: ' & !name
      endif
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createBBlock
--
-- Description: Creates BBLOCK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createBBlock()
if (!this.licenceCheck()) then
else
  -- Check that outerLoop is set, and that it is a closed loop so that a volume can be created
  if(!this.currentBBlock.outerLoop.set().not()) OR (!this.currentBBlock.outerLoop.isClosed().not()) then
    !!alert.warning('Geometry must be defined before a Building Block is created.')
    return
  endif

  -- Reference Element
  !reference  = !!ce

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created ' & !this.bblockRText)
  !this.undo.undoAction('!!accMainRefData.undoAction(''!this.bblockCreate()'')')
  !this.undo.redoAction('')
  !this.undo.add()

  -- Update Block Attributes
  !this.updateBBlockData()

  -- Create new element
  if(!this.currentBBlock.create()) then
    !this.bblock        = !this.currentBBlock.dbElement

    -- Generate Boundary and Area Definition
    if(!this.currentBBlock.outerLoop.set()) then
      !!ce              = !this.bblock

      -- Create boundary
      NEW BNDLIN
      !!ce.description  = !this.bblockRText & ' Boundary'

      -- Name element
      if(!this.bblock.isNamed) then
        call !!autoNameCe(false)
      endif
      NEW LOOP
      !this.currentBBlock.outerLoop.dbWrite(CE)

      -- Create Area definition
      NEW AREADEF
      !!ce.description  = !this.bblockRText & ' Volume'

      -- Name element
      if(!this.bblock.isNamed) then
        call !!autoNameCe(false)
      endif
      NEW AEXTR
      !!ce.obs = 0
      !extrusion        = !!ce
      !extrusion.height = !this.bblock.heiDefault
      RULE SET HEIGHT STATIC (heiDefault of BBLOCK)
      NEW LOOP
      !this.currentBBlock.outerLoop.dbWrite(CE)

      -- Set the label position to the mid point of the AREADEF as a default
      !cofg             = !extrusion.gcofg
      handle ANY
      elsehandle NONE
        !labOffset[1]           = !cofg.east
        !labOffset[2]           = !cofg.north
        !labOffset[3]           = 0
        !this.bblock.labOffset  = !labOffset
      endhandle

    endif

    -- Switch to modify pane
    !this.bblockModify(!this.bblock)

    -- Refresh navigator, this should be handled by the navigator itself
    !!accNavigator.reloadBBlocks(!this.bblock)

  -- Failed creating element
  else
    !!alert.warning(!!error.text)
  endif

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Return to original element
  !!ce        = !reference
endif
endmethod

------------------------------------------------------------------------
--
-- Method:      deleteBBlock
--
-- Description: Delete BBLOCK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteBBlock()
  --should this be automated, i.e. from subscription mechanism?
  !this.bblock                    = !!accNavigator.bblock()

  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.bblock).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  endif

   -- Refresh navigator, this should be handled by the navigator itself
  if(!this.bblock.badref())then
    !!accNavigator.reloadBBlocks()
  endif

  !this.updateGadgets()
endmethod
------------------------------------------------------------------------
--
-- Method:      deleteBLevel
--
-- Description: Delete BLEVEL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteBLevel()
  --should this be automated, i.e. from subscription mechanism?
  !this.blevel                    = !!accNavigator.blevel()

  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.blevel).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  endif

  -- Refresh navigator, this should be handled by the navigator itself
  if(!this.blevel.badref())then
  !!accNavigator.reloadBLevels()
  !!accNavigator.reloadBBlocks()
  endif
 !this.updateGadgets()
endmethod

------------------------------------------------------------------------
--
-- Method:      modifyBBlock
--
-- Description: Modify BBLOCK (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyBBlock()
if (!this.licenceCheck()) then
else
  -- Update Block Attributes
  !this.updateBBlockData()
  if(!this.bblock.badref()) then
    !!error.text                  = 'Element is no longer valid.'
    !!alert.warning(!!error.text)
    !this.bbModAcceptBB.active  = false
    !this.bbModDiscardBB.active  = false
    return false
  endif

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.bblock.namn & ')')
  !this.undo.undoAction('!!accMainRefData.undoAction(''!this.bblockModify()'')')
  !this.undo.redoAction('!!accMainRefData.undoAction(''!this.bblockModify()'')')
  !this.undo.add()

  -- Modify BBlock
  if(!this.currentBBlock.modify().not())then
    !!alert.warning(!!error.text)
  endif

  -- Refresh navigator, this should be handled by the navigator itself
  !!accNavigator.reloadBBlocks(!this.bblock)

  -- Set end mark for UNDO
  !this.undo.endUndoable()
endif
endmethod

------------------------------------------------------------------------
--
-- Method:      modifyGeomBBlock
--
-- Description: Modify BBLOCK Geometry (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyGeomBBlock()

    -- Generate Boundary and Area Definition
    if(!this.currentBBlock.outerLoop.set()) then
      !!ce              = !this.bblock

      -- check to see if geometry defined
      BNDLIN 1
      handle ANY
        -- Create boundary
        NEW BNDLIN
        !!ce.description  = !this.bblockRText & ' Boundary'

        -- Name element
        if(!this.bblock.isNamed) then
          call !!autoNameCe(false)
        endif
        NEW LOOP
        !this.currentBBlock.outerLoop.dbWrite(CE)

        -- Create Area definition
        NEW AREADEF
        !!ce.description  = !this.bblockRText & ' Volume'

        -- Name element
        if(!this.bblock.isNamed) then
          call !!autoNameCe(false)
        endif
        NEW AEXTR
        !!ce.obs = 0
        !extrusion        = !!ce
        !extrusion.height = !this.bblock.heiDefault
        RULE SET HEIGHT STATIC (heiDefault of BBLOCK)
        NEW LOOP
        !this.currentBBlock.outerLoop.dbWrite(CE)

        -- Set the label position to the mid point of the AREADEF as a default
        !cofg             = !extrusion.gcofg
        handle ANY
        elsehandle NONE
          !labOffset[1]           = !cofg.east
          !labOffset[2]           = !cofg.north
          !labOffset[3]           = 0
          !this.bblock.labOffset  = !labOffset
        endhandle
      endhandle

    endif

  -- re-assign the bblock to the object to update the geometry changes
  !this.currentBBlock             = object DBEBBLOCK(!this.bblock)

  -- Update Block Attributes
  !this.updateBBlockData()

  -- Update Geometry attribute (Default Height )
  !this.currentBBlock.defaultHeight = !this.bbGHeight.val

  -- Set aid numbers
  !this.currentBBlock.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)
  -- re-draw the aid after change in geometry
  !this.currentBBlock.draw()

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.bblock.namn & ')')
  !this.undo.undoAction('!!accMainRefData.undoAction(''!this.bblockModify()'')')
  !this.undo.redoAction('!!accMainRefData.undoAction(''!this.bblockModify()'')')
  !this.undo.add()

  -- Modify BBlock
  !this.currentBBlock.modify()

  -- Update geometry if required

  -- Update any rules on the area definition
  RULE EXECUTE ALL ON ALL AEXTR FOR $!<this.bblock>
  handle ANY
  endhandle

  -- Refresh navigator, this should be handled by the navigator itself
  !!accNavigator.reloadBBlocks(!this.bblock)

  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      updateBBlockData
--
-- Description: Update current BBlock data with data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateBBlockData()

  if(!this.bblockName.val.set()) then
    !this.currentBBlock.name      = !this.bblockName.val
  endif

  !this.currentBBlock.description = !this.bblockDescription.val
  !this.currentBBlock.function    = !this.bblockFunction.val
  !this.currentBBlock.area        = !this.bblockArea.val

endmethod

------------------------------------------------------------------------
--
-- Method:      createBLevel
--
-- Description: Create BLEVEL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createBLevel()
if (!this.licenceCheck()) then
else
  -- Reference Element
  !reference  = !!ce

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created ' & !this.blevelRText)
  !this.undo.undoAction('!!accMainRefData.undoAction(''!this.blevelCreate()'')')
  !this.undo.redoAction('')
  !this.undo.add()

  -- Navigate to BBlock
  !!ce                  = !this.bblock

  -- Update Block Attributes
  !this.updateBLevelData()

  -- Create new element
  if(!this.currentBLevel.create()) then
    !this.blevel        = !this.currentBLevel.dbElement

    -- Generate Boundary and Area Definition
    if(!this.currentBLevel.outerLoop.set()) then
      !!ce              = !this.blevel

      -- Create boundary
      NEW BNDLIN
      !!ce.description  = !this.blevelRText & ' Boundary'

      -- Name element
      if(!this.blevel.isNamed) then
        call !!autoNameCe(false)
      endif
      NEW LOOP
      !this.currentBLevel.outerLoop.dbWrite(CE)

      -- Create Area definition
      NEW AREADEF
      !!ce.description  = !this.blevelRText & ' Volume'

      -- Name element
      if(!this.blevel.isNamed) then
        call !!autoNameCe(false)
      endif
      NEW AEXTR
      !!ce.obs = 0
      !extrusion        = !!ce
      !extrusion.height = !this.blevel.heiDefault
      RULE SET HEIGHT STATIC (heiDefault of BLEVEL)
      NEW LOOP
      !this.currentBLevel.outerLoop.dbWrite(CE)

      -- Set the label position to the mid point of the AREADEF as a default
      !cofg             = !extrusion.gcofg
      handle ANY
      elsehandle NONE
        !labOffset[1]           = !cofg.east
        !labOffset[2]           = !cofg.north
        !labOffset[3]           = 0
        !this.blevel.labOffset  = !labOffset
      endhandle

    endif

    -- Switch to modify pane
    !this.blevelModify(!this.blevel)

    -- Refresh navigator, this should be handled by the navigator itself
    !!accNavigator.reloadBLevels(!this.blevel)

  -- Failed creating element
  else
    !!alert.warning(!!error.text)
  endif

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Return to original element
  !!ce        = !reference
endif
endmethod

------------------------------------------------------------------------
--
-- Method:      modifyBLevel
--
-- Description: Modify BLEVEL (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyBLevel()
if (!this.licenceCheck()) then
else
  -- Update Block Attributes
  !this.updateBLevelData()

  if(!this.blevel.badref()) then
    !!error.text                  = 'Element is no longer valid.'
    !!alert.warning(!!error.text)
    !this.blModAcceptBL.active  = false
    !this.blModDiscardBL.active  = false
    return false
  endif

 -- Define UNDO Information
  !this.undo.description('Modified (' & !this.blevel.namn & ')')
  !this.undo.undoAction('!!accMainRefData.undoAction(''!this.blevelModify()'')')
  !this.undo.redoAction('!!accMainRefData.undoAction(''!this.blevelModify()'')')
  !this.undo.add()

  -- Modify BBlock
  if(!this.currentBLevel.modify().not())then
    !!alert.warning(!!error.text)
  endif

  -- Refresh navigator, this should be handled by the navigator itself
  !!accNavigator.reloadBLevels(!this.blevel)

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Refresh the form
  !this.blevelModify(!this.blevel)

endif
endmethod

