------------------------------------------------------------------------
--
-- Method:      bblockCreate
--
-- Description: Setup bblock edit form to create a new bblock
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .bblockCreate()

  -- Initialise Variables
  !this.currentBBlock             = object DBEBBLOCK()
  !east	 =	!!accConfig.bpos[0]
  !north =	!!accConfig.bpos[1]
  !up 	 =	!!accConfig.bpos[2]

  !configPosition = object POSITION('East $!east North $!north Up $!up')
  !this.currentBBlock.position(!configPosition)

  -- Form title
  !this.formTitle                 = 'Create ' & !this.bblockRText

  -- Edit panel title
  !this.bbEditTitle.val           = 'Main Attributes of ' & !this.bblockRText &':'
  !this.bblockCrtShapeDef.val     = 'None currently defined'

  -- Set aid numbers
  !this.currentBBlock.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Update BBlock gadgets
  !this.updateBBlockAttributes()

  -- Show creation panel
  !this.bblockCrtPane.visible     = true
  !this.bblockModPane.visible     = false

  -- Set defaults
  !this.shapeflag                 = false

  -- Set edit pane
  !this.bblockDefinitionPane(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      bblockModify
--
-- Description: Setup bblock edit form to modify a bblock from current navigator
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .bblockModify() is BOOLEAN
  return !this.bblockModify(!!accNavigator.bblock())
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      bblockModify
--
-- Description: Setup bblock edit form to modify a bblock
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       BBlock to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .bblockModify(!element is DBREF) is BOOLEAN

  if(!element.unset())then
    !!alert.warning('No BBlock is selected to modify.')
    !this.mainTasks(true)
    return false
  endif
  -- Check BBLOCK has been passed
  if(!element.badref()) then
    !!error.text                  = 'Element is no longer valid.'
    !!alert.warning(!!error.text)
    !this.bbModAcceptBB.active  = false
    !this.bbModDiscardBB.active  = false
    return false
  endif
  if(!element.fulltype.neq('BBLOCK')) then
    !!error.message               = 'Element "' & !element.namn & '" is not a BBLOCK.'
    return false
  endif
  !this.bbModAcceptBB.active  = true
  !this.bbModDiscardBB.active  = true

  -- Load current BBlock
  !this.bblock                    = !element
  !this.currentBBlock             = object DBEBBLOCK(!this.bblock)

  -- Set aid numbers
  !this.currentBBlock.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Form title
  !this.formTitle                 = 'Modify ' & !this.bblockRText

  -- Edit panel title
  !this.bbEditTitle.val           = !this.bblockRText & ': ' & !this.bblock.namn

  -- Update BBlock gadgets
  !this.updateBBlockAttributes()

  -- Show creation panel
  !this.bblockCrtPane.visible     = false
  !this.bblockModPane.visible     = true

  -- Set edit pane
  !this.bblockDefinitionPane(true)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateBBlockAttributes
--
-- Description: Update BBlock gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateBBlockAttributes()

  -- Set values of gadgets from BBlock object
  !this.bblockName.val            = !this.currentBBlock.name
  !this.bblockDescription.val     = !this.currentBBlock.description
  !this.bblockFunction.val        = !this.currentBBlock.function
  !this.bblockArea.val            = !this.currentBBlock.area
  !this.bblockNAngle.val          = !this.currentBBlock.nAngle
  !position                       = !this.currentBBlock.position.wrt(World)
  !this.bbPosition.xyz(!position.east, !position.north, !position.up)
  !this.bblockHeight.val          = !this.currentBBlock.defaultHeight

  !this.bblockare.val        =  !this.currentBBlock.bblockare
  !this.bblockvol.val        =  !this.currentBBlock.bblockvol

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateBLevelAttributes
--
-- Description: Update BLevel gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateBLevelAttributes()

  -- Set values of gadgets from BBlock object
  !this.blevelName.val            = !this.currentBLevel.name
  !this.blevelDescription.val     = !this.currentBLevel.description
  !this.blevelFunction.val        = !this.currentBLevel.function
  !this.blevelArea.val            = !this.currentBLevel.area
  !this.blevelNAngle.val          = !this.currentBLevel.nAngle
  !this.blevelElevation.val       = !this.currentBLevel.elevation
  !this.blevelXOffset.val         = !this.currentBLevel.xyOffset[1]
  !this.blevelYOffset.val         = !this.currentBLevel.xyOffset[2]
  !this.blevelHeight.val          = !this.currentBLevel.defaultHeight
  !this.blevelFlrHeight.val       = !this.currentBLevel.dFlrHeight
  !this.blevelClnHeight.val       = !this.currentBLevel.dClnHeight

  !this.blevelare.val             = !this.currentBLevel.blevelare
  !this.blevelvol.val             = !this.currentBLevel.blevelvol
endmethod
-- End of method

