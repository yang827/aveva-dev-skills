-- Method:      refreshConfig
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refreshConfig()

  !description          = 'Relative to ' & !!accConfig.typeDescription(!this.owner.type)
  !this.wrtpara.val     = !description

endmethod
-- End of method
------------------------------------------------------------------------
