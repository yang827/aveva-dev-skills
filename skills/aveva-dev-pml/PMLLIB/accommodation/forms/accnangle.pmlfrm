--
--
-- Description: Set the nAngle of Accommodation elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accNangle()                      -                   Constructor
--  close()                          -
--  draw()                           -                   Setup EDG pick event for picking position
--  initialise()                     -
--  offset(EDGPOSITIONDATA)          -                   Map picked position to room offset
--  pickOffset()                     -                   Define EDG event to pick position
--  refresh()                        -
--  refreshConfig()                  -
--  setup(DBREF)                     BOOLEAN
--  tidy()                           -
--  update(GADGET,STRING)            -
--  updateElement()                  -
--  updateGadgets()                  -
--


 setup form !!accNangle resize

  !this.formTitle     = 'Angle From North'
  !this.iconTitle     = 'nAngle'
  !this.callback      = '!this.initialise()'
  !this.quitcall      = '!this.tidy()'
  !this.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
  button .selectElement linkLabel 'Element:'  anchor top + left           at x0.5   ymin       callback 'call !!accNangle(!!ce)' width 6
  paragraph .namepara                         anchor top + left + right   at xmax   ymin       width 15 lines 2

  -- Nangle of element with respect to owner`
  numericinput .nangleTxt 'Angle'        tagwidth 9 anchor top + left  at x3    ymax+0.5      callback '!this.update(' range -180 180 ndp 0 width 10
  paragraph .wrtpara                        anchor top + left + right   at x3    ymax+0.2    width 20 lines 2

  -- Apply button
  button .acceptBtn   'Accept'    anchor top + left           at x0.5     ymax+0.5                                  callback '!this.updateElement()' width 5

  -- Dismiss button
  button .discardBtn  'Dismiss'  anchor top + right          at x20   ymin                               callback '!this.close()'  width 5

  -- Form Members
  -- Current Element
  member .element         is DBREF

  -- Element of reference
  member .owner         is DBREF

  -- Element has Nangle attribute
  member .nangleFlag    is BOOLEAN

  -- Nangle Values
  member .nAngle        is REAL

  -- Plane
  member .plane           is PLANE

  member .aidNumber       is REAL

  -- Attribute data
  member .attributeData   is DBEATTRIBSEARCH

 exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accNangle
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .accNangle()

  -- Alternative attributes for Nangle
  !oriAtts[1]          = 'Orientation'

  -- set the attribute Data search  Object
  !this.attributeData = object DBEATTRIBSEARCH(object DBREF() , 'NAngle' , !oriAtts)

    -- Get aid number
  !this.aidNumber   = !!aidNumbers.add('Nangle display')

    -- Set events for numeric gadgets
  !this.nangleTxt.modifiedEvents   = true

   -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

   -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

endmethod

------------------------------------------------------------------------
--
-- Method:initialise
--
-- Description:Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--  element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.setup(!!ce)

endmethod
------------------------------------------------------------------------
--
-- Method:  setup
--
-- Description: Setup form for passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if element is valid
--
------------------------------------------------------------------------

define method .setup(!passedElement is DBREF) is BOOLEAN


  if(!passedElement.ahlist.findfirst('AREADE').set() or !passedElement.type.eq('AREADE')) then
    !ownerList     = !!ce.ownlst
    !ownerPlace    = !!ce.ahlist.findfirst('AREADE')
     if (!ownerPlace.set()) then
      !!ce           = !ownerList[!ownerPlace - 1]
     else
      !!ce           = !ownerList[!ownerList.size()]
     endif
   !passedElement = !!ce

  elseif(!passedElement.ahlist.findfirst('BNDLIN').set() or  !passedElement.type.eq('BNDLIN')) then
     !ownerList     = !!ce.ownlst
    !ownerPlace    = !!ce.ahlist.findfirst('BNDLIN')
    if (!ownerPlace.set()) then
      !!ce           = !ownerList[!ownerPlace - 1]
     else
      !!ce           = !ownerList[!ownerList.size()]
     endif
   !passedElement = !!ce

  endif

  !element         = !this.attributeData.element(!passedElement)

  if (!element.unset() ) then
      !!error.text = 'Element doesn''t have an Nangle or  Orientation attribute.'
       return
  endif

  -- Check again that Z is U in case navigated to another element
  if(!element.orientation.wrt(world).zdir().up.abs().neq(1) ) then
    !!error.text      = 'Unable to set North angle for ' & !element.namn & ' as the Z direction is not in vertical axis.'
    return false
  endif

  -- Set element to modify
  !this.element   = !element
  !owner          = !element.owner

  -- Set whether we are working with Nangle or not
  if (!this.attributeData.attribute.eq('NAngle')) then
    !this.nangleFlag = TRUE
  else
    !this.nangleFlag = FALSE
  endif

  -- set form gadgets values
  !this.namepara.val    = !element.flnn
 -- !this.formTitle       = !this.attributeData.description

  -- Get owning frame of reference
  do
    !position = !owner.position
    handle ANY
      !owner    = !owner.owner
      handle ANY
        !!alert.warning('Unable to form frame of reference of element ' & !element.namn)
        return
      endhandle
    elsehandle NONE
      break
    endhandle
  enddo

  -- assign the owner
  !this.owner = !owner

  -- Owing element type
  !description          = 'Relative to ' & !!accConfig.typeDescription(!this.owner.type)
  !this.wrtpara.val     = !description

  -- Derive plane where Nangle is measured, this is using POS and ORI of the element
  !this.plane         = object PLANE(!element.position, !owner.orientation)

  -- Get the Nangle as a XYPOSITION of the element
  if(!this.nangleFlag) then
    !this.nAngle      = !element.nAngle
  else
      !cAngle       =   object COMPOUNDANGLES()
      !angles       =   !cAngle.angles(!this.element.orientation , !this.plane)
      !this.nAngle  =   !angles[1]
  endif

  -- Update input gadgets with values
  !this.updateGadgets()

  -- Tag element
  !this.draw()

  -- Return
  return true

endmethod

------------------------------------------------------------------------
--
-- Method:    update
--
-- Description: Sets the Nangle of the element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update(!gadget is GADGET, !unusedSelect is STRING)

  !this.nAngle = !gadget.val
  !this.draw()

endmethod
------------------------------------------------------------------------
--
-- Method:    updateGadgets
--
-- Description: Sets the Nangle of the element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  -- Initialise Variables
 !this.nangleTxt.val     = !this.nAngle

  if (!!dbrefUpdatable(!this.element).not() )  then
      write $!!error.text
      !this.acceptBtn.active = FALSE
  else
      !this.acceptBtn.active = TRUE
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      draw()
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draw()

  -- Remove aid graphics
  !this.tidy()

  !position       = !this.element.position
  !direction      = !this.owner.orientation.yDir()

  if(!this.nAngle.neq(0)) then

  -- Define arc
  if(!this.nAngle.lt(0)) then
    !sense        = false
  else
    !sense        = true
  endif

  !arc            = object ARC(!position, !this.owner.orientation, 90 , 90 + !this.nAngle, 750mm, !sense)
  !anglePoint     = !arc.anglePosition(90 + !this.nAngle * 0.5)
  !direction      = !arc.angleDirection(!arc.endAngle)

  AID ARROW NUMBER $!<this.aidNumber> AT $!position DIRECTION $!<direction> HEIGHT 1100mm PROPORTION 0.1
  AID ARROW NUMBER $!<this.aidNumber> AT $!position DIRECTION $!direction HEIGHT 1200mm
  AID TEXT NUMBER $!<this.aidNumber> '$!this.nAngle' AT $!anglePoint
  !arc.draw(!this.aidNumber, 1, 4)

  var !coordinate coordinate
  if(!coordinate.eq('ENU'))then
  !worldOri        = y is N
  else
    !worldOri        = y is Y
  endif

  if (!this.owner.orientation.wrt(world).neq(!worldOri)) then
    !northArc         = object ARC(!position, !worldOri , 90 , 90 + !this.nAngle, 500mm, TRUE)

    !endDir          = !arc.angleDirection(!arc.endAngle)
    !endPoint         = !position.offset(!endDir.wrt(world) , 500mm)

    !northArc         = !northArc.endPosition(!endPoint)
    !northArcAngle    = !northArc.angle()

    if(!northArcAngle.gt(180)) then
       !northArc.sense   = false
       !northArcAngle    = ( !northArc.angle() * -1)
    endif

    !northTxtPoint    = !position.offset(N, 1000mm)
    !northAnglePoint  = !northArc.anglePosition( (!northArc.startAngle + !northArc.endAngle) *  0.5)

    AID ARROW NUMBER $!<this.aidNumber> AT $!position DIRECTION N HEIGHT 1000mm PROPORTION 0.11
    if(!coordinate.eq('ENU'))then
    AID TEXT NUMBER $!<this.aidNumber> 'N' AT $!northTxtPoint
    else
      AID TEXT NUMBER $!<this.aidNumber> 'Y' AT $!northTxtPoint
    endif
    AID TEXT NUMBER $!<this.aidNumber> '$!northArcAngle' AT $!northAnglePoint
    !northArc.draw(!this.aidNumber, 1, 8)
  endif

 endif
endmethod

------------------------------------------------------------------------
--
-- Method: close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()
  !this.tidy()
  !this.hide()
endmethod

------------------------------------------------------------------------
--
-- Method: tidy
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()
  AID CLEAR ALL $!<this.aidNumber>
  handle ANY
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      updateElement
--
-- Description: Update element with modified values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateElement()

--mark for undo option
  !nAngleMark = object UNDOABLE()
  !undoDesc = 'Modify Nangle of $!this.namepara.val'
  !nAngleMark.description(!undoDesc)
  !nAngleMark.add()

  -- Update XYPosition
  if (!this.nangleFlag) then
       !this.element.nAngle   = !this.nAngle
  else
       -- Calculate the Orientation for elements that do not have nAngle
       !zdir        = !this.element.orientation.zdir()
       !newDirection =  'Y is N ' & !this.nAngle.string() & ' W'
       !newOrientation = object ORIENTATION('$!<newDirection> and z is $!<zdir> ')

       !this.element.orientation      = !newOrientation
  endif

  --for undo option
  !nAngleMark.endundoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Define EDG event to pick position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- method not used  will be used in case any EDG pick is necessary
define method .pickOffset()

  -- Initialise Variables
  -- use the altText here
  !prompt               = 'Pick origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Modify XYOffset'
  !packet.remove        = true
  !packet.action        = '!!accNangle.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to room offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!unusedData is EDGPOSITIONDATA)

 !!alert.message('Not yet implemented')

endmethod
-- End of method
------------------------------------------------------------------------
