  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.currentElement).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  else
    !this.reloadBBlocks()
    --!this.reloadBLevels()
    --!this.reloadRooms()
    -- set the current element to some other Element
  endif

