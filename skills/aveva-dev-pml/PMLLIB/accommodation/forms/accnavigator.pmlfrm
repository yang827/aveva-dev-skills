------------------------------------------------------------------------
--
-- Method:      tagCurrentElement
--
-- Description: Tag current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagCurrentElement()

  -- Tidy
  AID CLEAR ALL $!<this.aidNumber>

  -- return if current element is not set
  if(!this.currentElement.unset()) then
    return
  endif

  -- Get label position
  if(!this.currentElement.attributes().findFirst('LabOffset').set()) then
    !position = !this.currentElement.labPosition
  --elseif (!this.currentElement.attributes().findFirst('Position').set()) then
  --  !position = !this.currentElement.position
  --elseif (!this.currentElement.owner.attributes().findFirst('Position').set()) then
  --  !position = !this.currentElement.owner.position
  else
    !position = !this.currentElement.position
    handle ANY
      !position = !this.currentElement.owner.position
      handle ANY
        return
      endhandle
    endhandle
  endif

  -- Get name
  if(!this.currentElement.isNamed) then
    !name   = !this.currentElement.namn
  else
    !name   = !this.currentElement.fulltype
  endif
  AID TEXT NUMBER $!<this.aidNumber> '$!name' AT $!<position>

endmethod

------------------------------------------------------------------------
--
-- Method:      selectBBlock
--
-- Description: Select BBLOCK from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectBBlock(!passedArray is ARRAY)

  -- Initialise Variable
  !elements               = !this.bblockGrid.getSelectedRowTags()

  -- No BBlock selected
  if(!elements.empty()) then
    !this.bblock          = object DBREF()

  -- BBLOCK
  else
    !bblock               = !elements[1].dbref()

    -- Set BBlock to selected element
    if(!this.bblock.neq(!bblock)) then
      !this.bblock        = !bblock
      !this.blevel        = object DBREF()
      !this.blevelOwner   = object DBREF()
      !this.room          = object DBREF()
      !this.roomOwner     = object DBREF()
      !this.member        = object DBREF()
    endif

    -- Define quick selection
    !this.bblockOpen.tag  = !this.bblock.namn
    !this.blevelOpen.tag  = !this.blevelRText & 's'
    !this.roomOpen.tag    = !this.roomRText & 's'

  endif

  -- Current Element
  !this.currentElement    = !this.bblock

  -- Tag element
  !this.tagCurrentElement()
  if(!this.bblock.set())then
    !this.blevelCollection.scope(!this.bblock)
    !this.blevelOpen.active = !this.blevelCollection.results().empty().not()
    !this.popupBBlock.setFieldProperty('bblockLevels', 'ACTIVE',!this.blevelOpen.active)
    handle ANY
    endhandle
    !this.popupMember.setFieldProperty('memberLevels', 'ACTIVE',!this.blevelOpen.active)
    handle ANY
    endhandle
    !this.roomCollection.scope(!this.bblock)
    !this.roomOpen.active   = !this.roomCollection.results().empty().not()
    !this.popupBBlock.setFieldProperty('bblockRooms', 'ACTIVE', !this.roomOpen.active)
    handle ANY
    endhandle
    !this.popupBLevel.setFieldProperty('blevelRooms', 'ACTIVE', !this.roomOpen.active)
    handle ANY
    endhandle
    !this.popupMember.setFieldProperty('memberRooms', 'ACTIVE', !this.roomOpen.active)
    handle ANY
    endhandle
  endif

  -- Run control update
  !!accControl.refresh(!this)

endmethod

------------------------------------------------------------------------
--
-- Method:      selectBLevel
--
-- Description: Select BLEVEL from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectBLevel(!passedArray is ARRAY)

  -- Initialise Variable
  --!elements               = !this.blevelGrid.getSelectedRowTags()
  !elementSelected               = !this.blevelGrid.getSelectedRows()
		
  -- No BLevel selected
  if(!elementSelected.unset()) then
    !blevel          = object DBREF()

  -- BLEVEL
  else

    !blevel               = object DBREF(!elementSelected[1][1])
    handle any
    	!blevel               = object DBREF('/' + !elementSelected[1][1])
    	handle (2,109)
    		!blevel        = object DBREF()
    	endhandle
    endhandle
    	
    -- Set BBlock to selected element
    if(!this.blevel.neq(!blevel)) then
      !this.blevel        = !blevel
      !this.room          = object DBREF()
      !this.roomOwner     = object DBREF()
      !this.member        = object DBREF()
    endif

    -- Define quick selection
    !this.blevelOpen.tag  = !this.blevel.namn
    !this.roomOpen.tag    = !this.roomRText & 's'

  endif

  -- Current Element
  !this.currentElement    = !this.blevel

  -- Tag element
  !this.tagCurrentElement()
  if(!this.blevel.set())then
    !this.roomCollection.scope(!this.blevel)
    !this.roomOpen.active   = !this.roomCollection.results().empty().not()
    !this.popupBBlock.setFieldProperty('bblockRooms', 'ACTIVE', !this.roomOpen.active)
    handle ANY
    endhandle
    !this.popupBLevel.setFieldProperty('blevelRooms', 'ACTIVE', !this.roomOpen.active)
    handle ANY
    endhandle
    !this.popupMember.setFieldProperty('memberRooms', 'ACTIVE', !this.roomOpen.active)
     handle ANY
    endhandle
  endif

  -- Run control update
  !!accControl.refresh(!this)

endmethod

------------------------------------------------------------------------
--
-- Method:      selectRoom
--
-- Description: Select ROOM from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectRoom(!passedArray is ARRAY)

  -- Initialise Variable
  !elements               = !this.roomGrid.getSelectedRowTags()

  -- No BBlock selected
  if(!elements.empty()) then
    !this.room            = object DBREF()
  else

    -- Set BBlock to selected element
    !this.room            = !elements[1].dbref()
    !this.member          = object DBREF()

    -- Define quick selection
    !this.roomOpen.tag    = !this.room.namn
    !this.blevel          = !this.room.owner
    --!this.blevelOpen.tag  = !this.blevel.namn
  endif

  -- Current Element
  !this.currentElement    = !this.room

  -- Tag element
  !this.tagCurrentElement()

  -- Run control update
  !!accControl.refresh(!this)

endmethod

------------------------------------------------------------------------
--
-- Method:      selectMember
--
-- Description: Select member from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectMember(!passedArray is ARRAY)

  -- Initialise Variable
  !elements               = !this.memberGrid.getSelectedRowTags()

  -- No BBlock selected
  if(!elements.empty()) then
    !this.member          = object DBREF()
  else

    -- Set BBlock to selected element
    !this.member          = !elements[1].dbref()

  endif

  -- Current Element
  !this.currentElement    = !this.member

  -- Tag element
  !this.tagCurrentElement()

  if(!this.member.set())then
    !this.roomCollection.scope(!this.bblock)
    !this.roomOpen.active   = !this.roomCollection.results().empty().not()
    if (!this.memberGrid.getSelectedRows()[1][2] inset('DETGRP', 'BNDLIN', 'STRWEL', 'AREADE', 'SPBSET', 'RSTARE', 'OPENSP')) then
       !this.popupMember.setFieldProperty('memberTasks', 'ACTIVE', !this.roomOpen.active.not())
       handle ANY
       endhandle
    else
       !this.popupMember.setFieldProperty('memberTasks', 'ACTIVE', !this.roomOpen.active)
       handle ANY
       endhandle
    endif
    if (!this.memberGrid.getSelectedRows()[1][2].eq('DETGRP')) then
    	!this.popupMember.setFieldProperty('memberContents', 'ACTIVE', !this.roomOpen.active)
      handle ANY
      endhandle
    else
      !this.popupMember.setFieldProperty('memberContents', 'ACTIVE', !this.roomOpen.active.not())
      handle ANY
      endhandle
    endif
  endif

  -- Run control update
  !!accControl.refresh(!this)

endmethod

------------------------------------------------------------------------
--
-- Method:      tasks
--
-- Description: Show appropriate task form for selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tasks()

  -- Initialise Variable
  !elementType = !this.currentElement.type

  -- Main Reference Data
  if(!elementType inset('BBLOCK', 'BLEVEL')) then

    -- Make form active task form
    !!accTaskManager.active('accMainRefData')

    -- Show correct panel
    if(!elementType.eq('BBLOCK')) then
      !!accMainRefData.bblockTasks(true)
    else
      !!accMainRefData.blevelTasks(true)
    endif

  -- Room Tasks
  elseif (!elementType.eq('ROOM')) then

    -- Make form active task form
    !!accTaskManager.active('accRoomDefinition')

    -- Show correct panel
    !!accRoomDefinition.mainTasks(true)
  endif

endmethod

