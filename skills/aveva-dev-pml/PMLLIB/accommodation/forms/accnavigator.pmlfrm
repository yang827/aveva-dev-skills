  !!accTaskManager.active('accCopyManager')

  -- Add selected element to copy manager
  !!copyManager.add(!this.currentElement)

endmethod

------------------------------------------------------------------------
--
-- Method:      locateFromTree
--
-- Description: Locate current element in navigator
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locateFromTree()


  -- Determine the owning element type
  !reference    = !!ce


  if(!reference.type inset('BBLOCK', 'BLEVEL' , 'ROOM')) then
       !block            = object BLOCK('!this.reload' & !reference.type & 's(!reference)')
       !block.evaluate()
  elseif(!reference.type.eq('DETGRP')) then
  	   if(!reference.owner.type.eq('ROOM'))then
  	   	 !this.reloadRooms(!reference.owner)
       elseif(!reference.owner.type.eq('BLEVEL'))then
  	     !this.reloadBLevels(!reference.owner)
       elseif(!reference.owner.type.eq('BBLOCK'))then
   	     !this.reloadBBlocks(!reference.owner)
       endif
       !block           = object BLOCK('!this.loadMembers()')
       !block.evaluate()
  else

       -- Get owning element information
       !owningTypes  = !reference.ahList
       !owners       = !reference.ownLst

       -- Get element type from navigator
       !roomIndex  = !owningTypes.findFirst('ROOM')
       !levelIndex = !owningTypes.findFirst('BLEVEL')
       !buildIndex = !owningTypes.findFirst('BBLOCK')

       -- Work backwards up the tree, i.e. bottom up
       if(!roomIndex.set()) then
         !element    = !owners[!roomIndex]
         !this.reloadRooms(!element)

       elseif (!levelIndex.set()) then
         !element    = !owners[!levelIndex]
         !this.reloadBLevels(!element)

       elseif (!buildIndex.set()) then
         !element    = !owners[!buildIndex]
         !this.reloadBBlocks(!element)

       endif

  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      lock
--
-- Description: Set lock
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lock()

  -- Set tracking flag
  !this.tracking  = !this.lock.val

  -- If tracking and at a different element
  if(!this.tracking and !!ce ne !this.currentElement) then
      !this.track()
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
