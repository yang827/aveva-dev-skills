------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accNavigator()                   -                   Constructor
--  bblock()                         DBREF               Returns currently selected BBLOCK
--  blevel()                         DBREF               Returns currently selected BLEVEL
--  copy()                           -
--  create()                         -                   Show creation panel/for for selected element
--  currentSelection()               DBREF               Returns currently selected element
--  delete()                         -                   Perform appropriate delete action for selected element
--  initialise()                     -                   Initialisation method
--  loadBBlocks()                    -                   Load BBLOCK into the system
--  loadBLevels()                    -                   Load BLEVEL into the system
--  loadMembers()                    -                   Load members into the system
--  loadRooms()                      -                   Load ROOMs into the system
--  locateFromTree()                 -                   Locate current element in navigator
--  lock()                           -                   Set lock
--  member()                         DBREF               Returns currently selected member
--  modify()                         -
--  popupBBlock(ARRAY)               -                   Pop-up callback for BBLOCKs
--  popupBLevel(ARRAY)               -                   Pop-up callback for BLEVELs
--  popupMember(ARRAY)               -                   Pop-up callback for Members
--  popupMenus()                     -                   Setup popup menus.
--  popupRoom(ARRAY)                 -                   Pop-up callback for ROOMs
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  reloadBBlocks()                  -                   Reload BBLOCK into the system
--  reloadBBlocks(DBREF)             -                   Reload BBLOCK into the system
--  reloadBLevels()                  -                   Reload BLEVEL into the system
--  reloadBLevels(DBREF)             -                   Reload BLEVEL into the system
--  reloadRooms()                    -                   Reload Room into the system
--  reloadRooms(DBREF)               -                   Reload ROOM into the system
--  room()                           DBREF               Returns currently selected ROOM
--  selectBBlock(ARRAY)              -                   Select BBLOCK from grid
--  selectBLevel(ARRAY)              -                   Select BLEVEL from grid
--  selectMember(ARRAY)              -                   Select member from grid
--  selectRoom(ARRAY)                -                   Select ROOM from grid
--  switchPanel(GADGET)              -                   Switches to specified panel and hides current
--  tagCurrentElement()              -                   Tag current element
--  tasks()                          -                   Show appropriate task form for selection
--  tidy()                           -                   Tidy aid graphics
--  track()                          -                   Track db changes.
--

import 'GridControl'
handle any
endhandle

setup form !!accNavigator dialog docking right

  -- Tracking
  --track 'DBCHANGED' call '!this.track()'

  !this.formTitle     = 'Room Design Navigator'
  !this.iconTitle     = 'Navigator'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.tidy()'
  !this.killingCall    = '!this.tidy()'
  !this.formRevision  = ' $Revision$ '

  track    |DESICE| call |!this.track()|
  toggle    .lock         'Track current element' at x0.5   ymax callback '!this.lock()'

  -- Direct navigation to panels
  button .bblockOpen  linkLabel  'BBLOCK'                           at xmin                     ymax                callback '!this.loadBBlocks()' width 12
  button .blevelOpen  linkLabel  'BLEVEL'                           at xmax                     ymin                callback '!this.loadBLevels()' width 12
  button .roomOpen    linkLabel  'ROOM'                             at xmax                     ymin                callback '!this.loadRooms()'   width 12

  -- PML Container to host grid control for BBLOCKs
  frame .bBlockFrame panel            anchor all                    at x0.5                     ymax
    container .bblocks PMLNetCONTROL 'NET' dock fill
    list .bBlockDummy                 anchor all                    at x0.5                     y0.5                callback '' columns height 20 width 36
  exit

  frame .bLevelFrame panel            anchor all                    at x0.5                     ymin
    container .blevels PMLNetCONTROL 'NET' dock fill
    list .bLevelDummy                 anchor all                    at x0.5                     y0.5                callback '' columns height 20 width 36
  exit

  frame .roomFrame panel              anchor all                    at x0.5                     ymin
    container .rooms   PMLNetCONTROL 'NET' dock fill
    list .bLeve2Dummy                 anchor all                    at x0.5                     y0.5                callback '' columns height 20 width 36
  exit

  frame .memberFrame panel            anchor all                    at x0.5                     ymin
    container .members   PMLNetCONTROL 'NET' dock fill
    list .bLeve3Dummy                 anchor all                    at x0.5                     y0.5                callback '' columns height 20 width 36
  exit

  -- Form members

  -- Replacement Texts for Element types
  member .bblockRText is STRING
  member .blevelRText is STRING
  member .roomRText   is STRING

  -- Current active elements
  member .currentElement    is DBREF
  member .bblock            is DBREF
  member .blevel            is DBREF
  member .room              is DBREF
  member .member            is DBREF

  -- Current Active Panel
  member .currentPanel      is GADGET

  -- Grid data
  member .bblockCollection  is COLLECTION
  member .bblockAttributes  is ARRAY
  member .blevelCollection  is COLLECTION
  member .blevelAttributes  is ARRAY
  member .roomCollection    is COLLECTION
  member .roomAttributes    is ARRAY
  member .roomAttributesAlt is ARRAY

  member .memberCollection  is COLLECTION
  member .memberAttributes  is ARRAY

  -- Current grid contents
  member .blevelOwner       is DBREF
  member .roomOwner         is DBREF

  -- Aid text
  member .aidNumber         is REAL

   -- Aid text
  member .tracking         is BOOLEAN

  -- Grid control
  using namespace 'Aveva.Pdms.Presentation'
  member .bblockGrid        is NETGRIDCONTROL
  member .blevelGrid        is NETGRIDCONTROL
  member .roomGrid          is NETGRIDCONTROL
  member .memberGrid        is NETGRIDCONTROL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accNavigator
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accNavigator()

  -- Set tracking to be off by default
  !this.tracking  = false

  -- Aid number
  !this.aidNumber = !!aidNumbers.add('Accommodation Navigator')

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('Name')
  !attributes.append('Area')
  !attributes.append('Description')

  -- Collection definitions
  !this.bblockCollection      = object COLLECTION()
  !this.bblockCollection.addType('BBLOCK')
  !this.bblockAttributes      = !attributes

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('Name')
  !attributes.append('Elevation')
  !attributes.append('Description')

  !this.blevelCollection      = object COLLECTION()
  !this.blevelCollection.addType('BLEVEL')
  !this.blevelAttributes      = !attributes

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('Name')
  !attributes.append('Number')
  !attributes.append('Description')

  !this.roomCollection        = object COLLECTION()
  !this.roomCollection.addType('ROOM')
  !this.roomAttributes        = !attributes
  !attributes.append('Owner')
  !this.roomAttributesAlt     = !attributes

  !this.memberCollection      = object COLLECTION()
  --!this.memberCollection.addType('ROOM')

  !attributes     = ARRAY()
  !attributes.append('Name')
  !attributes.append('TYPE')
  !attributes.append('Description')
  !this.memberAttributes      = !attributes

  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- Add .Net control to PML container for BBLOCKs
  !this.bblockGrid            = object NETGRIDCONTROL()
  !this.bblocks.control       = !this.bblockGrid.handle()

  -- Events handled
  !this.bblockGrid.addEventHandler('onPopup',           !this, 'popupBBlock')
  !this.bblockGrid.addEventHandler('afterSelectChange', !this, 'selectBBlock')

  -- Add .Net control to PML container for BLEVELs
  !this.blevelGrid            = object NETGRIDCONTROL()
  !this.blevels.control       = !this.blevelGrid.handle()
  !this.blevelGrid.addEventHandler('onPopup',           !this, 'popupBLevel')
  !this.blevelGrid.addEventHandler('afterSelectChange', !this, 'selectBLevel')

  -- Add .Net control to PML container for ROOMs
  !this.roomGrid              = object NETGRIDCONTROL()
  !this.rooms.control         = !this.roomGrid.handle()
  !this.roomGrid.addEventHandler('onPopup',           !this, 'popupRoom')
  !this.roomGrid.addEventHandler('afterSelectChange', !this, 'selectRoom')

  -- Add .Net control to PML container for ROOMs
  !this.memberGrid              = object NETGRIDCONTROL()
  !this.members.control         = !this.memberGrid.handle()
  !this.memberGrid.addEventHandler('onPopup',           !this, 'popupMember')
  !this.memberGrid.addEventHandler('afterSelectChange', !this, 'selectMember')

  -- Set Active Panel
  !this.currentPanel        = !this.bBlockFrame
  !this.bBlockFrame.visible = true
  !this.bLevelFrame.visible = false
  !this.roomFrame.visible   = false
  !this.memberFrame.visible = false

  -- Load information from Configuration
  !this.refreshConfig()

  -- Load Data grid with elements
  !this.loadBBlocks()

  -- Setup popup-menus
  !this.popupMenus()

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()
  !this.loadBBlocks()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()
  AID CLEAR ALL $!<this.aidNumber>
  handle ANY
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Replacement Text (needs to be set using configuration information)
  !this.bblockRText             = !!accConfig.typeDescription ( 'BBLOCK' )
  !this.blevelRText             = !!accConfig.typeDescription ( 'BLEVEL' )
  !this.roomRText               = !!accConfig.typeDescription ( 'ROOM' )

  !bblockRText          = !this.bblockRText & 's'
  !blevelRText          = !this.blevelRText & 's'
  !roomRText            = !this.roomRText & 's'

  -- Direct navigation to panels
  !this.bblockOpen.tag  = !bblockRText
  !this.blevelOpen.tag  = !blevelRText
  !this.roomOpen.tag    = !roomRText

  -- Navigator defaults
  !columnExcelFilter    = !!accConfig.navigator.columnExcelFilter
  !outlookGroupStyle    = !!accConfig.navigator.outlookGroupStyle
  !columnSummaries      = !!accConfig.navigator.columnSummaries
  !labelVisibility      = !!accConfig.navigator.labelVisibility

  -- Control configuration (BBlock)
  !this.bblockGrid.columnExcelFilter(!columnExcelFilter)
  !this.bblockGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.bblockGrid.columnSummaries(!columnSummaries)
  !this.bblockGrid.fixedHeaders(false)
  !this.bblockGrid.fixedRows(false)
  !this.bblockGrid.singleRowSelection(true)
  !this.bblockGrid.setLabelVisibility(!labelVisibility)

  -- Control configuration (BLevel)
  !this.blevelGrid.columnExcelFilter(!columnExcelFilter)
  !this.blevelGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.blevelGrid.columnSummaries(!columnSummaries)
  !this.blevelGrid.fixedHeaders(false)
  !this.blevelGrid.fixedRows(false)
  !this.blevelGrid.singleRowSelection(true)
  !this.blevelGrid.setLabelVisibility(!labelVisibility)

  -- Control configuration (Rooms)
  !this.roomGrid.columnExcelFilter(!columnExcelFilter)
  !this.roomGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.roomGrid.columnSummaries(!columnSummaries)
  !this.roomGrid.fixedHeaders(false)
  !this.roomGrid.fixedRows(false)
  !this.roomGrid.singleRowSelection(true)
  !this.roomGrid.setLabelVisibility(!labelVisibility)

  -- Control configuration (Members)
  !this.memberGrid.columnExcelFilter(!columnExcelFilter)
  !this.memberGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.memberGrid.columnSummaries(!columnSummaries)
  !this.memberGrid.fixedHeaders(false)
  !this.memberGrid.fixedRows(false)
  !this.memberGrid.singleRowSelection(true)
  !this.memberGrid.setLabelVisibility(!labelVisibility)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      popupMenus
--
-- Description: Setup popup menus.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .popupMenus()

  -- Initialise Variables
  !bblockRText        = !this.bblockRText & 's'
  !blevelRText        = !this.blevelRText & 's'
  !roomRText          = !this.roomRText & 's'

  -- Popup Menus for BBLCOK Grid
  !popup = !this.newMenu('popupBBlock')
  !popup.add('callback', 'Modify',            '!this.modify()',           'bblockModify')
  !popup.add('callback', 'Create',            '!this.create()',           'bblockCreate')
  --!popup.add('callback', 'Copy',            '!this.copy()',             'bblockCopy')
  !popup.add('separator')
  !popup.add('callback', 'Delete',            '!this.delete()',           'bblockDelete')
  !popup.add('separator')
  !popup.add('callback', 'Tasks',             '!this.tasks()',            'bblockMainRefData')
  !popup.add('separator')
  !popup.add('callback', 'Members',           '!this.loadMembers()',      'bblockMembers')
  !popup.add('callback', 'Levels',            '!this.loadBLevels()',      'bblockLevels')
  !popup.add('callback', 'Rooms',             '!this.loadRooms()',        'bblockRooms')
  !popup.add('separator')
  !popup.add('callback', 'Add to view',       '!!accVisualisation.add(!this.bblock)', 'bblockAdd')
  !popup.add('separator')
  !popup.add('callback', 'Locate in Tree',    '!!ce = !this.bblock',      'bblockInTree')
  !popup.add('callback', 'Locate from Tree',  '!this.locateFromTree()',   'bblockFromTree')
  !this.bblocks.popup   = !popup

  -- Popup Menu for BLEVEL Grid
  !popup                = !this.newMenu('popupBLevel')
  !popup.add('callback', 'Modify',            '!this.modify()',           'blevelModify')
  !popup.add('callback', 'Create',            '!this.create()',           'blevelCreate')
  --!popup.add('callback', 'Copy',            '!this.copy()',             'bblockCopy')
  !popup.add('separator')
  !popup.add('callback', 'Delete',            '!this.delete()',           'blevelDelete')
  !popup.add('separator')
  !popup.add('callback', 'Tasks',             '!this.tasks()',            'bblockTasks')
  !popup.add('separator')
  !popup.add('callback', 'Members',           '!this.loadMembers()',      'blevelMembers')
  !popup.add('callback', !bblockRText,        '!this.loadBBlocks()',      'blevelBlocks')
  !popup.add('callback', !roomRText,          '!this.loadRooms()',        'blevelRooms')
  !popup.add('separator')
  !popup.add('callback', 'Add to view',       '!!accVisualisation.add(!this.blevel)', 'blevelAdd')
  !popup.add('separator')
  !popup.add('callback', 'Locate in Tree',    '!!ce = !this.currentElement', 'blevelCE')
  !popup.add('callback', 'Locate from Tree',  '!this.locateFromTree()',   'bblockFromTree')
  !this.blevels.popup   = !popup

  -- Popup Menu for ROOM Grid
  !popup                = !this.newMenu('popupRoom')
  !popup.add('callback', 'Modify',            '!this.modify()',           'roomModify')
  !popup.add('callback', 'Create',            '!this.create()',           'roomCreate')
  --!popup.add('callback', 'Copy',            '!this.copy()',             'bblockCopy')
  !popup.add('separator')
  !popup.add('callback', 'Delete',            '!this.delete()',           'roomDelete')
  !popup.add('separator')
  !popup.add('callback', 'Tasks',             '!this.tasks()',            'roomTasks')
  !popup.add('separator')
  !popup.add('callback', 'Members',           '!this.loadMembers()',      'roomMembers')
  !popup.add('callback', !bblockRText,        '!this.loadBBlocks()',      'roomBlocks')
  !popup.add('callback', !blevelRText,        '!this.loadBLevels()',      'roomLevels')
  !popup.add('separator')
  !popup.add('callback', 'Add to view',       '!!accVisualisation.add(!this.room)', 'roomAdd')
  !popup.add('separator')
  !popup.add('callback', 'Locate in Tree',    '!!ce = !this.currentElement', 'roomCE')
  !popup.add('callback', 'Locate from Tree',  '!this.locateFromTree()',   'bblockFromTree')
  !this.rooms.popup     = !popup

  -- Popup Menu for members Grid
  !popup                = !this.newMenu('popupMember')
  !popup.add('callback', 'Modify',            '!this.modify()',           'memberModify')
  --!popup.add('callback', 'Copy',            '!this.copy()',             'bblockCopy')
  !popup.add('separator')
  !popup.add('callback', 'Delete',            '!this.delete()',           'memberDelete')
  !popup.add('separator')
  !popup.add('callback', 'Tasks',             '!this.tasks()',            'memberTasks')
  !popup.add('callback', 'Contents',          'show !!accContentNavigator',            'memberContents')
  !popup.add('separator')
  !popup.add('callback', !bblockRText,        '!this.loadBBlocks()',      'memberBlocks')
  !popup.add('callback', !blevelRText,        '!this.loadBLevels()',      'memberLevels')
  !popup.add('callback', !roomRText,          '!this.loadRooms()',        'memberRooms')
  !popup.add('separator')
  !popup.add('callback', 'Locate in Tree',    '!!ce = !this.currentElement', 'memberCE')
  !popup.add('callback', 'Locate from Tree',  '!this.locateFromTree()',   'bblockFromTree')
  !this.members.popup   = !popup

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: Track db changes.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track()

  -- Initialise Variables
  -- Need to check
  if (!this.tracking) then
    !this.locateFromTree()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reloadBBlocks
--
-- Description: Reload BBLOCK into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reloadBBlocks()
  !this.bblock  = object DBREF()
  !this.loadBBlocks()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reloadBBlocks
--
-- Description: Reload BBLOCK into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Giving element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reloadBBlocks(!element is DBREF)

  -- Check BBlock has been passed
  if(!element.type.neq('BBLOCK')) then
    return
  endif

  -- Initialise Variables
  !this.bblock  = !element
  !this.loadBBlocks()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reloadBLevels
--
-- Description: Reload BLEVEL into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reloadBLevels()
  !this.blevel  = object DBREF()
  !this.loadBLevels()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reloadBLevels
--
-- Description: Reload BLEVEL into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Giving element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reloadBLevels(!element is DBREF)

  -- Check Blevel has been passed
  if(!element.type.neq('BLEVEL')) then
    return
  endif

  -- Initialise Variables
  !this.bblock  = !element.owner
  !this.blevel  = !element
  !this.loadBLevels()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reloadRooms
--
-- Description: Reload Room into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reloadRooms()
  !this.room  = object DBREF()
  !this.loadRooms()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reloadRooms
--
-- Description: Reload ROOM into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Giving element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reloadRooms(!element is DBREF)

  -- Check room has been passed
  if(!element.type.neq('ROOM')) then
    return
  endif

  -- Initialise Variables
  !this.bblock  = !element.owner.owner
  !this.blevel  = !element.owner
  !this.room    = !element
  !this.loadRooms()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadBBlocks
--
-- Description: Load BBLOCK into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadBBlocks()

  -- Initialise Variables
  !this.currentPanel.visible  = false
  !this.currentPanel          = !this.bBlockFrame
  !this.currentPanel.visible  = true
  !this.bblockOpen.active     = false
  !this.blevelOpen.active     = true
  !this.roomOpen.active       = true
  !this.currentElement        = !this.bblock
  !bblock                     = !this.bblock

  -- Get all BBLOCK
  !myCollection         = !this.bblockCollection.results()
  !this.blevelOpen.active = !myCollection.empty().not() and !this.bblockGrid.getSelectedRows().empty().not()
  !this.roomOpen.active   = !myCollection.empty().not() and !this.bblockGrid.getSelectedRows().empty().not()

  !block                = object BLOCK('!myCollection[!evalIndex].string()')
  !dbNames              = !myCollection.evaluate(!block)

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds                  = object NETDATASOURCE('BBlocks', !this.bblockAttributes, !dbNames)
  !this.bblockGrid.bindToDataSource(!nds)
  !this.bblock          = !bblock
  !this.currentElement  = !bblock

  -- Select current bblock or first if its empty
  if(!this.bblock.unset()) then
    !this.bblockGrid.selectRow(1)
    handle ANY
    endhandle
  else
    !elementList[1]     = !this.bblock.string()
    !this.bblockGrid.setSelectedRowTags(!elementList)
    if(!this.bblock.badref().not())then
      !this.bblockOpen.tag        = !this.bblock.namn
      !this.tagCurrentElement()
    else
      !bblockRText          = !this.bblockRText & 's'
      !this.bblockOpen.tag  = !bblockRText
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadBLevels
--
-- Description: Load BLEVEL into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadBLevels()

  if(!this.bblock.badref())then
    return
  endif

  -- Initialise Variables
  !this.currentPanel.visible  = false
  !this.currentPanel          = !this.bLevelFrame
  !this.currentPanel.visible  = true
  !this.bblockOpen.tag        = !this.bblock.namn

  !this.bblockOpen.active     = true
  !this.blevelOpen.active     = false
  !this.roomOpen.active       = true
  !this.currentElement        = !this.blevel
  !blevel                     = !this.blevel

  -- Get all levels
  !this.blevelOwner     = !this.bblock
  !this.blevelCollection.scope(!this.bblock)
  !myCollection         = !this.blevelCollection.results()
  !block                = object BLOCK('!myCollection[!evalIndex].string()')
  !dbNames              = !myCollection.evaluate(!block)

 !mainGridElements  = object ARRAY()
  do !i indices !dbNames
    !mainGridElements[!i][1] = !dbNames[!i].dbref().flnn
    !mainGridElements[!i][2] = !dbNames[!i].dbref().elevation.string(!!distanceFmt)
    !mainGridElements[!i][3] = !dbNames[!i].dbref().description
  enddo

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds                  = object NETDATASOURCE('BLevels', !this.blevelAttributes, !mainGridElements)
  !this.blevelGrid.bindToDataSource(!nds)

  -- Reset blevel
  !this.blevel          = !blevel
  !this.currentElement  = !blevel

  -- Select current bblock or first if its empty
 if(!this.blevel.unset()) then
    !this.blevelGrid.selectRow(0)
    handle ANY
    endhandle
 else
    !index = !dbNames.findFirst(!this.blevel.string())
    if(!index.unset()) then
    	!index = 0
    endif
    !this.blevelGrid.selectRow(!index)

    handle ANY
      !this.blevelGrid.selectRow(0)
      handle ANY
      endhandle
    endhandle
 endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadRooms
--
-- Description: Load ROOMs into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadRooms()

 if(!this.bblock.badref() and !this.blevel.badref())then
   return
  endif

  -- Determine if we are loading all the rooms for a bblock or only for the blevel
  !bblockRooms                = !this.currentPanel.name().eq('BBLOCKFRAME')
  if(!bblockRooms or !this.blevel.unset()) then
    !scanLevel                = !this.bblock
    !attributeList            = !this.roomAttributesAlt
  else
    !scanLevel                = !this.blevel
    !attributeList            = !this.roomAttributes
  endif

  -- Initialise Variables
  !this.currentPanel.visible  = false
  !this.currentPanel          = !this.roomFrame
  !this.currentPanel.visible  = true
  !this.bblockOpen.tag        = !this.bblock.namn

  !this.bblockOpen.active     = true
  !this.blevelOpen.active     = true
  !this.roomOpen.active       = false
  !this.currentElement        = !this.room

  -- Current room
  !room                       = !this.room

  -- If the list is based on the same element, don't update it
  if(!scanLevel.eq(!this.roomOwner).or(!scanLevel.unset())) then
    -- Select current bblock or first if its empty
    if(!this.room.unset() or !this.room.badref()) then
      !this.roomGrid.selectRow(0)
      handle ANY
      endhandle
    else
      !elementList[1]   = !this.room.string()
      !this.roomGrid.setSelectedRowTags(!elementList)
      handle ANY
        !this.roomGrid.selectRow(0)
        handle ANY
        endhandle
      endhandle
    endif
    --return
  endif

  -- Get all rooms
  !this.roomCollection.scope(!scanLevel)
  !this.roomOwner     = !scanLevel
  !myCollection       = !this.roomCollection.results()
  !block              = object BLOCK('!myCollection[!evalIndex].string()')
  !dbNames            = !myCollection.evaluate(!block)

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds                = object NETDATASOURCE('Rooms', !attributeList, !dbNames)
  !this.roomGrid.bindToDataSource(!nds)

  -- Reset blevel
  !this.room            = !room
  !this.currentElement  = !room

  -- Select current bblock or first if its empty
  if(!this.room.unset()) then
    !this.roomGrid.selectRow(0)
    handle ANY
    endhandle
  else
    !elementList[1]   = !this.room.string()
    !this.roomGrid.setSelectedRowTags(!elementList)
    handle ANY
      !this.roomGrid.selectRow(0)
      handle ANY
      endhandle
    endhandle
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadMembers
--
-- Description: Load members into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadMembers()

  -- Determine if we are loading all the rooms for a bblock or only for the blevel
  !scanLevel                  = !this.currentElement
  !listTypes                  = !scanLevel.list
  !attributeList              = !this.memberAttributes

  -- Initialise Variables
  !this.currentPanel.visible  = false
  !this.currentPanel          = !this.memberFrame
  !this.currentPanel.visible  = true
  !this.bblockOpen.active     = true
  !this.blevelCollection.scope(!this.bblock)
  !this.blevelOpen.active = !this.blevelCollection.results().empty().not()
  !this.roomCollection.scope(!this.bblock)
  !this.roomOpen.active   = !this.roomCollection.results().empty().not()

  -- Get all levels
  !this.memberCollection.scope(!scanLevel)
  !this.memberCollection.types(!listTypes)
  !depth              = !scanLevel.ddepth + 1
  !expression         = object EXPRESSION('DDEPTH eq ' & !depth)
  !this.memberCollection.filter(!expression)
  !myCollection       = !this.memberCollection.results()
  !block              = object BLOCK('!myCollection[!evalIndex].string()')
  !dbNames            = !myCollection.evaluate(!block)

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds                = object NETDATASOURCE('Members', !attributeList, !dbNames)
  !this.memberGrid.bindToDataSource(!nds)

  !members = !!ce
  !elementList[1]   = !members.string()
  !this.memberGrid.setSelectedRowTags(!elementList)
  handle ANY
    !this.memberGrid.selectRow(0)
    handle ANY
    endhandle
  endhandle


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      switchPanel
--
-- Description: Switches to specified panel and hides current
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .switchPanel(!gadget is GADGET)

  -- Initialise Variables
  !this.formTitle             = !gadget.name()
  !this.currentPanel.visible  = false
  !this.currentPanel          = !gadget
  !this.currentPanel.visible  = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      popupBBlock
--
-- Description: Pop-up callback for BBLOCKs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .popupBBlock(!a is ARRAY)
-- No popup if there are no bblocks
  if (!a.size() geq 3) then
    !active = !a[2][1].dbref().lock.not()
    !this.popupBBlock.setFieldProperty('bblockCreate', 'ACTIVE', !active)
    !this.popupBBlock.setFieldProperty('bblockModify', 'ACTIVE', !active)
    !this.popupBBlock.setFieldProperty('bblockDelete', 'ACTIVE', !active)
    !this.bblocks.showPopup(!a[0], !a[1])
  endif
endmethod

