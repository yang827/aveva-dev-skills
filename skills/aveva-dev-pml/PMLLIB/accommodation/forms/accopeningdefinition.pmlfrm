------------------------------------------------------------------------
--
-- Method:      .pickPenetrated()
--
-- Description: Set EDG to pick penetrated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .pickPenetrated()

  -- Define packet for penetrated items
  !packet                = object EDGPACKET()
  !packet.pickPacket.stdGraphic('Pick penetrated object or ESC to exit')
  !packet.description    = 'Pick Penetrated item'
  !packet.priority       = 3
  !packet.action         = '!!' & !this.name() & '.pickPenetratedEvent(!this.return[1])'
  if (!this.penWallGrid.getRows().size() eq 0) then
  !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE inset(|PANE|,|HPLATE|,|CPLATE|)'
  elseif(!this.penWallGrid.getRows().size() eq 1) then
    !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE eq |CTWALL|'
  endif
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Add to system
  !!edgCntrl.add(!packet)

endmethod

----------------------------------------------------------------------
--
-- Method:      .pickPenetratedEvent()
--
-- Description: EDG callback for penetrated item pick
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .pickPenetratedEvent(!data is EDGPICKDATA)

  !positionData          = !data.positionData()

  -- get pick position and plane
  if(!positionData.line.set()) then
    !position = !positionData.line.intersection(!positionData.pointVector)
    !plane    = object PLANE()
  elseif (!positionData.plane.set()) then
    !position = !positionData.pointVector.intersection(!positionData.plane)
    !plane    = !positionData.plane
  elseif (!positionData.position.set()) then
    !position = !positionData.position.wrt( /* )
    !plane    = object PLANE()
  endif

  !penetrated     = ARRAY()
  !penetrated.append(!data.item.flnm)
  !penetrated.append(!position.string())
  !penetrated.append(!plane.position.string())
  !penetrated.append(!plane.orientation.string())
  !penetrated.append('FALSE')

  !this.penWallGrid.addRow(!penetrated)

  if (!this.penWallGrid.getRows().size() eq 2) then
    !this.wallAdd.active   = FALSE
  else
    !this.wallAdd.active   = TRUE
  endif

  !this.holAccept.active = TRUE
  !this.wallRem.active   = TRUE

  -- set the penetrated element and check that it is valid
  --!this.managedHoleProfile.setPenetrated(!data.item, !position, !plane)
  --!penetrated = !this.managedHoleProfile.getPenetrated()
  --if( !penetrated.empty() ) then
    --!this.tidyManagedHole()
    --!!alert.error('Selected item is not valid for creating Managed Holes')
    --return
  --endif

  -- graphical feedback
  --!this.updatePenetrated(!penetrated)

endmethod
----------------------------------------------------------------------
--
-- Method:      .holesFromList()
--
-- Description: Create Virtual Holes or WLOPENs for selected Panels/Walls
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------

define method .holesFromList()

  if(!!alert.confirm('OK to create a managed hole in the selected items').eq('YES')) then

    -- Define UNDO
    !undoManagedHole  = object UNDOABLE()

    !undoManagedHole.description('Create Managed Hole (PROF)')
    !undoManagedHole.add()

    -- Get all of the penetrated items

    !penetratedItems = !this.penWallGrid.getRows()

    do !i indices !penetratedItems

      -- skip if the hole is already managed
      skip if (!penetratedItems[!i][5].boolean())

      !penItem = !penetratedItems[!i][1].dbref()
      if (!penItem.hardType neq 'CTWALL') then
        !itemPos = !penetratedItems[!i][2].position()

        !itemPlane = object PLANE(!penetratedItems[!i][3].position(), !penetratedItems[!i][4].orientation())
        handle ANY
          !itemPlane = object PLANE()
        endhandle

        -- Get profile of penetrating item
        !this.managedHoleProfile = object HMHOLEFROMPROFILE()
        !profile = !this.managedHoleProfile.setPenetrating(!this.opening)
        if( !profile.unset() ) then
          !!alert.error('Cannot make a managed hole because the selected opening has no hole boundary definition')
          return false
        endif


        !this.managedHoleProfile.setPenetrated(!penItem, !itemPos, !itemPlane)
        !penetrated = !this.managedHoleProfile.getPenetrated()
        if( !penetrated.empty() ) then
          !this.tidyManagedHole()
          !!alert.error('Selected item is not valid for creating Managed Holes')
          return
        endif
      endif

      if (!penItem.fulltype eq 'CTWALL') then
        !this.projectOpening(!penItem)
      else
    -- create virtual hole
    !error   = ''
    !virtualHole = !this.managedHoleProfile.createVirtualFixing()
    handle any
      !error = !!error.text
    elsehandle none
      -- create managed hole association
      !this.managedHoleProfile.createManagedHole()
      handle any
        !error    = !!error.text
        -- clean up virtual hole
        if( not badref(!virtualHole) ) then
          !saveCE = !!ce
          !!ce    = !virtualHole
          DELETE FRMW
          handle any
          endhandle
          !!ce    = !saveCE
          handle any
          endhandle
        endif
          elsehandle NONE
            -- Find the association of the wall opening
            !this.hmHole = object HMHOLE(!this.openingGrid.getSelectedRows()[1][2].dbref().assos[1])
      endhandle
    endhandle
    if( !error.empty().not() ) then
      !error = 'Cannot create Managed Hole: ' + !error
      !!alert.error(!error)
    endif

      endif

    enddo

    !undoManagedHole.endUndoable()
  endif

  !this.tidyManagedHole()

    -- Attributes
  !attributes     = ARRAY()
  !attributes.append('Name')
  !attributes.append('Position')
  !attributes.append('Plane Position')
  !attributes.append('Plane Orientation')
  !attributes.append('Managed')

  !penetratedArr  = ARRAY()


  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds                = object NETDATASOURCE('PenWalls', !attributes, !penetratedArr)

  !this.penWallGrid.bindToDataSource(!nds)

  !this.wallAdd.active   = FALSE
  !this.wallRem.active   = FALSE
  !this.holAccept.active = FALSE


endmethod

------------------------------------------------------------------------
--
-- Method:      .updatePenetrated()
--
-- Description: Update penetrated items list and highlight penetrated items
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------
define method .updatePenetrated(!penetratedItems is ARRAY)

  !oldList                = !this.enhancePenetrated
  !this.enhancePenetrated = ARRAY()

  -- unenhance old list
  UNENHANCE ALL FROM !oldList

  !item = !penetratedItems[1]

  -- to avoid bug where HPANEL cannot be highlighted
  if( !item.hardType eq 'HPANEL' ) then
    var !temp COLL ALL HPLATE FOR $!item
    !this.enhancePenetrated.appendArray(!temp)
  elseif( !item.hardType eq 'CPANEL' ) then
    var !temp COLL ALL CPLATE FOR $!item
    !this.enhancePenetrated.appendArray(!temp)
  else
    !this.enhancePenetrated.append(!item.string())
  endif

  -- enhance new list
  !enhance = !this.enhancePenetrated
  ENHANCE ALL FROM !enhance COL 16

endmethod

------------------------------------------------------------------------
-- Method:      tidyManagedHole()
--              cleanup hole management data
------------------------------------------------------------------------
define method .tidyManagedHole()

  !enhanceList = !this.enhancePenetrated
  UNENHANCE ALL FROM !enhanceList

  -- Remove applications events from system
  !!edgCntrl.remove('Pick Penetrated')

endmethod

------------------------------------------------------------------------
-- Method:      openingCopy
--
-- Description: Setup to copy selected opening
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       opening to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .openingCopy() is BOOLEAN


 !element = !this.openingGrid.getSelectedRowTags()[1].dbref()
  handle ANY
    !!alert.error('Please select an opening to copy')
    return
  endhandle

  -- Set definition
  !this.definition          = object DBEOPENING(!element)
  !this.definition.wallOpening = object DBREF()

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidNumber, !this.aidAxes)
  -- create a wall feature for the copy
  !this.definition.zDistance = !this.definition.zDistance + 250
  if !!alert.confirm('Ok to create copy').eq('YES') then
    !this.definition.create()
    !!alert.message('Copy Complete')
    !newElement = !this.definition.opening
    !this.opening = !newElement
    !this.definition          = object DBEOPENING(!newElement)

    !this.tagopening()
  else
    return
  endif
  -- Edit panel title
  --!this.editTitle.val       = 'Copy opening: ' & !this.opening.namn

  -- Update gadgets
  !this.updateAttributes(FALSE)

  -- Switch to modify pane
  !this.selectedOpening = !this.opening

  -- sort the list of wall openings
  --!this.sortOpenings()

  !this.getRotation()

  !this.showEditPanel(TRUE,TRUE)

  !this.openingModify(!this.opening)
  -- Failed creating element
  -- Setup panes
  --!this.modifyOpening(true)

  return true

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateAttributes
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAttributes(!override is BOOLEAN)

  if !override then
     !this.zLock.val = FALSE
     !this.vLock.val = FALSE
  endif
  -- Set values of gadgets from DBEOPENING object
  !this.dbName.val            = !this.definition.name
  !this.dbDescription.val     = !this.definition.description
  !this.dbFunction.val        = !this.definition.function
  !this.dbPurpose.val         = !this.definition.purpose
  !this.dbnumber.val      = !this.definition.number
  -- try to ensure that the locking works to retain numbers
  if !this.vLock.val.and(!this.vDistance.set()).not() then
    !this.vDistance.val         = !this.definition.vDistance
  endif
  if !this.zLock.val.and(!this.zDistance.set()).not() then
     !this.zDistance.val         = !this.definition.zDistance
  endif
  -- set the text attribute to reflect the specification component
  if !this.definition.spref.set() then
     !this.selectedSpec.val = 'Specification: ' & !this.definition.spref.name
  else
     !this.selectedSpec.val = 'Specification: Unset'
  endif
  --!this.openingPosition.xyz( !this.definition.position.east,  !this.definition.position.north,  !this.definition.position.up)
  !this.inset.val             = !this.definition.inset
  !this.getRotation()
  -- set the justification gadget
  !this.setJustLineGadget()
  -- draw the selected item
  !this.definition.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateData
--
-- Description: Update current data with gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateData()

  -- Initialise Variables
  if(!this.dbName.val.set()) then
    !this.definition.name         = !this.dbName.val
  endif
  !this.definition.description    = !this.dbDescription.val
  !this.definition.function       = !this.dbFunction.val
  !this.definition.number         = !this.dbnumber.val
  !this.definition.purpose        = !this.dbPurpose.val
  !this.definition.zDistance      = !this.zDistance.val
  !this.definition.vDistance      = !this.vDistance.val
  !this.definition.wjusl          = !this.wjusl.selection()
  !this.definition.inset          = !this.inset.val
  !this.definition.orientation    = !this.orientation

  !selectedSpecTag  = !this.selectedSpec.val
  !selectedSpecText = !selectedSpecTag.after(':').trim()
  if(!selectedSpecText.set() ) then
    !selectedSpec = !selectedSpecText.dbref()
    handle ANY
    elsehandle none
      !this.definition.spref          = !selectedSpec
    endhandle
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create()

  --!this.showCreatePanel( TRUE )

  --  Reference Element
  !reference  = !!ce

  -- Update definition attributes from the current form
  !this.updateData()

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created opening')
  !this.undo.add()

    -- Create new element
  if(!this.definition.create()) then
    !this.element = !this.definition.opening
    !this.selectedOpening = !this.element
    !this.showEditPanel(TRUE,TRUE)
    -- Switch to modify pane
    !this.openingModify(!this.element)
    -- create opening in the second wall if the second wall is set
    if(!this.secondWall.set()) then
      !this.secondWallOpening()
    endif
  else
    -- Failed creating element
    !!alert.warning(!!error.text)
  endif

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Return to original element
  !!ce        = !reference

endmethod

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.definition.opening.namn & ')')
  handle ANY
  endhandle
  !this.undo.add()

  -- Modify opening
  !this.definition.modify()

  -- set the apply discard buttons to off
  !this.updateGadgets(FALSE)

  !this.tagopening()

  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      discard
--
-- Description: discard changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .discard()

  -- Modify opening
  if !this.definition.opening.unset() then
     !this.definition = object DBEOPENING()
     !this.modAccept.active = FALSE
     !this.showOpeningPanel(TRUE)
  else
     !this.definition.modify()
     !this.definition = object DBEOPENING(!this.definition.opening)
     !this.showEditPanel(TRUE ,TRUE)
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = ''
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

  -- set something to signal update
  !this.updateGadgets(TRUE )

endmethod

------------------------------------------------------------------------
--
-- Method:      checkWord
--
-- Description: Check word is valid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkWord(!gadget is GADGET )

  -- Initialise Variables
  !name        = !gadget.val

  -- Check that the input string is a WORD
  !check       = !!admChkWord(!name)
  if (!check.not()) then
    if (!this.opening.set()) then
      !gadget.val  = !this.opening.purp
    else
      !gadget.val  = |unset|
    endif
    !!alert.error('Attribute must be alphabetical.')
    return false
  endif

  !this.updateGadgets(TRUE )

endmethod

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Continue"
--    3   R      STRING      "Continue" text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING, !continue is STRING)

  -- Switch warning pane
  !this.currentPane.visible   = FALSE
  !this.warningPane.visible   = true

  -- Concatenate message into a single line
  !display    = ''
  do !i indices !message
    !display  = !display & ' ' & !message[!i]
  enddo

  -- Display message
  !this.warning.val           = !display.trim()
  !this.warningDone.tag       = !continue

  -- Set "Continue" action (If the action is dependent on other criteria
  -- e.g. being in the correct position in the hierarchy, then the
  -- active state of the "Done" button needs to be managed.
  !this.warningAction         = object BLOCK(!action)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warningDone
--
-- Description: Exit warning
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warningDone()

  -- Hide warning pane
  !this.warningPane.visible   = FALSE

  -- Execute action
  !this.warningAction.evaluate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      exampleWarning
--
-- Description: Example of how to use a warning with an action
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exampleWarning1()

  -- Define message to be displayed
  !message[1] = 'This is the message that is to be displayed in the '
  !message[2] = 'warning pane. The message can be up to 132 Characters'
  !message[3] = 'long.'
  !this.warning(!message, '!this.firstTaskPane(true)', !this.ftpWarningMsg.val)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteOpening
--
-- Description: Delete
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteopening()

  --should set current opening to delete here (from navigator for other element types)
  !this.selectedOpening = !this.openingGrid.getSelectedRowTags()[1].dbref()
  handle ANY
    !!alert.error('Please select an opening to delete')
    return
  endhandle
  !!ce = !this.selectedOpening
  !assos = !!ce.assos
  do !assoc values !assos
    !purpose = !assoc.owner.purp
    if (!purpose eq 'HOLE') then
      !!alert.error('The selected opening has hole management associations. You must delete these using the hole management form before deleting the opening')
      !this.showHoleMan()
      return
    endif
  enddo
  -- if we are using a template, the template gets locked and we need to unlock it
  unlock all
  !this.enhance('RED', TRUE )
  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.selectedOpening.owner).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  endif
  !this.activeOpening.val = ''
  !this.showOpeningPanel(TRUE)

endmethod

------------------------------------------------------------------------
--
-- Method:      useSelectedWalls
--
-- Description: Get walls from graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useselectedWalls()

  -- Unenhance walls
  !this.tidyWalls()

  -- Tidy graphics
  !this.definition.tidy()

  -- Clear grid
  !this.wallGrid.clearGrid()

  -- Initialise Variables
  !this.wallList.clear()
  !this.wallNames.clear()

  -- Get selected draws to convert into walls
  !selection          = object SELECTION()
  !selection.getCurrent()

  -- Get draws from graphical selection
  !elements           = !selection.getSelection()

  -- Build new selection
  !selection.clear()
  do !i indices !elements
    !type             = !elements[!i].type
    if(!type.eq('CTWALL')) then
      !selection.add(!elements[!i])
      !this.wallList.append(!elements[!i])
    endif
  enddo

  -- Highlight selection
  !selection.setCurrent()

  -- Update grid
  !this.updateWallList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useActiveWalls
--
-- Description: Get walls from current active element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useActiveWalls()

  -- Unenhance walls
  !this.tidyWalls()

  -- Tidy graphics
  !this.definition.tidy()

  -- Clear grid
  !this.wallGrid.clearGrid()
  -- Initialise Variables
  !this.wallList.clear()
  !this.wallNames.clear()
  !groups = ARRAY()

  -- Collect all walls for current active element
  !collection     = object COLLECTION()
  !collection.addType('CTWALL')
  !collection.scope(!this.owningElement)
  !this.wallList  = !collection.results()

    -- Define selection
    !selection      = object SELECTION()
    do !wall values !this.wallList
      !selection.add(!wall)
    enddo

    -- Highlight selection
    !selection.setCurrent()
  --endif

  -- Update grid
  !this.updateWallList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useActiveOpenings
--
-- Description: Get walls from current active element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useactiveOpenings()

  -- Tidy graphics
  !this.definition.tidy()

  -- Clear grid
  !this.openingGrid.clearGrid()
  -- Initialise Variables
  !this.openingList.clear()
  !this.openingNames.clear()
  !groups = ARRAY()

  -- Collect all walls for current active element
  if !this.selectedWall.set() then

  -- Collect walls from groups owned by the active element
    !collection     = object COLLECTION()
    !collection.addType('DOOR')
    !collection.addType('WINDOW')
    !collection.scope(!this.selectedWall)
    !this.openingList  = !collection.results()

    -- Define selection
    !selection      = object SELECTION()
    do !opening values !this.openingList
      !selection.add(!opening)
    enddo

    -- Highlight selection
    !selection.setCurrent()

  endif

  -- Update grid
  !this.updateopeningList()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      tidyWalls
--
-- Description: Tidy walls
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyWalls()

  -- Get current list
  !list = !this.wallNames
  unenhance all from !list

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  !this.definition.tidy()
  !this.tidyWalls()

endmethod
-- End of method

