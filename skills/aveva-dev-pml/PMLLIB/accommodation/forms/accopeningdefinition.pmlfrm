--
--
-- Description:
--    Main form for opening definitions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accOpeningDefinition()           -                   Constructor
--  applyInset(REAL)                 -                   set the inset of a door or wall
--  applyRotation(REAL)              -
--  calculateNewPosition()           -                   Calculate the new positions based on a change of the vdistance and zdistance gadgets
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  checkOwner()                     -                   Check owner of opening
--  checkWord(GADGET)                -
--  create()                         -                   Create element
--  createHole(BOOLEAN)              -                   Display hole pane in create mode
--  createOpening(BOOLEAN)           -                   Display opening pane in create mode
--  deleteEmptyOpenings()            -
--  deleteopening()                  -
--  discard()                        -                   discard changes
--  draw()                           -
--  drawLocalObstruction()           -
--  enhance(STRING,BOOLEAN)          -                   enhance the current opening
--  exampleWarning1()                -
--  getPath(DBREF)                   -                   Initialises the current RPATH
--  getRotation()                    -
--  getopenings()                    ARRAY
--  holeCreate()                     -                   Create managed hole
--  holesFromList()                  -                   Create Virtual Holes or WLOPENs for selected Panels/Walls
--  initialise()                     -                   Initialise form.
--  lockPosition(GADGET,STRING)      -                   method for ensuring the user can't lock both positions
--  managedHoleCreate()              BOOLEAN             Create a hole in the hole management system by
--  modify()                         -                   Modify (write modified values to DB)
--  offset()                         -                   when we change the vertical or horizontal offset of an opening
--  openingCopy()                    BOOLEAN             Setup to copy selected opening
--  openingCreate(STRING)            -
--  openingModify(DBREF)             BOOLEAN             Setup to modify opening
--  pickPenetrated()                 -                   Set EDG to pick penetrated items
--  pickPenetratedEvent(EDGPICKDATA) -                   EDG callback for penetrated item pick
--  pickPosition()                   -                   Setup EDG pick event for picking position
--  pickSecondWall()                 -                   EDG to pick the second wall to penetrate
--  pickWall()                       -                   EDG to pick a wall
--  position(EDGPOSITIONDATA)        -                   Get position mapped on to all
--  positionOption()                 -                   Position option to choose explicit or relative
--  projectOpening(DBREF)            -                   Project opening onto wall
--  refresh()                        -
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  removeWallOpening()              -                   Remove a wall opening from the current door/window
--  secondWallOpening()              -
--  selectOpening(ARRAY)             -                   Select Wall from grid
--  selectProjectedWall(EDGPOSITIONDATA) -                   EDG callback after wall pick
--  selectSpec()                     -                   Selecting spec
--  selectWall(ARRAY)                -                   Select Wall from grid
--  setInset(GADGET,STRING)          -                   set the inset of a door or wall
--  setJustLine(REAL)                -                   set a db element in which the door will be placed.
--  setJustLineGadget()              -                   set the justification gadget to the current opening justification
--  setRotation(GADGET,STRING)       -                   set the inset of a door or wall
--  setSecondWall(EDGPICKDATA)       -
--  setSpec()                        -                   Set spec
--  setStorageArea(DBREF)            -                   set a db element in which the door will be placed.
--  showCallingForm()                -                   method for setting visibility of calling form
--  showCreateHole(BOOLEAN)          -                   method for setting visibility of hole panel
--  showCreatePanel(BOOLEAN)         -                   method for setting visibility of edit panel
--  showEditPanel(BOOLEAN,BOOLEAN)   -
--  showHoleMan()                    -                   Show the hole management form
--  showLayoutForm()                 -                   method for setting visibility of layout form
--  showMainPanel(BOOLEAN)           -                   method for setting visibility of main panel
--  showOpeningPanel(BOOLEAN)        -                   method for setting visibility of opening list panel
--  sortopenings()                   -
--  tagopening()                     -
--  tidy()                           -                   Tidy graphics
--  tidyManagedHole()                -
--  tidyWalls()                      -                   Tidy walls
--  updateAttributes(BOOLEAN)        -                   Update gadgets with object data
--  updateData()                     -                   Update current data with gadget values
--  updateGadgets(BOOLEAN)           -
--  updateNumeric(GADGET,STRING)     -                   Numeric gadget callback
--  updatePenetrated(ARRAY)          -                   Update penetrated items list and highlight penetrated items
--  updatePositionGadgets(BOOLEAN)   -
--  updateWallList()                 -                   Get walls from graphic selection
--  updateopeningList()              -
--  useActiveWalls()                 -                   Get walls from current active element
--  useactiveOpenings()              -
--  useselectedWalls()               -
--  warning(ARRAY,STRING,STRING)     -                   Set warning task and message
--  warningDone()                    -                   Exit warning
--
import 'PositionControl'
handle ANY
endhandle

setup form !!accOpeningDefinition dialog docking right

  !this.formTitle     = 'opening Definition'
  !this.iconTitle     = 'opening'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.tidy()'
  !this.formRevision  = ' $Revision$ '

  -- Current hierarchy
  --paragraph .currentOwner                     anchor top + left + right         at x0.5           ymax                width 30 lines 1
  paragraph .activeWall                       anchor top + left + right         at x0.5           ymax                width 30 lines 1
  paragraph .activeOpening                    anchor top + left + right         at x0.5           ymax               width 30 lines 1

  -- Main Task Pane
  frame .mainTaskPane panel                   anchor top + left + right         at x0             ymax.activeOpening

    -- Walls
    paragraph .wallModListTag                 anchor top + left + right         at x0.5           ymax                text 'List of Walls'
    line .wallModL1                           anchor top + left + right         at xmin           ymax                horizontal width 32

    -- List of walls to modify
    container .walls PMLNetCONTROL 'NET'      anchor top + left + right         at x0             ymax                width 32 height 8

    -- Populate list of walls
    button .wmSelection linkLabel 'Graphical selection'   anchor t + l + r      at x2             ymax+0.5            callback '!this.useselectedWalls()'  width 16
    button .wmActive    linkLabel 'Active element walls'  anchor t + l + r      at xmin           ymax                callback '!this.useActiveWalls()'  width 16

    -- Create options
    paragraph .wallselection                                                      at x0.5         ymax      text 'Select Wall to modify'
    line .mainTaskL1 anchor top + left + right                                  at xmin           ymax                horizontal width 32
    button .mtCrt    linkLabel   'Edit Selected Wall'                                    at x2    ymax        callback '!this.showOpeningPanel(true)'
    --line .mainTaskL1a anchor top + left + right                                  at x0.5          ymax                horizontal width 32

    paragraph .editBackIcon                        anchor top + left           at x0              ymax+0.5            pixmap width 16 height 16
    button .crtlayout   linkLabel 'Back to layout tasks'                  at xmax+1           ymin                callback '!this.showLayoutForm()'

    paragraph .editBackIcon1                       anchor top + left           at x0              ymax+0.5            pixmap width 16 height 16
    button .crtedit   linkLabel 'Back to detail tasks'                  at xmax+1           ymin                callback '!this.showCallingForm()'

  exit
  -- End of Main Task Pane

  -- Opening task pane
  frame .openingTaskPane panel                   anchor top + left + right      at x0          ymax.activeOpening

    -- Walls
    paragraph .openingModListTag                 anchor top + left + right      at x0.5         ymax                  text 'List of Openings'
    line .openingModL1                           anchor top + left + right      at xmin         ymax                  horizontal width 32

    -- List of openings to modify
    container .openings PMLNetCONTROL 'NET'      anchor top + left + right         at x0         ymax                width 32 height 8

    -- Create options
    paragraph .createTasks                                                      at x0.5         ymax                width 30 lines 1
    line .oTaskL1                          anchor top + left + right         at xmin            ymax                horizontal width 32
    button .dtCrt         linkLabel 'Door'                                   at x2              ymax                callback '!this.openingCreate(|DOOR|)'
    button .wtCrt         linkLabel 'Window'                                   at x2            ymax                callback '!this.openingCreate(|WINDOW|)'
    button .htCrt         linkLabel 'Managed Hole'                                        at x2             ymax                callback '!this.holeCreate()'

    -- Modify options
    paragraph .modifyTasks                                                      at x0.5         ymax+0.5            width 30 lines 1
    line .mainTaskL2                          anchor top + left + right         at xmin         ymax                horizontal width 32
    button .mtMod         linkLabel 'Opening Definition'                        at x2           ymax                callback '!this.showEditPanel(true,false)'

    -- Copy options
    paragraph .copyTasks                                                        at x0.5         ymax+0.5            width 30 lines 1
    line .mainTaskL3                          anchor top + left + right         at xmin         ymax                horizontal width 32
    button .mtCopy        linkLabel 'Copy Opening'                              at x2           ymax                callback '!this.openingCopy()'

    -- Delete options
    paragraph .deleteTasks                                                      at x0.5         ymax+0.5            width 30 lines 1
    line .mainTaskL4                          anchor top + left + right         at xmin         ymax                horizontal width 32
    button .mtDel         linkLabel 'Delete Opening'                            at x2           ymax                callback '!this.deleteopening()'

    paragraph .wallBackIcon                        anchor top + left           at x0            ymax+0.5            pixmap width 16 height 16
    button .walledit   linkLabel 'Back to Wall Selection'                  at xmax+1            ymin                callback '!this.showMainPanel(true)'

  exit
  -- End of Opening task pane

  -- Edit task panel
  frame .holePane panel                                 anchor top + left + right         at x0             ymax.activeOpening

    container .penWalls PMLNetControl 'NET'             anchor top + left + right         at x0             ymax                width 32 height 6

    paragraph .wallAddIcon                              anchor top + left                 at x0             ymax+0.5            pixmap width 16 height 16
    button .wallAdd       linkLabel 'Add Element'                                         at xmax+1         ymin                callback '!this.managedHoleCreate()'
    paragraph .wallRemIcon                              anchor top + left                 at x0             ymax+0.5            pixmap width 16 height 16
    button .wallRem       linkLabel 'Remove Element'                                      at xmax+1         ymin                callback '!this.removeWallOpening()'

    -- Create opening
    paragraph .holAcceptIcon                            anchor top + left                 at x0             ymax+0.5            pixmap width 16 height 16
    button .holAccept linkLabel 'Manage Hole'           anchor top + left                 at xmax+0.5       ymin+0.1            callback '!this.holesFromList()' width 12

    paragraph .holBackIcon                              anchor top + left                 at x0             ymax+0.5            pixmap width 16 height 16
    button .holMain   linkLabel 'Back to main opening tasks'                              at xmax+1         ymin                callback '!this.showOpeningPanel(true)'

  exit

  frame .editPane panel                             anchor top + left + right   at x0           ymax.activeOpening

    paragraph .editTitle                  anchor top + left + right         at x0.5                   ymax              width 30 lines 1
    line .editPaneL1                  anchor top + left + right         at xmin                   ymax                horizontal width 32

    --frame .attributes FoldUpPanel 'Default attributes' anchor l+t+r   at x0.5   ymax+0.2     width 30 heig 1
      -- Gadgetry definition for creation
      text .dbName  'Name:'  tagwidth 9               anchor top + left + right   at x2           ymax+0.2            callback |!this.checkName(!this.dbName, 'new')| width 20 is STRING
      path down
      halign right
      text .dbDescription 'Description:' tagwidth 9   anchor top + left + right                                         callback '!this.updateGadgets( TRUE ) ' width 20 is STRING
      text .dbFunction 'Function:'       tagwidth 9   anchor top + left + right                                         callback '!this.updateGadgets( TRUE )' width 20 is STRING
      text .dbPurpose  'Purpose:'        tagwidth 9   anchor top + left + right                                         callback '!this.checkWord( !this.dbPurpose )' width 20 is STRING
      numericinput .dbnumber 'Number:'   tagwidth 9   anchor top + left           at xmin                   ymax+0.2            callback '!this.updateNumeric(' range 0 10000 ndp 0 width 4
    --exit

    paragraph .spec                                 anchor top + left + right   at x0.5           ymax+0.2            text 'Specification:' width 28 lines 1
    line .editLine2                                 anchor top + left + right   at xmin           ymax                horizontal width 32
    paragraph .selectedSpec                         anchor top + left + right   at xmin           ymax                width 30 lines 1
    paragraph .specSearchIcon                       anchor top + left           at xmin           ymax            pixmap width 15 height 15
    button    .specSelect  linkLabel  'Select Specification...'  anchor top + left    at xmax+.5    ymin    callback '!this.selectSpec()'     width 30 lines 1

    toggle .occToggle tagwid 26 'Filter selection on ROOM occupancy type'     anchor top + left + right   at x0.5          ymax+0.2

    -- Positioning
    --frame .position      'Positioning'                  anchor top + left    at x0.5          ymax+0.2            width 28 lines 1

    -- Positioning
    paragraph .location                   anchor top + left + right         at x0.5                   ymax+0.2            text 'Location:' width 10
    line .editPaneL2                  anchor top + left + right         at xmin                   ymax                horizontal width 32

      button .pickPosition linkLabel 'Position...'    anchor top + left + right   at x2           ymax     callback '!this.pickPosition()' width 10

      -- XY Offset of floor from building origin

      text .zDistance   'U Distance:'    tagwidth 10             anchor top + left    at x2            ymax+0.5            callback '!this.offset()' width 7 is REAL format !!distanceFmt
      toggle .zLock  tagwid 4 'Lock'  at xmax+0.5 ymin                                                                 callback '!this.lockPosition('
      text .vDistance   'V Distance:'    tagwidth 10            anchor top + left    at xmin.zDistance         ymax+0.2  callback '!this.offset()' width 7 is REAL format !!distanceFmt
      toggle .vLock  tagwid 4 'Lock'   at xmax+0.5 ymin                                                                callback '!this.lockPosition('

      option .wjusl        'Justification:'   tagwidth 12  anchor t + l    at xmin.zDistance                   ymax+0.2         callback '!this.setJustLine(!this.wjusl.val)'     width 6.5
      -- Numeric offset
      numericinput .inset  'Wall Inset:'   tagwidth 12      anchor t + l    at xmin              ymax+0.2     callback '!this.setInset('   range -1000000 1000000 ndp 0 width 7
      numericinput .angle 'Rotation Angle:'   tagwidth 12      anchor t + l    at xmin             ymax+0.2     callback '!this.setRotation('   range -180 180 ndp 0 width 7

    --exit
    -- end of positioning frame

    -- Defaults
    frame .defaults foldUpPanel 'Defaults'          anchor top + left + right   at x0             ymax+0.5            width 32
      combo .clnType 'opening Type:'           tagwidth 10 anchor t + l + r         at xmin           ymax+0.5            width 13
      combo .clnCode 'opening Code:'           tagwidth 10 anchor t + l + r        at xmin           ymax+0.2            width 13
    exit

    -- Positioning
    paragraph .secondWallPara                   anchor top + left + right         at x0.5                   ymax+0.2            text 'Second wall opening:'
    line .editPaneL3                  anchor top + left + right         at xmin                   ymax                horizontal width 32

    -- select second wall to create opening
    button .selSecondWall linkLabel 'Pick Second Wall to create opening'  anchor top + left      at x0.5       ymax+0.2                callback '!this.pickSecondWall()' width 22

    -- Modification data specific to a opening
    frame .modPane panel                            anchor top + left + right   at x0             ymax+0.2

      -- Accept Changes
      paragraph .modAcceptIcon                      anchor top + left           at x0             ymax          pixmap width 16 height 16
      button .modAccept  linkLabel 'Accept Changes' anchor top + left           at xmax+0.5       ymin                callback '!this.modify()' width 10

      -- Discard Changes
      paragraph .modDiscardIcon                     anchor top + right          at xmax+4         ymin                pixmap width 16 height 16
      button .modDiscard linkLabel 'Discard Changes' anchor top + right         at xmax+0.5       ymin                callback '!this.discard()' width 10

      paragraph .modBackIcon                        anchor top + left           at x0             ymax+0.5            pixmap width 15 height 15
      button .modMain   linkLabel   'Back to main opening tasks'                at xmax+1         ymin                callback '!this.showOpeningPanel(true)' width 18

    exit

    -- Creation data specific to a opening
    frame .crtPane panel                            anchor top + left + right   at xmin.modPane   ymin.modPane

      -- Create Floor/opening
      --paragraph .createOptions                      anchor top + left + right   at x0.5           ymax+0.5            text 'Create options' width 28 lines 1
      --line .editLine4                               anchor top + left + right   at xmin           ymax                horizontal width 32

      -- Create opening
      paragraph .crtAcceptIcon                      anchor top + left           at x0             ymax+0.5            pixmap width 16 height 16
      button .crtAccept linkLabel 'Create opening'  anchor top + left           at xmax+0.5       ymin+0.1            callback '!this.create()' width 10

      -- Discard Changes
      paragraph .crtDiscardIcon                     anchor top + right          at xmax+4         ymin                pixmap width 16 height 16
      button .crtDiscard linkLabel 'Discard Changes' anchor top + right         at xmax+0.5       ymin                callback '!this.discard()' width 10

      paragraph .crtBackIcon                        anchor top + left           at x0             ymax+0.5            pixmap width 16 height 16
      button .crtMain   linkLabel 'Back to main opening tasks'                  at xmax+1         ymin                callback '!this.showOpeningPanel(true)' width 18

    exit

  exit
  -- end of edit task panel

  -- Warning Task Pane
  frame .warningPane panel                    anchor top + left + right         at x0             ymax.activeOpening

    paragraph .warningHeader                                                    at x0             ymax                text 'Warning'
    line .warningLine                         anchor top + left + right         at x0             ymax                horizontal width 32
    paragraph .warningIcon                    anchor left + top                 at x0.5           ymax+0.2            pixmap width 32 heigh 32
    paragraph .warning                        anchor left + right + top         at xmax+2         ymin                width 26 lines 6
    button    .warningDone linkLabel 'Continue' anchor left + top               at x0.5           ymax                callback '!this.warningDone()' width 28

  exit

  -- Form Members

  --using namespace 'Aveva.Pdms.Presentation'
  --member .openingPosition is POSITIONCONTROL

  -- Alternative text for owning element type
  member .ownerAltText    is STRING

  -- Owning element
  member .owningElement   is DBREF
  member .ownerType       is STRING

  -- Current Element (opening)
  member .element         is DBREF
  member .elementType     is STRING
  member .definition      is DBEOPENING

   -- Walls for modification
  member .wall            is DBREF
  member .secondWall      is DBREF

  -- !this.wallFeature the element to be used for creating walls and doors
  member .wallFeature     is DBREF

  member .wallList        is ARRAY
  member .wallNames       is ARRAY
  member .openingList     is ARRAY
  member .opening         is DBREF
  member .openingNames    is ARRAY
  member .originPosition  is POSITION
  member .doorPosition    is POSITION
  member .orientation     is ORIENTATION
  member .posRef          is DBREF
  member .path            is DBREF
  member .plane           is PLANE

  using namespace 'Aveva.Pdms.Presentation'
  member .wallGrid        is NETGRIDCONTROL
  using namespace 'Aveva.Pdms.Presentation'
  member .openingGrid     is NETGRIDCONTROL
  using namespace 'Aveva.Pdms.Presentation'
  member .penWallGrid     is NETGRIDCONTROL


  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK
  member .refreshTask     is BLOCK

  -- Warning action
  member .warningAction   is BLOCK

  -- Undo for form
  member .undo            is UNDOABLE


  -- EDG Description
  member .packet                is EDGPACKET
  member .edgDescription        is STRING

  -- Wall Path (as polyline)
  member .polyLine        is PMLPOLYLINE

  -- Aid Numbers
  member .aidNumber       is REAL
  member .aidAxes         is REAL

  member .selectedWall    is DBREF
  member .selectedOpening is DBREF

  -- hole management members
  member .managedHoleProfile  is HMHOLEFROMPROFILE
  member .enhancePenetrated   is ARRAY
  member .hmHole              is HMHOLE

  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
  --!!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accOpeningDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accOpeningDefinition()

  -- Set form to autoScroll
  !this.autoScroll              = true

  -- Collapse foldUp panels
  !this.defaults.expanded       = FALSE

  -- Set events for numeric gadgets
  !this.inset.modifiedEvents   = true
  !this.angle.modifiedEvents   = true
  !this.dbnumber.modifiedEvents   = true

   -- Add .Net control to PML container for Walls
   using namespace 'Aveva.Pdms.Presentation'
  !this.wallGrid              = object NETGRIDCONTROL()
  !this.walls.control         = !this.wallGrid.handle()
  --!this.wallGrid.addEventHandler('onPopup',           !this, 'popupRoom')
  !this.wallGrid.addEventHandler('afterSelectChange', !this, 'selectWall')
  -- Add .Net control to PML container for Walls
   using namespace 'Aveva.Pdms.Presentation'
  !this.openingGrid              = object NETGRIDCONTROL()
  !this.openings.control         = !this.openingGrid.handle()
  --!this.wallGrid.addEventHandler('onPopup',           !this, 'popupRoom')
  !this.openingGrid.addEventHandler('afterSelectChange', !this, 'selectOpening')
  -- Add .Net control to PML container for penetrated walls
  using namespace 'Aveva.Pdms.Presentation'
  !this.penWallGrid           = object NETGRIDCONTROL()
  !this.penWalls.control      = !this.penWallGrid.handle()


  -- Load information from Configuration
  !this.refreshConfig()

  -- Set Spec Icon
  !searchIcon                   = !!pml.getpathname('ng_zoomtodrawlist.png')
  !this.specSearchIcon.addPixmap(!searchIcon)

  -- Set "Back" icon
  !backIcon                     = !!pml.getpathname('back.png')
  !this.crtBackIcon.addPixmap(!backIcon)
  !this.modBackIcon.addPixmap(!backIcon)
  !this.editBackIcon.addPixmap(!backIcon)
  !this.editBackIcon1.addPixmap(!backIcon)
  !this.wallBackIcon.addPixmap(!backIcon)
  !this.holBackIcon.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getpathname('create.png')
  !this.crtAcceptIcon.addPixmap(!createIcon)
  !this.holAcceptIcon.addPixmap(!createIcon)

  -- Add Icons
  !addIcon                      = !!pml.getpathname('draft_t_023.png')
  !this.wallAddIcon.addPixmap(!addIcon)
  -- Remove Icons
  !removeIcon                   = !!pml.getpathname('draft_t_024.png')
  !this.wallRemIcon.addPixmap(!removeIcon)


  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getpathname('accept.png')
  !this.modAcceptIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getpathname('discard.png')
  !this.modDiscardIcon.addPixmap(!discardIcon)
  !this.crtDiscardIcon.addPixmap(!discardIcon)
  -- Set "Warning" icon
  !warningIcon                  = !!pml.getpathname('exclamation-32.png')
  !this.warningIcon.addPixmap(!warningIcon)

  -- EDG Description
  !this.edgDescription    = 'Accommodation opening definition'

  -- Aid number
  --!this.aidNumber       = !!aidNumbers.add('Wall Feature Test Tag')

  -- Assign aid numbers for form
  !this.aidNumber     = !!aidNumbers.add('Opening - position')
  !this.aidAxes           = !!aidNumbers.add('Opening - Axes')

  -- Populate combo with defaults
  --!this.position.val = 2
  --!this.positionOption()


  --****START POSITION CONTROL SECTION****--
  -- Load ship grid data for use with positioning controls (may be this should be a function?)
  !grid                     = object SHIPGRID()
  !gridDefined              = !grid.position.set()

  -- Only populate the grid data is available
  if(!gridDefined) then
    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo
  endif

  !a[1] = 'Left'
  !a[2] = 'Centre'
  !a[3] = 'Right'
  !b[1] = 'LEFT'
  !b[2] = 'CENTRE'
  !b[3] = 'RIGHT'

  !this.wjusl.dtext = !a
  !this.wjusl.rtext = !b



  -------------------- Setup for position control ----------------------
  -- Declare namespace where position control exists
  --using namespace 'Aveva.Pdms.Presentation'

  -- Modify BBLOCK position
  --!this.openingPosition          = object POSITIONCONTROL()

  -- Set grid data (should put all control grid setups in here

  --if (!gridDefined) then
  --  !this.openingPosition.gridData(!xGridData,!yGridData,!zGridData)
  --  !this.openingPosition.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
  --else
  --  !this.openingPosition.gridVisible(FALSE)
  --endif

  -- Assign action to be taken when position is changed
  --!this.openingPosition.changeAction('!!accOpeningsDefinition.offset(3)')

  -- Initialise Gadgets
  --!this.openingPosition.forceXYZ(0,0,0)

  -- Add PMLNet control to PML frame
  --!this.editPosNetFrame.control  = !this.openingPosition.handle()

  -- Set position control to be show in the correct form
  -- Add all control into this block
  --var !coordinate coordinate
  --if(!gridDefined.and(!coordinate.eq('XYZ'))) then
  --  !this.openingPosition.gridFormat()
  --else
  --  !this.openingPosition.enuFormat()
  --endif

  --****END POSITION CONTROL SECTION****--

  -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .showMainPanel
--
-- Description: method for setting visibility of main panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showMainPanel(!action is BOOLEAN)

  !this.mainTaskPane    .visible = !action
  !this.walls           .visible = !action
  !this.openings        .visible = !action.not()
  !this.openingTaskPane .visible = !action.not()
  !this.editPane        .visible = !action.not()
  !this.defaults        .visible = !action.not()
  !this.modPane         .visible = !action.not()
  !this.crtPane         .visible = !action.not()
  --!this.modGeometry     .visible = !action.not()
  !this.warningPane     .visible = !action.not()
  !this.selectedSpec.val = ''

  !this.updateGadgets(FALSE)

  if !action then
    !this.useActiveWalls()
    !this.definition.tidy()
  endif

  !this.activeOpening.val = ''

   !this.formTitle           = 'Select Wall'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .showCallingForm
--
-- Description: method for setting visibility of calling form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showCallingForm()

  !this.tidyWalls()
  --!this.hide()
  !!acctaskmanager.active('accDetail')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .showLayoutForm
--
-- Description: method for setting visibility of layout form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showLayoutForm()

  !this.tidyWalls()
  --!this.hide()
  !!acctaskmanager.active('accLayout')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .lockPosition
--
-- Description: method for ensuring the user can't lock both positions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .lockPosition( !gadget is GADGET, !action is STRING)

  !this.zDistance.active = true
  !this.vDistance.active = true

  if !action.eq('SELECT') then
    if !gadget.eq(!this.zLock) then
       !this.vLock.val        = false
       !this.zDistance.active = false
       !this.vDistance.active = true
    elseif  !gadget.eq(!this.vLock) then
       !this.zLock.val        = false
       !this.vDistance.active = false
       !this.zDistance.active = true
  endif
endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .showOpeningPanel
--
-- Description: method for setting visibility of opening list panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showOpeningPanel(!action is BOOLEAN)

  if !this.modAccept.active then
    !answer = !!alert.question('Changes have been made to this item, do you wish to apply them before navigating away from this pane?')
    if !answer.eq('YES') then
    	!this.definition.tidy()
      !this.modify()
    elseif !answer.eq('NO') then
    	!this.definition.tidy()
      !this.discard()
    else
        -- do nothing
        return
    endif
  endif

  !this.selectedWall = !this.wallGrid.getSelectedRowTags()[1].dbref()
  handle ANY
    !!alert.error('Please Select a wall from the list')
    return
  endhandle
   --make sure there is an element for putting stuff in
  !this.setStorageArea(!!accOpeningDefinition.selectedWall)
  !this.mainTaskPane    .visible = !action.not()
  !this.walls           .visible = !action.not()
  !this.openings        .visible = !action
  !this.openingTaskPane .visible = !action
  !this.editPane        .visible = !action.not()
  !this.holePane        .visible = !action.not()
  !this.defaults        .visible = !action.not()
  !this.modPane         .visible = !action.not()
  !this.crtPane         .visible = !action.not()
  --!this.modGeometry     .visible = !action.not()
  !this.warningPane     .visible = !action.not()
  if !action then
    !this.useactiveOpenings()
  endif

  !this.formTitle           = 'Select Opening'
  !this.activeOpening.val   = ''

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .showEditPanel
--
-- Description: method for setting visibility of edit panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- !action is show or hide
-- mode is new or edit
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showEditPanel(!action is BOOLEAN,!mode is BOOLEAN )


  if !mode.not() then
    --if !this.selectedOpening.unset() then
     !this.selectedOpening = !this.openingGrid.getSelectedRowTags()[1].dbref()
     handle any
       !!alert.error('Please select a valid Opening')
       return
     endhandle
    --endif
  endif

  !assos = !this.selectedOpening.assos
  do !assoc values !assos
    !purpose = !assoc.owner.purp
    if (!purpose eq 'HOLE') then
      !hole = object HMHOLE(!assoc)
      if (!hole.fullStatus eq 'APPROVED') then
        !!alert.error('The selected opening has an APPROVED hole management association. You must modify the status before making any modifications to the opening')
        !this.showHoleMan()
        return
      else
        !!alert.warning('The selected opening has a hole management association. If you modify the opening you will need to modify the hole definition')
        !this.showHoleMan()
      endif
    endif
  enddo

  --make sure thre is an element for putting stuff in
  !this.setStorageArea(!!accOpeningDefinition.selectedWall)

  !this.mainTaskPane    .visible = !action.not()
  !this.walls           .visible = !action.not()
  !this.openings        .visible = !action.not()
  !this.openingTaskPane .visible = !action.not()
  !this.editPane        .visible = !action
  --!this.explicit.active = FALSE
  !this.defaults        .visible = !action.not()
  !this.modPane         .visible = !action
  !this.crtPane         .visible = !action.not()
  !this.warningPane     .visible = !action.not()
  !this.selSecondWall   .visible = !action.not()
  !this.secondWallPara  .visible = !action.not()
  !this.editPaneL3      .visible = !action.not()

  !this.modAccept.callback   = |!this.modify()|

  -- create the object to deal with the element attributes
  !this.definition = object DBEOPENING(!this.selectedOpening)

  --check if wall is owned by room, if so allow 'filter on occupancy type'
  !this.checkOwner()

  if !this.definition.posRef.set() then
     !this.updatePositionGadgets(TRUE)
  else
     !this.updatePositionGadgets(FALSE)
  endif

   -- Change form title to reflect the active pane
  !this.formTitle           = 'Modify Opening'

  if (!this.selectedOpening.type eq 'DOOR') then
    !this.specSelect.tag = 'Select Door Specification...'
  elseif (!this.selectedOpening.type eq 'WINDOW') then
    !this.specSelect.tag = 'Select Window Specification...'
  endif

  -- Edit panel title
  !this.editTitle.val         = !this.selectedOpening.type & ': ' & !this.selectedOpening.namn
  !this.definition.aidNumbers(!this.aidNumber, !this.aidAxes)
  -- go and populate the form gadgets
  !this.updateAttributes(!mode.not())
  -- set the accept/discard changes to invisible
  !this.updateGadgets(FALSE)

    if !this.definition.posRef.set() then
     !this.updatePositionGadgets(TRUE)
  else
     !this.updatePositionGadgets(FALSE)
  endif

  -- tag current opening
  !this.tagopening()

endmethod

------------------------------------------------------------------------------------------------------------------------------------------------
--
-- Method:      .showCreatePanel
--
-- Description: method for setting visibility of edit panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showCreatePanel(!action is BOOLEAN)

  !this.mainTaskPane    .visible = !action.not()
  !this.walls           .visible = !action.not()
  !this.openings        .visible = !action.not()
  !this.openingTaskPane .visible = !action.not()
  !this.editPane        .visible = !action
--  !this.explicit        .active  = FALSE
  !this.defaults        .visible = !action.not()
  !this.modPane         .visible = !action
  !this.crtPane         .visible = !action.not()
  !this.warningPane     .visible = !action.not()
  !this.selSecondWall   .visible = !action
  !this.secondWallPara  .visible = !action
  !this.editPaneL3      .visible = !action

  --check if wall is owned by room, if so allow 'filter on occupancy type'

  !this.checkOwner()

 -- !this.position.callback    = '!this.positionOption()'

  -- set the accept/discard changes to invisible
  !this.updateGadgets(FALSE)

  -- go and populate the form gadgets
  !this.updateAttributes(FALSE)
  !this.activeOpening.val = ''

endmethod
------------------------------------------------------------------------
--
-- Method:      .showCreateHole
--
-- Description: method for setting visibility of hole panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showCreateHole(!action is BOOLEAN)

  !this.mainTaskPane    .visible = !action.not()
  !this.walls           .visible = !action.not()
  !this.openings        .visible = !action.not()
  !this.openingTaskPane .visible = !action.not()
  !this.editPane        .visible = !action.not()
--  !this.explicit        .active  = FALSE
  !this.defaults        .visible = !action.not()
  !this.modPane         .visible = !action.not()
  !this.crtPane         .visible = !action.not()
  !this.warningPane     .visible = !action.not()
  !this.holePane        .visible = !action

 -- !this.position.callback    = '!this.positionOption()'
  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('Name')
  !attributes.append('Position')
  !attributes.append('Plane Position')
  !attributes.append('Plane Orientation')
  !attributes.append('Managed')

  !penetratedArr  = ARRAY()


  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds                = object NETDATASOURCE('PenWalls', !attributes, !penetratedArr)

  !this.penWallGrid.bindToDataSource(!nds)

  -- set the accept/discard changes to invisible
  !this.updateGadgets(FALSE)

  -- go and populate the form gadgets
  !this.updateAttributes(FALSE)

  -- tag current opening
  !this.tagopening()

endmethod

------------------------------------------------------------------------
--
-- Method:      checkOwner
--
-- Description: Check owner of opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .checkOwner()

  if (!this.definition.wall.owner.owner.type eq 'ROOM') and (!this.definition.elementType eq 'DOOR') then
    !this.occToggle.visible = TRUE
    !this.occToggle.val = FALSE
  else
    !this.occToggle.visible = FALSE
   endif

endmethod

------------------------------------------------------------------------
--
-- Method:      positionOption
--
-- Description: Position option to choose explicit or relative
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .positionOption()
return

 !indx =  !this.position.val
 !selection = !this.position.rtoggle(!indx)
 if(!selection.tag.upcase().matchwild('*EXPLICIT*'))then
  !this.expliPosition.visible = true
  !this.relPosition.visible = false
 else
  !this.expliPosition.visible = false
  !this.relPosition.visible = true
 endif

endmethod

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()


  -- Get current element
  !element                = !!accNavigator.currentSelection()

  -- If element is unset, then initialise form with limited actions
  if(!element.unset()) then
    !this.owningElement         = object DBREF()

  -- Initialise form with relevant actions
  else
    -- Set owner where layout data is to be stored
    !this.owningElement         = !element
    !this.ownerType             = !this.owningElement.type
  endif

  !this.showMainPanel(TRUE)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- opening Tasks
  !this.createTasks.val         = 'Create'
  !this.modifyTasks.val         = 'Modify'
  !this.copyTasks.val           = 'Copy'
  !this.deleteTasks.val         = 'Delete'


    -- Grid defaults
  !columnExcelFilter            = !!accConfig.navigator.columnExcelFilter
  !outlookGroupStyle            = !!accConfig.navigator.outlookGroupStyle
  !columnSummaries              = !!accConfig.navigator.columnSummaries
  !labelVisibility              = !!accConfig.navigator.labelVisibility

   -- Control configuration (Rooms)
  !this.wallGrid.columnExcelFilter(!columnExcelFilter)
  !this.wallGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.wallGrid.columnSummaries(!columnSummaries)
  !this.wallGrid.fixedHeaders(FALSE)
  !this.wallGrid.fixedRows(FALSE)
  !this.wallGrid.singleRowSelection(TRUE)
  !this.wallGrid.setLabelVisibility(!labelVisibility)


  !this.openingGrid.columnExcelFilter(!columnExcelFilter)
  !this.openingGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.openingGrid.columnSummaries(!columnSummaries)
  !this.openingGrid.fixedHeaders(FALSE)
  !this.openingGrid.fixedRows(FALSE)
  !this.openingGrid.singleRowSelection(TRUE)
  !this.openingGrid.setLabelVisibility(!labelVisibility)

  !this.penWallGrid.columnExcelFilter(!columnExcelFilter)
  !this.penWallGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.penWallGrid.columnSummaries(!columnSummaries)
  !this.penWallGrid.fixedHeaders(FALSE)
  !this.penWallGrid.fixedRows(FALSE)
  !this.penWallGrid.singleRowSelection(TRUE)
  !this.penWallGrid.setLabelVisibility(!labelVisibility)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      holeCreate
--
-- Description: Create managed hole
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .holeCreate()

  -- Initialise Variables
  !this.formTitle = 'Create Managed Hole'

  !this.showCreateHole(TRUE)

  -- Setup panes
  !this.createHole(TRUE)

  -- Load the managed hole grid with existing associations
  !assos = !this.opening.assos
  do !assoc values !assos
    if (!assoc.owner.purp eq 'HOLE') then
      !hole = object HMHOLE(!assoc)
      !this.hmHole = !hole
      if (badref(!hole.holeOwner))then
        !!alert.error('The managed hole is incorrectly set up. Please check using the hole management form')
        !this.showHoleMan()
        return
      elseif (!hole.holeOwner.set()) then
        !penetrated     = ARRAY()
        !penetrated.append(!hole.holeOwner.flnm)
        !penetrated.append('N/A')
        !penetrated.append('N/A')
        !penetrated.append('N/A')
        !penetrated.append('TRUE')
        !this.penWallGrid.addRow(!penetrated)
      endif
      if (!hole.extraWallOpening.set()) then
        !penetrated     = ARRAY()
        !penetrated.append(!hole.extraWallOpening.amemrf.flnm)
        !penetrated.append('N/A')
        !penetrated.append('N/A')
        !penetrated.append('N/A')
        !penetrated.append('TRUE')
        !this.penWallGrid.addRow(!penetrated)
      endif
      break
    endif
  enddo
  if (!this.penWallGrid.getRows().size() eq 2) then
    !!alert.message('The hole opening is already fully managed')
    !this.wallAdd.active   = FALSE
    !this.wallRem.active   = TRUE
  elseif (!this.penWallGrid.getRows().size() eq 1) then
    !this.wallAdd.active   = TRUE
    !this.wallRem.active   = TRUE
  else
    !this.wallAdd.active   = TRUE
    !this.wallRem.active   = TRUE
  endif

  !this.holAccept.active = FALSE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      openingCreate
--
-- Description: Create opening
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .openingCreate(!type is STRING )

  -- Initialise Variables

  !this.secondWall  = object DBREF()

  !this.definition  = object DBEOPENING()

  -- grey out the positioning gadgets until the position reference has been set
  !this.updatePositionGadgets(FALSE)
  if(!type.eq('DOOR'))then
    !this.vDistance.val    = !!accConfig.dDoorSill
  elseif(!type.eq('WINDOW'))then
    !this.vDistance.val    = !!accConfig.dWindowSill
  endif
  !this.vDistance.active = false
  !this.vLock.val        = true
  !this.vLock.active     = false

  !this.definition.elementType = !type

  -- Change form title and spec link button to reflect the active pane
  !this.formTitle           = 'Create $!type'
  if (!type eq 'DOOR') then
    !this.specSelect.tag = 'Select Door Specification...'
  elseif (!type eq 'WINDOW') then
    !this.specSelect.tag = 'Select Window Specification...'
  endif

  !this.showCreatePanel( TRUE )

  -- Edit panel title
  !this.editTitle.val         = 'New $!type for ' & !this.selectedWall.flnm

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidNumber, !this.aidAxes)

  -- Update gadgets
  !this.updateAttributes(FALSE)

  -- Setup panes
  !this.createOpening(true)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      createOpening
--
-- Description: Display opening pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createOpening(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then
    !this.secondWall  = object DBREF()
    -- Manage create/modify panels
    ---*************************************
    --!this.showEditPanel(TRUE,TRUE)
    !this.modPane.visible     = FALSE
    !this.crtPane.visible     = true
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
 -- !this.editPane.visible      = !active

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      createHole
--
-- Description: Display hole pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createHole(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Manage create/modify panels
    !this.modPane.visible     = FALSE
    !this.crtPane.visible     = FALSE
    !this.holePane.visible    = TRUE

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
 -- !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      openingModify
--
-- Description: Setup to modify opening
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       opening to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .openingModify(!element is DBREF) is BOOLEAN

  -- Load current element
  !this.element             = !element

  -- Set definition
  !this.definition          = object DBEOPENING(!element)

  if !this.definition.posRef.set() then
     !this.updatePositionGadgets(TRUE)
  else
     !this.updatePositionGadgets(FALSE)
  endif

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidNumber, !this.aidAxes)



  -- Update gadgets
  !this.updateAttributes(FALSE)

  !this.tagopening()
  -- Setup panes
  --!this.modifyOpening(true)

  return true

endmethod
-- End of method
