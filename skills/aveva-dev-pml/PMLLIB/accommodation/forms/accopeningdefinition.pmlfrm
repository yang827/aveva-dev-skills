--
-- Method:      tag
--
-- Description: Tag current level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

--define method .tag()

  -- Display Axes
  --!axes             = object GPHAXES(!this.doorPosition, !this.plane.orientation)
  --!axes.description = ' ' & !this.doorPosition
  --!axes.tag         = true
  --!axes.detail      = FALSE
  --!axes.draw(!this.aidAxes)

--endmethod
-- End of method definition for .tag()

------------------------------------------------------------------------
--
-- Method:      updateWallList
--
-- Description: Get walls from graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateWallList()

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('NAME')
  !attributes.append('WThickness')
  !attributes.append('Height')
  --!attributes.append('Justification')

  -- Load grid
  if !this.wallList.empty().not() then
    !block                  = object BLOCK('!this.wallList[!evalIndex].string()')
    !dbNames                = !this.wallList.evaluate(!block)
    !this.wallNames         = !dbNames

    using namespace 'Aveva.Pdms.Presentation'
    !nds                = object NETDATASOURCE('Walls', !attributes, !dbNames)

    !this.wallGrid.bindToDataSource(!nds)
    !a = ARRAY()
    !this.wallGrid.setSelectedRowTags(!a)

     if !dbNames.size().eq(1) then
       -- there is only one item to select, so we might as well select it
       !this.wallGrid.setSelectedRowTags(!dbNames )
     endif
  else
    !this.activeWall.val = 'Active Wall:'
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateOpeningList
--
-- Description: Get walls from graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateopeningList()

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('TYPE')
  !attributes.append('NAME')
  !attributes.append('SPREF')
  --!attributes.append('Justification')

  -- Load grid
  if(!this.openingList.empty().not()) then
    !block                  = object BLOCK('!this.openingList[!evalIndex].string()')
    !dbNames                = !this.openingList.evaluate(!block)
    !this.openingNames      = !dbNames

    using namespace 'Aveva.Pdms.Presentation'
    !dataSource                = object NETDATASOURCE('Openings', !attributes, !dbNames)
    !this.openingGrid.bindToDataSource(!dataSource)
    !a = ARRAY()
    -- !this.openingGrid.setSelectedRowTags(!this.openingNames)
    !this.openingGrid.setSelectedRowTags(!a)

    if !dbNames.size().eq(1) then
       -- there is only one item to select, so we might as well select it
      !this.openingGrid.setSelectedRowTags(!dbNames )
      !this.tagopening()
      return
    else
        !this.activeOpening.val = ''
    endif

    -- if we are at an element which is in the list then we need to update the list
    !this.refresh()


  else
      !this.selectedOpening = object DBREF()
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:     updateNumeric
--
-- Description: Numeric gadget callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateNumeric(!gadget is GADGET, !dummyval is STRING)

  !this.updateGadgets(TRUE)

endmethod

------------------------------------------------------------------------
--
-- Method:      selectWall
--
-- Description: Select Wall from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectWall(!passedArray is ARRAY)

  if !passedArray.size().eq(0) then
     return
  endif
  !this.selectedWall = !this.wallGrid.getSelectedRowTags()[1].dbref()
  handle ANY
    return
  endhandle
  !aWall = !this.selectedWall.flnn
  !this.activeWall.val = 'Active Wall: ' & !aWall
  --!this.activeOpening.val = ''

  -- Unenhance walls
  !this.tidyWalls()

  -- Initialise Variable
  !elements = !this.wallGrid.getSelectedRowTags()
  !list     = !this.wallNames

  enhance all from !elements colour red

  -- get the current RPATH
  !this.getPath(!this.selectedWall)

  -- get the current wall feature
  !this.setStorageArea(!!accOpeningDefinition.selectedWall)
  handle ANY
  endhandle

  -- Set definition
  !this.definition            = object DBEOPENING()
  !this.definition.aidNumbers(!this.aidNumber, !this.aidAxes)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectOpening
--
-- Description: Select Wall from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectOpening(!passedArray is ARRAY)

  -- Unenhance walls
  !this.tidyWalls()
  aid clear text all

  -- Initialise Variable
  !elements = !this.openingGrid.getSelectedRowTags()
  !list     = !this.openingNames
  !opening  = !elements[1].dbref()
  handle any
    return
  endhandle
  !this.opening = !opening
  !this.selectedOpening = !opening
  !this.tagopening()

endmethod

------------------------------------------------------------------------
--
-- Method:      tagOpening
--
-- Description: tag the current door.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagopening()

  !this.definition.tidy()
  !textDescription = !this.opening.flnn
  handle ANY
    -- current opening not set
    !this.activeOpening.val = ''
    return
  endhandle

  !this.activeOpening.val = 'Active Opening: ' & !textDescription
  !position = !this.opening.position
  !position.wrt(/* )
  AID TEXT NUMBER $!<this.aidNumber> '$!textDescription' at $!position
  !elements[1] = !this.opening.string()
  !this.enhance('GREEN',TRUE )
  -- enhance all from !elements colour green

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      selectSpec
--
-- Description: Selecting spec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectSpec()

 -- if we are not editing a current item we need to store the spref and definition in the definition object
  !!stChooseData.cleardata()

  !!stChooseData.settitle('Opening Type')
  !!stChooseData.setdata('ROOM', !this.definition.elementType)

  !owningElement = !this.definition.wall.owner.owner

  --if ((!this.definition.elementType eq 'DOOR') and (!this.owningElement.fulltype eq 'ROOM')) then
  if ((!this.occToggle.val eq TRUE) and (!this.definition.elementType eq 'DOOR') and (!owningElement.fulltype eq 'ROOM')) then
    !!stChooseData.questions[1] = 'OCCU'
    !!stChooseData.answers[1]   = !owningElement.occType
  endif

  !!stChooseData.setTable()

  show !!stChooseSelection

  !!stChooseSelection.action = object BLOCK('!!' & !this.name() & '.setSpec()')

endmethod
-- End of method
-----------------------------------------------------------------------
--
-- Method:      setSpec
--
-- Description: Set spec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING      Element to be created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpec()

  --!tabItem       = !!stChoose.netSelTabItems.getSelectedRows()[1][1]
  !tabItem       = !!stChooseSelection.netSelTabItems.getSelectedRows()[1][1]
  !tabItemString = '/' & !tabItem
  !tabItemDbref  = !tabItemString.dbref()
  -- tabItem may be unnamed
  handle ANY
    !tabItemDbref  = !tabItem.dbref()
  endhandle
  !selectedSpec = !tabItemDbref.prtref.name

  if !this.definition.opening.unset() then
    !this.definition.setSpref(!selectedSpec.dbref())
    !this.definition.inset  = !this.definition.spref.rprop.iset
    handle ANY
    elsehandle NONE
      !this.inset.val = !this.definition.inset
    endhandle
  else
    !this.definition.opening.spref = !selectedSpec.dbref()
  endif

  !this.selectedSpec.val = 'Component: ' & !selectedSpec
  !this.updateGadgets( TRUE )

endmethod
-- End of method
-----------------------------------------------------------------------
--
-- Method:      pickPosition
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPosition()

  -- Initialise Variables
  !prompt               = 'Pick position'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = TRUE
  !packet.action        =  '!!' & !this.name() & '.position(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Get position mapped on to all
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA EDG Picked position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!data is EDGPOSITIONDATA)

    -- go and get the appropriate path
    !this.getPath(!this.selectedWall)

    -- Initialise Variables
    -- actual position picked
    !actualPosition            = !data.position.wrt(World)

    -- get the position on the path
    !this.doorPosition        = !this.polyLine.near(!actualPosition)
    if !this.doorPosition.unset() then
      return
    endif
    !rPath                    = object RPATHPOSITIONING(!this.path)
    !rPath.setPositionNear(!this.doorPosition, FALSE)
    !this.posRef              = !rPath.referencePoint
    if !this.zLock.val.not() then
      !this.zDistance.val     = !rPath.zDistance
    endif
    !plane = object PLANE()
    !plane.position = !actualPosition
    !ori = Z is D wrt world
    !plane.orientation = !ori
    !distance = !this.doorPosition.distance(!plane)
    --  Position when offset
    !this.originPosition    = !this.doorPosition.offset(U wrt World, !distance)
    !vDistance              = !this.doorPosition.distance(!this.originPosition )
    if !this.vLock.val.not() then
      !this.vDistance.val   = !vDistance
    endif
    -- set the position reference
    !this.definition.posRef                   = !this.posRef
    if !this.definition.wallOpening.set() then
       !this.definition.wallOpening.posRef    = !this.posRef
       !this.offset()
    endif

   -- set the create gadget to true so that we can create something
   !this.updateGadgets( TRUE )
   !this.updatePositionGadgets(TRUE)

    -- Draw
    !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     .offset
--
-- Description: when we change the vertical or horizontal offset of an opening
--              we need to re-position the graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .offset()

    -- this method sets the vdistance and zdistance directly if the element has been defined
    -- if its not been defined yet then it needs to move the notional position and update the draw routine
    -- if the definition is not defined then we need to re-calculate the position based on the
    -- vdistance and zdistance relative to the pos ref
    -- first test if we have the right things set

   if !this.definition.wallOpening.unset() then
     !this.calculateNewPosition()
     !this.draw()
   else
     !this.definition.wallOpening.vDistance = !this.vDistance.val
     handle ANY
       -- this.definition has not been set yet
       return
     endhandle
     !this.enhance('GREEN',TRUE )
    !this.definition.wallOpening.zDistance = !this.zDistance.val
   endif

-- set the create gadget to true so that we can create something
!this.updateGadgets( TRUE )

endmethod

-----------------------------------------------------------------------
--
-- Method:      calculateNewPosition
--
-- Description: Calculate the new positions based on a change of the vdistance and zdistance gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calculateNewPosition()

    if !this.posRef.unset() then
      return
    endif

   !nextPoint = !this.posRef.owner.members[!this.posRef.order + 1]
   -- handle closed walls
   handle ANY
     !nextPoint = !this.posRef.owner.members[1]
   endhandle

   -- construct a point vector from the at the position point pointing towards the next point
   var !dir dir from $!this.posRef to $!nextPoint
   !pv1 = object POINTVECTOR(!this.posRef.position, !dir.direction())
   !pv2 = !pv1.offset(!this.zDistance.val)
   !this.doorPosition = !pv2.position.wrt(/* )
   !pv2.direction = up wrt /*
   !pv3 = !pv2.offset(!this.vDistance.val)
   !this.originPosition = !pv3.position.wrt(/* )

endmethod

-----------------------------------------------------------------------
--
-- Method:      getPath
--
-- Description: Initialises the current RPATH
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getPath(!wall is DBREF)

 !this.path  = RPATH 1 of $!wall
  handle ANY
    !!alert.error('Cannot find a suitable RPATH for selected wall')
    !this.path = DBREF()
    return
  endhandle
  !this.polyLine   = object PMLPOLYLINE(!this.path)

endmethod

-----------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Tag position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Initialise Variables
  !this.definition.tidy()

  !this.definition.draw(!this.zDistance.val,!this.vDistance.val)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setStorageArea
--
-- Description: set a db element in which the door will be placed.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .setStorageArea(!wall is DBREF)

   !this.wallFeature = !!accwallFeat(!wall, 'OPEN', 'Doors and Windows')

endmethod

------------------------------------------------------------------------
--
-- Method:      setInset
--
-- Description: set the inset of a door or wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .setInset(!gadget is GADGET, !select is STRING)

-- method to apply a numeric offset to the door/window
-- sets the position based on an offset
!this.applyInset(!this.inset.val)

endmethod

------------------------------------------------------------------------
--
-- Method:     applyInset
--
-- Description: set the inset of a door or wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .applyInset(!val is REAL)

--!pos = !this.definition.opening.position.wrt(!this.definition.opening.owner)
!pos = !this.definition.opening.position
handle ANY
  return
endhandle
!pos.north = !val
!this.definition.opening.position = !pos
-- should update the position control but this does not do it
--!this.opening.position = !pos
 !this.updateGadgets(TRUE )

endmethod
------------------------------------------------------------------------
--
-- Method:      GetRotation
--
-- Description: get the rotation of door or window
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .getRotation()

!ori = !this.definition.opening.orientation
handle ANY
  !number = 0
  !this.angle.val = !number
  return
endhandle
--Orientation Y is W 13 D and Z is N  is positive 13
--Orientation Y is W 12 U and Z is N  is negative 13
!number = !ori.string().split()[4].real()
handle ANY
  !number = 0
endhandle
if !ori.string().split()[5].match('-').gt(0) then
  !number = !number * -1
endif
!this.angle.val = !number
handle ANY
endhandle


endmethod

------------------------------------------------------------------------
------------------------------------------------------------------------
--
-- Method:      setRotation
--
-- Description: set the inset of a door or wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .setRotation(!gadget is GADGET, !select is STRING)

-- sets the position based on an offset
!this.applyRotation(!this.angle.val)

endmethod

-------------------------------------------------------
--
-- Method:      ApplyRotation
--
-- Description: set the rotation of a door or window
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .applyRotation(!val is REAL)

-- basic orientation is this
-- Orientation Y is W and Z is N
-- minus orientation moves anticlockwise
-- positive orientation moves clockwise
-- Convert angle into an orientation
  !newValue     = !val
  !orientation  = object ORIENTATION('Y is W ' & !newValue & 'U and Z is N' )
  !orientation.origin = !this.definition.wallOpening
  !this.definition.opening.orientation = !orientation
  handle ANY
  endhandle
  !this.updateGadgets(TRUE )

endmethod

------------------------------------------------------------------------
--
-- Method:      setJustLine
--
-- Description: set a db element in which the door will be placed.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .setJustLine(!number is REAL)

  if !number.eq(1) then
    !this.definition.wjusl = 'LEFT'
  elseif !number.eq(2) then
    !this.definition.wjusl = 'CENTRE'
  else
    !this.definition.wjusl = 'RIGHT'
  endif

  !this.definition.wallOpening.wjusl =  !this.definition.wjusl
  handle ANY
    -- the wall opening has not been created yet
  endhandle
  -- set something to signal update
  !this.updateGadgets(TRUE )
  !this.draw()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setJustLineGadget
--
-- Description: set the justification gadget to the current opening justification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .setJustLineGadget()

!just = !this.definition.wjusl
handle ANY
 return
endhandle
if !just.eq('LEFT') then
  !this.wjusl.val = 1
elseif !just.eq('CENT') then
  !this.wjusl.val = 2
else
  !this.wjusl.val = 3
endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:     updateGadgets
--
-- Description: set the accept changes gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .updateGadgets( !action is BOOLEAN    )

  !this.modAcceptIcon  .active   = !action
  !this.modAccept      .active   = !action
  !this.modDiscardIcon .active   = !action
  !this.modDiscard     .active   = !action

endmethod

------------------------------------------------------------------------
--
-- Method:     updatePositionGadgets
--
-- Description: set the position gadgets to work
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .updatePositionGadgets( !action is BOOLEAN    )

  if !this.vLock.val OR !this.zLock.val then
    !this.vDistance  .active   = !action
	  !this.zDistance  .active   = !action
  else
	  !this.vDistance  .active   = !action
	  !this.zDistance  .active   = !action
  endif

  --!this.vDistance  .active   = !action
  !this.vLock      .active   = !action
  --!this.zDistance  .active   = !action
  !this.zLock      .active   = !action
  !this.wjusl      .active   = !action
  !this.inset      .active   = !action
  !this.angle      .active   = !action

  --!this.vLock.val = false
  !this.zLock.val = false

endmethod

------------------------------------------------------------------------
--
-- Method:      draws a local obstruction around the design item
-- for development at present
--
-- Description: draw the shape of the current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .drawLocalObstruction()

!e = object LOCALVOLUME(!this.definition.opening, !this.definition.opening)
!p = object GPHBOX(!e.box())
!p.draw(1)

endmethod

$(
------------------------------------------------------------------------
--
-- Method:      sortOpenings
--
-- Description: sort the openings so that they are in order along the wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .sortopenings()

return

     !this.deleteEmptyOpenings()
     !openings = !this.getopenings()

     do !a index !openings
       !current[!a] = !openings[!a].posRef.order
       handle ANY
         return
       endhandle
     enddo
     !newIndex = !current.sortedindices()
     !openings.reindex(!newIndex)
     !save = !!ce
     !!ce = !this.wallFeature
     do !a from 2 to !openings.size()
       !prev = !a - 1
       reorder $!openings[$!a] after $!openings[$!prev]
     enddo

     -- now go and sort by zDistance
     !openings = !this.getopenings()
     !sort = ARRAY() !final = ARRAY()
     do !a from 2 to !openings.size()
       if !openings[!a].posRef.eq(!openings[!a - 1].posRef) then
          !sort.append(!openings[!a - 1])
          !sort.append(!openings[!a])
          !sort.unique()
       else
          if !sort.size().gt(1) then
             !final.append(!sort)
             !sort = ARRAY()
          endif
       endif
     enddo
     !final.append(!sort)

     !!ce = !save
     handle ANY
     endhandle

endmethod
$)
------------------------------------------------------------------------
--
-- Method:      getOpenings
--
-- Description: get all the openings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .getopenings()is ARRAY

-- Collect wall openings from groups owned by the active element
    !collection     = object COLLECTION()
    !collection.addType('WLOPEN')
    !collection.scope(!this.wallFeature)
    handle ANY
     -- in case its not set
       return
    endhandle
    return  !collection.results()

endmethod

------------------------------------------------------------------------
--
-- Method:      DeleteEmptyOpenings
--
-- Description: sort the openings so that they are in order along the wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .deleteEmptyOpenings()

  !openings = !this.getopenings()
  do !a values !openings
     if !a.posRef.unset().or(!a.posRef.badref()) then
       $!a
       delete WLOPEN
     endif
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      pickWall
--
-- Description: EDG to pick a wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickWall()

 -- Initialise Variables
  !prompt               = 'Pick penetrated wall'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = TRUE
  !packet.action        =  '!!' & !this.name() & '.selectProjectedWall(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      selectProjectedWall
--
-- Description: EDG callback after wall pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectProjectedWall(!data is EDGPOSITIONDATA)

  !wall = !data.item
  if !wall.type.neq('CTWALL') then
    !!alert.error('Please Identify a wall')
  endif
  !this.projectOpening(!wall)

endmethod

------------------------------------------------------------------------
--
-- Method:      projectOpening
--
-- Description: Project opening onto wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .projectOpening(!wall is DBREF)


 --new method for projecting an opening onto a wall
   -- go and get the appropriate path
  !this.getPath(!wall)

  -- Initialise Variables
  -- actual position picked
  !actualPosition             = !this.opening.position.wrt(World)

  -- get the position on the path
  !openingPosition    = !this.polyLine.near(!actualPosition)
  if !openingPosition.unset() then
    return
  endif
  !rPath                  = object RPATHPOSITIONING(!this.path)
  !rPath.setPositionNear(!openingPosition, FALSE)

  !plane = object PLANE()
  !plane.position = !actualPosition
  !ori = Z is D wrt world
  !plane.orientation = !ori
  !distance = !openingPosition.distance(!plane)
  --  Position when offset
  !originPosition  = !openingPosition.offset(U wrt World, !distance)
  !vDistance       = !openingPosition.distance(!originPosition )

 -- set the create gadget to true so that we can create something

  --!this.updateAttributes()
  -- Draw
  !this.draw()
  -- Set definition
  !collect = object COLLECTION()
  !collect.scope(!wall)
  !collect.filter(object EXPRESSION('Description eq |Doors and Windows|'))
  !collect.type('WLFEAT')

  if (!collect.results().size() gt 0) then
  	!wallFeat = !collect.results()[1]
  	!!ce = !wallFeat
  else
  	!!ce = !wall
  	NEW WLFEAT
  	!!ce.desc = 'Doors and Windows'
  endif

  NEW WLOPEN
  !newOpening = !!ce
  !newOpening.wJusLine  = !wall.wJusLine
  !newOpening.zDistance = !rPath.zDistance
  !newOpening.posRef    = !rPath.referencePoint
  !newOpening.vertDirection = TRUE

  !!ce = !this.opening.owner
  RPATH 1
  !profile = object PROFILE(!!ce)

  !!ce = !newOpening
  NEW RPATH
  !profile.dbWrite(!!ce)
  -- add the new wall opening to the association
  !control = object HMCONTROL()
  !control.addMemberToHole(!this.hmHole,!newOpening,'extraWallOpening')

endmethod

------------------------------------------------------------------------
--
-- Method:      pickSecondWall
--
-- Description: EDG to pick the second wall to penetrate
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickSecondWall()

  -- Define packet for second wall
  !packet                = object EDGPACKET()
  !packet.initialisation = '!!accOpeningDefinition.secondWall = object DBREF()'
  !packet.pickPacket.stdGraphic('Pick Second wall to create opening')
  !packet.description    = 'Pick Second wall'
  !packet.action         = '!!' & !this.name() & '.setSecondWall(!this.return[1])'
  --<mjb>Jun2010 P-30740 Allow pick of panelled wall
  !packet.pickPacket.picks[1].pick.input[3]   = 'HARDTYPE inset(|CTWALL|,|WLPANE|)'
  !packet.pickPacket.picks[1].pick.modifiable = false

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      setSecondWall
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSecondWall(!data is EDGPICKDATA)

  if(!data.item.badref() or !data.item.unset()) then
    !this.secondWall = object DBREF()
    !!alert.error('Please Identify a wall')
    return
  endif

  --<mjb>Jun2010 P-30740 Allow pick of panelled wall
  !pickedObject = !data.item
  !type = !pickedObject.type
  if (!type eq 'CTWALL') then
      !this.secondWall = !pickedObject
  elseif (!type eq 'WLPANE') then
      !this.secondWall = !pickedObject.owner.owner
  endif

  if(!this.secondWall.eq(!this.selectedWall)) then
    !this.secondWall = object DBREF()
    !!alert.error('Selected Wall and Picked wall are same. Pick a different wall.')
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:       secondWallOpening
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .secondWallOpening()

  -- return if no second wall set
  if !this.secondWall.unset() then
	  return
  endif

  !collection  = object COLLECTION()
  !collection.scope(!this.secondWall)
  !collection.type('RPATH')

  -- return if the wall profile (layout) is not defined
  if (!collection.results().size() eq 0) then
    return
  endif

  !rPath = !collection.results().last()
  !polyLine   = object PMLPOLYLINE(!rPath)

  -- change the opening position to the new position on the picked wall
  !actualPosition             = !this.definition.opening.position.wrt(World)

  -- get the position on the path
  !doorPosition    = !polyLine.near(!actualPosition)
  if !doorPosition.unset() then
    return
  endif
  !path                  = object RPATHPOSITIONING(!rPath)
  !openingPossible  = !path.setPositionNear(!doorPosition, FALSE)
  if(!openingPossible.not()) then
    return
  endif

  !referencePoint  = !path.referencePoint
  !zDistance       = !path.zDistance

  --!nextPoint  = !referencePoint.owner.member[!referencePoint.seq + 1]
  --handle ANY
  --  -- cannot create an opening here
  --  return
  --endhandle
  --!direction  = !referencePoint.position.direction(!nextPoint.position)
  --!openingPosition  = !referencePoint.position.offset(!direction, !zDistance)

  !plane = object PLANE()
  !plane.position = !actualPosition
  !ori = Z is D wrt world
  !plane.orientation = !ori
  !distance = !doorPosition.distance(!plane)
  --  Position when offset
  !originPosition  = !doorPosition.offset(U wrt World, !distance)
  !vDistance       = !doorPosition.distance(!originPosition )

  -- Draw
  !this.draw()

  -- get the profile from the RPATH of WLOPEN of the first wall
  !wallOpening  = !this.definition.wallOpening
  !rPathCollection  = object COLLECTION()
  !rPathCollection.scope(!wallOpening)
  !rPathCollection.type('RPATH')

  if (!rPathCollection.results().size() eq 0) then
    return false
  endif

  !referencePath = !rPathCollection.results().last()

  !profile  = object PROFILE(!referencePath)

  !ref = !!ce
  !!ce  = !this.secondWall

  NEW WLFEAT
    FUNC 'OPEN'

  NEW WLOPEN
    POSREF $!referencePoint
    ZDISTANCE $!zDistance
    VDISTANCE $!vDistance
    VERTDIRECTION true
    !wallJustification  = !this.definition.opening.owner.wJusLine
    WJUSLINE $!wallJustification

  NEW RPATH
  !profile.dbWrite(!!ce)

  -- navigate to the old ce
  !!ce = !ref

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refresh()

  if !this.openingTaskPane.visible.not() then
     return
  endif

  if !!ce.prmown.type.neq('WLOPEN') then
    -- its not door or a window
    return
  endif

  if !!ce.ddepth.gt(7) then
    !element = !!ce
    do from (!!ce.ddepth - 1) to 7 by -1
      !element = !element.owner
    enddo
  else
    !element = !!ce
  endif

  !block             = object BLOCK('!this.openingList[!evalIndex].string()')
  !dbNames           = !this.openingList.evaluate(!block)
  !openingNames      = !dbNames
  !num = !openingNames.findFirst(!element.string())
  if !num.set() then
    !this.openingGrid.selectRow(!num )
  endif

  !this.tagopening()

endmethod

------------------------------------------------------------------------
--
-- Method:      .enhance
--
-- Description: enhance the current opening
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enhance(!colour is STRING, !enhance is BOOLEAN)

if !this.selectedOpening.unset().or(!this.selectedOpening.badref()) then
   return
endif

if !enhance then
  !action = 'ENHANCE'
  !colourString = 'colour ' & !colour
  UNENHANCE ALL
  refresh
else
  !action = 'UNENHANCE'
  !colourString = ''
endif

-- method to enhance or unenhance everything in the current wall opening
do !a values !this.selectedOpening.owner.members
   if !a.type.eq('DOOR').or(!a.type.eq('WINDOW')) then
     $!action $!a $!colourString
     if !a.members.set() then
       do !b values !a.members
         $!action $!b $!colourString
         if !b.members.set() then
           do !c values !b.members
              $!action $!c $!colourString
           enddo
         endif
       enddo
     endif
   endif
enddo
refresh

endmethod

------------------------------------------------------------------------
--
-- Method:      removeWallOpening
--
-- Description: Remove a wall opening from the current door/window
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeWallOpening()

  !row  = !this.penWallGrid.getSelectedRows()
  if (!row.empty()) then
    !!alert.error('No item selected')
    return
  endif
  !item = !row[1][1].dbref()
  !managed = !row[1][5].boolean()
  if (!item.hardType eq 'WLOPEN' and !managed) then
    !safeCE = !!ce
    !!ce = !item
    DELETE WLOPEN
    handle ANY
      !!alert.error(!!error.text)
      !!ce = safeCE
    elsehandle NONE
      !!ce = !safeCE
      handle ANY
      endhandle
      -- remove the row from the grid
      !this.penWallGrid.deleteSelectedRows()
    endhandle
    -- remove the item from the association
    !control = object HMCONTROL()
    !control.removeMemberFromHole(!this.hmHole,'extraWallOpening')
    !this.wallAdd.active = TRUE
  elseif (!managed.not()) then
    -- if it is not managed just remove the row
    -- however if you are removing row 1 then remove all rows because
    -- we can't have a managed hole without the middle penetrated object
    if (!this.penWallGrid.getSelectedRowTags()[1] eq '1') then
      !attributes     = ARRAY()
      !attributes.append('Name')
      !attributes.append('Position')
      !attributes.append('Plane Position')
      !attributes.append('Plane Orientation')
      !attributes.append('Managed')

      !penetratedArr  = ARRAY()

      -- Load grid
      using namespace 'Aveva.Pdms.Presentation'
      !nds                = object NETDATASOURCE('PenWalls', !attributes, !penetratedArr)

      !this.penWallGrid.bindToDataSource(!nds)
    else
      !this.penWallGrid.deleteSelectedRows()
    endif
  else
    !!alert.message('You can only remove the managed penetration through the hole management form')
    !this.showHoleMan()
  endif

  !rows = !this.penWallGrid.getRows()
  if (!rows.empty()) then
    !this.wallAdd.active   = TRUE
    !this.wallRem.active   = FALSE
    !this.holAccept.active = FALSE
  elseif(!rows.size() eq 1) then
    !this.wallAdd.active   = TRUE
    !this.wallRem.active   = TRUE
    if (!rows[1][5].boolean()) then
      !this.holAccept.active = FALSE
    else
      !this.holAccept.active = TRUE
    endif
  else
    !this.wallAdd.active   = FALSE
    !this.wallRem.active   = TRUE
    if (!rows[1][5].boolean() and !rows[2][5].boolean()) then
      !this.holAccept.active = FALSE
    else
      !this.holAccept.active = TRUE
    endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      showHoleMan
--
-- Description: Show the hole management form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showHoleMan()

  -- Bring up the hole management form and populate with the current association
  if (undefined(!!holeManMain)) then
    pml load form !!holeManMain
    !!holeManMain.show()
  elseif(!!holeManMain.shown().not()) then
    !!holeManMain.show()
  endif
  !safeCE = !!ce
  !!ce = !this.openingGrid.getSelectedRows()[1][2].dbref()
  !!holeManMain.showAssocs(!!holeManMain.btnRefresh,'ADD')
  !!holeManMain.returnToAssocs()
  !!ce = !safeCE

endmethod
-- end of code
