--
-- File:            accroomdefinition.pmlfrm
--   Type:          Form Definition
--   Group:         Accommodation
--
--     Keyword:     Room Definition
--   Module:        Design
--   Replaces:
--
-- Author:          neil.holmes
-- Created:         Sun Feb 4 20:00:00 GMT 2007
--
--
-- Description:
--    Main form for room definitions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accRoomDefinition()              -                   Constructor
--  accUnitsFormats()                -                   Set unit global format objects specific to room design
--  backToMainRoomDesignTasks()      -                   Switching to Main Room Design Tasks
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  create()                         -                   Create element
--  createRoom(BOOLEAN)              -                   Display room pane in create mode
--  deleteRoom()                     -
--  dummy()                          -                   Dummy method for unset
--  elevation()                      -                   Set elevation of level
--  exampleWarning1()                -
--  geometry()                       -                   Define geometry for element
--  geometryUpdate(SHAPEDEFINITION)  -                   Update with returned data
--  height(GADGET,STRING)            -                   Set height of element
--  licenceCheck()                   BOOLEAN             checks for a valid Room design licence
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  modify()                         -                   Modify (write modified values to DB)
--  modifyGeometry()                 -                   Modify geometry
--  modifyRoom(BOOLEAN)              -                   Display room pane in modify mode
--  nAngle(GADGET,STRING)            -                   Set rotate of BBLEVEL element
--  offset()                         -                   Set xy offset of element
--  offset(EDGPOSITIONDATA)          -                   Map picked position to room offset
--  pickOffset()                     -                   Setup EDG pick event for picking position
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  roomCreate()                     -                   Create Room
--  roomGeometry()                   -                   Switch to geometry modification pane for current element
--  roomGeometry(BOOLEAN)            -                   Switch to geometry modification pane
--  roomGeometry(DBREF)              -                   Switch to geometry modification pane for specified element
--  roomModGeometry()                -                   Modify geometry for ROOM (needs to pass current geometry to shape editor)
--  roomModify()                     BOOLEAN             Modify Room
--  roomModify(DBREF)                BOOLEAN             Setup to modify room
--  selectRoomType()                 -                   Display room type selection form
--  setRoomType(STRING,STRING,STRING,STRING,STRING,STRING,STRING,STRING,STRING) -                   Display room type selection form
--  setup()                          -                   Set up form
--  updateAttributes()               -                   Update gadgets with object data
--  updateData()                     -                   Update current data with gadget values
--  updateGadgets()                  -                   updateGadgets
--  updateRoomTypeAttributes()       -                   Update room type gadgets with object data
--  validateTextGadgets(GADGET,REAL) -
--  warning(ARRAY,STRING)            -                   Set warning task and message with default "Continue"
--  warning(ARRAY,STRING,STRING)     -                   Set warning task and message
--  warningDone()                    -                   Exit warning
--

setup form !!accRoomDefinition dialog docking right

  !this.formTitle     = 'Room Definition'
  !this.iconTitle     = 'Room'
  !this.callback      = '!this.setup()'
  !this.cancelCall    = '!this.definition.tidy()'
  !this.formRevision  = ' $Revision$ '

  -- Main Task Pane
  frame .mainTaskPane panel                   anchor top + left + right         at x0                     y0

    -- Create options
    paragraph .roomCreateTasks                                                  at x0.5                   ymax                width 30 lines 1
    line .mainTaskL1                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtCrtRoom     linkLabel 'ROOM'                                      at x2                     ymax                callback '!this.roomCreate()'

    -- Modify options
    paragraph .roomModifyTasks                                                  at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskL2                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtModRoom     linkLabel 'Room Definition'                           at x2                     ymax                callback '!this.roomModify()'
    button .mtGeomRoom    linkLabel 'Room Geometry'                             at xmin                   ymax                callback '!this.roomGeometry()'

    -- Delete options
    paragraph .roomDeleteTasks                                                  at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskL4                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtDelRoom     linkLabel 'Delete Room'                               at x2                     ymax                callback '!this.deleteRoom()'

    paragraph .blTskBackMainIcon1            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain1     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit

  -- Room creation/modification pane
  frame .editPane panel                             anchor top + left + right   at x0                     y0

    paragraph .editTitle                            anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .editLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Gadgetry definition for creation
    text .dbName  'Name:'  tagwidth 9               anchor top + left + right   at x2                     ymax+0.2            callback '!this.checkName(!this.dbName, !this.definition.name)' width 20 is STRING
    path down
    halign right
    text .dbDescription 'Description:' tagwidth 9   anchor top + left + right                                                 callback '' width 20 is STRING
    numericinput .dbNumber 'Number:'  tagwidth 9    anchor top + left           at xmin                   ymax+0.2            callback '' range 0 10000 ndp 0 width 4

    -- Room Type
    button .roomTypeSelect linkLabel 'Room Type...' anchor top + left + right   at x0.5                   ymax+0.2            callback '!this.selectRoomType()'
    line .editLine1a                                anchor top + left + right   at xmin                   ymax                horizontal width 32
    paragraph .dbFunctionTag                        anchor top + left           at x2                     ymax+0.2            width  9 lines 1
    paragraph .dbFunction                           anchor top + left + right   at xmax                   ymin                width 20 lines 1
    paragraph .dbRoomTypeTag                        anchor top + left           at x2                     ymax                width  9 lines 1
    paragraph .dbRoomType                           anchor top + left + right   at xmax                   ymin                width 20 lines 1
    paragraph .dbOccTypeTag                         anchor top + left           at x2                     ymax                width  9 lines 1
    paragraph .dbOccType                            anchor top + left + right   at xmax                   ymin                width 20 lines 1

    -- Positioning
    paragraph .location                             anchor top + left + right   at x0.5                   ymax+0.2            text 'Location:' width 28 lines 1
    line .editLine2                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Angle from Y axis
    numericinput .nAngle 'Angle from BLEVEL Y axis:' tagwidth 23 anchor t + l    at x2                     ymax+0.2            callback '!this.nAngle('  range 180 -180 ndp 0 width 4

    -- Floor height
    text .flrHeight 'Floor height:'    tagwidth 11  anchor top + left + right   at x2                     ymax+0.5            callback '!this.elevation()' width 17  is REAL format !!distanceFmt
    path down
    halign right
    -- Ceiling height
    text .clnHeight 'Ceiling height:'  tagwidth 11  anchor top + left + right                                                 width 17  is REAL format !!distanceFmt

    -- XY Offset of floor from building origin
    button .offset linkLabel 'Room Offset'          anchor top + left + right   at x2                     ymax+0.2            callback '!this.pickOffset()' width 20
    text .xOffset   'X:'                            anchor top + left + right   at xmin+4                 ymax                callback '!this.offset()' width 21 is REAL format !!distanceFmt
    text .yOffset   'Y:'                            anchor top + left + right   at xmin                   ymax+0.2            callback '!this.offset()' width 21 is REAL format !!distanceFmt

    -- Defaults
    frame .criteria FoldUpPanel 'Design Criteria' anchor top + left + right     at x0                     ymax+0.5            width 32

      -- Occupancy
      paragraph .occupancyTag                       anchor t + l + r            at x0.5                   ymax                width 20 lines 1
      numericinput .occupancy 'Number:' tagwidth 8  anchor t + l + r            at xmin                   ymax+0.2            range 0 1000 ndp 0 width 6

      -- Colour scheme
      combo .colSchema 'Colour Schema:' tagwidth 11 anchor t + l                at x0.5                   ymax+0.5            width 13

      -- Lighting
      text .lighting 'Lighting:'        tagwidth 11 anchor t + l + r            at x0.5                   ymax+0.5            width 13 is REAL
      -- Air change rate
      text .airChangeRate 'Air change rate:'  tagwidth 11 anchor t + l + r      at x0.5                   ymax+0.5            width 13 is REAL
      -- Fire rating
      combo .fireRating 'Fire rating:'  tagwidth 11 anchor t + l                at x0.5                   ymax+0.5            width 13

    exit

    -- Environment Information
    frame .environment FoldUpPanel 'Environment Settings' anchor t + l + r      at x0                     ymax+0.5            width 32

      paragraph .ambTag                             anchor top + left           at x11.5                  ymax                text 'Design'
      paragraph .maxTag                             anchor top + left           at xmax+1.5               ymin                text 'Min'
      paragraph .minTag                             anchor top + left           at xmax+3                 ymin                text 'Max '

      text .temperature 'Temperature:' tagwidth 10  anchor top + left           at x1                     ymax-0.1            width 5 is REAL format !!integerFmt
      text .minTemp                                 anchor top + left           at xmax+0.5               ymin                width 5 is REAL format !!integerFmt
      text .maxTemp                                 anchor top + left + right   at xmax+0.5               ymin                width 5 is REAL format !!integerFmt

      text .pressure 'Pressure:' tagwidth 10        anchor top + left           at x1                     ymax+0.2            width 5 is REAL format !!realFmt
      text .minPressure                             anchor top + left           at xmax+0.5               ymin                width 5 is REAL format !!realFmt
      text .maxPressure                             anchor top + left + right   at xmax+0.5               ymin                width 5 is REAL format !!realFmt

      text .humidity 'Humidity:' tagwidth 10        anchor top + left           at x1                     ymax+0.2            width 5 is REAL format !!realFmt
      text .minHumidity                             anchor top + left           at xmax+0.5               ymin                width 5 is REAL format !!realFmt
      text .maxHumidity                             anchor top + left + right   at xmax+0.5               ymin                width 5 is REAL format !!realFmt

      paragraph .waterTag                           anchor top + left           at x1                     ymax+0.2            text 'Water Depth'
      text .maxWater                                anchor top + left + right   at xmin.maxHumidity       ymin                width 5 is REAL format !!realFmt

      toggle .waterTight 'Room is water tight' tagwidth 24    anchor t + l + r  at x4                     ymax+0.5
      toggle .gasTight   'Room is gas tight'   tagwidth 24    anchor t + l + r  at xmin                   ymax
    exit

    -- Defaults
    frame .defaults FoldUpPanel 'Defaults'          anchor top + left + right   at x0                     ymax+0.5            width 32

      text .dDoorSill 'Door Sill above Floor:'    tagwidth 17 anchor t + l + r    at x1                     ymax                width 11 is REAL format !!distanceFmt
      text .dWinSill  'Window Sill above Floor:'  tagwidth 17 anchor t + l + r    at xmin                   ymax+0.2            width 11 is REAL format !!distanceFmt

      combo .dClnType 'Ceiling Type:'           tagwidth 10 anchor t + l        at xmin                   ymax+0.5            width 13
      combo .dClnCode 'Ceiling Code:'           tagwidth 10 anchor t + l        at xmin                   ymax+0.2            width 13

      combo .dFlrType 'Floor Type:'             tagwidth 10 anchor t + l        at xmin                   ymax+0.5            width 13
      combo .dFlrCode 'Floor Code:'             tagwidth 10 anchor t + l        at xmin                   ymax+0.2            width 13

    exit

    -- Modification data specific to a room
    frame .modPane panel                            anchor top + left + right   at x0                     ymax+0.2

      -- Information
      frame .roomInformation FoldUpPanel 'Information'           anchor top + left + right   at x0                     ymax           width 32

        text .roomare   'Area:'    tagwidth 16               anchor top + left + right   at x0.5                   ymax                 width 11 is REAL format !!accAreaFmt
        text .roomvol   'Volume:'  tagwidth 16               anchor top + left + right   at x0.5                   ymax+0.5             width 11 is REAL format !!accVolFmt
      exit

      -- Accept Changes
      paragraph .modAcceptIcon                      anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .modAccept  linkLabel 'Accept Changes' anchor top + left           at xmax+0.5               ymin                callback '!this.modify()' width 10

      -- Discard Changes
      paragraph .modDiscardIcon                     anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
      button .modDiscard linkLabel 'Discard Changes' anchor top + right         at xmax+0.5               ymin                callback '!this.roomModify(!this.element)' width 10

      paragraph .modBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      button .modMain   linkLabel   'Back to main Room tasks'                   at xmax+1                 ymin                callback '!this.mainTasks(true)'

      paragraph .blTskBackMainIcon2            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
      button .blTskMain2     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20
    exit

    -- Creation data specific to a room
    frame .crtPane panel                            anchor top + left + right   at xmin.modPane           ymin.modPane

      paragraph .createGeometry                     anchor top + left + right   at x0.5                   ymax                text 'Geometry' width 28 lines 1
      line .editLine3                               anchor top + left + right   at xmin                   ymax                horizontal width 32

      -- Define geometry definition method
      text .height 'Default height:' tagwidth 10    anchor top + left + right   at x2                     ymax+0.2            callback '!this.height(' width 19 is REAL format !!distanceFmt

      -- Define geometry
      button .crtShape linkLabel  'Define BBLOCK geometry:' anchor t + l + r    at xmin                   ymax+0.2            callback '!this.geometry()' width 28
      paragrap .crtShapeDef                         anchor top + left + right   at xmin+2                 ymax                width 28 lines 1

      -- Create Floor/Ceiling
      paragraph .createOptions                      anchor top + left + right   at x0.5                   ymax+0.5            text 'Create options' width 28 lines 1
      line .editLine4                               anchor top + left + right   at xmin                   ymax                horizontal width 32

      toggle .crtCeiling 'Create ceiling' tagwidth 24 anchor t + l + r          at x2                     ymax+0.2            callback '!this.crtCeilingGrid.active = !this.crtCeiling.val'
      toggle .crtCeilingGrid 'Create ceiling grid' tagwidth 24 anchor t + l + r at x4                     ymax                callback ''
      toggle .crtFloor   'Create floor covering' tagwidth 24 anchor t + l + r   at x2                     ymax+0.2            callback ''

      -- Create Room
      paragraph .crtAcceptIcon                      anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .crtAccept linkLabel 'Create Room'     anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.create()' width 12

      paragraph .crtBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .crtMain   linkLabel 'Back to main Room tasks'                     at xmax+1                 ymin                callback '!this.mainTasks(true)'

     paragraph .blTskBackMainIcon3            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
     button .blTskMain3     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20
    exit

  exit

  -- Modify geometrical information
  frame .modGeometry panel                          anchor top + left + right   at x0                     y0

    paragraph .geomTitle                            anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .geomLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

      -- Define geometry definition method
      text .gHeight 'Default height:' tagwidth 10   anchor top + left + right   at x2                     ymax+0.2            callback '!this.height(' width 19 is REAL format !!distanceFmt
      button .roomModShape linkLabel 'Modify Room geometry:' anchor t + l + r   at x2                     ymax+0.2            callback '!this.roomModGeometry()' width 28
      -- Accept Changes
      paragraph .gModAcceptIcon                     anchor top + left           at x0                     ymax+0.2            pixmap width 16 height 16
      button .gModAccept  linkLabel 'Accept Changes' anchor top + left          at xmax+0.5               ymin                callback '!this.modifyGeometry()' width 10

      -- Discard Changes
      paragraph .gModDiscardIcon                    anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
      button .gModDiscard linkLabel 'Discard Changes' anchor top + right        at xmax+0.5               ymin                callback '!this.roomGeometry(!this.element)' width 10

      paragraph .gModBackIcon                        anchor top + left          at x0                     ymax+0.5            pixmap width 15 height 15
      button .gModMain   linkLabel  'Back to main Room tasks'                   at xmax+1                 ymin                callback '!this.mainTasks(true)'

      paragraph .blTskBackMainIcon4            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
      button .blTskMain4     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit

  -- Warning Task Pane
  frame .warningPane panel                    anchor top + left + right         at x0                     y0

    paragraph .warningHeader                                                    at x0                     ymax                text 'Warning'
    line .warningLine                         anchor top + left + right         at x0                     ymax                horizontal width 32
    paragraph .warningIcon                    anchor left + top                 at x0.5                   ymax+0.2            pixmap width 32 heigh 32
    paragraph .warning                        anchor left + right + top         at xmax+2                 ymin                width 26 lines 6
    button    .warningDone linkLabel 'Continue' anchor left + top               at x0.5                   ymax                callback '!this.warningDone()' width 28

  exit

  -- Form Members
  using namespace 'PMLPositionControl'

  -- Alternative text for element type
  member .altText         is STRING

  -- Owning element
  member .owner           is DBEBLEVEL
  member .owningElement   is DBREF

  -- Current Element (Room)
  member .element         is DBREF
  member .definition      is DBEROOM

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK

  -- Warning action
  member .warningAction   is BLOCK

  -- Undo for form
  member .undo            is UNDOABLE

  -- EDG Description
  member .edgDescription  is STRING

  -- Aid Numbers
  member .aidAxes         is REAL
  member .outerBoundary   is REAL
  member .innerBoundaries is REAL

  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
  --!!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accRoomDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accRoomDefinition()

  -- Set form to auto scroll
  !this.autoScroll              = true

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!this.dummy()')

  -- Collapse fold up panels
  !this.defaults.expanded       = false
  !this.criteria.expanded       = false
  !this.environment.expanded    = FALSE
  !this.roomInformation.expanded    = FALSE

  !this.roomare.editable = FALSE
  !this.roomvol.editable = FALSE

  -- Set events for numeric gadgets
  !this.nAngle.modifiedEvents   = true

  -- Load information from Configuration
  !this.refreshConfig()

 -- Initialise task panes
  !this.mainTasks(true)
  !this.createRoom(false)
  !this.modifyRoom(false)
  !this.warningPane.visible     = false

  -- Set "Back" icon
  !backIcon                     = !!pml.getpathname('back.png')
  !this.crtBackIcon.addpixmap(!backIcon)
  !this.modBackIcon.addpixmap(!backIcon)
  !this.gModBackIcon.addpixmap(!backIcon)

  !this.blTskBackMainIcon1.addpixmap(!backIcon)
  !this.blTskBackMainIcon2.addpixmap(!backIcon)
  !this.blTskBackMainIcon3.addpixmap(!backIcon)
  !this.blTskBackMainIcon4.addpixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getpathname('create.png')
  !this.crtAcceptIcon.addpixmap(!createIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getpathname('accept.png')
  !this.modAcceptIcon.addpixmap(!acceptIcon)
  !this.gModAcceptIcon.addpixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getpathname('discard.png')
  !this.modDiscardIcon.addpixmap(!discardIcon)
  !this.gModDiscardIcon.addpixmap(!discardIcon)

  -- Set "Warning" icon
  !warningIcon                  = !!pml.getpathname('exclamation-32.png')
  !this.warningIcon.addpixmap(!warningIcon)

  -- EDG Description
  !this.edgDescription    = 'Accommodation Room Definition'

  -- Assign aid numbers for form
  !this.aidAxes           = !!aidNumbers.add('Room Definition - Axes')
  !this.outerBoundary     = !!aidNumbers.add('Room Definition - OuterBoundary')
  !this.innerBoundaries   = !!aidNumbers.add('Room Definition - InnerBoundaries')

  -- Populate combo with defaults
  !this.colSchema.dtext   = !!accConfig.colourSchemes()
  !this.fireRating.dtext  = !!accConfig.fireRatings()
  !this.dClnType.dtext    = !!accConfig.ceilingTypes()
  !this.dClnCode.dtext    = !!accConfig.ceilingCodes()
  !this.dFlrType.dtext    = !!accConfig.floorTypes()
  !this.dFlrCode.dtext    = !!accConfig.floorCodes()

  -- set tag for Geometry button
   !this.crtShape.tag     = 'Define ' & !this.altText &  ' geometry:'

  -- validate the text gadgets
  !this.flrHeight.validateCall     = '!this.validateTextGadgets(!this.flrHeight,!this.definition.flrHeight)'
  !this.clnHeight.validateCall     = '!this.validateTextGadgets(!this.clnHeight,!this.definition.clnHeight)'
  !this.xOffset.validateCall       = '!this.validateTextGadgets(!this.xOffset,!this.definition.xyOffset[1])'
  !this.yOffset.validateCall       = '!this.validateTextGadgets(!this.yOffset,!this.definition.xyOffset[2])'
  !this.lighting.validateCall      = '!this.validateTextGadgets(!this.lighting,!this.definition.lighting)'
  !this.airChangeRate.validateCall = '!this.validateTextGadgets(!this.airChangeRate,!this.definition.airChangeRate)'
  !this.dDoorSill.validateCall     = '!this.validateTextGadgets(!this.dDoorSill,!this.definition.dDoorSill)'
  !this.dWinSill.validateCall      = '!this.validateTextGadgets(!this.dWinSill,!this.definition.dWinSill)'

  !this.temperature.validateCall   = '!this.validateTextGadgets(!this.temperature,!this.definition.temperature)'
  !this.minTemp.validateCall       = '!this.validateTextGadgets(!this.minTemp,!this.definition.minTemp)'
  !this.maxTemp.validateCall       = '!this.validateTextGadgets(!this.maxTemp,!this.definition.maxTemp)'

  !this.pressure.validateCall      = '!this.validateTextGadgets(!this.pressure,!this.definition.pressure)'
  !this.minPressure.validateCall   = '!this.validateTextGadgets(!this.minPressure,!this.definition.minPressure)'
  !this.maxPressure.validateCall   = '!this.validateTextGadgets(!this.maxPressure,!this.definition.maxPressure)'

  !this.humidity.validateCall      = '!this.validateTextGadgets(!this.humidity,!this.definition.humidity)'
  !this.minHumidity.validateCall   = '!this.validateTextGadgets(!this.minHumidity,!this.definition.minHumidity)'
  !this.maxHumidity.validateCall   = '!this.validateTextGadgets(!this.maxHumidity,!this.definition.maxHumidity)'

  !this.maxWater.validateCall      = '!this.validateTextGadgets(!this.maxWater,!this.definition.maxWater)'

  !this.height.validateCall        = '!this.validateTextGadgets(!this.height,!this.definition.defaultHeight)'
  !this.gHeight.validateCall       = '!this.validateTextGadgets(!this.gHeight,!this.definition.defaultHeight)'

  -- Register refresh with navigator form
  --!action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  --!!accControl.register('accNavigator', !action)

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dummy
--
-- Description: Dummy method for unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dummy()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectRoomType
--
-- Description: Display room type selection form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectRoomType()

  -- Define form if required
  if(undefined(!!accRoomTypes)) then
    pml reload form !!accRoomTypes
  endif

  -- Setup form
  !action = '!!' & !this.name() & '.setRoomType(!function, !roomType, !occType, !colSchema, !fireRating, !dClnCode, !dClnType, !dFlrCode, !dFlrType)'
  !!accRoomTypes.setup(!this.definition.function, !this.definition.roomType, !this.definition.occType, !this.definition.colSchema, !this.definition.fireRating, !this.definition.dClnCode, !this.definition.dClnType, !this.definition.dFlrCode, !this.definition.dFlrType, !action)
  show !!accRoomTypes

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setRoomType
--
-- Description: Display room type selection form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setRoomType(!function is STRING, !roomType is STRING, !occType is STRING, !colSchema is STRING, !fireRating is STRING, !dClnCode is STRING, !dClnType is STRING, !dFlrCode is STRING, !dFlrType is STRING)

  -- Define form if required
  !this.definition.function = !function
  !this.definition.roomType = !roomType
  !this.definition.occType  = !occType

    if(!this.colSchema.dtext.findFirst(!colSchema).set()) then
      !this.definition.colSchema    = !colSchema
    endif

    if(!this.fireRating.dtext.findFirst(!fireRating).set()) then
      !this.definition.fireRating    = !fireRating
    endif

    if(!this.dClnType.dtext.findFirst(!dClnType).set()) then
      !this.definition.dClnType    = !dClnType
    endif

    if(!this.dClnCode.dtext.findFirst(!dClnCode).set()) then
      !this.definition.dClnCode   = !dClnCode
    endif

    if(!this.dFlrType.dtext.findFirst(!dFlrType).set()) then
      !this.definition.dFlrType    = !dFlrType
    endif

    if(!this.dFlrCode.dtext.findFirst(!dFlrCode).set()) then
      !this.definition.dFlrCode    = !dFlrCode
    endif

  -- Set description to be same as occupancy type, can then be modified by user
  !this.definition.description = !occType

  -- Update Room Type
  !this.updateRoomTypeAttributes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Set form members for when form title changes in other methods
  !this.altText                 = !!accConfig.typeDescription ( 'ROOM' )

  -- Replacement Text (set using configuration information)
  !roomRText                    = !this.altText
  !levelRText                   = !!accConfig.typeDescription ( 'BLEVEL' )

  -- Room Tasks
  !this.roomCreateTasks.val     = 'Create'
  !this.roomModifyTasks.val     = 'Modify'
  --!this.roomCopyTasks.val       = 'Copy'
  !this.roomDeleteTasks.val     = 'Delete'

  -- Room Create Task Tags
  !this.mtCrtRoom.tag           = !roomRText

  -- Room Modify Task Tags
  !this.mtModRoom.tag           = !roomRText & ' Definition'
  !this.mtGeomRoom.tag          = !roomRText & ' Geometry'

  -- Room Action Task Tags
  !this.mtDelRoom.tag           = 'Delete ' & !roomRText

  -- Room Type Tags
  !this.dbFunctionTag.val       = 'Function:'
  !this.dbRoomTypeTag.val       = 'Room Type:'
  !this.dbOccTypeTag.val        = 'Occupancy:'

  -- Room Editing Tags
  !this.nAngle.tag              = 'Angle from ' & !levelRText & ' Y axis:'
  !this.offset.tag              = !roomRText & ' Offset...'
  --!this.offsetTag.val           = !roomRText & ' Offset'

  !this.occupancyTag.val        = !roomRText & ' Occupancy:'

  !this.waterTight.tag          = ' ' & !roomRText & ' is water tight'
  !this.gasTight.tag            = ' ' & !roomRText & ' is gas tight'

  -- Room Modify tags
  !this.modMain.tag             = 'Back to main ' & !roomRText & ' tasks'

  -- Room Create tags
  !this.crtAccept.tag           = 'Create ' & !roomRText
  !this.crtMain.tag             = 'Back to main ' & !roomRText & ' tasks'

   !this.crtShape.tag           = 'Define ' & !this.altText &  ' geometry:'

    --update the Combo boxes as well
  !this.colSchema.dtext   = !!accConfig.colourSchemes()
  !this.fireRating.dtext  = !!accConfig.fireRatings()
  !this.dClnType.dtext    = !!accConfig.ceilingTypes()
  !this.dClnCode.dtext    = !!accConfig.ceilingCodes()
  !this.dFlrType.dtext    = !!accConfig.floorTypes()
  !this.dFlrCode.dtext    = !!accConfig.floorCodes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Set up form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !this.owningElement  = !!accNavigator.blevel()
  !this.updateGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.mainTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.mainTasks(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Main ' & !this.altText & ' Tasks'

  endif

  -- Unit Conversions for Area and Volume
  !this.accUnitsFormats()

 !this.updateGadgets()
  -- Show/hide task pane
  !this.mainTaskPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createRoom
--
-- Description: Display room pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createRoom(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.createRoom(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Create ' & !this.altText

    -- Manage create/modify panels
    !this.modPane.visible     = false
    !this.crtPane.visible     = true
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyRoom
--
-- Description: Display room pane in modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyRoom(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.modifyRoom(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify ' & !this.altText

    -- Manage create/modify panels
    !this.modPane.visible     = true
    !this.crtPane.visible     = false
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roomCreate
--
-- Description: Create Room
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomCreate()
if (!this.licenceCheck()) then
else
  -- Initialise Variables
  if(!!accNavigator.blevel().badref())then
    !!alert.warning('The active Floor Elevation Element in Room Design Navigator may be deleted or not selected. Can not create room.')
    return
  endif
  !this.owner                 = object DBEBLEVEL(!!accNavigator.blevel())
  !this.definition            = object DBEROOM()
  !this.definition.initialise(!this.owner.dbElement)

  -- Form title
  !this.formTitle             = 'Create ' & !this.altText

  -- Edit panel title
  !this.editTitle.val         = 'New ' & !this.altText &' for ' & !this.owner.dbElement.namn
  !this.crtShapeDef.val       = 'None currently defined'

  -- Populate form with default information (where possible)
  -- Set the default value from owner. If the value is unset, then get the value from configuration.
  -- Set the floor height from BLEVEL if set else set from configuration settings
  if(!this.owner.dFlRHeight.set() and !this.owner.dFlRHeight.neq(0)) then
    !this.definition.flrHeight  = !this.owner.dFlRHeight
  else
    !this.definition.flrHeight  = !!accConfig.flrHeight
  endif

  -- Set the ceiling height from BLEVEL if set else set from configuration settings
  if(!this.owner.dClnHeight.set() and !this.owner.dClnHeight.neq(0)) then
    !this.definition.clnHeight  = !this.owner.dClnHeight
  else
    !this.definition.clnHeight  = !!accConfig.clnHeight
  endif

  !this.definition.dDoorSill    = !!accConfig.dDoorSill
  !this.definition.dWinSill     = !!accConfig.dWindowSill
  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Set elevation
  !this.definition.elevation(!this.definition.flrHeight)

  -- Update gadgets
  !this.updateAttributes()

  -- Setup panes
  !this.createRoom(true)
endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roomModify
--
-- Description: Modify Room
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomModify() is BOOLEAN
  return !this.roomModify(!!accNavigator.room())
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roomModify
--
-- Description: Setup to modify room
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Room to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .roomModify(!element is DBREF) is BOOLEAN

  -- has room actually been deleted?
  if ( !element.badref() ) then
    -- Refresh navigator, this should be handled by the navigator itself
    !!accNavigator.reloadRooms()
    !this.updateGadgets()
    return false
  endif
  -- Check Room has been passed
  if(!element.fulltype.neq('ROOM')) then
    !!error.message               = 'Element "' & !element.namn & '" is not a ROOM.'
    return false
  endif

  -- Load current Room
  !this.element                   = !element

  !this.owner                     = object DBEBLEVEL(!element.owner)
  !this.definition                = object DBEROOM(!element)
  !this.owningElement             = !element.owner

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Form title
  !this.formTitle                 = 'Modify ' & !this.altText

  -- Edit panel title
  !this.editTitle.val             = !this.altText & ': ' & !this.element.namn

  -- Update Room gadgets
  !this.updateAttributes()

  -- Setup panes
  !this.modifyRoom(true)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roomGeometry
--
-- Description: Switch to geometry modification pane for current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomGeometry()
  !this.roomGeometry(!!accNavigator.room())
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roomGeometry
--
-- Description: Switch to geometry modification pane for specified element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomGeometry(!element is DBREF)

  -- has room actually been deleted?
  if ( !element.badref() ) then
    -- Refresh navigator, this should be handled by the navigator itself
    !!accNavigator.reloadRooms()
    !this.updateGadgets()
    return false
  endif
  -- Check Room has been passed
  if(!element.fulltype.neq('ROOM')) then
    !!error.message               = 'Element "' & !element.namn & '" is not a ROOM.'
    return false
  endif
if (!this.licenceCheck()) then
else
  -- Load current Room
  !this.element                   = !element

  !this.owner                     = object DBEBLEVEL(!element.owner)
  !this.definition                = object DBEROOM(!element)
  !this.owningElement             = !element.owner

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- Form title
  !this.formTitle                 = 'Modify ' & !this.altText

  -- Edit panel title
  !this.geomTitle.val             = 'Modify Geometry of ' & !this.element.namn

  -- Update attributes
  !this.gHeight.val         = !this.definition.defaultHeight

  -- Display pane
  !this.roomGeometry(true)
endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roomGeometry
--
-- Description: Switch to geometry modification pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomGeometry(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.modGeometry

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.roomGeometry(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify ' & !this.altText & ' Geometry'

    -- Draw
    !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.modGeometry.visible   = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateRoomTypeAttributes
--
-- Description: Update room type gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRoomTypeAttributes()

  if(!this.definition.function.set()) then
    !this.dbFunction.val  = !this.definition.function
  else
    !this.dbFunction.val  = 'unset'
  endif

  if(!this.definition.roomType.set()) then
    !this.dbRoomType.val  = !this.definition.roomType
  else
    !this.dbRoomType.val  = 'unset'
  endif

  if(!this.definition.occType.set()) then
    !this.dbOccType.val   = !this.definition.occType
  else
    !this.dbOccType.val   = 'unset'
  endif

  if(!this.definition.colSchema.set()) then
    if(!this.colSchema.dtext.findFirst(!this.definition.colSchema).set()) then
      !this.colSchema.val    = !this.definition.colSchema
    endif
  endif

  if(!this.definition.fireRating.set()) then
    if(!this.fireRating.dtext.findFirst(!this.definition.fireRating).set()) then
      !this.fireRating.val    = !this.definition.fireRating
    endif
  endif

  if(!this.definition.dClnType.set()) then
    if(!this.dClnType.dtext.findFirst(!this.definition.dClnType).set()) then
      !this.dClnType.val    = !this.definition.dClnType
    endif
  endif

  if(!this.definition.dClnCode.set()) then
    if(!this.dClnCode.dtext.findFirst(!this.definition.dClnCode).set()) then
      !this.dClnCode.val    = !this.definition.dClnCode
    endif
  endif

  if(!this.definition.dFlrType.set()) then
    if(!this.dFlrType.dtext.findFirst(!this.definition.dFlrType).set()) then
      !this.dFlrType.val    = !this.definition.dFlrType
    endif
  endif

  if(!this.definition.dFlrCode.set()) then
    if(!this.dFlrCode.dtext.findFirst(!this.definition.dFlrCode).set()) then
      !this.dFlrCode.val    = !this.definition.dFlrCode
    endif
  endif

  !this.dbDescription.val = !this.definition.description
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateAttributes
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAttributes()

  -- Set values of gadgets from Room object
  !this.dbName.val        = !this.definition.name
  !this.dbDescription.val = !this.definition.description

  -- Update Room Type
  !this.updateRoomTypeAttributes()

  !this.dbNumber.val      = !this.definition.number
  !this.nAngle.val        = !this.definition.nAngle
  !this.xOffset.val       = !this.definition.xyOffset[1]
  !this.yOffset.val       = !this.definition.xyOffset[2]
  !this.height.val        = !this.definition.defaultHeight
  !this.flrHeight.val     = !this.definition.flrHeight
  !this.clnHeight.val     = !this.definition.clnHeight

  !this.occupancy.val     = !this.definition.occupancy

  --!this.colSchema.val     = !this.definition.colSchema
  if(!this.definition.colSchema.set()) then
    if(!this.colSchema.dtext.findFirst(!this.definition.colSchema).set()) then
      !this.colSchema.val    = !this.definition.colSchema
    endif
  endif

  !this.lighting.val      = !this.definition.lighting
  !this.airChangeRate.val = !this.definition.airChangeRate

  --!this.fireRating.val    = |'$!this.definition.fireRating'|
  if(!this.definition.fireRating.set()) then
    if(!this.fireRating.dtext.findFirst(!this.definition.fireRating).set()) then
      !this.fireRating.val    = !this.definition.fireRating
    endif
  endif

  !this.temperature.val   = !this.definition.temperature
  !this.minTemp.val       = !this.definition.minTemp
  !this.maxTemp.val       = !this.definition.maxTemp
  !this.pressure.val      = !this.definition.pressure
  !this.minPressure.val   = !this.definition.minPressure
  !this.maxPressure.val   = !this.definition.maxPressure
  !this.humidity.val      = !this.definition.humidity
  !this.minHumidity.val   = !this.definition.minHumidity
  !this.maxHumidity.val   = !this.definition.maxHumidity
  !this.maxWater.val      = !this.definition.maxWater
  !this.waterTight.val    = !this.definition.waterTight
  !this.gasTight.val      = !this.definition.gasTight
  !this.dDoorSill.val     = !this.definition.dDoorSill
  !this.dWinSill.val      = !this.definition.dWinSill

  -- Unit Conversions for Area and Volume
  !this.accUnitsFormats()

  !this.roomare.val        =  !this.definition.roomare
  !this.roomvol.val        =  !this.definition.roomvol

  if(!this.definition.dClnType.set()) then
    if(!this.dClnType.dtext.findFirst(!this.definition.dClnType).set()) then
      !this.dClnType.val    = !this.definition.dClnType
    endif
  endif

  if(!this.definition.dClnCode.set()) then
    if(!this.dClnCode.dtext.findFirst(!this.definition.dClnCode).set()) then
      !this.dClnCode.val    = !this.definition.dClnCode
    endif
  endif

  if(!this.definition.dFlrType.set()) then
    if(!this.dFlrType.dtext.findFirst(!this.definition.dFlrType).set()) then
      !this.dFlrType.val    = !this.definition.dFlrType
    endif
  endif

  if(!this.definition.dFlrCode.set()) then
    if(!this.dFlrCode.dtext.findFirst(!this.definition.dFlrCode).set()) then
      !this.dFlrCode.val    = !this.definition.dFlrCode
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateData
--
-- Description: Update current data with gadget values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateData()

  -- Initialise Variables
  if(!this.dbName.val.set()) then
    !this.definition.name         = !this.dbName.val
  endif

  !this.definition.description    = !this.dbDescription.val
  !this.definition.function       = !this.dbFunction.val
  !this.definition.roomType       = !this.dbRoomType.val
  !this.definition.occType        = !this.dbOccType.val
  !this.definition.number         = !this.dbNumber.val
  !this.definition.flrHeight      = !this.flrHeight.val
  !this.definition.clnHeight      = !this.clnHeight.val
  !this.definition.occupancy      = !this.occupancy.val
  !this.definition.colSchema      = !this.colSchema.displaytext()
  !this.definition.lighting       = !this.lighting.val
  !this.definition.airChangeRate  = !this.airChangeRate.val
  !this.definition.fireRating     = !this.fireRating.displaytext()
  !this.definition.temperature    = !this.temperature.val
  !this.definition.minTemp        = !this.minTemp.val
  !this.definition.maxTemp        = !this.maxTemp.val
  !this.definition.pressure       = !this.pressure.val
  !this.definition.minPressure    = !this.minPressure.val
  !this.definition.maxPressure    = !this.maxPressure.val
  !this.definition.humidity       = !this.humidity.val
  !this.definition.minHumidity    = !this.minHumidity.val
  !this.definition.maxHumidity    = !this.maxHumidity.val
  !this.definition.maxWater       = !this.maxWater.val
  !this.definition.waterTight     = !this.waterTight.val
  !this.definition.gasTight       = !this.gasTight.val
  !this.definition.dDoorSill      = !this.dDoorSill.val
  !this.definition.dWinSill       = !this.dWinSill.val
  !this.definition.dClnType       = !this.dClnType.displaytext()
  !this.definition.dClnCode       = !this.dClnCode.displaytext()
  !this.definition.dFlrType       = !this.dFlrType.displaytext()
  !this.definition.dFlrCode       = !this.dFlrCode.displaytext()

endmethod

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create()
if (!this.licenceCheck()) then
else
  -- Check that outerLoop is set, and that it is a closed loop so that a volume can be created
  if(!this.definition.outerLoop.set().not()) OR (!this.definition.outerLoop.isClosed().not()) then
    !!alert.warning('Geometry must be defined before a Room is created.')
    return
  endif

  -- Reference Element
  !reference  = !!ce

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created ' & !this.altText)
  !this.undo.add()

  -- Navigate to Level
  !!ce                  = !this.owningElement

  -- Create new element
  if(!this.definition.create()) then
    !this.element       = !this.definition.dbElement

    -- Define basic of room
    !roomBasics         = object ACCROOMBASICS(!this.definition)
    !roomBasics.defineCeiling(!this.crtCeiling.val)
    !roomBasics.defineCeilingGrid(!this.crtCeilingGrid.val)
    !roomBasics.defineFloor(!this.crtFloor.val)

    -- Create basics
    !roomBasics.create()

    -- Switch to modify pane
    !this.roomModify(!this.element)

    -- Refresh navigator, this should be handled by the navigator itself
    !!accNavigator.reloadRooms(!this.element)

  -- Failed creating element
  else
    !!alert.warning(!!error.text)
  endif

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  -- Return to original element
  !!ce        = !reference
endif
endmethod

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()
if (!this.licenceCheck()) then
else
  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.element.namn & ')')
  !this.undo.add()

  -- Modify Room
  if(!this.definition.modify())then
    !collection = object COLLECTION()
    !collection.type('CEILIN')
    !collection.scope(!this.element)
    do !ceiling values !collection.results()
     !ceiling.clnHeight = !this.definition.clnHeight
    enddo
  else
    !!alert.warning(!!error.text)
  endif

  -- Refresh navigator, this should be handled by the navigator itself
  !!accNavigator.reloadRooms(!this.element)

  -- Set end mark for UNDO
  !this.undo.endUndoable()
endif
endmethod

------------------------------------------------------------------------
--
-- Method:      modifyGeometry
--
-- Description: Modify geometry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyGeometry()

  -- re-assign the room element to the object to update the geometry changes
  !this.definition             = object DBEROOM(!this.element)

  -- Update Geometry attribute (Default Height )
  !this.definition.defaultHeight = !this.gHeight.val

  -- Update Block Attributes
  !this.updateData()

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary, !this.innerBoundaries)

  -- re-draw the aid after change in geometry
  !this.definition.draw()

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.element.namn & ')')
  !this.undo.add()

  -- Modify Room
  !this.definition.modify()

  -- Update any rules on the area definition
  RULE EXECUTE ALL ON ALL AEXTR FOR $!<this.element>
  handle ANY
    QUERY VAR !!error
  endhandle

  -- Refresh navigator, this should be handled by the navigator itself
  !!accNavigator.reloadRooms(!this.element)

  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      geometry
--
-- Description: Define geometry for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometry()

  -- Define data to pass to shape definition form
  !plane  = !this.definition.plane
  !shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)

  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form for return to Room creation
  -- Information for form is:
  --   Calling form
  --   Form title
  --   Apply tag (Test for "apply" button)
  --   Action on completion, method name only, method must be in format
  --      .methodName(<SHAPEDEFINITION>)
  --   Default shape, should be at least pos and ori of the plane the
  --   shape is to be mapped onto.
  !!shapeDefinitionEditor.setup(!this, 'Define Room Boundary', 'Define Boundary', 'geometryUpdate', !shape)

endmethod

------------------------------------------------------------------------
--
-- Method:      geometryUpdate
--
-- Description: Update with returned data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometryUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  !this.crtShapeDef.val       = !shapeDefinition.description

  !this.definition.position(!shapeDefinition.profile.position)
  !this.definition.outerLoop  = !shapeDefinition.profile
  !this.definition.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message with default "Continue"
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Done"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING)
  !this.warning(!message, !action, 'Continue')
endmethod
-- End of method

