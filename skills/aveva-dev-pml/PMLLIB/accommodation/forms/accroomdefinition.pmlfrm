------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickOffset()

  -- Initialise Variables
  !prompt               = 'Pick ' & !this.altText & ' origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to room offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

  -- Initialise Variables
  !this.definition.xyOffset(!data.position)

  -- Update gadget
  !this.xOffset.val = !this.definition.xyOffset[1]
  !this.yOffset.val = !this.definition.xyOffset[2]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Continue"
--    3   R      STRING      "Continue" text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING, !continue is STRING)

  -- Switch warning pane
  !this.currentPane.visible   = false
  !this.warningPane.visible   = true

  -- Concatenate message into a single line
  !display    = ''
  do !i indices !message
    !display  = !display & ' ' & !message[!i]
  enddo

  -- Display message
  !this.warning.val           = !display.trim()
  !this.warningDone.tag       = !continue

  -- Set "Continue" action (If the action is dependent on other criteria
  -- e.g. being in the correct position in the hierarchy, then the
  -- active state of the "Done" button needs to be managed.
  !this.warningAction         = object BLOCK(!action)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warningDone
--
-- Description: Exit warning
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warningDone()

  -- Hide warning pane
  !this.warningPane.visible   = false

  -- Execute action
  !this.warningAction.evaluate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      exampleWarning
--
-- Description: Example of how to use a warning with an action
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exampleWarning1()

  -- Define message to be displayed
  !message[1] = 'This is the message that is to be displayed in the '
  !message[2] = 'warning pane. The message can be up to 132 Characters'
  !message[3] = 'long.'
  !this.warning(!message, '!this.firstTaskPane(true)', !this.ftpWarningMsg.val)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteRoom
--
-- Description: Delete ROOM
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteRoom()
	if (!this.licenceCheck()) then
else

  --should this be automated, i.e. from subscription mechanism?
  !this.element                  = !!accNavigator.room()
  -- has room been deleted already?
  if ( !this.element.badref() ) then
    -- Refresh navigator, this should be handled by the navigator itself
    !!accNavigator.reloadRooms()
    !this.updateGadgets()
    return
  endif

  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.element).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  else
  endif
  -- has room actually been deleted?
  if ( !this.element.badref() ) then
    -- Refresh navigator, this should be handled by the navigator itself
    !!accNavigator.reloadRooms()
    !this.updateGadgets()
  endif
endif
endmethod
------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: updateGadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  !this.element = !!accNavigator.room()
  !this.mtCrtRoom.active  = !!accNavigator.blevel().badref().not()
  !this.mtModRoom.active  = !this.element.badref().not()
  !this.mtGeomRoom.active = !this.element.badref().not()
  !this.mtDelRoom.active  = !this.element.badref().not()

endmethod

------------------------------------------------------------------------
--
-- Method:      backToMainRoomDesignTasks
--
-- Description: Switching to Main Room Design Tasks
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backToMainRoomDesignTasks()

  !this.hide()
  !!accTaskManager.active('accMainRefData')
  !!accMainRefData.mainTasks(true)

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      roomModGeometry
--
-- Description: Modify geometry for ROOM (needs to pass current geometry to shape editor)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomModGeometry()

  -- use the accProfileEdit function to edit the profile
  if(defined(!!dbeProfileEdit)) then
    !!dbeProfileEdit.close()
  endif

  !!accProfileEdit(!this.element)

endmethod
------------------------------------------------------------------------
--
-- Method:          validateTextGadgets
--
-- Description:     validate the value entered in the text gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateTextGadgets(!gadget is GADGET, !oldValue is REAL )

  if(!gadget.val.unset()) then
    !gadget.val = !oldValue
    !gadget.refresh()

  elseif(!gadget.name().match('HEIGHT').gt(0)) then
    if(!gadget.val.lt(0)) then
      !tag  = !gadget.tag.replace(':','')
      !!alert.error('$!tag cannot be less than zero')
      !gadget.val = !oldValue
      !gadget.refresh()
      return
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:          .licenceCheck
--
-- Description:     checks for a valid Room design licence
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if Invalid Seat
------------------------------------------------------------------------
define method .licenceCheck() is BOOLEAN
	!bool = FALSE
 	!roomDesignExist   = object MDRLICENCEMANAGER()
  !status = !roomDesignExist.getLicence('ROOMDESIGN')
  !error = !roomDesignExist.lastError()
  if (!status lt 0) then
  	!!alert.error('$!error')
  	!bool = TRUE
 	endif
 	return !bool
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        accUnitsFormats
--
-- Description:   Set unit global format objects specific to room design
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accUnitsFormats()

  -- Convert area units to inch and metric units to metres
  -- set up area and volume formats
  !!accAreaFmt = !!areaFmt
  !!accVolFmt  = !!volumeFmt

  if( !!isImperialLength('DIST') ) then
    -- set square inch format
    !!accAreaFmt.dp    = 0
    !!accAreaFmt.units = 'inch'
    !!accAreaFmt.label = ' sq in'
    -- set cubic inch format
    !!accVolFmt.dp     = 0
    !!accVolFmt.units  = 'inch'
    !!accVolFmt.label  = ' cu in'
  else
    -- set square metre format
    !!accAreaFmt.dp    = 3
    !!accAreaFmt.units = 'metre'
    !!accAreaFmt.label = ' sq metre'
    -- set cubic metre format
    !!accVolFmt.dp     = 3
    !!accVolFmt.units  = 'metre'
    !!accVolFmt.label  = ' cu metre'
  endif

endmethod
-- End of method definition
