--
-- Author:          neil.holmes
-- Created:         Mon May 12 10:00:00 BST 2008
--
--
-- Description:
--   Form for selecting room type settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accRoomTypes()                   -
--  selectTableEntry()               -                   Set up table from current information
--  setRoomType()                    -                   Get information
--  setup()                          -                   Setup default information
--  setup(DBREF)                     BOOLEAN             Setup information from passed Room
--  setup(STRING,STRING,STRING,STRING,STRING,STRING,STRING,STRING,STRING,STRING) -                   Setup information from passed data
--

-- Import DLL

setup form !!accRoomTypes resize

  -- Form details
  !this.formTitle    = 'Room Types'
  !this.icontitle    = ''
  !this.callback     = ''
  !this.formrevision = ''

  -- List of room designs
  frame .bBlockFrame panel            anchor all                    at x0.5                     ymax
    container .roomTypeList PMLNetCONTROL 'NET' dock fill width 60 lines 10
  exit

  -- Set
  button .dismiss 'Dismiss'   anchor right + bottom         at xmax-size              ymax+0.2          callback '!this.hide()'         width 6
  button .apply 'Apply'       anchor left + bottom          at x0.5                   ymin              callback '!this.setRoomType()'  width 6

  -- Form variables
  using namespace 'Aveva.Pdms.Presentation'
  member .roomTypeGrid    is NETGRIDCONTROL

  -- Default information
  member .function        is STRING
  member .roomType        is STRING
  member .occType         is STRING

  member .dClnCode        is STRING
  member .dClnType        is STRING

  member .dFlrCode        is STRING
  member .dFlrType        is STRING

  member .colSchema       is STRING
  member .fireRating      is STRING

  -- Room element
  member .room            is DBREF

  -- Action on form
  member .action          is BLOCK

exit

------------------------------------------------------------------------
--
-- Method:      rooAccRoomTypesmTypeTest
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accRoomTypes()

  -- File
  !file     = object FILE('%PDMSDFLTS%\roomtypes.csv')
  !filename = !file.fullname()

  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  !this.roomTypeGrid            = object NETGRIDCONTROL()
  !this.roomTypeList.control    = !this.roomTypeGrid.handle()
  !nds                          = object NETDATASOURCE('spreadsheet', !filename)
  !this.roomTypeGrid.bindToDataSource(!nds)

  -- Configure grid layout
  !this.roomTypeGrid.outlookGroupStyle(false)
  !this.roomTypeGrid.singleRowSelection(true)
  !this.roomTypeGrid.columnExcelFilter(true)
  !this.roomTypeGrid.columnSummaries(false)
  !this.roomTypeGrid.setLabelVisibility(false)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup default information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Set room
  !this.room      = object DBREF()

  -- Get values
  !this.function  = STRING()
  !this.roomType  = STRING()
  !this.occType   = STRING()

  !this.colSchema = STRING()
  !this.fireRating = STRING()
  !this.dClnCode = STRING()
  !this.dClnType = STRING()
  !this.dFlrCode = STRING()
  !this.dFlrType = STRING()

  -- Select entry
  !this.selectTableEntry()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup information from passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!function is STRING, !roomType is STRING, !occType is STRING, !colSchema is STRING, !fireRating is STRING, !dClnCode is STRING, !dClnType is STRING, !dFlrCode is STRING, !dFlrType is STRING, !action is STRING)

  -- Set room
  !this.room      = object DBREF()

  -- Set values
  !this.function  = !function
  !this.roomType  = !roomType
  !this.occType   = !occType

  !this.colSchema = !colSchema
  !this.fireRating = !fireRating
  !this.dClnCode = !dClnCode
  !this.dClnType = !dClnType
  !this.dFlrCode = !dFlrCode
  !this.dFlrType = !dFlrType

  !this.action    = object BLOCK(!action)

  -- Select entry
  !this.selectTableEntry()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup information from passed Room
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Room to set up for using
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if setup correctly (error via public_error)
--
------------------------------------------------------------------------

define method .setup(!element is DBREF) is BOOLEAN

  -- Check the element type
  !ownerTypes     = !element.ahList
  !ownerTypes.append(!element.type)

  !index          = !ownerTypes.findFirst('ROOM')
  if(!index.unset()) then
    !!error.text  = 'Element ' & !element.flnn & ' is not a Room element.'
    return false
  endif

  -- Get information
  !owners         = !element.ownLst
  !owners.append(!element)
  !this.room      = !owners[!index]

  -- Get values
  !this.function  = !this.room.function
  !this.roomType  = !this.room.roomType
  !this.occType   = !this.room.occType
  !this.colSchema = !this.room.colSchema
  !this.fireRating = !this.room.fireRating
  !this.dClnCode = !this.room.dClnCode
  !this.dClnType = !this.room.dClnType
  !this.dFlrCode = !this.room.dFlrCode
  !this.dFlrType = !this.room.dFlrType


  -- Select entry
  !this.selectTableEntry()

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectTableEntry
--
-- Description: Set up table from current information
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectTableEntry()

  -- Setup form
  if(!this.room.unset()) then
    !this.formTitle = 'Room Types'
  else
    !this.formTitle = 'Room Type Settings for ' & !this.room.flnn
  endif

  -- Define test data to find in grid
  !data[1]  = !this.function
  !data[2]  = !this.roomType
  !data[3]  = !this.occType
  !data[4]  = !this.colSchema
  !data[5]  = !this.fireRating
  !data[6]  = !this.dClnType
  !data[7]  = !this.dClnCode
  !data[8]  = !this.dFlrType
  !data[9]  = !this.dFlrCode

  -- Find row in grid
  !row      = !this.roomTypeGrid.getRows().findFirst(!data)
  if(!row.set()) then
    !this.roomTypeGrid.selectRow(!row)
  else
    !this.roomTypeGrid.selectRow(1)
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setRoomType
--
-- Description: Get information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setRoomType()

  -- Get selected row
  !data = !this.roomTypeGrid.getSelectedRows()[1]
  handle ANY
    return
  endhandle

  -- Set current setting
  !function         = !data[1].trim()
  !roomType         = !data[2].trim()
  !occType          = !data[3].trim()

  !colSchema  = !data[4].trim()
  !fireRating = !data[5].trim()
  !dClnCode   = !data[6].trim()
  !dClnType   = !data[7].trim()
  !dFlrCode   = !data[8].trim()
  !dFlrType   = !data[9].trim()

  !this.function    = !function
  !this.roomType    = !roomType
  !this.occType     = !occType

  !this.colSchema  = !colSchema
  !this.fireRating = !fireRating
  !this.dClnCode   = !dClnCode
  !this.dClnType   = !dClnType
  !this.dFlrCode   = !dFlrCode
  !this.dFlrType   = !dFlrType

  -- Carry out set action
  if(!this.action.set()) then
    !this.action.evaluate()

  -- If action is not set, the do default action and modify element
  else
    if(!this.function.set()) then
      !this.room.function = !this.function
    endif
    if(!this.roomType.set()) then
      !this.room.roomType = !this.roomType
    endif
    if(!this.occType.set()) then
      !this.room.occType  = !this.occType
    endif

    if(!this.colSchema.set()) then
      !this.room.colSchema  = !this.colSchema
    endif
    if(!this.fireRating.set()) then
      !this.room.fireRating  = !this.fireRating
    endif
    if(!this.dClnCode.set()) then
      !this.room.dClnCode  = !this.dClnCode
    endif
    if(!this.dClnType.set()) then
      !this.room.dClnType  = !this.dClnType
    endif
    if(!this.dFlrCode.set()) then
      !this.room.dFlrCode  = !this.dFlrCode
    endif
    if(!this.dFlrType.set()) then
      !this.room.dFlrType  = !this.dFlrType
    endif

  endif

endmethod
-- End of method
