--
--
-- Description: Set the nAngle and hAngle of Accommodation elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accSlopeAngle()                  -                   Constructor
--  close()                          -
--  draw()                           -                   Setup EDG pick event for picking position
--  initialise()                     -
--  offset(EDGPOSITIONDATA)          -                   Map picked position to room offset
--  pickOffset()                     -                   Define EDG event to pick position
--  refresh()                        -
--  refreshConfig()                  -
--  setup(DBREF)                     BOOLEAN
--  tidy()                           -
--  updateElement()                  -
--  updateGadgets()                  -
--  updatehAngle(GADGET,STRING)      -
--  updatenAngle(GADGET,STRING)      -
--


 setup form !!accSlopeAngle

  !this.formTitle     = 'Angle and Slope'
  !this.iconTitle     = 'Angle and Slope'
  !this.callback      = '!this.initialise()'
  !this.quitcall      = '!this.close()'
  !this.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
  button .selectElement linkLabel 'Element:'  anchor top + left           at x0.5   ymin       callback 'call !!accSlopeAngle(!!ce)' width 6
  paragraph .namepara                         anchor top + left + right   at xmax   ymin       width 20 lines 2

  -- Nangle of element with respect to owner`
  numericinput .nAngleTxt 'Angle from North'              tagwidth 20 anchor top + left  at x0.5    ymax+1      callback '!this.updatenAngle(' range -180 180 ndp 0 width 7
  numericinput .hAngleTxt 'Angle from Horizontal'         tagwidth 20 anchor top + left  at x0.5    ymax+0.5      callback '!this.updatehAngle(' range -180 180 ndp 0 width 7

  -- Apply button
  button .acceptBtn   'Accept'    anchor top + left           at x0.5     ymax+0.5                                  callback '!this.updateElement()' width 5

  -- Dismiss button
  button .discardBtn  'Dismiss'  anchor top + right          at x24   ymin                               callback '!this.close()'  width 5

  -- Form Members
  -- Current Element
  member .element         is DBREF

  -- Element of reference
  member .owner         is DBREF

  -- Element has Nangle attribute
  member .nangleFlag    is BOOLEAN

  -- Nangle Values
  member .nAngle        is REAL

  member .hAngle        is REAL

   -- Plane
  member .plane           is PLANE

  member .aidNumber       is REAL

  -- Attribute data
  member .attributeData   is DBEATTRIBSEARCH

 exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accSlopeAngle
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .accSlopeAngle()

  -- set the attribute Data search  Object
  !this.attributeData = object DBEATTRIBSEARCH(object DBREF() , 'Orientation' , object ARRAY())

  -- Set events for numeric gadgets
  !this.nAngleTxt.modifiedEvents   = true
  !this.hAngleTxt.modifiedEvents   = true

    -- Get aid number
  !this.aidNumber   = !!aidNumbers.add('Nangle display')

   -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

   -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

endmethod

------------------------------------------------------------------------
--
-- Method:initialise
--
-- Description:Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--  element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.setup(!!ce)

endmethod
------------------------------------------------------------------------
--
-- Method:  setup
--
-- Description: Setup form for passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if element is valid
--
------------------------------------------------------------------------

define method .setup(!passedElement is DBREF) is BOOLEAN

  if(!passedElement.ahlist.findfirst('AREADE').set() or !passedElement.type.eq('AREADE')) then
    !ownerList     = !!ce.ownlst
    !ownerPlace    = !!ce.ahlist.findfirst('AREADE')
     if (!ownerPlace.set()) then
      !!ce           = !ownerList[!ownerPlace - 1]
     else
      !!ce           = !ownerList[!ownerList.size()]
     endif
   !passedElement = !!ce

  elseif(!passedElement.ahlist.findfirst('BNDLIN').set() or  !passedElement.type.eq('BNDLIN')) then
     !ownerList     = !!ce.ownlst
    !ownerPlace    = !!ce.ahlist.findfirst('BNDLIN')
    if (!ownerPlace.set()) then
      !!ce           = !ownerList[!ownerPlace - 1]
     else
      !!ce           = !ownerList[!ownerList.size()]
     endif
   !passedElement = !!ce
  endif

  !element         = !this.attributeData.element(!passedElement)

  if (!element.unset() ) then
    !!alert.warning('Element doesn''t have an Orientation attribute.')
    return
  endif

  -- Set element to modify
  !this.element   = !element
  !owner          = !element.owner

  -- set form gadgets values
  !this.namepara.val    = !element.flnn

  -- Get owning frame of reference
  do
    !position = !owner.position
    handle ANY
      !owner    = !owner.owner
      handle ANY
        !!alert.warning('Unable to form frame of reference of element ' & !element.namn)
        return
      endhandle
    elsehandle NONE
      break
    endhandle
  enddo

  -- assign the owner
  !this.owner = !owner

  -- Owing element type
  !description          = 'Relative to ' & !!accConfig.typeDescription(!this.owner.type)

  -- Derive plane where Nangle is measured, this is using POS and ORI of the element
  !this.plane         = object PLANE(!element.position, !owner.orientation)

      !cAngle       =   object COMPOUNDANGLES()
      !angles       =   !cAngle.angles(!this.element.orientation , !this.plane)
      !this.nAngle  =   !angles[1]
      !this.hAngle  =   !angles[2]

  -- Update input gadgets with values
  !this.updateGadgets()

  -- Tag element
  !this.draw()

  -- Return
  return true

endmethod

------------------------------------------------------------------------
--
-- Method:    updatenAngle
--
-- Description: Sets the Nangle of the element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updatenAngle(!gadget is GADGET, !select is STRING)

  !this.nAngle = !gadget.val
  !this.draw()
endmethod
------------------------------------------------------------------------
--
-- Method:    updatehAngle
--
-- Description: Sets the Nangle of the element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updatehAngle(!gadget is GADGET, !select is STRING)



  !this.hAngle = !gadget.val

  !this.draw()

endmethod
------------------------------------------------------------------------
--
-- Method:    updategadgets
--
-- Description: Sets the Nangle of the element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  -- Initialise Variables
 !this.nAngleTxt.val     = !this.nAngle
 !this.hAngleTxt.val     = !this.hAngle

  if (!!dbrefUpdatable(!this.element).not() )  then
      $P $!!error.text
      !this.acceptBtn.active = FALSE
  else
      !this.acceptBtn.active = TRUE
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      draw()
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draw()

  -- Remove current graphics
  !this.tidy()

    !orientation            = object ORIENTATION('Y is N ' & !this.nAngle & ' W ' & !this.hAngle & ' U ')
    !this.plane.orientation = !orientation

  -- Tag at label position
  !labPosition          = !this.plane.position

  if(!this.element.labOffset.set()) then
    !xyPosition         = object XYPOSITION(!this.element.labOffset[1], !this.element.labOffset[2])
    !labPosition        = !this.plane.threeDPosition(!xyPosition)
    !labPosition.up     = !labPosition.up     + !this.element.labOffset[2]
  else
    !xyPosition         = object XYPOSITION(0,0)
    !labPosition        = !this.plane.threeDPosition(!xyPosition)
    !labPosition.up     = !labPosition.up     + 0

  endif

  if(!labPosition.near(!this.plane.position, 10mm).not()) then
    AID TEXT NUMBER $!<this.aidNumber> '$!this.element.flnn' AT $!labPosition
    AID TEXT NUMBER $!<this.aidNumber> 'Origin' AT $!this.plane.position
  else
    AID TEXT NUMBER $!<this.aidNumber> '$!this.element.flnn' AT $!this.plane.position
  endif

  -- Display Angle direction
  !direction            = !this.plane.orientation.yDir()
  AID ARROW NUMBER $!<this.aidNumber> AT $!this.plane.position DIRECTION $!<direction> HEIGHT 1000mm PROPORTION 0.1

  -- Angle from North
  if(!this.nAngle.neq(0)) then

    if(!this.nAngle.lt(0)) then
      !sense        = false
    else
      !sense        = true
    endif
    !arc            = object ARC(!this.plane.position, Y is N, 90, 90 + !this.nAngle, 750mm, !sense)
    !anglePoint     = !arc.anglePosition(90 + !this.nAngle * 0.5)
    !direction      = !arc.angleDirection(!arc.endAngle)
    if(!this.hAngle.eq(0)) then
      AID ARROW NUMBER $!<this.aidNumber> AT $!this.plane.position DIRECTION $!direction HEIGHT 1000mm
    else
      !line         = !arc.position.line(!arc.anglePosition(90 + !this.nAngle))
      !line.draw(!this.aidNumber, 1, 4)
    endif
    AID TEXT NUMBER $!<this.aidNumber> '$!this.nAngle' AT $!anglePoint
    !arc.draw(!this.aidNumber, 1, 4)

  endif

  -- Angle from horizontal
  if(!this.hAngle.neq(0)) then

    if(!this.hAngle.lt(0)) then
      !sense        = false
    else
      !sense        = true
    endif

    !orientation    = object ORIENTATION('X is N ' & !this.nAngle & 'W and Z is E ' & !this.nAngle & ' N')
    !arc            = object ARC(!this.plane.position, !orientation, 0, !this.hAngle, 750mm, !sense)
    !anglePoint     = !arc.anglePosition(!arc.endAngle * 0.5)
    !direction      = !arc.angleDirection(!arc.endAngle)
    AID ARROW NUMBER $!<this.aidNumber> AT $!this.plane.position DIRECTION $!direction HEIGHT 1000mm
    AID TEXT NUMBER $!<this.aidNumber> '$!this.hAngle' AT $!anglePoint
    !arc.draw(!this.aidNumber, 1, 4)
  endif


endmethod

------------------------------------------------------------------------
--
-- Method: close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()
  !this.tidy()
  !this.hide()
endmethod

------------------------------------------------------------------------
--
-- Method: tidy
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()
  AID CLEAR ALL $!<this.aidNumber>
  handle ANY
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      updateelement
--
-- Description: Update element with modified values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateElement()

--mark for undo option
  !nAngleMark = object UNDOABLE()
  !undoDesc = 'Modify Nangle of $!this.namepara.val'
  !nAngleMark.description(!undoDesc)
  !nAngleMark.add()

       -- Calculate the Orientation for elements that do not have nAngle
       !zdir        = !this.element.orientation.zdir()
       !newdirection =  'Y is N ' & !this.nAngle.string() & ' W ' & !this.hAngle.string() & ' U '
       --!neworientation = object ORIENTATION('$!<newdirection> and z is $!<zdir> ')
       !neworientation = object ORIENTATION('$!<newdirection> ')
       !this.element.orientation      = !neworientation

  --for undo option
  !nAngleMark.endundoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Define EDG event to pick position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- method not used  will be used in case any EDG pick is necessary
define method .pickOffset()

  -- Initialise Variables
  -- use the alttext here
  !prompt               = 'Pick origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Modify XYOffset'
  !packet.remove        = true
  !packet.action        = '!!accSlopeAngle.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to room offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

 !!alert.message('Not yet implemented')

endmethod
-- End of method
