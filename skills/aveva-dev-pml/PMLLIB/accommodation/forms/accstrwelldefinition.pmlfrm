------------------------------------------------------------------------
--
-- Method:      selectStrwell
--
-- Description: Select Stair Well from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectStrwell(!dummyPassedArray is ARRAY)

  -- Unenhance walls
  !this.tidyStrwells()

  -- Initialise Variable
  !elements = !this.strwellGrid.getSelectedRowTags()
  !list     = !this.strwellNames
  enhance all from !elements colour red

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      tidyStrwells
--
-- Description: Tidy stair wells
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyStrwells()

  -- Get current list
  !list = !this.strwellNames
  unenhance all from !list

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateStrwellList
--
-- Description: Update grid of stair wells
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateStrwellList()

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('NAME')
  --!attributes.append('InsuType')
  --!attributes.append('DINThickness')
  --!attributes.append('Justification')

  -- Load grid
  if(!this.strwellList.empty().not()) then
    !block                  = object BLOCK('!this.strwellList[!evalIndex].string()')
    !dbNames                = !this.strwellList.evaluate(!block)
    !this.strwellNames         = !dbNames
    using namespace 'Aveva.Pdms.Presentation'
    !nds                = object NETDATASOURCE('Stair Wells', !attributes, !dbNames)
    !this.strwellGrid.bindToDataSource(!nds)

    !selected = ARRAY()
    !selected.append(!this.strwellNames[1])
    --!this.flrcovGrid.setSelectedRowTags(!this.flrcovNames[1])
    !this.strwellGrid.setSelectedRowTags(!selected)
  endif

  if(!this.strwellList.empty()) then
  	!this.mtModStrwell.active  = false
  	!this.mtGeomStrwell.active = false
  	!this.mtDelStrwell.active  = false
  else
    !this.mtModStrwell.active  = true
  	!this.mtGeomStrwell.active = true
  	!this.mtDelStrwell.active  = true
  endif
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      strwellModifySelection
--
-- Description: Modify Selected Stair Well
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strwellModifySelection()

  if !this.strwellGrid.getSelectedRows().unset().not() then
    !element = !this.strwellGrid.getSelectedRows()[1][1].dbref()
  else
    !element = object DBREF()
  endif

  if !element.unset().not() then

    !this.element = !element
    !this.strwellModify(!this.element)

  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      deleteSelectedStrwell
--
-- Description: Delete Selected Stair well
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteSelectedStrwell()

  if !this.strwellGrid.getSelectedRows().unset().not() then
    !element = !this.strwellGrid.getSelectedRows()[1][1].dbref()
  else
    !element = object DBREF()
  endif

  if !element.unset().not() then

    !this.element = !element
    -- Delete current element
    if(!!accDeleteManager.deleteElement(!this.element).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
    endif

    !this.updateStrwellList()

  endif

  if(!this.strwellGrid.getNumberRows().eq(0)) then
  	!this.mtModStrwell.active  = false
  	!this.mtGeomStrwell.active = false
  	!this.mtDelStrwell.active  = false
  else
    !this.mtModStrwell.active  = true
  	!this.mtGeomStrwell.active = true
  	!this.mtDelStrwell.active  = true
  endif


endmethod
------------------------------------------------------------------------
--
-- Method:      strwellModifySelection
--
-- Description: Modify Selected Stair Well
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strwellModifyGeomSelection()

  if !this.strwellGrid.getSelectedRows().unset().not() then
    !element = !this.strwellGrid.getSelectedRows()[1][1].dbref()
  else
    !element = object DBREF()
  endif

  if !element.unset().not() then

    !this.element = !element
    !this.strwellGeometry(!this.element)

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      strModGeometry
--
-- Description: Modify geometry for STRWEL (needs to pass current geometry to shape editor)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strModGeometry()

  -- use the accProfileEdit function to edit the profile
  if(defined(!!dbeProfileEdit)) then
    !!dbeProfileEdit.close()
  endif

  !!accProfileEdit(!this.element)

endmethod
