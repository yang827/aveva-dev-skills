--
--
-- Description:
--    Main form for room definitions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accstrwellDefinition()           -                   Constructor
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  create()                         -                   Create element
--  createStrwell(BOOLEAN)           -
--  deleteSelectedStrwell()          -                   Delete Selected Stair well
--  deleteStrwell()                  -                   Delete ROOM
--  dummy()                          -                   Dummy method for unset
--  elevation()                      -                   Set elevation of level
--  exampleWarning1()                -
--  geometry()                       -                   Define geometry for element
--  geometryUpdate(SHAPEDEFINITION)  -                   Update with returned data
--  height(GADGET,STRING)            -                   Set height of element
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  modify()                         -                   Modify (write modified values to DB)
--  modifyGeometry()                 -                   Modify geometry
--  modifyStrwell(BOOLEAN)           -
--  offset()                         -                   Set xy offset of element
--  offset(EDGPOSITIONDATA)          -                   Map picked position to room offset
--  pickOffset()                     -                   Setup EDG pick event for picking position
--  prmDir(GADGET,STRING)            -                   Set rotate of blevel element
--  refresh()                        -                   Refresh form from navigator.
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  selectStrwell(ARRAY)             -
--  setup()                          -                   Set up form
--  strModGeometry()                 -                   Modify geometry for STRWEL (needs to pass current geometry to shape editor)
--  strwellCreate()                  -                   Create Stair Well
--  strwellGeometry()                -
--  strwellGeometry(BOOLEAN)         -
--  strwellGeometry(DBREF)           -
--  strwellModify()                  BOOLEAN             Modify Stair Well
--  strwellModify(DBREF)             BOOLEAN             Setup to modify room
--  strwellModifyGeomSelection()     -
--  strwellModifySelection()         -                   Modify Selected Stair Well
--  tidyStrwells()                   -
--  updateData()                     -                   Update current data with gadget values
--  updateGadgets()                  -
--  updateStrwellList()              -
--  useActiveStrwells()              -                   Get strwels from current active element
--  warning(ARRAY,STRING)            -                   Set warning task and message with default "Continue"
--  warning(ARRAY,STRING,STRING)     -                   Set warning task and message
--  warningDone()                    -                   Exit warning
--
import 'GridControl'
handle any
endhandle
setup form !!accstrwellDefinition dialog docking right

  !this.formTitle     = 'Stair Well Definition'
  !this.iconTitle     = 'Stair Well'
  !this.callback      = '!this.setup()'
  !this.quitCall    = '!this.definition.tidy()'
  !this.cancelCall    = '!this.definition.tidy()'
  !this.formRevision  = ' $Revision$ '

  -- Main Task Pane
  frame .mainTaskPane panel                   anchor top + left + right         at x0                     y0

-- Stair wells
    paragraph .flrcovListTag                 anchor top + left + right         at x0.5                   ymax                text 'List of Stair Wells'
    line .flrcovL1                           anchor top + left + right         at xmin                   ymax                horizontal width 32

    -- List of stair wells to modify
    container .strwells PMLNetCONTROL 'NET'      anchor top + left + right         at x0                     ymax                width 32 height 8

    -- Populate list of stair wells
    button .strwellsActive    linkLabel 'Current Element'       anchor t + l + r      at x2                     ymax+0.5                 callback '!this.useActiveStrwells()'  width 26

    -- Create options
    paragraph .strwellCreateTasks                                               at x0.5                   ymax                width 30 lines 1
    line .mainTaskL1                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtCrtStrwell     linkLabel 'Stair Well'                             at x2                     ymax                callback '!this.strwellCreate()'

    -- Modify options
    paragraph .strwellModifyTasks                                               at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskL2                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtModStrwell     linkLabel 'Stair Well Definition'                  at x2                     ymax                callback '!this.strwellModifySelection()'
    button .mtGeomStrwell    linkLabel 'Stair Well Geometry'                    at xmin                   ymax                callback '!this.strwellModifyGeomSelection()'

    -- Copy options
    --paragraph .strwellCopyTasks                                                    at x0.5                   ymax+0.5            width 30 lines 1
    --line .mainTaskL3                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    --button .mtCopyStrwell    linkLabel 'Copy Stair Well'                           at x2                     ymax          callback ''

    -- Delete options
    paragraph .strwellDeleteTasks                                                  at x0.5                   ymax+0.5            width 30 lines 1
    line .mainTaskL4                          anchor top + left + right         at xmin                   ymax                horizontal width 32
    button .mtDelStrwell     linkLabel 'Delete Stair Well'                         at x2                     ymax                callback '!this.deleteSelectedStrwell()'

  exit

  -- Stair well creation/modification pane
  frame .editPane panel                             anchor top + left + right   at x0                     y0

    paragraph .editTitle                            anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .editLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Gadgetry definition for creation
    text .dbName  'Name:'  tagwidth 9               anchor top + left + right   at x2                     ymax+0.2            callback '!this.checkName(!this.dbName, !this.definition.name)' width 20 is STRING
    path down
    halign right
    text .dbDescription 'Description:' tagwidth 9   anchor top + left + right                                                 callback '' width 20 is STRING
    text .dbFunction 'Function:'       tagwidth 9   anchor t + l + r              at xmin                   ymax+0.2            callback '' width 20 is STRING
    numericinput .dbNumber 'Number:'   tagwidth 9   anchor top + left           at xmin                   ymax+0.2            callback '' range 0 10000 ndp 0 width 4

    -- Positioning
    paragraph .location                             anchor top + left + right   at x0.5                   ymax+0.2            text 'Location:' width 28 lines 1
    line .editLine2                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

    -- Primary Direction
    text .prmDirTxt 'Primary Direction:'  tagwidth 12   anchor t + l                at x2                ymax+0.2             callback '!this.prmDir('   width 6 is DIRECTION

    -- Elevation
    text .elevation 'Elevation:'    tagwidth 12  anchor top + left + right           at x2                     ymax+0.5            callback '!this.elevation()' width 14  is REAL format !!distanceFmt
    path down
    halign right
    -- Ceiling height
--  text .clnHeight 'Ceiling height:'  tagwidth 11  anchor top + left                                                         width 14  is REAL format !!distanceFmt

    -- XY Offset of stair well from building origin
    button .offset linkLabel 'Stair Well Offset'    anchor top + left + right   at x2                     ymax+0.2            callback '!this.pickOffset()' width 20
    text .xOffset   'X:'                            anchor top + left + right   at xmin+7.5                 ymax                callback '!this.offset()' width 18 is REAL format !!distanceFmt
    text .yOffset   'Y:'                            anchor top + left + right   at xmin                   ymax+0.2            callback '!this.offset()' width 18 is REAL format !!distanceFmt


    paragraph .sizePara anchor top + left + right   at x0.5                   ymax                text 'Design Criteria' width 28 lines 1
    line .editLine3     anchor top + left + right   at xmin                   ymax                horizontal width 32

    --paragraph .opLenTag  anchor top + left           at x14     ymax                text 'Length'
    --paragraph .opWidTag  anchor top + left           at xmax+3.5  ymin                text 'Width'
    --paragraph .opHeiTag  anchor top + left           at xmax+3    ymin                text 'Height'

    --text .opLengthTxt  'Operating' tagwidth 12  anchor top + left          at x0.5        ymax-0.1             callback '' width 8 is REAL format !!distanceFmt
    --text .opWidthTxt     anchor top + left          at xmax+0.5  ymin                 callback '' width 8 is REAL format !!distanceFmt
    --text .opHeightTxt    anchor  top + left+right   at xmax+0.5  ymin                 callback '' width 8 is REAL format !!distanceFmt

    text .headRoomTxt  'Head Room'         tagwidth 12       anchor top + left+right        at x2                     ymax+0.2                callback '' width 14 is REAL format !!distanceFmt
    text .headClearTxt 'Head Clearance:'   tagwidth 12       anchor top + left+right        at x2                     ymax+0.2                callback '' width 14 is REAL format !!distanceFmt
    text .cwidthTxt    'Clearance Width:'  tagwidth 12       anchor top + left+right        at x2                     ymax+0.2               callback '' width 14 is REAL format !!distanceFmt

    --frame .linkedLevelcntrl FoldUpPanel |Connected Levels|   anchor left + right + top         at x0                 ymax+0.5        width 32
        --textpane .accLevelsPane  'Access Levels'             anchor left + top                 at xmin               ymax            width 16 heig 6
        --textpane .levRfaPane     'Reference Levels'          anchor left + right + top         at xmax               ymin            width 16 heig 6
    --exit

    -- Defaults
    --frame .criteria FoldUpPanel 'Design Criteria' anchor top + left + right     at x0                     ymax+0.5            width 32

      -- Occupancy
      --paragraph .occupancyTag                       anchor t + l + r            at x0.5                   ymax                width 20 lines 1
      --combo .occType 'Type:'            tagwidth 8  anchor t + l                at x3.5                   ymax                width 13
      --numericinput .occupancy 'Number:' tagwidth 8  anchor t + l + r            at xmin                   ymax+0.2            range 0 1000 ndp 0 width 6

      -- Colour scheme
      --combo .colSchema 'Colour Schema:' tagwidth 11 anchor t + l                at x0.5                   ymax+0.5            width 13

      -- Lighting
      --text .lighting 'Lighting:'        tagwidth 11 anchor t + l + r            at x0.5                   ymax+0.5            width 13 is REAL
      -- Air change rate
      --text .airChangeRate 'Air change rate:'  tagwidth 11 anchor t + l + r      at x0.5                   ymax+0.5            width 13 is REAL
      -- Fire rating
      --combo .fireRating 'Fire rating:'  tagwidth 11 anchor t + l                at x0.5                   ymax+0.5            width 13

    --exit

    -- Environment Information
    --frame .environment FoldUpPanel 'Environment Settings' anchor t + l + r      at x0                     ymax+0.5            width 32

      --paragraph .ambTag                             anchor top + left           at x11.5                  ymax                text 'Design'
      --paragraph .maxTag                             anchor top + left           at xmax+1.5               ymin                text 'Min'
      --paragraph .minTag                             anchor top + left           at xmax+3                 ymin                text 'Max '

      --text .temperature 'Temperature:' tagwidth 10  anchor top + left           at x1                     ymax-0.1            width 5 is REAL format !!integerFmt
      --text .minTemp                                 anchor top + left           at xmax+0.5               ymin                width 5 is REAL format !!integerFmt
      --text .maxTemp                                 anchor top + left + right   at xmax+0.5               ymin                width 5 is REAL format !!integerFmt

      --text .pressure 'Pressure:' tagwidth 10        anchor top + left           at x1                     ymax+0.2            width 5 is REAL format !!realFmt
      --text .minPressure                             anchor top + left           at xmax+0.5               ymin                width 5 is REAL format !!realFmt
      --text .maxPressure                             anchor top + left + right   at xmax+0.5               ymin                width 5 is REAL format !!realFmt

      --text .humidity 'Humidity:' tagwidth 10        anchor top + left           at x1                     ymax+0.2            width 5 is REAL format !!realFmt
      --text .minHumidity                             anchor top + left           at xmax+0.5               ymin                width 5 is REAL format !!realFmt
      --text .maxHumidity                             anchor top + left + right   at xmax+0.5               ymin                width 5 is REAL format !!realFmt

      --paragraph .waterTag                           anchor top + left           at x1                     ymax+0.2            text 'Water Depth'
      --text .maxWater                                anchor top + left + right   at xmin.maxHumidity       ymin                width 5 is REAL format !!realFmt

      --toggle .waterTight 'ROOM is water tight' tagwidth 24    anchor t + l + r  at x4                     ymax+0.5
      --toggle .gasTight   'ROOM is gas tight'   tagwidth 24    anchor t + l + r  at xmin                   ymax
    --exit

    -- Defaults
    --frame .defaults FoldUpPanel 'Defaults'          anchor top + left + right   at x0                     ymax+0.5            width 32

      --combo .dClnType 'Ceiling Type:'           tagwidth 10 anchor t + l        at xmin                   ymax+0.5            width 13
      --combo .dClnCode 'Ceiling Code:'           tagwidth 10 anchor t + l        at xmin                   ymax+0.2            width 13

      --combo .dFlrType 'Floor Type:'             tagwidth 10 anchor t + l        at xmin                   ymax+0.5            width 13
      --combo .dFlrCode 'Floor Code:'             tagwidth 10 anchor t + l        at xmin                   ymax+0.2            width 13

    --exit

    -- Modification data specific to a stair well
    frame .modPane panel                            anchor top + left + right   at x0                     ymax+0.5

      -- Accept Changes
      paragraph .modAcceptIcon                      anchor top + left           at x0                     ymax+0.2            pixmap width 16 height 16
      button .modAccept  linkLabel 'Accept Changes' anchor top + left           at xmax+0.5               ymin                callback '!this.modify()' width 10

      -- Discard Changes
      paragraph .modDiscardIcon                     anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
      button .modDiscard linkLabel 'Discard Changes' anchor top + right         at xmax+0.5               ymin                callback '!this.strwellModify(!this.element)' width 10

      paragraph .modBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      button .modMain   linkLabel   'Back to main STRWEL tasks'                   at xmax+1                 ymin                callback '!this.mainTasks(true)'

    exit

    -- Creation data specific to a stair well
    frame .crtPane panel                            anchor top + left + right   at xmin.modPane           ymin.modPane

      paragraph .createGeometry                     anchor top + left + right   at x0.5                   ymax                text 'Geometry' width 28 lines 1
      line .editLine4                               anchor top + left + right   at xmin                   ymax                horizontal width 32

      -- Define geometry definition method
      text .height 'Default height:' tagwidth 10    anchor top + left + right   at x2                     ymax+0.2            callback '!this.height(' width 19 is REAL format !!distanceFmt

      -- Define geometry
      button .crtShape linkLabel  'Define BBLOCK geometry:' anchor t + l + r    at xmin                   ymax+0.2            callback '!this.geometry()' width 28
      paragrap .crtShapeDef                         anchor top + left + right   at xmin+2                 ymax                width 28 lines 1

      -- Create Stair Well
      paragraph .crtAcceptIcon                      anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .crtAccept linkLabel 'Create Strwell'     anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.create()' width 12

      paragraph .crtBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .crtMain   linkLabel 'Back to main Strwell tasks'                     at xmax+1                 ymin                callback '!this.mainTasks(true)'

    exit

  exit

  -- Modify geometrical information
  frame .modGeometry panel                          anchor top + left + right   at x0                     y0

    paragraph .geomTitle                            anchor top + left + right   at x0.5                   ymax                width 30 lines 1
    line .geomLine1                                 anchor top + left + right   at xmin                   ymax                horizontal width 32

      -- Define geometry definition method
      text .gHeight 'Default height:' tagwidth 10   anchor top + left + right   at x2                     ymax+0.5            callback '!this.height(' width 19 is REAL format !!distanceFmt
      button .strModShape linkLabel 'Modify StairWell Geometry:' anchor t + l + r at x2                   ymax+0.5            callback '!this.strModGeometry()' width 28

      -- Accept Changes
      paragraph .gModAcceptIcon                     anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .gModAccept  linkLabel 'Accept Changes'anchor top + left           at xmax+0.5               ymin                callback '!this.modifyGeometry()' width 10

      -- Discard Changes
      paragraph .gModDiscardIcon                      anchor top + right        at xmax+4                 ymin                pixmap width 16 height 16
      button .gModDiscard linkLabel 'Discard Changes' anchor top + right        at xmax+0.5               ymin                callback '!this.strwellGeometry(!this.element)' width 10

      paragraph .gModBackIcon                        anchor top + left          at x0                     ymax+0.5            pixmap width 15 height 15
      button .gModMain   linkLabel  'Back to StairWell Tasks'                   at xmax+1                 ymin                callback '!this.mainTasks(true)'

  exit

  -- Warning Task Pane
  frame .warningPane panel                    anchor top + left + right         at x0                     y0

    paragraph .warningHeader                                                    at x0                     ymax                text 'Warning'
    line .warningLine                         anchor top + left + right         at x0                     ymax                horizontal width 32
    paragraph .warningIcon                    anchor left + top                 at x0.5                   ymax+0.2            pixmap width 32 heigh 32
    paragraph .warning                        anchor left + right + top         at xmax+2                 ymin                width 26 lines 6
    button    .warningDone linkLabel 'Continue' anchor left + top               at x0.5                   ymax                callback '!this.warningDone()' width 28

  exit

  -- Form Members
  using namespace 'PMLPositionControl'

  -- Alternative text for element type
  member .altText         is STRING

  -- Owning element
  member .owner           is DBEBBLOCK
  member .owningElement   is DBREF

  -- Current Element (Stair Well)
  member .element         is DBREF
  member .definition      is DBESTRWELL

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK
  member .refreshTask     is BLOCK

  -- Floor coverings for modification
  member .strwellList        is ARRAY
  member .strwellNames       is ARRAY

  -- Warning action
  member .warningAction   is BLOCK

  -- Undo for form
  member .undo            is UNDOABLE

  -- EDG Description
  member .edgDescription  is STRING

  -- Aid Numbers
  member .aidAxes         is REAL
  member .outerBoundary   is REAL

  -- Stair wells grid
  using namespace 'Aveva.Pdms.Presentation'
  member .strwellGrid        is NETGRIDCONTROL
  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
  --!!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accstrwellDefinition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accstrwellDefinition()

  -- Set form to autoscroll
  !this.autoScroll              = true

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!this.dummy()')
  !this.refreshTask             = object BLOCK('!this.dummy()')

  -- Set "Back" icon
  !backIcon                     = !!pml.getPathname('back.png')
  !this.crtBackIcon.addPixmap(!backIcon)
  !this.modBackIcon.addPixmap(!backIcon)
  !this.gModBackIcon.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getPathname('create.png')
  !this.crtAcceptIcon.addPixmap(!createIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getPathname('accept.png')
  !this.modAcceptIcon.addPixmap(!acceptIcon)
  !this.gModAcceptIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getPathname('discard.png')
  !this.modDiscardIcon.addPixmap(!discardIcon)
  !this.gModDiscardIcon.addPixmap(!discardIcon)

  -- Set "Warning" icon
  !warningIcon                  = !!pml.getPathname('exclamation-32.png')
  !this.warningIcon.addPixmap(!warningIcon)

  -- Add .Net control to PML container for floor coverings
  using namespace 'Aveva.Pdms.Presentation'
  !this.strwellGrid              = object NETGRIDCONTROL()
  !this.strwells.control         = !this.strwellGrid.handle()
  --!this.wallGrid.addEventHandler('onPopup',           !this, 'popupRoom')
  !this.strwellGrid.addEventHandler('afterSelectChange', !this, 'selectStrwell')

  -- Load information from Configuration
  !this.refreshConfig()

  -- Initialise task panes
  !this.mainTasks(true)
  !this.createStrwell(false)
  --!this.modifyStrwell(false)
  !this.warningPane.visible     = false

  -- EDG Description
  !this.edgDescription    = 'Accommodation Stair Well Definition'

  -- Assign aid numbers for form
  !this.aidAxes           = !!aidNumbers.add('Stair Well Definition - Axes')
  !this.outerBoundary     = !!aidNumbers.add('Stair Well Definition - OuterBoundary')

  -- Populate combo with defaults
--  !this.dbFunction.dtext  = !!accConfig.roomFunctions()
  --!this.occType.dtext     = !!accConfig.occupancyTypes()
  --!this.colSchema.dtext   = !!accConfig.colourSchemes()
  --!this.fireRating.dtext  = !!accConfig.fireRatings()
  --!this.dClnType.dtext    = !!accConfig.ceilingTypes()
  --!this.dClnCode.dtext    = !!accConfig.ceilingCodes()
  --!this.dFlrType.dtext    = !!accConfig.floorTypes()
  --!this.dFlrCode.dtext    = !!accConfig.floorCodes()

  -- set tag for Geometry button
   !this.crtShape.tag     = 'Define ' & !this.altText &  ' geometry:'

  -- Register refresh with navigator form
  --!action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  --!!accControl.register('accNavigator', !action)

  -- Register refresh with config settings form
  !action                 = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

  -- Register refresh with navigator form
  !action                 = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dummy
--
-- Description: Dummy method for unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dummy()
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh form from navigator.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh task
  if(!this.shown()) then
    !this.setup()
    !this.refreshTask.evaluate()
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Set form members for when form title changes in other methods
  !this.altText                 = 'Stair Well'

  -- Replacement Text (set using configuration information)
  !strwellText                    = !this.altText

  -- Strwell Tasks
  !this.strwellCreateTasks.val     = 'Create'
  !this.strwellModifyTasks.val     = 'Modify'
  --!this.strwellCopyTasks.val       = 'Copy'
  !this.strwellDeleteTasks.val     = 'Delete'

  -- Stair Well Create Task Tags
  !this.mtCrtStrwell.tag          = !strwellText
  --!this.mtCrtMRoom.tag          = 'Multiple ' & !strwellText & 's'

  -- Stair Well Modify Task Tags
  !this.mtModStrwell.tag           = !strwellText & ' Definition'
  !this.mtGeomStrwell.tag          = !strwellText & ' Geometry'

  -- Stair Well Action Task Tags
  --!this.mtCopyStrwell.tag          = 'Copy ' & !strwellText
  !this.mtDelStrwell.tag           = 'Delete ' & !strwellText

  -- Stair Well Editing Tags
  !this.offset.tag              = !strwellText & ' Offset...'
  --!this.offsetTag.val           = !strwellText & ' Offset'

  --!this.occupancyTag.val        = !strwellText & ' Occupancy:'

  --!this.waterTight.tag          = ' ' & !strwellText & ' is water tight'
  --!this.gasTight.tag            = ' ' & !strwellText & ' is gas tight'

  -- Stair Well Modify tags
  !this.modMain.tag             = 'Back to main ' & !strwellText & ' tasks'

  -- Stair Well Create tags
  !this.crtAccept.tag           = 'Create ' & !strwellText
  !this.crtMain.tag             = 'Back to main ' & !strwellText & ' tasks'

  !this.crtShape.tag           = 'Define ' & !strwellText &  ' geometry:'

  -- Grid defaults
  !columnExcelFilter            = !!accConfig.navigator.columnExcelFilter
  !outlookGroupStyle            = !!accConfig.navigator.outlookGroupStyle
  !columnSummaries              = !!accConfig.navigator.columnSummaries
  !labelVisibility              = !!accConfig.navigator.labelVisibility

  -- Control configuration (Stair Wells)
  !this.strwellGrid.columnExcelFilter(!columnExcelFilter)
  !this.strwellGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.strwellGrid.columnSummaries(!columnSummaries)
  !this.strwellGrid.fixedHeaders(false)
  !this.strwellGrid.fixedRows(false)
  !this.strwellGrid.singleRowSelection(true)
  !this.strwellGrid.setLabelVisibility(!labelVisibility)

    --update the Combo boxes as well
--  !this.dbFunction.dtext  = !!accConfig.roomFunctions()
  --!this.occType.dtext     = !!accConfig.occupancyTypes()
  --!this.colSchema.dtext   = !!accConfig.colourSchemes()
  --!this.fireRating.dtext  = !!accConfig.fireRatings()
  --!this.dClnType.dtext    = !!accConfig.ceilingTypes()
  --!this.dClnCode.dtext    = !!accConfig.ceilingCodes()
  --!this.dFlrType.dtext    = !!accConfig.floorTypes()
  --!this.dFlrCode.dtext    = !!accConfig.floorCodes()


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Set up form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise !this.element

  -- Initialise Variables
  --!this.owningElement  = !!accNavigator.bblock()

  !element                = !!accNavigator.currentSelection()

  -- If element is unset, then initialise form with limited actions
  if(!element.unset() or !element.badref()) then
    !this.owningElement         = object DBREF()
    --!this.currentOwner.val      = 'No active element selected'

  -- Initialise form with relevant actions
  else
    if !element.type.eq('ROOM') then
      !this.owningElement  = !!accNavigator.blevel()
    else

      -- Set owner where layout data is to be stored
      !this.owningElement         = !element
      --!this.ownerType             = !this.owningElement.type
    endif

    !this.strwellsActive.tag          = 'Select ' & !this.owningElement.namn & ' Stair Wells'

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.mainTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.mainTasks(false)')
    !this.refreshTask         = object BLOCK('!this.dummy()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Main ' & !this.altText & ' Tasks'

  endif

  -- Show/hide task pane
  !this.mainTaskPane.visible = !active
  if(!this.strwellList.empty()) then
  	!this.mtModStrwell.active  = false
  	!this.mtGeomStrwell.active = false
  	!this.mtDelStrwell.active  = false
  else
    !this.mtModStrwell.active  = true
  	!this.mtGeomStrwell.active = true
  	!this.mtDelStrwell.active  = true
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createStrwell
--
-- Description: Display stair well pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createStrwell(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.createStrwell(false)')
    --!this.refreshTask         = object BLOCK('!this.strwellCreate()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Create ' & !this.altText

    -- set up values from configuration
    !this.definition.headRoom  = !!accConfig.headRoom
    !this.definition.headClearance  = !!accConfig.headClear
    !this.definition.cwidth  = !!accConfig.clearWidth

    -- Manage create/modify panels
    !this.modPane.visible     = false
    !this.crtPane.visible     = true
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Update gadgets
  !this.updateGadgets()

  -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyStrwell
--
-- Description: Display stair well pane in modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyStrwell(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.modifyStrwell(false)')
    --!this.refreshTask         = object BLOCK('!this.strwellModify()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify ' & !this.altText

    -- Manage create/modify panels
    !this.modPane.visible     = true
    !this.crtPane.visible     = false
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      strwellCreate
--
-- Description: Create Stair Well
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strwellCreate()

  -- Initialise Variables
  !this.owner                 = object DBEBBLOCK(!!accNavigator.bblock())
  !this.definition            = object DBESTRWELL()
  --!this.definition.initialise(!this.owner.dbElement)
  !this.definition.initialise(!this.owningElement)

  -- Form title
  !this.formTitle             = 'Create ' & !this.altText

  -- Edit panel title
  !this.editTitle.val         = 'New ' & !this.altText &' for ' & !this.owningElement.namn
  !this.crtShapeDef.val       = 'None currently defined'

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary)

  -- Update gadgets
  !this.updateGadgets()

  -- Setup panes
  !this.createStrwell(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      strwellModify
--
-- Description: Modify Stair Well
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strwellModify() is BOOLEAN
  -- return !this.strwellModify(!!accNavigator.room())

    -- Find the ceiling of the current element
  do !i indices !this.owningElement.members
    !element  = !this.owningElement.members[!i]
    !strwel = strwel 1 of $!element
    handle ANY
      skip
    elsehandle NONE
      break
    endhandle
  enddo

  -- No floor covering found
  if(undefined(!strwel)) then
    return false
  endif

  -- Display modify pane
  return !this.strwellModify(!strwel)


  --return !this.strwellModify(!this.element)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      strwellModify
--
-- Description: Setup to modify stair well
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Stair Well to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .strwellModify(!element is DBREF) is BOOLEAN

  -- Check Stair Well has been passed
  if(!element.fulltype.neq('STRWELL')) then
    !!error.text               = 'Element "' & !element.namn & '" is not a Stair Well.'
    return false
  endif

  -- Load current Stair Well
  !this.element                   = !element

  !this.owner                     = object DBEBBLOCK(!element.owner)
  !this.definition                = object DBESTRWELL(!element)
  !this.owningElement             = !element.owner

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary)

  -- Form title
  !this.formTitle                 = 'Modify ' & !this.altText

  -- Edit panel title
  !this.editTitle.val             = !this.altText & ': ' & !this.element.namn

  -- Update Stair Well gadgets
  !this.updateGadgets()

  -- Setup panes
  !this.modifyStrwell(true)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      strwellGeometry
--
-- Description: Switch to geometry modification pane for current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strwellGeometry()
--  !this.strwellGeometry(!!accNavigator.room())
    !this.strwellGeometry(!this.element)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      strwellGeometry
--
-- Description: Switch to geometry modification pane for specified element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strwellGeometry(!element is DBREF)

  -- Check Stair Well has been passed
  if(!element.fulltype.neq('STRWELL')) then
    !!error.text               = 'Element "' & !element.namn & '" is not a STRWELL.'
    return false
  endif

  -- Load current Stair Well
  !this.element                   = !element

  !this.owner                     = object DBEBBLOCK(!element.owner)
  !this.definition                = object DBESTRWELL(!element)
  !this.owningElement             = !element.owner

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary)

  -- Form title
  !this.formTitle                 = 'Modify ' & !this.altText

  -- Edit panel title
  !this.geomTitle.val             = 'Modify Geometry of ' & !this.element.namn

  -- Update attributes
  !this.gHeight.val         = !this.definition.defaultHeight

  -- Update gadgets in create/modify too
  !this.updateGadgets()

  -- Display pane
  !this.strwellGeometry(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      strwellGeometry
--
-- Description: Switch to geometry modification pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strwellGeometry(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.modGeometry

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.strwellGeometry(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify ' & !this.altText & ' Geometry'

    -- Draw
    !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary)
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.modGeometry.visible   = !active

endmethod
-- End of method

