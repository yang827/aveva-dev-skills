-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteStrwell()

  --should this be automated, i.e. from subscription mechanism?
 -- !this.element                  = !!accNavigator.strwell()

  -- Delete current element
  if(!!accDeleteManager.deleteElement(!this.element).not()) then
    !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  endif

endmethod

