--
-- Method:      createBLevel
--
-- Description: Create BLEVEL
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create()
  -- Check shape is defined, otherwise do not allow creation
  if !this.definition.outerLoop.area().eq(0) then
    !!alert.warning('Stair well geometry must be defined before stair well is created')
  else
    -- Reference Element
    !reference  = !!ce

    -- Define UNDO Information
    --!this.undo  = object UNDOABLE()

    --!this.undo.description('Created ' & !this.blevelRText)
    --!this.undo.undoAction('!!accMainRefData.undoAction(''!this.blevelCreate()'')')
    --!this.undo.redoAction('!!accMainRefData.undoAction(''!this.blevelModify(' & !this.blevel & ')'')')
    --!this.undo.add()

    -- Navigate to BBlock
    !!ce                  = !this.owningElement

    -- Update Block Attributes
    !this.updateData()

    -- Create new element
    if(!this.definition.create()) then
      !this.element        = !this.definition.dbElement

      -- Generate Boundary and Area Definition
      if(!this.definition.outerLoop.set()) then
        !!ce              = !this.element

        -- Create boundary
        NEW BNDLIN
        --!!ce.description  = !this.blevelRText & ' Boundary'

        -- Name element
        if(!this.element.isNamed) then
          call !!autoNameCe(false)
        endif
        NEW LOOP
        !this.definition.outerLoop.dbWrite(CE)

        -- Create Area definition
        NEW AREADEF
        --!!ce.description  = !this.blevelRText & ' Volume'

        -- Name element
        if(!this.element.isNamed) then
          call !!autoNameCe(false)
        endif
        NEW AEXTR
        !!ce.obs = 0
        !extrusion        = !!ce
        !extrusion.height = !this.definition.defaultHeight
        RULE SET HEIGHT STATIC (heiDefault of STRWEL)
        NEW LOOP
        !this.definition.outerLoop.dbWrite(CE)

        -- Set the label position to the mid point of the area def as a default
        --!cofg             = !extrusion.gcofg
        --handle ANY
        --elsehandle NONE
          --!labOffset[1]           = !cofg.east
          --!labOffset[2]           = !cofg.north
          --!labOffset[3]           = 0
          --!this.blevel.labOffset  = !labOffset
        --endhandle

      endif

      -- Switch to modify pane
      !this.strwellModify(!this.element)

      -- Refresh navigator, this should be handled by the navigator itself
      --!!accNavigator.reloadBLevels(!this.blevel)

    -- Failed creating element
    else
      !!alert.warning(!!error.text)
    endif

    -- Set end mark for UNDO
    --!this.undo.endUndoable()

    -- Return to original element
    !!ce        = !reference
  endif
endmethod
------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.element.namn & ')')
  !this.undo.add()

  -- Modify Stair Well
  if(!this.definition.modify().not())then
    !!alert.warning(!!error.text)
  endif

  -- Refresh navigator, this should be handled by the navigator itself
  !!accNavigator.reloadRooms(!this.element)

  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      modifyGeometry
--
-- Description: Modify geometry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyGeometry()

  -- Update Block Attributes
  !this.updateData()

  -- Define UNDO Information
  !this.undo.description('Modified (' & !this.element.namn & ')')
  !this.undo.add()

  -- Modify Stair Well
  !this.definition.modify()

  -- Update any rules on the area definition
  RULE EXECUTE ALL ON ALL AEXTR FOR $!<this.element>
  handle ANY
  endhandle

  -- Refresh navigator, this should be handled by the navigator itself
  !!accNavigator.reloadRooms(!this.element)

  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      geometry
--
-- Description: Define geometry for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometry()

  -- Define data to pass to shape definition form
  !plane  = !this.definition.plane
  !shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)

  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form for return to Stair Well creation
  -- Information for form is:
  --   Calling form
  --   Form title
  --   Apply tag (Test for "apply" button)
  --   Action on completion, method name only, method must be in format
  --      .methodName(<SHAPEDEFINITION>)
  --   Default shape, should be at least pos and ori of the plane the
  --   shape is to be mapped onto.
  !!shapeDefinitionEditor.setup(!this, 'Define Stair Well Boundary', 'Define Boundary', 'geometryUpdate', !shape)

endmethod

------------------------------------------------------------------------
--
-- Method:      geometryUpdate
--
-- Description: Update with returned data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geometryUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  !this.crtShapeDef.val       = !shapeDefinition.description

  !this.definition.position(!shapeDefinition.profile.position)
  !this.definition.outerLoop  = !shapeDefinition.profile
  !this.definition.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message with default "Continue"
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Done"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING)
  !this.warning(!message, !action, 'Continue')
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: Set elevation of level
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elevation()
  !this.definition.elevation(!this.elevation.val)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Set xy offset of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset()
  !offset[1]  = !this.xOffset.val
   handle ANY
    !offset[1] = 0
   endhandle
  !offset[2]  = !this.yOffset.val
   handle ANY
    !offset[2] = 0
   endhandle

  -- if (!this.flrHeight.val.unset() ) then
    --!this.flrHeight.val = 0
   --endif
  !this.definition.position(!offset, 0)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      prmDir
--
-- Description: Set rotate of blevel element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .prmDir(!gadget is GADGET, !select is STRING)

  -- Initialise Variables
  !this.definition.prmDir(!gadget.val)
  refresh

 -- Can we update the gadget back
 !gadget.val = !this.definition.prmDir
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      height
--
-- Description: Set height of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .height(!gadget is GADGET, !select is STRING)

  -- Initialise Variables
  !this.definition.height(!gadget.val)
  refresh

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickOffset()

  -- Initialise Variables
  !prompt               = 'Pick ' & !this.altText & ' origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to stair well offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

  -- Initialise Variables
  !this.definition.xyOffset(!data.position)

  -- Update gadget
  !this.xOffset.val = !this.definition.xyOffset[1]
  !this.yOffset.val = !this.definition.xyOffset[2]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      warning
--
-- Description: Set warning task and message
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Warning message
--    2   R      STRING      Callback action for "Continue"
--    3   R      STRING      "Continue" text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warning(!message is ARRAY, !action is STRING, !continue is STRING)

  -- Switch warning pane
  !this.currentPane.visible   = false
  !this.warningPane.visible   = true

  -- Concatenate message into a single line
  !display    = ''
  do !i indices !message
    !display  = !display & ' ' & !message[!i]
  enddo

  -- Display message
  !this.warning.val           = !display.trim()
  !this.warningDone.tag       = !continue

  -- Set "Continue" action (If the action is dependent on other criteria
  -- e.g. being in the correct position in the hierarchy, then the
  -- active state of the "Done" button needs to be managed.
  !this.warningAction         = object BLOCK(!action)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      warningDone
--
-- Description: Exit warning
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .warningDone()

  -- Hide warning pane
  !this.warningPane.visible   = false

  -- Execute action
  !this.warningAction.evaluate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      exampleWarning
--
-- Description: Example of how to use a warning with an action
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exampleWarning1()

  -- Define message to be displayed
  !message[1] = 'This is the message that is to be displayed in the '
  !message[2] = 'warning pane. The message can be up to 132 characters'
  !message[3] = 'long.'
  !this.warning(!message, '!this.firstTaskPane(true)', !this.ftpWarningMsg.val)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteStrwell
--
-- Description: Delete STRWELL
--
