-- Created:         Fri Mar 2 09:00:00 GMT 2007
--
--
-- Description:
--    Form for setting up the view(s) for accommodation elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accViewSetup()                   -                   Constructor
--  addElement()                     -                   Add current navigator elements to graphics
--  displayElement()                 -                   Remove all and Add current navigator elements to graphics
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  refreshElement()                 -                   Refresh current navigator elements in current drawlist
--  refreshGraphics()                -                   Refresh all accommodation elements in current drawlist
--  refreshUpdate()                  -                   Refresh update buttons
--  setFittingDetail()               -                   Set fitting detail flag
--  setFittingFlags()                -                   Set fitting flags
--  setFittingTag()                  -                   Set fitting tag flag
--  setupData()                      -                   Setup data settings
--  setupDetailData()                -                   Setup data settings
--  setupRefData()                   -                   Setup data settings
--  updateDetailGadgets()            -                   Update detail gadgets
--  updateDetailSettings()           -                   Update the accVisualisation object with the detail settings
--  updateGadgets()                  -                   Update gadgets
--  updateGadgets(STRING)            -                   Update gadgets
--  updateRefDataGadgets()           -                   Update reference data gadgets
--  updateRefDataSettings()          -                   Update the accVisualisation object with the ref data settings
--  updateSettings()                 -                   Update the accVisualisation object
--

setup form !!accViewSetup dialog docking right

  !this.formTitle     = 'View Setup'
  !this.iconTitle     = 'View'
  !this.callback      = '!this.updateGadgets()'
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision$ '
  !this.autoscroll    = true

  path down
  vdist 0

  -- Detail Data
  paragraph .refDataTag                       anchor top + left + right         at x0.5                   ymax                text 'Reference Settings'
  line .refDataLine                           anchor top + left + right         at x0.5                   ymax                horizontal width 32

  -- Standard Setting for main reference data
  option .refDataOpt 'Predefined:' tagwidth 13 anchor top + left + right        at x2                     ymin+0.5            callback '!this.setupRefData()' width 14

  -- Main reference options
  frame .mainRefData folduppanel 'Options:'   anchor top + left + right         at x0.5                   ymax+0.5            width 32

    paragraph .taggingBBlock                  anchor top + left + right         at x2                     ymax+1.5            width 12 lines 1
    toggle .volBBlock                         anchor top + right                at xmax+2.5               ymin
    toggle .bndBBlock                         anchor top + right                at xmax+3.5               ymin
    toggle .tagBBlock                         anchor top + right                at xmax+2.5               ymin

    paragraph .taggingBLevel                  anchor top + left + right         at x2                                         width 12 lines 1
    toggle .volBLevel                         anchor top + right                at xmin.volBBlock         ymin
    toggle .bndBLevel                         anchor top + right                at xmin.bndBBlock         ymin
    toggle .tagBLevel                         anchor top + right                at xmin.tagBBlock         ymin

    paragraph .taggingRoom                    anchor top + left + right         at x2                                         width 12 lines 1
    toggle .volRoom                           anchor top + right                at xmin.volBBlock         ymin
    toggle .bndRoom                           anchor top + right                at xmin.bndBBlock         ymin
    toggle .tagRoom                           anchor top + right                at xmin.tagBBlock         ymin

    paragraph .taggingCeiling                 anchor top + left + right         at x2                                         width 12 lines 1
    toggle .volCeiling                        anchor top + right                at xmin.volBBlock         ymin
    toggle .bndCeiling                        anchor top + right                at xmin.bndBBlock         ymin
    toggle .tagCeiling                        anchor top + right                at xmin.tagBBlock         ymin

    paragraph .taggingCGrids                  anchor top + left + right         at x2                                         width 12 lines 1
    toggle .bndCGrids                         anchor top + right                at xmin.bndBBlock         ymin
    toggle .tagCGrids                         anchor top + right                at xmin.tagBBlock         ymin

    paragraph .taggingStairwells              anchor top + left + right         at x2                                         width 12 lines 1
    toggle .volStairwells                     anchor top + right                at xmin.volBBlock         ymin
    toggle .bndStairwells                     anchor top + right                at xmin.bndBBlock         ymin
    toggle .tagStairwells                     anchor top + right                at xmin.tagBBlock         ymin

    paragraph .taggingOpenSp                  anchor top + left + right         at x2                                         width 12 lines 1
    toggle .volOpenSp                         anchor top + right                at xmin.volBBlock         ymin
    toggle .bndOpenSp                         anchor top + right                at xmin.bndBBlock         ymin
    toggle .tagOpenSp                         anchor top + right                at xmin.tagBBlock         ymin

    paragraph .taggingRArea                   anchor top + left + right         at x2                                         width 12 lines 1
    toggle .volRArea                          anchor top + right                at xmin.volBBlock         ymin
    toggle .bndRArea                          anchor top + right                at xmin.bndBBlock         ymin
    toggle .tagRArea                          anchor top + right                at xmin.tagBBlock         ymin

    paragraph .mrdGap at xmin ymax-0.7 lines 1 width 1

    -- Column Headings
    paragraph .tagVol                         anchor top + right                at xmin.volBBlock-2       y0.5                width 6
    paragraph .tagBND                         anchor top + right                at xmin.bndBBlock-1.6     ymin                width 5
    paragraph .tagTag                         anchor top + right                at xmin.tagBBlock-0.7     ymin                width 3
  exit

  -- Detail Data
  paragraph .detailTag                        anchor top + left + right         at x0.5                   ymax+0.5            text 'Detail Settings'
  line .detailLine                            anchor top + left + right         at x0.5                   ymax                horizontal width 32

  -- Standard Setting for main reference data
  option .detailOpt 'Predefined:' tagwidth 13 anchor top + left + right         at x2                     ymin+0.5            callback '!this.setupDetailData()' width 14

  -- Detail Data
  frame .detailDetail folduppanel 'Options:'  anchor top + left + right         at x0.5                   ymax+0.5            width 32

    paragraph .taggingWalls                   anchor top + left + right         at x2                     ymax+1.5            width 12 lines 1
    toggle .detWalls                          anchor top + right                at xmax+2.5               ymin
    toggle .tagWalls                          anchor top + right                at xmax+2.5               ymin

    paragraph .taggingDoors                   anchor top + left + right         at x2                     ymax                width 12 lines 1
    toggle .detDoors                          anchor top + right                at xmax+2.5               ymin
    toggle .tagDoors                          anchor top + right                at xmax+2.5               ymin

    paragraph .taggingWindows                 anchor top + left + right         at x2                     ymax                width 12 lines 1
    toggle .detWindows                        anchor top + right                at xmax+2.5               ymin
    toggle .tagWindows                        anchor top + right                at xmax+2.5               ymin

    paragraph .taggingFloors                  anchor top + left + right         at x2                                         width 12 lines 1
    toggle .detFloors                         anchor top + right                at xmax+2.5               ymin
    toggle .tagFloors                         anchor top + right                at xmax+2.5               ymin

    paragraph .taggingCLattice                anchor top + left + right         at x2                                         width 12 lines 1
    toggle .detCLattice                       anchor top + right                at xmax+2.5               ymin

    paragraph .taggingCTiles                  anchor top + left + right         at x2                                         width 12 lines 1
    toggle .detCTiles                         anchor top + right                at xmax+2.5               ymin
    toggle .tagCTiles                         anchor top + right                at xmax+2.5               ymin

    paragraph .taggingCHangers               anchor top + left + right         at x2                                         width 12 lines 1
    toggle .detCHangers                      anchor top + right                at xmax+2.5               ymin
    toggle .tagCHangers                      anchor top + right                at xmax+2.5               ymin

    paragraph .taggingCPhysical              anchor top + left + right         at x2                                         width 12 lines 1
    toggle .detCPhysical                     anchor top + right                at xmax+2.5               ymin
    toggle .tagCPhysical                     anchor top + right                at xmax+2.5               ymin

    paragraph .taggingFurniture               anchor top + left + right         at x2                                         width 12 lines 1
    toggle .detFurniture                      anchor top + right                at xmax+2.5               ymin
    toggle .tagFurniture                      anchor top + right                at xmax+2.5               ymin

    paragraph .taggingFixtures                anchor top + left + right         at x2                                         width 12 lines 1
    toggle .detFixtures                       anchor top + right                at xmax+2.5               ymin
    toggle .tagFixtures                       anchor top + right                at xmax+2.5               ymin

    paragraph .taggingFittings                anchor top + left + right         at x2                                         width 12 lines 1
    toggle .detFittings                       anchor top + right                at xmax+2.5               ymin                callback '!this.setFittingFlags()'
    toggle .tagFittings                       anchor top + right                at xmax+2.5               ymin                callback '!this.setFittingFlags()'

    paragraph .taggingEFittings               anchor top + left + right         at x4                                         width 12 lines 1
    toggle .detEFittings                      anchor top + right                at xmax+0.5               ymin                callback '!this.setFittingDetail()'
    toggle .tagEFittings                      anchor top + right                at xmax+2.5               ymin                callback '!this.setFittingTag()'

    paragraph .taggingFFittings               anchor top + left + right         at x4                                         width 12 lines 1
    toggle .detFFittings                      anchor top + right                at xmax+0.5               ymin                callback '!this.setFittingDetail()'
    toggle .tagFFittings                      anchor top + right                at xmax+2.5               ymin                callback '!this.setFittingTag()'

    paragraph .taggingHFittings               anchor top + left + right         at x4                                         width 12 lines 1
    toggle .detHFittings                      anchor top + right                at xmax+0.5               ymin                callback '!this.setFittingDetail()'
    toggle .tagHFittings                      anchor top + right                at xmax+2.5               ymin                callback '!this.setFittingTag()'

    paragraph .taggingIFittings               anchor top + left + right         at x4                                         width 12 lines 1
    toggle .detIFittings                      anchor top + right                at xmax+0.5               ymin                callback '!this.setFittingDetail()'
    toggle .tagIFittings                      anchor top + right                at xmax+2.5               ymin                callback '!this.setFittingTag()'

    paragraph .taggingStairs                  anchor top + left + right         at x2                                         width 12 lines 1
    toggle .detStairs                         anchor top + right                at xmax+2.5               ymin
    toggle .tagStairs                         anchor top + right                at xmax+2.5               ymin

    paragraph .taggingLadders                 anchor top + left + right         at x2                                         width 12 lines 1
    toggle .detLadders                        anchor top + right                at xmax+2.5               ymin
    toggle .tagLadders                        anchor top + right                at xmax+2.5               ymin

    paragraph .taggingHandrails               anchor top + left + right         at x2                                         width 12 lines 1
    toggle .detHandrails                      anchor top + right                at xmax+2.5               ymin
    toggle .tagHandrails                      anchor top + right                at xmax+2.5               ymin

    paragraph .ddGap at xmin ymax-0.7 lines 1 width 1

    -- Column Headings
    paragraph .tagDet                         anchor top + right                at xmin.detWalls-2        y0.5                width 6
    paragraph .tagTag1                        anchor top + right                at xmin.tagWalls-0.7      ymin                width 3

  exit

  -- Update options
  paragraph .updateTag                        anchor top + left + right         at x0.5                   ymax+0.5            text 'Graphic Update'
  line .updateLine                            anchor top + left + right         at x0.5                   ymax                horizontal width 32

  -- Refresh the all the graphics
  button .updateAll linklabel 'Refresh graphics'          anchor t + l + r      at x2                     ymax+0.2            callback '!this.refreshGraphics()'  width 30
  button .updateCE  linklabel 'Refresh element graphics'  anchor t + l + r      at x2                     ymax                callback '!this.refreshElement()'   width 30
  button .displayCE linklabel 'Display element'           anchor t + l + r      at x2                     ymax                callback '!this.displayElement()'   width 30
  button .addCE     linklabel 'Add to graphics'           anchor t + l + r      at x2                     ymax                callback '!this.addElement()'       width 30


  -- Form members

  -- Current BBlock
  member .bblock          is DBREF

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accViewSetup
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accViewSetup()

  -- Standard Options
  !this.refDataOpt.dtext  = !!accVisualisation.stdRefData()
  !this.detailOpt.dtext   = !!accVisualisation.stdDetail()

  -- Fold panes
  !this.mainRefData.expanded  = false
  !this.detailDetail.expanded = false

  -- Load information from Configuration
  !this.refreshConfig()

  -- Monitor changes in navigator
  !action = object BLOCK('!!' & !this.name() & '.refreshUpdate()')
  !!accControl.register(!!accNavigator, !action)

  -- Update the changes in Configuration settings
  !action = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigsettings', !action)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setupData
--
-- Description: Setup data settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupData()

  -- Standard Options
  !!accVisualisation.setupRefData(!this.refDataOpt.selection())
  !!accVisualisation.setupDetail(!this.detailOpt.selection())

  -- Setup gadgets
  !this.updateGadgets()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setupRefData
--
-- Description: Setup data settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupRefData()

  -- Standard Options
  !!accVisualisation.setupRefData(!this.refDataOpt.selection())

  -- Setup gadgets
  !this.updateGadgets('REF')

endmethod
-- End of method------------------------------------------------------------------------
--
-- Method:      setupDetailData
--
-- Description: Setup data settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupDetailData()

  -- Standard Options
  !!accVisualisation.setupDetail(!this.detailOpt.selection())

  -- Setup gadgets
  !this.updateGadgets('DET')

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Update gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  !this.updateGadgets('REF')
  !this.updateGadgets('DET')
  -- Update toggles
  --!this.updateRefDataGadgets()
  --!this.updateDetailGadgets()

  -- Setup fitting flags
  --!this.setFittingDetail()
  --!this.setFittingTag()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Update gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets(!type is STRING)

  if !type.eq('REF') then
    -- Update toggles
    !this.updateRefDataGadgets()
  elseif !type.eq('DET') then
	  -- Update toggles
    !this.updateDetailGadgets()
    -- Setup fitting flags
    !this.setFittingDetail()
    !this.setFittingTag()
	endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateRefDataGadgets
--
-- Description: Update reference data gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRefDataGadgets()

  -- BBlock Data
  !data = !!accVisualisation.getRefData('BBLOCK')
  !this.volBBlock.val     = !data[1]
  !this.bndBBlock.val     = !data[2]
  !this.tagBBlock.val     = !data[3]

  -- BLevel Data
  !data = !!accVisualisation.getRefData('BLEVEL')
  !this.volBLevel.val     = !data[1]
  !this.bndBLevel.val     = !data[2]
  !this.tagBLevel.val     = !data[3]

  -- Rooms Data
  !data = !!accVisualisation.getRefData('ROOM')
  !this.volRoom.val       = !data[1]
  !this.bndRoom.val       = !data[2]
  !this.tagRoom.val       = !data[3]

  -- Ceiling Data
  !data = !!accVisualisation.getRefData('CEILIN')
  !this.volCeiling.val    = !data[1]
  !this.bndCeiling.val    = !data[2]
  !this.tagCeiling.val    = !data[3]

  -- Ceiling Grid Data
  !data = !!accVisualisation.getRefData('CLNPNG')
  !this.bndCGrids.val     = !data[2]
  !this.tagCGrids.val     = !data[3]

  -- Stairs Data
  !data = !!accVisualisation.getRefData('STRWEL')
  !this.volStairwells.val = !data[1]
  !this.bndStairwells.val = !data[2]
  !this.tagStairwells.val = !data[3]

  -- Open Space Data
  !data = !!accVisualisation.getRefData('OPENSP')
  !this.volOpenSp.val     = !data[1]
  !this.bndOpenSp.val     = !data[2]
  !this.tagOpenSp.val     = !data[3]

  -- Restricted Area Data
  !data = !!accVisualisation.getRefData('RSTARE')
  !this.volRArea.val      = !data[1]
  !this.bndRArea.val      = !data[2]
  !this.tagRArea.val      = !data[3]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDetailGadgets
--
-- Description: Update detail gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateDetailGadgets()

  -- Wall Data
  !data   = !!accVisualisation.getDetail('CTWALL')
  !this.detWalls.val        = !data[1]
  !this.tagWalls.val        = !data[2]

  -- Door Data
  !data   = !!accVisualisation.getDetail('DOOR')
  !this.detDoors.val        = !data[1]
  !this.tagDoors.val        = !data[2]

  -- Window Data
  !data   = !!accVisualisation.getDetail('WINDOW')
  !this.detWindows.val      = !data[1]
  !this.tagWindows.val      = !data[2]

  -- Floor Covering Data
  !data   = !!accVisualisation.getDetail('FLRCOV')
  !this.detFloors.val       = !data[1]
  !this.tagFloors.val       = !data[2]

  -- Ceiling Lattice Data
  !data   = !!accVisualisation.getDetail('CLNLAT')
  !this.detCLattice.val     = !data[1]

  -- Ceiling Tile Data
  !data   = !!accVisualisation.getDetail('CLNTIL')
  !this.detCTiles.val       = !data[1]
  !this.tagCTiles.val       = !data[2]

  -- Ceiling Hanger Data
  !data   = !!accVisualisation.getDetail('HANG')
  !this.detCHangers.val       = !data[1]
  !this.tagCHangers.val       = !data[2]

  -- Ceiling Hanger Data
  !data   = !!accVisualisation.getDetail('PANE')
  !this.detCPhysical.val       = !data[1]
  !this.tagCPhysical.val       = !data[2]

  -- Furniture Data
  !data   = !!accVisualisation.getDetail('FURNIT')
  !this.detFurniture.val    = !data[1]
  !this.tagFurniture.val    = !data[2]

  -- Fixtures Data
  !data   = !!accVisualisation.getDetail('FIXTUR')
  !this.detFixtures.val     = !data[1]
  !this.tagFixtures.val     = !data[2]

  -- Electrical Fittings Data
  !data   = !!accVisualisation.getDetail('ELFITT')
  !this.detEFittings.val    = !data[1]
  !this.tagEFittings.val    = !data[2]

  -- Fire Protection Data
  !data   = !!accVisualisation.getDetail('FPFITT')
  !this.detFFittings.val    = !data[1]
  !this.tagFFittings.val    = !data[2]

  -- HVAC Data
  !data   = !!accVisualisation.getDetail('HVACFI')
  !this.detHFittings.val    = !data[1]
  !this.tagHFittings.val    = !data[2]

  -- Information Data
  !data   = !!accVisualisation.getDetail('INFITT')
  !this.detIFittings.val    = !data[1]
  !this.tagIFittings.val    = !data[2]

  -- Stair Data
  !data   = !!accVisualisation.getDetail('STRFLT')
  !this.detStairs.val       = !data[1]
  !this.tagStairs.val       = !data[2]

  -- Ladders Data
  !data   = !!accVisualisation.getDetail('LADDER')
  !this.detLadders.val      = !data[1]
  !this.tagLadders.val      = !data[2]

  -- Handrails Data
  !data   = !!accVisualisation.getDetail('HANDRA')
  !this.detHandrails.val    = !data[1]
  !this.tagHandrails.val    = !data[2]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshUpdate
--
-- Description: Refresh update buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshUpdate()

  -- Initialise Variables
  !element            = !!accNavigator.currentElement

  -- Handle unset current element
  if(!element.unset()) then
    !this.updateCE.active   = false
    !this.displayCE.active  = false
    !this.addCE.active      = false

  -- Refresh gadgets
  else
    !this.updateCE.active   = true
    !this.displayCE.active  = true
    !this.addCE.active      = true
    !this.updateCE.tag      = 'Refresh ' & !element.namn & ' in graphics'
    !this.displayCE.tag     = 'Display only ' & !element.namn
    !this.addCE.tag         = 'Add ' & !element.namn & ' to graphics'
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Refresh update buttons
  !this.refreshUpdate()

  -- Main Ref Data Headings
  !this.taggingBBlock.val         = !!accConfig.typeDescription ( 'BBLOCK' ) & 's'
  !this.taggingBLevel.val         = !!accConfig.typeDescription ( 'BLEVEL' ) & 's'
  !this.taggingRoom.val           = !!accConfig.typeDescription ( 'ROOM' ) & 's'
  !this.taggingCeiling.val        = 'Ceilings'
  !this.taggingStairwells.val     = 'Stairwells'
  !this.taggingOpenSp.val         = 'Open Spaces'
  !this.taggingRArea.val          = 'Restricted Areas'
  -- Column Headings
  !this.tagVol.val                = 'Volume'
  !this.tagBND.val                = 'Outline'
  !this.tagTag.val                = 'Tag'

  -- Details Headings
  !this.taggingWalls.val          = 'Walls'
  !this.taggingDoors.val          = 'Doors'
  !this.taggingWindows.val        = 'Windows'
  !this.taggingFloors.val         = 'Floor Coverings'
  !this.taggingCGrids.val         = 'Ceiling Grids'
  !this.taggingCLattice.val       = 'Ceiling Lattice'
  !this.taggingCTiles.val         = 'Ceiling Tiles'
  !this.taggingCHangers.val       = 'Ceiling Hangers'
  !this.taggingCPhysical.val       = 'Physical Ceiling'
  !this.taggingFurniture.val      = 'Furniture'
  !this.taggingFixtures.val       = 'Fixtures'
  !this.taggingFittings.val       = 'Fittings'
  !this.taggingEFittings.val      = 'Electrical'
  !this.taggingFFittings.val      = 'Fire Protection'
  !this.taggingHFittings.val      = 'HVAC'
  !this.taggingIFittings.val      = 'Information'
  !this.taggingStairs.val         = 'Stairs'
  !this.taggingLadders.val        = 'Ladders'
  !this.taggingHandrails.val      = 'Handrails'

  -- Column Headings
  !this.tagDet.val                = 'Detail'
  !this.tagTag1.val               = 'Tag'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshGraphics
--
-- Description: Refresh all accommodation elements in current drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshGraphics()

  -- Update Visualisation settings
  !this.updateSettings()

  -- Refresh all accommodation elements in the graphics
  !!accVisualisation.refresh()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshElement
--
-- Description: Refresh current navigator elements in current drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshElement()

  -- Update Visualisation settings
  !this.updateSettings()
  !this.refreshUpdate()

  -- Update current navigator selection in the graphics
  !!accVisualisation.refresh(!!accNavigator.currentElement)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addElement
--
-- Description: Add current navigator elements to graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addElement()

  -- Update Visualisation settings
  !this.updateSettings()
  !this.refreshUpdate()

  -- Add current navigator selection into the graphics
  !!accVisualisation.add(!!accNavigator.currentElement)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      displayElement
--
-- Description: Remove all and Add current navigator elements to graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayElement()

  -- Update Visualisation settings
  REMOVE ALL

  -- Add current navigator selection into the graphics
  !!accVisualisation.add(!!accNavigator.currentElement)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setFittingDetail
--
-- Description: Set fitting detail flag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setFittingDetail()
  !this.detFittings.val   = !this.detEFittings.val and !this.detFFittings.val and !this.detHFittings.val and !this.detIFittings.val
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setFittingTag
--
-- Description: Set fitting tag flag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setFittingTag()
  !this.tagFittings.val   = !this.tagEFittings.val and !this.tagFFittings.val and !this.tagHFittings.val and !this.tagIFittings.val
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setFittingFlags
--
-- Description: Set fitting flags
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setFittingFlags()

  !this.detEFittings.val  = !this.detFittings.val
  !this.detFFittings.val  = !this.detFittings.val
  !this.detHFittings.val  = !this.detFittings.val
  !this.detIFittings.val  = !this.detFittings.val

  !this.tagEFittings.val  = !this.tagFittings.val
  !this.tagFFittings.val  = !this.tagFittings.val
  !this.tagHFittings.val  = !this.tagFittings.val
  !this.tagIFittings.val  = !this.tagFittings.val

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateSettings
--
-- Description: Update the accVisualisation object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateSettings()
  !this.updateRefDataSettings()
  !this.updateDetailSettings()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateRefDataSettings
--
-- Description: Update the accVisualisation object with the ref data settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRefDataSettings()

  -- Set main reference data
  !!accVisualisation.setRefData('BBLOCK', !this.volBBlock.val,      !this.bndBBlock.val,      !this.tagBBlock.val)
  !!accVisualisation.setRefData('BLEVEL', !this.volBLevel.val,      !this.bndBLevel.val,      !this.tagBLevel.val)
  !!accVisualisation.setRefData('ROOM',   !this.volRoom.val,        !this.bndRoom.val,        !this.tagRoom.val)
  !!accVisualisation.setRefData('CEILIN', !this.volCeiling.val,     !this.bndCeiling.val,     !this.tagCeiling.val)
  !!accVisualisation.setRefData('CLNPNG', false,                    !this.bndCGrids.val,      !this.tagCGrids.val)
  !!accVisualisation.setRefData('STRWEL', !this.volStairwells.val,  !this.bndStairwells.val,  !this.tagStairwells.val)
  !!accVisualisation.setRefData('OPENSP', !this.volOpenSp.val,      !this.bndOpenSp.val,      !this.tagOpenSp.val)
  !!accVisualisation.setRefData('RSTARE', !this.volRArea.val,       !this.bndRArea.val,       !this.tagRArea.val)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDetailSettings
--
-- Description: Update the accVisualisation object with the detail settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateDetailSettings()

  -- Set detail data
  !!accVisualisation.setDetail('CTWALL', !this.detWalls.val,      !this.tagWalls.val)
  !!accVisualisation.setDetail('DOOR',   !this.detDoors.val,      !this.tagDoors.val)
  !!accVisualisation.setDetail('WINDOW', !this.detWindows.val,    !this.tagWindows.val)
  !!accVisualisation.setDetail('FLRCOV', !this.detFloors.val,     !this.tagFloors.val)
  !!accVisualisation.setDetail('CLNLAT', !this.detCLattice.val,   false)
  !!accVisualisation.setDetail('CLNTIL', !this.detCTiles.val,     !this.tagCTiles.val)
  !!accVisualisation.setDetail('HANG',   !this.detCHangers.val,   !this.tagCHangers.val)
  !!accVisualisation.setDetail('PANE',   !this.detCPhysical.val,   !this.tagCPhysical.val)
  !!accVisualisation.setDetail('FURNIT', !this.detFurniture.val,  !this.tagFurniture.val)
  !!accVisualisation.setDetail('FIXTUR', !this.detFixtures.val,   !this.tagFixtures.val)
  !!accVisualisation.setDetail('ELFITT', !this.detEFittings.val,  !this.tagEFittings.val)
  !!accVisualisation.setDetail('FPFITT', !this.detFFittings.val,  !this.tagFFittings.val)
  !!accVisualisation.setDetail('HVACFI', !this.detHFittings.val,  !this.tagHFittings.val)
  !!accVisualisation.setDetail('INFITT', !this.detIFittings.val,  !this.tagIFittings.val)
  !!accVisualisation.setDetail('STRFLT', !this.detStairs.val,     !this.tagStairs.val)
  !!accVisualisation.setDetail('LADDER', !this.detLadders.val,    !this.tagLadders.val)
  !!accVisualisation.setDetail('HANDRA', !this.detHandrails.val,  !this.tagHandrails.val)

endmethod
-- End of method
