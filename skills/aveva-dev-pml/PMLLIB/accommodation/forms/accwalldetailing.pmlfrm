--
--  File:            accwalldetailing.pmlfrm
--    Type:          Form Definition
--    Group:         Room Design
--      Keyword:     Wall Detailing
--    Module:        Design
--  Created:         Fri Mar 14 11:42:54 2008
--
--  Description:     Wall Detail definition form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accWallDetailing()               -                   Constructor
--  backToMainRoomDesignTasks()      -                   Switching to Main Room Design Tasks
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  createJoiner()                   -                   Create a single joiner with the specified SPREF
--  createJoiners(DBREF)             -                   Create a line of joiners along a wall
--  createJoinersBetweenFeatures()   -                   Creates new joiners, between panels
--  createPanel()                    -                   Create a single panel in a Wall
--  createProfile()                  -                   Create a single profile in a Wall
--  deleteDetail()                   -                   Delete the current detail
--  deleteJoiners()                  -                   Delete all the joiners on the current wall
--  deletePanels()                   -                   Delete all the panels on the current wall
--  deleteProfiles()                 -                   Delete all the profiles on the current wall
--  detailTasks(BOOLEAN)             -                   Set main tasks
--  drawJoiners()                    -                   Draws aid graphics for each of the joiners to be created
--  drawModifiedJoiner()             -
--  drawProfile()                    -                   Draws an aid line graphic representing a Wall Profile
--  drawProfile(LINE,REAL)           -                   Draws an aid line graphic representing a Wall Profile
--  drawRPoint(STRING)               -                   Draws an aid box at the position of an rPath Point
--  drawSingleJoiner()               -                   Draws an aid line representing a single Wall Joiner
--  dummy()                          -                   Dummy method for unset
--  getDetails()                     -                   Retrieves a list of all the current profiles, panels
--  getDoorBox(DBREF,LINE)           ARRAY               Retrieve the extremities of a given door
--  getFeatures()                    -                   Retrieves a list of all the wall openings, doors, windows
--  getOpeningLines(ARRAY,LINE)      ARRAY               Returns an array of line representing the passed array
--  getRPath(DBREF)                  BOOLEAN             Retrieves the points of the selected wall's RPATH
--  getSectionDetails(DBREF)         ARRAY               Retrieves a list of all the wall panels, doors & windows
--  initialise()                     -                   Initialise form.
--  joinerHeight(GADGET,STRING)      -                   Updates and displays the height of joiners
--  joinerSpacing()                  -                   Updates and displays the spacings between a set of joiners
--  joinerTasks(BOOLEAN)             -                   Set Joiner Tasks pane
--  listSelection(GADGET,STRING)     -                   Updates the current wall feature
--  modJoiners(BOOLEAN)              -
--  modPanel(BOOLEAN)                -                   Set modify panel pane
--  modProfile(BOOLEAN)              -                   Set modify profile pane
--  modify(DBREF)                    BOOLEAN             Load for with passed ceiling grid element
--  modifyDetail(GADGET,STRING)      -                   Updates the current details attributes to DB
--  modifyJoinerHeight(GADGET,STRING) -                   Updates and displays the height of joiners
--  panelAid()                       -                   Draws an aid text box at the position of the new panel
--  panelArcWallSegment(REAL,DBREF,DBREF,STRING,REAL) -                   Create panel detail for a curved wall segment
--  panelAround()                    -                   Panels from either side of a wall opening
--  panelDirection(GADGET,STRING)    -
--  panelSearch()                    -                   Launches the selection form for wall panels
--  panelStraightWallSegment(REAL,DBREF,LINE,STRING,STRING,REAL) -                   Create panel detail for a straight wall segment
--  panelTasks(BOOLEAN)              -                   Set panel tasks pane
--  profileHeight()                  -                   Updates and displays the line representing a wall profile
--  profilePoints()                  -                   Updates and displays the line representing a wall profile
--  profileSearch(GADGET,STRING)     -
--  profileTasks(BOOLEAN)            -                   Set profile tasks pane
--  refresh()                        -                   Refresh form from navigator.
--  refreshConfig()                  -                   Refresh all setting that use the configuration data.
--  selectWall(ARRAY)                -                   Select Wall from grid
--  setDetail(GADGET,STRING)         -                   Update current detail DBREF
--  setJoinerDist()                  -                   set the joiner dist to 0 on change of POINTR
--  setSpreField(STRING,ANY)         -                   Sets the value of correct text box to the passed SPREF
--  splitWholeWall(REAL)             -                   Creates a set of panels along the RPATH of a wall
--  switchJoinCall()                 -                   Changes the create joiner callback
--  tidy()                           -                   Tidy graphics
--  tidyWalls()                      -                   Tidy walls
--  updateGadgets(STRING)            -                   Update relevant gadgets with detail information
--  updateWallList()                 -                   Get walls from graphic selection
--  useActiveWalls()                 -                   Get walls from graphic selection
--  useSelectedWalls()               -                   Get walls from graphic selection
--  validate(GADGET,STRING)          -                   validate the value entered in the text gadgets
--  validateJoinerDist(GADGET,STRING) -                   validate the joiner distance from wall point
--  validatePanelValues(GADGET,STRING) -
--  validateProfileGadgets(GADGET,STRING) -                   validate Profile Gadgets
--  wallPanelOption()                -
--

import 'GridControl'
handle any
endhandle

setup form !!accWallDetailing dialog docking right

  !this.formTitle    = 'Wall Detail'
  !this.iconTitle    = 'Wall Detail'
  !this.callback     = '!this.initialise()'
  !this.quitCall     = '!this.tidy()'
  !this.formRevision = ' $Revision$ '


  -- Current Hierarchy
  paragraph .currentOwner                                     anchor top + left + right     at x0.5             ymax                width 30 lines 1

  -- Main Detail Task Panel
  frame     .detailTaskPane panel                             anchor top + left + right     at x0               ymax.currentOwner

    paragraph .selectWallText                                                               at x1               ymax                text 'Select Wall..'
    container .walls        PMLNETCONTROL 'NET'               anchor top + left + right     at xmin             ymax+0.1            width 30 height 6

    -- Graphical Selection
    button    .gphWallSelect linklabel  'Use selected wall'   anchor top + left             at xmin             ymax+0.2            callback '!this.useSelectedWalls()' width 20
    button    .accElementSel linklabel  'Use active element walls'    anchor top + left     at xmin             ymax+0.1            callback '!this.useActiveWalls()' width 20

    -- Create Options
    paragraph .createPanelTasks                                                             at x0.5             ymax+0.5            text 'Create...'
    line      .detailTasksL1                                  anchor top + left + right     at xmin             ymax                horizontal width 32

    button    .dtCrtPanel   linkLabel   'Panel Definition'    anchor top + left + right     at x2               ymax                callback '!this.panelTasks(TRUE)'
    button    .dtCrtProfile linkLabel   'Profile Definition'  anchor top + left + right     at xmin             ymax                callback '!this.profileTasks(TRUE)'
    button    .dtCrtJoiner  linkLabel   'Joiner Definition'   anchor top + left + right     at xmin             ymax                callback '!this.joinerTasks(TRUE)'

    -- Modify Options
    paragraph .modifyPanelTasks                                                             at x0.5             ymax+0.5            text 'Modify...'
    line      .detailTasksL2                                  anchor top + left + right     at xmin             ymax                horizontal width 32


    button    .dtModPanel   linkLabel   'Panels'              anchor top + left at xmin             ymax+0.2            callback '!this.modPanel(TRUE)'
    button    .dtModProfile linkLabel   'Profiles'            anchor top + left at xmin             ymax                callback '!this.modProfile(TRUE)'
    button    .dtModJoiner  linkLabel   'Joiners'             anchor top + left at xmin             ymax                callback '!this.modJoiners(TRUE)'

    list      .pickDetail 'Choose Detail:'                    anchor top  + left + right     at xmax.dtModPanel+2              ymin.dtModPanel          callback '!this.setDetail(' multi width 18 length 8

    -- Delete Options
    paragraph .deteleDetailTasks                                                            at x0.5             ymax+0.2            text 'Delete...'
    line      .detailTasksL3                                  anchor top + left + right     at x0               ymax                horizontal width 32

    button    .deleteDet    linkLabel   'Delete Detail'       anchor top + left + right     at x2               ymax+0.2            callback '!this.deleteDetail()'
    button    .deletePan    linkLabel   'All Panels'          anchor top + left + right     at xmin             ymax+0.2            callback '!this.deletePanels()'
    button    .deletePro    linkLabel   'All Profiles'        anchor top + left + right     at xmin             ymax+0.1            callback '!this.deleteProfiles()'
    button    .deleteJoi    linkLabel   'All Joiners'         anchor top + left + right     at xmin             ymax+0.1            callback '!this.deleteJoiners()'

    paragraph .blTskBackMainIcon1            anchor top + left                 at x0                     ymax+0.5                pixmap width 15 height 15
    button .blTskMain1     linkLabel 'Return to main tasks'                    at xmax+1                 ymin                callback '!this.backToMainRoomDesignTasks()' width 20

  exit
  -- End of Main Detail Task Panel

  -- Panel Create Task Panel
  frame       .panelTaskPane panel                            anchor top + left + right     at x0               ymax.currentOwner

    -- Owning wall
    paragraph .panCurrWall                                    anchor top + left + right     at x0               ymax                text 'Current Wall:' width 25

    -- Basic attributes
    paragraph .panAtts                                                                      at x0.5             ymax+0.5            text 'Panel Attributes'
    line      .panelTasksL1                                   anchor top + left + right     at xmin             ymax                horizontal width 32

    -- Find Profile
    paragraph .findPanIcon                                      anchor top + left     at x0.5           ymax+0.2            pixmap width 16 height 15
    button    .findPane  'Select Panel Specification...'      linkLabel           anchor top + left     at xmax+0.5       ymin                callback '!this.panelSearch()'

    text      .panSPREF  'Specification:'           tagwidth 10         anchor top + left + right     at x1             ymax+0.2            width 15  is STRING

    text      .panWidth  'Width:'           tagwidth 10         anchor top + left + right     at x1             ymax+0.2            callback '!this.validate('width 10  is REAL format !!distanceFmt
    text      .panThick  'Thickness:'       tagwidth 10         anchor top + left + right     at x1             ymax+0.2            callback '!this.validate('width 10  is REAL format !!distanceFmt

    text      .panHeight 'Vertical Offset:' tagwidth 10         anchor top + left + right     at x1             ymax+0.2            callback '!this.validate('width 10  is REAL format !!distanceFmt

    combo     .wallJust  'Justify:'         tagwidth 10         anchor top + left + right     at x1             ymax+0.5            width 10

    frame     .layoutRGroup 'Wall Connection Options'           anchor top + left + right     at x1             ymax+0.5

      paragraph .layoutIcon1                                                                                                          pixmap width 12 height 10
      path right
      rToggle   .rad1   'Layout 1'                                                            at xmax+3
      paragraph .layoutIcon2                                                                  at xmin.layoutIcon1 ymax.layoutIcon1+0.7   pixmap width 12 height 10
      rToggle   .rad2   'Layout 2'                                                            at xmax+3
      paragraph .layoutIcon3                                                                  at xmin.layoutIcon2 ymax.layoutIcon2+0.7   pixmap width 12 height 10
      rToggle   .rad3   'Layout 3'                                                            at xmax+3

    --paragraph .selectedLayout                                 anchor top + left + right     at x0.5             ymax                text ''

    exit

    frame .panelOption  'Wall Panelling Option' anchor top + left + right     at xmin             ymax+0.5  width 30
      rToggle   .panelWholeWall      'Panel Whole Wall'                      at xmin+1  ymax       callback '!this.wallPanelOption()'
      rToggle   .panelWallSection    'Panel Wall Section'                    at xmin    ymax       callback '!this.wallPanelOption()'
    exit

    frame     .frPanelWholeWall panel                         anchor top + left + right     at xmin             ymax.panelOption+0.5 width 35
      combo     .panelDir1 'Panel Direction:'  tagwidth 8       anchor top + left             at xmin               ymax+0.5            callback '!this.panelDirection(' width 18
    -- Split Entire Wall
      button    .dtSplitWall   linkLabel    'Create Panels for the whole wall'     anchor top + left + right     at x0.5           ymax+0.5                callback '!this.splitWholeWall(!this.panWidth.val)'

    -- Return to main pane
    paragraph .panDefBackIcon                                 anchor top + left             at x0               ymax+0.5            pixmap width 15 height 15
    button    .panDefBack    linkLabel 'Back to detail tasks' anchor t + l + r              at xmax+1           ymin                callback '!this.detailTasks(true)' width 20

  exit
  -- End of Panel Create Task Panel

    frame     .frPanelWallSection panel                         anchor top + left + right     at xmin             ymax.panelOption+0.3

      paragraph .sectionOptions                                 anchor top + left + right     at x0               ymax+0.5                                                text 'Wall Section and Door Options'
      line      .panelTasksL2                                   anchor top + left + right     at xmin             ymax-0.1            horizontal width 32

      combo     .wallPoint 'Wall Point:'      tagwidth 8       anchor top + left             at x1               ymax+0.2            callback '!this.getFeatures()' width 18

      list      .features  'Wall Features'                   anchor top + left + right      at x1               ymax+0.5            callback '!this.listSelection(' SINGLE width 30 length 8

      combo     .panelDir 'Panel Direction:'  tagwidth 8       anchor top + left             at x1               ymax+0.5            callback '!this.panelDirection(' width 18


      paragraph .createOptions                                  anchor top + left + right     at x1               ymax+1            text 'Panel Create Options'
      line      .panelTasksL3                                   anchor top + left + right     at xmin             ymax-0.1            horizontal width 32

      button    .dtCrtPane     linkLabel   'Panel Wall Section' anchor top + left             at x1               ymax+0.2            callback '!this.panelAround()' width 32
       -- Return to main pane
      paragraph .panDefBackIcon1                                 anchor top + left             at x0               ymax+0.5            pixmap width 15 height 15
      button    .panDefBack1    linkLabel 'Back to detail tasks' anchor t + l + r              at xmax+1           ymin                callback '!this.detailTasks(true)' width 20

    exit

  exit
  -- end of Panel Creation Pane

  -- Panel Modify Task Panel
  frame       .panelModPane    panel                          anchor top + left + right     at x0               ymax.currentOwner

      -- Owning wall
    paragraph .panCurDet                                      anchor top + left + right     at x0               ymax                text 'Current Panel:' width 25

    -- Basic attributes
    paragraph .panModAtts                                                                   at x0.5             ymax                text 'Basic Attributes'
    line      .panelModTasksL1                                anchor top + left + right     at xmin             ymax                horizontal width 32

    -- Basic Attributes

    -- Find Panel
    paragraph .modFindPanIcon                                   anchor top + left      at x0.5           ymax+0.2            pixmap width 16 height 15
    button    .findModPane  'Select Panel Specification...'   linkLabel           anchor top + left      at xmax+0.5       ymin                callback '!this.panelSearch()'

    text      .panModSPREF  'Specification:'        tagwidth 16         anchor top + left + right     at x1             ymax+0.2            width 15  is STRING

    text      .panModDesc 'Description:'           tagwidth 16 anchor top + left + right     at x1             ymax+0.5            width 15  is STRING

    text      .panModStart 'Pos Ref:'              tagwidth 16 anchor top + left + right     at xmin           ymax+0.5            width 15  is STRING

    text      .panModDist   'Distance from Wall Point:' tagwidth 16 anchor top + left + right     at xmin      ymax+0.5            callback '!this.validatePanelValues(' width 15  is REAL format !!distanceFmt
    text      .panModHeight 'Vertical Distance:'   tagwidth 16 anchor top + left + right     at xmin           ymax+0.5            callback '!this.validatePanelValues(' width 15  is REAL format !!distanceFmt

    -- Trim Panel
    paragraph .panModTrim                                                                    at x0.5           ymax+1              text 'Panel Trimming'
    line      .panelModTasksL2                                 anchor top + left + right     at xmin           ymax                horizontal width 32

    text      .panTopCut   'Panel Height Trim'    tagwidth 16  anchor top + left + right     at x1             ymax+0.5            callback '!this.validatePanelValues(' width 15   is REAL format !!distanceFmt
    text      .panLeadCut  'Leading Trim'         tagwidth 16  anchor top + left + right     at xmin           ymax+0.5            callback '!this.validatePanelValues(' width 15   is REAL format !!distanceFmt
    text      .panRearCut  'Trailing Trim'        tagwidth 16  anchor top + left + right     at xmin           ymax+0.5            callback '!this.validatePanelValues(' width 15   is REAL format !!distanceFmt

    -- Panel Trimming
    --button    .trimPanel  linkLabel 'Trim Panel'              anchor top + left + right     at xmin             ymax+0.2            callback '!this.dummy()' width 15

    -- Accept Changes
    paragraph .panAcceptIcon                                  anchor top + left             at x0               ymax+1            pixmap width 15 height 15
    button    .panAccept  linkLabel 'Accept Changes'          anchor top + left             at xmax+0.5         ymin                callback '!this.modifyDetail(' width 10

    -- Discard Changes
    paragraph .panDiscardIcon                                 anchor top + right            at xmax+4           ymin                pixmap width 15 height 15
    button    .panDiscard linkLabel 'Discard Changes'         anchor top + right            at xmax+0.5         ymin                callback '!this.detailTasks(true)' width 10

    paragraph .panBackIcon                                    anchor top + left             at x0               ymax+0.5            pixmap width 15 height 15
    button    .panMain   linkLabel   'Back to detail tasks'                                 at xmax+1           ymin                callback '!this.detailTasks(true)'

  exit
  -- End of Panel Modify Task Panel

  -- Profile Create Task Panel
  frame       .profileTaskPane panel                          anchor top + left + right     at x0               ymax.currentOwner

    -- Owning wall
    paragraph .profCurrWall                                   anchor top + left + right     at x0               ymax                text 'Current Wall:' width 25

    -- Basic attributes
    paragraph .profAtts                                                                     at x0.5             ymax                text 'Basic Attributes'
    line      .profTasksL1                                    anchor top + left + right     at xmin             ymax                horizontal width 32

    --text      .proName   'Name:'        tagwidth 8            anchor top + left + right     at x2               ymax+0.5            callback '!this.checkName(' width 15  is STRING
    --text      .proDesc   'Description:' tagwidth 8            anchor top + left + right     at xmin             ymax+0.2            width 15  is STRING

    -- Find Profile
    paragraph .findProIcon                                    anchor top + left       at x0.5             ymax+0.2            pixmap width 16 height 15
    button    .findProf       linkLabel 'Select Profile Specification...'       anchor top + left       at xmax+0.5         ymin                callback '!this.profileSearch('

    text      .proSPREF         'Specification:'    tagwidth 14       anchor top + left + right      at x1               ymax+0.3            width 15  is STRING
    paragraph .paProfileJustLine                              anchor top + left              at xmin             ymax+0.3            text 'P-Line Justification:'  width 13
    paragraph .profileJustLine                                anchor top + left + right      at xmax+1         ymin                text 'unset'  width 6

    text      .profileLength    'Length:'   tagwidth 14       anchor top + left + right     at xmin.paProfileJustLine     ymax+0.3            callback '!this.validate(' width 10  is REAL format !!distanceFmt

    -- Position attributes
    paragraph .profPosition                                                                  at x0.5             ymax+1              text 'Profile Position'
    line      .profTasksL2                                     anchor top + left + right     at xmin             ymax                horizontal width 32

    combo     .startPick 'Start:'  tagwidth 14                 anchor top + left + right     at x1               ymax+0.3            callback '!this.profilePoints()' width 10
    combo     .stopPick  'End:  '  tagwidth 14                 anchor top + left + right     at xmin             ymax+0.3            callback '!this.profilePoints()' width 10

    text      .profileElev    'Height:' tagwidth 14                 anchor top + left + right     at xmin             ymax+0.3            callback '!this.profileHeight()' width 10 is REAL format !!distanceFmt

    combo     .profileWallJustLine   'Wall Justification:' tagwidth 14    anchor top + left + right     at xmin             ymax+0.3            width 10

    -- Create Profile

    paragraph .proCrtIcon                                     anchor top + left             at x0.5             ymax+1.5            pixmap width 15 height 15
    button    .proCrt       linklabel 'Create Profile'        anchor top + left             at xmax+1           ymin                callback '!this.createProfile()' width 20

    -- Return to main pane
    paragraph .proDefBackIcon                                 anchor top + left             at x0               ymax+0.5            pixmap width 15 height 15
    button    .proDefBack   linkLabel 'Back to detail tasks'  anchor t + l + r              at xmax+1           ymin                callback '!this.detailTasks(true)' width 20

  exit
  -- End of Profile Create Task Panel

  -- Profile Modify Task Panel
  frame       .profileModPane  panel                          anchor top + left + right     at x0               ymax.currentOwner

    -- Current Detail
    paragraph .proCurDet                                      anchor top + left + right     at x0               ymax                text 'Current Profile:' width 25
    line      .profModL1                                      anchor top + left + right     at xmin             ymax                horizontal width 32

    --text      .proModName  'Name:'        tagwidth 8          anchor top + left + right     at x2               ymax+0.5            callback '!this.checkName(' width 15  is STRING
    --text      .proModDesc  'Description:' tagwidth 8          anchor top + left + right     at xmin             ymax+0.2            width 15  is STRING

    -- Profile Start and End Points
    text      .modProfileStart 'Start Ref:'  tagwidth 14           anchor top + left + right     at x1             ymax+0.5            width 15  is STRING
    text      .modProfileEnd   'End Ref:'    tagwidth 14           anchor top + left + right     at xmin             ymax+0.2            width 15  is STRING

    paragraph .modFindProfIcon                                    anchor top + left      at xmin             ymax+0.2            pixmap width 16 height 15
    button    .modFindProfile       linkLabel 'Select Profile Specification...'     anchor top + left      at xmax+0.5         ymin                callback '!this.profileSearch('

    -- Profile Spec and P-Line Justification
    text      .modProfileSpec         'Specification:'    tagwidth 14       anchor top + left + right      at x1          ymax+0.3            width 15  is STRING
    paragraph .paModProfileJustLine                              anchor top + left              at xmin             ymax+0.3            text 'P-Line Justification:'  width 13
    paragraph .modProfileJustLine                                anchor top + left + right      at xmax+1         ymin                text 'unset'  width 6

    -- Profile start and end distance
    text      .modProfileStartDist 'Start Distance:'  tagwidth 14           anchor top + left + right     at x1             ymax+0.2            callback '!this.validateProfileGadgets(' width 10 is REAL format !!distanceFmt
    text      .modProfileEndDist   'End Distance:'    tagwidth 14           anchor top + left + right     at x1             ymax+0.2            callback '!this.validateProfileGadgets(' width 10 is REAL format !!distanceFmt

    -- Profile Height
    text      .modProfileHeight 'Height:'    tagwidth 14           anchor top + left + right     at x1             ymax+0.2            callback '!this.validateProfileGadgets(' width 10 is REAL format !!distanceFmt

    --combo     .modProfileJustLine      'P-Line Justification:' tagwidth 12                 anchor top + left + right     at xmin             ymax+0.5            width 10
    combo     .modProfileWallJustLine   'Wall Justification:' tagwidth 14                 anchor top + left + right     at xmin             ymax+0.5            width 10


    -- Accept Changes
    paragraph .proAcceptIcon                                  anchor top + left             at x0               ymax+1            pixmap width 15 height 15
    button    .proAccept  linkLabel 'Accept Changes'          anchor top + left             at xmax+0.5         ymin                callback '!this.modifyDetail(' width 10

    -- Discard Changes
    paragraph .proDiscardIcon                                 anchor top + right            at xmax+4           ymin                pixmap width 15 height 15
    button    .proDiscard linkLabel 'Discard Changes'         anchor top + right            at xmax+0.5         ymin                callback '!this.modProfile(true)' width 10

    paragraph .proBackIcon                                    anchor top + left             at x0               ymax+0.5            pixmap width 15 height 15
    button    .proMain   linkLabel   'Back to detail tasks'                                 at xmax+1           ymin                callback '!this.detailTasks(true)'

  exit
  -- End of Profile Modify Task Panel

  -- Create Joiner Task Panel
  frame       .joinerTaskPane panel                           anchor top + left + right     at x0               ymax.currentOwner

    -- Owning wall
    paragraph .joinCurrWall                                   anchor top + left + right     at xmin.currentOwner             ymax                text 'Current Wall:' width 25

    -- Basic attributes
    paragraph .joinAtts                                                                     at x0.5             ymax                text 'Basic Attributes'
    line      .joinTasksL1                                    anchor top + left + right     at xmin             ymax                horizontal width 32

    -- Find Joiners
    paragraph .findJoinerIcon                                    anchor top + left      at x0.5             ymax+0.5            pixmap width 16 height 15
    button    .findJoin       linkLabel 'Select Joiner Specification...'        anchor top + left      at xmax+0.5         ymin                callback '!this.profileSearch('

    text      .joinSPREF      'Specification:'        tagwidth 18     anchor top + left + right     at x1               ymax+0.2            width 13 is STRING

    paragraph .paJoinerJustLine                               anchor top + left     at xmin             ymax+0.2            text 'P-Line Justification:'  width 13
    paragraph .joinerJustLine                                 anchor top + left + right     at xmax+5         ymin                text 'unset'  width 6

    toggle    .singleJoin    'Create Single Joiner'           anchor top + left + right     at xmin.paJoinerJustLine             ymax+0.5            callback '!this.switchJoinCall()'

    text      .jSpacing      'Spacing:'       tagwidth 18     anchor top + left + right     at xmin             ymax+0.5            callback '!this.joinerSpacing()' width 13 is REAL format !!distanceFmt

    combo     .joinPoint     'Wall Point:'    tagwidth 18     anchor top + left + right     at xmin.jSpacing      ymin.jSpacing       callback '!this.setJoinerDist()'  width 11

    text      .jStartHeight  'Start Height:'  tagwidth 18     anchor top + left + right     at xmin             ymax+0.5            callback '!this.joinerHeight('  width 13 is REAL format !!distanceFmt
    text      .jEndHeight    'End Height:'    tagwidth 18     anchor top + left + right     at xmin             ymax+0.5            callback '!this.joinerHeight('  width 13 is REAL format !!distanceFmt

    combo     .joinerWallJustLine  'Wall Justification:'      tagwidth 18      anchor top + left + right     at xmin        ymax+0.5            width 11

    text      .joinerDist    'Distance from Wall Point:'      tagwidth 18      anchor top + left + right     at xmin        ymax+0.5           callback '!this.validateJoinerDist(' width 13  is REAL format !!distanceFmt

    -- Create Joiners
    paragraph .joinCrtIcon                                    anchor top + left             at x0.5             ymax+1.5            pixmap width 15 height 15
    button    .joinCrt      linklabel 'Create Joiners'        anchor top + left             at xmax + 1         ymin                callback '!this.createJoiners(!this.currentWall)' width 20

    -- Return to main pane
    paragraph .joinDefBackIcon                                anchor top + left             at x0               ymax+0.5            pixmap width 15 height 15
    button    .joinDefBack  linklabel 'Back to detail tasks'  anchor top + left + right     at xmax+1           ymin                callback '!this.detailTasks(TRUE)' width 20

  exit
  -- End of Create Joiner Task Panel

  -- Modify Joiner Task Panel
  frame     .joinerModPane  panel                           anchor top + left + right     at x0               ymax.currentOwner

    -- Current Detail
    paragraph .joinCurDet                                     anchor top + left + right     at x0               ymax                text 'Current Joiner:' width 25

    text      .joinModStart   'Pos Ref:'      tagwidth 14      anchor top + left + right     at x2               ymax+0.2            width 10  is STRING

    --combo     .joinModJustify 'Justify:'      tagwidth 9      anchor top + left + right     at xmin             ymax+0.2            width 10

    paragraph .modFindJoinerIcon                                anchor top + left     at x2             ymax+0.2            pixmap width 16 height 15
    button    .modFindJoin       linkLabel 'Select Joiner Specification...'        anchor top + left      at xmax+0.5         ymin                callback '!this.profileSearch('

    text      .modJoinerSpec      'Specification:'        tagwidth 14     anchor top + left + right     at x2               ymax+0.2            width 15 is STRING

    paragraph .paModJoinerJustLine                               anchor top + left     at xmin             ymax+0.2            text 'P-Line Justification:'  width 13
    paragraph .modJoinerJustLine                                 anchor top + left + right     at xmax+1         ymin                text 'unset'  width 6

    text      .modJStartHeight 'Start Height:' tagwidth 14      anchor top + left + right     at x2             ymax+0.2            callback '!this.modifyJoinerHeight(' width 10 is REAL format !!distanceFmt
    text      .modJEndHeight   'End Height:'   tagwidth 14      anchor top + left + right     at xmin             ymax+0.2            callback '!this.modifyJoinerHeight(' width 10 is REAL format !!distanceFmt

    text      .modJoinerDist   'Z Dist:'       tagwidth 14      anchor top + left + right     at xmin             ymax+0.2            callback '!this.validateJoinerDist(' width 10  is REAL format !!distanceFmt

    combo     .modJoinerWallJustLine  'Wall Justification:'           tagwidth 14                 anchor top + left + right     at xmin             ymax+0.2            width 10

    -- Accept Changes
    paragraph .joiAcceptIcon                                  anchor top + left             at x0               ymax+1            pixmap width 15 height 15
    button    .joiAccept  linkLabel 'Accept Changes'          anchor top + left             at xmax+0.5         ymin                callback '!this.modifyDetail(' width 10

    -- Discard Changes
    paragraph .joiDiscardIcon                                 anchor top + right            at xmax+4           ymin                pixmap width 15 height 15
    button    .joiDiscard linkLabel 'Discard Changes'         anchor top + right            at xmax+0.5         ymin                callback '!this.modJoiners(true)' width 10

    paragraph .joiBackIcon                                    anchor top + left             at x0               ymax+0.5            pixmap width 15 height 15
    button    .joiMain   linkLabel   'Back to detail tasks'                                 at xmax+1           ymin                callback '!this.detailTasks(true)'

  exit
  -- End of Modify Joiner Task Panel

  -- Form Members

  -- Current active element
  member .owner         is DBREF

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK
  member .refreshTask     is BLOCK

  -- Wall information
  member .currentWall     is DBREF

  -- Wall features start and end points reference
  member  .wallSectionStart is DBREF
  member  .wallSectionEnd   is DBREF

  -- Wall panelling start and end element
  member  .panelStartElement is DBREF
  member  .panelEndElement   is DBREF

  -- Walls for modification
  member .wallList        is ARRAY
  member .wallNames       is ARRAY

  -- Detail for Modify
  member .currentDetail   is DBREF
  member .selectionArray  is ARRAY
  member .currentFeature  is DBREF

  -- rPath data
  member .pointNames      is ARRAY
  member .pointDBREF      is ARRAY
  member .pointGaps       is ARRAY
  member .pointDbs        is ARRAY
  member .currRPath       is ARRAY

  -- Closed Path
  member .closedPath      is BOOLEAN

  -- Undo for form
  member .undo            is UNDOABLE

  -- EDG Description
  member .edgDescription  is STRING

  -- Aid Numbers
  member .aidNumber       is REAL
  member .aidPointsNo      is REAL

  -- Wall Grid
  using namespace 'Aveva.Pdms.Presentation'
  member .wallGrid        is NETGRIDCONTROL

  -- profile catalogue data
  member .catalogueProfile  is PROFILECATALOGUEDATA

  -- Joiner Distance
  member .joinerDistance is REAL

exit

-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accWallDetailing
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accWallDetailing()

  -- Set form to auto scroll
  !this.autoScroll          = TRUE

  -- Setup dummy default task
  !this.currentTask         = object BLOCK('!this.dummy()')

  -- Closed path default
  !this.closedPath          = FALSE

  -- Add .Net control to PML container for Walls
  using namespace 'Aveva.Pdms.Presentation'
  !this.wallGrid            = object NETGRIDCONTROL()
  !this.walls.control       = !this.wallGrid.handle()
  !this.wallGrid.addEventHandler('afterSelectChange', !this, 'selectWall')

  -- Load information from Configuration
  !this.refreshConfig()

  -- Set "Back" icon
  !backIcon                     = !!pml.getpathname('back.png')
  !this.panDefBackIcon.addPixmap(!backIcon)
  !this.panDefBackIcon1.addPixmap(!backIcon)
  !this.proDefBackIcon.addPixmap(!backIcon)
  !this.joinDefBackIcon.addPixmap(!backIcon)
  !this.blTskBackMainIcon1.addPixmap(!backIcon)

  -- Set "Create" icon
  !createIcon                   = !!pml.getpathname('create.png')
  --!this.panCrtIcon.addPixmap(!createIcon)
  !this.proCrtIcon.addPixmap(!createIcon)
  !this.joinCrtIcon.addPixmap(!createIcon)

  -- Set "Search" icon
  !searchIcon                   = !!pml.getpathname('ng_zoomtodrawlist.png')
  !this.findProIcon.addPixmap(!searchIcon)
  !this.modFindProfIcon.addPixmap(!searchIcon)
  !this.findJoinerIcon.addPixmap(!searchIcon)
  !this.modFindJoinerIcon.addPixmap(!searchIcon)
  !this.modFindPanIcon.addPixmap(!searchIcon)
  !this.findPanIcon.addPixmap(!searchIcon)

  -- Set "Back" icon
  !backIcon                     = !!pml.getpathname('back.png')
  !this.proBackIcon.addPixmap(!backIcon)
  !this.panBackIcon.addPixmap(!backIcon)
  !this.joiBackIcon.addPixmap(!backIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getpathname('accept.png')
  !this.joiAcceptIcon.addPixmap(!acceptIcon)
  !this.panAcceptIcon.addPixmap(!acceptIcon)
  !this.proAcceptIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getpathname('discard.png')
  !this.joiDiscardIcon.addPixmap(!discardIcon)
  !this.panDiscardIcon.addPixmap(!discardIcon)
  !this.proDiscardIcon.addPixmap(!discardIcon)

  -- Set "Wall Layout" icons
  !lay1Icon                     = !!pml.getpathname('wallpanelsetup1.png')
  !this.layoutIcon1.addPixmap(!lay1Icon)
  !lay2Icon                     = !!pml.getpathname('wallpanelsetup2.png')
  !this.layoutIcon2.addPixmap(!lay2Icon)
  !lay3Icon                     = !!pml.getpathname('wallpanelsetup3.png')
  !this.layoutIcon3.addPixmap(!lay3Icon)

  -- Initialise task panes
  !this.detailTasks(TRUE)
  !this.panelTasks(FALSE)
  !this.profileTasks(FALSE)
  !this.joinerTasks(FALSE)
  !this.modPanel(FALSE)
  !this.modProfile(FALSE)
  !this.modJoiners(FALSE)

  -- Disable Create and Modify Links
  !this.dtCrtProfile.active = FALSE
  !this.dtCrtJoiner.active  = FALSE
  !this.dtCrtPanel.active   = FALSE
  !this.dtModPanel.active   = FALSE
  !this.dtModProfile.active = FALSE
  !this.dtModJoiner.active  = FALSE
  !this.deleteDet.active    = FALSE
  !this.deleteJoi.active    = FALSE
  !this.deletePan.active    = FALSE
  !this.deletePro.active    = FALSE

  -- set joiner dist value
  !this.joinerDistance = 0
  !this.joinerDist.val = 0

  -- EDG Description
  !this.edgDescription      = 'Accommodation Wall Detailing'

  -- Assign aid numbers for form
  !this.aidNumber           = !!aidNumbers.add('Wall Detailing')
  !this.aidPointsNo         = !!aidNumbers.add('Wall Points')

  -- Register refresh with navigator form
  !action                   = object BLOCK('!!' & !this.name() & '.refresh()')
  !!accControl.register('accNavigator', !action)

  -- Register refresh with config settings form
  !action                   = object BLOCK('!!' & !this.name() & '.refreshConfig()')
  !!accControl.register('accConfigSettings', !action)

  -- set wall justification values for Panel, Profile, Joiner
  !justificationDtext    = ARRAY()
  !justificationDtext[1] = 'Left'
  !justificationDtext[2] = 'Right'
  !justificationDtext[3] = 'Centre'

  !justificationRtext    = ARRAY()
  !justificationRtext[1] = 'LEFT'
  !justificationRtext[2] = 'RIGH'
  !justificationRtext[3] = 'CENT'

  !this.wallJust.dtext                = !justificationDtext
  !this.wallJust.rtext                = !justificationRtext

  !this.profileWallJustLine.dtext     = !justificationDtext
  !this.profileWallJustLine.rtext     = !justificationRtext

  !this.modProfileWallJustLine.dtext  = !justificationDtext
  !this.modProfileWallJustLine.rtext  = !justificationRtext

  !this.joinerWallJustLine.dtext      = !justificationDtext
  !this.joinerWallJustLine.rtext      = !justificationRtext

  !this.modJoinerWallJustLine.dtext   = !justificationDtext
  !this.modJoinerWallJustLine.rtext   = !justificationRtext

  -- Select Layout 1 as default wall connection
  !this.rad1.val  = true

  -- set tool tip for gadgets
  if(!!isImperialLength('DIST')) then
    !minimumLength  = '20in'
  else
    !minimumLength  = '500mm'
  endif
  --!this.profileLength.setTooltip('Minimum length should be ' & !minimumLength)

  !this.panelWholeWall.val = true
  !this.wallPanelOption()

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      wallPanelOption
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .wallPanelOption()

  if(!this.panelWholeWall.val) then
   	 !this.frPanelWholeWall.visible   = true
   	 !this.frPanelWallSection.visible = false
  else
     !this.frPanelWholeWall.visible   = false
   	 !this.frPanelWallSection.visible = true
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      updateWallList
--
-- Description: Get walls from graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateWallList()

  -- Set the 'delete detail' linklabel to inactive
  !this.deleteDet.active = FALSE

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('NAME')
  !attributes.append('WThickness')
  !attributes.append('Height')

  -- Load grid
  if(!this.wallList.empty().not()) then
    !block                  = object BLOCK('!this.wallList[!evalIndex].string()')
    !dbNames                = !this.wallList.evaluate(!block)
    !this.wallNames         = !dbNames
    using namespace 'Aveva.Pdms.Presentation'
    !nds                = object NETDATASOURCE('Walls', !attributes, !dbNames)
    !this.wallGrid.bindToDataSource(!nds)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useActiveWalls
--
-- Description: Get walls from graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useActiveWalls()

  -- Tidy graphics
  !this.tidy()

  -- Clear grid
  !this.wallGrid.clearGrid()

  -- Initialise Variables
  !this.wallList.clear()
  !this.wallNames.clear()
  !groups = ARRAY()

  -- Collect all walls for current active element

  -- Get DetGrp of active element
  do !member values !this.owner.members
    if(!member.type.eq('DETGRP')) then
      !groups.append(!member)
    endif
  enddo

  -- Collect walls from groups
  if(!groups.empty().not()) then
    !collection       = object COLLECTION()
    !collection.addType('CTWALL')
    !collection.scope(!groups)
    !this.wallList    = !collection.results()
  endif

  -- Update grid
  !this.updateWallList()

endmethod

-- End of Method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh form from navigator.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Refresh task
  if(!this.shown() and (!this.currentPane eq !this.detailTaskPane)) then
    !this.initialise()
    !this.refreshTask.evaluate()
  endif

endmethod
-- End of method

  ------------------------------------------------------------------------
--
-- Method:      refreshConfig
--
-- Description: Refresh all setting that use the configuration data.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshConfig()

  -- Grid defaults
  !columnExcelFilter            = !!accConfig.navigator.columnExcelFilter
  !outlookGroupStyle            = !!accConfig.navigator.outlookGroupStyle
  !columnSummaries              = !!accConfig.navigator.columnSummaries
  !labelVisibility              = !!accConfig.navigator.labelVisibility

  -- Control configuration (Rooms)
  !this.wallGrid.columnExcelFilter(!columnExcelFilter)
  !this.wallGrid.outlookGroupStyle(!outlookGroupStyle)
  !this.wallGrid.columnSummaries(!columnSummaries)
  !this.wallGrid.fixedHeaders(false)
  !this.wallGrid.fixedRows(false)
  !this.wallGrid.singleRowSelection(false)
  !this.wallGrid.setLabelVisibility(!labelVisibility)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Get current element
  !element                = !!accNavigator.currentSelection()

  if(!!isImperialLength('DIST')) then
    !maximumLength  = 120in
  else
    !maximumLength  = 3000mm
  endif

  -- If element is unset, then initialise form with limited actions
  if(!element.unset()) then
    !this.currentOwner.val      = 'No active element selected'

  -- Initialise form with relevant actions
  else
    -- Set owner where layout data is to be stored
    !this.owner                 = !element
    !this.currentOwner.val      = 'Active element: ' & !this.owner.namn
    !this.useActiveWalls()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dummy
--
-- Description: Dummy method for unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dummy()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  AID CLEAR ALL $!<this.aidNumber>


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidyWalls
--
-- Description: Tidy walls
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyWalls()

  -- Get current list
  !list = !this.wallNames
  unenhance all from !list

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      detailTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .detailTasks(!active is BOOLEAN)

  !this.tidy()

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.detailTaskPane

    -- Check wall has not been deleted
    !ce = !!ce
    !!ce = !this.currentWall
    handle ANY
    	!wallExists = FALSE
    elsehandle NONE
    	!wallExists = TRUE
    endhandle
    !!ce = !ce

    if (!this.currentWall.set() AND !wallExists) then
      !this.getDetails()
    else
      !this.dtModPanel.active   = FALSE
      !this.dtModProfile.active = FALSE
      !this.dtModJoiner.active  = FALSE
    endif

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.detailTasks(false)')
    !this.refreshTask         = object BLOCK('!this.dummy()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Wall Detail Tasks'

  endif

  -- Show/hide task pane
  !this.detailTaskPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      joinerTasks
--
-- Description: Set Joiner Tasks pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .joinerTasks(!active is BOOLEAN)

  -- Initialise Variables
  !this.joinSPREF.active  = FALSE
  !this.joinPoint.visible = false
  !this.joinerDist.visible = false

  -- Make task pane active
  if(!active) then

    --!this.switchJoinCall()

    -- Set current pane
    !this.currentPane       = !this.joinerTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.joinerTasks(FALSE)')
    !this.refreshTask         = object BLOCK('!this.dummy()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Create Wall Joiners'

    -- initialise the joiner gadgets
    !this.joinSPREF.val       = 'Unset'
    !this.joinerJustLine.val  = 'Unset'

    if(!!isImperialLength('DIST')) then
      !this.jSpacing.val      = 20in
    else
      !this.jSpacing.val      = 500mm
    endif

    !this.jStartHeight.val    = 0
    !this.jEndHeight.val      = !this.currentWall.height
   !this.joinerDistance       = 0
    !this.joinerDist.val      = 0

    !this.switchJoinCall()

  endif

  -- Show/hide task pane
  !this.joinerTaskPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      switchJoinCall
--
-- Description: Changes the create joiner callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .switchJoinCall()

  if (!this.singleJoin.val) then
    !this.joinCrt.callback  = '!this.createJoiner()'
    !this.jSpacing.visible    = FALSE
    !this.joinPoint.visible   = true
    !this.joinerDist.visible  = true

    !this.drawSingleJoiner()

  else
    !this.joinCrt.callback    = '!this.createJoiners(!this.currentWall)'
    !this.jSpacing.visible    = TRUE
    !this.joinPoint.visible   = false
    !this.joinerDist.visible  = false

    !this.drawJoiners()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      panelTasks
--
-- Description: Set panel tasks pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .panelTasks(!active is BOOLEAN)

  -- Initialise Variables
  !this.panSPREF.active = false
  !this.panWidth.active = false
  !this.panThick.active = false

    -- Make task pane active
    if(!active) then

      -- Set current pane
      !this.currentPane         = !this.panelTaskPane

      -- Run action for current pane
      !this.currentTask.evaluate()

      -- Defined action to be carried out on closing pane
      !this.currentTask         = object BLOCK('!this.panelTasks(false)')
      !this.refreshTask         = object BLOCK('!this.refresh()')

      -- Change form title to reflect the active pane
      !this.formTitle           = 'Panel Definition'

      -- Retrieve list of wall features
      !this.getFeatures()

      -- Set default connection type
      !this.rad1.val = TRUE

      !this.panSPREF.val        = 'Unset'
      !this.panWidth.val        = 0
      !this.panThick.val        = 0
      !this.panHeight.val       = 0
      !this.dtSplitWall.active  = FALSE
      !this.dtCrtPane.active    = FALSE

    else
      AID CLEAR ALL !this.aidPointsNo
    endif

    -- Show/hide task pane
    !this.panelTaskPane.visible = !active


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      profileTasks
--
-- Description: Set profile tasks pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      BOOLEAN    Set pane to..
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileTasks(!active is BOOLEAN)

  -- Initialise Variables
  !this.proSPREF.active = false

  -- Make task pane active
  if (!active) then

    -- Set current pane
    !this.currentPane         = !this.profileTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.profileTasks(FALSE)')
    !this.refreshTask         = object BLOCK('!this.refresh()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Create Profile'

    -- initialise the profile task gadgets
    !this.proSPREF.val            = 'Unset'
    !this.profileJustLine.val     = 'Unset'

    !this.profileLength.val   = !!accConfig.panelProfile
    !this.profileElev.val   = 0

  endif

  -- Show/hide task pane
  !this.profileTaskPane.visible = !active

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      modProfile
--
-- Description: Set modify profile pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      BOOLEAN    Set pane to..
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modProfile(!active is BOOLEAN)

  !this.modProfileSpec.active   = false

  -- Make task pane active
  if (!active) then

    -- Set current pane
    !this.currentPane         = !this.profileModPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.modProfile(FALSE)')
    !this.refreshTask         = object BLOCK('!this.refresh()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Profile'

    -- Set the current profile
    !this.currentDetail = !this.selectionArray[1]

    -- update gadgets with values from joiner attributes
    !this.updateGadgets('Profile')

    !this.drawProfile()

  endif

  -- Show/hide task pane
  !this.profileModPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modPanel
--
-- Description: Set modify panel pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      BOOLEAN    Set pane to..
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modPanel(!active is BOOLEAN)

  -- Make task pane active
  if (!active) then

    -- Set current pane
    !this.currentPane         = !this.panelModPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.modPanel(FALSE)')
    !this.refreshTask         = object BLOCK('!this.refresh()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Panel'

    -- update gadgets with values from panel attributes
    !this.updateGadgets('Panel')
  endif

  -- Show/hide task pane
  !this.panelModPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modJoiner
--
-- Description: Set modify joiner pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      BOOLEAN    Set pane to..
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modJoiners(!active is BOOLEAN)

  !this.modJoinerSpec.active = false

  -- Make task pane active
  if (!active) then

    -- Set current pane
    !this.currentPane         = !this.joinerModPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Defined action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.modJoiners(FALSE)')
    !this.refreshTask         = object BLOCK('!this.refresh()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Joiner'

    -- update gadgets with values from joiner attributes
    !this.updateGadgets('Joiner')

    -- display aid graphics
    !this.tidy()

    !this.drawModifiedJoiner()

  endif

  -- Show/hide task pane
  !this.joinerModPane.visible = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectWall
--
-- Description: Select Wall from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectWall(!dummyPassedArray is ARRAY)

  -- Initialise Variable
  !elements = !this.wallGrid.getSelectedRowTags()

  !this.pickDetail.clear()

  if (!elements.size() neq 0) then

    !this.currentWall = !elements[1].dbref()
    handle ANY
    endhandle

    !list     = !this.wallNames
    enhance all from !elements colour red

    if (!this.getRPath(!this.currentWall)) then

      !this.dtCrtProfile.active = TRUE
      !this.dtCrtJoiner.active  = TRUE
      !this.dtCrtPanel.active   = TRUE

      !this.panCurrWall.val     = 'Current Wall: ' & !this.currentWall.fullname
      !this.profCurrWall.val    = 'Current Wall: ' & !this.currentWall.fullname
      !this.joinCurrWall.val    = 'Current Wall: ' & !this.currentWall.fullname

    else
      !!alert.warning('No RPATH on Wall')
      !this.dtCrtProfile.active = FALSE
      !this.dtCrtJoiner.active  = FALSE
      !this.dtCrtPanel.active   = FALSE
    endif

    !this.getDetails()

  else
    !this.dtCrtProfile.active = FALSE
    !this.dtCrtJoiner.active  = FALSE
    !this.dtCrtPanel.active   = FALSE
    !this.dtModPanel.active   = FALSE
    !this.dtModProfile.active = FALSE
    !this.dtModJoiner.active  = FALSE
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      listSelection
--
-- Description: Updates the current wall feature
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .listSelection(!gadget is GADGET, !action is STRING)

  if (!action eq 'SELECT') then

    !this.tidy()

    !selectedRow          = !this.features.rtext[!this.features.val]
    !featureRow           = !selectedRow.split()

    !firstElement         = object DBREF(!featureRow[1])
    !secondElement        = object DBREF(!featureRow[2])
    if(!firstElement.type.eq('DOOR')) then
      !this.currentFeature  = !firstElement
    else
      !this.currentFeature  = !secondElement
    endif

    handle ANY
        !this.getFeatures()
      return FALSE
    elsehandle NONE
        !this.dtCrtPane.tag = 'Create Panels from $!firstElement to $!secondElement'
    endhandle

    !this.panelStartElement = !firstElement
    !this.panelEndElement   = !secondElement

    !startPos = !firstElement.position
    !endPos   = !secondElement.position

    AID CLEAR ALL !this.aidPointsNo
    AID TEXT NUMBER $!<this.aidPointsNo> 'Start' At $!<startPos>
    AID TEXT NUMBER $!<this.aidPointsNo> 'End' At $!<endPos>

    if(!firstElement.type.eq('DOOR')) then
      !one  = !firstElement.name
    else
      !one = !firstElement.type   & ' ' & !firstElement.tyseq
    endif

    if(!secondElement.type.eq('DOOR')) then
      !two  = !secondElement.name
    else
      !two = !secondElement.type  & ' ' & !secondElement.tyseq
    endif

    !panellingDirDtext[1] = 'From $!one To $!two'
    !panellingDirDtext[2] = 'From $!two To $!one'

    !panellingDirRtext[1]  = !firstElement.string()  + ' ' + !secondElement.string()
    !panellingDirRtext[2]  = !secondElement.string() + ' ' + !firstElement.string()

    -- populate the panel direction options
    !this.panelDir.dtext  = !panellingDirDtext
    !this.panelDir.rtext  = !panellingDirRtext

    !this.dtCrtPane.tag = 'Create Panels from $!one to $!two'

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setDetail
--
-- Description: Update current detail DBREF
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING   Selected Detail
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDetail(!gadget is GADGET, !mode is STRING)

  !this.dtModJoiner.active  = FALSE
  !this.dtModPanel.active   = FALSE
  !this.dtModProfile.active = FALSE

  if ( !mode eq 'UNSELECT' ) then
     return
  elseif ( !mode eq 'SELECT' ) then
     !this.selectionArray.clear()
     do !i from 1 to !gadget.selection().size()
       !this.selectionArray.append(!gadget.selection()[!i].dbref())
     enddo

     handle ANY
     endhandle
  elseif ( !mode eq 'STOP' ) then
     do !i from 1 to !gadget.selection().size()
       -- only allow selections of elements of the same type
       if (!this.selectionArray[1].fulltype neq !this.selectionArray[!i].fulltype) then
          !!alert.error('Selected elements must be of the same type')
          !this.selectionArray.clear()
          !this.deleteDet.active = FALSE
	  !gadget.clearSelection()
	  !gadget.refresh()
          return
       endif
     enddo
  endif

  if (!this.selectionArray.set()) then
    !!ce = !this.selectionArray[1]

    if (!this.selectionArray[1].fulltype eq 'WLJOIN') then
      !this.currentDetail = !this.selectionArray[1]
      !this.dtModJoiner.active  = TRUE
      -- Update joiner gadgets
      !this.updateGadgets('Joiner')

    elseif (!this.selectionArray[1].fulltype eq 'WLPANEL') then
      !this.dtModPanel.active   = TRUE
      -- Update panel gadgets
      !this.updateGadgets('Panel')

    elseif (!this.selectionArray[1].fulltype eq 'WLPROF') then
      !this.dtModProfile.active = TRUE
      -- Update profile gadgets
      !this.updateGadgets('Profile')

    else
        !gadget.clearSelection()
        !!alert.warning('Wrong element type selected.')
        return
    endif

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Update relevant gadgets with detail information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     Detail Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets(!detailType is STRING)

  if (!this.pickDetail.selection().unset()) then
    !this.deleteDet.active = FALSE
  else
    !this.deleteDet.active = TRUE
  endif

  if (!detailType.upcase() eq 'JOINER') then

    if ( !this.selectionArray.size() eq 1 ) then
       !this.joinCurDet.val        = 'Current Joiner: ' & !this.selectionArray[1].fullname
       !this.modJoinerDist.active  = true
    else
       !this.joinCurDet.val        = 'Modifying ' & !this.selectionArray.size() & ' Joiners'
       !this.modJoinerDist.active  = false
    endif
    !this.joinModStart.val      = !this.selectionArray[1].posRef.string()
    !this.joinModStart.active   = false
    !this.modJoinerSpec.val      = !this.selectionArray[1].spref.name
    !this.modJoinerSpec.active   = false
    !this.modJoinerJustLine.val = !this.selectionArray[1].jusLine
    !this.modJStartHeight.val   = !this.selectionArray[1].sdista
    !this.modJEndHeight.val     = !this.selectionArray[1].edista
    !this.modJoinerDist.val     = !this.selectionArray[1].zdist
    !this.joinerDistance        = !this.selectionArray[1].zdist
    !this.modJoinerWallJustLine.select('rtext', !this.selectionArray[1].wJusLine)
    handle ANY
      -- in case the list do not have the justification
    endhandle

  elseif (!detailType.upcase() eq 'PROFILE') then

    if ( !this.selectionArray.size() eq 1 ) then
       !this.proCurDet.val       = 'Current Profile: ' & !this.selectionArray[1].fullname
       !this.modProfileStartDist.active   = TRUE
       !this.modProfileEndDist.active   = TRUE
    else
       !this.proCurDet.val        = 'Modifying ' & !this.selectionArray.size() & ' Profiles'
       !this.modProfileStartDist.active   = FALSE
       !this.modProfileEndDist.active   = FALSE
    endif

    !this.modProfileStart.val     = !this.selectionArray[1].staRef.string()
    !this.modProfileEnd.val       = !this.selectionArray[1].endRef.string()
    !this.modProfileStart.active  = FALSE
    !this.modProfileEnd.active    = FALSE
    !this.modProfileSpec.val      = !this.selectionArray[1].spref.name
    !this.modProfileSpec.active   = false
    !this.modProfileJustLine.val  = !this.selectionArray[1].jusLine
    !this.modProfileStartDist.val = !this.selectionArray[1].szdistance
    !this.modProfileEndDist.val   = !this.selectionArray[1].ezdistance
    !this.modProfileHeight.val    = !this.selectionArray[1].zOffset
    !this.modProfileWallJustLine.select('rtext',!this.selectionArray[1].wJusLine)
    handle ANY
    endhandle

  elseif (!detailType.upcase() eq 'PANEL') then

    if ( !this.selectionArray.size() eq 1 ) then
       !this.panCurDet.val       = 'Current Panel: ' & !this.selectionArray[1].fullname
       !this.panModDist.active   = TRUE
       !this.panLeadCut.active   = TRUE
       !this.panRearCut.active   = TRUE
    else
       !this.panCurDet.val       = 'Modifying ' & !this.selectionArray.size() & ' Panels'
       !this.panModDist.active   = FALSE
       !this.panLeadCut.active   = FALSE
       !this.panRearCut.active   = FALSE
    endif

    !this.panModDesc.val      = !this.selectionArray[1].description
    !this.panModSPREF.val     = !this.selectionArray[1].spref.name
    !this.panModSPREF.active  = FALSE
    !this.panModStart.val     = !this.selectionArray[1].posRef.string()
    !this.panModStart.active  = FALSE
    !this.panModDist.val      = !this.selectionArray[1].zdistance
    !this.panModHeight.val    = !this.selectionArray[1].vdistance

    -- Set the desparam according to the justification of the panel
    if (!this.selectionArray[1].wJusLine eq 'RIGH') then
       !this.panLeadCut.val = !this.selectionArray[1].desparam[2]
       !this.panRearCut.val = !this.selectionArray[1].desparam[1]
    else
       !this.panLeadCut.val = !this.selectionArray[1].desparam[1]
       !this.panRearCut.val = !this.selectionArray[1].desparam[2]
    endif

    if (!this.selectionArray[1].desparam[3].set()) then
      !this.panTopCut.val = !this.selectionArray[1].desparam[3]
    endif


  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      catalogueSearch
--
-- Description: Launches the selection form for profiles
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileSearch(!gadget is GADGET , !dummyString is STRING)

  -- Initialise the form
  !profileData = object PROFILECATALOGUEDATA()

  !plineList   = ARRAY()

  -- Selection form title
  !title              = 'Select Wall Supports'

  -- Action to be carried out
  if (!gadget eq !this.findProf or !gadget eq !this.modFindProfile) then
    !action             = '!!' & !this.name() & '.setSpreField(|Wall Profiles|,!this.catalogueProfile)'
  elseif (!gadget eq !this.findJoin or !gadget eq !this.modFindJoin) then
    !action             = '!!' & !this.name() & '.setSpreField(|Wall Joiners|,!this.catalogueProfile)'
    !title              = 'Select Wall Joiners'
  endif

  -- Setup object for profile selection
  !profileSelection   = object PROFILESELECTION(!title, !action)

  !profileSelection.profileData(!profileData)
  !profileSelection.defaultPlines(!plineList)

  -- Display profile selection form
  !profileSelection.show()

  -- Filter the results
  !!sectionprofileselection.specList.select('dtext' , 'Wall Support Profile')
  -- load the gtypes for the selected specification
  !!sectionprofileselection.selectSpecification()

  -- filter the gtype
  if (!gadget eq !this.findProf or !gadget eq !this.modFindProfile) then
    !!sectionprofileselection.gtypeList.select('dtext' , 'Wall Profiles')
  elseif (!gadget eq !this.findJoin or !gadget eq !this.modFindJoin) then
    !!sectionprofileselection.gtypeList.select('dtext' , 'Wall Joiners')
  endif
  -- load the profiles for the selected gtype
  !!sectionprofileselection.selectGtype()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      panelSearch
--
-- Description: Launches the selection form for wall panels
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .panelSearch()

  -- Initialise the form
  !!stchoosedata.cleardata()

  !!stchoosedata.settitle('Wall Panel')

  !!stchoosedata.setdata('ROOM','WLPN')

  !!stchoosedata.questions[1] = 'TYPE'
  !!stchoosedata.answers[1]   = 'Wall Panel'

  !!stchoosedata.setTable()

  show !!stchooseselection

  !!stchooseselection.action = object BLOCK('!!' & !this.name() & '.setSpreField(|Wall Panel|, !this.selectedItem )')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setSpreField
--
-- Description: Sets the value of correct text box to the passed SPREF
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       STRING    Profile Type
--    2    R       STRING    Profile Name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpreField(!profileType is STRING, !catalogueProfileData is ANY)

    if (!profileType eq 'Wall Profiles') then
      !this.catalogueProfile  = !catalogueProfileData
      !this.proSPREF.val           = !catalogueProfileData.catalogueReference.catref.name
      !this.modProfileSpec.val     = !catalogueProfileData.catalogueReference.catref.name
      !this.profileJustLine.val    = !catalogueProfileData.justificationLine
      !this.modProfileJustLine.val = !catalogueProfileData.justificationLine

      !!sectionprofileselection.hide()

    elseif (!profileType eq 'Wall Joiners') then
      !this.catalogueProfile  = !catalogueProfileData
      !this.joinSPREF.val         = !catalogueProfileData.catalogueReference.catref.name
      !this.modJoinerSpec.val     = !catalogueProfileData.catalogueReference.catref.name
      !this.joinerJustLine.val    = !catalogueProfileData.justificationLine
      !this.modJoinerJustLine.val = !catalogueProfileData.justificationLine
      !!sectionprofileselection.hide()

    elseif (!profileType eq 'Wall Panel') then
      !this.panSPREF.val  = !catalogueProfileData.name
      !this.panModSPREF.val  = !catalogueProfileData.name
      !this.panWidth.val  = !!stchooseselection.netSelTabItems.getSelectedRows()[1][3].real()
      !this.panThick.val  = !!stchooseselection.netSelTabItems.getSelectedRows()[1][5].real()
      !this.dtSplitWall.active  = TRUE
      !this.dtCrtPane.active  = TRUE
    endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getRPath
--
-- Description: Retrieves the points of the selected wall's RPATH
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--     BOOLEAN    RPATH or No?
--
------------------------------------------------------------------------

define method .getRPath(!selectedWall is DBREF) is BOOLEAN

  !closeFlag   = !selectedWall.closeFlag
  !collection  = object COLLECTION()
  !collection.scope(!selectedWall)
  !collection.type('RPATH')

  if (!collection.results().size() eq 0) then
    return FALSE
  endif

  !rPath = !collection.results().last()

  !rPoints = object COLLECTION()
  !rPoints.scope(!rPath)
  !rPoints.type('POINTR')

  !wallPoints = !rPoints.results()

  !this.currRPath = !wallPoints

  !this.pointNames = ARRAY()
  !this.pointDBREF = ARRAY()

  !this.pointGaps  = ARRAY()
  !this.pointDbs   = ARRAY()

    do !points values !wallPoints
    !index = !wallPoints.findFirst(!points)
    !this.pointNames.append('POINTR' & !index)
    if (!index neq !wallPoints.size()) then
      !this.pointGaps.append('POINTR ' & !index & ' to POINTR ' & (!index + 1))
      !this.pointDbs.append(!points.string())
    endif
      !this.pointDBREF.append(!points.string())
  enddo

  -- handle closed walls
  if ( !closeFlag ) then
    !this.pointGaps.append('POINTR ' & !wallPoints.size() & ' to POINTR 1' )
    !this.pointDbs.append(!wallPoints.last().string())
  endif

  !this.startPick.dtext = !this.pointNames
  !this.startPick.rtext = !this.pointDBREF

  !this.stopPick.dtext  = !this.pointNames
  !this.stopPick.rtext  = !this.pointDBREF

  !this.joinPoint.dtext = !this.pointNames
  !this.joinPoint.rtext = !this.pointDBREF

  !this.wallPoint.dtext = !this.pointGaps
  !this.wallPoint.rtext = !this.pointDbs

  return TRUE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getDetails
--
-- Description: Retrieves a list of all the current profiles, panels
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getDetails()

  !!ce        = !this.currentWall
  !details    = ARRAY()
  !gotDetails = FALSE

  -- Look for and list any Wall Joints
  !joiCollect = object COLLECTION()
  !joiCollect.scope(!!ce)
  !joiCollect.type('WLJNTS')

  !detailExist = FALSE

  if (!joiCollect.results().size() neq 0) then
    !wallJoints = !joiCollect.results()[1].members
    !details.appendArray(!wallJoints)
    !gotDetails = TRUE
    !this.deleteJoi.active = TRUE
    !detailExist = TRUE
  else
    !this.deleteJoi.active = FALSE
  endif

  -- Look for and list any Wall Profiles
  !proCollect = object COLLECTION()
  !proCollect.scope(!!ce)
  !proCollect.type('WLPRSE')

  if (!proCollect.results().size() neq 0) then
    !wallProfs  = !proCollect.results()[1].members
    !details.appendArray(!wallProfs)
    !gotDetails = TRUE
    !this.deletePro.active = TRUE
    !detailExist = TRUE
  else
    !this.deletePro.active = FALSE
  endif

  -- Look for and list any Wall Panels
  !panCollect = object COLLECTION()
  !panCollect.scope(!!ce)
  !panCollect.type('WLCOMP')

  if (!panCollect.results().size() neq 0) then
    !wallPanels = !panCollect.results()[1].members
    !details.appendArray(!wallPanels)
    !gotDetails = TRUE
    !this.deletePan.active = TRUE
    !detailExist = TRUE
  else
    !this.deletePan.active = FALSE
  endif

  -- Convert list of details into two arrays, one of names and one of dbRefs
  !detailNames = object ARRAY()
  !detailDBREF = object ARRAY()

  do !det values !details
    if (!det.fullname.split().size() ge 2) then
      !detailNames.append(!det.fullname.split()[1] & !det.fullname.split()[2])
    else
      !detailNames.append(!det.name)
    endif
    !detailDBREF.append(!det.string())
  enddo

  !this.pickDetail.dtext = !detailNames
  !this.pickDetail.rtext = !detailDBREF

  -- If no details in the wall then, deactivate modify buttons
  if (!gotDetails) then
    !this.setDetail(!this.pickDetail, 'SELECT' )
  else
    !this.dtModPanel.active   = FALSE
    !this.dtModProfile.active = FALSE
    !this.dtModJoiner.active  = FALSE
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createJoiners
--
-- Description: Create a line of joiners along a wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createJoiners(!wall is DBREF)

  if(!this.joinSPREF.val.unset() or !this.joinSPREF.val.empty()) then
    !!alert.message('Joiner Specification is not set')
    return
  endif

  !!ce    = !wall
  !closeFlag          = !!ce.closeFlag
  !justificationLine   = !this.catalogueProfile.justificationLine
  -- Joiner Wall Justification
  !wallJustificationLine   = !this.joinerWallJustLine.selection()

  !collection         = object COLLECTION()
  !collection.scope(!!ce)
  !collection.type('WLJNTS')

    -- Define UNDO Information
  !this.undo = object UNDOABLE()

  !this.undo.description('Created Wall Joints')
  !this.undo.add()

    -- If group exists, add panels to that group
    if (!collection.results().size() ne 0) then
      !wallJointsGroup = !collection.results()[1]
    -- If group doesn't exist, create new group
    else
      NEW WLJNTS
      !wallJointsGroup = !!ce
    endif

    !!ce = !wallJointsGroup

    do !i indices !this.currRPath

      --break if (!i eq !this.currRPath.size())
      !cPoint = !this.currRPath[!i]
      if (!i eq !this.currRPath.size()) then
        if ( !closeFlag eq true ) then
           -- closed wall so add joiners to final section
           !nPoint = !this.currRPath[1]
        else
           break
        endif
      else
        !j = !i + 1
        !nPoint = !this.currRPath[!j]
      endif

      -- offset joiner depending on position of first panel in the leg of the path
      !collection  = object COLLECTION()
      !collection.scope(!wall)
      !collection.type('WLPANE')
     -- !expression = object EXPRESSION('POSREF of owner eq $!<this.wallSectionStart>')
      !expression = object EXPRESSION('POSREF  eq $!cPoint')
      !collection.filter(!expression)
      if (!collection.results().size() ne 0) then
        !firstWallPanel = !collection.results()[1]
        !offset = !firstWallPanel.zdist - 0.5 *  !firstWallPanel.prop.widt.real()
        handle ANY
          !offset = 0.0
        endhandle
      else
        !offset = 0.0
      endif

      !cPos = !cPoint.position
      !nPos = !nPoint.position

      !sectionLine = object LINE(!cPos, !nPos)

      !sectionLen  = !sectionLine.length()

      -- If next section is a curve, set section length to distance round the curve
      do !k indices !cPoint.owner.members

        if (!cPoint.owner.members[!k] eq !cPoint)then

          !nextPoint = !cPoint.owner.members[!k + 1]
          handle ANY
            break
          endhandle

          if (!nextPoint.fulltype eq 'CURVE') then

          --CURVE
          !start = !nextPoint.ppos[1].wrt( /* )
          !thru  = !nextPoint.ppos[7].wrt( /* )
          !end   = !nextPoint.ppos[2].wrt( /* )
          !plane = !start.plane(!thru, !end)
          !dir   = !plane.pointVector().direction
          !arc   = !start.arcThru(!thru,!end,!dir)

          !sectionLen = !arc.length()

          endif

        endif

        break if (!cPoint.owner.members[!k] eq !cPoint)

      enddo

      --!spacing = !this.jSpace.val
      !spacing = !this.jSpacing.val

      if (!spacing lt 500mm) then
        !spacing = 500mm
      endif

      !zdist = !spacing + !offset

      do

        break if (!zdist ge (!sectionLen - 100mm))

        !!ce = !wallJointsGroup

        NEW WLJOIN

        !element = !!ce
        -- Name element
        if(!element.isNamed) then
          call !!autoNameCe(false)
        endif

        !element.spref      = !this.joinSPREF.val.dbref()
        !element.zdistance  = !zdist
        !element.sdistance  = !this.jStartHeight.val
        !element.edistance  = !this.jEndHeight.val
        !element.posRef     = !cPoint

        !element.jusLine      = !justificationLine
        !element.wJusLine     = !wallJustificationLine

        !zdist = !zdist + !spacing

        !!ce = !wallJointsGroup
      enddo

    enddo


    !this.undo.endUndoable()

    refresh

endmethod

--------------------------------------------------------------------------
--
-- Method:      getFeatures
--
-- Description: Retrieves a list of all the wall openings, doors, windows
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getFeatures()

  AID CLEAR ALL !this.aidPointsNo

  !wallDistances = ARRAY()

  -- Tag start and end of wall section

  !this.wallSectionStart = !this.wallPoint.selection().dbref()
  handle ANY
   !this.dtCrtPane.tag = 'Create Panels on current Wall Section'
   return TRUE
  endhandle

  AID TEXT NUMBER $!<this.aidPointsNo> 'Start' At $!<this.wallSectionStart.position>

  !this.wallSectionEnd = !this.wallSectionStart.owner.members[!this.wallSectionStart.sequ + 1]
  handle ANY
    !this.wallSectionEnd = !this.wallSectionStart.owner.members[1]
  endhandle
  -- move to the next POINTR if the next element type is CURVE
  if (!this.wallSectionEnd.type eq 'CURVE') then
      !this.wallSectionEnd = !this.wallSectionEnd.owner.members[!this.wallSectionEnd.sequ + 1]
  endif

  if (!this.wallSectionEnd.set()) then
      AID TEXT NUMBER $!<this.aidPointsNo> 'End' At $!<this.wallSectionEnd.position>
  endif

  !startPoint  = !this.wallSectionStart.type  & ' ' & !this.wallSectionStart.tyseq
  !endPoint    = !this.wallSectionEnd.type    & ' ' & !this.wallSectionEnd.tyseq

  !this.dtCrtPane.tag = 'Create Panels from ' & !startPoint & ' to ' &  !endPoint

  -- collect all doors between the selected wall section start and end points
  -- collect all doors which has wall section start (POINTR) as POSREF of its owner (WLOPEN)
  !doorColl  = object COLLECTION()
  !doorColl.scope(!this.currentWall)
  !doorColl.type('DOOR')

  !expression = object EXPRESSION('POSREF of owner eq $!<this.wallSectionStart>')
  !doorColl.filter(!expression)
  !doors  = !doorColl.results()

  -- headings for the wall features list
  !headings = object ARRAY()
  !headings.append('Between')
  !headings.append('And')
  !headings.append('ZDist')

  -- initialise the wall features array that will be populated in the list
  !wallFeats = ARRAY()
  !listRtext  = ARRAY()

  -- initialise the panel direction options array
  !panellingDirDtext  = ARRAY()
  !panellingDirRtext  = ARRAY()

  if(!doors.set()) then

    !doorDist     = !doors.evaluate(object BLOCK('!doors[!evalIndex].owner.zdist'))
    !sortIndices  = !doorDist.sortedIndices()
    !doors.reindex(!sortIndices)

    !listItems[1]  = !this.wallSectionStart
    !listItems.appendArray(!doors)
    !listItems.append(!this.wallSectionEnd)

    do !n from 1 to !listItems.size() - 1
      !doorArray  = ARRAY()

      if(!listItems[!n].type.eq('POINTR')) then
        !firstString = 'POINTR ' + object STRING(!listItems[!n].tyseq)
      elseif(!listItems[!n].type.eq('DOOR')) then
        !firstString = !listItems[!n].flnn
      endif

      if(!listItems[!n + 1].type.eq('POINTR')) then
        !secondString = 'POINTR ' + object STRING(!listItems[!n + 1].tyseq)
      elseif(!listItems[!n + 1].type.eq('DOOR')) then
        !secondString = !listItems[!n + 1].flnn
      endif

      !doorArray.append(!firstString)
      !doorArray.append(!secondString)

      !listRtext[!n]  = !listItems[!n].string() + ' ' + !listItems[!n + 1].string()

      !zdist  = !listItems[!n].owner.zdist
      handle ANY
        !zdist  = !listItems[!n + 1].owner.zdist
      endhandle

      !doorArray.append(!zdist.string())

      !wallFeats.append(!doorArray)
    enddo

  endif

  !panellingDirDtext[1] = 'From $!startPoint To $!endPoint'
  !panellingDirDtext[2] = 'From $!endPoint To $!startPoint'

  !panellingDirRtext[1] = !this.wallSectionStart.string() + ' ' + !this.wallSectionEnd.string()
  !panellingDirRtext[2] = !this.wallSectionEnd.string()   + ' ' + !this.wallSectionStart.string()

  -- populate the wall features list with the door details
  !this.features.setHeadings(!headings)
  !this.features.setRows(!wallFeats)
  !this.features.rtext  = !listRtext

  -- populate the panel direction options
  !this.panelDir.dtext  = !panellingDirDtext
  !this.panelDir.rtext  = !panellingDirRtext

  !this.panelStartElement = !this.wallSectionStart
  !this.panelEndElement   = !this.wallSectionEnd

  !panellingDirDtext1[1] = 'From POINTR 1 to' & ' POINTR '  & !this.currRPath.size()
  !panellingDirDtext1[2] = 'From POINTR ' & !this.currRPath.size() & ' to POINTR 1'

  !panellingDirRtext1[1] = !this.currRPath[1].string() + ' ' + !this.currRPath[!this.currRPath.size()].string()
  !panellingDirRtext1[2] = !this.currRPath[!this.currRPath.size()].string() + ' ' + !this.currRPath[1].string()

  !this.panelDir1.dtext  = !panellingDirDtext1
  !this.panelDir1.rtext  = !panellingDirRtext1

  !this.currentFeature = object DBREF()

endmethod
-- End of method

--------------------------------------------------------------------------
--
-- Method:      createJoiner
--
-- Description: Create a single joiner with the specified SPREF
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       DBREF    Joiner SPREF
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------

define method .createJoiner()

  if(!this.joinSPREF.val.empty() or !this.joinSPREF.val.unset()) then
    !!alert.message('Joiner Specification is not set')
    return
  endif

  !!ce                 = !this.currentWall
  -- Joiner P-Line Justification
  --!justificationLine   = !this.catalogueProfile.justificationLine
  !justificationLine  = !this.joinerJustLine.val
  if(!justificationLine eq 'unset') then
    !justificationLine  = 'NA'
  endif

  -- Joiner Wall Justification
  !wallJustificationLine   = !this.joinerWallJustLine.selection()

  !collection         = object COLLECTION()
  !collection.scope(!!ce)
  !collection.type('WLJNTS')

    -- Define UNDO Information
  !this.undo = object UNDOABLE()

  !this.undo.description('Created Wall Joint')
  !this.undo.add()

   -- If group exists, add panels to that group
   if (!collection.results().size() ne 0) then
     !wallJointsGroup = !collection.results()[1]
   -- If group doesn't exist, create new group
   else
     NEW WLJNTS
     !wallJointsGroup = !!ce
   endif
   !!ce = !wallJointsGroup

   NEW WLJOIN
   !element = !!ce
   !element.spref      = !this.joinSPREF.val.dbref()
   !element.zdistance  = !this.joinerDistance
   !element.sdistance  = !this.jStartHeight.val
   !element.edistance  = !this.jEndHeight.val
   if (!this.currentWall.closeFlag eq FALSE) then
     if (!this.joinPoint.selection().dbref() eq !this.pointDBREF.last().dbref()) then
       !element.posRef      = !this.pointDBREF[!this.pointDBREF.size()].dbref()
       -- !element.pkDistance  = 1
     else
       !element.posRef     = !this.joinPoint.selection().dbref()
     endif
   else
     !element.posRef     = !this.joinPoint.selection().dbref()
   endif

   !element.jusLine      = !justificationLine
   !element.wJusLine     = !wallJustificationLine

   !!ce = !wallJointsGroup

   !this.undo.endUndoable()

   refresh

endmethod
------------------------------------------------------------------------
--
-- Method:      createProfile
--
-- Description: Create a single profile in a Wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Successful create or no
--
------------------------------------------------------------------------

define method .createProfile()

  if(!this.proSPREF.val.empty() or !this.proSPREF.val.unset()) then
    !!alert.message('Profile Specification is not set')
    return
  endif
    !start = !this.startPick.selection().dbref()
  !end   = !this.stopPick.selection().dbref()

  !!ce = !this.currentWall

  !maxLength   = !this.profileLength.val
  !zOffset     = !this.profileElev.val
  !spref       = !this.proSPREF.val.dbref()

  !justificationLine  = !this.profileJustLine.val
  if(!justificationLine eq 'unset') then
    !justificationLine  = 'NA'
  endif

  !wallJustLine       = !this.profileWallJustLine.selection()

  -- Define UNDO Information
  !this.undo = object UNDOABLE()

  !this.undo.description('Created Wall Profile')
  !this.undo.add()

  !collection         = object COLLECTION()
  !collection.scope(!!ce)
  !collection.type('WLPRSE')

  -- If group exists, add panels to that group
  if (!collection.results().size() ne 0) then
    !!ce = !collection.results()[1]
  -- If group doesn't exist, create new group
  else
    NEW WLPRSE
  endif
  !filteredPoints = !this.currRPath
  !firstPoinR =  !filteredPoints[1]
  !startIndex = !this.currRPath.findFirst(!start)
  !endIndex = !filteredPoints.findFirst(!end)

  if ( !startIndex gt !endIndex ) then
    !tempArray = !filteredPoints.from(!startIndex )
    !tempArray.appendArray(!filteredPoints.from(1, !endIndex))
    !filteredPoints = !tempArray
  elseif ( !startIndex eq !endIndex ) then
    if (!this.currentWall.closeFlag eq true ) then
      !filteredPoints.append(!filteredPoints[1])
    endif

  else
    if( !endIndex.set() and !endIndex lt !filteredPoints.maxIndex() ) then
      !filteredPoints.removeFrom(!endIndex + 1)
    endif
    if (!startIndex neq 1) then
      !filteredPoints.removeTo(!startIndex - 1)
    endif
  endif
  !lastWallBegins = !filteredPoints.size() - 1

  do !i from 1 to !lastWallBegins
    !startPoint  = !filteredPoints[!i]
    !endPoint   = !filteredPoints[!i + 1]
    if (!endPoint eq !firstPoinR and !this.currentWall.closeFlag eq False) then
      skip
    endif

    !arcLen = 0
    do !k indices !startPoint.owner.members

        if (!startPoint.owner.members[!k] eq !startPoint)then
          if (!k eq !startPoint.owner.members.size() ) then
            !nextPoint = !startPoint.owner.members[!k]
          else
            !nextPoint = !startPoint.owner.members[!k + 1]
          endif

          if (!nextPoint.fulltype eq 'CURVE') then
            --CURVE
            !cStart = !nextPoint.ppos[1].wrt( /* )
            !cThru  = !nextPoint.ppos[7].wrt( /* )
            !cEnd   = !nextPoint.ppos[2].wrt( /* )
            !plane = !cStart.plane(!cThru, !cEnd)
            !dir   = !plane.pointVector().direction
            !arc   = !cStart.arcThru(!cThru,!cEnd,!dir)

            !arcLen = !arc.length()
          endif

        endif

        break if (!startPoint.owner.members[!k] eq !startPoint)

    enddo

    !lineSegment = object LINE(!startPoint.position, !endPoint.position)
    if (!arcLen gt 0) then
      !segmentLength = !arcLen
    else
      !segmentLength = !lineSegment.length()
    endif

    !maxLength   = !this.profileLength.val

    if(!maxLength lt 500mm) then

      NEW WLPROF
      !element = !!ce
      !element.spref       = !spref
      !element.jusLine     = !justificationLine
      !element.wjusl       = !wallJustLine
      !element.staRef      = !start
      !element.endRef      = !end
      !element.zOffset     = !zOffset

      !this.undo.endUndoable()

      !this.tidy()

      return

    endif

    !startDist   = 0
    -- loop through adding profile lengths on each wall segment
    do

      break if (!startDist ge !segmentLength)

      NEW WLPROF
      !element = !!ce
      !element.spref       = !spref
      !element.jusLine     = !justificationLine
      !element.wjusl       = !wallJustLine
      !element.staRef      = !startPoint
      !element.szdistance  = !startDist
      !element.zOffset     = !zOffset

      !distanceLeft = !segmentLength - !startDist

      !startDist = !startDist + !maxLength
      -- anchor end position to start to avoid a core bug
      !element.endRef     = !startPoint

      if (!distanceLeft le !maxLength) then
        -- stopping short of end to avoid a core bug
        !element.ezdistance = !segmentLength - 0.1mm
      else
        !element.ezdistance = !startDist
      endif

    enddo

  enddo

  !this.undo.endUndoable()

  !this.tidy()

endmethod

------------------------------------------------------------------------
--
-- Method:      createPanel
--
-- Description: Create a single panel in a Wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Successful create or no
--
------------------------------------------------------------------------

define method .createPanel()

  !!ce  = !this.currentWall

  -- Define UNDO Information
  !this.undo  = object UNDOABLE()

  !this.undo.description('Created Wall Panel')
  !this.undo.add()

  -- Search for WLCOMP Group
  !collection       = object COLLECTION()
  !collection.scope(!!ce)
  !collection.type('WLCOMP')

  -- If group exists, add panels to that group
  if (!collection.results().size() ne 0) then
    !wallCompGroup = !collection.results()[1]
  -- If group doesn't exist, create new group
  else
    NEW WLCOMP
    !wallCompGroup = !!ce
  endif

  !!ce = !wallCompGroup

  NEW WLPANE

  !element = !!ce
  !name                       = !this.panName.val.trim()
  if(!name.neq('')) then
    !name                     = '/' & !name
    !element.name    = !name
  endif
  !element.description = !this.panDesc.val
  !element.spref = !this.panSPREF.val.dbref()

  !element.zdistance = !this.panDist.val
  !element.posRef    = !this.panStart.selection().dbref()
  !element.wJusLine  = 'CENT'

  !this.undo.endUndoable()

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      splitWholeWall
--
-- Description: Creates a set of panels along the RPATH of a wall
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitWholeWall(!panWidth is REAL)

  if(!this.panSPREF.val.unset() or !this.panSPREF.val.empty()) then
    !!alert.message('Wall panel Specification not selected')
    return
  elseif (!panWidth.unset() or !panWidth eq 0) then
    !!alert.message('Wall panel Width is not specified')
    return
  elseif (!this.panThick.val.unset() or !this.panThick.val eq 0) then
    !!alert.message('Wall panel Thickness is not specified')
    return
  endif

  if (!this.currRPath.size() lt 2) then
    return
  endif

  !thickness          = !this.currentWall.wthickness
  !closeFlag          = !this.currentWall.closeFlag
  !minPanelWidth      = 10mm
  !halfThick          = !thickness / 2
  !panelThickness     = !this.panThick.val
  !wallJustification  = !this.wallJust.displayText()
  !rPathElement       = !this.currRPath[1].owner

  -- Set Wall Offsets
  if (!this.rad1.val) then
    !startAtCorner    = 'AFTER'
    !endAtCorner      = 'BEFORE'
  elseif (!this.rad2.val) then
    !startAtCorner    = 'AFTER'
    !endAtCorner      = 'AFTER'
  elseif (!this.rad3.val) then
    !startAtCorner    = 'BEFORE'
    !endAtCorner      = 'BEFORE'
  endif

    -- Preprocess points on the RPath to find wall centre line
    !leaveCentre     = ARRAY()
    !arriveCentre    = ARRAY()
    !leavePos        = ARRAY()
    !arrivePos       = ARRAY()
    !type            = ARRAY()
    !posRef          = ARRAY()
    !pathMembers     = !rPathElement.members
    if ( !closeFlag ) then
      !pathMembers.append(!pathMembers[1])
    endif
    -- get raw position data
    do !index indices !pathMembers

      !pathMember           = !pathMembers[!index]
      !type[!index]         = !pathMember.hardType
      !posRef[!index]       = !pathMember
      !arrivePos[!index]    = !pathMember.ppos[1]
      !arriveCentre[!index] = !pathMember.ppos[12].midPoint(!pathMember.ppos[13])
      !leavePos[!index]     = !pathMember.ppos[2]
      !leaveCentre[!index]  = !pathMember.ppos[22].midPoint(!pathMember.ppos[23])
      if( !type[!index] eq 'POINTR' ) then
        -- if P1 = P2 then there is no fillet arc
        if( !arrivePos[!index].distance(!leavePos[!index]) lt 1mm ) then
          -- no arc - start as requested by user
          !arrive[!index]   = !endAtCorner
          !leave[!index]    = !startAtCorner
        else
          -- arc found - start at start of straight
          !arrive[!index]   = 'ON'
          !leave[!index]    = 'ON'
        endif
      else
        -- curve
        !arrive[!index]     = 'ON'
        !leave[!index]      = 'ON'
        !arrive[!index - 1] = 'ON'
        !leave[!index - 1]  = 'ON'
      endif

    enddo


    !penultimatePoint     = !posRef.size() - 1
    !line = ARRAY()
    -- get lines representing mid-line the wall
    do !index from 1 to !penultimatePoint

      if( !type[!index] eq 'POINTR' and !type[!index + 1] eq 'POINTR'  ) then
        !line[!index]     = object LINE(!leaveCentre[!index], !arriveCentre[!index + 1])
        if( !line[!index].length() eq 0mm ) then
          !line[!index]   = object LINE()
        endif
      else
        !line[!index]     = object LINE()
      endif

    enddo

    -- allow for a closed wall
    if ( !closeFlag.not() ) then
      -- force the first panel to start ON the position
      !leave[1]                   = 'ON'
      !arrive[!arrive.maxIndex()] = 'ON'
    endif

    -- get centre line path of wall
    do !index from 2 to !line.size()
      -- Do not find intersection if starting on point
      skip if( !leave[!index] eq 'ON' )
      -- Do not find intersection for an arc
      skip if( !line[!index - 1].unset() or !line[!index].unset() )
      -- do not find intersection if walls are not orthogonal (assume corner joiner piece will be used)
      -- allow a small error on the angle
      if( abs(!line[!index - 1].direction().angle(!line[!index].direction()) - 90) gt 1.0 ) then
        !leave[!index]  = 'ON'
        !arrive[!index] = 'ON'
        skip
      endif
      !intersection = !line[!index - 1].intersection(!line[!index])
      handle any
        -- allow for co-linear edges - allow panels to butt
        !leave[!index]  = 'ON'
        !arrive[!index] = 'ON'
        skip
      endhandle
      !line[!index - 1].endPosition = !intersection
      !line[!index].startPosition   = !intersection
    enddo

    -- calculate start and end points for panel walls
    !walls = ARRAY()
    do !index from 1 to !line.size()
      if( !line[!index].unset() ) then
        !walls[!index] = !line[!index]
        skip
      endif
      if( !leave[!index] eq 'BEFORE' ) then
        !adjustStart = !panelThickness
      elseif( !leave[!index] eq 'AFTER' ) then
        !adjustStart = 0.0
      else
        !adjustStart = 0.0
      endif
      if( !arrive[!index + 1] eq 'BEFORE' ) then
        !adjustEnd = 0.0
      elseif( !arrive[!index + 1] eq 'AFTER' ) then
        !adjustEnd = !panelThickness
      else
        !adjustEnd = 0.0
      endif
      -- Shift start and end of wall line to new positions
      -- correct for justification of the panels
      if ( !index gt 1 ) then
         -- adjust for turning left or right
         if( !line[!index - 1].set() ) then
           !cross = !line[!index - 1].direction().cross(!line[!index].direction()).up
           if ( !wallJustification eq 'Right' ) then
              !cross = - !cross
           elseif ( !wallJustification eq 'Centre' ) then
              !cross = 0.0
           endif
           if ( !cross gt 0.95 ) then
	      -- turn left
              !adjustStart = !adjustStart - !halfThick
           elseif ( !cross lt -0.95 ) then
	      -- turn right
              !adjustStart = !adjustStart + !halfThick - !panelThickness
           elseif ( !cross eq 0.0 ) then
	      -- panel on centreline
              -- !adjustStart = !adjustStart - !halfThick + !panelThickness * 0.5
              !adjustStart = !adjustStart - !panelThickness * 0.5
           endif
         endif
      else
         -- adjust closed walls
         if ( !closeFlag ) then
            -- adjust for turning left or right
            if( !line[!line.size()].set() ) then
              !cross = !line[!line.size()].direction().cross(!line[!index].direction()).up
              if ( !wallJustification eq 'Right' ) then
                 !cross = - !cross
              elseif ( !wallJustification eq 'Centre' ) then
                 !cross = 0.0
              endif
              if ( !cross gt 0.95 ) then
	         -- turn left
                 !adjustStart = !adjustStart - !halfThick
              elseif ( !cross lt -0.95 ) then
	         -- turn right
                 !adjustStart = !adjustStart + !halfThick - !panelThickness
              elseif ( !cross eq 0.0 ) then
	         -- panel on centreline
                 !adjustStart = !adjustStart - !panelThickness * 0.5
              endif
            endif
         endif
      endif

      if ( !index lt !line.size() ) then
         -- adjust for turning left or right
         if( !line[!index + 1].set() ) then
           !cross = !line[!index].direction().cross(!line[!index + 1].direction()).up
           if ( !wallJustification eq 'Right' ) then
              !cross = - !cross
           elseif ( !wallJustification eq 'Centre' ) then
              !cross = 0.0
           endif
           if ( !cross gt 0.95 ) then
	      -- turn left
              !adjustEnd = !adjustEnd - !halfThick
           elseif ( !cross lt -0.95 ) then
	      -- turn right
              !adjustEnd = !adjustEnd + !halfThick - !panelThickness
           elseif ( !cross eq 0.0 ) then
	      -- panel on centreline
              --!adjustEnd = !adjustEnd - !halfThick + !panelThickness * 0.5
              !adjustEnd = !adjustEnd - !panelThickness * 0.5
           endif
         endif
      else
         -- adjust closed walls
         if ( !closeFlag ) then
            -- adjust for turning left or right
            if( !line[1].set() ) then
              !cross = !line[!index].direction().cross(!line[1].direction()).up
              if ( !wallJustification eq 'Right' ) then
                 !cross = - !cross
              elseif ( !wallJustification eq 'Centre' ) then
                 !cross = 0.0
              endif
              if ( !cross gt 0.95 ) then
	         -- turn left
                 !adjustEnd = !adjustEnd - !halfThick
              elseif ( !cross lt -0.95 ) then
	         -- turn right
                 !adjustEnd = !adjustEnd + !halfThick - !panelThickness
              elseif ( !cross eq 0.0 ) then
	         -- panel on centreline
                 --!adjustEnd = !adjustEnd - !halfThick + !panelThickness * 0.5
                 !adjustEnd = !adjustEnd - !panelThickness * 0.5
              endif
            endif
         endif
      endif
      !walls[!index] = !line[!index].extendStart(!adjustStart).extendEnd(!adjustEnd)

    enddo


    -- Define UNDO Information
    !this.undo  = object UNDOABLE()
    !this.undo.description('Created Wall Panel')
    !this.undo.add()

    -- Search for WLCOMP Group
    !collection       = object COLLECTION()
    !collection.scope(!this.currentWall)
    !collection.type('WLCOMP')

    -- If group exists, add panels to that group
    if (!collection.results().size() ne 0) then
      !wallCompGroup = !collection.results()[1]
      !!ce = !wallCompGroup
    else
    -- If group doesn't exist, create new group
      NEW WLCOMP
      !wallCompGroup = !!ce
    endif

    -- place the panes along the wall
    do !index indices !walls

      !wall = !walls[!index]
      -- skip curves
      if(!wall.unset()) then
        skip if( !type[!index] neq 'CURVE' )
        -- handle curves
        !curve      = !posRef[!index]
        !start      = !curve.ppos[1].wrt( /* )
        !thru       = !curve.ppos[7].wrt( /* )
        !end        = !curve.ppos[2].wrt( /* )
        !plane      = !start.plane(!thru, !end)
        !dir        = !plane.pointVector().direction
        !arc        = !start.arcThru(!thru,!end,!dir)
        !wallLength = !arc.length()
        !numFullPanels = int( !wallLength / !panWidth )
        !remainder     = !wallLength - !panWidth * !numFullPanels
        if( !remainder lt !minPanelWidth ) then
          !remainder   = 0
        endif

        -- add the full panels
        do !indexFullPanel from 1 to !numFullPanels

          -- find the ZDIST of the wall panel centre
          if(!this.panelDir1.val.eq(2)) then
          	!zdistance  = !wallLength - ( !panWidth * ( !indexFullPanel - 0.5 ))
          else
          !zdistance  = !panWidth * ( !indexFullPanel - 0.5 )
          endif
           NEW WLPANE
          !element = !!ce
          !element.spref       = !this.panSPREF.val.dbref()
          -- Set element position
          !element.zdistance   = !zdistance
          !element.posRef      = !posRef[!index - 1]
          !element.wJusLine    = !wallJustification

          -- Set vertical offset of panel
          !parameter3 = 0
          if (!this.panHeight.val.set()) then
            !element.vdistance = !this.panHeight.val
          else
            !element.vdistance = 0
          endif

          !panelTop          = !element.vdistance + !element.cpar[1]
          if (!panelTop gt !this.currentWall.height) then
            !parameter3 = !panelTop - !this.currentWall.height
          endif

          !element.desparam[1] = 0
          !element.desparam[2] = 0
          !element.desparam[3] = !parameter3

        enddo

        if( !remainder gt 0 ) then

          -- find the ZDIST of the wall panel centre
          if(!this.panelDir1.val.eq(2)) then
          	!zdistance  = !wallLength - ( !panWidth * !numFullPanels ) - ( !remainder * 0.5)
          else
          !zdistance  = !panWidth * !numFullPanels + !remainder * 0.5
          endif


          NEW WLPANE
          !element = !!ce
          !element.spref       = !this.panSPREF.val.dbref()
          -- Set element position
          !element.zdistance   = !zdistance
          !element.posRef      = !posRef[!index - 1]
          !element.wJusLine    = !wallJustification

          -- Set vertical offset of panel
          !parameter3 = 0
          if (!this.panHeight.val.set()) then
            !element.vdistance = !this.panHeight.val
          else
            !element.vdistance = 0
          endif

          !panelTop          = !element.vdistance + !element.cpar[1]
          if (!panelTop gt !this.currentWall.height) then
            !parameter3 = !panelTop - !this.currentWall.height
          endif

          -- Set the desparam according to the justification of the panel
          !element.desparam[1] = ( !panWidth - !remainder ) / 2
          !element.desparam[2] = ( !panWidth - !remainder ) / 2
          !element.desparam[3] = !parameter3

        endif

        skip

      endif

      -- calculate number of full panels required and any remaining cut panel
      !wallLength    = !wall.length()
      !numFullPanels = int( !wallLength / !panWidth )
      !remainder     = !wallLength - !panWidth * !numFullPanels
      if( !remainder lt !minPanelWidth ) then
        !remainder   = 0
      endif

      -- map POSREF position onto the wall for ZDIST calculation
      if (!this.panelDir1.val.eq(1)) then
      !wallVector    = object POINTVECTOR( !wall.startPosition, !wall.direction() )
      else
       !wallVector    = object POINTVECTOR( !wall.endPosition, !wall.direction().opposite() )
      endif
      !posRefVector  = object POINTVECTOR( !wall.near(!posRef[!index].position), !wall.direction() )

      -- add the full panels
      do !indexFullPanel from 1 to !numFullPanels

        -- find the ZDIST of the wall panel centre
        !wallPanelOffset  = !panWidth * ( !indexFullPanel - 0.5 )
        !wallOffsetVector = !wallVector.offset(!wallPanelOffset)
        !zdistance        = !posRefVector.position.distance(!wallOffsetVector.position)

        NEW WLPANE
        !element = !!ce

        -- Name element
--        if(!element.isNamed) then
--          call !!autoNameCe(FALSE)
--        endif

        !element.spref       = !this.panSPREF.val.dbref()
        -- Set element position
        !element.zdistance   = !zdistance
        !element.posRef      = !posRef[!index]
        !element.wJusLine    = !wallJustification

        -- Set vertical offset of panel
        !parameter3 = 0
        if (!this.panHeight.val.set()) then
          !element.vdistance = !this.panHeight.val
        else
          !element.vdistance = 0
        endif

        !panelTop          = !element.vdistance + !element.cpar[1]
        if (!panelTop gt !this.currentWall.height) then
          !parameter3 = !panelTop - !this.currentWall.height
        endif

        !element.desparam[1] = 0
        !element.desparam[2] = 0
        !element.desparam[3] = !parameter3

      enddo

      if( !remainder gt 0 ) then

        -- find the ZDIST of the wall panel centre
        !wallPanelOffset  = !panWidth * !numFullPanels + !remainder * 0.5
        !wallOffsetVector = !wallVector.offset(!wallPanelOffset)
        !zdistance        = !posRefVector.position.distance(!wallOffsetVector.position)

        NEW WLPANE
        !element = !!ce

        -- Name element
--        if(!element.isNamed) then
--          call !!autoNameCe(FALSE)
--        endif

        !element.spref       = !this.panSPREF.val.dbref()
        -- Set element position
        !element.zdistance   = !zdistance
        !element.posRef      = !posRef[!index]
        !element.wJusLine    = !wallJustification

        -- Set vertical offset of panel
        !parameter3 = 0
        if (!this.panHeight.val.set()) then
          !element.vdistance = !this.panHeight.val
        else
          !element.vdistance = 0
        endif

        !panelTop          = !element.vdistance + !element.cpar[1]
        if (!panelTop gt !this.currentWall.height) then
          !parameter3 = !panelTop - !this.currentWall.height
        endif

        -- Set the desparam according to the justification of the panel
        !element.desparam[1] = ( !panWidth - !remainder ) / 2
        !element.desparam[2] = ( !panWidth - !remainder ) / 2
        !element.desparam[3] = !parameter3

      endif

    enddo

  !this.undo.endUndoable()

  !!ce = !this.currentWall

  REM CE
  ADD CE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      panelAround
--
-- Description: Panels from either side of a wall opening
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .panelAround()

  if (!this.panSPREF.val.eq('') or !this.panSPREF.val.unset()) then
    !!alert.error('Wall panel not selected')
    return
  endif

  !closeFlag          = !this.currentWall.closeFlag
  !thickness          = !this.currentWall.wthickness
  !minPanelWidth      = 10mm
  !halfThick          = !thickness / 2
  !rPathElement       = !this.currRPath[1].owner

  -- Set Wall Offsets (Wall connection options)
  if (!this.rad1.val) then
   !startAtCorner    = 'AFTER'
   !endAtCorner      = 'BEFORE'
  elseif (!this.rad2.val) then
   !startAtCorner    = 'AFTER'
   !endAtCorner      = 'AFTER'
  elseif (!this.rad3.val) then
   !startAtCorner    = 'BEFORE'
   !endAtCorner      = 'BEFORE'
  endif

  -- Preprocess points on the RPath to find wall centre line
  !leaveCentre     = ARRAY()
  !arriveCentre    = ARRAY()
  !leavePos        = ARRAY()
  !arrivePos       = ARRAY()
  !type            = ARRAY()
  !pathMembers     = !rPathElement.members
  -- get raw position data
  do !index indices !pathMembers

    !pathMember           = !pathMembers[!index]
    !type[!index]         = !pathMember.hardType
    !arrivePos[!index]    = !pathMember.ppos[1]
    !arriveCentre[!index] = !pathMember.ppos[12].midPoint(!pathMember.ppos[13])
    !leavePos[!index]     = !pathMember.ppos[2]
    !leaveCentre[!index]  = !pathMember.ppos[22].midPoint(!pathMember.ppos[23])
    if( !type[!index] eq 'POINTR' ) then
      -- if P1 = P2 then there is no fillet arc
      if( !arrivePos[!index].distance(!leavePos[!index]) lt 1mm ) then
        -- no arc - start as requested by user
        !arrive[!index]   = !endAtCorner
        !leave[!index]    = !startAtCorner
      else
        -- arc found - start at start of straight
        !arrive[!index]   = 'ON'
        !leave[!index]    = 'ON'
      endif
    else
      -- curve
      !arrive[!index]     = 'ON'
      !leave[!index]      = 'ON'
      !arrive[!index - 1] = 'ON'
      !leave[!index - 1]  = 'ON'
    endif

    if (!this.currentFeature.set()) then
      if (!pathMember eq !this.currentFeature.owner.posRef) then
        !wantedIndex = !index
      endif
    else
      if (!pathMember eq !this.wallPoint.selection().dbref()) then
        !wantedIndex = !index
      endif
    endif

  enddo

  -- force the first panel to start ON the position
  !leave[1]                   = 'ON'
  !arrive[!arrive.maxIndex()] = 'ON'

  !penultimatePoint     = !pathMembers.size() - 1
  -- handle closed walls
  if ( !closeFlag ) then
    !penultimatePoint     = !pathMembers.size()
  endif
  !wLine = ARRAY()
  -- get lines representing the mid-line of the wall
  do !index from 1 to !penultimatePoint
    !lastPoint = !index + 1
    if ( !index eq  !penultimatePoint and !closeFlag ) then
      !lastPoint = 1
    endif
    if( !type[!index] eq 'POINTR' and !type[!lastPoint] eq 'POINTR'  ) then
      !wLine[!index]     = object LINE(!leaveCentre[!index], !arriveCentre[!lastPoint])
    else
      !wLine[!index]     = object LINE()
    endif
  enddo

  -- get centre line path of wall
  do !index from 2 to !wLine.size()
    -- Do not find intersection if starting on point
    skip if( !leave[!index] eq 'ON' )
    -- Do not find intersection for an arc
    skip if( !wLine[!index - 1].unset() or !wLine[!index].unset() )
    -- do not find intersection if walls are not orthogonal (assume corner joiner piece will be used)
    -- allow a small error on the angle
    if( abs(!wLine[!index - 1].direction().angle(!wLine[!index].direction()) - 90) gt 1.0 ) then
      !leave[!index]  = 'ON'
      !arrive[!index] = 'ON'
      skip
    endif
    !intersection = !wLine[!index - 1].intersection(!wLine[!index])
    handle any
      -- allow for co-linear edges - allow panels to butt
      !leave[!index]  = 'ON'
      !arrive[!index] = 'ON'
      skip
    endhandle
    !wLine[!index - 1].endPosition = !intersection
    !wLine[!index].startPosition   = !intersection
  enddo

  -- calculate start and end points for panel walls
  !walls = ARRAY()
  do !index from 1 to !wLine.size()
    if( !wLine[!index].unset() ) then
      !walls[!index] = !wLine[!index]
      skip
    endif
    if( !leave[!index] eq 'BEFORE' ) then
      !adjustStart = !halfThick
    elseif( !leave[!index] eq 'AFTER' ) then
      !adjustStart = -1 * !halfThick
    else
      !adjustStart = 0.0
    endif
    !lastPoint = !index + 1
    if ( !index eq  !wLine.size() and !closeFlag ) then
      !lastPoint = 1
    endif
    if( !arrive[!lastPoint] eq 'BEFORE' ) then
      !adjustEnd = -1 * !halfThick
    elseif( !arrive[!lastPoint] eq 'AFTER' ) then
      !adjustEnd = !halfThick
    else
      !adjustEnd = 0.0
    endif
    -- Shift start and end of wall line to new positions
    !currWallLine = !wLine[!index].extendStart(!adjustStart).extendEnd(!adjustEnd)
    handle ANY
    endhandle
    break if (!index eq !wantedIndex)
  enddo

    -- Define UNDO Information
  !this.undo  = object UNDOABLE()
  !this.undo.description('Created Wall Panel')
  !this.undo.add()
  !wallJustification = !this.wallJust.displayText()

  !!ce = !this.currentWall
  -- Search for WLCOMP Group
  !collection       = object COLLECTION()
  !collection.scope(!this.currentWall)
  !collection.type('WLCOMP')

  -- If group exists, add panels to that group
  if (!collection.results().size() ne 0) then
    !wallCompGroup = !collection.results()[1]
    !!ce = !wallCompGroup
  else
  -- If group doesn't exist, create new group
    NEW WLCOMP
    !wallCompGroup = !!ce
  endif

  if(!this.panelStartElement.type.eq('POINTR') and !this.panelEndElement.type.eq('POINTR') ) then
    !posRef = !this.wallPoint.selection().dbref()
    !!ce = !posRef
    NEXT
    handle ANY
      FIRST
    endhandle
    if (!!ce.fulltype eq 'CURVE') then
      !curved = TRUE
      !curve = !!ce
    else
      !curved = FALSE
    endif

    !!ce  = !wallCompGroup
    if (not !curved) then
      !this.panelStraightWallSegment(!this.panWidth.val, !posRef, !currWallLine, 'CORNER', 'CORNER', 10mm)
    elseif (!curved ) then
      if(!this.panelStartElement.seq lt !this.panelEndElement.seq) then
        !layout = 'START'
      else
        !layout = 'END'
      endif

      !this.panelArcWallSegment(!this.panWidth.val, !posRef, !curve, !layout, 10mm)
    endif

  -- panel from POINTR to door
  elseif(!this.panelStartElement.type.eq('POINTR') and !this.panelEndElement.type.eq('DOOR') ) then
    if(!this.panelStartElement eq !this.panelEndElement.owner.posRef) then
      !doorPosition = !this.getDoorBox(!this.panelEndElement, !currWallLine)[3].position()
      !line = object LINE(!currWallLine.startPosition, !doorPosition )
    else
      !doorPosition = !this.getDoorBox(!this.panelEndElement, !currWallLine)[4].position()
      !line = object LINE(!currWallLine.endPosition, !doorPosition)
    endif

    !this.panelStraightWallSegment(!this.panWidth.val, !this.panelStartElement, !line, 'CORNER', 'DOOR', 10mm)

  -- panel from door to POINTR
  elseif(!this.panelStartElement.type.eq('DOOR') and !this.panelEndElement.type.eq('POINTR') ) then
    if(!this.panelEndElement eq !this.panelStartElement.owner.posRef) then
      !doorPosition = !this.getDoorBox(!this.panelStartElement, !currWallLine)[3].position()
      !line = object LINE(!doorPosition, !currWallLine.startPosition )
    else
      !doorPosition = !this.getDoorBox(!this.panelStartElement, !currWallLine)[4].position()
      !line = object LINE(!doorPosition,!currWallLine.endPosition)
    endif

    !this.panelStraightWallSegment(!this.panWidth.val, !this.panelEndElement, !line, 'DOOR', 'CORNER', 10mm)

  -- panel from door to door
  elseif(!this.panelStartElement.type.eq('DOOR') and !this.panelEndElement.type.eq('DOOR') ) then
    if(!this.panelStartElement.owner.zdist lt !this.panelEndElement.owner.zdist) then
      !startPosition = !this.getDoorBox(!this.panelStartElement, !currWallLine)[4].position()
      !endPosition   = !this.getDoorBox(!this.panelEndElement,   !currWallLine)[3].position()
    else
      !startPosition = !this.getDoorBox(!this.panelStartElement,   !currWallLine)[3].position()
      !endPosition   = !this.getDoorBox(!this.panelEndElement, !currWallLine)[4].position()
    endif

    !doorLine = object LINE(!startPosition, !endPosition )
    !this.panelStraightWallSegment(!this.panWidth.val, !this.panelEndElement.owner.posRef, !doorLine, 'DOOR', 'DOOR', 10mm)

  endif

  !this.undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getDoorBox
--
-- Description: Retrieve the extremities of a given door
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       DBREF     Given Door
--    2    R       LINE      Wall Line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getDoorBox(!door is DBREF, !line is LINE) is ARRAY

  -- Get extremities of door
  !wallProfile = object COMPATH(!this.currentWall)
  !localVolume = object LOCALVOLUME(!door,!door)
  !edgeFrom = !wallProfile.edgeRefPosition(!localVolume.from)
  !edgeTo   = !wallProfile.edgeRefPosition(!localVolume.to)

  if( !edgeFrom[2] gt !edgeTo[2] ) then
  -- swap order if door defined in opposite direction to wall (by comparing z distances)
    !localFrom = !localVolume.to
    !localTo   = !localVolume.from
  else
    !localTo   = !localVolume.to
    !localFrom = !localVolume.from
  endif


  -- map to and from onto wall line
  !mapFrom = !line.near(!localFrom)
  !mapTo   = !line.near(!localTo)

  !doorCentLine = !line.overlap(object LINE(!mapFrom, !mapTo))

  !posRef = !door.owner.posRef
  !posRefVector  = object POINTVECTOR( !line.near(!posRef.position), !line.direction())

  !startDist = !posRefVector.position.distance(!doorCentLine.startPosition)
  !endDist   = !posRefVector.position.distance(!doorCentLine.endPosition)

  !distances = ARRAY()
  !distances.append(!startDist.string())
  !distances.append(!endDist.string())
  !distances.append(!doorCentLine.startPosition.string())
  !distances.append(!doorCentLine.endPosition.string())

  return !distances

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      panelArcWallSegment
--
-- Description: Create panel detail for a curved wall segment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .panelArcWallSegment(!panWidth is REAL, !posRef is DBREF, !curve is DBREF, !layout is STRING, !minPanelWidth is REAL)

  -- calculate number of full panels required and any remaining cut panel
  -- handle curves
  !start      = !curve.ppos[1].wrt( /* )
  !end        = !curve.ppos[2].wrt( /* )
  !thru       = !curve.ppos[7].wrt( /* )

  !plane      = !start.plane(!thru, !end)
  !dir        = !plane.pointVector().direction
  !arc        = !start.arcThru(!thru,!end,!dir)
  !wallLength = !arc.length()

  !numFullPanels = int( !wallLength / !panWidth )
  !remainder     = !wallLength - ( !panWidth * !numFullPanels )
  if( !remainder lt !minPanelWidth ) then
    !remainder   = 0
  endif
  !wallJustification  = !this.wallJust.displayText()

  if( !numFullPanels eq 0 and !remainder  eq 0 ) then
    return
  endif

    -- add the full panels
    do !indexFullPanel from 1 to !numFullPanels

      -- find the ZDIST of the wall panel centre
      if(!layout.eq('START')) then
        !zdistance  = !panWidth * ( !indexFullPanel - 0.5 )
      elseif(!layout.eq('END')) then
        !zdistance  = !wallLength - ( !panWidth * ( !indexFullPanel - 0.5 ) )
      endif

       NEW WLPANE
      !element = !!ce

      !element.spref       = !this.panSPREF.val.dbref()
      -- Set element position
      !element.zdistance   = !zdistance
      !element.posRef      = !posRef
      !element.wJusLine    = !wallJustification

      -- Set vertical offset of panel
      !parameter3 = 0
      if (!this.panHeight.val.set()) then
        !element.vdistance = !this.panHeight.val
      else
        !element.vdistance = 0
      endif

      !panelTop          = !element.vdistance + !element.cpar[1]
      if (!panelTop gt !this.currentWall.height) then
        !parameter3 = !panelTop - !this.currentWall.height
      endif

      !element.desparam[1] = 0
      !element.desparam[2] = 0
      !element.desparam[3] = !parameter3

    enddo

    if( !remainder gt 0 ) then

      -- find the ZDIST of the wall panel centre
      if(!layout.eq('START')) then
        !zdistance  = ( !panWidth * !numFullPanels ) + ( !remainder * 0.5 )
      elseif(!layout.eq('END')) then
        !zdistance  = !wallLength - ( !panWidth * !numFullPanels ) - ( !remainder * 0.5 )
      endif

      NEW WLPANE
      !element = !!ce

      !element.spref       = !this.panSPREF.val.dbref()
      -- Set element position
      !element.zdistance   = !zdistance
      !element.posRef      = !posRef
      !element.wJusLine    = !wallJustification

      -- Set vertical offset of panel
      !parameter3 = 0
      if (!this.panHeight.val.set()) then
        !element.vdistance = !this.panHeight.val
      else
        !element.vdistance = 0
      endif

      !panelTop          = !element.vdistance + !element.cpar[1]
      if (!panelTop gt !this.currentWall.height) then
        !parameter3 = !panelTop - !this.currentWall.height
      endif

      -- Set the desparam according to the justification of the panel
      !element.desparam[1] = ( !panWidth - !remainder ) / 2
      !element.desparam[2] = ( !panWidth - !remainder ) / 2
      !element.desparam[3] = !parameter3

    endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      panelStraightWallSegment
--
-- Description: Create panel detail for a straight wall segment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .panelStraightWallSegment(!panWidth is REAL, !posRef is DBREF, !wallSegment is LINE, !startCode is STRING, !endCode is STRING, !minPanelWidth is REAL)

  -- calculate number of full panels required and any remaining cut panel
  !wallLength    = !wallSegment.length()
  !numFullPanels = int( !wallLength / !panWidth )
  !remainder     = !wallLength - (!panWidth * !numFullPanels)
  if( !remainder lt !minPanelWidth ) then
    !remainder   = 0
  endif
  !wallJustification = !this.wallJust.displayText()

  if( !numFullPanels eq 0 and !remainder  eq 0 ) then
    return
  endif

  !backwards = false

  -- both the corners are route points (POINTR)
  if( !startCode eq 'CORNER' and !endCode eq 'CORNER' ) then
    if(!posRef eq !this.panelEndElement ) then
      -- panel wall end to start
      !wallVector    = object POINTVECTOR( !wallSegment.endPosition, !wallSegment.direction().opposite() )
      !backwards = true
    else
      !wallVector    = object POINTVECTOR( !wallSegment.startPosition, !wallSegment.direction() )
    endif

  -- start from POINTR and end in door
  elseif( !startCode eq 'CORNER' and !endCode eq 'DOOR' ) then
    if(!posRef eq !this.panelEndElement.owner.posRef) then
      !backwards  = false
    else
      !posRef = !this.panelEndElement.owner.posRef
      !backwards  = true
    endif

    !wallVector    = object POINTVECTOR( !wallSegment.startPosition, !wallSegment.direction() )

  -- start from door and end in POINTR
  elseif( !startCode eq 'DOOR' and !endCode eq 'CORNER' ) then
    if(!posRef eq !this.panelStartElement.owner.posRef) then
      !backwards  = true
    else
      !posRef = !this.panelStartElement.owner.posRef
      !backwards  = false
    endif

    !wallVector    = object POINTVECTOR( !wallSegment.startPosition, !wallSegment.direction() )

  -- start from door and end in door
  elseif( !startCode eq 'DOOR' and !endCode eq 'DOOR' ) then
    if(!this.panelStartElement.owner.zdist lt !this.panelEndElement.owner.zdist) then
      !backwards  = false
    else
      !backwards  = true
    endif

    !wallVector    = object POINTVECTOR( !wallSegment.startPosition, !wallSegment.direction() )

  endif

  --!posRefVector  = object POINTVECTOR( !wallSegment.near(!posRef.position), !wallSegment.direction() )
  !posRefVector  = object POINTVECTOR( !wallSegment.near(!posRef.position), !wallSegment.direction() )

  -- add the full panels
  do !indexFullPanel from 1 to !numFullPanels

    -- find the ZDIST of the wall panel centre
    !wallPanelOffset  = !panWidth * ( !indexFullPanel - 0.5 )
    !wallOffsetVector = !wallVector.offset(!wallPanelOffset)
    !zdistance        = !posRefVector.position.distance(!wallOffsetVector.position)

    NEW WLPANE
    !element = !!ce

    !element.spref       = !this.panSPREF.val.dbref()
    -- Set element position
    !element.zdistance   = !zdistance
    !element.posRef      = !posRef
    !element.wJusLine    = !wallJustification

    -- Set vertical offset of panel
    !parameter3 = 0
    if (!this.panHeight.val.set()) then
      !element.vdistance = !this.panHeight.val
    else
        !element.vdistance = 0
    endif
    !panelTop          = !element.vdistance + !element.cpar[1]
    if (!panelTop gt !this.currentWall.height) then
      !parameter3 = !panelTop - !this.currentWall.height
    endif

    !element.desparam[1] = 0
    !element.desparam[2] = 0
    !element.desparam[3] = !parameter3

  enddo

  if( !remainder gt 0 ) then

    -- find the ZDIST of the wall panel centre
    !wallPanelOffset  = !panWidth * !numFullPanels
    !wallOffsetVector = !wallVector.offset(!wallPanelOffset)
    !zdistance        = !posRefVector.position.distance(!wallOffsetVector.position)

    !prevElement = !!ce
    !!ce = !posRef
    NEXT
    handle ANY
      !pointPosition = !wallSegment.endPosition
      !nextPointDist = !posRefVector.position.distance(!pointPosition)
    elsehandle NONE
      !nextPoint = !!ce
      !pointPosition = !wallSegment.near(!nextPoint.position)
      !nextPointDist = !posRefVector.position.distance(!pointPosition)
    endhandle

    !!ce = !prevElement
    NEW WLPANE
    !element = !!ce

    if (!backwards) then
      !newDistance = !zdistance - (!remainder / 2)
      if (!newDistance lt 0) then
        !distOff = !newDistance * -1
        if (!wallJustification eq 'RIGH') then
          !element.desparam[1] = (!panWidth - !remainder) / 2 - !distOff
          !element.desparam[2] = (!panWidth - !remainder) / 2 + !distOff
        else
          !element.desparam[1] = (!panWidth - !remainder) / 2 + !distOff
          !element.desparam[2] = (!panWidth - !remainder) / 2 - !distOff
        endif
        !zdistance = 0
      else
        !zdistance = !newDistance
        !element.desparam[1] = (!panWidth - !remainder) / 2
        !element.desparam[2] = (!panWidth - !remainder) / 2
      endif
    else
      !newDistance = !zdistance + (!remainder / 2)
      if (!newDistance gt !nextPointDist) then
        !distOff = !newDistance - !nextPointDist
        if (!wallJustification eq 'RIGH') then
          !element.desparam[1] = (!panWidth - !remainder) / 2 + !distOff
          !element.desparam[2] = (!panWidth - !remainder) / 2 - !distOff
        else
          !element.desparam[1] = (!panWidth - !remainder) / 2 - !distOff
          !element.desparam[2] = (!panWidth - !remainder) / 2 + !distOff
        endif
        !zdistance = !nextPointDist
      else
        !zdistance = !newDistance
        !element.desparam[1] = (!panWidth - !remainder) / 2
        !element.desparam[2] = (!panWidth - !remainder) / 2
      endif
    endif

    !element.spref       = !this.panSPREF.val.dbref()
    -- Set element position
    !element.zdistance   = !zdistance
    !element.posRef      = !posRef
    !element.wJusLine    = !wallJustification

    -- Set vertical offset of panel
    !parameter3 = 0
    if (!this.panHeight.val.set()) then
      !element.vdistance = !this.panHeight.val
    else
        !element.vdistance = 0
    endif

    !panelTop          = !element.vdistance + !element.cpar[1]
    if (!panelTop gt !this.currentWall.height) then
      !parameter3 = !panelTop - !this.currentWall.height
    endif


    -- Set the desparam according to the justification of the panel
    !element.desparam[3] = !parameter3

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyDetail
--
-- Description: Updates the current details attributes to DB
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyDetail(!gadget is GADGET, !dummyString is STRING)

  if (!gadget eq !this.joiAccept) then

     -- Define UNDO Information
     !this.undo = object UNDOABLE()

     !this.undo.description( !this.joinCurDet.val )
     !this.undo.add()

     do !i from 1 to !this.selectionArray.size()
       !this.currentDetail = !this.selectionArray[!i]
       skip if (!this.currentDetail.fulltype neq 'WLJOIN')
       -- zdist is not modified for multiple selections
       if ( !this.selectionArray.size() eq 1 ) then

         !this.currentDetail.zdist   = !this.joinerDistance
       endif
       handle (2,795)
         !this.tidy()
         !this.updateWallList()
         !this.getDetails()
         !this.detailTasks(TRUE)
         return FALSE
       endhandle
       !this.currentDetail.sdist       = !this.modJStartHeight.val
       !this.currentDetail.edist       = !this.modJEndHeight.val
       !this.currentDetail.jusLine     = !this.modJoinerJustLine.val
       !this.currentDetail.wJusLine    = !this.modJoinerWallJustLine.selection()
       !this.currentDetail.spre        = !this.modJoinerSpec.val.dbref()
     enddo

  elseif (!gadget eq !this.panAccept) then

     -- Define UNDO Information
     !this.undo = object UNDOABLE()

     !this.undo.description( !this.panCurDet.val )
     !this.undo.add()

     do !i from 1 to !this.selectionArray.size()
       !this.currentDetail = !this.selectionArray[!i]
       skip if (!this.currentDetail.fulltype neq 'WLPANEL')
       !this.currentDetail.spre        = !this.panModSPREF.val.dbref()
       !this.currentDetail.description = !this.panModDesc.val
       handle (2,795)
         !this.tidy()
         !this.updateWallList()
         !this.getDetails()
         !this.detailTasks(TRUE)
         return FALSE
       endhandle
       -- zdist is not modified for multiple selections
       if ( !this.selectionArray.size() eq 1 ) then
          !this.currentDetail.zdistance   = !this.panModDist.val
       endif
       if (!this.panModHeight.val.set()) then
         !this.currentDetail.vdistance = !this.panModHeight.val
       endif

       -- Set the desparam according to the justification of the panel
       if ( !this.selectionArray.size() eq 1 ) then
       if (!this.currentDetail.wJusLine eq 'RIGH' OR !this.currentDetail.wJusLine eq 'CENT') then
          !this.currentDetail.desparam[2] = !this.panLeadCut.val
          handle (2,795)
            !this.tidy()
            !this.updateWallList()
            !this.getDetails()
            !this.detailTasks(TRUE)
            return FALSE
          endhandle
          !this.currentDetail.desparam[1] = !this.panRearCut.val
       elseif (!this.currentDetail.wJusLine eq 'LEFT') then
          !this.currentDetail.desparam[1] = !this.panLeadCut.val
          handle (2,795)
            !this.tidy()
            !this.updateWallList()
            !this.getDetails()
            !this.detailTasks(TRUE)
            return FALSE
          endhandle
          !this.currentDetail.desparam[2] = !this.panRearCut.val
       elseif (!this.currentDetail.wJusLine eq 'CENT') then
         !this.currentDetail.desparam[1] = !this.panLeadCut.val
         handle (2,795)
           !this.tidy()
           !this.updateWallList()
           !this.getDetails()
           !this.detailTasks(TRUE)
         endhandle
         !this.currentDetail.desparam[2] = !this.panRearCut.val
       endif
       endif

       if (!this.panTopCut.val.set()) then
         !this.currentDetail.desparam[3] = !this.panTopCut.val
       endif

       !this.updateGadgets('Panel')
     enddo

  elseif (!gadget eq !this.proAccept) then

     -- Define UNDO Information
     !this.undo = object UNDOABLE()

     !this.undo.description( !this.proCurDet.val )
     !this.undo.add()

     do !i from 1 to !this.selectionArray.size()
       !this.currentDetail = !this.selectionArray[!i]
       skip if (!this.currentDetail.fulltype neq 'WLPROF')
       !this.currentDetail.spref       = !this.modProfileSpec.val.dbref()
       !this.currentDetail.jusLine     = !this.modProfileJustLine.val
       -- zdist is not modified for multiple selections
       if ( !this.selectionArray.size() eq 1 ) then
          !this.currentDetail.szdistance  = !this.modProfileStartDist.val
          !this.currentDetail.ezdistance  = !this.modProfileEndDist.val
       endif
       !this.currentDetail.zOffset     = !this.modProfileHeight.val
       !this.currentDetail.wJusLine    = !this.modProfileWallJustLine.selection()
     enddo

  endif

  !this.undo.endUndoable()

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Load for with passed ceiling grid element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Ceiling grid to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid element
--
------------------------------------------------------------------------

define method .modify(!passedElement is DBREF) is BOOLEAN

  -- Initialise Variables
  !this.selectionArray[1] = !passedElement
  !this.setDetail(!this.pickDetail, 'DUMMY' )

  if(!this.selectionArray[1].set()) then
    !this.currentWall = !this.selectionArray[1].owner.owner
    !this.getRPath(!this.currentWall)
  endif

  -- Switch to appropriate modify pane
  if (!passedElement.fulltype eq 'WLJOIN') then
    !this.modJoiners(TRUE)
  elseif (!passedElement.fulltype eq 'WLPANEL') then
    !this.modPanel(TRUE)
  elseif (!passedElement.fulltype eq 'WLPROF') then
    !this.modProfile(TRUE)
  endif

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteDetail
--
-- Description: Delete the current detail
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteDetail()

  -- Delete current element
  do !i from 1 to !this.selectionArray.size()
    !this.currentDetail = !this.selectionArray[!i]
    if(!!accDeleteManager.deleteElement(!this.currentDetail).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
    endif
  enddo

  !this.deleteDet.active = FALSE
  !this.getDetails()

endmethod

------------------------------------------------------------------------
--
-- Method:      deletePanels
--
-- Description: Delete all the panels on the current wall
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deletePanels()

  !!ce = !this.currentWall

  !panelCollect = object COLLECTION()
  !panelCollect.addType('WLCOMP')
  !panelCollect.scope(!!ce)
  !compList    = !panelCollect.results()

 -- If there are no panel elements - no nothing
  if(!compList.empty().not()) then
    if(!!accDeleteManager.deleteElement(!compList.first()).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
      !this.tidy()
    endif
  endif

  !this.getDetails()
  !!ce = !this.currentWall

  REM CE
  ADD CE


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteProfiles
--
-- Description: Delete all the profiles on the current wall
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteProfiles()

  !!ce = !this.currentWall

  !panelCollect = object COLLECTION()
  !panelCollect.addType('WLPRSE')
  !panelCollect.scope(!!ce)
  !compList    = !panelCollect.results()

 -- If there are no profile elements - no nothing
  if(!compList.empty().not()) then
    if(!!accDeleteManager.deleteElement(!compList.first()).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
      !this.tidy()
    endif
  endif

  !this.getDetails()
  !!ce = !this.currentWall

  REM CE
  ADD CE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteJoiners
--
-- Description: Delete all the joiners on the current wall
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteJoiners()

  !!ce = !this.currentWall

  !panelCollect = object COLLECTION()
  !panelCollect.addType('WLJNTS')
  !panelCollect.scope(!!ce)
  !compList    = !panelCollect.results()


 -- If there are no joint elements - no nothing
  if(!compList.empty().not()) then
    if(!!accDeleteManager.deleteElement(!compList.first()).not()) then
      !!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
      !this.tidy()
    endif
  endif

  !this.getDetails()

  !!ce = !this.currentWall

  REM CE
  ADD CE

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      drawJoiners
--
-- Description: Draws aid graphics for each of the joiners to be created
--              along a given line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawJoiners()

  !this.tidy()

  !spacing      = !this.jSpacing.val
  !startHeight  = !this.jStartHeight.val
  !endHeight    = !this.jEndHeight.val

  -- Loop through wall rPath
  do !i from 1 to !this.currRPath.size() - 1

    !startPoint = !this.currRPath[!i]
    !endPoint   = !this.currRPath[!i + 1]

    !startPointPos   = !startPoint.position
    !endPointPos     = !endPoint.position

    !length     = !startPointPos.distance(!endPointPos)
    skip if( !length eq 0mm )
    !direction  = !startPointPos.direction(!endPointPos)

    !joinerStartPos = !startPointPos.offset(up, !startHeight)
    !joinerEndPos   = !startPointPos.offset(up, !endHeight)

    !joinerLine = object LINE(!joinerStartPos, !joinerEndPos)

    !lineCount  = 1

    -- Draw aid graphics for joiners along current section line
    do

      break if ( !spacing * !lineCount ge !length )

      !joinerLine = !joinerLine.offset(!direction,!spacing)
      !joinerLine.draw(!this.aidNumber,1,3)

      !lineCount  = !lineCount + 1

    enddo
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawSingleJoiner
--
-- Description: Draws an aid line representing a single Wall Joiner
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawSingleJoiner()


 !this.tidy()

  !dist         = !this.joinerDistance
  !numPoints    = !this.joinPoint.dtext.size()
  !selectedVal  = !this.joinPoint.val

  if (!this.currentWall.closeFlag eq true) then

    if (!selectedVal eq !numPoints ) then
     if (!dist gt 0 ) then
       !nextVal  = 1
     else
       !nextVal   = !selectedVal - 1
       !dist = - !dist
     endif

    elseif (!selectedVal eq 1) then
          if (!dist lt 0 ) then
            !nextVal   = !numPoints
            !dist = - !dist
          else
            !nextVal  = !selectedVal + 1
          endif

        else
          if (!dist gt 0 ) then
            !nextVal  = !selectedVal + 1
          else
            !nextVal   = !selectedVal - 1
            !dist      = - !dist
          endif
        endif

  else

    if (!selectedVal eq 1) then
      !nextVal = !selectedVal + 1

    elseif (!selectedVal eq !numPoints) then
          !nextVal = !selectedVal - 1
          !dist    = - !dist

        else
          if (!dist ge 0) then
            !nextVal   = !selectedVal + 1
          else
            !nextVal   = !selectedVal - 1
            !dist      = - !dist

          endif
    endif

  endif


  !this.joinerDist.active = true
  !startPoint   = !this.currRPath[!selectedVal]
  !nextPoint    = !this.currRPath[!nextVal]
  !direction    = !startPoint.position.direction(!nextPoint.position)

  -- selected wall point at which joiner needs to be created
  !joinerPoint  = !this.joinPoint.selection().dbref()
  handle ANY
    return
  endhandle

  !startPos     = !joinerPoint.position.offset(up, !this.jStartHeight.val)
  !endPos       = !joinerPoint.position.offset(up, !this.jEndHeight.val)
  !joinerLine   = object LINE(!startPos, !endPos)
  !joinerLine   = !joinerLine.offset(!direction, !dist)


  !joinerLine.draw(!this.aidNumber, 1, 5)
  AID TEXT NUMBER $!<this.aidNumber> 'Start' AT $!<joinerLine.startPosition>
  AID TEXT NUMBER $!<this.aidNumber> 'End'   AT $!<joinerLine.endPosition>

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      drawRPoint
--
-- Description: Draws an aid box at the position of an rPath Point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     rPath Point
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawRPoint(!strPoint is STRING)

  !this.tidy()

  if ((!strPoint neq '') and (!strPoint.occurs('=') ge 1)) then
    !point    = !strPoint.dbref()
    if (!point.badref()) then
      !!alert.warning('Bad Ref')
    else
      !pointPos = !point.position
      AID TEXT NUMBER $!<this.aidNumber> 'Start' AT $!<pointPos>
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawProfile
--
-- Description: Draws an aid line graphic representing a Wall Profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       LINE      Target Line
--    2    R       REAL     Profile Height
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawProfile(!profileLine is LINE, !profileHeight is REAL)

  !this.tidy()

  if (!profileLine.length() lt 1mm) then
    !profileLine.startPosition.up  = !profileHeight
    AID TEXT NUMBER $!<this.aidNumber> 'Start & End' AT $!<profileLine.startPosition>

  else
    !newLine = !profileLine.offset(object DIRECTION( 'UP WRT WORLD' ),!profileHeight)
    AID TEXT NUMBER $!<this.aidNumber> 'Start'  AT $!<newLine.startPosition>
    AID TEXT NUMBER $!<this.aidNumber> 'End'    AT $!<newLine.endPosition>
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawProfile
--
-- Description: Draws an aid line graphic representing a Wall Profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       DBREF      Start Ref
--    2    R       DBREF       Stop Ref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawProfile()

  !this.tidy()

  if(!this.selectionArray[1].staRef eq !this.currRPath.last()) then
    return
  endif

  if(!this.selectionArray[1].staRef eq !this.selectionArray[1].endRef) then
    !startPoint   = !this.selectionArray[1].staRef
    !sequence     = !this.currRPath.findFirst(!this.selectionArray[1].staRef)

    !nextPoint    = !this.currRPath[!sequence + 1]

    !direction    = !startPoint.position.direction(!nextPoint.position)
    !distance     = !startPoint.position.distance(!nextPoint.position)

    if(!this.modProfileStartDist.val gt !distance or !this.modProfileEndDist.val gt !distance) then
      !!alert.message('Distance is greater than the distance between wall points')
      return
    endif

    if (!this.pickDetail.selection().size() eq 1) then
      !profileStartPos = !this.selectionArray[1].staRef.position.offset(!direction, !this.modProfileStartDist.val)
      !profileEndPos   = !this.selectionArray[1].staRef.position.offset(!direction, !this.modProfileEndDist.val)
    else
      !profileStart    = !this.startPick.selection().dbref()
      !profileStartPos = !profileStart.position
      !profileEnd      = !this.stopPick.selection().dbref()
      !profileEndPos   = !profileEnd.position

    endif

    !profileLine  = object LINE(!profileStartPos, !profileEndPos)
    if (!profileLine.length() lt 1mm) then
      return
    endif

    !newProfileLine = !profileLine.offset(up, !this.modProfileHeight.val)
    AID TEXT NUMBER $!<this.aidNumber> 'Start' AT $!<newProfileLine.startPosition>
    AID TEXT NUMBER $!<this.aidNumber> 'End'   AT $!<newProfileLine.endPosition>

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      panelAid
--
-- Description: Draws an aid text box at the position of the new panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .panelAid()

  !this.tidy()

  !panPos = !this.selectionArray[1].position
  !panOri = !this.selectionArray[1].orientation

  if (!this.panModDist.val.set()) then
    !panPos.east = !panPos.east + (!this.panModDist.val - !panPos.east)
  endif

  if (!this.panModHeight.val.set()) then
    !panPos.up = !panPos.up + (!this.panModHeight.val - !panPos.up)
  endif

  !aidAxes = object GPHAXES(!panPos, !panOri)
  !aidAxes.draw(!this.aidNumber)

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      joinerSpacing
--
-- Description: Updates and displays the spacings between a set of joiners
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       REAL      Joiner Spacing
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------

define method .joinerSpacing()

  if(!this.jSpacing.val.unset()) then

    if(!!isImperialLength('DIST')) then
      !this.jSpacing.val        = 20in
    else
      !this.jSpacing.val        = 500mm
    endif

    !!alert.message('Spacing cannot be empty. Setting it to the minimum value.')

  elseif(!this.jSpacing.val.lt(0)) then
    !!alert.message('Value for Spacing should be positive')
    !this.jSpacing.val = abs(!this.jSpacing.val)
  endif

  if(!!isImperialLength('DIST') and !this.jSpacing.val.lt(20in) ) then
    !!alert.message('Minimum value for Spacing should be 20in')
    !this.jSpacing.val = 20in
  elseif(!!isImperialLength('DIST').not() and !this.jSpacing.val.lt(500mm) ) then
    !!alert.message('Minimum value for Spacing should be 500mm')
    !this.jSpacing.val = 500mm
  endif

  !this.drawJoiners()

  refresh

endmethod
-- End of method

-------------------------------------------------------------------------
--
-- Method:      joinerHeight
--
-- Description: Updates and displays the height of joiners
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       REAL      Joiner Spacing
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------

define method .joinerHeight(!gadget is GADGET, !dummyAction is STRING)

  if(!gadget.val.set() and !gadget.val lt 0 ) then
    !!alert.message('Value for Height should be positive')
    !gadget.val = abs(!gadget.val)
  endif

  if( !gadget.val.unset() and !gadget.name().matchwild('*JSTARTHEIGHT') ) then
    !!alert.message('Value for Joiner start height cannot be empty')
    !this.jStartHeight.val  = 0
    if( !this.jEndHeight.val eq 0 ) then
      !this.jEndHeight.val    = !this.currentWall.height
    endif

  elseif(!gadget.name().matchwild('*JENDHEIGHT') ) then
    if (!gadget.val.unset() or !gadget.val eq 0 ) then
      !!alert.message('Value for Joiner end height cannot be empty')
      !this.jEndHeight.val    = !this.currentWall.height - !this.jStartHeight.val
    --elseif(!gadget.val gt !this.currentWall.height) then
    --  !!alert.message('Joiner end height is greater than the Wall height. Setting it to Wall height.')
    --  !this.jEndHeight.val    = !this.currentWall.height
    endif
  endif

  if(!this.currentWall.set()) then
    !wallHeight = !this.currentWall.height
  elseif(!this.currentDetail.set()) then
    !wallHeight = !this.currentDetail.owner.owner.height
  endif

  if(!gadget.val gt !wallHeight) then
    !!alert.message('Height cannot be greater than the Wall height. Setting it to Wall height.')
    !gadget.val    = !wallHeight
  endif

  !this.tidy()

  if(!gadget.name().matchwild('MOD*')) then
    if(!this.modJStartHeight.val eq !this.modJEndHeight.val) then
      !!alert.message('Joiner Start and End are in the same height')
      return
    endif

  else
    if(!this.jStartHeight.val eq !this.jEndHeight.val) then
      !!alert.message('Start and End are in the same height')
      return
    endif
  endif

  if(!this.singleJoin.val) then
    !this.drawSingleJoiner()
  else
    !this.drawJoiners()
  endif

  refresh

endmethod
-- End of method

-------------------------------------------------------------------------
--
-- Method:      profileHeight
--
-- Description: Updates and displays the line representing a wall profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       REAL     Profile Height
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------

define method .profileHeight()

  !this.tidy()

  if(!this.profileElev.val.unset()) then
    !!alert.message('Value for Height cannot be empty')
    !this.profileElev.val  = 0

  elseif(!this.profileElev.val.lt(0)) then
    !!alert.message('Value for Height should be positive')
    !this.profileElev.val  = abs(!this.profileElev.val)
  endif

  !startPoint = !this.startPick.selection().dbref()
  !stopPoint  = !this.stopPick.selection().dbref()

  !wallLine   = object LINE(!startPoint.position, !stopPoint.position)

  !this.drawProfile(!wallLine, !this.profileElev.val)
  refresh

endmethod
-- End of method

-------------------------------------------------------------------------
--
-- Method:      profilePoints
--
-- Description: Updates and displays the line representing a wall profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       REAL     Profile Height
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------

define method .profilePoints()

  !this.tidy()

  !startPoint = !this.startPick.selection().dbref()
  handle (2,111)
    return FALSE
  endhandle

  !stopPoint  = !this.stopPick.selection().dbref()
  handle (2,111)
    return FALSE
  endhandle

  !wallLine   = object LINE(!startPoint.position, !stopPoint.position)

  !this.drawProfile(!wallLine, !this.profileElev.val)
  handle(2,785)
    return FALSE
  endhandle

  refresh

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useSelectedWalls
--
-- Description: Get walls from graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useSelectedWalls()

  -- Unenhance walls
  !this.tidyWalls()

  -- Tidy graphics
  !this.tidy()

  -- Clear grid
  !this.wallGrid.clearGrid()

  -- Initialise Variables
  !this.wallList.clear()
  !this.wallNames.clear()

  -- Get selected draws to convert into walls
  !selection          = object SELECTION()
  !selection.getCurrent()

  -- Get draws from graphical selection
  !elements           = !selection.getSelection()

  -- Build new selection
  !selection.clear()
  do !i indices !elements
    !type             = !elements[!i].type
    if(!type.eq('CTWALL')) then
      !selection.add(!elements[!i])
      !this.wallList.append(!elements[!i])
    endif
  enddo

  -- Highlight selection
  !selection.setCurrent()

  -- Update grid
  !this.updateWallList()

endmethod
------------------------------------------------------------------------
--
-- Method:      backToMainRoomDesignTasks
--
-- Description: Switching to Main Room Design Tasks
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backToMainRoomDesignTasks()

  !this.detailTasks(true)
  --!this.hide()
  !!accTaskManager.active('accDetail')
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        validate
--
-- Description:   validate the value entered in the text gadgets
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validate(!gadget is GADGET, !dummyAction is STRING)

  if(!gadget.name() eq 'PROFILELENGTH') then

    if(!!isImperialLength('DIST')) then
      !maximumLength  = 120in
    else
      !maximumLength  = 3000mm
    endif

    if(!gadget.val.unset()) then
      !gadget.val = !maximumLength
    endif

  elseif(!gadget.val.unset()) then
    !!alert.message('Field cannot be empty')
    !gadget.val = 0
    return
  endif

  if(!gadget.name() inset ('PANWIDTH','PANTHICK','PANMODDIST','PROFILELENGTH','MODPROFILEHEIGHT') ) then
    if(!gadget.val.lt(0)) then
      !gadgetTag  = !gadget.tag.before(':')
      !!alert.message('Value for ' & '"' & !gadgetTag & '" ' & 'should be positive')
      !gadget.val = abs(!gadget.val)
      return
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        validatePanelValues
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validatePanelValues(!gadget is GADGET, !dummyAction is STRING)

  if(!gadget.val.unset()) then

    !!alert.message('Value cannot be empty.')

    if(!gadget eq !this.panModDist) then
      !this.panModDist.val  = !this.currentDetail.zdistance
    elseif(!gadget eq !this.panModHeight) then
      !this.panModHeight.val  = !this.currentDetail.vdistance

    else
      if (!this.currentDetail.wJusLine eq 'RIGH') then
         !panLeadCut = !this.currentDetail.desparam[2]
         !panRearCut = !this.currentDetail.desparam[1]
      else
         !panLeadCut = !this.currentDetail.desparam[1]
         !panRearCut = !this.currentDetail.desparam[2]
      endif

      if (!this.currentDetail.desparam[3].set()) then
        !panTopCut = !this.currentDetail.desparam[3]
      endif

      if(!gadget eq !this.panTopCut) then
        !this.panTopCut.val  = !panTopCut
      elseif(!gadget eq !this.panLeadCut) then
        !this.panLeadCut.val  = !panLeadCut
      elseif(!gadget eq !this.panRearCut) then
        !this.panRearCut.val  = !panRearCut
      endif
    endif

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        validateJoinerDist
--
-- Description:   validate the joiner distance from wall point
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateJoinerDist(!gadget is GADGET, !dummyAction is STRING)

  if(!gadget.val.unset()) then
    !!alert.message('Field cannot be empty')
    !this.joinerDistance = 0
    !gadget.val = 0
    return
  endif

  !this.joinerDistance = !gadget.val

  if (!gadget.name().matchwild('MOD*')) then
    !selectedVal = !this.currentDetail
    !startPoint  = !selectedVal.posRef
    !points      = !startPoint.owner.members

    if (!this.currentWall.closeFlag eq TRUE) then
      if (!startPoint eq !points.last()) then
        if (!this.joinerDist ge 0 ) then
          !nextPoint         = !points[1]
          !distBetweenPoints = !startPoint.position.distance(!nextPoint.position)
          if (!this.joinerDistance gt !distBetweenPoints) then
            !!alert.message('Distance is greater than the distance between wall points')
            !this.joinerDistance = !distBetweenPoints
          endif
        else
          !!alert.message('Value should be positive')
          !this.joinerDistance = !distBetweenPoints
        endif
      elseif (!startPoint eq !points[1]) then
            if (!this.joinerDistance ge 0 ) then
              !nextPoint         = !points[!startPoint.sequence + 1]
              !distBetweenPoints = !startPoint.position.distance(!nextPoint.position)
              if (!this.joinerDistance gt !distBetweenPoints) then
                !!alert.message('Distance is greater than the distance between wall points')
                !this.joinerDistance = !distBetweenPoints
              endif
            else
              !!alert.message('Value should be positive')
              !this.joinerDistance = 0
            endif
      else
        if (!gadget.val ge 0) then
          !nextPoint         = !points[!startPoint.sequence + 1]
          !distBetweenPoints = !startPoint.position.distance(!nextPoint.position)
          if (!this.joinerDistance gt !distBetweenPoints) then
            !!alert.message('Distance is greater than the distance between wall points')
            !this.joinerDistance = !distBetweenPoints
          endif
        else
          !!alert.message('Value should be positive')
          !this.joinerDistance = 0
        endif
      endif
    else
      if (!startPoint eq !points.last()) then
        if (!this.joinerDistance gt 0) then
          !!alert.message('value should be negative')
          !this.joinerDistance    = 0
        else
          !nextPoint          = !points[!startPoint.sequence - 1]
          !distBetweenPoints  = !startPoint.position.distance(!nextPoint.position)
          !distBetweenPoints2 = - !distBetweenPoints
          if (!this.joinerDistance lt !distBetweenPoints2) then
            !!alert.message('Distance is greater than the distance between wall points')
            !this.joinerDistance = !distBetweenPoints2
          endif
        endif
      elseif (!startPoint eq !points[1]) then
            if (!this.joinerDistance ge 0 ) then
              !nextPoint         = !points[!startPoint.sequence + 1]
              !distBetweenPoints = !startPoint.position.distance(!nextPoint.position)
              if (!this.joinerDistance gt !distBetweenPoints) then
                !!alert.message('Distance is greater than the distance between wall points')
                !this.joinerDistance = !distBetweenPoints
              endif
            else
              !!alert.message('Value should be positive')
              !this.joinerDistance    = 0
            endif
      else
        if (!this.joinerDistance ge 0) then
          !nextPoint         = !points[!startPoint.sequence + 1]
          !distBetweenPoints = !startPoint.position.distance(!nextPoint.position)
          if (!this.joinerDistance gt !distBetweenPoints) then
            !!alert.message('Distance is greater than the distance between wall points')
            !this.joinerDistance = !distBetweenPoints
          endif
        else
          !!alert.message('Value should be positive')
          !this.joinerDistance    = 0
        endif
      endif
    endif

    !gadget.val = !this.joinerDistance
    !this.drawModifiedJoiner()

  else

    !selectedVal  = !this.joinPoint.val
    if (!this.currentWall.closeFlag eq TRUE) then
      !startPoint = !this.currRPath[!selectedVal]
      if (!selectedVal eq !this.joinPoint.dtext.size()) then
        if (!this.joinerDist.val gt 0) then
          !nextPoint = !this.currRPath[1]
        else
          !nextPoint = !this.currRPath[!selectedVal - 1]
        endif
      elseif (!selectedVal eq 1) then
        if (!this.joinerDist.val gt 0 ) then
          !nextPoint = !this.currRPath[!selectedVal + 1]
        else
          !nextPoint = !this.currRPath.last()
        endif
      else
        if (!this.joinerDist.val gt 0 ) then
          !nextPoint = !this.currRPath[!selectedVal + 1]
        else
          !nextPoint = !this.currRPath[!selectedVal - 1]
        endif
      endif

      !distBetweenPoints  = !startPoint.position.distance(!nextPoint.position)
      !distBetweenPoints2 = - !distBetweenPoints
      if (!this.joinerDistance gt !distBetweenPoints) then
        !!alert.message('Distance is greater than the distance between wall points')
        !this.joinerDistance = !distBetweenPoints
      elseif (!this.joinerDistance lt !distBetweenPoints2) then
        !!alert.message('Distance is greater than the distance between wall points')
        !this.joinerDistance = !distBetweenPoints2
      endif


    else

      if (!selectedVal eq !this.joinPoint.dtext.size() ) then
        if (!this.joinerDistance gt 0) then
          !gadgetTag  = !this.joinerDist.tag.before(':')
          !!alert.message('Value for ' & '"' & !gadgetTag & '" ' & 'should be negative')
          !this.joinerDistance = 0
        else
          !startPoint         = !this.currRPath[!selectedVal]
          !nextPoint          = !this.currRPath[!selectedVal - 1]
          !distBetweenPoints  = !startPoint.position.distance(!nextPoint.position)
          !distBetweenPoints2 = - !distBetweenPoints
          if (!this.joinerDistance lt !distBetweenPoints2) then
            !!alert.message('Distance is greater than the distance between wall points')
            !this.joinerDistance = !distBetweenPoints2
          endif
        endif

      elseif (!this.joinPoint.selection('DTEXT') eq 'POINTR1') then
            if (!this.joinerDistance ge 0 ) then
              !startPoint        = !this.currRPath[!selectedVal]
              !nextPoint         = !this.currRPath[!selectedVal + 1]
              !distBetweenPoints = !startPoint.position.distance(!nextPoint.position)
              if (!this.joinerDistance gt !distBetweenPoints) then
                !!alert.message('Distance is greater than the distance between wall points')
                !this.joinerDistance = !distBetweenPoints
              endif
            else
              !gadgetTag  = !gadget.tag.before(':')
              !!alert.message('Value for ' & '"' & !gadgetTag & '" ' & 'should be positive')
              !this.joinerDistance = 0
            endif
      elseif (!selectedVal neq 1 and !selectedVal neq !this.joinPoint.dtext.size()) then
            if (!this.joinerDistance gt 0 ) then
              !startPoint         = !this.currRPath[!selectedVal]
              !nextPoint          = !this.currRPath[!selectedVal + 1]
              !distBetweenPoints  = !startPoint.position.distance(!nextPoint.position)
              if (!this.joinerDistance gt !distBetweenPoints) then
                !!alert.message('Distance is greater than the distance between wall points')
               !this.joinerDistance = !distBetweenPoints
              endif
            else
              !startPoint         = !this.currRPath[!selectedVal]
              !nextPoint          = !this.currRPath[!selectedVal - 1]
              !distBetweenPoints  = !startPoint.position.distance(!nextPoint.position)
              !distBetweenPoints2 = - !distBetweenPoints
              if (!this.joinerDistance lt !distBetweenPoints2) then
                !!alert.message('Distance is greater than the distance between wall points')
                !this.joinerDistance = !distBetweenPoints2
              endif
           endif
      endif

    endif
   !gadget.val = !this.joinerDistance

    !this.drawSingleJoiner()
  endif


endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:      modifyJoinerHeight
--
-- Description: Updates and displays the height of joiners
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       REAL      Joiner Spacing
-- Return:
--   [Data Type] [Description]
--
-------------------------------------------------------------------------

define method .modifyJoinerHeight(!gadget is GADGET, !dummyAction is STRING)

  if(!gadget.val.set() and !gadget.val lt 0 ) then
    !!alert.message('Value for Height should be positive')
    !gadget.val = abs(!gadget.val)
  endif

  if(!this.currentWall.set()) then
    !wallHeight = !this.currentWall.height
  elseif(!this.currentDetail.set()) then
    !wallHeight = !this.currentDetail.owner.owner.height
  endif

  if( !gadget.val.unset() and !gadget.name().matchwild('*JSTARTHEIGHT') ) then
    !!alert.message('Value for Joiner start height cannot be empty')
    !this.modJStartHeight.val  = 0
    if( !this.modJEndHeight.val eq 0 ) then
      !this.modJEndHeight.val  = !wallHeight
    endif

  elseif(!gadget.name().matchwild('*JENDHEIGHT') ) then
    if (!gadget.val.unset() or !gadget.val eq 0 ) then
      !!alert.message('Value for Joiner end height cannot be empty')
      !this.modJEndHeight.val    = !wallHeight - !this.modJStartHeight.val
    endif
  endif

  if(!gadget.val gt !wallHeight) then
    !!alert.message('Height cannot be greater than the Wall height. Setting it to Wall height.')
    !gadget.val    = !wallHeight
  endif

  !this.tidy()

  if(!this.modJStartHeight.val eq !this.modJEndHeight.val) then
    !!alert.message('Joiner Start and End are in the same height')
    return
  endif

  !this.drawModifiedJoiner()

endmethod
-- End of method

-------------------------------------------------------------------------
--
-- Method:      drawModifiedJoiner
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawModifiedJoiner()

  !this.tidy()

  !startPos     = !this.currentDetail.posRef.position.offset(up, !this.modJStartHeight.val)
  !endPos       = !this.currentDetail.posRef.position.offset(up, !this.modJEndHeight.val)

  !joinerLine   = object LINE(!startPos, !endPos)

  !selectedVal  = !this.currentDetail.posRef.sequence
  !wall         = !this.currentDetail.owner.owner

  !startPoint   = !this.currentDetail.posRef
  !points       = !startPoint.owner.members
  !dist         = !this.joinerDistance

  if (!this.currentWall.closeFlag eq TRUE) then
    if (!startPoint eq !points[1]) then
      !endPoint          = !points[!startPoint.sequence + 1]

    elseif (!startPoint eq !points.last()) then
          !endPoint          = !points[1]
    else
          !endPoint          = !points[!startPoint.sequence + 1]
    endif

  else
    if (!startPoint eq !points.last()) then
      !endPoint          = !points[!startPoint.sequence - 1]
      !dist = - !dist
    else
      !endPoint          = !points[!startPoint.sequence + 1]
    endif
  endif



  handle ANY
    --
  elsehandle none
    !direction  = !startPoint.position.direction(!endPoint.position)
    if (!this.currentWall.closeFlag.not() and !startPoint eq !points.last()) then
      !joinerLine = !joinerLine.offset(!direction, !this.joinerDistance * -1)
    else
      !joinerLine = !joinerLine.offset(!direction, !this.joinerDistance)
    endif

     endhandle

  !joinerLine.draw(!this.aidNumber, 1, 3)
  AID TEXT NUMBER $!<this.aidNumber> 'Start' AT $!<joinerLine.startPosition>
  AID TEXT NUMBER $!<this.aidNumber> 'End'   AT $!<joinerLine.endPosition>

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        validateProfileGadgets
--
-- Description:   validate Profile Gadgets
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateProfileGadgets(!gadget is GADGET, !dummyAction is STRING)


  if(!gadget.val.unset()) then
    !!alert.message('Value cannot be empty.')
    if(!gadget eq !this.modProfileStartDist) then
      !this.modProfileStartDist.val  = !this.currentDetail.szdistance
    elseif(!gadget eq !this.modProfileEndDist) then
      !this.modProfileEndDist.val  = !this.currentDetail.ezdistance
    elseif(!gadget eq !this.modProfileHeight) then
      !this.modProfileHeight.val  = !this.currentDetail.zOffset
    endif
  endif

  if(!gadget.val lt 0) then
    !!alert.message('Value for ' & !gadget.tag.before(':') & ' should be positive')
    !gadget.val = abs(!gadget.val)
  endif

  if(!gadget eq !this.modProfileHeight and !this.modProfileHeight.val gt !this.currentWall.height) then
    !!alert.message('Profile Height should not be greater than the Wall height.')
    !this.modProfileHeight.val  = !this.currentDetail.zOffset
  endif

  if(!this.currentDetail.staRef eq !this.currRPath.last()) then
    return
  endif

  if(!this.currentDetail.staRef eq !this.currentDetail.endRef) then

    !startPoint   = !this.currentDetail.staRef
    !sequence     = !this.currRPath.findFirst(!this.currentDetail.staRef)

    !nextPoint   = !this.currRPath[!sequence + 1]

    !textDirection      = !startPoint.position.direction(!nextPoint.position)
    !distBetweenPoints  = !startPoint.position.distance(!nextPoint.position)

    if(!gadget.val gt !distBetweenPoints) then
      if(!this.modProfileStartDist.val gt !distBetweenPoints or !this.modProfileEndDist.val gt !distBetweenPoints) then
        !!alert.message(!gadget.tag.before(':') & ' is greater than the distance between wall points')
        if(!gadget eq !this.modProfileStartDist) then
          !this.modProfileStartDist.val  = !this.currentDetail.szdistance
        elseif(!gadget eq !this.modProfileEndDist) then
          !this.modProfileEndDist.val  = !this.currentDetail.ezdistance
        endif
      endif
    endif

    if(!this.modProfileEndDist.val le !this.modProfileStartDist.val) then
      if(!gadget eq !this.modProfileStartDist) then
        !!alert.message('Start distance should be lesser than End distance.')
        !this.modProfileStartDist.val  = !this.currentDetail.szdistance
      elseif(!gadget eq !this.modProfileEndDist) then
        !!alert.message('End Distance should be greater than Start distance.')
        !this.modProfileEndDist.val  = !this.currentDetail.ezdistance
      endif
    endif

    if (!this.pickDetail.selection().size() eq 1) then
      !profileStartPos = !this.currentDetail.staRef.position.offset(!textDirection, !this.modProfileStartDist.val)
      !profileEndPos   = !this.currentDetail.staRef.position.offset(!textDirection, !this.modProfileEndDist.val)
    else
      !profileStart    = !this.startPick.selection().dbref()
      !profileStartPos = !profileStart.position
      !profileEnd      = !this.stopPick.selection().dbref()
      !profileEndPos   = !profileEnd.position
    endif

    !profileLine  = object LINE(!profileStartPos, !profileEndPos)
    if(!profileLine.length() lt 1mm) then
      return
    endif

    !this.drawProfile(!profileLine, !this.modProfileHeight.val)

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getSectionDetails
--
-- Description: Retrieves a list of all the wall panels, doors & windows
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getSectionDetails(!posRef is DBREF) is ARRAY

  !!ce = !this.currentWall

  !wallDistances = ARRAY()
  !wallOpenGroup = object COLLECTION()
  !wallOpenGroup.scope(!this.currentWall)

  !wallOpenGroup.type('DOOR')
  !doorGroup = !wallOpenGroup.results()

  !wallOpenGroup.type('WLPANE')
  !panelGroup = !wallOpenGroup.results()

  !wallOpenGroup.type('WINDOW')
  !windowGroup = !wallOpenGroup.results()

    -- Get Door distances
    --do !i indices !doorGroup
      --skip if (!doorGroup[!i].owner.posRef neq !posRef)
      --!wallDistances.append(!doorGroup[!i].owner.zdist)
    --enddo

    -- Get panel distances
    do !i indices !panelGroup
        skip if (!panelGroup[!i].posRef neq !posRef)
        !wallDistances.append(!panelGroup[!i].zdist)
    enddo

    -- Get window distances
    --do !i indices !windowGroup
        --skip if (!windowGroup[!i].owner.posRef neq !posRef)
        --!wallDistances.append(!windowGroup[!i].owner.zdist)
    --enddo

  !wallDistances.sort()


  !wallFeats = ARRAY()
  !wallPanels = ARRAY()
  do !dist indices !wallDistances
    !doorDist = !wallDistances[!dist]


    -- Any matching panels?
    do !p indices !panelGroup
    skip if (!panelGroup[!p].posRef neq !posRef)
     if (!panelGroup[!p].zdist eq !doorDist) then
         !matchingDetail = !panelGroup[!p]
     endif
    enddo


    !doorArray = ARRAY()
    !doorArray.append(!doorDist.string())
    !doorArray.append(!matchingDetail.string())

    !wallPanels.append(!doorArray)
  enddo

  !wallFeats.append(!wallPanels)
  !wallFeats.append(!doorGroup)
  !wallFeats.append(!windowGroup)
  return !wallFeats

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createJoinersBetweenFeatures
--
-- Description: Creates new joiners, between panels
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createJoinersBetweenFeatures()

        !sectionPosRef = !this.joinPoint.selection().dbref()

        !!ce = !sectionPosRef
        NEXT
        handle ANY
                return TRUE
        elsehandle NONE
                !nextPosRef = !!ce
        endhandle

        !line = object LINE(!sectionPosRef.position, !nextPosRef.position)

        !wallDetails = !this.getSectionDetails(!sectionPosRef)
        !wallPanels  = !wallDetails[1]
        !wallDoors   = !wallDetails[2]
        !wallWindows = !wallDetails[3]

        !doorLines   = !this.getOpeningLines(!wallDoors, !line)
        !windowLines = !this.getOpeningLines(!wallWindows, !line)

        !wallProfile = object COMPATH(!this.currentWall)

        !!ce = !this.currentWall

        !collection         = object COLLECTION()
  !collection.scope(!!ce)
  !collection.type('WLJNTS')

        -- If group exists, add panels to that group
  if (!collection.results().size() ne 0) then
    !wallJointsGroup = !collection.results()[1]
  -- If group doesn't exist, create new group
  else
   NEW WLJNTS
   !wallJointsGroup = !!ce
  endif
  !!ce = !wallJointsGroup

        do !i indices !wallPanels

                -- When not to create a joiner
                skip if (!i eq !wallPanels.size())

                -- Get extremities of Wall Detail
        !localVolume = object LOCALVOLUME(!wallPanels[!i][2].dbref(),!wallPanels[!i][2].dbref())
        !edgeFrom = !wallProfile.edgeRefPosition(!localVolume.from)
        handle ANY
                skip
        endhandle
        !edgeTo   = !wallProfile.edgeRefPosition(!localVolume.to)
        handle ANY
                skip
        endhandle

        if( !edgeFrom[2] gt !edgeTo[2] ) then
        -- swap order if door defined in opposite direction to wall (by comparing z distances)
        !localFrom = !localVolume.to
          !localTo   = !localVolume.from
          else
        !localTo   = !localVolume.to
        !localFrom = !localVolume.from
        endif

        -- map to and from onto wall line
        !mapFrom = !line.near(!localFrom)
        !mapTo   = !line.near(!localTo)

        !startPos = !wallProfile.near(!mapFrom)
        !endPos = !wallProfile.near(!mapTo)

        !nearOpening = FALSE

        !detailLine = object LINE(!sectionPosRef.position, !endPos)
        !detLine1 = object LINE(!sectionPosRef.position, !startPos)

        if (!detailLine.length() gt !detLine1.length()) then
                !endZDist = !detailLine.length()
        else
                !endZDist = !detLine1.length()
        endif

        do !dr indices !doorLines
                !doorLine = !doorLines[!dr].extendStart(50mm).extendEnd(50mm)
                !dl1 = object LINE(!sectionPosRef.position, !doorLine.startPosition)
                !dl2 = object LINE(!sectionPosRef.position, !doorLine.endPosition)
                !dSDist = !dl1.length()
                !dEDist = !dl2.length()

                if ((!endZDist ge !dSDist) AND (!endZDist le !dEDist)) then
                        !nearOpening = TRUE
                endif
                break if (!nearOpening eq TRUE)
        enddo

         do !wd indices !windowLines
                !windowLine = !windowLines[!wd].extendStart(50mm).extendEnd(50mm)
                !windowLine1 = object LINE(!sectionPosRef.position, !windowLine.startPosition)
                !windowLine2 = object LINE(!sectionPosRef.position, !windowLine.endPosition)
                !wSDist = !windowLine1.length()
                !wEDist = !windowLine2.length()
                if ((!endZDist ge !wSDist) AND (!endZDist le !wEDist)) then
                        !nearOpening = TRUE
                endif
                break if (!nearOpening eq TRUE)
        enddo

        if (!nearOpening.not()) then
   NEW WLJOIN
   !element = !!ce
   !element.spref      = !this.joinSPREF.val.dbref()
   !element.zdistance  = !endZDist
   !element.sdistance  = !this.jStartHeight.val
   !element.edistance  = !this.jEndHeight.val
   !element.posRef     = !this.joinPoint.selection().dbref()
   !element.jusLine      = 'CENT'
   !element.wJusLine     = 'CENT'
  endif


        enddo


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOpeningLines
--
-- Description: Returns an array of line representing the passed array
--                                                of wall openings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--                ARRAY     Array of Lines
------------------------------------------------------------------------

define method .getOpeningLines(!openings is ARRAY, !wallLine is LINE) is ARRAY

        !wallProfile = object COMPATH(!this.currentWall)

        !returnedLines = ARRAY()

        do !i indices !openings

                !opening = !openings[!i]

                -- Get extremities of Wall Detail
        !localVolume = object LOCALVOLUME(!opening,!opening)

        !edgeFrom = !wallProfile.edgeRefPosition(!localVolume.from)
        !edgeTo   = !wallProfile.edgeRefPosition(!localVolume.to)

        if( !edgeFrom[2] gt !edgeTo[2] ) then
                -- swap order if door defined in opposite direction to wall (by comparing z distances)
                !localFrom = !localVolume.to
        !localTo   = !localVolume.from
                else
                !localTo   = !localVolume.to
                !localFrom = !localVolume.from
                endif

        -- map to and from onto wall line
        !mapFrom = !wallLine.near(!localFrom)
        !mapTo   = !wallLine.near(!localTo)

        !openingLine = object LINE(!mapFrom, !mapTo)

        !returnedLines.append(!openingLine)

        enddo

        return !returnedLines

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      panelDirection
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .panelDirection(!gadget is GADGET, !action is STRING )

  if(!action.eq('SELECT')) then
    if(!gadget.name() eq 'PANELDIR') then
      !selection  = !this.panelDir.selection()
    else
      !selection  = !this.panelDir1.selection()
    endif

    !firstElement   = object DBREF(!selection.split()[1])
    !secondElement  = object DBREF(!selection.split()[2])

    !this.panelStartElement = !firstElement
    !this.panelEndElement   = !secondElement

    !startPos = !firstElement.position
    !endPos   = !secondElement.position

    AID CLEAR ALL !this.aidPointsNo
    AID TEXT NUMBER $!<this.aidPointsNo> 'Start' At $!<startPos>
    AID TEXT NUMBER $!<this.aidPointsNo> 'End' At $!<endPos>

    if(!firstElement.isNamed) then
      !firstName  = !firstElement.name
    else
      !firstName  = !firstElement.type   & ' ' & !firstElement.tyseq
    endif

    if(!secondElement.isNamed) then
      !secondName  = !secondElement.name
    else
      !secondName  = !secondElement.type   & ' ' & !secondElement.tyseq
    endif

    !this.dtCrtPane.tag = 'Create Panels from ' & !firstName & ' to ' &  !secondName

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setJoinerDist()
--
-- Description: set the joiner dist to 0 on change of POINTR
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setJoinerDist()

  !this.joinerDistance = 0
  !this.joinerDist.val = 0

  !this.drawSingleJoiner()

endmethod
