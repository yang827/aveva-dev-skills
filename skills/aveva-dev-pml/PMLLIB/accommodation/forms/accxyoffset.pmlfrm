-- File:            accxyoffset.pmlfrm
--   Type:          Form Definition
--   Group:         Accommodation Application
--     Keyword:
--   Module:        Accommodation
--   Replaces:
--
-- Author:          G.Somasundaram
-- Created:         08/05/2007 17:35
--
--
-- Description: Set the xyoffset of Accommodation elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accXYOffset()                    -                   Constructor
--  close()                          -
--  draw()                           -                   Setup EDG pick event for picking position
--  initialise()                     -
--  offset(EDGPOSITIONDATA)          -                   Map picked position to room offset
--  pickOffset()                     -                   Define EDG event to pick position
--  setXYoffset()                    -                   Update element with modified values
--  tidy()                           -
--  xyOffsetUpdate()                 -
--


 setup form !!accXYOffset dialog docking

  !this.formTitle     = 'XYOFFSET'
  !this.iconTitle     = 'xyoffset'
  !this.callback      = '!this.initialise()'
  !this.quitcall      = '!this.tidy()'
  !this.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
  button .selectElement linkLabel 'Element:'  anchor top + left       at x0.5                 ymin                    callback '!this.initialise()' width 6
  paragraph .namepara                     anchor top + left + right   at xmax                 ymin                    width 20 lines 1

  -- XY Offset of floor from building origin
  button .offset linkLabel 'Pick Offset...' anchor top + left + right at x0.5                 ymax+0.2                callback '!this.pickOffset()'     width 20
  text .xOffset   'X:'                    anchor top + left + right   at x2                   ymax                    callback '!this.xyOffsetUpdate()' width 21 is REAL format !!distanceFmt
  text .yOffset   'Y:'                    anchor top + left + right   at xmin                 ymax+0.2                callback '!this.xyOffsetUpdate()' width 21 is REAL format !!distanceFmt
  paragraph .wrtpara                      anchor top + left + right   at x2                   ymax+0.2                width 20

  -- Apply button
  valign top
  paragraph .acceptPara                   anchor top + left           at x0.5                 ymax+0.5                pixmap width 16 height 16
  button .acceptBtn linkLabel 'Accept'    anchor top + left           at xmax+1                                       callback '!this.setXYoffset()' width 5
  -- Create Room
  paragraph .discardPara                  anchor top + right          at xmax.yOffset-9       ymin.acceptPara         pixmap width 16 height 16
  button .discardBtn linkLabel 'Dismiss'  anchor top + right          at xmax+1                                       callback '!this.close()'  width 5

  -- Form Members
  -- Current Element
  member .element         is DBREF

  -- Element has XYOffset attribute
  member .xyOffsetFlag    is BOOLEAN

  -- XYOffset Values
  member .xyOffset        is XYPOSITION

  -- Plane
  member .plane           is PLANE

  member .aidNumber       is REAL

 exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      accXYOffset
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .accXYOffset()

-- get the icons for the gadgets
  !acceptIcon       = !!pml.getpathname('accept.png')
  !this.acceptPara.addPixmap(!acceptIcon)

  !discardIcon      = !!pml.getpathname('discard.png')
  !this.discardPara.addPixmap(!discardIcon)

  -- Get aid number
  !this.aidNumber   = !!aidNumbers.add('XYOffset display')

endmethod

------------------------------------------------------------------------
--
-- Method:initialise
--
-- Description:Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--  element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables

  -- Element
  !element              = !!ce

  -- Get XYOffset of element if it has it, if not use the position
  !attList              = !element.attributes()

  if(!attList.findFirst('XYOffset').set()) then
    !this.xyOffsetFlag  = true
  elseif (!attList.findFirst('Position').set()) then
    !this.xyOffsetFlag  = false
  else
    !!alert.warning('Element doesn''t have an XYOffset of position attribute.')
    return
  endif

  -- Set element to modify
  !this.element         = !element
  !owner                = !element.owner

  -- Element being modified
  !this.namepara.val    = !element.flnn

  -- Get owning frame of reference
  do
    !position = !owner.position
    handle ANY
      !owner    = !owner.owner
      handle ANY
        !!alert.warning('Unable to from frame of reference of element ' & !element.namn)
        return
      endhandle
    elsehandle NONE
      break
    endhandle
  enddo

  -- Owing element type
  !description          = 'Relative to ' & !!accConfig.typeDescription(!owner.type)
  !this.wrtpara.val     = !description

  -- Derive plane of XYOffset is on, this is the POS and ORI of the owning element
  -- Position of plane need act through the position of the element in case
  -- there is an Z component of the element.
  !elementPlane         = object PLANE(!element.position, !owner.orientation)
  !mappedPosition       = !elementPlane.near(!owner.position)
  !this.plane           = object PLANE(!mappedPosition , !owner.orientation)

  -- Get the XYOffset as a XYPOSITION of the element
  if(!this.xyOffsetFlag) then
    !this.xyOffset      = object XYPOSITION(!element.xyOffset[1] , !element.xyOffset[2])

  -- Get the position as XYPOSITION
  else
    !this.xyOffset      = !this.plane.xyOffset(!element.position)
  endif

  -- Update input gadgets with values
  !this.xOffset.val     = !this.xyOffset.x
  !this.yOffset.val     = !this.xyOffset.y

  -- Tag element
  !this.draw()

endmethod

------------------------------------------------------------------------
--
-- Method:    xyOffsetUpdate
--
-- Description: Sets the xyOffset of the element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .xyOffsetUpdate()

  -- Initialise Variables
  !this.xyOffset  = object XYPOSITION(!this.xOffset.val, !this.yOffset.val)

  -- Draw
  !this.draw()

endmethod

 ------------------------------------------------------------------------
--
-- Method:      draw()
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .draw()

  -- Remove aid graphics
  !this.tidy()

  !position       = !this.plane.threeDPosition(!this.xyOffset)
  !direction      = !this.plane.direction()

  AID ARROW NUMBER $!<this.aidNumber> AT $!position DIRECTION $!direction HEIGHT 1000mm PROPORTION 0.1
  AID TEXT NUMBER $!<this.aidNumber> '$!this.element.flnn' AT $!position
--AID TEXT NUMBER $!<this.aidNumber> '$!name' AT $!position
endmethod

------------------------------------------------------------------------
--
-- Method: close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()
  !this.tidy()
  !this.hide()
endmethod

------------------------------------------------------------------------
--
-- Method: tidy
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()
  AID CLEAR ALL $!<this.aidNumber>
  handle ANY
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      setXYoffset
--
-- Description: Update element with modified values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setXYoffset()

  -- Update XYPosition
  if (!this.xyOffsetFlag) then

    !this.element.xyOffset[1]   = !this.xyOffset.x
    !this.element.xyOffset[2]   = !this.xyOffset.y

  -- Update position
  else

    -- Get position
    !position                   = !this.element.position
    !position.east              = !this.xyOffset.x
    !position.north             = !this.xyOffset.y

    -- Modify position
    !this.element.position      = !position

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Define EDG event to pick position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickOffset()

  -- Initialise Variables
  -- use the alttext here
  !prompt               = 'Pick origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Modify XYOffset'
  !packet.remove        = true
  !packet.action        = '!!accXYOffset.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to room offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

  -- Map position onto plane
  !this.xyOffset    = !this.plane.xyOffset(!data.position)

  -- Update input gadgets with values
  !this.xOffset.val = !this.xyOffset.x
  !this.yOffset.val = !this.xyOffset.y

  !this.draw()

endmethod
-- End of method
