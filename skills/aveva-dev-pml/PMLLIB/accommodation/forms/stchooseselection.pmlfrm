--
--  Description:     Choose form for selection tables
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  actions(GADGET,STRING)           -                   Gadget actions for main form
--  apply()                          -                   Set spref of design element to selected table item.
--  choose()                         -                   Choose matching table items from selection table
--  firstShown()                     -                   Actions when form is shown for the first time.
--  initSelTableList()               -                   Initialise table group option list
--  initSelTypeList()                -                   Initialise Selection table option list
--  initTable()                      -                   Initialise the selected Type
--  initialise()                     -                   Form initialisation
--  kill()                           -                   Actions when form is killed.
--  netAfterSelect(ARRAY)            -                   After select event for .net control
--  stChooseSelection()              -
--
------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

--- form definition
setup form !!stChooseSelection dialog dock right

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Grid control members
  member .netSelTabItems   is NETGRIDCONTROL

  -- Other members
  member .newItemName      is STRING
  member .selTables        is ARRAY
  member .selectedSelTab   is SELECTIONTABLE
  member .comprop          is COMPROP

  -- Questions and answers
  member .choices          is ARRAY
  member .selectedItem     is DBREF

  -- 3D view
  member .drawlist         is REAL

  -- Action to be evaluated
  member .action                                         is BLOCK

  path down

  -- Selection groups and tables
  option .opSelTables at xmin form tagwid 6 '' anchor left + right + top width 35
  option .opSelTypes tagwid 6 '' anchor left + right + top width 35

  -- PML container to host .NET grid control
  container .conSelTabItems nobox PmlNetControl 'Table items' anchor top + left + right at xmin form width 50 height 15

  -- 3D view
  frame .frView3D '3D view' anchor top + left + right width 50 height 10
    view .vwView3D volume
    exit
  exit

  button .bnSelect  'Select'      at xmin               ymax+0.5      anchor top + left   callback '!this.apply()'
  button .bnCancel  'Cancel'      at xmax form-size     ymin.bnSelect anchor top + right  cancel

exit

------------------------------------------------------------------------
--
-- Method:      stChoose
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stChooseSelection()

  -- Form details
  !this.formTitle = 'Choose'
  !this.iconTitle = 'Choose'
  !this.initCall  = '!this.initialise()'
  !this.firstShownCall  = '!this.firstShown()'

  -- Set auto-scroll
  !this.autoScroll = true

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Create grid control objects
  !this.netSelTabItems  = object NETGRIDCONTROL()
  -- Add event handlers to .net container
  !this.netSelTabItems.addEventHandler('AfterSelectChange', !this, 'netAfterSelect')
  -- Set grid properties
  !this.netSelTabItems.fixedHeaders(false)
  !this.netSelTabItems.outlookGroupStyle(true)
  !this.netSelTabItems.columnExcelFilter(true)
  !this.netSelTabItems.headerSort(true)
  !this.netSelTabItems.columnSummaries(false)
  !this.netSelTabItems.singleRowSelection(true)
  !this.netSelTabItems.setAlternateRowColor('WHITE')

  -- Add grid controls to containers
  !this.conSelTabItems.control  = !this.netSelTabItems.handle()

  -- Callbacks
  !this.opSelTables.callback = |!this.actions(|
  !this.opSelTypes.callback = |!this.actions(|
  !this.bnSelect.callback = |!this.apply()|

  -- 3D view / local drawlist
  !this.vwView3D.shaded = true
  !viewDir[1] = 0.57735
  !viewDir[2] = 0.57735
  !viewDir[3] = -0.57735
  !this.vwView3D.direction = !viewDir
  !this.drawlist = !!gphDrawlists.createDrawList()

endmethod
-- End of method definition for .stChoose()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Form initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- Check global variable stChooseData is defined
  if (undefined(!!stChooseData)) then
    return error 1 |!!stChooseData global variable not defined!|
  endif

    -- Set forms current element
 -- if (!!stChooseData.desItem.badref()) then
   -- return error 1 |Bad definition of !!stChooseData global variable, .desigItem must be set for Modify function!|
  --endif

  -- Set form title and list tags
  !this.formTitle = |Choose | & !!stChooseData.formTitle
  !this.opSelTables.tag = !!stChooseData.tableTag
  !this.opSelTypes.tag = !!stChooseData.typeTag

  -- Inactivate 3D view
  !this.vwView3D.active = false

  -- Set selection tables
  !this.selTables = !!stChooseData.getSelTabs()

  -- Populate the table list
  !this.initSelTableList()

  -- Populate the type list
  !this.initSelTypeList()

  -- Initialise the selected type
  !this.initTable()

  -- Make properties and plotfile buttons inactive
  !this.bnSelect.active = false

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      initSelTableList
--
-- Description: Initialise selection table option list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSelTableList()

  if (!this.selTables.size() gt 0) then
    -- Populate table group option list
    !dtext = !this.selTables.evaluate(object BLOCK(|!this.selTables[!evalIndex].name|))
    !this.opSelTables.dtext = !dtext
    -- Set selected table
    !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[1])
  else
    -- Set list for none
    !dtext[1] = 'None'
    !this.opSelTables.dtext = !dtext
    -- Unset selected table group
    !this.selectedSelTab = object SELECTIONTABLE()
  endif

endmethod
-- End of method definition for .initSelTableList()
------------------------------------------------------------------------
--
-- Method:      initSelTypeList
--
-- Description: Initialise selection type option list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSelTypeList()

  if (!this.selTables.size() gt 0) then

    -- Get types for selected table
    !types = !this.selectedSelTab.getTypes()

    -- Populate type list
    if (!types.set()) then
      !this.opSelTypes.dtext = !types

      -- Select specified table type
      if (!!stChooseData.tableType.set()) then
        -- Get type index for specified type
        !typeIndex = REAL()
        do !ind indices !types
          if (!types[!ind].trim().upcase() eq !!stChooseData.tableType) then
            !typeIndex = !ind
            break
          endif
        enddo
        -- Select table type in option list and selection table object
        if (!typeIndex.set()) then
          !this.opSelTypes.val = !typeIndex
        else
          !!alert.warning(|Invalid table type specified in !!stChooseData global object. The first type in the table will be selected!|)
        endif
      endif

    else
      !dtext[1] = 'None'
      !this.opSelTypes.dtext = !dtext
    endif

  -- Set list for none
  else
    !dtext[1] = 'None'
    !this.opSelTypes.dtext = !dtext
  endif

endmethod
-- End of method definition for .initSelTypeList()

------------------------------------------------------------------------
--
-- Method:      initTable
--
-- Description: Initialise the selected Type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initTable()

  -- Clear 3D view
  if (!this.drawlist.set()) then
    !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
    !drawlist.removeAll()
    !this.vwView3D.active = false
  endif

  -- Clear choose list
  !this.netSelTabItems.clearGrid()

  -- Show choose list
  if (!this.opSelTypes.selection() ne 'None')then
    !this.selectedSelTab.setType(!this.opSelTypes.val)
    !this.choose()
  endif

endmethod
-- End of method definition for .initTable()

------------------------------------------------------------------------
--
-- Method:      actions
--
-- Description: Gadget actions for main form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actions(!object is GADGET, !action is STRING)

  -- Table group option list
  if (!object eq !this.opSelTables and !action eq |SELECT|) then
    !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[!this.opSelTables.val])
    !this.initSelTypeList()
    !this.initTable()

  -- Selection table option list
  elseif (!object eq !this.opSelTypes and !action eq |SELECT|) then
    !this.initTable()
  endif

endmethod
-- End of method definition for .actions()

------------------------------------------------------------------------
--
-- Method:      choose
--
-- Description: Choose matching table items from selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .choose()

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Get choice from selection table (answer data types converted to text)
  !questions = !!stChooseData.questions
  !answers = !!stChooseData.answers
  if (!questions.unset() or !questions.empty()) then
    !choiceItems = !this.selectedSelTab.choose(!!stChooseData.desItem, |TEXT|, TRUE)
  else
    !choiceItems = !this.selectedSelTab.choose(!!stChooseData.desItem, !questions, !answers, |TEXT|, TRUE)
  endif

  -- Save choices
  !this.choices.clear()
  do !ind indices !choiceItems
      !this.choices.append(!choiceItems[!ind].removeFirst())
  enddo

  -- Clear table ready for repopulating
  !this.netSelTabItems.clearGrid()

  -- Get headings for table
  !headings = object ARRAY()
  !headings.append('Item Name')
  !headings.appendArray(!this.selectedSelTab.getQuestions(|PURP|))
  !headings.appendArray(!this.selectedSelTab.stdGpartAtts)

  -- Total indicator
  !chooseTi = 'Choose'

  -- Bind to data source
  !ndsItems = object NETDATASOURCE(!chooseTi, !headings, !choiceItems)
  !this.netSelTabItems.bindToDataSource(!ndsItems)
  -- Select first row in the list
  !this.netSelTabItems.selectRow(0)

endmethod
-- End of method definition for .choose()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Set spref of design element to selected table item.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  !this.action.evaluate()

  !this.kill()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      netAfterSelect
--
-- Description: After select event for .net control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       !a[0] is array of selected row tags (strings)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelect(!a is ARRAY)

  -- Get local drawlist
  !drawlist = !!gphDrawlists.drawlist(!this.drawlist)

  -- Item is selected
  if (!a[0].set()) then
    -- Selected table item
    !this.selectedItem = !this.choices[!a[0][1].real()]

    -- Show in 3D view
    !gPart = !this.selectedItem.prtref
    if (!gPart.badref().not()) then
      !drawlist.removeAll()
      if (!gPart.tmpref.badref().not()) then
        !!gphViews.limits(!this.vwView3D, !gPart.tmpref)
        !drawlist.add(!gPart.tmpref)
        !this.vwView3D.active = true
      elseif (!gPart.catref.badref().not()) then
        !!gphViews.limits(!this.vwView3D, !gPart.catref)
        !drawlist.add(!gPart.catref)
        !this.vwView3D.active = true
      else
        !this.vwView3D.active = false
      endif
    endif

    -- Activate apply button
    !this.bnSelect.active = true

  -- Item is not selected
  else
    -- Deactivate buttons
    !this.bnSelect.active = false
    -- Clear 3D view
    !drawlist.removeAll()
    !this.vwView3D.active = false

  endif

endmethod
-- End of method definition for .netAfterSelect()

------------------------------------------------------------------------
--
-- Method:      firstShown
--
-- Description: Actions when form is shown for the first time.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .firstShown()

  -- Add 3D view to view system (this shows the form)
  !!gphViews.add(!this.vwView3D)

  -- Create local drawlist and add to 3D view
  !this.drawlist = !!gphDrawlists.createDrawList()
  !!gphDrawlists.attachView(!this.drawlist, !this.vwView3D)

endmethod
-- End of method definition for .firstShown()

------------------------------------------------------------------------
--
-- Method:      kill
--
-- Description: Actions when form is killed.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .kill()

  -- Remove local drawlist from drawlist system
  !!gphDrawlists.detachAllViews(!this.drawlist)

  -- Remove form from view system (this kills the form)
  !!gphViews.remove(!this.vwView3D)

endmethod
-- End of method definition for .kill()
