--
--
-- Description:
-- View setup utility for standard room design
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!accDefSetup()

  -- Find all graphical form names
  !hideForms = ARRAY()
  do !view values !!gphViews.views
     !hideForms.append( !view.fullname().before('.'))
  enddo

  -- Hide all current views
  do !hide values !hideForms
    hide $!hide
    handle ANY
    endhandle
  enddo

  if(undefined(!!gphControl)) then
    pml load form !!gphControl
    !!gphControl.initialise()
  endif

  -- Delete previously created room design views
  -- These will have a tag set to "ROOM DESIGN"
  do !i from  !!gphViews.views.size() to 1 by -1

    !view   = !!gphViews.views[!i]
    if(!view.tag.eq('ROOM DESIGN') ) then

      !formToDelete = !view.fullname().before('.').after('!!')
      -- select in the GPHCONTROL view list the view to be removed
      !!gphControl.view.select('rtext', !formToDelete)
      -- remove the view selected in GPHCONTROL
      !!gphControl.remove()
      -- initialise the GPHCONTROL form
      !!gphControl.initialise()

    endif

  enddo

  -- basic design views
  !designViews = !!gphViews.views

  -- Create two views for setup as room design default views
  !!gphViews.addDesign()
  !!gphViews.addDesign()

  -- new views added for room design
  !addedViews  = !!gphViews.views.difference(!designViews)

  -- Get the names of the last two added forms
  do !n indices !addedViews
    !newForms[!n] = !addedViews[!n].fullname().before('.')
  enddo

  !drawList1 = !!gphDrawLists.createdrawList()
  !drawList2 = !!gphDrawLists.createdrawList()

  !!gphDrawLists.drawLists[!drawList1].addOnCreate(TRUE)
  !!gphDrawLists.drawLists[!drawList2].addOnCreate(TRUE)

  !!gphDrawLists.attachView(!drawList1,$!newForms[1]$n.view)
  !!gphDrawLists.attachView(!drawList2,$!newForms[2]$n.view)

  -- Set room form title and tag design tag
  $!newForms[1]$n.formtitle = 'Room Design Plan View'
  $!newForms[2]$n.formtitle = 'Room Design Default View'
  $!newForms[1]$n.view.tag  = 'ROOM DESIGN'
  $!newForms[2]$n.view.tag  = 'ROOM DESIGN'

  -- Set initial directions of views
  !direction = object DIRECTION()
  !direction.east     = 0
  !direction.north    = 1
  !direction.up       = 0
  !!gphViews.look($!newForms[2]$n.view,!direction)

  !direction = object DIRECTION()
  !direction.east     = 0
  !direction.north    = 0
  !direction.up       = -1
  !!gphViews.look($!newForms[1]$n.view,!direction)

  -- Make sure the view shading is set
  $!newForms[1]$n.view.shaded = FALSE
  $!newForms[2]$n.view.shaded = TRUE

  !noDrawLists = !!gphDrawLists.drawLists.size()
  !dl1    = !noDrawLists
  !dl2    = (!noDrawLists - 1)
  !unusedList1  = !!gphDrawLists.drawLists[!dl1]
  !list2  = !!gphDrawLists.drawLists[!dl2]
  !list2.level(11)

  -- initialise the GPHCONTROL form
  !!gphControl.initialise()

  !!alert.message('Please use Window Tile Horizontally to see both the views')

  return

endfunction
-- End of function definition for !!AccViewSetup
