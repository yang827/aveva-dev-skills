---
-- Description:
--
-- Verifying whether the element has attribute Ceiling height
-- before calling the form
------------------------------------------------------------------------

define function !!accClnheight(!passedElement is DBREF)

  -- Set up attribute data
  !attributeData = object DBEATTRIBSEARCH(object DBREF(), 'ClnHeight', object ARRAY())

  !element         = !attributeData.element(!passedElement)
  if(!element.unset()) then
    !!alert.warning('Element doesn''t have an Ceiling Height "ClnHeight" attribute.')
    return
  endif

  if(undefined(!!accClnheight)) then
    pml reload form !!accClnheight
  endif

  if (!!accClnheight.shown() ) then
      !!accClnheight.setup(!!ce)
  else
    show !!accClnheight
  endif

endfunction
-- End of function definition
