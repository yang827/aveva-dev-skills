---
-- Description:
--  Accommodation configuration file initialisation function.
--
------------------------------------------------------------------------

define function !!accConfig()

  -- Check for global instance of accommodation configuration
  if(undefined(!!accConfig)) then
    !!accConfig = object ACCCONFIG()
  endif

endfunction
-- End of function definition
