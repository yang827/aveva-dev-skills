---
-- Description:
--  Display suitable panes while creating Accommodation elements.
--
------------------------------------------------------------------------

define function !!acccreate(!type is STRING)
   -- Get the type
   !accomType = !type.upcase()

   -- do we need to have a modify mode

  -- final type name can be retained and the other can be removed later
  if (!accomType.eq(|BLOCK|) or !accomType.substring(1,5).eq(|BUILD|) ) then
     !!accTaskManager.active(!!accMainrefdata)
         handle(2,751)
           pml load form !!accMainrefdata
           !!accTaskManager.active(!!accMainrefdata)
         endhandle
     !!accMainrefdata.bblockcreate()
  elseif (!accomType.eq(|BLEVEL|) ) then
     !!accTaskManager.active(!!accMainrefdata)
        handle(2,751)
          pml load form !!accMainrefdata
          !!accTaskManager.active(!!accMainrefdata)
        endhandle
     !!accMainrefdata.blevelcreate()
  elseif (!accomType.eq(|ROOM|) ) then
     !!accTaskManager.active(!!accRoomDefinition)
           handle(2,751)
               pml load form !!accMainrefdata
               !!accTaskManager.active(!!accRoomDefinition)
           endhandle
     !!accRoomDefinition.roomCreate()
  elseif (!accomType.eq(|WALLS|) ) then
     !!accTaskManager.active(!!accLayout)
           handle(2,751)
               pml load form !!accLayout
               !!accTaskManager.active(!!accLayout)
           endhandle
     !!accLayout.wallDefinitionTasks(TRUE)
  elseif (!accomType.eq(|CEILING|) ) then
     !!accTaskManager.active(!!accceilingDefinition)
           handle(2,751)
               pml load form !!accLayout
               !!accTaskManager.active(!!accceilingDefinition)
           endhandle
     !!accceilingDefinition.ceilingDefinition()
  elseif (!accomType.eq(|OPENING|) ) then
     !!accTaskManager.active(!!accOpeningDefinition)
           handle(2,751)
               pml load form !!accLayout
               !!accTaskManager.active(!!accOpeningDefinition)
           endhandle
     !!accOpeningDefinition.accOpeningDefinition()
  endif


endfunction
-- End of function definition
