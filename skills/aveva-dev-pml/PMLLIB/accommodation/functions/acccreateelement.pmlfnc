---
-- Description:
--  Displays the appropriate create form for the application
--
------------------------------------------------------------------------

define function !!accCreateElement(!elementType is STRING, !elementOwn is DBREF)

  -- Initialise Variable
  !type = !elementType.upcase()
  !bool = FALSE
 if (!type EQ 'BBLOCK' OR !type EQ 'BLEVEL' OR !type EQ 'ROOM' OR !type EQ 'STDROOM' OR !type EQ'DETGRP')then
 	!roomDesignExist   = object MDRLICENCEMANAGER()
  !status = !roomDesignExist.getLicence('ROOMDESIGN')
  !error = !roomDesignExist.lastError()
  if (!status lt 0) then
  	!!alert.error('$!error')
  	!bool = TRUE
  	return
 	endif
endif
if (!bool) then
	return
else
  -- Run initialisation, this checks if main components are loaded and
  -- loads them if required.
 -- !!accInitialise()
  if (defined(!!shapeDefinitionEditor)) then
    !!shapeDefinitionEditor.clearVariables()
  endif
  -- Main Reference Data
  if(!type inset('BUILD', 'BBLOCK', 'BLEVEL')) then

    -- Make form active task form
    !!accTaskManager.active('accMainRefData')

    -- Show correct panel for "building"
    if(!type inset('BUILD', 'BBLOCK')) then
      !!accMainRefData.bblockCreate()

    -- Show correct panel for "level"
    else
      !!accMainRefData.blevelCreate()
    endif

  -- Room
  elseif (!type.eq('ROOM')) then
    !!accTaskManager.active('accRoomDefinition')
    !!accRoomDefinition.roomCreate()

  -- Standard Room (copy from pre-defined rooms)
  elseif (!type.eq('STDROOM')) then
    !!accTaskManager.active('accCreStdRoom')

  -- Walls
  elseif (!type.eq('CTWALL')) then
    !!accTaskManager.active('accLayout')
    !!accLayout.initialise()
    !!accLayout.wallDefinitionTasks(true)

  -- Ceiling
  elseif (!type.eq('CEILIN')) then
    !!accTaskManager.active('accCeilingDefinition')
    !!accCeilingDefinition.ceilingCreate()

  -- Ceiling Grid
  elseif (!type.eq('CLNPNG')) then
    !!accTaskManager.active('accCeilingGridDefinition')
    !!accCeilingGridDefinition.initialise(!!ce)

  -- Ceiling Supports
  elseif (!type.eq('HANG')) then
    !!accTaskManager.active('accCeilingSupports')
    !!accCeilingSupports.initialise()

  -- Ceiling Fittings
  elseif ((!type.eq('CLNFITTING')) or ((!type.eq('HVACFI')) or (!type.eq('INFITT')) or (!type.eq('ELFITT')) or (!type.eq('FPFITT'))) $
          and ((!elementOwn.type.eq('CLNCGR') or !elementOwn.type.eq('CGRDLP') or !elementOwn.type.eq('CGRDCP') $
	   or !elementOwn.type.eq('CLNTIL') or !elementOwn.type.eq('CEILIN')))) then
    !!accTaskManager.active('accCeilingFittings')
    !!accCeilingFittings.initialise()

  elseif (!type.eq('FIXTUR')) then
 	  !!accTaskManager.active('accFittingsDefinition')
    !!accFittingsDefinition.mainTasks(true)

  -- Wall Panels
  elseif (!type.eq('WLPANE') or !type.eq('WLJOIN') or !type.eq('WLPROF')) then
    !!accTaskManager.active('accWallDetailing')
    --!!accWallDetailing.initialise()
    !!accWallDetailing.detailTasks(true)

  -- Windows and doors
  elseif !type.eq('DOOR') or !type.eq('WINDOW') then
    !!accTaskManager.active('accOpeningDefinition')
    --!!accOpeningDefinition.openingCreate(!type)

  -- Floor covering
  elseif (!type.eq('FLRCOV')) then
    !!accTaskManager.active('accFlrCoverDefinition')
    !!accFlrCoverDefinition.initialise()
    !!accFlrCoverDefinition.mainTasks(true)

  -- Element type
  --elseif(!type.eq('FURNIT') or !type.eq('FIXTUR')) then
  elseif (((!type.eq('HVACFI')) or (!type.eq('INFITT')) or (!type.eq('ELFITT')) or (!type.eq('FPFITT')) or (!type.eq('FURNIT')) or (!type.eq('FIXTUR'))) $
          and ((!elementOwn.type.eq('DETGRP') or !elementOwn.type.eq('WLFITT')))) then
    !!accTaskManager.active('accFittingsDefinition')
    !!accFittingsDefinition.mainTasks(true)

  elseif !type.eq('OPENSP') then
    !!accTaskManager.active('accOpeningDefinition')

  -- Insulation requirement
  elseif (!type.eq('INSURQ')) then
    !!accTaskManager.active('accInsurqDefinition')
    !!accInsurqDefinition.insurqCreate()

  -- Insulation requirement
  elseif (!type.eq('STRWEL')) then
    !!accTaskManager.active('accStrwellDefinition')
    !!accStrwellDefinition.strwellCreate()
  endif
endif
endfunction
-- End of function definition
