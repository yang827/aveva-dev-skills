-- Description:
--
-- Verifying whether the element has one of the attribute that
-- have impact on the elevation of the form before calling the form
------------------------------------------------------------------------

define function !!accElevation(!passedElement is DBREF)

  !elevAtts[1]     = 'FlrHeight'
  !elevAtts[2]     = 'ClnHeight'
  !elevAtts[3]     = 'Position'

  -- Set up element data don't worry about which is the attribute set as it will be taken up in the form
  !attributeData   = object DBEATTRIBSEARCH(object DBREF() , 'Elevation' , !elevAtts)

  !element         = !attributeData.element(!passedElement)
  if(!element.unset()) then
    !!alert.error('Element doesn''t have any attribute that can modify the Elevation.')
    return
  endif

  if(undefined(!!accElevation)) then
    pml reload form !!accElevation
  endif

  if (!!accElevation.shown() ) then
      !!accElevation.setup(!element)
  else
    show !!accElevation
  endif


endfunction
-- End of function definition
