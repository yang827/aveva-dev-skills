---
-- Description:
--
-- Verifying whether the element has either attribute Floor height
-- before calling the form
------------------------------------------------------------------------

define function !!accFlrheight(!passedElement is DBREF)

  -- Set up attribute data
  !attributeData = object DBEATTRIBSEARCH(object DBREF(), 'FlrHeight', object ARRAY())

  !element         = !attributeData.element(!passedElement)
  if(!element.unset()) then
    !!alert.warning('Element doesn''t have an Floor Height "FlrHeight" attribute.')
    return
  endif

  if(undefined(!!accFlrheight)) then
    pml reload form !!accFlrheight
  endif

  if (!!accFlrheight.shown() ) then
      !!accFlrheight.setup(!!ce)
  else
    show !!accFlrheight
  endif


endfunction
-- End of function definition
