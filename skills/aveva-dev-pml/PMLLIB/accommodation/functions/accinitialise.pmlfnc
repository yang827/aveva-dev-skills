---
-- Description:
--  Initialisation for main components of Accommodation application
--
------------------------------------------------------------------------

define function !!accInitialise()

  -- Check out Room Design licence - show warning message and return if not possible
  !roomDesignExist   = object MDRLICENCEMANAGER()
  !status = !roomDesignExist.getLicence('ROOMDESIGN')
--  if (!status lt 0) then
--  	return
  -- error already shown while loading or switching application
  if (!status eq 1) then
   !!alert.warning('ROOM-DESIGN licence will expire at midnight.')
  elseif (!status gt 1) then
   !!alert.warning('ROOM-DESIGN licence will expire after ' & !status & ' midnights have passed.')
  endif

  -- Check for global instance of accommodation form control object
  if(undefined(!!accControl)) then
    !!accControl = object FORMSUBSCRIPTION()
  endif

  -- Check for global instance of accommodation configuration
  if(undefined(!!accConfig)) then
    !!accConfig = object ACCCONFIG()
  endif

  -- Check if taskManager has been defined
  if(undefined(!!accTaskManager)) then
    !!accTaskManager = object ACCTASKMANAGER()
  endif

  -- Accommodation Visualization
  if(undefined(!!accVisualisation)) then
    !!accVisualisation = object ACCVISUALISATION()
    !tagNumber = !!aidNumbers.add('Accommodation Tag Numbers')
    !!accVisualisation.aidNumbers(!tagNumber)
  endif

  -- Main Navigation form
  if(undefined(!!accNavigator)) then
    pml reload form !!accNavigator
  endif

  -- Check if accommodation delete has been loaded
  if(undefined(!!accDeleteManager)) then
    !!accDeleteManager = object ACCDELETE()
  endif

  if(undefined(!!deleteManager)) then
    !!deleteManager = object DELETEMANAGER()
  endif
   -- Check if accommodation copy has been loaded
 -- if(undefined(!!copyManager)) then
 --   !!copyManager = object COPYMANAGER()
 -- endif


  -- Load error message form
  if(undefined(!!accErrorDisplay)) then
    pml reload form !!accErrorDisplay
  endif

  -- This code should convert area units to inch and metric units to
  -- metres, but not possible now, so just use standard derived units

  -- Check if area format object has been defined
  if(undefined(!!accAreaFmt)) then
    !!accAreaFmt = !!areaFmt
    if( !!isImperialLength('DIST') ) then
      -- set square inch format
      !!accAreaFmt.dp    = 0
      !!accAreaFmt.units = 'inch'
      !!accAreaFmt.label = ' sq in'
    else
      -- set square metre format
      !!accAreaFmt.dp    = 3
      !!accAreaFmt.units = 'metre'
      !!accAreaFmt.label = ' sq metre'
    endif
  endif

  -- Check if area format object has been defined
  if(undefined(!!accVolFmt)) then
    !!accVolFmt  = !!volumeFmt
    if( !!isImperialLength('DIST') ) then
      -- set cubic inch format
      !!accVolFmt.dp     = 0
      !!accVolFmt.units  = 'inch'
      !!accVolFmt.label  = ' cu in'
    else
      -- set cubic metre format
      !!accVolFmt.dp     = 3
      !!accVolFmt.units  = 'metre'
      !!accVolFmt.label  = ' cu metre'
    endif
  endif

endfunction
-- End of function definition
