---
-- Description:
--
-- Verifying whether the element has attribute Laboffset
-- before calling the form
------------------------------------------------------------------------

define function !!accLabOffset(!passedElement is DBREF)

  -- Set up attribute data
  !attributeData = object DBEATTRIBSEARCH(object DBREF(), 'LabOffset', object ARRAY())

  !element         = !attributeData.element(!passedElement)
  if(!element.unset()) then
    !!alert.warning('Element doesn''t have an Label Offset "LabOffset" attribute.')
    return
  endif

  if(undefined(!!accLabOffset)) then
    pml reload form !!accLabOffset
  endif

  if (!!accLabOffset.shown() ) then
      !!accLabOffset.setup(!!ce)
  else
    show !!accLabOffset
  endif

endfunction
-- End of function definition
