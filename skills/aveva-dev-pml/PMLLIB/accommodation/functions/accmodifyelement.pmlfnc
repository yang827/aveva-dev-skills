-- File:            accmodifyelement.pmlfnc
--   Type:          Function Definition
--   Group:         Accommodation Application
--
--     Keyword:     Element Creation
--   Module:        design
--   Replaces:
--
-- Author:          Neil Holmes
-- Created:         Thursday Nov 28 28:00:00 GMT 2006
---
-- Description:
--  Displays the appropriate modify form for the application
--
------------------------------------------------------------------------

define function !!accModifyElement(!element is DBREF)

  if(!element.olist.empty())then
    !!alert.warning('Can not modify world.')
    return
  endif

  -- Initialise Variable
  !type   = !element.type.upcase()
  !bool = FALSE
  -- Define element types handled by function, if an
  -- element is included in this list and it isn't handled
  -- within the function, there is a good chance of recursion.
  !types  = ARRAY()
  !types.append('BBLOCK')
  !types.append('BLEVEL')
  !types.append('ROOM')
  !types.append('CTWALL')
  !types.append('CEILIN')
  !types.append('STRWELL')
  !types.append('CLNPNG')
  !types.append('FLRCOV')
  !types.append('INSURQ')
  !types.append('HVACFI')
  !types.append('INFITT')
  !types.append('ELFITT')
  !types.append('FPFITT')
  !types.append('WLPANE')
  !types.append('WLPROF')
  !types.append('WLJOIN')
  !types.append('WLJOIN')
  !types.append('DOOR')
  !types.append('WINDOW')
  !types.append('HANG')
  !types.append('GENSEC')
if (!type EQ 'BBLOCK' OR !type EQ 'BLEVEL' OR !type EQ 'ROOM' OR !type EQ 'STDROOM' OR !type EQ'DETGRP')then
 	!roomDesignExist   = object MDRLICENCEMANAGER()
  !status = !roomDesignExist.getLicence('ROOMDESIGN')
  !error = !roomDesignExist.lastError()
  if (!status lt 0) then
  	!!alert.error('$!error')
  	!bool = TRUE
  	return
 	endif
endif
if (!bool) then
	return
else
  -- Run initialisation, this checks if main components are loaded and
  -- loads them if required.
  !!accInitialise()

  -- Main Reference Data
  if(!type inset('BBLOCK', 'BLEVEL')) then

    -- Make form active task form
    !!accTaskManager.active('accMainRefData')

    -- Show correct panel
    if(!type.eq('BBLOCK')) then
      !!accMainRefData.bblockModify(!element)
    else
      !!accMainRefData.blevelModify(!element)
    endif

  -- Room
  elseif (!type.eq('ROOM')) then

    -- Make form active task form
    !!accTaskManager.active('accRoomDefinition')
    !!accRoomDefinition.roomModify(!element)

  -- Ceiling
  elseif (!type.eq('CEILIN')) then
    !!accTaskManager.active('accCeilingDefinition')
    !!accCeilingDefinition.ceilingModify(!element)

  -- Ceiling
  elseif (!type.eq('STRWEL')) then
    !!accTaskManager.active('accStrWellDefinition')
    !!accStrwellDefinition.strwellModify(!element)

  -- Ceiling Grid
  elseif (!type.eq('CLNPNG')) then
    !!accTaskManager.active('accCeilingGridDefinition')
    !!accCeilingGridDefinition.modify(!element)

  -- Ceiling Hanger
  elseif (!type.eq('HANG')) then
    !!accTaskManager.active('accCeilingSupports')
    --!!accCeilingSupports.hangerModify(!element)
    !!accCeilingSupports.mainTasks(true)

  elseif (!type.eq('GENSEC') and (!element.owner.purp eq 'SUPP')) then
    !!accTaskManager.active('accCeilingSupports')
    !!accCeilingSupports.supportModify(!element)

  -- Floor Covering
  elseif (!type.eq('FLRCOV')) then
    !!accTaskManager.active('accFlrCoverDefinition')
    !!accFlrcoverDefinition.flrcoverModify(!element)

  -- Floor Covering
  elseif (!type.eq('INSURQ')) then
    !!accTaskManager.active('accInsurqDefinition')
    !!accInsurqDefinition.insurqModify(!element)

  -- Wall Layout
  elseif (!type.eq('CTWALL'))then
    !!accTaskManager.active('accLayout')
    !!accLayout.wallModificationTasks(true)

  -- Wall Details
  elseif ((!type.eq('WLPANE')) or (!type.eq('WLJOIN')) or (!type.eq('WLPROF'))) then
  !!accTaskManager.active('accWallDetailing')
    !!accWallDetailing.modify(!element)

  -- Windows and doors
  elseif !type.eq('DOOR') or !type.eq('WINDOW') then

  !!accTaskManager.active('accOpeningDefinition')
  !!accOpeningDefinition.selectedOpening = !element
  !!accOpeningDefinition.showOpeningPanel(TRUE)
  !!accOpeningDefinition.selectedOpening = !element
  !!accOpeningDefinition.showEditPanel(TRUE,FALSE )

  -- Ceiling Fittings
  elseif (((!type.eq('HVACFI')) or (!type.eq('INFITT')) or (!type.eq('ELFITT')) or (!type.eq('FPFITT'))) $
            and ((!element.owner.fulltype eq 'CGRDCP') or (!element.owner.fulltype eq 'CGRDLP') or (!element.owner.fulltype eq 'CLNCGR') or (!element.owner.fulltype eq 'CLNTIL'))) then
    !!accTaskManager.active('accCeilingFittings')
    !!accCeilingFittings.modify(!element)

  -- Element type
  elseif (((!type.eq('HVACFI')) or (!type.eq('INFITT')) or (!type.eq('ELFITT')) or (!type.eq('FPFITT')) or (!type.eq('FURNIT')) or (!type.eq('FIXTUR'))) $
            and (((!element.owner.type eq 'WLFITT' and !element.own.own.type.eq('WLFEAT'))) or (!element.owner.type eq 'DETGRP'))) then
    !!accTaskManager.active('accFittingsDefinition')
    -- setup the element
    !!accFittingsDefinition.currentelempick(!element)
    -- modify working fitting
    !!accFittingsDefinition.modifySelection()
  else

    -- Determine if we modify one of owning element
    !owningElements = !element.ownLst
    !owningTypes    = !element.ahList

    -- Quick check to see if one of the owners is
    -- handled by the function
    if(!owningTypes.intersect(!types).set()) then

      -- Move up the list of element until we find
      -- one that is handled by the function
      !owningElements.invert()
      !owningTypes.invert()
      do !i indices !owningElements
        if(!types.findFirst(!owningTypes[!i]).set()) then
          !!accModifyElement(!owningElements[!i])
          return
        endif
      enddo

    else
      !!alert.warning('Element ($!!ce) or any of its parents are not a  valid room design element.')
      return
    endif
  endif
endif
endfunction
-- End of function definition
