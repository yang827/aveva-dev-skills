---
-- Description:
-- Verifying whether the zdir is vertical before calling the form
-- and the passed element has either attribute NAngle or orientation
------------------------------------------------------------------------

define function !!accNangle(!passedElement is DBREF)

  !oriAtts[1] = 'Orientation'

  -- Set up attribute data
  !attributeData = object DBEATTRIBSEARCH(object DBREF(), 'NAngle', !oriAtts)

  !element         = !attributeData.element(!passedElement)
  if(!element.unset()) then
    !!alert.error('Element doesn''t have an North angle "NAngle" attribute.')
    return
  endif

  if(undefined(!!accNangle)) then
    pml reload form !!accNangle
  endif

    if (!element.orientation.wrt(world).zdir().up.abs().eq(1) ) then
       -- display the form
       !!ce = !element
       if (!!accNangle.shown() ) then
           !!accNangle.setup(!element)
       else
         show !!accNangle
       endif
    else
       !name = !element.namn
       !!alert.error('Unable to set Nangle for $!name as the zdir is not in vertical axis')
    endif

endfunction
-- End of function definition
