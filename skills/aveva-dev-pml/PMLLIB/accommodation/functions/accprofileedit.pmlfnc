-- File:            accprofileedit.pmlfnc
--   Type:          Function Definition
--   Group:         Room Design

--     Keyword:     Profile Modify
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu May 22 14:00:00 "BST 2008
--
--
-- Description:
--   Invocation for profile editor for room design loop based elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Profile to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if loop found
--
------------------------------------------------------------------------

define function !!accProfileEdit(!element is DBREF) is BOOLEAN

  -- Initialise Variables
  !loop = object DBREF()

  -- Check if form has been build
  if(undefined(!!dbeProfileEdit)) then
    pml reload form !!dbeProfileEdit
  endif

  -- Determine the loop based element to edit
  if(!element.type.neq('LOOP')) then

    -- If element is not a Loop, then look for the first BNDLIN
    -- directly below the passed element
    !boundary         = BNDLIN 1 of $!<element>
    handle ANY
      --## Look for other elements which may have a loop if the BNDLIN
      --## does not exist, this may mean going up a level to the owner
      --## if it is in the room design hierarchy

    elsehandle NONE
      !loop           = LOOP 1 of $!<boundary>
    endhandle

  -- Passed element is a loop
  else
    !loop = !element
  endif

  -- We need to determine which are the "same" loops so that when
  -- we save the modified loop we automatically update the others
  -- The "same" need to be held in a global variable, so that they
  -- can be accessed by the modify function once the "loop" has been
  -- changed, as it would be difficult to determine the "same" once
  -- it has been changed. Messy but quick and dirty.

  -- Remove the transfer global variable, if one already exists
  if(defined(!!accSameProfileDefinitions)) then
    !!accSameProfileDefinitions.delete()
  endif

  -- !scope is usually the same as !element - exception if element is a AREADE say
  !scope = !boundary.owner
  handle ANY
    !scope = !element
  endhandle

  -- Collect all loop below element to check for similarities
  !collection       = object COLLECTION()
  !collection.type('LOOP')
  !collection.scope(!scope)
  !loops            = !collection.results()

  -- Check for loops within element
  if(!loops.set()) then

    -- Get Base information we are going to compare for "similarity"
    -- on the loops, i.e. area, edge length, should give a good
    -- approximation as a deep level compare will always not find
    -- similarities because of dbref info.

    --## We might have to check that the orientation is the same and
    --## that the projected edges (or some) common on a base reference plane

    !areas        = ARRAY()
    !lengths      = ARRAY()

    do !i indices !loops
      !profile    = object PROFILE(!loops[!i])
      !areas.append(!profile.area().int())
      -- ignore degenerate loops
      handle ANY
        !areas.append(-1.0)
        !lengths.append(-1.0)
      elsehandle NONE
        !lengths.append(!profile.length().int())
      endhandle
    enddo

    -- Get area of the loop
    !index        = !loops.findFirst(!loop)
    !area         = !areas[!index]
    !length       = !lengths[!index]
    !areaList     = !areas.find(!area)
    !lengthList   = !lengths.find(!length)

    -- Get loops which are similar
    !similar      = !areaList.intersect(!lengthList)

    -- Define list of "same" profiles
    !sameList     = ARRAY()
    do !i values !similar
      skip if(!i.eq(!index))
      !sameList.append(!loops[!i])
    enddo

    if(!sameList.set()) then
      !!accSameProfileDefinitions = !sameList
    endif

  endif

  if(!loop.set()) then
      -- Setup and show form
      !action = '!!accProfileModify(!loop)'
      !!dbeProfileEdit.setup(!loop, !action)
   else
      !!alert.error('No geometry to modify')
      return false
   endif
  -- Return
  return true

endfunction
-- End of function definition
