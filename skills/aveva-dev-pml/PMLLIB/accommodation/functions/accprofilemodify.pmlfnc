-- Created:         Thu May 22 14:00:00 "BST 2008
  --
--
-- Description:
--   Carries out secondary action for profile modification of room design elements
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBELOOP     Base loop element to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define function !!accProfileModify(!dbeLoop is DBELOOP) is BOOLEAN

  -- Initialise Variables
  !profile  = !dbeLoop.profile

  -- If global variable exists, loop through the loops and apply
  -- the profile to the loops
  do !i indices !!accSameProfileDefinitions

    -- Owner of loop
 --   !owner        = !!accSameProfileDefinitions[!i].owner

    -- Map profile on to loop
    !loopProfile  = !profile
 --   !loopProfile.position     = !owner.position
 --   !loopProfile.orientation  = !owner.orientation

    !loopProfile.dbWrite(!!accSameProfileDefinitions[!i])
  enddo

  -- Return
  return true

endfunction
-- End of function definition
