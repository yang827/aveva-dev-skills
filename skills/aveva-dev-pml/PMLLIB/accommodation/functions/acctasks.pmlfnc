---
-- Description:
--  Loads and displays main task panes for accommodation application
--
------------------------------------------------------------------------

define function !!accTasks(!mainTask is STRING)

  -- Initialise Variable
  !task = !mainTask.upcase()

  -- Run initialisation, this checks if main components are loaded and
  -- loads them if required.
  !!accInitialise()

  -- Navigator
  if(!task.eq('NAVIGATOR')) then
    show !!accNavigator free

  -- Visualisation
  elseif (!task.eq('VISUALISATION')) then
    show !!accViewSetup free

  -- Main Reference Data
  elseif (!task.eq('MAINREFDATA')) then
    !!accTaskManager.active('accMainRefData')
    !!accMainRefData.mainTasks(true)

  -- Layout
  elseif (!task.eq('LAYOUT')) then
    !!accTaskManager.active('accLayout')
    !!accLayout.mainTasks(true)

  -- Detailing
  elseif (!task.eq('DETAILING')) then
    !!accTaskManager.active('accDetail')
    !!accDetail.mainTasks(true)

  -- Ceiling
  elseif (!task.eq('CEILING')) then
    !!accTaskManager.active('accCeilingDefinition')
    !!accCeilingDefinition.mainTasks(true)

  endif

  --CEILING
endfunction
-- End of function definition
