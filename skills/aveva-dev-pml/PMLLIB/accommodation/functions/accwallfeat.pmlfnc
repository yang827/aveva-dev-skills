--
-- Author:          Richard Martin
-- Created:         Thur Nov 28 28:00:00 GMT 2006
--
-- Description:
--  Returns the wall feature for the passed element of the given purpose
--  if there isn't one, then one is created beneath the element.
--
------------------------------------------------------------------------

define function !!accwallfeat(!owner is DBREF, !purpose is STRING, !description is STRING) is DBREF

  -- Initialise Variables
  !reference          = !!ce

  -- Check if element can own or is owned by a DETGRP
  !otypes             = !owner.ahlist
  !otypes.append(!owner.type)
  !ownList            = !owner.ownlst
  !ownList.append(!owner)
  !oIndex             = !otypes.findFirst('WLFEAT')

  -- Return detail group if of correct purpose
  if(!oIndex.set()) then
    if(!ownList[!oIndex].purpose.eq(!purpose)) then
      return !ownList[!oIndex]
    endif

    -- If element is WALL FEAT, then set owner to its owne
    if(!owner.type.eq('WLFEAT')) then
      !owner          = !owner.owner
    endif
  endif

  -- Get detail groups of element
  var !wallFeatures collect members of $!<owner> with (TYPE eq 'WLFEAT' and FUNC eq '$!purpose')

  -- Create detail group
  if(!wallFeatures.unset()) then
    !!ce              = !owner
    NEW WLFEAT
    !wallFeature      = !!ce
    !!ce.description  = !description
    !!ce.function      = !purpose

    if(!!ce.owner.isNamed) then
      call !!autoNameCe(false)
    endif
    !!ce              = !reference
  else
    !wallFeature      = !wallFeatures.first().dbref()
  endif

  -- Return
  return !wallFeature

endfunction
-- End of function definition
