---
-- Description:
--
-- Verifying whether the element has attribute XYoffset
-- before calling the form
------------------------------------------------------------------------

define function !!accXYoffset(!passedElement is DBREF)

  -- Set up attribute data
  !posAtts[1]  = 'Position'
  !attributeData = object DBEATTRIBSEARCH(object DBREF() , 'XYOffset' , !posAtts)

  !element         = !attributeData.element(!passedElement)
  if(!element.unset()) then
    !!alert.warning('Element doesn''t have an XYOffset or Position attribute.')
    return
  endif

  if(undefined(!!accXYoffset)) then
    pml reload form !!accXYoffset
  endif

  if (!!accXYoffset.shown() ) then
      !!accXYoffset.setup(!!ce)
  else
    show !!accXYoffset
  endif

endfunction
-- End of function definition
