---
-- Description:
-- Verifying whether the zdir is vertical before calling the form
-- and the passed element has either attribute NAngle or orientation
------------------------------------------------------------------------

define function !!SlopeAngle(!passedElement is DBREF)

  -- Set up attribute data
  !attributeData = object DBEATTRIBSEARCH(object DBREF(), 'Orientation', object ARRAY())

  !element         = !attributeData.element(!passedElement)
  if(!element.unset()) then
    !!alert.error('Element doesn''t have an "Orientation" attribute.')
    return
  endif

  if(undefined(!!SlopeAngle)) then
    pml reload form !!SlopeAngle
  endif
       -- display the form
       !!ce = !element
       if (!!SlopeAngle.shown() ) then
           !!SlopeAngle.setup(!element)
       else
         show !!SlopeAngle
       endif

endfunction
-- End of function definition
