---
-- Description:
--  shows the stchoose form for picking a spref with appropriate filters to allow proper picking
--
-- Arguments
-- num   arg     type    description
-- (1) !title    STRING  sets the title of the called form
-- (2) !type     STRING  this is the purpose of the catalogue tab group that will be used to find components (eg. 'ACCO')
-- (3) !filters  ARRAY   an array of question and answers that refer to tabitems in the catalogue (i.e. !filters[!i][1] = question, !filters[!i][2] = answer
-- (4) !gadget   GADGET  sets a gadget on a user specified form that the selection is returned to
------------------------------------------------------------------------

define function !!stchoosefilter(!title is STRING, !type is STRING, !filters is ARRAY, !gadget is GADGET)

  !!stchoosedata.cleardata()
  !!stchoosedata.settitle(!title)

  !!stchoosedata.setdata(!type)

  do !i from 1 to !filters.size()

    !!stchoosedata.questions[!i] = !filters[!i][1]
    !!stchoosedata.answers[!i] = !filters[!i][2]

  enddo

  !!stchoosedata.setTable()
  !!stchooseselection.calledGadget = !gadget
  show !!stchooseselection

endfunction
