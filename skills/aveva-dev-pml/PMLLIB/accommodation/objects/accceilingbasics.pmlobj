-- Created:         Wednesday Feb 21 10:00:00 GMT 2007
---
-- Description:
--    Object for creating basic room definitions along with automatic
--    creation of offspring elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accCeilingBasics()               -                   Constructor
--  accCeilingBasics(DBECEILING)     -                   Constructor
--  create()                         -                   Create basics for ceiling
--  defineCeilingGrid(BOOLEAN)       -                   Define ceiling grid
--  definePhysicalCeiling(BOOLEAN)   -                   Define a pane representing the ceiling volume
--

define object ACCCEILINGBASICS

  -- Room element
  member .dbElement           is DBREF

  -- Room definition
  member .definition          is DBECEILING

  -- Undo for form
  member .undo                is UNDOABLE

  -- Panel Thickness
  member	.clnThick				    is REAL

  -- Create options
  member .defineCeilingGrid   is BOOLEAN
  member .definePhysCeiling   is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      accCeilingBasics
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accCeilingBasics()

  -- Initialise Variables
  !this.defineCeilingGrid   = FALSE
  !this.definePhysCeiling   = FALSE

endmethod

------------------------------------------------------------------------
--
-- Method:      accCeilingBasics
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accCeilingBasics(!definition is DBECEILING)

  -- Initialise Variables
  !this.accCeilingBasics()
  !this.dbElement           = !definition.dbElement
  !this.definition          = !definition
  !this.clnThick					  = !definition.clnThick

endmethod

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create basics for ceiling
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create()

  -- Initialise Variables
  !reference    = !!ce
  !element      = !this.dbElement

  -- Generate Boundary and Area Definition
  if(!this.definition.outerLoop.set()) then
    !!ce              = !element

    -- Create boundary
    NEW BNDLIN
    !boundary         = !!ce
    !!ce.description  = 'Boundary'

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif
    NEW LOOP
    !this.definition.outerLoop.dbWrite(CE)

    if (!this.definition.innerLoops.set()) then
      !innerLoops = !this.definition.innerLoops
      do !i indices !innerLoops
         NEW LOOP
         !innerLoops[!i].dbWrite(CE)
      enddo
    endif

    -- Create Area definition
    NEW AREADEF
    --!volume           = !!ce
    !!ce.description  = 'Volume'

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif
    NEW AEXTR
    !!ce.obs = 0
    !extrusion        = !!ce
    !extrusion.height = !this.definition.clnVoid
    RULE SET HEIGHT STATIC (clnVoid of CEILIN)
    NEW LOOP
    !this.definition.outerLoop.dbWrite(CE)

    -- Set the label position to the mid point of the areadef as a default
    !cofg                 = !extrusion.gcofg
    handle ANY
    elsehandle NONE
      !labOffset[1]       = !cofg.east
      !labOffset[2]       = !cofg.north
      !labOffset[3]       = 0
      !element.labOffset  = !labOffset
    endhandle

  endif

  -- Define Ceiling Grid
  if(!this.defineCeilingGrid) then
    !!ce                    = !element
    NEW CLNPNG
    !ceilingGrid            = !!ce
    !ceilingGrid.labOffset  = !element.labOffset

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif

    -- This should be held in the config as a default
    -- potentially against the "ceiling Type/Code
    !xGrid[1]         = 600
    !yGrid[1]         = 600
    !ceilingGrid.grdXSpacing  = !xGrid
    !ceilingGrid.grdYSpacing  = !yGrid

    -- Set design criteria
    !ceilingGrid.fireRating   = !element.fireRating
    !ceilingGrid.colSchema    = !element.colSchema

    if(!this.definition.outerLoop.set()) then
      NEW BNDLIN
      !boundary         = !!ce
      !!ce.description  = 'Ceiling Grid Boundary'

      -- Name element
      if(!ceilingGrid.isNamed) then
        call !!autoNameCe(false)
      endif

      -- Name element
      if(!element.isNamed) then
        call !!autoNameCe(false)
      endif
      NEW LOOP
      !this.definition.outerLoop.dbWrite(CE)

    endif

    if (!this.definition.innerLoops.set()) then
      !innerLoops = !this.definition.innerLoops
      do !i indices !innerLoops
         NEW LOOP
         !innerLoops[!i].dbWrite(CE)
      enddo
    endif

  endif

  -- Define physical ceiling
  if (!this.definePhysCeiling) then
    !!ce                     = !element
    NEW PANE
    !unusedPane = !!ce

    NEW PLOO
    !!ce.height = !this.clnThick
  	if(!this.definition.clnMaterial.set()) then
  	  !this.dbElement.matref  = !this.definition.clnMaterial
  	  --!!ce.matref = !this.definition.clnMaterial
  	else
  	  !ref = !!ce
  	  !!ce = !this.dbElement
  	  Matref nulref
  	  !!ce = !ref
  	endif

    !this.definition.outerLoop.dbWrite(CE)

  endif

  -- Return to original element
  !!ce        = !reference

endmethod

------------------------------------------------------------------------
--
-- Method:      defineCeilingGrid
--
-- Description: Define ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineCeilingGrid(!create is BOOLEAN)
  !this.defineCeilingGrid = !create
endmethod

------------------------------------------------------------------------
--
-- Method:      definePhysicalCeiling
--
-- Description: Define a pane representing the ceiling volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definePhysicalCeiling(!create is BOOLEAN)

  !this.definePhysCeiling = !create
  if (!create) then
  	!this.defineCeilingGrid = false
  endif

endmethod
