---
-- Description:
--  Content collection object (collects DETGRPs and their contents)
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accCollectContents()             -                   Constructor
--  collectAllContents()             ARRAY               Collect all contents for current scope
--  collectAllOfType(ARRAY)          -
--  collectAllOfType(STRING)         ARRAY               Collect all contents for current scope of passed type
--  collectContents()                ARRAY               Collect content using objects settings
--  collectDirectContents()          ARRAY               Collect contents directly owned by current scope
--  collectDirectOfType(STRING)      ARRAY               Collect contents directly owned by current scope of passed type
--  collectDirectOfTypes(ARRAY)      ARRAY               Collect contents directly owned by current scope of passed types
--  detailElementTypes()             -                   List of element types that can be owne by a DETGEP
--  scope(DBREF)                     BOOLEAN             Set scope of scan, return any errors via !!error.message
--
------------------------------------------------------------------------

define object ACCCOLLECTCONTENTS

  -- Scope
  member .scope           is DBREF

  -- Element types
  member .types           is ARRAY

  -- List of element
  member .elements        is ARRAY

  -- Scan type for contents (Only directly owned element or all element beneath scope)
  -- Directly owned elements are the element owned by the DETGRP of the scope element
  member .scanDirect      is BOOLEAN
  member .scanAll         is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:     accCollectContents
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accCollectContents()

  -- Initialise Variables
  !this.scanDirect  = true
  !this.scanAll     = !this.scanDirect.not()

  -- Element types owned by a DETGRP
  !this.detailElementTypes()

endmethod

------------------------------------------------------------------------
--
-- Method:     detailElementTypes
--
-- Description: List of element types that can be owne by a DETGEP
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .detailElementTypes()

  -- Ideally we need to get the LIST of a DETGRP, but without the element existing
  !this.types.clear()
  !this.types.append('CEILIN')
  !this.types.append('CLNPNG')
  !this.types.append('WINDOW')
  !this.types.append('DOOR')
  !this.types.append('FLRCOV')
  !this.types.append('INSURQ')
  !this.types.append('FURNIT')
  !this.types.append('FIXTUR')
  !this.types.append('ELFITT')
  !this.types.append('HVACFI')
  !this.types.append('FPFITT')
  !this.types.append('INFITT')
  !this.types.append('HANDRA')
  !this.types.append('LADDER')
  !this.types.append('CTWALL')
  !this.types.append('CLNTIL')

endmethod

------------------------------------------------------------------------
--
-- Method:     scope
--
-- Description: Set scope of scan, return any errors via !!error.message
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Scope of scan
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Scope element is to start from
--
------------------------------------------------------------------------

define method .scope(!scope is DBREF) is BOOLEAN

  -- Initialise Variables
  if(!scope.unset()) then
    !!error.text      = 'Unset DBREF passed.'
    return false
  endif

  -- If element is not DETGRP, then look for owning DETGRP
  if(!scope.type.eq('DETGRP')) then
    !this.scope       = !scope

  -- Get owning DETGRP or see if element can own a DETGRP
  else
    if(!scope.list.findFirst('DETGRP').set()) then
      !this.scope     = !scope

    -- Get owning DETGRP is possible
    else
      !index          = !scope.ahList.findFirst('DETGRP')
      if(!index.set()) then
        !this.scope   = !scope.ownLst[!index]

        -- Look for a parent that can own a DETGRP
      else

        -- Loop through parents
        !owners       = !scope.ownLst.invert()
        do !owner values !owners
          if(!owner.list.findFirst('DETGRP').set()) then
            !this.scope     = !owner
            return true
          endif
        enddo

        !!error.text  = 'Element ' & !scope.flnn & ' is not or not a member of a DETGRP.'
        return false
      endif
    endif
  endif

  -- Return
  return true

endmethod

------------------------------------------------------------------------
--
-- Method:     collectAllContents
--
-- Description: Collect all contents for current scope
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of element
--
------------------------------------------------------------------------

define method .collectAllContents() is ARRAY
  !this.scanDirect  = false
  !this.scanAll     = !this.scanDirect.not()
  return !this.collectContents()
endmethod

------------------------------------------------------------------------
--
-- Method:     collectAllOfType
--
-- Description: Collect all contents for current scope of passed type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .collectAllOfType(!type is STRING) is ARRAY
  !this.scanDirect  = false
  !this.scanAll     = !this.scanDirect.not()
  !this.types.clear()
  !this.types.append(!type)
  return !this.collectContents()
endmethod

------------------------------------------------------------------------
--
-- Method:     collectAllOfTypes
--
-- Description: Collect all contents for current scope of passed types
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .collectAllOfType(!types is ARRAY)
  !this.scanDirect  = false
  !this.scanAll     = !this.scanDirect.not()
  !this.types       = !types
  return !this.collectContents()
endmethod

------------------------------------------------------------------------
--
-- Method:     collectDirectContents
--
-- Description: Collect contents directly owned by current scope
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of element
--
------------------------------------------------------------------------

define method .collectDirectContents() is ARRAY
  !this.scanDirect  = true
  !this.scanAll     = !this.scanDirect.not()
  return !this.collectContents()
endmethod

------------------------------------------------------------------------
--
-- Method:     collectDirectOfType
--
-- Description: Collect contents directly owned by current scope of passed type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .collectDirectOfType(!type is STRING) is ARRAY
  !this.scanDirect  = true
  !this.scanAll     = !this.scanDirect.not()
  !this.types.clear()
  !this.types.append(!type)
  return !this.collectContents()
endmethod

------------------------------------------------------------------------
--
-- Method:     collectDirectOfTypes
--
-- Description: Collect contents directly owned by current scope of passed types
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .collectDirectOfTypes(!types is ARRAY) is ARRAY
  !this.scanDirect  = true
  !this.scanAll     = !this.scanDirect.not()
  !this.types       = !types
  return !this.collectContents()
endmethod

------------------------------------------------------------------------
--
-- Method:     collectContents
--
-- Description: Collect content using objects settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of element
--
------------------------------------------------------------------------

define method .collectContents() is ARRAY

  -- Initialise Variables
  !this.elements.clear()

  -- Check we have a scope

  -- Check we have a list of elements to search for

  -- If scope is Detail group
  if(!this.scope.type.eq('DETGRP')) then
    !detailGroups[1]  = !this.scope

  -- Search for Detail groups
  else
    -- Define scope of collection
    !collection       = object COLLECTION()
    !collection.scope(!this.scope)
    !collection.type('DETGRP')

    -- Define expression for getting only directly owned DETGRP of scope element
    if(!this.scanDirect) then
      !depth        = !this.scope.ddepth + 1
      !expression   = object EXPRESSION('DDEPTH eq ' & !depth )
      !collection.filter(!expression)
    endif

    -- Get DETGRP elements
    !detailGroups     = !collection.results()

  endif

  -- If there are no detail groups
  if(!detailGroups.empty()) then
    return ARRAY()
  endif

  -- Collect all element types required
  !collection         = object COLLECTION()
  !collection.scope(!detailGroups)
  !collection.types(!this.types)
  !this.elements      = !collection.results()

  -- Return
  return !this.elements

endmethod
