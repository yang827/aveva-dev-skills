------------------------------------------------------------------------
--
-- Method: typeDescription
--
-- Description: Returns description of type (use alternative text is available)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type
-- Return:
--   [Data Type] [Description]
--    STRING      Description text
--
------------------------------------------------------------------------
define method .typeDescription(!passedType is STRING) is STRING

  -- Initialise Variables
  !type = !passedType.upcase()

  -- Descriptions managed by the object
  if(!type.eq('BBLOCK')) then
    if (  !this.bblock.empty() ) then
      !return = 'Bblock'
    else
      !return   = !this.bblock
    endif
  elseif (!type.eq('BLEVEL')) then
    if (  !this.blevel.empty() ) then
      !return = 'Blevel'
    else
      !return   = !this.blevel
    endif
  elseif (!type.eq('ROOM')) then
    if (  !this.room.empty() ) then
      !return = 'Room'
    else
      !return   = !this.room
    endif

  -- Get report text of element
  else
    var !rptx noundef $!type rptx
    handle ANY
   --!return = !passedTypes
    elsehandle NONE
      !return = !rptx[1]
    endhandle

  endif

  -- Return
  return !return

endmethod

------------------------------------------------------------------------
