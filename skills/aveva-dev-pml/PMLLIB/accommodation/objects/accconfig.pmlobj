-- File:            accconfig.pmlobj
--   Type:          Object Definition
--   Group:         Accommodation Application
--
--     Keyword:     Configuration
--   Module:        design
--   Replaces:
--
-- Author:          Neil Holmes
-- Created:         Sunday Oct 29 20:00:00 GMT 2006
---
-- Description:
--  Accommodation configuration file:
--    This file should be used to hold configuration information about
--    the accommodation application.
--
--    This object should have a form for allowing users to set configuration
--    information, any changes should automatically update the file without
--    prompting the users to write/overwrite/create the file.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accConfig()                      -                   Constructor
--  altName(STRING,STRING)           -                   Set Alternative names
--  ceilingCodes()                   ARRAY
--  ceilingTypes()                   ARRAY
--  colourSchemes()                  ARRAY
--  fireRatings()                    ARRAY
--  floorCodes()                     ARRAY
--  floorTypes()                     ARRAY
--  load()                           -                   Load configuration file
--  load(FILE)                       -                   Load configuration file
--  locateFile()                     FILE                Load configuration file
--  occupancyTypes()                 ARRAY
--  openingCodes()                   ARRAY
--  openingTypes()                   ARRAY
--  readDfltFile(FILE)               ARRAY
--  roomFunctions()                  ARRAY
--  setDefaults()                    -
--  typeDescription(STRING)          STRING
--  updateFileData()                 -                   Load configuration file
--  writeFile()                      BOOLEAN
--
------------------------------------------------------------------------

define object ACCCONFIG

  -- Alternative descriptions for elements
  member .bblock            is STRING
  member .blevel            is STRING
  member .room              is STRING

  -- Navigator display options
  member .navigator         is GRIDCONTROLDEFAULTS

  -- Positioning Format
  member .positionFormat    is STRING

  -- Position
  member .bpos              is ARRAY

  -- COnfiguration files
  member .userConfig        is FILE
  --member .dfltsConfig     is FILE
  member .pdmsConfig        is FILE
  member .projConfig        is FILE

  -- default values for room elements
  -- Default door sill
  member .dDoorSill         is REAL

  -- Default Window  sill
  member .dWindowSill       is REAL

  -- Floor height from level
  member .flrHeight         is REAL

  -- Ceiling Height
  member .clnHeight         is REAL

  -- Stair Well attributes
  -- Head Room
  member .headRoom         is REAL

  -- Head Clearance
  member .headClear         is REAL

  -- Clearance Width
  member .clearWidth         is REAL

  -- Lattice Profile length
  member .latticeProfile     is REAL

  -- Panel Profile length
  member .panelProfile       is REAL

  -- Tables of reference text
  member .colourSchemes     is ARRAY
  member .fireRatings       is ARRAY
  member .ceilingTypes      is ARRAY
  member .ceilingCodes      is ARRAY
  member .openingTypes      is ARRAY
  member .openingCodes      is ARRAY
  member .hazardTypes       is ARRAY
  member .floorTypes        is ARRAY
  member .floorCodes        is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      accConfig
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accConfig()

  -- set default values to avoid any unset value
  !this.setDefaults()

  -- Load configuration file, read data from configuration file
  !this.load()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setDefaults
--
-- Description: Set the defaults in case the user
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDefaults()

  -- General Defaults
  !this.bblock  = 'Building Block'
  !this.blevel  = 'Floor Elevation'
  !this.room    = 'Room'

  -- Positioning Default
  !this.positionFormat  = 'XYZ'
  if(!!isImperialLength('DIST')) then
 	!this.bpos[0] =  400in
  !this.bpos[1] =  80in
  !this.bpos[2] =  120in
 else
  !this.bpos[0] =  10000mm
  !this.bpos[1] =  2000mm
  !this.bpos[2] =  3000mm
 endif

  -- Navigator Defaults
 !this.navigator.columnExcelFilter = false
 !this.navigator.outlookGroupStyle = false
 !this.navigator.columnSummaries   = false
 !this.navigator.labelVisibility   = false

 -- Room attributes
 if(!!isImperialLength('DIST')) then
  !this.dDoorSill        = 4in
  !this.dWindowSill      = 4in
  !this.flrHeight        = 4in
  !this.clnHeight        = 8ft
  !this.headRoom         = 8ft
  !this.headClear        = 2ft
  !this.clearWidth       = 4ft
  !this.latticeProfile   = 20ft
  !this.panelProfile     = 10ft

 else
  !this.dDoorSill        = 100mm
  !this.dWindowSill      = 100mm
  !this.flrHeight        = 100mm
  !this.clnHeight        = 2400mm
  !this.headRoom         = 2400mm
  !this.headClear        = 600mm
  !this.clearWidth       = 1200mm
  !this.latticeProfile   = 6000mm
  !this.panelProfile     = 3000mm
 endif

 !this.colourSchemes[1]  = 'BASIC'
 !this.colourSchemes[2]  = 'WHITE'
 !this.colourSchemes[3]  = 'PASTELS'
 !this.colourSchemes[4]  = 'STANDARD'
 !this.colourSchemes[5]  = 'LUXURY'

 !this.fireRatings[1]    = 'A'
 !this.fireRatings[2]    = 'B'

 !this.ceilingTypes[1]   = 'SUSPENDED'
 !this.ceilingTypes[2]   = 'PLASTERED'

 !this.ceilingCodes[1]   = 'ABCD'
 !this.ceilingCodes[2]   = 'PQRS'

 !this.hazardTypes[1]   = 'WET AREA'
 !this.hazardTypes[2]   = 'LOW BEAMS'
 !this.hazardTypes[3]   = 'HAZARDOUS CHEMICALS'
 !this.hazardTypes[4]   = 'RADIOACTIVE AREA'

 !this.floorTypes[1]     = 'BASIC'
 !this.floorTypes[2]     = 'UTILITY'
 !this.floorTypes[3]     = 'SOLID'
 !this.floorTypes[4]     = 'CARPETED'
 !this.floorTypes[5]     = 'WOODEN'
 !this.floorTypes[6]     = 'STANDARD'
 !this.floorTypes[7]     = 'LUXURY'

 !this.floorCodes[1]     = 'BAS'
 !this.floorCodes[2]     = 'UTI'
 !this.floorCodes[3]     = 'SOL'
 !this.floorCodes[4]     = 'CAR'
 !this.floorCodes[5]     = 'WOO'
 !this.floorCodes[6]     = 'STA'
 !this.floorCodes[7]     = 'LUX'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      load
--
-- Description: Load configuration file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .load()

  -- Initialise Variables

  !defaultFile = !this.locateFile()

  if (!defaultFile.set() ) then
      !this.load(!defaultFile)
  -- else
  --  !this.setDefaults()
  endif

  -- Need to load the file into their appropriate member and load the
  -- contents in to the relevant members of the form.

   -- Need to call a method that updates the forms  Soma
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      load
--
-- Description: Load configuration file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .load(!file is FILE)

  -- Initialise Variables
  !dfltData = !this.readDfltFile(!file)
    --return

  do !i indices !dfltData
      do !j  from 1 to !dfltData[!i].maxindex()
         if (!i eq 1 ) then
           !this.altName(!dfltData[!i][!j][2], !dfltData[!i][!j][3])
            handle any
               write(!!error.text)
            endhandle
         elseif(!i eq 2) then
             !memberStr = '!this.navigator.' & !dfltData[!i][!j][2]
             $!<memberStr> = !dfltData[!i][!j][3].boolean()
           -- Handle incorrect Attribute name in the configuration file
           -- Should we show some error to the user - Mike to answer
            handle(2,759)
            elsehandle any
               write(!!error.text)
            endhandle
         elseif(!i eq 3 ) then
            if(!j eq 1) then           	
               !this.positionFormat =  !dfltData[!i][!j][3]
             else
               !this.bpos[0] = !dfltData[!i][!j][3].real(!!distanceFmt)
               !this.bpos[1] = !dfltData[!i][!j][4].real(!!distanceFmt)
               !this.bpos[2] = !dfltData[!i][!j][5].real(!!distanceFmt)
             endif
            handle any
                write(!!error.text)
            endhandle
         elseif(!i eq 4 ) then
            !memberStr = '!this.' & !dfltData[!i][!j][2]
            -- error will occur in case there is a STRING in the text
            $!<memberStr> = !dfltData[!i][!j][3].real(!!distanceFmt)
            handle any
                write(!!error.text)
            endhandle
         elseif(!i eq 5 ) then
            !memberStr    = '!this.' & !dfltData[!i][!j][2]
            $!<memberStr> = !dfltData[!i][!j].from(3)
            handle any
                write(!!error.text)
            endhandle
         endif
      enddo
  enddo


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      altName
--
-- Description: Set Alternative names
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .altName(!type is STRING, !altName is STRING)

  -- Set relevant member to alternative text.
  -- maybe one for each type?
  -- Checking whether type is a valid type
  --var !noun noundef $!<type> name
  handle ANY
    return
  endhandle

  !typeStr = '!this.' & !type
  $!<typeStr> = !altName
  -- handle in case the passed type is not a member
       handle(2,759)
           !message = !type & ' is not a valid type to change description using Accommodation configuration object'
           write(!message)
       endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:   readDfltFile
--
-- Description: read the contents from the Default file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .readDfltFile(!dfltsFile is FILE)  is ARRAY

!dfltsData = !dfltsFile.readfile()
 handle ANY
   -- What should we do if this file is not readable   Mike to give answer
   -- should we try to read the next possible
 endhandle

!dfltsArray[1] = ARRAY()
!dfltsArray[2] = ARRAY()
!dfltsArray[3] = ARRAY()
!dfltsArray[4] = ARRAY()
!dfltsArray[5] = ARRAY()
!dfltsArray[6] = ARRAY()

-- Change the logic to store the key words from which the array is built dynamically.
do !i indices !dfltsData

   skip if(!dfltsData[!i].trim().empty() or   !dfltsData[!i].trim('L').substring(1,2).eq('--') or !dfltsData[!i].trim('L').substring(1,2).eq('$$*'))
   !dfltsDataSplit = !dfltsData[!i].split(',')
   if (!dfltsDataSplit[1].upcase().matchwild('DESC*') ) then
     !dfltsArray[1].append(!dfltsDataSplit)
   elseif (!dfltsDataSplit[1].upcase().matchwild('NAVI*') ) then
     !dfltsArray[2].append(!dfltsDataSplit )
   elseif (!dfltsDataSplit[1].upcase().matchwild('POSI*') ) then
     !dfltsArray[3].append(!dfltsDataSplit )
   elseif (!dfltsDataSplit[1].upcase().matchwild('ROOMATT*') ) then
     !dfltsArray[4].append(!dfltsDataSplit )
   elseif (!dfltsDataSplit[1].upcase().matchwild('ROOMINFO*') ) then
     !dfltsArray[5].append(!dfltsDataSplit )
   elseif (!dfltsDataSplit[1].upcase().matchwild('DEFAULTL*') ) then
     !dfltsArray[6].append(!dfltsDataSplit )
   endif

enddo

return !dfltsArray

endmethod
-- End of method

------------------------------------------------------------------------

--
-- Method:      updateFileData
--
-- Description: Load configuration file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateFileData()

    -- unset the Configuration files to avoid using a redundant  information
  !this.userConfig = object FILE()
  !this.pdmsConfig = object FILE()
  !this.projConfig = object FILE()

  !files = !!searchpaths('accconfig.pmldat')
  if (!files.size().eq(0) ) then
     -- Get the information from the default
  else
    do !i indices !files
       !fileCategory = '!this.' & !files[!i].defaulttype & 'config'
       $!<fileCategory> = object FILE(!files[!i].fullname )
    enddo
  endif

endmethod
  -- End of method
------------------------------------------------------------------------
--
-- Method:      locateFile
--
-- Description: Load configuration file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locateFile() is FILE

  !this.updateFileData()

  !defaultFile = object FILE()
  -- Give  priority in the order, User, Project, PDMS
  if (!this.userConfig.set() ) then
     !defaultFile = !this.userConfig
  elseif (!this.projConfig.set() ) then
    !defaultFile = !this.projConfig
  elseif (!this.pdmsConfig.set() ) then
    !defaultFile = !this.pdmsConfig
  endif

  return !defaultFile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Load configuration file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .writeFile() is BOOLEAN

 !dfltsArray[1] = ARRAY()
 !dfltsArray[2] = ARRAY()
 !dfltsArray[3] = ARRAY()
 !dfltsArray[4] = ARRAY()

 !groupCode[1] = 'Description'
 !groupCode[2] = 'Navigation'
 !groupCode[3] = 'PositionControl'
 !groupCode[4] = 'RoomAttributes'
 !groupCode[5] = 'RoomInfo'
 !groupCode[6] = 'DefaultLengths'

 -- should the user be given a chance to set which is the option(user/pdms/proj) he need to set

 -- store the data for Alternate Description
  !dfltsArray[1][1][1] = 'BLEVEL'
  !dfltsArray[1][1][2] = !this.blevel
  !dfltsArray[1][2][1] = 'BBLOCK'
  !dfltsArray[1][2][2] = !this.bblock
  !dfltsArray[1][3][1] = 'ROOM'
  !dfltsArray[1][3][2] = !this.room

 -- store the data for navigation
 -- !dfltsArray[2][1]    = !groupCode[2]
  !dfltsArray[2][1][1] = 'columnExcelFilter'
  !dfltsArray[2][1][2] = !this.navigator.columnExcelFilter
  !dfltsArray[2][2][1] = 'outlookGroupStyle'
  !dfltsArray[2][2][2] = !this.navigator.outlookGroupStyle
  !dfltsArray[2][3][1] = 'columnSummaries'
  !dfltsArray[2][3][2] = !this.navigator.columnSummaries
  !dfltsArray[2][4][1] = 'labelVisibility'
  !dfltsArray[2][4][2] =  !this.navigator.labelVisibility

  !dfltsArray[3][1][1] = 'positionFormat'
  !dfltsArray[3][1][2] = !this.positionFormat
  !dfltsArray[3][2][1] = 'Position'
  !dfltsArray[3][2][2] = !this.bpos[0].string(!!distanceFmt)
  !dfltsArray[3][2][3] = !this.bpos[1].string(!!distanceFmt)
  !dfltsArray[3][2][4] = !this.bpos[2].string(!!distanceFmt)

  !dfltsArray[4][1][1] = 'DDOORSILL'
  !dfltsArray[4][1][2] = !this.dDoorSill.string(!!distanceFmt)
  !dfltsArray[4][2][1] = 'DWINDOWSILL'
  !dfltsArray[4][2][2] = !this.dWindowSill.string(!!distanceFmt)
  !dfltsArray[4][3][1] = 'FLRHEIGHT'
  !dfltsArray[4][3][2] = !this.flrHeight.string(!!distanceFmt)
  !dfltsArray[4][4][1] = 'CLNHEIGHT'
  !dfltsArray[4][4][2] = !this.clnHeight.string(!!distanceFmt)
  !dfltsArray[4][5][1] = 'HEADROOM'
  !dfltsArray[4][5][2] = !this.headRoom.string(!!distanceFmt)
  !dfltsArray[4][6][1] = 'HEADCLEAR'
  !dfltsArray[4][6][2] = !this.headClear.string(!!distanceFmt)
  !dfltsArray[4][7][1] = 'CLEARWIDTH'
  !dfltsArray[4][7][2] = !this.clearWidth.string(!!distanceFmt)

  !dfltsArray[5][1][1] = 'COLOURSCHEMES'
  !dfltsArray[5][1][2] = !this.colourSchemes
  !dfltsArray[5][2][1] = 'FIRERATINGS'
  !dfltsArray[5][2][2] =  !this.fireRatings
  !dfltsArray[5][3][1] = 'CEILINGTYPES'
  !dfltsArray[5][3][2] = !this.ceilingTypes
  !dfltsArray[5][4][1] = 'CEILINGCODES'
  !dfltsArray[5][4][2] = !this.ceilingCodes
  !dfltsArray[5][5][1] = 'HAZARDTYPES'
  !dfltsArray[5][5][2] = !this.hazardTypes
  !dfltsArray[5][6][1] = 'FLOORTYPES'
  !dfltsArray[5][6][2] =  !this.floorTypes
  !dfltsArray[5][7][1] = 'FLOORCODES'
  !dfltsArray[5][7][2] =  !this.floorCodes

  !dfltsArray[6][1][1] = 'LATTICEPROFILE'
  !dfltsArray[6][1][2] = !this.latticeProfile.string(!!distanceFmt)
  !dfltsArray[6][2][1] = 'PANELPROFILE'
  !dfltsArray[6][2][2] = !this.panelProfile.string(!!distanceFmt)

  !outputArray = ARRAY()
  do  !i indices !dfltsArray
      do !j indices !dfltsArray[!i]
          !outString = !groupCode[!i]
          do !k indices  !dfltsArray[!i][!j]
            if (!dfltsArray[!i][!j][!k].objecttype().eq('ARRAY') ) then
              -- Is it ok to store the array elements as a CSV Neil to answer
               do !l indices !dfltsArray[!i][!j][!k]
                 !outString =  !outString & ',' &  !dfltsArray[!i][!j][!k][!l].string()
               enddo
            else
                 !outString =  !outString & ',' &  !dfltsArray[!i][!j][!k].string()
            endif
          enddo
          !outputArray.append(!outString)
      enddo
  enddo

  !defaultFile = !this.locateFile()

  if (!defaultFile.unset() ) then
      -- where should we write Mike should give feedback
      var !evar EVAR PDMSUSER
     if(!evar.trim().empty().not()) then
       !defaultFile.file('%PDMSUSER%/' & 'accconfig.pmldat')
     endif
  endif

  !defaultFile.writeFile('overwrite',!outputArray)
  handle ANY
    -- If this is not writable what to do? Mike to answer
  endhandle

endmethod

-- End of method
