-- Author:          Neil Holmes
-- Created:         Sunday Oct 29 20:00:00 GMT 2006
---
-- Description:
--  Accommodation control object, use to manage distribution of current
--  active accommodation elements
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accDelete()                      -                   Constructor
--  deleteElement(DBREF)             BOOLEAN             Delete passed element
--  deleteElements()                 -                   Delete elements in the list of elements
--  deleteElements(ARRAY)            BOOLEAN             Delete passed element
--  deleteElements(ARRAY,STRING)     BOOLEAN             Delete passed element of specific type (navigates to type if higher in the tree)
--  deleteFromSelection(STRING)      BOOLEAN             Delete specific type of element from current graphic selection
--  errors()                         ARRAY               Returns error stack
--  verify()                         BOOLEAN             Verify elements in list to be deleted, if abort then errors from the system will be false
--
------------------------------------------------------------------------

define object ACCDELETE

  -- Elements to delete (array of DBREFs)
  member .deleteList    is ARRAY

  -- Elements as and array of STRING (as enhance command prefers this)
  member .elementList   is ARRAY

  -- Error message
  member .errorMessage  is STRING

  -- Error stack (returned from delete manager)
  member .errorStack    is ARRAY

  -- Delete state (true if successful)
  member .deleted       is BOOLEAN

  -- Delete has been aborted
  member .aborted       is BOOLEAN

  -- Verify deletion by highlighting
  member .verify        is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:     accDelete
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accDelete()

  -- Initialise Variables
  !this.verify      = true
  !this.aborted     = false
  !this.deleted     = true

  -- Check that deleteManager has been loaded
  if(undefined(!!deleteManager)) then
    !!deleteManager = object DELETEMANAGER()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     verify
--
-- Description: Verify elements in list to be deleted, if abort then errors from the system will be false
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN
--
------------------------------------------------------------------------

define method .verify() is BOOLEAN

  -- Initialise Variables
  !this.aborted         = false
  !return               = true

  -- No element found
  if(!this.deleteList.empty()) then
    !this.aborted       = true
    return !return
  endif

  -- Check if verification is required
  if(!this.verify) then
    -- Highligh elements in delete list
    !block              = object BLOCK('!this.deleteList[!evalIndex].string()')
    !elementList        = !this.deleteList.evaluate(!block)
    !this.elementList   = !elementList
    ENHANCE ALL FROM !elementList COLOUR RED

    -- Check if elements should be deleted
    !return             = !!alert.confirm('OK to delete highlighted elements?').boolean()
    UNENHANCE ALL FROM !elementList
  endif

  -- Return
  !this.aborted         = !return.not()
  return !return

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:     deleteElements
--
-- Description: Delete elements in the list of elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteElements()

  -- Initialise Variables
  !this.errorStack.clear()
  !this.errorMessage  = ''

  -- Delete element using standard delete manager
  if(!!deleteManager.dbDelete(!this.deleteList, true)) then
    !this.deleted     = true

  -- Error in deletion
  else
    !this.deleted     = false
    !this.errorStack  = !!deleteManager.errors()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     deleteElement
--
-- Description: Delete passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to delete
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is successful, False is failed (error returned via .errorStack)
--
------------------------------------------------------------------------

define method .deleteElement(!element is DBREF) is BOOLEAN

  -- Initialise Variables
  !this.deleteList.clear()
  !this.deleted = true

  -- No element passed (could be better than just an alert)
  if(!element.unset()) then
    !!alert.warning('No element passed')
    return false
  endif

  -- Add element to list
  !this.deleteList.append(!element)

  -- Verify deletion
  if(!this.verify()) then
    !this.deleteElements()
  endif

  -- Return
  return !this.deleted.or(!this.aborted)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     deleteElements
--
-- Description: Delete passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of element to delete
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is successful, False is failed (error returned via .errorStack)
--
------------------------------------------------------------------------

define method .deleteElements(!elements is ARRAY) is BOOLEAN

  -- Initialise Variables
  !this.deleteList.clear()

  -- Add element to list
  !this.deleteList  = !elements

  -- Verify deletion
  if(!this.verify()) then
    !this.deleteElements()
  endif

  -- Return
  return !this.deleted.or(!this.aborted)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     deleteElements
--
-- Description: Delete passed element of specific type (navigates to type if higher in the tree)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of element to delete
--    2   R      STRING      Type of element to delete from list
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is successful, False is failed (error returned via .errorStack)
--
------------------------------------------------------------------------

define method .deleteElements(!elements is ARRAY, !passedType is STRING) is BOOLEAN

  -- Initialise Variables
  !this.deleteList.clear()
  !type               = !passedType.upcase()
  !deleteList         = ARRAY()

  -- Get only element from list which conform to the given type
  do !element values !elements
    if(!element.fulltype.match(!type).boolean()) then
      !deleteList.append(!element)
    endif
  enddo

  -- Check there are some element to delete
  if(!deleteList.empty()) then
    !this.deleted       = false
    !this.errorMessage  = 'No elements of type "' & !type & '" found within passed list of elements.'
    return false
  endif

  -- Assign elements to delete list
  !this.deleteList      = !deleteList

  -- Verify deletion
  if(!this.verify()) then
    !this.deleteElements()
  endif

  -- Return
  return !this.deleted.or(!this.aborted)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     deleteFromSelection
--
-- Description: Delete specific type of element from current graphic selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of element to delete from list
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is successful, False is failed (error returned via .errorStack)
--
------------------------------------------------------------------------

define method .deleteFromSelection(!type is STRING) is BOOLEAN

  -- Get elements from graphical selection
  !selection  = object SELECTION()
  !selection.getCurrent()
  !elements   = !selection.getSelection()

  -- Delete list of elements
  !this.deleteElements(!elements, !type)

  -- Return
  return !this.deleted.or(!this.aborted)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     errors
--
-- Description: Returns error stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       2D array of element and error
--
------------------------------------------------------------------------

define method .errors() is ARRAY
  return !this.errorStack
endmethod
-- End of method
