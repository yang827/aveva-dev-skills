---
-- Description:
--    Object for creating basic room definitions along with automatic
--    creation of offspring elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accopeningBasics()               -                   Constructor
--  accopeningBasics(DBEOPENING)     -                   Constructor
--  create()                         -                   Create basics for opening
--  defineopeningGrid(BOOLEAN)       -                   Define opening grid
--

define object ACCOPENINGBASICS

  -- opening element
  member .dbElement           is DBREF

  -- opening definition
  member .definition          is DBEOPENING

  -- Undo for form
  member .undo                is UNDOABLE

  -- Create options
  member .defineopeningGrid   is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      accopeningBasics
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accopeningBasics()

  -- Initialise Variables
  !this.defineopeningGrid   = false

endmethod

------------------------------------------------------------------------
--
-- Method:      accopeningBasics
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accopeningBasics(!definition is DBEOPENING)

  -- Initialise Variables
  !this.accopeningBasics()
  !this.dbElement           = !definition.dbElement
  !this.definition          = !definition

endmethod

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create basics for opening
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create()

!!alert.error('Building basic elements for doors and windows not yet implemented')
return

  -- Initialise Variables
  !reference    = !!ce
  !element      = !this.dbElement

  -- Generate Boundary and Area Definition
  if(!this.definition.outerLoop.set()) then
    !!ce              = !element

    -- Create boundary
    NEW BNDLIN
    !boundary         = !!ce
    !!ce.description  = 'Boundary'

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif
    NEW LOOP
    !this.definition.outerLoop.dbWrite(CE)

    -- Create Area definition
    NEW AREADEF
    --!volume           = !!ce
    !!ce.description  = 'Volume'

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif
    NEW AEXTR
    !extrusion        = !!ce
    !extrusion.height = !this.definition.clnVoid
    RULE SET HEIGHT STATIC (clnVoid of CEILIN)
    NEW LOOP
    !this.definition.outerLoop.dbWrite(CE)

    -- Set the label position to the mid point of the areadef as a default
    !cofg                 = !extrusion.gcofg
    handle ANY
    elsehandle NONE
      !labOffset[1]       = !cofg.east
      !labOffset[2]       = !cofg.north
      !labOffset[3]       = 0
      !element.labOffset  = !labOffset
    endhandle

  endif

  -- Define opening Grid
  if(!this.defineopeningGrid) then
    !!ce                    = !element
    NEW CLNPNG
    !openingGrid            = !!ce
    !openingGrid.labOffset  = !element.labOffset

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif

    -- This should be held in the config as a default
    -- potentially against the "opening Type/Code
    !xGrid[1]         = 600
    !yGrid[1]         = 600
    !openingGrid.grdXSpacing  = !xGrid
    !openingGrid.grdYSpacing  = !yGrid

    -- Set design criteria
    --!!ce.fireRating           = !element.fireRating
    !openingGrid.colSchema    = !element.colSchema

    if(!this.definition.outerLoop.set()) then
      NEW BNDLIN
      !boundary         = !!ce
      !!ce.description  = 'opening Grid Boundary'

      -- Name element
      if(!openingGrid.isNamed) then
        call !!autoNameCe(false)
      endif

      -- Name element
      if(!element.isNamed) then
        call !!autoNameCe(false)
      endif
      NEW LOOP
      !this.definition.outerLoop.dbWrite(CE)

    endif

  endif

  -- Return to original element
  !!ce        = !reference

endmethod

------------------------------------------------------------------------
--
-- Method:      defineopeningGrid
--
-- Description: Define opening grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineopeningGrid(!create is BOOLEAN)
  !this.defineopeningGrid = !create
endmethod
