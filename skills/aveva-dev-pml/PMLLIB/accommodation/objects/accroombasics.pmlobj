---
-- Description:
--    Object for creating basic room definitions along with automatic
--    creation of offspring elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accRoomBasics()                  -                   Constructor
--  accRoomBasics(DBEROOM)           -                   Constructor
--  create()                         -                   Create basics for room
--  defineCeiling(BOOLEAN)           -                   Define ceiling
--  defineCeilingGrid(BOOLEAN)       -                   Define ceiling grid
--  defineFloor(BOOLEAN)             -                   Define floor
--

define object ACCROOMBASICS

  -- Room element
  member .dbElement           is DBREF

  -- Room definition
  member .definition          is DBEROOM

  -- Undo for form
  member .undo                is UNDOABLE

  -- Create options
  member .defineCeiling       is BOOLEAN
  member .defineCeilingGrid   is BOOLEAN
  member .defineFloor         is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      accRoomBasics
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accRoomBasics()

  -- Initialise Variables
  !this.defineCeiling       = false
  !this.defineCeilingGrid   = false
  !this.defineFloor         = false

endmethod

------------------------------------------------------------------------
--
-- Method:      accRoomBasics
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accRoomBasics(!definition is DBEROOM)

  -- Initialise Variables
  !this.accRoomBasics()
  !this.dbElement           = !definition.dbElement
  !this.definition          = !definition

endmethod

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create basics for room
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create()

  -- Initialise Variables
  !reference    = !!ce
  !element      = !this.dbElement

  -- Generate Boundary and Area Definition
  -- Check that outer loop is set, and that it is a closed loop so that a volume can be created
  if(!this.definition.outerLoop.set()) AND (!this.definition.outerLoop.isClosed()) then
    !!ce              = !element

    -- Create boundary
    NEW BNDLIN
    !boundary         = !!ce
    !!ce.description  = 'Boundary'

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif
    NEW LOOP
    !this.definition.outerLoop.dbWrite(CE)

    -- Create Area definition
    NEW AREADEF
    --!volume           = !!ce
    !!ce.description  = 'Volume'

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif
    NEW AEXTR
    !!ce.obs = 0
    !extrusion        = !!ce
    !extrusion.height = !this.definition.defaultHeight
    RULE SET HEIGHT STATIC (heiDefault of ROOM)
    NEW LOOP
    !this.definition.outerLoop.dbWrite(CE)

    -- Set the label position to the mid point of the AREADEF as a default
    !cofg                 = !extrusion.gcofg
    handle ANY
    elsehandle NONE
      !labOffset[1]       = !cofg.east
      !labOffset[2]       = !cofg.north
      !labOffset[3]       = 0
      !element.labOffset  = !labOffset
    endhandle

  endif

  -- Define Ceiling
  if(!this.defineCeiling) then
    !!ce              = !element
    NEW DETGRP
    !!ce.purpose      = 'CLN'
    !!ce.description  = 'Ceiling Definitions'

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif

    -- Create Ceiling
    NEW CEILING
    !ceiling            = !!ce
    !ceiling.labOffset  = !element.labOffset

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif

    -- Set ceiling height
    !ceiling.clnHeight    = !element.clnHeight

    -- Ceiling void
    !ceiling.clnVoid      = !element.heiDefault - !element.clnHeight

    -- Set design criteria
    --!!ce.fireRating       = !element.fireRating
    !ceiling.colSchema    = !element.colSchema

    -- Set Defaults
    !ceiling.clnType      = !element.dClnType
    !ceiling.clnCode      = !element.dClnCode

    -- Define Ceiling Boundary (default to same as room)
    if(!this.definition.outerLoop.set()) then
      NEW BNDLIN
      COPY $!<boundary>
      !!ce.description  = 'Ceiling Boundary'

      -- Name element
      if(!ceiling.isNamed) then
        call !!autoNameCe(false)
      endif

      -- Define Ceiling Void space
      NEW AREADEF
      !!ce.description  = 'Ceiling Void'

      -- Name element
      if(!ceiling.isNamed) then
        call !!autoNameCe(false)
      endif
      NEW AEXTR
      !!ce.obs = 0
      !extrusion        = !!ce
      !extrusion.height = !ceiling.clnVoid
      RULE SET HEIGHT STATIC (clnVoid of CEILIN)
      NEW LOOP
      !this.definition.outerLoop.dbWrite(CE)
      AEXTR
      AT N0
    endif

    -- Define Ceiling Grid
    if(!this.defineCeilingGrid) then
      !!ce              = !ceiling
      NEW CLNPNG
      !ceilingGrid            = !!ce
      !ceilingGrid.labOffset  = !element.labOffset

      -- Name element
      if(!ceiling.isNamed) then
        call !!autoNameCe(false)
      endif

      -- This should be held in the config as a default
      -- potentially against the "ceiling Type/Code
      !xGrid[1]         = 600
      !yGrid[1]         = 600
      !ceilingGrid.grdXSpacing  = !xGrid
      !ceilingGrid.grdYSpacing  = !yGrid

      -- Set design criteria
      --!!ce.fireRating           = !element.fireRating
      !ceilingGrid.colSchema    = !element.colSchema

      if(!this.definition.outerLoop.set()) then
        NEW BNDLIN
        COPY $!<boundary>
        !!ce.description  = 'Ceiling Grid Boundary'

        -- Name element
        if(!ceilingGrid.isNamed) then
          call !!autoNameCe(false)
        endif

      endif

    endif

  endif

  -- Define Floor covering
  if(!this.defineFloor) then
    !!ce                = !element
    NEW DETGRP
    !!ce.purpose        = 'FLR'
    !!ce.description    = 'Floor Coverings'

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif

    -- Create Ceiling
    NEW FLRCOV
    !floorCovering            = !!ce
    !floorCovering.labOffset  = !element.labOffset

    -- Name element
    if(!element.isNamed) then
      call !!autoNameCe(false)
    endif

    -- Set design criteria
    --!!ce.fireRating           = !element.fireRating
    !floorCovering.colSchema  = !element.colSchema

    NEW FLRLAY
    !!ce.fllThk = !element.flrheight

    -- Define floor Boundary (default to same as room)
    if(!this.definition.outerLoop.set()) then
      NEW LOOP
      !this.definition.outerLoop.dbWrite(CE)
    endif

  endif

  -- Return to original element
  !!ce        = !reference

endmethod

------------------------------------------------------------------------
--
-- Method:      defineCeiling
--
-- Description: Define ceiling
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineCeiling(!create is BOOLEAN)
  !this.defineCeiling = !create
endmethod

------------------------------------------------------------------------
--
-- Method:      defineCeilingGrid
--
-- Description: Define ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineCeilingGrid(!create is BOOLEAN)
  !this.defineCeilingGrid = !create
endmethod

------------------------------------------------------------------------
--
-- Method:      defineFloor
--
-- Description: Define floor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineFloor(!create is BOOLEAN)
  !this.defineFloor = !create
endmethod
