define object ACCSHAPE

endobject

define method .pickRectangle()

  -- Define edg packet
  !packet             = object EDGPACKET()

  !packet.key         = 'Accommodation'
  !packet.type        = 'Accommodation'
  !packet.priority    = 0
  !packet.remove      = true
  !packet.description = 'Shape Definition'
  !packet.action      = '!!accShape.rectangle2pnts(!this.return[1])'

  -- Define the picks
  !packet.pickPacket.picks[1]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('first point')
  !packet.pickPacket.picks[2]    = object EDGPICKTYPE()
  !packet.pickPacket.picks[2].stdPosition('second point')

  !!edgcntrl.add(!packet)

endmethod

define method .rectangle2pnts(!data is ARRAY)

  !plane      = object PLANE(E 135600mm N 2150mm U 34000mm, Y)
  !position1  = !data[1]
  !position2  = !data[2]

  !pos[1]     = !plane.near(!position1.position)
  !pos[2]     = !plane.near(!position2.position)

  -- Define rectangle between two points
  !volume     = object VOLUME()
  !volume.from  = !pos[1]
  !volume.to    = !pos[2]
  !box          = !volume.box()
  !gbox         = object GPHBOX(!box)
  !gbox.draw(1)
  --q var !box
  pin1 at $!pos[1]
  pin2 at $!pos[2]
  --q var !position1.position !pos[1]
endmethod
