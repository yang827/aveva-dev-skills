-- File:            acctaskmanager.pmlobj
--   Type:          Object Definition
--   Group:
--
--     Keyword:     Task Manager
--   Module:        General
--   Replaces:
--
-- Author:          Neil.Holmes
-- Created:         Monday Jan 22 10:00:00 GMT 2007
--
-- Description:
--   Used to switch between the accommodation task forms, in theory this
--   should be replace by the task manager supplied by F&M
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  active(FORM)                     -                   Make passed form the active form
--  active(STRING)                   -                   Make passed form the active form
--  back()                           -                   Restore previous form from stack
--  clear()                          -                   Remove all the forms from the stack
--
------------------------------------------------------------------------

define object ACCTASKMANAGER

  -- List of forms currently in the stack
  member .stack         is ARRAY

  -- Currently active form shown
  member .active        is FORM

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:     clear
--
-- Description: Remove all the forms from the stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clear()
  !this.stack.clear()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     active
--
-- Description: Make passed form the active form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form to be made active
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .active(!formname is STRING)

  -- Initialise Variable
  !formID = '!!' & !formname

  -- Check for form existence (messy but quick)
  if(undefined($!formID)) then
    pml reload form $!formID
  endif

  !this.active($!formID )

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     active
--
-- Description: Make passed form the active form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form to be made active
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .active(!form is FORM)

  -- Check if passed form is already in the stack
  !index      = !this.stack.findFirst(!form)
  !addToStack = true

  -- If index is set, then remove from 1 to form index
  -- and make form current
  if(!index.set()) then
    !this.stack.removeFrom(1, !index)
    !addToStack = false
  endif

  -- Move current form into form stack
  if(!this.active.set()) then
    if(!this.active.neq(!form)) then
      !this.active.hide()
    endif
  endif

  if(!addToStack) then
    !this.stack.insert(1,!this.active)
  endif

  -- Make form current form
  !this.active  = !form

  -- Show form
  if(!this.active.shown().not()) then
    !this.active.show('FREE')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     back
--
-- Description: Restore previous form from stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .back()

  -- If there is nothing in the stack, then don't do anything
  if(!this.stack.empty()) then
    return
  endif

  -- Remove active form
  if(!this.active.set()) then
    !this.active.hide()
  endif

  -- Reinstate previous form
  if(!this.stack.empty().not()) then
    --!size           = !this.stack.size()
    !this.active    = !this.stack.removeFirst()

    -- Show form
    if(!this.active.shown().not()) then
      !this.active.show('FREE')
    endif

  endif

endmethod
-- End of method
