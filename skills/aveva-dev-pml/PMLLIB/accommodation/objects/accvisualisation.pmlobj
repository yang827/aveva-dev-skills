-- Description:
--    Object to manage the visualisation of the
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accVisualisation()               -                   Constructor
--  add(DBREF)                       -                   Add passed element to the graphics
--  aidNumbers(REAL)                 -                   Set aid numbers
--  detailSet()                      -                   Derive the detail elements types
--  getDetail(STRING)                ARRAY               Set reference data visualisation settings
--  getRefData(STRING)               ARRAY               Get reference data visualisation settings
--  mainSet()                        -                   Derive the main reference elements types
--  refresh()                        -                   Refresh contents of the main graphics views (main drawlist)
--  refresh(DBREF)                   -                   Refresh the passed element in the graphics
--  setDetail(STRING,BOOLEAN,BOOLEAN) -                   Set reference data visualisation settings
--  setRefData(STRING,BOOLEAN,BOOLEAN,BOOLEAN) -                   Set reference data visualisation settings
--  setupDetail(STRING)              -                   Setup standard detail options
--  setupRefData(STRING)             -                   Setup standard reference data options
--  stdDetail()                      ARRAY               Standard detail options
--  stdRefData()                     ARRAY               Standard reference data options
--  tagElements()                    -                   Tag Elements
--

define object ACCVISUALISATION

  -- Volume Elements
  member .refDataTypes        is ARRAY
  member .refDataVolume       is ARRAY
  member .refDataBoundary     is ARRAY
  member .refDataTag          is ARRAY

  -- Detail Elements
  member .detailTypes         is ARRAY
  member .detailDetail        is ARRAY
  member .detailTag           is ARRAY

  -- Private members used by the object
  -- Set of main types
  member .mainVolumeSet       is STRING
  member .mainVolumeUnset     is STRING
  member .mainBoundarySet     is STRING
  member .mainBoundaryUnset   is STRING
  member .mainTagSet          is STRING
  member .detailSet           is ARRAY
  member .detailUnset         is ARRAY
  member .detailTagSet        is ARRAY

  -- Tag Number
  member .tagNumber           is REAL

  -- Element lists
  member .areas               is ARRAY
  member .outlines            is ARRAY

  -- Ideally the configurations should be defined and held as members
  -- of the object, so that can be swapped in

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      accVisualisation
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .accVisualisation()

  -- Initialise Variables
  !this.setupRefData('Default')
  !this.setupDetail('Default')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mainSet
--
-- Description: Derive the main reference elements types
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainSet()

  -- Initialise Variables
  !volumeSet        = ''
  !volumeUnset      = ''
  !boundarySet      = ''
  !boundaryUnset    = ''
  !tagSet           = ''

  -- Build rule
  do !i indices !this.refDataTypes
    if(!this.refDataVolume[!i]) then
      !volumeSet      = !volumeSet & ',''' & !this.refDataTypes[!i] & ''''
    else
      !volumeUnset    = !volumeUnset & ',''' & !this.refDataTypes[!i] & ''''
    endif
    if(!this.refDataBoundary[!i]) then
      !boundarySet    = !boundarySet & ',''' & !this.refDataTypes[!i] & ''''
    else
      !boundaryUnset  = !boundaryUnset & ',''' & !this.refDataTypes[!i] & ''''
    endif
    if(!this.refDataTag[!i]) then
      !tagSet         = !tagSet & ',''' & !this.refDataTypes[!i] & ''''
    endif
  enddo

  -- Set of main reference elements
  !this.mainVolumeSet     = !volumeSet.trim('LR', ',')
  !this.mainVolumeUnset   = !volumeUnset.trim('LR', ',')
  !this.mainBoundarySet   = !boundarySet.trim('LR', ',')
  !this.mainBoundaryUnset = !boundaryUnset.trim('LR', ',')
  !this.mainTagSet        = !tagSet.trim('LR',',')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      detailSet
--
-- Description: Derive the detail elements types
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .detailSet()

  -- Initialise Variables
  !detailSet        = ARRAY()
  !detailUnset      = ARRAY()
  !tagSet           = ARRAY()

  -- Build rule
  do !i indices !this.detailTypes
    if(!this.detailDetail[!i]) then
      !detailSet.append(!this.detailTypes[!i])
    else
      !detailUnset.append(!this.detailTypes[!i])
    endif
    if(!this.detailTag[!i]) then
      !tagSet.append(!this.detailTypes[!i])
    endif
  enddo

  -- Set of main reference elements
  !this.detailSet     = !detailSet
  !this.detailUnset   = !detailUnset
  !this.detailTagSet  = !tagSet

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh contents of the main graphics views (main drawlist)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Derive set of reference elements
  !this.mainSet()
  !this.detailSet()

  -- Get main area definitions for main elements
  if(!this.mainVolumeUnset.trim().length().neq(0)) then
    var !areas collect all AREADEF with (type of owner inset($!this.mainVolumeUnset)) from drawlist

    -- Get reference area definitions
    --# This needs adding


    -- Remove elements from drawlist
    REMOVE ALL FROM !areas

  endif

  -- Get outlines for main elements
  if(!this.mainBoundaryUnset.trim().length().neq(0)) then
    var !outlines collect all BNDLIN with (type of owner inset($!this.mainBoundaryUnset)) from drawlist

    -- Remove elements from drawlist
    REMOVE ALL FROM !outlines
  endif

  -- Get detail elements to tags
  if(!this.detailUnset.empty().not()) then
    var !drawlist collect all from drawlist
    !block            = object BLOCK('!drawlist[!evalIndex].dbref()')
    !elements         = !drawlist.evaluate(!block)
    !detailCollection = object COLLECTION()
    !detailCollection.scope(!elements)
    !detailCollection.types(!this.detailUnset)
    !exp = object EXPRESSION(|type neq 'HANG' and type neq 'PANE'|)
    !detailCollection.filter(!exp)

    !detailGroups     = !detailCollection.results()
    !block            = object BLOCK('!detailGroups[!evalIndex].string()')
    !elementsProcessed         = !detailGroups.evaluate(!block)

    REMOVE ALL FROM !elementsProcessed

    -- Remove GENSEC from CLNLAT if required
    if !this.detailUnset.findFirst('CLNLAT').unset().not() then
      !gensecCollection = object COLLECTION()
      !gensecCollection.scope(!elements)
      !gensecCollection.type('GENSEC')
      !exp = object EXPRESSION(|type of owner eq 'CLNLAT'|)
      !gensecCollection.filter(!exp)
      !gensecs = !gensecCollection.results()
      !block            = object BLOCK('!gensecs[!evalIndex].string()')
      !gensecsProcessed = !gensecs.evaluate(!block)
      REMOVE ALL FROM !gensecsProcessed
    endif

    -- Remove HANG from REST of CLNPNG if required
    if !this.detailUnset.findFirst('HANG').unset().not() then
      !hangCollection = object COLLECTION()
      !hangCollection.scope(!elements)
      !hangCollection.type('HANG')
      !exp = object EXPRESSION(|type of owner of owner eq 'CLNPNG'|)
      !hangCollection.filter(!exp)
      !hangs = !hangCollection.results()
      !block            = object BLOCK('!hangs[!evalIndex].string()')
      !hangsProcessed = !hangs.evaluate(!block)
      REMOVE ALL FROM !hangsProcessed
    endif

    -- Remove PANE from CEILIN (of DETGRP) if required
    if !this.detailUnset.findFirst('PANE').unset().not() then
      !paneCollection = object COLLECTION()
      !paneCollection.scope(!elements)
      !paneCollection.type('PANE')
      !exp = object EXPRESSION(|type of owner eq 'CEILIN'|)
      !paneCollection.filter(!exp)
      !panes = !paneCollection.results()
      !block            = object BLOCK('!panes[!evalIndex].string()')
      !panesProcessed = !panes.evaluate(!block)
      REMOVE ALL FROM !panesProcessed
    endif


  endif

  -- Tag Main Elements
  !this.tagElements()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: Refresh the passed element in the graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh(!element is DBREF)

  -- Derive set of reference elements
  !this.mainSet()
  !this.detailSet()

  -- Get main area definitions for main elements
  if(!this.mainVolumeUnset.trim().length().neq(0)) then
    var !areas collect all AREADEF with (type of owner inset($!this.mainVolumeUnset)) for $!<element>

    -- Get reference area definitions
    --# Ths needs adding

    -- Get elements in the drawlist
    var !areasDL collect all AREADEF with (type of owner inset($!this.mainVolumeUnset)) from drawlist

    -- Remove elements from drawlist, i.e. the ones that are in both the
    -- element and the drawlist
    !removeAreas  = !areas.intersect(!areasDL)
    REMOVE ALL FROM !removeAreas

  endif

  -- Get outlines for main elements
  if(!this.mainBoundaryUnset.trim().length().neq(0)) then
    var !outlines collect all BNDLIN with (type of owner inset($!this.mainBoundaryUnset)) for $!<element>

    -- Remove elements from drawlist
    REMOVE ALL FROM !outlines
  endif

  -- Get detail elements to tags
  if(!this.detailUnset.empty().not()) then
    !detailCollection = object COLLECTION()
    !detailCollection.scope(!element)
    !detailCollection.types(!this.detailUnset)
    !detailGroups     = !detailCollection.results()
    !block            = object BLOCK('!detailGroups[!evalIndex].string()')
    !elements         = !detailGroups.evaluate(!block)
    REMOVE ALL FROM !elements
  endif

  -- Tag Main Elements
  !this.tagElements()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add passed element to the graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .add(!element is DBREF)

  -- Derive set of reference elements
  !this.mainSet()
  !this.detailSet()

  -- Get main area definitions for main elements
  if(!this.mainVolumeSet.trim().length().neq(0)) then
    var !areas collect all AREADEF with (type of owner inset($!this.mainVolumeSet)) for $!<element>

    -- Get reference area definitions
    --# Ths needs adding


    -- Remove elements from drawlist
    ADD ALL FROM !areas

  endif

  -- Get outlines for main elements
  if(!this.mainBoundarySet.trim().length().neq(0)) then
    var !outlines collect all BNDLIN with (type of owner inset($!this.mainBoundarySet)) for $!<element>
    ADD ALL FROM !outlines
  endif

  -- Get detail elements to tags
  if(!this.detailSet.empty().not()) then
    !detailCollection = object COLLECTION()
    !detailCollection.scope(!element)
    !detailCollection.type('DETGRP')
    !detailGroups     = !detailCollection.results()
    !block            = object BLOCK('!detailGroups[!evalIndex].string()')
    !elements         = !detailGroups.evaluate(!block)
    ADD ALL FROM !elements
  endif

  -- Handles some problems with what is actually added to the draw list
  !this.refresh(!element)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aidNumbers
--
-- Description: Set aid numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidNumbers(!tagNumber is REAL)
  !this.tagNumber  = !tagNumber
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tagElements
--
-- Description: Tag Elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagElements()

  -- Clear aid graphics
  AID CLEAR ALL $!<this.tagNumber>

  -- Get main elements to tags
  if(!this.mainTagSet.trim().length().neq(0)) then
    var !elements collect all (AREADEF BNDLIN) with (type of owner inset($!this.mainTagSet)) from drawlist

    if(!elements.empty().not()) then
      var !owners   evaluate  (OWNER) for all from !elements

      !block      = object BLOCK('!owners[!evalIndex].dbref()')
      !owners     = !elements.evaluate(!block)

      do !i indices !owners
        !name     = !owners[!i].namn
        !type     = !owners[!i].repTxt
        !position = !owners[!i].labPosition
        !position = N0
        !position.east    = !owners[!i].labOffset[1]
        !position.north   = !owners[!i].labOffset[2]
        !position.up      = !owners[!i].labOffset[3]
        !position.origin  = !owners[!i]
        AID TEXT NUMBER $!<this.tagNumber> '$!type: $!name' AT $!<position>
      enddo

    endif

  endif

  -- Get detail elements to tags
  if(!this.detailTagSet.empty().not()) then
    var !detailGroups collect all (DETGRP STRFLT LADDER HANDRA) from drawlist

    if(!detailGroups.empty().not()) then
      !block      = object BLOCK('!detailGroups[!evalIndex].dbref()')
      !groups     = !detailGroups.evaluate(!block)

      -- Define collection
      !collection = object COLLECTION()
      !collection.scope(!groups)
      !collection.types(!this.detailTagSet)
      !detail     = !collection.results()

      do !i indices !detail
        !name     = !detail[!i].namn
        !type     = !detail[!i].repTxt
        !position = !detail[!i].labPosition
        handle ANY
          !position = !detail[!i].position
        endhandle
        AID TEXT NUMBER $!<this.tagNumber> '$!type: $!name' AT $!<position>
      enddo

    endif

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      stdRefData
--
-- Description: Standard reference data options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       2 dimension array (DTEXT)(RTEXT)
--
------------------------------------------------------------------------

define method .stdRefData() is ARRAY
  !roomDesc    =  !!accConfig.room

  !descriptions   = ARRAY()
  !descriptions.append('Default')
  !descriptions.append('Select None')
  !descriptions.append('Select All')
  !descriptions.append('Volumes with Tags')
  !descriptions.append('Volumes Only')
  !descriptions.append(!roomDesc & ' Volumes with Tags')
  !descriptions.append(!roomDesc & ' Volumes Only')
  !descriptions.append('All Outlines')
  !descriptions.append(!roomDesc &  ' Outlines Only')
  !descriptions.append(!roomDesc & ' Outlines with Tags')
  return !descriptions
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      stdDetail
--
-- Description: Standard detail options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       2 dimension array (DTEXT)(RTEXT)
--
------------------------------------------------------------------------

define method .stdDetail() is ARRAY
  !descriptions   = ARRAY()
  !descriptions.append('Default')
  !descriptions.append('Select None')
  !descriptions.append('Select All')
  !descriptions.append('Walls & Floors')
  !descriptions.append('Fittings Only')
  !descriptions.append('Furniture & Fittings')
  !descriptions.append('Ceiling Elements')
  !descriptions.append('ASL Elements')
  return !descriptions
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setupRefData
--
-- Description: Setup standard reference data options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupRefData(!option is STRING)

  -- Reference Data format <type>,<volume>,<boundary>,<tag>

  if(!option.eq('Select None')) then
    !this.setRefData('BBLOCK',  false, false, false)
    !this.setRefData('BLEVEL',  false, false, false)
    !this.setRefData('ROOM',    false, false, false)
    !this.setRefData('CEILIN',  false, false, false)
    !this.setRefData('CLNPNG',  false, false, false)
    !this.setRefData('STRWEL',  false, false, false)
    !this.setRefData('OPENSP',  false, false, false)
    !this.setRefData('RSTARE',  false, false, false)

  elseif (!option.eq('Select All')) then
    !this.setRefData('BBLOCK',  true, true, true)
    !this.setRefData('BLEVEL',  true, true, true)
    !this.setRefData('ROOM',    true, true, true)
    !this.setRefData('CEILIN',  true, true, true)
    !this.setRefData('CLNPNG',  true, true, true)
    !this.setRefData('STRWEL',  true, true, true)
    !this.setRefData('OPENSP',  true, true, true)
    !this.setRefData('RSTARE',  true, true, true)

  elseif (!option.eq('Volumes with Tags')) then
    !this.setRefData('BBLOCK',  true, false, true)
    !this.setRefData('BLEVEL',  true, false, true)
    !this.setRefData('ROOM',    true, false, true)
    !this.setRefData('CEILIN',  true, false, true)
    !this.setRefData('CLNPNG',  true, false, true)
    !this.setRefData('STRWEL',  true, false, true)
    !this.setRefData('OPENSP',  true, false, true)
    !this.setRefData('RSTARE',  true, false, true)

  elseif (!option.eq('Volumes Only')) then
    !this.setRefData('BBLOCK',  true, false, false)
    !this.setRefData('BLEVEL',  true, false, false)
    !this.setRefData('ROOM',    true, false, false)
    !this.setRefData('CEILIN',  true, false, false)
    !this.setRefData('CLNPNG',  true, false, false)
    !this.setRefData('STRWEL',  true, false, false)
    !this.setRefData('OPENSP',  true, false, false)
    !this.setRefData('RSTARE',  true, false, false)

  elseif (!option.eq('Room Volumes with Tags')) then
    !this.setRefData('BBLOCK',  false, false, false)
    !this.setRefData('BLEVEL',  false, false, false)
    !this.setRefData('ROOM',    true,  false, true)
    !this.setRefData('CEILIN',  false, false, false)
    !this.setRefData('CLNPNG',  false, false, false)
    !this.setRefData('STRWEL',  true,  false, true)
    !this.setRefData('OPENSP',  false, false, false)
    !this.setRefData('RSTARE',  false, false, false)

  elseif (!option.eq('Room Volumes Only')) then
    !this.setRefData('BBLOCK',  false, false, false)
    !this.setRefData('BLEVEL',  false, false, false)
    !this.setRefData('ROOM',    true,  false, false)
    !this.setRefData('CEILIN',  false, false, false)
    !this.setRefData('CLNPNG',  false, false, false)
    !this.setRefData('STRWEL',  true,  false, false)
    !this.setRefData('OPENSP',  false, false, false)
    !this.setRefData('RSTARE',  false, false, false)

  elseif (!option.eq('All Outlines')) then
    !this.setRefData('BBLOCK',  false, true, false)
    !this.setRefData('BLEVEL',  false, true, false)
    !this.setRefData('ROOM',    false, true, false)
    !this.setRefData('CEILIN',  false, true, false)
    !this.setRefData('CLNPNG',  false, true, false)
    !this.setRefData('STRWEL',  false, true, false)
    !this.setRefData('OPENSP',  false, true, false)
    !this.setRefData('RSTARE',  false, true, false)

  elseif (!option.eq('Room Outlines Only')) then
    !this.setRefData('BBLOCK',  false, false, false)
    !this.setRefData('BLEVEL',  false, false, false)
    !this.setRefData('ROOM',    false, true,  false)
    !this.setRefData('CEILIN',  false, false, false)
    !this.setRefData('CLNPNG',  false, false, false)
    !this.setRefData('STRWEL',  false, true,  false)
    !this.setRefData('OPENSP',  false, false, false)
    !this.setRefData('RSTARE',  false, false, false)

  elseif (!option.eq('Room Outlines with Tags')) then
    !this.setRefData('BBLOCK',  false, false, false)
    !this.setRefData('BLEVEL',  false, false, false)
    !this.setRefData('ROOM',    false, true,  true)
    !this.setRefData('CEILIN',  false, false, false)
    !this.setRefData('CLNPNG',  false, false, false)
    !this.setRefData('STRWEL',  false, true,  true)
    !this.setRefData('OPENSP',  false, false, false)
    !this.setRefData('RSTARE',  false, false, false)

  -- Defaults
  else
    !this.setRefData('BBLOCK',  true, true, false)
    !this.setRefData('BLEVEL',  true, true, false)
    !this.setRefData('ROOM',    true, true, false)
    !this.setRefData('CEILIN',  true, true, false)
    !this.setRefData('CLNPNG',  true, true, false)
    !this.setRefData('STRWEL',  true, true, false)
    !this.setRefData('OPENSP',  true, true, false)
    !this.setRefData('RSTARE',  true, true, false)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setupDetail
--
-- Description: Setup standard detail options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupDetail(!option is STRING)

  -- Detail Data format <type>,<detail>,<tag>

  if(!option.eq('Select None')) then
    !this.setDetail('CTWALL', false, false)
    !this.setDetail('DOOR',   false, false)
    !this.setDetail('WINDOW', false, false)
    !this.setDetail('FLRCOV', false, false)
    !this.setDetail('CLNLAT', false, false)
    !this.setDetail('CLNTIL', false, false)
    !this.setDetail('HANG',   false, false)
    !this.setDetail('FURNIT', false, false)
    !this.setDetail('FIXTUR', false, false)
    !this.setDetail('ELFITT', false, false)
    !this.setDetail('FPFITT', false, false)
    !this.setDetail('HVACFI', false, false)
    !this.setDetail('INFITT', false, false)
    !this.setDetail('STRFLT', false, false)
    !this.setDetail('LADDER', false, false)
    !this.setDetail('HANDRA', false, false)
    !this.setDetail('PANE',   false, false)

  elseif (!option.eq('Select All')) then
    !this.setDetail('CTWALL', true, true)
    !this.setDetail('DOOR',   true, true)
    !this.setDetail('WINDOW', true, true)
    !this.setDetail('FLRCOV', true, true)
    !this.setDetail('CLNLAT', true, true)
    !this.setDetail('CLNTIL', true, true)
    !this.setDetail('HANG'  , true, true)
    !this.setDetail('FURNIT', true, true)
    !this.setDetail('FIXTUR', true, true)
    !this.setDetail('ELFITT', true, true)
    !this.setDetail('FPFITT', true, true)
    !this.setDetail('HVACFI', true, true)
    !this.setDetail('INFITT', true, true)
    !this.setDetail('STRFLT', true, true)
    !this.setDetail('LADDER', true, true)
    !this.setDetail('HANDRA', true, true)
    !this.setDetail('PANE',   true, true)

  elseif (!option.eq('Walls & Floors')) then
    !this.setDetail('CTWALL', true,  false)
    !this.setDetail('DOOR',   true,  false)
    !this.setDetail('WINDOW', true,  false)
    !this.setDetail('FLRCOV', true,  false)
    !this.setDetail('CLNLAT', false, false)
    !this.setDetail('CLNTIL', false, false)
    !this.setDetail('HANG'  , false, false)
    !this.setDetail('FURNIT', false, false)
    !this.setDetail('FIXTUR', false, false)
    !this.setDetail('ELFITT', false, false)
    !this.setDetail('FPFITT', false, false)
    !this.setDetail('HVACFI', false, false)
    !this.setDetail('INFITT', false, false)
    !this.setDetail('STRFLT', false, false)
    !this.setDetail('LADDER', false, false)
