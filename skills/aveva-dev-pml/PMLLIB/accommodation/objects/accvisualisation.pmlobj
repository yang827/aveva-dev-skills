------------------------------------------------------------------------
--
-- Method:      setRefData
--
-- Description: Set reference data visualisation settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setRefData(!type is STRING, !volume is BOOLEAN, !boundary is BOOLEAN, !tag is BOOLEAN)

  -- Set if type exists
  !index      = !this.refDataTypes.findFirst(!type)
  if(!index.unset()) then
    !index    = !this.refDataTypes.size() + 1
  endif

  -- Set data
  !this.refDataTypes[!index]    = !type
  !this.refDataVolume[!index]   = !volume
  !this.refDataBoundary[!index] = !boundary
  !this.refDataTag[!index]      = !tag

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getRefData
--
-- Description: Get reference data visualisation settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getRefData(!type is STRING) is ARRAY

  -- Set if type exists
  !index      = !this.refDataTypes.findFirst(!type)
  if(!index.unset()) then
    !index    = !this.refDataTypes.size() + 1
  endif

  -- Return data
  !return[1]  = !this.refDataVolume[!index]
  !return[2]  = !this.refDataBoundary[!index]
  !return[3]  = !this.refDataTag[!index]

  -- Return
  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setDetail
--
-- Description: Set reference data visualisation settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDetail(!type is STRING, !detail is BOOLEAN,!tag is BOOLEAN)

  -- Set if type exists
  !index      = !this.detailTypes.findFirst(!type)
  if(!index.unset()) then
    !index    = !this.detailTypes.size() + 1
  endif

  -- Set data
  !this.detailTypes[!index]   = !type
  !this.detailDetail[!index]  = !detail
  !this.detailTag[!index]     = !tag

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getDetail
--
-- Description: Set reference data visualisation settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getDetail(!type is STRING) is ARRAY

  -- Set if type exists
  !index      = !this.detailTypes.findFirst(!type)
  if(!index.unset()) then
    !index    = !this.detailTypes.size() + 1
  endif

  -- Return data
  !return[1]  = !this.detailDetail[!index]
  !return[2]  = !this.detailTag[!index]

  -- Return
  return !return

endmethod
-- End of method
