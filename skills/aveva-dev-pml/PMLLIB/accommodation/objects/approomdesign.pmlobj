--
--
-- Description:     Object for Room Design application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  barMenu()                        -                   Adds options to the bar menu for this application
--  createMenu()                     -                   Adds options to the Create menu
--  deleteMenu()                     -                   Adds options to the Delete menu
--  displayMenu()                    -                   Adds options to the Display menu
--  graphMenu()                      -                   Adds options to the Graphics menu
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenu()                     -                   Adds options to the Modify menu
--  modifyMenus()                    -                   Runs all other menu creation methods
--  queryMenu()                      -                   Adds options to the Query menu
--  settingsMenu()                   -                   Adds options to the Settings menu
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--  viewGraphMenu()                  -                   Adds options to the Graphics menu
--
------------------------------------------------------------------------
define object APPROOMDESIGN
endobject
-- End of object definition for APPROOMDESIGN

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Position|, 'POSITION')
  !bmenu.add(|Orientate|, 'ORI')
  !!appMenuCntrl.addBarMenu(!bmenu, 'ROOMDESIGN')
endmethod
-- End of method definition for .barMenu()

------------------------------------------------------------------------
--
-- Method:      .displayMenu()
--
-- Description: Adds options to the Display menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayMenu()
  !menu = object APPMENU('sysView')
  !menu.add('SEPARATOR')
  !menu.insertBefore('My Data', 'CALLBACK', |Navigator...|, |!!accTasks('NAVIGATOR')|, 'accNavigator')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')
endmethod
-- End of method definition for .displayMenu()

------------------------------------------------------------------------
--
-- Method:      .graphMenu()
--
-- Description: Adds options to the Graphics menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .graphMenu()
  !menu = object APPMENU('sysGph')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')

endmethod
-- End of method definition for .graphMenu()

------------------------------------------------------------------------
--
-- Method:      .viewGraphMenu()
--
-- Description: Adds options to the Graphics menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewGraphMenu()
  !menu = object APPMENU('COREVIEWMENU')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Room Design default view|, '!!accDefSetup()', 'accDefSetup')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')
endmethod
-- End of method definition for .viewGraphMenu()

------------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description: Adds options to the Query menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryMenu()
  !menu = object APPMENU('sysQry')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Detail Group Contents...|, 'show !!accContentNavigator', 'accDesignContent')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')
endmethod
-- End of method definition for .queryMenu()

------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |View Setup...|,   |show !!accViewSetup|,      'accContents')
  !menu.add('CALLBACK', 'Configuration',   'show !!accConfigSettings',       'accConfig')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')
endmethod
-- End of method definition for .settingsMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Main Reference', '!!accTasks(''MAINREFDATA'')',  'accMainRefData')
  !menu.add('CALLBACK', 'Layout Tasks',   '!!accTasks(''LAYOUT'')',       'accLayout')
  !menu.add('CALLBACK', 'Detail Tasks',   '!!accTasks(''DETAILING'')',    'accDetailing')
  !menu.add('CALLBACK', 'Ceiling Tasks',  '!!accTasks(''CEILING'')',      'accCeiling')

  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')

endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()

  -- Main Room Design Elements
  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Building',                        '!!accCreateElement(''BBLOCK'', !!ce)',  'accCrtBuilding')
  !menu.add('CALLBACK', 'Level',                           '!!accCreateElement(''BLEVEL'', !!ce)',  'accCrtLevel')
  !menu.add('MENU',     'Room',                            'accCrtRooms',        'accCrtRooms')
  !menu.add('MENU',     'Wall',                            'accCrtWalls',        'accCrtWalls')
  !menu.add('MENU',     'Ceiling',                         'accCrtCeilings',     'accCrtCeilings')
  !menu.add('MENU',     'Floor Covering',                  'accCrtFlrCover',     'accCrtFlrCover')
  !menu.add('CALLBACK', 'Furniture, Fittings & Fixtures',  '!!accCreateElement(''FIXTUR'', !!ce)',   'accCrtFittings')
  !menu.add('MENU',     'Insulation Requirement',          'accCrtInsurq',  'accCrtInsurq')
  !menu.add('MENU',     'Stair Well',          'accCrtStrwell',  'accCrtStrwell')

!roomDesignExist   = object MDRLICENCEMANAGER()
  if !roomDesignExist.hascablinglicence('ROOMDESIGN').not() then
 !menu.menu.setFieldProperty('accCrtBuilding', 'active', FALSE)
!menu.menu.setFieldProperty('accCrtLevel', 'active', FALSE)
!menu.menu.setFieldProperty('accCrtRooms', 'active', FALSE)
-- !!appdesmain.sysdes.setactive('Room Design...', false)
endif
  -- Remove entries which are not required for Room Design
  !menu.removeSystem('Site')
  !menu.removeSystem('Zone')
  !menu.removeSystem('Group')
  var !user user
  !u=object user(!user)
  if (!u.access.upcase() eq 'FREE') then
     !menu.removeSystem('SYSTEM')
  endif

  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')

  -- Room Elements
  !menu = object APPMENU('accCrtRooms')
  !menu.add('CALLBACK', 'Definition', '!!accCreateElement(''ROOM'', !!ce)', 'accCrtRoom')
  !menu.add('CALLBACK', 'Standard', '!!accCreateElement(''STDROOM'', !!ce)', 'accCreStdRoom')
  --!menu.add('FORM', 'Standard', 'accCreStdRoom', 'accCreStdRoom')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')

  -- Wall Elements
  !menu = object APPMENU('accCrtWalls')
  !menu.add('CALLBACK', 'Layout',             '!!accCreateElement(''CTWALL'', !!ce)',       'accCrtWallLayout')
  !menu.add('CALLBACK', 'Profiles & Joiners', '!!accCreateElement(''WLPROF'', !!ce)', 'accCrtWallPrfJoin')
  !menu.add('CALLBACK', 'Panels',             '!!accCreateElement(''WLPANE'', !!ce)',   'accCrtWallPanel')
  !menu.add('CALLBACK', 'Doors & Windows',    '!!accCreateElement(''DOOR'', !!ce)',   'accCrtOpening')

  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')

  -- Ceiling Elements
  !menu = object APPMENU('accCrtCeilings')
  !menu.add('CALLBACK', 'Definition',   '!!accCreateElement(''CEILIN'', !!ce)',      'accCrtClnDef')
  !menu.add('CALLBACK', 'Grid',         '!!accCreateElement(''CLNPNG'', !!ce)',       'accCrtClnGrid')
  !menu.add('CALLBACK', 'Supports',     '!!accCreateElement(''HANG'', !!ce)',         'accCrtClnSupp')
  !menu.add('CALLBACK', 'Fittings',     '!!accCreateElement(''CLNFITTING'', !!ce)',  'accCrtClnFit')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')

  -- Floor Elements
  !menu = object APPMENU('accCrtFlrCover')
  !menu.add('CALLBACK', 'Definition', '!!accCreateElement(''FLRCOV'', !!ce)',     'accCrtFlrDef')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')

  -- Insulation Requirements
  !menu = object APPMENU('accCrtInsurq')
  !menu.add('CALLBACK', 'Definition', '!!accCreateElement(''INSURQ'', !!ce)',     'accCrtInsurq')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')

  -- Stair Well
  !menu = object APPMENU('accCrtStrwell')
  !menu.add('CALLBACK', 'Definition', '!!accCreateElement(''STRWEL'', !!ce)',     'accCrtStrwell')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')

endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()
  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Room Design Element', '!!accModifyElement(!!ce)',  'accModRMDElement')
  !menu.add('CALLBACK', 'Room Design Boundary', '!!accProfileEdit(!!ce)',  'accModRMDBoundary')

  -- Remove entries which are not required for Room Design
  var !user user
  !u=object user(!user)
  if (!u.access.upcase() eq 'FREE') then
     !menu.removeSystem('SYSTEM')
  endif

  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')
endmethod
-- End of method definition for .modifyMenu()

------------------------------------------------------------------------
--
-- Method:      .deleteMenu()
--
-- Description: Adds options to the Delete menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteMenu()
  !menu = object APPMENU('sysDel')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')
endmethod
-- End of method definition for .deleteMenu()

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .toolbars()
  frame .accToolbar toolbar 'Room Design Toolbar'
    !iconSize = !!comSysOpt.iconSize()

    !icon     = !!pml.getPathName('rdnavigator16.png')
    button .accNavigator tooltip 'Navigator'  pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!accTasks('NAVIGATOR')|

    !icon     = !!pml.getPathName('rdviewsetup16.png')
    button .accVisualise tooltip 'View Setup' pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!accTasks('VISUALISATION')|

    !icon     = !!pml.getPathName('bblock.png')
    button .accBlock     tooltip 'Building Block Tasks' pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!accTasks('MAINREFDATA')|

    !icon     = !!pml.getPathName('rdlayout16.png')
    button .accLayout tooltip 'Layout'        pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!accTasks('LAYOUT')|

    !icon     = !!pml.getPathName('rddetailing16.png')
    button .accDetail tooltip 'Detailing'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!accTasks('DETAILING')|

    !icon     = !!pml.getPathName('rdmodele16.png')
    button .accModify tooltip 'Modify Room Design Element'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!accModifyElement(!!ce)|

  exit

  !!appTbarCntrl.addToolbar('accToolbar', 'ROOMDESIGN')

endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()
  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly')
  !menu.add('CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR|, 'Relatively')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |XYOffset...|,          '!!accXYOffset(!!ce)',  'XYOffset')
  !menu.add('CALLBACK', |Elevation...|,         '!!accElevation(!!ce)', 'RoomElevation')
  !menu.add('CALLBACK', |Ceiling Height...|,    '!!accClnHeight(!!ce)', 'CeilingHeight')
  !menu.add('CALLBACK', |Floor Height...|,      '!!accFlrHeight(!!ce)', 'FloorHeight')
  !menu.add('CALLBACK', |Label Offset...|,      '!!accLabOffset(!!ce)', 'LabelOffset')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')

  !menu = object APPMENU('ORI')
  !menu.add('CALLBACK', |Axes...|,   |call !!oriElement(!!ce)|,     'Axes')
  !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|,  'Rotate')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Angle from North...|,  '!!accNAngle(!!ce)',      'NAngle')
  !menu.add('CALLBACK', |Angle and Slope...|,   '!!accSlopeAngle(!!ce)',  'AngleSlope')
  !!appMenuCntrl.addMenu(!menu, 'ROOMDESIGN')
  !!appdesmain.sysdes.setactive('Room Design...', TRUE)
endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.viewGraphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
