--
-- Description:
--    Object for handling planer ceiling grids
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addTile(REAL,REAL,DBREF)         -                   Add/replace catalogue tile in list
--  aidNumbers(REAL,REAL,REAL)       -                   Set aid numbers
--  angles(REAL,REAL)                -                   Set north angle and angle from horizontal
--  ceilingGridPlaner()              -                   Constructor
--  ceilingGridPlaner(DBREF)         BOOLEAN             Constructor
--  clearTiles()                     -                   Clear list of tiles
--  createBoundary(PROFILE,REAL)     -                   Create boundary with standard size profiles
--  createGrid()                     BOOLEAN             Create ceiling grid
--  createGridDefinition()           BOOLEAN             Setup attributes of newly created ceiling grid
--  createLattice(BOOLEAN,BOOLEAN,BOOLEAN) BOOLEAN             Create lattice for grid
--  createProfile(LINE,REAL)         -                   Create a set of standard size profiles along a given line
--  createTiles(DBREF)               -                   Create tiles for ceiling grid
--  createTiles(DBREF,ARRAY,DBREF)   BOOLEAN             Create tiles for ceiling grid at passed cell positions
--  draw()                           -                   Draw ceiling grid
--  drawGrid()                       -                   Draw ceiling grid
--  elevation(REAL)                  -                   Set elevation
--  getTileComponent(ARRAY)          DBREF               Get
--  gridAngle(REAL)                  -                   Modify grid angle
--  gridOffset(POSITION)             -                   Modify grid XYOffset using passed position
--  gridOffset(REAL,REAL)            -                   Modify grid XYOffset
--  gridOffset(XYPOSITION)           -
--  gridSpacings(ARRAY,ARRAY)        -                   Modify spacings
--  gridSpacings(REAL,REAL)          -                   Modify spacings (single size grid)
--  hAngle(REAL)                     -                   Set north angle of object
--  initialise(DBREF)                -                   Initialise object against passed element
--  latticeCross(DBREF)              -                   Set lattice cross profile
--  latticeEdge(DBREF)               -                   Set lattice edge profile
--  modifyGridDefinition()           BOOLEAN             Modify ceiling grid definition
--  nAngle(REAL)                     -                   Set north angle of object
--  offsetBoundaries(REAL)           -                   Offset the outer and inner boundaries by the passed value
--  offsetInnerBoundaries(REAL)      -                   Offset the inner boundaries by the passed value
--  offsetOuterBoundary(REAL)        -                   Offset the outer boundary by the passed value
--  position(ARRAY,REAL)             -
--  position(POSITION)               -
--  position(XYPOSITION)             -
--  position(XYPOSITION,REAL)        -
--  tagCells(STRING,ARRAY)           -                   Tag passed cells with passed tag and ID
--  tagTiles()                       -                   Tag derived tile information
--  test()                           -                   Test
--  tidy()                           -                   Tidy up aid graphics
--  tileSizes()                      ARRAY               Returns a list of the tiles sizes for the grid
--  updateTiles(ARRAY)               BOOLEAN             Update passed tiles to use new data, delete any external to the boundary
--  xyOffset(POSITION)               -                   Set XY offset of room from passed position
--  xyOffset(REAL,REAL)              -                   Set xyOffset
--
------------------------------------------------------------------------

define object CEILINGGRIDPLANER

  -- DB Element referenced
  member .dbElement       is DBREF
  member .wrt             is DBREF

  -- New ceiling grid
  member .new             is BOOLEAN

  -- Ceiling Grid
  member .ceilingGrid     is RECTANGULARGRID

  -- CLNPNG plane
  member .plane           is PLANE
  member .referencePlane  is PLANE

  -- Tile information
  -- List of tiles sizes required by grid
  member .tileSizes       is ARRAY

  -- Available catalogue tiles (size paired with tile component)
  --   Size X, Y (2D array)
  member .tileList        is ARRAY
  --   Catalogue reference
  member .tileComponents  is ARRAY

  -- Support lattice profiles
  member .latticeEdge     is DBREF
  member .latticeCross    is DBREF

  -- Continuous edge profile
  member .continuous      is BOOLEAN

  -- Trimmed tolerance size
  member .trimTolerance   is REAL
  -- Min lattice length
  member .minCrossLength  is REAL
  -- Max lattice length
  member .maxProfLength   is REAL

  -- Undo object
  member .undo            is UNDOABLE

  -- Error state, where a method doesn't return a boolean but a null object is returned
  member .errorState      is BOOLEAN
  member .errorText       is STRING
  member .errorList       is ARRAY

  -- Aid graphics
  member .aidInner        is REAL
  member .aidOuter        is REAL
  member .aidNumber       is REAL
  ---------- Design Criteria
  -- Name
  member .name            is STRING
  -- Description
  member .description     is STRING
  -- Function
  member .function        is STRING
  -- Purpose
  member .purpose         is STRING
  -- Area
  member .area            is REAL
  -- Angle from North
  member .nAngle          is REAL
  -- Angel from Horizontal
  member .hAngle          is REAL
  -- Number
  member .number          is REAL
  -- Height
  member .clnHeight       is REAL
  -- Colour scheme
  member .colSchema       is STRING
  -- Fire rating
  member .fireRating      is STRING
  -- Knuckled Tiles
  member .knuckledTiles   is BOOLEAN
  -- Tile Thickness
  member .tileThick       is REAL
  -- XY Offset
  member .xyOffset        is ARRAY
  -- Outer Loop
  member .outerLoop       is PROFILE
  -- Inner Loops
  member .innerLoops        is ARRAY
  -- XSpacing
  member .xSpacings       is REAL
  -- YSpacing
  member .ySpacings       is REAL

  -- Modifiable element
  member .modifiable      is BOOLEAN
  member .modifyMode      is BOOLEAN
  member .modifiableText  is STRING

  member .dynamicUpdate   is BOOLEAN

  -- Cell Size
  member .cellXSize       is REAL
  member .cellYSize       is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:     ceilingGridPlaner
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ceilingGridPlaner()

  -- Initialise Variables
  !this.new             = true
  !this.errorState      = false
  !this.errorText       = STRING()
  !this.errorList.clear()

  -- Tolerances
  if(!!isImperialLength('DIST'))then
    !this.trimTolerance   = 4in
    !this.minCrossLength  = 2in
    !this.maxProfLength   = 80in
  else
    !this.trimTolerance   = 100mm
    !this.minCrossLength  = 50mm
    !this.maxProfLength   = 2000mm
  endif

  -- Continuous edge profile
  !this.continuous      = TRUE

    -- Initialise Variables
  !this.dbElement         = object DBREF()

  -- Frame of reference the BLevel relates to (i.e. BBLOCK element)
  !this.wrt               = World

  -- Element plane
  !this.referencePlane    = object PLANE(N0, Y is N)
  !this.plane             = object PLANE(N0, Y is N)

  -- Grid Spacings
  if(!!isImperialLength('DIST'))then
    !this.xSpacings         = 24in
    !this.ySpacings         = 24in
  else
    !this.xSpacings         = 600mm
    !this.ySpacings         = 600mm
  endif

  -- Angles
  !this.nAngle            = 0
  !this.hAngle            = 0

  -- Number
  !this.number            = 0

  -- Function
  !this.function          = ''

  -- Void Height
  !this.clnHeight         = 0

  -- XY Offset
  !this.xyOffset[1]       = 0
  !this.xyOffset[2]       = 0

  -- Default modifiable settings
  !this.modifiable        = true
  !this.modifiableText    = STRING()

  -- Set modify mode to false, this should only be set by the .modify method
  !this.modifyMode        = FALSE

  !this.dynamicUpdate     = FALSE
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     ceilingGridPlaner
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Ceiling grid CLNPNG
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     If correct
--
------------------------------------------------------------------------

define method .ceilingGridPlaner(!element is DBREF) is BOOLEAN

  -- Initialise Variables
  --!this.ceilingGridPlaner()
  !this.errorState    = false

  -- Check that CLNPNG has been passed
  if(!element.type.neq('CLNPNG')) then
    !this.errorState  = true
    !this.errorText   = 'Element :' & !element.namn & ' is not a ceiling plane.'
    return false
  endif

  -- Set object using passed grid
  !this.new           = false
  !this.dbElement     = !element
  !this.ceilingGrid   = object RECTANGULARGRID(!element)
  !this.plane         = object PLANE(!element.position, !element.orientation)

  !this.outerLoop = !this.ceilingGrid.outerBoundary()
  !this.innerLoops = !this.ceilingGrid.innerBoundaries()

  if(!element.isnamed) then
    !this.name  = !element.name
  endif

  if(!element.number.set()) then
    !this.number  = !element.number
  else
    !this.number  = 0
  endif

    -- Tolerances
  if(!!isImperialLength('DIST'))then
    !this.trimTolerance   = 4in
    !this.minCrossLength  = 2in
    !this.maxProfLength   = 80in
  else
    !this.trimTolerance   = 100mm
    !this.minCrossLength  = 50mm
    !this.maxProfLength   = 2000mm
  endif

  -- Return
  return true

endmethod
-- End of method
-----------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise object against passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .initialise(!element is DBREF)

  -- Set frame of reference
  !this.wrt             = !element
  !this.referencePlane  = object PLANE(!element.position, !element.orientation)
  !this.plane           = object PLANE(!element.position, !element.orientation)

endmethod

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  AID CLEAR ALL $!<this.aidNumber>
  AID CLEAR ALL $!<this.aidOuter>
  AID CLEAR ALL $!<this.aidInner>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     aidNumbers
--
-- Description: Set aid numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidNumbers(!number is REAL, !outer is REAL, !inner is REAL)

  -- Initialise Variables
  !this.aidNumber = !number
  !this.aidOuter  = !outer
  !this.aidInner  = !inner

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridAngle
--
-- Description: Modify grid angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridAngle(!angle is REAL)

  -- Modify object
  !this.ceilingGrid.gridAngle(!angle)

  -- Redraw grid
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridOffset
--
-- Description: Modify grid XYOffset using passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridOffset(!position is POSITION)

  -- Map position on the ceiling grid plane
  !xyPosition = !this.plane.xyOffset(!position)

  -- Get XYOffset of position
  !this.gridOffset(!xyPosition)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridOffset
--
-- Description: Modify grid XYOffset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        X offset
--    2   R      REAL        Y offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridOffset(!xOffset is REAL, !yOffset is REAL)
  !xypos = object XYPOSITION(!xOffset, !yOffset)

  !this.gridOffset(!xypos)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridXYOffset
--
-- Description: Modify grid XYOffset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION  Grid offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridOffset(!xyPosition is XYPOSITION)

  -- Modify object
  !this.ceilingGrid.gridXYPosition(!xyPosition)

  -- Redraw grid
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridSpacings
--
-- Description: Modify spacings (single size grid)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        X Space
--    2   R      REAL        Y Space
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridSpacings(!xSpace is REAL, !ySpace is REAL)

  -- Define array for spacing
  !xSpacing[1] = !xSpace
  !ySpacing[1] = !ySpace

  -- Modify spacings
  !this.gridSpacings(!xSpacing, !ySpacing)

  -- Redraw grid
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridSpacings
--
-- Description: Modify spacings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       X Spacings
--    2   R      ARRAY       Y Spacings
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridSpacings(!xSpacing is ARRAY, !ySpacing is ARRAY)

  -- Modify spacing
  !this.ceilingGrid.gridXSpacings(!xSpacing)
  !this.ceilingGrid.gridYSpacings(!ySpacing)

  -- Redraw grid
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     offsetOuterBoundary
--
-- Description: Offset the outer boundary by the passed value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset value
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetOuterBoundary(!offset is REAL)

  -- Get boundary
  !profile      = !this.ceilingGrid.outerBoundary()

  -- Offset outer boundary
  !modifier     = object SHAPEMODIFIER()
  !newProfile   = !modifier.offset(!profile, !offset)

  -- Update boundary
  !this.ceilingGrid.outerBoundary(!newProfile)

  -- Redraw grid
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     offsetInnerBoundaries
--
-- Description: Offset the inner boundaries by the passed value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset value
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetInnerBoundaries(!offset is REAL)

  -- Get inner boundaries
  !profiles     = !this.ceilingGrid.innerBoundaries()

  if(!profiles.set()) then
    do !i indices !profiles
      !modifier         = object SHAPEMODIFIER()
      !newProfiles[!i]  = !modifier.offset(!profiles[!i], !offset)
    enddo

    -- Update inner boundaries
    !this.ceilingGrid.innerBoundaries(!newProfiles)
  endif

  -- Redraw grid
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     offsetBoundaries
--
-- Description: Offset the outer and inner boundaries by the passed value
--              Inner boundaries are offset by -1 * passed values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset value
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetBoundaries(!offset is REAL)

  -- Get boundary
  !profile      = !this.ceilingGrid.outerBoundary()

  -- Offset outer boundary
  !modifier     = object SHAPEMODIFIER()
  !newProfile   = !modifier.offset(!profile, !offset)

  -- Update boundary
  !this.ceilingGrid.outerBoundary(!newProfile)

  -- Offset inner boundaries
  !profiles     = !this.ceilingGrid.innerBoundaries()

  if(!profiles.set()) then
    do !i indices !profiles
      !modifier         = object SHAPEMODIFIER()
      !newProfiles[!i]  = !modifier.offset(!profiles[!i], !offset * -1)
    enddo

    -- Update inner boundaries
    !this.ceilingGrid.innerBoundaries(!newProfiles)
  endif

  -- Redraw grid
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xyOffset
--
-- Description: Set xyOffset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .xyOffset(!xOffset is REAL, !yOffset is REAL)
  !offset[1]  = !xOffset
  !offset[2]  = !yOffset
  !this.position(!offset, !this.clnHeight)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xyOffset
--
-- Description: Set XY offset of room from passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .xyOffset(!position is POSITION)

  -- Map position on to
  !xyPosition   = !this.referencePlane.xyOffset(!position)

  -- Update position
  !this.position(!xyPosition)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     tileSizes
--
-- Description: Returns a list of the tiles sizes for the grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of tile sizes
--
------------------------------------------------------------------------

define method .tileSizes() is ARRAY

  -- Initialise Variables
  !this.tileSizes.clear()
  !xSpacing   = !this.ceilingGrid.gridXSpacings()
  !ySpacing   = !this.ceilingGrid.gridYSpacings()

  do !x from 0 to !xSpacing.size() - 1
    do !y from 0 to !ySpacing.size() - 1
      !size   = !this.ceilingGrid.cellSize(!x, !y)
      !this.tileSizes.append(!this.ceilingGrid.cellSize(!x, !y))
    enddo
  enddo

  -- Remove duplications
  !this.tileSizes.unique()

  -- Return
  return !this.tileSizes

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     clearTiles
--
-- Description: Clear list of tiles
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearTiles()
  !this.tileList.clear()
  !this.tileComponents.clear()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     latticeCross
--
-- Description: Set lattice cross profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .latticeCross(!cross is DBREF)
  !this.latticeCross  = !cross
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     latticeEdge
--
-- Description: Set lattice edge profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .latticeEdge(!edge is DBREF)
  !this.latticeEdge = !edge
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     addTile
--
-- Description: Add/replace catalogue tile in list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addTile(!x is REAL, !y is REAL, !component is DBREF)

  -- Size
  !size[1]    = !x
  !size[2]    = !y

  -- Check if size is already in the list
  !index      = !this.tileList.findFirst(!size)

  -- If size is not found, then add it to the list
  if(!index.unset()) then
    !index                      = !this.tileList.size() + 1
    !this.tileList[!index]      = !size
  endif

  -- Set catalogue reference
  !this.tileComponents[!index]  = !component

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     createLattice
--
-- Description: Create lattice for grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createLattice(!xCreate is BOOLEAN, !yCreate is BOOLEAN, !boundCrt is BOOLEAN) is BOOLEAN

  -- Check element defined
  if(!this.new) then
    !this.errorState  = true
    !this.errorText   = 'No ceiling grid defined.'
    !this.errorList.clear()
    return false
  endif

  -- Define Undo (temporary until defined in the form
  !this.undo  = object UNDOABLE()

  !this.undo.description('Creating ceiling tiles')
  !this.undo.add()

  -- Initialise Variables
  !outerLoop  = !this.ceilingGrid.outerBoundary()
  !innerLoops = !this.ceilingGrid.innerBoundaries()
  !xLines     = !this.ceilingGrid.xGridlines()
  !yLines     = !this.ceilingGrid.yGridlines()

  -- Get lattices
  !collection = object COLLECTION()
  !collection.scope(!this.dbElement)
  !collection.filter(object EXPRESSION('PURP eq ''PRFL'''))
  !collection.type('CLNLAT')
  !lattices   = !collection.results()

  -- If there is no lattice element, then create one
  if(!lattices.empty()) then
    !!ce      = !this.dbElement
    NEW CLNLAT
    PURP PRFL

  -- Existing lattice
  else
    !!ce      = !lattices.first()

    -- Delete contents of lattice
    !answer = !!alert.confirm('Do you wish to delete the original lattice members?')

    if (!answer.boolean()) then
      DELETE CLNLAT MEMBERS
    endif

  endif

  if (!boundCrt) then
    !this.createBoundary(!outerLoop, !this.maxProfLength)

    do !i indices !innerLoops
      !this.createBoundary(!innerLoops[!i], !this.maxProfLength)
    enddo
  endif

  -- Cross sections of lattice
  if (!xCreate) then
    -- X sections
    do !i indices !xLines
      do !j from 2 to !xLines[!i].size()
        !line         = !xLines[!i][!j]
        skip if(!line.length().lt(!this.minCrossLength))

        !this.createProfile(!line, !this.maxProfLength)
      enddo
    enddo
  endif

  if (!yCreate) then
    -- Y sections
    do !i indices !yLines
      do !j from 2 to !yLines[!i].size()
        !line         = !yLines[!i][!j]
        skip if(!line.length().lt(!this.minCrossLength))

        !this.createProfile(!line, !this.maxProfLength)
      enddo
    enddo
  endif

  -- Determine completely new tiles
  -- Set end mark for UNDO
  !this.undo.endUndoable()

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     createBoundary
--
-- Description: Create boundary with standard size profiles
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      PROFILE    Boundary Profile
--    2    R       REAL      Profile size
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createBoundary(!profile is PROFILE, !sectionSize is REAL)

    !edges = !profile.edges()

    !arcs = object ARRAY()

    do !i indices !edges

      if (!edges[!i].objecttype() eq 'LINE') then

        break if (!edges[!i].startPosition eq !edges[!i].endPosition)

        !lineLength = !edges[!i].length()

        !maxLength = !sectionSize

        -- Standard size functionality
        if (!lineLength lt !maxLength) then

          NEW GENSEC

          !!ce.spref    = !this.latticeEdge
          !!ce.position = !edges[!i].startPosition
          NEW SPINE
          NEW POINSP
          NEW POINSP
          !!ce.position = !edges[!i].endPosition
          GENSEC
          DRNS PERP DRNE PERP
        else

          !startDist = 0
          !startPoint = object POINTVECTOR(!edges[!i].startPosition, !edges[!i].direction())


          do

            break if (!startDist ge !lineLength)

            !firstPoint = !startPoint.offset(!startDist)

            !endDistance = !lineLength - !startDist

            if (!endDistance le !maxLength) then
              !endPoint = !edges[!i].endPosition
            else
              !endPoint = !firstPoint.offset(!maxLength).position
            endif

            NEW GENSEC

            !!ce.spref = !this.latticeEdge
            !!ce.position = !firstPoint.position

            NEW SPINE
            NEW POINSP
            NEW POINSP

            !!ce.position = !endPoint

            GENSEC
            DRNS PERP DRNE PERP

            !startDist = !startDist + !maxLength

          enddo

        endif

      else
        !arcs.append(!edges[!i])
      endif

    enddo

    do !k indices !arcs

      !maxLength = !sectionSize

      !arcLen = !arcs[!k].length()


      if (!arcLen gt !maxLength) then

        !startChord = !maxLength
        !startAngle = !arcs[!k].startAngle
        !endAngle   = !arcs[!k].endAngle

        !firstArc = !arcs[!k]

        !distanceLeft = !arcLen

        do

          break if (!startChord ge !arcLen)

          !newArc = !firstArc.chord(!startChord)

          !newArc.startAngle = !startAngle

          !arcArr = object ARRAY()
          !arcArr.append(!newArc)
          !arcSet = object PROFILE(!profile.position, !profile.orientation, !arcArr)

          NEW GENSEC
          !!ce.spref = !this.latticeEdge
          NEW SPINE
          !arcSet.dbWrite(ce)

          !startAngle = !newArc.endAngle

          !distanceLeft = !arcLen - !startChord

          if (!distanceLeft le !maxLength) then
            !finalArc = object ARC(!arcs[!k].position, !arcs[!k].orientation, !startAngle, !endAngle, !arcs[!k].radius, TRUE)

            !arcArr = object ARRAY()
            !arcArr.append(!finalArc)
            !arcSet = object PROFILE(!profile.position, !profile.orientation, !arcArr)

            NEW GENSEC
            !!ce.spref = !this.latticeEdge
            NEW SPINE
            !arcSet.dbWrite(ce)
          endif

          !startChord = !startChord + !maxLength

        enddo

      else

        !arcArr = object ARRAY()
        !arcArr.append(!arcs[!k])

        !arcSet = object PROFILE(!profile.position, !profile.orientation, !arcArr)

        NEW GENSEC
        !!ce.spref = !this.latticeEdge
        NEW SPINE
        !arcSet.dbWrite(ce)

      endif
    enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createProfile
--
-- Description: Create a set of standard size profiles along a given line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       LINE      Line along which to run the profiles
--    2    R       REAL      Profile length
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createProfile(!line is LINE, !sectionSize is REAL)

    !currLine = !line
    !lineLength = !currLine.length()

    !maxLength = !sectionSize

    -- Standard size functionality
    if (!lineLength lt !maxLength) then

      NEW GENSEC

      !!ce.spref    = !this.latticeCross
      !!ce.position = !currLine.startPosition
      NEW SPINE
      NEW POINSP
      NEW POINSP
      !!ce.position = !currLine.endPosition
      GENSEC
      DRNS PERP DRNE PERP
    else

      !startDist = 0
      !startPoint = object POINTVECTOR(!currLine.startPosition, !currLine.direction())


      do

        break if (!startDist ge !lineLength)

        !firstPoint = !startPoint.offset(!startDist)

        !endDistance = !lineLength - !startDist

        if (!endDistance le !maxLength) then
          !endPoint = !currLine.endPosition
        else
          !endPoint = !firstPoint.offset(!maxLength).position
        endif

        NEW GENSEC

        !!ce.spref = !this.latticeCross
        !!ce.position = !firstPoint.position

        NEW SPINE
        NEW POINSP
        NEW POINSP

        !!ce.position = !endPoint

        GENSEC
        DRNS PERP DRNE PERP

        !startDist = !startDist + !maxLength

      enddo

    endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     createGrid
--
-- Description: Create ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createGrid() is BOOLEAN

  !reference      = !!ce
  NEW CLNPNG
  handle ANY
    return false
  endhandle

  -- Update element data
  !this.dbElement = !!ce
  !this.createGridDefinition()

  -- Return to current element
  --!!ce            = !reference

  -- Return
  return true

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      createGridDefinition
--
-- Description: Setup attributes of newly created ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createGridDefinition() is BOOLEAN

  -- Write out to dbElement
  !this.modifyMode            = TRUE

  -- Check element defined
  if(!this.new.not()) then
    !this.errorState  = true
    !this.errorText   = 'Cannot create definition for an element that already exists'
    !this.errorList.clear()
    return false
  endif

  -- Set name
  if(!this.name.set()) then
    !name                       = !this.name.trim()
    if(!name.neq('')) then
      !name                     = '/' & !name
      !this.dbElement.name      = !name
    endif
  endif

  -- Set basic attributes
  if(!this.description.set()) then
    !this.dbElement.description = !this.description
  endif

  if(!this.function.set()) then
    !this.dbElement.function    = !this.function
  endif

  if(!this.xSpacings.set()) then
    !this.dbElement.grdXSpacing[1] = !this.xSpacings
  endif

  if(!this.ySpacings.set()) then
    !this.dbElement.grdYSpacing[1] = !this.ySpacings
  endif

  if(!this.xyOffset[1].set()) then
    !this.dbElement.gXYOffset[1] = !this.xyOffset[1]
  endif

  if(!this.xyOffset[2].set()) then
    !this.dbElement.gXYOffset[2] = !this.xyOffset[2]
  endif

  if(!this.colSchema.set()) then
    !this.dbElement.colSchema = !this.colSchema
  endif

  if(!this.fireRating.set()) then
    !this.dbElement.fireRating = !this.fireRating
  endif

  if(!this.knuckledTiles.set()) then
    !this.dbElement.knuckl     = !this.knuckledTiles
  endif

  if(!this.tileThick.set()) then
    !this.dbElement.dcTilThk   = !this.tileThick
  endif

  !this.new = FALSE

  !this.position(!this.plane.position)
  !this.angles(!this.nAngle, !this.hAngle)

  !this.modifyMode = FALSE

  return TRUE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     createTiles
--
-- Description: Create tiles for ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createTiles(!cellType is DBREF)

  -- Initialise Variables

  -- Check element defined
  if(!this.new) then
    !this.errorState  = true
    !this.errorText   = 'No ceiling grid defined.'
    !this.errorList.clear()
    return false
  endif

  -- Define Undo (temporary until defined in the form
  !this.undo  = object UNDOABLE()

  !this.undo.description('Creating ceiling tiles')
  !this.undo.add()

  -- Get list of tiles that need to be created
  !newCells   = !this.ceilingGrid.listOfTrimmedCells()
  !newCells.appendArray(!this.ceilingGrid.listOfUntrimmedCells())

  -- Storage area exists for the tiles
  !tileStore      = !!accCeilingGroup(!this.dbElement, 'TILE', 'Ceiling Tiles')

  -- Collect all tiles for ceiling grid (if one exist)
  !collection     = object COLLECTION()
  !collection.scope(!tileStore)
  !collection.type('CLNTIL')
  !existingTiles  = !collection.results()

  -- Get existing tile cells
  !block          = object BLOCK('!existingTiles[!evalIndex].cellID')
  !tileCells      = !existingTiles.evaluate(!block)

  -- Collect all cell positioned elements
  !collection     = object COLLECTION()
  !collection.scope(!this.dbElement)
  !collection.type('CGRDCP')
  !existingComps  = !collection.results()

  -- Get existing tile cells
  !block          = object BLOCK('!existingComps[!evalIndex].cellID')
  !compCells      = !existingComps.evaluate(!block)

  -- If there are no tiles or components, then we only need to look at
  -- creating new tiles.
  if(!existingTiles.unset().and(!existingComps.unset())) then
    !this.createTiles(!tileStore, !newCells, !cellType)

  -- If there are existing fittings/tiles
  -- Basics rules are reuse existing tiles in case they own any fittings
  -- also if there is a CGRDCP in a cell position, then a tile won't be
  -- created in the cell
  else
    aid clear all $!<this.aidNumber>
    -- Create new tiles
    !list = !newCells.difference(!compCells)
    !list = !list.difference(!tileCells)
    !answer = !!alert.confirm('Do you wish to tag the New tiles?')
     if (!answer.boolean()) then
      !this.tagCells('New', !list)
     endif

    !this.createTiles(!tileStore, !list, !cellType)

    -- Update existing tiles
    --!this.tagCells('Old', !tileCells)
    !this.updateTiles(!existingTiles)

  endif

  -- Determine completely new tiles
  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     createTiles
--
-- Description: Create tiles for ceiling grid at passed cell positions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Storage area
--    2   R      ARRAY       List of cell positions to create tiles for
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True of there was no problems
--
------------------------------------------------------------------------

define method .createTiles(!tileStore is DBREF, !cells is ARRAY, !cellType is DBREF) is BOOLEAN

  -- Initialise Variables
  !this.errorState  = false
  !this.errorText   = STRING()
  !this.errorList.clear()
  !errors           = ARRAY()
  !reference        = !!ce
  !max              = !cells.size()

  -- Navigate to store
  !!ce              = !tileStore

  -- Loop through tiles
  do !i indices !cells
    !percent        = !i / !max * 100
    !!fmsys.setProgress(!percent)

    !size =  !this.ceilingGrid.cellSize(!cells[!i][1], !cells[!i][2])

    !correctSize = object ARRAY()
    !correctSize.append(!this.cellXSize)
    !correctSize.append(!this.cellYSize)

    if (!size eq !correctSize) then
      NEW CLNTIL
      !!ce.cellID = !cells[!i]
      !!ce.spref = !cellType
    endif

  enddo

  -- Clear progress
  !!fmsys.setProgress(0)

  -- Return
  !!ce                  = !reference
  if(!errors.set()) then
    !errors.unique()
    !this.errorText     = 'Problems creating ceiling tiles.'
    !this.errorList     = !errors
  endif
  return !this.errorState

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     updateTiles
--
-- Description: Update passed tiles to use new data, delete any external to the boundary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    2   R      ARRAY       List of tiles than need updating
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True of there was no problems
--
------------------------------------------------------------------------

define method .updateTiles(!tiles is ARRAY) is BOOLEAN

  -- Initialise Variables
  !this.errorState  = false
  !this.errorText   = STRING()
  !this.errorList.clear()
  !errors           = ARRAY()
  !reference        = !!ce
  !max              = !tiles.size()

  -- Loop through tiles
  do !i indices !tiles
    !tile           = !tiles[!i]
    !percent        = !i / !max * 100
    !!fmsys.setProgress(!percent)

    -- Get ceil ID
    !cell           = !tile.cellID

    -- Check if cell is in the boundary
    if(!this.ceilingGrid.isCellWithin(!cell[1], !cell[2])) then

      -- Get cell size
      !cellSize       = !this.ceilingGrid.cellSize(!cell[1], !cell[2])
      !tileComponent  = !this.getTileComponent(!cellSize)

      -- Update tile
      if(!tileComponent.set()) then

        -- Update if required
        !tile.spref  = !tileComponent

      -- No component found
      else
        !this.errorState  = true
        !errors.append('No catalogue component for tile size ' &  !cellSize[1] & 'x' & !cellSize[2])
      endif

    -- Delete cell
    else
      !!ce  = !tile
      DELETE CLNTIL

    endif

  enddo

  -- Clear progress
  !!fmsys.setProgress(0)

  -- Return
  !!ce                  = !reference
  if(!errors.set()) then
    !errors.unique()
    !this.errorText     = 'Problems creating update tiles.'
    !this.errorList     = !errors
  endif
  return !this.errorState

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     getTileComponent
--
-- Description: Get
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Cell size
-- Return:
--   [Data Type] [Description]
--    DBREF       Catalogue reference for size
--
------------------------------------------------------------------------

define method .getTileComponent(!size is ARRAY) is DBREF

  -- Initialise Variable
  !component    = object DBREF()

  !index        = !this.tileList.findFirst(!size)

  if(!index.set()) then
    !component  = !this.tileComponents[!index]
  endif

  -- Return
  return !component

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     modifyGridDefinition
--
-- Description: Modify ceiling grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if updated successfully
--
------------------------------------------------------------------------

define method .modifyGridDefinition() is BOOLEAN

  -- Check element defined
  if(!this.new) then
    !this.errorState  = true
    !this.errorText   = 'No element to modify.'
    !this.errorList.clear()
    return false
  endif

  -- Modify Element
  !this.dbElement.gAngle      = !this.ceilingGrid.gridAngle()
  !xyPosition                 = !this.ceilingGrid.gridXYPosition()
  !offset[1]                  = !xyPosition.x
  !offset[2]                  = !xyPosition.y
  !this.dbElement.gXYOffset   = !offset
  !this.dbElement.grdXSpacing = !this.ceilingGrid.gridXSpacings()
  !this.dbElement.grdYSpacing = !this.ceilingGrid.gridYSpacings()

  -- Return
  return true

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: Set elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .elevation(!elevation is REAL)
  !this.position(!this.xyOffset, !elevation)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      nAngle
--
-- Description: Set north angle of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .nAngle(!angle is REAL)
  !this.angles(!angle, !this.hAngle)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hAngle
--
-- Description: Set north angle of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .hAngle(!angle is REAL)
  !this.angles(!this.nAngle, !angle)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      angles
--
-- Description: Set north angle and angle from horizontal
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .angles(!nAngle is REAL, !hAngle is REAL)

  -- Set angle
  !this.nAngle            = !nAngle
  !this.hAngle            = !hAngle

  -- Convert angle into an orientation
  !orientation            = object ORIENTATION('Y is N ' & !this.nAngle & ' W ' & !this.hAngle & ' U ')

  !this.plane.orientation = !orientation

  -- Modify loop definitions

  -- Update db element
  if(!this.dynamicUpdate.or(!this.modifyMode)) then
    !this.outerLoop.orientation = !orientation
    !this.dbElement.orientation = !this.outerLoop.orientation

  -- Redraw element aid graphics
  else
    !this.outerLoop.orientation         = !orientation

    do !i indices !this.innerLoops
      !this.innerLoops[!i].orientation  = !orientation
    enddo
    if !this.outerLoop.position.set() then
      !this.position(!this.outerLoop.position)
    endif
      !this.ceilingGrid.orientation(!orientation)
      !this.ceilingGrid.outerBoundary(!this.outerLoop)
      !this.ceilingGrid.innerBoundaries(!this.innerLoops)

    !this.draw()

  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!position is POSITION)


  -- Map position onto reference plane
  !xyPosition   = !this.referencePlane.xyOffset(!position)
  !mPos         = !this.referencePlane.near(!position)
  !elevation    = !mPos.distance(!position)

  -- Determine the sign of the elevation
  if(!elevation.gt(0)) then
    !dir        = !mPos.direction(!position)
    !elevation  = !elevation * !dir.up
  endif

  -- Update position
  !this.position(!xyPosition, !elevation)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object using the xyPosition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!xyPosition is XYPOSITION)
  !xyOffset[1]  = !xyPosition.x
  !xyOffset[2]  = !xyPosition.y
  !this.position(!xyOffset, !this.clnHeight)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object using the xyPosition and elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!xyPosition is XYPOSITION, !elevation is REAL)

  !xyOffset[1]  = !xyPosition.x
  !xyOffset[2]  = !xyPosition.y

  !this.position(!xyOffset, !elevation)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object using the xyOffset and elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!xyOffset is ARRAY, !elevation is REAL)

  -- Set the xyOffset
  !this.xyOffset        = !xyOffset
  !this.clnHeight       = !elevation

  -- Get position on reference plane
  !xyPosition           = object XYPOSITION(!xyOffset[1], !xyOffset[2])
  !position             = !this.referencePlane.threeDPosition(!xyPosition)
  !position             = !position.offset(!this.referencePlane.direction(), !elevation)

  -- Set position of reference plane
  !this.plane.position  = !position

  -- Update db element
  if(!this.dynamicUpdate.or(!this.modifyMode)) then
    !this.dbElement.gXYOffset  = !this.xyOffset
    !this.dbElement.position   = !position

  -- Redraw element aid graphics
  else
    !this.outerLoop.position         = !position
    do !i indices !this.innerLoops
      !this.innerLoops[!i].position  = !position
    enddo
    !this.ceilingGrid.position(!position)
    !this.ceilingGrid.outerBoundary(!this.outerLoop)
    !this.ceilingGrid.innerBoundaries(!this.innerLoops)

    !this.draw()
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:     drawGrid
--
-- Description: Draw ceiling grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawGrid()

  -- Don't draw if there is no aid number
  if(!this.aidOuter.unset())then
    return
  endif

  -- Remove current graphics
  !this.tidy()

  -- Get boundary information
  !outerBoundary    = !this.ceilingGrid.outerBoundary()
  !outerBoundary.draw(!this.aidOuter, 1, 5)

  -- Inner boundaries
  !innerBoundaries  = !this.ceilingGrid.innerBoundaries()
  do !innerBoundary values !innerBoundaries
    !innerBoundary.draw(!this.aidInner, 1, 4)
  enddo

  -- Get gridlines
  !gridLines        = !this.ceilingGrid.xGridlines()
  do !lines values !gridLines
    do !j indices !lines
      skip if(!j.eq(1))
      !line = !lines[!j]
      !lines[!j].draw(!this.aidInner, 1, 4)
    enddo
  enddo

  !gridLines        = !this.ceilingGrid.yGridlines()
  do !lines values !gridLines
    do !j indices !lines
      skip if(!j.eq(1))
      !lines[!j].draw(!this.aidInner, 1, 4)
    enddo
  enddo

  -- Tag Origin of ceiling grid and point grid act through
  !oPosition  = !this.ceilingGrid.position()
  !xyPosition = !this.ceilingGrid.gridXYPosition()
  -- This should be replace by a .gridPosition()
  !gPosition  = !this.ceilingGrid.gridPosition()

  -- Get display name
  if(!this.name.unset()) then
    !name     = !this.dbElement.name
  else
    !name     = !!accConfig.typeDescription('CLNPNG')
  endif

  -- If grid position and CLNPNG position is the same only tag once
  if(!oPosition.near(!gPosition, 1mm)) then

    AID TEXT NUMBER $!<this.aidNumber> '$!name' At $!<oPosition>
  else
    AID TEXT NUMBER $!<this.aidNumber> '$!name' At $!<oPosition>
    AID TEXT NUMBER $!<this.aidNumber> 'Grid Origin' At $!<gPosition>
  endif

  -- Show XY axis of the grid
  --!xPosition  = !this.ceilingGrid.cellPosition(1,0)
  --!yPosition  = !this.ceilingGrid.cellPosition(0,1)
  --!xDirection = !gPosition.direction(!xPosition)
  --!yDirection = !gPosition.direction(!yPosition)
  --!xLength    = !gPosition.distance(!xPosition)
  --!yLength    = !gPosition.distance(!yPosition)
  --AID ARROW NUMBER $!<this.aidNumber> AT $!<gPosition> DIRECTION $!<xDirection> HEIGHT $!<xLength>
  --AID TEXT  NUMBER $!<this.aidNumber> 'X' AT $!<xPosition>
  --AID ARROW NUMBER $!<this.aidNumber> AT $!<gPosition> DIRECTION $!<yDirection> HEIGHT $!<yLength>
  --AID TEXT  NUMBER $!<this.aidNumber> 'Y' AT $!<yPosition>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Standard draw mechanism for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .draw()

  if (!this.new.not()) then

    !this.drawGrid()

  else

    -- Don't draw if there is no aid number
    if(!this.aidOuter.unset())then
      return
    endif

    -- Remove current graphics
    !this.tidy()

    -- Draw the outer boundary
    !this.outerLoop.draw(!this.aidOuter,1,3)

    -- Draw the inner loops
    do !i indices !this.innerLoops
      !this.innerLoops[!i].draw(!this.aidInner,3,3)
    enddo

    -- Tag origin
    if(!this.name.unset()) then
      !name = 'Ceiling Grid'
    else
      !name = !this.name
    endif

    -- Tag at label position
    !labPosition          = !this.plane.position
    --if(!this.labOff.set()) then
      --!xyPosition         = object XYPOSITION(!this.labOff[1], !this.labOff[2])
      --!labPosition        = !this.plane.threeDPosition(!xyPosition)
      --!labPosition.up     = !labPosition.up     + !this.labOff[3]
    --endif

    if(!labPosition.near(!this.plane.position, 10mm).not()) then
      AID TEXT NUMBER $!<this.aidOuter> '$!name' AT $!labPosition
      AID TEXT NUMBER $!<this.aidOuter> 'Origin' AT $!this.plane.position
    else
      AID TEXT NUMBER $!<this.aidOuter> '$!name' AT $!this.plane.position
    endif

    -- Display Angle direction
    !direction            = !this.referencePlane.orientation.yDir()
    AID ARROW NUMBER $!<this.aidOuter> AT $!this.plane.position DIRECTION $!<direction> HEIGHT 1000mm PROPORTION 0.1

    -- Angle from North
    if(!this.nAngle.neq(0)) then

      if(!this.nAngle.lt(0)) then
        !sense        = false
      else
        !sense        = true
      endif
      !arc            = object ARC(!this.plane.position, Y is N, 90, 90 + !this.nAngle, 750mm, !sense)
      !anglePoint     = !arc.anglePosition(90 + !this.nAngle * 0.5)
      !direction      = !arc.angleDirection(!arc.endAngle)
      if(!this.hAngle.eq(0)) then
        AID ARROW NUMBER $!<this.aidOuter> AT $!this.plane.position DIRECTION $!direction HEIGHT 1000mm
      else
        !line         = !arc.position.line(!arc.anglePosition(90 + !this.nAngle))
        !line.draw(!this.aidOuter, 1, 4)
      endif
      AID TEXT NUMBER $!<this.aidOuter> '$!this.nAngle' AT $!anglePoint
      !arc.draw(!this.aidOuter, 1, 4)

    endif

    -- Angle from horizontal
    if(!this.hAngle.neq(0)) then

      if(!this.hAngle.lt(0)) then
        !sense        = false
      else
        !sense        = true
      endif
      !orientation    = object ORIENTATION('X is N ' & !this.nAngle & 'W and Z is E ' & !this.nAngle & ' N')
      !arc            = object ARC(!this.plane.position, !orientation, 0, !this.hAngle, 750mm, !sense)
      !anglePoint     = !arc.anglePosition(!arc.endAngle)
      !direction      = !arc.angleDirection(!arc.endAngle)
      AID ARROW NUMBER $!<this.aidOuter> AT $!this.plane.position DIRECTION $!direction HEIGHT 1000mm
      AID TEXT NUMBER $!<this.aidOuter> '$!this.hAngle' AT $!anglePoint
      !arc.draw(!this.aidInner, 1, 4)
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     test
--
-- Description: Test
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .test()

  -- Add catalogue tiles to list
  !this.clearTiles()
  !this.addTile(600, 600,   /TI/BP958M3 )
  !this.addTile(1200, 1200, /TI/BP958M4 )
  !this.addTile(1200, 600,  /TI/BP952M3A )
  !this.addTile(600, 1200,  /TI/BP952M3B )

  -- Set lattice profiles
  !this.latticeCross(/CTP24x35x3 )
  !this.latticeEdge(/LTRIM19x33 )

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     tagTiles
--
-- Description: Tag derived tile information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagTiles()

  -- Initialise Variables
  if(!this.trimTolerance.neq(0)) then
    !trimmed  = !this.ceilingGrid.listOfTrimmedCells()
  else
    !trimmed  = !this.ceilingGrid.listOfTrimmedCells(!this.trimTolerance)
  endif
  !untrimmed  = !this.ceilingGrid.listOfUntrimmedCells()


  -- Tag trimmed tiles
  do !cell values !trimmed
    !tagPosition  = !this.ceilingGrid.cellPosition(!cell[1], !cell[2])
    AID TEXT NUMBER $!<this.aidNumber> 'T:$!cell[1]:$!cell[2]' AT $!<tagPosition>
  enddo

  -- Tag untrimmed tiles
  do !cell values !untrimmed
    !tagPosition  = !this.ceilingGrid.cellPosition(!cell[1], !cell[2])
    AID TEXT NUMBER $!<this.aidNumber> '$!cell[1]:$!cell[2]' AT $!<tagPosition>
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     tagCells
--
-- Description: Tag passed cells with passed tag and ID
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Tag
--    2   R      ARRAY       List of tiles
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagCells(!tag is STRING, !cells is ARRAY)

  -- Tag trimmed tiles
  do !cell values !cells
    !tagPosition  = !this.ceilingGrid.cellPosition(!cell[1], !cell[2])
    !tagString    = !tag & '[' & !cell[1] & ':' & !cell[2] & ']'
    AID TEXT NUMBER $!<this.aidNumber> '$!tagString' AT $!<tagPosition>
  enddo

endmethod
-- End of method
