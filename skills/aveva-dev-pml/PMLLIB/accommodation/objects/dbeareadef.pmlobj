---
-- Description:
--    AreaDef object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  create()                         -
--  dbDelete()                       -                   Delete database element
--  dbeAreaDef()                     -                   Constructor
--  dbeAreaDef(DBREF)                -                   Constructor
--  modify()                         -
--  orientation(ORIENTATION)         -                   Set orientation angle of object
--  position(POSITION)               -
--
------------------------------------------------------------------------


define object DBEAREADEF

  -- Common Members
  -- DB Element referenced
  member .dbElement     is DBREF
  -- DB Element Name
  member .name          is STRING
  -- DB Element Description
  member .description   is STRING
  -- DB Element Function
  member .function      is STRING
  -- DB Element Purpose
  member .purpose       is STRING
  -- DB Element Numb
  member .number        is REAL
  -- DB Element Area
  member .area          is REAL


  -- DB Element Pos
  member .position      is POSITION
   -- DB Element ori
  member .orientation   is ORIENTATION

   -- Is DB element modifiable
  member .modifiable    is BOOLEAN

  -- Dynamic update Flag
  member .dynamicUpdate is BOOLEAN
  -- Aid number
  member .aidNumber     is REAL

  -- (Private) Current db modify state, allows the standard attribute methods
  -- to handle both dynamic update and forced DB write via the modify method.
  member .modifyMode    is BOOLEAN


endobject
-- End of object definition



------------------------------------------------------------------------
--
-- Method:      dbeAreaDef
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeAreaDef()

   -- Initialise Variables

  -- Set modify mode to false, this should only be set by the .modify method
  !this.modifyMode    = false

  -- Dynamic update (default modifications change DB automatically)
  !this.dynamicUpdate = false


endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      dbeAreaDef
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeAreaDef(!dbref is DBREF)

 -- Load defaults
  !this.dbeAreaDef()

  -- Check for correct element type
  -- > add code to verify element type

  -- Set db element
  !this.dbElement   = !dbref

  -- Is element modifiable
  !this.modifiable  = !!dbRefUpdatable(!this.dbElement)

  -- Get attributes of the element
  !this.name        = !this.dbElement.name
  !this.description = !this.dbElement.description
  !this.function    = !this.dbElement.function
  !this.purpose     = !this.dbElement.purpose
  !this.number      = !this.dbElement.number
  !this.area        = !this.dbElement.area
  !this.position    = !this.dbElement.position
  !this.orientation      = !this.dbElement.orientation

endmethod
-- End of method


-----------------------------------------------------------------------
--
-- Method:      create
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .create()

  -- save current element for return
  !refe = !!ce

  NEW AREADEF
  handle ANY

  elsehandle NONE
    !this.dbElement = !!ce
    !this.modify()
  endhandle

  -- return to original element
  !!ce = !refe

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .modify()

  -- Write out to dbElement
  !this.modifyMode            = true

  -- save current element for return
  !refe                       = !!ce

  -- go to element
  !!ce                        = !this.dbElement


  !this.dbElement.name        = !this.name
  !this.dbElement.description = !this.description
  !this.dbElement.function    = !this.function
  !this.dbElement.purpose     = !this.purpose
  !this.dbElement.number      = !this.number
  !this.dbElement.area        = !this.area

  -- Reposition element
  !this.position(!this.position)

   -- Set ori
  !this.orientation(!this.orientation)

  -- Set modify mode to false
  !this.modifyMode            = false

  -- return to original element
  !!ce                        = !refe

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      dbDelete
--
-- Description: Delete database element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .dbDelete()

  -- Remove aid graphics
  !this.tidy()

  -- delete may delete a number of things/ some mechanism for this?

  -- save current element for return
  !refe = !!ce

  -- go to element
  !!ce = !this.dbElement

  DELETE AREADEF
  handle ANY
  endhandle

  -- return to original element
  !!ce = !refe
  handle ANY
  endhandle

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Set position
  !this.position = !position

  -- Update db element
  if(!this.dynamicUpdate.or(!this.modifyMode)) then
    !this.dbElement.position = !this.position

  -- Redraw element aid graphics
  else
    !this.draw()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Set orientation angle of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .orientation(!orientation is ORIENTATION)

  -- Set ori
  !this.orientation = !orientation

  -- Update db element
  if(!this.dynamicUpdate.or(!this.modifyMode)) then
    !this.dbElement.orientation = !this.orientation

  -- Redraw element aid graphics
  else
    !this.draw()
  endif

endmethod
-- End of method


