---
-- Description:
--    BNDLIN object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  create()                         -
--  dbeBndLin()                      -                   Constructor
--  dbeBndLin(DBREF)                 -                   Constructor
--  draw()                           -
--  draw(REAL)                       -
--  dynamicUpdate(BOOLEAN)           -                   Set dynamic update flag for object
--  innerBoundaries()                ARRAY               Return inner loops of room
--  modify()                         -
--  orientation(ORIENTATION)         -                   Set orientation angle of object
--  outerBoundary()                  PROFILE             Return outer boundary of room
--  position(POSITION)               -
--  tidy()                           -
--

------------------------------------------------------------------------


define object DBEBNDLIN

  -- Common Members
  -- DB Element referenced
  member .dbElement     is DBREF
  -- Name
  member .name          is STRING
  -- Description
  member .description   is STRING
  -- Function
  member .function      is STRING
  -- Purpose
  member .number        is REAL
  -- Area
  member .area          is REAL

  -- DB Element Pos
  member .position      is POSITION
   -- DB Element ori
  member .orientation   is ORIENTATION

  -- Outer loop
  member .outerLoop     is PROFILE

  -- Inner Loop
  member .innerLoops     is ARRAY

   -- Is DB element modifiable
  member .modifiable    is BOOLEAN

  -- Dynamic update Flag
  member .dynamicUpdate is BOOLEAN
  -- Aid number
  member .aidNumber     is REAL

  -- (Private) Current db modify state, allows the standard attribute methods
  -- to handle both dynamic update and forced DB write via the modify method.
  member .modifyMode    is BOOLEAN


endobject
-- End of object definition



------------------------------------------------------------------------
--
-- Method:      dbeBndLin
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeBndLin()

  -- Initialise Variables

  -- Set modify mode to false, this should only be set by the .modify method
  !this.modifyMode    = false

  -- Dynamic update (default modifications change DB automatically)
  !this.dynamicUpdate = false


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbeBndLin
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeBndLin(!dbElement is DBREF)

  -- Initialise Variables
  !element            = !dbElement
  -- Load Defaults
  !this.dbeBndLin()

  -- If element is not BNDLIN, then get the first one of the passed element
  if(!dbElement.type.neq('BNDLIN')) then
    !element          = !!dtbMemberOfType(!dbElement,'BNDLIN',1)
    if(!element.unset()) then
      return
    endif
  endif

  -- Set db element
  !this.dbElement   = !element

  -- Get Attributes of the element
  if(!this.dbElement.isNamed) then
    !this.name        = !this.dbElement.namn
  endif
  !this.description   =!this.dbElement.description
  !this.function      =!this.dbElement.function
  !this.number        =!this.dbElement.number
  !this.area          =!this.dbElement.area
  !this.position      =!this.dbElement.position
  !this.orientation   =!this.dbElement.orientation

  -- Get Inner and outer Loops if there are any
  if(!this.dbElement.mcount('LOOP').geq(1))then

    -- Outer Loop is always first
    !this.outerLoop = object PROFILE(!this.dbElement.members[1])

    -- Get inner loops
    !innerLoopArray  = !this.dbElement.members.from(2)

     -- Build inner loop array from any others
     do !i indices !innerLoopArray
       !this.innerLoops[!i] = object PROFILE(!innerLoopArray[!i])
     enddo
  else
    -- may be no outlines yet ?
  endif

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      create
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .create()

  -- save current element for return
  !refe = !!ce

  NEW BNDLIN
  handle ANY

  elsehandle NONE
    !this.dbElement = !!ce
    !origPos = !!ce.pos
    !origOri = !!ce.ori
    NEW LOOP
    --write profile object to DB using .dbwrite(DBREF) method
    !this.outerLoop.dbwrite(!!ce)
    --set position of BNDLIN to !origPos (relative to BBLOCK)(position of BNDLIN changes when profile is
    --written, we do not want this - just using position of BBLOCK which owns BNDLIN)
    --ori of BNDLIN set to !origPos
    !!ce.owner.position = !origPos
    !!ce.owner.ori = !origOri
    --do not run .modify() at the moment - not setting anything like description etc.
    --just want a BNDLIN created to own a LOOP
    --!this.modify()
  endhandle

  -- return to original element
  !!ce = !refe

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .modify()

  -- Write out to dbElement
  !this.modifyMode            = true

  -- save current element for return
  !refe                       = !!ce

  -- go to element
  !!ce                        = !this.dbElement

  !this.dbElement.name        = !this.name
  !this.dbElement.description = !this.description
  !this.dbElement.function    = !this.function
  !this.dbElement.number      = !this.number
  !this.dbElement.area        = !this.area
  !this.dbElement.xlength     = !this.xlength   $* method for this?

  -- Xlength ??

  -- Reposition element
  !this.position(!this.position)

   -- Set ori
  !this.orientation(!this.orientation)

  -- Set modify mode to false
  !this.modifyMode            = false

  -- return to original element
  !!ce                        = !refe

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Set position
  !this.position = !position

  -- Update db element
  if(!this.dynamicUpdate.or(!this.modifyMode)) then
    !this.dbElement.position = !this.position

  -- Redraw element aid graphics
  else
    !this.outerLoop.position        = !position
    do !i indices !this.innerLoops
      !this.innerLoops[!i].position  = !position
    enddo
    !this.draw()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Set orientation angle of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .orientation(!orientation is ORIENTATION)

  -- Set ori
  !this.orientation = !orientation

  -- Update db element
  if(!this.dynamicUpdate.or(!this.modifyMode)) then
    !this.dbElement.orientation       = !this.orientation

  -- Redraw element aid graphics
  else
    !this.outerLoop.orientation       = !orientation
    do !i indices !this.innerLoops
      !this.innerLoops[!i].orientation = !orientation
    enddo
    !this.draw()
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Draw method and aid number setting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .draw(!aidNumber is REAL)

  -- Set Aid number
  !this.aidNumber = !aidNumber

  -- Draw outline using standard functionality
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Standard draw mechanism for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .draw()

  -- Don't draw if there is no aid number
  if (!this.aidNumber.unset())then
    return
  endif

  -- Remove current graphics
  !this.tidy()

  --$P individual draw methods for inner outer? different colours styles?
  -- Draw outlines using standard functionality (linestyle and colour hard coded for now)
  !this.outerLoop.draw(!this.aidNumber,1,4)
  do !i indices !this.innerLoops
    !this.innerLoops[!i].draw(!this.aidNumber,1,2)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Tidy
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics

  AID CLEAR ALL $!<this.aidNumber>
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dynamicUpdate
--
-- Description: Set dynamic update flag for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .dynamicUpdate(!update is BOOLEAN)

  -- Set dynamic update
  !this.dynamicUpdate = !update

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      outerBoundary
--
-- Description: Return outer boundary of room
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    PROFILE     Profile of outer boundary
--
------------------------------------------------------------------------

define method .outerBoundary() is PROFILE

  -- Return outer boundary loop
  return !this.outerLoop

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      innerBoundaries
--
-- Description: Return inner loops of room
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--   ARRAY        Array of inner loop profiles
--
------------------------------------------------------------------------

define method .innerBoundaries() is ARRAY

  -- return inner loops
  return !this.innerLoops

endmethod
-- End of method
