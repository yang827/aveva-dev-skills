--
--   Keyword:       ACCOMMODATION
--   Module:        design
--   Replaces:
--
-- Author:
-- Created:
--
--
-- Description:
--    Ceiling object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidNumbers(REAL,REAL,REAL)       -                   Set aid numbers
--  angles(REAL,REAL)                -                   Set north angle and angle from horizontal
--  ceilingThickness(REAL)           -                   Set Physical Ceiling Thickness
--  create()                         BOOLEAN             Create a new ROOM object
--  dbeCeiling()                     -                   Constructor
--  dbeCeiling(DBREF)                BOOLEAN             Constructor
--  draw()                           -
--  draw(REAL,REAL)                  -
--  elevation(REAL)                  -                   Set elevation
--  hAngle(REAL)                     -                   Set north angle of object
--  height(REAL)                     -                   Set height
--  initialise(DBREF)                -                   Initialise object against passed element
--  labelOffset(ARRAY)               -                   Set label offset with XYZ offset
--  labelOffset(POSITION)            -                   Set label offset with passed position
--  modify()                         BOOLEAN             Modify the current dbelement (ROOM)
--  nAngle(REAL)                     -                   Set north angle of object
--  orientation()                    ORIENTATION         return orientation of object
--  outerBoundary(PROFILE)           -                   Sets outer boundary of room
--  plane()                          PLANE               return plane of object
--  position()                       POSITION
--  position(ARRAY,REAL)             -
--  position(POSITION)               -
--  position(XYPOSITION)             -
--  position(XYPOSITION,REAL)        -
--  tidy()                           -                   Tidy up aid graphics
--  xyOffset(POSITION)               -                   Set XY offset of room from passed position
--  xyOffset(REAL,REAL)              -                   Set xyOffset
--

------------------------------------------------------------------------

define object DBECEILING

  ---------- Element Attributes
  -- DB Element referenced
  member .dbElement       is DBREF
  -- Name
  member .name            is STRING
  -- Description
  member .description     is STRING
  -- Function
  member .function        is STRING
  -- Purpose
  member .purpose         is STRING
  -- Numb
  member .number          is REAL
  -- Area
  member .area            is REAL
  -- Angle from North
  member .nAngle          is REAL
  -- Angle from horizontal
  member .hAngle          is REAL
  -- Ceiling height
  member .clnHeight       is REAL
  -- XY Offset
  member .xyOffset        is ARRAY
  -- Label offset
  member .labOff          is ARRAY
  -- Area Reference
  member .areaRef         is DBREF


  -- Void height
  member .clnVoid         is REAL
  -- Default ceiling code
  member .clnCode         is STRING
  -- Default ceiling type
  member .clnType         is STRING

  ---------- Design Criteria
  -- Colour scheme
  member .colSchema       is STRING
  -- Fire rating
  member .fireRating      is STRING

  ------ Physical Ceiling attributes
  -- Panel Thickness
  member	.clnThick				is REAL
  -- Ceiling Material
  member  .clnMaterial 					is DBREF

  -- Private members used to help in deriving data
  -- Plane on which element is placed (i.e. owners plane)
  member .referencePlane  is PLANE
  -- Plane of room which boundary relates to
  member .plane           is PLANE

  -- Boundary Line (this may not be required)
  member .outline         is DBEBNDLIN

  -- Outer Boundary
  member .outerLoop       is PROFILE

  -- Inner Profiles (array of profiles)
  member .innerLoops      is ARRAY

  -- Frame of reference level relates to, i.e. owning BBlock
  member .wrt             is DBREF

  -- Dynamic update Flag
  member .dynamicUpdate   is BOOLEAN

  -- (Private) Current db modify state, allows the standard attribute methods
  -- to handle both dynamic update and forced DB write via the modify method.
  member .modifyMode      is BOOLEAN

  -- Visualization attributes
  -- Aid number
  member .aidAxes         is REAL
  member .aidNumberOuter  is REAL
  member .aidNumberInner  is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      dbeCeiling
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeCeiling()

  -- Initialise Variables
  !this.dbElement         = object DBREF()
  !this.name              = STRING()
  !this.description       = STRING()
  !this.function          = STRING()
  !this.purpose           = STRING()
  !this.number            = 0
  !this.area              = 0
  !this.nAngle            = 0
  !this.hAngle            = 0
  !this.clnHeight         = 0
  !this.xyOffset[1]       = 0
  !this.xyOffset[2]       = 0
  !offset[1]              = 0
  !offset[2]              = 0
  !offset[3]              = 0
  !this.labOff            = !offset
  !this.clnVoid           = 0
  !this.clnCode           = STRING()
  !this.clnType           = STRING()
  !this.colSchema         = STRING()
  !this.fireRating        = STRING()
  !this.clnThick					= 0
  !this.clnMaterial				= object DBREF()

  -- Frame of reference the BLevel relates to (i.e. BBLOCK element)
  !this.wrt               = World

  -- Element plane
  !this.referencePlane    = object PLANE(N0, Y is N)
  !this.plane             = object PLANE(N0, Y is N)

  -- Set modify mode to false, this should only be set by the .modify method
  !this.modifyMode        = false

  -- Dynamic update (default modifications change DB automatically)
  !this.dynamicUpdate     = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbeCeiling
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .dbeCeiling(!dbElement is DBREF) is BOOLEAN

   -- Load defaults
   !this.dbeCeiling()

   -- Verify type of the element passed
   if(!dbElement.fulltype.neq('CEILIN'))then
     !!error.text    = 'Element ' & !dbElement.namn & ' is not a ceiling.'
      return false
   endif

  -- Set db element
  !this.dbElement         = !dbElement

  -- Get attributes of the element
  if(!this.dbElement.isNamed) then
    !this.name        = !this.dbElement.namn
  endif

  !this.description   = !this.dbElement.description
  !this.function      = !this.dbElement.function
  !this.purpose       = !this.dbElement.purpose
  !this.number        = !this.dbElement.number
  !this.area          = !this.dbElement.area
  !this.clnHeight     = !this.dbElement.clnHeight
  !this.xyOffset      = !this.dbElement.xyOffset
  !this.labOff        = !this.dbElement.labOff
  !this.clnVoid       = !this.dbElement.clnVoid
  !this.clnCode       = !this.dbElement.clnCode
  !this.clnType       = !this.dbElement.clnType	
	
  -- Design Criteria
  !this.colSchema     = !this.dbElement.colSchema
  !this.fireRating    = !this.dbElement.fireRating

  !coll = object COLLECTION()
  !coll.scope(!this.dbElement)
  !coll.type('PLOO')
  !loop = !coll.results()
  if(!loop.set())then
  	!this.clnThick    = !loop[1].height
  endif


	-- Material Reference of Physical Ceiling
	if(!this.dbElement.matref.set()) then
  	!this.clnMaterial        = !this.dbElement.matref
  endif

  -- Frame of reference (owner of DETGRP)
  !this.wrt             = !this.dbElement.owner.owner
  !this.referencePlane  = object PLANE(!this.wrt.position, !this.wrt.orientation)

  -- Get orientation and get nAngle and hAngle from it
  !orientation        = !this.dbElement.orientation

  -- Get North and Horizontal angles from orientation wrt reference plane
  !cAngles            = object COMPOUNDANGLES()
  !angles             = !cAngles.angles(!orientation, !this.referencePlane)
  !this.nAngle        = !angles[1]
  !this.hAngle        = !angles[2]

  -- Element plane
  !this.position(!this.xyOffset, !this.clnHeight)

  -- Volume Information
  -- if area reference set record it
  if(!this.dbElement.areaRef.set()) then
    !this.areaRef   = !this.dbElement.areaRef
  endif

  -- Boundary Line Information
  -- Get first BNDLIN of the BBLOCK
  !boundary           = !!dtbMemberOfType(!this.dbElement,'BNDLIN',1)
  if(!boundary.set()) then
    !this.outline     = object DBEBNDLIN(!boundary)
    !this.outerLoop   = !this.outline.outerLoop
    !this.innerLoops  = !this.outline.innerLoops
  endif

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise object against passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .initialise(!wrt is DBREF)

  -- Initialise Variables
  !this.xyOffset[1]     = 0
  !this.xyOffset[2]     = 0
  !this.nAngle          = 0
  !this.hAngle          = 0

  -- Set frame of reference
  !this.wrt             = !wrt
  if !wrt.type.eq('DETGRP') then
  	!this.referencePlane  = object PLANE(!wrt.own.position, !wrt.own.orientation)
    !this.plane           = object PLANE(!wrt.own.position, !wrt.own.orientation)
  else
    !this.referencePlane  = object PLANE(!wrt.position, !wrt.orientation)
    !this.plane           = object PLANE(!wrt.position, !wrt.orientation)
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create a new ROOM object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if created, False if failed error via !!error.text
--
------------------------------------------------------------------------

define method .create() is BOOLEAN

  -- Initialise element
  !reference      = !!ce

  NEW CEILING
  handle ANY
    return false
  endhandle

  -- Update element data
  !this.dbElement = !!ce
  !this.modify()

  -- Return to current element
  !!ce            = !reference

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify the current dbelement (ROOM)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if modified, False if failed error via !!error.text
--
------------------------------------------------------------------------

define method .modify() is BOOLEAN

  -- Write out to dbElement
  !this.modifyMode            = true

  -- save current element for return
  !reference                  = !!ce

  -- go to element
  !!ce                        = !this.dbElement
  handle ANY
    return false
  endhandle

  -- Element not modifiable
  if(!!dbRefUpdatable(!this.dbElement).not()) then
    return false
  endif

  -- Check for Access rights  $**** could this be if (this.modifiable ...
  if(!this.dbElement.dbWrite.not())then
    !!error.text              = 'Unable to modify element "' & !this.dbElement.namn & ' is in readonly database.'
    return false
  endif

  -- Set name
  if(!this.name.set()) then
    !name                       = !this.name.trim()
    if(!name.neq('')) then
      !name                     = '/' & !name
      !this.dbElement.name      = !name
    endif
  endif

  -- Set basic attributes
  if(!this.description.set()) then
    !this.dbElement.description = !this.description
  endif
  if(!this.function.set()) then
    !this.dbElement.function    = !this.function
  endif
  if(!this.purpose.set()) then
    !this.dbElement.purpose     = !this.purpose
  endif

  !this.dbElement.number        = !this.number
  !this.dbElement.area          = !this.area

  !this.dbElement.clnHeight     = !this.clnHeight
  !this.dbElement.clnVoid       = !this.clnVoid

  -- Design Criteria
  !this.dbElement.colSchema     = !this.colSchema
  !this.dbElement.fireRating    = !this.fireRating

  -- Defaults
  if(!this.clnCode.set()) then
    !this.dbElement.clnCode     = !this.clnCode
  endif
  if(!this.clnType.set()) then
    !this.dbElement.clnType     = !this.clnType
  endif

  -- Label offset
  !this.dbElement.labOff        = !this.labOff

  -- Set area reference
  if(!this.areaRef.set()) then
    !this.dbElement.areaRef     = !this.areaRef
  endif

  -- Reposition element
  !this.position(!this.xyOffset, !this.clnHeight)

  -- Set north angle offset
  !this.angles(!this.nAngle, !this.hAngle)

  -- Set modify mode to false
  !this.modifyMode              = false

  -- return to original element
  !!ce                          = !reference

  -- Return
  return true

 endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  AID CLEAR ALL $!<this.aidNumberOuter>
  AID CLEAR ALL $!<this.aidNumberInner>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Map position onto reference plane
  !xyPosition   = !this.referencePlane.xyOffset(!position)
  !mPos         = !this.referencePlane.near(!position)
  !elevation    = !mPos.distance(!position)

  -- Determine the sign of the elevation
  if(!elevation.gt(0)) then
    !dir        = !mPos.direction(!position)
    !elevation  = !elevation * !dir.up
  endif

  -- Update position
  !this.position(!xyPosition, !elevation)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object using the xyPosition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!xyPosition is XYPOSITION)
  !xyOffset[1]  = !xyPosition.x
  !xyOffset[2]  = !xyPosition.y
  !this.position(!xyOffset, !this.clnHeight)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object using the xyPosition and elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!xyPosition is XYPOSITION, !elevation is REAL)
  !xyOffset[1]  = !xyPosition.x
  !xyOffset[2]  = !xyPosition.y
  !this.position(!xyOffset, !elevation)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object using the xyOffset and elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!xyOffset is ARRAY, !elevation is REAL)

  -- Set the xyOffset
  !this.xyOffset        = !xyOffset
  !this.clnHeight       = !elevation

  -- Get position on reference plane
  !xyPosition           = object XYPOSITION(!xyOffset[1], !xyOffset[2])
  !position             = !this.referencePlane.threeDPosition(!xyPosition)
  !position             = !position.offset(!this.referencePlane.direction(), !elevation)

  -- Set position of reference plane
  !this.plane.position  = !position

  -- Update db element
  if(!this.dynamicUpdate.or(!this.modifyMode)) then
    !this.dbElement.xyOffset  = !this.xyOffset
    !this.dbElement.clnHeight = !this.clnHeight

  -- Redraw element aid graphics
  else
    !this.outerLoop.position         = !position
    do !i indices !this.innerLoops
      !this.innerLoops[!i].position  = !position
    enddo
    !this.draw()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: return position of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position() is POSITION
  return !this.plane.position
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: return orientation of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .orientation() is ORIENTATION
  return !this.plane.orientation
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: return plane of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .plane() is PLANE
  return !this.plane
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      outerBoundary
--
-- Description: Sets outer boundary of room
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .outerBoundary(!profile is PROFILE)

  -- Define boundary (this should really be projected on to the current plane of the room)
  !this.outerLoop = !profile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      nAngle
--
-- Description: Set north angle of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .nAngle(!angle is REAL)
  !this.angles(!angle, !this.hAngle)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hAngle
--
-- Description: Set north angle of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .hAngle(!angle is REAL)
  !this.angles(!this.nAngle, !angle)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      angles
--
-- Description: Set north angle and angle from horizontal
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .angles(!nAngle is REAL, !hAngle is REAL)

  -- Set angle
  !this.nAngle            = !nAngle
  !this.hAngle            = !hAngle

  -- Convert angle into an orientation
  !orientation            = object ORIENTATION('Y is N ' & !this.nAngle & ' W ' & !this.hAngle & ' U ')
  !this.plane.orientation = !orientation

  -- Modify loop definitions

  -- Update db element
  if(!this.dynamicUpdate.or(!this.modifyMode)) then
    !this.dbElement.orientation = !orientation

  -- Redraw element aid graphics
  else
    !this.outerLoop.orientation         = !orientation
    do !i indices !this.innerLoops
      !this.innerLoops[!i].orientation  = !orientation
    enddo
    !this.draw()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: Set elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .elevation(!elevation is REAL)
  !this.position(!this.xyOffset, !elevation)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xyOffset
--
-- Description: Set xyOffset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .xyOffset(!xOffset is REAL, !yOffset is REAL)
  !offset[1]  = !xOffset
  !offset[2]  = !yOffset
  !this.position(!offset, !this.clnHeight)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xyOffset
--
-- Description: Set XY offset of room from passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .xyOffset(!position is POSITION)

  -- Map position on to
  !xyPosition   = !this.referencePlane.xyOffset(!position)

  -- Update position
  !this.position(!xyPosition)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      height
--
-- Description: Set height
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .height(!height is REAL)

  -- Set height
  !this.clnVoid = !height
	
  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      ceilingThickness
--
-- Description: Set Physical Ceiling Thickness
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .ceilingThickness(!thickness is REAL)

  -- Set Physical Ceiling Thickness
  !this.clnThick = !thickness
	
  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      labelOffset
--
-- Description: Set label offset with XYZ offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Label offset as XYZ array
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .labelOffset(!labelOffset is ARRAY)

  -- Set offset
  !this.labOffset = !labelOffset

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      labelOffset
--
-- Description: Set label offset with passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Label offset passed as a position
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .labelOffset(!position is POSITION)

  -- Get offset in terms of a position with respect to the element
  !labelOffset[1] = !this.position.east   - !position.east
  !labelOffset[2] = !this.position.north  - !position.north
  !labelOffset[3] = !this.position.up     - !position.up

  -- Set offset
  !this.labelOffset(!labelOffset)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aidNumbers
--
-- Description: Set aid numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .aidNumbers(!aidAxes is REAL, !aidNumberOuter is REAL, !aidNumberInner is REAL)

  -- Set Aid number
  !this.aidAxes         = !aidAxes
  !this.aidNumberOuter  = !aidNumberOuter
  !this.aidNumberInner  = !aidNumberInner

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Draw method and aid number setting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .draw(!aidNumberOuter is REAL, !aidNumberInner is REAL)

  -- Set Aid number
  !this.aidNumberOuter = !aidNumberOuter
  !this.aidNumberInner = !aidNumberInner

  -- Draw outline using standard functionality
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Standard draw mechanism for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .draw()

  -- Don't draw if there is no aid number
  if(!this.aidNumberOuter.unset())then
    return
  endif

  -- Remove current graphics
  !this.tidy()

  -- Draw the outer boundary
  !this.outerLoop.draw(!this.aidNumberOuter,1,3)

  -- Draw the inner loops
  do !i indices !this.innerLoops
    !this.innerLoops[!i].draw(!this.aidNumberInner,3,3)
  enddo

  -- Tag origin
  if(!this.name.unset()) then
    !name = 'Ceiling'
  else
    !name = !this.name
  endif

  -- Tag at label position
  !labPosition          = !this.plane.position
  if(!this.labOff.set()) then
    !xyPosition         = object XYPOSITION(!this.labOff[1], !this.labOff[2])
    !labPosition        = !this.plane.threeDPosition(!xyPosition)
    !labPosition.up     = !labPosition.up     + !this.labOff[3]
  endif

  if(!labPosition.near(!this.plane.position, 10mm).not()) then
    AID TEXT NUMBER $!<this.aidNumberOuter> '$!name' AT $!labPosition
    AID TEXT NUMBER $!<this.aidNumberOuter> 'Origin' AT $!this.plane.position
  else
    AID TEXT NUMBER $!<this.aidNumberOuter> '$!name' AT $!this.plane.position
  endif

  -- Display Angle direction
  !direction            = !this.referencePlane.orientation.yDir()
  AID ARROW NUMBER $!<this.aidNumberOuter> AT $!this.plane.position DIRECTION $!<direction> HEIGHT 1000mm PROPORTION 0.1

  -- Angle from North
  if(!this.nAngle.neq(0)) then

    if(!this.nAngle.lt(0)) then
      !sense        = false
    else
      !sense        = true
    endif
    !arc            = object ARC(!this.plane.position, Y is N, 90, 90 + !this.nAngle, 750mm, !sense)
    !anglePoint     = !arc.anglePosition(90 + !this.nAngle * 0.5)
    !direction      = !arc.angleDirection(!arc.endAngle)
    if(!this.hAngle.eq(0)) then
      AID ARROW NUMBER $!<this.aidNumberOuter> AT $!this.plane.position DIRECTION $!direction HEIGHT 1000mm
    else
      !line         = !arc.position.line(!arc.anglePosition(90 + !this.nAngle))
      !line.draw(!this.aidNumberOuter, 1, 4)
    endif
    !nAngle = !this.nAngle.nint()
    AID TEXT NUMBER $!<this.aidNumberOuter> '$!nAngle' at $!anglePoint
    !arc.draw(!this.aidNumberOuter, 1, 4)

  endif

  -- Angle from horizontal
  if(!this.hAngle.neq(0)) then

    if(!this.hAngle.lt(0)) then
      !sense        = false
    else
      !sense        = true
    endif
    !orientation    = object ORIENTATION('X is N ' & !this.nAngle & 'W and Z is E ' & !this.nAngle & ' N')
    !arc            = object ARC(!this.plane.position, !orientation, 0, !this.hAngle, 750mm, !sense)
    !anglePoint     = !arc.anglePosition(!arc.endAngle)
    !direction      = !arc.angleDirection(!arc.endAngle)
    AID ARROW NUMBER $!<this.aidNumberOuter> AT $!this.plane.position DIRECTION $!direction HEIGHT 1000mm
    !hAngle = !this.hAngle.nint()
    AID TEXT NUMBER $!<this.aidNumberOuter> '$!hAngle' at $!anglePoint
    !arc.draw(!this.aidNumberInner, 1, 4)
  endif

  -- Display height value
  if(!this.clnVoid.gt(0)) then
    !endPoint       = !this.plane.position.offset(U, !this.clnVoid)
    !line           = !this.plane.position.line(!endPoint)
    !line.draw(!this.aidNumberOuter, 1, 4)
    !upperProfile           = !this.outerLoop
    !upperProfile.position  = !endPoint
    !upperProfile.draw(!this.aidNumberOuter,1,4)
  endif

endmethod
-- End of method
