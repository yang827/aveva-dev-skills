------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidNumbers(REAL,REAL,REAL,REAL)  -                   Set aid numbers
--  angle(REAL)                      -
--  angles(REAL)                     -                   Set north angle and angle from horizontal
--  applyNegativeVolume(DBREF)       -
--  checkhierarchy(DBREF,DBREF)      -                   when we are updating fitting spref we may have a case where a fitting now penetrates a ctwall, or did previously
--  create()                         BOOLEAN             Create a new ROOM object
--  createTMPL()                     -                   copy a template into the fitting
--  createWallFitt(DBREF)            BOOLEAN             Create a new ROOM object
--  dbeFitting()                     -                   Constructor
--  dbeFitting(DBREF)                BOOLEAN             Constructor
--  deleteTMPL()                     -                   If we are using a template element below the door or window
--  draw()                           -
--  draw(REAL,REAL)                  -
--  drawNegativeVolume()             -
--  elevation(REAL)                  -                   Set elevation
--  getNegativeVolume(DBREF)         DBREF
--  getOffsets()                     -                   get the x and y offsets for the current element
--  getPosition()                    -
--  getWallZdir(DBREF,DBREF)         ARRAY               get the z direction (and x y for completeness) of a wall segment so that we can adequately orientate a mounted fitting
--  hAngle(REAL)                     -                   Set north angle of object
--  height(REAL)                     -                   Set height
--  initialise(DBREF)                -                   Initialise object against passed element
--  labelOffset(ARRAY)               -                   Set label offset with XYZ offset
--  labelOffset(POSITION)            -                   Set label offset with passed position
--  modify()                         BOOLEAN             Modify the current dbelement (ROOM)
--  orientation()                    ORIENTATION         return orientation of object
--  outerBoundary(PROFILE)           -                   Sets outer boundary of room
--  plane()                          PLANE               return plane of object
--  position()                       POSITION
--  position(ARRAY)                  POSITION
--  position(ARRAY,REAL)             POSITION
--  position(POSITION)               -
--  position(XYPOSITION)             -
--  position(XYPOSITION,REAL)        -
--  tidy()                           -                   Tidy up aid graphics
--  updateHole()                     -                   update an existing fitting hole with any position or orientation changes
--  xyOffset(POSITION)               -                   Set XY offset of room from passed position
--  xyOffset(REAL,REAL)              -                   Set xyOffset
--

------------------------------------------------------------------------

define object DBEFITTING

  ---------- Element Attributes
  -- DB Element referenced
  member .dbelement       is DBREF
  -- opening - if the wall fitting has negative geometry we reference a wall opening
  member .opening         is DBREF
  -- Name
  member .name            is STRING
  -- Description
  member .description     is STRING
  -- Function
  member .function        is STRING
  -- Purpose
  member .purpose         is STRING
  -- Numb
  member .number          is REAL
  -- Spref
  member .spref           is DBREF
  -- Area
  member .area            is REAL
  -- Angle from North
  member .nAngle          is REAL
  -- Angle from horizontal
  member .hAngle          is REAL
  -- XY Offset
  member .xyOffset        is ARRAY
  -- Label offset
  member .labOff          is ARRAY
  -- fitting orientation
  member .fittingori      is ARRAY
  -- fitting component orientation
  member .orientation     is ORIENTATION
  -- wlfitt justification when we are connecting to a wall
  member .justification   is STRING
  -- fitting level is the level at which the fitting is positioned in a room, this is linked to a flrcvr level or a ceiling level
  member .fittingLevel    is REAL

  -- posref is a reference to the posref of an owning wlfitt where the fitting is positioned on a ctwall
  member .posref          is DBREF

  -- Private members used to help in deriving data
  -- Plane on which element is placed (i.e. owners plane)
  member .referencePlane  is PLANE
  -- Plane of room which boundary relates to
  member .plane           is PLANE

  -- position and offset members
  member .position        is ARRAY

  -- Frame of reference level relates to, i.e. owning BBlock
  member .wrt             is DBREF

  -- Is DB element modifiable
  member .modifiable      is BOOLEAN
  member .modifiableText  is STRING

  -- Dynamic update Flag
  member .dynamicUpdate   is BOOLEAN

  -- (Private) Current db modify state, allows the standard attribute methods
  -- to handle both dynamic update and forced DB write via the modify method.
  member .modifyMode      is BOOLEAN

  -- Visualisation attributes
  -- Aid number
  member .aidAxes         is REAL
  member .aidText         is REAL
  member .aidLines        is REAL
  member .aidBox          is REAL

  -- member to store any data held in additional fields for object specific attributes
  member .extraText1      is STRING
  member .extraText2      is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      dbeFitting
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeFitting()

  -- Initialise Variables
  !this.dbelement         = object DBREF()
  !this.opening           = object DBREF()
  !this.name              = ''
  !this.description       = ''
  !this.function          = ''
  !this.purpose           = ''
  --!this.name              = STRING()
  --!this.description       = STRING()
  --!this.function          = STRING()
  --!this.purpose           = STRING()
  !this.number            = 0
  !this.nAngle            = 0
  !this.hAngle            = 0
  !this.position[1]       = 0
  !this.position[2]       = 0
  !this.position[3]       = 0
  !this.xyOffset[1]       = 0
  !this.xyOffset[2]       = 0
  !offset[1]              = 0
  !offset[2]              = 0
  !offset[3]              = 0
  !this.labOff            = !offset

  -- Frame of reference the BLevel relates to (i.e. BBLOCK element)
  !this.wrt               = World

  -- Element plane
  !this.referencePlane    = object PLANE(N0, Y is N)
  !this.plane             = object PLANE(N0, Y is N)

  -- Default modifiable settings
  !this.modifiable        = true
  !this.modifiableText    = STRING()

  -- Set modify mode to false, this should only be set by the .modify method
  !this.modifyMode        = false

  -- Dynamic update (default modifications change DB automatically)
  !this.dynamicUpdate     = FALSE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbeFitting
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .dbeFitting(!dbelement is DBREF) is BOOLEAN

  -- Load defaults
  !this.dbeFitting()
  !elementType = !!accFittingsDefinition.elementType.substring(1,6).upcase()

  -- Verify type of the element passed
  if(!dbelement.type.neq(!elementType))then
    !!error.text    = 'Element ' & !dbelement.namn & ' is not a $!elementType.'
     return false
  endif

  -- Set db element
  !this.dbelement         = !dbelement

  -- Is element modifiable
  !this.modifiable        = !!dbRefUpdatable(!this.dbelement)
  if(!this.modifiable.not()) then
    !this.modifiableText  = !!error.text
  endif

  -- Get attributes of the element
  if(!this.dbelement.isNamed) then
    !this.name        = !this.dbelement.namn
  endif

  !this.description   = !this.dbelement.description
  !this.function      = !this.dbelement.function
  !this.purpose       = !this.dbelement.purpose
  !this.number        = !this.dbelement.number
  !this.orientation   = !this.dbelement.orientation.wrt( /* )

  if !this.dbelement.owner.type.eq('WLFITT') then

    -- the fitting is part of a wall hierarchy and it needs to stay stationary but it's owning WLFITT needs to
    -- be positioned by zdist and vdist relative to a known point on the walls rpath
    !this.posref = !this.dbelement.owner.posref
    !this.xyOffset[1] = !this.dbelement.owner.zdist
    !this.xyOffset[2] = !this.dbelement.owner.vdist
    !this.justification = !this.dbelement.owner.wjusline
    if !this.justification.unset() then
      !this.justification = 'LEFT'
    endif

    ---------------------------CHECK FOR HOLES------------------------
    if !this.dbelement.own.posref.type.eq('WLOPEN') then
      !this.opening = !this.dbelement.own.posref
      !this.xyOffset[1] = !this.opening.zdist
    endif

  else

    !this.getPosition()
    !this.getOffsets()
    !this.fittingLevel = !this.dbelement.position.up

  endif

  !this.spref = !this.dbelement.spref

  ---------------------------------------------------------------------
  -- get any object type specific attributes here----------------------
  ---------------------------------------------------------------------
  !type = !this.dbelement.type
  if !type.eq('INFITT') or !type.eq('ELFITT') or !type.eq('HVACFI') or !type.eq('FPFITT') then
    -- only try and set data for the above types
    if !type.eq('INFITT') then
      !this.extraText1 = !this.dbelement.infotext
    elseif !type.eq('ELFITT') then
      !this.extraText1 = !this.dbelement.elrating.string()
      !this.extraText2 = !this.dbelement.optemperature.string()
    elseif !type.eq('HVACFI') then
      !this.extraText2 = !this.dbelement.optemperature.string()
    elseif !type.eq('FPFITT') then
      !this.extraText1 = !this.dbelement.hazard
    endif
  else
    !this.extraText1 = object STRING()
  endif
  ---------------------------------------------------------------------
  ---------------------------------------------------------------------

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise object against passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .initialise(!wrt is DBREF)

  -- Initialise Variables
  !this.xyOffset[1]     = 0
  !this.xyOffset[2]     = 0
  !this.nAngle          = 0
  !this.hAngle          = 0
  !this.extraText1      = '0'
  !this.extraText2      = '0'

  -- Set frame of reference
  !this.wrt             = !wrt
  !pos = !!accFittingsDefinition.workingelement.position.wrt( /* )
  !this.position[1]        = !pos.east
  !this.position[2]        = !pos.north
  !this.position[3]        = !pos.up

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create a new ROOM object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if created, False if failed error via !!error.text
--
------------------------------------------------------------------------

define method .create() is BOOLEAN

  -- Initialise element
  !reference      = !!ce

  !elementType = !!accFittingsDefinition.elementType.substring(1,6).upcase()
  NEW $!elementType
  handle ANY
    return false
  endhandle

  -- Update element data
  !this.dbelement = !!ce
  !!accFittingsDefinition.workingfitting = !this.dbelement
  !pos =  !this.dbelement.position.wrt( /* )

  !this.position[1] = !pos.east
  !this.position[2] = !pos.north
  !this.position[3] = !pos.up

  !this.modify()

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify the current dbelement (ROOM)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if modified, False if failed error via !!error.text
--
------------------------------------------------------------------------

define method .modify() is BOOLEAN

  -- Write out to dbelement
  !this.modifyMode            = true

  -- save current element for return
  !reference                  = !!ce

  -- go to element
  !!ce                        = !this.dbelement
  handle ANY
    return false
  endhandle

  -- Element not modifiable
  if(!this.modifiable.not()) then
    !!error.text              = !this.modifiableText
    !!alert.warning(!!error.text + ' cannot modify this element')
    return false
  endif

  -- Check for Access rights  $**** could this be if (this.modifiable ...
  if(!this.dbelement.dbWrite.not())then
    !!error.text              = 'Unable to modify element "' & !this.dbelement.namn & ' is in readonly database.'
    return false
  endif

  -- Set name
  if(!this.name.set()) then
    !name                       = !this.name.trim()
    if(!name.neq('')) then
      !name                     = '/' & !name
      !this.dbelement.name      = !name
    endif
  endif

  -- Set basic attributes
  if(!this.description.set()) then
    !this.dbelement.description = !this.description
  endif
  if(!this.function.set()) then
    !this.dbelement.function    = !this.function
  endif
  if(!this.purpose.set()) then
    !this.dbelement.purpose     = !this.purpose
  endif

  !oldspref         = !!ce.spref
  if(!this.spref.set())then
    !!ce.spref        = !this.spref
    -- CHECK TO SEE IF WE ARE CREATING A TEMPLATE FITTING
    if !!ce.spref.tmpref.unset().not() then
      -- we must have a template fitting so first delete any members under the fitting
      !this.deleteTMPL()
      -- now copy the template under the fitting level
      !this.createTMPL()
    else
      -- in case we have just switched from a template fitting to a catalogue fitting delete any members under the fitting
      !this.deleteTMPL()
    endif
  endif

  !this.dbelement.number        = !this.number

  if !this.dbelement.owner.type.eq('WLFITT') then
    -- the fitting is part of a wall hierarchy and it needs to stay stationary but it's owning WLFITT needs to
    -- be positioned by zdist and vdist relative to a known point on the walls rpath
    !this.dbelement.owner.wjusl = !this.justification

    !poseRefType = !this.dbelement.owner.posref.type
    handle ANY
      !poseRefType = ''
    endhandle

    if !poseRefType.eq('WLOPEN') and !this.posref.type.neq('WLOPEN') then
      !this.dbelement.owner.posref.posref = !this.posref
    else
      !this.dbelement.owner.posref = !this.posref
    endif

    !this.dbelement.owner.zdist = !this.xyOffset[1]
    handle ANY
    endhandle
    !this.dbelement.owner.vdist = !this.xyOffset[2]
    handle ANY
    endhandle
    !this.dbelement.orientation = !this.orientation.wrt( /* )
    handle ANY
    endhandle

    -- check to see if we have negative geometry
    !checkhole = !this.spref.catref.ngmre
    handle ANY
      !checkhole = object DBREF()
    endhandle

    -- if the spref of the fitting has changed we need to make sure that if there is any negative geometry it gets translated through as a hole
    if !oldspref.neq(!this.spref) then
      !this.checkhierarchy(!oldspref, !this.spref)
    elseif !checkhole.unset().not() then
      -- we have negative geometry and must update the hole position/orientation etc.
      !this.updateHole()
    endif

  else

    -- Reposition element
    !this.dbelement.position = !this.position(!this.xyOffset)

    !pos = !this.dbelement.position
    !posstring = 'E ' + !pos.east.string() + ' N ' + !pos.north.string() + ' U ' + !this.fittingLevel.string() + ' wrt ' + !pos.origin.string()
    !this.dbelement.position = !posstring.position()

    !this.dbelement.orientation = !this.orientation.wrt( /* )
    handle ANY
    endhandle
  endif

  -- Set modify mode to false
  !this.modifyMode              = false

  ---------------------------------------------------------------------
  -- set any object type specific attributes here----------------------
  ---------------------------------------------------------------------
  if(!this.extraText1.set()) then
    -- find out what type of element we have
    !type = !this.dbelement.type
    -- only try and set data for the following types
    if !type.eq('INFITT') then
      !this.dbelement.infotext = !this.extraText1
    elseif !type.eq('ELFITT') then
      !this.dbelement.elrating = !this.extraText1.real()
    elseif !type.eq('FPFITT') then
      !this.dbelement.hazard = !this.extraText1
    endif
  endif
  if(!this.extraText2.set()) then
    -- find out what type of element we have
    !type = !this.dbelement.type
    -- only try and set data for the following types
    if !type.eq('ELFITT') then
      !this.dbelement.optemperature = !this.extraText2.real()
      !this.extraText2 = !this.dbelement.optemperature.string()
    elseif !type.eq('HVACFI') then
      !this.dbelement.optemperature = !this.extraText2.real()
      !this.extraText2 = !this.dbelement.optemperature.string()
    endif
  endif
  ---------------------------------------------------------------------
  ---------------------------------------------------------------------

  -- return to original element
  !!ce                          = !reference
  handle ANY
  endhandle

  !this.tidy()

  -- Return
  return true

 endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .tidy()
  -- Remove aid graphics
  AID CLEAR ALL $!<this.aidAxes>
  AID CLEAR ALL $!<this.aidText>
  AID CLEAR ALL $!<this.aidLines>
  AID CLEAR ALL $!<this.aidBox>
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Map position onto reference plane
  !xyPosition   = !this.referencePlane.xyOffset(!position)
  !mpos         = !this.referencePlane.near(!position)
  !elevation    = !mpos.distance(!position)

  -- Determine the sign of the elevation
  if(!elevation.gt(0)) then
    !dir        = !mpos.direction(!position)
    !elevation  = !elevation * !dir.up
  endif

  -- Update position
  !this.position(!xyPosition, !elevation)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object using the xyPosition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!xyPosition is XYPOSITION)
  !xyOffset[1]  = !xyPosition.x
  !xyOffset[2]  = !xyPosition.y
  !this.position(!xyOffset, !this.clnHeight)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object using the xyPosition and elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!xyPosition is XYPOSITION, !elevation is REAL)
  !xyOffset[1]  = !xyPosition.x
  !xyOffset[2]  = !xyPosition.y
  !this.position(!xyOffset, !elevation)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object using the xyOffset and elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!xyOffset is ARRAY) is POSITION

  !element = !!accFittingsDefinition.workingelement

  --!xoffset = !this.xyOffset[1]
  --!yoffset = !this.xyOffset[2]
  !xoffset = !xyOffset[1]
  !yoffset = !xyOffset[2]

  -- construct point vector from the at the posref pointing towards the next posref
  !xdir = !element.orientation.xdir()
  !ydir = !element.orientation.ydir()
  !zdir = !element.orientation.zdir()

  !pv1 = object POINTVECTOR(!element.position, !xdir)
  !pv2 = !pv1.offset(!xoffset)
  !pos1 = !pv2.position
  !pv2.direction = !ydir
  !pv3 = !pv2.offset(!yoffset)
  !pos2 = !pv3.position

  return !pos2

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object using the xyOffset and elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!xyOffset is ARRAY, !elevation is REAL) is POSITION

  !element = !!accFittingsDefinition.workingelement

  --!xoffset = !this.xyOffset[1]
  --!yoffset = !this.xyOffset[2]
  !xoffset = !xyOffset[1]
  !yoffset = !xyOffset[2]

  -- construct point vector from the at the posref pointing towards the next posref
  !xdir = !element.orientation.xdir()
  !ydir = !element.orientation.ydir()
  !zdir = !element.orientation.zdir()

  !pv1 = object POINTVECTOR(!element.position, !xdir)
  !pv2 = !pv1.offset(!xoffset)
  !pos1 = !pv2.position
  !pv2.direction = !ydir
  !pv3 = !pv2.offset(!yoffset)
  !pos2 = !pv3.position

  !x = !pos2.east
  !y = !pos2.north
  !z = !elevation
  !ori = !pos2.origin
  !position = object POSITION('E ' + !x.string() + ' N ' + !y.string() + ' U ' + !z.string() + ' wrt ' + !ori.string())
  return !position

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: return position of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position() is POSITION
  !positionArray       = !this.position

  --set position object with positions, wrt world
  !position         = object POSITION()
  !position.east    = !positionArray[1]
  !position.north   = !positionArray[2]
  !position.up      = !positionArray[3]
  !position.origin  = /*
  return !position
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: return orientation of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .orientation() is ORIENTATION
  return !this.plane.orientation
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: return plane of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .plane() is PLANE
  return !this.plane
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      outerBoundary
--
-- Description: Sets outer boundary of room
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .outerBoundary(!profile is PROFILE)

  -- Define boundary (this should really be projected on to the current plane of the room)
  !this.outerLoop = !profile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      nAngle
--
-- Description: Set north angle of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .angle(!angle is REAL)
  !this.angles(!angle)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hAngle
--
-- Description: Set north angle of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .hAngle(!angle is REAL)
  !this.angles(!this.nAngle, !angle)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      angles
--
-- Description: Set north angle and angle from horizontal
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .angles(!angle is REAL)

  -- get the orientation of the fitting
  !ref = !!ce
  !!ce = !this.posref
  handle ANY
    return
  endhandle

  -- check to see if we have a hole
  if !!ce.type.eq('WLOPEN') then
    !!ce = !!ce.posref
  endif

  !point1 = !!ce
  next
  !point2 = !!ce
  !this.fittingori = !this.getWallZdir(!point1, !point2)

  !!ce = !ref

  !x = !this.fittingori[1]
  handle ANY
    return
  elsehandle NONE
    !y = !this.fittingori[2]
    !z = !this.fittingori[3]
  endhandle

  -- Convert angle into an orientation
  --!orientation            = object ORIENTATION('Y is N ' & !this.nAngle & ' W ' & !this.hAngle & ' U ')
  --!oriString = 'x is ' & !x.string().before('WRT') & !angle & !y.string().before('WRT')  & ' and z is ' & !z.string().before('WRT')
  !oriString = 'x is ' & !x.string().before('WRT') & ' and z is ' & !z.string().before('WRT')
  !orientation = object ORIENTATION(!oriString)
  !oriString = !orientation.string()
  handle ANY
    return
  endhandle

  !this.orientation = !oriString.orientation()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: Set elevation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .elevation(!elevation is REAL)
  !this.position(!this.xyOffset, !elevation)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xyOffset
--
-- Description: Set xyOffset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .xyOffset(!xoffset is REAL, !yoffset is REAL)

  if !this.dbelement.owner.type.eq('WTFITT') then
    -- update the aidLines
    !this.draw()
  else

    !offset[1]  = !xoffset
    !offset[2]  = !yoffset
    !this.position(!offset, !this.clnHeight)

endif



endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xyOffset
--
-- Description: Set XY offset of room from passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .xyOffset(!position is POSITION)

  -- Map position on to
  !xyPosition   = !this.referencePlane.xyOffset(!position)

  -- Update position
  !this.position(!xyPosition)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      height
--
-- Description: Set height
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .height(!height is REAL)

  -- Set height
  !this.clnVoid = !height

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      labelOffset
--
-- Description: Set label offset with XYZ offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Label offset as XYZ array
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .labelOffset(!labelOffset is ARRAY)

  -- Set offset
  !this.labOffset = !labelOffset

  -- Draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      labelOffset
--
-- Description: Set label offset with passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Label offset passed as a position
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .labelOffset(!position is POSITION)

  -- Get offset in terms of a position with respect to the element
  !labelOffset[1] = !this.position[1] - !position.east
  !labelOffset[2] = !this.position[2] - !position.north
  !labelOffset[3] = !this.position[3] - !position.up

  -- Set offset
  !this.labelOffset(!labelOffset)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aidNumbers
--
-- Description: Set aid numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .aidNumbers(!aidAxes is REAL, !aidLines is REAL, !aidText is REAL, !aidBox is REAL)

  -- Set Aid number
  !this.aidAxes         = !aidAxes
  !this.aidLines        = !aidLines
  !this.aidText         = !aidText
  !this.aidBox          = !aidBox

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Draw method and aid number setting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .draw(!aidNumberOuter is REAL, !aidNumberInner is REAL)

  -- Set Aid number
  !this.aidNumberOuter = !aidNumberOuter
  !this.aidNumberInner = !aidNumberInner

  -- Draw outline using standard functionality
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Standard draw mechanism for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .draw()

  !reference = !!ce

  -- Remove current graphics
  !this.tidy()

  if !!accFittingsDefinition.workingelement.type.eq('CTWALL') then

    -- Tag origin
    if(!this.name.unset()) then
      !name = 'Fitting'
    elseif(!this.name.eq('')) then
      !name = 'Fitting'
    else
      !name = !this.name
    endif

    !xoffset = !this.xyOffset[1]
    !xoff = !xoffset.nint()
    !yoffset = !this.xyOffset[2]
    !yoff = !yoffset.nint()
    !posref = !this.posref
    handle ANY
    endhandle

    if undefined(!posref) or !posref.unset() then
      return
    endif

    -- check to see if we have a hole
    if !posref.type.eq('WLOPEN') then
      !posref = !posref.posref
    endif

    !!ce = !posref
    next
    handle any
      -- handle closed walls
      first
    endhandle

    !nextposref = !!ce

    -- construct point vector from the posref pointing towards the next posref
    var !dir dir from $!posref to $!nextposref wrt /*
    handle any
      -- no gap between this point and the next
      return
    endhandle

    !pv1 = object POINTVECTOR(!posref.position, !dir.direction())
    !pv2 = !pv1.offset(!xoffset)
    !pvaid = !pv1.offset(!xoffset * 0.5)
    !aidPos1 = !pvaid.position
    !pos1 = !pv2.position

    !pv2.direction = up wrt /*

    !pvaid2 = !pv2.offset(!yoffset * 0.5)
    !aidPos2 = !pvaid2.position
    !pv2 = !pv2.offset(!yoffset)
    !pos2 = !pv2.position

    !xoffval = !xoffset
    !yoffval = !yoffset

    -- get the orientation of the fitting
    !ref = !!ce
    !!ce = !this.posref
    handle ANY
      return
    endhandle

    -- check to see if we have a hole
    if !!ce.type.eq('WLOPEN') then
      !!ce = !!ce.posref
    endif

    !point1 = !!ce
    next
    handle any
      -- handle closed walls
      first
    endhandle
    !point2 = !!ce
    !this.fittingori = !this.getWallZdir(!point1, !point2)

    !!ce = !ref

    !z = !this.fittingori[3]
    handle ANY
      return
    elsehandle NONE
      !x = !this.fittingori[1]
      !y = !this.fittingori[2]
    endhandle

    if !!accFittingsDefinition.justification.selection().eq('LEFT') or !!accFittingsDefinition.justification.selection().eq('CENTRE - DIRECTION LEFT') then
      --flip the zdir if the justification is on the opposite wall face
      !x = !x.opposite()
      !y = !y
      !z = !z.opposite()
    endif

    !pvaid.direction = !z
    !pvaid2.direction = !z
    !aidPos3 = !pvaid.offset(500mm).position
    !aidPos4 = !pvaid2.offset(500mm).position
    !pv1.direction = !z
    !aidPos5 = !pv1.offset(300mm).position
    !pv2.direction = !z
    !aidPos6 = !pv2.offset(300mm).position

    --AID TEXT NUMBER $!<this.aidText> '$!name' AT $!pos2
    AID CYLINDER NUMBER $!<this.aidLines> at $!aidPos4 diameter 10mm height $!yoffval filled on
    AID CYLINDER NUMBER $!<this.aidLines> at $!aidPos3 diameter 10mm ori z is $!dir height $!xoffval filled on
    AID CYLINDER NUMBER $!<this.aidLines> at $!aidPos5 diameter 10mm ori z is $!z height 600mm filled on
    AID CYLINDER NUMBER $!<this.aidLines> at $!aidPos6 diameter 10mm ori z is $!z height 600mm filled on
    AID CYLINDER NUMBER $!<this.aidLines> at $!aidPos6 diameter 10mm ori z is $!z height 100mm filled on
    AID SPHERE NUMBER $!<this.aidLines> $!pos1 diameter 10mm
    AID TEXT NUMBER $!<this.aidText> '$!xoff' AT $!aidPos3
    AID TEXT NUMBER $!<this.aidText> '$!yoff' AT $!aidPos4

    !volume = object LOCALVOLUME(!this.dbelement, !this.dbelement)
    handle ANY
    elsehandle NONE
      !box = object GPHBOX(!volume.box())
      !box.box.orientation = !this.orientation
      !box.draw(!this.aidBox)
      handle ANY
      endhandle


      !ydir = !this.orientation.ydir()
      --!currentxdir = !this.dbelement.orientation.xdir()
      --!newxdir = !box.box.orientation.xdir()
      AID ARROW NUMBER $!<this.aidLines> at $!pv2.position DIR $!y height 1000mm

      !angle = !!accFittingsDefinition.angle.val
      if !angle.real().lt(0) then
        !sense = FALSE
      else
        !sense = TRUE
      endif
      !oriString = 'y is ' & !y.string().before('WRT') & ' and z is ' & !z.string().before('WRT')
      handle ANY
      endhandle
      !arc            = object ARC(!pv2.position, !oriString.orientation(), 90, 90 + $!angle, 750mm, !sense)
      handle ANY
      endhandle
      !anglePoint     = !arc.anglePosition(0 + $!angle * 0.5)
      handle ANY
      elsehandle NONE
        AID TEXT NUMBER $!<this.aidText> '$!angle' AT $!anglePoint
        !direction      = !arc.angleDirection(!arc.endAngle)
        AID ARROW NUMBER $!<this.aidLines> at $!pv2.position DIR $!direction height 1000mm
        !arc.draw(!this.aidLines, 1, 4)
      endhandle

    endhandle

    !strOrientation   = 'Z is ' + !this.fittingori[3].string() + ' and Y is ' + !this.fittingori[2].string()
    !axesOrientation  = object ORIENTATION(!strOrientation)
    !axes             = object GPHAXES(!pos2, !axesOrientation)
    !axes.description = ' ' & !pos2
    !axes.tag         = false
    !axes.detail      = false
    !axes.visibleZ    = false
    !axes.draw(!this.aidAxes)

  else
    -- Tag origin
    if(!this.name.unset()) then
      !name = 'Fitting'
    elseif(!this.name.eq('')) then
      !name = 'Fitting'
    else
      !name = !this.name
    endif

    !xoffset = !this.xyOffset[1]
    !xoff = !xoffset.nint()
    !yoffset = !this.xyOffset[2]
    !yoff = !yoffset.nint()
    !zoffset = !this.fittingLevel
    !zoff = !zoffset.nint()
    !posref = !!accFittingsDefinition.workingelement

    if undefined(!posref) then
      return
    endif

    -- construct point vector from the at the posref pointing towards the next posref
    !xdir = !posref.orientation.xdir()
    !ydir = !posref.orientation.ydir()
    !zdir = !posref.orientation.zdir()

    !pv1 = object POINTVECTOR(!posref.position, !xdir)
    !pv2 = !pv1.offset(!xoff)
    !pos1 = !pv2.position
    !pvaidPos1 = !pv1.offset(!xoff * 0.5)
    !pv2.direction = !ydir
    !pv3 = !pv2.offset(!yoff)
    !pvaidPos3 = !pv2.offset(!yoff * 0.5)
    !pos2 = !pv3.position
    !pv3.direction = !zdir
    !pv4 = !pv3.offset(!zoff)
    !pos3 = !pv4.position
    !pvaidPos4 = !pv3.offset(!zoff * 0.5)

    !aidPos1 = !pvaidPos1.position
    !aidPos2 = !pvaidPos3.position
    !aidPos3 = !pvaidPos4.position

    !xoffval = !xoff.abs()
    !yoffval = !yoff.abs()
    !zoffval = !zoff.abs()

    AID CYLINDER NUMBER $!<this.aidLines> at $!aidPos3 diameter 5mm ori z is $!zdir height $!zoffval filled on
    AID CYLINDER NUMBER $!<this.aidLines> at $!aidPos2 diameter 5mm ori z is $!ydir height $!yoffval filled on
    AID CYLINDER NUMBER $!<this.aidLines> at $!aidPos1 diameter 5mm ori z is $!xdir height $!xoffval filled on
    AID SPHERE NUMBER $!<this.aidLines> $!pos1 diameter 5mm
    AID SPHERE NUMBER $!<this.aidLines> $!pos2 diameter 5mm
    AID TEXT NUMBER $!<this.aidText> '$!xoff' AT $!aidPos1
    AID TEXT NUMBER $!<this.aidText> '$!yoff' AT $!aidPos2
    AID TEXT NUMBER $!<this.aidText> '$!zoff' AT $!aidPos3

    !axes             = object GPHAXES(!pos3, !posref.orientation)
    !axes.description = ' ' & !pos3
    !axes.tag         = true
    !axes.detail      = FALSE
    !axes.draw(!this.aidAxes)
    handle ANY
    endhandle

    !this.position[1] = !pos2.east
    !this.position[2] = !pos2.north
    !this.position[3] = !pos2.up

  endif

  !!ce = !reference

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createWallFitt
--
-- Description: Create a new ROOM object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if created, False if failed error via !!error.text
--
------------------------------------------------------------------------

define method .createWallFitt(!wallfeature is DBREF) is BOOLEAN

  -- Initialise element
  !!ce = !wallfeature
  new WLFITT

  !elementType = !!accFittingsDefinition.elementType.substring(1,6).upcase()
  NEW $!elementType
  handle ANY
    return false
  endhandle

  -- Update element data
  !this.dbelement = !!ce
  !!accFittingsDefinition.workingfitting = !this.dbelement

  -- run the set justification routine in accfittingsdefinition because it relies upon the dbelement being set
  -- if we don't do it here then the component will be incorrectly justified on creation
  !!accFittingsDefinition.setjustification()
  !!accFittingsDefinition.updatedata()
  !this.modify()

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOffsets
--
-- Description: get the x and y offsets for the current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getOffsets()

  !element = !!accFittingsDefinition.workingelement
  -- find offset of current element from the working element in the plane of the working element
  !plane = object PLANE(!element.position, !element.orientation)
  !xyOffset = !plane.xyOffset(!this.dbelement.position)

  !this.xyOffset[1] = !xyOffset.x
  !this.xyOffset[2] = !xyOffset.y

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPosition
--
-- Description: get the world x y z components for the current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getPosition()

  !pos = !this.dbelement.position.wrt( /* )

  !this.position[1] = !pos.east
  !this.position[2] = !pos.north
  !this.position[3] = !pos.up

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getWallZdir
--
-- Description: get the z direction (and x y for completeness) of a wall segment so that we can adequately orientate a mounted fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       !point 1 is a POINTR loop element underneath an RPATH which corresponds to the first point that a fitting is positioned between
--    2    R     DBREF       !point 2 is a POINTR loop element underneath an RPATH which corresponds to the second point that a fitting is positioned between
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getWallZdir(!point1 is DBREF, !point2 is DBREF) is ARRAY
  !dirarray = object ARRAY()
  -- get the z orientation of the owning CTWALL
  !wall = !!accFittingsDefinition.workingelement

  if !wall.type.neq('CTWALL') then
    return
  endif

  !ydir = !wall.orientation.zdir().wrt( /* )

  -- get the direction from !point1 to !point2
  !xdir = !point1.position.direction(!point2.position)
  handle any
    !xdir = !wall.orientation.xdir().wrt( /* )
  endhandle

  -- cross x and y directions to get the required z direction from the wall segment
  !zdir = !xdir.cross(!ydir)

  !dirarray.append(!xdir)
  !dirarray.append(!ydir)
  !dirarray.append(!zdir)

  return !dirarray

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getNegativeVolume
--
-- Description: look at the spref of the door and see if we can derive a negative
-- the position gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .getNegativeVolume(!spref is DBREF ) is DBREF

  !catref = !spref.catref
  handle ANY
  endhandle
  !ngmre = !catref.ngmre
  handle ANY
  endhandle
  var !sloop coll all SLOOP for $!ngmre
  if !sloop.set() then
    !loop = !sloop[1].dbref()
  else
    !loop = object DBREF()
  endif

  return !loop

endmethod

------------------------------------------------------------------------
--
-- Method:      ApplyNegativeVolume
--
-- Description: build a cutout in the wall using the negative
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .applyNegativeVolume(!loop is DBREF)

  if !loop.set() then

    var !rPaths coll all rPath for $!this.opening
    handle ANY
      return
    endhandle
    if !rPaths.size().gt(0) then
      !rPath = !rPaths[1].dbref()
    else
      !!ce = !this.opening
      NEW RPATH
      !rPath = !!ce
    endif

  endif

   !profile        = object PROFILE(!loop,!this.dbelement)
   !profile.dbWrite(!rPath)
  !!ce            = !rPath

endmethod
------------------------------------------------------------------------
--
-- Method:      DrawNegativeVolume
--
-- Description: build a cutout in the wall using the negative
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .drawNegativeVolume()

if !this.loop.set() then
   var !rPaths coll all rPath for $!this.wallOpening
   handle ANY
   endhandle
   if !rPaths.size().gt(0) then
      !this.rPath = !rPaths[1].dbref()
   else
      !!ce = !this.wallOpening
      new rPath
      !this.rPath = !!ce
   endif
   !profile = object PROFILE(!this.loop,!this.opening)
   !profile.dbWrite(!this.rPath)
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      checkhierarchy
--
-- Description: when we are updating fitting spref we may have a case where a fitting now penetrates a ctwall, or did previously
--              but does not now. if this is the case we need to update the hierarchy to reflect this.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .checkhierarchy(!oldref is DBREF, !newref is DBREF)

  !ref = !!ce

  !oldcatref = !oldref.catref
  handle ANY
    !oldcatref = object DBREF()
  endhandle
  !oldngmre = !oldcatref.ngmre
  handle ANY
    !oldngmre = object DBREF()
  endhandle

  !newcatref = !newref.catref
  handle ANY
    !newcatref = object DBREF()
  endhandle
  !newngmre = !newcatref.ngmre
  handle ANY
    !newngmre = object DBREF()
  endhandle

  if !oldngmre.unset().not() and !newngmre.unset().not() then
    -- we should have a wlopen element in place to put the new negative geometry into so leave the hierarchy alone
    -- we do need to mess around with vdist etc. and write the new rpath stuff into the opening
    !this.opening.zdist = !this.xyOffset[1]
    !this.opening.vdist = !this.xyOffset[2]
    !this.dbelement.own.zdist = 0

    if !this.justification.split()[1].eq('CENTRE') then
      !this.opening.wjusl = !this.justification.split()[4]
    else
      !this.opening.wjusl = !this.justification
    endif
    !loop = !this.getNegativeVolume(!newref )
    !this.applyNegativeVolume(!loop)

  elseif !oldngmre.unset() and !newngmre.unset().not() then

    -- the old fitting did not have any hole data and therefore no wlopen reference, we need to create a wlopen, reference the
    -- posref of the wlfitt element to the new wlopen element, mess around with vdist, zdist etc. and finally write the rpath stuff
    -- into the wlopen element
    !!ce = !this.dbelement.own
    new wlopen
    !this.opening = !!ce
    !this.dbelement.own.posref = !this.opening
    !this.opening.posref = !this.posref

    !this.opening.zdist = !this.xyOffset[1]
    !this.opening.vdist = !this.xyOffset[2]
    !this.dbelement.own.zdist = 0

    if !this.justification.split()[1].eq('CENTRE') then
      !this.opening.wjusl = !this.justification.split()[4]
    else
      !this.opening.wjusl = !this.justification
    endif
    !loop = !this.getNegativeVolume(!newref )
    !this.applyNegativeVolume(!loop)

  elseif !oldngmre.unset().not() and !newngmre.unset() then

    -- the old fitting had a hole but the new one does not, hence remove the wlopen element and reinstate the proper vdist/zdist values
    !!ce = !this.opening
    handle ANY
      -- do nothing
    elsehandle NONE
      delete WLOPEN
      handle ANY
      endhandle
    endhandle

    !this.dbelement.own.zdist = !this.xyOffset[1]

  endif

  !!ce = !ref
  handle any
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      updateHole
--
-- Description: update an existing fitting hole with any position or orientation changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .updateHole()

  !this.opening.zdist = !this.xyOffset[1]
  !this.dbelement.own.zdist = 0

  if !this.justification.split()[1].eq('CENTRE') then
    !this.opening.wjusl = !this.justification.split()[4]
  else
    !this.opening.wjusl = !this.justification
  endif
  !loop = !this.getNegativeVolume(!this.spref)
  !this.applyNegativeVolume(!loop)

endmethod

------------------------------------------------------------------------
--
-- Method:      createTMPL
--
-- Description: copy a template into the fitting
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .createTMPL()

  !!ce = !this.dbelement
  !comprop = object COMPROP()
  !comprop.initialise(!this.dbelement.spref)
  !comprop.setProperties(!this.dbelement)
  !comprop.unsetDesiElement()

endmethod
------------------------------------------------------------------------
--
-- Method:      deleteTMPL
--
-- Description: If we are using a template element below the door or window
--              we can only modify the template by deleting the old one and
--              building a new one
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .deleteTMPL()

  if !this.dbelement.mcount('TMPL').gt(0) then
    !!ce = TMPL1 of $!this.dbelement
    unlock all
    delete TMPL
  endif

endmethod
