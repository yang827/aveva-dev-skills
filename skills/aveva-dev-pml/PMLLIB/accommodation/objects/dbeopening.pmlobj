--
--
-- Description:
--    Furniture object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidNumbers(REAL,REAL)            -                   Set aid numbers
--  applyInset(REAL)                 -
--  applyNegativeVolume()            -
--  buildFittingPath(PROFILE)        -                   build a cutout in the wall using the negative of a catalogue item
--  buildTemplatePath(PROFILE)       -                   build a cutout in the wall using the negative of a template
--  collect(STRING,DBREF,STRING)     ARRAY               general method for collecting
--  create()                         BOOLEAN             Create a new ROOM object
--  createTMPL()                     -                   copy a template into the opening
--  dbeopening()                     -                   Constructor
--  dbeopening(DBREF)                BOOLEAN             Constructor
--  deleteTMPL()                     -                   If we are using a template element below the door or window
--  draw()                           -
--  draw(REAL,REAL)                  -
--  drawNegativeVolume()             -
--  getNegativeVolume(DBREF)         -
--  getWallZdir(DBREF,DBREF)         ARRAY               get the z direction (and x y for completeness) of a wall segment so that we can adequately orientate a mounted fitting
--  modify()                         BOOLEAN             Modify the current wallOpening (ROOM)
--  setSpref(DBREF)                  -
--  tidy()                           -                   Tidy up aid graphics
--

------------------------------------------------------------------------

define object DBEOPENING

  ---------- Element Attributes
  --  referenced wall opening
  member .wall            is DBREF
  --  referenced wall feature
  member .wallFeature     is DBREF
  --  referenced wall opening
  member .wallOpening     is DBREF
  -- referenced actual door or window
  member .opening         is DBREF
  -- the type of opening we are going to create
  member .elementType     is STRING
  -- is it using a template or a catalogue component
  member .catalogueType   is STRING
  -- if its a template then
  member .template        is DBREF
  -- the rPath element which defines the zDistance
  member .posref          is DBREF
  -- loop for making hole PROFILE
  member .loop            is DBREF
  -- rPath for making the hole
  member .rPath           is DBREF
  -- Name
  member .name            is STRING
  -- Description
  member .description     is STRING
  -- Function
  member .function        is STRING
  -- Purpose
  member .purpose         is STRING
  -- position
  member .position        is POSITION
  -- orientation
  member .orientation     is ORIENTATION
  -- opening orientation
  member .openingOri     is ARRAY
  -- vDistance of wall opening
  member .vDistance       is REAL
  -- zDistance from the posRef element
  member .zDistance       is REAL
   -- justification
  member .wJusl           is STRING
 -- pkdist if used (Really don't want to use this if possible)
  member .pkDist          is REAL
  -- Numb
  member .number          is REAL
  -- Spref
  member .spref           is DBREF
  -- Area
  member .area            is REAL
  -- XY Offset
  member .labOff          is ARRAY
  -- Area Reference
  member .areaRef         is DBREF
  -- STD property data
  member .inset           is REAL
  -- store the design parameters for re-use
  member .despars         is ARRAY

  ---------- Design Criteria
  -- Colour scheme
  member .colSchema       is STRING
  -- FireRating
  member .fireRating      is STRING

  -- Private members used to help in deriving data
  -- Plane on which element is placed (i.e. owners plane)
  member .referencePlane  is PLANE
  -- Plane of room which boundary relates to
  member .plane           is PLANE

  -- Frame of reference level relates to, i.e. owning BBlock
  member .wrt             is DBREF

  -- Is DB element modifiable
  member .modifiable      is BOOLEAN
  member .modifiableText  is STRING

  -- Dynamic update Flag
  member .dynamicUpdate   is BOOLEAN

  -- (Private) Current db modify state, allows the standard attribute methods
  -- to handle both dynamic update and forced DB write via the modify method.
  member .modifyMode      is BOOLEAN

  -- Visualization attributes
  -- Aid number
  member .aidNumber  is REAL
  member .aidAxes    is REAL


endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      dbeopening
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeopening()

  -- Initialise Variables
  -- Assign aid numbers for form
  !this.aidNumber         = !!aidNumbers.add('Opening - position')
  !this.aidAxes           = !!aidNumbers.add('Opening - Axes')
  !this.wall              = object DBREF()
  !this.wallFeature       = object DBREF()
  !this.wallOpening       = object DBREF()
  !this.opening           = object DBREF()
  !this.name              = ''
  !this.description       = ''
  !this.function          = ''
  !this.purpose           = ''
  !this.position          = object POSITION()
  !this.posref            = object DBREF()
  !this.vDistance         = object REAL()
  !this.zDistance         = object REAL()
  !this.pkDist            = object REAL()
  !this.number            = 0
  !this.area              = 0
  !offset[1]              = 0
  !offset[2]              = 0
  !offset[3]              = 0
  !this.labOff            = !offset
  !this.colSchema         = STRING()
  !this.fireRating        = STRING()
  !this.loop              = object DBREF()
  !this.inset             = 0
  !this.despars           = ARRAY()
  -- This should be set to either TMPL or SFIT
  !this.catalogueType     = ''

  -- Frame of reference the BLevel relates to (i.e. BBLOCK element)
  !this.wrt               = World
  !this.wJusl             = !!accopeningDefinition.wJusl.selection()
  handle ANY
    !this.wJusl             = 'LEFT'
  endhandle
  -- Default modifiable settings
  !this.modifiable        = TRUE
  !this.modifiableText    = STRING()

  -- Set modify mode to false, this should only be set by the .modify method
  !this.modifyMode        = FALSE

  -- Dynamic update (default modifications change DB automatically)
  !this.dynamicUpdate     = FALSE

  !this.wall = !!accopeningDefinition.selectedWall
  handle ANY
    --!!alert.error('Cannot find Selected wall')
  endhandle
  !this.wallFeature = !!accopeningDefinition.wallFeature
  handle ANY
    --!!alert.error('Wall Opening does not exist')
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbeopening
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .dbeopening(!opening is DBREF) is BOOLEAN
   -- !opening is the selected

   -- Load defaults
   !this.dbeopening()

   if !opening.type.neq('DOOR').and(!opening.type.neq('WINDOW')) then
      !!error.text    = 'Element ' & !opening.namn & ' is not a Door or Window'
      return false
   endif

  -- Set db element
  !this.wall             = !opening.owner.owner.owner
  !this.wallFeature      = !opening.owner.owner.owner
  !this.wallOpening      = !opening.owner
  !this.wJusl            = !opening.owner.wJusl
  !this.opening          = !opening
  !this.spref            = !opening.spref
  if !this.spref.set() then
    if !this.spref.catref.unset().and(!this.spref.tmpref.set()) then
      !this.catalogueType  = 'TMPL'
    else
      !this.catalogueType  = 'SFIT'
    endif
  endif
  !this.inset            = !opening.position.north
  handle ANY
  endhandle
  !this.elementType      = !this.opening.type

  !!ce = !!accopeningDefinition.selectedWall

  -- Is element modifiable
  !this.modifiable        = !!dbRefUpdatable(!this.wallOpening)
  if(!this.modifiable.not()) then
    !this.modifiableText  = !!error.text
  endif

  -- Get attributes of the element
  if(!this.opening.isNamed) then
    !this.name        = !this.opening.namn
  endif

  !this.description   = !this.opening.description
  !this.function      = !this.opening.function
  !this.purpose       = !this.opening.purpose
  !this.number        = !this.opening.number
  !this.orientation   = !this.opening.orientation
  !this.despars       = !this.opening.desp
  !this.position      = !this.wallOpening.position
  -- set the positioning values
  !this.posref        = !this.wallOpening.posref
  handle ANY
  endhandle

  !this.vDistance     = !this.wallOpening.vDistance
  !this.zDistance     = !this.wallOpening.zDistance
  !this.pkDist        = !this.wallOpening.pkDist
  !this.wall          = !!accopeningDefinition.selectedWall
  handle ANY
    !!alert.error('Cannot find Selected wall')
  endhandle
  !this.wallFeature = !!accopeningDefinition.wallFeature
  handle ANY
    !!alert.error('Wall Opening does not exist')
  endhandle

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Create a new ROOM object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if created, False if failed error via !!error.text
--
------------------------------------------------------------------------

define method .create() is BOOLEAN

  -- check if SPEC and POSREF are set
  if(!this.spref.unset() or !this.posref.unset() ) then
    !!alert.message(!this.elementType & ' definition is not complete.')
    return false
  endif

  !!ce = !this.wallFeature

  if !this.wallOpening.unset() then
    !!ce = !this.wallFeature
    new WLOPEN
    !this.wallOpening = !!ce
    VertDirection TRUE
  else
    !!ce = !this.wallOpening
  endif

  -- set the wall opening attributes ZDISTANCE POSREF etc
  NEW $!this.elementType
  handle ANY
    return false
  endhandle
  -- to make existing items work so that z points out of the wall
  --ori X is Y and Y is Z
  Orientation Y is -X and Z is Y
  -- Update element data
  !this.opening = !!ce

  !this.modify()
  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify the current wallOpening (ROOM)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if modified, False if failed error via !!error.text
--
------------------------------------------------------------------------

define method .modify() is BOOLEAN

  -- Write out to wallOpening
  !this.modifyMode            = true

  -- save current element for return
  !reference                  = !!ce

  -- go to element
  !!ce                        = !this.opening
  handle ANY
    return false
  endhandle

  -- Element unModifiable
  if(!this.modifiable.not()) then
    !!error.text              = !this.modifiableText
    return false
  endif

  -- Check for Access rights  $**** could this be if (this.modifiable ...
  if(!this.opening.dbWrite.not())then
    !!error.text              = 'Unable to modify element "' & !this.opening.namn & ' is in readonly database.'
    return false
  endif

  -- Set name
  if(!this.name.set()) then
    !name                       = !this.name.trim()
    if(!name.neq('')) then
      !name                     = '/' & !name
      !this.opening.name        = !name
      handle ANY
        -- trying to name a copy
      endhandle
    endif
  endif

  -- Set basic attributes
  if(!this.description.set()) then
    !this.opening.description = !this.description
  endif
  if(!this.function.set()) then
    !this.opening.function    = !this.function
  endif
  if(!this.purpose.set()) then
    !this.opening.purpose      = !this.purpose
  endif
  if(!this.number.set()) then
    !this.opening.number        = !this.number
  endif
  if !this.posref.set() then
   !this.wallOpening.posref = !this.posref
  endif
  if !this.zDistance.set() then
     !this.wallOpening.zDistance = !this.zDistance
  endif
  if !this.vDistance.set() then
     !this.wallOpening.vDistance = !this.vDistance
  endif
  if !this.wJusl.set() then
    !this.wallOpening.wJusl = !this.wJusl
  endif
  if !this.inset.set() then
    !this.applyInset(!this.inset)
  endif
  if !this.despars.set() then
    !this.opening.desp = !this.despars
  endif
  if !this.orientation.set() then
    !this.opening.orientation = !this.orientation
  endif

  -- need to sort out how to deal with templates around here somewhere

  if !this.spref.set()then
    !this.opening.spref = !this.spref
    !this.setSpref(!this.spref)
    if !this.catalogueType.eq('TMPL') then
       !this.deleteTMPL()
       !this.createTMPL()
    else
       !this.deleteTMPL()
    endif
    --Get the catalogue cutout
    !this.getNegativeVolume(!this.opening.spref)
  endif

  -- build the cutout
  !this.applyNegativeVolume()

  -- Set modify mode to false
  !this.modifyMode              = false

  -- return to original element
  !!ce   = !reference
  handle ANY
    -- in case its been deleted in the mean time
  endhandle
  -- Return
  return true

 endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createTMPL
--
-- Description: copy a template into the opening
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .createTMPL()

if !this.opening.set() then
   !!ce = !this.opening
   !comProp = object COMPROP()
   !comProp.initialise(!this.opening.spref)
   !comProp.setProperties(!this.opening)
   !comProp.unsetDesiElement()
   !this.template = !!ce
endif

endmethod
------------------------------------------------------------------------
--
-- Method:      deleteTMPL
--
-- Description: If we are using a template element below the door or window
--              we can only modify the template by deleting the old one and
--              building a new one
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .deleteTMPL()

if !this.opening.set() then
  if !this.opening.mcount('TMPL').gt(0) then
    !!ce = TMPL1 of $!this.opening
    unlock all
    delete TMPL
  endif
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      setSpref
--
-- Description: If we are using a template element below the door or window
--              We need to set the catalogue type to reflect this
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .setSpref(!spref is DBREF )

 !this.spref = !spref
 if !this.spref.catref.unset().and(!this.spref.tmpref.set()) then
    !this.catalogueType  = 'TMPL'
 else
    !this.catalogueType  = 'SFIT'
 endif

endmethod
------------------------------------------------------------------------
--
-- Method:      ApplyInset
--
-- Description: set the inset of a door or wall using the ISET property from the catalogue
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .applyInset(!val is REAL)

!pos = !this.opening.position.wrt(!this.opening.owner)
!pos.north = !val
!this.opening.position = !pos

endmethod
------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  AID CLEAR ALL $!<this.aidNumber>
  AID CLEAR ALL $!<this.aidAxes>

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      aidNumbers
--
-- Description: Set aid numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .aidNumbers(!aidNumber is REAL, !aidAxes is REAL)

  -- Set Aid number

  !this.aidNumber       = !aidNumber
  !this.aidAxes         = !aidAxes

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Draw method and aid number setting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .draw(!aidNumberOuter is REAL, !aidNumberInner is REAL)

  -- Set Aid number
  !this.aidNumberOuter = !aidNumberOuter
  !this.aidNumberInner = !aidNumberInner

  -- Draw outline using standard functionality
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Standard draw mechanism for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .draw(!xoffset is REAL, !yoffset is REAL)
	
  !reference = !!ce

  -- Remove current graphics
  --!this.tidy()

  --if !!accFittingsDefinition.workingelement.type.eq('CTWALL') then

    -- Tag origin
    if(!this.name.unset()) then
      !name = 'Opening'
    elseif(!this.name.eq('')) then
      !name = 'Opening'
    else
      !name = !this.name
    endif

   --if !this.wallOpening.unset() then
     --!!accopeningDefinition.calculateNewPosition()
     --!this.draw(!this.doorPosition, !this.originPosition)
   --else
     --!this.wallOpening.vDistance = !!accopeningDefinition.vDistance.val
    -- handle ANY
       -- this.definition has not been set yet
      -- return
     --endhandle
     --!this.enhance('GREEN',TRUE )
    --!this.wallOpening.zDistance = !!accopeningDefinition.zDistance.val
  -- endif

    --!xoffset = !this.xyOffset[1]
    --!xoff = !xoffset.nint()
    --!yoffset = !this.xyOffset[2]
    --!yoff = !yoffset.nint()

    --q var !this.wallOpening.vDistance
    --!xoffset = !this.wallOpening.vDistance
    --!xoffset = !!accopeningDefinition.zDistance.val
    !xoff = !xoffset.nint()
    --!yoffset = !this.wallOpening.zDistance
    --!yoffset = !!accopeningDefinition.vDistance.val
    !yoff = !yoffset.nint()

    !posref = !this.posref
    handle ANY
    endhandle

    if undefined(!posref) or !posref.unset() then
      return
    endif

    -- check to see if we have a hole
    if !posref.type.eq('WLOPEN') then
      !posref = !posref.posref
    endif

    !!ce = !posref
    next
    handle any
       first
    endhandle

    !nextposref = !!ce

    -- construct pointvector from the posref pointing towards the next posref
    var !dir dir from $!posref to $!nextposref wrt /*
    handle any
      -- no gap between this point and the next
      return
    endhandle

    !pv1 = object POINTVECTOR(!posref.position, !dir.direction())
    !pv2 = !pv1.offset(!xoffset)
    !pvaid = !pv1.offset(!xoffset * 0.5)
    --!aidpos1 = !pvaid.position
    !pos1 = !pv2.position

    !pv2.direction = up wrt /*

    !pvaid2 = !pv2.offset(!yoffset * 0.5)
    --!aidpos2 = !pvaid2.position
    !pv2 = !pv2.offset(!yoffset)
    !pos2 = !pv2.position

    !xoffval = !xoffset
    !yoffval = !yoffset

    -- get the orientation of the fitting
    !ref = !!ce
    !!ce = !this.posref
    handle ANY
      return
    endhandle

    -- check to see if we have a hole
    if !!ce.type.eq('WLOPEN') then
      !!ce = !!ce.posref
    endif

    !point1 = !!ce
    next
    handle any
       -- handle closed walls
       first
    endhandle
    !point2 = !!ce
  --  !this.fittingori = !this.getWallZdir(!point1, !point2)
  !this.openingOri = !this.getWallZdir(!point1, !point2)

    !!ce = !ref

   -- !z = !this.fittingori[3]
   -- handle ANY
   --   return
  --  elsehandle NONE
  --    !x = !this.fittingori[1]
  --    !y = !this.fittingori[2]
  --  endhandle

        !z = !this.openingOri[3]
    handle ANY
      return
    elsehandle NONE
      !x = !this.openingOri[1]
      !y = !this.openingOri[2]
    endhandle

    if !this.wJusl.eq('LEFT') then
      --flip the zdir if the justification is on the opposite wall face
      !x = !x.opposite()
      !y = !y
      !z = !z.opposite()
    endif

    !pvaid.direction = !z

    !pvaid2.direction = !z

    !aidpos3 = !pvaid.offset(500).position

    !aidpos4 = !pvaid2.offset(500).position

    !pv1.direction = !z

    !aidpos5 = !pv1.offset(300).position

    !pv2.direction = !z

    !aidpos6 = !pv2.offset(300).position


!aidNumber = !this.aidNumber

    --AID TEXT NUMBER $!<this.aidtext> '$!name' AT $!pos2
    AID CYLINDER NUMBER $!aidNumber at $!aidpos4 diameter 10 height $!yoffval filled on

    AID CYLINDER NUMBER $!aidNumber at $!aidpos3 diameter 10 ori z is $!dir height $!xoffval filled on
    AID CYLINDER NUMBER $!aidNumber at $!aidpos5 diameter 10 ori z is $!z height 600 filled on
    AID CYLINDER NUMBER $!aidNumber at $!aidpos6 diameter 10 ori z is $!z height 600 filled on
    AID CYLINDER NUMBER $!aidNumber at $!aidpos6 diameter 10 ori z is $!z height 100 filled on
    AID SPHERE NUMBER $!aidNumber $!pos1 diameter 10
    AID TEXT NUMBER $!aidNumber '$!xoff' AT $!aidpos3
    AID TEXT NUMBER $!aidNumber '$!yoff' AT $!aidpos4

$(

    !volume = object LOCALVOLUME(!this.dbelement, !this.dbelement)
    handle ANY
    elsehandle NONE
      !box = object GPHBOX(!volume.box())
      !box.box.orientation = !this.orientation
      !box.draw(!this.aidbox)
      handle ANY
      endhandle


      !ydir = !this.orientation.ydir()
      --!currentxdir = !this.dbelement.orientation.xdir()
      --!newxdir = !box.box.orientation.xdir()
      AID ARROW NUMBER $!<this.aidlines> at $!pv2.position DIR $!y height 1000

      !angle = !!accFittingsDefinition.angle.val
      if !angle.real().lt(0) then
        !sense = FALSE
      else
        !sense = TRUE
      endif
      !oriString = 'y is ' & !y.string().before('WRT') & ' and z is ' & !z.string().before('WRT')
      handle ANY
      endhandle
      !arc            = object ARC(!pv2.position, !oriString.orientation(), 90, 90 + $!angle, 750mm, !sense)
      handle ANY
      endhandle
      !anglePoint     = !arc.anglePosition(0 + $!angle * 0.5)
      handle ANY
      elsehandle NONE
        AID TEXT NUMBER $!<this.aidtext> '$!angle' AT $!anglePoint
        !direction      = !arc.angleDirection(!arc.endAngle)
        AID ARROW NUMBER $!<this.aidlines> at $!pv2.position DIR $!direction height 1000
        !arc.draw(!this.aidlines, 1, 4)
      endhandle

    endhandle
$)
    !strOrientation   = 'Z is ' + !this.openingOri[3].string() + ' and Y is ' + !this.openingOri[2].string()
    !axesOrientation  = object ORIENTATION(!strOrientation)
    !axes             = object GPHAXES(!pos2, !axesOrientation)
    !axes.description = ' ' & !pos2
    !axes.tag         = false
    !axes.detail      = false
    !axes.visibleZ    = false
    !axes.draw(!this.aidAxes)

  !!ce = !reference

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getWallZdir
--
-- Description: get the z direction (and x y for completeness) of a wall segment so that we can adequately orientate a mounted fitting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       !point 1 is a POINTR loop element underneath an RPATH which corresponds to the first point that a fitting is positioned between
--    2    R     DBREF       !point 2 is a POINTR loop element underneath an RPATH which corresponds to the second point that a fitting is positioned between
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getWallZdir(!point1 is DBREF, !point2 is DBREF) is ARRAY
  !dirarray = object ARRAY()
  -- get the z orientation of the owning CTWALL

  !wall = !!accopeningDefinition.wallFeature.own

  if !wall.type.neq('CTWALL') then
    return
  endif

  !ydir = !wall.orientation.zdir().wrt( /* )

  -- get the direction from !point1 to !point2
  !xdir = !point1.position.direction(!point2.position)
  handle any
    !xdir = !wall.orientation.xdir().wrt( /* )
  endhandle

  -- cross x and y directions to get the required z direction from the wall segment
  !zdir = !xdir.cross(!ydir)

  !dirarray.append(!xdir)
  !dirarray.append(!ydir)
  !dirarray.append(!zdir)

  return !dirarray

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Standard draw mechanism for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .draw()

 return

 -- Display Axes
  if !this.position.unset() then
     return
  endif

  !axes             = object GPHAXES(!this.position, !this.wall.orientation)
  !axes.description = ' ' & !this.position
  !axes.tag         = true
  !axes.detail      = FALSE
  !axes.draw(!this.aidAxes)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getNegativeVolume
--
-- Description: look at the spref of the door and see if we can derive a negative
-- the position gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .getNegativeVolume(!spref is DBREF )

if !this.catalogueType.eq('TMPL') then
  !loopList = !this.collect(|PORI|, !this.template ,|PURP of OWNER eq 'OPGE' and not badref(tarf)|)
  !loopList.appendarray(!this.collect(|PORI|, !this.template ,|PURP of OWNER eq 'HOLE' and not badref(tarf)|))
  if !loopList.set() then
    !loopList.unique()
    !this.loop = !loopList[1].tarf.members[1]
    handle ANY
      !this.loop = object DBREF()
    endhandle
  else
    !this.loop = object DBREF()
  endif
else
   !ngmre = !spref.catref.ngmre
   handle ANY
        !this.loop = object DBREF()
        return
   endhandle
   !loopList = !this.collect(|SLOOP|,!ngmre,|PURP eq 'OPGE'|)
   if !loopList.set() then
     !this.loop = !loopList[1]
   else
     !this.loop = object DBREF()
   endif
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      ApplyNegativeVolume
--
-- Description: build a cutout in the wall using the negative
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .applyNegativeVolume()

if !this.loop.set() then
   var !rPaths coll all rPath for $!this.wallOpening
   handle ANY
   endhandle
   if !rPaths.size().gt(0) then
      !this.rPath = !rPaths[1].dbref()
   else
      !!ce = !this.wallOpening
      new rPath
      !this.rPath = !!ce
   endif

   if !this.catalogueType.eq('TMPL') then
     !profile = object PROFILE(!this.loop)
     handle ANY
        !!alert.error('Unable to construct negative volume for this item')
        return
     endhandle
     -- special case for building template based path
     !this.buildTemplatePath(!profile)
   else
    !profile = object PROFILE(!this.loop,!this.opening)
    handle ANY
      !!alert.error('Unable to construct negative volume for this item')
      return
    endhandle
     !this.buildFittingPath(!profile)
   endif
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      buildFittingPath
--
-- Description: build a cutout in the wall using the negative of a catalogue item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .buildFittingPath(!profileObject is PROFILE)

   !profileObject.dbWrite(!this.rPath)

endmethod

------------------------------------------------------------------------
--
-- Method:      buildTemplatePath
--
-- Description: build a cutout in the wall using the negative of a template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .buildTemplatePath(!profileObject is PROFILE)

  !this.buildFittingPath(!profileObject)

endmethod

------------------------------------------------------------------------
--
-- Method:      DrawNegativeVolume
--
-- Description: build a cutout in the wall using the negative
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .drawNegativeVolume()

if !this.loop.set() then
   var !rPaths coll all rPath for $!this.wallOpening
   handle ANY
   endhandle
   if !rPaths.size().gt(0) then
      !this.rPath = !rPaths[1].dbref()
   else
      !!ce = !this.wallOpening
      new rPath
      !this.rPath = !!ce
   endif
   !profile = object PROFILE(!this.loop,!this.opening)
   !profile.dbWrite(!this.rPath)
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      collect
--
-- Description: general method for collecting
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- !type = type of element to look for
-- !scanElement = where to look
--
-- Return:
--   [Data Type] [Description]
--  array of DBREF
--
------------------------------------------------------------------------
define method .collect(!type is STRING, !scanElement is DBREF, !expression is STRING)is ARRAY

    !collection     = object COLLECTION()
    !collection.addType(!type)
    !collection.scope(!scanElement)
    handle ANY
     -- in case its not set
       return ARRAY()
    endhandle
    if !expression.set() then
      !collection.filter(object EXPRESSION(!expression))
    endif
    return  !collection.results()

endmethod
-- end of code
