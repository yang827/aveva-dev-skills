------------------------------------------------------------------------
--
-- Method:      xyOffset
--
-- Description: Set xyOffset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .xyOffset(!xOffset is REAL, !yOffset is REAL)
  !offset[1]  = !xOffset
  !offset[2]  = !yOffset
  !this.position(!offset, !this.flrHeight)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xyOffset
--
-- Description: Set XY offset of open space from passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .xyOffset(!position is POSITION)

  -- Map position on to
  !xyPosition   = !this.referencePlane.xyOffset(!position)

  -- Update position
  !this.position(!xyPosition)

endmethod
-- End of method

------------------------------------------------------------------------
