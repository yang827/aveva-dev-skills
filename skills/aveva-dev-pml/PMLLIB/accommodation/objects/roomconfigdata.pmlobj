---
-- Description:
--  Configuration object for room data.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  loadRoomTypes()                  -                   Load room type file into the object
--  roomConfigData()                 -                   Constructor
--
------------------------------------------------------------------------

define object ROOMCONFIGDATA

  -- Main Reference File for Rooms
  member .roomTypeFile    is FILE

  -- Selection Table (3D Array)
  member .selectionTree   is PMLTREENODE

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      roomConfigData
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .roomConfigData()

  -- Initialise Variables
  -- Data File, could be CSV or Excel, the latter will allow easier
  -- modification instead of trying to write something in PML.
  !this.roomTypeFile  = object FILE('%PDMSUSER%\roomtypes.xls')

  -- Load Room Type File
  !this.loadRoomTypes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadRoomTypes
--
-- Description: Load room type file into the object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadRoomTypes()

  -- Initialise Variables
  !this.selectionTree = object PMLTREENODE('RoomData','TOP','Room Type Data')
  !filename           = !this.roomTypeFile.fullname()

  -- use the grid control (silently) to read the data source
  using namespace  'Aveva.Pdms.Presentation'
  !dbCtrl     = object NETGRIDCONTROL()
  !nds        = object NETDATASOURCE('spreadsheet', !filename)
  !dbCtrl.bindToDataSource(!nds)

  -- The grid control treats the first row as a heading row
  -- The rawTable does not included the first (heading) row
  !rows       = !dbCtrl.getRows()
  !headings   = !dbCtrl.getColumns()

  -- Process the data into a searchable grid of data.
  -- This should be generic, but because of time and the grid
  -- control not being what it should be I'm doing here in
  -- the object.
  -- From a tabular structure we need to convert into a selection
  -- tree mechanism:
  --     Level 1      Level 2     Level 3
  -- [1] Opt  1   [1] Opt 1   [1] Opt 1
  --                          [2] Op1 2
  --              [2] Opt 2   [1] Opt 1
  --              [3] Opt 3   [1] Opt 1
  -- [2] Opt  2   [1] Opt 1   [1] Opt 1
  --  ...

  do !row indices !rows
    !newNode  = object PMLTREENODE(!headings[1], !rows[!row][1])
    !added    = !this.selectionTree.add(!newNode)
  enddo

endmethod
-- End of method
