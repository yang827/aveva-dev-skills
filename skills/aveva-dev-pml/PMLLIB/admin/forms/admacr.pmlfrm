--
-- Author:          I.Clark
-- Created:         Tue Dec 15 15:01:49 GMT 1998
--
--
-- Description:
-- This form allow the construction of ACRS from scopes and Roles
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  acrGet()                         ADMACR              A method to return the current ACR
--  acrSet(ADMACR)                   -                   A method to set the current ACR
--  cbApply()                        -                   Callback method for apply button!
--  cbLists(GADGET,STRING)           -                   Function to update Chosen Element in the text gadget
--  cbMode()                         -                   Callback to the mode gadget in the ACR Definition form.
--  cbName(GADGET)                   -                   Method to act as a callback to the Name gadget
--  dbRefSelect(DBREF,ARRAY,GADGET,STRING) -
--  display(STRING)                  -                   Method to Display the ACR definition form
--  init()                           -                   A method to initialise this form!
--  modeGet()                        STRING              Function to return the current mode of the ACR Definition form.
--  modeSet(STRING)                  -                   Method to set the mode of the ACR Definition form.
--  update()                         -                   method to update the displayed ACR in the ACR Definition
--
------------------------------------------------------------------------

setup form !!admAcr resize

  !this.formTitle     = 'ACR Definition'
  !this.iconTitle     = 'ACR'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.12 $ '

  -- Body of form definition
  text   .name at x 3 y 0.2   anchor top+left+right       |Name        | call |!this.cbName(!this.name)|  width 30 scroll 49 NAME
  option .mode at xmax+2 ymin  anchor top+right call |!this.cbMode()| width 10
  text   .desc at xmin.name ymax+0.2  anchor top+left+right |Description | width 30 scroll 120 STRING
  list   .roles at xmin ymax+0.2 |Roles| anchor all call |!this.cbLists(!this.roles,!this.chosenRole)| columns width 25 height 15
  list   .scopes at xmax+1 ymin |Scopes|  anchor top+bottom+right call |!this.cbLists(!this.scopes, !this.chosenScope)| columns width 25 height 15

  button .apply   at x 0 ymax+0.5 |Apply|  anchor bottom+left call |!!admAcr.cbApply()| APPLY
  button .reset   at xcen form-0.5 * size ymin  anchor bottom |Reset| RESET
  button .dismiss at xmax form-size ymin     anchor bottom+right   |Dismiss| CANCEL

  -- Members
  -- Used to store Scopes displayed in List
  member .scopeList   is ARRAY
  -- Used to Store Role Displayed in List
  member .roleList    is ARRAY
  -- Used to Store AdmAcr
  member .admAcr      is ADMACR
  -- current chosen role
  member .chosenRole  is STRING
  -- current chosen scope
  member .chosenScope is STRING

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  --- Assign Mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !!admAcr.mode.dText  = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !!admAcr.mode.rText  = !rText
  !rText.clear()

--   !this.chosenRole.setEditable(FALSE)
--   !this.chosenScope.setEditable(FALSE)

exit
-- End of form definition for !!admAcr
------------------------------------------------------------------------
--
-- Method: .acrGet()
--
-- Description: A method to return the current ACR
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--  DBREF       The current ACR funnily enough!
------------------------------------------------------------------------
define method .acrGet() is ADMACR
  return !this.admAcr
endmethod
-- End of method definition for .acrGet() ADMACR
------------------------------------------------------------------------
--
-- Method: .acrSet()
--
-- Description: A method to set the current ACR
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R            DBREF       The role the current form is to be set to!
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .acrSet(!object is ADMACR)
  !this.admAcr = !object
endmethod
-- End of method definition for .acrSet(ADMACR)
------------------------------------------------------------------------
--
-- Method:  .init()
--
-- Description: A method to initialise this form!
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
--  !this.desc.active = FALSE
    -- Initialise variables
  !mode    = !this.modeGet()
  if(!mode EQ |MODIFY|)then
    !objectTemp   = !!adminElem.acrGet()
    if( !objectTemp.type eq 'ACRST' ) then
      -- leave this form if current selected ACR is an ACR group
      return
    endif
    !object  = object ADMACR()
    !object.acr2AdmAcr(!objectTemp)
  else
    !object  = object ADMACR()
  endif
  -- set up lists of roles and scopes
  !scopes    = !!dbrAdminGetWorld(|SCOPE|).mem
  !roles     = !!dbrAdminGetWorld(|ROLE|).mem
  !roleList  = object ADMTEXTLIST()
  !roleList.addRoles(!roles, TRUE, !this.roles)
  !scopeList = object ADMTEXTLIST()
  !scopeList.addScopes(!scopes, TRUE, !this.scopes)
  !this.scopeList    = !scopes
  !this.roleList     = !roles
  -- Check the current mode
  if (!mode eq 'CREATE') then
    -- Set the form title
    !this.formTitle  = 'Create ACR'
    -- Set the form gadgets
    !this.name.val   = |unset|
    !this.desc.val   = |unset|
    !this.cbLists(!this.roles,!this.chosenRole)
    !this.cbLists(!this.scopes, !this.chosenScope)
  elseif (!mode eq 'MODIFY') then
    -- Set the form title
    if(!object.name.set())then
      !this.formTitle = 'Modify ACR: ' + !object.name.substring(2)
    else
      !this.formTitle = 'Modify ACR: '
    endif
    -- Set the form gadgets
    !acrName = !object.name
    if( !acrName.substring(1,1) eq '=' ) then
      !this.name.val = 'unset'
    else
       !this.name.val = !acrName.substring(2)
    endif
    !this.desc.clear()
    !this.desc.val = !object.description
    !this.dbRefSelect(!object.scoRef, !this.scopeList, !this.scopes , !this.chosenScope)
    handle any
        -- ##
      !message = | The Scope no longer exists, probably deleted. This ACR is now no longer valid and may cause problems|
      !!alert.error(!message)
--      !this.chosenScope.val = |unset|
      !this.chosenScope = |unset|
    endhandle
    !this.dbRefSelect(!object.rolRef, !this.roleList, !this.roles, !this.chosenRole)
    handle any
        -- ##
      !message = | The Role no longer exists, probably deleted. This ACR is now no longer valid and may cause problems|
      !!alert.error(!message)
--      !this.chosenRole.val = |unset|
      !this.chosenRole = |unset|
    endhandle
  endif

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method: dbRefSelect()
--
-- Description: A  method to take a dbref and to find it in the array which in
-- is turn displayed in a gadget and to select it in that gadget. Note if not found to
-- report error and quit form!
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      DBREF          Dbref to be looked for!
--   2   R      ARRAY          DBREFs to look in
--   3   R/RW   GADGET         TO make select relevant element
--   4   R/RW   GADGET         Text member to store Dbref in
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
--define method .dbRefSelect(!dbRef is DBREF, !array is ARRAY, !gadget is GADGET ,!text is GADGET)
define method .dbRefSelect(!dbRef is DBREF, !array is ARRAY, !gadget is GADGET ,!text is STRING)
  if(!dbRef.badRef())then
    return error 1 noalert
  endif
  do !i indices !array
    if(!dbRef.name EQ !array[!i].name)then
      !gadget.val = !i
--      !text.val   = !dbRef.name.substring(2)
      !text       = !dbRef.name.substring(2)
      return
    endif
  enddo
endmethod
-- End of method definition for .dbRefSelect(DBREF, ARRAY, GADGET ,GADGET)
------------------------------------------------------------------------
--
-- Method:      .modeGet()
--
-- Description: Function to return the current mode of the ACR Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Mode of form.
--
-----------------------------------------------------------------------
define method .modeGet() is STRING
  -- Return the mode
  return !this.mode.selection('rtext')
endmethod
-- End of method definition for .modeGet() STRING
------------------------------------------------------------------------
--
-- Method:      .modeSet()
--
-- Description: Method to set the mode of the ACR Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       STRING      Mode to set (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modeSet(!mode is STRING)
  -- Store the mode gadget
  !this.mode.select('rtext',!mode.upcase())
  handle any
    -- Dummy handle (should not happen)
  endhandle
endmethod
-- End of method definition for .modeSet(STRING)
------------------------------------------------------------------------
--
-- Method:      .cbMode()
--
-- Description: Callback to the mode gadget in the ACR Definition form.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .cbMode()
  -- Read the mode value
  !mode    = !this.modeGet()
  -- Call the display method to reset the form
    !this.display(!mode)
endmethod
-- End of method definition for .cbMode()
------------------------------------------------------------------------
--
-- Method:      .cbName()
--
-- Description: Method to act as a callback to the Name gadget
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define Method
define method .cbName(!gadget is GADGET)

  call !!admGenNameChk(!gadget, !this.modeGet(), !this.acrGet().dbRef)

endmethod
-- End of method definition for .cbName(GADGET)
------------------------------------------------------------------------
--
-- Method:  .display()
--
-- Description: Method to Display the ACR definition form
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1    R     STRING      Mode to display form in (CREATE/MODIFY)
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display(!mode is STRING)
    -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY') then
    -- Invalid mode
    return error |Invalid mode for form !!admAcr|
  endif
  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then
    --kill !!adminElemQu
    !!adminElemAcr.hide()
    !this.acrSet(object ADMACR())
  elseif (!mode eq 'MODIFY') then
    !object   = !!adminElem.acrGet()
    if (!object.unset()) then
      -- No action required
      return
    elseif (!object eq !this.acrGet().dbRef and !this.shown()) then
      -- No action required
      return
    elseif(!object.type EQ |ACR|)then
      -- Set the new locations
      !temp = object ADMACR()
      !temp.acr2AdmAcr(!object)
      !this.acrSet(!temp)
    elseif(!object.type EQ |ACRST|)then
      !this.hide()
      !!admAcrSt.display(|MODIFY|)
      return
    endif
  endif
  -- Select the mode
  !this.modeSet(!mode.upcase())
  -- Show the form
  if(!this.shown() EQ FALSE)then
    show !!admAcr
  else
    !this.init()
  endif
endmethod
-- End of method definition for .display(STRING)
------------------------------------------------------------------------
--
-- Method: cbLists()
--
-- Description: Function to update Chosen Element in the text gadget
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      GADGET       List from which user picks element
--   2   R/RW   GADGET       Text gadget in which to place Chosen Element
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
--define method .cbLists(!list is GADGET, !text is GADGET)
define method .cbLists(!list is GADGET, !text is STRING)

--  !text.val = !list.rText[!list.val].dbRef().name.substring(2)
  !text = !list.rText[!list.val].dbRef().name.substring(2)
  handle any
     return error 1 'At least one Role and one Scope must be defined to create an ACR'
  endhandle
--  !this.desc.val = !this.chosenRole.val + | + | + !this.chosenScope.val

endmethod
-- End of method definition for .cbLists(GADGET, GADGET)
------------------------------------------------------------------------
--
-- Method:      .update()
--
-- Description: method to update the displayed ACR in the ACR Definition
-- form. The form must be displayed and in MODIFY mode.
--
------------------------------------------------------------------------
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .update()
  -- Return if the form is not shown
  if (undefined (!!admAcr) or not !this.shown()) then
    return
  endif
  -- Initialise variables
  !mode    = !this.modeGet()
  !selAcr  = !!adminElem.acrGet()
  !curAcr  = !this.acrGet().dbRef
  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif
  -- Return if the same reference
  if (!selAcr eq !curAcr) then
    return
  endif
  !object = object ADMACR()
  !object.acr2AdmAcr(!selAcr)
  -- Reinitialise the form
  !this.acrSet(!object)
  !this.init()
endmethod
-- End of method definition for .update()
------------------------------------------------------------------------
--
-- Method: .cbApply()
--
-- Description: Callback method for apply button!
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbApply()
  !temp = object ADMACR()
  !orig = !this.acrGet().dbRef
  -- Get the values from the form
  if(!this.name.val EQ |unset|)then
    -- ##
    !!alert.error(|You have not given this ACR a name|)
    return
  else
    !temp.name = |/| + !this.name.val
  endif
  !temp.description = !this.desc.val
--  if((!this.chosenRole.val NEQ |unset|) AND (!this.chosenScope.val NEQ |unset|))then
  if((!this.chosenRole NEQ |unset|) AND (!this.chosenScope NEQ |unset|))then
--    !rolRef = |/| + !this.chosenRole.val
    !rolRef = |/| + !this.chosenRole
    !temp.rolRef = !rolRef.dbRef()
--    !scoRef = |/| + !this.chosenScope.val
    !scoRef = |/| + !this.chosenScope
    !temp.scoRef = !scoRef.dbRef()
  else
    -- ##
    !!alert.error(|You have not chosen BOTH a Scope and a Role|)
    return
  endif
  !temp.dbRef = !orig
  !mode = !this.modeGet()
  if(!mode EQ |CREATE|)then
    -- Form specific
    !temp.newAcr()
    !this.init()
    !!adminElem.update('ACR')
    return
  elseif(!mode EQ |MODIFY|)then
    !temp.modifyAcr(!orig)
    !!adminElem.update('ACR')
    return
  endif

endmethod
-- End of method definition for .cbApply()
