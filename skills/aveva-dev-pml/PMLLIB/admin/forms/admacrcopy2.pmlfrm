--
--
-- Description:
-- A form to copy an acr to a selection of users!
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cpy()                            -                   copy an acr to a selection of users
--  display(STRING,ADMACR,DBREF)     -                   display acr's
--  init()                           -                   initialise form.
--
------------------------------------------------------------------------
setup form !!admAcrCopy2

  !this.formTitle     = 'ACR copy'
  !this.iconTitle     = 'ACR CPY'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition

  list .users at x 3 y 0.2 MULTIPLE columns width 40 height 20
  text .acr at xmin ymax+0.2 |Acr to be Copied| width 20 scroll 50 STRING
  button .cpy at xmin ymax+0.2 |Copy Acr to Selected Users| call |!this.cpy()|
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  -- ADMACR
  member .acrInquest is ADMACR

exit
-- End of form definition for !!admAcrCopy2

------------------------------------------------------------------------
--
-- Method: .init()
--
-- Description: initialise form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()
  !temp = !!dbrAdminGetWorld(|USER|).mem
  -- Must take out currently selected user
  !!adminUserTxtList(!temp, !this.users, !!admDisplayConfig.fmtUserGet(), !!admDisplayConfig.eleTypeGet())
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method: .display()
--
-- Description: display acr's
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display(!acrString is STRING, !admAcr is ADMACR, !dummyUser is DBREF)
--  !tempList = !this.users.rText
--  !tempList2 = !this.users.dText
--  !name = !dummyUser.dbRef().dbRef.string()
--  !num = !tempList.findFirst(!name)
--  !tempList.remove(!num)
--  !tempList2.remove(!num)
--  !this.users.clear()
--  !this.users.dText = !tempList2
--  !this.users.rText = !tempList
  !this.acr.active = FALSE
  !this.acr.val = !acrString
  !this.acrInquest = !admAcr
    -- Show the form
  !this.init()
  if(!this.shown() EQ FALSE)then
    show !!admAcrCopy2
  endif
endmethod
-- End of method definition for .display(STRING, ADMACR, DBREF)

------------------------------------------------------------------------
--
-- Method: .cpy()
--
-- Description: copy an acr to a selection of users
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cpy()
  do !i values !this.users.selection(|RTEXT|)
    !tempUser = !i.dbRef()
    !tempAdmAcr = !this.acrInquest
    !tempAdmAcr.name = |/| + !tempUser.name + !tempAdmAcr.name
    !tempAdmAcr.newAcr(!tempUser)
    handle any
      !!alert.error(!!error.text)
      !!alert.error(|Copy failed for | + !tempUser.name)
    endhandle
  enddo
endmethod
-- End of method definition for .cpy()
