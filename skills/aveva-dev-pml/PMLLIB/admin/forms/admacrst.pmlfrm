--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:
-- Created:
--
--
--
-- Description:
-- Form definition to create/modify ACR Groups elements.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  acrGet()                         ARRAY               Method to return the stored array of project ACRSTs.
--  acrList()                        -                   Method to update the contents of the project teams list gadget on
--  acrSet()                         -                   Method to set the form attribute to store an array of project Acrs
--  cbApply()                        -                   Method to create or modify a USER element. The values for the
--  cbName(GADGET)                   -                   Method to act as a callback to the Name gadget
--  display(STRING)                  -                   Function to display the ACRST Definition form.
--  init()                           -                   Method to initialise the USER Definition form.
--  membAdd()                        -                   Method to add the selected project Acrs to the Acr Group membership store.
--  membGet()                        ARRAY               Method to return the stored array of ACR members for the ACR group in
--  membList()                       -                   Method to update the contents of the user membership list gadget
--  membRem()                        -                   Method to remove the selected teams from the user membership store.
--  membSet()                        -                   Method to set the form attribute containing the array of acrs to
--  mode()                           -                   Callback to the mode gadget in the ACRST Definition form.
--  modeGet()                        STRING              Method to return the current mode of the ACRST definition form.
--  modeSet(STRING)                  -                   Method to set the mode of the !this. form.
--  moveElements(REAL)               -                   move a continuous block elements up or down!
--  refGet()                         DBREF               Method to return the current ACRST DBREF for the element being
--  refSet(DBREF)                    -                   Method to set the current DBREF of the  USER that is being
--  refresh()                        -                   Method to refresh the TEAM elements listed in the gadgets on the
--  update()                         -                   Method to update the displayed ACRST in the ACRST Definition form.
--  validSelection()                 BOOLEAN             This function will check to see if the user has selected
--
------------------------------------------------------------------------

-- Define form
setup form !!admAcrSt at xr 0.35 yr 0.1 resize

  !this.formTitle     = 'ACR Group Definition'
  !this.iconTitle     = 'ACRST'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.13 $ '

  -- Body of form definition

  -- User information
  text   .name at x 2 y 0.2           |Name        | anchor top+left+right call |!this.cbName(!this.name)| width 30 scroll 49 NAME
  text   .desc at xmin.name ymax+0.2  |Description | anchor top+left+right width 52 scroll 120 STRING

  -- ACRST membership
  frame .memberFrame at x 0 ymax+0.5 anchor all |ACR Membership|

    list .nonMemAcrs at xmin+1 ymin+1 anchor all |Project ACRs| multiple columns width 30 height 15

    button .add  at xmax+0.2 ymin+4 anchor bottom+top+right call |!this.membAdd()| pixmap width 16 height 16
    button .rem  at xmin ymax       anchor bottom+top+right call |!this.membRem()| pixmap width 16 height 16

    list .memAcrs at xmax ymin.nonMemAcrs anchor top+bottom+right |member ACRs| multiple columns width 30 height 15
    button .up   at xmax.memAcrs+0.2 ymin.add anchor bottom+top+right call |!this.moveElements(-1)| pixmap width 16 height 16
    button .down at xmin             ymax     anchor bottom+top+right call |!this.moveElements(+1)| pixmap width 16 height 16

    option .sort at xmin.nonMemAcrs ymax.nonMemAcrs+0.2 anchor bottom+left |Sort | call |!this.acrList()| width 12
    text   .filter at xmax+5.5 ymin   anchor bottom+right+left  |Filter | call |!this.acrList()| width 31 STRING
  exit

  option .mode at xmax form-size ymin.name anchor bottom+top+right call |!this.mode()| width 10
  button .apply at xmin.memberFrame ymax.memberFrame+0.5 anchor bottom+left |Apply| call |!this.cbApply()| APPLY
  button .reset at xcen form-0.5 * size ymin anchor bottom |Reset| call |!this.init()|
  button .dismiss at xmax form-size ymin anchor bottom+right |Dismiss| CANCEL

  -- Member definitions
    -- User Dbref
    member .dbRef      is DBREF
    -- Array of project Acrs
    member .nonMemAcrArray  is ARRAY
    -- Teams to which user belongs
    member .membership is ARRAY
    -- Members to store sort and filter values
    member .filterVal is STRING
    member .sortVal   is STRING

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  -- set icons
  !this.add.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !this.rem.addPixmap(!!pml.getPathName('leftarrow16.png'))
  !this.up.addPixmap(!!pml.getPathName('uparrow16.png'))
  !this.down.addPixmap(!!pml.getPathName('downarrow16.png'))

  -- Assign mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !this.mode.dText = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !this.mode.rText = !rText
  !rText.clear()

  -- Assign sort gadget values
  !!admAcrSortGadg(!this.sort)

  -- Assign Filter Gadget
  !this.filter.val = |*|

exit
-- End of form definition for !!admAcrSt

------------------------------------------------------------------------
--
-- Method: .cbApply()
--
-- Description: Method to create or modify a USER element. The values for the
-- element are taken from the USER Definition form.
-- Method to be replaced by method .cbApply()
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbApply()

  -- Initialise variables
  !dbRef             = !this.refGet()
  !mode              = !this.modeGet()
  !updateFlag        = false
  !prev              = !!ce

  -- Check that the name gadget is set
  if (!this.name.val eq 'unset') then

    -- Reset gadget in modify mode
    if (!mode eq 'MODIFY') then
      !acrName = !dbRef.name
      if( !acrName.substring(1,1) eq '=' ) then
        !this.name.val = 'unset'
      else
        !this.name.val = !acrName.substring(2)
      endif
    endif

    -- Raise error
    !this.name.setFocus()
    -- ##
    -- !!messageFile.error(141, 101,  !mode.lowcase())
    !!alert.error(|You have not specified a name!|)

    return

  endif

  -- Action attribute depending on mode
  if (!mode eq 'CREATE') then

    -- User attributes
    !name          = |/| + !this.name.val
    !description   = !this.desc.val

    -- Navigate to the user world
    !!ce               = !!dbrAdminGetWorld('ACR')

    -- Create the ACR element *** OLD PML SYNTAX ****
    call !!admCommand(|NEW ACRST $!name|)
    handle (41,12)

      -- User already exists
      call !!admCommand(|DELETE ACRST|)
      -- ##
      -- !!messageFile.error(141, 103,  _name.val)
      !!alert.error(|This Acr Group already exists!|)
      !this.name.val          = |unset|
      return

    endhandle

    -- Set the description
    if (!description neq 'unset') then
      call !!admCommand('DESCR |$!description|')
    endif

    -- Set the update flag
    !updateFlag        = true
    !dbRef             = !!ce
    !!adminElem.acrSet(!!ce)

    call !!admCommand(|SET ACRSET $!name|)

    -- Deal with acr membership
    do !i values !this.membership
      !tempName = !i.name
      call !!admCommand(|ACRADD $!tempName|)
    enddo

  elseif (!mode eq 'MODIFY') then

    -- User attributes
    !name          = |/| + _name.val
    !description   = !this.desc.val

    -- Navigate to the user element
    !!ce               = !dbRef
--    call !!admCommand(|SET ACRSET $!name |)

    -- Check for element being already claimed

    if (not !!dbRefUpdate (!dbRef)) then
      !!alert.error (!!error.text)
      return
    endif

    -- Change the name
    if (!dbRef.name neq !name) then

      -- Modify the name   *** OLD PML SYNTAX ***
      call !!admCommand(|NAME $!name|)
      handle (41,12)

        -- Acr Already exists
        -- !!messageFile.error(141, 103,  _name.val)
        !!alert.error(|This Acr Group already exists!|)

        !this.name.val = !dbRef.name.substring(2)

      endhandle

      -- Set the update flag
      !updateFlag     = true
      !this.formTitle = |Modify User: |+ !dbRef.name.substring(2)

    endif

    -- Change the description
    if (!dbRef.description neq !description) then

      -- Modify the description  *** OLD PML SYNTAX ***
      call !!admCommand('DESC |$!description|')
      !updateFlag       = true

    endif

    -- Add and Delete ACRs

    !original  = !dbRef.acrGroup

    !onesToAdd = !this.membership.difference(!original)
    !onesToRem = !original.difference(!this.membership)

    do !i values !onesToRem
      !updateFlag       = true
      !tempName = !i.fullName
      call !!admCommand(|ACRREM $!tempName|)
      handle any
        skip
      endhandle
    enddo

   set acrs $!!ce.name
    do !j values !onesToAdd
      !updateFlag       = true
      !tempName = !j.fullName
      call !!admCommand(|ACRADD $!tempName|)
      handle any
        skip
      endhandle
    enddo

  endif

  -- Update forms if required
  if (!updateFlag) then
    !!adminElem.update('ACR')
  endif

 -- Reset the form if create mode
  if (!mode eq 'CREATE') then
    !this.init()
  endif

  !!ce = !prev
endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method: .display()
--
-- Description: Function to display the ACRST Definition form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Mode to display form in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display(!mode is STRING)

  -- Check mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY') then

    -- Invalid mode
    return error |Invalid mode for form !!admAcrSt|

  endif

  -- Set the DBREF dependent on mode
  if (!mode.upcase() eq 'CREATE') then
    --kill !!adminElemQu
    !!adminElemAcr.hide()
    !this.refSet(object DBREF())

  elseif (!mode.upcase() eq 'MODIFY') then

    -- Get the DBREF of the current user
    !dbRef  = !!adminElem.acrGet()
    if (!dbRef.unset()) then
      -- No action required (don't show form)
      return
    elseif (!dbRef eq !this.refGet() and !this.shown()) then
      -- No action required
      return
    elseif (!dbRef.badRef()) then
      -- Raise error
      !!messageFile.error(141, 106,  !dbRef.string())
      handle (06, 106)
        !!adminElem.update('ACR')
        return
      endhandle
    elseif(!dbRef.type EQ |ACRST|)then
      -- Set the new reference
      !this.refSet(!dbRef)
    elseif(!dbRef.type EQ |ACR|)then
      !this.hide()
      !!admAcr.display(|MODIFY|)
      return
    endif

  endif

  -- Select the mode
  !this.modeSet(!mode.upcase())

  -- Show or update the form
  if (!this.shown()) then

    -- Re-initialise the form
    !this.init()

  else

    -- Show the form
    show !!admAcrSt free

  endif

endmethod
-- End of method definition for .display(STRING)

------------------------------------------------------------------------
--
-- Method: .init()
--
-- Description: Method to initialise the USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- Initialise variables
  !mode     = !this.modeGet()
  !dbRef    = !this.refGet()

  -- Reinstate sort and filter values
  if (!this.filterVal.set()) then
    !this.filter.val = !this.filterVal
  endif
  if (!this.sortVal.set()) then
    !this.sort.select('rtext',!this.sortVal)
  endif

  -- Set the form gadgets according to mode
  if (!mode eq 'CREATE') then

    !this.formTitle  = |Create ACR Group|
    !this.name.val   = |unset|
    !this.desc.val   = |unset|
    !this.nonMemAcrArray.clear()
    !this.membership.clear()

    !this.membSet()
    !this.acrSet()

    !this.membList()
    !this.acrList()

  elseif (!mode eq 'MODIFY') then

    !acrName = !dbRef.name
    !this.formTitle  = |Modify Acr Group | + !acrName.substring(2)
    if( !acrName.substring(1,1) eq '=' ) then
      !this.name.val = 'unset'
    else
      !this.name.val = !acrName.substring(2)
    endif
    if (!dbRef.description.empty()) then
      !this.desc.val   = |unset|
    else
      !this.desc.val   = !dbRef.description
    endif


    !this.membSet()
    !this.acrSet()

    !this.membList()
    !this.acrList()

  endif

  -- Dismiss the prompt
  !!prompt(0)

  -- Set focus to the name gadget
  !this.name.setFocus()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method: .membAdd()
--
-- Description: Method to add the selected project Acrs to the Acr Group membership store.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .membAdd()

  -- Get the current selection
  !acrSel    = !this.nonMemAcrs.val

  -- Return if no values
  if (!acrSel.size() eq 0) then
    return
  endif

  -- Process the selection list
  do !i values !acrSel

    -- Convert the value
    !dbRef     = !this.nonMemAcrs.rText[!i].dbRef()
    handle any
      -- Bad reference
      skip
    endhandle

    -- Add the value to the membership store
    !this.membership.append(!dbRef)

  enddo

  -- Update the list gadgets
  !this.acrList()
  !this.membList()

endmethod
-- End of method definition for .membAdd()

------------------------------------------------------------------------
--
-- Method: .membGet()
--
-- Description: Method to return the stored array of ACR members for the ACR group in
-- the ACR Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of DBREF of AACR Group
--
------------------------------------------------------------------------

-- Define method
define method .membGet() is ARRAY

  -- Return the value
  return !this.membership

endmethod
-- End of method definition for .membGet() ARRAY

------------------------------------------------------------------------
--
-- Method: .membList()
--
-- Description: Method to update the contents of the user membership list gadget
-- on the USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .membList()

  -- Initialise variables
  !membership    = !this.membGet()

  -- Clear the list
  !this.memAcrs.clear()

  -- Display the membership
  !!admAcrTxtList(!membership, !this.memAcrs, !!admDisplayConfig.fmtAcrGet(), FALSE)

endmethod
-- End of method definition for .membList()

------------------------------------------------------------------------
--
-- Method: .membRem()
--
-- Description: Method to remove the selected teams from the user membership store.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .membRem()

  -- Get the selected teams
  !membSel    = !this.memAcrs.val

  -- Return if no selection
  if (!membSel.size() eq 0) then
    return
  endif

  -- Process the selection list
  do !index values !membSel

    -- Convert value
    !dbRef      = !this.memAcrs.rText[!index].dbRef()
    handle any
      -- Bad reference
      skip
    endhandle

    -- Find the element in the member array
    !pos        = !this.membership.findFirst(!dbRef)
    if (!pos.set()) then
      !this.membership.remove(!pos)
    endif

  enddo

  -- Update the list gadgets
  !this.acrList()
  !this.membList()

endmethod
-- End of method definition for .membRem()

------------------------------------------------------------------------
--
-- Method: .membSet()
--
-- Description: Method to set the form attribute containing the array of acrs to
-- which the ACR Group in the Acr group Definition form is a member.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .membSet()

  -- Initialise variables
  !dbRef           = !this.refGet()

  -- Get the teams for the user
  if (!dbRef.badRef()) then
    -- DBREF is unset
    !membership    = ARRAY()
  else
    -- Get the membership
    !membership    = !dbRef.acrGroup
  endif

  -- Store the array
  !this.membership = !membership

endmethod
-- End of method definition for .membSet()

------------------------------------------------------------------------
--
-- Method: .mode()
--
-- Description: Callback to the mode gadget in the ACRST Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .mode()

  -- Read the mode value
  !mode    = !this.modeGet()

  -- the display method to reset the form
  !this.display(!mode)

endmethod
-- End of method definition for .mode()

------------------------------------------------------------------------
--
-- Method: .modeGet()
--
-- Description: Method to return the current mode of the ACRST definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Mode of form.
--
------------------------------------------------------------------------

-- Define method
define method .modeGet() is STRING

  -- Return the mode
  return !this.mode.selection('rtext')

endmethod
-- End of method definition for .modeGet() STRING

------------------------------------------------------------------------
--
-- Method: .modeSet()
--
-- Description: Method to set the mode of the !this. form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to set (CREATE / MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .modeSet(!mode is STRING)

  -- Set the mode gadget
  !this.mode.select('rtext',!mode.upcase())
  handle any
    -- Dummy handle (should not happen)
  endhandle

endmethod
-- End of method definition for .modeSet(STRING)

------------------------------------------------------------------------
--
-- Method:      .cbName()
--
-- Description: Method to act as a callback to the Name gadget
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define Method
define method .cbName(!gadget is GADGET)

  call !!admGenNameChk(!gadget, !this.modeGet(), !this.refGet())

endmethod
-- End of method definition for .cbName(GADGET)

------------------------------------------------------------------------
--
-- Method: .refGet()
--
-- Description: Method to return the current ACRST DBREF for the element being
-- edited.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of USER being created or modified
--
------------------------------------------------------------------------

-- Define method
define method .refGet() is DBREF

  -- Return the value
  return !this.dbRef
endmethod
-- End of method definition for .refGet() DBREF

------------------------------------------------------------------------
--
-- Method: .refresh()
--
-- Description: Method to refresh the TEAM elements listed in the gadgets on the
-- USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refresh()

  -- Return if the form is not shown
  if (undefined (!!admAcrSt) or not !this.shown()) then
    return
  endif

  -- Display a message
  !!messageFile.prompt(141, 004,  !this.formTitle,  'ACRST')

  -- Set the user information
  !this.acrSet()

  -- Update the project team list
  !this.acrList()
  !this.membList()

  -- Dismiss the prompt
  !!prompt(0)

endmethod
-- End of method definition for .refresh()

------------------------------------------------------------------------
--
-- Method: .refSet()
--
-- Description: Method to set the current DBREF of the  USER that is being
-- created or modified.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of USER (can be unset).
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refSet(!dbRef is DBREF)

  -- Set the DBREF
  !this.dbRef  = !dbRef

endmethod
-- End of method definition for .refSet(DBREF)

------------------------------------------------------------------------
--
-- Method: .acrGet()
--
-- Description: Method to return the stored array of project ACRSTs.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of project users
--
------------------------------------------------------------------------

-- Define method
define method .acrGet() is ARRAY

  -- Return the array
  return !this.nonMemAcrArray

endmethod
-- End of method definition for .acrGet() ARRAY

------------------------------------------------------------------------
--
-- Method: .acrList()
--
-- Description: Method to update the contents of the project teams list gadget on
-- the USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .acrList()

  -- Initialise variables
  !projAcrs        = !this.acrGet()
  !membership      = !this.membGet()

  -- Save the sort and filter values for later user
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.filterVal  = !this.filter.val
  !this.sortVal    = !this.sort.selection('rtext')

  -- Clear the list gadget
  !this.nonMemAcrs.clear()

  -- Determine Acr that are not a member of this ACRST
  if(!membership.size() neq 0)then
    !acrList       = !projAcrs.difference(!membership)
  else
    !acrList       = !projAcrs
  endif
  -- Sort the list of teams
  !displayList     = !!adminFilterSort(!acrList, !this.sort, !this.filter)

  -- Display the list of teams
  !!admAcrTxtList(!displayList, !this.nonMemAcrs, !!admDisplayConfig.fmtAcrGet(), FALSE)

endmethod
-- End of method definition for .acrList()

------------------------------------------------------------------------
--
-- Method: .acrSet()
--
-- Description: Method to set the form attribute to store an array of project Acrs
-- in the ACRST Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .acrSet()

  -- Initialise variables
  !acrOfTypes          = ARRAY()
  !acrs                = ARRAY()

  !currentPos          = !!ce

  -- Collect the project teams
  !!ce                 = !!dbrAdminGetWorld('ACR')
  !acrOfTypes          = !!ce.mem

  do !i values !acrOfTypes
    skip if(!i.type NEQ |ACR|)
    !acrs.append(!i)
  enddo

  !this.nonMemAcrArray  = !acrs

  -- Return to database position
  !!ce                  = !currentPos

endmethod
-- End of method definition for .acrSet()

------------------------------------------------------------------------
--
-- Method: .update()
--
-- Description: Method to update the displayed ACRST in the ACRST Definition form.
-- The form must be displayed and in MODIFY mode.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update()

  -- Initialise variables
  !mode   = !this.modeGet()
  !selAcr = !!adminElem.acrGet()
  !curAcr = !this.refGet()

  -- Return if the form is not shown
  if (!this.shown().not()) then
    return
  endif

  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif

  -- Return if the same reference
  if (!selAcr eq !curAcr) then
    return
  endif

  -- Reinitialise the form
  !this.refSet(!selAcr)
  !this.init()

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
--Method: moveElements()
--
-- Description: move a continuous block elements up or down!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      REAL         Direction to move elements in up equals -1 down +1
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveElements(!direction is REAL)
  if(!this.validSelection())then
    !selection = !this.memAcrs.val
    if(!selection.size() EQ 0)then
      return
    endif
    !selection.sort()
    -- User has a block start at element 1 and they want to move the block up
    if((!selection.first() eq 1) AND (!direction EQ -1))then
      return
      -- in shame!
    endif
    -- User has a block start at the end and they want to move the block down
    if((!selection.last() eq !this.memAcrs.dText.size()) AND (!direction EQ 1))then
      return
      -- in shame!
    endif
    !tempArray = ARRAY()
    do !i values !selection
      !tempArray.append(!this.membership[!i])
    enddo
    if(!direction EQ 1)then

      !overwritVals = !this.membership.overlay(!selection.first() + 1, !tempArray)
      !this.membership[!selection.first()] = !overwritVals.last()

    elseif(!direction EQ -1)then

      !overwritVals = !this.membership.overlay(!selection.first() - 1, !tempArray)
      !this.membership[!selection.last()] = !overwritVals.first()

    endif

    do !i indices !selection
      !selection[!i] = !selection[!i] + !direction
    enddo

    !this.membList()

    !this.memAcrs.val = !selection

  endif
endmethod
-- End of method definition for .moveElements(REAL)
------------------------------------------------------------------------
--
--Method: .validSelection
--
-- Description: This function will check to see if the user has selected
-- a valid block of elements to reorder! A valid selection is a continuous block
-- of 1 or more elements
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--    BOOLEAN     IF the selection is valid
------------------------------------------------------------------------
define method .validSelection() is BOOLEAN
  if(!this.memAcrs.val.size() EQ 0)then
    return true
    -- go no further with this mockery
  endif

  !selection = !this.memAcrs.val
  -- Not much point going any further as by definition a selection of 1 elements
  -- is continuous block!
  if(!selection.size() GT 1)then
    !selection.sort()
    do !i indices !selection
      skip if(!i EQ 1)
      if( !selection[(!i - 1)] NEQ (!selection[!i] - 1))then
        -- This is not a continuous block, halt and reprimand user!!!!!!!!!!!!!!!!!!!!!!!!!!!!
        -- ##
        !!alert.error(|Please select a continuous block of elements if you wish to reorder elements! i.e. element 3,4,5 etc...|)
        !this.memAcrs.val = object ARRAY()
        return false
      endif
    enddo
  endif
  return true

endmethod
-- End of method definition for .validSelection() BOOLEAN
