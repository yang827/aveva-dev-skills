--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          M.Barlow
-- Created:         Mon Jan 17 16:07:37 "GMT 2000
--
--
-- Description:
-- Display summary report of a list of actions from a DBREFTEXT object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  display(ARRAY)                   -                   Add given array of dbRefText objects to the form
--  elementList()                    -                   Callback action when user selects list item
--
------------------------------------------------------------------------

setup form !!admActionSummary

  !this.formTitle     = 'Summary Report'
  !this.iconTitle     = 'SUMREP'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.2 $ '

  -- Body of form definition

  list .list |Summary| call |!this.elementList()| width 50 length 10

  -- Detail text
  frame .detailFrame |Details| at xmin ymax+0.25

    para .detail width 51 lines 3

  exit

  -- Dismiss
  button .dismiss |Dismiss| at xmax form-size ymax +0.2 cancel

  -- Detail Descriptions (this must be an array of dbRefText elements)
  member .details is ARRAY

exit

------------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Add given array of dbRefText objects to the form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define Method
define method .display( !list is ARRAY )

  -- Initialise Variables
  !dText        = ARRAY()
  !rText        = ARRAY()

  !this.details = !list

  -- Load DBREFTEXT elements into lists
  do !i indices !list
    !briefText[!i] = !list[!i].brief
    !ref           = !list[!i].element
    if( badref(!ref) ) then
      !elements[!i]  = ' '
    elseif( !ref.owner.type.upcase() eq 'WORL' ) then
      !elements[!i]  = 'System Element'
    else
      !elements[!i]  = !list[!i].element.flnn
      -- take away the leading * for elements whose names begin /*
      !elements[!i]  = !elements[!i].replace('*','',1,1)
    endif
  enddo

  -- Max width of Brief description
  !maxWidth    = !briefText.width()

  -- Build list of brief + full element names to show
  do !i indices !elements
    VAR !display COMPOSE space 2 |$!briefText[$!i]| width $!maxWidth C space 2 |-| space 2 |$!elements[$!i]|
    !dText[!i] = !display[1]
    !rText[!i] = !i.string()
  enddo

  -- Load Display
  !this.list.dText = !dText
  !this.list.rText = !rText

  -- Select the first item
  !this.show()
  !this.list.select('RTEXT','1')
  !this.elementList()

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method:      .elementList()
--
-- Description: Callback action when user selects list item
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define Method
define method .elementList( )

  -- Initialise Variables
  !index           = !this.list.selection('RTEXT').real()

  -- Display the detail text
  !this.detail.val = !this.details[!index].detail

endmethod
-- End of method definition for .cbApply()
