--   Module:        admin
--   Replaces:
--
-- Author:          Martin Ward
-- Created:         November 2006
--
--
-- Description:
-- Form definition to create/modify authenticated User .
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addUser()                        -                   Constructor
--  admAuthUSer()                    -
--  applyCall()                      -                   Action
--  checkName()                      -                   Constructor
--  init(BOOLEAN)                    -                   Constructor
--  remUser()                        -                   Constructor
--

-- Define form
setup form !!admAuthUser

  -- Body of form definition

  -- Auth User information
  text .name at x 3 y 0.2 |Name        |  width 30 scroll 31 NAME
  option .mode at xmax+15 ymin width 10


  -- Auth User members
  frame .memberFrame at x 0 ymax+0.5  |Authenticated User Membership|

    list .projUsers at xmin+1 ymin+1 |Project Users| columns multiple width 40 height 15

    button .add at xmax+0.2 ymin+5  pixmap width 16 height 16
    button .rem at xmin ymax   pixmap width 16 height 16

    list .authUsers at xmax ymin.projUsers |Authenticated Users| columns multiple width 40 height 15

    option .sort at xmin.projUsers ymax |Sort |   width 12
    text .filter at xmax+1 ymin | Filter |  width 15 STRING
    option .default at xmax+1 ymin | Default User | width 12

  exit

  button .apply   at xmin ymax+0.5 |Apply|  APPLY
--  button .reset   at xcen form-0.5 * size ymin |Reset|   RESET
  button .dismiss at xmax form-size ymin       |Dismiss| CANCEL

  -- Member definitions
    -- Array of project and authenticated users
    member .projUserDArray is ARRAY
    member .projUserRArray is ARRAY
    member .authUserArray  is ARRAY
    -- Members to store sort and filter values
    member .filterVal is STRING
    member .sortVal   is STRING

    member .opt is STRING

exit

-- End of form definition for !!admAuthUser

----------------------------------------------------------------------
--
-- Method:      .admAuthUser
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .admAuthUSer()

  !this.formTitle     = 'NT Authenticated User Definition'
  !this.iconTitle     = 'NTUSER'
  !this.callback      = '!this.init(true)'
  !this.formRevision  = '  '

  -- callbacks

  !this.name.callback   = |!this.checkName()|
  !this.mode.callback   = |!this.init(false)|
  !this.add.callback    = |!this.addUser()|
  !this.rem.callback    = |!this.remUser()|
  !this.sort.callback   = |!this.init(false)|
  !this.filter.callback = |!this.init(false)|
  !this.apply.callback  = |!this.applyCall()|

-- set icons
  !this.add.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !this.rem.addPixmap(!!pml.getPathName('leftarrow16.png'))

endmethod

----------------------------------------------------------------------
--
-- Method:      .init
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------

define method .init(!firstInit is BOOLEAN)

if (!firstInit) then
  !dtext=ARRAY()
  !rtext=ARRAY()

  -- Assign mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !this.mode.dText = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !this.mode.rText = !rText
  !rText.clear()

  !heading=ARRAY()
  !heading.append('Name')
  !this.authUsers.setHeadings(!heading)
  !heading.append('Description')
  !heading.append('Security')
  !this.projUsers.setHeadings(!heading)
  !this.sort.dtext=!heading

  if (!this.opt eq 'CREATE') then
    !this.formTitle = |NT Authenticated User Creation|
    !this.mode.select('rtext','CREATE')
    !this.name.val = 'unset'

  elseif (!this.opt eq 'MODIFY') then
    !this.formTitle = |NT Authenticated User Modification|
    !this.mode.select('rtext','MODIFY')
    !this.name.val = !!adminelem.element.selection()
  endif
else
  !this.opt = !this.mode.selection()
endif

  -- Check that we have a filter string
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif

   -- Get a list of project users
  !userList = USERS
  -- Get description array of users
  !userName=ARRAY()
  !userDesc=ARRAY()
  !userSecu=ARRAY()
  do !i indices !userList

    -- Set the user name
    !userName[!i] = !userList[!i].name

    -- Set the description
    !userDesc[!i]  = !userList[!i].description
    if (!userDesc[!i].empty()) then

      !userDesc[!i] = |-- No description --|

    endif
    -- Set the security
    !userSecu[!i]  = !userList[!i].access

  enddo

  -- Sort the output
  if (!this.sort.selection() eq |Name|) then
    !sort = !userName.sortedIndices()

  elseif (!this.sort.selection() eq |Description|) then
      !sort = !userDesc.sortedIndices()

  elseif (!this.sort.selection() eq |Security|) then
      !sort = !userSecu.sortedIndices()

  endif

  -- Clear the list gadget
  !this.projUsers.clear()
  !this.AuthUsers.clear()

  -- Build display and replacement texts
  !dispList = ARRAY()
  !replList = ARRAY()

  do !i values !sort

    -- Build strings to filter
    if (!this.sort.selection() eq |Name|) then

      -- Filter on username
      !filterString = !userName[!i]

    elseif (!this.sort.selection() eq |Description|) then

      -- Filter on user description
      !filterString = !userDesc[!i]

    elseif (!this.sort.selection() eq |Security|) then

      -- Filter on user description
      !filterString = !userSecu[!i]

    endif

    -- Discard entries not matching filter
    skip if (not !filterString.matchWild(!this.filter.val))

    -- Compose text
    if (!this.sort.selection() eq |Name|) then
      !heading=ARRAY()
      !heading.append('Name')
      !heading.append('Description')
      !heading.append('Security')
      !this.projUsers.setHeadings(!heading)
      !text=!userName[!i] & |	| & !userDesc[!i] & |	| & !userSecu[!i]

    elseif (!this.sort.selection() eq |Description|) then
      !heading=ARRAY()
      !heading.append('Description')
      !heading.append('Name')
      !heading.append('Security')
      !this.projUsers.setHeadings(!heading)

      !text=!userDesc[!i] & |	| & !userName[!i] & |	| & !userSecu[!i]

    elseif (!this.sort.selection() eq |Security|) then
      !heading=ARRAY()
      !heading.append('Security')
      !heading.append('Name')
      !heading.append('Description')
      !this.projUsers.setHeadings(!heading)

      !text=!userSecu[!i] & |	| & !userName[!i] & |	| & !userDesc[!i]

    endif

    !dispList.append(!text)
    !replList.append(!userName[!i])

  enddo
  -- load the member objects for future reference id add and rem methods
  if (!dispList.set()) then

    !this.projUserDArray = !dispList
    !this.projUserRArray = !replList

  endif


  if (!this.opt eq 'CREATE') then
    !this.formTitle = |NT Authenticated User Creation|
    !this.mode.select('rtext','CREATE')
    -- Assign values if defined
    if (!dispList.set()) then

      !this.projUsers.dText = !dispList
      !this.projUsers.rText = !replList

    endif
    !this.name.val = 'unset'
    !this.default.clear()

  elseif (!this.opt eq 'MODIFY') then
    !this.formTitle = |NT Authenticated User Modification|
    !this.mode.select('rtext','MODIFY')
    !this.name.val = !!adminelem.element.selection()
    -- Build the lists up based on the Authenticated user information
    !authUser = object authUser(!this.name.val)
    !authUserList = !authUser.userList()
    --Create the user list
    !authUserListNames=ARRAY()
    do !i values !authUserList
      !authUserListNames.append(!i.name)
    enddo
    !this.authUsers.dtext=!authUserListNames

    -- Remove any authenticated users from the project users list
    !modDispList=ARRAY()
    !modReplList=ARRAY()
    do !i index !replList
      skip if (!authUserListNames.findFirst(!replList[!i]).set())
      !modDispList.append(!dispList[!i])
      !modReplList.append(!replList[!i])
    enddo
    if (!modDispList.set()) then

      !this.projUsers.dText = !modDispList
      !this.projUsers.rText = !modReplList

    endif

    -- Add the users to the default list and set it to the default user if it's set
    -- otherwise set it to the first in the list
    !this.default.dtext=!authUserListNames
    !defaultUser=!authUser.defaultUser()
    handle none
       !this.default.select('dtext',!defaultUser.name)
       handle any
          -- It is possible for default user to be missing from list (see P-33746)
          -- In this case use the first listed user it list is not empty
          if (!authUserListNames.size() gt 0) then
            !this.default.select('dtext',!authUserListNames[1])
          endif
       endhandle
    elsehandle any
    endhandle
  endif
endmethod

----------------------------------------------------------------------
--
-- Method:      .addUser
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------

define method .addUser()

!projUserDArray=!this.projUsers.dtext
!projUserRArray=!this.projUsers.rtext
!this.authUserArray=!this.authUsers.dtext
!selection = !this.projUsers.selection()
do !i values !selection
  !this.authUserArray.append(!i)
  !index=!projUserRArray.findFirst(!i)
  !projUserRArray.remove(!index)
  !projUserDArray.remove(!index)
enddo

!this.projUsers.dtext=!projUserDArray
!this.projUsers.rtext=!projUserRArray
!this.authUsers.dtext=!this.authUserArray
!this.default.dtext=!this.authUserArray
endmethod

----------------------------------------------------------------------
--
-- Method:      .remUser
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------

define method .remUser()

!projUserDArray=!this.projUsers.dtext
!projUserRArray=!this.projUsers.rtext
!this.authUserArray=!this.authUsers.dtext
!selection = !this.authUsers.selection()
do !i index !selection
  !index=!this.authUserArray.findFirst(!selection[!i])
  !this.authUserArray.remove(!index)
  !index=!this.projUserRArray.findFirst(!selection[!i])
  !projUserRArray.append(!this.projUserRArray[!index])
  !projUserDArray.append(!this.projUserDArray[!index])
enddo

!this.projUsers.dtext=!projUserDArray
!this.projUsers.rtext=!projUserRArray
!this.authUsers.dtext=!this.authUserArray
!this.default.dtext=!this.authUserArray
endmethod
----------------------------------------------------------------------
--
-- Method:      .checkName
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------

define method .checkName()

if (!this.name.val eq '') then
  !this.name.val = 'unset'
  return error 1 'Name was left blank. Please enter a valid NT Login ID'
endif

-- If the name exists put in modify mode if a new name put in create mode

!newName = !this.name.val
if (!!adminElem.element.dtext.findFirst(!this.name.val).set()) then
  !this.opt='MODIFY'
  !this.mode.select('rtext','MODIFY')
  !this.init(false)
else
  !this.opt='CREATE'
  !this.mode.select('rtext','CREATE')
  !this.init(false)
  !this.name.val = !newName
endif
!this.name.val = !newName

endmethod

----------------------------------------------------------------------
--
-- Method:      .applyCall
--
-- Description: Action
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------

define method .applyCall()

-- Ensure name is lowercase
!this.name.val = !this.name.val.lowcase()

-- Check there is a valid name in the name gadget
if (!this.name.val eq 'unset') then
  return error 1 'No Name supplied. Please enter a valid NT Login ID'
endif
-- Don't create the user if there are no auth users set
if (!this.authUsers.dtext.size() eq 0) then
  return error 1 'No authenticated users selected. Please add a Project User to the authenticated user list using the right arrow'
endif

-- Creation mode
if (!this.mode.selection() eq 'CREATE') then
  CREATE AUTHUSER '$!this.name.val'
  do !i values !this.authUsers.dtext
    USERADD TO '$!this.name.val' '$!i'
  enddo
  !defaultUser = !this.default.selection()
  USERADD TO '$!this.name.val' DEFAULT '$!defaultUser'
  -- Update the list on adminelem form with the name and reset the form to modify
  !names=!!adminElem.element.dtext
  !names.append(!this.name.val)
  !!adminElem.element.dtext=!names
  !!adminElem.element.select('dtext',!this.name.val)
  !this.mode.select('rtext','MODIFY')
  !this.opt = 'MODIFY'
  !this.init(false)
  -- Just in case it's the first user activate the modify and delete buttons
  if (!!adminElem.element.dtext.size() eq 1) then
    !!adminElem.modify.active = TRUE
    !!adminElem.delete.active = TRUE
  endif

elseif (!this.mode.selection() eq 'MODIFY') then

  -- Find out the users in the list
  !authUser=object authUser(!this.name.val)
  !authUserList=!authUser.userList()
  do !i values !authUserList
    !name = !i.name
    USERREMOVE FROM '$!this.name.val' '$!name'
  enddo
  do !i values !this.authUsers.dtext
    USERADD TO '$!this.name.val' '$!i'
  enddo
  !defaultUser = !this.default.selection()
  if (!defaultUser ne '') then
    USERADD TO '$!this.name.val' DEFAULT '$!defaultUser'
  endif
  !this.init(false)

endif
endmethod
