--
--
-- Description:
-- test form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply changes to admControl
--  globalMode()                     -                   Apply changes to admControl
--  initialise()                     -                   Initialisation form
--  initialiseControl()              -                   Initialise Control Object with current settings
--  reset()                          -                   Reset control object
--  select()                         -                   Select utility
--

setup form !!admControlEdit

  !this.formTitle     = 'Admin Control Edit'
  !this.iconTitle     = ''
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.4 $ '

  -- Current Global State
  frame .frameStates 'Project Settings'
    option .globalMode 'Mode'                                       callback '!this.globalMode()' width 12

    -- Global project
    toggle .isGlobal   'Global Project'                             callback '!!admControl.global   = !this.isGlobal.val'

    -- DAC available
    toggle .isDAC      'DAC'                                        callback '!!admControl.dac      = !this.isDAC.val'

    -- Database Sets available
    toggle .isDBSets   'DB Sets'                                    callback '!!admControl.dbSets   = !this.isDBSets.val'

    -- Default Settings
    button .default 'Initialise Control' at xmax form-size ymax+0.5 callback '!this.initialiseControl()'
    path left
    button .reset   'Reset'                                         callback '!this.reset()'

    -- Rebuild Main Bar
    button .rebuild 'Build Main' callback '                         call !!admMain()'
    path right
  exit

  -- Body of form definition
  list   .utilities 'Utilities' at xmin ymax callback '!this.select()' width 70 lines 20

  -- Frame settings
  frame .frameSettings 'Global Settings' at xmin ymax

    -- Description
    paragraph .display width 70 lines 1

    -- None Global Settings
    toggle .globalActive  'Active Global ' at x2 ymax
    toggle .none          'None '
    toggle .global        'Global '
    toggle .globalPlus    'Global Plus '

    -- Set attributes
    button .set           'Set'      callback '!this.apply()'

    button .test          'Test'     callback 'q var !!admControl.isValid(!this.description)'

  exit

  -- Form Member
  member .selection   is REAL

  -- Current Selection
  member .description is STRING

exit
-- End of form definition

----------------------------------------------------------------------
--
-- Method:      globalMode
--
-- Description: Apply changes to admControl
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .globalMode()

  -- Define Global Mode
  !!admControl.mode      = !this.globalMode.selection()
  !!admControl.modeIndex = !this.globalMode.val

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply changes to admControl
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Apply changes to control object
  !!admControl.utility(!this.description, !this.globalActive.val, !this.none.val, !this.global.val, !this.globalPlus.val)

  -- Initialise form
  !this.initialise()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      initialiseControl
--
-- Description: Initialise Control Object with current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialiseControl()

  -- Load Global Instance if required
  if(undefined(!!admControl)) then
    call !!comDefineGlobal(object ADMCONTROL())
  endif

  -- Initialise Control
  !!admControl.admControl(!this.globalMode.val)

  -- Initialise form
  !this.initialise()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      reset
--
-- Description: Reset control object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reset()

  -- Load Global Instance if required
  if(undefined(!!admControl)) then
    call !!comDefineGlobal(object ADMCONTROL())

  -- Initialise Control
  else
    !!admControl.admControl()
  endif

  -- Initialise form
  !this.initialise()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select utility
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select()

  -- Initialise Variables
  !this.selection = !this.utilities.selection('RTEXT').real()

  -- If selection is zero, then return
  if(!this.selection eq 0) then
    !this.display.val         = ''
    !this.none.active         = false
    !this.global.active       = false
    !this.globalPlus.active   = false
    !this.globalActive.active = false
    !this.set.active          = false
    !this.test.active         = false
    return
  endif

  !this.none.active           = true
  !this.global.active         = true
  !this.globalPlus.active     = true
  !this.globalActive.active   = true
  !this.set.active            = true
  !this.test.active           = true

  -- Get Control Data
  !this.description           = !!admControl.description[!this.selection]
  !this.display.val           = !this.description
  !flags                      = !!admControl.utilityMode[!this.selection]
  !this.none.val              = !flags[1]
  !this.global.val            = !flags[2]
  !this.globalPlus.val        = !flags[3]
  !this.globalActive.val      = !!admControl.globalActive[!this.selection]

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  !!alert.message('This form is no longer maintained since PDMS11.5')

  -- Load Global Instance if required
  if(undefined(!!admControl)) then
    call !!comDefineGlobal(object ADMCONTROL())
  endif

  -- Initialise Variables
  !width   = 7

  -- Set Global flag
  !this.isGlobal.val   = !!admControl.isGlobal()
  !this.isDAC.val      = !!admControl.isDAC()
  !this.isDBSets.val   = !!admControl.isDBSet()

  -- Setup global mode
  !dtext[1]   = 'None Global'
  !rtext[1]   = 'NONE'
  !dtext[2]   = 'Global'
  !rtext[2]   = 'GLOBAL1'
  !dtext[3]   = 'Global Plus'
  !rtext[3]   = 'GLOBALPLUS'

  !this.globalMode.dtext = !dtext
  !this.globalMode.rtext = !rtext

  !this.globalMode.val   = !!admControl.modeIndex

  -- Header Data
  !dtext  = !!admControl.dumpHeader(!width)

  -- Define RTEXT for header
  !block   = object BLOCK('|0|')
  !rtext   = !dtext.evaluate(!block)

  !display = !!admControl.dumpDisplay(!width)

  !dtext.appendArray(!display[1])
  !rtext.appendArray(!display[2])

  !this.utilities.dtext = !dtext
  !this.utilities.rtext = !rtext

  -- If selection is unset, then set to 0
  if(!this.selection.unset()) then
    !this.selection = 0
  endif

  -- Select entry
  !this.utilities.select('RTEXT', !this.selection.string())
  !this.select()

endmethod
-- End of method
