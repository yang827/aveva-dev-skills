-- File:            admdaccontrol.pmlfrm
--   Type:          Form Definition
--   Group:         General Application

--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Thu Dec 17 14:59:34 GMT 1998
--
--
-- Description:
-- Form used to turn Data Access Control Off/On
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   Apply DAC switch
--  init()                           -                   A method to initialise the Buttons
--
setup form !!admDacControl

  !!admDacControl.formTitle     = 'DAC Switch'
  !!admDacControl.iconTitle     = 'DAC'
  !!admDacControl.callback      = '!!admDacControl.init()'
  !!admDacControl.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition
  frame .frame at x 0.1 y 0.1 | Data Access Control |
    rgroup .mode
      add tag | On    |  select |ON|
      add tag | Off   | select |OFF|
    exit
  exit
  button .apply at xmin ymax+0.5 |Apply| call |!this.cbApply()| APPLY
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL
exit
-- End of form definition for !!admDacControl
------------------------------------------------------------------------
--
-- Method: .init()
--
-- Description: A method to initialise the Buttons
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
  -- Get the state of DATA ACCESS CONTROL
  !state = !!dbrAdminGetWorld(|ROLE|).lacr
  handle any
    -- ACR LACR attribute now stored under ROLE world (since 28-Jan-2000)
    !!alert.error('You may need to update your project. The ACR switch is now stored with roles')
    !state = FALSE
  endhandle
  if(!state)then
    !this.mode.select(|ON|)
  else
    !this.mode.select(|OFF|)
  endif
endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method: .cbApply()
--
-- Description: Apply DAC switch
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbApply()
  -- Get the state of DATA ACCESS CONTROL
  !dacSwitch = !this.mode.selection()
  !dacState  = !dacSwitch eq 'ON'
  !answer = !!alert.confirm(|Are you sure you wish to switch DAC | + !dacSwitch + | project-wide|)
  if(!answer.boolean().not())then
    -- The user said No
    return
  endif
  !prevPos = !!ce
  -- ACR LACR attribute now stored under ROLE world
  !!ce = !!dbrAdminGetWorld(|ROLE|)
  LACR $!dacState
  handle any
    -- ACR LACR attribute now stored under ROLE world (since 28-Jan-2000)
    !!alert.error('You may need to update your project. The ACR switch is now stored with roles')
  endhandle
  -- update display on the main menu bar
  !!adminApplic.dacStatus()
  !!ce = !prevPos
endmethod
-- End of method definition for .cbApply()
