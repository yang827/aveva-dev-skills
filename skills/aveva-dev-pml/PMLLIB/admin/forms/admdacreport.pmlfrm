-- File:            admdacreport.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--   Keyword:       GEN
--   Module:        admin
--   Replaces:
--
-- Author:          I.Clark
-- Created:
--
--
-- Description:
--     Form to produce a report/Audit of the current DAC
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbEles(STRING,GADGET)            -                   a function to go to the right line number for a given function!
--  createAudit(GADGET)              -                   Creates the Audit
--  init()                           -                   initialise form
--  setGadgets()                     -                   function to setup the eleTypes gadget after creation of an audit!
--  swapEles()                       -                   function to place a list of elements of the right type into the eles gadget!
--

setup form !!admDacReport resize

  !!admDacReport.formTitle     = 'Data Access Control Audit'
  !!admDacReport.iconTitle     = 'DAC Audit'
  !!admDacReport.callback      = '!!admDacReport.init()'
  !!admDacReport.formRevision  = ' '

  -- Body of form definition
  list .report |Audit| anchor all at x 1 y 0.2 width 60 height 31
  list .eleTypes  at xmax+1 ymin |DAC Element Type| anchor top+right call |!this.swapEles()| SINGLE width 12 height 5
  list .eles      at xmin   ymax |DAC Elements|     anchor top+right+bottom call |!this.cbEles(!this.eles.selection('DTEXT'), !this.report)| SINGLE width 12 height 18

  button .create  at xmin.report ymax.report |Create Audit| anchor left+bottom call |!this.createAudit(!this.report)|
  button .dismiss at xmax form-size ymin |Dismiss| anchor bottom+right CANCEL

  member .roleDtext  is ARRAY
  member .roleRtext  is ARRAY
  member .scopeDtext is ARRAY
  member .scopeRtext is ARRAY
  member .acrsDtext  is ARRAY
  member .acrsRtext  is ARRAY
  member .acrgDtext  is ARRAY
  member .acrgRtext  is ARRAY

exit
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
--  !this.report.setEditable(FALSE)
  !this.createAudit(!this.report)
endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      .createAudit()
--
-- Description: Creates the Audit
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createAudit(!dummyreportGadget is GADGET)
  !this.roleDtext.clear()
  !this.roleRtext.clear()
  !this.scopeDtext.clear()
  !this.scopeRtext.clear()
  !this.acrsDtext.clear()
  !this.acrsRtext.clear()
  !this.acrgDtext.clear()
  !this.acrgRtext.clear()

  !timeNow = object DATETIME()
  !report = ARRAY()
  !report[1] = |Data Access Control Report for Project | +  !!sessionSettings.project.upcase()
  !report[2] = |Date : | + !timeNow.date().string() + | | + !timeNow.monthString() + | | + !timeNow.year().string() + | Time :- | + !timeNow.hour().string() + |:| + !timeNow.minute().string()
  !report[3] = | |
  !report[4] = | ******** SCOPEs in Project ********|
  !report[5] = | |
  -- Navigate to Scope World
  !prev = !!ce
  !!ce = !!dbrAdminGetWorld(|SCOPE|)
  -- Collect Scopes
  !scopes = !!ce.mem
  -- Generate text for Scope
  do !i values !scopes
    !!ce = !i
    !report.append(|SCOPE NAME : | + !i.name)
    !this.scopeDtext.append(!i.name.substring(2))
    !this.scopeRtext.append(!report.maxIndex().string())
    !report.append(|  DESCRIPTION : | + !i.desc)
    VAR !x SCOSEL
    !report.append(|  SCOPE DEFINITION: | + !x)
    !report.append(| |)
  enddo
  !report.append(| ******** ROLEs in Project ******** |)
  !report.append(| |)
  -- Navigate to Role World
  !!ce = !!dbrAdminGetWorld(|ROLE|)

  -- Collect Roles
  !roles = !!ce.mem
  do !j values !roles

    !report.append(|ROLE NAME : | + !j.name)
    !this.roleDtext.append(!j.name.substring(2))
    !this.roleRtext.append(!report.maxIndex().string())
    !report.append(|  DESCRIPTION : | + !j.desc)
    !report.append(|  Permissible operations for the role are: |)
    -- get Perops for this Role
    !perops = !j.mem
    !eBlock = object BLOCK('!report.append(|        | + !!ce.eclass[!evalIndex])')
    !aBlock = object BLOCK('!report.append(|        | + !!ce.aclass[!evalIndex])')
    do !k values !perops
      !!ce = !k
      !report.append(|    NAME : | + !k.name)
      !report.append(|      Element List :|)
      !!ce.eclass.evaluate(!eBlock)
      !report.append(|      Attribute List :|)
      !!ce.aclass.evaluate(!aBlock)
      VAR !t CONDITION
      !report.append(|      Condition     : | + !t)
      handle any
        !report.append(|      Condition     :  Too Long to report|)
      endhandle
      !report.append(|      Error Message : | + !k.acrMessage)
      if( !k.opModify.trim().upcase() eq 'GRANT' ) then
        !report.append(|      Modify - ALLOW|)
      elseif( !k.opModify.trim().upcase() eq 'DENY' ) then
        !report.append(|      Modify - DISALLOW|)
      else
        !report.append(|      Modify - | + !k.opModify)
      endif
      if( !k.opCreate.trim().upcase() eq 'GRANT' ) then
        !report.append(|      Create - ALLOW|)
      elseif( !k.opCreate.trim().upcase() eq 'DENY' ) then
        !report.append(|      Create - DISALLOW|)
      else
        !report.append(|      Create - | + !k.opCreate)
      endif
      if( !k.opDelete.trim().upcase() eq 'GRANT' ) then
        !report.append(|      Delete - ALLOW|)
      elseif( !k.opDelete.trim().upcase() eq 'DENY' ) then
        !report.append(|      Delete - DISALLOW|)
      else
        !report.append(|      Delete - | + !k.opDelete)
      endif
      if( !k.opClaim.trim().upcase() eq 'GRANT' ) then
        !report.append(|      Claim  - ALLOW|)
      elseif( !k.opClaim.trim().upcase() eq 'DENY' ) then
        !report.append(|      Claim  - DISALLOW|)
      else
        !report.append(|      Claim  - | + !k.opClaim)
      endif
      if( !k.opIssue.trim().upcase() eq 'GRANT' ) then
        !report.append(|      Issue  - ALLOW|)
      elseif( !k.opIssue.trim().upcase() eq 'DENY' ) then
        !report.append(|      Issue  - DISALLOW|)
      else
        !report.append(|      Issue  - | + !k.opIssue)
      endif
      if( !k.opDrop.trim().upcase() eq 'GRANT' ) then
        !report.append(|      Drop   - ALLOW|)
      elseif( !k.opDrop.trim().upcase() eq 'DENY' ) then
        !report.append(|      Drop   - DISALLOW|)
      else
        !report.append(|      Drop   - | + !k.opDrop)
      endif
    enddo
    !report.append(| |)

  enddo

  !report.append(| ******** ACRs in Project ********|)
  !report.append(| |)
  -- Navigate to USER World
  !!ce = !!dbrAdminGetWorld(|ACR|)
  do !i values !!ce.mem
    skip if(!i.type ne |ACR|)
    !!ce = !i
    !report.append(|NAME : | + !i.name)
    !this.acrsDtext.append(!i.name.substring(2))
    !this.acrsRtext.append(!report.maxIndex().string())
    !report.append(|  DESCRIPTION    : | + !i.desc)
    if(!i.scopeRef.unset())then
      !report.append(|  SCOPE Reference: ERROR attribute unset this could cause problems|)
    else
      !report.append(|  SCOPE Reference: | + !i.scopeRef.name.substring(2))
    endif
    if(!i.roleRef.unset())then
      !report.append(|  ROLE  Reference: ERROR attribute unset this could cause problems|)
    else
      !report.append(|  ROLE  Reference: | + !i.roleRef.name.substring(2))
    endif
    !report.append(| |)
  enddo

  !report.append(| ******** ACR Groups in Project ********|)
  !report.append(| |)
  !!ce = !!dbrAdminGetWorld(|ACR|)
  do !i values !!dbrAdminGetWorld(|ACR|).mem
    skip if(!i.type ne |ACRST|)
    !report.append(|NAME : | + !i.name)
    !this.acrgDtext.append(!i.name.substring(2))
    !this.acrgRtext.append(!report.maxIndex().string())
    !report.append(|  DESCRIPTION  : | + !i.desc)
    do !acrGroupIndex indices !i.acrGroup
      !report.append(|  ACR Reference: | + !i.acrGroup[!acrGroupIndex].name.substring(2))
    enddo
    !report.append(| |)
  enddo

  !report.append(|******** AUDIT END ********|)
  !this.report.dText = !report
  !!ce = !prev
  !this.setGadgets()
  !curPos[1] = 1
  !curPos[2] = 0
  !this.report.val = !curPos[1]

endmethod
-- End of method definition for .createAudit(GADGET)
------------------------------------------------------------------------
--
--Method: .setGadgets()
--
-- Description: function to setup the eleTypes gadget after creation of an audit!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setGadgets()

  !tempDtext = ARRAY()

  !this.eleTypes.clear()

  !tempDtext.append(|Roles|)
  !tempDtext.append(|Scopes|)
  !tempDtext.append(|ACRs|)
  !tempDtext.append(|ACR Groups|)

  !this.eleTypes.dText = !tempDtext
  !this.eleTypes.val = 1

  !this.swapEles()

endmethod
-- End of method definition for .setGadgets()
------------------------------------------------------------------------
--
--Method: .swapEles()
--
-- Description: function to place a list of elements of the right type into the eles gadget!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .swapEles()
  if(!this.eleTypes.selection(|DTEXT|) EQ |Roles|)then
    !this.eles.dText = !this.roleDtext
    !this.eles.rText = !this.roleRtext
  elseif(!this.eleTypes.selection(|DTEXT|) EQ |Scopes|)then
    !this.eles.dText = !this.scopeDtext
    !this.eles.rText = !this.scopeRtext
  elseif(!this.eleTypes.selection(|DTEXT|) EQ |ACRs|)then
    !this.eles.dText = !this.acrsDtext
    !this.eles.rText = !this.acrsRtext
  elseif(!this.eleTypes.selection(|DTEXT|) EQ |ACR Groups|)then
    !this.eles.dText = !this.acrgDtext
    !this.eles.rText = !this.acrgRtext
  endif
endmethod
-- End of method definition for .swapEles()
------------------------------------------------------------------------
--
--Method: .cbEles
--
-- Description: a function to go to the right line number for a given function!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R       STRING     STRING OF A NUMBER OF THE ELEMENT TO GO TO!
--   2   RW      GADGET     The Gadget to be navigated in!
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbEles(!strNumber is STRING, !gadget is GADGET)
  !report     = !gadget.dText
  do !i index !report
    break if (!report[!i].match(!strNumber) gt 0 )
  enddo
  !curPos[1]  = !i
  !curPos[2]  = 0
  !gadget.val = !curPos[1]
endmethod
-- End of method definition for .cbEles(STRING, GADGET)
