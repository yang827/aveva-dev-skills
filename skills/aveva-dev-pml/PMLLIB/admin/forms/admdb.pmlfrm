------------------------------------------------------------------------
--
--Method: .cbName()
--
-- Description: Callback to the Name gadget in the DB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbName(!gadget is GADGET)

  -- Initialise variables
  !mode     = !this.modeGet()
  !dbRef    = !this.refGet()
  !owner    = !this.teamGet()
  !value    = !gadget.val.trim()

  -- Check that the name has not been entered with a '/'
  if (!value.substring(1,1) eq '/') then
    !value    = !value.substring(2)
  endif

  -- warn user if the name already exists (on create)
  if( !mode eq 'CREATE' ) then
    -- (AK) check to see if name has not been used
    !check  = !owner.name.string() + '/' + !value
    !unused = !check.dbRef()
    handle ANY
    elsehandle NONE
      !!messageFile.warning(141, 153, !check)
    endhandle
  else
    -- check to see if it has been changed to a valid name
    if( !value.empty() ) then
      !!alert.error('Database must be given a name')
      !gadget.val = !dbRef.name.after(!owner.name.string() + '/')
      return
    else
      -- check for name changed
      !check     = !owner.name.string() + '/' + !value
      !dbElement = !check.dbRef()
      handle ANY
        -- name is unused, so OK
      elsehandle NONE
        -- check to see if name has changed to a used name
        if( !dbElement ne !dbRef ) then
          -- using a name already used
          !gadget.val = !dbRef.name.after(!owner.name.string() + '/')
          !!messageFile.warning(141, 153, !check.substring(3))
          return
        endif
      endhandle
    endif
  endif

  -- Change the database paragraph gadget
  if (!owner.set()) then
    !this.dbName.val  = !owner.name.substring(3) +|/|+ !value
  else
    !this.dbName.val  = |unset/| + !value
  endif

  -- Reset the name gadget
  !gadget.val         = !value

endmethod
-- End of method definition for .cbName(GADGET)

