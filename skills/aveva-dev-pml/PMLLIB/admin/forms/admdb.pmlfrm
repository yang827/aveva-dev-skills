-- End of method definition for .teamGet() DBREF

------------------------------------------------------------------------
--
--Method: .teamSel()
--
-- Description: Callback to Project Team list for user selection.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget selection was made from.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .teamSel(!gadget is GADGET)

  -- Initialise variables
  !dbOwner           = !this.teamGet()
  !selectedTeam      = !gadget.selection('rtext').dbRef()
  handle (2,107)

    -- Team does not exist in project
    !!messageFile.error(141, 3, $
        !!messageFile.messageString(141, 803), !gadget.selection('rtext'))
    handle (06, 003)
      -- Dummy handle
    endhandle

    !this.refresh()
    return

  endhandle

  -- Check that the selection is new
  if (!dbOwner eq !selectedTeam) then
    return
  endif

  -- Quick check to make sure TRANSACTION is not used
  if (!selectedTeam.name eq '/*TRANSACTION' ) then
    !project = current project
    if (!project.isGlobal().not()) then
      !!alert.error('TRANSACTION is a reserved team name, used in Global Projects. This team should only be used for Global transaction databases..')
      -- Select the old team
      !selectedTeam = !this.team
      -- Reselect the old team in gadget list
      !gadget.select('rtext', !selectedTeam.string())
      handle ANY
      endhandle
    endif
  endif

  -- Set the new team
  !this.teamSet(!selectedTeam)

  -- Reset the paragraph gadget
  !this.dbName.val = !selectedTeam.name.substring(3) + |/| + !this.name.val

endmethod
-- End of method definition for .teamSel(GADGET)

------------------------------------------------------------------------
--
--Method: .teamSet()
--
-- Description: set the current TEAM DBREF for the DB Definition form.
-- The TEAM owns the current database.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of TEAM element (can be unset).
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .teamSet(!dbRef is DBREF)

  -- Set the DBREF
  !this.team     = !dbRef

  if (!this.team.name eq '/*TRANSACTION') then
    -- Only a transaction db can be created in the transaction team
    !this.type.select('rtext', 'TRAN')
    !this.cbType()
  else
    -- A transaction db can NOT be created in other than the transaction team
    if (!this.type.selection('rtext') eq 'TRAN') then
      !this.type.select('rtext', 'DESI')
      !this.cbType()
    endif
  endif

endmethod
-- End of method definition for .teamSet(DBREF)

------------------------------------------------------------------------
--
--Method: .cbType()
--
-- Description: acts as callback to the Database Type gadget. Controls
-- active state of access gadget and picf gadget.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbType()

  -- Initialise variables
  -- Check the database type
  !type  = !this.type.selection('rtext')
  !mode  = !this.modeGet()
  !dbRef = !this.refGet()

  if (!type neq 'ENGI') then
    !this.elementType.active = false
    !this.elementType.clear()
  else
    !this.getElementType()
    !this.elementType.active = true
  endif


  -- Check to ensure a transaction DB cannot be created in other than the transaction team
  if (!this.shown()) then
    if (!this.team.name neq '/*TRANSACTION' and !type eq 'TRAN') then
      -- A transaction db can NOT be created in other than the transaction team
      if (!this.shown()) then
        !!alert.error('A transaction dB can only be created in the transaction team')
      endif
      !this.type.select('rtext', 'DESI')
      !type  = !this.type.selection('rtext')
    elseif (!this.team.name eq '/*TRANSACTION' and !type neq 'TRAN') then
      -- Only a transaction dB can be created in the transaction team
      if (!this.shown()) then
        !!alert.error('Only a transaction dB can be created in the transaction team')
      endif
      !this.type.select('rtext', 'TRAN')
      !type  = !this.type.selection('rtext')
    endif
  endif

 !mode              = !this.modeGet()

  if (!mode eq 'CREATE') then
    if (!type eq 'MANU' or !type eq 'TRAN' or !type eq 'NSEQ') then
      !this.dbElem.active = FALSE
      !this.dbElem.tag    = ''
    else
      !this.dbElem.active = TRUE
    endif
  endif

  if ( !this.dbElem.active ) then
    if (!type eq 'DESI') then
      if (!this.refOnly.val) then
        !this.dbElem.tag = 'Create SYGPWL'
      else
        !this.dbElem.tag = 'Create SITE'
      endif
    elseif (!type eq 'PADD') then
      !this.dbElem.tag = 'Create DEPT'
    elseif (!type eq 'CATA') then
      !this.dbElem.tag = 'Create CATA'
    elseif (!type eq 'PROP') then
      !this.dbElem.tag = 'Create CMPW'
    elseif (!type eq 'SCHE') then
      !this.dbElem.tag = 'Create SCGROU'
    elseif (!type eq 'ISOD') then
      !this.dbElem.tag = 'Create ISODEP'
    elseif (!type eq 'DICT') then
      !this.dbElem.tag = 'Create UWRL'
    elseif (!type eq 'ENGI') then
      !this.dbElem.tag = 'Create ENGWLD'
    elseif (!type eq 'ALYS') then
      !this.dbElem.tag = 'Create HYSWLD'
    else
      !this.dbElem.tag = ''
    endif
  endif

  if (!type eq 'DESI' or !type eq 'PADD' or !type eq 'CATA' or !type eq 'ISOD' or !type eq 'SCHE' or !type eq 'MANU' or !type eq 'ENGI' or !type eq 'ALYS') then

    -- All database modes are available
    if (!this.access.selection() eq 'Overwrite') then
      -- set up the access modes option menu
      !this.access.clear()
      !rText              = ARRAY()
      !dText              = ARRAY()
      !dText[1]           = |Multiwrite|
      !dText[2]           = |Update|
      !rText[1]           = |Multiwrite|
      !rText[2]           = |Update|
      !this.access.dText  = !dText
      !this.access.rText  = !rText
    endif

    !this.area.active     = true
    !this.access.active   = true
    !this.access()
    if (!type eq 'DESI') then
      !this.controlled.active = TRUE
    else
      !this.controlled.active = FALSE
    endif
    if (!mode eq 'CREATE' and !type eq 'DESI') then
      !this.refOnly.active = TRUE
    else
      !this.refOnly.active = FALSE
    endif

    !this.protected.active = true
    !this.changeDbPass.active = true

    -- P-20307 Cannot change protected field if DB not Primary
    if (!mode eq 'MODIFY' and !this.dbRef.isprim eq false ) then
      !this.protected.active = false
      !this.changeDbPass.active = false
      !this.deleteDbPass.active = false
    endif

  elseif (!type eq 'TRAN') then

    -- All database modes are not available
    !this.access.clear()
    !rText              = ARRAY()
    !dText              = ARRAY()
    !dText[1]           = |Overwrite|
    !rText[1]           = |Overwrite|
    if (!mode eq 'MODIFY' and !dbRef.accessDb eq 'Multiwrite') then
      !dText[1]           = |Multiwrite|
      !rText[1]           = |Multiwrite|
      !dText[2]           = |Overwrite|
      !rText[2]           = |Overwrite|
    endif
    !this.access.dText  = !dText
    !this.access.rText  = !rText

    !this.area.val = 'Set by System'
    !this.area.active     = false
    !this.access.active   = false
    !this.claim.select('rtext','IMPLICIT')
    !this.claim.active    = false
    !this.controlled.active = false
    !this.controlled.val    = false
    !this.refOnly.active = false
    !this.refOnly.val    = false
    !this.protected.active = false
    !this.changeDbPass.active = false
    !this.deleteDbPass.active = false
    !this.protected.val    = false
    !this.expires.val    = FALSE
    !this.expires.active = FALSE
    !this.day.active     = FALSE
    !this.month.active   = FALSE
    !this.year.active    = FALSE

  elseif (!type eq 'NSEQ') then

    -- All database modes are not available
    !this.access.clear()
    !rText              = ARRAY()
    !dText              = ARRAY()
    !dText[1]           = |Overwrite|
    !rText[1]           = |Overwrite|
    !this.access.dText  = !dText
    !this.access.rText  = !rText

    !this.area.val = 'Set by System'
    !this.area.active     = false
    !this.access.active   = false
    !this.claim.select('rtext','IMPLICIT')
    !this.claim.active    = false
    !this.controlled.active = false
    !this.controlled.val    = false
    !this.refOnly.active = false
    !this.refOnly.val    = false
    !this.protected.active = false
    !this.changeDbPass.active = false
    !this.deleteDbPass.active = false
    !this.protected.val    = false
    !this.expires.val    = FALSE
    !this.expires.active = FALSE
    !this.day.active     = FALSE
    !this.month.active   = FALSE
    !this.year.active    = FALSE

  else

    -- All database modes are available
    if (!this.access.selection() eq 'Overwrite') then
      -- set up the access modes option menu
      !this.access.clear()
      !rText              = ARRAY()
      !dText              = ARRAY()
      !dText[1]           = |Multiwrite|
      !dText[2]           = |Update|
      !rText[1]           = |Multiwrite|
      !rText[2]           = |Update|
      !this.access.dText  = !dText
      !this.access.rText  = !rText
    endif

    -- Only update mode is permitted for Non Design databases
    !this.area.active     = true
    !this.access.select('rtext','Update')
    !this.access.active   = false
    !this.claim.active    = false
    !this.controlled.active = FALSE
    !this.refOnly.active = false

    !this.protected.active = true
    !this.changeDbPass.active = true


  endif


  -- Make the description active (Also valid for TRAN dbs)
  !this.desc.active = true

  -- Check to see is we have a Global project
  if (!!admControl.isValid('Global')) then
  	
    !this.distDb.val = TRUE
    -- could we use !this.access.selection here?
    -- if( !this.type.selection('rtext') eq 'NSEQ' or !this.type.selection('rtext') eq 'TRAN') then
    if( !this.access.selection('rtext').upcase() eq 'OVERWRITE' ) then
    	!this.distDb.val = FALSE
    	!this.distDb.active = false
    else
    	!this.distDb.active = true
    endif

    if (!this.modeGet() eq 'MODIFY') then
          !this.distDb.val  = !dbRef.members[1].propg
    endif

    -- Only Draft database need the picture file gadget
    if (!this.type.selection('rtext') eq 'PADD' or !this.type.selection('rtext') eq 'SCHE') then
      !this.picture.active  = true

      -- P-3687 SCHE should be PICFD true by default - only applies to PADD/SCHE dbs
      if (!type eq 'SCHE' ) then
        !this.picture.val = TRUE
      else
        !this.picture.val = FALSE
      endif

      if (!this.modeGet() eq 'MODIFY') then
          -- P-20307 Get values from Database when Modifying
          !this.distDb.val    = !dbRef.members[1].propg
          !this.picture.val  = !dbRef.members[1].picfd
      endif

    else
      !this.picture.active  = false
    endif

		-- Enable Link Documents if in Global and a Design Database Type is set
		if (!this.isGlobalHub()) then
			!glocwl = object DBREF('/*GL')
	    if (!glocwl.set()) then
	      if (!glocwl.gLinkPropagation) then
	      	!this.linkDocuments.active = !type eq 'DESI'
	    	else
	    		!this.linkDocuments.active = false
				endif
			endif
		endif

  endif

endmethod
-- End of method definition for .cbType()

------------------------------------------------------------------------
--
--Method: .cbRefOnly()
--
-- Description: acts as callback to the Reference Only toggle.
-- Controls top-level element type to be created.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbRefOnly()
  if (!this.type.selection('rtext') eq 'DESI') then
    if (!this.refOnly.val) then
      !this.dbElem.tag = 'Create SYGPWL'
    else
      !this.dbElem.tag = 'Create SITE'
    endif
  endif
endmethod
-- End of method definition for .cbRefOnly()

------------------------------------------------------------------------
--
--Method: .update()
--
-- Description: update the displayed DB in the DB Definition form.
-- The form must be displayed in MODIFY mode.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- Initialise variables
  !mode  = !this.modeGet()
  !selDb = !!adminElem.dbGet()
  !curDb = !this.refGet()

  -- Return if the form is not shown
  if (!!admDb.shown().not()) then
    return
  endif

  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif
  -- Return if the same reference
  if (!selDb eq !curDb) then
    return
  endif

  -- Return if the database is foreign
  if (!selDb.foreign eq 'FOREIGN') then
    !!messageFile.warning(141, 161, !selDb.name.substring(3))
    return
  endif

  -- Reinitialise the form
  !this.refSet(!selDb)
  !this.teamSet(!selDb.owner.owner)
  !this.init()

 -- Update the !!changeDbPass form
  if (Undefined (!!changeDbPass)) then
     !!loadForm ('changeDbPass')
  endif
  if(!!changeDbPass.shown())then
     !!changeDbPass.update()
     if (!this.lPassGet() eq true) then
        !!changeDbPass.oldPasswd.setFocus()
     else
        !!changeDbPass.newPasswd.setFocus()
     endif
  endif
   -- Update the !!getDbPass form
  if (Undefined (!!getDbPass)) then
     !!loadForm ('getDbPass')
  endif
  if(!!getDbPass.shown())then
     !!getDbPass.update()
     !!getDbPass.currPasswd.setFocus()

  endif

endmethod
-- End of method definition for .update()
------------------------------------------------------------------------
--
-- Method:     setupDate()
--
-- Description: setup the data for date
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupDate()


do !x to 31
  !day[!x] = !x.string()
enddo
!this.day.dText = !day

   !month[1] = 'Jan'
   !month[2] = 'Feb'
   !month[3] = 'Mar'
   !month[4] = 'Apr'
   !month[5] = 'May'
   !month[6] = 'Jun'
   !month[7] = 'Jul'
   !month[8] = 'Aug'
   !month[9] = 'Sep'
   !month[10] = 'Oct'
   !month[11] = 'Nov'
   !month[12] = 'Dec'

   !this.month.dText = !month

!date = object DATETIME()
!currentYear  = !date.year()
!previousYear = (!currentYear + 10)
do !x from !currentYear to !previousYear
  !year[!x] = !x.string()
enddo

!this.year.dText = !year

endmethod

-- End of method definition for .setupDate()
------------------------------------------------------------------------
--
-- Method:     protected()
--
-- Description: change the status of the expire data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .protected()

!mode = !this.modeGet()
if ((!mode eq 'MODIFY') and (!this.lPassGet() eq true) and (!this.dbRef.lprot eq true) and !this.protected.val.not()) then
  --!!alert.warning('The current Database has a password and to remove protection, password required when you apply changes.')
  !this.showGetDbPassDialog('REMPROT')
       handle any
        !!alert.error(!!error.text)
       endhandle
else
   !this.protectedSetting()
endif

endmethod

define method .protectedSetting()
!mode = !this.modeGet()
if (!mode eq 'MODIFY' and !this.expires.val and !this.protected.val) then
  !expiry = !this.dbRef.expiry
  if (!expiry.unset() or !expiry eq '') then
    !this.expires.val    = TRUE
    !this.expires.active = TRUE
    -- Initialise the current time
    !timeNow = object DATETIME()
    !this.day.val        = !timeNow.date().string()
    !this.month.val      = !timeNow.month()
    !this.year.val       = !timeNow.year().string()
    !this.day.active     = FALSE
    !this.month.active   = FALSE
    !this.year.active    = FALSE
  else
    !this.expires.val    = TRUE
    !this.expires.active = FALSE
    !date = !expiry.split('-')
    !expireTime = object DATETIME(!date[1].real(),!date[2].real(),!date[3].real())
    !this.day.val        = !expireTime.date().string()
    !this.month.val      = !expireTime.month()
    !this.year.val       = !expireTime.year().string()
    !this.day.active     = TRUE
    !this.month.active   = TRUE
    !this.year.active    = TRUE
  endif
elseif (!mode eq 'MODIFY' and !this.expires.val and !this.protected.val.not()) then
  !this.expires.val    = FALSE
  !this.expires.active = FALSE
  !this.day.active     = FALSE
  !this.month.active   = FALSE
  !this.year.active    = FALSE
elseif (!mode eq 'MODIFY' and !this.expires.val.not() and !this.protected.val) then
  !expiry = !this.dbRef.expiry
  if (!expiry.unset() or !expiry eq '') then
    !this.expires.val    = FALSE
    !this.expires.active = TRUE
    -- Initialise the current time
    !timeNow = object DATETIME()
    !this.day.val        = !timeNow.date().string()
    !this.month.val      = !timeNow.month()
    !this.year.val       = !timeNow.year().string()
    !this.day.active     = FALSE
    !this.month.active   = FALSE
    !this.year.active    = FALSE
  else
    !this.expires.val    = TRUE
    !this.expires.active = FALSE
    !date = !expiry.split('-')
    !expireTime = object DATETIME(!date[1].real(),!date[2].real(),!date[3].real())
    !this.day.val        = !expireTime.date().string()
    !this.month.val      = !expireTime.month()
    !this.year.val       = !expireTime.year().string()
    !this.day.active     = TRUE
    !this.month.active   = TRUE
    !this.year.active    = TRUE
  endif
elseif (!mode eq 'MODIFY' and !this.expires.val.not() and !this.protected.val.not()) then
  !this.expires.val    = FALSE
  !this.expires.active = FALSE
  !this.day.active     = FALSE
  !this.month.active   = FALSE
  !this.year.active    = FALSE

elseif (!mode eq 'CREATE' and !this.protected.val) then
  !this.expires.active = TRUE
elseif (!mode eq 'CREATE' and !this.protected.val.not()) then
  !this.expires.active = FALSE
  !this.expires.val = FALSE
  !this.day.active   = FALSE
  !this.month.active = FALSE
  !this.year.active  = FALSE
  !this.apply.active = TRUE
  !timeNow = object DATETIME()
  !this.day.val            = !timeNow.date().string()
  !this.month.val          = !timeNow.month()
  !this.year.val           = !timeNow.year().string()
endif
endmethod

-- End of method definition for .protectedSetting()
------------------------------------------------------------------------
--
-- Method:     expires()
--
-- Description: change the status of the date
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .expires()

!mode              = !this.modeGet()

if (!this.expires.val) then
  if (!mode eq 'CREATE') then
    !expiry = ''
  else
    !expiry = !this.dbRef.expiry
  endif
  if (!expiry.unset() or !expiry eq '') then
    !this.expires.val    = TRUE
    if (!mode eq 'CREATE') then
      !this.expires.active = TRUE
    else
      !this.expires.active = FALSE
    endif
    -- Initialise the current time
    !timeNow = object DATETIME()
    !this.day.val        = !timeNow.date().string()
    !this.month.val      = !timeNow.month()
    !this.year.val       = !timeNow.year().string()
    !this.day.active     = FALSE
    !this.month.active   = FALSE
    !this.year.active    = FALSE
  else
    !this.expires.val    = TRUE
    if (!mode eq 'CREATE') then
      !this.expires.active = TRUE
    else
      !this.expires.active = FALSE
    endif
    !date = !expiry.split('-')
    !expireTime = object DATETIME(!date[1].real(),!date[2].real(),!date[3].real())
    !this.day.val        = !expireTime.date().string()
    !this.month.val      = !expireTime.month()
    !this.year.val       = !expireTime.year().string()
    !this.day.active     = TRUE
    !this.month.active   = TRUE
    !this.year.active    = TRUE
  endif
  !this.day.active   = TRUE
  !this.month.active = TRUE
  !this.year.active  = TRUE
else
  !this.day.active   = FALSE
  !this.month.active = FALSE
  !this.year.active  = FALSE
  !timeNow = object DATETIME()
  !this.day.val            = !timeNow.date().string()
  !this.month.val          = !timeNow.month()
  !this.year.val           = !timeNow.year().string()
  !this.apply.active = TRUE
endif

endmethod

-- End of method definition for .expires()
------------------------------------------------------------------------
--
-- Method:     validDate()
--
-- Description: check the date is valid and in the future
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validDate()

!todayDate  = object DATETIME()
!futureDate = object DATETIME(!this.year.selection().real(),!this.month.selection(),!this.day.selection().real(), 23.0, 59.0, 59.0)
handle (161,50) $* Invalid Date
  !!alert.error('The date entered is invalid')
  !this.apply.active = FALSE
  return
elsehandle none
  !this.apply.active = TRUE
endhandle
if (!todayDate.gt(!futureDate)) then
  !!alert.error('The date entered must not be a past date')
  !this.apply.active = FALSE
else
  !this.apply.active = TRUE
endif
endmethod

-- End of method definition for .validDate()

------------------------------------------------------------------------
--
--Method: .isGlobalHub()
--
-- Description: If the project is Global then this method will determine
-- whether the current project is a Hub
--
------------------------------------------------------------------------

define method .isGlobalHub() is BOOLEAN

	!isHubLocation = false
	
	!globalProject = !!admControl.isValid('Global')
	if (!globalProject) then
	   !isHubLocation  = !!glbHubStatus(!globalProject)
	endif

	return !isHubLocation
	
endmethod
------------------------------------------------------------------------
--
--Method: .getElementType()
--
-- Description: Populate the element option gadget
--
------------------------------------------------------------------------
define method .getElementType()

  !dText[1] = 'Engineering Data World'
  !rText[1] = 'ENGWLD'

  !dText[2] = 'Extended Properties World'
  !rText[2] = 'XPIWLD'

  !this.elementType.dText = !dText
  !this.elementType.rText = !rText


endmethod
------------------------------------------------------------------------
--
--Method: .setElementType()
--
-- Description: set  the element to be created
--
------------------------------------------------------------------------
define method .setElementType()

  !type = !this.elementType.selection('rtext')

  if (!type eq 'ENGWLD') then
    !this.dbElem.tag = 'Create ENGWLD'
  else
    !this.dbElem.tag = 'Create XPIWLD'
  endif


endmethod

------------------------------------------------------------------------
--
-- Method: .lPassGet()
--
-- Description: get DB password existence status (lPass)
--
------------------------------------------------------------------------

define method .lPassGet() is BOOLEAN
  !dbRef = !this.refGet()
  !prevRef = !!ce
	!!ce     = !dbRef
  !dbName  = !dbRef.name.substring(3)
  !lPass = false
  !command = |CHANGE | + !dbName +| VERIFY ''|
  call !!admCommand(!command)
   handle (2,173)
     !lPass = true
   elsehandle any
     -- Read-only or Secondary database - cannot set password
   endhandle
   !!ce = !prevRef
  return !lPass
endmethod
------------------------------------------------------------------------
--
-- Method: .showDbPassDialog()
--
-- Description: Show Set / Change DB password dialog box
--
------------------------------------------------------------------------

-- Define method
define method .showDbPassDialog()

    if (undefined (!!changeDbPass)) then
        !!loadForm ('changeDbPass')
    else
        kill !!changeDbPass
        !!loadForm ('changeDbPass')
    endif

    !!changeDbPass.dbRef = !this.dbRef
    !!changeDbPass.mode = !this.modeGet()

    show !!changeDbPass at xr 0.36 yr 0.35

endmethod
-- End of method definition for .showDbPassDialog()
------------------------------------------------------------------------
--
-- Method: .showGetDbPassDialog()
--
-- Description: Show Get DB password dialog box
--
------------------------------------------------------------------------

-- Define method
define method .showGetDbPassDialog(!reason is STRING)

    if (undefined (!!getDbPass)) then
        !!loadForm ('getDbPass')
    else
        kill !!getDbPass
        !!loadForm('getDbPass')
    endif

    !!getDbPass.reason = !reason
    !!getDbPass.dbRef = !this.dbRef
    !!getDbPass.mode = !this.modeGet()

     show !!getDbPass at xr 0.36 yr 0.35

endmethod
-- End of method definition for .showGetDbPassDialog()
