-- File:            admdb.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Thu May 8 15:59:10 BST 1997
--
--
-- Description:
-- Form definition to create/modify  database elements.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  access()                         -                   acts as callback to Access gadget in the DB Definition form.
--  admDb()                          -                   Constructor
--  cbApply()                        -                   create or modify a DB element. The values method . the element
--  cbFino(STRING)                   -                   Callback for the database file number gadget, and the reset button.
--  cbName(GADGET)                   -                   Callback to the Name gadget in the DB Definition form.
--  cbRefOnly()                      -                   acts as callback to the Reference Only toggle.
--  cbType()                         -                   acts as callback to the Database Type gadget. Controls
--  display(STRING)                  -                   display the DB Definition form.
--  expires()                        -                   change the status of the date
--  getElementType()                 -                   Populate the element option gadget
--  init()                           -                   initialise the DB Definition form.
--  isGlobalHub()                    BOOLEAN             If the project is Global then this method will determine
--  lPassGet()                       BOOLEAN             get DB password existence status (lPass)
--  loc(STRING)                      -                   Callback to Primary location gadget on the DB Definition form.
--  locGet()                         DBREF               return the DBREF of the current databases primary loc.
--  locSet(DBREF)                    -                   set the form member for a databases primary location
--  mode()                           -                   Callback to the mode gadget in the DB Definition form.
--  modeGet()                        STRING              return the current mode of the DB Definition form.
--  modeSet(STRING)                  -                   set the mode of the DB Definition form.
--  protected()                      -                   set protected on /off
--  protectedSetting()               -                   change the status of the expire data
--  refGet()                         DBREF               return the current DB DBREF for the element being edited.
--  refSet(DBREF)                    -                   set the current DB DBREF for the DB Definition form.
--  refresh()                        -                   refresh the TEAM elements listed in the Project Teams
--  setElementType()                 -                   set  the element to be created
--  setupDate()                      -                   setup the data for date
--  showDbPassDialog()               -                   Show DB password text entry/confirmation dialog
--  showGetDbPassDialog(STRING)      -                   Show get DB password text entry dialog
--  teamArrGet()                     ARRAY               return the array of project teams being used by the DB Definition form.
--  teamArrList()                    -                   update the contents of the project teams list gadget on DB Definition form.
--  teamArrSet()                     -                   set the form member for the project teams in the DB Definition form.
--  teamGet()                        DBREF               return the DBREF of the TEAM to which the current DB in
--  teamSel(GADGET)                  -                   Callback to Project Team list for user selection.
--  teamSet(DBREF)                   -                   set the current TEAM DBREF for the DB Definition form.
--  update()                         -                   update the displayed DB in the DB Definition form.
--  validDate()                      -                   check the date is valid and in the future
--
------------------------------------------------------------------------

-- Initialise variables
!globalProject = !!admControl.isValid('Global')
if (!globalProject) then
   !hubLocation  = !!glbHubStatus(!globalProject)
else
   !hubLocation  = false
endif

-- Define form
setup form !!admDb at xr 0.35 yr 0.1 resize

  !!admDb.formTitle     = 'admDb Definition'
  !!admDb.iconTitle     = 'DB'
  !!admDb.callback      = '!this.init()'
  !!admDb.formRevision  = ' $Revision: 1.42 $ '

  -- Body of form definition

  para   .dbNameTx                anchor top+left at xmin        y0.2     text |Database :|
  para   .dbName                  anchor top+left at xmin+1      ymax                                           width 44 line 1

  frame .teamFrame anchor all |Owning Team|  at x 0         ymax.dbName+0.2

    list   .projTeams  anchor all at xmin+1      ymin+1   call |!this.teamSel(!this.projTeams)| columns width 46 height 10
    path down
    halign left
    option .sort     anchor bottom+left tagwid 9 |Sort by:|                          call |!this.teamArrList()|            width 12
    text   .filter   anchor bottom+left tagwid 8 |Filter: |   at xmax+1     ymin.sort call |!this.teamArrList()|            width 14 STRING

  exit

  text   .name   anchor bottom+left+right tagwid 12 |Name:        |  at x 2         ymax+0.5 call |!this.cbName(!this.name)|       width 32 scroll 49 NAME

--  text   .desc   tagwid 12 |Description: |  at xmin        ymax+0.2                                       width 32 scroll 120 STRING

  para   .dbdesc           anchor bottom+left            at xmin       ymax0.2     text |Description:|
  textpane   .desc         anchor bottom+left+right | |  at xmin+12      ymax.dbdesc-1                                   width 33 height 3

  option .type        anchor bottom+left tagwid 12 |Database Type:|  at xmin.dbdesc  ymax+0.3 call |!this.cbType()|        width 17
  option .elementType anchor bottom+left tagwid 12 |Element Type:|   at xmin         ymax+.3  call |!this.setElementType()|  width 17

  text   .dbElem anchor bottom+left+right tagwid 12 |DB Element Name:|  at xmin.elementType       ymax+0.2                                       width 32 scroll 120 STRING

  option .access anchor bottom+left tagwid 12 |Access Mode: |     at xmin        ymax+0.2 call |!this.access()|                 width 11
  option .claim  anchor bottom+left                               at xmax+1      ymin                                           width 15
  toggle .controlled anchor bottom+left |Controlled| at xmin.desc    ymax+0.2
  toggle .refOnly anchor bottom+left |Reference Only| at xmax.controlled+0.2 ymin.controlled call |!this.cbRefOnly()|
  toggle .protected  anchor bottom+left |Protected|  at xmin.access  ymax+0.2
  path right
  toggle .expires  anchor bottom+left |Expires| at xmin.controlled tagwid 10
   option .day     anchor bottom+left width 2
    option .month  anchor bottom+left  width 3
    option .year   anchor bottom+left  width 4
  path right

  text   .area    anchor bottom+left tagwid 12 |Area Number:| at xmin.protected  ymax+0.2 call |!!admChkDbArea(!this.area.val,!this.area,!this.refGet())|    width 10 INTEGER min 0 max 999
  button .areaDef anchor bottom+left |System|        at xmax+1     ymin     call |!!admChkDbArea('SYS',!this.area,!this.refGet())|
  text   .dbNo    anchor bottom+left tagwid 12 |DB Number:  | at xmin.protected  ymax+0.2 call |!!admChkDbDbno(!this.dbNo.val, !this.dbNo)|                  width 10 INTEGER min 1 max 255000
  button .dbNoDef anchor bottom+left |System|        at xmax+1     ymin     call |!!admChkDbDbno('SYS', !this.dbNo)|
  button .dbNoUniq anchor bottom+left |Project |      at xmax+2     ymin     call |!!admChkDbDbno('UNI', !this.dbNo)|
  text   .fino    anchor bottom+left tagwid 12 |File Number:| at xmin.protected  ymax+0.2 call |!this.cbFino(!this.fino.val)|                                width 10 INTEGER min 1 max 8188
  button .finoDef anchor bottom+left |System|        at xmax+1     ymin     call |!this.cbFino('SYS')|
  button .changeDbPass anchor bottom+left at xmin.protected ymax+0.2 |Set/Reset Password| call |!this.showDbPassDialog()| width 15
  button .deleteDbPass anchor bottom+right at xmax+1 ymin.changeDbPass |Delete Password| call |!this.showGetDbPassDialog('DELPASS')| width 14
   -- Gadgets for a Global Project
  if (!globalProject) then

    text   .primary anchor bottom+left tagwid 12 |Primary Loc.:|    at xmin.name  ymax+0.3  call |!this.loc(!this.primary.val)| width 30 NAME

      button .priBtn  anchor bottom+left at xmax+0.2 ymin pixmap width 16 height 16 call |!!glbDbPri.infoInit(!this)|

    frame .distTx |Propagate| anchor bottom+left  at xmin.teamFrame ymax.primary+0.2 width 50
      toggle    .distDb  anchor bottom+left |Database|      at xmin+2 ymax
      toggle    .picture anchor bottom+left |Picture/Neutral Format Files| at xmin.distDb    ymax



      toggle .linkDocuments anchor bottom+left |Link Documents (Only on Design Databases)| at xmin.distDb ymax anchor b+l+r
    exit

  endif



  -- Bottom Line
  button .apply   anchor bottom+left |Apply|   at xmin form-0          ymax+0.5      call |!this.cbApply()| APPLY
  button .reset   anchor bottom |Reset|   at xcen form-0.5 * size ymin call |!this.init()|
  button .dismiss anchor bottom+right |Dismiss| at xmax form-size       ymin CANCEL

  -- Mode
  option .mode  anchor top+right at xmax form-size       ymin.dbNameTx call |!this.mode()| width 6

  -- Member definitions
  -- Active database DBREF
  member .dbRef        is DBREF

  -- Owning team
  member .team         is DBREF

  -- Project Teams
  member .teamArray    is ARRAY

  -- Primary Location
  if(!globalProject) then
    member .primaryLoc is DBREF
  endif

  --  Members to store sort and filter values
  member .filterVal    is STRING
  member .sortVal      is STRING
  member .fromDialog   is ARRAY
  member .fromDialog2   is ARRAY
exit
-- End of form definition for !!admDb

----------------------------------------------------------------------
--
-- Method:      admDb
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .admDb()

  -- Initialise Variables

   !type  = !this.type.selection('rtext')

   if (!type neq 'ENGI') then
     !this.elementType.active = false
   endif


  -- Global Project
  if(!!admControl.isValid('Global')) then

    -- Are we at the hub
    !hubLocation   = !!glbHubStatus(!!admControl.isValid('Global'))

    -- If at hub set pixmap
    if(!hubLocation) then
      !this.priBtn.addPixmap(!!pml.getPathName('popup16.png'))
    endif

  -- None Global project
  else
    !hubLocation   = false
  endif

  -- Assign Mode gadget values
  !dText           = ARRAY()
  !rText           = ARRAY()
  !dText.append(|Create|)
  !rText.append(|CREATE|)
  !dText.append(|Modify|)
  !rText.append(|MODIFY|)

  !this.mode.dText = !dText
  !this.mode.rText = !rText

  -- Assign Database type gadget values
  !!admTypeDbLoad(!this.type)

  -- Assign sort gadget values
  !!admTeamSortGadg(!this.sort)

  -- Assign filter gadget value
  !this.filter.val   = |*|

  -- Assign area gadget value
  !this.area.val     = |Set by System|

  -- Assign access mode gadget values
  !dText.clear()
  !rText.clear()
  !dText.append(|Multiwrite|)
  !rText.append(|Multiwrite|)
  !dText.append(|Update|)
  !rText.append(|Update|)
  --!dText.append(|Controlled|)
  --!rText.append(|Controlled|)

  !this.access.dText = !dText
  !this.access.rText = !rText

  -- Assign claim mode gadget values
  !dText.clear()
  !rText.clear()
  !dText.append(|Implicit Claim|)
  !rText.append(|IMPLICIT|)
  !dText.append(|Explicit Claim|)
  !rText.append(|EXPLICIT|)

  !this.claim.dText  = !dText
  !this.claim.rText  = !rText

  -- Assign picture file gadget values
  if(!!admControl.isValid('Global')) then
    !this.distDb.val  = true
    !this.picture.val = false

		if (!this.isGlobalHub()) then
	    !glocwl = /*GL
			!linkDocumentsState    = !glocwl.gLinkPropagation
			
	    !this.linkDocuments.val = !linkDocumentsState
	  endif
  endif

  !this.expires.callback      = |!this.expires()|
  !this.protected.callback    = |!this.protected()|
  !this.day.callback          = |!this.validDate()|
  !this.month.callback        = |!this.validDate()|
  !this.year.callback         = |!this.validDate()|
  !this.setupDate()
endmethod
-- End of method definition

------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: create or modify a DB element. The values method . the element
-- are taken from the DB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbApply()

  -- Initialise variables
  !dbRef      = !this.refGet()
  !owner      = !this.teamGet()
  !mode       = !this.modeGet()
  !dbCreate   = ''
  !updateFlag = false

  -- Check that the team is set
  if (!owner.unset()) then

    -- Raise error
    !!messageFile.error(141, 151, !mode.lowcase())

  endif

  -- Check that the team is valid
  if (!owner.badRef()) then

    -- Team does not exist
      !!messageFile.error(141, 3, !!messageFile.messageString(141, 803), !owner.string())
    handle (06, 003)
      -- Dummy handle
    endhandle

    -- Reset values
    !this.teamSet(object DBREF())
    _dbName.val     = |unset|& !this.name.val
    !this.teamArrList()
    return

  endif

  -- Check that the Database Name is set
  if (!this.name.val eq 'unset') then

    -- Reset the name if modify mode
    if (!mode eq 'MODIFY') then
      !this.name.val         = !dbRef.name.substring(3).after('/')
    endif

    -- Raise error
    !this.name.setFocus()
    !!messageFile.error(141, 152, !mode.lowcase())

  endif

  -- Action attributes based on mode
  if (!mode eq 'CREATE') then

    !this.dbElem.active = FALSE

    -- Gather attribute values
    !dbName      = !owner.name.substring(3) +|/|+ !this.name.val
    !dbType      = !this.type.selection('rtext')
    !description = !this.desc.line(1)
    !access      = !this.access.selection('rtext')

    if !this.dbElem.val neq 'unset' then

      if (!dbType eq 'DESI' ) then
        if (!this.refOnly.val) then
          !dbCreate = ' with SYGPWL /' + !this.dbElem.val
        else
          !dbCreate = ' with SITE /' + !this.dbElem.val
        endif
      elseif (!dbType eq 'PADD' ) then
        !dbCreate = ' with DEPT /' + !this.dbElem.val
      elseif (!dbType eq 'CATA' ) then
        !dbCreate = ' with CATA /' + !this.dbElem.val
      elseif (!dbType eq 'PROP' ) then
        !dbCreate = ' with CMPW /' + !this.dbElem.val
      elseif (!dbType eq 'SCHE' ) then
        !dbCreate = ' with  SCGROU /' + !this.dbElem.val
      elseif (!dbType eq 'ISOD' ) then
        !dbCreate = ' with  ISODEP /' + !this.dbElem.val
      elseif (!dbType eq 'DICT' ) then
        !dbCreate = ' with  UWRL /' + !this.dbElem.val
      elseif (!dbType eq 'ENGI' ) then
        if (!this.elementType.selection('rtext') eq 'ENGWLD') then
          !dbCreate = ' with  ENGWLD /' + !this.dbElem.val
        else
          !dbCreate = ' with  XPIWLD /' + !this.dbElem.val
        endif
      elseif (!dbType eq 'ALYS' ) then
          !dbCreate = ' with  HYSWLD /' + !this.dbElem.val
      endif

    endif

    -- Get the CLAIM value
    if (!access neq 'Update') then
      !claim       = | CLAIM |+ !this.claim.selection('rtext')
    else
      !claim       = ||
    endif

    -- Get the AREA value
    if (!this.area.val.trim() eq 'Set by System') then
      !area        = ||
    else
      !area        = | IN AREA |+ !this.area.val
    endif

    -- Get the DBNO value
    if (!this.dbNo.val.trim() eq 'Set by System') then
      !dbNo        = ||
    else
      !dbNo        = | DBNO |+ !this.dbNo.val
    endif

    -- Get the FINO value
    if (!this.fino.val.trim() eq 'Set by System') then
      !fino        = ||
    else
      !fino        = | FINO |+ !this.fino.val
    endif

    -- Get the controlled value
    if (!this.controlled.val) then
      !controlled  = | CONTROLLED |
    else
      !controlled  = ||
    endif

    if (!this.refOnly.val) then
      !refOnly = | REFONLY |
    else
      !refOnly = ||
    endif

    -- Get the protected value
    if (!this.protected.val) then
      !protected  = | PROTECTED |
      -- Get the expires value
      if (!this.expires.val) then
        !protected  =  !protected + | EXPIRES | + !this.day.selection() + ' ' + !this.month.selection() + ' ' + !this.year.selection()
      endif
    else
      !protected  = ||
    endif
-- Set database Password if required:
    if (!this.fromDialog.size() ne 0) then
		if (!this.fromDialog[1] ne 'NONE') then
		   !newPass = !this.fromDialog[3]
       !dbPass  = | PASSWORD '| + !newPass + |'|
		endif
    !this.fromDialog.clear()
    else
      !dbPass  = ||
    endif
    -- Transaction db has restrictions
    !transaction = false
    if (!dbType eq 'TRAN') then
      !transaction = true
    endif
    if (!transaction) then
      if (!owner.name.substring(3) neq 'TRANSACTION') then
         !!alert.error('A Transaction dB can only be created in the TRANSACTION Team')
         return
      endif
    else
      if (!owner.name.substring(3) eq 'TRANSACTION') then
         !!alert.error('The Transaction Team dB can only have Transaction dBs')
         return
      endif
    endif

    -- Name sequence db has restrictions
    !nameSequence = false
    if (!dbType eq 'NSEQ') then
      !nameSequence = true
    endif

    -- Construct the command
    if (!transaction) then
      !command      = |CREATE DB |+ !dbName +| |+ !area +| ACCESS |+ !access + !dbNo + !fino
    elseif (!nameSequence) then
      !command      = |CREATE DB |+ !dbName +| |+ !dbType + | ACCESS | + !access + !dbNo + !fino
    else
      !command      = |CREATE DB |+ !dbName +| |+ !dbType + !refOnly +| |+ !dbPass + !area + !controlled + !protected + | ACCESS | + !access + !claim + !dbNo + !fino + !dbCreate
    endif
    -- $P Command: $!command
    -- Execute the command
    call !!admCommand(!command)
    handle (1,4)

      -- Db Already exists
      !!messageFile.error(141, 153, !dbName)

    elsehandle (1,15)

      -- Maximum number of databases reached
      !!messageFile.error(141, 154)

    elsehandle (1,17)

      -- File already exists
      !!messageFile.error(141, 155)

    elsehandle (1,19)

      -- Cannot open virgin database
      !!messageFile.error(141, 156, !dbType)

    elsehandle (1,35)

      -- Area does not exist
      !!messageFile.error(141, 157, !this.area.val)
      !this.area.val     = |Set by System|

    elsehandle (1,249)

      -- File number already exists
      !!messageFile.error(141, 158, !!messageFile.messageString(141, 806), !this.fino.val)
      !this.fino.val     = !dbRef.nxtfdb

    elsehandle (1,253)

      -- DBNO already allocated
      !!messageFile.error(141, 158, !!messageFile.messageString(141, 805), !this.dbNo.val)
      !this.dbNo.val     = !dbRef.nxtfdb

    elsehandle ANY
      !!alert.error(!!error.text)
      return

    endhandle
    -- Navigate to the new DB
    !dbName       = |/*|+ !dbName
    !!ce          = !dbName.dbRef()
    -- Set the database description
    if (!description neq 'unset' and !this.desc.active) then
      -- converts the textpane array to a string
      !descriptionValues = ''
      !descriptionString       = !this.desc.val
      do !i values !descriptionString
        !descriptionValues = !descriptionValues & | | & !i
      enddo
      !description  = !descriptionValues.substring(2)
      !!ce.description = !description
    endif

    -- Set the update flag
    !updateFlag   = true
    !dbRef        = !!ce
    !!adminElem.dbSet(!!ce)

  elseif (!mode eq 'MODIFY') then

    -- Check for element being already claimed
    if (not !!dbRefUpdate (!dbRef)) then
      !!alert.error (!!error.text)
      return
    endif

    -- Modify the database
    -- Generate new attributes
    !dbName       = !owner.name.substring(3) +|/|+ !this.name.val
    -- converts the textpane array to a string
    !descriptionValues = ''
    !descriptionString       = !this.desc.val
    do !i values !descriptionString
      !descriptionValues = !descriptionValues & | | & !i
    enddo
    !description  = !descriptionValues.substring(2)
    !access       = !this.access.selection('rtext')
    !claim        = !this.claim.selection('rtext')
    !controlled   = !this.controlled.val
    !protected   =  !this.protected.val
    if (!this.area.val.trim() eq 'Set by System') then
      !area         = 0
    else
      !area         = !this.area.val.real()
    endif
    if (!this.fino.val.trim() eq 'Set by System') then
      !fino         = 0
    else
      !fino         = !this.fino.val.real()
    endif

    -- Navigate to the database
    !!ce           = !dbRef
    -- Change the name
    if (!dbRef.name.substring(3) neq !dbName) then

      -- Modify the database name
      !command       = |CNAME DB |+ !dbRef.name.substring(3) +| |+ !dbName
      call !!admCommand(!command)
      handle (1,4)

        -- Database name already exists
        !answer = !!alert.confirm(!!messageFile.messageString(141,175, !dbName))
        if (!answer.boolean()) then
          call !!admCommand( !command + ' OVER' )
          handle (1,427) (1,4)
            -- Database is primary at a satellite
            !this.name.val      = !dbRef.name.substring(3).after('/')
            !this.dbName.val    = !dbRef.owner.owner.name.substring(3) +|/|+ !this.name.val
            !this.projTeams.select('rtext',!dbRef.owner.owner.string())
            !!messageFile.error(141, 556, !dbRef.name.substring(3), !dbName)
            !this.name.setFocus()
          elsehandle (1,356)
            !!alert.error('You cannot replace an extract database or a database owning extracts')
            !this.name.setFocus()
            return
          endhandle
        else
          !this.name.val      = !dbRef.name.substring(3).after('/')
          !this.dbName.val    = !owner.name.substring(3) +|/|+ !this.name.val
          !this.name.setFocus()
          return
        endif

      endhandle

      -- Set the update flag
      !updateFlag    = true
      !dbName        = !dbRef.name.substring(3)

    endif

    -- Change the description
    if (!description neq 'unset' and !this.desc.active) then

      -- Modify the description
      !!ce.description = !description

      -- Set the update flag
      !updateFlag    = true

    endif
    -- Set/Reset database Password if required:
    if (!this.fromDialog.size() ne 0) then
		if (!this.fromDialog[1] ne 'NONE') then
			 !oldPass = !this.fromDialog[2]
			 !newPass = !this.fromDialog[3]
			 !prevRef = !!ce
			 !!ce     = !dbRef
			 !dbName  = !dbRef.name.substring(3)
			 !command = |CHANGE | + !dbName +| VERIFY '| + !oldPass + |' PASSWORD '| +  !newPass + |'|
			  call !!admCommand(!command)
			  handle (2, 173)
	--         !!alert.error(!!error.text)
	--          -- Password validation failed.
	           !!alert.error('The current Database password you entered is incorrect. Database password not changed')
			  endhandle
       if (!this.lPassGet() eq true) then
   			 	 !this.deleteDbPass.active = true
			 else
   			 	!this.deleteDbPass.active = false
			 endif
			 !!ce     = !prevRef
		endif
		!this.fromDialog.clear()
		if (defined (!!changeDbPass)) then
			  kill !!changeDbPass
	  endif
    endif

     if (!this.lPassGet() eq true ) then

       if (!this.fromDialog2.size() ne 0) then
	      if (!this.fromDialog2[1] eq 'VALID') then
	         if (!this.fromDialog2[3] eq 'DELPASS') then
			        !currPass = !this.fromDialog2[2]
			        !prevRef = !!ce
			        !!ce     = !dbRef
			        !dbName  = !dbRef.name.substring(3)
			        !command = |CHANGE | + !dbName +| VERIFY '| + !currPass + |' PASSWORD DELETE|
			        call !!admCommand(!command)
			        handle (2, 173)
		               !!alert.error('The current Database password you entered is incorrect. Database password not deleted')
			        endhandle
              if (!this.lPassGet() eq true) then
   			 	       !this.deleteDbPass.active = true
			        else
   			 	       !this.deleteDbPass.active = false
			        endif
			        !!ce     = !prevRef
			        !this.fromDialog2.clear()
			        if (defined (!!getDbPass)) then
			           kill !!getDbPass
			        endif
		       endif
		   endif
		
      endif
    endif

    -- Change the access
    if (!access neq !dbRef.accessDb) then

      -- Change the access mode
      !dbName       = !dbRef.name.substring(3)
      !command      = |CHANGE |+ !dbName +| ACCESS |+ !access
      call !!admCommand(!command)
      handle (1,267)

        -- Database in use
        !!messageFile.error(141, 183, !dbName, !!error.text.part(-1))
        handle (06, 183)
          -- Dummy handle
        endhandle

      elsehandle none

        -- Set the update flag
        !updateFlag    = true

      endhandle

    endif

    -- Change the Claim mode if applicable
    if (!dbRef.accessDb eq 'Multiwrite' or !dbRef.accessDb eq 'Controlled') then

        !changeClaim = !dbRef.claimDb.unset()
        if( !changeClaim.not() ) then
          !changeClaim = (!claim.upcase() neq !dbRef.claimDb.upcase())
        endif
        if ( !changeClaim ) then

        --  Modify the claim mode
        !dbName       = !dbRef.name.substring(3)
        !command      = |CHANGE |+ !dbName +| CLAIM |+ !claim
        call !!admCommand(!command)
        handle (1,70)
          -- Already in claim mode, take no action
        endhandle

      endif

    endif

    -- Change lCtrol if required
    if( !controlled ne !dbRef.lCtrol ) then
      !prevRef = !!ce
      !!ce     = !dbRef
      !command = |LCTROL | + !controlled.string()
      call !!admCommand(!command)
      handle any
        !!alert.error(!!error.text)
      endhandle
      !!ce     = !prevRef
    endif

    -- Change Protection if required
    !prevRef = !!ce
    !!ce     = !dbRef
    !dbName  = !dbRef.name.substring(3)
    if ( !protected ) then
      !protValOnOff = | ON |
      if (!this.expires.val) then
        !expires = | EXPIRES | + !this.day.selection() + ' ' + !this.month.selection() + ' ' + !this.year.selection()
      else
        !expires = ||
      endif
    else
      !protValOnOff = | OFF|
      !expires = ||
    endif
    !verify = ||
    if ((!this.lPassGet() eq true) and (!dbRef.lprot eq true) and (!protected eq false)) then

       if (!this.fromDialog2.size() ne 0) then
	       if (!this.fromDialog2[1] eq 'VALID') then
			     !currPass = !this.fromDialog2[2]
			     !verify = | VERIFY '| + !currPass + |' |
		     endif
		     !this.fromDialog2.clear()
       endif
    endif

    if (!mode eq 'MODIFY' and !this.dbRef.isprim eq false ) then
       -- P-20307 - Do not change protection on non-primary db (Gadget is also disabled)
    else
       !command = |CHANGE | + !dbName + !verify + | PROTECTED|+ !protValOnOff + !expires
       call !!admCommand(!command)
       handle (1, 793)
         !!alert.error(!!error.text)
         !this.protected.val = !dbRef.lprot
       elsehandle any
         !!alert.error(!!error.text)
       endhandle
    endif
    !!ce     = !prevRef
    -- Change the database area
    if (!area neq !dbRef.area) then

      -- Move the database area
      !dbName       = !dbRef.name.substring(3)
      !command      = |MOVE DB |+ !dbName +| TO AREA |+ !area.string()
      call !!admCommand(!command)
      handle (1,18)

        -- Cannot open new database file
        if (!dbRef.area eq 0) then
          !this.area.val = |Set by System|
        else
          !this.area.val = !dbRef.area.string()
        endif

        -- Raise error
        !!messageFile.message(141, 163, !area.string())
      endhandle

    endif

    -- Change the file number to the new numbering system
    if (!fino neq !dbRef.fino) then

      -- Move the database area
      !dbName       = !dbRef.name.substring(3)
      !command      = |CHANGE |+ !dbName +| FINO |+ !fino.string()
      call !!admCommand(!command)
      handle any
        -- Raise error
        !!alert.error(!!error.text)
      endhandle

    endif

  endif

  -- Perform Global actions. These are the same for CREATE or MODIFY
  if (!!admControl.isValid('Global')) then

		-- Get Db Type
		!typeDb = !!ce.typeDb
    !dbAccessType = !!ce.accessDb
		
	
    -- Navigate to the database DBLOC
    !!ce     = !dbRef
    DBLOC 1

    -- Check for element being already claimed
    if (not !!ce.okClaim and not !!ce.lclm) then
      !!messageFile.error (141,30)
      return
    endif

    -- Set the distribution flags
    if( !dbAccessType.upcase() neq 'OVERWRITE' ) then
      -- Overwrite DBs are non-propagating always

      if (!this.distDb.val neq !!ce.propg) then
        !command  = |PROPG |+ !this.distDb.val.string()
        call !!admCommand(!command)
      endif
    endif
    if (!this.picture.active and !this.picture.val neq !!ce.picfd) then
      !command  = |PICFD |+ !this.picture.val.string()
      call !!admCommand(!command)
    endif

		if (!this.isGlobalHub()) then
	    if (!typeDb eq 'DESI') then
	    	-- NOLNKP True if Propagation NOT required
	    	!!ce.noLnkPropagation = !this.linkDocuments.val.not()
		  endif
		endif

    -- Set primary location
    !primary  = !this.locGet()
    if (!primary neq !!ce.locRf) then

      if (!mode eq 'CREATE' and !primary.iconn.boolean()) then

        if (!dbRef.typeDb neq 'TRAN') then

          -- Allocate database as primary (on-line location)
          !command  = |ALLOCATE |+ !dbRef.name.substring(3) +| PRIMARY AT |+ !primary.name
          call !!admCommand(!command)
          handle any

            -- Allocation failed
              !!messageFile.error(141, 523, !dbRef.name.substring(3), !!error.text)
            handle (06, 523)
              !!messageFile.message(141, 544)
            endhandle

          endhandle

        endif

      elseif (!mode eq 'CREATE' and not !primary.iconn.boolean()) then

        if (!dbRef.typeDb neq 'TRAN') then

          -- Offline location
          !command  = |ALLOCATE |+ !dbRef.name.substring(3) +| AT |+ !primary.name
          call !!admCommand(!command)
          handle any

            -- Allocation failed
            !!messageFile.error(141, 523, !dbRef.name.substring(3), !!error.text)
            handle (06, 523)
              !!messageFile.message(141, 544)
            endhandle

          elsehandle none

            -- Allocation succeeded, now change primary
            !command  = |CHANGE |+ !dbRef.name.substring(3) +| PRIMARY AT |+ !primary.nam
            call !!admCommand(!command)
            handle any

              -- Failed to change primary
                !!messageFile.error(141, 545, !dbRef.name.substring(3), !!error.text)
              handle (06, 545)
                -- Dummy handle
              endhandle

            elsehandle none
              !updateFlag = true
            endhandle

          endhandle

        endif

      else

        -- (Modify mode) Change primary location
        !command  = |CHANGE |+ !dbRef.name.substring(3) +| PRIMARY AT |+ !primary.name
        call !!admCommand(!command)
        handle any

          -- Failed to change primary
              !!messageFile.error(141, 545, !dbRef.name.substring(3), !!error.text)
          handle (06, 545)
            -- Dummy handle
          endhandle

        elsehandle none
          !updateFlag = true
        endhandle

      endif

    endif

  endif

  -- Update forms if required
  if (!updateFlag) then
    !!adminElem.update('DB')
    !this.update()
  endif

  -- Reset the form if create mode
  if (!mode eq 'CREATE') then
    !this.init()
  endif

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
--Method: .access()
--
-- Description: acts as callback to Access gadget in the DB Definition form.
-- Controls claim mode gadget based on access mode selected.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .access()

  -- Initialise variables
  !dbRef   = !this.refGet()
  !dText   = ARRAY()
  !rText   = ARRAY()

  -- Check the access mode
  if (!this.access.selection('rtext') eq 'Multiwrite') then

    -- Set claim modes
    !dText.append(|Implicit Claim|)
    !dText.append(|Explicit Claim|)
    !this.claim.dText   = !dText
    !dText.clear()
    !rText.append(|IMPLICIT|)
    !rText.append(|EXPLICIT|)
    !this.claim.rText   = !rText
    !rText.clear()

    -- Enable claim mode
    !this.claim.active   = true

--    elseif (!this.access.selection('rtext') eq 'Controlled') then
--
--     -- Set claim modes
--     !dText.append(|Implicit Claim|)
--     !dText.append(|Explicit Claim|)
--     !dText.append(|Off|)
--     !this.claim.dText   = !dText
--     !dText.clear()
--     !rText.append(|IMPLICIT|)
--     !rText.append(|EXPLICIT|)
--     !rText.append(|OFF|)
--     !this.claim.rText   = !rText
--     !rText.clear()
--
--     -- Enable claim mode
--     !this.claim.active   = true

  else

    -- Disable claim mode
    !this.claim.active   = false

  endif

  -- Set the claim if possible
  if (!dbRef.set()) then
    if (!dbRef.claimDb.set()) then
      !this.claim.select('rtext', !dbRef.claimDb.upcase())
      handle any
        -- Dummy handle
      endhandle
    endif
  endif

endmethod
-- End of method definition for .access()

------------------------------------------------------------------------
--
--Method: .display()
--
-- Description: display the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display from in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display(!mode is STRING)

  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY') then

    -- Invalid mode
    return error |Invalid mode for form !this.|

  endif

  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then

    !this.refSet(object DBREF())

  elseif (!mode eq 'MODIFY') then

    --Get the current MDB from
    !dbRef    = !!adminElem.dbGet()

    if (!dbRef.unset()) then

      -- No action required
      return

    elseif (!dbRef eq !this.refGet() and !this.shown()) then

      -- No action required
      return

    elseif (!dbRef.badRef()) then

      -- Raise an error
      !!messageFile.error(141, 160, !dbRef.string())
      handle (06, 160)
        !!adminElem.update('DB')
        return
      endhandle

    elseif (!dbRef.foreign eq 'FOREIGN') then

      -- Cannot modify foreign databases
      !!messageFile.error(141, 161, !dbRef.name.substring(3))
      handle (06, 161)
        if (!this.refGet().unset()) then
          !this.modeSet('CREATE')
        endif
      endhandle
      return

    -- Check for element being already claimed

    elseif (not !!dbRefUpdatable (!dbRef)) then
      !!alert.error (!!error.text)
      return

    endif

    -- Set the new reference to modify
    !this.refSet(!dbRef)
    !this.teamSet(!dbRef.owner.owner)
  endif

  -- Select the mode
  !this.modeSet(!mode.upcase())

  -- Show or update the form
  if (!!admDb.shown()) then

    -- Re-initialise the form
    !this.init()

  else

    -- Show the form
    show !!admDb free

  endif

endmethod
-- End of method definition for .display(STRING)

------------------------------------------------------------------------
--
-- Method: .cbFino
--
-- Description: Callback for the database file number gadget, and the reset button.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Value to assign
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbFino(!value is STRING)

  !teamWorld = !!dbrAdminGetWorld('TEAM')

  -- Check to see if values is to be system generated
  if (!value eq 'SYS') then

    -- Reset to default area
    !this.fino.val   = |Set by System|
    !systemNumber = !teamWorld.nxtfdb.string()
    !!alert.message(|The next available DB file number is | & !systemNumber & |. However, if 'System' is used then the $
number will be the same as the DB number followed by _0001|)
    return

  endif

  -- Check that the passed value can be numeric
  !fileNumber   = !value.real()
  handle (2,441)

    -- Unable to convert value
    !this.fino.val    = 'Set by System'
    !!messageFile.error(141, 10, !!messageFile.messageString(141, 802))
    return

  endhandle

  -- Catch unset value which is caught in above handle
  if (!fileNumber.unset()) then
    !this.fino.val   = |Set by System|
    !!messageFile.error(61, 573)
    return
  endif

  -- Collect databases in the project
  if (!fileNumber lt 100) then
    !maskValue      = |000| + !fileNumber.string()
    !maskValue      = !maskValue.substring(-3,3)
  else
    !maskValue      = !fileNumber.string()
  endif
  !expression     = 'substring(file,14,9) eq |'& !maskValue &'|'
  !databases      = !!collectAllFor('DB',!expression,!teamWorld)

  -- Check no other database exist with this number
  if (!databases.unset()) then

    -- Value is unique
    !this.fino.val    = !fileNumber.string()

  else

    -- Process the list of dbs to check that any are local
    do !db values !databases

      if (!db.foreign eq 'LOCAL') then

        -- Not unique number within local project
        !this.fino.val    = 'Set by System'
        !!messageFile.error(141, 174, !fileNumber.string())
        break

      endif

    enddo

  endif

endmethod
-- End of method definition for .cbFino(STRING)

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: initialise the DB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Kill off calling form!
  !!adminElemDb.hide()
  handle (2,751)
  endhandle

  -- Initialise variables
  !mode              = !this.modeGet()
  !dbRef             = !this.refGet()

  !globalProject     = !!admControl.isValid('Global')
  if (!globalProject) then
    !hubLocation  = !!glbHubStatus(!globalProject)
  else
    !hubLocation  = false
  endif

  !this.name.setFocus()

  -- Reinstate the sort and filter gadgets
  if (!this.filterVal.set()) then
    !this.filter.val = !this.filterVal
  endif

  if (!this.sortVal.set()) then
    !this.sort.select('rtext',!this.sortVal)
  endif

  -- set apply and other gadgets active in case the last operation disabled it
  !this.apply.active      = true
  !this.controlled.active = true
  !this.refOnly.active = true
  !this.protected.active = true
  !this.access.active     = true

  -- set up the access modes option menu
  !this.access.clear()
  !rText              = ARRAY()
  !dText              = ARRAY()
  !dText[1]           = |Multiwrite|
  !dText[2]           = |Update|
  !rText[1]           = |Multiwrite|
  !rText[2]           = |Update|
  !this.access.dText  = !dText
  !this.access.rText  = !rText

  -- Set form gadget according to mode
  if (!mode eq 'CREATE') then

    !this.dbElem.active = TRUE

    -- Update the type and access gadgets
    !this.cbType()

    !this.formTitle      = |Create Database|
    !this.name.val       = |unset|
    !s[1] = |unset|
    do !i from 2 to !s.size()
      !s[!i]= '$!s'
    enddo
    !this.desc.val       = !s
    !description = !this.desc.val
    !this.dbElem.val       = |unset|
    !this.dbNo.val       = 'Set by System'
    !this.fino.val       = 'Set by System'
    !this.controlled.val = false
    !this.refOnly.val = false
    !this.protected.val = false

    -- Set gadgets active
    !this.type.active    = true
    !this.dbNo.active    = true
    !this.dbNoUniq.active    = true
    !this.dbNoDef.active = true
    !this.fino.active    = true
    !this.finoDef.active = true
    !this.controlled.active = true
    !this.refOnly.active = true
    !this.protected.active = true

    -- Initialise the current time
    !timeNow = object DATETIME()
    !this.day.val        = !timeNow.date().string()
    !this.month.val      = !timeNow.month()
    !this.year.val       = !timeNow.year().string()
    !this.expires.active = FALSE
    !this.expires.val    = FALSE
    !this.day.active     = FALSE
    !this.month.active   = FALSE
    !this.year.active    = FALSE

    -- Set Global Attributes
    if (!globalProject) then
      !currentLocation = CURLOC
      !primary               = !!dbrGlbHubLocRf()
      !this.locSet(!primary)
      !this.primary.val    = !primary.name.substring(2)
      if (!this.isGlobalHub()) then
        !this.priBtn.visible  = TRUE
        !this.primary.active = TRUE
      else
        !this.primary.active = FALSE
        !this.priBtn.visible = FALSE
      endif

			if (!this.isGlobalHub()) then
	      !glocwl = object DBREF('/*GL')
	      if (!glocwl.set()) then
		      if (!glocwl.gLinkPropagation) then
		      	-- Check Database Type drop down list
		      	!this.linkDocuments.active = !this.type.selection('rtext') eq 'DESI'
						!this.linkDocuments.tag = 'Link Documents (Only on Design Databases)'
		      else
		      	!this.linkDocuments.active = false
		      	!this.linkDocuments.tag = 'Link Documents (Currently Disabled on Project)'
					endif
				endif
      endif

      -- Only at the Hub
      if (!currentLocation.locid eq !primary.locid) then
        -- If there is not a transaction team at this stage we must create one
        !unusedTestForTransaction = object TEAM('TRANSACTION')
        handle ANY
          -- Create the transaction team command
          !commandCreateTransactionTeam = 'CREATE TEAM TRANSACTION'
          -- Create the transaction team
          call !!admCommand(!commandCreateTransactionTeam)
          handle ANY
            -- No error should occur but just in case
          endhandle
        endhandle
      endif

    endif
  !this.deleteDbPass.active = false
  !this.changeDbPass.active = true
  			
  elseif (!mode eq 'MODIFY') then

    !this.dbElem.active = FALSE
    !this.dbElem.tag    = ''
	!this.dbElem.val    = ''

    !this.type.select('rtext',!dbRef.typeDb)
    if (!dbRef.claimDb.set()) then
      !this.claim.select('rtext', !dbRef.claimDb.upcase())
    endif
    -- Update the type and access gadgets
    !this.cbType()

    -- set controlled button to controlled state of the DB
    !this.controlled.val = !dbRef.lCtrol

    !dbAccessType = !dbRef.accessDb
    if( !dbAccessType.upcase() eq 'CONTROLLED' ) then
      !!alert.warning('Controlled type databases are no longer supported. Use the Access Control buttons on the form to change the access type to the new controlled multiwrite or controlled update types')
      !this.access.select('dtext','Multiwrite')

    elseif ( !dbRef.typeDb neq 'TRAN' ) then
    	-- Do not select Access type for TRAN dbs
      !this.access.select('dtext',!dbRef.accessDb)
    endif

    -- set Reference Only toggle, but NO modification
    !this.refOnly.active = FALSE
    !this.refOnly.val = !dbRef.lRefO

    -- set Protected toggle
    !this.protected.val = !dbRef.lprot

    -- find if expiry set
    if (!this.protected.val) then
      !expiry = !dbRef.expiry
      if (!expiry.unset() or !expiry eq '') then
        !this.expires.val    = FALSE
        !this.expires.active = TRUE
        -- Initialise the current time
        !timeNow = object DATETIME()
        !this.day.val        = !timeNow.date().string()
        !this.month.val      = !timeNow.month()
        !this.year.val       = !timeNow.year().string()
        !this.day.active     = FALSE
        !this.month.active   = FALSE
        !this.year.active    = FALSE
      else
        !this.expires.val    = TRUE
        !this.expires.active = FALSE
        !date = !expiry.split('-')
        !expireTime = object DATETIME(!date[1].real(),!date[2].real(),!date[3].real())
        !this.day.val        = !expireTime.date().string()
        !this.month.val      = !expireTime.month()
        !this.year.val       = !expireTime.year().string()
        !this.day.active     = TRUE
        !this.month.active   = TRUE
        !this.year.active    = TRUE

      endif
    else
      !this.expires.val    = FALSE
      !this.expires.active = FALSE
      !timeNow = object DATETIME()
      !this.day.val        = !timeNow.date().string()
      !this.month.val      = !timeNow.month()
      !this.year.val       = !timeNow.year().string()
      !this.day.active     = FALSE
      !this.month.active   = FALSE
      !this.year.active    = FALSE
    endif
    if (!this.lPassGet() eq true) then
   	   !this.deleteDbPass.active = true
    else
   	   !this.deleteDbPass.active = false
    endif
    -- find out whether this is a DB or an extract and set the access menu & form heading accordingly
    !extNo = !dbRef.extNo
    handle (2,805)
        -- do nothing
        !this.formTitle      = |Modify Database: | + !dbRef.name.substring(3)
    elsehandle none
      if(!extNo GT 1)then
        !this.formTitle      = |Modify Extract: |  + !dbRef.name.substring(3)
        -- Access mode of extracts cannot be changed
        !this.access.active  = false
        !this.deleteDbPass.active = false
        !this.changeDbPass.active = false
      else
        !this.formTitle      = |Modify Database: | + !dbRef.name.substring(3)
        -- check for any extracts. The mode cannot be changed if extracts exist
        !this.access.active  = !dbRef.extcls.empty()
        if (!this.lPassGet() eq true) then
   	      !this.deleteDbPass.active = true
        else
   	      !this.deleteDbPass.active = false
        endif
        !this.changeDbPass.active = true
      endif
    endhandle

    !this.name.val       = !dbRef.name.substring(3).after('/')

    if (!dbRef.description.empty()) then
      !s[1] = |unset|
     do !i from 2 to !s.size()
       !s[!i]= '$!s'
     enddo
     !this.desc.val       = !s
     !description = !this.desc.val
    else
      !dbTemp1 = ARRAY()
      !dbTemp1[1] = !dbRef.description
      !this.desc.val = !dbTemp1
    endif

    if (!dbRef.area eq 0) then
      !this.area.val     = |Set by System|
    else
      !this.area.val     = !dbRef.area.string()
    endif
    !this.dbNo.val       = !dbRef.dbNo.string()
    if(!dbRef.fino eq 0) then
      !this.fino.val     = |Set by System|
    else
      !this.fino.val     = !dbRef.fino.string()
    endif
    !this.type.select('rtext',!dbRef.typeDb)

    -- Set gadgets inactive
    !this.type.active    = false
    !this.dbNo.active    = false
    !this.dbNoUniq.active    = false
    !this.dbNoDef.active = false
    !this.fino.active    = false
    !this.finoDef.active = false

    -- Set Global Attributes
    if (!globalProject) then
      !!ce                   = !dbRef
      DBLOC 1
      if (!!ce.locRf.set()) then
        !this.locSet(!!ce.locRf)
        !this.primary.val    = !!ce.locRf.name.substring(2)
        if (!hubLocation) then
          !this.priBtn.visible  = TRUE
          !this.primary.active = TRUE
        else
          !this.priBtn.visible = FALSE
          !this.primary.active = FALSE
        endif
      else
        !this.locSet(!!ce.locRf)
        !!alert.warning('You cannot modify a transient database')
        !this.primary.val    = |Transient|
        !this.apply.active   = false
        !this.primary.active = false
        !this.priBtn.visible  = FALSE
        -- make sure that primary location form is not displayed
        if( defined( !!glbDbPri ) ) then
          if( !!glbDbPri.shown() ) then
            !!glbDbPri.hide()
          endif
        endif
      endif
      !this.distDb.val     = !!ce.propg
      !this.picture.val    = !!ce.picfd

			if (!this.isGlobalHub()) then
	      !glocwl = object DBREF('/*GL')
	      if (!glocwl.set()) then
		      if (!glocwl.gLinkPropagation) then
		      	!this.linkDocuments.active = !this.type.selection('rtext') eq 'DESI'
						!this.linkDocuments.tag = 'Link Documents (Only on Design Databases)'
		      else
		      	!this.linkDocuments.active = false
		      	!this.linkDocuments.tag = 'Link Documents (Currently Disabled on Project)'
					endif
					
					do !dbloc values !dbRef.members
	      		if (!dbloc.type eq 'DBLOC') then
	      			if (!dbloc.noLnkPropagation) then
	      				!this.linkDocuments.val = false
	      			else
	      				-- Only valid for DESI databases
                        if( !dbRef.typeDb eq 'DESI' ) then
                           !this.linkDocuments.val = true
                        else
                           !this.linkDocuments.val = false
                        endif
	      			endif
	      		endif
	      	enddo
				endif
			endif
			
    endif
  endif
  -- Display a message
  !!messageFile.prompt(141, 4, !this.formTitle, !!messageFile.messageString(141, 803))

  -- Gather the team information
  !this.teamArrSet()

  -- Update the list of teams
  !this.teamArrList()

  -- Dismiss the prompt
  !!prompt(0)

  -- Set the database name paragraph gadget
  !dbOwner  = !this.teamGet()
  if (!dbOwner.unset()) then
    !this.dbName.val  = |unset/|+ !this.name.val
  else
     !this.dbName.val  = !dbOwner.name.substring(3) + |/| + !this.name.val
  endif

  -- Run this to make sure transaction db rules are picked up
  !this.cbType()

  if (!this.fromDialog.size() ne 0) then
  	!this.fromDialog.clear()
  endif
  if (!this.fromDialog2.size() ne 0) then
  	!this.fromDialog2.clear()
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
--Method: .loc()
--
-- Description: Callback to Primary location gadget on the DB Definition form.
-- Gadget will accept Location NAME, DBREF or LOCID as a value.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Value for name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loc(!value is STRING)

  -- Initialise variables
  !curDbRef = !this.refGet()
  !curPrimLoc  = !this.locGet()

  -- See if the value starts with a '/'
  if (!value.substring(1,1) neq '/') then
    !name     = |/| + !value
  else
    !name     = !value
  endif

  -- See if the values can be navigated to
  !newLocDbRef    = !name.dbRef()
  handle any

    -- See if the value is the LOCID
    if (!value.length() neq 3) then

      -- Raise error
      !this.primary.val  = !curPrimLoc.name.substring(2)
      !!messageFile.error(141, 7, !value, 'LOC')

    endif

    !!ce      = !!dbrAdminGetWorld('LOC')
    !clause   = 'locid eq |'+ !value.upcase() +'|'
    !locN     = !!collectAllFor('LOC',!clause,!!ce)
    if (!locN.size() neq 1) then

      -- Raise error
      !this.primary.val  = !curPrimLoc.name.substring(2)
      !!messageFile.error(141, 7, !value, 'LOC')

    endif

    -- Found a location
    !newLocDbRef    = !locN[1]

  endhandle

  -- Return if value is already set
  if (!newLocDbRef eq !curPrimLoc) then
    return
  endif

  -- The entry can be found in the database
  -- Check that the element is of type LOC
  if (!newLocDbRef.type neq 'LOC') then

    -- Raise error
    !this.primary.val  = !curPrimLoc.name.substring(2)
    !!messageFile.error(141, 7, !newLocDbRef.name, !!messageFile.messageString(141, 815))

  endif

  -- Check that the element is initialised
  if (!newLocDbRef.lInit.boolean().not()) then

    -- Raise error
    !this.primary.val  = !curPrimLoc.name.substring(2)
    !!messageFile.error(141, 518, !newLocDbRef.name.substring(2))

  endif

  -- Check that the user is not trying an illegal move:-
  -- On-line Satellite   ->  Off-line satellite
  -- Off-line Satellite  ->  On-line satellite
  if (!curDbRef.set()) then

    !hubRef    = !!dbrGlbHubLocRf()
    !!ce       = !curDbRef
    DBLOC 1
    !curLocRef   = !!ce.locRf
    !onLine   = !!ce.locRf.iconn.boolean()
    if (!onLine) then

      -- Check move for on-line database from satellite to off-line
      if (!curLocRef neq !hubRef and not !newLocDbRef.iconn.boolean()) then
        -- Illegal change primary for an on-line db
        !this.primary.val  = !curPrimLoc.name.substring(2)
        !!messageFile.error(141, 547, !curLocRef.name.substring(2), !newLocDbRef.name.substring(2))
      endif

    elseif (not !onLine) then

      -- Check move for off-line database
      if (!newLocDbRef neq !hubRef) then
        -- Illegal change primary for off-line db
        !this.primary.val  = !curPrimLoc.name.substring(2)
        !!messageFile.error(141, 548, !curLocRef.name.substring(2), !newLocDbRef.name.substring(2))
      endif

    endif

    -- Output a warning to check that a db has been 'transferred to' if changing a dB primary here

    !onLine   = !newLocDbRef.iconn.boolean()
    if (!onLine.not()) then
      !!alert.warning('Please make sure the database has been allocated and transferred to the offline location$
 for this change primary command to succeed.')
    endif

  endif

  -- Element is valid so store the values
  !this.locSet(!newLocDbRef)
  !this.primary.val  = !newLocDbRef.name.substring(2)

endmethod
-- End of method definition for .loc(STRING)

------------------------------------------------------------------------
--
--Method: .locGet()
--
-- Description: return the DBREF of the current databases primary loc.
-- in the DB Definition form.
--
-- method Type:   method/Procedure
