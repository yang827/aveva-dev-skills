--
--
-- Description:
-- Form definition to provide facilities to copy DB elements.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   method to copy a source database to a new database.
--  cbName()                         -                   Callback to the Name gadget in the Copy Db form.
--  init()                           -                   method to initialise the Copy Db form.
--  prjTGet()                        ARRAY               method to return the array of project teams being used by
--  prjTList()                       -                   method to update the contents of the project teams list gadget on
--  prjTSet()                        -                   method to set the form member for the project teams in the Copy DB
--  refGet()                         DBREF               method to return the source DB DBREF for the element to be copied.
--  refSet(DBREF)                    -                   method to set the source DB DBREF for the Copy DB form.
--  refresh()                        -                   method to update the list of project teams displayed in the
--  teamGet()                        DBREF               method to return the target TEAM for a DB Copy command.
--  teamSel(GADGET)                  -                   Callback to Project Team list for user selection.
--  teamSet(DBREF)                   -                   method to set the form member to store the target TEAM for a
--

-- Define form
setup form !!admDbCpy at xr 0.35 yr 0.1

  !this.formTitle     = 'admDbCpy Database'
  !this.iconTitle     = 'COPYDB'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.13 $ '

  -- Body of form definition
  paragraph  .toTx at x 0 y 0 text |To Database |
  paragraph .to at xmax ymin width 30 line 1

  frame .teamFrame at xmin.toTx ymax+0.2 |Owning Team|

    list .projTeams at xmin+1 ymin+1 call |!this.teamSel(_projTeams)| columns width 45 height 10
    option .sort at xmin ymax |Sort| call |!this.prjTList()| width 12
    text .filter at xmax+1 ymin |Filter| call |!this.prjTList()| width 15 STRING

  exit

  text .name at xmin+2 ymax+0.5 |Name         | call |!this.cbName()| width 30 scroll 49 NAME
  text .desc at xmin ymax+0.2 |Description  | width 30 scroll 120 STRING
  text .area at xmin ymax+0.2 |Area Number  | call |!!admChkDbArea(_area.val,_area,_dbRef)| $
       width 10 INTEGER min 0 max 999
  button .areaDef at xmax+1 ymin |System| call |!!admChkDbArea('SYS',_area,_dbRef)|

  button .ok at xmin.toTx ymax+0.5 |  OK  | call |!this.cbApply()|  OK
  button .cancel at xmax form-size ymin |Cancel| CANCEL

  -- Member definitions
    -- Source database DBREF
    member .dbRef     is DBREF
    -- Project Teams
    member .teamArray is ARRAY
    -- Target Team
    member .team      is DBREF
    --  Members to store sort and filter values
    member .filterVal is STRING
    member .sortVal   is STRING

-- Assign sort gadget values
!!admTeamSortGadg(!this.sort)

-- Assign Filter Gadget values
!this.filter.val  = |*|

exit
-- End of form definition for !!admDbCpy


------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: method to copy a source database to a new database.
-- The new database will inherit all attributes (and contents)
-- from the source database.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbApply()

  -- Initialise variables
  !sourceDatabase  = !this.refGet()
  !sourceArea      = !sourceDatabase.area
  !targetTeam      = !this.teamGet()
  !targetTeamName  = !targetTeam.name.substring(3)
  !targetName      = !this.name.val
  !fullName        = |/*|+ !targetTeamName +|/|+ !targetName
  !description     = !this.desc.val
  if (!this.area.val.lowcase().trim() eq 'system') then
    !targetArea    = 0
  else
    !targetArea    = !this.area.val.real()
    handle ANY
      !!alert.error('Invalid input for Area Number')
      return
    endhandle
  endif

  -- Check for unset target name
  if (!targetName eq 'unset') then
     !!messageFile.error(141, 164)
  endif

  -- Create copy command
  if (!targetArea eq !sourceArea) then
    !command   = |COPY DB |+ !sourceDatabase.name.substring(3) + $
                 | TO |+ !targetTeamName +|/|+ !targetName
  else
    !command   = |COPY DB |+ !sourceDatabase.name.substring(3) + $
                 | TO |+ !targetTeamName +|/|+ !targetName +$
                 | TO AREA |+ !targetArea.string()
  endif

  -- Execute copy command
  call !!admCommand(!command)
  handle (1,4)

    -- Database already exists
    !!messageFile.error(141, 153, !targetName)

  elsehandle (1,7)

    -- Source database not found
    !!adminElem.update('DB')
    !!messageFile.error(141, 160, !sourceDatabase)

  elsehandle (1,15)

    -- Maximum number of databases reached
    !!messageFile.error(141, 154)

  elsehandle (1,18)

    -- Cannot open database file (Source)
   !!messageFile.error(141, 166, !sourceDatabase)

  elsehandle (1,20)

    -- Cannot open target database (Disk full?)
    !!messageFile.error(141, 167)

  elsehandle any

    -- Non specific
   !!messageFile.error(141, 168, !!error.text)

  endhandle

  -- Get the new DBREF
  !!ce        = !fullName.dbRef()
  !!adminElem.dbSet(!!ce)

  -- Copy command was a success so modify the description
  if (!description.empty() or !description eq 'unset') then
    !!ce.description = ||
  else
    !!ce.description = !description
  endif

  -- Update forms
  !!adminElem.update('DB')
  !!admDb.update()

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: method to initialise the Copy Db form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- Initialise variables
  !dbRef   = !!adminElem.dbGet()
  !team    = !dbRef.owner.owner

  -- Store DBREF values
  !this.refSet(!dbRef)
  !this.teamSet(!team)

  -- Set form values
  !this.formTitle  = |Copy Database: |+ !dbRef.name.substring(3)
  !this.name.val   = |unset|
  !this.to.val     = !team.name.substring(3) +|/unset|

  -- Set the description
  if (!dbRef.description.empty()) then
    !this.desc.val   = |unset|
  else
    !this.desc.val   = !dbRef.description
  endif

  -- Set the database area
  if (!dbRef.area eq 0) then
    !this.area.val   = |System|
  else
    !this.area.val   = !dbRef.area.string()
  endif

  -- Display a message
  !!messageFile.prompt(141, 4, !this.formTitle, $
            !!messageFile.messageString(141, 803))

  -- Gather the team information
  !this.prjTSet()

  -- Update the list of teams
  !this.prjTList()

  -- Dismiss the prompt
  !!prompt(0)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
--Method: .cbName()
--
-- Description: Callback to the Name gadget in the Copy Db form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbName()

  -- Initialise variables
  !targetTeam     = !this.teamGet()
  !targetName     = _name.val

  -- Check that name does not start with a '/'
  if (!targetName.substring(1,1) eq '/') then
    !targetName     = !targetName.substring(2)
    _name.val       = !targetName
  endif

  -- Check for unset value
  if (!targetName eq 'unset') then
    !this.to.val   = !targetTeam.name.substring(3) +|/unset|
    return
  endif

  -- Create new name
  !name           = |/*|+ !targetTeam.name.substring(3) +|/|+ !targetName

  -- Check the name
  !dbRef          = !name.dbRef()
  handle (2,109)

    -- Element name not used (good)
    !this.to.val   = !targetTeam.name.substring(3) +|/|+ !targetName
    !this.desc.setFocus()

  elsehandle none

    -- Element name already used (not good)
    -- Reset the value
    !this.to.val   = !targetTeam.name.substring(3) +|/unset|
    !this.name.val = |unset|

    -- Raise error
    !!messageFile.error(141, 153, !name.substring(3), !dbRef.type)

    -- Reset focus to the name
    !this.name.setFocus()

  endhandle

endmethod
-- End of method definition for .cbName()

------------------------------------------------------------------------
--
--Method: .prjTGet()
--
-- Description: method to return the array of project teams being used by
-- the Copy DB form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of project team DBREF's
--
------------------------------------------------------------------------

-- Define method
define method .prjTGet() is ARRAY

  -- Return the value
  return !this.teamArray

endmethod
-- End of method definition for .prjTGet() ARRAY

------------------------------------------------------------------------
--
--Method: .prjTList()
--
-- Description: method to update the contents of the project teams list gadget on
-- Copy DB form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .prjTList()

  -- Initialise variables
  !projTeams         = !this.prjTGet()
  !dbOwner           = !this.teamGet()

  -- Save the sort and filter values for later user
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.filterVal  = !this.filter.val
  !this.sortVal    = !this.sort.selection('rtext')

  -- Clear the list
  !this.projTeams.clear()

  -- Sort the list of teams
  !displayList       = !!adminFilterSort(!projTeams, !this.sort, !this.filter)

  -- Check that the DB Owner is displayed
  !pos               = !displayList.findFirst(!dbOwner)
  if (!pos.unset()) then
    !displayList.insert(1,!dbOwner)
  endif

  -- Display the list of teams
  !!adminTeamTxtList(!displayList, !this.projTeams,!!admDisplayConfig.fmtTeamGet(), !!admDisplayConfig.eleTypeGet())

  -- Select the DB owner
  !this.projTeams.select('rtext', !dbOwner.string())

endmethod
-- End of method definition for .prjTList()

------------------------------------------------------------------------
--
--Method: .prjTSet()
--
-- Description: method to set the form member for the project teams in the Copy DB
-- form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .prjTSet()

  -- Initialise variables
  !teams                = ARRAY()
  !currentPos           = !!ce

  -- Collect the project teams
  !!ce                  = !!dbrAdminGetWorld('TEAM')
  !teams                = !!collectAllFor('TEAM','',!!ce)

  -- Assign the array to its store
  !this.teamArray  = !teams

  -- Return to database position
  !!ce                  = !currentPos

endmethod
-- End of method definition for .prjTSet()

------------------------------------------------------------------------
--
--Method: .refGet()
--
-- Description: method to return the source DB DBREF for the element to be copied.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of DB being created or modified
--
------------------------------------------------------------------------

-- Define method
define method .refGet() is DBREF

  -- Return the value
  return !this.dbRef

endmethod
-- End of method definition for .refGet() DBREF

------------------------------------------------------------------------
--
--Method: .refresh()
--
--
-- Description: method to update the list of project teams displayed in the
-- Copy Db form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refresh()

  -- Return if form not shown
  if (Undefined (!!admDbCpy) or not !!admDbCpy.shown()) then
    return
  endif

  -- Display a message
  !!messageFile.prompt(141, 4, !this.formTitle, $
           !!messageFile.messageString(141, 803))

  -- Gather the team information
  !this.prjTSet()

  -- Update the list of teams
  !this.prjTList()

  -- Dismiss the prompt
  !!prompt(0)

endmethod
-- End of method definition for .refresh()

------------------------------------------------------------------------
--
--Method: .refSet()
--
-- Description: method to set the source DB DBREF for the Copy DB form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF  of DB element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refSet(!dbRef is DBREF)

  -- Set the DBREF
  !this.dbRef  = !dbRef

endmethod
-- End of method definition for .refSet(DBREF)

------------------------------------------------------------------------
--
--Method: .teamGet()
--
--
-- Description: method to return the target TEAM for a DB Copy command.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of target team
--
------------------------------------------------------------------------

-- Define method
define method .teamGet() is DBREF

  -- Return the value
  return !this.team

endmethod
-- End of method definition for .teamGet() DBREF


------------------------------------------------------------------------
--
--Method: .teamSel()
--
-- Description: Callback to Project Team list for user selection.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget selection was made from.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .teamSel(!gadget is GADGET)

  -- Initialise variables
  !dbOwner           = !this.teamGet()
  !selectedTeam      = !gadget.selection('rtext').dbRef()
  handle (2,107)

    -- Team does not exist in project
    !!messageFile.error(141, 3, $
           !!messageFile.messageString(141, 803),$
           !gadget.selection('rtext'))
    handle (06, 003)
      -- Dummy handle
    endhandle

    !this.refresh()
    return

  endhandle

  -- Check that the selection is new
  if (!dbOwner eq !selectedTeam) then
    return
  endif

  -- Set the new team
  !this.teamSet(!selectedTeam)

  -- Reset the paragraph gadget
  !this.to.val = !selectedTeam.name.substring(3) + |/| + !this.name.val

  -- Check the name combination
  !this.name()

endmethod
-- End of method definition for .teamSel(GADGET)

------------------------------------------------------------------------
--
--Method: .teamSet()
--
-- Description: method to set the form member to store the target TEAM for a
-- DB Copy command.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of target TEAM
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .teamSet(!dbRef is DBREF)

  -- Store the value
  !this.team   = !dbRef

endmethod
-- End of method definition for .teamSet(DBREF)
