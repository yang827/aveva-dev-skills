--   Replaces:
--
-- Author:          E.conba
-- Created:         Mon Oct 20 13:11:12 BST 1997
--
--
-- Description:
-- Form definition to allow the copying of foreign databases.
-- database that have a 'free' DBNO will be displayed in the form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   Callback copy the selected foreign database into the
--  cbName(GADGET)                   -                   Callback the target database name gadget in the Copy
--  cbUser(GADGET)                   -                   Callback the user name gadget on the Copy Foreign
--  dbGet()                          ARRAY               return the store array of valid databases.
--  dbList()                         -                   display and maintain the list of databases that are
--  dbLoad()                         -                   load an array of DB objects in the Copy Foreign
--  dbSel()                          -                   Callback selection of a foreign database to copy.
--  init()                           -                   initialise the Copy Foreign Database form.
--  prjGet()                         PROJECT
--  prjLoad()                        -
--  prjSel()                         -                   Callback method for a user selection of a foreign project.
--  prjSet(STRING)                   -                   set the selected foreign project. Selection is
--  refresh(STRING)                  -                   refresh the contents of the DB list in the Include Database
--  teamGet()                        DBREF               return the current selected team for the Copy Foreign
--  teamList()                       -                   maintain and display the list of project teams in the
--  teamLoad()                       -
--  teamSel()                        -                   Callback user selection of a Team in the Copy
--  teamSet(DBREF)                   -                   store the current selected Team in the Include Foreign
--
------------------------------------------------------------------------

-- Initialise variables
!dText  = ARRAY()
!rText  = ARRAY()

-- Define form
setup form !!admDbFor at xr 0.35 yr 0.1 resize

  !!admDbFor.formTitle     = 'Copy Foreign Database'
  !!admDbFor.iconTitle     = 'FOREIGN DB'
  !!admDbFor.callback      = '!!admDbFor.init()'
  !!admDbFor.formRevision  = ' $Revision: 1.10 $ '

  -- Body of form definition
  frame .projFrame at x 0 y 0  anchor top+left+right |Foreign Projects|

    list .projects at xmin+1 ymin+1 anchor top+left+right call |!this.prjSel()| width 45 height 5
    para .tx1 at xmin ymax  anchor left text |Access project as :-|
    text .user at xmin+2.5 ymax+0.2 anchor right+left |Username|  width 30 scroll 49 STRING
    text .pass at xmin ymax+0.2 anchor left |Password| call |!!admChkPassword(!this.pass)| width 15 noecho scroll 15 STRING

  exit

  frame .dbFrame at x 0 ymax+0.2 anchor top+left+right |Foreign Databases|

    list .dbs at xmin+1 ymin+1 anchor all call |!this.dbSel()| single columns width 45 height 5
    option .sort at xmin   ymax+0.2 anchor left+bottom |Sort By| call |!this.dbList()| width 12
    text .filter at xmax+1 ymin anchor right+bottom |Filter| call |!this.dbList()| width 15 STRING

  exit

  frame .targetFrame at x 0 ymax+0.2 anchor all |Target Database Name|

    para .dbNameTx at xmin+1 ymin+1 anchor left+top text |Database|
    para .dbName   at xmax+1 ymin anchor left+top width 38 line 1

    list .teams at xmin.targetFrame+1 ymax anchor all call |!this.teamSel()| single columns width 45 height 5
    option .teamSort at xmin ymax+0.2 anchor left+bottom |Sort By| call |!this.Teamlist()| width 12
    text .teamFilter at xmax+1 ymin anchor bottom+right |Filter| call |!this.teamList()| width 15 STRING

    text .name at xmin.teams ymax+0.2 anchor bottom+left+right |Database Name| call |!this.cbName(!this.name)| width 30 scroll 32 NAME

  exit

  button .apply at xmin ymax+0.5 anchor bottom+left |Apply| call |!this.cbApply()| APPLY
  button .dismiss at xmax form-size ymin anchor bottom+right |Dismiss| CANCEL

  -- Member definitions
    -- Array of project objects
    member .projArray  is ARRAY
    -- Array of valid DBS from selected project
    member .dbArray    is ARRAY
    -- Selected project (CODE)
    member .projCode   is STRING
    -- Team values
    member .teamArray  is ARRAY
    member .teamRef    is DBREF
    -- Sort and Filter value
    member .filterVal  is STRING
    member .sortVal    is STRING
    member .teamFilterVal is STRING
    member .teamSortVal   is STRING

-- Assign sort gadget values
!dText.append(|Name|)
!dText.append(|Type|)
!dText.append(|Number|)
!dText.append(|Description|)
!!admDbFor.sort.dText     = !dText
!dText.clear()
!rText.append(|!db.name|)
!rText.append(|!db.type + !db.name|)
!rText.append(|(substring('0000$$!db.number',-4,4)) + !db.name|)
!rText.append(|!db.description + !db.name|)
!!admDbFor.sort.rText     = !rText
!rText.clear()

!!admTeamSortGadg(!!admDbFor.teamSort)

-- Assign filter gadgets value
!!admDbFor.filter.val     = |*|
!!admDbFor.teamFilter.val = |*|


exit
-- End of form definition for !!admDbFor

------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: Callback copy the selected foreign database into the
-- local project, for the Copy Foreign Database form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbApply()

  -- Initialise variables
  !curPos     = !!ce
  !project    = !this.prjGet().code()
  !source     = !this.dbs.selection('rtext')
  !targetTeam = !this.teamGet()
  !targetDb   = !this.name.val
  !user       = !this.user.val
  !password   = !this.pass.val

  -- Check that target team and database are set
  if (!targetTeam.unset()) then

    -- No target team
    !!messageFile.error(141, 151, !!messageFile.messageString(141, 807))

  elseif (!targetDb.empty() or !targetDb eq 'unset') then

    -- No target database name
    !!messageFile.error(141, 152, !!messageFile.messageString(141, 807))

  else

    -- Create the target dbname
    !targetName = !targetTeam.name.substring(3) +'/'+ !targetDb

  endif

  -- Check that the username and password are set
  if (!user.empty() or !user eq 'unset') then

    -- No username
    !!messageFile.error(141, 101, !!messageFile.messageString(141, 809))

  elseif (!password.empty() or !password eq 'unset') then

    -- No password
    !!messageFile.error(141, 102, !!messageFile.messageString(141, 809))

  endif

  -- Copy the database
  --!command   = |COPY DB |+ !source +| FROM PROJ |+ !project +| USER |+ !user +|/|+ !password +| TO |+ !targetName
  !command   = 'COPY DB '+ !source +' FROM PROJ '+ !project +' USER '+ '|' + !user + '|' + '/'+ !password +' TO '+ !targetName
  !!messageFile.prompt(141, 179, !!messageFile.messageString(141, 808), !source, !project)

  call !!admCommand(!command)
  handle (1,4)

    -- DB Name already defined
    !!prompt(0)
    !!messageFile.error(141, 153, !targetName)

  elsehandle (1,253)

    -- DBNO already allocated
    !!prompt(0)
    !!messageFile.error(141, 158, !!error.text.after(')').part(3))

  elsehandle any

    -- Non-specific error
    !!prompt(0)
    !!messageFile.error(141, 182, $
           !!messageFile.messageString(141, 810), !source, !!error.text)

  endhandle

  -- Update the forms as required
  !!adminElem.update('DB')

endmethod
-- End of method definition for .cbApply()


------------------------------------------------------------------------
--
--Method:
--
-- Description: return the store array of valid databases.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of valid foreign databases
--
------------------------------------------------------------------------

-- Define method
define method .dbGet() is ARRAY

  -- Return the array
  return !this.dbArray

endmethod
-- End of method definition for .dbGet() ARRAY


------------------------------------------------------------------------
--
--Method: .dbList()
--
-- Description: display and maintain the list of databases that are
-- present in the current selected foreign project.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbList()

  -- Initialise variables
  !project             = !this.prjGet()
  !databases           = !this.dbGet()
  !dbName              = ARRAY()
  !dbType              = ARRAY()
  !dbNumb              = ARRAY()
  !dbDesc              = ARRAY()
  !sortValues          = ARRAY()
  !dText               = ARRAY()
  !rText               = ARRAY()

  -- Display a prompt
  !!messageFile.prompt(141, 4, !this.formTitle, !!messageFile.messageString(141, 811))

  -- Preserve sort and filter values
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.filterVal = !this.filter.val
  !this.sortVal   = !this.sort.selection('rtext')
  !filter              = !this.filter.val
  !sort                = !this.sort.selection('rtext')


  -- Clear the list gadget
  !this.dbs.clear()

  -- Process the array of databases
  do !db values !databases

    skip if (!db.foreign eq 'FOREIGN')
    skip if (!db.name.matchwild(!filter).not())

    !dbName.append(!db.name)
    !dbType.append(!db.type)
    !dbNumb.append(!db.number)
    if (!db.description.empty()) then
      !dbDesc.append('unset')
    else
      !dbDesc.append(!db.description)
    endif
    !sortValues.append($!sort)

  enddo

  -- Sort the array
  !order = !sortValues.sortedIndices()

   -- Element type indicator
  !useHeader = !!admDisplayConfig.eleTypeGet()
  if( !useHeader ) then
    !headerText  = |<DB>| & |  | & '	'
  else
    !headerText  = ||
  endif

  -- Create display texts
  do !i values !order

    !text = !headerText & !dbName[!i] & '	' & '[' & !dbType[!i] & ']' & '	' & !dbNumb[!i] & '	' & !dbDesc[!i]

     !dText.append(!text)
     !rText.append(!dbName[!i])

  enddo

  -- Assign values to text gadget
  -- set the headings
   -- set the headings
  !heading = object ARRAY()
  if( !useHeader ) then
      !heading.append('Type')
  endif
  !heading.append('Name')
  !heading.append('DB Type')
  !heading.append('DB Number')
  !heading.append('Description')
  !this.dbs.setHeadings(!heading)

  !this.dbs.dText  = !dText
  !this.dbs.rText  = !rText

  -- Dismiss the prompt
  !!prompt(0)

  -- Select the database (default)
  !this.dbSel()

endmethod
-- End of method definition for .dbList()

------------------------------------------------------------------------
--
--Method: .dbLoad()
--
-- Description: load an array of DB objects in the Copy Foreign
-- Database form, that are valid for copying to the current project.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbLoad()

  -- Initialise variables
  !curPos    = !!ce
  !project   = !this.prjGet()
  !!debug=!project
  !databases = !project.dbList()
  if( !databases.empty() ) then
    !!alert.message(|There are no databases in the project that you have selected|)
    !this.dbArray.clear()
    return
  endif
  !dbArray   = ARRAY()

  -- Get the current projects teams and databases
  !currentProject = CURRENT PROJECT
  !curProjDbs     = !currentProject.dbList()

  -- Get the team names and DBNOS
  !block     = object BLOCK(|!curProjDbs[!evalIndex].number|)
  !locDbno   = !curProjDbs.evaluate(!block)
  !locDbno.unique()

  -- Process remote database and find those
  -- with teams and DBNO's in the local project
  do !db values !databases

    -- Check the database number
    skip if (!locDbno.findFirst(!db.number).set())

    -- Db is valid
    !dbArray.append(!db)

  enddo

  -- Assign the array value
  !this.dbArray  = !dbArray

  -- warn user if all DB's are already in this project
  if( !dbArray.empty() ) then
    !!alert.message(|None of the databases in the selected project have database numbers which are free to be used in this project|)
  endif

  -- Restore database position
  !!ce       = !curPos

endmethod
-- End of method definition for .dbLoad()


------------------------------------------------------------------------
--
--Method:
--
-- Description: Callback selection of a foreign database to copy.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbSel()

  -- Initialise variables
  !selection   = !this.dbs.selection('rtext')
  !teamName    = !selection.before('/')
  !dbName      = !selection.after('/')

  -- Attempt to select the project team
  !teamName    = |/*|+ !teamName
  !dbRef       = !teamName.dbRef()
  handle none

    -- DBREF is real, but is it a team
    !this.teams.select('rtext', !dbRef.string())
    handle none

      -- Selection succeeded
      !this.teamSet(!dbRef)

    elsehandle any
      -- Dummy handle
    endhandle

  elsehandle any
    -- Element does not exist in project
  endhandle

  -- Set the database name portion
  !this.name.val  = !dbName

  -- the name gadget callback
  !this.cbName(!this.name)

endmethod
-- End of method definition for .dbSel()

------------------------------------------------------------------------
--
--Method:
--
-- Description: initialise the Copy Foreign Database form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- Set for gadget values
  !this.user.val   = |unset|
  !this.pass.val   = ||
  !this.dbName.val = |unset/unset|
  !this.name.val   = |unset|
  if (!this.filterVal.set()) then
    !this.filter.val = !this.filterVal
  endif
  if (!this.sortVal.set()) then
    !this.sort.select('rtext',!this.sortVal)
  endif
  if (!this.teamFilterVal.set()) then
    !this.teamFilter.val = !this.teamFilterVal
  endif
  if (!this.teamSortVal.set()) then
    !this.teamSort.select('rtext',!this.teamSortVal)
  endif

  -- Load the projects
  !this.prjLoad()

  -- Check that we have some foreign project in the environment
  if (!this.projArray.size() eq 0) then

    -- No foreign project so don't show the form
    !!messageFile.error(141, 177)

  endif

  -- Select the first project
  !this.prjSet('')
  !this.prjSel()

  -- Load the teams
  !this.teamLoad()
  !this.teamList()

  -- Select the first database
  !this.dbSel()

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
--Method: .cbName()
--
-- Description: Callback the target database name gadget in the Copy
-- Foreign database form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbName(!gadget is GADGET)

  -- Initialise variables
  !team    = !this.teamGet()
  !value   = !gadget.val

  -- Check the name has not been entered with a '/'
  if (!value.substring(1,1) eq '/') then
    !value   = !value.substring(2)
  elseif (!value.empty()) then
    !value   = |unset|
  endif

  -- Change the database paragraph gadget
  if (!team.set()) then
    !this.dbName.val  = !team.name.substring(3) +|/|+ !value
  else
    !this.dbName.val  = |unset/| + !value
  endif

  -- Reset the name gadget
  !gadget.val         = !value

endmethod
-- End of method definition for .cbName(GADGET)

------------------------------------------------------------------------
--
--Method: .prjGet()
--
-- Description:
-- return a PROJECT() object for the current
-- selected project.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PROJECT     Current selected project
--
------------------------------------------------------------------------

-- Define method
define method .prjGet() is PROJECT

  -- Initialise variables
  !code       = !this.projCode
  !projArray  = !this.projArray
  !codeArray  = ARRAY()
  !returnVal  = object PROJECT()

  -- Check the code is set
  if (!code.set()) then

    -- Get the project codes
    do !proj values !projArray
      !codeArray.append(!proj.code().upcase())
    enddo

    -- Find the project code
    !index      = !codeArray.findFirst(!code)
    if (!index.set()) then
      !returnVal  = !projArray[!index]
    endif

  endif

  -- Return the result
  return !returnVal

endmethod
-- End of method definition for .prjGet() PROJECT

------------------------------------------------------------------------
--
--Method: .prjLoad()
--
-- Description:
-- load an array of projects objects into the Foreign
-- Database form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .prjLoad()

  -- Initialise variables
  !projObjects = PROJECTS
  !currentProj = CURRENT PROJECT
  !projects    = ARRAY()
  !projCode    = ARRAY()
  !projId      = ARRAY()
  !projDesc    = ARRAY()
  !dText       = ARRAY()
  !rText       = ARRAY()
  !headings    = ARRAY()

  -- Set up the foreign project headings
  !headings.append('Project')
  !headings.append('Project Code')
  !headings.append('Description')

  !this.projects.setHeadings(!headings)

  -- Create an array of project (except the current one)
  do !proj values !projObjects

    skip if (!proj eq !currentProj)
    !projects.append(!proj)
    !projCode.append(!proj.code().upcase())
    if (!proj.id().unset()) then
      !projId.append(!proj.code().upcase())
    else
      !projId.append(!proj.id())
    endif
    !projDesc.append(!proj.description())

  enddo

  -- Sort the array of projects
  !order       = !projCode.sortedIndices()
  !projects.reIndex(!order)
  !projDesc.reIndex(!order)
  !projCode.reIndex(!order)
  !projId.reIndex(!order)

  -- Store the array of projects
  !this.projArray  = !projects

  -- Update the list of projects
  !this.projects.clear()

  do !i indices !projCode

    if (!projDesc[!i].set()) then
      !dText.append(!projId[!i] +|	|+ !projCode[!i] +|	|+ !projDesc[!i])
    else
      !dText.append(!projId[!i] +|	|+ !projCode[!i] +|	|+ | -- No description --|)
    endif
    !rText.append(!projCode[!i])

  enddo
  -- Assign the gadget values
  !this.projects.dText  = !dText
  !this.projects.rText  = !rText

  -- Select the default project
  !this.prjSet(!this.projects.selection('rtext'))

endmethod
-- End of method definition for .prjLoad()

------------------------------------------------------------------------
--
--Method: .prjSel()
--
-- Description: Callback method for a user selection of a foreign project.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .prjSel()

  -- Initialise variables
  !selection    = !this.projects.selection('rtext')
  !curSelection = !this.prjGet()

  -- See if the selection is different
  if (!selection neq !curSelection.code()) then

    -- Set the new selection
    !this.prjSet(!selection)

    -- the update methods
    !this.dbLoad()
    !this.dbList()

  endif

endmethod
-- End of method definition for .prjSel()

------------------------------------------------------------------------
--
--Method: .prjSet()
--
-- Description: set the selected foreign project. Selection is
-- based on the project code.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Project Code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .prjSet(!code is STRING)

  -- Initialise variables
  !projects   = !this.projArray
  !codeArray  = ARRAY()

  -- Get the project codes
  do !proj values !this.projArray
    !codeArray.append(!proj.code().upcase())
  enddo

  -- Check that the passed code is valid
  if (!codeArray.findFirst(!code).unset()) then

    -- Bad code was passed
    !this.projCode  = STRING()

  else

    -- Code is valid
    !this.projCode  = !code

  endif

endmethod
-- End of method definition for .prjSet(STRING)

------------------------------------------------------------------------
--
--Method: .refresh()
--
-- Description:refresh the contents of the DB list in the Include Database
-- Form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type to update
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refresh(!type is STRING)

  -- Check the form is displayed
  if (Defined (!!admDbFor) and !!admDbFor.shown()) then

    if (!type eq 'DB') then

      -- the update methods
      !this.dbLoad()
      !this.dbList()

    elseif (!type eq 'TEAM') then

      -- the update methods
      !this.teamLoad()
      !this.teamList()

    endif

  endif

endmethod
-- End of method definition for .refresh(STRING)

------------------------------------------------------------------------
--
--Method: .teamGet()
--
-- Description: return the current selected team for the Copy Foreign
-- database form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Current selected team
--
------------------------------------------------------------------------

-- Define method
define method .teamGet() is DBREF

  -- Return the value
  return !this.teamRef

endmethod
-- End of method definition for .teamGet() DBREF

------------------------------------------------------------------------
--
--Method: teamlist()
--
-- Description: maintain and display the list of project teams in the
-- Copy Foreign Database form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .teamList()

  -- Initialise variables
  !teamArray  = !this.teamArray
  !selection  = !this.teamGet()

  -- Preserve the sort and filter values
  if (!this.teamFilter.val.empty()) then
    !this.teamFilter.val  =|*|
  endif
  !this.teamSortVal   = !this.teamSort.selection('rtext')
  !this.teamFilterVal = !this.teamFilter.val

  -- Clear the list
  !this.teams.clear()

  -- Display a prompt
  !!messageFile.prompt(141, 4, !this.formTitle, $
            !!messageFile.messageString(141, 803))

  -- Display the list of teams
  !displayRef = !!adminFilterSort(!teamArray, !this.teamSort, !this.teamFilter)
  !!adminTeamTxtList(!displayRef, !this.teams, !!admDisplayConfig.fmtTeamGet(), !!admDisplayConfig.eleTypeGet())

  -- Dismiss the prompt
  !!prompt(0)

  -- Attempt to reselect the team
  !this.teams.select('rtext', !selection.string())
  handle any
    -- Doesn't matter if there isn't one
  endhandle

  !this.teamSel()

endmethod
-- End of method definition for .teamList()

------------------------------------------------------------------------
--
--Method: .teamLoad()
--
-- Description:
-- load the current set of project teams and store the
-- array in a form member.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .teamLoad()

  -- Initialise variables
  !curPos   = !!ce
  !teams    = ARRAY()

  -- Collect project teams
  !!ce      = !!dbrAdminGetWorld('TEAM')
  !teams    = !!collectAllFor('TEAM','',!!ce)

  -- Save the array
  !this.teamArray = !teams

  -- Restore database position and return
  !!ce      = !curPos
  return

endmethod
-- End of method definition for .teamLoad()

------------------------------------------------------------------------
--
--Method: .teamSel()
--
-- Description: Callback user selection of a Team in the Copy
-- Foreign database form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .teamSel()

  -- Initialise variables
  !curSelection  = !this.teamGet()
  !selection     = !this.teams.selection('rtext').dbRef()
  !dbName        = !this.name.val

  if (!curSelection neq !selection) then

    -- Set the new selection
    !this.teamSet(!selection)
    if (!selection.set()) then
      !this.dbName.val  = !selection.name.substring(3) +'/'+ !dbName
    else
      !this.dbName.val  = 'unset/'+ !dbName
    endif

  endif

endmethod
-- End of method definition for .teamSel()

------------------------------------------------------------------------
--
--Method: teamSet()
--
-- Description: store the current selected Team in the Include Foreign
-- Database form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of selected team (may be unset)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .teamSet(!dbRef is DBREF)

  -- Store the value
  !this.teamRef  = !dbRef

endmethod
-- End of method definition for .teamSet(DBREF)

-- Description: Callback the user name gadget on the Copy Foreign
-- Database form, to check the validity of the entry.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Username gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbUser(!gadget is GADGET)

  -- Initialise variables
  !name        = !gadget.val
  !occurrences  = REAL()

  -- Check that the input string does not contain numbers [0-9]
  !occurrences  = !name.occurs('0')
  !occurrences  = !occurrences + !name.occurs('1')
  !occurrences  = !occurrences + !name.occurs('2')
  !occurrences  = !occurrences + !name.occurs('3')
  !occurrences  = !occurrences + !name.occurs('4')
  !occurrences  = !occurrences + !name.occurs('5')
  !occurrences  = !occurrences + !name.occurs('6')
  !occurrences  = !occurrences + !name.occurs('7')
  !occurrences  = !occurrences + !name.occurs('8')
  !occurrences  = !occurrences + !name.occurs('9')

  if (!occurrences gt 0) then

    -- User names cannot contain numbers
    !gadget.val  = |unset|
    -- Raise error
    !!messageFile.error(141, 113)

  endif

  -- Force the value to uppercase and return
  !gadget.val  = !name.upcase()
  return

endmethod
-- End of method definition for .cbUser(GADGET)
