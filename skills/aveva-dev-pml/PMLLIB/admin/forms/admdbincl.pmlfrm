--
--
-- Description:
-- Form definition to allow inclusion of foreign databases. Only
-- database that have a 'free' DBNO will be displayed in the form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   method to include foreign databases
--  cbUser(GADGET)                   -                   Callback method to the user name gadget on the Include
--  dbGet()                          ARRAY               method to return the store array of valid databases.
--  dbList()                         -                   method to display and maintain the list of databases that are
--  dbLoad()                         -                   method to load an array of DB objects in the Include Foreign
--  init()                           -                   method to initialise the Foreign Database Inclusion form.
--  prjGet()                         PROJECT             method to return a PROJECT() object for the current
--  prjLoad()                        -                   method to load an array of projects objects into the Foreign
--  prjSel()                         -                   Callback method for a user selection of a foreign project.
--  prjSet(STRING)                   -                   method to set the selected foreign project. Selection is
--  refresh()                        -                   method to refresh the contents of the DB list in the Include Database
--
------------------------------------------------------------------------


-- Initialise variables
!dText  = ARRAY()
!rText  = ARRAY()

-- Define form
setup form !!admDbIncl at xr 0.35 yr 0.1 resize

  !!admDbIncl.formTitle     = 'Include Foreign Database'
  !!admDbIncl.iconTitle     = 'FOREIGN DB'
  !!admDbIncl.callback      = '!!admDbIncl.init()'
  !!admDbIncl.formRevision  = ' $Revision: 1.12 $ '

  -- Body of form definition
  frame .projFrame at x 0 y 0 anchor top+left+right |Foreign Projects|

    list .projects at xmin+1 ymin+1 anchor top+left+right call |!this.prjSel()| width 45 height 5
    para .tx1 at xmin ymax anchor left text |Access project as :-|
    text .user at xmin+2.5 ymax+0.2 anchor left+right |Username|  width 30 scroll 49 STRING
    text .pass at xmin ymax+0.2 anchor left |Password| call |!!admChkPassword(!this.pass)| width 15 noecho scroll 15 STRING

  exit

  frame .dbFrame at x 0 ymax+0.2 anchor all |Foreign Databases|

    list .dbs at xmin+1 ymin+1 anchor all multiple columns width 45 height 10
    option .sort at xmin   ymax+0.2 anchor left+bottom |Sort By| call |!this.dbList()| width 12
    text .filter at xmax+1 ymin anchor bottom+right |Filter|  call |!this.dbList()| width 15 STRING

  exit

  button .apply at xmin ymax+0.5 anchor bottom+left |Apply| call |!this.cbApply()| APPLY
  button .dismiss at xmax form-size ymin anchor bottom+right |Dismiss| CANCEL

  -- Member definitions
    -- Array of project objects
    member .projArray  is ARRAY
    -- Array of valid DBS from selected project
    member .dbArray    is ARRAY
    -- Selected project (CODE)
    member .projCode   is STRING
    -- Sort and Filter value
    member .filterVal  is STRING
    member .sortVal    is STRING

-- Assign sort gadget values
!dText.append(|Name|)
!dText.append(|Type|)
!dText.append(|Number|)
!dText.append(|Description|)
!!admDbIncl.sort.dText     = !dText
!dText.clear()
!rText.append(|!db.name|)
!rText.append(|!db.type + !db.name|)
!rText.append(|(substring('0000$$!db.number',-4,4)) + !db.name|)
!rText.append(|!db.description + !db.name|)
!!admDbIncl.sort.rText     = !rText
!rText.clear()

-- Assign filter gadget value
!!admDbIncl.filter.val     = |*|

exit
-- End of form definition for !!admDbIncl

------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: method to include foreign databases
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbApply()

  -- Initialise variables
  !curPos    = !!ce
  !project   = !this.projects.selection('rtext')
  !user      = !this.user.val
  !password  = !this.pass.val
  !selection = !this.dbs.selection('rtext')
  !locTeams  = ARRAY()
  !dbNames   = ARRAY()
  !newTeam   = false
  !update    = false

  -- Check for selected databases
  if (!selection.size() eq 0) then
    return
  endif

  -- Check that the username and password are set
  if (!user.empty() or !user eq 'unset') then

    -- No username
     !!messageFile.error(141, 101, !!messageFile.messageString(141, 812))

  elseif (!password.empty() or !password eq 'unset') then

    -- No password
     !!messageFile.error(141, 102, !!messageFile.messageString(141, 812))

  endif

  -- Get an array of teams in the local project
  !!ce       = !!dbrAdminGetWorld('TEAM')
  !locTeams  = !!collectAllFor('TEAM','',!!ce)
  !tBlock    = object BLOCK(|!locTeams[!evalIndex].name.substring(3)|)
  !teamNames = !locTeams.evaluate(!tBlock)

  -- Get the array of foreign databases
  !databases = !this.prjGet().dbList()
  do !db values !databases
    !dbNames.append(!db.name)
  enddo

  -- Process the set of databases
  do !db values !selection

    -- Find database object
    !index     = !dbNames.findFirst(!db)
    if (!index.unset()) then

      -- Not found in foreign project
      !!messageFile.error(141, 178, !db, !project)
      handle (06, 178)
        -- Dummy handle
        skip
      endhandle

    endif

    -- Check that the team exists
    if (!teamNames.findFirst(!db.before('/')).unset()) then

      -- Required team does not exist
      -- See if user wishes to create it
      !answer = !!alert.question(!!messageFile.messageString(141, 180, !db, !db.before('/')))
      if (!answer eq 'NO') then

        -- Cancel include process
        return

      elseif (!answer eq 'YES') then

        -- Create the team (with no users)
        !!ce       = !!dbrAdminGetWorld('TEAM')
        !name      = |/*|+ !db.before('/')
        call !!admCommand( 'NEW TEAM ' + !name )
        handle any

          -- Could not create team
          call !!admCommand('DELETE TEAM')
          !!messageFile.error(141, 181, !name, !db)
          handle (06, 181)
            skip
          endhandle

        elsehandle none

          -- Add new team to list of names
          !newTeam   = true
          !teamNames.append(!name.substring(3))

        endhandle

      else

        -- Skip this db
        skip

      endif

    endif

    -- Include the database
    !command   = 'INCLUDE DB '+ !db +' FROM PROJ '+ !project +' USER '+ '|'+ !user + '|' + '/'+ !password
    !!messageFile.prompt(141, 179, !!messageFile.messageString(141, 814), !db, !project)

    call !!admCommand(!command)
    handle (1,4)

      -- DB Name already defined
      !!messageFile.error(141, 153, !db)
      handle (06, 153)
        -- Dummy handle
      endhandle

    elsehandle (1,253)

      -- DBNO already allocated
      !!messageFile.error(141, 158, !!error.text.after(')').part(3))
      handle (06, 158)
        -- Dummy handle
      endhandle

    elsehandle any

      -- Non-specific error
      !!messageFile.error(141, 182, !!messageFile.messageString(141, 813), !db, !!error.text)
      handle (06, 182)
        -- Dummy handle
      endhandle

    elsehandle none

      -- Database was included
      !update    = true

    endhandle

    !!prompt(0)

  enddo

  -- Update the forms as required
  if (!newTeam) then
    !!adminElem.update('TEAM')
  endif
  if (!update) then
    !!adminElem.update('DB')
  endif

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
--Method: .dbGet()
--
-- Description: method to return the store array of valid databases.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbGet() is ARRAY

  -- Return the array
  return !this.dbArray

endmethod
-- End of method definition for .dbGet() ARRAY

------------------------------------------------------------------------
--
--Method: .dbList()
--
-- Description:method to display and maintain the list of databases that are
-- present in the current selected foreign project.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbList()

  -- Initialise variables
  !project             = !this.prjGet()
  !databases           = !this.dbGet()
  !dbName              = ARRAY()
  !dbType              = ARRAY()
  !dbNumb              = ARRAY()
  !dbDesc              = ARRAY()
  !sortValues          = ARRAY()
  !dText               = ARRAY()
  !rText               = ARRAY()

  -- Preserve sort and filter values
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.filterVal = !this.filter.val
  !this.sortVal   = !this.sort.selection('rtext')
  !filter               = !this.filter.val
  !sort                 = !this.sort.selection('rtext')


  -- Clear the list gadget
  !this.dbs.clear()

  -- Display a prompt
  !!messageFile.prompt(141, 4, !this.formTitle, !!messageFile.messageString(141, 811))

  -- Process the array of databases
  do !db values !databases

    skip if (!db.foreign eq 'FOREIGN')
    skip if (!db.name.matchwild(!filter).not())

    !dbName.append(!db.name)
    !dbType.append(!db.type)
    !dbNumb.append(!db.number)
    if (!db.description.empty()) then
      !dbDesc.append('unset')
    else
      !dbDesc.append(!db.description)
    endif
    !sortValues.append($!sort)

  enddo

  -- Sort the array
  !order = !sortValues.sortedIndices()

   -- Element type indicator
  !useHeader = !!admDisplayConfig.eleTypeGet()
  if( !useHeader ) then
    !headerText  = |<DB>| & |  | & '	'
  else
    !headerText  = ||
  endif

  -- Create display texts
  do !i values !order

    !text = !headerText  & !dbName[!i]& '	' & '[' & !dbType[!i] & ']' & '	' & !dbNumb[!i] & '	' & !dbDesc[!i]
    handle ANY
      !text = !headerText  & !dbName[!i]& '	' & '[' & !dbType[!i] & ']' & '	' & 'Line too long ...'
    endhandle

    !dText.append(!text)
    !rText.append(!dbName[!i])

  enddo

   -- set the headings
  !heading = object ARRAY()
  if( !useHeader ) then
      !heading.append('Type')
  endif
  !heading.append('Name')
  !heading.append('DB Type')
  !heading.append('DB Number')
  !heading.append('Description')
  !this.dbs.setHeadings(!heading)

  -- Assign values to text gadget
  !this.dbs.dText  = !dText
  !this.dbs.rText  = !rText

  -- Dismiss the prompt
  !!prompt(0)

endmethod
-- End of method definition for .dbList()

------------------------------------------------------------------------
--
--Method: .dbLoad()
--
-- Description: method to load an array of DB objects in the Include Foreign
-- Database form, that are valid for inclusion to the current project.
-- These must have teams that exist in the project and DBNO values that
-- do not already exists.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbLoad()

  -- Initialise variables
  !curPos    = !!ce
  !project   = !this.prjGet()
  !databases = !project.dbList()
  !dbArray   = ARRAY()

  -- Get the current projects teams and databases
  !!ce       = !!dbrAdminGetWorld('TEAM')
  !lDbs      = !!collectAllFor('DB','',!!ce)

  -- Get the team names and DBNOS
  !block     = object BLOCK(|!lDbs[!evalIndex].dbNo.string() & ' ' & !lDbs[!evalIndex].file.substring(-4,4)|)
  !locDbno   = !lDbs.evaluate(!block)
  !locDbno.unique()

  -- Process remote database and find those
  -- with teams and DBNO's in the local project
  do !db values !databases

    -- Check the database number
    skip if (!locDbno.findFirst(!db.number & ' ' & !db.file.substring(-4,4)).set())

    -- Db is valid
    !dbArray.append(!db)

  enddo

  -- Assign the array value
  !this.dbArray  = !dbArray

  -- Restore database position
  !!ce       = !curPos

endmethod
-- End of method definition for .dbLoad()


------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: method to initialise the Foreign Database Inclusion form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- Set for gadget values
  !this.user.val   = |unset|
  !this.pass.val   = ||
  if (!this.filterVal.set()) then
    !this.filter.val = !this.filterVal
  endif
  if (!this.sortVal.set()) then
    !this.sort.select('rtext',!this.sortVal)
  endif

  -- Load the projects
  !this.prjLoad()

  -- Check that we have some foreign project in the environment
  if (!this.projArray.size() eq 0) then

    -- No foreign project so don't show the form
    !!messageFile.error(141, 177)

  endif

  -- Select the first project
  !this.prjSet('')
  !this.prjSel()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
--Method: .prjGet()
--
-- Description: method to return a PROJECT() object for the current
-- selected project.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    PROJECT     Current selected project
--
------------------------------------------------------------------------

-- Define method
define method .prjGet() is PROJECT

  -- Initialise variables
  !code       = !this.projCode
  !projArray  = !this.projArray
  !codeArray  = ARRAY()
  !returnVal  = object PROJECT()

  -- Check the code is set
  if (!code.set()) then

    -- Get the project codes
    do !proj values !projArray
      !codeArray.append(!proj.code().upcase())
    enddo

    -- Find the project code
    !index      = !codeArray.findFirst(!code)
    if (!index.set()) then
      !returnVal  = !projArray[!index]
    endif

  endif

  -- Return the result
  return !returnVal

endmethod
-- End of method definition for .prjGet() PROJECT

------------------------------------------------------------------------
--
--Method: .prjLoad()
--
-- Description: method to load an array of projects objects into the Foreign
-- Database form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .prjLoad()

  -- Initialise variables
  !projObjects = PROJECTS
  !currentProj = CURRENT PROJECT
  !projects    = ARRAY()
  !projCode    = ARRAY()
  !projId      = ARRAY()
  !projDesc    = ARRAY()
  !dText       = ARRAY()
  !rText       = ARRAY()
  !headings    = ARRAY()

  -- Set up the foreign project headings
  !headings.append('Project')
  !headings.append('Project Code')
  !headings.append('Description')

  !this.projects.setHeadings(!headings)
  -- Create an array of project (except the current one)
  do !proj values !projObjects
    skip if (!proj.evar eq !currentProj.code().upcase())
    -- skip if (!proj.isGlobal() eq TRUE and !currentProj.isGlobal() eq FALSE )
    !projects.append(!proj)
    !projCode.append(!proj.code().upcase())
    if (!proj.id().unset()) then
      !projId.append(!proj.code().upcase())
    else
      !projId.append(!proj.id())
    endif
    !projDesc.append(!proj.description())

  enddo

  -- Sort the array of projects
  !order       = !projCode.sortedIndices()
  !projects.reIndex(!order)
  !projDesc.reIndex(!order)
  !projCode.reIndex(!order)
  !projId.reIndex(!order)

  -- Store the array of projects
  !this.projArray  = !projects

  -- Update the list of projects
  !this.projects.clear()

  do !i indices !projCode

    if (!projDesc[!i].set()) then
      !dText.append(!projId[!i] +|	|+ !projCode[!i] +|	|+ !projDesc[!i])
    else
      !dText.append(!projId[!i] +|	|+ !projCode[!i] +|	|+ | -- No description --|)
    endif
    !rText.append(!projCode[!i])

  enddo

  -- Assign the gadget values
  !this.projects.dText  = !dText
  !this.projects.rText  = !rText

  -- Select the default project
  !this.prjSet(!this.projects.selection('rtext'))

endmethod
-- End of method definition for .prjLoad()

------------------------------------------------------------------------
--
--Method: prjSel()
--
-- Description: Callback method for a user selection of a foreign project.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .prjSel()

  -- Initialise variables
  !selection    = !this.projects.selection('rtext')
  !curSelection = !this.prjGet()

  -- See if the selection is different
  if (!selection neq !curSelection.code()) then

    -- Set the new selection
    !this.prjSet(!selection)

    -- Display a prompt
    !!messageFile.prompt(141, 4, !this.formTitle, $
            !!messageFile.messageString(141, 811))

    -- the update methods
    !this.dbLoad()
    !this.dbList()

    -- Dismiss the prompt
    !!prompt(0)

  endif

endmethod
-- End of method definition for .prjSel()

------------------------------------------------------------------------
--
--Method: .prjSet()
--
-- Description: method to set the selected foreign project. Selection is
-- based on the project code.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Project Code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .prjSet(!code is STRING)

  -- Initialise variables
  !projects   = !this.projArray
  !codeArray  = ARRAY()

  -- Get the project codes
  do !proj values !this.projArray
    !codeArray.append(!proj.code().upcase())
  enddo
  -- Check that the passed code is valid
  if (!codeArray.findFirst(!code).unset()) then

    -- Bad code was passed
    !this.projCode  = STRING()

  else

    -- Code is valid
    !this.projCode  = !code
  endif

endmethod
-- End of method definition for .prjSet(STRING)

------------------------------------------------------------------------
--
--Method: .refresh()
--
-- Description: method to refresh the contents of the DB list in the Include Database
-- Form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refresh()

  -- Check the form is displayed
  if (!!admDbIncl.shown()) then

    -- Display a prompt
    !!messageFile.prompt(141, 004, !this.formTitle, 'DB')

    -- the update methods
    !this.dbLoad()
    !this.dbList()

    -- Dismiss the prompt
    !!prompt(0)

  endif

endmethod
-- End of method definition for .refresh()

------------------------------------------------------------------------
--
--Method: .cbUser()
--
-- Description: Callback method to the user name gadget on the Include
-- Foreign Database form, to check the validity of the entry.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Username gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbUser(!gadget is GADGET)

  -- Initialise variables
  !name        = !gadget.val
  !occurrences  = REAL()

  -- Check that the input string does not contain numbers [0-9]
  !occurrences  = !name.occurs('0')
  !occurrences  = !occurrences + !name.occurs('1')
  !occurrences  = !occurrences + !name.occurs('2')
  !occurrences  = !occurrences + !name.occurs('3')
  !occurrences  = !occurrences + !name.occurs('4')
  !occurrences  = !occurrences + !name.occurs('5')
  !occurrences  = !occurrences + !name.occurs('6')
  !occurrences  = !occurrences + !name.occurs('7')
  !occurrences  = !occurrences + !name.occurs('8')
  !occurrences  = !occurrences + !name.occurs('9')

  if (!occurrences gt 0) then

    -- User names cannot contain numbers
    !gadget.val  = |unset|
    -- Raise error
    !!messageFile.error(141, 113)

  endif

  -- Force the value to uppercase and return
  !gadget.val  = !name.upcase()
  return

endmethod
-- End of method definition for .cbUser(GADGET)
