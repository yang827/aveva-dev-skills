-- Created:         Tue Jan 21 14:36:32 GMT 1997
--
--
-- Description:
-- Form to display information on all databases in the project.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admDbList()                      -                   Constructor
--  apply(STRING)                    -                   Drop/Issue/Flush/Refresh selected extract db element in list
--  dbListSelect(REAL)               -                   Select a DB from the list and report its information
--  enableExtFunc(BOOLEAN)           -                   Set buttons active/inactive
--  extractHierarchy(DBREF,REAL)     -                   Get DB hierarchy
--  init()                           -                   Method to initialise the data for the DB List form
--  sortByHierarchy()                -                   Sort DB's by hierarchy
--
------------------------------------------------------------------------

-- Define form
setup form !!admDbList

  !this.formTitle     = |Extract Database Control|
  !this.iconTitle     = |DB List|
  !this.callback      = |!this.init()|
  !this.formRevision  = | $Revision: 1.7 $ |

  -- Body of form definition
  rgroup .sortOrder ' Sort Databases ' at x 0.5 callback '!this.init()' frame HORIZONTAL
    add tag 'Alphabetic  ' SELECT 'ALPHABETIC'
    add tag 'By Hierarchy' SELECT 'HIERARCHY'
  exit
--  path down
--  toggle .extractOnly 'Show Extract DB Families only' call |!this.extractOnlySelect(!this.dbs.val)|
  path right
  valign bottom
  toggle .display 'Show Extract Elements' at xmax+6 ycen call |!this.dbListSelect(!this.dbs.val)|

  list .dbs    at x 0.5 ymax+0.5 call |!this.dbListSelect(!this.dbs.val)| width 33 length 20

  list .report at xmax+0.5 ymin width 44 length 20

  frame .extractFrame ' Extract DB Operations ' at x 0.5 ymax+0.2
    path right
    button .actionFlush   | Flush | at x4 ymax0.5  call |!this.apply('FLUSH')| tooltip 'Issue Changes & keep claimed'  APPLY
    button .actionIssue   | Issue | at xmax+4 ymin call |!this.apply('ISSUE')| tooltip 'Issue Changes & release claim' APPLY
    button .actionDrop    | Abort | at xmax+4 ymin call |!this.apply('DROP')|  tooltip 'ABORT abandons Changes'        APPLY
    button .actionRefresh | Get All Changes | at xmax+14 ymin-0.5 call |!this.apply('REFRESH')| tooltip 'Get all Changes'   APPLY
    rgroup .fullRefresh '' at xmax_actionDrop+4 ymax callback '' HORIZONTAL
      add tag 'From parent only' SELECT 'PARENT'
      add tag 'From all ancestors' SELECT 'FULL'
    exit
  exit

  --button .dismiss at xmax form-size ymax_fullRefresh |Dismiss| OK

  -- Member Definitions
  member .dbList      is DBLISTOBJ
  member .dbNames     is ARRAY
  member .dbShow      is ARRAY

exit
-- End of form definition for !!dbList

------------------------------------------------------------------------
--
-- Method:      .admDbList()
--
-- Description: Constructor
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .admDbList()

  !this.sortOrder.val = 2

endmethod
-- End of method definition for .admDbList()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the data for the DB List form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  PROMPT 'Collecting extract database family information. Please wait...'

  !this.dbList = object DBLISTOBJ()
  !this.dbList.setOnlyExtrHeir(true)
  !this.dbList.update()

  if (!!sessionSettings.showAs eq |DESC|) then
    -- show DB descriptions
    !dbDtext = !this.dbList.getDbDesc()
    !dbRtext = !this.dbList.getDbNames()
  else
    -- show DB names
    !dbDtext = !this.dbList.getDbNames()
    !dbRtext = !dbDtext
  endif

  if( defined(!dbDtext[1]) ) then
    if( !this.sortOrder.selection().upcase() eq 'HIERARCHY' ) then
      -- sort by hierarchy
      !this.sortByHierarchy()
    else
      -- Sort alphabetically the list of DBs
      !sortOrder = !dbDtext.sortedIndices()
      !dbDispList = ARRAY()
      !dbReplList = ARRAY()

      do !i values !sortOrder
        !dbDispList.append(!dbDtext[!i])
        !dbReplList.append(!dbRtext[!i])
      enddo

      !this.dbs.dText = !dbDispList
      !this.dbs.rText = !dbReplList
    endif

    -- get details for first DB
    !this.dbListSelect( 1 )
  else
    !this.report.clear()
    !dbDispList[1] = 'No extract databases found'
    !this.dbs.dText = !dbDispList
    !this.dbListSelect( 1 )

  endif

  PROMPT DISMISS

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .dbListSelect()
--
-- Description: Select a DB from the list and report its information
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbListSelect( !dbListIndex is REAL)

  !extractElements = ARRAY()
  -- get name of database at given index
  !dbName = !this.dbs.rText[!dbListIndex]
  -- Abort if no extract DB's
  if( !dbName eq 'No extract databases found' ) then
    -- disable extract buttons
    !this.enableExtFunc(false)
    return
  endif
  -- create a DB object for the selected DB
  !db     = object DB( !dbName  )
  handle any
    -- db has probably been deleted
    !reply = !!alert.question( 'Database ' + !dbName + ' not found - it may have been deleted. Do you want to refresh the list?')
    if( !reply eq 'YES' ) then
      !this.init()
    endif
    return
  endhandle
  !dbRefNo = !db.refno.dbref()
  -- could be a master DB owning an extract hierarchy - set buttons active accordingly
  !isExtract = !dbRefNo.extown.set()
  !this.enableExtFunc(!isExtract)

  if( !this.display.val and !isExtract ) then
    -- show elements claimed to this Db
    VAR !extractElements split claimlist extract $!dbName
    handle any
      !extractElements[1] = 'none'
    endhandle
    !extractElements.insert(1,'Elements Extracted to this DB:')
  endif

  -- put a report on this DB into the report window
  !reportText = !this.dbList.getDbDetails(!this.dbs.rText[!dbListIndex])
  !reportText.appendArray(!extractElements)
  !this.report.dText = !reportText

endmethod
-- End of method definition for .dbListSelect()

------------------------------------------------------------------------
--
-- Method:      .sortByHierarchy()
--
-- Description: Sort DB's by hierarchy
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sortByHierarchy()

  !this.dbNames.clear()
  !this.dbShow.clear()

  !dbRefs = !this.dbList.getDbRefs()
  VAR !dbMasters COLLECT ALL WITH ( badref(EXTOWN) ) FROM !dbRefs

  do !masterDB values !dbMasters

    -- add master to output list
    !masterDbRef = !masterDB.dbref()
    if (!!sessionSettings.showAs eq |DESC|) then
      if( !masterDbRef.description.trim().empty() ) then
        -- use name if no description
        !this.dbShow.append(!masterDbRef.name.substring(3))
      else
        -- show DB descriptions
        !this.dbShow.append(!masterDbRef.description)
      endif
    else
      !this.dbShow.append(!masterDbRef.name.substring(3))
    endif
    !this.dbNames.append(!masterDbRef.name.substring(3))
    -- list extract hierarchy for this master
    !this.extractHierarchy(!masterDbRef, 1)

  enddo

  -- copy DB info to the form
  !this.dbs.dText = !this.dbShow
  !this.dbs.rText = !this.dbNames

endmethod
-- End of method definition for .sortByHierarchy()

------------------------------------------------------------------------
--
-- Method:      .extractHierarchy()
--
-- Description: Get DB hierarchy
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .extractHierarchy( !dbElement is DBREF, !level is REAL )

  -- set up indent string
  !indent = ' '
  do !i to !level
    !indent = '..' + !indent
  enddo

  -- loop through all child extracts for given DB
  do !childExtract values !dbElement.extcls
    if (!!sessionSettings.showAs eq |DESC|) then
      if( !childExtract.description.trim().empty() ) then
        -- use name if no description
        !this.dbShow.append(!indent + !childExtract.name.substring(3))
      else
        -- show DB descriptions
        !this.dbShow.append(!indent + !childExtract.description)
      endif
    else
      !this.dbShow.append(!indent + !childExtract.name.substring(3))
    endif
    !this.dbNames.append(!childExtract.name.substring(3))
    -- list next level down
    !this.extractHierarchy(!childExtract, !level + 1)
  enddo

endmethod
-- End of method definition for .extractHierarchy( DBREF, REAL )
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Drop/Issue/Flush/Refresh selected extract db element in list
--              Actions are DROP ISSUE FLUSH REFRESH
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [What action to take]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!passedAction is STRING)

  !dbName =  !this.dbs.rText[!this.dbs.val]
  handle any
    !this.dbListSelect(1)
    return
  endhandle
  !dbObject = object DB(!dbName)

  if( !passedAction eq 'DROP' ) then
    !reply = !!alert.question('Are you sure that you want to abort all changes? Changes to data will be lost')
    if( !reply ne 'YES' ) then
      return
    endif
  endif

  -- Operation on selected DB
  !temp = !dbObject.refno.dbref()
  !name = 'DB ' & !temp.name.substring(3)
  !action = !passedAction
  if (!action eq 'REFRESH' and !this.fullRefresh.selection() eq 'FULL') then
    !action = 'FULL' & !passedAction
  endif

  -- run command
  call !!admCommand(|EXTRACT $!action $!name|)
  handle any
    !!alert.error(!!error.text)
  elsehandle none
    if( !action eq 'DROP' ) then
      -- release claims after a DROP
      call !!admCommand(|EXTRACT RELEASE $!name|)
      handle any
        !!alert.error(!!error.text)
      endhandle
    endif
  endhandle

  if( !action inset('ISSUE','DROP') ) then
    -- clear the list
    !this.dbListSelect(!this.dbs.val)
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      .enableExtFunc()
--
-- Description: Set buttons active/inactive
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True to make action buttons active - false otherwise
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .enableExtFunc( !enabled is BOOLEAN )

  !this.actionRefresh.active = !enabled
  !this.actionFlush.active   = !enabled
  !this.actionDrop.active    = !enabled
  !this.actionIssue.active   = !enabled

endmethod
-- End of method definition for .enableExtFunc()
