--   Module:        admin
--   Replaces:
--
-- Author:          val w
-- Created:         feb 2010
--
--
-- Description:
-- Form definition to set a db range.
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admDBRange()                     -                   initialise form
--  cbApply()                        -                   Method to create a db range.
--  cbDismiss()                      -                   Method to make checks before dismissing DB Range form
--  init()                           -                   initialise form
--  setDBNo(STRING)                  -                   method to set the from and to database number range values.
--

-- Define form
setup form !!admDBRange

  !this.formTitle     = 'DB number Range'
  !this.iconTitle     = 'DBR'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition

  frame .extractNos  |Database Number Range|
    text .from at xmin+2 ymax |From | width 6 INTEGER min 10000 max 250000
    text .to   at xmax+4 ymin |To |   width 6 INTEGER min 10000 max 250000
  exit

  button .apply   at x 0 ymax+0.5        |Apply|   APPLY
  button .dismiss at xmax form-size ymin |Dismiss|

  -- Member Definitions

exit

-- End of form definition for !!admDBRange
------------------------------------------------------------------------
--
-- Method:      .admDBRange()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------

define method .admDBRange()

  --!this.from.callback        = |!this.checkExtNo(!this.from)|
  --!this.to.callback          = |!this.checkExtNo(!this.to)|
  !this.apply.callback       = |!this.cbApply()|
  !this.dismiss.callback       = |!this.cbDismiss()|
  !this.from.val = '10000'
  !this.to.val   = '250000'

endmethod
-- End of method definition for .admDBRange()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------

define method .init()


  !!globalProject = !!admControl.isValid('Global')

  if(!!globalProject)then
     !currentLocation = !!dbrGlbCurLocRf()
     if(!currentLocation neq !!dbrGlbHubLocRf()) then
       !!alert.error('You can only set database number ranges at the hub')
       return
     endif

     call !!admCommand(|/*GS|)
  else
     call !!admCommand(|/*S|)
  endif

  -- create DBRANG element if one does not already exist
  call !!admCommand(|DBRANG 1|)
  handle any
    call !!admCommand(|NEW DBRANG|)
    handle any
       !!alert.error(!!error.text)
    endhandle

    -- set DBRBEG and DBREND attributes
    !this.setDBNo('FROM')
    !this.setDBNo('TO')
  elsehandle none
    -- Initialise from existing element
    !this.from.val = !!ce.dbrbeg.string()
    !this.to.val   = !!ce.dbrend.string()
  endhandle

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      .setDBNo(!which is STRING)
--
-- Description: method to set the from and to database number range values.
--
-- method Type:   Function/Procedure
--
------------------------------------------------------------------------

define method .setDBNo(!which is STRING)


  if(!which.eq('FROM')) then
    !from = !this.from.val.real()
     call !!admCommand(|DBRBEG $!from|)
     handle any
       !!alert.error(!!error.text)
     endhandle
  else
     !to = !this.to.val.real()
     call !!admCommand(|DBREND $!to|)
     handle any
       !!alert.error(!!error.text)
     endhandle
  endif

endmethod
-- End of method definition for .setDBNo(STRING)

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: Method to create and modify DB Range elements.
--
------------------------------------------------------------------------
--
-- Method Type:   Function/Procedure
--
------------------------------------------------------------------------

define method .cbApply()

  -- Initialise variables

  !from            = !this.from.val.real()
  !to              = !this.to.val.real()

  if( !from.unset() or !to.unset() ) then
    !!alert.error('Database number range has unset value')
    return
  endif

  if( !from gt !to ) then
    !!alert.error('From value must be less than To value')
    !this.setDBNo('FROM')
    !this.setDBNo('TO')
    return
  endif

   -- set DBRBEG and DBREND numbers
  call !!admCommand(|DBRBEG $!from|)
  handle any
    !!alert.error(!!error.text)
    !this.setDBNo('FROM')
    !this.setDBNo('TO')
  endhandle

  call !!admCommand(|DBREND $!to|)
  handle any
  !!alert.error(!!error.text)
  !this.setDBNo('FROM')
  !this.setDBNo('TO')
  endhandle

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method:      .cbDismiss()
--
-- Description: Method to dismiss DB Range form
--
------------------------------------------------------------------------
--
-- Method Type:   Function/Procedure
--
------------------------------------------------------------------------

define method .cbDismiss()

  -- Initialise variables

  !from            = !this.from.val.real()
  !to              = !this.to.val.real()

  if( !from.unset() or !to.unset() ) then
    -- Do nothing
    !this.hide()
    return
  endif

  if( !from gt !to ) then
    !!alert.error('From value must be less than To value')
    !this.setDBNo('FROM')
    !this.setDBNo('TO')
  else
    !this.hide()
  endif

endmethod
-- End of method definition for .dismiss()
