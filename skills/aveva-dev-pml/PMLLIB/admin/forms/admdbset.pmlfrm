-- Created:         Tue Mar 30 9:41:00 GMT 1999
--
--
-- Description:
-- A form, with members to handle dbSets, with functions to perform dbSet verification.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   Method to create and modify dbset elements.
--  cbDbAdd(STRING)                  -
--  cbDbSetAdd(STRING)               -
--  cbMode()                         -                   Callback to the mode gadget in the Location Definition form.
--  cbName(GADGET)                   -                   Method to act as a callback to the Name gadget in the dbset form.
--  createSubForms(STRING,STRING)    FORM
--  dbSetGet()                       DBREF               A method to return the current dbset
--  dbSetSet(DBREF)                  -                   A method to set the current method
--  display(STRING)                  -                   Method to display the dbset definition form.
--  init()                           -                   initialise form
--  killSubForms()                   -
--  list(STRING)                     -                   This function will take the forms members containing
--  modeGet()                        STRING              Function to return the current mode of the LOC Definition form.
--  modeSet(STRING)                  -                   Method to set the mode of the LOC Definition form.
--  moveElements(REAL)               -                   move a continuous block elements up or down!
--  remove()                         -                   acts as the call back function for remove from all members list
--  removeAll()                      -                   remove all elements from the  members list
--  resetForm()                      -                   callback function for reset button
--  snapshot(STRING)                 -
--  stopRecursion(DBREF,STRING,ARRAY) BOOLEAN             This function will take the arg which is an array of DbRefs
--  update()                         -                   method to update the displayed dbset in the dbset Definition
--  validSelection()                 BOOLEAN             This function will check to see if the user has selected
--
------------------------------------------------------------------------

setup form !!admDbSet resize

  !this.formTitle     = 'DBSET Definition'
  !this.iconTitle     = 'ADMDBSET'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.12 $ '

  -- Body of form definition
  text   .name anchor top+left+right at x 0.5 y 0.2 |Name        | call |!this.cbName(!this.name)|  width 20 scroll 49 NAME
  path down
  text   .desc  anchor top+left+right |Description | width 32 scroll 120 STRING
  valign bottom


  list   .nonMemberSets anchor top+left+right |Non Members DB Sets| call || MULTIPLE columns width 44 height 12

  option .setSort anchor top+left |Sort By| call |!this.list('OTHERDBSETS')| width 11
  text   .setFilter anchor top+left at xmax+1 ymin |Filter|  call |!this.list('OTHERDBSETS')| width 14 STRING
  button .addSets anchor top+right at xmax.nonMemberSets+0.5 ymin.nonMemberSets+2 call |!this.cbDbSetAdd(!this.whereToAdd.selection())| pixmap width 16 height 16

  list   .nonMemberDbs anchor all |Non Member DBs|  at xmin.nonMemberSets ymax.setFilter+0.5 call | | MULTIPLE columns width 44 height 12

  option .dbSort anchor bottom+left |Sort By| call |!this.list('OTHERDBS')| width 11
  text   .dbFilter anchor bottom+left at xmax+1 ymin |Filter|  call |!this.list('OTHERDBS')| width 14 STRING
  button .addDbs anchor top+right at xmax.nonMemberDbs+0.5 ymin.nonMemberDbs+2 call |!this.cbDbAdd(!this.whereToAdd.selection()) | pixmap width 16 height 16

  list .members anchor top+bottom+right |Members (Ordered)| at xmax.addSets+0.5 ymin.nonMemberSets call | | MULTIPLE width 30 height 28

  rgroup .whereToAdd anchor top+right at xmin.members ymin.name | Add Elements | FRAME HORIZONTAL callback ||
    add tag |After |  select |AFTER|
    add tag |Before | select |BEFORE|
  exit

  button .up          anchor right at xmax.members+0.2 ymin.members+9 |Up| call |!this.moveElements(-1)|
  path down
  button .down        anchor right |Down|     call |!this.moveElements(1)|
  button .remove      anchor right |Remove|   call |!this.remove()|
  button .dbSnapshot  anchor bottom+right at xmin.members ymax.members |List ALL member DBs... | call |!this.snapshot('DB')|
  button .setSnapshot anchor bottom+right |List ALL member Sets...| call |!this.snapshot('DBSET')|

  option .mode    anchor top+right at xmax.whereToAdd+3 ymin.name call |!this.cbMode()| width 8
  button .apply   anchor bottom+left at xmin.name ymax.dbSort+0.5 |Apply| call |!this.cbApply()| APPLY
  button .reset   anchor bottom at xcen form-0.5 * size ymin |Reset| callback |!this.resetForm()| RESET
  button .dismiss anchor bottom+right at xmax form-size ymin |Dismiss| call |!this.killSubForms()| CANCEL

  menu .dbPopupMenu
    !this.dbPopupMenu.add(|CALLBACK|,|Select All DBs|,|!this.nonMemberDbs.select('rtext',!this.nonMemberDbs.rText)|)
    !this.dbPopupMenu.add(|CALLBACK|,|(DE)Select a Set of DBs...|,|!!admSelectDbSet.display(!this.nonMemberDbs)|)
    !this.dbPopupMenu.add(|CALLBACK|,|Clear Selection|,|!this.nonMemberDbs.clearSelection()|)

  !this.nonMemberDbs.setPopup(!this.dbPopupMenu)

  --Member Variables
  -- Set under scrutiny
  member .dbSet         is DBREF

  -- It's Members before Changes
  member .ordExistAll   is ARRAY
  member .allExistDb    is ARRAY
  member .allExistDbSet is ARRAY
  -- Current members
  member .ordCurrAll    is ARRAY
  -- Current Non-Members
  member .allNonMemDbs  is ARRAY
  member .allNonMemSets is ARRAY

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  --- Assign Mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !this.mode.dText  = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !this.mode.rText  = !rText
  !rText.clear()

exit
-- End of form definition for !!admDbSet
  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  --- Assign Mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !this.mode.dText  = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !this.mode.rText  = !rText
  !rText.clear()
  -- assign pixmaps to buttons
  !this.addSets.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !this.addDbs.addPixmap(!!pml.getPathName('rightarrow16.png'))

------------------------------------------------------------------------
--
-- Method: .dbSetGet()
--
-- Description: A method to return the current dbset
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--  DBREF       The current dbset funnily enough!
------------------------------------------------------------------------
define method .dbSetGet() is DBREF
  return !this.dbSet
endmethod
-- End of method definition for .dbSetGet() DBREF
------------------------------------------------------------------------
--
-- Method: .dbSetSet()
--
-- Description: A method to set the current method
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R            DBREF       The dbset the current form is to be set to!
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dbSetSet(!dbRef is DBREF)
  !this.dbSet = !dbRef
endmethod
-- End of method definition for .dbSetSet(DBREF)
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
  !prev = !!ce

  -- Initialise variables
  !mode    = !this.modeGet()
  !dbRef   = !this.dbSetGet()
  -- Clear the Lists
  !this.members.clear()
  !this.nonMemberDbs.clear()
  !this.nonMemberSets.clear()
  -- Clear the Member Variables
  !this.ordExistAll.clear()
  !this.allExistDb.clear()
  !this.allExistDbSet.clear()
  !this.ordCurrAll.clear()
  !this.allNonMemDbs.clear()
  !this.allNonMemSets.clear()
  --Get All Sets and DBs
  !!ce = !!dbrAdminGetWorld('DBSET')
  !allSets = !!ce.mem
  if(!!glbIsGlobal())then
    !!ce = !!adminApplic.getAdmContext()
    1
    !allDbs = !!ce.mem
  else
    -- I would have liked to use DBS but that gives dbs as opposed to DbRefs and the code becomes more complicated
    !!ce = !!dbrAdminGetWorld('TEAM')
    !allDbs = !!collectAllFor('DB'  ,'',!!ce)
  endif
  -- Check the current mode
  if (!mode eq 'CREATE') then
    -- Set the form title
    !this.formTitle  = 'Create DB Set'
    -- Set the form gadgets
    !this.name.val   = |unset|
    !this.desc.val   = |unset|
    !this.allNonMemSets = !allSets
    !this.allNonMemDbs = !allDbs
  elseif (!mode eq 'MODIFY') then
    -- Set the form title
    !this.formTitle  = 'Modify DB Set: ' + !dbRef.name.substring(2)
    -- Set the form gadgets
    !this.name.val   = !dbRef.name.substring(2)
    if (!dbRef.description.empty()) then
      !this.desc.val   = |unset|
    else
      !this.desc.val   = !dbRef.description
    endif
    !!ce = !this.dbSetGet()
    -- Set up Member Variables
    !this.ordExistAll    = DBSLEV
    do !i values !this.ordExistAll
      if(!i.type EQ |DB|)then
        !this.allExistDb.append(!i)
      elseif(!i.type EQ |DBSET|)then
        !this.allExistDbSet.append(!i)
      endif
    enddo
    !this.ordCurrAll     = !this.ordExistAll
    !this.allNonMemDbs   = !allDbs.difference(!this.allExistDb)
    !this.allExistDbSet = !this.allExistDbSet
    -- Can not add current dbset to a dbset, stupid!
    !this.allExistDbSet.append(!dbRef)
    !this.allNonMemSets  = !allSets.difference(!this.allExistDbSet)
  endif
  -- Set up filter and sort gadgets
  !this.dbFilter.val   = |*|
  !this.setFilter.val   = |*|
  !!admDbSetSortGadg(!this.setSort)
  !!admDbSortGadg(!this.dbSort)
  !this.list(|ALL|)
  !!ce = !prev
endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      .update()
--
-- Description: method to update the displayed dbset in the dbset Definition
-- form. The form must be displayed and in MODIFY mode.
--
------------------------------------------------------------------------
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update()

  -- Return if the form is not shown
  if (Undefined (!!admDbSet) or not !this.shown()) then
    return
  endif

  -- Initialise variables
  !mode    = !this.modeGet()
  !selLoc  = !!adminElem.dbSetGet()
  !curLoc  = !this.dbSetGet()

  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif

  -- Return if the same reference
  if (!selLoc eq !curLoc) then
    return
  endif

  -- Reinitialise the form
  !this.dbSetSet(!selLoc)
  !this.init()

endmethod
-- End of method definition for .update()
------------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Method to display the dbset definition form.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display form in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display(!mode is STRING)
  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY') then
    -- Invalid mode
    return error |Invalid mode for form !!admTeam|
  endif
  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then
    !this.dbSetSet(object DBREF())
  elseif (!mode eq 'MODIFY') then
    !dbRef   = !!adminElem.dbSetGet()
    if (!dbRef.unset()) then
      -- No action required
      return
    elseif (!dbRef eq !this.dbSetGet() and !this.shown()) then
      -- No action required
      return
    endif
    -- Set the new locations
    !this.dbSetSet(!dbRef)
  endif
  -- Select the mode
  !this.modeSet(!mode.upcase())
  -- Show or update the form
  if (!this.shown()) then
    -- Re-Initialise the form
    !this.init()
  else
    -- Show the form
    show !!admDbSet free
  endif
endmethod
-- End of method definition for .display(STRING)
------------------------------------------------------------------------
--
-- Method:      .modeGet()
--
-- Description: Function to return the current mode of the LOC Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Mode of form.
--
-----------------------------------------------------------------------
define method .modeGet() is STRING
  -- Return the mode
  return !this.mode.selection('rtext')
endmethod
-- End of method definition for .modeGet() STRING
------------------------------------------------------------------------
--
-- Method:      .modeSet()
--
-- Description: Method to set the mode of the LOC Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       STRING      Mode to set (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modeSet(!mode is STRING)
  -- Store the mode gadget
  !this.mode.select('rtext',!mode.upcase())
  handle any
    -- Dummy handle (should not happen)
  endhandle
endmethod
-- End of method definition for .modeSet(STRING)
------------------------------------------------------------------------
--
-- Method:      .cbMode()
--
-- Description: Callback to the mode gadget in the Location Definition form.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .cbMode()
  -- Read the mode value
  !mode    = !this.modeGet()
  -- Call the display method to reset the form
  !this.display(!mode)
endmethod
-- End of method definition for .cbMode()
------------------------------------------------------------------------
--
-- Method:      .cbName()
--
-- Description: Method to act as a callback to the Name gadget in the dbset form.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define Method
define method .cbName(!gadget is GADGET)
   -- Initialise variables
  !mode           = !this.modeGet()
  !name           = !gadget.val
  !curDbRef       = !this.dbSetGet()
  -- Check to see if name converts to a dbref
  !dbRef          = !name.dbRef()
  handle any
    !name         = '/' + !name
    !dbRef        = !name.dbRef()
    handle any
      -- Element name not used
      return
    endhandle
  endhandle
  -- Check for unset name
  if( !mode eq 'CREATE' and !dbRef.unset() ) then
     !gadget.val   = |unset|
     return
  endif
  -- Check to see if dbref matches current location
  if (!dbRef eq !curDbRef) then
    return
  endif
  -- Element name already used (Bad)
  -- Reset value based on mode
  if (!mode eq 'CREATE') then
    !!alert.error('Name ' & !gadget.val & ' already used or invalid name format')
    !gadget.val   = |unset|
  elseif (!mode eq 'MODIFY') then
    !gadget.val   = !curDbRef.name.substring(2)
  endif
  -- Raise error
  --  !!messageFile.error(141, 504, !dbRef.name)
endmethod
-- End of method definition for .cbName(GADGET)

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: Method to create and modify dbset elements.
--
------------------------------------------------------------------------
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .cbApply()
  -- Initialise variables
  !dbRef            = !this.dbSetGet()
  !mode             = !this.modeGet().upcase()
  !updateFlag       = false
  !prev             = !!ce
  !name             = !this.name.val
  !desc             = !this.desc.val

  --Phase 1 create elements, if new dbset create elements in order!
  if(!mode eq |CREATE|)then
    if (!name.upcase() eq |UNSET|) then
      -- ##
      !!alert.error(|Please enter a valid name|)
      return
    endif
    /*DS
    NEW DBSET /$!name
    handle any
      !!alert.error(!!error.text)
      DELETE DBSET
      return
    endhandle
    !!ce.description = !desc
    handle any
      !!alert.error(!!error.text)
      DELETE DBSET
      return
    endhandle
    SET DBSET /$!name
    -- Create command strings (there will be many, as if there are many items to add it will not fit into one command)
    do !i values !this.ordCurrAll
      !type = !i.type
      if(!type EQ |DB|)then
        !name = !i.name.substring(3)
      else
        !name = !i.name
      endif
      DADD $!type $!name
      handle any
        !!alert.error(!!error.text)
      endhandle
    enddo
    !updateFlag = TRUE
  elseif(!mode eq |MODIFY|)then
    !!ce = !dbRef
    if(!name NEQ !dbRef.name.substring(2))then
      !temp = '/' + !name
      NAME $!temp
      !updateFlag = TRUE
    endif
    if(!desc NEQ !dbRef.description)then
      !!ce.description = !desc
      !updateFlag = TRUE
    endif
    if(!this.ordExistAll NEQ !this.ordCurrAll)then
      SET DBSET /$!name
      --Iterate through Original Members and find out if the are to be removed!
      do !i values !this.ordExistAll
        if(!i.type EQ |DB|)then
          !dName = !i.name.substring(3)
        else
          !dName = !i.name
        endif
        !curType = !i.type
        !aIndex = object REAL()
        !aIndex = !this.ordCurrAll.findFirst(!i)
        skip if(!aIndex.set())
        -- This original has not been found hence it must be removed
        DREMOVE $!curType $!dName
        !updateFlag = TRUE
      enddo
      do !i values !this.ordCurrAll
        if(!i.type EQ |DB|)then
          !bName = !i.name.substring(3)
        else
          !bName = !i.name
        endif
        !curType = !i.type
        !bIndex = object REAL()
        !bIndex = !this.ordExistAll.findFirst(!i)
        skip if(!bIndex.set())
        -- This original has not been found hence it must be added
        DADD $!curType $!bName
        !updateFlag = TRUE
      enddo

      --Phase 2 if old dbset reorder elements
      !size =  !dbRef.mem.size()
      do !x to !size
        do !y from !x to !size
          if(!dbRef.mem[!y].type EQ |DBSTL|)then
            if(!this.ordCurrAll[!x] EQ !dbRef.mem[!y].dbsTf)then
              if(!x NEQ !y)then
                !!comMemberSwap(!x,!y, !dbRef)
                !updateFlag = TRUE
                break
              else
                break
              endif
            endif
          elseif(!dbRef.mem[!y].type EQ |DBL|)then
            if(!this.ordCurrAll[!x] EQ !dbRef.mem[!y].dbf)then
              if(!x NEQ !y)then
                !!comMemberSwap(!x,!y, !dbRef)
                !updateFlag = TRUE
                break
              else
                break
              endif
            endif
          endif
        enddo
      enddo

    endif
  endif
  -- Check to see if the Admin Elements form needs refreshing
  if (!updateFlag) then
    !!adminElem.update('DBSET')
  endif
  -- Reset the form for creation (if applicable)
  if (!mode eq 'CREATE') then
    !this.display('CREATE')
  endif
  !!ce = !prev
endmethod
-- End of method definition for .cbApply()
------------------------------------------------------------------------
--
--Method: .cbDbSetAdd()
--
-- Description:
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      The position to add the selected elements
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbDbSetAdd(!position is STRING)

  if(!this.nonMemberSets.val.size() LT 1)then
    -- Nothing to do, user is being silly!
    return
  endif

  !tempArr = !this.members.val
  !tempArr.sort()
  !this.members.val = !tempArr

  if( !this.members.dText.size() LT 1 )then
    !val2InsertBefore = 1
  elseif(!this.members.val.size() EQ 0)then
    if(!position eq |BEFORE|)then
      !val2InsertBefore = 1
    elseif(!position eq |AFTER|)then
      !val2InsertBefore = !this.members.dText.size() + 1
    endif
  elseif(!position eq |BEFORE|)then
    !val2InsertBefore = !this.members.val.first()
  elseif(!position eq |AFTER|)then
    !val2InsertBefore = !this.members.val.last() + 1
  endif

  -- Position of set to move!
  !arrayOfIndices = !this.nonMemberSets.val

  !anArray = ARRAY()
  -- Iterate through indices add them to an array to add to the ordCurrAll form variable
  -- remove same DbRefs
  do !i values !arrayOfIndices
    !temp = !this.nonMemberSets.rText[!i].dbRef()
    !errorMessage = | |
    if(!this.stopRecursion(!temp, !errorMessage, !anArray))then
      !anArray.append(!temp)
      -- it has just got to be there, it must!
      -- if this function does a deep level comparison it may take a long time!
      !index = !this.allNonMemSets.findFirst(!temp)
      !this.allNonMemSets.remove(!index)
    else
      -- Failed this could have caused recursion!
      -- ## these error messages are not stored in the messagefile.dat thing
      !!alert.error(!errorMessage)
      !answer = !!alert.question(|Continue processing additions? Press cancel to abort ALL additions|)
      if(!answer EQ |CANCEL|)then
        return
        -- having done nothing!
      elseif(!answer EQ |NO|)then
        break
      endif
    endif
  enddo

  -- Update form member containing an ordered list of dbSets
  !this.ordCurrAll.insertArray(!val2InsertBefore, !anArray)

  -- Now relist all gadgets that have changed
  !this.list(|ORDEREDMEM|)
  !this.list(|OTHERDBSETS|)


endmethod
-- End of method definition for .cbDbSetAdd(STRING)
------------------------------------------------------------------------
--
--Method: .cbDbAdd()
--
-- Description:
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      The position to add the selected elements
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbDbAdd(!position is STRING)

  if(!this.nonMemberDbs.val.size() LT 1)then
    -- Nothing to do, user is being silly!
    return
  endif

  !tempArr = !this.members.val
  !tempArr.sort()
  !this.members.val = !tempArr

  if( !this.members.dText.size() LT 1 )then
    !val2InsertBefore = 1
  elseif(!this.members.val.size() EQ 0)then
    if(!position eq |BEFORE|)then
      !val2InsertBefore = 1
    elseif(!position eq |AFTER|)then
      !val2InsertBefore = !this.members.dText.size() + 1
    endif
  elseif(!position eq |BEFORE|)then
    !val2InsertBefore = !this.members.val.first()
  elseif(!position eq |AFTER|)then
    !val2InsertBefore = !this.members.val.last() + 1
  endif

  -- Position of set to move!
  !arrayOfIndices = !this.nonMemberDbs.val

  !anArray = ARRAY()
  -- Iterate through indices add them to an array to add to the ordCurrAll form variable
  -- remove same DbRefs
  do !i values !arrayOfIndices
    !temp = !this.nonMemberDbs.rText[!i].dbRef()
    !errorMessage = | |
    if(!this.stopRecursion(!temp, !errorMessage, !anArray))then
      !anArray.append(!temp)
      -- it has just got to be there, it must!
      -- if this function does a deep level comparison it may take a long time!
      !index = !this.allNonMemDbs.findFirst(!temp)
      !this.allNonMemDbs.remove(!index)
    else
      -- Failed this could have caused recursion!
      -- ## these error messages are not stored in the messagefile.dat thing
      !!alert.error(!errorMessage)
      !answer = !!alert.question(|Continue processing additions? Press cancel to abort ALL additions|)
      if(!answer EQ |CANCEL|)then
        return
        -- having done nothing!
      elseif(!answer EQ |NO|)then
        break
      endif
    endif
  enddo

  -- Update form member containing an ordered list of dbSets
  !this.ordCurrAll.insertArray(!val2InsertBefore, !anArray)
  -- Now relist all gadgets that have changed
  !this.list(|ORDEREDMEM|)
  !this.list(|OTHERDBS|)



endmethod
-- End of method definition for .cbDbAdd(STRING)

------------------------------------------------------------------------
--
--Method: .list()
--
-- Description: This function will take the forms members containing
-- details about member and non-member dbs and display then in the relevant
-- gadgets
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1    R      STRING     Is an identifier for which gadget to display text for( handles Sorting to)
--                          ALL, OTHERDBS, OTHERDBSETS, ORDEREDMEM
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .list(!whichGadget is STRING)

  if( (!whichGadget EQ |OTHERDBSETS|) OR (!whichGadget EQ |ALL|) )then

    !dbSetRefs  = !!adminFilterSort(!this.allNonMemSets, !this.setSort, !this.setFilter)
    !!admDbSetTxtList(!dbSetRefs, !this.nonMemberSets,!!admDisplayConfig.fmtDbSetGet(), !!admDisplayConfig.eleTypeGet())
  endif
  if( (!whichGadget EQ |OTHERDBS|) OR (!whichGadget EQ |ALL|) )then

    !dbRefs     = !!adminFilterSort(!this.allNonMemDbs, !this.dbSort, !this.dbFilter)
    if(!!glbIsGlobal())then
      !!adminDbTxtList(!dbRefs, !this.nonMemberDbs, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(),!!adminApplic.getAdmContext())
    else
      !!adminDbTxtList(!dbRefs, !this.nonMemberDbs, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(),object DBREF())
    endif
  endif
  if( (!whichGadget EQ |ORDEREDMEM|) OR (!whichGadget EQ |ALL|) )then
    --Display Text of Existing Members
    !dText = ARRAY()
    !rText = ARRAY()
    -- Include header or not
    !useHeader = !!admDisplayConfig.eleTypeGet()
    do !i values !this.ordCurrAll
      if(!i.type EQ |DB|)then
        if( !useHeader ) then
          !displayText = |<DB>    | + !i.name.substring(3)
        else
          !displayText = || + !i.name.substring(3)
        endif
      elseif(!i.type EQ |DBSET|)then
        if( !useHeader ) then
          !displayText = |<DBSET> | + !i.name.substring(2)
        else
          !displayText = || + !i.name.substring(2)
        endif
      endif
      !dText.append(!displayText)
      !rText.append(!i.name)
    enddo
    !this.members.dText = !dText
    !this.members.rText = !rText
  endif
endmethod
-- End of method definition for .list(STRING)
------------------------------------------------------------------------
--
--Method: remove()
--
-- Description: acts as the call back function for remove from all members list
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remove()
  !txtOfDbRefs = !this.members.selection(|RTEXT|)
  !aDbRef = object DBREF()
  do !i values !txtOfDbRefs
    !temp = !i.dbRef()
    if(!temp.type eq |DB|)then
      !aDbRef = !temp
      !this.allNonMemDbs.append(!temp)
      !index = !this.ordCurrAll.findFirst(!temp)
      !this.ordCurrAll.remove(!index)
    elseif(!temp.type eq |DBSET|)then
      !aDbRef = !temp
      !this.allNonMemSets.append(!temp)
      !index = !this.ordCurrAll.findFirst(!temp)
      !this.ordCurrAll.remove(!index)
    endif
  enddo
  if(!aDbRef.set() AND !aDbRef.type EQ |DB|)then
    !this.list(|OTHERDBS|)
    !this.list(|ORDEREDMEM|)
  elseif(!aDbRef.set() AND !aDbRef.type EQ |DBSET|)then
    !this.list(|OTHERDBSETS|)
    !this.list(|ORDEREDMEM|)
  endif
endmethod
-- End of method definition for .remove()
------------------------------------------------------------------------
--
--Method: .stopRecursion()
--
-- Description: This function will take the arg which is an array of dbRefs
-- and strip out the duplicates in the dbSet list and the db list
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      ARRAY       Array of DbRefs
--   2   RW     STRING      IF RESULT this is the error message to return
-- Return:
--  [Data Type] [Description]
--   BOOLEAN     True or False if this dbRef is suitable to add
--
------------------------------------------------------------------------
define method .stopRecursion(!dbRef is DBREF, !errorMessage is STRING, !anArray is ARRAY) is BOOLEAN

 !temp = !this.ordCurrAll
 -- get array of current member and members already checked
 !temp.appendArray(!anArray)
 !arrayToCheck = !temp


 if(!dbRef.type EQ |DB|)then
 -- check that this db is not a member of a dbSet already in this set
   do !j values !arrayToCheck
     skip if(!j.type NEQ |DBSET|)
     !dbsInDbSet = !j.dbsList
     do !k values !dbsInDbSet
       skip if(!k NEQ !dbRef)
       !errorMessage = |DB | + !dbRef.name + | is a member of Set | + !j.name + | which is a member of the current set and hence this DB cannot be added|
       return false
     enddo
   enddo
 elseif(!dbRef.type EQ |DBSET|)then
 -- check that this dbSet does not contain any dbs already in the set
 -- check that no dbSet contains this dbSet
   do !j values !arrayToCheck
     if(!j.type EQ |DB|)then
       !dbsInDbSet = !dbRef.dbsList
       do !k values !dbsInDbSet
         skip if(!k NEQ !j)
         !errorMessage = |DB Set | + !dbRef.name + | contains DB | + !j.name + | which is a member of the current set and hence this Set cannot be added|
         return false
       enddo
     elseif(!j.type EQ |DBSET|)then
       !dbSetsInDbSet = !dbRef.dbsHie
       do !t values !dbSetsInDbSet
         skip if(!t NEQ !j)
         !errorMessage = |DB Set | + !j.name + | is contained in DB Set | + !dbRef.name + | as | +!j.name + | is a member of the current set, this Set cannot be added|
         return false
       enddo
       !dbSetsInOther = !j.dbsHie
       do !s values !dbSetsInOther
         skip if(!s NEQ !j)
         !errorMessage = |DB Set | + !dbRef.name + | is contained in DB Set | + !j.name + | as | +!j.name + | is a member of the current set, this Set cannot be added|
         return false
       enddo

     endif
   enddo
 endif
 return true
endmethod
-- End of method definition for .stopRecursion(DBREF, STRING, ARRAY) BOOLEAN
------------------------------------------------------------------------
--
--Method: .validSelection
--
-- Description: This function will check to see if the user has selected
-- a valid block of elements to reorder! A valid selection is a continuous block
-- of 1 or more elements
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--    BOOLEAN     IF the selection is valid
------------------------------------------------------------------------
define method .validSelection() is BOOLEAN
  if(!this.members.val.size() EQ 0)then
    return false
    -- empty selection
  endif

  !selection = !this.members.val
  -- Only check further if more than 1 item selected
  if(!selection.size() GT 1)then
    !selection.sort()
    do !i indices !selection
      skip if(!i EQ 1)
      if( !selection[(!i - 1)] NEQ (!selection[!i] - 1))then
        -- This is not a continuous block. Warn user
        !!alert.error(|Please select a continuous block of elements to reorder|)
        return false
      endif
    enddo
  endif
  return true

endmethod
-- End of method definition for .validSelection() BOOLEAN
------------------------------------------------------------------------
--
--Method: moveElements()
--
-- Description: move a continuous block elements up or down!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      REAL         Direction to move elements in up equals -1 down +1
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveElements(!direction is REAL)
  if(!this.validSelection())then
    !selection = !this.members.val
    !selection.sort()
    -- User has a block start at element 1 and they want to move the block up
    if((!selection.first() eq 1) AND (!direction EQ -1))then
      return
      -- in shame!
    endif
    -- User has a block start at the end and they want to move the block down
    if((!selection.last() eq !this.members.dText.size()) AND (!direction EQ 1))then
      return
      -- in shame!
    endif
    !tempArray = ARRAY()
    do !i values !selection
      !tempArray.append(!this.ordCurrAll[!i])
    enddo
    if(!direction EQ 1)then

      !overWriteValues = !this.ordCurrAll.overlay(!selection.first() + 1, !tempArray)
      !this.ordCurrAll[!selection.first()] = !overWriteValues.last()

    elseif(!direction EQ -1)then

      !overWriteValues = !this.ordCurrAll.overlay(!selection.first() - 1, !tempArray)
      !this.ordCurrAll[!selection.last()] = !overWriteValues.first()


    endif
    do !i indices !selection
      !selection[!i] = !selection[!i] + !direction
    enddo

    !this.list(|ORDEREDMEM|)

    !this.members.val = !selection

  endif
endmethod
-- End of method definition for .moveElements(REAL)
------------------------------------------------------------------------
--
--Method: .snapshot()
--
-- Description:
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      Whether to list to DB s  or DBSET s
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .snapshot(!type is STRING)
  !formsName = ||
  do !i from 1000 by 1 to 2000
    show !!admDbSet$!i
    handle (61,123)
      -- Variable doesn't exist hence can be used to create a form
      !formsName = |!!admDbSet| + !i.string()
      break
    endhandle
  enddo
  if(!formsName EQ ||)then
    --No free form variable - Note currently 1000 is an arbitrary limit
    return
  endif

  -- Make sure ce is pointing to the right element
  !tempArray = ARRAY()
  if(!type EQ |DB|)then
    do !i values !this.members.rText
      if(!i.dbRef().type EQ |DB|)then
        !tempArray.append(!i.dbRef())
      else
        -- a dbset
        !tempArray.appendArray(!i.dbRef().dbsList)
      endif
    enddo
    !formRef = !this.createSubForms(!formsName, !type )
    if(!!glbIsGlobal())then
      !!adminDbTxtList(!tempArray, !formRef.output, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(),!!adminApplic.getAdmContext())
    else
      !!adminDbTxtList(!tempArray, !formRef.output, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(),object DBREF())
    endif
  else
    do !i values !this.members.rText
      skip if(!i.dbRef().type EQ |DB|)
      -- a dbset
      !tempArray.append(!i.dbRef())
      !tempArray.appendArray(!i.dbRef().dbsHie)
    enddo
    !formRef = !this.createSubForms(!formsName, !type )
    !!admDbSetTxtList(!tempArray, !formRef.output,!!admDisplayConfig.fmtDbSetGet(), !!admDisplayConfig.eleTypeGet())
  endif

  !this.cancelCall = '!this.killSubForms()'
endmethod
-- End of method definition for .snapshot(STRING)
------------------------------------------------------------------------
--
--Method: .killSubForms()
--
-- Description:
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .killSubForms()
  do !i from 1000 by 1 to 2000
    kill !!admDbSet$!i
    handle (61,123)
    endhandle
  enddo
endmethod
-- End of method definition for .killSubForms()
------------------------------------------------------------------------
--
--Method: .createSubForms()
--
-- Description:
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createSubForms(!formsName is STRING, !type is STRING) is FORM
  !form = ARRAY()
  !form[1] = |Setup Form | + !formsName + | resize|

  if(!type EQ |DB|)then
    !form[2] = !formsName + |.formTitle     = 'A Snapshot'|
    !form[3] = !formsName + |.iconTitle     = 'ALL DBs'|
    !form[4] = |list .output  at x 0 y 0 anchor all 'ALL DBs (Ordered)' at xmin ymax+0.2 MULTIPLE columns width 30 height 25 |
  else
    !form[2] = !formsName + |.formTitle     = 'A Snapshot'|
    !form[3] = !formsName + |.iconTitle     = 'ALL DBSETs'|
    !form[4] = |list .output  at x 0 y 0 anchor all 'ALL DBSETs (Ordered)' at xmin ymax+0.2 MULTIPLE  columns width 30 height 25 |
  endif
  !form[5] = |button .dismiss at xmax form-size ymax anchor bottom+right 'Dismiss' CALL 'kill | + !formsName + |'|
  !form[6] = |!admDbSetTemp  = !this|
  !form[7] = |EXIT|

  do !t values !form
    $!t
  enddo

  show $!formsName

  return !admDbSetTemp

endmethod
-- End of method definition for .killSubForms()

-------------------------------------------------------------------------
--
--Method: resetForm()
--
-- Description: callback function for reset button
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------

define method .resetForm()
  !mode    = !this.modeGet()
   if ( !mode.upcase() eq 'CREATE') then
     !this.removeAll()
    else
      !this.init()
  endif

endmethod

-------------------------------------------------------------------------
--
--Method: removeAll()
--
-- Description: remove all elements from the  members list
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeAll()
      -- Clear all Members
   !noOfDbRefs = !this.members.count
   do !i to !noOfDbRefs
   !temp = !this.members.rText[!i].dbRef()
   if(!temp.type eq |DB|)then
      !this.allNonMemDbs.append(!temp)
      !index = !this.ordCurrAll.findFirst(!temp)
      !this.ordCurrAll.remove(!index)
   elseif(!temp.type eq |DBSET|)then
      !this.allNonMemSets.append(!temp)
      !index = !this.ordCurrAll.findFirst(!temp)
      !this.ordCurrAll.remove(!index)
    endif
  enddo
  !this.list(|ALL|)
  !this.list(|ORDEREDMEM|)
endmethod
-- End of method definition for .remove()
