--   Module:        admin
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Mon Jul 21 11:55:10 BST 1997
--
--
-- Description:
-- Form definition to provide facilities to copy dbset elements.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   method to copy a source dbset to a new dbset using the Admin form of
--  init()                           -                   method to initialise the dbset Copy Form.
--  nameCheck()                      -                   method to act as a callback to the Name gadget in the Copy dbset
--  refGet()                         DBREF               method to return the DBREF of the source dbset for a copy dbset
--  refSet(DBREF)                    -                   method to set the DBREF of the source dbset.
--
------------------------------------------------------------------------

-- Define form
setup form !!admDbSetCpy at xr 0.35 yr 0.1

  !this.formTitle     = 'Copy dbset'
  !this.iconTitle     = 'COPYdbset'
  !this.callback      = '!this.init()'
  !!admDbSetCpy.formRevision  = ' $Revision: 1.13 $ '

  -- Body of form definition
  text .name at x 0 y 0 |To dbset    | call |!this.nameCheck()| width 30 scroll 49 NAME
  text .desc at xmin ymax+0.2 |Description| width 30 scroll 120 STRING

  button .ok at xmin.name ymax+0.5 |  OK  | call |!this.cbApply()| OK
  button .cancel at xmax form-size ymin |Cancel| CANCEL

  -- Member definitions
  -- Source dbset Dbref
  member .dbRef is DBREF

exit
-- End of form definition for !!admDbSetCpy

------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: method to copy a source dbset to a new dbset using the Admin form of
-- the copy command.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbApply()

  -- Initialise variables
  !sourceDbSet = !this.refGet()
--  !sourceName  = !sourceDbSet.name.substring(2)
  !targetDbSet = !this.name.val
  !description = !this.desc.val

  -- Check for unset target name
  if (!targetDbSet.lowcase() eq 'unset') then
    !!messageFile.error(141, 107)
  endif

  -- APPWARE CODE AS WRITTEN IN ANTICIPATION OF A CORE COPY DBSET COMMAND
  -- Create copy command
--  !command          = |COPY dbset |+ !sourceName +| TO |+ !targetDbSet
  -- Execute the copy command
--  call !!admCommand(!command)
--   handle (1,3)
--
--     -- dbset already exists
--     !!messageFile.error(141, 103, !targetDbSet)
--
--   elsehandle (1,6)
--
--     -- Source dbset not found
--     !!adminElem.update('DBSET')
--     !!messageFile.error(141, 106, !sourceDbSet)
--
--   elsehandle any
--
--     -- Non specific
--     !!messageFile.error(141, 107, !!error.text)
--
--   endhandle

  -- APPWARE DRIVEN COPY
  !elem     = object ADMVIRTDBSET()
  !elem.goVirtual(!sourceDbSet)
  !elemName = |/| + !targetDbSet
  !elem.goReal(!elemName)
  handle any
    !!alert.error(!!error.text)
    return
  endhandle

-- Goto the new DBREF
  !!ce              = !elemName.dbRef()
  !!adminElem.dbSetSet(!!ce)

  -- Copy command was a success so modify the description
  if (!description.empty() or !description eq 'unset') then
    !description = ''
  endif
  !!ce.description = !description

  -- Update the forms
  !!adminElem.update('DBSET')
  !!admDbSet.update()

endmethod
-- End of method definition for .cbApply()

-- Description: method to initialise the dbset Copy Form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- -- Initialise form variables
  !dbRef     = !!adminElem.dbSetGet()
  !this.refSet(!dbRef)

  -- Set the form title
  !this.formTitle = |Copy dbset: |+ !dbRef.name.substring(2)

  -- Initialise form gadgets
  !this.name.val  = |unset|
  if (!dbRef.description.empty()) then
    !this.desc.val  = |unset|
  else
    !this.desc.val  = !dbRef.description
  endif


endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
--Method: .nameCheck()
--
-- Description: method to act as a callback to the Name gadget in the Copy dbset
-- form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .nameCheck()

  -- Call the dbset name check
  call !!nameGadget( !this.name, 'NEW' )

endmethod
-- End of method definition for .nameCheck()

------------------------------------------------------------------------
--
--Method: .refGet()
--
-- Description: method to return the DBREF of the source dbset for a copy dbset
-- operation.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of source dbset
--
------------------------------------------------------------------------

-- Define method
define method .refGet() is DBREF

  -- Return the values
  return !this.dbRef

endmethod
-- End of method definition for .refGet() DBREF

------------------------------------------------------------------------
--
--Method: .refSet()
--
-- Description: method to set the DBREF of the source dbset.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Source dbset Dbref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refSet(!dbRef is DBREF)

  if(badref(!dbRef)) then
    !!alert.error('Cannot find selected element. Please refresh the element list')
    return error
  endif
  -- Check that the element type is a dbset
  if (!dbRef.type neq 'DBSET') then
    return error
  endif

  !this.dbRef  = !dbRef

endmethod
-- End of method definition for .refSet(DBREF)
