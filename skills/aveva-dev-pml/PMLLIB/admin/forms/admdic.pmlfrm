--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Thu Feb 13 08:48:48 GMT 1997
--
--
-- Description:
-- Form to allow database integrity checking - old DICE
-- functionality.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   Function to perform database integrity check on selected databases.
--  check()                          -                   Function to set the mode of gadgets in the Database Integrity Check
--  dbGet()                          ARRAY               Function to return the form member for the project databases in the
--  dbList()                         -                   Method to control the contents of the database list gadget in the
--  dbSet()                          -                   Method to generate an array of project databases and store them
--  externalCall()                   -                   Method to active the relevant gadgets for the external gadget setting
--  init()                           -                   Method to initialise the Database Integrity Checker form.
--  output()                         -                   Function to control the gadget states for output from the
--
------------------------------------------------------------------------

setup form !!admdic
Import 'pmlfilebrowser'
handle any
endhandle

  !this.formTitle     = |Database Integrity Check|
  !this.iconTitle     = |CHECK DB|
  !this.callback      = |!this.init()|
  !this.formRevision  = ' $Revision: 1.22 $ '

  -- Body of form definition
  frame .dbFr at x 0.1 y 0 |Databases| width 60

    option .check  at xmin+1 ymin+1 |Check |          call |!this.check()| width 11
    button .selAll at xmax+8 ymin   |Select All|      call |!this.dbs.select('rtext',!this.dbs.rtext)|
    button .clrSel at xmax+2 ymin   |Clear Selection| call |!this.dbs.clearSelection()|

    list   .dbs    at xmin.dbFr+1 ymax+0.2  multiple columns width 55 height 10

    option .sort   at xmin ymax+0.2 |Sort By | call |!this.dbList()| width 11
    text   .filter at xmax+0.2 ymin |Filter|   call |!this.dbList()| width 10 string

  exit

  frame .set at xmin ymax+0.2 |Settings| width 60

    -- the mode brief or full option has been removed (same as maximum errors of 1)
    option .stat     at xmin.set+1 ymax |Statistics    | width 11
    path down
    option .extern                      |External Refs.| call |!this.externalCall()| width 11
    option .patch                       |Attempt to patch database problems | width 5
    if(!!admControl.isValid('Extracts')) then
      option .claim                     |Check extract claimlist integrity  | width 5
    endif
    text   .maxWarning                  |Maximum number of warnings         | width 5 integer min 1 max 10000
    text   .maxError                    |Maximum number of errors           | width 5 integer min 1 max 10000
    option .mdbs     at xmax.extern+1 ymin.extern |Preferred MDB  | width 11

  exit

  frame .outputTo at xmin.set ymax.set+0.5 |Output| width 60
    path right
    rgroup .output at xmin.outputTo+0.5 ymin.outputTo+1  call |!this.output()|
      add tag |Screen|
      add tag |File|
    exit

    text .file at xmin.output+0.5 ymax.output+0.5 |Filename  | width 30 STRING
    button .browse at xmax+3 ymin |Browse...| call $
         |!!fileBrowser('%PDMSUSER%','DiceResults.txt','Database Integrity Check Output File',false,'!!admdic.file.val = !!fileBrowser.file.name()')|

  exit

  button .apply at xmin ymax+0.5 |Apply| call |!this.cbApply()| APPLY
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  menu .dbPopupMenu
    !this.dbPopupMenu.add(|CALLBACK|,|Select All DBs|,|!this.dbs.select('rtext',!this.dbs.rtext)|)
    !this.dbPopupMenu.add(|CALLBACK|,|Select/Deselect a Set of DBs...|,|!!admSelectDbSet.display(!this.dbs)|)
    !this.dbPopupMenu.add(|CALLBACK|,|Clear Selection|,|!this.dbs.clearSelection()|)
    !this.dbs.setPopup(!this.dbPopupMenu)
  menu .warningsMenu
    !this.warningsMenu.add(|CALLBACK|,|Minimum(1)|,|!this.maxWarning.val = '1'|)
    !this.warningsMenu.add(|CALLBACK|,|Default(50)|,|!this.maxWarning.val = '50'|)
    !this.maxWarning.setPopup(!this.warningsMenu)
  menu .errorsMenu
    !this.errorsMenu.add(|CALLBACK|,|Minimum(1)|,|!this.maxError.val = '1'|)
    !this.errorsMenu.add(|CALLBACK|,|Default(50)|,|!this.maxError.val = '50'|)
    !this.maxError.setPopup(!this.errorsMenu)

  -- Member Definitions
    -- Array of databases
    member .dbArray   is ARRAY
    -- Sort and filter values
    member .sortVal   is STRING
    member .filterVal is STRING

  -- Initialise display list
  !dtext    = ARRAY()
  !rtext    = ARRAY()
  !isGlobal = !!glbIsGlobal()

  -- Set Sort gadget data
  !!admDbSortGadg(!this.sort)

  -- Set filter gadget
  !this.filter.val = |*|

  -- Set Check option gadget data
  !dtext.append(|Selection  |)
  !dtext.append(|System DB|)
  !dtext.append(|MISC DB|)
  !dtext.append(|COMMS DB|)
  if (!isGlobal) then
    !dtext.append(|Global DB|)
  endif
  if (!isGlobal) then
    if (!!dbrGlbCurLocRf() eq !!dbrGlbHubLocRf()) then
      !dtext.append(|Project|)
    endif
  else
    !dtext.append(|Project|)
  endif
  !this.check.dtext = !dtext
  !dtext.clear()
  !rtext.append(|DB|)
  !rtext.append(|SYSTEM|)
  !rtext.append(|MISCDB|)
  !rtext.append(|COMMDB|)
  if (!isGlobal) then
    !rtext.append(|GLOBALDB|)
  endif
  if (!isGlobal) then
    if (!!dbrGlbCurLocRf() eq !!dbrGlbHubLocRf()) then
      !rtext.append(|PROJECT|)
    endif
  else
    !rtext.append(|PROJECT|)
  endif
  !this.check.rtext = !rtext
  !rtext.clear()

  -- Set the statistics gadgets
  !dtext.append(|On|)
  !dtext.append(|Off|)
  !dtext.append(|Extra|)
  !this.stat.dtext   = !dtext
  !dtext.clear()
  !rtext.append(|ON|)
  !rtext.append(|OFF|)
  !rtext.append(|FULL|)
  !this.stat.rtext   = !rtext
  !this.stat.select('rtext','OFF')
  !rtext.clear()

  -- Set external check option gadget data
  !dtext.append(|No Checking|)
  !dtext.append(|Check|)
  !dtext.append(|Reject|)
  !this.extern.dtext = !dtext
  !dtext.clear()
  !rtext.append(|NOCHECK|)
  !rtext.append(|CHECK|)
  !rtext.append(|REJECT|)
  !this.extern.rtext = !rtext
  !rtext.clear()

  -- Set the patch gadgets
  !dtext.append(|On|)
  !dtext.append(|Off|)
  !this.patch.dtext   = !dtext
  !dtext.clear()
  !rtext.append(|ON|)
  !rtext.append(|OFF|)
  !this.patch.rtext   = !rtext
  !this.patch.select('rtext','OFF')
  !rtext.clear()

  -- Set the claim gadgets
  if(!!admControl.isValid('Extracts')) then
    !dtext.append(|On|)
    !dtext.append(|Off|)
    !this.claim.dtext   = !dtext
    !dtext.clear()
    !rtext.append(|ON|)
    !rtext.append(|OFF|)
    !this.claim.rtext   = !rtext
    !rtext.clear()
  endif

  -- Set defaults check values
  !this.maxWarning.val = '50'
  !this.maxError.val   = '50'
  !this.file.val      = '%PDMSUSER%/DiceResults.txt'

exit
-- End of form definition for !!admdic

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the Database Integrity Checker form.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Restore sort and filter values
  if (!this.sortVal.set()) then
    !this.filter.val  = !this.filterVal
    !this.sort.select('rtext',!this.sortVal)
  endif

  -- Prepare project databases
  !this.dbSet()

  -- Display database list
  !this.dbList()

  -- Collect and Display the preferred MDBs
  var !mdbs collect all MDB for /*M
  -- Use names of the MDBs not reference numbers
  !mdbNames = ARRAY()
  do !i indices !mdbs
    !!ce = !mdbs[!i].dbref()
    !mdbNames[!i] = !!ce.flnm
  enddo
  -- Give the option to have no preference MDB
  !mdbNames.insert(1,'NONE')
  -- Display the MDBs in the gadget
  !this.mdbs.dtext = !mdbNames

  -- Gadget maintenance
  !this.externalCall()
  !this.check()
  !this.output()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .dbSet()
--
-- Description: Method to generate an array of project databases and store them
-- as a form member in the Database Integrity Check form.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbSet()

  -- Initialise variables

  !globalProject   = !!glbIsGlobal()
  if (!globalProject) then
     !hubStatus = !!glbHubStatus(!globalProject)
  else
     !hubStatus = false
  endif
  !dbArray         = ARRAY()

  -- Collect and sort all the project dbs
  if (not !globalProject or !hubStatus) then
    -- Show all databases (HUB and non-global)
    !!ce      = !!dbrAdminGetWorld('TEAM')
    !dbArray  = !!collectAllFor('DB','',!!ce)
    -- add working extracts
    !!ce      = !!dbrAdminGetWorld('USER')
    !dbArray.appendArray(!!collectAllFor('DB','',!!ce))
  else
    !!ce      = !!dbrGlbCurLocRf()
    !clause   = 'TYPE eq |DB|'
    !dbArray  = !!ce.mem[1].mem
  endif

  -- Store the value
  !this.dbArray  = !dbArray

endmethod
-- End of method definition for .dbSet()

------------------------------------------------------------------------
--
-- Method:      .dbGet()
--
-- Description: Function to return the form member for the project databases in the
-- Database Integrity Check form.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of project databases
--
------------------------------------------------------------------------

-- Define function
define method .dbGet() is ARRAY

  -- Return the value
  return !this.dbArray

endmethod
-- End of method definition for .dbGet() ARRAY

------------------------------------------------------------------------
--
-- Method:      .dbList()
--
-- Description: Method to control the contents of the database list gadget in the
-- Database Integrity Check form.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbList()

  -- Initialise variables
  !dbArray            = !this.dbGet()

-- Show prompt
  !!messagefile.prompt(141, 4, !this.formTitle, !!messagefile.messageString(141, 811))

  -- Preserve sort and filter gadgets
  if (!this.filter.val.empty()) then
    !this.filter.val  = |*|
  endif
  !this.filterVal  = !this.filter.val
  !this.sortVal    = !this.sort.selection('rtext')

  -- Clear the list gadget
  !this.dbs.clear()

  -- Sort the database list
  !dbSorted = !!adminFilterSort(!dbArray,!this.sort,!this.filter)

  -- Generate the database list
  call !!adminDbTxtList(!dbSorted,!this.dbs,!!admDisplayConfig.fmtDbGet(),!!admDisplayConfig.eleTypeGet(), object DBREF())

  -- Dismiss prompt
  call !!prompt(0)

endmethod
-- End of method definition for .dbList()

------------------------------------------------------------------------
--
-- Method:      .check()
--
-- Description: Function to set the mode of gadgets in the Database Integrity Check
-- form depending on the type of check requested by the user.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .check()

  -- Initialise variables
  !check    = !this.check.selection('rtext').upcase()

  -- Set gadget modes
  if (!check eq 'DB') then

    -- Gadget should be active
    !this.selAll.active     = true
    !this.clrSel.active     = true
    !this.dbs.active        = true
    !this.sort.active       = true
    !this.filter.active     = true

  else

    -- Gadgets should be inactive
    !this.selAll.active     = false
    !this.clrSel.active     = false
    !this.dbs.active        = false
    !this.sort.active       = false
    !this.filter.active     = false

  endif

endmethod
-- End of method definition for .check()

------------------------------------------------------------------------
--
-- Method:      .output()
--
-- Description: Function to control the gadget states for output from the
-- database integrity check form.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .output()

  -- Check the state of the radiogroup
  if (!this.output.selection() eq 'Screen') then

    -- Make file gadgets inactive
    !this.file.active    = false
    !this.browse.active  = false

  else

    -- Make file gadgets active
    !this.file.active    = true
    !this.browse.active  = true

  endif

endmethod
-- End of method definition for .output()

------------------------------------------------------------------------
--
-- Method:      .externalCall()
--
-- Description: Function called from .extern gadget
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .externalCall()

  -- The MDB gadget is only active if the external refs selection is CHECK
  if (!this.extern.selection() eq 'CHECK') then
    !this.mdbs.active = true
  else
    !this.mdbs.active = false
  endif

endmethod
-- End of method definition for .externalCall()

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: Function to perform database integrity check on selected databases.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbApply()

  -- Initialise variables
  !checkWhat   = !this.check.selection('rtext')
  !statistics  = !this.stat.selection('rtext')
  !external    = !this.extern.selection('rtext')
  !preference  = !this.mdbs.selection('rtext')
  !patch       = !this.patch.selection('rtext')
  if(!!admControl.isValid('Extracts')) then
    !claim       = !this.claim.selection('rtext')
  endif
  !maxWarning  = !this.maxWarning.val
  !maxError    = !this.maxError.val
  !file        = object FILE()
  !dbList      = ARRAY()
  !sessionData = CURRENT SESSION

  -- Check that we have something to check
  if (!checkWhat eq |DB| and !this.dbs.val.empty()) then

    !!messagefile.error(141, 309)

  endif

  -- Set the check settings
  -- the mode brief or full option has been removed (same as maximum errors of 1)
  call !!admCommand(|CHECKOPTION MODE       FULL|)

  call !!admCommand(|CHECKOPTION STATISTICS $!statistics|)

  if (!external eq 'CHECK') then
    call !!admCommand(|CHECKOPTION EXTERNAL $!external PREFERENCE $!preference|)
  else
    call !!admCommand(|CHECKOPTION EXTERNAL $!external|)
  endif

  if (!patch eq 'ON') then
    !answer = !!alert.confirm('Attempt to patch database problems? Are you sure?')
    if (!answer eq 'YES') then
      call !!admCommand(|CHECKOPTION PATCH ON|)
    else
      call !!admCommand(|CHECKOPTION PATCH OFF|)
      !this.patch.select('RTEXT','OFF')
    endif
  else
    call !!admCommand(|CHECKOPTION PATCH OFF|)
  endif

  if(!!admControl.isValid('Extracts')) then
    call !!admCommand(|CHECKOPTION CLAIM      $!claim|)
  endif

  call !!admCommand(|CHECKOPTION MAXWARNING $!maxWarning|)
  call !!admCommand(|CHECKOPTION MAXERROR   $!maxError|)

  -- Check for an output file
  if (!this.output.selection() eq 'File') then

    -- Create an output file
  -- Trim off "//" if start is an environment variable
    !fileName = !this.file.val
    if (!fileName.substring(1,2) eq |/%|) then

      !fileName = !fileName.substring(2)
    endif

    !file.file(!fileName)

    -- Check to see if file exists
    if (!file.exists()) then

      -- Get user to confirm overwrite
      !answer = !!alert.confirm(!!messagefile.messageString(146, 10, !file.fullname()))

      if (!answer.boolean().not()) then
        return
      endif

      -- Set the output file
      !outputFile  = !file.fullname()
      !fileCommand = |ALPHA FILE |& '"' & !file.fullname() & '"' & | OVERWRITE|

    else

      -- Set the output file
      !outputFile  = !file.name()
      !fileCommand = |ALPHA FILE | & '"' & !file.name() & '"'

    endif

  else

    -- Setup a temporary file
    !outputFile  = |%PDMSWK%/dice| & !sessionData.uniqueId
    !fileCommand = |ALPHA FILE |& '"' & !outputFile & '"' & | OVERWRITE|

  endif

  -- Open the output file regardless
  call !!admCommand(!fileCommand)
  handle any
    -- Unable to open file
    !!messagefile.error(146, 26, !outputFile, !!error.text)
  endhandle

  -- Check the user selection
  if (!checkWhat eq |DB|) then

    -- Check the selection list
    !dbList = !this.dbs.selection(|RTEXT|)

    -- Process the selections
    do !ref values !dbList

      -- Get the database name
      !db = !ref.dbref().name.substring(3)

      -- Set prompt
      !!messagefile.prompt(141, 310, !db)

      -- Check the DB
      call !!admCommand('CHECK DB ' + !db)
      handle ANY
        !!alert.error('Unable to check DB' + !db + ' because ' + !!error.text )
      endhandle

      -- Dismiss prompt
      call !!prompt(0)

    enddo

  elseif (!checkWhat eq |SYSTEM|) then

    -- Check the system database
    -- Set prompt
    !!messagefile.prompt(141, 310, |SYSTEM|)

    -- Check System Db
    CHECK SYSTEM

    -- Dismiss the prompt
    call !!prompt(0)

  elseif (!checkWhat eq |GLOBALDB|) then

    -- Check the global database
    -- Set prompt
    !!messagefile.prompt(141, 310, |GLOBALDB|)

    -- Check the global db
    CHECK GLOBALDB

    -- Dismiss the prompt
    call !!prompt(0)

  elseif (!checkWhat eq |MISCDB|) then

    -- Check the MISC database
    -- Set prompt
    !!messagefile.prompt(141, 310, |MISC DB|)

    -- Check the global db
    CHECK MISCDB

    -- Dismiss the prompt
    call !!prompt(0)

  elseif (!checkWhat eq |COMMDB|) then

    -- Check the MISC database
    -- Set prompt
    !!messagefile.prompt(141, 310, |COMMS DB|)

    -- Check the global db
    CHECK COMMDB

    -- Dismiss the prompt
    call !!prompt(0)

  elseif (!checkWhat eq |PROJECT|) then

    -- Check all databases in the project

    -- Get user to confirm the action
    !answer = !!alert.confirm(!!messagefile.messageString(141, 311))
    if (!answer.boolean().not()) then
      -- Close the output file
      ALPHA FILE END
      return
    endif

    -- Set prompt
    !!messagefile.prompt(141, 312)

    -- Check project
    CHECK PROJECT

    -- Dismiss the prompt
    call !!prompt(0)

  endif

  -- Close the output file
  ALPHA FILE END

  -- If the output was to a user file check for display
  if (!this.output.selection() eq 'File') then

    -- See if user wishes to view the file now
    !answer = !!alert.confirm(!!messagefile.messageString(141, 313))
    if (!answer.boolean().not()) then
      return
    endif

  endif

  -- Display the result to the screen
  if (undefined(!!fileViewer)) then
    !!loadform ('fileViewer')
  endif

  !!fileViewer(!outputFile, !!messagefile.messageString(141, 816))
  -- Example
  --!!fileViewer('%PDMSWK%\diceX104-PC338copy', 'Database integrity check')

endmethod
-- End of method definition for .cbApply()
