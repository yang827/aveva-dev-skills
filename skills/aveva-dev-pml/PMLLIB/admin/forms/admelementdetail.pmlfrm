--
-- File:            admelementdetail.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--
--     Keyword:     GEN
--   Module:        global
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Mon Mar 22 10:42:08 GMT 1999
--
--
-- Description:
-- This form will be used to set up the default detail level of element displayed in the Admin Elements form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   to initialise form
--  checkOutput(STRING)              -                   to check that at least one field is checked for output
--  checkUserPass(STRING)            -                   To unset user if password is selected, and vice versa
--  init()                           -                   to initialise form
--

setup form !!admElementDetail

  !this.formTitle     = 'Level of Detail on the Admin Elements form'
  !this.iconTitle     = 'Detail'
  !this.callback      = '!!admElementDetail.init()'
  !this.formRevision  = ' $Revision: 1.9 $ '

  path right
  hdist 2

  -- Body of form definition
  frame .databases 'Databases' width 58
    toggle .dName           |Name|            at x2
    toggle .dTypeDb         |Type of DB|      at xmax+4
    toggle .dDbNo           |DB Number|
    if(!!glbIsGlobal())then
      toggle .isPrim         |Location|
    endif
    toggle .dDescription    |Description|

    toggle .dAccess         |Access|          at xmin.dName   ymax+0.2
    toggle .dClaim          |Claim|           at xmin.dTypeDb
    toggle .dFilename       |Filename|        at xmin.dDbNo

  exit

  frame .users 'Users' at xmin ymax width 58
    toggle .uName           |Name|             at x2
    toggle .uPassword       |Password Set?|    at xmin.dTypeDb
    toggle .uSecurity       |Security|         at xmin.dDbNo
    toggle .uDescription    |Description|      at xmin.dDescription
  exit

  frame .teams 'Teams' at xmin ymax width 58
    toggle .tName           |Name|             at x2
    toggle .tDescription    |Description|      at xmin.dTypeDb
  exit

  if(!!admControl.isValid('Data Access Control')) then
    frame .acrs 'ACRs' at xmin ymax width 58
      toggle .aName         |Name|             at x2
      toggle .aDescription  |Description|      at xmin.dTypeDb
    exit
  endif

  frame .mdbs 'MDBs' at xmin ymax width 58
    toggle .mName           |Name|             at x2
    toggle .mDescription    |Description|      at xmin.dTypeDb
  exit

  if(!!admControl.isValid('Database Sets')) then
    frame .dbSets 'Database Sets' at xmin ymax width 58
      toggle .dSName        |Name|             at x2
      toggle .dSDescription |Description|      at xmin.dTypeDb
    exit
  endif

  frame .stamps 'Stamps' at xmin ymax width 58
    toggle .sName           |Name|             at x2
    toggle .sDate           |Date|             at xmin.dTypeDb
    toggle .sFunction       |Function|         at xmin.dDbNo
    toggle .sDescription    |Description|      at xmin.dDescription
  exit

  toggle .typeIndicator |Element Type Indicator| at xmin+2 ymax+0.5

  -- Bottom Line
  button .apply   |Apply|   at xmin form-0          ymax+0.5 call |!this.cbApply()| APPLY
  button .reset   |Reset|   at xcen form-0.5 * size ymin RESET
  button .dismiss |Dismiss| at xmax form-size       ymin CANCEL

exit
-- End of form definition for !!admElementDetail

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: to initialise form
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  !dbFormat              =     object DBLISTATTR()
  !dbFormat              =     !!admDisplayConfig.fmtDbGet()
  !this.dName.val        =     !dbFormat.name
  !this.dTypeDb.val      =     !dbFormat.typeDb
  !this.dDbNo.val        =     !dbFormat.dbNo
  if(!!glbIsGlobal())then
    !this.isPrim.val       =     !dbFormat.isPrim
  endif
  !this.dDescription.val =     !dbFormat.description
  !this.dAccess.val      =     !dbFormat.access
  !this.dClaim.val       =     !dbFormat.claim
  !this.dFilename.val    =     !dbFormat.filename

  !this.dName.callback        = |!this.checkOutput('DB')|
  !this.dTypeDb.callback      = |!this.checkOutput('DB')|
  !this.dDbNo.callback        = |!this.checkOutput('DB')|

  if(!!glbIsGlobal())then
    !this.isPrim.callback       = |!this.checkOutput('DB')|
  endif

  !this.dDescription.callback = |!this.checkOutput('DB')|
  !this.dAccess.callback      = |!this.checkOutput('DB')|
  !this.dClaim.callback       = |!this.checkOutput('DB')|
  !this.dFilename.callback    = |!this.checkOutput('DB')|

  !userFormat            =     object USERLISTATTR()
  !userFormat            =     !!admDisplayConfig.fmtUserGet()
  !this.uName.val        =     !userFormat.name
  !this.uPassword.val    =     !userFormat.password
  !this.uSecurity.val    =     !userFormat.security
  !this.uDescription.val =     !userFormat.description

  !this.uName.callback        = |!this.checkUserPass('NAME')|
  !this.uPassword.callback    = |!this.checkUserPass('PASS')|
  !this.uSecurity.callback    = |!this.checkOutput('USER')|
  !this.uDescription.callback = |!this.checkOutput('USER')|

  !teamFormat            =     object TEAMLISTATTR()
  !teamFormat            =     !!admDisplayConfig.fmtTeamGet()
  !this.tName.val        =     !teamFormat.name
  !this.tDescription.val =     !teamFormat.description

  !this.tName.callback        = |!this.checkOutput('TEAM')|
  !this.tDescription.callback = |!this.checkOutput('TEAM')|

  !acrFormat            =     object ACRLISTATTR()
  !acrFormat            =     !!admDisplayConfig.fmtAcrGet()
  if(!!admControl.isValid('Data Access Control')) then
    !this.aName.val        =     !acrFormat.name
    !this.aDescription.val =     !acrFormat.description

    !this.aName.callback        = |!this.checkOutput('ACR')|
    !this.aDescription.callback = |!this.checkOutput('ACR')|
  endif

  !mdbFormat             =     object MDBLISTATTR()
  !mdbFormat             =     !!admDisplayConfig.fmtMdbGet()
  !this.mName.val        =     !mdbFormat.name
  !this.mDescription.val =     !mdbFormat.description

  !this.mName.callback        = |!this.checkOutput('MDB')|
  !this.mDescription.callback = |!this.checkOutput('MDB')|

  !stampFormat            =     object STAMPLISTATTR()
  !stampFormat            =     !!admDisplayConfig.fmtStampGet()
  !this.sName.val         =     !stampFormat.name
  !this.sDate.val         =     !stampFormat.date
  !this.sFunction.val     =     !stampFormat.function
  !this.sDescription.val  =     !stampFormat.description

  !this.sName.callback         = |!this.checkOutput('STAMP')|
  !this.sDate.callback         = |!this.checkOutput('STAMP')|
  !this.sFunction.callback     = |!this.checkOutput('STAMP')|
  !this.sDescription.callback  = |!this.checkOutput('STAMP')|

  if(!!admControl.isValid('Database Sets')) then
    !dbSetFormat             =     object DBSETLISTATTR()
    !dbSetFormat             =     !!admDisplayConfig.fmtDbSetGet()
    !this.dSName.val         =     !dbSetFormat.name
    !this.dSDescription.val  =     !dbSetFormat.description
    !this.dSName.callback         = |!this.checkOutput('DBSET')|
    !this.dSDescription.callback  = |!this.checkOutput('DBSET')|
  endif

  !this.typeIndicator.val =     !!admDisplayConfig.eleTypeGet()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: to initialise form
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbApply()

  !dbFormat              =     object DBLISTATTR()
  !dbFormat.name         =     !this.dName.val
  !dbFormat.typeDb       =     !this.dTypeDb.val
  !dbFormat.dbNo         =     !this.dDbNo.val
  if(!!glbIsGlobal())then
    !dbFormat.isPrim       =     !this.isPrim.val
  endif

  !dbFormat.description  =     !this.dDescription.val
  !dbFormat.access       =     !this.dAccess.val
  !dbFormat.claim        =     !this.dClaim.val
  !dbFormat.filename     =     !this.dFilename.val
  !!admDisplayConfig.fmtDbSet(!dbFormat)

  !userFormat            =     object USERLISTATTR()
  !userFormat.name       =     !this.uName.val
  !userFormat.password   =     !this.uPassword.val
  !userFormat.security   =     !this.uSecurity.val
  !userFormat.description=     !this.uDescription.val
  !!admDisplayConfig.fmtUserSet(!userFormat)

  !teamFormat            =     object TEAMLISTATTR()
  !teamFormat.name       =     !this.tName.val
  !teamFormat.description=     !this.tDescription.val
  !!admDisplayConfig.fmtTeamSet(!teamFormat)

  if(!!admControl.isValid('Data Access Control')) then
    !acrFormat            =     object ACRLISTATTR()
    !acrFormat.name       =     !this.aName.val
    !acrFormat.description=     !this.aDescription.val
    !!admDisplayConfig.fmtAcrSet(!acrFormat)
  endif

  !mdbFormat             =     object MDBLISTATTR()
  !mdbFormat.name        =     !this.mName.val
  !mdbFormat.description =     !this.mDescription.val
  !!admDisplayConfig.fmtMdbSet(!mdbFormat)

  !stampFormat             =     object STAMPLISTATTR()
  !stampFormat.name        =     !this.sName.val
  !stampFormat.date        =     !this.sDate.val
  !stampFormat.function    =     !this.sFunction.val
  !stampFormat.description =     !this.sDescription.val
  !!admDisplayConfig.fmtStampSet(!stampFormat)

  if(!!admControl.isValid('Database Sets')) then
    !dbSetFormat             =     object DBSETLISTATTR()
    !dbSetFormat.name        =     !this.dSName.val
    !dbSetFormat.description =     !this.dSDescription.val
    !!admDisplayConfig.fmtDbSetSet(!dbSetFormat)
  endif

  !!admDisplayConfig.eleTypeSet(!this.typeIndicator.val)
  !!adminElem.update(!!adminElem.type.selection('rtext'))

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
--Method: .checkOutput(STRING)
--
-- Description: to check that at least one field is checked for output
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      Type of gadget group being checked
--                          DB, USER, TEAM, ACR, MDB, STAMP, PACK, DBSET
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkOutput(!group is STRING)

  -- Initialise variables
  !set = ARRAY()

  -- Test for group
  if (!group.eq('DB')) then

    -- Read field settings
    !set.append(!this.dName.val)
    !set.append(!this.dTypeDb.val)
    !set.append(!this.dDbNo.val)

    if(!!glbIsGlobal())then
      !set.append(!this.isPrim.val)
    endif
    !set.append(!this.dDescription.val)
    !set.append(!this.dAccess.val)
    !set.append(!this.dClaim.val)
    !set.append(!this.dFilename.val)

    -- Check for all off
    if (!set.find(true).unset()) then
      !this.dName.val = true
    endif

  elseif (!group.eq('USER')) then
    !set.append(!this.uName.val)
    !set.append(!this.uPassword.val)
    !set.append(!this.uSecurity.val)
    !set.append(!this.uDescription.val)
    if (!set.find(true).unset()) then
      !this.uName.val = true
    endif
  elseif (!group.eq('TEAM')) then
    !set.append(!this.tName.val)
    !set.append(!this.tDescription.val)
    if (!set.find(true).unset()) then
      !this.tName.val = true
    endif
  elseif (!group.eq('ACR')) then
    !set.append(!this.aName.val)
    !set.append(!this.aDescription.val)
    if (!set.find(true).unset()) then
      !this.aName.val = true
    endif
  elseif (!group.eq('MDB')) then
    !set.append(!this.mName.val)
    !set.append(!this.mDescription.val)
    if (!set.find(true).unset()) then
      !this.mName.val = true
    endif
  elseif (!group.eq('STAMP')) then
    !set.append(!this.sName.val)
    !set.append(!this.sDate.val)
    !set.append(!this.sFunction.val)
    !set.append(!this.sDescription.val)
    if (!set.find(true).unset()) then
      !this.sName.val = true
    endif
  elseif (!group.eq('PACK')) then
    !set.append(!this.pName.val)
    !set.append(!this.pDescription.val)
    !set.append(!this.pPrimaryLoc.val)
    if (!set.find(true).unset()) then
      !this.pName.val = true
    endif
  elseif (!group.eq('DBSET')) then
    !set.append(!this.dSName.val)
    !set.append(!this.dSDescription.val)
    if (!set.find(true).unset()) then
      !this.dSName.val = true
    endif
  endif

endmethod
-- End of method definition for .checkOutput(STRING)
------------------------------------------------------------------------
--
--Method:   checkUserPass(STRING)
--
-- Description: To unset user if password is selected, and vice versa
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--  [1] [R]    [STRING]    [password or user checked]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkUserPass(!dummyOption is STRING)

!this.checkOutput('USER')

endmethod
-- End of method definition for .checkUserPass(STRING)
