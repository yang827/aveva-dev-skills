--
-- Description:
-- Form definition to allow foreign databases to be removed from
-- the project.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!admExClaim

-- Define form
setup form !!admExClaim at xr 0.35 yr 0.1 resize

  !!admExClaim.formTitle     = 'Expunge Database Claimlists'
  !!admExClaim.iconTitle     = 'CLAIM'
  !!admExClaim.callback      = 'call !!admExClaimInit()'
  !!admExClaim.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition
  frame _dbFrame at x 0.1 y 0 anchor all |Multiwrite and Controlled Databases in Project|

    list .db at xmin+1 ymin+1 anchor all multiple columns width 45 length 10

    option .sort at xmin ymax+0.2 anchor bottom+left  |Sort By| call |call !!admExClaimDbList()| width 12
    text .filter at xmax+0.5 ymin anchor bottom+right |Filter| call |call !!admExClaimDbList()| width 15 string

  exit

  button .expunge at xmin.dbFrame ymax.dbFrame+0.5 anchor bottom+left |Expunge| call |call !!admExClaim()|
  button .dismiss at xmax form-size ymin anchor bottom+right |Dismiss| CANCEL

  -- Member Definitions
    -- Array of databases
    member .dbArray   is ARRAY
    -- Preserve sort and filter values
    member .sortVal   is STRING
    member .filterVal is STRING

exit
-- End of form definition for !!admExClaim

-- Assign sort gadget values
call !!admDbSortGadg(!!admExClaim.sort)

-- Assign filter gadget value
!!admExClaim.filter.val  = |*|
