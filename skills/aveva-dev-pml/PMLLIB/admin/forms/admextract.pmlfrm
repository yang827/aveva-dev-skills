------------------------------------------------------------------------
--
--Method: .setExtNoToSys()
--
-- Description: method to set extno to system, so that the number is chosen by the system
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setExtNoToSys(!gadget is GADGET)

  -- Set value to be system generated
  !gadget.val   = |Set by System|
  !systemNumber = !this.origDb.nxtexn.string()
  handle ANY
    -- Just being extra safe
    return
  endhandle
  !!alert.message('The next System generated extract number will be ' & !systemNumber)

endmethod
-- End of method definition for .setExtNoToSys(GADGET)


------------------------------------------------------------------------
--
--Method: .update()
--
-- Description: method to update the displayed DB in the DB Definition form.
-- The form must be displayed in MODIFY mode.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- Return if the form is not shown
  if (!this.shown().not()) then
    return
  endif

  !this.init()

endmethod
-- End of method definition for .update()


------------------------------------------------------------------------
--
--Method: .setPropagateFlags(!adminDbRef is DBREF)
--
-- Description: method to set the Propagation flags for the Extract
--              This should not be called for non-Global projects
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of selected DB
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPropagateFlags(!adminDbRef is DBREF)

    !globalProject = !!glbIsGlobal()
    if( !globalProject eq false ) then
      -- Nothing to set - these gadgets are only active in Global projects
      return
    endif

    !currentLoc         = !!dbrGlbCurLocRf()

    !dbLoc      = !adminDbRef.members[1]
    handle any
      -- Working extracts cannot propagate
      !this.linkDocuments.active = false
      !this.linkDocuments.val    = false
      !this.picture.active       = false
      !this.picture.val          = false
      !this.distDb.active        = false
      !this.distDb.val           = false
      return
    endhandle
    -- Ensure DBLOC member has been found, as expected
    if( !dbLoc.type neq |DBLOC| ) then
      do !dbLoc values !adminDbRef
        if( !dbLoc.type eq |DBLOC| ) then
          break
        endif
      enddo
    endif

    !dbType     = !adminDbRef.sType

    -- These gadgets are only active at the Project Hub
    !this.distDb.val  = !dbLoc.propG
    !this.distDb.active = (!currentLoc eq !!dbrGlbHubLocRf() )

    -- Check that the Parent extract is primary here
    if( !this.distDb.active ) then
      !this.distDb.active = (!currentLoc eq !adminDbRef.prmLoc )
    endif
    -- Also check that Extract location is primary
    if( !this.distDb.active ) then
      !this.distDb.active = (!currentLoc.namn eq !this.primary.val)
    endif

    if( !dbType neq |DESI| ) then
      !this.linkDocuments.active = false
      !this.linkDocuments.val    = false
      !drawingDB = (!dbType eq |PADD| or !dbType eq |SCHE| )
      !this.picture.active = (!drawingDB and !this.distDb.active )
      !this.picture.val    = (!drawingDB and !dbLoc.picFD )
    else
      !this.linkDocuments.active = !this.distDb.active
      !this.linkDocuments.val    = !dbLoc.noLnkP.not()
      !this.picture.val          = false
      !this.picture.active       = false
    endif

endmethod
-- End of method definition for .setPropFlags(DBREF)
