------------------------------------------------------------------------
--
--Method: .refresh()
--
-- Description:method to refresh the TEAM elements listed in the Project Teams
-- gadget on the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Return in form in not shown
  if (Undefined (!!admExtract) or not !!admMdb.shown()) then
    return
  endif

  -- Display a message
  !!messageFile.prompt(141, 4, !!admExtractincl.formTitle, !!messageFile.messageString(141, 803))

  -- Rebuild the project teams
  !this.teamArrSet()

  -- Update the project users list
  !this.teamArrList()

  -- Rebuild the project teams
  !this.origDbArrSet()

  -- Update the project users list
  !this.origDbArrList()

  -- Dismiss the prompt
  !!prompt(0)

endmethod
-- End of method definition for .refresh()

