------------------------------------------------------------------------
--
--Method: .origDbArrList()
--
-- Description: method to update the contents of the project origDbs list gadget on
-- DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .origDbArrList()
  -- clear the last original DB selection
  !this.origDb       = object DBREF()
  -- Initialise variables
  !projOrigDbs       = !this.origDbArrGet()
  !dbOwner           = !this.origDbGet()
  -- Save the sort and filter values for later user
  !this.dbFilterVal  = !this.dbFilter.val
  if (!this.dbFilter.val.empty()) then
    !this.dbFilter.val = |*|
  endif
  !this.dbSortVal    = !this.dbSort.selection('rtext')
  -- Clear the list
  !this.projDbs.clear()
  -- Sort the list of origDbs
  !displayList     = !!adminFilterSort(!projOrigDbs, !this.dbSort, !this.dbFilter)
  -- Check that the DB Owner is displayed
  if (!dbOwner.set()) then
    !pos           = !displayList.findFirst(!dbOwner)
    if (!pos.unset()) then
      !displayList.insert(1,!dbOwner)
    endif
  else
    if (!displayList.set()) then
      !dbOwner = !displayList[1]
      !this.origDbSet(!dbOwner)
    endif
  endif
  if(!!glbIsGlobal())then
    -- Display the list of origDbs
    !!adminDbTxtList(!displayList, !this.projDbs, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(), ADMLOC)
  else
    !nullLoc = object DBREF()
    !!adminDbTxtList(!displayList, !this.projDbs, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(), !nullLoc)
  endif
  -- Select the DB owner
  !this.projDbs.select('rtext', !dbOwner.string())
  handle any
    -- Only if DbOwner is unset
  elsehandle NONE
    -- Run the callback of the Database list gadget.
    !this.origDbSel(!this.projDbs)
  endhandle

endmethod
-- End of method definition for .origDbArrList()

------------------------------------------------------------------------
--
--Method: .origDbArrSet()
--
-- Description: method to set the form member for the project origDbs in the DB
-- Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .origDbArrSet()

  -- Initialise variables
  !origDbs           = ARRAY()
  !currentPos        = !!ce

  -- Initialise variables
  !globalProject = !!glbIsGlobal()
  if (!globalProject) then
     !hubStatus = !!glbHubStatus(!globalProject)
  else
     !hubStatus = false
  endif

  -- Collect the project origDbs
  if (not !globalProject or (!hubStatus and CURLOC eq ADMLOC)) then
    -- This list includes Working extracts
    !origDbs = DBS
  else
    -- Satellites - Only show allocated DBs
    !!ce          = !!adminApplic.getAdmContext()
    !origDbs      = !!ce.mem[1].mem
  endif
  !origDbsFinal = ARRAY()
  do !j values !origDbs
    if( !j.objectType() EQ |DB|)then
      !t = !j.refno.dbRef()
    else
      !t = !j
    endif

    skip if(!t.dAccess.upcase() NEQ |MULTIWRITE|)
    -- (AK) copy db's and foreign db's have extracts, so don't put in the list.
    skip if(!t.bCpyRef.set() or !t.projId.set())
    -- (CJF) P-41948 skip if working extract.
    skip if(!t.owner.owner.type eq 'USER' )

   !origDbsFinal.append(!t)
  enddo

  -- Assign the array to its store
  !this.origDbArray  = !origDbsFinal

  -- Return to database position
  !!ce               = !currentPos

endmethod
-- End of method definition for .origDbArrSet()

------------------------------------------------------------------------
--
--Method: .origDbGet()
--
-- Description: method to return the DBREF of the origDb to which the current DB in
-- the DB Definition form is owned by.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of owning origDb
--
------------------------------------------------------------------------

define method .origDbGet() is DBREF

  -- Return the value
  return   !this.origDb

endmethod
-- End of method definition for .origDbGet() DBREF

------------------------------------------------------------------------
--
--Method: .origDbSel()
--
-- Description: Callback to Project origDb list for user selection.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget selection was made from.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .origDbSel(!gadget is GADGET)

  -- Initialise variables
  !dbOwner           = !this.origDbGet()
  !selectedOrigDb    = !gadget.selection('rtext').dbRef()
  handle (2,107)

    -- origDb does not exist in project
    !!messageFile.error(141, 3, !!messageFile.messageString(141, 803), !gadget.selection('rtext'))
    handle (06, 003)
      -- Dummy handle
    endhandle

    !this.refresh()
    return

  endhandle

  -- Check that the selection is new
  if (!dbOwner eq !selectedOrigDb) then
    return
  endif

  -- Set the new origDb
  !this.origDbSet(!selectedOrigDb)

  -- set the Propagate Flags
  !this.setPropagateFlags( !selectedOrigDb )

endmethod
-- End of method definition for .origDbSel(GADGET)

------------------------------------------------------------------------
--
--Method: .origDbSet()
--
-- Description: set the current origDb DBREF for the DB Definition form.
-- The origDb owns the current database.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of origDb element (can be unset).
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .origDbSet(!dbRef is DBREF)

  -- Set the DBREF
  !this.origDb     = !dbRef

  if( !dbRef.access.upcase() eq 'MULTIWRITE' ) then
    -- set the claim button to match owning DB (AK)
    !claim = !dbRef.claimDb.upcase()
    handle any
      -- safety net (should not need this)
    endhandle
    !this.claim.select('RTEXT',!claim)
    handle any
      -- safety net (should not need this)
    endhandle
  endif

  -- set default controlled state to match owning DB
  !this.controlled.val = !this.origDb.lCtrol
  handle any
    -- safety net (should not need this)
    !this.controlled.val = false
  endhandle

endmethod
-- End of method definition for .origDbSet(DBREF)

