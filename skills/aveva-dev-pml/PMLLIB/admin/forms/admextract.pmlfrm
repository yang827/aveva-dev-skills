-- End of method definition for .teamArrGet() ARRAY

------------------------------------------------------------------------
--
--Method: .teamArrList()
--
-- Description: method to update the contents of the project teams list gadget on
-- DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .teamArrList()

  -- Initialise variables
  !projTeams = !this.teamArrGet()
  !origDb    = !this.origDbGet()
  if( !origDb.set() ) then
    -- get team from DB
    !dbOwner = !origDb.owner.owner
    !this.teamSet(!dbOwner)
  else
    !dbOwner = !this.teamGet()
  endif

  -- Save the sort and filter values for later user
  !this.filterVal  = !this.filter.val
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.sortVal    = !this.sort.selection('rtext')
  -- Clear the list
  !this.projTeams.clear()
  -- Sort the list of teams
  !displayList       = !!adminFilterSort(!projTeams, !this.sort, !this.filter)

  -- Check that the DB Owner is displayed
  if (!dbOwner.set()) then
    !pos               = !displayList.findFirst(!dbOwner)
    if (!pos.unset()) then
      !displayList.insert(1,!dbOwner)
    endif
  else
    if (!displayList.set()) then
      !dbOwner           = !displayList[1]
      !this.teamSet(!dbOwner)
    endif
  endif

  -- Display the list of teams
  !!adminTeamTxtList(!displayList, !this.projTeams, !!admDisplayConfig.fmtTeamGet(), !!admDisplayConfig.eleTypeGet())

  -- Select the DB owner
  !this.projTeams.select('rtext', !dbOwner.string())
  handle any
    -- Only if DbOwner is unset
  elsehandle NONE
    -- Run the callback of the Team list gadget.
    !this.teamSel(!this.projTeams)
  endhandle

endmethod
-- End of method definition for .teamArrList()

------------------------------------------------------------------------
--
--Method: .teamArrSet()
--
-- Description: method to set the form member for the project teams in the DB
-- Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .teamArrSet()

  -- Initialise variables
  !teams             = ARRAY()
  !currentPos        = !!ce

  -- Collect the project teams
  !!ce               = !!dbrAdminGetWorld('TEAM')
  !teams             = !!collectAllFor('TEAM','',!!ce)

  -- Assign the array to its store
  !this.teamArray  = !teams

  -- Return to database position
  !!ce               = !currentPos

endmethod
-- End of method definition for .teamArrSet()

