--
--
-- Description:
-- Form to handle extract creation.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admExtract()                     -                   Constructor
--  cbApply()                        -                   method to create or modify a DB element. The values method . the element
--  cbName(GADGET)                   -                   Callback to the Name gadget in the DB Definition form.
--  display(STRING)                  -                   method to display the DB Definition form.
--  display(STRING,STRING)           -                   method to display the DB Definition form.
--  init()                           -                   method to initialise the DB Definition form.
--  loc(STRING)                      -                   Callback to Primary location gadget on the DB Definition form.
--  locGet()                         DBREF               method to return the DBREF of the current databases primary loc.
--  locSet(DBREF)                    -                   method to set the form member for a databases primary location
--  modeGet()                        STRING              method to return the current mode of the DB Definition form.
--  origDbArrGet()                   ARRAY               method to return the array of project origDbs being used by
--  origDbArrList()                  -                   method to update the contents of the project origDbs list gadget on
--  origDbArrSet()                   -                   method to set the form member for the project origDbs in the DB
--  origDbGet()                      DBREF               method to return the DBREF of the origDb to which the current DB in
--  origDbSel(GADGET)                -                   Callback to Project origDb list for user selection.
--  origDbSet(DBREF)                 -                   method to set the current origDb DBREF for the DB Definition form.
--  refGet()                         DBREF               method to return the current DB DBREF for the element being edited.
--  refSet(DBREF)                    -                   method to set the current DB DBREF for the DB Definition form.
--  refresh()                        -                   method to refresh the TEAM elements listed in the Project Teams
--  setExtNoToSys(GADGET)            -                   method to set extno to system, so that the number is chosen by the system
--  setPropagateFlags(DBREF)         -                   method to set the Propagation flags for the Extract
--  teamArrGet()                     ARRAY               method to return the array of project teams being used by
--  teamArrList()                    -                   method to update the contents of the project teams list gadget on
--  teamArrSet()                     -                   method to set the form member for the project teams in the DB
--  teamGet()                        DBREF               method to return the DBREF of the TEAM to which the current DB in
--  teamSel(GADGET)                  -                   Callback to Project Team list for user selection.
--  teamSet(DBREF)                   -                   method to set the current TEAM DBREF for the DB Definition form.
--  update()                         -                   method to update the displayed DB in the DB Definition form.
--
------------------------------------------------------------------------

setup form !!admExtract at xr 0.35 yr 0.1 resize

  !this.formTitle     = 'Create Extract'
  !this.iconTitle     = 'Extract'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.35 $ '

  -- Body of form definition

  para .extractNameTx anchor top+left at x 0 y 0.2 text |Extract |
  para .extractName   anchor top+left at xmax ymin width 44 line 1

  frame .origDbFrame anchor all at x 0 ymax.extractName+0.2 |Select Database for Extract|

    list .projDbs anchor all at xmin+1 ymin+1 call |!this.origDbSel(!this.projDbs)| columns width 50 height 10
    path down
    halign left
    option .dbSort anchor bottom+left                |Sort |    call |!this.origDbArrList()| width 12
    text .dbFilter anchor bottom+left at xmax+1 ymin | Filter | call |!this.origDbArrList()| width 20 STRING

  exit

  frame .teamFrame anchor left+right+bottom at x 0 ymax.origDbFrame+0.2 |Owning Team|

    list .projTeams anchor all at xmin+1 ymin+1 call |!this.teamSel(!this.projTeams)| columns width 50 height 10

    option .sort anchor bottom+left                |Sort | call |!this.teamArrList()| width 12
    text .filter anchor bottom+left at xmax+1 ymin | Filter | call |!this.teamArrList()| width 20 STRING

  exit

  text .name anchor bottom+left+right at x 1   ymax+0.5  tagwid 18  |Name         | call |!this.cbName(!this.name)| width 32 scroll 49 NAME

  text .desc anchor bottom+left+right at xmin ymax+0.2   tagwid 18  |Description  | width 32 scroll 120 STRING

  option .claim      anchor bottom+left at xmin ymax+0.2 tagwid 18  |Access Mode  | width 16

  toggle .controlled anchor bottom+left at xmax+1 ymin |Controlled|
  toggle .variant    anchor bottom+left at xmin   ymax |Variant|

  text .area anchor bottom+left at xmin.desc ymax+0.2 tagwid 18 |Area Number  | call |!!admChkDbArea(!this.area.val,!this.area,!this.refGet())|  width 10 INTEGER min 0 max 999
  button .areaDef anchor bottom+left at xmax+1 ymin |System| call |!!admChkDbArea('SYS',!this.area,!this.refGet())|

  text   .extNo    anchor bottom+left at xmin.desc ymax+0.2 tagwid 18 |Extract Number | width 10 INTEGER min 0 max 8191
  button .extNoDef anchor bottom+left at xmax+1 ymin |System| call |!this.setExtNoToSys(!this.extNo)|

  -- text gadget for REFBLOCK option.
  text .refBlockNo   anchor bottom+left at xmin.desc ymax+0.2 tagwid 18 |Reference Blocks| width 10 INTEGER min 1 max 20

  !globalProject = !!glbIsGlobal()
  if (!globalProject) then
    text .primary anchor bottom+left at xmin.desc ymax+0.2 tagwid 18 |Primary Location | call |!this.loc(!this.primary.val)| width 28 NAME
    button .priBtn anchor bottom+left at xmax+0.2 ymin-0.1 pixmap width 16 height 16 call |!!glbDbPri.infoInit(!this)|

    frame .distTx |Propagate| anchor bottom+left+right  at xmin.teamFrame ymax.primary+0.2
      toggle .distDb  anchor bottom+left |Database|      at xmin+2 ymax
      toggle .picture anchor bottom+left |Picture/Neutral Format Files| at xmin.distDb    ymax
      toggle .linkDocuments anchor bottom+left+right |Link Documents (Only on Design Databases)| at xmin.distDb ymax
    exit
  endif

  button .apply   anchor bottom+left at x 0  ymax+0.5             |Apply| call |!this.cbApply()| APPLY
  button .reset   anchor bottom at xcen form-0.5 * size ymin |Reset|   RESET
  button .dismiss anchor bottom+right at xmax form-size ymin       |Dismiss| CANCEL

  -- Member definitions
    -- Active database DBREF
    member .dbRef is DBREF

    -- Original DB
    member .origDb      is DBREF
    -- Project Dbs
    member .origDbArray is ARRAY

    -- Owning team
    member .team      is DBREF
    -- Project Teams
    member .teamArray is ARRAY

--    if (!globalProject) then
      -- Primary Location
      member .primaryLoc is DBREF
--    endif
    --  Members to store sort and filter values
    member .filterVal is STRING
    member .sortVal   is STRING

    --  Members to store sort and filter values
    member .dbFilterVal is STRING
    member .dbSortVal   is STRING

exit
-- End of form definition for !!admExtract

------------------------------------------------------------------------
--
--Method: .admExtract()
--
-- Description: Constructor
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .admExtract()

-- Initialise variables
!dText         = ARRAY()
!rText         = ARRAY()
!globalProject = !!glbIsGlobal()

-- description gadget now always available (never used to be at satellite)
!this.desc.active = TRUE

-- set icons
if (!globalProject) then
     !this.priBtn.addPixmap(!!pml.getPathName('popup16.png'))
endif

-- Assign sort gadget values
!!admTeamSortGadg(!this.sort)

-- Assign sort gadget values
!!admDbSortGadg(!this.dbSort)

-- Assign filter gadget value
!this.filter.val    = |*|

-- Assign filter gadget value
!this.dbFilter.val    = |*|

-- Assign area gadget value
!this.area.val      = |Set by System|

-- Assign extno gadget value
   !this.extNo.val      = |Set by System|


-- Assign claim mode gadget values
!dText.append(|Implicit Claim|)
!dText.append(|Explicit Claim|)
!this.claim.dText   = !dText
!dText.clear()
!rText.append(|IMPLICIT|)
!rText.append(|EXPLICIT|)
!this.claim.rText   = !rText
!rText.clear()

  -- Assign picture file gadget values
  if(!!admControl.isValid('Global')) then
    !this.distDb.val  = true
    !this.picture.val = false

    !hubLocation  = !!glbHubStatus(!globalProject)
     !this.distDb.active        = !hubLocation
    !this.picture.active       = !hubLocation
    !this.linkDocuments.active = !hubLocation
    if( !hubLocation ) then
      !glocwl = /*GL
      !linkDocumentsState    = !glocwl.gLinkPropagation

      !this.linkDocuments.val = !linkDocumentsState
    endif

  endif


endmethod
-- End of method definition for .admExtract()

------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: method to create or modify a DB element. The values method . the element
-- are taken from the DB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbApply()

  -- Some Preliminary checks
  if((!this.name.val EQ ||) OR (!this.name.val EQ |UNSET|))then
    -- ##
    !!alert.error(|Please enter a valid name in the Name field!|)
    return
  endif
  if(!this.projTeams.val.unset())then
    -- ##
    !!alert.error(|Please select an owning team!|)
    return
  endif
  if(!this.projDbs.val.unset())then
    -- ##
    !!alert.error(|Please select a Database to Copy!|)
    return
  endif

  -- Initialise variables
  !dbRef      = !this.refGet()
  !owner      = !this.teamGet()
  !globalProject = !!glbIsGlobal()
  -- Variable for refBlock value & apply this into CR EXT & CR VAR command.
  !refBlockVal = !this.refBlockNo.val

  !this.name.setFocus()

  -- Check that the team is set
  if (!owner.unset()) then

    -- Raise error
    !!messageFile.error(141, 151, !mode.lowcase())

  endif

  -- Check that the team is valid
  if (!owner.badRef()) then

    -- Team does not exist
      !!messageFile.error(141, 3, !!messageFile.messageString(141, 803), !owner.string())
    handle (06, 003)
      -- Dummy handle
    endhandle

    -- Reset values
    !this.teamSet(object DBREF())
    !this.dbName.val     = |unset/|& !this.name.val
    !this.teamArrList()
    return

  endif

  -- Check that the Database Name is set
  if (!this.name.val eq 'unset') then

    -- Raise error
    !this.name.setFocus()
    !!messageFile.error(141, 152, |create|)

  endif

  -- Gather attribute values
  !dbName      = !owner.name.substring(3) +|/|+ !this.name.val
  !description = !this.desc.val
  !from        = | | + !this.projDbs.selection(|rtext|).dbRef().name.substring(3)

  -- Get the CLAIM value
  if (!this.claim.val.set())then
    !claim       = | CLAIM | + !this.claim.selection('rtext')
  else
    !claim       = ||
  endif

  -- Get the AREA value
  if (!this.area.val.trim() eq 'Set by System') then
    !area        = ||
  else
    !area        = | IN AREA |+ !this.area.val
  endif

 -- Get the extno value
    if (!this.extNo.val.trim() eq 'Set by System') then
      !extNo        = ||
    else
      !extNo        = | EXTNO  | + !this.extNo.val
    endif

  -- Get the controlled value
  if (!this.controlled.val) then
    !controlled  = | CONTROLLED |
  else
    !controlled  = ||
  endif

  -- Perform Global actions. These are the same for CREATE or MODIFY
  !primCommand  = ''
  if (!globalProject) then

    -- Set primary location
    !primary  = !this.locGet()
    !curLoc = CURLOC
    !primCommand  = ''
    if (!primary neq !curLoc) then
      -- Allocate database as primary (on-line location)
      !primCommand  = | AT |+ !primary.name
    endif

  endif

  -- Description should be included if using Global daemon to create Extract
  -- P-7695 Needed when creating Extract at satellite
  -- NOTE - Also needed when Owner is at Satellite (not done)

  if (!globalProject) then
    -- Check whether at the Project Hub
    !localCreate  = !!glbHubStatus(!globalProject)
    if( !primCommand.length() gt 0 ) then
      -- Qualifying clause for Primary location has been specified
      !localCreate = FALSE
    endif
  else
    !localCreate  = TRUE
  endif
    -- Added REFBLOCK n option in CR EXT and CR VAR command.
  if(!this.variant.val)then
    -- Construct the command
    if (!localCreate) then
      !command      = |CREATE VARIANT |+ !dbName + | FROM | + !from + !area + !controlled + !claim + !extNo + !primCommand + | REFBLOCKS | + !refBlockVal
    else
      !command      = |CREATE VARIANT |+ !dbName + | FROM | + !from + !area + !controlled + !claim + !extNo + !primCommand + | REFBLOCKS | + !refBlockVal + ' DESC |' + !description + '|'
    endif
  else
    -- Construct the command
    if (!localCreate) then
      !command      = |CREATE EXTRACT |+ !dbName + | FROM | + !from + !area + !controlled + !claim + !extNo + !primCommand + | REFBLOCKS | + !refBlockVal
    else
      !command      = |CREATE EXTRACT |+ !dbName + | FROM | + !from + !area + !controlled + !claim + !extNo + !primCommand + | REFBLOCKS | + !refBlockVal + ' DESC |' + !description + '|'
    endif
  endif
  -- Execute the command
  call !!admCommand(!command)
  handle (1,4)

    -- Db Already exists
    !!messageFile.error(141, 153, !dbName)

  elsehandle (1,15)

    -- Maximum number of databases reached
    !!messageFile.error(141, 154)

  elsehandle (1,17)

    -- File already exists
    !!messageFile.error(141, 155)

  elsehandle (1,19)

    -- Cannot open virgin database
    !!messageFile.error(141, 156, !dbName)

  elsehandle (1,35)

    -- Area does not exist
    !!messageFile.error(141, 157, !this.area.val)
    !this.area.val     = |Set by System|

  elsehandle (1,266)

      !message = !!error.text
      !this.extNo.val     = |Set by System|
      return error 1 !message

  elsehandle none

    -- Navigate to the new DB
    !dbName        = |/*|+ !dbName
    !foundDatabase = true
    !!ce           = !dbName.dbRef()
    handle any
      !foundDatabase = false
      -- try to get any updates from other locations and then go to element. If this fails then tell user to wait
      do !try from 2 to 5
        PROMPT 'Waiting for request to create DB to be serviced: Attempt $!try'
        PAUSE 4
        GETWORK
        !!ce = !dbName.dbRef()
        handle any
        elsehandle none
          !foundDatabase = true
          PROMPT DISMISS
          break
        endhandle
      enddo
      PROMPT DISMISS
    endhandle

    -- Set Propagate flags if required
    if( !localCreate and !globalProject ) then
      !typeDb = !!ce.typeDb
      !dbLoc = !!ce.member[1]
      if( !typeDb eq 'DESI' ) then
        !dbLoc.noLnkP = !this.linkDocuments.val.not()
      elseif( !typeDb eq 'PADD' ) then
        !dbLoc.picFD = !this.picture.val
      elseif( !typeDb eq 'SCHE' ) then
        !dbLoc.picFD = !this.picture.val
      endif

    endif

    if( !foundDatabase.not() ) then
      -- if the db is created at a satellite, this element will not exist
      -- until the transaction is complete (i.e. hub has notified satellite
      -- to create), and getwork done
      !!alert.warning('A request has been made to create a DB Extract. When the request has been serviced, use Getwork to create the DB Extract and update the Database lists.')
    else

      -- Set the database description
      if (!description neq 'unset') then
        !!ce.description = !description
        handle any
          -- stops failure while core not allowing description change
          --!!alert.warning('Problem with extract description. Description not set.')
        endhandle
      endif

      !!adminElem.dbSet(!!ce)
      !!adminElem.update('DB')
      -- Record the team selection
      !teamSelection = !this.projTeams.selection('rtext')
      !this.update()
      -- Try and reselect the original team selection before the update
      !this.projTeams.select('rtext', !teamSelection)
      -- Run the callback of the Team list gadget.
      !this.teamSel(!this.projTeams)
    endif

  elsehandle any

    !!alert.error( !!error.text )

  endhandle

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
--Method: .display()
--
-- Description: method to display the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display from in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display(!mode is STRING)

  !this.display(!mode, '')

endmethod
-- End of method definition for .display(STRING)

------------------------------------------------------------------------
--
--Method: .display()
--
-- Description: method to display the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display from in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display(!mode is STRING, !fromEntry is STRING)

  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE')then
    -- Invalid mode
    return error |Invalid mode for this form (!!admExtract)|
  endif

  !this.refSet(object DBREF())

  -- Show or update the form
  if (!this.shown()) then

    -- Re-initialise the form
    !this.init()

  else

    -- Show the form
    show !!admExtract free

  endif

  -- select the given DB if possible
  !this.projDbs.select('rtext',!fromEntry)
  handle any
  elsehandle none
    -- select the team of the given DB if possible
    !teamRef = !fromEntry.dbRef().own.own.string()
    handle any
    elsehandle NONE
      -- Run the callback of the Database list gadget.
      !this.origDbSel(!this.projDbs)
      !this.projTeams.select('rtext',!teamRef)
      handle ANY
      elsehandle NONE
        -- Run the callback of the Team list gadget.
        !this.teamSel(!this.projTeams)
      endhandle
    endhandle
  endhandle


endmethod
-- End of method definition for .display(STRING, STRING)

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: method to initialise the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Kill off calling form!
  if( defined(!!adminElemdb) ) then
    !!adminElemdb.hide()
  endif
  --kill !!adminElemQu

  -- Initialise variables
  !dbRef             = !this.refGet()
  !globalProject     = !!glbIsGlobal()
  !this.refBlockNo.val = |1|

  -- Reinstate the sort and filter gadgets
  if (!this.filterVal.set()) then
    !this.filter.val = !this.filterVal
  endif
  if (!this.sortVal.set()) then
    !this.sort.select('rtext',!this.sortVal)
    -- Run the callback of the Sort option gadget.
--    !this.teamArrList()
  endif

    -- Reinstate the sort and filter gadgets
  if (!this.dbFilterVal.set()) then
    !this.dbFilter.val = !this.dbFilterVal
  endif
  if (!this.dbSortVal.set()) then
    !this.dbSort.select('rtext',!this.dbSortVal)
    -- Run the callback of the db sort option gadget.
--    !this.origDbArrList()
  endif

  !this.formTitle      = |Create Extract|
  !this.name.val       = |unset|
  !this.desc.val       = |unset|

  -- Set Global Attributes
  if (!globalProject) then
--    !primary               = !!dbrGlbHubLocRf()
    !primary            = !!dbrGlbCurLocRf()
    !this.locSet(!primary)
    !this.primary.val   = !primary.name.substring(2)
  endif
    !this.extNo.val     = 'Set by System'
--    Commented out next line of code for DFN1969
--    !this.extNo.active  = !!glbHubStatus(!globalProject)

  -- Display a message
  !!messageFile.prompt(141, 4, !this.formTitle, !!messageFile.messageString(141, 803))

  -- clear the last original DB selection
  !this.origDb = object DBREF()

  -- Gather the DB information
  !this.origDbArrSet()

  -- Update the list of DBs
  !this.origDbArrList()

  -- Gather the team information
  !this.teamArrSet()

  -- Update the list of teams
  !this.teamArrList()

  -- Dismiss the prompt
  !!prompt(0)

  -- Select the current database in the list
  !adminDbRef = !!adminElem.element.selection().dbRef()
  if (!adminDbRef.accessDb eq 'Multiwrite') then
    !adminElement = !!adminElem.element.selection().dbRef().string()
    !this.projDbs.select('RTEXT',!adminElement)
    handle (61,567)
      -- Can not find in list
      !!alert.warning( |Cannot create extracts from selected database | & !adminDbRef.name.substring(3) )
      !this.projDbs.val = 1
    endhandle
    !team = !!adminElem.element.selection().dbRef().owner.owner
    !this.teamSet(!team)
    !this.projTeams.select('RTEXT',!team.string())
    !this.origDbSet(!adminDbRef)
    -- Set the database name paragraph gadget
    !this.extractName.val  = !team.name.substring(3) +|/|+ !this.name.val
  else
    !dbOwner  = !this.teamGet()
    -- Set the database name paragraph gadget
    if (!dbOwner.unset()) then
      !this.extractName.val  = |unset/|+ !this.name.val
    else
      !this.extractName.val  = !dbOwner.name.substring(3) +|/|+ !this.name.val
    endif

  endif

  -- name sure that there are DB's to pick
  if( !this.origDb.unset() ) then
    !!alert.error( 'Extracts cannot be made from any of the listed databases' )
    return
  else
    -- set the claim button to match owning DB (AK)
    if( !this.origDb.access.upcase() eq 'MULTIWRITE' ) then
      !origClaim = !this.origDb.claimDb
      handle any
        return
      endhandle
      !this.claim.select('Rtext',!origClaim.upcase() )
      handle any
        return
      endhandle
    endif

    -- Initial settings for Propagation flags
    if (!globalProject) then
      !this.setPropagateFlags( !this.origDb )
    endif
  endif

   --Added by DDC for Global Enhancements. Date :07.04.06

   --Modified by DDC for DFN 9249. Date :28.04.06
   if(!!admControl.isValid('Global') and !!dbrGlbCurLocRf().noextc) then
           !this.apply.active = false
        else
         !this.apply.active = !!admControl.isValid('Extracts')
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
--Method: .loc()
--
-- Description: Callback to Primary location gadget on the DB Definition form.
-- Gadget will accept Location NAME, DBREF or LOCID as a value.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Value for name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loc(!value is STRING)

  -- Initialise variables
  !curDbRef = !this.refGet()
  !curPrimLoc  = !this.locGet()

  -- See if the value starts with a '/'
  if (!value.substring(1,1) neq '/') then
    !name     = |/| + !value
  else
    !name     = !value
  endif

  -- See if the values can be navigated to
  !newLocDbRef    = !name.dbRef()
  handle any

    -- See if the value is the LOCID
    if (!value.length() neq 3) then

      -- Raise error
      !this.primary.val  = !curPrimLoc.name.substring(2)
      !!messageFile.error(141, 7, !value, 'LOC')

    endif

    !!ce      = !!dbrAdminGetWorld('LOC')
    !clause   = 'locid eq |'+ !value +'|'
    !locArray     = !!collectAllFor('LOC',!clause,!!ce)
    if (!locArray.size() neq 1) then

      -- Raise error
      !this.primary.val  = !curPrimLoc.name.substring(2)
      !!messageFile.error(141, 7, !value, 'LOC')

    endif

    -- Found a location
    !newLocDbRef    = !locArray[1]

  endhandle

  -- Return if value is already set
  if (!newLocDbRef eq !curPrimLoc) then
    return
  endif

  -- The entry can be found in the database
  -- Check that the element is of type LOC
  if (!newLocDbRef.type neq 'LOC') then

    -- Raise error
    !this.primary.val  = !curPrimLoc.name.substring(2)
    !!messageFile.error(141, 7, !newLocDbRef.name, !!messageFile.messageString(141, 815))

  endif

  -- Check that the element is initialised
  if (!newLocDbRef.lInit.boolean().not()) then

    -- Raise error
    !this.primary.val  = !curPrimLoc.name.substring(2)
    !!messageFile.error(141, 518, !newLocDbRef.name.substring(2))

  endif

  -- Validate that this is a suitable satellite
  !hubRef    = !!dbrGlbHubLocRf()
  !curLoc = curLoc
  if( !curLoc neq !hubRef and !curLoc neq !newLocDbRef and !curLoc neq !newLocDbRef.prmLoc ) then
       -- Invalid selection - Location not administered by Curloc
      !this.primary.val  = !curPrimLoc.name.substring(2)
      !!messageFile.error(141, 559, !newLocDbRef.name.substring(2), !curLoc.name.substring(2) )
  endif

  -- Check that the user is not trying an illegal move:-
  -- On-line Satellite   ->  Off-line satellite
  -- Off-line Satellite  ->  On-line satellite
  if (!curDbRef.set()) then

    -- !hubRef    = !!dbrGlbHubLocRf()
    -- !!ce       = !curDbRef
    -- DBLOC 1
    -- !curLocRef   = !!ce.locRf
    !curLocRef = !curDbRef.prmLoc
    !onLine   = !curLocRef.iconn.boolean()
    if (!onLine) then

      -- Check move for on-line database from satellite to off-line
      if (!curLocRef neq !hubRef and not !newLocDbRef.iconn.boolean()) then
        -- Illegal change primary for an on-line db
        !this.primary.val  = !curPrimLoc.name.substring(2)
        !!messageFile.error(141, 547, !curLocRef.name.substring(2), !newLocDbRef.name.substring(2))
      endif

    elseif (not !onLine) then

      -- Check move for off-line database
      if (!newLocDbRef neq !hubRef) then
        -- Illegal change primary for off-line db
        !this.primary.val  = !curPrimLoc.name.substring(2)
        !!messageFile.error(141, 548, !curLocRef.name.substring(2), !newLocDbRef.name.substring(2))
      endif

    endif

  endif

  -- Element is valid so store the values
  !this.locSet(!newLocDbRef)
  !this.primary.val  = !newLocDbRef.name.substring(2)

  -- set the Propagate Flags
  !this.setPropagateFlags( !this.origDb )

endmethod
-- End of method definition for .loc(STRING)

