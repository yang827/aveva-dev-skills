--  Created:         Wed Mar 28 10:02:50 2007

--
--  Description:     -- Form definition to facilitate the handling of the folder upgrade process-- using the APPFOLDERUPGRADE PML2 object--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addFolder()                      -                   Adds an explicitly given folder to the job contents
--  addLocation()                    -                   Adds the subfolders of the Global location to the job contents
--  addLocationSingle(STRING,STRING) REAL                Auxiliary routine, adding a single folder from the Global location to the job contents
--  addProject()                     -                   Adds the folders of the given project to the job contents
--  addProjectSingle(STRING,STRING)  REAL                Auxiliary routine, adding a single project's folder to the job contents
--  admFolderUpgrade()               -                   Perform the initial construction of the object
--  browse()                         -                   Callback to the Browse button (shows the File selection dialog)
--  cbfr1()                          -                   Callback procedure on frame fr1
--  cbfr2()                          -                   Callback procedure for frame fr2
--  clear()                          -                   Clears internal structures and frame gadgets from any previous use
--  doAdd(STRING,STRING,BOOLEAN)     -                   Auxiliary routine, adding the folder to the job contents
--  init()                           -                   The procedure called before the form is shown
--  remove()                         -                   Removes currently selected single item from the job contents list
--  setFolder(STRING)                -                   Callback from the file selection dialog (sets the folder name field)
--  updateJob()                      -                   Updates the contents of the Job list, reflecting the current job contents
--  upgrade(STRING)                  -                   Performs the upgrade or check of the folder structure
--  validFolder()                    -                   Validates the explicitly given folder path (folderName)
--  validLocation()                  -                   Validates the transfer area environment variable (locName)
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            admfolderupgrade.pmlfrm
--   Type:          Form Definition
--   Group:         Admin Application
--     Keyword:     ADM
--   Module:        admin
--   Replaces:
--
-- Author:          T.Lisowski
--
-- Description:
-- Form definition to facilitate the handling of the folder upgrade process
-- using the APPFOLDERUPGRADE PML2 object
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------

kill !!admFolderUpgrade

setup form !!admFolderUpgrade resize
  Import 'pmlfilebrowser'
  handle any
  endhandle

  member .jobData is ARRAY
  member .out is ARRAY
  member .lastDir is STRING

  path down
  frame .fr1 ' Upgrade '
    rtoggle .upgProject 'Project' tagwidth 6 $
      tooltip 'Selects the directories of the given project (e.g. SAMPIC, SAMDWG)'
    rtoggle .upgLocation 'PDMS Global location' at xmin_upgProject ymax_upgProject+0.3 tagwidth 12 $
      tooltip 'Selects the subdirectories of the given location transfer area (e.g. %SAM_LOC%\sampic, %SAM_LOC%\samdwg)'
    rtoggle .upgFolder 'Any folder' at xmin_upgProject ymax_upgLocation+0.5 tagwidth 6 $
      tooltip 'The path to upgrade is given explicitly'
    text .prjName at xmax_upgProject+0.5 ymin_upgProject width 13 is STRING $
      tooltip 'The name of the project to upgrade (e.g. SAM)'
    text .locName at xmax_upgLocation+0.5 ymin_upgLocation width 7 is STRING $
      tooltip 'The environment variable defining the location''s transfer area (e.g. SAM_LOC)'
    text .folderName at xmax_upgFolder+0.5 ymin_upgFolder width 41 is STRING tooltip 'The path to upgrade'
    path right
    button .btnBrowse 'Browse' width 10 at xmax-size ymin-1.2 callback '!this.browse()' $
      tooltip 'Browses the file system for a path to upgrade'
    frame .fr1a ' File handling mode ' at xmax_prjName+0.5 ymin_prjName-0.3 width 16
      rtoggle .fileMove 'Move' tagwidth 5 at ymax-0.3 $
        tooltip 'Existing files will be distributed among subfolders'
      rtoggle .fileDel 'Delete' tagwidth 5 at xmin ymax $
        tooltip 'Existing files will be deleted. USE WITH CAUTION!!!'
    exit
    frame .fr1b | 'Any folder' upgrade mode | at xmin_upgProject ymax_upgFolder+0.2 width 16
      rtoggle .afPF 'DRAFT picture files' at ymax-0.3 tagwidth 15 $
        tooltip 'The given folder will be upgraded like the folder containing the DRAFT picture files'
      path right
      rtoggle .afDWG 'PDMS DWG picture files' tagwidth 16 $
        tooltip 'The given folder will be upgraded like the folder containing the PDMS DWG picture files'
    exit
    button .btnAdd 'Add' at xmax_folderName-size ymin+0.2 anchor left + right callback '!this.addProject()' width 10 heigh 1.7 $
      tooltip 'Adds the selected folders to the job contents for processing'
    path down
  exit

  list .job 'Job contents' anchor all columns single zerosel width_fr1 length 8 $
    tooltip 'List of folders to process with their parameters'
  frame .fr2 'Log level' at x0 width_fr1
    rtoggle .log0 'No logging' tagwidth 6 at ymax-0.3
    path right
    rtoggle .log1 'Errors and warnings only' tagwidth 15
    rtoggle .log2 'Full logging' tagwidth 8
    text .logFile 'Log file name' tagwidth 10 at xmin_log0 ymax width 30 is STRING $
      tooltip 'The path to the user-specified log file'
    toggle .lfAuto 'Automatic' tagwidth 6 callback '!this.logFile.active = not !this.lfAuto.val' $
      tooltip 'If checked, the system will choose the log file name automatically'
  exit
  textpane .output 'Output' at x0 ymax+0.5 width_fr1 height 16
  button .btnUpgrade 'Upgrade' at x0 ymax+0.5 callback |!this.upgrade('FULL')| width 8 $
    tooltip 'Upgrades the listed folders updating the subfolder structure and moving files if necessary' APPLY
  path right
  button .btnCheck 'Check only' callback |!this.upgrade('CHECKONLY')| width 8 $
    tooltip 'Just checks the folder structure without attempting to update it' APPLY
  button .btnRemove 'Remove job item' callback '!this.remove()' width 12 $
    tooltip 'Removes a single entry (selected) from the Job contents list'
  button .btnClear 'Clear job' callback '!this.clear()' width 8 $
    tooltip 'Removes all entries from the Job contents list and clears the output pane'
  button .btnClose 'Close' callback '!this.hide()' width 8 CANCEL
exit

------------------------------------------------------------------------
--
-- Method:      admFolderUpgrade
--
-- Description: Perform the initial construction of the object
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .admFolderUpgrade()
  !this.formTitle = 'Folder structure upgrade'
  !this.initcall = '!this.init()'
  !this.jobData = ARRAY()
  !this.out = ARRAY()
  !this.fr1.callback = '!this.cbfr1()'
  !this.fr2.callback = '!this.cbfr2()'
  !this.locName.validateCall = '!this.validLocation()'
  !this.folderName.validateCall = '!this.validFolder()'
  !head[1] = 'Folder'
  !head[2] = 'Options'
  !head[3] = 'Path'
  !this.job.setHeadings(!head)
  !this.output.setEditable(false)
  !this.lastDir = 'C:\'
endmethod

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: The procedure called before the form is shown
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .init()
  !this.fr1a.val = 1
  !this.fr1b.val = 1
  !this.prjName.val = ''
  !this.locName.val = ''
  !this.folderName.val = ''
  !this.job.clear()
  !this.fr1.val = 1
  !this.logFile.val = ''
  !this.lfAuto.val = true
  !this.fr2.val = 2
  !this.cbfr1()
  !this.cbfr2()
  !this.btnUpgrade.active = false
  !this.btnCheck.active = false
  !this.btnRemove.active = false
endmethod

------------------------------------------------------------------------
--
-- Method:      cbfr1
--
-- Description: Callback procedure for frame fr1
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .cbfr1()
  !ind = !this.fr1.val
  if( !ind.eq(1) ) then
    !this.fr1b.active = false
    !this.prjName.active = true
    !this.locName.active = false
    !this.folderName.active = false
    !this.btnBrowse.active = false
    !this.btnAdd.callback = '!this.addProject()'
  elseif( !ind.eq(2) ) then
    !this.fr1b.active = false
    !this.prjName.active = false
    !this.locName.active = true
    !this.folderName.active = false
    !this.btnBrowse.active = false
    !this.btnAdd.callback = '!this.addLocation()'
  elseif( !ind.eq(3) ) then
    !this.fr1b.active = true
    !this.prjName.active = false
    !this.locName.active = false
    !this.folderName.active = true
    !this.btnBrowse.active = true
    !this.btnAdd.callback = '!this.addFolder()'
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      cbfr2
--
-- Description: Callback procedure for frame fr2
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .cbfr2()
  !isAuto = !this.lfAuto.val
  !ind = !this.fr2.val
  if( !ind.eq(1) ) then
    !this.logFile.active = false
    !this.lfAuto.active = false
  else
    !this.lfAuto.active = true
    !this.logFile.active = not !isAuto
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      validLocation
--
-- Description: Validates the transfer area environment variable (locName)
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .validLocation()
  !loc = !this.locName.val.trim().upCase()
  if( !loc.empty().not() ) then
    !ind = !loc.match('_')
    if( !ind.lt(1) ) then
      return error 1 'The environment variable $!loc does not have the correct format!'
    endif
    var !eloc evar '$!loc'
    if( !eloc.empty() ) then
      return error 2 'The environment variable $!loc is not defined!'
    endif
    !f = object FILE(!eloc)
    if( !f.exists() ) then
      if( !f.type().eq('DIRECTORY') ) then
        return
      endif
    endif
    return error 3 'The environment variable $!loc does not define an existing directory!'
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      validFolder
--
-- Description: Validates the explicitly given folder path (folderName)
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .validFolder()
  !folder = !this.folderName.val.trim()
  if( !folder.empty() ) then
    return
  endif
  !f = object FILE(!folder)
  if( !f.exists() ) then
    if( !f.type().eq('DIRECTORY') ) then
      return
    endif
  endif
  return error 1 'The folder $!folder does not exist!'
endmethod

------------------------------------------------------------------------
--
-- Method:      browse
--
-- Description: Callback to the Browse button (shows the File selection dialog)
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .browse()
  !!fileBrowser(!this.lastDir, 'dummy.file', |Navigate to the desired folder, and click 'Open'|, FALSE, '!!admFolderUpgrade.setFolder(!!fileBrowser.file.pathName())')
endmethod

------------------------------------------------------------------------
--
-- Method:      setFolder
--
-- Description: Callback from the file selection dialog (sets the folder name field)
--
-- Method Type: procedure
-- Arguments:
--    1    R    STRING   folder name returned from the file selection dialog
-- Return:
------------------------------------------------------------------------
define method .setFolder(!name is STRING)
  !this.lastDir = !name
  !this.folderName.val = !name
endmethod

------------------------------------------------------------------------
--
-- Method:      addProject
--
-- Description: Adds the folders of the given project to the job contents
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .addProject()
  !project = !this.prjName.val.trim().upCase()
  if( !project.empty() ) then
    !this.prjName.setFocus()
    return
  endif
  !count = !this.addProjectSingle(!project, 'PIC')
  !count = !count + !this.addProjectSingle(!project, 'DWG')
  !count = !count + !this.addProjectSingle(!project, 'DRG')
  if( !count.eq(0) ) then
    !!alert.warning('No suitable environment variable has been found. Does the project $!project exist ...?')
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      addProjectSingle
--
-- Description: Auxiliary routine, adding a single project's folder to the job contents
--
-- Method Type: procedure
-- Arguments:
--    1    R    STRING   project code
--    2    R    STRING   'kind' of folder (PIC, DWG, or DRG)
-- Return:
--    REAL      1, if the environment variable has been found, otherwise 0
------------------------------------------------------------------------
define method .addProjectSingle(!project is STRING, !kind is STRING) is REAL
  !evar = !project & !kind
  var !ev evar '$!evar'
  if( !ev.empty() ) then
    return 0
  endif
  !path = '%' & !evar & '%'
  !isDWG = !kind.eq('DWG')
  !this.doAdd(!path, !ev, !isDWG)
  return 1
endmethod

------------------------------------------------------------------------
--
-- Method:      addLocation
--
-- Description: Adds the subfolders of the Global location to the job contents
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .addLocation()
  !ev = !this.locName.val.trim().upCase()
  if( !ev.empty() ) then
    !this.locName.setFocus()
    return
  endif
  !project = !ev.before('_').lowCase()
  !base = '%' & !ev & '%\' & !project
  !count = !this.addLocationSingle(!base, 'pic')
  !count = !count + !this.addLocationSingle(!base, 'dwg')
  !count = !count + !this.addLocationSingle(!base, 'drg')
  if( !count.eq(0) ) then
    !!alert.warning('No suitable subfolder has been found for the PDMS Global transfer area %$!ev%')
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      addLocationSingle
--
-- Description: Auxiliary routine, adding a single folder from the Global location to the job contents
--
-- Method Type: procedure
-- Arguments:
--    1    R    STRING   Base path name
--    2    R    STRING   'Kind' of the folder (pic, dwg, or drg)
-- Return:
--    REAL   1, if the subfolder has been found, otherwise 0
------------------------------------------------------------------------
define method .addLocationSingle(!base is STRING, !kind is STRING) is REAL
  !isDWG = !kind.eq('dwg')
  !path = !base & !kind
  !f = object FILE(!path)
  if( !f.exists() ) then
    if( !f.type().eq('DIRECTORY') ) then
      !this.doAdd(!path, !f.fullName(), !isDWG)
      return 1
    endif
  endif
  return 0
endmethod

------------------------------------------------------------------------
--
-- Method:      addFolder
--
-- Description: Adds an explicitly given folder to the job contents
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .addFolder()
  !folder = !this.folderName.val
  if( !folder.empty() ) then
    !this.folderName.setFocus()
    return
  endif
  !isDWG = !this.fr1b.val.eq(2)
  !this.doAdd(!folder, !folder, !isDWG)
endmethod

------------------------------------------------------------------------
--
-- Method:      doAdd
--
-- Description: Auxiliary routine, adding the folder to the job contents
--
-- Method Type: procedure
-- Arguments:
--    1    R    STRING   Original (as given) folder name
--    2    R    STRING   Evaluated folder name with environment variables expanded
--    3    R    BOOLEAN  True, if the folder is processed as the PDMS DWG folder, otherwise False
-- Return:
------------------------------------------------------------------------
define method .doAdd(!original is STRING, !evaluated is STRING, !isDWG is BOOLEAN)
  !locOrg = !original
  if( !original.substring(-1,1).eq('\') and !original.length().gt(3) ) then
    !locOrg = !locOrg.substring(-2)
  endif
  if( !isDWG ) then
    !kind = '2'
  else
    !kind = '1'
  endif
  !locEval = !evaluated
  if( !evaluated.substring(-1,1).eq('\') and !evaluated.length().gt(3) ) then
    !locEval = !evaluated.substring(-2)
  endif
  !fileMode = !this.fr1a.val.string()
  !full = !fileMode & !kind & !locOrg
  !fullUp = !full.upCase()
  !locOrg = !locOrg.upCase()
  -- Scan existing entries for duplicates
  !notFound = true
  do !ind indices !this.jobData
    !entry = !this.jobData[!ind].before('|').upCase()
    !org = !entry.substring(3)
    -- if the same dir already present with the same parameters
    if( !entry.eq(!fullUp) ) then
      return
    endif
    -- if the same dir already present, but with some other parameters
    if( !org.eq(!locOrg) ) then
      !res = !!alert.confirm('The folder $!locOrg is already included, but with some other processing parameters. Do you want to replace the job entry?')
      if( !res.boolean() ) then
        !this.jobData[!ind] = !full & '|' & !locEval
        !notFound = false
        break
      else
        return
      endif
    endif
  enddo
  if( !notFound ) then
    -- Not found, add a new entry
    !s = !full & '|' & !locEval
    !this.jobData.append(!s)
  endif
  !this.updateJob()
endmethod

------------------------------------------------------------------------
--
-- Method:      updateJob
--
-- Description: Updates the contents of the Job list, reflecting the current job contents
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .updateJob()
  !res = ARRAY()
  do !s values !this.jobData
    !parts = !s.split('|')
    !org = !parts[1].substring(3)
    !row = ARRAY()
    !row[1] = !org
    !i1 = !s.substring(1,1)
    !i2 = !s.substring(2,1)
    if( !i2.eq('1') ) then
      !s1 = 'Picture files'
    else
      !s1 = 'PDMS DWG files'
    endif
    if( !i1.eq('1') ) then
      !s2 = ' (Move)'
    else
      !s2 = ' (Delete)'
    endif
    !row[2] = !s1 + !s2
    !ev = !parts[2]
    if( !org.eq(!ev) ) then
      !row[3] = ''
    else
      !row[3] = !ev
    endif
    !res.append(!row)
  enddo
  !this.job.setRows(!res)
  !state = !this.jobData.size().gt(0)
  !this.btnUpgrade.active = !state
  !this.btnCheck.active = !state
  !this.btnRemove.active = !state
endmethod

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Clears internal structures and frame gadgets from any previous use
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .clear()
  !this.jobData.clear()
  !this.job.clear()
  !this.out.clear()
  !this.output.clear()
  !this.btnUpgrade.active = false
  !this.btnCheck.active = false
  !this.btnRemove.active = false
endmethod

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Removes currently selected single item from the job contents list
--
-- Method Type: procedure
-- Arguments:
-- Return:
------------------------------------------------------------------------
define method .remove()
  if( !this.job.selection().empty().not() ) then
    !ind = !this.job.pickedField
    !this.jobData.remove(!ind)
    !this.updateJob()
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      upgrade
--
-- Description: Performs the upgrade or check of the folder structure
--
-- Method Type: procedure
-- Arguments:
--    1    R    STRING   Either 'FULL' or 'CHECKONLY' (upgrade mode)
-- Return:
------------------------------------------------------------------------
define method .upgrade(!mode is STRING)
  if( !this.jobData.size().eq(0) ) then
    !!alert.error('You have not said, what folders to upgrade! Add all required folders to the job contents first ...')
    return
  endif
  !log = !this.fr2.val
  if( !log.eq(1) ) then
    !opt = 'CMD=0, LOG=0, TIM=0'
    !logFile = ''
  else
    if( !log.eq(2) ) then
      !opt = 'CMD=0, LOG=1, TIM=1'
    else
      !opt = 'CMD=0, LOG=2, TIM=1'
    endif
    if( !this.lfAuto.val ) then
      !logFile = ''
    else
      !logFile = !this.logFile.val
      if( !logFile.empty() ) then
        !this.logFile.setFocus()
        return
      endif
    endif
  endif
  !obj = object APPFOLDERUPGRADE(!opt, !logFile)
  do !s values !this.jobData
    !parts = !s.split('|')
    !entry = !parts[1]
    !dir   = !entry.substring(3)
    !fMode = !entry.substring(1,1)
    !kind  = !entry.substring(2,1)
    if( !kind.eq('1') ) then
      !method = 'upgradePIC'
    else
      !method = 'upgradeDWG'
    endif
    if( !fMode.eq('1') ) then
      !action = 'MOVE'
    else
      !action = 'DELETE'
    endif
    !obj.addPath(!dir, !method, !action)
  enddo
  !add = ARRAY()
  !isFull = !mode.eq('FULL')
  !dt = object DATETIME()
  !timeStamp = !dt.string()
  if( !isFull ) then
    !add.append('$!timeStamp - Performing FULL upgrade ...')
  else
    !add.append('$!timeStamp - Checking the folder structure ...')
  endif
  !res = !obj.upgrade(!mode)
  if( !obj.logLevel.eq(0) ) then
    if( !log.neq(1) ) then
      !add.append('Log file could not be created! Logging has been turned off ...')
    endif
  else
    !lf = !obj.logFPath
    !add.append('Log file: $!lf')
  endif
  !err = !obj.errorMsg(!res)
  do !ind indices !err
    !s = '  ' & !ind & '. ' & !err[!ind]
    !add.append(!s)
  enddo
  if( !obj.isOK(!res) ) then
    if( !isFull ) then
      !msg = 'Success! The folder structure was successfully verified/updated!'
    else
      !msg = 'Success! No errors have been detected while analysing the folder structure'
    endif
  elseif( !isFull ) then
    !msg = 'Errors encountered while updating the folder structure!'
  else
    !msg = 'Errors encountered while checking the folder structure!'
  endif
  !add.append(!msg)
  !add.append('------------------------------------------------------------------------')
  !this.out.insertArray(1, !add)
  !this.output.val = !this.out
endmethod
