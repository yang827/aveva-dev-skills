--
--
-- Description:
-- Form to allow for definition of Admin FONTS.
--
------------------------------------------------------------------------

-- Define form
setup form !!admFonts

  !!admFonts.formTitle     = |Font Family Definitions|
  !!admFonts.iconTitle     = |FONT DEF|
  !!admFonts.callback      = |call !!admFontsInit()|
  !!admFonts.formRevision  = | $Revision: 1.8 $ |

  -- Body of form definition
  text .fontDir at x 4 y 0.2 |Font Directory| call |call !!admFontsDir()| width 17 scroll 17 NAME

  list .fontList at x 0.5 ymax+0.5 |Current Font Settings| call |call !!admFontsSelect()| $
       width 48 length 5

  frame .setFont at x 0 ymax.fontList+0.1 |Font Details|

    rgroup .fontType at xmin+0.5 ymin.setFont+1 call |call !!admFontsType()|
      add tag |System Font|
      add tag |User Defined Font|
    exit

 -- System font attribute group
    frame .sysFr at xmin+0.5 ymax+0.1 |System Font|

      option .irno     at xmin+0.5 ymin+1 |Font Type      | width 28
      option .style    at xmin ymax+0.2   |Font Style     | width 28
      text   .sysAngle at xmin ymax+0.2   |Angle          | width 10 int min -85 max 85

    exit

  -- User defined font attribute group
    frame .userFr at xmin.sysFr ymax.sysFr+0.5 |User Defined Font|

      text .stdFile   at xmin+0.5 ymin+1 |Std. Font Name | call |call !!admFontsChkFile(_stdFile)| width 30 scroll 120 name
      text .boldFile  at xmin ymax+0.2   |Bold Font Name | call |call !!admFontsChkFile(_boldFile)| width 30 scroll 120 name
      text .udefAngle at xmin ymax+0.2   |Angle          | width 10 int min -85 max 85

    exit
  exit

  button .apply at xmin.fontList ymax.userFr+0.5 |Apply| call |call !!admFonts()| APPLY
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  -- Member Definitions
    -- Array of DBREF (1-4) for fontfamilies
    member .font      is ARRAY
    -- Current font number
    member .current   is REAL
    -- Array of STYLE data (object FONTSTYLE)
    member .styleData is ARRAY
    -- Array of IRNO data (object FONTIRNO)
    member .irnoData  is ARRAY

exit
-- End of form definition for !!admFonts
