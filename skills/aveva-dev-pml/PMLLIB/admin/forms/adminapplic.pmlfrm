-- File:            adminapplic.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Tue May 6 08:56:01 BST 1997
--
--
-- Description:
-- Admin Application bar menu definition file.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adminApplic()                    -                   Constructor
--  changeAdmLoc(DBREF)              -                   Callback function to change Location if user changes gadget
--  dacControl(MENU,STRING)          -                   Callback to control Data Access Control status (on/off)
--  dacStatus()                      -                   Updates display of Data Access Control status on/off
--  getAdmContext()                  DBREF               Get the location that is now the context of Administration
--  getPossLocs()                    -                   Method which works out locations that can be administered
--  getWorkRefresh()                 -                   This function forces a getwork and refreshes key forms/gadgets
--  init()                           -                   initialise the form
--  isGlobalHub()                    BOOLEAN             If the project is Global then this method will determine
--  lock()                           -                   Callback to set the locking
--  marEnvSetup()                    -                   Callback to display the Marine environment setup form
--  ntAuth()                         -                   Callback to control NT Authentication status (on/off)
--  propagateLinkDocuments()         -                   Callback to control Propagate Link Documents status (on/off)
--  queryList(FORM)                  -                   Define common query list menu
--  setAdmContext(DBREF)             -                   Sets Location that is NOW the context of Administration
--  setLinkDocumentUIState()         -                   Set the state of the Propagate Link Document flag on the UI
--  setMenuState()                   -                   This method may be called at any time a will set the menu state
--
------------------------------------------------------------------------

-- Define form
setup form !!adminApplic at xr 0 yr 0 main size 95 0

  !this.formTitle     = 'Admin - AVEVA PDMS'
  !this.iconTitle     = 'Admin - AVEVA PDMS'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.89 $ '
  !this.quitCall      = |CALLIB XEXIT|

  -- Body of form definition

  -- Top level menu
  bar
  exit

  -- Relative positioning
  valign centre
  path   right
  hdist  2

  -- Project information
  para .pInfo at x0 y0 text 'Project Information' width 24

  -- Project Isolation gadget (GLOBAL)
  if (!!admControl.isGlobal()) then

    if(!!admControl.isValid('Centralised Admin')) then
      option .admLocation 'Administering ' callback '!this.changeAdmLoc(!this.locList[!this.admLocation.val])' width 6
    endif

    -- Data Access Control is available
    if(!!admControl.isValid('Data Access Control')) then
      para .dacStatus                    text 'DAC    '
    endif
    -- NT Authentication is available
    para .ntAuthStatus                    text 'NT Authentication    '

    -- Propagate Link Documents
    para .propagateLinkDocumentsStatus text 'Link Documents    '

    -- Project type
    para .projType                       text 'Type       '

    para   .lockTx1                      text 'Project '
    para   .lock     at xmax ymin        text 'UnLocked'

    toggle .isolate 'Isolation'          callback 'call !!glbIsolateDaemon(!!adminApplic.isolate)'

  else

    -- Data Access Control is available
    if(!!admControl.isValid('Data Access Control')) then
      para .dacStatus                    text 'DAC    '
    endif

    -- NT Authentication is available
    para .ntAuthStatus                    text 'NT Authentication    '

    -- Project type
    para .projType                       text 'Type       '

    para   .lockTx1                      text 'Project '
    para .lock     at xmax ymin          text 'UnLocked'

  endif

  -- Form member definition
  member .world           is DBREF
  member .statWorld       is DBREF
  member .teamWorld       is DBREF
  member .userWorld       is DBREF
  member .mdbWorld        is DBREF
  member .scopeWorld      is DBREF
  member .roleWorld       is DBREF
  member .dbSetWorld      is DBREF
  member .acrWorld        is DBREF
  member .stampWorld      is DBREF

  -- This Member is the Current Size of the Admin Elements Form
  member .sizeOfAdmElem   is REAL

  -- Database types
  member .typeDb          is ARRAY

  -- Only for global projects
  member .gStatWorld      is DBREF
  member .locnWorld       is DBREF
  member .lComWorld       is DBREF
  member .hubRef          is DBREF
  member .packageWorld    is DBREF

  -- A technique, so later, I can grab an location object from
  -- the location gadget instead of only Text
  member .locList         is ARRAY
  member .currentAdmLoc   is DBREF


exit
-- End of form definition for !!adminApplic

----------------------------------------------------------------------
--
-- Method:      adminApplic
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .adminApplic()

  -- For Marine/Schematic Header
  !mm = object AVEVAMODULEMANAGER()
  !product = !mm.currentProductName()
  !this.formTitle = 'Admin - AVEVA $!product'

  -- Initialise Variables

  -- Check the projects Global settings
  !globalProject = !!admControl.isGlobal()

  -- Define Main Bar Menu
  !bar      = !this.bar
  !bar.add('Admin',     'Admin')
  !bar.add('Display',   'Display')
  !bar.add('Query',     'Query')
  !bar.add('Settings',  'Settings')
  !bar.add('Utilities', 'Utilities')
  !bar.add('Project',   'Project')
  !bar.add('Data',      'Data')

  -- Only available for Global Projects
  if (!globalProject) then
    !bar.add('Remote',  'GlbRemote')
  endif

  if(!!mmsIsThis3dmmProj()) then
    !bar.add('Install',   'Install')
  endif
    !bar.add('Window',    'WINDOW')
    !bar.add('Help',      'Help')

  ----------------------------- Define Main Menus -----------------------------

  ----------------------------- Admin Menu Option -----------------------------
  !admin       = !this.newMenu('admin')
  !admin.add('separator')
    !admin.add('callback', 'Save Work',             'call !!comSavework()')

  !admin.add('callback', 'Get Work',              '!this.getWorkRefresh()')

    !admin.add('callback', 'Session Comment...',    'show !!msgSavework')
    !admin.add('separator')
    !admin.add('menu',     'Modules',               'modules')
    !admin.add('separator')
    !admin.add('callback', 'Exit',                  '$M "%PMLLIB%/limbo/functions/moduleswitch.pmlfnc" $<EXIT$>')

    -- Set the modules menu
    call !!moduleMenus(!this)
    handle ANY
    endhandle

  ----------------------------- Display Menu Option -----------------------------
  !display     = !this.newMenu('display')
    !display.add('callback', 'Admin Elements...',   'show !!adminElem')
    !display.add('callback', 'Command Window...',     'show !!cadcBth free')
  !display.add('TOGGLE',   'Admin Explorer',     '',                   'Admin Explorer')
  !display.add('TOGGLE',   'Global Explorer',     '',                   'Global Explorer')
  !display.add('TOGGLE',   'My Data',             '',                'My Data')
  !display.add('TOGGLE',   'Reference List',      '',                'Reference List')
  !display.add('TOGGLE',   'Attributes...',  '',                'Attributes Utility')
  !display.add('TOGGLE',   'Search...',  '',                    'Find Utility')
  !display.add('TOGGLE',   'Search Results...',  '',                    'Output Utility')

  ----------------------------- Query Menu Option -----------------------------
  !query       = !this.newMenu('query')
    !query.add('menu',    'Project',                'list')

    -- Only valid for global projects
    !flag = !!admControl.isValid('Locking and Isolation') and !!admControl.isValid('Communications')
    if (!flag) then
      !query.add('separator')
      !query.add('menu',  'Global Status',          'glbStates')

      ----------------------------- Global State Menu -----------------------------
      ---To replace the old forms "glbPing & qryLockIsol" with new forms "glbModulesPing & glbQryLockIsol"
      !glbStates      = !this.newMenu('glbStates')
      if(!!admControl.isValid('Locking and Isolation')) then
        !glbStates.add('callback',  'Locking & Isolation...',  'show !!glbQryLockIsol')
      endif

      -- None off line working
      if(!!admControl.isValid('Communications')) then
        !glbStates.add('callback',  'Communications...',       'show !!glbModulesPing')
      endif
    endif

    ----------------------------- List Menu -----------------------------
    !this.queryList(!this)

  ----------------------------- Settings Menu Option -----------------------------
  !settings      = !this.newMenu('Settings')

    !settings.add('menu',       'Display Mode','displayMode')
    !settings.add('callback',   'Change Password ...',      'show !!admSetChPass')
    !settings.add('callback',   'DB Number Range ...',      'show !!admDBRange')

    if (!!admControl.isValid('Global Extract Range'))then
      !settings.add('callback', 'Global Extract Range ...', 'show !!glbExtractRange')
    endif

    if(!!admControl.isValid('Daemon'))then
      !settings.add('separator')
      !settings.add('callback', 'Daemon Settings...',       'show !!glbDaemon')
    endif

    -- Transactions Event Timings
    if (!!admControl.isGlobal()) then
      !settings.add('callback',        'Transaction Timings...',         'show !!glbEventTimings')
      !settings.add('callback',        'Transaction dB Merge/Purge...',  'show !!glbMergePurgeTimings')
    endif

    --------------------------- Display Mode Menu ---------------------------
    !displayMode = !this.newMenu('displayMode')

      !displayMode.add('callback',    'Names',                          '!!admElemText(|NAME|)')
      !displayMode.add('callback',    'Descriptions',                   '!!admElemText(|DESC|)')
      --!displayMode.add('callback',    'Resize Admin Elements form... ', 'show !!admSizeOfAdmEle')
      !displayMode.add('callback',    'Setup Admin Elements form... ',  'show !!admElementDetail')

      if(!!admControl.isValid('Configuration File')) then
        !displayMode.add('menu',      'Manage User Config file',        'manageFile')

        !manageFile = !this.newMenu('manageFile')
          !manageFile.add('callback', 'Load Current Config',            '!!admDisplayConfig.load()')
          !manageFile.add('callback', 'Save Current Config',            '!!admDisplayConfig.save()')
          !manageFile.add('callback', 'Reset Config to Defaults',       '!!admDisplayConfig.reset()')
          !manageFile.add('callback', 'Delete YOUR Config',             '!!admDisplayConfig.deleteFile()')

      endif

  ----------------------------- Utilities Menu Option -----------------------------
  !utilities   = !this.newMenu('Utilities')

    !utilities.add('callback',        'Integrity Checker...',           'show !!admDic')
    if (!!admControl.isGlobal()) then
      !utilities.add('callback',        'System DB Repair...',            'call !!admRepair(true)')
    endif
    !utilities.add('callback',        'Send Message...',                'show !!admMess')

    -- Transactions
    if (!!admControl.isGlobal()) then
      !utilities.add('callback',      'Transactions...',                'show !!glbTransactions')
    endif

    if(!!admControl.isValid('Offline Transfer')) then
      !this.utilities.add('separator')
      !this.utilities.add('callback', 'Offline Transfer...',            'show !!glbTransfer')
    endif

    -- Export and Import Admin Elements to and from Excel
    !utilities.add('separator')
    !utilities.add('callback', 'Export...', '', 'Export')
    !utilities.add('callback', 'Import...', '', 'Import')
    !utilities.add('callback', 'Rollback...', '', 'Rollback')

  ----------------------------- Project Menu Option -----------------------------
  !project     = !this.newMenu('Project')

    !project.add('callback',          'Information...',                 'show !!projectInfo')
    !project.add('callback',          'Font Families...',               'show !!admFonts')
    !project.add('callback',          'TrueType fonts...',              'show !!admTTFonts')
    !project.add('callback',          'Module Definitions...',          'show !!admModDef')

    if(!product.upcase().eq('HULL & OUTFITTING')) then
       !project.add('callback',       'Marine environment setup...',    '!this.marEnvSetup()')
    endif

    !project.add('separator')
    !project.add('menu',              'Replicate',                      'replicate')
    !project.add('separator')
    !project.add('menu',              'Expunge',                        'expunge')
    !project.add('separator')
    !project.add('toggle',            'NT Authentication...',           '!this.ntAuth()' ,'NTAuth')

    if (!globalProject) then
      !project.add('toggle',            'Propagate Link Documents...',           '!this.propagateLinkDocuments()' ,'LinkDocuments')
    endif

    -- This menu option should only be available at the HUB on a global project
    if(!!admControl.isValid('Data Access Control')) then
      if (!globalProject) then
        !curLoc    = CURLOC
        !locWorld  = /*GL
        !hereIsHub = !curLoc eq !locWorld.hubRf
        if(!hereIsHub) then
          !project.add('separator')
          !project.add('toggle',          'Data Access Control...',         '!this.dacControl(')
        endif
      else
        !project.add('separator')
        !project.add('toggle',          'Data Access Control...',         '!this.dacControl(')
      endif
    endif

    if(!!admControl.isValid('Initialise Location')) then
      !project.add('separator')
      !project.add('callback',        'Initialise Location',            '!!glbInitialise()')
    endif
  if (!globalProject) then
     !project.add('separator')
     !project.add('callback',      'Locking & Isolation...',         'show !!glbLockIsol')
  else
    !project.add('separator')
    !project.add('toggle',      'Lock',         '!this.lock()', 'Locking')
  endif

    --------------------------- Replicate Menu ---------------------------
    !replicate = !this.newMenu('replicate')

      if(!!admControl.isValid('Replicate Project data')) then
        !replicate.add('callback',    'Project data...',                '!!admReplicate(|PROJECT|)')
        !replicate.add('separator')
      endif

      if(!!admControl.isValid('Replicate Project structure')) then
        !replicate.add('callback',    'Project structure...',           '!!admReplicate(|SYSTEM|)')
      endif

      if(!!admControl.isValid('Replicate Standalone')) then
        !replicate.add('callback',    'Standalone...',                  '!!admReplicate(|STANDALONE|)')
      endif

      if(!!admControl.isValid('Replicate Satellite Structure')) then
        !replicate.add('callback',    'Satellite Structure...',         '!!admReplicate(|SATELLITE|)')
      endif

    --------------------------- Replicate Menu ---------------------------
    !expunge   = !this.newMenu('expunge')

      !expunge.add('callback',        'All Users',                      '!!admExpungeAll()')
      -- Only available for Global Projects
      if (!globalProject) then
        !expunge.add('callback',        'Global Daemon',                '!!glbExpungeDaemon()')
      endif
      !expunge.add('callback',        'User process...',                'show !!admExpunge')
      !expunge.add('separator')
      !expunge.add('callback',        'Claimlist...',                   'show !!admExClaim')

      if(!!admControl.isValid('Expunge Picture Files')) then
        !expunge.add('callback',      'Picture Files',                  '!!glbPurgePict()')
      endif

      if(!!admControl.isValid('Expunge DB files')) then
        !expunge.add('callback',      'Database files',                 '!!glbPurgeDb()')
      endif

  ----------------------------- Data Menu Option -----------------------------
  !data        = !this.newMenu('Data')

    !data.add('menu',                 'Change Management',              'dbChanges')

    ----------------------------- Database Change Menu -----------------------------
    !dbChanges = !this.newMenu('dbChanges')

      !dbChanges.add('callback',      'Merge Changes...',               'show !!admMergeChange')
      !dbChanges.add('callback',      'Backtrack Changes...',           'show !!admBacktrack')

    !data.add('callback',             'Inter-DB Macros...',             'show !!interDbMacro')
    !separator = false
    if(!!admControl.isValid('Extracts')) then
      !data.add('separator')
      !data.add('callback',             'Extract Database Control...',    'show !!admDbList')
      !separator = false
    endif

    -- Database Allocation
    if(!!admControl.isValid('DB Allocation')) then
      !curLoc    = CURLOC
      !locWorld  = /*GL
      !hereIsHub = !curLoc eq !locWorld.hubRf
      if(!hereIsHub) then
        !data.add('separator')
        !separator = true
        !data.add('menu',               'Database Allocation',            'glbAllocate')

        ----------------------------- Allocation Menu -----------------------------
        !glbAllocate = !this.newMenu('glbAllocate')

          !glbAllocate.add('callback',  'By Database...',                 'show !!glbAllDb')
          !glbAllocate.add('callback',  'By Location...',                 'show !!glbAllLoc')
          !glbAllocate.add('callback',  'Update order...',                'show !!glbUpdOrd')

        -- Database Distribution uses same control values as Allocation
        !data.add('callback',           'Database Distribution...',       'show !!glbDbDistribution')

      endif
    endif

    if(!!admControl.isValid('Update')) then
      if(!separator.not()) then
        !data.add('separator')
        !separator = true
      endif
      !data.add('callback',           'Update...',                      'show !!glbUpdateDb')
    endif

    if(!!admControl.isValid('Synchronise Data')) then
      if(!separator.not()) then
        !data.add('separator')
        !separator = true
      endif
      !data.add('callback',           'Synchronise...',                 'show !!glbSynchrDb')
    endif

    -- Data Recover
    if(!!admControl.isValid('Recover')) then
      if(!separator.not()) then
        !data.add('separator')
        !separator = true
      endif
      !data.add('menu',               'Recover',                        'glbRecover')

      ----------------------------- Database Recover Menu -----------------------------
      !glbRecover = !this.newMenu('glbRecover')

      !glbRecover.add('callback',   'Database...',                     'show !!glballDbRec')

        if(!!admControl.isValid('Recover Primary Location')) then
          !this.glbRecover.add('callback','Primary Location...',         'show !!glbPrOwn')
        endif

        !glbRecover.add('callback',    'To Locations...',                'show !!glballDbRec')

        if(!!admControl.isValid('Recover Hub')) then
          !this.glbRecover.add('callback','Hub...',         '!!glbRecoverHub()')
        endif

    endif

  ----------------------------- Global Remote Menu Option -----------------------------
  !glbRemote   = !this.newMenu('glbRemote')

    if(!!admControl.isValid('Remote Merge Changes')) then
      !glbRemote.add('menu',       'Global Change Management',          'rmtDbChanges')

      ----------------------------- Remote Change Management Menu -----------------------------
      !rmtDbChanges = !this.newMenu('rmtDbChanges')

        !rmtDbChanges.add('callback', 'Global Merge Changes...',               'call !!glbRmtShowIfLocn(|!!glbRmtMerge|)')
        !rmtDbChanges.add('callback', 'Remote Backtrack Changes...',           'show !!glbRmtBacktrack')
    endif

    if(!!admControl.isValid('Remote Locking & Isolation')) then
      !glbRemote.add('callback',      'Locking & Isolation...',         'show !!glbLckIsl')
    endif

    if(!!admControl.isValid('Remote Synchronisation')) then
      !glbRemote.add('callback',      'Synchronisation...',             'call !!glbRmtShowIfLocn(|!!glbRmtSync|)')
    endif

   if(!!admControl.isValid('Remote Update')) then
     !glbRemote.add('callback',      'Update...',                      'show !!glbRmtUpdateDb')
   endif

    if(!!admControl.isValid('Remote Recover DB')) then
      !glbRemote.add('callback',      'Recover Database...',            'call !!glbRmtShowIfLocn(|!!glbRmtRec|)')
    endif

    if(!!admControl.isValid('Remote Expunge')) then
      !glbRemote.add('callback',      'Remote Expunge...',              'call !!glbRmtShowIfLocn(|!!glbRmtExpunge|)')
    endif

    if(!!admControl.isValid('Remote Integrity Checker')) then
      !glbRemote.add('callback',      'Integrity Checker...',           'show !!glbrmtAdmDic')
    endif

  ----------------------------- Install Menu Option -----------------------------

    -- Install Menu Option
  if(!!mmsIsThis3dmmProj()) then
    !install          = !this.newMenu('Install')
      !install.add('menu',              'Setup Model Object Management' ,        'setupMms')
  endif

   if(!!mmsIsThis3dmmProj()) then
    !setupMms      = !this.newMenu('setupMms')
      !setupMms.add('callback',      'MOM Build All Components',        '$m "%pmllib%/mms/macros/mmsprojectsetup.pmlmac"')
      !setupMms.add('callback',      'MOM Admin Build',                 '!!mmsAdminBuild()')
      !setupMms.add('callback',      'MOM Uda Build',                   '$m "%pmllib%/mms/macros/mmsudabuild.pmlmac"')
      !setupMms.add('callback',      'MOM Users Build',                 '!!mmsCallUsers()')
   endif

  -- End of Menu Bar

  -- Load databases types
  !!admTypeDbDflt()

  -- Grey out the UDA build if MDB is not defined
  if(!!mmsIsThis3dmmProj()) then
     !session    = CURRENT SESSION
     !isMdbUnset = !session.mdb().unset()
     if(!isMdbUnset) then
        !this.setupMms.setActive('MOM Uda Build',false)
     else
        !this.setupMms.setActive('MOM Uda Build',true)
     endif
  endif
  -- Define adm message form
  pml reload form !!admMess

  -- construct forms for serialisation
  if(defined (!!appCntrl)) then
   !!appCntrl.delete()
  endif
  !!appCntrl = object APPCNTRL()

  !!appFormCntrl.constructForms()

endmethod
-- End of method definition for .adminApplic()

----------------------------------------------------------------------
--
-- Method:      queryList
--
-- Description: Define common query list menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form the menu is to be loaded into
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .queryList(!form is FORM)

    !ntAuth=authentication

  -- If menu is define, then clear it
  if(defined(!form.list)) then
    !list      = !form.list
    !list.clear()

  -- Define list menu
  else
    !list      = !form.newMenu('list')
  endif

  !list.add('callback',  'User Status...',          'show !!userStatus')

  -- Define query NOTE !this.list MUST directly correspond to equivalent in adminElem
  if(!!admControl.isValid('Global')) then

    if(!!admControl.isValid('Centralised Admin')) then
      !list.add('callback',  'Users...',                'show !!glbUserList')
      !list.add('callback',  'NT Authenticated Users...','show !!glbAuthUserList','NTAU')
      if (!ntAuth) then
        !this.list.setFieldProperty('NTAU','visible',true)
      else
        !this.list.setFieldProperty('NTAU','visible',false)
      endif
      !list.add('callback',  'Teams...',                'show !!glbTeamList')
      !list.add('callback',  'DBs...',                  'show !!glbDbList')
      !list.add('callback',  'Database Sessions...',    'show !!glbDbSess')
      !list.add('callback',  'MDBs...',                 'show !!glbMdbList')
      !list.add('callback',  'Stamps...',               'show !!stampList')
      !list.add('callback',  'Locations...',            'show !!glbListLocn')
      !list.add('callback',  'DB Allocation...',        'show !!glbListAlloc')
      !list.add('callback',  'Location Groups...',      'show !!glbListGrp')
      !list.add('callback',  'Update Events...',        'show !!glbCommList')
    else
      !list.add('callback',  'Users...',                'show !!userList')
      !list.add('callback',  'NT Authenticated Users...','show !!authUserList','NTAU')
      if (!ntAuth) then
        !this.list.setFieldProperty('NTAU','visible',true)
      else
        !this.list.setFieldProperty('NTAU','visible',false)
      endif
      !list.add('callback',  'Teams...',                'show !!teamList')
      !list.add('callback',  'DBs...',                  'show !!dbList')
      !list.add('callback',  'Database Sessions...',    'show !!admDbSess')
      !list.add('callback',  'MDBs...',                 'show !!mdbList')
      !list.add('callback',  'Stamps...',               'show !!stampList')
      !list.add('callback',  'Locations...',            'show !!glbListLocn')
      !list.add('callback',  'DB Allocation...',        'show !!glbListAlloc')
      !list.add('callback',  'Location Groups...',      'show !!glbListGrp')
      !list.add('callback',  'Update Events...',        'show !!glbCommList')
    endif

  -- Non-Global project
  else
    !list.add('callback',  'Users...',                'show !!userList')
    !list.add('callback',  'NT Authenticated Users...','show !!authUserList','NTAU')
    if (!ntAuth) then
      !this.list.setFieldProperty('NTAU','visible',true)
    else
      !this.list.setFieldProperty('NTAU','visible',false)
    endif
    !list.add('callback',  'Teams...',                'show !!teamList')
    !list.add('callback',  'DBs...',                  'show !!dbList')
    !list.add('callback',  'Database Sessions...',    'show !!admDbSess')
    !list.add('callback',  'MDBs...',                 'show !!mdbList')
    !list.add('callback',  'Stamps...',               'show !!stampList')
  endif

  -- Data Access Control
  if(!!admControl.isValid('Data Access Control')) then
    !list.add('callback',  'Data Access Control...',  'show !!admDacReport')
  endif

  -- Only available for DB Sets
  if(!!admControl.isValid('Database Sets')) then
    !list.add('callback',  'Database Sets...',        'show !!admQryDbSet')
  endif

  -- Added new options to query Remote FileDetails & Lastsession for all database to a specified location.
  if(!!admControl.isValid('Global')) then
    !list.add('SEPARATOR')
    !list.add('callback',  'Remote Filedetails...',   'show !!glbRmtFileDetail')
    !list.add('callback',  'Remote Last Session...',  'show !!glbRmtLastSession')
  endif

endmethod
-- End of method definition for .queryList(FORM)

------------------------------------------------------------------------
--
-- Method:      .changeAdmLoc()
--
-- Description: Callback function to change Location if user changes gadget
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Location Selected in Gadget(Normally)!
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .changeAdmLoc(!newLoc is DBREF)

  -- Return if the selected location is the same as the current (open sys DB)
  if ( !this.currentAdmLoc EQ !newLoc) then
    return
  endif

  !hubRef = !!dbrGlbHubLocRf()
  !curRef = !!dbrGlbCurLocRf()
  -- Administer new location
  -- determine whether the selected location is this location
  if( !newLoc.prmrf.unset() OR ( !newLoc.prmrf EQ !!dbrGlbCurLocRf() ) ) then
    -- this site is self administering if it is initialised
    !selfAdmin = !newLoc.linit
  else
    -- The hub is always self administering, regardless on initialisation state
    -- checks for selected location being the HUB and this location is the HUB
    -- This was put in because the Hub admin location is unset
    !selfAdmin = ( !newLoc EQ !hubRef ) OR ( !hubRef EQ !curRef )
  endif

  -- set up administration location
  if (!selfAdmin) then
    call !!admCommand('ADMINISTER SYSTEM AT |$!newLoc.locID|')
    handle (44,7)
      !!alert.error(!!error.text & ': You may need to use UPDATE to update the system databases at this location' )
      return
    elsehandle none
      -- Additional code at 11.5.SP1 for Repair functionality
      call !!admRepair(false)
    elsehandle (1,501)
      !!alert.error(!!error.text)
    endhandle
  else
    call !!admCommand('ADMINISTER SYSTEM AT |$!newLoc.locID| READONLY')
    handle (1,501)
      !!alert.error(!!error.text)
    endhandle
  endif
  !this.currentAdmLoc = !newLoc
  -- Resetting Forms ( are there other forms to update ?)
  -- Set the flag on the status menu
  !ntAuthState    = authentication

  if(!ntAuthState) then
    !this.ntAuthStatus.val = 'NT Authentication ON '
    !this.project.setFieldProperty('NTAuth','selected',true)
    !this.list.setFieldProperty('NTAU','visible',true)
  else
    !this.ntAuthStatus.val = 'NT Authentication OFF'
    !this.project.setFieldProperty('NTAuth','selected',false)
    !this.list.setFieldProperty('NTAU','visible',false)
  endif
  !!adminElem.init()
  !this.setMenuState()
endmethod
-- End of method definition for .changeAdmLoc(DBREF)

------------------------------------------------------------------------
--
-- Method:      .getPossLocs()
--
-- Description: Method which works out locations that can be administered
-- at this location and places result in admLocation in Gadget
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .getPossLocs()

  -- initialise Location Gadget

  if(!!admControl.isValid('Centralised Admin')) then
    !this.admLocation.clear()
  endif
  -- Get a list of locations which are initialised
  !resultingLocs = !!collectAllFor('loc','',!!dbrAdminGetWorld('LOC'))

  -- Rebuild list of Locs
  !hereIsHub = !!dbrGlbCurLocRf() EQ !!dbrGlbHubLocRf()
  !this.locList.clear()
  !textOfLocs = ARRAY()
  do !location values !resultingLocs

    -- Get only Locations that this physical Location can administer! + itself(to be opened readonly, if it can't admin itself)
    !locationIsHub  = !location EQ !!dbrGlbHubLocRf()
    !locationIsHere = !location EQ !!dbrGlbCurLocRf()
    -- Only the Hub can administer the Hub. This test identifies whether the current location is the hub
    skip if( !locationIsHub AND !hereIsHub.not() )

    -- add to list if the location is the current location
    if( !locationIsHere ) then
      -- Use insert to ensure Local is always the first Value
      !this.locList.insert(1, !location)
      !textOfLocs.insert(1, 'LOCAL')
      skip
    endif

    -- check for the location being administered here, and that it is initialised
    if( ( !location.linit OR !hereIsHub ) AND ( !location.prmrf EQ !!dbrGlbCurLocRf() ) ) then
      !textOfLocs.append(!location.locID)
      !this.locList.append(!location)
    endif

  enddo

  if(!!admControl.isValid('Centralised Admin')) then
    !this.admLocation.dtext = !textOfLocs
  endif

endmethod
-- End of method definition for .getPossLocs()

------------------------------------------------------------------------
--
-- Method:      .getAdmContext()
--
-- Description: Get the location that is now the context of Administration
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    Dbref       the current Location
------------------------------------------------------------------------
define method .getAdmContext() is DBREF

  if(!!admControl.isValid('Centralised Admin')) then
    return !this.locList[!this.admLocation.val]
  else
    return !this.locList[1]
  endif

endmethod
-- End of method definition for .getAdmContext() DBREF

------------------------------------------------------------------------
--
-- Method:      .setAdmContext()
--
-- Description: Sets Location that is NOW the context of Administration
-- i.e. administer system location <locID> already done
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     DBREF       The Location that is NOW the context of Administration
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .setAdmContext(!loc is DBREF)

  !this.currentAdmLoc = !loc
  if(!!admControl.isValid('Centralised Admin')) then
    -- if location not the one currently displayed
    if (!loc.locID NEQ !this.getAdmContext().locID) then
      if(!loc.locID EQ !!dbrGlbCurLocRf().locID) then
        if(!this.getAdmContext().locID NEQ 'LOCAL') then
          !this.admLocation.val = !this.admLocation.dtext.findFirst('LOCAL')
          handle ANY
             -- commented this out, you can't say that (AK)
             -- Cannot find Location in Gadget - How have you done this!
          endhandle
        endif
      endif
      !this.admLocation.val = !this.admLocation.dtext.findFirst(!loc.locID)
      handle ANY
        -- commented this out, you can't say that (AK)
        -- Cannot find Location in Gadget - How have you done this!
      endhandle
    endif
  endif

endmethod
-- End of method definition for .setAdmContext(DBREF)

------------------------------------------------------------------------
--
-- Method: .setMenuState
--
-- Description: This method may be called at any time a will set the menu state
-- correctly. i.e.:- if this is a location administered elsewhere it will not have
-- all it functionality
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMenuState()
  -- These disabling of functions only applies to the global project
  !global      = !!glbIsGlobal()
  !actualLoc   = !!dbrGlbCurLocRf()
  !adminLoc    = !this.getAdmContext()
  !bar         = !this.bar

  -- CASE 2 (GLOBAL)
  if(!global)then
    -- COMMON GLOBAL

    !bar.setActive('Remote',TRUE)

    -- CASE 2.1 (HUB LOCATION)
    if((!adminLoc EQ !actualLoc) AND (!actualLoc EQ !!dbrGlbHubLocRf()))then
    if(!!mmsIsThis3dmmProj()) then
      !bar.setActive('Install', TRUE)
      !this.setupMms.setActive('MOM Build All Components', TRUE)
      !this.setupMms.setActive('MOM Admin Build', TRUE)
endif
    !this.lock.active = FALSE
      !bar.setActive('Data',TRUE)
      -- Note this overrides the above statement
    -- CASE 2.2 (A SITE ADMINISTERING ANOTHER SITE R/W)
    elseif((!adminLoc NEQ !actualLoc) AND (!adminLoc.prmrf EQ !actualLoc))then
    if(!!mmsIsThis3dmmProj()) then
      !bar.setActive('Install', TRUE)
    !this.setupMms.setActive('MOM Build All Components', FALSE)
    !this.setupMms.setActive('MOM Admin Build', FALSE)
endif
      !bar.setActive('Data',False)
      !this.lock.active = FALSE
    -- CASE 2.3 (A SITE ADMINISTERING ITSELF R/W)
    elseif((!adminLoc EQ !actualLoc) AND ( (!adminLoc.prmrf EQ !actualLoc) OR  ( !adminLoc.prmrf.unset() AND !adminLoc.prmrf.unset() ) ) )then
    if(!!mmsIsThis3dmmProj()) then
      !bar.setActive('Install', TRUE)
      !this.setupMms.setActive('MOM Build All Components', FALSE)
      !this.setupMms.setActive('MOM Admin Build', FALSE)
    endif
      !this.lock.active = FALSE
      !bar.setActive('Data',TRUE)
    -- CASE 2.4 (A SITE WHICH IS ADMINISTERING ITSELF BUT READ-ONLY)
    elseif((!adminLoc EQ !actualLoc) AND ( (!adminLoc.prmrf NEQ !actualLoc) OR !adminLoc.prmrf.unset() ))then
    if(!!mmsIsThis3dmmProj()) then
      !bar.setActive('Install', TRUE)
    !this.setupMms.setActive('MOM Build All Components', FALSE)
    !this.setupMms.setActive('MOM Admin Build', FALSE)
endif
      !this.lock.active = FALSE
      !bar.setActive('Data',False)
    endif

  endif

  -- Note these 4 cases are mutually exclusive!!

endmethod
-- End of method definition for .setMenuState()
------------------------------------------------------------------------
--
--Method: .getWorkRefresh()
--
-- Description: This function forces a getwork and refreshes key forms/gadgets
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getWorkRefresh()
  --get works asking for confirmation beforehand
  !refresh = !!comGetWork()

  -- comGetwork returns a boolean in answer to getwork confirmation
  if (!refresh) then
    -- Updates administering context gadget
    if(!!glbIsGlobal())then
      -- get currently selected location
      !currentLocation = !this.getAdmContext()
      -- update locations in case a new one has arrived
      !this.getPossLocs()
      -- reselect the original location
      !this.setAdmContext(!currentLocation)
    endif
    -- Updates Elements form
    !!adminElem.init()
    -- update data access control status
    !this.dacStatus()
  endif

endmethod
-- End of method definition for .getWorkRefresh()
------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: initialise the form
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise Variables

  -- Initialise the world locations
  call !!dbrAdminSetWorld()

  -- Get current project
  !project              = CURRENT PROJECT
  !code                 = !project.id()

  -- Get the project lock state
  var !projectLock lock
  !this.lock.val = !projectLock
  if (!projectLock.upcase()eq'LOCKED') then
    !this.lock.background = 3
  else
    !this.lock.background = 0
  endif

  -- Isolated
  if(!!admControl.isValid('Global')) then
    !isol               = STRING()
    VAR !isol ISOLATION
    if(!isol.set())then
      !this.isolate.val = !isol.boolean()
      !this.isolate.active = false
    endif

    -- Current location
    !locn               = !!dbrGlbCurLocRf()
    handle ANY
      return
    elsehandle NONE
      !locID            = !locn.locID
    endhandle

    -- Hub or satellite
    !hubOrSatellite = ' (satellite)'
    !hubRef = !!dbrGlbHubLocRf()
    handle any
      !hubRef = object DBREF()
    endhandle
    if (!hubRef.set()) then
      if (!locn eq !hubRef) then
        !hubOrSatellite = ' (hub)'
      endif
    else
      !prevHub = !locn.refno.owner.owner.prvrf
      if (!prevHub.set()) then
        if (!locn eq !prevHub) then
          !hubOrSatellite = ' (old hub)'
        endif
      endif
    endif

    !this.pInfo.val     = 'Project ' & !code & ' at ' & !locID & !hubOrSatellite
    !this.getPossLocs()

    -- Set Currently administered Loc to Local (cos it is at this stage)
    !this.setAdmContext(!!dbrGlbCurLocRf())
    !this.setMenuState()

  else
    !this.pInfo.val     = 'Project ' & !code

  endif

  -- Display DAC Status
  !this.dacStatus()

  -- Display Project type
  VAR !projectType PROJECT TYPE
  !this.projType.val = !projectType

  -- Display the NT Authentication State
  !ntAuth=authentication
  if (!ntAuth) then
    !this.ntAuthStatus.val='NT Authentication ON'
    !this.project.setFieldProperty('NTAuth','selected',true)
  else
    !this.ntAuthStatus.val='NT Authentication OFF'
    !this.project.setFieldProperty('NTAuth','selected',false)
  endif

  -- Display Link Document State
  if (!!glbIsGlobal() ) then
    !this.setLinkDocumentUIState()
  endif

  -- Display the locking state
  if (!!glbIsGlobal().not()) then
    if (!projectLock.upcase() eq 'LOCKED') then
      !this.project.setFieldProperty('Locking','selected',TRUE)
    else
      !this.project.setFieldProperty('Locking','selected',FALSE)
    endif
  endif

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
--Method: .dacStatus()
--
-- Description: Updates display of Data Access Control status on/off
--    BEWARE: This method is called externally
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dacStatus()

  -- Check for if DAC is valid
  if(!!admControl.isValid('Data Access Control')) then

    !dacSetting = !!dbrAdminGetWorld('ROLE').lacr

    if(!dacSetting) then
      !this.dacStatus.val = 'DAC ON '
    else
      !this.dacStatus.val = 'DAC OFF'
    endif
    if(!!glbHubStatus(!!admControl.isGlobal())) then
      !this.project.select('Data Access Control...', !dacSetting)
    endif
  endif

endmethod
-- End of method definition for .dacStatus()
------------------------------------------------------------------------
--
--Method: .dacControl()
--
-- Description: Callback to control Data Access Control status (on/off)
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dacControl(!menu is MENU, !dummySelect is STRING)

  -- Get the state of DATA ACCESS CONTROL
  !dacState    = !menu.selected(!menu.pickedField)
  if( !dacState ) then
    !dacSwitch = 'ON'
  else
    !dacSwitch = 'OFF'
  endif
  !answer = !!alert.confirm(|Are you sure you wish to switch DAC | + !dacSwitch + | project-wide|)
  if(!answer.boolean().not())then
    -- The user said No - toggle state back
    !menu.select(!menu.pickedField, !dacState.not())
    return
  endif
  !prevPos = !!ce
  -- ACR LACR attribute now stored under ROLE world
  !!ce = !!dbrAdminGetWorld(|ROLE|)
  LACR $!dacState
  handle any
    -- ACR LACR attribute now stored under ROLE world (since 28-Jan-2000)
    !!alert.error('You may need to update your project. The ACR switch is now stored with roles')
  endhandle
  -- update display on the main menu bar
  if(!dacState) then
    !this.dacStatus.val = 'DAC ON '
  else
    !this.dacStatus.val = 'DAC OFF'
  endif
  !menu.select(!menu.pickedField, !dacState)
  !!ce = !prevPos

endmethod
-- End of method definition for .dacControl(MENU, STRING)
------------------------------------------------------------------------
--
--Method: .ntAuth()
--
-- Description: Callback to control NT Authentication status (on/off)
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ntAuth()

  -- Get the state of NT Authentication
  !ntAuthState    = authentication
  if( !ntAuthState ) then
    !ntAuthSwitch = 'OFF'
  else
    !ntAuthSwitch = 'ON'
  endif
  !answer = !!alert.confirm(|Are you sure you wish to switch NT Authentication | + !ntAuthSwitch + | project-wide|)
  -- update display on the main menu bar and change the NT Authentication
  if (!answer.boolean() and !ntAuthSwitch eq 'ON') then
    AUTHENTICATION ON
  elseif (!answer.boolean() and !ntAuthSwitch eq 'OFF') then
    AUTHENTICATION OFF
  endif
  -- Set the flag on the status menu
  !ntAuthState    = authentication

  if(!ntAuthState) then
    !this.ntAuthStatus.val = 'NT Authentication ON '
    !this.project.setFieldProperty('NTAuth','selected',true)
    !this.list.setFieldProperty('NTAU','visible',true)
  else
   !this.ntAuthStatus.val = 'NT Authentication OFF'
    !this.project.setFieldProperty('NTAuth','selected',false)
    !this.list.setFieldProperty('NTAU','visible',false)
  endif
  -- reset the adminElem form
  if (!!adminElem.shown()) then
    kill !!adminElem
    show !!adminElem
  else
    kill !!adminElem
    pml load form !!adminElem
  endif
endmethod
-- End of method definition for .ntAuth()

------------------------------------------------------------------------
--
--Method: .propagateLinkDocuments()
--
-- Description: Callback to control Propagate Link Documents status (on/off)
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .propagateLinkDocuments()

  !glocwl = object DBREF('/*GL')
  !linkDocumentsState    = !glocwl.gLinkPropagation

  if( !linkDocumentsState ) then
    !linkDocumentsSwitch = 'OFF'
  else
    !linkDocumentsSwitch = 'ON'
  endif

  -- Modifications only allowed at the Project Hub
    if (!this.isGlobalHub()) then
      !answer = !!alert.confirm('Are you sure you wish to set Propagate Link Documents to ' + !linkDocumentsSwitch + ' project-wide?')

      if (!answer.boolean()) then

        -- Update the Propagate Link Documents setting
        if (!linkDocumentsState) then
          !glocwl.gLinkPropagation = false
        else
          !glocwl.gLinkPropagation = true
        endif

      endif
    else
      !!alert.warning('Propagation of Linked Documents cannot be modified at a satellite')
    endif

    -- Update the status
      !this.setLinkDocumentUIState()
endmethod
-- End of method definition for .propagateLinkDocuments()

------------------------------------------------------------------------
--
--Method: .setLinkDocumentUIState()
--
-- Description: Set the state of the Propagate Link Document flag on the UI
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setLinkDocumentUIState()

  !glocwl = object DBREF('/*GL')
  !linkDocumentsState    = !glocwl.gLinkPropagation

  -- Set Link Document State on the Menu & Status Menu
  if (!linkDocumentsState) then
    !this.propagateLinkDocumentsStatus.val = 'Link Documents ON '
    !this.project.setFieldProperty('LinkDocuments','selected',true)
  else
    !this.propagateLinkDocumentsStatus.val = 'Link Documents OFF'
    !this.project.setFieldProperty('LinkDocuments','selected',false)
  endif
  if( !this.isGlobalHub().not() ) then
    !this.project.setFieldProperty('LinkDocuments','active',false)
  endif

endmethod

------------------------------------------------------------------------
--
--Method: .marEnvSetup()
--
-- Description: Callback to display the Marine environment setup form
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .marEnvSetup()

  import 'marenvsetup'
  handle(1000,0)
  endhandle
  using namespace 'Aveva.Marine.Environment.ProjectSetup'
  !aa = object PMLENTRY()
  !aa.showForm()

endmethod
-- End of method definition for .marEnvSetup()
------------------------------------------------------------------------
--
--Method: .lock()
--
-- Description: Callback to set the locking
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .lock()

  var !projectLock lock
  -- Check the lock flag against the project
  if (!projectLock.upcase() eq 'LOCKED') then
    -- Unlock the project
    UNLOCK
    !this.project.setFieldProperty('Locking','selected',FALSE)
    !this.lock.val = 'Unlocked'
    !this.lock.background = 0
  else
    -- Lock the project
    LOCK
    !this.project.setFieldProperty('Locking','selected',TRUE)
    !this.lock.val = 'Locked'
    !this.lock.background = 3
  endif

endmethod
-- End of method definition for .lock()

------------------------------------------------------------------------
--
--Method: .isGlobalHub()
--
-- Description: If the project is Global then this method will determine
-- whether the current project is a Hub
--
-- method Type:   function
--
------------------------------------------------------------------------

define method .isGlobalHub() is BOOLEAN

	!isHubLocation = false
	
	!globalProject = !!admControl.isValid('Global')
	if (!globalProject) then
	   !isHubLocation  = !!glbHubStatus(!globalProject)
	endif
	
	return !isHubLocation
	
endmethod
