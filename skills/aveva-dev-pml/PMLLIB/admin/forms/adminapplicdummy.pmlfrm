-- Description:
-- Admin Application bar menu definition file.
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adminApplicDummy()               -
--

-- Define form
setup form !!adminApplicDummy at xr 0 yr 0 main size 95 0

  !this.formTitle     = 'Admin - AVEVA PDMS'
  !this.iconTitle     = 'Admin - AVEVA PDMS'
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition

  -- Top level menu
  bar
  exit

  -- Relative positioning
  valign centre
  path   right
  hdist  2

  -- Project information
  para .pInfo at x0 y0 text 'Dummy Main Bar' width 20


exit
-- End of form definition for !!adminApplicDummy

----------------------------------------------------------------------
--
-- Method:      adminApplic
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .adminApplicDummy()

  -- Initialise Variables
  -- For Marine Header
  var !marine evar  'AVEVA_MARINE'
  if(!marine.upcase().eq('YES')) then
    !this.formTitle = 'Admin - AVEVA MARINE'
  else
    !this.formTitle = 'Admin - AVEVA PDMS'
  endif

  -- Define Main Bar Menu
  !bar      = !this.bar
    !bar.add('Control',     'control')

  !control     = !this.newMenu('control')
    !control.add('callback',  'Command Window...',        'show !!cadcBth free')

endmethod
-- End of method definition for .adminApplicDummy()
