-- File:            adminelem.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Tue May 6 08:59:05 BST 1997
--
-- Description:
-- Administration elements form. Acts as restricted members list
-- for "feel" of other modules.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  acrChoose(STRING)                -                   An acr to choose whether to create an acr or an Acr group
--  acrGet()                         DBREF
--  acrSet(DBREF)                    -                   set the current acr in the Admin element form
--  acrSetButtons()                  -                   Sets active state of ACR function buttons
--  adminElem()                      -                   Constructor
--  authUserSetButtons()             -                   Sets active state of Authenticated USER function buttons
--  daemonGlbStat(STRING)            -                   Alert to check the communication then show the relevant form.
--  dbChoose()                       -                   An form to choose whether to create a db or an extract
--  dbGet()                          DBREF
--  dbSet(DBREF)                     -                   set the current DB in the Admin element form
--  dbSetButtons()                   -                   Sets active state of DB function buttons
--  dbSetGet()                       DBREF
--  dbSetSet(DBREF)                  -                   set the current SET in the Admin element form
--  dbSetSetButtons()                -                   Sets active state of DBSET function buttons
--  deleteCurr()                     -                   delete an element of the four basic object groups
--  depend()                         -                   update the forms that depend on the list position of
--  filt()                           -                   take the user input filter and remember the value
--  goto(STRING)                     -                   method navigate user to named element (more or less).
--  greyButtons()                    -                   Sets active state of TEAM function buttons
--  grpGet()                         DBREF               return the current selected GRP from the Admin
--  grpSet(DBREF)                    -                   set the current GRP in the Admin element form
--  grpSetButtons()                  -                   Sets active state of GROUP function buttons
--  init()                           -                   initialise the Admin elements form. Controls
--  isHub()                          BOOLEAN             returns true if this is the hub
--  lComGet()                        DBREF               return the current selected LCOMD from the Admin
--  lComSet(DBREF)                   -                   set the current LCOMD in the Admin element form
--  lcomdSetButtons()                -                   Sets active state of LCOMD function buttons
--  locGet()                         DBREF               return the current selected LOC from the Admin
--  locSet(DBREF)                    -                   set the current LOC in the Admin element form
--  locSetButtons()                  -                   Sets active state of LOCATION function buttons
--  mdbGet()                         DBREF               return the current selected MDB from the Admin
--  mdbSet(DBREF)                    -                   set the current Mdb in the Admin element form
--  mdbSetButtons()                  -                   Sets active state of MDB function buttons
--  queryCe()                        -                   Will query the current element.
--  refresh()                        -                   refresh the list of Admin elements after a
--  roleGet()                        DBREF               return the current selected ROLE from the Admin
--  roleSet(DBREF)                   -                   set the current ROLE in the Admin element form
--  roleSetButtons()                 -                   Sets active state of ROLE function buttons
--  scopeGet()                       DBREF               return the current selected SCOPE from the Admin
--  scopeSet(DBREF)                  -                   set the current SCOPE in the Admin element form
--  scopeSetButtons()                -                   Sets active state of SCOPE function buttons
--  sel(STRING)                      -                   navigate the user to the current selected element.
--  selRef(DBREF)                    -                   select a specific DBREF from the current displayed
--  setHeader()                      -
--  sort()                           -                   take the user input sort and remember the value
--  stampCopy()                      -                   Call the stamp copy form
--  stampGet()                       DBREF               Return the current selected STAMP from the Admin
--  stampSet(DBREF)                  -                   Set the current STAMP in the Admin element form
--  stampSetButtons()                -                   Sets active state of STAMP function buttons
--  teamGet()                        DBREF               return the current selected TEAM from the Admin
--  teamSet(DBREF)                   -                   set the current TEAM in the Admin element form
--  teamSetButtons()                 -                   Sets active state of TEAM function buttons
--  type()                           -                   set up the adminElem form depending on the selected
--  update(STRING)                   -                   reconstruct the list from the database. This method
--  userGet()                        DBREF               return the current selected USER from the Admin
--  userSet(DBREF)                   -                   set the current USER in the Admin element form
--  userSetButtons()                 -                   Sets active state of USER function buttons
--  which()                          -                   Works out which arguments to send to form glbCopyElem2Locs.
--  workSetButtons()                 -                   Sets active state of WORKING EXTRACT function buttons
--
------------------------------------------------------------------------
-- Define form
setup form !!adminElem at xr 0 yr 0 document NoAlign

  !this.formTitle     = 'Admin elements'
  !this.iconTitle     = 'ADM ELEM'
  !this.callback      = '!this.init()'
  !!adminElem.formRevision  = ' $Revision: 1.67 $ '
  -- Body of form definition
  -- Menu Bar
  --  bar
  --    add |Control|        .control
  --  exit

  -- element list Frame
  frame .elemFrame   at x 0 y 0      anchor all   |Admin elements|

    option .type     at xmin+1 ymin+1   anchor top+left+right tagwidth 7 |Elements|   callback |!this.update(!this.type.selection('rText'))| width 26

    button .update   at xmax+2 ymin     anchor top+right |Refresh List|    callback |!this.update(!this.type.selection('rText'))| width 12

    button .prev     at xmin.type+1.4 ymax+0.5  anchor top+left pixmap width 9 height 12 callback |!this.sel('PREV')|

    text   .navigate at xmax   ymin       anchor top+right+left       callback |!this.goto(!this.navigate.val)| width 46 NAME

    button .next     at xmax   ymin      anchor top+right      pixmap width 9 height 12 callback |!this.sel('NEXT')|

    list   .element  at xmin.prev ymax+0.2       anchor all       callback |!this.sel('SELECT')| width 48 height 20

-- Add do-it button for sort, rather than option gadget callback to prevent blocking of other apps, for big lists (P-1951 rcfl 25/07/09)
    path down
    button .doit   |Sort| at xmin.element   anchor l+b  callback |!this.sort()|  width 9
    path right
    option .sort   tagwid  3 |by|           anchor l+r+b                         width 10
    text   .filter tagwid  9 |using filter| anchor b+r  callback |!this.filt()|  width 12 STRING

  exit

  button .create   at xmin+3  ymax+0.4 anchor left+bottom  |Create...|
  button .copy     at xmax+1  ymin     anchor left+bottom  | Copy... |
  button .modify   at xmax+1  ymin     anchor left+bottom  |Modify...|
  button .delete   at xmax+1  ymin     anchor left+bottom  | Delete |        callback |!this.deleteCurr()|

  if(!!admControl.isValid('Copy to Location'))then
    button .copy2  at x 0       ymax+0.2 anchor left+bottom |  Copy element to location...  | callback |show !!glbCopyElem2Locs free|
  endif

  button .inclDb   at x 0       ymax+0.2 anchor left+bottom |  Include...  |  callback |show !!admDbIncl free|
  button .forDb    at xmax+1    ymin     anchor left+bottom |Copy Foreign...| callback |show !!admDbFor free|
  button .exclude  at xmax+1    ymin     anchor left+bottom |  Exclude...  |  callback |show !!excludeDb free|
  button .scriptGen at xmax+1   ymin     anchor left+bottom |Create Script..| callback |show !!admScriptGenerate free|

  -- Member definitions
  -- Collection of DBREFS of element Type
  member .elements      is ARRAY
  member .acrRefs       is ARRAY
  member .teamRefs      is ARRAY
  member .userRefs      is ARRAY
  member .authUserRefs  is ARRAY
  member .dbRefs        is ARRAY
  member .mdbRefs       is ARRAY
  member .scopeRefs     is ARRAY
  member .roleRefs      is ARRAY
  member .dbSetRefs     is ARRAY
  member .extractsRefs  is ARRAY
  member .stampRefs     is ARRAY
  member .authUsers     is ARRAY

  if(!!admControl.isValid('Global')) then
    member .locRefs     is ARRAY
    member .grpRefs     is ARRAY
    member .lComdRefs   is ARRAY
  endif

  -- DBREF attribute to remember the current hierarchy locations
  member .acr           is DBREF
  member .team          is DBREF
  member .user          is DBREF
  member .db            is DBREF
  member .mdb           is DBREF
  member .scope         is DBREF
  member .role          is DBREF
  member .dbSet         is DBREF
  member .extracts      is DBREF
  member .stamp         is DBREF

  if(!!admControl.isValid('Global')) then
    member .loc         is DBREF
    member .grp         is DBREF
    member .lcomd       is DBREF
  endif

  -- STRING attribute to remember old filter values
  member .acrFilter     is STRING
  member .teamFilter    is STRING
  member .userFilter    is STRING
  member .dbFilter      is STRING
  member .mdbFilter     is STRING
  member .scopeFilter   is STRING
  member .roleFilter    is STRING
  member .dbSetFilter   is STRING
  member .extractsFilter is STRING
  member .stampFilter   is STRING
  member .authUserFilter is STRING

  if(!!admControl.isValid('Global')) then
    member .locFilter   is STRING
    member .grpFilter   is STRING
    member .lcomdFilter is STRING
  endif

  -- STRING attribute to remember old sort values
  member .acrSort       is STRING
  member .teamSort      is STRING
  member .userSort      is STRING
  member .dbSort        is STRING
  member .mdbSort       is STRING
  member .scopeSort     is STRING
  member .roleSort      is STRING
  member .dbSetSort     is STRING
  member .extractsSort  is STRING
  member .stampSort     is STRING
  member .authUserSort  is STRING

  if(!!admControl.isValid('Global')) then
    member .locSort     is STRING
    member .grpSort     is STRING
    member .lcomdSort   is STRING
  endif

  member .prevType is STRING

exit
-- End of form definition for !!adminElem

----------------------------------------------------------------------
--
-- Method:      adminElem
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .adminElem()

  -- Initialise Variables
  !this.maximised = true

  !globalProject  = !!admControl.isValid('Global')
  !dacAvailable   = !!admControl.isValid('Data Access Control')

  -- Control Menu
  !control       = !this.newMenu('control')
  !control.add(|callback|, |Close|, |!this.hide()|)

  -- List Menu (same as main application Project>Query)
  !!adminApplic.queryList(!this)

  -- Query popup menu
  !popupMenu     = !this.newMenu('popupMenu')

  !popupMenu.add(|callback|,|Query Current element|, |!this.queryCe()|)
  !popupMenu.add(|menu|,    |Query|,                 |list|)

  -- Set pop-up menu
  !this.element.setPopup(!this.popupMenu)

  -- Set pixmaps
  !this.prev.addPixmap(!!pml.getPathName('leftarrow9x12.png'))
  !this.next.addPixmap(!!pml.getPathName('rightarrow9x12.png'))

  -- Set the initial filter values
  !this.acrFilter      = |*|
  !this.teamFilter     = |*|
  !this.userFilter     = |*|
  !this.dbFilter       = |*|
  !this.mdbFilter      = |*|
  !this.scopeFilter    = |*|
  !this.roleFilter     = |*|
  !this.dbSetFilter    = |*|
  !this.extractsFilter = |*|
  !this.stampFilter = |*|
  !this.authUserFilter = |*|

  if(!globalProject) then
    !this.locFilter    = |*|
    !this.grpFilter    = |*|
    !this.lcomdFilter  = |*|
  endif

  -- Set the initial sort values
  !this.acrSort        = |Name|
  !this.teamSort       = |Name|
  !this.userSort       = |Name|
  !this.dbSort         = |Name|
  !this.mdbSort        = |Name|
  !this.scopeSort      = |Name|
  !this.roleSort       = |Name|
  !this.dbSetSort      = |Name|
  !this.extractsSort   = |Name|
  !this.stampSort      = |Name|
  !this.authUserSort   = |Name|

  if(!globalProject) then
    !this.locSort      = |Name|
    !this.grpSort      = |Name|
    !this.lcomdSort    = |Name|
  endif

  !heading[1] = 'Element Name'
  !heading[2] = 'Description'
  !this.element.setHeadings(!heading)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .acrGet()
--
-- Description:
-- return the current selected acr from the Admin
-- elements form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    acrRef       acrRef of current database
--
------------------------------------------------------------------------
-- Define method
define method .acrGet() is DBREF
  -- Return the value
  return !this.acr
endmethod
-- End of method definition for .acrGet() DBREF
------------------------------------------------------------------------
--
-- Method:      .acrSet()
--
-- Description: set the current acr in the Admin element form
-- value.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      acrRef       acrRef of acr element (may be UNSET)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .acrSet(!acrRef is DBREF)
  -- Check parameters are met
  if (!acrRef.unset() or !acrRef.type eq 'ACR' or !acrRef.type eq 'ACRST') then
    -- Set the value
    !this.acr    = !acrRef
  endif
endmethod
-- End of method definition for .acrSet(DBREF)
