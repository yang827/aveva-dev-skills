------------------------------------------------------------------------
--
--Method: .dbSetButtons()
--
-- Description: Sets active state of DB function buttons
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dbSetButtons()

  -- if list not populated, do not allow modify, copy etc.
  if(!this.isHub()) then

    !populatedList = !this.element.dText.empty().not()
    !this.create.active    = true
    !this.create.callback  = |!this.dbChoose()|
    !this.copy.active      = !populatedList
    !this.copy.callback    = |show !!admDbCpy free|
    !this.copy.active      = BADREF(!this.element.selection().dbref().extOwn )
    handle any
      !this.copy.active    = false
    endhandle
    !this.modify.active    = !populatedList
    !this.modify.callback  = |!!admDb.display('MODIFY')|
    !this.delete.active    = !populatedList
    !this.forDb.active     = true
    !this.inclDb.active    = true
    !this.exclude.active   = !populatedList
    !this.scriptGen.active = false

  else
  -- Effective only for satellites
    if(!!admControl.isValid('Global') and !!dbrGlbCurLocRf().noextc) then
      !this.create.active = false
    else
      !this.create.active = !!admControl.isValid('Extracts')
    endif

    !this.create.callback  = |!!admExtract.display('CREATE',!this.element.selection('rText'))|
    !this.copy.active      = false
    !this.copy.callback    = ||
    !this.modify.active    = false
    !this.modify.callback  = ||
    !this.delete.active    = false
    !this.forDb.active     = false
    !this.inclDb.active    = false
    !this.exclude.active   = false
    !this.scriptGen.active = false
  endif

  if (!!admControl.isValid('Copy to Location')) then
    !this.copy2.active = false
  endif

endmethod
-- End of method definition for .dbSetButtons()

