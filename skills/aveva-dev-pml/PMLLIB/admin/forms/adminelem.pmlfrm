------------------------------------------------------------------------
--
-- Method:      .deleteCurr()
--
-- Description: delete an element of the five basic object groups
-- TEAM USER DB MDB STAMP. This acts as a general callback to the adminElem
-- form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .deleteCurr()

  -- For NTUSER only which are not DBREFs
  !type       = !this.type.selection('rText')
  if (!type eq 'NTUSER') then
    !authUser=!!adminElem.element.selection()
    !answer=!!alert.confirm('OK to delete Authenticated User $!authUser')
    if (!answer.boolean()) then
      AUTHUSERREMOVE '$!authUser'
    endif
  else
    -- Get the Dbref data
    !globalProj = !!admControl.isValid('Global')
    !element    = !this.element.selection('rText').dbref()
    handle any
    !r        = |/*| + !this.element.selection('rText')
    !element  = !r.dbref()
    handle any
      !!alert.error('Element ' + !this.element.selection('rText') + ' not found - update the list using the Refresh List button')
      return
    endhandle
  endhandle
  !type       = !this.type.selection('rText')
  -- (AK) for working extracts
  if(!type.eq('WORK EXT')) then
    !newType  = 'DB'
  else
    !newType  = !type
  endif

  if (!element.unset()) then
     return
  endif
  -- Check for element being already claimed
  if (not !!dbRefUpdate (!element)) then
     !!alert.error (!!error.text)
     return
  endif
  -- Check the Dbref type matches the selected element type
  -- caters for ACRs and ACRSTs co-existing
  if (!element.type neq !newType AND NOT (!element.type EQ |ACRST|) ) then
    -- Internal error
    !!messageFile.error(141, 7, !element.type, !type)
    handle (06, 007)
    -- Dummy handle
    endhandle
    -- Rebuild the list
   !this.update(!newType)
  endif

  -- Database require a special deletion case
  if (!element.type eq 'DB') then
    -- Get the DB name
    !db            = | DB |
    !user          = ||
    !elementName   = !element.name.substring(3)
    !dbName        = !elementName
    -- For a working extract - dbName is the name of the owning DB
    -- working extracts (AK)
    if(!element.owner.owner.type.eq('USER')) then
      !dbName      = !element.name.substring(3).substring(-8)
      !elementName = !element.name.substring(3)
      !username    = !element.owner.owner.name.substring(2)
      !user        = |FOR  | + |'| + !username + |' |
      !db          = | WORK EXT FROM |
    endif
    -- Check that DB is local to this project
    if (!element.foreign neq 'LOCAL') then
      -- Foreign database use EXCLUDE DB
      !!messageFile.error(141, 169, !elementName)
    endif
    -- Check for database allocation in a global project
    if (!globalProj) then
      -- Check the database allocation
      !hubRef          = !!dbrGlbHubLocRf()
      !project         = CURRENT PROJECT
      !locations       = !project.locations()
      do !loc values !locations
        !locRef = !loc.refno.dbref()
        skip if (!locRef eq !hubRef)
        if (!locRef.dbAll.findFirst(!element).set()) then
          -- Database is still allocated
          !!messageFile.error(141, 546, !elementName)
        endif
      enddo
    endif
    -- test for DB that has extracts
    !extractCount = !element.extcls.size()
    if(!extractCount gt 0) then
      !!alert.error('This DB cannot be deleted because it has ' + !extractCount.string() + ' extracts')
      return
    endif
    -- Get user to confirm deletion
    if( !db.trim() eq 'DB' ) then
      -- Database

      -- Check extract claim list
      var !extractClaim CLAIMLIST EXTRACT $!elementName
      -- Handled error, Because it should not stop the Deletion process.
      handle(43,429)
        !confirmAlert = !!alert.confirm('$!!error.text - Do you wish to continue')
        if(!confirmAlert.boolean().not()) then
            -- User said NO
            return
        else
          !answer = !!alert.confirm(!!messageFile.messageString(141, 170, !elementName))
        endif
      elsehandle NONE
      if (!extractClaim.match('/').gt(0) or !extractClaim.match('=').gt(0)) then
        -- This database has elements claimed from it
        !answer = !!alert.confirm('Warning! ' & !elementName & ' has extract claimed elements. ' & !!messageFile.messageString(141, 170, !elementName))
      else
        !answer = !!alert.confirm(!!messageFile.messageString(141, 170, !elementName))
      endif
      endhandle
    else
      -- Working extract

      -- Check working extract claim list
      var !extractClaim CLAIMLIST EXTRACT $!elementName
      if (!extractClaim.match('/').gt(0) or !extractClaim.match('=').gt(0)) then
        -- This database has elements claimed from it
        !message = !elementName + ' [ Working extract from ' + !dbName + ' ' + !user + ']'
        !answer = !!alert.confirm('Warning! ' & !elementName & ' has extract claimed elements. ' & !!messageFile.messageString(141, 170, !message))
      else
        !message = !elementName + ' [ Working extract from ' + !dbName + ' ' + !user + ']'
        !answer = !!alert.confirm(!!messageFile.messageString(141, 170, !message))
      endif
    endif
    if (!answer.boolean().not()) then
      -- User said NO
      return
    endif
    -- Delete the database

    !deleteCommand = |DELETE | & !db & | | & !dbName & | | & !user
    call !!admCommand(!deleteCommand)
    handle(2,857)
      -- error is extracts existing below db trying to delete (AK)
      !!alert.error('Cannot delete DB '  + !elementName  + ' since it owns extracts')
      return
    elsehandle(43,41)
      -- file does not exist for this DB, but element does get deleted
    elsehandle (1,650)
      !!alert.error('The folder structure of this project requires an upgrade before a PADD-type database is deleted. Consult your system manager!')
    elsehandle any
      -- Error occurred deleting database
      !!messageFile.error(141, 171, !!error.text)
    endhandle
    -- Move back to world
    /*

  elseif (!element.type eq 'LOC') then
    !!alert.message('Action will take time if Daemon at Hub is not running, check the communication status.')
    -----
    -- Special checks ans deletion for Locations
    -----
    -- Initialise variables
    !elementName   = !element.name
    !elementID     = !element.locid
    !hubRef        = !!dbrGlbHubLocRf()
    !children      = ARRAY()
    !!ce           = !element
    !clause        = 'TYPE eq |DB|'
    !allocation    = !element.mem[1].mem
    !!dbrLocOffspring(!element, !children)
    -- Check that this location is not the hub
    if (!element eq !hubRef) then
      -- Cannot delete the hub
      !!messageFile.error(141, 539, !element.locid)
    endif
    -- Check this location has no descendants
    if (!children.set()) then
      -- Cannot delete location whilst it has children
      !!messageFile.error(141, 540, !element.locid, !children.size().string())
    endif
    -- Check all databases are deallocated
    if (!allocation.set()) then
      -- Cannot delete location whilst it still had
      -- allocated databases
      -- However, the transaction db can still be allocated and deletion will still be allowed
      !transactionDbName = '/*TRANSACTION/' & !elementID
      if (!allocation.size() eq 1 and !allocation[1].name eq !transactionDbName) then
        -- That is OK
      else
        !!messageFile.error(141, 541, !element.locid,  !allocation.size().string())
      endif
    endif
    -- Get user to confirm deletion
    !answer = !!alert.confirm(!!messageFile.messageString(141, 542, !element.locid))
    if (!answer.boolean().not()) then
      -- User said NO
      return
    endif
    -- Delete the database ( This also changes the allocation of the transaction db to primary at the hub )
    !deleteCommand = |DELETE LOCATION |& !elementName
    call !!admCommand(!deleteCommand)
    handle(1,584)
      -- Warning: file --- must be delete manually from offline satellites (if any)
      !!alert.warning(!!error.text)
    elsehandle any
      -- Error occurred deleting database
      !!messageFile.error(141, 543, !elementName, !!error.text)
    elsehandle NONE
      -- Try to delete the transaction database also (must be deallocated at this stage)
      !deleteTransaction = |DELETE DB TRANSACTION/| & !elementID
      call !!admCommand(!deleteTransaction)
      handle ANY
        -- !!alert.error('Unable to delete transaction dB because ' & !!error.text)
      endhandle
    endhandle

  elseif (!element.type eq 'GRP' or !element.type eq 'LCOMD' or !element.type eq 'DBSET' or !element.type eq 'ACR' or !element.type eq 'ACRST') then
    !elementName   = !element.name
    if (!element.type eq 'GRP') then
      !outputType = 'Group'
    elseif(!element.type eq 'DBSET') then
      !outputType = 'Database Set'
    elseif(!element.type eq 'ACRST') then
      !outputType = 'ACR group'
    elseif(!element.type eq 'DBSET') then
      !outputType = 'ACR'
    else
      !outputType = 'Update'
    endif
    -- Get user to confirm deletion
    !answer = !!alert.confirm(!!messageFile.messageString(141, 8, !outputType, !elementName))
    if (!answer.boolean().not()) then
      -- User said NO
      return
    endif
    -- Delete the element
    !!ce           = !element
    !deleteCommand = |DELETE |& !element.type
    call !!admCommand(!deleteCommand)
    handle any
      -- Error occurred deleting database
      !!messageFile.error(141, 9, !element.type, !elementName, !!error.text)
    endhandle

  else

    -- Delete elements (TEAM USER MDB SCOPE ROLE)
    -- Get the element name
    if (!element.type eq 'TEAM') then
      !elementName   = !element.name.substring(3)
    elseif (!element.type eq 'USER')then
      !elementName   = !element.name.substring(2)
      -- The user could be associated with NT users in which case do not allow delete
      !find = object COLLECTION()
      !find.type('ULOGID')
      !loginIds = !find.results()
      !usrli = !loginIds.evaluate(object BLOCK('!loginIds[!evalIndex].usrli'))
      do !list values !usrli
        if (!list.findFirst(!element).set()) then
          !authentication=authentication
          if (!authentication) then
            !!alert.error('The user $!elementName has authenticated users and can not be deleted. Please remove the user from the authenticated user or delete the authenticated user first')
          else
            !!alert.error('Although you do not have NT authentication switched on, the user $!elementName has authenticated users and can not be deleted. Please remove the user from the authenticated user or delete the authenticated user first. You will need to switch NT authentication on to do this')
          endif
          return
        endif
      enddo
    -- ROLE or SCOPE or MDB
    else
      !elementName   = !element.name
    endif
    -- Get user to confirm deletion
    !answer = !!alert.confirm(!!messageFile.messageString(141, 8, !element.type, !elementName))
    if (!answer.boolean().not()) then
      -- User said NO
      return
    endif
    -- Delete the element
    !prev = !!ce
    if((!element.type EQ |SCOPE|) OR (!element.type EQ |ROLE|) OR (!element.type EQ |USER|) OR (!element.type.eq('STAMP')))then
      !!ce  = !element
      !deleteCommand = |DELETE | + !element.type
    else
      !deleteCommand = |DELETE | + !element.type + | | + !elementName
    endif
    call !!admCommand(!deleteCommand)
    handle (1,12)
      -- Team still owns databases
      -- Display list of DBs which are team members
      !this.dbFilter  = !elementName &|*|
      !this.type.select('rText','DB')
      !this.type()

      -- Raise error
      !!messageFile.error(141, 59, !elementName)
    elsehandle any
      -- Raise error
      !!messageFile.error(141, 9, !element.type, !elementName, !!error.text)
    endhandle
    !!ce  = !prev
    handle any
    endhandle

    endif
  endif
  -- To get this far deletion must have succeeded
  !this.update(!type)

endmethod
-- End of method definition for .deleteCurr()
------------------------------------------------------------------------
--
-- Method:      .depend()
--
-- Description: update the forms that depend on the list position of
-- the adminElem form. These are generally forms associated with
-- creation and modification of elements.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .depend()
  -- This is an important line as the form admSelectDbSet is used in quite a lot of places
  if (Undefined (!!admSelectDbSet)) then
    !!loadForm ('admselectdbset')
  endif
  -- Initialise variables
  !globalProject = !!admControl.isValid('Global')
  if (!globalProject) then
     !hubStatus = !!glbHubStatus(!globalProject)
  else
     !hubStatus = false
  endif
  !type          = !this.type.selection('rText').upcase()
  -- Performs actions on element type
  if (!type eq 'TEAM') then
    -- Set the current element and team ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      !this.teamSet(object DBREF())
      !!ce               = /*
      return
    endhandle
    -- Update the !!team form
    if (Undefined (!!admTeam)) then
       !!loadForm ('admteam')
    endif
    !this.teamSet(!!ce)
    !!admTeamUpdate()
    if (Undefined (!!admTeamCpy)) then
       !!loadForm ('admteamcpy')
    endif
    !!refreshDependent(!!admTeamCpy)

  elseif (!type eq 'USER') then
    -- Set the current element and USER ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      !this.userSet(object DBREF())
      !!ce               = /*
      return
    endhandle
    -- Update the !!user form
    if (Undefined (!!admUser)) then
       !!loadForm ('admuser')
    endif
    !this.userSet(!!ce)
    if(Undefined (!!admAcr))then
      !!loadForm(|admacr|)
    endif
    if(Undefined(!!admAcrCopy2))then
      !!loadForm(|admacrcopy2|)
    endif
    !!admUser.update()
    if (Defined (!!admUserCpy)) then
       !!refreshDependent(!!admUserCpy)
    endif
    -- Try and reset copyElem2Locs forms
    !this.which()

  elseif (!type eq 'DBSET') then
    -- Set the current element and team ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      !this.dbSetSet(object DBREF())
      !!ce               = /*
      return
    endhandle
    -- Update the !!dbSet form
    if (Undefined (!!admDbSet)) then
       !!loadForm ('admdbset')
    endif
    !this.dbSetSet(!!ce)
    !!admDbSet.update()
    if (Undefined (!!admDbSetCpy)) then
       !!loadForm ('admDbSetCpy')
    endif
    !!refreshDependent(!!admDbSetCpy)
    -- Try and reset copyElem2Locs forms
    !this.which()

  elseif (!type eq 'ROLE') then
    -- Set the current element and ROLE ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      !this.roleSet(object DBREF())
      !!ce               = /*
      return
    endhandle
    -- Update the !!role form
    if (Undefined (!!admRole)) then
       !!loadForm ('admRole')
    endif
    !this.roleSet(!!ce)
    !!admRole.update()
    if(Undefined (!!admPerop)) then
       !!loadForm ('admPerop')
    endif
    !!admPerop.hide()

  elseif (!type eq 'SCOPE') then
    -- Set the current element and SCOPE ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      !this.scopeSet(object DBREF())
      !!ce               = /*
      return
    endhandle
    -- Update the !!scope form
    if (Undefined (!!admScope)) then
       !!loadForm ('admScope')
    endif
    !this.scopeSet(!!ce)
    !!admScope.update()
    -- Try and reset copyElem2Locs forms
    !this.which()

  elseif (!type eq 'ACR') then
    -- Set the current element and SCOPE ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      !this.acrSet(object DBREF())
      !!ce               = /*
      return
    endhandle
    -- Update the !!admAcr form
    if (Undefined (!!admAcr)) then
       !!loadForm ('admacr')
    endif
    -- Update the !!admAcrSt form
    if (Undefined (!!admAcrSt)) then
       !!loadForm ('admacrst')
    endif
    !this.acrSet(!!ce)
    if(!!ce.type EQ |ACR|)then
      !!admAcr.update()
    else
      !!admAcrSt.update()
    endif

  elseif (!type eq 'DB') then
    -- Set the current element and DB ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      -- try it with /* appended to it
      !r = |/*| + !this.element.selection('rText')
      !!ce       = !r.dbref()
      handle any
        !this.dbSet(object DBREF())
        !!ce               = /*
        return
      endhandle
    endhandle
    -- Update the !!database form
    if (Undefined (!!admDb)) then
      !!loadForm ('admdb')
    endif
    !this.dbSet(!!ce)
    if(!!admDb.shown() AND (!!admDb.modeGet() EQ |MODIFY|))then
      !!admDb.update()
    endif

    if (Undefined (!!admExtract)) then
      !!loadForm ('admExtract')
    endif
    !this.dbSet(!!ce)
    if(!!admExtract.shown() AND (!!admExtract.modeGet() EQ |MODIFY|))then
      !!admExtract.update()
    endif
    if (Undefined (!!admDbCpy)) then
      !!loadForm ('admdbcpy')
    endif
    !!refreshDependent(!!admDbCpy)
--    if (!hubStatus) then
      if (Undefined (!!glbDbPri)) then
        !!loadForm ('glbdbpri')
      endif
      !!refreshDependent(!!glbDbPri)
--    endif

  elseif (!type eq 'WORK EXT') then
    -- Set the current element and DB ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      -- try it with /* appended to it
      !r = |/*| + !this.element.selection('rText')
      !!ce       = !r.dbref()
      handle any
        !this.dbSet(object DBREF())
        !!ce               = /*
        return
      endhandle
    endhandle
    !this.dbSet(!!ce)
    -- Update the !!database form
    if (Undefined (!!admWorkMod)) then
      !!loadForm ('admworkmod')
    endif
    if(!!admWorkMod.shown())then
      !!admWorkMod.update()
    endif

  elseif (!type eq 'MDB') then
    -- Update the MDB Definition form
    if (Undefined (!!admMdb)) then
      !!loadForm ('admmdb')
    endif
    -- Set the current element and MDB ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      !this.mdbSet(object DBREF())
      !!ce               = /*
      return
    endhandle
    !this.mdbSet(!!ce)
    !!admMdb.update()
    if (Defined (!!admMdbCpy)) then
      !!refreshDependent(!!admMdbCpy)
    endif
    -- Try and reset copyElem2Locs forms
    !this.which()

  elseif (!type eq 'LOC') then
    -- Set the current element and LOC ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      !this.locSet(object DBREF())
      !!ce               = /*
      return
    endhandle
    !this.locSet(!!ce)
    -- Update the location definition form
    if (!hubStatus) then
      !!glbLoc.update()
    endif

  elseif (!type eq 'GRP') then
    -- Set the current element and GRP ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      !this.grpSet(object DBREF())
      !!ce               = /*
      return
    endhandle
    !this.grpSet(!!ce)
    -- Update the !!location form
    if (!hubStatus) then
      !!glbGrpUpdate()
    endif

  elseif (!type eq 'LCOMD') then
    -- Set the current element and GRP ref
    !!ce       = !this.element.selection('rText').dbref()
    handle any
      !this.lComSet(object DBREF())
      !!ce               = /*
      return
    endhandle
    !this.lComSet(!!ce)
    -- Update the !!commsLink form
    if (!globalProject) then
      if (defined(!!glbLcomd)) then
        !!glbLcomd.update()
      endif
    endif

  elseif (!type eq 'STAMP') then

    -- Set the current element and stamp ref
    !!ce = !this.element.selection('RTEXT').dbref()
    handle any
      !this.stampSet(object DBREF())
      !!ce               = /*
      return
    endhandle

    -- Update the STAMP Definition form
    if (Undefined (!!admStamp)) then
      !!loadForm ('admStamp')
    endif
    !this.stampSet(!!ce)

  endif

endmethod
-- End of method definition for .depend()
------------------------------------------------------------------------
--
-- Method:      .filt()
--
-- Description: take the user input filter and remember the value
-- for later use.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .filt()
  -- Initialise variables
  !type    = !this.type.selection('rText').upcase()
  !activeButtons = true

  !globalProject = !!admControl.isValid('Global')

  if(!globalProject AND NOT (!!adminApplic.getAdmContext().prmRf.unset() AND !!adminApplic.getAdmContext().prvrf.unset()) )then
    -- if this site cannot administer the current admin context then inactivate most of this form!
    if( (!!adminApplic.getAdmContext().prmRf NEQ !!dbrGlbCurLocRf()) AND ( !!dbrGlbCurLocRf() NEQ !!dbrGlbHubLocRf() ))then
      !activeButtons = false
    endif
  endif

  -- Check that the filter is not blank
  if (!this.filter.val.empty()) then
    !this.filter.val   = |*|
  endif
  -- Remember the filter for the form mode
  if (!type eq 'TEAM') then
    !this.teamFilter   = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.teamSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'USER') then
    !this.userFilter   = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.userSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'DB') then
    !this.dbFilter     = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.dbSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'MDB') then
    !this.mdbFilter    = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.mdbSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'LOC') then
    !this.locFilter    = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.locSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'GRP') then
    !this.locFilter    = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.grpSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'LCOMD') then
    !this.lcomdFilter  = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.lcomdSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'ROLE') then
    !this.roleFilter  = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.roleSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'SCOPE') then
    !this.scopeFilter  = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.scopeSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'WORK EXT') then
    !this.extractsFilter  = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.workSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'DBSET') then
    !this.dbSetFilter  = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.dbSetSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'ACR') then
    !this.acrFilter  = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.acrSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'STAMP') then
    !this.stampFilter  = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.stampSetButtons()
    else
      !this.greyButtons()
    endif
  elseif (!type eq 'NTUSER') then
    !this.authUserFilter  = !this.filter.val
    -- Refresh the form list
    !this.refresh()
    -- update button active state for new list
    if (!activeButtons) then
      !this.authUserSetButtons()
    else
      !this.greyButtons()
    endif
  endif

endmethod
-- End of method definition for .filt()
------------------------------------------------------------------------
--
-- Method:      .goto()
--
-- Description: method navigate user to named element (more or less).
--
-- ***** This method can have some unexpected results because as far
--       as the user is aware TEAM and USERS can share names. The use
--       of /*<team> must be used to navigate to a TEAM if not the
--       user will be found.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .goto(!name is STRING)
  -- Get the current logical position just in case
  !currDbRef = !this.element.selection('rText').dbref()
  -- Check the contents of !name
  if (!name.unset() or !name.empty()) then
    return
  endif
  -- Check to se if name start with a '/'
  if (!name.substring(1,1) neq '=' and !name.substring(1,1) neq '/') then
    !gotoName = |/| + !name
  else
    !gotoName = !name
  endif
  -- Try to navigate to element
  !dbref    = !gotoName.dbref()
  handle (2,109)
    -- Try just in case a DB or TEAM exists
    !gotoName = |/*| + !name
    !dbref    = !gotoName.dbref()
    handle (2,109)
      !this.navigate.val = ||
      !!messageFile.error(143, 007, !name)
    endhandle
  endhandle
  -- At the new element so check the type
  !!ce      = !dbref
  !type     = !!ce.type
  !typeList = |TEAM USER DB MDB LOC GRP LCOMD DBSET ROLE SCOPE ACR ACRST STAMP|
  if (!typeList.match(!type) eq 0) then
    -- element cannot be displayed in view
    !!ce = !currDbRef
    !this.navigate.val = ||
    return
  endif
  -- This is a viewable element
  -- Check the group that is currently displayed
  if (!type neq !this.type.selection('rText')) then
    !this.type.select('rText', !type)
    !this.update(!this.type.selection('rText'))
  endif
  -- Try to select the element in the list
  !this.selRef(!dbref)
  -- Clear the navigate gadget
  !this.navigate.val = ||
endmethod
-- End of method definition for .goto(STRING)

------------------------------------------------------------------------
--
-- Method:      .grpGet()
--
-- Description: return the current selected GRP from the Admin
-- elements form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of current user
--
------------------------------------------------------------------------
-- Define method
define method .grpGet() is DBREF
  -- Return the value
  return !this.grp
endmethod
-- End of method definition for .grpGet() DBREF
------------------------------------------------------------------------
--
-- Method:      .grpSet()
--
-- Description: set the current GRP in the Admin element form
-- value.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of GRP element (may be unset)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .grpSet(!dbref is DBREF)
  -- Check that the type is valid
  if (!dbref.unset() or !dbref.type eq 'GRP') then
    -- Set the value
    !this.grp    = !dbref
  endif
endmethod
-- End of method definition for .grpSet(DBREF)
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise the Admin elements form. Controls
-- the displayed object type.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .init()

  -- Initialise variables
  !dText         = ARRAY()
  !rText         = ARRAY()

  !this.setHeader()

  !globalProject = !!admControl.isValid('Global')

  -- Reports whether Data Access Control is available
  !dacAvailable  = !!admControl.isDAC()

  if (!globalProject) then
    !hubStatus = !!glbHubStatus(!globalProject)

    -- make sure 'copy to locations form is loaded!
    !!loadForm ('glbCopyElem2Locs')
  else
    !hubStatus = false
  endif

  -- Load element types
  !dText.append(|Teams|)
  !rText.append(|TEAM|)

  !dText.append(|Users|)
  !rText.append(|USER|)

  -- Add in NT users if authentication is switched on
  !authentication=authentication
  if (!authentication) then
    !dText.append(|NT Authenticated Users|)
    !rText.append(|NTUSER|)
  endif

  -- Extracts available
  if(!!admControl.isValid('Extracts')) then
    !dText.append(|Databases & Extracts|)
    !rText.append(|DB|)

    !dText.append(|Working Extracts|)
    !rText.append(|WORK EXT|)
  else
    !dText.append(|Databases|)
    !rText.append(|DB|)
  endif

  !dText.append(|MDBs|)
  !rText.append(|MDB|)

  if(!!admControl.isDBSet())then
    !dText.append(|DB Sets|)
    !rText.append(|DBSET|)
  endif

  -- Is the access control assistant being used
  !acaAddIn = FALSE
  !file = object FILE('%PDMSEXE%\AdminAddins.xml')
  if (!file.exists()) then
    !data = !file.readfile()
    do !value values !data
      if (!value.trim() eq '<string>acaAddin</string>') then
        !acaAddIn = TRUE
        break
      endif
    enddo
  endif

  if (!!admControl.isValid('Data Access Control') and !acaAddIn.not()) then
    !dText.append(|Scopes|)
    !rText.append(|SCOPE|)

    !dText.append(|Roles|)
    !rText.append(|ROLE|)

    !dText.append(|ACRs & ACR Groups|)
    !rText.append(|ACR|)
  endif

  if(!!admControl.isValid('Locations')) then
    !dText.append(|Locations|)
    !rText.append(|LOC|)
  endif

  if(!!admControl.isValid('Location Groups')) then
    !dText.append(|Location Groups|)
    !rText.append(|GRP|)
  endif

  if(!!admControl.isValid('Location Updates')) then
    !dText.append(|Update Events|)
    !rText.append(|LCOMD|)
  endif

--  if ((!globalProject and !hubStatus) or !globalProject.not()) then
    !dText.append(|Date Stamps|)
    !rText.append(|STAMP|)
--  endif

  -- Set Type gadget
  !this.type.dText = !dText
  !this.type.rText = !rText

  -- Set the default previous type
  if(!this.prevType.set())then
    !this.type.val = !this.type.rText.findFirst(!this.prevType)
  endif

  -- Now using faster data collection using xxx.mem syntax rather than !!collectAllFor
  -- Collect the elements in the database
  !!ce                    = !!dbrAdminGetWorld('TEAM')

  !this.teamRefs    = !!ce.mem

  !!ce                    = !!dbrAdminGetWorld('USER')

  !uRefs = !!ce.mem
  !count = 0
  !this.userRefs.clear()
    do !i values !uRefs
      if (!i.type eq 'USER') then
        !this.userRefs.append(!i)
      elseif (!i.type eq 'ULOGID') then
         !this.authUserRefs.append(!i)
      endif
    enddo

  -- Build up a list of authenticated users if authentication is on
  !authentication=authentication
  if (!authentication) then
    !this.authUsers.clear()
    !authUsers = authusers
    do !i values !authUsers
      !this.authUsers.append(!i.name)
    enddo
  endif

  !!ce               = !!dbrAdminGetWorld('STAMP')
  !this.stampRefs    = !!ce.mem

  if(!!admControl.isDBSet())then
    !!ce                    = !!dbrAdminGetWorld('DBSET')

    !this.dbSetRefs    = !!ce.mem
  endif

  if (!dacAvailable) then

    !!ce                  = !!dbrAdminGetWorld('SCOPE')

    !this.scopeRefs    = !!ce.mem

    !!ce                  = !!dbrAdminGetWorld('ACR')
    handle any

    elsehandle none
      !this.acrRefs    = !!ce.mem
    endhandle

    -- Roles are stored in Global database in Global projects
    if (!globalProject) then
      var !roleStrings COLLECT ALL ROLE FOR /*GRO
    else
      var !roleStrings COLLECT ALL ROLE FOR /*RO
    endif
    !roleDbRefs = ARRAY()
    do !i values !roleStrings
      !roleDbRefs.append(!i.dbref())
    enddo
    !this.roleRefs = !roleDbRefs

  endif

  !!ce                    = !!dbrAdminGetWorld('MDB')
  !this.mdbRefs     = !!ce.mem
  if (!globalProject) then
    !!ce                    = !!dbrAdminGetWorld('LOC')
    !this.locRefs     = !!ce.mem[2].mem
    !this.grpRefs     = !!ce.mem[1].mem
    !!ce                    = !!dbrAdminGetWorld('LCOM')
    do !typ values !!ce.mem
        if(!typ.type.eq('LCOML'))then
              !this.lComdRefs   = !typ.mem
        endif
    enddo
  endif
  -- (ak) working extracts ------------------------------------

  !!ce                = !!dbrAdminGetWorld('USER')
  var !workStrings COLLECT ALL DB FOR CE

  !workDbRefs  = ARRAY()
  do !i values !workStrings
    !workDbRefs.append(!i.dbref())
  enddo

  !this.extractsRefs = !workDbRefs

-------------------------------------------------------------

  !this.update(!this.type.selection('rText'))
  !this.which()
endmethod
-- End of method definition for .init()
