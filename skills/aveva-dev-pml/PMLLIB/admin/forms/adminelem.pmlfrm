endmethod
-- End of method definition for .roleSet(DBREF)
------------------------------------------------------------------------
--
-- Method:      .which()
--
-- Description: Works out which arguments to send to form glbCopyElem2Locs.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .which()
  if(!!admControl.isValid('Global'))then
    !type       = !this.type.selection('rText')
    if( not defined(!!glbCopyElem2Locs) ) then
      pml load form !!glbCopyElem2Locs
    endif
    if(!type eq |MDB|)then
      !element = !this.mdbGet()
      !!glbCopyElem2Locs.display(!type, !element)
    elseif(!type eq |USER|)then
      !element = !this.userGet()
      !!glbCopyElem2Locs.display(!type, !element)
    elseif(!type eq |SCOPE|)then
      !element = !this.scopeGet()
      !!glbCopyElem2Locs.display(!type, !element)
    elseif(!type eq |DBSET|)then
      !element = !this.dbSetGet()
      !!glbCopyElem2Locs.display(!type, !element)
    endif
  endif
endmethod
-- End of method definition for .which()
------------------------------------------------------------------------
--
-- Method:      .queryCe()
--
-- Description: Will query the current element.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryCe()

  if (!this.element.dText.size() eq 0) then
    return
  endif
  !currElemName = !!adminElem.element.selection(|rText|).dbref().namn
  handle (2,813) (2,113) $* NT Auth user rText is name
    !currElemName = !!adminElem.element.selection(|rText|)
  endhandle
  !currElemName = !currElemName.trim('L','*')
  !currElemName = !currElemName.replace('/','')
  !currElemName = !currElemName.replace('_','')
  !currElemName = !currElemName.replace('-','')
  !currElemName = !currElemName.replace('.','')
  !typeName     = !!adminElem.type.selection(|rText|)
  !typeName     = !typeName.replace(' ','')
  !formsName    = |!!queryFrm| + !currElemName.string() + !typeName.string()
  !form = ARRAY()
  !form[1] = |Setup Form | + !formsName
  !form[2] = !formsName + |.formTitle     = 'Query Results'|
  !form[3] = !formsName + |.iconTitle     = 'Query Result'|
  !form[4] = |view .output at x 0 y 0 ALPHA|
  !form[5] = |height 10 width 60|
  !form[6] = |CHANNEL REQUESTs|
  !form[7] = |exit|
  !form[8] = |button .dismiss at xmax form-size ymax  'Dismiss' CALL 'kill | + !formsName + |'|
  !form[9] = !formsName + |.cancelCall = 'kill | + !formsName + |'|
  !form[10] = |exit|
  do !t values !form
    $!t
  enddo
  -- Make sure ce is pointing to the right element
  !prev = !!ce
  !!ce = !!adminElem.element.selection(|rText|).dbref()
  handle (2,813) (2,113) $* NT Auth user needs to have a /
    !ntUser = '/' & !!adminElem.element.selection(|rText|)
    !!ce = !ntUser.dbref()
  endhandle
  show $!formsName
  !stringForm = $!formsName
  !string = 'kill ' + !formsName
  !stringForm.cancelCall = !string
  QUERY ATT
  !!ce = !prev
endmethod
-- End of method definition for .queryCe()
------------------------------------------------------------------------
--
--Method: .acrChoose()
--
-- Description: An acr to choose whether to create an acr or an Acr group
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .acrChoose(!mode is STRING)
  if(!mode eq |CREATE|)then
  --  kill !!adminElemQu
    --!form = ARRAY()
    --Setup Form !!adminElemQu
    --!!adminElemQu.formTitle     = 'Question'
    --!!adminElemQu.iconTitle     = 'Question'
    --para .question1 at x 0 y 0 text 'Do you wish to Create'
    --para .question2 at x 0 ymax text 'an ACR or a group of ACRs'

    --button .acr at x 0  ymax  'ACR' CALL |!!admAcr.display('CREATE')|
    --button .group at xmax+11  ymin  'ACR GROUP' CALL |!!admAcrSt.display('CREATE')|

    --button .dismiss at xmax form-size ymax  'Dismiss' CALL 'kill !!adminElemQu'
    --exit
    show !!adminElemAcr
    -- This form get kill again in the relevant form!
  else
    -- fix arg 1 unset on the modify button
    -- this should be replaced by greying out the modify button when there is nothing to modify,
    -- but that will take more effort and is liable to bring in more bugs. Do this when we have more time. (AK)
    if(!this.acrGet().set()) then
      if(!this.acrGet().type EQ |ACR|)then
        !!admAcr.display('MODIFY')
      else
        !!admAcrSt.display('MODIFY')
      endif
    endif
  endif
endmethod
-- End of method definition for .acrChoose(STRING)
------------------------------------------------------------------------
--
--Method: .dbChoose()
--
-- Description: An form to choose whether to create a db or an extract
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dbChoose()

  -- If we are allowed to create extract, then allow the choice of DB
  -- type to be created
  if(!!admControl.isValid('Extracts')) then

    -- Load admin element DB form
    if(undefined(!!adminElemDb)) then
      !!loadForm('adminelemdb')
    endif

    -- This form get kill again in the relevant form!
    !!adminElemDb.display( !this.element.selection('rText') )

  -- Display db create form
  else
    !!admDb.display(|CREATE|)
  endif

endmethod
-- End of method definition for .dbChoose()

------------------------------------------------------------------------
--
--Method: .isHub()
--
-- Description: returns true if this is the hub
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isHub() is BOOLEAN

  -- This relies on a previous bit of coding being correct ( I don't like this!!)
  if (!!admControl.isValid('Global')) then
    !isHub = (!!adminApplic.getAdmContext() EQ !!dbrGlbHubLocRf())
  else
    !isHub = TRUE
  endif

  return !isHub

endmethod
-- End of method definition for .isHub() BOOLEAN

------------------------------------------------------------------------
--
--Method: .greyButtons()
--
-- Description: Sets active state of TEAM function buttons
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .greyButtons()

  !this.create.active    = false
  !this.create.callback  = ||
  !this.copy.active      = false
  !this.copy.callback    = ||
  !this.modify.active    = false
  !this.modify.callback  = ||
  !this.delete.active    = false
  !this.forDb.active     = false
  !this.inclDb.active    = false
  !this.exclude.active   = false
  !this.scriptGen.active = false

  if (!!admControl.isValid('Copy to Location')) then
    !this.copy2.active   = false
  endif

endmethod
-- End of method definition for .greyButtons()

------------------------------------------------------------------------
--
--Method: .teamSetButtons()
--
-- Description: Sets active state of TEAM function buttons
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .teamSetButtons()

  -- if list not populated, do not allow modify, copy etc.
  if (!this.isHub()) then

    !populatedList         = !this.element.dText.empty().not()
    !this.create.active    = true
    !this.create.callback  = |!!admTeamDisplay('CREATE')|
    !this.copy.active      = !populatedList
    !this.copy.callback    = |show !!admTeamCpy free|
    !this.modify.active    = !populatedList
    !this.modify.callback  = |!!admTeamDisplay('MODIFY')|
    !this.delete.active    = !populatedList
    !this.forDb.active     = false
    !this.inclDb.active    = false
    !this.exclude.active   = false
    !this.scriptGen.active = false

    -- copy2 button only available on global2 projects
    if (!!admControl.isValid('Copy to Location')) then
      !this.copy2.active   = false
    endif

  else
    !this.greyButtons()
  endif

endmethod
-- End of method definition for .teamSetButtons()

