------------------------------------------------------------------------
--
--Method: .locSetButtons()
--
-- Description: Sets active state of LOCATION function buttons
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .locSetButtons()

  if (!this.isHub()) then
    -- Check hub is initialised
    !hubInitialised = !!dbrGlbHubLocRf().linit
    -- if list not populated, do not allow modify, copy etc.
    !populatedList = !this.element.dText.empty().not()
    !this.create.active    = !hubInitialised
    !this.create.callback  = |!this.daemonGlbStat('CREATE')|
    --!this.create.callback  = |!!glbLoc.display('CREATE')|
    !this.copy.active      = false
    !this.copy.callback    = ||
    -- Can modify an uninitialised Hub - but not Create/Delete
    !this.modify.active    = !populatedList
    !this.modify.callback  = |!this.daemonGlbStat('MODIFY')|
    --!this.modify.callback  = |!!glbLoc.refSet(!this.element.selection('rtext').dbref())
    --!!glbLoc.display('MODIFY')|
    !this.delete.active    = (!populatedList and !hubInitialised)
    !this.forDb.active     = false
    !this.inclDb.active    = false
    !this.exclude.active   = false
    !this.scriptGen.active = false
    if (!!admControl.isValid('Copy to Location')) then
      !this.copy2.active = false
    endif
  else
    !this.greyButtons()
  endif

endmethod
-- End of method definition for .locSetButtons()

