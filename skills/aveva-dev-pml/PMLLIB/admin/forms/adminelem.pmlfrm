------------------------------------------------------------------------
--
--Method: .stampSetButtons()
--
-- Description: Sets active state of STAMP function buttons
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stampSetButtons()

  -- Initialise variables
  !populatedList = !this.element.dText.empty().not()
  !globalProject = !!admControl.isValid('Global')
  if (!globalProject) then
     !hubStatus = !!glbHubStatus(!globalProject)
  else
     !hubStatus = false
  endif

  -- If list not populated, do not allow modify, copy etc.
  !this.filter.val   = !this.stampFilter
if ((!globalProject and !hubStatus) or !globalProject.not()) then
  !this.create.active    = true
  !this.create.callback  = |!!admStamp.formMethods.display('CREATE')|
  !this.copy.active      = !populatedList
  !this.copy.callback    = |!this.stampCopy()|
  !this.modify.active    = !populatedList
  !this.modify.callback  = |!!admStamp.formMethods.display('MODIFY')|
  !this.delete.active    = !populatedList
  !this.forDb.active     = false
  !this.inclDb.active    = false
  !this.exclude.active   = false
  !this.scriptGen.active = false
  if (!!admControl.isValid('Copy to Location')) then
    !this.copy2.active = false
  endif
else
    !this.greyButtons()
    -- This is a special case where:-
    -- If at a satellite we need to view the Stamps even though we cannot create or modify
    --!this.modify.active    = !populatedList
    --!this.modify.callback  = |!!admStamp.formMethods.display('VIEW')|
endif

endmethod
-- End of method definition for .stampSetButtons()

------------------------------------------------------------------------
--
--Method: .stampCopy()
--
-- Description: Call the stamp copy form
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stampCopy()

  -- Test for loaded form
  if (undefined(!!admStampCpy)) then
    pml load form !!admStampCpy
  endif

  -- Show copy stamp form
  !!admStampCpy.show('FREE')

endmethod
-- End of method definition for .stampCopy()

------------------------------------------------------------------------
--
-- Method:      .stampGet()
--
-- Description: Return the current selected STAMP from the Admin
-- elements form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of current STAMP
--
------------------------------------------------------------------------
-- Define method
define method .stampGet() is DBREF
  -- Return the value
  return !this.stamp
endmethod
-- End of method definition for .stampGet() DBREF
------------------------------------------------------------------------
--
-- Method:      .stampSet()
--
-- Description: Set the current STAMP in the Admin element form
-- value.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of STAMP element (may be UNSET)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .stampSet(!dbref is DBREF)
  -- Check that the type is valid
  if (!dbref.unset() or !dbref.type.upcase().eq('STAMP')) then
    -- Set the value
    !this.stamp = !dbref
  endif
endmethod
-- End of method definition for .stampSet(DBREF)


------------------------------------------------------------------------
--
-- method Type:   method/Procedure
--
-- Description : Set the header of the list of elements
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setHeader()

  if(!this.type.selection().upcase().eq('TEAM')) then
    !validHeadings = !!admDisplayConfig.teamFormat.order
    do !i indices !validHeadings
      if(!!admDisplayConfig.teamFormat.attribute(!validHeadings[!i].upcase())) then
        !heading[!i] = !!admDisplayConfig.teamFormat.order[!i]
      endif
    enddo
  !heading.compress()
  elseif(!this.type.selection().upcase().eq('ROLE')) then
  --  same order  and heading as team (No config for Roles ?? [AK]
     !heading = !!admDisplayConfig.teamFormat.order
  elseif(!this.type.selection().upcase().eq('ACR')) then
  -- ACR's are slightly different to the other lists (the <type> is a separate column not a string in the first column)
    !heading[1] = 'Type'
  -- same order  and heading as team
    !validHeadings = !!admDisplayConfig.teamFormat.order
    do !i indices !validHeadings
      !c = !i + 1
      if(!!admDisplayConfig.acrFormat.attribute(!validHeadings[!i].upcase())) then
        !heading[!c] = !!admDisplayConfig.teamFormat.order[!i]
      endif
    enddo
  !heading.compress()
  elseif(!this.type.selection().upcase().eq('DBSET')) then
    -- same order  and heading as team
   !validHeadings = !!admDisplayConfig.teamFormat.order
   do !i indices !validHeadings
    if(!!admDisplayConfig.dbSetFormat.attribute(!validHeadings[!i].upcase())) then
      !heading[!i] = !!admDisplayConfig.teamFormat.order[!i]
    endif
  enddo
  !heading.compress()
  elseif(!this.type.selection().upcase().eq('SCOPE')) then
  -- same order and heading as team (No config for Scopes ?? [AK]
    !heading = !!admDisplayConfig.teamFormat.order
  elseif(!this.type.selection().upcase().eq('USER')) then
    !validHeadings = !!admDisplayConfig.userFormat.order
    do !i indices !validHeadings
      if(!!admDisplayConfig.userFormat.attribute(!validHeadings[!i].upcase())) then
        !heading[!i] = !!admDisplayConfig.userFormat.order[!i]
      endif
    enddo
    !heading.compress()
  elseif(!this.type.selection().upcase().eq('DB')) then
    !validHeadings = !!admDisplayConfig.dbFormat.order
    do !i indices !validHeadings
      if(!!admDisplayConfig.dbFormat.attribute(!validHeadings[!i].upcase())) then
       -- change the header to English
        if(!!admDisplayConfig.dbFormat.order[!i].eq('TypeDb')) then
          !heading[!i] = 'Type'
        elseif(!!admDisplayConfig.dbFormat.order[!i].eq('DbNo')) then
          !heading[!i] = 'DB Number'
        elseif(!!admDisplayConfig.dbFormat.order[!i].eq('isprim')) then
          !heading[!i] = 'Location'
        elseif(!!admDisplayConfig.dbFormat.order[!i].eq('Name')) then
          -- Force in a TAB character
          !heading[!i] = '	' & 'Name'
        else
          !heading[!i] = !!admDisplayConfig.dbFormat.order[!i]
        endif
      endif
    enddo
    !heading.compress()
  elseif(!this.type.selection().upcase().eq('MDB')) then
  -- same order and heading as team
    do !i indices !!admDisplayConfig.teamFormat.order
      if(!!admDisplayConfig.mdbFormat.attribute(!!admDisplayConfig.teamFormat.order[!i].upcase())) then
        !heading[!i] = !!admDisplayConfig.teamFormat.order[!i]
      endif
    enddo
    !heading.compress()
  elseif(!this.type.selection().upcase().eq('LOC')) then
  -- same order and heading as team
    do !i indices !!admDisplayConfig.teamFormat.order
      if(!!admDisplayConfig.mdbFormat.attribute(!!admDisplayConfig.teamFormat.order[!i].upcase())) then
        !heading[!i] = !!admDisplayConfig.teamFormat.order[!i]
      endif
    enddo
    !heading.compress()
  elseif(!this.type.selection().upcase().eq('GRP')) then
  -- same order and heading as team
    do !i indices !!admDisplayConfig.teamFormat.order
      if(!!admDisplayConfig.mdbFormat.attribute(!!admDisplayConfig.teamFormat.order[!i].upcase())) then
         !heading[!i] = !!admDisplayConfig.teamFormat.order[!i]
      endif
    enddo
    !heading.compress()
  elseif(!this.type.selection().upcase().eq('LCOMD')) then
   -- same order and heading as team
    do !i indices !!admDisplayConfig.teamFormat.order
      if(!!admDisplayConfig.mdbFormat.attribute(!!admDisplayConfig.teamFormat.order[!i].upcase())) then
         !heading[!i] = !!admDisplayConfig.teamFormat.order[!i]
      endif
    enddo
    !heading.compress()
  elseif(!this.type.selection().upcase().eq('WORK EXT')) then
    !validHeadings = !!admDisplayConfig.dbFormat.order
    do !i indices !validHeadings
      if(!!admDisplayConfig.dbFormat.attribute(!validHeadings[!i].upcase())) then
       -- change the header to English
        if(!!admDisplayConfig.dbFormat.order[!i].eq('TypeDb')) then
          !heading[!i] = 'Type'
        elseif(!!admDisplayConfig.dbFormat.order[!i].eq('DbNo')) then
          !heading[!i] = 'DB Number'
        elseif(!!admDisplayConfig.dbFormat.order[!i].eq('isprim')) then
          !heading[!i] = 'Location'
        else
          !heading[!i] = !!admDisplayConfig.dbFormat.order[!i]
        endif
      endif
    enddo
   !heading.compress()
    -- add an extra header in for Working extracts
    if(!!admDisplayConfig.dbFormat.name) then
      !heading.insert(2,'For User')
    else
    -- if name is unchecked
      !heading.insert(1,'For User')
    endif
  elseif(!this.type.selection().upcase().eq('STAMP')) then
    !validHeadings = !!admDisplayConfig.stampFormat.order
    do !i indices !validHeadings
      if(!!admDisplayConfig.stampFormat.attribute(!validHeadings[!i].upcase())) then
        !heading[!i] = !!admDisplayConfig.stampFormat.order[!i]
      endif
    enddo
    !heading.compress()
  elseif(!this.type.selection().upcase().eq('NTUSER')) then
    !heading[1] = 'Name'
  else
    !heading[1] = ''
  endif
  !this.element.setHeadings(!heading)
  --handle ANY
   -- temporary while move all headings to the object
  --endhandle
endmethod
-- End of method definition for .setHeader()
----------------------------------------------------------------------------------
--
--Method: .daemonGlbStat(STRING)
--
-- Description: Alert to check the communication then show the relevant form
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .daemonGlbStat(!action is STRING)

   -- Message will not display, if Hub is not initialised.
   if (!this.isHub() and !!dbrGlbCurLocRf().linit) then
     !!alert.message('Action will take time if Daemon at Hub is not running. Check the communication status.')
   endif

     if (!action.eq('CREATE')) then
       !!glbLoc.display('CREATE')
     elseif(!action.eq('MODIFY')) then
       !!glbLoc.refSet(!this.element.selection('rtext').dbref())
       !!glbLoc.display('MODIFY')
     endif

endmethod
-- End of method definition for .daemonGlbStat()
-----------------------------------------------------------------------------------
