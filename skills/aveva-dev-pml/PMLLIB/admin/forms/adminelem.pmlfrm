------------------------------------------------------------------------
--
-- Method:      .refresh()
--
-- Description: refresh the list of Admin elements after a
-- create or delete operation.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .refresh()

  -- Initialise variables
  !globalProject = !!admControl.isValid('Global')
  !type        = !this.type.selection('rText').upcase()
  !displayRefs = ARRAY()

  -- Display a message
  !!messageFile.prompt(141, 4, !this.formTitle, !type)

  -- Clear the list
--  !this.element.clear()

  -- Regenerate the list contents
  if (!type eq 'TEAM') then

    -- Display the TEAM text
    !displayRefs  = !!adminFilterSort(!this.teamRefs, !this.sort, !this.filter)
    !!adminTeamTxtList(!displayRefs, !this.element, !!admDisplayConfig.fmtTeamGet(), !!admDisplayConfig.eleTypeGet())

    -- Try and reset the current team
    !this.selRef(!this.team)

  elseif (!type eq 'ROLE') then

    -- Display the ROLE text
    !displayRefs  = !!adminFilterSort(!this.roleRefs, !this.sort, !this.filter)
    !!admRoleTxtList(!displayRefs, !this.element, !!admDisplayConfig.eleTypeGet())

    -- Try and reset the current user
    !this.selRef(!this.role)

  elseif (!type eq 'ACR') then

    -- Display the ACR text
    !displayRefs  = !!adminFilterSort(!this.acrRefs, !this.sort, !this.filter)
    !!admAcrTxtList(!displayRefs, !this.element, !!admDisplayConfig.fmtAcrGet(), !!admDisplayConfig.eleTypeGet())

    -- Try and reset the current user
    !this.selRef(!this.acr)

  elseif (!type eq 'DBSET') then

    -- Display the DBSET text
    !displayRefs  = !!adminFilterSort(!this.dbSetRefs, !this.sort, !this.filter)
    !!admDbSetTxtList(!displayRefs, !this.element,!!admDisplayConfig.fmtDbSetGet(), !!admDisplayConfig.eleTypeGet())

    -- Try and reset the current user
    !this.selRef(!this.dbSet)

  elseif (!type eq 'SCOPE') then

    -- Display the SCOPE text
    !displayRefs  = !!adminFilterSort(!this.scopeRefs, !this.sort, !this.filter)
    !!admScopeTxtList(!displayRefs, !this.element, !!admDisplayConfig.eleTypeGet())

    -- Try and reset the current user
    !this.selRef(!this.scope)

  elseif (!type eq 'USER') then

    -- Display the USER text
    !displayRefs  = !!adminFilterSort(!this.userRefs, !this.sort, !this.filter)
    !!adminUserTxtList(!displayRefs, !this.element, !!admDisplayConfig.fmtUserGet(), !!admDisplayConfig.eleTypeGet())

    -- Try and reset the current user
    !this.selRef(!this.user)

  elseif (!type eq 'DB') then

   !displayRefs = !this.dbRefs
   !orderedDisplayConfiguration = !!admDisplayConfig.dbFormat
  -- Initialise variables
  !globalProj  = !!glbIsGlobal()

--DB name construction was previously carried out using admTextList.pmlobj however to improve performance
--when working with large numbers of databases in Admin the db data extract method used has been improved
--and carried out inline which means we can no longer use admTextList.pmlobj so we must therefore construct the name here

    !sortCriteria  = ARRAY()
    !dText = ARRAY()
    !sortedDText = ARRAY()
    !sortedRText = ARRAY()
    !rText = ARRAY()

    do !db values !displayRefs

      --Initialise the array used to hold the column values
      !temp = ARRAY()

      --If we are displaying the name then construct the displayed name including determining symbol flags such as * for foreign
      if (!orderedDisplayConfiguration.name) then

        -- filter out the database if the filter is set

        if (!this.filter.val neq '*') then
          skip if (!db.name.after('/*').matchWild('$!this.filter.val').not())
        endif

        --Initialise the variables used to hold the symbols and the symbol and db name concatenation

        --symbol0 is a constant holding the <DB> prefix
        if( !!admDisplayConfig.eleTypeGet() ) then
          !symbol0 = |<DB>|
        else
          !symbol0 = ||
        endif

        --symbol1 is used to hold a * if the db is foreign or a W if it is a global working extract
        !symbol1 = | |

         --symbol2 is used to hold V if the DB is a variant
        !symbol2 = | |

        --symbol3 is used to hold an X if the DB is an extract
        !symbol3 = | |

        --symbol4 holds MARINE if db is a marine db
        !symbol4 = | |


        --For foreign db add a * to symbol1
        if (!db.projid.set()) then
          !symbol1 = |*|
        endif

        !lvar = !db.lvar
        handle ANY
          -- do nothing
        elsehandle none
          --If the DB is a variant then add a V to symbol2
          if (!lvar) then
            !symbol2 = |V|
          endif
        endhandle

       !extOwner = !db.extOwner
       handle ANY
         -- do nothing
       elsehandle none
         --If the DB is an extract then add a X to symbol3
         if (!extOwner.set()) then
           !symbol3 = |X|
         endif
       endhandle


        --If it's a global project then
        if (!globalProj) then
          if (undefined(!curLoc)) then
            !curLoc      = !!adminApplic.getAdmContext()
            handle any
              !curLoc = object DBREF()
            endhandle
          endif
          if (!db.foreign neq 'FOREIGN') then
             -- Primary(+) or secondary(-) flag
             !locRef    = !db.prmloc
             !prvrf     = !db.members[1].prvrf
             handle any
               !prvrf = object DBREF()
             endhandle
             if(!locRef.unset() AND !prvrf.unset())then
               !symbol1 = |?|
             elseif(!locRef EQ  !curLoc)then
               !symbol1 = |+|
             elseif(!locRef NEQ !curLoc)then
               !symbol1 = |-|
             else
               !symbol1 = |?|
             endif
          endif
        endif

        -- P-17003 No need to report Sub-type (STYPDB) - no longer used
        --         This could be left in as configurable - but this is unnecessary complexity
        !symbol4 = | |

        --Construct the name using the flags and the db name and add to the temp output array
        !temp.append(!symbol0 + !symbol1 + !symbol2 + !symbol3 + !symbol4)
        !configuredName = !db.name.after('/*')
        !temp.append(!configuredName)
      else

        if (!this.filter.val neq '*') then
          skip if (!db.name.after('/*').matchWild('$!this.filter.val').not())
        endif

      endif

      if (!orderedDisplayConfiguration.typeDb) then
        !temp.append(!db.stype)
      endif


      if (!orderedDisplayConfiguration.dbNo) then
        !temp.append(!db.numbDb.string())
      endif

      if (!globalProj) then
        if (!orderedDisplayConfiguration.isPrim) then
          if (!db.prmloc.set()) then
            !primaryLocation = !db.prmloc.namn
            !temp.append(!primaryLocation)
          else
            !temp.append('unset')
          endif
        endif
      endif

      if (!orderedDisplayConfiguration.access) then
        !temp.append(!db.access)
      endif
      if (!orderedDisplayConfiguration.claim) then
        !temp.append(!db.claimDb)
      endif
      if (!orderedDisplayConfiguration.filename) then
       !temp.append(!db.file)
      endif
      if (!orderedDisplayConfiguration.description) then
        if (!db.description eq '') then
          !temp.append('unset')
        else
          !temp.append(!db.description)
        endif
      endif

      !dText.append(!temp)
      !rText.append(!db.name)
      if (!this.sort.selection() eq 'name' or !this.sort.selection() eq  'owner.owner.name.substring(3)') then
        !sortCriteria.append(!db.name)
      elseif (!this.sort.selection() eq 'typedb') then
        !sortCriteria.append(!db.typeDb)
      elseif (!this.sort.selection() eq 'dbno.string()') then
        !sortCriteria.append(!db.dbNo)
      elseif (!this.sort.selection() eq 'prmloc.string()') then
        !sortCriteria.append(!db.prmloc.string())
      elseif (!this.sort.selection() eq 'accessdb') then
        !sortCriteria.append(!db.accessdb)
      elseif (!this.sort.selection() eq 'description') then
        !sortCriteria.append(!db.description)
      endif
    enddo
    !sorted = !sortCriteria.sortedIndices()
    do !index index !sorted
      !sortedDText[!index] = !dText[!sorted[!index]]
      !sortedRText[!index] = !rText[!sorted[!index]]
    enddo
   !this.element.setrows(!sortedDText)
   !this.element.rText = !sortedRText


    -- Try and reset the current database

    !this.selRef(!this.db)

  elseif (!type eq 'MDB') then

    !displayRefs  = !!adminFilterSort(!this.mdbRefs, !this.sort, !this.filter)
    !!adminMdbTxtList(!displayRefs, !this.element, !!admDisplayConfig.fmtMdbGet(), !!admDisplayConfig.eleTypeGet())

    -- Try and reset the current MDB
    !this.selRef(!this.mdb)

  elseif (!type eq 'LOC') then

    !displayRefs  = !!adminFilterSort(!this.locRefs, !this.sort, !this.filter)
    !!adminLocnTxtList(!displayRefs, !this.element)

    -- Try and reset the current location
    !this.selRef(!this.loc)

  elseif (!type eq 'GRP') then

    !displayRefs  = !!adminFilterSort(!this.grpRefs, !this.sort, !this.filter)
    !!adminGrpTxtList(!displayRefs, !this.element)

    -- Try and reset the current group
    !this.selRef(!this.grp)

  elseif (!type eq 'LCOMD') then
    !displayRefs  = !!adminFilterSort(!this.lComdRefs, !this.sort, !this.filter)
    !!adminCommTxtList(!displayRefs, !this.element)

    -- Try and reset the current comms link
    !this.selRef(!this.lcomd)

  elseif (!type eq 'WORK EXT') then
    !displayRefs  = !!adminFilterSort(!this.extractsRefs, !this.sort, !this.filter)
    if(!!admControl.isValid('Global'))then
      !!adminDbTxtList(!displayRefs, !this.element, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(),!!adminApplic.getAdmContext())
    else
      !!adminDbTxtList(!displayRefs, !this.element, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(),object DBREF())
    endif

    -- Try and reset the current comms link
--  !this.db = !this.element.selection().dbref()
    !this.selRef(!this.db)

  elseif (!type.eq('STAMP')) then

    -- Display the STAMP text
    !displayRefs  = !!adminFilterSort(!this.stampRefs, !this.sort, !this.filter)
    !!adminStampTxtList(!displayRefs, !this.element, !!admDisplayConfig.fmtStampGet(), !!admDisplayConfig.eleTypeGet())

    -- Try and reset the current user from the stamp form
    if (!!admStamp.shown()) then
      !this.selRef(!!admStamp.formMethods.dbref)
    else
      !this.selRef(!this.stamp)
    endif

  elseif (!type eq 'NTUSER') then
    if (!this.filter.val.empty()) then
      !this.filter.val = |*|
    endif
    !sort = !this.authUsers.sortedIndices()

    -- Build display and replacement texts
    !dispList = ARRAY()

    do !i values !sort
      !filterString = !this.authUsers[!i]
      skip if (not !filterString.matchWild(!this.filter.val))
      !dispList.append(!this.authUsers[!i])
    enddo

    -- Assign values if defined
      !this.element.dText=!dispList
  endif

  -- Clear the prompt
  !!prompt(0)

endmethod
-- End of method definition for .refresh()

------------------------------------------------------------------------
--
-- Method:      .sel
--
-- Description: navigate the user to the current selected element.
-- This could be NEXT / PREV or SELECTED.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action to take.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method

define method .sel(!action is STRING)

  -- Initialise variables
  !currentPos   = !this.element.val
  !maxPos       = !this.element.dText.size()

  -- Check that the list contains values
  if (!maxPos eq 0) then
    return
  endif

  -- Process the action
  if (!action eq 'NEXT') then

    -- Calculate the next position
    !newPos       = !currentPos + 1
    if (!newPos gt !maxPos) then
      !newPos       = !maxPos
    endif

    -- Set the new list position
    !this.element.val  = !newPos

  -- Calculate the previous position
  elseif (!action eq 'PREV') then

    !newPos       = !currentPos - 1
    if (!newPos lt 1) then
      !newPos       = 1
    endif

    -- Set the new list position
    !this.element.val  = !newPos

  endif

  !unused = !this.element.selection().dbref()
  handle (2,107)
    !!alert.error(|This element cannot be found. It may have been deleted - the list will be updated|)
    !this.update(!this.type.selection('rtext'))
    return
  elsehandle (2,813) (2,113)
    -- for NT user names as they are not DBRefs
    -- TFS-141595 : also handle different error when NT user name is numeric
  endhandle

  -- Update form dependencies
  !type       = !this.type.selection('rText')

  if(!type eq |WORK EXT| )then
     !this.db = !this.element.selection().dbref()
  endif

  !this.depend()

  -- Update copyElem2locs form
  if((!type EQ |MDB|) OR (!type EQ |USER|) OR (!type EQ |SCOPE|))then
    !this.which()
  endif

  -- if this is an extract - grey out the copy button
  if(!type eq |DB| )then
    !this.copy.active = BADREF(!this.element.selection().dbref().extOwn ) and !this.isHub()
  endif


endmethod
-- End of method definition for .sel(STRING)
------------------------------------------------------------------------
--
-- Method:      .selRef()
--
-- Description: select a specific DBREF from the current displayed
-- list of elements.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       element to select
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .selRef(!dbref is DBREF)
  -- Initialise variables
  !typeShown   = !this.type.selection('rText').upcase()
  if(!typeShown eq 'WORK EXT') then
    !typeShown = 'DB'
  endif
  -- Attempt to set the value is it is a good ref
  if (!dbref.badRef().not()) then
    -- Select if the type matches
    if (!dbref.type eq !typeShown) then
      if (!this.type.selection() eq 'DB') then
        !this.element.select('rText',!dbref.name.string())
        handle any
        -- Not found in list
        endhandle
      else
        !this.element.select('rText',!dbref.string())
        handle any
        -- Not found in list
        endhandle
      endif
    endif
  endif
  -- Update the dependencies on the form
  !this.depend()
endmethod
-- End of method definition for .selRef(DBREF)
------------------------------------------------------------------------
--
-- Method:      .sort()
--
-- Description: take the user input sort and remember the value
-- for later use.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .sort()
  -- Initialise variables
  !type    = !this.type.selection('rText').upcase()
  -- Remember the sort for the form mode
  if (!type eq 'TEAM') then
    !this.teamSort   = !this.sort.selection('dText')
  elseif (!type eq 'USER') then
    !this.userSort   = !this.sort.selection('dText')
  elseif (!type eq 'DB') then
    !this.dbSort     = !this.sort.selection('dText')
  elseif (!type eq 'MDB') then
    !this.mdbSort    = !this.sort.selection('dText')
  elseif (!type eq 'LOC') then
    !this.locSort    = !this.sort.selection('dText')
  elseif (!type eq 'GRP') then
    !this.locSort    = !this.sort.selection('dText')
  elseif (!type eq 'LCOMD') then
    !this.lcomdSort  = !this.sort.selection('dText')
  elseif (!type eq 'DBSET') then
    !this.dbSetSort  = !this.sort.selection('dText')
  elseif (!type eq 'ACR') then
    !this.acrSort  = !this.sort.selection('dText')
  elseif (!type eq 'WORK EXT') then
    !this.acrSort  = !this.sort.selection('dText')
  elseif (!type eq 'STAMP') then
    !this.stampSort   = !this.sort.selection('dText')
  elseif (!type eq 'NTUSER') then
    !this.authUserSort   = !this.sort.selection('dText')
  endif
  -- Refresh the form list
  !this.refresh()
endmethod
-- End of method definition for .sort()
------------------------------------------------------------------------
--
-- Method:      .teamGet()
--
-- Description: return the current selected TEAM from the Admin
-- elements form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of current user
--
------------------------------------------------------------------------
-- Define method
define method .teamGet() is DBREF
  -- Return the value
  return !this.team
endmethod
-- End of method definition for .teamGet() DBREF
------------------------------------------------------------------------
--
-- Method:      .teamSet()
--
-- Description: set the current TEAM in the Admin element form
-- value.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of TEAM element (may be unset)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .teamSet(!dbref is DBREF)
  -- Check that the type is valid
  if (!dbref.unset() or !dbref.type eq 'TEAM') then
    -- Set the value
    !this.team    = !dbref
  endif
endmethod
-- End of method definition for .teamSet(DBREF)
------------------------------------------------------------------------
--
-- Method:      .type()
--
-- Description: set up the adminElem form depending on the selected
-- element group.
-- this method also sets active states of the adminelem form
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .type()

  -- Initialise variables
  !type          = !this.type.selection('rText').upcase()
  !activeButtons = true

  -- Set previous type for FUTURE case
  !this.prevType = !type
  !globalProject = !!admControl.isValid('Global')

  if(!globalProject AND NOT (!!adminApplic.getAdmContext().prmRf.unset() AND !!adminApplic.getAdmContext().prvrf.unset()) )then
    -- if this site cannot administer the current admin context then inactivate most of this form!
    if( (!!adminApplic.getAdmContext().prmRf NEQ !!dbrGlbCurLocRf()) AND ( !!dbrGlbCurLocRf() NEQ !!dbrGlbHubLocRf() ))then
      !activeButtons = false
    endif
  endif

  -- Set the form up for the selected type
  if (!type eq 'TEAM') then

    -- Set up gadgets for a team
    !this.filter.val   = !this.teamFilter

    -- Assign the sort gadget values
    !!admTeamSortGadg(!this.sort)
    !this.sort.select('dText',!this.teamSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.teamSetButtons()
    else
      !this.greyButtons()
    endif

    -- Ensure that !!admMdb is present
    if (undefined (!!admMdb)) then
      !!loadForm ('admmdb')
    endif

  -- Set up gadgets for a working extract
  elseif (!type eq 'WORK EXT') then

    !this.filter.val   = !this.extractsFilter
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.workSetButtons()
    else
      !this.greyButtons()
    endif

    -- Assign the sort gadget values
    !!admDbSortGadg(!this.sort)
    !this.sort.select('dText',!this.extractsSort)

  -- Set up gadgets for a DBSET
  elseif (!type eq 'DBSET') then

    !this.filter.val   = !this.dbSetFilter

    -- Assign the sort gadget values
    !!admPackSortGadg(!this.sort)
    !this.sort.select('dText',!this.dbSetSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.dbSetSetButtons()
    else
      !this.greyButtons()
    endif

    -- Ensure that !!admDbSet is present
    if (undefined (!!admDbSet)) then
       !!loadForm ('admdbset')
    endif

  -- Set up gadgets for a ACR
  elseif (!type eq 'ACR') then

    !this.filter.val   = !this.acrFilter

    -- Assign the sort gadget values
    !!admAcrSortGadg(!this.sort)
    !this.sort.select('dText',!this.acrSort)
    !this.refresh()
    if (!activeButtons) then
      !this.acrSetButtons()
    else
      !this.greyButtons()
    endif

    -- Ensure that !!admAcr is present
    if (undefined (!!admUser)) then
       !!loadForm ('admuser')
    endif

    if (undefined (!!admAcr)) then
       !!loadForm ('admacr')
    endif

    if (undefined (!!admAcrSt)) then
       !!loadForm ('admacrst')
    endif

  -- Assign the sort gadget values
  elseif (!type eq 'SCOPE') then

    !this.filter.val   = !this.scopeFilter

    !!admScopeSortGadg(!this.sort)
    !this.sort.select('dText',!this.scopeSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.scopeSetButtons()
    else
      !this.greyButtons()
    endif

    -- Ensure that !!admScope is present
    if (undefined (!!admScope)) then
      !!loadForm ('admscope')
    endif

  -- Set up gadgets for a team
  elseif (!type eq 'ROLE') then

    !this.filter.val   = !this.roleFilter

    -- Assign the sort gadget values
    !!admRoleSortGadg(!this.sort)
    !this.sort.select('dText',!this.roleSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.roleSetButtons()
    else
      !this.greyButtons()
    endif

    -- Ensure that !!admRole is present
    if (undefined (!!admRole)) then
      !!loadForm ('admrole')
    endif

    -- Ensure that !!admPerop is present
    if (undefined (!!admPerop)) then
      !!loadForm ('admperop')
    endif

  -- Assign the sort gadget values
  elseif (!type eq 'USER') then

    !this.filter.val   = !this.userFilter

    !!admUserSortGadg(!this.sort)
    !this.sort.select('dText',!this.userSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.userSetButtons()
    else
      !this.greyButtons()
    endif

    -- Ensure that !!admAcr is present
    if (undefined (!!admAcr)) then
      !!loadForm ('admacr')
    endif

    -- Ensure that !!admAcrCopy2 is present
    if (undefined (!!admAcrCopy2)) then
      !!loadForm ('admacrcopy2')
    endif

  -- Assign the sort gadget values
  elseif (!type eq 'NTUSER') then

    !this.filter.val   = !this.authUserFilter

    -- Initialise variables
    !dText        = ARRAY()
    !rText        = ARRAY()

    -- Assign values to the gadget
    -- Dtexts
    !dText.append('Name')
    !this.sort.dText  = !dText

    -- RTexts
    !rText.append('name')
    !this.sort.rText  = !rText

    !this.sort.select('dText',!this.authUserSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.authUserSetButtons()
    else
      !this.greyButtons()
    endif


  -- Set up gadgets for a DB
  elseif (!type eq 'DB') then

    !this.filter.val   = !this.dbFilter

    -- Assign the sort gadget values
    !!admDbSortGadg(!this.sort)
    !this.sort.select('dText',!this.dbSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.dbSetButtons()
    else
      !this.greyButtons()
    endif

    -- Ensure that !!admDb is present
    if (undefined (!!admDb)) then
      !!loadForm ('admdb')
    endif


    -- Ensure that !!admExtract is present
    if (undefined (!!admExtract)) then
       !!loadForm ('admextract')
    endif

  -- Assign the sort gadget values
  elseif (!type eq 'MDB') then

    !this.filter.val   = !this.mdbFilter

    !!admMdbSortGadg(!this.sort)
    !this.sort.select('dText',!this.mdbSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.mdbSetButtons()
    else
      !this.greyButtons()
    endif

  -- Set up gadgets for a LOC
  elseif (!type eq 'LOC') then

    -- Ensure that !!glbLoc is present
    if (undefined (!!glbLoc)) then
      !!loadForm ('glbloc')
    endif

    !this.filter.val   = !this.locFilter

    -- Assign sort gadget values
    !!admLocSortGadg(!this.sort)
    !this.sort.select('dText',!this.locSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.locSetButtons()
    else
      !this.greyButtons()
    endif

    -- The hub is transient
    if(!!dbrGlbHubLocRf().unset())then
      -- ##
      !!alert.error(|The Hub Location has not been set. This must happen before the creation of new locations.|)
      !this.create.active    = FALSE
    -- The hub's hostname has not been set
    elseif(!!dbrGlbHubLocRf().rhost.unset())then
      -- ##
      !!alert.error(|The Hub Location does not have its Host attribute set. This must happen before the creation of new locations.|)
      !this.create.active    = FALSE
    elseif (!!dbrGlbHubLocRf().linit.not()) then
      -- ##
      !text = |Make any necessary changes in the Locations form and apply. This is necessary for the project to function.|
      !!alert.error(|The Hub Location has not been initialised. | + !text)
      !this.create.active    = FALSE
    endif

  -- Set up gadgets for a GRP
  elseif (!type eq 'GRP') then

    -- Ensure that !!glbGrp is present
    if (undefined (!!glbGrp)) then
      !!loadForm ('glbgrp')
    endif

    !this.filter.val   = !this.grpFilter

    -- Assign sort gadget values
    !!admGrpSortGadg(!this.sort)
    !this.sort.select('dText',!this.grpSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.grpSetButtons()
    else
      !this.greyButtons()
    endif

  elseif (!type eq 'LCOMD') then

    -- Ensure that !!glbLcomd is present
    if (undefined (!!glbLcomd)) then
      !!loadForm ('glblcomd')
    endif

    !this.filter.val   = !this.locFilter

    -- Assign sort gadget values
    !!admCommSortGadg(!this.sort)
    !this.sort.select('dText',!this.lcomdSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.lcomdSetButtons()
    else
      !this.greyButtons()
    endif

  elseif (!type eq 'STAMP') then

    -- Set up gadgets for a team
    !this.filter.val   = !this.stampFilter

    -- Ensure that !!admStamp is present
    if (undefined (!!admStamp)) then
      !!loadForm ('admStamp')
    endif

    -- Assign the sort gadget values
    !!admStampSortGadg(!this.sort,'LONG')
    !this.sort.select('dText',!this.stampSort)
    !this.refresh()

    -- setup function buttons on the form
    if (!activeButtons) then
      !this.stampSetButtons()
    else
      !this.greyButtons()
    endif

  endif

endmethod
-- End of method definition for .type()

------------------------------------------------------------------------
--
-- Method:      .update
--
-- Description: reconstruct the list from the database. This method
-- will also the methods that maintain the lists in other forms
-- for the selected element type.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of element tp re-construct for.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .update(!type is STRING)

!this.setHeader()


  -- Initialise variables
  !activeButtons = true

  -- Change form mode if necessary
  !changedType = (!this.prevType.unset() or !type neq !this.type.selection('rText') or !type neq !this.prevType)
  if (!changedType) then
    !this.type.select('rText',!type)
  endif

  -- Check for a global project
  !isGlobal   = !!admControl.isValid('Global')

  if(!isGlobal AND NOT (!!adminApplic.getAdmContext().prmRf.unset() AND !!adminApplic.getAdmContext().prvrf.unset()) )then
    -- if this site cannot administer the current admin context then inactivate most of this form!
    if( (!!adminApplic.getAdmContext().prmRf NEQ !!dbrGlbCurLocRf()) AND ( !!dbrGlbCurLocRf() NEQ !!dbrGlbHubLocRf() ))then
      !activeButtons = false
    endif
  endif

  -- Perform reconstruction on element type

  if (!type eq 'TEAM') then
    -- Update the list of team refs
    !!ce                  = !!dbrAdminGetWorld('TEAM')
    !this.teamRefs = !!ce.mem
    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.teamSetButtons()
    else
      !this.greyButtons()
    endif
    -- Update forms that use this array
    if (Defined (!!admTeamCpy)) then
      !!refreshDependent(!!admTeamCpy)
    endif
    if (Defined (!!admUser)) then
      !!admUser.refresh()
    endif
    if (Defined (!!admDb)) then
      !!admDb.refresh()
    endif
    if (Defined (!!admDbCpy)) then
      !!admDbCpy.refresh()
    endif
    if (Defined (!!admDbFor)) then
      !!admDbFor.refresh('TEAM')
    endif
    if (Defined (!!admMess)) then
      !!refreshDependent(!!admMess)
    endif

  elseif (!type eq 'USER') then
    -- Update the list of user refs
    !!ce                  = !!dbrAdminGetWorld('USER')

    !uRefs = !!ce.mem
    !this.userRefs.clear()
    !this.authUserRefs.clear()
    !count = 0
    do !i values !uRefs
      if (!i.type eq 'USER') then
        !this.userRefs.append(!i)
      elseif (!i.type eq 'ULOGID' ) then
        !this.authUserRefs.append(!i)
      endif
    enddo

    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.userSetButtons()
    else
      !this.greyButtons()
    endif
    -- Update forms that use this array
    !!admTeamRefresh()
    if (Defined (!!admMess)) then
       !!refreshDependent(!!admMess)
    endif

  elseif (!type eq 'NTUSER') then

    !this.authUsers.clear()
    !authUsers = authusers
    do !i values !authUsers
      !this.authUsers.append(!i.name)
    enddo

    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.authUserSetButtons()
    else
      !this.greyButtons()
    endif
    -- Update forms that use this array

    -- if NT Authenticated users load the Authenticated user form
     pml load form !!admAuthUser

  elseif (!type eq 'DBSET') then
    -- Update the list of user refs
    !!ce                  = !!dbrAdminGetWorld('DBSET')

    !this.dbSetRefs = !!ce.mem
    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
     -- setup function buttons on the form
    if (!activeButtons) then
      !this.dbSetSetButtons()
    else
      !this.greyButtons()
    endif
    -- Update forms that use this array
    if (Defined(!!admDbSet)) then
      !!refreshDependent(!!admDbSet)
    endif
    if (Defined (!!admDbSetCpy)) then
      !!refreshDependent(!!admDbSetCpy)
    endif

  elseif (!type eq 'ROLE') then
    -- Roles are stored in Global database in Global projects
    if (!!admControl.isValid('Global')) then
      var !roleStrings COLLECT ALL ROLE FOR /*GRO
    else
      var !roleStrings COLLECT ALL ROLE FOR /*RO
    endif
    !roleDbRefs = ARRAY()
    do !i values !roleStrings
      !roleDbRefs.append(!i.dbref())
    enddo
    !this.roleRefs = !roleDbRefs
    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.roleSetButtons()
    else
      !this.greyButtons()
    endif
    -- Update forms that use this array
    if (Defined(!!admRole)) then
      !!refreshDependent(!!admRole)
    endif
    -- Update forms that use this array
    if (Defined(!!admUser)) then
      !!refreshDependent(!!admUser)
    endif
    -- Update forms that use this array
    if (Defined(!!admAcr)) then
      !!refreshDependent(!!admAcr)
    endif

  elseif (!type eq 'SCOPE') then
    -- Update the list of SCOPE refs
    !!ce                 = !!dbrAdminGetWorld('SCOPE')

    !this.scopeRefs = !!ce.mem
    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.scopeSetButtons()
    else
      !this.greyButtons()
    endif
    -- Update forms that use this array
    if (Defined(!!admScope)) then
      !!refreshDependent(!!admScope)
    endif
    -- Update forms that use this array
    if (Defined(!!admUser)) then
      !!refreshDependent(!!admUser)
    endif
    -- Update forms that use this array
    if (Defined(!!admAcr)) then
      !!refreshDependent(!!admAcr)
    endif

  elseif (!type eq 'ACR') then
    -- Update the list of ACR refs
    !!ce                 = !!dbrAdminGetWorld('ACR')
    handle any
    elsehandle none
      !this.acrRefs = !!ce.mem
    endhandle
    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.acrSetButtons()
    else
      !this.greyButtons()
    endif
    -- Update forms that use this array
    if (Defined(!!admUser)) then
      !!refreshDependent(!!admUser)
    endif
    -- Update forms that use this array
    if (Defined(!!admAcr)) then
      !!refreshDependent(!!admAcr)
    endif
    if (Defined(!!admAcrSt)) then
      !!refreshDependent(!!admAcrSt)
    endif

  elseif (!type eq 'DB') then
    -- Update the list of database refs
    if (not !isGlobal) then
      !dbs = DBS
      !this.dbRefs = !dbs.evaluate(object BLOCK(|!dbs[!evalIndex].refno.dbref()|))
    else
      -- Use current location db allocation for global projects
      !!ce = admloc
      !clause  = 'TYPE eq |DB|'

      !this.dbRefs = !!ce.mem[1].mem
    endif
    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.dbSetButtons()
    else
      !this.greyButtons()
    endif
    -- Update forms that use this array
    if (Defined(!!admMdb)) then
      !!admMdb.refresh()
    endif
    if (Defined(!!admDic)) then
      !!refreshDependent(!!admDic)
    endif
    if (Defined(!!admDbIncl)) then
      !!admDbIncl.refresh()
    endif
    if (Defined(!!admDbFor)) then
      !!admDbFor.refresh('DB')
    endif
    if (Defined(!!admExClaim)) then
      !!admExClaimRefr()
    endif
    if (!isGlobal) then
      !!glbUpdOrdRefresh('DB')
    endif

  elseif (!type eq 'WORK EXT') then
    -- (ak) working extracts ------------------------------------
    !!ce  = !!dbrAdminGetWorld('USER')
    var !workStrings COLLECT ALL DB FOR CE
    !workDbRefs  = ARRAY()
    do !i values !workStrings
      !workDbRefs.append(!i.dbref())
    enddo
    !this.extractsRefs = !workDbRefs
    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.workSetButtons()
    else
      !this.greyButtons()
    endif
  -------------------------------------------------------------

   elseif (!type eq 'MDB') then
    -- Update the list of MDB refs
    !!ce                 = !!dbrAdminGetWorld('MDB')

    !this.mdbRefs = !!ce.mem
    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.mdbSetButtons()
    else
      !this.greyButtons()
    endif

  elseif (!type eq 'LOC') then
    -- Update the list of locations refs
    !!ce                 = !!dbrAdminGetWorld('LOC')

    !this.locRefs = !!ce.mem[2].mem
    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.locSetButtons()
    else
      !this.greyButtons()
    endif
    -- Update forms that use this array
    if (Defined(!!commsLink)) then
      !!refreshDependent(!!commsLink)
    endif
    if (Defined(!!glbListLocn)) then
      !!refreshDependent(!!glbListLocn)
    endif
    if (Defined(!!glbListAlloc)) then
      !!refreshDependent(!!glbListAlloc)
    endif
    if (Defined(!!glbParLoc)) then
      !!refreshDependent(!!glbParLoc)
    endif
    if (Defined(!!glbPing)) then
      !!refreshDependent(!!glbPing)
    endif
    !!glbUpdOrdRefresh('LOC')

  elseif (!type eq 'GRP') then
    -- Update the list of locations refs
    !!ce                  = !!dbrAdminGetWorld('LOC')

    !this.grpRefs = !!ce.mem[1].mem
    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.grpSetButtons()
    else
      !this.greyButtons()
    endif
    -- Update forms that use this array
    if (Defined(!!glbGrpLoc)) then
      !!refreshDependent(!!glbGrpLoc)
    endif

  elseif (!type eq 'LCOMD') then
    -- Update the list of locations refs
    !!ce                  = !!dbrAdminGetWorld('LCOM')

    do !typ values !!ce.mem
       if(!typ.type.eq('LCOML'))then
         !this.lComdRefs   = !typ.mem
       endif
    enddo

    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif
    -- setup function buttons on the form
    if (!activeButtons) then
      !this.lcomdSetButtons()
    else
      !this.greyButtons()
    endif

   elseif (!type eq 'STAMP') then

    -- Update the list of MDB refs
    !!ce = !!dbrAdminGetWorld('STAMP')
    !this.stampRefs = !!ce.mem
    if (!changedType) then
      !this.type()
    else
      !this.refresh()
    endif

    -- Test for shown MERGE CHANGES form
    if (defined(!!admMergeChange)) then
      if (!!admMergeChange.shown()) then

        -- Update the stamp lists
        !!admMergeChange.stampRefs = !this.stampRefs
        if (!!admMergeChange.stampAfter.active) then
          !!admMergeChange.stampList(!!admMergeChange.stampAfter)
        endif
        if (!!admMergeChange.stampBefore.active) then
          !!admMergeChange.stampList(!!admMergeChange.stampBefore)
        endif

      endif
    endif

    -- Setup function buttons on the form
    if (!activeButtons) then
      !this.stampSetButtons()
    else
      !this.greyButtons()
    endif

  endif

  -- Record the last selected type for future updates
  !this.prevType = !this.type.selection('rText')

endmethod
-- End of method definition for .update(STRING)

------------------------------------------------------------------------
--
-- Method:      .userGet()
--
-- Description: return the current selected USER from the Admin
-- elements form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of current user
--
------------------------------------------------------------------------
-- Define method
define method .userGet() is DBREF
  -- Return the value
  return !this.user
endmethod
-- End of method definition for .userGet() DBREF
------------------------------------------------------------------------
--
-- Method:      .userSet()
--
-- Description: set the current USER in the Admin element form
-- value.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of User element (may be UNSET)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .userSet(!dbref is DBREF)
  -- Check that the type is valid
  if (!dbref.set() and !dbref.type eq 'USER') then
    -- Set the value
    !this.user    = !dbref
  endif
endmethod
-- End of method definition for .userSet(DBREF)
