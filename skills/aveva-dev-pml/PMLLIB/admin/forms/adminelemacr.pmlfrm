-- Created:         Wed Sep 8 7:13:50 BST 1999
--
--
-- Description:
-- form to ask user what type of DB or ACR to create
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adminElemAcr()                   -
--  cancel()                         -
--  ok()                             -                   OK
--


setup form !!adminElemAcr

  !this.formTitle     = 'ACRs & ACR Groups      '
  !this.iconTitle     = 'CreateACRs'
  !this.formRevision  = ' $Revision: 1.4 $ '

  rgroup .whichType 'Create' frame vertical
   add tag 'Access Control Rights   '
   add tag 'A group of ACRs         '
  exit

  button .ok at x 0 ymax+.2  '  OK  '
  path right
  button .cancel at xmax form-size  'Cancel' cancel

exit
-- End of form definition for !!adminElemAcr

------------------------------------------------------------------------
--
-- Method:      constructor
--
-- Description: Build form constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .adminElemAcr()

  !this.ok.callback       = '!!admAcr.display(|CREATE|)'
  !this.ok.callback       = '!this.ok()'
  !this.cancel.callback   = '!this.cancel()'
  !this.cancelCall        = '!this.cancel()'

endmethod
-- End of method definition for .adminElemAcr()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description: OK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ok()

    if(!this.whichType.val.eq(1) ) then
      !!admAcr.display(|CREATE|)
    else
      !!admAcrSt.display(|CREATE|)
    endif

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      Cancel
--
-- Description: Cancel form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()


  !this.hide()



endmethod
-- End of method definition for .cancel()
