--
-- File:            adminelemdb.pmlfrm
--   Type:          Form Definition
--   Group:         PDMS Global Administration Application

--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Wed Sep 8 7:13:50 BST 1999
--
--
-- Description:
-- form to ask user what type of DB or ACR to create
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adminElemDb()                    -
--  cancel()                         -                   Cancel form
--  checkExt()                       -                   Checks the Extract creation is possible from the current location.
--  display(STRING)                  -                   method to display the DB Definition form.
--  init()                           -                   Form initialisation.
--  ok()                             -                   OK
--
------------------------------------------------------------------------
setup form !!adminElemDb

  !this.formTitle     = 'Databases & Extracts    '
  !this.iconTitle     = 'CreateDBs'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.5 $ '

  rgroup .whichType 'Create' frame vertical call |!this.checkExt()|
   add tag 'Master DB               '
   add tag 'An Extract of a DB      '
  exit

  button .ok at x 0 ymax+1  '  OK  '
  path right
  button .cancel at xmax form-size  'Cancel' cancel

  member .fromEntry     is STRING

exit
-- End of form definition for !!adminElemDb

------------------------------------------------------------------------
--
-- Method:      constructor
--
-- Description: Build form constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .adminElemDb()

  !this.ok.callback       = '!!admDb.display(|CREATE|)'
  !this.ok.callback       = '!this.ok()'
  !this.cancel.callback   = '!this.cancel()'
  !this.cancelCall        = '!this.cancel()'

endmethod
-- End of method definition for .adminElemDb()

------------------------------------------------------------------------
--
--Method: .display()
--
-- Description: method to display the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display from in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display(!fromEntry is STRING)

  -- store the parent reference number (from admin element form rtext
  !this.fromEntry = !fromEntry

  -- Show the form
  show !!adminElemDb

endmethod
-- End of method definition for .display(STRING)

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description: OK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ok()
    if(!this.whichType.val.eq(1) ) then
      !!admDb.display(|CREATE|)
    else
      !!admExtract.display(|CREATE|, !this.fromEntry)
    endif
endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description: Cancel form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  !this.hide()

endmethod
-- End of method definition for .cancel()
------------------------------------------------------------------------
-- Added by DDC for Global Enhancements. Date :07.04.06
--
-- Method:      init
--
-- Description: Initialisation for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
-- Added by DDC for DFN 9249. Date :28.04.06
    if(!!admControl.isValid('Global') and !!dbrGlbCurLocRf().noextc and !this.whichType.val.eq(2)) then
         !this.ok.active = false
     else
         !this.ok.active    = !!admControl.isValid('Extracts')
    endif
endmethod
-- End of method definition for .init()
-----------------------------------------------------------------------
-- Added by DDC for Global Enhancements. Date :10.04.06
--
-- Method:      .checkExt
--
-- Description: Checks the Extract creation is possible from the current location.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkExt()
--Modified by DDC for DFN 9249. Date :28.04.06
     if(!!admControl.isValid('Global') and !!dbrGlbCurLocRf().noextc and !this.whichType.val.eq(2)) then
           !curlocnam = !!dbrGlbCurLocRf().name.substring(2)
                 !!alert.message('Cannot create extract from  location $!curlocnam')
                 !this.init()
         else
           !this.init()
     endif
endmethod
-- End of method definition for .checkExt()
-----------------------------------------------------------------------
