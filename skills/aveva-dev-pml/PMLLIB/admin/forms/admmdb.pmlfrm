--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admMdb()                         -                   Constructor
--  cbApply()                        -                   create or modify an MDB element. The values for the
--  cbName(GADGET)                   -                   act as a callback to the MDB Definition form name
--  chkAllDbNo(ARRAY)                ARRAY               check that all databases being added to the current MDB
--  chkDbNo(DBREF)                   BOOLEAN             check that a database being added to the current MDB
--  curDbAdd(DBREF,REAL)             -                   add a database to the curArray array in the MDB
--  curDbGet()                       ARRAY               return an array of the current MDB's current databases.
--  curDbList(ARRAY)                 -                   control the contents on the Current Database
--  curDbRem(DBREF)                  -                   remove a database from the array of current database)
--  curDbSet()                       -                   set the current database array for the MDB that
--  curDef()                         -                   make the selected Current databases deferred in the
--  curDefEx()                       -                   exchange selected current databases with selected
--  curProj()                        -                   remove the select current databases from the MDB
--  defCur()                         -                   make the selected Deferred databases current in the
--  defDbAdd(DBREF,REAL)             -                   add a database to the defArray array in the MDB
--  defDbGet()                       ARRAY               return an array of the current MDB's deferred databases.
--  defDbList(ARRAY)                 -                   control the contents on the Deferred Database
--  defDbRem(DBREF)                  -                   remove a database from the array of deferred database)
--  defDbSet()                       -                   set the array of deferred databases for the MDB that
--  defProj()                        -                   remove the select deferred databases from the MDB
--  display(STRING)                  -                   setup the MDB creation and modification form for displaying.
--  init()                           -                   initialise the MDB Definition form.
--  mode()                           -                   Callback to the Mode gadget in the MDB Definition form.
--  modeGet()                        STRING              return the current mode of the MDB definition form.
--  modeSet(STRING)                  -                   set the mode of the this form
--  projCur()                        -                   make the selected Project databases current in the
--  projDbGet()                      ARRAY               return the array of project databases in use
--  projDbList()                     -                   control the contents on the Project Databases
--  projDbSet()                      -                   set the array of project databases for the form
--  projDef()                        -                   make the selected Project databases defer in the
--  reCompose(STRING)                -                   rebuild the 3 list gadgets
--  refGet()                         DBREF               return the current MDB dbRef for the element
--  refSet(DBREF)                    -                   set the current dbRef of the MDB that is being
--  refresh()                        -                   refresh the DB elements listed in the list gadgets
--  update()                         -                   update the displayed MDB in the MDB definition form. The
--
------------------------------------------------------------------------

-- Define form
setup form !!admMdb at xr 0.35 yr 0.1 resize

  !this.formTitle     = 'Multiple Database Creation'
  !this.iconTitle     = 'MDB'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.21 $ '

  -- Body of form definition
  text .name   anchor top+left+right at x 0.5 y 0.2 |Name        | call |!this.cbName(!this.name)| width 32 scroll 49 NAME
  option .mode anchor top+right      at xmax+12 ymin call |!this.mode()| width 7

  text .desc anchor top+left+right at xmin.name ymax+0.2 |Description | width 54 scroll 120 STRING

  frame .projDbsFr anchor all at xmin ymax+0.3 |Project Databases|

    list .projDbs anchor all at xmin+1 ymin+1 MULTIPLE columns width 64 height 10
    option .sort  anchor bottom+left at xmin ymax |Sort By | call |!this.projDbList()| width 12
    text .filter  anchor bottom+left at xmax+1 ymin | Filter | call |!this.projDbList()| width 15 STRING

  exit

--  button .clrCur anchor bottom+left at x2 ymax+0.5 |Clear| call |!this.curDb.clearSelection()|
  button .addCur anchor bottom+left at x12 ymax+0.5 call |!this.projCur()| pixmap width 16 height 16
  button .remCur anchor bottom+left at xmax ymin call |!this.curProj()| pixmap width 16 height 16

  toggle .reCompose anchor bottom+left at xmin.filter-2 ymin |Rebuild Lists | call | !this.reCompose('SWITCH') |
  button .now anchor bottom+left at xmax ymin |Now| call |!this.reCompose('ALL')|

  button .addDef anchor bottom+right at x52 ymin.addCur  call |!this.projDef()| pixmap width 16 height 16
  button .remDef anchor bottom+right at xmax ymin call |!this.defProj()| pixmap width 16 height 16
--  button .clrDef anchor bottom+right at xmax+4 ymin |Clear| call |!this.defDb.clearSelection()|

  frame .curDbsFr anchor bottom+left+right at xmin.name ymax+0.5 |Current Databases|

    list .curDb    anchor all at xmin.curDbsFr+1 y1 MULTIPLE columns width 30 height 10
    option .insCur anchor bottom+left at xmin ymax+0.2 |Insert | width 6

  exit

  button .def anchor bottom+right at xmax+0.2 ymin+3.5 call |!this.curDef()| pixmap width 16 height 16
  button .cur anchor bottom+right at xmin ymax         call |!this.defCur()| pixmap width 16 height 16
  button .exc anchor bottom+right at xmin ymax         call |!this.curDefEx()| pixmap width 16 height 16

  frame .defDbsFr anchor bottom+right at xmax ymin.curDbsFr |Deferred Databases|

    list .defDb    anchor all at xmin.defDbsFr+1 y1 MULTIPLE columns width 26 height 10
    option .insDef anchor bottom+left at xmin ymax+0.2 |Insert | width 6

  exit

  button .apply   anchor bottom+left  at xmin.curDbsFr ymax+0.5 | Apply | call |!this.cbApply()|  APPLY
  button .dismiss anchor bottom+right at xmax form-size ymin  |Dismiss| CANCEL

  -- Form member definition
    -- Mdb element dbRef
    member .dbRef    is DBREF
    -- Array of Project Databases
    member .dbArray  is ARRAY
    -- Array of Current Databases
    member .curArray is ARRAY
    -- Array of Deferred Databases
    member .defArray is ARRAY
    -- Members to maintain sort and filter
    member .filterVal is STRING
    member .sortVal   is STRING
    member .updateRequired is BOOLEAN

  menu .dbPopupMenu
    !this.dbPopupMenu.add(|CALLBACK|,|Select All DBs|,|!this.projDbs.select('rtext',!this.projDbs.rText)|)
    !this.dbPopupMenu.add(|CALLBACK|,|(DE)Select a Set of DBs...|,|!!admSelectDbSet.display(!this.projDbs)|)
    !this.dbPopupMenu.add(|CALLBACK|,|Clear Selection|,|!this.projDbs.clearSelection()|)
  !this.projDbs.setPopup(!this.dbPopupMenu)

  menu .dbPopupMenu2
    !this.dbPopupMenu2.add(|CALLBACK|,|Select All DBs|,|!this.curDb.select('rtext',!this.curDb.rText)|)
    !this.dbPopupMenu2.add(|CALLBACK|,|(DE)Select a Set of DBs...|,|!!admSelectDbSet.display(!this.curDb)|)
    !this.dbPopupMenu2.add(|CALLBACK|,|Clear Selection|,|!this.curDb.clearSelection()|)
  !this.curDb.setPopup(!this.dbPopupMenu2)

  menu .dbPopupMenu3
    !this.dbPopupMenu3.add(|CALLBACK|,|Select All DBs|,|!this.defDb.select('rtext',!this.defDb.rText)|)
    !this.dbPopupMenu3.add(|CALLBACK|,|(DE)Select a Set of DBs...|,|!!admSelectDbSet.display(!this.defDb)|)
    !this.dbPopupMenu3.add(|CALLBACK|,|Clear Selection|,|!this.defDb.clearSelection()|)
  !this.defDb.setPopup(!this.dbPopupMenu3)

exit
-- End of form definition for !!admMdb

------------------------------------------------------------------------
--
--Method: .admMdb()
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .admMdb()

  -- Initialise variables
  !dText = ARRAY()
  !rText = ARRAY()

  -- Initialise gadget
  !this.reCompose.val= true
  !this.now.active = !this.reCompose.val.not()

  -- set icons
  !this.addCur.addPixmap(!!pml.getPathName('downarrow16.png'))
  !this.remCur.addPixmap(!!pml.getPathName('uparrow16.png'))
  !this.def.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !this.cur.addPixmap(!!pml.getPathName('leftarrow16.png'))
  !this.exc.addPixmap(!!pml.getPathName('leftrightarrow16.png'))
  !this.addDef.addPixmap(!!pml.getPathName('downarrow16.png'))
  !this.remDef.addPixmap(!!pml.getPathName('uparrow16.png'))

  -- Assign Mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !this.mode.dText    = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !this.mode.rText    = !rText
  !rText.clear()

  -- Assign Insert gadget values
  !dText.append(|Before|)
  !dText.append(|After|)
  !this.insCur.dText  = !dText
  !this.insDef.dText  = !dText
  !dText.clear()
  !rText.append(|BEF|)
  !rText.append(|AFT|)
  !this.insCur.rText  = !rText
  !this.insDef.rText  = !rText
  !rText.clear()

  -- Assign Project Database sort values
  call !!admDbSortGadg(!this.sort)

  -- Assign default filter gadget value
  !this.filter.val    = |*|

endmethod
-- End of method definition for .admMdb()

------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: create or modify an MDB element. The values for the
-- element are taken from the MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbApply()

  -- Initialise variables
  !mode       = !this.modeGet()
  !dbRef      = !this.refGet()
  !updateFlag = false

  -- Check that the name is set
  if (!this.name.val eq 'unset') then

    -- Reset name if modify mode
    if (!mode eq 'MODIFY') then
      !this.name.val       = !dbRef.name.substring(2)
    endif

    -- Raise error
    !this.name.setFocus()
    !!messageFile.error(141, 201, !mode.lowcase())

  endif

  -- Actions depend on mode
  if (!mode eq 'CREATE') then

    -- Construct new name
    !mdbName     = |/| + !this.name.val
    !description = !this.desc.val

    -- Create the new MDB element
    !!ce         = !!dbrAdminGetWorld('MDB')
    -- *** OLD PML SYNTAX ***
    call !!admCommand(|NEW MDB $!mdbName|)
    handle (41,12)

      -- Mdb name already exists
      call !!admCommand(|DELETE MDB|)
      !!messageFile.error(141, 202, !this.name.val)
      !this.name.val    = |unset|

    endhandle

    -- Set the new element description
    if (!description neq 'unset') then
      !!ce.description = !description
    endif

    -- Set the update flag
    !updateFlag    = true
    !dbRef         = !!ce
    !!adminElem.mdbSet(!!ce)

  elseif (!mode eq 'MODIFY') then

    -- Check for element being already claimed
    if (not !!dbRefUpdate (!dbRef)) then
      !!alert.error (!!error.text)
      return
    endif

    -- Generate new attribute name
    !newName     = |/| + !this.name.val
    !description = !this.desc.val

    -- Navigate to the MDB
    !!ce         = !dbRef

    -- Change the name
    if (!dbRef.name neq !newName) then

      -- Modify the name
      -- *** OLD PML SYNTAX ***
      call !!admCommand(|NAME $!newName|)
      handle (41,12)

        -- Mdb already exists
        !!messageFile.error(141, 202, !this.name.val)
        !this.name.val         = !dbRef.name.substring(2)
        !this.name.setFocus()
        return
      endhandle

      -- Set the update flag
      !updateFlag        = true
      !this.formTitle = |Modify Multiple Database: |& !dbRef.name.substring(2)

    endif

    -- Change the description
    if (!description neq 'unset' and !dbRef.description neq !description) then
      !!ce.description = !description
      !updateFlag      = true
    endif

  endif

  -- Update the admin elements form if required
  if (!updateFlag) then
    !!adminElem.update('MDB')
  endif

  -- Set prompt while members are updated
  !!messageFile.prompt(141, 216, !dbRef.name.substring(2))

  -- Rationalise database members
  -- *** OLD PML SYNTAX ***
  call !!admCommand(|SET MDB $!dbRef.name|)
  !!ce     = !dbRef

  -- Get database information
  !oldCur  = CURDB
  !oldCur.invert()
  !oldDbs  = !!ce.dbls
  !newCur  = !this.curDbGet()
  !newDbs  = !newCur.union(!this.defDbGet())
  !addDbs  = !newDbs.difference(!oldDbs)
  !addDbs.invert()
  !remDbs  = !oldDbs.difference(!newDbs)
  !remDbs.invert()

  -- Defer current databases
  do !db values !oldCur
    !dbName  = !db.name.substring(3)
    -- *** OLD PML SYNTAX ***
    call !!admCommand(|DEFER $!dbName|)
  enddo

  -- Remove old dbs
  do !db values !remDbs
    !dbName          = !db.name.substring(3)
    call !!admCommand(|REMOVE $!dbName|)
  enddo

  -- Add new databases
  do !db values !addDbs
    !dbName          = !db.name.substring(3)
    call !!admCommand(|ADD $!dbName|)
  enddo

  -- Make databases current again
  do !i indices !newCur
    !dbName          = !newCur[!i].name.substring(3)
    call !!admCommand(|CURRENT $!dbName $!i|)
  enddo

  -- Dismiss the prompt
  !!prompt(0)

  -- Reset the form if create mode
  if (!mode eq 'CREATE' or !this.updateRequired ) then
    !this.init()
  endif

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
--Method: .curDbAdd()
--
-- Description: add a database to the curArray array in the MDB
-- definition form. The database is to be inserted at the position
-- supplied.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .curDbAdd(!dbRef is DBREF, !pos is REAL)

  -- Insert the value
  !this.curArray.insert(!pos,!dbRef)

  -- Compress the array
  !this.curArray.compress()

endmethod
-- End of method definition for .curDbAdd(DBREF, REAL)

------------------------------------------------------------------------
--
--Method: .curDbGet()
--
-- Description: return an array of the current MDB's current databases.
-- Applicable to the current MDB in the MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of databases current in MDB.
--
------------------------------------------------------------------------

define method .curDbGet() is ARRAY

   -- Return the value
   return !this.curArray

endmethod
-- End of method definition for .curDbGet() ARRAY

------------------------------------------------------------------------
--
--Method: .curDbList()
--
-- Description: control the contents on the Current Database
-- list gadget in the Multiple Database definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of current databases
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .curDbList(!dbArray is ARRAY)

  if(!!glbIsGlobal())then
    !wrtLoc = !!adminApplic.getAdmContext()
  else
    !wrtLoc = object DBREF()
  endif

  !dbFormat = !!admDisplayConfig.fmtDbGet()
  !dbFormat.sequence = true
  !dbList = object ADMTEXTLIST()
  !dbList.addDbs(!dbArray, !dbFormat, !!admDisplayConfig.eleTypeGet(), !this.curDb, !wrtLoc)

endmethod
-- End of method definition for .curDbList(ARRAY)

------------------------------------------------------------------------
--
--Method: .curDbRem()
--
-- Description: remove a database from the array of current database)
-- used by the MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       dbRef to be removed from curArray member.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .curDbRem(!dbRef is DBREF)

  -- Find the position in the array
  !pos  = !this.curArray.findFirst(!dbRef)

  -- Check the position was valid
  if (!pos.set()) then
    -- Remove the entry
    !this.curArray.remove(!pos)
  endif

endmethod
-- End of method definition for .curDbRem(DBREF)

------------------------------------------------------------------------
--
--Method: .curDbSet()
--
-- Description: set the current database array for the MDB that
-- is being defined in the mdb definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .curDbSet()

  -- Initialise variables
  !currentDbPos   = !!ce
  !dbRef          = !this.refGet()

  -- Set an empty array for an unset dbRef
  if (!dbRef.badRef()) then
    !databases      = ARRAY()
  else
    !!ce            = !dbRef
    !databases      = CURDB
  endif

  -- Store the value
  !this.curArray = !databases

  -- Restore the database position
  !!ce              = !currentDbPos

endmethod
-- End of method definition for .curDbSet()

------------------------------------------------------------------------
--
--Method: .curDef()
--
-- Description: make the selected Current databases deferred in the
-- MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .curDef()

  -- Initialise variables
  !curSel       = !this.curDb.val
  !neededCurSel = !this.curDb.val
  !remCurSel    = !neededCurSel.sort().invert()
  !defSel       = !this.defDb.val
  !defDbs       = !this.defDb.rText
  --!defDbs       = !this.defDbGet()
  !insert       = !this.insDef.selection('rtext')

  -- Check that Project Databases have been selected
  if (!curSel.size() eq 0) then
    return
  endif

  -- Check that only one Deferred database has been selected
  if (!defSel.size() gt 1) then
    -- Raise an error
    !!messageFile.error(141, 218)
    return
  endif

  -- Get the list position to insert at
  if (!insert eq 'BEF') then

    if (!defSel.size() eq 0 or !defSel[1] eq 1) then
      !pos        = 1
    else
      !pos        = !defSel[1]
    endif

  elseif (!insert eq 'AFT') then

    if (!defSel.size() eq 0) then
      !pos        = !defDbs.size() + 1
    else
      !pos        = !defSel[1] + 1
    endif

  endif

  -- Process the selection of current databases
  !tempDText = !this.defDb.dText
  !tempRText = !this.defDb.rText
  do !i indices !curSel

    !dbRef        = !this.curDb.rText[!curSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Insert new databases into deferred list and deferred gadget list
    !this.defDbAdd(!dbRef, !pos)
    !tempDText.insert(!pos, !this.curDb.dText[!curSel[!i]])
    !tempRText.insert(!pos, !this.curDb.rText[!curSel[!i]])

    -- Increment the position
    !pos          = !pos + 1

  enddo
  !this.defDb.dText = !tempDText
  !this.defDb.rText = !tempRText

  -- Process the selection of current databases
  !curDbDText = !this.curDb.dText
  !curDbRText = !this.curDb.rText
  do !i indices !curSel

    !dbRef        = !this.curDb.rText[!remCurSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Remove the databases from the Current Dbs list
    !this.curDbRem(!dbRef)
    !curDbDText.remove(!remCurSel[!i])
    !curDbRText.remove(!remCurSel[!i])

  enddo
  !this.curDb.dText = !curDbDText
  !this.curDb.rText = !curDbRText

  if (!this.reCompose.val) then
    !this.reCompose('CURDEF')
  else
    -- Set the update required member
    !this.updateRequired = true
  endif

endmethod
-- End of method definition for .curDef()

------------------------------------------------------------------------
--
--Method: .curDefEx()
--
-- Description: exchange selected current databases with selected
-- deferred databases.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .curDefEx()

  -- Initialise variables
  !curSel    = !this.curDb.val
  !defSel    = !this.defDb.val

  -- Ensure that the same number of each have been selected
  if (!curSel.size() neq !defSel.size()) then
    -- Raise error
    !!messageFile.error(141, 221)
  endif

  -- Return if no selection
  if (!curSel.size() eq 0) then
    return
  endif

  -- Process the selections (exchanging position for position)
  !curDbDText = !this.curDb.dText
  !curDbRText = !this.curDb.rText
  !defDbDText = !this.defDb.dText
  !defDbRText = !this.defDb.rText
  do !i indices !curSel

    -- Get the positions
    !curPos    = !curSel[!i]
    !defPos    = !defSel[!i]

    -- Get the dbRefs
    !curdbRef  = !this.curDb.rText[!curPos].dbRef()
    handle any
      skip
    endhandle
    !defDbRef  = !this.defDb.rText[!defPos].dbRef()
    handle any
      skip
    endhandle

    -- Insert deferred database in current list
    !this.curDbAdd(!defDbRef, !curPos)
    !curDbDText.insert(!curPos, !this.defDb.dText[!defSel[!i]])
    !curDbRText.insert(!curPos, !this.defDb.rText[!defSel[!i]])

    -- Insert current database in deferred list
    !this.defDbAdd(!curDbRef, !defPos)
    !defDbDText.insert(!defPos, !this.curDb.dText[!curSel[!i]])
    !defDbRText.insert(!defPos, !this.curDb.rText[!curSel[!i]])

    -- Remove database for current list
    !this.curDbRem(!curDbRef)
    !curDbDText.remove(!curSel[!i] + 1)
    !curDbRText.remove(!curSel[!i] + 1)

    -- Remove database for deferred list
    !this.defDbRem(!defDbRef)
    !defDbDText.remove(!defSel[!i] + 1)
    !defDbRText.remove(!defSel[!i] + 1)

  enddo
  !this.curDb.dText = !curDbDText
  !this.curDb.rText = !curDbRText
  !this.defDb.dText = !defDbDText
  !this.defDb.rText = !defDbRText

  if (!this.reCompose.val) then
    !this.reCompose('CURDEF')
  else
    -- Set the update required member
    !this.updateRequired = true
  endif

endmethod
-- End of method definition for .curDefEx()

------------------------------------------------------------------------
--
--Method: .curProj()
--
-- Description: remove the select current databases from the MDB
-- definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .curProj()

  -- Initialise variables
  !curSel       = !this.curDb.val
  !neededCurSel = !this.curDb.val
  !remCurSel    = !neededCurSel.sort().invert()
  !pos          = !this.projDbs.dText.size() + 1

  -- Check that some values are selected
  if (!curSel.size() eq 0) then
    return
  endif

  -- Process the selection of current databases
  !tempDText = !this.projDbs.dText
  !tempRText = !this.projDbs.rText
  do !i indices !curSel

    !dbRef        = !this.curDb.rText[!curSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Insert databases into database gadget list
    !tempDText.insert(!pos, !this.curDb.dText[!curSel[!i]])
    !tempRText.insert(!pos, !this.curDb.rText[!curSel[!i]])

    -- Increment the position
    !pos          = !pos + 1

  enddo
  !this.projDbs.dText = !tempDText
  !this.projDbs.rText = !tempRText

  -- Process the selection of current databases
  !curDbDText = !this.curDb.dText
  !curDbRText = !this.curDb.rText
  do !i indices !curSel

    !dbRef        = !this.curDb.rText[!remCurSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Remove the databases from the Current Dbs list
    !this.curDbRem(!dbRef)
    !curDbDText.remove(!remCurSel[!i])
    !curDbRText.remove(!remCurSel[!i])

  enddo
  !this.curDb.dText = !curDbDText
  !this.curDb.rText = !curDbRText

  if (!this.filter.val.trim() neq '*') then
    -- Filter the selections being sent to the projDb list
    !arrayProjDbRefs = ARRAY()
    !arrayOfIndices = ARRAY()
    !dText = ARRAY()
    !rText = ARRAY()
    -- get an array of dbRefs for project dbs
    do !i indices !this.projDbs.rText
      !arrayProjDbRefs[!i] = !this.projDbs.rText[!i].dbRef()
    enddo
    !displayRefs = !!adminFilterSort(!arrayProjDbRefs, !this.sort, !this.filter)
    -- Only display the filtered ones
    do !i indices !displayRefs
      !arrayOfIndices[!i] = !this.projDbs.rText.findFirst(!displayRefs[!i].string())
    enddo
    -- Now we have an array of indices we can display just those lines
    do !i indices !arrayOfIndices
      !dText[!i] = !this.projDbs.dText[!arrayOfIndices[!i]]
      !rText[!i] = !this.projDbs.rText[!arrayOfIndices[!i]]
    enddo
    -- Set the detail and return text
    !this.projDbs.dText = !dText
    !this.projDbs.rText = !rText
  endif

  if (!this.reCompose.val) then
    !this.reCompose('PROJCUR')
  else
    -- Set the update required member
    !this.updateRequired = true
  endif

endmethod
-- End of method definition for .curProj()

------------------------------------------------------------------------
--
--Method: .defCur()
--
-- Description: make the selected Deferred databases current in the
-- MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defCur()

  -- Initialise variables
  !defSel       = !this.defDb.val
  !neededDefSel = !this.defDb.val
  !remDefSel    = !neededDefSel.sort().invert()
  !currSel      = !this.curDb.val
  !currDbs      = !this.curDb.rText
  --!currDbs      = !this.curDbGet()
  !curCount     = !currDbs.size()
  !insert       = !this.insCur.selection('rtext')

  -- Check that Project Databases have been selected
  if (!defSel.size() eq 0) then
    return
  endif

  -- Check that insertion would not exceed 1000 limit
  if (!curCount + !defSel.size() gt 1000) then
    -- Raise error
    !!messageFile.error(141, 220)
    return
  endif

  -- Check that only one current database has been selected
  if (!currSel.size() gt 1) then
    -- Raise an error
    !!messageFile.error(141, 217)
    return
  endif

  -- Get the list position to insert at
  if (!insert eq 'BEF') then

    if (!currSel.size() eq 0 or !currSel[1] eq 1) then
      !pos        = 1
    else
      !pos        = !currSel[1]
    endif

  elseif (!insert eq 'AFT') then

    if (!currSel.size() eq 0) then
      !pos        = !currDbs.size() + 1
    else
      !pos        = !currSel[1] + 1
    endif

  endif

  -- Process the selection of deferred databases
  !tempDText = !this.curDb.dText
  !tempRText = !this.curDb.rText
  do !i indices !defSel

    !dbRef        = !this.defDb.rText[!defSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Insert new databases into current list and current gadget list
    !this.curDbAdd(!dbRef, !pos)
    !tempDText.insert(!pos, !this.defDb.dText[!defSel[!i]])
    !tempRText.insert(!pos, !this.defDb.rText[!defSel[!i]])

    -- Increment the position
    !pos          = !pos + 1

  enddo
  !this.curDb.dText = !tempDText
  !this.curDb.rText = !tempRText


  -- Process the selection of deferred databases
  !defDbDText = !this.defDb.dText
  !defDbRText = !this.defDb.rText
  do !i indices !defSel

    !dbRef        = !this.defDb.rText[!remDefSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Remove the databases from the deferred Dbs list
    !this.defDbRem(!dbRef)
    !defDbDText.remove(!remDefSel[!i])
    !defDbRText.remove(!remDefSel[!i])

  enddo
  !this.defDb.dText = !defDbDText
  !this.defDb.rText = !defDbRText

  if (!this.reCompose.val) then
    !this.reCompose('CURDEF')
  else
    -- Set the update required member
    !this.updateRequired = true
  endif

endmethod
-- End of method definition for .defCur()

------------------------------------------------------------------------
--
--Method: .defDbAdd()
--
-- Description: add a database to the defArray array in the MDB
-- definition form. The database is to be inserted at the position
-- supplied.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defDbAdd(!dbRef is DBREF, !pos is REAL)

  -- Insert the value
  !this.defArray.insert(!pos,!dbRef)

  -- Compress the array
  !this.defArray.compress()

endmethod
-- End of method definition for .defDbAdd(DBREF, REAL)

------------------------------------------------------------------------
--
--Method: .defDbGet()
--
-- Description: return an array of the current MDB's deferred databases.
-- Applicable to the current MDB in the MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of databases deferred in MDB.
--
------------------------------------------------------------------------

define method .defDbGet() is ARRAY

  -- Return the value
  return !this.defArray

endmethod
-- End of method definition for .defDbGet() ARRAY

------------------------------------------------------------------------
--
--Method: .defDbList()
--
-- Description: control the contents on the Deferred Database
-- list gadget in the Multiple Database definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of deferred databases
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defDbList(!dbArray is ARRAY)

  if(!!glbIsGlobal())then
    !wrtLoc = !!adminApplic.getAdmContext()
  else
    !wrtLoc = object DBREF()
  endif

  !dbList = object ADMTEXTLIST()
  !dbList.addDbs(!dbArray, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(), !this.defDb, !wrtLoc)

endmethod
-- End of method definition for .defDbList(ARRAY)

------------------------------------------------------------------------
--
--Method: .defDbRem()
--
-- Description: remove a database from the array of deferred database)
-- used by the MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       dbRef to be removed from defArray member.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defDbRem(!dbRef is DBREF)

  -- Find the position in the array
  !pos  = !this.defArray.findFirst(!dbRef)

  -- Check the position was valid
  if (!pos.set()) then

    -- Remove the entry
    !this.defArray.remove(!pos)

  endif

endmethod
-- End of method definition for .defDbRem(DBREF)

------------------------------------------------------------------------
--
--Method: .defDbSet()
--
-- Description: set the array of deferred databases for the MDB that
-- is being defined in the MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defDbSet()

  -- Initialise variables
  !currentDbPos     = !!ce
  !dbRef            = !this.refGet()

  -- Set an empty array for an unset dbRef
  if (!dbRef.badRef()) then

    !databases        = ARRAY()

  else

    !!ce              = !dbRef
    !curDb            = CURDB
    !allDb            = !!ce.dbls
    !databases        = !allDb.difference(!curDb)

  endif

  -- Store the value
  !this.defArray = !databases

  -- Restore the database position
  !!ce              = !currentDbPos

endmethod
-- End of method definition for .defDbSet()

------------------------------------------------------------------------
--
--Method: .defProj()
--
-- Description: remove the select deferred databases from the MDB
-- definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defProj()

  -- Initialise variables
  !defSel       = !this.defDb.val
  !neededDefSel = !this.defDb.val
  !remDefSel    = !neededDefSel.sort().invert()
  !pos          = !this.projDbs.dText.size() + 1

  -- Check that some values are selected
  if (!defSel.size() eq 0) then
    return
  endif

  -- Process the selection of deferred databases
  !tempDText = !this.projDbs.dText
  !tempRText = !this.projDbs.rText
  do !i indices !defSel

    !dbRef        = !this.defDb.rText[!defSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Insert databases into database gadget list
    !tempDText.insert(!pos, !this.defDb.dText[!defSel[!i]])
    !tempRText.insert(!pos, !this.defDb.rText[!defSel[!i]])

    -- Increment the position
    !pos          = !pos + 1

  enddo
  !this.projDbs.dText = !tempDText
  !this.projDbs.rText = !tempRText

  -- Process the selection of deferred databases
  !defDbDText = !this.defDb.dText
  !defDbRText = !this.defDb.rText
  do !i indices !defSel

    !dbRef        = !this.defDb.rText[!remDefSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Remove the databases from the Deferred Dbs list
    !this.defDbRem(!dbRef)
    !defDbDText.remove(!remDefSel[!i])
    !defDbRText.remove(!remDefSel[!i])

  enddo
  !this.defDb.dText = !defDbDText
  !this.defDb.rText = !defDbRText

  if (!this.filter.val.trim() neq '*') then
    -- Filter the selections being sent to the projDb list
    !arrayProjDbRefs = ARRAY()
    !arrayOfIndices = ARRAY()
    !dText = ARRAY()
    !rText = ARRAY()
    -- get an array of dbRefs for project dbs
    do !i indices !this.projDbs.rText
      !arrayProjDbRefs[!i] = !this.projDbs.rText[!i].dbRef()
    enddo
    !displayRefs = !!adminFilterSort(!arrayProjDbRefs, !this.sort, !this.filter)
    -- Only display the filtered ones
    do !i indices !displayRefs
      !arrayOfIndices[!i] = !this.projDbs.rText.findFirst(!displayRefs[!i].string())
    enddo
    -- Now we have an array of indices we can display just those lines
    do !i indices !arrayOfIndices
      !dText[!i] = !this.projDbs.dText[!arrayOfIndices[!i]]
      !rText[!i] = !this.projDbs.rText[!arrayOfIndices[!i]]
    enddo
    -- Set the detail and return text
    !this.projDbs.dText = !dText
    !this.projDbs.rText = !rText
  endif

  if (!this.reCompose.val) then
    !this.reCompose('PROJDEF')
  else
    -- Set the update required member
    !this.updateRequired = true
  endif

endmethod
-- End of method definition for .defProj()

------------------------------------------------------------------------
--
--Method: .display()
--
-- Description: setup the MDB creation and modification form for displaying.
-- method to become a method !this.display(string MODE).
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display form in.(CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display(!mode is STRING)

  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY') then

    -- Invalid mode

  endif

  -- Make sure admMdb form is loaded

  if (Undefined (!!admMdb)) then
     !!loadForm ('admMdb')
  endif

  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then

    !this.refSet(object DBREF())

  elseif (!mode eq 'MODIFY') then

    -- Get the current MDB from
    !dbRef    = !!adminElem.mdbGet()
    if (!dbRef.unset()) then
      -- No action required
      return
    elseif (!dbRef eq !this.refGet() and !this.shown()) then
      -- No action required
      return
    elseif (!dbRef.badRef()) then
      -- Raise an error
      !!messageFile.error(141, 203, !dbRef.string())
      handle (06, 203)
        !!adminElem.update('MDB')
        return
      endhandle
    endif

    -- Set the new reference to modify
    !this.refSet(!dbRef)

  endif

  -- Select the mode
  !this.modeSet(!mode.upcase())

  -- Show or update the form
  if (!this.shown()) then

    -- Re-Initialise the form
    !this.init()

  else

    -- Show the form
    show !!admMdb free

  endif

endmethod
-- End of method definition for .display(STRING)

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: initialise the MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Initialise variables
  !mode     = !this.modeGet()
  !dbRef    = !this.refGet()
  -- Initialise members
  !this.updateRequired = false

  -- Reinstate sort and filter values
  if (!this.filterVal.set()) then
    !this.filter.val = !this.filterVal
  endif
  if (!this.sortVal.set()) then
    !this.sort.select('rtext',!this.sortVal)
  endif

  -- Actions depend upon mode
  if (!mode eq 'CREATE') then

    !this.formTitle      = |Create Multiple Database|
    !this.name.val       = |unset|
    !this.desc.val       = |unset|

  elseif (!mode eq 'MODIFY') then

    !this.formTitle      = |Modify Multiple Database: |+ !dbRef.name.substring(2)
    !this.name.val       = !dbRef.name.substring(2)
    if (!dbRef.description.empty()) then
      !this.desc.val       = |unset|
    else
      !this.desc.val       = !dbRef.description
    endif

  endif

  -- Display a message
  !!messageFile.prompt(141, 004, !this.formTitle, 'MDB')

  -- Set the database information
  !this.projDbSet()
  !this.curDbSet()
  !this.defDbSet()

  -- Get the database information
  !currDbs       = !this.curDbGet()
  !defDbs       = !this.defDbGet()

  -- Update the project database list
  !this.projDbList()

  -- Update the current database list
  !this.curDbList(!currDbs)

  -- Update the deferred database list
  !this.defDbList(!defDbs)

  -- Dismiss the prompt
  call !!prompt(0)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
--Method: .mode()
--
-- Description: Callback to the Mode gadget in the MDB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .mode()

  -- Read the mode value
  !mode    = !this.modeGet()

  -- Call the display method to reset the form
  !this.display(!mode)

endmethod
-- End of method definition for .mode()

------------------------------------------------------------------------
--
--Method: .modeGet()
--
-- Description: return the current mode of the MDB definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Mode of form
--
------------------------------------------------------------------------

define method .modeGet() is STRING

  if (Undefined (!!admMdb)) then
     !!loadForm ('admMdb')
  endif

  -- Return the current mode
  return  !this.mode.selection('rtext')

endmethod
-- End of method definition for .modeGet() STRING

------------------------------------------------------------------------
--
--Method: .modeSet()
--
-- Description: set the mode of the this form
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to set (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .modeSet(!mode is STRING)

  -- Set the mode gadget
  !this.mode.select('rtext',!mode.upcase())
  handle any
    -- Dummy handle (should not happen)
  endhandle

endmethod
-- End of method definition for .modeSet(STRING)

------------------------------------------------------------------------
--
--Method: .cbName()
--
-- Description: act as a callback to the MDB Definition form name
-- gadget. Checks user input for a name that already exists.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbName(!gadget is GADGET)

  -- Initialise variables
  !dbRef   = !this.refGet()

  -- Call the admin MDB name check routine
  !!admChkMdbName(!gadget, !dbRef)
  handle any
    !!alert.error(!!error.text)
  endhandle

endmethod
-- End of method definition for .cbName(GADGET)

------------------------------------------------------------------------
--
--Method: .projCur()
--
-- Description: make the selected Project databases current in the
-- MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .projCur()

  -- Initialise variables
  !projSel        = !this.projDbs.val
  !neededProjSel  = !this.projDbs.val
  !remProjSel     = !neededProjSel.sort().invert()
  !currSel        = !this.curDb.val
  !currDbs        = !this.curDb.rText
  !defDbs         = !this.defDb.rText
  --!currDbs      = !this.curDbGet()
  --!defDbs       = !this.defDbGet()
  !curCount       = !currDbs.size()
  !dbCount        = !currDbs.size() + !defDbs.size()
  !insert         = !this.insCur.selection('rtext')

  -- Check that Project Databases have been selected
  if (!projSel.size() eq 0) then
    return
  endif

  -- Check that insertion would not exceed 1000 limit
  if (!curCount + !projSel.size() gt 1000) then
    -- Raise error
    !!messageFile.error(141, 220)
    return
  endif

  -- Check that insertion would not exceed the 1000 limit
  if (!dbCount + !projSel.size() gt 1000) then
    -- Raise error
    !!messageFile.error(141, 220)
  endif

  -- Check that only one current database has been selected
  if (!currSel.size() gt 1) then
    -- Raise an error
    !!messageFile.error(141, 217)
    return
  endif

  -- Get the list position to insert at
  if (!insert eq 'BEF') then

    if (!currSel.size() eq 0 or !currSel[1] eq 1) then
      !pos        = 1
    else
      !pos        = !currSel[1]
    endif

  elseif (!insert eq 'AFT') then

    if (!currSel.size() eq 0) then
      !pos        = !currDbs.size() + 1
    else
      !pos        = !currSel[1] + 1
    endif

  endif

  -- Process the selection of project databases
  -- check that there are no duplicate DBNO's
  !dbList = !this.chkAllDbNo( !this.projDbs.selection() )

  if( !dbList.empty() ) then
    return
  endif

  -- Process the selection of project databases
  !tempDText = !this.curDb.dText
  !tempRText = !this.curDb.rText
  do !i indices !projSel

    !dbRef        = !this.projDbs.rText[!projSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Insert new databases into current list and current gadget list
    !this.curDbAdd(!dbRef, !pos)
    !tempDText.insert(!pos, !this.projDbs.dText[!projSel[!i]])
    !tempRText.insert(!pos, !this.projDbs.rText[!projSel[!i]])

    -- Increment the position
    !pos          = !pos + 1

  enddo
  !this.curDb.dText = !tempDText
  !this.curDb.rText = !tempRText

  -- Process the selection of project databases
  !projDbDText = !this.projDbs.dText
  !projDbRText = !this.projDbs.rText
  do !i indices !projSel

    !dbRef        = !this.projDbs.rText[!remProjSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Remove the databases from the Project Dbs list
    !projDbDText.remove(!remProjSel[!i])
    !projDbRText.remove(!remProjSel[!i])

  enddo
  !this.projDbs.dText = !projDbDText
  !this.projDbs.rText = !projDbRText

  if (!this.reCompose.val) then
    !this.reCompose('PROJCUR')
  else
    -- Set the update required member
    !this.updateRequired = true
  endif

endmethod
-- End of method definition for .projCur()
------------------------------------------------------------------------
--
--Method: .projDbGet()
--
-- Description: return the array of project databases in use
-- by form !this. (Multiple Database definition).
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of dbRef of project databases
--
------------------------------------------------------------------------

define method .projDbGet() is ARRAY

  -- Return the value
  return  !this.dbArray

endmethod
-- End of method definition for .projDbGet() ARRAY

------------------------------------------------------------------------
--
--Method: .projDbList()
--
-- Description: control the contents on the Project Databases
-- List gadget in the Multiple Database definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .projDbList()

  -- Initialise variables
  !projDbs      = !this.projDbGet()
  !currDbs      = !this.curDbGet()
  !defDbs       = !this.defDbGet()
  !mdbDatabases = ARRAY()
  !mdbDatabases.appendArray(!currDbs)
  !mdbDatabases.appendArray(!defDbs)
  !dbArray      = !projDbs.difference(!mdbDatabases)

  -- Save the sort and filter values for later use
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.filterVal = !this.filter.val
  !this.sortVal   = !this.sort.selection('rtext')

  -- Clear the list
  !this.projDbs.clear()

  -- Sort the list of databases
  !displayRefs = !!adminFilterSort(!dbArray,!this.sort,!this.filter)

  -- Display the list of databases
  call !!adminDbTxtList(!displayRefs, !this.projDbs, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(), object DBREF())

endmethod
-- End of method definition for .projDbList()

------------------------------------------------------------------------
--
--Method: .projDbSet()
--
-- Description: set the array of project databases for the form
-- !this. (Multiple database definition).
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .projDbSet()

  -- Initialise variables
  !databases       = ARRAY()
  !currentDbPos    = !!ce

  -- Where database are collected from
  -- depends on whether the project is global.
  !globalProject   = !!glbIsGlobal()
  if (!globalProject) then
     !hubStatus  = !!glbHubStatus(!globalProject)
  else
     !hubStatus  = false
  endif

  if (not !globalProject or (!hubStatus and CURLOC eq ADMLOC)) then

    -- Get database from the team world
    !!ce             = !!dbrAdminGetWorld('TEAM')
    !databases       = !!collectAllFor('DB','',!!ce)

  else

    -- Get databases from the locations DBALL attribute
    !!ce             = !!adminApplic.getAdmContext()
    !databases       = !!ce.dbAll

  endif

  -- Assign the value to its store
  !this.dbArray = !databases

  -- Return to the database position
  !!ce             = !currentDbPos

endmethod
-- End of method definition for .projDbSet()

------------------------------------------------------------------------
--
--Method: .projDef()
--
-- Description: make the selected Project databases defer in the
-- MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .projDef()

  -- Initialise variables
  !projSel        = !this.projDbs.val
  !neededProjSel  = !this.projDbs.val
  !remProjSel     = !neededProjSel.sort().invert()
  !defSel         = !this.defDb.val
  !currDbs        = !this.curDb.rText
  !defDbs         = !this.defDb.rText
  --!currDbs        = !this.curDbGet()
  --!defDbs         = !this.defDbGet()
  !countDb        = !currDbs.size() + !defDbs.size()
  !insert         = !this.insDef.selection('rtext')

  -- Check that Project Databases have been selected
  if (!projSel.size() eq 0) then
    return
  endif

  -- Check that insertion would not exceed 1000 limit
  if (!countDb + !projSel.size() gt 1000) then
    -- Raise error
    !!messageFile.error(141, 220)
    return
  endif

  -- Check that only one deferred database has been selected
  if (!defSel.size() gt 1) then
    -- Raise an error
    !!messageFile.error(141, 218)
    return
  endif

  -- Get the list position to insert at
  if (!insert eq 'BEF') then

    if (!defSel.size() eq 0 or !defSel[1] eq 1) then
      !pos        = 1
    else
      !pos        = !defSel[1]
    endif

  elseif (!insert eq 'AFT') then

    if (!defSel.size() eq 0) then
      !pos        = !defDbs.size() + 1
    else
      !pos        = !defSel[1] + 1
    endif

  endif

  -- check that there are no duplicate DBNO's
  !dbList = !this.chkAllDbNo( !this.projDbs.selection() )

  if( !dbList.empty() ) then
    return
  endif

  -- Process the selection of project databases
  !tempDText = !this.defDb.dText
  !tempRText = !this.defDb.rText
  do !i indices !projSel

    !dbRef        = !this.projDbs.rText[!projSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Insert new databases into deferred list and deferred gadget list
    !this.defDbAdd(!dbRef, !pos)
    !tempDText.insert(!pos, !this.projDbs.dText[!projSel[!i]])
    !tempRText.insert(!pos, !this.projDbs.rText[!projSel[!i]])

    -- Increment the position
    !pos          = !pos + 1

  enddo
  !this.defDb.dText = !tempDText
  !this.defDb.rText = !tempRText

  -- Process the selection of project databases
  !projDbDText = !this.projDbs.dText
  !projDbRText = !this.projDbs.rText
  do !i indices !projSel

    !dbRef        = !this.projDbs.rText[!remProjSel[!i]].dbRef()
    handle any
      -- Skip bad references
      skip
    endhandle

    -- Remove the databases from the Project Dbs list
    !projDbDText.remove(!remProjSel[!i])
    !projDbRText.remove(!remProjSel[!i])

  enddo
  !this.projDbs.dText = !projDbDText
  !this.projDbs.rText = !projDbRText

  if (!this.reCompose.val) then
    !this.reCompose('PROJDEF')
  else
    -- Set the update required member
    !this.updateRequired = true
  endif

endmethod
-- End of method definition for .projDef()

------------------------------------------------------------------------
--
--Method: .refGet()
--
-- Description: return the current MDB dbRef for the element
-- being edited.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       dbRef of MDB being created or modified
--
------------------------------------------------------------------------

define method .refGet() is DBREF

  -- Return the dbRef
  return  !this.dbRef

endmethod
-- End of method definition for .refGet() DBREF

------------------------------------------------------------------------
--
--Method: .refresh()
--
-- Description: refresh the DB elements listed in the list gadgets
-- in the MDB Definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refresh()

  -- Return if the form is not shown
  if (Undefined (!!admMdb) or not !this.shown()) then
    return
  endif

  -- Display a message
  !!messageFile.prompt(141, 004, !this.formTitle, 'DB')

  -- Update the project databases
  !this.projDbSet()

    -- Get the database information
  !currDbs      = !this.curDbGet()
  !defDbs       = !this.defDbGet()

  -- Update the project database list
  !this.projDbList()

  -- Update the current database list
  !this.curDbList(!currDbs)

  -- Update the deferred database list
  !this.defDbList(!defDbs)

  -- Dismiss the prompt
  !!prompt(0)

endmethod
-- End of method definition for .refresh()

------------------------------------------------------------------------
--
--Method: .refSet()
--
-- Description: set the current dbRef of the MDB that is being
-- created or modified.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     DBREF       dbRef of current MDB (can be unset)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refSet(!dbRef is DBREF)

  -- Set the dbRef
  !this.dbRef  = !dbRef

endmethod
-- End of method definition for .refSet(DBREF)

------------------------------------------------------------------------
--
--Method: .update()
--
-- Description: update the displayed MDB in the MDB definition form. The
-- form must be displayed and in modify mode.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- Initialise variables
  !mode     = !this.modeGet()
  !selMdb   = !!adminElem.mdbGet()
  !curMdb   = !this.refGet()

  -- Return if the form is not shown
  if (!this.shown().not()) then
    return
  endif

  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif

  -- Return if both references are the same
  if (!selMdb eq !curMdb) then
    return
  endif

  -- Re-initialise the form
  !this.refSet(!selMdb)
  !this.init()

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
--Method: .chkDbNo()
--
-- Description: check that a database being added to the current MDB
-- does not have a copy of the database already in the MDB.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       dbRef to be added to MDB.
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if DBNO exists in MDB
--
------------------------------------------------------------------------

define method .chkDbNo(!dbRef is DBREF) is BOOLEAN

  -- Initialise variables
  !databases     = !this.curDbGet()
  !databases.appendArray(!this.defDbGet())
  !numbBlock     = object BLOCK('!databases[!evalIndex].dbNo')
  -- !numbBlock     = object BLOCK('!databases[!evalIndex].dbNo.string()') try this if above line has parameter mismatch

  -- Check for dbno in array
  !pos           = !databases.evaluate(!numbBlock).findFirst(!dbRef.dbNo)

  if (!pos.unset()) then
    -- Database number not found
    return false
  else
    -- Database number found
    return true
  endif

endmethod
-- End of method definition for .chkDbNo(DBREF) BOOLEAN

------------------------------------------------------------------------
--
--Method: .chkAllDbNo()
--
-- Description: check that all databases being added to the current MDB
-- have a unique DBNO (i.e. there are no copies or extracts with duplicate DBNO).
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      Array of string dbRef's of DB's to be added to MDB.
-- Return:
--   [Data Type] [Description]
--    ARRAY      Array of string dbRefS of DB's that can be added to the MDB
--
------------------------------------------------------------------------

define method .chkAllDbNo(!dbRefs is ARRAY) is ARRAY

  var !dbListNumbers EVALUATE DBNO FOR ALL FROM !dbRefs IGNORE ANY
  !uniqueNumbers = !dbListNumbers
  !uniqueNumbers.unique()

  if( !uniqueNumbers.size() ne !dbListNumbers.size() ) then
    !!alert.error(|There are databases with the same database number in the selected list (copy DB's or extracts). You may not add more than one database with the same database number to an MDB. Please reselect the databases.|)
    return object ARRAY()
  endif

  -- Initialise variables
  --!databases     = !this.curDbGet()
  !databases     = !this.curDb.rText
  --!databases.appendArray(!this.defDbGet())
  !databases.appendArray(!this.defDb.rText)
  -- check that there are no duplicate DBNO's in either the selected list or the target lists

  !numbBlock     = object BLOCK('!databases[!evalIndex].dbRef().dbNo.string()')
  !numbersInUse  = !databases.evaluate(!numbBlock)

  -- test for any overlap in the numbers
  !foundDuplicate = false
  !returnArray    = ARRAY()
  do !i indices !dbListNumbers
    if( !numbersInUse.findFirst(!uniqueNumbers[!i]).set() ) then
      !foundDuplicate = true
    else
      !returnArray.append(!dbRefs[!i])
    endif
  enddo

  if( !foundDuplicate ) then
    -- there is a DBNO number overlap
    !!alert.error(|The MDB already contains databases with the same database number as at least one of those selected.|)
    return object ARRAY()
  endif

  return !returnArray

endmethod
-- End of method definition for .chkAllDbNo(DBREF) BOOLEAN

------------------------------------------------------------------------
--
--Method: .reCompose()
--
-- Description: rebuild the 3 list gadgets
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       This can be all, curDef, projCur, projDef or switch
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reCompose(!option is STRING)

  !test = false
  if (!option.upcase() eq 'SWITCH' and !this.reCompose.val) then
    !test = true
    !this.now.active = !this.reCompose.val.not()
  else
    !test = false
    !this.now.active = !this.reCompose.val.not()
  endif

  if (!option.upcase() eq 'ALL' or !option.upcase() eq 'PROJCUR' or !option.upcase() eq 'CURDEF' or !test) then
    -- Update the current database list
    !this.curDbList(!this.curDbGet())
  endif

  if (!option.upcase() eq 'ALL' or !option.upcase() eq 'PROJDEF' or !option.upcase() eq 'CURDEF' or !test) then
    -- Update the deferred database list
    !this.defDbList(!this.defDbGet())
  endif

  if (!option.upcase() eq 'ALL' or !option.upcase() eq 'PROJCUR' or !option.upcase() eq 'PROJDEF' or !test) then
    -- Update the project database list
    !this.projDbList()
  endif

  if (!option.upcase() eq 'ALL' or !test) then
    -- Set the update required member
    !this.updateRequired = false
  else
    -- Set the update required member
    !this.updateRequired = true
  endif

endmethod
-- End of method definition for .reCompose()
