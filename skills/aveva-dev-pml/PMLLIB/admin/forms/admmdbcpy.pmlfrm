--
-- Description:
-- Form definition to provide facilities to copy MDB elements.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!admMdbCpy

-- Define form
setup form !!admMdbCpy at xr 0.35 yr 0.1

  !!admMdbCpy.formTitle     = 'Copy MDB'
  !!admMdbCpy.iconTitle     = 'COPYMDB'
  !!admMdbCpy.callback      = 'call !!admMdbCpyInit()'
  !!admMdbCpy.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  text .name at x 0 y 0 |To MDB     | call |call !!admMdbCpyName()| width 30 NAME
  text .desc at xmin ymax+0.2 |Description| width 30 scroll 120 STRING

  button .ok at xmin.name ymax+0.5 |  OK  | call |call !!admMdbCpy()| OK
  button .cancel at xmax form-size ymin |Cancel| CANCEL

  -- Member definitions
    -- Source user Dbref
    member .dbRef is DBREF


exit
-- End of form definition for !!admMdbCpy
