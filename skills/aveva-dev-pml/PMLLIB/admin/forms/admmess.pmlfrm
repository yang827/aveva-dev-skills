--
-- Author:          E.conba
-- Created:         Thu Jul 3 11:37:56 BST 1997
--
--
-- Description:
-- Form definition to allow sending of PDMS messages.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admMess()                        -                   constructor
--  apply()                          -                   apply the form
--  init()                           -                   initialise thr form
--  list()                           -                   redo list
--  type()                           -                   Callback function to a user selection of a type of message.
--
------------------------------------------------------------------------

-- Define form
setup form !!admMess

  !this.formTitle     = 'Send message'
  !this.iconTitle     = 'MESS'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.10 $ '

  -- Body of form definition
  frame .toFrame at x 0 y 0 |message To|

    option .toType at xmin+1 ymin+1 |Recipients| call |!this.type()| width 10
    list .to at xmin.toFrame+1 ymax+0.2 multiple columns width 40 height 10


    option .sort at xmin ymax+0.2 |Sort By | call |!this.list()| width 11
    text .filter at xmax+0.2 ymin |Filter|   call |!this.list()| width 10 string

  exit

  -- Add location frame if this is a global project
  if (!!glbIsGlobal()) then

    frame .locFrame at x 0 ymax+0.5 |Project Locations|

    list .locn at xmin.locFrame+1 ymax+0.2 multiple columns width 40 height 7

    exit

  endif

  text .message at xmin ymax+0.5 |message| width 35 scroll 80 STRING

  button .send at xmin.toFrame ymax+0.5 | Send | call |!this.apply()|  APPLY
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  -- Form member definitions
  member .onLine    is BOOLEAN
  -- Preserve selected type
  member .typeVal   is STRING
  -- Preserve sort and filter values
  member .sortVal   is STRING
  member .filterVal is STRING

exit
-- End of form definition
------------------------------------------------------------------------
--
--Method: .admMess()
--
-- Description: constructor
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .admMess()

-- Initialise variables
  !dtext          = ARRAY()
  !rtext          = ARRAY()
  !onLineLocn     = false
  !this.onLine    = false
  !globalProject  = !!glbIsGlobal()

-- Set variable for connected locations
  if (!globalProject) then
    /*S
    !onLineLocn     = !!ce.locrf.iconn.boolean()
  endif

  !menu = !this.newMenu('clearTop')
  !menu.add(|callback|, |Clear Selection|,  |!this.to.clearSelection()|)
  !menu.add(|callback|, |Select All|,  |!this.to.select('rtext',!this.to.rtext)|)

  !this.to.setPopup(!this.clearTop)

  if (!globalProject) then
    !menu = !this.newMenu('clearList')
    !menu.add(|callback|, |Clear Selection|,  |!this.locn.clearSelection()|)
    !menu.add(|callback|, |Select All|,  |!this.locn.select('rtext',!this.locn.rtext)|)
    !menu.add(|callback|, |Select Current|, |!this.locn.clearSelection() !this.locn.select('rtext',!!adminApplic.statWorld.locrf.string())|)
    !this.locn.setPopup(!this.clearList)
  endif

  -- Assign values to recipient type
  !dtext.append(|Teams|)
  !dtext.append(|Users|)
  if (!onLineLocn) then
    !dtext.append(|Free Users|)
    !dtext.append(|Users At|)
  endif
  !this.toType.dtext = !dtext
  !dtext.clear()
  !rtext.append(|TEAM|)
  !rtext.append(|USER|)
  if (!onLineLocn) then
    !rtext.append(|FREEUSER|)
    !rtext.append(|ALL|)
  endif
  !this.toType.rtext = !rtext
  !rtext.clear()

  -- Set form member value
  if (!globalProject) then
    !this.onLine          = !onLineLocn
    !this.locn.active     = !onLineLocn
    !this.locFrame.active = !onLineLocn
  endif

endmethod
-- End of method .admMess()
------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: initialise thr form
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- Initialise variables
  !globalProject = !!glbIsGlobal()
  !locArray      = ARRAY()

  -- Initialise form gadgets
  !this.message.val  = ||

  -- Restore gadget values
  if (!this.typeVal.set()) then
    !this.toType.select('rtext', !this.typeVal)
  endif
  if (!this.sortVal.set()) then
    !this.sort.select('rtext', !this.sortVal)
    !this.filter.val = !this.filterVal
  endif

  -- If this is a global project collect locations
  if (!this.onLine) then

    -- Only initialise the list if this is an on-line location
    !current       = !!dbrGlbCurLocRf()

    -- Add on-line locations to the list
    !!ce           = !!dbrAdminGetWorld('LOC')
    !clause        = 'ICONN eq 1 and LINIT'
    !locations     = !!collectAllFor('LOC', !clause, !!ce)
    -- An uninitialised location can send messages but not receive them
    if( !current.linit.not() ) then
      !locations.append(!current)
      !!alert.warning('Warning - Current location is uninitialised')
    endif
    call !!adminLocnTxtList(!locations,!this.locn)

    -- Select the current location
    !locArray.append(!current.string())
    !this.locn.select('rtext',!locArray)

  endif

  -- Call function to initialise the list
  !this.type()

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
--Method: .type()
--
-- Description: Callback function to a user selection of a type of message.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .type()

  -- Initialise variables
  !group  = !this.toType.selection('rtext')

  -- Preserve the message type
  !this.typeVal  = !group

  -- Perform setup of form based on group
  if (!group eq |FREEUSER| or !group eq |ALL|) then

    !this.to.clear()
    !this.sort.active    = false
    !this.filter.active  = false

    if (!this.onLine) then
      !this.locn.active    = true
    endif

    !dtext = ARRAY()
    if (!group eq |FREEUSER|) then
      !dtext.append('All Free Users at the Selected Locations')
    elseif (!group eq |ALL|) then
      !dtext.append('All Users at the Selected Locations')
    endif
    !this.to.dtext = !dtext
    !this.to.val = 1
    !this.to.active = false

  elseif (!group eq |TEAM|) then

    -- Set-up form gadgets
    !this.to.clear()
    !this.to.active      = true
    !this.sort.active    = true
    !this.filter.active  = true

    if (!this.onLine) then
      !this.locn.active    = true
    endif

    -- Set sort gadget values
    call !!admTeamSortGadg(!this.sort)

    -- Set the filter gadget
    !this.filter.val     = |*|

    -- Collect all the project teams
    !current  = !!ce
    !!ce      = !!dbrAdminGetWorld('TEAM')
    !dbRefs   = !!collectAllFor('TEAM','',!!ce)
    !showRefs = !!adminFilterSort(!dbRefs,!this.sort,!this.filter)
    call !!adminTeamTxtList(!showRefs,!this.to,!!admdisplayconfig.fmtTeamGet(),!!admdisplayconfig.eleTypeGet())
    !!ce      = !current

  elseif (!group eq |USER|) then

    -- Set-up form gadgets
    !this.to.clear()
    !this.to.active      = true
    !this.sort.active    = true
    !this.filter.active  = true

    if (!this.onLine) then
      !this.locn.active    = false
      !this.locn.clearSelection()
      !this.locn.select('rtext',!!dbrGlbCurLocRf().string())
    endif

    -- Set sort gadget values
    call !!admUserSortGadg(!this.sort)

    -- Set the filter gadget
    !this.filter.val     = |*|

    -- Collect all the project users
    !current  = !!ce
    !!ce      = !!dbrAdminGetWorld('USER')
    !dbRefs   = !!collectAllFor('USER','',!!ce)
    !showRefs = !!adminFilterSort(!dbRefs,!this.sort,!this.filter)
    call !!adminUserTxtList(!showRefs,!this.to,!!admdisplayconfig.fmtUserGet(),!!admdisplayconfig.eleTypeGet())
    !!ce      = !current

  endif

endmethod
-- End of method .type()
------------------------------------------------------------------------
--
--Method: .list()
--
-- Description: redo list
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .list()

  -- Initialise variables
  !group    = !this.toType.selection('rtext')
  !current  = !!ce

  -- Preserve the sort and filter values
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.sortVal   = !this.sort.selection('rtext')
  !this.filterVal = !this.filter.val

  -- List elements by type
  if (!group eq 'TEAM') then

    -- Collect all the project teams
    !!ce      = !!dbrAdminGetWorld('TEAM')
    !dbRefs   = !!collectAllFor('TEAM','',!!ce)

    -- Display the values
    !showRefs = !!adminFilterSort(!dbRefs,!this.sort,!this.filter)
    call !!adminTeamTxtList(!showRefs,!this.to,!!admdisplayconfig.fmtTeamGet(),!!admdisplayconfig.eleTypeGet())

  elseif (!group eq |USER|) then

    -- Collect all the project users
    !!ce      = !!dbrAdminGetWorld('USER')
    !dbRefs   = !!collectAllFor('USER','',!!ce)

    -- Display the values
    !showRefs = !!adminFilterSort(!dbRefs,!this.sort,!this.filter)
    call !!adminUserTxtList(!showRefs,!this.to,!!admdisplayconfig.fmtUserGet(),!!admdisplayconfig.eleTypeGet())

  else

    -- Unset sort values
    !this.sortVal   = STRING()
    !this.filterVal = STRING()

  endif

  -- Restore the database position
  !!ce      = !current

endmethod
-- End method .list()

------------------------------------------------------------------------
--
-- Method: .apply()
--
-- Description: apply the form
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Initialise variables
  !group       = !this.toType.selection('rtext')
  !message     = !this.message.val
  !messCommand = ARRAY()
  !toList      = ARRAY()

  -- Check to see if user has set a message
  if (!message.empty()) then
    !!messagefile.error(141, 013)
  endif

  -- Perform actions based on group
  if (!group eq 'FREEUSER') then

    !toList.append('FREEUSER')

  elseif (!group eq 'ALL') then

    !toList.append('ALL')

  elseif (!group eq 'TEAM') then

    !teams       = !this.to.selection('rtext')
    !toList      = ARRAY()
    do !team values !teams
      -- Team names should not be in quotes
      !toList.append('TEAM ' + !team.dbref().name.substring(3))
    enddo


  elseif (!group eq 'USER') then

    !users       = !this.to.selection('rtext')
    !toList = ARRAY()
    do !user values !users
      !toList.append('USER |' + !user.dbref().name.substring(2) + '|')
    enddo

  endif

  -- Check to see that we have recipients
  if (!toList.unset()) then
    !!messagefile.error(141, 014)
  endif

  -- Check to see if we have selected locations (on-line only)
  if (!this.onLine) then
    !locations   = !this.locn.selection('rtext')
    if (!locations.unset()) then
      !!messagefile.error(141, 702)
    endif
  endif

  -- Build message Commands to send
  do !i indices !toList

    if (!this.onLine.not() or !group eq |USER|) then

      -- Standard or offline projects
      !messCommand.append('MESSAGE ' + !toList[!i] + ' |' + !message + '|')

    else

      -- Global On-line locations (global message system)
      do !j values !locations
        !messCommand.append('REMOTEMESSAGE '+!j.dbref().name+' '+!toList[!i]+' |'+!message+'|')
      enddo

    endif

  enddo

  -- Send the messages
  do !i indices !messCommand

    $!messCommand[$!i]
    handle (1,129)
        !!alert.error( !group + ' ' + !toList[!i].part(2) + ' is not currently in this project' )
      -- User XXX is not currently in project
--      !!messagefile.error(141, 325, !toList[!i].part(2))
    elsehandle (1,501)

      -- Cannot contact global daemon
      !!messagefile.error(141, 734)
      handle (06, 734)
        -- Dummy handle
      endhandle

    endhandle

  enddo

endmethod
-- End of method .apply()
