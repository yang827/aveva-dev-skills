-- File:            admmodadv.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Tue Nov 18 15:42:53 GMT 1997
--
--
-- Description:
-- Form definition for advanced module settings.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!admModAdv

-- Initialise variables
!dbTypes  = !!admTypeDbGet()
!gadget   = ARRAY()
!dText    = ARRAY()
!rText    = ARRAY()

-- Prepare mode gadget values
!dText.append(|Unset|)
!dText.append(|Read/Write|)
!dText.append(|Read Only|)
!dText.append(|None|)
!rText.append(|unset|)
!rText.append(|RW|)
!rText.append(|R|)
!rText.append(|N|)

-- Define form
setup form !!admModAdv

  !!admModAdv.formTitle     = 'Advanced Module Settings'
  !!admModAdv.iconTitle     = 'MOD ADV'
  !!admModAdv.callback      = 'call !!admModAdvInit()'
  !!admModAdv.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition
  paragraph .nameTx at x 0.1 y 0.1 text |Module :|
  paragraph .name at xmax+1 ymin width 20 line 1

  text .buffer at xmin.nameTx+1 ymax+0.2 |Buffer size  | width 12 INTEGER min 0

  frame .modeFrame at x 0 ymax |Database Modes|

    option .default at xmin+1 ymin+1 |Default Type | call |!!admModAdvDefault(_default)| width 12

    do !value values !dbTypes

      !gadget.append(|!!admModAdv.|+ !value.type)
      !title    = !value.description +|             |
      !title    = !title.substring(1,13)
      option _$!<value.type> at xmin ymax+0.2 |$!title| call |call !!admModAdvMode(_$!<value.type>, '$!<value.type>')| width 12
      _$!<value.type>.dText = !dText
      _$!<value.type>.rText = !rText

    enddo

  exit

  button .ok at xmin.modeFrame ymax+0.5 |Apply| call |call !!admModAdv()| APPLY
  button .reset at xmax+1 ymin |Reset| RESET
  button .cancel at xmax form-size ymin |Dismiss| CANCEL

  -- Member definitions
    -- Array of gadget names
    member .gadgets  is ARRAY

exit
-- End of form definition for !!admModAdv

-- Assign defaults gadgets value
call !!admTypeDbLoad(!!admModAdv.default)
!dText  = !!admModAdv.default.dText
!rText  = !!admModAdv.default.rText
!dText.append('Unset')
!rText.append('unset')
!!admModAdv.default.dText = !dText
!!admModAdv.default.rText = !rText

-- Save the gadget names
!!admModAdv.gadgets  = !gadget
