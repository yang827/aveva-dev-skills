--
-- Description:
-- Form definition for the Copy Module form.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!admModCpy

-- Define form
setup form !!admModCpy

  !!admModCpy.formTitle     = 'Copy Module'
  !!admModCpy.iconTitle     = 'CPY MOD'
  !!admModCpy.callback      = 'call !!admModCpyInit()'
  !!admModCpy.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  text .numb at x 0 y 0 |To Number| call |call !!admModCpyNumb(_numb)| width 5 INTEGER min 0
  text .name at xmin ymax+0.2 |Name     | call |call !!admModCpyName(_name)| width 30 NAME

  button .ok at xmin ymax+0.5 |  OK  | call |call !!admModCpy()| OK
  button .cancel at xmax form-size ymin |Cancel| CANCEL

  -- Member Definitions
    -- Module Dbref
    member .dbRef is DBREF

exit
-- End of form definition for !!admModCpy
