--
--
-- Description:
-- Form definition for the Module Definition form.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!admModDef

-- Initialise variables
!dText = ARRAY()
!rText = ARRAY()

-- Define form
setup form !!admModDef at xr 0.31 yr 0.1

  !!admModDef.formTitle     = 'Module Definition'
  !!admModDef.iconTitle     = 'MODDEF'
  !!admModDef.callback      = 'call !!admModDefInit()'
  !!admModDef.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  frame .moduleFrame at x 0 y 0 |Modules|

    list .module at xmin+1 ymin+1 call |call !!admModDefModSel()| columns width 45 height 10

    option .sort at xmin ymax |Sort By | call |call !!admModDefModList()| width 8
    button .copy at xmax+12 ymin |Copy...| form !!admModCpy
    button .delete at xmax+1 ymin |Delete| call |call !!admModDefDelete()|

  exit

  frame .setFrame at xmin ymax |Settings|

    paragraph .numbTx at xmin+1 ymin+1 text |Number :|
    paragraph .numb at xmax+1 ymin width 31 line 1
    paragraph .nameTx at xmin.numbTx ymax text |Name   :|
    paragraph .name at xmax+1 ymin width 10 line 1

    option .security at xmin.nameTx ymax+0.2 |Security | width 15

    text .runf at xmin.nameTx ymax+0.2 |Runfile  | call |call !!admModDefRunf(_runf)| width 30 STRING

    text .macro at xmin.runf ymax+0.2 |Imacro   | call |call !!admModDefMacro(_macro)| width 30 STRING
    button .macroBtn at xmax+0.5 ymin |Unset| call |_macro.val = 'unset'|
    button .advanced at xmin.macro+13 ymax+0.5 |Advanced Settings...| form !!admModAdv

  exit

  button .apply at xmin.setFrame ymax+0.5 |Apply| call |call !!admModDef()| APPLY
  button .reset at xmax+1 ymin |Reset| RESET
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  -- Member definitions
    -- Array of modules
    member .modArray is ARRAY
    -- Current Module
    member .modRef   is DBREF
    -- Preserve Sort gadget
    member .sortVal  is STRING

exit
-- End of form definition for !!admModDef

-- Assign Sort gadget values
!dText.append(|Name|)
!dText.append(|Number|)
!!admModDef.sort.dText  = !dText
!dText.clear()
!rText.append(|NAME|)
!rText.append(|NUMBER|)
!!admModDef.sort.rText  = !rText
!rText.clear()

-- Assign security gadget values
!dText.append(|General|)
!dText.append(|Restricted|)
!dText.append(|Free|)
!!admModDef.security.dText  = !dText
!dText.clear()
