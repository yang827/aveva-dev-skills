--
--
-- Description:
-- Permissible operations creation and Modification
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aAdd()                           -                   Adds text from Attribute textbox into Attribute list
--  activateAttrs(BOOLEAN)           -                   Switch hierarchy in/out toggle for current selection
--  addNewPerop(ADMPEROP)            BOOLEAN             add new PEROP to role
--  admPerop()                       -                   Constructor
--  allAttributes()                  -                   insert ALL word in attribute list regardless of what's already there
--  allElements()                    -                   insert ALL word in element list regardless of what's already there
--  cAdd(GADGET,GADGET,STRING)       BOOLEAN             Adds text from textbox into Gadget
--  cbApply()                        -                   Method to create and modify Perop elements.
--  cbMode()                         -                   Callback to the mode gadget in the Perop Definition form.
--  cbName(GADGET)                   -                   Method to act as a callback to the Name gadget in the Perop form.
--  checkCondition()                 -                   Callback to check validity of condition
--  display(STRING)                  -                   Method to display the Perop definition form.
--  eAdd()                           -                   Adds text from Element textbox into Element list
--  eclassSelect()                   -                   Switch hierarchy in/out toggle for current selection
--  elementHier()                    -                   Switch between element hierarchy in/out
--  init()                           -                   initialise form
--  modeGet()                        STRING              Function to return the current mode of the PEROP Definition form.
--  modeSet(STRING)                  -                   Method to set the mode of the PEROP Definition form.
--  modifyPerop(ADMPEROP,ADMPEROP)   -                   Modify an existing perop!
--  negAttributes()                  -                   Switch between attribute access allowed or disallowed
--  negElements()                    -                   Switch between element access allowed or disallowed
--  peropGet()                       ADMPEROP            A method to return the current role
--  peropSet(ADMPEROP)               -                   A method to set the current method
--  remove(GADGET)                   -                   remove item from a gadget list
--  setAclassTag()                   -                   Form message for aclass list
--  update()                         -                   method to update the displayed Perop in the Perop Definition
--
------------------------------------------------------------------------

setup form !!admPerop

  !this.formTitle     = 'Permissible Operation (Perop) Definition'
  !this.iconTitle     = 'PEROP'
  !this.callback      = '!!admPerop.init()'
  !this.formRevision  = ' $Revision: 1.25 $ '

  -- Body of form definition
  text   .name         at x 1 y 0.2 |Name | call |!this.cbName(!this.name)|  width 32 scroll 49 NAME
  option .mode         at xmax+10 ymin      call |!this.cbMode()| width 8
  frame  .elements     at  xmin.name ymax ' Elements '
    list   .eclass     |Apply operations to element types      | call |!this.eclassSelect()| width 42 height 7
    rgroup .negElement '' at xmax.eclass+1 ymin.eclass Horizontal call |!this.negElements()|
      add tag '+ ' select '+'
      add tag '-'  select '-'
    exit
    para   .text1      at xmax.eclass+0.5 ymin+1 text |Add Type| width 13 height 1
    text   .eNewClass  at xmax.eclass+0.5 ymax ||  call |!this.eAdd()| width 12 scroll 20 STRING
    toggle .eHierarchy at xmax.eclass+0.5 ymax |Hierarchy| call |!this.elementHier()|
    button .eAll       at xmin+.2 ymax+0.5 |All|   call |!this.allElements()|
    button .eRemove    at xmax+2 ymin     |Remove| call |!this.remove(!this.eclass)|
    text   .cond       at xmin.eclass ymax.eclass+0.2 |Qualifying Condition |  call |!this.checkCondition()| width 37 scroll 256 STRING
    para   .qualTag    at xmin ymax+0.2 text |Message to output if permission denied by this PEROP|
    text   .acrMes     at xmin ymax || width 59 scroll 120 STRING
  exit
  frame .operations  at x 2 ymax+0.2  | Operations |
    option .modify   at x 0.5 y 1             |Modify| call |!this.activateAttrs(!this.modify.selection('DTEXT').upcase() ne 'IGNORE')| width 8
    option .create   at xmax+1 ymin           |Create| width 8
    option .delete   at xmax+1 ymin           |Delete| width 8
    option .claim    at xmin.modify ymax+0.2  |Claim | width 8
    option .issue    at xmax+1 ymin           |Issue | width 8
    option .drop     at xmax+1 ymin           |Drop  | width 8
  exit
  frame  .attributes   at  xmin.elements ymax 'Attributes'
    list   .aclass |Allow changes to attributes               | width 42 height 7
    rgroup .negAttr '' at xmax.aclass+1 ymin.aclass Horizontal call |!this.negAttributes()|
      add tag '+ ' select '+'
      add tag '-'  select '-'
    exit
    para   .text2     at xmax.aclass+0.5 ymin+1 text |Add Attribute| width 13 height 1
    text   .aNewClass at xmax.aclass+0.5 ymax ||     call |!this.aAdd()| width 12 scroll 20 STRING
    button .aAll      at xmin+.2 ymax+0.5     |All|  call |!this.allAttributes()|
    button .aRemove   at xmax+2 ymin       |Remove|  call |!this.remove(!this.aclass)|
  exit
  button .apply       at x 0 ymax+0.5  |Apply| call |!this.cbApply()| APPLY
  button .reset       at xcen form-0.5 * size ymin  |Reset| RESET
  button .dismiss     at xmax form-size ymin |Dismiss| CANCEL


  --Member Definitions
  member .perop    is ADMPEROP
  member .eMess    is STRING
  member .eMessNot is STRING
  member .aMess    is STRING
  member .aMessNot is STRING

exit

------------------------------------------------------------------------
--
-- Method: .admPerop()
--
-- Description:Constructor
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
------------------------------------------------------------------------
define method .admPerop()

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  --- Assign Mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !this.mode.dText  = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !this.mode.rText  = !rText
  !rText.clear()

  !dText[1] = 'Ignore'
  !dText[2] = 'Allow'
  !dText[3] = 'Disallow'

  !this.modify.dText = !dText
  !this.create.dText = !dText
  !this.delete.dText = !dText
  !this.claim.dText  = !dText
  !this.issue.dText  = !dText
  !this.drop.dText   = !dText

  !this.eMess    = |Apply operations to element types      |
  !this.eMessNot = |Apply operations to all elements except|
  !this.aMess    = | changes to attributes            |
  !this.aMessNot = | changes to all attributes except |

endmethod
-- End of method definition for .admPerop()

------------------------------------------------------------------------
--
-- Method: .peropGet()
--
-- Description: A method to return the current role
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--  DBREF       The current Perop funnily enough!
------------------------------------------------------------------------
define method .peropGet() is ADMPEROP
  return !this.perop
endmethod
-- End of method definition for .peropGet() ADMPEROP
------------------------------------------------------------------------
--
-- Method: .peropSet()
--
-- Description: A method to set the current method
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R            DBREF       The role the current form is to be set to!
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .peropSet(!object is ADMPEROP)
  !this.perop = !object
endmethod
-- End of method definition for .peropSet(ADMPEROP)
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
  -- Initialise variables
  !mode    = !this.modeGet()
  !object   = !!admRole.peropGet()

    -- Check the current mode
  if (!mode eq 'CREATE') then

    -- Set the form title
    !this.formTitle    = 'Create Permissible Operation (Perop)'
    -- Set the form gadgets
    !this.name.val     = |unset|
    !this.eclass.clear()
    !this.aclass.clear()
    !this.cond.val     = |unset|
    !this.acrMes.val   = |unset|
    !this.modify.select('DTEXT','Ignore')
    !this.create.select('DTEXT','Ignore')
    !this.delete.select('DTEXT','Ignore')
    !this.claim.select('DTEXT','Ignore')
    !this.issue.select('DTEXT','Ignore')
    !this.drop.select('DTEXT','Ignore')
    !this.negAttr.select('+')
    !this.aclass.tag     = !this.aMess
    !this.negElement.select('+')
    !this.eclass.tag     = !this.eMess
    !this.eHierarchy.val = false
    !dText[1]            = 'ALL'
    !this.aclass.dText   = !dText
    !this.activateAttrs(false)

  elseif (!mode eq 'MODIFY') then

    -- Set the form title
    !this.formTitle    = 'Modify Permissible Operation (Perop): ' + !object.name.substring(2)
    -- Set the form gadgets
    !this.name.val     = !object.name.substring(2)
    !this.eclass.dText = !object.eclass
    !this.aclass.dText = !object.aclass
    !tempCond          = !object.cond.substring(1,!object.cond.length() -  1)
    !tempCond          = !tempCond.substring(2)
    !this.cond.val     = !tempCond.trim()
    !this.acrMes.val   = !object.acrMessage
    !this.modify.select('DTEXT',!object.modify)
    !this.activateAttrs(!object.modify.upcase() ne 'IGNORE')
    !this.create.select('DTEXT',!object.create)
    !this.delete.select('DTEXT',!object.delete)
    !this.claim.select('DTEXT',!object.claim)
    !this.issue.select('DTEXT',!object.issue)
    !this.drop.select('DTEXT',!object.drop)
    if(!object.aNot) then
      !this.negAttr.select('-')
      !this.setAclassTag()
    else
      !this.negAttr.select('+')
    endif
    !this.setAclassTag()
    if(!object.eNot) then
      !this.negElement.select('-')
      !this.eclass.tag   = !this.eMessNot
    else
      !this.negElement.select('+')
      !this.eclass.tag   = !this.eMess
    endif
    !this.eclassSelect()

  endif

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      .update()
--
-- Description: method to update the displayed Perop in the Perop Definition
-- form. The form must be displayed and in MODIFY mode.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .update()
  -- Return if the form is not shown
  if (undefined (!!admPerop) or !this.shown().not()) then
    return
  endif
  -- Initialise variables
  !mode    = !this.modeGet()
  !selLoc  = !!admRole.peropGet()
  !curLoc  = !this.peropGet()
  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif
  -- Return if the same reference
  if (!selLoc eq !curLoc) then
    return
  endif
  -- Reinitialise the form
  !this.peropSet(!selLoc)
  !this.init()

endmethod
-- End of method definition for .update()
------------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Method to display the Perop definition form.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display form in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display(!mode is STRING)
  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY' and !mode.upcase() neq 'VIEW') then
    -- Invalid mode
    return error 1 |Invalid mode for form !!admPerop|
  else
    if (!mode eq 'VIEW') then
      !this.mode.select('RTEXT', 'MODIFY')
      -- Inform user he can only view this form not apply it
      -- if (!this.shown().not()) then
        -- !!alert.message('You cannot modify the Perops, but you can view them. The Apply button will be greyed out.')
      -- endif
    else
      -- Make sure the form apply is active
      !this.apply.active = true
      !this.reset.active = true
      !this.mode.active = true
      !this.name.active = true
      !this.negElement.active = true
      !this.eNewClass.active = true
      !this.eHierarchy.active = true
      !this.eAll.active = true
      !this.eRemove.active = true
      !this.cond.active = true
      !this.acrMes.active = true
      !this.modify.active = true
      !this.create.active = true
      !this.delete.active = true
      !this.claim.active = true
      !this.issue.active = true
      !this.drop.active = true
      !this.negAttr.active = true
      !this.aNewClass.active = true
      !this.aAll.active = true
      !this.aRemove.active = true
    endif
  endif
  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then
    !this.peropSet(object ADMPEROP())
  elseif (!mode eq 'MODIFY') then
    !object   = !!admRole.peropGet()
    if (!object.unset()) then
      -- No action required
      return
    elseif (!object eq !this.peropGet()) then
      -- show the form
      -- modify
      !this.modeSet('MODIFY')
      show !!admPerop
      return
    endif
    -- Set the new locations
    !this.peropSet(!object)
  endif
  -- Select the mode (AK changed to save data to create another similar)
  !this.modeSet(!mode.upcase())
  if (!mode.upcase() eq 'CREATE') then
    -- create
    -- Set the form title
    !this.formTitle  = 'Create Permissible Operation (Perop)'
    --  clear the name
    !this.name.val   = |unset|
  else
    -- modify
    !this.init()
  endif

  -- Show the form
  --if(!this.shown() EQ FALSE)then
    show !!admPerop
  --endif

  -- If in view only mode then do not allow apply (DFN1626)
  if (!mode eq 'VIEW') then
    -- Make sure the form apply is inactive
    !this.apply.active = false
    !this.reset.active = false
    !this.mode.active = false
    !this.name.active = false
    !this.negElement.active = false
    !this.eNewClass.active = false
    !this.eHierarchy.active = false
    !this.eAll.active = false
    !this.eRemove.active = false
    !this.cond.active = false
    !this.acrMes.active = false
    !this.modify.active = false
    !this.create.active = false
    !this.delete.active = false
    !this.claim.active = false
    !this.issue.active = false
    !this.drop.active = false
    !this.negAttr.active = false
    !this.aNewClass.active = false
    !this.aAll.active = false
    !this.aRemove.active = false
    -- Set the form title

    !object   = !!admRole.peropGet()
    !this.formTitle    = 'View Permissible Operation (Perop): ' + !object.name.substring(2)
  endif

endmethod
-- End of method definition for .display(STRING)
------------------------------------------------------------------------
--
-- Method:      .modeGet()
--
-- Description: Function to return the current mode of the PEROP Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Mode of form.
--
-----------------------------------------------------------------------
define method .modeGet() is STRING
  -- Return the mode
  return !this.mode.selection('rtext')
endmethod
-- End of method definition for .modeGet() STRING
------------------------------------------------------------------------
--
-- Method:      .modeSet()
--
-- Description: Method to set the mode of the PEROP Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       STRING      Mode to set (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modeSet(!mode is STRING)
  -- Store the mode gadget
  !this.mode.select('rtext',!mode.upcase())
  handle any
    -- Dummy handle (should not happen)
  endhandle
endmethod
-- End of method definition for .modeSet(STRING)
------------------------------------------------------------------------
--
-- Method:      .cbMode()
--
-- Description: Callback to the mode gadget in the Perop Definition form.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .cbMode()
  -- Read the mode value
  !mode    = !this.modeGet()
  -- Call the display method to reset the form
  !this.display(!mode)
  -- make sure that name is OK if mode changed
  !this.cbName(!this.name)
endmethod
-- End of method definition for .cbMode()
------------------------------------------------------------------------
--
-- Method:      .cbName()
--
-- Description: Method to act as a callback to the Name gadget in the Perop form.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define Method
define method .cbName(!gadget is GADGET)
   -- Initialise variables
  !mode     = !this.modeGet()
  !perop    = !this.peropGet()
  !name     = !gadget.val
  if( !name.substring(1,1) ne '/' ) then
    -- add a / for PDMS name
    !name     =  '/' + !name
  endif

  -- Check to see if name converts to a dbref
  call !!admGenNameChk(!gadget, !mode, !perop.dbRef)

endmethod
-- End of method definition for .cbName(GADGET)

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: Method to create and modify Perop elements.
--
------------------------------------------------------------------------
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .cbApply()
  !orig = !this.peropGet()
  !mode = !this.modeGet()
  !temp = object ADMPEROP()
  -- construct temp admperop
  if(!this.name.val EQ |unset|)then
    -- ##
    !!alert.error(|You have not given this Perop a name|)
    return
  else
    !temp.name = |/| + !this.name.val
  endif
  !temp.eclass = !this.eclass.dText
  !temp.aclass = !this.aclass.dText
  if(NOT !this.cond.val.empty() AND (!this.cond.val NEQ |unset|))then
    !temp.cond = |( | + !this.cond.val + | )|
  else
    !temp.cond = ||
  endif
  !temp.acrMessage = !this.acrMes.val
  -- operations
  !temp.modify = !this.modify.selection()
  !temp.create = !this.create.selection()
  !temp.delete = !this.delete.selection()
  !temp.claim  = !this.claim.selection()
  !temp.issue  = !this.issue.selection()
  !temp.drop   = !this.drop.selection()
  !temp.dbRef        = !orig.dbRef
  !temp.aNot         = !this.negAttr.selection() eq '-'
  !temp.eNot         = !this.negElement.selection() eq '-'
  if(!mode EQ |MODIFY|)then
    if(!orig NEQ !temp)then
      -- modify perop (with changes, original)
      !this.modifyPerop(!temp,!orig)
      -- reset the current PEROP details
      !this.peropSet(!!admRole.peropGet())
    endif
  elseif(!mode EQ |CREATE|)then
    if( !this.addNewPerop(!temp) ) then
      -- if new PEROP created OK then initialise form for the next PEROP create
      !this.init()
    endif
  endif

  -- deactivate modify buttons on form !!admRole if no perops set
  !!admRole.greyModify(!!admRole.listPerop)

endmethod
-- End of method definition for .cbApply()
------------------------------------------------------------------------
--
-- Method: .allElements
--
-- Description: insert ALL word in element list regardless of what's already there
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .allElements()
  !this.eclass.clear()
  !temp[1] = |ALL|
  !this.eclass.dText = !temp
  -- make sure that access is allowed
  !this.negElement.select('+')
  !this.eclass.tag = !this.eMess
  -- All does not use All Hierarchy
  !this.eHierarchy.val = false
endmethod
-- End of method definition for .allElements()
------------------------------------------------------------------------
--
-- Method: .allAttributes
--
-- Description: insert ALL word in attribute list regardless of what's already there
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .allAttributes()
  !this.aclass.clear()
  !temp[1] = |ALL|
  !this.aclass.dText = !temp
  -- make sure that access is allowed
  !this.negAttr.select('+')
  !this.setAclassTag()
endmethod
-- End of method definition for .allAttributes()
------------------------------------------------------------------------
--
-- Method: .eAdd
--
-- Description: Adds text from Element textbox into Element list
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .eAdd()

  -- deal with ALL if typed
  if( !this.eNewClass.val.upcase().trim() eq 'ALL' ) then
    -- replace list by ALL
    !this.eNewClass.clear()
    !this.allElements()
  else
    -- Add element name to element list and
    -- switch off hierarchy if add is successful
    !this.eHierarchy.val = !this.cAdd(!this.eclass, !this.eNewClass, 'NOUNDEF').not()
  endif

endmethod
-- End of method definition for .eAdd()
------------------------------------------------------------------------
--
-- Method: .aAdd
--
-- Description: Adds text from Attribute textbox into Attribute list
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .aAdd()

  -- deal with ALL if typed
  if( !this.aNewClass.val.upcase().trim() eq 'ALL' ) then
    -- replace list by ALL
    !this.aNewClass.clear()
    !this.allAttributes()
  else
    -- Add attribute name to attribute list
    !this.cAdd(!this.aclass, !this.aNewClass, 'ATTDEF')
  endif

endmethod
-- End of method definition for .aAdd()
------------------------------------------------------------------------
--
-- Method: .cAdd
--
-- Description: Adds text from textbox into Gadget
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   RW     GADGET      The gadget to add in to!
--   2   R      GADGET      Textbox
--   3   -      STRING      The PDMS element to test validity of user entry
-- Return:
--  [Data Type] [Description]
--  BOOLEAN      True if name transfers to list OK, false otherwise
--
------------------------------------------------------------------------
define method .cAdd(!gadget is GADGET, !textGd is GADGET, !validTest is STRING) is BOOLEAN

  -- !word is the element or attribute class
  !word = !textGd.val.trim().upcase()
  if (!word.empty()) then
    return false
  endif
  -- Test validity of user entry
  var !unused $!validTest $!word name
  handle any
    -- ##
    !!alert.error(|$!textGd is not a valid entry.|)
    !textGd.clear()
    !textGd.setFocus()
    return false
  endhandle

  !temp = ARRAY()
  !temp = !gadget.dText
  -- if currently ALL - replace ALL with this entry
  if((!temp.size() EQ 1) AND (!temp[1].upcase() EQ |ALL|))then
    !temp.clear()
    !temp.append(!word)
  else
    !temp.append(!word)
  endif
  -- make sure this is a unique entry
  !temp.sortUnique()
  !gadget.dText = !temp
  !gadget.select('DTEXT' , !word)
  !textGd.clear()
  !textGd.setFocus()
  return true
endmethod
-- End of method definition for .cAdd(GADGET, GADGET, STRING) BOOLEAN
------------------------------------------------------------------------
--
-- Method: .remove
--
-- Description: remove item from a gadget list
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   RW     GADGET      The gadget to remove from
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remove(!gadget is GADGET)
  !temp = !gadget.dText
  if(!gadget.val gt 0) then
    !temp.remove(!gadget.val)
    !gadget.dText = !temp
  endif
  !this.eclassSelect()
endmethod
-- End of method definition for .remove(GADGET)
-----------------------------------------------------------------------
--
-- Method: .negAttributes()
--
-- Description: Switch between attribute access allowed or disallowed
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .negAttributes()

  if( !this.negAttr.selection() eq '-' ) then
    !temp = !this.aclass.dText
    if( !temp.empty().not() ) then
      if( !temp[1].upcase() eq 'ALL' ) then
        !!alert.warning('NOT <attribute list> cannot be used with ALL option')
        -- Must not allow NOT ALL
        !this.negAttr.select('+')
        return
      endif
    endif
  endif
  !this.setAclassTag()

endmethod
-- End of method definition for .negAttributes()
-----------------------------------------------------------------------
--
-- Method: .negElements()
--
-- Description: Switch between element access allowed or disallowed
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .negElements()

  if( !this.negElement.selection() eq '-' ) then
    !temp = !this.eclass.dText
    if( !temp.empty().not() ) then
      if( !temp[1].upcase() eq 'ALL' ) then
        !!alert.warning('NOT <element list> cannot be used with ALL option')
        -- Must not allow NOT ALL
        !this.eclass.tag = !this.eMess
        !this.negElement.select('+')
        return
      endif
    endif
    -- disallow access
    !this.eclass.tag = !this.eMessNot
  else
    -- allow access
    !this.eclass.tag = !this.eMess
  endif

endmethod
-- End of method definition for .negElements()
-----------------------------------------------------------------------
--
-- Method: .elementHier()
--
-- Description: Switch between element hierarchy in/out
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .elementHier()

  if(!this.eclass.val eq 0) then
    return
  endif
  if( !this.eHierarchy.val ) then
    !hierarchyString = ' HIERARCHY'
  else
    !hierarchyString = ''
  endif

  !temp  = !this.eclass.dText
  if( !temp.empty().not() ) then
    if( !temp[1].upcase() eq 'ALL' ) then
      !!alert.warning('HIERARCHY cannot be used with ALL option')
      -- Must not allow ALL HIERARCHY
      !this.eHierarchy.val = false
      return
    endif
  endif

  !newEntry = !temp[!this.eclass.val].part(1) + !hierarchyString
  !temp[!this.eclass.val] = !newEntry
  !temp.unique()
  !this.eclass.dText = !temp
  !this.eclass.select('DTEXT', !newEntry)

endmethod
-- End of method definition for .elementHier()
-----------------------------------------------------------------------
--
-- Method: .eclassSelect()
--
-- Description: Switch hierarchy in/out toggle for current selection
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .eclassSelect()

  if(!this.eclass.val eq 0) then
    return
  endif
  !entry = !this.eclass.dText[!this.eclass.val]
  !this.eHierarchy.val =  !entry.part(2) eq 'HIERARCHY'

endmethod
-- End of method definition for .eclassSelect()
-----------------------------------------------------------------------
--
-- Method: .activateAttrs(BOOLEAN)
--
-- Description: Switch hierarchy in/out toggle for current selection
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      BOOLEAN     True to activate aclass gadgets, False to grey them
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .activateAttrs(!active is BOOLEAN)

  !this.aclass.active    = !active
  !this.negAttr.active   = !active
  !this.text2.active     = !active
  !this.aNewClass.active = !active
  !this.aAll.active      = !active
  !this.aRemove.active   = !active
  !this.setAclassTag()

endmethod
-- End of method definition for .activateAttrs(BOOLEAN)
-----------------------------------------------------------------------
--
-- Method: .setAclassTag()
--
-- Description: Form message for aclass list
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAclassTag()

  if( !this.modify.selection('DTEXT').trim().upcase() eq 'DISALLOW' ) then
    !allow = 'Disallow'
  else
    !allow = 'Allow'
  endif

  if( !this.negAttr.selection() eq '+' ) then
    !this.aclass.tag = !allow + !this.aMess
  else
    !this.aclass.tag = !allow + !this.aMessNot
  endif

endmethod
-- End of method definition for .setAclassTag()

------------------------------------------------------------------------
--
-- Method: .addNewPerop
--
-- Description: add new PEROP to role
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1    R          ADMPEROP   The New Perop
-- Return:
--  [Data Type] [Description]
--   BOOLEAN     True if create OK, false if error
--
------------------------------------------------------------------------
define method .addNewPerop(!object is ADMPEROP) is BOOLEAN

  -- Create New Perop
  !object.newPerop(!!admRole.roleGet())
  handle any
    -- This error needs to be handled when attribute entered - not here
    !!alert.error(!!error.text)
    return false
  endhandle
  !!admRole.update()
  return true

endmethod
-- End of method definition for .addNewPerop(ADMPEROP) BOOLEAN
------------------------------------------------------------------------
--
-- Method: .modifyPerop()
--
-- Description: Modify an existing perop!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1    R             ADMPEROP  Changed perop
--   2    R             ADMPEROP  Original perop

-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyPerop(!changed is ADMPEROP, !original is ADMPEROP)

  -- check for PEROP deleted while form displayed
  if( badref ( !original.dbRef ) ) then
    !!alert.error(|Cannot modify Permissible Operation | & !original.name & | - it may have been deleted since this form was displayed| )
    return
  endif
  -- Modify perop
  !changed.modifyPerop(!original.dbRef)
  handle any
    -- This error needs to be handled when attribute entered - not here
    !!alert.error(!!error.text)
    !this.update()
    return
  endhandle
  !!admRole.update()

endmethod
-- End of method definition for .modifyPerop(ADMPEROP, ADMPEROP)

------------------------------------------------------------------------
--
-- Method: .checkCondition
--
-- Description: Callback to check validity of condition
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkCondition()

  -- Create New Perop
  !condition = !this.cond.val.trim()
  if(!condition.empty().not()) then
    -- check syntax
    VAR !conditionType EXPTYP ( $!condition )
    handle (99,532)
      -- can't always check UDA names because MDB may not be set
      !conditionType[1] = 'LOGICAL'
    elsehandle any
--      !!alert.error( 'Condition entered is invalid: ' & !!error.text )
    if(!this.perop.dbRef.set()) then
       !ref = !!ce
       !!ce = !this.perop.dbRef
       COND ( $!condition )
        handle ANY
         !reason  = !!error.text
         !command = !!error.command
         !!alert.error(|$!reason

$!command|)
         !!ce = !ref
      endhandle
    endif
      !this.cond.setFocus()
      return
    endhandle
    if( !conditionType[1].trim().upcase() ne 'LOGICAL' ) then
      !!alert.error( 'Expression does not give a boolean (true/false) answer' )
      !this.cond.setFocus()
      return
    endif
  endif

endmethod
-- End of method definition for .checkCondition()
