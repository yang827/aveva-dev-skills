--     Keyword:     GEN
--   Module:        global
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Thu Apr 22 14:28:29 BST 1999
--
--
-- Description:
-- A form to display all DBSet information on one form
-- .
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbListGadget(STRING,GADGET)      -                   To set cursor position to the selected Dbsets!
--  createReport(GADGET,GADGET)      -                   Creates the Report
--  init()                           -                   initialise form
--

setup form !!admQryDbSet resize

  !!admQryDbSet.formTitle     = 'Database Sets Report'
  !!admQryDbSet.iconTitle     = 'DB Sets'
  !!admQryDbSet.callback      = '!!admQryDbSet.init()'
  !!admQryDbSet.formRevision  = ' '

  -- Body of form definition
  textpane .report at x 0 y 0.2 anchor all width 60 height 30
  list .dbSets |Navigate to DBSet| at xmax+0.2 ymin+3 anchor top+bottom+right call |!this.cbListGadget(!this.dbSets.selection('RTEXT'),!this.report)| SINGLE width 18 height 15
  button .run at xmin.report ymax.report+0.2 |Update Report| anchor left+bottom call |!this.createReport(!this.report,!this.dbSets)|
  button .dismiss at xmax form-size ymin |Dismiss| anchor right+bottom CANCEL

exit
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
  !this.report.setEditable(FALSE)
  !this.createReport(!this.report,!this.dbSets)
endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      .createReport()
--
-- Description: Creates the Report
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createReport(!reportGadget is GADGET, !listGadget is GADGET)
  !timeNow = object DATETIME()
  !report[1] = |DB Sets Report for Project | +  !!sessionSettings.projname
  !report[2] = |Date :- | + !timeNow.date().string() + | | + !timeNow.monthString() + | | + !timeNow.year().string() + | Time :- | + !timeNow.hour().string() + |:| + !timeNow.minute().string()
  !report[3] = | |
  !report[4] = | ******** DB Sets in Project ********|
  !report[5] = | |

  -- Navigate to DBSet World
  !prev = !!ce
  !!ce = !!dbrAdminGetWorld(|DBSET|)

  -- Collect Scopes
  !dbSets = !!ce.mem

  -- Normal text for sorting alphabetise them
  !textBlock = object BLOCK(|!dbSets[!evalIndex].name|)
  !sortText  = !dbSets.evaluate(!textBlock)
  !sortOrder = !sortText.sortedIndices()
  !dbSets.reIndex(!sortOrder)

  !currentLine = 6
  -- Generate text for Scope
  do !i values !dbSets
    !!ce = !i
    !report[!currentLine] = |Name - | + !i.name + |  Description - | + !i.desc
    -- Get the DBs of this DBSET
    !dbs = !i.dbsList
    !sets = !i.dbsHie

    if( !sets.size() GT 0)then
      !setsText = |DBsets within this set...|
      do !t values !sets
        !setsText =  !setsText + !t.name + | |
      enddo
      !report[!currentLine + 1 ] =  !setsText
      !currentLine = !currentLine + 2
    endif

    if( !dbs.size() LT 1)then
      !report[!currentLine + 1 ] = |This Set has no Databases!!!|
      !currentLine = !currentLine + 2
    else
      !report[!currentLine + 1 ] =  |Databases in this Set are..|
      !currentLine = !currentLine + 2
    endif
    do !k values !dbs
      !report[!currentLine + 1 ] =  !k.name
      !currentLine = !currentLine + 2
    enddo
    !report[!currentLine] = | |
    !currentLine = !currentLine + 1
  enddo

  !report[!currentLine] = | ******** REPORT END ********|
  !reportGadget.val = !report
  !!ce = !prev


  -- Populate gadget with DBSets
  !tempRtext = ARRAY()
  !tempDtext = ARRAY()
  do !z values !dbSets
    !tempDtext.append(!z.name.substring(2))
    -- This next line MUST exactly corresponded to the identical line above
    !tempRtext.append(|Name - | + !z.name + |  Description - | + !z.desc)
  enddo
  !listGadget.dText = !tempDtext
  !listGadget.rText = !tempRtext

endmethod
-- End of method definition for .createReport(GADGET, GADGET)
------------------------------------------------------------------------
--
--Method: .cbListGadget()
--a
-- Description: To set cursor position to the selected Dbsets!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbListGadget(!rText is STRING, !reportGadget is GADGET)
  !arrayToSearch = !reportGadget.val
  !posToGoto = ARRAY()
  !posToGoto[1] = !arrayToSearch.findFirst(!rText)
  !posToGoto[2] = 0
  !reportGadget.setCurPos(!posToGoto)
endmethod
-- End of method definition for .cbListGadget(STRING, GADGET)
