--
--
-- Description:
-- Form to repair system DB
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   Function to perform repair.
--  init()                           -                   Method to initialise the form.
--  output()                         -                   Function to control the gadget states for output
--
------------------------------------------------------------------------

setup form !!admRepair
Import 'pmlfilebrowser'
handle any
endhandle

  !this.formTitle     = |Repair System Database|
  !this.iconTitle     = |Repair|
  !this.callback      = |!this.init()|
  !this.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition

  paragraph .option at x0.5 ymax  text 'Option -'  width 10
  rgroup .repairOptions '' at xmax ymin  call || horizontal
    add tag |Repair|
    add tag |Check |
  exit

  paragraph .outputTo at x0.5 ymax  text 'Output -'  width 10
  rgroup .output '' at xmax ymin call |!this.output()| horizontal
    add tag |None  |
    add tag |Screen|
    add tag |File  |
  exit

  text .file at x0.5 ymax.output+0.2 || width 30 STRING
  button .browse at xmax+0.5 ymin |Browse...| call $
         |!!fileBrowser('%PDMSUSER%','RepairResults.txt','Database Repair Output File',false,'!!admRepair.file.val = !!fileBrowser.file.name()')|

  button .apply at x0.5 ymax+0.5 |Apply| call |!this.cbApply()| APPLY
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  !this.file.val      = '%PDMSUSER%/RepairResults.txt'

  -- members
  member .noneCheck is BOOLEAN

exit
-- End of form definition for !!admRepair

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the Database Integrity Checker form.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Report option active or not
  !this.output()

  -- Initialise the no Report Check member
  !this.noneCheck = false

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .output()
--
-- Description: Function to control the gadget states for output from the
-- database integrity check form.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .output()

  -- Check the state of the radiogroup
  if (!this.output.selection().match('File') neq 0) then

    -- Make file gadgets inactive
    !this.file.active    = true
    !this.browse.active  = true

  else

    -- Make file gadgets active
    !this.file.active    = false
    !this.browse.active  = false

  endif

endmethod
-- End of method definition for .output()

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: Function to perform database integrity check on selected databases.
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbApply()

  -- Initialise variables
  !file = object FILE()

  -- If the output not set to none hide the file Browser
  if (!this.output.selection().match('None') eq 0) then
    -- Display the result to the screen
    if (defined(!!fileViewer)) then
      !!fileViewer.hide()
    endif
  endif

  -- Check for an output file
  if (!this.output.selection().match('File') neq 0) then
    -- For File

    -- Create an output file
    -- Trim off "//" if start is an environment variable
    !fileName = !this.file.val
    if (!fileName.substring(1,2) eq |/%|) then

      !fileName = !fileName.substring(2)
    endif

    !file.file(!fileName)

    -- Check to see if file exists
    if (!file.exists()) then

      -- Get user to confirm overwrite
      !answer = !!alert.confirm('File ' & !file.fullname() & 'exists. Do you wish to overwrite?')

      if (!answer.boolean().not()) then
        !!alert.message('Repair not carried out')
        return
      endif

      -- Set the output file
      !outputFile  = !file.fullname()
      !fileCommand = |ALPHA FILE "| &  !file.fullname() &  |" OVERWRITE|

    else

      -- Set the output file
      !outputFile  = !file.name()
      !fileCommand = |ALPHA FILE "| & !file.name() & |"|

    endif

  else
    -- Not File
    if ((!this.output.selection().match('None') gt 0) and (!this.repairOptions.selection().match('Check') gt 0)) then
      !this.noneCheck = true
      call !!admRepair(true)
      !this.noneCheck = false
      return
    else
      -- Setup a temporary file in PDMSWK area
      !sessionData = CURRENT SESSION
      !outputFile  = |%PDMSWK%/repair|& !sessionData.uniqueId
      !fileCommand = |ALPHA FILE "| & !outputFile & |"  OVERWRITE|
    endif

  endif

  -- Open the output file regardless
  call !!admCommand(!fileCommand)
  handle any
    -- Unable to open file (No error if no report was asked for)
    if (!this.output.selection().match('None') eq 0) then
      -- Not None
      !!messagefile.error(146, 26, !outputFile, !!error.text)
      return
    else
      -- None
      -- If output is none then do the repair
      -- Repair (not repair nocheck option is not used in this form)
      if (!this.repairOptions.selection().match('Repair') gt 0) then
        -- First check in case we are read only
        !memory = !!ce
        GOTO FRSTW SYST
        var !dbWrite DBWRITE
        if (!dbWrite.boolean().not()) then
          !!alert.message(|The System Database is 'Read Only', Required repair can only be checked|)
          !!ce = !memory
          handle ANY
          endhandle
          return
        endif
        !!ce = !memory
        handle ANY
        endhandle
        REPAIR NOCHECK
      else
        REPAIR CHECKONLY
      endif
      return
    endif

  elsehandle none
    -- File must be open

    -- Insert a header comment
    var !clock CLOCK
    WRITEALPHAFILE '-- ----------------------------------------------------------------'
    WRITEALPHAFILE '-- Repair System Database -  Date : $!clock '
    WRITEALPHAFILE ''

    -- Repair (not repair nocheck option is not used in this form)
    if (!this.repairOptions.selection().match('Repair') gt 0) then
      -- First check in case we are read only
      !memory = !!ce
      GOTO FRSTW SYST
      var !dbWrite DBWRITE
      if (!dbWrite.boolean().not()) then
        !!alert.message(|The System Database is 'Read Only', Required repair can only be checked|)
        !!ce = !memory
        handle ANY
        endhandle
        return
      endif
      !!ce = !memory
      handle ANY
      endhandle
      REPAIR
    else
      REPAIR CHECKONLY
    endif

    -- insert a footer comment
    WRITEALPHAFILE '-- End Repair System Database -  Date : $!clock '
    WRITEALPHAFILE '-- ----------------------------------------------------------------'

    -- Close the output file
    ALPHA FILE END

  endhandle

  -- If the output was to a user file check for if user wishes to view it now.
  if (!this.output.selection().match('File') neq 0) then
    -- File
    -- See if user wishes to view the file now
    !answer = !!alert.confirm('View the repair log file now?')
    if (!answer.boolean().not()) then
      return
    endif
  endif

  -- If the output not set to none display the file
  if (!this.output.selection().match('None') eq 0) then

    -- Display the result to the screen
    if (undefined(!!fileViewer)) then
      !!loadform ('fileViewer')
    endif

    !!fileViewer(!outputFile, 'Repair System DB Output')
    -- Example
    --!!fileViewer('%PDMSWK%\repairX104-PC338copy', 'Repair System DB Output')

  endif

endmethod
-- End of method definition for .cbApply()
