--
--
-- Description:
-- Form to allow the user to specify the three letter code for the PDMS
-- project which is the target (will be created) of the replication.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admReplPrj()                     -                   Constructor
--  init()                           -                   Initialise
--  okcall()                         -                   Proceed
--

-- Kill existing form definition
kill !!admReplPrj

-- Define form
setup form !!admReplPrj resize


  -- Body of form definition
  para .info   at x 0 y 0   text |Copy entire project structure and data to a new project.|

--  text .target at x 11 ymax+0.5 |Enter Project Code   | call |call !!admReplPrjCode()| width 6 NAME
  list .projects at xmin+1 ymin+1 anchor all  width 45 height 5

  button .ok at x0 ymax+0.5 anchor left+bottom |  OK  |  OK
  button .cancel at xmax form-size ymin anchor left+bottom |Cancel| CANCEL


exit

----------------------------------------------------------------------
--
-- Method:      admReplPrj
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------

define method .admReplPrj()
  !this.formTitle     = 'Replicate Project'
  !this.iconTitle     = 'REPLICA'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.4 $ '
  !this.ok.callback   = '!this.okcall()'
endmethod

----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------

define method .init()

!headings=ARRAY()
!headings.append('Project')
!headings.append('Project Code')
!this.projects.setHeadings(!headings)

!project       = ARRAY()
!projectId     = ARRAY()
!projectStatus = ARRAY()
!validProjCode = ARRAY()

!validProj     =projects
do !i values !validProj
  !vpc=!i.code().upcase()
  !validProjCode.append(!vpc)
enddo

-- Find out projects that have XXX000,XXXPIC & XXXMAC set as these are the criteria that must be met to
-- replicate a project notify if the project is empty or not.

-- Find out from the evars file what are available projects, cannot do it from projects because
-- projects only show projects that are available

var !unique unique
!pdmswk = !!evarSplit('PDMSWK')[1]
!fileName=  !pdmswk & '\' & !unique & 'evar.pmlmac'
!command=|set >  "| & !fileName & |"|
syscom'$!command'

!file = object FILE(!fileName)
!fileContents=ARRAY()
!file.open('READ')

do !i
   !text=!file.readRecord()
   handle(41,319)
    -- RSE
   elsehandle (41,384)
     -- Ignore long line - unlikely to be a Project code
     skip
   endhandle
   break if (!text.unset())
   !fileContents.append(!text)
enddo

do !i values !fileContents
  !proj000=!i.substring(4,4)
  if (!proj000 eq '000=') then
     !proj=!i.substring(1,3).upcase()
     -- Miss out all projects that have in the projects array
     skip if (!validProjCode.findFirst(!proj).set())
     !pic=FALSE
     !mac=FALSE
     !id =FALSE
     do !j values !fileContents
       !projPic=!j.substring(1,6).upcase()
       !projPicVal = !proj & 'PIC'
       if (!projPic eq !projPicVal) then
          !pic = TRUE
          break
       endif
     enddo
     do !j values !fileContents
       !projMac=!j.substring(1,6).upcase()
       !projMacVal = !proj & 'MAC'
       if (!projMac eq !projMacVal) then
          !mac = TRUE
          break
       endif
     enddo
     do !j values !fileContents
       !projid=!j.substring(1,8).upcase()
       !projidVal = !proj & '000ID'
       if (!projid eq !projidVal) then
          !id = TRUE
          break
       endif
     enddo
     if (!pic and !mac) then
        !project.append(!proj)
        if (!id) then
          var !evarId evar '$!projid'
          !projectId.append(!evarId)
        else
          !projectId.append(!proj)
        endif
        -- We now have the projects and the project ids. These projects may be valid projects
        -- Warn the user of non empty projects
        -- Is it a currently used project?
        if (!validProjCode.findFirst(!proj).unset()) then
          !projectStatus.append('No current data files')
        else
          !projectStatus.append('Currently used Project')
        endif
     endif
  endif
enddo

!dtext=ARRAY()
!rtext=ARRAY()

do !i index !project
  !dtext.append(!projectId[!i] & |	| & !project[!i])
  !rtext.append(!project[!i])
enddo

if (!project.empty()) then
  return error 1 'There are no Environment variables set up that do not contain Project data. Unable to Replicate'
endif

!this.projects.dtext=!dtext
!this.projects.rtext=!rtext

!file.close()
!file.deletefile()
handle (41,322)
  -- Ignore FIU error
endhandle

endmethod

----------------------------------------------------------------------
--
-- Method:      okcall
--
-- Description: Proceed
--
-- Method Type: Function/Procedure
--
------------------------------------------------------------------------

define method .okcall()

  -- Initialise variables
  !project  = CURRENT PROJECT
  !target   = !this.projects.selection()
  VAR !lock LOCK
  !answer = 'NO'


  -- Check the project lock whilst process is working
  if (!lock eq 'Unlocked') then

    -- Project is unlocked, lock project whilst replication
    -- is in progress
    !answer   = !!alert.confirm(!!messageFile.messageString(141, 318, !project.id()))
    if (!answer.boolean()) then

      -- Lock the project
      LOCK
      if( !!glbIsGlobal().not()) then
        !!adminApplic.project.setFieldProperty('Locking','selected',TRUE)
      endif
      !!adminApplic.lock.val = 'Locked'
      !!adminApplic.lock.background = 3
      QUERY LOCK

    endif

  endif

  -- Set the prompt
  !!messageFile.prompt(141, 319, !project.code(), !target)

  -- Set the command
  !command  = |REPLICATE | + !target

  -- Execute the command
  call !!admCommand(!command)
  handle (1,17)

    -- File already exists
    !!ce      = !!dbrAdminGetWorld('WORLD')
    call !!prompt(0)
    !!messageFile.error(141, 321)

  elsehandle (1,54)

    -- Users still in project
    !!ce      = !!dbrAdminGetWorld('WORLD')
    call !!prompt(0)
    !!messageFile.error(141, 322)

  elsehandle any

    -- Non-specific error
    !!ce      = !!dbrAdminGetWorld('WORLD')
    call !!prompt(0)
    !!messageFile.error(141, 323, !!error.text)

  endhandle

  -- Dismiss the prompt
  call !!prompt(0)


endmethod


-- End of form definition for !!admReplPrj
