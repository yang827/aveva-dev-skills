-- Created:         Wed Dec 2 11:31:46 GMT 1998
--
--
-- Description: The form needed to create/modify the admin element ROLE
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admRole()                        -                   Constructor
--  cbApply()                        -                   Method to create and modify Role elements.
--  cbMode()                         -                   Callback to the mode gadget in the PEROP Definition form.
--  cbName(GADGET)                   -                   Method to act as a callback to the Name gadget in the Role form.
--  display(STRING)                  -                   Method to display the ROLE definition form.
--  greyModify(GADGET)               -                   grey gadgets [modifyPerop |Modify|], [.deletePerop |Delete|], [.toggleMode |+ / -|] if
--  init()                           -                   initialise form
--  modeGet()                        STRING              Function to return the current mode of the PEROP Definition form.
--  modeSet(STRING)                  -                   Method to set the mode of the PEROP Definition form.
--  moveElement(STRING,GADGET)       -                   reorders items in a gadget list
--  peropDelete(REAL)                -                   Function to mark perops for deletion, NB removed from both arrays if perop new this session
--  peropGet()                       ADMPEROP            A method to return the current selected Perop
--  peropSet(REAL)                   -                   A method to set the perop highlighted in gadget
--  roleGet()                        DBREF               A method to return the current role
--  roleSet(DBREF)                   -                   A method to set the current method
--  setPeropList(DBREF)              -
--  updDepend()                      -                   Method to update dependent forms, mainly !!admRole
--  update()                         -                   method to update the displayed ROLE in the ROLE Definition
--
------------------------------------------------------------------------

setup form !!admRole

  !this.formTitle     = 'Role Definition'
  !this.iconTitle     = 'ROLE'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.15 $ '

  -- Body of form definition
  text   .name       at x 1 y 0.2 |Name        | call |!this.cbName(!this.name)|  width 28 scroll 49 NAME
  option .mode       at xmax+2 ymin call |!this.cbMode()| width 8
  text   .desc       at xmin.name ymax+0.2 |Description | width 42 scroll 120 STRING
  frame  .framePerop at xmin  ymax+0.5 |Permissible Operations|
    list .listPerop  call |!this.updDepend()| width 48 height 6
    path down
    halign centre
    vdist 0.2
    button .modifyPerop |Modify...| call |!!admPerop.display('MODIFY')| tooltip |Modify selected Permissible Operation|
    path left
    valign centre
    hdist 1
    button .createPerop |Create...| call |!!admPerop.display('CREATE')| tooltip |Add a new Permissible Operation|
    button .deletePerop at xmax.modifyPerop+1 ymin |Delete| call |!this.peropDelete(!this.listPerop.val)| tooltip |Delete selected Permissible Operation|
    button .up    at xmax.listPerop+0.2 ymin.listPerop+0.2 call |!this.moveElement('UP', !this.listPerop)| pixmap width 16 height 16 tooltip 'Move up in list'
    button .down  at xmax.listPerop+0.2 ymax  call |!this.moveElement('DOWN', !this.listPerop)| pixmap width 16 height 16 tooltip 'Move down in list'
  exit
  button .apply   at x 0 ymax+0.5               |Apply| call |!this.cbApply()| APPLY
  button .reset   at xcen form-0.5 * size ymin  |Reset| call |!this.init()|    RESET
  button .dismiss at xmax form-size ymin        |Dismiss| CANCEL

  --Member Definitions
  member .role          is DBREF
  -- An Array of Perops currently displayed
  member .listAdmPerop  is ARRAY
  -- An array of reals, 0 = No Change, 1 = New perop, 2 perop changed.

exit
-- End of form definition for !!admRole
------------------------------------------------------------------------
--
-- Method: .admRole()
--
-- Description: Constructor
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
------------------------------------------------------------------------
define method .admRole()

  !this.up.addPixmap(!!pml.getPathName('uparrow16.png'))
  !this.down.addPixmap(!!pml.getPathName('downarrow16.png'))

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  --- Assign Mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !!admRole.mode.dText  = !dText
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !!admRole.mode.rText  = !rText
--  !this.recoverPerops = false

endmethod
-- End of method definition for .admRole()
------------------------------------------------------------------------
--
-- Method: .roleGet()
--
-- Description: A method to return the current role
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--  DBREF       The current Role funnily enough!
------------------------------------------------------------------------
define method .roleGet() is DBREF
  return !this.role
endmethod
-- End of method definition for .roleGet() DBREF
------------------------------------------------------------------------
--
-- Method: .roleSet()
--
-- Description: A method to set the current method
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R            DBREF       The role the current form is to be set to!
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .roleSet(!dbRef is DBREF)
  !this.role = !dbRef
endmethod
-- End of method definition for .roleSet(DBREF)
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
  -- Initialise variables
  !mode    = !this.modeGet()
  !dbRef   = !this.roleGet()
    -- Check the current mode
  if (!mode eq 'CREATE') then
    -- Set the form title
    !this.formTitle  = 'Create Role'
    -- Set the form gadgets
    !this.name.val   = |unset|
    !this.desc.val   = |unset|
    !this.listAdmPerop.clear()
    !this.listPerop.clear()
--    !this.peropChg.clear()
--    !this.deletedPerop.clear()
    !this.createPerop.active = false
  elseif (!mode eq 'MODIFY') then
    if( badref( !dbRef ) ) then
      -- Role element probably deleted while form displayed causing badref
      !!alert.warning('This Role has been deleted. Switching form to Create mode')
      -- throw form into create mode
      !this.modeSet('CREATE')
      -- Set the form title
      !this.formTitle  = 'Create Role'
      -- Set the form gadgets
      !this.name.val   = |unset|
      !this.desc.val   = |unset|
      !this.listAdmPerop.clear()
      !this.listPerop.clear()
--      !this.peropChg.clear()
--      !this.deletedPerop.clear()
      !this.createPerop.active = false
    else
      -- Set the form title
      !this.formTitle  = 'Modify Role: ' + !dbRef.name.substring(2)
      -- Set the form gadgets
      !roleName = !dbRef.name
      if( !roleName.substring(1,1) eq '=' ) then
        !this.name.val = 'unset'
      else
        !this.name.val = !roleName.substring(2)
      endif
      if (!dbRef.description.empty()) then
        !this.desc.val   = |unset|
      else
        !this.desc.val   = !dbRef.description
      endif
      !this.listAdmPerop.clear()
      !this.listPerop.clear()
--      !this.peropChg.clear()
--      !this.deletedPerop.clear()
      !this.createPerop.active = true
      -- set array of PEROPs in this role
      !this.setPeropList(!dbRef)
      !!admPeropTxtList(!this.listAdmPerop,!this.listPerop,False)
    endif
  endif

  -- Dismiss the prompt
  !!prompt(0)

  -- grey gadgets

  !this.greyModify(!this.listPerop)

  -- Set focus to the name gadget
  !this.name.setFocus()

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      .update()
--
-- Description: method to update the displayed ROLE in the ROLE Definition
-- form. The form must be displayed and in MODIFY mode.
--
------------------------------------------------------------------------
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update()

  -- Return if the form is not shown
  if (undefined (!!admRole) or !this.shown().not()) then
    return
  endif

  -- Initialise variables
  !mode    = !this.modeGet()

  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif

  -- Reinitialise the form
  !selLoc  = !!adminElem.roleGet()
  !this.roleSet(!selLoc)
  !this.init()

endmethod
-- End of method definition for .update()
------------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Method to display the ROLE definition form.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display form in (CREATE/MODIFY/VIEW)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display(!mode is STRING)
  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY' and !mode.upcase() neq 'VIEW') then
    -- Invalid mode
    return error 1 |Invalid mode for form !!admTeam|
  else
    if (!mode eq 'VIEW') then
      !this.mode.select('RTEXT', 'MODIFY')
      -- Inform user he can only view this form not apply it
      if (!this.shown().not()) then
        !!alert.message('You cannot modify the Roles, but you can view them. The Apply button will be inactive.')
      endif
    else
      -- Make sure the form apply is active
      !this.apply.active = true
      !this.reset.active = true
      !this.up.active = true
      !this.down.active = true
      !this.mode.active = true
      !this.name.active = true
      !this.desc.active = true
      !this.createPerop.active = true
      !this.deletePerop.active = true
    endif
  endif
  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then
    !this.roleSet(object DBREF())
    !this.createPerop.active = false
  elseif (!mode eq 'MODIFY' or !mode eq 'VIEW') then
    !dbRef   = !!adminElem.roleGet()
    if (!dbRef.unset()) then
      -- No action required
      return
    elseif (!dbRef eq !this.roleGet() and !this.shown()) then
      -- No action required
--      return
    endif
    -- Set the new locations
    !this.roleSet(!dbRef)
    !this.createPerop.active = true

  endif
  -- Select the mode
  !this.modeSet(!mode.upcase())
  -- Show or update the form
  if (!this.shown()) then
    -- Re-Initialise the form
    !this.init()
  else
    -- Show the form
    show !!admRole free
    !this.init()
  endif

  -- If in view only mode then do not allow apply (DFN1626)
  if (!mode eq 'VIEW') then
    -- Make sure the form apply is inactive
    !this.apply.active = false
    !this.reset.active = false
    !this.up.active = false
    !this.down.active = false
    !this.mode.active = false
    !this.name.active = false
    !this.desc.active = false
    !this.createPerop.active = false
    !this.deletePerop.active = false
    -- Change the callback on the modify so that user will only be able to view the perops
    !this.modifyPerop.callback = |!!admPerop.display('VIEW')|
    !this.modifyPerop.setTooltip(|View selected Permissible Operation|)
    !this.modifyPerop.tag = 'View...'
    !dbRef   = !this.roleGet()
    -- Set the form title
    !this.formTitle  = 'View Role: ' + !dbRef.name.substring(2)
  else
    -- Change the callback on the modify so that user will be able to modify the perops
    !this.modifyPerop.callback = |!!admPerop.display('MODIFY')|
    !this.modifyPerop.setTooltip(|Modify selected Permissible Operation|)
    !this.modifyPerop.tag = 'Modify...'
  endif

endmethod
-- End of method definition for .display(STRING)
------------------------------------------------------------------------
--
-- Method:      .modeGet()
--
-- Description: Function to return the current mode of the PEROP Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Mode of form.
--
-----------------------------------------------------------------------
define method .modeGet() is STRING
  -- Return the mode
  return !this.mode.selection('rtext')
endmethod
-- End of method definition for .modeGet() STRING
------------------------------------------------------------------------
--
-- Method:      .modeSet()
--
-- Description: Method to set the mode of the PEROP Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       STRING      Mode to set (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modeSet(!mode is STRING)
  -- Store the mode gadget
  !this.mode.select('rtext',!mode.upcase())
  handle any
    -- Dummy handle (should not happen)
  endhandle
endmethod
-- End of method definition for .modeSet(STRING)
------------------------------------------------------------------------
--
-- Method:      .cbMode()
--
-- Description: Callback to the mode gadget in the PEROP Definition form.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .cbMode()
  -- Read the mode value
  !mode    = !this.modeGet()
  -- Call the display method to reset the form
  !this.display(!mode)
endmethod
-- End of method definition for .cbMode()
------------------------------------------------------------------------
--
-- Method:      .cbName()
--
-- Description: Method to act as a callback to the Name gadget in the Role form.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define Method
define method .cbName(!gadget is GADGET)

  call !!admGenNameChk(!gadget, !this.modeGet(), !this.roleGet())

endmethod
-- End of method definition for .cbName(GADGET)

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: Method to create and modify Role elements.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .cbApply()
  -- Initialise variables
  !dbRef        = !this.roleGet()
  !mode         = !this.modeGet().upcase()
  !updateFlag   = false
  !prev         = !!ce

  -- Check that all parameters are set
  if (!this.name.val eq 'unset') then
    -- Reset the name if modify mode
    if (!mode eq 'MODIFY') then
      !this.name.val = !dbRef.name.substring(2)
    endif
    -- Raise error
    -- ##
     !!alert.error(|No name has been specified|)
     !this.name.setFocus()
     return
  endif
  -- Get all the new attribute values
  !roleName          =  |/| + !this.name.val
  !description       =  !this.desc.val

  -- Act on Role according to mode
  if (!mode eq 'CREATE') then

    -- Navigate to the Global Location World
    !!ce             = !!dbrAdminGetWorld('ROLE')
    call !!admCommand(|NEW ROLE $!roleName|)
    handle any
      !!alert.error(!!error.text)
      return
    endhandle
    -- Needed later on for Perop Creation
    !this.roleSet(!!ce)
    -- Set attributes
    DESC  |$!description|
    !!prompt(0)
    -- Set the current Role
    !!adminElem.roleSet(!!ce)
    -- Set the update flag
    !updateFlag = true
    -- No perops to delete because any new ones that have been created do not actually yet exist in DB!

  elseif (!mode eq 'MODIFY') then

    if( badref(!dbRef) ) then
      !!alert.error('Element selected for modification has not been found')
      return
    endif
    -- Check for element being already claimed
    if (not !!dbRefUpdate(!dbRef)) then
      !!alert.error (!!error.text)
      return
    endif
    -- Modify the current Role element.
    -- Navigate to Role element
    !!ce  = !dbRef
    -- See if the name needs modifying
    if (!roleName neq !dbRef.name) then
      -- Modify the name
      call !!admCommand(|NAME $!roleName|)
      -- ##
      handle any
        !!alert.error (!!error.text)
        -- Role name already exists
--      !!messageFile.error(141, 504, !this.name.val)
        !this.name.val = !dbRef.name.substring(2)
        return
      endhandle
      -- Change the formTitle
      !this.formTitle  = |Modify Role: | + !dbRef.name
      !updateFlag = true
    endif
    -- Check DESC modification
    if (!description neq 'unset' and !description neq !dbRef.description) then
      -- Modify the description
      DESC |$!description|
      !updateFlag = true
    endif

  endif

  -- Check to see if the Admin Elements form needs refreshing
  if(!updateFlag)then
    !!adminElem.update('ROLE')
    -- force to MODIFY mode
    !this.display('MODIFY')
  endif

  !!ce = !prev

endmethod
-- End of method definition for .cbApply()
------------------------------------------------------------------------
--
-- Method: .peropGet()
--
-- Description: A method to return the current selected Perop
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--   ADMPEROP       The ADMPEROP of the currently highlighted Perop.
------------------------------------------------------------------------
define method .peropGet() is ADMPEROP
  if(!this.listPerop.val GT 0)then
    return !this.listAdmPerop[!this.listPerop.val]
  else
    return(object ADMPEROP())
  endif
endmethod
-- End of method definition for .peropGet() ADMPEROP
------------------------------------------------------------------------
--
-- Method: .peropSet()
--
-- Description: A method to set the perop highlighted in gadget
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      The is the name of the perop to be highlighted
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .peropSet(!val is REAL)
  !this.listPerop.val = !val
endmethod
-- End of method definition for .peropSet(REAL)
------------------------------------------------------------------------
--
-- Method: .updDepend()
--
-- Description:  Method to update dependent forms, mainly !!admRole
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updDepend()
  -- Update the !!admPerop form
  if (undefined (!!admPerop)) then
     !!loadForm ('admPerop')
  endif

  -- if the mode is inactive then we are in view mode so set display appropriately
  if (!this.mode.active.not()) then
    if (!!admPerop.shown()) then
      !!admPerop.display('VIEW')
      return
    endif
  endif

  !!admPerop.update()

endmethod
-- End of method definition for .updDepend()

------------------------------------------------------------------------
--
-- Method: .peropDelete()
--
-- Description: Function to delete a PEROP
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1    R      REAL         Is the index of the perop to be deleted!
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .peropDelete(!num is REAL)
  -- Get user to confirm deletion
  !answer = !!alert.confirm(!!messageFile.messageString(141, 8, |Perop|, !this.listAdmPerop[!num].name))
  if (!answer.boolean().not()) then
    -- User said NO
    return
  endif

  !this.listAdmPerop[!num].deletePerop()
  !this.setPeropList(!this.roleGet())
  !!admPeropTxtList(!this.listAdmPerop,!this.listPerop,false)

  -- deactivate modify buttons on form !!admRole if no perops set
  !this.greyModify(!this.listPerop)
endmethod
-- End of method definition for .peropDelete(REAL)
------------------------------------------------------------------------
--
-- Method: .moveElement
--
-- Description: reorders items in a gadget list
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      Direction to move in (UP/DOWN)
--   2   RW     GADGET      Gadget to reorder items in
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveElement(!direction is STRING, !listGadget is GADGET)
  if(!listGadget.dText.size() lt 2)then
    -- There is only one element nothing to do!
    return
  endif

  !currSel = !listGadget.val
  if((!direction EQ |UP|) AND (!currSel NEQ 1))then
    !vector = -1
  elseif((!direction EQ |DOWN|) AND (!currSel NEQ !listGadget.dText.size()))then
    !vector = 1
  else
    return
  endif

  -- swap order of members in the role list
  !!comMemberSwap(!currSel, !currSel + !vector , !this.roleGet())
  -- update list of perop objects
  !this.setPeropList(!this.roleGet())

  !!admPeropTxtList(!this.listAdmPerop,!listGadget,False)

  !listGadget.val = !currSel + !vector

endmethod
-- End of method definition for .moveElement(STRING, GADGET)

------------------------------------------------------------------------
--
-- Method: .greyModify()
--
-- Description: grey gadgets [modifyPerop |Modify|], [.deletePerop |Delete|], if
--              no permissible operations for role.
--              ***** WARNING this method is also called from admperop.pmlfrm *****
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1     R     GADGET     List of defined perops
-- Return:
--
------------------------------------------------------------------------
define method .greyModify(!gadget is GADGET)

  if (!gadget.dText.empty()) then
    -- empty list deactivate the gadgets
    !this.modifyPerop.active = FALSE
    !this.deletePerop.active = FALSE
  else
    -- not empty - activate the gadgets
    !this.modifyPerop.active = TRUE
    !this.deletePerop.active = TRUE
  endif

endmethod
-- End of method definition for .greyModify(GADGET)
--
------------------------------------------------------------------------
--
-- Method: .setPeropList(DBREF)
--
-- Description: Set Perop list (array of ADMPEROP) from role element
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--
------------------------------------------------------------------------
define method .setPeropList( !role is DBREF )

  -- I don't Like this although it is a fast and quick way of getting
  -- the perops (remembering the mem of a role are perops)
  !this.listAdmPerop.clear()
  !peropList = !role.mem
  do !perop values !peropList
    !temp = object ADMPEROP()
    !temp.perop2AdmPerop(!perop)
    !this.listAdmPerop.append(!temp)
  enddo

endmethod
-- End of method definition for .setPeropList(DBREF)
