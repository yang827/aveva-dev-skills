--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Wed Dec 2 11:31:46 GMT 1998
--
--
-- Description:
-- The form needed to create/modify the admin element SCOPE
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   Method to create and modify Scope elements.
--  cbMode()                         -                   Callback to the mode gadget in the PEROP Definition form.
--  cbName(GADGET)                   -                   Method to act as a callback to the Name gadget in the Scope form.
--  display(STRING)                  -                   Method to display the SCOPE definition form.
--  init()                           -                   initialise form
--  modeGet()                        STRING              Function to return the current mode of the PEROP Definition form.
--  modeSet(STRING)                  -                   Method to set the mode of the PEROP Definition form.
--  scopeGet()                       DBREF               A method to return the current scope
--  scopeSet(DBREF)                  -                   A method to set the current method
--  update()                         -                   method to update the displayed SCOPE in the SCOPE Definition
--  validateExpression(GADGET,STRING) -                   Method to validate the expression input for the SCOSEL attribute of the scope
--
------------------------------------------------------------------------

setup form !!admScope

  !this.formTitle     = 'Scope Definition'
  !this.iconTitle     = 'SCOPE'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.11 $ '

  -- Body of form definition
  text   .name at x 3 y 0.2 |Name        | call |!this.cbName(!this.name)|  width 20 scroll 49 NAME
  option .mode at xmax+2 ymin call |!this.cbMode()| width 10
  text   .desc at xmin.name ymax+0.2 |Description | width 32 scroll 120 STRING
  para   .scopSelTxt at xmin ymax+0.2 text |Scope Selection|
  text   .scopSel at xmin ymax+0.2 width 46 scroll 256 STRING
  button .apply   at x 0 ymax+0.5 |Apply| call |!this.cbApply()| APPLY
  button .reset   at xcen form-0.5 * size ymin |Reset| RESET
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  --Member Definitions
  member .scope is DBREF

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  --- Assign Mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !this.mode.dText  = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !this.mode.rText  = !rText
  !rText.clear()

  -- Validation call for SCOPSEL attribute
  !this.scopSel.validateCall = '!this.validateExpression('

exit
-- End of form definition for !!admScope
------------------------------------------------------------------------
--
-- Method: .scopeGet()
--
-- Description: A method to return the current scope
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--  DBREF       The current Scope funnily enough!
------------------------------------------------------------------------
define method .scopeGet() is DBREF
  return !this.scope
endmethod
-- End of method definition for .scopeGet() DBREF
------------------------------------------------------------------------
--
-- Method: .scopeSet()
--
-- Description: A method to set the current method
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R            DBREF       The scope the current form is to be set to!
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .scopeSet(!dbRef is DBREF)
  !this.scope = !dbRef
endmethod
-- End of method definition for .scopeSet(DBREF)
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
  -- Initialise variables
  !mode    = !this.modeGet()
  !dbRef   = !this.scopeGet()
    -- Check the current mode
  if (!mode eq 'CREATE') then
    -- Set the form title
    !this.formTitle  = 'Create Scope'
    -- Set the form gadgets
    !this.name.val   = |unset|
    !this.desc.val   = |unset|
    !this.scopSel.val = ||
  elseif (!mode eq 'MODIFY') then
    -- Set the form title
    !this.formTitle  = 'Modify Scope: ' + !dbRef.name.substring(2)
    -- Set the form gadgets
    !scopeName = !dbRef.name
    if( !scopeName.substring(1,1) eq '=' ) then
      !this.name.val = 'unset'
    else
      !this.name.val = !scopeName.substring(2)
    endif
    if (!dbRef.description.empty()) then
      !this.desc.val   = |unset|
    else
      !this.desc.val   = !dbRef.description
    endif
    if(!dbRef.scoSel.set())then
      !prevPos = !!ce
      !!ce = !dbRef
      var !temp SCOSEL
      !this.scopSel.val = !temp.trim()
      !!ce = !prevPos
      !!ce
    else
      !this.scopSel.val = ||
    endif
  endif
endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:      .update()
--
-- Description: method to update the displayed SCOPE in the SCOPE Definition
-- form. The form must be displayed and in MODIFY mode.
--
------------------------------------------------------------------------
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update()

  -- Return if the form is not shown
  if (Undefined (!!admScope) or not !this.shown()) then
    return
  endif

  -- Initialise variables
  !mode    = !this.modeGet()
  !selLoc  = !!adminElem.scopeGet()
  !curLoc  = !this.scopeGet()

  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif

  -- Return if the same reference
  if (!selLoc eq !curLoc) then
    return
  endif

  -- Reinitialise the form
  !this.scopeSet(!selLoc)
  !this.init()

endmethod
-- End of method definition for .update()
------------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Method to display the SCOPE definition form.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display form in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display(!mode is STRING)
  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY') then
    -- Invalid mode
    return error |Invalid mode for form !!admTeam|
  endif
  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then
    !this.scopeSet(object DBREF())
  elseif (!mode eq 'MODIFY') then
    !dbRef   = !!adminElem.scopeGet()
    if (!dbRef.unset()) then
      -- No action required
      return
    elseif (!dbRef eq !this.scopeGet() and !this.shown()) then
      -- No action required
      return
    endif
    -- Set the new locations
    !this.scopeSet(!dbRef)
  endif
  -- Select the mode
  !this.modeSet(!mode.upcase())
  -- Show or update the form
  if (!this.shown()) then
    -- Re-Initialise the form
    !this.init()
  else
    -- Show the form
    show !!admScope free
  endif
endmethod
-- End of method definition for .display(STRING)
------------------------------------------------------------------------
--
-- Method:      .modeGet()
--
-- Description: Function to return the current mode of the PEROP Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Mode of form.
--
-----------------------------------------------------------------------
define method .modeGet() is STRING
  -- Return the mode
  return !this.mode.selection('rtext')
endmethod
-- End of method definition for .modeGet() STRING
------------------------------------------------------------------------
--
-- Method:      .modeSet()
--
-- Description: Method to set the mode of the PEROP Definition form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       STRING      Mode to set (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modeSet(!mode is STRING)
  -- Store the mode gadget
  !this.mode.select('rtext',!mode.upcase())
  handle any
    -- Dummy handle (should not happen)
  endhandle
endmethod
-- End of method definition for .modeSet(STRING)
------------------------------------------------------------------------
--
-- Method:      .cbMode()
--
-- Description: Callback to the mode gadget in the PEROP Definition form.
--
-- method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .cbMode()
  -- Read the mode value
  !mode    = !this.modeGet()
  -- Call the display method to reset the form
  !this.display(!mode)
endmethod
-- End of method definition for .cbMode()
------------------------------------------------------------------------
--
-- Method:      .cbName()
--
-- Description: Method to act as a callback to the Name gadget in the Scope form.
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define Method
define method .cbName(!gadget is GADGET)

  call !!admGenNameChk(!gadget, !this.modeGet(), !this.scopeGet())

endmethod
-- End of method definition for .cbName(GADGET)

------------------------------------------------------------------------
--
-- Method:      .cbApply()
--
-- Description: Method to create and modify Scope elements.
--
------------------------------------------------------------------------
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .cbApply()
  -- Initialise variables
  !dbRef            = !this.scopeGet()
  !mode             = !this.modeGet().upcase()
  !updateFlag       = false
  -- Check that all parameters are set
  if (_name.val eq 'unset') then
    -- Reset the name if modify mode
    if (!mode eq 'MODIFY') then
      _name.val         = !dbRef.name.substring(2)
    endif
    -- ##
    -- Raise error
    !!alert.error(|No name has been specified|)
    return
  endif
  -- Get all the new attribute values
  !scopeName           =  |/| + _name.val
  !description         =  !this.desc.val
  if(!this.scopSel.val.empty())then
    -- ##
    !!alert.error(|This Scope has no selection please enter one!|)
    return
  else
    !scopeSel            =  !this.scopSel.val.trim()
  endif
  -- Act on Scope according to mode
  if (!mode eq 'CREATE') then
    -- Navigate to the Global Location World
    !!ce                   = !!dbrAdminGetWorld('SCOPE')
    call !!admCommand(|NEW SCOPE $!scopeName|)
    -- ##
    handle any
      -- Delete Scope
      call !!admCommand(|DELETE SCOPE|)
      -- Raise error
      !!alert.error(|This scope cannot be created, check entered fields|)
      !this.name.val              = |unset|
      return
    endhandle
    -- Set attributes
    DESC  |$!description|
    SCOSEL $!scopeSel
    handle (47,62)
      -- ##
      !!alert.error(|Scope selection field is incomplete|)
      call !!admCommand(|DELETE SCOPE|)
      return
    elsehandle (47,15)
      -- ##
      !!alert.error(|Scope selection field is invalid|)
      call !!admCommand(|DELETE SCOPE|)
      return
    endhandle
    !!prompt(0)
    -- Set the current Scope
    !!adminElem.scopeSet(!!ce)
    -- Set the update flag
    !updateFlag            = true
  elseif (!mode eq 'MODIFY') then
    -- Check for element being already claimed
    if (not !!dbRefUpdate (!dbRef)) then
      !!alert.error (!!error.text)
      return
    endif
    if(!this.scopSel.val EQ ||)then
      -- ##
      !!alert.error(|This Scope is not allowed to have a Blank Selection|)
      return
    endif
    -- Modify the current Scope element.
    -- Navigate to Scope element
    !!ce                   = !dbRef
    -- See if the name need modifying
    if (!scopeName neq !dbRef.name) then
      -- Modify the name
      call !!admCommand(|NAME $!scopeName|)
      -- ##
    handle any
      -- Scope name already exists
      !!alert.error(|This Scope name already exists|)
      !this.name.val              = !dbRef.name.substring(2)
      return
    endhandle
      -- Change the formTitle
      !this.formTitle     = |Modify Scope: | + !dbRef.name
      !updateFlag            = true
    endif
    var !temp SCOSEL
    if(!scopeSel.upcase() NEQ !temp.upcase())then
       call !!admCommand(|SCOSEL $!scopeSel|)
      handle (47,62)
        -- ##
        !!alert.error(|Scope selection field is incomplete|)
        return
      elsehandle (47,15)
        -- ##
        !!alert.error(|Scope selection field is invalid|)
        return
      endhandle
      !updateFlag = TRUE
      -- ##
    endif
    -- Check DESC modification
    if (!description neq 'unset' and !description neq !dbRef.description) then
      -- Modify the description
      DESC |$!description|
      !updateFlag            = true
    endif
  endif
  -- Check to see if the Admin Elements form needs refreshing
  if (!updateFlag) then
    !!adminElem.update('SCOPE')
  endif
  -- Reset the form for creation (if applicable)
  if (!mode eq 'CREATE') then
   !this.display('CREATE')
  endif
endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method:      .validateExpression()
--
-- Description: Method to validate the expression input for the SCOSEL attribute of the scope
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     GADGET      Name gadget
--    2   R     STRING      Value of gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define Method
define method .validateExpression(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.val.string().trim().length().eq(0)) then
    return error 1 'Invalid input.'
  else
    !memory = !!ce
    -- Go to the scopeworld
    /*SC
    NEW SCOPE
    call !!expressionChk(!!ce, !!admScope.scopSel.val, 'SCOSEL')
    handle ANY
      DELETE SCOPE
      !reason  = !!error.text
      !!ce     = !memory
      return error 1 '$!reason'
    elsehandle NONE
      DELETE SCOPE
    endhandle
  endif

  !!ce = !memory

endmethod
-- End of method definition for .validateExpression(GADGET, STRING)
