-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      setConditionsOption()
--
-- Description: Sets active flag on conditions button according to toggle
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .setConditionsOption()

  if !this.condFlag.val.not() then
    if (!this.condUser.size() gt 0) or (!this.condHost.size() gt 0) $
        or !this.condBeforeSet or !this.condAfterSet then
      -- Conditions are specified, so get user to confirm discard
      !answer = !!alert.confirm('Do you also wish to discard the specified conditions?')

      if !answer.boolean() then
        !this.condUser.clear()
        !this.condHost.clear()
        !this.condBeforeSet = false
        !this.condAfterSet = false
      endif
    endif
  endif
  !this.conditions.active = !this.condFlag.val

endmethod
-- End of method definition for .setConditionsOption()

------------------------------------------------------------------------
--
-- Method:      setInput()
--
-- Description: Validates input filename if entered directly
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .setInput()

  !file = object FILE()
  !file.file( !this.inputFile.val )
  if (!file.unset() or !file.exists().not()) then
    !!alert.warning( 'Input script file does not exist.' )
    !this.inputFile.val = ||
  else
    !this.outputFile.setFocus()
  endif

endmethod
-- End of method definition for .setInput()

------------------------------------------------------------------------
--
-- Method:      setInputOption()
--
-- Description: Sets active flag on input script box according to toggle
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .setInputOption()

  !this.inputFile.active = !this.inputFlag.val
  !this.inputBrowse.active = !this.inputFlag.val

endmethod
-- End of method definition for .setInputOption()

------------------------------------------------------------------------
--
-- Method:      setMdbOption()
--
-- Description: Sets active flag on MDB selection according to toggle
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .setMdbOption()

  !this.mdb.active = !this.mdbFlag.val
  !this.mdbForm.active = !this.mdbFlag.val

endmethod
-- End of method definition for .setMdbOption()

------------------------------------------------------------------------
--
-- Method:      setModuleOption()
--
-- Description: Sets active flag on Module selection according to toggle
--
-- Method Type: Function
--
------------------------------------------------------------------------
--define method .setModuleOption()
--
--  !this.modules.active = !this.modFlag.val
--
--endmethod
-- End of method definition for .setModuleOption()

------------------------------------------------------------------------
--
-- Method:      setOutput()
--
-- Description: Validates output filename if entered directly
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .setOutput()

  !file = object FILE()
  !file.file( !this.outputFile.val )
  if (!file.unset().not() and !file.exists()) then
    -- Get user to confirm overwrite
    !answer = !!alert.confirm('File ' & !file.fullname() & ' exists. Do you wish to overwrite?')

    if (!answer.boolean().not()) then
      !this.outputFile.val = ||
    else
      !this.confirmedOverwrite = true
      !this.ok.setFocus()
    endif
  else
    !this.ok.setFocus()
  endif

endmethod
-- End of method definition for .setOutput()

------------------------------------------------------------------------
--
-- Method:      showInputBrowser()
--
-- Description: Action on Input Browse button
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .showInputBrowser()

  !!fileBrowser('%PDMSUSER%', '.mac', 'Script Generation Input File', $
                true, '!!admScriptGenerate.inputFile.val = !!fileBrowser.file.name()')
endmethod
-- End of method definition for .showInputBrowser()


------------------------------------------------------------------------
--
-- Method:      showOutputBrowser()
--
-- Description: Action on Output Browse button
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .showOutputBrowser()

  !!fileBrowser('%PDMSUSER%', 'projectentry.mac', 'Script Generation Output File', $
                false, '!!admScriptGenerate.outputFile.val = !!fileBrowser.file.name()')

  -- Overwrite confirmation is handled by fileBrowser
  !this.confirmedOverwrite = true

endmethod
-- End of method definition for .showOutputBrowser()

------------------------------------------------------------------------
--
-- Method:      cancel()
--
-- Description: hides the form
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .cancel()

  !this.hide()

endmethod
-- End of method definition for .cancel()
