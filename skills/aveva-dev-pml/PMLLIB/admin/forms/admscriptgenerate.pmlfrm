------------------------------------------------------------------------
--
-- Method:      !setUserName()
--
-- Description: action for setting userName and checking for Authentication
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .setUserName()

  -- Chop off leading slash
  if !this.userName.val.subString(1,1).eq('/') then
    !this.userName.val = !this.userName.val.after('/')
  endif

  !unusedUser = object USER( !this.userName.val )
  handle any
    !!alert.warning( 'User name is not valid. Please enter a known user name.' )
    !this.userName.val = ||
    !this.userName.setFocus()
  elsehandle none
    !this.passwd.setFocus()
  endhandle

endmethod
-- End of method definition for .setUserName()

------------------------------------------------------------------------
--
-- Method:      !setPassword()
--
-- Description: action for setting password
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .setPassword()

  if ( !this.userName.val eq || ) then
    !!alert.warning( 'User name not specified. Please enter user name before password.' )
    !this.passwd.val = ||
    !this.passwd2.val = ||
    !this.userName.setFocus()
  elseif ( !this.passwd.val ne !this.passwd2.val ) then
    !!alert.warning( 'Passwords do not match. Please enter and confirm password.' )
    !this.passwd.val = ||
    !this.passwd2.val = ||
    !this.passwd.setFocus()
  else
    -- Check password (username leading slash already chopped)
    !u = object USER( !this.userName.val )
    handle any
    elsehandle none
      !valid = !u.confirmID( |/| & !this.passwd.val )
      if ( !valid.boolean().not() ) then
        !!alert.warning( 'Password is not valid for user ' & !u.name &'. Please enter and confirm correct password.' )
        !this.passwd.val = ||
        !this.passwd2.val = ||
        !this.passwd.setFocus()
      else
        !this.outputFile.setFocus()
      endif
    endhandle
  endif

endmethod
-- End of method definition for .setPassword()

------------------------------------------------------------------------
--
-- Method:      !setMdb()
--
-- Description: action for setting mdb via text gadget
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .setMdb()

  -- Chop off leading slash
  if !this.mdb.val.subString(1,1).eq('/') then
    !this.mdb.val = !this.mdb.val.after('/')
  endif

  if (!this.mdb.val.trim() eq '') then
    !mdb = ''
  else
    !mdb = '/' + !this.mdb.val
  endif

  $!mdb
  handle any
    !!alert.warning( 'The named MDB is not valid. Please enter a known MDB.' )
    !this.mdb.val = ''
    !this.mdb.setFocus()
  elsehandle NONE
    if (!!ce.type neq 'MDB') then
      !!alert.warning( 'The named MDB is not valid. Please enter a known MDB.' )
      !this.mdb.val = ''
      !this.mdb.setFocus()
    else
      !this.ok.setFocus()
    endif
  endhandle

endmethod
-- End of method definition for .setMdb()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: action for ok button
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  if ( !this.userName.val.trim() eq || ) then
    !!alert.warning( 'User name has not been entered.' )

  elseif ( !this.passwd2.val.trim() eq || ) then
    !!alert.warning( 'Password has not been entered and confirmed.' )

  elseif ( !this.outputFile.val.trim() eq || ) then
    !!alert.warning( 'Output script filename has not been entered.' )

  else
    -- Generate script using generator object
    !generator = object PMLSECURELOGIN()

    !generator.project( !this.project.val )
    !generator.user( !this.userName.val )
    !generator.password( !this.passwd.val )
    if !this.mdbFlag.val then
      if (!this.mdb.val.trim() ne '') then
        !mdb = '/' + !this.mdb.val
        !generator.mdb( !mdb )
      endif
    endif
    -- if !this.modFlag.val then
    --  !generator.module( !this.module.selection() )
    -- endif
    if !this.condFlag.val then
      if !this.condUser.size() gt 0 then
        !generator.verifyWinUsers( !this.condUser )
      endif
      if !this.condHost.size() gt 0 then
        !generator.verifyHostnames( !this.condHost )
      endif
      if !this.condBeforeSet then
        !generator.verifyBefore( !this.condBefore )
      endif
      if !this.condAfterSet then
        !generator.verifyAfter( !this.condAfter )
      endif
    endif

    if (!this.inputFlag.val and !this.inputFile.val.trim() ne ||) then
      !generator.macro( !this.inputFile.val )
      !generator.embedMacro( true )
    endif

    -- Check against unconfirmed overwrite
    !file = object FILE()
    !file.file( !this.outputFile.val )
    if (!file.unset().not() and !file.exists()) then
      if !this.confirmedOverwrite.not() then
        -- Get user to confirm overwrite
        !answer = !!alert.confirm('File ' & !file.fullname() & ' exists. Do you wish to overwrite?')

        if (!answer.boolean().not()) then
          -- Clear Output and return
          !this.outputFile.val = ||
          return
        else
          !this.confirmedOverwrite = true
        endif
      endif
    endif

    !generator.saveToFile( !this.outputFile.val )

    !this.hide()

  endif
endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      !cancel()
--
-- Description: action for Cancel button
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
--define method .cancel()
