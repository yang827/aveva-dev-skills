--
-- Description:
-- Definition of Admin batch script generation form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admScriptGenerate()              -                   constructor
--  cancel()                         -                   hides the form
--  init()                           -                   initialise
--  ok()                             -                   action for ok button
--  setConditionsOption()            -                   action on conditions toggle
--  setInput()                       -                   action on manual input entry
--  setInputOption()                 -                   action on input toggle
--  setMdb()                         -                   action for setting mdb
--  setMdbOption()                   -                   action on mdb toggle
--  setOutput()                      -                   action on manual output entry
--  setPassword()                    -                   action to set the users password
--  setUserName()                    -                   action for setting userName and checking for Authentication
--  showInputBrowser()               -                   Action on Input Browse button
--  showOutputBrowser()              -                   Action on Output Browse button
--
setup form !!admScriptGenerate

  member .condUser is ARRAY
  member .condHost is ARRAY
  member .condBefore is DATETIME
  member .condAfter is DATETIME
  member .condBeforeSet is BOOLEAN
  member .condAfterSet is BOOLEAN
  member .confirmedOverwrite is BOOLEAN

  -- Body of form definition
  text   .project  at xmin ymax+0.2 |Project   |  width 20 string

  text   .userName at xmin.project ymax.project |Username  | width 20 string
  button .uSel at xmax ymin pixmap width 9 height 12

  text   .passwd   at xmin.project ymax.userName+0.5 |Password  | width 20 noecho string
  text   .passwd2  at xmin.project ymax |Confirm   | width 20 noecho string

  toggle .mdbFlag at xmin.project ymax+0.5
  text   .mdb     at xmax ymin |MDB     |  width 20 string
  button .mdbForm at xmax ymin pixmap width 9 height 12

  toggle .condFlag at xmin.project ymax+0.5
  button .conditions at xmax+9 ymin  | Conditions.. | call |show !!admScriptGenerateAdv|

  toggle .inputFlag at xmin.project ymax+0.5
  text   .inputFile at xmax ymin |Input| width 30 string
  button .inputBrowse at xmax ymin |Browse...| call |!this.showInputBrowser()|

  text   .outputFile at xmin.project ymax+0.5 |Output | width 30 string
  button .outputBrowse at xmax ymin |Browse...| call |!this.showOutputBrowser()|

  button .ok at xmin.project ymax+0.5 |  OK  |
  button .cancel at xmax form-size ymin |Cancel| cancel

exit
-- End of form definition for !!admScriptGenerate

------------------------------------------------------------------------
--
-- Method:      !admScriptGenerate()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .admScriptGenerate()

  !this.formTitle     = 'Command Script Generation'
  !this.iconTitle     = 'Command Script Generation'
  !this.callback      = '!this.init()'
  !this.formRevision  = ''

  !comboBoxIcon = !!pml.getPathName('comboboxarrow9x12.png')
 -- callbacks
  !this.userName.callback   = |!this.setUserName()|
  !this.uSel.callback       = |show !!selectuser|
  !this.passwd2.callback    = |!this.setPassword()|
  !this.mdbFlag.callback    = |!this.setMdbOption()|
  !this.mdb.callback        = |!this.setMdb()|
  !this.mdbForm.callback    = |show !!selectMdb|
--  !this.modFlag.callback    = |!this.setModuleOption()|
--  !this.modules.callback    = |!this.selectModule()|
  !this.condFlag.callback   = |!this.setConditionsOption()|
  !this.inputFile.callback  = |!this.setInput()|
  !this.inputFlag.callback  = |!this.setInputOption()|
  !this.outputFile.callback = |!this.setOutput()|

  !this.cancelCall      = '!this.cancel()'
  !this.cancel.callback = '!this.cancel()'
  !this.ok.callback = '!this.ok()'
  !this.uSel.addPixmap(!comboBoxIcon)
  !this.mdbForm.addPixmap(!comboBoxIcon)

  -- Project textbox is inactive, for info only
  !this.project.active = FALSE

  -- set MDB to inactive
  !this.mdbFlag.val    = FALSE
  !this.mdb.active     = FALSE
  !this.mdbForm.active = FALSE

  -- set conditions to inactive
  !this.condFlag.val      = FALSE
  !this.conditions.active = FALSE

  -- set input to be inactive
  !this.inputFlag.val      = FALSE
  !this.inputFile.active   = FALSE
  !this.inputBrowse.active = FALSE



  -- initialise the modules option gadget
--  !dText = ARRAY()
--  !rText = ARRAY()
--  !dText.append('')
--  !rText.append('')
--  !!modulesArray = !!moduleData()
--  do !moduleDef values !!modulesArray
--    skip if (!moduleDef.command.upcase() eq 'SUBMENU')
--    !dText.append(!moduleDef.dText)
--    !rText.append(!moduleDef.command.upcase())
--  enddo
--  !this.modules.dText = !dText
--  !this.modules.rText = !rText

  -- TO DO : generalise user and MDB selection
  --       : from Monitor appware. Gadgets inactive for now..
--  !this.uSel.active = false
--  !this.mdbForm.active = false

  -- check for "embed input script" capability
  !this.inputFlag.active = false
  !generator = object PMLSECURELOGIN()
  handle any
  elsehandle none
    if !generator.hasLicenceToEmbedMacro() then
      -- Input script embedding only available if licence allows
      !this.inputFlag.active = true
    endif
  endhandle

  -- initialise conditions
  !this.condUser.clear()
  !this.condHost.clear()
  !this.condBeforeSet = false
  !this.condAfterSet = false

  -- initialise all dialog settings
--  !this.reset()

endmethod
-- End of method definition for .admScriptGenerate()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: constructor
--
-- Method Type: Procedure
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .init()

  -- Preserve properties except for password x 2
  !this.passwd.val     = ''
  !this.passwd2.val    = ''

  !p = CURRENT PROJECT
  !this.project.val = !p.code()

  -- Set details according to CE
  if !!ce.set() then
    if !!ce.type ne |USER| then
      if !!ce.type eq |MDB| then
        -- Set MDB
        !this.mdb.val = !!ce.name
        -- Chop off leading slash
        if !this.mdb.val.subString(1,1).eq('/') then
          !this.mdb.val = !this.mdb.val.after('/')
        endif
        !this.mdbFlag.val = true
        !this.setMdbOption()
      endif
      !this.keyboardFocus = !this.userName
    else
      -- Set USER
      !this.userName.val = !!ce.name
      -- Chop off leading slash
      if !this.userName.val.subString(1,1).eq('/') then
        !this.userName.val = !this.userName.val.after('/')
      endif

      !this.keyboardFocus = !this.passwd
    endif
  endif

  -- !this.modules.select('rtext', !!sessionSettings.module.upcase())
  -- handle any
  -- endhandle
  -- !this.selectModule()

  -- Initialise activation of gadgets based on restored module selection
  -- !this.selectModule()

  -- Re-confirm overwrite in fresh dialog
  !this.confirmedOverwrite = false

endmethod
-- End of method definition for .init()


