-- File:            admscriptgenerateadv.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:
-- Created:         Mon Jul 20 2009
--
--
-- Description:
-- Form definition to specify environmental conditions applies to
-- encrypted login script generation.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admScriptGenerateAdv()           -                   constructor
--  dataLoad()                       -                   load data from parent form
--  hostEdit()                       -                   action for host Edit button
--  hostRemove()                     -                   action for host Remove button
--  hostSel()                        -                   action for host selection
--  hostSet()                        -                   action for host text entry
--  hostsRefresh()                   -                   method to refresh hosts gadget from array
--  init()                           -                   initialise form
--  ok()                             -                   action for OK button
--  setAfterFlag()                   -                   action for after toggle
--  setBeforeFlag()                  -                   action for before toggle
--  setupDates()                     -                   setup date selectors
--  userEdit()                       -                   action for user Edit button
--  userRemove()                     -                   action for user Remove button
--  userSel()                        -                   action for user selection
--  userSet()                        -                   action for user text entry
--  usersRefresh()                   -                   method to refresh users gadget from array
--
------------------------------------------------------------------------

-- Define form
setup form !!admScriptGenerateAdv at xr 0.35 yr 0.1 resize

  !!admScriptGenerateAdv.formTitle     = 'Command Script Conditions'
  !!admScriptGenerateAdv.iconTitle     = ''
  !!admScriptGenerateAdv.callback      = '!!admScriptGenerateAdv.init()'
  !!admScriptGenerateAdv.formRevision  = ''

  member .usersArray is ARRAY
  member .hostsArray is ARRAY

  member .userEditIndex is REAL
  member .hostEditIndex is REAL

  -- Body of form definition
  frame .userFrame at x 0 y 0 anchor top+left+right |Allowed Windows Users|

    text .user |Add User| at xmin.userFrame+1 ymin+1 width 45 string
    list .users at xmin.userFrame+1 ymax+0.5 anchor top+left+right call |!this.userSel()| width 45 height 5
    button .userEdit at xmax ymin anchor right |Edit| call |!this.userEdit()|
    button .userRemove at xmin ymax anchor right |Remove| call |!this.userRemove()|
  exit

  frame .hostFrame at x 0 ymax+0.2 anchor all |Allowed Host Computers|
    text .host |Add Host| at xmin.hostFrame+1 ymin+1 width 45 string
    list .hosts at xmin.hostFrame+1 ymax+0.5 anchor top+left+right call |!this.hostSel()| width 45 height 5
    button .hostEdit at xmax ymin anchor right |Edit| call |!this.hostEdit()|
    button .hostRemove at xmin ymax anchor right |Remove| call |!this.hostRemove()|
  exit

  frame .timeFrame at x 0 ymax+0.2 anchor bottom+left |Allowed Time Period|
    toggle .beforeFlag at xmin+1 ymin+1 call |!this.setBeforeFlag()|
    path right
    para .before text |Before |
    option .beforeDay   width 2
    option .beforeMonth width 3
    option .beforeYear  width 4

    toggle .afterFlag at xmin.timeFrame+1 ymax.before call |!this.setAfterFlag()|
    path right
    para .after text |After  |
    option .afterDay   width 2
    option .afterMonth width 3
    option .afterYear  width 4
  exit

  button .ok at xmin ymax+0.5 anchor bottom+left | OK | call |!this.ok()|
  button .cancel at xmax form-size ymin anchor bottom+right |Cancel| CANCEL

exit
-- End of form definition for !!admScriptGenerateAdv


------------------------------------------------------------------------
--
-- Method:      !admScriptGenerateAdv()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .admScriptGenerateAdv()

  !this.usersArray = ARRAY()
  !this.hostsArray = ARRAY()

  !this.userEditIndex = 0
  !this.hostEditIndex = 0

endmethod
-- End of method definition for .admScriptGenerateAdv()

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: method to initialise the Script Conditions form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  !this.usersArray = object ARRAY()
  !this.hostsArray = object ARRAY()

  !this.userEditIndex = 0
  !this.hostEditIndex = 0

  -- callbacks
  !this.user.callback = |!this.userSet()|
  !this.host.callback = |!this.hostSet()|

  -- Set up date selectors
  !this.setupDates()

  -- Load data from parent form
  !this.dataLoad()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method: userRemove()
--
-- Description: Callback method for user Remove button
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .userRemove()

  !selectIndex = !this.users.val
  if !selectIndex gt 0 then
    !this.usersArray.remove( !selectIndex )
    !this.usersRefresh()
  endif

endmethod
-- End of method definition for .userRemove()


------------------------------------------------------------------------
--
-- Method: userEdit()
--
-- Description: Callback method for user Edit button
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .userEdit()

  !selection = !this.users.selection('rtext')
  if !selection.set() then
    !this.user.tag = |Edit User|
    !this.user.val = !selection
    !this.userEditIndex = !this.users.val
    !this.userRemove.active = false
    !this.userEdit.active = false
  endif

endmethod
-- End of method definition for .userEdit()

------------------------------------------------------------------------
--
-- Method: userSet()
--
-- Description: Callback method for user textbox
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .userSet()

  if !this.userEditIndex gt 0 then
    -- Edit in progress
    !this.usersArray[ !this.userEditIndex ] = !this.user.val
  else
    -- Add new entry
    !this.usersArray.append( !this.user.val )
  endif

  -- Clear value and edit
  !this.user.tag = |Add User|
  !this.user.val = ||
  !this.userEditIndex = 0

  -- Refresh list
  !this.usersRefresh()
  !this.user.setFocus()

endmethod
-- End of method definition for .userSet()

------------------------------------------------------------------------
--
--Method: userSel()
--
-- Description: Callback method for selection of a windows user
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .userSel()

  !selection = !this.users.selection('rtext')
  if !selection.set() then
    !this.userRemove.active = true
    !this.userEdit.active = true
  endif
  -- Clear edit
  if !this.userEditIndex gt 0 then
    !this.userEditIndex = 0
    !this.user.tag = |Add User|
    !this.user.val = ||
  endif

endmethod
-- End of method definition for .userSel()

------------------------------------------------------------------------
--
-- Method: usersRefresh()
--
-- Description: method to refresh users gadget from array
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .usersRefresh()
  !this.users.clear()
  do !u values !this.usersArray
    !this.users.add( !u )
  enddo
  !items = (!this.usersArray.size() gt 0)
  !this.userRemove.active = !items
  !this.userEdit.active = !items

endmethod
-- End of method definition for .usersRefresh()

------------------------------------------------------------------------
--
-- Method: hostRemove()
--
-- Description: Callback method for hostname Remove button
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .hostRemove()

  !selectIndex = !this.hosts.val
  if !selectIndex gt 0 then
    !this.hostsArray.remove( !selectIndex )
    !this.hostsRefresh()
  endif

endmethod
-- End of method definition for .hostRemove()

------------------------------------------------------------------------
--
-- Method: hostEdit()
--
-- Description: Callback method for hostname Edit button
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .hostEdit()

  !selection = !this.hosts.selection('rtext')
  if !selection.set() then
    !this.host.tag = |Edit Host|
    !this.host.val = !selection
    !this.hostEditIndex = !this.hosts.val
    !this.hostRemove.active = false
    !this.hostEdit.active = false
  endif

endmethod
-- End of method definition for .hostEdit()

------------------------------------------------------------------------
--
-- Method: hostSet()
--
-- Description: Callback method for hostname textbox
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .hostSet()

  if !this.hostEditIndex gt 0 then
    -- Edit in progress
    !this.hostsArray[ !this.hostEditIndex ] = !this.host.val
  else
    -- Add new entry
    !this.hostsArray.append( !this.host.val )
  endif

  -- Clear value and edit
  !this.host.tag = |Add Host|
  !this.host.val = ||
  !this.hostEditIndex = 0

  -- Refresh list
  !this.hostsRefresh()
  !this.host.setFocus()

endmethod
-- End of method definition for .hostSet()

------------------------------------------------------------------------
--
-- Method: hostSel()
--
-- Description: Callback method for selection of a hostname
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .hostSel()

  !selection    = !this.hosts.selection('rtext')
  if !selection.set() then
    !this.hostRemove.active = true
    !this.hostEdit.active = true
  endif
  -- Clear edit
  if !this.hostEditIndex gt 0 then
    !this.hostEditIndex = 0
    !this.host.tag = |Add Host|
    !this.host.val = ||
  endif

endmethod
-- End of method definition for .hostSel()

------------------------------------------------------------------------
--
-- Method: hostsRefresh()
--
-- Description: method to refresh hosts gadget from array
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .hostsRefresh()
  !this.hosts.clear()
  do !h values !this.hostsArray
    !this.hosts.add( !h )
  enddo
  !items = (!this.hostsArray.size() gt 0)
  !this.hostRemove.active = !items
  !this.hostEdit.active = !items

endmethod
-- End of method definition for .hostsRefresh()

------------------------------------------------------------------------
--
--Method: .ok()
--
-- Description: action method on OK button
-- Form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  !!admScriptGenerate.condUser = !this.usersArray
  !!admScriptGenerate.condHost = !this.hostsArray

  if !this.beforeFlag.val then
    !!admScriptGenerate.condBeforeSet = true
    !!admScriptGenerate.condBefore = $
        object DATETIME( !this.beforeYear.selection().real(), $
                         !this.beforeMonth.selection(), $
                         !this.beforeDay.selection().real() )
  endif
  if !this.afterFlag.val then
    !!admScriptGenerate.condAfterSet = true
    !!admScriptGenerate.condAfter = $
        object DATETIME( !this.afterYear.selection().real(), $
                         !this.afterMonth.selection(), $
                         !this.afterDay.selection().real() )
  endif

  !this.hide()

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:     dataLoad()
--
-- Description: Load in user conditions data from parent form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dataLoad()

  !this.usersArray = !!admScriptGenerate.condUser
  !this.usersRefresh()

  !this.hostsArray = !!admScriptGenerate.condHost
  !this.hostsRefresh()

  if !!admScriptGenerate.condBeforeSet then
    !d = !!admScriptGenerate.condBefore
  else
    !d = object DATETIME()
  endif
  !this.beforeDay.select( 'rtext', !d.date().string() )
  !this.beforeMonth.select( 'rtext', !d.monthString().subString(1,3) )
  !this.beforeYear.select( 'rtext', !d.year().string() )
  !this.beforeFlag.val = !!admScriptGenerate.condBeforeSet
  !this.setBeforeFlag()

  if !!admScriptGenerate.condAfterSet then
    !d = !!admScriptGenerate.condAfter
  else
    !d = object DATETIME()
  endif
  !this.afterDay.select( 'rtext', !d.date().string() )
  !this.afterMonth.select( 'rtext', !d.monthString().subString(1,3) )
  !this.afterYear.select( 'rtext', !d.year().string() )
  !this.afterFlag.val = !!admScriptGenerate.condAfterSet
  !this.setAfterFlag()

endmethod
-- End of method definition for .dataLoad()

------------------------------------------------------------------------
--
-- Method:     setupDates()
--
-- Description: setup the data for dates
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupDates()

  do !x to 31
    !day[!x] = !x.string()
  enddo
  !this.beforeDay.dText = !day
  !this.afterDay.dText  = !day

   !month[1] = 'Jan'
   !month[2] = 'Feb'
   !month[3] = 'Mar'
   !month[4] = 'Apr'
   !month[5] = 'May'
   !month[6] = 'Jun'
   !month[7] = 'Jul'
   !month[8] = 'Aug'
   !month[9] = 'Sep'
   !month[10] = 'Oct'
   !month[11] = 'Nov'
   !month[12] = 'Dec'

   !this.beforeMonth.dText = !month
   !this.afterMonth.dText  = !month

   !date = object DATETIME()
   !currentYear  = !date.year()
   do !x from !currentYear - 5 to !currentYear + 10
      !year[!x] = !x.string()
   enddo

   !this.beforeYear.dText = !year
   !this.afterYear.dText  = !year

endmethod
-- End of method definition for .setupDates()

------------------------------------------------------------------------
--
-- Method:     setBeforeFlag()
--
-- Description: action for Before toggle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setBeforeFlag()
  !!admScriptGenerate.condBeforeSet = !this.beforeFlag.val
  !this.beforeDay.active = !this.beforeFlag.val
  !this.beforeMonth.active = !this.beforeFlag.val
  !this.beforeYear.active = !this.beforeFlag.val
endmethod
-- End of method definition for .setBeforeFlag()

------------------------------------------------------------------------
--
-- Method:     setAfterFlag()
--
-- Description: action for After toggle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAfterFlag()
  !!admScriptGenerate.condAfterSet = !this.afterFlag.val
  !this.afterDay.active = !this.afterFlag.val
  !this.afterMonth.active = !this.afterFlag.val
  !this.afterYear.active = !this.afterFlag.val
endmethod
-- End of method definition for .setAfterFlag()
