--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Mon May 24 11:28:31 BST 1999
--
--
-- Description:
-- function to select databases from the set a user chooses
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admSelectDbSet()                 -                   constructor method for this form!
--  deselect()                       -                   This method will select all the dbs in the calling gadget
--  display(GADGET)                  -                   This is the method that will be called to display this form
--  init()                           -                   initialise method for this form
--  select()                         -                   This method will select all the dbs in the calling gadget
--

setup form !!admSelectDbSet

  !this.formTitle     = 'DB Set selection'
  !this.iconTitle     = 'Select DBSET'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition

  list   .sets |Select a Set of Databases| at xmin+1.2 ymax+0.2 call || COLUMNS MULTIPLE width 40 height 10
  option .setSort   at xmin   ymax+0.2 |Sort By| call |!this.init()| width 12
  text   .setFilter at xmax+1 ymin     |Filter|  call |!this.init()| width 15 STRING
  button .select at xmin.sets ymax+0.2 |Select| call |!this.select()| APPLY
  button .deselect at xmax+0.2 ymin |DeSelect| call |!this.deselect()| APPLY
  button .refresh at xmax+0.2 ymin |Refresh List| call |!this.init()|

  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  -- form member variables

  member .dbSets is ARRAY

  member .callingGadget is GADGET

exit
-- End of form definition for !!admSelectDbSet
------------------------------------------------------------------------
--
--Method: .admSelectDbSet()
--
-- Description: constructor method for this form!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .admSelectDbSet()
  !!admDbSetSortGadg(!this.setSort)
  !this.setFilter.val   = |*|
endmethod
-- End of method definition for .admSelectDbSet()

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: initialise method for this form
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  !form = !this.callingGadget.owner()
  -- This is only relevant for the global update and synchronise forms
  !gadget = !form.whichDbs
  handle ANY
    -- Not update or synchronise
  elsehandle NONE
    if (!gadget.selection() neq 'USER') then
      return error 1 'DB Set selection is only relevant for the User Databases option'
    endif
  endhandle

  !this.sets.clearSelection()
  !prev = !!ce
  -- get all dbsets
  !!ce = !!dbrAdminGetWorld('DBSET')
  !this.dbSets = !!ce.mem
  --list them in gadget
  !dbSetRefs  = !!adminFilterSort(!this.dbSets, !this.setSort, !this.setFilter)
  !!admDbSetTxtList(!dbSetRefs, !this.sets,!!admDisplayConfig.fmtDbSetGet(), !!admDisplayConfig.eleTypeGet())
  !!ce = !prev
endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
--Method: .display()
--
-- Description: This is the method that will be called to display this form
-- it will store the calling gadget reference in the relevant form member!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R/RW    GADGET      The calling gadget of this form!
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display(!caller is GADGET)

  !this.callingGadget = !caller

    -- Show or update the form
  if (!this.shown()) then
    -- Re-Initialise the form
    !this.init()
  else
    -- Show the form
    show !!admSelectDbSet free
  endif

endmethod
-- End of method definition for .display(GADGET)
------------------------------------------------------------------------
--
--Method: .select()
--
-- Description: This method will select all the dbs in the calling gadget
-- which are in the selected sets!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .select()
  !tempArray = ARRAY()
  do !i values !this.sets.selection(|rtext|)
    !tempArray.appendArray(!i.dbRef().dbsList)
  enddo
  !tempArray.sort()
  !tempArray.unique()
  !toBeSelected = ARRAY()
  do !j indices !this.callingGadget.rText
    !index = REAL()
    !index = !tempArray.findFirst(!this.callingGadget.rText[!j].dbRef())
    handle(2,813)
      -- rtext[!j] store as master/demo not /*master/demo or =16830/10 append /*
      !temp = |/*| + !this.callingGadget.rText[!j]
      !index = !tempArray.findFirst(!temp.dbRef())
    endhandle
    if(!index.set())then
      !toBeSelected.append(!j)
    endif
  enddo
  -- get current selected
  !sele =  !this.callingGadget.val
  !sele.appendArray(!toBeSelected)
  !sele.sort()
  !sele.unique()
  !this.callingGadget.val = !sele
  -- Any forms that require special callbacks!
  if(!this.callingGadget.owner().fullname().upcase() EQ |!!GLBSYNCHRDB| )then
    !!glbSynchrDb.cbDbSelection()
  endif
  if(!this.callingGadget.owner().fullname().upcase() EQ |!!GLBRMTSYNC|)then
    !!glbRmtSync.cbDbSelection()
  endif
  if(!this.callingGadget.owner().fullname().upcase() EQ |!!GLBRMTUPDATEDB|)then
    !!glbRmtUpdateDb.cbDbSelection()
  endif
  if(!this.callingGadget.owner().fullname().upcase() EQ |!!GLBUPDATEDB|)then
    !!glbUpdateDb.cbDbSelection()
  endif
  !this.hide()
endmethod
-- End of method definition for .select()
------------------------------------------------------------------------
--
--Method: .deselect()
--
-- Description: This method will select all the dbs in the calling gadget
-- which are in the selected sets!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deselect()
  !tempArray = ARRAY()
  do !i values !this.sets.selection(|rtext|)
    !tempArray.appendArray(!i.dbRef().dbsList)
  enddo
  !tempArray.sort()
  !tempArray.unique()
  !toBeDeselected = ARRAY()
  do !j indices !this.callingGadget.rText
    !index = REAL()
    !index = !tempArray.findFirst(!this.callingGadget.rText[!j].dbRef())
    handle(2,813)
      -- rtext[!j] store as master/demo not /*master/demo or =16830/10 append /*
      !temp = |/*| + !this.callingGadget.rText[!j]
      !index = !tempArray.findFirst(!temp.dbRef())
    endhandle
    if(!index.set())then
      !toBeDeselected.append(!j)
    endif
  enddo
  -- get current selected
  !sele =  !this.callingGadget.val
  !temp = !sele.difference(!toBeDeselected)
  !temp.sort()
  !temp.unique()
  !this.callingGadget.val = !temp
  -- Any forms that require special Callbacks!
  if(!this.callingGadget.owner().fullname().upcase() EQ |!!GLBSYNCHRDB|)then
    !!glbSynchrDb.cbDbSelection()
  endif
  if(!this.callingGadget.owner().fullname().upcase() EQ |!!GLBRMTSYNC|)then
    !!glbRmtSync.cbDbSelection()
  endif
    if(!this.callingGadget.owner().fullname().upcase() EQ |!!GLBRMTUPDATEDB|)then
    !!glbRmtUpdateDb.cbDbSelection()
  endif
  if(!this.callingGadget.owner().fullname().upcase() EQ |!!GLBUPDATEDB|)then
    !!glbUpdateDb.cbDbSelection()
  endif

  !this.hide()
endmethod
-- End of method definition for .deselect()
