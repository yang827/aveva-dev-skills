--
-- File:            admsetchpass.pmlfrm
--   Type:          Form Definition
--   Group:         Naming
--     Keyword:     Change Password
--   Module:        admin
--   Replaces:
--
-- Author:          S.Ellis
-- Created:         Fri 10 July 1998
--
--                  Revised to use SYS db attribute LckPsw (on user world element)
--                  Ray Davies; 18 Oct 2010
--
-- Description:
-- form to edit change password settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admSetChPass()                   -                   form constructor
--  init()                           -                   form initialisation
--  ok()                             -                   action for ok callback
--
------------------------------------------------------------------------

-- Define form
setup form !!admSetChPass

  !this.formTitle     = 'Change Password Settings'
  !this.iconTitle     = 'Change Password'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.7 $ '

  frame .frame1 'Change Password' at xmin ymax+0.5 width 25
    rgroup .chPassRGroup at xmin+1 ymax vertical
      add tag 'Enabled' select 'ENABLED'
      add tag 'Disabled' select 'DISABLED'
    exit
  exit

  button .ok     '  OK  ' at x0 ymax+0.5 ok
  button .cancel 'Cancel' at xmax form-size ymin  cancel

exit
-- End of form definition for !!admSetChPass
------------------------------------------------------------------------
--
-- Method:      !admSetChPass()
--
-- Description: form constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .admSetChPass()
  !this.okCall = '!!admSetChPass.ok()'
endmethod
-- End of method definition for .admSetChPass()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  -- initialise form gadgets to main data settings

  -- go to user world
  /*U
  !protection = LckPsw

  if ($!protection) then
     !this.chPassRGroup.select('DISABLED')
  else
     !this.chPassRGroup.select('ENABLED')
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: action for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- confirm the new setting

  if (!this.chPassRGroup.selection() eq 'ENABLED') then
    !answer = !!alert.confirm(!!messageFile.messageString(141, 31))
  else
    !answer = !!alert.confirm(!!messageFile.messageString(141, 32))
  endif

  if (not !answer.boolean()) then
     return
  endif

  if (!this.chPassRGroup.selection() eq 'ENABLED') then
     passwordlock off
  else
     passwordlock on
  endif

endmethod
-- End of method definition for .ok()
