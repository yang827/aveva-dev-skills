--
-- File:            admsizeofadmele.pmlfrm
--   Type:          Form Definition
--   Group:         General Application

--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Wed Mar 10 14:56:24 GMT 1999
--
--
-- Description:
-- A form to change the Size of the Admin Elements Form!
-- .
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   The Apply method
--  changeSize(REAL)                 -                   Changes the size after validation see above!
--  init()                           -                   Functions to set up form!
--  validate(REAL)                   -                   Function to check new size is reasonable
--


setup form !!admSizeOfAdmEle

  !this.formTitle     = 'Resize Admin Elements    '
  !this.iconTitle     = 'SIZE'
  !this.callback      = '!!admSizeOfAdmEle.init()'
  !this.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition


  button .min at x 2 y 0.2 pixmap width 16 height 16 call |!this.changeSize(-2)|

  button .lessOne at xmax ymin pixmap width 16 height 16 call |!this.changeSize(-1)|
  text .size |Size| at xmax ymin call |!this.validate(!this.size.val.real())| width 4 is REAL
  button .greaterOne at xmax ymin pixmap width 16 height 16 call |!this.changeSize(1)|

  button .max at xmax ymin pixmap width 16 height 16 call |!this.changeSize(2)|


  button .apply at xmin.min-2 ymax+0.5 | Apply | call |!this.cbApply()|  APPLY
  button .dismiss at xmax form-size ymin  |Dismiss| CANCEL

  -- Member Definitions
  -- Current VALID size
  member .validSize is REAL

  !!admSizeOfAdmEle.min.addPixmap(!!pml.getPathName('leftleftarrow16.png'))
  !!admSizeOfAdmEle.lessOne.addPixmap(!!pml.getPathName('leftarrow16.png'))
  !!admSizeOfAdmEle.greaterOne.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !!admSizeOfAdmEle.max.addPixmap(!!pml.getPathName('rightrightarrow16.png'))


exit
-- End of form definition for !!admSizeOfAdmEle

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: Functions to set up form!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
  !this.validSize = !!admDisplayConfig.getSize()
  !this.size.val = !this.validSize
endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
--Method: .validate()
--
-- Description: Function to check new size is reasonable
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validate(!newSize is REAL)
  if(!newSize lt 45)then
    -- ##
    !!alert.error(|The Size can be no less than 45|)
    !this.size.val = !this.validSize
    return
  elseif(!newSize GT 120)then
    -- ##
    !!alert.error(|The Size can be no Greater than 120|)
    !this.size.val = !this.validSize
    return
  endif
  !this.validSize = !newSize
  !this.size.val = !newSize
endmethod
-- End of method definition for .validate(REAL)
------------------------------------------------------------------------
--
--Method: .changeSize()
--
-- Description: Changes the size after validation see above!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeSize(!directionAction is REAL)
  if(!directionAction EQ -2)then
    !this.validate(45)
  endif
  if(!directionAction EQ -1)then
    !this.validate(!this.validSize - 1)
  endif
  if(!directionAction EQ 1)then
    !this.validate(!this.validSize + 1)
  endif
  if(!directionAction EQ 2)then
    !this.validate(120)
  endif
endmethod
-- End of method definition for .changeSize(REAL)
------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: The Apply method
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbApply()
  if(!!admDisplayConfig.getSize() NEQ !this.validSize)then
    !!admDisplayConfig.setSize(!this.validSize)
    !type = !!adminElem.prevType
    -- PML SYNTAX TO RELOAD FORM
    pml reload form !!adminElem
    -- Define form
    !!adminElem.prevType = !type
    !!adminElem.show(|At|, 0, 0)
  endif
endmethod
-- End of method definition for .cbApply()
