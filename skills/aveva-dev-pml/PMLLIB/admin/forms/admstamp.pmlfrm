--
--
-- Description:
-- Form definition to create/modify STAMP elements.
--
------------------------------------------------------------------------
-- Define form
setup form !!admStamp at xr 0.35 yr 0.1 resize

  !this.formTitle     = 'Stamp Definition'
  !this.callback      = '!this.formMethods.init()'
  !this.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition

  -- Stamp information
  text   .name   anchor top+left+right at x0.5 ymax+0.2 |Name        | call |!this.formMethods.name(!this.name)| width 30 scroll 32 NAME
  option .mode anchor top+right at xmax+14 ymin call |!this.formMethods.mode()| width 7
  text .desc anchor top+left+right at xmin.name ymax+0.2 |Description | call |!this.apply.active = true| width 54 scroll 120 STRING
  text .func anchor top+left+right at xmin ymax+0.2 |Function    | call |!this.apply.active = true| width 54 scroll 120 STRING

  -- Database selection type
  option .what anchor top+left+right |Build Stamp | at x0.5 ymax+0.7 call |!this.formMethods.stampWhat(true)| width 24
  para .setByTxt anchor top+right at xmax+1 ymin text |by|
  frame .setBy anchor top+right at xmax+1 ymin-0.2
    rtoggle .date |Date| call |!this.formMethods.setBy()|
    rtoggle .sess |Session| call |!this.formMethods.setBy()|
  exit

  -- Date format
  -- Hour
  para .dPara anchor top+left at x0.5 ymax+1 text |Set Date    |
  button .upH anchor top+left at xmax ymin-0.05 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.hour,'UP','HOUR')|
  button .dnH anchor top+left at xmin ymax-0.05 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.hour,'DOWN','HOUR')|
  text .hour  anchor top+left at xmax-0.1 ymin.upH+0.1 tooltip 'Hour' call |!this.formMethods.checkValue(!this.hour,'HOUR')| width 2 is STRING

  -- Mins
  para .colon anchor top+left at xmax ymin text |:|
  text .mins  anchor top+left at xmax ymin tooltip 'Minutes' call |!this.formMethods.checkValue(!this.mins,'MINS')| width 2 is STRING
  button .upM anchor top+left at xmax+0.2 ymin-0.1 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.mins,'UP','MINS')|
  button .dnM anchor top+left at xmin ymax-0.05 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.mins,'DOWN','MINS')|

  -- Day
  option .day anchor top+left at xmax+1 ymin.mins tooltip 'Day' call |!this.formMethods.storeDate()| width 2

  -- Month
  option .month anchor top+left at xmax+1 ymin tooltip 'Month' call |!this.formMethods.month(true)| width 10

  -- Year
  text .year  anchor top+left at xmax+1 ymin tooltip 'Year' call |!this.formMethods.checkValue(!this.year,'YEAR')| width 4 is REAL
  button .upY anchor top+left at xmax+0.2 ymin-0.1 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.year,'UP','YEAR')|
  button .dnY anchor top+left at xmin ymax-0.05 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.year,'DOWN','YEAR')|

  -- Set date as now
  button .now anchor top+left |Now| at xmin.mode ymin.year call |!this.formMethods.stampDate('NOW')|

  -- Project dbs
  frame .displayFr anchor all |                      | at xmin.what ymax+0.5

    list .display anchor all at xmin+1 ymin+1 call |!this.formMethods.getDbSessions()| MULTIPLE columns width 62 height 10
    option .sort  anchor bottom+left at xmin ymax+0.2 |Sort by | call |!this.formMethods.sort()| width 12
    text .filter  anchor bottom+left at xmax+1 ymin |Filter | call |!this.formMethods.sort()| width 15 STRING

    -- Sessions
    text .session anchor bottom+left |Session | at xmax+1.3 ymin call |!this.formMethods.checkSession()| width 5 is REAL
    button .upS   anchor bottom+left at xmax+0.2 ymin-0.1 pixmap height 3 width 7 call |!this.formMethods.sessUpDown('UP')|
    button .dnS   anchor bottom+left at xmin ymax-0.05 pixmap height 3 width 7 call |!this.formMethods.sessUpDown('DOWN')|

  exit

  -- Stamped dbs
  frame .curDbsFr anchor left+right+bottom | Stamped Databases | at xmin ymax+0.2

    button .add anchor top+left at xmin+30 ymin+0.6 tooltip 'Add dbs' call |!this.formMethods.projCur()| pixmap width 16 height 16
    button .rem anchor top+left at xmax ymin tooltip 'Remove dbs' call |!this.formMethods.curProj()| pixmap width 16 height 16
    button .clr anchor top+left at xmax+7 ymin |Remove All| call |!this.formMethods.remAll()|
    list .curDbs anchor all at xmin.curDbsFr+1 ymax.add+0.2 MULTIPLE columns width 62 height 10

  exit

  -- Actions
  button .apply   anchor bottom+left at xmin ymax+0.5 |Apply| call |!this.formMethods.apply()| APPLY
  button .dismiss anchor bottom+right at xmax form-size ymin |Dismiss| CANCEL

  -- Members
  member .formMethods is ADMSTAMP

  -- Set form in object
  !this.formMethods.form = !this

  -- Pop-ups
  menu .dbPopupMenu1
    !this.dbPopupMenu1.add(|CALLBACK|,|Select All DBs|,|!this.display.select('rtext',!this.display.rText)|)
    !this.dbPopupMenu1.add(|CALLBACK|,|Clear Selection|,|!this.display.clearSelection()|)
  !this.display.setPopup(!this.dbPopupMenu1)

  menu .dbPopupMenu2
    !this.dbPopupMenu2.add(|CALLBACK|,|Select All DBs|,|!this.curDbs.select('rtext',!this.curDbs.rText)|)
    !this.dbPopupMenu2.add(|CALLBACK|,|Clear Selection|,|!this.curDbs.clearSelection()|)
  !this.curDbs.setPopup(!this.dbPopupMenu2)

  -- Pixmaps
  !this.upH.addPixmap(!!PML.getPathName('uparrow7x3.png'))
  !this.dnH.addPixmap(!!PML.getPathName('downarrow7x3.png'))
  !this.upM.addPixmap(!!PML.getPathName('uparrow7x3.png'))
  !this.dnM.addPixmap(!!PML.getPathName('downarrow7x3.png'))
  !this.upY.addPixmap(!!PML.getPathName('uparrow7x3.png'))
  !this.dnY.addPixmap(!!PML.getPathName('downarrow7x3.png'))
  !this.upS.addPixmap(!!PML.getPathName('uparrow7x3.png'))
  !this.dnS.addPixmap(!!PML.getPathName('downarrow7x3.png'))
  !this.add.addPixmap(!!PML.getPathName('downarrow16.png'))
  !this.rem.addPixmap(!!PML.getPathName('uparrow16.png'))

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()
  !text  = ARRAY()

  -- Assign mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !this.mode.dText = !dText
  !this.mode.rText = !rText
  !dText.clear()
  !rText.clear()

  -- Assign what gadget values
  !dText.append(|The Project|)
  !dText.append(|By Database Sets|)
  !dText.append(|By MDBs|)
  !dText.append(|By Teams|)
  !dText.append(|By Databases & Extracts|)
  !dText.append(|By Working Extracts|)
  !rText.append(|PROJ|)
  !rText.append(|DBST|)
  !rText.append(|MDBS|)
  !rText.append(|TEAM|)
  !rText.append(|BYDB|)
  !rText.append(|BYWE|)
  !this.what.dText = !dText
  !this.what.rText = !rText

  -- Populate Month gadget
  !text.append(|January|)
  !text.append(|February|)
  !text.append(|March|)
  !text.append(|April|)
  !text.append(|May|)
  !text.append(|June|)
  !text.append(|July|)
  !text.append(|August|)
  !text.append(|September|)
  !text.append(|October|)
  !text.append(|November|)
  !text.append(|December|)
  !this.month.dText = !text

exit
-- End of form definition for !!admStamp
