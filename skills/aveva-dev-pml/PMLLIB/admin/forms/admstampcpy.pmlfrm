--
-- Description:
-- Form definition to provide facilities to copy STAMP elements.
--
------------------------------------------------------------------------
-- Define form
setup form !!admStampCpy at xr 0.35 yr 0.1

  !this.formTitle     = 'Copy Date Stamp'
  !this.callback      = '!this.formMethods.init()'
  !this.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition
  text .name at x 0 y 0       |To Stamp   | call |!this.formMethods.nameSet()| width 30 scroll 32 NAME
  text .desc at xmin ymax+0.2 |Description| width 30 scroll 120 STRING
  text .func at xmin ymax+0.2 |Function   | width 30 scroll 120 STRING

  button .ok at xmin.name ymax+0.5 |  OK  | call |!this.formMethods.cbApply()|
  button .cancel at xmax form-size ymin |Cancel| CANCEL

  -- Member definitions
  member .formMethods is ADMSTAMPCPY

  -- Set form in object
  !this.formMethods.form = !this

exit
-- End of form definition for !!admStampCpy
