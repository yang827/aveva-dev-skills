--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Tue May 6 09:05:37 BST 1997
--
--
-- Description:
-- Form definition to create/modify TEAM elements.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  resetMemberList()                -                   if in create mode remove everything from the member list
--

-- Initialise variables
!dText  = ARRAY()
!rText  = ARRAY()

-- Define form
setup form !!admTeam at xr 0.35 yr 0.1 resize

  !this.formTitle     = 'Team Definition'
  !this.iconTitle     = 'TEAM'
  !this.callback      = 'call !!admTeamInit()'
  !this.formRevision  = ' $Revision: 1.12 $ '

  -- Body of form definition

  -- Team information
  text .name anchor top+left+right at x 3 y 0.2 |Name        | call |call !!admTeamName(_name)| width 30 scroll 31 NAME
  option .mode anchor top+right at xmax+10 ymin call |call !!admTeamMode()| width 10

  text .desc anchor top+left+right at xmin.name ymax+0.2 |Description | width 50 scroll 120 STRING

  -- Team members
  frame .memberFrame anchor all at x 0 ymax+0.5 |Team Membership|

    list .projUsers anchor all at xmin+1 ymin+1 |Project Users| columns multiple width 30 height 15

    button .add anchor top+right at xmax+0.2 ymin+5 call |call !!admTeamMembAdd()| pixmap width 16 height 16
    button .rem anchor top+right at xmin ymax call |call !!admTeamMembRem()| pixmap width 16 height 16

    list .teamUsers anchor top+bottom+right at xmax ymin.projUsers |Team Members| columns multiple width 30 height 15

    option .sort anchor bottom+left at xmin.projUsers ymax |Sort |  call |call !!admTeamUserList()| width 12
    text .filter anchor bottom+left at xmax+1 ymin | Filter | call |call !!admTeamUserList()| width 15 STRING

  exit

  button .apply   anchor bottom+left  at xmin ymax+0.5 |Apply| call |call !!admTeam()| APPLY
  button .reset   anchor bottom at xcen form-0.5 * size ymin |Reset| callback |!this.resetMemberList()|  RESET
  button .dismiss anchor bottom+right at xmax form-size ymin       |Dismiss| CANCEL

  -- Member definitions
    -- Team Dbref
    member .dbRef     is DBREF
    -- Array of project users
    member .userArray is ARRAY
    -- Team members (array of DBREFs)
    member .members   is ARRAY
    -- Members to store sort and filter values
    member .filterVal is STRING
    member .sortVal   is STRING


-- set icons
  !!admTeam.add.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !!admTeam.rem.addPixmap(!!pml.getPathName('leftarrow16.png'))

  -- Assign mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !!admTeam.mode.dText = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !!admTeam.mode.rText = !rText
  !rText.clear()

  -- Assign sort gadget values
  !!admUserSortGadg(!!admTeam.sort)

  -- Assign Filter Gadget
  !!admTeam.filter.val = |*|

  !heading[1] = 'Element Name'
  !heading[2] = 'Description'

 -- !this.projUsers.setHeadings(!heading)

exit
-- End of form definition for !!admTeam
------------------------------------------------------------------------
--
--Method: .resetMemberList()
--
-- Description:
-- if in create mode remove everything from the member list
-- if in modify mode reset back to initial settings
--
-- Method Type: Function/ Procedure
-- Arguments: none
--  [#] [R/RW] [Data Type] [Description]
-- Return: None
--  [Data Type] [Description]
--
------------------------------------------------------------------------

define method .resetMemberList()
   !mode = !!admTeamModeGet()
   if ( !mode.upcase() eq 'CREATE') then
      -- Clear all Team Members
      !!admTeamMembRemAll()
   else
    	  -- reset to initial state
    	!!admTeamInit()
    endif
endmethod
