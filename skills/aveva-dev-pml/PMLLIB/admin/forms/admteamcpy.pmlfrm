-- Created:         Wed Jul 16 13:34:26 BST 1997
--
--
-- Description:
-- Form definition to provide facilities to copy TEAM elements.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   Callback method for apply button!
--  cbName()                         -                   Callback to the Name gadget
--  init()                           -                   Initialise this form!
--
------------------------------------------------------------------------

-- Define form
setup form !!admTeamCpy at xr 0.35 yr 0.1

  !this.formTitle     = 'Copy Team'
  !this.iconTitle     = 'COPYTEAM'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition
  text .name at x 0 y 0 |To Team    | call |!this.cbName()| width 30 scroll 31 NAME
  text .desc at xmin ymax+0.2 |Description| width 30 scroll 120 STRING

  toggle .include at xmin+11 ymax+0.2 |Include Users|

  button .ok at xmin.name ymax+0.5 |  OK  | call |!this.cbApply()| OK
  button .cancel at xmax form-size ymin |Cancel| CANCEL

  -- Member definitions
    -- Source team dbRef
    member .dbRef is DBREF

exit
-- End of form definition for !!admTeamCpy
------------------------------------------------------------------------
--
-- Method:  .init()
--
-- Description: Initialise this form!
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise form variables
  !dbRef      = !!adminElem.teamGet()
  if (!dbRef.type neq 'TEAM') then
    return error
  endif
  !this.dbRef = !dbRef

  -- Set the form title
  !this.formTitle = |Copy Team: |+ !dbRef.name.substring(3)

  -- Initialise form gadgets
  !this.name.val  = |unset|
  if (!dbRef.description.empty()) then
    !this.desc.val  = |unset|
  else
    !this.desc.val  = !dbRef.description
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .cbName()
--
-- Description: Callback to the Name gadget
--
-- Method Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbName()

  -- Initialise variables

  -- Call the user name check
  if( !!admChkTeamName(!this.name, object dbRef()) ) then
    -- Name was good move focus on
    !this.desc.setFocus()
  else
    -- Name was bad keep focus here
    !this.name.setFocus()
  endif

endmethod
-- End of method definition for .cbName()
------------------------------------------------------------------------
--
-- Method: .cbApply()
--
-- Description: Callback method for apply button!
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbApply()

  -- Initialise variables
  !sourceTeam       = !this.dbRef
  !sourceName       = !sourceTeam.name.substring(3)
  !targetTeam       = !this.name.val
  !include          = !this.include.val
  !description      = !this.desc.val

  -- Check for unset target name
  if (!targetTeam eq 'unset') then
    !!messageFile.error(141, 056)
  endif

  -- Create the copy command
  if (!include) then
    !command          = |COPY TEAM |+ !sourceName +| TO |+ !targetTeam
  else
    !command          = |COPY TEAM |+ !sourceName +| TO |+ !targetTeam +| EXCLUDING USERS|
  endif

  -- Execute the copy command
  call !!admCommand(!command)
  handle (1,29)

    -- Team already exists
    !!messageFile.error(141, 052, !targetTeam)

  elsehandle (1,30)

    -- Team not found
    !!adminElem.update('TEAM')
    !!messageFile.error(141, 054, !sourceTeam)

  elsehandle any

    -- Non specific
    !!messageFile.error(141, 055, !!error.text)

  endhandle

  -- Get the new dbRef
  !elemName       = |/*| + !targetTeam
  !!ce            = !elemName.dbRef()
  !!adminElem.teamSet(!!ce)

  -- Copy command was a success so modify the description
  if (!description.empty() or !description eq 'unset') then
    !description = ''
  endif
  !!ce.description = !description

  -- As a legacy databases get included in the copy
  -- Update forms
  !!adminElem.update('DB')
  !!adminElem.update('TEAM')
  call !!admTeamUpdate()

endmethod
-- End of method definition for .cbApply()
