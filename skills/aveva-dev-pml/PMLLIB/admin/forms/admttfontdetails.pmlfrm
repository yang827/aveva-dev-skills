--
--
-- Description:
-- Form definition for editing the TrueType font details
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admTTFontDetails()               -
--  init()                           -
--  validate(GADGET,STRING)          -
--
------------------------------------------------------------------------

kill !!admTTFontDetails

setup form !!admTTFontDetails dialog
  text .face |Face name| tagwidth 8 width 40 is STRING $
    tooltip |The face name of the font|
  path down
  text .id |Font ID| tagwidth 8 width 40 is REAL $
    tooltip |The identifier of the font|
  text .desc |Description| tagwidth 8 width 40 is STRING $
    tooltip |Name of the font to be shown to the user|
  button .ok |OK| callback |!!admTTFonts.doUpdate()| width 6 OK
  path right
  button .cancel at xmax form-size |Cancel| width 6 CANCEL
exit
-- End of form definition for !!admTTFontDetails

------------------------------------------------------------------------
--
-- Method:      admTTFontDetails
--
-- Description: Constructor method
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .admTTFontDetails()
  !this.initcall = '!this.init()'
  !this.formTitle = 'TrueType font details'
  !this.face.active = FALSE
  !this.id.validateCall='!this.validate('
  !this.desc.validateCall='!this.validate('
endmethod
-- End of method definition for .admTTFontDetails()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Sets up the gadgets on the form before showing it
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()
  !this.face.val = !!admTTFonts.modFace
  !this.id.val = !!admTTFonts.modID
  !this.desc.val = !!admTTFonts.modDes
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      validate
--
-- Description: Open validator function to validate the ID and Description fields
--
-- Method Type: Procedure
-- Arguments:
--   1  GADGET  The gadget being validated
--   2  STRING  dummy action argument
-- Return:
--
------------------------------------------------------------------------
define method .validate(!gadget is GADGET, !dummyAction is STRING)
  !name = !gadget.name()
  if( !name.eq('ID') ) then

    !id = int(!gadget.val + 0.5)
    !idKind = !!fontManager.fontType(!id)
    if( !idKind.lt(1) ) then
      return error 1 'The selected font ID is not valid for a TrueType font.'
    elseif( !idKind.eq(2) and ( !!admTTFonts.modIsNew or !id.neq(!!admTTFonts.modID) ) ) then
      return error 2 'The selected font ID is already assigned to another font.'
    endif

  elseif( !name.eq('DESC') ) then

    !desc = !this.desc.val
    !descInd = !!fontManager.findDescription(!desc)
    if( !descInd.gt(0) and ( !!admTTFonts.modIsNew or !desc.lowCase().neq(!!admTTFonts.modDes.lowCase()) ) ) then
      return error 3 'The font description matches the description of another font. Such ambiguities are not allowed.'
    endif

  endif
endmethod
-- End of method definition for .validate()
