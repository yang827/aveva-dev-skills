--   Type:          Form Definition
--   Group:         Admin Application
--     Keyword:     ADM
--   Module:        admin
--   Replaces:
--
-- Author:          T.Lisowski
--  Created:         Tue Jul  3 16:43:50 2007
--
--
-- Description:
-- Form definition to facilitate the handling of the TrueType fonts
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addFont()                        -
--  admTTFonts()                     -
--  doUpdate()                       -
--  init()                           -
--  makeDefault()                    -                   Moves the currently selected font to the beginning
--  modifyFont()                     -
--  removeFont()                     -
--  updateFont(REAL,STRING,STRING)   -                   Updates the settings of the font, either new or old
--
------------------------------------------------------------------------

kill !!admTTFonts

setup form !!admTTFonts at xr0 yr0 resize

  member .modFace is STRING
  member .modDes is STRING
  member .modID is REAL
  member .modIsNew is BOOLEAN
  member .symbolFont is STRING
  list .ttf 'TrueType fonts' anchor all columns width 50 length 10
  button .btnAdd |Add| at xmin_ttf ymax+0.5 anchor bottom+left callback |!this.addFont()| width 6
  path right
  hdist 1
  button .btnMod |Modify| anchor bottom+left callback |!this.modifyFont()| width 6
  button .btnRem |Remove| anchor bottom+left callback |!this.removeFont()| width 6
  button .btnDef |Make default| anchor bottom+left callback |!this.makeDefault()| width 8
  button .btnExit |Dismiss| at xmax_ttf-size anchor bottom+right width 6 OK
exit
-- End of form definition for !!admTTFonts

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise the contents of the font list
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()
  -- NOTE: The font face name given below should match exactly
  -- the constant T:TTF.SYMBOL.FONT in inputfuncs.mcr !!!
  !this.symbolFont = 'PDMS Symbol'
  !!fontManager.loadFontInfo()
  !!fontManager.sort(2)
  !dText = ARRAY()
  !rText = ARRAY()
  !!fontManager.makeListArrays(!dText, !rText, 0, true)
  !this.ttf.dText = !dText
  !this.ttf.rText = !rText
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      admTTFonts
--
-- Description: Constructor, setting up the object
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .admTTFonts()
  if( undefined(!!fontManager) ) then
    !!comDefineGlobal(object ADMFONTMANAGER())
  endif
  !this.initcall = '!this.init()'
  !this.formTitle = 'TrueType fonts configuration'
  !h[1] = 'Face name'
  !h[2] = 'ID'
  !h[3] = 'Description'
  !this.ttf.setHeadings(!h)
endmethod
-- End of method definition for .admTTFonts()

------------------------------------------------------------------------
--
-- Method:      addFont
--
-- Description: Adds a new TrueType font to the list
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .addFont()
  import 'pmlnetutilities'
  handle any
  endhandle
  using namespace 'Aveva.Pdms.PMLNet'
  !dialog = object PMLFONTDIALOG()
  !dialog.show()
  !face = !dialog.fontFaceName()
  if( !face.empty() ) then
    return
  elseif( !face.eq(!this.symbolFont) ) then
    !!alert.warning(|The font '| & !this.symbolFont & |' cannot be added! It is used automatically by the system.|)
    return
  endif
  if( !!fontManager.findFace(!face).gt(0) ) then
    !!alert.warning(|The font face name '| & !face & |' is already in use!|)
    return
  endif
  !id = !!fontManager.findFreeID()
    if( !id.lt(0) ) then
      !!alert.warning('No more space for a new TrueType font!')
      return
    endif
  !this.modIsNew = TRUE
  !this.updateFont(!id, !face, !face)
endmethod
-- End of method definition for .addFont()

------------------------------------------------------------------------
--
-- Method:      modifyFont
--
-- Description: Modifies the currently selected font
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .modifyFont()
  !refStr = !this.ttf.selection()
  if( !refStr.empty() or !refStr.eq('None') ) then
    return
  endif
  !ind = !!fontManager.findRef(!refStr)
  !id = -1
  !face = ''
  !desc = ''
  !ref = ''
  !!fontManager.getInfo(!ind, !id, !face, !desc, !ref)
  if( !id.gt(0) ) then
    !this.modIsNew = FALSE
    !this.updateFont(!id, !face, !desc)
  endif
endmethod
-- End of method definition for .modifyFont()

------------------------------------------------------------------------
--
-- Method:      updateFont
--
-- Description: Updates the settings of the font, either new or old
--
-- Method Type: Procedure
-- Arguments:
--  1  REAL    The font ID
--  2  STRING  The font face name
--  3  STRING  The font description
-- Return:
--
------------------------------------------------------------------------
define method .updateFont(!id is REAL, !face is STRING, !desc is STRING)
  !this.modFace = !face
  !this.modDes = !desc
  !this.modID = !id
  show !!admTTFontDetails
endmethod
-- End of method definition for .updateFont()

------------------------------------------------------------------------
--
-- Method:      doUpdate
--
-- Description: Callback routine called by the !!admTTFontDetails form, applying the changes
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .doUpdate()
  !id = INT(!!admTTFontDetails.id.val + 0.5)
  !face = !!admTTFontDetails.face.val
  !desc = !!admTTFontDetails.desc.val

  if( !this.modIsNew ) then
    var !ftwl collect all FTWL for /*S
    if( !ftwl.empty() ) then
      !!alert.error('Database error - no Font World found!')
    else
      !mem = REF
      $!ftwl[1]
      LAST MEM $* will add the new font at the end of the member list
      NEW TTFONT TTFDES '$!desc' TTFACE '$!face' TTFIND $!id
      handle ANY
        !!alert.error('Error adding the font!')
      endhandle
      $!mem
    endif
  else
    !renumber = ''
    if( !id.neq(!this.modID) ) then
      !renumber = 'RENUMBER TO $!id'
    endif
    TTFONTNUM $!this.modID $!renumber FACE '$!face' DESCRIPTION '$!desc'
    handle ANY
      !!alert.error('Error modifying the font!')
    endhandle
  endif
  !this.init()
endmethod
-- End of method definition for .doUpdate()

------------------------------------------------------------------------
--
-- Method:      removeFont
--
-- Description: Removes the selected font from the system
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .removeFont()
  !refStr = !this.ttf.selection()
  if( !refStr.empty() or !refStr.eq('None') ) then
    return
  endif
  if( !!fontManager.findRef(!refStr).gt(0) ) then
    !mem = REF
    $!refStr
    delete TTFONT
    handle ANY
      !!alert.error('Error deleting the font!')
    endhandle
    $!mem
    !this.init()
  endif
endmethod
-- End of method definition for .removeFont()

------------------------------------------------------------------------
--
-- Method:      makeDefault
--
-- Description: Moves the currently selected font to the beginning
--              of the list, thus making it the default font
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .makeDefault()
  if( !!fontManager.nTTF.gt(1) ) then
    !refStr = !this.ttf.selection()
    if( not !refStr.empty() ) then
      !firstRefInd = !!fontManager.findID(!!fontManager.firstTTFid)
      if( !firstRefInd.gt(0) ) then
        !firstRef = !!fontManager.ttfRef[!firstRefInd]
        if( !refStr.neq(!firstRef) ) then
          !mem = REF
          $!refStr
          !curInd = SEQUENCE
          $!firstRef
          !firstInd = SEQUENCE
          OWNER
          REORDER $!curInd BEFORE $!firstInd
          $!mem
          !this.init()
        endif
      endif
    endif
  endif
endmethod
-- End of method definition for .makeDefault()
