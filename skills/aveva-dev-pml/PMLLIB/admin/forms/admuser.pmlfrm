------------------------------------------------------------------------
--
-- Method: .refresh()
--
-- Description: refresh the TEAM elements listed in the gadgets on the
-- USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refresh()

  -- Return if the form is not shown
  if (undefined (!!admUser) or not !this.shown()) then
    return
  endif

  -- Display a message
  !!messageFile.prompt(141, 004,  !this.formTitle,  'TEAM')

  -- Set the user information
  !this.teamSet()

  -- Update the project team list
  !this.teamList()
  !this.membList()

  -- Dismiss the prompt
  !!prompt(0)

endmethod
-- End of method definition for .refresh()

------------------------------------------------------------------------
--
-- Method: .refSet()
--
-- Description: set the current dbRef of the  USER that is being
-- created or modified.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
