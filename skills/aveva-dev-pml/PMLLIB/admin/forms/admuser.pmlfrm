------------------------------------------------------------------------
--
-- Method: .name()
--
-- Description: act as callback to the Name gadget in the USER
-- Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .name(!gadget is GADGET)

  -- Initialise variables
  !dbRef   = !this.refGet()

  -- the user name check routine
  if( !!admChkUserName(!gadget, !dbRef) ) then
    -- Name was good move focus on
    !this.setPass.setFocus()
  else
    -- Name was bad keep focus here
    -- ##
    !this.name.setFocus()
  endif

endmethod
-- End of method definition for .name(GADGET)

