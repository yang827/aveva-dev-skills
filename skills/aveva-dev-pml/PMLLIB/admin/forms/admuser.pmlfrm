--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbRef       dbRef of USER (can be unset).
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refSet(!dbRef is DBREF)

  -- Set the dbRef
  !this.dbRef  = !dbRef

endmethod
-- End of method definition for .refSet(dbRef)

------------------------------------------------------------------------
--
-- Method: .teamGet()
--
-- Description: return the stored array of project users.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of project users
--
------------------------------------------------------------------------

-- Define method
define method .teamGet() is ARRAY

  -- Return the array
  return !this.teamArray

endmethod
-- End of method definition for .teamGet() ARRAY

------------------------------------------------------------------------
--
-- Method: .teamList()
--
-- Description: update the contents of the project teams list gadget on
-- the USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .teamList()

  -- Initialise variables
  !projTeams           = !this.teamGet()
  !membership          = !this.membGet()

  -- Save the sort and filter values for later user
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.filterVal  = !this.filter.val
  !this.sortVal    = !this.sort.selection('rtext')

  -- Clear the list gadget
  !this.projTeams.clear()

  -- Determine teams that user is not a member of.
  if(!membership.size() neq 0)then
    !teamList            = !projTeams.difference(!membership)
  else
    !teamList            = !projTeams
  endif
  -- Sort the list of teams
  !displayList         = !!adminFilterSort(!teamList, !this.sort, !this.filter)

  -- Display the list of teams
  !!adminTeamTxtList(!displayList, !this.projTeams, !!admDisplayConfig.fmtTeamGet(), !!admDisplayConfig.eleTypeGet())

endmethod
-- End of method definition for .teamList()

------------------------------------------------------------------------
--
-- Method: .teamSet()
--
-- Description: set the form attribute to store an array of project teams
-- in the USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .teamSet()

  -- Initialise variables
  !teams               = ARRAY()
  !currentPos          = !!ce

  -- Collect the project teams
  !!ce                 = !!dbrAdminGetWorld('TEAM')
  !teams               = !!collectAllFor('TEAM','',!!ce)

  -- Assign the array to its store
  !this.teamArray  = !teams

  -- Return to database position
  !!ce                 = !currentPos

endmethod
-- End of method definition for .teamSet()

------------------------------------------------------------------------
--
-- Method: .update()
--
-- Description: update the displayed USER in the USER Definition form.
-- The form must be displayed and in MODIFY mode.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update()

  -- Initialise variables
  !mode    = !this.modeGet()
  !selUser = !!adminElem.userGet()
  !curUser = !this.refGet()

  -- Return if the form is not shown
  if (!this.shown().not()) then
    return
  endif

  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif

  -- Return if the same reference
  if (!selUser eq !curUser) then
    return
  endif

  -- Re-initialise the form
  !this.refSet(!selUser)
  !this.init()

endmethod
-- End of method definition for .update()
------------------------------------------------------------------------
--
-- Method: .updDepend()
--
-- Description:  update dependent forms, mainly !!admAcr
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updDepend()
  -- Update the !!admAcr form
  if (Undefined (!!admAcr)) then
     !!loadForm ('admacr')
  endif
  !!admAcr.update()
endmethod
-- End of method definition for .updDepend()

------------------------------------------------------------------------
--
-- Method: .cbCpyBtn
--
-- Description: correctly identify whether acr is there to be copied!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbCpyBtn()
  if(!this.acr.dText.size() LT 1)then
    return
  else
    !!admAcrCopy2.display(!this.acr.dText[!this.acr.val],!this.admAcr[!this.acr.val], !this.refGet())
  endif
endmethod
-- End of method definition for .cbCpyBtn()

------------------------------------------------------------------------
--
--Method: moveElements()
--
-- Description: move a continuous block elements up or down!
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      REAL         Direction to move elements in up equals -1 down +1
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveElements(!direction is REAL)
  if(!this.validSelection())then
    !selection = !this.memAcrs.val
    if(!selection.size() EQ 0)then
      return
    endif
    !selection.sort()
    -- User has a block start at element 1 and they want to move the block up
    if((!selection.first() eq 1) AND (!direction EQ -1))then
      return
      -- in shame!
    endif
    -- User has a block start at the end and they want to move the block down
    if((!selection.last() eq !this.memAcrs.dText.size()) AND (!direction EQ 1))then
      return
      -- in shame!
    endif
    !tempArray = ARRAY()
    do !i values !selection
      !tempArray.append(!this.aMembership[!i])
    enddo
    if(!direction EQ 1)then

      !overwritVals = !this.aMembership.overlay(!selection.first() + 1, !tempArray)
      !this.aMembership[!selection.first()] = !overwritVals.last()

    elseif(!direction EQ -1)then

      !overwritVals = !this.aMembership.overlay(!selection.first() - 1, !tempArray)
      !this.aMembership[!selection.last()] = !overwritVals.first()

    endif

    do !i indices !selection
      !selection[!i] = !selection[!i] + !direction
    enddo

    !this.aMembList()

    !this.memAcrs.val = !selection

  endif
endmethod
-- End of method definition for .moveElements(REAL)
------------------------------------------------------------------------
--
--Method: .validSelection
--
-- Description: This function will check to see if the user has selected
-- a valid block of elements to reorder! A valid selection is a continuous block
-- of 1 or more elements
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--    BOOLEAN     IF the selection is valid
------------------------------------------------------------------------
define method .validSelection() is BOOLEAN
  if(!this.memAcrs.val.size() EQ 0)then
    return true
    -- go no further with this mockery
  endif

  !selection = !this.memAcrs.val
  -- Not much point going any further as by definition a selection of 1 elements
  -- is continuous block!
  if(!selection.size() GT 1)then
    !selection.sort()
    do !i indices !selection
      skip if(!i EQ 1)
      if( !selection[(!i - 1)] NEQ (!selection[!i] - 1))then
        -- This is not a continuous block, halt and reprimand user!!!!!!!!!!!!!!!!!!!!!!!!!!!!
        -- ##
        !!alert.error(|Please select a continuous block of elements if you wish to reorder elements! i.e. element 3,4,5 etc...|)
        !this.memAcrs.val = object ARRAY()
        return false
      endif
    enddo
  endif
  return true

endmethod
-- End of method definition for .validSelection() BOOLEAN

------------------------------------------------------------------------
--
-- Method: .acrGet()
--
-- Description: return the stored array of project ACRSTs.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of project users
--
------------------------------------------------------------------------

-- Define method
define method .acrGet() is ARRAY

  -- Return the array
  return !this.nonMemAcrArray

endmethod
-- End of method definition for .acrGet() ARRAY

------------------------------------------------------------------------
--
-- Method: .acrList()
--
-- Description: update the contents of the project teams list gadget on
-- the USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .acrList()

  -- Initialise variables
  !projAcrs           = !this.acrGet()
  !aMembership          = !this.aMembGet()

  -- Save the sort and filter values for later user
  if (!this.acrFilter.val.empty()) then
    !this.acrFilter.val = |*|
  endif
  !this.acrFilterVal  = !this.acrFilter.val
  !this.acrSortVal    = !this.acrSort.selection('rtext')

  -- Clear the list gadget
  !this.nonMemAcrs.clear()

  -- Determine Acr that are not a member of this ACRST
  if(!aMembership.size() neq 0)then
    !acrList            = !projAcrs.difference(!aMembership)
  else
    !acrList            = !projAcrs
  endif
  -- Sort the list of teams
  !displayList         = !!adminFilterSort(!acrList, !this.acrSort, !this.acrFilter)

  -- Display the list of teams
  !!admAcrTxtList(!displayList, !this.nonMemAcrs, !!admDisplayConfig.fmtAcrGet(), TRUE)

endmethod
-- End of method definition for .acrList()

------------------------------------------------------------------------
--
-- Method: .acrSet()
--
-- Description: set the form attribute to store an array of project Acrs
-- in the ACRST Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .acrSet()

  -- Initialise variables
  !acrOfTypes     = ARRAY()
  !acrs           = ARRAY()

  !currentPos          = !!ce

  -- Collect the project teams
  !!ce                 = !!dbrAdminGetWorld('ACR')
  !acrOfTypes          = !!ce.mem

  do !i values !acrOfTypes
    skip if((!i.type NEQ |ACR|) AND (!i.type NEQ |ACRST|) )
    !acrs.append(!i)
  enddo

  !this.nonMemAcrArray  = !acrs

  -- Return to database position
  !!ce                 = !currentPos

endmethod
-- End of method definition for .acrSet()

--------------------------------------------------------------------------
--
-- Method: .aMembAdd()
--
-- Description: add the selected project Acrs to the Acr Group membership store.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .aMembAdd()

  -- Get the current selection
  !acrSel    = !this.nonMemAcrs.val

  -- Return if no values
  if (!acrSel.size() eq 0) then
    return
  endif

  -- Process the selection list
  do !i values !acrSel

    -- Convert the value
    !dbRef     = !this.nonMemAcrs.rText[!i].dbRef()
    handle any
      -- Bad reference
      skip
    endhandle

    -- Add the value to the membership store
    !this.aMembership.append(!dbRef)

  enddo

  -- Update the list gadgets
  !this.acrList()
  !this.aMembList()

endmethod
-- End of method definition for .aMembAdd()
----------------------------------------------------------------------
--
-- Method: .aMembGet()
--
-- Description: return the stored array of ACR members for the ACR group in
-- the ACR Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of dbRef of ACR Group
--
------------------------------------------------------------------------

-- Define method
define method .aMembGet() is ARRAY

  -- Return the value
  return !this.aMembership

endmethod
-- End of method definition for .aMembGet() ARRAY

------------------------------------------------------------------------
--
-- Method: .aMembList()
--
-- Description: update the contents of the user membership list gadget
-- on the USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .aMembList()

  -- Initialise variables
  !aMembership    = !this.aMembGet()

  -- Clear the list
  !this.memAcrs.clear()

  -- Display the membership
  !!admAcrTxtList(!aMembership, !this.memAcrs, !!admDisplayConfig.fmtAcrGet(), TRUE)

endmethod
-- End of method definition for .aMembList()

------------------------------------------------------------------------
--
-- Method: .aMembRem()
--
-- Description: remove the selected teams from the user membership store.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .aMembRem()

  -- Get the selected teams
  !membSel    = !this.memAcrs.val

  -- Return if no selection
  if (!membSel.size() eq 0) then
    return
  endif

  -- Process the selection list
  do !index values !membSel

    -- Convert value
    !dbRef      = !this.memAcrs.rText[!index].dbRef()
    handle any
      -- Bad reference
      skip
    endhandle

    -- Find the element in the member array
    !pos        = !this.aMembership.findFirst(!dbRef)
    if (!pos.set()) then
      !this.aMembership.remove(!pos)
    endif

  enddo

  -- Update the list gadgets
  !this.acrList()
  !this.aMembList()

endmethod
-- End of method definition for .aMembRem()

------------------------------------------------------------------------
--
-- Method: .aMembSet()
--
-- Description: set the form attribute containing the array of acrs to
-- which the ACR Group in the Acr group Definition form is a member.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .aMembSet()

  -- Initialise variables
  !dbRef                = !this.refGet()

  -- Get the teams for the user
  if (!dbRef.badRef()) then
    -- dbRef is unset
    !aMembership           = ARRAY()
  else
    -- Get the membership
    !aMembership           = !dbRef.acrli
  endif

  -- Store the array
  !this.aMembership  = !aMembership

endmethod
-- End of method definition for .aMembSet()

