------------------------------------------------------------------------
--
-- Method: .cbSecurity()
--
-- Description: Callback for security gadget because free users ignore DAC
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbSecurity()

    !test = !this.secu.selection().upcase().trim()
    -- because FREE users are not subjected to DAC
    if(!test EQ |FREE|)then
      !this.acrAdd.active = FALSE
      !this.acrRem.active = FALSE
    else
      !this.acrAdd.active = TRUE
      !this.acrRem.active = TRUE
    endif

endmethod
-- End of method definition for .cbSecurity()

