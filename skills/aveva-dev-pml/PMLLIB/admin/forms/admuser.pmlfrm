--
--
-- Description:
-- Form definition to create/modify USER elements.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aMembAdd()                       -                   add the selected project Acrs to the Acr Group membership store.
--  aMembGet()                       ARRAY               return the stored array of ACR members for the ACR group in
--  aMembList()                      -                   update the contents of the user membership list gadget
--  aMembRem()                       -                   remove the selected teams from the user membership store.
--  aMembSet()                       -                   set the form attribute containing the array of acrs to
--  acrGet()                         ARRAY               return the stored array of project ACRSTs.
--  acrList()                        -                   update the contents of the project teams list gadget on
--  acrSet()                         -                   set the form attribute to store an array of project Acrs
--  cbApply()                        -                   create or modify a USER element. The values for the
--  cbCpyBtn()                       -                   correctly identify whether acr is there to be copied!
--  cbSecurity()                     -                   Callback for security gadget because free users ignore DAC
--  display(STRING)                  -                   Function to display the USER Definition form.
--  init()                           -                   initialise the USER Definition form.
--  membAdd()                        -                   add the selected project teams to the user membership store.
--  membGet()                        ARRAY               return the stored array of team members for the user in
--  membList()                       -                   update the contents of the user membership list gadget
--  membRem()                        -                   remove the selected teams from the user membership store.
--  membSet()                        -                   set the form attribute containing the array of teams to
--  mode()                           -                   Callback to the mode gadget in the USER Definition form.
--  modeGet()                        STRING              return the current mode of the USER definition form.
--  modeSet(STRING)                  -                   set the mode of the !this. form.
--  moveElements(REAL)               -                   move a continuous block elements up or down!
--  name(GADGET)                     -                   act as callback to the Name gadget in the USER
--  refGet()                         DBREF               return the current USER dbRef for the element being
--  refSet(DBREF)                    -                   set the current dbRef of the  USER that is being
--  refresh()                        -                   refresh the TEAM elements listed in the gadgets on the
--  showDbs()                        -                   Show available dbs from which to create a working extract.
--  showPassDialog()                 -                   Show pass text entry/confirmation dialog
--  teamGet()                        ARRAY               return the stored array of project users.
--  teamList()                       -                   update the contents of the project teams list gadget on
--  teamSet()                        -                   set the form attribute to store an array of project teams
--  updDepend()                      -                   update dependent forms, mainly !!admAcr
--  update()                         -                   update the displayed USER in the USER Definition form.
--  validSelection()                 BOOLEAN             This function will check to see if the user has selected
--
------------------------------------------------------------------------

-- Define form
setup form !!admUser at xr 0.35 yr 0.1 resize

  !this.formTitle     = 'User Definition'
  !this.iconTitle     = 'USER'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.21 $ '

  -- Body of form definition

  -- User information

  text   .name   anchor top+left+right at x0 ymax+0.2 |Name        | call |!this.name(!this.name)| width 28 scroll 49 NAME

  button .setPass anchor top+right at xmax.name+1 ymin.name |Set Password| call |!this.showPassDialog()|

  text   .desc   anchor top+left+right at xmin.name ymax+0.2 |Description | width 28 scroll 120 STRING

  option .secu   anchor top+right at xmax.desc+1 ymin.desc | Security | call |!this.cbSecurity()| width 10

  -- Working extracts
--   frame .wEFrame at x36 y0.6 |Working Extracts|
--     list .wExtracts at xmin +1 ymin+1  width 35 height 5
--     button .wECreate at xmin+2 ymax+0.2 |Create| call |!this.showDbs()|
--     button .wEReplace at xmax+3 ymin |Replace| call |$P ***** Replace Working Extract *****|
--     button .wEDelete at xmax+3 ymin |Delete| call |$P ***** Delete Working Extract *****|
--   exit

  -- User membership
  frame .memberFrame anchor all at x 0 ymax+0.2 |User Membership|

    list .projTeams  anchor all at xmin+1 ymin+1 |Project Teams| columns multiple width 32 height 9

    button .add      anchor top+right at xmax+0.2 ymin+2 call |!this.membAdd()| pixmap width 16 height 16
    button .rem      anchor top+right at xmin ymax       call |!this.membRem()| pixmap width 16 height 16

    list .teams      anchor top+bottom+right at xmax ymin.projTeams |Team Membership| columns multiple width 32 height 9

    option .sort     anchor bottom+left at xmin.projTeams ymax |Sort | call |!this.teamList()| width 12
    text .filter     anchor bottom+left at xmax+1 ymin | Filter |       call |!this.teamList()| width 15 STRING
  exit
  path down
  halign left
  vdist 0.2
  frame .acrFrame anchor left+right+bottom |User Access Control Rights (ACRS)|

    list .nonMemAcrs anchor all at xmin+1 ymin+1 |Project ACRs| columns multiple width 30 height 10

    button .acrAdd   anchor top+right at xmax+0.2 ymin+2 call |!this.aMembAdd()| pixmap width 16 height 16
    button .acrRem   anchor top+right at xmin ymax       call |!this.aMembRem()| pixmap width 16 height 16

    list .memAcrs    anchor top+bottom+right at xmax ymin.nonMemAcrs |User's ACRs| columns multiple width 30 height 10
    button .acrUp    anchor top+right at xmax.memAcrs+0.2 ymin.memAcrs+2 call |!this.moveElements(-1)| pixmap width 16 height 16
    button .acrDown  anchor top+right at xmax.memAcrs+0.2 ymax           call |!this.moveElements(+1)| pixmap width 16 height 16

    option .acrSort  anchor bottom+left at xmin.nonMemAcrs ymax.nonMemAcrs |Sort | call |!this.acrList()| width 12
    text .acrFilter  anchor bottom+left at xmax+1 ymin | Filter | call |!this.acrList()| width 15 STRING

  exit

  button .apply   anchor bottom+left  at xmin ymax+0.5 |Apply| call |!this.cbApply()| APPLY
  button .reset   anchor bottom at xcen form-0.5 * size ymin |Reset| call |!this.init()|
  button .dismiss anchor bottom+right at xmax form-size ymin |Dismiss| CANCEL
  option .mode    anchor top+right    at xmax form-size y0.1 call |!this.mode()| width 6
  -- Member definitions
    -- User dbRef
    member .dbRef      is DBREF
    -- Array of project teams
    member .teamArray  is ARRAY
    -- Teams to which user belongs
    member .membership is ARRAY
    -- Members to store sort and filter values
    member .filterVal is STRING
    member .sortVal   is STRING
    -- Array of project Acrs
    member .nonMemAcrArray  is ARRAY
    -- Teams to which user belongs
    member .aMembership is ARRAY
    -- Members to store sort and filter values
    member .acrFilterVal is STRING
    member .acrSortVal   is STRING
    -- Working Extracts
    member .wEArray is ARRAY
    -- Password text memory
    member .fromDialog is STRING

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  -- set icons
  !!admUser.add.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !!admUser.rem.addPixmap(!!pml.getPathName('leftarrow16.png'))

  -- Initialise variables
  !dText  = ARRAY()
  !rText  = ARRAY()

  -- set icons
  !!admUser.acrAdd.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !!admUser.acrRem.addPixmap(!!pml.getPathName('leftarrow16.png'))
  !!admUser.acrUp.addPixmap(!!pml.getPathName('uparrow16.png'))
  !!admUser.acrDown.addPixmap(!!pml.getPathName('downarrow16.png'))

  -- Assign user security values
  !dText.append(|Free|)
  !dText.append(|General|)
  !!admUser.secu.dText = !dText
  !dText.clear()
  !rText.append(|FREE|)
  !rText.append(|GENERAL|)
  !!admUser.secu.rText = !rText
  !rText.clear()

  -- Assign mode gadget values
  !dText.append(|Create|)
  !dText.append(|Modify|)
  !!admUser.mode.dText = !dText
  !dText.clear()
  !rText.append(|CREATE|)
  !rText.append(|MODIFY|)
  !!admUser.mode.rText = !rText
  !rText.clear()

  -- Assign sort gadget values
  !!admTeamSortGadg(!this.sort)

  -- Assign Filter Gadget
  !!admUser.filter.val = |*|

  -- Assign sort gadget values
  !!admAcrSortGadg(!this.acrSort)

  -- Assign Filter Gadget
  !!admUser.acrFilter.val = |*|

exit
-- End of form definition for !!admUser

------------------------------------------------------------------------
--
-- Method: .cbApply()
--
-- Description: create or modify a USER element. The values for the
-- element are taken from the USER Definition form.
-- be replaced by method .cbApply()
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbApply()

  -- Initialise variables
  !dbRef             = !this.refGet()
  !mode              = !this.modeGet()
  !updateFlag        = false

  -- Check that the name gadget is set
  if (!this.name.val eq 'unset') then

    -- Reset gadget in modify mode
    if (!mode eq 'MODIFY') then
      !this.name.val          = !dbRef.name.substring(2)
    endif

    -- Raise error
    !this.name.setFocus()
    !!messageFile.error(141, 101,  !mode.lowcase())

  endif

  -- DUN1135 : allow unset passwords (with confirm)

  -- Action attribute depending on mode
  if (!mode eq 'CREATE') then

    -- User attributes
    !userName          = !this.name.val
    if !this.fromDialog ne || then
      !passText        = |/| + !this.fromDialog
    else
      !passText        = ||
    endif
    !security          = !this.secu.selection('dtext')
    !description       = !this.desc.val

    -- Navigate to the user world
    !!ce               = !!dbrAdminGetWorld('USER')

    -- P-25809: confirm user creation with no password
    if (!passText eq ||) then
        !answer = !!alert.confirm( !!messageFile.messageString(141, 115) )
        if (!answer.boolean().not()) then
            return
        endif
    endif

    -- Create the USER element *** OLD PML SYNTAX ****
    call !!admCommand('CREATE USER |$!userName| $!passText $!security')
    handle any

      !!alert.error(!!error.text)
      return

    endhandle

    -- Set the update flag
    !updateFlag        = true
    -- have to go to user element via world because user name can be the same as MDB name
    !userWorld         = !!dbrAdminGetWorld('USER')
    !!ce               = !userWorld
    VAR !userJustCreated COLL MEMBERS OF CE WITH ( NAMN eq '$!userName' )
    !!ce               = !userJustCreated[1].dbRef()

    -- Set the new element description
    if (!description neq 'unset') then
      !!ce.description = !description
    endif

    !!adminElem.userSet(!!ce)

    -- Create New ACRs (Only do this if a general user)
    !test = !this.secu.selection().upcase().trim()
    -- because FREE users are not subjected to DAC
    if(!test EQ |GENERAL|)then
      do !i indices !this.aMembership
        !acrName = !this.aMembership[!i].name
        call !!admCommand(|ACRLI NUMBER $!i $!acrName|)
        !updateFlag      = true
      enddo
    endif

    !dbRef             = !!ce

  elseif (!mode eq 'MODIFY') then

    -- User attributes
    !userName          = |/| + !this.name.val
    !passText          = |/| + !this.fromDialog
    !security          = !this.secu.selection('dtext')
    !description       = !this.desc.val

    -- Navigate to the user element
    !!ce               = !dbRef

    -- Check for element being already claimed

    if (not !!dbRefUpdate (!dbRef)) then
      !!alert.error (!!error.text)
      return
    endif

    -- Change the name
    if (!dbRef.name neq !userName) then

      -- Modify the name   *** OLD PML SYNTAX ***
      call !!admCommand(|NAME $!userName|)
      handle (41,12)

        -- User Already exists
        !!alert.error(!!messageFile.messageString(141, 103,  !this.name.val))
        !this.name.val           = !dbRef.name.substring(2)

      endhandle

      -- Set the update flag
      !updateFlag         = true
      !this.formTitle = |Modify User: |+ !dbRef.name.substring(2)

    endif

    -- Change pass
    if (!this.fromDialog neq ||) then

      -- Modify   *** OLD PML SYNTAX ***
      call !!admCommand('PASS |$!passText|')

      !this.fromDialog = ||
      !this.setPass.tag = |Reset Password|

    endif

    -- Change the security
    if (!dbRef.security neq !security) then

      -- validate whether they want to do this
      -- (This should really be a callback on !this.secu gadget)
      !curSess = current session
      !curSessUser = !curSess.user()
      if( !userName.after('/') eq !curSessUser.name and !security neq 'Free' ) then
        !answer = !!alert.confirm( !!messageFile.messageString(141, 114, !userName.after('/') ))
      else
        !answer = true
      endif

      if( !answer.boolean() ) then
        -- Modify the security   *** OLD PML SYNTAX ***
        call !!admCommand(|SECU $!security|)
        !updateFlag         = true
      else
        !this.secu.select( 'dtext', 'Free' )
      endif

    endif

    -- Change the description
    if (!dbRef.description neq !description) then
      !!ce.description = !description
      !updateFlag      = true
    endif

    -- Clear Current Acrs
    call !!admCommand(|ACRLI UNSET|)

    -- Create New ACRs (Only do this if a general user)
    !test = !this.secu.selection().upcase().trim()
    -- because FREE users are not subjected to DAC
    if(!test EQ |GENERAL|)then

      do !i indices !this.aMembership
        !acrName =  !this.aMembership[!i].name
        call !!admCommand(|ACRLI NUMBER $!i $!acrName|)
        !updateFlag = true
      enddo

    endif

  endif

  -- Update forms if required
  if (!updateFlag) then
    !!adminElem.update('USER')
  endif

  -- Get the user membership details
  !membership       = !this.membGet()
  !addRefs          = !membership.difference(!dbRef.teamLs)
  !remRefs          = !dbRef.teamLs.difference(!membership)

  -- Get the user name
  !userName         = !dbRef.name.substring(2)

  -- Add user to teams
  do !teamRef values !addRefs
    !teamName          = !teamRef.name.substring(3)
    call !!admCommand(|SET TEAM $!teamName|)
    call !!admCommand('TADD |$!userName|')
  enddo

  -- Remove user from teams
  do !teamRef values !remRefs
    !teamName          = !teamRef.name.substring(3)
    call !!admCommand(|SET TEAM $!teamName|)
    call !!admCommand('TREM |$!userName|')
  enddo

  -- Reset the form if create mode
  if (!mode eq 'CREATE') then
    !this.init()
  endif

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
-- Method: .display()
--
-- Description: Function to display the USER Definition form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Mode to display form in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display(!mode is STRING)

  -- Check mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY') then

    -- Invalid mode
    return error |Invalid mode for form !!admUser|

  endif

  -- Set the dbRef dependent on mode
  if (!mode.upcase() eq 'CREATE') then

    !!admUser.refSet(object dbRef())

  elseif (!mode.upcase() eq 'MODIFY') then

    -- Get the dbRef of the current user
    !dbRef  = !!adminElem.userGet()
    if (!dbRef.unset()) then
      -- No action required (don't show form)
      return
    elseif (!dbRef eq !!admUser.refGet() and !!admUser.shown()) then
      -- No action required
      return
    elseif (!dbRef.badRef()) then
      -- Raise error
      !!messageFile.error(141, 106,  !dbRef.string())
      handle (06, 106)
        !!adminElem.update('USER')
        return
      endhandle
    endif

    -- Set the new reference
    !!admUser.refSet(!dbRef)

  endif

  -- Select the mode
  !!admUser.modeSet(!mode.upcase())

  -- Show or update the form
  if (!!admUser.shown()) then

    -- Re-initialise the form
    !!admUser.init()

  else

    -- Show the form
    show !!admUser free

  endif

endmethod
-- End of method definition for .display(STRING)

------------------------------------------------------------------------
--
-- Method: .init()
--
-- Description: initialise the USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- Initialise variables
  !mode     = !this.modeGet()
  !dbRef    = !this.refGet()

  -- Reinstate sort and filter values
  if (!this.filterVal.set()) then
    !this.filter.val = !this.filterVal
  endif
  if (!this.sortVal.set()) then
    !this.sort.select('rtext',!this.sortVal)
  endif

  !this.fromDialog = ||

  -- Set the form gadgets according to mode
  if (!mode eq 'CREATE') then

    !this.formTitle  = !!messageFile.messageString(141, 856)
    !this.name.val   = |unset|
    !this.setPass.tag = |Set Password|
    !this.desc.val   = |unset|
    !this.secu.select('rtext','GENERAL')
      !this.acrAdd.active = TRUE
      !this.acrRem.active = TRUE
    !this.membership.clear()
    !this.memAcrs.clear()
    !this.nonMemAcrs.clear()
    !this.acrSet()
    !this.aMembSet()
    !this.aMembList()
    !this.acrList()
--    !this.wExtracts.clear()
  elseif (!mode eq 'MODIFY') then

    !this.formTitle  = !!messageFile.messageString(141, 855) + !dbRef.name.substring(2)
    !this.name.val = !dbRef.name.substring(2)
    !passQuality = !dbRef.passq
    handle any
       !passQuality = 0
    endhandle
    if (!passQuality eq 0) then
      !this.setPass.tag = |Set Password|
    else
      !this.setPass.tag = |Reset Password|
    endif
    if (!dbRef.description.empty()) then
      !this.desc.val   = |unset|
    else
      !this.desc.val   = !dbRef.description
    endif
    !this.secu.select('dtext',!dbRef.security)
    -- because FREE users are not subjected to DAC
    if(!dbRef.secu.upcase() EQ |FREE|)then
      !this.acrAdd.active = FALSE
      !this.acrRem.active = FALSE
    else
      !this.acrAdd.active = TRUE
      !this.acrRem.active = TRUE
    endif
    !this.membership.clear()
    !this.memAcrs.clear()
    !this.nonMemAcrs.clear()
    !this.acrSet()
    !this.aMembSet()
    !this.aMembList()
    !this.acrList()

    -- Get working Extracts for user
--    !this.workExtGet()

  endif

  -- Display a message
  !!messageFile.prompt(141, 004,  !this.formTitle, !!messageFile.messageString(141, 803))

  -- Set the user information
  !this.teamSet()
  !this.membSet()

  -- Update the project team list
  !this.teamList()
  !this.membList()

  -- Dismiss the prompt
  !!prompt(0)

  -- Set focus to the name gadget
  !this.name.setFocus()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method: .membAdd()
--
-- Description: add the selected project teams to the user membership store.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .membAdd()

  -- Get the current selection
  !teamSel    = !this.projTeams.val

  -- Return if no values
  if (!teamSel.size() eq 0) then
    return
  endif

  -- Process the selection list
  do !i values !teamSel

    -- Convert the value
    !dbRef     = !this.projTeams.rText[!i].dbRef()
    handle any
      -- Bad reference
      skip
    endhandle

    -- Add the value to the membership store
    !this.membership.append(!dbRef)

  enddo

  -- Update the list gadgets
  !this.teamList()
  !this.membList()

endmethod
-- End of method definition for .membAdd()

------------------------------------------------------------------------
--
-- Method: .membGet()
--
-- Description: return the stored array of team members for the user in
-- the USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of dbRef of Team membership
--
------------------------------------------------------------------------

-- Define method
define method .membGet() is ARRAY

  -- Return the value
  return !this.membership

endmethod
-- End of method definition for .membGet() ARRAY

------------------------------------------------------------------------
--
-- Method: .membList()
--
-- Description: update the contents of the user membership list gadget
-- on the USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .membList()

  -- Initialise variables
  !membership    = !this.membGet()

  -- Clear the list
  !this.teams.clear()

  -- Sort the list by name
  !nameBlock     = object BLOCK(|!membership[!evalIndex].name.substring(2)|)
  !names         = !membership.evaluate(!nameBlock)
  !order         = !names.sortedIndices()
  !membership.reIndex(!order)

  -- Display the membership
  !!adminTeamTxtList(!membership, !this.teams, !!admDisplayConfig.fmtTeamGet(), !!admDisplayConfig.eleTypeGet())

endmethod
-- End of method definition for .membList()

------------------------------------------------------------------------
--
-- Method: .membRem()
--
-- Description: remove the selected teams from the user membership store.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .membRem()

  -- Get the selected teams
  !teamSel    = !this.teams.val

  -- Return if no selection
  if (!teamSel.size() eq 0) then
    return
  endif

  -- Process the selection list
  do !index values !teamSel

    -- Convert value
    !dbRef      = !this.teams.rText[!index].dbRef()
    handle any
      -- Bad reference
      skip
    endhandle

    -- Find the element in the member array
    !pos        = !this.membership.findFirst(!dbRef)
    if (!pos.set()) then
      !this.membership.remove(!pos)
    endif

  enddo

  -- Update the list gadgets
  !this.teamList()
  !this.membList()

endmethod
-- End of method definition for .membRem()

------------------------------------------------------------------------
--
-- Method: .membSet()
--
-- Description: set the form attribute containing the array of teams to
-- which the USER in the USER Definition form is a member.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .membSet()

  -- Initialise variables
  !dbRef                = !this.refGet()

  -- Get the teams for the user
  if (!dbRef.badRef()) then
    -- dbRef is unset
    !membership           = ARRAY()
  else
    -- Get the membership
    !membership           = !dbRef.teamLs
  endif

  -- Store the array
  !this.membership  = !membership

endmethod
-- End of method definition for .membSet()

------------------------------------------------------------------------
--
-- Method: .cbMode()
--
-- Description: Callback to the mode gadget in the USER Definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .mode()

  -- Read the mode value
  !mode    = !this.modeGet()

  -- the display reset the form
  !this.display(!mode)

endmethod
-- End of method definition for .mode()


------------------------------------------------------------------------
--
-- Method: .modeGet()
--
-- Description: return the current mode of the USER definition form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Mode of form.
--
------------------------------------------------------------------------

-- Define method
define method .modeGet() is STRING

  -- Return the mode
