-- File:            admusercpy.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Mon Jul 21 11:55:10 BST 1997
--
--
-- Description:
-- Form definition to provide facilities to copy USER elements.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   method to copy a source user to a new user using the Admin form of
--  init()                           -                   method to initialise the User Copy Form.
--  nameSet()                        -                   method to act as a callback to the Name gadget in the Copy User
--  passSet()                        -                   method action for password confirm gadget in the Copy User
--  refGet()                         DBREF               method to return the DBREF of the source USER for a copy user
--  refSet(DBREF)                    -                   method to set the DBREF of the source USER.
--
------------------------------------------------------------------------

-- Initialise variables
!dText   = ARRAY()
!rText   = ARRAY()

-- Define form
setup form !!admUserCpy at xr 0.35 yr 0.1

  !this.formTitle     = 'Copy User'
  !this.iconTitle     = 'COPYUSER'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.13 $ '

  -- Body of form definition
  text .name at x 0 y 0 |To User    | call |!this.nameSet()| width 30 scroll 49 NAME
  frame .passFrame at xmin ymax
    text .pass at  xmin+0.5 ymax+0.2 |Password   |  width 15 noecho STRING
    text .pass2 at xmin ymax+0.2 |Confirm    | call |!this.passSet()| width 15 noecho STRING
  exit
  option .security at xmin.name ymax+0.2 |Security   | width 10
  text .desc at xmin ymax+0.2 |Description| width 30 scroll 120 STRING

  button .ok at xmin.name ymax+0.5 |  OK  | call |!this.cbApply()| OK
  button .cancel at xmax form-size ymin |Cancel| CANCEL

  -- Member definitions
    -- Source user Dbref
    member .dbRef is DBREF

exit
-- End of form definition for !!admUserCpy

-- Assign access gadget values
!dText.append(|Free|)
!dText.append(|General|)
!!admUserCpy.security.dText  = !dText
!dText.clear()
!rText.append(|FREE|)
!rText.append(|GENERAL|)
!!admUserCpy.security.rText  = !rText
!rText.clear()

------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: method to copy a source user to a new user using the Admin form of
-- the copy command.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbApply()

  -- Initialise variables
  !sourceUser       = !this.refGet()
  !sourceName       = !sourceUser.name.substring(2)
  !targetUser       = !this.name.val.upcase()
  !passText         = |/| + !this.pass2.val
  !security         = !this.security.selection('rtext')
  !description      = !this.desc.val

  -- Check for unset target name
  if (!targetUser eq 'UNSET') then
    !!messageFile.error(141, 107)
  endif

  -- Check for unset password
  -- Note that password is *not* optional in COPY USER command
  if !this.pass2.val eq || then
    -- generic password error for 'copy'
    !!messageFile.error(141, 102, !!messageFile.messageString(141,810))
  endif

  -- Create copy command
  !command          = 'COPY USER '+ '|' + !sourceName +'|' + ' TO '+ '|' + !targetUser + '|' + ' '+ !passText +' '+ !security
  -- Execute the copy command
  call !!admCommand(!command)
  handle (1,3)

    -- User already exists
    !!messageFile.error(141, 103, !targetUser)

  elsehandle (1,6)

    -- Source user not found
    !!adminElem.update('USER')
    !!messageFile.error(141, 106, !sourceUser)

  elsehandle any

    -- Non specific
    !!messageFile.error(141, 107, !!error.text)

  endhandle

  -- Goto the new DBREF
  -- have to go to user element via world because user name can be the same as MDB name
  !userWorld         = !!dbrAdminGetWorld('USER')
  !!ce               = !userWorld
  VAR !userJustCreated COLL MEMBERS OF CE WITH ( NAMN eq '$!targetUser' )
  !!ce              = !userJustCreated[1].dbRef()
  !!adminElem.userSet(!!ce)

  -- Copy command was a success so modify the description
  if (!description.empty() or !description eq 'unset') then
    !description = ''
  endif
  !!ce.description = !description

  -- Update the forms
  !!adminElem.update('USER')
  !!admUser.update()

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: method to initialise the User Copy Form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- -- Initialise form variables
  !dbRef     = !!adminElem.userGet()
  !this.refSet(!dbRef)

  -- Set the form title
  !this.formTitle = |Copy User: |+ !dbRef.name.substring(2)

  -- Initialise form gadgets
  !this.name.val  = |unset|
  !this.pass.val  = ||
  !this.pass2.val = ||
  !this.security.select('rtext',!dbRef.security.upcase())
  if (!dbRef.description.empty()) then
    !this.desc.val  = |unset|
  else
    !this.desc.val  = !dbRef.description
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
--Method: .nameSet()
--
-- Description: method to act as a callback to the Name gadget in the Copy User
-- form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .nameSet()

  -- Initialise variables
  !tempRef     = object DBREF()

  -- Call the user name check
  if( !!admChkUserName(!this.name, !tempRef) ) then
    -- Name was good move focus on
    !this.pass.setFocus()
  else
    -- Name was bad keep focus here
    !this.name.setFocus()
  endif

endmethod
-- End of method definition for .nameSet()

------------------------------------------------------------------------
--
--Method: .passSet()
--
-- Description: method to action for password confirm text in Copy User
-- form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .passSet()

  -- Ensure password and confirmation match
  if !this.pass.val ne !this.pass2.val then
    -- Password mismatch, so warn
    !!alert.warning( 'Passwords do not match. Please enter and confirm password.' )
    -- clear
    !this.pass.val  = ||
    !this.pass2.val = ||
    -- and keep focus on passwords
    !this.pass.setFocus()
  endif

endmethod
-- End of method definition for .passSet()

------------------------------------------------------------------------
--
--Method: .refGet()
--
-- Description: method to return the DBREF of the source USER for a copy user
-- operation.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of source user
--
------------------------------------------------------------------------

-- Define method
define method .refGet() is DBREF

  -- Return the values
  return !this.dbRef

endmethod
-- End of method definition for .refGet() DBREF

------------------------------------------------------------------------
--
--Method: .refSet()
--
-- Description: method to set the DBREF of the source USER.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Source USER Dbref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refSet(!dbRef is DBREF)

  -- Check that the element type is a USER
  if (!dbRef.type neq 'USER') then
    return error
  endif

  !this.dbRef  = !dbRef

endmethod
-- End of method definition for .refSet(DBREF)
