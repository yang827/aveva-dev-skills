--
------------------------------------------------------------------------

define method .userArrGet() is ARRAY

  -- Return the value
  return !this.userArray

endmethod
-- End of method definition for .userArrGet() ARRAY

------------------------------------------------------------------------
--
-- Method: .userArrList()
--
-- Description: update the contents of the project teams list gadget on
-- DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .userArrList()

  -- Initialise variables
  !projUsers         = !this.userArrGet()
  !dbOwner           = !this.userGet()

  -- Save the sort and filter values for later user
  !this.filterVal  = !this.filter.val
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif
  !this.sortVal    = !this.sort.selection('rtext')

  -- Clear the list
  !this.projUsers.clear()

  -- Sort the list of teams
  !displayList       = !!adminFilterSort(!projUsers, !this.sort, !this.filter)

  -- Check that the DB Owner is displayed    [badref check had to be added to cope with problem after location switch]
  if (not badref(!dbOwner)) then
    if( !dbOwner.type eq 'TMLI' ) then
      -- not sure why we get in this state, but protects from failure
      !dbOwner = !dbOwner.owner
    endif
    !pos               = !displayList.findFirst(!dbOwner)
    if (!pos.unset() and !dbOwner.type eq 'USER') then
      !displayList.insert(1,!dbOwner)
    endif
  else
    if (!displayList.set()) then
      !dbOwner           = !displayList[1]
      !this.userSet(!dbOwner)
    endif
  endif

  -- Display the list of teams
  !!adminUserTxtList(!displayList, !this.projUsers, !!admDisplayConfig.fmtUserGet(), !!admDisplayConfig.eleTypeGet())

  -- Select the DB owner
  !this.projUsers.select('rtext', !dbOwner.string())
  handle any
    -- Only if DbOwner is unset
  endhandle

endmethod
-- End of method definition for .userArrList()

------------------------------------------------------------------------
--
--Method: .userArrSet()
--
-- Description: set the form member for the project teams in the DB
-- Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .userArrSet()

  -- Initialise variables
  !users             = ARRAY()
  !currentPos        = !!ce

  -- Collect the project teams
  !!ce               = !!dbrAdminGetWorld('USER')
  !users             = !!collectAllFor('USER','',!!ce)

  -- Assign the array to its store
  !this.userArray  = !users

  -- Return to database position
  !!ce               = !currentPos

endmethod
-- End of method definition for .userArrSet()

