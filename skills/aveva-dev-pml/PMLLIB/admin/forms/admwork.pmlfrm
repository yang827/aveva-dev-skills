--
--
-- Description:
-- form to create working extracts
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admWork()                        -                   Constructor
--  cbApply()                        -                   create or modify a DB element. The values method . the element
--  cbName(GADGET)                   -                   Callback to the Name gadget in the DB Definition form.
--  display(STRING)                  -                   display the DB Definition form.
--  init()                           -                   initialise the DB Definition form.
--  locGet()                         DBREF               return the DBREF of the current databases primary loc.
--  locSet(DBREF)                    -                   set the form member for a databases primary location
--  modeGet()                        STRING              return the current mode of the DB Definition form.
--  origDbArrGet()                   ARRAY               return the array of project origDbs being used by
--  origDbArrList()                  -                   update the contents of the project origDbs list gadget on
--  origDbArrSet()                   -                   set the form member for the project origDbs in the DB
--  origDbGet()                      DBREF               return the DBREF of the origDb to which the current DB in
--  origDbSel(GADGET)                -                   Callback to Project origDb list for user selection.
--  origDbSet(DBREF)                 -                   set the current origDb DBREF for the DB Definition form.
--  refGet()                         DBREF               return the current DB DBREF for the element being edited.
--  refSet(DBREF)                    -                   set the current DB DBREF for the DB Definition form.
--  refresh()                        -                   refresh the TEAM elements listed in the Project Teams
--  setExtNoToSys(GADGET)            -                   set extno to system, so that the number is chosen by the system
--  update()                         -                   update the displayed DB in the DB Definition form.
--  userArrGet()                     ARRAY               return the array of project teams being used by
--  userArrList()                    -                   update the contents of the project teams list gadget on
--  userArrSet()                     -                   set the form member for the project teams in the DB
--  userGet()                        DBREF               return the DBREF of the TEAM to which the current DB in
--  userSel(GADGET)                  -                   Callback to Project Team list for user selection.
--  userSet(DBREF)                   -                   set the current TEAM DBREF for the DB Definition form.
--
------------------------------------------------------------------------

-- Initialise variables
!dText         = ARRAY()
!rText         = ARRAY()
!globalProject = !!glbIsGlobal()
if (!globalProject) then
   !hubLocation  = !!glbHubStatus(!globalProject)
else
   !hubLocation  = false
endif

setup form !!admWork at xr 0.35 yr 0.1 resize

  !this.formTitle     = 'Create Working Extracts'
  !this.iconTitle     = 'Extract'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.22 $ '

  -- Body of form definition

  --para .extractNameTx at x 0 y 1 text |Extract |
  para .extractName  at x0 ymin width 44 line 1

  frame .origDbFrame at x0 ymax+0.3  anchor all |Database to Create Working Extracts From|

    list .projDbs  at xmin+1 ymin+1    anchor all    call |!this.origDbSel(!this.projDbs)| columns width 50 height 10

    option .dbSort at xmin ymax+0.1   |Sort | anchor left+bottom  call |!this.origDbArrList()| width 12
    text .dbFilter at xmax+1 ymin | Filter | anchor bottom+left call |!this.origDbArrList()| width 20 STRING

  exit

  frame .userFrame at x 0 ymax.origDbFrame+0.2  anchor left+right+bottom|User List|

    list .projUsers at xmin+1 ymin+1 anchor left+right      call |!this.userSel(!this.projUsers)| MULTI columns width 50 height 10

    option .sort   at xmin ymax+0.1   |Sort |  anchor left+bottom call |!this.userArrList()| width 12
    text   .filter at xmax+1 ymin | Filter | anchor left+bottom call |!this.userArrList()| width 20 STRING

  exit

 -- text .name at x 4 ymax+0.5 |Name         | call |!this.cbName(!this.name)| width 32 scroll 32 NAME

  text   .desc    at xmin+3 ymax+0.3 |Description  | anchor bottom+left+right width 36 scroll 120 STRING

  -- ## B u n g controlled in here
  option .claim   at xmin+14 ymax+0.3 anchor bottom+left width 15

  toggle .controlled at xmax+1 ymin |Controlled| anchor bottom+left
  toggle .variant    at xmin   ymax |Variant|    anchor bottom+left

  text   .area    at xmin.desc ymax+0.2 |Area Number  | anchor bottom+left call |!!admChkDbArea(!this.area.val,!this.area,!this.refGet())| width 10 INTEGER min 0 max 999
  button .areaDef at xmax+1 ymin |System| anchor bottom+left call |!!admChkDbArea('SYS',!this.area,!this.refGet())|

  -- Gadgets for a Global Project
--  if (!globalProject) then

    text   .extNo    at xmin.area-2 ymax+0.2 |Extract Number | anchor bottom+left width 10 INTEGER min 2 max 8191
    button .extNoDef at xmax+1 ymin          |System| anchor bottom+left call |!this.setExtNoToSys(!this.extNo)|

    --text .primary at xmin.desc ymax+0.2   |Primary Loc. | call |!this.loc(!this.primary.val)| width 28 NAME
    --if (!hubLocation) then
      -- button .priBtn at xmax ymin pixmap width 16 height 16 call |!!glbDbPri.infoInit(!this)|
    --endif
--     paragraph .distTx at xmin.desc ymax+0.2 text |Propagate   |
--     toggle .distDb at xmax ymin |Database|
--     toggle .picture at xmax+2 ymin |Picture Files|

--  endif

  button .apply   at x 0  ymax+0.5             |Apply|   anchor bottom+left call |!this.cbApply()| APPLY
  button .reset   at xcen form-0.5 * size ymin |Reset|   anchor bottom RESET
  button .dismiss at xmax form-size       ymin |Dismiss| anchor bottom+right CANCEL

  -- Member definitions
    -- Active database DBREF
    member .dbRef is DBREF

    -- Original DB
    member .origDb      is DBREF
    -- Project Teams
    member .origDbArray is ARRAY

    -- Owning team
    member .user      is DBREF
    -- Project users
    member .userArray is ARRAY

    if (!globalProject) then
      -- Primary Location
      member .primaryLoc is DBREF
    endif
    --  Members to store sort and filter values
    member .filterVal is STRING
    member .sortVal   is STRING

    --  Members to store sort and filter values
    member .dbFilterVal is STRING
    member .dbSortVal   is STRING


-- set icons
--if (!globalProject) then
  -- if (!hubLocation) then
    -- !this.priBtn.addPixmap(!!pml.getPathName('popup16.png'))
  --endif
--endif

-- Assign sort gadget values
!!admTeamSortGadg(!this.sort)

-- Assign sort gadget values
!!admDbSortGadg(!this.dbSort)

-- Assign filter gadget value
!this.filter.val    = |*|

-- Assign filter gadget value
!this.dbFilter.val    = |*|

-- Assign area gadget value

  !this.area.val      = |System|

-- Assign extno gadget value
--   if (!globalProject) then
     !this.extNo.val      = |System|
--   endif

-- Assign claim mode gadget values

  !dText.append(|Implicit Claim|)
  !dText.append(|Explicit Claim|)
  !this.claim.dText   = !dText
  !dText.clear()
  !rText.append(|IMPLICIT|)
  !rText.append(|EXPLICIT|)
  !this.claim.rText   = !rText
  !rText.clear()

-- Assign picture file gadget values
--if (!globalProject) then
--  !this.distDb.val    = true
--  !this.picture.val   = false
--endif

exit
-- End of form definition for !!admWork
------------------------------------------------------------------------
--
--Method: .admWork()
--
-- Description: Constructor
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .admWork()

    !menu = !this.newMenu('clearList')
    !menu.add('callback', 'Clear Selection',  '!this.projUsers.clearSelection()')

    !this.projUsers.setPopup(!this.clearList)

endmethod
-- End of method definition for .admWork()

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: initialise the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Initialise variables
  !dbRef             = !this.refGet()
  !globalProject     = !!glbIsGlobal()

  -- Reinstate the sort and filter gadgets
  if (!this.filterVal.set()) then
    !this.filter.val = !this.filterVal
  endif
  if (!this.sortVal.set()) then
    !this.sort.select('rtext',!this.sortVal)
  endif

    -- Reinstate the sort and filter gadgets
  if (!this.dbFilterVal.set()) then
    !this.dbFilter.val = !this.dbFilterVal
  endif
  if (!this.dbSortVal.set()) then
    !this.dbSort.select('rtext',!this.dbSortVal)
  endif

  !this.formTitle      = |Create Working Extracts|
  --!this.name.val       = |unset|
  !this.desc.val       = |unset|

  -- Set Global Attributes
--  if (!globalProject) then
    !this.extNo.active = TRUE

    --!primary               = !!dbrGlbHubLocRf()
    --!this.locSet(!primary)
   -- !this.primary.val    = !primary.name.substring(2)
--  endif

  -- Display a message
  !!messageFile.prompt(141, 4, !this.formTitle, !!messageFile.messageString(141, 804))

  -- Gather the team information
  !this.userArrSet()

  -- Update the list of teams
  !this.userArrList()

  -- clear the last master DB
  !this.origDb = object DBREF()

  -- Gather the DB information
  !this.origDbArrSet()

  -- Update the list of DBs
  !this.origDbArrList()

  -- Dismiss the prompt
  !!prompt(0)

  -- only set this if modify (AK) to do
  -- Set the database name paragraph gadget
  --!dbOwner  = !this.userGet()
  --if (!dbOwner.unset()) then
    --!this.extractName.val  = |unset/|+ !this.name.val
  --else
    --!this.extractName.val  = !dbOwner.name    +|/|+ !this.name.val
  --endif

  -- set the claim button to match owning DB (AK)

    !claim = !this.origDb.claimDb.upcase()
    handle any
      return
    endhandle
    !this.claim.select('RTEXT',!claim)
     handle any
       -- safety net (shouldn't need this)
     endhandle
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method: .cbApply()
--
-- Description: create or modify a DB element. The values method . the element
-- are taken from the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cbApply()

  -- Some Preliminary checks
  --if((!this.name.val EQ ||) OR (!this.name.val EQ |UNSET|))then
    -- ##
    --!!alert.error(|Please enter a valid name in the Name field!|)
    --return
  --endif
  if(!this.projUsers.val.unset())then
    -- ##
    !!alert.error(|Please select a User|)
    return
  endif
  if(!this.projDbs.val.unset())then
    -- ## this should never happen (AK)
    !!alert.error(|Please select Database to create a Working Extract from!|)
    return
  endif

  -- Initialise variables
  !dbRef      = !this.refGet()
  !owner      = !this.userGet()
--  !globalProj = !!glbIsGlobal()

  -- Check that the team is set
  if (!owner.unset()) then
    -- Raise error
    !!alert.error(!!messageFile.messageString(141, 151, !mode.lowcase()))
    return
  endif

  -- Check that the team is valid
  if (!owner.badRef()) then

    -- Team does not exist
    !!alert.error(!!messageFile.messageString(141, 3, !!messageFile.messageString(141, 803), !owner.string()))
    handle (06, 003)
      -- Dummy handle
    endhandle
    return

  endif

  -- Gather attribute values
  !dbName      = !this.origDb.name.substring(3)
  handle any
    -- no DB selected
    !!alert.error('No database selected')
    return
  endhandle

  !description = !this.desc.val
  !allUsers    = !this.projUsers.selection()

    if(!this.controlled.val) then
    !control = | CONTROLLED|
  else
    !control = ||
  endif

  -- Get the CLAIM value
  if (!this.claim.val.set())then
    !claim       = | CLAIM | + !this.claim.selection('rtext')
  else
    !claim       = ||
  endif

  -- Get the AREA value
  if (!this.area.val.trim() eq 'System') then
    !area        = ||
  else
    !area        = | IN AREA | + !this.area.val
  endif

 -- Get the extno value
--  if(!globalProj) then
    if (!this.extNo.val.trim() eq 'System') then
      !extNo        = ||
    else
      !extNo        = | EXTNO  | + !this.extNo.val
    endif
--  else
--    !extNo = ||
--  endif

 !command = ARRAY()
  do !i values !allUsers
    !user = !i.dbRef().name.substring(2)
    if(!this.variant.val) then
      -- Construct the command
      !command.append(|CREATE WORK VARIANT FROM |+ !dbName + | FOR | + |'| + !user + |'| + !control + !area + !claim + !extNo )
    else
      -- Construct the command
      !command.append(|CREATE WORK EXTRACT FROM |+ !dbName + | FOR | + |'| + !user + |'| + !control + !area + !claim + !extNo )
    endif
  enddo

    -- Navigate to the new DB
    !dbName       = |/*|+ !dbName

  -- Execute the command

  do !i indices !command
    call !!admCommand(!command[!i])
    handle (1,4)

      -- Db Already exists
      !!alert.error(!!messageFile.messageString(141, 153, !dbName))
      return

    elsehandle (1,15)

      -- Maximum number of databases reached
      !!alert.error(!!messageFile.messageString(141, 154))
      return

    elsehandle (1,17)

      -- File already exists
      !!alert.error(!!messageFile.messageString(141, 155))
      return

    elsehandle (1,19)

      -- Cannot open virgin database
      !!alert.error(!!messageFile.messageString(141, 156, !dbName))
      return

    elsehandle (1,35)

      -- Area does not exist
      !!alert.error(!!messageFile.messageString(141, 157, !this.area.val))
      !this.area.val = |System|
      return

    elsehandle (1,266)

--      if( !globalProj ) then
        -- ext number already used (AK) (message error to do)
        !!alert.error(|Database Number $!<this.extNo.val> already used|)
        !this.extNo.val     = |System|
--      else
--        !!alert.error(!!error.text)
--      endif
      return

    elsehandle (1,373)
      !user     = !allUsers[!i].dbRef().name
      !dbString = !dbName.substring(3)
      -- ext number already used (AK) (message error to do)
      !!alert.error(|User $!user already has a working extract for db $!dbString|)
      return

    elsehandle (1,351)

      -- extract number range not set
      !!alert.error('Extract number range not set for this location, or extract number not in extract number range')
      return

    elsehandle any

      -- extract number range not set
      !!alert.error(!!error.text)
      return

    elsehandle none

      -- Set the database description
      if (!description neq 'unset') then
        -- find the working extract name
        !userRef      = !allUsers[!i].dbRef()
        !!ce          = !dbName.dbRef()
        do !extract values !dbName.dbRef().extcls
          skip if( !extract.owner.owner ne !userRef )
          !extract.description = !description
          break
        enddo
      endif

    endhandle
  enddo

  !!ce          = !dbName.dbRef()
   -- Set the update flag
   --!updateFlag   = true
   --!dbRef        = !!ce
   !!adminElem.dbSet(!!ce)

   !!adminElem.update('WORK EXT')
  -- (AK) !this.update()
 endmethod

------------------------------------------------------------------------
--
--Method: .display()
--
-- Description: display the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display from in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display(!mode is STRING)

  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE')then

    -- Invalid mode
    return error |Invalid mode for form !this.|

  endif

  !this.refSet(object DBREF())

  -- Show or update the form
  if (!this.shown()) then

    -- Re-initialise the form
    !this.init()

  else

    -- Show the form
    show !!admWork free

  endif

endmethod
-- End of method definition for .display(STRING)

