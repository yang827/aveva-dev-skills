-- File:            admworkmod.pmlfrm
--   Type:          Form Definition
--   Group:         PDMS Global Administration Application

--     Keyword:     GLOBAL
--   Module:        admin
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Mon Oct 18 9:46:15 BST 1999
--
--
-- Description:
-- form to create working extracts
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admWorkMod()                     -                   Constructor
--  cbApply()                        -                   create or modify a DB element.
--  cbName(GADGET)                   -                   Callback to the Name gadget in the DB Definition form.
--  display()                        -                   display the DB Definition form.
--  init()                           -                   initialise the DB Definition form.
--  locGet()                         DBREF               return the DBREF of the current databases primary loc.
--  locSet(DBREF)                    -                   set the form member for a databases primary location
--  refGet()                         DBREF               return the current DB DBREF for the element being edited.
--  refSet(DBREF)                    -                   set the current DB DBREF for the DB Definition form.
--  refresh()                        -                   refresh the TEAM elements listed in the Project Teams
--  update()                         -                   update the displayed DB in the DB Definition form.
--
------------------------------------------------------------------------

setup form !!admWorkMod at xr 0.35 yr 0.1

  !this.formTitle     = 'Modify Working Extracts'
  !this.iconTitle     = 'extMod'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.11 $ '

  -- Body of form definition

  para .wextTxt   text |Working Extract: |
  para .wextName  at xmax ymin text | | width 36
  para .dbNameTxt at xmin.wextTxt   ymax text |Extract db : |
  para .dbname    at xmax ymin text | | width 36
  para .userTxt   at xmin.dbNameTxt ymax text |  For User : |
  para .userName  at xmax ymin text | | width 36

  text   .desc    at xmin.dbNameTxt ymax+0.2 |Description  | width 38 scroll 120 STRING

  option .claim   at xmin+13.2 ymax+0.3 width 16

  toggle .controlled at xmax+1 ymin |Controlled|

  text   .area    at xmin.desc ymax+0.5 |Area Number  | width 10 INTEGER min 0 max 999
  button .areaDef at xmax+1 ymin |System|

  button .apply   at x 0  ymax+0.5             |Apply|   APPLY
  button .reset   at xcen form-0.5 * size ymin |Reset|   RESET
  button .dismiss at xmax form-size       ymin |Dismiss| CANCEL

  -- Member definitions
  -- Active database DBREF
  member .dbref is DBREF

  -- Original DB
  member .origDb      is DBREF
  -- Project Teams
  member .origDbArray is ARRAY

--  if (!globalProject) then
    -- Primary Location
    member .primaryLoc is DBREF
--  endif

exit
-- End of form definition for !!admWorkMod
------------------------------------------------------------------------
--
--Method: .admWorkMod()
--
-- Description: Constructor
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .admWorkMod()

-- Assign area gadget value
  !this.area.val      = |System|
-- Initialise variables
  !dText         = ARRAY()
  !rText         = ARRAY()

-- Assign claim mode gadget values
  !dText.append(|Implicit Claim|)
  !dText.append(|Explicit Claim|)
  !this.claim.dText   = !dText
  !rText.append(|IMPLICIT|)
  !rText.append(|EXPLICIT|)
  !this.claim.rText   = !rText

  !this.area.callback    = |!!admChkDbArea(!this.area.val,!this.area,!this.refGet())|
  !this.areaDef.callback = |!!admChkDbArea('SYS',!this.area,!this.refGet())|
  !this.apply.callback   = |!this.cbApply()|

endmethod
-- End of method definition for .admWorkMod()

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: initialise the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- get the db from the main admin form
  !dbref   = !!adminElem.db
  !desc    = !dbref.desc
  !claim   = !dbref.claimdb
  !area    = !dbref.area
  !control = !dbref.lctrol

  !user                = !dbref.owner.owner.fullname
  !workExtractName     = !dbref.fullname.substring(3)
  !this.wextName.val   = !workExtractName.substring(1,36)
  !this.dbname.val     = !workExtractName.substring(-8)
  !this.userName.val   = !user.substring(2)
  !this.dbref          = !dbref
  !this.claim.select('RTEXT',!claim.upcase())
  !this.desc.val       = !desc
  !this.controlled.val = !control

  if(!area.eq(0)) then
    !this.area.val = 'System'
  else
    !this.area.val = !area.string()
  endif
  -- Initialise variables

 !this.formTitle      = |Modify Working Extract|

  -- Dismiss the prompt
  !!prompt(0)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method: .cbApply()
--
-- Description: create or modify a DB element.
-- The elements are taken from the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbApply()

  !!ce     = !this.dbref
  !dbname  = !!ce.name.after('/*')
  !desc    = !this.desc.val
  !control = !this.controlled.val
  !claim   = !this.claim.selection()
  !area    = !this.area.val.real()
  handle ANY
    -- if system do nothing
  elsehandle NONE
    call !!admCommand(|AREA $!area|)
  endhandle
  !!ce.description = !desc
  call !!admCommand(|LCTROL $!control|)

  call !!admCommand('CLAIMDB |$!claim|')
  handle ANY
    -- don't work yet (TMU to fix)
    CHANGE $!dbname CLAIM $!claim
  endhandle
  !!adminElem.update('WORK EXT')

 endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
--Method: .display()
--
-- Description: display the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display()

  !selDb = !!adminElem.dbGet()
  !this.refSet(!selDb)

  -- Show or update the form
  if (!this.shown()) then
    -- Re-initialise the form
    !this.init()
  else
    -- Show the form
    show !!admWorkMod free
  endif

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
--Method: .locGet()
--
-- Description: return the DBREF of the current databases primary loc.
-- in the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of primary locations
--
------------------------------------------------------------------------
define method .locGet() is DBREF

  -- return the value
  return !this.primaryLoc

endmethod
-- End of method definition for .locGet() DBREF

------------------------------------------------------------------------
--
--Method: .locSet()
--
-- Description: set the form member for a databases primary location
-- in the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of Primary Location
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .locSet(!dbref is DBREF)

  -- Store the value
  !this.primaryLoc  = !dbref

endmethod
-- End of method definition for .locSet(DBREF)

------------------------------------------------------------------------
--
--Method: .cbName()
--
-- Description: Callback to the Name gadget in the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbName(!gadget is GADGET)

  -- Initialise variables
  !dbref    = !this.refGet()
  !value    = !gadget.val

  -- Check the name has not been entered with a '/'
  if (!value.substring(1,1) eq '/') then
    !value    = !value.substring(2)
  endif

  -- Reset the name gadget
  !gadget.val         = !value

endmethod
-- End of method definition for .cbName(GADGET)

------------------------------------------------------------------------
--
--Method: .refGet()
--
-- Description: return the current DB DBREF for the element being edited.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of DB being created or modified
--
------------------------------------------------------------------------
define method .refGet() is DBREF

  -- Return the value
  return !this.dbref
endmethod
-- End of method definition for .refGet() DBREF

------------------------------------------------------------------------
--
--Method: .refresh()
--
-- Description:refresh the TEAM elements listed in the Project Teams
-- gadget on the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refresh()

  -- Return in form in not shown
  if (Undefined (!!admWorkMod) or not !!admMdb.shown()) then
    return
  endif

  -- Display a message
  !!messageFile.prompt(141, 4, !!admWorkModIncl.formTitle, !!messageFile.messageString(141, 803))

  -- Rebuild the project teams
  !this.origDbArrSet()

  -- Update the project users list
  !this.origDbArrList()

  -- Dismiss the prompt
  !!prompt(0)

endmethod
-- End of method definition for .refresh()

------------------------------------------------------------------------
--
--Method: .refSet()
--
-- Description: set the current DB DBREF for the DB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF  of DB element (can be unset).
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refSet(!dbref is DBREF)

  -- Set the DBREF
  !this.dbref  = !dbref

endmethod
-- End of method definition for .refSet(DBREF)

------------------------------------------------------------------------
--
--Method: .update()
--
-- Description: update the displayed DB in the DB Definition form.
-- The form must be displayed in MODIFY mode.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .update()

  -- Return if the form is not shown
  if (!this.shown().not()) then
    return
  endif
  !this.init()

endmethod
-- End of method definition for .update()
