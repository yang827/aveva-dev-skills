--  Author:          Undefined
--  Created:         Thu Dec 13 15:15:52 2012

--
--  Description:     -- Form to allow admin to set or change a DB password.--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   action
--  changeDbPass()                   -                   constructor
--  init()                           -                   constructor
--  okcall()                         -                   action
--  update()                         -                   action
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            changedbpass.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--   Keyword:     GEN
--   Module:        Admin
-- Description:
-- Form to allow admin to set or change a DB password.
--
------------------------------------------------------------------------
--


setup form !!changeDbPass at xr 0 yr 0 MAIN

  -- Members
  member .mode is STRING
  member .dbRef  is DBREF

  -- Body of form definition
  path down

  text .oldPasswd      |Current Database Password:    | width 15 noecho string
  text .newPasswd      |New Database Password:        | width 15 noecho string
  text .confirmPasswd  |Confirm New Database Password:| width 15 noecho string

  button .ok at xmin ymax+0.5 |  OK  | APPLY

  button .cancel at xmax form-size ymin |Cancel| CANCEL

exit

------------------------------------------------------------------------
--
-- Method:      .changeDbPass()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .changeDbPass()

  --!this.dbRef    =     !!adminElem.dbGet()
  !this.formTitle     = |Set Database Password:|
  !this.iconTitle     = |CH DB PW|
  !this.callback      = |!this.init()|
  !this.formRevision  = | $Revision: 1.0 $ |

  -- callbacks
  !this.ok.callback            = |!this.okcall()|
  !this.cancel.callback        = |!this.cancel()|
endmethod

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .init()
!this.mode = !!admDb.modeGet()
!this.dbRef = !!admDb.refGet()
if (!this.mode eq 'MODIFY') then
   if (!!admDb.lpassGet() eq true) then
     !this.formTitle      = |Reset Database Password: | + !this.dbRef.name.substring(3)
     !this.oldPasswd.active = true
   else
     !this.formTitle      = |Set Database Password: | + !this.dbRef.name.substring(3)
     !this.oldPasswd.active = false
   endif
else
   !this.formTitle      = |Set Database Password: |
   !this.oldPasswd.active = false
endif
!this.oldPasswd.val     = ||
!this.newPasswd.val     = ||
!this.confirmPasswd.val = ||

endmethod

------------------------------------------------------------------------
--
-- Method:      .okcall()
--
-- Description: action
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .okcall()
!!admDb.fromDialog[1] = |NONE|
-- Ensure something is entered for old password
!confirmed = false
if (!this.mode eq 'MODIFY') then
   if ( !!admDb.lpassGet() eq true) then
      if (!this.oldPasswd.val eq ||) then
        !!alert.error('No current Database password entered.')
        if (!!admDb.fromDialog.size() ne 0) then
               !!admDb.fromDialog.clear()
           endif
        !this.hide()
        return
      else
--       Validate old pass:
         !confirmed = true
         !dbRef   = !this.dbRef
         !oldPass = !this.oldPasswd.val
--         !newPass = !this.confirmPasswd.val
-- If we pass same passwords as old and new, then this command only validates it against database
         !prevRef = !!ce
         !!ce     = !dbRef
         !dbName  = !dbRef.name.substring(3)
         !command = |CHANGE | + !dbName +| VERIFY '| + !oldPass + |'|
--       $P Command: $!command
         call !!admCommand(!command)
          handle (2,173)
--         !!alert.error(!!error.text)
--          -- Password validation failed.
           !confirmed = false
          endhandle
         !!ce     = !prevRef
         if (!confirmed.not()) then
           !!alert.error('The current Database password you entered is incorrect. Database password will not change')
           if (!!admDb.fromDialog.size() ne 0) then
               !!admDb.fromDialog.clear()
           endif
           !this.hide()
           return
         endif
         !!admDb.fromDialog[1] = |RESET|
      endif
   else
      !this.oldPasswd.val     = ||
      !!admDb.fromDialog[1] = |SET|
   endif
else
   !this.oldPasswd.val     = ||
   !!admDb.fromDialog[1] = |SET|
endif


if (!!admDb.lpassGet() eq true and !confirmed and  (!this.newPasswd.val eq ||) and (!this.confirmPasswd.val eq ||)) then
  !!alert.warning('No new Database password entered. Database password will be deleted if you press Apply button.')
  !!admDb.fromDialog[1] = |RESET|
  --!this.hide()
  --!this.oldPasswd.val = ||
  --return
endif

if (!this.newPasswd.val neq !this.confirmPasswd.val) then

  !!alert.warning('The Passwords you typed do not match. Type the new DB password in both text boxes')

else
 !!admDb.fromDialog[2] = !this.oldPasswd.val
 !!admDb.fromDialog[3] = !this.confirmPasswd.val

  hide !!changeDbPass
endif

  -- Clear out password text values
  !this.oldPasswd.val     = ||
  !this.newPasswd.val     = ||
  !this.confirmPasswd.val = ||

   --Ignore the form result to delete the password if not applied yet.
   -- Change pass gets precedence in this case
   if (!!admDb.fromDialog2.size() eq 3) then
      if (!!admDb.fromDialog2[3] eq 'DELPASS') then
         !!admDb.fromDialog2.clear()
      endif
   endif

endmethod


------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: action
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .cancel()
  if (!!admDb.fromDialog.size() ne 0) then
     !!admDb.fromDialog.clear()
 endif
endmethod


------------------------------------------------------------------------
--
--Method: .update()
--
-- Description: update the displayed DB in the password form.
-- The form must be displayed in MODIFY mode.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()
  if (!!changeDbPass.shown().not()) then
    return
  endif
  !this.init()
endmethod
-- End of method definition for .update()


-- End of form definition for !!changeDbPass
