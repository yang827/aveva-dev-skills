--
--
-- Description:
-- Form definition to allow foreign databases to be removed from
-- the project.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!excludeDb

-- Define form
setup form !!excludeDb at xr 0.35 yr 0.1 resize

  !!excludeDb.formTitle     = 'Exclude Foreign Databases'
  !!excludeDb.iconTitle     = 'EXCL DB'
  !!excludeDb.callback      = 'call !!excludeDbInit()'
  !!excludeDb.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition
  frame _dbFrame at x 0.1 y 0 anchor all |Foreign Databases in Project|

    list .foreignDb at xmin+1 ymin+1 anchor all multiple columns width 45 length 10

    option .sort at xmin ymax+0.2 anchor bottom+left |Sort By| call |call !!excludeDbInit()| width 12
    text .filter at xmax+0.5 ymin anchor bottom+right |Filter| call |call !!excludeDbInit()| width 15 string

  exit

  button .exclude at xmin.dbFrame ymax.dbFrame+0.5 anchor bottom+left |Exclude| call |call !!excludeDb()|
  button .dismiss at xmax form-size ymin anchor bottom+right |Dismiss| CANCEL

  -- Member Definitions
    -- Selected Db name
    member .db is STRING

exit
-- End of form definition for !!excludeDb

-- Assign sort gadget values
call !!admDbSortGadg(!!excludeDb.sort)

-- Assign filter gadget value
!!excludeDb.filter.val  = |*|
