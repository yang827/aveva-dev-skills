-- Created:         Fri Feb 14 09:00:21 GMT 1997
--
--
-- Description:
-- Form to allow the administrator to expunge selected user
-- processes from the current PDMS project.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!expungePid

-- Define form
setup form !!expungePid

  !!expungePid.formTitle     = |Expunge User Process|
  !!expungePid.iconTitle     = |EXPUNGE PID|
  !!expungePid.callback      = |call !!expungePidInit()|
  !!expungePid.formRevision  = | $Revision: 1.4 $ |

  -- Body of form definition
  frame .processFr at x 0.1 y 0 |Project Users|

    list .process at xmin+1 ymin+1 multiple width 50 height 10

    option .sort at xmin ymax |Sort By| call |call !!expungePidInit()| width 10
    !dispList = ARRAY()
    !dispList.append(|Date|)
    !dispList.append(|Real Name|)
    !dispList.append(|Username|)
    !dispList.append(|Host|)
    !dispList.append(|Module|)
    !dispList.append(|Version|)	
    _sort.dText = !dispList

    button .update at xmax+19 ymin |Update List| call |call !!expungePidInit()|

  exit

  button .expunge at xmin.process ymax+0.5 |Expunge| call |call !!expungePid()|
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL


exit
-- End of form definition for !!expungePid
