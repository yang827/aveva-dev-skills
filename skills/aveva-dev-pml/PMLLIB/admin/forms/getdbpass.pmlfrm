--  Author:          Undefined
--  Created:         Thu Dec 13 15:14:49 2012

--
--  Description:     -- Form to allow admin to get a DB password for validation.--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   action
--  getDbPass()                      -                   constructor
--  init()                           -                   constructor
--  okcall()                         -                   action
--  update()                         -                   action
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            getdbpass.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--   Keyword:     GEN
--   Module:        Admin
-- Description:
-- Form to allow admin to get a DB password for validation.
--
------------------------------------------------------------------------
--


setup form !!getDbPass at xr 0 yr 0

  -- Members
  member .reason is STRING
  member .mode is STRING
  member .dbRef  is DBREF

  -- Body of form definition
  path down

  text .currPasswd      |Current Database Password:    | width 15 noecho string

  button .ok at xmin ymax+0.5 |  OK  | APPLY

  button .cancel at xmax form-size ymin |Cancel| CANCEL

exit

------------------------------------------------------------------------
--
-- Method:      .getDbPass()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .getDbPass()

  --!this.dbRef    =     !!adminElem.dbGet()
  !this.formTitle     = |Get Database Password:|
  !this.iconTitle     = |GT DB PW|
  !this.callback      = |!this.init()|
  !this.formRevision  = | $Revision: 1.0 $ |

  -- callbacks
  !this.ok.callback            = |!this.okcall()|
  !this.cancel.callback        = |!this.cancel()|
endmethod

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .init()
!this.mode = !!admdb.modeGet()
!this.dbRef = !!admdb.refGet()
!!admdb.fromDialog2[1] = |NONE|
!this.formTitle      = |Get Database Password: | + !this.dbRef.name.substring(3)
!this.currPasswd.active = true
!this.currPasswd.val     = ||

endmethod

------------------------------------------------------------------------
--
-- Method:      .okcall()
--
-- Description: action
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .okcall()

-- Ensure something is entered for old password
!confirmed = false
if (!this.mode eq 'MODIFY') then
   if ( !!admdb.lpassGet() eq true) then
      if (!this.currPasswd.val eq ||) then
        !!alert.error('No current Database password entered.')
        if (!this.reason eq 'REMPROT') then
           if ( !this.dbRef.lprot eq true) then
                !!admdb.protected.val = TRUE
           else
                !!admdb.protected.val = FALSE
           endif
        endif
        if (!!admdb.fromDialog2.size() ne 0) then
           !!admdb.fromDialog2.clear()
        endif
        !this.hide()
        return
      else
--       Validate old pass:
         !confirmed = true
         !dbRef   = !this.dbRef
         !oldPass = !this.currPasswd.val
-- If we pass same passwords as old and new, then this command only validates it against database
         !prevRef = !!ce
         !!ce     = !dbRef
         !dbName  = !dbRef.name.substring(3)
         !command = |CHANGE | + !dbName +| VERIFY '| + !oldPass + |'|
--       $P Command: $!command
         call !!admCommand(!command)
          handle (2,173)
--         !!alert.error(!!error.text)
--          -- Password validation failed.
           !confirmed = false
          endhandle
         !!ce     = !prevRef
         if (!confirmed.not()) then
           !!alert.error('The current Database password you entered is incorrect.')
             if (!this.reason eq 'REMPROT') then
                if ( !this.dbRef.lprot eq true) then
                   !!admdb.protected.val = TRUE
                else
                   !!admdb.protected.val = FALSE
                endif
             endif
           if (!!admdb.fromDialog2.size() ne 0) then
              !!admdb.fromDialog2.clear()
           endif
           !this.hide()
           return
         endif
         !!admdb.fromDialog2[1] = |VALID|

      endif
   else
      !this.currPasswd.val     = ||
      !!admdb.fromDialog2[1] = |INVALID|
   endif
else
   !this.currPasswd.val     = ||
   !!admdb.fromDialog2[1]  = |INVALID|
endif
  !!admdb.fromDialog2[2] = !this.currPasswd.val

  !!admdb.fromDialog2[3] = !this.reason

  -- Clear out password text values
  !this.currPasswd.val     = ||

  !this.hide()

  if (!this.reason eq 'REMPROT') then
     !!admdb.protectedsetting()
  endif
  --Ignore the form result to change the password if not applied yet.
  -- deletion gets precedence in this case
  if (!this.reason eq 'DELPASS') then
     if (!!admdb.fromDialog.size() ne 0) then
        !!admdb.fromDialog.clear()
     endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: action
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .cancel()
--!!alert.warning('Database password not provided')
if (!this.mode eq 'MODIFY') then
   if (!this.reason eq 'REMPROT') then
      if ( !this.dbRef.lprot eq true) then
        !!admdb.protected.val = TRUE
      else
        !!admdb.protected.val = FALSE
      endif
     !!admdb.protectedsetting()
   endif
 endif
 if (!!admdb.fromDialog2.size() ne 0) then
     !!admdb.fromDialog2.clear()
 endif

endmethod


------------------------------------------------------------------------
--
--Method: .update()
--
-- Description: update the displayed DB in the get password form.
-- The form must be displayed in MODIFY mode.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()
  if (!!getDbPass.shown().not()) then
    return
  endif
  !this.init()
endmethod
-- End of method definition for .update()



-- End of form definition for !!getDbPass
