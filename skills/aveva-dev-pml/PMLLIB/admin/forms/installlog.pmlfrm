-- Description:
-- Form to show log of Cadc data installation
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!installLog

-- Define form
setup form !!installLog

  !!installLog.formTitle     = |Install Log|
  !!installLog.iconTitle     = |INST LOG|
  !!installLog.callback      = ||
  !!installLog.formRevision  = | $Revision: 1.4 $ |

  -- Body of form definition

  list .logData at x0 y0 width 60 height 10
  button .dismiss at xmax form-size ymax |Dismiss| CANCEL

exit
-- End of form definition for !!installLog
