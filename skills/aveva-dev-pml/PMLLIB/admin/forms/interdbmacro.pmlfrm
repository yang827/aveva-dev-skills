--
--
-- Description:
-- Form to list and allow deletion of project inter-db macros
-- by the project administrator.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!interDbMacro

-- Define form
setup form !!interDbMacro at xr 0.35 yr 0.1

  !!interDbMacro.formTitle     = 'Inter-Database Macros'
  !!interDbMacro.iconTitle     = 'IDBMAC'
  !!interDbMacro.callback      = 'call !!interDbMacroInit()'
  !!interDbMacro.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  para .macroTx at x 0 y 0 text |Project Inter-Db Macros|
  list .macro at xmin ymax+0.2 columns width 80 length 10

  para .countTx at x 0 ymax text |No. of Macros = |
  para .count at xmax ymin width 5 line 1

  button .delete at xmin.macro ymax+0.2 |Delete| call |call !!interDbMacroDel()|
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL


exit
-- End of form definition for !!interDbMacro
