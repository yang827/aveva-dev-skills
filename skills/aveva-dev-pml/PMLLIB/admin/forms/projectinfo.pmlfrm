--
--
-- Description:
-- Form to allow the administrator to set the project information.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkNumber()                    -                   action
--  init()                           -                   constructor
--  okcall()                         -                   action
--  projectInfo()                    -                   constructor
--

-- Define form
setup form !!projectInfo

  member .marine is BOOLEAN
  -- Body of form definition
  paragraph .idTx at x0 y0.2 text |Project|
  paragraph .id at xmax+1 ymin width 10 line 1
  paragraph .codeTx at xmax+1 ymin text |Project Code  :|
  paragraph .code at xmax+1 ymin width 10 line 1

  text .maxUser at xmin.idTx+10 ymax+0.2 |Maximum Number of Users | width 10 integer
  path down
  frame .setFr at xmin.idTx ymax |Project Attributes|
    text .projNumb |Number      | width 32 is STRING
    text .projName |Name        | width 32 scroll 120 is STRING
    text .projDesc |Description | width 32 scroll 120 is STRING
    text .projMess |Message     | width 32 scroll 120 is STRING
  exit

  button .ok at xmin.setFr ymax.setFr+0.5 |  OK  |  OK
  button .cancel at xmax form-size ymin |Cancel| CANCEL

 exit

------------------------------------------------------------------------
--
-- Method:      !projectInfo()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .projectInfo()

  -- Get global status
  !globalProject  = !!glbIsGlobal()
  if (!globalProject) then
     !projectHub  = !!glbHubStatus(!globalProject)
  else
     !projectHub  = false
  endif

  -- Callbacks
  !this.formTitle     = |Project Information|
  !this.iconTitle     = |PROJ INFO|
  !this.callback      = |!this.init()|
  !this.formRevision  = | $Revision: 1.8 $ |
  !this.ok.callback   = |!this.okcall()|
  !this.projNumb.callback = |!this.checkNumber()|

  -- Activate gadgets
  if (!globalProject) then
    !this.projNumb.active = !projectHub
    !this.projName.active = !projectHub
    !this.projDesc.active = !projectHub
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .init()

!project   = CURRENT PROJECT

  !this.projName.val = !project.name()
  !this.projNumb.val = !project.number()
  !this.projDesc.val = !project.description()
  !this.projMess.val = !project.message()

  -- Set project code
  !this.code.val    = !project.code()
  !this.id.val      = !project.id()

--  if (!this.code.val eq !this.id.val) then
--    !this.marine = FALSE
--  else
  !marEvar=!this.code.val & 'MAR'
  var !evar EVAR $!marEvar
    if (!evar neq '') then
      !this.marine = TRUE
    else
      !this.marine = FALSE
    endif
--   endif
  var !maxUsers MAXUSERS
  !this.maxUser.val = !maxUsers
    -- Check the number and id are the same
    if (!this.marine and !this.id.val neq !this.projNumb.val) then
       !answer = !!alert.confirm('This is a MARINE Project and the Project and Project Number must be the same. Do you want to change it?')
       if( !answer.eq('YES') ) then
         PROJECT NUMBER '$!this.id.val'
         handle any
           -- report error
           !!alert.error(!!error.text)
         endhandle
       endif
       !this.projNumb.val = !project.number()
       !this.projNumb.active=false
    elseif(!this.marine and !this.id.val eq !this.projNumb.val) then
      !this.projNumb.active=false
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      !checkNumber()
--
-- Description: action
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .checkNumber()

    if (!this.marine and !this.id.val neq !this.projNumb.val) then
       !!alert.error('This is a MARINE Project and the Project and Project Number must be the same.')
       !this.projNumb.val=!this.id.val
       !this.projNumb.active=false
    endif

endmethod
------------------------------------------------------------------------
--
-- Method:      !okcall()
--
-- Description: action
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .okcall()

  -- Set project info
  !project   = CURRENT PROJECT

  if (!this.projName.active) then
    PROJECT NAME '$!this.projName.val'
  endif
  if (!this.projNumb.active) then
    PROJECT NUMBER '$!this.projNumb.val'
  endif
  if (!this.projDesc.active) then
    PROJECT DESCRIPTION '$!this.projDesc.val'
  endif
  PROJECT MESSAGE '$!this.projMess.val'

  MAXUSERS $!this.maxUser.val

endmethod
