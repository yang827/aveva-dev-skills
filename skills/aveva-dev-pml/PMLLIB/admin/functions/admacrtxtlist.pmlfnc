--
-- Description:
-- A function to generate a text lists for a gadget
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of DBREF of database elements
--    2   RW     GADGET      List gadget to populate
--    3   R      BOOLEAN     User ACR line header "<ACR>" or <ACRGRP>
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!admAcrTxtList(!dbRefArray is ARRAY, !list is GADGET,!listFormat is ACRLISTATTR,!useHeader is BOOLEAN)

  !acrList = object ADMTEXTLIST()
  !acrList.addAcrs(!dbRefArray, !listFormat, !useHeader, !list)

endfunction
-- End of function definition for !!admAcrTxtList
