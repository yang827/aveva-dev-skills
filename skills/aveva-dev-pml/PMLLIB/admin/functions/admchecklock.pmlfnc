--
--
-- Description:
-- Function to check the project lock before a FINISH or module switch.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admCheckLock()

  -- Initialise variables
  VAR !projLock LOCK

  -- Check the project lock before exit
  if (!projLock eq 'Locked') then

    -- Get user to confirm exit in locked state
    !answer = !!alert.confirm(!!messageFile.messageString(141,17))
    if (!answer.boolean()) then
      UNLOCK
    endif

  endif

endfunction
-- End of function definition for !!admCheckLock
