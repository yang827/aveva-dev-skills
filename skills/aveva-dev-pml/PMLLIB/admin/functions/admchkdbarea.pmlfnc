--
-- Author:          E.conba
-- Created:         Fri May 9 15:20:46 BST 1997
--
--
-- Description:
-- Function to set and check a database area.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Value to be used ( 0-999 or SYS )
--    2   RW     GADGET      Value to which value is written
--    3   R      DBREF       Source element for operation (May be unset)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admChkDbArea(!value is STRING, !gadget is GADGET, !currentRef is DBREF)

  -- Initialise variables
  !project      = CURRENT PROJECT
  !file         = object FILE()

  -- Check to see if values is to be system generated
  if (!value eq 'SYS') then

    -- Reset to default area
    !gadget.val   = |Set by System|
    !!alert.message('The default System area number is area 0 (As in ' & !project.code() & '000)')
    return

  endif

  -- Check that the passed value can be numeric
  !areaNumber   = !value.real()
  handle (2,441)

    -- Cannot convert string to integer
    if (!!database.dbRef.unset() or !!database.dbRef.area eq 0) then
      !gadget.val   = |set by System|
    else
      !gadget.val   = !!database.dbRef.area.string()
    endif

    -- Raise error
    !!alert.error(!!messageFile.messageString(141, 10, Messagefile.messageString(141, 801)))
    return error 1 noalert

  endhandle

  -- Catch unset value which is caught in above handle
  if (!areaNumber.unset()) then
    !gadget.val   = |Set by System|
    !!messageFile.error(61, 573)
    return
  endif

  -- Check for a '0' value
  if (!areaNumber eq 0) then
    !gadget.val   = |Set by System|
    return
  endif

  -- Check that an EVAR exists for this area
  !areaMask     = '000' + !areaNumber.string()
  !evarValue    = |%| + !project.code() + !areaMask.substring(-3,3) + |%|

  !fileOk = true
  !file.file(!evarValue)
  !fileOk = !file.exists()
  handle any
    !fileOk = false
  endhandle
  if (!fileOk and !file.type() eq 'DIRECTORY') then

    -- Value of EVAR is valid
    !gadget.val = !areaNumber.string()

  else

    -- Invalid area number
    if (!currentRef.unset() or !currentRef.area eq 0) then
      !gadget.val = |Set by System|
    else
      !gadget.val = !currentRef.area.string()
    endif

    -- Raise error
    !!alert.error(!!messageFile.messageString(141, 157, !areaNumber.string()))
    return error 1 noalert

  endif

endfunction
-- End of function definition for !!admChkDbArea
