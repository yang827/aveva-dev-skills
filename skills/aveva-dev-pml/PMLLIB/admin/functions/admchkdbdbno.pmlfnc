-- Created:         Fri May 9 15:46:47 BST 1997
--
--
-- Description:
-- Function to check and set the database number to be used on
-- creation of a database.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Value to assign
--    2   RW     GADGET      Gadget to write value back to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admChkDbDbno(!value is STRING, !gadget is GADGET)

  -- get team world element
  !teamWorld = !!dbrAdminGetWorld('TEAM')

  -- Check to see if value is to be system generated
  if (!value eq 'SYS') then

    -- Reset to default area
    !systemNumber = !teamWorld.nxtdbn.string()
    !!alert.message('The next System generated DB number will be ' & !systemNumber)
    !gadget.val   = !systemNumber
    return

  endif

  -- Check to see if value is to be generated from unique db ranges
  if (!value eq 'UNI') then
    !systemNumber = !teamWorld.nxtdbu.string()
    --check that number is positive, if not then there is probably no range set
    if( !systemNumber.real() lt 1 ) then
       !!messageFile.error(1, 784)
    else
       !!alert.message('The next Unique DB number will be ' & !systemNumber)
       !gadget.val = !systemNumber
    endif
    return

  endif

  -- Check that the passed value can be numeric
  !dbNumber       = !value.real()
  handle (2,441)

    -- Unable to convert value
    !gadget.val    = 'Set by System'
    !!messageFile.error(141, 10, !!messageFile.messageString(141, 802))

  endhandle

  -- Catch unset value which is caught in above handle
  if (!dbNumber.unset()) then
    !gadget.val   = |Set by System|
    !!messageFile.error(61, 573)
    return
  endif

  -- Check for db number being between 7000 and 8000 or 250000 and 255000 which are
  -- numbers reserved for AVEVA use

  if (!dbNumber gt 7000 and !dbNumber lt 8000 or !dbNumber gt 250000 and !dbNumber lt 255000) then
     !answer = !!alert.confirm (!!messageFile.messageString(141, 186))
     if (!answer ne |YES|) then
        !gadget.val    = 'Set by System'
        return
     endif
  endif

  -- Collect databases with the same number
  -- expression was not validating a number (AK)
  !expression     = 'dbno eq ' + !dbNumber.string()
  !databases      = !!collectAllFor('DB',!expression,!teamWorld)

  -- Check no other database exist with this number
  if (!databases.unset()) then

    -- Value is unique
    !gadget.val    = !dbNumber.string()

  else

    -- Not unique number
    !gadget.val    = 'Set by System'
    !!messageFile.error(141, 158, !dbNumber.string())
  endif

endfunction
-- End of function definition for !!admChkDbDbno
