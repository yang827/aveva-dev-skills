-- File:            admchkmdbname.pmlfnc
--   Type:          Function Definition
--   Group:         Naming
--     Keyword:     NAME
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Tue Jul 22 09:37:58 BST 1997
--
--
-- Description:
-- Function to check whether a specified mdb name conforms to
-- Admin Requirements and that is does not already exist.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Gadget containing name value.
--    2   R      DBREF       Dbref of target element (can be unset)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admChkMdbName(!gadget is GADGET, !currentRef is DBREF)

  -- Initialise variables
  !name        = !gadget.val

  -- Add a '/' if required
  if (!name.substring(1,1) neq '/') then
    !name        = '/' + !name
  endif

  -- Check to see if the element name has already been used
  !dbRef       = !name.dbRef()
  handle (2,109)

    -- Element name not used (good)
    !gadget.val  = !name.substring(2)

  elsehandle none

    -- If the named element is a USER then this
    -- must be permissible for backward compatibility
    if (!dbRef.type eq 'USER') then
      !gadget.val  = !name.substring(2)
    else
      -- Element name already used (not good)

      -- Reset value based on the DBREF
      if (!currentRef.set()) then
        !gadget.val  = !currentRef.name.substring(2)
      else
        !gadget.val  = |unset|
        !gadget.setFocus()
      endif

      -- Raise error
      !!messageFile.error(141, 12, !name.substring(2), !dbRef.type)

    endif

  endhandle

endfunction
-- End of function definition for !!admChkMdbName
