-- File:            admchkstampname.pmlfnc
--   Type:          Function Definition
--   Group:         Naming
--     Keyword:     NAME
--   Module:        admin
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         Sun Aug 05 12:57:23 BST 2001
--
--
-- Description:
-- Function to check whether a specified stamp name conforms to
-- Admin Requirements and that is does not already exist.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Gadget containing name value.
--    2   R      DBREF       Dbref of target element (can be unset)
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is name OK and not already used. False otherwise
--
------------------------------------------------------------------------

-- Define function
define function !!admChkStampName(!gadget is GADGET, !currentRef is DBREF) is BOOLEAN

  -- Initialise variables
  !name = !gadget.val

  -- Check for no name
  if (!name.eq('')) then
    -- Null/Blank names are not permissible
    -- !!messageFile.warning(143, 8)
    !!alert.warning('Null/Blank names are not permissible')
    !gadget.val  = |unset|
    return false
  endif

  -- Add a slash if required
  if (!name.substring(1,1) neq '/') then
    !name = '/' & !name
  endif

  -- Check to see if the element name has already been used
  !dbRef = !name.dbRef()
  handle (2,109)

    -- Element name not used (good)
    !gadget.val  = !name.substring(2)
    return true

  elsehandle none

    -- Element name already used (not good)
    -- Reset value based on the DBREF
    if (!currentRef.set()) then
      !gadget.val  = !currentRef.name.substring(2)
    else
      !gadget.val  = |unset|
    endif

    -- Raise error
    -- !!messageFile.error(141, 12, !name.substring(2), !dbRef.type)
    !!alert.error('The name ' & !name.substring(2) & ' already exists in project. (Type ' & !dbRef.type & ')')
    return false

  endhandle

endfunction
-- End of function definition for !!admChkStampName
