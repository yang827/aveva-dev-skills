-- File:            admchkteamname.pmlfnc
--   Type:          Function Definition
--   Group:         Naming
--     Keyword:     NAME
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Mon Jul 21 14:36:36 BST 1997
--
--
-- Description:
-- Function to check whether a specified team name, conforms to
-- Admin requirements and that it does not already exist.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Gadget containing name value.
--    2   R      DBREF       Dbref of target element (can be unset)
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is name OK and not already used. False otherwise
------------------------------------------------------------------------

-- Define function
define function !!admChkTeamName(!gadget is GADGET, !currentRef is DBREF) is BOOLEAN

  -- Initialise variables
  !name        = !gadget.val

  -- Remove any user '/'
  if (!name.substring(1,2) eq '/*') then
    !name        = !name.substring(3)
  elseif (!name.substring(1,1) eq '/') then
    !name        = !name.substring(2)
  endif

  -- Check that the input string is a WORD
  !check       = !!admChkWord(!name)
  if (!check.not()) then

    -- Name is not a valid word
    if (!currentRef.set()) then
      !gadget.val  = !currentRef.name.substring(3)
    else
      !gadget.val  = |unset|
    endif
    !!messageFile.error(141, 21, !!messageFile.messageString(141, 803), !name)
    return false

  endif

  -- Force the name to uppercase
  !name        = !name.upcase()

  -- Quick check to make sure TRANSACTION is not used
  if (!name eq 'TRANSACTION') then
    !project = current project
    if (!project.isGlobal().not()) then
      !gadget.val  = |unset|
      !!alert.error('Invalid team name. TRANSACTION is a reserved team name, used in Global Projects')
      return false
    endif
  endif

  -- Add a '/*' to the front of the name
  !name        = '/*' + !name

  -- Check to see if the element name has already been used
  !dbRef       = !name.dbRef()
  handle (2,109)
    -- Element name not used (good)
    !gadget.val  = !name.substring(3)
    return true
  elsehandle none
    -- Element name already used (not good)

    -- Reset value based on the DBREF
    if (!currentRef.set()) then
      !gadget.val  = !currentRef.name.substring(3)
    else
      !gadget.val  = |unset|
    endif

    -- Raise error
    !!alert.error(!!messageFile.messageString(141, 12, !name.substring(3), !dbRef.type))

    return false

  endhandle

endfunction
-- End of function definition for !!admChkTeamName
