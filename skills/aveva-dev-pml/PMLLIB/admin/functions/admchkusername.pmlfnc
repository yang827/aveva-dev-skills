-- File:            admchkusername.pmlfnc
--   Type:          Function Definition
--   Group:         Naming
--     Keyword:     NAME
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Mon Jul 21 14:36:36 BST 1997
--
--
-- Description:
-- Function to check whether a specified user name, conforms to
-- Admin requirements and that it does not already exist.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Gadget containing name value.
--    2   R      DBREF       Dbref of target element (can be unset)
-- Return:
--   [Data Type] [Description]
--    BOOLEAN    True if name valid and does not already exist. False otherwise
--
------------------------------------------------------------------------

-- Define function
define function !!admChkUserName(!gadget is GADGET, !currentRef is DBREF) is BOOLEAN

  -- Initialise variables
  !name        = !gadget.val

  -- Check that the input string does not contain numbers [0-9]
  !check       = !!admChkUsernameString(!name)
  if (!check.not()) then

    -- Name is not a valid word
    if (!currentRef.set()) then
      !gadget.val  = !currentRef.name.substring(2)
    else
      !gadget.val  = |unset|
    endif
    !!alert.error( !!messageFile.messageString(141, 33, !name) )
    return false

  endif

  -- Add a '/' if required
  if (!name.substring(1,1) neq '/') then
    !name        = '/' + !name
  endif

  -- Check to see if the element name has already been used
  !dbRef       = !name.dbRef()
  handle (2,109)
    -- Element name not used (good)
    !gadget.val  = !name.substring(2)
    return true
  elsehandle none

    -- If the named element is an MDB then this
    -- must be permissible for backward compatibility
    if (!dbRef.type eq 'MDB') then
      !gadget.val  = !name.substring(2)
      return true
    else
      -- Element name already used (not good)

      -- Reset value based on the DBREF
      if (!currentRef.set()) then
        !gadget.val  = !currentRef.name.substring(2)
      else
        !gadget.val  = |unset|
      endif

      -- Raise error
      !!alert.error( !!messageFile.messageString(141, 12, !name.substring(2), !dbRef.type) )
      return false

    endif

  endhandle

endfunction
-- End of function definition for !!admChkUserName
