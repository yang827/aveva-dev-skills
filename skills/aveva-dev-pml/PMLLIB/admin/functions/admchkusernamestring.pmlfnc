--
--
-- Description:
-- Function to check if a passed string is a valid User Name for use in
-- syntax graphs. Used to check USER names.
-- WORDs will be a string,but special characters like '|','@','$','/' and '*' should be avoided.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      String to check
-- Return:
--   [Data Type] [Description]
---   BOOLEAN     True if STRING is a WORD
--
------------------------------------------------------------------------

-- Define function
define function !!admChkUsernameString(!value is STRING) is BOOLEAN

  if(!value.occurs('$@').gt(0))then
  	return false
  elseif(!value.occurs('$$').gt(0))then
  	return false
  elseif(!value.occurs(|'|).gt(0))then
    return false
  elseif(!value.occurs('|').gt(0))then
  	return false
  elseif(!value.substring(1,1).eq('/'))then
  	return false
  elseif(!value.substring(1,1).eq('*'))then
  	return false
  elseif(!value.substring(!value.length()).eq('*'))then
  	return false
  else
    return true
  endif

endfunction
-- End of function definition for !!admChkUsernameString
