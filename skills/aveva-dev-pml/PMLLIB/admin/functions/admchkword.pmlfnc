--
-- Description:
-- Function to check if a passed string is a valid WORD for use in
-- syntax graphs. Used to check TEAM, USER and MODULE names.
-- WORDs must only be letters (in uppercase)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      String to check
-- Return:
--   [Data Type] [Description]
---   BOOLEAN     True if STRING is a WORD
--
------------------------------------------------------------------------

-- Define function
define function !!admChkWord(!value is STRING) is BOOLEAN

  return !value.isLetters()

endfunction
-- End of function definition for !!admChkWord
