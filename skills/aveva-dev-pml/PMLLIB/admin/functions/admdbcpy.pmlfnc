-- Created:         Tue Jul 22 17:14:45 BST 1997
--
--
-- Description:
-- Function to copy a source database to a new database.
-- The new database will inherit all attributes (and contents)
-- from the source database.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admDbCpy()

  -- Initialise variables
  !sourceDatabase    = !!admDbCpyRefGet()
  !sourceArea        = !sourceDatabase.area
  !targetTeam        = !!admDbCpyTeamGet()
  !targetTeamName    = !targetTeam.name.substring(3)
  !targetName        = !!admDbCpy.name.val
  !fullName          = |/*|+ !targetTeamName +|/|+ !targetName
  !description       = !!admDbCpy.desc.val
  if (!!admDbCpy.area.val eq 'System') then
    !targetArea        = 0
  else
    !targetArea        = !!admDbCpy.area.val.real()
  endif

  -- Check for unset target name
  if (!targetName eq 'unset') then
     !!messageFile.error(141, 164)
  endif

  -- Create copy command
  if (!targetArea eq !sourceArea) then
    !command           = |COPY DB |+ !sourceDatabase.name.substring(3) + $
                         | TO |+ !targetTeamName +|/|+ !targetName
  else
    !command           = |COPY DB |+ !sourceDatabase.name.substring(3) + $
                         | TO |+ !targetTeamName +|/|+ !targetName +$
                         | TO AREA |+ !targetArea.string()
  endif

  -- Execute copy command
  $!command
  handle (1,4)

    -- Database already exists
    !!messageFile.error(141, 153, !fullName)

  elsehandle (1,7)

    -- Source database not found
    !!adminElem.update('DB')
    !!messageFile.error(141, 160, !sourceDatabase)

  elsehandle (1,15)

    -- Maximum number of databases reached
    !!messageFile.error(141, 154)

  elsehandle (1,18)

    -- Cannot open database file (Source)
   !!messageFile.error(141, 166, !sourceDatabase)

  elsehandle (1,20)

    -- Cannot open target database (Disk full?)
    !!messageFile.error(141, 167)

  elsehandle any

    -- Non specific
   !!messageFile.error(141, 168, !!error.text)

  endhandle

  -- Get the new DBREF
  !!ce        = !fullName.dbRef()
  !!adminElem.dbSet(!!ce)

  -- Copy command was a success so modify the description
  if (!description.empty() or !description eq 'unset') then
    !command   = |CDESC DB |+ !targetTeamName +|/|+ !targetName +| ''|
    $!command
  else
    !command   = |CDESC DB |+ !targetTeamName +|/|+ !targetName +| '|+ !description +|'|
    $!command
  endif

  -- Update forms
  !!adminElem.update('DB')
  call !!admDbUpdate()

endfunction
-- End of function definition for !!admDbCpy
