-- File:            admdbdatesess.pmlfnc
--   Type:          Function Definition
--   Group:         General
--     Keyword:     STAMP
--   Module:        admin
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         Fri Aug 24 16:18:40 BST 2001
--
--
-- Description:
-- Return the last session of a db before a specific date
-- Use the stamp session if the stamp list already holds this information
-- Use the form session when no date is available
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB reference either string or dbref
-- Return:
--   [Data Type] [Description]
--    REAL       Session number
--
------------------------------------------------------------------------
-- Define function
define function !!admDbDateSess(!dbRef is DBREF) is REAL

  -- Initialise variables
  !session = STRING()
  !dateString = !!admStamp.formMethods.dateString
  !existDbRefs = !!admStamp.formMethods.existDbRefs
  !stlstRefs = !!admStamp.formMethods.stlstRefs
  !sessionGadget = !!admStamp.session

  -- Attempt to find the passed db in the existing list
  !position = !existDbRefs.findFirst(!dbRef)

  -- Get session number
  if (!position.set() and !!admStamp.sess.val.not()) then

    -- Testing
--write 'From stlst'

    -- Use the stamp list session
    !session = !stlstRefs[!position].stSess.string()

  elseif (!dateString.unset() or !!admStamp.sess.val) then

    -- Testing
--write 'From gadget value'

    -- Read the form session gadget
    !session = !sessionGadget.val.string()

  else

    -- Testing
--write 'Calculated by date'

    -- Get session by date
    !dbObj = object DB(!dbRef)
    VAR !session SESSION ON $!dateString $!<dbObj.name>
    handle ANY
      !!alert.error(!!error.text)
    endhandle

  endif

  return !session.real()

endfunction
-- End of function definition for !!admDbDateSess(DBREF)
