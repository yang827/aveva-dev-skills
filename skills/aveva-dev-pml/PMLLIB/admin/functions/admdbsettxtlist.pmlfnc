--
-- Description:
-- Function to construct list texts for DBSET elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Array of DBREFs of dbset elements
--    2   RW     GADGET       List gadget to populate
--    3   R      DBSETLISTATTR dbset list format object
--    4   R      BOOLEAN      Use line header '<dbSET>'
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admDbSetTxtList(!dbRefArray is ARRAY, !list is GADGET,!listFormat is DBSETLISTATTR,!useHeader is BOOLEAN)

  !dbSetList = object ADMTEXTLIST()
  !dbSetList.addDbSets(!dbRefArray, !listFormat, !useHeader, !list)

endfunction
-- End of function definition for !!admDbSetTxtList
