--
--
-- Description:
-- Function to set the contents of a sort gadget associated with
-- database elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      List gadget to assign to.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function


define function !!admDbSortGadg(!gadget is GADGET)

  -- Ensure that gadget is an LIST gadget
  if (!gadget.type() neq 'LIST') then
    return
  endif

  -- Initialise variables
  !dText        = ARRAY()
  !rText        = ARRAY()

  -- Assign values to the gadget
  -- Dtexts
  !dText.append('Name')
  !dText.append('Team')
  !dText.append('Type')
  !dText.append('Number')
  if (!!admcontrol.isglobal()) then
    !dText.append('Location')
  endif
  !dText.append('Access')
  !dText.append('Description')
  !gadget.dText  = !dText

  -- Rtexts
  !rText.append('name')
  !rText.append('owner.owner.name.substring(3)')
  !rText.append('typedb')
  !rText.append('dbno.string()')
  if (!!admcontrol.isglobal()) then
    !rText.append('prmloc.string()')
  endif
  !rText.append('accessdb')
  !rText.append('description')
  !gadget.rText  = !rText

endfunction
-- End of function definition for !!admDbSortGadg
