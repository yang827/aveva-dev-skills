--
-- File:            admduplicate.pmlfnc
--   Type:          Function Definition
--   Group:         Highlight Changes
--     Keyword:     CHANGE
--   Module:        admin
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         Sun Aug 05 12:57:23 BST 2001
--
--
-- Description:
-- Form to display a list of dbs that possess a duplicate dbno for selection
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       DB references
--    2   R      ARRAY       DB numbers
--    4   R      STRING      Call type LIST to list the removed dbs
--                                     CHOOSE to offer the user a choice for selection
-- Return:
--   [Data Type] [Description]
--    REAL       Session number
--
------------------------------------------------------------------------
define function !!admDuplicate(!dbRefs is ARRAY, !dbNos is ARRAY, !callType is STRING)

  -- Define form
  setup form !!admDuplicate

    !this.formTitle = |Duplicate Databases|
    !this.callback = |!this.formMethods.init('$!callType')|

    -- Paragraph
    para .para at x1 y0.2 width 62 lines 1

    -- Display list
    frame .displayFr | Databases & Extracts | at xmin ymax

      list .display at xmin+1 ymin+1 SINGLE columns width 62 height 10
      option .sort at xmin ymax+0.2 |Sort by | call |!this.formMethods.sort()| width 12
      text .filter at xmax+1 ymin |Filter | call |!this.formMethods.sort()| width 15 STRING

    exit

    -- Action
    if (!callType.eq('CHOOSE')) then
      button .apply |Apply| at xmin ymax+0.5 call |!this.formMethods.apply('STAMP')|
      button .skip |Skip| at xmax+5 ymin call |!this.formMethods.apply('SKIP')|
      button .dismiss |Dismiss| at xmax form-size ymin call |!this.formMethods.dbRefs.clear()| CANCEL
    else
      button .dismiss |Dismiss| at xmax form-size ymax+0.5 call |!this.formMethods.dbRefs.clear()| CANCEL
    endif

    -- Members
    member .formMethods is ADMDUPLICATE

    -- Set form in object
    !this.formMethods.form = !this

    -- Store dbrefs
    !this.formMethods.dbRefs = !dbRefs
    !this.formMethods.dbNos = !dbNos

  exit
  -- End of form definition for !!admDuplicate

endfunction
-- End of function definition for !!admDuplicate
