--
--
-- Description:
-- Function to control the appearance of USERNAME etc as a name string
-- or as a description string for the list forms in the admin module.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Value of display mode to use (NAME/DESC)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admElemText(!mode is STRING)

  -- Initialise variables
  !globalProj  = !!glbIsGlobal()

  -- See if the display mode is different to the one held
  if (!!sessionSettings.showAs neq !mode) then

    !!sessionSettings.showAs = !mode

    -- Update Admin forms
    if (!globalProj) then
      if (Defined (!!glbListAlloc)) then
        call !!refreshDependent(!!glbListAlloc)
      endif
      if (Defined (!!glbListLocn)) then
        call !!refreshDependent(!!glbListLocn)
      endif
    endif

    -- Update common library forms
    if (Defined (!!userList)) then
      call !!refreshDependent(!!userList)
    endif
    if (Defined (!!teamList)) then
      call !!refreshDependent(!!teamList)
    endif
    if (Defined (!!dbList)) then
      call !!refreshDependent(!!dbList)
    endif
    if (Defined (!!mdbList)) then
      call !!refreshDependent(!!mdbList)
    endif
    if (Defined (!!userStatus)) then
      call !!refreshDependent(!!userStatus)
    endif

  endif

endfunction
-- End of function definition for !!admElemText
