--
--
-- Description:
-- Callback function to expunge the selected databases for the Expunge
-- Database Claimlist form.
-- Function to be replaced by method !!admExClaim.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admExClaim()

  -- Initialise variables
  !selection   = !!admExClaim.db.selection('rtext')

  -- Return if no selection
  if (!selection.size() eq 0) then
    return
  endif

  -- Do loop while processing
  do !value values !selection

    -- Convert selection
    !dbRef       = !value.dbRef()
    handle any
      skip
    endhandle

    -- Build the command
    !command     = |EXPUNGE DB |+ !dbRef.name.substring(3)
    !!messageFile.prompt(141, 184, !dbRef.name.substring(3))

    -- Expunge the databases
    call !!admCommand(|$!command|)
    handle any
      !!messageFile.error(141, 185, !dbRef.name.substring(3), !!error.text.after(')').trim('L'))
      handle (06, 185)
        -- dummy handle
      endhandle
    endhandle

  enddo

    -- Dismiss the prompt
    call !!prompt(0)

endfunction
-- End of function definition for !!admExClaim
