--
--
-- Description:
-- Function to control the contents of the Database list gadget on the
-- Expunge Database Claimlist form.
-- Function to be replaced by method !!admExClaim.dbList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admExClaimDbList()

  -- Initialise variables
  !dbArray    = !!admExClaimDbGet()

  -- Show prompt
  !!messageFile.prompt(141, 4, !!admExClaim.formTitle, $
            !!messageFile.messageString(141, 811))

  -- Preserve sort and filter values
  if (!!admExClaim.filter.val.empty()) then
    !!admExClaim.filter.val = |*|
  endif
  !!admExClaim.sortVal   = !!admExClaim.sort.selection('rtext')
  !!admExClaim.filterVal = !!admExClaim.filter.val

  -- Clear the list gadget
  !!admExClaim.db.clear()

  -- Sort the databases
  !dispRefs   = !!adminFilterSort(!dbArray,!!admExClaim.sort,!!admExClaim.filter)

  -- Display the list of databases
  call !!adminDbTxtList(!dispRefs,!!admExClaim.db,!!admDisplayConfig.fmtDbGet(),!!admDisplayConfig.eleTypeGet(), object DBREF())

  -- Dismiss the prompt
  call !!prompt(0)

endfunction
-- End of function definition for !!admExClaimDbList
