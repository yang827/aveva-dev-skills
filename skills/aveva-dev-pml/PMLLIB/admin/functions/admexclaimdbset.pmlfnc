--
--
-- Description:
-- Function to collect and store multiwrite databases elements against
-- the Expunge Claimlist form.
-- Function to be replaced by method !!admExClaim.dbSet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admExClaimDbSet()

  -- Initialise variables
  !dbArray        = ARRAY()
  !databases      = ARRAY()
  !globalProject  = !!glbIsGlobal()

  -- Collect multiwrite and controlled databases
  !!ce        = !!dbrAdminGetWorld('TEAM')
  !clause     = '(ACCESSDB eq |Multiwrite| or ACCESSDB eq |Controlled|) and (FOREIGN neq |FOREIGN|)'
  !databases  = !!collectAllFor('DB', !clause, !!ce)

  -- return with current list if not a global project
  if ( !globalProject.not() ) then
    !!admExClaim.dbArray  = !databases
    return
  endif

 -- find DB's primary at this location in a global project
  do !database values !databases
    !locRf = !database.mem[1].locRf
    -- Skip if not Primary at this Location [note that this is not a network query]
    skip if(!locRf.unset())
    skip if(!locRf NEQ CURLOC)
    -- Skip if not propagating DB (This skip is removed. We believe it is not required)
    -- skip if(!database.mem[1].propg EQ FALSE)
    !dbArray.append(!database)
  enddo

  -- Store the array of databases
  !!admExClaim.dbArray  = !dbArray

endfunction
-- End of function definition for !!admExClaimDbSet
