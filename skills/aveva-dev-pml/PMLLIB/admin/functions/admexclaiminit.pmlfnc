--
-- Description:
-- Function to initialise the Expunge Database Claimlist form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admExClaimInit()

  -- Restore the sort and filter values
  if (!!admExClaim.sortVal.set()) then
    !!admExClaim.sort.select('rtext',!!admExClaim.sortVal)
    !!admExClaim.filter.val = !!admExClaim.filterVal
  endif

  -- Collect and display the databases
  call !!admExClaimDbSet()
  call !!admExClaimDbList()

endfunction
-- End of function definition for !!admExClaimInit
