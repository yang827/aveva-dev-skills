--
-- Description:
-- Function to refresh the contents of the Expunge Database Claimlist
-- form.
-- Function to be replaced by method !!admExClaim.refresh()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admExClaimRefr()

  -- Return if the form is not displayed
  if (!!admExClaim.shown().not()) then
    return
  endif

  -- Refresh the array of databases
  call !!admExClaimDbSet()

  -- Update the displayed databases
  call !!admExClaimDbList()

endfunction
-- End of function definition for !!admExClaimRefr
