--
--
-- Description:
-- Function to exit PDMS Admin back to UNIX.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admExit()

  -- Get user to confirm exit of PDMS
  !answer = !!alert.confirm(!!messageFile.messageString(141, 18))
  if (!answer.boolean().not()) then
    return
  endif

  -- Check the project lock
  call !!admCheckLock()

  -- End PDMS Session
  call !!writeSessionFile()
  FINISH

endfunction
-- End of function definition for !!admExit
