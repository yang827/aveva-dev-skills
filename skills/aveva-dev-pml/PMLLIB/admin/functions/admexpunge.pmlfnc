--
--
-- Description:
-- Callback function to expunge selected user processes.
-- Function to be replaced by method !!admExpunge.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admExpunge()

  -- Initialise variables
  !processList = ARRAY()

  -- Get the current selections
  !processList = _Process.selection(|RTEXT|)

  -- Check to see that we have selections
  if (!processList.empty()) then

    return

  endif

  -- Process the list of values
  do !pid values !processList

    EXPUNGE '$!pid'
    handle (1,36)

      -- Cannot expunge current process
      !!messageFile.error(141, 307)
      handle (06, 307)
        -- Dummy handle
      endhandle

    elsehandle any

      -- Non-specific error
      !!messageFile.error(141, 308, !pid, !!error.text)
      handle (06, 308)
        -- Dummy handle
      endhandle

    endhandle

  enddo

  -- Rebuild the process list
  call !!admExpungeInit()

  -- Attempt to reselect old processes that haven't been expunged
  do !pid values !processList

    _Process.select(|RTEXT|,!pid)
    handle (61,567)
      -- Process has been expunged
    endhandle

  enddo


endfunction
-- End of function definition for !!admExpunge
