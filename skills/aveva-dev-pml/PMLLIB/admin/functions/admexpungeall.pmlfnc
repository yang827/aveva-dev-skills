--
--
-- Description:
-- Function to expunge all user functions from the current project.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admExpungeAll()

  -- Initialise variables
  !project  = CURRENT PROJECT
  !projId=!project.id()
  if (!projId.unset()) then
    !projId=!project.code().upcase()
  endif
  -- Get user to confirm the expunge process
  !answer = !!alert.confirm(!!messageFile.messageString(141, 301, $
     !projId))

  if (!answer.boolean().not()) then

    -- User aborted
    return

  endif

  -- Expunge the project
  EXPUNGE
  handle (43,41)
  	!error	= 'Expunge has completed, but one or more database files have not been found in the project directory.'
  	!!alert.warning(!error)
  elsehandle ANY
  	!error 	= !!error.text
  	!!alert.warning(!error)
  endhandle

endfunction
-- End of function definition for !!admExpungeAll
