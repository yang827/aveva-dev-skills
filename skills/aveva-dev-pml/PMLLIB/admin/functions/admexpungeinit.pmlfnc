-- Created:         Wed Apr 16 09:31:28 BST 1997
--
--
-- Description:
-- Function to initialise and sort the list of user processes
-- in the current project.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admExpungeInit()

  -- Get up to date view of COMMS db
  GETWORK COMMS
  -- Initialise variables
  !dispList   = ARRAY()
  !replList   = ARRAY()
  !sessions   = SESSIONS
  !textLines  = ARRAY()
  !sortOn     = !!admExpunge.sort.selection(|DTEXT|)

  -- Clear the existing list of processes
  !!admExpunge.process.clear()

  -- Gather session information before sorting
  do !i index !sessions

    -- Create arrays of the process data
    !isCurrent[!i]    = !sessions[!i].isCurrent
    !startDate[!i]    = !sessions[!i].entered.split()

    -- Entered strings are for daemon user hh:mm:ss Day Date Month Year
    --                     for normal user hh:mm:ss Date Month

    !!ss = !startDate[!i]
    !month[!i] = !startDate[!i][4]
    handle any
      !month[!i] = !startDate[!i][3]
    endhandle

    if (!month[!i] eq |Jan|) then
       !monthNum = |01|
    elseif (!month[!i] eq |Feb|) then
       !monthNum = |02|
    elseif (!month[!i] eq |Mar|) then
       !monthNum = |03|
    elseif (!month[!i] eq |Apr|) then
       !monthNum = |04|
    elseif (!month[!i] eq |May|) then
       !monthNum = |05|
    elseif (!month[!i] eq |Jun|) then
       !monthNum = |06|
    elseif (!month[!i] eq |Jul|) then
       !monthNum = |07|
    elseif (!month[!i] eq |Aug|) then
       !monthNum = |08|
    elseif (!month[!i] eq |Sep|) then
       !monthNum = |09|
    elseif (!month[!i] eq |Oct|) then
       !monthNum = |10|
    elseif (!month[!i] eq |Nov|) then
       !monthNum = |11|
    else
       !monthNum = |12|
    endif

    !day[!i] = REAL(!startDate[!i][3])
    handle any
      !day[!i] = REAL(!startDate[!i][2])
    endhandle
    if (!day[!i] lt 10) then
       !dayStr = |0| + !day[!i].string()
    else
       !dayStr = !day[!i].string()
    endif

    !sortDate[!i]     = !monthNum + $
                        !dayStr + $
                        !startDate[!i][1]
    !realName[!i]     = !sessions[!i].name
    !hostname[!i]     = !sessions[!i].host
    !version[!i]      = !sessions[!i].version	
    !processId[!i]    = !sessions[!i].uniqueId
    !user[!i]         = !sessions[!i].user().name
    handle (2,754)
      -- User name not found
      !user[!i]       = 'Unknown'
    endhandle

    !testModule       = !sessions[!i].modulename
    handle (2,754)
      !testModule = 'Unknown'
    endhandle
    if( !testModule.unset() ) then
      !testModule = 'Unset'
    endif

    -- In 12.1 series, use normal module names
      !module[!i] = !testModule

  enddo

  -- Sort the data based on the value of the sort gadget
  if (!sortOn eq |Date|) then

    -- Sort on DATE
    !sortOrder        = !sortDate.sortedIndices()

  elseif (!sortOn eq |Real Name|) then

    -- Sort on REAL NAME
    !sortOrder        = !realName.sortedIndices()

  elseif (!sortOn eq |Username|) then

    -- Sort on USER
    !sortOrder        = !user.sortedIndices()

  elseif (!sortOn eq |Host|) then

    -- Sort on HOST
    !sortOrder        = !hostname.sortedIndices()

  elseif (!sortOn eq |Module|) then

    -- Sort on MODULE
    !sortOrder        = !module.sortedIndices()
	
  elseif (!sortOn eq |Version|) then

  -- Sort on VERSION
    !sortOrder        = !version.sortedIndices()	

  endif

  -- Build list of display text
  !mm = object AVEVAMODULEMANAGER()
  if (!mm.currentProductName().upcase().eq('HULL & OUTFITTING')) then
    !userType = 'MARINE User'
  else
    !userType = 'PDMS User'
  endif

  do !i values !sortOrder
    -- Replacement text is PID
    !replList.append(!processId[!i])

    -- Construct display text template
    if (!sortOn eq |Date|) then
     !heading[1] = 'Date' !heading[2] = 'Name' !heading[3] = 'Host Name' !heading[4] = !userType !heading[5] = 'Module' !heading[6] = 'Version'
      !command  =  !day[!i] & ' ' & !month[!i] & ' ' & !startDate[!i][1] & '	' & !realName[!i]  & '	' & $
                   !hostname[!i]  & '	' & !user[!i]  & '	' &  !module[!i] & '	' & !version[!i]
    elseif (!sortOn eq |Real Name|) then
      !heading[1] = 'Name' !heading[2] = 'Date' !heading[3] = 'Host Name' !heading[4] = !userType !heading[5] = 'Module' !heading[6] = 'Version'
      !command  =  !realName[!i]  & '	' &  !day[!i] & ' ' & !month[!i] & ' ' & !startDate[!i][1]  & '	' & $
                   !hostname[!i]  & '	' & !user[!i]   & '	' &   !module[!i] & '	' & !version[!i]
    elseif (!sortOn eq |Username|) then
      !heading[1] = !userType !heading[2] = 'Module' !heading[3] = 'Version' !heading[4] = 'Name' !heading[5] = 'Date' !heading[6] = 'Host Name'
      !command  = !user[!i]  & '	' &  !module[!i]  & '	' &  !version[!i] & '	' & !realName[!i]   & '	' & $
                  !day[!i] & ' ' & !month[!i] & ' ' & !startDate[!i][1]  & '	' & !hostname[!i]
    elseif (!sortOn eq |Host|) then
      !heading[1] = 'Host Name' !heading[2] = 'Date' !heading[3] = 'Name' !heading[4] = !userType !heading[5] = 'Module' !heading[6] = 'Version'
	  !command  = !hostname[!i]  & '	' & !day[!i] & ' ' & !month[!i] & ' ' & !startDate[!i][1]  & '	' & $
                  !realName[!i]  & '	' & !user[!i]  & '	' & !module[!i] & '	' & !version[!i]
    elseif (!sortOn eq |Module|) then
      !heading[1] = 'Module' !heading[2] = 'Version' !heading[3] = !userType !heading[4] = 'Date' !heading[5] = 'Name' !heading[6] = 'Host Name'
      !command  = !module[!i] & '	' & !version[!i] & '	' & !user[!i]  & '	' &  !day[!i] & ' ' & !month[!i] & ' ' & !startDate[!i][1]  & '	' & $
                  !realName[!i]  & '	' & !hostname[!i]
    elseif( !sortOn eq |Version|) then
      !heading[1] = 'Version' !heading[2] = 'Date' !heading[3] = 'Name' !heading[4] = 'Host Name' !heading[5] = !userType !heading[6] = 'Module'
      !command  =  !version[!i] & '	' & !day[!i] & ' ' & !month[!i] & ' ' & !startDate[!i][1] & '	' & !realName[!i]  & '	' & $
                   !hostname[!i]  & '	' & !user[!i]  & '	' &	!module[!i]
    endif

    -- Compose the text array
    --!textLines        = !!composeText(!command)
    !textLines[1] = !command

    -- Check for current session
    if (!isCurrent[!i]) then

      -- Place asterisk in front of current session
      !textLines[1] = |* |& !textLines[1]

    else

      -- Blank before other sessions
      !textLines[1] = |  |& !textLines[1]

    endif

    -- Display text
    !dispList.append(!textLines[1])

  enddo

  -- set headings
  !!admExpunge.process.setHeadings(!heading)
  -- Add texts to list gadget
  !!admExpunge.process.dText = !dispList
  !!admExpunge.process.rText = !replList


endfunction
-- End of function definition for !!admExpungeInit
