define function !!admFontIrnoDflt()

  !fontIrno             = object FONTIRNO()
  !fontIrno.number      = 4
  !fontIrno.name        = 'UK'
  !fontIrno.description = 'UK'
  call !!admFontsIrnoAdd(!fontIrno)

  !fontIrno             = object FONTIRNO()
  !fontIrno.number      = 6
  !fontIrno.name        = 'US'
  !fontIrno.description = 'US'
  call !!admFontsIrnoAdd(!fontIrno)

  !fontIrno             = object FONTIRNO()
  !fontIrno.number      = 18
  !fontIrno.name        = 'GREEK'
  !fontIrno.description = 'Greek'
  call !!admFontsIrnoAdd(!fontIrno)

  !fontIrno             = object FONTIRNO()
  !fontIrno.number      = 37
  !fontIrno.name        = 'CYRILLIC'
  !fontIrno.description = 'Cyrillic'
  call !!admFontsIrnoAdd(!fontIrno)

  !fontIrno             = object FONTIRNO()
  !fontIrno.number      = 85901
  !fontIrno.name        = 'LATIN 1'
  !fontIrno.description = 'Latin 1'
  call !!admFontsIrnoAdd(!fontIrno)

  !fontIrno             = object FONTIRNO()
  !fontIrno.number      = 85902
  !fontIrno.name        = 'LATIN 2'
  !fontIrno.description = 'Latin 2'
  call !!admFontsIrnoAdd(!fontIrno)

  !fontIrno             = object FONTIRNO()
  !fontIrno.number      = 85905
  !fontIrno.name        = 'LATIN CYRILLIC'
  !fontIrno.description = 'Latin Cyrillic'
  call !!admFontsIrnoAdd(!fontIrno)

endfunction
-- End of function definition for !!admFontIrnoDflt
