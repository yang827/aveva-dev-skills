--
--
-- Description:
-- Callback function on the apply button of the Admin fonts form.
-- Function to be replaced by method !!admFonts.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admFonts()

  -- Initialise variables
  !font    = !!admFonts.fontList.selection('rtext').dbRef()
  !dir     = !!admFonts.fontDir.val

  -- Check for element being already claimed

  if (not !!dbRefUpdate (!font)) then
    !!alert.error (!!error.text)
    return
  endif

  -- Change the font directory
  if (!dir neq !font.owner.fntdir) then

    FONTDIRECTORY "$!dir"

  endif
  -- Set new font values
  if (!!admFonts.irno.active) then

    -- System font definition
    !!ce     = !font
    !irno    = !!admFonts.irno.selection('rtext')
    !style   = !!admFonts.style.selection('rtext')
    !angle   = !!admFonts.sysAngle.val.real()

    -- -- Change the Font type (Note 'LATIN 1' queries as 'LATIN-1')
    -- if (!irno neq !!ce.irno.replace('-',' ') ) then
    --   IRNO $!irno
    -- endif
    -- -- Change the font style
    -- if (!style neq !font.stno) then
    --   STNO $!style
    -- endif

    -- Change the Font type and style (Note 'LATIN 1' queries as 'LATIN-1')
    -- Do both together since this avoids spurious illegal combinations
    if (!irno neq !!ce.irno.replace('-',' ') or !style neq !font.stno) then
      FONTF $!!admFonts.fontList.val $!irno $!style
    endif

    -- Change the font angle
    if (!angle neq !font.faan) then
      !ang     = !angle.string()
      FAAN $!ang
    endif

    -- Unset user defined values
    FNMA unset
    FNMB unset

  elseif (!!admFonts.stdFile.active) then

    -- User defined font definition
    !!ce    = !font
    !std    = !!admFonts.stdFile.val
    !bold   = !!admFonts.boldFile.val
    !angle  = !!admFonts.sysAngle.val.real()

    -- Change the standard font file
    if (!std neq !!ce.fnma.substring(1) and !std neq 'unset') then
      FNMA  '/$!std'
    endif

    -- Change the bold font file
    if (!bold neq !!ce.fnmb and !bold neq 'unset') then
      FNMB  '/$!bold'
    elseif (!bold eq 'unset') then
      FNMB unset
    endif

    -- Change the font angle
    if (!angle neq !font.faan) then
      !ang     = !angle.string()
      FAAN $!ang
    endif

  endif

  -- Update the list
  call !!admFontsRefresh()

  -- Reselect the font
  !!admFonts.fontList.select('rtext', !font.string())
  call !!admFontsSelect()

endfunction
-- End of function definition for !!admFonts
