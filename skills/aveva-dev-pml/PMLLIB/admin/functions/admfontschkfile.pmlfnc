-- Created:         Thu Dec 11 10:22:24 GMT 1997
--
--
-- Description:
-- Function to check that the specified font file exists in the project
-- font directory.
-- Function to be replaced by method !!admFonts.checkFile(GADGET)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Callback for gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admFontsChkFile(!gadget is GADGET)

  -- Initialise variables
  !font       = !!admFonts.fontList.selection('rtext').dbRef()
  !fontName   = !gadget.val
  !directory  = !!admFonts.fontDir.val
  !file       = object FILE()

  -- Check that user has not supplied a '.gfb'
  if (!fontName.part(-1,'.') eq 'gfb') then
    !fontName   = !fontName.before('.gfb')
    !gadget.val = !fontName
  endif

  -- Construct the filename
  !filename   = !directory +'/'+ !fontName +'.gfb'

  -- Check the font file exists
  !file.file(!filename)
  if (!file.exists().not()) then

    -- File not found
    !!messageFile.warning(141, 324, !fontName, !directory)

    -- Reset the gadget values
    if (!gadget.name() eq 'STDFILE') then

      if (!font.fnma.empty()) then
        !gadget.val = |unset|
      else
        !gadget.val = !font.fnma
      endif

    elseif (!gadget.name() eq 'BOLDFILE') then

      if (!font.fnmb.empty()) then
        !gadget.val = |unset|
      else
        !gadget.val = !font.fnmb
      endif

    endif

  endif



endfunction
-- End of function definition for !!admFontsChkFile
