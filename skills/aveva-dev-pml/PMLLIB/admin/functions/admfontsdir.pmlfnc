--
--
-- Description:
-- Callback function to the Font directory text gadget on the
-- Font Family Definition form.
-- Function to be replaced by method !!admFonts.cbDir()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admFontsDir()

  -- Initialise variables
  !dir        = !!admFonts.fontDir.val
  !font       = !!admFonts.fontList.selection('rtext').dbRef()
  !currentDir = !font.owner.fntdir
  !check      = object DIRECTORY()

  -- Remove '//' from start of string
  if (!dir.substring(1,2) eq '//' or !dir.substring(1,2) eq '/%') then
    !dir        = !dir.substring(2)
  endif

  -- Check we have a directory
  !check      = !!directory(!dir)
  if (!check.name.unset()) then

    -- Invalid directory
    !!admFonts.fontDir.val = !currentDir
    !!messageFile.error(146, 23, !dir)

  endif

endfunction
-- End of function definition for !!admFontsDir
