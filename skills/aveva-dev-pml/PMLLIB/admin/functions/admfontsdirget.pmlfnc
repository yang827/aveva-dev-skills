-- Define function
define function !!admFontsDirGet()

  -- Navigate to the font world
  FTWL 1 of /*S

  -- Collect the DBrefs that make up the font families
  !!admFonts.fontDir.val   = !!ce.fntdir.substring(2)


endfunction
-- End of function definition for !!admFontsDirGet
