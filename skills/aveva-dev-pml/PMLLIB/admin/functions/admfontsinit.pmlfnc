--
--
-- Description:
-- Initialise the Admin font definition form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admFontsInit()

  -- Get the defaults date for style and IRNO
  call !!admFontsIrnoGet()
  call !!admFontsStyleGet()

  -- Get the font directory
  call !!admFontsDirGet()

  -- Get the font family definitions
  call !!admFontsGet()

  -- Initialise the list data
  call !!admFontsRefresh()

  -- Select a font family
  call !!admFontsSelect()


endfunction
-- End of function definition for !!admFontsInit
