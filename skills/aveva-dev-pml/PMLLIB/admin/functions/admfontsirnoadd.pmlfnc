--
-- Description:
-- Store a FONTIRNO object in the form !!admFonts form member
-- !!admFonts.irnoData.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FONTIRNO   Font IRNO object to store
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admFontsIrnoAdd(!data is FONTIRNO)

  -- Store the value
  !!admFonts.irnoData.append(!data)


endfunction
-- End of function definition for !!admFontsIrnoAdd
