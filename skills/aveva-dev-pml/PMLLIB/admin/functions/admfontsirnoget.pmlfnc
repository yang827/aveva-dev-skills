--
--
-- Description:
-- Get the defaults data form permissible font irno data.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admFontsIrnoGet()

  -- Initialise variables
  !rText  = ARRAY()
  !dText  = ARRAY()

  -- Clear the existing array and gadget
  !!admFonts.irno.clear()
  !!admFonts.irnoData.clear()

  -- load the defaults
  !!admFontIrnoDflt()

  -- Process IR number data
  do !i indices !!admFonts.irnoData

    !dText.append(!!admFonts.irnoData[!i].description)
    !rText.append(!!admFonts.irnoData[!i].name)

  enddo

  -- Assign values to the option gadget
  !!admFonts.irno.dText   = !dText
  !!admFonts.irno.rText   = !rText
  !dText.clear()
  !rText.clear()


endfunction
-- End of function definition for !!admFontsIrnoGet
