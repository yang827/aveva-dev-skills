--
--
-- Description:
-- Function to display the current font settings.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admFontsRefresh()

  -- Initialise variables
  !!admFonts.fontList.clear()
  !dText   = ARRAY()
  !rText   = ARRAY()
--  !irWidth = !!admFonts.irno.dText.width()
--  !stWidth = !!admFonts.style.dText.width()

  -- Loop through the list of fonts
  do !i indices !!admFonts.font

    !!ce     = !!admFonts.font[!i]

    -- See if the font is user defined
    if (!!ce.fnma.empty() and !!ce.fnmb.empty()) then

      -- Get information from the list
      -- NB: IRNO stored as 'LATIN-1' although set as 'LATIN 1'
      !typePos     = !!admFonts.irno.rText.findFirst(!!ce.irno.replace('-',' '))
      !stylePos    = !!admFonts.style.rText.findFirst(!!ce.stno)

      -- System defined font
      !displayText  = |Font | + !i.string() + | System| + $
                      |  Type: | + !!admFonts.irno.dText[!typePos] + $
                      |  Style: | + !!admFonts.style.dText[!stylePos]

      -- Assign list texts
      !dText.append(!displayText)
      !rText.append(!!ce.string())

    else

      -- User defined font
      !displayText  = |Font | + !i.string() + | User  | + $
                      |  Font file: | + !!ce.fnma + $
                      |  Bold file: | + !!ce.fnmb

      -- Assign list texts
      !dText.append(!displayText)
      !rText.append(!!ce.string())

    endif

  enddo

  -- Assign gadget values
  !!admFonts.fontList.dText  = !dText
  !!admFonts.fontList.rText  = !rText


endfunction
-- End of function definition for !!admFontsRefresh
