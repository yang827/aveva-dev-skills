--
--
-- Description:
-- Function to set data in the Admin Fonts form to the selected font
-- family.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admFontsSelect()

  -- Get the selected font
  !!ce      = !!admFonts.fontList.selection('rtext').dbRef()
  !pos      = !!admFonts.font.findFirst(!!ce)

  -- Set the current font family number
  !!admFonts.current = !pos

  -- Check to see what font type it is
  if (!!ce.fnma.empty() and !!ce.fnmb.empty()) then

    -- System defined font
    -- Set form values
    !!admFonts.fontType.val     = 1

    -- Set system font values
    !!admFonts.irno.active      = true
    !!admFonts.style.active     = true
    !!admFonts.sysAngle.active  = true
    !!admFonts.sysAngle.val     = !!ce.faAngle.string()
    -- (Note 'LATIN 1' queries as 'LATIN-1')
    !!admFonts.irno.select('rtext',!!ce.irno.replace('-',' ') )
    !!admFonts.style.select('rtext',!!ce.stno)

    -- Disable user defined fonts
    !!admFonts.stdFile.active   = false
    !!admFonts.stdFile.val      = |unset|
    !!admFonts.boldFile.active  = false
    !!admFonts.boldFile.val     = |unset|
    !!admFonts.udefAngle.active = false
    !!admFonts.udefAngle.val    = !!ce.faAngle.string()

  else

    -- User defined font
    -- Set form values
    !!admFonts.fontType.val     = 2

    -- Enable user defined fonts
    !!admFonts.stdFile.active   = true
    !!admFonts.boldFile.active  = true
    !!admFonts.udefAngle.active = true
    !!admFonts.udefAngle.val    = !!ce.faAngle.string()
    !!admFonts.stdFile.val      = !!ce.fnma.substring(2)
    if (!!ce.fnmb.empty()) then
      !!admFonts.boldFile.val     = |unset|
    else
      !!admFonts.boldFile.val     = !!ce.fnmb.substring(2)
    endif

    -- Disable system font values
    !!admFonts.irno.active      = false
    !!admFonts.style.active     = false
    !!admFonts.sysAngle.active  = false
    !!admFonts.sysAngle.val     = !!ce.faAngle.string()

  endif

endfunction
-- End of function definition for !!admFontsSelect
