--
-- Description:
-- Store a FONTSTYLE object in the form !!admFonts form member
-- !!admFonts.styleData.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FONTSTYLE   Font style object to store
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admFontsStyleAdd(!style is FONTSTYLE)

  -- Store the value
  !!admFonts.styleData.append(!style)


endfunction
-- End of function definition for !!admFontsStyleAdd
