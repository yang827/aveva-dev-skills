--
--
-- Description:
-- Get the defaults data form permissible font data.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admFontsStyleGet()

  -- Initialise variables
  !rText  = ARRAY()
  !dText  = ARRAY()

  -- Clear the old data
  !!admFonts.style.clear()
  !!admFonts.styleData.clear()

  -- load the defaults
  !!admFontStyleDflt()

  -- Process style data
  do !i indices !!admFonts.styleData

    !dText.append(!!admFonts.styleData[!i].description)
    !rText.append(!!admFonts.styleData[!i].name)

  enddo

  -- Assign values to the option gadget
  !!admFonts.style.dText   = !dText
  !!admFonts.style.rText   = !rText
  !dText.clear()
  !rText.clear()


endfunction
-- End of function definition for !!admFontsStyleGet
