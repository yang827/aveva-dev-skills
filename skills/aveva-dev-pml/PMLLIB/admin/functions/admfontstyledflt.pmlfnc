-- Description:
-- Defaults function for allowable font family style definitions.
--
------------------------------------------------------------------------

define function !!admFontStyleDflt()

  !fontStyle             = object FONTSTYLE()
  !fontStyle.number      = 1
  !fontStyle.name        = 'LINE'
  !fontStyle.description = 'Line'
  call !!admFontsStyleAdd(!fontStyle)

  !fontStyle             = object FONTSTYLE()
  !fontStyle.number      = 1
  !fontStyle.name        = 'BLOCK'
  !fontStyle.description = 'Block'
  call !!admFontsStyleAdd(!fontStyle)

  !fontStyle             = object FONTSTYLE()
  !fontStyle.number      = 3
  !fontStyle.name        = 'SERIF'
  !fontStyle.description = 'Serif'
  call !!admFontsStyleAdd(!fontStyle)

  !fontStyle             = object FONTSTYLE()
  !fontStyle.number      = 4
  !fontStyle.name        = 'ITALIC'
  !fontStyle.description = 'Italic'
  call !!admFontsStyleAdd(!fontStyle)

  !fontStyle             = object FONTSTYLE()
  !fontStyle.number      = 5
  !fontStyle.name        = 'SCRIPT'
  !fontStyle.description = 'Script'
  call !!admFontsStyleAdd(!fontStyle)

  !fontStyle             = object FONTSTYLE()
  !fontStyle.number      = 6
  !fontStyle.name        = 'TYPEWRITER'
  !fontStyle.description = 'Typewriter'
  call !!admFontsStyleAdd(!fontStyle)

  !fontStyle             = object FONTSTYLE()
  !fontStyle.number      = 7
  !fontStyle.name        = 'UWLINE'
  !fontStyle.description = 'Uniform Width'
  call !!admFontsStyleAdd(!fontStyle)

endfunction
-- End of function definition for !!admFontStyleDflt
