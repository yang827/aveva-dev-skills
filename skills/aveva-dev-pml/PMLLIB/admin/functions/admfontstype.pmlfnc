--
--
-- Description:
-- Callback to radio gadget for font type. Changes gadgets states
-- depending on type of selected font.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admFontsType()

  -- Change for state
  if (!!admFonts.fontType.val eq 1) then

    -- System defined font
    !!admFonts.irno.active      = true
    !!admFonts.style.active     = true
    !!admFonts.sysAngle.active  = true
    !!admFonts.stdFile.active   = false
    !!admFonts.boldFile.active  = false
    !!admFonts.udefAngle.active = false

  elseif (!!admFonts.fontType.val eq 2) then

    -- User defined font active
    !!admFonts.irno.active      = false
    !!admFonts.style.active     = false
    !!admFonts.sysAngle.active  = false
    !!admFonts.stdFile.active   = true
    !!admFonts.boldFile.active  = true
    !!admFonts.udefAngle.active = true

  endif


endfunction
-- End of function definition for !!admFontsType
