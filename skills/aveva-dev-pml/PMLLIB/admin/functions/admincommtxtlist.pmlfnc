-- Created:         Mon Jun 9 11:02:33 BST 1997
--
--
-- Description:
-- Function to construct the list texts for LCOMD elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of DBREF objects for LCOMD elements.
--    2   RW     GADGET      List gadget to populate
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!adminCommTxtList(!dbRefArray is ARRAY, !list is GADGET)

  -- Initialise variables
  !dText       = ARRAY()
  !rText       = ARRAY()

  -- Check we have some elements to process
  if (!dbRefArray.set()) then

    -- Loop through array
    do !i indices !dbRefArray

      -- Collect attributes
      !name[!i]   = !dbRefArray[!i].name.substring(2)
      !targ[!i]   = !dbRefArray[!i].locRf.locId
      handle (2,754)
        -- handle location reference being unset when location is offline
        !targ[!i] = 'Unset'
      endhandle
      !desc[!i]   = !dbRefArray[!i].desc
      if (!desc[!i].empty()) then

        !desc[!i] = |unset|

      endif

    enddo

    -- Calculate column widths
    !cwName = !name.width()

    -- Element type indicator
    if( !!admDisplayConfig.eleTypeGet() ) then
      !headerText  = |<LCOMD>| & |  |
    else
      !headerText  = ||
    endif

    -- Loop through array and build texts
    do !i indices !dbRefArray

      -- Build Masks
      !name[!i] = !name[!i] + |                                |

      -- Build Display text
    !displayText  = !headerText + !name[!i].substring(1,!cwName)  & |	| & |[To: | & !targ[!i] & |]|  & '	' &  !desc[!i]

      -- Construct texts
      !dText.append(!displayText)
      !rText.append(!dbRefArray[!i].string())

    enddo
  endif
  -- Assign elements to the list gadget
  !heading[1] = 'Name' !heading[2] = 'Update' !heading[3] = 'Description'

  !list.setHeadings(!heading)
  !list.dText   = !dText
  !list.rText   = !rText

endfunction
-- End of function definition for !!adminCommTxtList
