--
--
-- Description:
-- Function to construct the list texts for DB elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of DBREF of database elements
--    2   RW     GADGET      List gadget to populate
--    3   R      DBLISTATTR  Db list format object
--    4   R      BOOLEAN     User db line header "<db>"
--    5   R      DBREF       Global - DBREF of location which a databases
--                           primary or secondary state should be shown
--                           relative to.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!adminDbTxtList(!dbRefArray is ARRAY, !list is GADGET,!listFormat is DBLISTATTR,!useHeader is BOOLEAN, !wrtLoc is DBREF)

  !dbList = object ADMTEXTLIST()
  !dbList.addDbs(!dbRefArray, !listFormat, !useHeader, !list, !wrtLoc)

endfunction
-- End of function definition
