-- Created:         Tue May 6 09:39:23 BST 1997
--
--
-- Description:
-- Function to filter, then sort an array of DBREFs.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of DBREFs to process (must be common type)
--    2   R      GADGET      Option gadget containing SORT data (RTEXT is attribute)
--    3   R      GADGET      Text gadget containing FILTER data (incl. wildcards)
-- Return:
--   [Data Type] [Description]
--    ARRAY       Processed array of DBREFs
--
------------------------------------------------------------------------

-- Define function
define function !!adminFilterSort(!dbRefs is ARRAY, !sort is GADGET, !filter is GADGET) is ARRAY

  -- Legality Checks
  if (!dbRefs.empty()) then
    -- Empty array passed
    return object ARRAY()
  else
    -- Discover whether this is a list of DBs or DBREFs
    !objectType = !dbRefs[1].objectType()
  endif

  if (!sort.type() neq 'LIST' or !filter.type() neq 'TEXT') then

    -- Invalid gadgets passed
    return object ARRAY()
  endif

  !sortOn        = !sort.selection('RTEXT')
  !filterString  = !filter.val.trim()

  if (!filterString.empty() or !filterString eq |*|) then

    -- Set full wildcard as filter value
    !filter.val = |*|
    -- no filtering to do, just copy the array
    !returnArray = !dbRefs

  else

    -- Initialise variables
    !returnArray   = ARRAY()
    !sortText      = ARRAY()
    !filterName    = !!sessionSettings.showAs eq 'NAME'

    -- Build array to filter against
    do !db values !dbRefs

      if (!filterName or !db.description.unset()) then
        !name = !db.name.replace('*','')
        if( !objectType eq |DBREF| ) then
          -- remove leading / from name
          !name = !name.substring(2)
        endif
        if (!name.replace('*','').matchWild(!filterString)) then
          !returnArray.append(!db)
        endif

      else

        if (!db.description.matchWild(!filterString)) then
          !returnArray.append(!db)
        endif
      endif
    enddo
  endif

 WORLD

  -- Build the sort texts
  if (!sortOn.lowcase() eq 'dbno.string()' or !sortOn.lowcase() eq 'dbno' ) then
    -- Database numbers need something special
    !textBlock  = object BLOCK(|substring('000000' + !returnArray[!evalIndex].|& !sortOn &|,-6,6) + !returnArray[!evalIndex].name|)
    !errorBlock = object BLOCK(|substring('000000' + !returnArray[!evalIndex].refno.dbRef().|& !sortOn &|,-6,6) + !returnArray[!evalIndex].name|)
  else
    !textBlock  = object BLOCK(|!returnArray[!evalIndex].|& !sortOn &| + !returnArray[!evalIndex].name|)
    !errorBlock = object BLOCK(|!returnArray[!evalIndex].refno.dbRef().|& !sortOn &| + !returnArray[!evalIndex].name|)
  endif

  -- get text for sort
  !sortText  = !returnArray.evaluate(!textBlock)

  handle (2,759)
    -- The attribute searched for does not exist, it maybe pml object hence try the dbref of it's refno attr
    !sortText  = !returnArray.evaluate(!errorBlock)
    handle any
      return !returnArray
    endhandle
  elsehandle any
    return !returnArray
  endhandle

  if (!sortOn eq 'prmloc.string()')then
    var !locId locId of hubrf of /*GL
    do !index index !sortText
      !text = !sortText[!index]
      skip if (!text.matchWild('Unset*'))
      !location     = !text.before('/*')
      !rest         = !text.after(!location)
      !locationName = !location.dbRef().name
      !hub          = !location.dbRef().locId
      if (!hub eq !locId) then
        !text = '/1' & !locationName & !rest
      else
        !text = !locationName & !rest
      endif
      !sortText[!index] = !text
    enddo
  endif

  -- Sort and return the array
  !sortOrder = !sortText.sortedIndices()
  !returnArray.reIndex(!sortOrder)
  return !returnArray

endfunction
-- End of function definition for !!adminFilterSort
