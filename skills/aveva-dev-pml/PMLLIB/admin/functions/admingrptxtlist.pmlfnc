--
--
-- Description:
-- Function to construct the list texts for GRP elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of DBREF objects for GRP elements.
--    2   RW     GADGET      List gadget to populate
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!adminGrpTxtList(!dbRefArray is ARRAY, !list is GADGET )

  -- Initialise variables
  !dText       = ARRAY()
  !rText       = ARRAY()

  -- Check that we have some groups to process
  if (!dbRefArray.unset()) then
    !list.dText = !dText
    !list.rText = !rText
    return
  endif

  -- Loop through array
  do !i indices !dbRefArray

    -- Collect attributes
    !name[!i]   = !dbRefArray[!i].name.substring(2)
    !desc[!i]   = !dbRefArray[!i].desc
    if (!desc[!i].empty()) then

      !desc[!i] = |unset|

    endif

  enddo

  -- Calculate column widths
  !cwName = !name.width()

  -- Element type indicator
    if( !!admDisplayConfig.eleTypeGet() ) then
    !headerText  = |<GRP>| & |  |
  else
    !headerText  = ||
  endif

  -- Loop through array and build texts
  do !i indices !dbRefArray

    -- Build Masks
    !name[!i] = !name[!i] + |                                |

    -- Build Display text
    !displayText  = !headerText & !name[!i].substring(1,!cwName)  & ' ' &  !desc[!i]

    -- Construct texts
    !dText.append(!displayText)
    !rText.append(!dbRefArray[!i].string())

  enddo

  -- Assign elements to the list gadget
  !list.dText   = !dText
  !list.rText   = !rText


endfunction
-- End of function definition for !!adminGrpTxtList
