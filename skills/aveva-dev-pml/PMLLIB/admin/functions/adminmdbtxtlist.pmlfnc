--
-- Description:
-- Function to construct the list texts for MDB elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of DBREFs of mdb elements.
--    2   RW     GADGET      List gadget to populate
--    3   R      MDBLISTATTR Mdb list format object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!adminMdbTxtList(!dbRefArray is ARRAY, !list is GADGET, !listFormat is MDBLISTATTR, !useHeader is BOOLEAN)

  !mdbList = object ADMTEXTLIST()
  !mdbList.addMdbs(!dbRefArray, !listFormat, !useHeader, !list)

endfunction
-- End of function definition for !!adminMdbTxtList
