--
--
-- Description:
-- Function to load objects required by the Admin module.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!adminObjects()

  -- Load Common Objects
    -- Date time object
    !!loadObject('clock')

    -- Directory entries
    !!loadObject('directory')

    -- File information object
    !!loadObject('file')
    !!loadObject('module')

    -- Message system objects
    !!loadObject('message')
    !!loadObject('messages')

    -- Used for collections
    !!loadObject('volume')
    !!loadObject('collect')

  -- Session data
  !!loadObject('pdmssettings')

  -- Module bar data
  !!loadObject('modulebardata')

  -- Admin Elements List Settings
  !!loadObject('dblistattr')
  !!loadObject('userlistattr')
  !!loadObject('teamlistattr')
  !!loadObject('mdblistattr')

  -- Standard font details
  !!loadObject('fontirno')
  !!loadObject('fontstyle')

endfunction
-- End of function definition for !!adminObjects
