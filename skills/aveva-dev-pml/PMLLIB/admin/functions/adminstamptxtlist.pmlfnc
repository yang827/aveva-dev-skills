--
--
-- Description:
-- Function to construct list texts for STAMP elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      ARRAY          Array of DBREFs of stamp elements
--    2   RW     GADGET         List gadget to populate
--    3   R      STAMPLISTATTR  Stamp list format object
--    4   R      BOOLEAN        Use line header '<STAMP>'
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!adminStampTxtList(!dbRefArray is ARRAY, !list is GADGET,!listFormat is STAMPLISTATTR,!useHeader is BOOLEAN)

  !stampList = object ADMTEXTLIST()
  !stampList.addStamps(!dbRefArray, !listFormat, !useHeader, !list)

endfunction
-- End of function definition
