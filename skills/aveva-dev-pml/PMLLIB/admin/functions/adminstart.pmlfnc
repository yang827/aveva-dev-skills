--
--
-- Description:
-- Function to initialise the Admin UI.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!adminStart()

  -- Check to see if UI should be started
  if (!!ttyMode()) then

    -- Module run in TTY mode
    return

  endif

  -- Load synonyms from PDMSUI common
  $m "%PDMSUI%/CLIB/FILES/VARS"

  -- Define global instance (!!admControl)
    call !!comDefineGlobal(object ADMCONTROL())

  -- Check to see if the project is a Global one.
  !adminGlobal  = !!glbIsGlobal()

  -- Check to see is the session settings have been set. If not this is
  -- because someone has gone into PDMS in TTY mode then
  -- changed to GRAPHICS from inside.... sigh
  !sessionData              = CURRENT SESSION
  !currentProject           = CURRENT PROJECT
  if (undefined(!!sessionSettings)) then

    -- Set the session settings
    !!sessionSettings         = object PDMSSETTINGS()

    !!sessionSettings.project = !currentProject.code()
    !!sessionSettings.user    = !sessionData.user().name
    !!sessionSettings.mdb     = !sessionData.mdb().name

  endif

  -- Define the admin or Global Help system
  if(!adminGlobal)then
    !!fmsys.setHelpFileAlias('AUG')
    fminfo help callback '$m "%PDMSUI%/MON/ADMIN/HELPABOUT"'
  else
    !!fmsys.setHelpFileAlias('AUG')
    fminfo help callback '$m "%PDMSUI%/MON/ADMIN/HELPABOUT"'
  endif

  -- Create object to hold the User define-able setting for the Admin Elements form
  !!admDisplayConfig = object ADMDISPLAYCONFIG()

  -- load defaults, note if this operation fails, calling function will set defaults
  !!admDisplayConfig.load()

  -- Initialise the Admin forms
  call !!adminForms()

  -- Set the isolation state if the project is global
  !hubUninitialised = false
  if (!adminGlobal) then

    -- Must ensure that adminApplic element data is set up first!
    call !!dbrAdminSetWorld()

    !hubRef = !!dbrGlbHubLocRf()
    if( !hubRef.set() ) then

      -- check that hub is initialised
      if(!!dbrGlbHubLocRf().lInit.not())then
        -- !!alert.error(|The Hub is uninitialised, make any necessary changes in the Locations forms and apply. This is needed for the project to function!|)
        !hubUninitialised = true
      endif

    else
      -- no reference to hub location (could be a hub with location moved but no getwork done)
      !!alert.error(|Reference to the Hub is unset. Has hub location been changed, but GETWORK not used to update this location with new hub details? This must be resolved for the project to function!|)
    endif

  endif

  -- setup the main application window
  !!pdmsAppWindow()

  -- Switch to new main form
  swap main to !!adminApplic

  -- Display the Admin Elements form
  show !!adminElem
  if( !hubUninitialised ) then
     !!adminElem.update('LOC')
  endif

--initialisation for search utility form
!!comformats = object COMFORMATS()

endfunction
-- End of function definition for !!adminStart
