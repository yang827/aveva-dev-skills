--
-- Description:
-- Function to construct list texts for TEAM elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Array of DBREFs of team elements
--    2   RW     GADGET       List gadget to populate
--    3   R      TEAMLISTATTR Team list format object
--    4   R      BOOLEAN      Use line header '<TEAM>'
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!adminTeamTxtList(!dbRefArray is ARRAY, !list is GADGET,!listFormat is TEAMLISTATTR,!useHeader is BOOLEAN)

  !teamList = object ADMTEXTLIST()
  !teamList.addTeams(!dbRefArray, !listFormat, !useHeader, !list)

endfunction
-- End of function definition
