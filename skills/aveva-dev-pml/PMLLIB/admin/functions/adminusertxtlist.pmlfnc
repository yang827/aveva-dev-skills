--
-- Description:
-- Function to construct list texts for USER elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Array of DBREFs of user elements
--    2   RW     GADGET       List gadget to populate
--    3   R      USERLISTATTR User list format object
--    4   R      BOOLEAN      Display line header '<USER>'
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!adminUserTxtList(!dbRefArray is ARRAY, !list is GADGET,!listFormat is USERLISTATTR,!useHeader is BOOLEAN)

  !userList = object ADMTEXTLIST()
  !userList.addUsers(!dbRefArray, !listFormat, !useHeader, !list)

endfunction
-- End of function definition for !!adminUserTxtList
