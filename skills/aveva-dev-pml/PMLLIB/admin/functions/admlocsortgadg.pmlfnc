--
--
-- Description:
-- Function to set the contents of a sort gadget associated with
-- location elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admLocSortGadg(!gadget is GADGET)

  -- Ensure that gadget is an LIST gadget
  if (!gadget.type() neq 'LIST') then
    return
  endif

  -- Initialise variables
  !dText        = ARRAY()
  !rText        = ARRAY()

  -- Assign values to the gadget
  -- Dtexts
  !dText.append('Name')
  !dText.append('Location Id')
  !dText.append('Connection')
  !dText.append('Description')
  !gadget.dText  = !dText

  -- Rtexts
  !rText.append('name')
  !rText.append('locid')
  !rText.append('iconn.string()')
  !rText.append('desc')
  !gadget.rText  = !rText


endfunction
-- End of function definition for !!admLocSortGadg
