--
--
-- Description:
--
--   Rebuild ADM main application bar
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!admMain()

  -- Initialise Variables

  -- Switch main form to CADCBTH
  if(undefined(!!adminApplicDummy)) then
    pml reload form !!adminApplicDummy
  endif

  swap main to !!adminApplicDummy

  -- Rebuild form
  pml reload form !!adminApplic

  -- Switch to new main form
  swap main to !!adminApplic

endfunction
-- End of function definition
