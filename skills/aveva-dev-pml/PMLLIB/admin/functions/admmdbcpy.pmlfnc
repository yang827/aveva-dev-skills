-- Author:          E.conba
-- Created:         Tue Jul 22 10:02:22 BST 1997
--
--
-- Description:
-- Function to copy a source mdb to a new mdb. The new mdb
-- will inherit the databases structure of the first mdb.
-- Function to be replaced by method !!admMdbCpy.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admMdbCpy()

  -- Initialise variables
  !sourceMdb      = !!admMdbCpyRefGet()
  !targetMdb      = !!admMdbCpy.name.val
  !description    = !!admMdbCpy.desc.val

  -- Check for unset target name
  if (!targetMdb eq 'unset') then
    !!messageFile.error(141, 212)
  else
    !targetMdb      = '/' + !targetMdb
  endif

  -- Create copy command
  !command        = |COPY MDB |+ !sourceMdb.name +| TO |+ !targetMdb

  -- Execute the copy command
  call !!admCommand(!command)
  handle (1,5)

    -- MDB already exists
    !!messageFile.error(141, 202, !targetMdb.substring(2))

  elsehandle (1,8)

    -- Source MDB not found
    !!messageFile.error(141, 203, !sourceMdb.name.substring(2))

  elsehandle any

    -- Non specific
    !!messageFile.error(141, 213, !!error.text)

  endhandle

  -- Get the new DBREF
  !elemName        = |/| + !targetMdb
  !!ce             = !elemName.dbRef()
  !!adminElem.mdbSet(!!ce)

  -- Copy command was a success so modify the description
  if (!description.empty() or !description eq 'unset') then
    !description = ''
  endif
  !!ce.description = !description

  -- Update forms
  !!adminElem.update('MDB')
  !!admMdb.update()


endfunction
-- End of function definition for !!admMdbCpy
