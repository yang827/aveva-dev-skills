--
--
-- Description:
-- Function to initialise the !!admMdbCpy form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admMdbCpyInit()

  -- Initialise form variables
  !dbRef   = !!adminElem.mdbGet()

  -- Return if no dbref to copy
  if (!dbRef.unset()) then
    !!messageFile.error(141, 029, 'MDB')
  endif

  -- Set the DBREF for the form
  !!admMdbCpyRefSet(!dbRef)

  -- Set form title
  !!admMdbCpy.formTitle   = 'Copy MDB: ' + !dbRef.name.substring(2)

  -- Initialise form gadgets
  !!admMdbCpy.name.val    = 'unset'

  if (!dbRef.description.empty().not()) then
    !!admMdbCpy.desc.val    = !dbRef.description
  else
    !!admMdbCpy.desc.val    = 'unset'
  endif


endfunction
-- End of function definition for !!admMdbCpyInit
