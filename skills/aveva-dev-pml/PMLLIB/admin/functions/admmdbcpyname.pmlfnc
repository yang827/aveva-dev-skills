--
-- Description:
-- Function to act as a callback to the Name gadget in the !!copyMdb
-- form.
-- Function to be replaced by method !!admMdbCpy.cbName()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admMdbCpyName()

  -- Initialise variables
  !tempRef     = object DBREF()

  -- Call the user name check
  call !!admChkMdbName(!!admMdbCpy.name, !tempRef)

endfunction
-- End of function definition for !!admMdbCpyName
