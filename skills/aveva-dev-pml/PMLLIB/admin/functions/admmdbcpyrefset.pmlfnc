--
--
-- Description:
-- Function to set the current dbref to be the source for the
-- MDB Copy form.
-- Function to be replaced by method !!admMdbCpy.refSet(DBREF)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       MDB to use as target.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admMdbCpyRefSet(!dbRef is DBREF)

  -- Check that the element is an MDB
  if (!dbRef.type neq 'MDB') then
    return error
  endif

  !!admMdbCpy.dbRef  = !dbRef
endfunction
-- End of function definition for !!admMdbCpyRefSet
