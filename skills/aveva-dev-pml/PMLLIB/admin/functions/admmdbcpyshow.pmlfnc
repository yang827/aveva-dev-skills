--
-- Description:
-- Function to display form if hidden, or hide form if displayed.
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
--
------------------------------------------------------------------------

-- Define function
define function !!monSelPrjDisplay()

  -- Check shown status
  if (undefined(!!selectProject)) then
    show !!selectProject
  else
    if (!!selectUser.shown()) then
      hide !!selectProject
    else
      show !!selectProject
    endif
  endif

endfunction
-- End of function definition for !!monSelPrjDisplay
