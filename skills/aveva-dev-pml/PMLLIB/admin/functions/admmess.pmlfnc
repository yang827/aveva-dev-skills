--
--
-- Description:
-- Function to send PDMS messages to selected groups or pdms users.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admMess()

  -- Initialise variables
  !group       = !!admMess.toType.selection('rtext')
  !message     = !!admMess.message.val
  !messCommand = ARRAY()
  !toList      = ARRAY()

  -- Check to see if user has set a message
  if (!message.empty()) then
    !!messageFile.error(141, 013)
  endif

  -- Perform actions based on group
  if (!group eq 'FREEUSER') then

    !toList.append('FREEUSER')

  elseif (!group eq 'ALL') then

    !toList.append('ALL')

  elseif (!group eq 'TEAM') then

    !teams       = !!admMess.to.selection('rtext')
    !teamBlock   = object BLOCK(|'TEAM ' + !teams[!evalIndex].dbRef().name.substring(3)|)
    !toList      = !teams.evaluate(!teamBlock)

  elseif (!group eq 'USER') then

    !users       = !!admMess.to.selection('rtext')
    !userBlock   = object BLOCK(|'USER ' + !users[!evalIndex].dbRef().name.substring(2)|)
    !toList      = !users.evaluate(!userBlock)

  endif

  -- Check to see that we have recipients
  if (!toList.unset()) then
    !!messageFile.error(141, 014)
  endif

  -- Check to see if we have selected locations (on-line only)
  if (!!admMess.online) then
    !locations   = !!admMess.locn.selection('rtext')
    if (!locations.unset()) then
      !!messageFile.error(141, 702)
    endif
  endif

  -- Build Message Commands to send
  do !i indices !toList

    if (!!admMess.online.not() or !group eq |USER|) then

      -- Standard or offline projects
      !messCommand.append('MESSAGE ' + !toList[!i] + ' |' + !message + '|')

    else

      -- Global On-line locations (global message system)
      do !j values !locations
        !messCommand.append('REMOTEMESSAGE '+!j.dbRef().name+' '+!toList[!i]+' |'+!message+'|')
      enddo

    endif

  enddo

  -- Send the messages
  do !i indices !messCommand

    $!messCommand[$!i]
    handle (1,129)
      -- User XXX is not currently in project
      !!messageFile.error(141, 325, !toList[!i].part(2))
    elsehandle (1,501)

      -- Cannot contact global daemon
      !!messageFile.error(141, 734)
      handle (06, 734)
        -- Dummy handle
      endhandle

    endhandle

  enddo


endfunction
-- End of function definition for !!admMess
