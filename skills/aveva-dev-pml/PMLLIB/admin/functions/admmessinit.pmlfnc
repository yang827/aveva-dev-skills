--
--
-- Description:
-- Function to initialise the !!admMess form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admMessInit()

  -- Initialise variables
  !locArray      = ARRAY()

  -- Initialise form gadgets
  !!admMess.message.val  = ||

  -- Restore gadget values
  if (!!admMess.typeVal.set()) then
    !!admMess.toType.select('rtext', !!admMess.typeVal)
  endif
  if (!!admMess.sortVal.set()) then
    !!admMess.sort.select('rtext', !!admMess.sortVal)
    !!admMess.filter.val = !!admMess.filterVal
  endif

  -- If this is a global project collect locations
  if (!!admMess.online) then

    -- Only initialise the list if this is an on-line location
    !current       = !!dbrGlbCurLocRf()

    -- Add on-line locations to the list
    !!ce           = !!dbrAdminGetWorld('LOC')
    !clause        = 'ICONN eq 1 and LINIT'
    !locations     = !!collectAllFor('LOC', !clause, !!ce)
    call !!adminLocnTxtList(!locations,!!admMess.locn)

    -- Select the current location
    !locArray.append(!current.string())
    !!admMess.locn.select('rtext',!locArray)

  endif

  -- Call function to initialise the list
  call !!admMessType()

endfunction
-- End of function definition for !!admMessInit
