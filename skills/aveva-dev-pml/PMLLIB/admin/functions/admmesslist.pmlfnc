--
--
-- Description:
-- Function to control the contents of the list gadget for message
-- recipients in the Message form.
-- Function to be replaced by method !!admMess.list()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admMessList()

  -- Initialise variables
  !group    = !!admMess.toType.selection('rtext')
  !current  = !!ce

  -- Preserve the sort and filter values
  if (!!admMess.filter.val.empty()) then
    !!admMess.filter.val = |*|
  endif
  !!admMess.sortVal   = !!admMess.sort.selection('rtext')
  !!admMess.filterVal = !!admMess.filter.val

  -- List elements by type
  if (!group eq 'TEAM') then

    -- Collect all the project teams
    !!ce      = !!dbrAdminGetWorld('TEAM')
    !dbRefs   = !!collectAllFor('TEAM','',!!ce)

    -- Display the values
    !showRefs = !!adminFilterSort(!dbRefs,!!admMess.sort,!!admMess.filter)
    call !!adminTeamTxtList(!showRefs,!!admMess.to,!!admDisplayConfig.fmtTeamGet(),!!admDisplayConfig.eleTypeGet())

  elseif (!group eq |USER|) then

    -- Collect all the project users
    !!ce      = !!dbrAdminGetWorld('USER')
    !dbRefs   = !!collectAllFor('USER','',!!ce)

    -- Display the values
    !showRefs = !!adminFilterSort(!dbRefs,!!admMess.sort,!!admMess.filter)
    call !!adminUserTxtList(!showRefs,!!admMess.to,!!admDisplayConfig.fmtUserGet(),!!admDisplayConfig.eleTypeGet())

  else

    -- Unset sort values
    !!admMess.sortVal   = STRING()
    !!admMess.filterVal = STRING()

  endif

  -- Restore the database position
  !!ce      = !current

endfunction
-- End of function definition for !!admMessList
