--
--
-- Description:
-- Callback function to a user selection of a type of message.
-- Function to be replaced by method !!admMess.cbType()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admMessType()

  -- Initialise variables
  !group  = !!admMess.toType.selection('rtext')

  -- Preserve the message type
  !!admMess.typeVal  = !group

  -- Perform setup of form based on group
  if (!group eq |FREEUSER| or !group eq |ALL|) then

    !!admMess.to.clear()
    !!admMess.sort.active    = false
    !!admMess.filter.active  = false
    !!admMess.all.active     = false
    !!admMess.clear.active   = false
    if (!!admMess.online) then
      !!admMess.curLocn.active = true
      !!admMess.allLocn.active = true
      !!admMess.clrLocn.active = true
      !!admMess.locn.active    = true
    endif

  elseif (!group eq |TEAM|) then

    -- Set-up form gadgets
    !!admMess.to.clear()
    !!admMess.sort.active    = true
    !!admMess.filter.active  = true
    !!admMess.all.active     = true
    !!admMess.clear.active   = true
    if (!!admMess.online) then
      !!admMess.curLocn.active = true
      !!admMess.allLocn.active = true
      !!admMess.clrLocn.active = true
      !!admMess.locn.active    = true
    endif

    -- Set sort gadget values
    call !!admTeamSortGadg(!!admMess.sort)

    -- Set the filter gadget
    !!admMess.filter.val     = |*|

    -- Collect all the project teams
    !current  = !!ce
    !!ce      = !!dbrAdminGetWorld('TEAM')
    !dbRefs   = !!collectAllFor('TEAM','',!!ce)
    !showRefs = !!adminFilterSort(!dbRefs,!!admMess.sort,!!admMess.filter)
    call !!adminTeamTxtList(!showRefs,!!admMess.to,!!admDisplayConfig.fmtTeamGet(),!!admDisplayConfig.eleTypeGet())
    !!ce      = !current

  elseif (!group eq |USER|) then

    -- Set-up form gadgets
    !!admMess.to.clear()
    !!admMess.sort.active    = true
    !!admMess.filter.active  = true
    !!admMess.all.active     = true
    !!admMess.clear.active   = true
    if (!!admMess.online) then
      !!admMess.curLocn.active = false
      !!admMess.allLocn.active = false
      !!admMess.clrLocn.active = false
      !!admMess.locn.active    = false
      !!admMess.locn.clearSelection()
      !!admMess.locn.select('rtext',!!dbrGlbCurLocRf().string())
    endif

    -- Set sort gadget values
    call !!admUserSortGadg(!!admMess.sort)

    -- Set the filter gadget
    !!admMess.filter.val     = |*|

    -- Collect all the project users
    !current  = !!ce
    !!ce      = !!dbrAdminGetWorld('USER')
    !dbRefs   = !!collectAllFor('USER','',!!ce)
    !showRefs = !!adminFilterSort(!dbRefs,!!admMess.sort,!!admMess.filter)
    call !!adminUserTxtList(!showRefs,!!admMess.to,!!admDisplayConfig.fmtUserGet(),!!admDisplayConfig.eleTypeGet())
    !!ce      = !current

  endif


endfunction
-- End of function definition for !!admMessType
