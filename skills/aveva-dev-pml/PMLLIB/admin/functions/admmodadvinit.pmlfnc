-- Created:         Tue Nov 18 16:28:35 GMT 1997
--
--
-- Description:
-- Function to initialise the Advance Module Settings form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModAdvInit()

  -- Initialise variables
  !curPos  = !!ce
  !dbRef   = !!admModDefRefGet()
  !gadgets = !!admModAdv.gadgets

  -- Reset all gadgets to unset mode
  do !gadget values !gadgets
    $!<gadget>.select('rtext','unset')
  enddo

  -- Reset the default gadget
  call !!admTypeDbLoad(!!admModAdv.default)
  !dText  = !!admModAdv.default.dText
  !rText  = !!admModAdv.default.rText
  !dText.append('Unset')
  !rText.append('unset')
  !!admModAdv.default.dText = !dText
  !!admModAdv.default.rText = !rText
  !!admModAdv.default.select('rtext','unset')

  -- Set the modules name
  !!admModAdv.name.val = !dbRef.name.after('/').before('*')
  if (!!admModAdv.name.val inset('ADMIN','GLOBALDAEMON','MONITOR','ISODRAW')) then
    !!admModAdv.default.active = false
  else
    !!admModAdv.default.active = true
  endif

  -- Set the buffer size
  !!ce     = !dbRef
  CMBU 1
  handle any
    -- Module has the default buffer
    !!admModAdv.buffer.val = |Default|
  elsehandle none
    -- Set the buffer values
    !format     = object FORMAT()
    !format.dp  = 0
    !buffer     = !!ce.bufs * 1000
    !!admModAdv.buffer.val = !buffer.string(!format)
  endhandle

  -- Set database modes
  !!ce     = !dbRef
  !clause  = 'TYPE eq |CMMO|'
  !cmmo    = !!collectAllFor('',!clause,!!ce)

  -- Set gadget values for database types
  do !ref values !cmmo

    !!ce     = !ref
    if (!!ce.modeDb eq 'Default') then
        call !!admTypeDbLoad(!!admModAdv.default)
        !!admModAdv.default.select('rtext',!!ce.tyna)
        handle ANY
          -- This could be a TRAN dB which is only available in global projects
        endhandle
    else
        !gadget  = |!!admModAdv.|+ !!ce.tyna
        $!<gadget>.select('rtext',!!ce.modeDb)
        handle ANY
         -- This could be a TRAN dB which is only available in global projects
        endhandle
    endif

  enddo

  -- Restore database position
  !!ce     = !curPos
endfunction
-- End of function definition for !!admModAdvInit
