-- Created:         Mon Nov 24 15:26:01 GMT 1997
--
--
-- Description:
-- Callback function to the Mode DB Type gadget on the Advanced
-- Module Settings form. Prevents user setting gadget to Unset.
-- Function to be replaced by method !!admModAdv.cbMode(GADGET, STRING)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Default Db Type option gadget
--    2   R      STRING      Type of database
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModAdvMode(!gadget is GADGET, !dbType is STRING)

  -- Initialise variables
  !curPos     = !!ce
  !dbRef      = !!admModDefRefGet()
  !module     = !dbRef.name.after('/').before('*')
  !selection  = !gadget.selection('RTEXT')

  -- Return if the selection is not 'unset'
  if (!selection neq 'unset') then
    return
  endif

  -- Only databases without a Default DB may use the
  -- 'unset' option. Syntax does not allow it to be unset.
  !!ce        = !dbRef
  !clause     = 'TYNA eq |'+ !dbType +'| and MODEDB neq |Default|'
  !modeRef    = !!collectAllFor('CMMO',!clause,!!ce)

  if (not !modeRef.empty()) then

    -- Database already has a default DB
    !gadget.select('rtext', !modeRef[1].modeDb)

    -- Raise error
    !!messageFile.error(141, 26,  !module,  !dbType,  !modeRef[1].modeDb)
    handle (06, 026)
      -- Dummy handle
    endhandle

  endif

  -- Restore database position
  !!ce        = !curPos

endfunction
-- End of function definition for !!admModAdvMode
