--
--
-- Description:
-- Callback function to copy a module definition to a new module.
-- Function to be replaced by method !!admModCpy.cbOk()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModCpy()

  -- Initialise variables
  !source      = !!admModCpyRefGet()
  !targetName  = _name.val
  !targetNumb  = _numb.val

  -- Get source module name
  !sourceName  = !source.name.after('/').before('*')

  -- Copy the module
  !command     = |COPY MODULE |+ !sourceName +| TO |+ !targetNumb +| |+ !targetName
  $!command
  handle any

    -- Non specific error coping module
    !!messageFile.error(141, 22, !sourceName, !!error.text)

  endhandle

  -- Get a DBREF for the new module
  !elemName    = |/|+ !targetName +|*|
  !!ce         = !elemName.dbRef()

  -- Refresh the module definition form
  call !!admModDefRefSet(!!ce)
  call !!refreshDependent(!!admModDef)

endfunction
-- End of function definition for !!admModCpy
