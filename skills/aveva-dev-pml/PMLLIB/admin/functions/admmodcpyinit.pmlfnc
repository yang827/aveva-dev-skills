--
-- Description:
-- Function to initialise the Copy Module form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModCpyInit()

  -- Initialise variables
  !module               = !!admModDefRefGet()

  -- Set the Source Module
  call !!admModCpyRefSet(!module)

  -- Update form gadgets
  !!admModCpy.numb.val  = ||
  !!admModCpy.name.val  = |unset|

  -- Set the focus to Number gadget
  !!admModCpy.numb.setFocus()

endfunction
-- End of function definition for !!admModCpyInit
