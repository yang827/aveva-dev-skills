--
--
-- Description:
-- Callback function to Name gadget on the Copy Module form.
-- Function to be replaced by method !!admModCpy.cbName(GADGET)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModCpyName(!gadget is GADGET)

  -- Initialise variables
  !name        = !gadget.val

  -- Check that the name is not unset or empty
  if (!name.empty()) then
    !gadget.val  = |unset|
    !gadget.setFocus()
    return
  elseif (!name eq |unset|) then
    !gadget.setFocus()
    return
  endif

  -- Capitalise the input
  !name        = !name.upcase()

  -- Check for prefixed '/' or suffixed '*'
  if (!name.substring(1,1) eq '/') then
    !name        = !name.substring(2)
  endif
  if (!name.substring(-1,1) eq '*') then
    !name        = !name.substring(1,(!name.length() - 1))
  endif

  -- Module names must be a WORD. Call the Word Checker
  !check       = !!admChkWord(!name)
  if (!check.not()) then

    -- Name is not a WORD
    !gadget.val  = |unset|
    !gadget.setFocus()
    !!messageFile.error(141, 021,  $
       !!messageFile.messageString(141, 820), !name)

  endif

  -- Check that the Module name does not exists
  !module      = |/|+ !name +|*|
  !module.dbRef()
  handle any

    -- Good, module does not exists
    !gadget.val  = !name

  elsehandle none

    -- Bad Module already exists
    !gadget.val  = |unset|
    !gadget.setFocus()
    !!messageFile.error(141, 020,  !name)

  endhandle

endfunction
-- End of function definition for !!admModCpyName
