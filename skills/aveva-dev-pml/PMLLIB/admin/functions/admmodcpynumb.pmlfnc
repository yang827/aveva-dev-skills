--
--
-- Description:
-- Callback function to the Number gadget on the Copy Module form.
-- Function to be replaced by method !!admModCpy.cbNumb(GADGET)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Number gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModCpyNumb(!gadget is GADGET)

  -- Initialise variables
  !number      = !gadget.val.real()
  !modules     = !!admModDefModGet()

  -- Get all the module numbers
  !mBlock      = object BLOCK(|!modules[!evalIndex].smno|)
  !numbArray   = !modules.evaluate(!mBlock)

  -- See if the input number has been used
  if (!numbArray.findFirst(!number).set()) then

    -- Number already used
    !!messageFile.error(141, 019,  !number.string())
    handle (06, 019)
      -- Dummy handle
    endhandle
    !gadget.val  = ||
    !gadget.setFocus()

  endif

endfunction
-- End of function definition for !!admModCpyNumb
