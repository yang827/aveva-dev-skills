--
--
-- Description:
-- Function to set the DBREF of the source Module.
-- Function to be replaced by method !!admModCpy.refSet(DBREF)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of module (%RUNF)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModCpyRefSet(!dbRef is DBREF)

  -- Check that the DBREF is a module
  if (!dbRef.unset() or !dbRef.type neq 'RUNF') then
    return error
  endif

  -- Store the value
  !!admModCpy.dbRef  = !dbRef

  -- Change the form title
  !modName               = !dbRef.name.after('/').before('*')
  !modNumb               = !dbRef.smno.string()
  !!admModCpy.formTitle  = |Copy Module: |+ !modName +| (|+ !modNumb +|)|

endfunction
-- End of function definition for !!admModCpyRefSet
