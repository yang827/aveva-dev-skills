--
--
-- Description:
-- Callback function to the apply button in the Module Definition form.
-- Function to be replaced by method !!admModDef.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModDef()

  -- Initialise variables
  !curRef    = !!ce
  !modRef    = !!admModDefRefGet()
  !module    = !modRef.name.after('/').before('*')

  -- Get the current module settings
  !!ce       = !modRef
  !curSecu   = !!ce.secu
  CMRE 1
  handle none
     !curRunf  = !!ce.fnam.substring(2)
  elsehandle any
     !curRunf = 'unset'
  endhandle
  !!ce       = !modRef
  CMMA 1
  handle any
    !curMacro  = 'unset'
  elsehandle none
    !curMacro  = !!ce.fname.substring(2)
  endhandle

  -- Get the current form setting
  !security  = _security.selection('rtext')
  !runfile   = _runf.val
  !runfile   =  !runfile.before('.exe')
  !macro     = _macro.val

  -- Change the module security
  if (!curSecu neq !security) then

    !command   = |EDIT MODULE |+ !module +| SECURITY |+ !security
    $!command

  endif

  -- Change the module runfile
  if (!curRunf neq !runfile or !runfile.lowcase().trim() neq 'unset') then

    !command   = |EDIT MODULE |+ !module +| RESUME /|+ !runfile
    $!command

  endif

  -- Change the module Imacro
  if (!curMacro neq !macro) then

    if (!macro eq 'unset') then
      !command   = |EDIT MODULE |+ !module +| IMACRO DELETE|
    else
      !command   = |EDIT MODULE |+ !module +| IMACRO /|+ !macro
    endif
    $!command

  endif

  -- Restore the database position
  !!ce       = !curRef
  handle ANY
  endhandle

endfunction
-- End of function definition for !!admModDef
