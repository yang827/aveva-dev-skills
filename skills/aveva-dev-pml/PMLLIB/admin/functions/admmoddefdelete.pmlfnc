--
--
-- Description:
-- Callback function to the delete button on the Module Definition
-- form. Function deletes the selected module.
-- Function to be replaced by method !!admModDef.cbDelete()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModDefDelete()

  -- Initialise variables
  !dbRef     = !!admModDefRefGet()
  !name      = !dbRef.name.after('/').before('*')

  -- Check for element being already claimed

  if (not !!dbRefUpdate (!dbRef)) then
    !!alert.error (!!error.text)
    return
  endif

  -- Construct the command
  !command   = |DELETE MODULE |+ !name

  -- Get user to confirm module deletion
  !answer    = !!alert.confirm(!!messageFile.messageString(141, 23, $
     !name))
  if (!answer.boolean()) then

    -- Delete the module
    $!command
    handle any

      -- Non-specific error on delete
      !!messageFile.error(141, 24, !name, !!error.text)

    endhandle

    -- Update the form
    call !!admModDefRefSet(object DBREF())
    call !!refreshDependent(!!admModDef)

  endif

endfunction
-- End of function definition for !!admModDefDelete
