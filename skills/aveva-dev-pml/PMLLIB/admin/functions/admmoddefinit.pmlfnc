--
--
-- Description:
-- Function to initialise the module definition form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModDefInit()

  -- Get defined modules
  call !!admModDefModSet()

  -- Restore sort gadget
  if (!!admModDef.sortVal.set()) then
    !!admModDef.sort.select('rtext',!!admModDef.sortVal)
  endif

  -- List modules information
  call !!admModDefModList()

  -- Get the module information
  call !!admModDefRefSet(object DBREF())
  call !!admModDefModSel()

endfunction
-- End of function definition for !!admModDefInit
