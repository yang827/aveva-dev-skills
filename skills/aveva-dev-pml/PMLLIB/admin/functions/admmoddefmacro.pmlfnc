--
--
-- Description:
-- Callback function to the Macro gadget on the Module Definition form.
-- Function to be replaced by method !!admModDef.cbMacro(GADGET)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Macro gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModDefMacro(!gadget is GADGET)

  -- Initialise variables
  !dbRef       = !!admModDefRefGet()
  !macro       = !gadget.val

  -- See if the macro is unset
  if (!macro.empty() or !macro eq 'unset') then

    -- Reset the gadget value
    !gadget.val  = 'unset'
    return

  endif

  -- Check that the specified file exists
  !file        = !!file(!macro)
  if (!file.exists().not()) then

    -- File does not exist
    !!messageFile.warning(146, 9, !macro)

    -- Restore the current macro
    !!ce         = !dbRef
    CMMA 1
    handle none

      -- Take current macro
      !gadget.val  = !!ce.fnam.substring(2)

    elsehandle any

      -- There is no macro
      !gadget.val  = 'unset'

    endhandle

  endif

endfunction
-- End of function definition for !!admModDefMacro
