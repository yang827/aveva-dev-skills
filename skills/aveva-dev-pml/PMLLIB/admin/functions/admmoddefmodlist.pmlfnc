--
--
-- Description:
-- Function to control the contents of the Module list in the
-- Module Definition form.
-- Function to be replaced by method !!glbModDef.modList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModDefModList()

  -- Initialise variables
  !modules    = !!admModDefModGet()
  !select     = !!admModDefRefGet()
  !sortValue  = !!admModDef.sort.selection('rtext')
  !modName    = ARRAY()
  !modNumb    = ARRAY()
  !dText      = ARRAY()
  !rText      = ARRAY()

  -- Save the sort value
  !!admModDef.sortVal  = !sortValue

  -- Collect information about modules
  do !mod values !modules

    !modName.append(!mod.name.substring(2).before('*'))
    !modNumb.append(!mod.smno)

  enddo

  -- Sort the values
  !nameOrder  = !modName.sortedIndices()
  !numbOrder  = !modNumb.sortedIndices()

  -- Clear the list
  !!admModDef.module.clear()

  -- Construct texts
  if (!sortValue eq 'NAME') then
    !heading[1] = 'Name' !heading[2] = 'Number'
    -- Text order is module name
    do !index values !nameOrder

      !number     = !modNumb[!index].string()
      !text = !modName[!index]  & '	' & !number

      !dText.append(!text)
      !rText.append(!modules[!index].string())

    enddo

  else
    !heading[1] = 'Number' !heading[2] = 'Name'
    -- Text order is module number
    do !index values !numbOrder

      !number     = !modNumb[!index].string()
      !text       = !number  & '	' & !modName[!index]

      !dText.append(!text)
      !rText.append(!modules[!index].string())

    enddo

  endif

  -- Assign list values
  !!admModDef.module.setHeadings(!heading)
  !!admModDef.module.dText = !dText
  !!admModDef.module.rText = !rText

  -- Attempt to reselect the selected module
  if (!select.set()) then
    !!admModDef.module.select('rtext', !select.string())
    handle any
      -- Shouldn't happened
    endhandle
  endif

endfunction
-- End of function definition for !!admModDefModList
