--
--
-- Description:
-- Function to act as callback to the user selection of a Module
-- in the Module Definition form.
-- Function to be replaced by method !!admModDef.modSel()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModDefModSel()

  -- Initialise variables
  !module   = !!admModDef.module.selection('rtext').dbRef()

  -- Set the new current module
  call !!admModDefRefSet(!module)

  -- Collect information about the module
  !!ce      = !module
  !name     = !!ce.name.after('/').before('*')
  !security = !!ce.secu
  !number   = !!ce.smno

  -- Executable
  CMRE 1
  handle none
     !runfile  = !!ce.fnam.substring(2)
  elsehandle any
     !runfile = |unset|
  endhandle

  -- Macro
  !!ce      = !module
  CMMA 1
  handle none
    !macro    = !!ce.fnam.substring(2)
  elsehandle any
    !macro    = |unset|
  endhandle

  -- Update form gadgets
  !!admModDef.name.val    = !name
  !!admModDef.numb.val    = !number.string()
  !!admModDef.runf.val    = !runfile
  !!admModDef.macro.val   = !macro
  !!admModDef.security.select('rtext',!security)

  -- Update other forms if displayed

  if (Undefined(!!admModCpy)) then
    !!loadForm ('admModCpy')
  endif
  if (Undefined(!!admModAdv)) then
    !!loadForm ('admModAdv')
  endif

  call !!refreshDependent(!!admModCpy)
  call !!refreshDependent(!!admModAdv)

endfunction
-- End of function definition for !!admModDefModSel
