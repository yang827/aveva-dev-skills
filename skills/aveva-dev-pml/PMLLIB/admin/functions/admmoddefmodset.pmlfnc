--
--
-- Description:
-- Function to collect and store all the RUNF element for use in the
-- Module Definition form.
-- Function to be replaced by method !!admModDef.modSet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModDefModSet()

  -- Initialise variables
  !modules    = ARRAY()
  !mm = object AVEVAMODULEMANAGER()
  if (!mm.currentProductName().upcase().eq('HULL & OUTFITTING')) then
    !marine = TRUE
  else
    !marine = FALSE
  endif

  -- Collect all modules
  !!ce        = !!dbrAdminGetWorld('STAT')
  !modules    = !!collectAllFor('RUNF','',!!ce)

  -- remove marine modules if working in plant and vice versa

  do !i from 1 to !modules.size()
    !ob = !modules[!i]
    !obName = !ob.name.substring(2).before('*').upcase()
    if (!marine) then
      if (!obName inset('DESIGN','DRAFT')) then
        !modules.deleteFrom(!i, 1)
      endif
      -- Remove design and draft
    else
      -- Remove Outfitting and hull
      if (!obName inset('OUTFITTING','OUTFITTINGDRAFT','HULLDESIGN','MARINEDRAFTING')) then
        !modules.deleteFrom(!i, 1)
      endif
    endif
  enddo

  --and finally get rid of any gaps in the array
  !modules.compress()
  -- Store the array
  !!admModDef.modArray  = !modules

endfunction
-- End of function definition for !!admModDefModSet
