-- Description:
-- Function to return the module currently being edited in the
-- Module Definition form.
-- Function to be replaced by method !!admModDef.refGet() is DBREF
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of module (%RUNF)
--
------------------------------------------------------------------------

-- Define function
define function !!admModDefRefGet() is DBREF

  -- Return the value
  return !!admModDef.modRef

endfunction
-- End of function definition for !!admModDefRefGet
