--
--
-- Description:
-- Function to set and store the Module that is currently being
-- modified in the Module Definition form.
-- Function to be replaced by method !!admModDef.refSet(DBREF)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of Module (%RUNF)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModDefRefSet(!dbRef is DBREF)

  -- Check that the element is a module
  if (!dbRef.set() and !dbRef.type neq 'RUNF') then
    return
  endif

  -- Store the value
  !!admModDef.modRef  = !dbRef

endfunction
-- End of function definition for !!admModDefRefSet
