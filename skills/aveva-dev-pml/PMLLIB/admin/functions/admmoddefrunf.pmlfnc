--
--
-- Description:
-- Callback function to the Runfile gadget on the Module Definition form.
-- Function to be replaced by method !!admModDef.cbRunf(GADGET)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Runfile gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admModDefRunf(!gadget is GADGET)

  -- Initialise variables
  !curPos      = !!ce
  !dbRef       = !!admModDefRefGet()
  !runfile     = !gadget.val
  !runfileExe  = !runfile & '.exe'
  !file        = !!file(!runfile)
  !fileExe     = !!file(!runfileExe)

  -- Check that the specified file exists
  if (!file.exists().not() and !fileExe.exists().not()) then

    -- File does not exist
    !!messageFile.warning(146, 9, !runfile)

    -- Restore the current macro
    !!ce         = !dbRef
    CMRE 1
    handle none
      !gadget.active = true
      !gadget.val  = !!ce.fnam.substring(2)
    elsehandle any
      if (!!ce.name eq '/GLOBALDAEMON*') then
        !gadget.active = false
      endif
      !gadget.val = |unset|
    endhandle

  endif

  -- Restore database position
  !!ce         = !curPos

endfunction
-- End of function definition for !!admModDefRunf
