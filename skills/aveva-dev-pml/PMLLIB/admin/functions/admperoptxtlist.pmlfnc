--
--
-- Description:
-- A function to display admPerops in a list Gadget. admPerops are a special DB
-- independent data type
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of DBREF of database elements
--    2   RW     GADGET      List gadget to populate
--    3   R      BOOLEAN     User PEROP line header "<PEROP>"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!admPeropTxtList(!dbRefArray is ARRAY, !list is GADGET,!useHeader is BOOLEAN)

  -- Initialise variables
  !dText       = ARRAY()
  !rText       = ARRAY()

  -- Check that we have some PEROPs to process
  if (!dbRefArray.unset()) then
    !list.clear()
    return
  endif

  -- Loop through array
  do !i indices !dbRefArray

    -- Collect attributes
    !name[!i]   = !dbRefArray[!i].name.substring(2)
    !acrMes[!i] = !dbRefArray[!i].acrMessage
    if (!acrMes[!i].empty()) then
      !acrMes[!i] = |unset|
    endif
--     if(!dbRefArray[!i].unset() OR !dbRefArray[!i].affirm)then
--       !mode[!i] = |(+)|
--     else
--       !mode[!i] = |(-)|
--     endif

  enddo

  -- Calculate column widths
  !cwName = !name.width()

    -- Build Display text
    if(!useHeader) then
      !initialText = |<PEROP> |
    else
      !initialText = ||
    endif

  -- Loop through array and build texts
  do !i indices !dbRefArray

    -- Build Masks
    !name[!i] = !name[!i] + |                                |

--    !displayText  = !initialText + | | + !mode[!i] + | | + !name[!i].substring(1,!cwName) + |  | + !acrMes[!i]
    !displayText  = !initialText + !name[!i].substring(1,!cwName) + |  | + !acrMes[!i]

    -- Construct texts
    !dText.append(!displayText)
    !rText.append(!dbRefArray[!i].dbRef.string())

  enddo

  -- Assign elements to the list gadget
  !list.dText   = !dText
  !list.rText   = !rText

endfunction
-- End of function definition for !!admPeropTxtList
