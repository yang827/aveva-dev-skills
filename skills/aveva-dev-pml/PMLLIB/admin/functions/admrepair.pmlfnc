--
-- Description:
-- Function to show the Repair System Database form if required
--
------------------------------------------------------------------------
--
-- Function:      .admRepair()
--
-- Description: Function to show the Repair System Database form if required
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     Do we need a message if no repair is required
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!admRepair(!noRepairMessage is BOOLEAN)

  var !repairRequired REPAIRREQUIRED

  if (!repairRequired.real() eq 1) then
    if (!noRepairMessage) then
      !!alert.message('The System Database requires just 1 repair.')
      if (defined(!!admRepair) and !!admRepair.noneCheck) then
        !answer = false
      else
        !answer = true
      endif
    else
      !answer = !!alert.confirm('The System Database requires a repair. Do you wish to repair it now?')
    endif
  elseif (!repairRequired.real() gt 1) then
    if (!noRepairMessage) then
      !!alert.message('The System Database requires ' & !repairRequired & ' repairs.')
      if (defined(!!admRepair) and !!admRepair.noneCheck) then
        !answer = false
      else
        !answer = true
      endif
    else
      !answer = !!alert.confirm('The System Database requires ' & !repairRequired & ' repairs. Do you wish to repair them now?')
    endif
  else
    -- No repairs required
    if (!noRepairMessage) then
      !!alert.message('The System Database does NOT require any repair.')
    endif
    return
  endif

  if (!answer.boolean()) then
    show !!admRepair
  endif

endfunction
-- End of function definition for .admRepair()
