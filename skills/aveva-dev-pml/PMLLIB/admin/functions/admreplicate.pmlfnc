--
--
-- Description:
-- Function to manage the REPLICATE command in terms of displayed
-- user interface forms.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      REPLICATE Function to perform.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admReplicate(!command is STRING)
Import 'pmlfilebrowser'
handle any
endhandle

  -- Display forms based on argument
  if (!command eq 'PROJECT') then

    -- Replicate entire project structure
    show !!admReplPrj

  elseif (!command eq 'SYSTEM') then

    -- Use the standard form of REPLICATE SYSTEM
    -- For a non-global project
    !directory   = |%PDMSUSER%|
    !seedFile    = |ReplicateProj.mac|
    !title       = |Replicate Project Structure|
    !exists      = false
    !callback    = |call !!admReplSystem(!!fileBrowser.file)|
    call !!fileBrowser(!directory, !seedFile, !title, !exists, !callback)

  elseif (!command eq 'STANDALONE') then

    -- Replicate location structure as though
    -- this were a stand alone project
    !directory   = |%PDMSUSER%|
    !seedFile    = |ReplicateProj.mac|
    !title       = |Replicate Location As Standalone Structure|
    !exists      = false
    !callback    = |call !!admReplStand(!!fileBrowser.file)|
    call !!fileBrowser(!directory, !seedFile, !title, !exists, !callback)

  elseif (!command eq 'SATELLITE') then

    -- Replicate location structure in terms of
    -- satellite information (USERS/MDBS etc.)
    !directory   = |%PDMSUSER%|
    !seedFile    = |ReplicateProj.mac|
    !title       = |Replicate Location As Satellite Structure|
    !exists      = false
    !callback    = |call !!admReplSatellite(!!fileBrowser.file)|
    call !!fileBrowser(!directory, !seedFile, !title, !exists, !callback)

  endif

endfunction
-- End of function definition for !!admReplicate
