--
--
-- Description:
-- Function copy the current project structure and data to a new
-- project.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admReplPrj()

  -- Initialise variables
  !project  = CURRENT PROJECT
  !target   = !!admReplPrj.target.val
  VAR !lock LOCK
  !answer = 'NO'

  -- Return on empty on unset target
  if (!target.empty() or !target eq 'unset') then
    return
  endif

  -- Check the project lock whilst process is working
  if (!lock eq 'Unlocked') then

    -- Project is unlocked, lock project whilst replication
    -- is in progress
    !answer   = !!alert.confirm(!!messageFile.messageString(141, 318, !project.code()))
    if (!answer.boolean()) then

      -- Lock the project
      call !!admLockProject(true)
      !!adminApplic.lock.val = 'Locked'
      !!adminApplic.lock.background = 3
      QUERY LOCK

    endif

  endif

  -- Set the prompt
  !!messageFile.prompt(141, 319, !project.code(), !target)

  -- Set the command
  !command  = |REPLICATE | + !target

  -- Execute the command
  call !!admCommand(!command)
  handle (1,17)

    -- File already exists
    !!ce      = !!dbrAdminGetWorld('WORLD')
    call !!prompt(0)
    !!messageFile.error(141, 321)

  elsehandle (1,54)

    -- Users still in project
    !!ce      = !!dbrAdminGetWorld('WORLD')
    call !!prompt(0)
    !!messageFile.error(141, 322)

  elsehandle any

    -- Non-specific error
    !!ce      = !!dbrAdminGetWorld('WORLD')
    call !!prompt(0)
    !!messageFile.error(141, 323, !!error.text)

  endhandle

  -- Dismiss the prompt
  call !!prompt(0)

endfunction
-- End of function definition for !!admReplPrj
