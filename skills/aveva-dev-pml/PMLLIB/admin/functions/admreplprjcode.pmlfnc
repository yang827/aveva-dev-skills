--
--
-- Description:
-- Function to check that the code entered is a valid 3 letter code
-- for a PDMS project, that has the correct EVAR's set but is not a
-- project that is currently in existence.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admReplPrjCode()

  -- Initialise values
  !code        = !!admReplPrj.target.val
  !occurrences  = REAL()

  -- Check that the value is set
  if (!code.empty() or !code eq 'unset') then

    -- Unset the value
    !!admReplPrj.target.val  = 'unset'
    return

  endif

  -- Check that the value 3 characters
  if (!code.length() lt 3) then

    -- Too few characters
    !!admReplPrj.target.val  = 'unset'
    !!messageFile.error(150, 47)

  elseif (!code.length() gt 3) then

    -- Too many characters
    !!messageFile.warning(150, 48, !code)
    !code        = !code.substring(1,3)

  endif

  -- Check that the string does not contain numeric values
  !occurrences  = !code.occurs('0')
  !occurrences  = !occurrences + !code.occurs('1')
  !occurrences  = !occurrences + !code.occurs('2')
  !occurrences  = !occurrences + !code.occurs('3')
  !occurrences  = !occurrences + !code.occurs('4')
  !occurrences  = !occurrences + !code.occurs('5')
  !occurrences  = !occurrences + !code.occurs('6')
  !occurrences  = !occurrences + !code.occurs('7')
  !occurrences  = !occurrences + !code.occurs('8')
  !occurrences  = !occurrences + !code.occurs('9')

  if (!occurrences gt 0) then

    -- Project code cannot contain numbers
    !!admReplPrj.target.val  = 'unset'
    !!messageFile.error(150, 49)

  endif

  -- Convert the 3-Char expression to Upper Case
  !code        = !code.upcase()


  -- Check that the value is not an project that already
  -- exists in the current users scope.
  --!projects    = PROJECTS
  --do !proj values !projects

    -- See if the code matches
    --if (!proj.code() eq !code) then

      -- Found a matching project - Replication not allowed
      --!!admReplPrj.target.val  = 'unset'
      --call !!setMessage(1,!code)
      --call !!error(06316)

    --endif

  --enddo


  -- Passed all the basic tests, check that we have all the
  -- Environment setup for the target project.

  -- Collect all the databases
  !!ce         = !!dbrAdminGetWorld('TEAM')
  !dbs         = !!collectAllFor('DB','',!!ce)
  !areaBlock   = object BLOCK(|'000' + !dbs[!evalIndex].area.string()|)
  !areas       = !dbs.evaluate(!areaBlock)
  !areas.unique()

  -- Construct array of required environment variables
  !evarArray   = !areas
  !evarArray.append('PIC')
  !evarArray.append('MAC')

  -- Process array of require environment variables
  do !value values !evarArray

    -- Create the EVAR to check
    !evarValue   = !!evar(!code + !value.substring(-3,3))

    -- Check the EVAR is set
    if (!evarValue.empty()) then

      -- Variable returns no value
      !!admReplPrj.target.val  = 'unset'
      !!messageFile.error(141, 320, !code + !value.substring(-3,3), !code)

    endif

    -- Check that the directory is empty
    !directory = !!directory(!evarValue)
    if (!directory.name.unset()) then

      -- UNIX directory does not exist
      !!admReplPrj.target.val  = 'unset'
      !!messageFile.error(146, 023, !evarValue)

    elseif (!directory.files.set()) then

      -- Directory contains files (Warn user)
      !!messageFile.warning(141, 317, !evarValue)

    endif

  enddo


  -- Passed all the tests okay, reset the gadget
  !!admReplPrj.target.val  = !code

endfunction
-- End of function definition for !!admReplPrjCode
