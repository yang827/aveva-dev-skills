--
--
-- Description:
-- Function to replicate the current locations structure as though it
-- were a satellite location. This only outputs USER, MDB and other
-- local data
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admReplSatellite(!file is FILE)

  -- Check to see if file exists
  if (!file.exists()) then

    -- See if the user wants to overwrite the file
    !answer    = !!alert.confirm(!!messageFile.messageString(146, 10, !file.fullname()))

    -- Return if answer is no
    if (!answer.boolean().not()) then
      return
    endif

    !filename  = !file.fullname()

  else

    !filename  = !file.name()

  endif

  -- Create the replication command
  !command   = |REPLICATE SYSTEM SATELLITE| + |"| + !filename + |"| + | OVERWRITE|

  -- Execute the command
  call !!admCommand(!command)
  handle any

    -- Non specific error when trying to replicate project structure
    !!messageFile.error(141, 315, !!error.text)

  endhandle


endfunction
-- End of function definition for !!admReplSatellite
