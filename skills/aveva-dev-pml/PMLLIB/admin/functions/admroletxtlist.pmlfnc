--
-- Description:
-- A function to create a list of text to show role
-- .
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of DBREF of database elements
--    2   RW     GADGET      List gadget to populate
--    3   R      BOOLEAN     User ROLE line header "<ROLE>"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!admRoleTxtList(!dbRefArray is ARRAY, !list is GADGET,!useHeader is BOOLEAN)

  !roleList = object ADMTEXTLIST()
  !roleList.addRoles(!dbRefArray, !useHeader, !list)

endfunction
-- End of function definition for !!admRoleTxtList
