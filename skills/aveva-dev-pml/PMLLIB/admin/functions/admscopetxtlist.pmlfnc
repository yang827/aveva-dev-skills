--
--
-- Description:
-- A function to generate a list of text to display scopes
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of DBREF of database elements
--    2   RW     GADGET      List gadget to populate
--    3   R      BOOLEAN     User SCOPE line header "<SCOPE>"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!admScopeTxtList(!dbRefArray is ARRAY, !list is GADGET,!useHeader is BOOLEAN)

  !scopeList = object ADMTEXTLIST()
  !scopeList.addScopes(!dbRefArray, !useHeader, !list)

endfunction
-- End of function definition for !!admScopeTxtList
