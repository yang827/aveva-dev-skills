-- Author:          Steve Wilson
-- Created:         13 July 2001
--
--
-- Description:
-- Sort the contents of a list gadget associated with stamp elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The sort gadget
--    2   R      GADGET      The list gadget to sort
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!admStampSort(!stampRefs is ARRAY, !sortGadget is GADGET, !listGadget is GADGET)

  -- Initialise variables
  !sortString = !sortGadget.selection()
  !selected = !listGadget.selection('RTEXT')
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Get stamp attribute data
  do !stamp val !stampRefs
    if (!sortString.eq('NAME')) then
      !dtext.append(!stamp.flnn)
    elseif (!sortString.eq('DESCRIPTION')) then
      !description = !stamp.desc
      if (!description.eq('')) then
        !dtext.append('Unset')
      else
        !dtext.append(!description)
      endif
    elseif (!sortString.eq('DATE')) then
      !setDat = !stamp.setDat
      if (!setDat.eq('')) then
        !dtext.append('Unset')
      else
        !dtext.append(!setDat)
      endif
    else
      !function = !stamp.func
      if (!function.eq('')) then
        !dtext.append('Unset')
      else
        !dtext.append(!function)
      endif
    endif
    !rtext.append(!stamp.string())
  enddo

  -- Sort the data
  !sorted = !dtext.sortedIndices()
  !dtext.sort()
  !rtext.reIndex(!sorted)

  -- Populate the list
  !listGadget.dtext = !dtext
  !listGadget.rtext = !rtext

  -- Reselect the previously selected stamp
  if (!selected.neq('')) then
    if (!listGadget.rtext.findFirst(!selected).unset().not()) then
      !listGadget.select('RTEXT',!selected)
    endif
  endif

endfunction
-- End of function definition
