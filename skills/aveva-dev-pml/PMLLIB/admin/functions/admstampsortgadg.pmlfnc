--
-- Author:          Steve Wilson
-- Created:         13 July 2001
--
--
-- Description:
-- Set the contents of a sort gadget associated with stamp elements.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget to populate
--    2   R      STRING      SHORT or LONG dtexts
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!admStampSortGadg(!gadget is GADGET,!option is STRING)

  -- Ensure that gadget is an LIST gadget
  if (!gadget.type().upCase().neq('LIST')) then
    return
  endif

  -- Initialise variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Assign values to the gadget
  -- Dtexts
  if (!option.eq('LONG')) then
    !dtext.append('Name')
    !dtext.append('Set Date')
    !dtext.append('Function')
    !dtext.append('Description')
    !gadget.dtext  = !dtext
  else
    !dtext.append('Name')
    !dtext.append('Date')
    !dtext.append('Func')
    !dtext.append('Desc')
    !gadget.dtext  = !dtext
  endif

  -- Rtexts
  !rtext.append('NAME')
  !rtext.append('DATE')
  !rtext.append('FUNCTION')
  !rtext.append('DESCRIPTION')
  !gadget.rtext  = !rtext

endfunction
-- End of function definition
