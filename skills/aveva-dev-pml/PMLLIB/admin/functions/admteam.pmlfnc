--
--
-- Description:
-- Function to create or modify and TEAM element. The values for the
-- element are taken from the TEAM Definition form.
-- Function to be replaced by method !!admTeam.cbApply()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeam()

  -- Initialise variables
  !dbRef         = !!admTeamRefGet()
  !mode          = !!admTeamModeGet()
  !updateFlag    = false

  -- Check that team name is not unset
  if (_name.val eq 'unset') then

    -- Reset name if modify mode
    if (!mode eq 'Modify') then
      _name.val    = !dbRef.name.substring(3)
    endif

    -- Raise error
    _name.setFocus()
    !!messageFile.error(141, 051, !mode.lowcase())

  endif

  -- Action attributes depending on mode
  if (!mode eq 'CREATE') then

    -- Navigate to team world
    !teamName      = |/*| + _name.val
    !description   = _desc.val

    -- Create new TEAM element
    !!ce           = !!dbrAdminGetWorld('TEAM')
    -- *** OLD PML SYNTAX
    call !!admCommand(|NEW TEAM $!teamName|)
    handle (41,12)

      -- Team already exists
       call !!admCommand(|DELETE TEAM|)
      !!messageFile.error(141, 052, _name.val)
      _name.val      = |unset|

    endhandle

    -- Set the new element description
    if (!description neq 'unset') then
      !!ce.description = !description
    endif

    -- Set the update flag
    !updateFlag    = true
    !dbRef         = !!ce
    !!adminElem.teamSet(!!ce)

  elseif (!mode eq 'MODIFY') then

    -- Generate new attributes
    !newName       = |/*|+ _name.val
    !description   = _desc.val

    -- Navigate to the TEAM
    !!ce           = !dbRef

    -- Check for element being already claimed

    if (not !!dbRefUpdate (!dbRef)) then
      !!alert.error (!!error.text)
      return
    endif

    -- Change the name
    if (!dbRef.name neq !newName) then

      -- Modify the name
      -- OLD PML SYNTAX
      call !!admCommand(|NAME $!newName|)
      handle (41,12)

       -- Team already exists
        !!messageFile.error(141, 052, _name.val)
        _name.val    = !dbRef.name.substring(3)

      endhandle

      -- Set the update flag
      !updateFlag      = true
      !!admTeam.formTitle = !!messageFile.messageString(141, 853) + !dbRef.name.substring(3)

    endif

    -- Change the description
    if (!dbRef.description neq !description) then
      !!ce.description = !description
      !updateFlag      = true
    endif

  endif

  -- Update forms if required
  if (!updateFlag) then
    !!adminElem.update('TEAM')
  endif

  -- Get the membership details
  !teamMembers       = !!admTeamMembGet()
  !addRefs           = !teamMembers.difference(!dbRef.userLs)
  !remRefs           = !dbRef.userLs.difference(!teamMembers)
  !teamName          = !dbRef.name.substring(3)

  -- Make the team current
  call !!admCommand(|SET TEAM $!teamName|)

  -- Add new users to the team
  do !userRef values !addRefs
    !userName          = !userRef.name.substring(2)
    call !!admCommand('TADD |$!userName|')
  enddo

  -- Remove users from the team
  do !userRef values !remRefs
    !userName          = !userRef.name.substring(2)
    call !!admCommand('TREM |$!userName|')
  enddo

  -- Reset the form if create mode
  if (!mode eq 'CREATE') then
    call !!admTeamInit()
  endif

endfunction
-- End of function definition for !!admTeam
