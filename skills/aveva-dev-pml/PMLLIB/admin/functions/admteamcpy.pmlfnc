-- Created:         Wed Jul 16 16:03:37 BST 1997
--
--
-- Description:
-- Function to copy a source team to a new team element using the
-- old admin form of the COPY command.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamCpy()

  -- Initialise variables
  !sourceTeam       = !!admTeamCpyRefGet()
  !sourceName       = !sourceTeam.name.substring(3)
  !targetTeam       = !!admTeamCpy.name.val
  !include          = !!admTeamCpy.include.val
  !description      = !!admTeamCpy.desc.val

  -- Check for unset target name
  if (!targetTeam eq 'unset') then
    !!messageFile.error(141, 056)
  endif

  -- Create the copy command
  if (!include) then
    !command          = |COPY TEAM |+ !sourceName +| TO |+ !targetTeam
  else
    !command          = |COPY TEAM |+ !sourceName +| TO |+ !targetTeam +| EXCLUDING USERS|
  endif

  -- Execute the copy command
  call !!admCommand(!command)
  handle (1,29)

    -- Team already exists
    !!messageFile.error(141, 052, !targetTeam)

  elsehandle (1,30)

    -- Team not found
    !!adminElem.update('TEAM')
    !!messageFile.error(141, 054, !sourceTeam)

  elsehandle any

    -- Non specific
    !!messageFile.error(141, 055, !!error.text)

  endhandle

  -- Get the new DBREF
  !elemName       = |/*| + !targetTeam
  !!ce            = !elemName.dbRef()
  !!adminElem.teamSet(!!ce)

  -- Copy command was a success so modify the description
  if (!description.empty() or !description eq 'unset') then
    !description = ''
  endif
  !!ce.description = !description

  -- As a legacy databases get included in the copy
  -- Update forms
  !!adminElem.update('DB')
  !!adminElem.update('TEAM')
  call !!admTeamUpdate()

endfunction
-- End of function definition for !!admTeamCpy
