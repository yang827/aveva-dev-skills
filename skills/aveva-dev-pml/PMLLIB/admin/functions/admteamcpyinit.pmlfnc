--
-- Description:
-- Function to initialise the Team Copy form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamCpyInit()

  -- Initialise form variables
  !dbRef     = !!adminElem.teamGet()
  !!admTeamCpyRefSet(!dbRef)

  -- Set the form title
  !!admTeamCpy.formTitle = |Copy Team: |+ !dbRef.name.substring(3)

  -- Initialise form gadgets
  !!admTeamCpy.name.val  = |unset|
  if (!dbRef.description.empty()) then
    !!admTeamCpy.desc.val  = |unset|
  else
    !!admTeamCpy.desc.val  = !dbRef.description
  endif


endfunction
-- End of function definition for !!admTeamCpyInit
