--
--
-- Description:
-- Function to act as a callback to the Name gadget in the CopyTeam
-- form.
-- Function to be replaced by method !!admTeamCpy.name()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamCpyName()

  -- Initialise variables
  !tempRef     = object DBREF()

  -- Call the user name check
  if( !!admChkTeamName(!!admTeamCpy.name, !tempRef) ) then
    -- Name was good move focus on
    !!admTeamCpy.desc.setFocus()
  else
    -- Name was bad keep focus here
    !!admTeamCpy.name.setFocus()
  endif

endfunction
-- End of function definition for !!admTeamCpyName
