--
-- Description:
-- Function to set the DBREF of the source TEAM.
-- Function to be replaced by method !!admTeamCpy.refSet(!dbRef)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Source TEAM Dbref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamCpyRefSet(!dbRef is DBREF)

  -- Check that the element type is a TEAM
  if (!dbRef.type neq 'TEAM') then
    return error
  endif

  !!admTeamCpy.dbRef  = !dbRef

endfunction
-- End of function definition for !!admTeamCpyRefSet
