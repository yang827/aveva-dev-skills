--
--
-- Description:
-- Function to display the Team definition form.
-- Function to be replaced by method !!admMdb.display(string MODE).
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display form in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamDisplay(!mode is STRING)

  -- Check to see if mode is valid
  if (!mode.upcase() neq 'CREATE' and !mode.upcase() neq 'MODIFY') then

    -- Invalid mode
    return error |Invalid mode for form !!admTeam|

  endif

  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then

    call !!admTeamRefSet(object DBREF())

  elseif (!mode eq 'MODIFY') then

    -- Get the current MDB from
    !dbRef    = !!adminElem.teamGet()
    if (!dbRef.unset()) then
      -- No action required
      return
    elseif (!dbRef eq !!admTeamRefGet() and !!admTeam.shown()) then
      -- No action required
      return
    elseif (!dbRef.badRef()) then
      -- Raise an error
      !!messageFile.error(141, 054, !dbRef.string())
      handle (06, 054)
        !!adminElem.update('TEAM')
        return
      endhandle
    endif

    -- Set the new reference to modify
    call !!admTeamRefSet(!dbRef)

  endif

  -- Select the mode
  call !!admTeamModeSet(!mode.upcase())

  -- Show or update the form
  if (!!admTeam.shown()) then

    -- Re-Initialise the form
    call !!admTeamInit()

  else

    -- Show the form
    show !!admTeam free

  endif

endfunction
-- End of function definition for !!admTeamDisplay
