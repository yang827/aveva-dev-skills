--
--
-- Description:
-- Function to initialise the TEAM definition form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamInit()

  -- Initialise variables
  !mode      = !!admTeamModeGet()
  !dbRef     = !!admTeamRefGet()

  -- Reinstate the sort and filter values
  if (!!admTeam.filterVal.set()) then
    !!admTeam.filter.val = !!admTeam.filterVal
  endif
  if (!!admTeam.sortVal.set()) then
    !!admTeam.sort.select('rtext',!!admTeam.sortVal)
  endif

  -- Set form gadgets according to mode
  if (!mode eq 'CREATE') then

    !!admTeam.formTitle  = !!messageFile.messageString (141, 854)
    !!admTeam.name.val   = |unset|
    !!admTeam.desc.val   = |unset|

  elseif (!mode eq 'MODIFY') then

    !!admTeam.formTitle  = !!messageFile.messageString (141, 853)+ $
       !dbRef.name.substring(3)
    !!admTeam.name.val   = !dbRef.name.substring(3)
    if (!dbRef.description.empty()) then
      !!admTeam.desc.val   = |unset|
    else
      !!admTeam.desc.val   = !dbRef.description
    endif

  endif

  -- Display a message
  !!messageFile.prompt(141, 004, !!admTeam.formTitle, 'USER')

  -- Gather the user information
  call !!admTeamUserSet()
  call !!admTeamMembSet()

  -- Update the project users list
  call !!admTeamUserList()

  -- Update the team members list
  call !!admTeamMembList()

  -- Dismiss the prompt
  call !!prompt(0)

  -- Set the focus to the name gadget
  !!admTeam.name.setFocus()

endfunction
-- End of function definition for !!admTeamInit
