--
--
-- Description:
-- Function to add the selected project users to the current team.
-- Function to be replaced by method !!admTeam.membAdd()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamMembAdd()

  -- Get the current selections
  !userSel    = !!admTeam.projUsers.val

  -- Return if not values
  if (!userSel.size() eq 0) then
    return
  endif

  -- Process the selection list
  do !i values !userSel

    -- Convert the value
    !dbRef      = !!admTeam.projUsers.rText[!i].dbRef()
    handle any
      -- Bad reference
      skip
    endhandle

    -- Add the value to the team members store
    !!admTeam.members.append(!dbRef)

  enddo

  -- Update the list gadgets
  call !!admTeamUserList()
  call !!admTeamMembList()

endfunction
-- End of function definition for !!admTeamMembAdd
