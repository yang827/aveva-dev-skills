--
--
-- Description:
-- Function to update the contents of the team member list gadget on the
-- TEAM Definition form.
-- Function to be replaced by method !!admTeam.membList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamMembList()

  -- Initialise variables
  !teamMembers    = !!admTeamMembGet()

  -- Clear the list gadgets
  !!admTeam.teamUsers.clear()

  -- Sort the list by name
  !nameBlock      = object BLOCK(|!teamMembers[!evalIndex].name.substring(3)|)
  !names          = !teamMembers.evaluate(!nameBlock)
  !order          = !names.sortedIndices()
  !teamMembers.reIndex(!order)

  -- Display a list of team members
  call !!adminUserTxtList(!teamMembers,!!admTeam.teamUsers,!!admDisplayConfig.fmtUserGet(),false)

endfunction
-- End of function definition for !!admTeamMembList
