--
-- Description:
-- Function to remove all users from the current team.
-- Function to be replaced by method !!admTeam.membRemAll()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamMembRemAll()

  -- Get the selected members
  !membSel    = !!admTeam.teamUsers.Count

  -- Return if no values
  if (!membSel eq 0) then
    return
  endif

  -- Process the selection list
  do !index to !membSel

    -- Convert the value
    !dbRef      = !!admTeam.teamUsers.rText[!index].dbRef()
    handle any
      -- Bad reference
      skip
    endhandle

    -- Find the element in the member array
    !pos        = !!admTeam.members.findFirst(!dbRef)
    if (!pos.set()) then
      !!admTeam.members.remove(!pos)
    endif

  enddo

  -- Update the list gadgets
  call !!admTeamUserList()
  call !!admTeamMembList()

endfunction
-- End of function definition for !!admTeamMembRem
