--
-- Description:
-- Function to the array of users that are currently members of the TEAM
-- that is current in the TEAM Definition form.
-- Function to be replaced by method !!admTeam.membSet()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamMembSet()

  -- Initialise variables
  !dbRef          = !!admTeamRefGet()

  -- Get the membership from the team
  if (!dbRef.badRef()) then

    -- Dbref is unset
    !members        = ARRAY()

  else

    -- Get the membership
    !members        = !dbRef.userLs

  endif

  -- Store the values
  !!admTeam.members = !members

endfunction
-- End of function definition for !!admTeamMembSet
