--
-- Description:
-- Callback to the mode gadget in the TEAM Definition form.
-- Function to be replaced by method !!admTeam.cbMode
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamMode()

  -- Read the mode value
  !mode    = !!admTeamModeGet()

  -- Call the display method to reset the form
  call !!admTeamDisplay(!mode)



endfunction
-- End of function definition for !!admTeamMode
