--
-- Description:
-- Function to return the current mode of the TEAM definition form.
-- Function to be replaced by method !!admTeam.modeGet() is STRING
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Mode of form.
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamModeGet() is STRING

  -- Return the mode
  return !!admTeam.mode.selection('rtext')

endfunction
-- End of function definition for !!admTeamModeGet
