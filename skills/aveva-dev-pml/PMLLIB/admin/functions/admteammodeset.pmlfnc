--
-- Description:
-- Function to set the mode of the !!admTeam form.
-- Function to be replaced by method !!admTeam.modeSet(!mode is STRING)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to set (CREATE / MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamModeSet(!mode is STRING)

  -- Set the mode gadget
  !!admTeam.mode.select('rtext',!mode.upcase())
  handle any
    -- Dummy handle (should not happen)
  endhandle

endfunction
-- End of function definition for !!admTeamModeSet
