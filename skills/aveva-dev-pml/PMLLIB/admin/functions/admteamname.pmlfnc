--
--
-- Description:
-- Function to act as callback to the Name gadget in the TEAM Definition
-- form.
-- Function to be replaced by method !!admTeam.cbName()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamName(!gadget is GADGET)

  -- Initialise variables
  !dbRef    = !!admTeamRefGet()

  -- Call the TEAM Name check routine
  if( !!admChkTeamName(!gadget, !dbRef) ) then
    -- Name was good move focus on
    !!admTeam.desc.setFocus()
  else
    -- Name was bad keep focus here
    !!admTeam.name.setFocus()
  endif

endfunction
-- End of function definition for !!admTeamName
