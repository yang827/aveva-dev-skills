--
-- Description:
-- Function to refresh the USER elements listed in the gadgets on the
-- TEAM Definition form
-- Function to be replaced by method !!admTeam.refresh()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamRefresh()

  -- Return if the form is not shown
  if (!!admTeam.shown().not()) then
    return
  endif

  -- Display a message
  !!messageFile.prompt(141, 4, !!admTeam.formTitle, 'USER')

  -- Rebuild the project user array
  call !!admTeamUserSet()

  -- Update the project user list
  call !!admTeamUserList()

  -- Update the Team Members list
  call !!admTeamMembList()

  -- Dismiss the prompt
  call !!prompt(0)


endfunction
-- End of function definition for !!admTeamRefresh
