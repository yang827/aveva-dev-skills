--
-- Description:
-- Function to set the current DBREF of the  TEAM that is being
-- created or modified.
-- Function to be replaced by method !!admTeam.refSet(!dbRef is DBREF)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of TEAM (can be unset).
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamRefSet(!dbRef is DBREF)

  -- Set the DBREF
  !!admTeam.dbRef  = !dbRef

endfunction
-- End of function definition for !!admTeamRefSet
