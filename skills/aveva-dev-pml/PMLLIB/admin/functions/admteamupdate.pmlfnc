--
--
-- Description:
-- Function to update the displayed TEAM in the TEAM Definition form.
-- The form must be displayed and in MODIFY mode.
-- Function to be replaced by method !!admTeam.update()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamUpdate()

  -- Return if the form is not shown
  if (!!admTeam.shown().not()) then
    return
  endif

  -- Initialise variables
  !mode    = !!admTeamModeGet()
  !selTeam = !!adminElem.teamGet()
  !curTeam = !!admTeamRefGet()

  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif

  -- Return if the same reference
  if (!selTeam eq !curTeam) then
    return
  endif

  -- Reinitialise the form
  call !!admTeamRefSet(!selTeam)
  call !!admTeamInit()

endfunction
-- End of function definition for !!admTeamUpdate
