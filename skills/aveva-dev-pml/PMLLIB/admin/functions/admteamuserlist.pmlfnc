--
--
-- Description:
-- Function to update the contents of the project users list gadget on
-- the TEAM Definition form.
-- Function to be replaced by method !!admTeam.userList()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamUserList()

  -- Initialise variables
  !projUsers          = !!admTeamUserGet()
  !teamMembers        = !!admTeamMembGet()

  -- Save the sort and filter values for later use
  if (!!admTeam.filter.val.empty()) then
    !!admTeam.filter.val = |*|
  endif
  !!admTeam.filterVal = !!admTeam.filter.val
  !!admTeam.sortVal   = !!admTeam.sort.selection('rtext')

  -- Clear the list gadget
  !!admTeam.projUsers.clear()

  -- Determine user to be displayed
  -- User not in team only
  !userList           = !projUsers.difference(!teamMembers)

  -- Sort the list of users
  !displayList        = !!adminFilterSort(!userList, !!admTeam.sort, !!admTeam.filter)

  -- Display the list of users
  call !!adminUserTxtList(!displayList, !!admTeam.projUsers, !!admDisplayConfig.fmtUserGet(), false)


endfunction
-- End of function definition for !!admTeamUserList
