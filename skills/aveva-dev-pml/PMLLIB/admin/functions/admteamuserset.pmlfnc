--
-- Description:
-- Function to set the form attribute to store an array of project users
-- in the TEAM Definition form.
-- Function to be replaced by method !!admTeam.setPrjUser()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTeamUserSet()

  -- Initialise variables
  !users               = ARRAY()
  !currentPos          = !!ce

  -- Collect the project users
  !!ce                 = !!dbrAdminGetWorld('USER')
  !users               = !!collectAllFor('USER','',!!ce)

  -- Assign the array to its store
  !!admTeam.userArray  = !users

  -- Return to database position
  !!ce                 = !currentPos

endfunction
-- End of function definition for !!admTeamUserSet
