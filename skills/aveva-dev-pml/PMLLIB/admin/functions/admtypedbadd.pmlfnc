--
-- Description:
-- Function to store database types used in the Admin module.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ADMTYPEDB   Database type to store
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTypeDbAdd(!typeDb is ADMTYPEDB)

  -- Store the value
  !!adminApplic.typeDb.append(!typeDb)

endfunction
-- End of function definition for !!admTypeDbAdd
