--
-- Description:
-- Load database types that are used inside PDMS Admin.
--
------------------------------------------------------------------------
define function !!admTypeDbDflt()

  -- Design Databases
  !typeDb              = object ADMTYPEDB()
  !typeDb.type         = 'DESI'
  !typeDb.description  = 'Design'
  !typeDb.order        = 4
  call !!admTypeDbAdd(!typeDb)

  -- Draft databases
  !typeDb              = object ADMTYPEDB()
  !typeDb.type         = 'PADD'
  !typeDb.description  = 'Draft'
  !typeDb.order        = 6
  call !!admTypeDbAdd(!typeDb)

  -- Catalogue databases
  !typeDb              = object ADMTYPEDB()
  !typeDb.type         = 'CATA'
  !typeDb.description  = 'Catalogue'
  !typeDb.order        = 3
  call !!admTypeDbAdd(!typeDb)

  -- Properties databases
  !typeDb              = object ADMTYPEDB()
  !typeDb.type         = 'PROP'
  !typeDb.description  = 'Properties'
  !typeDb.order        = 2
  call !!admTypeDbAdd(!typeDb)

  -- Dictionary databases
  !typeDb              = object ADMTYPEDB()
  !typeDb.type         = 'DICT'
  !typeDb.description  = 'Dictionary'
  !typeDb.order        = 1
  call !!admTypeDbAdd(!typeDb)

  -- Isodraft databases
  !typeDb              = object ADMTYPEDB()
  !typeDb.type         = 'ISOD'
  !typeDb.description  = 'Isodraft'
  !typeDb.order        = 5
  call !!admTypeDbAdd(!typeDb)


  -- Transaction databases only for global projects
  !project = current project
  if (!project.isGlobal()) then
    !typeDb              = object ADMTYPEDB()
    !typeDb.type         = 'TRAN'
    !typeDb.description  = 'Transaction'
    !typeDb.order        = 8
    call !!admTypeDbAdd(!typeDb)
  endif

  -- Schematic databases
   !typeDb              = object ADMTYPEDB()
   !typeDb.type         = 'SCHE'
   !typeDb.description  = 'Schematic'
   !typeDb.order        = 9
   call !!admTypeDbAdd(!typeDb)

  -- Manufacturing databases
   !typeDb              = object ADMTYPEDB()
   !typeDb.type         = 'MANU'
   !typeDb.description  = 'Manufacturing'
   !typeDb.order        = 10
   call !!admTypeDbAdd(!typeDb)

  -- Namesequence databases
   !typeDb              = object ADMTYPEDB()
   !typeDb.type         = 'NSEQ'
   !typeDb.description  = 'Namesequence'
   !typeDb.order        = 11
   call !!admTypeDbAdd(!typeDb)

  -- Attributes databases
   !typeDb              = object ADMTYPEDB()
   !typeDb.type         = 'ENGI'
   !typeDb.description  = 'Engineering'
   !typeDb.order        = 12
   call !!admTypeDbAdd(!typeDb)

  -- Analysis databases
   !typeDb              = object ADMTYPEDB()
   !typeDb.type         = 'ALYS'
   !typeDb.description  = 'Analysis'
   !typeDb.order        = 13
   call !!admTypeDbAdd(!typeDb)

endfunction
-- End of function definition for !!admTypeDbDflt
