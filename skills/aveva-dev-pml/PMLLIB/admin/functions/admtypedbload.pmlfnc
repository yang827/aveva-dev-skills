--
--
-- Description:
-- Function to load an option gadget with a set of Admin database types.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Option gadget to load
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admTypeDbLoad(!gadget is GADGET)

  -- Initialise variables
  !dText         = ARRAY()
  !rText         = ARRAY()
  !typeDb        = !!admTypeDbGet()

  -- Process the array of db types
  do !type values !typeDb

    !dText.append(!type.description)
    !rText.append(!type.type)

  enddo

  -- Assign values to gadgets
  !gadget.dText  = !dText
  !gadget.rText  = !rText

endfunction
-- End of function definition for !!admTypeDbLoad
