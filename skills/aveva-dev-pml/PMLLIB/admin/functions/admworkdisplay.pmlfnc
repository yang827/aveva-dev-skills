--
--
-- Description:
-- Function to display the Team definition form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to display form in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!admWorkDisplay(!mode is STRING)


  -- Perform actions dependent on mode
  if (!mode eq 'CREATE') then
  -- Show or update the form
  if (defined (!!admWork) and !!admWork.shown()) then

    -- Re-Initialise the form
    !!admWork.init()

  else

    -- Show the form
    show !!admWork

  endif


  elseif (!mode eq 'MODIFY') then
    show !!admWorkMod

  endif



endfunction
-- End of function definition
