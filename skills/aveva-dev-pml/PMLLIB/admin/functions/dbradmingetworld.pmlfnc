--
--
-- Description:
-- Function to return the DBREF of a world element in terms of
-- the Admin hierarchy.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type to get world for.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dbrAdminGetWorld(!type is STRING) is DBREF

  -- Return the value of the requested world
  if (!type.upcase() eq 'WORLD') then

    -- Return WORLD (System DB)
    return !!adminApplic.world

  elseif (!type.upcase() eq 'STAT') then

    -- Return the STAT world
    return !!adminApplic.statWorld

  elseif (!type.upcase() eq 'TEAM') then

    -- Return TEAM WORLD
    return !!adminApplic.teamWorld

  elseif (!type.upcase() eq 'DB') then

    -- Return TEAM WORLD (for databases)
    return !!adminApplic.teamWorld

  elseif (!type.upcase() eq 'USER') then

    -- Return the USER WORLD
    return !!adminApplic.userWorld

  elseif (!type.upcase() eq 'MDB') then

    -- Return the MDB world
    return !!adminApplic.mdbWorld

  elseif (!type.upcase() eq 'GSTAT') then

    -- Return the Global Stat world (Global)
    return !!adminApplic.gStatWorld

  elseif (!type.upcase() eq 'LOC') then

    -- Return the Location world (Global)
    return !!adminApplic.locnWorld

  elseif (!type.upcase() eq 'ROLE') then

    -- Return the Role World
    if(!!adminApplic.roleWorld.unset())then
      -- ##
      return error 1 |Warning the Role World does not exist - The Role World is a feature of Data Access Control, DAC features will be suppressed|
    endif
    return !!adminApplic.roleWorld


  elseif (!type.upcase() eq 'ACR') then

    -- Return the Role World
    if(!!adminApplic.acrWorld.unset())then
      -- ##
      return error 1 |Warning the Acr World does not exist - The Acr World is a feature of Data Access Control, DAC features will be suppressed|
    endif
    return !!adminApplic.acrWorld

  elseif (!type.upcase() eq 'SCOPE') then

    -- Return the Scope World
    if(!!adminApplic.scopeWorld.unset())then
      -- ##
      return error 1 |Warning the Scope World does not exist - The Scope World is a feature of Data Access Control, DAC features will be suppressed|
    endif
    return !!adminApplic.scopeWorld


  elseif (!type.upcase() eq 'DBSET') then

    -- Return the Scope World
    if(!!adminApplic.dbSetWorld.unset())then
      -- ##
      return error 1 |Warning the DB SET World does not exist - The DB SET World was introduced in Global Phase 2, DBSET features will be suppressed|
    endif
    return !!adminApplic.dbSetWorld


  elseif (!type.upcase() eq 'LCOM') then

    -- Return the Local Communications world (Global)
    return !!adminApplic.lComWorld

  elseif (!type.upcase() eq 'STAMP') then

    -- Return the STAMP WORLD
    return !!adminApplic.stampWorld

  endif

  -- Invalid world
  !!alert.error(|Invalid world requested [|+ !type +|]|)

endfunction
-- End of function definition for !!dbrAdminGetWorld
