--
--
-- Description: Function to set the values of the various admin world used
-- in the Admin Application.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dbrAdminSetWorld()

  -- Initialise variables
  !globalProject   = !!glbIsGlobal()

  -- Initialise the world element DBREF variables
  -- Standard Admin

  -- World
  /*
  !!adminApplic.world  = !!ce

  -- Stat World
  /*S
  !!adminApplic.statWorld  = !!ce

  -- User World
  /*U
  !!adminApplic.userWorld  = !!ce

  -- Mdb World
  /*M
  !!adminApplic.mdbWorld   = !!ce

  -- Stamp World
  if (!globalProject) then
    /*GST
    handle (2,109)
      if (DBWRITE) then
        NEW GSTWLD /*GST
      else
        -- Do nothing, this in case the user enters Admin (first time only) in Read only mode DFN1871
        --!!alert.warning('Global Stamp World has not been created yet. It will be created when you enter ADMIN in R/W mode')
      endif
    endhandle
  else
    /*ST
    handle (2,109)
      if (DBWRITE) then
        NEW STWLD /*ST
      else
        -- Do nothing, this in case the user enters Admin (first time only) in Read only mode DFN1871
        --!!alert.warning('Stamp World has not been created yet. It will be created when you enter ADMIN in R/W mode')
      endif
    endhandle
  endif
  !!adminApplic.stampWorld   = !!ce

  -- Scope World
  /*SC
  handle any
    -- Scope world does not exist, this could be because project is a Global phase 1 project or a pre Data Access Control version
    -- ##
  endhandle
  if(!!ce.name EQ |/*SC|)then
    !!adminApplic.scopeWorld   = !!ce
  endif

  -- Acr World
  /*ACR
  handle any
    -- ACR world does not exist, this could be because project is a Global phase 1 project or a pre Data Access Control version
    -- ##
  endhandle
  if(!!ce.name EQ |/*ACR|)then
    !!adminApplic.acrWorld   = !!ce
  endif

  -- DB Set World
  /*DS
  handle any
    -- DB SET world does not exist, this could be because project is a Global phase 1 project or a pre Data Access Control version
    -- ##
  endhandle
  if(!!ce.name EQ |/*DS|)then
    !!adminApplic.dbSetWorld = !!ce
  endif

  if (not !globalProject) then
    -- Role World(Non-Global)
    /*RO
    handle any
      -- Role world does not exist, this could be because project is a Global phase 1 project or a pre Data Access Control version
      -- ##
    endhandle
    if(!!ce.name EQ |/*RO|)then
      !!adminApplic.roleWorld = !!ce
    endif
    -- Team World (Non-Global)
    /*T
    !!adminApplic.teamWorld  = !!ce

  else

    -- Global Projects
    -- Role World (Global)
    /*GRO
    handle any
      -- Role world does not exist, this could be because project is a Global phase 1 project or a pre Data Access Control version
      -- ##
    endhandle
    if(!!ce.name EQ |/*GRO|)then
      !!adminApplic.roleWorld  = !!ce
    endif

    -- Team World (Global)
    /*GT
    !!adminApplic.teamWorld  = !!ce

    -- Global Stat world (Global)
    /*GS
    !!adminApplic.gStatWorld = !!ce

    -- Location World (Global)
    /*GL
    !!adminApplic.locnWorld  = !!ce
    !!adminApplic.hubRef     = !!ce.hubRf

    -- Comm World (Global)
    /*LC
    !!adminApplic.lComWorld  = !!ce

  endif


endfunction
-- End of function definition for !!dbrAdminSetWorld
