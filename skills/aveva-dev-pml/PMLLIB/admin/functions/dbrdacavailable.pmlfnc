-- Description:
-- Function to query if Data Access Control is built in to this Project
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!dbrDacAvailable() is BOOLEAN

  return !!admControl.isValid('Data Access Control')

--  !!dbrAdminGetWorld(|SCOPE|)
  /*SC
  handle any
    -- Prebuilt error occurs only if Scope world does not exist, hence DAC not present
    return FALSE
  endhandle
  return TRUE
endfunction
-- End of function definition for !!dbrDacAvailable
