--
-- Description:
-- Function to return the current project locations DBREF.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Current locations DBREF
--
------------------------------------------------------------------------

-- Define function
define function !!dbrGlbCurLocRf() is DBREF

  -- Get the Stat world element
  !stat   = !!dbrAdminGetWorld('STAT')

  -- Return the locrf
  return !stat.curLoc

endfunction
-- End of function definition for !!dbrGlbCurLocRf
