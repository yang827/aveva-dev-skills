--
--
-- Description:
-- Function to create array entries for the passed location DBREF for
-- its parents and children. Called recursively.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of location
--    2   R      REAL        Current level in hierarchy (0 >)
--    3   RW     ARRAY       Array of locations
--    4   RW     ARRAY       Array of parents
--    5   RW     ARRAY       Array of levels
-- Return:
--   [Data Type]   [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dbrLocDataSet(!loc is DBREF, !level is REAL, !locations is ARRAY, !parents is ARRAY, !levels is ARRAY)

  -- Initialise variables
  !!ce          = !!dbrAdminGetWorld('LOC')
  !children     = !!collectAllFor('LOC', 'linit eq true and locrf eq '+ !loc.string(), !!ce)

  -- Add location to the arrays
  !levels.append(!level)
  !locations.append(!loc)
  !parents.append(!loc.locRf)

  -- Sort the children by name
  !nameBlock    = object BLOCK(|!children[!evalIndex].name|)
  !names        = !children.evaluate(!nameBlock)
  !order        = !names.sortedIndices()
  !children.reIndex(!order)

  -- Process the child locations
  do !dbRef values !children

    -- Process each in turn
    call !!dbrLocDataSet(!dbRef,!level + 1, !locations, !parents, !levels)

  enddo

endfunction
-- End of function definition for !!dbrLocDataSet
