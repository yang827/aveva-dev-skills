-- Author:          E.conba
-- Created:         Mon Oct 27 14:11:07 GMT 1997
--
--
-- Description:
-- Function to return an array of all of the descendants (offspring) of
-- the password location. (Called recursively)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Starting locations if hierarchy
--    2   RW     ARRAY       Array of offspring locations
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dbrLocOffspring(!loc is DBREF, !offspring is ARRAY)

  -- Initialise variables
  !!ce          = !!dbrAdminGetWorld('LOC')
  !clause       = 'linit eq true and locrf eq '+ !loc.string()
  !children     = !!collectAllFor('LOC',!clause, !!ce)

  -- Sort the children by name
  !nameBlock    = object BLOCK(|!children[!evalIndex].name|)
  !names        = !children.evaluate(!nameBlock)
  !order        = !names.sortedIndices()
  !children.reIndex(!order)

  -- Process the child locations
  do !dbRef values !children

    -- Process each in turn
    !offspring.append(!dbRef)
    call !!dbrLocOffspring(!dbRef, !offspring)

  enddo

endfunction
-- End of function definition for !!dbrLocOffspring
