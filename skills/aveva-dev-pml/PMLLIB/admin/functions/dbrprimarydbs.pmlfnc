--
--
-- Description: returns array of dbrefs of DB's primary at the given location
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DBREF of location
--    2   R      STRING      'DBREF' or 'STRING' specifying the type of reference
--                           returned in the array
-- Return:
--   [Data Type]   [Description]
--    ARRAY         array of dbrefs or string references of DB's primary at the given location
--
------------------------------------------------------------------------

define function !!dbrPrimaryDbs(!loc is DBREF, !type is STRING) is ARRAY

  -- Initialise variables
  !locRef       = !loc.string()
  -- get list of dbs allocated to this location
  !allocatedDbs = !loc.dbAll
  !block        = object BLOCK(|!allocatedDbs[!evalIndex].string()|)
  !dbList       = !allocatedDbs.evaluate(!block)

  -- get all db's whose primary location = given location
  VAR !primaryDbs COLLECT ALL DB WITH ( locRf of DBLOC 1 eq $!locRef ) FROM !dbList

  if( !type.upcase() eq 'STRING' ) then
    return !primaryDbs
  else
    -- convert to dbrefs
    !block        = object BLOCK(|!primaryDbs[!evalIndex].dbref()|)
    return !primaryDbs.evaluate(!block)
  endif

endfunction
-- End of function definition
