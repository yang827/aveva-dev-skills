--
--
-- Description:
-- Function to exclude foreign databases from the current project.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!excludeDb()

  -- Initialise variables
  !project    = CURRENT PROJECT
  !selection  = !!excludeDb.foreignDb.selection('rtext')
  !noOfSel    = !selection.size()
  !verify     = BOOLEAN()

  -- Return if not elements
  if (!noOfSel eq 0) then
    return
  endif

  -- See if there is more than one selection
  if (!noOfSel gt 1) then
    !verify     = !!alert.confirm(!!messageFile.messageString(141, 176, !noOfSel.string())).boolean()
  else
    !verify     = true
  endif

  -- Process the list of selections
  do !i indices !selection

    !database   = !selection[!i].dbRef()
    !dbName     = !database.name.substring(3)

    -- Get the user to confirm the exclusion
    if (!verify.boolean()) then

      !answer     = !!alert.confirm(!!messageFile.messageString(141, 172, !dbName, !project.code()))
      skip if (!answer.boolean().not())

    endif

    -- Exclude the database
    EXCLUDE DB $!dbName
    handle any

      !!messageFile.error(141, 173, !dbName, !!error.text)
      handle (06, 173)
        -- Dummy handle to continue
      endhandle

    endhandle

  enddo

  -- Update the forms
  !!adminElem.update('DB')
  call !!excludeDbInit()
  if (Defined (!!checkDb)) then
     call !!refreshDependent(!!checkDb)
  endif


endfunction
-- End of function definition for !!excludeDb
