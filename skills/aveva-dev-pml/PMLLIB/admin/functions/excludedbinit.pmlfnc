--
--
-- Description:
-- Function to initialise the ExcludeDb form with foreign databases.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!excludeDbInit()

  -- Initialise variables
  !!ce          = !!dbrAdminGetWorld('TEAM')
  !databases    = !!collectAllFor('DB','',!!ce)
  !forDatabases = ARRAY()

  -- Process the database in this project
  !evalBlock    = object BLOCK(|!databases[!evalIndex].foreign|)
  !dbProject    = !databases.evaluate(!evalBlock)

  -- Find all the elements not in the current project
  do !i indices !dbProject
    if (!dbProject[!i] neq 'LOCAL') then
      -- Foreign database
      !forDatabases.append(!databases[!i])
    endif
  enddo

  -- Clear list
  !!excludeDb.foreignDb.clear()

  -- Return if no values
  if (!forDatabases.empty()) then
    return
  endif

  -- Add elements to the list
  !displayRefs   = !!adminFilterSort(!forDatabases,!!excludeDb.sort,!!excludeDb.filter)
  call !!adminDbTxtList(!displayRefs, !!excludeDb.foreignDb, !!admDisplayConfig.fmtDbGet(), false, object DBREF())


endfunction
-- End of function definition for !!excludeDbInit
