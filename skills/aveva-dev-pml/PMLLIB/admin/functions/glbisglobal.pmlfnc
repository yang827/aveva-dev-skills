--
-- Description:
-- Function to return whether or not the current project is a Global
-- project.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if project is global
--
------------------------------------------------------------------------

-- Define function
define function !!glbIsGlobal() is BOOLEAN

  return !!admControl.isValid('Global')
  -- Get the current project
  !project   = CURRENT PROJECT

  -- Return the results
  return !project.isGlobal()

endfunction
-- End of function definition for !!glbIsGlobal
