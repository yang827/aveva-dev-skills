--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          E.conba
-- Created:         Wed Jan 22 09:16:43 GMT 1997
--
--
-- Description:
-- Function to install AVEVA Data from sample projects.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     STRING      Mode of installation
--    2   RW     STRING      Submode
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!installCadc(!mode is STRING, !subMode is STRING)

  -- Initialise variables
  !installData = ARRAY()

  -- Check that the current user is SYSTEM
  !sessionData = CURRENT SESSION
  !userName = !sessionData.user().name

  -- Creating Tutorial users SAMPLE, HANGER and HVAC
  if (!subMode eq |SAMPLE|) then

    ----------------------------
    -- Create tutorial users --
    ----------------------------
    prompt |Creating tutorial users...|

    CREATE USER 'SAMPLE'/SAMPLE       DESC 'User for Stabiliser Plant'
    handle (1,3) $* already exists
    endhandle

    CREATE USER 'DEMO'/DEMO           DESC 'User for Solvent Recovery Plant'
    handle (1,3) $* already exists
    endhandle

    CREATE USER 'HANGER'/HANGER       DESC 'User for HANGERS Tutorials'
    handle (1,3) $* already exists
    endhandle

    CREATE USER 'HVAC'/HVAC           DESC 'User for HVAC Tutorials'
    handle (1,3) $* already exists
    endhandle

    CREATE USER 'PIPE'/PIPE           DESC 'User for PIPING Tutorials'
    handle (1,3) $* already exists
    endhandle

    CREATE USER 'EQUI'/EQUI           DESC 'User for EQUIPMENT Tutorials'
    handle (1,3) $* already exists
    endhandle

    CREATE USER 'STRUC'/STRUC         DESC 'User for STRUCTURAL Tutorials'
    handle (1,3) $* already exists
    endhandle

    CREATE USER 'ADMIN'/ADMIN         DESC 'User for Database Administration'
    handle (1,3) $* already exists
    endhandle

    CREATE USER 'CATS'/CATS           DESC 'User for Cats And Specs Tutorials'
    handle (1,3) $* already exists
    endhandle

    ---------------------------
    -- Create tutorial teams --
    ---------------------------
    prompt |Creating tutorial teams...|

    CREATE TEAM SAMPLE              DESC 'Team used for Stabiliser Plant'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'SAMPLE'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM MASTER              DESC 'Team used for MASTER DBs'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'SAMPLE'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM DEMO                DESC 'Team used for Solvent Recovery Plant'
    handle (1,29)  $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'DEMO'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM HANGER              DESC 'Team used for HANGERS Tutorials'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'HANGER'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM HVAC                DESC 'Team used for HVAC Tutorials'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'HVAC'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM PIPE                DESC 'Team used for PIPING Tutorials'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'PIPE'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM EQUI                DESC 'Team used for EQUIPMENT Tutorials'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'EQUI'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM STRUC               DESC 'Team used for STRUCTURAL Tutorials'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'STRUC'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM DRAFTADMIN          DESC 'Team used for DRAFT Administration Databases'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM ISOADMIN            DESC 'Team used for ISODRAFT Administration'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM HSADMIN             DESC 'Team used for Hangers and Supports Administration'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM PARAGONADMIN        DESC 'Team used for PARAGON Administration'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM ADMIN               DESC 'Team used for General Administration Databases'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'ADMIN'
    endhandle

    CREATE TEAM CATS                DESC 'Team used for Cats And Specs Tutorials'
    handle (1,29) $* Team Already exists
    elsehandle none
      TADD '$!userName'
      TADD 'CATS'
      TADD 'ADMIN'
    endhandle


    !installData.append(|Created Tutorial Users and Teams successfully|)
    prompt dismiss

  endif


  -----------------------------------------------------
  -- Include MASTER Dbs in Project According to Mode --
  -----------------------------------------------------

  -- Create lists of required DB's based on the supplied SubMode
  !dbList  = ARRAY()
  !dbTitle = ARRAY()

  -- Database required for HVAC
  if (!subMode eq |HVAC| or !subMode eq |ALL| or !subMode eq |SAMPLE|) then

    !dbList.append(|MASTER/HVACCATA|)
    !dbTitle.append(|HVAC Catalogue|)

  endif

  -- Database required for PIPE
  if (!subMode eq |PIPE| or !subMode eq |ALL| or !subMode eq |SAMPLE|) then

    !dbList.append(|MASTER/PIPECATA|)
    !dbTitle.append(|Pipe Catalogue|)
    !dbList.append(|MASTER/PIPEOLD|)
    !dbTitle.append(|Old Pipe Catalogue|)

  endif

  -- Database required for EQUIPMENT
  if (!subMode eq |EQUI| or !subMode eq |ALL| or !subMode eq |SAMPLE|) then

    !dbList.append(|MASTER/EQUICATA|)
    !dbTitle.append(|Equipment Catalogue|)
    !dbList.append(|MASTER/EQUITMPL|)
    !dbTitle.append(|Equipment Templates|)
    !dbList.append(|MASTER/ASLCATA|)
    !dbTitle.append(|ASL Catalogue|)

  endif

  -- Databases required for SUPPORTS
  if (!subMode eq |SUPP| or !subMode eq |ALL| or !subMode eq |SAMPLE|) then

    !dbList.append(|MASTER/SUPPCATA|)
    !dbTitle.append(|Support Catalogue|)

  endif

  -- Databases required for STEELWORK
  if (!subMode eq |STL| or !subMode eq |ALL| or !subMode eq |SAMPLE|) then

    !dbList.append(|MASTER/STLCATA|)
    !dbTitle.append(|Steelwork Catalogue|)

  endif

  -- Databases required for PROPERTIES
  if (!subMode eq |PROP| or !subMode eq |ALL| or !subMode eq |SAMPLE|) then

    !dbList.append(|MASTER/PROP|)
    !dbTitle.append(|Properties|)

  endif

  -- Databases required for DICTIONARY
  if (!subMode eq |DICT| or !subMode eq |ALL| or !subMode eq |SAMPLE|) then

    !dbList.append(|MASTER/DICT|)
    !dbTitle.append(|Dictionary|)

  endif

  -- Databases required for DRAFT
  if (!subMode eq |DRA| or !subMode eq |ALL| or !subMode eq |SAMPLE|) then

    !dbList.append(|MASTER/PADD|)
    !dbTitle.append(|DRAFT Library|)

  endif

  -- Create command templates for DB action depending on mode
  if (!mode eq |FOREIGN|) then

    -- Include databases
    !commandTemplate = 'INCLUDE DB dbname FROM PROJ MAS USER |SYSTEM|/XXXXXX'
    !action = |include|

  elseif (!mode eq |LOCAL|) then

    -- Copy databases
    !commandTemplate = 'COPY DB dbname FROM PROJ MAS USER |SYSTEM|/XXXXXX TO dbname'
    !action = |load|

  endif

  -- Execute the DB commands based on the list of DB's required
  do !i indices !dbList

    -- Make command
    !command = !commandTemplate.replace(|dbname|,!dbList[!i])

    -- Show a prompt
    prompt |Performing $!action on database $!dbList[$!i] ...|

    -- Execute command
    $!command
    handle any
      !installData.append(|The |+!dbTitle[!i]+| data failed to |+!action+| (may already exist)|)
    elsehandle none
      !installData.append(!dbTitle[!i]+| data: |+!action+| successful. Db |+!dbList[!i])
    endhandle

    prompt dismiss

  enddo

  -- Create remainder of SAMPLE project structure
  if (!subMode eq |SAMPLE|) then

    --------------------------------------------------
    -- Copy the working dbs from the SAMPLE project --
    --------------------------------------------------
    -- NB. These must be copies a write access will be required.

    -- Copy databases command template
    !commandTemplate = 'COPY DB dbname FROM PROJ SAM USER |SYSTEM|/XXXXXX TO dbname'

    -- Clear the DB arrays from previous usage
    !dbList.clear()
    !dbTitle.clear()

    -- Set-up a list of dbs to actions
    !dbList.append(|ADMIN/PADD|)
    !dbList.append(|SAMPLE/DESI|)
    !dbList.append(|SAMPLE/PADD|)
    !dbList.append(|DEMO/DESI|)
    !dbList.append(|DEMO/PADD|)
    !dbList.append(|HANGER/DESI|)
    !dbList.append(|HANGER/PADD|)
    !dbList.append(|HVAC/DESI|)
    !dbList.append(|HVAC/PADD|)
    !dbList.append(|PIPE/DESI|)
    !dbList.append(|PIPE/PADD|)
    !dbList.append(|PIPE/ISOD|)
    !dbList.append(|EQUI/DESI|)
    !dbList.append(|EQUI/PADD|)
    !dbList.append(|STRUC/DESI|)
    !dbList.append(|STRUC/PADD|)
    !dbList.append(|CATS/DESI|)
    !dbList.append(|CATS/CATA|)
    !dbList.append(|CATS/PADD|)

    !dbTitle.append(|Sample Draft Admin|)
    !dbTitle.append(|Sample Design|)
    !dbTitle.append(|Sample Draft|)
    !dbTitle.append(|Demo Design|)
    !dbTitle.append(|Demo Draft|)
    !dbTitle.append(|Hanger Design|)
    !dbTitle.append(|Hanger Draft|)
    !dbTitle.append(|HVAC Design|)
    !dbTitle.append(|HVAC Draft|)
    !dbTitle.append(|Piping Design|)
    !dbTitle.append(|Piping Draft|)
    !dbTitle.append(|Piping Spooler|)
    !dbTitle.append(|Equipment Design|)
    !dbTitle.append(|Equipment Draft|)
    !dbTitle.append(|Structural Design|)
    !dbTitle.append(|Structural Draft|)
    !dbTitle.append(|Cats and Specs Design|)
    !dbTitle.append(|Cats and Specs Catalogue|)
    !dbTitle.append(|Cats and Specs Draft|)

    -- Loop through the array of databases
    do !i indices !dbList

      -- Make command template
      !command = !commandTemplate.replace(|dbname|,!dbList[!i])

      -- Show prompt
      !promptString = |Performing load on database |+!dbList[!i]+|...|
      prompt |$!promptString|

      -- Execute command
      $!command
      handle any
        !installData.append(|The |+!dbTitle[!i]+| data failed to load (may already exist)|)
      elsehandle none
        !installData.append(!dbTitle[!i]+| data: Load successful. Db |+!dbList[!i])
      endhandle

      prompt dismiss

    enddo

    ------------------------------
    -- Create and populate MDBs --
    ------------------------------
    prompt |Creating sample MDBs...|

    CREATE MDB /SAMPLE
    handle (1,5)
      -- Already exists
    elsehandle none

      ADD SAMPLE/DESI         1
      ADD SAMPLE/PADD         2
      ADD ADMIN/PADD          3
      ADD MASTER/PIPECATA     4
      ADD MASTER/PIPEOLD      5
      ADD MASTER/STLCATA      6
      ADD MASTER/HVACCATA     7
      ADD MASTER/SUPPCATA     8
      ADD MASTER/EQUICATA     9
      ADD MASTER/EQUITMPL    10
      ADD MASTER/ASLCATA     11
      ADD MASTER/PADD        12
      ADD MASTER/DICT        13
      ADD MASTER/PROP        14

    endhandle

    CREATE MDB /DEMO
    handle (1,5)
      -- Already exists
    elsehandle none

      ADD DEMO/DESI           1
      ADD DEMO/PADD           2
      ADD ADMIN/PADD          3
      ADD MASTER/PIPECATA     4
      ADD MASTER/PIPEOLD      5
      ADD MASTER/STLCATA      6
      ADD MASTER/HVACCATA     7
      ADD MASTER/SUPPCATA     8
      ADD MASTER/EQUICATA     9
      ADD MASTER/EQUITMPL    10
      ADD MASTER/ASLCATA     11
      ADD MASTER/PADD        12
      ADD MASTER/DICT        13
      ADD MASTER/PROP        14

    endhandle

    CREATE MDB /HANGER
    handle (1,5)
      -- Already exists
    elsehandle none

      ADD HANGER/DESI         1
      ADD HANGER/PADD         2
      ADD ADMIN/PADD          3
      ADD MASTER/PIPECATA     4
      ADD MASTER/PIPEOLD      5
      ADD MASTER/STLCATA      6
      ADD MASTER/HVACCATA     7
      ADD MASTER/SUPPCATA     8
      ADD MASTER/EQUICATA     9
      ADD MASTER/EQUITMPL    10
      ADD MASTER/ASLCATA     11
      ADD MASTER/PADD        12
      ADD MASTER/DICT        13
      ADD MASTER/PROP        14

    endhandle

    CR MDB /HVAC
    handle (1,5)
      -- Already exists
    elsehandle none

      ADD HVAC/DESI           1
      ADD HVAC/PADD           2
      ADD ADMIN/PADD          3
      ADD MASTER/PIPECATA     4
      ADD MASTER/PIPEOLD      5
      ADD MASTER/STLCATA      6
      ADD MASTER/HVACCATA     7
      ADD MASTER/SUPPCATA     8
      ADD MASTER/EQUICATA     9
      ADD MASTER/EQUITMPL    10
      ADD MASTER/ASLCATA     11
      ADD MASTER/PADD        12
      ADD MASTER/DICT        13
      ADD MASTER/PROP        14

    endhandle

    CREATE MDB /PIPE
    handle (1,5)
      -- Already exists
    elsehandle none

      ADD PIPE/DESI           1
      ADD PIPE/PADD           2
      ADD ADMIN/PADD          3
      ADD PIPE/ISOD           4
      ADD MASTER/PIPECATA     5
      ADD MASTER/PIPEOLD      6
      ADD MASTER/STLCATA      7
      ADD MASTER/HVACCATA     8
      ADD MASTER/SUPPCATA     9
      ADD MASTER/EQUICATA    10
      ADD MASTER/EQUITMPL    11
      ADD MASTER/ASLCATA     12
      ADD MASTER/PADD        13
      ADD MASTER/DICT        14
      ADD MASTER/PROP        15

    endhandle

    CREATE MDB /STRUC
    handle (1,5)
      -- Already exists
    elsehandle none

      ADD STRUC/DESI          1
      ADD STRUC/PADD          2
      ADD ADMIN/PADD          3
      ADD MASTER/PIPECATA     4
      ADD MASTER/PIPEOLD      5
      ADD MASTER/STLCATA      6
      ADD MASTER/HVACCATA     7
      ADD MASTER/SUPPCATA     8
      ADD MASTER/EQUICATA     9
      ADD MASTER/EQUITMPL    10
      ADD MASTER/ASLCATA     11
      ADD MASTER/PADD        12
      ADD MASTER/DICT        13
      ADD MASTER/PROP        14

    endhandle

    CREATE MDB /CATS
    handle (1,5)
      -- Already exists
    elsehandle none

      ADD CATS/DESI           1
      ADD CATS/CATA           2
      ADD CATS/PADD           3
      ADD ADMIN/PADD          4
      ADD MASTER/PIPECATA     5
      ADD MASTER/PIPEOLD      6
      ADD MASTER/STLCATA      7
      ADD MASTER/HVACCATA     8
      ADD MASTER/SUPPCATA     9
      ADD MASTER/EQUICATA    10
      ADD MASTER/EQUITMPL    11
      ADD MASTER/ASLCATA     12
      ADD MASTER/PADD        13
      ADD MASTER/DICT        14
      ADD MASTER/PROP        15

    endhandle

    CREATE MDB /EQUI
    handle (1,5)
      -- Already exists
    elsehandle none

      ADD EQUI/DESI           1
      ADD EQUI/PADD           2
      ADD ADMIN/PADD          3
      ADD MASTER/EQUICATA     4
      ADD MASTER/EQUITMPL     5
      ADD MASTER/ASLCATA      6
      ADD MASTER/PIPECATA     7
      ADD MASTER/PIPEOLD      8
      ADD MASTER/STLCATA      9
      ADD MASTER/HVACCATA    10
      ADD MASTER/SUPPCATA    11
      ADD MASTER/PADD        12
      ADD MASTER/DICT        13
      ADD MASTER/PROP        14

    endhandle

    prompt dismiss

    -----------------------------
    -- Edit module definitions --
    -----------------------------
    -- pur 33965 fixed AK
    --EDIT MODULE DESIGN   IMACRO /%DESSTART%
    --EDIT MODULE DRAFT    IMACRO /%DRASTART%
    --EDIT MODULE ISODRAFT IMACRO /%ISOSTART%
    --EDIT MODULE PARAGON  IMACRO /%CATSTART%
    EDIT MODULE PARAGON  MODE PROP RW

    !installData.append(|Sample project installation complete|)

  endif

  -- Display the Installation Log data form

  if (Undefined (!!installLog)) then
     !!loadForm ('installLog')
  endif

  !!installLog.logData.dtext = !installData
  !!installLog.show()
  !installData.delete()

  -- Update the admin elements form
  !!adminElem.update('DB')

endfunction
-- End of function definition for !!installCadc
