--
--
-- Description:
-- Function to delete the selected inter-db macros.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!interDbMacroDel()

  -- Collect values from the list gadget
  !macro       = !!interDbMacro.macro.selection('rtext')

  -- Check to see if there is a value
  if (!macro.empty()) then

    -- No macro to delete
    !!messageFile.error(150, 064)

  endif

  -- Get the user to confirm the deletion
  !answer     = !!alert.confirm(!!messageFile.messageString(150, 061, !macro))
  if (!answer.boolean().not()) then
    return
  endif

  -- Delete the macro
  DELETE MACRO $!macro
  handle any

    -- Unable to delete macro
    !!messageFile.error(150, 65, !macro, !!error.text)
    handle (03, 065)
      -- Dummy handle
    endhandle

  endhandle

  -- Rebuild the list
  call !!interDbMacroInit()

endfunction
-- End of function definition for !!interDbMacroDel
