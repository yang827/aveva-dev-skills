--
--
-- Description:
-- Function to initialise the list of project inter-db macros.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!interDbMacroInit()

  -- Initialise variables
  !macros   = MACROS
  !dText    = ARRAY()
  !rText    = ARRAY()

  -- Clear the current list of texts
  !!interDbMacro.macro.clear()

  -- Set the macro count
  !!interDbMacro.count.val = !macros.size().string()

  -- Check that we have some macros
  if (!macros.size() eq 0) then
    return
  endif
  !heading[1] = '#'   !heading[2] = 'From Database' !heading[3] = 'To Database' !heading[4] = 'Filename'
  -- Build the display texts
  do !i indices !macros

    -- Fix for pur 36228
    -- It is possible for the 'to' or 'from' value to be unset

    -- Process the 'from'
    if (!macros[!i].from.unset()) then
      !fromText = 'Unknown'
    else
      if (!macros[!i].from.name.set()) then
        !fromText = !macros[!i].from.name
      else
        !fromText = 'Unknown'
      endif
    endif

    -- Process the 'to'
    if (!macros[!i].to.unset()) then
      !toText = 'Unknown'
    else
      if (!macros[!i].to.name.set()) then
        !toText = !macros[!i].to.name
      else
        !toText = 'Unknown'
      endif
    endif

   -- End of fix for pur 36228

    -- Construct texts
    !numbText    = |   | + !macros[!i].number.string()
    !fromText    = !fromText + |                                          |
    !toText      = !toText   + |                                          |
    !dispText   = !numbText.substring(-3,3)  & '	' &  $
                  !fromText.substring(1,30)  & '	' &  $
                  !toText.substring(1,30)  & '	' &  $
                  !macros[!i].filename

    !dText.append(!dispText)
    !rText.append(!macros[!i].number.string())

  enddo

  -- Assign list gadget values
  !!interDbMacro.macro.setHeadings(!heading)
  !!interDbMacro.macro.dText = !dText
  !!interDbMacro.macro.rText = !rText


endfunction
-- End of function definition for !!interDbMacroInit
