--
--
-- Description:
-- Function to load the monitor admin defaults.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!monAdmLoadDflts()

  -- Initialise variables
  !defaultFiles   = ARRAY()

  -- Load the Admin defaults
  !defaultFiles   = !!searchpaths('mon-admin.pmldat')
  if (!defaultFiles.set()) then


    -- Found some defaults
    !defaultFiles.invert()

    -- Load the closest to user defaults
    !!runMacro(!defaultFiles[1].file.fullname(),'')
    handle ANY

      -- Bad file format
      !!messageFile.warning(146, 014,  'Monitor Admin Defaults',  !defaultFiles[1].file.fullname(),  '- incorrect format')

    endhandle

    -- No data set so use a defaults value
    if (undefined(!!monAdminDflts)) then
      !!monAdminDflts  = object MONADMINDFLTS()
      !!monAdminDflts.chPass   = false
    endif

    -- Clear the array
    !defaultFiles.clear()

  else

    -- No file set so use a defaults value
    !!monAdminDflts  = object MONADMINDFLTS()
    !!monAdminDflts.chPass   = false

  endif

endfunction
-- End of function definition for !!monAdmLoadDflts
