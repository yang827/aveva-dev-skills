--
--
-- Description:
-- Function to read the project attribute selected in the option
-- gadget and post value to the associated text pane.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!projectInfoAttr()

  -- Initialise variables
  !project   = CURRENT PROJECT
  !attribute = !!projectInfo.set.selection(|RTEXT|)

  -- Check for gadget state
  if (!attribute eq |Name|) then

    -- Project NAME
    !value   = !project.name()

  elseif (!attribute eq |Number|) then

    -- Project NUMBER
    !value   = !project.number()

  elseif (!attribute eq |Description|) then

    -- Project DESCRIPTION
    !value   = !project.description()

  elseif (!attribute eq |Message|) then

    -- Project MESSAGE
    !value   = !project.message()

  endif

  -- Set the value in the text field
  if (!value.unset()) then

    !!projectInfo.value.val  = |unset|

  else

    !!projectInfo.value.val  = !value

  endif


endfunction
-- End of function definition for !!projectInfoAttr
