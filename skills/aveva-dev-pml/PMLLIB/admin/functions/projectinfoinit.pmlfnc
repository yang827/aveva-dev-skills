--
-- Description:
-- Function to initialise the project information form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!projectInfoInit()

  -- Initialise variables
  !project   = CURRENT PROJECT

  !!projectInfo.piName = !project.name()
  !!projectInfo.piNumber = !project.number()
  !!projectInfo.piDesc = !project.description()
  !!projectInfo.piMessage = !project.message()

  -- Set project code
  !!projectInfo.code.val    = !project.code()
  var !maxUsers MAXUSERS
  !!projectInfo.maxUser.val = !maxUsers

  -- Generate the textpane contents
  call !!projectInfoPane()

  -- Get the value for the selected attribute
  call !!projectInfoAttr()

endfunction
-- End of function definition for !!projectInfoInit
