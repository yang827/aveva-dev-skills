--
-- Description:
-- Function to set the current project data.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   None
-- Return:
--   None
--
------------------------------------------------------------------------

-- Define function
define function !!projectInfoOk()

  -- Set the attribute
  if (not unset (!!projectInfo.piName)) then
    PROJECT NAME '$!!projectInfo.piName'
  endif

  if (not unset (!!projectInfo.piNumber)) then
    PROJECT NUMBER '$!!projectInfo.piNumber'
  endif

  if (not unset (!!projectInfo.piDesc)) then
    PROJECT DESCRIPTION '$!!projectInfo.piDesc'
  endif

  if (not unset (!!projectInfo.piMessage)) then
    PROJECT MESSAGE '$!!projectInfo.piMessage'
  endif

  if (!!projectInfo.maxUser.val.trim().length() gt 0) then
    MAXUSER $!!projectInfo.maxUser.val
  endif

endfunction
-- End of function definition for !!projectInfoOk
