--
--
-- Description:
-- Function to control the contents on the project information
-- text pane.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!projectInfoPane()

  -- Initialise variables
  !textLines = ARRAY()
  !dispList  = ARRAY()


  -- Process project name
  if (unset (!!projectInfo.piName)) then

    !dispList.append(|Name        : unset|)

  else

    !compose    = |space 0 '|& !!projectInfo.piName &|' width 40|
    !textLines  = !!composeText(!compose)

    -- Process the lines
    do !i indices !textLines

     if (!i eq 1) then
       !textLines[!i] = |Name        : |&!textLines[!i]
     else
       !textLines[!i] = |            : |&!textLines[!i]
     endif

    enddo

    -- Add the lines to the display texts
    !dispList.appendArray(!textLines)

  endif
  -- Add a blank line
  !dispList.append(| |)

  -- Process project number
  if (unset (!!projectInfo.piNumber)) then

    !dispList.append(|Number      : unset|)

  else

    !dispList.append(|Number      : |&!!projectInfo.piNumber)

  endif
  -- Add a blank line
  !dispList.append(| |)



  -- Process the project description
  if (unset (!!projectInfo.piDesc)) then

    !dispList.append(|Description : unset|)

  else

    !compose    = |space 0 '|& !!projectInfo.piDesc &|' width 40|
    !textLines  = !!composeText(!compose)

    -- Process the line list
    do !i indices !textLines

      if (!i eq 1) then
        !textLines[!i] = |Description : |& !textLines[!i]
      else
        !textLines[!i] = |            : |& !textLines[!i]
      endif

    enddo

    -- Add the lines to the display list
    !dispList.appendArray(!textLines)

  endif
  -- Add a blank line
  !dispList.append(| |)

  -- Process the project message
  if (unset (!!projectInfo.piMessage)) then

    !dispList.append(|Message     : unset|)

  else

    !compose    = |space 0 '|& !!projectInfo.piMessage &|' width 40|
    !textLines  = !!composeText(!compose)

    -- Process the line list
    do !i indices !textLines

      if (!i eq 1) then
        !textLines[!i] = |Message     : |& !textLines[!i]
      else
        !textLines[!i] = |            : |& !textLines[!i]
      endif

    enddo

    -- Add the lines to the display list
    !dispList.appendArray(!textLines)

  endif

  -- Display the project details
  !!projectInfo.projectAtt.val = !dispList


endfunction
-- End of function definition for !!projectInfoPane
