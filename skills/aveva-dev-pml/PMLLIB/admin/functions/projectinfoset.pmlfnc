--
--
-- Description:
-- Function to set one specific attribute of the current project data.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!projectInfoSet()

  -- Initialise variables
  !attribute  = !!projectInfo.set.selection(|RTEXT|)
  !value      = !!projectInfo.value.val


  -- Check for a null value
  if (!value.empty() or !value eq |unset|) then

    !!projectInfo.value.val = |unset|
    !value                  = ||

  endif


  -- Set the attribute
  if (!attribute eq |Name|) then

    !!projectInfo.piName = !value

  elseif (!attribute eq |Number|) then

    if (!value.length() gt 16) then
      !!messageFile.warning(141, 016)
      !!projectInfo.value.val = !value.substring(1,16)
    endif
    !!projectInfo.piNumber = !value

  elseif (!attribute eq |Description|) then

    !!projectInfo.piDesc = !value

  elseif (!attribute eq |Message|) then

    !!projectInfo.piMessage = !value

  endif


  -- Rebuild the text pane
  call !!projectInfoPane()


endfunction
-- End of function definition for !!projectInfoSet
