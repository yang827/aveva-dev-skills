--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Tue Dec 15 11:50:48 GMT 1998
--
--
-- Description:
-- An object to store an ACR in an DB independent data object, also includes methods to deal with these
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  acr2AdmAcr(DBREF)                -                   Converts a dbRef/acr into an ADMACR, only is valid for current sys db
--  deleteAcr()                      -                   Method to delete a 'real' ACR
--  goReal()                         -                   Converts virtual ADMACR into a actual ACR
--  goVirtual(DBREF)                 -                   Converts a dbRef/acr into an ADMACR, takes names instead of dbRefs
--  modifyAcr(DBREF)                 -                   Method to modify an existing acr if necessary
--  newAcr()                         -                   To create an Dbref/ACR from an ADMACR
--
------------------------------------------------------------------------

define object ADMACR
  member .name        is STRING
  member .description is STRING
  -- use in acr2AdmAcr()
  member .rolRef      is DBREF
  member .scoRef      is DBREF
  -- used instead in goVirtual()
  member .acrRefs     is ARRAY
  member .acrRefName  is STRING
  member .rolRefName  is STRING
  member .scoRefName  is STRING
  member .type        is STRING
  member .dbRef       is DBREF
endobject
-- End of object definition for ADMACR
------------------------------------------------------------------------
--
-- Method:  .acr2AdmAcr()
--
-- Description: Converts a dbRef/acr into an ADMACR, only is valid for current sys db
-- once taken out of context it is useless! (see goVirtual())
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      DBREF       The dbRef of the acr to be stored
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .acr2AdmAcr(!dbRef is DBREF)
  !this.name        = !dbRef.name
  !this.description = !dbRef.description
  !this.rolRef      = !dbRef.roleRef
  !this.scoRef      = !dbRef.scopeRef
  !this.dbRef       = !dbRef
  !this.type        = !dbRef.type
endmethod
-- End of method definition for .acr2AdmAcr(DBREF)
------------------------------------------------------------------------
--
-- Method:  .newAcr()
--
-- Description: To create an Dbref/ACR from an ADMACR
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--    DBREF       The acr created by this method
------------------------------------------------------------------------
define method .newAcr()
  !prevPos = !!ce
  -- TO get to the ACRLI World
  !!ce = !!dbrAdminGetWorld(|ACR|)
   call !!admCommand(|NEW ACR|)
  if(!this.name.empty() EQ FALSE)then
      call !!admCommand(|NAME $!this.name|)
     handle any
      -- ##
       call !!admCommand(|DELETE ACR|)
      return error 1 |The name specified is invalid for this ACR|
    endhandle
  endif
  if(!this.description.empty() EQ FALSE)then
    !temp =  !this.description.trim('LR','|').trim()
    if (!temp.substring(1,1).eq(|'|) and !temp.substring(-1,1).eq(|'|)) then
        !temp = !temp.trim('LR',|'|)
        !descript = |Desc | & '|' & |$!temp| & '|'
    else
         !descript = |Desc | & '|' & |$!temp| & '|'
    endif

       call !!admCommand(!descript)
  endif
  if((!this.rolRef.type EQ |ROLE|) AND (!this.rolRef.set()))then
     call !!admCommand(|ROLEREF $!this.rolRef.name|)
    handle any
      -- ##
       call !!admCommand(|DELETE ACR|)
      return error 2 |The ROLE reference specified is invalid for this ACR|
    endhandle
  endif
  if((!this.scoRef.type EQ |SCOPE|) AND (!this.scoRef.set()))then
     call !!admCommand(|SCOPEREF $!this.scoRef.name|)
    handle any
      -- ##
       call !!admCommand(|DELETE ACR|)
      return error 3 |The SCOPE reference specified is invalid for this ACR|
    endhandle
  endif
  !result = !!ce
  !!ce = !prevPos
endmethod
-- End of method definition for .newAcr()
------------------------------------------------------------------------
--
-- Method:  .modifyAcr()
--
-- Description: Method to modify an existing acr if necessary
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      DBREF       The dbRef of the acr to be changed
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyAcr(!dbRef is DBREF)
  if(!dbRef.type EQ |ACR|)then
    !prevPos = !!ce
    !!ce = !dbRef
    if((!this.name NEQ !dbRef.name) AND (!this.name.empty() EQ FALSE))then
      call !!admCommand(|NAME $!this.name|)
      handle any
        return error 1 $!!error.text
      endhandle
    endif
    if((!this.description NEQ !dbRef.description) AND (!this.description.empty() EQ FALSE))then
    !temp =  !this.description.trim('LR','|').trim()
    if (!temp.substring(1,1).eq(|'|) and !temp.substring(-1,1).eq(|'|)) then
        !temp = !temp.trim('LR',|'|)
        !descript = |Desc | & '|' & |$!temp| & '|'
    else
         !descript = |Desc | & '|' & |$!temp| & '|'
    endif

       call !!admCommand(!descript)
    endif
    if((!this.rolRef NEQ !dbRef.roleRef) AND (!this.rolRef.set()))then
      call !!admCommand(|ROLEREF $!this.rolRef.name|)
      handle any
        return error 2 |The ROLE reference specified is invalid for this ACR|
      endhandle
    endif
    if((!this.scoRef NEQ !dbRef.scopeRef) AND (!this.scoRef.set()))then
      call !!admCommand(|SCOPEREF $!this.scoRef.name|)
      handle any
        return error 3 |The SCOPE reference specified is invalid for this ACR|
      endhandle
    endif
    !!ce = !prevPos
  endif
endmethod
-- End of method definition for .modifyAcr(DBREF)
------------------------------------------------------------------------
--
-- Method: deleteAcr()
--
-- Description: Method to delete a 'real' ACR
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteAcr()
  !prev = !!ce
  if(!this.dbRef.unset())then
    return error 4 |The Dbref of the intended ACR doesn't exist|
  endif
  !!ce = !this.dbRef
  call !!admCommand(|DELETE ACR|)
  !!ce = !prev
endmethod
-- End of method definition for .deleteAcr()
------------------------------------------------------------------------
--
-- Method:  .goVirtual()
--
-- Description: Converts a dbRef/acr into an ADMACR, takes names instead of dbRefs
-- for use in other dbs! (see acr2AdmAcr())
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      DBREF       The dbRef of the acr to be stored
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goVirtual(!dbRef is DBREF)
 if (!dbRef.type eq 'ACR') then
  !this.name        = !dbRef.name
  !this.description = !dbRef.description
  if( !dbRef.roleRef.unset() ) then
    !this.rolRefName = '=0/0'
  else
    !this.rolRefName  = !dbRef.roleRef.name
  endif
  if( !dbRef.scopeRef.unset() ) then
    !this.scoRefName = '=0/0'
  else
    !this.scoRefName  = !dbRef.scopeRef.name
  endif
  !this.acrRefName  = '=0/0'
  !this.dbRef       = !dbRef
  !this.type        = !dbRef.type
 elseif (!dbRef.type eq 'ACRST') then
  !this.name        = !dbRef.name
  !this.description = !dbRef.description
  !this.rolRefName  = '=0/0'
  !this.scoRefName  = '=0/0'
  !this.acrRefName  = '=0/0'
  !this.dbRef       = !dbRef
  !this.type        = !dbRef.type
 elseif (!dbRef.type eq 'ACRL') then
  !this.name        = !dbRef.owner.name
  !this.description = ''
  !this.rolRefName  = '=0/0'
  !this.scoRefName  = '=0/0'
  if( !dbRef.acrf.unset() ) then
    !this.acrRefName = '=0/0'
  else
    !this.acrRefName  = !dbRef.acrf.name
  endif
  !this.dbRef       = !dbRef
  !this.type        = !dbRef.type
 endif
endmethod
-- End of method definition for .goVirtual(DBREF)
------------------------------------------------------------------------
--
-- Method:  .goReal()
--
-- Description: Converts virtual ADMACR into a actual ACR
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      DBREF       The dbRef of the acr to be stored
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goReal()
  !prevPos = !!ce

  -- We have 3 different types to watch for. (ACR,ACRST,ACRL)

  !!ce = !!dbrAdminGetWorld(|ACR|)
  !unusedRoleDbref = object DBREF( !this.rolRefName )
  handle any
    !errorMessage = |The ROLE | + !this.rolRefName + | specified for this ACR cannot be found. ACR not created|
    !!alert.warning(|$!errorMessage|)
    return error 2 |$!errorMessage|
  endhandle
  !unusedScopeDbRef = object DBREF( !this.scoRefName )
  handle any
    !errorMessage = |The SCOPE | + !this.scoRefName + | specified for this ACR cannot be found at location | + !!ce.admloc.name + |. ACR not created|
    !!alert.warning(|$!errorMessage|)
    -- return error 3 |$!errorMessage|
  endhandle

  -- *********** ACR *************

  if (!this.type eq 'ACR') then
    if (!!ce.members.size() gt 0) then
      1 LAST
    endif
    call !!admCommand(|NEW ACR|)
    if(!this.name.empty() EQ FALSE)then
      call !!admCommand(|NAME $!this.name|)
      handle any
        -- Just do NOT create it
        call !!admCommand(|DELETE ACR|)
        return error 1 |This ACR already exists or The name specified is invalid for this ACR|
      endhandle
    endif
    if(!this.description.empty() EQ FALSE)then
      !temp = '|' + !this.description + '|'
      call !!admCommand('DESCRIPTION $!temp')
    endif
      call !!admCommand(|ROLEREF $!this.rolRefName|)
      handle any
        call !!admCommand(|DELETE ACR|)
        return error 2 |The ROLE reference specified is invalid for this ACR|
      endhandle
      call !!admCommand(|SCOPEREF $!this.scoRefName|)
      handle any
        call !!admCommand(|DELETE ACR|)
        return error 3 |The SCOPE reference specified is invalid for this ACR|
      endhandle

  -- *********** ACRST *************

  elseif (!this.type eq 'ACRST') then
    if (!!ce.members.size() gt 0) then
      1 LAST
    endif
    call !!admCommand(|NEW ACRST|)
    if(!this.name.empty() EQ FALSE)then
      call !!admCommand(|NAME $!this.name|)
      handle any
        call !!admCommand(|DELETE ACRST|)
        return error 1 |This ACR group already exists or The name specified is invalid for this ACR group|
      endhandle
    endif
    if(!this.description.empty() EQ FALSE)then
      !temp = '|' + !this.description + '|'
      call !!admCommand('DESCRIPTION $!temp')
    endif

  -- *********** ACRL *************

  elseif (!this.type eq 'ACRL') then
    -- Need to navigate to the ACR group
    !!ce = !this.name.dbRef()
    handle any
      return error 1 |This ACR Group does not exists so cannot create a ACRL for it.|
    endhandle
    -- How do we know that this ACRL has not already been created
    do !v values !!ce.members
      if (!v.acrf.name eq !this.acrRefName) then
        -- This ACRL already exists, so don't create another
        return
      endif
    enddo
    if (!!ce.members.size() gt 0) then
      1 LAST
    endif
    call !!admCommand(|ACRADD $!this.acrRefName|)
    handle any
      return error 2 |The ACR reference specified is invalid for this ACRL|
    endhandle
  endif

  !result = !!ce
  !!ce = !prevPos
endmethod
-- End of method definition for .goReal()
