------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(STRING)                      REAL                Add new utility and return index
--  admControl()                     -                   Constructor
--  admControl(REAL)                 -                   Constructor
--  dump()                           ARRAY               Dumps out the utilities and flags to an array
--  dump(STRING)                     -                   Dumps out the utilities and flags to file
--  dumpDisplay(REAL)                ARRAY               Dumps display data
--  dumpHeader(REAL)                 ARRAY               Dumps out header data
--  globalInstance()                 -                   Global Instance of the ADMIN control object
--  initialise()                     -                   Initialise Object
--  isDAC()                          BOOLEAN             True if projects is a DAC enabled
--  isDBSet()                        BOOLEAN             True if projects is a DB Set enabled
--  isGlobal()                       BOOLEAN             True if projects is a global project
--  isValid(STRING)                  BOOLEAN             Returns is passed utility is valid for mode
--  setProjectMode()                 -                   Set project mode
--  setProjectMode(STRING)           -                   Set project mode
--  utility(STRING)                  REAL                Returns the utility index position
--  utility(STRING,BOOLEAN,BOOLEAN,BOOLEAN,BOOLEAN) -                   Define a utility for modes none global, global 1 and global plus
--  utilityForAll(STRING,BOOLEAN)    -                   Define a utility available for all modes
--  utilityForNone(STRING,BOOLEAN)   -                   Define a utility available for no modes
--  utilityOnlyFor(STRING,BOOLEAN,STRING) -                   Define a utility available for all modes
--

define object ADMCONTROL

  -- Current Mode (as defined by /*GL)
  member .mode         is STRING
  member .modeIndex    is REAL

  -- Available modes
  member .modes        is ARRAY

  -- Table of utilities
  member .description  is ARRAY
  member .utility      is ARRAY

  -- Modes for utilities
  member .utilityMode  is ARRAY

  -- Requires Global to be active
  member .globalActive is ARRAY

  -- Project is Global Enabled
  member .global       is BOOLEAN

  -- Project is Data Access Control Enabled
  member .dac          is BOOLEAN

  -- Project is Database Sets Enabled
  member .dbSets       is BOOLEAN

endobject
-- End of object definition

----------------------------------------------------------------------
--
-- Method:      admControl
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .admControl()

  -- Initialise Variables
  !project         = CURRENT PROJECT
  !reference       = !!ce


  -- Define the permissible modes
  !this.modes[1]   = 'NONE'
  !this.modes[2]   = 'GLOBAL'
  !this.modes[3]   = 'GLOBALPLUS'

  -- Check if project is global
  !project         = CURRENT PROJECT
  !this.global     = !project.isGlobal()

  -- Get round to allow us to get to see if the relevant DAC and DBSets exist
  /SYSTEM
  handle ANY
  endhandle

  -- Project is DAC Enabled
  var !exists exists /*SC
  !this.dac        = !exists.subString(1,1).boolean()

  -- Project is Database Sets Enabled
  var !exists exists /*DS
  !this.dbSets     = !exists.subString(1,1).boolean()

  -- Get project mode
  !this.setProjectMode()

  -- Initialise Object
  !this.initialise()

  -- Move back to reference
  !!ce             = !reference
  handle (2,822)
    -- catch case where !reference is not set
  endhandle

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      admControl
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Mode index
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .admControl(!index is REAL)

  -- Initialise Variables
  !this.modeIndex   = !index
  !this.mode        = !this.modes[!index]

  -- Initialise Object
  !this.initialise()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise Object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !project           = CURRENT PROJECT

  -- Global is active
  !this.global       = !this.isGlobal()

  -- Get locations and if we are on/offline
  if(!this.global) then

    -- is Current project location is project administration hub
    !hubLocation   = !!glbHubStatus(!this.global)

    -- Current Location
    !location      = !project.currentLocation().refno.dbref()
    !offline       = !location.iconn.boolean().not()

    -- Same as getting prvrf from /*GL
    !prevHub = !project.currentLocation().refno.dbref().owner.owner.prvrf

    -- Transient hub and current location is old hub
    !transientHub = false
    if (!prevHub.set()) then
      !transientHub = (!prevHub eq !location)
    endif

  -- None Global project
  else
    !offline         = false
    !hubLocation     = false
    !transientHub    = false
  endif

  ------------------------------ Utilities ------------------------------
  !this.utilityForAll('User States',                 false)
  !this.utilityForAll('Users',                       false)
  !this.utilityForAll('Teams',                       false)
  !this.utilityForAll('DBs',                         false)
  !this.utilityForAll('MDBs',                        false)
  !this.utilityForAll('Configuration File',          false)
  !this.utilityForAll('Database Sessions',           false)

  !this.utilityForAll('Change Password',             false)
  !this.utilityForAll('Replicate Project Data',      false)
  !this.utilityForAll('Replicate Project Structure', false)

  -- Global (common to all global modes) uses .isGlobal to check project is global enabled
  !this.utility('Expunge Picture Files',          true,  false, true,  true)
  !this.utility('Expunge DB Files',               true,  false, true,  true)

  !this.utility('Global',                         true,  false, !this.isGlobal(),  !this.isGlobal())

  !this.utility('Locations',                      true,  false, true,  true)
  !this.utility('Location Groups',                true,  false, true,  true)
  !this.utility('Location Updates',               true,  false, true,  true)

  !this.utility('Copy to Location',               true,  false, true,  true)

  !this.utility('Communication Events',           true,  false, true,  true)

  !this.utility('Centralised Admin',              true,  false, true,  true)

  !this.utility('Locking and Isolation',          true,  false, true,  true)


  !this.utility('Replicate Standalone',           true,  false, true,  true)
  !this.utility('Replicate Satellite Structure',  true,  false, true,  true)


  !this.utility('Initialise Location',            true,  false, true,  true)

  !this.utility('DB Allocation',                  true,  false, true,  true)

  !this.utility('Update',                         true,  false, true,  true)
  !this.utility('Synchronise Data',               true,  false, true,  true)

  !this.utility('Remote',                         true,  false, true,  true)

  !this.utility('Remote Merge Changes',           true,  false, true,  true)
  !this.utility('Remote Backtrack',               true,  false, true,  true)

  !this.utility('Remote Locking and Isolation',   true,  false, true,  true)
  !this.utility('Remote Synchronise',             true,  false, true,  true)
  !this.utility('Remote Update',                  true,  false, true,  true)
  !this.utility('Remote Recover DB',              true,  false, true,  true)
  !this.utility('Remote Expunge',                 true,  false, true,  true)
  !this.utility('Remote Integrity Checker',       true,  false, true,  true)
  !this.utility('Remote Admin Only At Hub',       true,  false, false, false)

  ------------------------------ Derived utilities ------------------------------

  -->>>>>>>>>>>>>>>>>> Data Access Control available for all - Only if its available
  if(!this.isDAC()) then
    !this.utility('Data Access Control', false,  true, true, true)
  else
    !this.utilityForNone('Data Access Control', false)
  endif

  -->>>>>>>>>>>>>>>>>> Database Sets available for all - Only if its available
  if(!this.isDBSet()) then
    !this.utilityForAll('Database Sets',  false)
  else
    !this.utilityForNone('Database Sets', false)
  endif

  -->>>>>>>>>>>>>>>>>> Communications
  !this.utility('Communications', true, false, !offline.not(), !offline.not())

  -->>>>>>>>>>>>>>>>>> Daemon Setting
  !daemon          = !this.global.and(!offline.not())
  !this.utility('Daemon', true, false, !daemon, !daemon)

  -->>>>>>>>>>>>>>>>>> Global Extract Range (Only global plus)
  !extractRange    = !this.global.and(!hubLocation)
  !this.utility('Global Extract Range', true, false, !extractRange, !extractRange)

  -->>>>>>>>>>>>>>>>>> Extract
--  !extract         = !this.global.and(!hubLocation)
  !this.utility('Extracts', false, true, true, true)

  -->>>>>>>>>>>>>>>>>> Offline Transfer
  -- Disable at On-line satellites, but allow at the Hub
  !offLineTransfer = !hubLocation.or(!offline)
  !this.utility('Offline Transfer',               true,  false, !offLineTransfer, !offLineTransfer)

  -->>>>>>>>>>>>>>>>>> Recover
  !this.utility('Recover',                        true,  false, true,  true)
  !this.utility('Recover Primary Location',       true,  false, !hubLocation,  !hubLocation)
  !this.utility('Recover Hub',                    true,  false, !transientHub, !transientHub)

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      setProjectMode
--
-- Description: Set project mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setProjectMode()

  -- Initialise Variables
  !project     = CURRENT PROJECT

  -- Check if /*GL exists
  !unusedGlobalWorld = !project.currentLocation().refno.dbref().owner.owner
  handle ANY
    !this.setProjectMode('NONE')
  elsehandle NONE
    --!this.setProjectMode(!globalWorld.glbVersion)
    -- Hard code this to be GLOBAL (See DFN1111)
    !this.setProjectMode('GLOBAL')
  endhandle

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      setProjectMode
--
-- Description: Set project mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setProjectMode(!mode is STRING)

  -- Initialise Variables

  -- Get mode index
  !index          = !this.modes.findFirst(!mode.trim(' ', 'LMR').upcase())

  -- If index is unset, assume 1
  if(!index.unset()) then
    !index        = 1
  endif

  !this.modeIndex = !index
  !this.mode      = !this.modes[!index]

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      isValid
--
-- Description: Returns is passed utility is valid for mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Utility name/key
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if valid
--
------------------------------------------------------------------------

define method .isValid(!name is STRING) is BOOLEAN

  -- Initialise Variables
  !index = !this.utility(!name)

  -- If index if unset, then assume utility is valid
  if(!index.unset()) then
    return true
  else

    -- Check if global is required to be active and if it is active
    if(!this.global.not() and !this.globalActive[!index]) then
      return false
    endif

    -- Return current mode flag
    return !this.utilityMode[!index][!this.modeIndex]
  endif

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      isGlobal
--
-- Description: True if projects is a global project
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if global project
--
------------------------------------------------------------------------

define method .isGlobal() is BOOLEAN

  --!project = CURRENT PROJECT
  --return !project.isGlobal()
  return !this.global

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      isDAC
--
-- Description: True if projects is a DAC enabled
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if DAC enabled
--
------------------------------------------------------------------------

define method .isDAC() is BOOLEAN

  -- Check for existence of /*SC
  --var !exists exists /*SC
  --return !exists.subString(1,1).boolean()
  return !this.dac

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      isDBSet
--
-- Description: True if projects is a DB Set enabled
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if DB Set enabled
--
------------------------------------------------------------------------

define method .isDBSet() is BOOLEAN

  -- Check for existence of /*DS
  --var !exists exists /*DS
  --return !exists.subString(1,1).boolean()
  return !this.dbSets

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add new utility and return index
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Utility name/key
-- Return:
--   [Data Type] [Description]
--    REAL        Utility index
--
------------------------------------------------------------------------

define method .add(!name is STRING) is REAL

  -- Get new index
  !index                     = !this.utility.size() + 1
  !this.description[!index]  = !name
  !this.utility[!index]      = !name.trim(' ','LMR').upcase()
  !this.utilityMode[!index]  = ARRAY()
  !this.globalActive[!index] = false

  -- Return
  return !index

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      utility
--
-- Description: Returns the utility index position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Utility name/key
-- Return:
--   [Data Type] [Description]
--    REAL        Utility index
--
------------------------------------------------------------------------

define method .utility(!name is STRING) is REAL

  -- Initialise Variables
  !key   = !name.trim(' ','LMR').upcase()

  -- Return index number
  return !this.utility.findFirst(!key)

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      utility
--
-- Description: Define a utility for modes none global, global 1 and global plus
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Utility name/key
--    2   R      BOOLEAN     Requires global to be active
--    3   R      BOOLEAN     None Global flag
--    4   R      BOOLEAN     Global 1 flag
--    5   R      BOOLEAN     Global Plus flag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .utility(!name is STRING, !globalRequired is BOOLEAN, !noneGlobal is BOOLEAN, !global1 is BOOLEAN, !globalPlus is BOOLEAN)

  -- Initialise Variables

  -- Check for entry
  !index = !this.utility(!name)

  -- If index exist, the replace with new values
  if(!index.unset()) then
    !index = !this.add(!name)
  endif

  -- Global Required
  !this.globalActive[!index]   = !globalRequired

  -- Set utility mode flags
  !this.utilityMode[!index][1] = !noneGlobal
  !this.utilityMode[!index][2] = !global1
  !this.utilityMode[!index][3] = !globalPlus

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      utilityForAll
--
-- Description: Define a utility available for all modes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Utility name/key
--    2   R      BOOLEAN     Requires global to be active
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .utilityForAll(!name is STRING, !globalRequired is BOOLEAN)

  -- Quick method, if we include more mode then we will need to define
  -- all the utilityMode flags, not just the three current ones
  !this.utility(!name, !globalRequired, true, true, true)

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      utilityForNone
--
-- Description: Define a utility available for no modes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Utility name/key
--    2   R      BOOLEAN     Requires global to be active
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .utilityForNone(!name is STRING, !globalRequired is BOOLEAN)

  -- Quick method, if we include more mode then we will need to define
  -- all the utilityMode flags, not just the three current ones
  !this.utility(!name, !globalRequired, false, false, false)

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      utilityOnlyFor
--
-- Description: Define a utility available for all modes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Utility name/key
--    2   R      BOOLEAN     Requires global to be active
--    3   R      STRING      Mode available for
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .utilityOnlyFor(!name is STRING, !globalRequired is BOOLEAN, !mode is STRING)

  -- Initialise Variables
  !modeKey = !mode.trim(' ','LMR').upcase().replace(' ','')

  -- Crude mechanism at present
  if(!modeKey eq 'GLOBAL1') then
    !this.utility(!name, !globalRequired, false, true,  false)
  elseif (!modeKey eq 'GLOBALPLUS') then
    !this.utility(!name, !globalRequired, false, false, true)
  else
    !this.utility(!name, !globalRequired, true , false, false)
  endif

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Global Instance of the ADMIN control object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .globalInstance()

  -- Initialise Variables
  !!admControl = !this

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      dump
--
-- Description: Dumps out the utilities and flags to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      File name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dump(!filename is STRING)

  -- Initialise Variables
  !file = object FILE(!filename)

  -- Overwrite existing file
  if(!file.exists()) then
    if(!!alert.confirm('OK to overwrite file "' & !file.fullname() & '" ?').boolean().not()) then
      return
    endif
  endif

  -- Write data to file
  !file.writefile('overwrite', !this.dump())

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      dumpHeader
--
-- Description: Dumps out header data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Width of flag field
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of table
--
------------------------------------------------------------------------

define method .dumpHeader(!fW is REAL) is ARRAY

  -- Initialise Variables
  !dW            = !this.description.width()

  -- Compose Header
  var !header compose            space 2               'Description' width $!<dW> c space 2 'Global Active'         width $!<fW> c space 2 'None Global'       width $!<fW> c $
space 2 'Global 1'         width $!<fW> c space 2 'Global Plus'         width $!<fW> c

  -- Return header
  return !header

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      dumpDisplay
--
-- Description: Dumps display data
--
-- Method Type: Function/Procedure
-- Arguments:
--    1   R      REAL        Width of flag field
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Two dimensional Array of Display test and sort order
--
------------------------------------------------------------------------

define method .dumpDisplay(!fW is REAL) is ARRAY

  -- Initialise Variables
  !dW            = !this.description.width()
  !descriptions  = !this.description

  -- Convert flags into strings
  do !i indices !this.utilityMode
    !none[!i]    = !this.utilityMode[!i][1].string()
    !g1[!i]      = !this.utilityMode[!i][2].string()
    !gPlus[!i]   = !this.utilityMode[!i][3].string()

    !gActive[!i] = !this.globalActive[!i].string()
  enddo

  -- Sort descriptions
  var !sort sort !descriptions ascii

  -- Compose list
  var !output compose sort !sort space 2 column values !descriptions width $!<dW>    space 2  column values !gActive width $!<fW> c space 2 column values !none width $!<fW> c $
space 2  column values !g1 width $!<fW> c space 2  column values !gPlus width $!<fW> c

  -- Return data
  !return[1] = !output
  !return[2] = !sort
  return !return

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      dump
--
-- Description: Dumps out the utilities and flags to an array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of table
--
------------------------------------------------------------------------

define method .dump() is ARRAY

  -- Initialise Variables
  !fW           = 6

  -- Header
  !header  = !this.dumpHeader(!fW)

  -- Basic display text of utilities
  !output  = !this.dumpDisplay(!fW)[1]

  -- Define output
  !return  = ARRAY()

  !date    = object DATETIME()
  !session = current session

  !return.append('Current Administrator Control Table Settings')
  !return.append('')
  !return.append('  Created by : ' & !session.name)
  !return.append('  Created on : ' & !date)
  !return.append('')
  !return.append(' Global Mode : ' & !this.mode)
  !return.append('      Active : ' & !this.global)
  !return.append('')
  !return.appendArray(!header)
  !return.append('')
  !return.appendArray(!output)

  -- Return
  return !return

endmethod
-- End of method
