--
--Method: .deleteFile()
--
-- Description: delete()
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteFile()
  !toBeDeleted = object FILE(|%PDMSUSER%/| + !!sessionSettings.user + |_admDisplayConfig.dat|)
  !toBeDeleted .deleteFile()
endmethod
-- End of method definition for .deleteFile()
