--
--
-- Description:
-- Object to store, save, and load user default settings for admin module
-- .
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admDisplayConfig()               -                   constructor for this object
--  deleteFile()                     -                   delete()
--  eleTypeGet()                     BOOLEAN             to return a state indicating whether <db> etc. should be used
--  eleTypeSet(BOOLEAN)              -                   method to set a variable saying whether <db> etc. should be used
--  fmtAcrGet()                      ACRLISTATTR         method to return the Admin acr element list format object
--  fmtAcrSet(ACRLISTATTR)           -                   method to store the Admin acr element list format object
--  fmtDbGet()                       DBLISTATTR          method to store the Admin DB element list format object
--  fmtDbSet(DBLISTATTR)             -                   method to store the Admin DB element list format object
--  fmtDbSetGet()                    DBSETLISTATTR       method to return the Admin DBSet element list format object
--  fmtDbSetSet(DBSETLISTATTR)       -                   method to store the Admin DBSET element list format object
--  fmtMdbGet()                      MDBLISTATTR         method to return the Admin MDB element list format object
--  fmtMdbSet(MDBLISTATTR)           -                   method to store the Admin MDB element list format object
--  fmtOrderedDbGet()                DBLISTATTR          method to store the Admin DB element list format object
--  fmtStampGet()                    STAMPLISTATTR       method to return the Admin STAMP element list format object
--  fmtStampSet(STAMPLISTATTR)       -                   method to store the Admin STAMP element list format object
--  fmtTeamGet()                     TEAMLISTATTR        method to return the Admin TEAM element list format object
--  fmtTeamSet(TEAMLISTATTR)         -                   method to store the Admin TEAM element list format object
--  fmtUserGet()                     USERLISTATTR        method to return the Admin USER element list format object
--  fmtUserSet(USERLISTATTR)         -                   method to store the Admin USER element list format object
--  getSize()                        REAL                to return a expected size of the Admin Elements form
--  load()                           -                   loads the saved configuration of a user
--  reset()                          -                   method to set defaults back factory made settings
--  save()                           -                   method to save defaults to a file
--  setSize(REAL)                    -                   method to set a variable declaring size of admin elements form
--
------------------------------------------------------------------------
-- Define Object
define object ADMDISPLAYCONFIG

  member .dbFormat is DBLISTATTR
  member .mdbFormat is MDBLISTATTR
  member .teamFormat is TEAMLISTATTR
  member .userFormat is USERLISTATTR
  member .dbSetFormat is DBSETLISTATTR
  member .acrFormat is ACRLISTATTR
  member .stampFormat is STAMPLISTATTR
  member .typeIndicator is BOOLEAN
  member .adminElemSize is REAL

  -- The filename this could be stored in!
  member .filename is STRING

endobject
-- End of object definition for ADMDISPLAYCONFIG
------------------------------------------------------------------------
--
--Method: .admDisplayConfig()
--
-- Description: constructor for this object
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .admDisplayConfig()
  !this.filename = !!sessionSettings.user + |_admDisplayConfig.dat|
endmethod
-- End of method definition for .admDisplayConfig()
------------------------------------------------------------------------
--
--Method: .reset()
--
-- Description: method to set defaults back factory made settings
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reset()

!globalProj  = !!glbIsGlobal()
  --
  -- Database Elements  (DBLISTATTR)
  --
  !this.dbFormat.name          = true
  !this.dbFormat.typeDb        = true
  !this.dbFormat.dbNo          = true
  !this.dbFormat.description   = true
  if (!globalProj)then
    !this.dbFormat.isprim      = true
  endif
  !this.dbFormat.access        = false
  !this.dbFormat.claim         = false
  !this.dbFormat.filename      = false
  --
  -- User Elements      (USERLISTATTR)
  --
  !this.userFormat.name        = true
  !this.userFormat.password    = false
  !this.userFormat.security    = true
  !this.userFormat.description = true
  --
  -- Team Elements      (TEAMLISTATTR)
  --
  !this.teamFormat.name        = true
  !this.teamFormat.description = true
  --
  -- Mdb Elements       (MDBLISTATTR)
  --
  !this.mdbFormat.name         = true
  !this.mdbFormat.description  = true
  --
  -- DBSET Elements       (DBSETLISTATTR)
  --
  !this.dbSetFormat.name         = true
  !this.dbSetFormat.description  = true

  -- ACR Elements       (ACRLISTATTR)
  --
  !this.acrFormat.name         = true
  !this.acrFormat.description  = true

  -- STAMP Elements     (STAMPLISTATTR)
  --
  !this.stampFormat.name         = true
  !this.stampFormat.date         = true
  !this.stampFormat.function     = true
  !this.stampFormat.description  = true

  !this.typeIndicator = true
  !this.adminElemSize = 45

  !this.filename = !!sessionSettings.user + |_admDisplayConfig.dat|
  if(!!adminElem.shown())then
    !!adminElem.update(!!adminElem.type.selection('rtext'))
  endif
  handle any
    -- Don't do anything!
  endhandle

endmethod
-- End of method definition for .reset()
------------------------------------------------------------------------
--
--Method: .save()
--
-- Description: method to save defaults to a file
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .save()
  !locationsOfFile = !!comGetOptFiles(!this.filename)
  -- Overwrite Existing File
  if(NOT !locationsOfFile.empty())then
    !outputFile = object FILE(!locationsOfFile.last().string())
    !outputFile.open(|OVERWRITE|)
    handle (41,319)
      -- Unable to get Write access, try to create a new file in the users working directory
      !temp = |%PDMSUSER%/| + !this.filename
      !outputFile = object FILE(!temp)
      !outputFile.open(|WRITE|)
      handle (41,319)
        -- the user has probably made the config file in their directory read-only somehow
        -- ##
        !!alert.error(|Unable to open an existing configuration file or create a new one|)
        return
      endhandle
    endhandle
  else
    !temp = |%PDMSUSER%/| + !this.filename
    !outputFile = object FILE(!temp)
    !outputFile.open(|WRITE|)
    handle any
      !!alert.error(|The Saving of User's Config was aborted with error = | + !!error.text)
      return
    endhandle
  endif

  -- By storing a command at each line it allows for partial stores of data

  --
  -- Database Elements  (DBLISTATTR)
  --
  !outputFile.writeRecord(|!!admDisplayConfig.dbFormat.name = | + !this.dbFormat.name.string())
  !outputFile.writeRecord(|!!admDisplayConfig.dbFormat.typeDb = | + !this.dbFormat.typeDb.string())
  !outputFile.writeRecord(|!!admDisplayConfig.dbFormat.dbNo = | + !this.dbFormat.dbNo.string())
  if (!!glbIsGlobal()) then
    !outputFile.writeRecord(|!!admDisplayConfig.dbFormat.isprim = | + !this.dbFormat.isprim.string())
  endif
  !outputFile.writeRecord(|!!admDisplayConfig.dbFormat.description = | + !this.dbFormat.description.string())
  !outputFile.writeRecord(|!!admDisplayConfig.dbFormat.access = | + !this.dbFormat.access.string())
  !outputFile.writeRecord(|!!admDisplayConfig.dbFormat.claim = | + !this.dbFormat.claim.string())
  !outputFile.writeRecord(|!!admDisplayConfig.dbFormat.filename = | + !this.dbFormat.filename.string())
  --
  -- User Elements      (USERLISTATTR)
  --
  !outputFile.writeRecord(|!!admDisplayConfig.userFormat.name = | + !this.userFormat.name.string())
  !outputFile.writeRecord(|!!admDisplayConfig.userFormat.password = | + !this.userFormat.password.string())
  !outputFile.writeRecord(|!!admDisplayConfig.userFormat.security = | + !this.userFormat.security.string())
  !outputFile.writeRecord(|!!admDisplayConfig.userFormat.description = | + !this.userFormat.description.string())
  --
  -- Team Elements      (TEAMLISTATTR)
  --
  !outputFile.writeRecord(|!!admDisplayConfig.teamFormat.name = | + !this.teamFormat.name.string())
  !outputFile.writeRecord(|!!admDisplayConfig.teamFormat.description = | + !this.teamFormat.description.string())
  --
  -- Mdb Elements       (MDBLISTATTR)
  --
  !outputFile.writeRecord(|!!admDisplayConfig.mdbFormat.name = | + !this.mdbFormat.name.string())
  !outputFile.writeRecord(|!!admDisplayConfig.mdbFormat.description = | + !this.mdbFormat.description.string())
  --
  -- DBSET Elements       (DBSETLISTATTR)
  --
  !outputFile.writeRecord(|!!admDisplayConfig.dbSetFormat.name = | + !this.dbSetFormat.name.string())
  !outputFile.writeRecord(|!!admDisplayConfig.dbSetFormat.description = | + !this.dbSetFormat.description.string())
  --
  -- ACR Elements       (ACRLISTATTR)
  --
  !outputFile.writeRecord(|!!admDisplayConfig.acrFormat.name = | + !this.acrFormat.name.string())
  !outputFile.writeRecord(|!!admDisplayConfig.acrFormat.description = | + !this.acrFormat.description.string())
  --
  -- STAMP Elements     (STAMPLISTATTR)
  --
  !outputFile.writeRecord(|!!admDisplayConfig.stampFormat.name = | & !this.stampFormat.name.string())
  !outputFile.writeRecord(|!!admDisplayConfig.stampFormat.date = | & !this.stampFormat.date.string())
  !outputFile.writeRecord(|!!admDisplayConfig.stampFormat.function = | & !this.stampFormat.function.string())
  !outputFile.writeRecord(|!!admDisplayConfig.stampFormat.description = | & !this.stampFormat.description.string())
  --
  !outputFile.writeRecord(|!!admDisplayConfig.typeIndicator = | + !this.typeIndicator.string())
  !outputFile.writeRecord(|!!admDisplayConfig.adminElemSize = | + !this.adminElemSize.string())
  !outputFile.close()

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
--Method: .load()
--
-- Description: loads the saved configuration of a user
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .load()
  -- Get list of file locations
  !locationsOfFile = !!comGetOptFiles(!this.filename)
  if(NOT !locationsOfFile.empty())then
    !inputfile = object FILE(!locationsOfFile.last().string())
    !inputfile.open(|READ|)
    handle (160,9)
      -- File not found - alert user quietly, after setting the object to a default config
      !this.reset()
      write('This user has no defined Display Configuration file')
      return
    endhandle
  else
    !this.reset()
    write('This user has no defined Display Configuration file')
    return
  endif

  do !aline values !inputfile.readfile()
    -- execute line from saved file
    $!aline
    handle any
      -- ##
      !!alert.error(!aline)
      !!alert.error(|The Loading of User's Config was aborted with error = | + !!error.text)
      !this.reset()
      return
    endhandle
  enddo

  !inputfile.close()

  -- Update the Admin elements form
  if(defined(!!adminElem) and !!adminElem.shown())then
    !!adminElem.update(!!adminElem.type.selection('rtext'))
  endif

endmethod
-- End of method definition for .load()
------------------------------------------------------------------------
--
-- Method:      .fmtDbGet()
--
-- Description: method to store the Admin DB element list format object
-- This object is used to display text on DB elements in list gadgets
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBLISTATTR  Format of a database text list to use
--
------------------------------------------------------------------------
-- Define method
define method .fmtDbGet() is DBLISTATTR
  -- Store the value
  return !this.dbFormat
endmethod
-- End of method definition for .fmtDbGet() DBLISTATTR
------------------------------------------------------------------------
--
-- Method:      .fmtOrderedDbGet()
--
-- Description: method to store the Admin DB element list format object
-- This object is used to display text on DB elements in list gadgets
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBLISTATTR  Format of a database text list to use
--
------------------------------------------------------------------------
-- Define method
define method .fmtOrderedDbGet() is DBLISTATTR

  -- DB list format with sequence as first column
  !listFormat = !this.dbFormat
  !listFormat.sequence = true
  !order = !listFormat.order
  !listFormat.order[1] = 'Sequence'
  do !item values !order
    skip if (!item eq 'Sequence')
    !listFormat.order.append(!item)
  enddo
  return !listFormat

endmethod
-- End of method definition for .fmtDbGet() DBLISTATTR
