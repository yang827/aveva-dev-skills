-- Created:         14 June 2001
--
--
-- Description:
-- Duplicate Db Numbers form methods
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING)                    -                   Take selections for return to !!admStamp
--  init(STRING)                     -                   Method to initialise the form
--  sort()                           -                   Sort the displayed list
--
------------------------------------------------------------------------
define object ADMDUPLICATE

  member .form is FORM
  member .runType is STRING

  member .dbRefs is ARRAY
  member .dbNos is ARRAY

  member .groups is ARRAY
  member .index is REAL

  member .filterVal    is STRING
  member .sortVal      is STRING

endobject

------------------------------------------------------------------------
--
-- Method:      .apply(STRING)
--
-- Description: Take selections for return to !!admStamp
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      STAMP - use the current selection for stamping
--                           SKIP - do not use the current selection but show the next group or finish
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .apply(!action is STRING)

  -- For the selection to be stamped
  if (!action.eq('STAMP')) then

    -- Initialise variables
    !dbRef = !this.form.display.selection().dbRef()

    -- Add the chosen db to the main form !!admStamp
    !!admStamp.formMethods.stampDbrefs.append(!dbRef)
    !!admStamp.formMethods.stampedDbs.append(object ADMSTAMP(!dbRef,!!admDbDateSess(!dbRef)))

    -- For adding dbs to the stamp list before creating the hierarchy
    if (!!admStamp.curDbs.active) then

      -- Update the main form current db list gadget
      !!admStamp.formMethods.currDbList()

    -- In the case of automatically stamping the PROJECT, create a new STLST for the selected db
    else

      -- Create the STLST
      !objectArray[1] = object ADMSTAMP(!dbRef,!!admDbDateSess(!dbRef))
      !unusedResult = !!admStamp.formMethods.create(!objectArray)

    endif

  endif

  -- Test for the last group
  if (!this.index.eq(!this.groups.size())) then

    -- Reinitialise the stamp form current db list
-- SW: Removed this call since it empties the object array .stampedDbs and hence nothing gets stamped
--    !!admStamp.formMethods.curDbSet()

    -- Hide this form
    hide !!admDuplicate

  -- Display the next group
  else
    !this.index = !this.index + 1
    !this.sort()

    -- Re-Set form title
    !this.form.para.val = |Duplicate Databases not selected for Stamping: Group | & !this.index & | of | & !this.groups.size()

  endif

endmethod
-- End of method definition for .apply(STRING)

------------------------------------------------------------------------
--
-- Method:      .init(STRING)
--
-- Description: Method to initialise the form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Call option CHOOSE to select a db
--                                       LIST   to simply display a list of dbs
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .init(!callType is STRING)

  -- Initialise variables
  !this.groups.clear()
  !this.form.display.clear()

  -- Populate sort gadget
  !!admDbSortGadg(!this.form.sort)

  -- Sort and filter values
  if (!this.form.filter.val.empty()) then
    !this.form.filter.val = |*|
  endif
  !this.filterVal = !this.form.filter.val
  !this.sortVal   = !this.form.sort.selection('RTEXT')

  -- Display a list only
  if (!callType.eq('LIST')) then

    -- Sort the list
    !this.sort()

    -- Set form title
    !this.form.para.val = |Duplicate Databases not selected for Stamping|

  -- Select a db from one or more groups of dbs with the same dbno
  else

    -- Sort dbs into groups of same dbno
    !uniqueDbNos = !this.dbNos
    !uniqueDbNos.sortUnique()
    do !index ind !uniqueDbNos
      !dbRefs = ARRAY()

      do !number val !this.dbNos.find(!uniqueDbNos[!index])
        !dbRefs.append(!this.dbRefs[!number])
      enddo

      !this.groups.append(!dbRefs)
    enddo

    -- Display first group
    !this.index = 1
    !this.sort()

    -- Set skip activity status
    if (!this.groups.size().eq(1)) then
      !this.form.skip.active = false
    endif

    -- Set form title
    !this.form.para.val = |Duplicate Databases not selected for Stamping: Group | & !this.index & | of | & !this.groups.size()

  endif

endmethod
-- End of method definition for .init(STRING)

------------------------------------------------------------------------
--
-- Method:      .sort()
--
-- Description: Sort the displayed list
-- for later use.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Dbrefs
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .sort()

  -- Initialise variables
  !this.form.display.clear()

  -- Sort the list
  if (!this.groups.empty()) then
    !displayRefs = !!adminFilterSort(!this.dbrefs,!this.form.sort,!this.form.filter)
  else
    !displayRefs = !!adminFilterSort(!this.groups[!this.index],!this.form.sort,!this.form.filter)
  endif

  -- Display the list
  !!adminDbTxtList(!displayRefs, !this.form.display, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(), object DBREF())

endmethod
-- End of method definition for .sort()
