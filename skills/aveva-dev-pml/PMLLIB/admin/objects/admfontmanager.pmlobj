-- Author:          Tomasz Lisowski
-- Created:         04/07/2007
--
-- Description:
-- The object handles data for (truetype) font management
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addSpecialFontValues(STRING,ARRAY,ARRAY) -                   Appends special values (Default, Template, Unchanged) to the OPTION gadget lists
--  admFontManager()                 -                   Default constructor creating precomputed data for later use
--  allowedFontKind(DBREF)           REAL                Determines, which font kinds (PDMS / TrueType) are allowed for the current element
--  findDBOrder(REAL)                REAL                Finds the index of the TrueType font by its DB order index
--  findDescription(STRING)          REAL                Finds a TrueType font description (case-insensitive)
--  findFace(STRING)                 REAL                Finds a TrueType font face name
--  findFreeID()                     REAL                Finds the first unused TrueType font slot
--  findID(REAL)                     REAL                Finds a TrueType font by its ID
--  findRef(STRING)                  REAL                Finds a TrueType font DB Reference
--  fontName(REAL,BOOLEAN)           STRING              Determine the font name to be shown in the GUI
--  fontType(REAL)                   REAL                Determine the characteristics of the font
--  fontType(REAL,REAL,BOOLEAN,BOOLEAN,REAL) -                   Determine the characteristics of the font
--  getInfo(REAL,REAL,STRING,STRING,STRING) -                   Returns the information about the particular TT font
--  globalInstance()                 -                   Creates a global instance of itself
--  loadFontInfo()                   -                   Reads the SYSTEM database information about TrueType fonts
--  makeListArrays(ARRAY,ARRAY,REAL,BOOLEAN) -                   Builds a DText and RText arrays (Face | ID | Description) for forms
--  sort(REAL)                       -                   Sorts the currently held TrueType font info
--
define object ADMFONTMANAGER
  -- codes determining the valid ranges for TrueType and PDMS fonts
  member .fontData is ARRAY
  -- array of face names of the loaded TrueType fonts
  member .ttfFace is ARRAY
  -- array of font IDs of the loaded TrueType fonts
  member .ttfID is ARRAY
  -- array of descriptions of the loaded TrueType fonts
  member .ttfDesc is ARRAY
  -- array of references (SYSTEM DB) of the loaded TrueType fonts
  member .ttfRef is ARRAY
  -- array of indices in the DB ordering of the loaded TrueType fonts
  member .ttfDBOrder is ARRAY
  -- number of the loaded TrueType fonts
  member .nTTF is REAL
  -- PDMS font names
  member .wigFontNames is ARRAY
  -- first TrueType font in the database order
  member .firstTTFid is REAL

  -- NOTE: If you have added a new DB element, which requires a font attribute to be handled
  --       in the GUI, make sure, that you also update the members below

  -- array of element types, for which the %BSRF attribute determines, which fonts are valid
  member .typBSRF is STRING
  -- array of element types, for which the %TTFENA attribute determines, which fonts are valid
  member .typTTFENA is STRING
  -- array of element types, for which the %TTFENA attribute of a direct or indirect parent
  -- determines, which fonts are valid
  member .typTTFENAUP is STRING
  -- array of element types, for which all fonts are valid
  member .typYes is STRING
  -- array of element types, for which only TrueType fonts are valid
  member .typTTF is STRING
  -- array of element types, for which the DFON/PFON attributes can take the value of DEFAULT
  member .typDefault is STRING
  -- array of element types, for which the FONT attribute can take the value of TEMPLATE
  member .typTemplate is STRING
  -- array of element types, for which the FONT attribute can take the value of UNCHANGED
  member .typUnchanged is STRING
endobject

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Creates a global instance of itself
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .globalInstance()
  !!fontManager = !this
endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      admFontManager
--
-- Description: Default constructor creating precomputed data for later use
--
-- Method Type: Constructor
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .admFontManager()
  !this.fontData = ARRAY()
  !this.fontData[1] = 0
  !this.fontData[2] = 0
  !this.fontData[3] = 0
  !this.fontData[4] = 0
  !this.fontData[5] = 1
  !this.fontData[6] = 1
  !this.fontData[7] = 1
  !this.fontData[8] = 1
  !this.fontData[9] = 1
  !this.fontData[10] = 0
  !this.fontData[11] = 0
  !this.fontData[12] = 0
  !this.fontData[13] = 0
  !this.fontData[14] = 0
  !this.fontData[15] = 0
  !this.fontData[16] = 0
  !this.fontData[17] = 1
  !this.fontData[18] = 1
  !this.fontData[19] = 1
  !this.fontData[20] = 0
  !this.fontData[21] = 0
  !this.fontData[22] = 0
  !this.fontData[23] = 0
  !this.fontData[24] = 0
  !this.fontData[25] = 0
  !this.fontData[26] = 0
  !this.fontData[27] = 1
  !this.fontData[28] = 1
  !this.fontData[29] = 1
  !this.fontData[30] = 0
  !this.fontData[31] = 0
  !this.fontData[32] = 0
  !this.fontData[33] = 0
  !this.fontData[34] = 0
  !this.fontData[35] = 0
  !this.fontData[36] = 0
  !this.fontData[37] = 1
  !this.fontData[38] = 1
  !this.fontData[39] = 1
  !this.fontData[40] = 0
  !this.fontData[41] = 0
  !this.fontData[42] = 0
  !this.fontData[43] = 0
  !this.fontData[44] = 0
  !this.fontData[45] = 0
  !this.fontData[46] = 0
  !this.fontData[47] = 1
  !this.fontData[48] = 1
  !this.fontData[49] = 1
  !this.fontData[50] = -1
  !this.fontData[51] = -1
  !this.fontData[52] = -1
  !this.fontData[53] = -1
  !this.fontData[54] = -1
  !this.fontData[55] = -1
  !this.fontData[56] = -1
  !this.fontData[57] = 1
  !this.fontData[58] = 1
  !this.fontData[59] = 1
  !this.fontData[60] = 1
  !this.fontData[61] = 1
  !this.fontData[62] = 1
  !this.fontData[63] = 0

  -- The index below should be the same, as K:TTF.SYMBOL in inputfuncs.mcr
  !this.fontData[62] = -1

  !this.ttfFace = ARRAY()
  !this.ttfID = ARRAY()
  !this.ttfDesc = ARRAY()
  !this.ttfRef = ARRAY()
  !this.ttfDBOrder = ARRAY()
  !this.nTTF = 0

  -- both fonts allowed if %BSRF is null. If not null, then the backing sheet's %TTFENA
  -- determines, which fonts are valid
  !this.typBSRF = 'DEPT/REGI/DRWG/LIBY/DRTMLB/DRTMPL/'
  -- the element's %TTFENA attribute determines, which fonts are valid
  !this.typTTFENA = 'SYLB/ISOLB/LALB/BACK/OVER/'
  -- find the parent (direct or indirect), having the %TTFENA attribute. Its value determines, which fonts are valid
  !this.typTTFENAUP = 'LAYE/TEXP/GLAB/SLAB/NOTE/VNOT/ADIM/LDIM/RDIM/PDIM/DPOI/DPPT/ADIR/APPT/DPBA/DSLAYE/DESSYM/AXESYM/TXTM/SYTM/ISOTM/'
  -- both fonts unconditionally allowed
  !this.typYes = 'SHLB/ACSTYL/'
  -- only TrueType fonts allowed
  !this.typTTF = 'LINEST/OLINES/'
  -- PFON/DFON can take the value of DEFAULT
  !this.typDefault = 'APPT/ADIR/DPPT/DPBA/DPOI/'
  -- FONT can take the value of TEMPLATE
  !this.typTemplate = 'SLAB/LAYE/'
  -- FONT can take the value of UNCHANGED
  !this.typUnchanged = 'ACSTYL/'

  !s = ' Thin Upright/ Thin Forward/ Thin Reverse/ Bold Upright/ Bold Forward/ Bold Reverse'
  !this.wigFontNames = !s.split('/')

  !this.loadFontInfo()
endmethod
-- End of method definition for .admFontManager()

------------------------------------------------------------------------
--
-- Method:      fontType
--
-- Description: Determine the characteristics of the font
-- Status codes:
--    0 - PDMS font
--    1 - TrueType font (unused slot)
--    2 - TrueType font (used slot)
--   -1 - invalid font ID (reserved or out of range)
--
-- Method Type: Procedure
-- Arguments:
--   1 R REAL    The verified font ID
--   2 W REAL    The effective font ID, reduced to the range <1, 63>
--   3 W BOOLEAN The Bold flag for the font (relevant for TrueType)
--   4 W BOOLEAN The Italics flag for the font (relevant for TrueType)
--   5 W REAL    The status code of the font
-- Return:
--
------------------------------------------------------------------------
define method .fontType(!id is REAL, !effectiveID is REAL, !isBold is BOOLEAN, !isItalic is BOOLEAN, !fType is REAL)
  if( !id.lt(1001) ) then
    !effectiveID = !id
    !isBold = FALSE
    !isItalic = FALSE
  elseif( !id.lt(2001) ) then
    !effectiveID = !id - 1000
    !isBold = TRUE
    !isItalic = FALSE
  elseif( !id.lt(3001) ) then
    !effectiveID = !id - 2000
    !isBold = FALSE
    !isItalic = TRUE
  else
    !effectiveID = !id - 3000
    !isBold = TRUE
    !isItalic = TRUE
  endif
  if( !effectiveID.between( 1, 63 ) ) then
    !fType = !this.fontData[!effectiveID]
    if( !fType.eq(1) ) then
      if( set(!this.ttfID.findFirst(!effectiveID)) ) then
        !fType = 2
      endif
    endif
  else
    !fType = -1
  endif
endmethod
-- End of method definition for .fontType()

------------------------------------------------------------------------
--
-- Method:      fontType
--
-- Description: Determine the characteristics of the font
-- Status codes:
--    0 - PDMS font
--    1 - TrueType font (unused slot)
--    2 - TrueType font (used slot)
--   -1 - invalid font ID (reserved or out of range)
--
-- Method Type: Function
-- Arguments:
--   1 R REAL    The verified font ID
-- Return:
--   REAL    The status code of the font
------------------------------------------------------------------------
define method .fontType(!id is REAL) is REAL
  !effectiveID = -99
  !bold = false
  !italic = false
  !fType = -99
  !this.fontType(!id, !effectiveID, !bold, !italic, !fType)
  return !fType
endmethod
-- End of method definition for .fontType()

------------------------------------------------------------------------
--
-- Method:      fontName
--
-- Description: Determine the font name to be shown in the GUI
--
-- Method Type: Function
-- Arguments:
--   1 R REAL    The font ID
--   2 R BOOLEAN True, if the Bold/Italics information is to be supplied
-- Return:
--   STRING  The font name
------------------------------------------------------------------------
define method .fontName(!id is REAL, !addAttr is BOOLEAN) is STRING
  !effectiveID = -1
  !isBold = FALSE
  !isItalic = FALSE
  !fType = -99
  !this.fontType(!id, !effectiveID, !isBold, !isItalic, !fType)
  if( !fType.eq(0) ) then
    if( !effectiveID.between(1, 4) ) then
      !fontN = 1
      !fontF = !effectiveID
    else
      !fontF = INT((!effectiveID + 0.5) / 10)
      !fontN = !effectiveID - 10 * !fontF
    endif
    if( !addAttr ) then
      !name = !!cdFonts[!fontF] & !this.wigFontNames[!fontN]
    else
      !name = !!cdFonts[!fontF]
    endif
  elseif( !fType.eq(2) ) then
    !ind = !this.findID(!effectiveID)
    !name = !this.ttfDesc[!ind]
    if( !name.empty() ) then
      !name = !this.ttfFace[!ind]
    endif
    if( !addAttr ) then
      if( !isBold ) then
        !name = !name & ' Bold'
      endif
      if( !isItalic ) then
        !name = !name & ' Italic'
      endif
    endif
  elseif( !fType.eq(1) ) then
    !name = '*Unassigned TrueType font*'
  else
    !name = '*Invalid font number*'
  endif
  return !name
endmethod
-- End of method definition for .fontName()

------------------------------------------------------------------------
--
-- Method:      findFreeID
--
-- Description: Finds the first unused TrueType font slot
--
-- Method Type: Function
-- Arguments:
-- Return:
--    REAL   The unused ID for the TrueType font, or -1, if there is no free slot
------------------------------------------------------------------------
define method .findFreeID() is REAL
  do !ind from 1 to 63
    if( !this.fontData[!ind].eq(1) ) then
      if( unset(!this.ttfID.findFirst(!ind)) ) then
        return !ind
      endif
    endif
  enddo
  return -1
endmethod
-- End of method definition for .findFreeID()

------------------------------------------------------------------------
--
-- Method:      loadFontInfo
--
-- Description: Reads the SYSTEM database information about TrueType fonts
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .loadFontInfo()
  !this.ttfFace.clear()
  !this.ttfID.clear()
  !this.ttfDesc.clear()
  !this.ttfRef.clear()
  !this.ttfDBOrder.clear()
  var !refArr collect all TTFONT
  !this.nTTF = !refArr.size()
  !this.ttfRef = !refArr
  if( !this.nTTF.gt(0) ) then
    !ind = 0
    !mem = REF
    do !ref values !refArr
      !ind = !ind + 1
      $!ref
      !id = TTFIND
      !face = TTFACE
      handle ANY
        !face = 'Unset'
      endhandle
      !desc = TTFDES
      handle ANY
        !desc = !face
      endhandle
      !this.ttfID.append(!id)
      !this.ttfFace.append(!face)
      !this.ttfDesc.append(!desc)
      !this.ttfDBOrder.append(!ind)
    enddo
    $!mem
    !this.firstTTFid = !this.ttfID[1]
   else
    !this.firstTTFid = -1
  endif
endmethod
-- End of method definition for .loadFontInfo()

------------------------------------------------------------------------
--
-- Method:      sort
--
-- Description: Sorts the currently held TrueType font info
-- Sorting codes:
--    1 - sort by ID
--    2 - sort by Face name
--    3 - sort by Description
--    4 - sort by the DB ordering
-- Method Type: Procedure
-- Arguments:
--    1  R   REAL  The code determining the sorting of the retrieved data
-- Return:
--
------------------------------------------------------------------------
define method .sort(!by is REAL)
  if( !this.nTTF.gt(0) ) then
    if( !by.eq(1) ) then
      !indArr = !this.ttfID.sortedIndices()
    elseif( !by.eq(2) ) then
      !indArr = !this.ttfFace.sortedIndices()
    elseif( !by.eq(3) ) then
      !indArr = !this.ttfDesc.sortedIndices()
    elseif( !by.eq(4) ) then
      !indArr = !this.ttfDBOrder.sortedIndices()
    else
      return
    endif
    !this.ttfID.reIndex(!indArr)
    !this.ttfFace.reIndex(!indArr)
    !this.ttfDesc.reIndex(!indArr)
    !this.ttfRef.reIndex(!indArr)
    !this.ttfDBOrder.reIndex(!indArr)
  endif
endmethod
-- End of method definition for .sort()

------------------------------------------------------------------------
--
-- Method:      getInfo
--
-- Description: Returns the information about the particular TT font
--
-- Method Type: Procedure
-- Arguments:
--    1  R   REAL   The font index
--    2  W   REAL   The font ID
--    3  W   STRING The face name
--    4  W   STRING The description
--    5  W   STRING The DB reference of the TTFONT element
-- Return:
------------------------------------------------------------------------
define method .getInfo(!ind is REAL, !id is REAL, !face is STRING, !desc is STRING, !ref is STRING)
  !id = !this.ttfID[!ind]
  handle ANY
    !id = -1
    !face = ''
    !desc = ''
    !ref = ''
  elsehandle None
    !face = !this.ttfFace[!ind]
    !desc = !this.ttfDesc[!ind]
    !ref  = !this.ttfRef[!ind]
  endhandle
endmethod
-- End of method definition for .getInfo()

------------------------------------------------------------------------
--
-- Method:      findID
--
-- Description: Finds the index of the TrueType font by its ID
--
-- Method Type: Function
-- Arguments:
--    1  R   REAL   The font ID
-- Return:
--    REAL Index of the ID found, or -1, if not found
------------------------------------------------------------------------
define method .findID(!id is REAL) is REAL
  !ind = !this.ttfID.findFirst(!id)
  if( unset(!ind) ) then
    return -1
  else
    return !ind
  endif
endmethod
-- End of method definition for .findID()

------------------------------------------------------------------------
--
-- Method:      findFace
--
-- Description: Finds the index of the TrueType font face name
--
-- Method Type: Function
-- Arguments:
--    1  R   STRING The font face name
-- Return:
--    REAL Index of the face name found, or -1, if not found
------------------------------------------------------------------------
define method .findFace(!face is STRING) is REAL
  !ind = !this.ttfFace.findFirst(!face)
  if( unset(!ind) ) then
    return -1
  else
    return !ind
  endif
endmethod
-- End of method definition for .findFace()

------------------------------------------------------------------------
--
-- Method:      findDescription
--
-- Description: Finds the index of the TrueType font description (case-insensitive)
--
-- Method Type: Function
-- Arguments:
--    1  R   STRING The font description
-- Return:
--    REAL Index of the description found, or -1, if not found
------------------------------------------------------------------------
define method .findDescription(!desc is STRING) is REAL
  !loDesc = !desc.lowCase()
  do !ind indices !this.ttfDesc
    !s = !this.ttfDesc[!ind].lowCase()
    if( !loDesc.eq(!s) ) then
      return !ind
    endif
  enddo
  return -1
endmethod
-- End of method definition for .findDescription()

------------------------------------------------------------------------
--
-- Method:      findRef
--
-- Description: Finds the index of the TrueType font DB Reference
--
-- Method Type: Function
-- Arguments:
--    1  R   STRING The DB reference of the TTFONT element
-- Return:
--    REAL Index of the DB Reference found, or -1, if not found
------------------------------------------------------------------------
define method .findRef(!ref is STRING) is REAL
  !ind = !this.ttfRef.findFirst(!ref)
  if( unset(!ind) ) then
    return -1
  else
    return !ind
  endif
endmethod
-- End of method definition for .findRef()

------------------------------------------------------------------------
--
-- Method:      findDBOrder
--
-- Description: Finds the index of the TrueType font by its DB order index
--
-- Method Type: Function
-- Arguments:
--    1  R   REAL The DB Order index of the TTFONT element
-- Return:
--    REAL Index of font found, or -1, if not found
------------------------------------------------------------------------
define method .findDBOrder(!dbIndex is REAL) is REAL
  !ind = !this.ttfDBOrder.findFirst(!dbIndex)
  if( unset(!ind) ) then
    return -1
  else
    return !ind
  endif
endmethod
-- End of method definition for .findDBOrder()

------------------------------------------------------------------------
--
-- Method:      makeListArrays
--
-- Description: Builds a DText and RText arrays (Face | ID | Description) for forms
--
-- Method Type: Procedure
-- Arguments:
--    1  R/W  ARRAY   The DText array
--    2  R/W  ARRAY   The RText array
--    3   R   REAL    Mode: 0 - put DB refs as RText, 1 - put font IDs as RText
--    4   R   BOOLEAN True, if the default font is to be marked with an asterisk. Otherwise false.
-- Return:
------------------------------------------------------------------------
define method .makeListArrays(!dText is ARRAY, !rText is ARRAY, !mode is REAL, !markDefault is BOOLEAN)
  !tab = '	'
  if( !this.ttfRef.empty() ) then
    !dText[1] = 'None' & !tab & !tab
    !rText[1] = 'None'
  else
    if( !markDefault ) then
      !defID = !this.firstTTFid
    else
      !defID = -99
    endif
    do !ind indices !this.ttfRef
      !fontID = !this.ttfID[!ind]
      if( !fontID.eq(!defID) ) then
        !fID = '[' & !fontID & ']'
      else
        !fID = !fontID.string()
      endif
      !s = !this.ttfFace[!ind] & !tab & !fID & !tab & !this.ttfDesc[!ind]
      !dText.append(!s)
      if( !mode.eq(0) ) then
        !rText.append( !this.ttfRef[!ind] )
      else
        !rText.append( !this.ttfID[!ind].string() )
      endif
    enddo
  endif
endmethod
-- End of method definition for .makeListArrays()

------------------------------------------------------------------------
--
-- Method:      allowedFontKind
--
-- Description: Determines, which font kinds (PDMS / TrueType) are allowed for the current element
--
-- Method Type: Function
-- Arguments:
--   1  R  DBREF  DB reference of the BSRF
-- Return:
--   REAL  Status code (0 - no font allowed, 1 - PDMS only, 2 - TrueType only, 3 - both)
------------------------------------------------------------------------
define method .allowedFontKind(!back is DBREF) is REAL
  !typ = TYPE
  !type = !typ & '/'
  !code = 0

  if( !this.typBSRF.match(!type).gt(0) ) then
  -- The %TTFENA attribute of the backing sheet determines the type of the fonts
  -- If the backing sheet reference is unset, then both font types are available
--    !back = BSRF
--    handle (2,201)
--      !!alert.error('Error looking up the %BSRF attribute!')
--    elsehandle None
    if( !back.badRef() ) then
      !code = 3
    else
      !mem = REF
      $!back
      !ttfEnabled = TTFENA
      if( !ttfEnabled ) then
        !code = 2
      else
        !code = 1
      endif
      $!mem
    endif
--    endhandle

  elseif( !this.typTTFENA.match(!type).gt(0) ) then
  -- the element's %TTFENA attribute determines the type of the fonts
    !ttfEnabled = TTFENA
    handle (2,201)
      !!alert.error('Error looking up the %TTFENA attribute!')
    elsehandle None
      if( !ttfEnabled ) then
        !code = 2
      else
        !code = 1
      endif
    endhandle

  elseif( !this.typTTFENAUP.match(!type).gt(0) ) then
  -- the parent (direct or indirect) of the element, having the %TTFENA attribute
  -- determines the type of the fonts
    !mem = REF
    do
      OWNER
      handle ANY
        !!alert.error('Error looking up the %TTFENA attribute!')
        break
      endhandle

      !ttfEnabled = TTFENA
      handle (2,201)
      elsehandle None
        if( !ttfEnabled ) then
          !code = 2
        else
          !code = 1
        endif
        break
      endhandle
    enddo
    $!mem

  elseif( !this.typYes.match(!type).gt(0) ) then
  -- all font types are available
    !code = 3

  elseif( !this.typTTF.match(!type).gt(0) ) then
  -- only TrueType fonts are available
    !code = 2

  endif

  return !code
endmethod
-- End of method definition for .allowedFontKind()

------------------------------------------------------------------------
--
-- Method:      addSpecialFontValues
--
-- Description: Appends special values (Default, Template, Unchanged) to the OPTION gadget lists
--
-- Method Type: Procedure
-- Arguments:
--    1  R/W  ARRAY  The DText array
--    2  R/W  ARRAY  The RText array
-- Return:
------------------------------------------------------------------------
define method .addSpecialFontValues(!fontAtt is STRING, !dText is ARRAY, !rText is ARRAY)
  !typ = TYPE
  !type = !typ & '/'
  !attributes = '_DFON_DFONT_PFON_PFONT_'
  if( !attributes.match('_$!fontAtt_').gt(0) ) then $* DFON/T or PFON/T
    if( !this.typDefault.match(!type).gt(0) ) then
      !dText.append('DEFAULT')
      !rText.append('default')
    endif
  elseif( !fontAtt.eq('FONT') ) then
    if( !this.typTemplate.match(!type).gt(0) ) then
      !dText.append('TEMPLATE')
      !rText.append('template')
    elseif( !this.typUnchanged.match(!type).gt(0) ) then
      !dText.append('UNCHANGED')
      !rText.append('unchanged')
    endif
  endif
endmethod
-- End of method definition for .addSpecialFontValues()
