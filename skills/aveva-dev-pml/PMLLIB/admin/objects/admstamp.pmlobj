--
-- File:            admstamp.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 July 2001
--
--
-- Description:
-- Object to define a stamped database and form methods
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admStamp(DBREF,REAL)             -                   Method to set dbRef and session number
--  apply()                          -                   Create or modify a STAMP element
--  checkSession()                   -                   Check that the entered session is valid
--  checkValue(GADGET,STRING)        -                   Check that the entered value is valid
--  chkDbno(ARRAY)                   ARRAY               Check that there are dbs with duplicate DBNO
--  chkSess(ARRAY,BOOLEAN)           ARRAY               Check for dbs without a session before the stamp date
--  clrActive()                      -                   Set the clear gadget active status
--  create(ARRAY)                    BOOLEAN             Create the stamp list element
--  curDbSet()                       -                   Set the database array for the current STAMP
--  curProj()                        -                   Move the selected entry from current to project
--  currDbList()                     -                   Control the contents on the Current Database list gadget
--  dateActive(BOOLEAN)              -                   Set date active gadgets
--  dateUnset()                      -                   Unset date gadgets
--  dbActive(STRING)                 -                   Set database active gadgets
--  dbSetList()                      -                   Populate display list
--  dbSetSet()                       -                   Get db sets
--  display(STRING)                  -                   Function to display the STAMP Definition form.
--  getDbSessions()                  -                   Get all session numbers for a selected db
--  init()                           -                   initialise the STAMP Definition form.
--  mode()                           -                   Set the mode CREATE or MODIFY
--  modeGet()                        STRING              Returns the current mode
--  modeSet(STRING)                  -                   set the mode of the this form
--  month(BOOLEAN)                   -                   Set the number of days in the month
--  name(GADGET)                     -                   Check input name is valid and not used
--  projCur()                        -                   Move the selected entry from display to current
--  projDbList()                     -                   Controls the contents on the display list
--  projDbSet()                      -                   Gets all project databases
--  projMdbList()                    -                   Controls the MDB contents in the display list
--  projMdbSet()                     -                   Gets all project mdbs
--  remAll()                         -                   Remove all current entries
--  sessUpDown(STRING)               -                   Cycle through available sessions
--  setBy()                          -                   Set the stamp by date or sessions
--  setByActive(STRING,BOOLEAN)      -                   Set by gadgets active
--  setDate(DATETIME)                -                   Set the date object gadgets
--  sort()                           -                   Sort the displayed list
--  sortValues()                     -                   Set the sort values
--  stampDate(STRING)                -                   Set the date gadgets
--  stampWhat(BOOLEAN)               -                   Choose what to stamp
--  storeDate()                      -                   Store the date and date string
--  teamList()                       -                   Populate display list with Teams
--  teamSet()                        -                   Get all Teams
--  upDown(GADGET,STRING,STRING)     -                   Raise or lower passed time counter
--  update()                         -                   Update the displayed STAMP
--  workDbList()                     -                   Control the Working Extracts contents in the display list
--  workDbSet()                      -                   Gets all project working databases
--  zero(STRING)                     STRING              Calculate any leading required zeros
--
------------------------------------------------------------------------
-- Define object
define object ADMSTAMP

  -- The form
  member .form is FORM

  -- The current db or stamp
  member .dbRef is DBREF

  -- The stamped session of the db
  member .sessNo is REAL

  -- The db store
  member .allDbRefs is ARRAY
  member .projDbRefs is ARRAY
  member .dbSetRefs is ARRAY
  member .mdbRefs is ARRAY
  member .teamRefs is ARRAY
  member .workDbRefs is ARRAY
  member .stampDbRefs is ARRAY
  member .existDbRefs is ARRAY
  member .existDbStrings is ARRAY
  member .stlstRefs is ARRAY
  member .stampedDbs is ARRAY

  -- Dates
  member .currDate is DATETIME
  member .date is DATETIME
  member .dateString is STRING
  member .setDate is DATETIME
  --  Members to store sort and filter values
  member .filterVal    is STRING
  member .sortVal      is STRING

  -- Stamp method
  member .stampMethod is STRING

  -- Current db sessions
  member .currentDb is DB
  member .lastSession is DBSESS
  member .currentSession is DBSESS
  member .currentNumber is REAL

endobject
-- End of object definition for ADMSTAMP

------------------------------------------------------------------------
--
-- Method:      .admStamp(DBREF,REAL)
--
-- Description: Method to set dbRef and session number
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Database Dbref
--    2   R      REAL        Session Number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .admStamp(!dbRef is DBREF, !session is REAL)

  !this.dbRef = !dbRef
  !this.sessNo = !session

endmethod
-- End of method definition for .admStamp(DBREF,REAL)

------------------------------------------------------------------------
--
-- Method: .apply()
--
-- Description: create or modify a STAMP element
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .apply()

  -- Initialise variables
  !mode = !this.modeGet()
  !updateFlag = false
  !result = false

  -- Stamp attributes
  !stampName = |/| + !this.form.name.val
  !description = !this.form.desc.val
  !function = !this.form.func.val
  !dateString = !this.dateString
  !purpose = !this.form.what.selection()

  -- Check for any current dbs
  if (!purpose.neq('PROJ')) then
    if (!this.form.curDbs.rtext.unset() or !this.form.curDbs.rtext.empty()) then
      !!alert.warning('You have not chosen any databases to stamp')
      return
    endif
  endif

  -- Check that the name gadget is set
  if (!this.form.name.val eq 'unset') then

    -- Reset gadget in modify mode
    if (!mode eq 'MODIFY') then
      !this.form.name.val = !this.dbRef.name.substring(2)
    endif

    -- Raise error
    !this.form.name.setFocus()
    !!messageFile.warning(146,8,'',' No name has been given')
    return

  endif

  -- Check that the description gadget is set
  if (!this.form.desc.val.upCase().eq('UNSET')) then

    -- Reset gadget in modify mode
    if (!mode.eq('MODIFY')) then
      !this.form.desc.val = !this.dbRef.desc
    endif

    -- Raise error 'Aborted -'
    !this.form.desc.setFocus()
    !!messageFile.warning(146,8,'',' No description has been given')
    return

  endif

  -- Check for future date
  if (!this.date.gt(object DATETIME())) then
    !!alert.error('You have set the date to a time in the future. The date will be reset to the present....')
    !this.setDate = object DATETIME()
--    !this.setDate(object DATETIME())
    !this.storeDate()
    return
  endif

  -- Determine actual dbs depending on purpose
  if (!purpose.eq('PROJ')) then

    -- Check for dbs without a session before the stamp date
    !validDbs = !this.chkSess(!this.allDbRefs,false)
    if (!validDbs.unset() or !validDbs.empty()) then
--      !!alert.warning('No databases were found to stamp')
      return
    endif

    -- Check that there are no duplicate DBNO's
    !validDbs = !this.chkDbno(!validDbs)
    if (!!admDuplicate.formMethods.dbRefs.empty() and !validDbs.empty()) then
--      !!alert.warning('No databases were found to stamp')
      return
    endif

    -- Build stamped db objects
    !this.stampedDbs.clear()
    !actualDbRefs = ARRAY()
    do !dbRef val !validDbs
      !actualDbRefs.append(object ADMSTAMP(!dbRef,!!admDbDateSess(!dbRef)))
    enddo

  else

    -- Use the chosen dbs
    !actualDbRefs = !this.stampedDbs

  endif

  -- Action attribute depending on mode
  -- CREATE MODE --
  if (!mode eq 'CREATE') then

   -- Navigate to the stamp world
    !!ce = !!dbrAdminGetWorld('STAMP')

    -- Create the stamp hierarchy
    NEW STAMP
     NAME $!stampName
     !!ce.description = !description
     !!ce.function    = !function
     SETDAT '$!dateString'
     PURP $!purpose

    -- Store new stamp dbref in form member
    !this.dbRef = !!ce

    -- Create the STLSTs to reference the dbs
    !result = !this.create(!actualDbRefs)

    -- Mark as modified
    !updateFlag = true

  -- MODIFY MODE --
  elseif (!mode eq 'MODIFY') then

    -- Build date object for currently set date
    if (!this.dbRef.setDat.neq('')) then
      !this.setDate = object DATETIME(!this.dbRef.setDat)
    endif

    -- Navigate to the user element
    !!ce = !this.dbRef

    -- Check element can be updated
    if (not !!dbRefUpdate(!this.dbRef)) then
      !!alert.error (!!error.text)
      return
    endif

    -- Change the name
    if (!this.dbRef.name.neq(!stampName)) then

      -- Modify the name   *** OLD PML SYNTAX ***
      !!admCommand(|NAME $!stampName|)
      handle (41,12)
        -- Name Already exists
        !!alert.error(!!messageFile.messageString(141, 103,  !this.name.val))
        !this.form.name.val = !this.dbRef.name.substring(2)
      endhandle

      -- Refresh form title
      !this.form.formTitle = 'Modify Date Stamp: ' & !this.dbRef.name.substring(2)

      -- Mark as modified
      !updateFlag = true

    endif

    -- Change the date
    if (!dateString.unset()) then
      -- Unset the date
      SETDAT ''

      -- Mark as modified
      !updateFlag = true

      -- Test
      --write 'UNSETTING DATE'

    elseif (!this.dbRef.setDat.neq('') or !dateString.set()) then
      -- Set the new date
      SETDAT '$!dateString'

      -- Mark as modified
      !updateFlag = true

      -- Test
      --write 'SETTING NEW DATE'
    endif

    -- Change the description
    if (!this.dbRef.description.neq(!description)) then

      -- Modify the description
      !!ce.description = !description

      -- Mark as modified
      !updateFlag  = true

    endif

    -- Change the function
    if (!this.dbRef.function.neq(!function)) then

      -- Modify the function
      !!ce.function = !function

      -- Mark as modified
      !updateFlag  = true

    endif

    -- Change the purpose
    if (!this.dbRef.purpose.neq(!purpose)) then

      -- Modify the purpose
      !!ce.purpose = !purpose

      -- Mark as modified
      !updateFlag  = true

    endif

    -- Delete any unwanted stlsts
    if (!this.stlstRefs.size().gt(!actualDbRefs.size())) then

      -- Get excess stlst elements
      !excessRefs = !this.stlstRefs.deleteFrom(!actualDbRefs.size() + 1)
      do !stlst val !excessRefs

        -- Access excess STLSTs and delete them
        !!ce = !stlst
        DELETE STLST

        -- Test
        --write 'DELETING $!stlst.flnm'

      enddo

      -- Mark as modified
      !updateFlag  = true

    endif

    -- Unset the db reference for the existing STLSTs
    -- Otherwise may result in attempting to reference the same db twice
    do !index ind !this.stlstRefs
      !!ce = !this.stlstRefs[!index]
      STLSF UNSET
    enddo

    -- Modify the existing STLSTs
    do !index ind !this.stlstRefs

      -- Access existing
      !!ce = !this.stlstRefs[!index]

      -- Set the attributes
      STLSF $!<actualDbRefs[$!index].dbRef>
      STSESS $!<actualDbRefs[$!index].sessNo>
        handle (1,138)
          -- Session does not exist
          !!alert.warning(!!error.text.after('(1,138)   ') & '. Ignoring this database.')
          DELETE STLST
        endhandle

      -- Test
      --write 'MODIFYING $!this.stlstRefs[$!index].flnm $!actualDbRefs[$!index].flnm $!this.stampSessions[$!index]'

      -- Mark as modified
      !updateFlag  = true

    enddo

    -- Create any new STLSTs
    if (!actualDbRefs.size().gt(!this.stlstRefs.size())) then

      -- Get dbrefs and session number
      !dbArray = !actualDbRefs.deleteFrom(!this.stlstRefs.size() + 1)

      -- Create the STLSTs
      !result = !this.create(!dbArray)

      -- Test
      --do !index ind !dbRefs
      --  write 'CREATING STLST FOR $!dbRefs[$!index].flnm $!sessNumb[$!index]'
      --enddo

      -- Mark as modified
      !updateFlag  = true

    endif

    -- Test for no update and nothing created
    if (!updateFlag.not() and !result.not() and !!admDuplicate.formMethods.dbRefs.empty()) then
      !!alert.warning('There were no Stamp attributes modified nor any Stlst elements created or modified!')
    endif

  endif

  -- Update forms if required
  if (!updateFlag) then

    -- Admin Elements
    !!adminElem.update('STAMP')

    -- Merge Changes
    if (defined(!!admmergechange)) then
      if (!!admmergechange.shown()) then
        !!admmergechange.dbListSelect()
      endif
    endif

    -- Backtrack
    if (defined(!!admBacktrack)) then
      if (!!admBacktrack.shown()) then
        !!admBacktrack.dbListSelect()
      endif
    endif

  endif

  -- When running the automatic project option, offer the list of any db's found to have the same db number
  if (!purpose.eq('PROJ') and !!admDuplicate.formMethods.dbRefs.empty().not()) then
    !!admDuplicate.show()
  endif

  -- Select modify mode if in create mode
  if (!mode.eq('CREATE')) then
    !this.form.mode.select('RTEXT','MODIFY')
  endif

  -- Set the date inactive
  -- This is to prevent the date being modified when it references dbs
  -- The dbs must be cleared first in order to modify the date
  if (!purpose.neq('PROJ')) then
    !this.dateActive(false)
  endif

  -- Reinitialise the form
  !this.init()

  -- Set apply inactive
  !this.form.apply.active = false

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
--Method: .checkSession()
--
-- Description: Check that the entered session is valid
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .checkSession()

  -- Initialise variables
  !dbObj = object DB()
  !formSession = 0

  !dbObj = object DB(!this.form.display.selection()[1])
  !formSession = !this.form.session.val
  !this.currentSession = !dbObj.session(!formSession)
  !this.currentNumber = !this.currentSession.number
  if (!this.currentNumber eq 0) then
    !this.currentNumber = !dbObj.lastSession().number
  endif
  if (!formSession neq !this.currentNumber) then
    !this.form.session.val = !this.currentNumber
  endif

endmethod
-- End of method definition for .checkSession()

------------------------------------------------------------------------
--
--Method: .checkValue()
--
-- Description: Check that the entered value is valid
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Calling gadget
--    2   R      STRING      Value type MINS, HOUR or YEAR
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .checkValue(!gadget is GADGET, !type is STRING)

  -- Check that the entered value is valid
  if (!type.eq('MINS')) then
    if (!gadget.val.real().gt(59)) then
      !!alert.error('The maximum value allowed is 59')
      !gadget.val = '59'
    elseif (!gadget.val.real().lt(0)) then
      !!alert.error('The minimum value allowed is 0')
      !gadget.val = '0'
    endif
  elseif (!type.eq('HOUR')) then
    if (!gadget.val.real().gt(23)) then
      !!alert.error('The maximum value allowed is 23')
      !gadget.val = '23'
    elseif (!gadget.val.real().lt(0)) then
      !!alert.error('The minimum value allowed is 0')
      !gadget.val = '0'
    endif
  elseif (!type.eq('YEAR')) then
    if (!gadget.val.real().lt(1996) or !gadget.val.real().gt(!this.currDate.year())) then
      !!alert.error('The year specified (' & !gadget.val & ') must be between 1996 and ' & !this.currDate.year())
      !gadget.val = !this.currDate.year()
    endif
  endif

  -- Store the date
  !this.storeDate()

endmethod
-- End of method definition for .checkValue()

------------------------------------------------------------------------
--
--Method: .chkDbno()
--
-- Description: Check that there are dbs with duplicate DBNO
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      Array of string DBREF's of DB's
-- Return:
--   [Data Type] [Description]
--    ARRAY      Array of string DBREFS of DB's that can be added
--
------------------------------------------------------------------------
-- Define method
define method .chkDbno(!dbRefs is ARRAY) is ARRAY

  -- Initialise variables
  !sameArray = ARRAY()
  !sameDbNos = ARRAY()
  !emptyArray = ARRAY()
  !emptyDbNos = ARRAY()
  !returnArray = ARRAY()
  !alreadyAdded = ARRAY()

  -- Initialise the duplicate form
  !!admDuplicate(!emptyArray,!emptyDbNos,'INIT')

  -- Ensure that the dbrefs array is unique for automatic operations
  if (!this.form.what.selection().neq('BYDB') and !this.form.what.selection().neq('BYWE')) then
    !dbRefs.unique()
  endif

  -- Get db numbers for the passed dbrefs
  !extractDbno = object BLOCK('!dbRefs[!evalIndex].dbNo')
  !dbNumbers = !dbRefs.evaluate(!extractDbno)

  -- Get array of unique db numbers
  !uniqueNumbers = !dbNumbers
  !uniqueNumbers.unique()

  -- Compare arrays
  if (!this.form.what.selection().eq('BYDB') or !this.form.what.selection().eq('BYWE')) then
    if (!uniqueNumbers.size().neq(!dbNumbers.size())) then
      !!alert.error('Some of the selected databases have the same database number. You may not add more than one database with the same database number. Please unselect them and try again.')
      return object ARRAY()
    endif
  endif

  -- Get db number for current stamped dbs
  !extractDbno = object BLOCK('!this.stampDbRefs[!evalIndex].dbNo')
  !numbersInUse = !this.stampDbRefs.evaluate(!extractDbno)

  -- Test for any overlap in dbs and db numbers
  do !index ind !dbRefs

    -- Test if a db of the same number is already added
    if (!numbersInUse.findFirst(!dbNumbers[!index]).set() and !this.form.what.selection().neq('PROJ')) then
      !alreadyAdded.append(!dbRefs[!index])
      !foundDuplicate = true

    -- If db has not already been added
    else

      -- Test if more than one db with the same number in the passed list of dbs
      if (!dbNumbers.find(!dbNumbers[!index]).size().gt(1)) then
        !sameArray.append(!dbRefs[!index])
        !sameDbNos.append(!dbNumbers[!index])

      -- If dbno is unique then can add this db
      else
        !returnArray.append(!dbRefs[!index])
      endif

    endif

  enddo

  -- For the PROJECT, remove any of duplicates from the return array so that they can be added by manual selection from the duplicate form
  if (!this.form.what.selection().eq('PROJ')) then
    !returnArray = !returnArray.difference(!sameArray)
  endif

  -- For db number overlap of those trying to be added, offer them for selection
--  if (!foundDuplicate.not() and !sameArray.empty().not()) then
  if (!sameArray.empty().not()) then
    !!alert.error('You have selected several databases with the same database number. As only one can be stamped for each number, please selected them from the Duplicate Databases form.')
    !!admDuplicate(!sameArray,!sameDbNos,'CHOOSE')

  -- Test for a db number overlap with those already added
--  elseif (!foundDuplicate and !returnArray.empty().not()) then
  elseif (!alreadyAdded.empty().not() and !returnArray.empty().not()) then
    !!alert.error('The Stamp already contains databases with the same database number as at least one of those selected. The databases with duplicate numbers have been removed from the list while the remainder will be added')
    !!admDuplicate(!alreadyAdded,!emptyDbNos,'LIST')

  -- All selected have db numbers the same as those already added
  elseif (!foundDuplicate and !returnArray.empty()) then
    if (!dbRefs.size().eq(1)) then
      !!alert.error('The Stamp already contains a database with the same database number as the one selected. It cannot therefore be added')
      !this.form.display.clearSelection()
    else
      !!alert.error('The Stamp already contains databases with the same database numbers as those selected. The result is that no databases will be added')
    endif

  -- No dbs to stamp
  elseif (!returnArray.empty()) then
    !!alert.message('Cannot find any databases to stamp')
  endif

  return !returnArray

endmethod
-- End of method definition for .chkDbno()

------------------------------------------------------------------------
--
--Method: .chkSess(ARRAY,BOOLEAN)
--
-- Description: Check for dbs without a session before the stamp date
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      Array of string DBREF's of DB's
--    2   R      BOOLEAN    Display messages or not
-- Return:
--   [Data Type] [Description]
--    ARRAY      Array of string DBREFS of DB's that can be added
--
------------------------------------------------------------------------
-- Define method
define method .chkSess(!dbRefs is ARRAY, !messages is BOOLEAN) is ARRAY

  -- Initialise variables
  !noSess = false
  !returnArray = ARRAY()

  -- Test for session number before the stamp date
  do !index ind !dbRefs

    -- Get session number
    !session = !!admDbDateSess(!dbRefs[!index])
    if (!session.unset()) then
      !noSess = true
    else
      !returnArray.append(!dbRefs[!index])
    endif

  enddo

  -- Test for no session number
  if (!messages) then
    if (!noSess and !returnArray.empty().not()) then
      !!alert.error('At least one of the selected databases does not have a session number before the stamp date. These databases have been removed from the list while the remainder will be added')
    elseif (!noSess and !returnArray.empty()) then
      if (!dbRefs.size().eq(1)) then
        !!alert.error('The selected database does not have a session number before the stamp date. It cannot therefore be added')
      else
        !!alert.error('At least one of the selected databases do not have a session number before the stamp date. The result is that no databases will be added')
      endif
    elseif (!returnArray.empty()) then
      !!alert.message('Cannot find any databases to stamp')
    endif
  endif

  return !returnArray

endmethod
-- End of method definition for .chkSess(ARRAY,BOOLEAN)

------------------------------------------------------------------------
--
-- Method: .clrActive()
--
-- Description: Set clear button active status
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .clrActive()

  if (!this.form.curDbs.rtext.size().eq(0)) then
    !this.form.clr.active = false
  else
    !this.form.clr.active = true
  endif

endmethod
-- End of method definition for .clrActive()

------------------------------------------------------------------------
--
-- Method: .create(ARRAY)
--
-- Description: Create the stamp lists
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of ADMSTAMP objects
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Whether any STLST elements were actually created
--
------------------------------------------------------------------------
-- Define method
define method .create(!allObjs is ARRAY) is BOOLEAN

  -- Initialise variables
  !created = FALSE

  -- Create the hierarchy for each db
  do !index ind !allObjs

    -- Create the stamp list element & set attributes
    NEW STLST
    handle (41,8)
      -- not at the correct level of the hierarchy
      !!ce = !this.dbRef
      NEW STLST
    endhandle
     STLSF $!<allObjs[$!index].dbRef>
       handle (1,139)
         -- DB is already referenced by STAMP
         DELETE STLST
       elsehandle (1,138)
         -- Session does not exist
         DELETE STLST
       elsehandle none
         STSESS $!<allObjs[$!index].sessNo>
         !created = true
       endhandle

  enddo

  -- Return to owning stamp
  STAMP

  return !created

endmethod
-- End of method definition for .create(ARRAY)

------------------------------------------------------------------------
--
--Method: .curProj()
--
-- Description: Move the selected entry from current to project
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .curProj()

  -- Check at least one entry has been selected
  if (!this.form.curDbs.val.unset() or !this.form.curDbs.val.empty()) then
    return
  endif

  -- Remove from the current lists
  do !index val !this.form.curDbs.val
    !this.stampDbRefs.deleteFrom(!index,1)
    !this.stampedDbs.deleteFrom(!index,1)
  enddo

  -- Refresh current display
  !this.currDbList()

  -- Refresh the display for Dbs
  if (!this.form.what.selection().eq('BYDB')) then
    !this.projDbList()
  elseif (!this.form.what.selection().eq('BYWE')) then
    !this.workDbList()
  endif

  -- Check for an empty list
  -- In which case we can make a date available if one wasn't before
  if (!this.form.sess.val.not() and (!this.form.curDbs.rtext.unset() or !this.form.curDbs.rtext.empty())) then
    if (!this.dateString.unset()) then
      -- Set date to now
      !this.setDate(object DATETIME())
      !this.storeDate()
    endif
    !this.dateActive(true)
    !this.form.apply.active = false
  else
    -- Set apply active
    !this.form.apply.active = true
  endif

  -- Set clear button
  !this.clrActive()


endmethod
-- End of method definition for .curProj()

------------------------------------------------------------------------
--
--Method: .currDbList()
--
-- Description: Control the contents on the Current Database list gadget
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of current databases
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .currDbList()

  -- Build a DBLISTATTR object to define content of DB list
  !listFormat             = object DBLISTATTR()
  !listFormat.name        = true
  !listFormat.typeDb      = true
  !listFormat.dbNo        = true
  !listFormat.description = true
  !listFormat.access      = false
  !listFormat.claim       = false
  !listFormat.filename    = false
  !listFormat.sequence    = false
  !listFormat.session     = true

  -- Get stamped db reference array into name order
  !getName = object BLOCK('!this.stampDbRefs[!evalIndex].flnn')
  !stampNames = !this.stampDbRefs.evaluate(!getName)
  !sort = !stampNames.sortedIndices()
  !this.stampDbRefs.reIndex(!sort)
  !this.stampedDbs.reIndex(!sort)

  -- Test for global project
  !globalProject = !!admControl.isValid('Global')
  if (!globalProject) then
    !wrtLoc = !!adminApplic.getAdmContext()
  else
    !wrtLoc = object DBREF()
  endif

  -- Build list gadget
  !dbList = object ADMTEXTLIST()
  !dbList.addDbs(!this.stampDbRefs, !listFormat, true, !this.form.curDbs, !wrtLoc)

endmethod
-- End of method definition for .currDbList(ARRAY)

------------------------------------------------------------------------
--
--Method: .curDbSet()
--
-- Description: Set the database array for the current STAMP
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .curDbSet()

  -- Initialise variables
  !ce = !!ce
  !stampRef = !this.dbRef
  !dbRefs = ARRAY()
  !dbStrings = ARRAY()
  !dbObjs = ARRAY()
  !this.stlstRefs = ARRAY()

  -- Check for an unset DBREF
  if (!stampRef.badRef() or !stampRef.unset()) then
    !dbRefs = ARRAY()
  else

    -- Collect all stamp lists
    VAR !allStlst COLL ALL STLST FOR $!stampRef

    -- Get stamp reference array into name order
    do !stlst val !allStlst

      -- Check for any unset db references i.e. FIX
      if (!stlst.dbRef().stlsf.unset()) then
        !!ce = !stlst.dbRef()
        DELETE STLST
      else
        !this.stlstRefs.append(!stlst.dbRef())
        !dbRefs.append(!stlst.dbRef().stlsf)
        !dbStrings.append(!stlst.dbRef().stlsf.string())
        !dbObjs.append(object ADMSTAMP(!stlst.dbRef().stlsf,!stlst.dbRef().stSess))
      endif

    enddo

  endif

  -- Store the values
  !this.existDbRefs = !dbRefs
  !this.existDbStrings = !dbStrings
  !this.stampDbRefs = !dbRefs
  !this.stampedDbs = !dbObjs

  -- Restore the database position
  !!ce  = !ce
    handle (2,822)
      -- Cannot set current element to an unset reference
    endhandle

endmethod
-- End of method definition for .curDbSet()

------------------------------------------------------------------------
--
-- Method: .dateActive(BOOLEAN)
--
-- Description: Set date active gadgets
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Set gadgets active or inactive
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .dateActive(!active is BOOLEAN)

  -- Set date gadgets on
  if (!active) then

    !this.form.upH.active = true
    !this.form.dnH.active = true
    !this.form.hour.active = true
    !this.form.mins.active = true
    !this.form.upM.active = true
    !this.form.dnM.active = true
    !this.form.day.active = true
    !this.form.month.active = true
    !this.form.year.active = true
    !this.form.upY.active = true
    !this.form.dnY.active = true
    !this.form.now.active = true

  -- Set date gadgets off
  else

    !this.form.upH.active = false
    !this.form.dnH.active = false
    !this.form.hour.active = false
    !this.form.mins.active = false
    !this.form.upM.active = false
    !this.form.dnM.active = false
    !this.form.day.active = false
    !this.form.month.active = false
    !this.form.year.active = false
    !this.form.upY.active = false
    !this.form.dnY.active = false
    !this.form.now.active = false

  endif

endmethod
-- End of method definition for .dateActive()

------------------------------------------------------------------------
--
-- Method: .dateUnset()
--
-- Description: Unset date gadgets
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .dateUnset()

    !this.form.hour.val = ''
    !this.form.mins.val = ''
    !this.form.day.clearSelection()
    !this.form.month.clearSelection()
    !this.form.year.clear()

endmethod
-- End of method definition for .dateUnset()

------------------------------------------------------------------------
--
-- Method: .dbActive(STRING)
--
-- Description: Set database active gadgets
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      ON or OFF
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .dbActive(!onOff is STRING)

  if (!onOff.eq('OFF')) then

    !this.form.display.clear()
    !this.form.curDbs.clear()

    !this.form.display.active = false
    !this.form.sort.active = false
    !this.form.filter.active = false
    !this.form.add.active = false
    !this.form.rem.active = false
    !this.form.clr.active = false
    !this.form.curDbs.active = false
    -- Session gadget, Up and Down arrow buttons should be disabled when the Build option is 'PROJECT'
    !this.form.upS.active     = false
    !this.form.dnS.active     = false
    !this.form.session.active = false
  else

    !this.form.display.active = true
    !this.form.sort.active = true
    !this.form.filter.active = true
    !this.form.add.active = true
    !this.form.rem.active = true
    !this.form.clr.active = true
    !this.form.curDbs.active = true

  endif

endmethod
-- End of method definition for .dbActive(STRING)

------------------------------------------------------------------------
--
-- Method: .dbSetList()
--
-- Description: Populate display list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .dbSetList()

  -- Clear the display list gadget
  !this.form.display.clear()

  -- Sort the list
  !displayRefs  = !!adminFilterSort(!this.dbSetRefs, !this.form.sort, !this.form.filter)

  -- Display the list
  !!admDbSetTxtList(!displayRefs, !this.form.display,!!admDisplayConfig.fmtDbSetGet(), !!admDisplayConfig.eleTypeGet())

  -- Set frame text
  !this.form.displayFr.tag = ' Database Sets '

endmethod
-- End of method definition for .dbSetList()

------------------------------------------------------------------------
--
-- Method: .dbSetSet()
--
-- Description: Get db sets
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .dbSetSet()

  -- Initialise variables
  !ce = !!ce

  -- Get all dbs from the db set world
  !!ce = !!dbrAdminGetWorld('DBSET')
  !this.dbSetRefs = !!ce.mem

  -- Return to the database position
  !!ce = !ce

endmethod
-- End of method definition for .dbSetSet()

------------------------------------------------------------------------
--
-- Method: .display()
--
-- Description: Function to display this form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Mode to display form in (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .display(!mode is STRING)

  -- Set the dbRef dependent on mode
  if (!mode.upCase() eq 'CREATE') then

    -- Initialise variables
    !this.dbRef = object DBREF()

    -- Allow the date to be modified
    !this.dateActive(true)

  elseif (!mode.upCase() eq 'MODIFY') then

    -- Get the dbRef of the current stamp
    !dbRef  = !!adminElem.stampGet()
    if (!dbRef.unset()) then
      -- No action required (don't show form)
      return
    elseif (!dbRef.eq(!this.dbRef) and !this.form.shown()) then
      -- No action required
      return
    elseif (!dbRef.badRef()) then
      -- Raise error
      !!messageFile.error(141, 106,  !dbRef.string())
      handle (06, 106)
        !!adminElem.update('STAMP')
        return
      endhandle
    endif

    -- Set the new reference
    !this.dbRef = !dbRef

    -- Do not allow the date to be modified
    !this.dateActive(false)

  endif

  -- Select the mode
  !this.modeSet(!mode.upCase())

  -- Show or update the form
  if (!!admStamp.shown()) then

    -- Re-initialise the form
    !this.init()

  else

    -- Show the form
    show !!admStamp free

  endif

endmethod
-- End of method definition for .display(STRING)

------------------------------------------------------------------------
--
-- Method: .getDbSessions()
--
-- Description: Get all session numbers for a selected db
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .getDbSessions()

  -- Check for no selected db or stamp is by date
  if (!this.form.display.val.empty() or !this.form.display.val.unset() or !this.form.date.val) then
    !this.form.session.clear()
    return

  -- Check for >1 selected dbs
  elseif (!this.form.display.val.size().gt(1)) then

    -- Select only the last selected db
    !this.form.display.clearSelection()
    !this.form.display.val = !this.form.display.pickedField
      handle (61,620)
        -- Name Already exists
        !!alert.warning(|This is a single selection operation only|)
      endhandle
    !this.getDbSessions()

  else

    -- Get db
    !dbObj = object DB(!this.form.display.selection()[1])

    -- Display last session
    !this.currentNumber = !dbObj.lastSession().number
    !this.currentDb = !dbObj
    !this.form.session.val = !this.currentNumber

  endif

  -- Make session gadget active
  !this.form.session.active = true
  !this.form.upS.active     = true
  !this.form.dnS.active     = true

endmethod
-- End of method definition for .getDbSessions()

------------------------------------------------------------------------
--
-- Method: .init()
--
-- Description: initialise this form.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .init()

  -- Initialise variables
  !mode = !this.modeGet()
  !dbRef = !this.dbRef
  !this.allDbRefs = ARRAY()
  !this.projDbRefs = ARRAY()
  !this.stampDbRefs = ARRAY()
  !this.dbSetRefs = ARRAY()
  !this.mdbRefs = ARRAY()
  !this.workDbRefs = ARRAY()
  !this.existDbRefs = ARRAY()
  !this.stlstRefs = ARRAY()

  -- Clear display duplicate form array
  if (undefined(!!admDuplicate)) then
    pml load form !!admDuplicate
  else
    !!admDuplicate.formMethods.dbRefs.clear()
  endif

  -- Assign sort values
  !this.sortValues()

  -- Sort and filter values
  if (!this.form.filter.val.empty()) then
    !this.form.filter.val = |*|
  endif
  !this.filterVal = !this.form.filter.val
  !this.sortVal   = !this.form.sort.selection('RTEXT')

  -- Test for no existing stamps
  if (!!adminElem.stampRefs.unset()) then
    !this.form.mode.active = false
  else
    !this.form.mode.active = true
  endif

  -- Set the form gadgets according to mode
  if (!mode eq 'CREATE') then

    !this.form.formTitle  = 'Create Date Stamp'
    !this.form.name.val   = 'unset'
    !this.form.desc.val   = 'unset'
    !this.form.func.val   = 'unset'

    -- Set date gadgets
    !this.form.sess.val = FALSE
    !this.form.date.val = TRUE
    !this.dateActive(true)
    !this.stampDate('NOW')

    -- Set stamp for Project
    !this.form.what.select('RTEXT','PROJ')
    !this.stampMethod = 'PROJ'

  elseif (!mode eq 'MODIFY') then

    -- Set for title
    !this.form.formTitle  = 'Modify Date Stamp: ' & !dbRef.name.substring(2)

    -- Set stamp info
    !this.form.name.val = !dbRef.name.substring(2)
    if (!dbRef.description.empty()) then
      !this.form.desc.val   = 'unset'
    else
      !this.form.desc.val   = !dbRef.description
    endif
    if (!dbRef.function.empty()) then
      !this.form.func.val   = 'unset'
    else
      !this.form.func.val   = !dbRef.function
    endif

    -- Set stamp what type gadget
    if (!dbRef.purp.neq('')) then
      !this.form.what.select('RTEXT',!dbRef.purp)
      !this.stampMethod = !dbRef.purp
    endif

    -- Set date gadgets
    !this.stampDate('DBREF')

    -- Set apply inactive
    !this.form.apply.active = false

    -- Do not allow the date to be modified
    !this.dateActive(false)

  endif

  -- Get the database information
  if (!this.form.what.selection().eq('PROJ')) then
    !this.projDbSet()
    !this.form.setBy.active = false
  elseif (!this.form.what.selection().eq('BYDB')) then
    !this.projDbSet()
    !this.form.setBy.active = true
  elseif (!this.form.what.selection().eq('DBST')) then
    !this.dbSetSet()
    !this.form.setBy.active = false
  elseif (!this.form.what.selection().eq('MDBS')) then
    !this.projMdbSet()
    !this.form.setBy.active = false
  elseif (!this.form.what.selection().eq('TEAM')) then
    !this.teamSet()
    !this.form.setBy.active = false
  elseif (!this.form.what.selection().eq('BYWE')) then
    !this.workDbSet()
    !this.form.setBy.active = true
  endif
  !this.curDbSet()

  -- Set focus to the name gadget
  !this.form.name.setFocus()

  -- Set database gadgets active state
  if (!this.form.what.selection().eq('PROJ')) then
    !this.dbActive('OFF')
  else
    !this.dbActive('ON')
  endif

  -- Populate the list gadgets
  if (!this.form.what.selection().neq('PROJ')) then
    if (!this.form.what.selection().eq('DBST')) then
      !this.dbSetList()
    elseif (!this.form.what.selection().eq('MDBS')) then
      !this.projMdbList()
    elseif (!this.form.what.selection().eq('TEAM')) then
      !this.teamList()
    elseif (!this.form.what.selection().eq('BYWE')) then
      !this.workDbList()
    else
      !this.projDbList()
    endif
    !this.currDbList()
  endif

  -- Set clear button
  !this.clrActive()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
--Method: .mode()
--
-- Description: Callback to the Mode gadget in the MDB Definition form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .mode()

  -- Read the mode value
  !mode    = !this.modeGet()

  -- Call the display method to reset the form
  !this.display(!mode)

endmethod
-- End of method definition for .mode()

------------------------------------------------------------------------
--
--Method: .modeGet()
--
-- Description: return the current mode of the MDB definition form.
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Mode of form
--
------------------------------------------------------------------------
-- Define method
define method .modeGet() is STRING

  if (Undefined (!!admMdb)) then
     !!loadForm ('admmdb')
  endif

  -- Return the current mode
  return  !this.form.mode.selection('rtext')

endmethod
-- End of method definition for .modeGet() STRING

------------------------------------------------------------------------
--
--Method: .modeSet()
--
-- Description: set the mode of the this form
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mode to set (CREATE/MODIFY)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .modeSet(!mode is STRING)

  -- Set the mode gadget
  !this.form.mode.select('rtext',!mode.upCase())
    handle any
      -- Dummy handle (should not happen)
    endhandle

endmethod
-- End of method definition for .modeSet(STRING)

------------------------------------------------------------------------
--
--Method: .month(BOOLEAN)
--
-- Description: Set the number of days in the month
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to store the date
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .month(!store is BOOLEAN)

  -- Initialise variables
  !days30 = 'SEPTEMBER APRIL JUNE NOVEMBER'

  -- Build day array
  if (!this.form.month.selection('DTEXT').upCase().eq('FEBRUARY')) then

    -- Test for leap year
    !divide = !this.form.year.val / 4
    if (!divide.string().match('.').eq(0)) then
      -- Leap year
      !limit = 29
    else
      !limit = 28
    endif

  elseif (!days30.match(!this.form.month.selection('DTEXT').upCase()).neq(0)) then
    !limit = 30
  else
    !limit = 31
  endif
  do !count from 1 to 31
    !text[!count] = !count.string()
    break if (!count.eq(!limit))
  enddo

  -- Populate day gadget
  !this.form.day.dtext = !text

  -- Store new date/time
  if (!store) then
    !this.storeDate()
  endif

endmethod
-- End of method definition for .month(BOOLEAN)

------------------------------------------------------------------------
--
-- Method: .name()
--
-- Description: Check input name is valid and not used
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .name(!gadget is GADGET)

  -- Initialise variables
  !dbRef   = !this.dbRef

  -- The user name check routine
  if( !!admChkStampName(!gadget, !dbRef)) then

    -- Name was good, move focus on
    !this.form.desc.setFocus()

    -- Set apply active
    !this.form.apply.active = true

  else
    -- Name was bad, keep focus here
    !this.form.name.setFocus()
  endif

endmethod
-- End of method definition for .name(GADGET)

------------------------------------------------------------------------
--
--Method: .projCur()
--
-- Description: Move the selected entry from project to current
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .projCur()

  -- Check at least one entry has been selected
  if (!this.form.display.val.unset() or !this.form.display.val.empty()) then
    return
  endif

  -- Initialise variables
  !selection = !this.form.display.selection()
  !dbRefs = ARRAY()

  -- Check whether the selected session matches the date
  -- This is necessary to prevent a stamp being regarded as by date when it isn't
  if (!this.dateString.set() and !this.form.sess.val ) then

    -- Get session number for the selected db on the chosen date
    !dbObj = object DB(!selection[1])
    VAR !sessByDate SESSION ON $!<this.dateString> $!<dbObj.name>

    if (!this.form.session.val.neq(!sessByDate.real())) then
      !response = !!alert.question('You are attempting to stamp a database at a different date to that originally specified. Do you wish to continue?')
      if (!response.eq('NO') or !response.eq('CANCEL')) then
        return
      endif
    endif

   -- Unset the date
   !this.dateString = STRING()
   !this.dateUnset()
  elseif (!this.dateString.set() and !this.form.sess.val) then
  	!this.storeDate()

  endif

  -- Get databases depending on what is being stamped
  -- Remember that this button is not active for option PROJ
  if (!this.form.what.selection().eq('DBST')) then

    -- Get dbs for each db set
    do !dbSet val !selection
      VAR !dblStrings COLL ALL DBL FOR $!dbSet
      !getDbref = object BLOCK('!dblStrings[!evalIndex].dbRef().dbf')
      !dbRefs.appendArray(!dblStrings.evaluate(!getDbref))
    enddo

  elseif (!this.form.what.selection().eq('MDBS')) then

    -- Get dbs for each mdb
    do !mdb val !selection
      !mdbObj = object MDB(!mdb)
      !getDbref = object BLOCK('!mdbObj.current()[!evalIndex].refno.dbRef()')
      !dbRefs.appendArray(!mdbObj.current().evaluate(!getDbref))
    enddo

  elseif (!this.form.what.selection().eq('TEAM')) then

    -- Get dbs for each team
    do !team val !selection
      VAR !dbStrings COLL ALL DB FOR $!team
      !getDbref = object BLOCK('!dbStrings[!evalIndex].dbRef()')
      !dbRefs.appendArray(!dbStrings.evaluate(!getDbref))
    enddo

  else

    -- Get selected dbrefs
    !getDbref = object BLOCK('!selection[!evalIndex].dbRef()')
    !dbRefs = !selection.evaluate(!getDbref)

  endif

  -- Check for dbs without a session before the stamp date
  !validDbs = !this.chkSess(!dbRefs,true)
  if (!validDbs.unset() or !validDbs.empty()) then
    return
  endif

  -- Check that there are no duplicate DBNO's
  -- Had to check sessions before db numbers because I did not want to display duplicates only to report that it did not have a relevant session
  !validDbs = !this.chkDbno(!validDbs)
  if (!!admDuplicate.formMethods.dbRefs.empty().not()) then
    !!admDuplicate.show()
  endif
  if (!validDbs.unset() or !validDbs.empty()) then
    return
  endif

  -- Add to the current lists
  !this.stampDbRefs.appendArray(!validDbs)
  do !dbRef val !validDbs

    -- Add stamp objects
    !this.stampedDbs.append(object ADMSTAMP(!dbRef,!!admDbDateSess(!dbRef)))

  enddo

  -- Refresh the current display
  !this.currDbList()

  -- Refresh the display for Dbs
  if (!this.form.what.selection().eq('BYDB')) then
    !this.projDbList()
  elseif (!this.form.what.selection().eq('BYWE')) then
    !this.workDbList()
  endif

  -- Offer the list of db's found to have the same db number
  if (!!admDuplicate.formMethods.dbRefs.empty().not()) then
    !!admDuplicate.show()
  endif

  -- For sessions clear the session number gadget
  if (!this.form.sess.val) then
    !this.form.session.clear()
    !this.form.session.active = false
    !this.form.upS.active     = false
    !this.form.dnS.active     = false

  endif

  -- Set clear button active
  !this.clrActive()

  -- Set apply active
  !this.form.apply.active = true

endmethod
-- End of method definition for .projCur()

