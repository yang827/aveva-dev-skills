------------------------------------------------------------------------
--
-- Method: .update()
--
-- Description: update the displayed STAMP in this form.
-- The form must be displayed and in MODIFY mode.
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .update()

  -- Initialise variables
  !mode    = !this.modeGet()
  !selUser = !!adminElem.userGet()
  !curUser = !this.dbRef

  -- Return if the form is not shown
  if (!this.shown().not()) then
    return
  endif

  -- Return if not modify mode
  if (!mode neq 'MODIFY') then
    return
  endif

  -- Return if the same reference
  if (!selUser eq !curUser) then
    return
  endif

  -- Reinitialise the form
  !this.dbRef = !selUser
  !this.init()

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method: .upDown()
--
-- Description: Raise or lower passed time counter

------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      Calling gadget
--    2    R     STRING      Counter type MINS, HOUR or YEAR
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .upDown(!gadget is GADGET, !dir is STRING, !type is STRING)

  -- Initialise variables
  if (!type.eq('HOUR')) then
    !max = 23
    !min = 0
  elseif (!type.eq('MINS')) then
    !max = 59
    !min = 0
  elseif (!type.eq('YEAR')) then
    !max = !this.currDate.year()
    !min = 1996
  endif

  -- Calculate new value
  if (!dir.eq('UP')) then
    if (!gadget.val.real().eq(!max)) then
      !value = !min
    else
      !value = !gadget.val.real() + 1
    endif
  else
    if (!gadget.val.real().eq(!min)) then
      !value = !max
    else
      !value = !gadget.val.real() - 1
    endif
  endif

  -- Display value
  if (!type.eq('YEAR')) then
    !gadget.val = !value
  else
    !gadget.val = !this.zero(!value.string())
  endif

  -- Store new date/time
  !this.storeDate()

endmethod
-- End of method definition for .upDown()

------------------------------------------------------------------------
--
--Method: .workDbList()
--
-- Description: Control the Working Extracts contents in the display list
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .workDbList()

  -- Clear the display list gadget
  !dbArray  = !this.workDbRefs.difference(!this.stampDbRefs)
  !this.form.display.clear()

  -- Sort the list
  !displayRefs  = !!adminFilterSort(!dbArray, !this.form.sort, !this.form.filter)

  -- Display the list
  !!adminDbTxtList(!displayRefs, !this.form.display, !!admDisplayConfig.fmtDbGet(), !!admDisplayConfig.eleTypeGet(),object DBREF())

  -- Set frame text
  !this.form.displayFr.tag = ' Working Extracts '

endmethod
-- End of method definition for .projMdbList()

------------------------------------------------------------------------
--
--Method: .workDbSet()
--
-- Description: Gets all project databases
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .workDbSet()

  -- Initialise variables
  !ce = !!ce

  -- Get all dbs from the user world
  !!ce = !!dbrAdminGetWorld('USER')
  VAR !workStrings COLLECT ALL DB FOR CE
  !buildDbref = object BLOCK('!workStrings[!evalIndex].dbRef()')
  !this.workDbRefs = !workStrings.evaluate(!buildDbref)

  -- Return to the database position
  !!ce = !ce

endmethod
-- End of method definition for .workDbSet()

------------------------------------------------------------------------
--
-- Method: .zero()
--
-- Description: Calculate any leading required zeros
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .zero(!string is STRING) is STRING

  -- Is a leading zero required?
  if (!string.length().eq(1)) then
    !value = '0' & !string
  else
    !value = !string
  endif
  return !value

endmethod
-- End of method definition for .zero()
