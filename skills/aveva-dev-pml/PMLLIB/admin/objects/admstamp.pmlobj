------------------------------------------------------------------------
--
-- Method: .remAll()
--
-- Description: Remove all current displayed stamped dbs
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .remAll()

  -- Clear gadgets and members
  !this.form.curDbs.clear()
  !this.stampDbRefs.clear()
  !this.stampedDbs.clear()

  -- Refresh for dbs & working dbs
  if (!this.form.what.selection().eq('BYDB')) then
    !this.projDbList()
  elseif (!this.form.what.selection().eq('BYWE')) then
    !this.workDbList()
  endif

  -- Activate the date if inactive
  if (!this.form.day.active.not()) then
    !this.dateActive(true)
  endif

  -- Set this button active status
  !this.clrActive()

endmethod
-- End of method definition for .remAll()

------------------------------------------------------------------------
--
-- Method: .sessUpDown(STRING)
--
-- Description: Cycle through sessions
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     STRING      Cycle UP or DOWN the list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .sessUpDown(!direction is STRING)

  -- Determine next array position
  -- Remember count is in reverse due to sessions
  if (!direction.eq('UP')) then
    !nextSession = !this.currentDb.sessionRange(!this.currentNumber, 2)
    !next = !nextSession[!nextSession.size()].number
  else
    !nextSession = !this.currentDb.sessionRange(!this.currentNumber, -2)
    !next = !nextSession[!nextSession.size()].number
  endif

  -- Store the next index
    !this.currentNumber = !next

  -- Display the session value
    !this.form.session.val = !this.currentNumber

endmethod
-- End of method definition for .sessUpDown(STRING)

------------------------------------------------------------------------
--
-- Method: .setBy()
--
-- Description: Set the stamp by date or sessions
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setBy()
  -- For session
  if (!this.form.sess.val) then
    -- Test that current stamp what is db or working extracts
    if (!this.form.what.selection().neq('BYDB') and !this.form.what.selection().neq('BYWE')) then
      -- Message
      !!alert.warning('You can only stamp by session when stamping databases, extracts or working extracts')

      -- Set stamp option to original stamp option
      if (!this.form.what.selection().neq(!this.stampMethod)) then
        !this.form.what.select('RTEXT',!this.stampMethod)
        !this.stampWhat(false)
      endif

      -- Set by date
      !this.setByActive('DATE',true)

    else

      -- Set by session
      !this.setByActive('SESSION',true)

      -- For a selected db
      !this.getDbSessions()

    endif

  -- For date
  else
    -- Test for no date
    if (!this.dateString.unset() and !this.form.curDbs.rtext.size().neq(0)) then
     !!alert.warning('You cannot stamp by date once a stamp has been set by sessions. Remove all dbs first.')
      !this.setByActive('SESSION',true)
    else
     !this.setByActive('DATE',true)
     !this.stampDate('NOW')
    endif

  endif

endmethod
-- End of method definition for .setBy()

------------------------------------------------------------------------
--
-- Method: .setByActive(STRING,BOOLEAN)
--
-- Description: Set by active
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING     Whether to set date or session
--    2    R     BOOLEAN    Whether to set the date gadgets active status
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setByActive(!option is STRING, !set is BOOLEAN)

  -- Initialise variables
  !mode = !this.modeGet()
  if (!option.eq('DATE')) then

    -- Set gadgets
    !this.form.date.val = TRUE
    !this.form.session.active = false
    !this.form.upS.active = false
    !this.form.dnS.active = false

    -- Set date gadgets active state
    if (!set) then
      if (!mode eq 'CREATE') then
        !this.dateActive(true)
      else
      	if (!this.form.curDbs.rtext.size().neq(0)) then
      		!this.dateActive(false)
      	else
      		!this.dateActive(true)
      	endif	
      endif
    endif

  else
    !this.form.sess.val = TRUE
    if (!this.form.display.selection().size().neq(0)) then
      -- Up and Down arrow for session gadget should be active when the DB session option selected.
      !this.form.upS.active = true
      !this.form.dnS.active = true
      !this.form.session.active = true
    endif
    if (!set) then
      !this.dateActive(false)
    endif
  endif

endmethod
-- End of method definition for .setByActive(STRING,BOOLEAN)

------------------------------------------------------------------------
--
-- Method: .setDate(DATETIME)
--
-- Description: set the date object gadgets
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DATETIME      Date object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setDate(!dateTime is DATETIME)

    -- Set date gadgets
    -- Hour/Mins
    !this.form.hour.val = !this.zero(!dateTime.hour().string())
    !this.form.mins.val = !this.zero(!dateTime.minute().string())

    -- Do year before month so can check for a leap year
    !this.form.year.val = !dateTime.year()

    -- Do month before day so can populate day gadget
    !this.form.month.select('DTEXT',!dateTime.monthString())
    !this.month(false)

    -- Do day
    !this.form.day.select('DTEXT',!dateTime.date().string())

endmethod
-- End of method definition for .setDate(DATETIME)

------------------------------------------------------------------------
--
-- Method:      .sort()
--
-- Description: Sort the displayed list
-- for later use.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .sort()

  -- Populate display list
  if (!this.form.what.selection().eq('PROJ')) then
    !this.projDbList()
  elseif (!this.form.what.selection().eq('DBST')) then
    !this.dbSetList()
  elseif (!this.form.what.selection().eq('MDBS')) then
    !this.projMdbList()
  elseif (!this.form.what.selection().eq('BYWE')) then
    !this.workDbList()
  else
    !this.projDbList()
  endif

endmethod
-- End of method definition for .sort()

------------------------------------------------------------------------
--
-- Method: .sortValues()
--
-- Description: Set the sort values
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .sortValues()

  if (!this.form.what.selection().eq('PROJ')) then
    !!admDbSortGadg(!this.form.sort)
  elseif (!this.form.what.selection().eq('DBST')) then
    !!admPackSortGadg(!this.form.sort)
  elseif (!this.form.what.selection().eq('MDBS')) then
    !!admMdbSortGadg(!this.form.sort)
  elseif (!this.form.what.selection().eq('BYWE')) then
    !!admDbSortGadg(!this.form.sort)
  else
    !!admDbSortGadg(!this.form.sort)
  endif

endmethod
-- End of method definition for .sortValues()

------------------------------------------------------------------------
--
-- Method: .stampDate(STRING)
--
-- Description: set the date gadgets
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Which date to set
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .stampDate(!dateType is STRING)

  -- Get date for selected stamp
  if (!dateType.eq('NOW')) then

      -- Test for active date
      if (!this.form.day.active) then

        -- Use today
        !this.setDate(object DATETIME())

      else
        return
      endif

  else

    -- For unset date
    if (!this.dbRef.setDat.eq('')) then

      -- Set date gadgets inactive
      !this.dateUnset()
      !this.dateString = STRING()
      !this.dateActive(false)

      -- Set by Session
      !this.setByActive('SESSION',false)

      -- Stamp by db
      if (!this.dbRef.purp.upCase().eq('BYDB') or !this.dbRef.purp.upCase().eq('BYWE')) then
        !this.form.what.select('RTEXT',!this.dbRef.purp.upCase())
      else
        !this.form.what.select('RTEXT','BYDB')
      endif
      !this.stampWhat(false)
      return

    else

      -- Use stamp date
      !this.setDate(object DATETIME(!this.dbRef.setDat))

      -- Set date gadgets active
      !this.dateActive(true)

      -- Set by date
      !this.setByActive('DATE',false)

    endif

  endif

  -- Store new date/time
  !this.storeDate()

endmethod
-- End of method definition for .stampDate(STRING)

------------------------------------------------------------------------
--
-- Method: .stampWhat(BOOLEAN)
--
-- Description: Set what to stamp
--
------------------------------------------------------------------------
--
-- Method Type:   Method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     BOOLEAN     Whether to put out messages or not
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .stampWhat(!message is BOOLEAN)

  -- Test if the option has already been displayed hence do nothing
  if (!this.form.what.selection().eq(!this.stampMethod)) then
    return
  endif

  -- Assign the sort values
  !this.sortValues()

  -- Test for no date
  if (!this.dateString.unset()) then
    if (!this.form.what.selection().neq('BYDB') and !this.form.what.selection().neq('BYWE')) then

      -- Test for message
      if (!message) then
        !!alert.warning(|When there isn't a date, you can only stamp by database, extracts or working extracts and by session|)
      endif

      -- Return to previous stamp method
      !this.form.what.select('RTEXT',!this.stampMethod)

      -- Set by session
      if (!this.form.date.val) then
        !this.setByActive('SESSION',true)
      endif

    endif
  else
    !this.setByActive('DATE',true)
  endif

  -- Populate the database gadgets
  if (!this.form.what.selection().eq('PROJ')) then
    if (!this.allDbRefs.empty()) then
      !this.projDbSet()
    endif
    !this.form.display.clear()
    !this.form.curDbs.clear()
    !this.dbActive('OFF')
    !this.form.setBy.active = false
  elseif (!this.form.what.selection().eq('DBST')) then
    if (!this.dbSetRefs.empty()) then
      !this.dbSetSet()
    endif
    !this.dbSetList()
    !this.currDbList()
    !this.dbActive('ON')
    !this.form.setBy.active = false
  elseif (!this.form.what.selection().eq('MDBS')) then
    if (!this.mdbRefs.empty()) then
      !this.projMdbSet()
    endif
    !this.projMdbList()
    !this.currDbList()
    !this.dbActive('ON')
    !this.form.setBy.active = false
  elseif (!this.form.what.selection().eq('TEAM')) then
    if (!this.teamRefs.empty()) then
      !this.teamSet()
    endif
    !this.teamList()
    !this.currDbList()
    !this.dbActive('ON')
    !this.form.setBy.active = false
  elseif (!this.form.what.selection().eq('BYWE')) then
    if (!this.workDbRefs.empty()) then
      !this.workDbSet()
    endif
    !this.workDbList()
    !this.currDbList()
    !this.dbActive('ON')
    !this.form.setBy.active = true
  else
    if (!this.allDbRefs.empty()) then
      !this.projDbSet()
    endif
    !this.projDbList()
    !this.currDbList()
    !this.dbActive('ON')
    !this.form.setBy.active = true
  endif

  -- Store selection
  !this.stampMethod = !this.form.what.selection()

endmethod
-- End of method definition for .stampWhat(BOOLEAN)

------------------------------------------------------------------------
--
-- Method: .storeDate(STRING)
--
-- Description: Store the date and date string
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .storeDate()

  -- Build & store the date object for the comparison date/time
  !hourMins = !this.form.hour.val & ':' & !this.form.mins.val
  !day = !this.form.day.selection('DTEXT')
  !month = !this.form.month.selection('DTEXT')
  !year = !this.form.year.val
  !this.date = object DATETIME(!hourMins & ' ' & !day & ' ' & !month & ' ' & !year)

  -- Store the date/time as a string WITHOUT the seconds
  !hour = !this.zero(!this.date.hour().string())
  !mins = !this.zero(!this.date.minute().string())
  !this.dateString = !hour & ':' & !mins & ' ' & !this.date.date() & ' ' & !this.date.monthString().substring(1,3) & ' ' & !this.date.year()

  -- Set apply active
  !this.form.apply.active = true

endmethod
-- End of method definition for .storeDate()

