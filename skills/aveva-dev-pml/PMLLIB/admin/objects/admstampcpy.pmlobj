--   Module:        admin
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         27 July 2001
--
--
-- Description:
-- Object to define stamp copy form methods
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cbApply()                        -                   method to copy a source user to a new user using the Admin form of
--  init()                           -                   method to initialise the Stamp Copy Form.
--  nameSet()                        -                   method to act as a callback to the Name gadget in the Copy Stamp
--  refGet()                         DBREF               method to return the DBREF of the source STAMP for a copy stamp
--  refSet(DBREF)                    -                   method to set the DBREF of the source STAMP.
--
------------------------------------------------------------------------
-- Define object
define object ADMSTAMPCPY

  -- The form
  member .form is FORM

  -- Source stamp Dbref
  member .dbRef is DBREF

endobject
-- End of object definition for ADMSTAMPCPY
------------------------------------------------------------------------
--
--Method: .cbApply()
--
-- Description: method to copy a source stamp to a new stamp using the Admin form of
-- the copy command.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .cbApply()

  -- Check for unset target name
  if (!this.form.name.val.lowcase().eq('unset')) then
    !!alert.error('Cannot copy Date Stamp when target name is unset.')
    !this.form.name.setFocus()
    return
  endif

  -- Initialise variables
  !sourceStamp      = !this.refGet()
  !sourceName       = '/' & !sourceStamp.name.substring(2)
  !targetStamp      = '/' & !this.form.name.val
  !description      = !this.form.desc.val
  !function         = !this.form.func.val

  -- Create copy command
  !command          = |COPY STAMP | & !sourceName & | TO | & !targetStamp

  -- Execute the copy command
  call !!admCommand(!command)
  handle (1,3)

    -- Stamp already exists
    !!messageFile.error(141, 103, !targetStamp)

  elsehandle (1,6)

    -- Source Stamp not found
    !!adminElem.update('Stamp')
    !!messageFile.error(141, 106, !sourceStamp)

  elsehandle any

    -- Non specific
    !!messageFile.error(141, 107, !!error.text)

  endhandle

  -- Access new stamp
  STAMP $!targetStamp

  -- Update main form
  !!adminElem.stampSet(!!ce)

  -- Copy command was a success so modify the description & function
  if (!description.empty() or !description eq 'unset') then
    !description = ''
  endif
  !!ce.description = !description

  if (!function.empty() or !function.eq('unset')) then
    !function = ''
  endif
  !!ce.function = !function

  -- Update the forms
  !!adminElem.update('STAMP')
  if (!!admStamp.shown()) then
    !!admStamp.formMethods.update()
  endif

  -- Hide this form
  !this.form.hide()

endmethod
-- End of method definition for .cbApply()

------------------------------------------------------------------------
--
--Method: .init()
--
-- Description: method to initialise the Stamp Copy Form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- -- Initialise form variables
  !dbRef     = !!adminElem.stampGet()
  !this.refSet(!dbRef)

  -- Set the form title
  !this.form.formTitle = |Copy Date Stamp: |+ !dbRef.name.substring(2)

  -- Initialise form gadgets
  !this.form.name.val  = |unset|
  if (!dbRef.description.empty()) then
    !this.form.desc.val  = |unset|
  else
    !this.form.desc.val  = !dbRef.description
  endif
  if (!dbRef.function.empty()) then
    !this.form.func.val  = |unset|
  else
    !this.form.func.val  = !dbRef.function
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
--Method: .nameSet()
--
-- Description: method to act as a callback to the Name gadget in the Copy Stamp
-- form.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .nameSet()

  -- Initialise variables
  !tempRef     = object DBREF()

  -- Call the Stamp name check
  if( !!admChkStampName(!this.form.name, !tempRef) ) then
    -- Name was good move focus on
    !this.form.desc.setFocus()
  else
    -- Name was bad keep focus here
    !this.form.name.setFocus()
  endif

endmethod
-- End of method definition for .name()

------------------------------------------------------------------------
--
--Method: .refGet()
--
-- Description: method to return the DBREF of the source Stamp for a copy Stamp
-- operation.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of source Stamp
--
------------------------------------------------------------------------

-- Define method
define method .refGet() is DBREF

  -- Return the values
  return !this.dbRef

endmethod
-- End of method definition for .refGet() DBREF

------------------------------------------------------------------------
--
--Method: .refSet()
--
-- Description: method to set the DBREF of the source Stamp.
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Source Stamp Dbref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .refSet(!dbRef is DBREF)

  -- Check that the element type is a Stamp
  if (!dbRef.type.upCase().neq('STAMP')) then
    return error
  endif

  !this.dbRef  = !dbRef

endmethod
-- End of method definition for .refSet(DBREF)
