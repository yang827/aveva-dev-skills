------------------------------------------------------------------------
--
-- Method:      .addAcrs(ARRAY, DBSETLISTATTR, BOOLEAN, GADGET)
--
-- Description: Create a list of Team data and store column formats
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Array of DBREF objects for team elements
--    2   R      DBSETLISTATTR  Team list format object
--    3   R      BOOLEAN      Use line header '<TEAM>'
--    4   RW     GADGET       Gadget for receive DTEXT & RTEXT
--
------------------------------------------------------------------------

define method .addAcrs(!dbRefArray is ARRAY, !listFormat is ACRLISTATTR, !useHeader is BOOLEAN, !list is GADGET )

  -- Clear the list gadget
  !list.clear()
  !this.colFmt = ARRAY()
  !this.colSpace = ARRAY()

  -- Check that array has values
  if (!dbRefArray.unset()) then
    return
  endif

  -- check for ADMACR or DBREF
  if(!dbRefArray[1].objectType() eq 'ADMACR') then
    !block      = object BLOCK( '!dbRefArray[!evalIndex].dbref.string()' )
  else
    -- DBREF
    !block      = object BLOCK( '!dbRefArray[!evalIndex].string()' )
  endif
  !stringRefs   = !dbRefArray.evaluate(!block)

  -- put types in first column
  VAR !temp EVAL ( TYPE ) FOR ALL FROM !stringRefs
  !block        = object BLOCK( '|<| + !temp[!evalIndex] + |>|' )
  !this.cd[1]   = !temp.evaluate(!block)
  if (!useHeader) then
    !this.colFmt[1]  = ''
  endif

  -- old EVAL syntax used for performance
  -- get names
  if (!listFormat.name) then
    VAR !temp EVAL ( substring(NAME,2) ) FOR ALL FROM !stringRefs
    !this.cd[2]      = !temp
    !this.colFmt[2]  = ''
  endif
  if (!listFormat.description) then
    VAR !temp EVAL DESCRIPTION FOR ALL FROM !stringRefs
    !this.cd[3] = !temp
    !this.colFmt[3]  = ''
  endif
------------------------try this for all list--------------------------------------------------------
   -- ACR's are slightly different to the other lists (the <type> is a separate column not a string in the first column)
     !heading[1] = 'Type'
   -- same order  and heading as team
     !validHeadings = !!admDisplayConfig.teamFormat.order
     do !i indices !validHeadings
        !c = !i + 1
        if(!!admDisplayConfig.acrFormat.attribute(!validHeadings[!i].upcase())) then
          !heading[!c] = !!admDisplayConfig.teamFormat.order[!i]
        endif
     enddo
   !heading.compress()
   !list.setHeadings(!heading)
-----------------------------------------------------------------------------------------------------
  !this.buildTable(!list)

  --!list.dText = !this.table
  !list.rText = !stringRefs

endmethod
-- End of method definition for .addAcrs(ARRAY, DBSETLISTATTR, BOOLEAN, GADGET)

------------------------------------------------------------------------
--
-- Method:      .addStamps(ARRAY, STAMPLISTATTR, BOOLEAN, GADGET)
--
-- Description: Create a list of Stamp data and store column formats
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      ARRAY          Array of DBREF objects for STAMP elements
--    2   R      STAMPLISTATTR  Stamp list format object
--    3   R      BOOLEAN        Use line header '<STAMP>'
--    4   RW     GADGET         Gadget for receive DTEXT & RTEXT
--
------------------------------------------------------------------------
-- Define Method
define method .addStamps(!dbRefArray is ARRAY, !listFormat is STAMPLISTATTR, !useHeader is BOOLEAN, !list is GADGET )

  -- Clear the list gadget
  !list.clear()
  !this.colFmt = ARRAY()
  !this.colSpace = ARRAY()

  -- Check that array has values
  if (!dbRefArray.unset()) then
    return
  endif

  if (!useHeader) then
    !displayText  = |<STAMP>  |
  else
    !displayText  = ||
  endif

  -- Discover whether this is a list of ADMVIRTUSER or DBREF objects
  !objectType = !dbRefArray[1].objectType()

  -- Get a list of string reference numbers from either DB or DBREF objects
  if(!objectType EQ |DBREF|)then
    !block = object BLOCK( '!dbRefArray[!evalIndex].string()' )
  elseif(!objectType EQ |ADMVIRTUSER|)then
    !block = object BLOCK( '!dbRefArray[!evalIndex].name.dbref().string()' )
  else
    return
  endif
  !stringRefs   = !dbRefArray.evaluate(!block)

  -- old EVAL syntax used for performance
  -- get names
  VAR !names EVAL ( replace(NAME,'/',!displayText,1,1) ) FOR ALL FROM !stringRefs
  if (!listFormat.name) then
    !this.colFmt[1]  = ''
    !this.cd[1]   = !names
  endif
  if (!listFormat.date) then
    VAR !temp EVAL SETDAT FOR ALL FROM !stringRefs
    !this.cd[2]      = !temp
    !this.colFmt[2]  = ''
  endif
  if (!listFormat.function) then
    VAR !temp EVAL FUNCTION FOR ALL FROM !stringRefs
    !this.cd[3] = !temp
    !this.colFmt[3]  = ''
  endif
  if (!listFormat.description) then
    VAR !temp EVAL DESCRIPTION FOR ALL FROM !stringRefs
    !this.cd[4] = !temp
    !this.colFmt[4]  = ''
  endif

-----------------------------------------------------------------------------------------------------
  !validHeadings = !!admDisplayConfig.stampFormat.order
  do !i indices !validHeadings
    if(!!admDisplayConfig.stampFormat.attribute(!validHeadings[!i].upcase())) then
       !heading[!i] = !!admDisplayConfig.stampFormat.order[!i]
    endif
  enddo
  !heading.compress()
  !list.setHeadings(!heading)
-----------------------------------------------------------------------------------------------------
  !this.buildTable(!list)

  --!list.dText = !this.table
  !list.rText = !stringRefs

endmethod
-- End of method definition for .addStamps(ARRAY, STAMPLISTATTR, BOOLEAN, GADGET)

------------------------------------------------------------------------
--
-- Method:      .buildTable(GADGET)
--
-- Description: Create a table using the list of Team data and stored column formats
-- Creates a formatted table from a 2D array of string data.
-- The input data array is an array of columns of data (strings). The colFmt
-- array is an array of COMPOSE command format statements to control layout.
--
-- NOTE: The strange coding of this method is deliberate. Before the !c array was
-- introduced, the complete COMPOSE command was constructed in a single text string,
-- but the string became too long, so each column is now defined in a !c array
-- element. A maximum of 16 columns can be displayed.
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .buildTable(!list is GADGET)
!this.cd.compress()

  !list.setColumns(!this.cd)
  handle(61,686)
   -- had to add the "For User" column in for the DICE form because all
   -- dbs (working et al) are listed in the dice FORM, and removed the column for DBs only list here
     !this.cd.remove(2)
     !list.setColumns(!this.cd)
  endhandle
  -- the following handle can go when the full line up exercise is complete
--  handle ANY
--  -- Initialise variables
--  !c = ARRAY()
--
--  -- loop through data columns building up a COMPOSE command with
--  -- colData[<col>][I] <format> WIDT <max. column width> SPAC 2
--  -- Command words and variable name had to be abbreviated to fit command on one line
--
--  do !col indices !this.cd
--
--    skip if( not defined( !this.colFmt[!col] ) )
--    if(defined( !this.colSpace[!col] )) then
--      !spacing = 'SPA' + !this.colSpace[!col].string()
--    else
--      !spacing = 'SPA2'
--    endif
--    !columnWidth = !this.cd[!col].width()
--    if( !columnWidth gt 0 ) then
--      !format = !this.colFmt[!col]
--      !c.append('|$$!this.cd[$!col][$$!i]|$!<format> WID$!columnWidth$!spacing')
--    endif
--
--  enddo
--
--  if( !c[1].empty() ) then
--    !this.table = ARRAY()
--    return
--  endif
--
--  do !i to 16
--    !c.append('')
--  enddo
--
--  -- execute constructed COMPOSE command for each row of the table
--  do !i indices !this.cd[1]
----
---- NOTE: The strange coding of this method is deliberate. Before the !c array was
---- introduced, the complete COMPOSE command was constructed in a single text string,
---- but the string became too long, so each column is now defined in a !c array
---- element. A maximum of 16 columns can be displayed.
---- The unused columns are set to the empty string.
----
--    VAR !row COMPOSE $!c[1] $!c[2] $!c[3] $!c[4] $!c[5] $!c[6] $!c[7] $!c[8] $!c[9] $!c[10] $!c[11] $!c[12] $!c[13] $!c[14] $!c[15] $!c[16]
--    handle any
--    endhandle
--    -- Assign Texts
--
--    !this.table[!i] = !row[1]
--  enddo
--
--
--  !list.dText = !this.table
--  --!list.rText = !stringRefs
--  endhandle
endmethod
-- End of method definition for .buildTable()

------------------------------------------------------------------------
--
-- Method:      .assignToGadget(GADGET)
--
-- Description: Assign the table to the given gadget dtext
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   RW     GADGET      List gadget to populate
--
------------------------------------------------------------------------

define method .assignToGadget( !list is GADGET )

  !list.dText = !this.table
  !list.rText = !this.stringRefs

endmethod
-- End of method definition for .assignToGadget(GADGET)
