--
-- Description:
-- Object to build tables of data for ADMIN forms
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addAcrs(ARRAY,ACRLISTATTR,BOOLEAN,GADGET) -                   Create a list of Team data and store column formats
--  addDbSets(ARRAY,DBSETLISTATTR,BOOLEAN,GADGET) -                   Create a list of Team data and store column formats
--  addDbs(ARRAY,DBLISTATTR,BOOLEAN,GADGET,DBREF) -                   Create a list of Team data and store column formats
--  addDbs(ARRAY,DBLISTATTR,BOOLEAN,GADGET,DBREF,BOOLEAN) -                   Create a list of Team data and store column formats
--  addMdbs(ARRAY,MDBLISTATTR,BOOLEAN,GADGET) -                   Create a list of Team data and store column formats
--  addRoles(ARRAY,BOOLEAN,GADGET)   -                   Create a list of Team data and store column formats
--  addScopes(ARRAY,BOOLEAN,GADGET)  -                   Create a list of Team data and store column formats
--  addStamps(ARRAY,STAMPLISTATTR,BOOLEAN,GADGET) -                   Create a list of Stamp data and store column formats
--  addTeams(ARRAY,TEAMLISTATTR,BOOLEAN,GADGET) -                   Create a list of Team data and store column formats
--  addUsers(ARRAY,USERLISTATTR,BOOLEAN,GADGET) -                   Create a list of Team data and store column formats
--  assignToGadget(GADGET)           -                   Assign the table to the given gadget dtext
--  buildTable(GADGET)               -                   Create a table using the list of Team data and stored column formats
--
------------------------------------------------------------------------

define object ADMTEXTLIST

  -- Array of headings so can be available to calling methods
  member           .heading       is ARRAY

  -- Array of column data  NOTE: variable name must be short to avoid compose string too long
  member           .cd            is ARRAY

  -- array of column formats
  -- This is an array of COMPOSE command format statements to control layout
  member           .colFmt        is ARRAY

  -- This is an array of gaps between columns used by the COMPOSE command to control layout
  member           .colSpace      is ARRAY

  -- the table ready for allocation to a form DTEXT
  member           .table         is ARRAY

  -- list of string references for allocation to a form RTEXT
  member           .stringRefs    is ARRAY

endobject
-- End of object definition for ADMTEXTLIST

------------------------------------------------------------------------
--
-- Method:      .addTeams(ARRAY, TEAMLISTATTR, BOOLEAN, GADGET)
--
-- Description: Create a list of Team data and store column formats
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Array of DBREF objects for team elements
--    2   R      TEAMLISTATTR Team list format object
--    3   R      BOOLEAN      Use line header '<TEAM>'
--    4   RW     GADGET       Gadget for receive DTEXT & RTEXT
--
------------------------------------------------------------------------
define method .addTeams(!dbRefArray is ARRAY, !listFormat is TEAMLISTATTR, !useHeader is BOOLEAN, !list is GADGET )

  -- Clear the list gadget
  !list.clear()
  !this.colSpace = ARRAY()
  !this.colFmt = ARRAY()

  -- Check that array has values
  if (!dbRefArray.unset()) then
    return
  endif

  if (!useHeader) then
    !displayText  = |<TEAM>  |
  else
    !displayText  = ||
  endif

  !block        = object BLOCK( '!dbRefArray[!evalIndex].string()' )
  !stringRefs   = !dbRefArray.evaluate(!block)
  -- old EVAL syntax used for performance
  if (!listFormat.name) then
    VAR !temp EVAL ( replace(NAME,'/*',!displayText,1,1) ) FOR ALL FROM !stringRefs
   !this.cd[1]   = !temp
   !this.colFmt[1]  = ''
  endif
  if (!listFormat.description) then
    VAR !temp EVAL DESC FOR ALL FROM !stringRefs
    !this.cd[2] = !temp
    !this.colFmt[2]  = ''
  endif
-------------------------------------------------------------------------------------------------------
     !validHeadings = !!admDisplayConfig.teamFormat.order
     do !i indices !validHeadings
       if(!!admDisplayConfig.teamFormat.attribute(!validHeadings[!i].upcase())) then
         !heading[!i] = !!admDisplayConfig.teamFormat.order[!i]
      endif
     enddo
   !heading.compress()
   !list.setHeadings(!heading)
-------------------------------------------------------------------------------------------------------
  !this.buildTable(!list)
  --!list.setColumns(!this.cd)
  --!list.dText = !this.table
  !list.rText = !stringRefs

endmethod
-- End of method definition for .addTeams(ARRAY, TEAMLISTATTR, BOOLEAN, GADGET)

------------------------------------------------------------------------
--
-- Method:      .addUsers(ARRAY, USERLISTATTR, BOOLEAN, GADGET)
--
-- Description: Create a list of Team data and store column formats
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Array of DBREF objects for team elements
--    2   R      USERLISTATTR Team list format object
--    3   R      BOOLEAN      Use line header '<TEAM>'
--    4   RW     GADGET       Gadget for receive DTEXT & RTEXT
--
------------------------------------------------------------------------

define method .addUsers(!dbRefArray is ARRAY, !listFormat is USERLISTATTR, !useHeader is BOOLEAN, !list is GADGET )

  -- Clear the list gadget
  !list.clear()
  !this.colFmt = ARRAY()
  !this.colSpace = ARRAY()

  -- Check that array has values
  if (!dbRefArray.unset()) then
    return
  endif

  if (!useHeader) then
    !displayText  = |<USER>  |
  else
    !displayText  = ||
  endif

  -- Discover whether this is a list of ADMVIRTUSER or DBREF objects
  !objectType = !dbRefArray[1].objectType()
  -- get a list of string reference numbers from either DB or DBREF objects
  if(!objectType EQ |DBREF|)then
    !block = object BLOCK( '!dbRefArray[!evalIndex].string()' )
  elseif(!objectType EQ |ADMVIRTUSER|)then
    !block = object BLOCK( '!dbRefArray[!evalIndex].name.dbref().string()' )
  else
    return
  endif
  !stringRefs   = !dbRefArray.evaluate(!block)

  -- old EVAL syntax used for performance
  -- get names
  VAR !names EVAL ( replace(NAME,'/',!displayText,1,1) ) FOR ALL FROM !stringRefs
  if(!listFormat.name) then
    !this.cd[1]     = !names
    !this.colFmt[1] = ''
  endif
  if (!listFormat.password) then
    VAR !temp EVAL (PASSQUALITY ne 0) FOR ALL FROM !stringRefs
    !block          = object BLOCK( '!temp[!evalIndex]' )
    !names          = !temp.evaluate(!block)
    !this.colFmt[2] = ''
    !this.cd[2]     = !names
  endif
  if (!listFormat.security) then
    VAR !temp EVAL SECURITY FOR ALL FROM !stringRefs
    !block          = object BLOCK( '|[| + !temp[!evalIndex] + |]|' )
    !this.cd[3] = !temp.evaluate(!block)
    !this.colFmt[3] = ''
  endif
  if (!listFormat.description) then
    VAR !temp EVAL DESCRIPTION FOR ALL FROM !stringRefs
    !this.cd[4] = !temp
    !this.colFmt[4]  = ''
  endif
------------------------------------------------------------------------------------------------
    !validHeadings = !!admDisplayConfig.userFormat.order
    do !i indices !validHeadings
      if(!!admDisplayConfig.userFormat.attribute(!validHeadings[!i].upcase())) then
        !heading[!i] = !!admDisplayConfig.userFormat.order[!i]
        if (!heading[!i] eq 'Password') then
          !heading[!i] = 'Password?'
        endif
      endif
     enddo
  !heading.compress()
  !list.setHeadings(!heading)
------------------------------------------------------------------------------------------------
  !this.buildTable(!list)

  --!list.dText = !this.table
  !list.rText = !stringRefs

endmethod
-- End of method definition for .addUsers(ARRAY, USERLISTATTR, BOOLEAN, GADGET)

------------------------------------------------------------------------
--
-- Method:      .addMdbs(ARRAY, MDBLISTATTR, BOOLEAN, GADGET)
--
-- Description: Create a list of Team data and store column formats
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Array of DBREF objects for team elements
--    2   R      MDBLISTATTR  Team list format object
--    3   R      BOOLEAN      Use line header '<TEAM>'
--    4   RW     GADGET       Gadget for receive DTEXT & RTEXT
--
------------------------------------------------------------------------

define method .addMdbs(!dbRefArray is ARRAY, !listFormat is MDBLISTATTR, !useHeader is BOOLEAN, !list is GADGET )

  -- Clear the list gadget
  !list.clear()
  !this.colFmt = ARRAY()
  !this.colSpace = ARRAY()

  -- Check that array has values
  if (!dbRefArray.unset()) then
    return
  endif

  if (!useHeader) then
    !displayText  = |<MDB>  |
  else
    !displayText  = ||
  endif

  !block        = object BLOCK( '!dbRefArray[!evalIndex].string()' )
  !stringRefs   = !dbRefArray.evaluate(!block)

  -- old EVAL syntax used for performance
  -- get names
  VAR !temp EVAL ( replace(NAME,'/',!displayText,1,1) ) FOR ALL FROM !stringRefs
  if (!listFormat.name) then
    !this.colFmt[1]  = ''
    !this.cd[1]   = !temp
  endif
  if (!listFormat.description) then
    VAR !temp EVAL DESCRIPTION FOR ALL FROM !stringRefs
    !this.cd[2] = !temp
    !this.colFmt[2]  = ''
  endif
-------------------------------------------------------------------------------------------------------
     !validHeadings = !!admDisplayConfig.teamFormat.order
     do !i indices !validHeadings
       if(!!admDisplayConfig.mdbFormat.attribute(!validHeadings[!i].upcase())) then
         !heading[!i] = !!admDisplayConfig.teamFormat.order[!i]
      endif
     enddo
   !heading.compress()
   !list.setHeadings(!heading)
-------------------------------------------------------------------------------------------------------
  !this.buildTable(!list)

  --!list.dText = !this.table
  !list.rText = !stringRefs

endmethod
-- End of method definition for .addMdbs(ARRAY, MDBLISTATTR, BOOLEAN, GADGET)

------------------------------------------------------------------------
--
-- Method:      .addDbSets(ARRAY, DBSETLISTATTR, BOOLEAN, GADGET)
--
-- Description: Create a list of Team data and store column formats
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Array of DBREF objects for team elements
--    2   R      DBSETLISTATTR  Team list format object
--    3   R      BOOLEAN      Use line header '<TEAM>'
--    4   RW     GADGET       Gadget for receive DTEXT & RTEXT
--
------------------------------------------------------------------------

define method .addDbSets(!dbRefArray is ARRAY, !listFormat is DBSETLISTATTR, !useHeader is BOOLEAN, !list is GADGET )

  -- Clear the list gadget
  !list.clear()
  !this.colFmt = ARRAY()
  !this.colSpace = ARRAY()

  -- Check that array has values
  if (!dbRefArray.unset()) then
    return
  endif

  if (!useHeader) then
    !displayText  = |<DBSET>  |
  else
    !displayText  = ||
  endif

  !block        = object BLOCK( '!dbRefArray[!evalIndex].string()' )
  !stringRefs   = !dbRefArray.evaluate(!block)

  -- old EVAL syntax used for performance
  -- get names
  VAR !temp EVAL ( replace(NAME,'/',!displayText,1,1) ) FOR ALL FROM !stringRefs

  if (!listFormat.name) then
    !this.colFmt[1]  = ''
    !this.cd[1]   = !temp
  endif
  if (!listFormat.description) then
    VAR !temp EVAL DESCRIPTION FOR ALL FROM !stringRefs
    !this.cd[2] = !temp
    !this.colFmt[2]  = ''
  endif
-------------------------------------------------------------------------------------------------------
      -- same order  and heading as team
     !validHeadings = !!admDisplayConfig.teamFormat.order
     do !i indices !validHeadings
       if(!!admDisplayConfig.dbSetFormat.attribute(!validHeadings[!i].upcase())) then
         !heading[!i] = !!admDisplayConfig.teamFormat.order[!i]
      endif
     enddo
   !heading.compress()
   !list.setHeadings(!heading)
-------------------------------------------------------------------------------------------------------
  !this.buildTable(!list)

  --!list.dText = !this.table
  !list.rText = !stringRefs

endmethod
-- End of method definition for .addDbSets(ARRAY, DBSETLISTATTR, BOOLEAN, GADGET)

------------------------------------------------------------------------
--
-- Method:      .addDbs(ARRAY, TEAMLISTATTR, BOOLEAN, GADGET, DBREF)
--
-- Description: Create a list of Team data and store column formats
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Array of DBREF objects for team elements
--    2   R      TEAMLISTATTR Team list format object
--    3   R      BOOLEAN      Use line header '<TEAM>'
--    4   RW     GADGET       Gadget for receive DTEXT & RTEXT
--    5   R      DBREF        Primary location for reference
--
------------------------------------------------------------------------

define method .addDbs(!dbRefArray is ARRAY, !listFormat is DBLISTATTR, !useHeader is BOOLEAN, !list is GADGET, !wrtLoc is DBREF)

  -- Thin layer defaults to building list
  !this.addDbs(!dbRefArray, !listFormat, !useHeader, !list, !wrtLoc, TRUE)

endmethod
-- End of method definition for .addDbs(ARRAY, DBLISTATTR, BOOLEAN, GADGET, DBREF)

------------------------------------------------------------------------
--
-- Method:      .addDbs(ARRAY, TEAMLISTATTR, BOOLEAN, GADGET, DBREF, BOOLEAN)
--
-- Description: Create a list of Team data and store column formats
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Array of DBREF objects for team elements
--    2   R      TEAMLISTATTR Team list format object
--    3   R      BOOLEAN      Use line header '<TEAM>'
--    4   RW     GADGET       Gadget for receive DTEXT & RTEXT
--    5   R      DBREF        Primary location for reference
--    6   R      BOOLEAN      Build list if true (otherwise just want data in member array)
--
------------------------------------------------------------------------

define method .addDbs(!dbRefArray is ARRAY, !listFormat is DBLISTATTR, !useHeader is BOOLEAN, !list is GADGET, !wrtLoc is DBREF, !buildList is BOOLEAN)

  -- Clear the list gadget
  !list.clear()
  !this.colSpace = ARRAY()

  -- Check that array has values
  if (!dbRefArray.unset()) then
    return
  endif

  -- Initialise variables
  !globalProj  = !!glbIsGlobal()
  !objectType  = STRING()
  !prev = !!ce

  -- set up array of formats for each column of the table  (undefined means not output)
  !this.colFmt = ARRAY()
--  !this.colFmt[1] = 'R'
  !this.colFmt[1] = ''
  !this.colSpace[1] = 1
  if (!listFormat.name) then
--    !this.colFmt[2] = ''
    !this.colFmt[3] = ''
  endif
  if (!listFormat.access) then
    !this.colFmt[7] = ''
  endif
  if (!listFormat.claim) then
    !this.colFmt[8] = ''
  endif

  -- Get the primary databases if the project is global
  if (!globalProj) then
    if (!wrtLoc.unset()) then
      !wrtLoc      = !!adminApplic.getAdmContext()
      handle any
        !wrtLoc = object DBREF()
      endhandle
    endif
  endif

  -- Discover whether this is a list of DB or DBREF objects
  !objectType = !dbRefArray[1].objectType()
  !stringRefs = ARRAY()
  -- get a list of string reference numbers from either DB or DBREF objects
  if(!objectType EQ |DBREF|)then
--    !block = object BLOCK( '!dbRefArray[!evalIndex].string()' )
    do !db values !dbRefArray
      skip if badref(!db)
      !stringRefs.append(!db.string())
    enddo
  elseif(!objectType EQ |DB|)then
--    !block = object BLOCK( '!dbRefArray[!evalIndex].refno' )
    do !db values !dbRefArray
      !unused = !db.refno.dbref()
      handle any
        skip
      endhandle
      !stringRefs.append(!db.refno)
    enddo
  else
    return
  endif
--  !stringRefs   = !dbRefArray.evaluate(!block)

  if (!useHeader) then
    !displayText  = |<DB>|
  else
    !displayText  = ||
  endif

  -- old EVAL syntax used for performance --

  -- get name without leading /*
  VAR !names EVAL ( substring(NAME,3) ) FOR ALL FROM !stringRefs
  VAR !nameType EVAL ( substring(TYPE,1) ) FOR ALL FROM !stringRefs
  !nameTypes = !nameType[1]

  -- get typedb
  if (!listFormat.typedb) then
    VAR !temp EVAL ( TYPEDB ) FOR ALL FROM !stringRefs
    !this.cd[4]  = !temp
    !this.colFmt[4]   = ''
  endif
  -- get database number
  if (!listFormat.dbno) then
    VAR !temp EVAL ( DBNO ) FOR ALL FROM !stringRefs
    !this.cd[5]  = !temp
    !this.colFmt[5]   = 'R'
  endif
  -- get database Location
  if (!nameTypes eq 'DBSET') then
    VAR !temp EVAL ( TYPE ) FOR ALL FROM !stringRefs
  elseif (!globalProj)then
     if (!listFormat.isprim) then
        VAR !temp EVAL ( prmlocation ) FOR ALL FROM !stringRefs
        !this.cd[6]  = !temp
        !this.colFmt[6]   = 'R'
     endif
  endif
  -- get access type
  if (!listFormat.access) then
     VAR !temp EVAL ( ACCESS ) FOR ALL FROM !stringRefs
     !this.cd[7]    = !temp
  endif
-- get database filename
  if (!listFormat.fileName) then
    VAR !temp EVAL ( FILENAME ) FOR ALL FROM !stringRefs
    !this.cd[9]  = !temp
    !this.colFmt[9]   = ''
  endif
  -- get description
  if (!listFormat.description) then
    VAR !temp EVAL ( DESCRIPTION ) FOR ALL FROM !stringRefs
    !this.cd[10] = !temp
    !this.colFmt[10]  = ''
  endif
  -- foreign DBs
  VAR !foreign EVAL  ( FOREIGN ) FOR ALL FROM !stringRefs

  -- Session
  !sessFlg = FALSE
  if (!listFormat.session) then
    !sessions = ARRAY()
    do !stampedDb val !!admStamp.formMethods.stampedDbs
      !sessions.append(!stampedDb.sessNo.string())
    enddo
    !this.cd[11] = !sessions
    !sessFlg = TRUE
    !this.colFmt[11]  = ''
  endif

  -- now loop through elements to set other data
  do !i indices !stringRefs
    !working = FALSE

    !dbRefNo = !stringRefs[!i].dbref()

    -- look for working extracts
    if(!dbRefNo.owner.owner.type eq 'USER' ) then
      !working = TRUE
      !this.cd[3][!i] = !dbRefNo.owner.owner.name.substring(2)
    else
      !this.cd[3][!i] = ''
    endif

    -- Get type of DB as a symbol wrt this location (foreign/primary/secondary/....)
    if (!foreign[!i] eq 'FOREIGN') then
      -- Foreign database
      !symbol1 = |*|
    elseif( !working eq TRUE ) then
      !symbol1 = |W|
    else
      !symbol1 = | |
    endif

    !symbol2 = | |
    !symbol3 = | |
    !symbol4 = | |
    !currentRef = !dbRefNo
    !!ce = !dbRefNo
    if (!globalProj) then
      if (!working neq TRUE ) then
        -- All databases other than Working extracts
        if ( !foreign[!i] neq 'FOREIGN') then
          -- Navigate to DBLOC member of DBs
          1
          handle any
            -- Unexpected error - already handled Working extracts
            !!alert.error(!!error.text)
          endhandle
          !currentRef = !!ce
          handle ANY
              !symbol1   = | |
          elsehandle NONE
              -- Primary(+) or secondary(-) flag
              !locRef    = !currentRef.locrf
              if(!locRef.unset() AND !currentRef.prvrf.unset())then
                !symbol1 = |?|
              elseif(!locRef EQ  !wrtLoc)then
                !symbol1 = |+|
              elseif(!locRef NEQ !wrtLoc)then
                !symbol1 = |-|
              endif
          endhandle
        endif
        -- Go Back UP!
        OWN
        handle (47,62)
          -- Occasional problem with this syntax
          GOTO OWNER
        endhandle
        !currentRef = !!ce
      endif
    endif

    -- Setup Variant and Extract Flags
    !lvar = !currentRef.lvar
    handle (2,805)
      -- do nothing
    elsehandle (2,201)
      -- do nothing
    elsehandle none
      if(!lvar)then
        !symbol2 = |V|
      else
        !symbol2 = | |
      endif
      -- if lvar exists then Extracts must exist
      !extown    = !currentRef.extown
      handle (2,805)
        -- do nothing
      elsehandle none
        if(!extown.set() and !working neq true )then
          !symbol3 = |X|
        else
          !symbol3 = | |
        endif
      endhandle
    endhandle
    -- P-17003 No need to report Sub-type (STYPDB) - no longer used
    --         This could be left in as configurable - but this is unnecessary complexity
    !symbol4 = | |

    -- add list numbering if required
    !symbols = !displayText + !symbol1 + !symbol2 + !symbol3 + !symbol4
    if (!listFormat.name) then
      !nameString = !names[!i]
      if (!listFormat.sequence) then
        !sequence = '   ' + !i.string()
        !this.cd[1][!i] = !sequence.substring(-3,3) + | | + !symbols + | | + !nameString
      else
        !this.cd[1][!i] = !symbols + | | + !nameString
      endif
    else
      !nameString = ''
    endif

    -- claim
    if(!listFormat.claim) then
       !claimType = !dbRefNo.claimDb
       if( !claimType.set() ) then
         !this.cd[8][!i] = !claimType
       else
         !this.cd[8][!i] = 'N/A'
       endif
    endif
  enddo
  -- build table to go on the form
-------------------------------------------------------------------------------------------------------
  if (!globalProj)then
  if(!working.not()) then
     !validHeadings = !!admDisplayConfig.dbFormat.order
     do !i indices !validHeadings
       if(!!admDisplayConfig.dbFormat.attribute(!validHeadings[!i].upcase())) then
       -- change the header to English
        if(!!admDisplayConfig.dbFormat.order[!i].eq('TypeDb')) then
          !heading[!i] = 'Type'
        elseif(!!admDisplayConfig.dbFormat.order[!i].eq('DbNo')) then
          !heading[!i] = 'DB Number'
          elseif(!!admDisplayConfig.dbFormat.order[!i].eq('isprim')) then
           !heading[!i] = 'Location'
        else
          !heading[!i] = !!admDisplayConfig.dbFormat.order[!i]
        endif
      endif
     enddo
   !heading.compress()
   if(!sessFlg) then
     !heading.append('Session')
   endif
 else
 !validHeadings = !!admDisplayConfig.dbFormat.order
  do !i indices !validHeadings
    if(!!admDisplayConfig.dbFormat.attribute(!validHeadings[!i].upcase())) then
     -- change the header to English
      if(!!admDisplayConfig.dbFormat.order[!i].eq('TypeDb')) then
         !heading[!i] = 'Type'
      elseif(!!admDisplayConfig.dbFormat.order[!i].eq('DbNo')) then
         !heading[!i] = 'DB Number'
      elseif(!!admDisplayConfig.dbFormat.order[!i].eq('isprim')) then
        !heading[!i] = 'Location'
      else
         !heading[!i] = !!admDisplayConfig.dbFormat.order[!i]
      endif
   endif
  enddo
  !heading.compress()
    -- add an extra header in for Working extracts
    if(!!admDisplayConfig.dbFormat.name) then
       !heading.insert(2,'For User')
    else
    -- if the name is unchecked insert anyway
       !heading.insert(1,'For User')
    endif
  endif
 else
  if(!working.not()) then
    !validHeadings = !!admDisplayConfig.dbFormat.order
    do !i indices !validHeadings
      if(!!admDisplayConfig.dbFormat.attribute(!validHeadings[!i].upcase())) then
      -- change the header to English
        if(!!admDisplayConfig.dbFormat.order[!i].eq('TypeDb')) then
          !heading[!i] = 'Type'
        elseif(!!admDisplayConfig.dbFormat.order[!i].eq('DbNo')) then
          !heading[!i] = 'DB Number'
        else
          !heading[!i] = !!admDisplayConfig.dbFormat.order[!i]
        endif
      endif
     enddo
    !heading.compress()
    if(!sessFlg) then
      !heading.append('Session')
    endif
  else
 !validHeadings = !!admDisplayConfig.dbFormat.order
  do !i indices !validHeadings
    if(!!admDisplayConfig.dbFormat.attribute(!validHeadings[!i].upcase())) then
     -- change the header to English
      if(!!admDisplayConfig.dbFormat.order[!i].eq('TypeDb')) then
         !heading[!i] = 'Type'
      elseif(!!admDisplayConfig.dbFormat.order[!i].eq('DbNo')) then
         !heading[!i] = 'DB Number'
      else
         !heading[!i] = !!admDisplayConfig.dbFormat.order[!i]
      endif
    endif
  enddo
  !heading.compress()
  -- add an extra header in for Working extracts
    if(!!admDisplayConfig.dbFormat.name) then
      !heading.insert(2,'For User')
    else
    -- if name is unchecked insert anyway
      !heading.insert(1,'For User')
    endif
  endif
 endif
 -- Build list if required
 if (!buildList) then
   !list.setHeadings(!heading)
   !this.buildTable(!list)
   -- allocate table and references to the form
   --!list.dText = !this.table
   !list.rText = !stringRefs
 else
   !this.heading = !heading
   !this.cd.compress()
   -- Allow for db list to apply to Dice form or to db forms
   if (!this.cd.size() gt !this.heading.size()) then
     !this.cd.remove(2)
   endif
   !this.stringRefs = !stringRefs
 endif
  -- Return Current element back to !prev
  !!ce =!prev
  handle ANY
  endhandle

endmethod
-- End of method definition for .addDbs(ARRAY, DBLISTATTR, BOOLEAN, GADGET, DBREF, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .addScopes(ARRAY, BOOLEAN, GADGET)
--
-- Description: Create a list of Team data and store column formats
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Array of DBREF objects for  team elements
--    2   R      BOOLEAN      Use line header '<TEAM>'
--    3   RW     GADGET       Gadget for receive DTEXT & RTEXT
--
------------------------------------------------------------------------

define method .addScopes(!dbRefArray is ARRAY, !useHeader is BOOLEAN, !list is GADGET )

  -- Clear the list gadget
  !list.clear()
  !this.colFmt = ARRAY()
  !this.colSpace = ARRAY()

  -- Check that array has values
  if (!dbRefArray.unset()) then
    return
  endif

  if (!useHeader) then
    !displayText  = |<SCOPE>  |
  else
    !displayText  = ||
  endif

  !block        = object BLOCK( '!dbRefArray[!evalIndex].string()' )
  !stringRefs   = !dbRefArray.evaluate(!block)

  -- old EVAL syntax used for performance
  -- get names
  VAR !temp EVAL ( replace(NAME,'/',!displayText,1,1) ) FOR ALL FROM !stringRefs
  !this.cd[1]   = !temp
  !this.colFmt[1]  = ''
  -- description
  VAR !temp EVAL DESCRIPTION FOR ALL FROM !stringRefs
  !this.cd[2] = !temp
  !this.colFmt[2]  = ''
-----------------------------------------------------------------------------------------------------
  !heading = !!admDisplayConfig.teamFormat.order
  !list.setHeadings(!heading)
-----------------------------------------------------------------------------------------------------
  !this.buildTable(!list)

  --!list.dText = !this.table
  !list.rText = !stringRefs

endmethod
-- End of method definition for .addScopes(ARRAY, BOOLEAN, GADGET)

