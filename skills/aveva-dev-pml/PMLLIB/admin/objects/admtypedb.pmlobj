-- Description:
-- Object definition to store database types used in PDMS
--
------------------------------------------------------------------------

-- Define object
define object ADMTYPEDB

  -- Type of databases (4 characters)
  member .type   is STRING
  -- Description of database
  member .description is STRING
  -- Order of update (Global only)
  member .order  is REAL

endobject
-- End of object definition for ADMTYPEDB
