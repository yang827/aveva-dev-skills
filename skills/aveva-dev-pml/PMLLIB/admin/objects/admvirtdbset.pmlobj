--   Group:         General Application

--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Tue Feb 23 9:44:48 GMT 1999
--
--
-- Description:
-- A object to store virtually (ie:- without a db open) an dbset.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  goReal()                         -                   Converts a virtual ADMVIRTDBSET into a real dbset
--  goReal(STRING)                   -                   Converts a virtual ADMVIRTDBSET into a real dbset
--  goVirtual(DBREF)                 -                   Converts a dbset into an ADMVIRTDBSET
--
define object ADMVIRTDBSET
  member .name is STRING
  member .description is STRING
  member .names is ARRAY
  member .types is ARRAY
  member .dbRef is DBREF
  member .location is STRING
endobject
-- End of object definition for ADMVIRTDBSET
------------------------------------------------------------------------
--
-- Method:  .goVirtual()
--
-- Description: Converts a dbset into an ADMVIRTDBSET
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      DBREF        The element to be converted
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goVirtual(!dbRef is DBREF)
  !this.name = !dbRef.name
  !this.description = !dbRef.description
  !arrayOfMem = !dbRef.dbsLev
  !tempNames = ARRAY()
  !tempTypes = ARRAY()
  do !i values !arrayOfMem
      !tempNames.append(!i.name)
      !tempTypes.append(!i.type)
  enddo
  !this.names = !tempNames.invert()
  !this.types = !tempTypes.invert()
  !this.dbRef = !dbRef
  if(!!glbIsGlobal())then
    !this.location = !!adminApplic.getAdmContext().name
  else
    !this.location = ''
  endif
endmethod
-- End of method definition for .goVirtual(DBREF)
------------------------------------------------------------------------
--
-- Method:  .goReal()
--
-- Description: Converts a virtual ADMVIRTDBSET into a real dbset
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goReal()
  if(!!glbIsGlobal())then
    --get the current open sys db location name
    if(!this.location EQ !!dbrAdminGetWorld(|STAT|).locRf.name)then
      --##
      !!alert.error(|You can not re-create the same DBSET in the same location|)
      return
    endif
    !dbSetName = !this.name
    -- create a DBSET with the same name as the stored DBSET (probably at another location)
    !this.goReal( !dbSetName )
  endif
endmethod
-- End of method definition for .goReal()

------------------------------------------------------------------------
--
-- Method:  .goReal()
--
-- Description: Converts a virtual ADMVIRTDBSET into a real dbset
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      Name of new DBSET
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goReal(!dbSetName is STRING)

  !prev = !!ce
  !!ce = !!dbrAdminGetWorld(|DBSET|)

  -- create new DBSET with given name
  call !!admCommand(|NEW dbset $!dbSetName|)

  handle any
    !errorString = |dbset already exists|
    !!ce = !prev
    return error 1 '$!errorString'
  endhandle
    -- Set the attributes *** OLD PML SYNTAX ***
  !!ce.description = !this.description
  call !!admCommand(|SET DBSET $!dbSetName|)
  do !i indices !this.types
    if(!this.types[!i] EQ |DBSET|)then
      call !!admCommand(|DADD DBSET $!this.names[!i]|)
      handle (1,319)
        -- ##
        !errorString = |The | + !this.types[!i] + | | + !this.names[!i] + | is missing at | + !!dbrAdminGetWorld(|STAT|).locRf.name
        call !!admCommand(|DELETE DBSET|)
        !!ce = !prev
        return error 1 '$!errorString'
      elsehandle any
        !errorString = !!error.text
        call !!admCommand(|DELETE DBSET|)
        !!ce = !prev
        return error 1 '$!errorString'
      endhandle
    elseif(!this.types[!i] EQ |DB|)then
      !tempName = !this.names[!i].substring(3)
      call !!admCommand(|DADD DB $!tempName|)
      handle (39,4)
        -- ##
        !errorString = |The | + !this.types[!i] + | | + !this.names[!i] + | is missing at | + !!dbrAdminGetWorld(|STAT|).locRf.name
        call !!admCommand(|DELETE DBSET|)
        !!ce = !prev
        return error 1 '$!errorString'
      elsehandle any
        !errorString = !!error.text
        call !!admCommand(|DELETE DBSET|)
        !!ce = !prev
        return error 1 '$!errorString'
      endhandle
    endif
  enddo
  !!ce = !prev

endmethod
-- End of method definition for .goReal()
