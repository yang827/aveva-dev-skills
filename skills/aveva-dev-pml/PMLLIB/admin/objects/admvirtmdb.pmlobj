-- File:            admvirtmdb.pmlobj
--   Type:          Object Definition
--   Group:         General Application

--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Tue Feb 23 9:44:48 GMT 1999
--
--
-- Description:
-- An object to store virtually (i.e:- without a db open) an MDB
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  goReal()                         -                   Converts a virtual ADMVIRTMDB into a real MDB
--  goVirtual(DBREF)                 -                   Converts a MDB into an ADMVIRTMDB
--
define object ADMVIRTMDB
  member .name is STRING
  member .description is STRING
  member .curDbs is ARRAY
  member .defDbs is ARRAY
  member .dbRef is DBREF
  member .location is STRING
endobject
-- End of object definition for ADMVIRTMDB
------------------------------------------------------------------------
--
-- Method:  .goVirtual()
--
-- Description: Converts a MDB into an ADMVIRTMDB
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      DBREF        The element to be converted
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goVirtual(!dbRef is DBREF)
  !this.name = !dbRef.name
  !this.description = !dbRef.description
  !arrayOfCurDbs = !dbRef.curDbs
  !temp = ARRAY()
  do !i values !arrayOfCurDbs
    !temp.append(!i.name.substring(3))
  enddo
  !this.curDbs = !temp.invert()
  !arrayOfAllDbs = !dbRef.mem
  !temp2 = ARRAY()
  do !j values !arrayOfAllDbs
    !temp2.append(!j.name.substring(3))
  enddo
  !this.defDbs = !temp2.difference(!this.curDbs).invert()
  !this.dbRef = !dbRef
  !this.location = !!adminApplic.getAdmContext().name
endmethod
-- End of method definition for .goVirtual(DBREF)
------------------------------------------------------------------------
--
-- Method:  .goReal()
--
-- Description: Converts a virtual ADMVIRTMDB into a real MDB
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goReal()
  --get the current open sys db location name
  !admLocRef = !!ce.admLoc

  if(!this.location EQ !admLocRef.name)then
    -- ##
    !!alert.error(|You can not re-create the same MDB in the same location|)
    return
  endif
  !!ce = !!dbrAdminGetWorld(|MDB|)

  -- Validate the Location and warn about database allocation

  -- Get all dbs at this location
  !dbsAtLoc = !admLocRef.dbAll

  !txtDbNames = ARRAY()
  do !h values !dbsAtLoc
    !txtDbNames.append(!h.name.substring(3) )
  enddo
  -- gives elements in curDbs not in the list of all dbs a this loc
  !curDbsNotThere =  !this.curDbs.difference(!txtDbNames)
  -- gives elements in defDbs not in the list of all dbs a this loc
  !defDbsNotThere =  !this.defDbs.difference(!txtDbNames)
  -- creates an array of a dbs missing from here
  !curDbsNotThere.appendArray(!defDbsNotThere)
  if(!curDbsNotThere.size() GT 0)then
  	-- Missing DBs do not prevent the database allocation from succeeding
    !textString = | - |
    !separator  = | |
    do !j values !curDbsNotThere
      !textString = !textString + !separator + !j
      !separator = |, |
    enddo
    !errorString = |Warning - The MDB contains | + !curDbsNotThere.size().string()
    !errorString2 = | databases which are not allocated at | + !admLocRef.name
    !!alert.warning(!errorString + !errorString2 + !textString)
    -- ##
    -- return error 1 '$!errorString'
  endif
  !mdbName = !this.name
  call !!admCommand(|NEW MDB $!mdbName|)
   handle any
     !errorString = !!error.text
     -- MDB already exists
     call !!admCommand(|DELETE MDB|)
     -- Revert to original database before abandon processing...
     call !!admCommand('ADMINISTER SYSTEM LOCAL')
     return error 1 '$!errorString'
   endhandle
     -- Set the attributes *** OLD PML SYNTAX ***
   !!ce.description = !this.description
   call !!admCommand(|SET MDB $!this.name|)
   do !i values !this.curDbs
     call !!admCommand(|ADD $!i|)
     call !!admCommand(|CURRENT $!i 1|)
   enddo
   do !k values !this.defDbs
     call !!admCommand(|ADD $!k|)
   enddo

endmethod
-- End of method definition for .goReal()
