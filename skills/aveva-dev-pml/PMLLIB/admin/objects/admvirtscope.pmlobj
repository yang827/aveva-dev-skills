--   Group:         General Application

--     Keyword:     GEN
--   Module:        admin
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Thu Feb 18 13:04:18 GMT 1999
--
--
-- Description:
-- A object to store a scope whilst sysdb is being changed
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  goReal()                         -                   Converts a virtual ADMVIRTSCOPE into a real SCOPE
--  goVirtual(DBREF)                 -                   Converts a SCOPE into an ADMVIRTSCOPE
--
define object ADMVIRTSCOPE
  member .name is STRING
  member .description is STRING
  member .scoSel is STRING
  member .dbRef is DBREF
  member .location is STRING
endobject
-- End of object definition for ADMVIRTSCOPE
------------------------------------------------------------------------
--
-- Method:  .goVirtual()
--
-- Description: Converts a SCOPE into an ADMVIRTSCOPE
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goVirtual(!dbRef is DBREF)
  !prev = !!ce
  !!ce = !dbRef
  !this.name = !dbRef.name
  !this.description = !dbRef.description
  VAR !x SCOSEL
  !this.scoSel = !x
  !this.dbRef = !dbRef
  !this.location = !!adminApplic.getAdmContext().name
  !!ce = !prev
endmethod
-- End of method definition for .goVirtual(DBREF)
------------------------------------------------------------------------
--
-- Method:  .goReal()
--
-- Description: Converts a virtual ADMVIRTSCOPE into a real SCOPE
--
-- Method Type: Function/ Procedure
-- arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goReal()
  --get the current open sys db location name
  if(!this.location EQ !!dbrAdminGetWorld(|STAT|).locRf.name)then
    -- ##
    !!alert.error(|You can not re-create the same SCOPE in the same location|)
    return
  endif
  !prev = !!ce
  !!ce = /*SC
  !scopeName = !this.name
  call !!admCommand(|NEW SCOPE $!scopeName|)
   handle any
     -- SCOPE already exists
     call !!admCommand(|DELETE SCOPE|)
     -- ##
     !errorString = |Scope already exists|
     return ERROR 1 '$!errorString'
   endhandle
     -- Set the attributes *** OLD PML SYNTAX ***
   call !!admCommand(|DESC '$!this.description'|)
   call !!admCommand(|SCOSEL $!this.scoSel|)
--   !!ce = !prev
 --  !!ce
endmethod
-- End of method definition for .goReal()
