--
--
-- Description:
-- Function to define which attributes of a database element are displayed
-- in a list gadget text.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dbListAttr()                     -                   constructor
--

-- Define object
define object DBLISTATTR

  -- One member Boolean member defined for each attribute
  -- True  = Displayed
  -- False = Omitted
  member .description is BOOLEAN
  member .name        is BOOLEAN
  member .typeDb      is BOOLEAN
  member .dbNo        is BOOLEAN
  member .isprim      is BOOLEAN
  member .access      is BOOLEAN
  member .claim       is BOOLEAN
  member .filename    is BOOLEAN
  member .sequence    is BOOLEAN
  member .session     is BOOLEAN
  member .order       is ARRAY

endobject
-- End of object definition for DBLISTATTR

------------------------------------------------------------------------
--
--Method: .dbListAttr()
--
-- Description: constructor
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .dbListAttr()

  if(!!admcontrol.isglobal())then
    !this.name        = true
    !this.typeDb      = false
    !this.dbNo        = false
    !this.isprim      = false
    !this.description = false
    !this.access      = false
    !this.claim       = false
    !this.filename    = false
    !this.sequence    = false
    !this.session     = false
    !this.order[1]    = 'Name'
    !this.order[2]    = 'TypeDb'
    !this.order[3]    = 'DbNo'
    !this.order[4]    = 'isprim'
    !this.order[5]    = 'Access'
    !this.order[6]    = 'Claim'
    !this.order[7]    = 'Filename'
    !this.order[8]    = 'Description'
  else
    !this.name        = true
    !this.typeDb      = false
    !this.dbNo        = false
    !this.description = false
    !this.access      = false
    !this.claim       = false
    !this.filename    = false
    !this.sequence    = false
    !this.session     = false
    !this.order[1]    = 'Name'
    !this.order[2]    = 'TypeDb'
    !this.order[3]    = 'DbNo'
    !this.order[4]    = 'Access'
    !this.order[5]    = 'Claim'
    !this.order[6]    = 'Filename'
    !this.order[7]    = 'Description'
  endif

endmethod
-- End of method definition for .dbListAttr()
