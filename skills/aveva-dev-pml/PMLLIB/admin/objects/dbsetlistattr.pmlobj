--
-- Description:
-- Function to define which attributes of a DBSET element are displayed
-- in a list gadget text.
--
------------------------------------------------------------------------

-- Define object
define object DBSETLISTATTR

  -- One member Boolean member defined for each attribute
  -- True  = Displayed
  -- False = Omitted
  member .name        is BOOLEAN
  member .description is BOOLEAN

endobject
-- End of object definition for DBSETLISTATTR
