-- Description:
-- Object to store standard font IR number details.
--
------------------------------------------------------------------------

-- Define object
define object FONTIRNO

  -- IR Number
  member .number      is REAL

  -- Name of font
  member .name        is STRING

  -- Descriptive name of font
  member .description is STRING

endobject
-- End of object definition for FONTIRNO
