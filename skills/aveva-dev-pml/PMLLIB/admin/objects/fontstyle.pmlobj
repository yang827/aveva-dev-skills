-- Description:
-- Object to store standard font style details.
--
------------------------------------------------------------------------

-- Define object
define object FONTSTYLE

  -- Style Number
  member .number      is REAL

  -- Name of Style
  member .name        is STRING

  -- Descriptive name of style
  member .description is STRING

endobject
-- End of object definition for FONTSTYLE
