--
--
-- Description:
-- Object to define which attributes of a STAMP element are displayed
-- in a list gadget text.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  stampListAttr()                  -
--
define object STAMPLISTATTR

  -- One Boolean member defined for each attribute
  -- True  = Displayed
  -- False = Omitted

  member .name         is BOOLEAN
  member .date         is BOOLEAN
  member .function     is BOOLEAN
  member .description  is BOOLEAN
  member .order        is ARRAY

endobject
-- End of object definition for STAMPLISTATTR
------------------------------------------------------------------------
--
--Method: stamplistattr()
--
-- Description: constructor
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .stampListAttr()

  !this.name        = TRUE
  !this.description = FALSE
  !this.date        = FALSE
  !this.function    = FALSE
  !this.description = FALSE
  !this.order[1]    = 'Name'
  !this.order[2]    = 'Date'
  !this.order[3]    = 'Function'
  !this.order[4]    = 'Description'

endmethod
-- End of method definition for .stampListAttr()
