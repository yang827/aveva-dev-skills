--
-- Description:
-- Function to define which attributes of a team element are displayed
-- in a list gadget text.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  teamListAttr()                   -
--

-- Define object
define object TEAMLISTATTR

  -- One member Boolean member defined for each attribute
  -- True  = Displayed
  -- False = Omitted
  member .name        is BOOLEAN
  member .description is BOOLEAN
  member .order       is ARRAY

endobject
-- End of object definition for TEAMLISTATTR
------------------------------------------------------------------------
--
--Method: teamlistattr()
--
-- Description: constructor
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .teamListAttr()

  !this.name        = TRUE
  !this.description = FALSE
  !this.order[1]    = 'Name'
  !this.order[2]    = 'Description'

endmethod
-- End of method definition for .teamListAttr()
