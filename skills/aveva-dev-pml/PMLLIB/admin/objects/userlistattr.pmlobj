--
--
-- Description:
-- Object to define which attributes of a user element are displayed
-- in a list gadget text.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  userListAttr()                   -                   constructor
--

-- Define object
define object USERLISTATTR

  -- One Boolean member defined for each attribute
  -- True  = Displayed
  -- False = Omitted
  member .name         is BOOLEAN
  member .password     is BOOLEAN
  member .security     is BOOLEAN
  member .description  is BOOLEAN
  member .order        is ARRAY

endobject
-- End of object definition for USERLISTATTR
------------------------------------------------------------------------
--
--Method:  userListAttr()
--
-- Description: constructor
--
------------------------------------------------------------------------
--
-- method Type:   method/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .userListAttr()

  !this.name        = true

  !this.description = false

  !this.order[1]    = 'Name'
  !this.order[2]    = 'Password'
  !this.order[3]    = 'Security'
  !this.order[4]    = 'Description'

endmethod
-- End of method definition for .userListAttr()
