-- Group:           ASL
-- Keyword:         Create Settings
-- Module:          ASL
-- Author:          Naresh Kumar K
-- Created:         Mon oct 13 09:00:00 IST 2008
--
--
-- Description:     ASL create settings form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Create Elements
--  aslCreateSettings()              -                   Constructor
--  checkName()                      -                   Valid Check for the Current Element, Referring to stair tower
--  close()                          -                   Close the form
--  setType()                        -                   set the type of setting to create or modify.
--
------------------------------------------------------------------------

setup form !!aslCreateSettings dialog dock size 20 4

  !this.formTitle     = 'Create ASL Settings'
  !this.iconTitle     = 'Create ASL Settings'

  -- Body of form definition
  text   .dbName  'Name'         tagwidth 13  anchor T+L  at xmin           ymin      callback '!this.checkName()'  width 20 is STRING
  option .type    'Setting Type' tagwidth 13  anchor T+L  at xmin           ymax+0.2  callback ''                   width 17.8
  button .ok      'Apply'                     anchor T+L  at xmin.dbName+15 ymax+0.5
  button .cancel  'Dismiss'                   anchor T+L  at xmax+3         ymin

  -- Form Members
  member .action          is STRING
  member .errorState      is BOOLEAN
  member .settingType     is STRING

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslCreateSettings
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslCreateSettings()

  !this.ok.callback       = '!this.apply()'
  !this.cancel.callback   = '!this.close()'
  !this.errorState        = false
  !this.type.add('PROJECT')

endmethod
-- End of method definition for .aslInputSettings()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Create Elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  if ( !this.dbName.val.set().not() ) then
    !!alert.error('Name Field should not be empty!')
    return
  endif

  if ( !this.action.upcase() eq 'CREATE' )then

    -- setting description
    ---------------------------------------------------------------------------
    !newSetting             = object SETTING()
    !newSetting.description = !this.dbName.val.after('/').trim()
    !newSetting.deleteFlag  = false
    !newSetting.purpose     = 'ASL'
    !newSetting.type        = 'PROJ'

    -- updates the standard list
    !!aslSettings.fillStandards()

    -- set the first standard and secondary standard
    !!aslSettings.fillSubStandards()

    !newSetting.settingData = object ARRAY()

    !newSettingData         = object SETTINGDATA()
    !newSettingData.purpose = 'STANDARD'
    !newSettingData.value   = !!aslSettings.opStandards.selection()
    !newSetting.settingData.append(!newSettingData)

    !newSettingData         = object SETTINGDATA()
    !newSettingData.purpose = 'SUBSTANDARD'
    !newSettingData.value   = !!aslSettings.opSubStandards.selection()
    !newSetting.settingData.append(!newSettingData)

    --set the member details
    !!aslSettings.setTemplateElements()

    -- initialise
    !criteriaSetName = object ARRAY()

    -- this is to define the different criteria groups
    !subStandard = object ASLSUBSTANDARD()

    -- handles all criteria sets of a subStandard
    do !criteria value !subStandard.attributes()

      -- delete existing distance
      if ( DEFINED(!criteriaSet) ) then
        !criteriaSet.delete()
      endif

      -- evaluates the criteria set
      !criteriaSet = !subStandard.attribute(!criteria)

      --ignores the basic data types
      skip if ( !criteriaSet.objectType() inset ('ARRAY', 'BOOLEAN', 'DBREF', 'REAL', 'STRING') )

      -- evaluates the description of the criteria set and stores the name
      !suffix = !criteria.after('ASL').before('CRITERIA')
      skip if ( !suffix.eq('STRTWR') )
      !criteriaName = '!!aslSettings.me' & '$!suffix' & 'refes'
      !criteriaSetName.append(!criteriaName.upcase())
    enddo

    do !criteriaData values !criteriaSetName
      !newSubSetting = object SUBSETTING()
      !newSubSetting.purpose = !criteriaData.after('ME').before('REFES')
      do !assemblyItem values $!criteriaData
        !settingData = object SETTINGDATA()
        !settingData.assigned     = True
        !settingData.purpose      = !criteriaData.after('ME').before('REFES')
        if ( !assemblyItem.own.type.eq('LADDER') ) then
          skip
        endif
        !settingData.value        = !assemblyItem.name
        --append the value to the setting
        !newSubSetting.settingData.append(!settingData)
      enddo
      !newSetting.subSettings.append(!newSubSetting)
    enddo

    --append the settings
    !!aslCentralData.projectSettings.append(!newSetting)

    --create the DB element for the setting
    !!aslSettings.createSettingToDb(!newSetting)

  elseif ( !this.action.upcase() eq 'COPY' )then

    --get the form Data
    !copyType         =  !!alert.confirm('Copy the Selected Setting?')
    if ( !copyType.upcase().eq('NO') ) then
      !this.hide()
      return
    elseif ( !copyType.upcase().eq('YES') ) then
      !selectedSetting  =  !!aslSettings.neAslSettings.getselectedrows()[1][1]
      !deleteElement    =  '/' & '$!selectedSetting'
      !deleteDbElement  =  !deleteElement.dbref()

      if ( !deleteDbElement.badref() ) then
        !!alert.error('Cannot copy the selected setting. Check for Unset or Bad Reference')
        return
      endif

      -- find the settings to be copied
      do !setting value !!aslCentralData.userSettings
        if ( !setting.description.eq(!selectedSetting) ) then
          !copySetting  = !setting
        endif
      enddo

      do !setting value !!aslCentralData.projectSettings
        if ( !setting.description.eq(!selectedSetting) ) then
          !copySetting  = !setting
        endif
      enddo

      do !setting value !!aslCentralData.settings
        if ( !setting.description.eq(!selectedSetting) ) then
          !copySetting  = !setting
        endif
      enddo

      -- setting description
      ---------------------------------------------------------------------------
      !newSetting              =  object SETTING()
      !newSetting              =  !copySetting
      !newSetting.description  =  !this.dbName.val.after('/').trim()
      !newSetting.type         =  'PROJ'

      --append the settings
      !!aslCentralData.projectSettings.append(!newSetting)

      --create the DB element for the setting
      !!aslSettings.createSettingToDb(!newSetting)
    endif

  elseif ( !this.action.upcase() eq 'RENAME' )then

    --get the selected setting
    !selectedSetting  =  !!aslSettings.neAslSettings.getselectedrows()[1][1]
    !renameString     =  !this.dbName.val.after('/')

    if ( !selectedSetting.eq(!renameString) ) then
      return
    endif

    --get the form Data
    !renameType         =  !!alert.confirm('Rename the Selected Setting?')
    if ( !renameType.upcase().eq('NO') ) then
      !this.hide()
      return
    elseif ( !renameType.upcase().eq('YES') ) then
      !renameElement    =  '/' & '$!selectedSetting'
      !renameDBelement  =  !renameElement.dbref()

      if ( !renameDBelement.badref() ) then
        !!alert.error('Cannot Rename the selected setting. Check for Unset or Bad Reference')
        return
      endif

      -- find the settings to be renamed
      do !setting value !!aslCentralData.userSettings
        if ( !setting.description.eq(!selectedSetting) ) then
          !renameSetting  = !setting
        endif
      enddo

      do !setting value !!aslCentralData.projectSettings
        if ( !setting.description.eq(!selectedSetting) ) then
          !renameSetting  = !setting
        endif
      enddo

      do !setting value !!aslCentralData.settings
        if ( !setting.description.eq(!selectedSetting) ) then
          !renameSetting  = !setting
        endif
      enddo

      -- setting description
      ---------------------------------------------------------------------------
      !newSetting              =  object SETTING()
      !newSetting              =  !renameSetting
      !newSetting.description  =  !this.dbName.val.after('/').trim()
    endif

    --rename the setting and the corresponding DB element
    !!aslSettings.renameDBelement(!newSetting, !this.dbName.val)

  endif

  --read the asl setting
  !!aslCentralData.readAslSettings()

  -- updates the settings list
  !!aslSettings.fillSettings()

  --set the assemblyItem
  !!aslSettings.selectSetting(!this.dbName.val)
  !!aslSettings.neAslSettings.selectrow(1)

  --Update the gadgets
  !!aslSettings.updateGadgets()

  !this.hide()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      setType
--
-- Description: set the type of setting to create or modify.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      keyword for the setting type ('USER', 'PROJECT', ...)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setType()

  !this.settingType = !this.type.selection('dtext')

  if(!this.settingType.eq('PROJECT'))then
    !this.dbName.val = 'Unset'
  else
    !this.dbName.val = 'Unset'
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Valid Check for the Current Element, Referring to stair tower
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R    GADGET val  calling gadget value to check for name availability
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkName()

  -- Check if the Name already exists

  !checkName = !!checkName(!this.dbName.val, 'new')
    if (!checkName.set()) then
      !this.dbName.val = !checkName
    else
      !this.dbName.val = 'Unset'
    endif


endmethod
-- End of method definition
