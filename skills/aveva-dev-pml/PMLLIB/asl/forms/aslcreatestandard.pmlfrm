--   Description:     Form for getting input for creating new standard or secondary standard
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Create Elements
--  aslCreateStandard()              -                   Constructor
--  close()                          -                   Close the form
--  descValidate()                   -
--  nameValidate()                   -                   Validate name of the element
--
------------------------------------------------------------------------

setup form !!aslCreateStandard dialog dock size 20 4

  -- Body of form definition
  text   .name    'Name'        tagwidth 8  anchor T+L  at xmin           ymin      width 25 is STRING
  text   .desc    'Description' tagwidth 8  anchor T+L  at xmin           ymax+0.2  width 25 is STRING
  button .ok      'Apply'                   anchor T+L  at xmin.name+15   ymax+0.5
  button .cancel  'Dismiss'                 anchor T+L  at xmax+3         ymin

  -- Form Members
  member .elementType     is STRING
  member .action  		    is STRING
  member .errorState 			is BOOLEAN

exit

-- End of form definition
------------------------------------------------------------------------
--
-- Method:      aslCreateStandard
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslCreateStandard()

    !this.name.callback	    = '!this.nameValidate()'
    !this.desc.callback	    = '!this.descValidate()'
    !this.ok.callback  			= '!this.apply()'
    !this.cancel.callback 	= '!this.close()'
    !this.errorState			  = false

endmethod
-- End of method definition for .aslCreateStandard()

------------------------------------------------------------------------
--
-- Method:      nameValidate
--
-- Description: Validate name of the element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameValidate()

  !enteredName    = !this.name.val
  -- check if entered name contain spaces and remove the spaces
  if(!enteredName.occurs(' ').neq(0))then
  	!!alert.warning('Name Field cannot accept space.')
  	return
  endif

  if(!this.elementType.upcase() eq 'STANDARD')then
    if(!enteredName.subString(1,1).eq('/')) then
      !maxNameLength = 50
    else
      !maxNameLength = 49
    endif

    if(!enteredName.length() gt !maxNameLength )then
      !!alert.message('Exceeds Naming Characters limitation. Truncating the name.')
      !enteredName  = !enteredName.subString(1,!maxNameLength)
      !this.errorState  = true
    endif

  elseif(!this.elementType.upcase() eq 'SUBSTANDARD')then
    if(!enteredName.subString(1,1).eq('/')) then
      !maxNameLength = 43
    else
      !maxNameLength = 42
    endif

    if(!enteredName.length() gt !maxNameLength )then
      !!alert.message('Exceeds Naming Characters limitation. Truncating the name.')
      !enteredName  = !enteredName.subString(1,!maxNameLength)
    	!this.errorState  = true
    endif
  endif

  !name    = !!checkName(!enteredName,'new')
  if(!name.unset())then
  	if(!this.elementType.upcase() eq 'STANDARD')then
      !this.name.val = 'ASL-User_Defined_Standard'
    else
      !this.name.val = 'ASL-User_Defined_Sub_Standard'
    endif
    !this.errorState  = true
  else
    !this.name.val  = !enteredName
  endif

endmethod
-- End of method definition for .nameValidate()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Create Elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  if(undefined(!!aslStoreTable))then
    !!alert.warning('Set storage area for ASL Standard')
    return
  endif

  if(!!aslStoreTable.getStore('standards').unset())then
     !!alert.warning('Set Storage area for ASL Standard. Goto Settings menu ---->> ASL Storage Area...to set.')
     return
  endif

  !this.nameValidate()
  if(!this.errorState) then
    !this.errorState  = false
    return
  endif

  !this.descValidate()

  if(!this.action.upcase() eq 'CREATE')then

  	 -- creating standard
  	---------------------------------------------------------------------------
  	if ( !this.elementType.upcase() eq 'STANDARD' ) then
  	  !newStandard           			 = object ASLSTANDARD()
  	  !newStandard.name      			 = !this.name.val
  	  !newStandard.description 		 = !this.desc.val
  	  !newStandard.originKey 			 = 'PROJDFLTS'

   	  -- append the new standard to the central object
  	  !!aslCentralData.standards.append(!newStandard)
  	  	
  	  -- save the standard to files
  		!!aslCentralData.writeStandards()
  	
      if ( !!aslCentralData.standards.size().eq(1) ) then
  	      !!aslstandards.meCurrStandard =  !!aslCentralData.standards[1]
  	  endif 	
  	    	
  	   -- update the form
  	  !!aslstandards.setup()
  	
  	  -- select the new standard
  	  !!aslstandards.opStandards.select('DTEXT', !newStandard.name)
  	  !!aslstandards.select(!!aslstandards.opStandards, 'SELECT')
  		  	
  	-- creating subStandard
  	---------------------------------------------------------------------------
  	elseif ( !this.elementType.upcase() eq 'SUBSTANDARD' ) then
  	  !newSubStandard       				= object ASLSUBSTANDARD()
  	  !newSubStandard.name  				= !this.name.val
  	  !newSubStandard.description  	= !this.desc.val
  	
  	  -- append the new subStandard to the standard object
  	  do !i index !!aslCentralData.standards
  	    if ( !!aslCentralData.standards[!i].name.eq(!!aslstandards.meCurrStandard.name) ) then
  	      !!aslCentralData.standards[!i].subStandards.append(!newSubStandard)
  	      !currentStandard  = !!aslCentralData.standards[!i]
  	      break
  	    endif
  	  enddo
  	
  	  -- update the form
  	  !!aslstandards.setup()
  	  !!aslstandards.meCurrStandard  = !currentStandard
  	
  	  -- select the standard
  	  !!aslstandards.opStandards.select('DTEXT', !!aslstandards.meCurrStandard.name)
  	  !!aslstandards.select(!!aslstandards.opStandards, 'SELECT')
  	
  	  -- select the new standard
  	  !!aslstandards.opsubStandards.select('DTEXT', !newSubStandard.name)
  	  !!aslstandards.meCurrsubStandard   = !newSubStandard
  	
  	  -- save the standard to files
  		!!aslCentralData.writeStandards()
  	endif

	elseif(!this.action.upcase() eq 'COPY')then
		
		if ( !this.elementType.upcase() eq 'STANDARD' ) then
			
			-- copy the standard
    	!newStandard           				= !!aslstandards.meCurrStandard
    	!newStandard.name      				= !this.name.val
    	!newStandard.description			= !this.desc.val
    	!newStandard.originKey 				= 'PROJDFLTS'
    	
    	-- Need to copy the standard in the database
    	!toCopy = !newStandard.refe
    	
      if(!toCopy.unset())then
    		!!aslstandards.updateSubStandards()
    		!!aslstandards.updateGadgets()
    	endif
    	
    	!toCopy = !!aslstandards.meCurrStandard.refe
    	
    	!tpwlRefe = !!aslStoreTable.getStore('standards')
      if(!tpwlRefe.unset())then
        !!alert.warning('Set Storage area for ASL Standard. Goto Settings menu ---->> ASL Storage Area...to set.')
        return
      endif

   		-- Navigate to the said APPLDW
   		!!ce = !tpwlRefe
   		new APPDAR copy $!toCopy
   		if(!this.name.val.subString(1,1).eq('/')) then
   		  !!ce.name  = !this.name.val
   		else
   		  !!ce.name  = '/' & !this.name.val
   		endif
   		
   		--Update the standards object
   		!newStandard.refe = !!ce
   		!members = !!ce.members
      do !subStd indices !members
        !members[!subStd].name = !newStandard.refe.name & '/' & 'SubStandard' & '$!subStd'
        handle ANY
          !members[!subStd].name = !newStandard.refe.name & '/' & 'SubStd' & '$!subStd'
          handle ANY
            -- leave it unnamed
          endhandle
        endhandle
      enddo

   		do !i indices !newStandard.subStandards
   		  if(!members[!i].isNamed)then
   		    !newStandard.subStandards[!i].name = !members[!i].namn
   		  else
   		    !newStandard.subStandards[!i].name = !members[!i].refNo.string()
   		  endif
   		
   		  !newStandard.subStandards[!i].description = !members[!i].desc
   		  !newStandard.subStandards[!i].refe = !members[!i]
   		enddo
   		
   		-- append the new standard to the central object
   		!!aslCentralData.standards.append(!newStandard)

    	-- update the form
    	!!aslstandards.setup()

    	-- select the new standard
    	!!aslstandards.opStandards.select('DTEXT', !newStandard.name)
    	!!aslstandards.select(!!aslstandards.opStandards, 'SELECT')
    	
    	-- save the standard to files
  		!!aslCentralData.writeStandards()

  	elseif( !this.elementType.upcase() eq 'SUBSTANDARD' ) then

    	 -- copy the sub-standard
    	!newSubStandard           			= !!aslstandards.meCurrsubStandard
    	!newSubStandard.name      			= !this.name.val
    	!newSubStandard.description			= !this.desc.val
    	
    	-- Need to copy the standard in the database
    	!toCopy = !newSubStandard.refe
    	!memory = !!ce
    	!!ce = !!aslstandards.meCurrStandard.refe
    	handle ANY
    	  !!alert.error('Cannot Copy selected Secondary Standard.')
    	  return
    	endhandle
    	tail
    	new APPLDA copy $!toCopy
   		if(!this.name.val.subString(1,1).eq('/')) then
   		  !!ce.name  = !this.name.val
   		else
   		  !!ce.name  = '/' & !this.name.val
   		endif
   		    	
    	--Update the standards object
    	!newSubStandard.refe = !!ce
    	!!ce = !memory

    	-- append the new subStandard to the standard object
    	do !i index !!aslCentralData.standards
    	  if ( !!aslCentralData.standards[!i].name.eq(!!aslstandards.meCurrStandard.name) ) then
    	    !!aslCentralData.standards[!i].subStandards.append(!newSubStandard)
    	    !currentStandard  = !!aslCentralData.standards[!i]
    	    break
    	  endif
    	enddo

    	-- update the form
    	!!aslstandards.setup()
    	!!aslstandards.meCurrStandard = !currentStandard
    	
    	-- select the standard
    	!!aslstandards.opStandards.select('DTEXT', !!aslstandards.meCurrStandard.name)
    	!!aslstandards.select(!!aslstandards.opStandards, 'SELECT')
    	
    	-- select the new standard
    	!!aslstandards.opsubStandards.select('DTEXT', !newSubStandard.name)
    	!!aslstandards.meCurrsubStandard = !newSubStandard
    	-- save the standard to files
  		!!aslCentralData.writeStandards()

    endif

  endif

  !this.hide()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .descValidate()

  !enteredDesc  = !this.desc.val
  if(!enteredDesc.trim() eq '') then
    !!alert.message('Description Field cannot be empty.')
    return
  elseif(!enteredDesc.trim().length() gt 120) then
    !!alert.message('Exceeds Characters limitation. Truncating the Description.')
    !this.desc.val  = !enteredDesc.trim().subString(1,120)
  endif

endmethod
-- End of method definition
