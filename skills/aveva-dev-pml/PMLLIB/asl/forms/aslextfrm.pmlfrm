-- Author:          Karel Pleschner
-- Created:         Thu Oct 09 13:28:00 GMT 2008
--
--
-- Description:     Add/remove external frame segment of PLTFRM
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslExtFrm()                      -
--  dismiss()                        -                   dismiss form
--  draw()                           -                   draw added segments
--  drawArcAsCyli(ARC,REAL,REAL,REAL,BOOLEAN) -                   draw passed ARC as aid cylinders (ARC is segmented)
--  drawLineAsCyli(LINE,REAL,REAL,BOOLEAN) -                   draw passed LINE as aid cylinder with passed diameter
--  init()                           -                   form initialisation
--  reinstateAll()                   -                   re-instate all gensec
--  selectSegment(GADGET,STRING)     -                   callback actioned on segment selection
--  updateList()                     -                   update segment list
--

setup form !!aslExtFrm dialog docking

  list .segmentList    'Segments'   anchor T+L+R+B  at x0  y0  callback '!this.selectSegment(' zerosel multiple columns  width 21  height 8 tooltip 'Click to Add/Remove Segment'

  button .reinstateAll 'Re-instate all' linklabel anchor B+L at xmin ymax+0.2 callback '!this.reinstateAll()' width 10

  button    .dismiss    linklabel  'Dismiss'    anchor B+R  at xmax form-6   ymin   callback '!this.dismiss()'   width 5
  paragraph .paDismi                            anchor B+R  at xmin-3   ymin      pixmap    width 16   height 16

  member .status is ARRAY
  member .edges is ARRAY
  member .aidNumber is REAL
  member .form is FORM

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslExtFrm
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslExtFrm()

  !this.formTitle = 'Add/Remove Frame Segment'
  !this.initCall = '!this.init()'
  !this.cancelCall = '!!aidNumbers.hide(!this.aidNumber)'
  !this.killingCall = '!!aidNumbers.hide(!this.aidNumber)'

  !this.paDismi.addPixmap(!!pml.getPathName('discard.png'))

  !this.segmentList.setHeadings('No.	Status')

  !this.aidNumber  = !!aidNumbers.add(!this.formTitle)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: form initialisation
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !this.form = !!aslpltfrmlayout

  !this.edges = !this.form.extfrmDefinition.profile.edges()
  !gensec = !this.form.extfrmDefinition.gensec
  !status = ARRAY()
  do !c indices !this.edges
    !status[!c] = defined(!gensec[!c])
  enddo

  !this.status = !status

  !this.updateList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateList
--
-- Description: update segment list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateList()

  !dtext = ARRAY()
  !selection = ARRAY()
  do !c indices !this.status
    if !this.status[!c] then
      !textStat = 'On (Added)'
      !selection.append(!c)
    else
      !textStat = 'Off (Removed)'
    endif
    !dtext[!c] = !c & '	' & !textStat
  enddo

  !this.draw()
  !this.segmentList.dtext = !dtext
  !this.segmentList.val = !selection

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description: dismiss form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  !!aidNumbers.hide(!this.aidNumber)
  !this.hide()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: draw added segments
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- init variables
  !number    = !this.aidNumber
  !diameter  = 125mm
  !chordHeig = 5mm

  -- clear existing graphic
  !!aidNumbers.hide(!this.aidNumber)

  -- draw frame segments
  do !c indices !this.edges
    if !this.edges[!c].objectType().eq('LINE') then
      !drawLine = !this.edges[!c]
      !command = object BLOCK('!this.drawLineAsCyli(!drawLine,!number,!diameter,on)')
      !pos = !drawLine.proportion(0.5)
    else
      !drawArc = !this.edges[!c]
      !command = object BLOCK('!this.drawArcAsCyli(!drawArc,!number,!diameter,!chordHeig,on)')
      !propAngle = !drawArc.proportion(0.5)
      if !propAngle.between(179,181).or(!propAngle.between(-179,-181)) then
        !propAngle = 0
      endif
      !pos = !drawArc.anglePosition(!propAngle)
    endif

    !desc = !c.string()
    if !this.status[!c] then
      !command.evaluate()
    else
      !desc = !desc & ' - Removed'
    endif
    !!drawAidText(!desc,!pos,!number)
  enddo


endmethod
-- End of method

---------------------------------------------------------------------
--
-- Method:      selectSegment
--
-- Description: callback actioned on segment selection
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectSegment(!list is GADGET,!signal is STRING)

  if !signal.neq('STOP') then
    return
  endif

  !selection = !list.val
  do !index indices !this.status
    !this.status[!index] = !selection.find(!index).set()
    if !this.status[!index] then
      !this.form.extfrmDefinition.addGensec(!index)
    else
      !this.form.extfrmDefinition.removeGensec(!index)
    endif
  enddo

  !this.updateList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reinstateAll
--
-- Description: re-instate all gensec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reinstateAll()

  do !c indices !this.status
    !this.status[!c] = true
    !this.form.extfrmDefinition.addGensec(!c)
  enddo

  !this.updateList()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawLineAsCyli
--
-- Description: draw passed LINE as aid cylinder with passed diameter
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        line to be draw as cylinder
--    2   R      REAL        aid number
--    3   R      REAL        diameter of cylinder
--    4   R      BOOLEAN     filled
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawLineAsCyli(!drawLine is LINE,!number is REAL,!diameter is REAL,!filled is BOOLEAN)

  -- compute cylinder properties
  !ori = !drawLine.plane().orientation
  !pos = !drawLine.proportion(0.5)
  !leng = !drawLine.length()

  -- draw cylinder
  !!drawAidCylinder(!diameter,!leng,!pos,!ori,true,!number)

  -- draw sphere at the start
  !!drawAidSphere(!diameter,!drawLine.startPosition,!number)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawArcAsCyli
--
-- Description: draw passed ARC as aid cylinders (ARC is segmented)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        line to be draw as cylinder
--    2   R      REAL        aid number
--    3   R      REAL        diameter of cylinder
--    4   R      REAL        arc tolerance
--    %   R      BOOLEAN     filled
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawArcAsCyli(!drawArc is ARC,!number is REAL,!diameter is REAL,!chordHeig is REAL,!filled is BOOLEAN)

  -- compose profile from arc
  !arcArr[1] = !drawArc
  !arcProfile = object PROFILE(!drawArc.position,!drawArc.orientation,!arcArr)

  -- convert acr to lines
  !lines = !arcProfile.polyline(!chordHeig).edges()

  -- draw lines
  do !drawLine values !lines
    !this.drawLineAsCyli(!drawLine,!number,!diameter,!filled)
  enddo

endmethod
-- End of method
