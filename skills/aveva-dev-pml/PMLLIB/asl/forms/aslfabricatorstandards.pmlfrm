--
-- Description:    ASL fabricator standard form, only for ASLADMIN
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslFabricatorStandards()         -                   Constructor
--  createRestriction()              -                   create a new restriction for the current element
--  deleteRestriction()              -                   deletes the restriction
--  modifyRestriction(ARRAY)         -                   modifies the restriction
--  setup()                          -                   callback when opening the form
--  track()                          -                   ce tracker
--  updateContainer()                -                   update the .NET container
--  updateForm()                     -                   update all gadgets
--

import 'GridControl'
handle ANY
endhandle

setup form !!aslFabricatorStandards dialog dock
  -- .NET library
  using namespace 'Aveva.Pdms.Presentation'

  track    'DESICE'    callback '!this.track()'

  -- create/copy and select standards, set defaults
  para   .paElement                     at xmin form                ymax    text 'Element'
  line   .lnElement                     at xmin                     ymax-.2                                                       anchor T+L+R HORIZ width 67
  para   .paText                        at x2                       ymax+.2 text 'Fabricator standard for '
  para   .paNameDesc                                                                                                              anchor T+L+R       width 37 lines 1
  para   .paCreateRestriction           at xmin.paText              ymax+.2 pixmap                                                                   width 16 height 16
  button .lkCreateRestriction linklabel at x5                       ymin    'Create an additional restriction'  callback '!this.createRestriction()' width 30
  para   .paDeleteRestriction           at xmin.paText              ymin    pixmap                                                                   width 16 height 16
  button .lkDeleteRestriction linklabel at xmin.lkCreateRestriction ymin    'Delete the additional restriction' callback '!this.deleteRestriction()' width 30

  path down vdist 0.1
  -- Tab set for criteria
  para  .paTabs at xmin form ymax text 'Additional restrictions'
  line  .lnTabs at xmin      ymax-.2 anchor T+L+R HORIZ width.lnElement

 -- adds the graphical members
  container .coStandards PMLNetCONTROL at xmin.paText ymax+.5 anchor all 'Additional restrictions' width 65 height 15

  -- adds the netcontrol members
  member .netStandards is NETGRIDCONTROL

  member .cataRefe     is DBREF

  member .ddseRefe     is DBREF

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslFabricatorStandards
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslFabricatorStandards()

  using namespace 'Aveva.Pdms.Presentation'

  !this.autoscroll   = true
  !this.callback     = '!this.setup()'
  !this.formRevision = ' $Revision$ '
  !this.formTitle    = 'Fabricator Standards for Access Stair and Ladder application'
  !this.quitCall     = ''

  -- set the pixmaps
  !this.paCreateRestriction.addPixmap(!!pml.getPathName('aslnewfabricatorstandard16.png'))
  !this.paDeleteRestriction.addPixmap(!!pml.getPathName('asldeletefabricatorstandard16.png'))

  -- create instance of .Net control
  !this.netStandards = object NETGRIDCONTROL()

  -- add PML event handlers to .Net control
  !this.netStandards.addeventhandler('AfterCellUpdate',  !this, 'modifyRestriction')

  !this.netStandards.columnExcelFilter(false)
  !this.netStandards.outlookGroupStyle(false)
  !this.netStandards.fixedHeaders(true)
  !this.netStandards.fixedRows(false)
  !this.netStandards.editableGrid(true)
  !this.netStandards.headerSort(false)

  -- add .Net control to PML container
  !this.coStandards.control = !this.netStandards.handle()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createRestriction
--
-- Description: create a new restriction for the current element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .createRestriction()

  -- create undo mark
  !undo = object UNDOABLE()
  !undo.description('Create ASL fabricator standards')
  !undo.undoAction('!!aslFabricatorStandards.setup()')
  !undo.redoAction('!!aslFabricatorStandards.setup()')
  !undo.add()

  !!ce = !this.cataRefe
  NEW DDSE
  !!ce.purp      = 'FABR'
  !this.ddseRefe = !!ce
  OWNER

  -- end undo mark
  !undo.endUndoable()

  -- update the form
  !this.updateForm()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteRestriction
--
-- Description: deletes the restriction
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deleteRestriction()

  if ( !!alert.confirm('Do you really want to delete the additional restriction?').neq('YES') ) then
    return
  endif

  -- create undo mark
  !undo = object UNDOABLE()
  !undo.description('Delete ASL fabricator standards')
  !undo.undoAction('!!aslFabricatorStandards.setup()')
  !undo.redoAction('!!aslFabricatorStandards.setup()')
  !undo.add()

  !!ce = !this.ddseRefe
  DELETE DDSE

  -- end undo mark
  !undo.endUndoable()

  -- update the form
  !this.updateForm()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyRestriction
--
-- Description: modifies the restriction
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyRestriction(!array is ARRAY)

  !array[1]         = true

  using namespace  'Aveva.Pdms.Presentation'

  !criteriaSetName  = 'ASL' & !this.cataRefe.type & 'CRITERIA'
  !criteriaSet      = object $!<criteriaSetName>()

  -- handles all rows of the netcontrol
  do !row value !this.netStandards.getRows()
    -- gets the description
    !desc = !row[1]

    -- looking for the matching criterion
    do !i index !criteriaSet.attributes()

      !attributeName   = !criteriaSet.attributes()[!i]

      -- destroys the old version of the criterion
      if ( DEFINED(!criterion) ) then
        !criterion.delete()
      endif

      -- gets the criterion
      !criterion = !criteriaSet.attribute(!attributeName)

      -- ignores none criterion objects
      skip if ( !criterion.objectType().neq('CRITERION') )

      if ( !criterion.description.eq(!desc) ) then
        -- validValues
        !criterion.validValues = object ARRAY()
        if ( !row[2].neq('') ) then
          do !value value !row[2].split(';')
            !criterion.validValues.append(!value.real())
          enddo
        endif

        -- min
        if ( !row[3].eq('') ) then
          !criterion.min = object REAL()
        else
          !criterion.min = !row[3].real()
        endif

        -- max
        if ( !row[4].eq('') ) then
          !criterion.max = object REAL()
        else
          !criterion.max = !row[4].real()
        endif

        -- tolerance
        if ( !row[5].eq('') ) then
          !criterion.tolerance = object REAL()
        else
          !criterion.tolerance = !row[5].real()
        endif

        -- optimum
        if ( !row[6].eq('') ) then
          !criterion.optimum = object REAL()
        else
          !criterion.optimum = !row[6].real()
        endif

        -- expression
        if ( !row[7].eq('') ) then
          !criterion.value[1] = object STRING()
        else
          !criterion.value[1] = !row[7]
        endif

        break
      endif
    enddo
    !criteriaSet.attribute(!attributeName) = !criterion
  enddo

  -- create undo mark
  !undo = object UNDOABLE()
  !undo.description('Modify ASL fabricator standards')
  !undo.undoAction('!!aslFabricatorStandards.setup()')
  !undo.redoAction('!!aslFabricatorStandards.setup()')
  !undo.add()

  -- write to the db
  !!ce = !this.ddseRefe
  DELETE DDSE MEM
  !!aslCentralData.writeCriteriaSetToDB(!criteriaSet)
  !!ce = !this.cataRefe

  -- end undo mark
  !undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: callback when opening the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setup()

  !this.track()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: ce tracker
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .track()

  if ( !!ce.type inset ('STRFLT', 'STRTWR', 'STRSET', 'LADDER') ) then
    !this.setActive(true)

    -- update the member
    !this.cataRefe = !!ce

    -- update all gadgets
    !this.updateForm()
  else
    !this.setActive(false)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateContainer
--
-- Description: update the .NET container
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateContainer()

  using namespace  'Aveva.Pdms.Presentation'

  -- evaluates the write permission
  !writeAccess = !!aslCentralData.administrator

  -- set the headings of the access-list
  ---------------------------------------------------------------------------
  !heading[1] = 'Description'
  !heading[2] = 'Valid Value'
  !heading[3] = 'Min'
  !heading[4] = 'Max'
  !heading[5] = 'Tolerance'
  !heading[6] = 'Optimum'
  !heading[7] = 'Expression'

  --gets the name of the criteriaSet and the name of the criterion (e.g. ASLLADDERCRITERIA), there can be only one
  !criteriaSetName = 'ASL' & !this.cataRefe.type & 'CRITERIA'

  -- fills the grid
  ---------------------------------------------------------------------------
  -- collect all ddat elements from the database
  !collection = object COLLECTION()
  !collection.scope(!this.ddseRefe)
  !collection.type('DDAT')
  !dDatRefes  = !collection.results()

  -- there are elements, so get the standard
  if ( !dDatRefes.empty().not() ) then

    -- get the data from the database
    !standards       = !!aslCentralData.readStandardsFromDB(!dDatRefes)

    -- get the current criteriaset, there can be only one, therefore ...[1]...[1]...
    !criteriaSet     = !standards[1].subStandards[1].attribute(!criteriaSetName)

  -- otherwise take the unset object
  else
    -- get the current criteriaset, there can be only one, therefore ...[1]...[1]...
    !criteriaSet     = object $!<criteriaSetName>()

  endif

  -- inits
  !criterions     = object ARRAY()
  !criterionDescs = object ARRAY()

  -- evaluates the values for the name and the description of all criterion elements of the criteria  set
  do !criterionName value !criteriaSet.attributes()
    -- destroys the old version of the criterion
    if ( DEFINED(!criterion) ) then
      !criterion.delete()
    endif

    -- evaluates the real object
    !criterion = !criteriaSet.attribute(!criterionName)

    -- ignores all none criterion elements
    skip if ( !criterion.objectType().neq('CRITERION') )

    -- collects the valid data for further process
    !criterions.append(!criterion)
    !criterionDescs.append(!criterion.description)
  enddo

  -- sorts the criterion elements by their description
  !sortedIndices = !criterionDescs.sortedIndices()
  !criterions.reIndex(!sortedIndices)

  -- handle the sorted criterion elements
  do !i index !criterions
    !criterion = !criterions[!i]
    !rows[!i]  = object ARRAY()
    !rows[!i].append(!criterion.description)

    -- fills the valid values gadget
    ---------------------------------------------------------------------------
    !validValues = ''
    do !validValue value !criterion.validValues
      if ( !validValues.eq('') ) then
        !validValues = !validValue.string()
      else
        !validValues = !validValues & ';' & !validValue.string()
      endif
    enddo

    !rows[!i].append(!validValues)
    !rows[!i].append(!criterion.min.string())
    !rows[!i].append(!criterion.max.string())
    !rows[!i].append(!criterion.tolerance.string())
    !rows[!i].append(!criterion.optimum.string())
    !rows[!i].append(!criterion.value[1].string())
  enddo

  !netDataSource = object NETDATASOURCE(' ', !heading, !rows)
  !this.netStandards.bindToDataSource(!netDataSource)
  !this.netStandards.editableGrid(!writeAccess)
  !this.netStandards.setEditableColumn(1, false)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateForm
--
-- Description: update all gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateForm()

  -- set the create/delete gadgets visible / invisible
  !collection = object COLLECTION()
  !expression = object EXPRESSION('PURP eq |FABR|')
  !collection.filter(!expression)
  !collection.scope(!this.cataRefe)
  !collection.type('DDSE')
  !allDDSets  = !collection.results()
  !flag                             = !allDDSets.empty().not()
--TODO (to be deleted)
  !flag                             = !this.cataRefe.members.empty().not() and $
                                      !this.cataRefe.members[1].type.eq('DDSE')

  !this.paCreateRestriction.visible = !flag.not()
  !this.lkCreateRestriction.visible = !flag.not()
  !this.paDeleteRestriction.visible = !flag
  !this.lkDeleteRestriction.visible = !flag

  -- update the .NET container
  if ( !flag ) then
    --TODO
--    !this.ddseRefe        = !allDDSets[1]
    !this.ddseRefe        = !this.cataRefe.members[1]

    -- update the .NET container
    !this.updateContainer()
  else
    !this.netStandards.clearGrid()
  endif

  -- update name and description
  !this.paNameDesc.val     = !this.cataRefe.nameTy & ' - Description: ' !this.cataRefe.description

endmethod
-- End of method
