--
-- Description:
--    Main form for handrail (HANDRA)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  acceptGates()                    -                   accept changes made from gate modification panel
--  acceptGeom()                     -                   accept changes made from geometry modification panel
--  acceptHandrail()                 -                   update handrail db element
--  addGate()                        -                   Invoke edg mode to add gate to handrail object
--  addGate(EDGPOSITIONDATA)         -                   add gate to handrail object at position obtained from picked data
--  area(GADGET,STRING)              -                   set area attribute
--  aslHandra()                      -
--  cancel()                         -                   form cancellation callback
--  closeFlag()                      -                   callback of related toggle
--  copyOwnerPath()                  -                   invoke EDG mode to pick START vertices of owner path
--  copyPath()                       -                   invoke EDG mode to pick START vertices of owner path
--  copyPath(EDGPICKDATA)            -                   pick vertex to define handrail geometry
--  copyPathClose()                  -                   callback on close of EDG session
--  createHandrail()                 -                   create handrail and show modify panel
--  createHandrailPane(STRING)       -                   setup new handrail object and display main modification panel
--  defineGeom()                     -
--  defineGeom(EDGPOSITIONDATA)      -
--  defineGeomClose()                -                   close EDG session for define geometry
--  deleteHandrail()                 -                   delete handrail
--  description()                    -                   set description attribute
--  discardGates()                   -                   discard changes made from gate mod. panel
--  discardGeom()                    -                   discard changes made from geometry panel
--  discardHandrail()                -                   discard changes and reset form to previously saved status
--  drawEdges(REAL,BOOLEAN)          ARRAY               draw handrail edges as aid cylinder
--  drawGate(REAL,REAL,REAL,REAL)    -                   draw and mark gate with passed index for edg pick in aids colour
--  drawGates(REAL,REAL,REAL)        -                   draw and mark gates for edg pick in aids colour
--  drawLineAsCyli(LINE,REAL,REAL)   -                   draw passed LINE as aid cylinder with passed diameter
--  drawVertices(REAL,REAL,ANY,BOOLEAN) ARRAY               draw vertices
--  edgDeleteGate(EDGPICKDATA)       -                   pick gate (aid sphere) to delete
--  edgDeleteGateInit()              -                   invoke edg mode to pick the gate (aid sphere) to be deleted
--  edgpickToPosition(EDGPICKDATA)   POSITION            extract position from EDGPICKDATA object
--  extend()                         -                   initialise edg session to extend handrail start/end
--  extend(EDGPICKDATA)              -                   extend start/end of open handrail
--  extend(EDGPOSITIONDATA)          -                   extend start/end of open handrail
--  extendClose()                    -                   callback on EDG session close
--  gatePane(GADGET)                 -                   Show panel for gates
--  gatePaneToCreateHandrail()       -                   exit gate panel and return back to create handrail panel
--  gatePaneToModifyHandrail()       -                   exit gate panel and return back to modify handrail panel
--  gatePosition()                   -                   invoke edg mode to pick new position of the gate
--  gatePosition(EDGPOSITIONDATA)    -                   move gate to the new position snapped onto handrail boundary edge
--  gates(ARRAY)                     -                   callback of gates container
--  geomPane(GADGET)                 -
--  geomPaneButtons()                -                   handle activity status of buttons of geomPane
--  geomPaneToCreateHandrail()       -                   exit modify geometry panel and return back to create handrail panel
--  geomPaneToModifyHandrail()       -                   exit modify geometry panel and return back to modify handrail panel
--  getHandrailAbove(DBREF)          DBREF
--  getHandrailOwnerFrom(DBREF)      DBREF               get possible handrail owner passed db position, e.g db item that can own the handrail
--  handrail(ASLHANDRAIL)            -                   assign ASLHANDRAIL object to the form
--  init()                           -                   form initialize HANRAIL
--  kill()                           -                   callback called on form kill
--  mainPane()                       -
--  merge()                          -                   Initialise EDG pick to pick handrail to be merged
--  merge(EDGPICKDATA)               -                   Merge current and picked handrail
--  modifyHandrailPane(ASLHANDRAIL,DBREF) -                   show main modification panel
--  modifyHandrailPane(DBREF)        -
--  moveCurrentVertex()              -                   invoke EDG session to pick new position of current vertex
--  moveCurrentVertex(EDGPOSITIONDATA) -                   move current vertex to picked position
--  moveCurrentVertexClose()         -                   callback on EDG session close
--  number(GADGET,STRING)            -                   set number attribute
--  openSegment()                    -                   initialise edg session to pick linear segment of HR to make it open
--  openSegment(EDGPICKDATA)         -                   make linear segment of HR open
--  openSegmentClose()               -                   called on exit from EDG mode to make segment open
--  postSpacing(GADGET)              -                   callback performed on post spacing gadgets
--  radius()                         -                   callback of radius text gadget (sets the handrail bend radius)
--  railSpacing()                    -
--  railSpacingSetactive()           -                   set active status of associated gadgets to rail spacing container
--  remGate()                        -                   remove gate from handrail object
--  removeCurrentVertex()            -                   remove current vertex and associated posts
--  removeGeom()                     -                   completely remove geometry definition of handrail incl posts, rails, gates, etc.
--  removeVertices()                 -                   invoke EDG mode to pick START vertex to remove
--  removeVertices(EDGPICKDATA)      -                   pick start/end vertex sequence to be deleted
--  removeVerticesClose()            -                   called on exit from EDG mode to remove vertices
--  rpath()                          ASLRPATH            get rpath from owned handrail object
--  selectCurrentVertex()            -                   invoke EDG session to pick vertex to be made current
--  selectCurrentVertex(EDGPICKDATA) -                   make picked vertex current
--  selectCurrentVertexClose()       -                   executed when edg session is closed
--  selectGate(ARRAY)                -                   callback on selection of gates container gadget
--  setGadgets()                     -                   populate gadgets with the handrail object values
--  setHandrailPaneGadgets(BOOLEAN)  -
--  setName()                        -
--  shiftOffset()                    -                   shift offset inclination
--  showPanel(GADGET)                -
--  split()                          -                   init EDG mode to pick element on split
--  split(EDGPICKDATA)               -                   Split handrail on passed element
--  splitRail()                      -                   init EDG mode to pick element on split
--  splitRail(EDGPICKDATA)           -                   Split single rail on passed element
--  stringToDistance(STRING)         REAL                convert distance in string to real in current units
--  termination(GADGET)              -                   set termination template
--  tmplReference()                  -                   callback of .tmplReference option gadget
--  trackDb()                        -                   method to control active status of main panel buttons
--  trackStairs(DBREF,POSITION)      ARRAY               track side of stairs closer to passed position.
--  undo(STRING)                     -                   undo/redo callback of UNDOABLE object added to undo stack from .updateDb() method of ASLHANDRAIL object
--  vertex()                         ARRAY               return vertex array of rpath owned by handrail object
--  vertex(REAL)                     ARRAY               return passed vertex as array of all properties of it (position, type, detail)
--  vertexDetail()                   ARRAY               return vertex detail array of rpath owned by handrail object
--  vertexType()                     ARRAY               return vertex type array of rpath owned by handrail object
--  visiblePane()                    GADGET              return currently visible panel
--

import 'GridControl'
handle ANY
endhandle


setup form !!aslHandra dialog docking right


  -- .NET library
  using namespace 'Aveva.Pdms.Presentation'

  frame .mainPane  panel  anchor top + left + right     at x0    y0
    paragraph .createTask   at x0.5 ymax text 'Create' width 5
    line .createTaskLine at xmin  ymax  anchor top + left + right  horizontal width 32
    button .mainCreateHandra linklabel 'Handrail'at x2  ymax callback  '!this.createHandrailPane(''init'')' width 5
    button .mainCreateGate   linklabel 'Gates'    at xmin ymax callback '!this.gatePane(!this.mainPane)' width 6

    paragraph .modifyTask  at x0.5 ymax+0.5 text 'Modify' width 5
    line .modifyTaskLine at xmin ymax anchor top + left + right horizontal width 32
    button .mainModifyHandra linklabel 'Handrail Definition' at x2 ymax callback '!this.modifyHandrailPane(handra)' width 11
    button .mainModifyGeom   linklabel 'Handrail Geometry'   at xmin ymax callback '!this.geomPane(!this.mainPane)' width 11
    button .mainModifyGate   linklabel 'Gates'  at xmin ymax callback '!this.gatePane(!this.mainPane)' width 4
    button .split            linklabel 'Split Handrail...' at xmin ymax callback '!this.split()' width 11
    button .merge            linklabel 'Merge Handrail...' at xmin ymax callback '!this.merge()' width 11
    button .mainExtend       linklabel 'Extend Handrail End...' at xmin ymax callback '!this.extend()' width 14
    button .splitRail        linklabel 'Split Single Rail(s)...' at xmin ymax callback '!this.splitRail()' width 14

    paragraph .deleteTask at x0.5 ymax+0.5 text 'Delete' width 5
    line .deleteTaskLine at xmin ymax anchor top + left + right horizontal width 32
    button .mainDeleteHandra linklabel 'Handrail' at x2 ymax callback '!this.deleteHandrail()' width 5
    button .mainDeleteGate   linklabel 'Gate...'  at xmin ymax callback '!this.edgDeleteGateInit()' width 5

    paragraph .exitIcon  anchor top + left   at x0  ymax+0.5  pixmap width 15 height 15
    button .exit    linkLabel 'Exit' at xmax+1  ymin   callback '!this.hide() !this.cancel()' width 3
  exit

  frame .handrailPane panel anchor top + left + right at x0 y0
    paragraph .generalData at x0.5 ymax text 'General Attributes' width 14
    line .generalDataLine at xmin ymax anchor top + left + right horizontal width 32
    text   .name         'Name:'         tagwidth 10   at x1 ymax+0.2   callback '!this.setName()'          anchor L+T+R  width 20 is STRING
    text   .desc         'Description:'  tagwidth 10   at xmin ymax+0.2 callback '!this.description()'  anchor L+T+R width 20 is STRING
    numericinput .area   'Area:'         tagwidth 10   at xmin ymax+0.2 callback '!this.area('           anchor l+t+r range -1000000 1000000 width 10
    numericinput .number 'Number:'       tagwidth 10   at xmin ymax+0.2 callback '!this.number('         anchor l+t+r range -1000000 1000000 width 10

    paragraph .tmplData at x0.5 ymax+0.5 text 'Template' width 7
    line .tmplDataLine at xmin ymax anchor top + left + right horizontal width 32
    option .tmplReference at x1 ymax +0.2 anchor L+R+T callback '!this.tmplReference()'  width 28

    paragraph .termination at x0.5 ymax+0.5 text 'Termination'  width 14
    line .terminationLine at xmin ymax anchor T+L+R horizontal width 32
    option .terminationStart 'Start:' tagwidth 5 at x1 ymax+0.2 anchor L+R+T callback '!this.termination(!this.terminationStart)' width 23
    option .terminationEnd   'End:'   tagwidth 5 at x1 ymax+0.2 anchor L+R+T callback '!this.termination(!this.terminationEnd)' width 23

    paragraph .postData at x0.5 ymax+0.5 text 'Posts' width 5
    line .postDataLine at xmin ymax anchor top + left + right horizontal width 32
    text .postSpacing    'Post spacing:'    at x1 ymax+0.5 anchor left + right callback '!this.postSpacing(!this.postSpacing)' tagwidth 12 width 18 is REAL format !!distanceFmt
    text .tangentSpacing 'Tangent spacing:' at xmin ymax anchor left + right callback '!this.postSpacing(!this.tangentSpacing)' tagwidth 12 width 18 is REAL  format !!distanceFmt
    text .endSpacing     'End spacing:'     at xmin ymax anchor left + right callback '!this.postSpacing(!this.endSpacing)' tagwidth 12 width 18 is REAL  format !!distanceFmt

    paragraph .railData at x0.5 ymax + 0.5 text 'Rails' width 5
    line .railDataLine at xmin ymax anchor top + left + right horizontal width 32
    text .radius 'Bend Radius:'  at x1 ymax+0.5 anchor left + right callback '!this.radius()' tagwidth 12 width 18 is REAL FORMAT !!distanceFmt
    text .railSpacing 'Spacing:' at xmin ymax anchor left+righ callback '!this.railSpacing()' tagwidth 12  width 18 is STRING

    line .geomDataLine at x0.5 ymax+0.3 anchor top + left + right horizontal width 32
    button .handrailGeom linklabel 'Handrail Geometry...' at xmin+0.5 ymax+0.5 callback '!this.geomPane(!this.handrailPane)' width 13

    button .handrailGate linklabel 'Gates...' at xmin ymax callback '!this.gatePane(!this.handrailPane)' width 7

    paragraph .createHandrailIcon        anchor top + left   at x0   ymax+1 pixmap width 15 height 15
    button .createHandrail  linklabel    'Create Handrail' at xmax+1 ymin callback '!this.createHandrail()' width 10

    paragraph .acceptHandrailIcon  anchor top + left  at xmin.createHandrailIcon   ymin.createHandrailIcon   pixmap width 16 height 16
    button    .acceptHandrail linklabel 'Accept Changes'     anchor top + left  at xmax+1 ymin  callback '!this.acceptHandrail()' width 10

    paragraph .discardHandrailIcon anchor top + right at xmax form - 16 ymin pixmap width 16 heigh 16
    button    .discardHandrail linklabel 'Discard Changes'  anchor top + right at xmax+1 ymin callback '!this.discardHandrail()' width 10

    paragraph .handrailBackToMainIcon    anchor top + left   at x0   ymax+0.5 pixmap width 15 height 15
    button .handrailBackToMain linklabel 'Back to Main Handrail Tasks' at xmax+1  ymin callback '!this.mainPane()' width 17

  exit

  frame .geomPane panel anchor top + left + right at x0 y0

    toggle .closeFlag  'Closed'  at x0.5 ymax callback '!this.closeFlag()'
    button .copyOwnerPath linklabel 'Copy Path of Owner' at xmin ymax callback '!this.copyOwnerPath()' width 12
    button .copyPath linklabel 'Copy Path of Picked Item...' at xmin ymax callback '!this.copyPath()'  width 17
    button .geomDefine linklabel 'Insert Corner/Segment...' at xmin ymax callback '!this.defineGeom()' width 15
    frame  .geomDefineParam at xmin ymax
      rtoggle .usepos 'Use exact position' tagwidth 10
      rtoggle .useLine 'Use picked line' at xmin ymax tagwidth 7
    exit
    button .selectCurrentVertex linklabel 'Set Current Vertex...' at xmin ymax+0.5 callback '!this.selectCurrentVertex()' width 13
    button .moveCurrentVertex   linklabel 'Move Current Vertex...' at xmin ymax callback '!this.moveCurrentVertex()' width 14
    button .removeCurrentVertex linklabel 'Remove Current Vertex' at xmin ymax callback '!this.removeCurrentVertex()' width 14

    button .removeVertices      linklabel 'Remove Picked Vertices...'    at xmin ymax+0.5 callback '!this.removeVertices()' width 16
    button .removeGeom linklabel 'Remove All Vertices'   at xmin ymax callback '!this.removeGeom()'  width 13

    button .geomExtend          linklabel 'Extend Start/End...' at xmin ymax+0.5 callback '!this.extend()' width 11

    button .shiftOffset toggle 'Shift Offset' at xmin ymax+0.5 callback '!this.shiftOffset()' width 8 tooltip 'Shift offset of handrail members'

    button .acceptGeomIcon anchor top + left at x0 ymax+1 pixmap width 15 height 15
    button .acceptGeom linklabel 'Accept Changes' anchor top + left   at xmax+1 ymin width 10

    paragraph .discardGeomIcon anchor top + right at xmax form - 16 ymin pixmap width 16 heigh 16
    button    .discardGeom linklabel 'Discard Changes' anchor top + right   at xmax+1 ymin width 10

    paragraph .geomBackIcon    anchor top + left   at x0   ymax+0.5 pixmap width 15 height 15
    button .geomBack linklabel at xmax+1  ymin width 17

  exit

  frame .gatePane panel anchor top + left + right at x0 y0
    container .gates PMLNetCONTROL   at xmin form ymax+0.5 anchor all width 31 heigh 8
    button .addGate linklabel 'Add Gate...' at xmin ymax+0.3 anchor L+B callback '!this.addGate()' width 7
    button .posGate linklabel 'Position Gate...' at xmin ymax anchor L+B callback '!this.gatePosition()' width 9
    button .remGate linklabel 'Remove Gate' at xmin ymax anchor L+B callback '!this.remGate()' width 8

    paragraph .acceptGatesIcon anchor top + left   at x0   ymax+1 pixmap width 15 height 15
    button    .acceptGates linklabel 'Accept Changes' anchor top + left   at xmax+1 ymin width 10

    paragraph .discardGatesIcon anchor top + right at xmax form - 16 ymin pixmap width 16 heigh 16
    button    .discardGates linklabel 'Discard Changes' anchor top + right   at xmax+1 ymin width 10

    paragraph .gateBackIcon    anchor top + left   at x0   ymax+0.5 pixmap width 15 height 15
    button .gateBack linklabel  at xmax+1 ymin  width 18

  exit

  -- set form tracking
    track    'DESICE'    callback '!this.trackDb()'

  -- Form Members
  -- reference to db item where the new handrail to be created
  member .handrailOwner          is DBREF

  -- working handrail object
  member .handrail               is ASLHANDRAIL

  -- saved handrail object
  member .savedHandrail          is ASLHANDRAIL

  -- temporary handrail object
  member .tmpHandrail            is ASLHANDRAIL

  -- handrail templates
  member .templates              is ARRAY

 -- handrail termination templates
 member .terminationTmpl         is ARRAY

  -- gates gadget control
  member .gatesControl           is NETGRIDCONTROL

  -- EDG Description
  member .edgDescription         is STRING

  -- Aid Numbers for indication of selected gate (aid number for drafting of whole handrail is stored at handrail object)
  member .aidNumber              is REAL

  -- registry of panels
  member .panels                 is ARRAY

  -- use ASL store table
  member .useStoreTable          is BOOLEAN

  -- arrays for temporary storage of working data
  member .tmpPath                is ARRAY
  member .tmpVertex              is ARRAY
  member .tmpVertexIndex         is ARRAY
  member .currentVertex          is REAL
  member .extend                 is STRING

  -- If the form should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be register.
  -- Register the form
  !!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslHandrail
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslHandra()

  !this.formRevision  = ' $Revision$ '
  !this.initCall      = '!this.init()'
  !this.cancelCall    = '!this.cancel()'
  !this.killingCall   = '!this.kill()'

  -- set store table on
  !this.useStoreTable = true

  -- Set form to auto scroll
  !this.autoScroll              = true

  !this.area.modifiedEvents   = true
  !this.number.modifiedEvents   = true

  -- Set "Back" icon
  !backIcon                     = !!pml.getPathname('back.png')
  !this.exitIcon.addPixmap(!backIcon)
  !this.handrailBackToMainIcon.addPixmap(!backIcon)
  !this.geomBackIcon.addPixmap(!backIcon)
  !this.gateBackIcon.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getPathname('create.png')
  !this.createHandrailIcon.addPixmap(!createIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getPathname('accept.png')
  !this.acceptHandrailIcon.addPixmap(!acceptIcon)
  !this.acceptGatesIcon.addPixmap(!acceptIcon)
  !this.acceptGeomIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getPathname('discard.png')
  !this.discardHandrailIcon.addPixmap(!discardIcon)
  !this.discardGatesIcon.addPixmap(!discardIcon)
  !this.discardGeomIcon.addPixmap(!discardIcon)

  -- Set "Warning" icon
  --!warningIcon                  = !!pml.getPathname('exclamation-32.png')

   using namespace 'Aveva.Pdms.Presentation'

  -- create instance of .Net control for gates
  !this.gatesControl = object NETGRIDCONTROL()

  -- add PML event handlers to .Net control for gates
  !this.gatesControl.addeventhandler('AfterCellUpdate', !this, 'gates')
  !this.gatesControl.addeventhandler('AfterSelectChange', !this, 'selectGate')
  !this.gatesControl.columnExcelFilter(false)
  !this.gatesControl.outlookGroupStyle(false)
  !this.gatesControl.fixedHeaders(true)
  !this.gatesControl.fixedRows(true)
  !this.gatesControl.editableGrid(true)
  !this.gatesControl.headerSort(false)
  !this.gatesControl.singleRowSelection(true)
  !this.gatesControl.columnSummaries(false)
  !this.gatesControl.seteditableColumn(1,false)

  -- add .Net control to PML container for the gates
  !this.gates.control = !this.gatesControl.handle()

  -- EDG Description
  !this.edgDescription    = 'ASL Handrail Form'

  -- add all panels to registry
  !this.panels.append(!this.mainPane)
  !this.panels.append(!this.handrailPane)
  !this.panels.append(!this.gatePane)
  !this.panels.append(!this.geomPane)

  -- set colour of shift offset button
  !this.shiftOffset.background = !this.background

  -- activate toggle for edg definition of geometry
  !this.usepos.val = true
  !this.geomDefineParam.active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: form initialize
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- register form in !!aidNumbers
  !this.aidNumber = !!aidNumbers.add('ASL Handrail Form')

  !this.mainPane()
  !this.trackDb()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createHandrailPane
--
-- Description: setup new handrail object and display main modification panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Operation mode - "init" to initialize object and show panel or "show" to show panel only (can be any string
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createHandrailPane(!mode is STRING)

  -- remove EDG packet from stack first
  !!edgCntrl.remove(!this.edgDescription)

  -- clear aid graphic
  !!aidNumbers.hide(!this.aidNumber)

  if !mode.lowcase().eq('init') then
    -- initialize handrail object
    !handrail = object ASLHANDRAIL(!!aslCentralData.currSetting.description)
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle

    -- set automatic offset on
    !handrail.autoOffset = true

    -- get position and orientation of handrail object from hierarchy above
    !owner = !this.handrailOwner
    do
      !pos = !owner.position
      handle ANY
        !owner = !owner.owner
        skip
      endhandle
      break
    enddo
    !owner = !this.handrailOwner
    do
      !ori = !owner.orientation
      handle ANY
        !owner = !owner.owner
        skip
      endhandle
      break
    enddo
    !handrail.position = !pos
    !handrail.orientation = !ori

    -- assign object to form
    !this.handrail(!handrail)
  endif

  -- set gadgets
  !this.setHandrailPaneGadgets(true)

  -- set form title
  !this.formTitle = 'Create Handrail'
  -- show panel
  !this.showPanel(!this.handrailPane)


endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      setHandrailPaneGadgets
--
-- Description: set active/visible status of gadgets of create/modify handrail panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     create status (create = true,  modify = false)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setHandrailPaneGadgets(!createStatus is BOOLEAN)

  -- init
  !modifyStatus = !createStatus.not()

  -- set active status of rail spacing gadget
  !this.railSpacingSetactive()

  -- set visibility of executable buttons
  !this.createHandrailIcon.visible = !createStatus
  !this.createHandrail.visible = !createStatus
  !this.acceptHandrailIcon.visible = !modifyStatus
  !this.acceptHandrail.visible = !modifyStatus
  !this.discardHandrailIcon.visible = !modifyStatus
  !this.discardHandrail.visible = !modifyStatus

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      railSpacingSetactive
--
-- Description: set active status of associated gadgets to rail spacing container
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .railSpacingSetactive()

  -- get editable status from rail spacing gadget
  !railSpacingEditable = !this.handrail.railSpacingEditable
  !this.railSpacing.setEditable(!railSpacingEditable)
  !this.railSpacingApply.active = !railSpacingEditable
  handle ANY
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      shiftOffset
--
-- Description: shift offset inclination
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shiftOffset()

  !this.handrail.shiftOffset()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      gatePane
--
-- Description: Show panel for gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------


define method .gatePane(!callingPanel is GADGET)

  if !callingPanel.eq(!this.mainPane) then
    !tag       = 'Back to Main Handrail Tasks'
    !callback  = '!this.mainPane()'
    !accept    = '!this.acceptHandrail()'
    !discard   = '!this.discardHandrail()'
    !handraObj =  object ASLHANDRAIL(handra)
    !this.handrail(!handraObj)
  elseif !callingPanel.eq(!this.handrailPane) then
    if !this.createHandrail.visible then
    -- calling handrail panel is in create mode
      !tag      = 'Back to Create Handrail'
      !callback = '!this.gatePaneToCreateHandrail()'
      !accept  = '!this.acceptGates()'
    else
    -- calling panel is in modify mode
      !tag      = 'Back to Modify Handrail'
      !callback = '!this.gatePaneToModifyHandrail()'
      !accept = '!this.acceptHandrail()'
    endif
    -- make temporary copy of handrail object
    !this.tmpHandrail = !this.handrail
    !discard = '!this.discardGates()'
  endif

  -- set accept/discard buttons
  !this.acceptGates.callback  = !accept
  !this.discardGates.callback = !discard

  -- set "Go back" button
  !this.gateBack.tag = !tag
  !this.gateBack.callback = !callback

  -- set form title
  !this.formTitle = 'Handrail Gates'
  -- show panel
  !this.showPanel(!this.gatePane)

  -- draw gate if selected
  !selected = !this.gatesControl.getSelectedRows()
  if defined(!selected[1][1]) then
    !index = !selected[1][1].real()
    !this.drawGate(!index, !this.aidNumber, 1, 350mm)
  else
    !this.gatesControl.selectRow(1)
    !this.posGate.active = defined(!this.gatesControl.getSelectedRows()[1][1])
    !this.remGate.active = defined(!this.gatesControl.getSelectedRows()[1][1])
  endif

  -- handle active status of gate buttons
  !this.addGate.active = !this.handrail.rpath.set()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyHandrailPane
--
-- Description: show main modification panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Handrail to be load into form and modified
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyHandrailPane(!handrail is DBREF)

  -- remove EDG packet from stack first
  !!edgCntrl.remove(!this.edgDescription)

  -- clear aid graphic
  !!aidNumbers.hide(!this.aidNumber)

  -- load handrail if isn't nulref
  if !handrail.set() then
    !handraObj =  object ASLHANDRAIL(!handrail)
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle
    !this.handrail(!handraObj)
    !this.handrailOwner = !this.handrail.refe.owner
  endif

  -- set gadgets
  !this.setHandrailPaneGadgets(false)

  -- set form title
  !this.formTitle = 'Modify Handrail'
  -- show panel
  !this.showPanel(!this.handrailPane)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyHandrailPane
--
-- Description: show main modification panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLHANDRAIL Handrail object to be load into form and modified
--    2   R      DBREF       Handrail owner
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyHandrailPane(!handrail is ASLHANDRAIL,!owner is DBREF)

  -- remove EDG packet from stack first
  !!edgCntrl.remove(!this.edgDescription)

  -- clear aid graphic
  !!aidNumbers.hide(!this.aidNumber)

  !this.handrail(!handrail)
  !this.handrailOwner = !owner

  -- set gadgets
  !this.setHandrailPaneGadgets(false)

  -- set form title
  !this.formTitle = 'Modify Handrail'
  -- show panel
  !this.showPanel(!this.handrailPane)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      GeomPane
--
-- Description: Show panel for geometry definition
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geomPane(!callingPanel is GADGET)

  if !callingPanel.eq(!this.mainPane) then
    !tag = 'Back to Main Handrail Tasks'
    !callback = '!this.mainPane()'
    !accept    = '!this.acceptHandrail()'
    !handraObj =  object ASLHANDRAIL(handra)
    !this.handrail(!handraObj)
  elseif !callingPanel.eq(!this.handrailPane) then
    if !this.createHandrail.visible then
    -- calling handrail panel was in create mode
      !tag = 'Back to Create Handrail'
      !callback = '!this.geomPaneToCreateHandrail()'
      !accept = '!this.acceptGeom()'
    else
    -- calling panel was in modify mode
      !tag = 'Back to Modify Handrail'
      !callback = '!this.geomPaneToModifyHandrail()'
      !accept = '!this.acceptHandrail()'
    endif
    -- make temporary copy of handrail object
    !this.tmpHandrail = !this.handrail
  endif

  -- set accept/discard buttons
  !this.acceptGeom.callback  = !accept
  !this.discardGeom.callback = '!this.discardGeom()'

  -- set "Go back" button
  !this.geomBack.tag = !tag
  !this.geomBack.callback = !callback

  -- set form title
  !this.formTitle = 'Handrail Geometry'
  -- show panel
  !this.showPanel(!this.geomPane)

  -- set current vertex to last point
  !this.currentVertex = !this.handrail.lastVertex()

  -- set buttons active status and update current vertex indicator
  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      geomPaneButtons
--
-- Description: handle activity status of buttons of geomPane
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geomPaneButtons()

  if !this.geomPane.visible.not() then
    return
  endif

  !active = !this.vertex().size().boolean()
  !ownermemb = !this.handrailOwner.memb

  !this.copyOwnerPath.active = !ownermemb.evaluate(object BLOCK('!ownermemb[!evalindex].type')).find('RPATH').set().and(!this.handrailOwner.type.neq('STRFLT'))
  !this.copyPath.active = true
  !this.geomDefine.active = true
  !this.moveCurrentVertex.active = !active
  !this.removeCurrentVertex.active = !active
  !this.selectCurrentVertex.active = !active
  !this.removeGeom.active = !active
  !this.removeVertices.active = !active
  !this.geomExtend.active = !active.and(!this.handrail.closeFlag().not())

  aid clear text $!this.aidNumber
  handle ANY
  endhandle
  if !this.currentVertex.boolean().and(!this.vertex().size().boolean()) then
  -- indicate last point
    !pos = !this.vertex()[!this.currentVertex]
    handle ANY
      !this.currentVertex = !this.handrail.lastVertex()
      if !this.currentVertex.boolean() then
        !pos = !this.vertex()[!this.currentVertex]
      endif
    elsehandle NONE
      if !this.handrail.vertexIsGate(!this.currentVertex) then
        !this.currentVertex = !this.handrail.lastVertex()
        !pos = !this.vertex()[!this.currentVertex]
      endif
    endhandle
    if defined(!pos) then
      !!drawAidText('Current Vertex',!pos,!this.aidNumber)
      handle ANY
      endhandle
    endif

    -- indicate next point
    do !c from !this.currentVertex
      !next = !this.rpath().nextPointOf(!c)
      break if !next.eq(1)
      if !this.handrail.vertexIsGate(!next).not() then
        break
      endif
    enddo
    if !next.lt(!this.currentVertex) then
      if !this.handrail.closeFlag() then
        !nextpos = !this.vertex()[!next]
      endif
    elseif !next.gt(!this.currentVertex) then
      !nextpos = !this.vertex()[!next]
    endif
    if defined(!nextpos) then
      !!drawAidText('Next',!nextpos,!this.aidNumber)
      handle ANY
      endhandle
    endif
  else
    !this.currentVertex = 0
  endif

  -- set shift toggle button
  !this.shiftOffset.val = !this.handrail.xoffset.lt(0)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      mainPane
--
-- Description: show main panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainPane()

  !panel = !this.visiblePane()
  if !panel.set() then
  !checkedPanels[1] = !this.geomPane
  !checkedPanels.append(!this.gatePane)
  !checkedPanels.append(!this.handrailPane)
    if !checkedPanels.find(!this.handrailPane).set() then
      if !this.handrail.neq(!this.savedHandrail) then
        if !!alert.confirm('O.K. to go back? Changes you have made will be lost!').boolean().not() then
          return
        endif
      endif
    endif
  endif

  !this.showPanel(!this.mainPane)
  !this.formTitle = 'Main Handrail Tasks'

  -- tidy up
  -- un register handrail object from aid numbers
  !this.handrail.remFromAidNumbers()
  -- remove edg packet from stack
  !!edgCntrl.remove(!this.edgDescription)
  -- clear aid graphic
  !!aidNumbers.hide(!this.aidNumber)

  -- run db tracking method
  !this.trackDb()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showPane
--
-- Description: make passed panel visible and discard the others
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Panel to be displayed
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showPanel(!panel is GADGET)

   -- make panels invisible
   do !onepanel values !this.panels
     skip if !onepanel.eq(!panel)
     !onepanel.visible = false
   enddo

   -- make passed panel visible
   !panel.visible = true

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      handrail
--
-- Description: assign ASLHANDRAIL object to the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW]        [Data Type]   [Description]
--    1   RW            ASLHANDRAIL   handrail object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .handrail(!handrail is ASLHANDRAIL)

  !handrail.autoDrawOn()

  -- undo callback must be declared in fullname format (not using !this shortcut) as it will be called externally
  !handrail.undoCall('!!aslHandra.undo(''$!handrail.refe'')')

  !this.handrail = !handrail
  !this.handrail.addToAidNumbers()

  -- populate gadgets with object values
  !this.setGadgets()

  -- store copy of handrail object
  !this.savedHandrail = !this.handrail
  !this.tmpHandrail = !this.handrail

  -- draw handrail
  !this.handrail.autoDraw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setGadgets
--
-- Description: populate gadgets with the handrail object values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setGadgets()

  !this.handrail.setGadget('postspacinggadget',!this.postSpacing)
  !this.handrail.setGadget('endspacinggadget',!this.endSpacing)
  !this.handrail.setGadget('tangentspacinggadget',!this.tangentSpacing)
  !this.handrail.setGadget('closeflaggadget',!this.closeFlag)
  !this.handrail.setGadget('railspacinggadget',!this.railSpacing)
  !this.handrail.setGadget('gatesgadget',!this.gates,'gatesControl')
  !this.handrail.setGadget('radiusgadget',!this.radius)
  !this.handrail.setGadget('namegadget',!this.name)
  !this.handrail.setGadget('descriptiongadget',!this.desc)
  !this.handrail.setGadget('numbergadget',!this.number)
  !this.handrail.setGadget('areagadget',!this.area)

  !this.templates = !this.handrail.setTmplrefGadget(!this.tmplReference)

  !this.terminationTmpl = !this.handrail.setTerminationGadgets(!this.terminationStart,!this.terminationEnd)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteHandrail
--
-- Description: delete handrail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteHandrail()


  -- check if you are at HANDRA element or below
  !!ce = HANDRA
  handle ANY
    !!alert.warning('Not below HANDRA hierarchy')
    return
  endhandle

  call !!aslEnhance(!!ce)
  if ( !!alert.confirm('Do you really want to delete the current handrail?').eq('NO') ) then
    call !!aslUnEnhance(!!ce)
    return
  endif

  !undo = object UNDOABLE()
  !undo.description('Delete Handrail')
  -- undo callback must be declared in fullname format (not using !this shortcut) as it will be called externally
  !undoCall = '!!aslHandra.undo(''$!!ce'')'
  !undo.undoaction(!undoCall)
  !undo.redoaction(!undoCall)
  !undo.add()

  DELETE HANDRA

  !undo.endundoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      RailSpacing
--
-- Description: callback of rail spacing container
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .railSpacing()

  !val = !this.railSpacing.val
  !spacing = ARRAY()
  if !val.objectType().eq('ARRAY') then
    !strSpaces = !val
  else
    if !val.match(';').boolean() then
      !delim = ';'
    else
      !delim = ' '
    endif
    -- sort out single value
    !val.real(!!distanceFmt)
    handle NONE
      !strSpaces[1] = !val
    elsehandle ANY
      !strSpaces = !val.split(!delim)
    endhandle
  endif

  do !space values !strSpaces
    !tmpreal = !space.real(!!distanceFmt)
    handle ANY
      skip
    endhandle
    skip if !tmpreal.unset()
    !spacing.append(!tmpreal)
  enddo

  !this.handrail.railSpacing(!spacing)
  handle ANY
    !!alert.error(!!error.text)
  endhandle


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      radius
--
-- Description: callback of radius text gadget (sets the handrail bend radius)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .radius()

  !this.handrail.radius(!this.radius.val)
    handle ANY
      !!alert.error(!!error.text)
    endhandle

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      closeFlag
--
-- Description: callback of related toggle
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .closeFlag()

  !closed = !this.closeFlag.val

  -- send data to object
  !this.handrail.closeFlag(!closed)

  -- update form
  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      area
--
-- Description: set area attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      gadget running this method
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .area(!numinput is GADGET,!dummy is STRING)

  !val = !numinput.val

  !this.handrail.area(!val)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      number
--
-- Description: set number attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      gadget running this method
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .number(!numinput is GADGET,!dummy is STRING)

  !val = !numinput.val

  !this.handrail.number(!val)
  handle ANY
    !!alert.error(!!error.text)
  endhandle


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      description
--
-- Description: set description attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .description()

  !this.handrail.description(!this.desc.val)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setName
--
-- Description: set the HR name
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setName()

  !this.handrail.name(!this.name.val)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gates
--
-- Description: callback of gates container
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gates(!array is ARRAY)

  -- init
  !width = ARRAY()
  !pos = ARRAY()
  !currWidth = ARRAY()
  !currPos = ARRAY()

  !widthCol = !this.gatesControl.getColumn(2)
  !posCol   = !this.gatesControl.getColumn(3)
  !gates = !this.handrail.gates

  !widthIndex = ARRAY()
  !posIndex = ARRAY()
  -- evaluate obtained data
  !rows = !this.gatesControl.getNumberRows()

  do !c from 1 to !rows
    !currWidth[!c] = !gates[!c].width
    !currPos[!c] = !this.handrail.gatePosition(!c)
    !width[!c] = !this.stringToDistance(!widthCol[!c]).abs()
    handle ANY
      !width[!c] = 0
    endhandle
    !pos[!c] = !posCol[!c].position(!!distanceFmt)
    handle ANY
      !pos[!c] = object POSITION()
    endhandle
    if !width[!c].eq(0) then
      !width[!c] = !currWidth[!c]
      !this.gatesControl.setCellValue(!c,2,!width[!c].string(!!distanceFmt))
    endif
    if !pos[!c].unset() then
      !pos[!c] = !currPos[!c]
      !strPos = !pos[!c].string().before(' WRT /*')
      !this.gatesControl.setCellValue(!c,3,!strPos)
    endif
    if !pos[!c].neq(!currPos[!c]) then
      !posIndex.append(!c)
    endif
    if !width[!c].neq(!currWidth[!c]) then
      !widthIndex.append(!c)
    endif
  enddo


  do !c values !widthIndex
    !this.handrail.gateWidth(!c,!width[!c])
    handle ANY
      !!alert.error(!!error.text)
      !this.gatesControl.setCellValue(!c,2,!currWidth[!c].string())
    endhandle
    !this.gatesControl.selectRow(!c)
  enddo

  do !c values !posIndex
    !this.handrail.gatePosition(!c,!pos[!c])
    handle ANY
      !!alert.error(!!error.text)
      !this.gatesControl.setCellValue(!c,3,!currPos[!c].string().before(' WRT /*'))
    endhandle
    !this.gatesControl.selectRow(!c)
  enddo

  refresh

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      stringToDistance
--
-- Description: convert distance in string to real in current units
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      string to be converted, e.g. '100 mm' or '15in'
--
-- Return:
--   [Data Type] [Description]
--    REAL        converted value in current distance unit
--
------------------------------------------------------------------------

define method .stringToDistance(!stringDist is STRING) is REAL

  !realDist = !stringDist.real(!!distanceFmt)
  handle ANY
    return error 1 'Error conversion STRING to REAL'
  endhandle

  return !realDist

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      selectGate
--
-- Description: callback on selection of gates container gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectGate(!array is ARRAY)

  !!aidNumbers.hide(!this.aidNumber)
  -- exit if no selection
  if !array.unset() then
    !this.remGate.active = false
    !this.posGate.active = false
    return
  endif

  !this.remGate.active = true
  !this.posGate.active = true

  -- update rpath segments to speed up drawing of the handrail
  !this.handrail.rpath.segment(!this.handrail.closeFlag())
  -- draw gate
  !number = !this.aidNumber
  !index = !array[0][1].real()
  !this.drawGate(!index, !number, 1, 350mm)

  refresh

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:       postSpacing
--
-- Description:  callback performed on post spacing gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      gadget to extract data from
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .postSpacing(!gadget is GADGET)

  !attr = !gadget.name()
  !value = !gadget.val

  !this.handrail.postSpacing(!attr,!value)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      termination
--
-- Description: set termination template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      gadget to extract data from
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .termination(!gadget is GADGET)

  !val = !gadget.val

  if !gadget.name().eq('TERMINATIONSTART') then
    !end = 'START'
  else
    !end = 'END'
  endif

  !type = 'DETAIL'
  if !val.eq(1) then
    !type = 'NONE'
  elseif !val.eq(2) then
    !type = 'POST'
  endif

  !tmpl = !this.terminationTmpl[!val]

  !this.handrail.terminationTmpl(!end,!tmpl,!type)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createHandrail
--
-- Description: create handrail and show modify panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createHandrail()

  -- navigate to proper db position
  !!ce = !this.handrailOwner

  -- get new handrail refno for undo callback argument
  new HANDRA
  !this.handrail.refe = !!ce
  !this.handrail.undoCall = !this.handrail.undoCall.replace('Unset',!!ce.string())
  delete HANDRA

  -- create handrail
  !this.acceptHandrail()

  -- show modify panel
  !this.modifyHandrailPane(nulref)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      acceptHandrail
--
-- Description: update handrail db element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .acceptHandrail()

  -- store current element
  !oldCE = !!ce
  if !this.handrail.refe.badref() then
    !oldCE = nulref
  endif

  -- create handrail
  !handrail = !this.handrail.updateDb()

  -- update backup objects
  !this.savedHandrail = !this.handrail
  !this.tmpHandrail = !this.handrail

  if !oldCE.badref() then
  -- jump to handrail
    !!ce =!handrail
  else
  -- jump to old CE
    !!ce =!oldCE
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      discardHandrail
--
-- Description: discard changes and reset form to previously saved status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .discardHandrail()

  if !this.handrail.eq(!this.savedHandrail) then
  -- no changes have been made
    return
  endif

  !this.handrail = !this.savedHandrail

  -- populate gadgets
  !this.setGadgets()

  -- handle railspacing gadgets active status
  !this.railSpacingSetactive()

  !this.handrail.autoDraw()


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      acceptGates
--
-- Description: accept changes made from gate modification panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .acceptGates()

  !this.tmpHandrail = !this.handrail

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      discardGates
--
-- Description: discard changes made from gate mod. panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .discardGates()

  if !this.handrail.eq(!this.tmpHandrail) then
  -- no changes have been made
    return
  endif

  !this.handrail = !this.tmpHandrail

  -- populate gadget
  !this.handrail.gatesGadget()

  !this.posGate.active = false
  !this.remGate.active = false

  !this.handrail.autoDraw()

  if defined(!this.handrail.gates[1]) then
    !this.gatesControl.selectRow(1)
  endif

  -- update gate container
  !this.handrail.gatesGadget()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      acceptGeom
--
-- Description: accept changes made from geometry modification panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .acceptGeom()

  !this.tmpHandrail = !this.handrail

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      discardGeom
--
-- Description: discard changes made from geometry panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .discardGeom()

  if !this.handrail.eq(!this.tmpHandrail) then
  -- no changes has been made
    return
  endif

  !this.handrail = !this.tmpHandrail

  !this.handrail.autoDraw()

  -- update close flag toggle
  !this.closeFlag.val = !this.handrail.closeFlag

  -- set current vertex to last point
  !this.currentVertex = !this.vertex().size()
  !this.geomPaneButtons()

  -- update gate container
  !this.handrail.gatesGadget()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gatePaneToModifyHandrail
--
-- Description: exit gate panel and return back to modify handrail panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gatePaneToModifyHandrail()

  if !this.handrail.neq(!this.tmpHandrail) then
  -- ask user to confirm
    if !!alert.confirm('O.K. to go back? Changes you have made will be lost!').boolean().not() then
      return
    endif
  endif

  !this.discardGates()

  !this.modifyHandrailPane(nulref)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gatePaneToCreateHandrail
--
-- Description: exit gate panel and return back to create handrail panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gatePaneToCreateHandrail()

  if !this.handrail.neq(!this.tmpHandrail) then
  -- ask user to confirm
    if !!alert.confirm('O.K. to go back? Changes you have made will be lost!').boolean().not() then
      return
    endif
  endif

  !this.discardGates()

  !this.createHandrailPane('show')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      geomPaneToModifyHandrail
--
-- Description: exit modify geometry panel and return back to modify handrail panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geomPaneToModifyHandrail()

  if !this.handrail.neq(!this.tmpHandrail) then
  -- ask user to confirm
    if !!alert.confirm('O.K. to go back? Changes you have made will be lost!').boolean().not() then
      return
    endif
  endif

  !this.discardGeom()

  !this.modifyHandrailPane(nulref)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      geomPaneToCreateHandrail
--
-- Description: exit modify geometry panel and return back to create handrail panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .geomPaneToCreateHandrail()

  if !this.handrail.neq(!this.tmpHandrail) then
  -- ask user to confirm
    if !!alert.confirm('O.K. to go back? Changes you have made will be lost!').boolean().not() then
      return
    endif
  endif

  !this.discardGeom()

  !this.createHandrailPane('show')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tmplReference
--
-- Description: callback of .tmplReference option gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmplReference()

  !tmpl = !this.templates[!this.tmplReference.val]

  !this.handrail.tmplReference(!tmpl)
  !this.terminationTmpl = !this.handrail.setTerminationGadgets(!this.terminationStart,!this.terminationEnd)

  !this.railSpacingApply.active = !this.handrail.railSpacingEditable
  handle ANY
  endhandle

  !fmt = !!distanceFmt
  !fmt.label = 'UNITS'

  -- set tooltips
  !criteria = !this.handrail.criteria
  !min = !criteria.postSpacing.min().string(!fmt)
  !max = !criteria.postSpacing.max().string(!fmt)
  !this.postSpacing.settooltip('Min: ' & !min & '  Max: ' &!max)
  !min = !criteria.tangentSpacing.min().string(!fmt)
  !max = !criteria.tangentSpacing.max().string(!fmt)
  !this.tangentSpacing.settooltip('Min: ' & !min & '  Max: ' &!max)
  !min = !criteria.endSpacing.min().string(!fmt)
  !max = !criteria.endSpacing.max().string(!fmt)
  !this.endSpacing.settooltip('Min: ' & !min & '  Max: ' &!max)
  !min = !criteria.bradius.min().string(!fmt)
  !max = !criteria.bradius.max().string(!fmt)
  !this.radius.settooltip('Min: ' & !min & '  Max: ' &!max)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      addGate
--
-- Description: Invoke edg mode to add gate to handrail object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addGate()

  -- check if geometry already defined
  if !this.handrail.rpath.unset() then
    return
  endif

  -- Initialise Variables for EDG
  !prompt               = 'Pick position to insert GATE'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.action        = !this.fullname() & '.addGate(!this.return[1])'
  !packet.close         = !this.fullname() & '.posGate.active = true ' & !this.fullname() & '.addGate.active = true'
  !packet.priority      = 1
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdPosition(!prompt)
  !packet.pickPacket = !pickPacket

  -- inactive gate buttons
  !this.posGate.active = false
  !this.addGate.active = false

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addGate
--
-- Description: add gate to handrail object at position obtained from picked data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]        [Description]
--    1   R      EDGPOSITIONDATA    position data from edg pick
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addGate(!edgData is EDGPOSITIONDATA)

  -- get position from edg pick
  !pickedpos = !edgData.position
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !gate = !this.handrail.insertGate(!pickedpos)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !this.gatesControl.selectRow(!gate.sequ)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      gatePosition
--
-- Description: invoke edg mode to pick new position of the gate
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gatePosition()

  !selected = !this.gatesControl.getSelectedRows()
  if undefined(!selected[1][1]) then
    return
  endif

  -- Initialise Variables for EDG
  !prompt               = 'Pick position to move GATE to'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = !this.fullname() & '.gatePosition(!this.return[1])'
  !packet.close         = !this.fullname() & '.setActive(true)'
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdPosition(!prompt)
  !packet.pickPacket = !pickPacket

  -- make all gadgets inactive
  !this.setActive(false)

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gatePosition
--
-- Description: move gate to the new position snapped onto handrail boundary edge
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      EDGPOSITIONDATA     position data from EDG pick
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gatePosition(!edgData is EDGPOSITIONDATA)

  !selected = !this.gatesControl.getSelectedRows()
  if undefined(!selected[1][1]) then
    return
  endif

  -- get position from edg pick
  !pickedpos = !edgData.position
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  -- get gate index
  !index = !selected[1][1].real()

  -- move gate to new position
  !this.handrail.gatePosition(!index,!pickedpos)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  -- select gate
  !this.gatesControl.selectRow(!index)
  handle ANY
  endhandle

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      remGate
--
-- Description: remove gate from handrail object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remGate()

  !selected = !this.gatesControl.getSelectedRows()
  if undefined(!selected[1][1]) then
    return
  endif

  -- ask user for confirmation
  if !!alert.confirm('O.K. to remove selected GATE?').boolean().not() then
    return
  endif

  -- tidy up aid graphic
  !!aidNumbers.hide(!this.aidNumber)

  -- get gate index
  !index = !selected[1][1].real()

  -- remove selected row - multiple selection is not supported!
  !this.gatesControl.deleteSelectedRows()

  -- remove gate
  !this.handrail.removeGate(!index)

  !rows = !this.gatesControl.getNumberRows()
  if !index.gt(!rows) then
    !index = !rows
  endif
  -- select gate of previous index
  !this.gatesControl.selectRow(!index)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      trackDb
--
-- Description: method to control active status of main panel buttons
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .trackDb()

  if !this.mainPane.visible.not() then
    return
  endif

  !owner = !!aslStoreTable.getStore('handrail')
  handle ANY
    !owner = nulref
  endhandle

  if !owner.badref() then
  !owner = !this.getHandrailOwnerFrom(!!ce)
  endif

  !crActive = !owner.set()
  !handrail = !this.getHandrailAbove(!!ce)
  !active = !handrail.set()

  if !active then
    !open = !handrail.closeFlag.not()
  else
    !open = false
  endif

  !gateActive = !active
  if !gateActive then
    !gateActive = !this.handrail.collection('HRGATE',!handrail).set()
  endif

  !this.mainCreateHandra.active = !crActive
  !this.mainCreateGate.active   = !active
  !this.mainModifyHandra.active = !active
  !this.mainModifyGate.active   = !active
  !this.mainModifyGeom.active   = !active
  !this.split.active            = !active
  !this.merge.active            = !open
  !this.splitRail.active        = !active
  !this.mainExtend.active       = !active
  !this.mainDeleteHandra.active = !active
  !this.mainDeleteGate.active = !gateActive

  !this.handrailOwner = !owner

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawGates
--
-- Description: draw and mark gates for edg pick in aids colour
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        aid number
--    2   R      REAL        line style (1 continues, 2 dashed, 3 dotted, 4 chained )
--    3   R      REAL        diameter (mm) of sphere to be drawn at gate position
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawGates(!number is REAL, !lineStyle is REAL, !diameter is REAL)

  -- init
  !col = !!gphColOpt.aids.code

  -- update rpath segments
  !this.handrail.rpath.segment(!this.handrail.closeFlag())

  do !c indices !this.handrail.gates
    !this.drawGate(!c,!number,!lineStyle,!diameter)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawGate
--
-- Description: draw and mark gate with passed index for edg pick in aids colour
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        gate index
--    2   R      REAL        aid number
--    3   R      REAL        line style (1 continues, 2 dashed, 3 dotted, 4 chained )
--    4   R      REAL        diameter (mm) of sphere to be drawn at gate position
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawGate(!index is REAL, !number is REAL, !lineStyle is REAL, !diameter is REAL)

  !col = !!gphColOpt.aids.code

  !gate = !this.handrail.gates[!index]
  !pos = !this.handrail.gatePosition(!index)
  !!drawAidSphere(!diameter, !pos, !number)
  !!drawAidText('GATE ' & !index, !pos, !number)
  if !this.handrail.drawGates.not() then
    !gate.draw(!this.handrail,!number,!lineStyle,!col)
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      edgDeleteGateInit
--
-- Description: invoke edg mode to pick the gate (aid sphere) to be deleted
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgDeleteGateInit()

  -- init handrail object
  !handrail = object ASLHANDRAIL(handra)
  if !handrail.gates.unset() then
    !!alert.error('There is no GATE to delete')
    return
  endif
  -- undo callback must be declared in fullname format (not using !this shortcut) as it will be called externally
  !handrail.undoCall('!!aslHandra.undo(''$!handrail.refe'')')

  !this.handrail = !handrail
  !this.handrail.autoUpdateDb = true
  !col = !!gphColOpt.aids
  !number = !this.aidNumber

  -- draw gates as aid spheres
  !this.drawGates(!number, 1, 500mm)

  -- Initialise Variables for EDG
  --!prompt               = 'Pick GATE (SPHERE in ' & !col.name.upcase() & ' colour) to delete'
  !prompt               = 'Pick GATE to delete'
  !packet               = object EDGPACKET()
  !packet.aidpick(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = !this.fullname() & '.edgDeleteGate(!this.return[1])'
  !packet.close         = '!!aidNumbers.hide(' & !number & ') ' & !this.fullname() & '.setActive(true)'
  !packet.pickPacket.picks[1].prompt = ''

  -- make all gadgets inactive
  !this.setActive(false)

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      edgDeleteGate
--
-- Description: pick gate (aid sphere) to delete
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      EDGPICKDATA   picked gate - aid sphere
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgDeleteGate(!edgData is EDGPICKDATA)

  -- extract picked data
  !type = !edgData.aidType
  !number = !edgData.point

  -- check picked data
  !col = !!gphColOpt.aids
  if !type.eq('SPHERE').and(!number.eq(!this.aidNumber)).not() then
    !!alert.error('Pick a SPHERE to select a GATE!')
    return
  endif

  !lineofpick =!edgData.pickLine.line(1000)

  -- compose array of distances between line of pick and position of all gates
  !gates = !this.handrail.gates
  !distance = ARRAY()
  !gatePosition = ARRAY()
  do !c indices !gates
    !pos = !this.handrail.gatePosition(!c)
    !dist = !lineofpick.distance(!pos)
    !gatePosition.append(!pos)
    !distance.append(!dist)
  enddo

  -- get picked gate index and position
  !index = !distance.sortedIndices().first()
  !gate = !gates[!index]
  !gateId = 'GATE ' & !index

  -- remove aid graphic and redraw the selected gate only in highlight colour
  !!aidNumbers.hide(!this.aidNumber)
  !aidcol = !!gphColOpt.aids.code
  !!gphColOpt.aids(!!gphColOpt.highlight.code)
  !this.drawGate(!index,!this.aidNumber, 1, 500mm)

  -- ask user to confirm
  if !!alert.confirm('O.K. to delete $!<gateId> ?').boolean() then
    -- delete picked gate
    !this.handrail.removeGate(!index)
    handle ANY
      !!alert.error(!!error.text)
    endhandle
  endif

  -- reset aid colour back
  !!gphColOpt.aids(!aidcol)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawVertices
--
-- Description: draw vertices
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        aid number
--    2   R      REAL        sphere diameter
--    3   R      ANY         DBREF (of type RPATH) or ASLRPATH
--    4   R      BOOLEAN     edges between vertices to be drawn or not
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of arrays with full vertex definition (position,type, sequence )
--
------------------------------------------------------------------------

define method .drawVertices(!number is REAL,!diam is REAL,!rpath is ANY,!drawEdges is BOOLEAN) is ARRAY


  if !rpath.objectType().eq('DBREF') then
    if !rpath.badref() then
      return error 1 'Invalid reference'
    endif
    !allowedTypes = 'RPATH SPINE PLOO LOOP'
    if !allowedTypes.match(!rpath.type).eq(0) then
      return error 2 'Invalid element type'
    endif
    !pathObj = object ASLRPATH(!rpath,'load')
    !memb = !pathObj.refe
  elseif !rpath.objectType().eq('ASLRPATH') then
    !pathObj = !rpath
  endif

  -- get sequence numbers (avoid CURVEs)
  !vertex = !pathObj.vertex
  !type   = !pathObj.type
  !countPointr = 0
  !countCurve = 0
  !sequ = ARRAY()
  !dispSequ = ARRAY()

  do !anyType values !type
    if !anyType.eq('CURVE') then
      !countCurve = !countCurve + 1
      !sequ.append(!countCurve)
    else
      !countPointr = !countPointr + 1
      !sequ.append(!countPointr)
    endif
  enddo

  if !vertex.unset() then
    return error 3 'No vertex to draw'
  endif


  if !drawEdges then
    !edges = !pathObj.edges(true)
    do !edge values !edges
      if !edge.objectType().eq('LINE') then
        !edge.draw(!number,1,!!gphColOpt.aids.code)
      endif
    enddo
  endif

  !pointSequ = 0
  do !c indices !vertex
    !pointPos =  !vertex[!c]
    !pointType = !type[!c]
    skip if !pointType.eq('CURVE')
    skip if !pathObj.eq(!this.rpath()).and(!this.handrail.vertexIsGate(!c))
    !pointSequ = !pointSequ + 1
    !dispSequ[!c] = !pointSequ.string()
    !!drawAidSphere(!diam, !pointPos, !number)
    !!drawAidText(!pointSequ.string(), !pointPos, !number)
  enddo

  -- compose return array and return it
  !result[1] = !vertex
  !result[2] = !type
  !result[3] = !sequ
  if defined(!memb) then
    !result[4] = !memb
  endif
  !result[5] = !dispSequ

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawEdges
--
-- Description: draw handrail edges as aid cylinder
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        aid cylinder diameter
--    1   R      BOOLEAN     enable/disable the drawing of curved segments
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       return segment data
--
------------------------------------------------------------------------

define method .drawEdges(!diam is REAL,!drawCurvedEdges is BOOLEAN) is ARRAY

  -- init
  !segment = !this.handrail.rpath.facetEdges(!this.handrail.closeFlag())

  do !c indices !segment
    if !segment[!c].unset() then
      !segment[!c].delete()
      skip
    endif
    if !this.handrail.vertexIsGate(!c) then
      !segment[!c].delete()
      skip
    endif
    if !drawCurvedEdges.not().and(!this.rpath().endOfCurve(!c,'start')) then
      !segment[!c].delete()
      skip
    endif
    if !segment[!c].size().eq(1) then
      !tmpLine = !segment[!c][1]
      do !incr from 1
        !next = !c + !incr
        !isGate = !this.handrail.vertexIsGate(!next)
        handle ANY
          break
        endhandle
        if !isGate then
          !tmpLine = !tmpLine.union(!segment[!next][1])
          handle ANY
          endhandle
        else
          break
        endif
      enddo
      !segment[!c][1] = !tmpLine
    endif
  enddo

  -- draw lines as cyli
  do !tmpsegm values !segment
    do !drawLine values !tmpsegm
      !this.drawLineAsCyli(!drawLine,!this.aidNumber,!diam)
    enddo
  enddo

  return !segment

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      defineGeom
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineGeom()

  if !this.vertex().maxIndex().eq(0) then
    !prompt = 'Pick position/line to define start VERTEX'
  else
    !prompt = 'Pick position/line to insert new VERTEX or SEGMENT after current vertex'
  endif

  -- Initialise Variables for EDG
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.action        = !this.fullname() & '.defineGeom(!this.return[1])'
--  !packet.action        = '!!pick = !this.return[1]'
  !packet.close         = !this.fullname() & '.defineGeomClose()'
  !packet.priority      = 1
  !packet.type          = 'defineGeom'
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdPosition(!prompt)
  !packet.pickPacket = !pickPacket

  -- make toggles active
  !this.geomDefineParam.active = true

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      defineGeomClose
--
-- Description: close EDG session for define geometry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineGeomClose()

  !this.geomPaneButtons()
  !this.geomDefineParam.active = false

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      defineGeom
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defineGeom(!edgData is EDGPOSITIONDATA)

  -- read edg data
  !item = !edgData.item
  !pickedpos = !edgData.position
  !pickedline = !edgData.line
  !point = !edgData.ppoint
  !type = !edgData.originalType
  !itemOwner = nulref

  !useLine = !this.useLine.val

  -- avoid if handrail itself has been picked
  if !this.getHandrailAbove(!item).eq(!this.handrail.refe).and(!this.handrail.refe.badref().not()) then
    return
  endif

  -- avoid aid graphic that belongs to the handrail object
  if !point.eq(!this.handrail.aidNumber) then
    return
  endif

  -- avoid PINs and AXES
  if !type.eq('PIN').or(!type.eq('AXES')) then
    return
  endif

  -- check if stair has been picked
  if !item.badref().not() then
    !itemOwner = !!dtbGetOwnerType(!item,'PLTFRM STRLNG')
    !ownls = !item.ownls
    !ownls.append(!item)
    !otyp  = !item.ahlis
    !otyp.append(!item.type)
    !indx = !otyp.findfirst('STRFLT')
    if !indx.set() then
      !answer = !!alert.question('The stairs have been picked! Do you want handrail to be made along the stairs?')
      if !answer.eq('CANCEL') then
        return
      endif
      if !answer.boolean() then
        !stair = !ownls[!indx]
      endif
    endif
  endif

  if defined(!stair) then
    !appendix = !this.trackStairs(!item,!pickedpos)
    if !appendix.unset() then
      !!alert.error(!!error.text)
      return
    endif
    !lastpos = !appendix[1].last()
  else
    if !pickedline.set() then
      if !useLine then
        !appendix = !pickedline
        !lastpos = !pickedline.endposition
      else
        !appendix = !pickedpos
      !lastpos = !appendix
      endif
    else
      !appendix = !pickedpos
      !lastpos = !appendix
    endif
  endif

  if undefined(!appendix) then
    !!alert.error('Invalid pick!')
    return
  endif

  -- apply picked data to handrail
  !newVertex = !this.handrail.insertSegment(!this.currentVertex,!appendix,!itemOwner)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  if !newVertex.unset() then
  -- no vertex has been added so exit without further action
    return
  endif

  -- update current vertex
  !this.currentVertex = !newVertex.maxIndex()

  if !this.vertex().size().eq(1) then
  -- change the prompt
    !!edgCntrl.setPrompt('Pick position/line to insert new VERTEX or SEGMENT after current vertex')
  endif

  !this.geomPaneButtons()


endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      copyPath
--
-- Description: invoke EDG mode to pick START vertex of owner path
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyPath()

  -- Invoke  EDG mode
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove = false
  !packet.action        = !this.fullname() & '.copyPath(!this.return[1])'
  !packet.close         = !this.fullname() & '.copyPathClose()'
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdElement('Pick item to copy routing path from')
  !pickPacket.picks[1].prompt = ''
  !packet.pickPacket = !pickPacket

  -- Add event to system
  !!edgCntrl.add(!packet)

  -- make buttons inactive
  !this.geomDefine.active = false
  !this.copyOwnerPath.active = false
  !this.copyPath.active = false
  !this.moveCurrentVertex.active = false
  !this.removeCurrentVertex.active = false
  !this.selectCurrentVertex.active = false
  !this.removeGeom.active = false
  !this.removeVertices.active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copyOwnerPath
--
-- Description: pick vertex to define handrail geometry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyOwnerPath()

  if !this.handrail.rpath.set() then
    if !!alert.confirm('The existing routing of the handrail will be lost, Yes to continue?').boolean().not() then
      return
    endif
  endif

  !ownerPath = RPATH 1 of $!this.handrailOwner
  !points = !ownerPath.memb

  !this.handrail.loadPoints(!points)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !this.currentVertex = !this.vertex().maxIndex()
  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copyPath
--
-- Description: pick vertex to define handrail geometry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      EDGPICKDATA  result from EDG pick
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyPath(!edgData is EDGPICKDATA)

  !type = !edgData.type
  !aidType = !edgData.aidType
  !number = !edgData.point
  !item = !edgData.item
  !path = nulref

  if !type.eq('ELEMENT').and(!item.badref().not()) then
  -- the very first pick
    -- try to get RPATH at first step
    !owner = !!dtbOwnerOfType(!item,'RPATH')
    if !owner.set() then
      !path = !!dtbMemberOfType(!owner,'RPATH',1)
    else
    -- try to get gensec spine
      !owner = !!dtbOwnerOfType(!item,'SPINE')
      if !owner.set() then
        !path = !!dtbMemberOfType(!owner,'SPINE',1)
      else
      -- try to get panel loop
        !owner = !!dtbOwnerOfType(!item,'PLOO')
        if !owner.set() then
          !path = !!dtbMemberOfType(!owner,'PLOO',1)
        else
        -- try to get extrusion loop
          !owner = !!dtbOwnerOfType(!item,'LOOP')
          if !owner.set() then
            !path = !!dtbMemberOfType(!owner,'LOOP',1)
          endif
        endif
      endif
    endif

    -- check if path has been found
    if !path.unset() then
      return
    endif

    -- avoid stair flight
    if !owner.type.eq('STRFLT') then
      return
    endif

    -- check panel/extru if horizontal
    if !path.type.eq('PLOO').or(!path.type.eq('LOOP')) then
      -- do we actually need it
    endif

    -- exit EDG session
    !!edgCntrl.escape()

    -- invoke vertex picking EDG session
    !this.tmpPath = !this.drawVertices(!this.aidNumber,400mm, !path,false)
    !this.tmpVertex.clear()

    -- Invoke  EDG mode
    !packet               = object EDGPACKET()
    !packet.description   = !this.edgDescription
    !packet.remove = false
    !packet.action        = !this.fullname() & '.copyPath(!this.return[1])'
    !packet.close         = !this.fullname() & '.copyPathClose()'
    !pickPacket = object EDGPICKPACKET()
    !pickPacket.stdAid('Pick start VERTEX')
    !pickPacket.picks[1].prompt = ''
    !packet.pickPacket = !pickPacket

    -- Add event to system
    !!edgCntrl.add(!packet)

    -- make buttons inactive
    !this.geomDefine.active = false
    !this.copyOwnerPath.active = false
    !this.copyPath.active = false
    !this.moveCurrentVertex.active = false
    !this.removeCurrentVertex.active = false
    !this.selectCurrentVertex.active = false
    !this.removeGeom.active = false
    !this.removeVertices.active = false
    return
  endif

  -- ignore invalid picks
  if !number.neq(!this.aidNumber) then
    return
  endif
  if !aidType.eq('SPHERE').or(!aidType.eq('LINE')).not() then
    return
  endif

  !pickLine = !edgData.pickLine.line(100)

  if !aidType.eq('SPHERE') then
    !index = REAL()
    !distance = ARRAY()
    do !c indices !this.tmpPath[1]
      !vrtxPos = !this.tmpPath[1][!c]
      !distance[!c] = !pickLine.distance(!vrtxPos)
    enddo
    !index = !distance.sortedIndices().first()
  elseif !aidType.eq('LINE') then
    !!alert.error('Only VERTEX can be currently picked')
    return
  endif

  -- first pick
  if undefined(!this.tmpVertex[1]) then
    -- store picked vertex
    !this.tmpVertex[1] = !index
    -- indicate selection
    aid clear text $!number
    do !c indices !this.tmpPath[1]
      !pointPos  = !this.tmpPath[1][!c]
      !pointType = !this.tmpPath[2][!c]
      !pointSequ = !this.tmpPath[3][!c]
      skip if !pointType.eq('CURVE')
      !text = !pointSequ.string()
      if !c.eq(!index) then
        !text = !text + ' - Start'
      endif
      !!drawAidText(!text,!pointPos,!number)
    enddo
    --change prompt
    !!edgCntrl.setPrompt('Pick end VERTEX')
    return

  -- second pick
  else
    -- retrieve data from previous pick
    !startVertex = !this.tmpVertex[1]
    !startTxt = !this.tmpPath[5][!startVertex]
    -- get data from this pick
    !endVertex = !index
    !endTxt = !this.tmpPath[5][!index]
    -- then check if points picked are not the same
    if !startVertex.eq(!endVertex) then
      return
    endif
  endif

  -- invert array if points has been picked in reverse order
  !getOverStart = false
  !allPoints = !this.tmpPath[4]
  if !startVertex.gt(!endVertex) then
    if !endVertex.eq(1) then
      !question = 'Do you want to copy points from $!startTxt to $!endTxt (YES) or from $!endTxt to $!startTxt (NO)?'
    else
      !question = 'Do you want to copy points from $!startTxt to $!endTxt backward (YES) or forward over 1 (NO)?'
    endif
    !answer = !!alert.question(!question)
    if !answer.eq('YES') then
      !startVertexRef = !allPoints[!startVertex]
      !endVertexRef = !allPoints[!endVertex]
      !this.tmpPath.evaluate(object BLOCK('!this.tmpPath[!evalindex].invert()'))
      !allPoints.invert()
      !startVertex = !allPoints.findfirst(!startVertexRef)
      !endVertex = !allPoints.findfirst(!endVertexRef)
    elseif !answer.eq('NO') then
      !getOverStart = true
    else
      -- close edg session
      !!edgCntrl.escape()
      return
    endif
  endif

  -- close edg session
  !!edgCntrl.escape()

  -- compose list of pointers
  !points = ARRAY()
  if !getOverStart then
    do !c from !startVertex to !allPoints.maxIndex()
      !points.append(!allPoints[!c])
    enddo
    !startVertex = 1
  endif
  do !c from  !startVertex to !endVertex
   !points.append(!allPoints[!c])
  enddo

  !indices = !this.handrail.insertPoints(!this.currentVertex,!points)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle
  if !indices.unset() then
  -- no points has been inserted
    return
  endif

  !this.currentVertex = !indices.last()
  handle ANY
    !this.currentVertex = !this.vertex().maxIndex()
  endhandle
  if !this.vertexType()[!this.currentVertex].eq('CURVE') then
    !this.currentVertex = !this.handrail.lastVertex()
  endif

  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copyPathClose
--
-- Description: callback on close of EDG session
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyPathClose()

  !!aidNumbers.hide(!this.aidNumber)

  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      merge
--
-- Description: Initialise EDG pick to pick handrail to be merged
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .merge()

  -- init handrail object
  !handrail = object ASLHANDRAIL(handra)
  -- undo callback must be declared in fullname format (not using !this shortcut) as it will be called externally
  !handrail.undoCall = '!!aslHandra.undo(''$!handrail.refe'')'
  !this.handrail = !handrail

  -- Initialise Variables for EDG
  !prompt               = 'Pick HANDRA to be merged with current HANDRA'
  !packet               = object EDGPACKET()
  !packet.elementpick(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = !this.fullname() & '.merge(!this.return[1])'
  !packet.close         = !this.fullname() & '.setActive(true)'
  !packet.pickPacket.picks[1].prompt = ''

  -- make all gadgets inactive
  !this.setActive(false)

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      merge
--
-- Description: Merge current and picked handrail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     EDGPICKDATA Picked handrail
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .merge(!edgData is EDGPICKDATA)

  !item = !edgData.item

  if !item.badref() then
    return
  endif

  !pickedHandrail = !!dtbGetOwnerType(!item,'HANDRA')
  if !pickedHandrail.badref() then
    !!alert.error('Picked element must be HANDRAIL')
    return
  endif

  if !this.handrail.refe.eq(!pickedHandrail) then
    !!alert.error('The same HANDRAIL has been picked!')
    return
  endif

  if !pickedHandrail.closeFlag then
    !!alert.error('Picked HANDRAIL must not be closed!')
    return
  endif

  !handrail = object ASLHANDRAIL(!pickedHandrail)

  -- merge handrail
  !this.handrail.merge(!handrail)
  handle ANY
    !!alert.error(!!error.text)
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      split
--
-- Description: init EDG mode to pick element on split
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .split()

  -- init handrail object
  !handrail = object ASLHANDRAIL(handra)
  -- undo callback must be declared in fullname format (not using !this shortcut) as it will be called externally
  !handrail.undoCall = '!!aslHandra.undo(''$!handrail.refe'')'
  !this.handrail = !handrail

  -- Initialise Variables for EDG
  !prompt               = 'Pick element or aid graphic to split HANDRAIL'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = !this.fullname() & '.split(!this.return[1])'
  !packet.close         = !this.fullname() & '.setActive(true)'
  !packet.pickPacket.stdGraphic(!prompt)
  !packet.pickPacket.picks[1].prompt = ''

  -- make all gadgets inactive
  !this.setActive(false)

  -- Add event to system
  !!edgCntrl.add(!packet)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      split
--
-- Description: Split handrail on passed element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      EDGPICKDATA   result from EDG pick
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .split(!edgData is EDGPICKDATA)

  -- init
  !clearance = !this.handrail.criteria.splitClearance.optimum()
  !item = !edgData.item

  -- get linear segments of handrail
  !segment = !this.rpath().edges(!this.handrail.closeFlag())
  -- remove arcs
  do !c indices !segment
    skip if !segment[!c].objectType().eq('LINE')
    !segment[!c].delete()
  enddo

  if !item.badref() then
    !type = !edgData.primaryObject
    !gap = !clearance * 2
    if !type.eq('FACET') then
      !facets = !edgData.facets
      !facets.unique()
      !surfacePlane = !facets[1].plane(!facets[2],!facets[3])
      handle ANY
        !surfacePlane = !facets[1].plane(!facets[2],!facets[4])
        handle ANY
          !!alert.error('Cannot extract plane from graphical pick.')
          return
        endhandle
      endhandle
      !surface = object PROFILE(!surfacePlane.position,!surfacePlane.orientation,!facets)
      !surface.mergepoints()
      !surface.mergelines()
      !surface.close()
      -- check lines for intersection with surface
      do !linesegm values !segment
        !intersection = !linesegm.intersection(!surfacePlane)
        handle ANY
          skip
        endhandle
        skip if !surface.isWithout(!intersection)
        handle ANY
          return
        endhandle
        skip if !linesegm.onProjected(!intersection).not()
        !splitPos = !intersection
        break
      enddo
      if undefined(!splitPos) then
        !!alert.error('Cannot determine intersection between HANDRAIL and picked surface.')
    return
  endif
    else
      !!alert.error('Only surface can be picked here.')
    return
  endif
  else
  -- volume data
  var !vol split lvol of $!item wrt $!item
  !wvol = !item.wvol
  if (!wvol.unset() ) then
    !!alert.error('Cannot determine intersection between HANDRAIL and picked element.')
    return
  endif
  !lowpos = e $!wvol[1] n $!wvol[2] u $!wvol[3] wrt world
  !height = !wvol[6] - !wvol[3]

  -- define base plane
  !base = object PLANE(!lowpos,Z is U wrt world)

  -- define all corner points
  !vrtx[1] = e $!vol[1] n $!vol[2] u $!vol[3] wrt $!item
  !vrtx[2] = e $!vol[4] n $!vol[2] u $!vol[3] wrt $!item
  !vrtx[3] = e $!vol[4] n $!vol[5] u $!vol[3] wrt $!item
  !vrtx[4] = e $!vol[1] n $!vol[5] u $!vol[3] wrt $!item
  !vrtx[5] = e $!vol[4] n $!vol[5] u $!vol[6] wrt $!item
  !vrtx[6] = e $!vol[1] n $!vol[5] u $!vol[6] wrt $!item
  !vrtx[7] = e $!vol[1] n $!vol[2] u $!vol[6] wrt $!item
  !vrtx[8] = e $!vol[4] n $!vol[2] u $!vol[6] wrt $!item

  -- project all points onto plane and discard duplicate points
  do !c indices !vrtx
    !vrtx[!c] = !base.near(!vrtx[!c])
  enddo
  !vrtx.unique()

  -- close shape
  !vrtx.append(!vrtx[1])

  -- compose shape
  !shape = object PROFILE(!lowpos,Z is U wrt world,!vrtx)
  !shape.mergepoints()
  !shape.mergelines()

  -- check lines against shape
  do !linesegm values !segment
    !intersect = !shape.intersections(!linesegm)
    if !intersect.size().geq(2) then
      !from = !linesegm.near(!intersect[1])
      !to = !linesegm.near(!intersect[2])
      if !linesegm.onProjected(!from).and(!linesegm.onProjected(!to)) then
        !intersectSegm = !linesegm
        break
      endif
    endif
  enddo

  if undefined(!intersectSegm) then
    !!alert.error('Cannot determine intersection between HANDRAIL and picked element.')
    return
  endif

  -- compose gap
  !gap = !from.distance(!to)
  !splitPos = !from.midpoint(!to)
  !gap = !gap + !clearance * 2

  -- check if picked item actually intersect with handrail path
  !lowpos = !base.near(!splitPos)
  !lineOnSplit = object LINE(!lowpos,!lowpos.offset(U wrt world,!height))
  !handrail = object LINE(!splitPos,!splitPos.offset(U wrt world,!this.handrail.railSpacing.last()))
  if !lineOnSplit.overlap(!handrail).unset() then
    !!alert.error('Cannot split HANDRAIL - picked element and handrail do not physically intersect.')
    return
  endif

  endif

  -- split handrail
  !this.handrail.split(!splitPos,!gap)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  if !!alert.confirm('O.K. to split HANDRAIL?').boolean().not() then
    undodb
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      splitRail
--
-- Description: init EDG mode to pick element on split
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitRail()

  -- there must be some rail withi current handrail
  if !this.handrail.collection('RAIL',handra).unset() then
    !!alert.error('No RAIL below current HANDRAIL!')
    return
  endif

  -- init handrail object
  !handrail = object ASLHANDRAIL(handra)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  -- undo callback must be declared in fullname format (not using !this shortcut) as it will be called externally
  !handrail.undoCall = '!!aslHandra.undo(''$!handrail.refe'')'
  !this.handrail = !handrail

  -- Initialise Variables for EDG
  !prompt               = 'Pick element to split single rail(s) of HANDRAIL'
  !packet               = object EDGPACKET()
  !packet.elementpick(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = !this.fullname() & '.splitRail(!this.return[1])'
  !packet.close         = !this.fullname() & '.setActive(true)'
  !packet.pickPacket.picks[1].prompt = ''

  -- make all gadgets inactive
  !this.setActive(false)

  -- Add event to system
  !!edgCntrl.add(!packet)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      splitRail
--
-- Description: Split single rail on passed element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      EDGPICKDATA   result from EDG pick
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitRail(!edgData is EDGPICKDATA)

  -- init
  !item = !edgData.item

  if !item.badref() then
    return
  endif

  -- avoid handrail itself
  !handrail = !this.getHandrailAbove(!item)
  if !handrail.set() then
    if !handrail.eq(!this.handrail.refe) then
      !!alert.error('You cannot pick the same HANDRAIL you want to split!')
      return
    endif
  endif

  -- pass item to handrail object
  !this.handrail.splitRail(!item)
  handle ANY
    !!alert.error(!!error.text)
    -- the error might come from desclash mode so try to exit from it
    exit
    handle ANY
    endhandle
    return
  endhandle

  if !!alert.confirm('O.K. to split RAIL(s)?').boolean().not() then
    undodb
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      openSegment
--
-- Description: initialise edg session to pick linear segment of HR to make it open
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .openSegment()

  -- remove existing graphic
  !!aidNumbers.hide(!this.aidNumber)

  -- draw linear segments
  !this.tmpPath = !this.drawEdges(100mm,false)

  -- Initialise Variables for EDG
  !prompt               = 'Pick handrail segment to be made open'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.action        = !this.fullname() & '.openSegment(!this.return[1])'
  !packet.close         = !this.fullname() & '.openSegmentClose()'
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdAid(!prompt)
  !pickPacket.picks[1].prompt = ''
  !packet.pickPacket = !pickPacket

  -- Add event to system
  !!edgCntrl.add(!packet)

  !this.geomPane.active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      openSegment
--
-- Description: make linear segment of HR open
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA   result from EDG pick
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .openSegment(!edgData is EDGPICKDATA)

  !aidType = !edgData.aidType
  !number = !edgData.point

  -- ignore invalid picks
  if !number.neq(!this.aidNumber) then
    return
  endif
  if !aidType.neq('CYLINDER') then
    return
  endif

  !pickLine = !edgData.pickLine.line(100)

  !index = REAL()
  !distance = ARRAY()
  do !c indices !this.tmpPath
    !tmpdist = ARRAY()
    do !tmpLine values !this.tmpPath[!c]
      !tmpdist.append(!pickLine.distance(!tmpLine))
    enddo
    if !tmpdist.set() then
      !distance[!c] = !tmpdist.sort().first()
    endif
  enddo
  !validIndices = !this.tmpPath.indices()
  !index = !distance.sortedIndices().first()
  !tmpIndex  = !validIndices.findfirst(!index)
  !index = !validIndices[!tmpIndex + 1]
  handle ANY
    !index = 1
  endhandle

  -- make selected segment open
  !this.handrail.openSegment(!index)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !!edgCntrl.escape()
  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      openSegmentClose
--
-- Description: called on exit from EDG mode to make segment open
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .openSegmentClose()

  !!aidNumbers.hide(!this.aidNumber)
  !this.geomPane.active = true
  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeGeom
--
-- Description: completely remove geometry definition of handrail incl posts, rails, gates, etc.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeGeom()

  --ask user first
  if !!alert.confirm('O.K. to remove all handrail vertices?').boolean().not() then
    return
  endif

  !this.handrail.removeGeometry()

  !this.currentVertex = 0
  !this.geomPaneButtons()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      removeCurrentVertex
--
-- Description: remove current vertex and associated posts
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeCurrentVertex()

  if !this.vertex().size().eq(0) then
    return
  endif

  !index = !this.currentVertex
  !this.handrail.deleteVertex(!index)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  if !this.vertex().size().boolean() then
    !index = !index - 1
    if undefined(!this.vertex()[!index]) then
      !index = !index - 1
      if undefined(!this.vertex()[!index]) then
        !index = 1
      endif
    endif
  else
    !index = 0
  endif


  !this.currentVertex = !index
  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeVertices
--
-- Description: invoke EDG mode to pick START vertex to remove
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeVertices()

  !rpath = !this.rpath()
  !!aidNumbers.hide(!this.aidNumber)
  !this.tmpPath = !this.drawVertices(!this.aidNumber,400mm, !rpath,false)
  !this.tmpVertex.clear()

  -- Initialise Variables for EDG
  !prompt               = 'Pick start VERTEX of sequence to be deleted'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.action        = !this.fullname() & '.removeVertices(!this.return[1])'
  !packet.close         = !this.fullname() & '.removeVerticesClose()'
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdAid(!prompt)
  !pickPacket.picks[1].prompt = ''
  !packet.pickPacket = !pickPacket

  -- Add event to system
  !!edgCntrl.add(!packet)

  !this.geomPane.active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeVertices
--
-- Description: pick start/end vertex sequence to be deleted
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      EDGPICKDATA   edg pick
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeVertices(!edgData is EDGPICKDATA)

  -- init
  !index = REAL()
  !distance = ARRAY()
  !remVertices = ARRAY()
  !type = !edgData.type
  !aidType = !edgData.aidType
  !number = !edgData.point

  -- ignore invalid picks
  if !number.neq(!this.aidNumber) then
    return
  endif
  if !aidType.neq('SPHERE') then
    return
  endif

  -- compose line of pick
  !pickLine = !edgData.pickLine.line(100)
  -- get vertex closest to line of pick
  do !c indices !this.tmpPath[1]
    !vrtxPos = !this.tmpPath[1][!c]
    !distance[!c] = !pickLine.distance(!vrtxPos)
  enddo
  !index = !distance.sortedIndices().first()

  -- first pick
  if undefined(!this.tmpVertex[1]) then
    -- store picked vertex
    !this.tmpVertex[1] = !index
    -- indicate selection
    aid clear text $!number
    do !c indices !this.tmpPath[5]
      !pointPos  = !this.tmpPath[1][!c]
      !pointType = !this.tmpPath[2][!c]
      !pointSequ = !this.tmpPath[5][!c]
      !text = !pointSequ
      if !c.eq(!index) then
        !text = !text + ' - Start'
      endif
      !!drawAidText(!text,!pointPos,!number)
    enddo

    --change prompt
    !!edgCntrl.setPrompt('Pick end VERTEX of sequence to be deleted')
    return

  -- second pick
  else
    -- retrieve data from previous pick
    !startVertex = !this.tmpVertex[1]
    !startTxt = !this.tmpPath[5][!startVertex]
    -- get data from this pick
    !endVertex = !index
    !endTxt = !this.tmpPath[5][!index]
    -- then check if points picked are not the same
    if !startVertex.eq(!endVertex) then
      return
    endif
  endif

  -- check sequence order
  !getOverStart = false

  if !startVertex.gt(!endVertex) then
    if !endVertex.eq(1) then
      !question = 'Do you want to delete vertices from $!endTxt to $!startTxt (YES) or from $!endTxt to $!startTxt (NO)?'
    else
      !question = 'Do you want to delete vertices from $!endTxt to $!startTxt backward (YES) or forward over 1 (NO)?'
    endif
    !answ = !!alert.question(!question)
    if !answ.eq('YES') then
    -- shift start/end
      !tmpStartVertex = !startVertex
      !startVertex = !endVertex
      !endVertex = !tmpStartVertex
    elseif !answ.eq('NO') then
      !getOverStart = true
    else
      return
    endif
  endif

  -- compose sequence array
  if !getOverStart then
    do !c from !startVertex to !this.vertex().maxIndex()
      !remVertices.append(!c)
    enddo
    !startVertex = 1
  endif
  do !c from  !startVertex to !endVertex
    !remVertices.append(!c)
  enddo

  -- delete vertices
  !this.handrail.deleteVertices(!remVertices)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  -- close edg session
  !!edgCntrl.escape()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeVerticesClose
--
-- Description: called on exit from EDG mode to remove vertices
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeVerticesClose()

  !!aidNumbers.hide(!this.aidNumber)
  !this.geomPane.active = true
  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectCurrentVertex
--
-- Description: make picked vertex current
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      EDGPICKDATA   picked data
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectCurrentVertex(!edgData is EDGPICKDATA)

  !aidType = !edgData.aidType
  !number = !edgData.point

  -- ignore invalid picks
  if !number.neq(!this.aidNumber) then
    return
  endif
  if !aidType.neq('SPHERE') then
    return
  endif

  !pickLine = !edgData.pickLine.line(100)

  !index = REAL()
  !distance = ARRAY()
  do !c indices !this.tmpPath[1]
    !vrtxPos = !this.tmpPath[1][!c]
    !distance[!c] = !pickLine.distance(!vrtxPos)
  enddo
  !index = !distance.sortedIndices().first()

  !this.currentVertex = !index
  !!edgCntrl.escape()
  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectCurrentVertex
--
-- Description: invoke EDG session to pick vertex to be made current
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectCurrentVertex()

  !rpath = !this.rpath()
  !!aidNumbers.hide(!this.aidNumber)
  !this.tmpPath = !this.drawVertices(!this.aidNumber,400mm, !rpath,false)
  !this.tmpVertex.clear()

  -- Initialise Variables for EDG
  !prompt               = 'Pick VERTEX to be made current'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.action        = !this.fullname() & '.selectCurrentVertex(!this.return[1])'
  !packet.close         = !this.fullname() & '.selectCurrentVertexClose()'
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdAid(!prompt)
  !pickPacket.picks[1].prompt = ''
  !packet.pickPacket = !pickPacket

  -- Add event to system
  !!edgCntrl.add(!packet)

  !this.geomPane.active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectCurrentVertexClose
