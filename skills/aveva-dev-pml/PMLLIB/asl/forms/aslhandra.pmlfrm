------------------------------------------------------------------------
--
-- Method:      moveCurrentVertex
--
-- Description: invoke EDG session to pick new position of current vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveCurrentVertex()

  -- check if vertex is not associated to another vertex
  !index = !this.currentVertex
  if !this.rpath().sigref[!index].badref().not() then
$(    !connected = !this.rpath().sigref[!index].owner.owner.namtyp
    -- ask user to confirm
    if !!alert.confirm('Current vertex is already connected to $!<connected>.
The connection will be lost. O.K. to continue?').boolean().not() then
      return
    endif$)
  endif

  -- Initialise Variables for EDG
  !prompt               = 'Pick position where the VERTEX to be moved to'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = !this.fullname() & '.moveCurrentVertex(!this.return[1])'
  !packet.close         = !this.fullname() & '.moveCurrentVertexClose()'
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdPosition(!prompt)
  !packet.pickPacket = !pickPacket

  -- Add event to system
  !!edgCntrl.add(!packet)

  -- make buttons inactive
  !this.copyOwnerPath.active = false
  !this.geomDefine.active    = false
  !this.selectCurrentVertex.active = false
  !this.moveCurrentVertex.active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      moveCurrentVertexClose
--
-- Description: callback on EDG session close
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveCurrentVertexClose()

  !this.copyOwnerPath.active = true
  !this.geomDefine.active    = true
  !this.selectCurrentVertex.active = true
  !this.moveCurrentVertex.active = true

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      moveCurrentVertex
--
-- Description: move current vertex to picked position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      EDGPICKDATA  Picked data
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveCurrentVertex(!edgData is EDGPOSITIONDATA)

  -- init
  !index = !this.currentVertex

  -- get position form edg pick
  !pickedpos = !edgData.position
  !item = !edgData.item

  if !item.badref().not() then
    !itemOwner = !!dtbGetOwnerType(!item,'PLTFRM STRLNG')
    if !itemOwner.set() then
      !expr = object EXPRESSION('type of owner of owner neq ''HANDRA''')
      !pointr = !this.handrail.collection('POINTR',!expr,!itemOwner)
      !pointrPos = !pointr.evaluate(object BLOCK('!pointr[!evalindex].pos.wrt(world)'))
      !found = !!findNearestPos(!pointrPos,!pickedpos,1mm)
      if !found.set() then
        !data = !pointr[!found]
      else
        !data = !pickedpos
      endif
    else
      !data = !pickedpos
    endif
  else
    !data = !pickedpos
  endif


  !this.handrail.modifyVertex(!index,!data,REAL())
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      extend
--
-- Description: initialise edg session to extend handrail start/end
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .extend()


  -- set up the object if called from main panel
  if !this.mainPane.visible then
    !handrail = object ASLHANDRAIL(handra)
    !handrail.autoDraw = false
    !handrail.autoUpdateDb = true
    !handrail.undoable = true
    !handrail.undoCall = '!!aslHandra.undo(''$!handrail.refe'')'
    !this.handrail = !handrail
  endif

  if !this.handrail.closeFlag() then
    !!alert.error('Cannot extend HANDRAIL that is closed!')
    return
  endif

  -- remove existing graphic
  !!aidNumbers.hide(!this.aidNumber)

  -- draw first and last vertex
  !startPos = !this.vertex()[1]
  !endPos   = !this.vertex().last()
  !diam = 400mm
  !!drawAidSphere(!diam, !startPos, !this.aidNumber)
  !!drawAidText('Start', !startPos, !this.aidNumber)
  !!drawAidSphere(!diam, !endPos, !this.aidNumber)
  !!drawAidText('End', !endPos, !this.aidNumber)

  -- Initialise Variables for EDG
  !prompt               = 'Pick handrail end to be extended'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.action        = !this.fullname() & '.extend(!this.return[1])'
  !packet.close         = !this.fullname() & '.extendClose()'
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdAid(!prompt)
  !pickPacket.picks[1].prompt = ''
  !packet.pickPacket = !pickPacket

  -- Add event to system
  !!edgCntrl.add(!packet)

  !this.visiblePane().active = false

  -- make .extend member empty
  !this.extend = ''


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      extend
--
-- Description: extend start/end of open handrail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA   picked start/end
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .extend(!edgData is EDGPICKDATA)

  -- init
  !aidType = !edgData.aidType
  !number = !edgData.point

  -- first pick which end to select
    if !aidType.eq('SPHERE').and(!number.eq(!this.aidNumber)).not() then
      return
    endif


    -- compose line of pick and position of start/end
    !pickLine = !edgData.pickLine.line(100)
    !startPos = !this.vertex()[1]
    !endPos   = !this.vertex().last()
    -- check which end is closer to line of pick
    if !pickLine.distance(!startPos).lt(!pickLine.distance(!endPos)) then
      !this.extend = 'START'
    else
      !this.extend = 'END'
    endif

    -- exit from edg mode
    !!edgCntrl.escape()

    -- invoke edg mode to extend selected end
  !prompt               = 'Pick POSITION LINE or SURFACE through the handrail $!<this.extend> to be extended'
    !packet               = object EDGPACKET()
    !packet.description   = !this.edgDescription
    !packet.remove        = false
    !packet.action        = !this.fullname() & '.extend(!this.return[1])'
    !packet.close         = !this.fullname() & '.extendClose()'
    !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdPosition(!prompt)
    !packet.pickPacket = !pickPacket

    -- Add event to system
    !!edgCntrl.add(!packet)

    -- make entire panel inactive
    !this.visiblePane().active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      extend
--
-- Description: extend start/end of open handrail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   R      EDGPOSITIONDATA   second pick to extend selected end
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .extend(!edgData is EDGPOSITIONDATA)

    -- init
    if !this.extend.eq('START') then
      !index = 1
      !prev = 2
    else
      !index = !this.vertex().maxIndex()
      !prev = !index - 1
    endif

  !pickedpos = !edgData.position
  !pickedline = !edgData.line
  !number = !edgData.ppoint
  !pickedPlane = !edgData.plane
  !newPos = object POSITION()
    !tmpLine = object LINE(!this.vertex()[!prev],!this.vertex()[!index])

  if !pickedPlane.set() then
    !newPos = !tmpLine.intersection(!pickedPlane)
      handle ANY
      endhandle
  endif

  if !pickedline.set().and(!newPos.unset()) then
    !newPos = !tmpLine.intersection(!pickedline)
      handle ANY
      endhandle
  endif

  if !newPos.unset() then
    !newPos = !tmpLine.near(!pickedpos)
    endif


    -- move vertex
    !this.handrail.modifyVertex(!index,!newPos,REAL())
    handle ANY
      !!alert.error(!!error.text)
    endhandle

    -- exit from EDG mode
    !!edgCntrl.escape()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      extendClose
--
-- Description: callback on EDG session close
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .extendClose()

  !!aidNumbers.hide(!this.aidNumber)
  !this.visiblePane().active = true
  !this.geomPaneButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawLineAsCyli
--
-- Description: draw passed LINE as aid cylinder with passed diameter
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        line to be draw as cylinder
--    2   R      REAL        aid number
--    3   R      REAL        diameter of cylinder
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawLineAsCyli(!drawLine is LINE,!number is REAL,!diameter is REAL)

  -- compute cylinder properties
  !ori = !drawLine.plane().orientation
  !pos = !drawLine.proportion(0.5)
  !leng = !drawLine.length()

  -- draw cylinder
  !!drawAidCylinder(!diameter,!leng,!pos,!ori,true,!number)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      edgpickToPosition
--
-- Description: extract position from EDGPICKDATA object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      EDGPICKDATA   result from EDG pick
--
-- Return:
--   [Data Type] [Description]
--    POSITION    exact picked position
--
------------------------------------------------------------------------

define method .edgpickToPosition(!edgData is EDGPICKDATA) is POSITION

  -- get picked position
  !object = !edgData.primaryObject
  !lines = !edgData.lines
  !pickLine = !edgData.pickLine
  !vertices = !edgData.vertices
  !facets = !edgData.facets

  if !object.eq('EDGE') then
    !edge = object LINE(!lines[1],!lines[2])
    !pickedpos = !edge.intersection(!pickLine)
  elseif !object.eq('VERTEX') then
    !pickedpos = !vertices[1]
  elseif !object.eq('FACET') then
    !facets.unique()
    !surface = !facets[1].plane(!facets[2],!facets[3])
    !pickedpos = !pickLine.intersection(!surface)
  else
  -- invalid pick
    return error 1 'Invalid pick!'
  endif

  return !pickedpos.wrt(world)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      trackStairs
--
-- Description: track side of stairs closest to passed position.
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference to STRFLT or below
--    2   R      POSITION    position to indicate side (the closer one) to be tracked
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array with points tracking the side of stairs
--
------------------------------------------------------------------------

define method .trackStairs(!item is DBREF,!anypos is POSITION) is ARRAY

    -- init
    !track = ARRAY()
    !stair = STRFLT of $!item
    !path = !!dtbMemberOfType(!stair,'RPATH',1)
    -- get stair flight centreline
    !pathObj = object ASLRPATH(!path,'load')
    !edges = !pathObj.edges(false)
    !dist = ARRAY()
    do !c indices !edges
      skip if !edges[!c].objectType().neq('LINE')
      !dist[!c] = !anypos.distance(!edges[!c])
    enddo
    !newIndx = !dist.sortedIndices()
    !closestLine = !edges[!newIndx.first()]

    -- get side that is closest to vertex
    !tmpPlane = object PLANE(!closestLine.startPosition, !this.handrail.orientation)
    !dir = !closestLine.direction().projected(!tmpPlane)
    !tmpPlane.orientation = Y is $!dir
    !xy = !tmpPlane.xyOffset(!anypos)

    if !xy.x.lt(0) then
      !side = 'L'
    else
      !side = 'R'
    endif

  !track = !this.handrail.trackStrflt(!stair,!side)

  return !track

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      undo
--
-- Description: undo/redo callback of UNDOABLE object added to undo stack from .updateDb() method of ASLHANDRAIL object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      reference to handrail as string
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .undo(!handrail is STRING)

  -- check if form is displayed
  if !this.shown().not() then
    return
  endif

  -- which panel is visible
  if !this.visiblePane().eq(!this.mainPane) then
    return
  endif

  -- check if passed handrail is being modified
  if !handrail.eq(!this.handrail.refe.string()) then
    -- check if passed handrail exists
    !handrailRef = !handrail.dbref()
    handle ANY
      !handrailRef = nulref
    endhandle
    if !handrailRef.badref() then
      -- check if handrail owner is valid
      if !this.handrailOwner.badref() then
      -- display form with main panel visible
        !this.savedHandrail = !this.handrail
        !this.mainPane()
      else
        !this.handrail.remFromAidNumbers()
        !this.createHandrailPane('init')
      endif
      -- exit
      return
    endif

    -- check if visible panel is handrailPane in create mode
    if !this.visiblePane().eq(!this.handrailPane).and(!this.createHandrail.visible) then
      -- show panel in modify mode and exit
      !this.handrail.remFromAidNumbers()
      !this.modifyHandrailPane($!handrail)
      handle ANY
      endhandle
      return
    endif
    -- remove handrail object aidnumbers
    !this.handrail.remFromAidNumbers()
    -- create new handrail object and associate it with this form
    !handrailObj = object ASLHANDRAIL(!handrailRef)
    !this.handrail(!handrailObj)
    if !this.visiblePane().eq(!this.geomPane) then
      if !this.currentVertex.eq(0) then
        !this.currentVertex = !this.handrail.lastVertex()
      endif
      !this.geomPaneButtons()
      handle ANY
      endhandle
    endif
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      visiblePane
--
-- Description: return currently visible panel
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    GADGET      currently visible panel gadget
--
------------------------------------------------------------------------

define method .visiblePane() is GADGET

  do !pane values !this.panels
    if !pane.visible then
      return !pane
    endif
  enddo

  return object GADGET()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getHandrailOwnerFrom
--
-- Description: get possible handrail owner passed db position, e.g db item that can own the handrail
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       checked db element
--
-- Return:
--   [Data Type] [Description]
--    DBREF       possible handrail owner - nulref is returned if handrail cannot be created there
--
------------------------------------------------------------------------

define method .getHandrailOwnerFrom(!item is DBREF) is DBREF

  -- init variables
  !owner = nulref
  if !this.useStoreTable then
    !owner = !!aslStoreTable.getStore('handrail')
    handle ANY
    endhandle
  else
    !this.useStoreTable = true
  endif

  if !owner.unset() then
  -- compose hierarchy above passed element
  !owntype = !item.ahlis
  !ownList = !item.ownls
  -- add item itself
  !owntype.append(!item.type)
  !ownList.append(!item)

  -- declare possible owner types
  !olis[1] = 'STRU'
  !olis[2] = 'STRFLT'
  !olis[3] = 'STRLNG'
  !olis[4] = 'DETGRP'
  !olis[5] = 'LADDER'
  !olis[6] = 'PLTFRM'

  -- check if any of above is in a list
  !owners = !olis.intersect(!owntype)
  if !owners.set() then
  -- get element
    !type = !owners.last()
    !level = !owntype.findfirst(!type)
    !owner = !ownList[!level]
  endif
  endif

  return !owner

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getHandrailAbove(!item is DBREF) is DBREF

  !handrail = nulref

  if !item.badref() then
    return !handrail
  endif

  -- compose hierarchy above passed element
  !owntype = !item.ahlis
  !ownList = !item.ownls
  -- add item itself
  !owntype.append(!item.type)
  !ownList.append(!item)

  -- get element
  !level = !owntype.findfirst('HANDRA')
  if !level.set() then
    !handrail = !ownList[!level]
  endif

  return !handrail

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rpath
--
-- Description: get rpath from owned handrail object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ASLRPATH    rpath owned by handrail
--
------------------------------------------------------------------------

define method .rpath() is ASLRPATH

  return !this.handrail.rpath

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      vertex
--
-- Description: return vertex array of rpath owned by handrail object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       position array
--
------------------------------------------------------------------------

define method .vertex() is ARRAY

  return !this.handrail.vertex()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      vertex
--
-- Description: return passed vertex as array of all properties of it (position, type, detail)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       vertex props. array
--
------------------------------------------------------------------------

define method .vertex(!index is REAL) is ARRAY

  !allData[1] = !this.vertex()[!index]
  !allData[2] = !this.vertexType()[!index]
  !allData[3] = !this.vertexDetail()[!index]

  return !allData

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      vertexType
--
-- Description: return vertex type array of rpath owned by handrail object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       string array
--
------------------------------------------------------------------------

define method .vertexType() is ARRAY

  return !this.handrail.type()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      vertexDetail
--
-- Description: return vertex detail array of rpath owned by handrail object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       mixed array
--
------------------------------------------------------------------------

define method .vertexDetail() is ARRAY

  return !this.handrail.detail()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description: form cancellation callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  -- tidy up
  -- escape from any EDG session
  !!edgCntrl.remove(!this.edgDescription)

  -- remove handrail object from aidNumbers
  !this.handrail.remFromAidNumbers()
  -- remove form from aidnumbers
  !!aidNumbers.remove(!this.aidNumber)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      kill
--
-- Description: callback executed on form kill
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .kill()

  !this.handrail.remFromAidNumbers()

endmethod
