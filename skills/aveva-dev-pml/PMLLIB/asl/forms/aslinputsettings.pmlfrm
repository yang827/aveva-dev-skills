--   Keyword:       ASL
--   Module:        Design
--   Replaces:
--
-- Author:          Venkatramanan.Iyer
-- Created:
-- Description:
-- Form for getting name and description for new standard or sub-standard
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Create Elements
--  aslInputSettings()               -                   Constructor
--  checkAccess(STRING)              BOOLEAN             checks the access to the paths for the supplied create type i.e. USER or PROJECT. if the current user
--  close()                          -                   Close the form
--  setType()                        -                   set the type of setting to create or modify.
--
------------------------------------------------------------------------

setup form !!aslInputSettings

  !this.formTitle     = 'ASL-Settings'
  !this.iconTitle     = 'ASL-Settings'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  para   .descTag                       anchor L+R+T  at xmin               ymin      text 'Description '     width 12
  text   .desc                          anchor L+R+T  at xmax+1             ymin                                  width 20 is STRING
  para   .typeTag                       anchor L+R+T  at xmin.descTag       ymax+0.5  text 'Setting Type '    width 12
  option .type                          anchor L+R+T  at xmax+1             ymin  callback |!this.setType()|  width 17.7
  -- Apply
  button .ok     ' OK'                  anchor L+B    at xmin.descTag       ymax+0.5

  -- Discard

  button .cancel 'Cancel'               anchor R+B    at xmax form - size   ymin.ok

  -- Form Members
  member .action          is STRING
  member .errorState      is BOOLEAN
  member .settingType     is STRING

exit

-- End of form definition
------------------------------------------------------------------------
--
-- Method:      aslInputSettings
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslInputSettings()
    !this.ok.callback       = '!this.apply()'
    !this.cancel.callback   = '!this.close()'
    !this.errorState        = false
    !this.type.add('USER')
    !this.type.add('PROJECT')
    !this.setType()

endmethod
-- End of method definition for .aslInputSettings()
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Create Elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  if !!aslInputSettings.desc.val.eq('') then
    !!alert.warning('Enter the Setting Description.')
    return
  endif

  !test = !this.checkAccess(!this.type.selection('dtext'))

  if !test.neq(TRUE) then
    return
  endif

  if(!this.action.upcase() eq 'CREATE')then

       --check statement for the description entered is already used in existing setting
       do !setting value !!aslCentralData.userSettings
         if ( !setting.description.eq(!this.desc.val.trim())) then
           !!alert.warning('Unable to create user setting. Description already used.')
           return
         endif
       enddo

       do !setting value !!aslCentralData.projectSettings
         if ( !setting.description.eq(!this.desc.val.trim())) then
           !!alert.warning('Unable to Create Project setting. Description already used.')
           return
         endif
       enddo

       -- check the new description, it must not appear twice
       do !setting value !!aslCentralData.settings
         if ( !setting.description.eq(!this.desc.val.trim())) then
           !!alert.warning('Unable to Create Default setting. Description already used.')
           return
         endif
       enddo

      -- setting description
       ---------------------------------------------------------------------------
       !newSetting             = object SETTING()
       !newSetting.description = !this.desc.val.trim()
       !newSetting.purpose     = 'ASL'
       !newSetting.type        = !this.settingType

       !!aslselections.meCurrSetting = !newSetting
       !!aslCentralData.currSetting = !newSetting

       -- updates the standard list
       !!aslselections.fillStandards()

       -- set the first standard and substandard
       !!aslselections.fillSubStandards()

       !newSetting.settingData = object ARRAY()

       !newSettingData         = object SETTINGDATA()
       !newSettingData.purpose = 'STANDARD'
       !newSettingData.value = !!aslselections.opStandards.selection()
       !newSetting.settingData.append(!newSettingData)

       !newSettingData         = object SETTINGDATA()
       !newSettingData.purpose = 'SUBSTANDARD'
       !newSettingData.value = !!aslselections.opSubStandards.selection()
       !newSetting.settingData.append(!newSettingData)

       -- reassign the variables for the current setting since the settingdata has been updated
       !!aslselections.meCurrSetting = !newSetting
       !!aslCentralData.currSetting  = !newSetting

       --updates the respective member of the aslcentraldata
       if !this.settingType.eq('USER') then
         -- adds the new settingset into the central object
         !!aslCentralData.userSettings.append(!newSetting )
       elseif !this.settingType.eq('PROJECT') then
         -- adds the new settingset into the central object
         !!aslCentralData.projectSettings.append(!newSetting )
       else
         -- adds the new settingset into the central object
         !!aslCentralData.settings.append(!newSetting )
       endif

       -- updates the settings list
       !!aslselections.fillSettings()

       --Updates the Gadget based on the meCurrSetting
       !!aslselections.updateGadgets()

       -- select the new setting
       !selectDtext = !!aslselections.opSettings.dText
       do !i from 1 to !selectDtext.size()
         !descriptionArray = !selectDtext[!i].split()
         if !descriptionArray.size().gt(2) then
           !description = !descriptionArray[1] + ' '
           do !j from 2 to !descriptionArray.size() - 1
             !description = !description + !descriptionArray[!j] + ' '
           enddo
         else
           !description = !selectDtext[!i].split()[1]
         endif

         if !!aslselections.meCurrSetting.description.trim().eq(!description.trim()) then
           !!aslselections.opSettings.val = !i
         endif
       enddo

  elseif(!this.action.upcase() eq 'COPY')then

       -- setting description
      ---------------------------------------------------------------------------
      !newSetting             = !!aslselections.meCurrSetting
      !newSetting.description = !this.desc.val

      do !setting value !!aslCentralData.userSettings
       if ( !setting.description.eq(!newSetting.description) ) then
         !!alert.warning('Unable to copy setting. Description already used.')
         return
       endif
      enddo

      do !setting value !!aslCentralData.projectSettings
        if ( !setting.description.eq(!newSetting.description) ) then
          !!alert.warning('Unable to copy setting. Description already used.')
          return
        endif
      enddo

      -- check the new description, it must not appear twice
      do !setting value !!aslCentralData.settings
        if ( !setting.description.eq(!newSetting.description) ) then
          !!alert.warning('Unable to copy setting. Description already used.')
          return
        endif
      enddo

        -- set setting variable
      !!aslselections.meCurrSetting = !newSetting

      --!this.settingType = !!aslCentralData.getSettingType(!newSetting.description)

      if !this.settingType.eq('DFLT') then
        !this.settingType = 'USER'
      endif

      if !this.settingType.eq('USER') then
        -- adds the new settingset into the central object
        !!aslCentralData.userSettings.append(!!aslselections.meCurrSetting )
      elseif !this.settingType.eq('PROJECT') then
        -- adds the new settingset into the central object
        !!aslCentralData.projectSettings.append(!!aslselections.meCurrSetting )
      else
        -- adds the new settingset into the central object
        !!aslCentralData.settings.append(!!aslselections.meCurrSetting )
      endif

      -- updates the settings list
      !!aslselections.fillSettings()

      -- set the list gadget value
      do !i from 1 to !!aslselections.opSettings.dText.size()
        if !!aslselections.opSettings.dText[!i].split()[1].eq(!newSetting .description) then
          !!aslselections.opSettings.val = !i
          break
        endif
      enddo

      -- select the new setting
      --!!aslselections.opSettings.select('rText', !!aslselections.meCurrSetting.description)
      !!aslselections.selectSetting()

      -- writes the settings
      !!aslCentralData.writeSettings()

  endif

  !this.hide()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      checkAccess
--
-- Description: checks the access to the paths for the supplied create type i.e. USER or PROJECT. if the current user
--              does not have the required setup for a write then this method will return false.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      keyword for the setting type ('USER', 'PROJECT', ...)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkAccess(!settingType is STRING) is BOOLEAN

  if !settingType.eq('USER') then
    -- get the user dflts
    !testFileName = '%PDMSUSER%' & '/test.xml'
    !testFile = object FILE(!testFileName)
    !fileName = object FILE('%PDMSUSER%' & '/aslsettings.xml')
  elseif !settingType.eq('PROJECT') then
    -- get the current project dflts
    !currProj = CURRENT PROJECT
    !testFileName = '%' & !currProj.code() & 'DFLTS%/test.xml'
    !testFile = object FILE(!testFileName)
    !fileName = object FILE('%' & !currProj.code() & 'DFLTS%/aslsettings.xml')
  else
    -- get the aveva dflts
    !testFileName = '%PDMSDFLTS%' & '/test.xml'
    !testFile = object FILE(!testFileName)
    !fileName = object FILE('%PDMSDFLTS%' & '/aslsettings.xml')
  endif

  -- write some junk data to the file
  !dataLines = object ARRAY()
  !dataLines.append('<?xml version="1.0" standalone="yes"?>')

  if !settingType.eq('PROJECT') then
    -- test to make sure the evar for the project dflts has been set
    !a = !testFile.pathname()
    !b = !a.subString(2)
    !evar = !currProj.code() & 'DFLTS'
    if !b.eq(|:\|) then
      !!alert.warning('Environment variable $!evar is not set in pdms evars.bat file. Set the variable $!evar for storing global ASL settings.' )
      return FALSE
    endif
  endif

  !testFile.writeFile('OVERWRITE', !dataLines)
  handle (41,319)
    !path = !testFile.pathname()
    !!alert.warning('Directory $!path does not exist to write file.')
    return FALSE
  elsehandle ANY
    !path = !testFile.pathname()
    !!alert.warning('Access Denied - check that you have write access to the destination $!path')
    return FALSE
  elsehandle NONE
    !testFile.deleteFile()
    handle ANY
    endhandle
    -- can create a test file in correct directory
    -- now check if the file can be written to
    !fileName.open('APPEND')
    handle ANY
      !name = !fileName.name()
      !!alert.warning('Error writing to file $!name - check that $!name is not open or write-protected')
      return FALSE
    endhandle
    !fileName.close()
    return TRUE
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      setType
--
-- Description: set the type of setting to create or modify.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      keyword for the setting type ('USER', 'PROJECT', ...)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setType()

  !this.settingType = !this.type.selection('dtext')

  if(!this.settingType.eq('PROJECT'))then
    var !projCode proj Code
    !this.desc.val = '$!projCode Project Settings'
  else
    !this.desc.val = 'User defined Settings'
  endif

endmethod
-- End of method
