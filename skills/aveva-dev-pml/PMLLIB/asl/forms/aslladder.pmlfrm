--    Description:   Ladder definition form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  acceptDetailAttributes()         -                   accept callback
--  acceptSpec()                     -                   Accept profile
--  aslLadder()                      -                   Constructor
--  calculateLowerPosition()         -                   Set Lower working point
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  closeForm()                      -                   closes the form
--  create()                         -                   create mode Settings
--  createLadder()                   -                   create new ladder
--  createSideExit(EDGPOSITIONDATA)  -                   implements new Access point
--  defineGeometry()                 -                   Defining the geometry
--  deleteAccessLadder()             -                   implements new Access point
--  deleteLadder()                   -                   delete ladder
--  deriveLWP()                      -                   evaluate picks and create ladder
--  deriveUWP()                      -                   evaluate picks and create ladder
--  discardLadder()                  -                   Discard changes
--  evaluate()                       -                   evaluate Ladder
--  evaluateLadder()                 -                   Derive ladder from returned pick data and selections on the form
--  evaluatePitch()                  -                   evaluate picks and create ladder
--  frameChange(GADGET)              -                   make the main frames visible/invisible
--  getWorkPoint(STRING)             -                   get LWP and UWP from Object and manipulates with foot room
--  lWP(EDGPOSITIONDATA)             -                   Set Lower working point
--  lwPlane(EDGPICKDATA)             -                   Set Lower working plane
--  modify()                         -                   Modify mode settings
--  modifyAccessLadder(ARRAY)        -                   callback when changing the grid
--  modifyGeometry()                 -                   Modify ladder Geometry
--  modifyLadder()                   -                   MOdify  ladder
--  modifyLadderTmplRef(GADGET,STRING) -                   open callback from most gadgets
--  newAccessLadder()                -                   implements new Access point
--  pickAccessLadder()               -                   implements new sideExit
--  pickAccessLadderReturn(EDGPOSITIONDATA) -                   repositions intermediate landing
--  pickLWP()                        -                   Setup EDG pick event for picking Lower Working Point
--  pickLWPlane()                    -                   Setup EDG pick event for picking Lower Working Plane
--  pickUWP()                        -                   Setup EDG pick event for picking Upper Working Point
--  positionOption()                 -                   Choose explicit or relative position option
--  selectAccessLadder(ARRAY)        -                   control for active/inactive of exit gadgets
--  selectCataOptionsLadder()        -                   select the current references in the options
--  selectProfile(GADGET)            -                   Select profile
--  selectProfile(REAL)              -                   Select profile
--  setGeometricalAttributes()       -                   Stores Derived LWP,uWP,ORise,Pitch and Direction.
--  setProfile(GADGET)               -                   Set profile
--  setProfile(REAL,PROFILECATALOGUEDATA) -                   Set profile
--  setup()                          -                   setup
--  showDimFeedbackLadder(GADGET,STRING) -                   callback from view gadgets
--  showVolFeedbackLadder()          -                   callback from view gadgets
--  sideExit()                       -                   Side Exit Create/Modify
--  topExitType()                    -                   top Exit definition
--  track()                          -                   ce-tracker
--  uWP(EDGPOSITIONDATA)             -                   Set Upper working point
--  updateAccessLadder()             -                   update the grid control
--  updateAttributes()               -
--  updateCataOptionsLadder()        -                   updates the catalogue options
--  updateCoordinateSystem()         -
--  updateFrameLadder()              -                   update the gadgets
--  updateLimitsLadder()             -                   updates the limits
--  validateDirection()              -                   Validating the Direction
--  validateElevationAccessLadder(REAL,CRITERION,ANY) REAL                Validating the text gadgets.
--  validateHeadroomAccessLadder(REAL,CRITERION,ANY) REAL                Validating the text gadgets.
--  validateSideExitElevation(REAL,REAL) BOOLEAN             implements new sideExit
--  validationTextGadgets(GADGET,CRITERION,ANY) -                   Validating the text gadgets.
--

import 'PositionControl'
handle ANY
endhandle

import 'GridControl'
handle ANY
endhandle


setup form !!aslLadder dialog dock right

  -- .NET library
  using namespace 'Aveva.Pdms.Presentation'

  track    'DESICE'    callback '!this.track()'

  path down

  frame .frMainPane  panel          anchor T+L+R                       at x0                 y0

    paragraph .createTask                                              at xmin               ymax text 'Create'                                                                       width 5
    line      .createTaskLine                                          at xmin               ymax                                                             anchor T+L  HORIZ       width 36
    button    .mainCreateLadder     linklabel      'Ladder'            at xmin.createTask+1  ymax+0.2     callback  '!this.create()'                                                  width 4
    button    .mainCreateSideExit   linklabel      'Side Exit'         at xmin.createTask+1  ymax+0.2     callback  '!this.sideExit()'                                                width 5

    paragraph .modifyTask                                              at xmin.createTask    ymax+0.5 text 'Modify'                                                                   width 5
    line      .modifyTaskLine                                          at xmin               ymax                                                             anchor T+L  HORIZ       width 36
    button    .mainModifyLadder     linklabel      'Ladder Definition' at xmin.createTask+1  ymax+0.2     callback '!this.modify()'                                                   width 10
    button    .mainModifySpec       linklabel      'Specifications'    at xmin.createTask+1  ymax+0.2     callback '!this.frameChange(!this.frSpecLadder)'                            width 9
    button    .mainModifySideExit   linklabel      'Side Exit'         at xmin.createTask+1  ymax+0.2     callback '!this.sideExit()'                                                 width 5

    paragraph .deleteTask                                              at xmin               ymax+0.5  text 'Delete'                                                                  width 5
    line      .deleteTaskLine                                          at xmin               ymax                                                             anchor T+L HORIZ        width 36
    button    .mainDeleteLadder     linklabel      'Ladder'            at xmin.createTask+1  ymax+0.2     callback '!this.deleteLadder()'                                             width 4
    button    .mainDeleteSideExit   linklabel      'Side Exit'         at xmin.createTask+1  ymax+0.2     callback '!this.sideExit()'                                                 width 5
    paragraph .exitIcon             anchor T+L                         at x0                 ymax+1       pixmap                                                                      width 16 height 16
    button    .exitLadder           linklabel      'Exit'              at xmax+1             ymin         callback '!this.closeForm()'                                                     width 5

  exit


  frame .frGeneralLadder panel      anchor T+L+R                       at x0                 y0

    -- General Attributes
    paragraph .generalTask                                             at xmin form          ymin+0.2 text 'General Attributes'                                                       width 13
    line      .generalTaskLine                                         at xmin               ymax-0.2                                                         anchor T+L  HORIZ       width 39
    text      .txNameLadder                         'Name:'            at xmin+1             ymax+0.5     callback '!this.checkName(!this.txNameLadder,!this.meLadderEngine.ladderData.name)'    anchor L+T tagwidth 11   width 23  is STRING format !!distanceFmt
    text      .txDescLadder                         'Description:'     at xmin.txNameLadder  ymax+0.2     callback ''                                         anchor L+T tagwidth 11  width 23                                      is STRING format !!distanceFmt
    numericinput .dbArea 'Area:'     tagwidth 11 anchor T+L            at xmin.txNameLadder  ymax+0.2     callback '' range 0 10000 ndp 0 width 6
    numericinput .dbNumber 'Number:' tagwidth 7 anchor T+L             at xmax               ymin         callback '' range 0 10000 ndp 0 width 6

    -- Geometry Definition
    paragraph .geometryTask                                            at xmin form          ymax+0.5 text 'Position and Direction'                                                   width 20
    line      .geometryTaskLine                                        at xmin               ymax-0.2                                                         anchor T+L  HORIZ       width 39

    paragraph .paUWP                                                 at xmin+1             ymax+0.2 text 'Upper Work Point'
    --line      .lnUWP                                                 at xmin               ymax-0.2                                                         anchor T+L HORIZ        width 35
    --frame .frUWP  panel 'Upper Work Point'                                   at x0                 ymax+0.5                                                                                 width 35
      button    .lkUWP              linklabel        'Pick Position'   at xmin+1             ymax+0.2     callback '!this.pickUWP()'                                                  width 11
      container .netLadderUWPFrame PMLNetCONTROL 'NET'                 at xmin.lkUWP         ymax                                                             anchor L+T              width 35 heigh 4
    --exit

    paragraph .paLWP                                                 at xmin.paUWP         ymax+0.5 text 'Lower Work Point'
    --line      .lnLWP                                                 at xmin               ymax-0.2                                                         anchor T+L HORIZ        width 35
    frame .frgeometry  panel  'Lower Work Point'                             at x0                 ymax+0.2                                                                                 width 33
      rtoggle .rtPoistion   tagwidth 5 'Position'      anchor T+L      at xmin+1             ymax+0.1
      rtoggle .rtPlane      tagwidth 5 'Plane'         anchor T+L      at xmax.rtPoistion+2  ymin

      frame     .frLowerPosition    panel  'Lower Position Definition' at xmin.rtPoistion    ymax+0.1                                                         anchor T+L              width 34 height 5
        button    .lkLWP            linklabel        'Pick Position'   at xmin.lkUWP         ymin         callback '!this.pickLWP()'                                                  width 11
        container .netLadderLWPFrame PMLNetCONTROL 'NET'               at xmin.lkUWP         ymax+0.2                                                         anchor L+T              width 34 heigh 4
      exit
      frame     .frLowerPlane       panel  'Lower Plane Definition'    at xmin.rtPoistion    ymin                                                             anchor T+L              width 34 height 5
        button    .lkLPlane         linklabel        'Pick Plane'      at xmin.rtPoistion    ymin         callback '!this.pickLWPlane()'                                              width 11
        text      .txExplicitDir                     'Direction:'      at xmin.lkLPlane      ymax+0.2     callback '!this.validateDirection()'                           tagwidth 9   width 15                                      is STRING
        text      .txPitchLadder                     'Pitch:'          at xmin.txExplicitDir ymax+0.2     callback '!this.evaluatePitch()'                    anchor L+T tagwidth 9   width 15                                      is REAL format !!realFmt
        button    .toAidPitchLadder                  toggle pixmap     at xmax+5             ymin         callback '!this.showDimFeedbackLadder('             anchor T+L              width 16 height 16
        text      .txHeightLadder                    'Overall Rise:'   at xmin.txExplicitDir ymax+0.2     callback '!this.calculateLowerPosition()'           anchor L+T tagwidth 9   width 15                                      is REAL format !!distanceFmt
        button    .toAidHeightLadder                 toggle pixmap     at xmax+5             ymin         callback '!this.showDimFeedbackLadder('             anchor T+L              width 16 height 16
      exit
    exit
    -- Installation Options
    paragraph .installationTask                                        at xmin form          ymax+0.5 text 'Installation and Assembly Options'                                        width 25
    line      .installationTaskLine                                    at xmin               ymax-0.2                                                         anchor T+L  HORIZ       width 39

    option    .opTopAccessTypeLadder                'Top Exit Type:'   at xmin+1             ymax+0.3     callback '!this.topExitType()'                      anchor L+T  tagwidth 11 width 21
    option    .opLadderTmplReferenceLadder          'Assembly '        at xmin               ymax+0.2     callback '!this.modifyLadderTmplRef('               anchor L+T  tagwidth 11 width 21

    paragraph .performTask                                             at xmin form          ymax+0.5 text 'Perform Tasks'                                                            width 13
    line      .performTaskLine                                         at xmin               ymax-0.2                                                         anchor T+L  HORIZ       width 39

    frame     .frModifyTask           panel                 ''         at xmin form          ymax+0.1                                                         anchor L+T              width 39

      button    .modifyGeometry     linklabel 'Evaluate Ladder'        at x2                 ymax+0.2     callback '!this.evaluate()'                                                 width 10
      --Ladder Detailed Attributes
      button    .lkLadderModDetail  linklabel 'Detailed Attributes...' at x2                 ymax+0.2     callback '!this.frameChange(!this.frDetailLadder)'                          width 15

      --Side Exits
      button    .lkLadderSideExit   linklabel 'Ladder Side Exits...'   at x2                 ymax+0.2     callback '!this.frameChange(!this.frAccessLadder)'                          width 15

      paragraph .acceptLadderIcon                                      at x2                 ymax+0.2     pixmap                                                                      width 16 height 16
      button    .acceptLadder       linklabel 'Accept Changes'         at xmax+1             ymin         callback '!this.modifyLadder()'                     anchor T+L              width 10

      paragraph .discardModLadderIcon                   anchor T+L     at xmax form -20      ymin         pixmap                                                                      width 16 height 16
      button    .discardModLadder   linklabel     'Discard Changes'    at xmax+1             ymin         callback '!this.discardLadder()'                    anchor T+L              width 10

      paragraph .ladderModBackToMainIcon1                              at x0.5               ymax+0.2     pixmap                                                                      width 15 height 15
      button    .ladderModBackToMain1 linklabel 'Back to Main Ladder Tasks' at xmax+1        ymin         callback '!this.frameChange(!this.frMainPane)'                              width 17

    exit

    frame     .frCreateTask          panel               ''            at xmin.frModifyTask  ymin.frModifyTask                                                anchor L+T              width 39

      button    .defineGeometry    linklabel 'Evaluate Ladder'         at x2                 ymax+0.2     callback '!this.evaluate()'                                                 width 10
      --Ladder Detailed Attributes
      button    .lkLadderCreDetail linklabel 'Detailed Attributes...'  at x2                 ymax+0.2     callback '!this.frameChange(!this.frDetailLadder)'                          width 12

      --Tasks
      paragraph .createLadderIcon                                      at x2                 ymax+0.5     pixmap                                                                      width 15 height 15
      button    .createLadder         linklabel      'Create Ladder'   at xmax+1             ymin         callback '!this.createLadder()'                                             width 10

      paragraph .ladderCreBackToMainIcon1                              at x2                 ymax+0.2     pixmap                                                                      width 15 height 15
      button    .ladderCreBackToMain1 linklabe 'Back to Main Ladder Tasks' at xmax+1         ymin         callback '!this.frameChange(!this.frMainPane)'                              width 17

    exit
  exit
  -- ladder Position
  ------------------------------------------------------------------------------------------------------------------------------------------------------
  frame .frDetailLadder panel                       anchor T+L+R       at x0                 y0
     paragraph .detailAtt                                              at xmin form          ymin+0.2 text 'Detailed Attributes'                                                      width 20
     line      .detailAttLine                                          at xmin               ymax-0.2                                                         anchor T+L  HORIZ       width 39

     text      .txWidthLadder              'Width:'                    at xmin+1             ymax+0.2     callback ''                                         anchor T+L tagwidth 17  width 12                                      is REAL format !!distanceFmt
     button    .toAidWidthLadder            toggle pixmap              at x35                ymin         callback '!this.showDimFeedbackLadder('             anchor T+L              width 16 height 16
     text      .txRiseLadder               'Rise:'                     at xmin.txWidthLadder ymax+0.2     callback ''                                         anchor T+L tagwidth 17  width 12                                      is REAL format !!distanceFmt
     button    .toAidRiseLadder             toggle pixmap              at x35                ymin         callback '!this.showDimFeedbackLadder('             anchor T+L              width 16 height 16
     text      .txLRiseLadder              'Distance to first rung:'   at xmin.txWidthLadder ymax+0.2     callback ''                                         anchor T+L tagwidth 17  width 12                                      is REAL format !!distanceFmt
     button    .toAidLRiseLadder            toggle pixmap              at x35                ymin         callback '!this.showDimFeedbackLadder('             anchor T+L              width 16 height 16
     text      .txExtensionLadder          'Extension above ladder:'   at xmin.txWidthLadder ymax+0.2     callback ''                                         anchor T+L tagwidth 17  width 12                                      is REAL format !!distanceFmt
     button    .toAidExtensionLadder        toggle pixmap              at x35                ymin         callback '!this.showDimFeedbackLadder('             anchor T+L              width 16 height 16
     text      .txheadroomLadder           'Headroom:'                 at xmin.txWidthLadder ymax+0.2     callback ''                                         anchor T+L tagwidth 17  width 12                                      is REAL format !!distanceFmt
     button    .toAidHeadroomLadder         toggle pixmap              at x35                ymin         callback '!this.showDimFeedbackLadder('             anchor T+L              width 16 height 16
     text      .txFootRoomLadder           'Clearance to obstruction:' at xmin.txWidthLadder ymax+0.2     callback ''                                         anchor T+L tagwidth 17  width 12                                      is REAL format !!distanceFmt
     button    .toAidFootRoomLadder         toggle pixmap              at x35                ymin         callback '!this.showDimFeedbackLadder('             anchor T+L              width 16 height 16
     text      .txCageOffsetLadder         'Cage offset:'              at xmin.txWidthLadder ymax+0.2     callback ''                                         anchor T+L tagwidth 17  width 12                                      is REAL format !!distanceFmt
     button    .toAidCageOffsetLadder       toggle pixmap              at x35                ymin         callback '!this.showDimFeedbackLadder('             anchor T+L              width 16 height 16
     text      .txCageSizeLadder           'Cage size:'                at xmin.txWidthLadder ymax+0.2     callback ''                                         anchor T+L tagwidth 17  width 12                                      is REAL format !!distanceFmt
     button    .toAidCageSizeLadder         toggle pixmap              at x35                ymin         callback '!this.showDimFeedbackLadder('             anchor T+L              width 16 height 16
     text      .txCageHoopDist             'Distance between Hoops :'  at xmin.txWidthLadder ymax+0.2     callback ''                                         anchor T+L tagwidth 17  width 12                                      is REAL format !!distanceFmt
     --button    .toAidCageHoopLadder         toggle pixmap              at x35                ymin         callback '!this.showDimFeedbackLadder('             anchor T+L              width 16 height 16


     numericinput .rungAngle 'Rung Orientation:' tagwidth 17 anchor T+L   at xmin.txWidthLadder  ymax+0.2     callback '' range 0 360 ndp 0 width 6

     paragraph .acceptTask                                             at xmin form          ymax+0.5 text 'Perform Tasks'                                                            width 20
     line      .acceptTaskLine                                         at xmin               ymax-0.2                                                         anchor T+L  HORIZ       width 39

     paragraph .acceptLadderDetailIcon                                 at xmin+1             ymax+0.2     pixmap                                                                      width 16 height 16
     button    .acceptLadderDetail linklabel   'Accept Changes'        at xmax+1             ymin         callback '!this.acceptDetailAttributes()'           anchor T+L              width 10

     paragraph .discardLadderDetailIcon                   anchor T+L   at xmax.acceptLadderDetail+8 ymin  pixmap                                                                      width 16 height 16
     button    .discardLadderDetail linklabel  'Discard Changes'       at xmax+1             ymin         callback '!this.discardLadder()'                    anchor T+L              width 10

     paragraph .ladderBackToCreateIcon1                                at xmin.acceptLadderDetailIcon  ymax+0.5  pixmap                                                               width 15 height 15
     button    .ladderBackToCreate1 linklabel 'Back to Create Ladder'  at xmax+1             ymin         callback '!this.frameChange(!this.frGeneralLadder)'                         width 17

     paragraph .ladderBackToMainIcon2                                  at xmin.acceptLadderDetailIcon  ymax+0.2  pixmap                                                               width 15 height 15
