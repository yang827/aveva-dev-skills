   button     .lkLdrStrSpec      linklabel        'Stringer Profile'   at x1.5               ymax+0.5     callback '!this.selectProfile(2)' anchor L+T         width 15
   text       .txLdrStrSpec                                            at xmax+1             ymin                                                             anchor L+T              width 13 is STRING

   --paragraph  .ldrStrSpecAcceptIcon                       anchor T+L   at x0                 ymax+0.5     pixmap                                                                      width 16 height 16
