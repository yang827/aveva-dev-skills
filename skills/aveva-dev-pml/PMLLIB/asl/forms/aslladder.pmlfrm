   button     .lkLdrCagSpec      linklabel        'Cage Profile'       at x1.5               ymax+0.5     callback '!this.selectProfile(1)' anchor L+T         width 15
   text       .txLdrCagSpec                                            at xmax+1             ymin                                                             anchor L+T              width 13 is STRING

   --paragraph  .ldrCagSpecAcceptIcon                       anchor T+L   at x0                 ymax+0.5     pixmap                                                                      width 16 height 16
   --button     .ldrCagSpecAccept  linkLabel        'Accept Changes'     at xmax+0.5           ymin         callback '!this.acceptSpec(|CAGE|)'                 anchor T+L              width 10


   -- Ladder Rungs Spec
