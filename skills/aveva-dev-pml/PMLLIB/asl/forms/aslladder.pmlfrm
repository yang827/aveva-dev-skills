  -- Side exits
    ---------------------------------------------------------------------------
  frame .frAccessLadder panel                        anchor T+L+R      at x0                 y0                                                                                                                                                                                                                                                                  width 36
    container .coAccessLadder PMLNetCONTROL                            at x1                                                                                  anchor T+L              width 33 height 10
    button    .lkCreateAccessLadder linklabel 'Create'                 at                    ymax+0.1      callback '!this.newAccessLadder()'                                         width 25
    button    .lkPickAccessLadder   linklabel 'Pick position'          at                    ymax+0.1      callback '!this.pickAccessLadder()'                                        width 25
    button    .lkDeleteAccessLadder linklabel 'Delete selected'        at                    ymax+0.1      callback '!this.deleteAccessLadder()'                                      width 25
    button    .lkAidAccessLadder    linklabel 'Display dimensions'     at                    ymax+0.1                                     callback '!this.showDimFeedbackLadder('     width 25
    paragraph .ladderBackToCreateIcon2                                 at x0                 ymax+0.5      pixmap                                                                     width 15 height 15
    button    .ladderBackToCreate2  linklabel 'Back to Create Ladder'  at xmax+1             ymin          callback '!this.frameChange(!this.frGeneralLadder)'                        width 17
    paragraph .ladderBackToMainIcon4                                   at x0                 ymax+0.5      pixmap                                                                     width 15 height 15
    button    .ladderBackToMain4    linklabel 'Back to Main Ladder Tasks' at xmax+1          ymin          callback '!this.frameChange(!this.frMainPane)'                             width 17
  exit

  ---------------------------------------------------------------------------
  -- Form Members

  member .meLadderEngine        is ASLLADDERENGINE
  member .meOldLadderData       is ASLLADDERDATA
  member .mode                  is STRING
  member .ladder                is DBREF
  member .lWP                   is POSITION
  member .uWP                   is POSITION
  member .derivedLWP 						is POSITION
  member .derivedUWP						is POSITION
  member .oRise                 is REAL
  member .pitch                 is REAL
  member .direction             is DIRECTION
  member .definedGeometry       is BOOLEAN
  member .errorState            is BOOLEAN
  ---------------------------------------------------------------------------
  -- my .Net control
  member .neAccessLadder        is NETGRIDCONTROL

  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'
  member .ladderLWPControl      is POSITIONCONTROL
  member .ladderUWPControl      is POSITIONCONTROL

  --Specifications
  member .cageSpec              is DBREF
  member .stringerSpec          is DBREF
  member .rungSpec              is DBREF

  --Aid Numbers
  member .lwpAidNumber          is REAL
  member .uwpAidNumber          is REAL


  member .profileData     is ARRAY
  member .profileDataGadget is ARRAY
  member .profileDataDesc   is ARRAY

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslLadder
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslLadder()

  --Implementation of positional control

  ------------------Setup for position control-----------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  --Create new instance of position control
  !this.ladderLWPControl      = object POSITIONCONTROL()
  !this.ladderUWPControl      = object POSITIONCONTROL()

  --Load ship grid data
  !grid                       = object SHIPGRID()
  !gridDefined                = !grid.position.set()

  -- Only populate the grid data if a ship reference grid is available
  if(!gridDefined) then

    do !i indices !grid.xID
      !xGridData[!i][1]       = !grid.xID[!i]
      !xGridData[!i][2]       = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]       = !grid.yID[!i]
      !yGridData[!i][2]       = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]       = !grid.zID[!i]
      !zGridData[!i][2]       = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.ladderLWPControl.gridData(!xGridData,!yGridData,!zGridData)
    !this.ladderUWPControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    !this.ladderLWPControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
    !this.ladderUWPControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
    -- Set position column heading
    !this.ladderLWPControl.heading('World Position')
    !this.ladderUWPControl.heading('World Position')
    !this.ladderLWPControl.gridFormat()
    !this.ladderUWPControl.gridFormat()
  else
    var !coordinate coordinate
    if(!coordinate.eq('ENU'))then
      !this.ladderLWPControl.enuFormat()
      !this.ladderUWPControl.enuFormat()
    else
      !this.ladderLWPControl.xyzFormat()
      !this.ladderUWPControl.xyzFormat()
    endif
    !this.ladderLWPControl.gridVisible(false)
    !this.ladderUWPControl.gridVisible(false)
  endif

  !this.ladderLWPControl.changeAction('!!aslLadder.deriveLWP()')
  !this.ladderUWPControl.changeAction('!!aslLadder.deriveUWP()')
  -- End of codes for Implementing positional control

   -- Add PMLNet control to PML frame
  !this.netLadderLWPFrame.control  = !this.ladderLWPControl.handle()
  !this.netLadderUWPFrame.control  = !this.ladderUWPControl.handle()
  using namespace 'Aveva.Pdms.Presentation'

  -- general form data
  !this.autoscroll   = true
  !this.callback     = '!this.setup()'
  !this.formRevision = ' $Revision$ '
  !this.formTitle    = 'Ladder Definition'
  !this.quitCall     = '!this.closeForm()'
  !this.killingCall  = '!this.closeForm()'

  !this.lwpAidNumber        = !!aidNumbers.add('LWP')
  !this.uwpAidNumber        = !!aidNumbers.add('UWP')

  ---------------------------------------------------------------------------
  -- LADDER gadgets
  ---------------------------------------------------------------------------
  -- button pixmap
  !this.createLadderIcon.addPixmap(!!pml.getPathName('create.png'))
  !this.acceptLadderIcon.addPixmap(!!pml.getPathName('accept.png'))
  --!this.ldrStrSpecAcceptIcon.addPixmap(!!pml.getPathName('accept.png'))
  --!this.ldrCagSpecAcceptIcon.addPixmap(!!pml.getPathName('accept.png'))
  !this.ldrRungSpecAcceptIcon.addPixmap(!!pml.getPathName('accept.png'))
  !this.discardModLadderIcon.addPixmap(!!pml.getPathName('discard.png'))
  !this.acceptLadderDetailIcon.addPixmap(!!pml.getPathName('accept.png'))
  !this.discardLadderDetailIcon.addPixmap(!!pml.getPathName('discard.png'))
  !this.ladderCreBackToMainIcon1.addPixmap(!!pml.getPathName('back.png'))
  !this.ladderModBackToMainIcon1.addPixmap(!!pml.getPathName('back.png'))
  !this.ladderBackToMainIcon2.addPixmap(!!pml.getPathName('back.png'))
  !this.ladderBackToMainIcon3.addPixmap(!!pml.getPathName('back.png'))
  !this.ladderBackToMainIcon4.addPixmap(!!pml.getPathName('back.png'))
  !this.ladderBackToCreateIcon1.addPixmap(!!pml.getPathName('back.png'))
  !this.ladderBackToCreateIcon2.addPixmap(!!pml.getPathName('back.png'))
  !this.exitIcon.addPixmap(!!pml.getPathName('back.png'))
  -- button pixmap  for dimensions
  !this.toAidCageOffsetLadder.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidCageOffsetLadder.setTooltip('Display cage offset')
  --!this.toAidCageHoopLadder.addPixmap(!!pml.getPathName('measure16.png'))
  --!this.toAidCageHoopLadder.setTooltip('Display Distance between cage hoops')
  !this.toAidWidthLadder.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidWidthLadder.setTooltip('Display Width of ladder')
  !this.toAidCageSizeLadder.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidCageSizeLadder.setTooltip('Display size of cage')
  !this.toAidExtensionLadder.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidExtensionLadder.setTooltip('Display distance cage above ladder')
  !this.toAidHeadroomLadder.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidHeadroomLadder.setTooltip('Display headroom')
  !this.toAidHeightLadder.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidHeightLadder.setTooltip('Display height')
  !this.toAidLRiseLadder.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidLRiseLadder.setTooltip('Display distance to first rung')
  !this.toAidFootRoomLadder.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidFootRoomLadder.setTooltip('Display distance to any obstruction')
  !this.toAidPitchLadder.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidPitchLadder.setTooltip('Display pitch')
  !this.toAidRiseLadder.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidRiseLadder.setTooltip('Display rise')

  -- exit types
  !exitTypeDText    = object ARRAY()
  !exitTypeDText.append('Front')
  !exitTypeDText.append('Left')
  !exitTypeDText.append('Right')
  !exitTypeDText.append('Back')
  !this.opTopAccessTypeLadder.dText = !exitTypeDText
  !exitTypeRText    = object ARRAY()
  !exitTypeRText.append('TFRO')
  !exitTypeRText.append('TLEF')
  !exitTypeRText.append('TRIG')
  !exitTypeRText.append('TBAC')
  !this.opTopAccessTypeLadder.rText = !exitTypeRText

  !this.txLdrCagSpec.active     = false
  !this.txLdrRungSpec.active    = false
  !this.txLdrStrSpec.active     = false
  !defaultDir                   = object DIRECTION('N')
  !this.txExplicitDir.val       = !defaultDir.string().before('WRT').trim()

   -- Validate calls for text fields
 	!this.txWidthLadder.callback          = '!this.validationTextGadgets(!this.txWidthLadder,       !this.meLadderEngine.ladderCriteria.width,      !this.meLadderEngine.ladderData.width)'
 	--!this.txPitchLadder.validateCall  	  = '!this.validationTextGadgets(!this.txPitchLadder,			  !this.meLadderEngine.ladderCriteria.pitch,      !this.meLadderEngine.ladderData.pitch)'
 	!this.txRiseLadder.callback 					= '!this.validationTextGadgets(!this.txRiseLadder,  			!this.meLadderEngine.ladderCriteria.rise,       !this.meLadderEngine.ladderData.rise)'
 	!this.txLRiseLadder.callback					=	'!this.validationTextGadgets(!this.txLRiseLadder,    		!this.meLadderEngine.ladderCriteria.lRise,      !this.meLadderEngine.ladderData.lRise)'
 	!this.txExtensionLadder.callback			= '!this.validationTextGadgets(!this.txExtensionLadder,		!this.meLadderEngine.ladderCriteria.extension,  !this.meLadderEngine.ladderData.extension)'
 	!this.txheadroomLadder.callback				= '!this.validationTextGadgets(!this.txheadroomLadder,		!this.meLadderEngine.ladderCriteria.headroom,   !this.meLadderEngine.ladderData.lExit.headroom)'
 	!this.txFootRoomLadder.callback 			= '!this.validationTextGadgets(!this.txFootRoomLadder,		!this.meLadderEngine.ladderCriteria.footroom,   !this.meLadderEngine.ladderData.footroom)'
 	!this.txCageOffsetLadder.callback 		= '!this.validationTextGadgets(!this.txCageOffsetLadder,	!this.meLadderEngine.ladderCriteria.cageOffset, !this.meLadderEngine.ladderData.cageOffset)'
 	!this.txCageSizeLadder.callback 			= '!this.validationTextGadgets(!this.txCageSizeLadder,		!this.meLadderEngine.ladderCriteria.cageSize,   !this.meLadderEngine.ladderData.cageSize)'
 	!this.txCageHoopDist.callback         = '!this.validationTextGadgets(!this.txCageHoopDist,      !this.meLadderEngine.ladderCriteria.hoopDistance, !this.meLadderEngine.ladderData.hoopDistance)'
 	--!this.txStringerDistLadder.callback =	'!this.validationTextGadgets(!this.txStringerDistLadder,!this.meLadderEngine.ladderCriteria.stringerDist)'
  --!this.txExplicitDir.validateCall      = '!this.validateDirection()'

  -- implement the .NET control
  ---------------------------------------------------------------------------
  -- create instance of .Net control
  !this.neAccessLadder = object NETGRIDCONTROL()

  -- add PML event handlers to .Net control
  !this.neAccessLadder.addeventhandler('AfterCellUpdate',  !this, 'modifyAccessLadder')
  !this.neAccessLadder.addeventhandler('AfterSelectChange', !this, 'selectAccessLadder')
  !this.neAccessLadder.columnExcelFilter(false)
  !this.neAccessLadder.outlookGroupStyle(false)
  !this.neAccessLadder.fixedHeaders(true)
  !this.neAccessLadder.fixedRows(true)
  !this.neAccessLadder.editableGrid(true)
  !this.neAccessLadder.headerSort(false)

  -- create the value list for the exit type column
  --!exitTypes[1] = 'Back'
  !exitTypes[1] = 'Left'
  !exitTypes[2] = 'Right'
  --!exitTypes[4] = 'Left&Right'
  !this.neAccessLadder.createValueList('ExitTypes', !exitTypes)

  -- add .Net control to PML container
  !this.coAccessLadder.control = !this.neAccessLadder.handle()

  !this.frameChange(!this.frMainPane)
  !this.meLadderEngine               = object ASLLADDERENGINE()
  !ladderTmplReference               = !this.opLadderTmplReferenceLadder.selection().dbref()
  !this.meLadderEngine.newDefaults(!ladderTmplReference)
  !this.meOldLadderData = !this.meLadderEngine.ladderData
  !this.updateLimitsLadder()
  !this.errorState = false

   -- declare profile data
  !this.profileData[1] = object PROFILECATALOGUEDATA()
  !this.profileData[2] = object PROFILECATALOGUEDATA()
  !this.profileData[3] = object PROFILECATALOGUEDATA()
  !this.profileDataDesc[1] = !this.lkLdrCagSpec.tag
  !this.profileDataDesc[2] = !this.lkLdrStrSpec.tag
  !this.profileDataDesc[3] = !this.lkLdrRungSpec.tag
  !this.profileDataGadget[1] = !this.txLdrCagSpec
  !this.profileDataGadget[2] = !this.txLdrStrSpec
  !this.profileDataGadget[3] = !this.txLdrRungSpec

endmethod
------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !originalName is STRING)

  -- Initialise Variables

  -- If gadget name is same as original name, then do nothing.
  if(!gadget.val.eq(!originalName)) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!gadget.val, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = STRING()
  else
    -- Remove leading slash
    !name         = !name.trim('L','/')
    !gadget.val   = !name
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      closeForm
--
-- Description:  closes the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .closeForm()

  -- clears the whole graphical feedback
  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()
  !!aidNumbers.hide(!this.lwpAidNumber)
  !!aidNumbers.hide(!this.uwpAidNumber)

  --end EDG
  !!edgCntrl.remove('ASL EDG Pick')
  !this.hide()
  pml reload form !!sectionProfileSelection

endmethod
-- End of method
-----------------------------------------------------------------------
--
-- Method:      create
--
-- Description: create mode Settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .create()

  !this.mode                            = 'Create'

  !this.createLadder.active             = false
  !this.frModifyTask.visible            = false
  !this.frCreateTask.visible            = true
  !this.definedGeometry                 = false
  !this.toAidCageOffsetLadder.visible   = false
  !this.toAidCageSizeLadder.visible     = false
  !this.toAidExtensionLadder.visible    = false
  !this.toAidFootRoomLadder.visible     = false
  !this.toAidHeadroomLadder.visible     = false
  !this.toAidHeightLadder.visible       = false
  !this.toAidLRiseLadder.visible        = false
  !this.toAidPitchLadder.visible        = false
  !this.toAidRiseLadder.visible         = false
  !this.toAidWidthLadder.visible        = false
  !this.lkLadderSideExit.visible        = false
  !this.meLadderEngine.ladderData.refe  = object DBREF()
  !this.meLadderEngine               = object ASLLADDERENGINE()
  !ladderTmplReference               = !this.opLadderTmplReferenceLadder.selection().dbref()
  !this.meLadderEngine.newDefaults(!ladderTmplReference)
  !this.meOldLadderData = !this.meLadderEngine.ladderData
  !this.ladderLWPControl.xyz(0,0,0)
  !this.ladderUWPControl.xyz(0,0,0)
  !this.updateFrameLadder()
  !this.txHeightLadder.val            = !this.meLadderEngine.getORise()
  !this.txPitchLadder.val             = !this.meLadderEngine.getPitch()
  !this.txExplicitDir.val             = !this.meLadderEngine.getDirection().string().before('WRT')
  !this.updateCoordinateSystem()

  ---- updates the limits
  !this.updateLimitsLadder()
  --

  -- calculate the ladder
  --!this.meLadderEngine.evaluate()
  --!this.showVolFeedbackLadder()
  !this.uWP     = object POSITION()
  !this.lWP     = object POSITION()
  !this.frameChange(!this.frGeneralLadder)

endmethod
-- End of method
-----------------------------------------------------------------------
--
-- Method:      createLadder
--
-- Description: create new ladder
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .createLadder()

  if(!this.definedGeometry)then
    !this.updateAttributes()
    !this.evaluateLadder()
    if(!this.meLadderEngine.ladderData.error.not())then
      !this.meOldLadderData = !this.meLadderEngine.ladderData
      !this.modify()
    endif
    !this.meLadderEngine.resetError()

  else
    !!alert.error('Not able to create Ladder.Geometry is not defined.')
    return
  endif
  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()
  !!aidNumbers.hide(!this.lwpAidNumber)
  !!aidNumbers.hide(!this.uwpAidNumber)
endmethod
-- End of method
-----------------------------------------------------------------------
--
-- Method:      modifyLadder
--
-- Description: Modify  ladder
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyLadder()

  !this.updateAttributes()
  !this.evaluateLadder()
  !this.meOldLadderData = !this.meLadderEngine.ladderData
  !this.meLadderEngine.resetError()
  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()
  !!aidNumbers.hide(!this.lwpAidNumber)
  !!aidNumbers.hide(!this.uwpAidNumber)

endmethod
-- End of method
-----------------------------------------------------------------------
--
-- Method:      discardLadder
--
-- Description: Discard changes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .discardLadder()

  !this.meLadderEngine.ladderData = !this.meOldLadderData
  !this.updateFrameLadder()
  if(!this.meLadderEngine.ladderData.uWP.set() and !this.meLadderEngine.ladderData.lWP.set())then
    !this.meLadderEngine.evaluate()
    !this.showVolFeedbackLadder()
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      deleteAccessLadder
--
-- Description: implements new Access point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deleteAccessLadder()

  if ( !!alert.confirm('Do you really want to delete the selected side exit?').neq('YES') ) then
    return
  endif

  -- loop through the selected rows and delete the respective gate
  do !row value !this.neAccessLadder.getSelectedRows()
    !index = !row[1].real()
    !this.meLadderEngine.remSideExit(!index)
  enddo
  !this.meLadderEngine.compressSideExits()

  -- evaluate the ladder
  !this.evaluateLadder()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteLadder
--
-- Description: delete ladder
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deleteLadder()

 !undo = object UNDOABLE()
 !undo.description('Delete Ladder')
 !undo.add()

  -- check if you are below a LADDER element
  LADDER
  handle ANY
    !!alert.warning('Not below LADDER hierarchy')
    return
  endhandle

  call !!aslEnhance(!!ce)
  if ( !!alert.confirm('Do you really want to delete the current ladder?').eq('NO') ) then
    call !!aslUnEnhance(!!ce)
    return
  endif

  DELETE LADDER
  !!aidNumbers.hide(!this.lwpAidNumber)
  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()

  !undo.endundoable()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLadder
--
-- Description: Derive ladder from returned pick data and selections on the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateLadder()

  -- set the template reference and the criterion reference
  !ladderTmplReference = !this.opLadderTmplReferenceLadder.selection().dbref()
  !this.meLadderEngine.setTmplReference(!ladderTmplReference)
  !this.meLadderEngine.setSettingReference()

  -- calculate the ladder
  !this.meLadderEngine.evaluate()

  -- check if an error occurred
  if ( !this.meLadderEngine.getError() ) then
    !!alert.error(!!error.text)
    !this.meLadderEngine.resetError()
    return
  endif
  -- create the ladder
  !this.meLadderEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- check if an error occurred
  if ( !this.meLadderEngine.getError() ) then
    !!alert.error(!!error.text)
    return
  endif

  -- update the gadgets
  !this.updateFrameLadder()
  !!aslCentralData.clearDimFeedback()
endmethod
-- End of method
----------------------------------------------------------------------
--
-- Method:      evaluate
--
-- Description: evaluate Ladder
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluate()

  !minHeight = !this.meLadderEngine.ladderCriteria.oRise.min()
  !maxHeight = !this.meLadderEngine.ladderCriteria.oRise.max()

  !error  = object STRING()
  !this.definedGeometry  = true
  if(!this.uWP.unset())then
     !east    = !!aslLadder.ladderUWPControl.xyz()[0].string()
     !north   = !!aslLadder.ladderUWPControl.xyz()[1].string()
     !up      = !!aslLadder.ladderUWPControl.xyz()[2].string()
     !this.uWP = object POSITION('E $!east N $!north U $!up wrt /* ')
  elseif(!this.lWP.unset())then
     !this.deriveLWP()
  endif

  !height          = !this.txHeightLadder.val
  !pitch           = !this.txPitchLadder.val


  -- checks the validity of the picks
  ---------------------------------------------------------------------------
  -- height
  if(!height lt 0)then
    !error = 'Upper working point elevation should be greater than the elevation of lower working point.'
    !this.definedGeometry = false
  elseif(!height.eq(0)) then
    !error ='Unable to define ladder of zero height.'
    !this.definedGeometry = false
  elseif(!height.between(!minHeight,!maxHeight).not())then
    !error = 'Height is not with in the Limits.($!minHeight to $!maxHeight)'
    !this.definedGeometry  = false
  endif

  if(!this.definedGeometry.not())then
    !!alert.error('Ladder can not be created. $!error')
    return
  endif

  !this.validateDirection()
  if(!!error.text.set() and !!error.text.trim().neq('') and !this.errorState)then
    return
  endif

  !this.evaluatePitch()

  if(!height.lt(!this.meLadderEngine.ladderCriteria.cageladderheight.max()))then
    !this.meLadderEngine.ladderData.cageRequired  = false
  else
    !this.meLadderEngine.ladderData.cageRequired  = true
  endif
  !this.setGeometricalAttributes()
  !this.defineGeometry()
  !this.meLadderEngine.evaluate()
  !this.showVolFeedbackLadder()

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      deriveLWP()
--
-- Description: evaluate picks and create ladder
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deriveLWP()

  !this.acceptLadder.active      = false
  !this.createLadder.active      = false

  !posFmt = !!distanceFmt
  !posFmt.dp = 0
   --set position object with positions, wrt world
  !lwpArray  = !this.ladderLWPControl.xyz()
  !east  = !lwpArray[0].string()
  !north = !lwpArray[1].string()
  !up    = !lwpArray[2].string()
  !this.lWP   = object POSITION('E $!east N $!north U $!up wrt /* ')

   --set position object with positions, wrt world
  !uwpArray  = !this.ladderUWPControl.xyz()
  !east  = !uwpArray[0].string()
  !north = !uwpArray[1].string()
  !up    = !uwpArray[2].string()
  !this.uWP    = object POSITION('E $!east N $!north U $!up wrt /* ')

  if(!this.lwpAidNumber.set())then
    !!aidNumbers.hide(!this.lwpAidNumber)
  else
    !this.lwpAidNumber        = !!aidNumbers.add('LWP')
  endif

  AID SPHERE NUMBER $!<this.lwpAidNumber> $!this.lWP DIAM 100mm
  AID TEXT NUMBER $!<this.lwpAidNumber> 'LWP' at $!this.lWP

  -- evaluates the height and pitch
  !height = !this.uWP.up - !this.lWP.up
  !this.txHeightLadder.val  = !height

  --evaluates the length and direction
  !line             = object LINE(!this.lWP, !this.uWP)
  !ori              = object ORIENTATION('Z is U')
  !plane            = object PLANE(!this.lWP, !ori)
  !projectedLine    = !line.projected(!plane)
  !length           = !projectedLine.length()

  if(!length eq 0)then
    !this.txPitchLadder.val = 90
  else
    !this.txPitchLadder.val  = atan ( !height / !length )
  endif

  -- Direction
  !this.txExplicitDir.val   = !projectedLine.direction().string().before('WRT')
  handle ANY
    !defaultDir             = object DIRECTION('N')
    !this.txExplicitDir.val = !defaultDir.string().before('WRT').trim()
  endhandle

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      deriveUWP()
--
-- Description: evaluate picks and create ladder
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deriveUWP()

  !this.acceptLadder.active      = false
  !this.createLadder.active      = false

  !posFmt = !!distanceFmt
  !posFmt.dp = 0

  --set position object with positions, wrt world
  !uwpArray  = !this.ladderUWPControl.xyz()

  !east  = !uwpArray[0].string()
  !north = !uwpArray[1].string()
  !up    = !uwpArray[2].string()

  !this.uWP    = object POSITION('E $!east  N $!north  U $!up  wrt /*')

  if(!this.uwpAidNumber.set())then
    !!aidNumbers.hide(!this.uwpAidNumber)
  else
    !this.uwpAidNumber        = !!aidNumbers.add('UWP')
  endif

  AID SPHERE NUMBER $!<this.uwpAidNumber> $!this.uWP DIAM 100mm
  AID TEXT NUMBER $!<this.uwpAidNumber> 'UWP' at $!this.uWP

  --!this.ladderUWPControl.xyz(!uWP.east, !uWP.north, !uWP.up)
  !this.lWP = object POSITION()
  !this.rtPlane.active = !this.uWP.set()

endmethod
-- End of method


-----------------------------------------------------------------------
--
-- Method:      setGeometricalAttributes
--
-- Description: Stores Derived lWP,uWP,ORise,Pitch and Direction.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .setGeometricalAttributes()

 --!this.lWP.east     = !this.ladderLWPControl.xyz()[0]
 --!this.lWP.north    = !this.ladderLWPControl.xyz()[1]
 --!this.lWP.up       = !this.ladderLWPControl.xyz()[2]
 --!this.lWP.origin   = World
 --
 --!this.uWP.east     = !this.ladderUWPControl.xyz()[0]
 --!this.uWP.north    = !this.ladderUWPControl.xyz()[1]
 --!this.uWP.up       = !this.ladderUWPControl.xyz()[2]
 --!this.uWP.origin   = World


 !this.oRise        = !this.txHeightLadder.val
 !this.pitch        = !this.txPitchLadder.val
 !this.direction    = !this.txExplicitDir.val.direction()


 !east   = -1 * !this.direction.east * !this.txFootRoomLadder.val
 !north	 = -1 * !this.direction.north * !this.txFootRoomLadder.val
 !up 		 = -1 * !this.direction.up * !this.txFootRoomLadder.val


 !lwpEast  = !this.lWP.east + !east
 !lwpNorth = !this.lWP.north + !north
 !lwpUp		 = !this.lWP.up  + !up

 !uwpEast  = !this.uWP.east + !east
 !uwpNorth = !this.uWP.north + !north
 !uwpUp		 = !this.uWP.up  + !up

 !this.derivedLWP  = object POSITION('E $!lwpEast N $!lwpNorth U $!lwpUp wrt /*')
 !this.derivedUWP  = object POSITION('E $!uwpEast N $!uwpNorth U $!uwpUp wrt /*')


 !this.toAidCageOffsetLadder.visible   = true
 !this.toAidCageSizeLadder.visible     = true
 !this.toAidExtensionLadder.visible    = true
 !this.toAidFootRoomLadder.visible     = true
 !this.toAidHeadroomLadder.visible     = true
 !this.toAidHeightLadder.visible       = true
 !this.toAidLRiseLadder.visible        = true
 !this.toAidPitchLadder.visible        = true
 !this.toAidRiseLadder.visible         = true
 !this.toAidWidthLadder.visible        = true
 !this.lkLadderSideExit.visible        = true

endmethod
--End of method

-----------------------------------------------------------------------
--
-- Method:      evaluatePitch
--
-- Description: evaluate picks and create ladder
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluatePitch()

  !this.acceptLadder.active      = false
  !this.createLadder.active      = false
  !pitch      = !this.txPitchLadder.val
  !minPitch   = !this.meLadderEngine.ladderCriteria.pitch.min()
  !maxPitch   = !this.meLadderEngine.ladderCriteria.pitch.max()
  if(!pitch.between(!this.meLadderEngine.ladderCriteria.pitch.min(),!this.meLadderEngine.ladderCriteria.pitch.max()).not())then
     return error 1 'Pitch is not within the Limits.($!minPitch to $!maxPitch)'
  endif

  !height     = !this.txHeightLadder.val
  !pitch      = !this.txPitchLadder.val
  !direction  = !this.txExplicitDir.val.direction()
  if(!pitch eq 90)then
  	!length = 0
  else
    !length     = !height / tan(!pitch)
  endif
  !lWP        = !this.uWP.offset(!direction.opposite(),!length).offset(D,!height)
  !this.ladderLWPControl.xyz(!lWP.east.string('d2').real(),!lWP.north.string('d2').real(),!lWP.up.string('d2').real())
  !this.lWP   = !lWP
    if(!this.lwpAidNumber.set())then
    !!aidNumbers.hide(!this.lwpAidNumber)
  else
    !this.lwpAidNumber        = !!aidNumbers.add('LWP')
  endif

  AID SPHERE NUMBER $!<this.lwpAidNumber> $!this.lWP DIAM 100mm
  AID TEXT NUMBER $!<this.lwpAidNumber> 'LWP' at $!this.lWP

  !this.updateAttributes()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      frameChange
--
-- Description: make the main frames visible/invisible
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the gadget to be visible
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .frameChange(!gadget is GADGET)

  if ( !gadget.eq(!this.frMainPane) ) then
    !!aslCentralData.clearDimFeedback()
    !!aslCentralData.clearVolFeedback()
    !!aidNumbers.hide(!this.lwpAidNumber)
    !!aidNumbers.hide(!this.uwpAidNumber)
    !this.frMainPane.visible            = true
    !this.frGeneralLadder.visible       = false
    !this.frDetailLadder.visible        = false
    !this.frAccessLadder.visible        = false
    !this.frSpecLadder.visible          = false
    !this.formTitle                     = 'Main Ladder Tasks'
    !this.track()

  elseif ( !gadget.eq(!this.frGeneralLadder) ) then
    !this.frMainPane.visible            = false
    !this.frGeneralLadder.visible       = true
    !this.frDetailLadder.visible        = false
    !this.frAccessLadder.visible        = false
    !this.frSpecLadder.visible          = false
    if(!this.uWP.unset())then
      !this.frgeometry.val              = 1
    else
      !this.frgeometry.val              = 2
    endif
    !this.rtPlane.active                = !this.uWP.set()
    !this.positionOption()
    !this.frgeometry.callback           = '!this.positionOption()'
    !this.formTitle                     = '$!this.mode Ladder '

  elseif ( !gadget.eq(!this.frDetailLadder) ) then
    !this.frMainPane.visible            = false
    !this.frGeneralLadder.visible       = false
    !this.frDetailLadder.visible        = true
    !this.frAccessLadder.visible        = false
    !this.frSpecLadder.visible          = false
    !this.ladderBackToCreate1.tag       = 'Back to $!this.mode Ladder'
    !this.formTitle                     = 'Detailed Attributes'

  elseif ( !gadget.eq(!this.frAccessLadder) ) then
    !this.frMainPane.visible            = false
    !this.frGeneralLadder.visible       = false
    !this.frDetailLadder.visible        = false
    !this.frAccessLadder.visible        = true
    !this.frSpecLadder.visible          = false
    !this.ladderBackToCreate2.tag       = 'Back to $!this.mode Ladder'
    !this.formTitle                     = 'Ladder-Side Exits'

  elseif ( !gadget.eq(!this.frSpecLadder) ) then
    !this.frMainPane.visible            = false
    !this.frGeneralLadder.visible       = false
    !this.frDetailLadder.visible        = false
    !this.frAccessLadder.visible        = false
    !this.frSpecLadder.visible          = true
    if(!this.meLadderEngine.ladderData.cageSpec.unset())then
      !this.txLdrCagSpec.val            = object STRING()
    else
      !this.txLdrCagSpec.val            = !this.meLadderEngine.ladderData.cageSpec.name
    endif

    if(!this.meLadderEngine.ladderData.rungSpec.unset())then
      !this.txLdrRungSpec.val           = object STRING()
    else
      !this.txLdrRungSpec.val           = !this.meLadderEngine.ladderData.rungSpec.name
    endif

    if(!this.meLadderEngine.ladderData.stringerSpec.unset())then
      !this.txLdrStrSpec.val            = object STRING()
    else
      !this.txLdrStrSpec.val            = !this.meLadderEngine.ladderData.stringerSpec.name
    endif

    !this.formTitle                     = 'Specification Details'
  endif
  -- Initialise the progress bar
  !!fmSys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify mode settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modify()

  !this.mode                            = 'Modify'

  !this.meLadderEngine.ladderData.refe  = !!ce
  !this.frModifyTask.visible            = true
  !this.frCreateTask.visible            = false
  --!this.acceptLadder.visible            = true
  --!this.acceptLadderIcon.visible        = true
  --!this.acceptLadder.active             = false
  --!this.lkLadderModDetail.active        = false
  --!this.createLadder.visible            = false
  --!this.createLadderIcon.visible        = false
  !this.discardModLadder.visible           = true
  !this.discardModLadderIcon.visible       = true
  --!this.toAidCageOffsetLadder.visible   = true
  --!this.toAidCageSizeLadder.visible     = true
  --!this.toAidExtensionLadder.visible    = true
  --!this.toAidFootRoomLadder.visible     = true
  --!this.toAidHeadroomLadder.visible     = true
  --!this.toAidHeightLadder.visible       = true
  --!this.toAidLRiseLadder.visible        = true
  --!this.toAidPitchLadder.visible        = true
  --!this.toAidRiseLadder.visible         = true
  --!this.toAidWidthLadder.visible        = true
  !this.lkLadderSideExit.visible        = true
  !this.updateCoordinateSystem()

  -- initialise the data objects

  LADDER
  handle ANY
    !!alert.warning('Not below LADDER hierarchy')
    return
  endhandle
  !this.meLadderEngine = object ASLLADDERENGINE()
  !ladderTmplReference               = !this.opLadderTmplReferenceLadder.selection().dbref()
  !this.meLadderEngine.newDefaults(!ladderTmplReference)
  -- update the new object with the current element
  !this.meLadderEngine.updateDataObj(!!ce)
  handle ANY
    !!alert.error('Unable to Modify: Check that the setting configuration used for this element exists')
    return
  endhandle
  !this.updateFrameLadder()
--  !this.showVolFeedbackLadder()
  !this.definedGeometry = true
  !this.frameChange(!this.frGeneralLadder)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyAccessLadder
--
-- Description: callback when changing the grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       not idea
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyAccessLadder(!array is ARRAY)

  -- means it is OK to change the value
  !array[1] = TRUE

  !allRows   = !this.neAccessLadder.getRows()
  !sideExits = object ARRAY()
  do !i index !allRows
    !row                          = !allRows[!i]
    !sideExit                     = object ASLLADDEREXITDATA()
    --!sideExit.elevation           = object REAL(!row[2],!!distanceFmt)
    --if ( !row[3] inset ('1', 'Back') ) then
      --!sideExit.exitType          = 'BACK'
    if ( !row[3] inset ('1', 'Left') ) then
      !sideExit.exitType          = 'LEFT'
    elseif ( !row[3] inset ('2', 'Right') ) then
      !sideExit.exitType          = 'RIGHT'
    --else
    --  !sideExit.exitType          = 'BOTH'
    endif

    !headroomCriteria		=	!this.meLadderEngine.ladderCriteria.headroom
    !headroomValue      = !this.meLadderEngine.ladderData.lExit.headroom
    !headroomToValidate = object REAL(!row[4],!!distanceFmt)

    !heightCriteria		=	!this.meLadderEngine.ladderCriteria.oRise
    !heightValue      = !this.meLadderEngine.ladderData.sideExits[!i].elevation
    !heightToValidate = object REAL(!row[2],!!distanceFmt)

    !headroom           = !this.validateHeadroomAccessLadder(!headroomToValidate,!headroomCriteria,!headroomValue)
    !validHeight        = !this.validateSideExitElevation(!heightToValidate,!i)
    if(!validHeight)then
    	!height 						= !this.validateElevationAccessLadder(!heightToValidate,!heightCriteria,!heightValue)
    else
      !height             = !heightValue
    endif

    !sideExit.elevation  = !height
    !sideExit.headroom            = !headroom
    !sideExit.distancePrevCage    = object REAL(!row[5],!!distanceFmt)

    !sideExits.append(!sideExit)
  enddo
  !this.meLadderEngine.setSideExits(!sideExits)

  -- create the ladder
  !this.meLadderEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- check if an error occurred
  if ( !this.meLadderEngine.getError() ) then
    !!alert.error(!!error.text)
    !this.meLadderEngine.resetError()
    return
  endif

  -- update the form
  !this.updateAccessLadder()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyLadder
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateAttributes()

 !undo = object UNDOABLE()
 !undo.description('Modify Ladder')
 !undo.undoAction('!!aslLadder.modify()')
 !undo.add()

 -- Name
 !this.meLadderEngine.ladderData.name = !this.txNameLadder.val

 --function
 --!this.meLadderEngine.ladderData.function   = !this.txFunctionLadder.val

 -- Description
 !this.meLadderEngine.ladderData.description  = !this.txDescLadder.val
 --area
 !this.meLadderEngine.ladderData.area       = !this.dbArea.val

 --number
 !this.meLadderEngine.ladderData.number     = !this.dbNumber.val

  -- width
 !this.meLadderEngine.setWidth(!this.txWidthLadder.val)

  -- type of top exit
 !this.meLadderEngine.setUExitType(!this.opTopAccessTypeLadder.selection())

  -- rise
 !this.meLadderEngine.setRise(!this.txRiseLadder.val)

  -- distance to first rung
 !this.meLadderEngine.setLRise(!this.txLRiseLadder.val)

 -- Rung BAngle
 !this.meLadderEngine.ladderData.rungAngle  = !this.rungAngle.val

  -- distance cage above ladder
 !this.meLadderEngine.setExtension(!this.txExtensionLadder.val)

  -- clearance to any obstruction
 !this.meLadderEngine.setheadroom(!this.txheadroomLadder.val)

  -- clearance to any obstruction
 !this.meLadderEngine.setFootRoom(!this.txFootRoomLadder.val)

  -- cage offset
 !this.meLadderEngine.setCageOffset(!this.txCageOffsetLadder.val)

  -- cage offset
 !this.meLadderEngine.setCageSize(!this.txCageSizeLadder.val)

 !this.meLadderEngine.ladderData.stringerSpec = !this.stringerSpec
 !this.meLadderEngine.ladderData.cageSpec     = !this.cageSpec
 !this.meLadderEngine.ladderData.rungSpec     = !this.rungSpec

 --Distance between Cage Hoops
 !this.meLadderEngine.ladderData.hoopDistance = !this.txCageHoopDist.val

 !undo.endundoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyLadderTmplRef
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyLadderTmplRef(!gadget is GADGET, !action is STRING)

  -- set the reference to the central template
  !ladderTmplReference = !this.opLadderTmplReferenceLadder.selection().dbref()
  !this.meLadderEngine.setTmplReference(!ladderTmplReference)

  -- combines general and fabricator standard
  !this.meLadderEngine.mergeCriteria()
  !this.updateLimitsLadder()


endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      newAccessLadder
--
-- Description: implements new Access point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newAccessLadder()

  if( !this.meLadderEngine.ladderData.cageRequired.not())then
  	!!alert.warning('Ladder height is not sufficient to create side exit.')
  	return
  endif

  !packet                 = object EDGPACKET()
  !packet.description     = 'Pick Elevation for Side Exit'

  -- When the component has been created successfully
  !packet.priority        = 2
  !packet.definePosition('Pick Elevation for Side Exit')
  !packet.remove          = true
  !packet.action = '!!aslLadder.createSideExit(!this.return[1])'
  !!edgCntrl.add(!packet)

 endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      createSideExit
--
-- Description: implements new Access point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .createSideExit(!positionData is EDGPOSITIONDATA)

  !elevation   							 = !positionData.position.wrt(/* ).up - !this.meLadderEngine.getLWP().wrt(/* ).up
  !sideExit                  = object ASLLADDEREXITDATA()
  !createStatus = !this.validateSideExitElevation(!elevation,object REAL())
  if(!createStatus.not())then
  	return
  endif
  !sideExit.elevation        = !elevation
  !this.meLadderEngine.addSideExit(!sideExit)

  !this.meLadderEngine.ladderData.stringerSpec = !this.stringerSpec
  !this.meLadderEngine.ladderData.cageSpec     = !this.cageSpec
  !this.meLadderEngine.ladderData.rungSpec     = !this.rungSpec
  !this.updateAttributes()

  -- create the ladder
  !this.meLadderEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- check if an error occurred
  if ( !this.meLadderEngine.getError() ) then
    !!alert.error(!!error.text)
    !this.meLadderEngine.resetError()
    return
  endif

  !this.updateAccessLadder()

  -- select the first one, so that it can be picked immediately
  !array[1] = 1
  !this.neAccessLadder.setSelectedRowTags(!array)

  !this.lkDeleteAccessLadder.active = true
  !this.lkPickAccessLadder.active   = true
  !this.lkAidAccessLadder.active    = true

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      pickAccessLadder
--
-- Description: implements new sideExit
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pickAccessLadder()

  !rows = !this.neAccessLadder.getSelectedRows()
  if ( !rows.size().neq(1) ) then
    !!alert.warning('Only possible when one row is selected')
    return
  endif

  -- defines packet
  !packet                     = object EDGPACKET()
  !packet.pickPacket.prompt   = 'Identify position of side exit'

  -- defines first pick
  !packet.pickPacket.picks[1] = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('')

  -- define actions on first pick
  !packet.action              = '!!aslLadder.pickAccessLadderReturn(!this.return[1])'

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      validateSideExitElevation
--
-- Description: implements new sideExit
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .validateSideExitElevation(!elevation is REAL,!index is REAL) is BOOLEAN

  !elevations   = object ARRAY()
  do !val values !this.meLadderEngine.ladderData.sideExits
    !elevations.append(!val.elevation)
  enddo

  if(!index.unset())then
  	!elevations.append(!elevation)
  else
    !elevations[!index] = !elevation
  endif
  !elevations.sort()
  !elevationIndex = !elevations.find(!elevation)[1]

  !validatingCriteria  = !this.meLadderEngine.ladderData.lExit.headroom + !this.meLadderEngine.ladderData.lExit.distancePrevCage
  if(!elevations.size() eq 1)then
  	if(!elevations[1].leq(!validatingCriteria))then
  		!!alert.warning('Picked Elevation is lesser than Headroom Elevations. Side exit creation is aborted.')
  		return false
  	endif
  else
    if(defined (!elevations[!elevationIndex - 1]) and !elevations[!elevationIndex - 1].set()) then
    	!differencePrevCurrent  = !elevations[!elevationIndex] - !elevations[!elevationIndex - 1]
    endif
    if(defined (!elevations[!elevationIndex + 1]) and !elevations[!elevationIndex + 1].set()) then
    	!differenceCurrentNext  = !elevations[!elevationIndex + 1] - !elevations[!elevationIndex]
    endif
    if(defined (!differencePrevCurrent) and !differencePrevCurrent.leq(!validatingCriteria))then
    	!!alert.warning('The minimum distance between previous side exit and picked position is not maintained. Side exit creation/modification is aborted.')
       return false
    elseif(defined (!differenceCurrentNext) and !differenceCurrentNext.leq(!validatingCriteria))then
    	 !!alert.warning('There is another side exit exists within the minimum distance which will clash with the current side exit position. Side exit creation/modification is aborted.')
       return false
    endif
  endif
  if(undefined (!elevations[!elevationIndex + 1]))then
     !validatingCriteria  = !this.uWP.up - ( !validatingCriteria )
     if(!elevation.gt(!validatingCriteria))then
    	 !!alert.warning('The Picked Elevation exceeds the upper point.Side exit creation/Modification is aborted.')
    	 return false
     endif
  endif


  return true


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickAccessLadderReturn
--
-- Description: repositions intermediate landing
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA
--                           edg pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pickAccessLadderReturn(!positionData is EDGPOSITIONDATA)
  !rows = !this.neAccessLadder.getSelectedRows()
  if ( !rows.size().neq(1) ) then
    !!alert.warning(!rows.size())
    !!alert.warning('Only possible when one row is selected')
    return
  endif
  -- find out which gate is to be positioned
  !index                 = !rows[1][1].real()
  !allExits              = !this.meLadderEngine.getSideExits()
  !currentExit           = !allExits[!index]

  -- get the gate data
  !position              = !positionData.position
  !elevationToValidate   = !position.wrt(/* ).up - !this.meLadderEngine.getLWP().wrt(/* ).up
  !modifyStatus  				 = !this.validateSideExitElevation(!elevationToValidate,!index)
  if(!modifyStatus.not())then
  	return
  endif
  !currentExit.elevation = !elevationToValidate

  -- load the gate to the central object
  !this.meLadderEngine.replaceSideExit(!currentExit, !index)

  -- evaluate the Ladder with the modified points
  !this.evaluateLadder()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      pickLWP
--
-- Description: Setup EDG pick event for picking Lower Working Point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickLWP()

  -- Initialise Variables
  !prompt               = 'Pick Lower Working Point'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Lower working point for Ladder'
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.lWP(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------
--
-- Method:      pickLWPlane
--
-- Description: Setup EDG pick event for picking Lower Working Plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickLWPlane()

  if(!this.uWP.unset())then
    !!alert.error('Upper work point is unset. Set the upper work point first.')
    return
  endif

  !this.validateDirection()
  if(!!error.text.set() and !!error.text.trim() neq '' and !this.errorState)then
    return
  endif

  !validTypeStr = |PANE,,PLTFRM,WALL,GWALL,STWALL,SCREED,FLOOR,HPLATE,HBRCKT,HDOPLA,HRSOF|

 -- rule that restricts the pick type and access
  !rule = |(match('| & !validTypeStr & |',TYPE) gt 0) and !!dbrefupdatable(CE)|

  -- Define EDG packet for picking elements to be split
  !packet                 =   object EDGPACKET()
  !packet.pickPacket.stdelement('Pick Lower Working Plane')
  !packet.action          =   '!!' & !this.name() & '.lwPlane(!this.return[1])'

  !packet.description     =  'Pick Lower Working Plane'
  !packet.priority        =   2
  !packet.remove          =   TRUE

  -- Add filter for Pick
  !packet.pickPacket.picks[1].pick.input[3]   = !rule
  !packet.pickPacket.picks[1].pick.modifiable = FALSE
  !!edgCntrl.add(!packet)

endmethod
------------------------------------------------------------------------
--
-- Method:      pickUWP
--
-- Description: Setup EDG pick event for picking Upper Working Point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickUWP()

  -- Initialise Variables
  !prompt               = 'Pick Upper Working Point'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Upper Working Point for Ladder'
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.uWP(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-----------------------------------------------------------------------
--
-- Method:      lWP
--
-- Description: Set Lower working point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lWP(!data is EDGPOSITIONDATA)

  -- Initialise Variable
  !position = !data.position.wrt(World)
  -- Update pos control gadget

  !this.ladderLWPControl.xyz(!position.east.string('d2').real(), !position.north.string('d2').real(), !position.up.string('d2').real())
  !this.lWP  = !position

  !this.deriveLWP()

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      lwPlane
--
-- Description: Set Lower working plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lwPlane(!data is EDGPICKDATA)

  !lowerElevation =  !data.item.position.wrt(world).up
  !upperElevation = !this.uWP.wrt(world).up
  !height  = !upperElevation - !lowerElevation
  !this.txHeightLadder.val = !height
  !this.calculateLowerPosition()

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      calculateLowerPosition
--
-- Description: Set Lower working point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calculateLowerPosition()

  !this.acceptLadder.active      = false
  !this.createLadder.active      = false

  if(!this.uWP.unset())then
    !!alert.error('Upper work point is unset. Set the upper work point first.')
    return
  endif

  !posFmt   = !!distanceFmt
  !posFmt.dp = 0

  !uWP       = !this.uWP
  !pitch     = !this.txPitchLadder.val
  !height    = !this.txHeightLadder.val
  !direction = !this.txExplicitDir.val.direction()

  !length     = !height / tan(!pitch)
  !lWP        = !uWP.offset(!direction.opposite(),!length).offset(D,!height)
  --!lWPString  = !lWP.string(!posFmt)
  --!lWP        = !lWPString.position()
  !this.ladderLWPControl.xyz(!lWP.east.string('d2').real(),!lWP.north.string('d2').real(),!lWP.up.string('d2').real())
  !this.lWP   = !lWP

   if(!this.lwpAidNumber.set())then
    !!aidNumbers.hide(!this.lwpAidNumber)
  else
    !this.lwpAidNumber        = !!aidNumbers.add('LWP')
  endif

  AID SPHERE NUMBER $!<this.lwpAidNumber> $!this.lWP DIAM 100mm
  AID TEXT NUMBER $!<this.lwpAidNumber> 'LWP' at $!this.lWP

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      uWP
--
-- Description: Set Upper working point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .uWP(!data is EDGPOSITIONDATA)

  -- Initialise Variables

  !position = !data.position.wrt(World)
  -- Update pos control gadget

  !this.ladderUWPControl.xyz(!position.east.string('d2').real(), !position.north.string('d2').real(), !position.up.string('d2').real())
  !this.lWP = object POSITION()
  !uwpArray  = !this.ladderUWPControl.xyz()
  !uWP       = object POSITION()
  !east  = !uwpArray[0]
  !north = !uwpArray[1]
  !up    = !uwpArray[2]
  --!origin = '/*'
  --!uWP.origin = !origin.dbref()
  !uWP = object POSITION('E $!east  N $!north  U $!up  wrt world')

  !this.uWP   = !uWP
  !this.rtPlane.active = !this.uWP.set()

  if(!this.uwpAidNumber.set())then
    !!aidNumbers.hide(!this.uwpAidNumber)
  else
    !this.uwpAidNumber        = !!aidNumbers.add('UWP')
  endif

  AID SPHERE NUMBER $!<this.uwpAidNumber> $!this.uWP DIAM 100mm
  AID TEXT NUMBER $!<this.uwpAidNumber> 'UWP' at $!this.uWP
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      defineGeometry
--
-- Description: Defining the geometry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .defineGeometry()

    !this.createLadder.active                = !this.definedGeometry
    !this.acceptLadder.active                = !this.definedGeometry
    --!this.lkLadderCreDetail.active           = !this.definedGeometry
    --!this.lkLadderModDetail.active           = !this.definedGeometry
   if(!this.definedGeometry)then
      !this.meLadderEngine.ladderData.lWP    = !this.derivedLWP
      !this.meLadderEngine.ladderData.uWP    = !this.derivedUWP
      !this.meLadderEngine.setORise(!this.oRise)
      !this.meLadderEngine.setPitch(!this.pitch)
      --!this.meLadderEngine.setDirectionOption(!this.direction)
      --!this.meLadderEngine.evaluate()
      --!this.showVolFeedbackLadder()
      --!this.frameChange(!this.frGeneralLadder)
   else
      !!alert.error('Geometry can not be defined for the ladder.')
   endif
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      selectAccessLadder
--
-- Description: control for active/inactive of exit gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      the selected rows
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectAccessLadder(!rows is ARRAY)

  !this.lkDeleteAccessLadder.active = !rows[0].empty().not()
  !this.lkPickAccessLadder.active   = !rows[0].size().eq(1)
  !this.lkAidAccessLadder.active    = !rows[0].empty().not()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectCataOptionsLadder
--
-- Description: select the current references in the options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectCataOptionsLadder()

  !ladderTmplReference = !this.meLadderEngine.getTmplReference()
  if ( !this.opLadderTmplReferenceLadder.rText.findFirst(!ladderTmplReference.string()).set() ) then
    !this.opLadderTmplReferenceLadder.select('RTEXT', !ladderTmplReference.string())
    !this.opLadderTmplReferenceLadder.active = true
  elseif ( !ladderTmplReference.badRef().not() ) then
    -- stair was built from a different standard
    !dText[1]                                = !ladderTmplReference.description
    !rText[1]                                = !ladderTmplReference.string()
    !this.opLadderTmplReferenceLadder.dText  = !dText
    !this.opLadderTmplReferenceLadder.rText  = !rText
    !this.opLadderTmplReferenceLadder.active = false
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: setup
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setup()

   !this.updateCoordinateSystem()

   !this.track()
  -- make frames active / inactive
   !this.frameChange(!this.frMainPane)


  -- updates the limits
  !this.updateLimitsLadder()
endmethod
-- End of method

----------------------------------------------------
--
-- Method:      showDimFeedbackLadder
--
-- Description: callback from view gadgets
--              set/unset all dimensions regarding value of  view gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimFeedbackLadder(!gadget is GADGET, !action is STRING)

  if ( !gadget.set() and $
       !gadget.eq(!this.lkAidAccessLadder) ) then
    if ( !this.lkAidAccessLadder.tag.eq('Display dimensions') ) then
      !this.lkAidAccessLadder.tag = 'Hide dimensions'
    elseif ( !this.lkAidAccessLadder.tag.eq('Hide dimensions') ) then
      !this.lkAidAccessLadder.tag = 'Display dimensions'
       !!aslCentralData.clearDimFeedback()
       return
    endif
  endif

  -- fill the dimension object, depends on the form toggles
  !ladderDimension               = object ASLLADDERDIM()
  !ladderDimension.cageOffset    = !this.toAidCageOffsetLadder.val
  !ladderDimension.cageSize      = !this.toAidCageSizeLadder.val
  !ladderDimension.extension     = !this.toAidExtensionLadder.val
  !ladderDimension.headroom      = !this.toAidHeadroomLadder.val
  !ladderDimension.height        = !this.toAidHeightLadder.val
  !ladderDimension.lRise         = !this.toAidLRiseLadder.val
  !ladderDimension.footroom      = !this.toAidFootRoomLadder.val
  !ladderDimension.pitch         = !this.toAidPitchLadder.val
  !ladderDimension.rise          = !this.toAidRiseLadder.val
  !ladderDimension.width         = !this.toAidWidthLadder.val
  !ladderDimension.gates         = !this.lkAidAccessLadder.tag.neq('Display dimensions')
  !this.meLadderEngine.ladderDim = !ladderDimension

    -- removes the old aid elements
  !!aslCentralData.clearDimFeedback()
  --!!aslCentralData.clearVolFeedback()
  !this.meLadderEngine.showDimFeedback()

endmethod
-- End of method

----------------------------------------------------
--
-- Method:      showVolFeedbackLadder
--
-- Description: callback from view gadgets
--              set/unset all dimensions regarding value of  view gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showVolFeedbackLadder()

  -- removes all old aid elements
  !!aslCentralData.clearVolFeedback()

  -- show
  !this.meLadderEngine.showVolFeedback()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateAccessLadder
--
-- Description: update the grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAccessLadder()

  -- use the .NET library
  using namespace  'Aveva.Pdms.Presentation'
  !this.neAccessLadder.clearGrid()

  !posFmt     = !!distanceFmt
  !posFmt.dp  = 0

  -- the title of the exit list
  !title      = 'Side exits'

  --set the headings of the exit list
  !heading    = object ARRAY()
  !heading.append('No.')
  !heading.append('Elevation')
  !heading.append('Exit type')
  !heading.append('headroom')
  !heading.append('Distance to prev cage')

  -- collect the data
  !allExits   = !this.meLadderEngine.getSideExits()
  !columns    = object ARRAY()
  do !i index !allExits
    !sideExit    = !allExits[!i]
    !columns[!i] = object ARRAY()

    -- column1 ,Index no.
    !columns[!i].append(!i.string())

    -- column2, elevation
    !columns[!i].append(!sideExit.elevation.string(!posFmt))

    -- column3, exit types
    --if ( !sideExit.exitType.eq('BACK') ) then
    --  !columns[!i].append('Back')
    if ( !sideExit.exitType.eq('LEFT') ) then
      !columns[!i].append('Left')
    elseif ( !sideExit.exitType.eq('RIGHT') ) then
      !columns[!i].append('Right')
    --else
    --  !columns[!i].append('Left&Right')
    endif

    -- column4, headroom
    !columns[!i].append(!sideExit.headroom.string(!posFmt))

    -- column5, distance to previous cage
    !columns[!i].append(!sideExit.distancePrevCage.string(!posFmt))
  enddo

  -- fill the grid
  !netDataSource = object NETDATASOURCE(!title, !heading, !columns)
  !this.neAccessLadder.bindToDataSource(!netDataSource)

  -- the following syntaxes must be carried out after the list has been filled!
  ---------------------------------------------------------------------------
  -- exit types
  !this.neAccessLadder.assignValueListToColumn('ExitTypes', 3)

  !this.lkDeleteAccessLadder.active = false
  !this.lkPickAccessLadder.active   = false
  !this.lkAidAccessLadder.active    = false
  !this.lkAidAccessLadder.tag       = 'Display dimensions'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateCataOptionsLadder
--
-- Description: updates the catalogue options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateCataOptionsLadder()

  -- Standard ('BS Private')
  --!this.paStandardLadder.val = !this.meLadderEngine.getSettingReference()

  -- collect all stairs from the options
  !dText           = object ARRAY()
  !rText           = object ARRAY()
  --!allCataElements = !!aslCentralData.currSetting.collectAll('LADDER')
  !allCataElements = !!aslCentralData.getTemplates('LADDER')
  do !cataElement value !allCataElements
    !dText.append(!cataElement.description)
    !rText.append(!cataElement.string())
  enddo
  !this.opLadderTmplReferenceLadder.dText = !dText
  !this.opLadderTmplReferenceLadder.rText = !rText

  -- try to select the current tmpl
  !currentTmplReference1 = !this.meLadderEngine.getTmplReference().string()
  if ( !this.opLadderTmplReferenceLadder.rText.find(!currentTmplReference1).unset() ) then
    !currentTmplReference = !this.opLadderTmplReferenceLadder.selection().dbref()
    !this.meLadderEngine.setTmplReference(!currentTmplReference)
  else
    !this.opLadderTmplReferenceLadder.select('RTEXT', !currentTmplReference1)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateFrameLadder
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrameLadder()

  !this.ladder = !!ce
  !ladderData           = !this.meLadderEngine.ladderData
  if ( !ladderData.unset() ) then
    return
  endif

  -- update position direction
  !posFmt               = object FORMAT()
  !posFmt.dp            = 0

  if(!this.meLadderEngine.ladderData.name.set() and !this.meLadderEngine.ladderData.name.substring(1,1) eq '=')then
    !this.txNameLadder.val    = ''
  else
    !this.txNameLadder.val      = !this.meLadderEngine.ladderData.name
  endif
  --!this.txFunctionLadder.val  = !this.meLadderEngine.ladderData.function
  !this.txDescLadder.val        = !this.meLadderEngine.ladderData.description
  !this.dbArea.val              = !this.meLadderEngine.ladderData.area
  !this.dbNumber.val            = !this.meLadderEngine.ladderData.number
  ---------------------------------------------------------------------------
  -- type of top exit
  !this.opTopAccessTypeLadder.select('RTEXT', !this.meLadderEngine.getUExitType())

  -- overall Rise
  !this.txHeightLadder.val   = !this.meLadderEngine.getORise()

  --Direction
  !this.txExplicitDir.val    = !ladderData.direction.string().before('WRT')

  -- overall Width
  !this.txWidthLadder.val   = !this.meLadderEngine.getWidth()

  -- pitch
  !this.txPitchLadder.val  = !this.meLadderEngine.getPitch()

  -- rise
  !this.txRiseLadder.val  = !this.meLadderEngine.getRise()

  --rung angle
  if(!this.meLadderEngine.ladderData.rungAngle.set())then
    !this.rungAngle.val     = !this.meLadderEngine.ladderData.rungAngle
  endif

  -- detailed attributes
  !this.txCageOffsetLadder.val    = !this.meLadderEngine.getCageOffset()
  !this.txCageSizeLadder.val      = !this.meLadderEngine.getCageSize()
  !this.txExtensionLadder.val     = !this.meLadderEngine.getExtension()
  !this.txheadroomLadder.val      = !this.meLadderEngine.getheadroom()
  !this.txLRiseLadder.val         = !this.meLadderEngine.getLRise()
  !this.txFootRoomLadder.val      = !this.meLadderEngine.getFootRoom()
  if(!this.meLadderEngine.getLWP().set())then
    --!lowerPoint                   = !this.meLadderEngine.getLWP().wrt(world)
    !this.getWorkPoint('LWP')
    !lowerPoint  = !this.lWP
  else
    !lowerPoint                   = object POSITION('E0 N0 U0 wrt /*')
    --!this.meLadderEngine.ladderData.lWP = !lowerPoint
    --!upperPoint                   = object POSITION('E0 N0 U$!this.txHeightLadder.val wrt /*')
  endif
  if(!this.meLadderEngine.getUWP().set())then
    --!upperPoint                   = !this.meLadderEngine.getUWP().wrt(world)
    !this.getWorkPoint('UWP')
    !upperPoint   = !this.uWP
  else
    !upperPoint                   = object POSITION('E0 N0 U$!this.txHeightLadder.val wrt /*')
    --!this.meLadderEngine.ladderData.uWP = !upperPoint
  endif

  !this.ladderLWPControl.xyz(!lowerPoint.east.string('d2').real(),!lowerPoint.north.string('d2').real(),!lowerPoint.up.string('d2').real())
  !this.ladderUWPControl.xyz(!upperPoint.east.string('d2').real(),!upperPoint.north.string('d2').real(),!upperPoint.up.string('d2').real())
  ---------------------------------------------------------------------------
  if(!this.meLadderEngine.ladderData.cageSpec.set())then
    !this.txLdrCagSpec.val   = !this.meLadderEngine.ladderData.cageSpec.name
    !this.cageSpec           = !this.meLadderEngine.ladderData.cageSpec
  else
    !this.txLdrCagSpec.val   = !this.meLadderEngine.ladderData.cageSpec.string()
  endif

  if(!this.meLadderEngine.ladderData.stringerSpec.set())then
    !this.txLdrStrSpec.val   = !this.meLadderEngine.ladderData.stringerSpec.name
    !this.stringerSpec       = !this.meLadderEngine.ladderData.stringerSpec
  else
    !this.txLdrStrSpec.val   = !this.meLadderEngine.ladderData.stringerSpec.string()
  endif

  if(!this.meLadderEngine.ladderData.rungSpec.set())then
    !this.txLdrRungSpec.val  = !this.meLadderEngine.ladderData.rungSpec.name
    !this.rungSpec           = !this.meLadderEngine.ladderData.rungSpec
  else
    !this.txLdrRungSpec.val  = !this.meLadderEngine.ladderData.rungSpec.string()
  endif

  -- Distance between cage Hoops
  !this.txCageHoopDist.val   = !this.meLadderEngine.ladderData.hoopDistance

  -- update the options for the setting
  !this.updateCataOptionsLadder()
  !this.selectCataOptionsLadder()

  -- access points
  !this.updateAccessLadder()

  -- show the dimensions
 -- !this.showDimFeedbackLadder(object GADGET(), '')

  -- update max/min
  !this.updateLimitsLadder()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateLimitsLadder
--
-- Description: updates the limits
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateLimitsLadder()
  call !!fillCriterionGadgets(!this.txHeightLadder,        object GADGET(), !this.meLadderEngine.ladderCriteria.oRise)
  call !!fillCriterionGadgets(!this.txWidthLadder,         object GADGET(), !this.meLadderEngine.ladderCriteria.width)
  call !!fillCriterionGadgets(!this.txPitchLadder,         object GADGET(), !this.meLadderEngine.ladderCriteria.pitch)
  call !!fillCriterionGadgets(!this.txRiseLadder,          object GADGET(), !this.meLadderEngine.ladderCriteria.rise)
  call !!fillCriterionGadgets(!this.txLRiseLadder,         object GADGET(), !this.meLadderEngine.ladderCriteria.lRise)
  call !!fillCriterionGadgets(!this.txExtensionLadder,     object GADGET(), !this.meLadderEngine.ladderCriteria.extension)
  call !!fillCriterionGadgets(!this.txheadroomLadder,      object GADGET(), !this.meLadderEngine.ladderCriteria.headroom)
  call !!fillCriterionGadgets(!this.txFootRoomLadder,      object GADGET(), !this.meLadderEngine.ladderCriteria.footroom)
  call !!fillCriterionGadgets(!this.txCageOffsetLadder,    object GADGET(), !this.meLadderEngine.ladderCriteria.cageOffset)
  call !!fillCriterionGadgets(!this.txCageSizeLadder,      object GADGET(), !this.meLadderEngine.ladderCriteria.cageSize)
  call !!fillCriterionGadgets(!this.txCageHoopDist,        object GADGET(), !this.meLadderEngine.ladderCriteria.hoopDistance)
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      getWorkPoint
--
-- Description: get LWP and UWP from Object and manipulates with foot room
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getWorkPoint(!workPoint is STRING)

    !this.oRise        = !this.txHeightLadder.val
 		!this.pitch        = !this.txPitchLadder.val
 		!this.direction    = !this.txExplicitDir.val.direction()

    !lowerPoint                   = !this.meLadderEngine.getLWP().wrt(world)
    !upperPoint                   = !this.meLadderEngine.getUWP().wrt(world)

    !east  			= !this.direction.east * !this.txFootRoomLadder.val
 		!north	 		= !this.direction.north * !this.txFootRoomLadder.val
 		!up 		 		= !this.direction.up * !this.txFootRoomLadder.val

    if(!workPoint eq 'LWP')then
 			!lwpEast  	= !lowerPoint.east + !east
 			!lwpNorth 	= !lowerPoint.north + !north
 			!lwpUp		  = !lowerPoint.up  + !up
 			!this.lWP  = object POSITION('E $!lwpEast N $!lwpNorth U $!lwpUp wrt /*')
 		else
			!uwpEast 	  = !upperPoint.east + !east
			!uwpNorth 	= !upperPoint.north + !north
			!uwpUp		 	= !upperPoint.up  + !up
			!this.uWP  = object POSITION('E $!uwpEast N $!uwpNorth U $!uwpUp wrt /*')
		endif

 endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      validationTextGadgets
--
-- Description: Validating the text gadgets.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET       Text Gadget to be validated
--    2    R     CRITERION    Validating Criteria for getting limits
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .validationTextGadgets(!gadget is GADGET,!validationCriteria is CRITERION,!value is ANY)
	
	!max      = !validationCriteria.max().string('d1').real()
	!min 			= !validationCriteria.min().string('d1').real()

  if(!gadget.dataType eq 'REAL')then
    if(!gadget.val.unset())then
      !!alert.error('$!validationCriteria.description should not be empty.')
      !gadget.val = !value
      !gadget.refresh()
      return
    endif
  elseif(!gadget.dataType eq 'STRING')then
    if(!gadget.val.unset() or !gadget.val.trim() eq '')then
      !!alert.error('$!validationCriteria.description should not be empty.')
      !gadget.val = !value
      !gadget.refresh()
    endif
  endif
 	if(!gadget.val.lt(0))then
    !!alert.error('Zero and Negative Values are not valid for this field.')
 		!gadget.val = !value
 		!gadget.refresh()
 		return
 	endif
 	if(!validationCriteria.setstatemax.set() and  !validationCriteria.setstatemin.set())then
    if ( !validationCriteria.setstatemax and !validationCriteria.setstatemin ) then
      if(!gadget.val.lt(!min) or !gadget.val.gt(!max))then
        !!alert.error('$!validationCriteria.description should lie in between $!min and $!max')
        !gadget.val = !value
        !gadget.refresh()
        return
      endif
    elseif ( !validationCriteria.setstatemax and !validationCriteria.setstatemin.not() ) then
      if(!gadget.val.gt(!max))then
        !!alert.error('$!validationCriteria.description should not be greater than $!max')
        !gadget.val = !value
        !gadget.refresh()
        return
      endif
    elseif ( !validationCriteria.setstatemax.not() and !validationCriteria.setstatemin ) then
      if(!gadget.val.lt(!min))then
        !!alert.error('$!validationCriteria.description should not be lesser than  $!min')
        !gadget.val = !value
        !gadget.refresh()
        return
      endif
    endif
  endif
  if(!gadget.name() eq 'TXWIDTHLADDER' or !gadget.name() eq 'TXCAGESIZELADDER' ) then
  	!sizeVal  = !this.txCageSizeLadder.val
  	!widthVal = !this.txWidthLadder.val
  	!validValue = (POW(!sizeVal / 2,2)) - (POW(!widthVal / 2,2))
  	if(!validValue.lt(0)) then
  		!!alert.error('Cage Size and Width of ladder are not matching. Change Cage size or width of ladder.')
  		!gadget.val = !value
  		!gadget.refresh()
  		return
  	endif
  endif
  !this.updateAttributes()
  if(!this.meLadderEngine.ladderData.uWP.set() and !this.meLadderEngine.ladderData.lWP.set())then
  !this.meLadderEngine.evaluate()
  !this.showVolFeedbackLadder()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      validateHeadroomAccessLadder
--
-- Description: Validating the text gadgets.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET       Text Gadget to be validated
--    2    R     CRITERION    Validating Criteria for getting limits
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .validateHeadroomAccessLadder(!headroomToValidate is REAL,!validationCriteria is CRITERION,!value is ANY) is REAL
	
	!max      = !validationCriteria.max().string('d1').real()
	!min 			= !validationCriteria.min().string('d1').real()

  if(!headroomToValidate.unset())then
      !!alert.error('$!validationCriteria.description should not be empty.')
			return !value
 	elseif(!headroomToValidate.lt(0))then
    !!alert.error('Zero and Negative Values are not valid for this field.')
 		return !value
 	endif
 	
 	if(!validationCriteria.setstatemax.set() and  !validationCriteria.setstatemin.set())then
    if ( !validationCriteria.setstatemax and !validationCriteria.setstatemin ) then
      if(!headroomToValidate.lt(!min) or !headroomToValidate.gt(!max))then
        !!alert.error('$!validationCriteria.description should lie in between $!min and $!max')
        return !value
      endif
    elseif ( !validationCriteria.setstatemax and !validationCriteria.setstatemin.not() ) then
      if(!headroomToValidate.gt(!max))then
        !!alert.error('$!validationCriteria.description should not be greater than $!max')
        return !value
      endif
    elseif ( !validationCriteria.setstatemax.not() and !validationCriteria.setstatemin ) then
      if(!gadget.val.lt(!min))then
        !!alert.error('$!validationCriteria.description should not be lesser than  $!min')
        return !value
      endif
    endif
  endif

  return !headroomToValidate

endmethod

------------------------------------------------------------------------
--
-- Method:      validateElevationAccessLadder
--
-- Description: Validating the text gadgets.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET       Text Gadget to be validated
--    2    R     CRITERION    Validating Criteria for getting limits
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .validateElevationAccessLadder(!heightToValidate is REAL, !validationCriteria is CRITERION,!value is ANY) is REAL
	
	!max      = !validationCriteria.max().string('d1').real()
	!min 			= !validationCriteria.min().string('d1').real()

  if(!heightToValidate.unset())then
    !!alert.error('$!validationCriteria.description should not be empty.')
    return !value

 	elseif(!heightToValidate.lt(0))then
    !!alert.error('Zero and Negative Values are not valid for this field.')
 		return !value
 	endif
 	
 	if(!validationCriteria.setstatemax.set() and  !validationCriteria.setstatemin.set())then
    if ( !validationCriteria.setstatemax and !validationCriteria.setstatemin ) then
      if(!heightToValidate.lt(!min) or !heightToValidate.gt(!max))then
        !!alert.error('$!validationCriteria.description should lie in between $!min and $!max')
        return !value
      endif
    elseif ( !validationCriteria.setstatemax and !validationCriteria.setstatemin.not() ) then
      if(!heightToValidate.gt(!max))then
        !!alert.error('$!validationCriteria.description should not be greater than $!max')
        return !value
      endif
    elseif ( !validationCriteria.setstatemax.not() and !validationCriteria.setstatemin ) then
      if(!heightToValidate.lt(!min))then
        !!alert.error('$!validationCriteria.description should not be lesser than  $!min')
        return !value
      endif
    endif
  endif

  !heightOfLadder  = !this.uWP.up - !this.lWP.up

  if(!heightToValidate.geq(!heightOfLadder))then
  	!!alert.error('The Elevation of Side Exit should be lesser than Ladder Height.')
  	return !value
  endif
  return !heightToValidate
endmethod

------------------------------------------------------------------------
--
-- Method:      validateDirection
--
-- Description: Validating the Direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET      Direction Gadget to be validated
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .validateDirection()

  !this.acceptLadder.active      = false
  !this.createLadder.active      = false

  !gadget = !this.txExplicitDir
  !!error.text = object STRING()
  !direction = !gadget.val.direction()
  handle (2,813)
    !!error.text = 'Enter a valid Direction'
  elsehandle none
    if(!direction.unset())then
      !!error.text = 'Direction field should not be empty.'
    elseif(!direction.up neq 0)then
        !!error.text = 'Direction Should not have Up component'
    endif
  endhandle
  if(!!error.text.set() and !!error.text.trim().neq(''))then
    !!alert.error(!!error.text)
    !this.errorState= true
    !gadget.setfocus()
  else
    !this.meLadderEngine.setDirectionOption(!gadget.val.direction())
    !gadget.val = !direction.string().before('WRT')
  endif

endmethod

----------------------------------------------------------------------------
-- Method:           updateCoordinateSystem
--
  -- Description: update the position and direction gadgets to display current coordinate system
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .updateCoordinateSystem()

  --Load ship grid data
  !grid                       = object SHIPGRID()
  !gridDefined                = !grid.position.set()
  -- Only populate the grid data if a ship reference grid is available
   if(!gridDefined) then
     !this.ladderLWPControl.gridFormat()
     !this.ladderUWPControl.gridFormat()
   else
    var !coordinate coordinate
    if(!coordinate.eq('ENU'))then
      !this.ladderLWPControl.enuFormat()
      !this.ladderUWPControl.enuFormat()
    else
      !this.ladderLWPControl.xyzFormat()
      !this.ladderUWPControl.xyzFormat()
    endif
   endif
endmethod
------------------------------------------------------------------------
--
-- Method:      selectProfile
--
-- Description: Select profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gadget ID
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectProfile(!id is REAL)

  -- Set default JusLine required for different types of profiles, if
  -- the one of the plines can't be found then NA is used.
  !plineList  = ARRAY()
  !plineList.append('TOS')
  !plineList.append('LTOC')
  !plineList.append('TOAX')

  -- Selection form title
  !title = !this.profileDataDesc[!id]

  -- Action to be carried out
  !action             = !this.fullname() & '.setProfile(' & !id & ', !this.catalogueProfile)'

  -- Profile Data
  !profileData        = !this.profileData[!id]

  -- Setup object for profile selection
  !profileSelection   = object PROFILESELECTION(!title, !action)

  !profileSelection.profileData(!profileData)
  !profileSelection.defaultPlines(!plineList)

  -- Display profile selection form
  !profileSelection.show()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setProfile
--
-- Description: Set profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILECATALOGUEDATA Profile Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setProfile(!id is REAL, !profileData is PROFILECATALOGUEDATA)

  -- Initialise Variable
  !spref = !profileData.catalogueReference
  --!jusl = !profileData.justificationLine
  !this.profileData[!id] = !profileData
  !this.profileDataGadget[!id].val  = !spref.name

endmethod
------------------------------------------------------------------------
--
-- Method:      selectProfile
--
-- Description: Select profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget to be populated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectProfile(!gadget is GADGET)

  pml reload form !!sectionProfileSelection
  if(!gadget.name() eq 'TXLDRCAGSPEC')then
    !!sectionProfileSelection.apply.callback = '!!aslLadder.setProfile(!!aslLadder.txLdrCagSpec)'
  elseif(!gadget.name() eq 'TXLDRSTRSPEC')then
    !!sectionProfileSelection.apply.callback = '!!aslLadder.setProfile(!!aslLadder.txLdrStrSpec)'
  elseif(!gadget.name() eq 'TXLDRRUNGSPEC')then
    !!sectionProfileSelection.apply.callback = '!!aslLadder.setProfile(!!aslLadder.txLdrRungSpec)'
  endif
  show !!sectionProfileSelection
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      acceptSpec
--
-- Description: Accept profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      the element type for which the profile is defined
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .acceptSpec()
  !this.cageSpec     = !this.txLdrCagSpec.val.dbref()
  !this.stringerSpec = !this.txLdrStrSpec.val.dbref()
  !this.rungSpec     = !this.txLdrRungSpec.val.dbref()
  !this.meLadderEngine.ladderData.cageSpec = !this.cageSpec
  !this.meLadderEngine.ladderData.rungSpec = !this.rungSpec
  !this.meLadderEngine.ladderData.stringerSpec = !this.stringerSpec
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setProfile
--
-- Description: Set profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILECATALOGUEDATA Profile Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setProfile(!gadget is GADGET)

  !gadget.val = !!sectionProfileSelection.profile.name
  hide !!sectionProfileSelection

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sideExit
--
-- Description: Side Exit Create/Modify
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sideExit()

 -- initialise the data objects
  LADDER
  handle ANY
    !!alert.warning('Not below LADDER hierarchy')
    return
  endhandle
  !this.meLadderEngine.ladderData.refe  = !!ce
  !this.meLadderEngine = object ASLLADDERENGINE()
  -- update the new object with the current element
  !this.meLadderEngine.updateDataObj(!!ce)
  handle ANY
    !!alert.error('Unable to Modify: Check that the setting configuration used for this element exists')
    return
  endhandle
  !this.updateFrameLadder()
  !this.frameChange(!this.frAccessLadder)
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyGeometry
--
-- Description: Modify ladder Geometry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyGeometry()

 -- initialise the data objects

  LADDER
  handle ANY
    !!alert.warning('Not below LADDER hierarchy')
    return
  endhandle
  !this.meLadderEngine.ladderData.refe  = !!ce
  !this.meLadderEngine = object ASLLADDERENGINE()
  -- update the new object with the current element
  !this.meLadderEngine.updateDataObj(!!ce)
  handle ANY
    !!alert.error('Unable to Modify: Check that the setting configuration used for this element exists')
    return
  endhandle
  !this.updateFrameLadder()
  !this.definedGeometry = true
  !this.frameChange(!this.frPositionLadder)
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: ce-tracker
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .track()

    -- check whether a Ladder could be created
  !flag             = false
  !referenceElement = !!ce
  !ref              = !!ce
  do !i
    break if ( !referenceElement.type.eq('WORL') )

    if ( !referenceElement.list.findFirst('LADDER').set() ) then
      !flag = true
      break
    endif
    !referenceElement = !referenceElement.owner
  enddo
  if(!flag)then
    !this.mainCreateLadder.active = true
    !this.mainModifySpec.active   = true
  else
    if(!!aslStoreTable.getStore('ladder').set() and !!aslStoreTable.getStore('ladder').badRef().not())then
      !this.mainCreateLadder.active = true
      !this.mainModifySpec.active   = true
    else
      !this.mainCreateLadder.active = false
      !this.mainModifySpec.active   = false
    endif
  endif

  LADDER
  handle ANY
    !this.mainCreateSideExit.active = false
    !this.mainModifyLadder.active   = false
    !this.mainModifySideExit.active = false
    !this.mainDeleteLadder.active   = false
    !this.mainDeleteSideExit.active = false
  elsehandle NONE
    !this.mainCreateSideExit.active = true
    !this.mainModifyLadder.active   = true
    !this.mainModifySideExit.active = !this.neAccessLadder.getRows().empty().not()
    !this.mainDeleteLadder.active   = true
    !this.mainDeleteSideExit.active = !this.neAccessLadder.getRows().empty().not()
  endhandle
  !!ce = !ref
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      acceptDetailAttributes
--
-- Description: accept callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .acceptDetailAttributes()

  !this.updateAttributes()
  !this.meLadderEngine.evaluate()
  !this.meOldLadderData = !this.meLadderEngine.ladderData
  !this.meLadderEngine.resetError()

endmethod
------------------------------------------------------------------------
--
-- Method:      topExitType
--
-- Description: top Exit definition
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .topExitType()

  !this.updateAttributes()
  if(!this.meLadderEngine.ladderData.uWP.set() and !this.meLadderEngine.ladderData.lWP.set())then
    !this.meLadderEngine.evaluate()
    !this.showVolFeedbackLadder()
  endif
endmethod
------------------------------------------------------------------------
--
-- Method:      positionOption
--
-- Description: Choose explicit or relative position option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .positionOption()

 !indx =  !this.frgeometry.val
 !selection = !this.frgeometry.rtoggle(!indx)
 if(!selection.tag.upcase().matchwild('*PLANE*'))then
  !this.frLowerPosition.visible = false
  !this.frLowerPlane.visible    = true
 else
  !this.frLowerPosition.visible = true
  !this.frLowerPlane.visible    = false
 endif
 --if(!this.mode.set())then
 -- if(!this.mode.upcase() eq 'MODIFY')then
 --   !this.modify()
 -- endif
 --endif
endmethod
-- End of method
