--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activateReEvaluate()             -                   activates the re-evaluate buttons
--  aslMain()                        -                   Constructor
--  ceHandRa()                       -                   modify the handrail
--  ceLadder()                       -                   modify the ladder
--  cePltFrm()                       -                   modify the platform
--  ceStrSet()                       -                   modify the current stair flight
--  ceStrTwr()                       -                   modify the stairFlight
--  ceValidCheck()                   -                   Valid Check for the Current Element, Referring to stair tower
--  ceWWay()                         -                   modify the walkway
--  changeCalcMethodStrSet(GADGET,STRING) -
--  checkName()                      -
--  clearIncompleteStrTwr()          -                   Clears incomplete stair tower
--  clearPlanesStrTwr()              -                   remove aid lines
--  closeForm()                      -                   closes the form
--  createHandRa(EDGPICKDATA)        -                   create new handrail
--  createLadderReturn(EDGPICKDATA)  -                   create new ladder
--  createStrSet(EDGPICKDATA)        -                   create new stair flight
--  deleteAccessHandRa()             -                   deletes a gate
--  deleteAccessLadder()             -                   implements new Access point
--  deleteAccessPltFrm()             -                   deletes an access point
--  deleteAccessStrSet()             -                   deletes an access point
--  deleteAccessStrTwr()             -                   deletes a gate
--  deleteAccessWWay()               -                   deletes an access point
--  deleteHandRa()                   -                   delete handrail
--  deleteLadder()                   -                   delete ladder
--  deleteOpeningsPltFrm()           -                   deletes a opening
--  deletePltFrm()                   -                   delete platform
--  deleteStrSet()                   -                   delete stairSet
--  deleteStrTwr()                   -                   delete stair tower
--  deleteWWay()                     -                   delete walkway
--  deriveDirectionOptionsLadder()   -                   Derive options from pick data
--  deriveDirectionOptionsStrSet()   -                   Derive options from pick data
--  deriveExtensionOptionsStrSet()   -                   Derive options from pick data
--  deriveInstallationOptionsStrSet() -                   Derive options from pick data
--  deriveInstallationOptionsStrTwr() -                   Derive options from pick data
--  deriveOptionsLadder()            -                   Derive options from pick data
--  deriveOptionsStrSet()            -                   Derive options from pick data
--  derivePositionOptionsLadder()    -                   Derive options from pick data
--  derivePositionOptionsStrSet()    -                   Derive options from pick data
--  dirOptionLadder(GADGET,STRING)   -                   open callback from install option gadgets
--  dirOptionStrSet(GADGET,STRING)   -                   open callback from install option gadgets
--  edgClearPlane()                  -                   Clears the Planes created for EDG pick for positioning access points
--  evaluateAccessPointPositionsStrSet() -                   evaluates the access point positions projected onto the stair flight plane
--  evaluateLadder()                 -                   Derive ladder from returned pick data and selections on the form
--  evaluatePicksLadder()            -                   evaluate picks and create ladder
--  evaluatePicksStrSet()            -                   evaluate picks and create stair
--  evaluatePltFrm()                 -                   Derive platform from returned pick data and selections on the form
--  evaluateStrSet()                 -                   Derive stair from returned pick data and selections on the form
--  evaluateStrTwr()                 -                   evaluates the stair tower with the settings
--  evaluateStrTwrPreview()          -                   evaluates the stair tower for the quick preview
--  evaluateWWay()                   -                   Derive walkway from returned pick data and selections on the form
--  extensionOptionStrSet(GADGET,STRING) -                   open callback from extension option gadgets
--  firstPickLadderReturn(EDGPICKDATA) EDGPOSITIONDATA     First pick
--  firstPickStrSet(EDGPICKDATA)     EDGPOSITIONDATA     First pick
--  flipAccessHandRa()               -                   flip gates
--  frameChange(GADGET)              -                   make the main frames visible/invisible
--  getOptimumPitchStrSet()          -                   use the optimum pitch
--  getOptimumPitchStrTwr()          -                   use the optimum pitch
--  getOptimumStrSet(GADGET,STRING)  -                   use the chosen optimum combination of number of treads
--  installOptionStrSet(GADGET,STRING) -                   open callback from install option gadgets
--  installOptionStrTwr(GADGET,STRING) -                   open callback from install option gadgets
--  mergeHandRaRouting()             -                   implements merge of handrail routings
--  mergeOpeningsPltFrm()            -                   merge openings
--  mergePltFrmShape()               -                   implements merge of platform shape
--  mergePltFrmShapeReturn(EDGPICKDATA) -                   return of implements merge of platform shape
--  mergePltFrmShapes()              -                   merge the shapes
--  modifyAccessHandRa(ARRAY)        -                   callback when changing the grid
--  modifyAccessLadder(ARRAY)        -                   callback when changing the grid
--  modifyAccessPltFrm(ARRAY)        -                   callback when changing the grid
--  modifyAccessStrSet(ARRAY)        -                   callback when changing the grid
--  modifyAccessStrTwr(ARRAY)        -                   callback when changing the grid
--  modifyAccessWWay(ARRAY)          -                   callback when changing the grid
--  modifyHandRa(GADGET,STRING)      -                   open callback from most gadgets
--  modifyHandRaRouting()            -                   callback when changing the grid
--  modifyHandRaRoutingAccept(ARRAY) -                   return from polyline form by press of ACCEPT
--  modifyHandRaRoutingDiscard()     -                   return from polyline form by press of DISCARD
--  modifyHandRaTmplReference()      -                   modify template reference
--  modifyLadder(GADGET,STRING)      -                   open callback from most gadgets
--  modifyLadderTmplReference(GADGET,STRING) -                   open callback from most gadgets
--  modifyOpeningsPltFrm(ARRAY)      -                   callback when changing the grid
--  modifyOpeningsPltFrm(GADGET,STRING) -                   implements new opening
--  modifyOpeningsPltFrmAccept(ARRAY,BOOLEAN) -                   return from profile form by press of ACCEPT
--  modifyOpeningsPltFrmDiscard()    -                   return from profile form by press of DISCARD
--  modifyPltFrm()                   -                   Switch to platform form, modify platform pane
--  modifyPltFrm(GADGET,STRING)      -                   open callback from most gadgets
--  modifyPltFrmShape()              -                   Invoke EDG pick
--  modifyPltFrmShapeAccept(ARRAY)   -                   return from profile form by press of ACCEPT
--  modifyPltFrmShapeDiscard()       -                   return from profile form by press of DISCARD
--  modifyPltFrmTmplReference()      -                   modify template reference
--  modifyRailSpacingHandRa(ARRAY)   -                   callback when changing the grid
--  modifyStrSet(GADGET,STRING)      -                   open callback from most gadgets
--  modifyStrSetTmplReference(GADGET,STRING) -                   open callback from most gadgets
--  modifyStrTwr(GADGET,STRING)      -                   open callback from most gadgets
--  modifyStrTwrTmplReference(GADGET,STRING) -                   open callback from most gadgets
--  modifyWWay(GADGET,STRING)        -                   open callback from most gadgets
--  modifyWWayRouting()              -                   Invoke EDG pick
--  modifyWWayRoutingAccept(ARRAY)   -                   return from polyline form by press of ACCEPT
--  modifyWWayRoutingDiscard()       -                   return from polyline form by press of DISCARD
--  modifyWWayTmplReference()        -                   modify template reference
--  newAccessHandRa()                -                   implements new gate point
--  newAccessHandRaReturn(EDGPOSITIONDATA) -                   return of implements new gate point
--  newAccessLadder()                -                   implements new Access point
--  newAccessPltFrm()                -                   implements new access point
--  newAccessPltFrmReturn(EDGPOSITIONDATA) -                   return of implements new access point
--  newAccessStrSet()                -                   implements new access point
--  newAccessStrTwr()                -                   implements new access point
--  newAccessWWay()                  -                   implements new access point
--  newAccessWWayReturn(EDGPOSITIONDATA) -                   return of implements new access point
--  newHandRaRouting()               -                   Invoke EDG pick
--  newHandRaRoutingAccept(ARRAY)    -                   return from polyline form by press of ACCEPT
--  newHandRaRoutingDiscard()        -                   return from polyline form by press of DISCARD
--  newLadder()                      -                   Invoke EDG pick
--  newPltFrm()                      -                   Go to platform form, create platform pane
--  newPltFrmShape()                 -                   Invoke EDG pick
--  newPltFrmShapeAccept(ARRAY)      -                   return from profile form by press of ACCEPT
--  newPltFrmShapeDiscard()          -                   return from profile form by press of DISCARD
--  newStrSet()                      -                   Invoke EDG pick
--  newStrTwr()                      -                   Invoke EDG pick
--  newWWayRouting()                 -                   Invoke EDG pick
--  newWWayRoutingAccept(ARRAY)      -                   return from polyline form by press of ACCEPT
--  newWWayRoutingDiscard()          -                   return from polyline form by press of DISCARD
--  pickAccessHandRa()               -                   implements new access point
--  pickAccessHandRaReturn(EDGPOSITIONDATA) -                   repositions gate
--  pickAccessLadder()               -                   implements new sideExit
--  pickAccessLadderReturn(EDGPOSITIONDATA) -                   repositions intermediate landing
--  pickAccessPltFrm()               -                   implements new access point
--  pickAccessPltFrmReturn(EDGPOSITIONDATA) -                   repositions access point
--  pickAccessStrSet()               -                   implements new gate
--  pickAccessStrSetReturn(EDGPOSITIONDATA) -                   repositions gate
--  pickAccessStrTwr()               -
--  pickAccessStrTwrReturn(EDGPOSITIONDATA) -                   repositions gate
--  pickAccessWWay()                 -                   implements new access point
--  pickAccessWWayReturn(EDGPOSITIONDATA) -                   repositions access point
--  pickLadder()                     -                   Invoke EDG pick
--  pickPosition()                   -                   Setup EDG pick event for picking position
--  pickStrSet(GADGET,STRING)        -                   Invoke EDG pick
--  posOptionLadder(GADGET,STRING)   -                   open callback from install option gadgets
--  posOptionStrSet(GADGET,STRING)   -                   open callback from install option gadgets
--  reEvaluateHandRa()               -                   reEvaluates the data according to the setting
--  reEvaluateLadder()               -                   reEvaluates the data according to the setting
--  reEvaluatePltFrm()               -                   reEvaluates the data according to the setting
--  reEvaluateStrSet()               -                   reEvaluates the data according to the current setting
--  reEvaluateStrTwr()               -
--  reEvaluateWWay()                 -                   reEvaluates the data according to the setting
--  saveData()                       ARRAY               Derive ladder from returned pick data
--  secondPickLadderReturn(EDGPICKDATA) -                   Derive ladder from returned pick data
--  secondPickStrSet(EDGPICKDATA)    -                   Derive stair from returned pick data
--  selectAccessHandRa(ARRAY)        -                   control for active/inactive of access gadgets
--  selectAccessLadder(ARRAY)        -                   control for active/inactive of exit gadgets
--  selectAccessPltFrm(ARRAY)        -                   control for active/inactive of access gadgets
--  selectAccessStrSet(ARRAY)        -                   control for active/inactive of access gadgets
--  selectAccessStrTwr(ARRAY)        -                   control for active/inactive of access gadgets
--  selectAccessWWay(ARRAY)          -                   control for active/inactive of access gadgets
--  selectCataOptionsHandRa()        -                   select the current references in the options
--  selectCataOptionsLadder()        -                   select the current references in the options
--  selectCataOptionsPltFrm()        -                   select the current references in the options
--  selectCataOptionsStrSet()        -                   select the current references in the options
--  selectCataOptionsStrTwr()        -                   select the current references in the options
--  selectCataOptionsWWay()          -                   select the current references in the options
--  selectOpeningsPltFrm(ARRAY)      -                   control for active/inactive of opening gadgets
--  senseStrTwr(GADGET,STRING)       -                   open callback from install option gadgets
--  setLocksStrSet(GADGET,STRING)    -
--  setMainAttributesStrSet()        -                   sets the main attributes of the stair set
--  setPickLadder(STRING,EDGPICKDATA) -                   define pick from EDGPICK
--  setPickStrSet(STRING,EDGPICKDATA) -                   define pick from EDGPICK
--  setWrt(GADGET,STRING)            -                   Set the origin.
--  setup()                          -                   setup
--  showDimFeedbackHandRa(GADGET,STRING) -                   callback from view gadgets
--  showDimFeedbackLadder(GADGET,STRING) -                   callback from view gadgets
--  showDimFeedbackPltFrm(GADGET,STRING) -                   callback from view gadgets
--  showDimFeedbackStrSet(GADGET,STRING) -                   callback from view gadgets
--  showDimFeedbackStrTwr(GADGET,STRING) -                   callback from view gadgets
--  showDimFeedbackWWay(GADGET,STRING) -                   callback from view gadgets
--  showVolFeedBackStrTwr()          -                   callback from view gadgets
--  showVolFeedbackHandRa()          -                   callback from view gadgets
--  showVolFeedbackLadder()          -                   callback from view gadgets
--  showVolFeedbackPltFrm()          -                   callback from view gadgets
--  showVolFeedbackStrSet()          -                   callback from view gadgets
--  showVolFeedbackWWay()            -                   callback from view gadgets
--  singlePickLadder(GADGET,STRING)  -                   Invoke EDG pick (only bottom pick)
--  singlePickLadderReturn(EDGPICKDATA,STRING) -                   Derive ladder from returned pick data
--  singlePickStrSet(GADGET,STRING)  -                   Invoke EDG pick (only bottom pick)
--  singlePickStrSetReturn(EDGPICKDATA,STRING) -                   Derive stair from returned pick data
--  track()                          -                   ce-tracker
--  trackCheck(STRING)               BOOLEAN             check whether a certain element can be created
--  updateAccessHandRa()             -                   update the gadgets
--  updateAccessLadder()             -                   update the grid control
--  updateAccessPltFrm()             -                   update the gadgets
--  updateAccessStrSet()             -                   update the gadgets
--  updateAccessStrTwr()             -                   update the gadgets
--  updateAccessWWay()               -                   update the gadgets
--  updateCataOptionsHandRa()        -                   updates the catalogue options
--  updateCataOptionsLadder()        -                   updates the catalogue options
--  updateCataOptionsPltFrm()        -                   updates the catalogue options
--  updateCataOptionsStrSet()        -                   updates the catalogue options
--  updateCataOptionsStrTwr()        -                   updates the catalogue options
--  updateCataOptionsWWay()          -                   updates the catalogue options
--  updateCoordinateSystem()         -
--  updateExplicitGadgetsStrSet(REAL) -                   Derive valid from pick data
--  updateFrameHandRa()              -                   update the gadgets
--  updateFrameLadder()              -                   update the gadgets
--  updateFramePltFrm()              -                   update the gadgets
--  updateFrameSegmentStrSet(GADGET,STRING) -                   update the gadgets for the segment frame
--  updateFrameStrSet()              -                   update the gadgets
--  updateFrameStrTwr()              -                   update the gadgets
--  updateFrameWWay()                -                   update the gadgets
--  updateLadderPositionGadgets()    -                   update the values in ladder position gadgets
--  updateLimitsHandRa()             -                   updates the limits
--  updateLimitsLadder()             -                   updates the limits
--  updateLimitsPltFrm()             -                   updates the limits
--  updateLimitsStrSet()             -                   updates the limits
--  updateLimitsStrTwr()             -                   updates the limits
--  updateLimitsWWay()               -                   updates the limits
--  updateOpeningsPltFrm()           -                   update the gadgets
--  updateOptimumGadgetStrSet(REAL)  -                   Derive optima from pick data
--  updateRailSpacingHandRa()        -                   update the gadgets
--  validationTextGadgets(GADGET,CRITERION) -                   Validating the textGadgets.
--

import 'PositionControl'
handle ANY
endhandle

import 'GridControl'
handle ANY
endhandle

-- setup form !!aslMain dialog dock taskpane
setup form !!aslMain dialog dock right

  -- .NET library
  using namespace 'Aveva.Pdms.Presentation'

  track    'DESICE'    callback '!this.track()'

  path down
  frame .frMain panel anchor T+L+R

    ------------------------------------------------------------------------------------------------------------------------------------------------------
    -- main form
    ------------------------------------------------------------------------------------------------------------------------------------------------------
    -- create
    ---------------------------------------------------------------------------
    para   .paCreate                                                                         text 'Create'
    line   .lnCreate                 at xmin                ymax-.2       anchor T+L+R HORIZ                                                    width 36
    --para   .paCreateMain             at x1                  ymax+0.5                         pixmap                                             width 32 height 32
    button .lkCreateStrTwr linklabel at x3                  ymax.lnCreate                    'Stair Tower'  callback '!this.newStrTwr()'        width 30
    --button .lkCreateStrSet linklabel at xmin.lkCreateStrTwr ymax-.2                          'Stair Flight' callback '!this.newStrSet()'        width 30
    button .lkCreateStrSet linklabel at xmin.lkCreateStrTwr ymax-.2                          'Stair Flight' callback '!!aslStrflt(|create|,!!ce)'        width 30
    button .lkCreateLadder linklabel at xmin.lkCreateStrTwr ymax-.2                          'Ladder'       callback '!!aslladder(|Create|)'        width 30
    button .lkCreatePltfrm linklabel at xmin.lkCreateStrTwr ymax-.2                          'Platform'     callback '!this.newPltFrm()'   width 30
--    button .lkCreateWWay   linklabel at xmin.lkCreateStrTwr ymax-.2                          'Walkway'      callback '!this.newWWayRouting()'   width 30
    button .lkCreateHandRa linklabel at xmin.lkCreateStrTwr ymax-.2                          'Handrail'     callback '!!aslHandRa(|create|,ce)' width 30

    -- modify
    ---------------------------------------------------------------------------
    para   .paModify                 at xmin.paCreate       ymax+.5                          text 'Modify'
    line   .lnModify                 at xmin.lnCreate       ymax-.2       anchor T+L+R HORIZ                                             width.lnCreate
    --para   .paModifyMain             at xmin.paCreateMain   ymax+0.5                         pixmap                                      width.paCreateMain   height.paCreateMain
    button .lkModifyStrTwr linklabel at xmin.lkCreateStrTwr ymax.lnModify                    'Stair Tower'   callback '!this.ceStrTwr()' width.lkCreateStrTwr
    --button .lkModifyStrSet linklabel at xmin.lkCreateStrTwr ymax-.2                          'Stair Flight'  callback '!this.ceStrSet()' width.lkCreateStrSet
    button .lkModifyStrSet linklabel at xmin.lkCreateStrTwr ymax-.2                          'Stair Flight'  callback '!!aslStrflt(|modify|,!!ce)' width.lkCreateStrSet
    button .lkModifyLadder linklabel at xmin.lkCreateStrTwr ymax-.2                          'Ladder'        callback '!!aslladder(|Modify|)' width.lkCreateLadder
    button .lkModifyPltFrm linklabel at xmin.lkCreateStrTwr ymax-.2                          'Platform'      callback '!this.modifyPltFrm()' width.lkCreatePltfrm
--    button .lkModifyWWay   linklabel at xmin.lkCreateStrTwr ymax-.2                          'Walkway'       callback '!this.ceWWay()'   width.lkCreateWWay
    button .lkModifyHandRa linklabel at xmin.lkCreateStrTwr ymax-.2                          'Handrail'      callback '!!aslHandRa(|modify|,ce)' width.lkCreateHandRa

    -- delete
    ---------------------------------------------------------------------------
    para   .paDelete                 at xmin.paCreate       ymax+.5                          text 'Delete'
    line   .lnDelete                 at xmin.lnCreate       ymax-.2       anchor T+L+R HORIZ                                                 width.lnCreate
    --para   .paDeleteMain             at xmin.paCreateMain   ymax+0.5                         pixmap                                          width.paCreateMain   height.paCreateMain
    button .lkDeleteStrTwr linklabel at xmin.lkCreateStrTwr ymax.lnDelete                    'Stair Tower'   callback '!this.deleteStrTwr()' width.lkCreateStrTwr
    button .lkDeleteStrSet linklabel at xmin.lkCreateStrTwr ymax-.2                          'Stair Flight'  callback '!this.deleteStrSet()' width.lkCreateStrSet
    button .lkDeleteLadder linklabel at xmin.lkCreateStrTwr ymax-.2                          'Ladder'        callback '!this.deleteLadder()' width.lkCreateLadder
    button .lkDeletePltFrm linklabel at xmin.lkCreateStrTwr ymax-.2                          'Platform'      callback '!this.deletePltFrm()' width.lkCreatePltfrm
    button .lkDeleteHandRa linklabel at xmin.lkCreateStrTwr ymax-.2                          'Handrail'      callback '!this.deleteHandRa()' width.lkCreateHandRa

  exit

  path down
  ------------------------------------------------------------------------------------------------------------------------------------------------------
  -- stair set
  ------------------------------------------------------------------------------------------------------------------------------------------------------
  frame .frMainWorkStrSet panel at xmin.frMain ymin.frMain anchor T+L+R

    -- general attributes
    ---------------------------------------------------------------------------
    para  .paGeneralStrSet                  at xmin form              ymax                text 'General attributes'
    line  .lnGeneralStrSet                  at xmin                   ymax-.2                                                                               anchor T+L+R HORIZ             width 36
    text   .txLengthStrSet                  at x 3                                        'Overall Length:'         callback '!this.modifyStrSet('          anchor L+T+R       tagwidth 14 width 10           is REAL format !!distanceFmt
    option .opLengthStrSet                  at xmin.txLengthStrSet    ymin.txLengthStrSet 'Overall Length:'         callback '!this.modifyStrSet('          anchor L+T+R       tagwidth 14 width  8
    button .toAidLengthStrSet toggle pixmap at x31                    ymin.txLengthStrSet                           callback '!this.showDimFeedbackStrSet(' anchor T+R                     width 16 height 16
    text   .txORiseStrSet                   at xmin.txLengthStrSet                        'Overall Rise:'           callback '!this.modifyStrSet('          anchor T+L+R       tagwidth 14 width 10           is REAL format !!distanceFmt
    option .opORiseStrSet                   at xmin.txORiseStrSet     ymin.txORiseStrSet  'Overall Rise:'           callback '!this.modifyStrSet('          anchor T+L+R       tagwidth 14 width  8
    button .toAidORiseStrSet  toggle pixmap at xmin.toAidLengthStrSet ymin.txORiseStrSet                            callback '!this.showDimFeedbackStrSet(' anchor T+R                     width 16 height 16
    text   .txWidthStrSet                   at xmin.txLengthStrSet                        'Width:'                  callback '!this.modifyStrSet('          anchor L+T+R       tagwidth 14 width 10           is REAL format !!distanceFmt
    option .opWidthStrSet                   at xmin.txWidthStrSet     ymin.txWidthStrSet  'Width:'                  callback '!this.modifyStrSet('          anchor L+T+R       tagwidth 14 width 10
    button .toAidWidthStrSet  toggle pixmap at xmin.toAidLengthStrSet ymin.txWidthStrSet                            callback '!this.showDimFeedbackStrSet(' anchor T+R                     width 16 height 16

    -- tasks
    ---------------------------------------------------------------------------
    para   .paTaskStrSet                 at xmin form           ymax+.5 text 'Tasks'
    line   .lnTaskStrSet                 at xmin                ymax-.2                                                                             anchor T+L+R HORIZ width 36
    button .lkreEvaluateStrSet linklabel at xmin.txLengthStrSet ymax    'Re-Evaluate stair flight'              callback '!this.reEvaluateStrSet()'                    width 30
    button .lkPickStrSet       linklabel at                     ymax-.2 'Repick top and bottom of stair flight' callback '!this.pickStrSet('                           width 30
    button .lkPickStrSetBottom linklabel at                     ymax-.2 'Repick bottom of stair flight'         callback '!this.singlePickStrSet('                     width 30
    button .lkPickStrSetTop    linklabel at                     ymax-.2 'Repick top of stair flight'            callback '!this.singlePickStrSet('                     width 30


    -- detailed attributes
    ---------------------------------------------------------------------------
    frame .frDetailAttributesStrSet FoldUp        at xmin form                                      'Detailed attributes'                                         anchor T+L+R             width 36
      text   .txLCutPlaneStrSet                   at xmin.txORiseStrSet                             'Lower Cutplane:'     callback '!this.modifyStrSet('          anchor T+L+R tagwidth 14 width 10           is STRING
      text   .txUCutPlaneStrSet                   at xmin.txORiseStrSet                             'Upper Cutplane:'     callback '!this.modifyStrSet('          anchor T+L+R tagwidth 14 width 10           is STRING
      text   .txFThicknessStrSet                  at xmin.txORiseStrSet                             'Flight Thickness:'   callback '!this.modifyStrSet('          anchor T+L+R tagwidth 14 width 10           is REAL format !!distanceFmt
      button .toAidFThicknessStrSet toggle pixmap at xmin.toAidLengthStrSet ymin.txFThicknessStrSet                       callback '!this.showDimFeedbackStrSet(' anchor T+R               width 16 height 16
      text   .txLOffsetStrSet                     at xmin.txLengthStrSet                            'Lower Offset:'       callback '!this.modifyStrSet('          anchor L+T+R tagwidth 14 width 10           is REAL format !!distanceFmt
      text   .txUOffsetStrSet                     at xmin.txLengthStrSet                            'Upper Offset:'       callback '!this.modifyStrSet('          anchor L+T+R tagwidth 14 width 10           is REAL format !!distanceFmt
    exit

    -- frame for one stair flight ( without gates )
    ---------------------------------------------------------------------------
    frame .frSegmentStrSet FoldUp                                    'Segment attributes'                                            anchor T+L+R       width 36
      numeric .nuSegmentStrSet    at x3                              'Segment'            callback '!this.updateFrameSegmentStrSet('                    width 2
      para    .paSegmentStrSet    at xmax                    ymin    text 'of  '

      -- pitch and number of treads
      para    .paExtensionStrSet  at x1                      ymax    text 'Extensions'
      line    .lnExtensionStrSet  at xmin                    ymax-.2                                                                 anchor T+L+R HORIZ width 31
      do !i to 4
        button .toExtensionOptionStrSet$!i toggle    at x3   ymax pixmap callback '!this.extensionOptionStrSet(' width 16 height 16
        button .lkExtensionOptionStrSet$!i linklabel at xmax ymin ''     callback '!this.extensionOptionStrSet(' width 30
      enddo
      para   .paLockHeading                       at xmax.txFThicknessStrSet ymax                    anchor T+R   text 'Lock'
      text   .txLExtensionStrSet                  at xmin.txORiseStrSet      ymax                    anchor T+L+R 'Lower Extension:' callback '!this.modifyStrSet('          tagwidth 14 width 10           is REAL format !!distanceFmt
      toggle .toLExtensionStrSet                  at xmax+1                  ymin                    anchor T+R                      callback '!this.setLocksStrSet('
      button .toAidLExtensionStrSet toggle pixmap at xmin.toAidLengthStrSet  ymin.txLExtensionStrSet anchor T+R                      callback '!this.showDimFeedbackStrSet('             width 16 height 16
      text   .txUExtensionStrSet                  at xmin.txORiseStrSet                              anchor T+L+R 'Upper Extension:' callback '!this.modifyStrSet('          tagwidth 14 width 10           is REAL format !!distanceFmt
      toggle .toUExtensionStrSet                  at xmin.toLExtensionStrSet ymin                    anchor T+R                      callback '!this.setLocksStrSet('
      button .toAidUExtensionStrSet toggle pixmap at xmin.toAidLengthStrSet  ymin.txUExtensionStrSet anchor T+R                      callback '!this.showDimFeedbackStrSet('             width 16 height 16

      -- pitch and number of treads
      para    .paOptimumStrSet  at xmin.paExtensionStrSet+.1 ymax+.5 text 'Pitch and number of treads'
      line    .lnOptimumStrSet  at xmin                      ymax-.2                                   anchor T+L+R HORIZ                                          width 31
      rtoggle .rtOptimumStrSet  at xmin.paOptimumStrSet+1    ymax-1  'Optimum'                                            callback '!this.changeCalcMethodStrSet('
      rtoggle .rtExplicitStrSet at xmax                      ymin    'Explicit'                                           callback '!this.changeCalcMethodStrSet('

      frame .frOptimumStrSet panel at xmin.rtOptimumStrSet   ymax+1                                    anchor T+L+R
        option .opOptimumStrSet                                   callback '!this.getOptimumStrSet(' anchor L+T+R width 25
      exit

      -- explicit values
      frame .frExplicitStrSet panel at xmin.frOptimumStrSet ymin.frOptimumStrSet  anchor T+L+R
        button  .buOptimumStrSet                at xmin.opOptimumStrSet    ymin               'Pitch    '              callback '!this.getOptimumPitchStrSet()'             width  4
        text    .txPitchStrSet                  at xmax+7                  ymin                           anchor L+T+R callback '!this.modifyStrSet('                       width 10           is REAL format !!angleFmt
        option  .opPitchStrSet                  at xmin.txPitchStrSet      ymin.txPitchStrSet             anchor L+T+R callback '!this.modifyStrSet('                       width  8
        toggle  .toPitchStrSet                  at xmin.toLExtensionStrSet ymin                           anchor   T+R callback '!this.setLocksStrSet('
        option  .opTreadsStrSet                 at xmin.buOptimumStrSet                       'Treads:'   anchor L+T+R callback '!this.modifyStrSet('           tagwidth 12 width  6
        toggle  .toTreadsStrSet                 at xmin.toLExtensionStrSet ymin                           anchor   T+R callback '!this.setLocksStrSet('
        button  .toAidPitchStrSet toggle pixmap at xmin.toAidLengthStrSet  ymin.txPitchStrSet             anchor   T+R callback '!this.showDimFeedbackStrSet('              width 16 height 16
      exit

      path down

      -- catalogue elements
      para  .paDetailSegmAttributesStrSet       at xmin.paOptimumStrSet ymax-.2                    text 'Detailed segment attributes'
      line  .lnDetailSegmAttributesStrSet       at xmin                 ymax-.2 anchor T+L+R HORIZ                                    width 31
      frame .frDetailSegmAttributesStrSet panel at xmin                 ymax+.2 anchor T+L+R
        text   .txOGoingStrSet                     at xmin.txORiseStrSet                            'Overall Going:' anchor T+L+R callback '!this.modifyStrSet('           tagwidth 14 width 10           is REAL format !!distanceFmt
        option .opOGoingStrSet                     at xmin.txORiseStrSet  ymin.txOGoingStrSet       'Overall Going:' anchor T+L+R callback '!this.modifyStrSet('           tagwidth 14 width  8
        toggle .toOGoingStrSet                        at xmin.toPitchStrSet  ymin                                    anchor T+R   callback '!this.setLocksStrSet('
        button .toAidOGoingStrSet    toggle pixmap at xmin.toAidLengthStrSet ymin.txOGoingStrSet                     anchor T+R   callback '!this.showDimFeedbackStrSet('              width 16 height 16
        text   .txGoingStrSet                      at xmin.txORiseStrSet                            'Going:'         anchor T+L+R callback '!this.modifyStrSet('           tagwidth 14 width 10           is REAL format !!distanceFmt
        option .opGoingStrSet                      at xmin.txORiseStrSet     ymin.txGoingStrSet     'Going:'         anchor T+L+R callback '!this.modifyStrSet('           tagwidth 14 width  8
        toggle .toGoingStrSet                      at xmin.toOGoingStrSet    ymin                                    anchor T+R   callback '!this.setLocksStrSet('
        button .toAidGoingStrSet     toggle pixmap at xmin.toAidLengthStrSet ymin.txGoingStrSet                      anchor T+R   callback '!this.showDimFeedbackStrSet('              width 16 height 16
        text   .txRiseStrSet                       at xmin.txORiseStrSet                            'Rise:'          anchor T+L+R callback '!this.modifyStrSet('           tagwidth 14 width 10           is REAL format !!distanceFmt
        option .opRiseStrSet                       at xmin.txORiseStrSet     ymin.txRiseStrSet      'Rise:'          anchor T+L+R callback '!this.modifyStrSet('           tagwidth 14 width  8
        toggle .toRiseStrSet                       at xmin.toOGoingStrSet    ymin                                    anchor T+R   callback '!this.setLocksStrSet('
        button .toAidRiseStrSet      toggle pixmap at xmin.toAidLengthStrSet ymin.txRiseStrSet                       anchor T+R   callback '!this.showDimFeedbackStrSet('              width 16 height 16
        text   .txLRiseStrSet                      at xmin.txORiseStrSet                            'Bottom Rise:'   anchor T+L+R                                          tagwidth 14 width 10           is REAL format !!distanceFmt
        button .toAidLRiseStrSet     toggle pixmap at xmin.toAidLengthStrSet ymin.txLRiseStrSet                      anchor T+R   callback '!this.showDimFeedbackStrSet('              width 16 height 16
        text   .txURiseStrSet                      at xmin.txORiseStrSet                            'Top Rise:'      anchor T+L+R                                          tagwidth 14 width 10           is REAL format !!distanceFmt
        button .toAidURiseStrSet     toggle pixmap at xmin.toAidLengthStrSet ymin.txURiseStrSet                      anchor T+R   callback '!this.showDimFeedbackStrSet('              width 16 height 16
        text   .txClearanceStrSet                  at xmin.txORiseStrSet                            'Clearance:'     anchor T+L+R                                          tagwidth 14 width 10           is REAL format !!distanceFmt
        button .toAidClearanceStrSet toggle pixmap at xmin.toAidLengthStrSet ymin.txClearanceStrSet                  anchor T+R   callback '!this.showDimFeedbackStrSet('              width 16 height 16
      exit
    exit

    -- installation options
    ---------------------------------------------------------------------------
    frame .frInstallationStrSet FoldUp  'Installation options' anchor T+L+R               width 36
      do !i to 7
        button .toInstallOptionStrSet$!i  toggle    at x3    ymax     pixmap    callback '!this.installOptionStrSet(' width 16 height 16
        button .lkInstallOptionStrSet$!i  linklabel at xmax  ymin    ''         callback '!this.installOptionStrSet(' width 30
      enddo
    exit

    -- position options
    ---------------------------------------------------------------------------
    frame .frPositionStrSet FoldUp  'Position options' anchor T+L+R               width 36
      do !i to 5
        button .toLPosOptionStrSet$!i toggle    at x3   ymax pixmap callback '!this.posOptionStrSet(' width 16 height 16
        button .lkLPosOptionStrSet$!i linklabel at xmax ymin ''     callback '!this.posOptionStrSet(' width 30
      enddo

      frame .frLPosStrSet  'Position' anchor T+L+R   at x0 width 36  hei 7
        container .netStrSetLPositionFrame PMLNetCONTROL 'NET' dock fill
      exit
      text .txLPosOriginStrSet 'WRT:'   at xmin    ymax    callback '!this.setWrt(' anchor L+T+R tagwidth 12 width 10 is STRING
      line .lnPositionStrSet            at xmin.paExtensionStrSet   ymax+.1  anchor T+L+R HORIZ width 34

      do !i to 5
        button .toUPosOptionStrSet$!i toggle    at x3   ymax pixmap callback '!this.posOptionStrSet(' width 16 height 16
        button .lkUPosOptionStrSet$!i linklabel at xmax ymin ''     callback '!this.posOptionStrSet(' width 30
      enddo

      frame .frUPosStrSet  'Position' anchor T+L+R   at x0 width 36  hei 7
        container .netStrSetUPositionFrame PMLNetCONTROL 'NET' dock fill
      exit
      text .txUPosOriginStrSet 'WRT:'   at xmin ymax    callback '!this.setWrt(' anchor L+T+R tagwidth 12   width 10 is STRING
    exit

    -- direction options
    ---------------------------------------------------------------------------
    frame .frDirectionStrSet FoldUp  'Direction options' anchor T+L+R                                 width 36
      do !i to 5
        button .toDirOptionStrSet$!i toggle    at x3   ymax pixmap callback '!this.dirOptionStrSet('                                 width 16 height 16
        button .lkDirOptionStrSet$!i linklabel at xmax ymin    ''  callback '!this.dirOptionStrSet('                                 width 30
      enddo
      text .txDirStrSet        'Direction:'    at x3   ymax        callback '!this.setMainAttributesStrSet()'  anchor L+T+R tagwidth 12 width 10           is STRING
      text .txDirOriginStrSet  'WRT:'          at x3   ymax        callback '!this.setMainAttributesStrSet()'  anchor L+T+R tagwidth 12 width 10           is STRING
    exit

    -- catalogue elements
    ---------------------------------------------------------------------------
    frame .frCatalogueStrSet FoldUp 'Standard & templates' anchor T+L+R       width 36
      para   .paStandardTagStrSet          at xmin.paExtensionStrSet         text 'Standard'                                                width 30 lines 1
      line   .lnStandardTagStrSet          at xmin                 ymax-.2                                             anchor T+L+R HORIZ width 32
      para   .paStandardStrSet             at xmin                                                                     width 28 lines 1

      para   .paStrFltTmplReferenceStrSet  at xmin.paExtensionStrSet         text 'Stairflight template'                                    width 30 lines 1
      line   .lnStrFltTmplReferenceStrSet  at xmin                 ymax-.2                                             anchor T+L+R HORIZ width 32
      option .opStrFltTmplReferenceStrSet  at xmin.paStandardStrSet        callback '!this.modifyStrSetTmplReference(' anchor L+T+R       width 28

      para   .paStrLngTmplReferenceStrSet  at xmin.paExtensionStrSet         text 'Landing template'                                       width 30 lines 1
      line   .lnStrLngTmplReferenceStrSet  at xmin                 ymax-.2                                             anchor T+L+R HORIZ width 32
      option .opStrLngTmplReferenceStrSet  at xmin.paStandardStrSet        callback '!this.modifyStrSetTmplReference(' anchor L+T+R       width 28

      para   .paHandRaTmplReferenceStrSet  at xmin.paExtensionStrSet         text 'Handrail template'                                       width 30 lines 1
      line   .lnHandRaTmplReferenceStrSet  at xmin                 ymax-.2                                              anchor T+L+R HORIZ width 32
      option .opHandRaTmplReferenceStrSet  at xmin.paStandardStrSet        callback '!this.modifyStrSetTmplReference(' anchor L+T+R       width 28
    exit

    -- Intermediate landings
    ---------------------------------------------------------------------------
    frame .frAccessStrSet FoldUp 'Explicit intermediate landings' anchor T+L+R         width 36
      container .coAccessStrSet PMLNetCONTROL                                                                                           anchor all width 33 height 10
      button    .lkCreateAccessStrSet linklabel at x1           'Create'           callback '!this.newAccessStrSet()'          width 25
      button    .lkPickAccessStrSet   linklabel at    ymax - .2 'Pick position'    callback '!this.pickAccessStrSet()' width 25
      button    .lkDeleteAccessStrSet linklabel at    ymax - .2 'Delete selected'  callback '!this.deleteAccessStrSet()'       width 25
    exit

    para   .paBackToMainStrSet           at xmin.paCreate ymax+.5 pixmap                                                                                   width 16 height 16
    button .lkBackToMainStrSet linklabel at xmin.lkCreateStrSet ymin   'Return to main'                               callback '!this.frameChange(!this.frMain)' width 30
  exit
  ------------------------------------------------------------------------------------------------------------------------------------------------------
  -- stair tower
  ------------------------------------------------------------------------------------------------------------------------------------------------------
  frame .frMainWorkStrTwr panel at xmin.frMain ymin.frMain anchor T+L+R
    --------------------------------------------------------------------------------
    --main attributes
    --------------------------------------------------------------------------------
    frame .frMainAttStrTwr 'Stair Tower Definition Attributes' anchor T+L+R at xmin form ymax+0.1 width 40
      --para .paMainAttStrTwr      at xmin form ymax                             text 'Main Definition Attributes'
      --line .lnMainAttStrTwr     at xmin      ymax-.2  anchor T+L+R HORIZ width 38
      text .dbName  'Name'  tagwidth 10               anchor top + left + right   at xmin+3               ymax+0.1           callback '!this.checkName()' width 25 is STRING
      text .dbDescription 'Description' tagwidth 10   anchor top + left + right   at xmin                 ymax+0.1           callback '' width 25 is STRING
      --text .dbFunction    'Function:'   tagwidth 10    anchor top + left + right   at xmin                 ymax+0.1           callback '' width 20 is STRING
      numericinput .dbArea 'Area'      tagwidth 10    anchor top + left           at xmin                 ymax+0.1           callback '' range 0 10000 ndp 0 width 4
      numericinput .dbNumber 'Number'  tagwidth 10    anchor top + left           at xmax+0.1                 ymin           callback '' range 0 10000 ndp 0 width 4
    exit
    --------------------------------------------------------------------------------
    -- Position / Orientation
    --------------------------------------------------------------------------------
    frame .frLocDirStrtwr 'Stair Tower Direction and Location' anchor T+L+R at xmin form ymax+0.25           width 40
      --para .paLocDirStrTwr      at xmin form ymax+1                             text 'Direction and Location'
      --line .lnLocDirStrTwr      at xmin      ymax  anchor T+L+R HORIZ      width 38
      text .txDirectionStrTwr 'Direction ' tagwidth 10 anchor L+T+R       at xmin+3                ymax+0.1           callback '!this.modifyStrTwr('  width 10           is STRING
        button .pickPosition linkLabel 'Pick Position...'    anchor top + left + right   at xmin                    ymax            callback '!this.pickPosition()' width 20

      frame .frPositionStrTwr panel 'Stair Tower Position' anchor T+L+R   width 36  hei 5
        container .netStrTwrPositionFrame PMLNetCONTROL 'NET' dock fill
      exit
    exit

    --------------------------------------------------------------------------------
    -- installation options
    --------------------------------------------------------------------------------
    frame .frInstallationStrTwr  'Stair Landing Installation Details' anchor T+L+R  at xmin form ymax+0.25             width 40
      --para   .paInstallationStrTwr             at xmin form              ymax+1      text 'Landing Installation Details'
      --line   .lnInstallationStrTwr             at xmin                   ymax-0.2  anchor L+T+R  HORIZ width 38
      para   .paClockwiseStrTwr                at xmin+1.5                               text 'Installation Sense'   width 30 lines 1
      line   .lnClockwiseStrTwr                at xmin                   ymax-.2  anchor T+L+R HORIZ width 36
      button .toClockwiseStrTwr      toggle    at xmin+2                 ymax+0.2  pixmap          callback '!this.senseStrTwr(' width 16 height 16
      button .lkClockwiseStrTwr      linklabel at xmax                   ymin      'Clockwise'      callback '!this.senseStrTwr(' width 12
      button .toAntiClockwiseStrTwr  toggle    at xmax                   ymin      pixmap          callback '!this.senseStrTwr(' width 16 height 16
      button .lkAntiClockwiseStrTwr  linklabel at xmax                   ymin      'Anti-Clockwise' callback '!this.senseStrTwr(' width 10

      para   .paInstallOptionStrTwr            at xmin.paClockwiseStrTwr ymax                             text 'Landing Configuration'                      width 30 lines 1
      line   .lnInstallOptionStrTwr            at xmin                   ymax-0.2 anchor T+L+R HORIZ width 36
      para   .paInstallOptionStrTwr1           at xmin+0.7               ymax text 'One stair'    width 7 lines 1
      para   .paInstallOptionStrTwr2           at xmax                   ymin text 'Two stairs'   width 8 lines 1
      para   .paInstallOptionStrTwr3           at xmax                   ymin text 'Three stairs' width 9 lines 1
      para   .paInstallOptionStrTwr4           at xmax                   ymin text 'Four stairs'  width 8 lines 1

      path down
      button .toInstallOptionStrTwr1  toggle   at xmin.paInstallOptionStrTwr1+1          ymax     pixmap           callback '!this.installOptionStrTwr(' width 24 height 24
      --button .toInstallOptionStrTwr2  toggle   at xmax+.5  ymin     pixmap           callback '!this.installOptionStrTwr(' width 24 height 24
      --button .toInstallOptionStrTwr3  toggle   at xmax+.5  ymin     pixmap           callback '!this.installOptionStrTwr(' width 24 height 24
      --button .toInstallOptionStrTwr4  toggle   at xmax+.5  ymin     pixmap           callback '!this.installOptionStrTwr(' width 24 height 24


      button .toInstallOptionStrTwr2  toggle   at xmax+4                   ymin     pixmap           callback '!this.installOptionStrTwr(' width 24 height 24
      --button .toInstallOptionStrTwr6  toggle   at xmax+.5  ymin     pixmap           callback '!this.installOptionStrTwr(' width 24 height 24


      button .toInstallOptionStrTwr3  toggle   at xmax+5     ymin     pixmap           callback '!this.installOptionStrTwr(' width 24 height 24
      --button .toInstallOptionStrTwr4  toggle   at xmax+.5  ymin     pixmap           callback '!this.installOptionStrTwr(' width 24 height 24
      --button .toInstallOptionStrTwr5  toggle   at xmax+.5  ymin     pixmap           callback '!this.installOptionStrTwr(' width 24 height 24
      --button .toInstallOptionStrTwr6 toggle   at xmax+.5  ymin     pixmap           callback '!this.installOptionStrTwr(' width 24 height 24


      button .toInstallOptionStrTwr4 toggle   at xmax+5    ymin     pixmap           callback '!this.installOptionStrTwr(' width 24 height 24
    exit

    ---------------------------------------------------------------------------------------------------
    -- catalogue elements
    ---------------------------------------------------------------------------------------------------

    frame .frCatalogueStrTwr 'Catalogue Selection for Stair Tower' anchor T+L+R  at xmin form ymax+0.25             width 40
      --para   .paStandardTagStrTwr          at xmin.paCreate         text 'Standard'                                                        width 30 lines 1
      --line   .lnStandardTagStrTwr          at xmin           ymax-.2                                                  anchor T+L+R HORIZ   width 32
      --para   .paStandardStrTwr             at xmin.paCreate+2                                                                              width 28 lines 1

      para   .paStrFltTmplReferenceStrTwr  at xmin+2 ymax         text 'Stair Flight'                                            width 10 lines 1
      --line   .lnStrFltTmplReferenceStrTwr  at xmin           ymax-.2                                                  anchor T+L+R HORIZ   width 32
      option .opStrFltTmplReferenceStrTwr  at xmax ymin       callback '!this.modifyStrTwrTmplReference(' anchor L+T+R         width 23

      para   .paStrLngTmplReferenceStrTwr  at xmin.paStrFltTmplReferenceStrTwr ymax         text 'Stair Landing'                                                width 10 lines 1
      --line   .lnStrLngTmplReferenceStrTwr  at xmin           ymax-.2                                                  anchor T+L+R HORIZ   width 32
      option .opStrLngTmplReferenceStrTwr  at xmax ymin       callback '!this.modifyStrTwrTmplReference(' anchor L+T+R         width 23

      para   .paHandRaTmplReferenceStrTwr  at xmin.paStrFltTmplReferenceStrTwr ymax       text 'Handrail'                                               width 10 lines 1
      --line   .lnHandRaTmplReferenceStrTwr  at xmin                 ymax-.2                                              anchor T+L+R HORIZ width 32
      option .opHandRaTmplReferenceStrTwr  at xmax ymin       callback '!this.modifyStrTwrTmplReference(' anchor L+T+R        width 23
    exit
-------------------------------------------------------------------------------------------------

    ---------------------------------------------------------------------------
    -- general attributes
    ---------------------------------------------------------------------------
    frame .frGenAttStrTwr     'Stair Tower Layout Attributes' anchor T+L+R at xmin form ymax+0.25        width 40
      --para  .paGeneralStrTwr    at xmin form      ymax+0.5                             text 'General Definition attributes'
      --line  .lnGeneralStrTwr    at xmin      ymax-.2 anchor T+L+R HORIZ width 38
      text   .txXLengthStrTwr           'Tower XLength ' at x3                                           callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14           is REAL format !!distanceFmt
      option .opXLengthStrTwr           'Tower XLength ' at xmin.txXLengthStrTwr    ymin.txXLengthStrTwr callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14
      button .toAidXLengthStrTwr toggle                  at x35                     ymin.txXLengthStrTwr callback '!this.showDimFeedbackStrTwr('  anchor T+R   pixmap      width 16 height 16
      text   .txYLengthStrTwr           'Tower YLength ' at xmin.txXLengthStrTwr                         callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14           is REAL format !!distanceFmt
      option .opYLengthStrTwr           'Tower YLength ' at xmin.txXLengthStrTwr    ymin.txYLengthStrTwr callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14
      button .toAidYLengthStrTwr toggle                  at xmin.toAidXLengthStrTwr ymin.txYLengthStrTwr callback '!this.showDimFeedbackStrTwr('  anchor T+R   pixmap      width 16 height 16
      text   .txZLengthStrTwr           'Tower Height '  at xmin.txXLengthStrTwr                         callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14           is REAL format !!distanceFmt
      option .opZLengthStrTwr           'Tower Height '  at xmin.txXLengthStrTwr    ymin.txZLengthStrTwr callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14
      button .toAidZLengthStrTwr toggle                  at xmin.toAidXLengthStrTwr ymin.txZLengthStrTwr callback '!this.showDimFeedbackStrTwr('  anchor T+R   pixmap      width 16 height 16
    --frame .frDetailAttributesStrTwr FoldUp  at xmin form 'Detailed Layout attributes' anchor T+L+R               width 40
      text   .txCLXSpacingStrTwr       'CL Spacing X '      at xmin.txXLengthStrTwr                               callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14          is REAL format !!distanceFmt
      option .opCLXSpacingStrTwr       'CL Spacing X '      at xmin.txXLengthStrTwr     ymin.txCLXSpacingStrTwr   callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14
      button .toAidCLXSpacingStrTwr toggle                  at xmin.toAidYLengthStrTwr  ymin.txCLXSpacingStrTwr   callback '!this.showDimFeedbackStrTwr('  anchor T+R   pixmap      width 16 height 16
      text   .txCLYSpacingStrTwr       'CL Spacing Y'      at xmin.txXLengthStrTwr                               callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14           is REAL format !!distanceFmt
      option .opCLYSpacingStrTwr       'CL Spacing Y '      at xmin.txXLengthStrTwr     ymin.txCLYSpacingStrTwr   callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14
      button .toAidCLYSpacingStrTwr toggle                  at xmin.toAidYLengthStrTwr  ymin.txCLYSpacingStrTwr   callback '!this.showDimFeedbackStrTwr('  anchor T+R   pixmap      width 16 height 16
--      option .opSenseStrTwr            'Sense'             at xmin.txXLengthStrTwr                               callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 15 width 10
      --text   .txDirectionStrTwr        'Primary Direction ' at xmin.txXLengthStrTwr                               callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 15 width 10           is STRING
      text   .txStrFltWidthStrTwr      'Stairflight Width ' at xmin.txXLengthStrTwr                               callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14         is REAL format !!distanceFmt
      option .opStrFltWidthStrTwr      'Stairflight Width ' at xmin.txXLengthStrTwr     ymin.txStrFltWidthStrTwr  callback '!this.modifyStrTwr('           anchor L+T+R tagwidth 14 width 14
      button .toAidStrFltWidthStrTwr   toggle               at xmin.toAidYLengthStrTwr  ymin.txStrFltWidthStrTwr  callback '!this.showDimFeedbackStrTwr('  anchor T+R   pixmap      width 16 height 16
      text   .txFThicknessStrTwr       'Stringer Thickness '  at xmin.txXLengthStrTwr                               callback '!this.modifyStrTwr('           anchor T+L+R tagwidth 14 width 14          is REAL format !!distanceFmt
      option .opFThicknessStrTwr       'Stringer Thickness '  at xmin.txXLengthStrTwr     ymin.txStrFltWidthStrTwr  callback '!this.modifyStrTwr('           anchor T+L+R tagwidth 14 width 14
      button .toAidFThicknessStrTwr    toggle               at xmin.toAidYLengthStrTwr  ymin.txFThicknessStrTwr   callback '!this.showDimFeedbackStrTwr('  anchor T+R   pixmap      width 16 height 16
      button .buOptimumStrTwr          'Pitch    '          at xmin.txXLengthStrTwr     ymax+.2                   callback '!this.getOptimumPitchStrTwr()'                          width 4
      text   .txStrFltPitchStrTwr                           at xmax+9                  ymin                      callback '!this.modifyStrTwr('           anchor L+T+R             width 14         is REAL format !!angleFmt
      option .opStrFltPitchStrTwr                           at xmin.txStrFltPitchStrTwr ymin.txStrFltPitchStrTwr  callback '!this.modifyStrTwr('           anchor L+T+R             width 14
      button .toAidStrFltPitchStrTwr  toggle                at xmin.toAidYLengthStrTwr  ymin.txStrFltPitchStrTwr  callback '!this.showDimFeedbackStrTwr('  anchor   T+R pixmap      width 16 height 16
    exit

--
    -- General attributes
    --frame .frAccessStrTwr FoldUp 'Access points Attributes' anchor T+L+R                                                                                   width 36
    --  container .coAccessStrTwr PMLNetCONTROL    anchor all width 32 height 10
    --  button    .lkNewAccessStrTwr      linklabel at x1           'Create'             callback '!this.newAccessStrTwr()'          width 25
    --  button    .lkPickAccessStrTwr     linklabel at    ymax - .2 'Pick position'      callback '!this.pickAccessStrTwr()' width 25
