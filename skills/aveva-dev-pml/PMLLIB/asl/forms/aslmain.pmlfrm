--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimFeedbackStrTwr(!gadget is GADGET, !action is STRING)

--  if ( !gadget.set() and $
--       !gadget.eq(!this.lkAidAccessStrTwr) ) then
--    if ( !this.lkAidAccessStrTwr.tag.eq('Display') ) then
--      !this.lkAidAccessStrTwr.tag = 'Hide'
--    elseif ( !this.lkAidAccessStrTwr.tag.eq('Hide') ) then
--      !this.lkAidAccessStrTwr.tag = 'Display'
--    endif
--  endif

  -- fill the dimension object, depends on the form toggles
  !strTwrDimension               = object ASLSTRTWRDIM()
  !strTwrDimension.clXSpacing    = !this.toAidClXSpacingStrTwr.val
  !strTwrDimension.clYSpacing    = !this.toAidClYSpacingStrTwr.val
  !strTwrDimension.strFltPitch   = !this.toAidStrFltPitchStrTwr.val
  !strTwrDimension.strFltWidth   = !this.toAidStrFltWidthStrTwr.val
  !strTwrDimension.fThickness    = !this.toAidFThicknessStrTwr.val
  !strTwrDimension.xLength       = !this.toAidXLengthStrTwr.val
  !strTwrDimension.yLength       = !this.toAidYLengthStrTwr.val
  !strTwrDimension.zLength       = !this.toAidZLengthStrTwr.val
  --!strTwrDimension.gates         = !this.lkAidAccessStrTwr.tag.neq('Display')
  !this.meStrTwrEngine.strTwrDim = !strTwrDimension

  !this.meStrTwrEngine.showDimFeedback()

endmethod
-- End of method

----------------------------------------------------
--
-- Method:      showDimFeedbackWWay
--
-- Description: callback from view gadgets
--              set/unset all dimensions regarding value of  view gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimFeedbackWWay(!gadget is GADGET, !action is STRING)

  if ( !gadget.set() ) then
    -- access
    if ( !gadget.eq(!this.lkAidAccessWWay) ) then
      if ( !this.lkAidAccessWWay.tag.eq('Display') ) then
        !this.lkAidAccessWWay.tag = 'Hide'

      elseif ( !this.lkAidAccessWWay.tag.eq('Hide') ) then
        !this.lkAidAccessWWay.tag = 'Display'
      endif
    endif
  endif

  -- removes the old aid elements
  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()

  -- draws the access points
  if ( !this.lkAidAccessWWay.tag.eq('Hide') ) then
    !this.meWWayEngine.drawAccess()
  endif

endmethod
-- End of method

