  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'
  member .strTwrPosControl      is POSITIONCONTROL
  member .strSetLPosControl     is POSITIONCONTROL
  member .strSetUPosControl     is POSITIONCONTROL
  member .ladderPosControl      is POSITIONCONTROL

  ---------------------------------------------------------------------------
  -- Members for Plane definition in EDGPICK

  member .planeNumber           is ARRAY

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslMain
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslMain()


--Implementation of positional control

  ------------------Setup for position control-----------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  --Create new instance of position control
  !this.strTwrPosControl            = object POSITIONCONTROL()
  !this.strSetLPosControl           = object POSITIONCONTROL()
  !this.strSetUPosControl           = object POSITIONCONTROL()
  !this.ladderPosControl            = object POSITIONCONTROL()

  --Load ship grid data
  !grid                       = object SHIPGRID()
  !gridDefined                = !grid.position.set()

  -- Only populate the grid data if a ship reference grid is available
  if(!gridDefined) then

      do !i indices !grid.xID
        !xGridData[!i][1]     = !grid.xID[!i]
        !xGridData[!i][2]     = !grid.xOffset[!i]
      enddo

      do !i indices !grid.yID
        !yGridData[!i][1]     = !grid.yID[!i]
        !yGridData[!i][2]     = !grid.yOffset[!i]
      enddo

      do !i indices !grid.zID
        !zGridData[!i][1]     = !grid.zID[!i]
        !zGridData[!i][2]     = !grid.zOffset[!i]
      enddo

    -- Set grid data
    !this.strTwrPosControl.gridData(!xGridData,!yGridData,!zGridData)
    !this.strSetLPosControl.gridData(!xGridData,!yGridData,!zGridData)
    !this.strSetUPosControl.gridData(!xGridData,!yGridData,!zGridData)
    !this.ladderPosControl.gridData(!xGridData,!yGridData,!zGridData)


    -- Initialise as grid control and Specify tags
    !this.strTwrPosControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
    !this.strSetLPosControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
    !this.strSetUPosControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
    !this.ladderPosControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.strTwrPosControl.heading('World Position')
    !this.strSetLPosControl.heading('World Position')
    !this.strSetUPosControl.heading('World Position')
    !this.ladderPosControl.heading('World Position')

    !this.strTwrPosControl.gridFormat()
    !this.strSetLPosControl.gridFormat()
    !this.strSetUPosControl.gridFormat()
    !this.ladderPosControl.gridFormat()

  else
    var !coordinate coordinate
      if(!coordinate.eq('ENU'))then
      	!this.strTwrPosControl.enuFormat()
      	!this.strSetLPosControl.enuFormat()
      	!this.strSetUPosControl.enuFormat()
      	!this.ladderPosControl.enuFormat()
      else
        !this.strTwrPosControl.xyzFormat()
        !this.strSetLPosControl.xyzFormat()
        !this.strSetUPosControl.xyzFormat()
        !this.ladderPosControl.xyzFormat()
      endif

    !this.strTwrPosControl.gridVisible(false)
    !this.strSetLPosControl.gridVisible(false)
    !this.strSetUPosControl.gridVisible(false)
    !this.ladderPosControl.gridVisible(false)
  endif
  -- End of codes for Implementing positional control

  !this.strTwrPosControl.changeAction('!!aslMain.modifyStrTwr(!!aslMain.netStrTwrPositionFrame,||)')
  !this.strSetLPosControl.changeAction('!!aslMain.modifyStrSet(!!aslMain.netStrSetLPositionFrame,||)')
