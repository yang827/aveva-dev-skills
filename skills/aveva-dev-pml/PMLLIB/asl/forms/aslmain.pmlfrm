define method .pickAccessHandRa()

  !rows = !this.neAccessHandRa.getSelectedRows()
  if ( !rows.size().neq(1) ) then
    !!alert.warning('Only possible when one row is selected')
    return
  endif

  -- defines packet
  !packet                     = object EDGPACKET()
  !packet.pickPacket.prompt   = 'Repick position for handrail gate'

  -- defines first pick
  !packet.pickPacket.picks[1] = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('')

  -- define actions on first pick
  !packet.action              = '!!aslMain.pickAccessHandRaReturn(!this.return[1])'

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
