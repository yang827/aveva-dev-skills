define method .updateAccessWWay()

  using namespace  'Aveva.Pdms.Presentation'

  !posFmt     = !!distanceFmt
  !posFmt.dp  = 0

  --set the headings of the access-list
  !heading[1] = 'No'
  !heading[2] = 'Arrive Offset'
  !heading[3] = 'Leave Offset'

  !title      = 'Access Points'

  !allGates   = !this.meWWayEngine.getGates()
--  !wWayRefe = !this.meWWayEngine.getRefe()
  !columns    = object ARRAY()
  do !i index !allGates
    !gate        = !allGates[!i]
    !columns[!i] = object ARRAY()
    !columns[!i].append(!i.string())
    !columns[!i].append(!gate.arriveOffset.string())
    !columns[!i].append(!gate.leaveOffset.string())
  enddo

  !netDataSource = object NETDATASOURCE(!title, !heading, !columns)
  !this.neAccessWWay.bindToDataSource(!netDataSource)

  !this.lkDeleteAccessWWay.active = false
  !this.lkPickAccessWWay.active   = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateCataOptionsHandRa
--
-- Description: updates the catalogue options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateCataOptionsHandRa()

  -- Standard ('BS Private')
  !this.paStandardHandRa.val = !this.meHandRaEngine.getSettingReference()

  -- collect all stairs from the options
  !dText           = object ARRAY()
  !rText           = object ARRAY()
  !allCataElements = !!aslCentralData.currSetting.collectAll('HANDRA')
  do !cataElement value !allCataElements
    !dText.append(!cataElement.description)
    !rText.append(!cataElement.string())
  enddo
  !this.opHandRaTmplReferenceHandRa.dText = !dText
  !this.opHandRaTmplReferenceHandRa.rText = !rText

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateCataOptionsLadder
--
-- Description: updates the catalogue options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateCataOptionsLadder()

  -- Standard ('BS Private')
  !this.paStandardLadder.val = !this.meLadderEngine.getSettingReference()

  -- collect all stairs from the options
  !dText           = object ARRAY()
  !rText           = object ARRAY()
  !allCataElements = !!aslCentralData.currSetting.collectAll('LADDER')
  do !cataElement value !allCataElements
    !dText.append(!cataElement.description)
    !rText.append(!cataElement.string())
  enddo
  !this.opLadderTmplReferenceLadder.dText = !dText
  !this.opLadderTmplReferenceLadder.rText = !rText

  -- try to select the current tmpl
  !currentTmplReference = !this.meLadderEngine.getTmplReference().string()
  if ( !this.opLadderTmplReferenceLadder.rText.find(!currentTmplReference).unset() ) then
    !currentTmplReference = !this.opLadderTmplReferenceLadder.selection().dbRef()
    !this.meLadderEngine.setTmplReference(!currentTmplReference)
  else
    !this.opLadderTmplReferenceLadder.select('RTEXT', !currentTmplReference)
  endif

endmethod
-- End of method

