------------------------------------------------------------------------
--
-- Method:      modifyWWayRouting
--
-- Description: Invoke EDG pick
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyWWayRouting()

  !polylineUI                 = object POLYLINEUI()
  !polylineUI.acceptCallback  = '!!aslMain.modifyWWayRoutingAccept(!this.mePolyLines)'
  !polylineUI.acceptDText     = 'Accept walkway'
  !polylineUI.create          = false
  !polylineUI.discardCallback = '!!aslMain.modifyWWayRoutingDiscard()'
  !polylineUI.discardDText    = 'Discard walkway'
  !polylineUI.formTitle       = 'Walkway'
  !polylineUI.polyline        = !this.meWWayEngine.getRouting()
  !polylineUI.twoDFlag        = false
  !polylineUI.load()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyWWayRoutingAccept
--
-- Description: return from polyline form by press of ACCEPT
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       polyLines
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyWWayRoutingAccept(!polyLines is ARRAY)

  -- shows the current form
  !this.show()

  -- change the frames to the handrail frame
  !this.frameChange(!this.frMainWorkWWay)

  -- remove aid lines
  !!aslCentralData.clearVolFeedback()

  -- set the profile as shape
  !this.meWWayEngine.setRouting(!polyLines[1])

  -- create the walkway
  !this.meWWayEngine.updateDB()

  -- updates the aid dimension elements
  !this.showDimFeedbackWWay(object GADGET(), '')

  -- update the gadgets
  !this.updateFrameWWay()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyWWayRoutingDiscard
--
-- Description: return from polyline form by press of DISCARD
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyWWayRoutingDiscard()

  -- shows the current form
  !this.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyWWayTmplReference
--
-- Description: modify template reference
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyWWayTmplReference()

  -- selects the templates
  !wWayTmplReference   = !this.opWWayTmplReferenceWWay.selection().dbRef()
  !handRaTmplReference = !this.opHandRaTmplReferenceWWay.selection().dbRef()
  !this.meWWayEngine.setTmplReferences(!wWayTmplReference, !handRaTmplReference)

  -- combines general and fabricator standard
  !this.meWWayEngine.mergeCriteria()

  !this.updateLimitsWWay()

  -- standard modify method
  !this.modifyWWay(object GADGET(), 'SELECT')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newAccessHandRa
--
-- Description: implements new gate point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newAccessHandRa()

  -- defines packet
  !packet                     = object EDGPACKET()
  !packet.pickPacket.prompt   = 'Identify position of walkway access'

  -- defines first pick
  !packet.pickPacket.picks[1] = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('')

  -- define actions on first pick
  !packet.action              = '!!aslMain.newAccessHandRaReturn(!this.return[1])'

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newAccessHandRaReturn
--
-- Description: return of implements new gate point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA
--                           edg pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newAccessHandRaReturn(!positionData is EDGPOSITIONDATA)

  !this.meHandRaEngine.addGate(!positionData.position)
  !this.updateFrameHandRa()

  -- create the handrail
  !this.meHandRaEngine.updateDB()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newAccessPltFrm
--
-- Description: implements new access point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newAccessPltFrm()

  -- defines packet
  !packet                     = object EDGPACKET()
  !packet.pickPacket.prompt   = 'Identify position of platform access'

  -- defines first pick
  !packet.pickPacket.picks[1] = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('')

  -- define actions on first pick
  !packet.action              = '!!aslMain.newAccessPltFrmReturn(!this.return[1])'

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newAccessPltFrmReturn
--
-- Description: return of implements new access point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA
--                           edg pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newAccessPltFrmReturn(!positionData is EDGPOSITIONDATA)

  !this.mePltFrmEngine.addGate(!positionData.position)
  !this.updateFramePltFrm()
  !this.lkAidAccessPltFrm.active = true

  -- create the platform
  !this.mePltFrmEngine.updateDB()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newAccessStrSet
--
-- Description: implements new access point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newAccessStrSet()

  !gate        = object GATE(!this.meStrSetEngine.getLWP(), N, S)
  !gate.height = 0
  !this.meStrSetEngine.addGate(!gate)

  -- evaluate the stair set
  !this.evaluateStrSet()

  -- create the stair flight
  !this.meStrSetEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- select the first one, so that it can be picked immediately
  !array[1] = 1
  !this.neAccessStrSet.setSelectedRowTags(!array)

  !this.lkDeleteAccessStrSet.active = true
  !this.lkPickAccessStrSet.active   = true

  -- update the stair flight frame
  !this.updateFrameStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newAccessStrTwr
--
-- Description: implements new access point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newAccessStrTwr()

  !position              = !this.meStrTwrEngine.strTwrData.position.offset(!this.meStrTwrEngine.strTwrData.orientation.yDir().orthogonal(u), !this.meStrTwrEngine.strTwrData.xLength / 2)
  !entryDirection        = !this.meStrTwrEngine.strTwrData.orientation.yDir().orthogonal(U).opposite()
  !exitDirection         = !entryDirection.opposite()
  !gate                  = object GATE(!position, !entryDirection, !exitDirection)
  !this.meStrTwrEngine.addGate(!gate)

  -- draw the tower
  !this.evaluateStrTwrPreview()

  -- select the new one, so that it can be picked immediately
  -- find the index of the current gate
  !array[1] = !this.meStrTwrEngine.getGates().findFirst(!gate)
  !this.neAccessStrTwr.setSelectedRowTags(!array)

  !this.lkDeleteAccessStrTwr.active = true
  !this.lkPickAccessStrTwr.active   = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newAccessWWay
--
-- Description: implements new access point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newAccessWWay()

  -- defines packet
  !packet                     = object EDGPACKET()
  !packet.pickPacket.prompt   = 'Identify position of walkway access'

  -- defines first pick
  !packet.pickPacket.picks[1] = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('')

  -- define actions on first pick
  !packet.action              = '!!aslMain.newAccessWWayReturn(!this.return[1])'

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newAccessWWayReturn
--
-- Description: return of implements new access point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA
--                           edg pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newAccessWWayReturn(!positionData is EDGPOSITIONDATA)

  !this.meWWayEngine.addGate(!positionData.position)
  !this.updateFrameWWay()
  !this.lkAidAccessWWay.active = true

    -- create the walkway
    !this.meWWayEngine.updateDB()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newAccessLadder
--
-- Description: implements new Access point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newAccessLadder()

  !sideExit                  = object ASLLADDEREXITDATA()
  !this.meLadderEngine.addSideExit(!sideExit)

  -- create the ladder
  !this.meLadderEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- check if an error occurred
  if ( !this.meLadderEngine.getError() ) then
    !!alert.error(!!error.text)
    !this.meLadderEngine.resetError()
    return
  endif

  !this.updateAccessLadder()

  -- select the first one, so that it can be picked immediately
  !array[1] = 1
  !this.neAccessLadder.setSelectedRowTags(!array)

  !this.lkDeleteAccessLadder.active = true
  !this.lkPickAccessLadder.active   = true
  !this.lkAidAccessLadder.active    = true

endmethod
-- End of method

