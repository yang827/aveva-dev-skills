------------------------------------------------------------------------
--
-- Method:      deriveDirectionOptionsLadder
--
-- Description: Derive options from pick data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deriveDirectionOptionsLadder()

  -- evaluates the direction options
  !lPosData           = !this.meLadderEngine.getLPosData()
  !uPosData           = !this.meLadderEngine.getUPosData()
  !directionOptions   = !!aslGetDirectionOptions(!lPosData, !uPosData, 'Standard installation Ladder')
--  !directionOptions = !this.meLadderEngine.getDirectionOptions()
  !directionLabels  = !directionOptions.first()
  !directionPixmaps = !directionOptions.last()

  -- fills the gadgets
  do !i index !directionLabels
    !this.attribute('TODIROPTIONLADDER' & !i).addPixmap(!directionPixmaps[!i])
    !this.attribute('TODIROPTIONLADDER' & !i).visible = true
    !this.attribute('TODIROPTIONLADDER' & !i).val     = false
    !this.attribute('LKDIROPTIONLADDER' & !i).tag     = !directionLabels[!i]
  enddo

  do !i from (!directionLabels.size() + 1) to 7
    !this.attribute('TODIROPTIONLADDER' & !i).visible = false
    !this.attribute('TODIROPTIONLADDER' & !i).val     = false
    !this.attribute('LKDIROPTIONLADDER' & !i).tag     = ''
  enddo

  -- switch on the first button if nothing has been selected yet
  !directionOption = !this.meLadderEngine.getDirectionOption()
  !i               = !directionLabels.findFirst(!directionOption)
  if ( !directionOption.unset() or $
       !i.unset() ) then
    !this.toDirOptionLadder1.val                  = true
    !this.meLadderEngine.setDirectionOption(!directionLabels.first())
  else
    !this.attribute('TODIROPTIONLADDER' & !i).val = true
    !this.meLadderEngine.setDirectionOption(!directionOption)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deriveDirectionOptionsStrSet
--
-- Description: Derive options from pick data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deriveDirectionOptionsStrSet()

  -- evaluates the direction options
  !lPosData           = !this.meStrSetEngine.getLPosData()
  !uPosData           = !this.meStrSetEngine.getUPosData()
  !installationOption = !this.meStrSetEngine.getInstallationOption()
  !directionOptions   = !!aslGetDirectionOptions(!lPosData, !uPosData, !installationOption)
--  !directionOptions = !this.meStrSetEngine.getDirectionOptions()
  !directionLabels  = !directionOptions.first()
  !directionPixmaps = !directionOptions.last()

  -- fills the gadgets
  do !i index !directionLabels
    !this.attribute('TODIROPTIONSTRSET' & !i).addPixmap(!directionPixmaps[!i])
    !this.attribute('TODIROPTIONSTRSET' & !i).visible = true
    !this.attribute('TODIROPTIONSTRSET' & !i).val     = false
    !this.attribute('LKDIROPTIONSTRSET' & !i).tag     = !directionLabels[!i]
  enddo

  do !i from (!directionLabels.size() + 1) to 5
    !this.attribute('TODIROPTIONSTRSET' & !i).visible = false
    !this.attribute('TODIROPTIONSTRSET' & !i).val     = false
    !this.attribute('LKDIROPTIONSTRSET' & !i).tag     = ''
  enddo

  -- switch on the first button if nothing has been selected yet
  !directionOption = !this.meStrSetEngine.getDirectionOption()
  !i               = !directionLabels.findFirst(!directionOption)
  if ( !directionOption.unset() or $
       !i.unset() ) then
    !this.toDirOptionStrSet1.val                  = true
    !this.meStrSetEngine.setDirectionOption(!directionLabels.first())
  else
    !this.attribute('TODIROPTIONSTRSET' & !i).val = true
--    !this.meStrSetEngine.setDirectionOption(!directionOption)
  endif

endmethod
