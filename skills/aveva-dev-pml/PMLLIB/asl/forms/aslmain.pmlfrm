    --  button    .lkAidAccessStrTwr      linklabel at    ymax - .2 'Display'            callback '!this.showDimFeedbackStrTwr('     width 25
    --exit

    para   .paEvaluateStrTwr             at xmin.paCreate pixmap                                                                  width 16 height 16
    button .lkEvaluateStrTwr   linklabel at xmin.lkCreateStrTwr ymin 'Generate Stair Tower'    callback '!this.evaluateStrTwr()'          width 30
    para   .paBackToMainStrTwr           at xmin.paCreate pixmap                                                                  width 16 height 16
    button .lkBackToMainStrTwr linklabel at xmin.lkCreateStrTwr ymin 'Return to Main'        callback '!this.frameChange(!this.frMain)' width 30
  exit

  ------------------------------------------------------------------------------------------------------------------------------------------------------
  -- ladder
  ------------------------------------------------------------------------------------------------------------------------------------------------------
  frame .frMainWorkLadder panel at xmin.frMain ymin.frMain anchor T+L+R

    path down

    -- general attributes
    ---------------------------------------------------------------------------
    para  .paGeneralLadder        at xmin form              ymax  text 'General attributes'
    line  .lnGeneralLadder        at xmin                   ymax-.2 anchor T+L+R HORIZ width 36
    text   .txHeightLadder        at x3                          'Height:'        callback '!this.modifyLadder('          anchor L+T+R tagwidth 14   width 10           is REAL format !!distanceFmt
    option .opHeightLadder        at xmin.txHeightLadder    ymin 'Height:'        callback '!this.modifyLadder('          anchor L+T+R tagwidth 14   width  8
    button .toAidHeightLadder    toggle pixmap  at x31                    ymin                  callback '!this.showDimFeedbackLadder(' anchor T+R   width 16 height 16
    text   .txWidthLadder         at xmin.txHeightLadder         'Width:'         callback '!this.modifyLadder('          anchor L+T+R tagwidth 14   width 10           is REAL format !!distanceFmt
    option .opWidthLadder         at xmin.txWidthLadder     ymin 'Width:'         callback '!this.modifyLadder('          anchor L+T+R tagwidth 14   width  8
    button .toAidWidthLadder     toggle pixmap  at xmin.toAidHeightLadder ymin                  callback '!this.showDimFeedbackLadder(' anchor T+R   width 16 height 16
    option .opTopAccessTypeLadder at xmin.txWidthLadder          'Top Exit Type:' callback '!this.modifyLadder('          anchor L+T+R tagwidth 14   width  8

    -- tasks
    ---------------------------------------------------------------------------
    para   .paTaskLadder                 at xmin form           ymax+.5 text 'Tasks'
    line   .lnTaskLadder                 at                     ymax-.2                                                                       anchor T+L+R HORIZ width 36
    button .lkreEvaluateLadder linklabel at xmin.txHeightLadder ymax    'Re-Evaluate ladder'              callback '!this.reEvaluateLadder()'                    width 30
    button .lkPickLadder       linklabel at                     ymax-.2 'Repick top and bottom of ladder' callback '!this.pickLadder()'                          width 30
    button .lkPickLadderBottom linklabel at                     ymax-.2 'Repick bottom of ladder'         callback '!this.singlePickLadder('                     width 30
    button .lkPickLadderTop    linklabel at                     ymax-.2 'Repick top of ladder'            callback '!this.singlePickLadder('                     width 30

    -- detail attributes
    ---------------------------------------------------------------------------
    frame .frDetailAttributesLadder  FoldUp  'Detailed attributes' at xmin form                                                            anchor T+L+R               width 36
      text   .txPitchLadder           'Pitch:'                     at xmin.txHeightLadder         callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width 10           is REAL format !!angleFmt
      option .opPitchLadder           'Pitch:'                     at xmin.txPitchLadder     ymin callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width  8
      button .toAidPitchLadder                                    toggle pixmap  at xmin.toAidHeightLadder ymin callback '!this.showDimFeedbackLadder('  anchor T+R   width 16 height 16
      text   .txRiseLadder            'Rise:'                      at xmin.txHeightLadder         callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width 10           is REAL format !!distanceFmt
      option .opRiseLadder            'Rise:'                      at xmin.txHeightLadder    ymin callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width  8
      button .toAidRiseLadder                                     toggle pixmap  at xmin.toAidHeightLadder ymin callback '!this.showDimFeedbackLadder('  anchor T+R   width 16 height 16
      text   .txLRiseLadder           'Distance to first rung:'    at xmin.txHeightLadder         callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width 10           is REAL format !!distanceFmt
      button .toAidLRiseLadder                                    toggle pixmap  at xmin.toAidHeightLadder ymin callback '!this.showDimFeedbackLadder('  anchor T+R   width 16 height 16
      text   .txExtensionLadder       'Extension above ladder:'    at xmin.txHeightLadder         callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width 10           is REAL format !!distanceFmt
      button .toAidExtensionLadder                                toggle pixmap  at xmin.toAidHeightLadder ymin callback '!this.showDimFeedbackLadder('  anchor T+R   width 16 height 16
      text   .txRungsLadder           'Rungs:'                     at xmin.txHeightLadder                                                  anchor T+L+R tagwidth 17   width 10           is REAL format !!distanceFmt
      text   .txheadroomLadder        'headroom:'                  at xmin.txHeightLadder         callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width 10           is REAL format !!distanceFmt
      button .toAidheadroomLadder                                 toggle pixmap  at xmin.toAidHeightLadder ymin callback '!this.showDimFeedbackLadder('  anchor T+R   width 16 height 16
      text   .txFootroomLadder        'Clearance to obstruction:'  at xmin.txHeightLadder         callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width 10           is REAL format !!distanceFmt
      button .toAidFootroomLadder                                 toggle pixmap  at xmin.toAidHeightLadder ymin callback '!this.showDimFeedbackLadder('  anchor T+R   width 16 height 16
      text   .txCageOffsetLadder      'Cage offset:'               at xmin.txHeightLadder         callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width 10           is REAL format !!distanceFmt
      button .toAidCageOffsetLadder                               toggle pixmap  at xmin.toAidHeightLadder ymin callback '!this.showDimFeedbackLadder('  anchor T+R   width 16 height 16
      text   .txCageSizeLadder        'Cage size:'                 at xmin.txHeightLadder         callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width 10           is REAL format !!distanceFmt
      button .toAidCageSizeLadder                                 toggle pixmap  at xmin.toAidHeightLadder ymin callback '!this.showDimFeedbackLadder('  anchor T+R   width 16 height 16
      text   .txStringerDistLadder    'Stringer distance:'         at xmin.txHeightLadder         callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width 10           is REAL format !!distanceFmt
      button .toAidStringerDistLadder                             toggle pixmap  at xmin.toAidHeightLadder ymin callback '!this.showDimFeedbackLadder('  anchor T+R   width 16 height 16
      text   .txStringerThnLadder     'Stringer thickness:'        at xmin.txHeightLadder         callback '!this.modifyLadder('           anchor T+L+R tagwidth 17   width 10           is REAL format !!distanceFmt
      button .toAidStringerThnLadder                              toggle pixmap  at xmin.toAidHeightLadder ymin callback '!this.showDimFeedbackLadder('  anchor T+R   width 16 height 16
