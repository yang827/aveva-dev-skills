------------------------------------------------------------------------
--
-- Method:      updateOpeningsPltFrm
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateOpeningsPltFrm()

  using namespace  'Aveva.Pdms.Presentation'

  !posFmt     = !!distanceFmt
  !posFmt.dp  = 0

  --set the headings of the access-list
  !heading[1] = 'No'
  !heading[2] = 'Handrail'

  !title      = 'Openings'

  !openingsHandRaStatus = !this.mePltFrmEngine.getOpeningsHandRaStatus()
  !columns              = object ARRAY()
  do !i index !openingsHandRaStatus
    !columns[!i] = object ARRAY()
    !columns[!i].append(!i.string())
    if ( !openingsHandRaStatus[!i] ) then
      !columns[!i].append('On')
    else
      !columns[!i].append('Off')
    endif
  enddo

  !netDataSource = object NETDATASOURCE(!title, !heading, !columns)
  !this.neOpeningsPltFrm.bindToDataSource(!netDataSource)

  !this.lkDeleteOpeningsPltFrm.active = false
  !this.lkMergeOpeningsPltFrm.active  = false
  !this.lkModifyOpeningsPltFrm.active = false

  -- the following syntaxes must be carried out after the list has been filled!
  ---------------------------------------------------------------------------
  -- handrail status on/off
  !this.neOpeningsPltFrm.assignValueListToColumn('Handrail', 2)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateOptimumGadgetStrSet
--
-- Description: Derive optima from pick data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateOptimumGadgetStrSet(!segmentIdx is REAL)

  -- number of segments
  !numberOfSegments = !this.meStrSetEngine.getNumberOfSegments()

  -- evaluates the optima option
  !optima = !this.meStrSetEngine.getOptima(!segmentIdx)
  !angles = !optima.first()
  !treads = !optima.last()

  -- generates the lines
  !dText = object ARRAY()
  !rText = object ARRAY()
  do !i index !angles
    !dText[!i] = !treads[!i] & ' treads (Angle ' & !angles[!i] & ')'
    !rText[!i] = !treads[!i] & ';' & !angles[!i]
  enddo

  -- fills the gadget
  if ( !this.opOptimumStrSet.dText.neq(!dText) or $
       !this.opOptimumStrSet.rText.neq(!rText) ) then
    !this.opOptimumStrSet.dText = !dText
    !this.opOptimumStrSet.rText = !rText
  endif

  -- reduces the size of the expressions
  !optimumAngle = !this.meStrSetEngine.getOptimumPitch(!segmentIdx)

  -- evaluates the difference of all optima angles form the optimum angle
  !difference   = object ARRAY()
  do !i index !angles
    !difference[!i] = ABS(!angles[!i] - !optimumAngle)
  enddo

  -- pre-select the angle nearest to the optimum angle
  if ( !difference.empty().not() and $
       !this.rtExplicitStrSet.val ) then
    !this.opOptimumStrSet.val = !difference.sortedIndices().first()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateRailSpacingHandRa
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateRailSpacingHandRa()

  using namespace  'Aveva.Pdms.Presentation'

  --set the headings of the access-list
  !title       = 'Rail spacing'
  !heading[1]  = 'No'
  !heading[2]  = 'Spacing'

  !railSpacing = !this.meHandRaEngine.getRailSpacing()

  !rows        = object ARRAY()
  do !i from 1 to 8
    !rows[!i]  = object ARRAY()
    !rows[!i].append(!i.string())
    if ( defined(!railSpacing[!i]) ) then
      !rows[!i].append(!railSpacing[!i].string())
    else
      !rows[!i].append('0')
    endif
  enddo

  !netDataSource = object NETDATASOURCE(!title, !heading, !rows)
  !this.neRailSpacingHandRa.bindToDataSource(!netDataSource)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      validationTextGadgets
--
-- Description: Validating the text gadgets.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET     Text Gadget to be validated
--    2    R     CRITERION  Validating Criteria for getting limits
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .validationTextGadgets(!gadget is GADGET,!validationCriteria is CRITERION)

  if(!gadget.val.lt(0))then
    !!alert.error('$!gadget.tag cannot accept a Negative value. Enter a positive value.')
    !!alert.message('Resetting $!gadget.tag Value back to optimum value ($!validationCriteria.optimum)')
    !gadget.val = !validationCriteria.optimum
    return
  elseif(!gadget.val.eq(0)) then
    !!alert.error('$!gadget.tag cannot accept a Zero value. Enter a positive value.')
    !!alert.message('Resetting $!gadget.tag Value back to optimum value ($!validationCriteria.optimum)')
    !gadget.val = !validationCriteria.optimum
    return
  endif

  if(!validationCriteria.setstatemax.set() and  !validationCriteria.setstatemin.set())then
    if ( !validationCriteria.setstatemax and !validationCriteria.setstatemin ) then
      if(!gadget.val.lt(!validationCriteria.min) or !gadget.val.gt(!validationCriteria.max))then
        !!alert.error('$!gadget.tag Value should lie in between min: $!validationCriteria.min and max: $!validationCriteria.max')
        !!alert.message('Resetting $!gadget.tag Value back to optimum value ($!validationCriteria.optimum)')
        !gadget.val = !validationCriteria.optimum
        return
      endif
    elseif ( !validationCriteria.setstatemax and !validationCriteria.setstatemin.not() ) then
      if(!gadget.val.gt(!validationCriteria.max))then
        !!alert.error('$!gadget.tag Value should not be greater than max: $!validationCriteria.max')
        !!alert.message('Resetting $!gadget.tag Value back to optimum value ($!validationCriteria.optimum)')
        !gadget.val = !validationCriteria.optimum
        return
      endif
    elseif ( !validationCriteria.setstatemax.not() and !validationCriteria.setstatemin ) then
      if(!gadget.val.lt(!validationCriteria.min))then
        !!alert.error('$!gadget.tag Value should not be lesser than min: $!validationCriteria.min')
        !!alert.message('Resetting $!gadget.tag Value back to optimum value ($!validationCriteria.optimum)')
        !gadget.val = !validationCriteria.optimum
        return
      endif
    endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set the origin.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET     Text Gadget to be set as origin
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setWrt(!gadget is GADGET,!action is STRING)

  if(!gadget.val.trim().upcase() eq 'CE')then
    !gadget.val = !!ce.name
    !dbRef  = !!ce
  else
    !dbRef  = !gadget.val.dbRef()
    handle ANY
      if(!gadget.val.subString(1,1).neq('/'))then
        !wrtElement = '/' & !gadget.val
        !dbRef      = !wrtElement.dbRef()
        handle ANY
          !!alert.error('This element does not exist.')
          return
        endhandle
      endif
    endhandle
  endif

  if(!gadget eq !this.txPosOriginLadder)then
    !newPosition = !this.ladder.pos.wrt(!this.txPosOriginLadder.val.dbRef())
    !this.ladderPosControl.xyz(!newPosition.east,!newPosition.north,!newPosition.up)
    --!this.modifyLadder(!gadget,!action)
  endif

  if(!gadget eq !this.txLPosOriginStrSet)then
    !newPosition = !this.strSetLpos.wrt(!this.txLPosOriginStrSet.val.dbRef())
    !this.strSetLPosControl.xyz(!newPosition.east,!newPosition.north,!newPosition.up)
    --!this.modifyStrSet(!gadget,!action)
  endif


  if(!gadget eq !this.txUPosOriginStrSet)then
    !newPosition = !this.strSetUpos.wrt(!this.txUPosOriginStrSet.val.dbRef())
    !this.strSetUPosControl.xyz(!newPosition.east,!newPosition.north,!newPosition.up)
    --!this.modifyStrSet(!gadget,!action)
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      updateLadderPositionGadgets
--
-- Description: update the values in ladder position gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateLadderPositionGadgets()

  --  !this.opLadderControlPoint.active = !ladderData.lPickType.eq(!ladderData.uPickType)
  !currPositionOption             = !this.meLadderEngine.getPositionOption()

  if ( !currPositionOption.matchwild('*lower*') ) then
    !controlPos        = !this.meLadderEngine.getLWP().wrt(world)
  else
    !controlPos        = !this.meLadderEngine.getUWP().wrt(world)
  endif

 !this.ladderPosControl.xyz(!controlPos.east,!controlPos.north,!controlPos.up)

endmethod
------------------------------------------------------------------------
-- Method:           updateCoordinateSystem
--
  -- Description: update the position and direction gadgets to display current coordinate system
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .updateCoordinateSystem()

  --Load ship grid data
  !grid                       = object SHIPGRID()
  !gridDefined                = !grid.position.set()
  -- Only populate the grid data if a ship reference grid is available
   if(!gridDefined) then
      !this.strTwrPosControl.gridFormat()
      !this.strSetLPosControl.gridFormat()
      !this.strSetUPosControl.gridFormat()
      !this.ladderPosControl.gridFormat()
   else
     var !coordinate coordinate
       if(!coordinate.eq('ENU'))then
         !this.strTwrPosControl.enuFormat()
         !this.strSetLPosControl.enuFormat()
         !this.strSetUPosControl.enuFormat()
         !this.ladderPosControl.enuFormat()
       else
         !this.strTwrPosControl.xyzFormat()
         !this.strSetLPosControl.xyzFormat()
         !this.strSetUPosControl.xyzFormat()
         !this.ladderPosControl.xyzFormat()
       endif
   endif
endmethod
------------------------------------------------------------------------
--
-- Method:      clearIncompleteStrTwr
--
-- Description: Clears incomplete stair tower
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearIncompleteStrTwr()

    -- Delete the stair tower element if creation is aborted and returned to main
    !stairTowerReference  = !this.meStrTwrEngine.strTwrData.refe
    if(!stairTowerReference.set() and !stairTowerReference.members.unset()) then
      !!ce  = !stairTowerReference
      !this.deleteStrTwr()
    endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      edgPickEscape
--
-- Description: Clears the planes created for EDGPick in stair tower
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .edgClearPlane()

  do !i index !this.planeNumber
    !!aidNumbers.remove(!this.planeNumber[!i])
  enddo
endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      ceValidCheck
--
-- Description: Valid Check for the Current Element, Referring to stair tower
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ceValidCheck()

  --Collects the Stair Tower Reference

    -- Check if the Current Element Type is Stair Tower
    if(!!ce.type.eq('STRTWR')) then
  	  return
  	else
  	  -- Navigate to the Stair Tower
  	  $!this.meStrTwrEngine.strTwrData.refe
    endif
endmethod
-- End of method definition
