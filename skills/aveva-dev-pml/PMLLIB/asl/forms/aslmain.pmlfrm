------------------------------------------------------------------------
--
-- Method:      deleteAccessHandRa
--
-- Description: deletes a gate
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deleteAccessHandRa()

  if ( !!alert.confirm('Do you really want to delete the selected gate?').neq('YES') ) then
    return
  endif

  -- loop through the selected rows and delete the respective gate
  !indices = ARRAY()
  do !row value !this.neAccessHandRa.getSelectedRows()
    !indices.append(!row[1].real())
  enddo
  !this.meHandRaEngine.remGates(!indices)

  !this.updateFrameHandRa()

  -- create the handrail
  !this.meHandRaEngine.updateDB()

endmethod
-- End of method

