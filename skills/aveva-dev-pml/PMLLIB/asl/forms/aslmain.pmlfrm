------------------------------------------------------------------------
--
-- Method:      modifyAccessStrSet
--
-- Description: callback when changing the grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       not idea
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyAccessStrSet(!array is ARRAY)

  -- means it is OK to change the value
  !array[1] = TRUE

  -- evaluates the access point positions projected onto the stair flight plane
  !this.evaluateAccessPointPositionsStrSet()

  -- evaluate the stair set
  !this.evaluateStrSet()

  -- create the stair flight
  !this.meStrSetEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- update the stair flight frame
  !this.updateFrameStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyAccessStrTwr
--
-- Description: callback when changing the grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       not idea
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyAccessStrTwr(!array is ARRAY)

  -- means it is OK to change the value
  !array[1] = TRUE
  !gates = !this.meStrTwrEngine.getGates()
  !rows  = !this.neAccessStrTwr.getRows()
  do !i index !rows
    !position               = object POSITION(!rows[!i][2])
    !position.origin        = world
    !gates[!i].position     = !position
    !gates[!i].arriveOffset = !rows[!i][3].real()
    !gates[!i].leaveOffset  = !rows[!i][4].real()
  enddo

  !this.meStrTwrEngine.setGates(!gates)

  -- draw the tower
  !this.evaluateStrTwrPreview()

endmethod
-- End of method

