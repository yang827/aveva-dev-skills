------------------------------------------------------------------------
--
-- Method:      reEvaluateStrTwr
--
-- Description: evaluates the stair tower with the new settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .reEvaluateStrTwr()

  -- sets the criteria
  !this.meStrTwrEngine.setCriteria()

  -- sets the reference to the central template
  !this.meStrTwrEngine.setSettingReference()

  -- update the catalogue options for the new selection
  !this.updateCataOptionsStrTwr()

  -- set the currently selected template references
  !strFltTmplReference = !this.opStrFltTmplReferenceStrTwr.selection().dbRef()
  !strLngTmplReference = !this.opStrLngTmplReferenceStrTwr.selection().dbRef()
  !handRaTmplReference = !this.opHandRaTmplReferenceStrTwr.selection().dbRef()
  !this.meStrTwrEngine.setTmplReferences(!strFltTmplReference, !strLngTmplReference, !handRaTmplReference)

  -- take the fabricator standard into account
  !this.meStrTwrEngine.mergeCriteria()

  -- update the limits of the gadgets
  !this.updateLimitsStrTwr()

  -- create the preview
  !this.evaluateStrTwrPreview()

  -- create the real stair tower
--  !this.evaluateStrTwr()

endmethod

