------------------------------------------------------------------------
--
-- Method:      modifyPltFrm
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyPltFrm(!gadget is GADGET, !action is STRING)

 !undo = object UNDOABLE()
 !undo.description('Modify Platform')
 !undo.undoAction('!!aslMain.cePltFrm()')
 !undo.add()

  -- open callback calls method twice
  if ( !gadget.type().eq('LIST') and $
       !action.eq('UNSELECT') ) then
    return
  endif

  -- thickness
  if ( !gadget.eq(!this.opThicknessPltFrm) ) then
    !this.mePltFrmEngine.setHeight(!this.opThicknessPltFrm.selection().real())
  elseif ( !gadget.eq(!this.txThicknessPltFrm) ) then
    !this.mePltFrmEngine.setHeight(!this.txThicknessPltFrm.val)
  endif

  -- justification
  !this.mePltFrmEngine.setJustification('BOTT')

  -- evaluate the handrails
  !this.mePltFrmEngine.evaluateHandRa()

  -- create the platform
  !this.mePltFrmEngine.updateDB()

  -- updates the aid dimension elements
  !this.showDimFeedbackPltFrm(object GADGET(), '')

  -- update the form with the current values
  !this.updateFramePltFrm()
  !this.lkreEvaluatePltFrm.active = true
  !undo.endundoable()

endmethod
-- End of method

