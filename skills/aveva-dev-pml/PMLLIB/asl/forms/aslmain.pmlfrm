--
-- Method:      newStrSet
--
-- Description: Invoke EDG pick
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newStrSet()
 !this.updateCoordinateSystem()
  -- check if there is a current setting, otherwise it does not make sense to create a stairFlight
  if ( !!aslCentralData.currSetting.unset() ) then
    !!alert.warning('There is no ASL selection. Ask your ASL administrator.')
    return
  endif
  if ( !!aslCentralData.currSetting.collectAll('STRFLT').empty() ) then
    !!alert.warning('There are no stair flights in the current ASL selection. Ask your ASL administrator.')
    return
  endif
  if ( !!aslCentralData.currSetting.collectAll('STRLNG').empty() ) then
    !!alert.warning('There are no stair landings in the current ASL selection. Ask your ASL administrator.')
    return
  endif

  -- initialise the data objects
  !this.meStrSetEngine = object ASLSTRSETENGINE()
  !strFltTmplReference = !this.opStrFltTmplReferenceStrSet.selection().dbRef()
  !strLngTmplReference = !this.opStrLngTmplReferenceStrSet.selection().dbRef()
  !handRaTmplReference = !this.opHandRaTmplReferenceStrSet.selection().dbRef()

  !this.meStrSetEngine.newDefaults(!strFltTmplReference, !strLngTmplReference, !handRaTmplReference)

  -- defines packet
  !packet                            = object EDGPACKET()
  !packet.pickPacket.prompt          = 'Stair Flight - '

  -- defines first pick
  !packet.pickPacket.picks[1]        = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdGraphics('Start')

  -- defines second pick and defines prompt
  !packet.pickPacket.picks[2]        = !packet.pickPacket.picks[1]
  !packet.pickPacket.picks[2].prompt = ('End')

  -- define actions on first pick
  !packet.pickPacket.picks[1].action = '!!aslMain.firstPickStrSet(!this.return[1])'

  -- defines action on pick completion
  !packet.action                     = '!!aslMain.createStrSet(!this.return[1][2])'

  --set the description
  !packet.description                = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

  -- remove aid lines
  !!aslCentralData.clearVolFeedback()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newStrTwr
--
-- Description: Invoke EDG pick
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newStrTwr()
 -- Updating the current Coordinate System
 !this.updateCoordinateSystem()

  -- check if there is a setting, otherwise it does not make sense to create a stairTower
  if ( !!aslCentralData.currSetting.unset() ) then
    !!alert.warning('There is no ASL selection. Ask your ASL administrator.')
    return
  endif
  if ( !!aslCentralData.currSetting.collectAll('STRFLT').empty() ) then
    !!alert.warning('There are no stair flights in the ASL selection. Ask your ASL administrator.')
    return
  endif
  if ( !!aslCentralData.currSetting.collectAll('STRLNG').empty() ) then
    !!alert.warning('There are no stair landings in the ASL selection. Ask your ASL administrator.')
    return
  endif

  -- initialise the data object
  !this.meStrTwrEngine = object ASLSTRTWRENGINE()
  !strFltTmplReference = !this.opStrFltTmplReferenceStrTwr.selection().dbRef()
  !strLngTmplReference = !this.opStrLngTmplReferenceStrTwr.selection().dbRef()
  !handRaTmplReference = !this.opHandRaTmplReferenceStrTwr.selection().dbRef()

  !this.meStrTwrEngine.newDefaults(!strFltTmplReference, !strLngTmplReference, !handRaTmplReference)

  -- fill the standards and templates option gadgets
  !this.updateCataOptionsStrTwr()

  -- fill the gadgets with min, max criteria
  !this.updateLimitsStrTwr()

  -- create the stair tower
  !this.meStrTwrEngine.updateDB()

  -- draw the tower
  !this.showVolFeedBackStrTwr()

  -- derive the options depended on the geometry
  !this.deriveInstallationOptionsStrTwr()

  -- quick evaluation for the preview
  !this.evaluateStrTwrPreview()

endmethod
-- End of method

