------------------------------------------------------------------------
--
-- Method:      updateCataOptionsStrSet
--
-- Description: updates the catalogue options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateCataOptionsStrSet()

  -- standard ('BS Private')
  !this.paStandardStrSet.val = !this.meStrSetEngine.getSettingReference()

  -- defines all element types
  !elementTypesString = 'STRFLT STRLNG HANDRA'
  !elementTypes       = !elementTypesString.split()

  -- handles option gadgets for all previously defined element types
  do !elementType value !elementTypes
    !dText           = object ARRAY()
    !rText           = object ARRAY()
    !allCataElements = !!aslCentralData.currSetting.collectAll(!elementType)
    do !cataElement value !allCataElements
      !dText.append(!cataElement.description)
      !rText.append(!cataElement.string())
    enddo
    !gadgetName = 'OP' & !elementType & 'TMPLREFERENCESTRSET'
    !this.attribute(!gadgetName).dText = !dText
    !this.attribute(!gadgetName).rText = !rText
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateCataOptionsStrTwr
--
-- Description: updates the catalogue options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateCataOptionsStrTwr()

  -- standard ('BS Private')
--  !this.paStandardStrTwr.val = !this.meStrTwrEngine.getSettingReference()

  -- defines all element types
  !elementTypesString = 'STRFLT STRLNG HANDRA'
  !elementTypes       = !elementTypesString.split()

  -- handles option gadgets for all previously defined element types
  do !elementType value !elementTypes
    -- collect all stairs from the options
    !dText           = object ARRAY()
    !rText           = object ARRAY()
    !allCataElements = !!aslCentralData.currSetting.collectAll(!elementType)
      do !cataElement value !allCataElements
        !dText.append(!cataElement.description)
        !rText.append(!cataElement.string())
      enddo
    !gadgetName = 'OP' & !elementType & 'TMPLREFERENCESTRTWR'
    !this.attribute(!gadgetName).dText = !dText
    !this.attribute(!gadgetName).rText = !rText

    -- try to reselect the reference
    !command  = '!tmplReference = !this.meStrTwrEngine.get' & !elementType & 'TmplReference()'
    $!command
    if ( !this.attribute(!gadgetName).rText.findFirst(!tmplReference.string()).set() ) then
      !this.attribute(!gadgetName).select('RTEXT', !tmplReference.string())
    endif
  enddo

endmethod
-- End of method

