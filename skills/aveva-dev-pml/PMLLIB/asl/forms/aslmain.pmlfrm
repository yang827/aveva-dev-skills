  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickAccessStrSetReturn
--
-- Description: repositions gate
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA
--                           edg pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pickAccessStrSetReturn(!positionData is EDGPOSITIONDATA)

  !rows = !this.neAccessStrSet.getSelectedRows()
  if ( !rows.size().neq(1) ) then
    !!alert.warning('Only possible when one row is selected')
    return
  endif

  -- derive the stair plane
  !strSetDir     = !this.meStrSetEngine.getDirection()
  !orthogonalDir = !strSetDir.orthogonal(U)
  !planeOri   = object ORIENTATION('Z IS ' & !orthogonalDir.string())
  !plane      = object PLANE(!this.meStrSetEngine.getLWP(), !planeOri)

  -- find out which gate is to be positioned
  !index        = !rows[1][1].real()
  !arriveOffset = !rows[1][4].real()
  !leaveOffset  = !rows[1][5].real()

  -- get the gate data
  !position              = !positionData.position
  !position              = !plane.near(!position)
  !entryDirection        = !this.meStrSetEngine.getDirection().orthogonal(U)
  !exitDirection         = !entryDirection.opposite()

  -- define the gate by the new position
  !gate                  = object GATE(!position, !entryDirection, !exitDirection)
  !gate.arriveOffset     = !arriveOffset
  !gate.leaveOffset      = !leaveOffset
  !gate.height           = 0

  -- load the gate to the central object
  !this.meStrSetEngine.replaceGate(!gate, !index)

  -- evaluate the stair set
  !this.evaluateStrSet()

  -- create the stair flight
  !this.meStrSetEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- update the stair flight frame
  !this.updateFrameStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickAccessReturnStrTwr
--
-- Description: implements new access point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pickAccessStrTwr()

  !rows = !this.neAccessStrTwr.getSelectedRows()
  if ( !rows.size().neq(1) ) then
    !!alert.warning('Only possible when one row is selected')
    return
  endif

  !strTwrData  = !this.meStrTwrEngine.strTwrData
  !xLength     = !this.meStrTwrEngine.getXLength()
  !yLength     = !this.meStrTwrEngine.getYLength()
  !zLength     = !this.meStrTwrEngine.getZLength()
  !position    = !this.meStrTwrEngine.getPosition()
  !orientation = !this.meStrTwrEngine.getOrientation()
  !xDir        = !strTwrData.orientation.xDir()
  !yDir        = !strTwrData.orientation.yDir()
  !zDir        = 'Z'
  !xDirOpp     = !xDir.opposite()
  !yDirOpp     = !yDir.opposite()

  -- Creating the planes for EDG Pick
  --------------------------------------------------------------

  !pickplane1 = object GPHPLANE()

  !pickplane1.plane.position = !position.offset(!yDir, !yLength / 2 ).offset(!zDir.direction(), !zLength / 2 )
  !pickplane1.plane.orientation = y is $!zDir and $!zDir is $!yDir
  !pickplane1.fill = 'ON'

  !pickplane1.y = !zLength
  !pickplane1.x = !xLength

  --------------------------------------------------------------

  !pickplane2 = object GPHPLANE()

  !pickplane2.plane.position = !position.offset(!yDirOpp, !yLength / 2 ).offset(!zDir.direction(), !zLength / 2 )
  !pickplane2.plane.orientation = y is $!zDir and $!zDir is $!yDirOpp
  !pickplane2.fill = 'ON'

  !pickplane2.y = !zLength
  !pickplane2.x = !xLength

  --------------------------------------------------------------

  !pickplane3 = object GPHPLANE()

  !pickplane3.plane.position =  !position.offset(!xDir, !xLength / 2 ).offset(!zDir.direction(), !zLength / 2 )
  !pickplane3.plane.orientation = y is $!yDir and $!zDir is $!xDir
  !pickplane3.fill = 'ON'

  !pickplane3.x = !zLength
  !pickplane3.y = !yLength

  --------------------------------------------------------------

  !pickplane4 = object GPHPLANE()

  !pickplane4.plane.position =  !position.offset(!xDirOpp, !xLength / 2 ).offset(!zDir.direction(), !zLength / 2 )
  !pickplane4.plane.orientation = y is $!yDir and $!zDir is $!xDirOpp
  !pickplane4.fill = 'ON'

  !pickplane4.x = !zLength
  !pickplane4.y = !yLength

  -------------------------------------------------------------
  --adding the created planes for EDG System pick

  do !i from 1 to 4
  !this.planeNumber[!i] = !!aidNumbers.add(!pickplane$!i)
  enddo

  -------------------------------------------------------------

  -- defines packet
  !packet                            = object EDGPACKET()
  !packet.pickPacket.prompt          = 'Identify position of Access Point'

  -- defines first pick
  !packet.pickPacket.picks[1]        = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('')

  -- define actions on first pick
  !packet.action                     = '!!aslMain.pickAccessStrTwrReturn(!this.return[1])'

  --set the description
  !packet.description                = 'ASL EDG Pick'

  -- removes the picking plane from the display
  !packet.escape                     = '!!aslMain.edgClearPlane()'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)



endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickAccessStrTwrReturn
--
-- Description: repositions gate
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA
--                           edg pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pickAccessStrTwrReturn(!positionData is EDGPOSITIONDATA)

  !rows = !this.neAccessStrTwr.getSelectedRows()
  if ( !rows.size().neq(1) ) then
    !!alert.warning('Only possible when one row is selected')
    return
  endif
  !index = !rows[1][1].real()

  -- init
  !strTwr       = !this.meStrTwrEngine.getRefe()
  !posData      = !positionData.position
  !pickPosition = !posData.wrt(!strTwr)

  -- create the four planes to know on which the position lies
  !xLength     = !this.meStrTwrEngine.getXLength()
  !yLength     = !this.meStrTwrEngine.getYLength()
  !zLength     = !this.meStrTwrEngine.getZLength()
  !strTwrOri   = !this.meStrTwrEngine.getOrientation()
  !strTwrPos   = !this.meStrTwrEngine.getPosition()
  !xDir        = !strTwrOri.xDir()
  !yDir        = !strTwrOri.yDir()

  -- show the planes
  !position    = !strTwrPos.offset(!yDir,            !yLength / 2).offset(U, !zLength / 2)
  !orientation = object ORIENTATION('Z IS ' & !yDir & ' AND X IS U')
  !plane1      = object PLANE(!position, !orientation)

  !position    = !strTwrPos.offset(!yDir.opposite(), !yLength / 2).offset(U, !zLength / 2)
  !orientation = object ORIENTATION('Z IS ' & !yDir & ' AND X IS U')
  !plane2      = object PLANE(!position, !orientation)

  !position    = !strTwrPos.offset(!xDir,            !xLength / 2).offset(U, !zLength / 2)
  !orientation = object ORIENTATION('Z IS ' & !xDir & ' AND X IS U')
  !plane3      = object PLANE(!position, !orientation)

  !position    = !strTwrPos.offset(!xDir.opposite(), !xLength / 2).offset(U, !zLength / 2)
  !orientation = object ORIENTATION('Z IS ' & !xDir & ' AND X IS U')
  !plane4      = object PLANE(!position, !orientation)

  if ( !pickPosition.distance(!plane3).lt(5) ) then
    !pickPosition.north    = 0
    !entryDirection        = object DIRECTION('W')
    !entryDirection.origin = !strTwr
    !exitDirection         = object DIRECTION('E')
    !exitDirection.origin  = !strTwr

  elseif ( !pickPosition.distance(!plane4).lt(5) ) then
    !pickPosition.north    = 0
    !entryDirection        = object DIRECTION('E')
    !entryDirection.origin = !strTwr
    !exitDirection         = object DIRECTION('W')
    !exitDirection.origin  = !strTwr

  elseif ( !pickPosition.distance(!plane1).lt(5) ) then
    !pickPosition.east     = 0
    !entryDirection        = object DIRECTION('S')
    !entryDirection.origin = !strTwr
    !exitDirection         = object DIRECTION('N')
    !exitDirection.origin  = !strTwr

  elseif ( !pickPosition.distance(!plane2).lt(5) ) then
    !pickPosition.east     = 0
    !entryDirection        = object DIRECTION('N')
    !entryDirection.origin = !strTwr
    !exitDirection         = object DIRECTION('S')
    !exitDirection.origin  = !strTwr

  endif
  !gate = object GATE(!pickPosition, !entryDirection, !exitDirection)
  !this.meStrTwrEngine.replaceGate(!gate, !index)

  -- remove all planes
  !this.edgClearPlane()

  -- draw the tower
  !this.evaluateStrTwrPreview()

endmethod
-- End of method

------------------------------------------------------------------------
