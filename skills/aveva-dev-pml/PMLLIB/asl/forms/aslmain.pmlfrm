define method .modifyAccessWWay(!array is ARRAY)

  -- means it is OK to change the value
  !array[1] = TRUE

--TODO: modifyAccessWWay

  -- create the handrail
  !this.meWWayEngine.updateDB()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyAccessLadder
--
-- Description: callback when changing the grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       not idea
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyAccessLadder(!array is ARRAY)

  -- means it is OK to change the value
  !array[1] = TRUE

  !allRows   = !this.neAccessLadder.getRows()
  !sideExits = object ARRAY()
  do !i index !allRows
    !row                          = !allRows[!i]
    !sideExit                     = object ASLLADDEREXITDATA()
    !sideExit.elevation           = !row[2].real()
    if ( !row[3] inset ('1', 'Back') ) then
      !sideExit.exitType          = 'BACK'
    elseif ( !row[3] inset ('2', 'Left') ) then
      !sideExit.exitType          = 'LEFT'
    elseif ( !row[3] inset ('3', 'Right') ) then
      !sideExit.exitType          = 'RIGHT'
    else
      !sideExit.exitType          = 'BOTH'
    endif
    !sideExit.headroom            = !row[4].real()
    !sideExit.distancePrevCage    = !row[5].real()

    !sideExits.append(!sideExit)
  enddo
  !this.meLadderEngine.setSideExits(!sideExits)

  -- create the ladder
  !this.meLadderEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- check if an error occurred
  if ( !this.meLadderEngine.getError() ) then
    !!alert.error(!!error.text)
    !this.meLadderEngine.resetError()
    return
  endif

  -- update the form
  !this.updateAccessLadder()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyHandRa
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyHandRa(!gadget is GADGET, !action is STRING)

 !undo = object UNDOABLE()
 !undo.description('Modify Handrail')
 !undo.undoAction('!!aslMain.ceHandRa()')
 !undo.add()

  -- open callback calls method twice
  if ( !gadget.type().eq('LIST') and $
       !action.eq('UNSELECT') ) then
    return
  endif

  -- rail height
  if ( !this.opRailHeightHandRa.dText.empty() ) then
    !this.meHandRaEngine.setRailHeight(!this.txRailHeightHandRa.val)
  else
    !this.meHandRaEngine.setRailHeight(!this.opRailHeightHandRa.selection().real())
  endif

  -- post spacing
  if ( !this.opPostSpacingHandRa.dText.empty() ) then
    !this.meHandRaEngine.setPostSpacing(!this.txPostSpacingHandRa.val)
  else
    !this.meHandRaEngine.setPostSpacing(!this.opPostSpacingHandRa.selection().real())
  endif

  -- tangent spacing
  if ( !this.opTangentSpacingHandRa.dText.empty() ) then
    !this.meHandRaEngine.setTangentSpacing(!this.txTangentSpacingHandRa.val)
  else
    !this.meHandRaEngine.setTangentSpacing(!this.opTangentSpacingHandRa.selection().real())
  endif

  -- tangent spacing
  if ( !this.opEndSpacingHandRa.dText.empty() ) then
    !this.meHandRaEngine.setEndSpacing(!this.txEndSpacingHandRa.val)
  else
    !this.meHandRaEngine.setEndSpacing(!this.opEndSpacingHandRa.selection().real())
  endif

  -- radius, only to be set when the gadget is called
  if ( !gadget.eq(!this.txRadiusHandRa) ) then
    !this.meHandRaEngine.setRadius(!this.txRadiusHandRa.val)
  endif

  -- build the handrail
  !this.meHandRaEngine.updateDB()

  -- updates the aid dimension elements
  !this.showDimFeedbackHandRa(object GADGET(), '')
  !this.lkreEvaluateHandRa.active = true
  !undo.endundoable()
endmethod
-- End of method

