------------------------------------------------------------------------
--
-- Method:      ceHandRa
--
-- Description: modify the handrail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .ceHandRa()

  !this.updateCoordinateSystem()
  -- remove aid lines
  !!aslCentralData.clearVolFeedback()

  -- check if you are below a HANDRA element
  HANDRA
  handle ANY
    !!alert.warning('Not below HANDRA hierarchy')
    return
  endhandle
  !handRaRefe = !!ce

  -- initialise the data objects
  !this.meHandRaEngine = object ASLHANDRAENGINE()

  -- update the new object with the current element
  !this.meHandRaEngine.updateDataObj(!handRaRefe)
  handle ANY
    !!alert.error('Unable to Modify: Check that the setting configuration used for this element exists')
    return
  endhandle

  -- update the gadgets
  !this.updateFrameHandRa()

endmethod
-- End of method

