------------------------------------------------------------------------
--
-- Method:      derivePositionOptionsLadder
--
-- Description: Derive options from pick data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .derivePositionOptionsLadder()

  -- evaluates the position options
  !positionOptions  = !this.meLadderEngine.getPositionOptions()
  !positionLabels   = !positionOptions.first()
  !positionPixmaps  = !positionOptions.last()

  -- fills the gadgets
  do !i index !positionLabels
    !iString = '0' & !i
    !iString = !iString.subString(-2, 2)
    !this.attribute('TOPOSOPTIONLADDER' & !iString).addPixmap(!positionPixmaps[!i])
    !this.attribute('TOPOSOPTIONLADDER' & !iString).visible = true
    !this.attribute('TOPOSOPTIONLADDER' & !iString).val     = false
    !this.attribute('LKPOSOPTIONLADDER' & !iString).tag     = !positionLabels[!i]
  enddo

  do !i from (!positionLabels.size() + 1) to 10
    !iString = '0' & !i
    !iString = !iString.subString(-2, 2)
    !this.attribute('TOPOSOPTIONLADDER' & !iString).visible = false
    !this.attribute('TOPOSOPTIONLADDER' & !iString).val     = false
    !this.attribute('LKPOSOPTIONLADDER' & !iString).tag     = ''
  enddo

  -- switch on the first button if nothing has been selected yet
  !positionOption = !this.meLadderEngine.getPositionOption()
  !i              = !positionLabels.findFirst(!positionOption)
  if ( !positionOption.unset() or $
       !i.unset() ) then
    !this.toPosOptionLadder01.val                       = true
    !this.meLadderEngine.setPositionOption(!positionLabels.first())
  else
    !iString                                            = '0' & !i
    !iString                                            = !iString.subString(-2, 2)
    !this.attribute('TOPOSOPTIONLADDER' & !iString).val = true
    !this.meLadderEngine.setPositionOption(!positionOption)
  endif

endmethod
-- End of method

