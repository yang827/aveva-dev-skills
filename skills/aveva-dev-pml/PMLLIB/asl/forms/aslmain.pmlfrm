------------------------------------------------------------------------

define method .deriveExtensionOptionsStrSet()

  -- evaluates the current segment index
  !segmentIdx = !this.nuSegmentStrSet.val.max(1)

  -- evaluates the installation option
  !extensionOptions = !this.meStrSetEngine.getExtensionOptions()
  !extensionLabels  = !extensionOptions.first()
  !extensionPixmaps = !extensionOptions.last()

  -- fills the gadgets
  do !i index !extensionLabels
    !this.attribute('TOEXTENSIONOPTIONSTRSET' & !i).addPixmap(!extensionPixmaps[!i])
    !this.attribute('TOEXTENSIONOPTIONSTRSET' & !i).visible = true
    !this.attribute('TOEXTENSIONOPTIONSTRSET' & !i).val     = false
    !this.attribute('LKEXTENSIONOPTIONSTRSET' & !i).tag     = !extensionLabels[!i]
  enddo

  do !i from (!extensionLabels.size() + 1) to 4
    !this.attribute('TOEXTENSIONOPTIONSTRSET' & !i).visible = false
    !this.attribute('TOEXTENSIONOPTIONSTRSET' & !i).val     = false
    !this.attribute('LKEXTENSIONOPTIONSTRSET' & !i).tag     = ''
  enddo

  -- switch on the first button if nothing has been selected yet
  !extensionOption = !this.meStrSetEngine.getExtensionOption(!segmentIdx)
  !i               = !extensionLabels.findFirst(!extensionOption)
  if ( !extensionOption.unset() or $
       !i.unset() ) then
    !this.toExtensionOptionStrSet1.val                  = true
    !this.meStrSetEngine.setExtensionOption(!extensionLabels.first(), !segmentIdx)
  else
    !this.attribute('TOEXTENSIONOPTIONSTRSET' & !i).val = true
 --   !this.meStrSetEngine.setExtensionOption(!extensionOption, !segmentIdx)
  endif

