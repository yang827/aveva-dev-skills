--                           edg pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pickAccessHandRaReturn(!positionData is EDGPOSITIONDATA)

  !rows = !this.neAccessHandRa.getSelectedRows()
  if ( !rows.size().neq(1) ) then
    !!alert.warning('Only possible when one row is selected')
    return
  endif

  !this.meHandRaEngine.replaceGate(!positionData.position, !rows[1].first().real())
  !this.updateFrameHandRa()

  -- create the handrail
  !this.meHandRaEngine.updateDB()

endmethod
