------------------------------------------------------------------------
--
-- Method:      updateAccessStrSet
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateAccessStrSet()

  using namespace  'Aveva.Pdms.Presentation'

  !posFmt     = !!distanceFmt
  !posFmt.dp  = 0

  --set the headings of the access-list
  !heading[1] = 'No'
  !heading[2] = 'Position WRT /*'
  !heading[3] = 'Entry Direction'
  !heading[4] = 'Arrive Offset'
  !heading[5] = 'Leave Offset'

  !title      = 'Access Points'

  -- get all gates from the engine
  !allGates   = !this.meStrSetEngine.getGates()
  !strSetRefe = !this.meStrSetEngine.getRefe()
  !columns    = object ARRAY()
  do !i index !allGates
    !gate           = !allGates[!i]

    -- get the gate position
    !columns[!i]  = object ARRAY()
    !columns[!i].append(!i.string())
    !columns[!i].append(!gate.position.wrt(!strSetRefe).string(!posFmt).before(' WRT'))
    !columns[!i].append(!gate.entryDirection.wrt(!strSetRefe).string(!posFmt).before(' WRT'))
    !columns[!i].append(!gate.arriveOffset.string())
    !columns[!i].append(!gate.leaveOffset.string())
  enddo

  !netDataSource = object NETDATASOURCE(!title, !heading, !columns)
  !this.neAccessStrSet.bindToDataSource(!netDataSource)

  !this.lkDeleteAccessStrSet.active = false
  !this.lkPickAccessStrSet.active   = false

endmethod
-- End of method

------------------------------------------------------------------------
