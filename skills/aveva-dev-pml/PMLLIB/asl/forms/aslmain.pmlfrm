------------------------------------------------------------------------
--
-- Method:      changeCalcMethodStrSet
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .changeCalcMethodStrSet(!gadget is GADGET, !action is STRING)

  !gadgetName = !gadget.name().upcase()

  -- only one stair segment
  if ( !gadgetName.eq('RTOPTIMUMSTRSET') ) then
    !segmentIdx                    = !this.nuSegmentStrSet.val.max(1)

    !this.rtExplicitStrSet.val     = false
    !this.rtOptimumStrSet.val      = true
    !this.toPitchStrSet.val        = true
    !this.toTreadsStrSet.val       = true
    !this.meStrSetEngine.setLock('PITCHLOCK', true, !segmentIdx)
    !this.meStrSetEngine.setLock('TREADSLOCK', true, !segmentIdx)
    !this.frExplicitStrSet.visible = false
    !this.frOptimumStrSet.visible  = true

    !this.updateOptimumGadgetStrSet(!segmentIdx)

  elseif ( !gadgetName.eq('RTEXPLICITSTRSET') ) then
    !this.rtOptimumStrSet.val      = false
    !this.rtExplicitStrSet.val     = true
    !this.frOptimumStrSet.visible  = false
    !this.frExplicitStrSet.visible = true
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clearPlanesStrTwr()
