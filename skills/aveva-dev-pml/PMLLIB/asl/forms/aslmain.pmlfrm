------------------------------------------------------------------------
--
-- Method:      dirOptionLadder
--
-- Description: open callback from install option gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dirOptionLadder(!gadget is GADGET, !action is STRING)

  -- get the respective toggle gadget
  !toggleGadget = !this.attribute('TO' & !gadget.name().subString(3))
  !labelGadget  = !this.attribute('LK' & !gadget.name().subString(3))

  -- if toggle is already switched on then return
  if ( !gadget.neq(!toggleGadget) and $
       !toggleGadget.val          or  $
       !gadget.eq(!toggleGadget)  and $
       !action.eq('UNSELECT') ) then
    !toggleGadget.val     = true
    return
  endif

  -- switch on the toggle gadget
  !toggleGadget.val     = true
  !this.meLadderEngine.setDirectionOption(!labelGadget.tag)

  -- recalculate the stair flight
  !this.evaluateLadder()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dirOptionStrSet
--
-- Description: open callback from install option gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dirOptionStrSet(!gadget is GADGET, !action is STRING)

  -- get the respective toggle gadget
  !toggleGadget = !this.attribute('TO' & !gadget.name().subString(3))
  !labelGadget  = !this.attribute('LK' & !gadget.name().subString(3))

  -- if toggle is already switched on then return
  if ( !gadget.neq(!toggleGadget) and $
       !toggleGadget.val          or  $
       !gadget.eq(!toggleGadget)  and $
       !action.eq('UNSELECT') ) then
    !toggleGadget.val     = true
    return
  endif

  -- switch on the toggle gadget
  !toggleGadget.val     = true
  !this.meStrSetEngine.setDirectionOption(!labelGadget.tag)

  -- evaluates the access point positions projected onto the stair flight plane
  !this.evaluateAccessPointPositionsStrSet()

  -- recalculate the stair flight
  !this.evaluateStrSet()

  -- create the stair flight
  !this.meStrSetEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- update the gadgets
  !this.updateFrameStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateAccessPointPositionsStrSet
--
-- Description: evaluates the access point positions projected onto the stair flight plane
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateAccessPointPositionsStrSet()

  -- update the strSetData
  !gates = object ARRAY()
  do !row value !this.neAccessStrSet.getRows()
    !position              = object POSITION(!row[2])
    !entryDirection        = object DIRECTION(!row[3])
    !exitDirection         = !entryDirection.opposite()
    !gate                  = object GATE(!position, !entryDirection, !exitDirection)
    !gate.arriveOffset     = !row[4].real()
    !gate.leaveOffset      = !row[5].real()
    !gate.height           = 0
    !gates.append(!gate)
  enddo
  !this.meStrSetEngine.setGates(!gates)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLadder
--
-- Description: Derive ladder from returned pick data and selections on the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateLadder()

  -- set the working points of the ladder
  !this.meLadderEngine.setWorkingPoints()

  -- set the tmplReference and the criterion reference
  !ladderTmplReference = !this.opLadderTmplReferenceLadder.selection().dbRef()
  !this.meLadderEngine.setTmplReference(!ladderTmplReference)
--  !this.meLadderEngine.setSettingReference()

  -- calculate the ladder
  !this.meLadderEngine.evaluate()

  -- check if an error occurred
  if ( !this.meLadderEngine.getError() ) then
    !!alert.error(!!error.text)
    !this.meLadderEngine.resetError()
    return
  endif

  -- create the ladder
  !this.meLadderEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- check if an error occurred
  if ( !this.meLadderEngine.getError() ) then
    !!alert.error(!!error.text)
    !this.meLadderEngine.resetError()
    return
  endif

  -- update the gadgets
  !this.updateFrameLadder()

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      evaluatePicksLadder
--
-- Description: evaluate picks and create ladder
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluatePicksLadder()

  -- reorder picks
  !this.meLadderEngine.reorderPicks()

  !lPosData = !this.meLadderEngine.getLPosData()
  !uPosData = !this.meLadderEngine.getUPosData()

  -- evaluates the height
  !lPos   = !lPosData.position.wrt(World)
  !uPos   = !uPosData.position.wrt(World)
  !height = abs(!uPos.up - !lPos.up)

  --evaluates the length
  !line   = object LINE(!lPos, !uPos)
  !ori    = object ORIENTATION('Z is U')
  !plane  = object PLANE(!lPos, !ori)
  !line   = !line.projected(!plane)
  !length = !line.length()

  -- checks the validity of the picks
  ---------------------------------------------------------------------------
  -- height
  if( !height.eq(0) ) then
    !!alert.warning('Unable to define ladder of zero height.')
    !!aslCentralData.clearVolFeedback()
    !this.frameChange(!this.frMain)
    return
  endif

  -- length
  if( !length.eq(0) ) then
    !!alert.warning('Unable to define ladder of zero length.')
   !!aslCentralData.clearVolFeedback()
    !this.frameChange(!this.frMain)
    return
  endif

  -- store the pick data
  !this.meLadderEngine.evaluateLPickType()
  !this.meLadderEngine.evaluateUPickType()

  -- fill the option gadgets
  !this.deriveOptionsLadder()

  -- evaluates the table
  !this.evaluateLadder()

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      evaluatePicksStrSet
--
-- Description: evaluate picks and create stair
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluatePicksStrSet()

  -- reorder picks
  !this.meStrSetEngine.reorderPicks()

  !lPosData = !this.meStrSetEngine.getLPosData()
  !uPosData = !this.meStrSetEngine.getUPosData()

  -- evaluates the oRise
  !lPos  = !lPosData.position.wrt(World)
  !uPos  = !uPosData.position.wrt(World)
  !oRise = abs(!uPos.up - !lPos.up)

  -- checks the validity of the picks
  ---------------------------------------------------------------------------
  -- oRise
  if( !oRise.eq(0) ) then
    !!alert.warning('Unable to define stair of zero height.')
    !!aslCentralData.clearVolFeedback()
    !this.frameChange(!this.frMain)
    return
  endif

  -- store the pick data
  !this.meStrSetEngine.evaluateLPickType()
  !this.meStrSetEngine.evaluateUPickType()

  -- reverse sense of line if necessary
  !this.meStrSetEngine.correctPickedLines()

  -- set the cut planes depending on the picked elements
  ---------------------------------------------------------------------------
  -- must be queried again because the lines might have changed
  !lPosData = !this.meStrSetEngine.getLPosData()
  !uPosData = !this.meStrSetEngine.getUPosData()
  if ( !lPosData.line.set() ) then
    !lCutPlane = !lPosData.line.direction().orthogonal(D)
    !this.meStrSetEngine.setLCutPlane(!lCutPlane)
  endif
  if ( !uPosData.line.set() ) then
    !uCutPlane = !uPosData.line.direction().orthogonal(D)
    !this.meStrSetEngine.setUCutPlane(!uCutPlane)
  endif

  -- fill the option gadgets
  !this.deriveInstallationOptionsStrSet()
  !this.deriveOptionsStrSet()
  !this.txLPosOriginStrSet.val = 'world'
  !this.txUPosOriginStrSet.val = 'world'
  -- evaluates the table
  !this.evaluateStrSet()

  -- create the stair flight
  !this.meStrSetEngine.showVolFeedback()

  -- create the stair flight
  if (!this.meStrSetEngine.getError().not() ) then
     !this.meStrSetEngine.updateDB()
  endif

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- update the gadgets
  !this.updateFrameStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluatePltFrm
--
-- Description: Derive platform from returned pick data and selections on the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluatePltFrm()

  -- check if an error occurred
  if ( !this.mePltFrmEngine.getError() ) then
    return
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateStrSet
--
-- Description: Derive stair from returned pick data and selections on the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateStrSet()

  !this.meStrSetEngine.evaluate()

  -- check if an error occurred
  if ( !this.meStrSetEngine.getError() ) then
    return
  endif


  !numberOfSegments = !this.meStrSetEngine.getNumberOfSegments()
  do !i to !numberOfSegments
    !this.meStrSetEngine.useOptimum(!i)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateStrTwr
--
-- Description: evaluates the stair tower with the settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateStrTwr()

  -- selects the templates

  !strFltTmplReference = !this.opStrFltTmplReferenceStrTwr.selection().dbRef()
  !strLngTmplReference = !this.opStrLngTmplReferenceStrTwr.selection().dbRef()
  !handRaTmplReference = !this.opHandRaTmplReferenceStrTwr.selection().dbRef()

  !this.meStrTwrEngine.setTmplReferences(!strFltTmplReference, !strLngTmplReference, !handRaTmplReference)

  -- evaluate the stair tower
  !this.meStrTwrEngine.evaluate()

  -- check if an error occurred
  if ( !this.meStrTwrEngine.getError() ) then
    !!alert.error(!!error.text)
    !this.meStrTwrEngine.resetError()
    return
  endif

  -- create the stair tower
  !this.meStrTwrEngine.updateDB()
  !this.meStrTwrEngine.strTwrData.updateGenAtt()

  !!aslCentralData.clearVolFeedback()

  !!fmSys.setProgress(0)

  -- check if an error occurred
  if ( !this.meStrTwrEngine.getError() ) then
    !!alert.error(!!error.text)
    !this.meStrTwrEngine.resetError()
    return
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateStrTwrPreview
--
-- Description: evaluates the stair tower for the quick preview
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateStrTwrPreview()

  -- clear all aidLines
  !!aslCentralData.clearVolFeedback()

  -- derive centre lines and planes
  !this.meStrTwrEngine.deriveCentreLines()

  -- derive the maximum stair flight lengths in both directions, the length of one circumference
  -- the "virtual" platforms
  !this.meStrTwrEngine.deriveBasicSettings()

  -- the basic platforms take the gates into account and combine them with the "virtual" platforms
  !this.meStrTwrEngine.deriveBasicPlatforms()

  -- derive the number of levels (quick evaluate)
  !this.meStrTwrEngine.evaluateQuick()

  -- derive the number of levels (quick evaluate)
  !this.meStrTwrEngine.evaluateStrFlts()

  -- derive the number of levels (quick evaluate)
  !this.meStrTwrEngine.showVolFeedback()

  -- updates the limits
  !this.updateFrameStrTwr()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateWWay
--
-- Description: Derive walkway from returned pick data and selections on the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateWWay()

  !this.meWWayEngine.evaluate()

  -- check if an error occurred
  if ( !this.meWWayEngine.getError() ) then
    return
  endif



  endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      extensionOptionStrSet
--
-- Description: open callback from extension option gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .extensionOptionStrSet(!gadget is GADGET, !action is STRING)

  -- evaluates the current segment index
  !segmentIdx = !this.nuSegmentStrSet.val.max(1)

  -- get the respective toggle gadget
  !toggleGadget = !this.attribute('TO' & !gadget.name().subString(3))
  !labelGadget  = !this.attribute('LK' & !gadget.name().subString(3))

  -- if toggle is already switched on then return
  if ( !gadget.neq(!toggleGadget) and $
       !toggleGadget.val          or  $
       !gadget.eq(!toggleGadget)  and $
       !action.eq('UNSELECT') ) then
    !toggleGadget.val     = true
    return
  endif

  -- switch off all install option toggle gadgets
  do !i to 4
    !this.attribute('TOEXTENSIONOPTIONSTRSET' & !i).val = false
  enddo

  -- switch on the toggle gadget
  !toggleGadget.val = true
  !this.meStrSetEngine.setExtensionOption(!labelGadget.tag, !segmentIdx)

  -- reads the values for extensions
  !this.txLExtensionStrSet.val = !this.meStrSetEngine.getLExtension(!segmentIdx)
  !this.txUExtensionStrSet.val = !this.meStrSetEngine.getUExtension(!segmentIdx)

  -- recalculate the stair flight
  !this.modifyStrSet(!gadget, !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      firstPickLadderReturn
--
-- Description: First pick
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA First pick data
-- Return:
--   [Data Type] [Description]
--    EDGPOSITIONDATA Derived position
------------------------------------------------------------------------

define method .firstPickLadderReturn(!pickData is EDGPICKDATA) is EDGPOSITIONDATA

  -- set the picks in the object (top or bottom)
  !this.setPickLadder('BOTTOM', !pickData)

  -- clears existing graphics and draw the control point
  !!aslCentralData.clearVolFeedback()

  -- Return data
  return !pickData.positionData()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      firstPickStrSet
--
-- Description: First pick
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA First pick data
-- Return:
--   [Data Type] [Description]
--    EDGPOSITIONDATA Derived position
------------------------------------------------------------------------

define method .firstPickStrSet(!pickData is EDGPICKDATA) is EDGPOSITIONDATA

  -- set the picks in the object (top or bottom)
  !this.setPickStrSet('BOTTOM', !pickData)

  -- clears existing graphics and draw the control point
  !!aslCentralData.clearVolFeedback()

  return !pickData.positionData()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      flipAccessHandRa
--
-- Description: flip gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .flipAccessHandRa()

  -- loop through the selected rows and delete the respective gate
  !indices = ARRAY()
  do !row value !this.neAccessHandRa.getSelectedRows()
    !indices.append(!row[1].real())
  enddo

  !this.meHandRaEngine.flipGates(!indices)

  !this.updateFrameHandRa()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      frameChange
--
-- Description: make the main frames visible/invisible
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the gadget to be visible
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .frameChange(!gadget is GADGET)

  if ( !gadget.eq(!this.frMain) ) then
    !this.frMain.visible           = true
    !this.frMainWorkLadder.visible = false
    !this.frMainWorkStrSet.visible = false
    !this.frMainWorkStrTwr.visible = false
    !this.frMainWorkHandRa.visible = false
    !this.frMainWorkPltFrm.visible = false
    !this.frMainWorkWWay.visible   = false
    !this.formTitle                = 'ASL Designer'

    !this.track()

    -- call method to clear incomplete stair tower, if any
    !this.clearIncompleteStrTwr()

    -- hide all aid lines
    !!aslCentralData.clearDimFeedback()
    !!aslCentralData.clearVolFeedback()

  elseif ( !gadget.eq(!this.frMainWorkLadder) ) then
    !this.frMain.visible           = false
    !this.frMainWorkLadder.visible = true
    !this.frMainWorkStrSet.visible = false
    !this.frMainWorkStrTwr.visible = false
    !this.frMainWorkHandRa.visible = false
    !this.frMainWorkPltFrm.visible = false
    !this.frMainWorkWWay.visible   = false
    !this.formTitle                = 'Modify Ladder'

  elseif ( !gadget.eq(!this.frMainWorkStrSet) ) then
    !this.frMain.visible           = false
    !this.frMainWorkLadder.visible = false
    !this.frMainWorkStrSet.visible = true
    !this.frMainWorkStrTwr.visible = false
    !this.frMainWorkHandRa.visible = false
    !this.frMainWorkPltFrm.visible = false
    !this.frMainWorkWWay.visible   = false
    !this.formTitle                = 'Modify Stair Flight'

  elseif ( !gadget.eq(!this.frMainWorkStrTwr) ) then
    !this.frMain.visible           = false
    !this.frMainWorkLadder.visible = false
    !this.frMainWorkStrSet.visible = false
    !this.frMainWorkStrTwr.visible = true
    !this.frMainWorkHandRa.visible = false
    !this.frMainWorkPltFrm.visible = false
    !this.frMainWorkWWay.visible   = false
    !this.formTitle                = 'Modify Stair Tower'

  elseif ( !gadget.eq(!this.frMainWorkHandRa) ) then
    !this.frMain.visible           = false
    !this.frMainWorkLadder.visible = false
    !this.frMainWorkStrSet.visible = false
    !this.frMainWorkStrTwr.visible = false
    !this.frMainWorkHandRa.visible = true
    !this.frMainWorkPltFrm.visible = false
    !this.frMainWorkWWay.visible   = false
    !this.formTitle                = 'Modify Handrail'

  elseif ( !gadget.eq(!this.frMainWorkPltFrm) ) then
    !this.frMain.visible           = false
    !this.frMainWorkLadder.visible = false
    !this.frMainWorkStrSet.visible = false
    !this.frMainWorkStrTwr.visible = false
    !this.frMainWorkHandRa.visible = false
    !this.frMainWorkPltFrm.visible = true
    !this.frMainWorkWWay.visible   = false
    !this.formTitle                = 'Modify Platform'

  elseif ( !gadget.eq(!this.frMainWorkWWay) ) then
    !this.frMain.visible           = false
    !this.frMainWorkLadder.visible = false
    !this.frMainWorkStrSet.visible = false
    !this.frMainWorkStrTwr.visible = false
    !this.frMainWorkHandRa.visible = false
    !this.frMainWorkPltFrm.visible = false
    !this.frMainWorkWWay.visible   = true
    !this.formTitle                = 'Modify Walkway'
  endif

  -- init the progress bar
  !!fmSys.setProgress(0)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOptimumPitchStrSet
--
-- Description: use the optimum pitch
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getOptimumPitchStrSet()

  !segmentIdx                      = !this.nuSegmentStrSet.val.max(1)

  -- gets the optimum value form the current standard
  !this.txPitchStrSet.val          = !this.meStrSetEngine.getOptimumPitch(!segmentIdx)

  -- remove all locks from the object
  !this.meStrSetEngine.setLock('GOINGLOCK',      false, !segmentIdx)
  !this.meStrSetEngine.setLock('LEXTENSIONLOCK', false, !segmentIdx)
  !this.meStrSetEngine.setLock('OGOINGLOCK',     false, !segmentIdx)
  !this.meStrSetEngine.setLock('PITCHLOCK',      false, !segmentIdx)
  !this.meStrSetEngine.setLock('RISELOCK',       false, !segmentIdx)
  !this.meStrSetEngine.setLock('TREADSLOCK',     false, !segmentIdx)
  !this.meStrSetEngine.setLock('UEXTENSIONLOCK', false, !segmentIdx)

  -- remove the locks from the form
  !this.toGoingStrSet.val          = false
  !this.toLExtensionStrSet.val     = false
  !this.toOGoingStrSet.val         = false
  !this.toPitchStrSet.val          = false
  !this.toRiseStrSet.val           = false
  !this.toTreadsStrSet.val         = false
  !this.toUExtensionStrSet.val     = false

  !this.modifyStrSet(!this.txPitchStrSet, '')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOptimumPitchStrTwr
--
-- Description: use the optimum pitch
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getOptimumPitchStrTwr()

  -- gets the optimum value form the current standard
  !this.txStrFltPitchStrTwr.val = !this.meStrTwrEngine.getOptimumPitch()

  !this.modifyStrTwr(!this.txStrFltPitchStrTwr, '')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOptimumStrSet
--
-- Description: use the chosen optimum combination of number of treads
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .getOptimumStrSet(!gadget is GADGET, !action is STRING)

  if ( !action.eq('UNSELECT') ) then
    return
  endif

  -- number of segments
  !segmentIdx = !this.nuSegmentStrSet.val.max(1)

  !this.txPitchStrSet.val = !gadget.selection().after(';').real()
  !this.opTreadsStrSet.select('DTEXT', !gadget.selection().before(';'))
  handle ANY
  endhandle
  !this.toPitchStrSet.val  = true
  !this.toTreadsStrSet.val = true
  !this.meStrSetEngine.setPitch(!this.txPitchStrSet.val,                  !segmentIdx)
  !this.meStrSetEngine.setLock('PITCHLOCK', true,  !segmentIdx)
  !this.meStrSetEngine.setTreads(!this.opTreadsStrSet.selection().real(), !segmentIdx)
  !this.meStrSetEngine.setLock('TREADSLOCK', true, !segmentIdx)

  !this.modifyStrSet(!this.txPitchStrSet, '')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      installOptionStrSet
--
-- Description: open callback from install option gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .installOptionStrSet(!gadget is GADGET, !action is STRING)

  -- get the respective toggle gadget
  !toggleGadget = !this.attribute('TO' & !gadget.name().subString(3))
  !labelGadget  = !this.attribute('LK' & !gadget.name().subString(3))

  -- if toggle is already switched on then return
  if ( !gadget.neq(!toggleGadget) and $
       !toggleGadget.val          or  $
       !gadget.eq(!toggleGadget)  and $
       !action.eq('UNSELECT') ) then
    !toggleGadget.val     = true
    return
  endif

  -- switch off all install option toggle gadgets
  do !i to 7
    !this.attribute('TOINSTALLOPTIONSTRSET' & !i).val = false
  enddo

  -- switch on the toggle gadget
  !toggleGadget.val = true
  !this.meStrSetEngine.setInstallationOption(!labelGadget.tag)

  -- evaluates the access point positions projected onto the stair flight plane
  !this.evaluateAccessPointPositionsStrSet()

  -- fill the form with the respective position and direction options
  !this.deriveOptionsStrSet()

  -- recalculate the stair flight
  !this.evaluateStrSet()

  -- create the stair flight
  !this.meStrSetEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- update the gadgets
  !this.updateFrameStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      installOptionStrTwr
--
-- Description: open callback from install option gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .installOptionStrTwr(!gadget is GADGET, !action is STRING)

  -- get the respective toggle gadget
  !toggleGadget = !this.attribute('TO' & !gadget.name().subString(3))
--  !labelGadget  = !this.attribute('LK' & !gadget.name().subString(3))

  -- if toggle is already switched on then return
  if ( !gadget.neq(!toggleGadget) and $
       !toggleGadget.val          or  $
       !gadget.eq(!toggleGadget)  and $
       !action.eq('UNSELECT') ) then
    !toggleGadget.val     = true
    return
  endif

  -- switch off all install option toggle gadgets
  do !i to 4
    !this.attribute('TOINSTALLOPTIONSTRTWR' & !i).val = false
  enddo

  -- switch on the toggle gadget
  !toggleGadget.val = true
  !this.meStrTwrEngine.setInstallationOption(!toggleGadget.tag)

  -- recalculate the stair Tower
  !this.evaluateStrTwrPreview()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergeHandRaRouting
--
-- Description: implements merge of handrail routings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergeHandRaRouting()

  -- defines packet
  !packet                     = object EDGPACKET()
  !packet.pickPacket.prompt   = 'Identify handrail for merge'

  -- defines first pick
  !packet.pickPacket.picks[1] = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('')

  -- define actions on first pick
  --!packet.action              = '!!aslMain.mergeHandRaRoutingReturn(!this.return[1])'

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergeOpeningsPltFrm
--
-- Description: merge openings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergeOpeningsPltFrm()

  !rows = !this.neOpeningsPltFrm.getSelectedRows()
  if ( !rows.size().leq(1) ) then
    !!alert.warning('Only possible when at least two rows are selected')
    return
  endif

  if ( !!alert.confirm('Do you really want to merge the selected openings?').neq('YES') ) then
    return
  endif

  !indices = ARRAY()
  do !row value !this.neOpeningsPltFrm.getSelectedRows()
    !indices.append(!row[1].real())
  enddo
  !this.mePltFrmEngine.mergeOpenings(!indices)

  -- check for errors
  if ( !this.mePltFrmEngine.getError() ) then
    !!alert.warning(!!error.text)
    !this.mePltFrmEngine.resetError()
  endif

  -- evaluate the handrails
  !this.mePltFrmEngine.evaluateHandRa()

  -- create the platform
  !this.mePltFrmEngine.updateDB()

  -- update the frame
  !this.cePltFrm()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergePltFrmShape
--
-- Description: implements merge of platform shape
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergePltFrmShape()

  -- initialise the stack of platforms to be merged
  !this.mePltFrmStack         = ARRAY()

  -- defines packet
  !packet                     = object EDGPACKET()
  !packet.pickPacket.prompt   = 'Identify platforms to be merged'

  -- defines first pick
  !packet.pickPacket.picks[1] = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdElement('')

  -- define actions on first pick
  !packet.pickPacket.picks[1].action = '!!aslMain.mergePltFrmShapeReturn(!this.return[1])'

  !packet.escape                     = '!!aslMain.mergePltFrmShapes()'

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergePltFrmShapeReturn
--
-- Description: return of implements merge of platform shape
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA edg pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergePltFrmShapeReturn(!pickData is EDGPICKDATA)

  !pickedItem = !pickData.item
  !pltFrmFlag = !pickedItem.ahList.findFirst('PLTFRM').set()

  if ( !pltFrmFlag.not() ) then
    !!alert.warning('Unable to merge - Picked item is not a platform')
    return
  endif

  !refe = !!ce
  !!ce  = !pickedItem
  !this.mePltFrmStack.append(PLTFRM)
  !!ce  = !refe

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergePltFrmShapes
--
-- Description: merge the shapes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA edg pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergePltFrmShapes()

  !this.mePltFrmEngine.mergePlatforms(!this.mePltFrmStack)

  !this.cePltFrm()

endmethod
-- End of method

