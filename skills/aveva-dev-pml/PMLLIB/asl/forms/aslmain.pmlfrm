-- Method:      modifyRailSpacingHandRa
--
-- Description: callback when changing the grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       not idea
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyRailSpacingHandRa(!array is ARRAY)

  -- means it is OK to change the value
  !array[1] = TRUE

  !allRows    = !this.neRailSpacingHandRa.getRows()
  !railSpacing = object ARRAY()
  do !row value !allRows
    !railSpacing.append(!row[2].real())
  enddo
  !this.meHandRaEngine.setRailSpacing(!railSpacing)

  -- create the handrail
  !this.meHandRaEngine.updateDB()

  -- updates the aid dimension elements
  !this.showDimFeedbackHandRa(object GADGET(), '')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyStrSet
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyStrSet(!gadget is GADGET, !action is STRING)

 !undo = object UNDOABLE()
 !undo.description('Modify Stair flight')
 !undo.add()
 !undo.undoAction('!!aslMain.ceStrSet()')

  -- open callback calls method twice
  if ( !gadget.type().eq('LIST') and $
       !action.eq('UNSELECT') ) then
    return
  endif

  -- number of segments
  !segmentIdx = !this.nuSegmentStrSet.val.max(1)

  -- stair set attributes
  ---------------------------------------------------------------------------
  -- overall rise
  if ( !gadget.eq(!this.opORiseStrSet) ) then
    !this.meStrSetEngine.setORise(!this.opORiseStrSet.selection().real())
  elseif ( !gadget.eq(!this.txORiseStrSet) ) then
    !this.meStrSetEngine.setORise(!this.txORiseStrSet.val)

  -- overall length
  elseif ( !gadget.eq(!this.opLengthStrSet) ) then
    !this.meStrSetEngine.setLength(!this.opLengthStrSet.selection().real())
  elseif ( !gadget.eq(!this.txLengthStrSet) ) then
    !this.meStrSetEngine.setLength(!this.txLengthStrSet.val)

  -- width
  elseif ( !gadget.eq(!this.opWidthStrSet) ) then
    !this.meStrSetEngine.setWidth(!this.opWidthStrSet.selection().real())
  elseif ( !gadget.eq(!this.txWidthStrSet) ) then
    !this.meStrSetEngine.setWidth(!this.txWidthStrSet.val)

  -- lower cutplane
  elseif ( !gadget.eq(!this.txLCutPlaneStrSet) ) then
    !this.meStrSetEngine.setLCutPlane(!this.txLCutPlaneStrSet.val.direction())

  -- upper cutplane
  elseif ( !gadget.eq(!this.txUCutPlaneStrSet) ) then
    !this.meStrSetEngine.setUCutPlane(!this.txUCutPlaneStrSet.val.direction())

  -- flight thickness
  elseif ( !gadget.eq(!this.txFThicknessStrSet) ) then
    !this.meStrSetEngine.setFThickness(!this.txFThicknessStrSet.val)

  -- lower offset
  elseif ( !gadget.eq(!this.txLOffsetStrSet) ) then
    !this.meStrSetEngine.setLOffset(!this.txLOffsetStrSet.val)

  -- upper offset
  elseif ( !gadget.eq(!this.txUOffsetStrSet) ) then
    !this.meStrSetEngine.setUOffset(!this.txUOffsetStrSet.val)

 -- lower explicit position
  elseif ( !gadget inset (!!aslMain.netStrSetLPositionFrame,!this.txLPosOriginStrSet ) ) then
    !position        = N0
    !position.east   = !this.strSetLPosControl.xyz()[0]
    !position.north  = !this.strSetLPosControl.xyz()[1]
    !position.up     = !this.strSetLPosControl.xyz()[2]
    !position.origin = !this.txLPosOriginStrSet.val.dbRef()
    !this.meStrSetEngine.strSetData.lPosData.position = !position
    !this.setMainAttributesStrSet()

  -- upper explicit position
  elseif ( !gadget inset (!!aslMain.netStrSetUPositionFrame, !this.txUPosOriginStrSet ) ) then
    !position        = N0
    !position.east   = !this.strSetUPosControl.xyz()[0]
    !position.north  = !this.strSetUPosControl.xyz()[1]
    !position.up     = !this.strSetUPosControl.xyz()[2]
    !position.origin = !this.txUPosOriginStrSet.val.dbRef()
    !this.meStrSetEngine.strSetData.uPosData.position = !position
    !this.setMainAttributesStrSet()


  --explicit direction
  elseif ( !gadget inset (!this.txDirStrSet, !this.txDirOriginStrSet ) ) then
    !direction        = object DIRECTION(!this.txDirStrSet.val)
    !direction.origin = !this.txDirOriginStrSet.val.dbRef()
    !this.meStrSetEngine.setExplicitDirection(!direction)

  -- stair flight attributes
  ---------------------------------------------------------------------------
  -- lower extension
  elseif ( !gadget.eq(!this.txLExtensionStrSet) ) then
    !this.meStrSetEngine.setLExtension(!this.txLExtensionStrSet.val, !segmentIdx)

  -- upper extension
  elseif ( !gadget.eq(!this.txUExtensionStrSet) ) then
    !this.meStrSetEngine.setUExtension(!this.txUExtensionStrSet.val, !segmentIdx)

  -- overall going
  elseif ( !gadget.eq(!this.opOGoingStrSet) ) then
    !this.meStrSetEngine.setOGoing(!this.opOGoingStrSet.selection().real(), !segmentIdx)
  elseif ( !gadget.eq(!this.txOGoingStrSet) ) then
    !this.meStrSetEngine.setOGoing(!this.txOGoingStrSet.val, !segmentIdx)

  -- pitch
  elseif ( !gadget.eq(!this.opPitchStrSet) ) then
    !this.meStrSetEngine.setPitch(!this.opPitchStrSet.selection().real(), !segmentIdx)
  elseif ( !gadget.eq(!this.txPitchStrSet) ) then
    !this.meStrSetEngine.setPitch(!this.txPitchStrSet.val, !segmentIdx)

  -- rise
  elseif ( !gadget.eq(!this.opRiseStrSet) ) then
    !this.meStrSetEngine.setRise(!this.opRiseStrSet.selection().real(), !segmentIdx)
  elseif ( !gadget.eq(!this.txRiseStrSet) ) then
    !this.meStrSetEngine.setRise(!this.txRiseStrSet.val, !segmentIdx)

  -- going
  elseif ( !gadget.eq(!this.opGoingStrSet) ) then
    !this.meStrSetEngine.setGoing(!this.opGoingStrSet.selection().real(), !segmentIdx)
  elseif ( !gadget.eq(!this.txGoingStrSet) ) then
    !this.meStrSetEngine.setGoing(!this.txGoingStrSet.val, !segmentIdx)

  -- number of treads
  elseif ( !gadget.eq(!this.opTreadsStrSet) ) then
    !this.meStrSetEngine.setTreads(!this.opTreadsStrSet.selection().real(), !segmentIdx)
  endif



  -- for the selected text gadget set the lock anyway
  ---------------------------------------------------------------------------
  if ( !gadget.type() inset ('TEXT', 'LIST') ) then
    !attributeName = !gadget.name().subString(3).subString(-7) & 'LOCK'
    !oldValue      = !this.meStrSetEngine.getLock(!attributeName, !segmentIdx)
    !this.meStrSetEngine.setLock(!attributeName, true, !segmentIdx)
  endif

  -- update the whole stair flight table
  if ( !gadget inset (!this.opLengthStrSet,        $
                      !this.txLengthStrSet,        $
                      !this.opORiseStrSet,         $
                      !this.txLOffsetStrSet,       $
                      !this.txUOffsetStrSet,       $
                      !this.txORiseStrSet,         $
                      !this.opWidthStrSet,         $
                      !this.txWidthStrSet,         $
                      !this.txLCutPlaneStrSet,     $
                      !this.txUCutPlaneStrSet) and $
       !this.meStrSetEngine.getLPickType().neq('PLANE')                                                                                                                                                 and $
       !this.meStrSetEngine.getUPickType().neq('PLANE') ) then
    !this.evaluateStrSet()

  -- only update the segment
  else
    --if ( not !gadget inset (!this.txLOffsetStrSet, !this.txUOffsetStrSet) ) then
    !this.meStrSetEngine.evaluateSegment(!segmentIdx)
  endif

  -- for the selected text gadget set the lock anyway
  if ( !gadget.type() inset ('TEXT', 'LIST') ) then
    !attributeName    = !gadget.name().subString(3).subString(-7) & 'LOCK'
    !buttonGadgetName = 'TO' & !gadget.name().subString(3)

    -- does the button gadget exist?
    if ( !this.attributes().findFirst(!buttonGadgetName).set() ) then
      !buttonGadget     = !this.attribute(!buttonGadgetName)
      !buttonGadget.val = !oldValue
      !this.meStrSetEngine.setLock(!attributeName, !oldValue, !segmentIdx)
    endif
  endif

  -- create the stair flight
  !this.meStrSetEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- update the form with the current values
  !this.updateFrameStrSet()
  !this.lkreEvaluateStrSet.active = true
  !undo.endundoable()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyStrSetTmplReference
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyStrSetTmplReference(!gadget is GADGET, !action is STRING)

  -- selects the templates
  !strFltTmplReferenceStrSet  = !this.opStrFltTmplReferenceStrSet.selection().dbRef()
  !strLngTmplReferenceStrSet  = !this.opStrLngTmplReferenceStrSet.selection().dbRef()
  !handRaTmplReferenceStrSet  = !this.opHandRaTmplReferenceStrSet.selection().dbRef()
  !this.meStrSetEngine.setTmplReferences(!strFltTmplReferenceStrSet, !strLngTmplReferenceStrSet, !handRaTmplReferenceStrSet)

  -- combines general and fabricator standard
  !this.meStrSetEngine.mergeCriteria()

  -- set the optimum width
  !this.meStrSetEngine.setOptimumWidth()

  !this.updateLimitsStrSet()

  -- standard modify method
  !this.modifyStrSet(!gadget, !action)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyStrTwr
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyStrTwr(!gadget is GADGET, !action is STRING)

 --Added to Check the Validity of the Current Element to Be Stair Tower
 !this.ceValidCheck()

 --added to collect the primary direction (prmDirection) from the stair tower data (ASLSTRTWRDATA)
 !tempStrTwrPrmDir = !this.meStrTwrEngine.strTwrData.prmDirection

 --valid check for the direction and orientation of the stair tower
  if (!gadget.set() and !gadget.name().eq('TXDIRECTIONSTRTWR') and !gadget.val.upcase().eq('SOUTH')) then

    !this.meStrTwrEngine.strTwrData.prmDirection = !this.txDirectionStrTwr.val.direction()

  elseif (!gadget.set() and !gadget.name().eq('TXDIRECTIONSTRTWR') ) then

    if (matchwild(!gadget.val.upcase(), '*U*') or matchwild(!gadget.val.upcase(), '*D*') or matchwild(!gadget.val.upcase(), '*Z*')) then
       !!alert.error ('Cannot orientate Stair Tower in $!gadget.val Direction. Enter any Directional combination of East-West & North-South. Switching back to Last Updated $!gadget.tag Value ($!tempStrTwrPrmDir)')
       !this.meStrTwrEngine.strTwrData.prmDirection = !tempStrTwrPrmDir
    else
       !this.meStrTwrEngine.strTwrData.prmDirection = !this.txDirectionStrTwr.val.direction()
        handle (2,813)
         !!alert.error ('Enter a Valid Direction. Switching back to Last Updated $!gadget.tag Value ($!tempStrTwrPrmDir)')
         !this.meStrTwrEngine.strTwrData.prmDirection = !tempStrTwrPrmDir
        endhandle
    endif
  endif

  --updating the undoable object
  !undo = object UNDOABLE()
  !undo.description('Modify Stair Tower')
  !undo.add()
  !undo.undoAction('!!aslMain.ceStrTwr()')

  -- open callback calls method twice
  if ( !gadget.type().eq('LIST') and $
       !action.eq('UNSELECT') ) then
    return
  endif

  -- check statement for stair tower x length
  if ( !this.opXLengthStrTwr.dText.empty() ) then
   if(!this.txXLengthStrTwr.val.leq(!this.txCLXSpacingStrTwr.val))then

    if(!gadget.name() eq 'TXXLENGTHSTRTWR') then
     !!alert.message('Tower X Length Value should be Greater than CL spacing X of Stair Flight / Stair Landing')
     !!alert.message('Resetting $!gadget.tag Value to Optimum Value')
    else
     !!alert.message('Tower CL spacing X Value should be Lesser than Tower X Length of Stair Flight / Stair Landing')
     !!alert.message('Resetting $!gadget.tag Value to Optimum Value')
    endif

    !this.txXLengthStrTwr.val = !this.meStrTwrEngine.strTwrCriteria.length.optimum
    !this.txCLXSpacingStrTwr.val = !this.meStrTwrEngine.strTwrCriteria.clXSpacing.optimum
       --return
   endif
   !this.meStrTwrEngine.setXLength(!this.txXLengthStrTwr.val)
  else
   !this.meStrTwrEngine.setXLength(!this.opXLengthStrTwr.selection().real())
  endif

  -- check statement for stair tower y length
  if ( !this.opYLengthStrTwr.dText.empty() ) then
   if(!this.txYLengthStrTwr.val.leq(!this.txCLYSpacingStrTwr.val))then

     if(!gadget.name() eq 'TXYLENGTHSTRTWR') then
      !!alert.message('Tower Y Length Value should be greater than CL spacing Y of Stair Flight / Stair Landing')
      !!alert.message('Resetting $!gadget.tag Value to Optimum Value')
     else
      !!alert.message('Tower CL spacing Y Value should be Lesser than Tower Y Length of Stair Flight / Stair Landing')
      !!alert.message('Resetting $!gadget.tag Value to Optimum Value')
     endif

     !this.txYLengthStrTwr.val = !this.meStrTwrEngine.strTwrCriteria.width.optimum
     !this.txCLYSpacingStrTwr.val = !this.meStrTwrEngine.strTwrCriteria.clYSpacing.optimum
       --return
    endif
   !this.meStrTwrEngine.setYLength(!this.txYLengthStrTwr.val)
  else
   !this.meStrTwrEngine.setYLength(!this.opYLengthStrTwr.selection().real())
  endif

  -- check statement for Stair tower height
  if ( !this.opZLengthStrTwr.dText.empty() ) then
    !this.meStrTwrEngine.setZLength(!this.txZLengthStrTwr.val)
  else
    !this.meStrTwrEngine.setZLength(!this.opZLengthStrTwr.selection().real())
  endif

  -- check statement for stair flight thickness
  if (!this.opFThicknessStrTwr.dText.empty()) then
   !this.meStrTwrEngine.setStrFltThk(!this.txFThicknessStrTwr.val)
  else
   !this.meStrTwrEngine.setStrFltThk(!this.opFThicknessStrTwr.selection.real())
  endif

  -- check statement for stair flight width
  if ( !this.opStrFltWidthStrTwr.dText.empty() ) then
    !this.meStrTwrEngine.setStrFltWidth(!this.txStrFltWidthStrTwr.val)
  else
    !this.meStrTwrEngine.setStrFltWidth(!this.opStrFltWidthStrTwr.selection().real())
  endif

  -- check statement for stair flight pitch
  if ( !this.opStrFltPitchStrTwr.dText.empty() ) then
    !this.meStrTwrEngine.setStrFltPitch(!this.txStrFltPitchStrTwr.val)
  else
    !this.meStrTwrEngine.setStrFltPitch(!this.opStrFltPitchStrTwr.selection().real())
  endif

  -- check statement for CLXSpacing
  if ( !this.opCLXSpacingStrTwr.dText.empty() ) then
    !this.meStrTwrEngine.setCLXSpacing(!this.txCLXSpacingStrTwr.val)
  else
    !this.meStrTwrEngine.setCLXSpacing(!this.opCLXSpacingStrTwr.selection().real())
  endif

  -- check statement for CLYSpacing
  if ( !this.opCLYSpacingStrTwr.dText.empty() ) then
    !this.meStrTwrEngine.setCLYSpacing(!this.txCLYSpacingStrTwr.val)
  else
    !this.meStrTwrEngine.setCLYSpacing(!this.opCLYSpacingStrTwr.selection().real())
  endif

  --set the stair tower sense direction
  !this.meStrTwrEngine.setClockwise(!this.toClockwiseStrTwr.val)

  --setting the position and orientation of the stair tower
  !this.meStrTwrEngine.setPosition(object POSITION('E' & !this.strTwrPosControl.xyz()[0] & ' N' & !this.strTwrPosControl.xyz()[1] & ' U' & !this.strTwrPosControl.xyz()[2]))
  !this.meStrTwrEngine.setOrientation(object ORIENTATION('Y IS ' & !this.meStrTwrEngine.strTwrData.prmDirection & ' AND Z IS U'))

  -- position and orientation must be updated immediately
  !reference = !this.meStrTwrEngine.getRefe()
  if (!reference.badRef().not() ) then
    !reference.position     = !this.meStrTwrEngine.getPosition()
    !reference.prmDirection = !this.meStrTwrEngine.getOrientation().yDir()
  endif

  --updates the general attributes for the stair tower when attributes are changed
  !this.meStrTwrEngine.modifyDefaults(!gadget)

  --Evaluation for generating the stair tower Preview (means quick preview)
  !this.evaluateStrTwrPreview()

  --enables the reevaluate stair tower link in the ASLMAIN form
  --!this.lkReEvaluateStrTwr.active = true
  !undo.endundoable()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyStrTwrTmplReference
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyStrTwrTmplReference(!gadget is GADGET, !action is STRING)

  --set the reference to the central template

  !strFltTmplReference = !this.opStrFltTmplReferenceStrTwr.selection().dbRef()
  !strLngTmplReference = !this.opStrLngTmplReferenceStrTwr.selection().dbRef()
  !handRaTmplReference = !this.opHandRaTmplReferenceStrTwr.selection().dbRef()

  !this.meStrTwrEngine.setTmplReferences(!strFltTmplReference, !strLngTmplReference, !handRaTmplReference)

  -- combines general and fabricator standard
  !this.meStrTwrEngine.mergeCriteria()

  -- redefine min max
  !this.updateLimitsStrTwr()

  -- standard modify method
  !this.modifyStrTwr(!gadget, !action)

endmethod
-- End of method

------------------------------------------------------------------------
