------------------------------------------------------------------------

define method .reEvaluateHandRa()

  -- sets the criteria
  !this.meHandRaEngine.setCriteria()

  -- sets the reference to the central template
  !this.meHandRaEngine.setSettingReference()

  -- combines general and fabricator standard
  !this.meHandRaEngine.mergeCriteria()

  -- update the catalogue options for the new selection
  !this.updateCataOptionsHandRa()

  -- update the limits of the gadgets
  !this.updateLimitsHandRa()

  -- create the handrail
  !this.meHandRaEngine.updateDB()

  -- updates the aid dimension elements
  !this.showDimFeedbackHandRa(object GADGET(), '')

endmethod
