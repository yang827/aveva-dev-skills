------------------------------------------------------------------------

define method .selectOpeningsPltFrm(!rows is ARRAY)

  !this.lkDeleteOpeningsPltFrm.active = !rows[0].empty().not()
  !this.lkMergeOpeningsPltFrm.active  = !rows[0].size().gt(1)
  !this.lkModifyOpeningsPltFrm.active = !rows[0].size().eq(1)
  !this.lkAidOpeningsPltFrm.active    = !rows[0].size().eq(1)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      senseStrTwr
--
-- Description: open callback from install option gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .senseStrTwr(!gadget is GADGET, !action is STRING)

  !this.ceValidCheck()

  -- get the respective toggle gadget
  !toggleGadget = !this.attribute('TO' & !gadget.name().subString(3))
--  !labelGadget  = !this.attribute('LK' & !gadget.name().subString(3))

  -- if toggle is already switched on then return
  if ( !gadget.neq(!toggleGadget) and $
       !toggleGadget.val          or  $
       !gadget.eq(!toggleGadget)  and $
       !action.eq('UNSELECT') ) then
    !toggleGadget.val     = true
    return
  endif

  -- Setting the installation sense attribute for toggle change
  if (!gadget.name() inset ('TOCLOCKWISESTRTWR' , 'LKCLOCKWISESTRTWR')) then
    !!ce.intsen = TRUE
  elseif(!gadget.name() inset ('TOANTICLOCKWISESTRTWR' , 'LKANTICLOCKWISESTRTWR')) then
    !!ce.intsen = FALSE
  endif

  -- switch off all sense option toggle gadgets
  !this.toClockwiseStrTwr.val     = false
  !this.toAntiClockwiseStrTwr.val = false

  -- switch on the toggle gadget
  !toggleGadget.val = true
  !this.modifyStrTwr(object GADGET(), '')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLocksStrSet
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLocksStrSet(!gadget is GADGET, !action is STRING)

  -- for lock buttons only set the value without recalculating
  !attributeName = !gadget.name().subString(3).subString(-7) & 'LOCK'
  !segmentIdx    = !this.nuSegmentStrSet.val
  !this.meStrSetEngine.setLock(!attributeName, !gadget.val, !segmentIdx)

  -- reset the tooltips
  !this.updateFrameStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setMainAttributesStrSet
--
-- Description: sets the main attributes of the stair set
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setMainAttributesStrSet()

    -- evaluate the stair set
  !this.evaluateStrSet()

  -- create the stair flight
  !this.meStrSetEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- reset the tooltips
  !this.updateFrameStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPickLadder
--
-- Description: define pick from EDGPICK
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      'TOP' or 'BOTTOM'
--    1   R      EDGPICK     the pick data
-- Return:
--   [Data Type] [Description]

------------------------------------------------------------------------

define method .setPickLadder(!topBottom is STRING, !pickData is EDGPICKDATA)

  if ( !topBottom.eq('BOTTOM') ) then
    !this.meLadderEngine.setLPosData(!pickData)
  elseif ( !topBottom.eq('TOP') ) then
    !this.meLadderEngine.setUPosData(!pickData)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPickStrSet
--
-- Description: define pick from EDGPICK
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      'TOP' or 'BOTTOM'
--    2   R      EDGPICK     the pick data
-- Return:
--   [Data Type] [Description]

------------------------------------------------------------------------

define method .setPickStrSet(!topBottom is STRING, !pickData is EDGPICKDATA)

  if ( !topBottom.eq('BOTTOM') ) then
    !this.meStrSetEngine.setLPosData(!pickData)
  elseif ( !topBottom.eq('TOP') ) then
    !this.meStrSetEngine.setUPosData(!pickData)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: setup
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setup()

   !this.updateCoordinateSystem()

  -- initialise stair tower data object
  !this.meStrTwrEngine.strTwrData  = object ASLSTRTWRDATA()

  -- make frames active / inactive
  !this.frameChange(!this.frMain)

  -- init the form for stair sets
  !this.rtExplicitStrSet.val = false
  !this.rtOptimumStrSet.val  = true

  -- updates the limits
  !this.updateLimitsHandRa()
  !this.updateLimitsLadder()
  !this.updateLimitsPltFrm()
  !this.updateLimitsStrSet()
  !this.updateLimitsStrTwr()
  !this.updateLimitsWWay()

endmethod
-- End of method

----------------------------------------------------
--
-- Method:      showDimFeedbackHandRa
--
-- Description: callback from view gadgets
--              set/unset all dimensions regarding value of  view gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimFeedbackHandRa(!gadget is GADGET, !action is STRING)

  if ( !gadget.set() and $
       !gadget.eq(!this.lkAidAccessHandRa) ) then

    if ( !this.lkAidAccessHandRa.tag.eq('Display') ) then
      !this.lkAidAccessHandRa.tag = 'Hide'

    elseif ( !this.lkAidAccessHandRa.tag.eq('Hide') ) then
      !this.lkAidAccessHandRa.tag = 'Display'
    endif
  endif

  -- removes the old aid elements
  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()

  -- draws the gates
  if ( !this.lkAidAccessHandRa.tag.eq('Hide') ) then
    !this.meHandRaEngine.drawAccess()
  endif

endmethod
-- End of method

----------------------------------------------------
--
-- Method:      showDimFeedbackLadder
--
-- Description: callback from view gadgets
--              set/unset all dimensions regarding value of  view gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimFeedbackLadder(!gadget is GADGET, !action is STRING)

  if ( !gadget.set() and $
       !gadget.eq(!this.lkAidAccessLadder) ) then
    if ( !this.lkAidAccessLadder.tag.eq('Display dimensions') ) then
      !this.lkAidAccessLadder.tag = 'Hide dimensions'
    elseif ( !this.lkAidAccessLadder.tag.eq('Hide dimensions') ) then
      !this.lkAidAccessLadder.tag = 'Display dimensions'
    endif
  endif

  -- fill the dimension object, depends on the form toggles
  !ladderDimension               = object ASLLADDERDIM()
  !ladderDimension.cageOffset    = !this.toAidCageOffsetLadder.val
  !ladderDimension.cageSize      = !this.toAidCageSizeLadder.val
  !ladderDimension.extension     = !this.toAidExtensionLadder.val
  !ladderDimension.headroom      = !this.toAidheadroomLadder.val
  !ladderDimension.height        = !this.toAidHeightLadder.val
  !ladderDimension.lRise         = !this.toAidLRiseLadder.val
  !ladderDimension.footroom      = !this.toAidFootroomLadder.val
  !ladderDimension.pitch         = !this.toAidPitchLadder.val
  !ladderDimension.rise          = !this.toAidRiseLadder.val
  !ladderDimension.stringerDist  = !this.toAidStringerDistLadder.val
  !ladderDimension.stringerThn   = !this.toAidStringerThnLadder.val
  !ladderDimension.width         = !this.toAidWidthLadder.val
  !ladderDimension.gates         = !this.lkAidAccessLadder.tag.neq('Display side exit dimensions')
  !this.meLadderEngine.ladderDim = !ladderDimension

    -- removes the old aid elements
  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()

  if ( !this.lkAidAccessLadder.tag.eq('Hide dimensions') ) then
  !this.meLadderEngine.showDimFeedback()
  endif

endmethod
-- End of method

----------------------------------------------------
--
-- Method:      showDimFeedbackPltFrm
--
-- Description: callback from view gadgets
--              set/unset all dimensions regarding value of  view gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimFeedbackPltFrm(!gadget is GADGET, !action is STRING)

  if ( !gadget.set() ) then

    -- access
    if ( !gadget.eq(!this.lkAidAccessPltFrm) ) then
      if ( !this.lkAidAccessPltFrm.tag.eq('Display') ) then
        !this.lkAidAccessPltFrm.tag = 'Hide'

      elseif ( !this.lkAidAccessPltFrm.tag.eq('Hide') ) then
        !this.lkAidAccessPltFrm.tag = 'Display'
      endif
    endif

    -- opening
    if ( !gadget.eq(!this.lkAidOpeningsPltFrm) ) then
      if ( !this.lkAidOpeningsPltFrm.tag.eq('Display') ) then
        !this.lkAidOpeningsPltFrm.tag = 'Hide'

      elseif ( !this.lkAidOpeningsPltFrm.tag.eq('Hide') ) then
        !this.lkAidOpeningsPltFrm.tag = 'Display'
      endif
    endif
  endif

  -- removes the old aid elements
  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()

  -- draws the access points
  if ( !this.lkAidAccessPltFrm.tag.eq('Hide') ) then
    !this.mePltFrmEngine.drawAccess()
  endif

  -- draws the openings
  if ( !this.lkAidOpeningsPltFrm.tag.eq('Hide') ) then
    !this.mePltFrmEngine.drawOpenings()
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showDimFeedbackStrSet
--
-- Description: callback from view gadgets
--              set/unset all dimensions regarding value of  view gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimFeedbackStrSet(!gadget is GADGET, !action is STRING)

  -- fill the dimension object, depends on the form toggles
  !strSetDimension               = object ASLSTRSETDIM()
  !strSetDimension.clearance     = !this.toAidClearanceStrSet.val
  !strSetDimension.fThickness    = !this.toAidFThicknessStrSet.val
  !strSetDimension.going         = !this.toAidGoingStrSet.val
  !strSetDimension.length        = !this.toAidLengthStrSet.val
  !strSetDimension.lExtension    = !this.toAidLExtensionStrSet.val
  !strSetDimension.lRise         = !this.toAidLRiseStrSet.val
  !strSetDimension.pitch         = !this.toAidPitchStrSet.val
  !strSetDimension.oGoing        = !this.toAidOGoingStrSet.val
  !strSetDimension.oRise         = !this.toAidORiseStrSet.val
  !strSetDimension.rise          = !this.toAidRiseStrSet.val
  !strSetDimension.width         = !this.toAidWidthStrSet.val
  !strSetDimension.uExtension    = !this.toAidUExtensionStrSet.val
  !strSetDimension.uRise         = !this.toAidURiseStrSet.val
  !this.meStrSetEngine.strSetDim = !strSetDimension

  !segmentIdx                    = !this.nuSegmentStrSet.val.max(1)

  !this.meStrSetEngine.showDimFeedback(!segmentIdx)

endmethod
-- End of method

------------------------------------------------------------------------
