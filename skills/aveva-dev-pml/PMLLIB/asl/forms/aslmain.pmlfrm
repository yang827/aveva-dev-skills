define method .selectCataOptionsHandRa()

  !handRaTmplReference = !this.meHandRaEngine.getTmplReference()
  if ( !this.opHandRaTmplReferenceHandRa.rText.findFirst(!handRaTmplReference.string()).set() ) then
    !this.opHandRaTmplReferenceHandRa.select('RTEXT', !handRaTmplReference.string())
    !this.opHandRaTmplReferenceHandRa.active = true
  elseif ( !handRaTmplReference.badRef().not() ) then
    -- stair was built from a different standard
    !dText[1]                                = !handRaTmplReference.description
    !rText[1]                                = !handRaTmplReference.string()
    !this.opHandRaTmplReferenceHandRa.dText  = !dText
    !this.opHandRaTmplReferenceHandRa.rText  = !rText
    !this.opHandRaTmplReferenceHandRa.active = false
  endif

