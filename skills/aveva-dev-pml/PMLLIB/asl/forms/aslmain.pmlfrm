------------------------------------------------------------------------
--
-- Method:      deleteHandRa
--
-- Description: delete handrail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deleteHandRa()

 !undo = object UNDOABLE()
 !undo.description('Delete handrail')
 !undo.add()

  -- check if you are below a HANDRA element
  HANDRA
  handle ANY
    !!alert.warning('Not below HANDRA hierarchy')
    return
  endhandle

  call !!aslEnhance(!!ce)
  if ( !!alert.confirm('Do you really want to delete the current handrail?').eq('NO') ) then
    call !!aslUnEnhance(!!ce)
    return
  endif

  DELETE HANDRA

  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()
  pml reload form !!aslHandRa
  !undo.endundoable()
endmethod
-- End of method

