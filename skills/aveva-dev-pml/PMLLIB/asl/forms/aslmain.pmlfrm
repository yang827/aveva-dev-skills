    -- position options
    ---------------------------------------------------------------------------
    frame .frPositionLadder FoldUp  'Position options' anchor T+L+R               width 36
      do !i to 10
        !iString = '0' & !i
        !iString = !iString.subString(-2, 2)
        button .toPosOptionLadder$!iString toggle    at x3   ymax pixmap callback '!this.posOptionLadder('                             width 16 height 16
        button .lkPosOptionLadder$!iString linklabel at xmax ymin ''     callback '!this.posOptionLadder('                             width 30
