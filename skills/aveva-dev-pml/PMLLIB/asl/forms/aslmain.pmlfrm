-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateLimitsLadder()

  call !!fillCriterionGadgets(!this.txHeightLadder,        !this.opHeightLadder, !this.meLadderEngine.ladderCriteria.oRise)
  call !!fillCriterionGadgets(!this.txWidthLadder,         !this.opWidthLadder,  !this.meLadderEngine.ladderCriteria.width)
  call !!fillCriterionGadgets(!this.txPitchLadder,         !this.opPitchLadder,  !this.meLadderEngine.ladderCriteria.pitch)
  call !!fillCriterionGadgets(!this.txRiseLadder,          !this.opRiseLadder,   !this.meLadderEngine.ladderCriteria.rise)
  call !!fillCriterionGadgets(!this.txLRiseLadder,         object GADGET(),      !this.meLadderEngine.ladderCriteria.lRise)
  call !!fillCriterionGadgets(!this.txExtensionLadder,     object GADGET(),      !this.meLadderEngine.ladderCriteria.extension)
  call !!fillCriterionGadgets(!this.txRungsLadder,         object GADGET(),      !this.meLadderEngine.ladderCriteria.rungs)
  call !!fillCriterionGadgets(!this.txheadroomLadder,      object GADGET(),      !this.meLadderEngine.ladderCriteria.headroom)
  call !!fillCriterionGadgets(!this.txFootroomLadder,      object GADGET(),      !this.meLadderEngine.ladderCriteria.footroom)
  call !!fillCriterionGadgets(!this.txCageOffsetLadder,    object GADGET(),      !this.meLadderEngine.ladderCriteria.cageOffset)
  call !!fillCriterionGadgets(!this.txCageSizeLadder,      object GADGET(),      !this.meLadderEngine.ladderCriteria.cageSize)
  call !!fillCriterionGadgets(!this.txStringerDistLadder,  object GADGET(),      !this.meLadderEngine.ladderCriteria.stringerDist)

