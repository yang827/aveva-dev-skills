-----------------------------------------------------------------------
--
-- Method:      secondPickLadderReturn
--
-- Description: Derive ladder from returned pick data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA      Second pick
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .secondPickLadderReturn(!pickData is EDGPICKDATA)

  -- update the catalogue options
  -- update the option gadget if reEvaluate
  if ( !this.lkreEvaluateLadder.visible or $
       !this.opLadderTmplReferenceLadder.dText.empty() ) then
    !this.updateCataOptionsLadder()
  endif

  -- set the picks in the object (top or bottom)
  !this.setPickLadder('TOP', !pickData)

  -- evaluate the picks and create the ladder
  !this.evaluatePicksLadder()

endmethod
-- End of method

