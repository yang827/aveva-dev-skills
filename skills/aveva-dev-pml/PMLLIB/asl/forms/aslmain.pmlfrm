------------------------------------------------------------------------
--
-- Method:      pickLadder
--
-- Description: Invoke EDG pick
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pickLadder()

  -- defines packet
  !packet                            = object EDGPACKET()
  !packet.pickPacket.prompt          = 'Ladder'

  -- defines first pick
  !packet.pickPacket.picks[1]        = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdGraphics('Start')

  -- defines second pick and defines prompt
  !packet.pickPacket.picks[2]        = !packet.pickPacket.picks[1]
  !packet.pickPacket.picks[2].prompt = ('End')

  -- define actions on first pick
  !packet.pickPacket.picks[1].action = '!!aslMain.firstPickLadderReturn(!this.return[1])'

  -- defines action on pick completion
  !packet.action                     = '!!aslMain.secondPickLadderReturn(!this.return[1][2])'

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickStrSet
--
-- Description: Invoke EDG pick
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pickStrSet(!gadget is GADGET, !action is STRING)

  !packet                   = object EDGPACKET()

  -- pick stair flight
  if ( !gadget.eq(!this.lkPickStrSet) ) then
    -- defines packet
    !packet.pickPacket.prompt = 'Stair flight'

    -- defines first pick
    !packet.pickPacket.picks[1] = object EDGPICKTYPE()
    !packet.pickPacket.picks[1].stdGraphics('Start')

    -- defines second pick and defines prompt
    !packet.pickPacket.picks[2]        = !packet.pickPacket.picks[1]
    !packet.pickPacket.picks[2].prompt = ('End')

    -- define actions on first pick
    !packet.pickPacket.picks[1].action = '!!aslMain.firstPickStrSet(!this.return[1])'

    -- defines action on pick completion
    !packet.action                     = '!!aslMain.secondPickStrSet(!this.return[1][2])'

  endif

  --set the description
  !packet.description = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      posOptionLadder
--
-- Description: open callback from install option gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .posOptionLadder(!gadget is GADGET, !action is STRING)

  -- get the respective toggle gadget
  !toggleGadget = !this.attribute('TO' & !gadget.name().subString(3))
  !labelGadget  = !this.attribute('LK' & !gadget.name().subString(3))

  -- if toggle is already switched on then return
  if ( !gadget.neq(!toggleGadget) and $
       !toggleGadget.val          or  $
       !gadget.eq(!toggleGadget)  and $
       !action.eq('UNSELECT') ) then
    !toggleGadget.val     = true
    return
  endif

  -- switch off all install option toggle gadgets
  do !i to 10
    !iString = '0' & !i
    !iString = !iString.subString(-2, 2)
    !this.attribute('TOPOSOPTIONLADDER' & !iString).val = false
  enddo

  -- switch on the toggle gadget
  !toggleGadget.val     = true
  !this.meLadderEngine.setPositionOption(!labelGadget.tag)
  !this.txPosOriginLadder.val     = 'world'

  !this.updateLadderPositionGadgets()
  -- recalculate the stair flight
  !this.evaluateLadder()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      posOptionStrSet
--
-- Description: open callback from install option gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .posOptionStrSet(!gadget is GADGET, !action is STRING)

  -- get the respective toggle gadget
  !toggleGadget = !this.attribute('TO' & !gadget.name().subString(3))
  !labelGadget  = !this.attribute('LK' & !gadget.name().subString(3))

  -- if toggle is already switched on then return
  if ( !gadget.neq(!toggleGadget) and $
       !toggleGadget.val          or  $
       !gadget.eq(!toggleGadget)  and $
       !action.eq('UNSELECT') ) then
    !toggleGadget.val     = true
    return
  endif

--  -- switch off all install option toggle gadgets
--  do !i to 5
--    !this.attribute('TOLPOSOPTIONSTRSET' & !i).val = false
--    !this.attribute('TOUPOSOPTIONSTRSET' & !i).val = false
--  enddo

  -- switch on the toggle gadget
  !toggleGadget.val     = true
  if ( !gadget.name().subString(3, 1).eq('L') ) then
    !this.meStrSetEngine.setLPositionOption(!labelGadget.tag)
  else
    !this.meStrSetEngine.setUPositionOption(!labelGadget.tag)
  endif

  !this.txLPosOriginStrSet.val = 'world'
  !this.txUPosOriginStrSet.val = 'world'

  -- evaluates the access point positions projected onto the stair flight plane
  !this.evaluateAccessPointPositionsStrSet()

  -- recalculate the stair flight
  !this.evaluateStrSet()

  -- create the stair flight
  !this.meStrSetEngine.updateDB()

  -- remove the aid lines and make the build button inactive
  !!aslCentralData.clearVolFeedback()

  -- update the gadgets
  !this.updateFrameStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reEvaluateHandRa
--
-- Description: reEvaluates the data according to the setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
