------------------------------------------------------------------------
--
-- Method:      singlePickLadder
--
-- Description: Invoke EDG pick (only bottom pick)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      event
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .singlePickLadder(!gadget is GADGET, !event is STRING)

  -- defines packet
  !packet                            = object EDGPACKET()
  !packet.pickPacket.prompt          = 'Ladder'

  -- defines first pick
  !packet.pickPacket.picks[1]        = object EDGPICKTYPE()

  if ( !gadget.eq(!this.lkPickLadderBottom) ) then
    !packet.pickPacket.picks[1].stdGraphics('Repick bottom')

    -- defines action on pick completion
    !packet.action                   = '!!aslMain.singlePickLadderReturn(!this.return[1], |BOTTOM|)'
  else
    !packet.pickPacket.picks[1].stdGraphics('Repick top')

    -- defines action on pick completion
    !packet.action                   = '!!aslMain.singlePickLadderReturn(!this.return[1], |TOP|)'
  endif

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      singlePickLadderReturn
--
-- Description: Derive ladder from returned pick data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA      Second pick
--    2   R      STRING           'TOP', 'BOTTOM'
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .singlePickLadderReturn(!pickData is EDGPICKDATA, !topBottom is STRING)

  -- set the picks in the data object (top or bottom)
  !this.setPickLadder(!topBottom, !pickData)

  -- evaluate the picks and create the ladder
  !this.evaluatePicksLadder()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      singlePickStrSet
--
-- Description: Invoke EDG pick (only bottom pick)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      event
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .singlePickStrSet(!gadget is GADGET, !event is STRING)

  -- defines packet
  !packet                     = object EDGPACKET()
  !packet.pickPacket.prompt   = 'Stair'

  -- defines first pick
  !packet.pickPacket.picks[1] = object EDGPICKTYPE()

  -- repick bottom of stair set
  if ( !gadget.eq(!this.lkPickStrSetBottom) ) then
    !packet.pickPacket.picks[1].stdGraphics('Repick bottom of set of stair flights')

    -- defines action on pick completion
    !packet.action            = '!!aslMain.singlePickStrSetReturn(!this.return[1], |BOTTOM|)'

  -- repick top of stair set
  elseif ( !gadget.eq(!this.lkPickStrSetTop) ) then
    !packet.pickPacket.picks[1].stdGraphics('Repick top of set of stair flights')

    -- defines action on pick completion
    !packet.action            = '!!aslMain.singlePickStrSetReturn(!this.return[1], |TOP|)'
  endif

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      singlePickStrSetReturn
--
-- Description: Derive stair from returned pick data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA      Second pick
--    2   R      STRING           'TOP', 'BOTTOM'
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .singlePickStrSetReturn(!pickData is EDGPICKDATA, !topBottom is STRING)

  -- set the picks in the data object (top or bottom)
  !this.setPickStrSet(!topBottom, !pickData)

  -- evaluate the picks and create the stair
  !this.evaluatePicksStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: ce-tracker
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .track()

  -- only when the main frame is visible
  if ( !this.frMain.visible.not() ) then
    return
  endif

  -- check whether a stair tower could be created
  !newStrTwrFlag       = !this.trackCheck('STRTWR')
  !newStrSetFlag       = !this.trackCheck('STRFLT')
  !newLadderFlag       = !this.trackCheck('LADDER')
  !newHandRaFlag       = !this.trackCheck('HANDRA')
  !newPltFrmFlag       = !this.trackCheck('PLTFRM')
--  !newWWayFlag         = !this.trackCheck('WWAY')
--TODO: switch to the correct type STRLNG -> WWAY
--  !newWWayFlag         = !this.trackCheck('STRLNG')

--TODO: Just a temporary get round for database bug re .ahList
if (type eq 'WORL' or type of owner eq 'WORL') then
  !ownerList  = ARRAY()
else
  !ownerList  = !!ce.ahList
endif
  !ownerList.append(!!ce.type)
  !strTwrFlag = !ownerList.findFirst('STRTWR').set()
  !strSetFlag = !ownerList.findFirst('STRFLT').set()
  !ladderFlag = !ownerList.findFirst('LADDER').set()
  !handRaFlag = !ownerList.findFirst('HANDRA').set()
  !pltFrmFlag = !ownerList.findFirst('PLTFRM').set()
--  !wWayFlag   = !ownerList.findFirst('WWAY').set()
--TODO: switch to the correct type STRLNG -> WWAY
--  !wWayFlag   = !ownerList.findFirst('STRLNG').set()

  -- make the gadgets active / inactive
  --!this.paCreateMain.active       = !newStrSetFlag or $
  --                                  !newStrTwrFlag or $
  --                                  !newLadderFlag or $
  --                                  !newHandRaFlag or $
  --                                  !newPltFrmFlag or $
  --                                  !newWWayFlag
  !this.lkCreateStrSet.active     = !newStrSetFlag
  !this.lkCreateStrTwr.active     = !newStrTwrFlag
  !this.lkCreateLadder.active     = !newLadderFlag
  !this.lkCreateHandRa.active     = !newHandRaFlag
  !this.lkCreatePltfrm.active     = !newPltFrmFlag
--TODO: activate WWay gadgets
--  !this.lkCreateWWay.active       = !newWWayFlag

  --!this.paModifyMain.active       = !strSetFlag or $
  --                                  !strTwrFlag or $
  --                                  !ladderFlag or $
  --                                  !handRaFlag or $
  --                                  !pltFrmFlag or $
  --                                  !wWayFlag

  -- Modification of Stair flight is not yet implemented. Hence this link is disabled.
  -- Modifying stair flight immediately after creation will work.
  --!this.lkModifyStrSet.active     = !strSetFlag or $
  --                                  !strTwrFlag
  !this.lkModifyStrSet.active     = false
  !this.lkModifyStrTwr.active     = !strTwrFlag
  !this.lkModifyLadder.active     = !ladderFlag
  !this.lkModifyHandRa.active     = !handRaFlag
  !this.lkModifyPltFrm.active     = !pltFrmFlag
--TODO: activate WWay gadgets
--  !this.lkModifyWWay.active       = !wWayFlag

  --!this.paDeleteMain.active       = !strSetFlag or $
  --                                  !strTwrFlag or $
  --                                  !ladderFlag or $
  --                                  !handRaFlag or $
  --                                  !pltFrmFlag or $
  --                                  !wWayFlag
  !this.lkDeleteStrSet.active     = !strSetFlag or $
                                    !strTwrFlag
  !this.lkDeleteStrTwr.active     = !strTwrFlag
  !this.lkDeleteLadder.active     = !ladderFlag
  !this.lkDeleteHandRa.active     = !handRaFlag
  !this.lkDeletePltFrm.active     = !pltFrmFlag
--TODO: activate WWay gadgets
--  !this.lkDeleteWWay.active       = !wWayFlag

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      trackCheck
--
-- Description: check whether a certain element can be created
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      type of element to be created
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     flag
------------------------------------------------------------------------

define method .trackCheck(!type is STRING) is BOOLEAN

  -- check whether a stair tower could be created
  !flag             = false
  !referenceElement = !!ce
  do !i
    break if ( !referenceElement.type.eq('WORL') )

    if ( !referenceElement.list.findFirst(!type).set() ) then
      !flag = true
      break
    endif
    !referenceElement = !referenceElement.owner
  enddo

  return !flag

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateAccessHandRa
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateAccessHandRa()

  using namespace  'Aveva.Pdms.Presentation'

  !posFmt     = !!distanceFmt
  !posFmt.dp  = 0

  --set the headings of the access-list
  !heading[1] = 'No'
  !heading[2] = 'Arrive Offset'
  !heading[3] = 'Leave Offset'

  !title      = 'Access Points'

  !allGates   = !this.meHandRaEngine.getGates()
--  !handRaRefe = !this.meHandRaEngine.getRefe()
  !columns    = object ARRAY()
  do !i index !allGates
    !gate        = !allGates[!i]
    !columns[!i] = object ARRAY()
    !columns[!i].append(!i.string())
    !columns[!i].append(!gate.arriveOffset.string())
    !columns[!i].append(!gate.leaveOffset.string())
  enddo

  !netDataSource = object NETDATASOURCE(!title, !heading, !columns)
  !this.neAccessHandRa.bindToDataSource(!netDataSource)

  !this.lkDeleteAccessHandRa.active = false
  !this.lkFlipAccessHandRa.active   = false
  !this.lkPickAccessHandRa.active   = false
  !this.lkAidAccessHandRa.active    = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateAccessLadder
--
-- Description: update the grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAccessLadder()

  -- use the .NET library
  using namespace  'Aveva.Pdms.Presentation'
  !this.neAccessLadder.clearGrid()

  !posFmt     = !!distanceFmt
  !posFmt.dp  = 0

  -- the title of the exit list
  !title      = 'Side exits'

  --set the headings of the exit list
  !heading    = object ARRAY()
  !heading.append('No.')
  !heading.append('Elevation')
  !heading.append('Exit type')
  !heading.append('headroom')
  !heading.append('Distance to prev cage')

  -- collect the data
  !allExits   = !this.meLadderEngine.getSideExits()
  !columns    = object ARRAY()
  do !i index !allExits
    !sideExit    = !allExits[!i]
    !columns[!i] = object ARRAY()

    -- column1 ,Index no.
    !columns[!i].append(!i.string())

    -- column2, elevation
    !columns[!i].append(!sideExit.elevation.string(!posFmt))

    -- column3, exit types
    if ( !sideExit.exitType.eq('BACK') ) then
      !columns[!i].append('Back')
    elseif ( !sideExit.exitType.eq('LEFT') ) then
      !columns[!i].append('Left')
    elseif ( !sideExit.exitType.eq('RIGH') ) then
      !columns[!i].append('Right')
    else
      !columns[!i].append('Left&Right')
    endif

    -- column4, headroom
    !columns[!i].append(!sideExit.headroom.string())

    -- column5, distance to previous cage
    !columns[!i].append(!sideExit.distancePrevCage.string())
  enddo

  -- fill the grid
  !netDataSource = object NETDATASOURCE(!title, !heading, !columns)
  !this.neAccessLadder.bindToDataSource(!netDataSource)

  -- the following syntaxes must be carried out after the list has been filled!
  ---------------------------------------------------------------------------
  -- exit types
  !this.neAccessLadder.assignValueListToColumn('ExitTypes', 3)

  !this.lkDeleteAccessLadder.active = false
  !this.lkPickAccessLadder.active   = false

endmethod
-- End of method

