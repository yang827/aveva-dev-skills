--    1   R      EDGPICKDATA      Second pick
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .secondPickStrSet(!pickData is EDGPICKDATA)

  -- update the catalogue options
  -- update the option gadget if reEvaluate
  if ( !this.lkreEvaluateStrSet.active or $
       !this.opStrFltTmplReferenceStrSet.dText.empty() ) then
    !this.updateCataOptionsStrSet()
  endif

  -- set the picks in the object (top or bottom)
  !this.setPickStrSet('TOP', !pickData)

  -- evaluate the picks and create the stair
  !this.evaluatePicksStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectAccessHandRa
--
-- Description: control for active/inactive of access gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      the selected rows
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectAccessHandRa(!rows is ARRAY)

  !this.lkDeleteAccessHandRa.active = !rows[0].empty().not()
  !this.lkFlipAccessHandRa.active   = !rows[0].size().eq(1)
  !this.lkPickAccessHandRa.active   = !rows[0].size().eq(1)
  !this.lkAidAccessHandRa.active    = !rows[0].size().eq(1)

endmethod
-- End of method

