    !allCataElements = !!aslCentralData.currSetting.collectAll(!elementType)
    do !cataElement value !allCataElements
      !dText.append(!cataElement.description)
      !rText.append(!cataElement.string())
    enddo
    !gadgetName = 'OP' & !elementType & 'TMPLREFERENCEWWAY'
    !this.attribute(!gadgetName).dText = !dText
    !this.attribute(!gadgetName).rText = !rText
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateExplicitGadgetsStrSet
--
-- Description: Derive valid from pick data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateExplicitGadgetsStrSet(!segmentIdx is REAL)

  -- evaluates the position options
  !validTreads      = !this.meStrSetEngine.getValidTreads(!segmentIdx)

  -- fills the gadget
  !dText = object ARRAY()
  do !treads value !validTreads
    !dText.append(!treads.string())
  enddo
  !this.opTreadsStrSet.dText = !dText

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateFrameHandRa
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrameHandRa()

  !handRaData           = !this.meHandRaEngine.handRaData
  if ( !handRaData.unset() ) then
    return
  endif

  -- change the frames to the handrail frame
  !this.frameChange(!this.frMainWorkHandRa)

  -- updates/selects template(s)
  !this.updateCataOptionsHandRa()
  !this.selectCataOptionsHandRa()

  -- access points
  !this.updateAccessHandRa()

  -- update max/min
  !this.updateLimitsHandRa()

  -- update the rail spacing
  !this.updateRailSpacingHandRa()

  -- height
  if ( !this.opRailHeightHandRa.dText.empty() ) then
    !this.txRailHeightHandRa.val   = !this.meHandRaEngine.getRailHeight()
  else
    !this.opRailHeightHandRa.select('DTEXT', !this.meHandRaEngine.getRailHeight().string())
  endif

  -- post spacing
  if ( !this.opPostSpacingHandRa.dText.empty() ) then
    !this.txPostSpacingHandRa.val   = !this.meHandRaEngine.getPostSpacing()
  else
    !this.opPostSpacingHandRa.select('DTEXT', !this.meHandRaEngine.getPostSpacing().string())
  endif

  -- tangent spacing
  if ( !this.opTangentSpacingHandRa.dText.empty() ) then
    !this.txTangentSpacingHandRa.val   = !this.meHandRaEngine.getTangentSpacing()
  else
    !this.opTangentSpacingHandRa.select('DTEXT', !this.meHandRaEngine.getTangentSpacing().string())
  endif

  -- end spacing
  if ( !this.opEndSpacingHandRa.dText.empty() ) then
    !this.txEndSpacingHandRa.val   = !this.meHandRaEngine.getEndSpacing()
  else
    !this.opEndSpacingHandRa.select('DTEXT', !this.meHandRaEngine.getEndSpacing().string())
  endif

  -- radius
  !this.txRadiusHandRa.val = !this.meHandRaEngine.getRadius()

  -- access points
  !this.updateAccessHandRa()

  -- update the re-evaluate buttons
  !this.lkreEvaluateHandRa.active = !!aslCentralData.currSetting.description.neq(!this.meHandRaEngine.getSettingReference())

  -- updates the aid dimension elements
  !this.showDimFeedbackHandRa(object GADGET(), '')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateFrameLadder
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrameLadder()

  !this.ladder = !!ce
  !ladderData           = !this.meLadderEngine.ladderData
  if ( !ladderData.unset() ) then
    return
  endif

  -- update position direction
  !posFmt               = object FORMAT()
  !posFmt.dp            = 0

  -- change the frames to the ladder frame
  !this.frameChange(!this.frMainWorkLadder)

  ---------------------------------------------------------------------------
  -- type of top exit
  !this.opTopAccessTypeLadder.select('RTEXT', !this.meLadderEngine.getUExitType())

  -- overall Rise
  if ( !this.opHeightLadder.dText.empty() ) then
    !this.txHeightLadder.val   = !this.meLadderEngine.getORise()
  else
    !this.opHeightLadder.select('DTEXT', !this.meLadderEngine.getORise().string())
  endif

  -- overall Width
  if ( !this.opWidthLadder.dText.empty() ) then
    !this.txWidthLadder.val   = !this.meLadderEngine.getWidth()
  else
    !this.opWidthLadder.select('DTEXT', !this.meLadderEngine.getWidth().string())
  endif

  -- pitch
  if ( !this.opPitchLadder.dText.empty() ) then
    !this.txPitchLadder.val  = !this.meLadderEngine.getPitch()
  else
    !this.opPitchLadder.select('DTEXT', !this.meLadderEngine.getPitch().string())
  endif

  -- rise
  if ( !this.opRiseLadder.dText.empty() ) then
    !this.txRiseLadder.val  = !this.meLadderEngine.getRise()
  else
    !this.opRiseLadder.select('DTEXT', !this.meLadderEngine.getRise().string())
  endif

  -- detailed attributes
  !this.txCageOffsetLadder.val    = !this.meLadderEngine.getCageOffset()
  !this.txCageSizeLadder.val      = !this.meLadderEngine.getCageSize()
  !this.txExtensionLadder.val     = !this.meLadderEngine.getExtension()
  !this.txheadroomLadder.val      = !this.meLadderEngine.getheadroom()
  !this.txLRiseLadder.val         = !this.meLadderEngine.getLRise()
  !this.txFootroomLadder.val      = !this.meLadderEngine.getFootroom()
  !this.txRungsLadder.val         = !this.meLadderEngine.getRungs()
  !this.txStringerDistLadder.val  = !this.meLadderEngine.getStringerDist()
  !this.txStringerThnLadder.val   = !this.meLadderEngine.getStringerThn()

  ---------------------------------------------------------------------------
  -- cut planes
  !this.txDirLadder.val           = !this.meLadderEngine.getDirection().wrt(!this.txDirOriginLadder.val.dbRef()).string().before(' WRT')

  !currPositionOption             = !this.meLadderEngine.getPositionOption()
  !this.netLadderPositionFrame.active = !currPositionOption.matchwild('Explicit * position...')
  !this.txPosOriginLadder.visible = !currPositionOption.matchwild('Explicit * position...')
  !this.txDirLadder.visible       = !currPositionOption.eq('Explicit direction...')
  !this.txDirOriginLadder.visible = !currPositionOption.eq('Explicit direction...')

  --  !this.opLadderControlPoint.active = !ladderData.lPickType.eq(!ladderData.uPickType)
  if ( !currPositionOption.matchwild('*lower*') ) then
    !controlPos        = !this.meLadderEngine.getLWP().wrt(world)
  else
    !controlPos        = !this.meLadderEngine.getUWP().wrt(world)
  endif

  if ( !currPositionOption.matchwild('*Explicit*').not() ) then
   !this.ladderPosControl.xyz(!controlPos.east,!controlPos.north,!controlPos.up)
  endif

  -- update the options for the setting
  !this.updateCataOptionsLadder()
  !this.selectCataOptionsLadder()

  -- derive and show the position/installation/direction options
  !this.deriveOptionsLadder()

  -- access points
  !this.updateAccessLadder()

  -- show the dimensions
  !this.showDimFeedbackLadder(object GADGET(), '')

  -- update max/min
  !this.updateLimitsLadder()

  -- update the re-evaluate buttons
  !this.lkreEvaluateLadder.active = !!aslCentralData.currSetting.description.neq(!this.meLadderEngine.getSettingReference())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateFramePltFrm
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFramePltFrm()

  !pltFrmData           = !this.mePltFrmEngine.pltFrmData
  if ( !pltFrmData.unset() ) then
    return
  endif

  -- update position direction
  !posFmt               = object FORMAT()
  !posFmt.dp            = 0

  -- change the frames to the platform frame
  !this.frameChange(!this.frMainWorkPltFrm)

   -- updates/selects template(s)
  !this.updateCataOptionsPltFrm()
  !this.selectCataOptionsPltFrm()

  -- thickness
  if ( !this.opThicknessPltFrm.dText.empty() ) then
    !this.txThicknessPltFrm.val = !this.mePltFrmEngine.getHeight()
  else
    !this.opThicknessPltFrm.select('DTEXT', !this.mePltFrmEngine.getHeight().string())
  endif

  -- MJB Commented out justification gadget, so below code commented out too
  -- justification
  --if(!this.mePltFrmEngine.getJustification().empty().not())then
  --!this.opJustificationPltFrm.select('RTEXT', !this.mePltFrmEngine.getJustification())
  --else
    --!this.opJustificationPltFrm.select('RTEXT', 'BOTT')
  --endif

  -- access points
  !this.updateAccessPltFrm()

  -- openings
  !this.updateOpeningsPltFrm()

  -- update max/min
  !this.updateLimitsPltFrm()

  -- update the re-evaluate buttons
  !this.lkreEvaluatePltFrm.active = !!aslCentralData.currSetting.description.neq(!this.mePltFrmEngine.getSettingReference())

  -- updates the aid dimension elements
  !this.showDimFeedbackPltFrm(object GADGET(), '')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateFrameSegmentStrSet
--
-- Description: update the gadgets for the segment frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrameSegmentStrSet(!dummyGadget is GADGET, !dummyAction is STRING)

  !segmentIdx = !this.nuSegmentStrSet.val.max(1)

  -- extension
  !this.txLExtensionStrSet.val = !this.meStrSetEngine.getLExtension(!segmentIdx)
  !this.toLExtensionStrSet.val = !this.meStrSetEngine.getLock('LEXTENSIONLOCK', !segmentIdx)
  !this.txUExtensionStrSet.val = !this.meStrSetEngine.getUExtension(!segmentIdx)
  !this.toUExtensionStrSet.val = !this.meStrSetEngine.getLock('UEXTENSIONLOCK', !segmentIdx)

  -- overall going
  if ( !this.opOGoingStrSet.dText.empty() ) then
    !this.txOGoingStrSet.val = !this.meStrSetEngine.getOGoing(!segmentIdx)
  else
    !this.opOGoingStrSet.select(!this.meStrSetEngine.getOGoing(!segmentIdx).string())
  endif
  !this.toOGoingStrSet.val = !this.meStrSetEngine.getLock('OGOINGLOCK', !segmentIdx)

  -- pitch
  if ( !this.opPitchStrSet.dText.empty() ) then
    !this.txPitchStrSet.val = !this.meStrSetEngine.getPitch(!segmentIdx)
  else
    !this.opPitchStrSet.select(!this.meStrSetEngine.getPitch(!segmentIdx).string())
  endif
  !this.toPitchStrSet.val = !this.meStrSetEngine.getLock('PITCHLOCK', !segmentIdx)

  -- rise
  if ( !this.opRiseStrSet.dText.empty() ) then
    !this.txRiseStrSet.val = !this.meStrSetEngine.getRise(!segmentIdx)
  else
    !this.opRiseStrSet.select(!this.meStrSetEngine.getRise(!segmentIdx).string())
  endif
  !this.toRiseStrSet.val = !this.meStrSetEngine.getLock('RISELOCK', !segmentIdx)

  -- lrise
  !this.txLRiseStrSet.val = !this.meStrSetEngine.getLRise(!segmentIdx)

  -- urise
  !this.txURiseStrSet.val = !this.meStrSetEngine.getURise(!segmentIdx)

  -- clearance
  !this.txClearanceStrSet.val = !this.meStrSetEngine.getClearance(!segmentIdx)

  -- pitch
  if ( !this.opGoingStrSet.dText.empty() ) then
    !this.txGoingStrSet.val = !this.meStrSetEngine.getGoing(!segmentIdx)
  else
    !this.opGoingStrSet.select(!this.meStrSetEngine.getGoing(!segmentIdx).string())
  endif
  !this.toGoingStrSet.val = !this.meStrSetEngine.getLock('GOINGLOCK', !segmentIdx)

  !this.updateOptimumGadgetStrSet(!segmentIdx)
  !this.updateExplicitGadgetsStrSet(!segmentIdx)

  -- switch the radio gadgets
  if ( !this.rtExplicitStrSet.val or $
       !this.opOptimumStrSet.dText.empty() ) then
    !this.changeCalcMethodStrSet(!this.rtExplicitStrSet, '')
  else
    !this.changeCalcMethodStrSet(!this.rtOptimumStrSet, '')
  endif

  -- update the optimum gadget
  !numberOfTreads = !this.meStrSetEngine.getTreads(!segmentIdx).string()
  do !idx index !this.opOptimumStrSet.rText
    if ( !this.opOptimumStrSet.rText[!idx].before(';').eq(!numberOfTreads) ) then
      !this.opOptimumStrSet.val = !idx
    endif
  enddo

  -- number of treads
  !this.opTreadsStrSet.select('DTEXT', !numberOfTreads)
  !this.toTreadsStrSet.val = !this.meStrSetEngine.getLock('TREADSLOCK', !segmentIdx)

  -- enhance the current segment
  !segmentIdx = !this.nuSegmentStrSet.val
  !this.meStrSetEngine.enhance(!segmentIdx)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateFrameStrSet
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrameStrSet()

  if ( !this.meStrSetEngine.getError() ) then
    !!alert.warning('Unable to evaluate a valid stair flight with the current values.')
    !this.meStrSetEngine.resetError()
    -- resets the progress bar
    !!fmSys.setProgress(0)
    return
  endif

  if ( !!fmSys.progress().neq(0) ) then
    !!fmSys.setProgress(85)
  endif

  -- update position direction
  !posFmt    = object FORMAT()
  !posFmt.dp = 0

  -- the number of segments
  !numberOfSegments = !this.meStrSetEngine.getNumberOfSegments()

  -- number of stair Flights
  !this.frameChange(!this.frMainWorkStrSet)

  !this.lkreEvaluateStrSet.active = false

  -- update the options for the current setting
  if ( !!fmSys.progress().neq(0) ) then
    !!fmSys.setProgress(87)
  endif
  !this.updateCataOptionsStrSet()
  !this.selectCataOptionsStrSet()

  -- update max/min
  if ( !!fmSys.progress().neq(0) ) then
    !!fmSys.setProgress(89)
  endif
  !this.updateLimitsStrSet()

  -- stair set attributes
  ---------------------------------------------------------------------------
  if ( !!fmSys.progress().neq(0) ) then
    !!fmSys.setProgress(90)
  endif

  -- overall rise
  if ( !this.opORiseStrSet.dText.empty() ) then
    !this.txORiseStrSet.val = !this.meStrSetEngine.getORise()
  else
    !this.opORiseStrSet.select('DTEXT', !this.meStrSetEngine.getORise().string())
  endif

  -- overall length
  if ( !this.opLengthStrSet.dText.empty() ) then
    !this.txLengthStrSet.val = !this.meStrSetEngine.getLength()
  else
    !this.opLengthStrSet.select('DTEXT', !this.meStrSetEngine.getLength().string())
  endif

  -- width
  if ( !this.opWidthStrSet.dText.empty() ) then
    !this.txWidthStrSet.val = !this.meStrSetEngine.getWidth()
  else
    !this.opWidthStrSet.select('DTEXT', !this.meStrSetEngine.getWidth().string())
  endif

  -- flight thickness
  !this.txFThicknessStrSet.val = !this.meStrSetEngine.getFThickness()

  -- offsets
  !this.txLOffsetStrSet.val     = !this.meStrSetEngine.getLOffset()
  !this.txUOffsetStrSet.val     = !this.meStrSetEngine.getUOffset()
  !installationOptions          = !this.meStrSetEngine.getInstallationOption()
  !this.txLOffsetStrSet.visible = !installationOptions.matchwild('*Parallel to lines*')
  !this.txUOffsetStrSet.visible = !installationOptions.matchwild('*Parallel to lines*')

  -- direction / position
  ---------------------------------------------------------------------------
  !this.txDirStrSet.val       = !this.meStrSetEngine.getDirection().wrt(!this.txDirOriginStrSet.val.dbRef()).string().before(' WRT')
  !this.txLCutPlaneStrSet.val = !this.meStrSetEngine.getLCutPlane().string(!posFmt).before(' WRT')
  !this.txUCutPlaneStrSet.val = !this.meStrSetEngine.getUCutPlane().string(!posFmt).before(' WRT')

  !currLPositionOption            = !this.meStrSetEngine.getLPositionOption()
  !this.netStrSetLPositionFrame.active = !currLPositionOption.matchwild('Explicit * position...')
  !this.txLPosOriginStrSet.active = !currLPositionOption.matchwild('Explicit * position...')

  !lPos                           = !this.meStrSetEngine.getLWP().wrt(!this.txLPosOriginStrSet.val.dbRef())
  !this.strSetLpos                = !lPos
  if(!this.netStrSetLPositionFrame.active.not())then
    !this.strSetLPosControl.xyz(!lPos.east,!lPos.north,!lPos.up)
  endif

  !currUPositionOption            = !this.meStrSetEngine.getUPositionOption()
  !this.netStrSetUPositionFrame.active = !currUPositionOption.matchwild('Explicit * position...')
  !this.txUPosOriginStrSet.active = !currUPositionOption.matchwild('Explicit * position...')

  !uPos                           = !this.meStrSetEngine.getUWP().wrt(!this.txUPosOriginStrSet.val.dbRef())
  !this.strSetUpos                = !uPos
  if(!this.netStrSetUPositionFrame.active.not())then
    !this.strSetUPosControl.xyz(!uPos.east,!uPos.north,!uPos.up)
  endif

  !currDirectionOption            = !this.meStrSetEngine.getDirectionOption()
  !this.txDirStrSet.visible       = !currDirectionOption.eq('Explicit direction...')
  !this.txDirOriginStrSet.visible = !currDirectionOption.eq('Explicit direction...')

  -- stair flight segments attributes
  ---------------------------------------------------------------------------
  !segmentIdx = !this.nuSegmentStrSet.val.max(1).min(!numberOfSegments)
  if ( !numberOfSegments.gt(1) ) then
    !range[1] = 1
    !range[2] = !numberOfSegments
    !range[3] = 1
    !this.nuSegmentStrSet.range  = !range
  endif
  !this.nuSegmentStrSet.active = !numberOfSegments.gt(1)
  !this.nuSegmentStrSet.val    = !segmentIdx
  !this.paSegmentStrSet.val    = 'of ' & !numberOfSegments

  if ( !!fmSys.progress().neq(0) ) then
    !!fmSys.setProgress(92)
  endif
  !this.updateFrameSegmentStrSet(object GADGET(), '')

  -- derive and show the position/installation/direction options
  ---------------------------------------------------------------------------
  if ( !!fmSys.progress().neq(0) ) then
    !!fmSys.setProgress(96)
  endif
  !this.deriveOptionsStrSet()

  -- update the gates
  if ( !!fmSys.progress().neq(0) ) then
    !!fmSys.setProgress(97)
  endif
  !this.updateAccessStrSet()

  -- show the dimensions
  if ( !!fmSys.progress().neq(0) ) then
    !!fmSys.setProgress(99)
  endif
  !this.showDimFeedbackStrSet(object GADGET(), '')

  -- update the re-evaluate buttons
  !this.lkreEvaluateStrSet.active = !!aslCentralData.currSetting.description.neq(!this.meStrSetEngine.getSettingReference())

  -- resets the progress bar
  !!fmSys.setProgress(0)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateFrameStrTwr
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrameStrTwr()

  !strTwrData           = !this.meStrTwrEngine.strTwrData
  if ( !strTwrData.unset() ) then
    return
  endif

  -- update position and direction
  !posFmt               = object FORMAT()
  !posFmt.dp            = 0

  -- show the work frame
  !this.frameChange(!this.frMainWorkStrTwr)

  --!this.lkReEvaluateStrTwr.active = false

  -- update the gadgets
  ---------------------------------------------------------------------------
  -- to manipulate the general attributes
    !this.meStrTwrEngine.strTwrData.modifyGenAtt()

  -- to manipulate the Length
  !xLength = !this.meStrTwrEngine.getXLength()
  if ( !this.opXLengthStrTwr.dText.empty() ) then
    !this.txXLengthStrTwr.val   = !xLength
  else
    !this.opXLengthStrTwr.select('DTEXT', !xLength.string())
  endif

  -- to manipulate the Width
  !yLength = !this.meStrTwrEngine.getYLength()
  if ( !this.opYLengthStrTwr.dText.empty() ) then
    !this.txYLengthStrTwr.val   = !yLength
  else
    !this.opYLengthStrTwr.select('DTEXT', !yLength.string())
  endif

  -- to manipulate the Height
  !zLength = !this.meStrTwrEngine.getZLength()
  if ( !this.opZLengthStrTwr.dText.empty() ) then
    !this.txZLengthStrTwr.val   = !zLength
  else
    !this.opZLengthStrTwr.select('DTEXT', !zLength.string())
  endif

  -- to manipulate the stair flight Thickness
  !fThickness = !this.meStrTwrEngine.getStrFltThk()
  if (!this.opFThicknessStrTwr.dText.empty()) then
   !this.txFThicknessStrTwr.val = !fThickness
  else
   !this.opFThicknessStrTwr.select('DTEXT', !fThickness.string())
  endif

  -- to manipulate the stair flight Width
  !strFltWidth = !this.meStrTwrEngine.getStrFltWidth()
  if ( !this.opStrFltWidthStrTwr.dText.empty() ) then
    !this.txStrFltWidthStrTwr.val   = !strFltWidth
  else
    !this.opStrFltWidthStrTwr.select('DTEXT', !strFltWidth.string())
  endif

  -- to manipulate the stair flight pitch
  !strFltPitch = !this.meStrTwrEngine.getStrFltPitch()
  if ( !this.opStrFltPitchStrTwr.dText.empty() ) then
    !this.txStrFltPitchStrTwr.val   = !strFltPitch
  else
    !this.opStrFltPitchStrTwr.select('DTEXT', !strFltPitch.string())
  endif

  -- to manipulate the centre line X Spacing
  !clXSpacing = !this.meStrTwrEngine.getCLXSpacing()
  if ( !this.opCLXSpacingStrTwr.dText.empty() ) then
    !this.txCLXSpacingStrTwr.val   = !clXSpacing
  else
    !this.opCLXSpacingStrTwr.select('DTEXT', !clXSpacing.string())
  endif

  -- to manipulate the centre line Y Spacing
  !clYSpacing = !this.meStrTwrEngine.getCLYSpacing()
  if ( !this.opCLYSpacingStrTwr.dText.empty() ) then
    !this.txCLYSpacingStrTwr.val   = !clYSpacing
  else
    !this.opCLYSpacingStrTwr.select('DTEXT', !clYSpacing.string())
  endif

  -- to manipulate the stair flight rotation (sense) clockwise or anti-clockwise
  !clockwise                      = !this.meStrTwrEngine.getClockwise()
  !this.toClockwiseStrTwr.val     = !clockwise
  !this.toAntiClockwiseStrTwr.val = !clockwise.not()

  -- to manipulate the position
  !position                 = !this.meStrTwrEngine.getPosition()
  --!this.strTwrPosControl.xyz(!position.east, !position.north, !position.up)

  -- to manipulate the direction gadget of the stair tower
  !orientation                = !this.meStrTwrEngine.getOrientation()
  if(!this.meStrTwrEngine.strTwrData.prmDirection.set()) then
    !this.txDirectionStrTwr.val = !this.meStrTwrEngine.strTwrData.prmDirection.string().before(' WRT')
  else
    !this.txDirectionStrTwr.val = !orientation.yDir().string().before(' WRT')
  endif

  -- Updates the access points (Gates) of the stair tower
  --!this.updateAccessStrTwr()

  -- draw the Stair tower
  !this.showDimFeedbackStrTwr(object GADGET(), '')

  -- auto limits on the tower
  if ( !!aslCentralData.autoLimits ) then
    !fromPosition = !position.offset(!orientation.yDir(),            !yLength / 2).offset(!orientation.xDir(),            !xLength / 2)
    !toPosition   = !position.offset(!orientation.yDir().opposite(), !yLength / 2).offset(!orientation.xDir().opposite(), !xLength / 2).offset(U, !zLength)
    !volume       = object VOLUME(!fromPosition, !toPosition)
    do !view value !!gphviews.views
      !!gphviews.limits(!view, !volume)
    enddo
  endif

  -- updates the limits
  !this.updateLimitsStrTwr()

  -- update active status of the re-evaluate buttons
  --!this.lkReEvaluateStrTwr.active = !!aslCentralData.currSetting.description.neq(!this.meStrTwrEngine.getRefe().strStd)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateFrameWWay
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrameWWay()

  !wWayData             = !this.meWWayEngine.wWayData
  if ( !wWayData.unset() ) then
    return
  endif

  -- update position direction
  !posFmt               = object FORMAT()
  !posFmt.dp            = 0

  -- change the frames to the walkway frame
  !this.frameChange(!this.frMainWorkWWay)

  -- updates/selects template(s)
  !this.updateCataOptionsWWay()
  !this.selectCataOptionsWWay()

  -- thickness
  if ( !this.opThicknessWWay.dText.empty() ) then
    !this.txThicknessWWay.val = !this.meWWayEngine.getHeight()
  else
    !this.opThicknessWWay.select('DTEXT', !this.meWWayEngine.getHeight().string())
  endif

  -- width
  if ( !this.opWidthWWay.dText.empty() ) then
    !this.txWidthWWay.val = !this.meWWayEngine.getWidth()
  else
    !this.opWidthWWay.select('DTEXT', !this.meWWayEngine.getWidth().string())
  endif

  -- access points
  !this.updateAccessWWay()

  -- update max/min
  !this.updateLimitsWWay()

  -- update the re-evaluate buttons
  !this.lkreEvaluateWWay.active = !!aslCentralData.currSetting.description.neq(!this.meWWayEngine.getSettingReference())

endmethod
-- End of method

