------------------------------------------------------------------------
--
-- Method:      modifyLadder
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyLadder(!gadget is GADGET, !action is STRING)

 !undo = object UNDOABLE()
 !undo.description('Modify Ladder')
 !undo.undoAction('!!aslMain.ceLadder()')
 !undo.add()

  -- open callback calls method twice
  if ( !gadget.type().eq('LIST') and $
       !action.eq('UNSELECT') ) then
    return
  endif

  -- overall rise
  if ( !this.opHeightLadder.dText.empty() ) then
    !height = !this.txHeightLadder.val
  else
    !height = !this.opHeightLadder.selection().real()
  endif

  if(!this.meLadderEngine.ladderData.positionOption.matchwild('*lower*'))then
    !this.meLadderEngine.ladderData.uPosData.position.up = !this.meLadderEngine.ladderData.lPosData.position.up + !height
  else
    !this.meLadderEngine.ladderData.lPosData.position.up = !this.meLadderEngine.ladderData.uPosData.position.up - !height
  endif
  if(!gadget inset (!this.txHeightLadder, !this.opHeightLadder))then
   !this.updateLadderPositionGadgets()
  endif

  -- width
  if ( !this.opWidthLadder.dText.empty() ) then
    !this.meLadderEngine.setWidth(!this.txWidthLadder.val)
  else
    !this.meLadderEngine.setWidth(!this.opWidthLadder.selection().real())
  endif

  -- type of top exit
  !this.meLadderEngine.setUExitType(!this.opTopAccessTypeLadder.selection())

  -- pitch
  if ( !this.opPitchLadder.dText.empty() ) then
    !this.meLadderEngine.setPitch(!this.txPitchLadder.val)
  else
    !this.meLadderEngine.setPitch(!this.opPitchLadder.selection().real())
  endif

  -- rise
  if ( !this.opRiseLadder.dText.empty() ) then
    !this.meLadderEngine.setRise(!this.txRiseLadder.val)
  else
    !this.meLadderEngine.setRise(!this.opRiseLadder.selection().real())
  endif

  -- distance to first rung
  !this.meLadderEngine.setLRise(!this.txLRiseLadder.val)

  -- distance cage above ladder
  !this.meLadderEngine.setExtension(!this.txExtensionLadder.val)

  -- clearance to any obstruction
  !this.meLadderEngine.setheadroom(!this.txheadroomLadder.val)

  -- clearance to any obstruction
  !this.meLadderEngine.setFootroom(!this.txFootroomLadder.val)

  -- cage offset
  !this.meLadderEngine.setCageOffset(!this.txCageOffsetLadder.val)

  -- cage offset
  !this.meLadderEngine.setCageSize(!this.txCageSizeLadder.val)

  -- stringer distance
  !this.meLadderEngine.setStringerDist(!this.txStringerDistLadder.val)

  -- stringer thickness
  !this.meLadderEngine.setStringerThn(!this.txStringerThnLadder.val)

  -- explicit position
  if ( !gadget inset (!!aslMain.netLadderPositionFrame, !this.txPosOriginLadder ) ) then
    !position        = N0
    !position.east   = !this.ladderPosControl.xyz()[0]
    !position.north  = !this.ladderPosControl.xyz()[1]
    !position.up     = !this.ladderPosControl.xyz()[2]
      !position.origin = !this.txPosOriginLadder.val.dbRef()
      if(!this.meLadderEngine.ladderData.positionOption.matchwild('*lower*'))then
         !this.meLadderEngine.ladderData.lPosData.position = !position
      else
         !this.meLadderEngine.ladderData.uPosData.position = !position
      endif
    !this.evaluateLadder()

  --explicit direction
  elseif ( !gadget inset (!this.txDirLadder, !this.txDirOriginLadder ) ) then
    !direction        = object DIRECTION(!this.txDirLadder.val)
    !direction.origin = !this.txDirOriginLadder.val.dbRef()
    !this.meLadderEngine.setExplicitDirection(!direction)
  endif

  -- check if the ladder is OK
  !this.evaluateLadder()
  !this.lkreEvaluateLadder.active = true
  !undo.endundoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyLadderTmplReference
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyLadderTmplReference(!gadget is GADGET, !action is STRING)

  -- set the reference to the central template
  !ladderTmplReference = !this.opLadderTmplReferenceLadder.selection().dbRef()
  !this.meLadderEngine.setTmplReference(!ladderTmplReference)

  -- combines general and fabricator standard
  !this.meLadderEngine.mergeCriteria()
  !this.updateLimitsLadder()

  -- standard modify method
  !this.modifyLadder(!gadget, !action)

endmethod
-- End of method

