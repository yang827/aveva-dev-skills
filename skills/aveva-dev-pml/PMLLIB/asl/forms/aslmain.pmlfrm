------------------------------------------------------------------------
--
-- Method:      ceStrSet
--
-- Description: modify the current stair flight
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .ceStrSet()

  !this.updateCoordinateSystem()
  -- remove aid lines
  !!aslCentralData.clearVolFeedback()

  -- check if you are below a STRFLT element
  STRFLT
  handle ANY
    !!alert.warning('Not below STRFLT hierarchy')
    return
  endhandle

  !strSetRefe = !!ce

  -- initialise the data objects
  !this.meStrSetEngine = object ASLSTRSETENGINE()

  -- update the new object with the current element
  !this.meStrSetEngine.updateDataObj(!strSetRefe)
  handle ANY
    !!alert.error('Unable to Modify: Check that the setting configuration used for this element exists')
    return
  endhandle

  !this.deriveInstallationOptionsStrSet()

  -- make "explicit" as default
  !this.changeCalcMethodStrSet(!this.rtExplicitStrSet, '')

  -- update the gadgets
  !this.updateFrameStrSet()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      ceStrTwr
--
-- Description: Data used by the modify option of the stair Tower
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .ceStrTwr()

  -- check if CE is Stair Tower or not
  if (!!ce.type.neq('STRTWR')) then
    !!alert.warning('Navigate to STRTWR (Stair Tower) hierarchy')
    return
  endif

  -- Updates the current coordinates system
  !this.updateCoordinateSystem()

  -- removes aid constructor
  !!aslCentralData.clearVolFeedback()

  -- Collects the current element
  !refe = !!ce

  -- initialise the data objects
  !this.meStrTwrEngine = object ASLSTRTWRENGINE()
  !strFltTmplReference = !this.opStrFltTmplReferenceStrTwr.selection().dbRef()
  !strLngTmplReference = !this.opStrLngTmplReferenceStrTwr.selection().dbRef()
  !handRaTmplReference = !this.opHandRaTmplReferenceStrTwr.selection().dbRef()

  !this.meStrTwrEngine.updateDataObj(!refe)

  -- Generate the Constructor aids for the stair tower elements
  !this.showVolFeedBackStrTwr()

  -- Evaluation of the centrelines, platformengines, Stairflightengine, etc
  !this.evaluateStrTwrPreview()

  -- update the gadgets
  !this.updateFrameStrTwr()

endmethod
-- End of method

