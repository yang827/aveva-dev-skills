  !rows = !this.neAccessLadder.getSelectedRows()
  if ( !rows.size().neq(1) ) then
    !!alert.warning('Only possible when one row is selected')
    return
  endif

  -- defines packet
  !packet                     = object EDGPACKET()
  !packet.pickPacket.prompt   = 'Identify position of side exit'

  -- defines first pick
  !packet.pickPacket.picks[1] = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('')

  -- define actions on first pick
  !packet.action              = '!!aslMain.pickAccessLadderReturn(!this.return[1])'

