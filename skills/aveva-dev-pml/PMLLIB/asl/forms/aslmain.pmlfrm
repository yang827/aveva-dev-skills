  !this.neAccessWWay = object NETGRIDCONTROL()

  -- add PML event handlers to .Net control for the access points
  !this.neAccessWWay.addEventHandler('AfterCellUpdate',   !this, 'modifyAccessWWay')
  !this.neAccessWWay.addEventHandler('AfterSelectChange', !this, 'selectAccessWWay')
  !this.neAccessWWay.columnExcelFilter(false)
  !this.neAccessWWay.outlookGroupStyle(false)
  !this.neAccessWWay.fixedHeaders(true)
  !this.neAccessWWay.fixedRows(true)
  !this.neAccessWWay.editableGrid(true)
  !this.neAccessWWay.headerSort(false)
--  !this.neAccessWWay.rowAddDeleteGrid(false)
  -- add .Net control to PML container for the access points
  !this.coAccessWWay.control = !this.neAccessWWay.handle()

  -- register the form so that it appears again when entering pdms
  !!appFormCntrl.registerForm(!this)

endmethod
-- End of method

