--
-- Method:      modifyOpeningsPltFrm
--
-- Description: callback when changing the grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       not idea
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyOpeningsPltFrm(!array is ARRAY)

  -- means it is OK to change the value
  !array[1] = TRUE

  -- init
  !openingStatus = object ARRAY()

  -- gets the values from all openings
  do !row value !this.neOpeningsPltFrm.getRows()
    !openingStatus.append(!row[2] inset ('1', 'On'))
  enddo

  !this.mePltFrmEngine.setOpeningsHandRaStatus(!openingStatus)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyOpeningsPltFrm
--
-- Description: implements new opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyOpeningsPltFrm(!gadget is GADGET, !action is STRING)

  -- open profile form
  ---------------------------------------------------------------------------
  !profileUI                 = object PROFILEUI()
  !profileUI.acceptDText     = 'Accept opening'
  !profileUI.discardCallback = '!!aslMain.modifyOpeningsPltFrmDiscard()'
  !profileUI.discardDText    = 'Discard opening'
  !profileUI.formTitle       = 'Opening'

  -- modify
  if ( !gadget.eq(!this.lkModifyOpeningsPltFrm) ) then
    !selectedRows = !this.neOpeningsPltFrm.getSelectedRows()
    !rowIdx       = !selectedRows.first().first().real()
    !allOpenings  = !this.mePltFrmEngine.getOpenings()

    !profileUI.acceptCallback = '!!aslMain.modifyOpeningsPltFrmAccept(!this.meProfiles, false)'
    !profileUI.create         = false
    !profileUI.profile        = !allOpenings[!rowIdx]

  -- create
  else
    !profileUI.acceptCallback = '!!aslMain.modifyOpeningsPltFrmAccept(!this.meProfiles, true)'
    !profileUI.create         = true
    !profileUI.profile        = object PROFILE()
  endif
  !profileUI.load()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyOpeningsPltFrmAccept
--
-- Description: return from profile form by press of ACCEPT
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
--    2   R      BOOLEAN     true, if create mode
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyOpeningsPltFrmAccept(!profiles is ARRAY, !createFlag is BOOLEAN)

 !this.mePltFrmOpening = !profiles
  -- shows the current form
  !this.show()

  -- remove aid lines
  !!aslCentralData.clearVolFeedback()

  -- set the profile as shape
  if ( !createFlag ) then
    !this.mePltFrmEngine.addOpening(!profiles[1])
  else
    !selectedRows = !this.neOpeningsPltFrm.getSelectedRows()
    !openingIdx   = !selectedRows.first().first().real()
    !this.mePltFrmEngine.replaceOpening(!profiles[1], !openingIdx)
  endif

  -- evaluate the handrails
  !this.mePltFrmEngine.evaluateHandRa()

  -- create the platform
  !this.mePltFrmEngine.updateDB()

  -- updates the aid dimension elements
  !this.showDimFeedbackPltFrm(object GADGET(), '')

  -- update the gadgets
  !this.updateFramePltFrm()

endmethod
-- End of method

