  !heading[3] = 'Arrive Offset'
  !heading[4] = 'Leave Offset'

  !title      = 'Access Points'

  !allGates   = !this.meStrTwrEngine.getGates()
  --!strTwrRefe = !this.meStrTwrEngine.getRefe()
  !columns    = object ARRAY()
  do !i index !allGates
    !gate        = !allGates[!i]
    !columns[!i] = object ARRAY()
    !columns[!i].append(!i.string())
    --!columns[!i].append(!gate.position.wrt(!strTwrRefe).string(!posFmt).before(' WRT'))
    !columns[!i].append(!gate.position.wrt(world).string().before(' WRT'))
    !columns[!i].append(!gate.arriveOffset.string())
    !columns[!i].append(!gate.leaveOffset.string())
  enddo

  !netDataSource = object NETDATASOURCE(!title, !heading, !columns)
  !this.neAccessStrTwr.bindToDataSource(!netDataSource)

  !this.lkDeleteAccessStrTwr.active = false
  !this.lkPickAccessStrTwr.active   = false

