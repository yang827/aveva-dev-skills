------------------------------------------------------------------------
--
-- Method:      newLadder
--
-- Description: Invoke EDG pick
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newLadder()
 !this.updateCoordinateSystem()
  -- check if there is a setting, otherwise it does not make sense to create a ladder
  if ( !!aslCentralData.currSetting.unset() ) then
    !!alert.warning('There is no ASL selection. Ask your ASL administrator.')
    return
  endif
  if ( !!aslCentralData.currSetting.collectAll('LADDER').empty() ) then
    !!alert.warning('There are no ladders in the ASL selection. Ask your ASL administrator.')
    return
  endif

  -- initialise the data objects
  !this.meLadderEngine               = object ASLLADDERENGINE()
  !ladderTmplReference               = !this.opLadderTmplReferenceLadder.selection().dbRef()
  !this.meLadderEngine.newDefaults(!ladderTmplReference)

  -- defines packet
  !packet                            = object EDGPACKET()
  !packet.pickPacket.prompt          = 'Ladder'

  -- defines first pick
  !packet.pickPacket.picks[1]        = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdGraphics('Start')

  -- defines second pick and defines prompt
  !packet.pickPacket.picks[2]        = !packet.pickPacket.picks[1]
  !packet.pickPacket.picks[2].prompt = ('End')

  -- define actions on first pick
  !packet.pickPacket.picks[1].action = '!!aslMain.firstPickLadderReturn(!this.return[1])'

  -- defines action on pick completion
  !packet.action                     = '!!aslMain.createLadderReturn(!this.return[1][2])'

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

  -- remove aid lines
  !!aslCentralData.clearVolFeedback()

endmethod
-- End of method

