  ---------------------------------------------------------------------------
  -- switch on the first button if nothing has been selected yet
  !lPositionOption = !this.meStrSetEngine.getLPositionOption()
  !uPositionOption = !this.meStrSetEngine.getUPositionOption()

  !i               = !lPositionLabels.findFirst(!lPositionOption)
--  if ( !lPositionOption.unset() and $
--       !uPositionOption.unset() or  $
--       !i.unset() ) then
--    !this.toLPosOptionStrSet1.val                  = true
--    !this.meStrSetEngine.setLPositionOption(!lPositionLabels.first())
--  else
  if ( !i.set() ) then
    !this.attribute('TOLPOSOPTIONSTRSET' & !i).val = true
--    !this.meStrSetEngine.setLPositionOption(!lPositionOption)
  endif
--  endif

  !i               = !uPositionLabels.findFirst(!uPositionOption)
--  if ( !lPositionOption.unset() and $
--       !uPositionOption.unset() or  $
--       !i.unset() ) then
--    !this.toUPosOptionStrSet1.val                  = true
--    !this.meStrSetEngine.setUPositionOption(!uPositionLabels.first())
