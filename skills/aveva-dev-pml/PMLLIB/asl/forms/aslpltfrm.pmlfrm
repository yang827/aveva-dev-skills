--   Type:          Form Definition
--   Group:         ASL
--
--   Keyword:       Platform Definition
--   Module:        Design
--   Replaces:
--
-- Author:          michael.board
-- Created:         Sun Feb 4 20:00:00 GMT 2007
--
--
-- Description:
--    Main form for platform (PLTFRM)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  area(GADGET,STRING)              -                   set area attribute
--  aslPltFrm()                      -                   Constructor
--  changePosType(GADGET)            -                   Change position type (FFL or TOS)
--  checkName(GADGET,STRING)         -                   Check name is a valid new name
--  connectSections(BOOLEAN)         -                   set connection flag on all panels
--  connectSections(GADGET)          -                   set connection toggles on all panels
--  create()                         -                   create platform
--  createOpening()                  -                   create opening
--  createOpeningPltFrm(BOOLEAN)     -                   Display openings pane in create mode
--  createPltFrm(BOOLEAN)            -                   Display platform pane in create mode
--  createVertex()                   -                   initialise EDG mode to create new vertex
--  createVertex(EDGPOSITIONDATA)    -                   create new vertex
--  createVertexClose()              -                   called on exit from EDG mode
--  deleteCurrentVertex()            -                   delete current vertex
--  deletePlopen()                   -                   Delete PLOPEN
--  deletePltFrm()                   -                   Delete PLTFRM
--  deletePltfrmDetail(STRING)       -
--  direction()                      -                   Set direction
--  discardModifyOpening()           -
--  drawVertices(REAL,REAL)          ARRAY               draw all vertices
--  dummy()                          -                   Dummy method for unset
--  geometryOpeningPltFrm()          -                   go to shape definition editor pane to define platform opening geometry
--  geometryOpeningPltFrmUpdate(SHAPEDEFINITION) -                   return from shape form by press of ACCEPT
--  geometryPltFrm()                 -                   go to shape definition editor pane to define platform geometry
--  geometryPltFrmUpdate(SHAPEDEFINITION) -                   return from shape form by press of ACCEPT
--  handRailCreate()                 -                   create hand rail
--  handRailModify()                 -                   modify hand rail
--  height()                         -                   set object height
--  init()                           -                   form initialisation
--  mainTasks(BOOLEAN)               -                   Set main tasks
--  modGeometry()                    -
--  modGeometryButtons()             -                   handle buttons of .modGeometry panel
--  modify(BOOLEAN)                  -                   Modify (write modified values to DB)
--  modifyOpening()                  -                   Modify opening (write modified values to DB)
--  modifyOpeningPltFrm(BOOLEAN)     -                   Display openings pane in create mode
--  modifyPltFrm(BOOLEAN)            -                   Display platform pane in modify mode
--  moveCurrentVertex()              -                   initialise EDG mode to move current vertex
--  moveCurrentVertex(EDGPOSITIONDATA) -                   move current vertex
--  moveCurrentVertexClose()         -                   called on exit from EDG mode
--  number(GADGET,STRING)            -                   set number attribute
--  offset(EDGPOSITIONDATA)          -                   Map picked position to opening covering offset
--  openingRadius()                  -                   set opening radius
--  openingSize()                    -                   set opening XY size
--  openingsPltFrm(BOOLEAN)          -                   Display openings pane
--  pickOffset()                     -                   Setup EDG pick event for picking position
--  pickPosition()                   -                   Setup EDG pick event for picking position
--  pickXyOpening()                  -                   Setup EDG pick event for picking position
--  pltFrmCreate()                   -                   Create Platform
--  pltFrmDefinitionPane(BOOLEAN)    -                   Switch to platform definition pane
--  pltFrmGeometry()                 -                   Switch to geometry modification pane for current element
--  pltFrmGeometry(BOOLEAN)          -                   Switch to geometry modification pane
--  pltFrmGeometry(DBREF)            -                   Switch to geometry modification pane for specified element
--  pltFrmModify()                   -                   modify platform
--  pltFrmModify(DBREF)              BOOLEAN             Setup to modify platform
--  pltFrmOpeningCreate()            -                   Create platform opening
--  pltFrmOpeningCreate(DBREF)       BOOLEAN             Setup to create platform opening
--  pltFrmOpeningCreateDirect()      -                   Create platform opening direct from platform pane
--  pltFrmOpeningModify()            -                   modify platform opening
--  pltFrmOpenings()                 -                   platform openings
--  pltFrmOpeningsModify(DBREF)      BOOLEAN             Setup to modify platform openings
--  pltGrdLayout()                   -                   switch to and initialise PLTGRD layout form
--  position(EDGPOSITIONDATA)        -                   Set platform position to picked position
--  radius()                         -                   set platform radius
--  selectEntity()                   -                   select entity to be modified (platform or openings)
--  selectOpeningsPltFrm(ARRAY)      -                   select opening
--  setCurrentVertex()               -                   initialise EDG mode to select current vertex
--  setCurrentVertex(EDGPICKDATA)    -                   select current vertex
--  setCurrentVertexClose()          -                   called on exit from EDG mode
--  setPosition()                    -                   set position
--  trackDb()                        -                   method to control active status of main panel buttons
--  undo(STRING)                     -
--  updateAttributes()               -                   Update gadgets with object data
--  updateOpeningAttributes()        -                   Update gadgets with object data
--  updateOpeningsAttributes()       -                   Update gadgets with object data
--  xyOpening()                      -                   Set xy position of opening
--  xyOpening(EDGPOSITIONDATA)       -                   Map picked position to room offset
--  xySize()                         -                   set XY size of platform
--


import 'GridControl'
handle ANY
endhandle

import 'PositionControl'
handle ANY
endhandle

setup form !!aslPltFrm dialog docking right

  -- .NET library
  using namespace 'Aveva.Pdms.Presentation'

  !this.formTitle     = 'Platform Definition'
  !this.iconTitle     = 'Platform Covering'
  !this.cancelCall    = '!this.definition.tidy()'
  !this.formRevision  = ' $Revision$ '

  -- Main Task Pane
  frame .mainTaskPane panel                   anchor top + left + right         at x0                     ymax

    -- Create options
    paragraph .createTasks                                                      at x0.5                   ymax        text 'Create' width 10
    line .mainTaskL1                          anchor top + left + right         at xmin                   ymax                horizontal width 33
    button .mtCrt         linkLabel 'Platform'                                  at x2                     ymax                callback '!this.pltFrmCreate()'
    button .mtCrtOpening  linkLabel 'Platform Opening'                          at x2                     ymax                callback '!this.pltFrmOpeningCreateDirect()'
    button .mtCrtHandRail linkLabel 'Handrail for Current Platform'             at x2                     ymax                callback '!this.handRailCreate()' width 28

    -- Modify options
    paragraph .modifyTasks                                                      at x0.5                   ymax+0.5     text 'Modify'       width 10
    line .mainTaskL2                          anchor top + left + right         at xmin                   ymax                horizontal width 33
    button .mtMod          linkLabel 'Platform Definition'                      at x2                     ymax                callback '!this.pltFrmModify()'
    button .mtModGeometry  linklabel 'Platform Geometry'         at x2  ymax  callback '!this.pltFrmGeometry()'
    button .mtPlateGrid    linkLabel 'Platform Layout'                               at xmin                     ymax                callback '!this.pltGrdLayout()'

    -- Detail options
    button .mtOpeningsDet  linkLabel 'Openings'                                 at xmin               ymax                callback '!this.pltFrmOpenings()'

    button .mtHandRail        linkLabel 'Handrail'                               at xmin                     ymax               callback '!this.handRailModify()'

    -- Delete options
    paragraph .deleteTasks                                                      at x0.5                   ymax+0.5      text 'Delete'      width 10
    line .mainTaskL4                          anchor top + left + right         at xmin                   ymax                horizontal width 33
    button .mtDel         linkLabel 'Platform'                           at x2                     ymax                callback '!this.deletePltFrm()'
    button .mtDelIntfrm   linklabel 'Platform Internal Frame'            at xmin                     ymax                callback '!this.deletePltfrmDetail(''intfrm'')'
    button .mtDelExtfrm   linklabel 'Platform External Frame'            at xmin                     ymax                callback '!this.deletePltfrmDetail(''extfrm'')'
    button .mtDelPltgrd   linklabel 'Platform Plate Detail'              at xmin                     ymax                callback '!this.deletePltfrmDetail(''pltgrd'')'

    paragraph .exitIcon                   anchor top + left                 at x0                     ymax+0.5            pixmap width 15 height 15
    button .exit   linkLabel   'Exit'                     at xmax+1                 ymin                callback '!this.hide()'

  exit

  -- Platform creation/modification pane
  frame .editPane panel                       anchor top + left + right         at x0                     ymin form

    -- general attributes
    ---------------------------------------------------------------------------
    para  .paGeneralCreatePltFrm                                                at x0.5      ymax text 'General attributes'
    line  .lnGeneralCreatePltFrm                                                at xmin                   ymax-.2 anchor T+L+R HORIZ width 33
    text   .txNameCreatePltFrm      'Name:'         tagwidth 10   at x1 ymax+0.2 callback '!this.checkName(!this.txNameCreatePltFrm, !this.definition.name)'       anchor L+T+R  width 21 is STRING
    text   .txDescCreatePltFrm      'Description:'  tagwidth 10   at xmin ymax+0.2 callback '!this.definition.description = !this.txDescCreatePltFrm.val.trim() !this.txDescCreatePltFrm.val = !this.definition.description'       anchor L+T+R width 21 is STRING
    numericinput .area              'Area:'         tagwidth 10   at xmin ymax+0.2 callback '!this.area('   anchor l+t+r range -1000000 1000000 width 10
    numericinput .number            'Number:'       tagwidth 10   at xmin ymax+0.2 callback '!this.number(' anchor l+t+r range -1000000 1000000 width 10
    text   .txThicknessCreatePltFrm 'Thickness:'    tagwidth 10   at xmin ymax+0.2 callback '!this.height()'       anchor L+T+R width 21 is REAL format !!distanceFmt

    -- Orientation
    paragraph .paLocationPltFrm     anchor top + left          at x0.5                   ymax+0.4            text 'Orientation'
    line .lnLocationPltFrm          anchor top + left + right  at xmin                   ymax                horizontal width 33


    text .prmDir 'Primary Direction:' tagwidth 12   anchor top + left + right   at x1   ymax+0.2     callback '!this.direction()'       width 19 is STRING

    -- positioning
    paragraph .paPosition           anchor top+left at x0.5  ymax+0.4 text 'Position'
    line .lnPosition                anchor T+L+R    at xmin ymax horizontal width 33

    option .opPosType       anchor top + left   at    xmin                    ymax+0.2       callback '!this.changePosType(!this.opPosType)'    width 4

    button .pickPosition linkLabel 'Cursor...'    anchor top + left   at xmax+0.5                   ymin            callback '!this.pickPosition()' width 10

    -- Create a frame to hold PMLNet Positioning Control
    frame .bbPositionControl panel   anchor top + left + right      at x0  ymax+0.2 width 29
      container .pltFrmEditPosNetFrame PMLNetCONTROL 'NET' dock fill anchor top+left+right width 31 height 4
    exit

    -- Modification data specific to a platform
    frame .modPane panel                            anchor top + left + right   at x0                     ymax+0.7

      -- Apply Changes
      paragraph .modAcceptIcon              anchor top + left                   at x0                     ymax            pixmap width 16 height 16
      button .modAccept  linkLabel 'Accept Changes' anchor top + left            at xmax+0.7               ymin                callback '!this.modify(false)' width 10

      -- Discard Changes
      button .modDiscard linkLabel 'Discard Changes' anchor top + right         at xmax form-12          ymin                callback '!this.pltFrmModify(!this.definition.dbElement)' width 10
      paragraph .modDiscardIcon             anchor top + right                  at xmin-2.7            ymin                pixmap width 16 height 16

      paragraph .modBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      button .modMain   linkLabel  'Back to main Platform tasks'                at xmax+1                 ymin                callback '!this.mainTasks(true)' width 20

    exit

    -- Creation data specific to a platform
    frame .crtPane panel                            anchor top + left + right   at xmin.modPane           ymin.modPane

      paragraph .createGeometry                     anchor top + left + right   at x0.5                   ymax                text 'Geometry' width 28 lines 1
      line .editLine3                               anchor top + left + right   at xmin                   ymax                horizontal width 33

      button .crtShape linkLabel  'Define Platform geometry:' anchor t + l  at xmin                   ymax+0.2            callback '!this.geometryPltFrm()' width 28
      paragrap .crtShapeDef                         anchor top + left + right   at xmin+2                 ymax                width 28 lines 1

      -- display layout toggle
      toggle .displayLayout       'Display Layout Modification' anchor t + l  at x1                   ymax+0.4

      -- Create platform
      paragraph .crtAcceptIcon                      anchor top + left           at x0                     ymax+0.3            pixmap width 16 height 16
      button .crtAccept linkLabel 'Create Platform' anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.create()'

      paragraph .crtBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .crtMain   linkLabel 'Back to main Platform tasks'                 at xmax+1                 ymin                callback '!this.mainTasks(true)'

    exit

  exit

  -- Modify geometrical information
  frame .modGeometry panel                          anchor top + left + right   at x0                     ymin form

    --paragraph .geomTitle                            anchor top + left + right   at x0.5                   ymax                width 20 lines 1
    option .entity   'Modify:' tagwidth 5 anchor top+left+right  at x0.5  ymax  callback '!this.selectEntity()' width 24
    line .geomLine1                                 anchor top + left + right   at xmin                   ymax+0.2                horizontal width 33

    -- Define geometry
    button .modRpathNew    linkLabel  'Insert Vertex...' anchor t + l     at x1 ymax  callback '!this.createVertex()' width 20
    button .modRpathMoveCv linkLabel  'Move Current Vertex...' anchor t + l    at x1 ymax  callback '!this.moveCurrentVertex()' width 20
    button .modRpathDelCv  linkLabel  'Remove Current Vertex...' anchor t + l  at x1 ymax  callback '!this.deleteCurrentVertex()' width 20
    button .modRpathSetCv  linkLabel  'Set Current Vertex...' anchor t + l        at x1 ymax+0.3  callback '!this.setCurrentVertex()' width 20

    toggle .modGeomConnect 'Connect Sections' tagwidth 15 anchor top + left   at xmin  ymax+0.3  callback '!this.connectSections(!this.modGeomConnect)'

    text .radius 'Radius:' tagwidth 6 anchor top + left + right at xmin ymax+0.2 callback '!this.radius()' width 20 is REAL format !!distanceFmt
    text .sizeX  'Xlength:' tagwidth 6 anchor top + left + right at xmin ymin callback '!this.xySize()' width 20 is REAL format !!distanceFmt
    text .sizeY  'Ylength:' tagwidth 6 anchor top + left + right at xmin ymax callback '!this.xySize()' width 20 is REAL format !!distanceFmt


    -- Accept Changes
    paragraph .gModAcceptIcon                       anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
    button .gModAccept  linkLabel 'Accept Changes'  anchor top + left           at xmax+0.5               ymin                callback '!this.modify(true)' width 10

    -- Discard Changes
    paragraph .gModDiscardIcon                      anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
    button .gModDiscard linkLabel 'Discard Changes' anchor top + right          at xmax+0.5               ymin                callback '!this.pltFrmGeometry(!this.definition.dbElement)' width 10

    paragraph .gModBackIcon                         anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
    button .gModMain   linkLabel   'Back to main Platform tasks'                at xmax+1                 ymin                callback '!this.mainTasks(true)' width 17

  exit

  -- Openings information
  frame .openingsPane panel                          anchor top + left + right  at x0                     ymin form

    container .coOpeningsPltFrm PMLNetCONTROL    anchor all width 32 height 10

    button .createOpening linkLabel 'Create Opening'  anchor top + left                    at xmin               ymax+0.2            callback '!this.pltFrmOpeningCreate()' width 18

    button .modifyOpening linkLabel 'Modify Selected Opening'  anchor top + left           at xmin               ymax+0.2            callback '!this.pltFrmOpeningModify()' width 18

    button .deleteOpening linkLabel 'Delete Selected Opening'  anchor top + left           at xmin               ymax+0.2            callback '!this.deletePlopen()' width 18

    toggle .openingsConnect 'Connect Sections' tagwidth 15 anchor top + left   at xmin  ymax+0.3  callback '!this.connectSections(!this.openingsConnect)'

    paragraph .openingsBackIcon                         anchor top + left                  at x0                 ymax+0.5            pixmap width 15 height 15
    button .openingsMain   linkLabel   'Back to main Platform tasks'                       at xmax+1             ymin                callback '!this.mainTasks(true)' width 18

  exit
  -- Openings information
  frame .openingPane panel                          anchor top + left + right              at x0     ymin form

    -- XY Offset of opening from platform origin
    button .xyOpening linkLabel 'Opening XY Position...'          anchor top + left    at x1                     ymax+0.2            callback '!this.pickXyOpening()' width 20
    text .xOpening   'X:'   tagwidth 6               anchor top + left + right   at x2                 ymax                callback '!this.xyOpening()' width 21 is REAL format !!distanceFmt
    text .yOpening   'Y:'   tagwidth 6               anchor top + left + right   at xmin                   ymax+0.2            callback '!this.xyOpening()' width 21 is REAL format !!distanceFmt

    toggle .modOpeningConnect 'Connect Sections' tagwidth 15 anchor top + left   at xmin  ymax+0.3  callback '!this.connectSections(!this.modOpeningConnect)'

    frame .modOpeningPane panel                            anchor top + left + right   at x0                     ymax

      --paragraph .modOpeningBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      --button .modOpening   linkLabel  'Back to main Platform tasks'                at xmax+1                 ymin                callback '!this.mainTasks(true)'

      text .openingRadius 'Radius:' tagwidth 6 anchor top + left + right at x2 ymax callback '!this.openingRadius()' width 21 is REAL format !!distanceFmt
      text .openingSizeX  'Xlength:' tagwidth 6 anchor top + left + right at xmin ymin callback '!this.openingSize()' width 21 is REAL format !!distanceFmt
      text .openingSizeY  'Ylength:' tagwidth 6 anchor top + left + right at xmin ymax callback '!this.openingSize()' width 21 is REAL format !!distanceFmt

      -- Apply Changes
      paragraph .modOpeningAcceptIcon              anchor top + left                   at x0                     ymax+0.5            pixmap width 16 height 16
      button .modOpeningAccept  linkLabel 'Accept Changes' anchor top + left            at xmax+0.5               ymin                callback '!this.modifyOpening()' width 10

      -- Discard Changes
      paragraph .modOpeningDiscardIcon             anchor top + right                  at xmax+4                 ymin                pixmap width 16 height 16
      button .modOpeningDiscard linkLabel 'Discard Changes' anchor top + right         at xmax+0.5               ymin                callback '!this.discardModifyOpening()' width 10

      paragraph .modOpeningBackIcon                        anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      button .modOpening   linkLabel  'Back to Openings'                at xmax+1                 ymin                callback '!this.pltFrmOpeningsModify(!this.definition.dbElement)'

    exit

    frame .crtOpeningPane panel                            anchor top + left + right   at xmin.modOpeningPane           ymin.modOpeningPane

      button .crtOpeningShape linkLabel  'Define Opening geometry:' anchor t + l    at xmin                   ymax+0.2            callback '!this.geometryOpeningPltFrm()' width 28
      paragraph .crtOpeningShapeDef                         anchor top + left + right   at xmin+2                 ymax                width 28 lines 1

      -- Create opening
      paragraph .crtOpeningAcceptIcon                      anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
      button .crtOpeningAccept linkLabel 'Create Opening'  anchor top + left           at xmax+0.5               ymin+0.1            callback '!this.createOpening()'


      paragraph .openingBackIcon                           anchor top + left           at x0                     ymax+0.5            pixmap width 15 height 15
      button .openingMain   linkLabel   'Back to Openings'                             at xmax+1                 ymin                callback '!this.pltFrmOpeningsModify(!this.definition.dbElement)'

    exit

  exit


  -- set form tracking
  track    'DESICE'    callback '!this.trackDb()'

  -- Form Members
--  using namespace 'PositionControl'
  using namespace 'Aveva.Pdms.Presentation'

  member .pltFrmPosition is POSITIONCONTROL

  member .neOpeningsPltFrm      is NETGRIDCONTROL

  -- reference to structure where the platform to be created
  member .stru is DBREF

  -- Current Task Pane within Form
  member .currentPane     is GADGET
  member .currentTask     is BLOCK
  member .refreshTask     is BLOCK

  -- Warning action
  member .warningAction   is BLOCK

  -- Undo for form
  member .undo            is UNDOABLE

  -- EDG Description
  member .edgDescription  is STRING

  -- Aid Numbers
  member .aidAxes         is REAL
  member .outerBoundary   is REAL
  member .innerBoundaries is REAL
  member .aidNumber       is REAL

  member .modifymode      is BOOLEAN

  -- Current Element (platform)
  member .element         is DBREF
  member .definition      is DBEPLTFRM

  member .currentOpeningNumber is REAL

  member .posType         is STRING

  -- controls if the sections to be connected
  member .connectSections        is BOOLEAN

  -- temporary working data
  member .currentVertex is REAL
  member .currentPathId   is REAL
  member .tmpPath is ARRAY

  -- If the form should be should be managed for serialisation, i.e. if it is shown
  -- on exiting the system and show be redisplayed on the next entry in to the system,
  -- then the form should be registered.
  -- Register the form
  --!!appFormCntrl.registerForm(!this)

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslPltFrm
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslPltFrm()

   using namespace 'Aveva.Pdms.Presentation'

  !this.initCall = '!this.init()'
  -- Set form to autoscroll
  !this.autoScroll              = true

  !this.modifymode = false

  !this.area.modifiedEvents   = true
  !this.number.modifiedEvents   = true

  -- Setup dummy default task
  !this.currentTask             = object BLOCK('!this.dummy()')
  !this.refreshTask             = object BLOCK('!this.dummy()')

  -- connection flag
  !this.connectSections = false

  -- Initialise task panes
  !this.mainTasks(true)
  !this.createPltFrm(false)
  !this.modifyPltFrm(false)
  !this.modGeometry.visible = false
  !this.openingsPane.visible = false
  !this.openingPane.visible = false

  -- Set "Back" icon
  !backIcon                     = !!pml.getPathname('back.png')
  !this.crtBackIcon.addPixmap(!backIcon)
  !this.modBackIcon.addPixmap(!backIcon)
  !this.exitIcon.addPixmap(!backIcon)
  !this.gModBackIcon.addPixmap(!backIcon)
  !this.openingsBackIcon.addPixmap(!backIcon)
  !this.openingBackIcon.addPixmap(!backIcon)
  !this.modOpeningBackIcon.addPixmap(!backIcon)

  -- Create Icons
  !createIcon                   = !!pml.getPathname('create.png')
  !this.crtAcceptIcon.addPixmap(!createIcon)
  !this.crtOpeningAcceptIcon.addPixmap(!createIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getPathname('accept.png')
  !this.gModAcceptIcon.addPixmap(!acceptIcon)
  !this.modAcceptIcon.addPixmap(!acceptIcon)
  !this.modOpeningAcceptIcon.addPixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getPathname('discard.png')
  !this.gModDiscardIcon.addPixmap(!discardIcon)
  !this.modDiscardIcon.addPixmap(!discardIcon)
  !this.modOpeningDiscardIcon.addPixmap(!discardIcon)


  -- EDG Description
  !this.edgDescription    = 'ASL Platform Definition'

  -- Assign aid numbers for form
  !this.aidAxes           = !!aidNumbers.add('Platform - Axes')
  !this.outerBoundary     = !!aidNumbers.add('Platform - OuterBoundary')
  !this.innerBoundaries   = !!aidNumbers.add('Platform - InnerBoundaries')
  !this.aidNumber         = !!aidNumbers.add('Platform - EDG graphics')

  !this.currentPathId = 0
  !this.currentVertex = 0

  -- Set option gadget for position type
  !types = ARRAY()
  !types.append('FFL')
  !types.append('TOS')
  !this.opPosType.dtext = !types

  !this.opPosType.val = 1

  --****START POSITION CONTROL SECTION****--
  -- Load ship grid data for use with positioning controls (may be this should be a function?)
  !grid                     = object SHIPGRID()
  !gridDefined              = !grid.position.set()

  -- Only populate the grid data is available
  if(!gridDefined) then
    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo
  endif

  -------------------- Setup for position control ----------------------
  -- Declare namespace where position control exists
  using namespace 'PositionControl'

  -- Modify BBLOCK position
  !this.pltFrmPosition          = object POSITIONCONTROL()

  -- Set grid data (should put all control grid setups in here
  if(!gridDefined) then
    !this.pltFrmPosition.gridData(!xGridData,!yGridData,!zGridData)
    !this.pltFrmPosition.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
  else
    !this.pltFrmPosition.gridVisible(false)
  endif

  -- Assign action to be taken when position is changed
  !this.pltFrmPosition.changeAction('!!aslPltFrm.setPosition()')

  -- Initialise Gadgets
  !this.pltFrmPosition.forceXYZ(0,0,0)

  -- Add PMLNet control to PML frame
  !this.pltFrmEditPosNetFrame.control  = !this.pltFrmPosition.handle()

  -- Set position control to be show in the correct form
  -- Add all control into this block
  var !coordinate coordinate
  if(!gridDefined.and(!coordinate.eq('XYZ'))) then
    !this.pltFrmPosition.gridFormat()
  else
    !this.pltFrmPosition.enuFormat()
  endif

  --****END POSITION CONTROL SECTION****--

  -- create instance of .Net control for the openings
  !this.neOpeningsPltFrm = object NETGRIDCONTROL()

  -- add PML event handlers to .Net control for the openings
  --!this.neOpeningsPltFrm.addeventhandler('AfterCellUpdate',   !this, 'modifyOpeningsPltFrm')
  !this.neOpeningsPltFrm.addeventhandler('AfterSelectChange', !this, 'selectOpeningsPltFrm')
  !this.neOpeningsPltFrm.columnExcelFilter(false)
  !this.neOpeningsPltFrm.outlookGroupStyle(false)
  !this.neOpeningsPltFrm.fixedHeaders(true)
  !this.neOpeningsPltFrm.fixedRows(true)
  !this.neOpeningsPltFrm.editableGrid(false)
  !this.neOpeningsPltFrm.singleRowSelection(true)
  !this.neOpeningsPltFrm.headerSort(false)

  -- add .Net control to PML container for the openings
  !this.coOpeningsPltFrm.control = !this.neOpeningsPltFrm.handle()

endmethod
-- End of method

