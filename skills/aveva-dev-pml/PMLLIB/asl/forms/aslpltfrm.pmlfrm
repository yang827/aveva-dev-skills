------------------------------------------------------------------------
--
-- Method:      connectSections
--
-- Description: set connection toggles on all panels
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      toggle from which the method is run
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectSections(!toggle is GADGET)

  !connect = !toggle.val

  !this.connectSections(!connect)

  if defined(!!aslpltfrmlayout) then
    !!aslpltfrmlayout.connectSections.val = !connect
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      connectSections
--
-- Description: set connection flag on all panels
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     connection flag
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectSections(!connect is BOOLEAN)

  !this.connectSections = !connect
  !this.definition.intFrame.connectSections = !connect

  !this.modGeomConnect.val = !connect
  !this.openingsConnect.val = !connect
  !this.modOpeningConnect.val = !connect

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mainTasks
--
-- Description: Set main tasks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainTasks(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.mainTaskPane

    -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.mainTasks(false)')
    !this.refreshTask         = object BLOCK('!this.dummy()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Main Platform Tasks'

  endif

  -- Show/hide task pane
  !this.mainTaskPane.visible = !active
  !this.trackDb()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createPltFrm
--
-- Description: Display platform pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createPltFrm(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.createPltFrm(false)')
    --!this.refreshTask         = object BLOCK('!this.create()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Create Platform'

    -- Manage create/modify panels
    !this.modPane.visible     = false
    !this.crtPane.visible     = true
    !this.modifymode = false
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
    -- remove EDG packet from stack
    !!edgCntrl.remove(!this.edgDescription)
  endif

  -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyPltFrm
--
-- Description: Display platform pane in modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyPltFrm(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.editPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.modifyPltFrm(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Platform Definition'

    -- Manage create/modify panels
    !this.modPane.visible     = true
    !this.crtPane.visible     = false
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
    -- remove EDG packet from stack
    !!edgCntrl.remove(!this.edgDescription)
  endif

  -- Show/hide task pane
  !this.editPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pltFrmCreate
--
-- Description: Create Platform
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pltFrmCreate()

  -- check if storage area STRU) is set
  if !this.stru.badref() then
    !this.mainTasks(true)
    !!alert.error('Invalid hierarchy to create PLTFRM.')
    return
  endif

  -- Initialise Variables
  -- Set definition
  !this.definition            = object DBEPLTFRM()

  !this.crtShapeDef.val       = 'None currently defined'

  !this.opPosType.val = 1

  -- draw platform aid lines (or just origin as no shape at first)
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary)
  --!this.definition.draw()

  -- Setup panes
  !this.createPltFrm(true)

  -- update the (NEW) gadgets (after switching panes, for positioning control to update correctly)
  !this.updateAttributes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pltFrmModify
--
-- Description: Setup to modify platform
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Platform to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .pltFrmModify(!element is DBREF) is BOOLEAN

  -- Check PLTFRM has been passed
  if(!element.fulltype.neq('PLTFRM')) then
    !!error.text            = 'Element "' & !element.namn & '" is not a Platform.'
    return false
  endif

  -- Load current BBlock
  !this.element             = !element

  -- Set definition
  !this.definition          = object DBEPLTFRM(!element)

  -- set undo object
  !callback = !this.fullname() & '.undo(''' & !element.string() & ''')'
  !this.undo.undoaction(!callback)
  !this.undo.redoaction(!callback)

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary)

  -- Setup panes
  !this.modifyPltFrm(true)

  !this.opPosType.val = !this.opPosType.dtext.findfirst(!this.definition.posType)

  -- Update gadgets
  !this.updateAttributes()

  return true

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      pltFrmOpeningsModify
--
-- Description: Setup to modify platform openings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      Platform opening to modify
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .pltFrmOpeningsModify(!element is DBREF) is BOOLEAN

  -- Check PLTFRM has been passed
  if(!element.fulltype.neq('PLTFRM')) then
    !!error.text            = 'Element "' & !element.namn & '" is not a Platform.'
    return false
  endif

  -- set reference to platform
  !this.element             = !element

  -- Set definition
  !this.definition          = object DBEPLTFRM(!element)
  !this.definition.tagOrigin = false

  !this.connectSections(!this.connectSections)
  !this.openingsConnect.active = !this.definition.intFrame.detailPresent()

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary)

  -- Setup panes
  -- Switch to openings pane, this should also load array of openings into grid
  !this.openingsPltFrm(true)

  -- Update openings gadgets (grid of openings from definition.openings)
  !this.updateOpeningsAttributes()

  -- Tag openings with number
  !this.definition.tagOpenings()

  -- set undo object
  !callback = !this.fullname() & '.undo(''' & !element.string() & ''')'
  !this.undo.undoaction(!callback)
  !this.undo.redoaction(!callback)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pltFrmGeometry
--
-- Description: Switch to geometry modification pane for current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pltFrmGeometry()

  !platform = PLTFRM
  handle ANY
    !!alert.error('Not below PLTFRM hierarchy')
    return
  endhandle

  !this.pltFrmGeometry(!platform)


endmethod

------------------------------------------------------------------------
--
-- Method:      pltFrmGeometry
--
-- Description: Switch to geometry modification pane for specified element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pltFrmGeometry(!element is DBREF)

  -- Get room info
  !this.element             = !element

  -- Set definition
  !this.definition          = object DBEPLTFRM(!element)
  !this.definition.tagOrigin = false

  !this.connectSections(!this.connectSections)
  !this.modGeomConnect.active = !this.definition.intFrame.detailPresent()

  -- set undo object
  !callback = !this.fullname() & '.undo(''' & !element.string() & ''')'
  !this.undo.undoaction(!callback)
  !this.undo.redoaction(!callback)

  -- set current vertex
  !this.currentPathId = 0
  !this.currentVertex = !this.definition.rpath.vertex.minIndex()

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary)

  -- Edit panel title
  --!this.geomTitle.val       = 'Modify Platform: ' & !this.element.namn
  !dtext[1] = 'Platform (' & !this.element.namn & ')'
  do !c indices !this.definition.dbElementOpenings
    !dtext.append('Opening ' & !c & ' (' & !this.definition.dbElementOpenings[!c].namn & ')')
  enddo

  !this.entity.dtext = !dtext
  !this.entity.val = 1

  -- Display pane
  !this.pltFrmGeometry(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pltFrmGeometry
--
-- Description: Switch to geometry modification pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Switch modification pane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pltFrmGeometry(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.modGeometry

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.pltFrmGeometry(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Platform Geometry'

    -- Draw
    !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary)
    !this.definition.draw()

  -- Actions when task pane is made inactive
  else
    -- remove EDG packet from stack
    !!edgCntrl.remove(!this.edgDescription)
    !this.definition.tidy()
    !!aidNumbers.hide(!this.aidNumber)
  endif

  -- Show/hide task pane
  !this.modGeometry.visible   = !active

  -- handle panel buttons
  !this.modGeometryButtons()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      updateAttributes
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAttributes()

  -- Set values of gadgets from platform object

  !this.txNameCreatePltFrm.val      = !this.definition.name
  !this.txDescCreatePltFrm.val  = !this.definition.description
  !this.number.val = !this.definition.number
  !this.area.val  = !this.definition.area

  -- thickness (height)

  !this.txThicknessCreatePltFrm.val          = !this.definition.height
  !detailed = !this.definition.extFrame.detailPresent().or(!this.definition.intFrame.detailPresent())
  !this.txThicknessCreatePltFrm.active = !detailed.not()

  -- position

  !position                       = !this.definition.position.wrt(World)

  !this.pltFrmPosition.forceXYZ(!position.east, !position.north, !position.up)

  -- Get orientation
  !direction              = !this.definition.direction()
  !this.prmDir.val        = !direction.string().before('WRT').trim()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateOpeningsAttributes
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateOpeningsAttributes()

  using namespace  'Aveva.Pdms.Presentation'

  !posFmt     = !!distanceFmt
  !posFmt.dp  = 0

  --set the headings of the access-list
  !heading[1] = 'No'
  !heading[2] = 'Name'

  !title      = 'Openings'

  !openings = !this.definition.dbElementOpenings

  !columns              = object ARRAY()
  do !i index !openings
    !columns[!i] = object ARRAY()
    !columns[!i].append(!i.string())

    !columns[!i].append(!openings[!i].namn)

  enddo

  !netDataSource = object NETDATASOURCE(!title, !heading, !columns)
  !this.neOpeningsPltFrm.bindToDataSource(!netDataSource)

  !number = !this.currentOpeningNumber
  if !number.set() then
    if !number.gt(!this.definition.openings.size()) then
      !number = !this.definition.openings.size()
    endif
    if !number.eq(0) then
      !number = 1
    endif
  else
    !number = 1
  endif

  !this.currentOpeningNumber = !number
  !this.neOpeningsPltFrm.selectRow(!number)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateOpeningAttributes
--
-- Description: Update gadgets with object data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateOpeningAttributes()

  -- Set values of gadgets from platform object for opening
  !number = !this.currentOpeningNumber
  !pos = !this.definition.openingsPos[!number].wrt(!this.element)

  --x and y position gadgets
  !xy = !this.definition.plane().xyOffset(!pos)

  !this.xOpening.val = !xy.x
  !this.yOpening.val = !xy.y

  -- radius
  !radius = !this.definition.radius(!number)
  !this.openingRadius.visible = !radius.set()
  !this.openingRadius.val = !radius

  -- XY size
  !xySize = !this.definition.xySize(!number)
  !this.openingSizeX.visible = !xySize.set()
  !this.openingSizeX.val = !xySize.x
  !this.openingSizeY.visible = !xySize.set()
  !this.openingSizeY.val = !xySize.y

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     flag indicating if geometry to be updated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify(!modifyGeometry is BOOLEAN)

  -- Define UNDO Information
  !this.undo.description('Modify platform (' & !this.element.namn & ')')
  !this.undo.add()

  -- Modify Platform
  !this.definition.updateDb(!modifyGeometry)

  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod
------------------------------------------------------------------------
--
-- Method:      modifyOpening
--
-- Description: Modify opening (write modified values to DB)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyOpening()

  -- Define UNDO Information
  !this.undo.description('Modified opening')
  !this.undo.add()

  !ce = !!ce

  -- Modify Platform
  !this.definition.modifyOpening(!this.currentOpeningNumber)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !!ce = !ce
  handle ANY
  endhandle

  -- Set end mark for UNDO
  !this.undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modgeometry
--
-- Description: Define geometry for element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modGeometry()

  -- Define data to pass to shape definition form
  !plane  = !this.definition.plane()

  !shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)

  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form for return to bblock creation
  -- Information for form is:
  --   Calling form
  --   Form title
  --   Apply tag (Test for "apply" button)
  --   Action on completion, method name only, method must be in format
  --      .methodName(<SHAPEDEFINITION>)
  --   Default shape, should be at least pos and ori of the plane the
  --   shape is to be mapped onto.
  !!shapeDefinitionEditor.setup(!this, 'Title', 'Define Boundary', 'modGeometryUpdate', !shape)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: Check name is a valid new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkName(!gadget is GADGET, !oldname is STRING)

  -- Initialise Variables
  !newname = !gadget.val.trim()

  if !newname.empty() then
    !gadget.val = ''
    !this.definition.name = STRING()
    return
  endif

  if !newname.eq('/') then
    !gadget.val = !oldname
    return
  endif

  -- If gadget name is same as original name, then do nothing.
  if !newname.eq(!this.definition.name) then
    return
  endif

  -- Check if name already exists
  !name           = !!checkName(!newname, 'NEW')

  -- Name already exists, set gadget to "unset"
  if(!name.unset()) then
    !gadget.val   = !oldname
  else
    !gadget.val   = !name
  endif

  !this.definition.name = !name

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickOffset
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickOffset()

  -- Initialise Variables
  !prompt               = 'Pick platform origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.offset(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Map picked position to opening covering offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!data is EDGPOSITIONDATA)

  -- Initialise Variables
  !this.definition.xyOffset(!data.position)

  -- Update gadget
  !this.xOffset.val = !this.definition.xyOffset[1]
  !this.yOffset.val = !this.definition.xyOffset[2]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deletePltFrm
--
-- Description: Delete PLTFRM
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deletePltFrm()

 !undo = object UNDOABLE()
 !undo.description('Delete Platform')
 !undo.add()

  -- check if you are below a PLTFRM element
  PLTFRM
  handle ANY
    !!alert.warning('Not below PLTFRM hierarchy')
    return
  endhandle

  call !!aslEnhance(!!ce)
  if ( !!alert.confirm('Do you really want to delete the current platform?').eq('NO') ) then
    call !!aslUnEnhance(!!ce)
    return
  endif

  DELETE PLTFRM

  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()

  !undo.endUndoable()

  --using delete manager version below

  -- check if you are below a PLTFRM element
  --PLTFRM
  --handle ANY
    --!!alert.warning('Not below PLTFRM hierarchy')
    --return
  --endhandle

  -- Delete current element
  --if(!!accDeleteManager.deleteElement(!!ce).not()) then
    --!!accErrorDisplay.errors('Delete Errors', !!accDeleteManager.errors())
  --endif

endmethod

------------------------------------------------------------------------
--
-- Method:      deletePltFrmDetail
--
-- Description: Delete platform detail (INTFRM, EXTFRM, PLTGRD)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      type of element to be deleted
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deletePltfrmDetail(!type is STRING)


 !element = object ELEMENTTYPE(!type)
 !descType = !element.description()

  -- check if you are below a PLTFRM element
  !pltfrm = !!dtbGetOwnerType(ce,'PLTFRM')
  if !pltfrm.unset() then
    !!alert.error('Not below PLTFRM hierarchy')
    return
  endif

  !!ce = !!dtbMemberOfType(!pltfrm,!type.upcase(),1)
  handle ANY
    !!alert.error('No ' & !descType & ' below this platform')
    return
  endhandle

  call !!aslEnhance(!!ce)
  if !!alert.confirm('Do you really want to delete ' & !descType & ' of the current platform?').boolean().not() then
    call !!aslUnEnhance(!!ce)
    return
  endif

 !undo = object UNDOABLE()
 !undo.description('Delete Platform ' & !descType)
 !undo.add()

  DELETE $!!ce.type

  !undo.endUndoable()

endmethod

------------------------------------------------------------------------
--
-- Method:      deletePlopen
--
-- Description: Delete PLOPEN
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deletePlopen()

  if !this.neOpeningsPltFrm.getselectedrows().unset().not() then
    !number = !this.neOpeningsPltFrm.getselectedrows()[1][1].real()
  else
    return
  endif

  !refe = !!ce

  if !!alert.confirm('Do you really want to delete the current platform opening?').eq('NO') then
    return
  endif

  -- Define UNDO Information
  !callback = !this.fullname() & '.undo(''' & !this.element.string() & ''')'
  !this.undo.description('Created platform opening')
  !this.undo.undoaction(!callback)
  !this.undo.redoaction(!callback)
  !this.undo.add()

  !this.definition.deleteOpening(!number)

  !this.undo.endUndoable()

  !!ce = !refe
  handle ANY
  endhandle

  --update openings pane
  !this.pltFrmOpenings()

endmethod

------------------------------------------------------------------------
--
-- Method:      area
--
-- Description: set area attribute
--
-- Method Type: FProcedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      gadget running this method
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .area(!numinput is GADGET,!dummy is STRING)

  !val = !numinput.val

  !this.definition.area = !val

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      number
--
-- Description: set number attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      gadget running this method
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .number(!numinput is GADGET,!dummy is STRING)

  !val = !numinput.val

  !this.definition.number = !val

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      height
--
-- Description: set object height
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .height()

  !heig = !this.txThicknessCreatePltFrm.val
  if !heig.unset() then
    !this.txThicknessCreatePltFrm.val = !this.definition.height
    return
  endif

  !this.definition.height(!heig)
  handle ANY
    !!alert.error(!!error.text)
    !this.txThicknessCreatePltFrm.val = !this.definition.height
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: set position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setPosition()

    -- Initialise Variables

  --get array of positions from positioning control
  !positionArray       = !this.pltFrmPosition.xyz()

  --set position object with positions, wrt world
  !position       = object POSITION()
  !position.east  = !positionArray[0]
  !position.north = !positionArray[1]
  !position.up    = !positionArray[2]
  !origin = '/*'
  !position.origin = !origin.dbref().position.origin

  !this.definition.position(!position)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      radius
--
-- Description: set platform radius
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .radius()

  !pathId = !this.currentPathId

  !radius =!this.radius.val
  !oldRadius = !this.definition.radius(!pathId)
  if !radius.unset() then
    !this.radius.val = !oldRadius
    return
  endif

  !this.definition.radius(!radius,!pathId)
  handle ANY
    !!alert.error(!!error.text)
    !this.radius.val = !oldRadius
  elsehandle NONE
    !this.modGeometryButtons()
    !this.definition.draw()
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      openingRadius
--
-- Description: set opening radius
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .openingRadius()

  !radius =!this.openingRadius.val
  !opening = !this.currentOpeningNumber
  !oldRadius = !this.definition.radius(!opening)
  if !radius.unset() then
    !this.openingRadius.val = !oldRadius
    return
  endif

  !this.definition.radius(!radius,!opening)
  handle ANY
    !!alert.error(!!error.text)
    !this.openingRadius.val = !oldRadius
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      openingSize
--
-- Description: set opening XY size
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .openingSize()

  !opening = !this.currentOpeningNumber
  !oldSize = !this.definition.xySize(!opening)
  !xsize = !this.openingSizeX.val
  !ysize = !this.openingSizeY.val

  if !xsize.unset() then
    !this.openingSizeX.val = !oldSize.x
    return
  elseif !ysize.unset() then
    !this.openingSizeY.val = !oldSize.y
    return
  endif

  !this.definition.xySize(!xsize,!ysize,!opening)
  handle ANY
    !!alert.error(!!error.text)
    !this.openingSizeX.val = !oldSize.x
    !this.openingSizeY.val = !oldSize.y
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xySize
--
-- Description: set XY size of platform
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .xySize()

  !pathId = !this.currentPathId

  !oldSize = !this.definition.xySize(!pathId)
  !xsize = !this.sizeX.val
  !ysize = !this.sizeY.val

  if !xsize.unset() then
    !this.sizeX.val = !oldSize.x
    return
  elseif !ysize.unset() then
    !this.sizeY.val = !oldSize.y
    return
  endif

  !this.definition.xySize(!xsize,!ysize,!pathId)
  handle ANY
    !!alert.error(!!error.text)
    !this.sizeX.val = !oldSize.x
    !this.sizeY.val = !oldSize.y
  elsehandle NONE
    !this.modGeometryButtons()
  endhandle


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      geometryPltFrm
--
-- Description: go to shape definition editor pane to define platform geometry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .geometryPltFrm()

  -- add this form to the form manager stack
  if undefined(!!accTaskManager) then
    !!accTaskManager = object ACCTASKMANAGER()
  endif
  !!accTaskManager.active = !this

   -- Define data to pass to shape definition form
  !plane  = !this.definition.plane()

  if !this.definition.posType.eq('TOS') then
    !planePos = !plane.position
    !planeUp = !planePos.up
    !planeUp = !planeUp - !this.definition.height
    !planePos.up = !planeUp
    !plane.position = !planePos
  endif

  !shape  = object SHAPEDEFINITION(!plane.position, !plane.orientation)

  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form for return to bblock creation
  -- Information for form is:
  --   Calling form
  --   Form title
  --   Apply tag (Test for "apply" button)
  --   Action on completion, method name only, method must be in format
  --      .methodName(<SHAPEDEFINITION>)
  --   Default shape, should be at least pos and ori of the plane the
  --   shape is to be mapped onto.
  !!shapeDefinitionEditor.setup(!this, 'Define Platform Boundary', 'Define Platform Boundary', 'geometryPltFrmUpdate', !shape)

endmethod
------------------------------------------------------------------------
--
-- Method:      geometryPltFrmUpdate
--
-- Description: return from shape form by press of ACCEPT
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .geometryPltFrmUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  --set shape type in platform create form
  !this.crtShapeDef.val       = !shapeDefinition.description

  !position                       = !shapeDefinition.profile.position.wrt(world)
  --!this.definition.position(!position)
  --!position                       = !this.definition.position.wrt(World)

  if !this.definition.posType.eq('TOS') then
    --!position = !this.definition.position.wrt(World)
    !up = !position.up
    !up = !up + !this.definition.height
    !position.up = !up

  endif

  !this.definition.position(!position)
  !shapeDefinition.profile.position = !position
  !this.definition.rpath = object ASLRPATH(!shapeDefinition.profile)
  !this.definition.rpath.close()

  !this.updateAttributes()

  --TODO remember to update handrail too when it's there

  !this.definition.draw()

endmethod
------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Set direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction()

  -- init
  !oldDir = !this.definition.direction().string().before('WRT').trim()

  -- Get direction from gadget
  !strdir  = !this.prmDir.val.trim()
  if !strdir.empty() then
    !this.prmDir.val = !oldDir
    return
  endif

  !dir = !strdir.direction()
  handle ANY
    !!alert.error('Direction (e.g. N 45 E) must be typed')
    !this.prmDir.val = !oldDir
    return
  endhandle

  -- send value to the platform object
  !newDir = !this.definition.direction(!dir)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  if defined(!newDir) then
    !this.prmDir.val = !newDir.string().before('WRT').trim()
  else
     !this.prmDir.val = !oldDir
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: create platform
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .create()

  -- Check shape is defined, otherwise do not allow creation
  if !this.definition.shape().edges().unset() then
    !!alert.error('Platform geometry must be defined before platform is created')
    return
  endif

  !this.undo.description('Create platform')
  !this.undo.add()

  -- navigate to structure
  !!ce = !this.stru

  -- Create new element
  !this.definition.updateDb(false)
  handle ANY
    !!alert.error(!!error.text)
    !this.undo.endUndoable()
    return
  endhandle

  -- Switch aslpltfrm (this form) to main pane
  !this.mainTasks(true)

  if !this.displayLayout.val then
  -- Switch to layout pane
  !this.pltGrdLayout()
  endif

  -- Set end mark for UNDO
  !this.undo.endUndoable()


endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      createOpening
--
-- Description: create opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .createOpening()

  --tidy graphics
  --!this.definition.tidy()

  -- Check shape is defined, otherwise do not allow creation
  if !this.definition.openingShape.edges().unset() then
    !!alert.error('Opening geometry must be defined before opening is created')
    return
  endif

  if !this.definition.shape().isWithin(!this.definition.openingShape).not() then
    !!alert.error('Opening exceeds the platform boundary')
    return
  endif

  !ce = !!ce

  -- Define UNDO Information
  !callback = !this.fullname() & '.undo(''' & !this.element.string() & ''')'
  !this.undo.description('Created platform opening')
  !this.undo.undoaction(!callback)
  !this.undo.redoaction(!callback)
    !this.undo.add()

    -- Create new element
    !this.definition.createOpening()
  handle ANY
    !!alert.error(!!error.text)
  elsehandle NONE
    !this.currentOpeningNumber = !this.definition.openings.size()
  endhandle

  !!ce = !ce
  handle ANY
    !!ce = !this.element
  endhandle

  -- Set end mark for UNDO
  !this.undo.endUndoable()

  !this.pltFrmOpenings()


endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      handRailCreate
--
-- Description: create hand rail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .handRailCreate()

  -- check if you are below a PLTFRM element
  PLTFRM
  handle ANY
    !!alert.warning('Not below PLTFRM hierarchy')
    return
  endhandle
  !pltfrm = !!ce

  !form = !!fmsys.loadform('aslhandra')
  !form.useStoreTable = false

  !!aslHandRa('create',!pltfrm)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

endmethod

-- End of method
------------------------------------------------------------------------
--
-- Method:      handRailModify
--
-- Description: modify hand rail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .handRailModify()

  -- check if you are below a HANDRA element
  -- this could do something like find first handrail of platform
  -- of list all handrails owned by platform and allow choice
  -- for now just a pure 'modify handrail' where ce must be HANDRA or below
  HANDRA
  handle ANY
    !!alert.warning('Not below HANDRA hierarchy')
    return
  endhandle

  !!aslHandRa('modify',ce)

endmethod

-- End of method
-----------------------------------------------------------------------------------------------------------
--
-- Method:      pltFrmDefinitionPane
--
-- Description: Switch to platform definition pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pltFrmDefinitionPane(!active is BOOLEAN)

  -- Initialise Variables

  -- Make task pane active
  if(!active) then
    !this.currentTask.evaluate()
    !this.currentTask           = object BLOCK('!this.pltFrmDefinitionPane(false)')
    !this.refreshTask           = object BLOCK('!this.pltFrmDefinitionPane(true)')

  -- Make task pane inactive
  else
    --!this.currentBBlock.tidy()
  endif

  -- Show task pane
  !this.editPane.visible  = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pltFrmModify
--
-- Description: modify platform
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pltFrmModify()

    -- check if you are below a PLTFRM element
  !pltFrmRefe =  PLTFRM
  handle ANY
    !!alert.warning('Not below PLTFRM hierarchy')
    return
  endhandle

  !this.pltFrmModify(!pltFrmRefe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pltFrmOpeningModify
--
-- Description: modify platform opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pltFrmOpeningModify()

  if !this.currentOpeningNumber.unset() then
    return
  endif

  -- Setup panes
  !this.modifyOpeningPltFrm(true)

  !this.connectSections(!this.connectSections)
  !this.modOpeningConnect.active = !this.definition.intFrame.detailPresent()

  -- Update gadgets
  !this.updateOpeningAttributes()


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      discardModifyOpening
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .discardModifyOpening()

  -- reset definition
  !this.definition          = object DBEPLTFRM(!this.element)
  !this.definition.tagOrigin = false

  -- Set aid numbers
  !this.definition.aidNumbers(!this.aidAxes, !this.outerBoundary)

  -- Update openings gadgets (grid of openings from definition.openings)
  !this.updateOpeningAttributes()

  --draw opening
  !this.definition.drawOpening(!this.currentOpeningNumber)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pltFrmOpeningCreate
--
-- Description: Create platform opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pltFrmOpeningCreate()

  !this.pltFrmOpeningCreate(!this.element)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      pltFrmOpeningCreateDirect
--
-- Description: Create platform opening direct from platform pane
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pltFrmOpeningCreateDirect()

  !this.pltFrmOpenings()

  !this.pltFrmOpeningCreate(!this.element)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pltFrmOpeningCreate
--
-- Description: Setup to create platform opening
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Platform passed
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if successful
--
------------------------------------------------------------------------

define method .pltFrmOpeningCreate(!element is DBREF) is BOOLEAN

  -- Check PLTFRM has been passed
  if(!element.fulltype.neq('PLTFRM')) then
    !!error.text            = 'Element "' & !element.namn & '" is not a Platform.'
    return false
  endif

  !this.crtOpeningShapeDef.val       = 'None currently defined'

  !this.connectSections(!this.connectSections)
  !this.modOpeningConnect.active = !this.definition.intFrame.detailPresent()

  -- set undo object
  !callback = !this.fullname() & '.undo(''' & !element.string() & ''')'
  !this.undo.undoaction(!callback)
  !this.undo.redoaction(!callback)

  -- Setup panes
  !this.createOpeningPltFrm(true)

  -- Update gadgets
  !this.xOpening.val = 0
  !this.yOpening.val = 0

  -- unset opening pointer
  !this.currentOpeningNumber = REAL()

  return true

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      geometryOpeningPltFrm
--
-- Description: go to shape definition editor pane to define platform opening geometry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .geometryOpeningPltFrm()

  -- add this form to the form manager stack
  if undefined(!!accTaskManager) then
    !!accTaskManager = object ACCTASKMANAGER()
  endif
  !!accTaskManager.active = !this

   -- Define data to pass to shape definition form
  !shape  = object SHAPEDEFINITION(!this.definition.openingShape.position, !this.definition.openingShape.orientation)


  -- Show the form
  !!accTaskManager.active('shapeDefinitionEditor')

  -- Setup shape definition form for return to bblock creation
  -- Information for form is:
  --   Calling form
  --   Form title
  --   Apply tag (Test for "apply" button)
  --   Action on completion, method name only, method must be in format
  --      .methodName(<SHAPEDEFINITION>)
  --   Default shape, should be at least pos and ori of the plane the
  --   shape is to be mapped onto.
  !!shapeDefinitionEditor.setup(!this, 'Define Platform Opening Boundary', 'Define Opening Boundary', 'geometryOpeningPltFrmUpdate', !shape)

endmethod
------------------------------------------------------------------------
--
-- Method:      geometryOpeningPltFrmUpdate
--
-- Description: return from shape form by press of ACCEPT
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .geometryOpeningPltFrmUpdate(!shapeDefinition is SHAPEDEFINITION)

  -- Initialise Variable
  --set shape type in platform create form
  !this.crtOpeningShapeDef.val       = !shapeDefinition.description

  !this.definition.openingShape = !shapeDefinition.profile

  !this.definition.previewOpening()

endmethod

------------------------------------------------------------------------
--
-- Method:      pltFrmOpenings
--
-- Description: platform openings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pltFrmOpenings()

  -- check if you are below a PLTFRM element
  !pltFrmRefe = PLTFRM
  handle ANY
    !!alert.warning('Not below PLTFRM hierarchy')
    return
  endhandle

  !this.pltFrmOpeningsModify(!pltFrmRefe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createOpeningPltFrm
--
-- Description: Display openings pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createOpeningPltFrm(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.openingPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.createOpeningPltFrm(false)')
    --!this.refreshTask         = object BLOCK('!this.flrcoverModify()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Create Platform Opening'

    -- Manage create/modify panes
    !this.modOpeningPane.visible     = false
    !this.crtOpeningPane.visible     = true

    -- re-initialise opening shape
    !this.definition.openingShape = object PROFILE()
    !this.definition.openingShape.position = !this.definition.position
    !this.definition.openingShape.orientation = !this.definition.orientation
    !this.definition.previewOpening()

  -- Actions when task pane is made inactive
  else
    !this.definition.tidyOpening()
    -- remove EDG packet from stack
    !!edgCntrl.remove(!this.edgDescription)
  endif

  -- Show/hide task pane
  !this.openingPane.visible      = !active

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyOpeningPltFrm
--
-- Description: Display openings pane in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyOpeningPltFrm(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.openingPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.modifyOpeningPltFrm(false)')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Modify Openings'

    -- Manage create/modify panes
    !this.modOpeningPane.visible     = true
    !this.crtOpeningPane.visible     = false
    !this.definition.drawOpening(!this.currentOpeningNumber)

    --draw openings?

  -- Actions when task pane is made inactive
  else
    !this.definition.tidyOpening()
    -- remove EDG packet from stack
    !!edgCntrl.remove(!this.edgDescription)
  endif

  -- Show/hide task pane
  !this.openingPane.visible      = !active

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      openingsPltFrm
--
-- Description: Display openings pane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .openingsPltFrm(!active is BOOLEAN)

  -- Make task pane active
  if(!active) then

    -- Set current pane
    !this.currentPane         = !this.openingPane

     -- Run action for current pane
    !this.currentTask.evaluate()

    -- Define action to be carried out on closing pane
    !this.currentTask         = object BLOCK('!this.openingsPltFrm(false)')
    --!this.refreshTask         = object BLOCK('!this.flrcoverModify()')

    -- Change form title to reflect the active pane
    !this.formTitle           = 'Platform Openings'

  -- Actions when task pane is made inactive
  else
    !this.definition.tidy()
  endif

  -- Show/hide task pane
  !this.openingsPane.visible      = !active

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      pickPosition
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPosition()

  -- Initialise Variables
  !prompt               = 'Pick platform position'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.position(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set platform position to picked position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!data is EDGPOSITIONDATA)

  -- Initialise Variables

  !position = !data.position.wrt(World)

  -- Update pos control gadget

  --!this.pltFrmPosition.forceXYZ(!position.east, !position.north, !position.up)
  !this.pltFrmPosition.xyz(!position.east, !position.north, !position.up)

  --set position of platform from pos control values
  !this.setPosition()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectOpeningsPltFrm
--
-- Description: select opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      the selected rows
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectOpeningsPltFrm(!rows is ARRAY)

  -- exit if no selection
  if !rows.unset() then
    !this.currentOpeningNumber = REAL()
  else
    !this.currentOpeningNumber = !rows[0][1].real()
  endif

  !this.modifyOpening.active = !this.currentOpeningNumber.set()
  !this.deleteOpening.active = !this.currentOpeningNumber.set()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectEntity
--
-- Description: select entity to be modified (platform or openings)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectEntity()

  !pathId = !this.entity.val - 1
  !this.currentPathId = !pathId

  !this.currentVertex = 1

  !this.modGeometryButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pltGrdLayout
--
-- Description: switch to and initialise PLTGRD layout form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      the selected rows
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pltGrdLayout()


  -- check if you are below a PLTFRM element
  !pltfrm = PLTFRM
  handle ANY
    !!alert.warning('Not below PLTFRM hierarchy')
    return
  endhandle

  !this.hide()
  show !!aslpltfrmlayout

  !!aslpltfrmlayout.initialise(!pltfrm)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xyOpening
--
-- Description: Set xy position of opening
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .xyOpening()

  !number = !this.currentOpeningNumber
  !east = !this.xOpening.val
  !north = !this.yOpening.val

  if !number.unset() then
    !pos = !this.definition.openingShape.position.wrt(!this.element)
  else
    !pos = !this.definition.openingsPos[!number].wrt(!this.element)
  endif

  !oldpos = !pos
  !pos.east = !east
  !pos.north = !north

  -- apply position
  !this.definition.xyOpening(!number,!pos)
  handle ANY
    !!alert.error(!!error.text)
    !this.xOpening.val = !oldpos.east
    !this.yOpening.val = !oldpos.north
  endhandle

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      pickXyOpening
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickXyOpening()

  -- Initialise Variables
  !prompt               = 'Pick opening position (origin)'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.xyOpening(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      xyOpening
--
-- Description: Map picked position to room offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .xyOpening(!data is EDGPOSITIONDATA)

  -- extract position
  !pickedpos = !data.position.wrt(!this.element)

  -- Update gadget
  !this.xOpening.val = !pickedpos.east
  !this.yOpening.val = !pickedpos.north

  -- apply position to object
  !this.xyOpening()

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      changePosType
--
-- Description: Change position type (FFL or TOS)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changePosType(!gadget is GADGET)

  !datum = !gadget.dtext[!gadget.val]

  !this.definition.posType(!datum)

  !this.definition.draw()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      trackDb
--
-- Description: method to control active status of main panel buttons
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .trackDb()

  if !this.mainTaskPane.visible.not() then
    --return
  endif

  !stru = !!aslStoreTable.getStore('platform')
  handle ANY
    !stru = nulref
  endhandle

  if !stru.unset() then
    !stru = !!dtbGetOwnerType(ce,'STRU')
  endif
  !this.stru = !stru
  !struSet = !stru.set()

  !pltfrm = !!dtbGetOwnerType(ce,'PLTFRM')
  !pltfrmSet = !pltfrm.set()
  !handra = !!dtbGetOwnerType(ce,'HANDRA').set()
  !extfrm = false
  !intfrm = false
  !pltgrd = false
  !plopen = false
  if !pltfrm.set() then
    !plopen = !!collectAllFor('PLOPEN','',!pltfrm).set()
    !extfrm = !!dtbMemberOfType(!pltfrm,'EXTFRM',1).set()
    !intfrm = !!dtbMemberOfType(!pltfrm,'INTFRM',1).set()
    !pltgrd = !!dtbMemberOfType(!pltfrm,'PLTGRD',1).set()
  endif

  !this.mtCrt.active         = !struSet
  !this.mtCrtOpening.active  = !pltfrmSet
  !this.mtCrtHandRail.active = !pltfrmSet
  !this.mtMod.active         = !pltfrmSet
  !this.mtModGeometry.active = !pltfrmSet
  !this.mtPlateGrid.active   = !pltfrmSet
  !this.mtOpeningsDet.active = !plopen
  !this.mtHandRail.active    = !handra
  !this.mtDel.active         = !pltfrmSet
  !this.mtDelIntfrm.active   = !intfrm
  !this.mtDelExtfrm.active   = !extfrm
  !this.mtDelPltgrd.active   = !pltgrd

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createVertex
--
-- Description: initialise EDG mode to create new vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createVertex()

  -- Initialise Variables for EDG
  !prompt               = 'Pick position to insert new VERTEX at'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = !this.fullname() & '.createVertex(!this.return[1])'
  !packet.close         = !this.fullname() & '.createVertexClose()'
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdPosition(!prompt)
  !packet.pickPacket = !pickPacket

  -- Add event to system
  !!edgCntrl.add(!packet)

  -- make buttons inactive
  !this.modRpathNew.active = false
  !this.modRpathMoveCv.active = false
  !this.modRpathDelCv.active = false
  !this.modRpathSetCv.active = false


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createVertex
--
-- Description: create new vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   RW     EDGPOSITIONDATA   result from edg pick
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createVertex(!edgData is EDGPOSITIONDATA)


  -- get position from edg pick
  !pickedpos = !edgData.position
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !this.definition.insertVertex(!this.currentPathId,!this.currentVertex,!pickedpos)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  -- update current vertex
  !this.currentVertex = !this.currentVertex + 1

  -- update panel
  !this.modGeometryButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createVertexClose
--
-- Description: called on exit from EDG mode
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createVertexClose()

  !this.modGeometryButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteCurrentVertex
--
-- Description: delete current vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteCurrentVertex()

  if !this.currentVertex.eq(0) then
    return
  endif

  !this.currentVertex = !this.definition.deleteVertex(!this.currentPathId,!this.currentVertex)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  -- update panel
  !this.modGeometryButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      moveCurrentVertex
--
-- Description: initialise EDG mode to move current vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveCurrentVertex()

  if !this.currentVertex.eq(0) then
    return
  endif

  -- Initialise Variables for EDG
  !prompt               = 'Pick position to move current VERTEX to'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = !this.fullname() & '.moveCurrentVertex(!this.return[1])'
  !packet.close         = !this.fullname() & '.moveCurrentVertexClose()'
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdPosition(!prompt)
  !packet.pickPacket = !pickPacket

  -- Add event to system
  !!edgCntrl.add(!packet)

  -- make buttons inactive
  !this.modRpathNew.active = false
  !this.modRpathMoveCv.active = false
  !this.modRpathDelCv.active = false
  !this.modRpathSetCv.active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      moveCurrentVertex
--
-- Description: move current vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   RW     EDGPOSITIONDATA   result from edg pick
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveCurrentVertex(!edgData is EDGPOSITIONDATA)

  if !this.currentVertex.eq(0) then
    return
  endif

  -- get position from edg pick
  !pickedpos = !edgData.position
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !this.definition.moveVertex(!this.currentPathId,!this.currentVertex,!pickedpos)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  -- update panel
  !this.modGeometryButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      moveCurrentVertexClose
--
-- Description: called on exit from EDG mode
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveCurrentVertexClose()

  !this.modGeometryButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setCurrentVertex
--
-- Description: initialise EDG mode to select current vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setCurrentVertex()

  !!aidNumbers.hide(!this.aidNumber)
  !this.tmpPath = !this.drawVertices(!this.aidNumber,400mm)

  -- Initialise Variables for EDG
  !prompt               = 'Pick VERTEX to be made current'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = false
  !packet.action        = !this.fullname() & '.setCurrentVertex(!this.return[1])'
  !packet.close         = !this.fullname() & '.setCurrentVertexClose()'
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdAid(!prompt)
  !pickPacket.picks[1].prompt = ''
  !packet.pickPacket = !pickPacket

  -- Add event to system
  !!edgCntrl.add(!packet)

  !this.modGeometry.active = false


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setCurrentVertex
--
-- Description: select current vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA result from edg pick
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setCurrentVertex(!edgData is EDGPICKDATA)

  !aidType = !edgData.aidType
  !number = !edgData.point

  -- ignore invalid picks
  if !number.neq(!this.aidNumber) then
    return
  endif
  if !aidType.neq('SPHERE') then
    return
  endif

  !pickLine = !edgData.pickLine.line(100)

  !index = REAL()
  !distance = ARRAY()
  do !c indices !this.tmpPath[1]
    !vrtxPos = !this.tmpPath[1][!c]
    !distance[!c] = !pickLine.distance(!vrtxPos)
  enddo
  !index = !distance.sortedIndices().first()

  !this.currentVertex = !this.tmpPath[2][!index]
  !this.currentPathId = !this.tmpPath[3][!index]
  !this.entity.val = !this.currentPathId + 1
  !!edgCntrl.escape()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setCurrentVertexClose
--
-- Description: called on exit from EDG mode
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setCurrentVertexClose()

  !!aidNumbers.hide(!this.aidNumber)
  !this.modGeometry.active = true
  !this.modGeometryButtons()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modGeometryButtons
--
-- Description: handle buttons of .modGeometry panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modGeometryButtons()

  if !this.modGeometry.visible.not() then
    return
  endif

  if !this.currentPathId.eq(0) then
    !rpath = !this.definition.rpath
  else
    !rpath = !this.definition.openings[!this.currentPathId]
  endif

  !active = !this.definition.rpath.size().boolean()

  !this.modRpathNew.active = true
  !this.modRpathMoveCv.active = !active
  !this.modRpathDelCv.active = !active
  !this.modRpathSetCv.active = !active

  -- radius
  !radius = !this.definition.radius(!this.currentPathId)
  !this.radius.visible = !radius.set()
  !this.radius.val = !radius

  -- XY size
  !xySize = !this.definition.xySize(!this.currentPathId)
  !this.sizeX.visible = !xySize.set()
  !this.sizeX.val = !xySize.x
  !this.sizeY.visible = !xySize.set()
  !this.sizeY.val = !xySize.y

  aid clear text $!this.aidNumber
  handle ANY
  endhandle

  -- indicate current vertex
  !current = !this.currentVertex
  if undefined(!rpath.vertex[!current]) then
    !current = !rpath.vertex.minIndex()
  endif
  if !current.boolean() then
    if !current.eq(!rpath.vertex.maxIndex()).and(!rpath.vertex.maxIndex().gt(1)) then
      !current = !current - 1
    endif
    !this.currentVertex = !current
    !pos = !rpath.vertex[!current]
      !!drawAidText('Current Vertex',!pos,!this.aidNumber)
      handle ANY
      endhandle

    -- indicate next point
    !next = !rpath.nextPointOf(!this.currentVertex)
    if !next.eq(!rpath.vertex.maxIndex()).and(!rpath.vertex.maxIndex().gt(1)) then
      !next = 1
    endif
    if !next.neq(!this.currentVertex) then
      !nextpos = !rpath.vertex[!next]
      !!drawAidText('Next',!nextpos,!this.aidNumber)
      handle ANY
      endhandle
    endif
  else
    !this.currentVertex = 0
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawVertices
--
-- Description: draw all vertices
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        aid number
--    2   R      REAL        sphere diameter
--    3   R      BOOLEAN     edges between vertices to be drawn or not
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of arrays with full vertex definition (position,type, sequence )
--
------------------------------------------------------------------------

define method .drawVertices(!number is REAL,!diam is REAL) is ARRAY

  -- init
  !vertex = ARRAY()
  !sequ = ARRAY()
  !pathId = ARRAY()
  !dispSequ = ARRAY()

  -- vertices of platform boundary
  !rpath = !this.definition.rpath
  do !c indices !rpath.vertex
    skip if !rpath.type[!c].neq('POINTR')
    skip if !c.eq(!rpath.size()).and(!rpath.vertex[!c].near(!rpath.vertex[1],1mm)).and(!c.gt(1))
    !vertex.append(!rpath.vertex[!c])
    !sequ.append(!c)
    !pathId.append(0)
    !dispSequ.append(!sequ.maxIndex())
  enddo

  -- opening vertices
  do !c indices !this.definition.openings
    !count = 0
    !rpath = !this.definition.openings[!c]
    do !cc indices !rpath.vertex
      skip if !rpath.type[!cc].neq('POINTR')
      skip if !cc.eq(!rpath.size()).and(!rpath.vertex[!cc].near(!rpath.vertex[1],1mm)).and(!cc.gt(1))
      !count = !count + 1
      !vertex.append(!rpath.vertex[!cc])
      !sequ.append(!cc)
      !pathId.append(!c)
      !dispSequ.append(!count)
    enddo
  enddo

  do !c indices !vertex
    !pointPos =  !vertex[!c]
    !pointSequ = !dispSequ[!c].string()
    !!drawAidSphere(!diam, !pointPos, !number)
    !!drawAidText(!pointSequ, !pointPos, !number)
  enddo

  -- compose return array and return it
  !result[1] = !vertex
  !result[2] = !sequ
  !result[3] = !pathId
  !result[4] = !dispSequ

  return !result


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      undo
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .undo(!pltfrm is STRING)

  -- first check if layout form is displayed
  if defined(!!aslpltfrmlayout) then
    !!aslpltfrmlayout.undo(!pltfrm)
  endif

  -- check if form is displayed and is about to modify the same PLTFRM
  if !this.shown().not() then
    return
  endif
  if !this.definition.dbElement.string().neq(!pltfrm) then
    return
  endif

  -- check panels
  if !this.mainTaskPane.visible then
    return
  endif

  !pltfrmRef = !pltfrm.dbref()
  handle ANY
    return
  endhandle

  if !this.editPane.visible then
    !this.pltFrmModify(!pltfrmRef)
  elseif !this.modGeometry.visible then
    !this.pltFrmGeometry(!pltfrmRef)
  elseif !this.openingPane.visible.or(!this.openingsPane.visible) then
    !this.pltFrmOpeningsModify(!pltfrmRef)
  else
    !this.mainTasks(true)
    return
  endif

endmethod
-- End of method
