-- Description:
--   Platform layout definition form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  acceptLayout()                   -                   Create/modify PLTGRD in DB
--  aslPltFrmLayout()                -                   Constructor
--  bangle(GADGET,STRING)            -                   set beta angle
--  boundaryOffset()                 -                   set boundary offset
--  checkProfileSize(DBREF,STRING)   -                   check size of profile spec.ref. of passed profile against other profiles
--  connections()                    -                   set section connection flag
--  dismiss()                        -                   Dismiss form
--  drawFrameLines()                 -                   Draw Frame Lines (Internal frame)
--  drawGridLines()                  -                   Draw Grid Lines (Plate grid)
--  flip(GADGET,STRING)              -                   flip profiles
--  frameOffset(GADGET)              -                   Offset Frame Grid
--  frameSpacing()                   -                   Change grid spacing in object
--  getPltfrmThickness()             REAL                return the size of the biggest profile
--  getProfileSize(EXPRESSION,DBREF) REAL                evaluate passed expression passed profile to get size
--  gridAngle(GADGET,STRING)         -                   Change grid angle
--  gridOffset(GADGET)               -                   Offset Grid
--  gridSpacing()                    -                   Change grid spacing in object
--  hideGrid()                       -                   remove/add PLTGRD from drawlist
--  initialise(DBREF)                -                   Initialise form, set up DBEPLTGRD object
--  plateSpec()                      -                   set plate specification
--  plateSpref()                     -                   set plate spec.ref
--  plateSpref(DBREF)                -                   set associated gadgets
--  plateThickness()                 -
--  plateThickness(REAL,REAL)        -                   Set plate thickness of object
--  selectProfile(REAL)              -                   Select profile
--  setPlateSpref(DBREF)             -
--  setProfile(REAL)                 -
--  setProfile(REAL,PROFILECATALOGUEDATA) -                   Set profile
--  setSpecifications()              -                   set profile and connection spec. details
--  setStateGadgets()                -                   active/inactive gadgets
--  splitOnGrid(GADGET)              -                   Split on grid
--  sprefList(PROFILECATALOGUEDATA)  ARRAY
--  stringSpacingToArray(STRING)     ARRAY
--  supportsOffset()                 -                   Change angle of grid by offset
--  tidy()                           -                   Tidy aid graphics
--  tmplReference()                  -                   set template reference
--  undo(STRING)                     -
--


-- Import DLL

setup form !!aslPltFrmLayout dialog dock right

  -- Form details
  !this.formTitle    = 'Modify Platform Layout'
  !this.icontitle    = ''
  !this.callback     = ''
  !this.formrevision = ''

  -- gadgets

  paragraph .tmplRefTag   at x0.5 ymax text 'Template'
  line .tmplRefLine  anchor t+l+r at xmin ymax horizontal width 38
  option .tmplReference  anchor T+L+R  at xmin ymax+0.2 callback '!this.tmplReference()' width 34

  paragraph .layoutSupportsText                           anchor top + left    at x0.5                   ymax                text 'Frame Layout'
  line .layoutSupportsLine1                               anchor top + left + right   at xmin                   ymax                horizontal width 38

  -- Grid Angle
  numericinput .gridAngle 'Internal frame angle:' tagwidth 14   anchor top + left           at x1                     ymax+0.2            callback '!this.gridAngle('  range 90 -90 ndp 0 width 8

  text .frameXOffset   'Primary Offset:'           tagwidth  14                   anchor top + left + right   at xmin                   ymax+0.3            callback '!this.frameOffset(!this.frameXOffset)' width 22 is REAL format !!distanceFmt
  text .frameYOffset   'Intermediate Offset:'      tagwidth  14                   anchor top + left + right   at xmin                   ymax+0.1            callback '!this.frameOffset(!this.frameYOffset)' width 22 is REAL format !!distanceFmt

  text .frameXSpacing 'Primary Spacing:'     tagwidth      14                 anchor top + left + right   at xmin                 ymax+0.3                callback '!this.frameSpacing()' width 22 is STRING
  text .frameYSpacing 'Intermediate Spacing:'     tagwidth    14                   anchor top + left + right   at xmin            ymax+0.1            callback '!this.frameSpacing()' width 22 is STRING

  paragraph .bangle  anchor top+right at x30 ymax text 'Bangle' width 5
  paragraph .flipIntfrm  anchor top+right at xmax+0.5 ymin text 'Flip' width 3
  button .selectProfileA  'Primary Profile:' linklabel   anchor left + top           at xmin .frameXOffset      ymax-0.2                  callback '!this.selectProfile(1)' width 13
  option .profileA  anchor L+R+T at xmax ymin callback '!this.setProfile(1)' width 12
  numericinput .bangleA        anchor R+T at xmax+0.2 ymin  callback '!this.bangle('   range 180 -180 step 90 ndp 0 width 3
  toggle .flipPrimary       anchor top  + right    at xmax+0.3 ymin callback '!this.flip('

  button .selectProfileB  'Intermediate Profile:' linklabel   anchor left + top           at xmin.frameXOffset ymax                  callback '!this.selectProfile(2)' width 13
  option .profileB  anchor L+R+T at xmax ymin callback '!this.setProfile(2)' width 12
  numericinput .bangleB   anchor R+T at xmin.bangleA ymin  callback '!this.bangle('   range 180 -180 step 90 ndp 0 width 3
  toggle .flipSecondary        anchor top  + right    at xmax+0.3 ymin callback '!this.flip('

  button .selectProfileC  'Opening Frame:'     linklabel   anchor left + top           at xmin.frameXOffset   ymax                 callback '!this.selectProfile(3)' width 13
  option .profileC  anchor L+R+T at xmax ymin callback '!this.setProfile(3)' width 12
  numericinput .bangleC   anchor R+T at xmin.bangleA ymin  callback '!this.bangle('   range 180 -180 step 90 ndp 0 width 3
  toggle .flipOpening       anchor top  + right    at xmax+0.3 ymin callback '!this.flip('

  button .selectProfileD  'External Frame:' linklabel   anchor left + top           at xmin.frameXOffset      ymax                 callback '!this.selectProfile(4)' width 13
  option .profileD  anchor L+R+T at xmax ymin callback '!this.setProfile(4)' width 12
  numericinput .bangleD   anchor R+T at xmin.bangleA ymin  callback '!this.bangle('   range 180 -180 step 90 ndp 0 width 3
  toggle .flipExternal   anchor top  + right    at xmax+0.3 ymin callback '!this.flip('

  button .addRemSegment  'Add/Remove Frame Segment...' linklabel anchor L+T  at xmin.frameXOffset ymax width 19 form !!aslExtfrm
  toggle .connectSections 'Connect sections' tagwidth 15 anchor top + left   at xmin     ymax+0.2            callback '!this.connections()'

  toggle .drawPrimaryLines 'Draw primary span grid lines' tagwidth 20 anchor top + left     at xmin         ymax            callback '!this.drawFrameLines()'

  toggle .drawSecondaryLines 'Draw intermediate span grid lines' tagwidth 22 anchor top + left   at xmin                ymax            callback '!this.drawFrameLines()'

  paragraph .layoutText                           anchor top + left   at x0.5                   ymax+0.4                text 'Plate Layout'
  line .layoutLine1                               anchor top + left + right   at xmin                   ymax                horizontal width 38

  option .plateSpec    'Specification:'   tagwidth 12    anchor top + left + right   at xmin.frameXOffset           ymax+0.2            callback '!this.plateSpec()' width 21

  text .plateThickness 'Plate Thickness:' tagwidth 12    anchor top + left + right   at xmin.frameXOffset           ymax+0.1            callback '!this.plateThickness()' width 23 is REAL format !!distanceFmt
  option .plateSpref   'Plate Thickness:' tagwidth 12    anchor top + left + right   at xmin ymin      callback '!this.plateSpref()' width 21

  option .layoutSupportsOffset tagwidth 12  'Plate x axis with:'                           anchor top + left + right   at xmin+0.1              ymax                callback '!this.supportsOffset()' width 21

  -- boundary offset
  text .boundaryOffset 'Offset from edge:'     tagwidth 12           anchor top + left + right   at xmin                 ymax+0.1            callback '!this.boundaryOffset()' width 23 is REAL format !!distanceFmt

  -- Grid Offset

  text .gridXOffset   'Offset X:'      tagwidth 12      anchor top + left + right   at xmin                   ymax+0.3            callback '!this.gridOffset(!this.gridXOffset)' width 23 is REAL format !!distanceFmt
  text .gridYOffset   'Offset Y:'      tagwidth 12      anchor top + left + right   at xmin                   ymax+0.1            callback '!this.gridOffset(!this.gridYOffset)' width 23 is REAL format !!distanceFmt

  text .gXSpacing 'Size X:'         tagwidth 12        anchor top + left + right   at xmin                 ymax+0.3            callback '!this.gridSpacing()' width 23 is STRING format !!distanceFmt
  text .gYSpacing 'Size Y:'         tagwidth 12        anchor top + left + right   at xmin                 ymax+0.1            callback '!this.gridSpacing()' width 23 is STRING format !!distanceFmt

  toggle .splitOnGridToggle 'Split on grid' tagwidth 12 anchor top + left   at xmin                 ymax+0.2            callback '!this.splitOnGrid(!this.splitOnGridToggle)'

  toggle .drawGridLines 'Draw grid lines' anchor top + left    at xmin                 ymax            callback '!this.drawGridLines()'

  toggle .hideGrid 'Hide panels' anchor top + left at xmin ymax callback '!this.hideGrid()'

  -- Accept Changes
  paragraph .acceptIcon                         anchor top + left           at x0                     ymax+1              pixmap width 16 height 16
  button .accept  linkLabel 'Accept Changes'    anchor top + left           at xmax+0.5               ymin                callback '!this.acceptLayout()' width 10

  -- Discard Changes
  paragraph .discardIcon                        anchor top + right          at xmax+4                 ymin                pixmap width 16 height 16
  button .discard linkLabel 'Discard Changes'   anchor top + right          at xmax+0.5               ymin                callback '!this.initialise(!this.platform)' width 10

  paragraph .backIcon                            anchor top + left           at x0                     ymax+0.5            pixmap width 16 height 16
  button .back   linkLabel  'Back to main Platform tasks'  anchor top+left      at xmax+1                 ymin                callback '!this.dismiss()' width 17

  -- members

  -- Undo for form
  member .undo            is UNDOABLE

  -- reference to platform
  member .platform    is DBREF

  -- Plate Grid definition
  member .gridDefinition    is DBEPLTGRD

  -- Internal frame grid definition
  member .frameDefinition is DBEINTFRM

  -- External Frame definition
  member .extFrmDefinition is DBEEXTFRM

  -- assembly templates
  member .templates  is ARRAY

  -- plate spec
  member .panelSpec    is ARRAY
  member .panelSpref   is ARRAY

  -- steel profiles
  member .primary   is ARRAY
  member .secondary is ARRAY
  member .opening   is ARRAY
  member .external  is ARRAY

  member .profileData     is ARRAY
  member .profileDataGadget is ARRAY
  member .profileDataDesc   is ARRAY

  -- Aid graphics
  member .aidNumberLines          is REAL
  member .aidNumberOuter          is REAL
  member .aidNumber               is REAL

  member .aidNumberSupportLines          is REAL
  member .aidNumberSupportOuter          is REAL
  member .aidNumberSupport               is REAL

exit

------------------------------------------------------------------------
--
-- Method:      aslPltFrmLayout
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslPltFrmLayout()

  -- Cancel Callback
  !this.cancelCall              = '!this.tidy()'

  -- Set form to auto scroll
  !this.autoScroll              = true


  !this.gridAngle.modifiedEvents   = true
  !this.bangleA.modifiedEvents = true
  !this.bangleB.modifiedEvents = true
  !this.bangleC.modifiedEvents = true
  !this.bangleD.modifiedEvents = true

  -- auto connection flag
  !this.connectSections.val = false

  !this.hideGrid.val = false

  -- drawing toggles
  !this.drawGridLines.val = true
  !this.drawPrimaryLines.val = true
  !this.drawSecondaryLines.val = true

  -- Set "Back" icon
  !backIcon                     = !!pml.getpathname('back.png')

  !this.backIcon.addpixmap(!backIcon)

  -- Set "Accept" icon
  !acceptIcon                   = !!pml.getpathname('accept.png')
  !this.acceptIcon.addpixmap(!acceptIcon)

  -- Set "Discard" icon
  !discardIcon                  = !!pml.getpathname('discard.png')
  !this.discardIcon.addpixmap(!discardIcon)

  -- Aid graphics
  !this.aidNumberLines  = !!aidNumbers.add('Plate grid, grid lines')
  !this.aidNumberOuter  = !!aidNumbers.add('Plate grid, outer boundary')
  !this.aidNumber       = !!aidNumbers.add('Plate grid, grid tags')

  !this.aidNumberSupportLines  = !!aidNumbers.add('Support grid, grid lines')
  !this.aidNumberSupportOuter  = !!aidNumbers.add('Support grid, outer boundary')
  !this.aidNumberSupport       = !!aidNumbers.add('Support grid, grid tags')

  !dtext = ARRAY()
  !dtext.append('primary span')
  !dtext.append('intermediate span')

  !this.layoutSupportsOffset.dtext = !dtext

  -- declare profile data
  !this.profileData[1] = object PROFILECATALOGUEDATA()
  !this.profileData[2] = object PROFILECATALOGUEDATA()
  !this.profileData[3] = object PROFILECATALOGUEDATA()
  !this.profileData[4] = object PROFILECATALOGUEDATA()
  !this.profileDataDesc[1] = !this.selectProfileA.tag
  !this.profileDataDesc[2] = !this.selectProfileB.tag
  !this.profileDataDesc[3] = !this.selectProfileC.tag
  !this.profileDataDesc[4] = !this.selectProfileD.tag
  !this.profileDataGadget[1] = !this.profileA
  !this.profileDataGadget[2] = !this.profileB
  !this.profileDataGadget[3] = !this.profileC
  !this.profileDataGadget[4] = !this.profileD

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  !this.gridDefinition.tidy()
  !this.frameDefinition.tidy()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      connections
--
-- Description: set section connection flag
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connections()

  !flag = !this.connectSections.val

  !this.frameDefinition.connectSections = !flag

  if defined(!!aslpltfrm) then
    !!aslpltfrm.connectSections = !flag
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gridOffset
--
-- Description: Offset Grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      the gadget where the method has been called from
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridOffset(!textGadget is GADGET)

  -- Initialise Variables
  !val = !textGadget.val
  if !textGadget.eq(!this.gridXOffset) then
    !x = !val
    !y = !this.gridYOffset.val
  else
    !x = !this.gridXOffset.val
    !y = !val
  endif

  !oldX = !this.gridDefinition.grid.gridXYposition().x
  !oldY = !this.gridDefinition.grid.gridXYposition().y

  -- Offset grid (in object)
  !xy = !this.gridDefinition.gridOffset(!x,!y)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  if defined(!xy) then
    !x = !xy.x
    !y = !xy.y
  else
    !x = !oldX
    !y = !oldY
  endif

  -- set gadget value
  !this.gridXOffset.val = !x
  !this.gridYOffset.val = !y

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      supportsOffset
--
-- Description: Change angle of grid by offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .supportsOffset()

  -- Initialise Variables

  !this.gridDefinition.gridAngle(!this.gridAngle.val,!this.layoutSupportsOffset.val)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      frameOffset
--
-- Description: Offset Frame Grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      the gadget where the method has been called from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .frameOffset(!textGadget is GADGET)

  -- Initialise Variables
  !val = !textGadget.val
  if !textGadget.eq(!this.frameXOffset) then
    !primary = !val
    !secondary = !this.frameYOffset.val
  else
    !primary = !this.frameXOffset.val
    !secondary = !val
  endif

  !oldSecondary = !this.frameDefinition.grid.gridXYposition().x
  !oldPrimary = !this.frameDefinition.grid.gridXYposition().y

  -- Offset grid (in object)
  !xy = !this.frameDefinition.gridOffset(!secondary,!primary)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  if defined(!xy) then
    !primary = !xy.y
    !secondary = !xy.x
  else
    !primary = !oldPrimary
    !secondary = !oldSecondary
  endif

  -- set gadget value
  !this.frameXOffset.val = !primary
  !this.frameYOffset.val = !secondary

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundaryOffset
--
-- Description: set boundary offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundaryOffset()

  !offset = !this.boundaryOffset.val
  if !offset.unset() then
    !this.boundaryOffset.val = !this.gridDefinition.bndoff
    return
  endif

  !this.gridDefinition.boundaryOffset(!offset)
  handle ANY
    !!alert.error(!!error.text)
    !this.boundaryOffset.val = !this.gridDefinition.bndoff
    return
  endhandle

  !this.gridDefinition.boundaryOffset(!offset)

endmethod
-- End of method

------------------------------------------------------------------------
-- Method:      drawGridLines
--
-- Description: Draw Grid Lines (Plate grid)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawGridLines()

  -- Initialise Variables

  !this.gridDefinition.tidy()

  if !this.drawGridLines.val.eq(false) then
    --unset draw number
    !this.gridDefinition.aidNumbersUnset()
  else
    --set draw number
    !this.gridDefinition.aidNumbers(!this.aidNumber, !this.aidNumberLines, !this.aidNumberOuter)
  endif

  --run draw on gridDefinition

  !this.gridDefinition.draw()

endmethod
-- End of method
------------------------------------------------------------------------
-- Method:      drawFrameLines
--
-- Description: Draw Frame Lines (Internal frame)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawFrameLines()

  -- Initialise Variables

  !this.frameDefinition.tidy()

  --re-set all draw numbers to active

  !this.frameDefinition.aidNumbers(!this.aidNumberSupport, !this.aidNumberSupportLines, !this.aidNumberSupportOuter)

  if !this.drawPrimaryLines.val.eq(false) then
    --unset draw number
    !this.frameDefinition.aidNumbersUnsetX()
  else
    --set draw number
    --!this.frameDefinition.aidNumbers(!this.aidNumberSupport, !this.aidNumberSupportLines, !this.aidNumberSupportOuter)
  endif

  if !this.drawSecondaryLines.val.eq(false) then
    --unset draw number
    !this.frameDefinition.aidNumbersUnsetY()
  else
    --set draw number
    --!this.frameDefinition.aidNumbers(!this.aidNumberSupport, !this.aidNumberSupportLines, !this.aidNumberSupportOuter)
  endif

  !this.frameDefinition.draw()

  --run draw on gridDefinition

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      acceptLayout
--
-- Description: Create/modify PLTGRD in DB
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .acceptLayout()

  if !this.profileA.val.eq(0) then
    !error = 'Primary profile must be selected'
  elseif !this.profileB.val.eq(0) then
    !error = 'Intermediate profile must be selected'
  elseif !this.profileC.val.eq(0).and(!this.frameDefinition.grid.innerBoundaries().set()) then
    !error = 'Opening frame profile must be selected'
  elseif !this.profileD.val.eq(0) then
    !error = 'External frame profile must be selected'
  endif

  if defined(!error) then
    !!alert.error(!error)
    return
  endif

  !assTmp = !this.templates[!this.tmplReference.val]
  !ce = !!ce

  !this.undo.add()
  !!ce = !this.platform
  assTmp $!<assTmp>
  !!ce.thickn = !this.getPltfrmThickness()
  handle ANY
  endhandle

  !this.extFrmDefinition.updateDb()
  !this.frameDefinition.updateDb()
  !this.gridDefinition.updateDb()
  !this.undo.endUndoable()

  !this.gridDefinition.hide(!this.hideGrid.val)

  !!ce = !ce
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plateThickness()
--
-- Description: Set plate thickness of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plateThickness()

  -- init
  !oldThickness = !this.gridDefinition.plateThickness
  !thickness = !this.plateThickness.val

  if !thickness.unset() then
    !this.plateThickness.val = !oldThickness
    return
  endif

  -- check the value
  if !thickness.leq(0) then
    !!alert.error('Thickness must be a positive non-zero value')
    !this.plateThickness.val = !oldThickness
    return
  endif

  !this.plateThickness(!thickness,!oldThickness)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plateThickness
--
-- Description: Set plate thickness of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        thickness
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plateThickness(!thickness is REAL,!oldThickness is REAL)

  -- init
  !diff = !thickness - !oldThickness

  --plate thickness
  !this.gridDefinition.plateThickness = !thickness
  !this.frameDefinition.platformThickness = !thickness
  if !this.gridDefinition.posType.eq('FFL') then
    !this.frameDefinition.elevation(-!diff)
    !this.extFrmDefinition.elevation(-!diff)
  else
    !this.gridDefinition.elevation(!diff)
  endif

  if !this.plateThickness.visible then
    !this.plateThickness.val = !thickness
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gridAngle
--
-- Description: Change grid angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridAngle(!gadget is GADGET,!string is STRING)

  !this.gridDefinition.gridAngle(!gadget.val,!this.layoutSupportsOffset.val)
  !this.frameDefinition.gridAngle(!gadget.val)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      splitOnGrid
--
-- Description: Split on grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitOnGrid(!toggle is GADGET)

  !split = !toggle.val

  !this.gridDefinition.splitOnGrid(!split)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gridSpacing
--
-- Description: Change grid spacing in object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridSpacing()

  -- Initialise Variables
  !oldXSpacingStr = !this.gridDefinition.stringSpacing('x')
  !oldYSpacingStr = !this.gridDefinition.stringSpacing('x')
  !xSpacingStr = !this.gXSpacing.val
  !ySpacingStr = !this.gYSpacing.val

  !xReals = !this.stringSpacingToArray(!xSpacingStr)
  !yReals = !this.stringSpacingToArray(!ySpacingStr)

  if !xReals.unset() then
    !this.gXSpacing.val = !oldXSpacingStr
    return
  endif
  if !yReals.unset() then
    !this.gYSpacing.val = !oldYSpacingStr
    return
  endif

  !newSpacing = !this.gridDefinition.gridSpacing(!xReals, !yReals)
  handle ANY
    !!alert.error(!!error.text)
    !xSpacingStr = !oldXSpacingStr
    !ySpacingStr = !oldYSpacingStr
  endhandle

  if defined(!newSpacing) then
    !xSpacingStr = !newSpacing[1]
    !ySpacingStr = !newSpacing[2]
  endif

  !this.gXSpacing.val = !xSpacingStr
  !this.gYSpacing.val = !ySpacingStr

endmethod
-- End of method
------------------------------------------------------------------------

--
-- Method:      frameSpacing
--
-- Description: Change grid spacing in object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .frameSpacing()

  -- Initialise Variables
  !oldPrimarySpacingStr = !this.frameDefinition.stringSpacing('y')
  !oldSecondarySpacingStr = !this.frameDefinition.stringSpacing('x')
  !primarySpacingStr = !this.frameXSpacing.val
  !secondarySpacingStr = !this.frameYSpacing.val

  !xReals = !this.stringSpacingToArray(!secondarySpacingStr)
  !yReals = !this.stringSpacingToArray(!primarySpacingStr)

  if !yReals.unset() then
    !this.frameXSpacing.val = !oldPrimarySpacingStr
    return
  endif
  if !xReals.unset() then
    !this.frameYSpacing.val = !oldSecondarySpacingStr
    return
  endif

  !newSpacing = !this.frameDefinition.gridSpacing(!xReals, !yReals)
  handle ANY
    !!alert.error(!!error.text)
    !primarySpacingStr = !oldPrimarySpacingStr
    !secondarySpacingStr = !oldSecondarySpacingStr
  endhandle

  if defined(!newSpacing) then
    !primarySpacingStr = !newSpacing[2]
    !secondarySpacingStr = !newSpacing[1]
  endif

  !this.frameXSpacing.val = !primarySpacingStr
  !this.frameYSpacing.val = !secondarySpacingStr

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      multiple spacing value
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       spacings as real array
--
------------------------------------------------------------------------

define method .stringSpacingToArray(!strSpacing is STRING) is ARRAY

  -- init
  !value = !strSpacing.trim().trim('L',';').trim()
  !fmt = !!distanceFmt
  !spacing = ARRAY()
  !realSpacing = ARRAY()

  -- parsing
  -- determine delimiters
  if !value.match(';').boolean() then
    !delim = ';'
  else
    !delim = ' '
  endif

  -- sort out single values
  !value.real(!fmt)
  handle NONE
    !spacing[1] = !value
  elsehandle ANY
    !spacing = !value.split(!delim)
  endhandle

  -- convert string to real
  do !val values !spacing
    !realVal = !val.real(!fmt)
    handle ANY
      skip
    endhandle
    skip if !realVal.unset()
    !realSpacing.append(!realVal)
  enddo

  return !realSpacing

endmethod
-- End of method

-- End of method
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form, set up DBEPLTGRD object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!platformRefe is DBREF)

  -- Verify type of the element passed
  if(!platformRefe.fulltype.neq('PLTFRM'))then
    !error    = 'Element ' & !platformRefe.namn & ' is not a platform.'
    return '$!error'
  endif

  -- set undo callback
  !callback = '!!aslPltFrmLayout.undo(''$!platformRefe'')'
  !this.undo.undoaction(!callback)
  !this.undo.redoaction(!callback)

  -- store platform ref
  !this.platform = !platformRefe

  -- initialise objects
  !platform = object DBEPLTFRM(!platformRefe)
  !templates = !platform.getTemplates()
  !tmplRef = !platform.tmplReference
  !indx = !templates.findFirst(!tmplRef)
  if !indx.unset() then
    !templates.append(!tmplRef)
    !indx = !templates.maxIndex()
  endif

  !dtext = ARRAY()
  do !c indices !templates
    if !templates[!c].badref() then
      !dtext[!c] = 'None'
      skip
    endif
    !dtext[!c] = !templates[!c].desc
  enddo

  !this.templates = !templates
  !this.tmplReference.dtext = !dtext
  !this.tmplReference.val = !indx

  !this.gridDefinition = !platform.pltGrid
  !this.drawGridLines()

  !this.frameDefinition = !platform.intFrame
  !this.drawFrameLines()

  !this.extFrmDefinition = !platform.extFrame

  --populate form with any settings set in object
  !this.gridAngle.val      = !this.gridDefinition.grid.gridAngle()

  !xyOffset             = !this.gridDefinition.grid.gridXYposition()
  !this.gridXOffset.val    = !xyOffset.x
  !this.gridYOffset.val    = !xyOffset.y


  !this.gXSpacing.val   = !this.gridDefinition.stringSpacing('x')
  !this.gYSpacing.val   = !this.gridDefinition.stringSpacing('y')

  --set option gadget depending on difference of angle between plate and frame grid angles
  !frameAngle = !this.frameDefinition.grid.gridAngle()
  !gridAngle = !this.gridDefinition.grid.gridAngle()

  if !frameAngle.eq(!gridAngle) then
    !this.layoutSupportsOffset.val = 1
  else
    !this.layoutSupportsOffset.val = 2
  endif

  !xyOffset             = !this.frameDefinition.grid.gridXYposition()
  !this.frameXOffset.val    = !xyOffset.y
  !this.frameYOffset.val    = !xyOffset.x

  !this.frameYSpacing.val   = !this.frameDefinition.stringSpacing('x')
  !this.frameXSpacing.val   = !this.frameDefinition.stringSpacing('y')

  -- get plate specification
  !panelSpec[1] = nulref
  !panelSpec.appendarray(!!collectAllFor('SPEC','purp eq ''PLT''',world))
  !panelSpref = !this.gridDefinition.spref
  if !panelSpref.badref().not() then
    if !panelSpec.find(!panelSpref.spown).unset() then
      !panelSpec.append(!panelSpref.spown)
    endif
  endif

  -- build up spec list
  !dtext = ARRAY()
  do !val values !panelSpec
    if !val.unset() then
      !dtext.append('None')
      skip
    endif
    !dtext.append(!val.desc)
  enddo
  !this.panelSpec = !panelSpec
  !this.plateSpec.dtext = !dtext
  !this.setPlateSpref(!panelSpref)

  !this.connections()

  !this.boundaryOffset.val = !this.gridDefinition.boundaryOffset()

  !this.setSpecifications()

  !this.splitOnGridToggle.val = !this.gridDefinition.splitOnGrid

  !this.hideGrid()

  !this.setStateGadgets()

  if defined(!!aslExtfrm) then
    if !!aslExtfrm.shown() then
      !!aslExtfrm.init()
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setStateGadgets
--
-- Description: active/inactive gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setStateGadgets()

  !tmpl = !this.templates[!this.tmplReference.val]
  if !tmpl.set() then
  -- hide profile selection form if displayed and associated with this form
    if defined(!!sectionProfileSelection) then
      if !!sectionProfileSelection.shown() then
        if !!sectionProfileSelection.action.string().match(!this.fullname()).gt(0) then
          !!sectionProfileSelection.hide()
        endif
      endif
    endif
  endif

  !gridSet = !this.gridDefinition.tmplReference.badref()
  !internalSet = !this.frameDefinition.tmplReference.badref()
  !externalSet = !this.extFrmDefinition.tmplReference.badref()

  !this.plateThickness.active = !gridSet
  !this.plateSpec.active = !gridSet
  !this.plateSpref.active = !gridSet

  !this.selectProfileA.active = !internalSet
  !this.bangleA.active = !internalSet
  !this.selectProfileB.active = !internalSet
  !this.bangleB.active = !internalSet
  !this.selectProfileC.active = !internalSet
  !this.bangleC.active = !internalSet
  !this.flipOpening.active = !internalSet
  !this.selectProfileD.active = !externalSet
  !this.bangleD.active = !externalSet
  !this.flipExternal.active = !externalSet

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description: Dismiss form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dismiss()

  !this.hide()
  !this.tidy()

  if !this.hideGrid.val then
    !this.gridDefinition.hide(false)
  endif

  -- hide external frame segment form
  if defined(!!aslExtfrm) then
    if !!aslExtfrm.shown() then
      !!aslExtfrm.dismiss()
    endif
  endif

  -- Show original form
  show !!aslpltfrm

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectProfile
--
-- Description: Select profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gadget ID
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectProfile(!id is REAL)

  -- Set default JusLine required for different types of profiles, if
  -- the one of the plines can't be found then NA is used.
  !plineList  = ARRAY()
  !plineList.append('TOS')
  !plineList.append('LTOC')
  !plineList.append('TOAX')

  -- Selection form title
  !title = !this.profileDataDesc[!id]

  -- Action to be carried out
  !action             = !this.fullname() & '.setProfile(' & !id & ', !this.catalogueProfile)'

  -- Profile Data
  !profileData        = !this.profileData[!id]

  -- Setup object for profile selection
  !profileSelection   = object PROFILESELECTION(!title, !action)

  !profileSelection.profileData(!profileData)
  !profileSelection.defaultPlines(!plineList)

  -- Display profile selection form
  !profileSelection.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setProfile
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setProfile(!id is REAL)

  !exitOnError = !this.frameDefinition.tmplReference.set()

  if !id.eq(1) then
    !indx = !this.profileA.val
    !spref = !this.primary[!indx]
    !this.checkProfileSize(!spref,'PRIMARY')
    handle ANY
      if !exitOnError then
        !!alert.error(!!error.text)
        return
      else
        !!alert.warning(!!error.text)
      endif
    endhandle
    !this.frameDefinition.sprefPrimary = !spref
  elseif !id.eq(2) then
    !indx = !this.profileB.val
    !spref = !this.secondary[!indx]
    !this.checkProfileSize(!spref,'SECONDARY')
    handle ANY
      if !exitOnError then
        !!alert.error(!!error.text)
        return
      else
        !!alert.warning(!!error.text)
      endif
    endhandle
    !this.frameDefinition.sprefSecondary = !spref
  elseif !id.eq(3) then
    !indx = !this.profileC.val
    !spref = !this.opening[!indx]
    !this.checkProfileSize(!spref,'OPENING')
    handle ANY
      if !exitOnError then
        !!alert.error(!!error.text)
        return
      else
        !!alert.warning(!!error.text)
      endif
    endhandle
    !this.frameDefinition.sprefOpeningFrame = !spref
  elseif !id.eq(4) then
    !indx = !this.profileD.val
    !spref = !this.external[!indx]
    !this.checkProfileSize(!spref,'EXTERNAL')
    handle ANY
      if !exitOnError then
        !!alert.error(!!error.text)
        return
      else
        !!alert.warning(!!error.text)
      endif
    endhandle
    !this.extFrmDefinition.spref = !spref
  endif

  !this.profileData[!id].catalogueReference = !spref
  !dtext = !this.sprefList(!this.profileData[!id])
  !dtext[!indx] = !dtext[!indx] & ' (' & !this.profileData[!id].justificationLine & ')'
  !this.profileDataGadget[!id].dtext = !dtext
  !this.profileDataGadget[!id].val = !indx

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setProfile
--
-- Description: Set profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILECATALOGUEDATA Profile Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setProfile(!id is REAL, !profileData is PROFILECATALOGUEDATA)

  -- Initialise Variable
  !spref = !profileData.catalogueReference
  !jusl = !profileData.justificationLine
  !appendJusl = ' (' & !jusl & ')'
  !this.profileData[!id] = !profileData
  !dtext = !this.sprefList(!profileData)
  !exitOnError = !this.frameDefinition.tmplReference.set()

  -- check profile size
  if !id.eq(1) then
    !status = 'PRIMARY'
  elseif !id.eq(2) then
    !status = 'SECONDARY'
  elseif !id.eq(3) then
    !status = 'OPENING'
  elseif !id.eq(4) then
    !status = 'EXTERNAL'
  endif

  !this.checkProfileSize(!spref,!status)
  handle ANY
    if !exitOnError then
      !!alert.error(!!error.text)
      return
    else
      !!alert.warning(!!error.text)
    endif
  endhandle

  --set spref in object to !profileData.catalogueReference
  !openingToo = false
  if !id.eq(1) then
    !this.frameDefinition.sprefPrimary = !spref
    !this.frameDefinition.justificationPrimary = !jusl
    !this.primary = !profileData.gtypeOwner.memb
    !indx = !this.primary.findFirst(!spref)
  elseif !id.eq(2) then
    !this.frameDefinition.sprefSecondary = !spref
    !this.frameDefinition.justificationSecondary = !jusl
    !this.secondary = !profileData.gtypeOwner.memb
    !indx = !this.secondary.findFirst(!spref)
  elseif !id.eq(3) then
    !this.frameDefinition.sprefOpeningFrame = !spref
    !this.frameDefinition.justificationOpening = !jusl
    !this.opening = !profileData.gtypeOwner.memb
    !indx = !this.opening.findFirst(!spref)
  elseif !id.eq(4) then
    !this.extFrmDefinition.spref = !spref
    !this.extFrmDefinition.justification = !jusl
    !this.external = !profileData.gtypeOwner.memb
    !indx = !this.external.findFirst(!spref)
    if !this.frameDefinition.sprefOpeningFrame.badref() then
      !openingToo = true
      !this.frameDefinition.sprefOpeningFrame = !spref
      !this.frameDefinition.justificationOpening = !jusl
      !this.profileData[3] = !profileData
      !this.opening = !profileData.gtypeOwner.memb
    endif
  endif

  !dtext[!indx] = !dtext[!indx] & !appendJusl
  !this.profileDataGadget[!id].dtext = !dtext
  !this.profileDataGadget[!id].val = !indx

  if !openingToo then
    !this.profileDataGadget[4].dtext = !dtext
    !this.profileDataGadget[4].val = !indx
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      flip
--
-- Description: flip profiles
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Gadget calling this method
--    2   R      STRING
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flip(!gadget is GADGET,!string is STRING)


  -- init
  !status = !gadget.val

  if !gadget.eq(!this.flipPrimary) then
    !this.frameDefinition.flipPrimary()
  elseif !gadget.eq(!this.flipSecondary) then
    !this.frameDefinition.flipSecondary()
  elseif !gadget.eq(!this.flipOpening) then
    !this.frameDefinition.flipOpening(!status)
  elseif !gadget.eq(!this.flipExternal) then
    !this.extFrmDefinition.sense(!status)
    if defined(!!aslExtfrm) then
      if !!aslExtfrm.shown() then
        !!aslExtfrm.init()
      endif
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      bangle
--
-- Description: set beta angle
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Gadget calling this method
--    2   R      STRING
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .bangle(!gadget is GADGET,!string is STRING)

  -- init
  !bangle = !gadget.val

  if !gadget.eq(!this.bangleA) then
    !this.frameDefinition.banglePrimary = !bangle
  elseif !gadget.eq(!this.bangleB) then
    !this.frameDefinition.bangleSecondary = !bangle
  elseif !gadget.eq(!this.bangleC) then
    !this.frameDefinition.bangleOpening = !bangle
  elseif !gadget.eq(!this.bangleD) then
    !this.extFrmDefinition.bangle = !bangle
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      undo
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .undo(!pltfrm is STRING)

  if !this.shown().and(!this.platform.string().eq(!pltfrm)) then
    !pltFrmRef = !pltfrm.dbref()
    handle ANY
      return
    endhandle
    !this.initialise(!pltFrmRef)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      hideGrid
--
-- Description: remove/add PLTGRD from drawlist
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hideGrid()

  !this.gridDefinition.hide(!this.hideGrid.val)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      tmplReference
--
-- Description: set template reference
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmplReference()

  !tmpl = !this.templates[!this.tmplReference.val]

  !extFrm = !!dtbMemberOfType(!tmpl,'EXTFRM',1)
  !intFrm = !!dtbMemberOfType(!tmpl,'INTFRM',1)
  !pltGrd = !!dtbMemberOfType(!tmpl,'PLTGRD',1)

  !oldThickness = !this.gridDefinition.plateThickness

  !this.extFrmDefinition.tmplReference(!extFrm)
  !this.frameDefinition.tmplReference(!intFrm)
  !this.gridDefinition.tmplReference(!pltGrd)

  !this.setSpecifications()
  !this.plateThickness(!this.gridDefinition.plateThickness,!oldThickness)

  !spref = !this.gridDefinition.spref
  !this.setPlateSpref(!spref)

  !this.setStateGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setSpecifications
--
-- Description: set profile and connection spec. details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSpecifications()

  !this.plateThickness.val = !this.gridDefinition.plateThickness

  !this.flipPrimary.val = !this.frameDefinition.flipPrimary
  !this.flipSecondary.val = !this.frameDefinition.flipSecondary
  !this.flipOpening.val = !this.frameDefinition.flipOpening()
  !this.flipExternal.val = !this.extFrmDefinition.sense()
  !primarySpref = !this.frameDefinition.sprefPrimary
  !secondarySpref = !this.frameDefinition.sprefSecondary
  !openingSpref = !this.frameDefinition.sprefOpeningFrame
  !externalSpref = !this.extFrmDefinition.spref

  !this.primary.clear()
  !this.secondary.clear()
  !this.opening.clear()
  !this.external.clear()

  --put sprefs into gadgets
  if !primarySpref.set() then
    --!this.profileA.val = !primarySpref.catr.namn & ' (' & !this.frameDefinition.justificationPrimary & ')'
    !this.profileData[1].profileCatalogueData(!primarySpref)
    !this.profileData[1].justificationLine = !this.frameDefinition.justificationPrimary
    !this.primary = !this.profileData[1].gtypeOwner.memb
    !indx = !this.primary.findFirst(!primarySpref)
    !dtext = !this.sprefList(!this.profileData[1])
    !dtext[!indx] = !dtext[!indx] & ' (' & !this.profileData[1].justificationLine & ')'
    !this.profileA.dtext = !dtext
    !this.profileA.val = !indx
  else
    !this.profileA.clear()
  endif
  if !secondarySpref.set() then
    !this.profileData[2].profileCatalogueData(!secondarySpref)
    !this.profileData[2].justificationLine = !this.frameDefinition.justificationSecondary
    !this.secondary = !this.profileData[2].gtypeOwner.memb
    !indx = !this.secondary.findFirst(!secondarySpref)
    !dtext = !this.sprefList(!this.profileData[2])
    !dtext[!indx] = !dtext[!indx] & ' (' & !this.profileData[2].justificationLine & ')'
    !this.profileB.dtext = !dtext
    !this.profileB.val = !indx
  else
    !this.profileB.clear()
  endif
  if !openingSpref.set() then
    !this.profileData[3].profileCatalogueData(!openingSpref)
    !this.profileData[3].justificationLine = !this.frameDefinition.justificationOpening
    !this.opening = !this.profileData[3].gtypeOwner.memb
    !indx = !this.opening.findFirst(!openingSpref)
    !dtext = !this.sprefList(!this.profileData[3])
    !dtext[!indx] = !dtext[!indx] & ' (' & !this.profileData[3].justificationLine & ')'
    !this.profileC.dtext = !dtext
    !this.profileC.val = !indx
  else
    !this.profileC.clear()
  endif
  if !externalSpref.set() then
    !this.profileData[4].profileCatalogueData(!externalSpref)
    !this.profileData[4].justificationLine = !this.extFrmDefinition.justification
    !this.external = !this.profileData[4].gtypeOwner.memb
    !indx = !this.external.findFirst(!externalSpref)
    !dtext = !this.sprefList(!this.profileData[4])
    !dtext[!indx] = !dtext[!indx] & ' (' & !this.profileData[4].justificationLine & ')'
    !this.profileD.dtext = !dtext
    !this.profileD.val = !indx
  else
    !this.profileD.clear()
  endif

  -- set bangle
  !this.bangleA.val = !this.frameDefinition.banglePrimary
  !this.bangleB.val = !this.frameDefinition.bangleSecondary
  !this.bangleC.val = !this.frameDefinition.bangleOpening
  !this.bangleD.val = !this.extFrmDefinition.bangle


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plateSpec
--
-- Description: set plate specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plateSpec()

  !spec = !this.panelSpec[!this.plateSpec.val]

  !this.plateSpref(!spec)

  !this.plateThickness.visible = !spec.badref()
  !this.plateSpref.visible = !spec.badref().not()

  if !spec.badref() then
    !this.gridDefinition.spref = nulref
    !this.plateThickness.val = !this.gridDefinition.plateThickness
  else
    !this.plateSpref()
    !this.gridDefinition.spref = !this.panelSpref[!this.plateSpref.val]
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plateSpec
--
-- Description: build up plateSpref option gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plateSpref(!spec is DBREF)

  !dtext = ARRAY()
  !this.panelSpref.clear()
  if !spec.badref().not() then
    !this.panelSpref = !spec.memb
    do !spref values !spec.memb
      !thickness = !!comConvertUnknownValue(!spref.answ, 'mm')
      !dtext.append(!thickness.string(!!distanceFmt))
    enddo
  endif

  !this.plateSpref.dtext = !dtext

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plateSpref
--
-- Description: set plate spec.ref
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plateSpref()

  !spref = !this.panelSpref[!this.plateSpref.val]
  !thick = !!comConvertUnknownValue(!spref.answ, 'mm')
  !oldThick = !this.gridDefinition.plateThickness

  !this.plateThickness(!thick,!oldThick)
  !this.gridDefinition.spref = !spref
  !this.gridDefinition.matref = !spref.matref

endmethod
-- End of method

--
-- Method:      plateSpref
--
-- Description: set associated gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       spec.ref
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPlateSpref(!spref is DBREF)

  if !spref.badref() then
    !indx = 1
    !spec = nulref
  else
    !spec = !spref.owner
    !indx = !this.panelSpec.findFirst(!spec)
    if !indx.unset() then
      !indx = 1
    endif
  endif

  !this.plateSpec.val = !indx
  !this.plateSpref(!spec)

  if !indx.eq(1) then
    !this.plateThickness.val = !this.gridDefinition.plateThickness
  else
    !this.plateSpref.val = !this.panelSpref.findFirst(!spref)
    handle ANY
    endhandle
  endif

  !specSet = !indx.neq(1)
  !this.plateThickness.visible = !specSet.not()
  !this.plateSpref.visible = !specSet

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sprefList(!profileData is PROFILECATALOGUEDATA) is ARRAY

  !owner = !profileData.gtypeOwner

  !dtext = ARRAY()
  if !owner.badref().not() then
    do !entry values !owner.memb
      !dtext.append(!entry.catr.namn)
      handle ANY
        !dtext.append(!entry.namn)
      endhandle
    enddo
  endif

  return !dtext

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkProfileSize
--
-- Description: check size of profile spec.ref. of passed profile against other profiles
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       profile spec.ref.
--    2   R      STRING      profile status (PRIMARY,SECONDARY,OPENING,EXTERNAL)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkProfileSize(!spref is DBREF,!status is STRING)

  -- Note: Size is currently taken from PARA[1]. If not present the profile is not checked.
  -- There should be some way to customise that (e.g. expression)

  -- init
  !primary = !this.frameDefinition.sprefPrimary
  !secondary = !this.frameDefinition.sprefSecondary
  !opening = !this.frameDefinition.sprefOpeningFrame
  !external = !this.extFrmDefinition.spref

  -- exit silently if spref is not valid
  if !spref.badref() then
    return
  endif

  !expr = !this.frameDefinition.attribute(!status & 'SIZE')
  handle ANY
    !expr = !this.extFrmDefinition.size
  endhandle
  !size = !this.getProfileSize(!expr,!spref)
  if !size.unset() then
    return
  endif

  !name = !spref.catr.namn
  handle ANY
    !name = !spref.namn
  endhandle

  !primarySize = !this.getProfileSize(!this.frameDefinition.primarySize,!primary)
  !secondarySize = !this.getProfileSize(!this.frameDefinition.secondarySize,!secondary)
  !openingSize = !this.getProfileSize(!this.frameDefinition.openingSize,!opening)
  !externalSize = !this.getProfileSize(!this.extFrmDefinition.size,!external)

  if !primary.badref().not() then
    !primaryName = !primary.catr.namn
  endif
  if !secondary.badref().not() then
    !secondaryName = !secondary.catr.namn
  endif
  if !opening.badref().not() then
    !openingName = !opening.catr.namn
  endif
  if !external.badref().not() then
    !externalName = !external.catr.namn
  endif

  if !status.eq('PRIMARY') then
    !gdgt = !this.profileA
    !indx = !this.primary.findFirst(!primary)
    -- size must be greater or equal to secondary
    if !secondarySize.set() then
      if !size.lt(!secondarySize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of primary profile $!<name> must not be smaller than size of intermediate profile $!<secondaryName>'
      endif
    endif
    -- size must not be grater than external profile
    if !externalSize.set() then
      if !size.gt(!externalSize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of primary profile $!<name> must not be bigger than size of external frame $!<externalName>'
      endif
    endif
    --size must not be greater than opening profile
    if !openingSize.set() then
      if !size.gt(!openingSize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of primary profile $!<name> must not be bigger than size of opening Frame $!<openingName>'
      endif
    endif
  elseif !status.eq('SECONDARY') then
    !gdgt = !this.profileB
    !indx = !this.secondary.findFirst(!secondary)
    --size must not be greater than any profiles
    if !primarySize.set() then
      if !size.gt(!primarySize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of intermediate profile $!<name> must not be bigger than size of primary profile $!<primaryName>'
      endif
    endif
    if !openingSize.set() then
      if !size.gt(!openingSize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of intermediate profile $!<name> must not be bigger than size of opening frame $!<openingName>'
      endif
    endif
    if !externalSize.set() then
      if !size.gt(!externalSize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of intermediate profile $!<name> must not be bigger than size of external frame $!<externalName>'
      endif
    endif
  elseif !status.eq('OPENING') then
    !gdgt = !this.profileC
    !indx = !this.opening.findFirst(!opening)
    --size must not be smaller than secondary profile
    if !secondarySize.set() then
      if !size.lt(!secondarySize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of opening frame $!<name> must not be smaller than size of intermediate profile $!<secondaryName>'
      endif
    endif
    --size must not be smaller than primary profile
    if !primarySize.set() then
      if !size.lt(!primarySize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of opening frame $!<name> must not be smaller than size of primary profile $!<primaryName>'
      endif
    endif
    --size must not be bigger than external
    if !externalSize.set() then
      if !size.gt(!externalSize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of opening frame $!<name> must not be bigger than size of external frame $!<externalName>'
      endif
    endif
  elseif !status.eq('EXTERNAL') then
    !gdgt = !this.profileD
    !indx = !this.external.findFirst(!external)
    -- size must not be smaller than any other profile
    if !secondarySize.set() then
      if !size.lt(!secondarySize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of external frame $!<name>  must not be smaller than size of intermediate profile $!<secondaryName>'
      endif
    endif
    if !primarySize.set() then
      if !size.lt(!primarySize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of external frame $!<name> must not be smaller than size of primary profile $!<primaryName>'
      endif
    endif
    if !openingSize.set() then
      if !size.lt(!openingSize) then
        !gdgt.val = !indx
        handle ANY
        endhandle
        return error 1 'Size of external frame $!<name> must not be smaller than size of opening frame $!<openingName>'
      endif
    endif
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      getProfileSize
--
-- Description: evaluate passed expression passed profile to get size
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getProfileSize(!expr is EXPRESSION,!spref is DBREF) is REAL

  -- init
  !size = REAL()

  if !spref.badref() then
    return !size
  endif
  if !expr.unset() then
    return !size
  endif

  -- evaluate expression
  !size = !expr.evaluate(!spref)
  handle ANY
  endhandle
  -- Expression can be PARA[1] so need to be careful with units
  -- If expression without units, then size is in MM
  -- Otherwise size is unchanged
  !size = !!comConvertUnknownValue(!size,'mm')

  return !size

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPltfrmThickness
--
-- Description: return the size of the biggest profile
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        platform thickness in current units
--
------------------------------------------------------------------------

define method .getPltfrmThickness() is REAL


  !size[1] = !this.getProfileSize(!this.frameDefinition.primarySize,!this.frameDefinition.sprefPrimary)
  !size[2] = !this.getProfileSize(!this.frameDefinition.secondarySize,!this.frameDefinition.sprefSecondary)
  !size[3] = !this.getProfileSize(!this.frameDefinition.openingSize,!this.frameDefinition.sprefOpeningFrame)
  !size[4] = !this.getProfileSize(!this.extFrmDefinition.size,!this.extFrmDefinition.spref)
  !thickness   = 0mm
  do !proSize values !size
    skip if( !proSize.unset() )
    !thickness = !thickness.max(!proSize)
  enddo

  return !thickness

endmethod
-- End of method
