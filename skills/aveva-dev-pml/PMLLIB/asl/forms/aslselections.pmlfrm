------------------------------------------------------------------------
--
-- Method:      updateStdSubStd
--
-- Description: sets the substandard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateStdSubStd()

  -- evaluates the standard data
  !this.meCurrSetting.settingData = object ARRAY()
  !this.meCurrSetting.subSettings = object ARRAY()
  !!aslCentralData.currSetting.settingData = object ARRAY()

  !newSettingData         = object SETTINGDATA()
  !newSettingData.purpose = 'STANDARD'
  !newSettingData.value   = !!aslSelections.opStandards.selection()
  !!aslCentralData.currSetting.settingData.append(!newSettingData)

  !newSettingData         = object SETTINGDATA()
  !newSettingData.purpose = 'SUBSTANDARD'
  !newSettingData.value   = !!aslSelections.opSubStandards.selection()
  !!aslCentralData.currSetting.settingData.append(!newSettingData)

  !this.meCurrSetting = !!aslCentralData.currSetting

  do !setting value !!aslCentralData.userSettings
     if ( !setting.description.eq(!!aslCentralData.currSetting.description) ) then
        !setting = !!aslCentralData.currSetting
        break
     endif
  enddo

  do !setting value !!aslCentralData.projectSettings
     if ( !setting.description.eq(!!aslCentralData.currSetting.description) ) then
        !setting = !!aslCentralData.currSetting
        break
     endif
  enddo

  do !setting value !!aslCentralData.settings
     if ( !setting.description.eq(!!aslCentralData.currSetting.description) ) then
        !setting = !!aslCentralData.currSetting
        break
     endif
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: init call of the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setup()

  !!aslCentralData.readSettings()
  !this.meCurrSetting = !!aslCentralData.currSetting

  -- defines the headers of the different lists
  ---------------------------------------------------------------------------
  !headers = object ARRAY()
  !headers.append('Type')
  !headers.append('Description')
  !headers.append('Name')

  !settingHeaders = object ARRAY()
  !settingHeaders.append('Name')
  !settingHeaders.append('Type')
  !this.opSettings.setHeadings(!settingHeaders)
  do !attributeName value !this.attributes()
    if ( !attributeName.matchwild('BU*ADD') ) then
      -- sets pixmap
      !this.attribute(!attributeName).addPixmap(!!pml.getPathName('uparrow16.png'))

      -- set tooltip
      !this.attribute(!attributeName).setToolTip('Add the selected option')

      !type = !attributeName.after('BU').subString(-4)

--TODO when element types are available get rid of collectType and replace it by !type
      if ( !type inset ('WWAY') ) then
        !collectType = 'STRLNG'
      else
        !collectType = !type
      endif

      -- assign headers
      !this.attribute('LI' & !type & 'ADD').setHeadings(!headers)
      !this.attribute('LI' & !type & 'REM').setHeadings(!headers)

--TODO: remove this if the types are available in the db
      skip if ( !collectType inset ('PIPEBDG') )

        !a = ARRAY()
        if (!!distanceFmt.units eq 'MM') then
          !expression = 'TYPE OF OWNER OF ZONE eq |APPLDA|and FUNC OF APPLDW neq |Imperial|'
        else
          !expression = 'TYPE OF OWNER OF ZONE eq |APPLDA| and FUNC OF APPLDW eq |Imperial|'
        endif
        var !c collect all $!collectType with ($!expression and FUNC of STRU eq '$!collectType')
        do !i indices !c
          !a[!i] = !c[!i].dbref()
        enddo

        !this.attribute('ME' & !type & 'REFES') = !a

    elseif ( !attributeName.matchwild('BU*REM') ) then
      !this.attribute(!attributeName).addPixmap(!!pml.getPathName('downarrow16.png'))
      !this.attribute(!attributeName).setToolTip('Remove the selected option')
    endif
  enddo

  -- fills the standards gadget
  !this.fillStandards()
  !this.fillSubStandards()

  -- fills the settings gadget
  !this.fillSettings()

  -- fills the substandard GADGET
  !this.setStandard()

  -- updates the selection and the content of the standard and substandard gadget
  if !!aslCentralData.currSetting.description.set() then
    !description = !!aslCentralData.currSetting.description
  else
    !descriptionArray = !this.opSettings.selection().split()
    if !descriptionArray.size().gt(2) then
      !description = !descriptionArray[1] + ' '
      do !i from 2 to !descriptionArray.size() - 1
        !description = !description + !descriptionArray[!i] + ' '
      enddo
    else
      !description = !this.opSettings.selection().split()[1]
      handle (2,752)
      !description = object STRING()
      endhandle
    endif
  endif

  do !setting value !!aslCentralData.userSettings
    if (!setting.description.trim().eq(!description.trim())) then
      !currSetting = !setting
      break
    endif
  enddo

  do !setting value !!aslCentralData.projectSettings
    if (!setting.description.trim().eq(!description.trim())) then
      !currSetting = !setting
      break
    endif
  enddo

  do !setting value !!aslCentralData.settings
    if (!setting.description.trim().eq(!description.trim())) then
      !currSetting = !setting
      break
    endif
  enddo

  -- set the list gadget value
  do !i from 1 to !this.opSettings.dText.size()
    if defined(!currSetting) then
      if !this.opSettings.dText[!i].split()[1].eq(!currSetting.description) then
        !this.opSettings.val = !i
        break
      endif
    endif
  enddo

  --updates the gadget
  !this.updateGadgets()


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sortArrays
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       leading array for sort
--    2   RW     ARRAY
--    3   RW     ARRAY
--    4   RW     ARRAY
--    5   RW     ARRAY
--    6   RW     ARRAY
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .sortArrays(!keyArray is ARRAY, !arrayA is ARRAY, !arrayB is ARRAY, !arrayC is ARRAY, !arrayD is ARRAY, !arrayE is ARRAY)

  !sortedIndices = !keyArray.sortedIndices()
  !arrayA.reIndex(!sortedIndices)
  !arrayB.reIndex(!sortedIndices)
  !arrayC.reIndex(!sortedIndices)
  !arrayD.reIndex(!sortedIndices)
  !arrayE.reIndex(!sortedIndices)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateAddList
--
-- Description: fills the add list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      keyword for the add list (STRFLT, STRLNG, ...)
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateAddList(!purpose is STRING)

  -- handles the different sub settings of the setting
  if ( !this.meCurrSetting.description.unset()) then
    -- re-initialise list gadgets for unset variables
    !dText = object ARRAY()
    !dtextItems = object ARRAY()

    !dtextItems.append('-UNSET-')
    !dtextItems.append('No Settings to derive Assigned Elements')
    !dtextItems.append('--Detail does not exists--')
    !dText.append(!dtextItems)

    !this.attribute('LI' & !purpose & 'ADD').setrows(!dText)
    handle (2,766)
    endhandle
  else
    do !subSetting value !this.meCurrSetting.subSettings
      -- allow only sub setting with matching purpose
      skip if ( !subSetting.purpose.neq(!purpose) )
      -- initialise
      !descs  = object ARRAY()
      !names  = object ARRAY()
      !refes  = object ARRAY()
      !refNos = object ARRAY()
      !types  = object ARRAY()
      -- handles all setting data of the sub setting
      do !settingData value !subSetting.settingData
        -- collects all data for valid references
        !refe = !settingData.value.dbref()
        handle ANY
        elsehandle NONE
          !descs.append(!refe.description)
          !names.append(!refe.fullname)
          !refes.append(!refe)
          !refNos.append(!refe.refe.string())
          !types.append(!refe.type)
        endhandle
      enddo
      -- sorts data by name
      !this.sortArrays(!names, !descs, !names, !refes, !refNos, !types)
      -- sorts data by type
      !this.sortArrays(!types, !descs, !names, !refes, !refNos, !types)
       -- fills the add list
      !columns[1] = !types
      !columns[2] = !descs
      !columns[3] = !names
      !this.attribute('LI' & !purpose & 'ADD').setColumns(!columns)
      !this.attribute('LI' & !purpose & 'ADD').rText = !refNos
      -- stops
      break
    enddo
  endif

  !this.updateCentralDataSettings()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateRemList
--
-- Description: fills the rem list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      keyword for the add list (STRFLT, STRLNG, ...)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRemList(!purpose is STRING)

  if ( !this.meCurrSetting.description.unset()) then
    -- re-initialise list gadgets for unset variables
    !dText = object ARRAY()
    !dtextItems = object ARRAY()

    !dtextItems.append('-UNSET-')
    !dtextItems.append('No Settings to Derive Assembly Elements')
    !dtextItems.append('--Detail does not exists--')
    !dText.append(!dtextItems)

    !this.attribute('LI' & !purpose & 'REM').setrows(!dText)
    handle (2,766)
    endhandle
  else



    -- evaluates the add refes
    ---------------------------------------------------------------------------
    !addRefes = object ARRAY()

    -- handles the different sub settings of the setting
    do !subSetting value !this.meCurrSetting.subSettings

      -- allow only sub setting with matching purpose
      skip if ( !subSetting.purpose.neq(!purpose) )

      -- handles all setting data of the sub setting
      do !settingData value !subSetting.settingData
        -- collects all data for valid references
        !refe = !settingData.value.dbref()
        handle ANY
        elsehandle NONE
          !addRefes.append(!refe)
        endhandle
      enddo
      -- stops
      break
    enddo


    -- evaluates the data for the rem list
    ---------------------------------------------------------------------------
    -- initialise
    !descs  = object ARRAY()
    !names  = object ARRAY()
    !refes  = object ARRAY()
    !refNos = object ARRAY()
    !types  = object ARRAY()

    !validRefes = !this.attribute('ME' & !purpose & 'REFES').difference(!addRefes)
    handle (2,766)
    endhandle
    do !refe value !validRefes
      skip if ( !refe.badRef() )
      !descs.append(!refe.description)
      !names.append(!refe.fullname)
      !refes.append(!refe)
      !refNos.append(!refe.refe.string())
      !types.append(!refe.type)
    enddo

    -- sorts data by name
    !this.sortArrays(!names, !descs, !names, !refes, !refNos, !types)

    -- sorts data by type
    !this.sortArrays(!types, !descs, !names, !refes, !refNos, !types)

    -- fills the rem list
    !columns[1] = !types
    !columns[2] = !descs
    !columns[3] = !names
    !this.attribute('LI' & !purpose & 'REM').setColumns(!columns)
    handle (2,766)
    endhandle
    !this.attribute('LI' & !purpose & 'REM').rText = !refNos
    handle (2,766)
    endhandle

  endif

  -- updates all the settings with the added or removed catalogue element list
  !this.updateCentralDataSettings()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateCentralDataSettings
--
-- Description: updates the central data with the changed value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      keyword for the add list (STRFLT, STRLNG, ...)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateCentralDataSettings()

  do !setting value !!aslCentralData.userSettings
     if ( !setting.description.eq(!this.meCurrSetting.description) ) then
        !!aslCentralData.currSetting = !this.meCurrSetting
        !setting = !this.meCurrSetting
     endif
  enddo

  do !setting value !!aslCentralData.projectSettings
     if ( !setting.description.eq(!this.meCurrSetting.description) ) then
        !setting = !this.meCurrSetting
     endif
  enddo

  do !setting value !!aslCentralData.settings
     if ( !setting.description.eq(!this.meCurrSetting.description) ) then
        !setting = !this.meCurrSetting
     endif
  enddo

endmethod
--end of code

------------------------------------------------------------------------
--
-- Method:      checkAccess
--
-- Description: checks the access to the paths for the supplied create type i.e. USER or PROJECT. if the current user
--              does not have the required setup for a write then this method will return false.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      keyword for the setting type ('USER', 'PROJECT', ...)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkAccess(!settingType is STRING) is BOOLEAN

  if !settingType.eq('USER') then
    -- get the user dflts
    !testFileName = '%PDMSUSER%' & '/test.xml'
    !testFile = object FILE(!testFileName)
    !fileName = object FILE('%PDMSUSER%' & '/aslsettings.xml')
  elseif !settingType.eq('PROJECT') then
    -- get the current project dflts
    !currProj = CURRENT PROJECT
    !testFileName = '%' & !currProj.code() & 'DFLTS%/test.xml'
    !testFile = object FILE(!testFileName)
    !fileName = object FILE('%' & !currProj.code() & 'DFLTS%/aslsettings.xml')
  else
    -- get the aveva dflts
    !testFileName = '%PDMSDFLTS%' & '/test.xml'
    !testFile = object FILE(!testFileName)
    !fileName = object FILE('%PDMSDFLTS%' & '/aslsettings.xml')
  endif

  -- write some junk data to the file
  !dataLines = object ARRAY()
  !dataLines.append('<?xml version="1.0" standalone="yes"?>')

  if !settingType.eq('PROJECT') then
    -- test to make sure the evar for the project dflts has been set
    !a = !testFile.pathname()
    !b = !a.subString(2)
    !evar = !currProj.code() & 'DFLTS'
    if !b.eq(|:\|) then
      !!alert.warning('Environment variable $!evar is not set in pdms evars.bat file. Set the variable $!evar for storing global ASL settings.' )
      return FALSE
    endif
  endif

  !testFile.writeFile('OVERWRITE', !dataLines)
  handle (41,319)
    !path = !testFile.pathname()
    !!alert.warning('Directory $!path does not exist to write file.')
    return FALSE
  elsehandle ANY
    !path = !testFile.pathname()
    !!alert.warning('Access Denied - check that you have write access to the destination $!path')
    return FALSE
  elsehandle NONE
    !testFile.deleteFile()
    handle ANY
    endhandle
    -- can create a test file in correct directory
    -- now check if the file can be written to
    !fileName.open('APPEND')
    handle ANY
      !name = !fileName.name()
      !!alert.warning('Error writing to file $!name - check that $!name is not open or write-protected')
      return FALSE
    endhandle
    !fileName.close()
    return TRUE
  endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Checks for the availability of the standard and updates the gadgets based on that.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  --if (!this.meCurrSetting.description.set()) then
  --  !this.lkDeleteSetting.active  = true
  --  !this.lkAcceptChanges.active  = true
  --  !this.lkDiscardChanges.active = true
  --else
  --  !this.lkDeleteSetting.active  = false
  --  !this.lkAcceptChanges.active  = false
  --  !this.lkDiscardChanges.active = false
  --endif

  if (!this.meCurrSetting.description.set()) then
     !status = !this.meCurrSetting.description.set()
     !this.updateCataButton(!status)
  else
     !status = !this.meCurrSetting.description.set()
     !this.updateCataButton(!status)
  endif

endmethod
----------------------------------------------------------------------------
----------------------------------------------------------------------------
--
-- Method:      discardSetting
--
-- Description: discard the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
----------------------------------------------------------------------------

define method .discardSetting()

  !this.hide()
  -- Reads the settings from the updated XML File if Accept changes is done or If XML File is updated
  !!aslCentralData.readSettings()
  !this.fillSettings()

  -- Check condition if setting is existing or not, if not then unset the meCurrSetting and aslCentralData.currSetting
  !collSetting = object REAL()
  !collSetting = !!aslCentralData.userSettings.size()
  !collSetting = !collSetting + !!aslCentralData.projectSettings.size()
  !collSetting = !collSetting + !!aslCentralData.settings.size()

  if (!collSetting.eq(0)) then
    !!aslCentralData.currSetting = object SETTING()
    !this.meCurrSetting = object SETTING()
  endif

endmethod
-- End of method
----------------------------------------------------------------------------
--
-- Method:      updateCataButton
--
-- Description: Updates the catalogue button status
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
----------------------------------------------------------------------------

define method .updateCataButton(!active is BOOLEAN)

  -- updates the catalogue add rem button
  do !attributeName value !this.attributes()
    !mainBuName = !attributeName.after('BU').subString(-4)
      if ( !attributeName.matchwild('BU*ADD')) then
        !this.attribute('BU' & !mainBuName & 'ADD').active = !active
      elseif ( !attributeName.matchwild('BU*REM')) then
        !this.attribute('BU' & !mainBuName & 'REM').active = !active
      endif
  enddo

endmethod
-- End of method
