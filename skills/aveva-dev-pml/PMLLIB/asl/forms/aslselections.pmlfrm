--
--
-- Description:    ASL settings form, only for ASLADMIN
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addRemOption(GADGET,STRING)      -                   assigns and remove assignment of options
--  aslSelections()                  -
--  checkAccess(STRING)              BOOLEAN             checks the access to the paths for the supplied create type i.e. USER or PROJECT. if the current user
--  closeForm()                      -                   closes the form and restores the limits and the displayed elements
--  copySetting()                    -                   copy an existing setting
--  createSetting()                  -                   creates a new setting
--  deleteSetting()                  -                   deletes the setting
--  discardSetting()                 -                   discard the form
--  fillSettings()                   -                   fills the settings gadget
--  fillStandards()                  -                   fills the standards gadget
--  fillSubStandards()               -                   fills the substandard gadget depending of the selected standard
--  saveSetting()                    -                   save the settings
--  selectOption(GADGET,STRING)      -                   handles the selection of option within all option lists
--  selectSetting()                  -                   handles the selection of setting
--  setStandard()                    -                   sets the standard and substandard
--  setSubStandard()                 -                   sets the substandard
--  setup()                          -                   init call of the form
--  sortArrays(ARRAY,ARRAY,ARRAY,ARRAY,ARRAY,ARRAY) -
--  updateAddList(STRING)            -                   fills the add list
--  updateCataButton(BOOLEAN)        -                   Updates the catalogue button status
--  updateCentralDataSettings()      -                   updates the central data with the changed value
--  updateGadgets()                  -                   Checks for the availability of the standard and updates the gadgets based on that.
--  updateRemList(STRING)            -                   fills the rem list
--  updateStdSubStd()                -                   sets the substandard
--

import 'GridControl'
handle ANY
endhandle

setup form !!aslSelections dialog docking right
  -- .NET library
  using namespace 'Aveva.Pdms.Presentation'

  -- form main attributes
  !this.autoscroll   = true
  !this.callback     = '!this.setup()'
  !this.cancelCall   = '!this.closeForm()'
  !this.formRevision = ' $Revision$ '
  !this.formTitle    = 'Selections for Access, Stairs and Ladder application'
  !this.iconTitle    = 'ASL selections'


  -- create/copy and select settings, set defaults
  para   .paSetting                    at xmin form            ymax text 'Selections'
  line   .lnSetting                    at xmin                 ymax-.2                                                         anchor T+L+R HORIZ width 47
  para   .paCreateSetting              at x2                   ymax+.2 pixmap                                                                     width 16 height 16
  button .lkCreateSetting    linklabel at x5                   ymin    'Create a new setting'        callback '!this.createSetting()'             width 30
  para   .paDeleteSetting              at xmin.paCreateSetting ymax+.2 pixmap                                                                     width 16 height 16
  button .lkDeleteSetting    linklabel at xmin.lkCreateSetting ymin    'Delete the selected setting' callback '!this.deleteSetting()'             width 30
  --para   .paCopySetting                at xmin.paCreateSetting ymax+.2 pixmap                                                                     width 16 height 16
  --button .lkCopySetting      linklabel at xmin.lkCreateSetting ymin    'Copy the selected setting'   callback '!this.copySetting()'               width 30

  list .opSettings                     at xmin.paCreateSetting  ymax+.2 'Setting'          anchor t+r+l callback '!this.selectSetting()' COLUMNS width 41.5 height 10
  hdist 0

  -- selectors for standard data
  para   .paStandard      at xmin form            ymax.opSettings+.2 text 'Assigned standard'
  line   .lnStandard      at xmin                 ymax-.2 anchor T+L+R HORIZ width.lnSetting
  option .opStandards     at xmin.paCreateSetting ymax+.2  'Standard'    anchor T+L+R callback '!this.setStandard()'    tagwidth 15 width 25
  option .opSubStandards  at xmin.paCreateSetting ymax+.5 'Secondary Standard' anchor T+L+R callback '!this.setSubStandard()' tagwidth 15 width 25

  path down

  -- tab set for settings
  para  .paTabs at xmin form ymax+0.5 text 'Assigned elements'
  line  .lnTabs at xmin      ymax-.2 anchor T+L+R HORIZ width.lnSetting
  frame .frTabs tabset at xmin.paCreateSetting ymax+.2 anchor all

    -- initialise
    !criteriaSetDescs  = object ARRAY()
    !criteriaSetSuffix = object ARRAY()

    -- this is to define the different criteria groups
    !subStandard = object ASLSUBSTANDARD()

    -- handles all criteria sets of a substandard
    do !criteriaSetName value !subStandard.attributes()

      -- delete existing distance
      if ( DEFINED(!criteriaSet) ) then
        !criteriaSet.delete()
      endif

      -- evaluates the criteria set
      !criteriaSet = !subStandard.attribute(!criteriaSetName)

      --ignores the basic data types
      skip if ( !criteriaSet.objectType() inset ('ARRAY', 'BOOLEAN', 'DBREF', 'REAL', 'STRING') )

      -- evaluates the description of the criteria set and stores the name
      !criteriaSetDescs.append(!criteriaSet.desc)
      !suffix = !criteriaSetName.after('ASL').before('CRITERIA')
      !criteriaSetSuffix.append(!suffix)
    enddo

    -- evaluates the order of the criteria set sorted by their description
    !sortedIndices = !criteriaSetDescs.sortedIndices()

    -- reorder the criteria sets attributes
    !criteriaSetDescs.reIndex(!sortedIndices)
    !criteriaSetSuffix.reIndex(!sortedIndices)


     do !i index !criteriaSetDescs

      -- reduces the size of the expression
      !desc   = !criteriaSetDescs[!i]
      !suffix = !criteriaSetSuffix[!i]

      -- We do not want the Stair Tower tab because it just uses the STFLT, STRLNG and HANDRA setting.
      skip if (!desc.upcase() eq 'STAIR TOWER')

      frame .fr$!<suffix> '$!desc'            at xmin.frTabs ymin.frTabs
        list   .li$!<suffix>Add        at ymin + .25           'Assigned elements'  callback '!this.selectOption(' anchor l+t+r multi columns height 10 width 40
        path down
        button .bu$!<suffix>Add pixmap at x 18                                      callback '!this.addRemOption(' anchor t                   height 16 width 16
        path right
        button .bu$!<suffix>Rem pixmap                                              callback '!this.addRemOption(' anchor t                   height 16 width 16
        path down
        list   .li$!<suffix>Rem        at xmin.li$!<suffix>Add 'Assembly elements' callback '!this.selectOption(' anchor all   multi columns height 10 width 40

          --check the user to be a member of ASLADMIN and make the gadget visible
          if(!!aslCentralData.administrator) then
            !this.bu$!<suffix>Add.active  = true
            !this.bu$!<suffix>Rem.active  = true
          else
            !this.bu$!<suffix>Add.active  = false
            !this.bu$!<suffix>Rem.active  = false
          endif

      exit

      -- container of all potential elements of the type
      member .me$!<suffix>Refes is ARRAY
    enddo

  exit

      path right
      para .paAcceptChanges              at xmin+3                  ymax anchor B+L pixmap                                           width 16 height 16
      button .lkAcceptChanges linklabel  at xmin.paAcceptChanges+3  ymin anchor B+L        'Accept changes'  callback '!this.saveSetting()' width 15
      para .paDiscardChanges             at xmin.lkAcceptChanges+20 ymin anchor B+R pixmap                                           width 16 height 16
      button .lkDiscardChanges linklabel at xmin.paDiscardChanges+3 ymin anchor B+R        'Discard changes' callback '!this.discardSetting()' width 15

  -- members
  -- aid number
  member .meAidNumber is REAL

  -- contains the setting
  member .meCurrSetting is SETTING

  -- stores the last displayed elements
  member .meLastDisplayedElement is DBREF

  -- stores the original view direction
  member .meLastDisplayedDirection is ARRAY

  -- stores the original view limits
  member .meLastDisplayedLimits is ARRAY

  -- stores from where (APPDESMAIN ASL menu or from this form) the settings to be done
  -- For synchronising the settings selection between this form and the app main menu
  member  .settingsFrom     is STRING

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslSelections
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslSelections()

  -- set the pixmaps
  ---------------------------------------------------------------------------
  --!this.paCopySetting.addPixmap(!!pml.getPathName('aslcopy16.png'))
  !this.paCreateSetting.addPixmap(!!pml.getPathName('aslnew16.png'))
  !this.paDeleteSetting.addPixmap(!!pml.getPathName('deletece16.png'))
  !this.paAcceptChanges.addPixmap(!!pml.getPathName('accept.png'))
  !this.paDiscardChanges.addPixmap(!!pml.getPathName('discard.png'))

  --check the user to be a member of ASLADMIN and make the gadget visible
  if(!!aslCentralData.administrator) then
    !this.lkAcceptChanges.active  = true
    !this.lkDiscardChanges.active = true
    !this.lkCreateSetting.active  = true
    !this.lkDeleteSetting.active  = true
  else
    !this.lkAcceptChanges.active  = false
    !this.lkDiscardChanges.active = false
    !this.lkCreateSetting.active  = false
    !this.lkDeleteSetting.active  = false
  endif

  -- Set default as ASL setting selection from the design main form
  !this.settingsFrom  = 'APPDESMAINFORM'

  -- evaluates the next free aid number
  ---------------------------------------------------------------------------
  !this.meAidNumber =  !!aidnumbers.add(!this.name())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addRemOption
--
-- Description: assigns and remove assignment of options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .addRemOption(!gadget is GADGET, !action is STRING)

  -- separates the different parts of the gadget name
  ---------------------------------------------------------------------------
  !gadgetName = !gadget.name()
  !mainName   = !gadgetName.subString(3).subString(-4)
  !actionType = !gadgetName.subString(-3, 4)


  -- evaluate the content and the selection of add and rem list
  ---------------------------------------------------------------------------
  !addRefnoSelection = !this.attribute('LI' & !mainName & 'ADD').selection('rText')
  !addRefnoAll       = !this.attribute('LI' & !mainName & 'ADD').rText
  !remRefnoSelection = !this.attribute('LI' & !mainName & 'REM').selection('rText')
  --!remRefnoAll       = !this.attribute('LI' & !mainName & 'REM').rText


  -- extends and reduce the different lists
  ---------------------------------------------------------------------------
  if ( !actionType.eq('ADD') ) then
    !addRefnoAll.appendArray(!remRefnoSelection)
    !remRefnoSelection = object ARRAY()
  elseif ( !actionType.eq('REM') ) then
    !addRefnoAll       = !addRefnoAll.difference(!addRefnoSelection)
    !addRefnoSelection = object ARRAY()
  endif


  -- remove the sub setting of the currently selected tab
  ---------------------------------------------------------------------------
  do !i index !this.meCurrSetting.subSettings

    -- ignore all not affected sub settings
    skip if ( !this.meCurrSetting.subSettings[!i].purpose.neq(!mainName) )

    -- removes the affected sub settings
    !this.meCurrSetting.subSettings.removeFrom(!i, 1)

    -- stops
    break
  enddo


  -- creates a new sub setting, fills and assign it
  ---------------------------------------------------------------------------
  !subSetting             = object SUBSETTING()
  !subSetting.purpose     = !mainName
  !subSetting.settingData = object ARRAY()
  do !refno value !addRefnoAll
    !settingData       = object SETTINGDATA()
    !settingData.purpose = !refno.dbref().type
    !settingData.value   = !refno
    !subSetting.settingData.append(!settingData)
  enddo
  !this.meCurrSetting.subSettings.append(!subSetting)

  ---- updates the selection
  -----------------------------------------------------------------------------
  !this.attribute('LI' & !mainName & 'ADD').select('rText', !addRefnoSelection)
  !this.attribute('LI' & !mainName & 'REM').select('rText', !remRefnoSelection)

  ---- updates the add and the rem list
  -----------------------------------------------------------------------------
  !this.updateAddList(!mainName)
  !this.updateRemList(!mainName)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      closeForm
--
-- Description: closes the form and restores the limits and the displayed elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .closeForm()

  !!ce = !this.meLastDisplayedElement
  REM CE

  !!gphViews.views[1].direction = !this.meLastDisplayedDirection
  !!gphViews.views[1].limits    = !this.meLastDisplayedLimits

  !!aidClear(!this.meAidNumber.string(), 'ALL')

  !this.discardSetting()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copySetting
--
-- Description: copy an existing setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .copySetting()

  pml reload form !!aslInputSettings
  !!aslInputSettings.formTitle       = 'ASL-Settings'
  !!aslInputSettings.desc.val        = 'ASL-User defined Setting'
  !!aslInputSettings.action          = 'COPY'
  show !!aslInputSettings

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createSetting
--
-- Description: creates a new setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .createSetting()

  pml reload form !!aslInputSettings
  !!aslInputSettings.formTitle       = 'ASL-Settings'
  !!aslInputSettings.desc.val        = 'User defined Setting'
  !!aslInputSettings.action          = 'CREATE'
  show !!aslInputSettings

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteSetting
--
-- Description: deletes the setting
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deleteSetting()

  !deleteType = !!alert.confirm('Delete the Selected Setting?')

  --!this.meCurrSetting.deleteFlag = !deleteType.boolean()
  do !i index !!aslCentralData.userSettings
    if (!!aslCentralData.userSettings[!i].eq(!this.meCurrSetting)) then
      !!aslCentralData.userSettings[!i].deleteFlag = !deleteType.boolean()
      !this.meCurrSetting = !!aslCentralData.userSettings[!i]
      !!aslCentralData.currSetting = !this.meCurrSetting
    endif
  enddo

  do !i index !!aslCentralData.projectSettings
    if (!!aslCentralData.projectSettings[!i].eq(!this.meCurrSetting)) then
      !!aslCentralData.projectSettings[!i].deleteFlag = !deleteType.boolean()
      !this.meCurrSetting = !!aslCentralData.projectSettings[!i]
      !!aslCentralData.currSetting = !this.meCurrSetting
    endif
  enddo

  do !i index !!aslCentralData.settings
    if (!!aslCentralData.settings[!i].eq(!this.meCurrSetting)) then
      !!aslCentralData.settings[!i].deleteFlag = !deleteType.boolean()
      !this.meCurrSetting = !!aslCentralData.settings[!i]
      !!aslCentralData.currSetting = !this.meCurrSetting
    endif
  enddo

  -- updates the settings in the list
  !this.fillSettings()


  if (!this.meCurrSetting.description.unset()) then
    -- updates the standard option gadgets
    !this.fillStandards()
    !this.fillSubStandards()
    !this.updateGadgets()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fillSettings
--
-- Description: fills the settings gadget
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .fillSettings()

  -- initialise the settings
  !settingDesc = object ARRAY()
  -- evaluate the settings data
  do !setting value !!aslCentralData.userSettings
    if (!setting.deleteFlag.not()) then
      !settingItems = object ARRAY()
      !settingItems.append(!setting.description)
      !settingItems.append(!!aslCentralData.getSettingType(!setting.description))
      !settingDesc.append(!settingItems)
    endif
  enddo

  do !setting value !!aslCentralData.projectSettings
    if (!setting.deleteFlag.not()) then
      !settingItems = object ARRAY()
      !settingItems.append(!setting.description)
      !settingItems.append(!!aslCentralData.getSettingType(!setting.description))
      !settingDesc.append(!settingItems)
    endif
  enddo

  do !setting value !!aslCentralData.settings
    if (!setting.deleteFlag.not()) then
      !settingItems = object ARRAY()
      !settingItems.append(!setting.description)
      !settingItems.append(!!aslCentralData.getSettingType(!setting.description))
      !settingDesc.append(!settingItems)
    endif
  enddo

  if (!settingDesc.unset()) then
    !dText = object ARRAY()
    !dtextItems = object ARRAY()

    !dtextItems.append('Setting file does not exists')
    !dtextItems.append('-UNSET-')
    !dText.append(!dtextItems)

    !this.opSettings.setrows(!dText)
  else
    -- assign
    !this.opSettings.setrows(!settingDesc)
    !this.selectSetting()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fillStandards
--
-- Description: fills the standards gadget
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .fillStandards()

  if (!!aslCentralData.currSetting.description.unset()) then
    !dText = object ARRAY()
    !dText.append('Settings file does not exists for Standards')
    !this.opStandards.dText = !dText
  else
    !standardNames = object ARRAY()
      do !standard value !!aslCentralData.standards
       !standardNames.append(!standard.name)
      enddo
    !this.opStandards.dText = !standardNames.sort()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fillSubStandards
--
-- Description: fills the substandard gadget depending of the selected standard
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .fillSubStandards()

  if (!!aslCentralData.currSetting.description.unset()) then
    !dText = object ARRAY()
    !dText.append('Settings file does not exists for Sub-Standards')
    !this.opSubStandards.dText = !dText
  else
    -- evaluate the currently selected standard
    !standardName = !this.opStandards.selection('rText')
    -- evaluates all substandard of the currently selected standard and fills the gadget
    do !standard value !!aslCentralData.standards
      if ( !standard.name.eq(!standardName)) then
       !subStandardNames = object ARRAY()
        do !subStandard value !standard.subStandards
          !subStandardNames.append(!subStandard.name)
        enddo
       !this.opSubStandards.dText = !subStandardNames
       break
      endif
    enddo
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      saveSetting
--
-- Description: save the settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .saveSetting()

  -- create undo mark
  !undo = object UNDOABLE()
  !undo.description('Modify ASL settings')
  !undo.undoAction('!!aslSelections.setup()')
  !undo.redoAction('!!aslSelections.setup()')
  !undo.add()

  --removes the deleted user setting from the list
  do !i index  !!aslCentralData.settings
    if (!!aslCentralData.settings[!i].deleteFlag) then
      !!aslCentralData.settings[!i].delete()
    endif
  enddo

  do !i index  !!aslCentralData.userSettings
    if (!!aslCentralData.userSettings[!i].deleteFlag) then
      !!aslCentralData.userSettings[!i].delete()
    endif
  enddo

  do !i index  !!aslCentralData.projectSettings
    if (!!aslCentralData.projectSettings[!i].deleteFlag) then
      !!aslCentralData.projectSettings[!i].delete()
    endif
  enddo

  !settingType = object STRING()

  do !i index  !!aslCentralData.userSettings
    if (!!aslCentralData.userSettings[!i].description.trim().eq(!this.meCurrSetting.description.trim())) then
      !!aslCentralData.userSettings[!i] = !this.meCurrSetting
      !settingType = 'USER'
      --Writing the available setting to the XML File by passing the settingType to aslCentralData
      !!aslCentralData.writeUserSettings(!settingType)
      break
    endif
  enddo

  !settingType = object STRING()
  do !i index  !!aslCentralData.projectSettings
    if (!!aslCentralData.projectSettings[!i].description.trim().eq(!this.meCurrSetting.description.trim())) then
      !!aslCentralData.projectSettings[!i] = !this.meCurrSetting
      !settingType = 'PROJECT'
      --Writing the available setting to the XML File by passing the settingType to aslCentralData
      !!aslCentralData.writeProjectSettings(!settingType)
      break
    endif
  enddo


  !settingType = object STRING()
  do !i index  !!aslCentralData.settings
    if (!!aslCentralData.settings[!i].description.trim().eq(!this.meCurrSetting.description.trim())) then
      !!aslCentralData.settings[!i] = !this.meCurrSetting
      !settingType = 'DFLTS'
      --Writing the available setting to the XML File by passing the settingType to aslCentralData
      !!aslCentralData.writeDfltSettings(!settingType)
      break
    endif
  enddo

  --compressing the settings after the deletion
  !!aslCentralData.userSettings.compress()
  !!aslCentralData.projectSettings.compress()
  !!aslCentralData.settings.compress()

  !collSetting = object REAL()
  !collSetting = !!aslCentralData.userSettings.size()
  !collSetting = !collSetting + !!aslCentralData.projectSettings.size()
  !collSetting = !collSetting + !!aslCentralData.settings.size()

  if (!collSetting.eq(0)) then
    !!aslCentralData.currSetting = object SETTING()
    !this.meCurrSetting = object SETTING()
  endif
    --update the settings GADGET
    !this.fillSettings()
    !this.updateGadgets()
    !!aslCentralData.updateSettings()

   -- end undo mark
  !undo.endUndoable()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      selectOption
--
-- Description: handles the selection of option within all option lists
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectOption(!gadget is GADGET, !action is STRING)

  if ( !this.meCurrSetting.description.set()) then

    -- updates the view only if anything is selected in the list
    if ( !gadget.selection().empty() ) then
      return
    endif

    -- ignores several call from the same gadget
    if ( !action.neq('STOP') ) then
      return
    endif

    -- remove the existing aid elements
    !!aidnumbers.hide(!this.meAidNumber)

    -- stores the recover information for view direction and view  limits
    if ( !this.meLastDisplayedElement.badRef() ) then
      !this.meLastDisplayedDirection = !!gphViews.views[1].direction
      !this.meLastDisplayedLimits    = !!gphViews.views[1].limits
    else
      !element = !this.meLastDisplayedElement
      REM $!element
    endif



    -- adds the selected element into the drawlist
    !this.meLastDisplayedElement = !gadget.selection().first().dbref()
    !element                     = !this.meLastDisplayedElement

    -- checks if the landing contains at least one panel
    if ( !element.mcount.eq(0) ) then
      return
    endif

    -- navigates to the ploo element below the panel
    !member = !element.members[1]

    -- displays the origin of the landing
    AID SPHERE NUMBER $!this.meAidNumber $!member.position DIAM 200
    handle ANY
    endhandle

    -- handles all vertex points of the landing
    !collection = object COLLECTION()
    !collection.scope(!member)
    !collection.type('PAVE')
    !paveRefes  = !collection.results()
    if ( !paveRefes.empty() ) then
      return
    endif

    -- displays the panels
    !plooRefe  = !paveRefes.first().owner
    !profile   = object PROFILE(!plooRefe)
    do !sequenceNo index !paveRefes

      -- reduces the expression
      !paveRefe = !paveRefes[!sequenceNo]

      -- evaluates the previous vertex point
      if ( !sequenceNo.eq(1) ) then
        !prevPAVERefe = !plooRefe.members.last()
      else
        !prevPAVERefe = !plooRefe.members[!sequenceNo - 1]
      endif

      -- evaluates the next vertex point
      if ( !sequenceNo.eq(!plooRefe.mcount) ) then
        !nextPAVERefe = !plooRefe.members.first()
      else
        !nextPAVERefe = !plooRefe.members[!sequenceNo + 1]
      endif

      -- generates the direction of the access point
      !line            = object LINE(!prevPAVERefe.position, !nextPAVERefe.position)
      !direction = !line.direction().orthogonal(U)

      -- moves the access point along the access direction
      !controlPosition = !paveRefe.position.offset(!direction, 10)

      -- checks if the position is within the ploop volume, if not choose the opposite direction
      if ( !profile.isWithin(!controlPosition) ) then
        !direction = !direction.opposite()
      endif
      !directionString = !direction.string().before(' WRT')

      if ( !paveRefe.gtype.eq('SU') ) then
          AID ARROW NUMB $!this.meAidNumber AT $!paveRefe.position DIR $!directionString 45 U HEIGHT 500
        elseif ( !paveRefe.gtype.eq('SD') ) then
          AID ARROW NUMB $!this.meAidNumber AT $!paveRefe.position DIR $!directionString 45 D HEIGHT 500
        else
          AID SPHERE NUMBER $!this.meAidNumber $!paveRefe.position DIAM 50
      endif
    enddo
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectSetting
--
-- Description: handles the selection of setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectSetting()

  if ( !this.meCurrSetting.description.set()) then
    -- Synchronise the ASL Setting selection between this form and Design Main ASL menu
    -- if called from this form then update the APPDESMAIN asl menu settings
    if(!this.settingsFrom.eq('APPDESMAINFORM')) then
      !mainMenuSetting = !!appDesMain.opASLSettings.selection().subString(4).trim()
      !formSettings = !this.opSettings.dText
      do !formSetting values !formSettings
        if(!formSetting.matchwild('$!<mainMenuSetting>*')) then
          !this.opSettings.select('dText',!formSetting)
          break
        endif
      enddo
    endif

    -- evaluates the name of the currently selected setting
    ---------------------------------------------------------------------------
    !descriptionArray = !this.opSettings.selection().split()
      if !descriptionArray.size().gt(2) then
        !description = !descriptionArray[1] + ' '
        do !i from 2 to !descriptionArray.size() - 1
          !description = !description + !descriptionArray[!i] + ' '
        enddo
      else
        !description = !this.opSettings.selection().split()[1]
        handle (2,752)
        !description = object STRING()
        endhandle
      endif

    -- evaluate the settings data
    ---------------------------------------------------------------------------
    do !setting value !!aslCentralData.userSettings
      if (!setting.description.trim().eq(!description.trim())) then
        !this.meCurrSetting = !setting
        !!aslCentralData.currSetting = !setting
        break
      endif
    enddo

    do !setting value !!aslCentralData.projectSettings
      if (!setting.description.trim().eq(!description.trim())) then
        !this.meCurrSetting = !setting
        !!aslCentralData.currSetting = !setting
        break
      endif
    enddo

    do !setting value !!aslCentralData.settings
      if (!setting.description.trim().eq(!description.trim())) then
        !this.meCurrSetting = !setting
        !!aslCentralData.currSetting = !setting
        break
      endif
    enddo


    -- evaluates the standard data
    ---------------------------------------------------------------------------
    do !settingData value !this.meCurrSetting.settingData
      if ( !settingData.purpose.eq('STANDARD') ) then
        -- selects the standard
        !this.opStandards.select('rText', !settingData.value)
        handle ANY
        	!this.meCurrSetting.settingData = object ARRAY()
        endhandle
        -- updates the substandard GADGET
        !this.fillSubStandards()
      elseif ( !settingData.purpose.eq('SUBSTANDARD') ) then
        -- selected the substandard from list
        !this.opSubStandards.select('rText', !settingData.value)
      endif
    enddo


    -- updates the different lists
    ---------------------------------------------------------------------------
    do !attributeName value !this.attributes()
      -- handles only relevant gadgets
      skip if ( !attributeName.matchwild('BU*ADD').not() )
      -- evaluates the main name
      !mainName = !attributeName.after('BU').subString(-4)
      !this.attribute('LI' & !mainName & 'ADD').clear()
      -- calls the update routine
      !this.updateAddList(!mainName)
      -- calls the update routine
      !this.updateRemList(!mainName)
    enddo

    -- Stores ASL Settings as displayed in design main ASL menu
    !appMainAslSettings = object ARRAY()
    !appMainAslSettings = !!appDesMain.opASLSettings.dText

    -- if called from this form then update the APPDESMAIN asl menu settings
    if(!this.settingsFrom.eq('SELECTIONSFORM')) then
      -- update/synchronize the design main ASL menu
      !currentSetting      = !this.meCurrSetting.description
      do !mainSettings values !appMainAslSettings
        if(!mainSettings.matchwild('*$!<currentSetting>')) then
          !!appDesMain.opASLSettings.select('dText', !mainSettings)
        endif
      enddo
    endif

    !this.settingsFrom  = 'SELECTIONSFORM'

  else
    -- if the meCurrSetting is unset
    !this.meCurrSetting = object SETTING()
    !!aslCentralData.currSetting = object SETTING()
    !!appDesMain.opASLSettings.dText = object ARRAY()

    do !attributeName value !this.attributes()
      -- handles only relevant gadgets

      -- evaluates the main name
      !mainName = !attributeName.after('BU').subString(-4)
      !this.attribute('BU' & !mainName & 'ADD').active = false
      handle (2,766)
      endhandle
      !this.attribute('BU' & !mainName & 'REM').active = false
      handle (2,766)
      endhandle
      !this.attribute('LI' & !mainName & 'ADD').clear()
      handle (2,766)
      endhandle
      !this.attribute('LI' & !mainName & 'REM').clear()
      handle (2,766)
      endhandle
      -- calls the update routine
      !this.updateAddList(!mainName)
      -- calls the update routine
      !this.updateRemList(!mainName)
    enddo

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setStandard
--
-- Description: sets the standard and substandard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setStandard()

  -- updates the substandard gadget
  !this.fillSubStandards()

  -- sets the substandard
  !this.setSubStandard()

endmethod
