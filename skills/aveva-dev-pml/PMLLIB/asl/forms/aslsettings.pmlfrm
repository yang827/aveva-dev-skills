--
--
-- Description:    ASL settings form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslSettingPopupCallback(ARRAY)   -                   shows the popup
--  aslSettings()                    -                   Constructor
--  clearAssemblyList()              -                   clears the assembly list if Settings exist
--  closeForm()                      -                   closes the form and restores the limits and the displayed elements
--  copySetting()                    -                   copy an existing setting
--  createSetting()                  -                   creates a new setting
--  createSettingToDb(SETTING)       -                   Create the assembly list based on the Settings to the DB
--  deleteSetting()                  -                   deletes the setting
--  fillSettings()                   -                   fills the settings gadget
--  fillStandards()                  -                   fills the standards gadget
--  fillSubStandards()               -                   fills the substandard gadget depending of the selected standard
--  renameDBelement(SETTING,STRING)  -                   renames the DB element
--  renameSetting()                  -                   renames an existing setting
--  selectAssembly()                 -                   init call of the form
--  selectSetting(ARRAY)             -                   handles the selection of setting
--  selectSetting(STRING)            -                   handles the selection of setting
--  setCurrentSetting()              -                   find the current setting and set it
--  setSetting(ARRAY)                -                   handles the selection of setting and assembly data
--  setStandard()                    -                   sets the standard and substandard
--  setSubStandard()                 -                   sets the substandard
--  setTemplateElements()            -                   set the template references in the form member
--  settingsArray()                  ARRAY               Returns the aslCentralData settings ( DFLT + User + Proj )
--  setup()                          -                   init call of the form
--  undo()                           -                   Read the data from the DB as per the undo action
--  updateGadgets()                  -                   Checks for the availability of the standard and updates the gadgets based on that.
--  updateSettingToDb()              -                   Update the settings in Db
--  updateStdSubStd()                -                   sets the substandard
--

import 'GridControl'
handle ANY
endhandle

setup form !!aslSettings dialog dock right
  -- .net library
  using namespace 'Aveva.Pdms.Presentation'

  -- form main attributes
  !this.autoscroll   = true
  !this.callback     = '!this.setup()'
  !this.cancelCall   = '!this.closeForm()'
  !this.formRevision = ' $Revision$ '
  !this.formTitle    = 'Assembly Selection for ASL application'
  !this.iconTitle    = 'ASL Assembly Selection'

  para      .paCreateSelection                             anchor T+L   at xmin form + 1           ymax+0.5  pixmap                                                width 16   height 16
  button    .lkCreateSelection  'Create a Setting...'      anchor T+L   at xmax+1                  ymin      linklabel  callback '!this.createSetting()'           width 11

  para      .paSelection                                   anchor T+L   at xmin.paCreateSelection  ymax+0.2  text 'Settings List'
  line      .lnSelection                                                at xmin                    ymax-0.2  anchor T+L+R HORIZ                                    width 53
  container .coAslSelection     NOBOX   PMLNetCONTROL      anchor T+L+R at xmin                    ymax+0.2                                                        width 53   height 7

  para      .paCopySelection                               anchor T+L   at xmin                    ymax+0.5  pixmap                                                width 16   height 16
  button    .lkCopySelection    'Copy selected Setting...' anchor T+L   at xmax+1                  ymin      linklabel  callback '!this.copySetting()'             width 14

  para      .paDeleteSelection                             anchor T+R   at xmax+10                 ymin      pixmap                                                width 16   height 16
  button    .lkDeleteSelection  'Delete Setting'           anchor T+R   at xmax+1                  ymin      linklabel  callback '!this.deleteSetting()'           width 9

  -- selectors for standard data
  frame     .paData                                        anchor all   at xmin form + 1           ymax+0.2  'Assembly Detail'                                     width 51
  para      .paStandard                                    anchor T+L   at xmin+1                  ymax+0.2  text 'Assigned Standard and Secondary Standard'
  line      .lnStandard                                                 at xmin                    ymax-0.2  anchor T+L+R HORIZ                                    width 50
  option    .opStandards        'Standard'                 anchor T+L+R at xmin.paStandard+2       ymax+0.2  callback '!this.setStandard()'          tagwidth 15   width 29
  option    .opSubStandards     'Secondary Standard'       anchor T+L+R at xmin.paStandard+2       ymax+0.2  callback '!this.setSubStandard()'       tagwidth 15   width 29

  -- Tab set for criteria
  para      .paTabs                                        anchor T+L   at xmin.paStandard         ymax+0.2  text 'Assembly Elements'
  line      .lnTabs                                                     at xmin                    ymax-0.2  anchor T+L+R  HORIZ                                   width 50
  frame     .frAssemblyTabs         tabset                 anchor T+L   at xmin.paStandard         ymax+0.2  anchor all

  -- initialise
  !criteriaSetDescs  = object ARRAY()
  !criteriaSetSuffix = object ARRAY()

  -- this is to define the different criteria groups
  !subStandard = object ASLSUBSTANDARD()

  -- handles all criteria sets of a subStandard
  do !criteriaSetName value !subStandard.attributes()

    -- delete existing distance
    if ( DEFINED(!criteriaSet) ) then
      !criteriaSet.delete()
    endif

    -- evaluates the criteria set
    !criteriaSet = !subStandard.attribute(!criteriaSetName)

    --ignores the basic data types
    skip if ( !criteriaSet.objectType() inset ('ARRAY', 'BOOLEAN', 'DBREF', 'REAL', 'STRING') )

    -- evaluates the description of the criteria set and stores the name
    !criteriaSetDescs.append(!criteriaSet.desc)
    !suffix = !criteriaSetName.after('ASL').before('CRITERIA')
    !criteriaSetSuffix.append(!suffix)
  enddo

  -- evaluates the order of the criteria set sorted by their description
  !sortedIndices = !criteriaSetDescs.sortedIndices()

  -- reorder the criteria sets attributes
  !criteriaSetDescs.reIndex(!sortedIndices)
  !criteriaSetSuffix.reIndex(!sortedIndices)


  -- handles all attributes of a subStandard
  do !i index !criteriaSetDescs

    -- reduces the size of the expression
    !desc   = !criteriaSetDescs[!i]
    !suffix = !criteriaSetSuffix[!i]

    -- We do not want the Stair Tower tab because it just uses the STFLT, STRLNG and HANDRA setting.
    skip if (!desc.upcase() eq 'STAIR TOWER')

    -- adds the graphical members
    frame       .fr$!<suffix>                      '$!desc'    anchor T+L+R at xmin ymin width 50 height 10
      container .co$!<suffix>        PMLNetCONTROL '$!desc'    dock fill
    exit

    -- adds the net control members
    member .net$!<suffix> is NETGRIDCONTROL
    -- container of all potential elements of the type
    member .me$!<suffix>Refes is ARRAY
  enddo
  -- End of Tabset
  exit

  para    .paAccept                at xmin+15            ymax+0.5 anchor B   pixmap                                                 width 16 height 16
  button  .lkAccept   linklabel    at xmax.paAccept+1    ymin     anchor B   'Accept changes'  callback '!this.updateSettingToDb()' width 10
  para    .paDiscard               at xmax.lkAccept+5    ymin     anchor B   pixmap                                                 width 16 height 16
  button  .lkDiscard  linklabel    at xmax.paDiscard+1   ymin     anchor B   'Discard changes' callback '!this.setup()'             width 10

exit

  -- define Setting list popup menu
  menu .aslSettingsPopup popup
  !this.aslSettingsPopup.add( 'CALLBACK', 'Set as Current Setting', '!this.setCurrentSetting()', 'current')
  !this.aslSettingsPopup.add( 'CALLBACK', 'Rename Selected Setting', '!this.renameSetting()', 'rename' )
  !this.aslSettingsPopup.add( 'CALLBACK', 'Copy Selected Setting', '!this.copySetting()', 'copy' )
  !this.aslSettingsPopup.add( 'CALLBACK', 'Delete Selected Setting', '!this.deleteSetting()', 'delete' )

  -- members
  -- contains the setting
  member .meCurrSetting        is SETTING

  -- Members for net grid control
  member .neAslSettings        is NETGRIDCONTROL

  --Members to select the toggle state for the menu ( 'Navigate to the Setting Element' )
  member .activeStatus         is BOOLEAN

  --Member for selected setting
  member .selectedSetting      is STRING

  -- Undoable or not?
  member .undoable             is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslSettings
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslSettings()

  ---------------------------------------------------------------------------------------
  -- set the pixmap
  ---------------------------------------------------------------------------
  !this.paCreateSelection.addPixmap(!!pml.getPathName('aslnew16.png'))
  !this.paCopySelection.addPixmap(!!pml.getPathName('aslcopy16.png'))
  !this.paDeleteSelection.addPixmap(!!pml.getPathName('deletece16.png'))
  !this.paAccept.addPixmap(!!pml.getPathName('accept.png'))
  !this.paDiscard.addPixmap(!!pml.getPathName('discard.png'))

  --check the user to be a member of ASLADMIN and make the gadget visible
  if(!!aslCentralData.administrator) then
    !this.lkCreateSelection.active  = true
    !this.lkCopySelection.active    = true
    !this.lkDeleteSelection.active  = true
  else
    !this.lkCreateSelection.active  = false
    !this.lkCopySelection.active    = false
    !this.lkDeleteSelection.active  = false
  endif
  !this.paData.active            = false
  !this.lkCopySelection.active   = false
  !this.lkDeleteSelection.active = false

  ---------------------------------------------------------------------------------------
  --.net control for TOS element
  ---------------------------------------------------------------------------------------
  -- implement the .net control
  using namespace 'Aveva.Pdms.Presentation'
  -- create instance of .net control
  !this.neAslSettings = object NETGRIDCONTROL()

  -- add PML event handlers to .net control
  !this.neAslSettings.addeventhandler('AfterSelectChange', !this, 'selectSetting')
  !this.neAslSettings.addeventhandler('onPopup', !this, 'aslSettingPopupCallback')
  !this.neAslSettings.columnExcelFilter(true)
  !this.neAslSettings.outlookGroupStyle(false)
  !this.neAslSettings.fixedHeaders(true)
  !this.neAslSettings.fixedRows(false)
  !this.neAslSettings.editableGrid(false)
  !this.neAslSettings.headerSort(true)
  !this.neAslSettings.rowAddDeleteGrid(false)
  !this.neAslSettings.singlerowselection(true)

  -- add .net control to PML container
  !this.coAslSelection.control = !this.neAslSettings.handle()

  --set the headings of the level-list
  --!heading[1]           = 'No'
  !heading[1]           = 'Name of Setting'
  !heading[2]           = 'Type of Setting'
  --fill the title
  !title                = 'Assembly Selection List'
  --Initial value filled in the lsLandLevel
  !settingsList         = object ARRAY()
  !netSettingsDetail    = object NETDATASOURCE(!title, !heading, !settingsList)
  !this.neAslSettings.bindToDataSource(!netSettingsDetail)

  -- implement the .net controls
  ---------------------------------------------------------------------------
  do !attributeName value !this.attributes()
    --ignores no dot net members
    skip if ( !attributeName.substring(1, 3).lowcase().neq('net') )

    -- create instance of .net control
    !this.attribute(!attributeName) = object NETGRIDCONTROL()
    !this.attribute(!attributeName).columnExcelFilter(true)
    !this.attribute(!attributeName).outlookGroupStyle(false)
    !this.attribute(!attributeName).fixedHeaders(true)
    !this.attribute(!attributeName).fixedRows(false)
    !this.attribute(!attributeName).editableGrid(true)
    !this.attribute(!attributeName).headerSort(true)
    !this.attribute(!attributeName).seteditableColumn(1,false)
    !this.attribute(!attributeName).seteditableColumn(2,false)
    !this.attribute(!attributeName).seteditableColumn(4,false)
    !this.attribute(!attributeName).rowAddDeleteGrid(false)

    -- create the value list for the exit type column
    !assigned[1] = 'True'
    !assigned[2] = 'False'
    !this.attribute(!attributeName).createValueList('Assigned', !assigned)

    -- add .net control to PML container
    !containerName                          = 'co' & !attributeName.lowcase().after('net')
    !this.attribute(!containerName).control = !this.attribute(!attributeName).handle()

    --set the headings of the level-list
    !heading[1]           = 'No'
    !heading[2]           = 'Description of Assembly'
    !heading[3]           = 'Assigned'
    !heading[4]           = 'Assembly Item'
    --fill the title
    !title                = 'Assembly  List'
    --Initial value filled in the lsLandLevel
    !assemblyList         = object ARRAY()
    !netAssemblyDetail    = object NETDATASOURCE(!title, !heading, !assemblyList)
    !this.attribute(!attributeName).bindToDataSource(!netAssemblyDetail)
  enddo

  --initialise
  !this.undoable = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setTemplateElements
--
-- Description: set the template references in the form member
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setTemplateElements()

  do !attributeName value !this.attributes()
    skip if ( !attributeName.substring(1, 3).lowcase().neq('net') )

    !type = !attributeName.lowcase().after('net')

    --when element types are available get rid of collectType and replace it by !type
    if ( !type inset ('WWAY') ) then
      !collectType = 'STRLNG'
    else
      !collectType = !type
    endif

    --remove this if the types are available in the db
    skip if ( !collectType inset ('PIPEBDG', 'STRTWR') )
    !currSelection = '/' & !this.opStandards.selection()
    skip if ( !currSelection.upcase().eq('/UNSET') )

    !eleScope = !currSelection.dbref().owner

    --collect the Assembly members
    !assembly       = object COLLECTION()
    if ( !collectType.upcase().eq('HANDRA') ) then
      !purpAssembly   = object EXPRESSION(|TYPE of OWN neq 'LADDER'|)
    endif
    !assembly.filter(!purpAssembly)
    !assembly.type(!collectType)
    !assembly.scope(!eleScope)
    !assemblyResult = !assembly.results()

    !this.attribute('ME' & !type & 'REFES') = !assemblyResult

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      closeForm
--
-- Description: closes the form and restores the limits and the displayed elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .closeForm()

  !this.hide()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createSetting
--
-- Description: creates a new setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .createSetting()

  if(undefined(!!aslStoreTable))then
    !!alert.error('Set storage area for ASL Setting')
    return
  endif

  if(!!aslStoreTable.getStore('settings').unset())then
    !!alert.warning('Set Storage area for ASL Setting. Goto Settings MENU ---->> ASL Storage Area...to set.')
    return
  endif

  if(!!dbrefupdate(!!aslStoreTable.getStore('settings')).not() )then
    !!alert.error('Access Denied. Read only DB')
    !this.display()
    return
  endif

  if ( !!aslStoreTable.getStore('settings').lock ) then
    !!alert.warning('Element is Locked!')
    return
  endif

  pml reload form !!aslCreateSettings
  !!aslCreateSettings.formTitle       = 'Create ASL Setting'
  !!aslCreateSettings.dbName.val      = 'Unset'
  !!aslCreateSettings.action          = 'CREATE'
  !!aslCreateSettings.dbName.setTooltip('Enter name of the Setting')
  !!aslCreateSettings.ok.setTooltip('Create ASL Setting')
  !!aslCreateSettings.cancel.setTooltip('Dismiss the form')
  show !!aslCreateSettings

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copySetting
--
-- Description: Copies an existing setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .copySetting()

  if(undefined(!!aslStoreTable))then
    !!alert.error('Set storage area for ASL Setting')
    return
  endif

  if(!!aslStoreTable.getStore('settings').unset())then
    !!alert.warning('Set Storage area for ASL Setting. Goto Settings MENU ---->> ASL Storage Area...to set.')
    return
  endif

  if(!!dbrefupdate(!!aslStoreTable.getStore('settings')).not() )then
    !!alert.error('Access Denied. Read only DB')
    !this.display()
    return
  endif

  --get the selected Settings
  !selectedSetting  =  !this.neAslSettings.getselectedrows()

  if ( !selectedSetting.unset() ) then
    !!alert.error('No Setting selected to copy. Select a Setting to copy.')
    return
  endif

  if ( !!aslStoreTable.getStore('settings').lock ) then
    !!alert.warning('Element is Locked!')
    return
  endif

  -- check for the unset Settings
  if ( !selectedSetting[1][2].upcase().eq('UNSET') ) then
    !!alert.error('UNSET settings cannot be copied!')
    !this.updateGadgets()
    return
  endif

  if ( !selectedSetting[1][2].eq('DFLTS') ) then
    !!alert.error(|Only USER or PROJECT Setting Can be Copied. Cannot Copy '$!selectedSetting[1][1]' Default ASL Setting.|)
    return
  endif

  pml reload form !!aslCreateSettings
  !!aslCreateSettings.formTitle       = 'Copy ASL Setting'
  !!aslCreateSettings.dbName.val      = 'Unset'
  !!aslCreateSettings.action          = 'COPY'
  !!aslCreateSettings.dbName.setTooltip('Enter name of the Setting to be Copied')
  !!aslCreateSettings.type.setTooltip('Setting type')
  !!aslCreateSettings.ok.setTooltip('Copy ASL Setting')
  !!aslCreateSettings.cancel.setTooltip('Dismiss the form')
  show !!aslCreateSettings

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      renameSetting
--
-- Description: renames an existing setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .renameSetting()

  --get the selected Settings
  !selectedSetting  =  !this.neAslSettings.getselectedrows()
  !dbElement        = '/' & '$!selectedSetting[1][1]'

  if ( !selectedSetting.unset() ) then
    !!alert.error('No Setting selected to Rename. Select a Setting to rename.')
    return
  endif

  -- check for the unset Settings
  if ( !selectedSetting[1][2].upcase().eq('UNSET') ) then
    !!alert.error('UNSET settings cannot be renamed!')
    !this.updateGadgets()
    return
  endif

  --check for the write access
  if( !!dbrefupdate(!dbElement.dbref()).not() )then
    !!alert.error(!!error.text)
    !this.updateGadgets()
    return
  endif

  if ( !dbElement.dbref().dacdel.not() ) then
    !!alert.warning(|Data Access Rights does not allow the user to delete the element| & !dbElement)
    return
  endif

  if ( !selectedSetting[1][2].eq('DFLT') ) then
    !!alert.error(|Only USER or PROJECT Setting Can be Renamed. Cannot Rename '$!selectedSetting[1][1]' Default ASL Setting.|)
    return
  endif

  !this.selectedSetting = !selectedSetting[1][1]

  pml reload form !!aslCreateSettings
  !!aslCreateSettings.formTitle       = 'Rename ASL Setting'
  !!aslCreateSettings.dbName.val      = '/' & '$!selectedSetting[1][1]'
  --!!aslCreateSettings.dbName.val      = 'Unset'
  !!aslCreateSettings.action          = 'RENAME'
  !!aslCreateSettings.dbName.setTooltip('Enter new name for the Setting')
  !!aslCreateSettings.type.setTooltip('Setting type')
  !!aslCreateSettings.ok.setTooltip('Rename ASL Setting')
  !!aslCreateSettings.cancel.setTooltip('Dismiss the form')
  show !!aslCreateSettings

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteSetting
--
-- Description: deletes the setting
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deleteSetting()

  !selectedSettings =  !this.neAslSettings.getselectedrows()

  if ( !selectedSettings.unset() ) then
    !!alert.error('No Setting selected to Delete.')
    return
  elseif ( !selectedSettings[1][2].upcase().eq('UNSET') ) then
    !!alert.error('Settings does not exists. Delete action cannot be performed!')
    !this.updateGadgets()
    return
  elseif ( !selectedSettings[1][2].upcase().eq('DFLT') ) then
    !!alert.error('Cannot delete the DEFAULT setting!.')
    !this.updateGadgets()
    return
  else
    !selectedSetting  =  !this.neAslSettings.getselectedrows()[1][1]
    !deleteElement    =  '/' & '$!selectedSetting'
    !deleteDbElement  =  !deleteElement.dbref()

    --get the old references
    !oldRefe = !!ce

    --get the form Data
    !deleteType       =  !!alert.confirm('Ok to delete $!selectedSettings[1][1] setting?')
    if ( !deleteType.eq('NO') ) then
      return
    endif

    if( !!dbrefupdate( !deleteDbElement ) ) then
      if ( !deleteDbElement.lock ) then
        !!alert.warning('Setting is Locked!!')
        return
      endif
    else
      !!alert.error(|Access Denied. '$!deleteDbElement' is in Read only DB|)
      !this.updateGadgets()
      return
    endif

    --!this.meCurrSetting.deleteFlag = !deleteType.boolean()
    do !i index !!aslCentralData.userSettings
      if (!!aslCentralData.userSettings[!i].description.eq(!selectedSetting)) then
        !!aslCentralData.userSettings[!i].deleteFlag = !deleteType.boolean()
      endif
    enddo

    do !i index !!aslCentralData.projectSettings
      if (!!aslCentralData.projectSettings[!i].description.eq(!selectedSetting)) then
        !!aslCentralData.projectSettings[!i].deleteFlag = !deleteType.boolean()
      endif
    enddo

    do !i index !!aslCentralData.settings
      if (!!aslCentralData.settings[!i].description.eq(!selectedSetting)) then
        !!aslCentralData.settings[!i].deleteFlag = !deleteType.boolean()
      endif
    enddo

    !undo = object UNDOABLE()
    !undo.description('Delete Setting')
    -- undo callback must be declared in fullname format (not using !this shortcut) as it will be called externally
    !undoCall = '!!aslSettings.undo()'
    !undo.undoaction(!undoCall)
    !undo.redoaction(!undoCall)
    !undo.add()

    --delete the setting from the DB
    !!ce = !deleteDbElement
    DELETE APPLDA

    --read the asl setting
    !!aslCentralData.readAslSettings()

    -- update the assembly list
    !this.clearAssemblyList()

    -- updates the settings in the list
    !this.fillSettings()

    --update the gadget list
    !this.updateGadgets()

    --select the first row
    if ( !this.neAslSettings.getRows().size().geq(1) and !this.neAslSettings.getRows()[1][2].upcase().neq('UNSET') ) then
      !this.neAslSettings.selectRow(1)
      !settingDesc = object ARRAY()
      !settingDesc[1] = !this.neAslSettings.getselectedrows()[1][1]
    endif

    if ( !oldRefe.badref().not() ) then
      !!ce = !oldRefe
    endif
  endif

  --end the undoable mark
  !undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fillStandards
--
-- Description: fills the standards gadget
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .fillStandards()

  !standardNames = object ARRAY()
  --set all the available standards
  do !standard value !!aslCentralData.standards
    !standardNames.append(!standard.name)
  enddo

  !this.opStandards.dText = !standardNames.sort()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fillSubStandards
--
-- Description: fills the substandard gadget depending of the selected standard
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .fillSubStandards()

  -- evaluate the currently selected standard
  !standardName = !this.opStandards.selection('rText')
  -- evaluates all substandard of the currently selected standard and fills the gadget
  do !standard value !!aslCentralData.standards
    if ( !standard.name.eq(!standardName)) then
     !subStandardNames = object ARRAY()
      do !subStandard value !standard.subStandards
        !subStandardNames.append(!subStandard.name)
      enddo
      !this.opSubStandards.dText = !subStandardNames
      break
    endif
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setStandard
--
-- Description: sets the standard and substandard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setStandard()

  !selectedSetting  =  !this.neAslSettings.getselectedrows()

  if ( !selectedSetting.unset() ) then
    return
  endif

  -- updates the substandard gadget
  !this.fillSubStandards()

  --check for unset standards
  if ( !this.opStandards.selection().upcase().eq('UNSET') ) then
    return
  endif

  --set the member details
  !this.setTemplateElements()
  !this.selectAssembly()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setStandard
--
-- Description: sets the standard and substandard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setSubStandard()

  !selectedSetting  =  !this.neAslSettings.getselectedrows()

  if ( !selectedSetting.unset() ) then
    return
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateStdSubStd
--
-- Description: sets the substandard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateStdSubStd()

  -- evaluates the standard data
  !this.meCurrSetting.settingData = object ARRAY()
  !this.meCurrSetting.subSettings = object ARRAY()
  !!aslCentralData.currSetting.settingData = object ARRAY()

  !newSettingData         = object SETTINGDATA()
  !newSettingData.purpose = 'STANDARD'
  !newSettingData.value   = !!aslSettings.opStandards.selection()
  !!aslCentralData.currSetting.settingData.append(!newSettingData)

  !newSettingData         = object SETTINGDATA()
  !newSettingData.purpose = 'SUBSTANDARD'
  !newSettingData.value = !!aslSettings.opSubStandards.selection()
  !!aslCentralData.currSetting.settingData.append(!newSettingData)

  !this.meCurrSetting = !!aslCentralData.currSetting

  do !setting value !!aslCentralData.userSettings
     if ( !setting.description.eq(!!aslCentralData.currSetting.description) ) then
        !setting = !!aslCentralData.currSetting
        break
     endif
  enddo

  do !setting value !!aslCentralData.projectSettings
     if ( !setting.description.eq(!!aslCentralData.currSetting.description) ) then
        !setting = !!aslCentralData.currSetting
        break
     endif
  enddo

  do !setting value !!aslCentralData.settings
     if ( !setting.description.eq(!!aslCentralData.currSetting.description) ) then
        !setting = !!aslCentralData.currSetting
        break
     endif
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: init call of the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setup()

  --fills the setting details
  !this.fillSettings()

  --update the gadgets
  !this.updateGadgets()

  --select the first row
  if ( !this.neAslSettings.getRows().set() ) then
    !this.neAslSettings.selectRow(1)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      fillSettings
--
-- Description: fills the settings gadget
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .fillSettings()

  -- initialise the settings
  !settingDesc = object ARRAY()
  -- evaluate the settings data
  do !setting value !!aslCentralData.userSettings
    if (!setting.deleteFlag.not()) then
      !settingItems = object ARRAY()
      !settingItems.append(!setting.description)
      !settingItems.append(!setting.type)
      !settingDesc.append(!settingItems)
    endif
  enddo

  do !setting value !!aslCentralData.projectSettings
    if (!setting.deleteFlag.not()) then
      !settingItems = object ARRAY()
      !settingItems.append(!setting.description)
      !settingItems.append(!setting.type)
      !settingDesc.append(!settingItems)
    endif
  enddo

  do !setting value !!aslCentralData.settings
    if (!setting.deleteFlag.not()) then
      !settingItems = object ARRAY()
      !settingItems.append(!setting.description)
      !settingItems.append(!setting.type)
      !settingDesc.append(!settingItems)
    endif
  enddo

  if (!settingDesc.unset()) then
    !settingItems = object ARRAY()
    !settingDesc = object ARRAY()
    !settingItems.append('Unset')
    !settingItems.append('Unset')
    !settingDesc.append(!settingItems)
  endif

  -- implement the .net control
  using namespace 'Aveva.Pdms.Presentation'

  --set the headings of the level-list
  !heading[1]           = 'Name of Setting'
  !heading[2]           = 'Type of Setting'

  --fill the title
  !title                = 'Assembly Selection List'

  --Initial Value filled in the lsLandLevel
  !netSettingsDetail    = object NETDATASOURCE(!title, !heading, !settingDesc)
  !this.neAslSettings.bindToDataSource(!netSettingsDetail)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectSetting
--
-- Description: handles the selection of setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectSetting(!selectedSetting is ARRAY)

  --check for the selected setting
  if ( undefined(!selectedSetting) or !selectedSetting.unset() ) then
    !this.lkCreateSelection.active = !!aslCentralData.administrator
    !this.paData.active            = false
    !this.lkCopySelection.active   = false
    !this.lkDeleteSelection.active = false
    !this.lkAccept.active          = false
    !this.lkDiscard.active         = false
    return
  endif

  --select the tag
  !selectedRow = !this.neAslSettings.getRow(!selectedSetting[0][1].real())
  handle (2,752)
    return
  endhandle

  if ( !selectedRow[2].upcase().eq('DFLT') and !!aslCentralData.administrator ) then
    --set the visible status
    !this.lkCreateSelection.active = !selectedSetting[0].empty().not()
    !this.paData.active            = !selectedSetting[0].empty().not()
    !this.lkCopySelection.active   = !selectedSetting[0].empty().not()
    !this.lkDeleteSelection.active = !selectedSetting[0].empty()
    !this.lkAccept.active          = !selectedSetting[0].empty().not()
    !this.lkDiscard.active         = !selectedSetting[0].empty().not()

  elseif ( !selectedRow[2].upcase().eq('DFLT') and !!aslCentralData.administrator.not() ) then
    --set the visible status
    !this.lkCreateSelection.active = !selectedSetting[0].empty()
    !this.paData.active            = !selectedSetting[0].empty().not()
    !this.lkCopySelection.active   = !selectedSetting[0].empty()
    !this.lkDeleteSelection.active = !selectedSetting[0].empty()
    !this.lkAccept.active          = !selectedSetting[0].empty()
    !this.lkDiscard.active         = !selectedSetting[0].empty()

  elseif ( !selectedRow[2].upcase().eq('PROJ') and !!aslCentralData.administrator ) then
    --set the visible status
    !this.lkCreateSelection.active = !selectedSetting[0].empty().not()
    !this.paData.active            = !selectedSetting[0].empty().not()
    !this.lkCopySelection.active   = !selectedSetting[0].empty().not()
    !this.lkDeleteSelection.active = !selectedSetting[0].empty().not()
    !this.lkAccept.active          = !selectedSetting[0].empty().not()
    !this.lkDiscard.active         = !selectedSetting[0].empty().not()

  elseif ( !selectedRow[2].upcase().eq('PROJ') and !!aslCentralData.administrator.not() ) then
    --set the visible status
    !this.lkCreateSelection.active = !selectedSetting[0].empty()
    !this.paData.active            = !selectedSetting[0].empty().not()
    !this.lkCopySelection.active   = !selectedSetting[0].empty()
    !this.lkDeleteSelection.active = !selectedSetting[0].empty()
    !this.lkAccept.active          = !selectedSetting[0].empty()
    !this.lkDiscard.active         = !selectedSetting[0].empty()
  endif

  if ( !selectedRow[2].upcase().eq('UNSET') ) then
    return
  endif

  --collect the central data settings
  !settings = !this.settingsArray()

  -- update the standards and secondary standards list
  !this.fillStandards()
  !this.fillSubStandards()

  -- evaluates the standard data
  do !aslSetting value !settings
    if ( !aslSetting.description.eq(!selectedRow[1]) ) then
      do !aslSettingData values !aslSetting.settingData
        if ( !aslSettingData.purpose.upcase().trim().eq('STANDARD') ) then
          !this.opStandards.select('RTEXT', !aslSettingData.value)
          !this.fillSubStandards()
        elseif ( !aslSettingData.purpose.upcase().trim().eq('SUBSTANDARD') ) then
          !this.opSubStandards.select('RTEXT', !aslSettingData.value)
        endif
      enddo
    endif
  enddo

  --set the assembly data
  if ( !selectedRow.set() ) then
    !this.setSetting(!selectedRow)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectSetting
--
-- Description: handles the selection of setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectSetting(!selectedSetting is STRING)

  --select the tag
  !selectedRow    = object ARRAY()
  !selectedRow[1] = !selectedSetting.after('/')

  -- update the standards and secondary standards list
  !this.fillStandards()
  !this.fillSubStandards()

  --set the assembly elements
  if ( !selectedRow.set() ) then
    !this.setSetting(!selectedRow)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      settingsArray
--
-- Description: Returns the aslCentralData settings ( DFLT + User + Proj )
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .settingsArray() is ARRAY

  -- evaluate the settings data
  !settings = object ARRAY()
  !settings.appendarray(!!aslCentralData.userSettings)
  !settings.appendarray(!!aslCentralData.projectSettings)
  !settings.appendarray(!!aslCentralData.settings)

  return !settings

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setSetting
--
-- Description: handles the selection of setting and assembly data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setSetting(!selectedRow is ARRAY)

  --check for badref
  !element   = '/' & !selectedRow[1]
  !unusedElement = object DBREF(!element)
  handle ANY
    return
  endhandle

  --collect the central data settings
  !settings  = !this.settingsArray()

  --use the .net library
  using namespace  'Aveva.Pdms.Presentation'

  --set the headings of the level-list
  !heading[1]           = 'No'
  !heading[2]           = 'Description of Assembly'
  !heading[3]           = 'Assigned'
  !heading[4]           = 'Assembly Item'

  --fill the title
  !title                = 'Assembly  List'

  do !aslSetting value !settings
    if ( !aslSetting.description.eq(!selectedRow[1]) ) then
      --Initial value filled in the lsLandLevel
      do !settingList values !aslSetting.subSettings
      !attributeName = 'NET' & !settingList.purpose
        !assemblyList       = object ARRAY()
        do !j indices !settingList.settingData
          !assemblyList[!j]       = object ARRAY()
          -- column1 ,Index no.
          !assemblyList[!j].append(!j.string())
          -- column2, Description of the assembly
          !data = !settingList.settingData[!j].value
          --!descRef = '/' & !data
          !descRef = !data
          !descOfItem = !descRef.dbref().desc
          !assemblyList[!j].append(!descOfItem)
          -- column3, assigned status
          !assemblyList[!j].append(!settingList.settingData[!j].assigned)
          -- column4, reference assembly element
          !assemblyList[!j].append(!settingList.settingData[!j].value)
        enddo
        !netAssemblyDetail    = object NETDATASOURCE(!title, !heading, !assemblyList)
        !this.attribute(!attributeName).bindToDataSource(!netAssemblyDetail)
        -- the following syntaxes must be carried out after the list has been filled!
        ---------------------------------------------------------------------------
        -- exit types
        !this.attribute(!attributeName).assignValueListToColumn('Assigned', 3)
        !this.attribute(!attributeName).seteditableColumn(1,false)
        !this.attribute(!attributeName).seteditableColumn(2,false)
        !this.attribute(!attributeName).seteditableColumn(4,false)
      enddo
    endif
  enddo
  --set the selected row

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectAssembly
--
-- Description: init call of the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectAssembly()

  --use the .net library
  using namespace  'Aveva.Pdms.Presentation'

  -- defines the headers of the different lists
  ---------------------------------------------------------------------------
  do !attributeName value !this.attributes()
    --ignores no dot net members
    skip if ( !attributeName.substring(1, 3).lowcase().neq('net') )

    -- create instance of .net control
    !this.attribute(!attributeName) = object NETGRIDCONTROL()
    -- create the value list for the exit type column
    !assigned[1] = 'True'
    !assigned[2] = 'False'
    !this.attribute(!attributeName).createValueList('Assigned', !assigned)

    -- add .net control to PML container
    !containerName                          = 'co' & !attributeName.lowcase().after('net')
    !this.attribute(!containerName).control = !this.attribute(!attributeName).handle()

    --set the headings of the level-list
    !heading[1]           = 'No'
    !heading[2]           = 'Description of Assembly'
    !heading[3]           = 'Assigned'
    !heading[4]           = 'Assembly Item'
    --fill the title
    !title                = 'Assembly  List'
    --Initial value filled in the lsLandLevel
    !assemblyList         = object ARRAY()

    !type = !attributeName.lowcase().after('net')

    --when element types are available get rid of collectType and replace it by !type
    if ( !type inset ('WWAY') ) then
      !collectType = 'STRLNG'
    else
      !collectType = !type
    endif

    --remove this if the types are available in the db
    skip if ( !collectType inset ('PIPEBDG', 'STRTWR') )

    do !i indices !this.attribute('ME' & !type & 'REFES')
      !assemblyDetail      = !this.attribute('ME' & !type & 'REFES')[!i]
      !assemblyList[!i]    = object ARRAY()
      -- column1 ,Index no.
      !assemblyList[!i].append(!i.string())
      -- column2, reference assembly element
      !assemblyList[!i].append(!assemblyDetail.desc)
      -- column3, assigned status
      !assemblyList[!i].append('True')
      -- column4, reference element
      !assemblyList[!i].append(!assemblyDetail.name.string().trim())
    enddo

    !netAssemblyDetail    = object NETDATASOURCE(!title, !heading, !assemblyList)
    !this.attribute(!attributeName).bindToDataSource(!netAssemblyDetail)

    -- the following syntaxes must be carried out after the list has been filled!
    ---------------------------------------------------------------------------
    -- exit types
    !this.attribute(!attributeName).assignValueListToColumn('Assigned', 3)

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Updates the gadgets based on the Settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadgets()

  !getSettings = !this.neAslSettings.getRows()

  if ( !getSettings.size().eq(1) and !getSettings[1][2].upcase().eq('UNSET') ) then
    !this.opStandards.clear()
    !this.opSubStandards.clear()
    !dText = object ARRAY()
    !dText.append('Unset')
    !this.opStandards.dText = !dText
    !this.opSubStandards.dText = !dText
    --make the gadgets inactive
    !this.lkCopySelection.active   = false
    !this.lkDeleteSelection.active = false
    !this.lkAccept.active          = false
    !this.lkDiscard.active         = false
    --!this.fillAssemblyList()
  elseif ( !getSettings.size().eq(1) and !getSettings[1][2].upcase().neq('UNSET') ) then
    -- fill the standard and Sub-Standard
    !this.fillStandards()
    !this.fillSubStandards()
    --make the gadgets active
    !this.lkCopySelection.active   = true
    !this.lkDeleteSelection.active = true
    !this.lkAccept.active          = true
    !this.lkDiscard.active         = true
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      createSettingToDb
--
-- Description: Create the assembly list based on the Settings to the DB
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createSettingToDb(!newSetting is SETTING)

  --create the setting
  -- create undo mark
  !undo = object UNDOABLE()
  !undo.description('Create Setting')
  -- undo callback must be declared in fullname format (not using !this shortcut) as it will be called externally
  !undoCall = '!!aslSettings.undo()'
  !undo.undoaction(!undoCall)
  !undo.redoaction(!undoCall)
  !undo.add()

  !oldRefe = !!ce

  --navigate to the storage Area
  !!ce = !!aslStoreTable.getStore('settings')

  --create the APPLDA
  !settingRefe           = object DBREF()
  !settingRefe           = !!aslCreate('APPLDA', !settingRefe)
  !settingRefe.name      = '/' & '$!newSetting.description'
  !settingRefe.function  = 'SETTING'
  !settingRefe.purpose   = !newSetting.purpose
  !settingRefe.gtype     = !newSetting.type

  --create the standards data
  !!ce = !settingRefe
  !stdSubStdRefe           = object DBREF()
  !stdSubStdRefe           = !!aslCreate('DDSE', !stdSubStdRefe)
  !stdSubStdRefe.function  = 'STANDARD-SUBSTANDARD'
  !stdSubStdRefe.purpose   = 'ASLA'

  --create the ddat element
  !!ce = !stdSubStdRefe
  do !stdSubStd values !newSetting.settingData
    !stdSubValue = object DBREF()
    !stdSubValue = !!aslCreate('DDAT', !stdSubValue)
    !stdSubValue.purpose     = 'ASLA'
    !stdSubValue.description = !stdSubStd.purpose
    !stdSubValue.lDisp       = !stdSubStd.assigned
    !stdSubValue.dDproperty  = '/' & '$!stdSubStd.value'
  enddo

  --create the data set elements
  do !criteriaValue values !newSetting.subSettings
    !!ce = !stdSubStdRefe
    !criteriaValToDb = object DBREF()
    !criteriaValToDb = !!aslCreate('DDSE', !criteriaValToDb)
    !criteriaValToDb.purpose            = 'ASLA'
    !criteriaValToDb.function           = !criteriaValue.purpose
    do !criteriaSetValue values !criteriaValue.settingData
      !criteriaSetValueToDb             = object DBREF()
      !criteriaSetValueToDb             = !!aslCreate('DDAT', !criteriaSetValueToDb)
      !criteriaSetValueToDb.purpose     = 'ASLA'
      !criteriaSetValueToDb.description = !criteriaSetValue.purpose
      !criteriaSetValueToDb.lDisp       = !criteriaSetValue.assigned
      !criteriaSetValueToDb.dDproperty  = '/' & '$!criteriaSetValue.value'
    enddo
  enddo
  --navigate to the same Element
  if ( !oldRefe.badref().not() ) then
    !!ce = !oldRefe
  endif

  --end the undoable mark
  !undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      undo
--
-- Description: Read the data from the DB as per the undo action
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .undo()

  --read the settings from the DB
  !!aslCentralData.readAslSettings()

  --initialise the form
  !this.setup()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateSettingToDb
--
-- Description: Update the settings in Db
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateSettingToDb()

  -- create undo mark
  !undo = object UNDOABLE()
  !undo.description('Update Setting')
  -- undo callback must be declared in fullname format (not using !this shortcut) as it will be called externally
  !undoCall = '!!aslSettings.undo()'
  !undo.undoaction(!undoCall)
  !undo.redoaction(!undoCall)
  !undo.add()

  --get the old ce
  !oldCe = !!ce

  --get the selected setting
  !selectedSetting  =  !this.neAslSettings.getselectedrows()
  if ( !selectedSetting.unset() ) then
    !!alert.warning('Select a Setting to Update Changes!')
    return
  elseif ( !selectedSetting[1][2].upcase().eq('UNSET') ) then
    !!alert.warning('No Settings to UPDATE!')
    return
  endif

  !modifySetting = '/' & '$!selectedSetting[1][1]'
  !!ce = !modifySetting.dbref()

  --modify the standard and secondary standard data
  !valuePurpose  = object EXPRESSION('(PURP eq |ASLA|) and (FUNC eq |STANDARD-SUBSTANDARD|)')

  !collectValue  = object COLLECTION()
  !collectValue.type('DDSE')
  !collectValue.scope(!modifySetting.dbref())
  !collectValue.filter(!valuePurpose)
  !resultValue   = !collectValue.results()

  --modify the standard data
  !stdPurpose    = object EXPRESSION('(PURP eq |ASLA|) and (DESC eq |STANDARD|)')

  !collectStd    = object COLLECTION()
  !collectStd.type('DDAT')
  !collectStd.scope(!resultValue)
  !collectStd.filter(!stdPurpose)
  !resultStd     = !collectStd.results()

  --set the selected standard
  !resultStd.first().dDproperty   = '/' & !this.opStandards.selection()

  --modify the secondary standard data
  !secStdPurpose    = object EXPRESSION('(PURP eq |ASLA|) and (DESC eq |SUBSTANDARD|)')

  !collectSecStd    = object COLLECTION()
  !collectSecStd.type('DDAT')
  !collectSecStd.scope(!resultValue)
  !collectSecStd.filter(!secStdPurpose)
  !resultSecStd     = !collectSecStd.results()

  --set the selected standard
  !resultSecStd.first().dDproperty   = '/' & !this.opSubStandards.selection()

  -- initialise
  !criteriaSetSuffix = object ARRAY()

  -- this is to define the different criteria groups
  !subStandard = object ASLSUBSTANDARD()

  -- handles all criteria sets of a subStandard
  do !criteriaSetName value !subStandard.attributes()
    -- delete existing distance
    if ( DEFINED(!criteriaSet) ) then
      !criteriaSet.delete()
    endif

    -- evaluates the criteria set
    !criteriaSet = !subStandard.attribute(!criteriaSetName)
    --ignores the basic data types
    skip if ( !criteriaSet.objectType() inset ('ARRAY', 'BOOLEAN', 'DBREF', 'REAL', 'STRING') )
    -- evaluates the description of the criteria set and stores the name
    !suffix = !criteriaSetName.after('ASL').before('CRITERIA')
    skip if ( !suffix.eq('STRTWR') )
    !criteriaSetSuffix.append(!suffix)
  enddo


  do !assemblyValues values !criteriaSetSuffix
    --modify the assembly data
    !ddatAssemblyPurpose    = object EXPRESSION('(PURP eq |ASLA|) and (FUNC eq |$!assemblyValues|)')

    !collectDdatAssembly    = object COLLECTION()
    !collectDdatAssembly.type('DDSE')
    !collectDdatAssembly.scope(!modifySetting.dbref())
    !collectDdatAssembly.filter(!ddatAssemblyPurpose)
    !resultDdatAssembly     = !collectDdatAssembly.results()

    if ( !resultDdatAssembly.set() ) then
      --modify the assembly data
      !ddseAssemblyPurpose    = object EXPRESSION('(PURP eq |ASLA|) and (DESC eq |$!assemblyValues|)')

      !collectDdseAssembly    = object COLLECTION()
      !collectDdseAssembly.type('DDAT')
      !collectDdseAssembly.scope(!resultDdatAssembly.first())
      !collectDdseAssembly.filter(!ddseAssemblyPurpose)
      !resultDdseAssembly     = !collectDdseAssembly.results()

      --get the data from the form
      !attributeName = 'net' & '$!assemblyValues'
      !formValue = !this.attribute(!attributeName).getRows()
        do !i indices !resultDdseAssembly
          !resultDdseAssembly[!i].dDproperty = '/' & '$!formValue[$!i][4]'
          if ( !formValue[!i][3] inset('True', 'TRUE', 'true', '1' ) ) then
            !resultDdseAssembly[!i].lDisp      = true
          elseif ( !formValue[!i][3] inset('False', 'FALSE', 'false', '2' ) ) then
            !resultDdseAssembly[!i].lDisp      = false
          endif
        enddo
    endif

  enddo

  --read the settings from the DB
  !!aslCentralData.readAslSettings()
  !!ce = !oldCe

  --end the undoable mark
  !undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aslSettingPopupCallback
--
-- Description: shows the popup
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslSettingPopupCallback(!a is ARRAY)

  --get the selected setting
  !selectedSetting = !this.neAslSettings.getselectedrows()

  --set the active status
  if ( !selectedSetting[1][2].upcase().eq('DFLT') ) then
    !this.aslSettingsPopup.setfieldproperty('rename', 'active', false )
    !this.aslSettingsPopup.setfieldproperty('delete', 'active', false )
  else
    !this.aslSettingsPopup.setfieldproperty('rename', 'active', true )
    !this.aslSettingsPopup.setfieldproperty('delete', 'active', true )
  endif

  --set the callback
  !this.coAslSelection.popup = !this.aslSettingsPopup
  !this.coAslSelection.showPopup(!a[0], !a[1])

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setCurrentSetting
--
-- Description: find the current setting and set it
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setCurrentSetting()

  !selectedSetting  =  !this.neAslSettings.getselectedrows()
  if ( !selectedSetting.unset() ) then
    !!alert.message('Select to set Current Setting')
    return
  elseif ( !selectedSetting[1][2].upcase().eq('UNSET') ) then
    !!alert.error('Cannot set an Unset setting as Current setting!')
    return
  endif

  !settings = !this.settingsArray()

  --set the current Settings
  do !currSetting values !settings
    if ( !selectedSetting[1][1].eq(!currSetting.description) ) then
      !!aslCentralData.currSetting = !currSetting
      break
    endif
  enddo

  --set the current status for the setting
  --collect the setting from the Data Base
  !settingPurpose = object EXPRESSION(|FUNC eq 'SETTING'|)

  !collectSetting = object COLLECTION()
  !collectSetting.type('APPLDA')
--  !collectSetting.scope(/* )
  !collectSetting.filter(!settingPurpose)
  !resultSetting = !collectSetting.results()

  do !setStatus values !resultSetting
    if ( !selectedSetting[1][1].eq(!setStatus.namn) ) then
      !setStatus.tType = 'true'
    elseif ( !selectedSetting[1][1].neq(!setStatus.namn) ) then
      !setStatus.tType = ''
    endif
  enddo

  --call the method to set the gadget value
  !!aslCentralData.setAppDesMainSettings(!resultSetting)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clearAssemblyList
--
-- Description: clears the assembly list if Settings exist
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearAssemblyList()

  --use the .net library
  using namespace  'Aveva.Pdms.Presentation'

  -- defines the headers of the different lists
  ---------------------------------------------------------------------------
  do !attributeName value !this.attributes()
    --ignores no dot net members
    skip if ( !attributeName.substring(1, 3).lowcase().neq('net') )

    --Initial value filled in the lsLandLevel
    !assemblyList         = object ARRAY()

    !type = !attributeName.lowcase().after('net')

    --when element types are available get rid of collectType and replace it by !type
    if ( !type inset ('WWAY') ) then
      !collectType = 'STRLNG'
    else
      !collectType = !type
    endif

    --remove this if the types are available in the db
    skip if ( !collectType inset ('PIPEBDG', 'STRTWR') )

    do !i indices !this.attribute('ME' & !type & 'REFES')
      !this.attribute('NET' & !type).cleargrid()
    enddo

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      renameDBelement
--
-- Description: renames the DB element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .renameDBelement(!newSetting is SETTING, !dbName is STRING)

  -- create undo mark
  !undo = object UNDOABLE()
  !undo.description('Rename Setting')
  -- undo callback must be declared in fullname format (not using !this shortcut) as it will be called externally
  !undoCall = '!!aslSettings.undo()'
  !undo.undoaction(!undoCall)
  !undo.redoaction(!undoCall)
  !undo.add()

  --replace the existing setting
  do !i from 1 to !!aslCentralData.projectSettings.size()
    if ( !!aslSettings.selectedSetting.eq(!!aslCentralData.projectSettings[!i].description) ) then
      !!aslCentralData.projectSettings[!i] = !newSetting
    endif
  enddo

  --rename the DB Element
  !element    = '/' & '$!this.selectedSetting'
  !dbElement  = !element.dbref()
  !!ce        = !dbElement
  !!ce.name   = !dbName

  --end the undoable mark
  !undo.endUndoable()

endmethod
-- End of method
