------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStandards()                   -                   Constructor
--  copy(GADGET,STRING)              -                   copy an existing standard
--  create(GADGET,STRING)            -                   create a new standard
--  deleteStandard(GADGET,STRING)    -                   deletes the standard
--  logicalCheck(ARRAY,ARRAY)        -
--  save()                           -                   save the standards
--  select(GADGET,STRING)            -                   callback from option gadget
--  selectColumStandards(ARRAY)      -
--  setup()                          -                   callback when opening the form
--  updateGadgets()                  -                   update the gadgets
--  updateSubStandards()             -                   update the option gadget of the subStandards
--

import 'GridControl'
handle any
endhandle

--setup form !!aslStandards document
setup form !!aslStandards dialog dock size 53 25
  -- .net library
  using namespace 'Aveva.Pdms.Presentation'

  -- create/copy and select standards, set defaults
  para   .paStandard                                                 at   xmin form               ymin     anchor T+L    text 'Standard'
  line   .lnStandard                                                 at   xmin                    ymax-0.2 anchor T+L+R  HORIZ                                             width 50
  option .opStandards                                                at   xmin+1                  ymax+0.2 anchor T+L+R                  callback '!this.select('          width 40
  para   .paCreateStandard                                           at   xmin.opStandards        ymax+0.5 anchor T+L    pixmap                                            width 16 height 16
  button .lkCreateStandard     'Create a Standard...'                at   xmax.paCreateStandard+1 ymin     anchor T+L    linklabel       callback '!this.create('          width 12
  para   .paCopyStandard                                             at   xmin.paCreateStandard   ymax     anchor T+L    pixmap                                            width 16 height 16
  button .lkCopyStandard       'Copy existing standard...'           at   xmin.lkCreateStandard   ymin     anchor T+L    linklabel       callback '!this.copy('            width 15
  para   .paDeleteStandard                                           at   xmin.paCreateStandard   ymax     anchor T+L    pixmap                                            width 16 height 16
  button .lkDeleteStandard     'Delete Standard...'                  at   xmin.lkCreateStandard   ymin     anchor T+L    linklabel       callback '!this.deleteStandard('  width 11

  para   .paSubStandard                                              at   xmin.paStandard         ymax+0.2 anchor T+L    text 'Secondary Standard'
  line   .lnSubStandard                                              at   xmin                    ymax-0.2 anchor T+L+R  HORIZ                                             width.lnStandard
  option .opSubStandards                                             at   xmin+1                  ymax+0.2 anchor T+L+R                  callback '!this.select('          width.opStandards
  para   .paCreatesubStandard                                        at   xmin.opStandards        ymax+0.5 anchor T+L    pixmap                                            width 16 height 16
  button .lkCreatesubStandard  'Create Secondary Standard...'        at   xmax.paCreateStandard+1 ymin     anchor T+L    linklabel       callback '!this.create('          width 18
  para   .paCopysubStandard                                          at   xmin.paCreateStandard   ymax     anchor T+L    pixmap                                            width 16 height 16
  button .lkCopysubStandard    'Copy existing Secondary Standard...' at   xmin.lkCreateStandard   ymin     anchor T+L    linklabel       callback '!this.copy('            width 22
  para   .paDeletesubStandard                                        at   xmin.paCreateStandard   ymax     anchor T+L    pixmap                                            width 16 height 16
  button .lkDeletesubStandard  'Delete Secondary Standard...'        at   xmin.lkCreateStandard   ymin     anchor T+L    linklabel       callback '!this.deleteStandard('  width 18

  -- Tab set for criteria
  para   .paTabs                                                     at   xmin.paStandard         ymax+0.5               text 'Criteria Set Values'
  line   .lnTabs                                                     at   xmin                    ymax-0.2 anchor T+L+R  HORIZ                                             width.lnStandard
  frame  .frTabs tabset                                              at   xmin.paCreateStandard   ymax+.2  anchor all

    -- initialise
    !criteriaSetDescs  = object ARRAY()
    !criteriaSetSuffix = object ARRAY()

    -- this is to define the different criteria groups
    !subStandard = object ASLSUBSTANDARD()

    -- handles all criteria sets of a subStandard
    do !criteriaSetName value !subStandard.attributes()

      -- delete existing distance
      if ( DEFINED(!criteriaSet) ) then
        !criteriaSet.delete()
      endif

      -- evaluates the criteria set
      !criteriaSet = !subStandard.attribute(!criteriaSetName)

      --ignores the basic data types
      skip if ( !criteriaSet.objectType() inset ('ARRAY', 'BOOLEAN', 'DBREF', 'REAL', 'STRING') )

      -- evaluates the description of the criteria set and stores the name
      !criteriaSetDescs.append(!criteriaSet.desc)
      !suffix = !criteriaSetName.after('ASL').before('CRITERIA')
      !criteriaSetSuffix.append(!suffix)
    enddo

    -- evaluates the order of the criteria set sorted by their description
    !sortedIndices = !criteriaSetDescs.sortedIndices()

    -- reorder the criteria sets attributes
    !criteriaSetDescs.reIndex(!sortedIndices)
    !criteriaSetSuffix.reIndex(!sortedIndices)


    -- handles all attributes of a subStandard
    do !i index !criteriaSetDescs

      -- reduces the size of the expression
      !desc   = !criteriaSetDescs[!i]
      !suffix = !criteriaSetSuffix[!i]

      -- adds the graphical members
      frame .fr$!<suffix>  '$!desc'                     anchor T+L+R at xmin ymin  width 50 height 9
        container .co$!<suffix> PMLNetCONTROL '$!desc'  dock fill
      exit

      -- adds the net control members
      member .net$!<suffix> is NETGRIDCONTROL
    enddo
  -- End of Tabset
  exit

  para   .paAcceptChanges                        at  xmin.paStandard+25      ymax+0.5  anchor B   pixmap                               width 16 height 16
  button .lkAcceptChanges    'Accept changes'    at  xmax.paAcceptChanges+1  ymin      anchor B   linklabel   callback '!this.save()'  width 10
  para   .paDiscardChanges                       at  xmax.lkAcceptChanges+3  ymin      anchor B   pixmap                               width 16 height 16
  button .lkDiscardChanges   'Dismiss '          at  xmax.paDiscardChanges+1 ymin      anchor B   linklabel   callback '!this.hide()'  width 5


  -- members
  -- the or selected standard
  member .meCurrStandard    is ASLSTANDARD

  -- the or selected subStandard
  member .meCurrsubStandard is ASLSUBSTANDARD

  -- the project standard
  member .meProjStandard    is STRING

  --member for storing the selected cell
  member .selectedCell      is ARRAY

  --member for storing the current pane
  member .selectedNetGrid   is STRING

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslStandards
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStandards()

  using namespace 'Aveva.Pdms.Presentation'

--  !this.autoScroll   = true
  !this.callback     = '!this.setup()'
  !this.formRevision = ' $Revision$ '
  !this.formTitle    = 'Standard for ASL Elements'
  !this.iconTitle    = 'ASL standard'
  !this.quitCall     = '!this.hide()'
  --!this.maximised    = true

  -- set the pixmap
  !this.paAcceptChanges.addPixmap(!!pml.getPathName('accept.png'))
  !this.paDiscardChanges.addPixmap(!!pml.getPathName('discard.png'))
  !this.paCreateStandard.addPixmap(!!pml.getPathName('aslnew16.png'))
  !this.paDeleteStandard.addPixmap(!!pml.getPathName('deletece16.png'))
  !this.paCopyStandard.addPixmap(!!pml.getPathName('aslcopy16.png'))
  !this.paCreatesubStandard.addPixmap(!!pml.getPathName('aslnew16.png'))
  !this.paDeletesubStandard.addPixmap(!!pml.getPathName('deletece16.png'))
  !this.paCopysubStandard.addPixmap(!!pml.getPathName('aslcopy16.png'))

  --tooltip for gadgets
  !this.lkCreateStandard.setTooltip('Create a new Standard for ASL Element')
  !this.lkCopyStandard.setTooltip('Copy an existing Standard for ASL Element')
  !this.lkDeleteStandard.setTooltip('Delete the Standard')
  !this.lkCreatesubStandard.setTooltip('Create a new Sub Standard for ASL Element')
  !this.lkCopysubStandard.setTooltip('Copy an existing Sub Standard for ASL Element')
  !this.lkDeletesubStandard.setTooltip('Delete the Sub Standard')
  !this.lkAcceptChanges.setTooltip('Write Standard to DB')
  !this.lkDiscardChanges.setTooltip('Close the Standards form')
  !this.opStandards.setTooltip('Current Standard')
  !this.opSubStandards.setTooltip('Current Sub Standard')

  -- implement the .net controls
  ---------------------------------------------------------------------------
  do !attributeName value !this.attributes()
    --ignores no dot net members
    skip if ( !attributeName.substring(1, 3).lowcase().neq('net') )

    -- create instance of .net control
    !this.attribute(!attributeName) = object NETGRIDCONTROL()

    !this.attribute(!attributeName).addeventhandler('BeforeCellUpdate',  !this, 'selectColumStandards')
    !this.attribute(!attributeName).columnExcelFilter(false)
    !this.attribute(!attributeName).outlookGroupStyle(false)
    !this.attribute(!attributeName).fixedHeaders(true)
    !this.attribute(!attributeName).fixedRows(false)
    !this.attribute(!attributeName).editableGrid(true)
    !this.attribute(!attributeName).headerSort(true)

    -- add .net control to PML container
    !containerName                          = 'co' & !attributeName.lowcase().after('net')
    !this.attribute(!containerName).control = !this.attribute(!attributeName).handle()
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copy
--
-- Description: copy an existing standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .copy(!gadget is GADGET, !action is STRING)

  if(!!aslStoreTable.getStore('standards').unset())then
    !!alert.warning('Set Storage area for ASL Standard. Goto Settings menu ---->> ASL Storage Area...to set.')
    return
  endif

  pml load form !!aslCreateStandard

  -- copying standard
  ---------------------------------------------------------------------------
  if ( !gadget.eq(!this.lkCopyStandard) ) then

    !!aslCreateStandard.elementType  = 'Standard'
    !!aslCreateStandard.formTitle    = 'Copy Standard'
    !!aslCreateStandard.name.active  = true
    !!aslCreateStandard.name.val     = 'ASL-User_Defined_Standard'
    !!aslCreateStandard.desc.val     = 'User Defined Standard'
    !!aslCreateStandard.action       = 'COPY'
    show !!aslCreateStandard

  -- copying subStandard
  ---------------------------------------------------------------------------
  else

    !!aslCreateStandard.elementType  = 'SubStandard'
    !!aslCreateStandard.formTitle    = 'Copy Secondary standard'
    !!aslCreateStandard.name.active  = true

    !owningStandardName              = !this.meCurrStandard.name
    !subStandardName                 = !owningStandardName & '/UserDefinedSubStandard'

    !!aslCreateStandard.name.val     = !subStandardName
    !!aslCreateStandard.desc.val     = 'User Defined SubStandard'
    !!aslCreateStandard.action       = 'COPY'
    show !!aslCreateStandard

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: create a new standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .create(!gadget is GADGET, !action is STRING)

  if(!!aslStoreTable.getStore('standards').unset())then
    !!alert.warning('Set Storage area for ASL Standard. Goto Settings menu ---->> ASL Storage Area...to set.')
    return
  endif

  pml load form !!aslCreateStandard

  -- creating standard
  ---------------------------------------------------------------------------
  if ( !gadget.eq(!this.lkCreateStandard) ) then

    !!aslCreateStandard.elementType  = 'Standard'
    !!aslCreateStandard.formTitle    = 'Create Standard'
    !!aslCreateStandard.name.active  = true
    !!aslCreateStandard.name.val     = 'ASL-User_Defined_Standard'
    !!aslCreateStandard.desc.val     = 'User Defined Standard'
    !!aslCreateStandard.action       = 'CREATE'
    show !!aslCreateStandard

  -- creating subStandard
  ---------------------------------------------------------------------------
  elseif ( !gadget.eq(!this.lkCreatesubStandard) ) then

    !!aslCreateStandard.elementType  = 'SubStandard'
    !!aslCreateStandard.formTitle    = 'Create Secondary Standard'
    !!aslCreateStandard.name.active  = true

    !owningStandardName = !this.meCurrStandard.name

    !!aslCreateStandard.name.val     = 'ASL-User_Defined_Sub_Standard'
    !!aslCreateStandard.desc.val     = 'User Defined SubStandard'
    !!aslCreateStandard.action       = 'CREATE'
    show !!aslCreateStandard

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteStandard
--
-- Description: deletes the standard
--
-- Method Type: Procedure
-- Arguments:
--    1   R      GADGET      the calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deleteStandard(!gadget is GADGET, !action is STRING)

  -- delete standard
  if ( !gadget.eq(!this.lkDeleteStandard) ) then
    do !i index !!aslCentralData.standards
      skip if ( !!aslCentralData.standards[!i].name.neq(!this.meCurrStandard.name) )
      if ( !!alert.confirm('Delete the selected Standard?').eq('YES') ) then
        !!aslCentralData.standards[!i].deleteFlag = true
        -- update the form
        !this.setup()
        !this.updateGadgets()
        return
      endif
    enddo
  -- delete subStandard
  else
    do !i index !!aslCentralData.standards
      skip if ( !!aslCentralData.standards[!i].name.neq(!this.meCurrStandard.name) )
      do !k index !!aslCentralData.standards[!i].subStandards
        skip if ( !!aslCentralData.standards[!i].subStandards[!k].name.neq(!this.meCurrsubStandard.name) )
        if ( !!alert.confirm('Delete the selected Secondary Standard?').eq('YES') ) then
          !currentStandard = !this.meCurrStandard
          !!aslCentralData.standards[!i].subStandards[!k].deleteFlag = true
          -- update the form
          !this.setup()
          !this.updateGadgets()
          -- select the standard
          !this.opStandards.select('dText', !currentStandard.name)
          !this.select(!this.opStandards, 'SELECT')
          return
        endif
      enddo
    enddo
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: save the standards
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .save()

  -- find the standard in the central standard object
  do !i index !!aslCentralData.standards
    if ( !!aslCentralData.standards[!i].name.eq(!this.meCurrStandard.name) ) then
      !standardIndex = !i
      break
    endif
  enddo

  -- find the subStandard in the central standard object
  do !i index !!aslCentralData.standards[!standardIndex].subStandards
    if ( !!aslCentralData.standards[!standardIndex].subStandards[!i].name.eq(!this.meCurrsubStandard.name) ) then
      !subStandardIndex = !i
      break
    endif
  enddo

  if(undefined(!subStandardIndex)) then
    !!alert.error('No Secondary Standard to set the properties')
    return
  endif

  -- reads the standard data
  !standard    = !!aslCentralData.standards[!standardIndex]
  !subStandard = !standard.subStandards[!subStandardIndex]

  -- handles all container objects
  do !netControlName value !this.attributes()
    -- ignores none container objects
    skip if ( !netControlName.substring(1, 3).lowcase().neq('net') )
    -- evaluates the criteria set
    !criteriaSetName = 'ASL' & !netControlName.substring(4) & 'CRITERIA'
    -- destroys the old version of the criteriaSet
    if ( DEFINED(!criteriaSet) ) then
      !criteriaSet.delete()
    endif

    !criteriaSet     = !subStandard.attribute(!criteriaSetName)

    -- handles all rows of the net control
    do !row value !this.attribute(!netControlName).getRows()
      -- gets the description
      !desc = !row[1]
      -- looking for the matching criterion
      do !i index !criteriaSet.attributes()
        !attributeName   = !criteriaSet.attributes()[!i]
        -- destroys the old version of the criterion
        if ( DEFINED(!criterion) ) then
          !criterion.delete()
        endif

        -- gets the criterion
        !criterion = !criteriaSet.attribute(!attributeName)

        -- ignores none criterion objects
        skip if ( !criterion.objectType().neq('CRITERION') )
        if ( !criterion.description.eq(!desc) ) then

          -- min
          if ( !row[2].eq('') ) then
            !criterion.min = object REAL()
          else
            !criterion.min = object REAL (!row[2], !!distanceFmt)
          endif

          -- optimum
          if ( !row[3].eq('') ) then
            !criterion.optimum = object REAL()
          else
            !criterion.optimum = object REAL ( !row[3], !!distanceFmt )
          endif

          -- max
          if ( !row[4].eq('') ) then
            !criterion.max = object REAL()
          else
            !criterion.max = object REAL ( !row[4], !!distanceFmt )
          endif

          -- tolerance
          if ( !row[5].eq('') ) then
            !criterion.tolerance = object REAL()
          else
            !criterion.tolerance = object REAL ( !row[5], !!distanceFmt )
          endif

          -- validValues
          !criterion.validValues = object ARRAY()
          if ( !row[6].neq('') ) then
            do !value value !row[6].split(';')
              !criterion.validValues.append(object REAL ( !value, !!distanceFmt ) )
            enddo
          endif

          -- expression
          if ( !row[7].eq('') ) then
            !criterion.value[1] = object STRING()
          else
            !criterion.value[1] = !row[7]
          endif
          break
        endif
      enddo
      !criteriaSet.attribute(!attributeName) = !criterion
    enddo
    -- writes the standard data
    !subStandard.attribute(!criteriaSetName)   = !criteriaSet
    !standard.subStandards[!subStandardIndex]  = !subStandard
    !!aslCentralData.standards[!standardIndex] = !standard
  enddo

  -- create undo mark
  !undo = object UNDOABLE()
  !undo.description('Modify ASL standards')
  !undo.undoAction('!!aslStandards.setup()')
  !undo.redoAction('!!aslStandards.setup()')
  !undo.add()

  -- save the standard to files
  !!aslCentralData.writeStandards()

  -- get the standard from the object
  do !standard value !!aslCentralData.standards
    if ( !standard.name.eq(!this.opStandards.selection('dText')) ) then
      !this.meCurrStandard = !standard
      break
    endif
  enddo

  -- end undo mark
  !undo.endUndoable()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: callback from option gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .select(!gadget is GADGET, !action is STRING)

  -- handles only the selection call
  if ( !action.neq('SELECT') ) then
    return
  endif

  -- update the form with the selected standard
  if ( !gadget.eq(!this.opStandards) ) then
    !this.updateSubStandards()
  endif

  -- update the form with the selected sub standard
  !this.updateGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: callback when opening the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setup()

  if (!!aslCentralData.standards.size().gt(0)) then
  -- display all standards on the form
  !standardNames = object ARRAY()
  do !i indices !!aslCentralData.standards
    if(!!aslCentralData.standards[!i].deleteFlag or !!aslCentralData.standards[!i].refe.badref() )then
      -- Delete the actual standard from the database
      !memory = !!ce
      !!ce = !!aslCentralData.standards[!i].refe
      handle ANY
      elsehandle NONE
        DELETE APPDAR
      endhandle
      !!ce = !memory
      handle ANY
        -- we may have just deleted it
      endhandle
      !!aslCentralData.standards[!i].delete()
      !!aslCentralData.standards.compress()
    endif
    do !j indices !!aslCentralData.standards[!i].subStandards
      if(!!aslCentralData.standards[!i].subStandards[!j].deleteFlag )then
       -- Delete the actual sub-standard from the database
       !memory = !!ce
       !!ce = !!aslCentralData.standards[!i].subStandards[!j].refe
       handle ANY
       elsehandle NONE
         DELETE APPLDA
       endhandle
       !!ce = !memory
       handle ANY
         -- We may have just deleted it
       endhandle
       !!aslCentralData.standards[!i].subStandards[!j].delete()
       !!aslCentralData.standards[!i].subStandards.compress()
    endif
    enddo
  enddo

  do !standard value !!aslCentralData.standards
    -- ignores deleted standard elements
    skip if ( !standard.deleteFlag )
    !standardNames.append(!standard.name)
  enddo
  !this.opStandards.dText = !standardNames.sort()

  -- read the project standard and select it on the form
  !project = CURRENT PROJECT
  !file    = object FILE('%' & !project.code() & 'DFLTS%/aslprojstandard.xml')
  if ( !file.exists() ) then
    !lines               = !file.readFile()
    !this.meProjStandard = !lines[1].after('"').before('"')
    if ( !this.opStandards.dText.find(!this.meProjStandard).set() ) then
      !this.opStandards.select('dText', !this.meProjStandard)
    endif
  endif

  -- fill the form with the selected standard
  !this.updateSubStandards()

  endif
  -- update the gadgets
  !this.updateGadgets()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateSubStandards
--
-- Description: update the option gadget of the subStandards
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateSubStandards()

  -- get the standard from the object
  do !standard value !!aslCentralData.standards
    if ( !standard.name.eq(!this.opStandards.selection('dText')) ) then
      !this.meCurrStandard = !standard
      break
    endif
  enddo

  -- update the option gadget
  !allSubStandards = object ARRAY()
  do !subStandard value !this.meCurrStandard.subStandards
    -- ignores deleted standard elements
    skip if ( !subStandard.deleteFlag )
    !allSubStandards.append(!subStandard.name)
  enddo
  !this.opSubStandards.dText = !allSubStandards

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateGadgets()

  using namespace  'Aveva.Pdms.Presentation'

  -- evaluates the write permission
  !writeAccess = !!aslCentralData.administrator

  --If there are no standards grey out the copy and delete buttons
   if (!this.opStandards.dText.empty()  ) then
     !this.lkCopyStandard.active      = FALSE
     !this.lkDeleteStandard.active    = FALSE
     !this.lkCreatesubStandard.active = FALSE
     !this.lkDeletesubStandard.active = FALSE
     !this.lkCopysubStandard.active   = FALSE
  else

  -- get the standard from the object
  ---------------------------------------------------------------------------
  do !subStandard value !this.meCurrStandard.subStandards
    if ( !subStandard.name.eq(!this.opSubStandards.selection('dText')) ) then
      !this.meCurrsubStandard = !subStandard
      break
    endif
  enddo

  -- set the headings of the access-list
  ---------------------------------------------------------------------------
  !heading[1] = 'Description'
  !heading[2] = 'Min'
  !heading[3] = 'Optimum'
  !heading[4] = 'Max'
  !heading[5] = 'Tolerance'
  !heading[6] = 'Valid Value'
  !heading[7] = 'Expression'

  -- fills the separate cells of the grid
  ---------------------------------------------------------------------------
  do !attributeName value !this.attributes()

    -- ignores no dot net members
    skip if ( !attributeName.substring(1, 3).lowcase().neq('net') )

    -- initialise
    !rows = object ARRAY()

    -- generates the name of the criteria set
    !criteriaSetName = 'ASL' & !attributeName.substring(4) & 'CRITERIA'

    -- destroys the old version of the criteria set
    if ( DEFINED(!criteriaSet) ) then
      !criteriaSet.delete()
    endif

    -- gets the data of the criteria set
    !criteriaSet     = !this.meCurrsubStandard.attribute(!criteriaSetName)

    -- initialise
    !criterions     = object ARRAY()
    !criterionDescs = object ARRAY()

    -- evaluates the values for the name and the description of all criterion elements of the criteria  set
    do !criterionName value !criteriaSet.attributes()
      -- destroys the old version of the criterion
      if ( DEFINED(!criterion) ) then
        !criterion.delete()
      endif

      -- evaluates the real object
      !criterion = !criteriaSet.attribute(!criterionName)

      -- ignores all none criterion elements
      skip if ( !criterion.objectType().neq('CRITERION') )

      -- collects the valid data for further process
      !criterions.append(!criterion)
      !criterionDescs.append(!criterion.description)
    enddo

    -- sorts the criterion elements by their description
    !sortedIndices = !criterionDescs.sortedIndices()
    !criterions.reIndex(!sortedIndices)

    -- handle the sorted criterion elements
    do !i index !criterions
      !criterion = !criterions[!i]
      !rows[!i]  = object ARRAY()
      !rows[!i].append(!criterion.description)
      if(!this.meCurrsubStandard.refe.unset() or!this.meCurrsubStandard.refe.badref())then
        !units = !this.meCurrStandard.refe.function
      else
        !units = !this.meCurrsubStandard.refe.owner.function
      endif
      if (!criterion.propertyType eq 'DIST' and !units.lowcase().eq('imperial') ) then
        -- fills the valid values gadget
        ---------------------------------------------------------------------------
        !validValues = ''
        do !validValue value !criterion.validValues
          if ( !validValues.eq('') ) then
            !validValues = !validValue.string(!!distanceFmt)
          else
            !validValues = !validValues & ';' & !validValue.string(!!distanceFmt)
          endif
        enddo

        !rows[!i].append(!criterion.min.string(!!distanceFmt))
        !rows[!i].append(!criterion.optimum.string(!!distanceFmt))
        !rows[!i].append(!criterion.max.string(!!distanceFmt))
        !rows[!i].append(!criterion.tolerance.string(!!distanceFmt))
        !rows[!i].append(!validValues)
        if (!criterion.value.size() eq 1) then
          !rows[!i].append(!criterion.value[1].string(!!distanceFmt))
        else
          !rows[!i].append('')
        endif
      else
      -- fills the valid values gadget
      ---------------------------------------------------------------------------
      !validValues = ''
      do !validValue value !criterion.validValues
        if ( !validValues.eq('') ) then
          !validValues = !validValue.string()
        else
          !validValues = !validValues & ';' & !validValue.string()
        endif
      enddo


      !rows[!i].append(!criterion.min.string())
      !rows[!i].append(!criterion.optimum.string())
      !rows[!i].append(!criterion.max.string())
      !rows[!i].append(!criterion.tolerance.string())
      !rows[!i].append(!validValues)
      if (!criterion.value.size() eq 1) then
        !rows[!i].append(!criterion.value[1].string())
      else
        !rows[!i].append('')
        endif
      endif
    enddo

    !netDataSource = object NETDATASOURCE(' ', !heading, !rows)
    !this.attribute(!attributeName).bindToDataSource(!netDataSource)
    !this.attribute(!attributeName).editableGrid(!writeAccess)
    !this.attribute(!attributeName).setEditableColumn(1, false)
  enddo
endif
  -- Get the activation status of the Modify/Delete gadgets
  !activateStdEdit      = ( !writeAccess AND !this.opStandards.dText.size().gt(0) )
  !activateSubStdEdit   = ( !writeAccess AND !this.opSubStandards.dText.size().gt(0) )

  -- activate Create Standard gadget if the user has writeAccess
   !this.lkCreateStandard.active = !writeAccess

  --activate these gadgets if there is at least one Standard
   !this.lkCopyStandard.active   = !activateStdEdit
   !this.lkDeleteStandard.active = !activateStdEdit
   !this.lkCreatesubStandard.active = !activateStdEdit

   --activate these gadgets if there is at least one sub Standard
  !this.lkDeletesubStandard.active = !activateSubStdEdit
  !this.lkCopysubStandard.active   = !activateSubStdEdit

  --anyhow make the copy

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      selectColumStandards
--
-- Description: callback when grid is clicked
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectColumStandards( !selectedCell is ARRAY )

  --set the value to the member
  !this.selectedCell = !selectedCell

  if ( !selectedCell[2].upcase().trim() inset('MAX', 'MIN', 'OPTIMUM', 'TOLERANCE') ) then

    if ( !selectedCell[0].trim().eq('') ) then
      !selectedCell[3] = false
      !!alert.error('Empty cell cannot be updated - Enter a real value.')
      return
    endif

    --!unusedSelectedCellValue = !selectedCell[0].real()
    --  handle (2,441)
    --    !!alert.error('Field can accept only real value.')
    --    !selectedCell[3] = false
    --    return
    --  endhandle
  endif

  !criteriaSetDescs  = object ARRAY()
  !criteriaSetSuffix = object ARRAY()

  -- this is to define the different criteria groups
  !subStandard = object ASLSUBSTANDARD()

  -- handles all criteria sets of a subStandard
  do !criteriaSetName value !subStandard.attributes()

    -- delete existing distance
    if ( DEFINED(!criteriaSet) ) then
      !criteriaSet.delete()
    endif

    -- evaluates the criteria set
    !criteriaSet = !subStandard.attribute(!criteriaSetName)

    --ignores the basic data types
    skip if ( !criteriaSet.objectType() inset ('ARRAY', 'BOOLEAN', 'DBREF', 'REAL', 'STRING') )

    -- evaluates the description of the criteria set and stores the name
    !criteriaSetDescs.append(!criteriaSet.desc)
    !suffix = !criteriaSetName.after('ASL').before('CRITERIA')
    !criteriaSetSuffix.append(!suffix)
  enddo

  -- evaluates the order of the criteria set sorted by their description
  !sortedIndices = !criteriaSetDescs.sortedIndices()

  -- reorder the criteria sets attributes
  !criteriaSetDescs.reIndex(!sortedIndices)
  !criteriaSetSuffix.reIndex(!sortedIndices)


  -- handles all attributes of a subStandard
  do !i index !criteriaSetDescs

    -- reduces the size of the expression
    !desc   = !criteriaSetDescs[!i]
    !suffix = !criteriaSetSuffix[!i]
    -- adds the net control members
    if ( !this.fr$!<suffix>.visible.eq(true) ) then
      !selectedRow = !this.net$!<suffix>.getrow(!selectedCell[1])
      !this.selectedNetGrid = !suffix
      !this.logicalCheck(!selectedCell, !selectedRow)
    endif
  enddo

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      selectColumStandards
--
-- Description: callback when grid is clicked
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      ARRAY      selected cell in a grid
--    2    R      ARRAY      Selected row in a grid
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .logicalCheck(!selectedCell is ARRAY, !selectedRow is ARRAY)

  --existing values in the selected row
  !minmumValue    = object REAL ( !selectedRow[2], !!distanceFmt )
  !optimimValue   = object REAL ( !selectedRow[3], !!distanceFmt )
  !maximumValue   = object REAL ( !selectedRow[4], !!distanceFmt )
  !toleranceValue = object REAL ( !selectedRow[5], !!distanceFmt )

  --entered value in the cell
  !newValue = object REAL ( !selectedCell[0], !!distanceFmt )

  --check condition for minimum
  if ( !selectedRow[4].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('MIN') and !newValue.gt(!maximumValue) ) then
      !!alert.error('Entered Minimum value ($!newValue) of $!selectedRow[1] is Greater than the Maximum value ($!maximumValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('MIN') and !newValue.eq(!maximumValue) ) then
      !!alert.warning('Entered Minimum value ($!newValue) of $!selectedRow[1] is Equal to the Maximum value ($!maximumValue)')
      !selectedCell[3] = true
      return
    endif
  endif

  if ( !selectedRow[5].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('MIN') and !newValue.lt(!toleranceValue) ) then
      !!alert.error('Entered Minimum value ($!newValue) of $!selectedRow[1] is Lesser than the Tolerance value ($!toleranceValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('MIN') and !newValue.eq(!toleranceValue) ) then
      !!alert.warning('Entered Minimum value ($!newValue) of $!selectedRow[1] is Equal to the Tolerance value ($!toleranceValue)')
      !selectedCell[3] = true
      return
    endif
  endif

  if ( !selectedRow[3].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('MIN') and !newValue.gt(!optimimValue) ) then
      !!alert.error('Entered Minimum value ($!newValue) of $!selectedRow[1] is Greater than the Optimum value ($!optimimValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('MIN') and !newValue.eq(!optimimValue) ) then
      !!alert.warning('Entered Minimum value ($!newValue) of $!selectedRow[1] is Equal to the Optimum value ($!optimimValue)')
      !selectedCell[3] = true
      return
    endif
  endif

  --check condition for maximum
  if ( !selectedRow[2].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('MAX') and !newValue.lt(!minmumValue) ) then
      !!alert.error('Entered Maximum value ($!newValue) of $!selectedRow[1] is Lesser than the Minimum value ($!minmumValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('MAX') and !newValue.eq(!minmumValue) ) then
      !!alert.warning('Entered Maximum value ($!newValue) of $!selectedRow[1] is Equal to the Minimum value ($!minmumValue)')
      !selectedCell[3] = true
      return
    endif
  endif

  if ( !selectedRow[5].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('MAX') and !newValue.lt(!toleranceValue) ) then
      !!alert.error('Entered Maximum value ($!newValue) of $!selectedRow[1] is Lesser than the Tolerance value ($!toleranceValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('MAX') and !newValue.eq(!toleranceValue) ) then
      !!alert.error('Entered Maximum value ($!newValue) of $!selectedRow[1] is Equal to the Tolerance value ($!toleranceValue)')
      !selectedCell[3] = false
      return
    endif
  endif

  if ( !selectedRow[3].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('MAX') and !newValue.lt(!optimimValue) ) then
      !!alert.error('Entered Maximum value ($!newValue) of $!selectedRow[1] is Lesser than the Optimum value ($!optimimValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('MAX') and !newValue.eq(!optimimValue) ) then
      !!alert.error('Entered Maximum value ($!newValue) of $!selectedRow[1] is Equal to the Optimum value ($!optimimValue)')
      !selectedCell[3] = false
      return
    endif
  endif

  --check condition for optimum
  if ( !selectedRow[2].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('OPTIMUM') and !newValue.lt(!minmumValue) ) then
      !!alert.error('Entered Optimum value ($!newValue) of $!selectedRow[1] is Lesser than the Minimum value ($!minmumValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('OPTIMUM') and !newValue.eq(!minmumValue) ) then
      !!alert.warning('Entered Optimum value ($!newValue) of $!selectedRow[1] is Equal to the Minimum value ($!minmumValue)')
      !selectedCell[3] = true
      return
    endif
  endif

  if ( !selectedRow[4].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('OPTIMUM') and !newValue.gt(!maximumValue) ) then
      !!alert.error('Entered Optimum value ($!newValue) of $!selectedRow[1] is Greater than the Maximum value ($!maximumValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('OPTIMUM') and !newValue.eq(!maximumValue) ) then
      !!alert.warning('Entered Optimum value ($!newValue) of $!selectedRow[1] is Equal to the Maximum value ($!maximumValue)')
      !selectedCell[3] = true
      return
    endif
  endif

  if ( !selectedRow[5].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('OPTIMUM') and !newValue.lt(!toleranceValue) ) then
      !!alert.error('Entered Optimum value ($!newValue) of $!selectedRow[1] is Lesser than the Tolerance value ($!toleranceValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('OPTIMUM') and !newValue.eq(!toleranceValue) ) then
      !!alert.warning('Entered Optimum value ($!newValue) of $!selectedRow[1] is Equal to the Tolerance value ($!toleranceValue)')
      !selectedCell[3] = true
      return
    endif
  endif

  --check condition for tolerance
  if ( !selectedRow[2].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('TOLERANCE') and !newValue.gt(!minmumValue) ) then
      !!alert.error('Entered Tolerance value ($!newValue) of $!selectedRow[1] is Greater than the Minimum value ($!minmumValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('TOLERANCE') and !newValue.eq(!minmumValue) ) then
      !!alert.warning('Entered Tolerance value ($!newValue) of $!selectedRow[1] is Equal to the Minimum value ($!minmumValue)')
      !selectedCell[3] = true
      return
    endif
  endif

  if ( !selectedRow[4].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('TOLERANCE') and !newValue.gt(!maximumValue) ) then
      !!alert.error('Entered Tolerance value ($!newValue) of $!selectedRow[1] is Greater than the Maximum value ($!maximumValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('TOLERANCE') and !newValue.eq(!maximumValue) ) then
      !!alert.error('Entered Tolerance value ($!newValue) of $!selectedRow[1] is Equal to the Maximum value ($!maximumValue)')
      !selectedCell[3] = false
      return
    endif
  endif

  if ( !selectedRow[3].trim().neq('') ) then
    if ( !selectedCell[2].upcase().eq('TOLERANCE') and !newValue.gt(!optimimValue) ) then
      !!alert.error('Entered Tolerance value ($!newValue) of $!selectedRow[1] is Greater than the Optimum value ($!optimimValue)')
      !selectedCell[3] = false
      return
    elseif ( !selectedCell[2].upcase().eq('TOLERANCE') and !newValue.eq(!optimimValue) ) then
      !!alert.warning('Entered Tolerance value ($!newValue) of $!selectedRow[1] is Equal to the Optimum value ($!optimimValue)')
      !selectedCell[3] = true
      return
    endif
  endif

endmethod
-- End of method
