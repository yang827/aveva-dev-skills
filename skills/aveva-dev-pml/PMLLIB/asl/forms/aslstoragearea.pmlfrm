------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStorageArea()                 -                   Constructor
--  checkStorage(GADGET,DBREF)       -
--  close()                          -                   Close the form
--  display()                        -                   Display the values in the local storeTable in the gadgets
--  initialise()                     -                   Initialisation
--  removeStorage(GADGET)            -                   Clear the current storage area
--  setAll(GADGET)                   -
--  setCE(GADGET)                    -                   Set the current element as storage area
--  setElement(GADGET)               -
--  setGadgetsEditable(BOOLEAN)      -
--  setStorage()                     -                   Set the current element as storage area
--
------------------------------------------------------------------------

setup form !!aslStorageArea

  !this.formTitle     = 'ASL Storage Area'
  !this.iconTitle     = 'ASL Storage Area'
  !this.formRevision  = '$Revision: 1.5 $ '
  !this.initcall      = '!this.initialise()'

  -- Body of form definition

  if (!!aslCentralData.administrator) then
    text   .txStandard      'Standard: '                    anchor L+T  at x1      ymin+0.5   tagwidth 10     width 25 is STRING
    button .ceStandard      'CE'                            anchor L+T  at xmax+1  ymin                       width 6
    button .clearStandard   'Default'                       anchor L+T  at xmax+1  ymin                       width 6

    text   .txSettings      'Settings: '                    anchor L+T  at x1      ymax+0.3   tagwidth 10     width 25 is STRING
    button .ceSettings      'CE'                            anchor L+T  at xmax+1  ymin                       width 6
    button .clearSettings   'Default'                       anchor L+T  at xmax+1  ymin                       width 6

  endif

  toggle .toSetAll          'Set Storage for All Elements'  anchor L+T  at x11     ymax+0.3   states 'ON' 'OFF'
  button .ceSetAll          'CE'                            anchor L+T  at x38     ymin                       width 6
  button .clearSetAll       'Default'                       anchor L+T  at xmax+1  ymin                       width 6

  text   .txStairTower      'Stair Tower:'                  anchor L+T  at x1      ymax+0.3   tagwidth 10     width 25 is STRING
  button .ceStairTower      'CE'                            anchor L+T  at xmax+1  ymin                       width 6
  button .clearStairTower   'Default'                       anchor L+T  at xmax+1  ymin                       width 6

  text   .txStairFlt        'Stair Flight:'                 anchor L+T  at x1      ymax+0.3   tagwidth 10     width 25 is STRING
  button .ceStairFlt        'CE'                            anchor L+T  at xmax+1  ymin                       width 6
  button .clearStairFlt     'Default'                       anchor L+T  at xmax+1  ymin                       width 6

  text   .txLadder          'Ladder:'                       anchor L+T  at x1      ymax+0.3   tagwidth 10     width 25 is STRING
  button .ceLadder          'CE'                            anchor L+T  at xmax+1  ymin                       width 6
  button .clearLadder       'Default'                       anchor L+T  at xmax+1  ymin                       width 6

  text   .txPlatform        'Platform:'                     anchor L+T  at x1      ymax+0.3   tagwidth 10     width 25 is STRING
  button .cePlatform        'CE'                            anchor L+T  at xmax+1  ymin                       width 6
  button .clearPlatform     'Default'                       anchor L+T  at xmax+1  ymin                       width 6

  text   .txHandrail        'Handrail:'                     anchor L+T  at x1      ymax+0.3   tagwidth 10     width 25 is STRING
  button .ceHandrail        'CE'                            anchor L+T  at xmax+1  ymin                       width 6
  button .clearHandrail     'Default'                       anchor L+T  at xmax+1  ymin                       width 6

  --accept
  button .apply             'Apply'                         anchor L+T  at x30     ymax+0.5                   width 6

  -- Discard
  button .cancel            'Dismiss'                       anchor L+T  at xmax+5  ymin                       width 6

  -- Form Member
  member .storeTable    is ELEMENTSTORETABLE

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslStorageArea
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslStorageArea()

  --Callbacks for the form gadgets
  --valid check for the user to be a member of ASLADMIN Team (Hiding and showing the gadget)
  if( defined(!this.txStandard) ) then
    !this.txStandard.val            = 'Any APPLDW with purpose set to ASL'
    !this.txStandard.callback       = '!this.setElement(!this.txStandard)'
    !this.ceStandard.callback       = '!this.setCE(!this.txStandard)'
    !this.clearStandard.callback    = '!this.removeStorage(!this.txStandard)'

    -- set the tooltip
    !this.txStandard.setTooltip('Enter Name of APPLDW to be created or existing APPLDW with PURPOSE set to ASL or unset.')
    !this.ceStandard.setTooltip('Any APPLDW with PURPOSE set to ASL or unset')
    !this.clearStandard.setTooltip('Reset to Defaults')

    !this.txSettings.val            = 'Any APPDAR with purpose set to ASL'
    !this.txSettings.callback       = '!this.setElement(!this.txSettings)'
    !this.ceSettings.callback       = '!this.setCE(!this.txSettings)'
    !this.clearSettings.callback    = '!this.removeStorage(!this.txSettings)'

    -- set the tooltip
    !this.txSettings.setTooltip('Enter Name of APPDAR to be created or existing APPDAR with PURPOSE set to ASL or unset.')
    !this.ceSettings.setTooltip('Any APPDAR with PURPOSE set to ASL or unset')
    !this.clearSettings.setTooltip('Reset to default')
  endif

  --Setting values for the Storage Area Elements
  !this.toSetAll.val= false
  !this.ceSetAll.active = false
  !this.clearSetAll.active  = false

  !this.toSetAll.callback     = '!this.setGadgetsEditable(!this.toSetAll.val)'
  !this.ceSetAll.callback     = '!this.setAll(!this.toSetAll)'
  !this.clearSetAll.callback  = '!this.removeStorage(!this.toSetAll)'

  --Setting values for the Storage Area Elements
  --Stair Tower
  !this.txStairTower.val          = 'Any Structure'
  !this.txStairTower.callback     = '!this.setElement(!this.txStairTower)'
  !this.ceStairTower.callback     = '!this.setCE(!this.txStairTower)'
  !this.clearStairTower.callback  = '!this.removeStorage(!this.txStairTower)'

    -- set the tooltip
  !this.txStairTower.setTooltip('Name or Reference of element type STRUCTURE for Storing Stair Towers')
  !this.ceStairTower.setTooltip('STRUCTURE for Storing Stair Towers')
  !this.clearStairTower.setTooltip('Clear the storage area of Stair Towers')

  -- stair flight
  !this.txStairFlt.val            = 'Any Structure or Stair Tower'
  !this.txStairFlt.callback       = '!this.setElement(!this.txStairFlt)'
  !this.ceStairFlt.callback       = '!this.setCE(!this.txStairFlt)'
  !this.clearStairFlt.callback    = '!this.removeStorage(!this.txStairFlt)'

    -- set the tooltip
  !this.txStairFlt.setTooltip('Name or Reference of element type STRUCTURE for Storing Stair flights')
  !this.ceStairFlt.setTooltip('STRUCTURE for Storing Stair flights')
  !this.clearStairFlt.setTooltip('Clear the storage area of Stair flights')

  -- Ladder
  !this.txLadder.val              = 'Any Structure'
  !this.txLadder.callback         = '!this.setElement(!this.txLadder)'
  !this.ceLadder.callback         = '!this.setCE(!this.txLadder)'
  !this.clearLadder.callback      = '!this.removeStorage(!this.txLadder)'

  -- set the tooltip
  !this.txLadder.setTooltip('Name or Reference element of type STRUCTURE for Storing Ladders')
  !this.ceLadder.setTooltip('STRUCTURE for Storing Ladders')
  !this.clearLadder.setTooltip('Clear the storage area of Ladders')

  --Handrail
  !this.txHandrail.val            = 'Any Structure,Platform,Stair landing or Stair flight'
  !this.txHandrail.callback       = '!this.setElement(!this.txHandrail)'
  !this.ceHandrail.callback       = '!this.setCE(!this.txHandrail)'
  !this.clearHandrail.callback    = '!this.removeStorage(!this.txHandrail)'

    -- set the tooltip
  !this.txHandrail.setTooltip('Name or Reference element of type STRUCTURE for Storing Handrails')
  !this.ceHandrail.setTooltip('STRUCTURE for Storing Handrails')
  !this.clearHandrail.setTooltip('Clear the storage area of Handrails')

  --Platform
  !this.txPlatform.val            = 'Any Structure'
  !this.txPlatform.callback       = '!this.setElement(!this.txPlatform)'
  !this.cePlatform.callback       = '!this.setCE(!this.txPlatform)'
  !this.clearPlatform.callback    = '!this.removeStorage(!this.txPlatform)'

    -- set the tooltip
  !this.txPlatform.setTooltip('Name or Reference element of type STRUCTURE for Storing Platforms')
  !this.cePlatform.setTooltip('STRUCTURE for Storing Platforms')
  !this.clearPlatform.setTooltip('Clear the storage area of Platforms')

  -- accept , reset and dismiss calls
  !this.apply.callback           = '!this.setStorage()'
  --!this.reset.callback           = '!this.initialise()'
  !this.cancel.callback          = '!this.close()'

  --Defining and Registering Store table
  !this.storeTable.register('standards', 'Standards' , 'Storage area for standards')
  !this.storeTable.storeType('standards', 'APPLDW')

  --Defining and Registering Store table
  !this.storeTable.register('settings', 'Settings', 'Storage area for settings')
  !this.storeTable.storeType('settings', 'APPDAR')

  --restrict the APPLDW that can be set
  !expression = object EXPRESSION('unset(PURP) or PURP eq |ASL|')
  !this.storeTable.expression('standards', !expression)
  !this.storeTable.expression('settings',  !expression)

  !this.storeTable.register('stairtower', 'StairTower' , 'Storage area for Stair Towers')
  !this.storeTable.storeType('stairtower', 'STRU')

  !this.storeTable.register('stairflight', 'StairFlight' , 'Storage area for Stair Flights')
  !this.storeTable.storeType('stairflight', 'STRU')

  !this.storeTable.register('ladder', 'Ladder' , 'Storage area for Ladders')
  !this.storeTable.storeType('ladder', 'STRU')

  !this.storeTable.register('platform', 'Platform' , 'Storage area for Platforms')
  !this.storeTable.storeType('platform', 'STRU')

  !this.storeTable.register('handrail', 'Handrail' , 'Storage area for Handrails')
  !this.storeTable.storeType('handrail', 'STRU')

endmethod
-- End of method definition for .aslStorageArea()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Assign the Element store table to the form members
   !localKeys = !this.storeTable.primarykeys
   !globalKeys = !!aslStoreTable.primarykeys
   !localKeys.sort()
   !globalKeys.sort()

  if (!localKeys.eq(!globalKeys)) then
      !this.storeTable = !!aslStoreTable
  else
      !!aslStoreTable =  !this.storeTable
  endif

  --set to default
 !this.display()

endmethod

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Display the storeTable values in the gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display()

  if (defined(!this.txStandard ) ) then
     --  get the standards storage area
     if(!this.storeTable.getStore('standards').set() and !this.storeTable.getStore('standards').badref().not())then
        !this.txStandard.val                 = !this.storeTable.getStore('standards').flnn
     else
        !this.txStandard.val                = 'Any APPLDW with purpose set to ASL'
     endif

     --  get the Settings storage area
     if(!this.storeTable.getStore('settings').set() and !this.storeTable.getStore('settings').badref().not())then
        !this.txSettings.val              = !this.storeTable.getStore('settings').flnn
     else
        !this.txSettings.val              = 'Any APPDAR with purpose set to ASL'
     endif
  endif


  if(!this.storeTable.getStore('stairTower').set() and !this.storeTable.getStore('stairTower').badref().not())then
     !this.txStairTower.val               = !this.storeTable.getStore('stairTower').flnn
  else
     !this.txStairTower.val               = 'Any Structure'
  endif

  if(!this.storeTable.getStore('stairflight').set() and !this.storeTable.getStore('stairflight').badref().not())then
     !this.txStairFlt.val                 = !this.storeTable.getStore('stairflight').flnn
  else
     !this.txStairFlt.val                 = 'Any Structure'
  endif

  if(!this.storeTable.getStore('ladder').set() and !this.storeTable.getStore('ladder').badref().not())then
     !this.txLadder.val                   = !this.storeTable.getStore('ladder').flnn
  else
     !this.txLadder.val                   = 'Any Structure'
  endif

  if(!this.storeTable.getStore('platform').set() and !this.storeTable.getStore('platform').badref().not())then
     !this.txPlatform.val                 = !this.storeTable.getStore('platform').flnn
  else
     !this.txPlatform.val                 = 'Any Structure'
  endif

  if(!this.storeTable.getStore('handrail').set() and !this.storeTable.getStore('handrail').badref().not())then
     !this.txHandrail.val                 = !this.storeTable.getStore('handrail').flnn
  else
     !this.txHandrail.val                 = 'Any Structure'
  endif

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      checkStorage
--
-- Description: Check whether the Specified storage area exists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1    RW     GADGET     Text Gadget to be validated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setElement(!gadget is GADGET)

  !storage = !gadget.val

  if(!storage.trim().eq(''))then
    !this.removeStorage(!gadget)
    return
  elseif(!storage.trim().match(' ').gt(0)) then
    --if the name already exists navigates to it after check statement.
    !tempStorage = !storage.split()
    !storage = ''
    !!alert.warning(|Name can not contain spaces, Replacing spaces with '-' (Hyphen).|)
      do !i from 1 to !tempStorage.size()
        if ( !i.neq(!tempStorage.size()) )then
        !storage = !storage & !tempStorage[!i] & '-'
       else
        !storage = !storage & !tempStorage[!i]
       endif
      enddo
    !gadget.val = !storage
  endif

  if(!storage.substring(1,1).eq('/') or !storage.substring(1,1).eq('='))then
    !storage  = !storage
  elseif(!storage.upcase().eq('CE'))then
    !storage  = !!ce.name
  else
    !storage  = '/' & !storage
  endif

  --Check whether the given name is already exists
  !exist = !!exists(!storage, STRING(), STRING())

  if (!exist) then
     !storageElement = !storage.dbref()

     -- Check the write access of the DB
     if(!!dbrefupdate(!storageElement).not())then
      !!alert.error(|Access Denied. '$!storageElement' is in Read only DataBase.|)
       !this.display()
       return
     endif

    if ( !gadget.name() inset ('TXSTANDARD', 'TXSETTINGS' ) )then
       !storageElement.purpose = 'ASL'
     endif

  else
    if ( !gadget.name().eq('TXSTANDARD') )then
      if ( !!alert.confirm('APPLDW $!storage does not exist. Do you want to create a new one?').eq('YES') )then
         new APPLDW $!storage
         purp ASL
         !storageElement = !!ce
       else
         !this.display()
         return
       endif
    elseif ( !gadget.name().eq('TXSETTINGS') ) then
      if ( !!alert.confirm('APPDAR $!storage does not exist. Do you want to create a new one?').eq('YES') ) then
        new APPDAR $!storage
        handle ANY
          !!alert.error('Cannot create a APPDAR at this level.')
          !this.display()
          return
        endhandle
        purp ASL
        !storageElement = !!ce
     else
       !this.display()
       return
      endif
    else
      !!alert.error('Element does not exist.')
      !this.display()
      return
     endif

  endif

  !this.checkStorage(!gadget , !storageElement)

  endmethod

------------------------------------------------------------------------
--
-- Method:      setAll
--
-- Description: Set the current element as storage area for all ASL elements
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAll(!gadget is GADGET )

  !storage     = !!ce

  if(!!dbrefupdate(!storage).not())then
    !!alert.error(|Access Denied. '$!storage' is in Read only DataBase.|)
    !this.display()
    return
  endif

  !this.checkStorage(!gadget, !storage)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setGadgetsEditable
--
-- Description: Changes the editable status of gadgets based
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setGadgetsEditable(!toggleState is BOOLEAN)

  !editState  = !toggleState.not()

  !this.txStairTower.active = !editState
  !this.txStairFlt.active   = !editState
  !this.txHandrail.active   = !editState
  !this.txPlatform.active   = !editState
  !this.txLadder.active     = !editState

  !this.ceSetAll.active     = !toggleState
  !this.ceStairTower.active = !editState
  !this.ceStairFlt.active   = !editState
  !this.ceHandrail.active   = !editState
  !this.cePlatform.active   = !editState
  !this.ceLadder.active     = !editState

  !this.clearSetAll.active     = !toggleState
  !this.clearStairTower.active = !editState
  !this.clearStairFlt.active   = !editState
  !this.clearHandrail.active   = !editState
  !this.clearPlatform.active   = !editState
  !this.clearLadder.active     = !editState

endmethod
-- End of method definition

------------------------------------------------------------------------

--
-- Method:      checkStorage
--
-- Description: Check whether the Specified storage area exists and check whether it is valid to store the corresponding elements.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1    RW     GADGET     Text Gadget to be validated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkStorage(!gadget is GADGET , !element is DBREF)

  -- Setting the Storage area
  if(!gadget.name() eq 'TXSTANDARD')then
    !errorState = !this.storeTable.setStore('standards',!element)
  elseif(!gadget.name() eq 'TXSETTINGS' )then
    !errorState = !this.storeTable.setStore('settings',!element)
  elseif(!gadget.name() eq 'TOSETALL') then
    !errorState =!this.storeTable.setStore('stairTower', !element)
    !errorState =!this.storeTable.setStore('stairflight',!element)
    !errorState = !this.storeTable.setStore('ladder',    !element)
    !errorState =!this.storeTable.setStore('platform',   !element)
    !errorState =!this.storeTable.setStore('handrail',   !element)
  elseif(!gadget.name() eq 'TXSTAIRTOWER') then
    !errorState =!this.storeTable.setStore('stairTower',!element)
  elseif(!gadget.name() eq 'TXSTAIRFLT')then
    !errorState =!this.storeTable.setStore('stairflight',!element)
  elseif(!gadget.name() eq 'TXLADDER')then
    !errorState = !this.storeTable.setStore('ladder',   !element)
  elseif(!gadget.name() eq 'TXPLATFORM')then
    !errorState =!this.storeTable.setStore('platform',  !element)
  elseif(!gadget.name() eq 'TXHANDRAIL')then
    !errorState =!this.storeTable.setStore('handrail',  !element)
  endif

  -- Check whether the Storage areas are successfully set or not.
  if(!errorState.not())then
    !!alert.error(!this.storeTable.errorText)
  endif

  !this.display()

endmethod
-- End of method definition for .checkStorage()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

   !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      setCE
--
-- Description: Set the current element as storage area
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      GADGET      Text Gadget to be set
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setCE(!gadget is GADGET)

  !gadget.val  = !!ce.flnn
  !storage     = !!ce

  if(!!dbrefupdate(!storage).not())then
    !!alert.error(|Access Denied. '$!storage' is in Read only DataBase.|)
    !this.display()
    return
  endif

  !this.checkStorage(!gadget, !storage)

endmethod
-- End of method definition for .setCE()
------------------------------------------------------------------------
--
-- Method:      setStorage
--
-- Description: Set the current element as storage area
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      GADGET      Text Gadget to be set
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setStorage()

   !!aslStoreTable = !this.storeTable

endmethod
-- End of method definition for .setStorage()
------------------------------------------------------------------------
--
-- Method:      removeStorage
--
-- Description: Clear the current storage area
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      GADGET      Text Gadget to be set
-- Return:
--   [Data Type] [Description]

------------------------------------------------------------------------

define method .removeStorage(!gadget is GADGET)

  if(!gadget.name().eq('TXSTANDARD'))then
    !this.storeTable.clear('standards')
  elseif(!gadget.name().eq('TXSETTINGS'))then
    !this.storeTable.clear('settings')
  elseif(!gadget.name().eq('TXSTAIRTOWER'))then
    !this.storeTable.clear('stairtower')
  elseif(!gadget.name().eq('TXSTAIRFLT'))then
    !this.storeTable.clear('stairflight')
  elseif(!gadget.name().eq('TXLADDER'))then
    !this.storeTable.clear('ladder')
  elseif(!gadget.name().eq('TXPLATFORM'))then
    !this.storeTable.clear('platform')
  elseif(!gadget.name().eq('TXHANDRAIL'))then
    !this.storeTable.clear('handrail')
  elseif(!gadget.name().eq('TOSETALL')) then
    !this.storeTable.clear('stairtower')
    !this.storeTable.clear('stairflight')
    !this.storeTable.clear('ladder')
    !this.storeTable.clear('platform')
    !this.storeTable.clear('handrail')
  endif

  !this.display()
endmethod
-- End of method definition for .removeStorage()
