------------------------------------------------------------------------

define method .detailAttribPane()

  -- Hide the stair flight pane
  !this.strfltPane.visible  = false

  -- Display the detailed attribute pane
  !this.detailAttribPane.visible  = true
  !this.showPanel(!this.detailAttribPane)
  !this.formTitle = 'Stair flight Detail Attributes'

  -- remove edg packets from stack
