-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            aslstrflt.pmlfrm
--   Type:          Form Definition
--   Group:         ASL
--
--     Keyword:     Stairs
--   Module:        Design
--   Replaces:
--
-- Author:          Murali.Narayanaswamy
-- Created:         Wed Mar 26 19:39:05 2008
--
--
-- Description:    Stair Flight definition form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  acceptStrflt()                   -
--  aslStrFlt()                      -
--  assignSense(GADGET,STRING)       -
--  assignTreadShift(REAL,REAL)      BOOLEAN
--  calcFlightLength(ARRAY)          -
--  calcLegLength()                  -
--  calcLndgElev(ARRAY)              -
--  cancel()                         -                   form cancellation callback
--  clearEdgStack()                  -
--  clearVolFeedback()               -
--  closeForm()                      -
--  createStrflt()                   -
--  createStrfltPane(STRING)         -                   setup new Stair flight object and display main modification panel
--  deleteStrflt()                   -                   delete Stair flight
--  detailAttribPane()               -
--  editLandings()                   -
--  evaluateStrflt()                 -
--  getPositionControlPos(ARRAY)     POSITION            returns the position in appropriate unit from POSITIONCONTROL gadget
--  getStrfltAbove(DBREF)            DBREF
--  getStrfltOwnerFrom(DBREF)        DBREF               get possible strflt owner passed db position, e.g db item that can own the strflt
--  installOption(GADGET,STRING)     -
--  kill()                           -                   callback executed on form kill
--  lwp(EDGPOSITIONDATA)             -                   Set Lower working point
--  mainPane()                       -
--  modTreadCnt()                    -
--  modTreadCntPane()                -                   show detail attribute panel
--  modifyGoing()                    -
--  modifyGoingPane()                -                   show detail attribute panel
--  modifyHandraSide()               -                   sets the selection for the side in which handrails are installed
--  modifySegmentElevation()         -
--  modifyStrflt(GADGET,STRING)      -
--  modifyStrfltPane(DBREF)          -                   show main modification panel
--  modifyTmplReference(GADGET,STRING) -                   open callback from most gadgets
--  modifyTreadCnt()                 -                   modifies the segment elevation after evaluation
--  pickLndgElevation()              -
--  pickLwp()                        -
--  pickNormalPoint()                -
--  pickPlane()                      -
--  pickUwp()                        -
--  planeLwp()                       -
--  planePoint(REAL)                 -                   sets the landing elevation with the picked value
--  populateLandingGrid(REAL,REAL)   REAL
--  positionControl()                -
--  positionOption()                 -                   Choose explicit or relative position option
--  reselElevRow(ARRAY)              -
--  reselRow(ARRAY)                  -
--  rpath()                          ASLRPATH            get rpath from owned Stair flight object
--  setDefaultValues()               -
--  setDimFeedBackGadgets()          -
--  setElevGrid()                    -
--  setExtension()                   -                   Set the gadgets related to Sense and calls the set sense method in Object
--  setFlightGadgets()               -
--  setGadgets(DBEASLSTRFLT)         -
--  setGenAttGadgets()               -
--  setHandraData(ASLHANDRAIL)       -
--  setLandingOffset(GADGET,STRING)  -
--  setLndgElevation(EDGPOSITIONDATA) -                   -
--  setModGoingPaneGadgets(BOOLEAN)  -
--  setNormalLength(POSITION)        -
--  setPerpPlane(REAL,DIRECTION)     -
--  setPickedData(EDGPOSITIONDATA,EDGPOSITIONDATA) -
--  setPitchGadget()                 -
--  setPixmapAndTooltip()            -                   sets the pixmap files and tooltip for gadgets
--  setPositionControl(POSITION,ANY) -                   returns the position in appropriate unit from POSITIONCONTROL gadget
--  setSegmentAttributes(REAL)       -
--  setSenseGadget(BOOLEAN)          -
--  setStrfltPaneGadgets(BOOLEAN)    -                   set active/visible status of gadgets of create/modify Strflt panel
--  setup()                          -                   form initialise
--  showDimFeedback(GADGET,STRING)   -                   callback from view gadgets
--  showDimFeedbackHeight()          -                   create and show linear dimension of overall length
--  showDimFeedbackLength()          -                   create and show linear dimension of overall length
--  showHandraDetailAttributes()     -                   opens the Handrail specification form
--  showLinearDimension(REAL,STRING,DIRECTION,POSITION,POSITION,REAL,REAL,STRING) -
--  showMainPane()                   -
--  showNormalPlane(PLANE)           -
--  showPanel(GADGET)                -                   make passed panel visible and discard the others
--  showVolFeedback()                -                   callback for displaying volume feedback
--  storePickedPosData(EDGPOSITIONDATA,STRING) -
--  storePosition(POSITION,STRING)   -
--  strflt(DBEASLSTRFLT)             -                   assign DBEASLSTRFLT object to the form
--  track()                          -
--  updateAssemblyOptions()          -
--  updateFrameSegment(GADGET,STRING) -                   update the gadgets
--  updateLimitsStrflt()             -
--  uwp(EDGPOSITIONDATA)             -                   Set Upper working point
--  validateHorizDirection(GADGET)   -                   validate if the entered value is a valid direction
--  validateName()                   -
--  validationTextGadgets(GADGET,CRITERION) -                   Validating the text gadgets.
--
------------------------------------------------------------------------
-- import dot net controls
import 'PositionControl'
handle ANY
endhandle

import 'GridControl'
handle ANY
endhandle

setup form !!aslStrFlt dialog dock right

  -- general form data
  !this.callback     = '!this.setup()'
  !this.formRevision = ' $Revision$ '
  !this.formTitle    = 'Stair Flight'
  !this.quitCall     = '!this.closeForm()'

  -- .NET library
  using namespace 'Aveva.Pdms.Presentation'

  track    'DESICE'    callback '!this.track()'

  path down

  -- Main Panel for Stair flight tasks
  -----------------------------------------------------------------------------
  frame       .mainPane         panel                     at x0    y0         anchor T+L

    -- Create Tasks
    para      .createTask                                 at x0.5   ymax      text 'Create'                                 width 5
    line      .createTaskLine                             at xmin   ymax-0.2   horizontal                                   width 32
    button    .mainCreateStrflt linklabel 'Stair Flight'  at x2     ymax      callback  '!this.createStrfltPane(''init'')'  width 10

    -- Modify Tasks
    para      .modifyTask                                 at x0.5   ymax+0.5  text 'Modify'                                 width 5
    line      .modifyTaskLine                             at xmin   ymax      horizontal                                    width 32
    button    .mainModifyStrflt linklabel 'Stair Flight'  at x2     ymax      callback '!this.modifyStrfltPane(!!ce)'       width 10

    -- Delete Tasks
    para      .deleteTask                                 at x0.5   ymax+0.5  text 'Delete'                                 width 5
    line      .deleteTaskLine                             at xmin   ymax      horizontal                                    width 32
    button    .mainDeleteStrflt linklabel 'Stair Flight'  at x2     ymax      callback '!this.deleteStrflt()'               width 17

    para      .exitIcon                                   at x0.5   ymax+0.5  pixmap                                        width 16 height 16
    button    .exit             linkLabel 'Exit'          at xmax+1 ymin      callback '!this.closeForm()'                  width 3

  exit
  -- End of Main Panel for Stair flight tasks


  -- Main Stair flight panel frame
  ------------------------------------------------------------------------------------------------------------------------------------------------------
  frame .strfltPane panel anchor T+L at x0 y0

    -- General attributes
    para    .paMainAttrib                             at x0.5                     ymin        text 'General Attributes'                     width 30
    line    .lnMainAttrib                             at xmin                     ymax-0.2    horizontal                                    width 37
    text    .txName    'Name:'          tagwidth 10   at x1                       ymax+0.1    callback '!this.modifyStrflt('                width 24  is STRING
    text    .txDesc    'Description:'   tagwidth 10   at x1                       ymax+0.1                                                  width 24  is STRING
    numeric .dbArea    'Area:'          tagwidth 10   at x1                       ymax+0.1    range 0 10000 ndp 0                           width 5
    numeric .dbNumber  'Number:'        tagwidth  8   at xmax+2                   ymin        range 0 10000 ndp 0                           width 5
    -- End of General attributes

    path down

    -- Installation options
    para   .paInstallationStrflt                      at x0.5                     ymax+0.5    text 'Installation Options'                   width 30
    line   .lnInstallationStrflt                      at xmin                     ymax-0.2    horizontal                                    width 37

    para   .paInstallOption1                          at xmin+0.7                 ymax        text 'Straight'                               width 7  lines 1
    para   .paInstallOption2                          at xmax+2.5                 ymin        text 'L-Shaped'                               width 7  lines 1
    para   .paInstallOption3                          at xmax+2.5                 ymin        text 'S-Shaped'                               width 7  lines 1
    para   .paInstallOption4                          at xmax+2.5                 ymin        text 'U-Shaped'                               width 7  lines 1


    button .toInstallOption1     toggle               at xmin.paInstallOption1+1  ymax        pixmap      callback '!this.installOption('   width 24 height 24
    button .toInstallOption2     toggle               at xmin.paInstallOption2+1  ymin        pixmap      callback '!this.installOption('   width 24 height 24
    button .toInstallOption3     toggle               at xmin.paInstallOption3+1  ymin        pixmap      callback '!this.installOption('   width 24 height 24
    button .toInstallOption4     toggle               at xmin.paInstallOption4+1  ymin        pixmap      callback '!this.installOption('   width 24 height 24

  option    .opExtnOptions  'Extensions '           at x1       ymax       anchor T+L            callback '!this.setExtension()' width 5

    path down

    -- Direction and Position attributes
    frame .frStrfltPosDir  panel                                          at x0      ymax-0.2  anchor T+L

      para        .paStrfltPosDir                                         at x0.5    ymax      text 'Position and Direction'                        width 30
      line        .lnStrfltPosDir                                         at xmin    ymax-0.2  horizontal                                           width 37

      para        .paUWP                                                  at x1      ymax      text 'Upper Work Point'
      button      .lkUWP                                  linklabel       at x1      ymax+0.1  'Pick Position'      callback '!this.pickUwp()'      width 8

      option    .opSurfJustUWP                                            at x12     ymin     anchor T+L    callback '!this.setLandingOffset('  width 3
      option    .opSurfLevelUWP                                           at x19     ymin     anchor T+L    callback '!this.setLandingOffset('  width 14

      container   .netUPositionFrame                      PMLNetCONTROL   at x1      ymax+0.6  'NET'                                                width 36  height 4

      para        .paLWP                                                  at x1      ymax+0.2  text 'Lower Work Point'

      rtoggle     .rtPosition                             tagwidth 5      at x1      ymax+0.2  'Position'
      rtoggle     .rtPlane                                tagwidth 5      at xmax+1  ymin      'Plane'

      option    .opSurfJustLWP                                            at x12     ymin+1    anchor T+L    callback '!this.setLandingOffset(' width 3
      option    .opSurfLevelLWP                                           at x19     ymin      anchor T+L    callback '!this.setLandingOffset(' width 14

      frame       .frLowerPosition                        panel           at x0      ymin+0.1
        button    .lkLWP                                  linklabel       at x1      ymin      'Pick Position'      callback '!this.pickLwp()'      width 8
        container .netLPositionFrame                      PMLNetCONTROL   at x1      ymax+0.5  'NET'                width 36 height 4
      exit

      frame       .frLowerPlane                           panel           at x0      ymin                                                           width 35 height 5
        button    .lkLPlane                               linklabel       at x1      ymin      'Pick Plane'         callback '!this.pickPlane()'    width 11
        text      .txExplicitDir     'Direction:'         tagwidth 14     at x1      ymax+0.2                  callback '!this.planeLwp()'          width 15    is DIRECTION format !!distanceFmt
        text      .txPitchStrFlt     'Pitch:'             tagwidth 14     at x1      ymax+0.2                   callback '!this.planeLwp()'                                    width 15    is REAL      format !!realFmt
        text      .txHeightStrFlt    'Height:'            tagwidth 14     at x1      ymax+0.2                   callback '!this.planeLwp()'         width 15    is REAL      format !!distanceFmt
      exit

      line        .lnPosDir                                               at xmin    ymax+0.1  HORIZ                                                width 37
      text        .txLandingThickness         'Landing Thickness:'  tagwidth 14       at x1      ymax+0.7  callback '!this.modifyStrflt('                       width 15  is REAL format !!distanceFmt


    frame .frUtypeNorLength  panel at x1 ymax
      text      .txUtypeNorDirection 'Normal Direction'  tagwidth 14  at x0    ymax          callback '!this.modifyStrflt('      width 12    is DIRECTION
       text      .txUtypeNorLength    'U-flight Offset'   tagwidth 14    at x0      ymax+0.2       callback '!this.modifyStrflt('      width 12    is REAL format !!distanceFmt
       button    .lkUtypeNorLength    linklabel                          at xmax    ymin                   'Pick position'         callback '!this.pickNormalPoint()'    width 11
    exit

      -- toggle gadgets for Sense
    button    .toClockwiseStrFlt       toggle     at xmax.txUtypeNorDirection+0.5   ymin.txUtypeNorDirection   pixmap callback '!this.assignSense(' width 16 height 16
    button    .toAntiClockwiseStrFlt   toggle     at xmax+2                         ymin                       pixmap callback '!this.assignSense(' width 16 height 16

    exit
    -- End of Direction and Position attributes

    path down

    -- Standards and templates (catalogue elements)
    para    .paAssemblies                             at x0.5     ymax+0.2  text 'Assemblies'                                                             width 30
    line    .lnAssemblies                             at xmin     ymax-0.2  horizontal                                                                    width 37

    para   .paStrfltTmplReference                     at x1                                 text 'Stair flight:'                            width 7
    option .opStrfltTmplReference                     at xmax+0.2 ymin                                      callback '!this.modifyTmplReference('         width 15
    button .lkStrfltPaneDetailAttrib    linklabel     at xmax+0.2 ymin      'Detail Attributes...'          callback '!this.detailAttribPane()'           width 11

    para   .paHandraTmplReference                     at x1                                                           text 'Handrail:'                                width 7
    option .opHandraTmplReference                     at xmax+0.2 ymin                                      callback '!this.modifyTmplReference('         width 15
    button .lkHandraSpecification       linklabel     at xmax+0.2 ymin      'Detail Attributes...'          callback '!this.showHandraDetailAttributes()' width 11

    line   .lnSide                                    at x1       ymax+0.2  horizontal                                                                    width 37
    para   .paHandraSide                              at x1                                                           text 'Handrail Installations:'                                width 14
    option .opHandraSide                              at xmax+0.2 ymin                                      callback '!this.modifyHandraSide()'           width 8

    --End of Standards and templates (catalogue elements)

    -- Perform sequence
    ---------------------------------------------------------------------------
      para .paStrfltPanePerformTask                             at x0.5   ymax+0.5  text 'Perform Task'                          width 30
    line      .lnStrfltPanePerformTask                        at xmin    ymax-0.2                     horizontal                                                      width 38

    para .paStrfltPaneEvaluateIcon                            at x1      ymax+0.1                     pixmap                                                          width 16 height 16
    button    .lkStrfltPaneEvaluate             linklabel     at x4      ymin                         'Evaluate Stair Flight'      callback '!this.evaluateStrflt()'  width 14

    para .paStrfltPaneCreateIcon                              at x1      ymax+0.2                     pixmap                                                          width 16 height 16
    button    .lkStrfltPaneCreate               linklabel     at x4      ymin                         'Create Stair Flight'        callback '!this.createStrflt()'    width 11

    para .paStrfltPaneAcceptIcon                              at x1      ymin.paStrfltPaneCreateIcon  pixmap width 16 height 16
    button    .lkStrfltPaneAccept               linklabel     at xmax+1  ymin                         'Update Changes'              callback '!this.acceptStrflt()'   width 10

    para .paStrfltPaneBackToStrfltMainIcon                    at x1      ymax+0.2                     pixmap                                                          width 16 height 16
    button    .lkStrfltPaneBackToStrfltMain     linkLabel     at x4      ymin                         'Back to Stair flight Tasks'  callback '!this.mainPane()'       width 18

    -- End of Perform sequence

  exit
  -- End of Main Stair flight panel frame


  -- Frame panel for Detail (Segment) attributes
  ---------------------------------------------------------------------------
  frame .detailAttribPane    panel              at x0         y0      ''    anchor T+L

    -- Flight detail attributes
    para   .paStrfltDetailAttributes       at x0.5   ymin+0.5          text 'Detail Attributes'                          width 30
    line   .lnStrfltDetailAttributes       at xmin   ymax-0.2          horizontal                                                           width 38

    text   .txLength                          at x3                       'Overall Length:'    callback '!this.modifyStrflt('     tagwidth 16  width 14           is REAL format !!distanceFmt
    button .toAidLength       toggle pixmap   at x35    ymin.txLength                          callback '!this.showDimFeedback('        width 16 height 16


    text   .txHeight                          at x3                       'Overall Height:'    callback '!this.modifyStrflt('     tagwidth 16  width 14           is REAL format !!distanceFmt
--    button .toAidHeight       toggle pixmap   at x35    ymin.txHeight                          callback '!this.showDimFeedbackHeight('        width 16 height 16
    button .toAidHeight       toggle pixmap   at x35    ymin.txHeight                          callback '!this.showDimFeedback('        width 16 height 16


    text   .txWidth                           at x3                       'Width:'             callback '!this.modifyStrflt('     tagwidth 16  width 14           is REAL format !!distanceFmt
    button .toAidWidth        toggle pixmap   at x35    ymin.txWidth                           callback '!this.showDimFeedback('               width 16 height 16

    text   .txFthickness                      at x3                       'Flight Thickness:'  callback '!this.modifyStrflt('     tagwidth 16  width 14           is REAL format !!distanceFmt
    button .toAidFltThickness toggle pixmap   at x35    ymin.txFthickness                      callback '!this.showDimFeedback('               width 16 height 16

    text   .txHeadRoom                        at x3                       'Head Room:'         callback '!this.modifyStrflt('     tagwidth 16  width 14           is REAL format !!distanceFmt
    button .toAidHeadRoom     toggle pixmap   at x35    ymin.txHeadRoom                        callback '!this.showDimFeedback('               width 16 height 16

    text   .txRise                            at x3                       'Rise:'              callback '!this.modifyStrflt('     tagwidth 16  width 14           is REAL format !!distanceFmt
    button .toAidRise         toggle pixmap   at x35    ymin.txRise                            callback '!this.showDimFeedback('               width 16 height 16

    text   .txLRise                           at x3                       'Lower Rise:'        callback '!this.modifyStrflt('     tagwidth 16  width 14           is REAL format !!distanceFmt
    button .toAidLRise        toggle pixmap   at x35    ymin.txLRise                           callback '!this.showDimFeedback('               width 16 height 16

    button .buLExtension          linklabel   at x3                       'Lower Extension:'   callback '!this.modifyGoing()'                  width 10
    text   .txLExtension                      at x19    ymin.buLExtension                      callback '!this.modifyStrflt('                  width 14           is REAL format !!distanceFmt
    button .toAidLExtension   toggle pixmap   at x35    ymin.txLExtension                      callback '!this.showDimFeedback('               width 16 height 16

    button .buUExtension          linklabel   at x3                       'Upper Extension:'   callback '!this.modifyGoing()'                  width 10
    text   .txUExtension                      at x19    ymin.buUExtension                      callback '!this.modifyStrflt('                  width 14           is REAL format !!distanceFmt
    button .toAidUExtension   toggle pixmap   at x35    ymin.txUExtension                      callback '!this.showDimFeedback('               width 16 height 16
    -- end of flight detail attributes

    -- Segment Attributes
    para    .paSegmentAttributes                   at x0.5      ymax+1  text            'Flight Segment Attributes'                                                         width 30
    line    .lnSegmentAttributes                   at xmin      ymax-0.2                                            horizontal                                              width 38

    para    .paSegmentTxt                          at x3                                text  'Flight Segment'
    numeric .nuSegmentStrflt                       at x19.2     ymin                    ''                          callback '!this.updateFrameSegment('                    width 5
    para    .paSegmentStrflt                       at xmax+0.5  ymin                    text  ' of  '
    path down

    text   .txLndgElevation                        at x3                                'Upper Elevation:'          callback '!this.modifySegmentElevation()' tagwidth 16   width 14           is REAL format !!distanceFmt
    button .lkPickLndgElevation        linkLabel   at x34.5     ymin                    'Pick'                      callback '!this.pickLndgElevation()'                    width 3

    button .buLowerLndgLength          linklabel   at x3                                'Lower Landing Length:'     callback '!this.modifyGoing()'                          width 15
    text   .txLowerLndgLength                      at x19       ymin.buLowerLndgLength                              callback '!this.modifyStrflt('                          width 14           is REAL format !!distanceFmt
    button .toAidLowerLndgLength toggle pixmap     at x35       ymin.txLowerLndgLength                              callback '!this.showDimFeedback('                       width 16 height 16

    button .buUpperLndgLength          linklabel   at x3                                'Upper Landing Length:'     callback '!this.modifyGoing()'                          width 15
    text   .txUpperLndgLength                      at x19       ymin.buUpperLndgLength                              callback '!this.modifyStrflt('                          width 14           is REAL format !!distanceFmt
    button .toAidUpperLndgLength toggle pixmap     at x35       ymin.txUpperLndgLength                              callback '!this.showDimFeedback('                       width 16 height 16

    text   .txOgoing                               at x3                                'Overall Going:'            callback '!this.modifyStrflt('            tagwidth 16   width 14           is REAL format !!distanceFmt
    button .toAidOGoing          toggle pixmap     at x35       ymin.txOgoing                                       callback '!this.showDimFeedback('                       width 16 height 16

    text   .txOrise                                at x3                                'Overall Rise:'             callback '!this.modifyStrflt('            tagwidth 16   width 14           is REAL format !!distanceFmt
    button .toAidORise           toggle pixmap     at x35       ymin.txOrise                                        callback '!this.showDimFeedback('                       width 16 height 16

    text   .txGoing                                at x3                                'Going:'                    callback '!this.modifyStrflt('            tagwidth 16   width 14           is REAL format !!distanceFmt
    button .toAidGoing           toggle pixmap     at x35       ymin.txGoing                                        callback '!this.showDimFeedback('                       width 16 height 16

    -- set the gadgets to real format as this is unit less
    text   .txPitch                                at x3                                'Pitch:'                    callback '!this.modifyStrflt('            tagwidth 16   width 14           is REAL format !!realFmt
    button .toAidPitch           toggle pixmap     at x35       ymin.txPitch                                        callback '!this.showDimFeedback('                       width 16 height 16

    button .buTreadCnt         linklabel         at x3                                'No of Treads:'               callback '!this.modTreadCnt()'                          width 15
    text   .txTreadCnt                           at x19        ymin.buTreadCnt                                      callback '!this.modifyTreadCnt()'                          width 14           is REAL format !!realFmt
    -- End of Segment attributes

    --Perform sequence
    ---------------------------------------------------------------------------
      para .paDetAttribPerformTask                 at x0.5   ymax+0.5  text 'Perform Task'                          width 30
      line .lnDetAttribPerformTask                 at xmin   ymax-0.2  anchor T+L horizontal                        width 38

      para .paDetAttribBackToStrfltIcon                                                 at x1    ymax+0.2      anchor T+L     pixmap                                                width 15 height 15
      button    .lkDetAttribBackToStrflt      linkLabel  'Back to Create Stair flight'  at x4    ymin          callback '!this.showPanel(!this.strfltPane)'  width 18

      para .paDetAttribBackToMainIcon                                                   at x1    ymax+0.2      anchor T+L     pixmap                                                width 15  height 15
      button    .lkDetAttribStrfltBackToMain  linkLabel  'Back to Stair flight Tasks'   at x4    ymin     callback '!this.mainPane()'                   width 18

    -- End of Perform sequence
  exit
  -- end of panel frame for Segment attributes

  -- Frame panel for modifying landing lengths nd extensions
  frame .modifyGoing  panel                      at x0         y0      ''    anchor T+L

      text .txModLExtension  'Lower Extension'   callback '!this.calcLegLength()' tagwidth 15  at x1 ymax+0.2    width 10 is REAL
      text .txModUExtension  'Upper Extension'   callback '!this.calcLegLength()' tagwidth 15  at x1 ymax+0.5    width 10 is REAL

      container .netLegGoingGridFrame PMLNETCONTROL |Net Grid| anchor ALL width 40 height 8

      text .origLengTxt  'Actual Length'     tagwidth 15  at x1 ymax+0.5    width 10 is REAL format !!distanceFmt
      text .calcLengTxt  'Calculated Length' tagwidth 15  at x1 ymax+0.5    width 10 is REAL format !!distanceFmt

      --Perform sequence
      ---------------------------------------------------------------------------
      para .paModifyGoingPerformTask                        at x0.5    ymax+1    text 'Perform Task'  width 30
      line .lnModifyGoingPerformTask                        at xmin    ymax-0.2  horizontal           width 38

      para .paModGoingAcceptIcon                            at x1       ymax+0.2   pixmap                                                                      width 16 height 16
      button    .lkModGoingPaneAccept           linklabel   at xmax+1   ymin       'Update Changes'              callback '!this.editLandings()'               width 10

      para .paModGoingBackToDetAttribIcon                   at x1       ymax+0.2   pixmap                                                                      width 15 height 15
      button    .lkModGoingBackToDetAttrib      linkLabel   at x4       ymin       'Back to Detail Attributes'   callback '!this.detailAttribPane()'           width 18

      para .paModGoingBackToStrfltIcon                      at x1       ymax+0.2   pixmap                                                                      width 15 height 15
      button    .lkModGoingBackToStrflt         linkLabel   at x4       ymin       'Back to Modify Stair flight' callback '!this.showPanel(!this.strfltPane)'  width 18

      para .paModGoingBackToMainIcon                        at x1       ymax+0.2   pixmap                                                                      width 15  height 15
      button    .lkModGoingBackToMain           linkLabel   at x4       ymin       'Back to Stair flight Tasks'  callback '!this.mainPane()'                   width 18
      -- End of Perform sequence
  exit
  -- end of modify going frame panel

  frame .modTreadCntPane  panel                      at x0         y0      ''    anchor T+L


      para .paTreadsCnt          at x1 ymax+0.2   text 'Modify tread count in a flight'                          width 40

      container .netTreadCntGridFrame PMLNETCONTROL |Net Grid| anchor ALL width 40 height 8

      --Perform sequence
      ---------------------------------------------------------------------------
      para .paModTreadCntTask                        at x0.5    ymax+1    text 'Perform Task'  width 30
      line .lnModTreadCntTask                        at xmin    ymax-0.2  horizontal           width 38

      para .paModTreadCntAcceptIcon                            at x1       ymax+0.2   pixmap                                                                      width 16 height 16
      button .lkModTreadCntAccept           linklabel   at xmax+1   ymin       'Update Changes'              callback ''               width 10

      para .paModTreadCntBackToDetAttribIcon                   at x1       ymax+0.2   pixmap                                                                      width 15 height 15
      button    .lkModTreadCntBackToDetAttrib      linkLabel   at x4       ymin       'Back to Detail Attributes'   callback '!this.detailAttribPane()'           width 18

      para .paModTreadCntBackToStrfltIcon                      at x1       ymax+0.2   pixmap                                                                      width 15 height 15
      button    .lkModTreadCntBackToStrflt         linkLabel   at x4       ymin       'Back to Modify Stair flight' callback '!this.showPanel(!this.strfltPane)'  width 18

      para .paModTreadCntBackToMainIcon                        at x1       ymax+0.2   pixmap                                                                      width 15  height 15
      button    .lkModTreadCntBackToMain           linkLabel   at x4       ymin       'Back to Stair flight Tasks'  callback '!this.mainPane()'                   width 18
      -- End of Perform sequence
  exit
  -- end of modify going frame panel

  -- Form Members

  -- reference to the stair flight
  member .strflt                is DBREF
  -- reference to db item where the new Strflt to be created
  member .strfltOwner           is DBREF

  -- working Strflt object
  member .strFltObj             is DBEASLSTRFLT

  -- temporary Strflt object
  member .tmpStrfltObj          is DBEASLSTRFLT

  member .standard              is ASLSTANDARD
  member .subStandard           is ASLSUBSTANDARD

  member  .strfltDim            is ASLSTRFLTDIM

  -- Stair flight templates
  member .templates             is ARRAY

  member .version               is STRING

  member .strfltLpos            is POSITION
  member .strfltUpos            is POSITION

  -- Array of picked position data
  member .pickedPositionData    is ARRAY

  -- Lower Work Point data
  member .pickedLPosData        is EDGPOSITIONDATA

  -- upper position data
  member .pickedUPosData        is EDGPOSITIONDATA

  -- flight configuration (installation option)
  member .flightConfiguration   is STRING

  -- Array of installation option toggles
  member .installationOptions   is ARRAY

  -- Declare namespace for .Net controls
  using namespace 'Aveva.Pdms.Presentation'

  -- .Net Position control
  member .netLPosControl        is POSITIONCONTROL
  member .netUPosControl        is POSITIONCONTROL

  -- .Net Grid control
  member .legGoingGrid         is NETGRIDCONTROL
  member .flightElevGrid       is NETGRIDCONTROL

  -- ARRAY of individual flights
  member .numberOfFlts is REAL

  -- arrays for temporary storage of working data
  member .tmpPath               is ARRAY
  member .tmpVertex             is ARRAY
  member .tmpVertexIndex        is ARRAY
  member .currentVertex         is REAL

  member .vertex                is ARRAY

  -- registry of panels
  member .panels                is ARRAY

  member .edgDescription        is STRING

  member .aidNumber             is REAL
  member .fltSegmentAidNumber   is REAL
  member .lwpAidNumber          is REAL
  member .uwpAidNumber          is REAL

  -- current mode (create or modify)
  member  .currentMode          is STRING

  member  .evaluationSuccess    is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      aslStrFlt
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslStrFlt()

  -- Version banner
  !this.version = '12.0.SP2'
  !this.formRevision  = ' $Revision$ '
  !this.callback      = '!this.setup()'
  !this.cancelCall    = '!this.cancel()'
  !this.killingCall   = '!this.kill()'

  -- Set form to autoScroll
  !this.autoScroll              = true

  !this.track()

  -- EDG Description
  !this.edgDescription    = 'ASL Stair flight Form'

--------------------------------------------------------

  -- initialise the PMLNet Position controls
  !this.positionControl()

-- --------------------------------------------------------
  -- must be set to true, so that the callback is carried out when pressing arrow up/down
  !this.nuSegmentStrflt.modifiedEvents = true
  !this.nuSegmentStrflt.val = 0
  !this.paSegmentStrflt.val = ' of 0'

  -- add all panels to registry
  !this.panels.append(!this.mainPane)
  !this.panels.append(!this.strfltPane)
  !this.panels.append(!this.detailAttribPane)
  !this.panels.append(!this.modifyGoing)
  !this.panels.append(!this.modTreadCntPane)

  !extnOptionDtext[1] = 'Both   '
  !extnOptionDtext[2] = 'Top    '
  !extnOptionDtext[3] = 'Bottom '
  !extnOptionDtext[4] = 'None   '

  !extnOptionRtext[1] = '3'
  !extnOptionRtext[2] = '2'
  !extnOptionRtext[3] = '1'
  !extnOptionRtext[4] = '0'

  !this.opExtnOptions.dText = !extnOptionDtext
  !this.opExtnOptions.rText = !extnOptionRtext

  -- Array of installation options gadget
  !this.installationOptions.append(!this.toInstallOption1)
  !this.installationOptions.append(!this.toInstallOption2)
  !this.installationOptions.append(!this.toInstallOption3)
  !this.installationOptions.append(!this.toInstallOption4)

  !surfFlushJustDtext[1] = 'FFL'
  !surfFlushJustDtext[2] = 'TOS'

  !surfLevelDtext[1] = 'Flush with Landing'
  !surfLevelDtext[2] = 'Above Landing'

  !surfLevelRtext[1] = 'Flush'
  !surfLevelRtext[2] = 'Above'

  !this.opSurfJustLWP.dText = !surfFlushJustDtext
  !this.opSurfJustUWP.dText = !surfFlushJustDtext

  !this.opSurfLevelUWP.dText = !surfLevelDtext
  !this.opSurfLevelLWP.dText  = !surfLevelDtext

  !this.opSurfLevelUWP.rText = !surfLevelRtext
  !this.opSurfLevelLWP.rText  = !surfLevelRtext

  !surfFlushJustDtext[1] = 'FFL'
  !surfFlushJustDtext[2] = 'TOS'
  !surfLevelDtext[1] = 'Flush with Landing'
  !surfLevelDtext[2] = 'Above Landing'

  !surfLevelRtext[1] = 'Flush'
  !surfLevelRtext[2] = 'Above'

  !this.opSurfJustLWP.dText = !surfFlushJustDtext
  !this.opSurfJustUWP.dText = !surfFlushJustDtext

  !this.opSurfLevelUWP.dText = !surfLevelDtext
  !this.opSurfLevelLWP.dText = !surfLevelDtext

  !this.opSurfLevelUWP.rText = !surfLevelRtext
  !this.opSurfLevelLWP.rText = !surfLevelRtext
--------------------------------------------------------
  -- get the setting data
  !currentSetting  = !!aslCentralData.currSetting.description
  handle ANY
     !!alert.error(!!error.text)
     return
  endhandle

  !this.strFltObj.dbeAslStrflt(!currentSetting)
--------------------------------------------------------

  !handraSideDtext[1] = 'Both'
  !handraSideDtext[2] = 'Left'
  !handraSideDtext[3] = 'Right'
  !handraSideDtext[4] = 'None'

  !handraSideRtext[1] = 'LR'
  !handraSideRtext[2] = 'L'
  !handraSideRtext[3] = 'R'
  !handraSideRtext[4] = ''

  !this.opHandraSide.dText = !handraSideDtext
  !this.opHandraSide.rText = !handraSideRtext


  -- initialise dimension feedback
  -- fill the dimension object, depends on the form toggles
  !strfltDimension               = object ASLSTRFLTDIM()

  !strfltDimension.length        = !this.toAidLength.val
  !strfltDimension.height        = !this.toAidHeight.val
  !strfltDimension.width         = !this.toAidWidth.val
  !strfltDimension.fThickness    = !this.toAidFltThickness.val
  !strfltDimension.headRoom      = !this.toAidHeadRoom.val
  !strfltDimension.rise          = !this.toAidRise.val
  !strfltDimension.lRise         = !this.toAidLRise.val
  !strfltDimension.lExtension    = !this.toAidLExtension.val
  !strfltDimension.uExtension    = !this.toAidUExtension.val

  --Flight Segment attributes
  !strfltDimension.lLndgLength   = !this.toAidLowerLndgLength.val
  !strfltDimension.uLndgLength   = !this.toAidUpperLndgLength.val
  !strfltDimension.oGoing        = !this.toAidOGoing.val
  !strfltDimension.oRise         = !this.toAidORise.val
  !strfltDimension.going         = !this.toAidGoing.val
  !strfltDimension.pitch         = !this.toAidPitch.val

  !this.strfltDim = !strfltDimension

--------------------------------------------------------

  -- Validate calls for text fields
  !this.txName.validateCall        = '!this.validateName()'
  !this.txExplicitDir.validateCall = '!this.validateHorizDirection(!this.txExplicitDir)'
  !this.txLength.validateCall      = '!this.validationTextGadgets(!this.txLength,    !this.strFltObj.criteria.oGoing)'
  !this.txHeight.validateCall      = '!this.validationTextGadgets(!this.txHeight,    !this.strFltObj.criteria.oRise)'
  !this.txWidth.validateCall       = '!this.validationTextGadgets(!this.txWidth,     !this.strFltObj.criteria.width)'
  !this.txFthickness.validateCall  = '!this.validationTextGadgets(!this.txFthickness,!this.strFltObj.criteria.thickness)'
  !this.txHeadRoom.validateCall    = '!this.validationTextGadgets(!this.txHeadRoom,  !this.strFltObj.criteria.verticalClearance)'

  !this.txOgoing.validateCall      = '!this.validationTextGadgets(!this.txOgoing,   !this.strFltObj.criteria.oGoing)'
  !this.txOrise.validateCall       = '!this.validationTextGadgets(!this.txOrise,    !this.strFltObj.criteria.oRise)'
  !this.txGoing.validateCall       = '!this.validationTextGadgets(!this.txGoing,    !this.strFltObj.criteria.going)'
  !this.txRise.validateCall        = '!this.validationTextGadgets(!this.txRise,     !this.strFltObj.criteria.rise)'
  !this.txLRise.validateCall       = '!this.validationTextGadgets(!this.txLRise,    !this.strFltObj.criteria.lRise)'
  !this.txPitch.validateCall       = '!this.validationTextGadgets(!this.txPitch,    !this.strFltObj.criteria.pitch)'

--------------------------------------------------------

 !this.frStrfltPosDir.callback = '!this.positionOption()'

  -- set gadgets as inactive
  -- some of the attributes may be allowed to be modified later

  -- Plane pick toggle
   !this.rtPlane.active = false

   -- flight segment attributes
   !this.txLndgElevation.active      = false
   !this.lkPickLndgElevation.active  = false

  -- Stair flight detail attributes
  !this.txLength.active     = false
  !this.txHeight.active     = false
  !this.txLExtension.active = false
  !this.txUExtension.active = false

  -- flight segment attributes
  -- Treads count is activated on conditional basis in setSegmentAttributes
  !this.txLowerLndgLength.active  = false
  !this.txUpperLndgLength.active  = false
  !this.txOgoing.active           = false
  !this.txOrise.active            = false
  !this.txGoing.active            = false
  !this.txLRise.active            = false
  !this.txPitch.active            = false
  !this.buTreadCnt.active       = true


  -- set the Create icon inactive till evaluation is successful
  !this.lkStrfltPaneCreate.active = false


--------------------------------------------------------
  -- register aid numbers
  !this.lwpAidNumber        = !!aidNumbers.add('LWP')
  !this.uwpAidNumber        = !!aidNumbers.add('UWP')
  !this.fltSegmentAidNumber = !!aidNumbers.add('ASL Flight Segment Details')

  -- register the form so that it appears again when entering pdms
  !!appFormCntrl.registerForm(!this)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: form initialize
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- update gadget limits with toot tip
  !this.updateLimitsStrflt()

  !this.updateAssemblyOptions()

  !this.currentMode = 'CREATE'

  !this.mainPane()

  using namespace  'Aveva.Pdms.Presentation'
   -- Add instances of .Net control
  !this.legGoingGrid = object NETGRIDCONTROL()

  -- Add .Net controls to PML containers
  !this.netLegGoingGridFrame.control = !this.legGoingGrid.handle()

   -- add PML event handlers to .Net control
  !this.legGoingGrid.addEventHandler('BeforeCellUpdate', !this, 'reselRow')
  !this.legGoingGrid.addEventHandler('AfterCellUpdate',  !this, 'calcFlightLength')

  !this.origLengTxt.active = false
  !this.calcLengTxt.active = false
  !this.lkModGoingPaneAccept.active = false

  -- Set parameters
  !this.legGoingGrid.columnExcelFilter(false)
  !this.legGoingGrid.outlookGroupStyle(false)
  !this.legGoingGrid.fixedHeaders(true)
  !this.legGoingGrid.fixedRows(false)
  !this.legGoingGrid.editableGrid(true)
  !this.legGoingGrid.headerSort(false)
  !this.legGoingGrid.columnSummaries(false)
  !this.legGoingGrid.singleRowSelection(true)

  -- Clear any existing data
  !this.legGoingGrid.clearGrid()

   using namespace  'Aveva.Pdms.Presentation'
   -- Add instances of .Net control
  !this.flightElevGrid = object NETGRIDCONTROL()

  !this.netTreadCntGridFrame.control = !this.flightElevGrid.handle()

   -- add PML event handlers to .Net control
  !this.flightElevGrid.addEventHandler('BeforeCellUpdate', !this, 'reselElevRow')
  !this.flightElevGrid.addEventHandler('AfterCellUpdate',  !this, 'calcLndgElev')

    -- Set parameters
  !this.flightElevGrid.columnExcelFilter(false)
  !this.flightElevGrid.outlookGroupStyle(false)
  !this.flightElevGrid.fixedHeaders(true)
  !this.flightElevGrid.fixedRows(false)
  !this.flightElevGrid.editableGrid(true)
  !this.flightElevGrid.headerSort(false)
  !this.flightElevGrid.columnSummaries(false)
  !this.flightElevGrid.singleRowSelection(true)

--------------------------------------------------------

  -- set pixmap images and tool-tips for gadget
  !this.setPixmapAndTooltip()

--------------------------------------------------------

  -- set default values for gadgets
  !this.setDefaultValues()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      positionControl
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionControl()

  -- Implementation of positional control

  ------------------Setup for position control-----------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- Create new instance of position control
  !this.netLPosControl = object POSITIONCONTROL()
  !this.netUPosControl = object POSITIONCONTROL()

  -- Load ship grid data
  !grid         = object SHIPGRID()
  !gridDefined  = !grid.position.set()

  -- Only populate the grid data if a ship reference grid is available
  if(!gridDefined) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.netLPosControl.gridData(!xGridData,!yGridData,!zGridData)
    !this.netUPosControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    !this.netLPosControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)
    !this.netUPosControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.netLPosControl.heading('World Position')
    !this.netUPosControl.heading('World Position')

    !this.netLPosControl.gridFormat()
    !this.netUPosControl.gridFormat()

  else
    var !coordinate coordinate
    if(!coordinate.eq('ENU'))then
      !this.netLPosControl.enuFormat()
      !this.netUPosControl.enuFormat()
    else
      !this.netLPosControl.xyzFormat()
      !this.netUPosControl.xyzFormat()
    endif

    !this.netLPosControl.gridVisible(false)
    !this.netUPosControl.gridVisible(false)
  endif
  -- End of code for Implementing positional control

  !this.netLPosControl.changeAction('!!aslStrFlt.modifyStrflt(!!aslStrFlt.netLPositionFrame,||)')
  !this.netUPosControl.changeAction('!!aslStrFlt.modifyStrflt(!!aslStrFlt.netUPositionFrame,||)')

   -- Add PMLNet control to PML frame
  !this.netLPositionFrame.control = !this.netLPosControl.handle()
  !this.netUPositionFrame.control = !this.netUPosControl.handle()

  -- set position to default E0N0U0
  !this.netLPosControl.xyz(0,0,0)
  !this.netUPosControl.xyz(0,0,0)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getPositionControlPos
--
-- Description: returns the position in appropriate unit from POSITIONCONTROL gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPositionControlPos(!posValues is ARRAY) is POSITION

  !east  = !posValues[0].string()
  !north = !posValues[1].string()
  !up    = !posValues[2].string()

  !position   = object POSITION(' E  $!east  N  $!north  U $!up ' )

  return !position

endmethod
------------------------------------------------------------------------
--
-- Method:      setPositionControl
--
-- Description: returns the position in appropriate unit from POSITIONCONTROL gadget
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPositionControl(!position is POSITION, !posCntrl is ANY)

  -- Format the values into proper Distance format
  !eastWest   = object REAL( !position.east.string() , !!distanceFmt)
  !northSouth = object REAL( !position.north.string(), !!distanceFmt)
  !upDown     = object REAL( !position.up.string()   , !!distanceFmt)

  -- update the position control
  !posCntrl.xyz(!eastWest, !northSouth, !upDown)

endmethod
------------------------------------------------------------------------
--
-- Method:      setPixmapAndTooltip
--
-- Description: sets the pixmap files and tooltip for the gadgets
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPixmapAndTooltip()

  -- Installation Configurations
  !this.toInstallOption1.addPixmap(!!pml.getPathName('aslinstallationsituation01-16.png'))
  !this.toInstallOption1.setTooltip('Straight Stair')

  !this.toInstallOption2.addPixmap(!!pml.getPathName('aslinstallationsituation06-16.png'))
  !this.toInstallOption2.setTooltip('L-Shaped Stair')

  !this.toInstallOption3.addPixmap(!!pml.getPathName('aslinstallationsituation02-16.png'))
  !this.toInstallOption3.setTooltip('S-Shaped Stair')

  !this.toInstallOption4.addPixmap(!!pml.getPathName('aslinstallationsituation04-16.png'))
  !this.toInstallOption4.setTooltip('U-Shaped Stair')

  !this.toClockwiseStrFlt.addPixmap(!!pml.getPathName('activeredo16.png'))
  !this.toAntiClockwiseStrFlt.addPixmap(!!pml.getPathName('activeundo16.png'))

  -- Detailed Attributes
  !this.toAidLength.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidLength.setTooltip('Display Overall length')

  !this.toAidHeight.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidHeight.setTooltip('Display Overall height')

  !this.toAidWidth.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidWidth.setTooltip('Display Flight width')

  !this.toAidFltThickness.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidFltThickness.setTooltip('Display Flight thickness')

  !this.toAidHeadRoom.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidHeadRoom.setTooltip('Display Head room')

  !this.toAidLExtension.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidLExtension.setTooltip('Display lower extension')

  !this.toAidUExtension.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidUExtension.setTooltip('Display upper extension')

  -- Segment attributes
  !this.toAidLowerLndgLength.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidLowerLndgLength.setTooltip('Display segment Lower Landing length')

  !this.toAidUpperLndgLength.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidUpperLndgLength.setTooltip('Display segment Upper Landing length')

  !this.toAidOGoing.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidOGoing.setTooltip('Display segment Overall going')

  !this.toAidORise.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidORise.setTooltip('Display segment Overall rise')

  !this.toAidGoing.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidGoing.setTooltip('Display segment Going')

  !this.toAidRise.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidRise.setTooltip('Display segment Rise')

  !this.toAidLRise.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidLRise.setTooltip('Display segment Bottom rise')

  !this.toAidPitch.addPixmap(!!pml.getPathName('measure16.png'))
  !this.toAidPitch.setTooltip('Pitch')

--------------------------------------------------------------------
  -- "Back" icon
  !backIcon                     = !!pml.getPathName('back.png')

  !this.paStrfltPaneBackToStrfltMainIcon.addPixmap(!backIcon)

  !this.paDetAttribBackToStrfltIcon.addPixmap(!backIcon)
  !this.paDetAttribBackToMainIcon.addPixmap(!backIcon)

  !this.paModGoingBackToDetAttribIcon.addPixmap(!backIcon)
  !this.paModGoingBackToStrfltIcon.addPixmap(!backIcon)
  !this.paModGoingBackToMainIcon.addPixmap(!backIcon)


  !this.paModTreadCntBackToDetAttribIcon.addPixmap(!backIcon)
  !this.paModTreadCntBackToStrfltIcon.addPixmap(!backIcon)
  !this.paModTreadCntBackToMainIcon.addPixmap(!backIcon)


  !this.exitIcon.addPixmap(!backIcon)

  -- "Evaluate" icon
  !evaluateIcon                 = !!pml.getPathName('aslnewstair16.png')
  !this.paStrfltPaneEvaluateIcon.addPixmap(!evaluateIcon)

  -- "Create" Icon
  !createIcon                   = !!pml.getPathName('create.png')
  !this.paStrfltPaneCreateIcon.addPixmap(!createIcon)

  -- "Accept" icon
  !acceptIcon                   = !!pml.getPathName('accept.png')
  !this.paStrfltPaneAcceptIcon.addPixmap(!acceptIcon)
  !this.paModGoingAcceptIcon.addPixmap(!acceptIcon)
  !this.paModTreadCntAcceptIcon.addPixmap(!acceptIcon)


endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:    updateLimitsStrflt
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateLimitsStrflt()

  call !!fillCriterionGadgets(!this.txLength,     object GADGET(), !this.strFltObj.criteria.oGoing)
  call !!fillCriterionGadgets(!this.txHeight,     object GADGET(), !this.strFltObj.criteria.oRise)
  call !!fillCriterionGadgets(!this.txWidth,      object GADGET(), !this.strFltObj.criteria.width)
  call !!fillCriterionGadgets(!this.txFthickness, object GADGET(), !this.strFltObj.criteria.thickness)
  call !!fillCriterionGadgets(!this.txHeadRoom,   object GADGET(), !this.strFltObj.criteria.verticalClearance)

  call !!fillCriterionGadgets(!this.txOgoing,     object GADGET(), !this.strFltObj.criteria.oGoing)
  call !!fillCriterionGadgets(!this.txOrise,      object GADGET(), !this.strFltObj.criteria.oRise)
  call !!fillCriterionGadgets(!this.txGoing,      object GADGET(), !this.strFltObj.criteria.going)
  call !!fillCriterionGadgets(!this.txRise,       object GADGET(), !this.strFltObj.criteria.rise)
  call !!fillCriterionGadgets(!this.txLRise,      object GADGET(), !this.strFltObj.criteria.lRise)
  call !!fillCriterionGadgets(!this.txPitch,      object GADGET(), !this.strFltObj.criteria.pitch)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateAssemblyOptions
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateAssemblyOptions()

  -- collect and update stair flight template references in the list
  !strfltTemplates = !!aslCentralData.getTemplates('STRFLT')

  !dText  = object ARRAY()
  !rText  = object ARRAY()
  do !strfltTmpl values !strfltTemplates
     !dText.append(!strfltTmpl.description)
     !rText.append(!strfltTmpl.string())
  enddo

  if (!dText.size().gt(0) ) then
  !this.opStrfltTmplReference.dText = !dText
  !this.opStrfltTmplReference.rText = !rText
  endif

  -- collect and update handrail template references in the list
  !handrailTemplates = !!aslCentralData.getTemplates('HANDRA')

  !dText  = object ARRAY()
  !rText  = object ARRAY()
  do !handrailTmpl values !handrailTemplates
     !dText.append(!handrailTmpl.description)
     !rText.append(!handrailTmpl.string())
  enddo

  if (!dText.size().gt(0) ) then
  !this.opHandraTmplReference.dText = !dText
  !this.opHandraTmplReference.rText = !rText
  endif
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track()

  !this.mainCreateStrflt.active = false
  !this.mainModifyStrflt.active = false
  !this.mainDeleteStrflt.active = false

  -- check if storage area is set for stair flight
  if(!!aslStoreTable.getStore('stairflight').badref().not()) then
    !strfltOwner = !!aslStoreTable.getStore('stairflight')
  else
    !strfltOwner  = !this.getStrfltOwnerFrom(!!ce)
  endif

  if(!strfltOwner.set() and !strfltOwner.badref().not()) then
    !this.mainCreateStrflt.active = true
  endif

  !strflt = !this.getStrfltAbove(!!ce)

  if(!strflt.set() and !strflt.badref().not()) then
    !this.mainModifyStrflt.active = true
    !this.mainDeleteStrflt.active = true
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------

--
-- Method:      closeForm
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .closeForm()

  -- remove text labels from aid numbers and unset the form aidNumber
  !!aidNumbers.remove(!this.lwpAidNumber)
  !this.lwpAidNumber = REAL()
  !!aidNumbers.remove(!this.uwpAidNumber)
  !this.uwpAidNumber = REAL()

  !!aidNumbers.remove(!this.fltSegmentAidNumber)

  -- clear the graphical aid created for stair flight
  !this.clearVolFeedback()

  !this.clearEdgStack()

  !this.hide()

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      setDefaultValues
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDefaultValues()

  -- initialise the general attributes
  !this.txName.val   = ''
  !this.txDesc.val   = ''
  !this.dbArea.val   = 0
  !this.dbNumber.val = 0

  -- unselect the installation options and make them active
  do !toggle values !this.installationOptions
    !toggle.val    = false
    !toggle.active = true
  enddo

  -- unset the flight configuration
  !this.flightConfiguration = ''

  -- Position gadgets - set position to default E0N0U0
  !this.netLPosControl.xyz(0,0,0)
  !this.netUPosControl.xyz(0,0,0)

  !this.pickedLPosData.position = E0
  !this.pickedUPosData.position = E0
  !pickedPosData[1] = !this.pickedLPosData
  !pickedPosData[2] = !this.pickedUPosData
  !this.strFltObj.setPickedPositionData(!pickedPosData)

  !fltDirection = N

   -- get the landing thickness from the platform criteria
  !landingThk = !!aslCentralData.getCriteriaSet(!this.strFltObj.settingReference, 'ASLPLTFRMCRITERIA').thickness.optimum()
  handle ANY
    !landingThk = 160mm
  endhandle
  !this.txLandingThickness.val = !landingThk

  !this.txExplicitDir.val      = !fltDirection
  !this.txPitchStrFlt.val      = !this.strFltObj.criteria.pitch.optimum
  !this.txHeightStrFlt.val     = !this.strFltObj.criteria.oRise.optimum

  !this.txUtypeNorDirection.val =  object DIRECTION()
  !this.txUtypeNorLength.val    = 0

   -- select position toggle as default
   !this.frStrfltPosDir.val = 1
   -- callback for rtoggle
   !this.positionOption()

   -- make the Left / Right option inactive
   !this.toClockwiseStrFlt.active     = false
   !this.toAntiClockwiseStrFlt.active = false

   !this.rtPlane.active            = false
   !this.lkStrfltPaneCreate.active = false

   !this.txUtypeNorLength.val      = 0

  -- update the assemblies list with the templates from setting
  !this.updateAssemblyOptions()

  -- set the criteria default (optimum) attributes
  !this.txLength.val      = !this.strFltObj.oGoing
  !this.txHeight.val      = !this.strFltObj.oRise

  if(!this.strFltObj.lExtension.unset()) then
    !this.strFltObj.lExtension  = 0
  endif
  !this.txLExtension.val  = !this.strFltObj.lExtension

  if(!this.strFltObj.uExtension.unset()) then
    !this.strFltObj.uExtension  = 0
  endif
  !this.txUExtension.val  = !this.strFltObj.uExtension

  -- default values not taken from criteria. values will be evaluated.
  !this.txLndgElevation.val     = 0
  !this.txLowerLndgLength.val   = 0
  !this.txUpperLndgLength.val   = 0

  !this.txLndgElevation.active     = false
  !this.lkPickLndgElevation.active = false

  !this.txOgoing.val      = !this.strFltObj.oGoing
  !this.txOrise.val       = !this.strFltObj.oRise
  !this.txWidth.val       = !this.strFltObj.width
  !this.txFthickness.val  = !this.strFltObj.fThickness
  !this.txHeadRoom.val    = !this.strFltObj.headRoom

  -- set the segment counter gadget
  !range[1] = 0
  !range[2] = 1
  !range[3] = 1
  !this.nuSegmentStrflt.range = !range
  handle ANY
    -- range not defined properly. range cannot be from zero to zero
  endhandle

  !this.nuSegmentStrflt.val = 0
  !this.paSegmentStrflt.val = ' of 0'
  !this.nuSegmentStrflt.active = false

  !this.txOgoing.val      = !this.strFltObj.oGoing
  !this.txOrise.val       = !this.strFltObj.oRise
  !this.txRise.val        = !this.strFltObj.rise
  !this.txLRise.val       = !this.strFltObj.lRise
  !this.txGoing.val       = !this.strFltObj.going
  !this.txPitch.val       = !this.strFltObj.pitch
  !this.txTreadCnt.val  = !this.strFltObj.numberOfSteps

  -- activate or deactivate the dim gadgets
  !this.setDimFeedBackGadgets()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showMainPane()

  !this.strfltPane.visible  = true

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pickLwp
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickLwp()

  -- define packet
  !prompt                = 'ASL Stair Flight - Lower Work Point'
  !packet                = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description    = 'Stair flight LWP'
  !packet.remove         = true
  !packet.action        = '!!aslStrFlt.lwp(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pickPlane
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPlane()

  !validTypeStr = |SCTN,GENSEC,PANE,WALL,GWALL,STWALL,SCREED,FLOOR,HPLATE,HBRCKT,HDOPLA,HRSOF|

  -- rule that restricts the pick type and access
  !rule = |(match('| & !validTypeStr & |',TYPE) gt 0) |

  -- Define edgpacket for picking elements to be split
  !packet                 =   object EDGPACKET()
  !packet.elementPick('Pick Planar Element for the lower working Point ')

  !packet.description     =   'Pick Planar Element for STRFLT'
  !packet.priority        =   2
  !packet.remove          =   TRUE

  -- Add filter for Pick
  !packet.pickPacket.picks[1].pick.input[3]   = !rule
  !packet.pickPacket.picks[1].pick.modifiable = FALSE

  !packet.action        = '!!aslStrFlt.planePoint(!this.return[1].item.position.wrt(world).up)'

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      pickNormalPoint
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickNormalPoint()

  -- define packet
  !prompt               = 'ASL Stair Flight - U-Shaped Point for Normal Distance'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Stair flight Normal Point'
  !packet.remove        = true
  !packet.action        = '!!aslStrFlt.setNormalLength(!this.return[1].position)'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      lwp
--
-- Description: Set Lower working point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lwp(!data is EDGPOSITIONDATA)

  -- Update position control gadget with the picked position
  !pickedPosition = !data.position.wrt(World)

  !this.setPositionControl(!pickedPosition , !this.netLPosControl)

  !evaluatedPosition   = !this.getPositionControlPos(!this.netLPosControl.xyz())

  -- store the picked position data
  !data.position        = !evaluatedPosition
  !this.pickedLPosData  = !data

  -- Work out the plane option
  if(!this.frLowerPlane.active ) then
    !this.setPitchGadget()
  endif

  -- display label for LWP
  if( !this.lwpAidNumber.set() ) then
    !!aidNumbers.hide(!this.lwpAidNumber)
    handle ANY
    endhandle 	    	

    !aidNumber          = !this.lwpAidNumber
    !!aidNumbers.remove(!aidNumber)
    !!aidNumbers.addNumber(!aidNumber , 'LWP')

  else

    !this.lwpAidNumber  = !!aidNumbers.add('LWP')
  endif

  !aidNumber = !this.lwpAidNumber
  !aidPos    = !this.pickedLPosData.position

  AID TEXT  NUMBER $!aidNumber 'LWP' AT $!aidPos


endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      pickUwp
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickUwp()

  -- define packet
  !prompt                = 'ASL Stair Flight - Upper Work Point'
  !packet                = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description    = 'Stair flight UWP'
  !packet.remove         = true
  !packet.action        = '!!aslStrFlt.uwp(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      uwp
--
-- Description: Set Upper working point
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .uwp(!data is EDGPOSITIONDATA)

  -- Update position control gadget with the picked position
  !pickedPosition = !data.position.wrt(World)

  !this.setPositionControl(!pickedPosition , !this.netUPosControl)

  !evaluatedPosition   = !this.getPositionControlPos(!this.netUPosControl.xyz())

  -- store the picked position data
  !data.position        = !evaluatedPosition
  !this.pickedUPosData  = !data

  -- display label for LWP
  if( !this.uwpAidNumber.set() ) then
    !!aidNumbers.hide(!this.uwpAidNumber)
  else
    !this.uwpAidNumber  = !!aidNumbers.add('UWP')
  endif
  AID TEXT  NUMBER $!<this.uwpAidNumber> 'UWP' AT $!this.pickedUPosData.position

  -- activate the planar pick gadget
  if (!this.rtPlane.active.not() ) then
    !this.rtPlane.active = true
  else
     if (!this.frLowerPlane.visible and !this.pickedLPosData.position.neq(E0)) then
      !calcLowPt = !!alert.confirm('Do you want to recalculate the lower position based on Pitch?')

      if (!calcLowPt.boolean()) then
         !this.planeLwp()
      else
         !this.setPitchGadget()
     endif

     endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickLndgElevation
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickLndgElevation()

  -- define packet
  !prompt               = 'Pick Intermediate Landing Elevation'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = 'Landing Elevation'
  !packet.remove        = true
  !packet.action        = '!!aslStrFlt.setLndgElevation(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setLndgElevation
--
-- Description: sets the landing elevation with the picked value
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setLndgElevation(!pickData is EDGPOSITIONDATA)

  -- set the picked elevation to the gadget
  !pickedElevation  = !pickData.position.up

  !this.txLndgElevation.val = !pickedElevation

  !this.modifySegmentElevation()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      planePoint
--
-- Description: sets the landing elevation with the picked value
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .planePoint(!elevation is REAL)

 !height = abs( !this.pickedUPosData.position.up -  !elevation )

 !this.txHeightStrFlt.val         = !height

 !this.planeLwp()

endmethod
------------------------------------------------------------------------
--
-- Method:      planeLwp
--
-- Description: sets the landing elevation with the picked value
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .planeLwp()

  if (!this.txHeightStrFlt.val.string().empty() )then
  	!!alert.error('Height cannot be empty')
  	!this.setPitchGadget()
  	return
  elseif (!this.txPitchStrFlt.val.string().empty() ) then
  	!!alert.error('Pitch cannot be empty')
  	!this.setPitchGadget()
  	return
  elseif (!this.txExplicitDir.val.unset() )then
  	!!alert.error('Direction cannot be empty')
  	!this.setPitchGadget()
  	return
  else
  !height  =  !this.txHeightStrFlt.val
  !pitch   =  !this.txPitchStrFlt.val
  !dir     =  !this.txExplicitDir.val
  endif

  !vertDir    = DOWN
  -- find the opposite as we always see from the lwp
  if (!vertDir.eq(down)  ) then
   !dir      = !dir.opposite()
  endif

  !topPt     = !this.pickedUPosData.position

  !planeDist = !height / tan (!pitch )
  !lowPt     = !topPt.offset(!dir , !planeDist).offset(!vertDir , !height)

  !lowPosData          = object EDGPOSITIONDATA()
  !lowPosData.position = !lowPt

  -- do not lock position
  !this.lwp(!lowPosData)

endmethod

------------------------------------------------------------------------
--
-- Method:        storePickedPosData
--
-- Description:   stores the picked position data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .storePickedPosData(!posData is EDGPOSITIONDATA,!workPoint is STRING )

  !pickedPosition     = !posData.position.wrt(World)

  if(!workPoint.eq('LWP')) then
    !this.pickedLPosData         = !posData
    !this.pickedPositionData[1]  = !this.pickedLPosData

    -- Update pos control gadget
    !this.setPositionControl(!pickedPosition , !this.netLPosControl)

    if( !this.lwpAidNumber.set() ) then
      !!aidNumbers.hide(!this.lwpAidNumber)
    else
      !this.lwpAidNumber  = !!aidNumbers.add('LWP')
    endif
    AID TEXT  NUMBER $!<this.lwpAidNumber> 'LWP' AT $!pickedPosition

  elseif(!workPoint.eq('UWP')) then

    !this.pickedUPosData   = !posData
    !this.pickedPositionData[2]  = !this.pickedUPosData
    !this.setPositionControl(!pickedPosition , !this.netUPosControl)


    if( !this.uwpAidNumber.set() ) then
      !!aidNumbers.hide(!this.uwpAidNumber)
    else
      !this.uwpAidNumber  = !!aidNumbers.add('UWP')
    endif

    AID TEXT  NUMBER $!<this.uwpAidNumber> 'UWP' AT $!pickedPosition

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      storePosition
--
-- Description: stores the entered position
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .storePosition(!pickedPos is POSITION,!workPoint is STRING )

  if(!workPoint.eq('LWP') ) then

    !this.pickedLPosData.position    = !pickedPos

    if( !this.lwpAidNumber.set() ) then
      !!aidNumbers.hide(!this.lwpAidNumber)
    else
      !this.lwpAidNumber  = !!aidNumbers.add('LWP')
    endif
    AID TEXT  NUMBER $!<this.lwpAidNumber> 'LWP' AT $!pickedPos

  elseif(!workPoint.eq('UWP')) then

    !this.pickedUPosData.position   = !pickedPos

    if( !this.uwpAidNumber.set() ) then
      !!aidNumbers.hide(!this.uwpAidNumber)
    else
      !this.uwpAidNumber  = !!aidNumbers.add('UWP')
    endif
    AID TEXT  NUMBER $!<this.uwpAidNumber> 'UWP' AT $!pickedPos

   endif
endmethod

-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setPickedData
--
-- Description: sets after sorting the picked data to the object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPickedData(!lposData is EDGPOSITIONDATA, !uposData is EDGPOSITIONDATA)

  !positionData[1]  = !lposData
  !positionData[2]  = !uposData

  !elevationPosArray[1] = !lposData.position.up
  !elevationPosArray[2] = !uposData.position.up

  if(!lposData.position.up.gt(!uposData.position.up) ) then

    -- sort the position array using elevation
    !sortedIndices  = !elevationPosArray.sortedIndices()
    !positionData.reindex(!sortedIndices)

    !this.pickedLPosData  = !positionData[1]
    !this.pickedUPosData  = !positionData[2]

    -- update pos control gadgets
    !this.setPositionControl(!positionData[1].position , !this.netLPosControl)
    !this.setPositionControl(!positionData[2].position , !this.netUPosControl)

    if( !this.lwpAidNumber.set() ) then
      !!aidNumbers.hide(!this.lwpAidNumber)
    else
      !this.lwpAidNumber  = !!aidNumbers.add('LWP')
    endif
    AID TEXT  NUMBER $!<this.lwpAidNumber> 'LWP' AT $!positionData[1].position

    if( !this.uwpAidNumber.set() ) then
      !!aidNumbers.hide(!this.uwpAidNumber)
    else
      !this.uwpAidNumber  = !!aidNumbers.add('UWP')
    endif
    AID TEXT  NUMBER $!<this.uwpAidNumber> 'UWP' AT $!positionData[2].position

  endif

  -- set position data to object
  !this.strFltObj.setPickedPositionData(!positionData)

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:setNormalLength
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setNormalLength(!pickPoint is POSITION)

   if (!this.pickedLPosData.position.set() and !this.pickedUPosData.position.set() ) then
     !lpos = !this.pickedLPosData.position
     !upos = !this.pickedUPosData.position

     -- work out the normal direction to create the plane and project from midPoint
     !fltDir      = !this.strFltObj.getFlightDirection(!lpos , !upos)
     handle ANY
       return
     endhandle

     if (!this.txUtypeNorDirection.val.unset() ) then
       !normalDir   = !fltDir.cross(U)
     else
       !normalDir =  !this.txUtypeNorDirection.val
     endif

     !normalPlane = object PLANE(!pickPoint , z is $!normalDir )
     !normalPt    = !normalPlane.near(!lpos)
     !normalDir    = !lpos.direction(!normalPt)
     !normalDist   = !lpos.distance(!normalPt)

     !this.setPerpPlane(!normalDist, !normalDir)

     !this.txUtypeNorLength.val = !normalDist

  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:setPerpPlane
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPerpPlane(!normalLength is REAL , !planeDir is DIRECTION )

  if (!this.pickedLPosData.position.set() and !this.pickedUPosData.position.set() ) then

     !lpos = !this.pickedLPosData.position
     !upos = !this.pickedUPosData.position

     -- work out the normal direction to create the plane and project from midPoint
     !fltDir        = !this.strFltObj.getFlightDirection(!lpos , !upos)
     handle ANY
      return
     endhandle

     if (!planeDir.unset() ) then
       !plnDir = !fltDir.cross(U)
     else
       !plnDir = !planeDir
     endif

     !normalPoint    = !lpos.offset(!plnDir , !normalLength )
     !normalPlane    = object PLANE(!normalPoint , z is $!plnDir )

     !this.strFltObj.utypeNorPlane  = !normalPlane
     !this.strFltObj.utypeNorLength = !normalLength

     !this.clearVolFeedback()

     !this.strFltObj.showNormalPlane(!normalPlane)

      if (!this.strFltObj.flights.size().gt(0) ) then
        !this.tmpStrfltObj = !this.strFltObj
        if (!this.strFltObj.setDirection().not() ) then
          -- reset to the old object and plane when unable to evaluate
           !this.strFltObj = !this.tmpStrfltObj
           !normalPoint    = !lpos.offset(!this.strFltObj.flightLegs[1].fltDirection , !normalLength )
           !normalPlane    = object PLANE(!normalPoint , z is $!plnDir )
        endif

        !this.setGadgets(!this.strFltObj)

     endif
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:showNormalPlane
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showNormalPlane(!norPlane is PLANE)

 !this.strFltObj.showNormalPlane(!norPlane)

endmethod
------------------------------------------------------------------------
--
-- Method:setPitchGadget
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPitchGadget()

  !incLine = object LINE(!this.pickedLPosData.position , !this.pickedUPosData.position )

  -- set the direction in Plane gadget

  !inclDir                = !this.strFltObj.getFlightDirection(!this.pickedLPosData.position , !this.pickedUPosData.position )
   handle ANY
     !!alert.error('Lower and Upper points are in the Vertical Direction')
     return
   endhandle
  !this.txExplicitDir.val = !inclDir

  !height  = abs (!this.pickedUPosData.position.wrt(world).up -  !this.pickedLPosData.position.wrt(world).up)
  !this.txHeightStrFlt.val = !height

  !horizLine = !incLine
  !horizLine.endposition.up = !this.pickedLPosData.position.up
  !length     = !horizLine.length()
  !pitch       = atan (!height  / !length)

  !this.txPitchStrFlt.val = !pitch

endmethod
-- End of method definition

------------------------------------------------------------------------

--
-- Method:        createStrflt
--
-- Description:   creates the stair flight
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createStrflt()

  -- clear the aid
  !!aidNumbers.hide(!this.lwpAidNumber)
  !!aidNumbers.hide(!this.uwpAidNumber)
  !!aidNumbers.hide(!this.fltSegmentAidNumber)

  -- set name in stair flight object
  !name = !this.txName.val.trim()
  if(!name neq '') then
    if(!name.substring(1,1) eq '/' ) then
      !name = !name.substring(2)
    endif
    !this.strFltObj.name  = !name
  endif

  -- Mark the database to Undo the creation of stair flight
  !undo = object UNDOABLE()
  !undo.description('Create Stair Flight')
  !undo.undoAction('!!aslStrFlt.mainPane()')
  !undo.add()

  -- create the stair flight element
  !this.strFltObj.dbWrite(!this.strfltOwner)
  handle ANY
  	return
  endhandle	

  -- set attributes for stair flight
  !this.strflt  = !this.strFltObj.refe

  !desc = !this.txDesc.val.trim()
  if(!desc neq '') then
    !this.strflt.desc  = !desc
  endif

  -- store the installation option
  !this.strflt.instOptions = !this.flightConfiguration
  handle ANY
  endhandle

  !area = !this.dbArea.val
  if(!area.neq(0)) then
    !this.strflt.area  = !area
  endif

  !numb = !this.dbNumber.val
  if(!numb.neq(0)) then
    !this.strflt.number  = !numb
  endif

  -- set the ASL Standard and SubStandard attribute
  !settingReference = !this.strFltObj.settingReference
  !currentSetting = !!aslCentralData.getSetting(!settingReference)

  !standard = !currentSetting.settingData[1]
  !standardName = !standard.value
  !this.strflt.aslStandard  = object DBREF('/' + !standardName)

  !subStandard = !currentSetting.settingData[2]
  !subStandardName = !subStandard.value
  !this.strflt.aslSbStandard  = object DBREF('/' + !subStandardName)

  -- set the Stair flight template reference to "assTmpReference" attribute
  !this.strflt.assTmpReference  = !this.strFltObj.tmplReference

  !undo.endUndoable()

 -- clear graphical aid created for stair flight
  !this.clearVolFeedback()

  -- set the form title and gadgets for Modify mode
  !this.setStrfltPaneGadgets(false)

  !this.currentMode = 'MODIFY'
  !this.formTitle   = 'Modify Stair Flight'
  !this.lkStrfltPaneEvaluate.tag    = 'Re-evaluate Stair Flight'

  -- make the installation options inactive
  do !toggle values !this.installationOptions
    !toggle.active = false
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      createStrfltPane
--
-- Description: setup new Stair flight object and display main modification panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Operation mode - "init" to initialize object and show panel or "show" to show panel only (can be any string
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createStrfltPane(!mode is STRING)

  !this.currentMode = 'CREATE'

  -- remove edg packet from stack first
  !this.clearEdgStack()

  if !mode.lowcase().eq('init') then

    -- check if storage area is set for stair flight
    if(!!aslStoreTable.getStore('stairflight').badref().not()) then
      !strfltOwner = !!aslStoreTable.getStore('stairflight')

    else
      !strfltOwner  = !this.getStrfltOwnerFrom(!!ce)
      if !strfltOwner.unset() then
        -- invalid reference passed. return error
        !!alert.warning('Invalid hierarchy to create STRFLT.')
        return

      -- Check the write access of the DB
      elseif(!!dbrefUpdate(!strfltOwner).not())then
        !!alert.error(!!error.text)
        return
      endif
    endif

    !this.strfltOwner = !strfltOwner

    -- initialise Stair flight object
    !this.strFltObj = object DBEASLSTRFLT(!!aslCentralData.currSetting.description)
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle

    !this.strFltObj.position    = !this.strfltOwner.position
    !this.strFltObj.orientation = !this.strfltOwner.orientation

    !this.flightConfiguration = ''

    -- set gadget values from criteria
    !this.setDefaultValues()

    !this.lkStrfltPaneEvaluate.tag    = 'Evaluate Stair Flight'

  elseif !mode.lowcase().eq('back') then
    !strfltOwner  = !this.getStrfltOwnerFrom(!!ce)
    if !strfltOwner.unset() then
      -- invalid reference passed - return error
      !!alert.warning('Invalid hierarchy to create STRFLT.')
      return
    else
      !this.strfltOwner = !strfltOwner
    endif

  endif

  -- set gadgets
  !this.setStrfltPaneGadgets(true)

  -- set form title
  !this.formTitle = 'Create Stair Flight'

  -- show panel
  !this.showPanel(!this.strfltPane)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deleteStrflt
--
-- Description: delete Strflt
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteStrflt()

  -- check if you are at STRFLT element or below
  !!ce = STRFLT
  handle ANY
    !!alert.warning('Not below STRFLT hierarchy')
    return
  endhandle

  call !!aslEnhance(!!ce)
  if ( !!alert.confirm('Do you really want to delete the current Stair Flight?').eq('NO') ) then
    call !!aslUnEnhance(!!ce)
    !this.clearVolFeedback()
    return
  endif

  -- Mark the database to Undo the deletion of stair flight
  !undo = object UNDOABLE()
  !undo.description('Delete Strflt')
  !undo.add()

  DELETE STRFLT

  !undo.endUndoable()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      setStrfltPaneGadgets
--
-- Description: set active/visible status of gadgets of create/modify Strflt panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     create status (create = TRUE,  modify = FALSE)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setStrfltPaneGadgets(!createStatus is BOOLEAN)

  -- initialise
  !modifyStatus = !createStatus.not()

  -- set visibility of executable buttons
  !this.paStrfltPaneCreateIcon.visible  = !createStatus
  !this.lkStrfltPaneCreate.visible      = !createStatus
  !this.paStrfltPaneAcceptIcon.visible  = !modifyStatus
  !this.lkStrfltPaneAccept.visible      = !modifyStatus

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: set active/visible status of gadgets of create/modify Strflt panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     create status (create = TRUE,  modify = FALSE)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setModGoingPaneGadgets(!status is BOOLEAN)

  -- set visibility of executable buttons

  !this.buLExtension.active       = !status
  !this.buUExtension.active       = !status
  !this.buLowerLndgLength.active  = !status
  !this.buUpperLndgLength.active  = !status

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:
--
-- Description: set active/visible status of gadgets of dimension Gadgets in Detailed attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     create status (create = TRUE,  modify = FALSE)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDimFeedBackGadgets()

if (!this.strFltObj.flights.size().gt(0) ) then
  !status = true
else
  !status = false
endif

  -- set visibility of executable buttons
!this.toAidLength.active           = !status
!this.toAidHeight.active           = !status
!this.toAidWidth.active            = !status
!this.toAidFltThickness.active     = !status
!this.toAidHeadRoom.active         = !status
!this.toAidRise.active             = !status
!this.toAidLRise.active            = !status
!this.toAidLExtension.active       = !status
!this.toAidUExtension.active       = !status

!this.toAidLowerLndgLength.active  = !status
!this.toAidUpperLndgLength.active  = !status
!this.toAidOGoing.active           = !status
!this.toAidORise.active            = !status
!this.toAidGoing.active            = !status
!this.toAidPitch.active            = !status

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      strflt
--
-- Description: assign stair flight object to the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW]        [Data Type]   [Description]
--    1   RW            DBEASLSTRFLT   strflt object
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strflt(!strFltObj is DBEASLSTRFLT)

  !strFltObj.autoDraw = true
  !strFltObj.undoable = true

  -- undo callback must be declared in fullname format (not using this shortcut) as it will be called externally
  !strFltObj.undoCall = '!!aslStrFlt.undo(''$!strFltObj.refe'')'

  !this.strFltObj     = !strFltObj

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        setGadgets
--
-- Description:   set the gadgets of General attributes directly from the DB Element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setGenAttGadgets()

  -- General attributes
  if(!this.currentMode.upcase().eq('MODIFY')) then
    !strfltRef                = !this.strFltObj.refe
    if(!this.strFltObj.name.set()) then
      !this.txName.val  = !this.strFltObj.name
    endif

    if(!strfltRef.desc.set()) then
      !this.txDesc.val  = !strfltRef.desc
    endif

    !this.dbArea.val          = !strfltRef.area
    !this.dbNumber.val        = !strfltRef.number

    !this.flightConfiguration = !strfltRef.instOptions
    handle ANY
    endhandle
  endif

  endmethod
------------------------------------------------------------------------
--
-- Method:        setGadgets
--
-- Description:   set the gadgets with values from the object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setGadgets(!strFltObj is DBEASLSTRFLT)

  -- update form gadgets from Stair flight object
  -- Position gadgets
  if(!this.strFltObj.rpath.vertex.set()) then
    !lowerPoint = !strFltObj.rpath.vertex.first()
    !upperPoint = !strFltObj.rpath.vertex.last()
  else
    !lowerPoint  = object POSITION('E0 N0 U0')
    !upperPoint  = object POSITION('E0 N0 U0')
  endif

  if (!strFltObj.lowLandingOffset.neq(0) ) then
    !this.opSurfLevelLWP.select('RTEXT' , 'Above')

    if (!strFltObj.lowLandingOffset.lt(0))   then
      !this.opSurfJustLWP.select('RTEXT' , 'FFL')
    else
      !this.opSurfJustLWP.select('RTEXT' , 'TOS')
    endif

  else
    !this.opSurfLevelLWP.select('RTEXT' , 'Flush')
    !this.opSurfJustLWP.select('RTEXT' , 'FFL')
  endif

  if (!strFltObj.upLandingOffset.neq(0) ) then
    !this.opSurfLevelUWP.select('RTEXT' , 'Above')

    if (!strFltObj.upLandingOffset.lt(0))   then
      !this.opSurfJustUWP.select('RTEXT' , 'FFL')
    else
      !this.opSurfJustUWP.select('RTEXT' , 'TOS')
    endif

  else
    !this.opSurfLevelUWP.select('RTEXT' , 'Flush')
    !this.opSurfJustUWP.select('RTEXT' , 'FFL')
  endif

  !this.txLandingThickness.val = !strFltObj.landingThickness

  !this.setPositionControl(!lowerPoint , !this.netLPosControl)
  !this.storePosition(!lowerPoint,'LWP')

  !this.setPositionControl(!upperPoint , !this.netUPosControl)
  !this.storePosition(!upperPoint,'UWP')

  if(!this.currentMode.upcase().eq('MODIFY')) then
    !this.setPickedData(!this.pickedLPosData,!this.pickedUPosData)
  endif

  if (!strFltObj.flightLegs.size().gt(1) ) then
      !this.toClockwiseStrFlt.active     = true
      !this.toAntiClockwiseStrFlt.active = true
      if ( !strFltObj.sense ) then
        !this.toClockwiseStrFlt.val = TRUE
        !this.toAntiClockwiseStrFlt.val = FALSE
      else
        !this.toClockwiseStrFlt.val = FALSE
        !this.toAntiClockwiseStrFlt.val = TRUE
      endif
  else
        !this.toClockwiseStrFlt.active     = false
        !this.toAntiClockwiseStrFlt.active = false
      !this.toClockwiseStrFlt.val = FALSE
      !this.toAntiClockwiseStrFlt.val = FALSE
  endif

  if (!strFltObj.flightLegs.size().eq(3) )  then
     !this.txUtypeNorLength.val = !strFltObj.utypeNorLength
     !this.txUtypeNorDirection.val = !strFltObj.flightLegs[1].fltDirection
  endif

  -- set the Stair flight template reference
  !strfltTmplRef  = !this.strFltObj.getStrfltTmplReference()
  if(!strfltTmplRef.set()) then
    !strfltTmplRefName  = !strfltTmplRef.refno.string()
    !this.opStrfltTmplReference.select('RTEXT',!strfltTmplRefName)
    handle ANY
      -- selection text not in the list
    endhandle
  endif

  -- set the handrail template reference
  !handrailTmplRef  = !this.strFltObj.getHandrailTmplReference()
  if(!handrailTmplRef.set()) then
    !handrailTmplRefName  = !handrailTmplRef.refno.string()
    !this.opHandraTmplReference.select('RTEXT',!handrailTmplRefName)
     handle ANY
       -- selection text not in the list
    endhandle
  endif

  -- display the side of the handrail
  !this.opHandraSide.select('RTEXT' , !this.strFltObj.handRailOption)

  -- Detailed attributes
  !this.txLength.val        = !strFltObj.oGoing
  !this.txHeight.val        = !strFltObj.oRise
  !this.txWidth.val         = !strFltObj.width
  !this.txFthickness.val    = !strFltObj.fThickness
  !this.txHeadRoom.val      = !strFltObj.headRoom
  !this.txLExtension.val    = !strFltObj.lExtension
  !this.txUExtension.val    = !strFltObj.uExtension

  -- Detailed Segment attributes
  !this.txLowerLndgLength.val     = 0
  !this.txUpperLndgLength.val     = 0
  !this.txOgoing.val        = !strFltObj.oGoing
  !this.txOrise.val         = !strFltObj.oRise
  !this.txGoing.val         = !strFltObj.going
  !this.txRise.val          = !strFltObj.rise
  !this.txLRise.val         = !strFltObj.lRise
  !this.txPitch.val         = !strFltObj.pitch
  !this.txTreadCnt.val    = !strFltObj.numberOfSteps

  -- initialise the segment counter gadgets with segment index 1
  if(!strFltObj.flights.set()) then
   if(!strFltObj.flights.size().eq(1) )  then
      !numberOfFlights  = 1
    else
      !numberOfFlights  = !strFltObj.flights.size()
    endif

    !range[1] = 1
    !range[2] = !numberOfFlights
    !range[3] = 1
    !this.nuSegmentStrflt.range = !range
    handle ANY
      -- range not defined properly. range cannot be from 1 to 1.
    endhandle

    !this.nuSegmentStrflt.val = 1
    !this.paSegmentStrflt.val = ' of $!numberOfFlights'
    !this.nuSegmentStrflt.active          = true
    !this.nuSegmentStrflt.modifiedEvents  = true
  else
    !this.txLndgElevation.active      = false

  endif

 -- activate/deactivate the dim aid toggles
 !this.setDimFeedBackGadgets()

  -- Set flight segment attributes
  if (!this.strFltObj.flights.size().gt(0) ) then
  !this.setSegmentAttributes(1)
   !this.txLndgElevation.active      = true
   !this.lkPickLndgElevation.active  = true
  else
   !this.txLndgElevation.active      = false
   !this.lkPickLndgElevation.active  = true
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        setFlightAttributes
--
-- Description:   sets the common detail attributes in the gadgets
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setFlightGadgets( )

  !strFltObj                = !this.strFltObj

  !this.txLength.val        = !strFltObj.oGoing
  !this.txHeight.val        = !strFltObj.oRise

  !this.txWidth.val         = !strFltObj.width
  !this.txFthickness.val    = !strFltObj.fThickness
  !this.txHeadRoom.val      = !strFltObj.headRoom
  !this.txLExtension.val    = !strFltObj.lExtension
  !this.txUExtension.val    = !strFltObj.uExtension

    -- Set flight segment attributes
  !this.setSegmentAttributes(1)

endmethod
------------------------------------------------------------------------
--
-- Method:        setSegmentAttributes
--
-- Description:   sets the segment attributes in the gadgets based on selected segment
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSegmentAttributes(!segmentIndex is REAL )

  !flight = !this.strFltObj.flights[!segmentIndex]

  -- Detailed Segment attributes
  !this.txLndgElevation.val       = !flight.uwp.up
  !this.txLowerLndgLength.val     = !flight.lLndgLength
  !this.txUpperLndgLength.val     = !flight.uLndgLength
  !this.txOgoing.val              = !flight.oGoing
  !this.txOrise.val               = !flight.oRise
  !this.txPitch.val               = !flight.pitch
  !this.txTreadCnt.val          = !flight.numOfTreads

  if(!this.strFltObj.flights.size().eq(!segmentIndex)) then
    !this.txLndgElevation.active      = false
    !this.lkPickLndgElevation.active  = false
  else
    !this.txLndgElevation.active      = true
    !this.lkPickLndgElevation.active  = true
  endif

  !this.txTreadCnt.active = true
  !fltsInLegCnt = 0
  do !fltInx indices  !this.strFltObj.flightLegs
     !fltsInLegCnt =  !fltsInLegCnt +  !this.strFltObj.flightLegs[!fltInx].numOfFlights
     if (!fltsInLegCnt.eq(!segmentIndex) )  then
        !this.txTreadCnt.active = false
        break
     elseif (!fltsInLegCnt.gt(!segmentIndex) )  then
        break
     endif
  enddo

  -- add graphical aid for flight segments
  !lwp      = !flight.lwp
  !uwp      = !flight.uwp
  !dir      = !lwp.direction(!uwp)
  !textDist = 0.5 * !lwp.distance(!uwp)
  !textPos  = !lwp.offset(!dir,!textDist)

  if(!this.fltSegmentAidNumber.set()) then
    !!aidNumbers.hide(!this.fltSegmentAidNumber)
  else
    !this.fltSegmentAidNumber  = !!aidNumbers.add('ASL Flight Segment Details')
  endif
  AID text NUMBER $!<this.fltSegmentAidNumber> 'Flight $!<segmentIndex>' at $!textPos

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateFrameSegment
--
-- Description: update the gadgets for segment attributes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrameSegment(!dummyGadget is GADGET, !dummyAction is STRING)

 !segmentIndex  = !this.nuSegmentStrflt.val

 if(!segmentIndex.eq(0)) then
  !this.nuSegmentStrflt.val = 1
 else
  !this.setSegmentAttributes(!segmentIndex)
 endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rpath
--
-- Description: get rpath from owned Strflt object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ASLRPATH    rpath owned by Strflt
--
------------------------------------------------------------------------

define method .rpath() is ASLRPATH

  return !this.strFltObj.rpath

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showDimFeedback
--
-- Description: display dimension feedback for stair flight attributes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimFeedback(!gadget is GADGET, !action is STRING)

  if (!this.strFltObj.flights.size().eq(0) ) then
    return
  endif

  -- first remove all dimension
  !!aslCentralData.clearDimFeedback()
  !aidDim         = !!aslCentralData.aidDim

  !this.strfltDim.length        = !this.toAidLength.val
  !this.strfltDim.height        = !this.toAidHeight.val
  !this.strfltDim.width         = !this.toAidWidth.val
  !this.strfltDim.fThickness    = !this.toAidFltThickness.val
  !this.strfltDim.headRoom      = !this.toAidHeadRoom.val
  !this.strfltDim.rise          = !this.toAidRise.val
  !this.strfltDim.lRise         = !this.toAidLRise.val
  !this.strfltDim.lExtension    = !this.toAidLExtension.val
  !this.strfltDim.uExtension    = !this.toAidUExtension.val

  !this.strfltDim.lLndgLength   = !this.toAidLowerLndgLength.val
  !this.strfltDim.uLndgLength   = !this.toAidUpperLndgLength.val
  !this.strfltDim.oGoing        = !this.toAidOGoing.val
  !this.strfltDim.oRise         = !this.toAidORise.val
  !this.strfltDim.going         = !this.toAidGoing.val
  !this.strfltDim.pitch         = !this.toAidPitch.val

  -- get information about the stair flight
  !strFltObj      = !this.strFltObj
  !strfltDim      = !this.strfltDim

  !segmentIndx = !this.nuSegmentStrflt.val
  !fltSegmentData = !strFltObj.flights[!segmentIndx]
  !fltDirection   = !fltSegmentData.fltDirection

  -- get direction of the stair flight
  !centreLine     = object LINE(!strFltObj.flights[!segmentIndx].lwp, !strFltObj.flights[!segmentIndx].uwp)
  !orthoDir       = !centreLine.direction().orthogonal(U)

  if ( !strfltDim.length ) then
    !this.showDimFeedbackLength()
  endif

  -- Stair flight attributes
  if ( !strfltDim.height ) then
    !this.showDimFeedbackHeight()
  endif

  if ( !strfltDim.width ) then
    !label      = 'Width = ' &  object STRING ( !strFltObj.width , !!distanceFmt)

    !halfPos    = !centreLine.proportion(0.5)
    !halfWidth  = !strFltObj.width / 2

    -- define the border positions
    !fPosition  = !halfPos.offset(!orthoDir, !halfWidth)
    !sPosition  = !halfPos.offset(!orthoDir.opposite(), !halfWidth)
    !dimObj     = object DISPLAYDIMENSION(!label, UP, !fPosition, !sPosition, 1000mm, !aidDim)
  endif

  if ( !strfltDim.fThickness ) then
    !label      = 'Flight thickness = ' & object STRING ( !strFltObj.fThickness , !!distanceFmt)
    !dimPos1    = !centreLine.proportion(0.7)
    !dimDir     = !centreLine.direction().orthogonal(!orthoDir)
    !dimPos2    = !dimPos1.offset(!dimDir, !strFltObj.fThickness)
    !dimObj     = object DISPLAYDIMENSION(!label, !orthoDir, !dimPos1, !dimPos2, 800mm, !aidDim)
  endif

  if ( !strfltDim.headRoom ) then
    !label    = 'Head Room = ' & object STRING ( !strFltObj.headRoom , !!distanceFmt)
    !fPos     = !strFltObj.uwp.offset(UP, !strFltObj.headRoom)
    !dimObj   = object DISPLAYDIMENSION(!label, !fltDirection, !strFltObj.uwp, !fPos, 800mm, !aidDim)
  endif

  if ( !strfltDim.rise ) then
    !label     = 'Rise = ' &  object STRING ( !strFltObj.rise , !!distanceFmt)
    !tempPos   = !strFltObj.lwp.offset(UP, !strFltObj.rise)
    !fPosTread = !tempPos.offset(!fltDirection, 2 * !strFltObj.going)
    !tempPos   = !fPosTread.offset(!fltDirection, !strFltObj.going)
    !sPosTread = !tempPos.offset(UP, !strFltObj.rise)
    !dimObj    = object DISPLAYDIMENSION(!label, !fltDirection, !fPosTread, !sPosTread, 400mm, !aidDim)
  endif

  if ( !strfltDim.lRise ) then
    !label     = 'Lower Rise = ' & object STRING ( !strFltObj.lRise , !!distanceFmt)
    !fPosTread = !strFltObj.lwp.offset(!fltDirection, !strFltObj.lRise)
    !tempPos   = !fPosTread.offset(!fltDirection, !strFltObj.going)
    !sPosTread = !tempPos.offset(UP, !strFltObj.lRise)
    !dimObj    = object DISPLAYDIMENSION(!label, !fltDirection, !fPosTread, !sPosTread, 400mm, !aidDim)
  endif

  if ( !strfltDim.lExtension ) then
    !label    = 'Lower Extension = ' & object STRING ( !strFltObj.lExtension , !!distanceFmt)
    !sPosition  = !strFltObj.lwp.offset(!strFltObj.flights[1].lLndgDir , !strFltObj.flights[1].lLndgLength)
    !fPosition  = !sPosition.offset(!strFltObj.lExtnDirection,!strFltObj.lExtension)
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !fPosition, !sPosition, 1200mm, !aidDim)
  endif

  if ( !strfltDim.uExtension ) then
    !label    = 'Upper Extension = ' & object STRING (!strFltObj.uExtension , !!distanceFmt)
    !fPosition  = !strFltObj.uwp.offset(!strFltObj.flights.last().uLndgDir , !strFltObj.flights.last().uLndgLength)
    !sPosition  = !fPosition.offset(!strFltObj.uExtnDirection,!strFltObj.uExtension)
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !fPosition, !sPosition, 1200mm, !aidDim)
  endif

  -- Flight Segment attributes
  if ( !strfltDim.lLndgLength ) then
    !label    = 'Lower Landing Length = ' &  object STRING (!fltSegmentData.lLndgLength , !!distanceFmt)
    !fPosition  = !fltSegmentData.lwp
    !sPosition  = !fPosition.offset(!fltSegmentData.lLndgDir,!fltSegmentData.lLndgLength)
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !fPosition, !sPosition, 400mm, !aidDim)
  endif

  if ( !strfltDim.uLndgLength ) then
    !label    = 'Upper Landing Length = ' &  object STRING (!fltSegmentData.uLndgLength , !!distanceFmt)
    !fPosition  = !fltSegmentData.uwp
    !sPosition  = !fPosition.offset(!fltSegmentData.uLndgDir,!fltSegmentData.uLndgLength)
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !fPosition, !sPosition, 1200mm, !aidDim)
  endif

  if ( !strfltDim.oGoing ) then
    !label    = 'Overall Going = ' &  object STRING (!strFltObj.oGoing , !!distanceFmt)
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !fltSegmentData.lwp, !fltSegmentData.uwp, 1000mm, !aidDim)
  endif

  if ( !strfltDim.oRise ) then
    !label    = 'Overall Rise = ' &  object STRING (!strFltObj.oRise , !!distanceFmt)
    !this.showLinearDimension(!aidDim,!label, !fltDirection, !fltSegmentData.lwp, !fltSegmentData.uwp, 800mm, 0.05, 'HEI')
  endif

  if ( !strfltDim.going ) then
    !label    = 'Going = ' &  object STRING (!strFltObj.going , !!distanceFmt)
    !tempPos   = !fltSegmentData.lwp.offset(UP, !strFltObj.lRise)
    !fPosTread = !tempPos.offset(!fltDirection, !strFltObj.going)
    !tempPos   = !fPosTread.offset(!fltDirection, !strFltObj.going)
    !sPosTread = !tempPos.offset(UP, !strFltObj.rise)
    !dimObj    = object DISPLAYDIMENSION(!label, UP, !fPosTread, !sPosTread, 400mm, !aidDim)
  endif

  if ( !strfltDim.pitch ) then
    !label    = 'Angle = ' &  object STRING (!fltSegmentData.pitch , !!realFmt) & ' deg'

    -- angle is defined by three positions - get the missing one
    !horiPos  = !fltSegmentData.lwp.offset(!fltDirection, !fltSegmentData.oGoing)
    !radius   = !fltSegmentData.oGoing
    !dimObj   = object DISPLAYDIMENSION(!label, !fltSegmentData.lwp, !horiPos, !fltSegmentData.uwp, !radius, !aidDim)
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      showDimFeedbackLength
--
-- Description: create and show linear dimension of overall length
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .showDimFeedbackLength()

  !posFmt    = !!distanceFmt
  !posFmt.dp = 0

  !this.strfltDim.length  = !this.toAidLength.val

  -- get information about the stair flight
  !strFltObj        = !this.strFltObj
  !strfltDim        = !this.strfltDim

  if ( !strfltDim.length.eq(true) and !strFltObj.flights.size().gt(0) ) then
    !profile        = !this.strFltObj.rpath.profile(false)
    !lineEdges      = !profile.edges()

    !j              = 0
    !distance       = 0
    !distArray      = object ARRAY()
    !lineArray      = object ARRAY()
    !directionArray = object ARRAY()

    do !i from 1 to !lineEdges.size()
      break if ( !i.eq(!lineEdges.size() ) )
      !j = !i + 1
      if ( !lineEdges[!i].direction().eq(!lineEdges[!j].direction()) ) then
         !distance  = !distance + !lineEdges[!i].length()
      elseif ( !lineEdges[!i].direction().neq(!lineEdges[!j].direction()) ) then
         !distance  = !distance + !lineEdges[!i].length()
         !distArray.append(!distance)
         !directionArray.append( !lineEdges[!i].startposition.direction(!lineEdges[!i].endposition))
         !distance = 0
      endif
    enddo

    !distance = !distance + !lineEdges.last().length()
    !distArray.append(!distance)
    !directionArray.append( !lineEdges[!i].startposition.direction(!lineEdges[!i].endposition))

    do !i indices !distArray
      if ( !i.eq(1) ) then
        !line               = object LINE()
        !line.startposition = !lineEdges.first().startposition.offset(D, 500mm)
        !line.endposition   = !line.startposition.offset( !directionArray[!i], !distArray[!i])
        !lineArray.append(!line)
      else
      !j = !i - 1
        !line               = object LINE()
        !line.startposition = !lineArray[!j].endposition
        !line.endposition   = !line.startposition.offset( !directionArray[!i], !distArray[!i])
        !lineArray.append(!line)
      endif
    enddo

    !pos               = !lineEdges.first().startposition.offset(D, 500mm)
    !direction         = !directionArray.first()
    !ori               = y is $!direction

    !profile = object PROFILE(!pos, !ori, !lineArray)
    !profile.draw(!!aslCentralData.aidDim, !!aslCentralData.lineStyleSolidThick  ,!!aslCentralData.colourCL)


    --Draw the extension for arrow line
    !line = object LINE()
    !line.startposition = !lineArray.first().startposition
    !line.endposition   = !line.startposition.offset( U, 500mm )
    !line.draw(!!aslCentralData.aidDim, !!aslCentralData.lineStyleSolidThick  ,!!aslCentralData.colourCL)

    !line = object LINE()
    !line.startposition = !lineArray.last().endposition
    !line.endposition   = !line.startposition.offset( U, !strFltObj.oRise).offset( U, 500mm )
    !line.draw(!!aslCentralData.aidDim, !!aslCentralData.lineStyleSolidThick  ,!!aslCentralData.colourCL)


    --draw the leg length
    do !i from 1 to !lineArray.size()
      !midPoint       = !lineArray[!i].startposition.midPoint(!lineArray[!i].endposition)
      !text           = 'Leg Length =' & ' ' & object STRING (  !distArray[!i] , !!distanceFmt)
       AID TEXT   NUMBER $!!<aslCentralData.aidDim> |$!text| AT $!midPoint
    enddo

    --display the overall length
    !point            = !lineArray.first().endposition
    --get the overall length
    !overallLength    = 0
    do !legLength values !distArray
      !overallLength  = !overallLength + !legLength
    enddo
    !text             = 'Overall Length = ' & object STRING (  !overallLength , !!distanceFmt)
     AID TEXT NUMBER $!!<aslCentralData.aidDim> |$!text| AT $!point

    --Creating the AID Arrow
    !aidArrowPos1       = !lineArray.first().startposition.offset( !directionArray.first(), ( 0.20 * !distArray.first() ) )
    !aidArrowDirection1 = !directionArray.first().opposite()
    !aidArrowHei1       = !distArray.first()
    AID arrow number $!!<aslCentralData.aidDim> at $!aidArrowPos1 dir $!aidArrowDirection1 hei ( 0.20 * $!aidArrowHei1 )

    !aidArrowPos2       = !lineArray.last().endposition.offset( !directionArray.last().opposite(), ( 0.20 * !distArray.last() ) )
    !aidArrowDirection2 = !directionArray.last()
    !aidArrowHei2       = !distArray.last()
     AID arrow number $!!<aslCentralData.aidDim> at $!aidArrowPos2 dir $!aidArrowDirection2 hei ( 0.20 * $!aidArrowHei2 )

    --draw the AID sphere
    do !i indices  !lineArray
      break if ( !i.eq(!lineArray.size() ) )
      !linePos = !lineArray[!i]
      AID SPHERE NUMBER $!!<aslCentralData.aidDim> $!linePos.endposition DIAM ( 0.05 * $!aidArrowHei1 )
    enddo
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      showDimFeedbackHeight
--
-- Description: create and show linear dimension of overall length
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .showDimFeedbackHeight()

  !posFmt    = !!distanceFmt
  !posFmt.dp = 0

  !this.strfltDim.height  = !this.toAidHeight.val

  -- get information about the stair flight
  !strFltObj        = !this.strFltObj
  !strfltDim        = !this.strfltDim

  if ( !strfltDim.height.eq(true) and !strFltObj.flights.size().gt(0) ) then
  	
    !profile        = !this.strFltObj.rpath.profile(false)
    !lineEdges      = !profile.edges()

    !j              = 0
    !distance       = 0
    !distArray      = object ARRAY()
    !lineArray      = object ARRAY()
    !directionArray = object ARRAY()

    do !i from 1 to !lineEdges.size()
      break if ( !i.eq(!lineEdges.size() ) )
      !j = !i + 1

      if ( !lineEdges[!i].direction().eq(!lineEdges[!j].direction()) ) then
         !distance  = !distance + !lineEdges[!i].length()
      elseif ( !lineEdges[!i].direction().neq(!lineEdges[!j].direction()) ) then
         !distance  = !distance + !lineEdges[!i].length()
         !distArray.append(!distance)
         !directionArray.append( !lineEdges[!i].startposition.direction(!lineEdges[!i].endposition))
         !distance = 0
      endif

    enddo

    !distance = !distance + !lineEdges.last().length()
    !distArray.append(!distance)
    !directionArray.append( !lineEdges[!i].startposition.direction(!lineEdges[!i].endposition))

    do !i indices !distArray
      if ( !i.eq(1) ) then
        !line               = object LINE()
        !line.startposition = !lineEdges.first().startposition.offset(D, 500mm)
        !line.endposition   = !line.startposition.offset( !directionArray[!i], !distArray[!i])
        !lineArray.append(!line)
      else
      !j = !i - 1
        !line               = object LINE()
        !line.startposition = !lineArray[!j].endposition
        !line.endposition   = !line.startposition.offset( !directionArray[!i], !distArray[!i])
        !lineArray.append(!line)
      endif
    enddo

    !pos               = !lineEdges.first().startposition.offset(D, 500mm)
    !direction         = !directionArray.first()
    !ori               = y is $!direction

    !profile = object PROFILE(!pos, !ori, !lineArray)
    !profile.draw(!!aslCentralData.aidDim, !!aslCentralData.lineStyleSolidThick  ,!!aslCentralData.colourCL)


    --Draw the extension for arrow line
    !line = object LINE()
    !line.startposition = !lineArray.first().startposition
    !line.endposition   = !line.startposition.offset( U, 500mm )
    !line.draw(!!aslCentralData.aidDim, !!aslCentralData.lineStyleSolidThick  ,!!aslCentralData.colourCL)

    !line = object LINE()
    !line.startposition = !lineArray.last().endposition
    !line.endposition   = !line.startposition.offset( U, !strFltObj.oRise).offset( U, 500mm )
    !line.draw(!!aslCentralData.aidDim, !!aslCentralData.lineStyleSolidThick  ,!!aslCentralData.colourCL)

    --display the overall height
    !line = object LINE()
    !line.startposition = !lineArray.last().endposition
    !line.endposition   = !line.startposition.offset( U, !strFltObj.oRise).offset( U, 500mm )

    --Creating the AID Arrow
    !aidArrowPos1       = !line.startposition.offset( U, ( 0.10 * !distArray.first() ) )
    !aidArrowDirection1 = DOWN
    !aidArrowHei1       = !distArray.first()
    !line.draw(!!aslCentralData.aidDim, !!aslCentralData.lineStyleSolidThick  ,!!aslCentralData.colourCL)

    !aidArrowPos2       = !line.endposition.offset( D, ( 0.10 * !distArray.last() ) )
    !aidArrowDirection2 = UP
    !aidArrowHei2       = !distArray.last()
    AID arrow number $!!<aslCentralData.aidDim> at $!aidArrowPos2 dir $!aidArrowDirection2 hei ( 0.10 * $!aidArrowHei2 )

    !point              = !line.startposition.midPoint(!line.endposition)
    !overallHeight      = !strFltObj.oRise
    !text               = |Overall Height = | &   object STRING( !overallHeight , !!distanceFmt)
    AID TEXT NUMBER $!!<aslCentralData.aidDim> |$!text| AT $!point

    --draw the AID sphere
    do !i indices  !lineArray
      break if ( !i.eq(!lineArray.size() ) )
      !linePos = !lineArray[!i]
      AID SPHERE NUMBER $!!<aslCentralData.aidDim> $!linePos.endposition DIAM ( 0.025 * $!aidArrowHei1 )
    enddo
  endif
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      showLinearDimension
--
-- Description: create and show linear dimension
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showLinearDimension(!aidNumber is REAL, !label is STRING, !direction is DIRECTION, !fPosition is POSITION, !sPosition is POSITION, !height is REAL, !proportion is REAL,!dimAtt is STRING )

  -- create plane through start position orthogonal to the direction of aid lines
  !plane1 = object PLANE(!fPosition, object ORIENTATION('Z IS ' & !direction.string()))

  -- define the projection of the end position on the plane
  !pos2OnPlane1 = !plane1.near(!sPosition)
  -- get the distance between this plane and the end position
  !distance     = !pos2OnPlane1.distance(!sPosition)

  -- define aid line positions by adding the desired height of dimension to the given positions
  !posHelp1 = !fPosition.offset(!direction, !height)
  !posHelp2 = !sPosition.offset(!direction, !height)

  -- add the distance calculated above to the 'lower' position
  if ( !distance.gt(1) ) then
    !line = object LINE(!fPosition, !fPosition.offset(!direction, 2 * !distance))
    if ( !line.onProjected(!sPosition) ) then
      !posHelp1 = !posHelp1.offset(!direction, !distance)
    else
      !posHelp2 = !posHelp2.offset(!direction, !distance)
    endif
  endif

  -- to extend aid lines define two additional positions
  !posHelp3  = !posHelp1.offset(!direction, 50)
  !posHelp4  = !posHelp2.offset(!direction, 50)

  -- use them to define the label position
  if(!dimAtt.eq('HEI') ) then
    !posText   = !posHelp4.midPoint(!sPosition)
  else
    !posText   = !posHelp3.midPoint(!posHelp4)
  endif

  -- define the parameter of the arrows - two become one
  !posArrow  = !posHelp1.midPoint(!posHelp2)
  !lenArrow  = !posHelp1.distance(!posArrow)
  if ( !lenArrow.gt(1) ) then
    !dirArrow1 = !posArrow.direction(!posHelp1)
    !dirArrow2 = !posArrow.direction(!posHelp2)
  endif

  -- draw the dimension
  AID LINE  NUMB $!aidNumber $!fPosition TO $!posHelp3
  AID LINE  NUMB $!aidNumber $!sPosition TO $!posHelp4

  if ( !lenArrow.gt(1) ) then
    AID ARROW NUMB $!aidNumber AT $!posArrow DIR $!dirArrow1 HEIGHT $!lenArrow PROPORTION $!proportion
    AID ARROW NUMB $!aidNumber AT $!posArrow DIR $!dirArrow2 HEIGHT $!lenArrow PROPORTION $!proportion
  endif

  AID TEXT  NUMB $!aidNumber |$!label| AT $!posText

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:        showVolFeedback
--
-- Description:   callback for displaying volume feedback
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showVolFeedback()

  !this.strFltObj.showVolFeedback()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      clearVolFeedback
--
-- Description: clears all graphical feedback
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearVolFeedback()

   -- clear the graphical aid created for stair flight
  !!aslCentralData.clearFeedback('AIDVOLENVELOPE')
  !!aslCentralData.clearFeedback('AIDVOLMAIN')
  !!aslCentralData.clearFeedback('AIDVOLSTRFLT')
  !!aslCentralData.clearFeedback('AIDVOLHANDRA')
  !!aslCentralData.clearFeedback('AIDVOLCL')
  !!aslCentralData.clearFeedback('AIDVOLARROW')
  !!aslCentralData.clearFeedback('AIDVOLPLANES')

  !!aslCentralData.clearDimFeedback()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      clearEdgStack
--
-- Description: clears the edg packets if any defined
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearEdgStack()

  -- remove edg packets from stack
  !!edgCntrl.remove('Stair flight LWP')
  !!edgCntrl.remove('Stair flight UWP')
  !!edgCntrl.remove('Landing Elevation')
  !!edgCntrl.remove('Pick Planar Element for STRFLT')

endmethod
-- End of method definition

------------------------------------------------------------------------

--
-- Method:      getStrfltAbove
--
-- Description: gets the stair flight above the hierarchy from ce
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     DBREF
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getStrfltAbove(!item is DBREF) is DBREF

  !strflt = nulref

  if !item.badref() then
    return !strflt
  endif

  -- compose hierarchy above passed element
  !ownType = !item.ahlis
  !ownList = !item.ownls
  -- add item itself
  !ownType.append(!item.type)
  !ownList.append(!item)

  -- get element
  !level = !ownType.findFirst('STRFLT')
  if !level.set() then
    !strflt = !ownList[!level]
  endif

  return !strflt

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      getStrfltOwnerFrom
--
-- Description: get possible stair flight owner passed db position, e.g db item that can own STRFLT
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       checked db element
--
-- Return:
--   [Data Type] [Description]
--    DBREF       possible strflt owner - nulref is returned if STRFLT cannot be created there
--
------------------------------------------------------------------------

define method .getStrfltOwnerFrom(!item is DBREF) is DBREF

  !owner = nulref

  -- compose hierarchy above passed element
  !ownType = !item.ahlis
  !ownList = !item.ownls
  -- add item itself
  !ownType.append(!item.type)
  !ownList.append(!item)

  -- declare possible owner types
  !olis[1] = 'STRU'

  -- check if any of above is in a list
  !owners = !olis.intersect(!ownType)
  if !owners.set() then
  -- get element
    !type = !owners.last()
    !level = !ownType.findFirst(!type)
    !owner = !ownList[!level]
  endif

  return !owner

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showPanel
--
-- Description: make passed panel visible and discard the others
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Panel to be displayed
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showPanel(!panel is GADGET)

   -- make panels invisible
   do !i indices !this.panels
     skip if !this.panels[!i].eq(!panel)
     !this.panels[!i].visible = false
   enddo

   -- make passed panel visible
   !panel.visible = true

  if(!this.currentMode.upcase().eq('MODIFY') ) then
    !this.lkDetAttribBackToStrflt.tag = 'Back to Modify Stair flight'
    !this.formTitle = 'Modify Stair flight'
  elseif(!this.currentMode.upcase().eq('CREATE') ) then
    !this.lkDetAttribBackToStrflt.tag = 'Back to Create Stair flight'
    !this.formTitle = 'Create Stair flight'
  endif
endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description: form cancellation callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  -- tidy up
  -- escape from any EDG session
  !this.clearEdgStack()

  -- remove text labels from aid numbers
  !!aidNumbers.remove(!this.lwpAidNumber)
  !!aidNumbers.remove(!this.uwpAidNumber)

  -- clear any graphical aid created for stair flight
  !this.clearVolFeedback()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      kill
--
-- Description: callback executed on form kill
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .kill()

  -- remove text labels from aid numbers
  !!aidNumbers.remove(!this.lwpAidNumber)
  !!aidNumbers.remove(!this.uwpAidNumber)
  !!aidNumbers.remove(!this.fltSegmentAidNumber)

  -- clear the graphical aid created for stair flight
  !this.clearVolFeedback()
  !!aslCentralData.clearDimFeedback()

  -- Remove all edg mode
  !this.clearEdgStack()

endmethod

------------------------------------------------------------------------
--
-- Method:      mainPane
--
-- Description: show main panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mainPane()

  !this.showPanel(!this.mainPane)
  !this.formTitle = 'Main Stair Flight Tasks'

  -- tidy up and clean the stair flight graphical aids
  !this.clearVolFeedback()

  -- Remove stair flight aid numbers
  !!aidNumbers.hide(!this.fltSegmentAidNumber)
  !!aidNumbers.hide(!this.lwpAidNumber)
  !!aidNumbers.hide(!this.uwpAidNumber)

  -- remove edg packets from stack
  !this.clearEdgStack()

endmethod
-- End of method definition

