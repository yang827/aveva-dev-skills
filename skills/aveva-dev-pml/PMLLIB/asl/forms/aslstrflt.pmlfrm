-- End of method definition

------------------------------------------------------------------------
--
-- Method:        acceptStrflt
--
-- Description:   Updates db with the changes made
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .acceptStrflt()

  -- store current element
  !oldCe = !!ce

  -- Mark the database to Undo the creation/modification of stair flight
  !undo = object UNDOABLE()
  !undo.description('Accept changes for Stair Flight')
  !undo.undoAction('!!aslStrFlt.mainPane()')
  !undo.add()

  !strflt = !this.strFltObj.refe

  -- set name in stair flight object
  !name = !this.txName.val.trim()
  if(!name neq '') then
    if(!name.substring(1,1) eq '/' ) then
      !name = !name.substring(2)
    endif
    !this.strFltObj.name  = !name
  endif

  !desc = !this.txDesc.val.trim()
  if(!desc neq '') then
    !strflt.desc  = !desc
  endif

  !area = !this.dbArea.val
  if(!area.neq(0)) then
    !strflt.area  = !area
  endif

  !numb = !this.dbNumber.val
  if(!numb.neq(0)) then
    !strflt.number  = !numb
  endif


  if(!strflt.unset() or !strflt.badref()) then
     !this.strFltObj.dbWrite(!this.strfltOwner)
  else
     !!ce  = !strflt
     -- update stair flight element and members
     !this.strFltObj.updateDb(!strflt)
  endif

  !undo.endUndoable()

  !!ce  = !oldCe
  handle ANY
    -- element might have been deleted
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validationTextGadgets
--
-- Description: Validating the text gadgets.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET     Text Gadget to be validated
--    2    R     CRITERION  Validating Criteria for getting limits
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .validationTextGadgets(!gadget is GADGET,!validationCriteria is CRITERION)

  !objectAttribString = !gadget.name().after('TX').before('STRFLT')
  !objectAttrib = '!this.strFltObj' & '.' & !objectAttribString

  if(!gadget.val.string().empty())then
    !!alert.error(!validationCriteria.string() & ' Field cannot be empty')
    !gadget.val = $!objectAttrib
       handle ANY
        !gadget.val = !validationCriteria.optimum()
       endhandle
    return
  elseif(!gadget.val.lt(0))then
    !!alert.error('Zero and Negative Values are not valid for $!validationCriteria field.')
    !gadget.val = $!objectAttrib
       handle ANY
        !gadget.val = !validationCriteria.optimum()
       endhandle
    return
  endif

  !validationCriteria.checkValue(!gadget.val)
  handle ANY
     !!alert.error(!!error.text)
     !gadget.val = $!objectAttrib
       handle ANY
        !gadget.val = !validationCriteria.optimum()
       endhandle
       !gadget.refresh()
       return error noalert
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      validateName
--
-- Description: Check and Validate the name entered for stair flight
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateName()

  !enteredName  = !this.txName.val
  !name = !!checkName(!enteredName,'new')
  if(!name.set()) then
    !this.txName.val = !name
  else
    !this.txName.val = ''
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      validateHorizDirection
--
-- Description: validate if the entered value is a valid direction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateHorizDirection(!gadget is GADGET)

 !dir =  !gadget.val.string().direction()

 handle ANY
  -- incorrect data type for the gadget
  return
 endhandle

 if (!dir.up.neq(0) ) then
   return error 2 'Direction should not contain vertical component'
 endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evaluateStrflt
--
-- Description: Evaluates the stair flight and creates the graphical aids
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evaluateStrflt()
  -- clear the graphical aid created for stair flight
  !this.clearVolFeedback()

  if(!this.flightConfiguration.unset() or !this.flightConfiguration.trim().eq('') ) then
    if(!this.currentMode.eq('CREATE')) then
      !!alert.error('Select flight configuration from Installation Options.')
    else
      !!alert.error('Installation Option is not set in the attribute INSTOPTIONS of Stair Flight $!this.strFltObj.refe.name')
    endif
    return
  elseif(!this.flightConfiguration.upcase().eq('STRAIGHT')) then
    !flightOption =  'STRAIGHT'
  elseif(!this.flightConfiguration.upcase().eq('L-SHAPED')) then
    !flightOption =  'L-SHAPED'
  elseif(!this.flightConfiguration.upcase().eq('S-SHAPED')) then
    !flightOption =  'S-SHAPED'
  elseif(!this.flightConfiguration.upcase().eq('U-SHAPED')) then
    !flightOption =  'U-SHAPED'
  endif

  if(!this.strFltObj.pickedPosData.unset() ) then
    !!alert.error('LWP and UWP not defined for Stair flight')
    return
  elseif(!this.strFltObj.pickedPosData.size() eq 1 ) then
    !!alert.error('Either LWP or UWP not defined for Stair flight')
    return
  endif

  -- set the object position data after sorting the positions using elevation
  !this.setPickedData(!this.pickedLPosData,!this.pickedUPosData)

  if(!this.opSurfLevelLWP.selection().upcase().eq('ABOVE') ) then
      !this.strFltObj.lowLandingOffset = !this.strFltObj.landingThickness
  else
     !this.strFltObj.lowLandingOffset = 0
  endif

  if(!this.opSurfLevelUWP.selection().upcase().eq('ABOVE') ) then
      !this.strFltObj.upLandingOffset = !this.strFltObj.landingThickness
  else
     !this.strFltObj.upLandingOffset = 0
  endif

  !this.setExtension()

  if (!flightOption.eq('U-SHAPED')) then
    !this.setPerpPlane(!this.txUtypeNorLength.val , !this.txUtypeNorDirection.val)
  endif

  !this.lkStrfltPaneAccept.active = false
  !this.lkStrfltPaneCreate.active = false

  !this.evaluationSuccess  = false
  !this.evaluationSuccess  = !this.strFltObj.evaluate(!flightOption)
  handle ANY
    !this.evaluationSuccess  = false
  endhandle

  if(!this.evaluationSuccess) then
    if(!this.currentMode.eq('CREATE')) then
      if(!this.lkStrfltPaneEvaluate.tag.lowcase().eq('re-evaluate stair flight')) then
        !this.lkStrfltPaneAccept.active = true
      else
        !this.lkStrfltPaneCreate.active = true
      endif
    elseif(!this.currentMode.eq('MODIFY'))  then
      !this.lkStrfltPaneAccept.active = TRUE
    endif

    -- set gadgets with evaluated values
    !this.setGadgets(!this.strFltObj)

    -- set modify going panel gadgets active status
    !this.setModGoingPaneGadgets(true)

  else

    if(!this.lkStrfltPaneEvaluate.tag.lowcase().eq('re-evaluate stair flight').not()) then
      !this.lkStrfltPaneAccept.active = false
      !this.lkStrfltPaneCreate.active = false
      !!alert.error('Cannot create Stair flight with the given parameters.')
    endif

    -- set modify going panel gadgets active status
    !this.setModGoingPaneGadgets(false)

    return
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifySegmentElevation
--
-- Description: modifies the segment elevation after evaluation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifySegmentElevation()

  !segmentIndex = !this.nuSegmentStrflt.val
  if (!this.txLndgElevation.val.string().empty()) then
    !this.txLndgElevation.val =   !this.strFltObj.flights[!segmentIndex].uwp.up
    !!alert.error('Landing Elevation cannot be empty.')
    return
  else
    !newElevation = !this.txLndgElevation.val
  endif

  !modificationSuccess  = !this.strFltObj.modifyElevation(!segmentIndex, !newElevation)
  if(!modificationSuccess) then
    !this.acceptStrflt()
  else
    !this.txLndgElevation.val = !this.strFltObj.flights[!segmentIndex].uwp.up
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------

-- Method:      modifyTreadCnt
--
-- Description: modifies the segment elevation after evaluation
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyTreadCnt()

  !segmentIndex = !this.nuSegmentStrflt.val
  !newTreadCnt  = !this.txTreadCnt.val

  if (!this.strFltObj.isValid('TREADS', !newTreadCnt ).eq(0) ) then

    if (!this.assignTreadShift( !segmentIndex , !newTreadCnt)   ) then
      !this.acceptStrflt()
    else
      !this.txTreadCnt.val = !this.strFltObj.flights[!segmentIndex].numOfTreads
    endif
  else
     !!alert.error(' $!newTreadCnt is not a valid value for TREADS')
    !this.txTreadCnt.val = !this.strFltObj.flights[!segmentIndex].numOfTreads
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        modifyStrflt
--
-- Description:   modifies the stair flight with the changes made
--
                                                                                                                                                                                                                                                                                                                                                                                                  -- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyStrflt(!gadget is GADGET, !action is STRING)

-- all validation calls and tooltips are handled in different methods use them instead of this

  !this.tmpStrfltObj  = !this.strFltObj

  -- open callback calls method twice
  if(!gadget.type().eq('LIST') and $
     !action.eq('UNSELECT') ) then
     return
  endif

  !gadgetName = !gadget.name()
  !objectAttribString = !gadgetName.after('TX').before('STRFLT')

   if( !gadget.eq(!this.txWidth) ) then
    if(!this.currentMode.upcase().eq('MODIFY')) then
      !this.strFltObj.setWidth(!this.txWidth.val)
      handle ANY
      	 !!alert.error(!!error.text)
      endhandle
    else
      !this.strFltObj.width = !this.txWidth.val.real()
    endif

  elseif( !gadget.eq(!this.txFthickness) ) then
    !this.strFltObj.setFlightThickness(!this.txFthickness.val)

  elseif( !gadget.eq(!this.txHeadRoom) ) then
    !this.strFltObj.setHeadRoom(!this.txHeadRoom.val)

  -- lower explicit position
  elseif ( !gadget.eq(!this.netLPositionFrame) ) then

    !position = !this.getPositionControlPos(!this.netLPosControl.xyz())

    !this.storePosition(!position,'LWP')

  -- upper explicit position
  elseif ( !gadget.eq(!this.netUPositionFrame) ) then

    !position          = !this.getPositionControlPos(!this.netUPosControl.xyz())
    !this.storePosition(!position,'UWP')

    -- activate the planar pick gadget
    !this.rtPlane.active = true

  elseif(  !gadget.eq(!this.txUtypeNorLength) ) then
     if (!gadget.val.unset() ) then
       !gadget.setValue(0 , true)
     endif

     !this.strFltObj.utypeNorLength =  !this.txUtypeNorLength.val
     !this.setPerpPlane(!this.txUtypeNorLength.val , !this.txUtypeNorDirection.val)

  elseif(  !gadget.eq(!this.txUtypeNorDirection  )) then
       !this.setPerpPlane(!this.txUtypeNorLength.val , !this.txUtypeNorDirection.val)

  elseif(  !gadget.eq(!this.txRise) ) then
    if (!this.strFltObj.flights.size().geq(1) ) then
    if (!this.strFltObj.rise.neq( !this.txRise.val ) ) then
         if (!this.strFltObj.reevaluate('RISE' , !this.txRise.val ).not() ) then
           !this.strFltObj = !this.tmpStrfltObj
         endif
       !this.setFlightGadgets()
    endif
  else
      !this.strFltObj.rise = !this.txRise.val
    endif
  else
    !objectAttrib = '!this.strFltObj' & '.' & !objectAttribString
    -- string for the form gadget value
    !setValue = '!this.' & !gadgetName & '.val'
    $!objectAttrib  = $!setValue
    handle ANY
      -- in case the gadget name is not matching with the object member name
    endhandle
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyStrfltPane
--
-- Description: show main modification panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Stair flight to be load into form and modified
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyStrfltPane(!ref is DBREF)

  !this.currentMode = 'MODIFY'

  !strflt = !this.getStrfltAbove(!ref)
  if !strflt.unset() then
    !!alert.warning('Not below STRFLT hierarchy')
    return
  endif

  !rpath = !!dtbMemberOfType(!strflt,'RPATH',1)
  if(!rpath.unset() or !rpath.members.unset()) then
    !!alert.message('Cannot modify the stair flight. RPATH is not defined.')
    return
  endif

  !this.clearVolFeedback()

  !this.flightConfiguration = !strflt.instOption
  handle ANY
  endhandle
  do !toggle values !this.installationOptions
    -- unselect other toggles
    !toggle.val = false
    !toggle.active = false
  enddo

  -- remove edg packet from stack first
  !this.clearEdgStack()

  -- initialize Stair flight object
  !this.strFltObj = object DBEASLSTRFLT(!!aslCentralData.currSetting.description)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  -- load stair flight object data
  !this.strFltObj.dbeAslStrflt(!strflt)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  -- add stair flight to the graphical view
  ADD $!strflt
  handle ANY
  endhandle

  -- set limits to the stair flight in the graphical view
  AUTO $!strflt
  handle ANY
    -- in case no elements are created under STRFLT
  endhandle

  -- set gadget values
  !this.setGenAttGadgets()
  !this.setGadgets(!this.strFltObj)

  -- set strflt panel gadgets visibility
  !this.setStrfltPaneGadgets(false)

  -- set modify going panel gadgets active status
  !this.setModGoingPaneGadgets(true)

  -- set form title
  !this.formTitle = 'Modify Stair flight'

  -- show panel
  !this.showPanel(!this.strfltPane)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyTmplReference
--
-- Description: sets the template reference of stair flight and handrail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyTmplReference(!gadget is GADGET, !action is STRING)

  if(!action.eq('SELECT')) then
    -- selects the templates
    if(!gadget.eq(!this.opStrfltTmplReference) ) then
      !strfltTmplReference  = !this.opStrfltTmplReference.selection().dbRef()
      !this.strFltObj.setTemplateReference(!strfltTmplReference)

    elseif(!gadget.eq(!this.opHandraTmplReference) ) then
      !handRaTmplReference  = !this.opHandraTmplReference.selection().dbRef()
      !this.strFltObj.lHandrail.autoDraw  = false
      !this.strFltObj.rHandrail.autoDraw  = false

      !this.strFltObj.lHandrail.xOffset(-1)
      !this.strFltObj.lHandrail.build(!this.strFltObj,'L',!handRaTmplReference)
      !this.strFltObj.rHandrail.build(!this.strFltObj,'R',!handRaTmplReference)
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyHandraSide
--
-- Description: sets the selection for the side in which handrails are installed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyHandraSide()

   !this.strFltObj.handRailOption =  !this.opHandraSide.selection()

   -- update the aids to provide feedback
   !this.clearVolFeedback()
   !this.showVolFeedback()

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:        installOption
--
-- Description:   sets the installation option
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .installOption(!gadget is GADGET, !action is STRING )

  !this.flightConfiguration = ''
  -- if action is select then unselect other toggles
  if( !action.eq('SELECT') ) then
    do !toggle values !this.installationOptions
      skip if(!toggle.eq(!gadget))
      -- unselect other toggles
      !toggle.val = false
    enddo

    -- set the right/left option inactive
    !this.toClockwiseStrFlt.active     = false
    !this.toAntiClockwiseStrFlt.active = false
    !this.frUtypeNorLength.active      = false

    !gadgetName  = !gadget.name()
    if(!gadgetName.eq( 'TOINSTALLOPTION1' )) then
      -- Configuration is Straight
      !this.flightConfiguration = 'STRAIGHT'
      !this.toClockwiseStrFlt.active     = false
      !this.toAntiClockwiseStrFlt.active = false

    elseif(!gadgetName.eq( 'TOINSTALLOPTION2' )) then
      -- Configuration is L-Shaped
      !this.flightConfiguration = 'L-SHAPED'
      !this.toClockwiseStrFlt.active     = true
      !this.toAntiClockwiseStrFlt.active = true
    elseif(!gadgetName.eq( 'TOINSTALLOPTION3' )) then
      -- Configuration is S-Shaped
      !this.flightConfiguration = 'S-SHAPED'
      !this.toClockwiseStrFlt.active     = false
      !this.toAntiClockwiseStrFlt.active = false
    elseif(!gadgetName.eq( 'TOINSTALLOPTION4' )) then
      -- Configuration is U-Shaped
      !this.flightConfiguration     = 'U-SHAPED'
      !this.toClockwiseStrFlt.active     = true
      !this.toAntiClockwiseStrFlt.active = true
      !this.frUtypeNorLength.active      = true
    endif
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      showHandraDetailAttributes
--
-- Description: opens the Handrail specification form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showHandraDetailAttributes()

  -- Selection form title
  !title              = 'Handrail Detail Attributes'

  -- Action to be carried out
  !action             = '!!aslStrFlt.setHandraData(!this.meHandraEngine)'

  --template Reference
  !handrailTmplReference = !this.strFltObj.lHandrail

  -- Setup form for handrail selection
  !handraSelection    = object ASLSTRMEMBHANDRA(!title, !action, !handrailTmplReference)

  !handraSelection.meHandraEngine(!this.strFltObj.lHandrail.tmplReference)

  -- Display profile selection form
  !handraSelection.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setHandraData
--
-- Description: sets the handrail data to the stair flight object
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setHandraData(!handrailObj is ASLHANDRAIL)

  !this.strFltObj.lHandrail.postSpacing    = !handrailObj.postSpacing
  !this.strFltObj.lHandrail.tangentSpacing = !handrailObj.tangentSpacing
  !this.strFltObj.lHandrail.endSpacing     = !handrailObj.endSpacing
  !this.strFltObj.lHandrail.radius         = !handrailObj.radius
  !this.strFltObj.lHandrail.railSpacing    = !handrailObj.railSpacing

  !this.strFltObj.rHandrail.postSpacing    = !handrailObj.postSpacing
  !this.strFltObj.rHandrail.tangentSpacing = !handrailObj.tangentSpacing
  !this.strFltObj.rHandrail.endSpacing     = !handrailObj.endSpacing
  !this.strFltObj.rHandrail.radius         = !handrailObj.radius
  !this.strFltObj.rHandrail.railSpacing    = !handrailObj.railSpacing

  -- Set the selected template reference from handrail attributes form
  !selectOpt = !handrailObj.tmplReference.refno.string()
  !this.opHandraTmplReference.select('RTEXT', !selectOpt)
  handle ANY
    -- selection text not in the list
  endhandle

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      modifyGoing
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyGoing()

  -- display the modify going panel
  !this.modifyGoingPane()

  !flightToModifyInx           = !this.nuSegmentStrflt.val

  -- set the length of lower and upper Extension
  !this.txModLExtension.val    =  !this.strFltObj.lExtension
  !this.txModUExtension.val    =  !this.strFltObj.uExtension
  !this.txModLExtension.active = TRUE
  !this.txModUExtension.active = TRUE

  !flights = !this.strFltObj.flights

  !fltsInLegCnt = 0
  do !fltInx indices  !this.strFltObj.flightLegs
     !fltsInLegCnt =  !fltsInLegCnt +  !this.strFltObj.flightLegs[!fltInx].numOfFlights
     if (!flightToModifyInx.leq(!fltsInLegCnt) )  then
        -- this is the leg to modify
        !startInx = !fltsInLegCnt  -  !this.strFltObj.flightLegs[!fltInx].numOfFlights + 1
        !endInx   = !fltsInLegCnt

        if(!fltInx.neq(1) ) then
           !this.txModLExtension.active = FALSE
        elseif (!this.strFltObj.lExtnDirection.isparallel(!flights[1].fltDirection).not() ) then
           !this.txModLExtension.active = FALSE
        endif

        if(!fltInx.neq(!this.strFltObj.flightLegs.maxindex() ) ) then
           !this.txModUExtension.active = FALSE
        elseif (!this.strFltObj.uExtnDirection.isparallel(!flights.last().fltDirection).not() ) then
           !this.txModUExtension.active = FALSE
        endif

        break
     endif
  enddo

  if (undefined(!endInx) ) then
  	return
  endif	

  !oLength = !this.populateLandingGrid(!startInx  , !endInx )

  -- make the system grid single selection
  !this.legGoingGrid.setEditableColumn(1,false)
  !this.legGoingGrid.setEditableColumn(3,false)
  !this.legGoingGrid.setEditableColumn(5,false)

  if (!this.txModLExtension.active ) then
    !oLength =  !oLength + !this.txModLExtension.val
  endif

  if (!this.txModUExtension.active ) then
    !oLength = !oLength + !this.txModUExtension.val
  endif

  !this.origLengTxt.val =     !oLength
  !this.calcLengTxt.val =     !oLength

  !this.legGoingGrid.selectRow(!this.nuSegmentStrflt.val)

endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:populateLandingGrid
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateLandingGrid(!startInx is REAL , !endInx is REAL) is REAL

  !headings = ARRAY()
  !headings.append('No')
  !headings.append('Low Landing')
  !headings.append('Going')
  !headings.append('Up Landing')
  !headings.append('Overall Length')

  !flights  = !this.strFltObj.flights
  !oLength  = 0

  do !i from !startInx to !endInx
    !flight = !flights[!i]
    !flightLength[!i][1] = !i
    !flightLength[!i][2] = !flight.lLndgLength.string(!!distanceFmt)
    !flightLength[!i][3] = !flight.oGoing.string(!!distanceFmt)
    !flightLength[!i][4] = !flight.uLndgLength.string(!!distanceFmt)
    !length              = !flight.lLndgLength + !flight.oGoing + !flight.uLndgLength
    !flightLength[!i][5] = !length.string(!!distanceFmt)
    !oLength             = !oLength + !length
--    !flightLength[!i][2] = object REAL(!flight.lLndgLength.string() , !!distanceFmt )
--    !flightLength[!i][3] = object REAL(!flight.oGoing.string()  ,!!distanceFmt)
--    !flightLength[!i][4] = object REAL(!flight.uLndgLength.string() , !!distanceFmt)
--    !length              = !flight.lLndgLength + !flight.oGoing + !flight.uLndgLength
--    !flightLength[!i][5] = object REAL(!length.string() , !!distanceFmt)
--    !oLength             = !oLength + !length
  enddo

  -- compress to eliminate empty array element
  !flightLength.compress()

  using namespace  'Aveva.Pdms.Presentation'
  !this.legGoingGrid = object NETGRIDCONTROL()



  !nds = object NETDATASOURCE('NET', !headings, !flightLength )
  !this.legGoingGrid.bindToDataSource(!nds)
  !this.legGoingGrid.setNameColumnImage()
  handle any
  endhandle

  return !oLength

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      reselRow
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reselRow( !arr is ARRAY)

  !rowIndx = !arr[1].real()
  if(!arr[2] inset (|Up Landing|, |Low Landing|) ) then  	
    !newLandingLength = object REAL(!arr[0] , !!distanceFmt)
    handle ANY    	
    	 !arr[3]    = false
    elsehandle none
      if (!this.strFltObj.isValid('FLTINTLNGLENGTH',!newLandingLength ) .neq(0) ) then
           !!alert.error(!!error.text)
      endif
    endhandle
  endif

  !this.legGoingGrid.selectRow(!rowIndx)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        calcFlightLength
--
-- Description:   Calculate the length of a single flight and display
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calcFlightLength( !arr is ARRAY)

  !rowIndx =  !this.legGoingGrid.getSelectedRowTags()[1]
  !rowVal =  !this.legGoingGrid.getRow(!rowIndx)

  !length = 0
  do !index from 2 to 4
    !partLength = object REAL( !rowVal[!index] , !!distanceFmt)
    !length = !length + !partLength
    handle (2,779)
    -- don't change the length if the new value is incorrect
    endhandle
  enddo

  !this.legGoingGrid.setCellValue( !rowIndx.real() , 5 , object STRING (!length , !!distanceFmt))

  !this.calcLegLength()

endmethod
------------------------------------------------------------------------
--
-- Method:          calcLegLength
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calcLegLength()

  !fltLengthValues       = !this.legGoingGrid.getColumn(5)

  !calcLength   = 0
  do !flightLength values !fltLengthValues
      !calcLength = !calcLength + object REAL( !flightLength , !!distanceFmt)
  enddo

  if (!this.txModLExtension.active ) then
    !calcLength = !calcLength + !this.txModLExtension.val
  endif
  if (!this.txModUExtension.active ) then
    !calcLength = !calcLength + !this.txModUExtension.val
  endif

  !this.calcLengTxt.val = !calcLength

  !origLength = !this.origLengTxt.val

  if(!calcLength.eq(!origLength) ) then
    !this.lkModGoingPaneAccept.active = true
  else
    !this.lkModGoingPaneAccept.active = false
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:        editLandings
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .editLandings()

  !landingVal = !this.legGoingGrid.getRows()

  !this.strFltObj.lExtension  = !this.txModLExtension.val
  !this.strFltObj.uExtension  =  !this.txModUExtension.val

  -- update the gadgets in the detail attribute panel also
  !this.txLExtension.val      = !this.txModLExtension.val
  !this.txUExtension.val      = !this.txModUExtension.val

  do !inx indices !landingVal
     !flightInx = !landingVal[!inx][1].real()
     !this.strFltObj.flights[!flightInx].lLndgLength = object REAL(!landingVal[!inx][2] , !!distanceFmt)
     !this.strFltObj.flights[!flightInx].uLndgLength = object REAL(!landingVal[!inx][4] , !!distanceFmt)
  enddo

  !this.strFltObj.modifyLandings()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      modTreadCnt
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modTreadCnt()

  -- display the modify going panel
  !this.modTreadCntPane()

  !this.setElevGrid()

  !this.flightElevGrid.setNameColumnImage()
  handle any
  endhandle

  -- make the system grid single selection
  !this.flightElevGrid.setEditableColumn(1,false)
  !this.flightElevGrid.setEditableColumn(3,false)

  !this.tmpStrfltObj = !this.strFltObj

 !this.legGoingGrid.selectRow(!this.nuSegmentStrflt.val)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      reselElevRow
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setElevGrid()

  !flightToModifyInx           = !this.nuSegmentStrflt.val

  -- Populate system members with standard TOOLTIP text (name and type)
  -- Set headings
  !headings = ARRAY()
  !headings.append('No')
  !headings.append('Rises in Flight')
  !headings.append('Top Elevation')

  !flights = !this.strFltObj.flights

  !fltsInLegCnt = 0
  do !fltInx indices  !this.strFltObj.flightLegs
     !fltsInLegCnt =  !fltsInLegCnt +  !this.strFltObj.flightLegs[!fltInx].numOfFlights
     if (!flightToModifyInx.leq(!fltsInLegCnt) )  then
        -- this is the leg to modify
        !startInx = !fltsInLegCnt  -  !this.strFltObj.flightLegs[!fltInx].numOfFlights + 1
        !endInx   = !fltsInLegCnt
        break
     endif
  enddo

  if (undefined(!endInx) ) then
  	return
  endif	

  !oLength  = 0
  do !i from !startInx to !endInx
    !flight = !flights[!i]
    !flightElev[!i][1] = !i
    !flightElev[!i][2] = !flight.numOfTreads
    !flightElev[!i][3] = !flight.uwp.up.string(!!distanceFmt)
  enddo

 --  will remove the array index to properly display in grid
 -- flight id is stored in the first array
 !flightElev.compress()

  using namespace  'Aveva.Pdms.Presentation'
  !this.flightElevGrid = object NETGRIDCONTROL()


  !nds = object NETDATASOURCE('NET', !headings, !flightElev)
  !this.flightElevGrid.bindToDataSource(!nds)

  -- make the last flight in the leg not editable
  !lastIndx = !endInx - !startInx + 1
  !this.flightElevGrid.setEditableRow(!lastIndx,false)


endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      reselElevRow
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reselElevRow( !arr is ARRAY)

  !rowIndx = !arr[1].real()
  !this.flightElevGrid.selectRow(!rowIndx)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:        calcLndgElev
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calcLndgElev(!arr is ARRAY)

  -- retrieve necessary data from the grid
  !rowIndx =  !this.flightElevGrid.getSelectedRowTags()[1]
  !botFlightIndx = !this.flightElevGrid.getcell(!rowIndx , 'No').real()
  !newBotTreads  = !this.flightElevGrid.getcell(!rowIndx.real() , 2 ).real()


  if (!this.strFltObj.isValid('TREADS',!newBotTreads ).neq(0) ) then
     !!alert.error(!!error.text)
     !this.setElevGrid()
     return
  endif

  if ( !this.assignTreadShift(!botFlightIndx , !newBotTreads).not() ) then
    !this.flightElevGrid.selectRow(!rowIndx.real())
  endif

  !flightIndices  = !this.flightElevGrid.getColumn('No')
  !baseFlightIndx = !this.flightElevGrid.getcell(1 , 1 ).real()
  !elev           = !this.strFltObj.flights[!baseFlightIndx].lwp.up

  do !i index !flightIndices
    !treadVal[!i][1] = !flightIndices[!i].real()
    !treadVal[!i][2] = !this.strFltObj.flights[!treadVal[!i][1]].numOfTreads
    -- Take care about the lrise also if it is there
    -- other than the one outside the loop others are Upper elevations
    !elev            = !elev + !treadVal[!i][2] * !this.strFltObj.rise
    !treadVal[!i][3] = !elev.string(!!distanceFmt)
  enddo

  !headings = !this.flightElevGrid.getColumns()

  using namespace  'Aveva.Pdms.Presentation'

  !nds = object NETDATASOURCE('NET', !headings, !treadVal)

  !this.flightElevGrid.bindToDataSource(!nds)

  !this.flightElevGrid.selectRow(!rowIndx.real())

  return

endmethod
------------------------------------------------------------------------
--
-- Method:        assignTreadShift
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assignTreadShift(!flightIndx is REAL , !newTreadsCnt is REAL) is BOOLEAN

   !oldBotTreads  = !this.strFltObj.flights[!flightIndx].numOfTreads
  -- get the difference in treads between the number in object and the user entered (+ve/-ve)
   !changeInTreads = !newTreadsCnt - !oldBotTreads
  if (!changeInTreads.eq(0) ) then
        return FALSE
  endif  	

  -- Move the treads to the upper side
   !newTopTreads  = !this.strFltObj.flights[!flightIndx + 1].numOfTreads - !changeInTreads
  handle ANY
    return FALSE
   elsehandle NONE
     if (!this.strFltObj.isValid('TREADS', !newTopTreads).neq(0) ) then
        !!alert.error('Tread can not be shifted to the upper flight, as it is beyond the valid values of it')
        return FALSE
     endif
   endhandle

   !this.clearVolFeedback()

   !this.strFltObj.shiftTreads(!flightIndx , !changeInTreads)
   -- update the detail attrib pane
   !this.setSegmentAttributes(!flightIndx)

   return TRUE
endmethod
-- End of method definition
------------------------------------------------------------------------

--
-- Method:      positionOption
--
-- Description: Choose explicit or relative position option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .positionOption()

 !indx =  !this.frStrfltPosDir.val
 !selection = !this.frStrfltPosDir.rtoggle(!indx)

 if(!selection.tag.upcase().matchwild('*PLANE*'))then
  !this.frLowerPosition.visible = false
  !this.frLowerPlane.visible    = true
 else
  !this.frLowerPosition.visible = true
  !this.frLowerPlane.visible    = false
 endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      surfaceMatchOption
--
-- Description: Set the landing offset based on the lower and upper landing levels
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLandingOffset(!gadget is GADGET, !action is STRING )

  !landingThickness = !this.strFltObj.landingThickness

  if(!gadget.name().eq('OPSURFLEVELLWP') or !gadget.name().eq('OPSURFJUSTLWP') ) then
    if (!this.opSurfLevelLWP.selection().upcase().eq('ABOVE') ) then
      if (!this.opSurfJustLWP.selection().upcase().eq('TOS') ) then
         !this.strFltObj.lowLandingOffset = !landingThickness
      else
         !this.strFltObj.lowLandingOffset = -1 * !landingThickness
      endif
    else
      !this.strFltObj.lowLandingOffset = 0
    endif
  endif

  if(!gadget.name().eq('OPSURFLEVELUWP') or !gadget.name().eq('OPSURFJUSTUWP') ) then
    if (!this.opSurfLevelUWP.selection().upcase().eq('ABOVE') ) then
      if (!this.opSurfJustUWP.selection().upcase().eq('TOS') ) then
         !this.strFltObj.upLandingOffset = !landingThickness
      else
         !this.strFltObj.upLandingOffset = -1 * !landingThickness
      endif
    else
       !this.strFltObj.upLandingOffset = 0
    endif
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      assignSense
--
-- Description: Calls the method that sets the correct values in relevant gadgets and object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .assignSense(!gadget is GADGET, !action is STRING )

   if (!gadget.name().upcase().matchwild('*ANTI*')) then
     !this.setSenseGadget(false)
   else
     !this.setSenseGadget(true)
   endif

endmethod

------------------------------------------------------------------------
--
-- Method:      setSenseGadget
--
-- Description: Set the gadgets related to Sense and calls the set sense method in Object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .setSenseGadget(!sense is BOOLEAN )

  if ( !this.strFltObj.sense.neq(!sense)) then
    !this.clearVolFeedback()
    !this.tmpStrfltObj  = !this.strFltObj
    if ( !this.strFltObj.setSense(!sense) ) then
     !this.toClockwiseStrFlt.val      = !sense
     !this.toAntiClockwiseStrFlt.val  = !sense.not()
    else
     !this.strFltObj  = !this.tmpStrfltObj
     !this.toClockwiseStrFlt.val      = !sense.not()
     !this.toAntiClockwiseStrFlt.val  = !sense
    endif
    !this.setGadgets(!this.strFltObj)
 endif

endmethod
------------------------------------------------------------------------
--
-- Method:      setExtension
--
-- Description: Set the gadgets related to Sense and calls the set sense method in Object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       profiles
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setExtension()

  !this.strFltObj.extnoption = !this.opExtnOptions.selection().real()

  if(!this.strFltObj.extnoption.eq(0) ) then
     !this.strFltObj.noextension = TRUE
  else
     !this.strFltObj.noextension = FALSE
  endif

endmethod
------------------------------------------------------------------------
