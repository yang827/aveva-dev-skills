------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  aslStrHandraDetails()            -
--  backToOptimum()                  -                   convert distance in string to real in current units
--  dismiss()                        -                   closes the form
--  setGadgetActiveStatus(GADGET,BOOLEAN) -                   set active status of the gadget
--  setRailSpacing()                 -
--  setTmplrefGadget(GADGET)         ARRAY
--  setup(STRING,STRING,ASLHANDRAIL) -                   setup the form
--  stringToDistance(STRING)         REAL                convert distance in string to real in current units
--  tmplReference()                  -                   callback of tmplReference option gadget
--  updateDataHandra(GADGET,STRING)  -                   updates the limits
--  updateGadgetVisibility()         -                   sets the visibility for the gadgets
--  updateGadgets()                  -                   sets the values for the gadgets
--  updateGadgetsOptimum()           -                   sets the optimum values for the gadgets
--  updateLimitsHandra()             -                   updates the limits
--  updatePixMap()                   -                   sets the pixmap for the gadgets
--  updateRailSpacing()              -                   updates the rail spacing
--  updateTmplrefGadget(ARRAY)       -
--  validateCallGadgets()            -                   sets the validate call for the gadgets
--  validationTextGadgets(GADGET,CRITERION) -                   Validating the text gadgets.
--

import 'GridControl'
handle ANY
endhandle


setup form !!aslStrHandraDetails dialog dock size 35 18

  --frame .handrailPane   'Handrail Attributes'              at xmin form+1          ymax+0.5            anchor L+T                                                     width 35
    paragraph .tmplData                                    at xmin+1               ymin                text 'Handrail Template'                                       width 15
    line .tmplDataLine                                     at xmin                 ymax                anchor T+L+R  horizontal                                       width 32
    option .tmplReference                                  at xmin                 ymax+0.2            anchor T+L+R  callback   '!this.tmplReference()'               width 28
    paragraph .postData                                    at xmin                 ymax                text 'Posts'                                                   width 5
    line .postDataLine                                     at xmin                 ymax                anchor T+L+R  horizontal                                       width 32
    text .postSpacing        'Post spacing:'               at xmin                 ymax+0.5            anchor T+L+R  callback   '!this.updateDataHandra(' tagwidth 12 width 13 is REAL  format !!distanceFMT
    option .opPostSpacing    'Post spacing:'               at xmin.postSpacing     ymin.postSpacing    anchor T+L    callback   '!this.updateDataHandra(' tagwidth 12 width 13
    text .tangentSpacing     'Tangent spacing:'            at xmin                 ymax+0.1            anchor T+L+R  callback   '!this.updateDataHandra(' tagwidth 12 width 13 is REAL  format !!distanceFMT
    option .opTangentSpacing 'Tangent spacing:'            at xmin.tangentSpacing  ymin.tangentSpacing anchor T+L    callback   '!this.updateDataHandra(' tagwidth 12 width 13
    text .endSpacing         'End spacing:'                at xmin                 ymax+0.1            anchor T+L+R  callback   '!this.updateDataHandra(' tagwidth 12 width 13 is REAL  format !!distanceFMT
    option .opEndSpacing     'End spacing:'                at xmin.endSpacing      ymin.endSpacing     anchor T+L    callback   '!this.updateDataHandra(' tagwidth 12 width 13

    paragraph .railData                                    at x0.5                 ymax+0.5            text 'Rails'                                                   width 5
    line .railDataLine                                     at xmin                 ymax                anchor T+L+R  horizontal                                       width 32
    text .radius             'Bend Radius:'                at x1                   ymax+0.5            anchor T+L+R  callback   '!this.updateDataHandra(' tagwidth 12 width 13 is REAL FORMAT !!distanceFMT
    option .opRadius         'Bend Radius:'                at xmin.radius          ymin.radius         anchor T+L    callback   '!this.updateDataHandra(' tagwidth 12 width 13
    textpane .railSpacing    'Spacing'                     at x1                   ymax+0.3            anchor T+L+R                                                   width 31 height 5
    button .railSpacingApply 'Use'                         at xmin                 ymax+0.3            anchor T+L+R  callback   '!this.setRailSpacing()'              width 3

  --exit

  --frame .handrailTask       'Perform Task'                 at xmin form+1          ymax+0.2            anchor T+L                                                     width 35

    paragraph .acceptHandrailIcon                          at xmin+0.5             ymax+1              anchor B      pixmap                                            width 16 height 16
    button    .acceptHandrail  linklabel 'Accept Changes'  at xmax+1               ymin                anchor B                   callback '!this.apply()'             width 10

    paragraph .discardHandrailIcon                         at xmax+3               ymin                anchor B      pixmap                                            width 16 heigh 16
    button    .discardHandrail linklabel 'Discard Changes' at xmax+1               ymin                anchor B                   callback '!this.backToOptimum()'     width 10

  --exit

-- private members
---------------------------------------------------------------------------
  -- contains for the handrail data
  member .meHandraEngine      is ASLHANDRAIL

  -- contains the old handrail data
  member .oldMeHandraEngine   is ASLHANDRAIL

  -- Action on apply
  member .action              is BLOCK

  -- handrail templates
  member .templates           is ARRAY

  -- handrail template gadget
  member .tmplReferenceGadget is GADGET

exit
---------------------------------------------------------------
--
-- Method:      setup
--
-- Description: setup
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .aslStrHandraDetails()

  -- general form data
  !this.formRevision             = ' $Revision$ '
  !this.formTitle                = 'Handrail Specification'
  !this.quitCall                 = '!this.dismiss()'
  !this.meHandraEngine           = object ASLHANDRAIL(!!aslCentralData.currSetting.description)

  --set validate call for the gadgets
  !this.validateCallGadgets()

  --update the gadget values
  !this.updateGadgets()

  --update the pixmap
  !this.updatePixMap()

  --update gadget visibility
  !this.updateGadgetVisibility()

  --update the limits for the gadgets
  !this.updateLimitsHandra()

  !this.oldMeHandraEngine = !this.meHandraEngine

endmethod
-- End of method
-----------------------------------------------------------------------
--
-- Method:      dismiss
--
-- Description:  closes the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dismiss()

  --close the form
  !this.hide()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      validateCallGadgets
--
-- Description: sets the validate call for the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .validateCallGadgets()

  --set the validate call
  !this.postSpacing.validatecall      = '!this.validationTextGadgets(!this.postSpacing,   !this.meHandraEngine.criteria.postSpacing)'
  !this.tangentSpacing.validatecall   = '!this.validationTextGadgets(!this.tangentSpacing,!this.meHandraEngine.criteria.tangentSpacing)'
  !this.endSpacing.validatecall       = '!this.validationTextGadgets(!this.endSpacing,    !this.meHandraEngine.criteria.endSpacing)'
  !this.radius.validatecall           = '!this.validationTextGadgets(!this.radius,        !this.meHandraEngine.criteria.bRadius)'

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: sets the values for the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateGadgets()

  --set the value for the gadget
  --post spacing of the Handrail
  !postSpacingHandra = !this.meHandraEngine.postSpacing
  if ( !this.opPostSpacing.dText.empty() ) then
    !this.postSpacing.val   = !postSpacingHandra
  else
    !this.opPostSpacing.select('DTEXT', !postSpacingHandra.string())
  endif

  --tangent spacing of the Handrail
  !tangentSpacingHandra = !this.meHandraEngine.tangentSpacing
  if ( !this.opPostSpacing.dText.empty() ) then
    !this.tangentSpacing.val   = !tangentSpacingHandra
  else
    !this.opTangentSpacing.select('DTEXT', !tangentSpacingHandra.string())
  endif

  --end spacing of the Handrail
  !endSpacingHandra = !this.meHandraEngine.endSpacing
  if ( !this.opEndSpacing.dText.empty() ) then
    !this.endSpacing.val   = !endSpacingHandra
  else
    !this.opEndSpacing.select('DTEXT', !endSpacingHandra.string())
  endif

  --bend radius of the Handrail
  !bendRadiusHandra = !this.meHandraEngine.radius
  if ( !this.opRadius.dText.empty() ) then
    !this.radius.val   = !bendRadiusHandra
  else
    !this.opRadius.select('DTEXT', !bendRadiusHandra.string())
  endif

  !railSpacingEditable          = !this.meHandraEngine.railSpacingEditable
  !this.railSpacingApply.active = !railSpacingEditable
  !this.railSpacing.seteditable(!railSpacingEditable)

  --update the template reference
  !this.templates = !this.setTmplrefGadget(!this.tmplReference)

  -- set active status of gadgets
  !this.setGadgetActiveStatus(!this.postSpacing,!this.meHandraEngine.isPanelised.not())
  !this.setGadgetActiveStatus(!this.endSpacing,!this.meHandraEngine.isPanelised.not())
  !this.setGadgetActiveStatus(!this.tangentSpacing,!this.meHandraEngine.isPanelised.not())
  !this.setGadgetActiveStatus(!this.radius,!this.meHandraEngine.isPanelised.not())

  --set the default railSpacing
  !this.updateRailSpacing()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updatePixMap
--
-- Description: sets the pixmap for the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updatePixMap()

  --adding the pixmap
  !this.acceptHandrailIcon.addPixmap(!!pml.getPathName('create.png'))
  !this.discardHandrailIcon.addPixmap(!!pml.getPathName('discard.png'))

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateGadgetVisibility
--
-- Description: sets the visibility for the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateGadgetVisibility()

  --setting the visibility
  !this.opPostSpacing.visible    = false
  !this.opTangentSpacing.visible = false
  !this.opEndSpacing.visible     = false
  !this.opRadius.visible         = false

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateLimitsHandra
--
-- Description: updates the limits
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateLimitsHandra()

  --set the variable for method
  call !!fillCriterionGadgets(!this.postSpacing,      !this.opPostSpacing,     !this.meHandraEngine.criteria.postSpacing)
  call !!fillCriterionGadgets(!this.tangentSpacing,   !this.opTangentSpacing,  !this.meHandraEngine.criteria.tangentSpacing)
  call !!fillCriterionGadgets(!this.endSpacing,       !this.opEndSpacing,      !this.meHandraEngine.criteria.endSpacing)
  call !!fillCriterionGadgets(!this.radius,           !this.opRadius,          !this.meHandraEngine.criteria.bRadius)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      validationTextGadgets
--
-- Description: Validating the text gadgets.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET     Text Gadget to be validated
--    2    R     CRITERION  Validating criteria for getting limits
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .validationTextGadgets(!gadget is GADGET,!validationCriteria is CRITERION)

  --set method call for filling the gadget on error

  --check if value is less than zero
  if(!gadget.val.lt(0))then
    !!alert.error('$!gadget.tag cannot accept a Negative value. Enter a positive value.')
      if ( !gadget.name().eq('POSTSPACING') ) then
        !gadget.val = !this.meHandraEngine.postSpacing
      elseif ( !gadget.name().eq('TANGENTSPACING') ) then
        !gadget.val = !this.meHandraEngine.tangentSpacing
      elseif ( !gadget.name().eq('endSpacing') ) then
        !gadget.val = !this.meHandraEngine.endSpacing
      elseif ( !gadget.name().eq('RADIUS') ) then
        !gadget.val = !this.meHandraEngine.radius
      endif
      !gadget.refresh()
      return
  --check if value is equal to zero
  elseif(!gadget.val.eq(0)) then
    !!alert.error('$!gadget.tag cannot accept a Zero value. Enter a positive value.')
      if ( !gadget.name().eq('POSTSPACING') ) then
        !gadget.val = !this.meHandraEngine.postSpacing
      elseif ( !gadget.name().eq('TANGENTSPACING') ) then
        !gadget.val = !this.meHandraEngine.tangentSpacing
      elseif ( !gadget.name().eq('endSpacing') ) then
        !gadget.val = !this.meHandraEngine.endSpacing
      elseif ( !gadget.name().eq('RADIUS') ) then
        !gadget.val = !this.meHandraEngine.radius
      endif
      !gadget.refresh()
      return
  endif

  --check if value lies with in the range
  if(!validationCriteria.setstatemax.set() and  !validationCriteria.setstatemin.set())then
    if ( !validationCriteria.setstatemax and !validationCriteria.setstatemin ) then
      if(!gadget.val.lt(!validationCriteria.min) or !gadget.val.gt(!validationCriteria.max))then
      !!alert.error('$!gadget.tag Value should lie in between min: $!validationCriteria.min and max: $!validationCriteria.max')
        if ( !gadget.name().eq('POSTSPACING') ) then
          !gadget.val = !this.meHandraEngine.postSpacing
        elseif ( !gadget.name().eq('TANGENTSPACING') ) then
          !gadget.val = !this.meHandraEngine.tangentSpacing
        elseif ( !gadget.name().eq('endSpacing') ) then
          !gadget.val = !this.meHandraEngine.endSpacing
        elseif ( !gadget.name().eq('RADIUS') ) then
          !gadget.val = !this.meHandraEngine.radius
        endif
      !gadget.refresh()
      return
      endif
    endif
  elseif ( !validationCriteria.setstatemax and !validationCriteria.setstatemin.not() ) then
    if(!gadget.val.gt(!validationCriteria.max))then
     !!alert.error('$!gadget.tag Value should not be greater than max: $!validationCriteria.max')
        if ( !gadget.name().eq('POSTSPACING') ) then
          !gadget.val = !this.meHandraEngine.postSpacing
        elseif ( !gadget.name().eq('TANGENTSPACING') ) then
          !gadget.val = !this.meHandraEngine.tangentSpacing
        elseif ( !gadget.name().eq('endSpacing') ) then
          !gadget.val = !this.meHandraEngine.endSpacing
        elseif ( !gadget.name().eq('RADIUS') ) then
          !gadget.val = !this.meHandraEngine.radius
        endif
      !gadget.refresh()
      return
    endif
  elseif ( !validationCriteria.setstatemax.not() and !validationCriteria.setstatemin ) then
    if(!gadget.val.lt(!validationCriteria.min))then
    !!alert.error('$!gadget.tag Value should not be lesser than min: $!validationCriteria.min')
        if ( !gadget.name().eq('POSTSPACING') ) then
          !gadget.val = !this.meHandraEngine.postSpacing
        elseif ( !gadget.name().eq('TANGENTSPACING') ) then
          !gadget.val = !this.meHandraEngine.tangentSpacing
        elseif ( !gadget.name().eq('endSpacing') ) then
          !gadget.val = !this.meHandraEngine.endSpacing
        elseif ( !gadget.name().eq('RADIUS') ) then
          !gadget.val = !this.meHandraEngine.radius
        endif
      !gadget.refresh()
      return
    endif
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateDataHandra
--
-- Description: updates the limits
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDataHandra(!gadget is GADGET, !action is STRING)

  --set the data for object
  if ( !gadget.name().eq('POSTSPACING') ) then
    !this.meHandraEngine.postSpacing = !gadget.val
  elseif ( !gadget.name().eq('TANGENTSPACING') ) then
    !this.meHandraEngine.tangentSpacing = !gadget.val
  elseif ( !gadget.name().eq('endSpacing') ) then
    !this.meHandraEngine.endSpacing = !gadget.val
  elseif ( !gadget.name().eq('RADIUS') ) then
    !this.meHandraEngine.radius = !gadget.val
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: setup the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setup(!title is STRING, !action is STRING, !handRaTmplReference is ASLHANDRAIL)

  --set the data for form
  -- Change form title
  !this.formTitle      = !title
  !this.action         = object BLOCK(!action)
  !this.meHandraEngine = !handRaTmplReference
  !this.updateGadgets()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  if !this.meHandraEngine.eq(!this.oldMeHandraEngine) then
  -- no changes have been made
    return
  endif

  !this.oldMeHandraEngine = !this.meHandraEngine

  -- Execute the action
  !this.action.evaluate()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateRailSpacing
--
-- Description: updates the rail spacing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRailSpacing()

  --set the rails spacing
  -- init
  !railSpacing = !this.meHandraEngine.railSpacing

  !gadget = !this.railSpacing

  !val = ARRAY()
  do !rail values !railSpacing
    !val.append(!rail.string(!!distanceFMT))
  enddo

  -- set gadget and editable status
  !gadget.val = !val

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      RailSpacing
--
-- Description: callback of rail spacing container
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setRailSpacing()

  !val = !this.railSpacing.val
  !spacing = ARRAY()
  do !space values !val
      !tmpReal = !this.stringToDistance(!space)
      handle ANY
        skip
      endhandle
      skip if !tmpReal.unset()
      !spacing.append(!tmpReal)
  enddo

  !this.meHandraEngine.railSpacing(!spacing)
    handle 1
      !!alert.error(!!error.text)
    elsehandle ANY
    endhandle


endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      stringToDistance
--
-- Description: convert distance in string to real in current units
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      string to be converted, e.g. '100 mm' or '15in'
--
-- Return:
--   [Data Type] [Description]
--    REAL        converted value in current distance unit
--
------------------------------------------------------------------------

define method .stringToDistance(!stringDist is STRING) is REAL

  !realDist = REAL()
  !error = 'Error conversion STRING ''''' & !stringDist & ''''' to a number'
  !realDist = object REAL(!stringDist , !!distanceFMT)
    handle ANY
      return error 1 '$!error'
  endhandle

  return !realDist

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      backToOptimum
--
-- Description: convert distance in string to real in current units
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      string to be converted, e.g. '100 mm' or '15in'
--
-- Return:
--   [Data Type] [Description]
--    REAL        converted value in current distance unit
--
-----------------------------------------------------------------------
define method .backToOptimum()

 --reset to old Value
  if !this.meHandraEngine.eq(!this.oldMeHandraEngine) then
  -- no changes have been made
    return
  endif

  !this.meHandraEngine = !this.oldMeHandraEngine

  !this.updateGadgets()

  !this.tmplReference()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateGadgetsOptimum
--
-- Description: sets the optimum values for the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateGadgetsOptimum()

  --set the value for the gadget
  --post spacing of the Handrail
  !postSpacingHandra = !this.meHandraEngine.criteria.postSpacing.optimum
  if ( !this.opPostSpacing.dText.empty() ) then
    !this.postSpacing.val   = !postSpacingHandra
  else
    !this.opPostSpacing.select('DTEXT', !postSpacingHandra.string())
  endif

  --tangent spacing of the Handrail
  !tangentSpacingHandra = !this.meHandraEngine.criteria.tangentSpacing.optimum
  if ( !this.opPostSpacing.dText.empty() ) then
    !this.tangentSpacing.val   = !tangentSpacingHandra
  else
    !this.opTangentSpacing.select('DTEXT', !tangentSpacingHandra.string())
  endif

  --endSpacing spacing of the Handrail
  !endSpacingHandra = !this.meHandraEngine.criteria.endSpacing.optimum
  if ( !this.opEndSpacing.dText.empty() ) then
    !this.endSpacing.val   = !endSpacingHandra
  else
    !this.opEndSpacing.select('DTEXT', !endSpacingHandra.string())
  endif

  --bend radius of the Handrail
  !bendRadiusHandra = !this.meHandraEngine.criteria.bRadius.optimum
  if ( !this.opRadius.dText.empty() ) then
    !this.radius.val   = !bendRadiusHandra
  else
    !this.opRadius.select('DTEXT', !bendRadiusHandra.string())
  endif

  --set the default railSpacing
  !this.updateRailSpacing()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      tmplReference
--
-- Description: callback of tmplReference option gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmplReference()

  !tmpl = !this.templates[!this.tmplReference.val]

  !this.meHandraEngine.tmplReference(!tmpl)

  -- set active status of gadgets
  !this.setGadgetActiveStatus(!this.postSpacing,!this.meHandraEngine.isPanelised.not())
  !this.setGadgetActiveStatus(!this.endSpacing,!this.meHandraEngine.isPanelised.not())
  !this.setGadgetActiveStatus(!this.tangentSpacing,!this.meHandraEngine.isPanelised.not())
  !this.setGadgetActiveStatus(!this.radius,!this.meHandraEngine.isPanelised.not())

  --update the gadgets
  !this.updateGadgets()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      settmplrefgadget
--
-- Description: set the reference to the template ref. list gadget and return list of templates
--
-- Method Type: function/procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      gadget to be referenced
--
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       list of available handrail templates
--
------------------------------------------------------------------------

define method .setTmplrefGadget(!gadget is GADGET) is ARRAY

  !this.tmplReferenceGadget = !gadget

  !tmpl = !this.meHandraEngine.getTemplates()
  !gadget.dText = !tmpl.evaluate(object BLOCK('!tmpl[!evalindex].desc'))

  !this.updateTmplrefGadget(!tmpl)

  return !tmpl

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      updatetmplrefgadget
--
-- Description: update the template reference list gadget with current value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       list of templates (DBREF ARRAY)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateTmplrefGadget(!tmplList is ARRAY)

  if !this.tmplReferenceGadget.unset() then
    return
  endif

  !value = !tmplList.findfirst(!this.meHandraEngine.tmplReference)
  if !value.unset() then
    !tmplList.append(!this.tmplReference)
    !dText = !this.tmplReferenceGadget.dText
    !dText.append(!this.meHandraEngine.tmplReference.desc)
    !this.tmplReferenceGadget.dText = !dText
    !value = !dText.size()
    -- display warning
    !!alert.warning('Handrail template "' & !this.meHandraEngine.tmplReference.desc & '" is not in ASL selection. Contact your ASL administrator.')
  endif
  !this.tmplReferenceGadget.val = !value

endmethod
-- end of method
------------------------------------------------------------------------
--
-- Method:      setGadgetActiveStatus
--
-- Description: set active status of the gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      gadget to be set
--    2   R      BOOLEAN     active status
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setGadgetActiveStatus(!gadget is GADGET, !active is BOOLEAN)

  if !gadget.unset() then
    return
  endif

  !gadget.active = !active
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
