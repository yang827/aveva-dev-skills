define method .updateFrameChangeLandingDB()

  --navigate to the frame accordingly to the rtoggle
  if ( !this.createTwrStl.val.eq(true) ) then
    !this.frameChange(!this.frMain2)
  elseif( !this.skipTwrStl.val.eq(true) ) then
    !this.frameChange(!this.frMain1)
  endif

endmethod
