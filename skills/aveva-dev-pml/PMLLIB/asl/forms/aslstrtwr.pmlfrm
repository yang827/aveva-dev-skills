  !allLevels      = !this.meStrTwrEngine.getFflLevelStrTwr()
  !strTwrPosition = !this.meStrTwrEngine.getPosition()

  !test = object REAL(!new[0], !!distanceFmt)
  handle (2,441)
    !new[3] = false
    !!alert.error('Field Accepts only real value')
    return
  endhandle
  if ( !test.unset() ) then
    !new[3] = false
    !!alert.error('Field Accepts only real value')
    return
  endif

  if ( object REAL ( !new[0], !!distanceFmt ) gt !this.txZLengthStrTwrSub.val ) then
    !new[3] = false
    !!alert.error('Entered Finished Floor Level is greater than the Tower Z Length.')
    return
  elseif ( ( object REAL ( !new[0], !!distanceFmt ) + !strTwrPosition.up ) lt !strTwrPosition.up ) then
    !new[3] = false
    !!alert.error('Entered Finished Floor Level is Less than the Origin of the Stair Tower.')
    return
  elseif ( object REAL ( !new[0], !!distanceFmt ) eq(0) ) then
    !new[3] = false
    !!alert.error('Entered Finished Floor Level is Less than the minimum required Headroom Clearance.')
    return
  else
    do !i from 1 to !allLevels.size()
      if ( !allLevels[!i] eq object REAL ( !new[0], !!distanceFmt ) ) then
        !new[3] = false
        !!alert.error('Finished Floor Level entered already exists in the table.')
        return
      else
        !new[3] = true
      endif
        break if ( !new[3].eq(false) )
    enddo
  endif

  !!data1 = !new

endmethod
