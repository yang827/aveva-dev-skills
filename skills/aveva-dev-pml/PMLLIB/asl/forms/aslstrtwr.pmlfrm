---------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: ce-tracker
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--------------------------------------------------------------------------

define method .track()

  --make the linklabel inactive
  !this.lkCreateStrTwr.active = false
  !this.lkModifyStrTwr.active = false
  !this.lkDeleteStrTwr.active = false

  -- check if storage area is set for stair flight
  if(!!aslStoreTable.getStore('stairtower').badRef().not()) then
    !strTwrOwner = !!aslStoreTable.getStore('stairtower')
  else
    !strTwrOwner  = !this.getStrTwrOwner(!!ce)
  endif

  --check if stair tower owner is set
  if(!strTwrOwner.set() and !strTwrOwner.badRef().not()) then
    !this.lkCreateStrTwr.active = true
  endif

  --check if stair tower exists from the c
  !strTwr = !this.getStrTwrAbove(!!ce)

  --set the active status for the gadget
  if(!strTwr.set() and !strTwr.badRef().not()) then
    !this.lkModifyStrTwr.active = true
    !this.lkDeleteStrTwr.active = true
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      trackCheck
--
-- Description: check whether a certain element can be created
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      type of element to be created
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     flag
------------------------------------------------------------------------

define method .trackCheck(!type is STRING) is BOOLEAN

  -- check whether a stair tower could be created
  !flag             = false
  !referenceElement = !!ce
  do !i
    break if ( !referenceElement.type.eq('WORL') )

    if ( !referenceElement.list.findFirst(!type).set() ) then
      !flag = true
      break
    endif
    !referenceElement = !referenceElement.owner
  enddo

  return !flag

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: setup
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setup()

  -- Updates the coordinate system
  !this.updateCoordinateSystem()

  -- make frames active / inactive
  !this.frameChange(!this.frMain0)

  !this.updateLimitsTwrStl()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateLimitsStrTwr
--
-- Description: updates the limits
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateLimitsTwrStl()

  call !!fillCriterionGadgets(!this.txXLengthStrTwr,      !this.opXLengthStrTwr,      !this.meStrTwrEngine.strTwrCriteria.width)
  call !!fillCriterionGadgets(!this.txYLengthStrTwr,      !this.opYLengthStrTwr,      !this.meStrTwrEngine.strTwrCriteria.length)
  call !!fillCriterionGadgets(!this.txZLengthStrTwr,      !this.opZLengthStrTwr,      !this.meStrTwrEngine.strTwrCriteria.height)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateLimitsStrLng
--
-- Description: updates the limits
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateLimitsStrLng()

  call !!fillCriterionGadgets(!this.txXLengthStrTwrSub,      !this.opXLengthStrTwrSub,      !this.meStrTwrEngine.strTwrCriteria.width)
  call !!fillCriterionGadgets(!this.txYLengthStrTwrSub,      !this.opYLengthStrTwrSub,      !this.meStrTwrEngine.strTwrCriteria.length)
  call !!fillCriterionGadgets(!this.txZLengthStrTwrSub,      !this.opZLengthStrTwrSub,      !this.meStrTwrEngine.strTwrCriteria.height)
  call !!fillCriterionGadgets(!this.txCLXSpacingStrTwr,      !this.opCLXSpacingStrTwr,      !this.meStrTwrEngine.strTwrCriteria.clXSpacing)
  call !!fillCriterionGadgets(!this.txCLYSpacingStrTwr,      !this.opCLYSpacingStrTwr,      !this.meStrTwrEngine.strTwrCriteria.clYSpacing)
  call !!fillCriterionGadgets(!this.txStrLngWidthStrTwr,     !this.opStrLngWidthStrTwr,     !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngCriteria.width)
  call !!fillCriterionGadgets(!this.txStrLngLengthStrTwr,    !this.opStrLngLengthStrTwr,    !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngCriteria.length)
  call !!fillCriterionGadgets(!this.txStrLngThkStrTwr,       !this.opStrLngThkStrTwr,       !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngCriteria.height)
  call !!fillCriterionGadgets(!this.txCLXSpacingStrFlt,      !this.opCLXSpacingStrFlt,      !this.meStrTwrEngine.strTwrCriteria.clXSpacing)
  call !!fillCriterionGadgets(!this.txCLYSpacingStrFlt,      !this.opCLYSpacingStrFlt,      !this.meStrTwrEngine.strTwrCriteria.clYSpacing)
  call !!fillCriterionGadgets(!this.txStrFltWidth,           !this.opStrFltWidth,           !this.meStrTwrEngine.strFltCriteria.width)

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      closeForm
--
-- Description:  closes the form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .closeForm()

  -- clears the whole graphical feedback
  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()

  --end EDG
  !!edgCntrl.remove('ASL EDG Pick')

  -- clear incomplete stair tower data if any
  !this.clearIncompleteStrTwr()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      clearIncompleteStrTwr
--
-- Description: Clears incomplete stair tower
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearIncompleteStrTwr()

    -- Delete the stair tower element if creation is aborted and returned to main
    !stairTowerReference  = !this.meStrTwrEngine.strTwrData.refe
    if(!stairTowerReference.set() and !stairTowerReference.members.unset()) then
      !!ce  = !stairTowerReference
      !this.deleteStrTwr()
    endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      deleteStrTwr
--
-- Description: delete stair tower
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deleteStrTwr()

 !undo = object UNDOABLE()
 !undo.description('Delete Stair Tower')
 !undo.add()


  -- check if you are below a strTwr element
  STRTWR
  handle ANY
    !!alert.warning('Navigate to Stair Tower hierarchy')
    return
  endhandle

  call !!aslEnhance(!!ce)

  !name = !!ce.flnm

  if ( !!alert.confirm('Ok  to  delete  $!name ?').eq('NO') ) then
    call !!aslUnEnhance(!!ce)
    return
  endif

  DELETE STRTWR

  !!aslCentralData.clearDimFeedback()
  !!aslCentralData.clearVolFeedback()
  !undo.endundoable()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      validationTextGadgets
--
-- Description: Validating the text gadgets.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     GADGET     Text Gadget to be validated
--    2    R     CRITERION  Validating Criteria for getting limits
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .validationTextGadgets(!gadget is GADGET,!validationCriteria is CRITERION)

  if ( !gadget.val.unset() ) then
    !!alert.error('$!gadget.tag cannot accept a Null or Unset value. Enter a positive value.')
      if ( !gadget.name() inset ( 'TXXLENGTHSTRTWR' , 'TXXLENGTHSTRTWRSUB' ) ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.xLength
      elseif ( !gadget.name() inset ( 'TXYLENGTHSTRTWR' , 'TXYLENGTHSTRTWRSUB' ) ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.yLength
      elseif ( !gadget.name() inset ( 'TXZLENGTHSTRTWR' , 'TXZLENGTHSTRTWRSUB' ) ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.zLength
      elseif ( !gadget.name().eq ('TXSTRLNGTHKSTRTWR') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk
      elseif ( !gadget.name().eq ('TXSTRLNGWIDTHSTRTWR') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
      elseif ( !gadget.name().eq ('TXSTRLNGLENGTHSTRTWR') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
      elseif ( !gadget.name().eq ('TXCLXSPACINGSTRFLT') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.fltClXSpacing
      elseif ( !gadget.name().eq ('TXCLYSPACINGSTRFLT') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.fltClYSpacing
      elseif ( !gadget.name().eq ('TXSTRFLTWIDTH') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.fltWidth
      endif
    return
  elseif(!gadget.val.lt(0))then
    !!alert.error('$!gadget.tag cannot accept a Negative value. Enter a positive value.')
      if ( !gadget.name() inset ( 'TXXLENGTHSTRTWR' , 'TXXLENGTHSTRTWRSUB' ) ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.xLength
      elseif ( !gadget.name() inset ( 'TXYLENGTHSTRTWR' , 'TXYLENGTHSTRTWRSUB' ) ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.yLength
      elseif ( !gadget.name() inset ( 'TXZLENGTHSTRTWR' , 'TXZLENGTHSTRTWRSUB' ) ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.zLength
      elseif ( !gadget.name().eq ('TXSTRLNGTHKSTRTWR') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk
      elseif ( !gadget.name().eq ('TXSTRLNGWIDTHSTRTWR') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
      elseif ( !gadget.name().eq ('TXSTRLNGLENGTHSTRTWR') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
      elseif ( !gadget.name().eq ('TXCLXSPACINGSTRFLT') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.fltClXSpacing
      elseif ( !gadget.name().eq ('TXCLYSPACINGSTRFLT') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.fltClYSpacing
      elseif ( !gadget.name().eq ('TXSTRFLTWIDTH') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.fltWidth
      endif
    return
  elseif(!gadget.val.eq(0)) then
    !!alert.error('$!gadget.tag cannot accept a Zero value. Enter a positive value.')
      if ( !gadget.name() inset ( 'TXXLENGTHSTRTWR' , 'TXXLENGTHSTRTWRSUB' ) ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.xLength
      elseif ( !gadget.name() inset ( 'TXYLENGTHSTRTWR' , 'TXYLENGTHSTRTWRSUB' ) ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.yLength
      elseif ( !gadget.name() inset ( 'TXZLENGTHSTRTWR' , 'TXZLENGTHSTRTWRSUB' ) ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.zLength
      elseif ( !gadget.name().eq ('TXSTRLNGTHKSTRTWR') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk
      elseif ( !gadget.name().eq ('TXSTRLNGWIDTHSTRTWR') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
      elseif ( !gadget.name().eq ('TXSTRLNGLENGTHSTRTWR') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
      elseif ( !gadget.name().eq ('TXCLXSPACINGSTRFLT') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.fltClXSpacing
      elseif ( !gadget.name().eq ('TXCLYSPACINGSTRFLT') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.fltClYSpacing
      elseif ( !gadget.name().eq ('TXSTRFLTWIDTH') ) then
        !gadget.val = !this.meStrTwrEngine.strTwrData.fltWidth
      endif
    return
  endif

  if(!validationCriteria.setstatemax.set() and  !validationCriteria.setstatemin.set())then
    if ( !validationCriteria.setstatemax and !validationCriteria.setstatemin ) then
      if(!gadget.val.lt(!validationCriteria.min) or !gadget.val.gt(!validationCriteria.max))then
        !!alert.error('$!gadget.tag Value should lie in between min: $!validationCriteria.min and max: $!validationCriteria.max')
          if ( !gadget.name() inset ( 'TXXLENGTHSTRTWR' , 'TXXLENGTHSTRTWRSUB' ) ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.xLength
          elseif ( !gadget.name() inset ( 'TXYLENGTHSTRTWR' , 'TXYLENGTHSTRTWRSUB' ) ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.yLength
          elseif ( !gadget.name() inset ( 'TXZLENGTHSTRTWR' , 'TXZLENGTHSTRTWRSUB' ) ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.zLength
          elseif ( !gadget.name().eq ('TXSTRLNGTHKSTRTWR') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk
          elseif ( !gadget.name().eq ('TXSTRLNGWIDTHSTRTWR') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
          elseif ( !gadget.name().eq ('TXSTRLNGLENGTHSTRTWR') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
          elseif ( !gadget.name().eq ('TXCLXSPACINGSTRFLT') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.fltClXSpacing
          elseif ( !gadget.name().eq ('TXCLYSPACINGSTRFLT') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.fltClYSpacing
          elseif ( !gadget.name().eq ('TXSTRFLTWIDTH') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.fltWidth
          endif
        return
      endif
    elseif ( !validationCriteria.setstatemax and !validationCriteria.setstatemin.not() ) then
      if(!gadget.val.gt(!validationCriteria.max))then
        !!alert.error('$!gadget.tag Value should not be greater than max: $!validationCriteria.max')
          if ( !gadget.name() inset ( 'TXXLENGTHSTRTWR' , 'TXXLENGTHSTRTWRSUB' ) ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.xLength
          elseif ( !gadget.name() inset ( 'TXYLENGTHSTRTWR' , 'TXYLENGTHSTRTWRSUB' ) ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.yLength
          elseif ( !gadget.name() inset ( 'TXZLENGTHSTRTWR' , 'TXZLENGTHSTRTWRSUB' ) ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.zLength
          elseif ( !gadget.name().eq ('TXSTRLNGTHKSTRTWR') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk
          elseif ( !gadget.name().eq ('TXSTRLNGWIDTHSTRTWR') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
          elseif ( !gadget.name().eq ('TXSTRLNGLENGTHSTRTWR') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
          elseif ( !gadget.name().eq ('TXCLXSPACINGSTRFLT') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.fltClXSpacing
          elseif ( !gadget.name().eq ('TXCLYSPACINGSTRFLT') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.fltClYSpacing
          elseif ( !gadget.name().eq ('TXSTRFLTWIDTH') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.fltWidth
          endif
       return
      endif
    elseif ( !validationCriteria.setstatemax.not() and !validationCriteria.setstatemin ) then
      if(!gadget.val.lt(!validationCriteria.min))then
        !!alert.error('$!gadget.tag Value should not be lesser than min: $!validationCriteria.min')
          if ( !gadget.name() inset ( 'TXXLENGTHSTRTWR' , 'TXXLENGTHSTRTWRSUB' ) ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.xLength
          elseif ( !gadget.name() inset ( 'TXYLENGTHSTRTWR' , 'TXYLENGTHSTRTWRSUB' ) ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.yLength
          elseif ( !gadget.name() inset ( 'TXZLENGTHSTRTWR' , 'TXZLENGTHSTRTWRSUB' ) ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.zLength
          elseif ( !gadget.name().eq ('TXSTRLNGTHKSTRTWR') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk
          elseif ( !gadget.name().eq ('TXSTRLNGWIDTHSTRTWR') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
          elseif ( !gadget.name().eq ('TXSTRLNGLENGTHSTRTWR') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
          elseif ( !gadget.name().eq ('TXCLXSPACINGSTRFLT') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.fltClXSpacing
          elseif ( !gadget.name().eq ('TXCLYSPACINGSTRFLT') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.fltClYSpacing
          elseif ( !gadget.name().eq ('TXSTRFLTWIDTH') ) then
            !gadget.val = !this.meStrTwrEngine.strTwrData.fltWidth
          endif
        return
      endif
    endif
  endif

endmethod
-- End of method
----------------------------------------------------------------------------
-- Method:           updateCoordinateSystem
--
-- Description: update the position and direction gadgets to display
-- current coordinate system
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
---------------------------------------------------------------------------
define method .updateCoordinateSystem()

  --Load ship grid data
  !grid                       = object SHIPGRID()
  !gridDefined                = !grid.position.set()
  -- Only populate the grid data if a ship reference grid is available
   if(!gridDefined) then
      !this.strTwrPosControl.gridFormat()
      --!this.strFltPosCtrl1.gridFormat()
      --!this.strFltPosCtrl2.gridFormat()
   else
     var !coordinate coordinate
     if(!coordinate.eq('ENU'))then
       !this.strTwrPosControl.enuFormat()
       --!this.strFltPosCtrl1.enuFormat()
       --!this.strFltPosCtrl2.enuFormat()
     else
       !this.strTwrPosControl.xyzFormat()
       --!this.strFltPosCtrl1.xyzFormat()
       --!this.strFltPosCtrl2.xyzFormat()
     endif
   endif
endmethod
------------------------------------------------------------------------
--
-- Method:      frameChange
--
-- Description: make the main frames visible/invisible
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the gadget to be visible
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .frameChange(!gadget is GADGET)

  if (!gadget.eq(!this.frMain0)) then
    -- check if there is a setting, otherwise it does not make sense to create a stairTower
    if ( !!aslCentralData.currSetting.unset() ) then
      return error 1 'There is no ASL selection. Ask your ASL administrator.'
    endif

    if ( !!aslCentralData.currSetting.collectAll('STRFLT').empty() ) then
      return error 2 'There are no stair flights in the ASL selection. Ask your ASL administrator.'
    endif

    if ( !!aslCentralData.currSetting.collectAll('STRLNG').empty() ) then
      return error 3 'There are no stair landings in the ASL selection. Ask your ASL administrator.'
    endif

    !!fmsys.setProgress(10)
    !this.frMain0.visible         = true
    !this.frMain1.visible         = false
    !this.frMain2.visible         = false
    !this.frMain3.visible         = false
    !this.frMain3Sub.visible      = false
    !this.frMain4.visible         = false
    !this.formTitle               = 'Main Stair Tower Tasks'

    -- call method to clear incomplete stair tower, if any
    !this.clearIncompleteStrTwr()
    !!fmsys.setProgress(30)

    --valid check
    !this.ceValidCheck()
    !!fmsys.setProgress(50)

    --unset the refe in the strTwrData
    !this.meStrTwrEngine.strTwrData.refe = object DBREF()
    !this.track()

    -- hide all aid lines
    !!aslCentralData.clearFeedBack('AIDVOLDATUM')
    !!aslCentralData.clearFeedBack('AIDVOLMAINSTRTWR')
    !!aslCentralData.clearFeedBack('AIDVOLSTRTWR')
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
    !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
    !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
    !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')
    !!aslCentralData.clearFeedBack('AIDVOLSTRFLT')
    !!aslCentralData.clearFeedBack('AIDDIM')
    !!aslCentralData.clearFeedBack('AIDVOLENVELOPE')
    !!aslCentralData.clearFeedBack('AIDVOLMAIN')

    if(defined(!!aslStrHandraDetails) ) then
      !!aslStrHandraDetails.hide()
    endif

    if(defined(!!pltSpecification) ) then
      !!pltSpecification.hide()
    endif

    !!fmsys.setProgress(70)

    !!fmsys.setProgress(100)
    !!fmsys.setProgress(0)

  elseif ( !gadget.eq(!this.frMain1) ) then

    !!fmsys.setProgress(10)
    !this.frMain0.visible         = false
    !this.frMain1.visible         = true
    !this.frMain2.visible         = false
    !this.frMain3.visible         = false
    !this.frMain3Sub.visible      = false
    !this.frMain4.visible         = false
    !!fmsys.setProgress(20)

    --navigate to the stair tower
    !this.ceValidCheck()
    !this.track()

    -- hide all aid lines
    !!aslCentralData.clearFeedBack('AIDVOLDATUM')
    !!aslCentralData.clearFeedBack('AIDVOLMAINSTRTWR')
    !!aslCentralData.clearFeedBack('AIDVOLSTRTWR')
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
    !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
    !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
    !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')
    !!aslCentralData.clearFeedBack('AIDVOLSTRFLT')
    !!aslCentralData.clearFeedBack('AIDDIM')

    --fill the stair tower definition Gadget
    !this.updateFrMain1StrTwr()

     --draw the datum Details
    !this.drawDatum()
    !!fmsys.setProgress(100)
    if ( !this.meStrTwrEngine.strTwrData.refe.set() ) then
      --show ce
      !!ce = !this.meStrTwrEngine.strTwrData.refe
      --add ce
    endif

    !!fmsys.setProgress(0)

  elseif ( !gadget.eq(!this.frMain2) ) then

    !!fmsys.setProgress(50)
    !this.frMain0.visible          = false
    !this.frMain1.visible          = false
    !this.frMain2.visible          = true
    !this.frMain3.visible          = false
    !this.frMain3Sub.visible       = false
    !this.frMain4.visible          = false
    !!fmsys.setProgress(50)
    --navigate to the stair tower
    !this.ceValidCheck()
    !this.track()

    -- hide all aid lines
    !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
    !!aslCentralData.clearFeedBack('AIDVOLSTRTWR')

    --fill the Tower Layout Gadget
    !this.updateFrMain2TwrStl()
    !!fmsys.setProgress(100)
    --hide ce
    !!ce = !this.meStrTwrEngine.strTwrData.refe
    --rem all for ce

    if(defined(!!aslStrHandraDetails) ) then
      !!aslStrHandraDetails.hide()
    endif

    if(defined(!!pltSpecification) ) then
      !!pltSpecification.hide()
    endif

    !!fmsys.setProgress(0)

  elseif ( !gadget.eq(!this.frMain3) ) then
    !!fmsys.setProgress(87)
    !this.frMain0.visible          = false
    !this.frMain1.visible          = false
    !this.frMain2.visible          = false
    !this.frMain3.visible          = true
    !this.frMain3Sub.visible       = false
    !this.frMain4.visible          = false

    !this.track()
    -- hide all aid lines
    !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
    !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')
    !!aslCentralData.clearFeedBack('AIDDIM')
    !!aslCentralData.clearFeedBack('AIDVOLENVELOPE')
    !!aslCentralData.clearFeedBack('AIDVOLMAIN')
    !!aslCentralData.clearFeedBack('AIDVOLSTRFLT')
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')

    !!fmsys.setProgress(95)
    --hide ce
    !!ce = !this.meStrTwrEngine.strTwrData.refe
    --rem ce

    --fill the stair flight and stair landing Details
    !this.updateFrMain3StrTwr()

    --draw the datum Details
    --!this.drawDatum()
    !!fmsys.setProgress(98)
    --draw centre lines
    !this.drawCentreLines()

    --draw the volume
    !this.drawTowerVolume()
    !!fmsys.setProgress(100)

    --update the stair flight creation gadget
    !this.lkFrMain3Sub4.active = false
    !this.updLkFrMain3Sub4.active = false
    !this.modLkFrMain3Sub4.active = false

    if(defined(!!aslStrHandraDetails) ) then
      !!aslStrHandraDetails.hide()
    endif

    if(defined(!!pltSpecification) ) then
      !!pltSpecification.hide()
    endif

    !!fmsys.setProgress(0)

  elseif ( !gadget.eq(!this.frMain3Sub) ) then
    !this.frMain0.visible          = false
    !this.frMain1.visible          = false
    !this.frMain2.visible          = false
    !this.frMain3.visible          = false
    !this.frMain3Sub.visible       = true
    !this.frMain4.visible          = false

    !this.track()

    --hide ce
    !!ce = !this.meStrTwrEngine.strTwrData.refe
    --rem all for ce

    -- clear the aid Text
    !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')

    --fill the stair flight and stair landing Details
    !this.updateFrMain3SubStrTwr()

    if(defined(!!aslStrHandraDetails) ) then
      !!aslStrHandraDetails.hide()
    endif

    if(defined(!!pltSpecification) ) then
      !!pltSpecification.hide()
    endif

  elseif ( !gadget.eq(!this.frMain4) ) then
    !this.frMain0.visible          = false
    !this.frMain1.visible          = false
    !this.frMain2.visible          = false
    !this.frMain3.visible          = false
    !this.frMain3Sub.visible       = false
    !this.frMain4.visible          = true

    if ( !this.formMode.eq('CREATE') ) then
      !this.formTitle                = 'Create Intermediate Access points'
    elseif ( !this.formMode.eq('MODIFY') ) then
      !this.formTitle                = 'Modify Intermediate Access points'
    endif

    !this.track()
    --hide all aid lines
    !!aslCentralData.clearFeedBack('AIDVOLDATUM')
    !!aslCentralData.clearFeedBack('AIDVOLMAINSTRTWR')
    !!aslCentralData.clearFeedBack('AIDVOLSTRTWR')
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
    !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
    !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
    !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')
    !!aslCentralData.clearFeedBack('AIDVOLSTRFLT')
    !!aslCentralData.clearFeedBack('AIDDIM')

    --draw the datum Details
    !this.drawDatum()

  endif
    -- init the progress bar
  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      ceValidCheck
--
-- Description: Valid Check for the Current Element, Referring to stair tower
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ceValidCheck()

  --Collects the Stair Tower Reference

  -- Check if the Current Element Type is Stair Tower
  if(!!ce.type.eq('STRTWR')) then
    return
  elseif( !this.meStrTwrEngine.strTwrData.refe.set() and !this.meStrTwrEngine.strTwrData.refe.badRef().not() ) then
    -- Navigate to the Stair Tower
    !!ce = !this.meStrTwrEngine.strTwrData.refe
  else
    !this.meStrTwrEngine.strTwrData.refe = object DBREF()
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      senseStrTwr
--
-- Description: open callback from install option gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .senseStrTwr(!gadget is GADGET, !action is STRING)

  -- get the respective toggle gadget
  !toggleGadget = !this.attribute('TO' & !gadget.name().subString(3))

  -- if toggle is already switched on then return
  if ( !gadget.neq(!toggleGadget) and $
       !toggleGadget.val          or  $
       !gadget.eq(!toggleGadget)  and $
       !action.eq('UNSELECT') ) then
    !toggleGadget.val     = true
    return
  endif

  -- Setting the installation sense attribute for toggle change
  if (!gadget.name() inset ('TOCLOCKWISESTRTWR' , 'LKCLOCKWISESTRTWR')) then
    !sense = true
    !this.meStrTwrEngine.setClockwise(!sense)
  elseif(!gadget.name() inset ('TOANTICLOCKWISESTRTWR' , 'LKANTICLOCKWISESTRTWR')) then
    !sense = false
    !this.meStrTwrEngine.setClockwise(!sense)
  endif

  -- switch off all sense option toggle gadgets
  !this.toClockwiseStrTwr.val     = false
  !this.toAntiClockwiseStrTwr.val = false

  -- switch on the toggle gadget
  !toggleGadget.val = true

  -- pass the gadget and the action
  do !i to 4
    if ( !this.attribute('TOINSTALLOPTIONSTRTWR' & !i).val.eq(true) ) then
      !gadgetVal = !this.toInstallOptionStrTwr$!<i>
      !act       = 'SELECT'
      !this.installOptionStrTwr(!gadgetVal, !act)
    endif
  enddo

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      installOptionStrTwr
--
-- Description: open callback from install option gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .installOptionStrTwr(!gadget is GADGET, !action is STRING)

  -- get the respective toggle gadget
  !toggleGadget = !this.attribute('TO' & !gadget.name().subString(3))

  -- if toggle is already switched on then return
  if ( !gadget.neq(!toggleGadget) and $
       !toggleGadget.val          or  $
       !gadget.eq(!toggleGadget)  and $
       !action.eq('UNSELECT') ) then
    !toggleGadget.val     = true
    return
  endif

  -- switch off all install option toggle gadgets
  do !i to 4
    !this.attribute('TOINSTALLOPTIONSTRTWR' & !i).val = false
  enddo

  -- switch on the toggle gadget
  !toggleGadget.val = true
  !this.meStrTwrEngine.setInstallationOption(!toggleGadget.tag)
  !!fmsys.setProgress(10)
  --check for the installation option and change the value accordingly
  !this.checkInstallationoption()

  --updating the graphical aids
  --clear aids if ANY
  !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
  !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
  !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
  !!aslCentralData.clearFeedBack('AIDDIM')

  --update the tie beam profile Data
  !this.updateTieBeamProfileData()
   !!fmsys.setProgress(60)
  --draw the ffl level aid
  !this.drawFflLevelAid()

  --update the handrail profile
  !this.updateHandrailLngProfile()
  if ( !this.toHandraProfileAid.val.eq(true) ) then
    !this.drawHandraAids()
  endif
  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      deriveInstallationOptionsStrTwr
--
-- Description: Derive options from pick data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deriveInstallationOptionsStrTwr()

  -- evaluates the installation option
  !installationOptions = !this.meStrTwrEngine.getInstallationOptions()
  !installationLabels  = !installationOptions.first()
  !installationPixmaps = !installationOptions.last()

  -- fills the gadgets
  do !i index !installationLabels
    !this.attribute('TOINSTALLOPTIONSTRTWR' & !i).addPixmap(!installationPixmaps[!i])
    !this.attribute('TOINSTALLOPTIONSTRTWR' & !i).visible = true
    !this.attribute('TOINSTALLOPTIONSTRTWR' & !i).val     = false
    !this.attribute('TOINSTALLOPTIONSTRTWR' & !i).tag     = !installationLabels[!i]
  enddo

  -- switch on the first button if nothing has been selected yet
  !installOption = !this.meStrTwrEngine.getInstallationOption()
  !i             = !installationLabels.findFirst(!installOption)

  if (!this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.installationOption.set()) then
    !instOpt    = !installationLabels.findFirst(!this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.installationOption)
    if ( !instOpt.set() ) then
      !this.attribute('TOINSTALLOPTIONSTRTWR' & !instOpt).val = true
    else
      !this.toInstallOptionStrTwr2.val                  = true
      !this.meStrTwrEngine.setInstallationOption(!installationLabels.first())
    endif
  elseif ( !installOption.unset() or $!i.unset() ) then
    !this.toInstallOptionStrTwr2.val                  = true
    !this.meStrTwrEngine.setInstallationOption(!installationLabels.first())
  else
    !this.attribute('TOINSTALLOPTIONSTRTWR' & !i).val = true
    !this.meStrTwrEngine.setInstallationOption(!installOption)
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      deriveConfigurationType
--
-- Description: Derive options from pick data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return: R      DBREF     Stair tower Element
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deriveConfigurationType(!ref is DBREF)

  if ( !ref.set() ) then
    !collection = object COLLECTION()
    !collection.scope(!ref)
    !collection.type('TWRSTL')
    !result = !collection.results()

    if ( !result.set() ) then
      !this.createTwrStl.val = true
    else
      !collection = object COLLECTION()
      !collection.scope(!ref)
      !collection.type('STRLNG')
      !result = !collection.results()
      if ( !result.set() ) then
        !this.skipTwrStl.val   = true
      endif
    endif
  elseif ( !ref.unset() ) then
    return error 1 'Undefined or badRef'
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      checkname
--
-- Description: Valid Check for the Current Element, Referring to stair tower
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1    R    GADGET val  calling gadget value to check for name availability
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkName()

  -- Check if the Name already exists

  !checkName = !!checkName(!this.dbName.val, 'new')
    if (!checkName.set()) then
      !this.dbName.val = !checkName
    else
      !this.dbName.val = 'Unset'
    endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      chkdir
--
-- Description: check and manipulate the entered direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .chkdir(!gadget is GADGET, !action is STRING)

  --added to collect the primary direction from the stair tower data
  !tempStrTwrPrmdir = !this.meStrTwrEngine.strTwrData.prmDirection

  if ( !gadget.val.set() and !gadget.val.neq('') ) then
    --valid check for the direction and orientation of the stair tower
    if ( !gadget.val.upcase().eq('SOUTH') ) then
      !this.meStrTwrEngine.strTwrData.prmDirection   = !gadget.val.direction()
    elseif (matchwild(!gadget.val.upcase(), '*U*') or matchwild(!gadget.val.upcase(), '*D*') or matchwild(!gadget.val.upcase(), '*Z*')) then
      !!alert.error ('Orientate of Stair Tower in $!gadget.val Direction is not allowed.')
      !this.meStrTwrEngine.strTwrData.prmDirection   = !tempStrTwrPrmdir
      return
    else
      !this.meStrTwrEngine.strTwrData.prmDirection   = !gadget.val.direction()
      handle ANY
        !!alert.error ('Enter a Valid Direction.')
        !this.meStrTwrEngine.strTwrData.prmDirection = !tempStrTwrPrmdir
        return
      endhandle
    endif
  else
    !!alert.error('$!gadget.tag cannot accept Null Value')
    !this.txDirectionStrTwr.val = !tempStrTwrPrmdir.string().before('WRT')
    return
  endif

  --set the value to the Gadget
  !this.txDirectionStrTwr.val = !this.meStrTwrEngine.strTwrData.prmDirection.string().before('WRT')

  --set th orientation of the stair tower
  !this.meStrTwrEngine.setOrientation(object ORIENTATION('Y IS ' & !this.meStrTwrEngine.strTwrData.prmDirection & ' AND Z IS U'))

  --hide all aid lines
  !!aslCentralData.clearFeedBack('AIDVOLDATUM')

  --draw the datum Details
  !this.drawDatum()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      chkpos
--
-- Description: check and manipulate the entered direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .chkpos()

  -- Set input gadgets
  !evaluatedPosition        = object POSITION()
  !evaluatedPosition.origin = WORL
  !east                     = !this.strTwrPosControl.xyz()[0].string()
  !north                    = !this.strTwrPosControl.xyz()[1].string()
  !up                       = !this.strTwrPosControl.xyz()[2].string()
  !evaluatedPosition        = object POSITION('E $!east N $!north U $!up')

  !this.meStrTwrEngine.setPosition(!evaluatedPosition)

  --hide all aid lines
  !!aslCentralData.clearFeedBack('AIDVOLDATUM')

  --draw the datum Details
  !this.drawDatum()

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      voidModify
--
-- Description: check and manipulate the entered value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .voidModify()

  --check for the gadget and give the message
  !index = !this.nuFlightSegment.val
  --!!alert.error('Cannot change the Value')
  !lwp = !this.meStrTwrEngine.strTwrData.strFltObj[!index].lwp
  !uwp = !this.meStrTwrEngine.strTwrData.strFltObj[!index].uwp

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      pickPosition
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPosition()

  -- Initialise Variables
  !prompt               = 'Pick element to set Stair Tower Origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgStrTwrPosDescription
  !packet.remove        = true
  !packet.action        =  '!!' & !this.name() & '.position(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA  EDG Picked position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!data is EDGPOSITIONDATA)

  -- Initialise Variables
  !position  = !data.position.wrt(world)

  -- Set position
  !this.position(!position)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Update pos control gadget
  !this.strTwrPosControl.xyz(!position.east, !position.north, !position.up)

  !evaluatedPosition        = object POSITION()
  !evaluatedPosition.origin = WORL
  !east   = !this.strTwrPosControl.xyz()[0].string()
  !north  = !this.strTwrPosControl.xyz()[1].string()
  !up     = !this.strTwrPosControl.xyz()[2].string()
  !evaluatedPosition        = object POSITION('E $!east N $!north U $!up')

  !this.meStrTwrEngine.setPosition(!evaluatedPosition)

  --clear aids if ANY
  !!aslCentralData.clearFeedBack('AIDVOLDATUM')
  !!aslCentralData.clearFeedBack('AIDDIM')

  --draw the datum
  !this.drawDatum()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateStrTwrDB
--
-- Description: creates/updates STRTER element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateStrTwrDB()

  if ( !this.skipTwrStl.val.eq(false) and !this.createTwrStl.val.eq(false) ) then
    !!alert.message('Stair Tower Configuration Type unset!.')
    return
  elseif ( !this.createTwrStl.val.eq(true) and !this.skipTwrStl.val.eq(false) ) then
    --create stair Tower
    !this.meStrTwrEngine.strTwrData.updateStrTwrDB()
    --change the frame appropriately
    !this.frameChange(!this.frMain2)
  elseif ( !this.skipTwrStl.val.eq(true) and !this.createTwrStl.val.eq(false) ) then
    --create stair Tower
    !this.meStrTwrEngine.strTwrData.updateStrTwrDB()
    !this.frameChange(!this.frMain3)
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateFrMain1StrTwr
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrMain1StrTwr()

  !!fmsys.setProgress(30)
  !strTwrData           = !this.meStrTwrEngine.strTwrData
  if ( !strTwrData.unset() ) then
    return
  endif

  !!fmsys.setProgress(50)
  -- to manipulate the position
  !position                 = !this.meStrTwrEngine.getPosition()

  -- to manipulate the direction gadget of the stair tower
  !orientation                = !this.meStrTwrEngine.getOrientation()

  if(!this.meStrTwrEngine.strTwrData.prmDirection.set()) then
    !this.txDirectionStrTwr.val = !this.meStrTwrEngine.strTwrData.prmDirection.string().before(' WRT')
  else
    !this.txDirectionStrTwr.val = !orientation.yDir().string().before(' WRT')
  endif

  -- to manipulate the stair flight rotation (sense) clockwise or anti-clockwise
  !clockwise                      = !this.meStrTwrEngine.getClockwise()
  !this.toClockwiseStrTwr.val     = !clockwise
  !this.toAntiClockwiseStrTwr.val = !clockwise.not()
  !!fmsys.setProgress(75)
  --update the rtoggle message as per the change
  if ( !this.formMode.eq('CREATE') and !this.meStrTwrEngine.strTwrData.refe.unset() ) then
    if ( !this.createTwrStl.val.eq(true) ) then
      !this.message.val            = 'Creates the Stair Tower layout and Supporting Steel structure.'
      !this.message.background     = 3
    endif
    !this.lkFrMain11.visible     = true
    !this.paFrMain11.visible     = true
    !this.lkFrMain11.active      = true
    !this.paFrMain11.active      = true
    !this.modLkFrMain11.visible  = false
    !this.updLkFrMain11.visible  = false
    !this.modPaFrMain11.visible  = false
    !this.updPaFrMain11.visible  = false
    !this.modLkFrMain11.active   = false
    !this.updLkFrMain11.active   = false
    !this.modPaFrMain11.active   = false
    !this.updPaFrMain11.active   = false
    !this.formTitle               = 'Create Stair Tower Definition'
  elseif ( !this.formMode.eq('CREATE') and !this.meStrTwrEngine.strTwrData.refe.set() ) then
    if ( !this.createTwrStl.val.eq(true) ) then
      !this.message.val            = 'Updates the Stair Tower layout and Supporting Steel structure.'
      !this.message.background     = 3
    endif
    !this.updLkFrMain11.visible  = true
    !this.updPaFrMain11.visible  = true
    !this.updLkFrMain11.active   = true
    !this.updPaFrMain11.active   = true
    !this.lkFrMain11.visible     = false
    !this.paFrMain11.visible     = false
    !this.modLkFrMain11.visible  = false
    !this.modPaFrMain11.visible  = false
    !this.lkFrMain11.active      = false
    !this.paFrMain11.active      = false
    !this.modLkFrMain11.active   = false
    !this.modPaFrMain11.active   = false
    !this.formTitle               = 'Update Stair Tower Definition'
  elseif ( !this.formMode.eq('MODIFY') ) then
    if ( !this.createTwrStl.val.eq(true) ) then
      !this.message.val            = 'Modifies the Stair Tower layout and Supporting Steel structure.'
      !this.message.background     = 40
    endif
    !this.modLkFrMain11.visible  = true
    !this.modPaFrMain11.visible  = true
    !this.modLkFrMain11.active   = true
    !this.modPaFrMain11.active   = true
    !this.lkFrMain11.visible     = false
    !this.paFrMain11.visible     = false
    !this.updLkFrMain11.visible  = false
    !this.updPaFrMain11.visible  = false
    !this.lkFrMain11.active      = false
    !this.paFrMain11.active      = false
    !this.updLkFrMain11.active   = false
    !this.updPaFrMain11.active   = false
    !this.formTitle               = 'Modify Stair Tower Definition'
  endif
  !!fmsys.setProgress(90)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateFrMain2TwrStl
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrMain2TwrStl()

  -- check for the existence of the landings
  if ( !this.meStrTwrEngine.strTwrData.refe.set() ) then
    var !resTwrStl coll all TWRSTL with PURP eq |COLU| for $!this.meStrTwrEngine.strTwrData.refe
  endif

  --update the gadget as per the change
  if ( ( !this.formMode.eq('CREATE') or !this.formMode.eq('MODIFY') ) and !resTwrStl.empty() ) then
    !this.lkFrMain23.visible     = true
    !this.paFrMain23.visible     = true
    !this.lkFrMain23.active      = true
    !this.paFrMain23.active      = true
    !this.modLkFrMain23.visible  = false
    !this.updLkFrMain23.visible  = false
    !this.modPaFrMain23.visible  = false
    !this.updPaFrMain23.visible  = false
    !this.modLkFrMain23.active   = false
    !this.updLkFrMain23.active   = false
    !this.modPaFrMain23.active   = false
    !this.updPaFrMain23.active   = false
    !this.formTitle              = 'Create Tower Steel Layout Definition'
  elseif ( !this.formMode.eq('CREATE') and !resTwrStl.set() ) then
    !this.updLkFrMain23.visible  = true
    !this.updPaFrMain23.visible  = true
    !this.updLkFrMain23.active   = true
    !this.updPaFrMain23.active   = true
    !this.lkFrMain23.visible     = false
    !this.paFrMain23.visible     = false
    !this.modLkFrMain23.visible  = false
    !this.modPaFrMain23.visible  = false
    !this.lkFrMain23.active      = false
    !this.paFrMain23.active      = false
    !this.modLkFrMain23.active   = false
    !this.modPaFrMain23.active   = false
    !this.formTitle               = 'Update Tower Steel Layout Definition'
  elseif ( !this.formMode.eq('MODIFY') ) then
    !this.modLkFrMain23.visible  = true
    !this.modPaFrMain23.visible  = true
    !this.modLkFrMain23.active   = true
    !this.modPaFrMain23.active   = true
    !this.lkFrMain23.visible     = false
    !this.paFrMain23.visible     = false
    !this.updLkFrMain23.visible  = false
    !this.updPaFrMain23.visible  = false
    !this.lkFrMain23.active      = false
    !this.paFrMain23.active      = false
    !this.updLkFrMain23.active   = false
    !this.updPaFrMain23.active   = false
    !this.formTitle              = 'Modify Tower Steel Layout Definition'
  endif

  --Initialise
  !strTwrData           = !this.meStrTwrEngine.strTwrData
  if ( !strTwrData.unset() ) then
    return
  endif

  -- update the gadgets
  ---------------------------------------------------------------------------
  -- to manipulate the Length
  !xLength = !this.meStrTwrEngine.getXLength()
  if ( !this.opXLengthStrTwr.dText.empty() ) then
    !this.txXLengthStrTwr.val   = !xLength
  else
    !this.opXLengthStrTwr.select('dText', !xLength.string())
  endif

  -- to manipulate the Width
  !yLength = !this.meStrTwrEngine.getYLength()
  if ( !this.opYLengthStrTwr.dText.empty() ) then
    !this.txYLengthStrTwr.val   = !yLength
  else
    !this.opYLengthStrTwr.select('dText', !yLength.string())
  endif

  -- to manipulate the Height
  !zLength = !this.meStrTwrEngine.getZLength()
  if ( !this.opZLengthStrTwr.dText.empty() ) then
    !this.txZLengthStrTwr.val   = !zLength
  else
    !this.opZLengthStrTwr.select('dText', !zLength.string())
  endif

  -- updates the limits
  !this.updateLimitsTwrStl()

  --update the beam levels of the stair tower based on Height
  !this.meStrTwrEngine.getBeamLevelStrTwr()
  !this.setFflLevelStrTwr()

  --update the profile data and aid graphics
  !this.updateBeamLevel()

  --update the profile data and aid graphics
  !this.updateColumnProfileData()
  !this.updateBeamProfileData()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateFrMain3StrTwr
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrMain3StrTwr()

  --derives the installation option
  !this.deriveInstallationOptionsStrTwr()

  --update the fold up Detail
  !this.frStrFltDetail.expanded    = false
  !this.frCatalogueStrTwr.expanded = false

  --unset the boolean object
  !this.meStrTwrEngine.strTwrData.evaluateSuccess    = object BOOLEAN()
  !this.meStrTwrEngine.strTwrData.evaluateStrFltAtt  = object BOOLEAN()

  --selecting the callback
  if ( !this.createTwrStl.val.eq(true) ) then
  	!this.paFrMain31.visible = false
  	!this.lkFrMain31.visible = false
  	!this.paFrMain32.visible = true
  	!this.lkFrMain32.visible = true
    --change the frame appropriately
    !this.txXLengthStrTwrSub.active = false
    !this.opXLengthStrTwrSub.active = false
    !this.txYLengthStrTwrSub.active = false
    !this.opYLengthStrTwrSub.active = false
    !this.txZLengthStrTwrSub.active = false
    !this.opZLengthStrTwrSub.active = false
    !this.txCLXSpacingStrTwr.active = false
    !this.opCLXSpacingStrTwr.active = false
    !this.txCLYSpacingStrTwr.active = false
    !this.opCLYSpacingStrTwr.active = false
  else
    !this.paFrMain32.visible = false
    !this.lkFrMain32.visible = false
    !this.paFrMain31.visible = true
    !this.lkFrMain31.visible = true
    --change the frame appropriately
    !this.txXLengthStrTwrSub.active = true
    !this.opXLengthStrTwrSub.active = true
    !this.txYLengthStrTwrSub.active = true
    !this.opYLengthStrTwrSub.active = true
    !this.txZLengthStrTwrSub.active = true
    !this.opZLengthStrTwrSub.active = true
    !this.txCLXSpacingStrTwr.active = false
    !this.opCLXSpacingStrTwr.active = false
    !this.txCLYSpacingStrTwr.active = false
    !this.opCLYSpacingStrTwr.active = false
  endif

  -- check for the existence of the landings
  if ( !this.meStrTwrEngine.strTwrData.refe.set() ) then
    !collectLng = object COLLECTION()
    !purpLng = object EXPRESSION(|PURP eq 'ILNG'|)
    !collectLng.type('STRLNG')
    !collectLng.filter(!purpLng)
    !collectLng.scope(!this.meStrTwrEngine.strTwrData.refe)
    !resultLng = !collectLng.results()
  endif

  --update the gadget as per the change
  if ( ( !this.formMode.eq('CREATE') or !this.formMode.eq('MODIFY') ) and !resultLng.empty() ) then
    !this.lkFrMain34.visible     = true
    !this.paFrMain34.visible     = true
    !this.lkFrMain34.active      = true
    !this.paFrMain34.active      = true
    !this.modLkFrMain34.visible  = false
    !this.updLkFrMain34.visible  = false
    !this.modPaFrMain34.visible  = false
    !this.updPaFrMain34.visible  = false
    !this.modLkFrMain34.active   = false
    !this.updLkFrMain34.active   = false
    !this.modPaFrMain34.active   = false
    !this.updPaFrMain34.active   = false
    !this.formTitle              = 'Create Stair Landing Layout Definition'
  elseif ( !this.formMode.eq('CREATE') and !resultLng.set() ) then
    !this.updLkFrMain34.visible  = true
    !this.updPaFrMain34.visible  = true
    !this.updLkFrMain34.active   = true
    !this.updPaFrMain34.active   = true
    !this.lkFrMain34.visible     = false
    !this.paFrMain34.visible     = false
    !this.modLkFrMain34.visible  = false
    !this.modPaFrMain34.visible  = false
    !this.lkFrMain34.active      = false
    !this.paFrMain34.active      = false
    !this.modLkFrMain34.active   = false
    !this.modPaFrMain34.active   = false
    !this.formTitle               = 'Update Stair Landing Layout Definition'
  elseif ( !this.formMode.eq('MODIFY') ) then
    !this.modLkFrMain34.visible  = true
    !this.modPaFrMain34.visible  = true
    !this.modLkFrMain34.active   = true
    !this.modPaFrMain34.active   = true
    !this.lkFrMain34.visible     = false
    !this.paFrMain34.visible     = false
    !this.updLkFrMain34.visible  = false
    !this.updPaFrMain34.visible  = false
    !this.lkFrMain34.active      = false
    !this.paFrMain34.active      = false
    !this.updLkFrMain34.active   = false
    !this.updPaFrMain34.active   = false
    !this.formTitle              = 'Modify Stair Landing Layout Definition'
  endif

  !strTwrData           = !this.meStrTwrEngine.strTwrData
  if ( !strTwrData.unset() ) then
    return
  endif

  -- update the gadgets
  ---------------------------------------------------------------------------
  -- to manipulate the Length
  !xLength = !this.meStrTwrEngine.getXLength()
  if ( !this.opXLengthStrTwrSub.dText.empty() ) then
    !this.txXLengthStrTwrSub.val   = !xLength
  else
    !this.opXLengthStrTwrSub.select('dText', !xLength.string())
  endif

  -- to manipulate the Width
  !yLength = !this.meStrTwrEngine.getYLength()
  if ( !this.opYLengthStrTwrSub.dText.empty() ) then
    !this.txYLengthStrTwrSub.val   = !yLength
  else
    !this.opYLengthStrTwrSub.select('dText', !yLength.string())
  endif

  -- to manipulate the Height
  !zLength = !this.meStrTwrEngine.getZLength()
  if ( !this.opZLengthStrTwrSub.dText.empty() ) then
    !this.txZLengthStrTwrSub.val   = !zLength
  else
    !this.opZLengthStrTwrSub.select('dText', !zLength.string())
  endif

  -- to manipulate the centre line (X) Spacing
  !clXSpacing = !this.meStrTwrEngine.getCLXSpacing()
  if ( !this.opCLXSpacingStrTwr.dText.empty() ) then
    !this.txCLXSpacingStrTwr.val = !clXSpacing
    !this.meStrTwrEngine.setCLXSpacing(!this.txCLXSpacingStrTwr.val)
  else
    !this.opCLXSpacingStrTwr.select('dText', !clXSpacing.string())
  endif

  -- to manipulate the centre line (Y) Spacing
  !clYSpacing = !this.meStrTwrEngine.getCLYSpacing()
  if ( !this.opCLYSpacingStrTwr.dText.empty() ) then
    !this.txCLYSpacingStrTwr.val = !clYSpacing
    !this.meStrTwrEngine.setCLYSpacing(!this.txCLYSpacingStrTwr.val)
  else
    !this.opCLYSpacingStrTwr.select('dText', !clYSpacing.string())
  endif

  -- to manipulate the landing Width
  !strLngWidth = !this.meStrTwrEngine.getStrLngWidth()
  if ( !this.opStrLngWidthStrTwr.dText.empty() ) then
    !this.txStrLngWidthStrTwr.val = !strLngWidth
  else
    !this.opStrLngWidthStrTwr.select('dText', !strLngWidth.string())
  endif

  -- to manipulate the landing Length
  !strLngLength = !this.meStrTwrEngine.getStrLngLength()
  if ( !this.opStrLngLengthStrTwr.dText.empty() ) then
    !this.txStrLngLengthStrTwr.val = !strLngLength
  else
    !this.opStrLngLengthStrTwr.select('dText', !strLngLength.string())
  endif

  --to manipulate the landing thickness
  !strLngThk = !this.meStrTwrEngine.getStrLngThk()
  if ( !this.opStrLngThkStrTwr.dText.empty() ) then
    !this.txStrLngThkStrTwr.val = !strLngThk
  else
    !this.opStrLngThkStrTwr.select('dText', !strLngThk.string())
  endif

  --check for the existence of the tower steel
  if ( !this.createTwrStl.val.eq(true) ) then
    --update the ffl in the container
    !this.setFflLevelStrTwr()
    !this.neFflLevel.editableGrid(false)
    !this.lsFflLevelCreate.active = false
    !this.lsFflLevelDelete.active = false
    !this.lsFflLevelPosi.active   = false

    --set the field property for the menu items
    !this.aslStrTwrFflPopup.setactive('Position FFL Level...', false)
    !this.aslStrTwrFflPopup.setactive('Remove FFL Level...', false)

  elseif ( !this.skipTwrStl.val.eq(true) ) then

    !collection = object COLLECTION()
    !collection.scope(!this.meStrTwrEngine.strTwrData.refe)
    !collection.type('TWRSTL')
    !result = !collection.results()

    --update the ffl in the container
    !this.setFflLevelStrTwr()

    if ( !result.empty() ) then
      !this.neFflLevel.editableGrid(true)
      !this.lsFflLevelCreate.visible = true
      !this.lsFflLevelCreate.active  = true
      !this.lsFflLevelDelete.visible = true
      !this.lsFflLevelDelete.active  = false
      !this.lsFflLevelPosi.visible   = true
      !this.lsFflLevelPosi.active    = false
    elseif ( !result.empty().not() ) then
      !this.neFflLevel.editableGrid(false)
      !this.lsFflLevelCreate.active  = false
      !this.lsFflLevelDelete.active  = false
      !this.lsFflLevelPosi.active    = false
    endif
  endif

  --update the grid data for ffl Landing
  !this.updateFflLevel()

  -- updates the limits
  !this.updateLimitsStrLng()

  --call the check condition for the gadget landing Width
  !this.checkInstallationoption()

  --call the check condition for the gadget landing SPEC
  !this.checkLandingCatalogue()

  -- update the aid for FFL
  !this.drawFflLevelAid()

  --update the tie beam profile data
  !this.updateTieBeamProfileData()

  --update the handrail profile
  !this.updateHandrailLngProfile()

  if ( !this.toHandraProfileAid.val.eq(true) ) then
    !this.drawHandraAids()
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateFrMain3SubStrTwr
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFrMain3SubStrTwr()

  -- check for the existence of the landings
  if ( !this.meStrTwrEngine.strTwrData.refe.set() ) then
    !collectFlt = object COLLECTION()
    --!purpFlt    = object EXPRESSION(|PURP eq 'TFLT'|)
    !collectFlt.type('STRFLT')
    --!collectFlt.filter(!purpFlt)
    !collectFlt.scope(!this.meStrTwrEngine.strTwrData.refe)
    !resultFlt = !collectFlt.results()
  endif

  --update the cata options for stair Flight
  !this.updateCataOptionsStrFlt()
  !this.opFltHandRaTmplReference.active = false

  --unset the boolean object
  !this.meStrTwrEngine.strTwrData.evaluateSuccess    = object BOOLEAN()
  !this.meStrTwrEngine.strTwrData.evaluateStrFltAtt  = object BOOLEAN()

  --clear the list gadget
  !this.lsAttStrFlt.clear()
  --!this.buEvalFltSpacing.active = true

  --get the installation Type
  !instOpt = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.installationOption

  --update the gadget for centreline Spacing
  if ( !instOpt.eq('Two stairs, platform north and south') ) then
    !this.txCLYSpacingStrFlt.active = false
    !this.txCLXSpacingStrFlt.active = true
  elseif ( !instOpt.eq('One stair, stair north') ) then
    !this.txCLYSpacingStrFlt.active = true
    !this.txCLXSpacingStrFlt.active = false
  else
    !this.txCLXSpacingStrFlt.active = true
    !this.txCLYSpacingStrFlt.active = true
  endif

  --update the gadget as per the change
  if ( ( !this.formMode.eq('CREATE') or !this.formMode.eq('MODIFY') ) and !resultFlt.empty() ) then
    !this.lkFrMain3Sub4.visible     = true
    !this.paFrMain3Sub4.visible     = true
    !this.lkFrMain3Sub4.active      = false
    !this.paFrMain3Sub4.active      = true
    !this.modLkFrMain3Sub4.visible  = false
    !this.updLkFrMain3Sub4.visible  = false
    !this.modPaFrMain3Sub4.visible  = false
    !this.updPaFrMain3Sub4.visible  = false
    !this.modLkFrMain3Sub4.active   = false
    !this.updLkFrMain3Sub4.active   = false
    !this.modPaFrMain3Sub4.active   = false
    !this.updPaFrMain3Sub4.active   = false
    !this.paEvalFlt.active          = true
    !this.paEvalFlt.visible         = true
    !this.paReEvalFlt.active        = false
    !this.paReEvalFlt.visible       = false
    !this.buEvalFlt.active          = true
    !this.buEvalFlt.visible         = true
    !this.buReEvalFlt.active        = false
    !this.buReEvalFlt.visible       = false
    !this.formTitle                 = 'Create Stair Flight Layout Definition'
  elseif ( !this.formMode.eq('CREATE') and !resultFlt.set() ) then
    !this.updLkFrMain3Sub4.visible  = true
    !this.updPaFrMain3Sub4.visible  = true
    !this.updLkFrMain3Sub4.active   = false
    !this.updPaFrMain3Sub4.active   = true
    !this.lkFrMain3Sub4.visible     = false
    !this.paFrMain3Sub4.visible     = false
    !this.modLkFrMain3Sub4.visible  = false
    !this.modPaFrMain3Sub4.visible  = false
    !this.lkFrMain3Sub4.active      = false
    !this.paFrMain3Sub4.active      = false
    !this.modLkFrMain3Sub4.active   = false
    !this.modPaFrMain3Sub4.active   = false
    !this.paReEvalFlt.active        = true
    !this.paReEvalFlt.visible       = true
    !this.buEvalFlt.active          = false
    !this.buEvalFlt.visible         = false
    !this.buReEvalFlt.active        = true
    !this.buReEvalFlt.visible       = true
    !this.formTitle               = 'Update Stair Flight Layout Definition'
  elseif ( !this.formMode.eq('MODIFY') ) then
    !this.modLkFrMain3Sub4.visible  = true
    !this.modPaFrMain3Sub4.visible  = true
    !this.modLkFrMain3Sub4.active   = false
    !this.modPaFrMain3Sub4.active   = true
    !this.lkFrMain3Sub4.visible     = false
    !this.paFrMain3Sub4.visible     = false
    !this.updLkFrMain3Sub4.visible  = false
    !this.updPaFrMain3Sub4.visible  = false
    !this.lkFrMain3Sub4.active      = false
    !this.paFrMain3Sub4.active      = false
    !this.updLkFrMain3Sub4.active   = false
    !this.updPaFrMain3Sub4.active   = false
    !this.paReEvalFlt.active        = true
    !this.paReEvalFlt.visible       = true
    !this.buEvalFlt.active          = false
    !this.buEvalFlt.visible         = false
    !this.buReEvalFlt.active        = true
    !this.buReEvalFlt.visible       = true
    !this.formTitle              = 'Modify Stair Flight Layout Definition'
  endif

  -- update the gadgets
  ---------------------------------------------------------------------------
  -- to manipulate centre line x Length
  !this.meStrTwrEngine.setFltCLXSpacing( !this.meStrTwrEngine.getCLXSpacing())
  !fltClxLength = !this.meStrTwrEngine.getFltCLXSpacing()
  if ( !this.opCLXSpacingStrFlt.dText.empty() ) then
    !this.txCLXSpacingStrFlt.val   = !fltClxLength
    !this.meStrTwrEngine.setFltCLXSpacing(!fltClxLength)
  else
    !this.opCLXSpacingStrFlt.select('dText', !fltClxLength.string())
  endif

  -- to manipulate centre line y Length
  !this.meStrTwrEngine.setFltCLYSpacing( !this.meStrTwrEngine.getCLYSpacing())
  !fltClyLength = !this.meStrTwrEngine.getFltCLYSpacing()
  if ( !this.opCLYSpacingStrFlt.dText.empty() ) then
    !this.txCLYSpacingStrFlt.val   = !fltClyLength
    !this.meStrTwrEngine.setFltCLYSpacing(!fltClyLength)
  else
    !this.opCLYSpacingStrFlt.select('dText', !fltClyLength.string())
  endif

  -- to manipulate flight Width
  !fltWidth = !this.meStrTwrEngine.getFltWidth()
  if ( !this.opStrFltWidth.dText.empty() ) then
    !this.txStrFltWidth.val   = !fltWidth
    !this.meStrTwrEngine.setFltWidth(!fltWidth)
  else
    !this.opStrFltWidth.select('dText', !fltWidth.string())
  endif

  !this.nuFlightSegment.modifiedEvents = true
  -- set the segment counter gadget
  !range[1] = 0
  !range[2] = 1
  !range[3] = 1
  !this.nuFlightSegment.range    = !range
  !this.nuFlightSegment.val      = 0
  !this.nuFlightSegment.active   = false
  !this.paFlightSegment.val      = ' of 0 '
  !this.paFlightSegment.active   = false
  !this.paGeneralAtt.active      = false
  !this.lnGeneralAtt.active      = false
  !this.buZoomFlt.active         = false
  !this.buWalkFlt.active         = true
  !this.toAidStrFltWidth.active  = false


  --update the cata options for stair Flight
  !this.updateCataOptionsStrFlt()
  !this.opFltHandRaTmplReference.active = false

  --update the graphical aids for the centre Line
  !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')
  !this.meStrTwrEngine.strTwrData.drawFltCentreLines()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      showDimTwrStl
--
-- Description: callback from view gadgets
--              set/unset all dimensions regarding value of  view gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimTwrStl(!gadget is GADGET, !action is STRING)

  -- fill the dimension object, depends on the form toggles
  !strTwrDimension               = object ASLSTRTWRDIM()

  !strTwrDimension.xLength       = !this.toAidXLengthStrTwr.val
  !strTwrDimension.yLength       = !this.toAidYLengthStrTwr.val
  !strTwrDimension.zLength       = !this.toAidZLengthStrTwr.val

  !this.meStrTwrEngine.strTwrDim = !strTwrDimension

  !this.meStrTwrEngine.showDimTwrStl()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      showDimStrLng
--
-- Description: callback from view gadgets
--              set/unset all dimensions regarding value of  view gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimStrLng(!gadget is GADGET, !action is STRING)

  -- fill the dimension object, depends on the form toggles
  !strTwrDimension               = object ASLSTRTWRDIM()

  !strTwrDimension.xLength       = !this.toAidXLengthTwr.val
  !strTwrDimension.yLength       = !this.toAidYLengthTwr.val
  !strTwrDimension.zLength       = !this.toAidZLengthTwr.val
  !strTwrDimension.clXSpacing    = !this.toAidCLXSpacingStrTwr.val
  !strTwrDimension.clYSpacing    = !this.toAidCLYSpacingStrTwr.val
  !strTwrDimension.lngLength     = !this.toAidStrLngLengthStrTwr.val
  !strTwrDimension.lngWidth      = !this.toAidStrLngWidthStrTwr.val
  !strTwrDimension.lngThk        = !this.toAidStrLngThkStrTwr.val

  !this.meStrTwrEngine.strTwrDim = !strTwrDimension

  !this.meStrTwrEngine.showDimStrLng()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      showDimStrFlt
--
-- Description: callback from view gadgets
--              set/unset all dimensions regarding value of  view gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the calling gadget
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimStrFlt(!gadget is GADGET, !action is STRING)

  -- fill the dimension object, depends on the form toggles
  !strTwrDimension               = object ASLSTRTWRDIM()

  !strTwrDimension.fltClXSpacing    = !this.toAidCLXSpacingStrFlt.val
  !strTwrDimension.fltClYSpacing    = !this.toAidCLYSpacingStrFlt.val
  !strTwrDimension.strFltWidth      = !this.toAidStrFltWidth.val

  !this.meStrTwrEngine.strTwrDim = !strTwrDimension

  !this.meStrTwrEngine.showDimStrFlt()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyTwrStlAtt
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyTwrStlAtt(!gadget is GADGET, !action is STRING)

  if ( !action.eq('SELECT') ) then
    --Added to Check the Validity of the Current Element to Be Stair Tower
    !this.ceValidCheck()

    -- check statement for stair tower x length
    if ( !gadget.name().eq('TXXLENGTHSTRTWR') ) and ( !this.opXLengthStrTwr.dText.empty() ) then
      if ( !gadget.val.eq(!this.meStrTwrEngine.strTwrData.xLength) ) then
        return
      endif
     !this.meStrTwrEngine.setXLength(!this.txXLengthStrTwr.val)
    elseif ( !gadget.name().eq('TXXLENGTHSTRTWR') ) and ( !this.opXLengthStrTwr.dText.empty().not() ) then
     !this.meStrTwrEngine.setXLength(!this.opXLengthStrTwr.selection().real())
    endif

    -- check statement for stair tower y length
    if ( !gadget.name().eq('TXYLENGTHSTRTWR') ) and ( !this.opYLengthStrTwr.dText.empty() ) then
      if ( !gadget.val.eq(!this.meStrTwrEngine.strTwrData.yLength) ) then
        return
      endif
     !this.meStrTwrEngine.setYLength(!this.txYLengthStrTwr.val)
    elseif ( !gadget.name().eq('TXYLENGTHSTRTWR') ) and ( !this.opYLengthStrTwr.dText.empty().not() ) then
     !this.meStrTwrEngine.setYLength(!this.opYLengthStrTwr.selection().real())
    endif

    -- check statement for Stair tower height
    if ( !gadget.name().eq('TXZLENGTHSTRTWR') ) and ( !this.opZLengthStrTwr.dText.empty() ) then
      if ( !gadget.val.eq(!this.meStrTwrEngine.strTwrData.zLength) ) then
        return
      endif
      !this.meStrTwrEngine.setZLength(!this.txZLengthStrTwr.val)
    elseif ( !gadget.name().eq('TXZLENGTHSTRTWR') ) and ( !this.opZLengthStrTwr.dText.empty().not() ) then
      !this.meStrTwrEngine.setZLength(!this.opZLengthStrTwr.selection().real())
    endif

    --update the beam levels of the stair tower based on Height
    !this.meStrTwrEngine.getBeamLevelStrTwr()
    !this.setFflLevelStrTwr()

    --update the profile data and aid graphics
    !this.updateBeamLevel()
    !this.updateColumnProfileData()
    !this.updateBeamProfileData()
  endif
  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyStrFltAtt
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyStrFltAtt(!gadget is GADGET, !action is STRING)

  if ( !action.eq('SELECT') ) then
    --Added to Check the Validity of the Current Element to Be Stair Tower
    !this.ceValidCheck()

    -- check statement for stair flight centerline x Spacing
    if ( !gadget.name().eq('TXCLXSPACINGSTRFLT') ) and ( !this.opCLXSpacingStrFlt.dText.empty() ) then
      if ( !gadget.val.eq(!this.meStrTwrEngine.strTwrData.fltClXSpacing) ) then
        return
      endif
     !this.meStrTwrEngine.setFltCLXSpacing(!this.txCLXSpacingStrFlt.val)
    elseif ( !gadget.name().eq('TXCLXSPACINGSTRFLT') ) and ( !this.opCLXSpacingStrFlt.dText.empty().not() ) then
     !this.meStrTwrEngine.setFltCLXSpacing(!this.opXLengthStrTwr.selection().real())
    endif

    -- check statement for stair flight centerline y Spacing
    if ( !gadget.name().eq('TXCLYSPACINGSTRFLT') ) and ( !this.opCLYSpacingStrFlt.dText.empty() ) then
      if ( !gadget.val.eq(!this.meStrTwrEngine.strTwrData.fltClYSpacing) ) then
        return
      endif
     !this.meStrTwrEngine.setFltCLYSpacing(!this.txCLYSpacingStrFlt.val)
    elseif ( !gadget.name().eq('TXCLYSPACINGSTRFLT') ) and ( !this.opCLYSpacingStrFlt.dText.empty().not() ) then
     !this.meStrTwrEngine.setFltCLYSpacing(!this.opCLYSpacingStrFlt.selection().real())
    endif

    -- check statement for stair flight Width
    if ( !gadget.name().eq('TXSTRFLTWIDTH') ) and ( !this.opStrFltWidth.dText.empty() ) then
      if ( !gadget.val.eq(!this.meStrTwrEngine.strTwrData.fltWidth) ) then
        return
      endif
     !this.meStrTwrEngine.setFltWidth(!this.txStrFltWidth.val)
     !this.toAidStrFltWidth.active  = false
    elseif ( !gadget.name().eq('TXSTRFLTWIDTH') ) and ( !this.opStrFltWidth.dText.empty().not() ) then
     !this.meStrTwrEngine.setFltWidth(!this.opStrFltWidth.selection().real())
    endif

    --update the profile data and aid graphics
    !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')
    !!aslCentralData.clearFeedBack('AIDVOLENVELOPE')
    !!aslCentralData.clearFeedBack('AIDVOLMAIN')
    !!aslCentralData.clearFeedBack('AIDVOLSTRFLT')
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
    !!aslCentralData.clearFeedBack('AIDVOLCL')
    !!aslCentralData.clearFeedBack('AIDVOLARROW')
    !!aslCentralData.clearFeedBack('AIDVOLPLANES')
    !this.meStrTwrEngine.strTwrData.drawFltCentreLines()

  endif
  !!fmsys.setProgress(0)

  --inactivate the icons and the links
  --!this.buEvalFltSpacing.active = true

  if ( !this.meStrTwrEngine.strTwrData.refe.set() ) then
    !collectFtl = object COLLECTION()
    !collectFtl.type('STRFLT')
    !collectFtl.scope(!this.meStrTwrEngine.strTwrData.refe)
    !resultFlt = !collectFtl.results()
  endif

  if ( ( !this.formMode.eq('CREATE') or !this.formMode.eq('MODIFY') ) and !resultFlt.empty() ) then
    !this.lkFrMain3Sub4.active      = false
    !this.lkFrMain3Sub4.visible     = true
    !this.updLkFrMain3Sub4.active   = false
    !this.updLkFrMain3Sub4.visible  = false
    !this.modLkFrMain3Sub4.active   = false
    !this.modLkFrMain3Sub4.visible  = false
    !this.paEvalFlt.active          = true
    !this.paEvalFlt.visible         = true
    !this.paReEvalFlt.active        = false
    !this.paReEvalFlt.visible       = false
    !this.buEvalFlt.active          = true
    !this.buEvalFlt.visible         = true
    !this.buReEvalFlt.active        = false
    !this.buReEvalFlt.visible       = false

  elseif ( !this.formMode.eq('CREATE') and !resultFlt.set() ) then
    !this.lkFrMain3Sub4.active      = false
    !this.lkFrMain3Sub4.visible     = false
    !this.updLkFrMain3Sub4.active   = false
    !this.updLkFrMain3Sub4.visible  = true
    !this.modLkFrMain3Sub4.active   = false
    !this.modLkFrMain3Sub4.visible  = false
    !this.paEvalFlt.active          = false
    !this.paEvalFlt.visible         = false
    !this.paReEvalFlt.active        = true
    !this.paReEvalFlt.visible       = true
    !this.buEvalFlt.active          = false
    !this.buEvalFlt.visible         = false
    !this.buReEvalFlt.active        = true
    !this.buReEvalFlt.visible       = true

  elseif ( !this.formMode.eq('MODIFY') ) then
    !this.lkFrMain3Sub4.active      = false
    !this.lkFrMain3Sub4.visible     = false
    !this.updLkFrMain3Sub4.active   = false
    !this.updLkFrMain3Sub4.visible  = false
    !this.modLkFrMain3Sub4.active   = false
    !this.modLkFrMain3Sub4.visible  = true
    !this.paEvalFlt.active          = false
    !this.paEvalFlt.visible         = false
    !this.paReEvalFlt.active        = true
    !this.paReEvalFlt.visible       = true
    !this.buEvalFlt.active          = false
    !this.buEvalFlt.visible         = false
    !this.buReEvalFlt.active        = true
    !this.buReEvalFlt.visible       = true
    !this.formTitle                 = 'Modify Stair Flight Layout Definition'
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyStrLngAtt
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyStrLngAtt(!gadget is GADGET, !action is STRING)

  if ( !action.eq('SELECT') ) then
    --Added to Check the Validity of the Current Element to Be Stair Tower
    !this.ceValidCheck()

    -- check statement for stair tower x length
    if ( !gadget.name().eq('TXXLENGTHSTRTWRSUB') ) and ( !this.opXLengthStrTwrSub.dText.empty() ) then
      if (!gadget.val.eq(!this.meStrTwrEngine.strTwrData.xLength) ) then
        return
      endif
     !this.meStrTwrEngine.setXLength(!this.txXLengthStrTwrSub.val)
     !this.meStrTwrEngine.strTwrData.clXSpacing = !gadget.val - !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
    elseif ( !gadget.name().eq('TXXLENGTHSTRTWRSUB') ) and ( !this.opXLengthStrTwrSub.dText.empty().not() ) then
     !this.meStrTwrEngine.setXLength(!this.opXLengthStrTwrSub.selection().real())
    endif

    -- check statement for stair tower y length
    if ( !gadget.name().eq('TXYLENGTHSTRTWRSUB') ) and ( !this.opYLengthStrTwrSub.dText.empty() ) then
      if (!gadget.val.eq(!this.meStrTwrEngine.strTwrData.yLength) ) then
        return
      endif
     !this.meStrTwrEngine.setYLength(!this.txYLengthStrTwrSub.val)
     !this.meStrTwrEngine.strTwrData.clXSpacing = !gadget.val - !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
    elseif ( !gadget.name().eq('TXYLENGTHSTRTWRSUB') ) and ( !this.opYLengthStrTwrSub.dText.empty().not() ) then
     !this.meStrTwrEngine.setYLength(!this.opYLengthStrTwrSub.selection().real())
    endif

    -- check statement for Stair tower height
    if ( !gadget.name().eq('TXZLENGTHSTRTWRSUB') ) and ( !this.opZLengthStrTwrSub.dText.empty() ) then
      if (!gadget.val.eq(!this.meStrTwrEngine.strTwrData.zLength) ) then
        return
      endif
      !this.meStrTwrEngine.setZLength(!this.txZLengthStrTwrSub.val)
    elseif ( !gadget.name().eq('TXZLENGTHSTRTWRSUB') ) and ( !this.opZLengthStrTwrSub.dText.empty().not() ) then
      !this.meStrTwrEngine.setZLength(!this.opZLengthStrTwrSub.selection().real())
    endif

    -- check statement for stair tower x length
    if ( !gadget.name().eq('TXCLXSPACINGSTRTWR') ) and ( !this.opCLXSpacingStrTwr.dText.empty() ) then
      if (!gadget.val.eq(!this.meStrTwrEngine.strTwrData.clXSpacing) ) then
        return
      endif
     !this.meStrTwrEngine.setCLXSpacing(!this.txCLXSpacingStrTwr.val)
    elseif ( !gadget.name()eq('TXCLXSPACINGSTRTWR') ) and ( !this.opCLXSpacingStrTwr.dText.empty().not() ) then
     !this.meStrTwrEngine.setCLXSpacing(!this.opCLXSpacingStrTwr.selection().real())
    endif

    -- check statement for stair tower y length
    if ( !gadget.name().eq('TXCLYSPACINGSTRTWR') ) and ( !this.opCLYSpacingStrTwr.dText.empty() ) then
      if (!gadget.val.eq(!this.meStrTwrEngine.strTwrData.clYSpacing) ) then
        return
      endif
     !this.meStrTwrEngine.setCLYSpacing(!this.txCLYSpacingStrTwr.val)
    elseif ( !gadget.name().eq('TXCLYSPACINGSTRTWR') ) and ( !this.opCLYSpacingStrTwr.dText.empty().not() ) then
     !this.meStrTwrEngine.setCLYSpacing(!this.opCLYSpacingStrTwr.selection().real())
    endif

    --check condition for the stair landing Width
    if ( !gadget.name().eq('TXSTRLNGWIDTHSTRTWR') ) and ( !this.opStrLngWidthStrTwr.dText.empty() ) then
      if (!gadget.val.eq(!this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth) ) then
        return
      endif
      !this.meStrTwrEngine.setStrLngWidth(!this.txStrLngWidthStrTwr.val)
    elseif ( !gadget.name().eq('TXSTRLNGWIDTHSTRTWR') ) and ( !this.opStrLngWidthStrTwr.dText.empty().not() ) then
      !this.meStrTwrEngine.setStrLngWidth(!this.opStrLngWidthStrTwr.selection().real())
    endif

    --check condition for the Stair Landing Length
    if ( !gadget.name().eq('TXSTRLNGLENGTHSTRTWR') ) and ( !this.opStrLngLengthStrTwr.dText.empty() ) then
      if (!gadget.val.eq(!this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength) ) then
        return
      endif
      !this.meStrTwrEngine.setStrLngLength(!this.txStrLngLengthStrTwr.val)
    elseif ( !gadget.name().eq('TXSTRLNGLENGTHSTRTWR') ) and ( !this.opStrLngLengthStrTwr.dText.empty().not() ) then
      !this.meStrTwrEngine.setStrLngLength(!this.opStrLngLengthStrTwr.selection().real())
    endif

    --check condition for the stair landing thickness
    if ( !gadget.name().eq('TXSTRLNGTHKSTRTWR') ) and ( !this.opStrLngThkStrTwr.dText.empty() ) then
      if (!gadget.val.eq(!this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk) ) then
        return
      endif
      if ( !gadget.val.lt(!this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk) ) then
        !value = !gadget.val - !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk
        !this.modifyFflStrTwr(!value)
      elseif ( !gadget.val.gt(!this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk) ) then
        !value = !gadget.val - !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk
        !this.modifyFflStrTwr(!value)
      endif

      !this.meStrTwrEngine.setStrLngThk(!this.txStrLngThkStrTwr.val)
        if ( !this.createTwrStl.val.eq(true) ) then
          --update the beam levels of the stair tower based on Height
          --!this.meStrTwrEngine.getBeamLevelStrTwr()
          --update the finished floor level as per the thickness added and top of steel of Beam
          !this.setFflLevelStrTwr()
          --sort the Data
          !this.meStrTwrEngine.strTwrData.sortFflLevel()
          --update the finished floor level in the container
          !this.updateFflLevel()
        elseif ( !this.skipTwrStl.val.eq(true) ) then
          --sort the Data
          !this.meStrTwrEngine.strTwrData.sortFflLevel()
          --update the ffl in the container
          !this.updateFflLevel()
        endif
    elseif ( !gadget.name().eq('TXSTRLNGTHKSTRTWR') ) and ( !this.opStrLngThkStrTwr.dText.empty().not() ) then
      !this.meStrTwrEngine.setStrLngThk(!this.opStrLngThkStrTwr.selection().real())
    endif

    --update the centre lines values
    !this.txCLXSpacingStrTwr.val = !this.txXLengthStrTwrSub.val - !this.txStrLngWidthStrTwr.val
    !this.meStrTwrEngine.setCLXSpacing(!this.txCLXSpacingStrTwr.val)
    !this.txCLYSpacingStrTwr.val = !this.txYLengthStrTwrSub.val - !this.txStrLngLengthStrTwr.val
    !this.meStrTwrEngine.setCLYSpacing(!this.txCLYSpacingStrTwr.val)

    --clear aids if ANY
    !!aslCentralData.clearFeedBack('AIDVOLSTRTWR')
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
    !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
    !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
    !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')
    !!aslCentralData.clearFeedBack('AIDVOLSTRFLT')
    !!aslCentralData.clearFeedBack('AIDDIM')

    --update the beam levels of the stair tower based on Height
    !this.meStrTwrEngine.getBeamLevelStrTwr()
    --update the finished floor level as per the thickness added and top of steel of Beam
    !this.setFflLevelStrTwr()
    --sort the Data
    !this.meStrTwrEngine.strTwrData.sortFflLevel()
    --update the finished floor level in the container
    !this.updateFflLevel()


    --update the tie beam profile Data
    !this.updateTieBeamProfileData()

    --draw the centre Line
    !this.drawCentreLines()

    --draw the tower volume
    !this.drawTowerVolume()

    --draw the landing Levels
    !this.drawFflLevelAid()

    --draw the handrail Data
    !this.updateHandrailLngProfile()

    if ( !this.toHandraProfileAid.val.eq(true) ) then
      !this.drawHandraAids()
    endif

  endif
  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyFflStrTwr
--
-- Description: modifies the ffl level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyFflStrTwr(!value is REAL)

  !fflLevelElev  = !this.meStrTwrEngine.getFflLevelStrTwr()
  !newFflLevel   = object ARRAY()

  do !i from 1 to !fflLevelElev.size()
    !level = (!fflLevelElev[!i] + !value )
    !newFflLevel.append( !level )
  enddo

  !newFflLevel.sort()
  !this.meStrTwrEngine.strTwrData.fflLevelStrTwr = object ARRAY()
  !this.meStrTwrEngine.strTwrData.fflLevelStrTwr = !newFflLevel

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      selectProfile
--
-- Description: Select profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gadget ID
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectProfile(!id is STRING)

  -- Set default JusLine required for different types of profiles, if
  -- the one of the plines can't be found then NA is used.
  !plineList  = ARRAY()
  !plineList.append('TOS')
  !plineList.append('TOC')
  !plineList.append('TOAX')

  -- Selection form title
  --!title              = 'Test Profile ' & !id
  !title              = 'Section Profile Selection'

  -- Action to be carried out
  !action             = '!!' & !this.name() & '.setProfile(''' & !id & ''', !this.catalogueProfile)'
  --!string = 'profileData' & !id

  -- Profile Data
  !profileData        = !this.attribute('profileData' & !id)

  -- Setup object for profile selection
  !profileSelection   = object PROFILESELECTION(!title, !action)

  !profileSelection.profileData(!profileData)
  !profileSelection.defaultPlines(!plineList)

  -- Display profile selection form
  !profileSelection.show()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setProfile
--
-- Description: Set profile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILECATALOGUEDATA Profile Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setProfile(!id is STRING, !profileData is PROFILECATALOGUEDATA)

  -- Initialise Variable
  !this.attribute('profileData' & !id) = !profileData
  !this.attribute('profileSect' & !id).val  = !profileData.catalogueReference.namn
  !this.attribute('profileJust' & !id).val  = !profileData.justificationline

  if ( !id.eq('A') ) then
    --update the member
    !this.meStrTwrEngine.strTwrData.columnProfile.sprefSteelColumn     = !profileData.catalogueReference.namn
    !this.meStrTwrEngine.strTwrData.columnProfile.cPLineJustification  = !profileData.justificationline
    --update the profile data
    !this.updateColumnProfileData()
    !this.updateBeamProfileData()
  elseif ( !id.eq('B') ) then
    --update the member
    !this.meStrTwrEngine.strTwrData.beamProfile.sprefSteelBeam         = !profileData.catalogueReference.namn
    !this.meStrTwrEngine.strTwrData.beamProfile.bPlineJustification    = !profileData.justificationline
    --update the profile data
    !this.updateColumnProfileData()
    !this.updateBeamProfileData()
  elseif (!id.eq('C')) then
    --update the member
    !this.meStrTwrEngine.strTwrData.beamProfile.sprefSteelTieUp        = !profileData.catalogueReference.namn
    !this.meStrTwrEngine.strTwrData.beamProfile.tPlineJustification    = !profileData.justificationline
    --update the tie beam profile Data
    !this.updateTieBeamProfileData()
  endif

  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      newBeamLevelStrTwr
--
-- Description: implements new Beam Level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newBeamLevelStrTwr()

  !newBeamLevel = 1000mm
  !this.meStrTwrEngine.newBeamLevel(!newBeamLevel)

  -- update the beam level
  !this.updateBeamLevel()

  --update the profile data and aid graphics
  !this.updateColumnProfileData()
  !this.updateBeamProfileData()

  --draw the datum
  !this.drawDatum()

  --select the first one, so that it can be picked immediately
  !array[1] = 1
  !this.neBeamLevel.setSelectedRowTags(!array)
  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      newFflLevelStrTwr
--
-- Description: implements new FFL Level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newFflLevelStrTwr()

  !newFflLevel = 1000mm
  !this.meStrTwrEngine.newFflLevel(!newFflLevel)

  -- update the beam level
  !this.updateFflLevel()

  --update the aids graphics
  --clear aids if ANY
  !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
  !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
  !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
  !!aslCentralData.clearFeedBack('AIDDIM')
  !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')

  --update the tie beam profile Data
  !this.updateTieBeamProfileData()

  --draw the centreline
  !this.drawCentreLines()

  --draw the ffl level aid
  !this.drawFflLevelAid()

  --draw the handrail Data
  !this.updateHandrailLngProfile()

  if ( !this.toHandraProfileAid.val.eq(true) ) then
    !this.drawHandraAids()
  endif

  --select the first one, so that it can be picked immediately
  !array[1] = 1
  !this.neFflLevel.setSelectedRowTags(!array)

  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateBeamLevel
--
-- Description: update the grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateBeamLevel()

  --use the .NET library
  using namespace  'Aveva.Pdms.Presentation'
  !this.neBeamLevel.clearGrid()

  !posFmt     = !!distanceFmt
  !posFmt.dp  = 2

  --fill the title
  !title      = 'Beam Elevation Levels'
  --set the headings of the level-list
  !heading    = object ARRAY()
  !heading.append('No.')
  !heading.append('TOS of Beam (WRT Stair Tower)')

  -- collect the data
  !allBeam    = !this.meStrTwrEngine.strTwrData.beamLevelStrTwr
  !columns    = object ARRAY()

  do !i index !allBeam
    !beamLanding    = !allBeam[!i]
    !columns[!i]    = object ARRAY()
    -- column1 ,Index no.
    !columns[!i].append(!i.string())
    -- column2, elevation
    !columns[!i].append(!beamLanding.string(!posFmt))
  enddo

  -- fill the grid
  !netLandDetail = object NETDATASOURCE(!title, !heading, !columns)
  !this.neBeamLevel.bindToDataSource(!netLandDetail)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateFflLevel
--
-- Description: update the grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateFflLevel()

  --use the .NET library
  using namespace  'Aveva.Pdms.Presentation'
  !this.neFflLevel.clearGrid()

  --update the floor level
  !posFmt     = !!distanceFmt
  !posFmt.dp  = 2

  --fill the title
  !title      = 'Finished Floor Levels'
  --set the headings of the level-list
  !heading    = object ARRAY()
  !heading.append('No.')
  !heading.append('FFL of Landing (wrt Stair Tower)')

  -- collect the data
  !allFfl     = !this.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !columns    = object ARRAY()

  do !i index !allFfl
    !fflLanding     = !allFfl[!i]
    !columns[!i]    = object ARRAY()
    -- column1 ,Index no.
    !columns[!i].append(!i.string())
    -- column2, elevation
    !columns[!i].append(!fflLanding.string(!posFmt))
  enddo

  -- fill the grid
  !netFflDetail = object NETDATASOURCE(!title, !heading, !columns)
  !this.neFflLevel.bindToDataSource(!netFflDetail)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      deleteBeamLevelStrTwr
--
-- Description: Delete the beam level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deleteBeamLevelStrTwr()

  --check for selected rows
  !rows = !this.neBeamLevel.getSelectedRows()
  if ( ( !rows.empty() ) or ( !rows.size().gt(1) ) ) then
    !!alert.warning('Select a Row to Delete...')
    return
  endif

  if ( !!alert.confirm('Do you want to delete the selected Beam level?').neq('YES') ) then
    return
  endif

  -- collect the selected row and delete them respectively
  !beamIndices = !this.neBeamLevel.getSelectedRows()
  !this.meStrTwrEngine.remBeamLevel(!beamIndices)

  --Update the landing level
  !this.updateBeamLevel()

  --update the profile data and aid graphics
  !this.updateColumnProfileData()
  !this.updateBeamProfileData()

  --draw the datum point
  !this.drawDatum()

  --select the first one, so that it can be picked immediately
  !array[1] = 1
  !this.neBeamLevel.setSelectedRowTags(!array)
  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      deleteFflLevelStrTwr
--
-- Description: Delete the FFL level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deleteFflLevelStrTwr()

  --check for selected rows
  !rows = !this.neFflLevel.getSelectedRows()
  if ( ( !rows.empty() ) or ( !rows.size().gt(1) ) ) then
    !!alert.warning('Select a Row to Delete...')
    return
  endif

  if ( !!alert.confirm('Do you want to delete the selected FFL level?').neq('YES') ) then
    return
  endif

  -- collect the selected row and delete them respectively
  !fflIndices = !this.neFflLevel.getSelectedRows()
  !this.meStrTwrEngine.remFflLevel(!fflIndices)

  -- update the beam level
  !this.updateFflLevel()

  --update the Aids graphics
  --clear aids if ANY
  !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
  !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
  !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
  !!aslCentralData.clearFeedBack('AIDDIM')
  !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')

  --update the tie beam profile Data
  !this.updateTieBeamProfileData()

  --draw the centreline
  !this.drawCentreLines()

  --draw the ffl level aid
  !this.drawFflLevelAid()

  --draw the handrail Data
  !this.updateHandrailLngProfile()

  if ( !this.toHandraProfileAid.val.eq(true) ) then
    !this.drawHandraAids()
  endif

  --select the first one, so that it can be picked immediately
  !array[1] = 1
  !this.neFflLevel.setSelectedRowTags(!array)

  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      selectBeamLevelStrTwr
--
-- Description: control for active/inactive of exit gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      the selected rows
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectBeamLevelStrTwr(!rows is ARRAY)

  !this.lsBeamLevelDelete.active = !rows[0].empty().not()
  !this.lsBeamLevelPosi.active   = !rows[0].empty().not()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      selectFflLevelStrTwr
--
-- Description: control for active/inactive of exit gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      the selected rows
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectFflLevelStrTwr(!rows is ARRAY)

	if ( !this.createTwrStl.val.eq(true) ) then
    !this.lsFflLevelDelete.active = !rows[0].empty()
    !this.lsFflLevelPosi.active   = !rows[0].empty()
  elseif ( !this.skipTwrStl.val.eq(true) ) then
    !this.lsFflLevelDelete.active = !rows[0].empty().not()
    !this.lsFflLevelPosi.active   = !rows[0].empty().not()
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setFflLevelStrTwr
--
-- Description: sets the finished floor level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setFflLevelStrTwr()

  !this.meStrTwrEngine.setFflLevelStrTwr()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyBeamLevelStrTwr
--
-- Description: callback when changing the grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       not idea
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyBeamLevelStrTwr(!array is ARRAY)

  -- Initialise Variables
  !levels = object ARRAY()
  !levels = !this.meStrTwrEngine.strTwrData.beamLevelStrTwr
  !rows   = !this.neBeamLevel.getRows()

  !answer = !!data[3]
  !index  = !!data[1].real()

  if ( !answer.eq(true) ) then
    !this.meStrTwrEngine.strTwrData.beamLevelStrTwr[!index] = object REAL(!rows[!index][2], !!distanceFmt)
  endif

  -- sort the Levels
  !this.meStrTwrEngine.strTwrData.sortBeamLevel()

  -- update the beam level
  !this.updateBeamLevel()

  --update the profile data and aid graphics
  !this.updateColumnProfileData()
  !this.updateBeamProfileData()

  --draw the datum
  !this.drawDatum()
  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyFflLevelStrTwr
--
-- Description: callback when changing the grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       not idea
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyFflLevelStrTwr(!array is ARRAY)

  -- means it is OK to change the value
  !levels = object ARRAY()
  !levels = !this.meStrTwrEngine.getFflLevelStrTwr()
  !rows   = !this.neFflLevel.getRows()

  !answer = !!data1[3]
  !index  = !!data1[1].real()

    if ( !answer.eq(true) ) then
      !this.meStrTwrEngine.strTwrData.fflLevelStrTwr[!index] = object REAL(!rows[!index][2], !!distanceFmt)
    endif

  -- sort the Levels
  !this.meStrTwrEngine.strTwrData.sortFflLevel()

  -- update the beam level
  !this.updateFflLevel()

  --updating the graphical aids
  --clear aids if ANY
  !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
  !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
  !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
  !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')
  !!aslCentralData.clearFeedBack('AIDDIM')


  --update the tie beam profile Data
  !this.updateTieBeamProfileData()

  --draw the centreline
  !this.drawCentreLines()

  --draw the ffl level aid
  !this.drawFflLevelAid()

  --draw the handrail Data
  !this.updateHandrailLngProfile()

  if ( !this.toHandraProfileAid.val.eq(true) ) then
    !this.drawHandraAids()
  endif

  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      selectBeamColumStrTwr
--
-- Description: callback when grid is clicked
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .selectBeamColumStrTwr( !new is ARRAY )

  !allLevels      = !this.meStrTwrEngine.strTwrData.beamLevelStrTwr
  !strTwrPosition = !this.meStrTwrEngine.getPosition()

  !test = object REAL(!new[0], !!distanceFmt)
  handle (2,441)
    !new[3] = false
    !!alert.error('Field Accepts only real value')
    return
  endhandle
  if ( !test.unset() ) then
    !new[3] = false
    !!alert.error('Field Accepts only real value')
    return
  endif

  if ( object REAL (!new[0], !!distanceFmt ) gt !this.txZLengthStrTwr.val ) then
    !new[3] = false
    !!alert.error('Entered TOS of Beam is greater than the Tower Z Length.')
    return
  elseif ( ( object REAL (!new[0], !!distanceFmt ) + !strTwrPosition.up ) lt !strTwrPosition.up ) then
    !new[3] = false
    !!alert.error('Entered TOS of Beam is Lesser than the Origin of the Stair Tower.')
    return
  elseif ( object REAL (!new[0], !!distanceFmt ) eq(0) ) then
    !new[3] = false
    !!alert.error('Entered TOS of Beam is Lesser than the minimum required Headroom Clearance.')
    return
  else
    do !i from 1 to !allLevels.size()
      if ( !allLevels[!i] eq object REAL (!new[0], !!distanceFmt ) ) then
        !new[3] = false
        !!alert.error('TOS of Beam entered already exists in the table.')
        return
      else
        !new[3] = true
      endif
        break if ( !new[3].eq(false) )
    enddo
  endif

  !!data = !new

  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      selectFflColumStrTwr
--
-- Description: callback when grid is clicked
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
