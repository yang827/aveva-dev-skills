--   File:           aslstrtwr.pmlfrm
--   Group:          ASL
--   Keyword:        Stair Tower
--   Module:         ASL
--   Author:         Naresh Kumar K
--   Created:        Fri Feb 15 09:00:00 2008
--
--
--   Description:    Stair Tower definition form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addGate()                        -                   Invoke edg mode to add gate to handrail object
--  aslStrTwr()                      -                   Constructor
--  aslStrTwrFflPopupCallback(ARRAY) -                   shows the popup
--  aslStrTwrTosPopupCallback(ARRAY) -                   shows the popup
--  ceValidCheck()                   -                   Valid Check for the Current Element, Referring to stair tower
--  checkInstallationoption()        -                   callback to check installation option and check for gadget
--  checkLandingCatalogue()          -                   callback to check for the gadget and installation template
--  checkName()                      -
--  chkdir(GADGET,STRING)            -                   check and manipulate the entered direction
--  chkpos()                         -                   check and manipulate the entered direction
--  clearIncompleteStrTwr()          -                   Clears incomplete stair tower
--  closeForm()                      -                   closes the form
--  createStrTwr()                   -                   show main creation panel
--  deleteBeamLevelStrTwr()          -                   Delete the beam level
--  deleteFflLevelStrTwr()           -                   Delete the FFL level
--  deleteStrTwr()                   -                   delete stair tower
--  deriveConfigurationType(DBREF)   -                   Derive options from pick data
--  deriveInstallationOptionsStrTwr() -                   Derive options from pick data
--  drawCentreLines()                -                   creates the centre Line details
--  drawDatum()                      -                   creates the datum details
--  drawFflLevelAid()                -                   creates the aid for Landing details
--  drawHandraAids()                 -                   updates the handrail Profile aids
--  drawHandraProfileAids()          -                   draw the HANDRA profile aids
--  drawTowerVolume()                -                   creates the volume details of the Tower
--  evaluateStrFltAtt()              -                   evaluate the strflt attribute
--  frameChange(GADGET)              -                   make the main frames visible/invisible
--  getStrTwrAbove(DBREF)            DBREF
--  getStrTwrOwner(DBREF)            DBREF               get possible stair tower owner passed db position, e.g db item that can own STRTWR
--  installOptionStrTwr(GADGET,STRING) -                   open callback from install option gadgets
--  modifyBeamLevelStrTwr(ARRAY)     -                   callback when changing the grid
--  modifyCataOptionsStrTwr()        -                   update the option gadget for template assembly
--  modifyFflLevelStrTwr(ARRAY)      -                   callback when changing the grid
--  modifyFflStrTwr(REAL)            -                   modifies the ffl level
--  modifyStrFltAtt(GADGET,STRING)   -                   open callback from most gadgets
--  modifyStrLngAtt(GADGET,STRING)   -                   open callback from most gadgets
--  modifyStrTwr(DBREF)              -                   show main modification panel
--  modifyStrTwrTmplReference(GADGET,STRING) -                   open callback from most gadgets
--  modifyTwrStlAtt(GADGET,STRING)   -                   open callback from most gadgets
--  newBeamLevelStrTwr()             -                   implements new Beam Level
--  newFflLevelStrTwr()              -                   implements new FFL Level
--  pickBeamLevelReturn(EDGPOSITIONDATA) -                   repositions intermediate beam level
--  pickBeamlevel()                  -                   implements new level form Beam by EDG Pick
--  pickFflLevelReturn(EDGPOSITIONDATA) -                   repositions intermediate FFL level
--  pickFfllevel()                   -                   implements new level form FFL by EDG Pick
--  pickPosition()                   -                   Setup EDG pick event for picking position
--  position(EDGPOSITIONDATA)        -                   Set position
--  position(POSITION)               -                   Set position
--  rtoggleCallChange()              -
--  selectBeamColumStrTwr(ARRAY)     -
--  selectBeamLevelStrTwr(ARRAY)     -                   control for active/inactive of exit gadgets
--  selectFflColumStrTwr(ARRAY)      -
--  selectFflLevelStrTwr(ARRAY)      -                   control for active/inactive of exit gadgets
--  selectPltSpecification()         -                   select the plate specification for the stair landing catalogue
--  selectProfile(STRING)            -                   Select profile
--  senseStrTwr(GADGET,STRING)       -                   open callback from install option gadgets
--  setFflLevelStrTwr()              -                   sets the finished floor level
--  setHandraData(STRING,ASLHANDRAIL) -                   sets the HANDRA specification data
--  setPlateSpec(ASLSTRLNGDATA)      -                   sets the Plate specification data
--  setProfile(STRING,PROFILECATALOGUEDATA) -                   Set profile
--  setup()                          -                   setup
--  showDimStrFlt(GADGET,STRING)     -                   callback from view gadgets
--  showDimStrLng(GADGET,STRING)     -                   callback from view gadgets
--  showDimTwrStl(GADGET,STRING)     -                   callback from view gadgets
--  showHandraSpecification(STRING)  -                   opens the HANDRA specification form
--  strFltSegmentDetails(GADGET,STRING) -                   update the gadgets
--  strFltSegmentDetails(REAL)       -
--  track()                          -                   ce-tracker
--  trackCheck(STRING)               BOOLEAN             check whether a certain element can be created
--  updateBeamLevel()                -                   update the grid control
--  updateBeamProfileData()          -                   updates the beam details
--  updateCataOptionsStrFlt()        -                   updates the catalogue options
--  updateCataOptionsStrLng()        -
--  updateColumnBeamProfileDb()      -                   creates the column and beam details
--  updateColumnProfileData()        -                   updates the column details
--  updateCoordinateSystem()         -
--  updateFflLevel()                 -                   update the grid control
--  updateFrMain1StrTwr()            -                   update the gadgets
--  updateFrMain2TwrStl()            -                   update the gadgets
--  updateFrMain3StrTwr()            -                   update the gadgets
--  updateFrMain3SubStrTwr()         -
--  updateFrameChangeLandingDB()     -
--  updateGadgetHandra()             -
--  updateGadgetHandraAid()          -                   update the gadget
--  updateHandrailLngProfile()       -                   updates the handrail Profile details
--  updateLimitsStrLng()             -                   updates the limits
--  updateLimitsTwrStl()             -
--  updateStrFltDB()                 -                   create the stair flight
--  updateStrFltObject()             -
--  updateStrLngDB()                 -                   creates the Landing details
--  updateStrTwrDB()                 -                   creates/updates STRTER element
--  updateTieBeamProfileData()       -                   updates the Tie beam details
--  validationTextGadgets(GADGET,CRITERION) -                   Validating the textGadgets.
--  voidModify()                     -                   check and manipulate the entered value
--  walkToStrTwrDetails()            -                   update the gadgets
--  zoomStrFltSegmentDetails()       -                   update the gadgets
--

--------------------------------------------------------------------------------------------------------------------------------------------
-- Importing the .Net objects
--------------------------------------------------------------------------------------------------------------------------------------------
  import 'PositionControl'
  handle ANY
  endhandle

  import 'GridControl'
  handle ANY
  endhandle


--------------------------------------------------------------------------------------------------------------------------------------------
setup form !!aslStrTwr dialog dock right

  -- .NET library
  using namespace 'Aveva.Pdms.Presentation'

  track    'DESICE'    callback '!this.track()'

  path down
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
  frame .frMain0 panel anchor T+L+R at xmin form ymax+0.1
    --create
    ---------------------------------------------------------------------------
    para   .paCreate                  at xmin+1.5              ymax                 anchor T+L  text 'Create'                                            width 12
    line   .lnCreate                  at xmin.paCreate         ymax                 anchor T+L  HORIZ                                                    width 38
    button .lkCreateStrTwr linklabel  at xmin.paCreate+1       ymax+0.5             anchor T+L  'Stair Tower'     callback |!!aslStrTwr('CREATE', !!ce)| width 7

    path down
    -- modify
    ---------------------------------------------------------------------------
    para   .paModify                 at xmin.paCreate          ymax+0.5              anchor T+L  text 'Modify'                                           width 12
    line   .lnModify                 at xmin.paModify          ymax                  anchor T+L  HORIZ                                                   width 38
    button .lkModifyStrTwr linklabel at xmin.paCreate+1        ymax+0.5              anchor T+L  'Stair Tower'    callback |!!aslStrTwr('MODIFY', !!ce)| width 7

    path down
    -- delete
    ---------------------------------------------------------------------------
    para   .paDelete                 at xmin.paCreate         ymax+0.5              anchor T+L  text 'Delete'                                            width 12
    line   .lnDelete                 at xmin.lnCreate         ymax                  anchor T+L  HORIZ                                                    width 38
    button .lkDeleteStrTwr linklabel at xmin.paCreate+1       ymax+0.5              anchor T+L  'Stair Tower' callback '!this.deleteStrTwr()'            width 7

    button .buExitStrTwr             at xmin.paCreate         ymax+2                anchor T+L  pixmap                                                   width 16 height 16
    button .lkExitStrTwr   linklabel at xmax.buExitStrTwr+1   ymin                  anchor T+L  'Exit'           callback '!this.hide()'                 width 8

  exit

  --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    -- stair tower
  --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

  frame .frMain1 panel anchor T+L+R at x0 y0

    --------------------------------------------------------------------------------
    --main attributes
    --------------------------------------------------------------------------------
    --frame .frMainAttStrTwr        'General Attributes'              anchor T+L at xmin form ymax+0.1                                                   width 40
      para         .paGenAtt                                        anchor T+L at xmin   ymax      text 'General Attributes'                        width 12
      line         .lnGenAtt                                        anchor T+L at xmin   ymax-0.2  HORIZ                                            width 38
      text         .dbName        'Name:'              tagwidth 10  anchor T+L at xmin+3 ymax+0.5  callback '!this.checkName()'                     width 24 is STRING
      text         .dbDescription 'Description:'       tagwidth 10  anchor T+L at xmin   ymax+0.1  callback ''                                      width 24 is STRING
      numericinput .dbArea        'Area:'              tagwidth 10  anchor T+L at xmin   ymax+0.1  callback ''                  range 0 10000 ndp 0 width 6
      numericinput .dbNumber      'Number:'            tagwidth 8   anchor T+L at xmax   ymin      callback ''                  range 0 10000 ndp 0 width 6
    --exit

    --------------------------------------------------------------------------------
    -- Position / Orientation
    --------------------------------------------------------------------------------
    --frame       .frLocDirStrtwr                       'Direction, Position and Sense'                  anchor T+L at xmin form           ymax+0.5                                            width 40
      para   .paLocDirStrtwr                                                                           anchor T+L at xmin.paGenAtt       ymax+0.5            text 'Direction and Position'   width 25
      line   .lnLocDirStrtwr                                                                           anchor T+L at xmin                ymax-0.2            HORIZ                           width 38
      text      .txDirectionStrTwr                    'Direction:'                         tagwidth 10 anchor T+L at xmin+3              ymax+0.5            callback '!this.chkdir('        width 10        is STRING
      button    .buPickPosition                                                            pixmap      anchor T+L at xmin                ymax+0.3            callback '!this.pickPosition()' width 16 height 16
      button    .pickPosition linkLabel               'Pick Position'                                  anchor T+L at xmax.buPickPosition ymin.buPickPosition callback '!this.pickPosition()' width 9
      container .netStrTwrPositionFrame               PMLNetCONTROL                                    anchor T+L at xmin.buPickPosition ymax+0.2                                            width 34 height 4.5
    --exit

    ---------------------------------------------------------------------------
    --action sequence
    ---------------------------------------------------------------------------
    --frame .actionSeq1                   'Select Configuration Type'             anchor T+L at xmin form             ymax+0.5                                                     width 40
      para      .paCreateTwr                                                    anchor T+L at xmin.paGenAtt         ymax+0.5  text 'Configuration Type'                          width 30 lines 1
      line      .lnCreateTwr                                                               at xmin                  ymax-0.2  anchor T+L   HORIZ                                 width 38
      button    .buCreateTwr                                                    anchor T+L at xmin+3                ymax+0.5  pixmap                                             width 16 height 16
      rtoggle   .createTwrStl tagwidth 20 |Tower Steel Layout Configuration   | anchor T+L at xmax.buCreateTwr+1    ymin      states '' 'ON'
      button    .buCreateLng                                                    anchor T+L at xmin.buCreateTwr      ymax      pixmap                                             width 16 height 16
      rtoggle   .skipTwrStl   tagwidth 20 |Stair Landing Configuration   |      anchor T+L at xmax.buCreateLng+1    ymin      states '' 'OFF'
      paragraph .actionMessage                                                  anchor T+L at xmin.buCreateTwr      ymax+0.2  text 'Configuration Description:-'                 width 17 lines 1
      line      .lnaction11                                                                at xmin-0.2              ymax-0.1  anchor T+L+R HORIZ                                 width 17
      paragraph .message                                                        anchor T+L at xmin                  ymax+0.5                                                     width 36 lines 2
    --exit

    ---------------------------------------------------------------------------
    --Perform sequence
    ---------------------------------------------------------------------------
    --frame    .frMain1task         'Perform Task' anchor T+L at xmin form         ymax+0.5                                                                                           width 40
      para   .paMain1task                        anchor T+L at xmin.paGenAtt     ymax+1          text 'Perform Task'                                                                width 30 lines 1
      line   .lnMain1task                                   at xmin              ymax-0.2        anchor T+L   HORIZ                                                                 width 38
      para   .paFrMain11                         anchor T+L at xmin+3            ymax+0.5        pixmap                                                                             width 25
      para   .updPaFrMain11                      anchor T+L at xmin.paFrMain11   ymin.paFrMain11 pixmap                                                                             width 25
      para   .modPaFrMain11                      anchor T+L at xmin.paFrMain11   ymin.paFrMain11 pixmap                                                                             width 25
      button .lkFrMain11    linklabel            anchor T+L at xmax.paFrMain11+1 ymin                   'Create Stair Tower Element'    callback '!this.updateStrTwrDB()'           width 17
      button .updLkFrMain11 linklabel            anchor T+L at xmax.paFrMain11+1 ymin                   'Update Stair Tower Element'    callback '!this.updateStrTwrDB()'           width 17
      button .modLkFrMain11 linklabel            anchor T+L at xmax.paFrMain11+1 ymin                   'Modify Stair Tower Element'    callback '!this.updateStrTwrDB()'           width 17
      para   .paFrMain01                         anchor T+L at xmin.paFrMain11   ymax            pixmap                                                                             width 16 height 16
      button .lkFrMain01    linklabel            anchor T+L at xmin.lkFrMain11   ymin                   'Back to Main Task'             callback '!this.frameChange(!this.frMain0)' width 11
    --exit

  exit

--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

  frame .frMain2 panel anchor T+L+R at x0 y0
    ---------------------------------------------------------------------------
    -- general attributes
    ---------------------------------------------------------------------------
    --frame .frGenAttStrTwr               'Tower Layout Attributes' anchor T+L at xmin form                ymax+0.1                                                               width 40
      para   .paGenAttStrTwr                                      anchor T+L at xmin.paGenAtt            ymax                     text 'Tower Layout Attributes'                width 30 lines 1
      line   .lnGenAttStrTwr                                                 at xmin                     ymax-0.2                 anchor T+L   HORIZ                            width 38
      text   .txXLengthStrTwr           'Tower Length(X):'        anchor T+L at x3                       ymax+0.5                 callback '!this.modifyTwrStlAtt(' tagwidth 14 width 14           is REAL format !!distanceFmt
      option .opXLengthStrTwr           'Tower Length(X) '        anchor T+L at xmin.txXLengthStrTwr     ymin.txXLengthStrTwr     callback '!this.modifyTwrStlAtt(' tagwidth 14 width 10
      button .toAidXLengthStrTwr toggle                           anchor T+L at x35                      ymin.txXLengthStrTwr     callback '!this.showDimTwrStl('   pixmap      width 16 height 16
      text   .txYLengthStrTwr           'Tower Length(Y):'        anchor T+L at xmin.txXLengthStrTwr                              callback '!this.modifyTwrStlAtt(' tagwidth 14 width 14           is REAL format !!distanceFmt
      option .opYLengthStrTwr           'Tower Length(Y)'         anchor T+L at xmin.txXLengthStrTwr     ymin.txYLengthStrTwr     callback '!this.modifyTwrStlAtt(' tagwidth 14 width 10
      button .toAidYLengthStrTwr toggle                           anchor T+L at xmin.toAidXLengthStrTwr  ymin.txYLengthStrTwr     callback '!this.showDimTwrStl('   pixmap      width 16 height 16
      text   .txZLengthStrTwr           'Tower Height(Z):'        anchor T+L at xmin.txXLengthStrTwr                              callback '!this.modifyTwrStlAtt(' tagwidth 14 width 14           is REAL format !!distanceFmt
      option .opZLengthStrTwr           'Tower Height(Z)'         anchor T+L at xmin.txXLengthStrTwr     ymin.txZLengthStrTwr     callback '!this.modifyTwrStlAtt(' tagwidth 14 width 10
      button .toAidZLengthStrTwr toggle                           anchor T+L at xmin.toAidXLengthStrTwr  ymin.txZLengthStrTwr     callback '!this.showDimTwrStl('   pixmap      width 16 height 16
    --exit

    ---------------------------------------------------------------------------
    -- column attributes
    ---------------------------------------------------------------------------
    --frame .frColumnSpec       'Column SPEC Details'               anchor T+L at xmin form           ymax+0.5                                                     width 40
      para   .paColumnSpectitle                                   anchor T+L at xmin.paGenAtt       ymax+0.5              text 'Column SPEC Details'             width 30 lines 1
      line   .lnColumnSpec                                                   at xmin                ymax-0.2              anchor T+L   HORIZ                     width 38
      button .paColumnSpec                                        anchor T+L at xmin+3              ymax+0.5 pixmap       callback '!this.selectProfile(''A'')'  width 16 height 16
      button .selectProfileA  'Select SPEC For Column...'         anchor T+L at xmax.paColumnSpec+1 ymin+0.1 linklabel    callback '!this.selectProfile(''A'')'  width 17
      text   .profileSectA    'Column Profile:'                   anchor T+L at xmin.paColumnSpec   ymax+0.25tagwidth 14                                         width 19 is STRING
      text   .profileJustA    'Column Justification:'             anchor T+L at xmin.paColumnSpec   ymax+0.1 tagwidth 14                                         width 19 is STRING
    --exit

    ---------------------------------------------------------------------------
    -- beam attributes
    ---------------------------------------------------------------------------
    --frame .frBeamSpec         'Beam SPEC Details'                 anchor T+L at xmin form           ymax+0.5                                                     width 40
      para   .paBeamSpectitle                                     anchor T+L at xmin.paGenAtt       ymax+0.5              text 'Beam SPEC Details'               width 30 lines 1
      line   .lnBeamSpec                                                     at xmin                ymax-0.2              anchor T+L   HORIZ                     width 38
      button .paBeamSpec                                          anchor T+L at xmin+3              ymax+0.5 pixmap       callback '!this.selectProfile(''B'')'  width 16 height 16
      button .selectProfileB  'Select SPEC For Beam...'           anchor T+L at xmax.paBeamSpec+1   ymin+0.1 linklabel    callback '!this.selectProfile(''B'')'  width 15
      text   .profileSectB    'Beam Profile:'                     anchor T+L at xmin.paBeamSpec     ymax+0.25tagwidth 14                                         width 19 is STRING
      text   .profileJustB    'Beam Justification:'               anchor T+L at xmin.paBeamSpec     ymax+0.1 tagwidth 14                                         width 19 is STRING
      toggle .toConnSections  'Connect Sections   '               anchor T+L at xmin                ymax+0.5
    --exit

    ---------------------------------------------------------------------------
    -- Beam Top of Steel attributes
    ---------------------------------------------------------------------------
    ---frame .frlandingLevel     'Beam TOS Elevation Detail'         anchor T+L at xmin form           ymax+0.5                                                              width 40
      para      .palandingLevel                                   anchor T+L at xmin.paGenAtt       ymax+0.5                text 'Beam TOS Elevation Detail'              width 30 lines 1
      line      .lnlandingLevel                                              at xmin                ymax-0.2                anchor T+L   HORIZ                            width 38
      --frame     .frameBeam         panel                          dock top
      container .lsBeamLevel       nobox       PMLNetCONTROL      anchor T+L at xmin+1              ymax+0.5                                                              width 37 height 8
      --exit
      button    .lsBeamLevelCreate 'Add Beam Level'               anchor T+L at xmin+1              ymax+0.2 linklabel      callback '!this.newBeamLevelStrTwr()'         width 10
      button    .lsBeamLevelPosi   'Position Beam Level'          anchor T+L at xmin                ymax     linklabel      callback '!this.pickBeamlevel()'              width 16
      button    .lsBeamLevelDelete 'Remove Beam Level'            anchor T+L at xmin                ymax     linklabel      callback '!this.deleteBeamLevelStrTwr()'      width 13
    --exit

    ---------------------------------------------------------------------------
    --Perform sequence
    ---------------------------------------------------------------------------
    --frame    .frMain2task          'Perform Task'                      anchor T+L at xmin form        ymax+0.5                                                             width 40
      para   .paMain2task                                              anchor T+L at xmin.paGenAtt    ymax+0.5                text 'Perform Task'                          width 30 lines 1
      line   .lnMain2task                                                         at xmin             ymax-0.2                anchor T+L   HORIZ                           width 38
      para   .paFrMain23                                               anchor T+L at xmin+3           ymax+0.5        pixmap                                               width 40
      para   .updPaFrMain23                                            anchor T+L at xmin.paFrMain23  ymin.paFrMain23 pixmap                                               width 40
      para   .modPaFrMain23                                            anchor T+L at xmin.paFrMain23  ymin.paFrMain23 pixmap                                               width 40
      button .lkFrMain23    linklabel 'Create Tower Steel'             anchor T+L at xmax.paFrMain23  ymin                   callback '!this.updateColumnBeamProfileDb()'  width 13
      button .updLkFrMain23 linklabel 'Update Tower Steel'             anchor T+L at xmax.paFrMain23  ymin                   callback '!this.updateColumnBeamProfileDb()'  width 17
      button .modLkFrMain23 linklabel 'Modify Tower Steel'             anchor T+L at xmax.paFrMain23  ymin                   callback '!this.updateColumnBeamProfileDb()'  width 17
      para   .paFrMain21                                               anchor T+L at xmin.paFrMain23  ymax            pixmap                                               width 25
      button .lkFrMain21 linklabel 'Back to Stair Tower Definition'    anchor T+L at xmin.lkFrMain23  ymin                   callback '!this.frameChange(!this.frMain1)'   width 19
      para   .paFrMain20                                               anchor T+L at xmin.paFrMain23  ymax            pixmap                                               width 25
      button .lkFrMain20 linklabel 'Back to Main Task'                 anchor T+L at xmin.lkFrMain23  ymin                   callback '!this.frameChange(!this.frMain0)'   width 11
    --exit

  exit

--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

  frame .frMain3 panel anchor T+L+R at x0 y0

    --------------------------------------------------------------------------------
    -- Clockwise / AntiClockwise details for walkway and flight routing
    --------------------------------------------------------------------------------
    --frame    .frInstallSenseStrTwr               'Installation Sense' anchor T+L   at xmin form ymax+0.5                                                            width 40
      para   .paClockwiseStrTwr                        at xmin.paGenAtt+1  ymax+0.2  text 'Installation Sense'                                 width 30 lines 1
      line   .lnClockwiseStrTwr                        at xmin             ymax-0.2  anchor T+L+R HORIZ                                        width 38
      button .toClockwiseStrTwr       toggle           at xmin+3           ymax+0.5  pixmap                      callback '!this.senseStrTwr(' width 16 height 16
      button .lkClockwiseStrTwr       linklabel        at xmax             ymin      'Clockwise'                 callback '!this.senseStrTwr(' width 6
      button .toAntiClockwiseStrTwr   toggle           at xmax+7           ymin      pixmap                      callback '!this.senseStrTwr(' width 16 height 16
      button .lkAntiClockwiseStrTwr   linklabel        at xmax             ymin      'Anti-Clockwise'            callback '!this.senseStrTwr(' width 9
    --exit

    --------------------------------------------------------------------------------
    -- installation options
    --------------------------------------------------------------------------------
    --frame .frInstallationStrTwr               'Stair Landing Installation Options'    anchor T+L  at xmin form                       ymax+0.1                                                                                        width 40
      para   .paInstallOptionStrTwr                                                               at x1                            ymax                      text 'Landing Configuration'                                          width 30 lines 1
      line   .lnInstallOptionStrTwr                                                               at xmin                          ymax                      anchor T+L+R HORIZ                                                    width 38
      para   .paInstallOptionStrTwr1                                                              at xmin+0.8                      ymax+0.2                  text 'One stair'                                                      width 7  lines 1
      para   .paInstallOptionStrTwr2                                                              at xmax                          ymin                      text 'Two stairs'                                                     width 8  lines 1
      para   .paInstallOptionStrTwr3                                                              at xmax                          ymin                      text 'Three stairs'                                                   width 9  lines 1
      para   .paInstallOptionStrTwr4                                                              at xmax                          ymin                      text 'Four stairs'                                                    width 8  lines 1
      path down
      button .toInstallOptionStrTwr1  toggle                                                      at xmin.paInstallOptionStrTwr1+1.2 ymax                    pixmap                         callback '!this.installOptionStrTwr('  width 24 height 24
      button .toInstallOptionStrTwr2  toggle                                                      at xmax+4                        ymin                      pixmap                         callback '!this.installOptionStrTwr('  width 24 height 24
      button .toInstallOptionStrTwr3  toggle                                                      at xmax+5                        ymin                      pixmap                         callback '!this.installOptionStrTwr('  width 24 height 24
      button .toInstallOptionStrTwr4  toggle                                                      at xmax+5                        ymin                      pixmap                         callback '!this.installOptionStrTwr('  width 24 height 24
      button .buWalkStrLng                                                             anchor T+L at x35                           ymin                      pixmap                         callback '!this.walkToStrTwrDetails()' width 16 height 16

      para   .paStrLngWidthStrTwr                                                                 at x1                            ymax+0.5                  text 'Landing Attributes'                                             width 20
      line   .lnStrLngWidthStrTwr                                                                 at xmin                          ymax                      anchor T+L+R HORIZ                                                    width 38
      text   .txStrLngThkStrTwr               'Landing Thickness:'                     anchor T+L at xmin.paStrLngWidthStrTwr+2    ymax+0.2                  tagwidth 14                    callback '!this.modifyStrLngAtt('      width 14           is REAL format !!distanceFmt
      option .opStrLngThkStrTwr               'Landing Thickness:'                     anchor T+L at xmin.txStrLngThkStrTwr        ymin.txStrLngThkStrTwr    tagwidth 14                    callback '!this.modifyStrLngAtt('      width 10
      button .toAidStrLngThkStrTwr    toggle                                           anchor T+L at x33                           ymin.txStrLngThkStrTwr    pixmap                         callback '!this.showDimStrLng('        width 16 height 16
      text   .txStrLngLengthStrTwr            'Landing Length:'                        anchor T+L at xmin.txStrLngThkStrTwr        ymax+0.3                  tagwidth 14                    callback '!this.modifyStrLngAtt('      width 14           is REAL format !!distanceFmt
      option .opStrLngLengthStrTwr            'Landing Length:'                        anchor T+L at xmin.txStrLngLengthStrTwr     ymin.txStrLngLengthStrTwr tagwidth 14                    callback '!this.modifyStrLngAtt('      width 10
      button .toAidStrLngLengthStrTwr toggle                                           anchor T+L at x33                           ymin.txStrLngLengthStrTwr pixmap                         callback '!this.showDimStrLng('        width 16 height 16
      text   .txStrLngWidthStrTwr             'Landing Width:'                         anchor T+L at xmin.txStrLngLengthStrTwr     ymax+0.3                  tagwidth 14                    callback '!this.modifyStrLngAtt('      width 14           is REAL format !!distanceFmt
      option .opStrLngWidthStrTwr             'Landing Width:'                         anchor T+L at xmin.txStrLngWidthStrTwr      ymin.txStrLngWidthStrTwr  tagwidth 14                    callback '!this.modifyStrLngAtt('      width 10
