-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateStrLngDB()

  !!fmsys.setProgress(5)
  --navigate to the stair tower
  !this.ceValidCheck()

  if ( !this.meStrTwrEngine.strTwrData.fflLevelStrTwr.empty() ) then
    !!alert.error('Cannot create Landing as Finished Floor Level set to empty')
    return
  else
    -- creates the DB elements
    !this.meStrTwrEngine.strTwrData.updateStrLngDB()
  endif

  --update the frame once tower steel is created
  !this.frameChange(!this.frMain3Sub)

endmethod
