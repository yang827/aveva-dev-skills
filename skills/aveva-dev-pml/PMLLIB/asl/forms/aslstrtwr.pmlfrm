------------------------------------------------------------------------
--
-- Method:      pickBeamlevel
--
-- Description: implements new level form Beam by EDG Pick
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pickBeamlevel()

  !rows = !this.neBeamLevel.getSelectedRows()
  if ( !rows.size().neq(1) ) then
    !!alert.warning('Select a Row to Set the Elevation')
    return
  endif

  -- defines packet
  !packet                     = object EDGPACKET()
  !packet.pickPacket.prompt   = 'Identify position Up for Beam Level'

  -- defines first pick
  !packet.pickPacket.picks[1] = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('')

  -- define actions on first pick
  !packet.action              = '!!aslStrTwr.pickBeamLevelReturn(!this.return[1])'

  --set the description
  !packet.description         = 'ASL EDG Pick'

  -- adds packet to EDG system
  !!edgCntrl.add(!packet)

endmethod
-- End of method
------------------------------------------------------------------------
