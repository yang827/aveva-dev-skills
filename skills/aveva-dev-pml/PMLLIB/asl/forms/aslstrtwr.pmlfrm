  endif

  -- defines packet
  !packet                     = object EDGPACKET()
  !packet.pickPacket.prompt   = 'Identify position Up for Finished Floor Level'

  -- defines first pick
  !packet.pickPacket.picks[1] = object EDGPICKTYPE()
  !packet.pickPacket.picks[1].stdPosition('')

  -- define actions on first pick
  !packet.action              = '!!aslStrTwr.pickFflLevelReturn(!this.return[1])'

