-- End of method
------------------------------------------------------------------------
--
-- Method:      selectPltSpecification
--
-- Description: select the plate specification for the stair landing catalogue
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .selectPltSpecification()

  -- Selection form title
  !title              = 'Plate Specification (Testing)'

  -- Action to be carried out
  !action             = '!!' & !this.name() & '.setPlateSpec(!this.strLngData)'

  --template Reference
  !strLngData         = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData


  -- Setup object for profile selection
  !pltSpecification   = object ASLPLTSPEC(!title, !action, !strLngData)

  -- Display profile selection form
  !pltSpecification.show()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setPlateSpec
--
-- Description: sets the Plate specification data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setPlateSpec(!strLngData is ASLSTRLNGDATA)

  --update the profile data and aid graphics
  !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData = !strLngData

  --clear the aid lines
  !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
  !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
  !!aslCentralData.clearFeedBack('AIDVOLHANDRA')


  --update the stair landing frame
  !this.updateFrMain3StrTwr()
  !!fmsys.setProgress(0)

endmethod
-- End of method
