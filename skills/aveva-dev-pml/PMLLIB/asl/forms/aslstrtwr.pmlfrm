------------------------------------------------------------------------
--
-- Method:      updateCataOptionsStrTwr
--
-- Description: updates the catalogue options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateCataOptionsStrLng()

  --get the template reference
  !strLngTemplate = object ARRAY()
  !strLngTemplate = !!aslCentralData.getTemplates('STRLNG')

  !dText           = object ARRAY()
  !rText           = object ARRAY()

  do !strLngTmpl values !strLngTemplate
    !dText.append(!strLngTmpl.own.description)
    !rText.append(!strLngTmpl.own.string())
  enddo

  --make the array unique
  !dText.unique()
  !rText.unique()

  --assign the value to the option gadget
  !this.opStrLngTmplReferenceStrTwr.dText = !dText
  !this.opStrLngTmplReferenceStrTwr.rText = !rText

  --get the template reference
  !handraTemplate = object ARRAY()
  !handraTemplate = !!aslCentralData.getTemplates('HANDRA')

  !dText  = object ARRAY()
  !rText  = object ARRAY()
  do !handraTmpl values !handraTemplate
    !dText.append(!handraTmpl.description)
    !rText.append(!handraTmpl.string())
  enddo

  --assign the value to the option gadget
  !this.opHandRaTmplReferenceStrTwr.dText = !dText
  !this.opHandRaTmplReferenceStrTwr.rText = !rText

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateCataOptionsStrFlt
--
-- Description: updates the catalogue options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateCataOptionsStrFlt()

  --get the template reference
  !strFltTemplate = object ARRAY()
  !strFltTemplate = !!aslCentralData.getTemplates('STRFLT')

    !dText           = object ARRAY()
    !rText           = object ARRAY()
  do !strfltTmpl values !strFltTemplate
    !dText.append(!strfltTmpl.description)
    !rText.append(!strfltTmpl.string())
  enddo

  --assign the value to the option gadget
  !this.opStrFltTmplReferenceStrTwr.dText = !dText
  !this.opStrFltTmplReferenceStrTwr.rText = !rText

  --get the template reference
  !handraTemplate = object ARRAY()
  !handraTemplate = !!aslCentralData.getTemplates('HANDRA')

  !dText  = object ARRAY()
  !rText  = object ARRAY()
  do !handraTmpl values !handraTemplate
    !dText.append(!handraTmpl.description)
    !rText.append(!handraTmpl.string())
  enddo

  --assign the value to the option gadget
  !this.opFltHandRaTmplReference.dText = !dText
  !this.opFltHandRaTmplReference.rText = !rText

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyStrTwrTmplReference
--
-- Description: open callback from most gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      calling gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyStrTwrTmplReference(!gadget is GADGET, !action is STRING)

  --set the reference to the central template
  if ( !action.eq('SELECT') ) then
    if ( !gadget.name().eq('OPSTRLNGTMPLREFERENCESTRTWR') ) then
      !strLngTmplReference = !this.opStrLngTmplReferenceStrTwr.selection().dbRef()
      !this.meStrTwrEngine.setStrLngTemplateReferences(!strLngTmplReference)
      -- call to check for the gadget Update
      !this.checkLandingCatalogue()
    elseif ( !gadget.name().eq('OPHANDRATMPLREFERENCESTRTWR') ) then
      !handRaTmplReference = !this.opHandRaTmplReferenceStrTwr.selection().dbRef()
      !this.meStrTwrEngine.setHandraReferences(!handRaTmplReference)
      !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
      !this.updateHandrailLngProfile()
      if ( !this.toHandraProfileAid.val.eq(true) ) then
        !this.drawHandraAids()
      endif
    elseif ( !gadget.name().eq('OPSTRFLTTMPLREFERENCESTRTWR') ) then
      !strFltTmplReference = !this.opStrFltTmplReferenceStrTwr.selection().dbRef()
      !this.meStrTwrEngine.setStrFltReferences(!strFltTmplReference)
    endif
  endif
  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--.


-- Method:      checkInstallationoption
--
-- Description: callback to check installation option and check for gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .checkInstallationoption()

  --get the installation option
  !instLngOption = !this.meStrTwrEngine.getInstallationOption()
  --set the gadgets status
  if ( !instLngOption.eq( 'Two stairs, platform north and south' ) ) then
    !this.txStrLngWidthStrTwr.active     = false
    !this.toAidStrLngWidthStrTwr.active  = false
    !this.toAidStrLngWidthStrTwr.val     = false
    !this.txStrLngWidthStrTwr.val = !this.txStrLngLengthStrTwr.val
    !this.meStrTwrEngine.setStrLngWidth(!this.txStrLngWidthStrTwr.val)
  elseif ( !instLngOption.neq( 'Two stairs, platform north and south' ) ) then
    !this.txStrLngWidthStrTwr.active     = true
    !this.toAidStrLngWidthStrTwr.active  = true
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      checkLandingCatalogue
--
-- Description: callback to check for the gadget and installation template
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .checkLandingCatalogue()

  --get the catalogue details
  if ( !this.opStrLngTmplReferenceStrTwr.selection().dbRef().desc eq 'Concrete landing' ) then
      !this.lkPanelSpecification.active    = false
  elseif ( !this.opStrLngTmplReferenceStrTwr.selection().dbRef().desc neq 'Concrete landing' ) then
      !this.lkPanelSpecification.active     = true
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      showHandraSpecification
--
-- Description: opens the HANDRA specification form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showHandraSpecification(!id is STRING)

  -- Selection form title
  !title              = 'Handrail Detail Attributes'

  -- Action to be carried out
  !action             = '!!' & !this.name() & '.setHandraData(''' & !id & ''', !this.meHandraEngine)'

  --template Reference
  !handRaTmplReference = !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.meHandraEngine


  -- Setup object for profile selection
  !handraSelection    = object ASLSTRMEMBHANDRA(!title, !action, !handRaTmplReference)

  !handraSelection.meHandraEngine(!this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.meHandraEngine.tmplReference)

  -- Display profile selection form
  !handraSelection.show()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setHandraData
--
-- Description: sets the HANDRA specification data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setHandraData(!id is STRING, !meHandraEngine is ASLHANDRAIL)

  --update the profile data and aid graphics
  if (!id.eq('A')) then
    !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.meHandraEngine = !meHandraEngine

    !selectOpt = !meHandraEngine.tmplReference.refno.string()
    !this.opHandRaTmplReferenceStrTwr.select('RTEXT', !selectOpt)

    --clear the dimension
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
    --update the handrail data
    !this.updateHandrailLngProfile()
    if ( !this.toHandraProfileAid.val.eq(true) ) then
      !this.drawHandraAids()
    endif
  elseif (!id.eq('B')) then

  endif

  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      getStrTwrAbove
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     DBREF
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getStrTwrAbove(!item is DBREF) is DBREF

  !strTwr = nulref

  if !item.badRef() then
    return !strTwr
  endif

  -- compose hierarchy above passed element
  !ownType = !item.ahlis
  !ownList = !item.ownls
  -- add item itself
  !ownType.append(!item.type)
  !ownList.append(!item)

  -- get element
  !level = !ownType.findFirst('STRTWR')
  if !level.set() then
    !strTwr = !ownList[!level]
  endif

  return !strTwr

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      modifyStrTwr
--
-- Description: show main modification panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Stair Tower to be load into form and modified
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyStrTwr(!ref is DBREF)

  !this.formMode = 'MODIFY'

  !strTwr = !this.getStrTwrAbove(!ref)

  if !strTwr.unset() then
    !!alert.warning('Navigate to Stair Tower hierarchy.')
    return
  elseif !strTwr.set() then
    !this.meStrTwrEngine.strTwrData.refe = !strTwr
  endif

  -- Updates the current coordinates system
  !this.updateCoordinateSystem()

  -- removes aid constructor
  !!aslCentralData.clearFeedBack('AIDVOLMAINSTRTWR')
  !!aslCentralData.clearFeedBack('AIDVOLSTRTWR')
  !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
  !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
  !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
  !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')
  !!aslCentralData.clearFeedBack('AIDVOLSTRFLT')
  !!aslCentralData.clearFeedBack('AIDDIM')

  -- remove edg packet from stack first
  !!edgCntrl.remove(!this.edgStrTwrPosDescription)

  --general attributes
  if ( !strTwr.isnamed ) then
    !this.dbName.val = !strTwr.name
  else
    !this.dbName.val = 'Unset'
  endif

  if ( !strTwr.description.neq('') ) then
    !this.dbDescription.val = !strTwr.description
  else
    !this.dbDescription.val = 'Unset'
  endif

  --if ( !strTwr.function.neq('') ) then
  --  !this.dbFunction.val    = !strTwr.function
  --else
  --  !this.dbFunction.val    = 'Unset'
  --endif

  -- area and number attribute
  !this.dbArea.val          = !strTwr.area
  !this.dbNumber.val        = !strTwr.number

  -- Setting the stair tower position
  !this.position(!strTwr.pos)

  --pass the reference to stair tower data to extract data from the DB
  !this.meStrTwrEngine.updateDataObj(!strTwr)

  --adding pixmap and the install option
  !this.deriveInstallationOptionsStrTwr()

  --Setting the template reference
  !this.modifyCataOptionsStrTwr()

  --derive the Configuration Type
  !this.deriveConfigurationType(!ref)

  -- implement the .NET control
  using namespace 'Aveva.Pdms.Presentation'

  --set the headings of the level-list
  !heading[1] = 'No'
  !heading[2] = 'TOS of Beam (wrt Stair Tower)'

  --fill the title
  !title      = 'Beam Elevation Levels'

  --update the gadget
  !this.updateBeamLevel()

  --set the headings of the level-list
  !heading[1] = 'No'
  !heading[2] = 'FFL of Landings (wrt Stair Tower)'

  --fill the title
  !title      = 'Finished Floor Levels'

  --update the gadget
  !this.updateFflLevel()

  !this.frameChange(!this.frMain1)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      createStrTwr
--
-- Description: show main creation panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Stair Tower to be load into form and modified
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createStrTwr()

  !this.formMode = 'CREATE'

  !this.frameChange(!this.frMain1)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      getStrTwrOwner
--
-- Description: get possible stair tower owner passed db position, e.g db item that can own STRTWR
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       checked db element
--
-- Return:
--   [Data Type] [Description]
--    DBREF       possible Stair tower owner - nulref is returned if STRTWR cannot be created
--
------------------------------------------------------------------------

define method .getStrTwrOwner(!item is DBREF) is DBREF

  !owner = nulref
  --check if the storage area is set
  if(!!aslStoreTable.getStore('stairtower').set() and !!aslStoreTable.getStore('stairtower').badRef().not())then
    !owner = !!aslStoreTable.getStore('stairtower')
  endif

  -- compose hierarchy above passed element
  !ownType = !item.ahlis
  !ownList = !item.ownls
  -- add item itself
  !ownType.append(!item.type)
  !ownList.append(!item)

  -- declare possible owner types
  !olis[1] = 'STRU'
  !olis[2] = 'STRWEL'

  -- check if any of above is in a list
  !owners = !olis.intersect(!ownType)
  if !owners.set() then
  -- get element
    !type = !owners.last()
    !level = !ownType.findFirst(!type)
    !owner = !ownList[!level]
  endif

  return !owner

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      updateStrFltObject
--
-- Description: calculate the position for the stair flight and
--              object definition
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateStrFltObject()

  !!fmsys.setProgress(10)
  !!aslCentralData.clearFeedBack('AIDDIM')
  !!aslCentralData.clearFeedBack('AIDVOLENVELOPE')
  !!aslCentralData.clearFeedBack('AIDVOLMAIN')
  !!aslCentralData.clearFeedBack('AIDVOLSTRFLT')
  !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
  !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')

  --evaluate the Spacing
  !this.evaluateStrFltAtt()

  if ( !this.meStrTwrEngine.strTwrData.evaluateStrFltAtt.not() ) then
    return
  endif

  --set the boolean Value
  !this.meStrTwrEngine.strTwrData.evaluateSuccess = true

  --update the object
  !this.meStrTwrEngine.updateStrFltObject()

  --check for the evaluation boolean and proceed
  if ( !this.meStrTwrEngine.strTwrData.evaluateSuccess.not() ) then
    !this.frameChange(!this.frMain3Sub)
    !!aslCentralData.clearFeedBack('AIDDIM')
    !!aslCentralData.clearFeedBack('AIDVOLENVELOPE')
    !!aslCentralData.clearFeedBack('AIDVOLMAIN')
    !!aslCentralData.clearFeedBack('AIDVOLSTRFLT')
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
    !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
    return
  endif

  -- set the range
  !range[1] = 1
  !range[2] = !this.meStrTwrEngine.strTwrData.strFltObj.size()
  !range[3] = 1
  !this.nuFlightSegment.range = !range
  !this.nuFlightSegment.val = 1
  !this.paFlightSegment.val = ' of $!range[2]'

  --make the gadget active
  !this.nuFlightSegment.active   = true
  !this.paFlightSegment.active   = true
  !this.paGeneralAtt.active      = true
  !this.lnGeneralAtt.active      = true
  !this.buZoomFlt.active         = true
  !this.buWalkFlt.active         = true
  !this.toAidStrFltWidth.active  = true


  if ( !this.meStrTwrEngine.strTwrData.refe.set() ) then
    !collectFtl = object COLLECTION()
    !collectFtl.type('STRFLT')
    !collectFtl.scope(!this.meStrTwrEngine.strTwrData.refe)
    !resultFlt = !collectFtl.results()
  endif
  !!fmsys.setProgress(86)

  if ( ( !this.formMode.eq('CREATE') or !this.formMode.eq('MODIFY') ) and !resultFlt.empty() ) then
    !this.lkFrMain3Sub4.active      = true
    !this.lkFrMain3Sub4.visible     = true
    !this.updLkFrMain3Sub4.active   = false
    !this.updLkFrMain3Sub4.visible  = false
    !this.modLkFrMain3Sub4.active   = false
    !this.modLkFrMain3Sub4.visible  = false
    !this.paEvalFlt.active          = true
    !this.paEvalFlt.visible         = true
    !this.paReEvalFlt.active        = false
    !this.paReEvalFlt.visible       = false
    !this.buEvalFlt.active          = true
    !this.buEvalFlt.visible         = true
    !this.buReEvalFlt.active        = false
    !this.buReEvalFlt.visible       = false

  elseif ( !this.formMode.eq('CREATE') and !resultFlt.set() ) then
    !this.lkFrMain3Sub4.active      = false
    !this.lkFrMain3Sub4.visible     = false
    !this.updLkFrMain3Sub4.active   = true
    !this.updLkFrMain3Sub4.visible  = true
    !this.modLkFrMain3Sub4.active   = false
    !this.modLkFrMain3Sub4.visible  = false
    !this.paEvalFlt.active          = false
    !this.paEvalFlt.visible         = false
    !this.paReEvalFlt.active        = true
    !this.paReEvalFlt.visible       = true
    !this.buEvalFlt.active          = false
    !this.buEvalFlt.visible         = false
    !this.buReEvalFlt.active        = true
    !this.buReEvalFlt.visible       = true
  elseif ( !this.formMode.eq('MODIFY') ) then
    !this.lkFrMain3Sub4.active      = false
    !this.lkFrMain3Sub4.visible     = false
    !this.updLkFrMain3Sub4.active   = false
    !this.updLkFrMain3Sub4.visible  = false
    !this.modLkFrMain3Sub4.active   = true
    !this.modLkFrMain3Sub4.visible  = true
    !this.paEvalFlt.active          = false
    !this.paEvalFlt.visible         = false
    !this.paReEvalFlt.active        = true
    !this.paReEvalFlt.visible       = true
    !this.buEvalFlt.active          = false
    !this.buEvalFlt.visible         = false
    !this.buReEvalFlt.active        = true
    !this.buReEvalFlt.visible       = true
  endif

  !!fmsys.setProgress(100)

  --update the frame
  !this.strFltSegmentDetails(1)
  !!fmsys.setProgress(0)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      updateStrFltDB
--
-- Description: create the stair flight
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateStrFltDB()

  !!fmsys.setProgress(15)
  !this.meStrTwrEngine.updateStrFltDB()

  --check if handrail Update is required
  !instOpt       = !this.meStrTwrEngine.getInstallationOption()
  !xLength       = !this.meStrTwrEngine.getXLength()
  !yLength       = !this.meStrTwrEngine.getYLength()
  !strWdt        = !this.meStrTwrEngine.getFltWidth()
  !fltClXSpacing = !this.meStrTwrEngine.getFltCLXSpacing()
  !fltClYSpacing = !this.meStrTwrEngine.getFltCLYSpacing()
  !totalXlength  = !strWdt + !fltClXSpacing
  !totalYlength  = !strWdt + !fltClYSpacing

  if ( !instOpt.eq('Two stairs, platform north and south') ) then
    if ( !totalXlength.lt( !xLength ) ) then
      !alertMessage = object BOOLEAN()
      !alertMessage = true
    elseif ( !totalXlength.geq(!xLength) ) then
      !alertMessage = object BOOLEAN()
      !alertMessage = false
    endif
  elseif ( !instOpt.eq('One stair, stair north') ) then
    if ( !totalYlength.lt( !yLength ) ) then
      !alertMessage = object BOOLEAN()
      !alertMessage = true
    elseif ( !totalYlength.geq(!yLength) ) then
      !alertMessage = object BOOLEAN()
      !alertMessage = false
    endif
  elseif ( !instOpt inset( 'Three stairs, platform south', 'Four stairs' ) ) then
    if ( !totalYlength.lt( !yLength ) ) then
      !alertMessage = object BOOLEAN()
      !alertMessage = true
    elseif ( !totalYlength.geq(!yLength) ) then
      !alertMessage = object BOOLEAN()
      !alertMessage = false
    elseif ( !totalXlength.lt( !xLength ) ) then
      !alertMessage = object BOOLEAN()
      !alertMessage = true
    elseif ( !totalXlength.geq(!xLength) ) then
      !alertMessage = object BOOLEAN()
      !alertMessage = false
    endif
  endif


  if ( !alertMessage.set() and !alertMessage.eq(true) ) then
    if ( !!alert.confirm('Update Stair Landing Handrail Details to match the Stair Flight Handrail?.').eq('YES') ) then
      !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.updateHandrail = true
      !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.updateStrLngDB()
      !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.updateHandrail = false
    endif

    --clear the aid
    !!aslCentralData.clearFeedBack('AIDVOLDATUM')
    !!aslCentralData.clearFeedBack('AIDVOLMAINSTRTWR')
    !!aslCentralData.clearFeedBack('AIDVOLSTRTWR')
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
    !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
    !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
    !!aslCentralData.clearFeedBack('AIDVOLLINECOLUMN')
    !!aslCentralData.clearFeedBack('AIDVOLSTRFLT')
    !!aslCentralData.clearFeedBack('AIDDIM')
    !!aslCentralData.clearFeedBack('AIDVOLPLANES')
    !!aslCentralData.clearFeedBack('AIDVOLENVELOPE')
    !!aslCentralData.clearFeedBack('AIDVOLMAIN')
    !!aslCentralData.clearFeedBack('AIDVOLCL')
    !!aslCentralData.clearFeedBack('AIDVOLARROW')


    --add the stair tower
    !!ce = !this.meStrTwrEngine.strTwrData.refe
    --add ce

    --update the frame
    !this.nuFlightSegment.val = 1
    !this.strFltSegmentDetails(1)
    !!fmsys.setProgress(0)
  endif

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      updateStrFltDB
--
-- Description: create the stair flight
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .strFltSegmentDetails(!index is REAL)

  --set the gadget value on navigation
  !lwp = !this.meStrTwrEngine.strTwrData.strFltObj[!index].lwp
  !uwp = !this.meStrTwrEngine.strTwrData.strFltObj[!index].uwp

  -- initialise an array
  !columns = object ARRAY()
  --main heading
  !col = object ARRAY()
  !col.append('LWP')
  !col.append(!this.meStrTwrEngine.strTwrData.strFltObj[!index].lwp.string())
  !columns.append(!col)


  !col = object ARRAY()
  !col.append('UWP')
  !col.append(!this.meStrTwrEngine.strTwrData.strFltObj[!index].uwp.string())
  !columns.append(!col)

  !col = object ARRAY()
  !col.append('Flight Direction')
  !col.append(!this.meStrTwrEngine.strTwrData.strFltObj[!index].fltDirection.string())
  !columns.append(!col)

  !col = object ARRAY()
  !col.append('Over all Length')
  !col.append(!this.meStrTwrEngine.strTwrData.strFltObj[!index].oGoing.string(!!distanceFmt))
  !columns.append(!col)

  !col = object ARRAY()
  !col.append('Over all Height')
  !col.append(!this.meStrTwrEngine.strTwrData.strFltObj[!index].oRise.string(!!distanceFmt))
  !columns.append(!col)

  !col = object ARRAY()
  !col.append('Lower Rise')
  !col.append(!this.meStrTwrEngine.strTwrData.strFltObj[!index].lRise.string(!!distanceFmt))
  !columns.append(!col)

  !col = object ARRAY()
  !col.append('Flight Pitch')
  !col.append(!this.meStrTwrEngine.strTwrData.strFltObj[!index].flights[1].pitch.string(!!distanceFmt))
  !columns.append(!col)

  !col = object ARRAY()
  !col.append('Flight Width')
  !col.append(!this.meStrTwrEngine.strTwrData.strFltObj[!index].width.string(!!distanceFmt))
  !columns.append(!col)

  !col = object ARRAY()
  !col.append('Flight Going')
  !col.append(!this.meStrTwrEngine.strTwrData.strFltObj[!index].going.string(!!distanceFmt))
  !columns.append(!col)

  !col = object ARRAY()
  !col.append('Flight Rise')
  !col.append(!this.meStrTwrEngine.strTwrData.strFltObj[!index].rise.string(!!distanceFmt))
  !columns.append(!col)


  --set the values to the list gadget
  !this.lsAttStrFlt.setrows(!columns)

  if ( !this.meStrTwrEngine.strTwrData.strFltObj[!index].refe.set() )then
    !dbElement = !this.meStrTwrEngine.strTwrData.strFltObj[!index].refe
    if ( !dbElement.badRef().not() ) then
      !!ce = !dbElement
    else
      !!alert.error('Flight No. $!index Does not exists, check for UNSET or DELETED Item ')
    endif
  endif

  !!fmsys.setProgress(88)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      strFltSegmentDetails
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .strFltSegmentDetails(!dummyGadget is GADGET, !dummyAction is STRING)

  !!fmsys.setProgress(10)
  !!aslCentralData.clearFeedBack('AIDVOLMAINSTRTWR')

  !index  = !this.nuFlightSegment.val

  -- get the position
  !lwp = !this.meStrTwrEngine.strTwrData.strFltObj[!index].lwp
  !uwp = !this.meStrTwrEngine.strTwrData.strFltObj[!index].uwp

  -- draw the aid text
  !midPoint = !lwp.midPoint(!uwp)
  !text = 'Flight' & ' ' & '$!index'
  AID TEXT   NUMBER $!!<aslCentralData.aidVolMainStrTwr> '$!text' AT $!midPoint


  --update the graphics
  AID SPHERE NUMBER $!!<aslCentralData.aidVolMainStrTwr> $!lwp DIAM 250mm
  AID SPHERE NUMBER $!!<aslCentralData.aidVolMainStrTwr> $!uwp DIAM 250mm

  if(!index.eq(0)) then
    !this.nuSegmentStrflt.val = 1
  else
    !this.strFltSegmentDetails(!index)
  endif
  !!fmsys.setProgress(60)

  --draw a the route path profile between the points
  !this.meStrTwrEngine.strTwrData.strFltObj[!index].rpath.draw(!!aslCentralData.aidVolMainStrTwr, !!aslCentralData.lineStyleDashedThick  ,!!aslCentralData.colourSteelBeam, false)

  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      zoomStrFltSegmentDetails
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .zoomStrFltSegmentDetails()

  -- get the position and index
  !index  = !this.nuFlightSegment.val
  !lwp = !this.meStrTwrEngine.strTwrData.strFltObj[!index].lwp
  !uwp = !this.meStrTwrEngine.strTwrData.strFltObj[!index].uwp

  -- update the gphview to the set the volume
  !fromPosition = !lwp
  !toPosition   = !uwp
  !volume       = object VOLUME(!fromPosition, !toPosition)
  do !view value !!gphviews.views
    !!gphviews.limits(!view, !volume)
  enddo

  --highlight ce
  if ( !this.meStrTwrEngine.strTwrData.strFltObj[!index].refe.set() ) then
    !dbElement = !this.meStrTwrEngine.strTwrData.strFltObj[!index].refe
    if ( !dbElement.badRef().not() ) then
      !!ce = !dbElement
    else
      !!alert.error('Flight No. $!index Does not exists, check for UNSET or DELETED Item ')
    endif
    do from 1 to 2
      rem ce
      !!gph3ddesign1.view.refresh()
      add ce
      !!gph3ddesign1.view.refresh()
    enddo
  endif

  !!fmsys.setProgress(0)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      walkToStrTwrDetails
--
-- Description: update the gadgets
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .walkToStrTwrDetails()

  !!aslCentralData.clearFeedBack('AIDVOLMAINSTRTWR')
  !pos = !this.meStrTwrEngine.strTwrData.position

  !fromPosition = !pos
  !toPosition   = !pos.offset(U, !this.meStrTwrEngine.strTwrData.zLength)
  !volume       = object VOLUME(!fromPosition, !toPosition)
  do !view value !!gphviews.views
    !!gphviews.limits(!view, !volume)
  enddo

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      drawHandraProfileAids
--
-- Description: draw the HANDRA profile aids
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .drawHandraProfileAids()

  if ( !this.toHandraProfileAid.val.eq(true) ) then
    !this.meStrTwrEngine.strTwrData.drawHandraAids()
  else
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
  endif
  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateGadgetHandraAid
--
-- Description: update the gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .updateGadgetHandraAid()

  if ( !this.toHandraProfileAid.val.eq(true) ) then
    !this.toHandraProfileAid.val = false
    !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
  elseif ( !this.toHandraProfileAid.val.eq(false) ) then
    !this.toHandraProfileAid.val = true
    !this.drawHandraProfileAids()
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateGadgetHandraAid
--
-- Description: update the gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .updateGadgetHandra()

  if ( !this.toHandraMatchFlt.val.eq(true) ) then
    !this.toHandraMatchFlt.val = false
  elseif ( !this.toHandraMatchFlt.val.eq(false) ) then
    !this.toHandraMatchFlt.val = true
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      modifyCataOptionsStrTwr
--
-- Description: update the option gadget for template assembly
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .modifyCataOptionsStrTwr()

  --check for the stair landing existence
  !collStrLng = object COLLECTION()
  !collStrLng.scope(!this.meStrTwrEngine.strTwrData.refe)
  !collStrLng.type('STRLNG')
  !resultLng = !collStrLng.results()

  if ( !resultLng.set() ) then
  --update the selection for the options
  if ( !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.strLngTmplReference.set() ) then
      !this.opStrLngTmplReferenceStrTwr.select('DTEXT', !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.strLngTmplReference.desc)
    endif
  endif

  !this.opHandRaTmplReferenceStrTwr.select('DTEXT', !this.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.meHandraEngine.tmplReference.desc)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      addGate
--
-- Description: Invoke edg mode to add gate to handrail object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addGate()

  -- Initialise Variables for EDG
  !prompt               = 'Pick position to insert GATE'
  !packet               = object EDGPACKET()
  !packet.description   = !this.edgDescription
  !packet.remove        = FALSE
  !packet.action        = !this.fullname() & '.addGate(!this.return[1])'
  !packet.close         = !this.fullname() & '.posGate.active = true ' & !this.fullname() & '.addGate.active = true'
  !packet.priority      = 1
  !pickPacket = object EDGPICKPACKET()
  !pickPacket.stdPosition(!prompt)
  !packet.pickPacket = !pickPacket

  -- inactive gate buttons
  !this.posGate.active = FALSE
  !this.addGate.active = FALSE

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      aslStrTwrTosPopupCallback
