-- End of method
------------------------------------------------------------------------
--
-- Method:      pickBeamLevelReturn
--
-- Description: repositions intermediate beam level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA
--                           edg pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pickBeamLevelReturn(!positionData is EDGPOSITIONDATA)

  !rows = !this.neBeamLevel.getSelectedRows()
  if ( ( !rows.empty() ) or ( !rows.size().gt(1) ) ) then
    !!alert.warning('Select a Row to Set the Elevation')
    return
  endif

  -- find out which level to be positioned
  !allLevel              = !this.meStrTwrEngine.getBeamLevelStrTwr()
  !index                 = !rows[1][1].real()
  !currentBmLevel        = !allLevel[!index]
  !beamLevelStoreStrTwr  = object BOOLEAN()
  !beamLevelStoreStrTwr  = false

  -- get the gate data
  !position              = !positionData.position
  !editBmLevel           = !position.wrt(!this.meStrTwrEngine.strTwrData.refe).up

  --get the stair tower Position
  !strTwrPos = !this.meStrTwrEngine.getPosition()

  if ( !editBmLevel.gt( !this.txZLengthStrTwr.val ) ) then
    !beamLevelStoreStrTwr = true
    !!alert.error('Picked TOS of Beam is greater the Tower Z Height.')
    return
  elseif ( !editBmLevel.lt( !strTwrPos.up ) ) then
    !beamLevelStoreStrTwr = true
    !!alert.error('Picked TOS of Beam is Lesser than Stair Tower Origin.')
    return
  endif

  --check with the picked column
  if ( !currentBmLevel.eq( !editBmLevel ) ) then
    !beamLevelStoreStrTwr = true
    !!alert.error('Picked TOS($!editBmLevel) and Existing TOS($!currentBmLevel) is same. Please pick an other level.')
    return
    --!this.pickBeamlevel()
  else
    do !i from 1 to !allLevel.size()
    --check with other values
      if ( !editBmLevel eq !allLevel[!i] ) then
        !beamLevelStoreStrTwr = true
        !!alert.error('Picked TOS already exists in the table. Please Select an other value.')
        return
      endif
      skip
    enddo
  endif

  if ( !beamLevelStoreStrTwr.eq(false) ) then
    -- load the level to the object
    !this.meStrTwrEngine.replaceBeamLevel(!editBmLevel, !index)
  endif

  -- sort the Levels
  !this.meStrTwrEngine.strTwrData.sortBeamLevel()

  -- update the beam level
  !this.updateBeamLevel()

  --update the profile data and aid graphics
  !this.updateColumnProfileData()
  !this.updateBeamProfileData()

  --draw the datum
  !this.drawDatum()
  !!fmsys.setProgress(0)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      pickFflLevelReturn
--
-- Description: repositions intermediate FFL level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA
--                           edg pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .pickFflLevelReturn(!positionData is EDGPOSITIONDATA)

  !rows = !this.neFflLevel.getSelectedRows()
  if ( ( !rows.empty() ) or ( !rows.size().gt(1) ) ) then
    !!alert.warning('Select a Row to Set the Elevation')
    return
  endif

  -- find out which level to be positioned
  !allLevel             = !this.meStrTwrEngine.getFflLevelStrTwr()
  !index                = !rows[1][1].real()
  !currentFflLevel      = !allLevel[!index]
  !fflLevelStoreStrTwr  = object BOOLEAN()
  !fflLevelStoreStrTwr  = false

  -- get the gate data
  !position             = !positionData.position
  !editFflLevel         = !position.wrt(worl).up

  --get the stair tower Position
  !strTwrPos = !this.meStrTwrEngine.getPosition()

  if ( !editFflLevel.gt( !this.txZLengthStrTwrSub.val ) ) then
    !fflLevelStoreStrTwr = true
    !!alert.error('Picked Finished Floor Level is greater the Tower Z Height.')
    return
  elseif ( !editFflLevel.lt( !strTwrPos.up ) ) then
    !fflLevelStoreStrTwr = true
    !!alert.error('Picked Finished Floor Level is Lesser the Tower Z Height.')
    return
  endif

  --check with the picked column
  if ( !currentFflLevel.eq( !editFflLevel ) ) then
    !fflLevelStoreStrTwr = true
    !!alert.error('Picked Finished Floor Level($!editFflLevel) and Existing Finished Floor Level($!currentBmLevel) is same.')
    return
    --!this.pickBeamlevel()
  else
    do !i from 1 to !allLevel.size()
    --check with other values
      if ( !editFflLevel eq !allLevel[!i] ) then
        !fflLevelStoreStrTwr = true
        !!alert.error('Picked Finished Floor Level already exists in the table. Please Select an other value.')
        return
      endif
      skip
    enddo
  endif

  if ( !fflLevelStoreStrTwr.eq(false) ) then
    -- load the level to the object
    !this.meStrTwrEngine.replaceFflLevel(!editFflLevel, !index)
  endif

  -- sort the Levels
  !this.meStrTwrEngine.strTwrData.sortFflLevel()

  --updating the graphical aids
  --clear aids if ANY
  !!aslCentralData.clearFeedBack('AIDVOLHANDRA')
  !!aslCentralData.clearFeedBack('AIDVOLLINEFFL')
  !!aslCentralData.clearFeedBack('AIDVOLLINEBEAM')
  !!aslCentralData.clearFeedBack('AIDDIM')

  -- update the FFL level
  !this.updateFflLevel()

  --update the tie beam profile Data
  !this.updateTieBeamProfileData()

  --draw the centreline
  !this.drawCentreLines()

  --draw the ffl level aid
  !this.drawFflLevelAid()

  --draw the handrail Data
  !this.updateHandrailLngProfile()

  if ( !this.toHandraProfileAid.val.eq(true) ) then
    !this.drawHandraAids()
  endif

endmethod
