------------------------------------------------------------------------
--
-- Method:      updateColumnBeamProfileDb
--
-- Description: creates the column and beam details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateColumnBeamProfileDb()

  !!fmsys.setProgress(10)
  --navigate to the stair tower
  !this.ceValidCheck()

  if ( !this.meStrTwrEngine.strTwrData.beamLevelStrTwr.empty() ) then
    !!alert.error('Cannot create Tower Steel with TOS Levels set to empty')
    !!fmsys.setProgress(0)
    return
  else
    -- creates the DB elements
    !!fmsys.setProgress(20)
    !this.meStrTwrEngine.strTwrData.updateColumnProfileDb()
    !this.meStrTwrEngine.strTwrData.updateBeamProfileDb()
  endif
  !!fmsys.setProgress(83)
  --add ce
  !!ce = !this.meStrTwrEngine.strTwrData.refe
  --add all for ce

  --disconnect all the sections
  !this.meStrTwrEngine.strTwrData.tieBeamProfile.disConnect( !this.meStrTwrEngine.strTwrData.refe )

  --connect the sections
  if ( !this.toConnSections.val ) then
    !this.meStrTwrEngine.strTwrData.tieBeamProfile.connect( !this.meStrTwrEngine.strTwrData.refe )
  endif

  --update the frame once tower steel is created
  !this.frameChange(!this.frMain3)

endmethod
-- End of method
