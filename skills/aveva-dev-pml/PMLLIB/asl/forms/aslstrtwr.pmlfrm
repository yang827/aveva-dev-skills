------------------------------------------------------------------------

define method .rtoggleCallChange()

  if ( !this.createTwrStl.val.eq(true) and !this.formMode.eq('CREATE') ) then
    !this.message.val = 'Creates the Stair Tower layout and Supporting Steel structure.'
    !this.message.background = 3
  elseif (!this.createTwrStl.val.eq(true) and !this.formMode.eq('MODIFY') ) then
    !this.message.val = 'Modifies the Stair Tower layout and Supporting Steel structure.'
    !this.message.background = 3
  elseif( !this.skipTwrStl.val.eq(true) and !this.formMode.eq('CREATE') ) then
    !this.message.val = 'Creates the Stair Tower layout without the Supporting Steel structure.'
    !this.message.background = 40
  elseif( !this.skipTwrStl.val.eq(true) and !this.formMode.eq('MODIFY') ) then
    !this.message.val = 'Modifies the Stair Tower layout without the Supporting Steel structure.'
    !this.message.background = 40
  endif

endmethod
