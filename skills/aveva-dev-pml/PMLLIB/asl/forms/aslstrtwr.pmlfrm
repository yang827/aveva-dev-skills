   -- Form Members
  member .meStrTwrEngine          is ASLSTRTWRENGINE
---------------------------------------------------------------------------
  -- .Net control
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'
  member .strTwrPosControl        is POSITIONCONTROL
  --member .strFltPosCtrl1          is POSITIONCONTROL
  --member .strFltPosCtrl2          is POSITIONCONTROL
---------------------------------------------------------------------------
  -- Members for Plane definition in EDGPICK
  member .planeNumber             is ARRAY

  -- Desc for position pick for stair tower
  member .edgStrTwrPosDescription is STRING
---------------------------------------------------------------------------
  -- Members for net grid control
  member .neBeamLevel             is NETGRIDCONTROL
  member .neFflLevel              is NETGRIDCONTROL
  member .gatesControl            is NETGRIDCONTROL
---------------------------------------------------------------------------
  -- Members for profile Data Selection
  member .profileDataA  is PROFILECATALOGUEDATA
  member .profileDataB  is PROFILECATALOGUEDATA
  member .profileDataC  is PROFILECATALOGUEDATA
---------------------------------------------------------------------------
  -- Members for form mode Selection
  member .formMode      is STRING

---------------------------------------------------------------------------

  -- define the popup menu for TOS
  menu .aslStrTwrTosPopup  popup
  !this.aslStrTwrTosPopup.add( 'CALLBACK', 'Position Beam Level...', '!this.pickBeamlevel()' )
  !this.aslStrTwrTosPopup.add( 'CALLBACK', 'Remove Beam Level...', '!this.deleteBeamLevelStrTwr()')

  -- define the popup menu for TOS
  menu .aslStrTwrFflPopup  popup
  !this.aslStrTwrFflPopup.add( 'CALLBACK', 'Position FFL Level...', '!this.pickFfllevel()' )
  !this.aslStrTwrFflPopup.add( 'CALLBACK', 'Remove FFL Level...', '!this.deleteFflLevelStrTwr()')

exit

--End of form Definition

---------------------------------------------------------------------------
--
-- Method:      aslStrTwr
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
---------------------------------------------------------------------------

define method .aslStrTwr()

  -- set the form mode
  !this.formMode = 'CREATE'

  --update the cata options for Stair Landing
  !this.updateCataOptionsStrLng()

  --update the cata options for Stair Landing
  !this.updateCataOptionsStrFlt()

  --select the template reference
  !strFltTmplReference = !this.opStrFltTmplReferenceStrTwr.selection().dbRef()
  !strLngTmplReference = !this.opStrLngTmplReferenceStrTwr.selection().dbRef()
  !handRaTmplReference = !this.opHandRaTmplReferenceStrTwr.selection().dbRef()

  --set the template references
  !this.meStrTwrEngine.dfltTempRef(!strFltTmplReference, !strLngTmplReference, !handRaTmplReference)

  --set the setting reference
  !this.meStrTwrEngine.setSettingReference()

  --call the Initialise for form values for the first time
  !this.meStrTwrEngine.getDefaults()

  --fill the section profile gadgets with some default values
  !this.profileSectA.val = 'BS-SPEC/254x254x107kg/m'
  !this.profileJustA.val = 'NA'
  !this.profileSectB.val = 'BS-SPEC/203x133x30kg/m'
  !this.profileJustB.val = 'TOS'
  !this.profileSectC.val = 'BS-SPEC/203x133x30kg/m'
  !this.profileJustC.val = 'TOS'

  ------------------Setup for position control-----------------------------
  -- Declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  --Create new instance of position control
  !this.strTwrPosControl    = object POSITIONCONTROL()

  --Load ship grid data
  !grid                     = object SHIPGRID()
  !gridDefined              = !grid.position.set()

  -- Only populate the grid data if a ship reference grid is available
  if(!gridDefined) then

    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.strTwrPosControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialise as grid control and Specify tags
    !this.strTwrPosControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.strTwrPosControl.heading('World Position')
    !this.strTwrPosControl.gridFormat()

  else

    var !coordinate coordinate
    if(!coordinate.eq('ENU'))then
      !this.strTwrPosControl.enuFormat()
    else
      !this.strTwrPosControl.xyzFormat()
    endif

    !this.strTwrPosControl.gridVisible(false)

  endif
  -- End of codes for Implementing positional control

  --add PMLnet control change action to the frame
  !this.strTwrPosControl.changeAction('!!'& !this.name() & '.chkpos()')

  -- Add PMLNet control to PML frame
  !this.netStrTwrPositionFrame.control  = !this.strTwrPosControl.handle()

  -- general form data
  !this.autoscroll               = true
  !this.callback                 = '!this.setup()'
  !this.formRevision             = ' $Revision$ '
  !this.formTitle                = 'Create Stair Tower'
  !this.quitCall                 = '!this.closeForm()'
  !this.edgStrTwrPosDescription  = 'Pick to Position Stair tower'
  !this.dbName.val               = 'Unset'
  !this.dbDescription.val        = 'Unset'
  --!this.dbFunction.val           = 'Unset'
  !this.createTwrStl.val         = true
  !this.profileSectA.editable    = false
  !this.profileSectB.editable    = false
  !this.profileSectC.editable    = false
  !this.profileJustA.editable    = false
  !this.profileJustB.editable    = false
  !this.profileJustC.editable    = false

  --form gadget callback
  !this.createTwrStl.callback   = '!this.rtoggleCallChange()'
  !this.skipTwrStl.callback     = '!this.rtoggleCallChange()'
  !this.rtoggleCallChange()

  ---------------------------------------------------------------------------------------
