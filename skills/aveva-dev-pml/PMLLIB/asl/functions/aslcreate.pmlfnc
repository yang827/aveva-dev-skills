--
--
--  Description:    creates a given asl element
--
----------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      type of the element
--    2   R      DBREF       reference of the element
-- Return:
--   [Data Type] [Description]
--    DBREF       reference of the element
------------------------------------------------------------------------

define function !!aslCreate(!type is STRING, !refe is DBREF) is DBREF

  -- creates the owner element
  if ( !refe.badRef() ) then
    -- creates a new element
    if ( !refe.unset() ) then
      NEW $!type

    -- recreates a new element with a given reference number
    else
      NEW $!type REF $!refe
    endif

  -- updates an existing element
  else
    !!ce = !refe
    DELETE $!type
    NEW $!type REF $!refe
  endif

  return !!ce

endfunction
