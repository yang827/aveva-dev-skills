--
--
--  Description:    enhance the element with the given reference
--
----------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference of the element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define function !!aslEnhance(!refe is DBREF)

  if ( !refe.set() and $
       !refe.badRef().not() ) then
    var !allElem collect all for $!refe
    !hColour = !!gphColOpt.highlight().code
    ENHANCE ALL FROM !allElem COLOUR $!hColour
  endif

endfunction
