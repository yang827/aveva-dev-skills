--
--
--  Description:    erase a given asl element
--
----------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference of the element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define function !!aslErase(!refe is DBREF)

  -- deletes the element
  if ( !refe.badRef().not() ) then
    -- stores the current position within the db
    !oldRefe = !!ce

    -- jump to element
    !!ce = !refe

    -- evaluates the type of the element
    !type = !!ce.type

    -- deletes the element
    DELETE $!type

    -- try jump to the previous element
    if ( !oldRefe.badRef().not() ) then
      !!ce =  !oldRefe
    endif
  endif

endfunction
