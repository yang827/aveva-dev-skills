--
--
--  Description:
--
----------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   R      EDGPOSITIONDATA  lower position data
--    2   R      EDGPOSITIONDATA  upper position data
--    3   R      STRING           installation option
-- Return:
--   [Data Type] [Description]
--    ARRAY       description and pixmap of options
------------------------------------------------------------------------

define function !!aslGetDirectionOptions(!lPosData is EDGPOSITIONDATA, !uPosData is EDGPOSITIONDATA, !installationOption is STRING) is ARRAY

  -- inits
  !directionLabels  = object ARRAY()
  !directionPixmaps = object ARRAY()

  var !coordinate coordinate
  if(!coordinate.eq('ENU'))then
    !directionLabelX1 = 'East'
    !directionLabelX2 = 'West'
    !directionLabelY1 = 'North'
    !directionLabelY2 = 'South'
  else
    !directionLabelX1 = 'X'
    !directionLabelX2 = '-X'
    !directionLabelY1 = 'Y'
    !directionLabelY2 = '-Y'
  endif
  -- two lines
  ---------------------------------------------------------------------------
  if ( !lPosData.line.set() and $
       !uPosData.line.set() ) then
    -- parallel lines
    if( !lPosData.line.direction().isParallel(!uPosData.line.direction()) ) then
      if ( !installationOption.matchwild('Standard installation*') ) then
        !directionLabels.append('Orthogonal to lines')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation01-16.png'))
      elseif ( !installationOption.eq('Parallel to lines, flight right, exit front') ) then
        !directionLabels.append('Parallel to lines')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation04-16.png'))
      elseif ( !installationOption.eq('Parallel to lines, flight left, exit front') ) then
        !directionLabels.append('Parallel to lines')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation05-16.png'))
      elseif ( !installationOption.matchwild('Parallel to lines, flight right, exit backwards*') ) then
        !directionLabels.append('Parallel to lines')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation06-16.png'))
      elseif ( !installationOption.matchwild('Parallel to lines, flight left, exit backwards*') ) then
        !directionLabels.append('Parallel to lines')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation07-16.png'))
      endif

    -- orthogonal lines
    elseif( !lPosData.line.direction().angle(!uPosData.line.direction()).between(88, 92) ) then
      if ( !installationOption.eq('Parallel to upper line, exit left') ) then
        !directionLabels.append('Parallel to upper line, orthogonal to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation16-16.png'))
      elseif ( !installationOption.eq('Parallel to upper line, exit right') ) then
        !directionLabels.append('Parallel to upper line, orthogonal to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation17-16.png'))
      elseif ( !installationOption.eq('Parallel to lower line, flight left') ) then
        !directionLabels.append('Parallel to lower line, orthogonal to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation18-16.png'))
      elseif ( !installationOption.eq('Parallel to lower line, flight right') ) then
        !directionLabels.append('Parallel to lower line, orthogonal to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation19-16.png'))
      endif

    -- non parallel lines
    else
      -- Standard installation
      if ( !installationOption.matchwild('Standard installation*') ) then
        !directionLabels.append('Orthogonal to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation02-16.png'))
        !directionLabels.append('Orthogonal to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation03-16.png'))

      elseif ( !installationOption.eq('Parallel to lines, flight right, exit front') ) then
        !directionLabels.append('Parallel to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation08-16.png'))
        !directionLabels.append('Parallel to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation09-16.png'))

      elseif ( !installationOption.eq('Parallel to lines, flight left, exit front') ) then
        !directionLabels.append('Parallel to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation10-16.png'))
        !directionLabels.append('Parallel to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation11-16.png'))

      elseif ( !installationOption.matchwild('Parallel to lines, flight right, exit backwards*') ) then
        !directionLabels.append('Parallel to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation12-16.png'))
        !directionLabels.append('Parallel to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation13-16.png'))

      elseif ( !installationOption.matchwild('Parallel to lines, flight left, exit backwards*') ) then
        !directionLabels.append('Parallel to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation14-16.png'))
        !directionLabels.append('Parallel to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation15-16.png'))

      elseif ( !installationOption.eq('Parallel to upper line, exit left') ) then
        !directionLabels.append('Orthogonal to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation20-16.png'))
        !directionLabels.append('Parallel to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation21-16.png'))

      elseif ( !installationOption.eq('Parallel to upper line, exit right') ) then
        !directionLabels.append('Orthogonal to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation22-16.png'))
        !directionLabels.append('Parallel to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation23-16.png'))

      elseif ( !installationOption.eq('Parallel to lower line, flight left') ) then
        !directionLabels.append('Parallel to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation24-16.png'))
        !directionLabels.append('Orthogonal to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation25-16.png'))

      elseif ( !installationOption.eq('Parallel to lower line, flight right') ) then
        !directionLabels.append('Parallel to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation26-16.png'))
        !directionLabels.append('Orthogonal to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation27-16.png'))
      endif
    endif

  -- one line and one point
  ---------------------------------------------------------------------------
  elseif ( !lPosData.line.set()   and $
           !uPosData.line.unset() or $
           !lPosData.line.unset() and $
           !uPosData.line.set() ) then

    -- is the left or the right end of the line nearer to the pick?
    if ( !lPosData.line.set() ) then
      if ( !installationOption.matchwild('Standard installation*') ) then
        !directionLabels.append('Orthogonal to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation02-16.png'))

      elseif ( !installationOption.eq('Parallel to lower line, flight left') ) then
        !directionLabels.append('Parallel to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation24-16.png'))

      elseif ( !installationOption.eq('Parallel to lower line, flight right') ) then
        !directionLabels.append('Parallel to lower line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation26-16.png'))
      endif

    -- upper line is set
    else
      if ( !installationOption.matchwild('Standard installation*') ) then
        !directionLabels.append('Orthogonal to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation03-16.png'))

      elseif ( !installationOption.eq('Parallel to upper line, exit left') ) then
        !directionLabels.append('Parallel to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation21-16.png'))

      elseif ( !installationOption.eq('Parallel to upper line, exit right') ) then
        !directionLabels.append('Parallel to upper line')
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation23-16.png'))
      endif
    endif

  -- two points
  ---------------------------------------------------------------------------  elseif ( !lPosData.set() ) then
  else
    if ( !installationOption.neq('Standard installation Ladder') ) then
      !direction = !lPosData.position.direction(!uPosData.position)
      if ( !direction.north.gt(0) ) then
        !directionLabels.append(!directionLabelY1)
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation28-16.png'))
      elseif ( !direction.north.lt(0) ) then
        !directionLabels.append(!directionLabelY2)
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation30-16.png'))
      endif
      if ( !direction.east.gt(0) ) then
        !directionLabels.append(!directionLabelX1)
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation29-16.png'))
      elseif ( !direction.east.lt(0) ) then
        !directionLabels.append(!directionLabelX2)
        !directionPixmaps.append(!!pml.getPathName('asldirectionsituation31-16.png'))
      endif
    endif
  endif

  if ( !installationOption.eq('Standard installation Ladder') ) then
    !directionLabels.append(!directionLabelY1)
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation28-16.png'))
    !directionLabels.append(!directionLabelY2)
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation30-16.png'))
    !directionLabels.append(!directionLabelX1)
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation29-16.png'))
    !directionLabels.append(!directionLabelX2)
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation31-16.png'))
  endif

  -- add the derived direction and explicit direction pixmaps
  !directionLabels.append('Derived direction')
  !directionLabels.append('Explicit direction...')
  if ( !installationOption.matchwild('Standard installation*') ) then
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation48-16.png'))
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation49-16.png'))

  elseif ( !installationOption.eq('Parallel to lines, flight right, exit front') ) then
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation32-16.png'))
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation40-16.png'))

  elseif ( !installationOption.eq('Parallel to lines, flight left, exit front') ) then
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation33-16.png'))
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation41-16.png'))

  elseif ( !installationOption.matchwild('Parallel to lines, flight right, exit backwards*') ) then
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation34-16.png'))
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation42-16.png'))

  elseif ( !installationOption.matchwild('Parallel to lines, flight left, exit backwards*') ) then
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation35-16.png'))
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation43-16.png'))

  elseif ( !installationOption.eq('Parallel to upper line, exit left') ) then
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation36-16.png'))
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation44-16.png'))

  elseif ( !installationOption.eq('Parallel to upper line, exit right') ) then
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation37-16.png'))
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation45-16.png'))

  elseif ( !installationOption.eq('Parallel to lower line, flight left') ) then
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation38-16.png'))
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation46-16.png'))

  elseif ( !installationOption.eq('Parallel to lower line, flight right') ) then
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation39-16.png'))
    !directionPixmaps.append(!!pml.getPathName('asldirectionsituation47-16.png'))
  endif

  !directionOptions = object ARRAY()
  !directionOptions.append(!directionLabels)
  !directionOptions.append(!directionPixmaps)

  return !directionOptions

endfunction
