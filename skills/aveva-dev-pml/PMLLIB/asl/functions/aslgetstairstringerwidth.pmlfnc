--   Module:        Design
--   Replaces:
-- Author:          Karel Pleschner
-- Created:         Tue Feb 17 17:09:41 GMT 2009
--
--
--  Description:    Get width of stair flight stringer
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--    1   R      DBREF                 Stair flight assembly
--    2   R      STRING                Side of stair flight (L, LM, LI, R, RM or RI )
--
-- Return:
--   [Data Type]          [Description]
--    REAL                 stringer width in current distance units
--
--------------------------------------------------------------------------------------------------------------
define function !!aslGetStairStringerWidth(!tmplref is DBREF,!side is STRING) is REAL

  -- init
  !width = 0
  !stringer = nulref
  !allStringers = ARRAY()

  -- check argument 2
  !whichSide = !side.upcase().trim()
  if !whichSide.eq('L').or(!whichSide.eq('R')).not() then
    return error 1 'ARGUMENT 2 is invalid - must be either "L" or "R"'
  endif

  -- collect stringer(s)
  !allStringers = !!collectAllFor('GENSEC','type of owner eq ''STRSTR''',!tmplref)
  handle ANY
  endhandle

  -- try to get width directly from stringers of assembly
  if !allStringers.size().eq(1) then
    !stringer = !allStringers[1]
  elseif !allStringers.size().gt(1) then
    if !whichSide.eq('L') then
      !stringer = !allStringers[2]
    elseif !whichSide.eq('R') then
      !stringer = !allStringers[1]
    endif
  endif

  if !stringer.set() then
    !bangle = !stringer.bangle
    !para = !stringer.para
    !desp = !stringer.desp
    if !bangle.eq(90 degrees).or(!bangle.eq(-90 degrees)) then
      !width = !para[1]
      handle ANY
        !width = !desp[1]
        handle ANY
        endhandle
      endhandle
    elseif !bangle.eq(0 degrees).or(!bangle.eq(180 degrees)) then
      !width = !para[2]
      handle ANY
        !width = !desp[2]
        handle ANY
        endhandle
      endhandle
    endif
    !width = !!comConvertUnknownValue(!width,'MM')
  endif

  -- return result
  return !width

endfunction
