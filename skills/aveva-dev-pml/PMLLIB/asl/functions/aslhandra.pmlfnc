-- Created:         Tue Nov 02 11:36:48 GMT 2007
--
--
--  Description:    show main handrail form
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      form operation mode (MODIFY,CREATE,DISPLAYONLY)
--    2   R      DBREF       should point to HANDRAIL (in modify mode) or to handrail owner (in create mode). Nulref is
--                           mode is DISPLAYONLY
--
-- Return:
--   [Data Type] [Description]
--    FORM        displayed form
--
--------------------------------------------------------------------------------------------------------------
define function !!aslHandra(!mode is STRING, !ref is DBREF) is FORM

  !form = !!fmSys.loadform('ASLHANDRA')
  if !form.shown() then
    if !form.visiblePane().neq(!form.mainPane) then
      return error 3 'Another HANDRA is already being created or modified!'
    endif
  else
    !form.show('free')
  endif

  -- init
  !handra = nulref
  !handraOwner = nulref

  if !mode.upcase().eq('DISPLAYONLY') then
  -- leave form as it is and exit
    return
  elseif !mode.upcase().eq('MODIFY') then
    !handra = !form.getHandrailAbove(!ref)
    if !handra.unset() then
    -- invalid reference passed - return error
      return error 1 'Not below HANDRA hierarchy.'
    else
      !form.modifyhandrailPane(!handra)
    endif
  elseif !mode.upcase().eq('CREATE') then
    !handraOwner = !form.getHandrailOwnerFrom(!ref)
    if !handraOwner.unset() then
   -- invalid reference passed - return error
      return error 2 'Invalid hierarchy to create HANDRA.'
    else
      !form.handrailOwner = !handraOwner
      !form.createHandrailPane('init')
    endif
  endif

  return !form

endfunction
