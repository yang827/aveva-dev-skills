--   Group:         Access Stairs & Ladders Application
--     Keyword:     ASL
--   Module:        Design
--   Replaces:
-- Author:          Karel Pleschner
-- Created:         Thu Dec 13 15:14:31 GMT 2007
--
--
--  Description:    Update geometry handrails found below passed dbreference.
--                  Align handrail vertices with their sigref (if set) and recalculate all handrail members
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--    1   R      DBREF                 db position from handrails to be collected
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!aslHandrailUpdate(!owner is DBREF)

  -- init
  !modified = ARRAY()
  !skipped = ARRAY()
  !unchanged = ARRAY()

  -- collect handrails from given db position
  !allHandrail = !!collectAllFor('HANDRA','',!owner)
  if !allHandrail.unset() then
    !!alert.message('No HANDRA in hierarchy below')
    return
  endif

  -- main loop
  do !handrail values !allHandrail
    !obj = object ASLHANDRAIL(!handrail)
    handle ANY
      !skipped.append(!handrail)
      skip
    endhandle
    -- change some aspects of object
    !obj.undoable = TRUE
    !obj.autoDraw = FALSE
    !obj.autoUpdateDb = TRUE
    !obj.autoOffset = FALSE
    -- update handrail
    !modvertices = !obj.updateGeometry()
    handle 1
      !unchanged.append(!handrail)
      skip
    elsehandle ANY
      !skipped.append(!handrail)
      skip
    elsehandle NONE
      if !modvertices.boolean() then
        !modified.append(!handrail)
      else
        !unchanged.append(!handrail)
      endif
    endhandle
  enddo

  if !modified.unset() then
    !!alert.message('No HANDRA has been changed')
    return
  endif

endfunction
