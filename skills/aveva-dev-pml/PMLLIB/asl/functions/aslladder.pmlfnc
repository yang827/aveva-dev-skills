--
--  Description:    show main Ladder form
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      form operation mode (MODIFY,CREATE)
--
-- Return:
--   [Data Type] [Description]
--    FORM        displayed form
--
--------------------------------------------------------------------------------------------------------------
define function !!aslLadder(!mode is STRING) is FORM


  !form = !!fmSys.loadform('ASLLADDER')
  if !form.shown() then
    !!alert.message('ASL Ladder form is already displayed')
    return
  endif

  if ( !!aslCentralData.currSetting.unset() ) then
    !!alert.warning('There is no ASL selection.')
    return
  endif
  !subSettings  = !!aslCentralData.currSetting.subSettings
  !purpose      = object ARRAY()
  do !currSubSetting values !subSettings
    !purpose.append(!currSubSetting.purpose)
  enddo
  if ( !purpose.unset() or !purpose.findfirst('LADDER').unset() ) then
    !!alert.warning('There are no ladders in the ASL selection.')
    return
  endif

 !form.show('free')

  if(!mode.upcase() eq 'MODIFY')then
      LADDER
      handle ANY
        !!alert.error('Not below LADDER hierarchy')
        return
      endhandle
     !form.modify()
  else
    !ref    = !!ce
      -- check whether a Ladder could be created
    !flag             = false
    !ownerList        = !!ce.ownLst
    !ownerList.append(!!ce)
    do !i values !ownerList
      if ( !i.list.findFirst('LADDER').set() ) then
        !flag = true
        !!ce = !i
        break
      endif
    enddo
    if(!flag.not())then
      if(!!aslStoreTable.getStore('ladder').unset() or !!aslStoreTable.getStore('ladder').badref())then
        !!alert.error ('Invalid hierarchy to create LADDER.')
        return
      endif
    endif
    -- pass form name to the object
    !form.create()
     !!ce = !ref
  endif

  return !form

endfunction
