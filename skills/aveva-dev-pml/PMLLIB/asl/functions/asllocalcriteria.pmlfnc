--
--
--  Description:    Override passed criteria set with local standards from assembly template
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--    1   R      ANY                   criteria set
--    2   R      STRING                template reference that store the local standard
--
-- Return:
--   [Data Type]          [Description]
--    ANY                  criteria set
--
--------------------------------------------------------------------------------------------------------------
define function !!aslLocalCriteria(!criteria is ANY, !asstmp is DBREF) is ANY

  -- init
  !result = !criteria
  !criteriaList = ARRAY()

  -- no template reference
  if !asstmp.badref() then
    return !result
  endif

  -- get all DDAT from DDSE directly owned by assembly template
  !allDdat = !!collectAllFor('DDAT','owner of DDSE eq $!asstmp ',!asstmp)

  -- no local criteria
  if !allDdat.empty() then
    return !result
  endif

  -- compose list of valid criteria in current context
  !attributes = !criteria.attributes()
  do !attrib values !attributes
    if !criteria.attribute(!attrib).objectType().eq('CRITERION') then
      !criteriaList.append(!attrib)
    endif
  enddo

  -- override standard criteria with the local criteria
  do !ddat values !allDdat
    !desc = !ddat.desc
    skip if !desc.match(!asstmp.type).neq(1)
    !desc = !desc.after(!asstmp.type).trim()
    !index = !criteriaList.findfirst(!desc)
    skip if !index.unset()
    !criteriaName = !criteriaList[!index]
    !local = !result.attribute(!criteriaName)
    !local.criterion(!ddat)
    handle ANY
      skip
    endhandle
    !result.attribute(!criteriaName) = !local
  enddo

  return !result

endfunction
