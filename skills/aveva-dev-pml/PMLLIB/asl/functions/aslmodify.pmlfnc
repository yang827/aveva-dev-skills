--   Replaces:
-- Author:          Karel Pleschner
-- Created:         Wed Apr 2 15:14:00 GMT 2008
--
--
--  Description:    Procedure to recognize the ASL element and display
--                  proper form for modification
--
--
----------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
----------------------------------------------------------------------
define function !!aslModify()

  !level   = !!ce.dbdep - 1
  !hier[1] = !!ce.type

  !owner = !!ce
  do from 1 to !level
    !owner = !owner.owner
    !hier.append(!owner.type)
  enddo

  if !hier.findfirst('HANDRA').set() then
    -- display form for handrails
    !!aslHandra('modify',HANDRA)
  elseif !hier.findfirst('PLTFRM').set() then
    -- display form for platforms
    !!aslPltfrm('modify',PLTFRM)
  elseif !hier.findfirst('STRFLT').set() then
    -- display form for stair flights
    !!aslStrflt('modify',STRFLT)
  elseif !hier.findfirst('LADDER').set() then
    !!aslLadder('Modify')
  elseif !hier.findfirst('STRTWR').set() then
    -- display form for stair towers
    !!aslStrTwr('modify',STRTWR)
  else
    -- display error message
    !!alert.warning('Navigate to appropriate ASL Hierarchy!')
  endif

endfunction
