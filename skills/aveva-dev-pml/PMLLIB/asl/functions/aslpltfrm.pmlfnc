--
--
--  Description:    show main platform form
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      form operation mode (MODIFY,CREATE,DISPLAYONLY)
--    2   R      DBREF       should point to PLTFRM (or below) in modify mode, otherwise it can be nulref
--
-- Return:
--   [Data Type] [Description]
--    FORM        displayed form
--
--------------------------------------------------------------------------------------------------------------
define function !!aslPltfrm(!mode is STRING, !ref is DBREF) is FORM

  !form = !!fmSys.loadform('ASLPLTFRM')
  if !form.shown() then
    if !form.mainTaskPane.visible.not() then
      return error 3 'Another PLATFORM is already being created or modified!'
    endif
  else
    !form.show('free')
  endif

  if !mode.upcase().eq('DISPLAYONLY') then
  -- leave form as it is
  elseif !mode.upcase().eq('MODIFY') then
    !pltFrm = !!dtbGetOwnerType(!ref,'PLTFRM')
    if !pltFrm.unset() then
    -- invalid reference passed - return error
      return error 1 'Not below PLTFRM hierarchy.'
    else
      !form.pltFrmModify(!pltFrm)
    endif
  elseif !mode.upcase().eq('CREATE') then
    !form.pltFrmCreate()
  endif

  return !form

endfunction
