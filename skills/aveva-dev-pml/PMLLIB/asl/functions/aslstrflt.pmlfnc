--
--
--  Description:    Stair flight form definition
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      form operation mode (MODIFY,CREATE,DISPLAYONLY)
--    2   R      DBREF       should point to STRFLT (in modify mode) or to stair flight owner (in create mode). Nulref is
--                           mode is DISPLAYONLY
--
-- Return:
--   [Data Type] [Description]
--    FORM        displayed form
--
--------------------------------------------------------------------------------------------------------------
define function !!aslStrflt(!mode is STRING, !ref is DBREF) is FORM

  !form = !!fmSys.loadform('ASLSTRFLT')

  -- initialise variables
  !strflt       = nulref

  if !mode.upcase().eq('DISPLAYONLY') then
    -- leave form as it is and exit
    return

  elseif !mode.upcase().eq('MODIFY') then

    !strflt = !form.getStrfltAbove(!ref)

    if !strflt.unset() then
      -- invalid reference passed - return error
      return error 1 'Not below STRFLT hierarchy.'
    else
      if !form.shown().not() then
        !form.show('free')
      endif
      !form.modifyStrfltPane(!strflt)
    endif

  elseif !mode.upcase().eq('CREATE') then

    if !form.shown().not() then
      !form.show('free')
    endif

    !form.createStrfltPane('init')

  endif

  return !form

endfunction
