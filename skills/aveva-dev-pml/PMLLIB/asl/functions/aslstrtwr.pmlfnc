--
--
--  Description:   show main form for Stair Tower
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      form operation mode (MODIFY,CREATE,DISPLAYONLY)
--    2   R      DBREF       should point to STRTWR (in modify mode) or to stair Tower owner (in create mode). Nulref is
--                           mode is DISPLAYONLY
--
-- Return:
--   [Data Type] [Description]
--    FORM        displayed form
--
--------------------------------------------------------------------------------------------------------------
define function !!aslStrTwr(!mode is STRING, !ref is DBREF) is FORM

  if ( !!aslCentralData.currSetting.description.unset() ) then
    !!alert.error('No Settings available to Create STAIR TOWER...')
    return
  endif

  !form = !!fmSys.loadform('ASLSTRTWR')

  -- initialise
  !strTwr       = nulref
  !strTwrOwner  = nulref

  if !mode.upcase().eq('DISPLAYONLY') then
    -- leave form as it is and exit
    return

  elseif !mode.upcase().eq('MODIFY') then
    !strTwr = !form.getStrTwrAbove(!ref)
    if !strTwr.unset() then
    -- invalid reference passed - return error
      !!alert.warning('Navigate to Stair Tower Hierarchy.')
    else
      !strLngTemplate = !!aslCentralData.getTemplates('STRLNG')
      !handraTemplate = !!aslCentralData.getTemplates('HANDRA')
      !strFltTemplate = !!aslCentralData.getTemplates('STRFLT')
      if ( !strLngTemplate.unset() ) then
        !!alert.warning(|No STAIR LANDING template available in '$!!aslCentralData.currSetting.description', Contact your ASL Administrator.|)
        return
      elseif ( !handraTemplate.unset() ) then
        !!alert.warning(|No HANDRAIL template available in '$!!aslCentralData.currSetting.description', Contact your ASL Administrator.|)
        return
      elseif ( !strFltTemplate.unset() ) then
        !!alert.warning(|No STAIR FLIGHT template available in '$!!aslCentralData.currSetting.description', Contact your ASL Administrator.|)
        return
      endif
      --show the form
      if ( !form.shown().not() ) then
        !form.show('free')
      endif
      !form.modifyStrTwr(!strTwr)
    endif

  elseif !mode.upcase().eq('CREATE') then
    !strTwrOwner = !form.getStrTwrOwner(!ref)
    if !strTwrOwner.unset() then
   -- invalid reference passed - return error
      !form.hide()
      !!alert.error('Unable to create STAIR TOWER. Cannot create a STRTWR at this level.')
    else
      !strLngTemplate = !!aslCentralData.getTemplates('STRLNG')
      !handraTemplate = !!aslCentralData.getTemplates('HANDRA')
      !strFltTemplate = !!aslCentralData.getTemplates('STRFLT')
      if ( !strLngTemplate.unset() ) then
        !!alert.warning(|No STAIR LANDING template available in '$!!aslCentralData.currSetting.description', Contact your ASL Administrator.|)
        return
      elseif ( !handraTemplate.unset() ) then
        !!alert.warning(|No HANDRAIL template available in '$!!aslCentralData.currSetting.description', Contact your ASL Administrator.|)
        return
      elseif ( !strFltTemplate.unset() ) then
        !!alert.warning(|No STAIR FLIGHT template available in '$!!aslCentralData.currSetting.description', Contact your ASL Administrator.|)
        return
      endif
      --show the form
      if ( !form.shown().not() ) then
        !form.show('free')
      endif
      !form.createStrTwr()
    endif
  endif

  return !form

endfunction
