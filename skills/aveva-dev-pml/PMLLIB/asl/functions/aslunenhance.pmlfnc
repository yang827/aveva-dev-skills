--
--
--  Description:    unenhance the element with the given reference
--
----------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference of the element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define function !!aslUnEnhance(!refe is DBREF)

  if ( !refe.set()  and $
       !refe.badRef().not() ) then
    var !allElem collect all for $!refe
    UNENHANCE ALL FROM !allElem
  endif

endfunction
