------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()

  frame .aslToolbar toolbar 'ASL Toolbar'
    option .opASLSettings tooltip 'Select ASL-Setting' callback '!!aslCentralData.setCurrentSetting()' width 20

    !iconSize = !!comSysOpt.iconSize()

    !icon     = !!pml.getPathName('aslnewstrtwr16.png')
    button .creStairTower tooltip 'Create Stair Tower'  pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!aslStrTwr('Create',!!ce)|

    !icon     = !!pml.getPathName('aslnewstair16.png')
    button .creStairFlight tooltip 'Create Stair Flight' pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!aslStrFlt('create',!!ce)|

    !icon     = !!pml.getPathName('aslnewladder16.png')
    button .creLadder tooltip 'Create Ladder'        pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!aslLadder('Create')|

    !icon     = !!pml.getPathName('aslnewpltfrm16.png')
    button .crePlatform tooltip 'Create Platform'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!aslPltfrm('create',!!ce)|

    !icon     = !!pml.getPathName('aslnewhandra16.png')
    button .creHandrail tooltip 'Create Handrail'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!aslhandra('create',!!ce)|

    !icon     = !!pml.getPathName('aslmodifystrtwr16.png')
    button .modStairTower tooltip 'Modify Stair Tower'  pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!aslStrTwr('Modify',!!ce)|

    !icon     = !!pml.getPathName('aslmodifystair16.png')
    button .modStairFlight tooltip 'Modify Stair Flight' pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!aslStrFlt('modify',!!ce)|

    !icon     = !!pml.getPathName('aslmodifyladder16.png')
    button .modLadder tooltip 'Modify Ladder'        pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!aslLadder('Modify')|

    !icon     = !!pml.getPathName('aslmodifypltfrm16.png')
    button .modPlatform tooltip 'Modify Platform'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!aslPltfrm('Modify',!!ce)|

    !icon     = !!pml.getPathName('aslmodifyhandra16.png')
    button .modHandrail tooltip 'Modify Handrail'     pixmap "$!<icon>" width $!<iconSize> height $!<iconSize> callback |!!aslhandra('Modify',!!ce)|

  exit
  !!appTbarCntrl.addToolbar('aslToolbar', 'ASL')

endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()

  !menu = object APPMENU('ASLSETTINGS')
  !menu.add('TOGGLE', 'Auto Limits for Stair Tower', '!!aslCentralData.autoLimits(', 'aslAutoLimits')
  !!appMenuCntrl.addmenu(!menu, 'ASL')

endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()

  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()

endmethod
-- End of method definition for .modifyMenus()
