------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .settingsMenu()

  !menu = object APPMENU('sysSet')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'ASL Storage Area...',         'ASLSTORAGEAREA',         'aslStorageArea')
  !menu.add('FORM', 'ASL Standards...',            'ASLSTANDARDS',           'aslStandards')
  !menu.add('FORM', 'ASL Settings...',           'ASLSETTINGS',          'aslSetting')
  !menu.add('MENU', 'ASL Settings',                'ASLSETTINGS',            'aslSettings')
  !!appMenuCntrl.addmenu(!menu, 'ASL')

endmethod
-- End of method definition for .settingsMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()

  !menu = object APPMENU('sysUtil')
  !!appMenuCntrl.addmenu(!menu, 'ASL')

endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()

  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Structure...|, |CALLG XCRTPURP STRU $$<Create Structure$$>|, 'Structure')
  !menu.insertAfter('Structure', 'CALLBACK', |Framework...|, |CALLG XCRTPURP FRMW $$<Create Framework$$>|, 'Framework')
  !menu.insertAfter('Framework', 'CALLBACK', |Sub-Frame...|, |CALLG XCRTPURP SBFR $$<Create Sub-Frame$$>|, 'SubFrame')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK','Stair Tower...', |!!aslStrTwr('Create',!!ce)|,'Strtwr')
  !menu.add('CALLBACK','Stair Flight...',|!!aslStrFlt('create',!!ce)|, 'Strflt')
  !menu.add('CALLBACK','Ladder...',|!!aslLadder('Create')|,'Ladder')
  !menu.add('CALLBACK','Platform...',|!!aslPltfrm('create',!!ce)|,'Pltfrm')
  !menu.add('CALLBACK','Handrail...',|!!aslhandra('create',!!ce)|,'Handra')

  !!appMenuCntrl.addmenu(!menu, 'ASL')

endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()

  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK','Stair Tower...', |!!aslStrTwr('Modify',!!ce)|,'Strtwr')
  !menu.add('CALLBACK','Stair Flight...',|!!aslStrFlt('modify',!!ce)|, 'Strflt')
  !menu.add('CALLBACK','Ladder...',|!!aslLadder('Modify')|,'Ladder')
  !menu.add('CALLBACK','Platform...',|!!aslPltfrm('Modify',!!ce)|,'Pltfrm')
  !menu.add('CALLBACK','Handrail...',|!!aslhandra('Modify',!!ce)|,'Handra')

  !menu.add('FORM', 'Material...', 'CDSETMATR', 'Material')
  !!appMenuCntrl.addmenu(!menu, 'ASL')

endmethod
-- End of method definition for .modifyMenu()

------------------------------------------------------------------------
