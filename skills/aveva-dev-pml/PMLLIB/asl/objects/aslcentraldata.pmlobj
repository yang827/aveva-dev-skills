--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addAidNumbers()                  -                   requests and claims numbers for aid elements
--  aslCentralData()                 -                   default constructor
--  autoLimits(MENU,STRING)          -                   sets the flag whether an autolimits is to be carried out
--  clearDimFeedback()               -                   clears dimension feedback from graphics
--  clearFeedback(STRING)            -                   clears feedback from graphics
--  clearVolFeedback()               -                   clears volume aid line feedback from graphics
--  getCriteriaSet(STRING,STRING)    ANY                 gets the required criteria set for the given setting
--  getData(STRING,STRING)           STRING              evaluate the value for given attribute name
--  getProjDfltsFile()               FILE                gets the project defaults file
--  getSetting(STRING)               SETTING             gets the required criteria set for the given setting
--  getSettingType(STRING)           STRING              gets the type of setting
--  getTemplates(STRING)             ARRAY               get list of available templates for the element type passed
--  getTemplates(STRING,STRING)      ARRAY               get list of templates of passed type stored within passed settings
--  readAslSettings()                -                   reads the settings
--  readSettings()                   -                   reads the settings
--  readStandards()                  -                   read the standards from xml files
--  readStandardsFromDB(ARRAY)       ARRAY               read the standards from  db
--  readStandardsFromFile(FILE,STRING) -                   read the standards from  xml files
--  readUserSetting()                -                   reads the user setting from the xml file
--  removeAidNumbers()               -                   un claims requested numbers of aid elements
--  setAppDesMainSettings(ARRAY)     -                   reads the settings
--  setColours()                     -                   sets the colours
--  setCurrentSetting()              -                   find the current setting and set it
--  setLineStyle()                   -                   sets the line style
--  setStandards()                   -                   sets the standard and the subStandard of the setting
--  setUserSetting(STRING)           -                   sets the setting
--  updateSettings()                 -
--  writeCriteriaSetToDB(ANY)        -                   writes the criteria set to the xml file
--  writeDfltSettings(STRING)        -                   writes the default settings
--  writeProjectSettings(STRING)     -                   writes the project settings
--  writeSettings()                  -                   writes the settings
--  writeSettings(BOOLEAN)           -                   writes the settings
--  writeSettings(STRING)            -                   writes the settings
--  writeStandards()                 -                   writes the standards
--  writeStandardsToDB()             -                   writes the standards into the db
--  writeStandardsToFile()           -                   writes the standards to the xml file
--  writeSubStandardsToDB(ASLSUBSTANDARD) -                   writes the sub standards to the xml file
--  writeUserSetting(GADGET,STRING)  -                   writes the user sub standard from the xml file
--  writeUserSettings(STRING)        -                   writes the user settings
--


-- Define object
define object ASLCENTRALDATA

  -- is the user ASLADMIN
  member .administrator           is BOOLEAN

  -- aid number for dimension
  ---------------------------------------------------------------------------
  member .aidDim                  is REAL

  -- aid numbers for volume
  ---------------------------------------------------------------------------
  member .aidVolArrow             is REAL
  member .aidVolCL                is REAL
  member .aidVolEnvelope          is REAL
  member .aidVolMain              is REAL
  member .aidVolWorkingPoint      is REAL
  member .aidVolPlanes            is REAL
  member .aidVolLineColumn        is REAL
  member .aidVolLineBeam          is REAL
  member .aidVolLineFfl           is REAL
  member .aidVolHandra            is REAL
  member .aidVolStrflt            is REAL
  member .aidVolStrTwr            is REAL
  member .aidVolMainStrTwr        is REAL
  member .aidVolDatum             is REAL

  -- aid colour
  ---------------------------------------------------------------------------
  member .colourAid               is REAL
  member .colourCL                is REAL
  member .colourEnvelope          is REAL
  member .colourMain              is REAL
  member .colourSteelColumn       is REAL
  member .colourSteelBeam         is REAL
  member .colourFflAid            is REAL
  member .colourHandra            is REAL
  member .colourStrflt            is REAL
  member .colourStrTwr            is REAL

  -- aid line style
  ---------------------------------------------------------------------------
  member .lineStyleSolidThick     is REAL
  member .lineStyleSolidThin      is REAL
  member .lineStyleDashedThick    is REAL
  member .lineStyleDashedThin     is REAL
  member .lineStyleDotDashedThick is REAL
  member .lineStyleDotDashedThin  is REAL
  member .lineStyleStrTwr         is REAL
  member .lineStyleStrTwrDatum    is REAL

  -- flag whether a preview is to be done or not
  member .autoBuild               is BOOLEAN

  -- flag whether an autolimits should be carried out when creating the stair towers
  member .autoLimits              is BOOLEAN

  -- the selection of asl elements like "Boiler"
  member .currSetting             is SETTING

  -- project standard (defined by the administrator)
  member .standards               is ARRAY
  member .currStandard            is ASLSTANDARD
  member .currSubStandard         is ASLSUBSTANDARD

  -- all possible selections of asl elements
  member .settings                is ARRAY
  member .projectSettings         is ARRAY
  member .userSettings            is ARRAY
  member .modified                is BOOLEAN

  -- Undoable or not?
  member .undoable                is BOOLEAN

endobject
-- End of object definition for aslCentralData

------------------------------------------------------------------------
--
-- Method:      aslCentralData
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslCentralData()

  --initialise
  !this.undoable = false

  !!appDesMain.aslsettings.setfieldproperty('ASLAUTOLIMITS', 'SELECTED', true)
  !this.autoLimits = true

  -- ASL admin or not
  !this.administrator = false
  !currentSession     = CURRENT SESSION
  do !team value !currentSession.user().teamList()
    if ( !team.name.eq('ASLADMIN') ) then
      !this.administrator = true
      break
    endif
  enddo

  -- evaluates the aid numbers
  !this.addAidNumbers()

  -- defines the colours
  !this.setColours()

  -- defines the line styles
  !this.setLineStyle()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addAidNumbers
--
-- Description: requests and claims numbers for aid elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .addAidNumbers()

  -- Check the aid data is loaded
  if( undefined(!!aidNumbers) ) then
    !!aidNumbers = object AIDNUMBERS()
  endif

  -- aid numbers for dimension
  ---------------------------------------------------------------------------
  !this.aidDim             = !!aidNumbers.add('ASL dimension')

  -- aid numbers for volume
  ---------------------------------------------------------------------------
  !this.aidVolArrow        = !!aidNumbers.add('ASL Volume Arrow')
  !this.aidVolCL           = !!aidNumbers.add('ASL Volume Centre')
  !this.aidVolEnvelope     = !!aidNumbers.add('ASL Volume Envelope')
  !this.aidVolMain         = !!aidNumbers.add('ASL Volume Body')
  !this.aidVolWorkingPoint = !!aidNumbers.add('ASL Volume WorkingPoint')
  !this.aidVolPlanes       = !!aidNumbers.add('ASL Volume Planes')
  !this.aidVolLineColumn   = !!aidNumbers.add('ASL Column Profile')
  !this.aidVolLineBeam     = !!aidNumbers.add('ASL Beam Profile')
  !this.aidVolLineFfl      = !!aidNumbers.add('ASL FFL Profile')
  !this.aidVolHandra       = !!aidNumbers.add('ASL Handrail Profile')
  !this.aidVolStrflt       = !!aidNumbers.add('ASL Stair Flight Profile')
  !this.aidVolStrTwr       = !!aidNumbers.add('ASL Stair Tower Envelope')
  !this.aidVolMainStrTwr   = !!aidNumbers.add('ASL Stair Tower Text')
  !this.aidVolDatum        = !!aidNumbers.add('ASL Stair Tower Datum')

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      autoLimits
--
-- Description: sets the flag whether an autolimits is to be carried out
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        the calling menu
--    2   R      STRING      the action
-- Return:
--   [Data Type] [Description]
--    STRING      value of the attribute
------------------------------------------------------------------------

define method .autoLimits(!dummymenu is MENU, !action is STRING)

  !this.autoLimits = !action.eq('SELECT')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clearFeedback
--
-- Description: clears feedback from graphics
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      filter
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .clearFeedback(!filter is STRING)

  -- handles all aid attributes
  do !attributeName value !this.attributes()
    --ignores none aid attributes
    skip if ( !attributeName.matchwild(!filter & '*').not() )

    -- evaluates the aid number
    !aidNumber = !this.attribute(!attributeName)
    AID CLEAR ALL $!<aidNumber>
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clearDimFeedback
--
-- Description: clears dimension feedback from graphics
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .clearDimFeedback()

  !this.clearFeedback('AIDDIM')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clearVolFeedback
--
-- Description: clears volume aid line feedback from graphics
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .clearVolFeedback()

  !this.clearFeedback('AIDVOL')

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      getCriteriaSet
--
-- Description: gets the required criteria set for the given setting
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      name of setting
--    2   R      STRING      name of set of criteria
-- Return:
--   [Data Type] [Description]
--    CRITERIASET set of criteria
------------------------------------------------------------------------

define method .getCriteriaSet(!settingName is STRING, !criteriaSetName is STRING) is ANY

  -- find out the used standard
  !setting         = !this.getSetting(!settingName)
  !standardName    = !setting.settingData[1].value
  !subStandardName = !setting.settingData[2].value

  -- get the used standard
  do !standard value !this.standards
    skip if ( !standard.name.neq(!standardName) )

    do !subStandard value !standard.subStandards
      skip if ( !subStandard.name.neq(!subStandardName) )

      !criteriaSet = !subStandard.attribute(!criteriaSetName)
      break
    enddo
    break
  enddo

  return !criteriaSet

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getData
--
-- Description:  evaluate the value for given attribute name
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      line for xml file
--    2   R      STRING      name of the attribute
-- Return:
--   [Data Type] [Description]
--    STRING      value of the attribute
------------------------------------------------------------------------

define method .getData(!line is STRING, !attributeName is STRING) is STRING

  -- define the search pattern
  !afterPattern     = ' ' & !attributeName & '="'
  !matchwildPattern = '*' & !afterPattern & '*"*'

  -- returns the value of the attribute
  if ( !line.matchwild(!matchwildPattern)) then
    return !line.after(!afterPattern).before('"').trim()
  else
    return ''
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getProjDfltsFile
--
-- Description: gets the project defaults file
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    FILE        project defaults file
------------------------------------------------------------------------

define method .getProjDfltsFile() is FILE

  -- defines the name of file with standard data
  !fileName      = 'aslstandards.xml'

  !currProj      = CURRENT PROJECT
  !projDfltsName = !currProj.code() & 'DFLTS'
  !file          = object FILE('%' & !projDfltsName & '%/' & !fileName)

  return !file

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSetting
--
-- Description: gets the required criteria set for the given setting
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    FILE        project defaults file
------------------------------------------------------------------------

define method .getSetting(!settingName is STRING) is SETTING

  !currSetting = object SETTING()

  -- find out the used standard
  do !setting value !this.userSettings
    if ( !setting.description.eq(!settingName) ) then
    !currSetting = !setting
      return !currSetting
    endif
  enddo

  do !setting value !this.projectSettings
    if ( !setting.description.eq(!settingName) ) then
      !currSetting = !setting
      return !currSetting
    endif
  enddo

  do !setting value !this.settings
    if ( !setting.description.eq(!settingName) ) then
      !currSetting = !setting
      return !currSetting
    endif
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      readSettings
--
-- Description: reads the settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .readSettings()

  -- initialise
  !this.settings = object ARRAY()
  !this.userSettings = object ARRAY()
  !this.projectSettings = object ARRAY()
  !settingColl = object ARRAY()

  -- get the user dflts
  !fileName = '%PDMSUSER%' & '/aslsettings.xml'
  !settingFiles = object ARRAY()
  !settingFiles.append(object FILE(!fileName))
  !settingFiles.append('USER')
  !settingColl.append(!settingFiles)

  -- get the current project dflts
  !currProj = CURRENT PROJECT
  !fileName = '%' & !currProj.code() & 'DFLTS%/aslsettings.xml'
  !settingFiles = object ARRAY()
  !settingFiles.append(object FILE(!fileName))
  !settingFiles.append('PROJECT')
  !settingColl.append(!settingFiles)

  -- get the aveva dflts
  !fileName = '%PDMSDFLTS%' & '/aslsettings.xml'
  !settingFiles = object ARRAY()
  !settingFiles.append(object FILE(!fileName))
  !settingFiles.append('DFLTS')
  !settingColl.append(!settingFiles)

  -- loop through the different settings locations
  do !i from 1 to !settingColl.size()

    !file = !settingColl[!i][1]
    -- reads the values from the standard file if it exists
    if ( !file.exists() ) then

      -- reads the file
      !fileCont = !file.readFile()
      -- initialise
      !subSettingMarker = false

      -- adds line to data blocks
      do !line value !fileCont
        -- setting
        if ( !line.matchwild('*<setting *') ) then
          !setting             = object SETTING()
          !setting.description = !this.getData(!line, 'description')
          !setting.purpose     = !this.getData(!line, 'purpose')
          !setting.type        = !this.getData(!line, 'type')
        -- footer for setting
        elseif ( !line.matchwild('*</setting>*') ) then
            if !settingColl[!i][2].eq('USER') then
              !this.userSettings.append(!setting)
            elseif !settingColl[!i][2].eq('PROJECT') then
              !this.projectSettings.append(!setting)
            elseif !settingColl[!i][2].eq('DFLTS') then
              !this.settings.append(!setting)
            endif

        -- sub setting
        elseif ( !line.matchwild('*<subsetting *') ) then
          -- the next value data sets are member of the sub setting
          !subSettingMarker   = true
          !subSetting         = object SUBSETTING()
          !subSetting.purpose = !this.getData(!line, 'purpose')

        -- footer for sub setting
        elseif ( !line.matchwild('*</subsetting>*') ) then
          -- the next value data sets are member of the setting
          !subSettingMarker = false
          !setting.subSettings.append(!subSetting)

        -- values
        elseif ( !line.matchwild('*<value *') ) then
          !settingData         = object SETTINGDATA()
          !settingData.purpose = !this.getData(!line, 'purpose')
          !settingData.value   = !this.getData(!line, 'val')

          -- controls the target of the value data
          if ( !subSettingMarker ) then
            !subSetting.settingData.append(!settingData)
          else
            !setting.settingData.append(!settingData)

          endif
        endif
      enddo
    endif
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      readStandards
--
-- Description: read the standards from xml files
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .readStandards()

--TODO: activates the read from DB method
  --collects all ddat elements
  -- First collect the ASL application data world
  !find = object COLLECTION()
  !find.type('APPLDW')
  !find.filter(object EXPRESSION('PURP EQ |ASL|'))
  !results = !find.results()
  if (!results.empty()) then
    !ddatRefes = ARRAY()
  else
    !collection = object COLLECTION()
    !expression = object EXPRESSION('PURPOSE OF OWNER EQ |ASL|')
    !collection.filter(!expression)
    !collection.scope(!results)
    !collection.type('DDAT')
    !ddatRefes = !collection.results()
  endif

  !this.standards = !this.readStandardsFromDB(!ddatRefes)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      readStandardsFromDB
--
-- Description: read the standards from  db
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .readStandardsFromDB(!ddatRefes is ARRAY) is ARRAY

  --initialise
  !standards      = object ARRAY()
  !standardIdx    = 0
  !subStandardIdx = 0

  --handles all criteria sets
  do !dDatRefe value !ddatRefes

    --standard
    if (  !standards.empty() or !standards.last().refe.neq(!dDatRefe.owner.owner.owner) ) then
      --creates new standard element and increase and resets the different counters
      !standards.append(object ASLSTANDARD())
      !standardIdx    = !standardIdx + 1
      !subStandardIdx = 0

      --assign the main attributes
      !standards[!standardIdx].refe         = !dDatRefe.owner.owner.owner
      !standards[!standardIdx].name         = !dDatRefe.owner.owner.owner.namn
      !standards[!standardIdx].description  = !dDatRefe.owner.owner.owner.description
    endif

    --reduces the size of the expression
    !standard = !standards[!standardIdx]

    --subStandard
    if (  !standard.subStandards.empty() or !standard.subStandards.last().refe.neq(!dDatRefe.owner.owner) ) then
      --creates new standard element and increase the counter
      !standard.subStandards.append(object ASLSUBSTANDARD())
      !subStandardIdx = !subStandardIdx + 1

      --assign the main attributes
      !standard.subStandards[!subStandardIdx].refe        = !dDatRefe.owner.owner
        handle ANY
          -- no privileges to delete
          skip
        endhandle
      !standard.subStandards[!subStandardIdx].name        = !dDatRefe.owner.owner.namn
      !standard.subStandards[!subStandardIdx].description = !dDatRefe.owner.owner.description
    endif

    --reduces the size of the expression
    !subStandard = !standard.subStandards[!subStandardIdx]

    --gets the name of the criteria set and the name of the criterion
    !criteriaSetName = 'ASL' & !dDatRefe.description.split().first() & 'CRITERIA'
      handle ANY
        -- no privileges to delete
        skip
      endhandle
    !criterionName   = !dDatRefe.description.split().last()

    --on the road to the criterion
    if ( DEFINED(!criteriaSet)) then
      !criteriaSet.delete()
    endif

    !criteriaSet = !subStandard.attribute(!criteriaSetName)
    !criterion   = !criteriaSet.attribute(!criterionName)
    handle ANY
      -- no privileges to delete
      skip
    endhandle

    --reads the attributes
    if ( DEFINED(!dDatRefe.maxMin[1]) and $
         !dDatRefe.maxMin[1].neq(0) ) then
      !criterion.min        = !dDatRefe.maxMin[1]
    endif

    if ( DEFINED(!dDatRefe.maxMin[2]) and $
         !dDatRefe.maxMin[2].neq(1000000) ) then
      !criterion.max        = !dDatRefe.maxMin[2]
    endif

    if ( !dDatRefe.dDDfault.set() ) then
      !criterion.optimum    = !dDatRefe.dDDfault.replace('(', '').replace(')', '').real()
    endif

--TODO: reads tolerance from db (SB There is a new attribute PTOLER on a data/ddat element)
    if ( !dDatRefe.ptoler.set() ) then
      !criterion.tolerance  = !dDatRefe.ptoler
    endif

    if ( !dDatRefe.dDProperty.set() ) then
      !criterion.value[1]      = !dDatRefe.dDProperty.real()
      handle ANY
        !criterion.value[1]      = !dDatRefe.dDProperty.string()
      endhandle
    endif

    !criterion.imperialUnits = !dDatRefe.ownls[!dDatRefe.ahlis.findFirst('APPLDW')].function.upcase().trim().eq('IMPERIAL')
    handle ANY
    endhandle

    !criterion.validValues = object ARRAY()

    -- collect vvalue
    !collection  = object COLLECTION()
    !collection.scope(!dDatRefe)
    !collection.type('VVALUE')
    !vvalueRefes = !collection.results()

    do !vvalue value !vvalueRefes
      !criterion.validValues.append(!vvalue.validValue.replace('(', '').replace(')', '').real())
    enddo

    --reduces the size of the expression
    !criteriaSet.attribute(!criterionName)   = !criterion
    !subStandard.attribute(!criteriaSetName) = !criteriaSet
    !standard.subStandards[!subStandardIdx]  = !subStandard
    !standards[!standardIdx]                 = !standard
  enddo

  return !standards

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      readStandardsFromFile
--
-- Description: read the standards from  xml files
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        default file
--    2   R      STRING      origin of the file (PDMSDFLTS or PROJDFLTS)
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .readStandardsFromFile(!file is FILE, !originKey is STRING)

  -- reads the values from the standard file if it exists
  if ( !file.exists() ) then

    -- reads the file
    !fileCont = !file.readFile()

    -- adds line to data blocks
    do !line value !fileCont

      -- standards
      if ( !line.lowCase().matchwild('*<standard *') ) then
        !standard             = object ASLSTANDARD()
        !standard.name        = !this.getData(!line, 'namn')
        !standard.description = !this.getData(!line, 'description')
        !standard.originKey   = !originKey


      elseif ( !line.lowCase().matchwild('*</standard>*') ) then
        !this.standards.append(!standard)

      -- sub standards
      elseif ( !line.lowCase().matchwild('*<subStandard *') ) then
        !subStandard              = object ASLSUBSTANDARD()
        !subStandard.name         = !this.getData(!line, 'namn')
        !subStandard.description  = !this.getData(!line, 'description')

      elseif ( !line.lowCase().matchwild('*</subStandard>*') ) then
        !standard.subStandards.append(!subStandard)

      -- sub standards
      elseif ( !line.lowCase().matchwild('*<criteriaset *') ) then
        !objectType  = !this.getData(!line, 'purpose')
        if ( DEFINED(!criteriaSet) ) then
          !criteriaSet.delete()
        endif
        !criteriaSet = object $!<OBJECTTYPE>()

      elseif ( !line.lowCase().matchwild('*</criteriaset>*') ) then
        !subStandard.attribute(!OBJECTTYPE) = !criteriaSet
        handle ANY
        endhandle

      -- criterions
      elseif ( !line.lowCase().matchwild('*<criterion *') ) then
        !criterionName = !this.getData(!line, 'purpose')
        !criterion     = object CRITERION()

      elseif ( !line.lowCase().matchwild('*</criterion>*') ) then
        skip if ( !criteriaSet.attributes().findFirst(!criterionName).set().not() )
        !criterion.description = !criteriaSet.attribute(!criterionName).description
        !criteriaSet.attribute(!criterionName) = !criterion
        handle ANY
        endhandle

      -- values
      elseif ( !line.lowCase().matchwild('*<value *') ) then
        !attributeName = !this.getData(!line, 'purpose')
        !attributeVal  = !this.getData(!line, 'val')
        !attributeType = !criterion.attribute(!attributeName).OBJECTTYPE()
        handle ANY
        endhandle

        -- handles the different possible data types
        if ( !attributeType.eq('ARRAY') ) then
          -- converts the string array into a real array
          !values = object ARRAY()
          do !value value !attributeVal.split(';')
            !values.append(!value.real())
          enddo
          !criterion.attribute(!attributeName) = !values.sort()
        elseif ( !attributeType.eq('BLOCK') ) then
          !criterion.attribute(!attributeName) = object BLOCK(!attributeVal)
        elseif ( !attributeType.eq('BOOLEAN') ) then
          !criterion.attribute(!attributeName) = !attributeVal.boolean()
        elseif ( !attributeType.eq('REAL') ) then
          !criterion.attribute(!attributeName) = !attributeVal.real()
        elseif ( !attributeType.eq('STRING') ) then
          !criterion.attribute(!attributeName) = !attributeVal
        endif
      endif
    enddo
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      readUserSetting
--
-- Description: reads the user setting from the xml file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .readUserSetting()

  -- initialise
  !this.currSetting = object SETTING()

  -- gets the file object
  !fileName = object ARRAY()
  !fileName.append('%PDMSUSER%/aslsettings.xml')

  !currProj = CURRENT PROJECT
  !fileName.append('%' & !currProj.code() & 'DFLTS%/aslsettings.xml')

  !fileName.append('%PDMSDFLTS%' & '/aslsettings.xml')

  do !fileRead values !fileName
    !description = ''
    !file = object FILE(!fileRead)
      -- checks if the file asl setting file exists
    if ( !file.exists() ) then
      -- reads the file and evaluates the name of the user selected settings
      !fileCont = !file.readFile()

      do !line value !fileCont
        if ( !line.matchwild('*<setting *') ) then
          !description = !this.getData(!line, 'description')
            break
        endif
      enddo
    endif
      break if (!description.trim().neq(''))
  enddo

  if (!description.trim().neq('')) then
    -- make the stored setting element to the setting
    !this.setUserSetting(!description)
    handle ANY
    endhandle

    -- updates the standard elements
    !this.setStandards()
    handle ANY
    endhandle
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeAidNumbers
--
-- Description: un claims requested numbers of aid elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .removeAidNumbers()

  -- handles all aid attributes
  do !attributeName value !this.attributes()
    --ignores none aid attributes
    skip if ( !attributeName.matchwild('AID*').not() )

    -- evaluates the aid number
    !aidNumber = !this.attribute(!attributeName)

    -- unclaim the aid number
    !!aidNumbers.remove(!aidNumber)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setColours
--
-- Description: sets the colours
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]

-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setColours()

  !this.colourAid         = 11
  !this.colourCL          =  5
  !this.colourEnvelope    =  4
  !this.colourMain        =  2
  !this.colourSteelColumn =  6
  !this.colourSteelBeam   =  8
  !this.colourFflAid      = 28
  !this.colourHandra      =  3
  !this.colourStrflt      = 13
  !this.colourStrTwr      =  5

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLineStyle
--
-- Description: sets the line style
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]

-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLineStyle()

  !this.lineStyleSolidThick     = 1
  !this.lineStyleSolidThin      = 1
  !this.lineStyleDashedThick    = 2
  !this.lineStyleDashedThin     = 2
  !this.lineStyleDotDashedThick = 4
  !this.lineStyleDotDashedThin  = 4
  !this.lineStyleStrTwr         = 1
  !this.lineStyleStrTwrDatum    = 1

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setStandards
--
-- Description: sets the standard and the subStandard of the setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setStandards()

  -- evaluates the name of standard and the name of subStandard of the setting
  !standardName    = ''
  !subStandardName = ''
  do !settingData value !this.currSetting.settingData
    -- standard
    if ( !settingData.purpose.eq('STANDARD') ) then
      !standardName    = !settingData.value

    -- sub standard
    elseif ( !settingData.purpose.eq('SUBSTANDARD')  ) then
      !subStandardName = !settingData.value
    endif
  enddo

  -- sets the standard and subStandard
  do !standard value !this.standards
    if ( !standard.name.eq(!standardName) ) then
      !this.currStandard = !standard

      do !subStandard value !this.currStandard.subStandards
        if ( !subStandard.name.eq(!subStandardName) ) then
          !this.currSubStandard = !subStandard
          break
        endif
      enddo
      break
    endif
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setUserSetting
--
-- Description: sets the setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      description of the setting
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setUserSetting(!description is STRING)

  do !setting value !this.userSettings
    if ( !setting.description.trim().eq(!description.trim())) then
      !this.currSetting = !setting
      break
    endif
  enddo

  do !setting value !this.projectSettings
    if ( !setting.description.trim().eq(!description.trim())) then
      !this.currSetting = !setting
      break
    endif
  enddo

  do !setting value !this.settings
    if ( !setting.description.trim().eq(!description.trim())) then
      !this.currSetting = !setting
      break
    endif
  enddo

  if ( !this.currSetting.unset() and !this.settings.empty().not() ) then
    !this.currSetting = !this.settings.first()
  endif

  -- set the asl selection list with the current setting
  if( defined(!!aslSelections) ) then
    !aslSettingsList = !!aslSelections.opSettings.dText
    do !settingDesc values !aslSettingsList
      !splitArray  = !settingDesc.split()
      if !splitArray.size().gt(2) then
        !setting = !splitArray[1] + ' '
        do !i from 2 to !splitArray.size() - 1
          !setting = !setting + !splitArray[!i] + ' '
        enddo
      else
        !setting = !settingDesc.split()[1]
      endif
      !setting = !setting.trim()

      if(!!appDesMain.opASLSettings.selection().matchwild('*$!<setting>')) then
        --!!aslSelections.opSettings.select('dText',!settingDesc)
        !!aslSelections.settingsFrom  = 'APPDESMAINFORM'
        !!aslSelections.selectSetting()
        break
      endif
    enddo
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      writeCriteriaSetToDB
--
-- Description: writes the criteria set to the xml file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         criteria set (ASLLADDER, etc.)
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .writeCriteriaSetToDB(!criteriaSet is ANY)

  -- store the element (like STRFLT, LADDER)
  !criteriaType = !criteriaSet.OBJECTTYPE().after('ASL').before('CRITERIA')

  -- loop through the criterion elements, like OGOING, WIDTH
  do !criterionName value !criteriaSet.attributes()
    -- destroy old instances
    if ( DEFINED(!criterion) ) then
      !criterion.delete()
    endif

    -- creates the object
    !criterion = !criteriaSet.attribute(!criterionName)

    -- ignore none criterion elements
    skip if ( !criterion.OBJECTTYPE().neq('CRITERION') )

    APPLDA
    var !dataset collect all DDSE with (function eq '$!criteriaType') for ce
    if(!dataset.unset()) then
      NEW DDSE
      purp ASL
      function '$!criteriaType'
    else
      $!dataset[1]
    endif

    var !designData collect all DDAT for ce
    if(!designData.unset()) then
      NEW DDAT
    else
      do !n indices !designData
        !designDataRef  = object DBREF()
        if(!designData[!n].dbref().description.part(2) eq !criterionName)  then
          !designDataRef  = !designData[!n].dbref()
          !!ce  = !designDataRef
          break
        endif
      enddo
      if(!designDataRef.unset()) then
        NEW DDAT
      endif
    endif

    --skip if(!!ce.type neq 'DDAT')

    !!ce.description = !criteriaType & ' ' & !criterionName
    if ( !criterion.min.set() ) then
      !!ce.maxMin[1] = !criterion.min
    else
      !!ce.maxMin[1] = 0
    endif
    if ( !criterion.max.set() ) then
      !!ce.maxMin[2] = !criterion.max
    else
      !!ce.maxMin[2] = 1000000
    endif
    if ( !criterion.optimum.set() ) then
      dDDfault $!<criterion.optimum>
    endif
    if ( !criterion.tolerance.set() ) then
      --!!ce.tolerance   = !criterion.tolerance
    endif
    if (!criterion.value.size().eq(1) and !criterion.value[1].set() ) then
      dDProperty $!<criterion.value[1]>
    endif
    -- clear old VVALUE members
    !memb = memb vvalue
    do !vval values !memb
      !!ce = !vval
      delete VVALUE
    enddo

    do !validValue value !criterion.validValues
      -- ignores empty cells
      skip if ( !validValue.string().trim().eq('') )

      NEW VVALUE
      !!ce.validValue = !validValue.string()
    enddo
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      writeSettings
--
-- Description: writes the settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .writeSettings()

  !this.writeSettings('ALL')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      writeSettings
--
-- Description: writes the settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .writeSettings(!type is STRING)

   if !type.eq('USER') then

    -- get the user dflts
    !fileName = object FILE('%PDMSUSER%' & '/aslsettings.xml')
    !settingFiles = object ARRAY()
    !dfltFiles = object ARRAY()
    !dfltFiles.append(!fileName)
    !dfltFiles.append(!this.userSettings)
    !settingFiles.append(!dfltFiles)

  elseif !type.eq('PROJECT') then

    -- get the current project dflts
    !currProj = CURRENT PROJECT
    !fileName = object FILE('%' & !currProj.code() & 'DFLTS%/aslsettings.xml')
    !settingFiles = object ARRAY()
    !dfltFiles = object ARRAY()
    !dfltFiles.append(!fileName)
    !dfltFiles.append(!this.projectSettings)
    !settingFiles.append(!dfltFiles)

  elseif !type.eq('DFLTS') then

    -- get the aveva dflts
    !fileName = object FILE('%PDMSDFLTS%' & '/aslsettings.xml')
    !settingFiles = object ARRAY()
    !dfltFiles = object ARRAY()
    !dfltFiles.append(!fileName)
    !dfltFiles.append(!this.settings)
    !settingFiles.append(!dfltFiles)

  elseif !type.eq('ALL') then

    -- get the user dflts
    !fileName = object FILE('%PDMSUSER%' & '/aslsettings.xml')
    !settingFiles = object ARRAY()
    !dfltFiles = object ARRAY()
    !dfltFiles.append(!fileName)
    !dfltFiles.append(!this.userSettings)
    !settingFiles.append(!dfltFiles)

    -- get the current project dflts
    !currProj = CURRENT PROJECT
    !fileName = object FILE('%' & !currProj.code() & 'DFLTS%/aslsettings.xml')
    !settingFiles = object ARRAY()
    !dfltFiles = object ARRAY()
    !dfltFiles.append(!fileName)
    !dfltFiles.append(!this.projectSettings)
    !settingFiles.append(!dfltFiles)

    -- get the aveva dflts
    !fileName = object FILE('%PDMSDFLTS%' & '/aslsettings.xml')
    !settingFiles = object ARRAY()
    !dfltFiles = object ARRAY()
    !dfltFiles.append(!fileName)
    !dfltFiles.append(!this.settings)

  else

    --no type specified
    return

  endif

  -- loop through the different settings locations i.e project dflts, user dflts etc. and load them into the XML FILE
  do !i from 1 to !settingFiles.size()
    !file = !settingFiles[!i][1]
    handle ANY
      skip
    endhandle
    -- initialise
    !dataLines = object ARRAY()

    !dataLines.append('<?xml version="1.0" standalone="yes"?>')
    !dataLines.append('<settings>')

    -- handles all available settings
    do !setting value !settingFiles[!i][2]

      -- adds the header for settings
      !dataLines.append('  <setting description="' & !setting.description & '"  purpose="' & !setting.purpose & '"  type="' & !setting.type &'">')

      -- handles all setting data
      do !settingData value !setting.settingData
        !dataLines.append('    <value purpose="' & !settingData.purpose & '" val="' & !settingData.value & '"/>')
      enddo

      -- handles all sub settings
      do !subSetting value !setting.subSettings

        -- adds the sub setting header
        !dataLines.append('    <subsetting purpose="' & !subSetting.purpose & '">')

        --handles all settings data of the setting
        do !settingData value !subSetting.settingData
          -- if the setting value is a reference then try to convert to an aveva name
          if !settingData.value.trim().subString(1,1).eq('=') then
            !name = !settingData.value.dbref().name
            !dataLines.append('      <value purpose="' & !settingData.purpose & '" val="' & !name & '"/>')
            handle ANY
              !dataLines.append('      <value purpose="' & !settingData.purpose & '" val="' & !settingData.value & '"/>')
            endhandle
          else
            !dataLines.append('      <value purpose="' & !settingData.purpose & '" val="' & !settingData.value & '"/>')
          endif
        enddo

        -- adds the sub setting footer
        !dataLines.append('    </subsetting>')
      enddo

      -- adds the footer for setting
      !dataLines.append('  </setting>')
    enddo

    !dataLines.append('</settings>')

    if(!file.exists() or !file.directory().exists())then
      !file.writeFile('OVERWRITE', !dataLines)
      handle (41,319)
        !!alert.warning('Access Denied. Check write access to $!file')
        skip
      endhandle
    else
       !!alert.warning('$!file does not exist')
       skip
    endif

    -- update the option gadget
    !dText = object ARRAY()
    !rText = object ARRAY()
    do !setting value !this.userSettings
      !dText.append('(U) ' + !setting.description)
      !rText.append(!setting.description)
    enddo

    do !setting value !this.projectSettings
      !dText.append('(P) ' + !setting.description)
      !rText.append(!setting.description)
    enddo

    do !setting value !this.settings
      !dText.append('(D) ' + !setting.description)
      !rText.append(!setting.description)
    enddo

    !!appDesMain.opASLSettings.dText = !dText

    if(!!appDesMain.opASLSettings.dText.set() and !!appDesMain.opASLSettings.val.eq(0)) then
      !!appDesMain.opASLSettings.val = 1
    elseif(!!appDesMain.opASLSettings.dText.set() and !!appDesMain.opASLSettings.val.geq(1)) then
      if(!!appDesMain.opASLSettings.selection().split()[1].eq('(P)'))then
        !!appDesMain.opASLSettings.val = !!aslCentralData.projectSettings.size()
        handle (61,620)
        endhandle
      elseif(!!appDesMain.opASLSettings.selection().split()[1].eq('(U)')) then
        !!appDesMain.opASLSettings.val = !!aslCentralData.userSettings.size()
        handle (61,620)
        endhandle
      endif
    endif

  enddo
endmethod
-- End of method
