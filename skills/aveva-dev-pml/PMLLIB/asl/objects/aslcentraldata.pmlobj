------------------------------------------------------------------------
--
-- Method:      writeStandards
--
-- Description: writes the standards
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateSettings()

    -- update the option gadget
    !dText = object ARRAY()
    !rText = object ARRAY()
    do !setting value !this.userSettings
      !dText.append('(U) ' + !setting.description)
      !rText.append(!setting.description)
    enddo

    do !setting value !this.projectSettings
      !dText.append('(P) ' + !setting.description)
      !rText.append(!setting.description)
    enddo

    do !setting value !this.settings
      !dText.append('(D) ' + !setting.description)
      !rText.append(!setting.description)
    enddo

    !!appDesMain.opASLSettings.dText = !dText

    if(!!appDesMain.opASLSettings.dText.set() and !!appDesMain.opASLSettings.val.eq(0)) then
      !!appDesMain.opASLSettings.val = 1
    elseif(!!appDesMain.opASLSettings.dText.set() and !!appDesMain.opASLSettings.val.geq(1)) then
      if(!!appDesMain.opASLSettings.selection().split()[1].eq('(P)'))then
        !!appDesMain.opASLSettings.val = !!aslCentralData.projectSettings.size()
        handle (61,620)
        endhandle
      elseif(!!appDesMain.opASLSettings.selection().split()[1].eq('(U)')) then
        !!appDesMain.opASLSettings.val = !!aslCentralData.userSettings.size()
        handle (61,620)
        endhandle
      endif
    endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      writeStandards
--
-- Description: writes the standards
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .writeStandards()

  -- activates the write to DB method
  !this.writeStandardsToDB()

  -- updates the standard and subStandard with the values
  !this.setStandards()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      writeStandardsToDB
--
-- Description: writes the standards into the db
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .writeStandardsToDB()

  -- create undo mark
  if ( !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update standard')
    !undo.add()
  endif

  !oldRefe = !!ce

  !tpwlRefe = !!aslStoreTable.getStore('standards')

  -- handles all available standards
  do  !i index !this.standards
    !standard = !this.standards[!i]
    -- checks if the standard already exists
    if ( !standard.deleteFlag ) then
      if ( !standard.refe.badref().not() ) then
        !!ce = !standard.refe
        DELETE APPDAR
        !this.standards[!i].delete()
      endif
      skip
    else
      if ( !standard.refe.badref() ) then
        !!ce           =  !tpwlRefe
        NEW APPDAR
        !standard.refe = !!ce
      else
        !!ce           = !standard.refe
      endif
    endif

    -- checks the write access (What if locked or claimed by other?)
    skip if ( !standard.refe.dbWrite.not() )
    skip if ( !standard.refe.lock )
    skip if ( !standard.refe.modatt.name.not() )
    skip if ( !standard.refe.dacmod.name.not() )

    if(!standard.description.set())then
    	!standard.refe.description = !standard.description
    else
    	!standard.refe.description = !standard.name.replace(' ','')
    endif

    if(!standard.name.subString(1,1).eq('/')) then
      !standard.refe.name        = !standard.name
    else
      !standard.refe.name        = '/' & !standard.name
    endif

    !standard.refe.purpose      = 'ASL'

    do !j index !standard.subStandards
      !subStandard = !standard.subStandards[!j]

      -- checks if the sub standard already exists
      if ( !subStandard.deleteFlag ) then
        if ( !subStandard.refe.badref().not() ) then
          !!ce = !subStandard.refe
          DELETE APPLDA
          !standard.subStandards[!j].delete()
        endif
        skip
      else
        if ( !subStandard.refe.badref() ) then
          !!ce              =  !standard.refe
          NEW APPLDA
          !subStandard.refe = !!ce
        else
          !!ce              = !subStandard.refe
        endif
      endif
      var !dataset collect all DDSE for ce
      do !k indices !dataset
        $!dataset[$!k]
        handle ANY
          !!alert.error('Data can not be modified ' & !!error.text)
          handle ANY
            !!alert.error(!!error.text)
            skip
          endhandle
        endhandle
      enddo

      -- write the subStandard (e.g. private) to the db
      !this.writeSubStandardsToDB(!subStandard)
      !subStandard.refe.purpose     = 'ASL'
      --!subStandard.refe.name        = !standard.refe.name & '/' & !subStandard.name
      if(!subStandard.name.subString(1,1).eq('/')) then
        !subStandard.refe.name        = !subStandard.name
        handle ANY
          !subStandard.refe.name        = !standard.refe.name & !subStandard.name
          handle ANY
          endhandle
        endhandle
      else
        !subStandard.refe.name        = '/' & !subStandard.name
        handle ANY
          !subStandard.refe.name        = !standard.refe.name & '/' & !subStandard.name
          handle ANY
          endhandle
        endhandle
      endif

      if(!subStandard.description.set())then
      	!subStandard.refe.description = !subStandard.description
      else
        !subStandard.refe.description = !subStandard.name.replace(' ','')
      endif

      do !mem indices !subStandard.refe.mem
         if(!subStandard.refe.mem[!mem].name.occurs('=').neq(0))then
         		!subStandard.refe.mem[!mem].name = !subStandard.refe.name & '/' & !subStandard.refe.mem[!mem].function.trim()
         		handle ANY
         		endhandle
         endif
      enddo

      !standard.subStandards[!j] = !subStandard
    enddo
    !standard.subStandards.compress()
    !this.standards[!i] = !standard
  enddo
  !this.standards.compress()

  !!ce = !oldRefe
  handle ANY
  endhandle

  -- end undo mark
  if ( !this.undoable ) then
    !undo.endUndoable()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      writeSubStandardsToDB
--
-- Description: writes the sub standards to the xml file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLSUBSTANDARD
--                           subStandard (private, etc.)
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .writeSubStandardsToDB(!subStandard is ASLSUBSTANDARD)

  -- loop through criteria set, e.g. LADDER or STRFLT
  do !criteriaSetName value !subStandard.attributes()
    -- destroy old instances
    if ( DEFINED(!criteriaSet) ) then
      !criteriaSet.delete()
    endif

    -- creates the object
    !criteriaSet = !subStandard.attribute(!criteriaSetName)

    -- ignore none criteria set elements
    skip if ( !criteriaSet.OBJECTTYPE() inset ('BOOLEAN', 'DBREF', 'STRING') )

    !this.writeCriteriaSetToDB(!criteriaSet)

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      writeStandardsToFile
--
-- Description: writes the standards to the xml file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .writeStandardsToFile()

  -- initialise
  !dataLines = object ARRAY()

  !dataLines.append('<?xml version="1.0" standalone="yes"?>')
  !dataLines.append('<standards>')

  -- handles all available standards
  do !standard value !this.standards

    -- ignores standard data from PDMSDFLTS path or deleted standards
    skip if ( !standard.originKey.eq('PDMSDFLTS') or $
              !standard.deleteFlag )

    -- adds the header for standards
    !dataLines.append('  <standard description="' & !standard.name & '">')

    -- handles all subStandards
    do !subStandard value !standard.subStandards

      -- ignores deleted sub standard data
      skip if ( !subStandard.deleteFlag )

      -- adds the sub standard header
      !dataLines.append('    <subStandard description="' & !subStandard.name & '">')

      -- handles all subStandards
      do !criteriaSetName value !subStandard.attributes().sort()
        -- delete old instances
        if ( DEFINED(!criteriaSet) ) then
          !criteriaSet.delete()
        endif

        --evaluate the subStandard object
        !criteriaSet = !subStandard.attribute(!criteriaSetName)

        -- ignores the none subStandard member
        skip if ( !criteriaSet.OBJECTTYPE() inset ('BOOLEAN', 'DBREF', 'STRING') )

        -- adds the sub standard header
        !dataLines.append('      <criteriaset purpose="' & !criteriaSetName & '">')

        --handles all criteria of the substandard
        do !criterionName value !criteriaSet.attributes().sort()
          -- delete old instances
          if ( DEFINED(!criterion) ) then
            !criterion.delete()
          endif

          --evaluate the criterion object
          !criterion     = !criteriaSet.attribute(!criterionName)
          !criterionType = !criterion.OBJECTTYPE()

          -- ignores none criterion attributes
          skip if ( !criterionType.neq('CRITERION') )

          -- adds the criterion header
          !dataLines.append('        <criterion purpose="' & !criterionName & '">')

          -- handles all members of the criterion element
          do !attributeName value !criterion.attributes().sort()

            -- ignores the description attribute
            skip if ( !attributeName inset ('DESCRIPTION', 'KEY') )

            -- delete old instances
            if ( DEFINED(!att) ) then
              !att.delete()
            endif
            !att     = !criterion.attribute(!attributeName)
            !attType = !att.OBJECTTYPE()

            --ignores empty arrays and unset real and string arrays
            skip if ( !attType.eq('ARRAY') and $
                      !att.empty() )

            skip if ( !attType.eq('BLOCK') and $
                      !att.string().eq('') )


            skip if ( !attType.eq('STRING') and $
                      !att.eq('') )

            skip if ( !att.unset() )

            -- data type ARRAY
            if ( !attType.eq('ARRAY') ) then
              -- sorts the values
              !values = !att.sort()
              !val    = !values.first().string()
              do !i from 2 to !values.size()
                !val = !val & ';' & !values[!i].string()
              enddo
              !dataLines.append('          <value purpose="' & !attributeName & '" val="' & !val & '"/>')
            else
              !dataLines.append('          <value purpose="' & !attributeName & '" val="' & !att.string() & '"/>')
            endif
          enddo

          -- adds the sub criterion footer
          !dataLines.append('        </criterion>')
        enddo

        -- adds the sub standard footer
        !dataLines.append('      </criteriaset>')
      enddo

      -- adds the sub standard footer
      !dataLines.append('    </subStandard>')
    enddo

    -- adds the footer for standards
    !dataLines.append('  </standard>')
  enddo
  !dataLines.append('</standards>')

  -- writes the local standard file
  !file = !this.getProjDfltsFile()
  !file.writeFile('OVERWRITE', !dataLines)

  -- updates the standard and subStandard with the values
  !this.setStandards()

endmethod
-- End of method

------------------------------------------------------------------------
