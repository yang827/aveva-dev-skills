endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSettingType
--
-- Description: gets the type of setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1   R      STRING      setting name
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .getSettingType(!settingName is STRING) is STRING

  -- find out the type of setting being used i.e. is it a USER setting a Project setting or the dflt
  do !setting value !this.userSettings
    if ( !setting.description.trim().eq(!settingName.trim()) ) then
      return 'USER'
    endif
  enddo

  do !setting value !this.projectSettings
    if ( !setting.description.trim().eq(!settingName.trim()) ) then
      return 'PROJECT'
    endif
  enddo

  do !setting value !this.settings
    if ( !setting.description.trim().eq(!settingName.trim()) ) then
      return 'DFLTS'
    endif
  enddo

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      writeSettings
--
-- Description: writes the settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .writeSettings(!type is BOOLEAN)

  if !type then

    do !i index  !!aslCentralData.userSettings
      if (!!aslCentralData.userSettings[!i].description.trim().eq(!!aslSelections.meCurrSetting.description.trim())) then
        !!as[!i] = !!aslCentralData.userSettings.removeFrom(!i, 1)
        !settingType = 'USER'
        break
      endif
    enddo

    do !i index  !!aslCentralData.projectSettings
      if (!!aslCentralData.projectSettings[!i].description.trim().eq(!!aslSelections.meCurrSetting.description.trim())) then
        !!as[!i] = !!aslCentralData.projectSettings.removeFrom(!i, 1)
        !settingType = 'PROJECT'
        break
      endif
    enddo

    do !i index  !!aslCentralData.settings
      if (!!aslCentralData.settings[!i].description.trim().eq(!!aslSelections.meCurrSetting.description.trim())) then
        !!as[!i] = !!aslCentralData.settings.removeFrom(!i, 1)
        !settingType = 'DFLTS'
        break
      endif
    enddo
  else
    return
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getTemplates
--
-- Description: get list of templates of passed type stored within passed settings
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY        dbref array of templates
--
------------------------------------------------------------------------

define method .getTemplates(!settings is STRING,!type is STRING) is ARRAY

  -- init
  !templates = ARRAY()
  !error = 'Settings "' & !settings & '" does not contain valid assembly templates for ' & !type.upcase() & '. Contact your ASL administrator.'

  -- get sub setting data from central data
  !subSetting = !!aslCentralData.getSetting(!settings).subSettings
  handle ANY
    return error 1 'Invalid setting reference "$!<settings>". Contact your ASL administrator.'
  endhandle

  !indx = !subSetting.evaluate(object BLOCK('!subSetting[!evalIndex].purpose')).findFirst(!type.upcase())

  if !indx.unset() then
    return error 2 '$!<error>'
  endif

  !settingData = !subSetting[!indx].settingData

  do !data values !settingData
     if ( !data.assigned.eq(true) ) then
      !tmplRef = !data.value.dbref()
      handle ANY
        skip
      endhandle
      skip if !tmplRef.badref()
      !templates.append(!tmplRef)
    endif
  enddo

  if !templates.unset() then
    return error 2 '$!<error>'
  endif

  return !templates

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      readAslSettings
--
-- Description: reads the settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .readAslSettings()

  -- initialise
  !this.currSetting     = object SETTING()
  !this.settings        = object ARRAY()
  !this.userSettings    = object ARRAY()
  !this.projectSettings = object ARRAY()
  !settingColl          = object ARRAY()

  --collect the setting from the Data Base
  !settingPurpose       = object EXPRESSION(|FUNC eq 'SETTING'|)

  !collectSetting       = object COLLECTION()
  !collectSetting.type('APPLDA')
--  !collectSetting.scope(/* )
  !collectSetting.filter(!settingPurpose)
  !resultSetting        = !collectSetting.results()

  -- loop through the different settings locations
  do !setting values !resultSetting
    --collect the subsetting data from the respective element
    !dataPurpose        = object EXPRESSION(|PURP eq 'ASLA'|)

    !collectData        = object COLLECTION()
    !collectData.type('DDSE')
    !collectData.scope(!setting)
    !collectData.filter(!dataPurpose)
    !resultData         = !collectData.results()

    !aslSetting                = object SETTING()
    !aslSetting.description    = !setting.name.after('/')
    !aslSetting.purpose        = !setting.purp
    !aslSetting.type           = !setting.gType

    do !data values !resultData
      --collect the values of the data set
      !valuePurpose = object EXPRESSION(|PURP eq 'ASLA'|)

      !collectValue = object COLLECTION()
      !collectValue.type('DDAT')
      !collectValue.scope(!data)
      !collectValue.filter(!valuePurpose)
      !resultValue  = !collectValue.results()

      if (!data.func.upcase().eq('STANDARD-SUBSTANDARD') ) then
        do !stdSubStd values !resultValue
          !settingData = object SETTINGDATA()
          !settingData.assigned     = !stdSubStd.ldisp
          !settingData.purpose      = !stdSubStd.description
          !settingData.value        = !stdSubStd.dDProperty.subString(-2).after('/').trim()
          --append the value to the setting
          !aslSetting.settingData.append(!settingData)
        enddo
      else
        !subSetting = object SUBSETTING()
        !subSetting.purpose = !data.function

        do !assemblyItem values !resultValue
          !settingData = object SETTINGDATA()
          !settingData.assigned     = !assemblyItem.ldisp
          !settingData.purpose      = !data.function
          !settingData.value        = !assemblyItem.dDProperty.subString(-2).after('/').trim()
          --append the value to the setting
          !subSetting.settingData.append(!settingData)
        enddo

        !aslSetting.subSettings.append(!subSetting)
      endif

    enddo

    --append the respective setting
    if ( !aslSetting.type.eq('USER') ) then
      !this.userSettings.append(!aslSetting)
    elseif ( !aslSetting.type.eq('PROJ') ) then
      !this.projectSettings.append(!aslSetting)
    elseif ( !aslSetting.type.eq('DFLT') ) then
      !this.settings.append(!aslSetting)
    endif

  enddo

  --set the current settings in the main MENU
  !this.setAppDesMainSettings(!resultSetting)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setAppDesMainSettings
--
-- Description: reads the settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setAppDesMainSettings(!resultSetting is ARRAY)

  -- update the appDesMain option gadget with the available settings
  !dText = object ARRAY()
  !rText = object ARRAY()

  do !setting value !this.settings
    !dText.append('(D) ' + !setting.description)
    !rText.append(!setting.description)
  enddo

  do !setting value !this.userSettings
    !dText.append('(U) ' + !setting.description)
    !rText.append(!setting.description)
  enddo

  do !setting value !this.projectSettings
    !dText.append('(P) ' + !setting.description)
    !rText.append(!setting.description)
  enddo

  !!appDesMain.opASLSettings.dText = !dText
  !!appDesMain.opASLSettings.rText = !rText

  --set the current setting
  do !currentSetting values !resultSetting
    if ( !currentSetting.tType.upcase().eq('TRUE') ) then
      !currSettingDesc = !currentSetting.namn
      break
    endif
  enddo

  --collect all the settings from the asl central object
  !allSettings = object ARRAY()
  !allSettings.appendarray(!this.settings)
  !allSettings.appendarray(!this.userSettings)
  !allSettings.appendarray(!this.projectSettings)

  if ( defined(!currSettingDesc) and !currSettingDesc.set() ) then
    do !setCurrentSettings values !allSettings
      if ( !currSettingDesc.eq(!setCurrentSettings.description) ) then
        !this.currSetting = !setCurrentSettings
        --set the selected setting in the option GADGET
        !!appDesMain.opASLSettings.select( 'rText', !setCurrentSettings.description )
        break
      endif
    enddo
  else
    if ( !allSettings.set() ) then
      !this.currSetting = !allSettings[1]
      !!appDesMain.opASLSettings.select( 'rText', !allSettings[1].description )
    endif
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setCurrentSetting
--
-- Description: find the current setting and set it
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .setCurrentSetting()

  !selectedSetting  =  !!appDesMain.opASLSettings.selection()
  if ( !selectedSetting.unset() ) then
    !!alert.message('Select to set Current Setting')
    return
  endif

  --collect all Settings
  !settings = object ARRAY()
  !settings.appendarray(!!aslCentralData.settings)
  !settings.appendarray(!!aslCentralData.userSettings)
  !settings.appendarray(!!aslCentralData.projectSettings)

  --set the current Settings
  do !currSetting values !settings
    if ( !selectedSetting.eq(!currSetting.description) ) then
      !!aslCentralData.currSetting = !currSetting
      break
    endif
  enddo

  --set the current status for the setting
  --collect the setting from the Data Base
  !settingPurpose = object EXPRESSION(|FUNC eq 'SETTING'|)

  !collectSetting = object COLLECTION()
  !collectSetting.type('APPLDA')
--  !collectSetting.scope(/* )
  !collectSetting.filter(!settingPurpose)
  !resultSetting = !collectSetting.results()

  do !setStatus values !resultSetting
    if ( !selectedSetting.eq(!setStatus.namn) ) then
      !setStatus.tType = 'true'
    elseif ( !selectedSetting.neq(!setStatus.namn) ) then
      !setStatus.tType = ''
    endif
  enddo

  --call the method to set the gadget Value
  !!aslCentralData.setAppDesMainSettings(!resultSetting)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      getTemplates
--
-- Description: get list of available templates for the element type passed
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]  [Description]
--    ARRAY        dbref array of Stair Flight  template
--
------------------------------------------------------------------------

define method .getTemplates(!element is STRING) is ARRAY

  --initialise
  !templates = ARRAY()

  -- get subSetting data from central data
  !subSetting = !this.getSetting(!this.currSetting.description).subSettings
  !indx = !subSetting.evaluate(object BLOCK('!subSetting[!evalIndex].purpose')).findFirst('$!element')
  if(!indx.unset()) then
     !!alert.error('Current Setting does not have templates for $!element')
     return
  endif

  !settingData = !subSetting[!indx].settingData

  do !data values !settingData
    if ( !data.assigned.eq(true) ) then
      !tmplRef = !data.value.dbref()
      !templates.append(!tmplRef)
    endif
  enddo

  return !templates

endmethod
-- End of method
