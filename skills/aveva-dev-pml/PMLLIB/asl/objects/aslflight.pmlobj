--
-- Description:     Object to hold individual flight data in a stair flight
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addLlndg(ARRAY)                  -
--  addLlndg(LINE)                   -
--  addUlndg(ARRAY)                  -
--  addUlndg(LINE)                   -
--  aslFlight(ARRAY)                 -                   Constructor
--  evalFltDirection()               DIRECTION
--  evalFltDirection(POSITION,POSITION) DIRECTION
--  evalGoing()                      REAL
--  evalGoing(POSITION,POSITION,DIRECTION) REAL
--  evalPitch()                      REAL
--  evalPitch(REAL,REAL)             REAL
--  offset(DIRECTION,REAL)           -
--  offsetPoint(POSITION,DIRECTION,REAL) -
--  update()                         -
--
------------------------------------------------------------------------
define object ASLFLIGHT

  member .refe         is DBREF
  member .lwp          is POSITION
  member .uwp          is POSITION

  member .fltDirection is DIRECTION

  member .pitch        is REAL
  member .going        is REAL
--  member .rise         is REAL

  member .oGoing        is REAL
  member .oRise         is REAL

  member .numOfTreads  is REAL
  member .numOfFlights   is REAL

  member .lLndgDir     is DIRECTION
  member .uLndgDir     is DIRECTION

  member .lLndgLength  is REAL
  member .uLndgLength  is REAL

  member .lLndg        is ASLRPATH
  member .uLndg        is ASLRPATH

endobject
------------------------------------------------------------------------
--
-- Method:      aslFlight
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslFlight(!vertices is ARRAY)

  -- Check whether  the passed vertices are just having 2 elevations, if not ignore the elevation at the
  -- Soma to do This  handles only single straight  segments. Is it not a better idea to hold

  !lowElev = !vertices[1].up
  !lowPts   = ARRAY()
  !upPts   = ARRAY()
  do !verInx indices !vertices
     !elevChange = FALSE
     if (!vertices[!verInx].up.eq(!lowElev)) then
        !lowPts.append(!vertices[!verInx])
     elseif (!vertices[!verInx].up.neq(!lowElev)) then
        !elevChange = TRUE
        !upPts.append(!vertices[!verInx])
     elseif (!vertices[!verInx].up.neq(!lowElev) or !vertices[!verInx].up.neq(!upElev) or ( (!vertices[!verInx].up.eq(!lowElev) or !vertices[!verInx].up.eq(!upElev)) and !elevChange) )then
          break
     endif
  enddo

  -- even though we presume that the lowPts will be at lower elevation, case may be that the opp is true
  !this.lLndg = object ASLRPATH(!lowPts)
  !this.uLndg = object ASLRPATH(!upPts)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset( !dir is DIRECTION , !dist is REAL)

   !this.lwp  =  !this.lwp.offset(!dir,!dist)
   !this.uwp  =  !this.uwp.offset(!dir,!dist)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      offsetPoint
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offsetPoint(!vertex is POSITION , !dir is DIRECTION , !dist is REAL)

   if (!dir.up.eq(0) ) then
      !this.xyOffset(!dir,!dist)
   elseif(!dir.isparallel(u) ) then
      !this.zOffset(!dir, !dist)
   else
      !segment    = !vertex.line(!vertex.offset(!dir,!dist))
      !horzPlane  =  object PLANE(!vertex , z is u)
      -- Project on the Horizontal plane and get the end position
     !projPoint   =  !segment.projected(!horzPlane).endPosition
     -- Find the horiz and Vertical component and assign offsets
     !horizDir     =  !vertex.direction(projPoint)
     !horizDist    = !vertex.distance(!projPoint)
     !this.xyOffset(!horizDir , !horizDist)
     !vertDir     =  !segment.endPosition.direction(projPoint)
     !vertDist    = !segment.endPosition.distance(!projPoint)
     !this.zOffset(!vertDir, !vertDist)
   endif

   !this.lwp  =  !this.lwp.offset(!dir,!dist)
   !this.uwp  =  !this.uwp.offset(!dir,!dist)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evalPitch
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evalPitch( ) is REAL

    !pitch = !this.evalPitch(!this.oRise , !this.oGoing)

     return !pitch

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evalPitch
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evalPitch(!fltRise is REAL, !fltGoing is REAL ) is REAL

  !tanPitch        =   !fltRise  /  !fltGoing
  !pitch             =  !tanPitch.atan()

  return !pitch

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evalFltDirection
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evalFltDirection( ) is DIRECTION

  !fltDirection  = !this.evalFltDirection(!this.lwp , !this.uwp)
  return !fltDirection
endmethod

-- End of method definition

------------------------------------------------------------------------
--
-- Method:      addLlndg
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addLlndg(!line is LINE )

   if(!line.startPosition.up.eq(!this.lwp.up) ) then
      !edges = !this.lLndg.edges(FALSE)
      !edges.append(!line)
      !this.lLndg.aslRpath(!edges)
   endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evalFltDirection
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evalFltDirection(!lwp is POSITION, !uwp is POSITION ) is DIRECTION

  !fltDirection      = !lwp.direction(!uwp)
  !fltDirection.up   = 0

  return !fltDirection

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      addLlndg
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addLlndg(!lines is ARRAY )

   if(!lines[1].startPosition.up.eq(!this.lwp.up) ) then
      !edges = !this.lLndg.edges(FALSE)
      !edges.appendarray(!lines)
      !this.lLndg.aslRpath(!edges)
   endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evalGoing
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evalGoing( ) is REAL

  !fltDirection = !this.evalFltDirection()
  !going        = !this.evalGoing(!this.lwp , !this.uwp , !fltDirection)

  return !going

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      addUlndg
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addUlndg(!line is LINE )

   if(!line.startPosition.up.eq(!this.uwp.up) ) then
      !edges = !this.uLndg.edges(FALSE)
      !edges.append(!line)
      !this.uLndg.aslRpath(!edges)
   endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evalGoing
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evalGoing(!lwp is POSITION, !uwp is POSITION  , !fltDirection is DIRECTION) is REAL

  !horVector         = object POINTVECTOR( !lwp , !fltDirection)
  !perpPlaneOri    = object ORIENTATION(|y is u and z is $!fltDirection|)
  !secPtPerpPlane  = object PLANE( !uwp  ,!perpPlaneOri)
  !goingPt         = !secPtPerpPlane.intersection(!horVector)
  !going           = !lwp.distance(!goingPt)

  return !going

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      addUlndg
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addUlndg(!lines is ARRAY )

   if(!lines[1].startPosition.up.eq(!this.uwp.up) ) then
      !edges = !this.lLndg.edges(FALSE)
      !edges.appendarray(!lines)
      !this.uLndg.aslRpath(!edges)
   endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  !this.oRise = abs(!this.uwp.up - !this.lwp.up)
  !this.fltDirection = !this.evalFltDirection()
  !this.oGoing  = !this.evalGoing()
  !this.pitch = !this.evalPitch()
  if(!this.lLndgDir.unset() ) then
    !this.lLndgDir = !this.fltDirection.opposite()
  endif
  if(!this.uLndgDir.unset() ) then
    !this.uLndgDir = !this.fltDirection
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
