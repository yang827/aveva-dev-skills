-- Author:          Lars Leppin
-- Created:         Tue Aug 1 09:00:00 GMT 2006
--
--
-- Description:     container for HandRail criteria data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslHandRaCriteria()              -                   default constructor
--  checkRailSpacing(ARRAY)          -                   check every single spaces within real array
--  checkValue(REAL,STRING)          -                   check value against criterion
--  complete()                       -                   completes all missing values
--  railSpacing()                    ARRAY               returns array of default rail spaces
--  string()                         STRING              returns description
--

-- Define object
define object ASLHANDRACRITERIA

  -- stores the description of the object
  member .desc            is STRING

  -- height of the hand rail
  member .height          is CRITERION

  -- spacing between the rails
  member .railSpacing     is CRITERION

  -- height of kickplates
  member .kickplateHeight is CRITERION

  -- spacing of posts
  member .postSpacing     is CRITERION

  -- spacing to end of handrail
  member .endSpacing      is CRITERION

  -- spacing to end of tangent handrail
  member .tangentSpacing  is CRITERION

  -- bend radius
  member .bradius         is CRITERION

  -- split clearance
  member .splitClearance  is CRITERION

  -- spacing between panels
  member .panelSpacing    is CRITERION

  -- end spacing of panels
  member .panelEndSpacing is CRITERION

endobject
-- End of object definition for ASLHandRaCriteria

------------------------------------------------------------------------
--
-- Method:      aslHandRaCriteria
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslHandRaCriteria()

  !this.desc = 'Handrail'

  !this.height.description          = 'Height of handrail'
  !this.railSpacing.description     = 'Rail spacing'
  !this.kickplateHeight.description = 'Kickplate height'
  !this.postSpacing.description     = 'Post spacing'
  !this.endSpacing.description      = 'End spacing'
  !this.tangentSpacing.description  = 'Tangent spacing'
  !this.bradius.description         = 'Bend Radius'
  !this.splitClearance.description  = 'Clearance on split'
  !this.panelSpacing.description    = 'Panel Spacing'
  !this.panelEndSpacing.description = 'Panel End Spacing'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      complete
--
-- Description: completes all missing values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .complete()

  !this.height.complete(1000mm, 1200mm)
  !this.railSpacing.complete(200mm, 300mm)
  !this.kickplateHeight.complete(10mm, 100mm)
  !this.postSpacing.complete(1000mm, 3000mm)
  !this.endSpacing.complete(0mm, 2000mm)
  !this.tangentSpacing.complete(0mm, 2000mm)
  !this.bradius.complete(200mm,200mm)
  !this.splitClearance.complete(0,0)
  !this.panelSpacing.complete(100mm,100mm)
  !this.panelEndSpacing.complete(50mm,50mm)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      string
--
-- Description: returns description when converted to string
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Object description
------------------------------------------------------------------------

define method .string() is STRING

  return !this.desc

endmethod
-- end of method


------------------------------------------------------------------------
--
-- Method:      railspacing
--
-- Description: returns default rail spacing - real array of same format as handrail attribute RailHeight
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       real array
------------------------------------------------------------------------
define method .railSpacing() is ARRAY

  !railSpacing = ARRAY()

  !space = !this.railSpacing.optimum()
  !height = !this.height.optimum()

  !ratio = !height / !space
  !space = !height / !ratio.int()

  do !c from !space to !height by !space
    skip if !c.gt(!height)
    !railSpacing.append(!c)
  enddo

  return !railSpacing

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      checkValue
--
-- Description: check value against criterion
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Value to be checked
--    2   R      STRING      Criterion name
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .checkValue(!value is REAL,!criterionName is STRING)

  -- get appropriate CRITERION and check the value
  !criterion = !this.attribute(!criterionName.upcase())
  !criterion.checkValue(!value)

endmethod
-- end of method


------------------------------------------------------------------------
--
-- Method:      checkRailSpacing
--
-- Description: check every single spaces within real array
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Rail spaces
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .checkRailSpacing(!values is ARRAY)

  -- get current units
  !fmt = !!distanceFMT
  !fmt.label = 'UNITS'

  -- round off value
  !strMin = !this.railSpacing.min().string(!fmt)
  !strMax = !this.railSpacing.max().string(!fmt)

  -- check spaces
  !lower = 0
  do !higher values !values
    !error = STRING()
    !space = !higher - !lower
    !strSpace = !space.string(!fmt)
    !strLower = !lower.string(!fmt)
    !strHigher = !higher.string(!fmt)
    !this.checkValue(!space,'railSpacing')
    handle 1
      !error = 'Space ' & !strSpace & ' (between ' & !strLower & ' and ' & !strHigher & ') is less than minimum specified (' & !strMin & ')'
    elsehandle 2
      !error = 'Space ' & !strSpace & ' (between ' & !strLower & ' and ' & !strHigher & ') is greater than maximum specified (' & !strMax & ')'
    endhandle

    if !error.set() then
      !error = !error.replace(|'|,|''|)
      return error 1 '$!error'
    endif
    !lower = !higher
  enddo

  !spacing = !values
  !highest = !spacing.sort()
  if !highest.set() then
    !this.checkValue(!highest.last(),'height')
  endif

endmethod
-- end of method
