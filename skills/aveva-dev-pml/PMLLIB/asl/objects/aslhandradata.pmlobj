------------------------------------------------------------------------

define method .unEnhance()

  call !!aslUnEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: creates/updates HandRa element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDB()

  -- create undo mark
  if ( !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update handrail')
    !undo.add()
  endif

--  if(!!aslStoreTable.getStore('handrail').unset() or !!aslStoreTable.getStore('handrail').badRef())then
--    !!alert.error('Storage area is not set. Handrail is generated under the current element.')
--  else
--    !!ce = !!aslStoreTable.getStore('handrail')
--  endif

  -- creates/updates the owner element
  !this.refe          = !!aslCreate('HANDRA', !this.refe)

  !spacing            = !this.railSpacing
  !spacingHeight      = 0
  !spacingHeight    = !spacing[!spacing.size()]
  !lastGap            = !this.height - !spacingHeight

  if ( !lastGap.gt(0) ) then
    !spacing.append(!lastGap)
  endif

  !this.refe.railHeight     = !spacing
  !this.refe.bRadius        = !this.radius

  !this.refe.postSpacing    = !this.postSpacing
  if (!this.tangentSpacing eq 0) then
    !this.refe.tangOffset     = !this.tangentSpacing + 0.1
  else
  !this.refe.tangOffset     = !this.tangentSpacing
  endif
  !this.refe.ePostOffset    = !this.endSpacing

  !this.refe.description    = !this.tmplReference.string() & ' ' & !this.settingReference.string()

  -- create the routing
  RPATH 1
  handle ANY
    new RPATH
  elsehandle NONE
    DELETE RPATH MEMBER
  endhandle
  !this.routing = !this.routing.mergeLines()
  !this.routing.dbWrite(!!ce)
  -- For a handrail, any coincident first and last points are not required
  RPATH
  -- If no members we don't need this RPATH
  if (!!ce.members.size() eq 0) then
    DELETE RPATH
  else
    !positionOne = !!ce.members[1].position
    !positionLast = !!ce.members[!!ce.members.size()].position
    if (!positionOne eq !positionLast) then
      -- Make the handrail closed
      HANDRA
      CLOSEFLAG true
      SAME
      1
      -- Set radius
      FRAD $!this.radius
      LAST
      !type = !!ce .type
      DELETE $!type
    endif

    -- create the gates
    !this.createGates()

    -- create the handrails
    !this.createRailset()

    -- create the posts
    !this.createPosts()
  endif

  -- end undo mark
  if ( !this.undoable ) then
    !undo.endUndoable()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: read the values from the HandRa
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  !this.refe           = !refe

  !this.railSpacing    = !refe.railHeight
  !this.height         = 0
  do !gap value !this.railSpacing
    !this.height       = !this.height + !gap
  enddo

  !this.postSpacing    = !refe.postSpacing
  !this.tangentSpacing = !refe.tangOffset
  !this.endSpacing     = !refe.ePostOffset
  !this.radius         = !refe.bRadius

  -- collect all railsets for the template
  !collection = object COLLECTION()
  !collection.scope(!refe)
  !collection.type('RPATH')
  !collection.initialise()
  !allPaths = !collection.results()

  if ( !allPaths.empty() ) then
    return
  endif
  !this.routing = object POLYLINE(!allPaths[1])
  !this.tmplReference     = object DBREF(!this.refe.description.before(' '))
  !this.settingReference  = !this.refe.description.after(' ')


  -- reads the gates
  ---------------------------------------------------------------------------
  -- inits
  !this.gates  = object ARRAY()

  -- collects all handrail gates
  !collection  = object COLLECTION()
  !collection.type('HRGATE')
  !collection.scope(!refe)
  !collection.initialise()
  !hrGateRefes = !collection.results()

  -- stops if there are no gates
  if ( !hrGateRefes.empty() ) then
    return
  endif

  -- collects all pointers of the handrail path
  !collection  = object COLLECTION()
  !collection.type('POINTR')
  !collection.scope(!refe)
  !collection.initialise()
  !pointrRefes = !collection.results()

  -- handles all gates
  do !hrGateRefe value !hrGateRefes
    -- evaluates the reference pointr
    !posRefPointr = !hrGateRefe.posRef

    -- stops if the there is no valid reference
    skip if ( !posRefPointr.badRef() )

    -- evaluates the number of the reference pointr
    !matchIdx = !pointrRefes.findFirst(!posRefPointr)

    -- stop if there is no next pointer element after the reference pointr
    skip if ( !pointrRefes.size().eq(!matchIdx) )

    -- evaluates the next pointr element after the gate
    !nextPointr = !pointrRefes[!matchIdx + 1]

    -- evaluates the direction of the line between both pointr
    !line      = object LINE(!posRefPointr.position, !nextPointr.position)
    !direction = !line.direction()

    -- evaluates the gate position
    !position = !posRefPointr.position.offSet(!direction, !hrGateRefe.zDistance)

    -- assumption
    !entryDir = !direction.orthogonal(U)
    !exitDir  = !direction.opposite()

    !gate = object GATE(!position, !entryDir, !exitDir)
    !this.gates.append(!gate)
  enddo

endmethod


-- End of method
