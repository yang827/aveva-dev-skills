-- Return:
--   [Data Type] [Description]
--    BOOLEAN     error status
------------------------------------------------------------------------

define method .getError() is BOOLEAN

  -- inits
  !error = !this.error



  return !error

endmethod
-- End of method

------------------------------------------------------------------------
