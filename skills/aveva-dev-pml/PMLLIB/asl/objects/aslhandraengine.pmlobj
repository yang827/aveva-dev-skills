------------------------------------------------------------------------
--
-- Method:      setCriteria
--
-- Description: sets the criteria from the current central standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setCriteria()

  !this.handRaCriteriaBasis = !!aslCentralData.currSubStandard.aslHandRaCriteria

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setDefaults
--
-- Description: sets the defaults
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setDefaults()

  -- combines general and fabricator standard
  !this.mergeCriteria()

  -- inits
  !this.handRaData.endSpacing     = !this.handRaCriteria.endSpacing.optimum
  !this.handRaData.tangentSpacing = !this.handRaCriteria.tangentSpacing.optimum
  !this.handRaData.postSpacing    = !this.handRaCriteria.postSpacing.optimum
  !this.handRaData.height         = !this.handRaCriteria.height.optimum
  !this.handRaData.radius         = 200mm

  -- evaluate the railspacing
  !railSpacings                = ARRAY()
  !railSpacing                 = !this.handRaCriteria.railSpacing.optimum
  !railHeight                  = !this.handRaData.height
  do !i
    if (!i eq 1) then
      !rail = !railSpacing
    else
      !rail = !rail + !railSpacing
    endif
    !railSpacings.append(!rail)
    break if ( !i.gt(100) or !railHeight.leq(0) )
    !railHeight                = !railHeight - !railSpacing
  enddo
  !this.handRaData.railSpacing = !railSpacings

  -- basis gates
  !this.handRaData.gates    = ARRAY()

  -- basis routing, not to be modified yet
  !this.handRaData.routing  = object POLYLINE()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setEndSpacing
--
-- Description: sets the end spacing
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        end spacing
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setEndSpacing(!endSpacing is REAL)

  !this.handRaData.endSpacing = !endSpacing

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setGates
--
-- Description: sets all gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of all gates
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setGates(!gates is ARRAY)

  -- evaluates the added and the removed gates
  !addGates = !gates.difference(!this.handRaData.gates)
  !remGates = !this.handRaData.gates.difference(!gates)
  !oldGates = !this.handRaData.gates.intersect(!gates)

  -- assigns the gates to the gate stack
  !this.handRaData.gates = !oldGates
  !this.handRaData.gates.appendArray(!addGates)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPostSpacing
--
-- Description: sets the post spacing
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        post spacing
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setPostSpacing(!postSpacing is REAL)

  !this.handRaData.postSpacing = !postSpacing

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setRadius
--
-- Description: sets the rail spacing
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        radius
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setRadius(!radius is REAL)

  !this.handRaData.radius = !radius

  -- modify the polyline to implement the radius
  !polyLine     = !this.getRouting()
  !vertexPoints = !polyLine.vertices()
  do !i index !vertexPoints[2]
    !vertexPoints[2][!i] = !radius
  enddo
  !newPolyLine  = object POLYLINE(!polyLine.position, !polyLine.orientation, !vertexPoints[1], !vertexPoints[2])
  !this.setRouting(!newPolyLine)

endmethod
-- End of method

