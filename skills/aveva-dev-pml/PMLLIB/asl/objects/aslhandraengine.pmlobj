--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addGate(POSITION)                -                   adds a new gate to the gate stack
--  aslHandraEngine()                -
--  drawAccess()                     -                   draws gates
--  evaluateGate(POSITION)           GATE                evaluates a gates
--  flipGates(ARRAY)                 -                   change the entry and exit direction of gates
--  getEndSpacing()                  REAL                returns the end spacing
--  getError()                       BOOLEAN             returns the error status
--  getGates()                       ARRAY               returns an array of gates
--  getPostSpacing()                 REAL                returns the post spacing
--  getRadius()                      REAL                returns the radius
--  getRailHeight()                  REAL                returns the rail height
--  getRailSpacing()                 ARRAY               returns the rail spacing
--  getRefe()                        DBREF               returns the reference
--  getRouting()                     POLYLINE            gets the routing
--  getSettingReference()            STRING              gets the setting
--  getTangentSpacing()              REAL                returns the tangent spacing
--  getTmplReference()               DBREF               returns the template
--  mergeCriteria()                  -                   merges central standard with fabricator standard
--  newDefaults(DBREF)               -                   sets the attributes for a new platform (defaults
--  remGates(ARRAY)                  -                   removes gates from the gate stack
--  replaceGate(GATE,REAL)           -                   replaces an existing gate by a new one
--  replaceGate(POSITION,REAL)       -                   replaces an existing gate by a new one
--  resetError()                     -                   resets error status
--  setCriteria()                    -                   sets the criteria from the current central standard
--  setDefaults()                    -                   sets the defaults
--  setEndSpacing(REAL)              -                   sets the end spacing
--  setGates(ARRAY)                  -                   sets all gates
--  setPostSpacing(REAL)             -                   sets the post spacing
--  setRadius(REAL)                  -                   sets the rail spacing
--  setRailHeight(REAL)              -                   sets the rail spacing
--  setRailSpacing(ARRAY)            -                   sets the rail spacing
--  setRouting(POLYLINE)             -                   sets the routing
--  setSettingReference()            -                   sets the setting
--  setSettingReference(STRING)      -                   sets the setting
--  setTangentSpacing(REAL)          -                   sets the tangent spacing
--  setTmplReference(DBREF)          -                   sets the template reference
--  updateDB()                       -                   update the db with the form settings
--  updateDataObj(DBREF)             -                   reads the data from db
--

-- Define object
define object ASLHANDRAENGINE

  -- public members
  ---------------------------------------------------------------------------
  -- container for the handrail data
  member .handRaData          is ASLHANDRADATA

  -- private members
  ---------------------------------------------------------------------------
  -- contains the criteria set for handrail elements (including fabricator standard)
  member .handRaCriteria      is ASLHANDRACRITERIA

  -- contains the criteria set for handrail elements (excluding fabricator standard)
  member .handRaCriteriaBasis is ASLHANDRACRITERIA

  -- contains a copy of handrail data before modify
  member .handRaDataOld       is ASLHANDRADATA

endobject
-- End of object definition for ASLHandRaEngine

------------------------------------------------------------------------
--
-- Method:      ASLHandRaEngine
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslHandraEngine()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addGate
--
-- Description: adds a new gate to the gate stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position of the access
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .addGate(!position is POSITION)

  !gate = !this.evaluateGate(!position)
  !this.handRaData.gates.append(!gate)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawAccess
--
-- Description: draws gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawAccess()

  !this.handRaData.drawAccess()

endmethod

------------------------------------------------------------------------
--
-- Method:      evaluateGate
--
-- Description: evaluates a gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position of the access
-- Return:
--   [Data Type] [Description]
--    GATE        gate
------------------------------------------------------------------------

define method .evaluateGate(!position is POSITION) is GATE

  -- evaluates the nearest edges
  !edgeIdx      = !this.handRaData.routing.nearEdges(!position).first()
  !edges        = !this.handRaData.routing.edges()
  !nearestEdge  = !edges[!edgeIdx]

  -- evaluates the position projected on the nearest edge
  !nearPosition = !nearestEdge.near(!position)

  -- assumption of the entry direction
  !entryDir     = !nearestEdge.direction().orthogonal(U)

  !gate = object GATE(!nearPosition, !entryDir, !entryDir.opposite())

  return !gate

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      flipGates
--
-- Description: change the entry and exit direction of gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       indices of gates
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .flipGates(!gateIndices is ARRAY)

  do !gateIdx value !gateIndices
    !entryDirection                                 = !this.handRaData.gates[!gateIdx].entryDirection
    !arriveOffset                                   = !this.handRaData.gates[!gateIdx].arriveOffset

    !this.handRaData.gates[!gateIdx].entryDirection = !this.handRaData.gates[!gateIdx].exitDirection
    !this.handRaData.gates[!gateIdx].arriveOffset   = !this.handRaData.gates[!gateIdx].leaveOffset

    !this.handRaData.gates[!gateIdx].exitDirection  = !entryDirection
    !this.handRaData.gates[!gateIdx].leaveOffset    = !arriveOffset
  enddo

endmethod
-- End of method

