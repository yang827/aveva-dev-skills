------------------------------------------------------------------------
--
-- Method:      mergeCriteria
--
-- Description: merges central standard with fabricator standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergeCriteria()

  -- gets the values for the end landing from the substandard
  !this.handRaCriteria  = !!getCriteriaSetIntersection(!this.handRaCriteriaBasis, !this.handRaData.tmplReference)
  !this.handRaCriteria.complete()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newDefaults
--
-- Description: sets the attributes for a new platform (defaults
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       handrail template
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newDefaults(!handRa is DBREF)

  -- sets the criteria
  !this.setCriteria()

  -- sets the reference to the central template
  !this.setSettingReference()

  -- if the dbref is part of the current standard use it, otherwise take the first best of the standard
  !allHandRas = !!aslCentralData.currSetting.collectAll('HANDRA')
  if ( !allHandRas.findFirst(!handRa).set() ) then
    !handRaTmpl = !handRa
  else
    !handRaTmpl = !allHandRas.first()
  endif

  -- selects the templates
  !this.setTmplReference(!handRaTmpl)

  -- set the default values
  !this.setDefaults()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      remGates
--
-- Description: removes gates from the gate stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       indices of gates
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .remGates(!gateIndices is ARRAY)

  do !gateIdx value !gateIndices
    !gate = !this.handRaData.gates[!gateIdx]
    !this.handRaData.gates.deleteFrom(!gateIdx, 1)
  enddo
  !this.handRaData.gates.compress()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      replaceGate
--
-- Description: replaces an existing gate by a new one
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GATE        gate
--    2   R      REAL        gate index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .replaceGate(!gate is GATE, !gateIdx is REAL)

  !this.handRaData.gates[!gateIdx] = !gate

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      replaceGate
--
-- Description: replaces an existing gate by a new one
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    gate position
--    2   R      REAL        gate index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .replaceGate(!position is POSITION, !gateIdx is REAL)

  !gate                            = !this.evaluateGate(!position)
  !this.handRaData.gates[!gateIdx] = !gate

endmethod
-- End of method

