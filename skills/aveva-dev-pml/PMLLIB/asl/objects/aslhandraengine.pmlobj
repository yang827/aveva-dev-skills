------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: reads the data from db
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        reference element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  !this.handRaData.updateDataObj(!refe)

  !this.handRaCriteriaBasis = !!aslCentralData.getCriteriaSet(!this.handRaData.settingReference, 'ASLHANDRACRITERIA')

  !this.mergeCriteria()

endmethod
-- End of method
