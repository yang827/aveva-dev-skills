--
-- Description:     Object to hold all HANDRAIL data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addToAidNumbers()                -
--  alignGate(REAL,REAL)             -                   align gate with start/endpoint of whole segment
--  area(REAL)                       -                   set area value
--  aslHandrail()                    -
--  aslHandrail(DBREF)               -
--  aslHandrail(STRING)              -                   Constructor
--  autoDraw()                       ASLHANDRAIL
--  autoDrawOff()                    -                   set autoDraw flag off
--  autoDrawOn()                     -                   set autoDraw flag on
--  autoDrawOn(REAL)                 -                   set autoDraw flag on and set aidnumber only
--  autoDrawOn(REAL,ANY,ANY)         -                   set autoDraw flag on and set number linetype and colour
--  autoOffset()                     -
--  build(ANY,STRING)                -                   build handrail on given side of passed stair flight
--  build(ANY,STRING,DBREF)          -                   build handrail on given side of passed stair flight with given template ref.
--  build(ARRAY)                     -                   build handrail based on passed vertex positions (type is defaulted to POINTR, detail to current bradius value)
--  build(ARRAY,ARRAY,ARRAY)         -                   build handrail based on passed vertices in usual format - array of type, position, data
--  build(ARRAY,ARRAY,ARRAY,ARRAY)   -                   build handrail based on passed vertices in usual format - array of type, position, data, sigref
--  closeFlag()                      BOOLEAN             get closeFlag value - if less then three vertices ignore actual value and return always false
--  closeFlag(BOOLEAN)               -
--  collection(ANY,ANY,ANY)          ARRAY               collect items from db
--  collection(ANY,DBREF)            ARRAY               collect items from db
--  deleteVertex(REAL)               -                   remove vertex from object including preceding and adjacent edge and rebuild object
--  deleteVertices(ARRAY)            -                   delete vertices between start and end index inclusive then rebuild object
--  description(STRING)              -                   set description
--  detail()                         ARRAY               return detail vertex array of ASLRPATH object
--  draw(REAL,REAL,REAL)             ASLHANDRAIL         draw the handrail as aid graphic using explicit pen colour and linetype
--  enhance()                        -                   enhances the element
--  eq(ASLHANDRAIL)                  BOOLEAN             compare equality of two objects
--  extendGateEnd(REAL,REAL)         -
--  extendGateStart(REAL,REAL)       -
--  gatePosition(REAL)               POSITION            returns position of gate of passed index
--  gatePosition(REAL,POSITION)      ASLHANDRAILMEMB
--  gateWidth(REAL,REAL)             -
--  gatesGadget()                    -                   Update gate gadget with current value
--  getActualXoffset(DBREF)          REAL                get actual xoffset from posts or panels
--  getBox(DBREF)                    ARRAY               return oriented volumetric box of db where each side is PROFILE object
--  getJustification(DBREF)          STRING              return justification of handrail on stair stringer
--  getKickplates()                  ARRAY
--  getPanels(REAL)                  ARRAY               calculate panels for segment starting on vertex number passed
--  getPosts()                       ARRAY
--  getPosts(REAL)                   ARRAY
--  getProfile(ARRAY)                PROFILE             compose profile from array of positions
--  getRails()                       ARRAY               calculate rails
--  getRemovedRef(STRING)            DBREF               remove dbreference from registry of deleted members and return it
--  getSpools()                      ARRAY               calculate spools for rails or kickplates (divided by gates) as array of from/to pointers
--  getTemplates()                   ARRAY               get list of rail templates available in current context
--  getTerminationTmpl(DBREF)        ARRAY               get list of terminations from passed HR template
--  getXoffset()                     REAL                get proper value of xoffset inclination
--  insertGate(ASLHANDRAILMEMB,REAL,LINE,POSITION) ASLHANDRAILMEMB
--  insertGate(POSITION)             ASLHANDRAILMEMB
--  insertGate(POSITION,REAL)        ASLHANDRAILMEMB
--  insertMembers(ARRAY,ARRAY)       -                   insert array of handrail members into existing members so that the actual order is maintained
--  insertPoints(REAL,ARRAY)         ARRAY               insert array of POINTR/CURVE into object
--  insertSegment(REAL,ANY,DBREF)    ARRAY               insert new handrail segment after passed vertex of rpath
--  insertVertex(STRING,REAL,POSITION,ANY,DBREF) REAL
--  insertVertices(REAL,ANY,STRING)  ARRAY               insert vertices along passed stairs after passed vertex
--  insertVertices(REAL,ARRAY)       ARRAY               insert vertices after passed vertex in usual format - position array
--  insertVertices(REAL,ARRAY,ARRAY,ARRAY) ARRAY               insert vertices after passed vertex in usual format - array of type, position, data
--  insertVertices(REAL,ARRAY,ARRAY,ARRAY,ARRAY) ARRAY               insert vertices in usual format - array of type, position, data, sigref
--  isPanelised(DBREF)               BOOLEAN             return true if passed handrail is built up from panels only
--  kickplTemplate(DBREF)            DBREF               get kickplate from template
--  lastVertex()                     REAL
--  loadPoints(ARRAY)                -                   load array of POINTR/CURVE into object
--  merge(ASLHANDRAIL)               ASLHANDRAIL         merge two handrails
--  mergeCriteria()                  -                   merges central standard with fabricator standard
--  modifyVertex(REAL,ANY,ANY)       -                   modifies vertex position and detail attribute and rebuild preceding and consecutive posts
--  moveGate(REAL,REAL)              -
--  movePost(REAL,POSITION)          -
--  name(STRING)                     -                   check the passed name and set it if unique
--  nextCorner(REAL)                 REAL                return index of next non-gate vertex from passed index
--  number(REAL)                     -                   set number value
--  openSegment(REAL)                -                   make segment ending on passed vertex index open
--  orientation(ORIENTATION)         -                   set handrail orientation and recalculate rpath
--  panelCriteria()                  -                   get and sort panel criteria and sort panel templates accordingly
--  panelTemplate(DBREF)             ARRAY               get panels from template
--  panels()                         -                   calculate panels for whole handrail
--  panelsOnCurvedSegment(REAL,ARC)  ARRAY               compute panels on curved segment of handrail
--  position(POSITION)               -                   set handrail position and reposition rpath as well
--  postSpacing(STRING,REAL)         -                   set post spacing value and recalculate the posts
--  postTemplate(DBREF)              DBREF               get post from template
--  prevCorner(REAL)                 REAL                return index of previous non-gate vertex from passed index
--  radius(REAL)                     -                   set bend radius
--  railSpacing(ARRAY)               -
--  railSpacingGadget(BOOLEAN)       -                   update gadget with current values and set editable status
--  railTemplate(DBREF)              ARRAY               get rails from template
--  rebuild()                        -                   rebuild all posts, rails and kickplates
--  remFromAidNumbers()              -
--  removeGate(REAL)                 ASLHANDRAILMEMB     remove gate with passed index as well as associated vertices
--  removeGeometry()                 -                   remove geometry completely
--  removeKickplates()               -                   remove all kickplates and store dbrefs if set
--  removePanels()                   ARRAY               remove all panels
--  removePanels(REAL)               ARRAY               remove all panels with posref equal to passed value
--  removePosts()                    ARRAY               remove all posts
--  removePosts(REAL)                ARRAY               remove all posts with posref equal to passed value
--  removeRails()                    -                   remove all rails and store dbrefs if set
--  removeVertex(REAL)               ARRAY
--  rotate(REAL)                     -                   rotate handrail about Z axis through its position by passed value
--  roundDown(REAL)                  REAL                Round down a value to nearest 1mm or 1/32 inch
--  selectPanel(REAL)                DBREF               select panels template based on length
--  setGadget(STRING,GADGET)         -
--  setGadget(STRING,GADGET,STRING)  -
--  setGadgetActiveStatus(GADGET,BOOLEAN) -                   set active status of the gadget
--  setTerminationGadgets(GADGET,GADGET) ARRAY               set the references to start/end termination gadget and return list of templates
--  setTmplrefGadget(GADGET)         ARRAY
--  settingReference(STRING)         -
--  shiftOffset()                    -                   shift offset inclination
--  showVolFeedback()                -                   draws the element with aid lines
--  sortGates()                      ARRAY               sort gates order based on posref and update sequence numbers
--  split(POSITION,REAL)             ASLHANDRAIL         split ASLHANDRAIL object into two - must be performed on already existing db element (DB is modified)
--  splitRail(DBREF)                 -                   split single rail(s) that collide with passed db item. Db handrail must already exist.
--  terminationTmpl(STRING,DBREF,STRING) -                   set termination template for passed end
--  terminationUpdateDb(STRING)      -                   update the handrail termination for passed end in database
--  tmplReference(DBREF)             -
--  trackStrflt(ANY,STRING)          ARRAY               return routing points along left or right side of passed stair flight
--  transformPos(POSITION,ORIENTATION) POSITION
--  type()                           ARRAY               return type of vertex array of ASLRPATH object
--  unEnhance()                      -                   unenhance the element
--  undoCall(STRING)                 -                   set undoable flag as well as undo/redo callback
--  updateDb()                       DBREF
--  updateGadget(GADGET,ANY)         -
--  updateGeometry()                 REAL                update handrail geometry - align each vertex with its sigref (if any) and then rebuild handrail
--  updatePosrefs(ARRAY,ARRAY)       -                   update posref staref and endref of all handrail members
--  updateSequence(ARRAY)            -                   update sequence number of passed members (array)
--  updateTerminationGadget(GADGET,ARRAY) -
--  updateTmplrefGadget(ARRAY)       -
--  vertex()                         ARRAY               return vertex array of ASLRPATH object
--  vertexIsGate(REAL)               BOOLEAN             returns true if vertex is startpoint or endpoint of the gate otherwise false
--  vertexIsGateEnd(REAL)            BOOLEAN             returns true if vertex is endpoint of the gate otherwise false
--  vertexIsGateStart(REAL)          BOOLEAN             returns true if vertex is startpoint of the gate otherwise false
--  xoffset(REAL)                    -                   change an offset inclination
--

-- Object definition
define object ASLHANDRAIL

  --  members

  -- general attributes
  member .name                 is STRING
  member .description          is STRING
  member .area                 is REAL
  member .number               is REAL

  -- position
  member .position             is POSITION

  -- orientation
  member .orientation          is ORIENTATION

  -- contains all gates
  member .gates                is ARRAY

  -- all kickplates
  member .kickplates           is ARRAY

  -- control of creation of kick plates on stairs
  member .kickplatesOnStairs   is BOOLEAN

  -- all posts
  member .posts                is ARRAY

  -- all rails
  member .rails                is ARRAY

  -- all panels
  member .panels               is ARRAY

  -- reference
  member .refe                 is DBREF

  -- rpath reference
  member .rpathref             is DBREF

  -- routing
  member .rpath                is ASLRPATH

  -- post spacing
  member .postSpacing          is REAL

  -- tangent spacing
  member .tangentSpacing       is REAL

  -- end spacing
  member .endSpacing           is REAL

  -- rail spacing
  member .railSpacing          is ARRAY

  -- radius
  member .radius               is REAL

  -- offset inclination (1 or -1) not the offset value itself
  member .xoffset              is REAL

  -- enable xoffset to be shifted automatically
  member .autoOffset           is BOOLEAN

  -- links to the setting and standards
  member .settingReference     is STRING
  member .standard             is DBREF
  member .subStandard          is DBREF

  -- reference to the template
  member .tmplReference        is DBREF

  -- close flag
  member .closeFlag            is BOOLEAN

  -- controls if the object uses the undo functionality
  member .undoable             is BOOLEAN

  -- undo/redo callback (full object name if callback is a method - to be called externally)
  member .undoCall             is STRING

  -- auto updateDB on/off
  member .autoUpdateDb         is BOOLEAN

  -- controls if railspacing can be changed
  member .railSpacingEditable  is BOOLEAN

  -- contains the local criteria set for handrail elements (including fabricator standard)
  member .criteria             is ASLHANDRACRITERIA

  -- contains the default criteria set for handrail elements (excluding fabricator standard)
  member .criteriaBasis        is ASLHANDRACRITERIA

  -- if handrail is made from panels only
  member .isPanelised          is BOOLEAN

  -- material reference
  member .matref               is DBREF

  -- handrail termination
  member .startTermination     is STRING
  member .startTerminationRef  is DBREF
  member .startTerminationTmpl is DBREF
  member .endTermination       is STRING
  member .endTerminationRef    is DBREF
  member .endTerminationTmpl   is DBREF

  -- storage of handrail member templates
  member .postTemplate         is DBREF
  member .panelTemplate        is ARRAY
  -- panel criteria set
  member .panelCriteria        is ARRAY

  -- registry of removed members to repeat refno
  member .removedPosts         is ARRAY
  member .removedGates         is ARRAY
  member .removedPanels        is ARRAY
  member .removedRails         is ARRAY
  member .removedKickplates    is ARRAY

  -- aid graphic attributes
  member .autoDraw             is BOOLEAN
  member .drawGates            is BOOLEAN
  member .aidNumber            is REAL
  member .aidColour            is REAL
  member .aidLinetype          is REAL
  member .aidColourGates       is REAL
  member .aidLinetypeGates     is REAL

  -- gadget links
  member .postSpacingGadget    is GADGET
  member .endSpacingGadget     is GADGET
  member .tangentSpacingGadget is GADGET
  member .railSpacingGadget    is GADGET
  member .closeFlagGadget      is GADGET
  member .tmplReferenceGadget  is GADGET
  member .startTerminationTmplGadget is GADGET
  member .endTerminationTmplGadget is GADGET
  member .gatesGadget          is GADGET
  member .gatesControl         is STRING
  member .radiusGadget         is GADGET
  member .nameGadget           is GADGET
  member .descriptionGadget           is GADGET
  member .numberGadget           is GADGET
  member .areaGadget           is GADGET

endobject
-- End of object definition for Criterion


------------------------------------------------------------------------
--
-- Method:      aslhandrail
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslHandrail()

  -- set defaults
  !this.closeFlag = false
  !this.gates.clear()
  !this.rails.clear()
  !this.posts.clear()
  !this.kickplates.clear()
  !this.rpath.aslrpath()
  !this.postSpacing = REAL()
  !this.radius = REAL()
  !this.position = e 0 n 0 u 0 wrt /*
  !this.orientation = Y is N wrt /* and Z is U wrt /*
  !this.autoUpdateDb = false
  !this.undoable = false
  !this.isPanelised = false
  !this.name = ''
  !this.number = 0
  !this.area = 0
  !this.description = ''
  !this.kickplatesOnStairs = true

  -- termination
  !this.startTermination = 'NONE'
  !this.endTermination = 'NONE'

  -- inside/outside offset inclination
  !this.autoOffset = false
  !this.xoffset = 1

  -- clear deleted refno registry
  !this.removedPosts.clear()
  !this.removedGates.clear()
  !this.removedRails.clear()
  !this.removedKickplates.clear()
  !this.removedPanels.clear()

  -- set aid graphic defaults
  !tty = istty
  if !tty.not() then
    !dfltCol = !!gphColopt.aids.code
    !this.aidColour = !dfltCol
    !this.aidColourGates = !dfltCol
  endif
  !this.autoDraw = false
  !this.drawGates = false
  !this.aidLinetype = 1
  !this.aidLinetypeGates = 3

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      aslhandrail
--
-- Description: Constructor - loads already existing handrail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Handrail to be load
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslHandrail(!handrail is DBREF)

  -- check type
  if !handrail.type.neq('HANDRA') then
      return error 1 'You must be at HANDRA or below'
  endif

  -- avoid HANDRA assembly template below APPDAR
  if !handrail.ahlis.find('APPLDA').set() then
    return error 2 'HANDRA $!handrail.name is the assembly template and cannot be modified this way!'
  endif

  !this.aslHandrail()

  -- get routing
  !this.rpath = object ASLRPATH(!handrail,'load')
  handle ANY
  endhandle

  -- read data from DB
  !this.refe           = !handrail
  if !handrail.isNamed then
    !this.name         = !handrail.name
  endif

  !this.description = !handrail.desc
  !this.number = !handrail.numb
  !this.area = !handrail.area

  !this.rpathref       = !!dtbMemberOfType(!handrail,'RPATH',1)
  handle ANY
    !this.rpathref = nulref
  endhandle
  !this.postSpacing    = !handrail.postSpacing
  !this.tangentSpacing = !handrail.tangOffset
  !this.endSpacing     = !handrail.ePostOffset
  !this.radius         = !handrail.bradius
  !this.closeFlag      = !handrail.closeFlag
  !this.orientation    = !handrail.ori.wrt(world)
  !this.position       = !handrail.pos.wrt(world)
  !this.matref         = !handrail.matref

  -- get template and setting references
  !settingReference = !this.refe.func
  !tmplReference     = !this.refe.asstmpref
  handle ANY
    !tmplReference = nulref
  endhandle

  if !tmplReference.badref() then
    return error 1 'Template reference not set. Contact your ASL administrator'
  endif

  -- set template and setting reference
  !this.tmplReference = !tmplReference
  !this.postTemplate = !this.postTemplate(!tmplReference)
  !this.panelTemplate = !this.panelTemplate(!tmplReference)
  !this.settingReference(!settingReference)
  !this.mergeCriteria()

  !this.isPanelised = !this.isPanelised(!tmplReference)
  if !this.isPanelised then
    !this.panelCriteria()
  endif

  -- rail spacing - special case
  -- get spacing from template
  !current = !this.railTemplate(!handrail)
  !template = !this.railTemplate(!this.tmplReference)
  !tmplref = ARRAY()
  !railspre = ARRAY()
  if !template.unset() then
  -- no rails within template - get spacing from current handrail
    if !current.unset() then
    -- no rails within current handrail - get it from attribute
      !this.railSpacing = !handrail.railHeight.sort()
    else
    -- use spacing from handrail
      !this.railSpacing = !current[2].sort()
    endif
    -- compose unset template and spec.ref. array
    do !c indices !this.railSpacing
      !tmplref.append(nulref)
      !railspre.append(nulref)
    enddo
  else
  -- use spacing from template
    !newindcs = !template[2].sortedIndices()
    !template[1].reindex(!newindcs)
    !template[2].reindex(!newindcs)
    !this.railSpacing = !template[2]
    -- compose array of templates and spec.refs.
    !tmplref = !template[1]
    !railspre = !tmplref.evaluate(object BLOCK('!tmplref[!evalindex].spref'))
  endif

  -- update railspacing gadget value and editable status
  !this.railSpacingGadget(!template.unset().and(!this.isPanelised.not()))

  -- get templates
  !postmpl = !this.postTemplate(!this.tmplReference)
  !kicktmpl = !this.kickplTemplate(!this.tmplReference)

  -- collect all handrail gates
  !gates = !this.collection('HRGATE',!handrail)
  do !gateref values !gates
    !gate = object ASLHANDRAILMEMB(!gateref)
    handle 1
    -- GATE has unset posref
      !this.removedGates.append(!gateref)
      skip
    endhandle
    !this.gates.append(!gate)
  enddo
  -- sort gates by posref
  !this.sortGates()

  -- collect all posts
  !posts = !this.collection('HRPOST',!handrail)
  do !postref values !posts
    !post = object ASLHANDRAILMEMB(!postref,!postmpl)
    handle ANY
    -- POST has unset posref
      !this.removedPosts.append(!postref)
      skip
    endhandle
    !this.posts.append(!post)
  enddo

  -- collect all rails
  !rails = !this.collection('RAIL',!handrail)
  do !railref values !rails
    !railtmpl = nulref
    !gettmplindex = !this.railSpacing.findfirst(!railref.zoffs)
    if !gettmplindex.unset() then
      !gettmplindex = !railspre.findfirst(!railref.spre)
      if !gettmplindex.set() then
        !railtmpl = !tmplref[!gettmplindex]
      endif
    else
      !railtmpl = !tmplref[!gettmplindex]
    endif
    !rail = object ASLHANDRAILMEMB(!railref,!railtmpl)
    -- if endref is unset then set it to last vertex
    if !rail.endref.unset() then
      if !this.closeFlag then
        !rail.endref = 1
      else
        !rail.endref = !this.rpath.vertex.maxIndex()
      endif
    endif
    !this.rails.append(!rail)
  enddo

  -- collect all kick plates
  !kickplates = !this.collection('KICKPL',!handrail)
  do !kickplref values !kickplates
    !kickpl = object ASLHANDRAILMEMB(!kickplref,!kicktmpl)
    -- if endref is unset then set it to last vertex
    if !kickpl.endref.unset() then
      if !this.closeFlag then
        !kickpl.endref = 1
      else
        !kickpl.endref = !this.rpath.vertex.maxIndex()
      endif
    endif
    !this.kickplates.append(!kickpl)
  enddo

  -- collect all panels
  !panels = !this.collection('HRPANE',!handrail)
  do !panelref values !panels
    !panel = object ASLHANDRAILMEMB(!panelref)
    handle ANY
    -- PANEL has unset posref
      !this.removedPanels.append(!panelref)
      skip
    endhandle
    !this.panels.append(!panel)
  enddo

  -- get xoffset inclination from first member with non-zero offset
  !xoffset = 0
  if !this.posts.set() then
    !member = !this.posts[1]
    !xoffset = !member.xoffset()
  endif
  if !xoffset.eq(0).and(!this.panels.set()) then
    !member = !this.panels[1]
    !xoffset = !member.xoffset()
  endif
  if !xoffset.eq(0).and(!this.rails.set()) then
    !member = !this.rails[1]
    !xoffset = !member.xoffset()
  endif
  if !xoffset.eq(0).and(!this.kickplates.set()) then
    !member = !this.kickplates[1]
    !xoffset = !member.xoffset()
  endif
  if !xoffset.neq(0) then
    !this.xoffset = !member.xoffset
  endif

  -- termination
  if !this.closeFlag.not().and(!this.isPanelised.not()) then
    -- start HR termination
    !terminationOnStart = !this.collection('HRTERM','func eq ''START''',!handrail)
    if !terminationOnStart.set() then
      !this.startTermination = 'DETAIL'
      !this.startTerminationRef = !terminationOnStart[1]
      !this.startTerminationTmpl = !terminationOnStart[1].asstmp
    else
      if !this.posts.set() then
        if !this.posts.first().zdis.eq(0) then
          !this.startTermination = 'POST'
        endif
      endif
    endif

    -- end HR termination
    !terminationOnEnd = !this.collection('HRTERM','func eq ''END''',!handrail)
    if !terminationOnEnd.set() then
      !this.endTermination = 'DETAIL'
      !this.endTerminationRef = !terminationOnEnd[1]
      !this.endTerminationTmpl = !terminationOnEnd[1].asstmp
    else
      if !this.posts.set() then
        if !this.posts.last().position.eq(!this.vertex().last()) then
          !this.endTermination = 'POST'
        endif
      endif
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aslHandrail
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Setting reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslHandrail(!setting is STRING)

  !this.aslHandrail()

  -- sets the setting reference
  !this.settingReference(!setting)

  -- get handrail templates
  !tmplref = !this.getTemplates()

  -- apply first template available
  !this.tmplReference(!tmplref[1])

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      tmplreference
--
-- Description: set template reference
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       handrail template reference
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .tmplReference(!tmplReference is DBREF)

  !this.isPanelised = !this.isPanelised(!tmplReference)
  !this.postTemplate = !this.postTemplate(!tmplReference)
  !this.panelTemplate = !this.panelTemplate(!tmplReference)

  !startTerm = !this.startTermination
  if !startTerm.eq('DETAIL') then
    !startTermDesc = !this.startTerminationTmpl.desc
  else
    !startTermDesc = ''
  endif
  !endTerm = !this.endTermination
  if !endTerm.eq('DETAIL') then
    !endTermDesc = !this.endTerminationTmpl.desc
  else
    !endTermDesc = ''
  endif

  -- set tmpl ref.
  !this.tmplReference = !tmplReference

  -- set start/end termination
  !termTmpl = !this.getTerminationTmpl(!this.tmplReference)
  !startTermTmpl = nulref
  !endTermTmpl = nulref
  !startTermTmplList = ARRAY()
  !endTermTmplList = ARRAY()
  if !startTermDesc.empty().not() then
    if !termTmpl.set() then
      !startTermTmplList = !this.collection('HRTERM','desc eq ''' & !startTermDesc & '''',!termTmpl)
    endif
    if !startTermTmplList.set() then
      !startTermTmpl = !startTermTmplList[1]
    else
      !startTerm = 'NONE'
    endif
  endif
  if !endTermDesc.empty().not() then
    if !termTmpl.set() then
      !endTermTmplList = !this.collection('HRTERM','desc eq ''' & !endTermDesc & '''',!termTmpl)
    endif
    if !endTermTmplList.set() then
      !endTermTmpl = !endTermTmplList[1]
    else
      !endTerm = 'NONE'
    endif
  endif

  if !this.isPanelised then
    !this.panelCriteria()
    !this.rpath.radius(0)
  else
    !this.rpath.radius(!this.radius)
  endif

  -- get the values for the handrail from the substandard
  !this.mergeCriteria()

  -- store post spacing to be checked later if changed
  !oldSpacing[1] = !this.postSpacing
  !oldSpacing[2] = !this.endSpacing
  !oldSpacing[3] = !this.tangentSpacing

  if !this.refe.unset() then
  -- handrail is not created yet
    if !this.postSpacing.unset() then
    -- object has been just created so get defaults from ASLHANDRACRITERIA object
      !this.endSpacing     = !this.criteria.endSpacing.optimum()
      !this.tangentSpacing = !this.criteria.tangentSpacing.optimum()
      !this.postSpacing    = !this.criteria.postSpacing.optimum()
      !this.radius         = !this.criteria.bradius.optimum()
    endif
    -- try to get settings from template
    if !tmplReference.ePostOffset.gt(0) then
      !this.endSpacing = !tmplReference.ePostOffset
    endif
    if !tmplReference.tangOffset.gt(0) then
      !this.tangentSpacing = !tmplReference.tangOffset
    endif
    if !tmplReference.postSpacing.gt(0) then
      !this.postSpacing = !tmplReference.postSpacing
    endif
    if !tmplReference.bradius.boolean() then
      !this.radius = !tmplReference.bradius
    endif
    -- set default railspacing
    !this.railSpacing = !this.criteria.railSpacing()
  endif

  -- compose new post spacing values to be compared to old ones
  !newSpacing[1] = !this.postSpacing
  !newSpacing[2] = !this.endSpacing
  !newSpacing[3] = !this.tangentSpacing

  -- check if there are some rails within template
  !railtmpl = !this.railTemplate(!tmplReference)
  if !railtmpl.unset() then
  -- no rails within template - try to get railspacing from template attributes
     if !tmplReference.railHeight.set() then
       !this.railSpacing = !tmplReference.railHeight
     endif
  else
  -- use spacing from template
    !this.railSpacing = !railtmpl[2].sort()
  endif

  -- set active status of gadgets
  !this.setGadgetActiveStatus(!this.postSpacingGadget,!this.isPanelised.not())
  !this.setGadgetActiveStatus(!this.endSpacingGadget,!this.isPanelised.not())
  !this.setGadgetActiveStatus(!this.tangentSpacingGadget,!this.isPanelised.not())
  !this.setGadgetActiveStatus(!this.radiusGadget,!this.isPanelised.not())

  -- update railspacing gadget value and editable status
  !this.railSpacingGadget(!railtmpl.unset().and(!this.isPanelised.not()))

  -- calculate members if rpath is set
  if !this.rpath.set() then
    !this.posts = !this.getPosts()
    !this.rails = !this.getRails()
    !this.kickplates = !this.getKickplates()
    !this.terminationTmpl('start',!startTermTmpl,!startTerm)
    !this.terminationTmpl('end',!endTermTmpl,!endTerm)
    !this.panels()
  else
    !this.terminationTmpl('start',!startTermTmpl,!startTerm)
    !this.terminationTmpl('end',!endTermTmpl,!endTerm)
  endif

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

  -- draw handrail
  !this.autoDraw()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      terminationUpdateDb
--
-- Description: update the handrail termination for passed end in database
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      handrail end (start/end)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .terminationUpdateDb(!whichEnd is STRING)

  if !this.closeFlag().or(!this.isPanelised).or(!this.rpath.unset()) then
    return
  endif

  !end = !whichEnd.upcase()
  -- retrieve data from object
  !type = !this.attribute(!end.upcase() + 'TERMINATION')
  if !type.eq('NONE').or(!type.eq('POST')) then
    return
  endif

  !ref = !this.attribute(!end + 'TERMINATIONREF')
  !tmpl = !this.attribute(!end + 'TERMINATIONTMPL')

  if !ref.badref() then
    if !end.eq('START') then
      !!ce = !this.rails.first().owner
      handle ANY
        new RAILSET
      endhandle
    else
      !!ce = !this.rails.last().refe
      handle ANY
        new RAILSET
      endhandle
    endif
    if !ref.unset() then
      new HRTERM
      !ref = !!ce
      !this.attribute(!end + 'TERMINATIONREF') = !ref
    else
      new HRTERM ref $!ref
    endif
  else
    !!ce = !ref
    delete HRTERM memb
  endif

  if !end.eq('START') then
    !posref = !this.rpath.refe.first()
    !bang = 180
    !zdis = 0
    !nextIndx = !this.rpath.nextPointOf(1)
    !frompos = !this.vertex()[!nextIndx]
    !topos = !posref.pos.wrt(world)
  else
    !posrefIndx = !this.rpath.prevPointOf(!this.vertex().maxIndex())
    !posref = !this.rpath.refe[!posrefIndx]
    !bang = 0
    !this.rpath.segment(false)
    !zdis = !this.rpath.segmentLength(!posrefIndx)
    -- make sure the value does not exceed the length of segment
    !zdis = !this.roundDown(!zdis)

    !frompos = !posref.pos.wrt(worl)
    !topos = !this.vertex().last()
  endif
  !dir = !frompos.direction(!topos)
  !tmpPlane = object PLANE(!this.position,!this.orientation)
  !angle = !dir.projected(!tmpPlane).angle(!dir)
  if !frompos.up.gt(!topos.up) then
    !angle = -!angle
  endif

  copy $!tmpl
  -- set attributes
  !!ce.asstmp = !tmpl
  !!ce.func = !end
  !!ce.xoff = !!ce.xoff * !this.xoffset
  !!ce.posref = !posref
  !!ce.bang = !bang
  !!ce.angl = !angle
  --!!ce.zdis = !zdis
  attrib zdis = $!zdis

  -- trim rails
  !railset = 0
  if !this.rails.set() then
    if !end.eq('START') then
      !railset = !this.rails.first().ownerSequ
    else
      !railset = !this.rails.last().ownerSequ
    endif
  endif

  !trim = !tmpl.railTrim
  do !c indices !this.railSpacing
    if undefined(!trim[!c]) then
      !trim.append(0)
    endif
  enddo

  !count = 0
  do !c indices !this.rails
    if !this.rails[!c].ownerSequ.eq(!railset) then
      !sequ = !this.rails[!c].sequ
      !!ce = !this.rails[!c].refe
      !staref = !this.rails[!c].staref
      !endref = !this.rails[!c].endref
      !lastPoint = !this.rpath.size()
      if !end.eq('START') then
        skip if !staref.neq(1)
        !count = !count + 1
        !szdis = !trim[!count]
        !!ce.szdis = !szdis
      elseif !end.eq('END') then
        skip if !endref.neq(!lastPoint)
        !count = !count + 1
        !!ce.ezdis = -!trim[!count]
      endif
    endif
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      terminationTmpl
--
-- Description: set termination template for passed end
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      handrail end (start/end)
--    2   R      DBREF       termination template
--    3   R      STRING      alternative termination if template is nulref (NONE or POST)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .terminationTmpl(!whichEnd is STRING,!template is DBREF,!alttype is STRING)

  -- init
  !end = !whichEnd.upcase()
  if !template.unset() then
    !ttyp = !alttype
    if !ttyp.unset().or(!ttyp.eq('')) then
      !ttyp = 'NONE'
    endif
  else
    !ttyp = 'DETAIL'
  endif

  if !end.eq('START') then
    !posref = 1
  elseif !end.eq('END') then
    !posref = !this.posts.last().posref
    handle ANY
    endhandle
  endif

  !ttypOld = !this.attribute(!end + 'TERMINATION')
  !this.attribute(!end + 'TERMINATION') = !ttyp
  !this.attribute(!end + 'TERMINATIONTMPL') = !template

  -- reset szdis and ezdis of rails to zero
  if !ttyp.eq('POST').or(!ttyp.eq('NONE')).and(!ttypOld.eq('DETAIL')).and(!this.rails.set()) then
    if !end.eq('START') then
      !railset = 1
    else
      !railset = !this.rails.last().ownerSequ
    endif
    do !c indices !this.rails
      if !this.rails[!c].ownerSequ.eq(!railset) then
        if !end.eq('START') then
          !this.rails[!c].szdis = 0
        else
          !this.rails[!c].ezdis = 0
          !this.rails[!c].epkdis = 0
        endif
      endif
    enddo
  endif

  if !this.posts.set().and(!ttyp.eq('POST').or(!ttypOld.eq('POST'))) then
    -- update rpath segments to speed up calculation of posts
    !this.rpath.segment(!this.closeFlag())
    !this.removePosts(!posref)
    !newPosts = !this.getPosts(!posref)
    !this.insertMembers(!newPosts, !this.posts)
    !this.posts.compress()
    !this.updateSequence(!this.posts)
    -- draw handrail
    !this.autoDraw()
  endif

  if !this.panels.set().and(!ttyp.eq('POST').or(!ttypOld.eq('POST'))) then
    -- rebuild panels
    !this.panels()
  endif

  if !this.autoUpdateDb then
    -- create/update db counterpart
    !this.updateDb()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getTerminationTmpl
--
-- Description: get list of terminations from passed HR template
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       handrail template
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       list of dbrefs
--
------------------------------------------------------------------------

define method .getTerminationTmpl(!template is DBREF) is ARRAY

  !listOfTmpl = !this.collection('HRTERM',!template)

  return !listOfTmpl

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      merge
--
-- Description: merge two handrails that must exist in db
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      ASLHANDRAIL    object to be merged
--
-- Return:
--   [Data Type]   [Description]
--    ASLHANDRAIL   merged handrail
--
------------------------------------------------------------------------

define method .merge(!handrail is ASLHANDRAIL) is ASLHANDRAIL

  -- copy passed object
  !merged = !handrail
  !newRail = !this

  if !newRail.closeFlag.or(!merged.closeFlag) then
    return error 1 'Cannot merge handrails that are not open.'
  endif

  -- merge rpaths of both handrails
  !newRail.rpath = !newRail.rpath.merge(!merged.rpath)

  -- remove redundant vertices from new part that are on the edge (i.e. not corner making)
  !lastVertex = !newRail.rpath.vertex.maxIndex()
  !newRail.rpath.mergeVertices(1,!lastVertex)

  -- remove all handrail members
  !newRail.removePosts()
  !newRail.removeRails()
  !newRail.removeKickplates()
  !newRail.removePanels()
  !merged.removePosts()
  !merged.removeRails()
  !merged.removeKickplates()
  !merged.removePanels()

  -- remove and store gates
  !oldGates = !newRail.gates.removeFrom(1)
  do !gate values !oldGates
    !newRail.removedGates.append(!gate.refe)
  enddo

  -- take over refnos from merge handrail
  !newRail.removedPosts.appendarray(!merged.removedPosts)
  !newRail.removedRails.appendarray(!merged.removedRails)
  !newRail.removedKickplates.appendarray(!merged.removedKickplates)
  !newRail.removedPanels.appendarray(!merged.removedPanels)


  -- rebuild handrail
  !newRail.posts = !newRail.getPosts()
  !newRail.panels()
  !newRail.rails = !newRail.getRails()
  !newRail.kickplates = !newRail.getKickplates()

  -- reproduce gates from this handrail
  do !gate values !oldGates
    -- get position
    !gatepos = !gate.refe.position
    -- insert gate
    !newRail.insertGate(!gatepos,!gate.width)
  enddo

  -- reproduce gates from second handrail
  do !gate values !merged.gates
    -- get position of source gate
    !gatepos = !gate.refe.position
    if !gate.refe.set() then
      !newRail.removedGates.append(!gate.refe)
    endif
    -- insert gate into new handrail
    !newRail.insertGate(!gatepos,!gate.width)
  enddo

  -- copy new rail to this
  !this = !newRail
  -- set undo stack
  !undo = object UNDOABLE()
  !undo.description('Split handrail')
  if !newRail.undoCall.set() then
    !undo.undoaction(!newRail.undoCall)
    !undo.redoaction(!newRail.undoCall)
  endif
  !undo.add()

  -- do changes in db
  !!ce = !merged.refe
  delete HANDRA

  !!ce = !this.refe
  !this.updateDb()

  -- end undo
  !undo.endUndoable()

  return !this

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      split
--
-- Description: split ASLHANDRAIL object into two - db counterpart must already exist (DB is modified)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position on split
--
-- Return:
--   [Data Type]  [Description]
--    ASLHANDRAIL  new handrail (second part after split) as ASLHANDRAIL object
--
------------------------------------------------------------------------

define method .split(!splitpos is POSITION,!gapWidth is REAL) is ASLHANDRAIL

  -- init
  !tmp = !this
  !tmp.autoDraw = false
  !tmp.autoUpdateDb = false
  !closeFlag = !this.closeFlag()

  -- get proper segment of rpath and starting vertex index
  !edgearray = !this.rpath.near(!splitpos,!closeFlag)
  if !edgearray.size().eq(0) then
  -- no valid edge found - return error
    return error 1 'Invalid POSITION to split the handrail'
  endif

  !edge = !edgearray.first()
  !index = !edgearray.minindex()
  !projpos = !edge.near(!splitpos)

  -- check if split position is not within gates
  do !gate values !this.gates
    if !index.eq(!gate.posref) then
      return error 1 'Cannot split HANDRAIL within the GATE.'
    endif
  enddo

  -- store gates before remove them
  !beforeSplit = ARRAY()
  !afterSplit = ARRAY()
  do !c indices !tmp.gates
    !gate = !tmp.gates[!c]
    !gate.position = !gate.refe.position
    !tmp.gates[!c].delete()
    if !gate.posref.lt(!index) then
      !beforeSplit.append(!gate)
    elseif !gate.posref.eq(!index) then
      !before = object LINE(!edge.startPosition,!projpos)
      !after  = object LINE(!projpos,!edge.endPosition)
      if !before.onProjected(!projpos) then
        !beforeSplit.append(!gate)
      elseif !after.onProjected(!projpos) then
        !afterSplit.append(!gate)
      endif
    else
      !afterSplit.append(!gate)
    endif
  enddo

  -- create new handrail object
  !new = !tmp
  !new.refe =nulref
  !new.rpathref = nulref
  !new.removedPosts.clear()
  !new.removedRails.clear()
  !new.removedKickplates.clear()
  !new.removedPanels.clear()
  !new.removedGates.clear()


  -- split rpath
  !path = !this.rpath.split(!projpos,!closeFlag,!gapWidth)
  -- assign rpath to tmp object
  !tmp.rpath = !path[1]
  -- assign rpath to new object
  if !path.size().eq(2) then
    !new.rpath = !path[2]
  else
    !tmp.closeFlag = false
  endif

  -- store ref. numbers of the gates
  do !gate values !beforeSplit
    if !gate.refe.set() then
      !tmp.removedGates.append(!gate.refe)
    endif
  enddo
  do !gate values !afterSplit
    if !gate.refe.set() then
      !new.removedGates.append(!gate.refe)
    endif
  enddo

  -- remove members of tmp but store ref. numbers
  !tmp.removePosts()
  !tmp.removePanels()
  !tmp.removeRails()
  !tmp.removeKickplates()

  -- remove members of new object (ref. numbers are not stored)
  !new.posts.clear()
  !new.panels.clear()
  !new.rails.clear()
  !new.kickplates.clear()

  -- reproduce gates
  do !gate values !beforeSplit
    !tmp.insertGate(!gate.position,!gate.width)
  enddo
  if !path.size().eq(1) then
  do !gate values !afterSplit
      !tmp.insertGate(!gate.position,!gate.width)
    enddo
   endif

  -- handle termination
  !tmp.endTerminationRef = nulref
  !new.startTerminationRef = nulref
  !new.endTerminationRef = nulref

  -- start of undoable action
  !undo = object UNDOABLE()
  !undo.description('Split handrail')
  if !tmp.undoCall.set() then
    !undo.undoaction(!tmp.undoCall)
    !undo.redoaction(!tmp.undoCall)
  endif
  !undo.add()

  -- rebuild object
  !tmp.autoUpdateDb = true
  !tmp.rebuild()

  if !path.size().eq(2) then
  -- create new handrail object (second part)
    -- inherit ref. numbers from tmp object
    !new.removedPosts = !tmp.removedPosts.removeFrom(1)
    !new.removedPanels = !tmp.removedPanels.removeFrom(1)
    !new.removedRails = !tmp.removedRails.removeFrom(1)
    !new.removedKickplates = !tmp.removedKickplates.removeFrom(1)
    -- rebuild object
    !!ce = !tmp.refe
    !new.rebuild()
    do !gate values !afterSplit
      !new.insertGate(!gate.position,!gate.width)
    enddo
    !new.updateDb()
  else
    !new = object ASLHANDRAIL()
  endif

  -- end of undoable action
  !undo.endUndoable()

  -- copy modified temporary object to this object
  !this = !tmp

  -- return new handrail
  return !new

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      splitRail
--
-- Description: split single rail(s) that collide with passed db item. Db handrail must already exist.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     DBREF       db item on split
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitRail(!onSplit is DBREF)

  -- init
  !path = !this.rpathref
  !closeFlag = !this.closeFlag()
  !storeCE = !!ce
  !part = REAL()
  !clearance = !this.criteria.splitClearance.optimum()

  -- run clasher
  desclash
    override on
    remove obstruction all
    obstruction all (RAIL) for $!this.refe
    report header off
    report main off
    report summary off
    report graphics off
    report position world
    report HH clash
    check $!onSplit
    var !count clash count clashes
    !nofClash = !count.real()
  exit

  !nofClash = !count.real()
  if !nofClash.eq(0) then
    !!alert.error('Cannot determine intersection between HANDRAIL and picked element.')
    return
  endif

  do !c from 1 to !nofClash
    var !clash  clash $!c second
    var !clashPos clash $!c position
    !rail[!c] = !clash.dbref()
    !pos[!c] = !clashPos.position()
  enddo

  do !c indices !pos
    !tmp = !this.rpath.snap2edge(!pos[!c],!closeFlag)
    !posindx[!c] = !tmp.maxIndex()
    !pos[!c] = !tmp[!posindx[!c]].offset(!this.orientation.zdir(),!rail[!c].zoffs)
  enddo

  -- compose volumetric box
  !box = !this.getBox(!onSplit)

  -- start of undoable action
  !undo = object UNDOABLE()
  !undo.description('Split single rail')
  if !this.undoCall.set() then
    !undo.undoaction(!this.undoCall)
    !undo.redoaction(!this.undoCall)
  endif
  !undo.add()

  do !c indices !rail
     !zdist[1] = REAL()
     !zdist[2] = REAL()
     !dist = 0
     -- get segment and compute intersection with volumetric box
     !segment = !this.rpath.segment[!posindx[!c]]
     do !cc indices !segment
       !part.delete()
       !part = !segment[!cc]
       !objType = !part.objectType()
       -- take ZOFF into account
       if !objType.eq('LINE') then
         !part = !part.offset(!this.orientation.zdir(),!rail[!c].zoffs)
       else
         !part.position = !part.position.offset(!this.orientation.zdir(),!rail[!c].zoffs)
       endif

       -- check all sides of box for intersection with segment
       do !side values !box
         !sidePlane = !side.plane()
         !getdist = REAL()
         if !objType.eq('LINE') then
           !xpos = !sidePlane.intersection(!part)
           handle ANY
             skip
           endhandle
           if !part.onProjected(!xpos).and(!side.isWithin(!xpos)) then
             -- intersection found
             !getdist = !part.startPosition.distance(!xpos) + !dist
           endif
         else
           !xposar = !sidePlane.intersections(!part)
           handle ANY
             skip
           endhandle
           do !xpos values !xposar
             if !part.onProjected(!xpos).and(!side.isWithin(!xpos)) then
               -- intersection found
               !getdist = !part.endPosition(!xpos).length() + !dist
               break
             endif
           enddo
         endif
         if !getdist.set() then
           if !zdist[1].unset() then
             !zdist[1] = !getdist
           else
             !zdist[2] = !getdist
             break
           endif
         endif
       enddo
       break if !zdist[1].set().and(!zdist[2].set())
       !dist = !dist + !part.length()
     enddo

     -- sort distances
     !zdist.sort()
     -- apply clearance
     !zdist[1] = !zdist[1] - !clearance
     !zdist[2] = !zdist[2] + !clearance
      -- split rail
      !!ce = !rail[!c]
      new $!!ce.type copy $!rail[$!c]
      !rail[!c].endref = !path.memb[!posindx[!c]]
      !rail[!c].ezdis = !zdist[1]
      !!ce.staref = !path.memb[!posindx[!c]]
      !!ce.szdis = !zdist[2]
  enddo

  -- end of undoable action
  !undo.endUndoable()

  !!ce = !storeCE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getBox
--
-- Description: return oriented volumetric box of db where each side is PROFILE object - should be a function
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       db item for which the volumetric box will be returned
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       profile array
--
------------------------------------------------------------------------

define method .getBox(!item is DBREF) is ARRAY

  -- init
  !box = ARRAY()

  -- volume data
  var !vol split lvol of $!item wrt $!item

  -- define all corner points
  !vrtx[1] = e $!vol[1] n $!vol[2] u $!vol[3] wrt $!item
  !vrtx[2] = e $!vol[4] n $!vol[2] u $!vol[3] wrt $!item
  !vrtx[3] = e $!vol[4] n $!vol[5] u $!vol[3] wrt $!item
  !vrtx[4] = e $!vol[1] n $!vol[5] u $!vol[3] wrt $!item
  !vrtx[5] = e $!vol[4] n $!vol[5] u $!vol[6] wrt $!item
  !vrtx[6] = e $!vol[1] n $!vol[5] u $!vol[6] wrt $!item
  !vrtx[7] = e $!vol[1] n $!vol[2] u $!vol[6] wrt $!item
  !vrtx[8] = e $!vol[4] n $!vol[2] u $!vol[6] wrt $!item

  -- compose sides
  !point[1] = !vrtx[1]
  !point[2] = !vrtx[2]
  !point[3] = !vrtx[3]
  !point[4] = !vrtx[4]
  !box[1] = !this.getProfile(!point)

  !point[1] = !vrtx[5]
  !point[2] = !vrtx[6]
  !point[3] = !vrtx[7]
  !point[4] = !vrtx[8]
  !box[2] = !this.getProfile(!point)

  !point[1] = !vrtx[2]
  !point[2] = !vrtx[3]
  !point[3] = !vrtx[5]
  !point[4] = !vrtx[8]
  !box[3] = !this.getProfile(!point)

  !point[1] = !vrtx[3]
  !point[2] = !vrtx[4]
  !point[3] = !vrtx[6]
  !point[4] = !vrtx[5]
  !box[4] = !this.getProfile(!point)

  !point[1] = !vrtx[1]
  !point[2] = !vrtx[4]
  !point[3] = !vrtx[6]
  !point[4] = !vrtx[7]
  !box[5] = !this.getProfile(!point)

  !point[1] = !vrtx[1]
  !point[2] = !vrtx[2]
  !point[3] = !vrtx[8]
  !point[4] = !vrtx[7]
  !box[6] = !this.getProfile(!point)

  return !box

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getProfile
--
-- Description: compose profile from array of positions
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       vertices (position array)
--
-- Return:
--   [Data Type] [Description]
--    PROFILE     returned profile
--
------------------------------------------------------------------------

define method .getProfile(!point is ARRAY) is PROFILE

  -- compose position and orientation
  !tmpPlane = !point[1].plane(!point[2],!point[3])
  !pos = !tmpPlane.position
  !ori = !tmpPlane.orientation

  -- compose and return profile
  !shape = object PROFILE(!pos,!ori,!point)
  !shape.close()

  return !shape

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertSegment
--
-- Description: insert new handrail segment after passed vertex of rpath
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index of vertex to be inserted after
--    2   R      ANY         Vertex (POSITION) or edge (LINE,ARC) or array of points in usual format
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       positions of created vertices
--
------------------------------------------------------------------------

define method .insertSegment(!insertAfter is REAL,!segment is ANY,!item is DBREF) is ARRAY

  -- init
  !index = REAL()
  !vertex = ARRAY()
  !type   = ARRAY()
  !detail = ARRAY()
  !sigref = ARRAY()
  !newVertex = ARRAY()
  !objType = !segment.objectType()
  !radius = !this.radius
  if !this.isPanelised then
    !radius = 0
  endif
  !closeFlag = !this.closeFlag

  if !item.badref().not() then
    !pointr = !this.collection('POINTR',object EXPRESSION('type of owner of owner neq ''HANDRA'''),!item)
  else
    !pointr = ARRAY()
  endif
  !pointrPos = !pointr.evaluate(object BLOCK('!pointr[!evalindex].pos.wrt(world)'))
  if !insertAfter.geq(1) then
    !last = !this.rpath.vertex[!insertAfter]
  endif
  if !insertAfter.gt(1) then
    if !this.rpath.type[!insertAfter - 1].eq('POINTR') then
      !lastEdge = object LINE(!this.rpath.vertex[!insertAfter - 1],!last)
    endif
  endif
  if !objType.eq('POSITION') then
    if defined(!lastEdge) then
      if !lastEdge.on(!segment) then
        !lastpos = !segment
      else
        !vertex[1] = !segment.wrt(world)
        !type[1]   = 'POINTR'
        !detail[1] = !radius
      endif
    else
      if defined(!last) then
        if !segment.near(!last,1mm) then
        -- new position is the same as the last vertex position so exit
          return !newVertex
        endif
      endif
      !vertex[1] = !segment
      !type[1]   = 'POINTR'
      !detail[1] = !radius
    endif
  elseif !objType.eq('ARRAY') then
  -- stair flight route has been passed - it MUST be array of arrays with points (position,type,detail)
    -- check whole array
    !errorString = 'Invalid segment passed to method INSERTSEGMENT of object ASLHANDRAIL'
    !objectsInArray = !segment.evaluate(object BLOCK('!segment[!evalindex].objectType()')).sortunique()
    if !objectsInArray.size().eq(1).and(!objectsInArray[1].eq('ARRAY')).not() then
      return error 1 '$!errorString'
    endif
    -- check component [1]
    !objectsInArray = !segment[1].evaluate(object BLOCK('!segment[1][!evalindex].objectType()')).sortunique()
    if !objectsInArray.size().eq(1).and(!objectsInArray[1].eq('STRING')).not() then
      return error 1 '$!errorString'
    endif
    -- check component [2]
    !objectsInArray = !segment[2].evaluate(object BLOCK('!segment[2][!evalindex].objectType()')).sortunique()
    if !objectsInArray.size().eq(1).and(!objectsInArray[1].eq('POSITION')).not() then
      return error 1 '$!errorString'
    endif
    -- check component [3]
    do !c indices !segment[3]
      if !segment[1][!c].eq('POINTR') then
      -- value must be REAL (radius)
        if !segment[3][!c].objectType().neq('REAL') then
          return error 1 '$!errorString'
        endif
      else
      -- value must be array of attribute of CURVE
        if !segment[3][!c].objectType().neq('ARRAY') then
          return error 1 '$!errorString'
        else
        -- check each component of subarray
          if !segment[3][!c][1].objectType().neq('STRING') then
            return error 1 '$!errorString'
          endif
        endif
      endif
    enddo
    !type =!segment[1]
    !vertex = !segment[2]
    !detail = !segment[3]
    !sigref = !segment[4]

    if defined(!last) then
      !start = !vertex[1]
      !end = !vertex.last()
      if !start.distance(!last).gt(!end.distance(!last)) then
      -- invert arrays
        !vertex.invert()
        !type.invert()
        !detail.invert()
        !sigref.invert()
      endif
    else
      -- ask user to decide which way the handrail to be made
      if !!alert.confirm('Do you want handrail to go upward(YES) or downward(NO).').boolean().not() then
      -- invert line array
        !vertex.invert()
        !type.invert()
        !detail.invert()
        !sigref.invert()
      endif
    endif
  elseif !objType.eq('LINE') then
    !segmentLine = !segment
    if defined(!last) then
      !start = !segmentLine.startPosition
      !end   = !segmentLine.endPosition
      !startToLast = !start.distance(!last)
      !endToLast   = !end.distance(!last)
      if !startToLast.gt(!endToLast) then
        !segmentLine.startPosition = !end
        !segmentLine.endPosition = !start
      endif
    endif
    if defined(!lastEdge) then
      if !segmentLine.direction().isParallel(!lastEdge.direction()).not() then
        !intersection = !segmentLine.intersection(!lastEdge)
        !linesIntersect = !segmentLine.on(!intersection).and(!lastEdge.on(!intersection))
      else
        !linesIntersect = false
      endif
      if !linesIntersect then
        !lastpos = !intersection
        !vertex[1] = !segmentLine.endPosition.wrt(world)
        !type[1]   = 'POINTR'
        !detail[1] = !radius
      else
        !vertex[1] = !segmentLine.startPosition.wrt(world)
        !vertex[2] = !segmentLine.endPosition.wrt(world)
        !type[1] = 'POINTR'
        !type[2] = 'POINTR'
        !detail[1] = !radius
        !detail[2] = !radius
      endif
    else
      if defined(!last) then
        if !segmentLine.startPosition.near(!last,1mm).not() then
          !vertex[1] = !segmentLine.startPosition.wrt(world)
          !type[1]   = 'POINTR'
          !detail[1] = !radius
        endif
        !vertex.append(!segmentLine.endPosition.wrt(world))
        !type.append('POINTR')
        !detail.append(!radius)
      else
        !vertex[1] = !segmentLine.startPosition.wrt(world)
        !vertex[2] = !segmentLine.endPosition.wrt(world)
        !type[1] = 'POINTR'
        !type[2] = 'POINTR'
        !detail[1] = !radius
        !detail[2] = !radius
      endif
    endif
  elseif !objType.eq('ARC') then

  endif

  if defined(!lastpos) then
    !this.rpath.vertex[!insertAfter] = !lastpos
  endif

  -- add sigref array to complete definition of vertices
  do !c indices !vertex
    skip if defined(!sigref[!c])
    !pointrIndex = !!findNearestPos(!pointrPos,!vertex[!c],1mm)
    if !pointrIndex.set() then
      !sigref[!c] = !pointr[!pointrIndex]
    else
      !sigref[!c] = nulref
    endif
  enddo

  !newVertex = !this.insertVertices(!insertAfter, !type, !vertex, !detail, !sigref)
  return !newVertex

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadPoints
--
-- Description: load array of POINTR/CURVE into object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       dbref array
--    2   R      STRING      operation mode - "load" or "track"
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadPoints(!points is ARRAY)

  -- init
  !radius = !this.radius
  if !this.isPanelised then
    !radius = 0
  endif

  -- set rpath .ownerType member
  !this.rpath.ownerType = 'HANDRA'

  -- build rpath
  !this.rpath.loadPoints(!points,'track')

  -- apply radius to all points
  !this.rpath.radius(!radius)

  -- remove all existing gates
  !this.gates.clear()

  -- rebuild handrail
  !this.rebuild()

  -- update GATE gadget
  !this.gatesGadget()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertPoints
--
-- Description: insert array of POINTR/CURVE into object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        array index to be inserted after
--    2   R      ARRAY       dbref array
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       indices of new vertices
--
------------------------------------------------------------------------

define method .insertPoints(!insertAfter is REAL, !insertPoints is ARRAY) is ARRAY

  -- init
  !points = !insertPoints
  !points.compress()
  !vertex = ARRAY()
  !type = ARRAY()
  !detail = ARRAY()
  !sigref = ARRAY()
  !newIndex = ARRAY()
  !closeFlag = !this.closeFlag
  !radius = !this.radius
  if !this.isPanelised then
    !radius = 0
  endif

  -- if no point defined in rpath then use loadpoints method
  if !this.vertex().unset() then
    !this.loadPoints(!points)
    return !this.vertex().indices()
  endif

  -- check if first and last inserted point is not coincident with previous and next existing point
  if !insertAfter.gt(0) then
    !last = !this.vertex()[!insertAfter]
    if (!points[1].pos.wrt(world).distance(!last).leq(1mm)) then
      !this.rpath.sigref[!insertAfter] = !points[1]
      !points.remove(1)
    endif
  endif
  if !this.vertex().size().gt(1) then
    !nextVertex = !this.rpath.nextPointOf(!insertAfter)
    if !nextVertex.eq(1).and(!closeFlag.not()).and(!insertAfter.boolean()) then
      !nextVertex.delete()
    else
      !next = !this.vertex()[!nextVertex]
      !nextVertices[1] = !nextVertex
    endif
    if defined(!nextVertex) then
   --   if !points.last().pos.wrt(world).eq(!next) then
      if (!points.last().pos.wrt(world).distance(!next).leq(1mm) ) then
        !this.rpath.sigref[!nextVertex] = !points.last()
        !points.removeLast()
      endif
    endif
  endif

  -- exit if both start/end points are coincident and no other point between them
  if !points.unset() then
    return error 1 'Point(s) or segment(s) already inserted'
  endif

  -- build arrays with vertex data
  do !ref values !points
    !vertex.append(!ref.pos.wrt(world))
    if !ref.type.eq('CURVE') then
      !detail.append(!this.rpath.getCurveAtt(!ref))
      !sigref.append(nulref)
      !type.append(!ref.type)
    else
      !detail.append(!radius)
      !sigref.append(!ref)
      !type.append('POINTR')
    endif
  enddo

  !newVertex = !this.insertVertices(!insertAfter, !type, !vertex, !detail, !sigref)

  !newIndex = !newVertex.indices()

  return !newIndex

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertVertices
--
-- Description: insert vertices along passed stairs after passed vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index the new indices to be inserted after
--    3   R      ANY         stairs - DBEASLSTRFLT or DBREF
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       newly created vertices
--
------------------------------------------------------------------------

define method .insertVertices(!insertAfter is REAL,!stairs is ANY,!side is STRING) is ARRAY

  -- get route data
  !route = !this.trackStrflt(!stairs, !side)

  -- compose arrays
  !type = !route[1]
  !vertex = !route[2]
  !detail = !route[3]
  !sigref = !route[4]

  return !this.insertVertices(!insertAfter, !type, !vertex, !detail, !sigref)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertVertices
--
-- Description: insert vertices after passed vertex in usual format - position array
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index the new indices to be inserted after
--    3   RW     ARRAY       vertex positions
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       newly created vertices
--
------------------------------------------------------------------------

define method .insertVertices(!insertAfter is REAL,!vertex is ARRAY) is ARRAY

  -- compose point type and details arrays
  !type = ARRAY()
  !detail = ARRAY()
  do !c indices !vertex
    !type[!c] = 'POINTR'
    !detail[!c] = 0
  enddo

  return !this.insertVertices(!insertAfter, !type, !vertex, !detail)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertVertices
--
-- Description: insert vertices after passed vertex in usual format - array of type, position, data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index the new indices to be inserted after
--    2   RW     ARRAY       vertex types
--    3   RW     ARRAY       vertex positions
--    4   RW     ARRAY       vertex data
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       newly created vertices
--
------------------------------------------------------------------------

define method .insertVertices(!insertAfter is REAL, !type is ARRAY, !vertex is ARRAY, !detail is ARRAY) is ARRAY

  -- compose sigref array
  !sigref = ARRAY()
  do !c indices !type
    !sigref[!c] = nulref
  enddo

  return !this.insertVertices(!insertAfter, !type, !vertex, !detail, !sigref)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertVertices
--
-- Description: insert vertices after passed vertex in usual format - array of type, position, data, sigref
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index the new indices to be inserted after
--    2   RW     ARRAY       vertex types
--    3   RW     ARRAY       vertex positions
--    4   RW     ARRAY       vertex data
--    5   RW     ARRAY       vertex sigref
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       newly created vertices
--
------------------------------------------------------------------------

define method .insertVertices(!insertAfter is REAL, !type is ARRAY, !vertex is ARRAY, !detail is ARRAY, !sigref is ARRAY) is ARRAY

  -- init
  !removed = ARRAY()
  !newPostsStart = ARRAY()
  !newPostsEnd = ARRAY()
  !newPanelsStart = ARRAY()
  !newPanelsEnd = ARRAY()
  !prevVertices = ARRAY()
  !nextVertices = ARRAY()
  !newIndex = ARRAY()
  !nextVertex = REAL()
  !fromStart = ARRAY()
  !toEnd = ARRAY()
  !closeFlag = !this.closeFlag
  !tmpType = ARRAY()
  !tmpVertex = ARRAY()
  !tmpDetail = ARRAY()
  !tmpSigref = ARRAY()

  -- result array to be returned
  !newVertex = ARRAY()

  -- go through vertices and convert all curves to type THRU
  do !c indices !type
    if !type[!c].eq('CURVE') then
    -- convert CURVE
      !prevpos = !tmpVertex.last()
      handle ANY
        !prevpos = !this.vertex()[!insertAfter]
      endhandle
      !nextpos = !vertex[!c + 1]
      !detail[!c].append(!vertex[!c])
      !convCurve = !this.rpath.anyCurve2Thru(!detail[!c],!prevpos,!nextpos)
      !tmpVertex.appendarray(!convCurve[1])
      !tmpType.appendarray(!convCurve[2])
      !tmpDetail.appendarray(!convCurve[3])
      !tmpSigref.appendarray(!convCurve[4])
    else
    -- just copy POINTR data
      !tmpType.append(!type[!c])
      !tmpVertex.append(!vertex[!c])
      !tmpDetail.append(!detail[!c])
      !tmpSigref.append(!sigref[!c])
    endif
  enddo

  -- copy converted vertices
  !vertex = !tmpVertex
  !type =   !tmpType
  !detail = !tmpDetail
  !sigref = !tmpSigref

  -- correct radius
  !radius = !this.radius
  if !this.isPanelised then
    !radius = 0
  endif
  do !c indices !type
    skip if !type[!c].neq('POINTR')
    !detail[!c] = !radius
  enddo

  -- check vertices against existing
  !existing  = !this.vertex().intersect(!vertex)
  do !vrtxToRemove values !existing
    !index = !vertex.findfirst(!vrtxToRemove)
    !vertex[!index].delete()
    !type[!index].delete()
    !detail[!index].delete()
    !sigref[!index].delete()
  enddo
  !vertex.compress()
  !type.compress()
  !detail.compress()
  !sigref.compress()

  -- merge coincident vertices
  !indxsToRemove = ARRAY()
  do !c indices !vertex
    skip if !type[!c].eq('CURVE')
    !indxs = !vertex.find(!vertex[!c])
    if !indxs.size().gt(1) then
      !indxs.removeFirst()
      do !cc values !indxs
        skip if !type[!cc].eq('CURVE')
        !indxsToRemove.append(!cc)
      enddo
    endif
  enddo
  !indxsToRemove.sortunique()
  !indxsToRemove.invert()
  do !c values !indxsToRemove
    !vertex.remove(!c)
    !type.remove(!c)
    !detail.remove(!c)
    !sigref.remove(!c)
  enddo

  -- return error and exit if no vertex left
  if !vertex.unset() then
    return error 1 'Point(s) or segment(s) already inserted'
  endif

  if !this.vertex().size().gt(1) then
    !nextVertex = !this.rpath.nextPointOf(!insertAfter)
    if !nextVertex.eq(1).and(!closeFlag.not()).and(!insertAfter.boolean()) then
      !nextVertex.delete()
    else
      !nextVertices[1] = !nextVertex
    endif
  endif

  if !insertAfter.boolean() then
    !prevVertices[1] = !insertAfter
  endif
  if !this.vertex().size().gt(1) then
    !prev = !this.rpath.prevPointOf(!insertAfter)
    if !insertAfter.eq(1) then
      if !closeFlag then
        !prevVertices[2] = !prev
      endif
    else
      !prevVertices[2] = !prev
    endif
  endif
  !prevVertices.invert()

  if !prevVertices.set() then
    if !insertAfter.eq(!this.vertex().maxIndex()) then
    -- segment to be inserted after last vertex
      !fromStart = !nextVertices.removeFrom(1)
      !toEnd = !prevVertices.removeFrom(1)
      !action = 'APPEND'
    elseif !insertAfter.eq(1) then
    -- points to be inserted after first vertex
      !fromStart[1] = !prevVertices.removeLast()
      !fromStart.appendarray(!nextVertices.removeFrom(1))
      !toEnd = !prevVertices.removeFrom(1)
      !action = 'INSERTSTART'
    else
    -- points to be inserted somewhere in between
      !toEnd = !prevVertices.removeFrom(1)
      !toEnd.appendarray(!nextVertices.removeFrom(1))
      !action = 'INSERTEND'
    endif
  endif

  if !nextVertices.set() then
  -- points to be inserted before first vertex
    !fromStart = !nextVertices
    !action = 'INSERTSTART'
  endif

  if undefined(!action) then
    !action = 'FIRSTADD'
  endif

  -- remove posts and panels from start
  if !fromStart.set() then
    do !index values !fromStart
      skip if !index.eq(0)
      !this.removePosts(!index)
      !this.removePanels(!index)
    enddo
  endif

  --remove posts and panels from end
  if !toEnd.set() then
    do !index values !toEnd
      skip if !index.eq(0)
      !removed.appendarray(!this.removePosts(!index))
      !this.removePanels(!index)
    enddo
  endif

  -- insert vertices into rpath
  !vertex.invert()
  !type.invert()
  !detail.invert()
  !sigref.invert()
  !index = !insertAfter
  do !c indices !vertex
    !index = !index + 1
    !newIndex.append(!index)
    !this.insertVertex(!type[!c], !insertAfter, !vertex[!c], !detail[!c], !sigref[!c])
  enddo

  -- compose new vertex array
  !vertex.invert()
  do !c indices !newIndex
    !newVertex[!newIndex[!c]] = !vertex[!c]
  enddo

  -- check if rpath is fully defined
  if !this.rpath.unset() then
    return !newVertex
  endif

  -- include new indices to list of indices where posts to be regenerated
  !newIndexSize = !newIndex.size()
  if !action.eq('APPEND') then
    !toEnd.appendarray(!newIndex)
  elseif !action.eq('INSERTSTART') then
    !insertAt = !insertAfter + 1
    !fromStart.insertarray(!insertAt,!newIndex)
    -- update arrays of concerned indices
    do !c from (!insertAt + !newIndexSize) to !fromStart.maxIndex()
      !fromStart[!c] = !c
    enddo
    do !c indices !toEnd
      !toEnd[!c] = !toEnd[!c] + !newIndexSize
    enddo
  elseif !action.eq('INSERTEND') then
    !insertAt = !toEnd.findfirst(!insertAfter) + 1
    !toEnd.insertarray(!insertAt,!newIndex)
    do !c from (!insertAt + !newIndexSize) to !toEnd.maxIndex()
      !toEnd[!c] = !toEnd[!c] + !newIndexSize
    enddo
  endif

  if !this.vertex().size().leq(2).or(!action.eq('FIRSTADD')) then
  -- rebuild posts and panels completely
    !this.posts = !this.getPosts()
    !this.panels()
  else
  -- rebuild adjacent and preceding segments
    -- update rpath segments to speed up calculation of posts
    !this.rpath.segment(!closeFlag)
    -- rebuild posts
    if !toEnd.set() then
      do !index values !toEnd
        !posts = !this.getPosts(!index)
        !newPostsEnd.appendarray(!posts)
      enddo
      !this.insertMembers(!newPostsEnd, !this.posts)
    endif

    if !fromStart.set() then
      do !index values !fromStart
        !posts = !this.getPosts(!index)
        !newPostsStart.appendarray(!posts)
      enddo
      !this.insertMembers(!newPostsStart, !this.posts)
    endif
    -- re index array
    !this.posts.compress()
    -- update sequence numbers - just in case
    !this.updateSequence(!this.posts)

    -- rebuild panels
    if !toEnd.set() then
      do !index values !toEnd
        !panels = !this.getPanels(!index)
        !newPanelsEnd.appendarray(!panels)
      enddo
      !this.insertMembers(!newPanelsEnd, !this.panels)
    endif
    if !fromStart.set() then
      do !index values !fromStart
        !panels = !this.getPanels(!index)
        !newPanelsStart.appendarray(!panels)
      enddo
      !this.insertMembers(!newPanelsStart, !this.panels)
    endif
    -- update indices and sequence numbers
    !this.panels.compress()
    !this.updateSequence(!this.panels)
  endif

  -- rebuild rails and kickplates
  !this.rails = !this.getRails()
  !this.kickplates = !this.getKickplates()

  -- set proper xoffset sign
  !this.autoOffset()

  -- draw handrail
  !this.autoDraw()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

  return !newVertex

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      build
--
-- Description: build handrail based on passed vertex positions (type is defaulted to POINTR, detail to current radius value)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       position array
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .build(!vertex is ARRAY)

  --init
  !type = ARRAY()
  !detail = ARRAY()
  if !this.isPanelised then
    !radius = 0
  else
    !radius = !this.radius
  endif

  do !c  indices !vertex
    !type[!c] = 'POINTR'
    !detail[!c] = !this.radius
  enddo

  -- build handrail
  !this.build(!type, !vertex, !detail)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      build
--
-- Description: build handrail based on passed vertices in usual format - array of type, position, data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       vertex types
--    2   RW     ARRAY       vertex positions
--    3   RW     ARRAY       vertex data
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .build(!type is ARRAY, !vertex is ARRAY, !detail is ARRAY)

  -- correct radius
  !radius = !this.radius
  if !this.isPanelised then
    !radius = 0
  endif
  do !c indices !type
    skip if !type[!c].neq('POINTR')
    !detail[!c] = !radius
  enddo

  -- set rpath
  !this.rpath.aslrpath(!vertex, !type, !detail)

  -- generate handrail members
  !this.rebuild()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      build
--
-- Description: build handrail based on passed vertices in usual format - array of type, position, data, sigref
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       vertex types
--    2   RW     ARRAY       vertex positions
--    3   RW     ARRAY       vertex data
--    4   RW     ARRAY       vertex sigref
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .build(!type is ARRAY, !vertex is ARRAY, !detail is ARRAY, !sigref is ARRAY)

  -- correct radius
  !radius = !this.radius
  if !this.isPanelised then
    !radius = 0
  endif
  do !c indices !type
    skip if !type[!c].neq('POINTR')
    !detail[!c] = !radius
  enddo

  -- set rpath
  !this.rpath.aslrpath(!vertex, !type, !detail, !sigref)

  -- generate handrail members
  !this.rebuild()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      build
--
-- Description: build handrail on given side of passed stair flight with given template ref.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Stair flight (STRFLT db item of DBEASLSTRFLT object)
--    2   R      STRING      Side of stair flight (L or R)
--    3   R      DBREF       Assembly template reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .build(!stair is ANY,!side is STRING,!tmplref is DBREF)

  -- init
  !type   = ARRAY()
  !pos    = ARRAY()
  !detail = ARRAY()
  !sigref = ARRAY()

  -- get justification info
  !just = !this.getJustification(!tmplref)

  if !just.eq('M') then
    !xtra = !this.getActualXoffset(!tmplref)
  else
    !xtra = 0
  endif

  -- get routing point data
  if !this.isPanelised(!tmplref) then
    !!currentHandrailRadius = 1mm
  else
    !!currentHandrailRadius = !this.radius * 0.75
  endif
  !route = !!aslGetStrfltEdge(!stair,!side & !just,!xtra,true)
  if !route.set() then
    !type   = !route[1]
    !pos    = !route[2]
    !detail = !route[3]
    !sigref = !route[4]
  endif

  -- set rpath
  !this.rpath.aslrpath(!pos, !type, !detail, !sigref)

  -- apply template ref.
  !this.tmplReference(!tmplref)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      build
--
-- Description: build handrail on given side of passed stair flight
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Stair flight (STRFLT db item of DBEASLSTRFLT object)
--    2   R      STRING      Side of stair flight (L or R)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .build(!stair is ANY,!side is STRING)

  -- init
  !type   = ARRAY()
  !pos    = ARRAY()
  !detail = ARRAY()
  !sigref = ARRAY()

  -- get routing point data
  !route = !this.trackStrflt(!stair, !side)
  if !route.set() then
    !type   = !route[1]
    !pos    = !route[2]
    !detail = !route[3]
    !sigref = !route[4]
  endif

  -- build handrail
  !this.build(!type, !pos, !detail, !sigref)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getposts
--
-- Description: calculate posts for handrail
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of ASLHANDRAILMEMB objects
--
------------------------------------------------------------------------

define method .getPosts() is ARRAY

  -- init
  !posts = ARRAY()

  -- return empty array if rpath is not correctly defined
  if !this.rpath.unset() then
    return !posts
  endif

  -- store reference of existing posts to be repeated
  do !post values !this.posts
    if !post.refe.set() then
      !this.removedPosts.append(!post.refe)
    endif
  enddo

  -- update rpath segments to speed up calculation of posts
  !this.rpath.segment(!this.closeFlag())

  -- calculate posts
  do !c indices !this.rpath.vertex
    !newPosts = !this.getPosts(!c)
    !posts.appendarray(!newPosts)
  enddo

  -- correct sequence numbers - they are not used but just in case
  !this.updateSequence(!posts)

  return !posts

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getposts
--
-- Description: calculate posts for edge segment starting on vertex number passed
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of ASLHANDRAILMEMB objects
--
------------------------------------------------------------------------

define method .getPosts(!posref is REAL) is ARRAY

  -- init
  !posts      = ARRAY()
  !spacing    = !this.postSpacing
  !tangOffset = !this.tangentSpacing
  !endSpacing = !this.endSpacing
  !tmplref    = !this.postTemplate
  !closeFlag  = !this.closeFlag()

  -- return empty array if handrail is made from panels only
  if !this.isPanelised then
    return !posts
  endif

  !edge = !this.rpath.segment[!posref]
  if !edge.unset() then
    return !posts
  endif

  -- return no posts if closeFlag is false and last vertex
  if !this.vertex().size().eq(!posref).and(!closeFlag.not()) then
    return !posts
  endif

  -- compute cutting planes
  !drns = U wrt world
  !segmentDir = !edge[1].direction()
  handle NONE
    !cross = !segmentDir.cross(!drns)
    handle NONE
      !drns = !cross.orthogonal(!segmentDir)
    elsehandle ANY
    endhandle
  elsehandle ANY
  endhandle
  !drne = !drns.opposite()

  -- common post parameters - see constructor method of object ASLHANDRAILMEMB
  !data = object ANYDATASET()
  !data.setAttribute('posref',!posref)
  !data.setAttribute('zdis',0)
  !data.setAttribute('tmplref',!tmplref)
  !data.setAttribute('xoffset',!this.xoffset)
  !data.setAttribute('matref',!this.matref)
  !data.setAttribute('drns',!drns)
  !data.setAttribute('drne',!drne)

  -- if passed posref is a gate start then return just one post
  !gateStartRefs = !this.gates.evaluate(object BLOCK('!this.gates[!evalindex].posref'))
  !startOfGate = !gateStartRefs.find(!posref).set()
  if !startOfGate then
    !data.setAttribute('position',!this.vertex()[!posref])
    !ref = !this.getRemovedRef('POST')
    !posts[1] = object ASLHANDRAILMEMB('HRPOST',1,!data,!ref)
    return !posts
  else
  -- check if passed posref is a gate end
    !gateEndRefs = !gateStartRefs.evaluate(object BLOCK('!gateStartRefs[!evalindex] + 1'))
    !endOfGate = !gateEndRefs.find(!posref).set()
  endif

  -- compute overall segment length
  !leng = 0
  do !segment values !edge
    !leng = !leng + !segment.length()
  enddo
  !oleng = !leng

  !linearSegment = true
  if !posref.eq(1) then
    !prevIndex = !this.vertex().size()
  else
    !prevIndex = !posref - 1
    if !this.type()[!prevIndex].eq('CURVE') then
      !prevIndex = !posref - 2
    endif
  endif
  if !posref.eq(!this.vertex().size()) then
    !nextIndex = 1
  else
    !nextIndex = !posref + 1
    if !this.type()[!nextIndex].eq('CURVE') then
      !nextIndex = !posref + 2
      !linearSegment = false
    endif
  endif

  !startFillet = !this.rpath.isFillet(!posref,!closeFlag)
  !endFillet = !this.rpath.isFillet(!nextIndex,!closeFlag)
  !openend = !nextIndex.eq(!this.vertex().size()).and(!closeFlag.not())
  !openstart = !posref.eq(1).and(!closeFlag.not())
  !startSpace = 0
  !endSpace = 0
  !gateAtEnd = !this.vertexIsGate(!nextIndex)

  if !startFillet then
    !startSpace = !tangOffset
  else
    if !openstart.and(!linearSegment).or(!endOfGate) then
      !startSpace = !endSpacing
    endif
  endif
  if !endFillet then
    !endSpace = !tangOffset
  else
    if !openend.and(!linearSegment).or(!gateAtEnd) then
      !endSpace = !endSpacing
    endif
  endif

  -- compute number of posts
  !leng = !leng - !startSpace - !endSpace
  !ratio = !leng / !spacing
  !nofspaces = !ratio.int()
  if !nofspaces.boolean() then
    !rest = ( !leng - ( !nofspaces * !spacing) ) / 2
    if !rest.gt(0) then
      !nofspaces = !nofspaces - 1
      !rest = ( !leng - ( !nofspaces * !spacing) ) / 2
    endif
  else
    !rest = !leng
  endif

  if !leng.leq(0).and(!openstart.not().and(!openend.not())) then
  -- segment is too short for posts
    return !posts
  endif

  !zdis = !startSpace
  if !leng.leq(!endSpacing) then
    !zdis = (!leng + !startSpace + !endSpace) / 2
  endif

  !postSequ = 0
  -- place post at the end of the gate if any
  if !endOfGate then
    !postSequ = 1
    !data.setAttribute('position',!this.vertex()[!posref])
    !ref = !this.getRemovedRef('POST')
    !posts[1] = object ASLHANDRAILMEMB('HRPOST',!postSequ,!data,!ref)
  endif

  -- place post at open start if start termination is POST and endSpacing is non-zero
  if !openstart.and(!this.startTermination.eq('POST')).and(!endSpacing.gt(0)) then
    !postSequ = 1
    !data.setAttribute('position',!this.vertex()[1])
    !ref = !this.getRemovedRef('POST')
    !posts[1] = object ASLHANDRAILMEMB('HRPOST',!postSequ,!data,!ref)
  endif

  -- first regular post
  !postSequ = !postSequ + 1
  !data.setAttribute('zdis',!zdis)
  !data.remAttribute('position')
  !ref = !this.getRemovedRef('POST')
  !newpost = object ASLHANDRAILMEMB('HRPOST',!postSequ,!data,!ref)
  !newpost.position = !newpost.position('pos',!edge)
  !posts.append(!newpost)

  if !leng.leq(!endSpacing) then
    -- the only post to be returned
    return !posts
  endif

  -- return posts if at the end of segment
  if !oleng.leq(!zdis + !rest).and(!endSpacing.neq(0)) then
    if !edge[1].objectType().eq('ARC') then
      if !edge[1].angle().gt(45) then
        !postSequ = !postSequ + 1
        !ref = !this.getRemovedRef('POST')
        !data.remAttribute('position')
        !data.setAttribute('zdis',!oleng / 2)
        !newpost = object ASLHANDRAILMEMB('HRPOST',!postSequ,!data,!ref)
        !newpost.position = !newpost.position('pos',!edge)
        !posts.append(!newpost)
      endif
    endif
    return !posts
  endif

  -- second post
  !postSequ = !postSequ + 1
  !zdis = !zdis + !rest
  !data.setAttribute('zdis',!zdis)
  !ref = !this.getRemovedRef('POST')
  !newpost = object ASLHANDRAILMEMB('HRPOST',!postSequ,!data,!ref)
  !newpost.position = !newpost.position('pos',!edge)
  !posts.append(!newpost)

  -- return posts and exit if there is no intermediate post
  if !rest.eq(!leng) then
    return !posts
  endif

  -- intermediate posts
  do !c from 1 to !nofspaces
    !zdis = !zdis + !spacing
    break if !zdis.geq(!oleng)
    !postSequ = !postSequ + 1
    !data.setAttribute('zdis',!zdis)
    !ref = !this.getRemovedRef('POST')
    !newpost = object ASLHANDRAILMEMB('HRPOST',!postSequ,!data,!ref)
    !newpost.position = !newpost.position('pos',!edge)
    !posts.append(!newpost)
  enddo

  -- last post
  if !endSpace.boolean().or(!linearSegment.not().and(!openend)).or(!gateAtEnd) then
    !postSequ = !postSequ + 1
    !zdis = !leng + !startSpace
    !data.setAttribute('zdis',!zdis)
    !ref = !this.getRemovedRef('POST')
    !newpost = object ASLHANDRAILMEMB('HRPOST',!postSequ,!data,!ref)
    !newpost.position = !newpost.position('pos',!edge)
    !posts.append(!newpost)
  endif

  -- end termination by post
  !endTerminationPost = !this.endTermination.eq('POST').and(!openend).and(!endSpacing.boolean())
  if !endTerminationPost then
    !postSequ = !postSequ + 1
    !zdis = !oleng
    !data.setAttribute('zdis',!zdis)
    !ref = !this.getRemovedRef('POST')
    !newpost = object ASLHANDRAILMEMB('HRPOST',!postSequ,!data,!ref)
    !newpost.position = !newpost.position('pos',!edge)
    !posts.append(!newpost)
  endif

  return !posts

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPanels
--
-- Description: calculate panels for segment starting on vertex number passed
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of ASLHANDRAILMEMB objects
--
------------------------------------------------------------------------

define method .getPanels(!vertex is REAL) is ARRAY

  -- init
  !panel = ARRAY()
  !data = object ANYDATASET()
  !data.setAttribute('posref',!vertex)
  !data.setAttribute('xoffset',!this.xoffset)
  !data.setAttribute('matref',!this.matref)
  !tmplref    = !this.panelTemplate
  !closeFlag  = !this.closeFlag()

  if !tmplref.unset() then
  -- return empty array if there is no panel within template
    return !panel
  endif

  !edge = !this.rpath.segment[!vertex]
  if !edge.unset() then
    return !panel
  endif

  -- return no panels if closeFlag is false and last vertex
  if !this.vertex().size().eq(!vertex).and(!closeFlag.not()) then
    return !panel
  endif

  if !this.isPanelised then
  -- calculate standalone panels
    !nextPoint = !this.rpath.nextPointOf(!vertex)
    if !this.vertexIsGateStart(!vertex).and(!this.vertexIsGate(!nextPoint)) then
    -- no panels are placed at the GATE
      return !panel
    endif

    if !edge[1].objectType().eq('ARC') then
      return !this.panelsOnCurvedSegment(!vertex,!edge[1])
    endif

    -- panel settings
    !gap = !this.criteria.panelSpacing.optimum()
    !startGap = !this.criteria.panelEndSpacing.optimum()
    !endGap = !startGap
    !gateOnStart = !this.vertexIsGate(!vertex)
    !gateOnEnd = !this.vertexIsGate(!nextPoint)
    !defTmpl = !this.panelTemplate.last()
    !defCriterion = !this.panelCriteria.last()
    !defLeng = !defCriterion.optimum()
    !minLeng = !this.panelCriteria.first().min()
    !maxLeng = !this.panelCriteria.last().max()
    -- compute gaps
    if !gateOnStart then
      !startGap = 0
    endif
    if !gateOnEnd then
      !endGap = 0
    endif

    -- get segment
    !segment = !edge[1]
    -- get segment directio
    !segmDir = !segment.direction()
    -- get segment length
    !segmLeng = !segment.length()
    !countLeng = 0

    -- exit if segment is too short
    if !segmLeng.lt(!startGap + !minLeng + !endGap) then
      return !panel
    endif

    -- place regular panels (with the biggest default length)
    do !c
      if !c.eq(1) then
        !zdis = !countLeng + !startGap
      else
        !zdis = !countLeng + !gap
      endif
      break if !segmLeng.lt(!zdis + !defLeng + !endGap)
      !pos = !segment.startPosition.offset(!segmDir,!zdis)
      !endpos = !pos.offset(!segmDir,!defLeng)
      !rise = !endpos.up - !pos.up
      !data.setAttribute('position',!pos)
      !data.setAttribute('rise',!rise)
      !data.setAttribute('length',!defLeng)
      !data.setAttribute('zdis',!zdis)
      !data.setAttribute('tmplref',!defTmpl)
      !ref = !this.getRemovedRef('PANEL')
      !newPanel = object ASLHANDRAILMEMB('HRPANE',0,!data,!ref)
      !panel.append(!newPanel)
      !countLeng = !zdis + !defLeng
    enddo
    !rest = !segmLeng - !countLeng

    -- check if there is empty space
    if (!panel.size().boolean()) and ((!rest - !endGap - !gap) lt !minLeng) then
      -- try to extend last panel
      !leng = !defLeng + !rest - !endGap
      !wkleng = REAL()
      !defCriterion.checkValue(!leng)
      handle 3
        -- get nearest less valid value
        !wkleng = !defCriterion.nearestLessValue(!leng)
      elsehandle NONE
        !wkleng = !leng
      elsehandle ANY
        !wkleng = !maxLeng
      endhandle
      !lastPanel = !panel.removeLast()
      !endpos = !lastPanel.position.offset(!segmDir,!wkleng)
      !rise = !endpos.up - !pos.up
      !lastPanel.panesize[1] = !wkleng
      !lastPanel.rise = !rise
      !panel.append(!lastPanel)
      !countLeng = !zdis + !wkleng
      !rest = !segmLeng - !countLeng
    endif

    -- compute the gaps needed
    if !panel.size().eq(0) then
      !bothGaps = !startGap + !endGap
      !zdis = !startGap
    else
      !bothGaps = !gap + !endGap
      !zdis = !countLeng + !gap
    endif
    -- check the space again if there is still empty space
    if !rest.gt(!bothGaps) then
      -- try to calculate another panel to fill the space
      !leng = !rest - !bothGaps
      !tmpl = !this.selectPanel(!leng)
      if !tmpl.set() then
        !pos = !segment.startPosition.offset(!segmDir,!zdis)
        !endpos = !pos.offset(!segmDir,!leng)
        !rise = !endpos.up - !pos.up
        !data.setAttribute('position',!pos)
        !data.setAttribute('rise',!rise)
        !data.setAttribute('length',!leng)
        !data.setAttribute('zdis',!zdis)
        !data.setAttribute('tmplref',!tmpl)
        !ref = !this.getRemovedRef('PANEL')
        !newPanel = object ASLHANDRAILMEMB('HRPANE',0,!data,!ref)
        !panel.append(!newPanel)
        !countLeng = !zdis + !leng
        !rest = !segmLeng - !countLeng
      endif
    endif

  else
  -- calculate infill panels between posts
    -- loop through all posts
    do !c indices !this.posts
      !post = !this.posts[!c]
      skip if !post.posref.neq(!vertex)
      break if !c.eq(!this.posts.size())
      !nextpost = !this.posts[!c + 1]
      if !nextpost.posref.gt(!vertex) then
        skip if !this.vertexIsGate(!post.posref).and(!this.vertexIsGate(!nextpost.posref))
        skip if !this.rpath.isFillet(!nextpost.posref,!this.closeFlag())
      endif
      !nextVertex = !this.rpath.type[!post.posref + 1]
      handle NONE
        skip if !nextVertex.eq('CURVE')
      elsehandle ANY
      endhandle
      !zdis = !post.zdis
      !leng = !post.position.distance(!nextpost.position)
      !rise = !nextpost.position.up - !post.position.up
      !data.setAttribute('zdis',!zdis)
      !data.setAttribute('length',!leng)
      !data.setAttribute('rise',!rise)
      !data.setAttribute('bang',0)
      -- loop through templates
      do !tmpl values !tmplref
        !ref = !this.getRemovedRef('PANEL')
        !data.setAttribute('tmplref',!tmpl)
        !newPanel = object ASLHANDRAILMEMB('HRPANE',0,!data,!ref)
        !panel.append(!newPanel)
      enddo
    enddo
  endif

  return !panel

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      panelsOnCurvedSegment
--
-- Description: compute panels on curved segment of handrail
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--    2   R      ARC         arc running along segment
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of ASLHANDRAILMEMB
--
------------------------------------------------------------------------

define method .panelsOnCurvedSegment(!vertex is REAL,!segment is ARC) is ARRAY

  -- init
  !panel = ARRAY()
  !data = object ANYDATASET()
  !data.setAttribute('posref',!vertex)
  !data.setAttribute('xoffset',!this.xoffset)
  !data.setAttribute('rise',0)
  !data.setAttribute('matref',!this.matref)
  !tmplref    = !this.panelTemplate

  -- compute segment length
  !segmLeng = !segment.length()
  !countLeng = 0
  !countArcLeng = 0

  -- compute defaults
  !gap = !this.criteria.panelSpacing.optimum()
  !arcGap = !segment.chord(!gap).length()
  handle ANY
    return !panel
  endhandle
  !endGap = !this.criteria.panelEndSpacing.optimum()
  !arcEndGap = !segment.chord(!endGap).length()
  handle ANY
    return !panel
  endhandle
  !tooShort = false
  !defLeng = !segment.chordHeight(100mm).chord().int()
  handle ANY
    !defLeng = !this.rpath.arcLength(!segment, (!segmLeng - !arcEndGap * 2)).chord()
    !tooShort = true
  endhandle
  !defTmpl = !this.selectPanel(!defLeng)
  if !defTmpl.unset() then
    if !tooShort then
      !defLeng = !this.rpath.arcLength(!segment, (!segmLeng - !arcEndGap * 2)).chord()
    else
      !defLeng = !this.panelCriteria.last().optimum()
    endif
    !defTmpl = !this.selectPanel(!defLeng)
    if !defTmpl.unset() then
      return !panel
    endif
  endif
  !defArcLeng = !segment.chord(!defLeng).length()

  -- compute default beta angle
  !tanDir = !segment.startTangent()
  !tmparc = !segment.chord(!defLeng)
  !startpos = !segment.anglePosition(!segment.startAngle)
  !endpos = !tmparc.anglePosition(!tmparc.endAngle)
  !tmpdir = !startpos.direction(!endpos)
  !tmpPlane = object PLANE(!startpos,object ORIENTATION('Y is ' & !tanDir))
  !xy = !tmpPlane.xyOffset(!endpos)
  if !xy.x.lt(0) then
    !sense = -1
  else
    !sense = 1
  endif
  !defBang = !tanDir.angle(!tmpdir) * !sense
  !data.setAttribute('bang',!defBang)
  !data.setAttribute('tmplref',!defTmpl)
  !data.setAttribute('length',!defLeng)

  -- other defaults
  !defCriterion = !this.panelCriteria[!tmplref.findfirst(!defTmpl)]
  !minLeng = !this.panelCriteria.first().min()
  !minArcLeng = !segment.chord(!minLeng).length()
  !maxLeng = !this.panelCriteria.last().max()
  !maxArcLeng = !segment.chord(!maxLeng).length()
  handle ANY
    !maxArcLeng = !segmLeng - 2 * !arcEndGap
    !maxLeng = !this.rpath.arcLength(!segment, !maxArcLeng).chord()
  endhandle

  -- exit if segment is too short
  if !segmLeng.lt(!minArcLeng + 2 * !arcEndGap) then
    return !panel
  endif

  -- place regular panels (with the biggest default length)
  do !c
    if !c.eq(1) then
      !zdis = !countArcLeng + !arcEndGap
    else
      !zdis = !countArcLeng + !arcGap
    endif
    break if !segmLeng.lt(!zdis + !defArcLeng + !arcEndGap)
    !propAng = !segment.proportion(!zdis / !segmLeng)
    !pos = !segment.anglePosition(!propAng)
    !data.setAttribute('position',!pos)
    !data.setAttribute('zdis',!zdis)
    !ref = !this.getRemovedRef('PANEL')
    !newPanel = object ASLHANDRAILMEMB('HRPANE',0,!data,!ref)
    !panel.append(!newPanel)
    !countArcLeng = !zdis + !defArcLeng
  enddo
  !rest = !segmLeng - !countArcLeng

  -- how much space is there
  if (!panel.size().boolean()) and ((!rest - !arcEndGap - !arcGap) lt !minArcLeng) then
    -- calculate the matching length
    !arcLeng = !defArcLeng + !rest - !arcEndGap
    if !panel.size().gt(1) then
      !arcLeng = (!arcLeng + !defArcLeng) / 2
    endif
    !leng = !this.rpath.arcLength(!segment,!arcLeng).chord()
    !wkleng = REAL()
    !defCriterion.checkValue(!leng)
    handle 3
      -- get nearest less valid value
      !wkleng = !defCriterion.nearestLessValue(!leng)
    elsehandle NONE
      !wkleng = !leng
    elsehandle ANY
      !wkleng = !maxLeng
    endhandle
    !tmparc = !segment.chord(!wkleng)
    !arcWkleng = !tmparc.length()
    !endpos = !tmparc.anglePosition(!tmparc.endAngle)
    !tmpdir = !startpos.direction(!endpos)
    !bang = !tanDir.angle(!tmpdir) * !sense
    if !panel.size().eq(1) then
    -- extend last panel
      !lastPanel = !panel.removeLast()
      !lastPanel.panesize[1] = !wkleng
      !lastPanel.bang = !bang
      !panel.append(!lastPanel)
    else
    -- trim last two panels to the same length
      !lastPanel = !panel.removeLast()
      !nextToLast = !panel.removeLast()
      !zdis = !lastPanel.zdis - (!defArcLeng - !arcWkleng)
      !nextToLast.panesize[1] = !wkleng
      !nextToLast.bang = !bang
      !lastPanel.panesize[1] = !wkleng
      !lastPanel.zdis = !zdis
      !lastPanel.bang = !bang
      !tmparc = !this.rpath.arcLength(!segment,!zdis)
      !lastPanel.position = !tmparc.anglePosition(!tmparc.endAngle)
      !panel.append(!nextToLast)
      !panel.append(!lastPanel)
    endif
    !countArcLeng = !zdis + !arcWkleng
    !rest = !segmLeng - !countArcLeng
  endif

  -- compute the gaps needed
  if !panel.size().eq(0) then
    !zdis = !arcEndGap
    !bothGaps = !arcEndGap * 2
  else
    !zdis = !countArcLeng + !arcGap
    !bothGaps = !arcGap + !arcEndGap
  endif
  -- check the space again
  if !rest.gt(!bothGaps) then
    !arcLeng = !rest - !bothGaps
    !tmparc = !this.rpath.arcLength(!segment,!arcLeng)
    !leng = !tmparc.chord()
    !tmpl = !this.selectPanel(!leng)
    if !tmpl.set() then
      !pos = !segment.anglePosition(!segment.proportion(!zdis / !segmLeng))
      !endpos = !tmparc.anglePosition(!tmparc.endAngle)
      !tmpdir = !startpos.direction(!endpos)
      !bang = !tanDir.angle(!tmpdir) * !sense
      !data.setAttribute('bang',!bang)
      !data.setAttribute('position',!pos)
      !data.setAttribute('length',!leng)
      !data.setAttribute('zdis',!zdis)
      !data.setAttribute('tmplref',!tmpl)
      !ref = !this.getRemovedRef('PANEL')
      !newPanel = object ASLHANDRAILMEMB('HRPANE',0,!data,!ref)
      !panel.append(!newPanel)
    endif
  endif

  return !panel

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectPanel
--
-- Description: select panels template based on length
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     REAL        panel length needed
--
-- Return:
--   [Data Type] [Description]
--    DBREF       panel template
--
------------------------------------------------------------------------

define method .selectPanel(!leng is REAL) is DBREF

  --init
  !tmpl = nulref
  !index = REAL()

  do !c indices !this.panelCriteria
    !crit = !this.panelCriteria[!c]
    !crit.checkValue(!leng)
    handle NONE
      !index = !c
      break
    elsehandle 3
      !leng = !crit.nearestLessValue(!leng)
      !index = !c
      break
    elsehandle ANY
      skip
    endhandle
  enddo

  if !leng.set().and(!index.set()) then
  -- select template if length is set
    !tmpl = !this.panelTemplate[!index]
  endif

  -- return result
  return !tmpl

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      panels
--
-- Description: calculate panels for whole handrail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .panels()

  -- init
  !panels = ARRAY()

  -- remove existing panels and store references if any
  !this.removePanels()

  -- exit with no panels if rpath is not correctly defined
  if !this.rpath.unset() then
    !this.panels = !panels
    return
  endif

  do !c indices !this.vertex()
    !newPanels = !this.getPanels(!c)
    !panels.appendarray(!newPanels)
  enddo

  !this.updateSequence(!panels)

  !this.panels = !panels

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isPanelised
--
-- Description: return true if passed handrail is built up from panels only
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .isPanelised(!handrail is DBREF) is BOOLEAN

  !panels = !this.collection('HRPANE',!handrail)
  !posts = !this.collection('HRPOST',!handrail)
  !rails = !this.collection('RAIL',!handrail)

  return !posts.unset().and(!rails.unset()).and(!panels.set())

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      getRails
--
-- Description: calculate rails
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of ASLHANDRAILMEMB objects
--
------------------------------------------------------------------------

define method .getRails() is ARRAY

  -- init
  !rails = ARRAY()
  !closeFlag = !this.closeFlag()
  !data = object ANYDATASET()
  !data.setAttribute('matref',!this.matref)

  -- store removed rails
  !this.removeRails()

  -- exit if path not defined yet
  if !this.rpath.unset() then
    return !rails
  endif

  -- return empty array if handrail is made from panels only
  if !this.isPanelised then
    return !rails
  endif

  -- get spools
  !spool = !this.getSpools()

  -- get rail spacing and template ref.
  -- init variable
  !tmpl = ARRAY()
  !railtmpl = !this.railTemplate(!this.tmplReference)
  if !railtmpl.unset() then
  -- get railspacing from this object
    !spacing = !this.railSpacing
    do !c indices !spacing
    -- declare unset tmplref
      !tmpl[!c] = nulref
    enddo
  else
  -- get it from template
    !spacing = !railtmpl[2]
    do !c indices !spacing
    -- compose desp array
      !tmpl.append(!railtmpl[1][!c])
    enddo
  endif

  do !c indices !spool
    !ownesequ = !c
    !staref = !spool[!c][1]
    !endref = !spool[!c][2]
    do !sequ indices !this.railSpacing
      !refno   = !this.getRemovedRef('RAIL')
      !zoffset = !spacing[!sequ]
      !data.setAttribute('ownersequ',!ownesequ)
      !data.setAttribute('staref',!staref)
      !data.setAttribute('endref',!endref)
      !data.setAttribute('tmplref',!tmpl[!sequ])
      !data.setAttribute('xoffset',!this.xoffset)
      !data.setAttribute('zoffset',!zoffset)
      !rail = object ASLHANDRAILMEMB('RAIL',!sequ,!data,!refno)
      !rails.append(!rail)
    enddo

  enddo

  return !rails

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getkickplates
--
-- Description: calculate kickplates based on existing rails
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of ASLHANDRAILMEMB objects
--
------------------------------------------------------------------------

define method .getKickplates() is ARRAY

  -- init
  !kickpl = ARRAY()
  !tmpkickpl = ARRAY()
  !startend = ARRAY()
  -- max. angle for kick plates to be created
  !maxSlope = 10

  -- store removed kickplates
  !this.removeKickplates()

  -- check if there is some KickPlate within template
  !tmpl = !this.kickplTemplate(!this.tmplReference)
  if !tmpl.badref() then
    return !kickpl
  endif

  -- common values of kickplates
  !data = object ANYDATASET()
  !data.setAttribute('tmplref',!tmpl)
  !data.setAttribute('xoffset',!this.xoffset)
  !data.setAttribute('matref',!this.matref)

  -- get spools
  !startend = !this.getSpools()


  do !c indices !startend
    !staref = !startend[!c][1]
    !endref = !startend[!c][2]
    !data.setAttribute('staref',!staref)
    !data.setAttribute('endref',!endref)
    !refno = !this.getRemovedRef('KICKPL')
    !newkickpl = object ASLHANDRAILMEMB('KICKPL',!c,!data,!refno)
    !tmpkickpl.append(!newkickpl)
  enddo

  -- check if there is an elevation change within each kickplate
  !tmpPlane = object PLANE(!this.position,!this.orientation)
  do !c indices !tmpkickpl
    !thiskickpl = !tmpkickpl[!c]
    !start = !thiskickpl.staref
    !end   = !thiskickpl.endref
    if !end.leq(!start) then
      !end = !this.vertex().size() + !end
    endif
    !splitkickpl = ARRAY()
    !startRef = !start
    do !cc from !start to !end
      !index = !cc
      if !index.gt(!this.vertex().size()) then
        !index = !index - !this.vertex().size()
      endif
      !pos = !this.rpath.vertex[!index].wrt(worl)
      !nextpos = !this.rpath.vertex[!index + 1].wrt(worl)
      handle ANY
        !nextpos = !this.rpath.vertex.first().wrt(world)
      endhandle
      !dir = !pos.direction(!nextpos)
      handle ANY
        !dir = !this.orientation.ydir()
      endhandle
      !projDir = !dir.projected(!tmpPlane)
      if !dir.angle(!projDir).gt(!maxSlope) then
        if !start.eq(!index) then
          !tmpkickpl[!c].staref = !index
        else
          !newkickpl = !thiskickpl
          !newkickpl.staref = !startRef
          !newkickpl.endref = !index
          !newkickpl.refe = !this.getRemovedRef('KICKPL')
          !splitkickpl.append(!newkickpl)
        endif
        !startRef = !index + 1
      endif
    enddo
    if !splitkickpl.set() then
      !kickpl.appendarray(!splitkickpl)
      if !splitkickpl.last().endref.neq(!thiskickpl.endref) then
        !newkickpl.staref = !startRef
        !newkickpl.endref = !thiskickpl.endref
        !newkickpl.refe = !this.getRemovedRef('KICKPL')
        !kickpl.append(!newkickpl)
      endif
    else
      !kickpl.append(!thiskickpl)
    endif
  enddo

  -- get spools along stairs
  !spoolsOnStairs = ARRAY()
  !stairs = false
  !sigref = !this.rpath.sigref
  do !c indices !sigref
    skip if !sigref[!c].badref()
    skip if !this.rpath.type[!c].neq('POINTR')
    if !sigref[!c].owner.owner.type.eq('STRFLT') then
      if !stairs.not() then
        !tmpSpool[1] = !c
        !stairs = true
      else
        !stairs = false
        !tmpSpool[2] = !c
        !spoolsOnStairs.append(!tmpSpool)
        !tmpSpool.clear()
      endif
    endif
  enddo

  -- remove kickplates that are mounted on stairs
  do !c indices !kickpl
    !start = !kickpl[!c].staref
    !end = !kickpl[!c].endref
    do !spool values !spoolsOnStairs
      if !start.between(!spool[1],!spool[2]).and(!end.between(!spool[1],!spool[2])) then
        !remove = !this.kickplatesOnStairs.not()
        if !start.eq(1).or(!end.eq(!this.rpath.size())) then
          !remove = (!start + 1) eq !end
        endif
        if !remove then
          !refno = !kickpl[!c].refe
          if !refno.set() then
            !this.removedKickplates.append(!refno)
          endif
          !kickpl[!c].delete()
          break
        endif
      elseif !start.lt(!spool[1]).and(!end.between(!spool[1],!spool[2])) then
        !kickpl[!c].endref = !spool[1]
        break
      elseif !start.between(!spool[1],!spool[2]).and(!end.gt(!spool[2])) then
        !kickpl[!c].staref = !spool[2]
      endif
    enddo
  enddo

  !kickpl.compress()
  !this.updateSequence(!kickpl)

  return !kickpl

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSpools
--
-- Description: calculate spools for rails or kickplates (divided by gates) as array of from/to pointers
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of real arrays - each array will hold two values (from/to)
--
------------------------------------------------------------------------

define method .getSpools() is ARRAY

  -- init
  !closeFlag = !this.closeFlag()
  !spool = ARRAY()
  !fromto = ARRAY()

  -- exit if path not defined yet
  if !this.rpath.unset() then
    return !spool
  endif


  -- how many spools we have
  !fromto[1] = 1
  -- define first or only one spool
  if !this.gates.size().boolean() then
  -- there are gates
    if !closeFlag.not() then
    -- define first spool if rail is not closed
      !fromto[2] = !this.gates[1].posref
      !spool[1] = !fromto
    endif
  else
  -- there are NO gates
    if !closeFlag then
      !fromto[2] = 1
    else
      !fromto[2] = !this.rpath.vertex.maxIndex()
    endif
    -- define spool
    !spool[1] = !fromto
  endif
  -- define spools between gates
  do !c indices !this.gates
    !fromto[1] = !this.gates[!c].posref + 1
    if !c.eq(!this.gates.size()) then
      if !closeFlag then
        !fromto[2] = !this.gates[1].posref
      else
        !fromto[2] = !this.rpath.vertex.maxIndex()
      endif
    else
      !fromto[2] = !this.gates[!c + 1].posref
    endif
    !spool.append(!fromto)
  enddo

  return !spool

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertMembers
--
-- Description: insert array of handrail members into existing members so that the actual order is maintained
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array with new handrail members
--    2   RW     ARRAY       target array with existing members
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertMembers(!newMember is ARRAY, !target is ARRAY)

  -- exit if there is no new member (array is empty)
  if !newMember.empty() then
    return
  endif

  -- if target array is empty then populate it with new members and exit
  if !target.empty() then
    !target = !newMember
    return
  endif

  -- get posref index of first member
  !posref = !newMember.first().posref

  -- find index to be inserted at
  !index = REAL()
  do !c indices !target
    if !target[!c].posref.gt(!posref) then
      !index = !c
      break
    endif
  enddo
  if !index.unset() then
    !index = !target.maxIndex() + 1
  endif

  -- insert members
  !target.insertarray(!index, !newMember)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getRemovedRef
--
-- Description: remove dbreference from registry of deleted members and return it
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      element type
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference number
--
------------------------------------------------------------------------

define method .getRemovedRef(!type is STRING) is DBREF

  !refno = nulref
  if !type.upcase().eq('GATE') then
    !memb = 'REMOVEDGATES'
  elseif !type.upcase().eq('POST') then
    !memb = 'REMOVEDPOSTS'
  elseif !type.upcase().eq('PANEL') then
    !memb = 'REMOVEDPANELS'
  elseif !type.upcase().eq('RAIL') then
    !memb = 'REMOVEDRAILS'
  elseif !type.upcase().eq('KICKPL') then
    !memb = 'REMOVEDKICKPLATES'
  endif

  !removed = !this.attribute(!memb)
  if !removed.set() then
    !refno = !removed.removeFirst()
    !this.attribute(!memb) = !removed
  endif

  return !refno

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .enhance()

  call !!aslEnhance(!this.refe)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      showVolFeedback
--
-- Description: draws the element with aid lines using default object pen settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showVolFeedback()

  -- init
  !number = !this.aidNumber
  !colour = !this.aidColour
  !linetype = !this.aidLinetype

  -- draw handrail
  !this.draw(!number, !linetype, !colour)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      unEnhance
--
-- Description: unenhance the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .unEnhance()

  call !!aslUnEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: updates/re-creates handrail
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDb() is DBREF

  -- create undo mark
  if !this.undoable then
    !undo = object UNDOABLE()
    !undo.description('Create/update handrail')
    if !this.undoCall.set() then
      !undo.undoaction(!this.undoCall)
      !undo.redoaction(!this.undoCall)
    endif
    !undo.add()
  endif

  -- create/recreate handrail
  if !this.refe.badref() then
    if !this.refe.unset() then
       new HANDRA
       !this.refe = !!ce
    else
       new HANDRA ref $!this.refe
    endif
  else
    !!ce = !this.refe
    -- delete all handrail members
    delete HANDRA members
  endif

  if !this.name.empty() then
    UNNAME
  else
    !this.refe.name = !this.name
    handle ANY
    endhandle
  endif


  -- apply object settings to db attributes
  !!ce.railHeight  = !this.railSpacing
  !!ce.postSpacing = !this.postSpacing
  !!ce.tangOffset  = !this.tangentSpacing
  !!ce.closeFlag   = !this.closeFlag
  !!ce.ePostOffset = !this.endSpacing
  !!ce.pos         = !this.position
  !!ce.ori         = !this.orientation
  !!ce.bradius     = !this.radius
  !!ce.number      = !this.number
  !!ce.area        = !this.area
  !!ce.desc        = !this.description

  -- set setting and template reference
  !!ce.func  = !this.settingReference
  !!ce.asstmpref = !this.tmplReference
  !!ce.aslSta      = !this.standard
  handle ANY
  endhandle
  !!ce.aslSbS      = !this.subStandard
  handle ANY
  endhandle

  -- create/recreate handrail contents
  -- first create rpath
  !this.rpathref = !this.rpath.dbwrite(!this.rpathref)

  -- then update handrail members
  -- GATES
  do !gate values !this.gates
    !gate.updateDb()
  enddo

  -- POSTS
  do !post values !this.posts
    !post.updateDb()
  enddo

  -- RAILS
  do !rail values !this.rails
    !rail.updateDb()
  enddo

  -- KICKPLS
  do !kick values !this.kickplates
    !kick.updateDb()
  enddo

  -- HRPANELS
  do !panel values !this.panels
    !panel.updateDb()
  enddo

  -- start/end termination
  !this.terminationUpdateDb('start')
  !this.terminationUpdateDb('end')

  -- re-execute all rules
  !!ce = handra
  RULE REXE

  -- TEMPORARY
  -- create empty railset if handrail is panelised and there is no kickplate
  if !this.isPanelised.and(!this.kickplates.size().eq(0)) then
    new railse
  endif

  -- jump to handrail
    !!ce = !this.refe

  -- end undo mark
  if !this.undoable then
    !undo.endUndoable()
  endif

  -- return handrail refno
  return !this.refe

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateGeometry
--
-- Description: update handrail geometry - align each vertex with its sigref (if any) and then rebuild handrail
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        number of vertices modified
--
--
------------------------------------------------------------------------

define method .updateGeometry() is REAL

   -- store actual zdistance of each gate
   do !c indices !this.gates
     !posref = !this.gates[!c].posref
     !preposref = !this.rpath.prevPointOf(!posref)
     !zdist[!c] = !this.vertex()[!preposref].distance(!this.vertex()[!posref])
     !dir[!c] = !this.vertex()[!preposref].direction(!this.vertex()[!posref])
   enddo

   -- update rpath
   !modified = !this.rpath.updateGeometry()
   if !modified.eq(0) then
     return error 1 'No vertex has been re-positioned'
   endif

   -- align gates
   do !c indices !this.gates
     !this.alignGate(!c,!zdist[!c])
   enddo

   -- rebuild handrail
   !this.rebuild()

   return !modified

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      alignGate
--
-- Description: align gate with start/endpoint of whole segment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        index of gate to be aligned
--    2   R      REAL        distance from previous vertex to posref of gate
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .alignGate(!index is REAL,!dist is REAL)

  -- get gate data
  !posref = !this.gates[!index].posref
  !width = !this.gates[!index].width

  -- get previous vertex
  !prevIndex = !this.rpath.prevPointOf(!posref)
  !start = !this.vertex()[!prevIndex]

  -- get direction
  !startCorner = !this.prevCorner(!posref)
  !endCorner = !this.nextCorner(!posref)
  !dir = !this.vertex()[!startCorner].direction(!this.vertex()[!endCorner])

  -- calculate new position of start/end of gate
  !prevpos = !start.offset(!dir,!dist)
  !nextpos = !prevpos.offset(!dir,!width)
  !this.rpath.vertex[!posref] = !prevpos
  !this.rpath.vertex[!posref + 1] = !nextpos

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      nextCorner
--
-- Description: return index of next non-gate vertex from passed index
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--
-- Return:
--   [Data Type] [Description]
--    REAL        index of next vertex
--
------------------------------------------------------------------------

define method .nextCorner(!index is REAL) is REAL

  !result = REAL()

  if !this.rpath.size().lt(2) then
    return !result
  endif

  do !c from !index
    !next = !this.rpath.nextPointOf(!c)
    skip if !this.vertexIsGate(!next)
    !result = !next
    break
  enddo

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      prevCorner
--
-- Description: return index of previous non-gate vertex from passed index
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--
-- Return:
--   [Data Type] [Description]
--    REAL        index of previous vertex
--
------------------------------------------------------------------------

define method .prevCorner(!index is REAL) is REAL

  !result = REAL()

  if !this.rpath.size().lt(2) then
    return !result
  endif

  do !c from !index to 1 by -1
    !prev = !this.rpath.prevPointOf(!c)
    skip if !this.vertexIsGate(!prev)
    !result = !prev
    break
  enddo

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergeCriteria
--
-- Description: merges central standard with fabricator standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergeCriteria()

  -- gets the values for the handrail from the substandard
  !this.criteria  = !!aslLocalCriteria(!this.criteriaBasis, !this.tmplReference)
  !this.criteria.complete()
  if !this.radiusGadget.set() then
    !this.radiusGadget.setEditable(!this.criteria.bradius.min.neq(!this.criteria.bradius.max))
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      setSettingReference
--
-- Description: sets the setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      setting
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .settingReference(!settingReference is STRING)

  !this.settingReference = !settingReference
  !this.criteriaBasis         = !!aslCentralData.getCriteriaSet(!settingReference, 'ASLHANDRACRITERIA')
  handle ANY
    return error 1 'Invalid setting reference "$!settingReference". Contact your ASL administrator'
  endhandle
  !this.criteriaBasis.complete()

  -- set standard/substandard
  !setting         = !!aslCentralData.getSetting(!settingReference)
  !standardName    = '/' + !setting.settingData[1].value
  !subStandardName = '/' + !setting.settingData[2].value

  !this.standard = !standardName.dbref()
  handle ANY
  endhandle
  !this.subStandard = !subStandardName.dbref()
  handle ANY
  endhandle

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: draw the handrail as aid graphic using explicit pen colour and linetype
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        aid graphic number
--    2   R      REAL        line type
--    3   R      REAL        colour
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .draw(!number is REAL, !linetype is REAL, !colour is REAL) is ASLHANDRAIL

  -- update rpath segments to speed up drawing of the handrail
  !this.rpath.segment(!this.closeFlag())

  -- draw posts
  do !post values !this.posts
    !post.draw(!this,!number, !linetype, !colour)
    handle ANY
    endhandle
  enddo

  -- draw rails
  do !rail values !this.rails
    !rail.draw(!this,!number, !linetype, !colour)
  enddo

  -- draw panels
  if !this.isPanelised then
    do !panel values !this.panels
      !panel.draw(!this,!number, !linetype, !colour)
      handle ANY
      endhandle
    enddo
  endif

  -- draw gates
  if !this.drawGates then
    do !gate values !this.gates
      !gate.draw(!this,!number, !linetype, !colour)
    enddo
  endif

  return !this

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      autodraw
--
-- Description: draw the handrail as aid graphic using object pen settings - existing graphic is REMOVED prior to drawing
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .autoDraw() is ASLHANDRAIL

  -- exit if autodraw is off
  if !this.autoDraw.not() then
    return
  endif

  -- init
  !number = !this.aidNumber
  !colour = !this.aidColour
  !linetype = !this.aidLinetype

  -- clear previous graphic
  !!aidNumbers.hide(!number)

  -- update rpath segments to speed up drawing of the handrail
  !this.rpath.segment(!this.closeFlag())

  -- draw posts
  do !post values !this.posts
    !post.draw(!this,!number, !linetype, !colour)
    handle ANY
    endhandle
  enddo

  -- draw rails
  do !rail values !this.rails
    !rail.draw(!this,!number, !linetype, !colour)
  enddo

  -- draw panels
  if !this.isPanelised then
    do !panel values !this.panels
      !panel.draw(!this,!number, !linetype, !colour)
      handle ANY
      endhandle
    enddo
  endif

  -- draw gates
  if !this.drawGates then
    !linetype = !this.aidLinetypeGates
    !colour   = !this.aidColourGates
    do !gate values !this.gates
      !gate.draw(!this,!number, !linetype, !colour)
    enddo
  endif

  return !this

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      autoDrawOn
--
-- Description: set autodraw flag on and set number linetype and colour
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        aid number
--    2   RW     ANY         line type (1 or solid, 2 or dashed, 3 or dotted, 4 or dashdot )
--    3   RW     ANY         colour
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoDrawOn(!aidNumber is REAL, !linetype is ANY, !aidColour is ANY)

  -- check passed data
  !number = !aidNumber
  !type = !this.aidLinetype
  !col = !this.aidColour
  if !linetype.objectType().eq('REAL') then
    !type = !linetype
  elseif !linetype.objectType().eq('STRING') then
    !tmpType = !linetype.trim().upcase()
    if !tmpType.eq('SOLID') then
      !type = 1
    elseif !tmpType.eq('DASHED') then
      !type = 2
    elseif !tmpType.eq('DOTTED') then
      !type = 3
    elseif !tmpType.eq('DASHDOT') then
      !type = 4
    endif
  else
    return error 1 'Invalid type of argument 2. REAL/STRING is expected.'
  endif

  if !aidColour.objectType().eq('REAL') then
    !col = !aidColour
  elseif !aidColour.objectType().eq('STRING') then
    !tmpCol = object COLOUR(!aidColour)
    handle NONE
      !col = !tmpCol.code
    elsehandle ANY
    endhandle
  elseif !aidColour.objectType().eq('COLOUR') then
    !col = !aidColour.code
  else
    return error 1 'Invalid type of argument 3. REAL/STRING/COLOUR is expected.'
  endif

  -- apply passed data
  !this.autoDraw = true
  !this.aidNumber = !number
  !this.aidLinetype = !type
  !this.aidColour = !col

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      autoDrawOn
--
-- Description: set autodraw flag on and set aidnumber only
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        aid number
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoDrawOn(!aidNumber is REAL)

  -- apply passed data
  !this.autoDraw = true
  !this.aidNumber = !aidNumber

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      autoDrawOn
--
-- Description: set autodraw flag on
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoDrawOn()

  -- apply passed data
  !this.autoDraw = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      autoDrawOff
--
-- Description: set autodraw flag off
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoDrawOff()

  -- apply passed data
  !this.autoDraw = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      undoCall
--
-- Description: set undoable flag as well as undo/redo callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      undo/redo callback
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .undoCall(!callback is STRING)

  !this.undoable = true
  !this.undoCall = !callback

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removevertex
--
-- Description: remove vertex from rpath including associated posts and update references of all members (rails,posts,gates)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index of vertex to be removed
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       parallel arrays with old and new indices
--
------------------------------------------------------------------------

define method .removeVertex(!index is REAL) is ARRAY

  -- remove associated posts and panels
  !this.removePosts(!index)
  !this.removePanels(!index)

  -- remove vertex and update posref of all members
  !indices = !this.rpath.removeVertex(!index)
  !this.updatePosrefs(!indices[1],!indices[2])

  return !indices

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteVertex
--
-- Description: remove vertex from object including preceding and adjacent edge and rebuild object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index of vertex to be deleted
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteVertex(!index is REAL)

  -- init
  !posts = ARRAY()
  !closeFlag = !this.closeFlag

  if !this.vertex().size().leq(3) then
    !this.removeVertex(!index)
    -- handle curves
    !curveIndex = !this.type().findfirst('CURVE')
    if !curveIndex.set() then
      !this.removeVertex(!curveIndex)
    endif
    !this.rebuild()
    -- update gadget for gates
    !this.gatesGadget()
    return
  endif

  !vrtxs = ARRAY()
  !fromStart = ARRAY()
  !toEnd = ARRAY()


  -- collect all preceding vertices including gates to be deleted
  do !c from !index to -100 by -1
    skip if !c.eq(!index)
    !prevVertex = !c
    if !c.lt(1) then
      if !closeFlag then
        !prevVertex = !this.vertex().maxIndex() + !c
      else
        break
      endif
    endif
    if !this.type()[!prevVertex].eq('CURVE').or(!this.vertexIsGate(!prevVertex)) then
      !vrtxs.append(!prevVertex)
    else
     !first = !prevVertex
      break
    endif
  enddo

  if defined(!first) then
    if !first.eq(1) then
      if !closeFlag then
        !beforeFirst = !this.vertex().maxIndex()
      endif
    else
      !beforeFirst = !first - 1
      if !this.rpath.endOfCurve(!first) then
        if !this.type()[!beforeFirst].eq('CURVE') then
          !beforeFirst = !first - 2
        endif
      endif
    endif
  endif
  !vrtxs.invert()
  !vrtxs.append(!index)

  -- collect all adjacent vertices including gates to be deleted
  !maxIndex = !this.vertex().maxIndex()
  do !c from !index
    skip if !c.eq(!index)
    !nextVertex = !c
    if !nextVertex.gt(!maxIndex) then
      if !closeFlag then
        !nextVertex = !c - !maxIndex
      else
        break
      endif
    endif
    if !this.vertexIsGate(!nextVertex).or(!this.type()[!nextVertex].eq('CURVE')) then
      !vrtxs.append(!nextVertex)
    else
      if !this.rpath.endOfCurve(!nextVertex).not() then
        !last = !nextVertex
      endif
      break
    endif
  enddo

  !vrtxs.sortunique()
  !vrtxs.invert()

  -- remove orphaned GATEs
  !gateRefs = !this.gates.evaluate(object BLOCK('!this.gates[!evalindex].posref'))
  do !c values !vrtxs
    !removeGate = !gateRefs.findfirst(!c)
    if !removeGate.set() then
      !this.gates[!removeGate].delete()
    endif
  enddo
  !this.gates.compress()
  !this.updateSequence(!this.gates)

  -- remove vertices
  do !c values !vrtxs
    !indices = !this.removeVertex(!c)
    !oldIndices = !indices[1]
    !newIndices = !indices[2]
    if defined(!first) then
      !find = !oldIndices.findfirst(!first)
      if !find.set() then
        !first = !newIndices[!find]
      endif
    endif
    if defined(!beforeFirst) then
      !find = !oldIndices.findfirst(!beforeFirst)
      if !find.set() then
        !beforeFirst = !newIndices[!find]
      endif
    endif
    if defined(!last) then
      !find = !oldIndices.findfirst(!last)
      if !find.set() then
        !last = !newIndices[!find]
      endif
    endif
  enddo

  if !this.vertex().size().leq(1) then
    !this.posts = !this.getPosts()
    !this.rails = !this.getRails()
    !this.kickplates = !this.getKickplates()
    !this.panels()
  else
  -- update rpath segments to speed up calculation of posts
     !this.rpath.segment(!closeFlag)

     -- calculate posts
     !removed = ARRAY()
     !newPosts = ARRAY()
     if defined(!beforeFirst) then
       !removed = !this.removePosts(!beforeFirst)
       !newPosts = !this.getPosts(!beforeFirst)
     endif
     if defined(!first) then
       !removed.appendarray(!this.removePosts(!first))
       !newPosts.appendarray(!this.getPosts(!first))
     endif
     if !newPosts.set() then
       !this.posts.insertarray(!removed.first(),!newPosts)
     endif
     !this.posts.compress()

     if defined(!last) then
       !removed = !this.removePosts(!last)
       !newPosts = !this.getPosts(!last)
       if !newPosts.set() then
         !this.posts.insertarray(!removed.first(),!newPosts)
       endif
       !this.posts.compress()
     endif
     !this.updateSequence(!this.posts)

     -- calculate panels
     !newPanels = ARRAY()
     if defined(!beforeFirst) then
       !this.removePanels(!beforeFirst)
       !newPanels = !this.getPanels(!beforeFirst)
     endif
     if defined(!first) then
       !this.removePanels(!first)
       !newPanels.appendarray(!this.getPanels(!first))
     endif
     !this.insertMembers(!newPanels,!this.panels)
     !this.panels.compress()

     if defined(!last) then
       !this.removePanels(!last)
       !newPanels = !this.getPanels(!last)
       if !newPanels.set() then
         !this.insertMembers(!newPanels, !this.panels)
       endif
       !this.panels.compress()
     endif
     !this.updateSequence(!this.panels)

     -- calculate rails and kickplates
     !this.rails = !this.getRails()
     !this.kickplates = !this.getKickplates()
  endif

  -- update gadget for gates
  !this.gatesGadget()

  -- redraw handrail
  !this.autoDraw()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteVertices
--
-- Description: delete vertices between start and end index inclusive then rebuild object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       vertices to be deleted (real array)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteVertices(!vertices is ARRAY)

  -- sort vertices
  !vertices.sort()

  -- remove all gates between start and end
  do !c indices !this.gates
    !posref = !this.gates[!c].posref
    !match = !vertices.find(!posref)
    if !match.set() then
      if !this.gates[!c].refe.set() then
        !this.removedGates.append(!this.gates[!c].refe)
      endif
      !this.gates[!c].delete()
    endif
  enddo
  !this.gates.compress()

  -- remove passed vertices except first one
  !index = !vertices.remove(1)
  !vertices.invert()

  do !c values !vertices
    !this.removeVertex(!c)
  enddo

  -- delete remaining vertex
  !this.deleteVertex(!index)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      removeGeometry
--
-- Description: remove geometry completely
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeGeometry()

  !this.rpath.aslrpath()
  !this.rpath.zdir = !this.orientation.zdir()

  -- remove posts and panels
  !this.removePosts()
  !this.removePanels()

  -- remove gates and store dbrefs if set
  do !c indices !this.gates
    !gate = !this.gates[!c]
    if !gate.refe.set() then
      !this.removedGates.append(!gate.refe)
    endif
    !this.gates[!c].delete()
  enddo

  -- remove rails and kickplates
  !this.removeRails()
  !this.removeKickplates()

  -- update gate gadget
  !this.gatesGadget()

  -- remove graphic
  if !this.autoDraw then
    !!aidNumbers.hide(!this.aidNumber)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertvertex
--
-- Description: insert new vertex after the existing one
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Vertex type
--    2   R      REAL        Existing vertex number to be inserted after
--    3   R      POSITION    vertex position
--    4   R      ANY         vertex details - ARRAY for curves REAL (radius) for POINTR's
--    5   R      DBREF       reference to pointr in another rpath
--
-- Return:
--   [Data Type]  [Description]
--    REAL         index of new vertex
--
------------------------------------------------------------------------

define method .insertVertex(!type is STRING,!index is REAL,!atpos is POSITION,!detail is ANY,!sigref is DBREF) is REAL

  -- create  vertex
  !indices = !this.rpath.insertVertex(!type, !index, !atpos, !detail,!sigref)

  -- update posref of all members
  !this.updatePosrefs(!indices[1],!indices[2])

  return !index + 1

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyVertex
--
-- Description: modifies vertex position and detail attribute and rebuild preceding and consecutive posts
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--    2   R      ANY         position or dbref (POINTR)
--    3   R      ANY         vertex detail - REAL radius or POINTR or array of attributes of CURVE
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyVertex(!index is REAL,!posdata is ANY,!detail is ANY)

  -- get original values
  !oldpos = !this.rpath.vertex[!index]
  !olddetail = !this.rpath.detail[!index]

  -- extract position and pointr reference form passed data
  !pos = object POSITION()
  !sigref = nulref
  if !posdata.objectType().eq('DBREF') then
    !pos = !posdata.position.wrt(world)
    !sigref = !posdata
  elseif !posdata.objectType().eq('POSITION') then
    !pos = !posdata.wrt(world)
  endif

  -- do nothing when both values are unset
  if !pos.unset().and(!detail.unset()) then
    return
  endif

  if !pos.unset() then
    !newpos = !oldpos
  else
    !newpos = !pos
  endif
  if !detail.unset() then
    !newDetail = !olddetail
  else
    !newDetail = !detail
  endif

  -- do nothing when new value is the same as old value
  if !newpos.eq(!oldpos).and(!newDetail.eq(!olddetail)) then
    return
  endif

  -- check passed position against existing vertices
  if !pos.set() then
    !found = !!findNearestPos(!this.vertex(),!pos,1mm)
    if !found.set() then
      return error 1 'Cannot move vertex - position is coincident with existing vertex'
    endif
  endif

  !prevGateVrtxs = ARRAY()
  !nextGateVrtxs = ARRAY()
  !prevVrtxs = ARRAY()
  !nextVrtxs = ARRAY()
  !fromStart = ARRAY()
  !toEnd = ARRAY()

  if !this.type()[!index].eq('CURVE') then
    !prevVrtxs[1] = !index - 1
  else
    do !c from !index to -100 by -1
      skip if !c.eq(!index)
      !prevVertex = !c
      if !c.lt(1) then
        if !this.closeFlag then
          !prevVertex = !this.vertex().maxIndex() + !c
        else
          break
        endif
      endif
      !first = !prevVertex
      skip if !this.type()[!prevVertex].eq('CURVE')
      !prevVrtxs.append(!prevVertex)
      break if !pos.unset()
      if !this.vertexIsGate(!prevVertex) then
        !prevGateVrtxs[!prevVertex] = !this.vertex()[!prevVertex]
      else
        break
      endif
    enddo

    if !pos.set().and(!prevVrtxs.set()) then
      if !prevVrtxs.last().eq(1) then
        if !this.closeFlag then
          !prevVrtxs.append(!this.vertex().maxIndex())
        endif
      else
        if !this.rpath.endOfCurve(!prevVertex).not() then
          !prevVrtxs.append(!prevVrtxs.last() - 1)
        endif
      endif
    endif
    !prevVrtxs.invert()

    !maxIndex = !this.vertex().maxIndex()
    do !c from !index
      break if !pos.unset()
      skip if !c.eq(!index)
      !nextVertex = !c
      if !nextVertex.gt(!maxIndex) then
        if !this.closeFlag then
          !nextVertex = !c - !maxIndex
        else
          break
        endif
      endif
      !last = !nextVertex
      skip if !this.type()[!nextVertex].eq('CURVE')
      break if !this.rpath.endOfCurve(!nextVertex)
      !nextVrtxs.append(!nextVertex)
      if !this.vertexIsGate(!nextVertex) then
        !nextGateVrtxs[!nextVertex] = !this.vertex()[!nextVertex]
      else
          break
      endif
    enddo
  endif

  !allVrtxs = !prevVrtxs
  !allVrtxs.append(!index)
  !allVrtxs.appendarray(!nextVrtxs)

  !getOverFirst = false
  do !c values !allVrtxs
    if !c.eq(1) then
      !getOverFirst = true
    endif
    if !getOverFirst then
      !fromStart.append(!c)
    else
      !toEnd.append(!c)
    endif
  enddo

  -- modify vertex
  -- unset argument means "unchanged"
  if !pos.set() then
    -- set new position
    !this.rpath.vertex[!index] = !newpos
    -- set pointr ref.
    !this.rpath.sigref[!index] = !sigref
    -- align gate vertices that are in between
    do !c indices !prevGateVrtxs
      !prevpos = !this.vertex()[!first]
      !dir = !prevpos.direction(!newpos)
      !dist = !prevpos.distance(!this.vertex()[!c])
      !this.rpath.vertex[!c] = !prevpos.offset(!dir,!dist)
    enddo
    do !c indices !nextGateVrtxs
       !nextpos = !this.vertex()[!last]
       !dir = !newpos.direction(!nextpos)
       !dist = !oldpos.distance(!this.vertex()[!c])
       !this.rpath.vertex[!c] = !newpos.offset(!dir,!dist)
    enddo
  endif
  if !detail.set() then
    !this.rpath.detail[!index] = !newDetail
  endif


  -- regenerate handrail completely if just four or less POINTR vertices
  !vertexNo = !this.type().find('POINTR').size()
  if !pos.set().and(!vertexNo.leq(4)) then
    !this.rebuild()
    !this.gatesGadget()
    !this.autoDraw()
    return
  endif

  -- update rpath segments to speed up calculation of posts
  !this.rpath.segment(!this.closeFlag)

  -- rebuild posts on concerned edges
  if !fromStart.set() then
    !newPosts = ARRAY()
    do !c values !fromStart
      !this.removePosts(!c)
      !newPosts.appendarray(!this.getPosts(!c))
    enddo
    !this.insertMembers(!newPosts,!this.posts)
    !this.posts.compress()
  endif
  if !toEnd.set() then
    !newPosts = ARRAY()
    !removed = ARRAY()
    do !c values !toEnd
      !removed.appendarray(!this.removePosts(!c))
      !newPosts.appendarray(!this.getPosts(!c))
    enddo
    !this.insertMembers(!newPosts,!this.posts)
    !this.posts.compress()
  endif

  -- update sequence numbers
  !this.updateSequence(!this.posts)

  -- rebuild panels on concerned edges
  if !fromStart.set() then
    !newPanels = ARRAY()
    do !c values !fromStart
      !this.removePanels(!c)
      !newPanels.appendarray(!this.getPanels(!c))
    enddo
    !this.insertMembers(!newPanels,!this.panels)
  endif
  if !toEnd.set() then
    !newPanels = ARRAY()
    !removed = ARRAY()
    do !c values !toEnd
      !this.removePanels(!c)
      !newPanels.appendarray(!this.getPanels(!c))
    enddo
    !this.insertMembers(!newPanels,!this.panels)
  endif

  -- update indices and sequence numbers
  !this.panels.compress()
  !this.updateSequence(!this.panels)

  -- set  xoffset inclination
  !this.autoOffset()

  -- update gadget for gates
  !this.gatesGadget()

  -- draw handrail
  !this.autoDraw()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      railTemplate
--
-- Description: get rails from template
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       HANDRAil template
--
-- Return:
--   [Data Type]  [Description]
--    ARRAY        parallel arrays of rails and Z offsets
--
------------------------------------------------------------------------

define method .railTemplate(!handratmpl is DBREF) is ARRAY

  -- init vars
  !rails = ARRAY()
  !offset = ARRAY()
  !result[1] = !rails
  !result[2] = !offset

  -- if template is nulref then return empty array
  if !handratmpl.badref() then
    return !result
  endif

  -- handrail members
  !hmemb = !handratmpl.memb
  -- if there is no railset the return empty array
  !railseIndx = !hmemb.evaluate(object BLOCK('!hmemb[!evalindex].type')).findfirst('RAILSE')
  if !railseIndx.unset() then
    return !result
  endif

  -- collect all rails from template
  !rails = !this.collection('RAIL',!hmemb[!railseIndx])
  if !rails.size().eq(0) then
    return !result
  endif

  -- extract ZOffset and spref
  !offset = !rails.evaluate(object BLOCK('!rails[!evalindex].zoffset'))

  !newIndx = !offset.sortedIndices()
  !result[1] = !rails.reindex(!newIndx)
  !result[2] = !offset.reindex(!newIndx)

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      postTemplate
--
-- Description: get post from template
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       HANDRAil template
--
-- Return:
--   [Data Type]  [Description]
--    DBREF        ref to post
--
------------------------------------------------------------------------

define method .postTemplate(!handratmpl is DBREF) is DBREF

  -- init
  !result = nulref

  -- collect all posts from template
  !post = !this.collection('HRPOST',!handratmpl)
  if !post.size().boolean() then
    !result = !post[1]
  endif

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      panelTemplate
--
-- Description: get panels from template
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       HANDRAil template
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       dbref array of panel templates
--
------------------------------------------------------------------------

define method .panelTemplate(!handrailtmpl is DBREF) is ARRAY

  -- init
  !panel = ARRAY()

  -- collect panels from template
  !panel = !!collectAllFor('HRPANE','',!handrailtmpl)

  return !panel

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      panelCriteria
--
-- Description: get and sort panel criteria and sort panel templates accordingly
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .panelCriteria()

  -- init
  !criteria = ARRAY()
  !optleng = ARRAY()
  -- loop through panel templates
  do !c indices !this.panelTemplate
    !ddat = !!collectAllFor('DDAT','purp eq ''DFLT'' and dkey eq ''LENG''',!this.panelTemplate[!c])
    !criteria[!c] = object CRITERION()
    if !ddat.set() then
      !criteria[!c] = object CRITERION(!ddat[1])
      handle ANY
      endhandle
    endif
    if !criteria[!c].optimum.unset() then
      !optimum = !this.panelTemplate[!c].panesi[1]
      handle ANY
        !criteria[!c].delete()
        !this.panelTemplate[!c].delete()
        skip
      endhandle
      !criteria[!c].complete(!optimum, !optimum)
    endif
    !optleng[!c] = !criteria[!c].optimum()
  enddo
  -- sort criteria and templates by optimum length
  !newIndices = !optleng.sortedIndices()
  !criteria.reindex(!newIndices)
  !this.panelCriteria = !criteria
  !this.panelTemplate.reindex(!newIndices)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      kickplTemplate
--
-- Description: get kickplate from template
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       HANDRAil template
--
-- Return:
--   [Data Type]  [Description]
--    DBREF        ref. to kickplates
--
------------------------------------------------------------------------

define method .kickplTemplate(!handratmpl is DBREF) is DBREF

  -- init
  !result = nulref

  -- collect all kickplates from template
  !kick = !this.collection('KICKPL',!handratmpl)
  if !kick.size().boolean() then
    !result = !kick[1]
  endif

  return !result


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      collection
--
-- Description: collect items from db
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         array or string - element type(s)
--    2   R      ANY         filter selection STRING or EXPRESSION
--    3   R      ANY         db reference(s) where  the collection to be made from
--
-- Return:
--   [Data Type]  [Description]
--    ARRAY        dbref array
--
------------------------------------------------------------------------

define method .collection(!type is ANY,!filter is ANY,!scope is ANY) is ARRAY

  if !type.objectType().eq('STRING') then
    !types[1] = !type
  else
    !types = !type
  endif
  if !filter.objectType().eq('STRING') then
    !expr = object EXPRESSION(!filter)
  elseif !filter.objectType().eq('EXPRESSION') then
    !expr = !filter
  endif

  !collect = object COLLECTION()
  !collect.types(!types)
  !collect.scope(!scope)
  if !expr.set() then
    !collect.filter(!expr)
  endif

  return !collect.results()


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      collection
--
-- Description: collect items from db
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         array or string - element type(s)
--    2   R      DBREF       db position the collection to be made from
--
-- Return:
--   [Data Type]  [Description]
--    ARRAY        dbref array
--
------------------------------------------------------------------------

define method .collection(!type is ANY,!scope is DBREF) is ARRAY


  !filter = object EXPRESSION()

  !result = !this.collection(!type, !filter, !scope)
  return !result

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      getTemplates
--
-- Description: get list of rail templates available in current context
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]  [Description]
--    ARRAY        dbref array of rail template
--
------------------------------------------------------------------------

define method .getTemplates() is ARRAY

  !templates = ARRAY()
  !templates = !!aslCentralData.getTemplates(!this.settingReference,'HANDRA')
  handle ANY
    return error
  endhandle

  return !templates

endmethod

------------------------------------------------------------------------
--
-- Method:      postSpacing
--
-- Description: set post spacing value and recalculate the posts
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        spacing attribute (member) name
--    2   R      REAL        value
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .postSpacing(!spacingAttr is STRING,!spacing is REAL)

  -- init
  !attr = !spacingAttr.upcase()
  !gadgetName = !attr + 'GADGET'
  !gadget = !this.attribute(!gadgetName)
  !oldSpacing = !this.attribute(!attr)

  -- check for unset argument
  if !spacing.unset() then
    !this.updateGadget(!gadget,!oldSpacing)
    return
  endif

  -- check if new value is the same as old value
  if !spacing.eq(!oldSpacing) then
    !this.updateGadget(!gadget,!oldSpacing)
    return
  endif

  -- check passed value
  !this.criteria.checkValue(!spacing,!attr)
  handle ANY
    !this.updateGadget(!gadget,!oldSpacing)
    return error
  endhandle

  -- set the value
  !this.attribute(!attr) = !spacing

  -- recalculate posts and panels if rpath set
  if !this.rpath.vertex.size().gt(1) then
    !this.posts = !this.getPosts()
    !this.panels()
  endif

  -- draw handrail
  !this.autoDraw()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      RailSpacing
--
-- Description: set railSpacing value and recalculate the rails
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        post spacing
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .railSpacing(!spacing is ARRAY)

  -- exit if supplied value is the same as the current value
  if !spacing.eq(!this.railSpacing) then
    -- update gadget and exit
    !this.railSpacingGadget(true)
    return
  endif

  -- check passed value
  !this.criteria.checkRailSpacing(!spacing)
  handle ANY
    !this.railSpacingGadget(true)
    return error
  endhandle

  -- set the value
  !this.railSpacing = !spacing

  -- recalculate rails if rpath set
  if !this.rpath.set() then
    !this.rails = !this.getRails()
  endif

  -- update gadget
  !this.railSpacingGadget(true)

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

  -- draw handrail
  !this.autoDraw()

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      radius
--
-- Description: set bend radius
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        radius
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .radius(!radius is REAL)

  -- exit if supplied value is the same as the current value
  if !radius.eq(!this.radius) then
    return
  endif

  -- check for unset value
  if !radius.unset() then
    !this.updateGadget(!this.radiusGadget,!this.radius)
    return
  endif


  -- check passed value
  !this.criteria.checkValue(!radius,'BRADIUS')
  handle ANY
    -- update gadget and exit
    !this.updateGadget(!this.radiusGadget,!this.radius)
    return error
  endhandle

  -- set the value
  !this.radius = !radius

  -- do nothing if handrail is panelised
  if !this.isPanelised then
    -- update gadget and exit
    !this.updateGadget(!this.radiusGadget,!this.radius)
    return
  endif

  -- apply radius to rpath
  !this.rpath.radius(!radius)

  -- recalculate posts and panels
  !this.posts = !this.getPosts()
  !this.panels()

  -- update gadget and exit
  !this.updateGadget(!this.radiusGadget,!radius)

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

  -- draw handrail
  !this.autoDraw()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: set handrail position and reposition rpath as well
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    new position
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .position(!newpos is POSITION)

  -- first check if positions differ
  if !this.position.eq(!newpos) then
    return
  endif


  -- then check if rpath is unset
  if !this.rpath.unset() then
  -- update object position and exit
    !this.position = !newpos
    return
  endif


  -- we need to move rpath and posts
  -- get distance and direction of move
  !dist = !this.position.distance(!newpos)
  !dir  = !this.position.direction(!newpos)

  -- move rpath
  !this.rpath = !this.rpath.offset(!dir,!dist)

  -- move posts
  do !c indices !this.posts
    !this.posts[!c].position = !this.posts[!c].position.offset(!dir,!dist)
  enddo

  -- move panels
  do !c indices !this.panels
    !this.panels[!c].position = !this.panels[!c].position.offset(!dir,!dist)
    handle ANY
    endhandle
  enddo

  -- then update object position
  !this.position = !newpos

  -- update associated gadgets
  !this.gatesGadget()

  -- draw handrail
  !this.autoDraw()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif



endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      closeflag
--
-- Description: set handrail closeflag and partially recalculate rails and posts
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     new value of closeflag
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .closeFlag(!newFlag is BOOLEAN)

  -- exit if closeflag is the same
  if !this.closeFlag.eq(!newFlag) then
    return
  endif

  -- update object value
  !this.closeFlag = !newFlag

  -- exit if rpath is unset
  if !this.rpath.unset() then
    return
  endif

  -- get the last vertex index
  !lastVertex = !this.rpath.vertex.maxIndex()

  -- if switching to false then remove all gates on last "closing" segment
  if !newFlag.not() then
    -- first find the last actual vertex and remove all vertices afterward (associated posts are removed accordingly)
    !lastindex = !lastVertex
    do !c from !lastindex to 1 by -1
      if !this.vertexIsGate(!c) then
        !this.removeVertex(!c)
      else
        !lastVertex = !c
        break
      endif
    enddo
    -- remove gates on last segment
    do !c indices !this.gates
      if !this.gates[!c].posref.geq(!lastVertex) then
        !this.gates[!c].delete()
      endif
    enddo
  else
  endif

  -- remove all existing posts with posref 1
  !this.removePosts(1)

  -- update rpath segments to speed up calculation of posts
  !this.rpath.segment(!this.closeFlag)

  -- calculate new posts to replace removed
  !firstposts = !this.getPosts(1)
  !this.insertMembers(!firstposts,!this.posts)

  --remove all existing posts on last two segments
  !this.removePosts(!lastVertex)
  !this.removePosts(!lastVertex - 1)
  -- calculate new post for last segments
  !lastposts = !this.getPosts(!lastVertex - 1)
  if !newFlag then
  -- calculate posts for the last segment as well
    !lastposts.appendarray(!this.getPosts(!lastVertex))
  endif

  -- append new posts to existing ones
  !this.posts.appendarray(!lastposts)

  -- update indices and sequence numbers - just in case
  !this.posts.compress()
  !this.updateSequence(!this.posts)

  -- calculate panels
  -- first segment for infill panels
  if !this.isPanelised.not() then
    !this.removePanels(1)
    !panels = !this.getPanels(1)
    !this.insertMembers(!panels,!this.panels)
  endif
  !panels = ARRAY()

  -- last segment before (infill panels only)
  !this.removePanels(!lastVertex)
  if !this.isPanelised.not() then
    !this.removePanels(!lastVertex - 1)
    !panels = !this.getPanels(!lastVertex - 1)
  endif
  if !newFlag then
  -- last segment
    !panels.appendarray(!this.getPanels(!lastVertex))
  endif

  -- append panels to existing ones
  !this.panels.appendarray(!panels)

  -- update indices and sequence numbers
  !this.panels.compress()
  !this.updateSequence(!this.panels)

  -- recalculate rails kickplates and panels
  !this.rails = !this.getRails()
  !this.kickplates = !this.getKickplates()

  -- update gadgets
  !this.updateGadget(!this.closeFlagGadget,!newFlag)
  !this.gatesGadget()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

  -- draw handrail
  !this.autoDraw()

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      openSegment
--
-- Description: make segment ending on passed vertex index open
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .openSegment(!index is REAL)


  -- init
  !indices = !this.vertex().indices()
  !newIndices = ARRAY()
  !diff = !index - 1
  !maxIndex = !this.rpath.size()

  -- reindex
  do !c indices !indices
    !newIndex = !c + !diff
    if !newIndex.gt(!maxIndex) then
      !newIndex = !maxIndex - !c - !diff
    endif
    !newIndices[!c] = !newIndex.abs()
  enddo

  -- reindex rpath members
  !this.rpath.detail.reindex(!newIndices)
  !this.rpath.refe.reindex(!newIndices)
  !this.rpath.sigref.reindex(!newIndices)
  !this.rpath.type.reindex(!newIndices)
  !this.rpath.vertex.reindex(!newIndices)

  -- update references of gates
  do !c indices !this.gates
    !posref = !this.gates[!c].posref
    !this.gates[!c].posref = !newIndices[!posref]
  enddo

  -- rebuild handrail
  !this.posts = !this.getPosts()
  !this.rails = !this.getRails()
  !this.kickplates = !this.getKickplates()
  !this.panels()

  -- make handrail open if closed
  if !this.closeFlag then
    !this.closeFlag(false)
  endif

  -- draw handrail
  !this.autoDraw()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      closeFlag
--
-- Description: get closeflag value - if less then three vertices ignore actual value and return always false
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .closeFlag() is BOOLEAN

  !closeFlag = !this.closeFlag

  !vertex = !this.vertex()
  do !c indices !vertex
    if !this.vertexIsGate(!c) then
      !vertex[!c].delete()
    endif
  enddo

  if !vertex.size().lt(3) then
    !closeFlag = false
  endif

  return !closeFlag

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      area
--
-- Description: set area value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       new value
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .area(!value is REAL)

  !this.area = !value
  !this.updateGadget(!this.areaGadget,!this.area)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      number
--
-- Description: set number value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        new value
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .number(!value is REAL)

  !this.number = !value
  !this.updateGadget(!this.numberGadget,!this.number)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      description
--
-- Description: set description
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      new description
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .description(!desc is STRING)

  !newDesc = !desc.trim()

  !this.description = !newDesc
  !this.updateGadget(!this.descriptionGadget,!this.description)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      name
--
-- Description: check the passed name and set it if unique
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     STRING      PDMS name of the handrail
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .name(!name is STRING)

  -- init
  !newName = !name.trim().replace(' ','')
  if !this.refe.badref() then
    !oldName = ''
  else
    !oldName = !this.refe.name
  endif
  if !newName.empty().not() then
    if !newName.match('/').neq(1) then
      !newName = '/' + !newName
    endif
    if !newName.neq(!oldName) then
      !newName.dbref()
      handle NONE
        !!alert.error('Name ($!newName) already exists')
        !newName = !this.name
      elsehandle ANY
      endhandle
    endif
  endif

  !this.name = !newName

  !this.updateGadget(!this.nameGadget,!this.name)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removePosts
--
-- Description: remove all posts with posref equal to passed value
--
-- Method Type: procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      REAL          posref
--
-- Return:
--   [Data Type]  [Description]
--    ARRAY        array with indices of removed posts
--
------------------------------------------------------------------------

define method .removePosts(!posref is REAL) is ARRAY

  !removed = ARRAY()
  !removedRef = ARRAY()

  do !c indices !this.posts
    !post = !this.posts[!c]
    skip if !post.posref.neq(!posref)
    !refno = !post.refe
    if !refno.set() then
      !removedRef.append(!refno)
    endif
    !this.posts[!c].delete()
    !removed.append(!c)
  enddo

  !this.removedPosts.appendarray(!removedRef)

  return !removed

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      removePosts
--
-- Description: remove all posts
--
-- Method Type: procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type]  [Description]
--    ARRAY        array with indices of removed posts
--
------------------------------------------------------------------------

define method .removePosts() is ARRAY

  !removed = ARRAY()
  !removedRef = ARRAY()

  do !c indices !this.posts
    !post = !this.posts[!c]
    !refno = !post.refe
    if !refno.set() then
      !removedRef.append(!refno)
    endif
    !this.posts[!c].delete()
    !removed.append(!c)
  enddo

  !this.removedPosts.appendarray(!removedRef)

  return !removed

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      removeRails
--
-- Description: remove all rails and store dbrefs if set
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeRails()

  -- init
  !removed = ARRAY()

  -- remove rails
  do !c indices !this.rails
    !refno = !this.rails[!c].refe
    if !refno.set() then
      !removed.append(!refno)
    endif
    !this.rails[!c].delete()
  enddo

  !this.removedRails.appendarray(!removed)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeKickplates
--
-- Description: remove all kickplates and store dbrefs if set
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeKickplates()

  -- init
  !removed = ARRAY()

  -- remove kickplates
  do !c indices !this.kickplates
    !refno = !this.kickplates[!c].refe
    if !refno.set() then
      !removed.append(!refno)
    endif
    !this.kickplates[!c].delete()
  enddo

  !this.removedKickplates.appendarray(!removed)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removePanels
--
-- Description: remove all panels with posref equal to passed value
--
-- Method Type: procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      REAL          posref
--
-- Return:
--   [Data Type]  [Description]
--    ARRAY        array with indices of removed panels
--
------------------------------------------------------------------------

define method .removePanels(!posref is REAL) is ARRAY

  !removed = ARRAY()
  !removedRef = ARRAY()

  do !c indices !this.panels
    !panel = !this.panels[!c]
    skip if !panel.posref.neq(!posref)
    !refno = !panel.refe
    if !refno.set() then
      !removedRef.append(!refno)
    endif
    !this.panels[!c].delete()
    !removed.append(!c)
  enddo

  !this.removedPanels.appendarray(!removedRef)

  return !removed

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      removePanels
--
-- Description: remove all panels
--
-- Method Type: procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type]  [Description]
--    ARRAY        array with indices of removed panels
--
------------------------------------------------------------------------

define method .removePanels() is ARRAY

  !removed = ARRAY()
  !removedRef = ARRAY()

  do !c indices !this.panels
    !panel = !this.panels[!c]
    !refno = !panel.refe
    if !refno.set() then
      !removedRef.append(!refno)
    endif
    !this.panels[!c].delete()
    !removed.append(!c)
  enddo

  !this.removedPanels.appendarray(!removedRef)

  return !removed

endmethod
-- end of method


------------------------------------------------------------------------
--
-- Method:      removeGate
--
-- Description: remove gate with passed index as well as associated vertices and rebuild concerned segment
--
-- Method Type: procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      REAL          gate index
--
-- Return:
--   [Data Type]       [Description]
--    ASLHANDRAILMEMB   removed gate as object
--
------------------------------------------------------------------------

define method .removeGate(!index is REAL) is ASLHANDRAILMEMB

  -- get start/end vertices
  !start = !this.gates[!index].posref
  !end = !start + 1

  -- remove gate
  !removedGate = !this.gates.remove(!index)

  -- store refno of removed gate within registry
  if !removedGate.refe.set() then
    !this.removedGates.append(!removedGate.refe)
  endif

  -- remove posts and panels from previous vertex to end vertex of gate
  !prev = !start - 1
  !removedPosts = ARRAY()
  !removedPanels = ARRAY()
  do !c from !prev to !end
    !tmprm = !this.removePosts(!c)
    !removedPosts.appendarray(!tmprm)
    !tmprm = !this.removePanels(!c)
    !removedPanels.appendarray(!tmprm)
  enddo

  -- remove end vertex first
  !this.removeVertex(!end)

  -- remove start vertex
  !this.removeVertex(!start)

  -- update rpath segments to speed up calculation of posts
  !this.rpath.segment(!this.closeFlag())

  -- sort gates
  !this.sortGates()

  -- re-build posts
  !newPosts = !this.getPosts(!prev)
  !this.insertMembers(!newPosts, !this.posts)
  !this.posts.compress()

  -- update sequence numbers on posts - just in case
  !this.updateSequence(!this.posts)

  -- re-build panels
  !newPanels = !this.getPanels(!prev)
  !this.insertMembers(!newPanels, !this.panels)
  !this.panels.compress()

  -- update sequence numbers on panels
  !this.updateSequence(!this.panels)

  -- re-build rails and kickplates
  !this.rails = !this.getRails()
  !this.kickplates = !this.getKickplates()

  -- update associated gadgets
  !this.gatesGadget()

  -- draw handrail
  !this.autoDraw()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

  return !removedGate

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: set handrail orientation and recalculate rpath
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      ORIENTATION   new orientation
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .orientation(!newori is ORIENTATION)

  -- first check if orientations differ
  if !this.orientation.eq(!newori) then
    return
  endif


  -- then check if rpath is unset
  if !this.rpath.unset() then
  -- update object orientation and rpath Zdir and exit
    !this.orientation = !newori
    !this.rpath.zdir = !newori.zdir()
    return
  endif


  -- transform positions
  do !c indices !this.rpath.vertex
    -- transform vertex position
    !curpos = !this.rpath.vertex[!c]
    !this.rpath.vertex[!c] = !this.transformPos(!curpos,!newori)
    -- there are also some positions within detail array when point is CURVE so transform them too
    if !this.rpath.type[!c].eq('CURVE') then
      do !cc indices !this.rpath.detail[!c]
        if !this.rpath.detail[!c][!cc].objectType().eq('POSITION') then
          !curpos = !this.rpath.detail[!c][!cc]
          !this.rpath.detail[!c][!cc] = !this.transformPos(!curpos,!newori)
        endif
      enddo
    endif
  enddo

  -- transform posts
  do !c indices !this.posts
    !postpos = !this.posts[!c].position
    !this.posts[!c].position = !this.transformPos(!postpos,!newori)
  enddo

  -- transform panels
  do !c indices !this.panels
    !panepos = !this.panels[!c].position
    !this.panels[!c].position = !this.transformPos(!panepos,!newori)
  enddo

  -- then update object value and rpath Zdir
  !this.orientation = !newori
  !this.rpath.zdir = !newori.zdir()

  -- draw handrail
  !this.autoDraw()

  -- update associated gadgets
  !this.gatesGadget()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      transformPos
--
-- Description: transform position from current coordinate system defined by object to one defined by new orientation
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      POSITION      current position
--    2   R      ORIENTATION   new orientation
--
-- Return:
--   [Data Type]  [Description]
--    POSITION     transformed position
--
------------------------------------------------------------------------

define method .transformPos(!pos is POSITION,!ori is ORIENTATION) is POSITION

  -- init
  !newpos = object POSITION()

  -- define planes
  -- plane with current orientation
  !curplane = object PLANE(!this.position,!this.orientation)

  -- plane with the new orientation
  !oriplane = object PLANE(!this.position,!ori)

  -- map vertex onto current plane
  !xy = !curplane.xyOffset(!pos)
  !z = !pos.distance(!curplane)
  -- if position does not lay on a plane then whether it is above or below plane
  if !z.boolean() then
    if !curplane.position.direction(!pos).angle(!curplane.direction()).gt(90) then
    -- position is below plane so it is the negative
      !z = !z * -1
    endif
  endif

  !newpos = !oriplane.threedposition(!xy)
  !newpos = !newpos.offset(!oriplane.direction(),!z)

  return !newpos

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: rotate handrail about Z axis through its position by passed value
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      REAL          rotation angle
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL)

  !newori = !this.orientation.wrt(worl)

  !newori.gamma = !newori.gamma + !angle

  !this.orientation(!newori)

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      shiftOffset
--
-- Description: shift offset inclination
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .shiftOffset()

  !offset = !this.xoffset * -1
  !this.xoffset(!offset)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      xoffset
--
-- Description: change an offset inclination
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        offset inclination (1 or -1) not the offset value itself
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .xoffset(!plusMinus is REAL)

  -- store value at object
  !this.xoffset = !plusMinus

  -- distribute value to all concerned members
  do !c indices !this.posts
    !this.posts[!c].xoffset(!plusMinus)
  enddo

  do !c indices !this.rails
    !this.rails[!c].xoffset(!plusMinus)
  enddo

  do !c indices !this.kickplates
    !this.kickplates[!c].xoffset(!plusMinus)
  enddo

  do !c indices !this.panels
    !this.panels[!c].xoffset = !plusMinus
  enddo

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getXoffset
--
-- Description: get proper value of xoffset inclination
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        offset inclination (1 or -1)
--
------------------------------------------------------------------------

define method .getXoffset() is REAL

  -- init
  !result = !this.xoffset
  !member = object ASLHANDRAILMEMB()

  !xoffset = 0
  if !this.posts.set() then
    !member = !this.posts[1]
    !xoffset = !member.xoffset()
  endif
  if !xoffset.eq(0).and(!this.panels.set()) then
    !member = !this.panels[1]
    !xoffset = !member.xoffset()
  endif
  if !xoffset.eq(0).and(!this.rails.set()) then
    !member = !this.rails[1]
    !xoffset = !member.xoffset()
  endif
  if !xoffset.eq(0).and(!this.kickplates.set()) then
    !member = !this.kickplates[1]
    !xoffset = !member.xoffset()
  endif

  if !member.tmplref.badref() then
    return !result
  endif

  !shape = !this.rpath.profile(true)
  handle ANY
    return !result
  endhandle

  if !shape.isValidClosed().not() then
    return !result
  endif

  -- obtain actual xoffset value from first post
  !offset = !member.xoffset()

  -- obtain first segment to apply offset to
  !segment = !shape.edges()[1]
  if !segment.objectType().eq('LINE') then
    !dir = !segment.direction().cross(U wrt worl)
    handle ANY
      return !result
    endhandle
    !pos = !segment.proportion(0.5)
    handle ANY
      return !result
    endhandle
  else
    !dir = !segment.angleDirection(!segment.startAngle)
    handle ANY
      return !result
    endhandle
    !pos = !segment.anglePosition(!segment.startAngle)
    handle ANY
      return !result
    endhandle
  endif

  -- construct offset position
  !pos = !pos.offset(!dir,!offset)

  if !offset.gt(0) then
    if !shape.isWithout(!pos) then
      !result = 1
    else
      !result = -1
    endif
  elseif !offset.lt(0) then
    if !shape.isWithin(!pos) then
      !result = 1
    else
      !result = -1
    endif
  endif

  return !result

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      autoXoffset
--
-- Description: set sign of offset automatically
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .autoOffset()

  -- exit if relevant flag is off
  if !this.autoOffset.not() then
    return
  endif

  if !this.vertex().size().geq(3) then
    !xoffset = !this.getXoffset()
    if !this.xoffset.neq(!xoffset) then
      !this.xoffset(!xoffset)
    endif
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      eq
--
-- Description: compare equality of two objects
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLHANDRAIL Compared object
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .eq(!that is ASLHANDRAIL) is BOOLEAN

  -- only the principal members are compared here
  -- all other members (temporary data, graphical settings, etc.) are ignored
  if !this.rpath.neq(!that.rpath) then
    return false
  elseif !this.tmplReference.neq(!that.tmplReference) then
    return false
  elseif !this.position.neq(!that.position) then
    return false
  elseif !this.orientation.neq(!that.orientation) then
    return false
  elseif !this.postSpacing.neq(!that.postSpacing) then
    return false
  elseif !this.tangentSpacing.neq(!that.tangentSpacing) then
    return false
  elseif !this.endSpacing.neq(!that.endSpacing) then
    return false
  elseif !this.railSpacing.neq(!that.railSpacing) then
    return false
  elseif !this.radius.neq(!that.radius) then
    return false
  elseif !this.xoffset.neq(!that.xoffset) then
    return false
  elseif !this.name.neq(!that.name) then
    return false
  elseif !this.description.neq(!that.description) then
    return false
  elseif !this.number.neq(!that.number) then
    return false
  elseif !this.area.neq(!that.area) then
    return false
  elseif !this.endTermination.neq(!that.endTermination) then
    return false
  elseif !this.endTerminationTmpl.neq(!that.endTerminationTmpl) then
    return false
  elseif !this.startTermination.neq(!that.startTermination) then
    return false
  elseif !this.startTerminationTmpl.neq(!that.startTerminationTmpl) then
    return false
  endif

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      insertgate
--
-- Description: insert new gate - snap position to nearest edge and create starting/ending vertices
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      POSITION      gate position
--
-- Return:
--   [Data Type]       [Description]
--    ASLHANDRAILMEMB   created gate
--
------------------------------------------------------------------------

define method .insertGate(!atpos is POSITION) is ASLHANDRAILMEMB

  !width = REAL()

  return !this.insertGate(!atpos,!width)

endmethod
-- end of method


------------------------------------------------------------------------
--
-- Method:      insertgate
--
-- Description: insert new gate - snap position to nearest edge and create starting/ending vertices
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      POSITION      gate position
--    2   R      REAL          gate width
--
-- Return:
--   [Data Type]       [Description]
--    ASLHANDRAILMEMB   created gate
--
------------------------------------------------------------------------

define method .insertGate(!atpos is POSITION,!width is REAL) is ASLHANDRAILMEMB

  -- returned errors:
  -- 1 no nearest edge found
  -- 2 one or both ends of gate exceeds the edge
  -- 3 edge is too short for gate

  -- find edge
  !edge = !this.rpath.near(!atpos,!this.closeFlag)
  if !edge.size().eq(0) then
  -- no valid segment found - return error
    return error 1 'No valid handrail segment found for GATE'
  endif

  -- get index and line
  !index = !edge.minindex()
  !line = !edge[!index]

  -- snap pos on line
  !gatepos = !line.near(!atpos)

  -- compose GATE data
  !data = object ANYDATASET()
  !data.setAttribute('posref',!index)
  if !width.set() then
    !data.setAttribute('width',!width)
  endif

  -- create gate object
  !refe = !this.getRemovedRef('GATE')
  !gate = object ASLHANDRAILMEMB('HRGATE',0,!data,!refe)

  return !this.insertGate(!gate, !index, !line, !gatepos)

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      insertgate
--
-- Description: insert new gate - internal method
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   R      ASLHANDRAILMEMB   gate position
--    2   R      REAL              vertex index
--    3   R      LINE              handrail segment
--    4   R      POSITION          gate position
--
-- Return:
--   [Data Type]       [Description]
--    ASLHANDRAILMEMB   inserted gate
--
------------------------------------------------------------------------

define method .insertGate(!gate is ASLHANDRAILMEMB,!index is REAL,!line is LINE,!gatepos is POSITION) is ASLHANDRAILMEMB

  -- returned errors:
  -- 2 one or both ends of gate exceeds the edge
  -- 3 edge is too short for gate

  -- check if start and end of gate are within the edge
  !startpos = !gatepos.offset(!line.direction(),!gate.width / -2)
  !endpos   = !gatepos.offset(!line.direction(),!gate.width / 2)
  if !line.onProjected(!startpos).and(!line.onProjected(!endpos)).not() then
    return error 2 'Startpoint and/or Endpoint of the GATE is out of the handrail segment'
  endif


  -- if it is OK then check if edge is long enough for gate
  -- tolerance currently endSpacing
  !tolerance = !this.endSpacing
  if !line.startPosition.near(!startpos,!tolerance).or(!line.endPosition.near(!endpos,!tolerance)) then
    return error 3 'Handrail segment is too short to insert GATE'
  endif

  -- remove all posts on the edge
  !removedPosts = !this.removePosts(!index)

  -- remove all panels on the edge
  !removedPanels = !this.removePanels(!index)

  -- store original index
  !storeIndex = !index

  -- create starting vertex
  !index = !this.insertVertex('POINTR',!index,!startpos,0,nulref)
  !gate.posref = !index

  -- create ending vertex
  !index = !this.insertVertex('POINTR',!index,!endpos,0,nulref)

  -- append gate to object
  !this.gates.append(!gate)

  -- sort gates
  !this.sortGates()

  -- get index of new gate
  do !c indices !this.gates
    skip if !this.gates[!c].posref.neq(!gate.posref)
    !gateindex = !c
    break
  enddo

  -- update rpath segments to speed up calculation of posts
  !this.rpath.segment(!this.closeFlag)

  -- re-calculate posts on affected edges
  !newPosts = ARRAY()
  do !c from !storeIndex to !index
    !newPosts.appendarray(!this.getPosts(!c))
  enddo

  -- insert new posts to the list
  !this.insertMembers(!newPosts, !this.posts)
  !this.posts.compress()

  -- update sequence numbers on posts - just in case
  !this.updateSequence(!this.posts)

  -- recalculate panels on affected segments
  !newPanels = ARRAY()
  do !c from !storeIndex to !index
    !newPanels.appendarray(!this.getPanels(!c))
  enddo

  -- insert new panels into the list
  !this.insertMembers(!newPanels, !this.panels)
  !this.panels.compress()

  -- update sequence numbers
  !this.updateSequence(!this.panels)

  -- recalculate rails and kickplates
  !this.rails = !this.getRails()
  !this.kickplates = !this.getKickplates()

  -- update associated gadgets
  !this.gatesGadget()

  -- draw handrail
  !this.autoDraw()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

  return !this.gates[!gateindex]

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      gateposition
--
-- Description: move gate to position snapped to edge
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   RW     REAL          gate index
--    1   R      POSITION      gate position
--
-- Return:
--   [Data Type]  [Description]
--    ASLHANDRAILMEMB   moved gate
--
------------------------------------------------------------------------

define method .gatePosition(!index is REAL,!atpos is POSITION) is ASLHANDRAILMEMB

  -- returned errors:
  -- 1 no nearest edge found
  -- 2 one or both ends of gate exceeds the edge
  -- 3 edge is too short for gate

  -- init
  !oldpos = !this.gatePosition(!index)

  -- calculate new position
  !edge = !this.rpath.near(!atpos,!this.closeFlag)
  if !edge.size().eq(0) then
    return error 1 'No valid handrail segment found for GATE'
  endif
  !newpos = !edge.first().near(!atpos.wrt(world))
  -- exit if positions are the same
  if !newpos.eq(!oldpos) then
    !this.gatesGadget()
    return
  endif

  -- store object
  !backup = !this

  -- remove gate
  !this.autoDrawOff()
  !gate = !this.removeGate(!index)
  !this.autoDrawOn()

  -- get out gate refno from remove list
  !this.removedGates.remove(!this.removedGates.findfirst(!gate.refe))
  handle ANY
  endhandle

  -- re-insert gate
  !edge = !this.rpath.near(!atpos,!this.closeFlag)
  if !edge.size().eq(0) then
  -- no valid segment found - return error
    !this = !backup
    !this.gatesGadget()
    return error 1 'No valid handrail segment found for GATE'
  endif

  -- get vertex index and line
  !vertex = !edge.minindex()
  !line = !edge[!vertex]

  !gate = !this.insertGate(!gate, !vertex, !line, !newpos)
  handle ANY
    !this = !backup
    !this.gatesGadget()
    return error
  endhandle

  -- update associated gadgets
  !this.gatesGadget()

  !index = !gate.sequ
  return !gate

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      movegate
--
-- Description: move gate by distance from current position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        gate index
--    2   R      REAL        distance
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveGate(!index is REAL, !distance is REAL)

  -- compute gate position and moving direction
  !pos = !this.gatePosition(!index)
  !start = !this.gates[!index].posref
  !end = !start + 1
  !dir = !this.vertex()[!start].direction(!this.vertex()[!end])
  !newpos = !pos.offset(!dir,!distance)

  -- move gate
  !this.gatePosition(!index, !newpos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      movepost
--
-- Description: move post to position snapped to edge
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      REAL          post index
--    1   R      POSITION      post position
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .movePost(!index is REAL,!atpos is POSITION)

  -- init
  !vertex = !this.posts[!index].posref
  !zdist = 0

  -- calculate edge
  !edges = !this.rpath.edgeOf(!vertex,true)

  !snap = ARRAY()
  !dist = ARRAY()
  do !edge values !edges
    !type = !edge.objectType()
    if !type.eq('ARC') then
      !projpos = !edge.anglePosition(!edge.near(!atpos))
    else
      !projpos =!edge.near(!atpos)
    endif
    if !edge.onProjected(!projpos) then
      !snap.append(!projpos)
      !dist.append(!atpos.distance(!projpos))
    endif
  enddo

  !newIndices = !dist.sortedIndices()
  !snap.reindex(!newIndices)
  if !snap.unset() then
    return error 1 'Cannot move HRPOST to position specified'
  endif

  !pos = !snap.first()
  do !edge values !edges
    !edgeleng = !edge.length()
    if !edge.on(!pos) then
      if !edge.objectType().eq('ARC') then
        !tmparc = !edge.endPosition(!pos)
        !zdist = !zdist + !tmparc.length()
      else
        !zdist = !zdist + !edge.startPosition.distance(!pos)
      endif
      break
    else
      !zdist = !zdist + !edgeleng
    endif
  enddo

  !this.posts[!index].zdis = !zdist
  !this.posts[!index].position = !pos

  -- rebuild panels
  !this.removePanels(!vertex)
  !newPanels = !this.getPanels(!vertex)
  !this.insertMembers(!newPanels, !this.panels)

  -- draw handrail
  !this.autoDraw()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

endmethod
-- end of method


------------------------------------------------------------------------
--
-- Method:      updatePosrefs
--
-- Description: update posref staref and endref of all handrail members
--
-- Method Type: procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      ARRAY         old indexes
--    2   R      ARRAY         new indexes
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .updatePosrefs(!oldIndices is ARRAY,!newIndices is ARRAY)

  -- update all gates
  do !c indices !this.gates
    !posref = !this.gates[!c].posref
    !index = !oldIndices.findfirst(!posref)
    if !index.set() then
      !posref = !newIndices[!index]
      !this.gates[!c].posref = !posref
    endif
  enddo

  -- update all posts
  !prevPosref = 0
  !index = REAL()
  do !c indices !this.posts
    !posref = !this.posts[!c].posref
    if !posref.gt(!prevPosref) then
      !index = !oldIndices.findfirst(!posref)
      !prevPosref = !posref
    endif
    if !index.set() then
      !posref = !newIndices[!index]
      !this.posts[!c].posref = !posref
    endif
  enddo

  -- update all panels
  !prevPosref = 0
  !index = REAL()
  do !c indices !this.panels
    !posref = !this.panels[!c].posref
    if !posref.gt(!prevPosref) then
      !index = !oldIndices.findfirst(!posref)
      !prevPosref = !posref
    endif
    if !index.set() then
      !posref = !newIndices[!index]
      !this.panels[!c].posref = !posref
    endif
  enddo

  -- update all rails
  do !c indices !this.rails
    !staref = !this.rails[!c].staref
    !endref = !this.rails[!c].endref
    !staindex = !oldIndices.findfirst(!staref)
    !endindex = !oldIndices.findfirst(!endref)
    if !staindex.set() then
      !staref = !newIndices[!staindex]
      !this.rails[!c].staref = !staref
    endif
    if !endindex.set() then
      !endref = !newIndices[!endindex]
      !this.rails[!c].endref = !endref
    endif
  enddo

  -- update all kickplates
  do !c indices !this.kikcplates
    !staref = !this.kickplates[!c].staref
    !endref = !this.kickplates[!c].endref
    !staindex = !oldIndices.findfirst(!staref)
    !endindex = !oldIndices.findfirst(!endref)
    if !staindex.set() then
      !staref = !newIndices[!staindex]
      !this.kickplates[!c].staref = !staref
    endif
    if !endindex.set() then
      !endref = !newIndices[!endindex]
      !this.kickplates[!c].endref = !endref
    endif
  enddo

endmethod
-- end of method


------------------------------------------------------------------------
--
-- Method:      updateSequence
--
-- Description: update sequence number of passed members (array)
--
-- Method Type: procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   RW     ARRAY         array of ASLHANDRAILMEMB objects
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .updateSequence(!members is ARRAY)

  do !c indices !members
    !members[!c].sequ = !c
  enddo

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      sortGates
--
-- Description: sort gates order based on posref and update sequence numbers
--
-- Method Type: procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type]  [Description]
--    ARRAY        array of sorted indices
--
------------------------------------------------------------------------

define method .sortGates() is ARRAY

  -- sort gates
  !newIndices = !this.gates.evaluate(object BLOCK('!this.gates[!evalindex].posref')).sortedIndices()
  !this.gates.reindex(!newIndices)

  -- update sequence numbers
  !this.updateSequence(!this.gates)

  return !newIndices

endmethod
-- end of method


------------------------------------------------------------------------
--
-- Method:      gatewidth
--
-- Description: set with of the gate and move associated vertices while gate position is kept
--
-- Method Type: procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      REAL          gate index
--    2   R      REAL          new width of gate
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .gateWidth(!index is REAL, !width is REAL)

  -- store autodraw flag and set it to false
  !storeAutoDraw = !this.autoDraw
  !this.autoDraw = false

  -- store autoUpdate flag and set it to false
  !storeAutoUpdateDb = !this.autoUpdateDb
  !this.autoUpdateDb = false

  !origWidth = !this.gates[!index].width
  !extension = (!width - !origWidth) / 2
  !this.extendGateStart(!index, !extension )
  !this.extendGateEnd(!index, !extension )

  -- reset flags to original value
  !this.autoDraw = !storeAutoDraw
  !this.autoUpdateDb = !storeAutoUpdateDb

  -- update associated gadgets
  !this.gatesGadget()

  -- draw handrail
  !this.autoDraw()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      extendgatestart
--
-- Description: extend gate startPosition and move associated vertex while the gate endPosition is kept
--
-- Method Type: procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      REAL          gate index
--    2   R      REAL          gate extension
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .extendGateStart(!index is REAL, !distance is REAL)

  -- init
  !gate = !this.gates[!index]
  !posref = !gate.posref
  !next = !this.rpath.nextPointOf(!posref)
  !prev = !this.rpath.prevPointOf(!posref)
  !startpos = !this.vertex()[!posref]
  !endpos = !this.vertex()[!next]
  !movedir = !startpos.direction(!endpos).opposite()

  -- move start vertex
  !newpos = !startpos.offset(!movedir,!distance)
  !this.rpath.vertex[!posref] = !newpos

  -- remove preceding posts and panels
  !removedPosts  = !this.removePosts(!prev)
  !removedPanels = !this.removePanels(!prev)

  -- update rpath segments to speed up calculation of posts
  !this.rpath.segment(!this.closeFlag)

  --rebuild preceding posts
  !newPosts = !this.getPosts(!prev)
  !this.insertMembers(!newPosts, !this.posts)
  !this.posts.compress()

  -- update post at start of gate
  do !c indices !this.posts
    if !this.posts[!c].posref.eq(!posref) then
      !this.posts[!c].position = !newpos
    endif
  enddo

  --rebuild preceding panels
  !newPanels = !this.getPanels(!prev)
  !this.insertMembers(!newPanels, !this.panels)
  !this.panels.compress()


  -- update width
  !width = !gate.width + !distance
  !this.gates[!index].width(!width)

  -- update posts sequence numbers
  !this.updateSequence(!this.posts)
  !this.updateSequence(!this.panels)

  -- draw handrail
  if !this.autoDraw then
    -- update associated gadgets
    !this.gatesGadget()
    !this.autoDraw()
  endif

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      extendgateend
--
-- Description: extend gate endposition and move associated vertex while the gate startposition is kept
--
-- Method Type: procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      REAL          gate index
--    2   R      REAL          gate extension
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

define method .extendGateEnd(!index is REAL, !distance is REAL)

  -- init
  !gate = !this.gates[!index]
  !posref = !gate.posref + 1
  !prev = !this.rpath.prevPointOf(!posref)
  !startpos = !this.rpath.vertex[!prev]
  !endpos = !this.rpath.vertex[!posref]
  !movedir = !startpos.direction(!endpos)

  -- move start vertex
  !newpos = !endpos.offset(!movedir,!distance)
  !this.rpath.vertex[!posref] = !newpos

  -- remove consecutive posts and panels
  !removedPosts  = !this.removePosts(!posref)
  !removedPanels = !this.removePanels(!posref)

  -- update rpath segments to speed up calculation of posts
  !this.rpath.segment(!this.closeFlag)

  --rebuild consecutive posts and panels
  !newPosts = !this.getPosts(!posref)
  !this.insertMembers(!newPosts, !this.posts)
  !this.posts.compress()

  !newPanels = !this.getPanels(!posref)
  !this.insertMembers(!newPanels,!this.panels)
  !this.panels.compress()

  -- update width
  !width = !gate.width + !distance
  !this.gates[!index].width(!width)

  -- update posts and panels sequence numbers
  !this.updateSequence(!this.posts)
  !this.updateSequence(!this.panels)

  -- draw handrail
  if !this.autoDraw then
    -- update associated gadgets
    !this.gatesGadget()
    !this.autoDraw()
  endif

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      rebuild
--
-- Description: rebuild all posts, rails and kickplates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rebuild()

  !this.posts = !this.getPosts()
  !this.rails = !this.getRails()
  !this.kickplates = !this.getKickplates()
  !this.panels()

  -- set proper offset sign
  !this.autoOffset()

  -- draw handrail
  !this.autoDraw()

  -- update db
  if !this.autoUpdateDb then
    !this.updateDb()
  endif

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      trackStrflt
--
-- Description: return routing points along left or right side of passed stair flight
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Stair flight
--    1   R      STRING      "L" or "R"
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       ARRAY of points in usual format (position, type, detail)
--
------------------------------------------------------------------------

define method .trackStrflt(!stair is ANY, !side is STRING) is ARRAY

  -- init
  !route = ARRAY()
  !just = !this.getJustification(!this.tmplReference)

  if !just.eq('M') then
    !xtra = !this.getActualXoffset(!this.tmplReference)
  else
    !xtra = 0
  endif

  !!currentHandrailRadius = !this.radius
  !route = !!aslGetStrfltEdge(!stair,!side & !just,!xtra,true)

  return !route

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getJustification
--
-- Description: return justification of handrail on stair stringer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       handrail assembly template
--
-- Return:
--   [Data Type] [Description]
--    STRING      M (middle of stringer)  or E (edge of stringer) or I (inner side of stringer)
--
------------------------------------------------------------------------

define method .getJustification(!tmpl is DBREF) is STRING

  !func = !tmpl.func.trim().upcase()
  handle ANY
    !func = ''
  endhandle

  if !func.eq('EDGE') then
    !just = 'E'
  elseif !func.eq('MIDDLE') then
    !just = 'M'
  elseif !func.eq('INSIDE') then
    !just = 'I'
  else
    !just = 'M'
    -- try to get the info from template
    !posts = !!collectAllFor('HRPOST','',!tmpl)
    if !posts.set() then
      if !posts[1].xoff.gt(0) then
        !just = 'E'
      endif
    else
      !panels = !!collectAllFor('HRPANE','',!tmpl)
      if !panels.set() then
        if !panels[1].xoff.gt(0) then
          !just = 'E'
        endif
      endif
    endif
  endif

  return !just

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getActualXoffset
--
-- Description: get actual xoffset from posts or panels
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       handrail assembly template
--
-- Return:
--   [Data Type] [Description]
--    REAL        offset in distance units
--
------------------------------------------------------------------------

define method .getActualXoffset(!tmpl is DBREF) is REAL

  -- init
  !xoff = 0
  !postTemplate = !this.postTemplate(!tmpl)
  !panelTemplate = !this.panelTemplate(!tmpl)

  if !postTemplate.badref().not() then
    !xoff = !postTemplate.xoffset
  elseif !panelTemplate.set() then
    if !panelTemplate.first().badref().not() then
      !xoff = !panelTemplate.first().xoffset
    endif
  endif

  !xoff = !xoff * -1

  return !xoff

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addToAidnumbers
--
-- Description: Register the object within !!aidNumbers global object and obtain the aid graphic number from it
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addToAidNumbers()

  !this.aidNumber = !!aidNumbers.add('ASL Handrail object')

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      gatePosition
--
-- Description: returns position of gate of passed index
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        gate index
--
-- Return:
--   [Data Type] [Description]
--    POSITION    gate position
--
------------------------------------------------------------------------

define method .gatePosition(!index is REAL) is POSITION

  !gate = !this.gates[!index]

  !start = !this.rpath.vertex[!gate.posref]
  !end   = !this.rpath.vertex[!gate.posref + 1]
  !pos = !start.midpoint(!end).wrt(world)

  return !pos

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      vertexIsGate
--
-- Description: returns true if vertex is startpoint or endpoint of the gate otherwise false
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .vertexIsGate(!index is REAL) is BOOLEAN

  !result = false

  do !gate values !this.gates
    !result = !gate.posref.eq(!index).or(!gate.posref.eq(!index - 1))
    break if !result
  enddo

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      vertexIsGateStart
--
-- Description: returns true if vertex is startpoint of the gate otherwise false
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .vertexIsGateStart(!index is REAL) is BOOLEAN

  !result = false

  do !gate values !this.gates
    !result = !gate.posref.eq(!index)
    break if !result
  enddo

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      vertexIsGateEnd
--
-- Description: returns true if vertex is endpoint of the gate otherwise false
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .vertexIsGateEnd(!index is REAL) is BOOLEAN

  !result = false

  do !gate values !this.gates
    !result = !gate.posref.eq(!index - 1)
    break if !result
  enddo

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      lastvertex
--
-- Description: return index of last (non-gate) vertex that can be manipulated explicitly
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        vertex index
--
------------------------------------------------------------------------

define method .lastVertex() is REAL

  !maxIndex = !this.vertex().maxIndex()
  !last = 0
  do !c from !maxIndex to 0 by - 1
    skip if !this.vertexIsGate(!c)
    break if !c.eq(0)
    !last = !c
    break
  enddo

  return !last

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      remFromAidnumbers
--
-- Description: Un register the object from !!aidNumbers global object, remove the graphic and make the aid number unset
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remFromAidNumbers()

  !!aidNumbers.remove(!this.aidNumber)
  !this.aidNumber = REAL()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      vertex
--
-- Description: return vertex array of ASLRPATH object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       position array
--
------------------------------------------------------------------------

define method .vertex() is ARRAY

  return !this.rpath.vertex

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      type
--
-- Description: return type of vertex array of ASLRPATH object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       string array
--
------------------------------------------------------------------------

define method .type() is ARRAY

  return !this.rpath.type

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      detail
--
-- Description: return detail vertex array of ASLRPATH object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       mixed array
--
------------------------------------------------------------------------

define method .detail() is ARRAY

  return !this.rpath.detail

endmethod
-- End of method

------------------------------------------------------------------------
------------------------------------------------------------------------
-- All methods defined below are only used to communicate to associated gadgets.
-- They do not actually modify the object itself or any other data contained
-- within object.
------------------------------------------------------------------------
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      railSpacingGadget
--
-- Description: update gadget with current values and set editable status
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     editable status of the gadget
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .railSpacingGadget(!editable is BOOLEAN)

  -- always set the boolean member
  !this.railSpacingEditable = !editable

  -- init
  !railSpacing = !this.railSpacing
  !gadget = !this.railSpacingGadget

  if !gadget.unset() then
    return
  endif

  -- setup formatting objects
  !fmt = !!distanceFmt
  -- Round down to nearest mm (only for current units MM)
  if (!!isImperialLength('DIST').not()) then
    !testUnit = 1mm
    !unitQualifier = !testUnit.units().unitQualifier().upcase()
    if( !unitQualifier eq 'MM' ) then
      !fmt.dp = 0
    elseif( !unitQualifier eq 'METRE' ) then
      !fmt.dp = 3
    else
      !fmt.dp = 2
    endif
  endif

  if !gadget.type().eq('TEXTPANE') then
    !val = ARRAY()
    do !rail values !railSpacing
      !val.append(!rail.string(!fmt))
    enddo
  elseif !gadget.type().eq('TEXT') then
    !val = ''
    !spaceFound = false
    do !rail values !railSpacing
      !strRail = !rail.string(!fmt)
      handle ANY
        skip
      endhandle
      if !strRail.match(' ').boolean() then
        !spaceFound = true
      endif
    enddo
    if !spaceFound then
      !delim = ' ; '
    else
      !delim = ' '
    endif
    do !rail values !railSpacing
      !val = !val & !delim & !rail.string(!fmt)
    enddo
    !val = !val.trim().trim('L',';').trim()
  endif

  -- set gadget and editable status
  !gadget.val = !val
  !gadget.setEditable(!editable)

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      gatesGadget
--
-- Description: Update gate gadget with current value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gatesGadget()

  -- init
  !gates = !this.gates
  !gadget = !this.gatesGadget

  if !gadget.unset() then
    return
  endif

  !form = !gadget.owner()
  !gadgetControl = !this.gatesControl

  using namespace  'Aveva.Pdms.Presentation'

  -- set heading
  !title = 'Gates'
  !heading[1] = 'No'
  !heading[2] = 'Width'
  !heading[3] = 'Position'

  -- compose gate data
  !rows = ARRAY()
  do !c indices !gates
    !gate = !gates[!c]
    !col[1] = !c.string()
    !col[2] = !gate.width.string(!!distanceFmt)
    !pos = !this.gatePosition(!c)
    !col[3] = !pos.string().before('WRT').trim()
    !rows[!c] = !col
  enddo

  !dataSource = object NETDATASOURCE(!title, !heading, !rows)
  !dataSource.rowTag(5)
  !form.attribute(!gadgetControl).bindToDataSource(!dataSource)
  !form.attribute(!gadgetControl).seteditableColumn(1,false)
  !form.attribute(!gadgetControl).editableGrid(!rows.set())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updategadget
--
-- Description: populate passed gadget with the passed value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      gadget to be updated
--    2   R      ANY         value to be populated with - data type must conform to gadget type
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateGadget(!gadget is GADGET,!value is ANY)

  if !gadget.unset() then
    return
  endif

  !gadget.val = !value

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      setgadget
--
-- Description: set the reference to the gadget and update it
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      "gadget" member name
--    2   RW     GADGET      gadget to be referenced
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setGadget(!gadgetName is STRING,!gadget is GADGET)

  !this.setGadget(!gadgetName, !gadget, STRING())

endmethod
-- end of method


------------------------------------------------------------------------
--
-- Method:      setgadget
--
-- Description: set the reference to the gadget and gadget's control (NETGRIDCONTROL) and update it
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      "gadget" member name
--    2   RW     GADGET      gadget to be referenced
---   3   R      STRING      name of associated NETGRIDCONTROL object - unset if gadget doesn't have one
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setGadget(!gadgetName is STRING,!gadget is GADGET,!gadgetControl is STRING)

  -- copy gadgetname in upper case
  !gname = !gadgetName.upcase()

  -- set reference to gadget
  !this.attribute(!gname) = !gadget

  -- get name of member associated to gadget
  if !gname.eq('POSTSPACINGGADGET') then
    !attr = 'POSTSPACING'
    !this.setGadgetActiveStatus(!gadget,!this.isPanelised.not())
  elseif !gname.eq('ENDSPACINGGADGET') then
    !attr = 'ENDSPACING'
    !this.setGadgetActiveStatus(!gadget,!this.isPanelised.not())
  elseif !gname.eq('TANGENTSPACINGGADGET') then
    !attr = 'TANGENTSPACING'
    !this.setGadgetActiveStatus(!gadget,!this.isPanelised.not())
  elseif !gname.eq('CLOSEFLAGGADGET') then
    !attr = 'CLOSEFLAG'
  elseif !gname.eq('RAILSPACINGGADGET') then
    !attr = 'RAILSPACING'
  elseif !gname.eq('GATESGADGET') then
    !attr = 'GATES'
  elseif !gname.eq('RADIUSGADGET') then
    !attr = 'RADIUS'
    !this.setGadgetActiveStatus(!gadget,!this.isPanelised.not())
    !gadget.setEditable(!this.criteria.bradius.min.neq(!this.criteria.bradius.max))
  elseif !gname.eq('NAMEGADGET') then
    !attr = 'NAME'
  elseif !gname.eq('DESCRIPTIONGADGET') then
    !attr = 'DESCRIPTION'
  elseif !gname.eq('NUMBERGADGET') then
    !attr = 'NUMBER'
  elseif !gname.eq('AREAGADGET') then
    !attr = 'AREA'
  endif

  -- update gadget
  !value = !this.attribute(!attr)
  if !attr.eq('RAILSPACING') then
    !this.railSpacingGadget(!this.railSpacingEditable)
  elseif !attr.eq('GATES') then
    !this.gatesControl = !gadgetControl.upcase()
    !this.gatesGadget()
  else
    !this.updateGadget(!gadget,!value)
  endif

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      setGadgetActiveStatus
--
-- Description: set active status of the gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      gadget to be set
--    2   R      BOOLEAN     active status
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setGadgetActiveStatus(!gadget is GADGET, !active is BOOLEAN)

  if !gadget.unset() then
    return
  endif

  !gadget.active = !active
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      settmplrefgadget
--
-- Description: set the reference to the template ref. list gadget and return list of templates
--
-- Method Type: function/procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      gadget to be referenced
--
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       list of available handrail templates
--
------------------------------------------------------------------------

define method .setTmplrefGadget(!gadget is GADGET) is ARRAY

  !this.tmplReferenceGadget = !gadget

  !tmpl = !!aslCentralData.getTemplates('HANDRA')
  !gadget.dtext = !tmpl.evaluate(object BLOCK('!tmpl[!evalindex].desc'))

  !this.updateTmplrefGadget(!tmpl)

  return !tmpl

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      setTerminationGadgets
--
-- Description: set the references to start/end termination gadget and return list of templates
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      start termination gadget to be referenced
--    2   RW     GADGET      end termination gadget to be referenced
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       list of handrail termination templates
--
------------------------------------------------------------------------

define method .setTerminationGadgets(!start is GADGET,!end is GADGET) is ARRAY

  !this.startTerminationTmplGadget = !start
  !this.endTerminationTmplGadget = !end

  !tmpl = !this.getTerminationTmpl(!this.tmplReference)
  !tmplReindex[1] = nulref
  !tmplReindex[2] = nulref
  !dtext[1] = 'None'
  !dtext[2] = 'Post only'
  do !c indices !tmpl
    !tmplReindex.append(!tmpl[!c])
    !dtext.append(!tmpl[!c].desc)
  enddo

  !start.dtext = !dtext
  !end.dtext = !dtext

  !this.updateTerminationGadget(!start,!tmplReindex)
  !this.updateTerminationGadget(!end,!tmplReindex)

  !this.startTerminationTmplGadget.active = !this.isPanelised.not()
  !this.endTerminationTmplGadget.active = !this.isPanelised.not()

  return !tmplReindex

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateterminationgadget
--
-- Description: update the termination reference list gadget with current value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     STRING      termination identifier (START/END)
--    1   RW     ARRAY       list of templates (DBREF ARRAY)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateTerminationGadget(!gadget is GADGET,!tmplList is ARRAY)

  if !gadget.unset() then
    return
  endif

  if !gadget.name().eq('TERMINATIONSTART') then
    !end = 'START'
  elseif !gadget.name().eq('TERMINATIONEND') then
    !end = 'END'
  else
    return
  endif
  !termination = !this.attribute(!end + 'TERMINATION')
  !template = !this.attribute(!end + 'TERMINATIONTMPL')

  if !termination.eq('NONE') then
    !value = 1
  elseif !termination.eq('POST') then
    !value = 2
  else
    !value = !tmplList.findfirst(!template)
    if !value.unset() then
      !tmplList.append(!template)
      !dtext = !gadget.dtext
      !dtext.append(!template.desc)
      !gadget.dtext = !dtext
      !value = !dtext.size()
    endif
  endif
  !gadget.val = !value

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      updatetmplrefgadget
--
-- Description: update the template reference list gadget with current value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       list of templates (DBREF ARRAY)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateTmplrefGadget(!tmplList is ARRAY)

  if !this.tmplReferenceGadget.unset() then
    return
  endif

  !value = !tmplList.findfirst(!this.tmplReference)
  if !value.unset() then
    !tmplList.append(!this.tmplReference)
    !dtext = !this.tmplReferenceGadget.dtext
    !dtext.append(!this.tmplReference.desc)
    !this.tmplReferenceGadget.dtext = !dtext
    !value = !dtext.size()
    -- display warning
    !!alert.warning('Handrail template "' & !this.tmplReference.desc & '" is out of ASL selection. Contact your ASL administrator.')
  endif
  !this.tmplReferenceGadget.val = !value

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      roundDown()
--
-- Description: Round down a value to nearest 1mm or 1/32 inch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Original value
-- Return:
--   [Data Type] [Description]
--    REAL        rounded value
--
------------------------------------------------------------------------
define method .roundDown(!value is REAL) is REAL

  !format           = object FORMAT()
  !format.dimension = 'L'
  if (!!isImperialLength('DIST')) then
    -- round down to 1/32 inch
    !tempValue            = !!comValueConvert(!value,'INCH')
    !format.units         = 'INCH'
    !format.inchSeparator = '.'
    !format.denominator   = 32
    !format.fraction      = true
    !tempValue            = !tempValue.string(!format).real(!format)
    if( !tempValue gt !value ) then
      -- Subtract 1/32nd inch to round down
      !tempValue = !tempValue - 1/32in
    endif
  else
    -- Round down to zero DP
    !tempValue      = !!comValueConvert(!value,'MM')
    !format.units   = 'MM'
    !tempValue      = !tempValue.string('D0').real(!format)
  endif

  return !tempValue

endmethod
-- End of method definition
