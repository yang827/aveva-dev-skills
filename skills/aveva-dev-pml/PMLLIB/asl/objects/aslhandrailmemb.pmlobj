--   Module:        Design
--   Replaces:
--
-- Author:          Karel Pleschner
-- Created:         Mon Sep 26 11:36:00 GMT 2007
--
-- Description:     Object to hold definition of various HANDRA members
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslhandrailmemb()                -                   Default constructor
--  aslhandrailmemb(DBREF)           -                   Constructor
--  aslhandrailmemb(DBREF,DBREF)     -                   Constructor
--  aslhandrailmemb(STRING,REAL,ANYDATASET,DBREF) -
--  draw(ASLHANDRAIL,REAL,REAL,REAL) ASLHANDRAILMEMB     draw the handrail member as aid graphic
--  enhance()                        -                   enhances the element
--  getEndref(ASLHANDRAIL)           DBREF
--  getPosref(ASLHANDRAIL)           DBREF
--  getStaref(ASLHANDRAIL)           DBREF
--  position(STRING,ARRAY)           POSITION            get position of member
--  string()                         STRING              convert object to string
--  unEnhance()                      -                   unenhances the element
--  updateDB()                       DBREF               updates HANDRAIL member
--  updateGate()                     DBREF               updates HRGATE element
--  updateKickpl()                   DBREF               update KICKPL element
--  updatePanel()                    DBREF
--  updatePost()                     DBREF               update HRPOST element
--  updateRail()                     DBREF               update HRPANE element
--  width(REAL)                      -                   sets GATE width and zdistance
--  xoffset()                        REAL                return calculated value of xoffset
--  xoffset(REAL)                    -                   change an offset inclination
--
define object ASLHANDRAILMEMB

  -- public members
  ---------------------------------------------------------------------------

  -- member type
  member .type      is STRING

  -- owner type
  member .otype     is STRING

  -- member reference
  member .refe      is DBREF

  -- owner reference
  member .owner     is DBREF

  -- sequence number
  member .sequ      is REAL

  -- owner sequence numb
  member .ownerSequ is REAL

  -- reference to vertex
  member .posref    is REAL

  -- reference to vertex
  member .staref    is REAL

  -- reference to vertex
  member .endref    is REAL

  -- reference to template to be copied
  member .tmplref is   DBREF

  -- attribute mapping
  member .desp       is ARRAY
  member .spref      is DBREF
  member .matref     is DBREF
  member .width      is REAL
  member .height     is REAL
  member .zdis       is REAL
  member .szdis      is REAL
  member .ezdis      is REAL
  member .pkdis      is REAL
  member .spkdis     is REAL
  member .epkdis     is REAL
  member .xoffset    is REAL
  member .zoffset    is REAL
  member .ydir       is DIRECTION
  member .zdir       is DIRECTION
  member .paneSize   is ARRAY
  member .lmirror    is BOOLEAN
  member .drns       is DIRECTION
  member .drne       is DIRECTION
  member .rise       is REAL
  member .bang       is REAL
  member .leng       is REAL

  -- position for aid graphic
  member .position   is POSITION

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      aslhandrailmemb
--
-- Description: Default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslhandrailmemb()

  -- owner sequence number
  !this.ownerSequ = 1

  -- init distances
  !this.zdis = 0
  !this.szdis = 0
  !this.ezdis = 0
  !this.pkdis = 0
  !this.spkdis = 0
  !this.epkdis = 0

  -- init some specific dimensions
  !this.height = 2200mm
  !this.bang = 0
  !this.rise = 0

  -- inside/outside offset inclination
  !this.xoffset = 1

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gate
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of member
--    2   R      REAL        sequence number
--    2   R      ARRAY       heterogeneous array with arguments depended on type
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslhandrailmemb(!type is STRING, !sequ is REAL, !data is ANYDATASET, !refe is DBREF)

  -- initialise
  !this.aslhandrailmemb()
  !this.type = !type.upcase()
  !this.sequ = !sequ
  !this.refe = !refe
  if !refe.badref().not() then
    !this.owner = !refe.owner
  endif

  if !this.type.eq('HRGATE') then
    -- gate defaults
    !this.width(1000mm)
    -- type HRGATE
    -- data:
    -- posref (REAL)
    -- width (REAL) - OPTIONAL
    -- height (REAL) - OPTIONAL
    -- spref (DBREF) - OPTIONAL
    -- desp (ARRAY) - OPTIONAL
    !this.otype = 'HRFEAT'
    !data.copyAttributesTo(!this)
  elseif !this.type.eq('HRPOST') then
    -- type HRPOST
    -- data:
    -- posref (REAL)
    -- zdis (REAL)
    -- tmplref (DBREF)
    -- position (POSITION) - derived position to avoid computation each time is needed (to speed up aid graphic performance)
    -- xoffset (REAL)
    !this.otype = 'POSTSE'
    !data.copyAttributesTo(!this)
    !this.bang = !this.xoffset.acos()
  elseif !this.type.eq('RAIL') then
    -- type RAIL
    -- data:
    -- ownerSequ (REAL)
    -- staref (REAL)
    -- endref (REAL)
    -- tmplref (DBREF)
    -- xoffset (REAL) - rail xoffset inclination (1 or -1)
    -- zoffset (REAL)
    -- szdis  (REAL) - OPTIONAL
    -- ezdis (REAL) - OPTIONAL
    -- drns (DIRECTION) - OPTIONAL start dir.
    -- drne (DIRECTION) - OPTIONAL end dir.
    !this.otype = 'RAILSE'
    !data.copyAttributesTo(!this)
  elseif !this.type.eq('KICKPL') then
    -- type KICKPL
    -- data:
    -- staref (REAL)
    -- endref (REAL)
    -- tmplref (DBREF.)
    -- xoffset (REAL)
    !this.otype = 'HRKPSE'
    !data.copyAttributesTo(!this)
  elseif !this.type.eq('HRPANE') then
    -- type HRPANE
    -- data:
    -- posref (REAL) - sequence number of vertex/point which is connected to
    -- zdis (REAL_ - zdistance from vertex
    -- tmplref (DBREF)
    -- length (REAL) - panel length
    -- rise (REAL) - panel rise
    -- xoffset (REAL)
    !this.otype = 'HRPNSE'
    !data.copyAttributesTo(!this)
    !this.paneSize = !this.tmplref.paneSize
    !this.paneSize[1] = !data.getAttribute('length')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aslhandrailmemb
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference
--    2   R      DBREF       template ref.
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslhandrailmemb(!refe is DBREF,!tmpl is DBREF)

  !this.aslhandrailmemb(!refe)
  !this.tmplref = !tmpl

  !offsetIncl = !refe.xoffset.gt(0)
  !tmplOffsetIncl = !tmpl.xoffset.gt(0)

  if !offsetIncl.neq(!tmplOffsetIncl) then
    !this.xoffset(-1)
  endif

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      aslhandrailmemb
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslhandrailmemb(!refe is DBREF)

  !this.aslhandrailmemb()
  !this.refe = !refe
  !this.owner = !refe.owner
  !this.sequ = !refe.tysequ
  !this.ownerSequ = !refe.owner.tysequ
  !this.type = !refe.type
  !this.otype = !refe.owner.type
  !this.matref = !refe.matref
  !this.tmplref = !refe.asstmp

  if !refe.type.eq('HRGATE') then

    if !refe.width.boolean() then
      !this.width = !refe.width
    endif
    if !refe.height.boolean() then
      !this.height = !refe.height
    endif
    !this.posref = !refe.posref.sequ
    handle ANY
      return error 1 'GATE is not associated with RPATH'
    endhandle
    !nextpoint = !refe.posref.owner.memb[!refe.posref.sequ + 1]
    handle NONE
      !width = !refe.posref.pos.distance(!nextpoint.pos)
      if !width.boolean() then
        !this.width = !width
      endif
    elsehandle ANY
    endhandle
    !this.zdis = 0
    !this.pkdis = 0.5

  elseif !refe.type.eq('HRPOST') then

    !this.zdis = !refe.zdis
    !this.pkdis = !refe.pkdis
    !this.posref = !refe.posref.sequ
    handle ANY
      return error 1 'POST is not associated with RPATH'
    endhandle
    !this.bang = !refe.bang

    !drns = !refe.drns
    handle ANY
    endhandle
    !drne = !refe.drne
    handle ANY
    endhandle
    !this.drns = !drns.wrt(world)
    handle ANY
      !this.drns = U wrt /*
    endhandle
    !this.drne = !drne.wrt(world)
    handle ANY
      !this.drne = D wrt /*
    endhandle

    !postpos = !refe.position.wrt(!refe)
    !postpos.up = !postpos.up - !refe.zoffs
    !postpos.east = !postpos.east - !refe.xoff
    !this.position = !postpos.wrt(worl)

  elseif !refe.type.eq('RAIL') then

    !this.zoffset = !refe.zoffset
    !this.staref = !refe.staref.sequ
    handle ANY
      !this.staref = 1
    endhandle
    !this.endref = !refe.endref.sequ
    handle ANY
    endhandle
    !this.szdis = !refe.szdis
    !this.spkdis = !refe.spkdis
    !this.ezdis = !refe.ezdis
    !this.epkdis = !refe.epkdis
    !this.drne = !refe.drne.wrt(world)
    handle ANY
    endhandle
    !this.drns = !refe.drns.wrt(world)
    handle ANY
    endhandle

  elseif !refe.type.eq('KICKPL') then

    !this.staref = !refe.staref.sequ
    handle ANY
      !this.staref = 1
    endhandle
    !this.endref = !refe.endref.sequ
    handle ANY
    endhandle
    !this.szdis = !refe.szdis
    !this.spkdis = !refe.spkdis
    !this.ezdis = !refe.ezdis
    !this.epkdis = !refe.epkdis
    !this.drne = !refe.drne.wrt(world)
    handle ANY
    endhandle
    !this.drns = !refe.drns.wrt(world)
    handle ANY
    endhandle

  elseif !refe.type.eq('HRPANE') then

    !this.zdis = !refe.zdis
    !this.pkdis = !refe.pkdis
    !this.posref = !refe.posref.sequ
    handle ANY
      return error 1 'PANEL is not associated with RPATH'
    endhandle
    !this.paneSize = !refe.paneSize
    !this.rise = !refe.rise
    !this.bang = !refe.bang
    !panepos = !refe.position.wrt(!refe)
    !panepos.up = !panepos.up - !refe.zoffs
    !panepos.east = !panepos.east - !refe.xoff
    !this.position = !panepos.wrt(worl)
  endif

  if !this.tmplref.badref().not() then
    !offsetIncl = !refe.xoffset.gt(0)
    !tmplOffsetIncl = !this.tmplref.xoffset.gt(0)
    if !offsetIncl.neq(!tmplOffsetIncl) then
      !this.xoffset = -1
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateGate
--
-- Description: updates HRGATE element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference to HRGATE
--
------------------------------------------------------------------------

define method .updateGate() is DBREF

  !this.refe.zdis = !this.zdis
  !this.refe.pkdis = !this.pkdis
  !this.refe.heig = !this.height
  !this.refe.width = !this.width

  !handrail = !this.refe.owner.owner
  !rpathref = !!dtbMemberOfType(!handrail,'RPATH',1)
  !this.refe.posref = !rpathref.memb[!this.posref]


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updatePost
--
-- Description: update HRPOST element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference to HRPOST
--
------------------------------------------------------------------------

define method .updatePost() is DBREF


  copy $!this.tmplref

  !this.refe.zdis = !this.zdis
  !this.refe.pkdis = !this.pkdis
  !this.refe.drns = !this.drns
  handle ANY
  endhandle
  !this.refe.drne = !this.drne
  handle ANY
  endhandle

  !this.refe.bang = !this.bang

  !handrail = !this.refe.owner.owner
  !rpathref = !!dtbMemberOfType(!handrail,'RPATH',1)
  !this.refe.posref = !rpathref.memb[!this.posref]

  -- offset
  !this.refe.xoffs = !this.xoffset()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateRail()
--
-- Description: update RAIL element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference to RAIL
--
------------------------------------------------------------------------

define method .updateRail() is DBREF


  !handrail = !this.refe.owner.owner
  !rpathref = !!dtbMemberOfType(!handrail,'RPATH',1)

  copy $!this.tmplref

  !this.refe.szdis = !this.szdis
  !this.refe.ezdis = !this.ezdis
  !this.refe.spkdis = !this.spkdis
  --!this.refe.epkdis = !this.epkdis
  epkdis $!this.epkdis
  !this.refe.staref = !rpathref.memb[!this.staref]
  !this.refe.endref = !rpathref.memb[!this.endref]
  if !this.drns.set() then
    if !this.drns.east.neq(0).or(!this.drns.north.neq(0)).and(!this.drns.up.neq(0)) then
      !this.refe.drns = !this.drns
    endif
  endif
  if !this.drne.set() then
    if !this.drne.east.neq(0).or(!this.drne.north.neq(0)).and(!this.drne.up.neq(0)) then
  !this.refe.drne = !this.drne
    endif
  endif

  -- offset
  !this.refe.xoffs = !this.xoffset()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updatePanel()
--
-- Description: update HRPANE element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference to RAIL
--
------------------------------------------------------------------------

define method .updatePanel() is DBREF


  !handrail = !this.refe.owner.owner
  !rpathref = !!dtbMemberOfType(!handrail,'RPATH',1)

  copy $!this.tmplref

  !this.refe.posref = !rpathref.memb[!this.posref]
  !this.refe.paneSize = !this.paneSize
  attrib zdis = $!this.zdis
  --!this.refe.zdis = !this.zdis

  !this.refe.pkdis = !this.pkdis

  !this.refe.rise = !this.rise
  !this.refe.bang = !this.bang

  -- offset
  !this.refe.xoffs = !this.xoffset()

  -- remove local criteria (DDAT) from panel
  !ddat = !!collectAllFor('DDAT','purp eq ''DFLT''',!this.refe)
  do !ce values !ddat
    !!ce = !ce
    unlock
    delete DDAT
  enddo
  if !!ce.type.eq('DDSE').and(!!ce.mcount.boolean().not()) then
    unlock
    delete DDSE
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateKickpl()
--
-- Description: update KICKPL element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference to KICKPL
--
------------------------------------------------------------------------

define method .updateKickpl() is DBREF

  !handrail = !this.refe.owner.owner
  !rpathref = !!dtbMemberOfType(!handrail,'RPATH',1)

  copy $!this.tmplref
  !this.refe.staref = !rpathref.memb[!this.staref]
  !this.refe.endref = !rpathref.memb[!this.endref]
  !this.refe.szdis = !this.szdis
  !this.refe.ezdis = !this.ezdis
  !this.refe.spkdis = !this.spkdis
  !this.refe.epkdis = !this.epkdis
  if !this.drns.set() then
    if !this.drns.east.neq(0).or(!this.drns.north.neq(0)).and(!this.drns.up.neq(0)) then
      !this.refe.drns = !this.drns
    endif
  endif
  if !this.drne.set() then
    if !this.drne.east.neq(0).or(!this.drne.north.neq(0)).and(!this.drne.up.neq(0)) then
  !this.refe.drne = !this.drne
    endif
  endif

  -- offset
  !this.refe.xoffs = !this.xoffset()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .enhance()

  call !!aslEnhance(!this.refe)

endmethod
-- End of method



------------------------------------------------------------------------
--
-- Method:      unEnhance
--
-- Description: unenhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .unEnhance()

  call !!aslUnEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: updates HANDRAIL member
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference to handrail member
--
------------------------------------------------------------------------

define method .updateDB() is DBREF

-- IMPORTANT: CE must be set to proper HANDRAil or below before the method is run

  -- TMPLREF member must be set!
  if !this.tmplref.badref().and(!this.type.neq('HRGATE')) then
  -- nothing is to be created and unset DBREF returned
    return nulref
  endif

  !otype = !this.otype
  !type = !this.type
  !sequ = !this.sequ
  !osequ = !this.ownerSequ
  !ref = !this.refe
  !oref = !this.owner

  if !oref.badref() then
    if !oref.unset() then
    -- refno is not set but owner may have been created from previous run
      !!ce = $!otype $!osequ
      handle ANY
      -- doesn't exist so try to jump to the last item of the same type and create new
        !!ce = last $!otype
        handle ANY
        endhandle
        new $!otype
      endhandle
      -- update reference
      !this.owner = !!ce
    else
    -- refno is set so re-use it - but first try to jump to the item of the same type and sequence numb.
      !!ce = $!otype $!osequ
      handle NONE
        !this.owner = !!ce
      elsehandle ANY
        !!ce = last $!otype
        handle ANY
        endhandle
        new $!otype ref $!oref
      endhandle
    endif
  endif

  if !ref.badref() then
    -- try to jump to the last member of owner
    !!ce = !this.owner.member.last()
    handle ANY
      !!ce = !this.owner
    endhandle
    if !ref.unset() then
    -- refno is not set
      new $!type
      -- update reference
      !this.refe = !!ce
    else
    -- refno is set so re-use it
      new $!type ref $!ref
    endif
  else
    !!ce = !this.refe
  endif

  -- delete all members of this member
  delete $!type members
  handle ANY
  endhandle

  -- update sequence numbers
  !this.sequ = !this.refe.tysequ
  !this.ownerSequ = !this.owner.tysequ

  -- run method specific to member type
  if !type.eq('HRGATE') then
    !this.updateGate()
  elseif !type.eq('HRPOST') then
    !this.updatePost()
  elseif !type.eq('RAIL') then
    !this.updateRail()
  elseif !type.eq('KICKPL') then
    !this.updateKickpl()
  elseif !type.eq('HRPANE') then
    !this.updatePanel()
  endif

  -- set template reference
  if !this.tmplref.set() then
    !this.refe.asstmpref = !this.tmplref
  endif

  -- set matref
  if !this.matref.set() then
    !this.refe.matref = !this.matref
  endif

  return !this.refe

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      getposref
--
-- Description: get dbreference of posref
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--    1   R      ASLHANDRAIL    Owning handrail object
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference to POINTR
--
------------------------------------------------------------------------

define method .getPosref(!handrail is ASLHANDRAIL) is DBREF

  !ref = nulref

  !ref = !handrail.rpath.member[!this.posref]
  handle ANY
  endhandle

  return !ref

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getstaref
--
-- Description: get dbreference staref
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLHANDRAIL    Owning handrail object
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference to POINTR
--
------------------------------------------------------------------------

define method .getStaref(!handrail is ASLHANDRAIL) is DBREF

  !ref = nulref

  !ref = !handrail.rpath.member[!this.staref]
  handle ANY
  endhandle

  return !ref

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      getendref
--
-- Description: get dbreference endref
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLHANDRAIL    Owning handrail object
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference to POINTR
--
------------------------------------------------------------------------

define method .getEndref(!handrail is ASLHANDRAIL) is DBREF

  !ref = nulref

  !ref = !handrail.rpath.member[!this.staref]
  handle ANY
  endhandle

  return !ref

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: get position of member
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      keyword to define position (start, end or pos)
--    2   R      ARRAY       edge - array of segments
--
-- Return:
--   [Data Type] [Description]
--    POSITION    element position
--
------------------------------------------------------------------------

define method .position(!key is STRING,!edges is ARRAY) is POSITION

  !pos = object POSITION()
  if !key.lowcase().eq('pos') then
    !index = !this.posref
    !zdist = !this.zdis
    !pkdis = !this.pkdis
  elseif !key.lowcase().eq('start') then
    !index = !this.staref
    !zdist = !this.szdis
    !pkdis = !this.spkdis
  elseif !key.lowcase().eq('end') then
    !index = !this.endref
    !zdist = !this.ezdis
    !pkdis = !this.epkdis
  endif

  -- compose actual zdistance
  !overallSegmentLength = 0
  do !segment values !edges
    !overallSegmentLength = !overallSegmentLength + !segment.length()
  enddo
  !zdist = !zdist + !overallSegmentLength * !pkdis

  -- apply zdistance to edge segment(s)
  do !segment values !edges
    !segmentLength = !segment.length()
    if !zdist.leq(!segmentLength) then
      if !segment.objectType().eq('LINE') then
        !startpos = !segment.startposition
        !dir = !segment.direction()
        !pos = !startpos.offset(!dir, !zdist)
      else
        -- round off the angles to 5 decimal places
        !segment.startAngle = !segment.startAngle.string('d5').real()
        !segment.endAngle = !segment.endAngle.string('d5').real()
        !propdist = !zdist / !segmentLength
        !angle = !segment.proportion(!propdist)
        !pos = !segment.anglePosition(!angle)
      endif
      break
    else
      !zdist = !zdist - !segmentLength
    endif
  enddo

  -- if position is not within the segment then set it to edposition of segment
  if !pos.unset() then
    !lastedge = !edges.last()
    if !lastedge.objectType().eq('LINE') then
      !pos = !lastedge.endposition
    else
      !pos = !lastedge.anglePosition(!lastedge.endAngle)
    endif
  endif

  return !pos

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: draw the handrail member as aid graphic
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   R      ASLHANDRAIL       owning handrail object
--    2   R      REAL              aid graphic number
--    3   R      REAL              line type
--    4   R      REAL              colour
-- Return:
--   [Data Type]         [Description]
--    ALSHANDRAIL
--
------------------------------------------------------------------------

define method .draw(!owner is ASLHANDRAIL,!number is REAL, !lineType is REAL, !colour is REAL) is ASLHANDRAILMEMB

   !zdir = !owner.orientation.zdir()
   !closeflag = !owner.closeflag()

   if !this.type.eq('HRPOST') then
     !start = !this.position
     !spacing = !owner.railSpacing
     !heig = !spacing.sort().last()
     !end = !start.offset(!zdir,!heig)
     !post = object LINE(!start,!end)
     !post.draw(!number, !lineType, !colour)
   elseif !this.type.eq('RAIL') then
     !zoffset = !this.zoffset
     !path = !owner.rpath.offset(!zdir,!zoffset)
     !staref = !this.staref
     !endref = !this.endref
     if !endref.eq(1) then
       !endref = !path.vertex.size()
     elseif !endref.lt(!path.vertex.size()) then
       !endref = !this.endref - 1
     endif
     !edges = !path.edges(!staref,!endref,!closeflag)[1]
     do !segment values !edges
       !segment.draw(!number, !lineType, !colour)
     enddo
   elseif !this.type.eq('HRGATE') then
     !widt = !this.width
     !heig = !this.height
     !edges = !owner.rpath.segment[!this.posref]
     !pos = !this.position('pos',!edges)
     !edgedir = !owner.rpath.getSegmentEnd(!edges.last(), 'end').direction
     !bl = !pos.offset(!edgedir.opposite(),!widt / 2)
     !br = !bl.offset(!edgedir,!widt)
     !tl = !bl.offset(!zdir,!heig)
     !tr = !tl.offset(!edgedir,!widt)
     --base line
     !lines[1] = object LINE(!bl,!br)
     -- left line
     !lines[2] = object LINE(!bl,!tl)
     -- right line
     !lines[3] = object LINE(!br,!tr)
     -- top line
     !lines[4] = object LINE(!tl,!tr)
     -- cross line bottom left to top right
     !lines[5] = object LINE(!bl,!tr)
     -- cross line bottom right to top left
     !lines[6] = object LINE(!br,!tl)
     -- draw lines
     do !c indices !lines
       !lines[!c].draw(!number,!lineType,!colour)
     enddo
   elseif !this.type.eq('HRPANE') then
     !leng = !this.paneSize[1]
     !heig = !this.paneSize[2]
     !pos = !this.position
     !radi = 0
     !allCurve = !!collectAllFor('CURVE','',!this.tmplref)
     !uradi = ARRAY()
     do !curve values !allCurve
       skip if !curve.uradi.gt(!leng * 0.5).or(!curve.uradi.gt(!heig))
       !uradi.append(!curve.uradi)
     enddo
     if !uradi.set() then
       !uradi.sort()
       !radi = !uradi.last()
     else
       !radi = 0
     endif
     !segm = !owner.rpath.segment[!this.posref][1]
     if !segm.objectType().eq('ARC') then
       !tmparc = !segm.startposition(!pos).chord(!leng)
       !endpos = !tmparc.anglePosition(!tmparc.endAngle)
       !dir = !pos.direction(!endpos)
     else
       !dir = !segm.direction()
     endif
     !line[1] = object LINE(!pos,!pos.offset(!dir,!leng))
     !line[1] = !line[1].offset(!zdir,!heig)
     !line[2] = object LINE(!pos,!pos.offset(!zdir,!heig))
     !line[3] = !line[2].offset(!dir,!leng)
     if !radi.gt(0) then
       !normal = !dir.cross(!zdir)
       !arc[1] = !line[1].startposition.arcFillet(!line[2].startposition,!line[1].endposition,!normal,!radi)
       if !arc[1].angle().gt(100) then
         !cradi = !arc[1].angle().atan() / 100 * !radi
         !arc[1] = !line[1].startposition.arcFillet(!line[2].startposition,!line[1].endposition,!normal,!cradi)
       endif
       !arc[2] = !line[1].endposition.arcFillet(!line[3].startposition,!line[1].startposition,!normal,!radi)
       if !arc[2].angle().gt(100) then
         !cradi = !arc[2].angle().atan() / 100 * !radi
         !arc[2] = !line[1].endposition.arcFillet(!line[3].startposition,!line[1].startposition,!normal,!cradi)
       endif
       !arc1Start = !arc[1].anglePosition(!arc[1].startAngle)
       !arc1End   = !arc[1].anglePosition(!arc[1].endAngle)
       !arc2Start = !arc[2].anglePosition(!arc[2].startAngle)
       !arc2End   = !arc[2].anglePosition(!arc[2].endAngle)
       !line[2].endposition = !arc1Start
       !line[1].startposition = !arc1End
       !line[1].endposition = !arc2End
       !line[3].endposition = !arc2Start
     endif
     do !c indices !line
       if !line[!c].length().boolean() then
         !line[!c].draw(!number,!lineType,!colour)
       endif
       if defined(!arc[!c]) then
         !arc[!c].draw(!number,!lineType,!colour)
       endif
     enddo
   endif

   return !this

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      width
--
-- Description: sets GATE width and zdistance
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        gate width
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .width(!width is REAL)

  !this.width = !width
  !this.zdis = 0
  !this.pkdis = 0.5

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      string
--
-- Description: convert object to string
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Brief description of object contents
--
------------------------------------------------------------------------

define method .string() is STRING

  !result = !this.type + ' ' & !this.sequ & ' of ' + !this.otype + ' ' & !this.ownerSequ

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xoffset
--
-- Description: return calculated value of xoffset
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        xoffset value
--
------------------------------------------------------------------------

define method .xoffset() is REAL

  !xoffset = 0
  !xoffset = !this.tmplref.xoffset * !this.xoffset
  handle ANY
  endhandle

  return !xoffset

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xoffset
--
-- Description: change an offset inclination
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        offset inclination (1 or -1) not the offset value itself
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .xoffset(!plusMinus is REAL)

  !this.xoffset = !plusMinus

  if !this.type.eq('HRPOST') then
    !this.bang = !this.xoffset.acos()
  endif

endmethod
-- End of method
