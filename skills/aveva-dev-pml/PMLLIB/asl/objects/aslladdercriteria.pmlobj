--
--
-- Description:     container for LADDER criteria data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslLadderCriteria()              -
--  complete()                       -                   completes all missing values
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--

-- Define object
define object ASLLADDERCRITERIA

  -- stores the key of the object
  member .desc               is STRING

  -- stringer offset dimension above uWP
  member .extension          is CRITERION

  -- rise of the bottom rung - lower gap
  member .lRise              is CRITERION

  -- distance between ladder and obstruction
  member .footroom           is CRITERION

  -- overall rise
  member .oRise              is CRITERION

  -- Pitch (Angle)
  member .pitch              is CRITERION

  -- rise
  member .rise               is CRITERION

  -- number of rungs
  member .rungs              is CRITERION

  -- width - includes stringers
  member .width              is CRITERION

  -- offset between ladder and cage
  member .cageOffset         is CRITERION

  -- size / diameter of cage
  member .cageSize           is CRITERION

  -- cage members
  -----------------------------------------------------------------
  -- distance between top of cage and next platform
  member .distancePrevCage   is CRITERION

  -- distance between platforms and bottom of cages
  member .headroom           is CRITERION

  -- Minimum ladder height for caged ladder
  member .cageLadderHeight   is CRITERION

  -- Distance between cage hoops
  member .hoopDistance       is CRITERION

endobject
-- End of object definition for ASLLadderCriteria

------------------------------------------------------------------------
--
-- Method:      aslLadderCriteria
--
-- key: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [key]
-- Return:
--   [Data Type] [key]
------------------------------------------------------------------------

define method .aslLadderCriteria()

  !this.desc                         = 'Ladder'

  !this.cageOffset.description       = 'Cage offset'
  !this.cageSize.description         = 'Cage size'
  !this.distancePrevCage.description = 'Extension from Top cage to next platform'
  !this.extension.description        = 'Extension above Ladder'
  !this.footroom.description         = 'Clearance from Obstruction'
  !this.hoopDistance.description     = 'Distance between cage hoops'
  !this.cageLadderHeight.description = 'Maximum height for Un-Caged Ladder'
  !this.headroom.description         = 'Headroom'
  !this.lRise.description            = 'Distance to the bottom rung'
  !this.oRise.description            = 'Overall rise'
  !this.pitch.description            = 'Pitch'
  !this.pitch.propertyType           = 'REAL'
  !this.rise.description             = 'Rung Spacing'
  !this.rungs.description            = 'No. of Rungs'
  !this.rungs.propertyType           = 'REAL'
  !this.width.description            = 'Width'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      complete
--
-- Description: completes all missing values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .complete()

  !this.cageOffset.complete(800mm, 1000mm)
  !this.cageSize.complete(800mm, 1000mm)
  !this.distancePrevCage.complete(200mm, 400mm)
  !this.extension.complete(1250mm, 1250mm)
  !this.footroom.complete(100mm, 1000mm)
  !this.headroom.complete(2000mm, 2200mm)
  !this.lRise.complete(!this.rise.min, !this.rise.max)
  !this.oRise.complete(0mm, 100000mm)
  !this.pitch.complete(80, 90)
  !this.rise.complete(0mm, 200mm)
  !this.rungs.complete(1, 1000)
  !this.width.complete(0mm, 600mm)
  !this.cageLadderHeight.complete(4000mm, 4000mm)
  !this.hoopDistance.complete(100mm, 600mm)

endmethod
-- End of method
