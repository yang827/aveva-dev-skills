--
--
-- Description:     container for LADDER data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addSideExit(ASLLADDEREXITDATA)   -                   adds a new side exit to the gate stack
--  aslLadderData()                  -                   default constructor
--  buildCages()                     -                   builds cages
--  buildExitCage(REAL,ASLLADDEREXITDATA) -                   creates an "exit" cage
--  buildHandrails()                 -                   creates the Handrails for Inclined Ladder
--  buildRung(REAL,POSITION,DBREF)   -                   builds rungs
--  buildRungs()                     -                   creates the rungs
--  buildTubeCage(REAL,REAL,REAL)    -                   creates a "tube" cage
--  compressSideExits()              -                   compress the gates
--  correctPickData(EDGPICKDATA)     EDGPOSITIONDATA     corrects the pick position data
--  deriveData()                     -
--  drawExit(ASLLADDEREXITDATA)      -                   draw ladder
--  enhance()                        -                   enhances the element
--  erase()                          -                   erases all traces
--  init()                           -                   initialise the object
--  remSideExit(REAL)                -                   removes a side exit from the gate stack
--  reorderPicks()                   -                   reorder the picks
--  replaceSideExit(ASLLADDEREXITDATA,REAL) -                   replaces an existing gate by a new one
--  setLWP()                         -                   evaluates and sets the LWP position
--  setORise()                       -                   evaluates and sets the oRise value
--  setUWP()                         -                   evaluates and sets the UWP position
--  showVolFeedback()                -                   draws the element with aid lines
--  sortSideExits()                  -                   sorts the side exits by the up position
--  unEnhance()                      -                   un enhances the element
--  updateDB()                       -                   creates/updates LADDER element
--  updateDataObj(DBREF)             -                   reads the values from the LADDER
--  updatePosData()                  -                   update the position data from the element itself
--

-- define object
define object ASLLADDERDATA

  -- public members
  ---------------------------------------------------------------------------
  -- Name of the ladder
  member .name               is STRING

  --Description
  member .description        is STRING

  --Function
  member .function           is STRING

  --Area
  member .area               is REAL

  --Number
  member .number             is REAL

  -- distance between ladder and cage - criteria data
  member .cageOffset         is REAL

  -- size / diameter of cage - criteria data
  member .cageSize           is REAL

  -- direction option
  member .directionOption    is STRING

  -- stringer offset dimension above uWP - criteria data
  member .extension          is REAL

  -- lower pick position data
  member .lPosData           is EDGPOSITIONDATA

  -- lower working point
  member .lWP                is POSITION

  -- lower exit/entry
  member .lExit              is ASLLADDEREXITDATA

  -- rise of the bottom rung - lower gap - criteria data
  member .lRise              is REAL

  -- distance between ladder and obstruction - criteria data
  member .footroom          is REAL

  -- overall rise - distance between WP's
  member .oRise              is REAL

  -- angle data
  member .pitch              is REAL

  -- position option
  member .positionOption     is STRING

  -- reference
  member .refe               is DBREF

  -- rung rising - vertical distance - criteria data
  member .rise               is REAL

  -- number of rungs
  member .rungs              is REAL

  -- side/intermediate exits
  member .sideExits          is ARRAY

  -- link to the uses setting
  member .settingReference   is STRING

  -- distance between stringers
  member .stringerDist       is REAL

  -- stringer thickness - criteria data
  member .stringerThn        is REAL

  -- reference to the central template
  member .tmplReference      is DBREF

  -- upper exit/entry
  member .uExit              is ASLLADDEREXITDATA

  -- upper pick position data
  member .uPosData           is EDGPOSITIONDATA

  -- upper working point
  member .uWP                is POSITION

  -- width of the ladder
  member .width              is REAL

  -- private member
  ---------------------------------------------------------------------------
  -- direction
  member .direction          is DIRECTION

  -- true if an error occurs
  member .error              is BOOLEAN

  -- bottom pick type (LINE, PLANE)
  member .lPickType          is STRING

  -- controls if the object uses the undo functionality
  member .undoable           is BOOLEAN

  -- top pick type (LINE, PLANE)
  member .uPickType          is STRING

  -- Rung Specification
  member .rungSpec           is DBREF

  -- Stringer Specification
  member .stringerSpec       is DBREF

  --Cage Specification
  member .cageSpec           is DBREF

  --Stringer Positions
  member .stringerPositions  is ARRAY

  --Rung angle
  member .rungAngle          is REAL

  --Cage required or not
  member .cageRequired       is BOOLEAN
  member .cageLadderHeight   is REAL

  --Distance between cage hoops
  member .hoopDistance       is REAL

endobject
-- End of object definition for ASLLadderData

------------------------------------------------------------------------
--
-- Method:      aslLadderData
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslLadderData()

  !this.init()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addSideExit
--
-- Description: adds a new side exit to the gate stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLLADDEREXITDATA        side exit
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .addSideExit(!sideExit is ASLLADDEREXITDATA)

  !this.sideExits.append(!sideExit)
  !this.sortSideExits()

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      buildExitCage
--
-- Description: creates an "exit" cage
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        number of exit
--    2   R      ASLLADDEREXITDATA        the side exit
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildExitCage(!number is REAL, !exitData is ASLLADDEREXITDATA)

  !ldrCage  = LDRCAG

  -- create the ldrexit element
  LAST MEM
  NEW LDREXT
  !!ce.elevation = !exitData.elevation
  !ldrExit       = !!ce
  !collection = object COLLECTION()
  !expression = object EXPRESSION('FUNC eq |' & !exitData.exitType & '|')
  !collection.filter(!expression)
  !collection.scope(!this.tmplReference)
  !collection.type('CAGSEG')
  !allCages = !collection.results()

  -- the sequence of the tube is twice the number
  !sequenceNumber = 2 * !number

  !!ce = !ldrCage
  if ( !ldrCage.mCount().lt(!sequenceNumber) ) then
    LAST MEM
    NEW CAGSEG
  else
    !!ce = !ldrCage.member[!sequenceNumber]
    DELETE CAGSEG MEM
  endif
  -- there is a catalogue element, take it
  if ( !allCages.empty().not() ) then
  	
    COPY $!allCages[1]

    !!ce.staElevation = !exitData.elevation - !exitData.distancePrevCage
    if ( !number.eq(!this.sideExits.size() + 1) ) then
      !!ce.endElevation = !exitData.elevation + !this.extension
    else
      !!ce.endElevation = !exitData.elevation + !exitData.headroom
    endif
    !!ce.function     = !exitData.exitType
    !!ce.extref       = !ldrExit
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      buildCages
--
-- Description:  builds cages
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildCages()

  -- first of all delete all ldrexits
  !collection = object COLLECTION()
  !collection.scope(!this.refe)
  !collection.type('LDREXT')
  !allLdrExits = !collection.results()
  do !ldrExit value !allLdrExits
    !!ce = !ldrExit
    handle ANY
      skip
    endhandle
    DELETE $!!ce.type
  enddo

  -- check if there is a cage in the catalogue, if not do not create the cages
  !collection = object COLLECTION()
  !collection.scope(!this.tmplReference)
  !collection.type('CAGSEG')
  !allCages = !collection.results()
  if ( !allCages.empty() ) then
    !collection.scope(!this.refe)
    !allCages = !collection.results()
    do !cage value !allCages
      !!ce = !cage
      handle ANY
        skip
      endhandle
      DELETE $!!ce.type
    enddo

  --catalogue requires detailed elements
  else

    -- create the main cage element if necessary
    !collection = object COLLECTION()
    !collection.scope(!this.refe)
    !collection.type('LDRCAG')
    !allLdrCage = !collection.results()
    if ( !allLdrCage.empty() ) then
      NEW LDRCAGE
    else
      !!ce = !allLdrCage[1]
    endif
    !!ce.cagSiz = !this.cageSize
    !!ce.cagOff = !this.cageOffset

    !exits      = !this.sideExits
    --!exits.append(!this.uExit)
       !collection = object COLLECTION()
   !expression = object EXPRESSION('FUNC eq |TUBE|')
   !collection.filter(!expression)
   !collection.scope(!this.refe)
   !collection.type('CAGSEG')
   !allTubeCages = !collection.results()

   !noOfTubeCage   		= !this.sideExits.size()
   !tubeCageDifference	= !noOfTubeCage - !allTubeCages.size()

   if(!tubeCageDifference.lt(0))then

   	do !c from 1 to abs(!tubeCageDifference)
   	  !!ce = !allTubeCages[!c]
   	  DELETE cagSeg
     enddo
   endif
  !!ce = LDRCAGE

    -- loop through all side exits
    do !cageNo index !exits
      LDRCAGE

      !sideExit = !exits[!cageNo]

      -- create the tube cage
      if ( !cageNo.eq(1) ) then
        !tubeStart = !this.lExit.headroom
      else
        !prevExit  = !this.sideExits[!cageNo - 1]
        !tubeStart = !prevExit.elevation + !prevExit.headroom
      endif
      !tubeEnd   = !sideExit.elevation - !sideExit.distancePrevCage

      !this.buildTubeCage(!cageNo, !tubeStart, !tubeEnd)

      -- create the exit cage
      !this.buildExitCage(!cageNo, !sideExit)
    enddo

    if(!exits.empty())then
      !tubeStart   = !this.lExit.headroom
    else
      !prevExit = !exits.last()
      !tubeStart  = !prevExit.elevation + !prevExit.headroom
    endif
    !tubeEnd      = !this.uExit.elevation - !this.uExit.distancePrevCage
    !this.buildTubeCage(!exits.size() + 1 , !tubeStart , !tubeEnd)
    !this.buildExitCage(!exits.size() + 1, !this.uExit)

    !collection = object COLLECTION()
    !collection.scope(LADDER)
    !collection.type('CAGSEG')
    !cageSeg      = !collection.results()
    do !cagSeg values !cageSeg
      !ce  = !!ce
      !!ce = !cagSeg
      if(!cagSeg.extref.badref())then
        DELETE CAGSEG
      endif
      !!ce  = !ce
    enddo
    !collection = object COLLECTION()
    !collection.scope(LDRCAG)
    !collection.type('GENSEC')
    !cage      = !collection.results()

    if(!this.cageSpec.set())then
      do !cageSp values !cage
        !cageSp.spref = !this.cageSpec
      enddo
    endif

    do !ldrStr value !allLdrStrs
      NEW LDRSTR COPY $!ldrStr
    enddo
    !collection = object COLLECTION()
    !collection.scope(LADDER)
    !collection.type('LDRSTR')
     !stringers  = !collection.results()
    !stringerGensecs = object ARRAY()
    !stringer1Poinsp = object ARRAY()
    !stringer2Poinsp = object ARRAY()
    if(!this.stringerSpec.set())then
      do !ladstringers values !stringers
        !!ce = !ladstringers
        !collection = object COLLECTION()
        !collection.scope(LDRSTR)
        !collection.type('GENSEC')
        !stringerGensecs.append(!collection.results())
      enddo
      do !indx index !stringerGensecs
        do !stringerSp values !stringerGensecs[!indx]
            !stringerSp.spref = !this.stringerSpec
        enddo
      enddo
    endif
    !collection = object COLLECTION()
    !collection.scope(!stringers[1])
    !collection.type('POINSP')
    !stringer1Poinsp = !collection.results()
    if(!this.stringerPositions.empty().not() and !this.stringerPositions.size() geq 4)then
      !stringer1Poinsp[1].position = !this.stringerPositions[1]
      !stringer1Poinsp[2].position = !this.stringerPositions[2]
    else
      !stringer1Poinsp[1].position = !this.lWP.offset(!this.direction.orthogonal(U), !this.width / 2)
      !upperStringerposition = !this.uWP
      if(!this.uExit.exitType.eq('TFRO').not() ) then
        !upperStringerposition.up  = !upperStringerposition.up + !this.extension
      endif
      !upperStringerposition = !upperStringerposition.offset(!this.direction.orthogonal(U), !this.width / 2)
      !stringer1Poinsp[2].position = !upperStringerposition
    endif

    !collection = object COLLECTION()
    !collection.scope(!stringers[2])
    !collection.type('POINSP')
    !stringer2Poinsp = !collection.results()
    if(!this.stringerPositions.empty().not() and !this.stringerPositions.size() geq 4)then
      !stringer2Poinsp[1].position = !this.stringerPositions[3]
      !stringer2Poinsp[2].position = !this.stringerPositions[4]
    else
      !stringer2Poinsp[1].position = !this.lWP.offset(!this.direction.orthogonal(U).opposite(), !this.width / 2)
      !upperStringerposition = !this.uWP
      if(!this.uExit.exitType.eq('TFRO').not() ) then
        !upperStringerposition.up  = !upperStringerposition.up + !this.extension
      endif
      !upperStringerposition = !upperStringerposition.offset(!this.direction.orthogonal(U).opposite(), !this.width / 2)
      !stringer2Poinsp[2].position = !upperStringerposition
    endif

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      buildRung
--
-- Description:  builds rungs
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        number of rung
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildRung(!rungNo is REAL, !position is POSITION, !refe is DBREF)

  !!ce = !refe
  -- check if there is a tread in the catalogue
  !collection = object COLLECTION()
  !collection.scope(!this.tmplReference)
  !collection.type('LDRRUN')
  !allRungs = !collection.results()

  -- there is a catalogue element, take it
  if ( !allRungs.empty().not() ) then
    -- if there are more than one tread they must alternate
    !size     = !allRungs.size()
    !division = !rungNo / !size
    !rounded  = !division.int()
    !index    = !rungNo - !rounded * !size + 1

    COPY $!allRungs[$!index]
    !!ce.position = !position
  endif

  LDRRUN

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      buildRungs
--
-- Description: creates the rungs
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildRungs()

  -- check if there is a tread in the catalogue, if not do not create the rungs
  !collection = object COLLECTION()
  !collection.scope(!this.tmplReference)
  !collection.type('LDRRUN')
  !allLdrRungs = !collection.results()
  if ( !allLdrRungs.empty() ) then
    !collection.scope(!!ce)
    !allLdrRungs = !collection.results()
    do !rung value !allLdrRungs
      !!ce = !rung
      handle ANY
        skip
      endhandle
      DELETE $!!ce.type
    enddo

  --catalogue requires detailed elements
  else
    if(!this.refe.set())then
      !collection = object COLLECTION()
      !collection.scope(!this.refe)
      !collection.type('RUNGSE')
      !allRungSet = !collection.results()

      if(!allRungSet.empty())then
        NEW RUNGSE
      else
        !!ce = !allRungSet[1]
      endif
    endif

    !collection = object COLLECTION()
    !collection.scope(RUNGSE)
    !collection.type('LDRRUN')
    !allLadderRungs = !collection.results()

    !difference = !allLadderRungs.size() - !this.rungs
    if(!difference.lt(0))then
      do !i from 1 to  abs(!difference)
        NEW LDRRUN
      enddo
    elseif(!difference.gt(0))then
      do !i from 1 to  abs(!difference)
        !refe = !!ce
        !!ce = !allLadderRungs[!i]
        delete LDRRUN
        !!ce = !refe
      enddo
    endif

    !collection = object COLLECTION()
    !collection.scope(RUNGSE)
    !collection.type('LDRRUN')
    !allLadderRungs = !collection.results()

    do !val values !allLadderRungs
      !currElement = !!ce
      !!ce = !val
      do !mem values !!ce.mem
        !!ce = !mem
        delete $!mem.type
      enddo
      !!ce = !currElement
    enddo

    !maxRungs = !this.rungs

    do !rungNo from 1 to !maxRungs
      -- bottom and top tread rise might be different
      if ( !rungNo.eq(1) ) then
        !elevation = !this.lRise
      else
        !elevation = !this.lRise + !this.rise * (!rungNo - 1)
      endif
      !rungPlane     = object PLANE(!this.lWP.offset(U, !elevation), Z IS U)
      !ladderLine    = !this.lWP.line(!this.uWP)
      !position       = !ladderLine.intersection(!rungPlane)
      !this.buildRung(!rungNo, !position, !allLadderRungs[!rungNo] )
    enddo
    !collection = object COLLECTION()
    !expression = object EXPRESSION('type eq |GENSEC|')
    !collection.filter(!expression)
    !collection.scope(rungse)
    !rungs      = !collection.results()

    if(!this.rungSpec.set())then
      do !rung values !rungs
       !rung.spref = !this.rungSpec
      enddo
    endif

    -- Rung BAngle
    do !rung values !rungs
      !rung.bAngle = !this.rungAngle
    enddo

  endif

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      buildHandrails
--
-- Description: creates the Handrails for Inclined Ladder
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildHandrails()

  -- check if there is a tread in the catalogue, if not do not create the rungs
  !collection = object COLLECTION()
  !collection.scope(!this.tmplReference)
  !collection.type('HANDRA')
  !allLdrHandra = !collection.results()
  if ( !allLdrHandra.empty() ) then
  	!collection = object COLLECTION()
    !collection.scope(!this.refe)
    !collection.type('HANDRA')
    !allHandraSet = !collection.results()
    do !handra values !allHandraSet
      !!ce = !handra
      delete HANDRA
    enddo
  	return
  endif


  --catalogue requires detailed elements
  if(!this.refe.set())then
    !collection = object COLLECTION()
    !collection.scope(!this.refe)
    !collection.type('HANDRA')
    !allHandraSet = !collection.results()
    !maximumHandras = 2
    !difference = !maximumHandras - !allHandraSet.size()

    if(!difference.gt(0))then
    	do from 1 to !difference
    		  NEW HANDRA copy $!allLdrHandra[1]
    	enddo
    endif

    !collection = object COLLECTION()
    !collection.scope(!this.refe)
    !collection.type('HANDRA')
    !allHandraSet = !collection.results()

    !!ce = !allHandraSet[1]

    !collection = object COLLECTION()
    !collection.scope(HANDRA)
    !collection.filter(object expression('TYPE OF OWNER EQ |RPATH|'))
    !collection.type('POINTR')
    !allPointrSet = !collection.results()
    !startPos    = object POSITION()
    !endPos 		= object POSITION()
    if(!allPointrSet.empty().not() and !allPointrSet.size() geq 2)then
    	if(!this.stringerPositions.set() and !this.stringerPositions.empty().not())then
    		!allPointrSet[1].position = !this.stringerPositions[1]
    		!allPointrSet[2].position = !this.stringerPositions[2]
    	endif
    endif
    	
    !!ce = !allHandraSet[2]

    !collection = object COLLECTION()
    !collection.scope(HANDRA)
    !collection.filter(object expression('TYPE OF OWNER EQ |RPATH|'))
    !collection.type('POINTR')
    !allPointrSet = !collection.results()
    !startPos    = object POSITION()
    !endPos 		= object POSITION()
    if(!allPointrSet.empty().not() and !allPointrSet.size() geq 2)then
    	if(!this.stringerPositions.set() and !this.stringerPositions.empty().not())then
    		!allPointrSet[1].position = !this.stringerPositions[3]
    		!allPointrSet[2].position = !this.stringerPositions[4]
    	endif
    endif
  endif

  !lengthOfLadder = !this.oRise / sin (!this.pitch)
  !topHRPostOffset = 500mm
  !effectiveLength = !lengthOfLadder - !topHRPostOffset
  !noOfLeftPosts 	     = INT ( !effectiveLength / 1200mm )
  !noOfRightPosts			= !noOfLeftPosts

  -- Right side Handrails

  !!ce = !allHandraSet[1]
  !collection = object COLLECTION()
	!collection.scope(!!ce)
	!collection.type('HRPOST')
	!allHRPost = !collection.results()
	!!ce = !allHRPost[1]
	!difference = !noOfRightPosts - !allHRPost.size()
	if(!difference.gt(0))then
		do from 1 to !difference
		 NEW HRPOST copy $!allHRPost[1]
		enddo
	elseif(!difference.lt(0))then
		 do !i from 1 to  abs(!difference)
		   !!ce = !allHRPost[!i]
		   DELETE HRPOST
		  enddo
  endif
		
  !collection = object COLLECTION()
	!collection.scope(!allHandraSet[1])
	!collection.type('HRPOST')
	!allHRPost = !collection.results()

   do !postNo from 1 to !noOfRightPosts
      -- bottom and top tread rise might be different
      if ( !postNo.eq(1) ) then
        !elevation = 500mm * sin (!this.pitch)
      else
        !elevation = ( 500mm + 1200mm * (!postNo - 1) )* sin (!this.pitch)
      endif
      !postPlane     = object PLANE(!this.uWP.offset(D, !elevation), Z IS D)
      !ladderLine    = !this.lWP.offset(!this.direction.orthogonal(U), !this.width / 2).line(!this.uWP.offset(!this.direction.orthogonal(U), !this.width / 2))
      !position       = !ladderLine.intersection(!postPlane)
      !!ce = !allHRPost[!postNo]
      TMPL 1
      GENSEC 1
      !!ce.position = !position
    enddo

    -- Left Side Handrails
      -- Right side Handrails

  !!ce = !allHandraSet[2]
  !collection = object COLLECTION()
	!collection.scope(!!ce)
	!collection.type('HRPOST')
	!allHRPost = !collection.results()
	!!ce = !allHRPost[1]
	!difference = !noOfLeftPosts - !allHRPost.size()
	if(!difference.gt(0))then
		do from 1 to !difference
		 NEW HRPOST copy $!allHRPost[1]
		enddo
	elseif(!difference.lt(0))then
		 do !i from 1 to  abs(!difference)
		   !!ce = !allHRPost[!i]
		   DELETE HRPOST
		  enddo
  endif
		
  !collection = object COLLECTION()
	!collection.scope(!allHandraSet[2])
	!collection.type('HRPOST')
	!allHRPost = !collection.results()

   do !postNo from 1 to !noOfLeftPosts
      -- bottom and top tread rise might be different
      if ( !postNo.eq(1) ) then
        !elevation = 500mm * sin (!this.pitch)
      else
        !elevation = ( 500mm + 1200mm * (!postNo - 1) )* sin (!this.pitch)
      endif
      !postPlane     = object PLANE(!this.uWP.offset(D, !elevation), Z IS D)
      !ladderLine    = !this.lWP.offset(!this.direction.orthogonal(U).opposite(), !this.width / 2).line(!this.uWP.offset(!this.direction.orthogonal(U).opposite(), !this.width / 2))
      !position       = !ladderLine.intersection(!postPlane)
      !!ce = !allHRPost[!postNo]
      TMPL 1
      GENSEC 1
      !!ce.position = !position
    enddo

    --!collection = object COLLECTION()
    --!expression = object EXPRESSION('type eq |GENSEC|')
    --!collection.filter(!expression)
    --!collection.scope(rungse)
    --!rungs      = !collection.results()

endmethod
-- End of method


-----------------------------------------------------------------------
--
-- Method:      buildTubeCage
--
-- Description: creates a "tube" cage
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        number of exit
--    2   R      REAL        tube start
--    3   R      REAL        tube end
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildTubeCage(!number is REAL, !startElevation is REAL, !endElevation is REAL)

  !ldrCage    = LDRCAG

  !collection = object COLLECTION()
  !expression = object EXPRESSION('FUNC eq |TUBE|')
  !collection.filter(!expression)
  !collection.scope(!this.tmplReference)
  !collection.type('CAGSEG')
  !allTubeCages = !collection.results()

  -- the sequence of the tube is twice the number - 1
  !sequenceNumber = 2 * !number - 1

  if ( !ldrCage.mCount().lt(!sequenceNumber) ) then
    LAST MEM
    handle ANY
    endhandle
    NEW CAGSEG
  else
    !!ce = !ldrCage.member[!sequenceNumber]
    DELETE CAGSEG MEM
  endif

  -- there is a catalogue element, take it
  if ( !allTubeCages.empty().not() ) then
    COPY $!allTubeCages[1]

    !!ce.staElevation = !startElevation
    !!ce.endElevation = !endElevation

  endif

  if(!allTubeCages.empty().not())then
    !collection = object COLLECTION()
    !collection.scope(CAGSEG)
    !collection.type('GENSEC')
    !allCageGensecs = !collection.results()
    !allHoopGensec  = object ARRAY()
    do !cageGensec values !allCageGensecs
     if(!cageGensec.zdir.up.eq(0))then
       !allHoopGensec.append(!cageGensec)
     endif
    enddo
    if(!allHoopGensec.empty().not())then
      !hoopElevation  = object ARRAY()
      !height = abs ( !startElevation - !endElevation )
      !noOfHoops  = INT ( ( !height / !this.hoopDistance )  )
      !position     = !allHoopGensec[1].position
      !hoopElevation[1]  = !startElevation
      if(!noOfHoops.gt(1))then
        do !j from 2 to ( !noOfHoops - 1)
          !hoopElevation[!j]   = !hoopElevation [ !j - 1 ] + !this.hoopDistance
        enddo
      endif
      !hoopElevation.append(!endElevation)
      !difference  = !noOfHoops - !allHoopGensec.size()
      if(!difference.lt(0))then
        --return
      else
        if(!difference.gt(0))then
          do !k from 1 to !difference
            NEW GENSEC copy $!allHoopGensec[1]
          enddo
        endif
      endif
        !collection = object COLLECTION()
        !collection.scope(CAGSEG)
        !collection.type('GENSEC')
        !allCageGensecs = !collection.results()
        !allHoopGensec  = object ARRAY()
        do !cageGensec values !allCageGensecs
          if(!cageGensec.zdir.up.eq(0))then
            !allHoopGensec.append(!cageGensec)
          endif
        enddo
        !hoopPosition  = !position

        do !index index !allHoopGensec
          !hoopPosition.up                = !hoopElevation[!index]
          !allHoopGensec[!index].position = !hoopPosition
        enddo
     -- endif
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      compressSideExits
--
-- Description: compress the gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .compressSideExits()

  !this.sideExits.compress()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      correctPickData
--
-- Description: corrects the pick position data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA     pick data
-- Return:
--   [Data Type] [Description]
--    EDGPOSITIONDATA
--                pick position data
------------------------------------------------------------------------

define method .correctPickData(!pickData is EDGPICKDATA) is EDGPOSITIONDATA

  !posData = !pickData.positionData()
  if( !posData.position.unset() ) then
    if( !posData.plane.set() ) then
      !posData.position = !posData.plane.intersection(!posData.pointVector)
    else
      !posData.position = !posData.line.intersection(!posData.pointVector)
    endif
  endif

  return !posData

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deriveData
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deriveData()

  !this.setORise()
  !this.uExit.elevation = !this.oRise

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawExit
--
-- Description: draw ladder
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLLADDEREXITDATA
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawExit(!exitData is ASLLADDEREXITDATA)

  !ladderLine = !this.lWP.line(!this.uWP)

  -- the arrows
  !elevationPlane    = object PLANE(!this.lWP.offset(U, !exitData.elevation), Z IS U)
  !elevationPosition = !ladderLine.intersection(!elevationPlane)
  if ( !exitData.exitType.eq('FRON') ) then
    !direction = !this.direction
    AID ARROW NUMBER $!!<aslCentralData.aidVolArrow> AT $!elevationPosition DIRECTION $!direction HEIGHT 1000mm

  elseif ( !exitData.exitType.eq('BACK') ) then
    !direction = !this.direction.opposite()
    AID ARROW NUMBER $!!<aslCentralData.aidVolArrow> AT $!elevationPosition DIRECTION $!direction HEIGHT 1000mm

  elseif ( !exitData.exitType.eq('LEFT') ) then
    !direction  = !this.direction.orthogonal(U).opposite()
    AID ARROW NUMBER $!!<aslCentralData.aidVolArrow> AT $!elevationPosition DIRECTION $!direction HEIGHT 1000mm

  elseif ( !exitData.exitType.eq('RIGH') ) then
    !direction  = !this.direction.orthogonal(U)
    AID ARROW NUMBER $!!<aslCentralData.aidVolArrow> AT $!elevationPosition DIRECTION $!direction HEIGHT 1000mm

  elseif ( !exitData.exitType.eq('BOTH') ) then
    !direction  = !this.direction.orthogonal(U)
    AID ARROW NUMBER $!!<aslCentralData.aidVolArrow> AT $!elevationPosition DIRECTION $!direction HEIGHT 1000mm
    !direction  = !this.direction.orthogonal(U).opposite()
    AID ARROW NUMBER $!!<aslCentralData.aidVolArrow> AT $!elevationPosition DIRECTION $!direction HEIGHT 1000mm
  endif

  -- one box showing the exit
  --if ( !exitData.headroom.neq(0) ) then
  --  !bottomPlane    = object PLANE(!this.lWP.offset(U, !exitData.elevation - !exitData.distancePrevCage), Z IS U)
  --  !bottomPosition = !ladderLine.intersection(!bottomPlane)
  --  !topPlane       = object PLANE(!this.lWP.offset(U, !exitData.elevation + !exitData.headroom), Z IS U)
  --  !topPosition    = !ladderLine.intersection(!topPlane)
  --  !leftDirection  = !this.direction.orthogonal(U)
  --  !rightDirection = !leftDirection.opposite()
  --
  --   draw the lines
  --  !bline      = !bottomPosition.offset(!leftDirection, !this.width).line(!bottomPosition.offset(!rightDirection, !this.width))
  --  !bline.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThin, !!aslCentralData.colourMain)
  --  !tline      = !topPosition.offset(!leftDirection, !this.width).line(!topPosition.offset(!rightDirection, !this.width))
  --  !tline.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThin, !!aslCentralData.colourMain)
  --  !leftLine   = !bline.startPosition.line(!tline.startPosition)
  --  !leftLine.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  --  !rightLine  = !bline.endPosition.line(!tline.endPosition)
  --  !rightLine.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  --  !crossLine1 = !bline.startPosition.line(!tline.endPosition)
  --  !crossLine1.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  --  !crossLine1 = !tline.startPosition.line(!bline.endPosition)
  --  !crossLine1.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  --endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .enhance()

  call !!aslEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      erase
--
-- Description: erases all traces
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .erase()

  -- deletes the element
  call !!aslErase(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: initialise the object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .init()

  -- initialise
  !this.error         = false
  !this.undoable      = false

  -- lower entry
  !this.lExit                  = object ASLLADDEREXITDATA()
  !this.lExit.distancePrevCage = 200mm
  !this.lExit.elevation        = 0
  !this.lExit.exitType         = 'LEFT'

  -- upper exit
  !this.uExit                  = object ASLLADDEREXITDATA()
  !this.uExit.distancePrevCage = 0
  !this.uExit.elevation        = 0
  !this.uExit.exitType         = 'TFRO'
  !this.uExit.headroom         = 0

  !this.area                   = 0
  !this.number                 = 0

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      remSideExit
--
-- Description: removes a side exit from the gate stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        side exit
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .remSideExit(!sideExitIdx is REAL)

  !this.sideExits.deleteFrom(!sideExitIdx, 1)
  !this.compressSideExits()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reorderPicks
--
-- Description: reorder the picks
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .reorderPicks()

  !lPos = !this.lPosData.position.wrt(World)
  !uPos = !this.uPosData.position.wrt(World)

  if( !lPos.up.gt(!uPos.up) ) then
    !tempPosData   = !this.lPosData
    !this.lPosData = !this.uPosData
    !this.uPosData = !tempPosData
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      replaceSideExit
--
-- Description: replaces an existing gate by a new one
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLLADDEREXITDATA        side exit
--    2   R      REAL        side exit index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .replaceSideExit(!sideExit is ASLLADDEREXITDATA, !sideExitIdx is REAL)

  !this.sideExits[!sideExitIdx] = !sideExit
  !this.sortSideExits()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLWP
--
-- Description: evaluates and sets the LWP position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLWP()

  !this.lWP = !this.uWP.offset(!this.direction.opposite(), !this.oRise)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setORise
--
-- Description: evaluates and sets the oRise value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setORise()

  !this.oRise = !this.uWP.up - !this.lWP.up

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setUWP
--
-- Description: evaluates and sets the UWP position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setUWP()

  !this.uWP = !this.lWP.offset(!this.direction, !this.oRise)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showVolFeedback
--
-- Description: draws the element with aid lines
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showVolFeedback()

  !ladderLine        = !this.lWP.line(!this.uWP)
  -- LWP and UWP
   ---------------------------------------------------------------------------
  !position = !this.uWP
  if(!!aslLadder.uwpAidNumber.set())then
    !!aidNumbers.hide(!!aslLadder.uwpAidNumber)
  else
    !!aslLadder.uwpAidNumber        = !!aidNumbers.add('UWP')
  endif

  AID SPHERE NUMBER $!!<aslLadder.uwpAidNumber> $!position DIAM 100mm
  AID TEXT NUMBER $!!<aslLadder.uwpAidNumber> 'UWP' at $!position

  !position = !this.lWP
  if(!!aslLadder.lwpAidNumber.set())then
    !!aidNumbers.hide(!!aslLadder.lwpAidNumber)
  else
    !!aslLadder.lwpAidNumber        = !!aidNumbers.add('LWP')
  endif

  AID SPHERE NUMBER $!!<aslLadder.lwpAidNumber> $!position DIAM 100mm
  AID TEXT NUMBER $!!<aslLadder.lwpAidNumber> 'LWP' at $!position

  -- the ladder
  ---------------------------------------------------------------------------
  --!ladderStart   = !this.lWP.offset(!this.direction, !this.lRise)
  --!ladderEnd     = !this.uWP.offset(!this.direction, !this.extension)
  !ladderStart   = !this.lWP
  !ladderEnd     = !this.uWP
  !blineRise     = !ladderStart.line(!ladderEnd)
  if(!this.uExit.exitType.eq('TFRO').not() ) then
    !blineRise   = !blineRise.extendEnd(!this.extension)
  endif
  !blineRise.draw(!!aslCentralData.aidVolCL, !!aslCentralData.lineStyleDashedThick, !!aslCentralData.colourCL)
  !leftLineRise  = !blineRise.offset(!this.direction.orthogonal(U), !this.width / 2)
  !this.stringerPositions[1] = !leftLineRise.startPosition
  !this.stringerPositions[2] = !leftLineRise.endPosition
  !leftLineRise.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  !rightLineRise = !blineRise.offset(!this.direction.orthogonal(U).opposite(), !this.width / 2)
  !this.stringerPositions[3] = !rightLineRise.startPosition
  !this.stringerPositions[4] = !rightLineRise.endPosition
  !rightLineRise.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  !orthLineRise1 = !leftLineRise.startPosition.line(!rightLineRise.startPosition)
  !orthLineRise1.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  !orthLineRise2 = !leftLineRise.endPosition.line(!rightLineRise.endPosition)
  !orthLineRise2.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)

  -- the rungs
  ---------------------------------------------------------------------------
  !leftDirection = !this.direction.orthogonal(U)
  do !i to !this.rungs
    !rungElevation = !this.lRise + (!i - 1) * !this.rise
    !rungPlane     = object PLANE(!this.lWP.offset(U, !rungElevation), Z IS U)
    !rungPosition  = !ladderLine.intersection(!rungPlane)
    AID CYLI NUMBER $!!<aslCentralData.aidVolEnvelope> AT $!rungPosition ORI Z IS $!leftDirection HEIGHT $!<this.width> DIAM 20mm FILLED ON
  enddo

  -- the cage
  if(!this.cageRequired)then
    ---------------------------------------------------------------------------
    !ladderDirection   = !ladderLine.direction()
    !cageLine          = !this.lWP.offset(!ladderDirection, !this.lExit.headroom).line(!this.uWP.offset(!ladderDirection, !this.extension))
    !leftDirection     = !this.direction.orthogonal(D)
    !offsetDirection   = !ladderDirection.orthogonal(!leftDirection)
    !cyliLine          = !cageLine.offset(!offsetDirection, !this.cageOffset / 2)
    !cyliHeight        = !cyliLine.length()
    !cyliPosition      = !cyliLine.proportion(0.5)
    AID CYLI NUMBER $!!<aslCentralData.aidVolEnvelope> AT $!cyliPosition ORI Z IS $!ladderDirection HEIGHT $!cyliHeight DIAM $!<this.cageSize>
  endif

  -- the exits
  ---------------------------------------------------------------------------
  !this.drawExit(!this.lExit)
  !this.drawExit(!this.uExit)
  do !exit value !this.sideExits
    !this.drawExit(!exit)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sortSideExits
--
-- Description: sorts the side exits by the up position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .sortSideExits()

  -- initialise
  !elevations = object ARRAY()

  -- evaluates the up positions
  do !sideExit value !this.sideExits
    !elevations.append(!sideExit.elevation)
  enddo

  -- sort
  !sortedIndices = !elevations.sortedIndices()
  !this.sideExits.reIndex(!sortedIndices)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      unEnhance
--
-- Description: un enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .unEnhance()

  call !!aslUnEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: creates/updates LADDER element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDB()

  -- create undo mark
  if ( !this.undoable.set() and !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update ladder')
    !undo.add()
  endif

  if(!!aslStoreTable.getStore('ladder').set() and !!aslStoreTable.getStore('ladder').badref().not())then
    !!ce = !!aslStoreTable.getStore('ladder')
  else
    if(!!dbrefUpdate(!!ce).not())then
      !!alert.warning('Read only DB.Can not create/modify ladder.')
      !this.error = true
      return
    endif
  endif

  -- creates/updates the owner element
  if(!this.refe.unset() or !this.refe.badref())then
    !this.refe = !!aslCreate('LADDER', !this.refe)
  endif

     -- ladder attributes
     ---------------------------------------------------------------------------
 if(!this.name.set()) then
   !name                       = !this.name.trim()
   if(!name.neq('')) then
     !name                     = '/' & !name
     !this.refe.name      = !name
   endif
 endif
 !this.refe.description    = !this.description
 --!this.refe.function       = !this.function
 !this.refe.area           = !this.area
 !this.refe.number         = !this.number

 !this.refe.pos            = !this.lWP
 !this.refe.oRise          = !this.oRise
 !this.refe.oGoing         = !this.oRise / !this.pitch.tangent()
 !this.refe.rise           = !this.rise
 !this.refe.ldrDirection   = !this.direction
 !this.refe.rWidth         = !this.width
 !this.refe.headroom       = !this.lExit.headroom
 !this.refe.uExtnsion      = !this.extension
 !this.refe.footroom       = !this.footroom

--   TODO must be replaced by correct attributes
 !this.refe.assTmpReference = !this.tmplReference
 --!this.refe.description   = !this.tmplReference.string() & ' ' & !this.settingReference
 handle ANY
 endhandle

 !!ce = !this.refe
 RULE REXE
 -- rungs
 ---------------------------------------------------------------------------
 !this.buildRungs()


 -- stringer
 ---------------------------------------------------------------------------

 -- check if there is a ldrstr in the catalogue, if not do not create the treads
 !collection = object COLLECTION()
 !collection.scope(!this.tmplReference)
 !collection.type('LDRSTR')
 !allLdrStrs = !collection.results()
 if ( !allLdrStrs.empty() ) then
   !collection.scope(!!ce)
   !allLdrStrs = !collection.results()
   do !ldrStr value !allLdrStrs
     !!ce = !ldrStr
     handle ANY
       skip
     endhandle
     DELETE $!!ce.type
   enddo

 --catalogue requires detailed elements
 else
  !collection = object COLLECTION()
  !collection.scope(LADDER)
  !collection.type('LDRSTR')
  !allStrs  = !collection.results()

  !difference = !allStrs.size() - !allLdrStrs.size()

  if(!difference.lt(0))then
    do !i from 1 to abs(!difference)
      NEW LDRSTR COPY $!allLdrStrs[$!i]
      if ( !this.uExit.exitType.neq('TFRO') ) then
        !!ce.uExtns = !this.extension
      endif
    enddo
  elseif(!difference.gt(0))then
    do !j  from 1 to abs(!difference)
      !!ce = !allStrs[!j]
      delete $!!ce.type
    enddo
  elseif(!difference.eq(0))then
    do !k  value !allStrs
      !!ce = !k
      delete $!k.type
    enddo
    do !ldrStr index !allLdrStrs
      NEW LDRSTR ref $!allStrs[$!ldrStr] COPY $!allLdrStrs[$!ldrStr]
      if ( !this.uExit.exitType.neq('TFRO') ) then
        !!ce.uExtns = !this.extension
      endif
    enddo
  endif
 endif

!this.buildHandrails()

 -- cages
 ---------------------------------------------------------------------------
 if(!this.cageRequired)then
  !this.buildCages()
 else
   !collection = object COLLECTION()
   !collection.type('LDRCAG')
   !collection.scope(!this.refe)
   !cages       = !collection.results()
   if(!cages.empty().not())then
    do !val values !cages
      !!ce = !val
      DELETE LDRCAG
    enddo
   endif
 endif

 !!ce     = !this.refe
 RULE REXE
 !collection = object COLLECTION()
 !collection.scope(LADDER)
 !collection.type('LDRSTR')
 !stringers  = !collection.results()
 !stringerGensecs = object ARRAY()
 !stringer1Poinsp = object ARRAY()
 !stringer2Poinsp = object ARRAY()
 if(!this.stringerSpec.set())then
  do !ladstringers values !stringers
    !!ce = !ladstringers
    !collection = object COLLECTION()
    !collection.scope(LDRSTR)
    !collection.type('GENSEC')
    !stringerGensecs.append(!collection.results())
  enddo
  do !indx index !stringerGensecs
    do !stringerSp values !stringerGensecs[!indx]
        !stringerSp.spref = !this.stringerSpec
    enddo
  enddo
 endif

 !collection = object COLLECTION()
 !collection.scope(!stringers[1])
 !collection.type('POINSP')
 !stringer1Poinsp = !collection.results()
 if(!this.stringerPositions.empty().not() and !this.stringerPositions.size() geq 4)then
   !stringer1Poinsp[1].position = !this.stringerPositions[1]
   !stringer1Poinsp[2].position = !this.stringerPositions[2]
 else
    !stringer1Poinsp[1].position = !this.lWP.offset(!this.direction.orthogonal(U), !this.width / 2)
    !upperStringerposition = !this.uWP
    if(!this.uExit.exitType.eq('TFRO').not() ) then
      !upperStringerposition.up  = !upperStringerposition.up + !this.extension
    endif
    !upperStringerposition = !upperStringerposition.offset(!this.direction.orthogonal(U), !this.width / 2)
    !stringer1Poinsp[2].position = !upperStringerposition
 endif

 !collection = object COLLECTION()
 !collection.scope(!stringers[2])
 !collection.type('POINSP')
 !stringer2Poinsp = !collection.results()
 if(!this.stringerPositions.empty().not() and !this.stringerPositions.size() geq 4)then
   !stringer2Poinsp[1].position = !this.stringerPositions[3]
   !stringer2Poinsp[2].position = !this.stringerPositions[4]
 else
   !stringer2Poinsp[1].position = !this.lWP.offset(!this.direction.orthogonal(U).opposite(), !this.width / 2)
   !upperStringerposition = !this.uWP
   if(!this.uExit.exitType.eq('TFRO').not() ) then
     !upperStringerposition.up  = !upperStringerposition.up + !this.extension
   endif
   !upperStringerposition = !upperStringerposition.offset(!this.direction.orthogonal(U).opposite(), !this.width / 2)
   !stringer2Poinsp[2].position = !upperStringerposition
 endif
  -- end undo mark
 if ( !this.undoable.set() and !this.undoable ) then
   !undo.endUndoable()
 endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: reads the values from the LADDER
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       database element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  !this.refe                   = !refe

  -- ladder attributes
  if(!this.refe.isNamed)then
    !this.name                 = !this.refe.namn
  endif
  !this.description            = !this.refe.description
  --!this.function             = !this.refe.function
  !this.area                   = !this.refe.area
  !this.number                 = !this.refe.number
  !this.direction              = !this.refe.ldrDirection
  !this.lWP                    = !this.refe.pos
  !this.uWP                    = !this.refe.uWP
  !this.oRise                  = !this.uWP.up - !this.lWP.up
  !this.rise                   = !this.refe.rise
  !this.width                  = !this.refe.rWidth
  !this.extension              = !this.refe.uExtnsion
  !this.footroom               = !this.refe.footroom
  !pitchVal                    = !this.oRise / !this.lWP.distance(!this.uWP)
  !this.pitch                  = ASIN(!pitchVal)
  handle (2,432)
  	!pitchVal 								 = !pitchVal.string('d4').real()
  	!this.pitch                  = ASIN(!pitchVal)
  endhandle
  !this.pitch                  = !this.pitch.string('D1').real()

  --!this.headroom             = !this.refe.headroom

  -- lower exit
  !lExit                       = object ASLLADDEREXITDATA()
  !lExit.headroom              = !this.refe.headroom
  !lExit.elevation             = 0
  !lExit.distancePrevCage      = 200mm
  !lExit.exitType              = 'LEFT'
  !this.lExit                  = !lExit

  -- cage attributes
  !collection = object COLLECTION()
  !collection.scope(!this.refe)
  !collection.type('LDRCAG')
  !allLdrCages = !collection.results()
  if ( !allLdrCages.empty().not() ) then
    !this.cageRequired         = true
    !ldrCage                   = !allLdrCages[1]
    !this.cageOffset           = !ldrCage.cagOff
    !this.cageSize             = !ldrCage.cagSiz
  else
    !this.cageRequired         = false
  --  !this.cageOffset           = !!aslLadder.txCageOffsetLadder.val
  --  !this.cageSize             = !!aslLadder.txCageSizeLadder.val
  endif

  -- cage segment attributes
  !collection = object COLLECTION()
  !expression = object EXPRESSION('FUNCTION neq |TUBE|')
  !collection.filter(!expression)
  !collection.scope(!this.refe)
  !collection.type('CAGSEG')
  !allCageSegments = !collection.results()

  do !i to (!allCageSegments.size() - 1)
    !cageSegment               = !allCageSegments[!i]
    !sideExit                  = object ASLLADDEREXITDATA()
    !sideExit.headroom         = !cageSegment.endElevation - !cageSegment.extref.elevation
    !sideExit.elevation        = !cageSegment.extref.elevation
    !sideExit.distancePrevCage = !cageSegment.extref.elevation - !cageSegment.staElevation
    !sideExit.exitType         = !cageSegment.function
    !this.sideExits.append(!sideExit)
  enddo
 --!this.cageSpec  = !allCageSegments[1].members[1].spref
  -- upper exit
  if(!allCageSegments.empty().not())then
    !cageSegment                 = !allCageSegments.last()
    !uExit                       = object ASLLADDEREXITDATA()
    !uExit.headroom              = !this.extension
    !uExit.elevation             = !this.oRise
    !uExit.distancePrevCage      = !cageSegment.extref.elevation - !cageSegment.staElevation
    !uExit.exitType              = !cageSegment.function
    !this.uExit                  = !uExit
  endif

  !collection = object COLLECTION()
  !expression = object EXPRESSION('FUNCTION eq |TUBE|')
  !collection.filter(!expression)
  !collection.scope(!this.refe)
  !collection.type('CAGSEG')
  !allHoopCageSegments = !collection.results()
  if(!allHoopCageSegments.empty().not())then
    -- cage segment attributes
    !collection = object COLLECTION()
    !collection.scope(!allHoopCageSegments.last())
    !collection.type('GENSEC')
    !allCageGensecs = !collection.results()
    !allHoopGensec  = object ARRAY()
    do !cageGensec  values !allCageGensecs
      if(!cageGensec.zdir.up.eq(0))then
        !allHoopGensec.append(!cageGensec)
      endif
    enddo
    if(!allHoopGensec.empty().not() and !allHoopGensec.size().gt(1))then
    	!elevation = object ARRAY()
    	do !gensec values !allHoopGensec
    		!elevation.append(!gensec.up)
    	enddo
    	!elevation.sort().unique()
      !this.hoopDistance   = !elevation[2]-!elevation[1]
    else
      !this.hoopDistance   = !!aslLadderCriteria.hoopDistance.optimum()
    endif
  endif

  -- rung attributes
  !collection = object COLLECTION()
  !collection.scope(!this.refe)
  !collection.type('LDRRUN')
  !allRungs = !collection.results()
  if ( !allRungs.empty().not() ) then
    !rung             = !allRungs[1]
    !this.lRise       = !rung.position.wrt(!this.refe).up
  endif
  !this.rungs         = !allRungs.size()

  !collection = object COLLECTION()
  !collection.scope(!this.refe)
  !collection.type('LDRSTR')
  !allstringers = !collection.results()

  if(!allCageSegments.empty().not() and !allCageSegments[1].members.empty().not())then
    --!this.cageSpec     = !allCageSegments[1].members[1].spref
  endif

  if(!allRungs.empty().not() and !allRungs[1].members.empty().not())then
    --!this.rungSpec     = !allRungs[1].members[1].spref
    !this.rungAngle    = !allRungs[1].members[1].bAngle
  endif

  if(!allstringers.empty().not() and !allstringers[1].members.empty().not())then
    --!this.stringerSpec = !allstringers[1].members[1].spref
  endif

  --TODO
  --!this.stringerDist
  --!this.stringerThn

--TODO must come from different attributes, or from the associations
  --!this.tmplReference     = object DBREF(!this.refe.description.before(' '))
  !this.tmplReference       = !this.refe.assTmpReference
  --!this.settingReference  = !this.refe.description.after(' ')
  !this.uPickType         = 'LINE'
  !this.lPickType         = 'PLANE'
  !this.positionOption    = 'Explicit upper position...'
  !this.directionOption   = 'Explicit direction...'

  !this.updatePosData()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updatePosData
--
-- Description: update the position data from the element itself
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updatePosData()

  !this.lPosData          = object EDGPOSITIONDATA()
  !this.lPosData.position = !this.lWP.offset(!this.direction, !this.footroom)

  !this.uPosData          = object EDGPOSITIONDATA()
  !this.uPosData.position = !this.uWP.offset(!this.direction, !this.footroom)

endmethod
-- End of method
