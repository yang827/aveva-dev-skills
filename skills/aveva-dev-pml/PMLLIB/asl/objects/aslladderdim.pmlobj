--
--
-- Description:     container for LADDER dimension data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslLadderDim()                   -                   default constructor
--

-- Define object
define object ASLLADDERDIM

  -- cage offset
  member .cageOffset          is BOOLEAN

  -- cage size
  member .cageSize            is BOOLEAN

  -- the upper extension
  member .extension           is BOOLEAN

  -- the headroom
  member .headroom            is BOOLEAN

  -- height
  member .height              is BOOLEAN

  -- lower rise
  member .lrise               is BOOLEAN

  -- foot room
  member .footroom            is BOOLEAN

  -- pitch
  member .pitch               is BOOLEAN

  -- rise
  member .rise                is BOOLEAN

  -- distance between stringers
  member .stringerDist        is BOOLEAN

  -- stringer thickness
  member .stringerThn         is BOOLEAN

  -- width
  member .width               is BOOLEAN

  -- side exits
  member .gates               is BOOLEAN

endobject
-- End of object definition for ASLLadderDim

------------------------------------------------------------------------
--
-- Method:      aslLadderDim
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslLadderDim()

  !this.cageOffset     = false
  !this.cageSize       = false
  !this.extension      = false
  !this.headroom       = false
  !this.height         = false
  !this.lrise          = false
  !this.footroom       = false
  !this.pitch          = false
  !this.rise           = false
  !this.stringerDist   = false
  !this.stringerThn    = false
  !this.width          = false
  !this.gates          = false

endmethod
-- End of method
