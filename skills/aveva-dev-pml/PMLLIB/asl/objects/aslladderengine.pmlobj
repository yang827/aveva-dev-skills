------------------------------------------------------------------------
--
-- Method:      mergeCriteria
--
-- Description: merges central standard with fabricator standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergeCriteria()

  -- if there is a fabricator standard it must be taken into account
  !this.ladderCriteria = !!getCriteriaSetIntersection(!this.ladderCriteriaBasis, !this.ladderData.tmplReference)
  !this.ladderCriteria.complete()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newDefaults
--
-- Description: sets the attributes for a new ladder (defaults
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      the reference as a string
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newDefaults(!ladder is DBREF)

  -- sets the criteria
  !this.setCriteria()

  -- sets the reference to the central template
  !this.setSettingReference()

  -- if the dbref is part of the current standard use it, otherwise take the first best of the standard
  --!allLadders = !!aslCentralData.currSetting.collectAll('LADDER')
  !allLadders = !!aslCentralData.getTemplates('LADDER')

   if ( !!aslCentralData.currSetting.unset() ) then
    !!alert.warning('There is no ASL selection.')
    return
  endif
  !subSettings  = !!aslCentralData.currSetting.subSettings
  !purpose      = object ARRAY()
  do !currSubSetting values !subSettings
    !purpose.append(!currSubSetting.purpose)
  enddo

  if ( !purpose.unset() or !purpose.findFirst('LADDER').unset() ) then
    !!alert.warning('There are no ladders in the ASL selection.')
    return
  endif

  if ( !allLadders.findFirst(!ladder).set() ) then
    !ladderTmpl = !ladder
  else
    !ladderTmpl = !allLadders.first()
  endif

  -- set the currently selected template reference
  !this.setTmplReference(!ladderTmpl)

  -- combines general and fabricator standard
  !this.mergeCriteria()

  -- initialise
  !this.ladderData.cageOffset             = !this.ladderCriteria.cageOffset.optimum()
  !this.ladderData.cageSize               = !this.ladderCriteria.cageSize.optimum()
  !this.ladderData.extension              = !this.ladderCriteria.extension.optimum()
  !this.ladderData.lExit.headroom         = !this.ladderCriteria.headroom.optimum()
  !this.ladderData.lRise                  = !this.ladderCriteria.lRise.optimum()
  !this.ladderData.footRoom               = !this.ladderCriteria.footRoom.optimum()
  !this.ladderData.oRise                  = !this.ladderCriteria.oRise.optimum()
  !this.ladderData.pitch                  = !this.ladderCriteria.pitch.optimum()
  !this.ladderData.rise                   = !this.ladderCriteria.rise.optimum()
  !this.ladderData.rungs                  = !this.ladderCriteria.rungs.optimum()
  !this.ladderData.hoopDistance           = !this.ladderCriteria.hoopDistance.optimum()
  --!this.ladderData.stringerDist           = !this.ladderCriteria.stringerDist.optimum
  !this.ladderData.uExit.distancePrevCage = !this.ladderCriteria.distancePrevCage.optimum()
  !this.ladderData.direction              = N
  !this.ladderData.stringerThn            = 50mm

  -- set the optimum width
  !this.setOptimumWidth()

endmethod
-- End of method

