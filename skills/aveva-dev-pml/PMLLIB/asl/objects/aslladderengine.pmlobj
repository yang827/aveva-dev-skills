------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addSideExit(ASLLADDEREXITDATA)   -                   adds a new gate to the gate stack
--  compressSideExits()              -                   compress the side exits
--  enhance()                        -                   enhances the element
--  erase()                          -                   erases all traces
--  evaluate()                       -                   evaluates LADDER elements according to the existing criterion set
--  evaluateDirectionOptions()       -                   evaluates the direction options
--  evaluateLPickType()              -                   evaluates the lower pick type
--  evaluateORise()                  -                   evaluates the ORise
--  evaluatePickType(EDGPOSITIONDATA) STRING              evaluates a pick type
--  evaluatePositionOptions()        -                   evaluates the position options
--  evaluateUPickType()              -                   evaluates the upper pick type
--  getCageOffset()                  REAL                returns the cage offset
--  getCageSize()                    REAL                returns the cage size
--  getDirection()                   DIRECTION           returns the direction
--  getDirectionOption()             STRING              returns the direction option
--  getError()                       BOOLEAN             returns the error status
--  getExplicitPosition()            POSITION            returns the position of the LWP or UWP depending on the selected position option
--  getExtension()                   REAL                returns the extension
--  getFootRoom()                    REAL                returns the foot room
--  getHeadroom()                    REAL                returns the headroom
--  getLPickType()                   STRING              returns the lower pick type
--  getLPosData()                    EDGPOSITIONDATA     returns the lower position data
--  getLRise()                       REAL                returns the lrise for the machine with the given segment index
--  getLWP()                         POSITION            returns the position of the LWP
--  getLength()                      REAL                returns the length
--  getORise()                       REAL                returns the overall rise
--  getOptimumExtension()            REAL
--  getOptimumWidth()                REAL
--  getPitch()                       REAL                returns the pitch
--  getPositionOption()              STRING              returns the position option
--  getPositionOptions()             ARRAY               returns the position option
--  getRefe()                        DBREF               returns the reference of the stair set
--  getRise()                        REAL                returns the rise for the machine with the given segment index
--  getRungs()                       REAL                returns the number of rungs
--  getSettingReference()            STRING              returns the setting
--  getSideExits()                   ARRAY               returns an array of sideExits
--  getStringerDist()                REAL                returns the distance between the stringers
--  getStringerThn()                 REAL                returns the thickness of the stringers
--  getTmplReference()               DBREF               returns the reference to the central template for  stair flight
--  getUExitType()                   STRING              return the type of the top exit
--  getUPickType()                   STRING              returns the upper pick type
--  getUPosData()                    EDGPOSITIONDATA     returns the upper position data
--  getURise(REAL)                   REAL                returns the urise for the machine with the given segment index
--  getUWP()                         POSITION            returns the position of the UWP
--  getWidth()                       REAL                returns the width
--  init()                           -                   initialise the object
--  mergeCriteria()                  -                   merges central standard with fabricator standard
--  newDefaults(DBREF)               -                   sets the attributes for a new ladder (defaults
--  remSideExit(REAL)                -
--  reorderPicks()                   -                   reorder the picks
--  replaceSideExit(ASLLADDEREXITDATA,REAL) -
--  resetError()                     -                   resets error status
--  setCageOffset(REAL)              -                   sets the cage offset
--  setCageSize(REAL)                -                   sets the cage size
--  setCriteria()                    -                   sets the criteria from the current central standard
--  setDirectionOption(DIRECTION)    -
--  setDirectionOption(STRING)       -                   sets the direction option
--  setExplicitPosition(POSITION)    -                   sets the position of the LWP or UWP depending on the selected position option
--  setExtension(REAL)               -                   sets the upper extension
--  setFootRoom(REAL)                -                   sets the foot room
--  setGoing(REAL,REAL)              -                   sets the going for the machine with the given segment index
--  setHeadroom(REAL)                -                   sets the headroom
--  setLPosData(EDGPICKDATA)         -                   sets the lower position data
--  setLRise(REAL)                   -                   sets the lrise for the machine with the given segment index
--  setLength(REAL)                  -                   sets the length
--  setORise(REAL)                   -                   sets the overall rise
--  setOptimumWidth()                -                   sets the optimum width
--  setPitch(REAL)                   -                   sets the pitch for the machine with the given segment index
--  setPositionOption(STRING)        -                   sets the position option
--  setRise(REAL)                    -                   sets the rise for the machine with the given segment index
--  setRungs(REAL)                   -                   sets the rungs
--  setSettingReference()            -                   sets the setting and criteria from the current central standard
--  setSideExits(ARRAY)              -                   sets all sideExits
--  setStringerDist(REAL)            -                   sets the distance between the stringer
--  setStringerThn(REAL)             -                   sets the thickness of the stringer
--  setTmplReference(DBREF)          -                   sets the reference to the central template for  stair flight
--  setUExitType(STRING)             -                   sets the type of the upper exit
--  setUPosData(EDGPICKDATA)         -                   sets the upper position data
--  setWidth(REAL)                   -                   sets the width
--  setWorkingPoints()               -                   set Working Points depending on the selected option
--  showDimFeedback()                -                   shows dimension
--  showVolFeedback()                -                   draws the element with aid lines
--  string()                         STRING
--  unEnhance()                      -                   unenhances the element
--  updateDB()                       -                   creates/updates a ladder
--  updateDataObj(DBREF)             -                   reads the ladder data
--

-- Define object
define object ASLLADDERENGINE

  -- public members
  ---------------------------------------------------------------------------
  -- container for the ladder data
  member .ladderData          is ASLLADDERDATA

  -- container for the ladder dimension
  member .ladderDim           is ASLLADDERDIM

  -- private members
  ---------------------------------------------------------------------------
  -- contains the criteria set for ladder elements (including fabricator standard)
  member .ladderCriteria      is ASLLADDERCRITERIA

  -- contains the criteria set for ladder elements (excluding fabricator standard)
  member .ladderCriteriaBasis is ASLLADDERCRITERIA

  -- contains a copy of ladder data before modify
  member .ladderDataOld       is ASLLADDERDATA

endobject
-- End of object definition for ASLLadderEngine
