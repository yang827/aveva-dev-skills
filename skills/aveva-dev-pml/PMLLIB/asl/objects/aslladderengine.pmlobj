------------------------------------------------------------------------
--
-- Method:      getOptimumExtension
--
-- Description: returns the optimum extension
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        optimum width
------------------------------------------------------------------------

define method .getOptimumExtension() is REAL

  return !this.ladderCriteria.width.extension

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOptimumWidth
--
-- Description: returns the optimum width
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        optimum width
------------------------------------------------------------------------

define method .getOptimumWidth() is REAL

  if ( !this.ladderCriteria.width.optimum.between(!this.ladderCriteria.width.min(), !this.ladderCriteria.width.max()) ) then
    return !this.ladderCriteria.width.optimum()
  else
    return !this.ladderCriteria.width.min()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      string
--
-- Description: returns description when converted to string
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Object description
------------------------------------------------------------------------

define method .string() is STRING

  return !this.desc

endmethod
-- end of method
