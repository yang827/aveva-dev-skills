------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: reads the ladder data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        reference element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  -- update the data object
  !this.ladderData.updateDataObj(!refe)
  --!this.ladderCriteriaBasis = !!aslCentralData.currSubStandard.aslLadderCriteria
  !this.ladderCriteriaBasis = !!aslCentralData.getCriteriaSet(!this.ladderData.settingReference, 'ASLLADDERCRITERIA')

  !this.mergeCriteria()

endmethod
-- End of method

