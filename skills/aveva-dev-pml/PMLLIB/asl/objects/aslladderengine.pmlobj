--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA
--                           pick data
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setUPosData(!pickData is EDGPICKDATA)

  !this.ladderData.uPosData = !this.ladderData.correctPickData(!pickData)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setWidth
--
-- Description: sets the width
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        width
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setWidth(!width is REAL)

  !this.ladderData.width = !width

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setWorkingPoints
--
-- Description: set Working Points depending on the selected option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setWorkingPoints()

  -- Initialise Variables
  !ladderData = !this.ladderData

  -- define the lower/upper position depending on the option selection
  if ( !ladderData.positionOption.eq('Left align with lower line') ) then
    !lPosition = !ladderData.lPosData.line.endPosition.wrt(World).offset(!ladderData.lPosData.line.direction().opposite(), !ladderData.width / 2)

  elseif ( !ladderData.positionOption.eq('Right align with lower line') ) then
    !lPosition = !ladderData.lPosData.line.startPosition.wrt(World).offset(!ladderData.lPosData.line.direction(), !ladderData.width / 2)

  elseif ( !ladderData.positionOption.eq('Centre align with lower line') ) then
    !lPosition = !ladderData.lPosData.line.proportion(0.5)

  elseif ( !ladderData.positionOption.eq('Right align with upper line') ) then
    !uPosition = !ladderData.uPosData.line.startPosition.wrt(World).offset(!ladderData.uPosData.line.direction(), !ladderData.width / 2)

  elseif ( !ladderData.positionOption.eq('Left align with upper line') ) then
    !uPosition = !ladderData.uPosData.line.endPosition.wrt(World).offset(!ladderData.uPosData.line.direction().opposite(), !ladderData.width / 2)

  elseif ( !ladderData.positionOption.eq('Centre align with upper line') ) then
    !uPosition = !ladderData.uPosData.line.proportion(0.5)

  elseif ( !ladderData.positionOption.eq('Derived lower position') ) then
    !lPosition = !ladderData.lPosData.position.wrt(World)

  elseif ( !ladderData.positionOption.eq('Derived upper position') ) then
    !uPosition = !ladderData.uPosData.position.wrt(World)

  elseif ( !ladderData.positionOption.eq('Explicit lower position...') ) then
    !lPosition = !ladderData.lPosData.position.offset(!this.ladderData.direction, !this.ladderData.footRoom)

  elseif ( !ladderData.positionOption.eq('Explicit upper position...' ) ) then
    !uPosition = !ladderData.uPosData.position.offset(!this.ladderData.direction, !this.ladderData.footRoom)
  endif

  -- define the second position depending on the first point and the direction selection
  if ( !ladderData.directionOption.matchwild('Orthogonal to lines*') ) then
    !direction = !ladderData.lPosData.line.direction().orthogonal(U)

  elseif ( !ladderData.directionOption.matchwild('Orthogonal to lower line*') ) then
    !direction = !ladderData.lPosData.line.direction().orthogonal(U)

  elseif ( !ladderData.directionOption.matchwild('Orthogonal to upper line*') ) then
    !direction = !ladderData.uPosData.line.direction().orthogonal(U)

  elseif ( !ladderData.directionOption.matchwild('Parallel to lines*') ) then
    !direction = !ladderData.lPosData.line.direction()

  elseif ( !ladderData.directionOption.matchwild('Parallel to lower line*') ) then
    !direction = !ladderData.lPosData.line.direction()

  elseif ( !ladderData.directionOption.matchwild('Parallel to upper line*') ) then
    !direction = !ladderData.uPosData.line.direction()

  elseif ( !ladderData.directionOption.eq('Derived direction') ) then
    !direction = !ladderData.lPosData.position.direction(!ladderData.uPosData.position).projected(object PLANE(E0, Z IS U))

  elseif ( !ladderData.directionOption.eq('Explicit direction...') ) then
    !direction = !ladderData.direction
  elseif ( !ladderData.directionOption inset ('North', 'South', 'East', 'West','X','-X','Y','-Y') ) then
    !direction = object DIRECTION(!ladderData.directionOption)
  endif

  if ( !direction.angle(!ladderData.lPosData.position.direction(!ladderData.uPosData.position)).gt(90) and $
       not !ladderData.directionOption inset ('North', 'South', 'East', 'West','X','-X','Y','-Y') ) then
    !direction = !direction.opposite()
  endif

  ---------------------------------------------------------------------------
  -- after picking use the picked data
  if ( !ladderData.positionOption.matchwild('*lower*') ) then
    -- if the second pick is a line, take the intersection
    if ( !ladderData.uPosData.line.set() ) then
      !uPosition = !ladderData.uPosData.line.intersection(object LINE(!lPosition, !lPosition.offset(!direction, 100mm)))
      handle ANY
        !uPosition = !ladderData.uPosData.position
      endhandle
    -- if the second pick is a position, project the position on the line resulting from the lower position and the direction
    -- and then project that position on the up plane
    else
      !uPlane    = object PLANE(!ladderData.uPosData.position, Z is U)
      !lLine     = object LINE(!lPosition, !lPosition.offset(!direction, 100mm))
      !uPosition = !uPlane.near(!lLine.near(!ladderData.uPosData.position))
    endif

  else
    -- if the second pick is a line, take the intersection
    if ( !ladderData.lPosData.line.set() ) then
      !lPosition = !ladderData.lPosData.line.intersection(object LINE(!uPosition, !uPosition.offset(!direction, 100mm)))
      handle ANY
        !lPosition = !ladderData.lPosData.position
      endhandle

    -- if the second pick is a position, project the position on the line resulting from the lower position and the direction
    -- and then project that position on the up plane
    else
      !lPlane    = object PLANE(!ladderData.lPosData.position, Z is U)
      !uLine     = object LINE(!uPosition, !uPosition.offset(!direction, 100mm))
      !lPosition = !lPlane.near(!uLine.near(!ladderData.lPosData.position))
    endif
  endif

  -- Initialise Variables
  !ladderData.lWP = !lPosition.offset(!direction.opposite(), !ladderData.footRoom)
  !ladderData.uWP = !uPosition.offset(!direction.opposite(), !ladderData.footRoom)

  ---------------------------------------------------------------------------
  -- Lower reference plane
  !lPlane    = object PLANE(!lPosition, Z is U)
  !direction = !direction.projected(!lPlane)

  !ladderData.direction = !direction

  -- Derive attributes like length, Height that depend on the picks
  !ladderData.deriveData()

  -- update the central object
  !this.ladderData = !ladderData

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showDimFeedback
--
-- Description: shows dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimFeedback()

  -- first remove all dimension
  !!aslCentralData.clearDimFeedback()

  -- get information about the Ladder
  !ladderData     = !this.ladderData
  !ladderDim      = !this.ladderDim
  !aidDim         = !!aslCentralData.aidDim

  if ( !ladderDim.cageOffset ) then
    !label    = 'Cage offset = ' & !ladderData.cageOffset.string(!!distanceFmt)
    !pos1     = !ladderData.uWP
    !pos2     = !pos1.offset(!ladderData.direction.opposite(), !ladderData.cageOffset)
    !dimObj   = object DISPLAYDIMENSION(!label, !ladderData.direction.orthogonal(U).opposite(), !pos1, !pos2, !ladderData.cageOffset * 3, !aidDim)
  endif

  if ( !ladderDim.cageSize ) then
    !label    = 'Cage size = ' & !ladderData.cageSize.string(!!distanceFmt)
    !pos1     = !ladderData.uWP.offset(!ladderData.direction.opposite(), !ladderData.cageOffset).offset(!ladderData.direction.orthogonal(U),            !ladderData.cageSize / 2)
    !pos2     = !ladderData.uWP.offset(!ladderData.direction.opposite(), !ladderData.cageOffset).offset(!ladderData.direction.orthogonal(U).opposite(), !ladderData.cageSize / 2)
    !dimObj   = object DISPLAYDIMENSION(!label, !ladderData.direction.opposite(), !pos1, !pos2, !ladderData.cageOffset, !aidDim)
  endif

  if ( !ladderDim.extension ) then
    !label    = 'Extension = ' & !ladderData.extension.string(!!distanceFmt)
    !pos1     = !ladderData.uWP
    !pos2     = !ladderData.uWP.offset(U, !ladderData.extension)
    !dimObj   = object DISPLAYDIMENSION(!label, !ladderData.direction.orthogonal(U), !pos1, !pos2, !ladderData.cageOffset * 3, !aidDim)
  endif

  if ( !ladderDim.headroom ) then
    !label    = 'Headroom = ' & !ladderData.lExit.headroom.string(!!distanceFmt)
    !pos1     = !ladderData.lWP
    !pos2     = !ladderData.lWP.offset(U, !ladderData.lExit.headroom)
    !dimObj   = object DISPLAYDIMENSION(!label, !ladderData.direction.opposite(), !pos1, !pos2, !ladderData.cageOffset * 5, !aidDim)
  endif

  if ( !ladderDim.height ) then
    !label    = 'Overall Rise = ' & !ladderData.oRise.string(!!distanceFmt)
    !pos1     = !ladderData.uWP.offset(D,!ladderData.oRise)
    !pos2     = !ladderData.uWP
    !dimObj   = object DISPLAYDIMENSION(!label, !ladderData.direction.orthogonal(U), !pos1, !pos2, !ladderData.cageOffset * 3, !aidDim)
  endif

  if ( !ladderDim.lRise ) then
    !label    = 'Bottom rise = ' & !ladderData.lRise.string(!!distanceFmt)
    !pos1     = !ladderData.lWP
    !pos2     = !ladderData.lWP.offset(U, !ladderData.lRise)
    !dimObj   = object DISPLAYDIMENSION(!label, !ladderData.direction.opposite(), !pos1, !pos2, !ladderData.cageOffset * 3, !aidDim)
  endif

  if ( !ladderDim.footRoom ) then
    !label    = 'Foot room = ' & !ladderData.footRoom.string(!!distanceFmt)
    !pos1     = !ladderData.uWP
    !pos2     = !ladderData.uWP.offset(!ladderData.direction, !ladderData.footRoom)
    !dimObj   = object DISPLAYDIMENSION(!label, !ladderData.direction.orthogonal(U), !pos1, !pos2, !ladderData.cageOffset, !aidDim)
  endif

  if ( !ladderDim.pitch ) then
    !label    = 'Pitch = ' & !ladderData.pitch & 'deg'

    -- angle is defined by three positions - get the missing one
    !horiPos  = !ladderData.lWP.offset(!ladderData.direction, 2000mm)
    !radius   = 1000mm
    !dimObj   = object DISPLAYDIMENSION(!label, !ladderData.lWP, !horiPos, !ladderData.uWP, !radius, !aidDim)
  endif

  if ( !ladderDim.rise ) then
    !label     = 'Rise = ' & !ladderData.rise.string(!!distanceFmt)
    !pos1      = !ladderData.lWP.offset(UP, !ladderData.lRise)
    !pos2      = !pos1.offset(UP, !ladderData.rise)
    !dimObj    = object DISPLAYDIMENSION(!label, !ladderData.direction.opposite(), !pos1, !pos2, !ladderData.cageOffset * 3, !aidDim)
  endif

  if ( !ladderDim.stringerDist ) then
  endif

  if ( !ladderDim.stringerThn ) then
  endif

  if ( !ladderDim.width ) then
    !label     = 'Width = ' & !ladderData.width.string(!!distanceFmt)
    !pos1      = !ladderData.lWP.offset(U, !ladderData.oRise / 2).offset(!ladderData.direction.orthogonal(U),            !ladderData.width / 2)
    !pos2      = !ladderData.lWP.offset(U, !ladderData.oRise / 2).offset(!ladderData.direction.orthogonal(U).opposite(), !ladderData.width / 2)
    !dimObj   = object DISPLAYDIMENSION(!label, !ladderData.direction.opposite(), !pos1, !pos2, !ladderData.cageOffset * 3, !aidDim)
  endif

    !gates    = !this.getSideExits()

  -- gate dimensioning
  if ( !ladderDim.gates and $
       !gates.empty().not() ) then
    do !i index !gates
      !label    = 'Side exit ' & !i
      !position = object POSITION('N0')
      !position.east  = !ladderData.lWP.east
      !position.north = !ladderData.lWP.north
      !position.up		=	!ladderData.lWP.up + !gates[!i].elevation
      AID TEXT NUMBER $!aidDim '$!label' AT $!position
    enddo
    !gate   = !gates.first()

    !label  = 'Distance to previous cage = ' & !gate.distancePrevCage.string(!!distanceFmt)
    !pos1   = !position.offset(D, !gate.distancePrevCage)
    !pos2   = !position
    !dimObj = object DISPLAYDIMENSION(!label, !ladderData.direction.orthogonal(U), !pos1, !pos2, 800mm, !aidDim)

    !label  = 'Headroom = ' & !gate.headroom.string(!!distanceFmt)
    !pos1   = !position
    !pos2   = !position.offset(U, !gate.headroom)
    !dimObj = object DISPLAYDIMENSION(!label, !ladderData.direction.orthogonal(U), !pos1, !pos2, 800mm, !aidDim)
  endif

endmethod
-- End of method

