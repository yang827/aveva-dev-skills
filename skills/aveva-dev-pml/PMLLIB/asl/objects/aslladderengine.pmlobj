------------------------------------------------------------------------
--
-- Method:      erase
--
-- Description: erases all traces
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .erase()

  !this.ladderData.erase()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluate
--
-- Description: evaluates LADDER elements according to the existing criterion set
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluate()

  -- number of rungs
  if ( !this.ladderData.uExit.exitType.eq('TFRO') ) then
    !rungORise = !this.ladderData.oRise
  else
    !rungORise = !this.ladderData.oRise + !this.ladderData.extension
  endif

  !this.ladderData.rungs         = INT(!rungORise / !this.ladderData.rise)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateDirectionOptions
--
-- Description: evaluates the direction options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateDirectionOptions()

  -- evaluates the direction for the pick position data
  if ( !this.directionOption.eq('Derived direction') ) then
    !startPoint                = !this.lPosData.position
    !endPoint                  = !this.uPosData.position
    !line                      = object LINE(!startPoint, !endPoint)
    !this.ladderData.direction = !line.direction()

  -- direction E
  elseif ( !this.ladderData.directionOption inset('East','X') ) then
    !this.ladderData.direction = E

  -- uses the user input
  elseif ( !this.ladderData.directionOption.eq('Explicit direction...') ) then
    -- nothing to do
--    !this.ladderData.direction = !this.ladderData.direction

  -- direction N
  elseif ( !this.ladderData.directionOption inset ('North','Y') ) then
    !this.ladderData.direction = N

  -- evaluates the direction orthogonal from any line
  elseif ( !this.ladderData.directionOption.eq('Orthogonal to lines') ) then
    !line                      = !this.ladderData.lPosData.line
    !this.ladderData.direction = !line.direction().orthogonal(U)

  -- evaluates the direction orthogonal from the lower line
  elseif ( !this.ladderData.directionOption.eq('Orthogonal to lower line') ) then
    !line                      = !this.ladderData.lPosData.line
    !this.ladderData.direction = !line.direction().orthogonal(U)

  -- evaluates the direction orthogonal from the upper line
  elseif ( !this.ladderData.directionOption.eq('Orthogonal to upper line') ) then
    !line                      = !this.ladderData.uPosData.line
    !this.ladderData.direction = !line.direction().orthogonal(U)

  -- direction S
  elseif ( !this.ladderData.directionOption inset ('South','-Y') ) then
    !this.ladderData.direction = S

  -- direction W
  elseif ( !this.ladderData.directionOption inset ('West','-X') ) then
    !this.ladderData.direction = W
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLPickType
--
-- Description: evaluates the lower pick type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateLPickType()

  !this.ladderData.lPickType = !this.evaluatePickType(!this.ladderData.lPosData)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateORise
--
-- Description: evaluates the ORise
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateORise()

  !this.ladderData.oRise = !this.ladderData.uWP.up - !this.ladderData.lWP.up

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluatePickType
--
-- Description: evaluates a pick type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA
--                           pick position data
-- Return:
--   [Data Type] [Description]
--    STRING      pick type
------------------------------------------------------------------------

define method .evaluatePickType(!posData is EDGPOSITIONDATA) is STRING

  if ( !posData.line.set() ) then
    return 'LINE'
  else
    return 'PLANE'
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluatePositionOptions
--
-- Description: evaluates the position options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluatePositionOptions()

  -- evaluates the mid point of the lower line
  if ( !this.ladderData.positionOption.eq('Centre align with lower line') ) then
    !this.ladderData.controlPoint = 'BOTTOM'
    !line                         = !this.ladderData.lPosData.line
    !direction                    = !line.direction()
    !halfLength                   = !line.length() / 2
    !this.ladderData.lWP          = !line.startPosition.offset(!direction, !halfLength)

  -- evaluates the mid point of the upper line
  elseif ( !this.ladderData.positionOption.eq('Centre align with upper line') ) then
    !this.ladderData.controlPoint = 'TOP'
    !line                         = !this.ladderData.uPosData.line
    !direction                    = !line.direction()
    !halfLength                   = !line.length() / 2
    !this.ladderData.uWP          = !line.startPosition.offset(!direction, !halfLength)

  -- uses the lower pick position
  elseif ( !this.ladderData.positionOption.eq('Derived lower position') ) then
    !this.ladderData.controlPoint = 'BOTTOM'
    !this.ladderData.lWP          = !this.ladderData.lPosData.position

  -- uses the upper pick position
  elseif ( !this.ladderData.positionOption.eq('Derived upper position') ) then
    !this.ladderData.controlPoint = 'TOP'
    !this.ladderData.uWP          = !this.ladderData.uPosData.position

  -- uses user input for the lower position
  elseif ( !this.ladderData.positionOption.eq('Explicit lower position...') ) then
    !this.ladderData.controlPoint = 'BOTTOM'
    -- nothing to do
--    !this.ladderData.lWP          = !this.ladderData.lWP

  -- uses user input for the upper position
  elseif ( !this.ladderData.positionOption.eq('Explicit upper position...') ) then
    !this.ladderData.controlPoint = 'TOP'
    -- nothing to do
--    !this.ladderData.uWP          = !this.ladderData.uWP

  -- uses the start point of the lower line
  elseif ( !this.ladderData.positionOption.eq('Left align with lower line') ) then
    !this.ladderData.controlPoint = 'BOTTOM'
    !line                         = !this.ladderData.lPosData.line
    !this.ladderData.lWP          = !line.startPosition

  -- uses the start point of the upper line
  elseif ( !this.ladderData.positionOption.eq('Left align with upper line') ) then
    !this.ladderData.controlPoint = 'TOP'
    !line                         = !this.ladderData.uPosData.line
    !this.ladderData.uWP          = !line.startPosition

  -- uses the end point of the lower line
  elseif ( !this.ladderData.positionOption.eq('Right align with lower line') ) then
    !this.ladderData.controlPoint = 'BOTTOM'
    !line                         = !this.ladderData.lPosData.line
    !this.ladderData.lWP          = !line.endPosition

  -- uses the end point of the upper line
  elseif ( !this.ladderData.positionOption.eq('Right align with upper line') ) then
    !this.ladderData.controlPoint = 'TOP'
    !line              = !this.ladderData.uPosData.line
    !this.ladderData.uWP          = !line.endPosition
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateUPickType
--
-- Description: evaluates the upper pick type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateUPickType()

  !this.ladderData.uPickType = !this.evaluatePickType(!this.ladderData.uPosData)

endmethod
-- End of method

