------------------------------------------------------------------------
--
-- Method:      getExplicitPosition
--
-- Description: returns the position of the LWP or UWP depending on the selected position option
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    position of the LWP or UWP
------------------------------------------------------------------------

define method .getExplicitPosition()is POSITION

  if ( !this.ladderData.positionOption.matchwild('* lower *') ) then
    return !this.ladderData.lWP
  else
    return  !this.ladderData.uWP
  endif

endmethod
-- End of method

