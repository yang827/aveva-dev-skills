--
-- Description:     container for LADDER EXIT data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslLadderExitData()              -                   default constructor
--

-- Define object
define object ASLLADDEREXITDATA

  -- distance to previous cage
  member .distancePrevCage    is REAL

  -- elevation
  member .elevation           is REAL

  -- type of exit
  member .exitType            is STRING

  -- headroom
  member .headroom            is REAL

endobject
-- End of object definition for ASLLadderExitData

------------------------------------------------------------------------
--
-- Method:      aslLadderExitData
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslLadderExitData()

  !this.distancePrevCage    = 200mm
  !this.elevation           = 0
  !this.exitType            = 'LEFT'
  !this.headroom            = 2200mm

endmethod
-- End of method
