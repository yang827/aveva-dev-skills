-- Created:         Tue Aug 1 09:00:00 GMT 2006
--
--
-- Description:     container for PltFrm criteria data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslPltFrmCriteria()              -                   default constructor
--  checkValue(REAL,STRING)          -                   check value against criterion
--  complete()                       -                   completes all missing values
--  string()                         STRING              returns description
--

-- Define object
define object ASLPLTFRMCRITERIA

  -- stores the description of the object
  member .desc      is STRING

  -- thickness
  member .thickness is CRITERION

endobject
-- End of object definition for ASLPltFrmCriteria

------------------------------------------------------------------------
--
-- Method:      aslPltFrmCriteria
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslPltFrmCriteria()

  !this.desc                  = 'Platform'

  !this.thickness.description = 'Thickness'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      complete
--
-- Description: completes all missing values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .complete()



endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      string
--
-- Description: returns description when converted to string
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Object description
------------------------------------------------------------------------

define method .string() is STRING

  return !this.desc

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      checkValue
--
-- Description: check value against criterion
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Value to be checked
--    2   R      STRING      Criterion name
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .checkValue(!value is REAL,!criterionName is STRING)

  -- get appropriate CRITERION and check the value
  !criterion = !this.attribute(!criterionName.upcase())
  !criterion.checkValue(!value)

endmethod
-- end of method
