--
-- Description:     container for PltFrm data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslPltFrmData()                  -                   default constructor
--  buildHandras(REAL)               -                   build the handrails
--  buildOpenings(REAL)              -                   build the openings
--  drawAccess()                     -                   draws access points
--  drawOpenings()                   -                   draws openings
--  enhance()                        -                   enhances the element
--  erase()                          -                   erases all traces
--  getError()                       BOOLEAN             returns the error status
--  resetError()                     -                   resets error status
--  showVolFeedback()                -                   draws the element with aid lines
--  unEnhance()                      -                   unenhances the element
--  updateDB()                       -                   creates/updates PltFrm element
--  updateDataObj(DBREF)             -                   read the values from the HandRa
--

-- Define object
define object ASLPLTFRMDATA

  -- public members
  ---------------------------------------------------------------------------
  -- TOP/BOTTOM justification
  member .justification         is STRING

  -- means the vertical clearance
  member .clearance             is REAL

  -- contains all gates
  member .gates                 is ARRAY

  -- all hand rails of the stair landing
  member .handRaEngines         is ARRAY

  -- reference to the central template for handrails
  member .handRaTmplReference   is DBREF

  -- height / thickness
  member .height                is REAL

  -- openings
  member .openings              is ARRAY

  -- openings
  member .openingsHandRaStatus is ARRAY

  -- orientation
  member .orientation           is ORIENTATION

  -- position
  member .position              is POSITION

  -- reference
  member .refe                  is DBREF

  -- link to the uses setting
  member .settingReference     is STRING

  -- reference to the central template for platforms
  member .pltFrmTmplReference  is DBREF

  -- shape
  member .shape                is PROFILE



  -- private members
  ---------------------------------------------------------------------------
  -- true if an error occurs
  member .error             is BOOLEAN

  -- controls if the object uses the undo functionality
  member .undoable          is BOOLEAN


endobject
-- End of object definition for aslPltFrmData

------------------------------------------------------------------------
--
-- Method:      aslPltFrmData
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslPltFrmData()

  -- inits
  !this.clearance     = 2000mm
  !this.error         = false
  !this.handRaEngines = object ARRAY()
  !this.openings      = object ARRAY()
  !this.orientation   = Y is N and Z is U
  !this.position      = E0 N0 U0
  !this.undoable      = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      buildHandras()
--
-- Description: build the handrails
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        the percentage of the progress bar
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildHandras(!progress is REAL)

  !currentProgress   = !!fmSys.progress()
  !progressPerHandRa = !progress / !this.handRaEngines.size()

  do !i index !this.handRaEngines
    !handRaEngine       = !this.handRaEngines[!i]
    !handRaEngine.setGates(!this.gates)
    !handRaEngine.updateDB()

    HANDRA
    if ( !this.justification.eq('TOP') ) then
      AT U 0
    else
      AT U $!this.height
    endif

    !!fmSys.setProgress(!currentProgress + !i * !progressPerHandRa)
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      buildOpenings()
--
-- Description: build the openings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        the percentage of the progress bar
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildOpenings(!progress is REAL)

  if ( !this.openings.size().eq(0) ) then
    return
  endif

  !currentProgress    = !!fmSys.progress()
  !progressPerOpening = !progress / !this.openings.size()

  do !i index !this.openings
    !opening          = !this.openings[!i]
    NEW PLFEAT
    NEW PLOPEN

    NEW RPATH
    !plooRefe           = !!ce
    !plooRefe.owner.position = !this.shape.position
    !opening.dbwrite(!!ce)

    END
    !!ce.orientation = !this.openings[!i].orientation

    !!fmSys.setProgress(!currentProgress + !i * !progressPerOpening)
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      drawAccess
--
-- Description: draws access points
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawAccess()

  do !i index !this.gates
    !this.gates[!i].showVolFeedback()
    !position  = !this.gates[!i].position
    !label     = 'Access point: ' & !i.string()
    !aidNumber = !!aslCentralData.aidDim
    AID TEXT NUMBER $!aidNumber '$!label' AT $!position
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      drawOpenings
--
-- Description: draws openings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawOpenings()

  do !i index !this.openings
    !position  = !this.openings[!i].position
    !label     = 'Opening: ' & !i.string()
    !aidNumber = !!aslCentralData.aidDim
    AID TEXT NUMBER $!aidNumber '$!label' AT $!position
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .enhance()

  call !!aslEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      erase
--
-- Description: erases all traces
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .erase()

  -- deletes the element
  call !!aslErase(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
