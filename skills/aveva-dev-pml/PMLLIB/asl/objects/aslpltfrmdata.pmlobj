-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: creates/updates PltFrm element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDB()

  -- create undo mark
  if ( !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update platform')
    !undo.add()
  endif

  -- basic settings for the progress bar
  !numberOfHandRas  = !this.handRaEngines.size()
  !part1            = 100 / !numberOfHandRas
  !part2            = (100 - !part1) / 3
  !part3            = 2 * (100 - !part1) / 3


--  if(!!aslStoreTable.getStore('platform').unset() or !!aslStoreTable.getStore('platform').badref())then
--    !!alert.error('Storage area is not set. Platform is generated under the current element.')
--  else
--    !!ce = !!aslStoreTable.getStore('platform')
--  endif

  -- creates/updates the owner element
  !this.refe = !!aslCreate('PLTFRM', !this.refe)

  !this.refe.orientation = !this.orientation
  !this.refe.position    = !this.position

  !this.refe.description = !this.pltFrmTmplReference.string() & ' ' & !this.settingReference.string()

  -- creates the loop (RPATH) element
  NEW RPATH
  !plooRefe           = !!ce
  !plooRefe.owner.position = !this.shape.position
  !plooRefe.owner.thickn = !this.height
  !this.shape.dbwrite(!!ce)

  --record the number of points in the rpath
  !!pathPoints = !plooRefe.members

  -- Build External Frame based on the Template definition
  !templateRef = !!aslMain.mePltFrmEngine.pltfrmdata.pltFrmTmplReference
  var !frames collect all extfrm for $!templateRef
  if (!frames.size() eq 1) then
    NEW EXTFRM copy $!frames[1]
    -- go to the points and set them
    var !kickPlates collect all kickpl for ce
    if (!kickPlates.size() eq 1) then
      !!ce = !kickPlates[1].dbref()
      -- unset the start and end references
      staRef nulref
      endRef nulref
      staRef $!!pathPoints[1]
      !lastPoint = !!pathPoints.size()
      endRef $!!pathPoints[$!lastPoint]
    endif
    EXTFRM
    var !gensecs collect all gensec for ce
    if (!gensecs.size() eq 1) then
      !!ce = !gensecs[1].dbref()
      delete gensec mem
      new spine
      !this.shape.dbwrite(!!ce)
    endif
  endif
  !!ce = !plooRefe

  !!fmSys.setProgress(!part1)

  -- create the openings
  !this.buildOpenings(!part2)

  -- create the handrails
  !this.buildHandras(!part3)

  !!ce = !this.refe

  !!fmSys.setProgress(0)

  -- end undo mark
  if ( !this.undoable ) then
    !undo.endUndoable()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: read the values from the HandRa
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  -- evaluates the panel loop
  !collection = object COLLECTION()
  !collection.type('PLOO')
  !collection.scope(!refe)
  !pLoopRefes = !collection.results()

  if ( !pLoopRefes.empty().not() ) then
    !pLoopRefe             = !pLoopRefes.first()
--TODO: updateDataObj clearance
    !this.clearance        = 2000mm
    !this.height           = !pLoopRefe.height

    !collection = object COLLECTION()
    !collection.type('LOOP')
    !collection.scope(!refe)
    !loopRefes                 = !collection.results()
    !this.openings             = object ARRAY()
    !this.openingsHandRaStatus = object ARRAY()
    do !loopRefe value !loopRefes
      !this.openings.append(object PROFILE(!loopRefe))
      !this.openingsHandRaStatus.append(true)
    enddo

    !this.justification       = !pLoopRefe.sJustification
    !this.orientation         = !refe.orientation
    !this.position            = !refe.position
    !this.refe                = !refe
    !this.settingReference    = !refe.description.after(' ')
    !this.shape               = object PROFILE(!pLoopRefe)
    !this.pltFrmTmplReference = object DBREF(!refe.description.before(' '))

  else

    !this.clearance           = 2000mm
    --MJB height was not being set
    !this.height              = !refe.thickness
    --MJB set justification to 'BOTT' as default for now
    --!this.justification       = !!aslMain.opJustificationPltFrm.selection()
    !this.justification       = 'BOTT'
    !this.orientation         = !refe.orientation
    !this.position            = !refe.position
    !this.refe                = !refe
    !this.settingReference    = !refe.description.after(' ')

    --MJB Do not get shape from !!profileUI, get from RPATH
    --!this.shape               = !!profileUI.meProfiles[1]

    --MJB get shape from RPATH
    !collection = object COLLECTION()
    !collection.type('RPATH')
    !collection.scope(!refe)
    !rpathRefes = !collection.results()
    if ( !rpathRefes.empty().not() ) then
      !rpathRefe             = !rpathRefes.first()
      !this.shape               = object PROFILE(!rpathRefe)

      --set shape in !!profileUI, as this is used for shape modification

      !profileUI                 = object PROFILEUI()
      !profileUI.acceptCallback  = '!!aslMain.newPltFrmShapeAccept(!this.meProfiles)'
      !profileUI.acceptDText     = 'Accept platform'
      !profileUI.create          = true
      !profileUI.discardCallback = '!!aslMain.newPltFrmShapeDiscard()'
      !profileUI.discardDText    = 'Discard platform'
      !profileUI.formTitle       = 'Platform'
      --!profileUI.profile         = object PROFILE()
      !profileUI.profile         = !this.shape
      !profileUI.load()

      --hide form (.load() method shows it)
      !!profileUI.hide()

      --!!profileUI.meProfiles[1] = !this.shape
    endif

    !this.pltFrmTmplReference = object DBREF(!refe.description.before(' '))

  endif

  -- update the handrail objects
  !collection         = object COLLECTION()
  !collection.type('HANDRA')
  !collection.scope(!refe)
  !handRaRefes        = !collection.results()
  !this.handRaEngines = object ARRAY()
  do !handRaRefe value !handRaRefes
    !handRaEngine = object ASLHANDRAENGINE()
    !handRaEngine.updateDataObj(!handRaRefe)
    !this.handRaEngines.append(!handRaEngine)
  enddo

  -- evaluates the current template for handrails
  if ( !this.handRaEngines.empty().not() ) then
    !this.handRaTmplReference = !this.handRaEngines.first().handRaData.tmplReference
  endif

  -- reads and corrects the gates from the handrail elements
  ---------------------------------------------------------------------------
  -- handles all handrails
  !this.gates = object ARRAY()
  do !handRaEngine value !this.handRaEngines
    !this.gates.appendArray(!handRaEngine.getGates())
  enddo
--  do !i index !this.handRaEngines
--    !gates = !this.handRaEngines[!i].handRaData.gates
--    -- handles all gates of the current handrail
--    do !j index !gates
--
--      -- generate positions in entry direction for the orientation check
--      !entryPos = !gates[!j].position.offSet(!gates[!j].entryDirection, 100mm)
--
--      -- check
--      if ( !this.shape.isWithout(!entryPos) ) then
--        !gates[!j].entryDirection = !gates[!j].entryDirection.opposite()
--        !gates[!j].exitDirection  = !gates[!j].exitDirection.opposite()
--      endif
--      !this.handRaEngines[!i].handRaData.gates = !gates
--      !this.gates.appendArray(!gates)
--    enddo
--  enddo

  --MJB Load openings into object/form

  --collect PLFEAT which own PLOPEN
  --load into object
  --load into list (grid-control gadget)

  !collection         = object COLLECTION()
  !collection.type('PLFEAT')
  !collection.scope(!refe)
  !plfeatRefes        = !collection.results()
  if !plfeatRefes.size().gt(0) then

    do !plfeat values !plfeatRefes

      !collection         = object COLLECTION()
      !collection.type('PLOPEN')
      !collection.scope(!plfeat)
      !plopenRefes        = !collection.results()

      if !plopenRefes.size().gt(0) then
        do !plopen values !plopenRefes

          !collection         = object COLLECTION()
          !collection.type('RPATH')
          !collection.scope(!plopen)
          !openingRpathRefes        = !collection.results()
          !firstopeningRpath            = !openingRpathRefes.first()

          !shape               = object PROFILE(!firstopeningRpath)

          !profiles = ARRAY()

          !profiles[1] = !shape

          !!aslMain.mePltFrmOpening = !profiles

          !!aslMain.mePltFrmEngine.addOpening(!profiles[1])

          -- evaluate the handrails
          --!this.mePltFrmEngine.evaluateHandRa()

          -- create the platform
          --!this.mePltFrmEngine.updateDB()

          -- updates the aid dimension elements
          --!this.showDimFeedbackPltFrm(object GADGET(), '')

          -- update the gadgets
          !!aslMain.updateFramePltFrm()
        enddo
      endif
    enddo
  endif
endmethod
-- End of method
