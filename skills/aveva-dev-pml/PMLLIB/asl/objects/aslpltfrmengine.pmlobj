------------------------------------------------------------------------
--
-- Method:      setCriteria
--
-- Description: sets the criteria from the current central standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setCriteria()

  !this.pltFrmCriteriaBasis = !!aslCentralData.currSubStandard.aslPltFrmCriteria
  !this.handRaCriteriaBasis = !!aslCentralData.currSubStandard.aslHandRaCriteria

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setGates
--
-- Description: sets all gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of all gates
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setGates(!gates is ARRAY)

  -- evaluates the added and the removed gates
  !addGates = !gates.difference(!this.pltFrmData.gates)
  !remGates = !this.pltFrmData.gates.difference(!gates)
  !oldGates = !this.pltFrmData.gates.intersect(!gates)

  -- assigns the gates to the gate stack
  !this.pltFrmData.gates = !oldGates
  !this.pltFrmData.gates.appendArray(!addGates)

endmethod
-- End of method

