------------------------------------------------------------------------

define method .drawOpenings()

  !this.pltFrmData.drawOpenings()

endmethod

------------------------------------------------------------------------
--
-- Method:      evaluateGate
--
-- Description: evaluates a gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position of the access
-- Return:
--   [Data Type] [Description]
--    GATE        gate
------------------------------------------------------------------------

define method .evaluateGate(!position is POSITION) is GATE

  -- evaluates the nearest edges
  !edgeIdx      = !this.pltFrmData.shape.nearEdges(!position).first()
  !edges        = !this.pltFrmData.shape.edges()
  !nearestEdge  = !edges[!edgeIdx]

  -- evaluates the position projected on the nearest edge
  !nearPosition = !nearestEdge.near(!position)

  -- assumption of the entry direction
  !entryDir     = !nearestEdge.direction().orthogonal(U)

  -- generate positions in entry direction for the orientation check
  !entryPos     = !nearPosition.offSet(!entryDir, 100)

  -- check
  if ( !this.pltFrmData.shape.isWithin(!entryPos) ) then
    !gate = object GATE(!nearPosition, !entryDir, !entryDir.opposite())
  else
    !gate = object GATE(!nearPosition, !entryDir.opposite(), !entryDir)
  endif

  return !gate

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateHandRa
--
-- Description: evaluates handrail elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateHandRa()

  -- get the values of the platform
  !pltFrmPos   = !this.pltFrmData.position
  !pltFrmOri   = !this.pltFrmData.orientation
  !pltFrmEdges = !this.pltFrmData.shape.edges()

  -- evaluate the polyline of the handrail
  !handRaEdges = object POLYLINE(!pltFrmPos, !pltFrmOri, !pltFrmEdges)

  -- initialise the handrail data objects
  !this.pltFrmData.handRaEngines                                = object ARRAY()
  !this.pltFrmData.handRaEngines[1]                             = object ASLHANDRAENGINE()
  !this.pltFrmData.handRaEngines[1].handRaCriteriaBasis         = !this.handRaCriteriaBasis
  !this.pltFrmData.handRaEngines[1].handRaCriteria              = !this.handRaCriteria
  !this.pltFrmData.handRaEngines[1].handRaData.settingReference = !this.pltFrmData.settingReference

  -- selects the templates
  !this.pltFrmData.handRaEngines[1].setTmplReference(!this.pltFrmData.handRaTmplReference)

  -- set default values
  !this.pltFrmData.handRaEngines[1].setDefaults()

  -- set the profile as shape
  !this.pltFrmData.handRaEngines[1].setRouting(!handRaEdges)

  -- set the default radius
  !this.pltFrmData.handRaEngines[1].setRadius(!this.pltFrmData.handRaEngines[1].handRaData.radius)

endmethod
-- End of method

