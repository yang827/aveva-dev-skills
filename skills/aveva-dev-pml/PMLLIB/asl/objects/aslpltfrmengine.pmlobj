--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of all openings
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setOpenings(!openings is ARRAY)

  !this.pltFrmData.openings = !openings

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setOpeningsHandRaStatus
--
-- Description: sets all openings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of all openings
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setOpeningsHandraStatus(!openingsHandraStatus is ARRAY)

  !this.pltFrmData.openingsHandraStatus = !openingsHandraStatus

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setSettingReference
--
-- Description: sets the setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setSettingReference()

  !this.pltFrmData.settingReference = !!aslCentralData.currSetting.description

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setSettingReference
--
-- Description: sets the setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      setting
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setSettingReference(!settingReference is STRING)

  !this.pltFrmData.settingReference = !settingReference
  !this.pltFrmCriteriaBasis         = !!aslCentralData.getCriteriaSet(!settingReference, 'ASLPLTFRMCRITERIA')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setShape
--
-- Description: sets the shape on data level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     the shape as profile object
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setShape(!shape is PROFILE)

  !this.pltFrmData.shape = !shape

  !this.evaluateHandRa()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setTmplReferences
--
-- Description: sets the template references
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      platform template reference
--    2   R      DBREF      handrail template reference
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setTmplReferences(!pltFrmTmplReference is DBREF, !handRaTmplReference is DBREF)

  !this.pltFrmData.pltFrmTmplReference = !pltFrmTmplReference
  !this.pltFrmData.handRaTmplReference = !handRaTmplReference

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: update the db with the form settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDB()

  !this.pltFrmData.updateDB()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: reads the data from db
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        reference element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  !this.pltFrmData.updateDataObj(!refe)
  !this.handRaCriteriaBasis = !!aslCentralData.getCriteriaSet(!this.pltFrmData.settingReference, 'ASLHANDRACRITERIA')
  !this.pltFrmCriteriaBasis = !!aslCentralData.getCriteriaSet(!this.pltFrmData.settingReference, 'ASLPLTFRMCRITERIA')

  !this.mergeCriteria()

endmethod
-- End of method
