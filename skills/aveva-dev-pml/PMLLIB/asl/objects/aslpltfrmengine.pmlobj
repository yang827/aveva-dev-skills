--    2   R      REAL        gate index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .replaceOpening(!opening is PROFILE, !openingIdx is REAL)

  !this.pltFrmData.openings[!openingIdx] = !opening

endmethod
-- End of method

