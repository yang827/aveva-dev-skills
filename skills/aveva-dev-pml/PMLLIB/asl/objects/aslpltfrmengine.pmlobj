------------------------------------------------------------------------
--
-- Method:      mergeCriteria
--
-- Description: merges central standard with fabricator standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergeCriteria()

  -- gets the values for the end landing from the substandard
  !this.pltFrmCriteria  = !!getCriteriaSetIntersection(!this.pltFrmCriteriaBasis, !this.pltFrmData.pltFrmTmplReference)
  !this.pltFrmCriteria.complete()

  -- gets the values for the end landing from the substandard
  !this.handRaCriteria  = !!getCriteriaSetIntersection(!this.handRaCriteriaBasis, !this.pltFrmData.handRaTmplReference)
  !this.handRaCriteria.complete()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergeOpenings
--
-- Description: merge Openings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       indices of openings
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergeOpenings(!openingIndices is ARRAY)

  -- inits
  !openingIdx    = !openingIndices.first()
  !openingMaster = !this.pltFrmData.openings[!openingIdx]

  -- check all further openings
  do !openingIdx value !openingIndices.from(2)

    -- gets the current opening
    !opening = !this.pltFrmData.openings[!openingIdx]

    -- check for intersection
    if ( !openingMaster.isIntersecting(!opening) ) then
      !openingMaster = !openingMaster.union(!opening).first()
    else
      !this.pltFrmData.error = true
      return
    endif
  enddo
  -- updates the first opening
  !openingIdx                            = !openingIndices.first()
  !this.pltFrmData.openings[!openingIdx] = !openingMaster

  -- removes the other openings
  !this.remOpenings(!openingIndices.from(2))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergePlatform
--
-- Description: merge Platform
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLPLTFRMENGINE
--                           platform to be merged
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergePlatForm(!secondPlatForm is ASLPLTFRMENGINE)

  ---------------------------------------------------------------------------
  -- merge the shapes
  !firstShape  = !this.getShape()

  -- get the shape of the new platform
  !secondShape = !secondPlatForm.getShape()

  -- merge the shapes
  !newShape    = !firstShape.union(!secondShape)

  -- set the shape as profile shape
  !this.setShape(!newShape[1])

  ---------------------------------------------------------------------------
  -- take over the gates
  !firstGates    = !this.getGates()

  -- gates of the second platform
  !secondGates   = !secondPlatForm.getGates()

  -- combined gates
  if ( !secondGates.empty().not() ) then
    !firstGates.appendArray(!secondGates)
  endif

  -- set the gates
  !this.setGates(!firstGates)


  ---------------------------------------------------------------------------
  -- take over the openings
  !firstOpenings    = !this.getOpenings()

  -- gates of the second platform
  !secondOpenings   = !secondPlatForm.getOpenings()

  -- combined openings
  if ( !secondOpenings.empty().not() ) then
    !firstOpenings.appendArray(!secondOpenings)
  endif

  -- set the gates
  !this.setOpenings(!firstOpenings)

  ---------------------------------------------------------------------------
  -- take over the opening handrail status
  !firstOpeningHandraStatus    = !this.getOpeningsHandraStatus()

  -- handrail status of the second platform
  !secondOpeningHandraStatus   = !secondPlatForm.getOpeningsHandraStatus()

  -- combined handra status on/off
  if ( !secondOpeningHandraStatus.empty().not() ) then
    !firstOpeningHandraStatus.appendArray(!secondOpeningHandraStatus)
  endif

  -- set the gates
  !this.setOpeningsHandraStatus(!firstOpeningHandraStatus)

  ---------------------------------------------------------------------------
  -- delete the second platform
  !refe = !!ce
  !!ce  = !secondPlatForm.getRefe()
  DELETE STRLNG
  !!ce  = !refe

  -- merge the platforms
  !this.updateDB()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergePlatforms
--
-- Description: merge Platforms
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of platforms
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergePlatforms(!allPlatForms is ARRAY)

  !allPlatForms.unique()

  -- original shap
  !originalShape         = !this.getShape()

  -- stack of platforms that can not be merged with the first try, but maybe later
  !notYetMergedPlatforms = ARRAY()

  -- stack of platforms that could be merged
  !mergedPlatforms       = ARRAY()

  -- stack of platforms that could not be merged
  !wrongPlatforms        = ARRAY()

  -- loop through the platforms and try to merge them with the first
  do !platForm value !allPlatForms

    skip if ( !platForm.eq(!this.getRefe()) )

    -- create an engine of the second platform
    !secondPlatForm = object ASLPLTFRMENGINE()
    !secondPlatForm.updateDataObj(!platForm)

    !secondShape = !secondPlatForm.getShape()

    -- check if they overlap
    !overlapFlag = !originalShape.isIntersecting(!secondShape)

    -- if they do not overlap then put the new platform on the not-yet-merged-stack and try it again later
    if ( !overlapFlag.not() ) then
      !notYetMergedPlatforms.append(!platForm)
      skip
    endif

    -- merge the platforms
    !this.mergePlatForm(!secondPlatForm)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newDefaults
--
-- Description: sets the attributes for a new platform (defaults
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       platform template
--    2   R      DBREF       handrail template
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newDefaults(!pltFrm is DBREF, !handRa is DBREF)

  -- sets the criteria
  !this.setCriteria()

  -- sets the reference to the central template
  !this.setSettingReference()

  -- if the dbref is part of the current standard use it, otherwise take the first best of the standard
  !allPltFrms = !!aslCentralData.currSetting.collectAll('PLTFRM')
  if ( !allPltFrms.findFirst(!pltFrm).set() ) then
    !pltFrmTmpl = !pltFrm
  else
    !pltFrmTmpl = !allPltFrms.first()
  endif

  !allHandRas = !!aslCentralData.currSetting.collectAll('HANDRA')
  if ( !allHandRas.findFirst(!handRa).set() ) then
    !handRaTmpl = !handRa
  else
    !handRaTmpl = !allHandRas.first()
  endif

  -- selects the templates
  !this.setTmplReferences(!pltFrmTmpl, !handRaTmpl)

  -- combines general and fabricator standard
  !this.mergeCriteria()

  -- inits
  !this.setHeight(50)

  -- justification
  !this.setJustification('BOTT')

--TODO to be removed
  -- basis gates
  !this.pltFrmData.gates    = ARRAY()

  -- openings
  !this.pltFrmData.openings = ARRAY()

  -- basis shape, not to be modified yet
  !this.pltFrmData.shape    = object PROFILE()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      remGates
--
-- Description: removes gates from the gate stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       indices of gates
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .remGates(!gateIndices is ARRAY)

  do !gateIdx value !gateIndices
    !gate = !this.pltFrmData.gates[!gateIdx]
    !this.pltFrmData.gates.deleteFrom(!gateIdx, 1)
  enddo
  !this.pltFrmData.gates.compress()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      remOpenings
--
-- Description: removes openings from the openings stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       indices of openings
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .remOpenings(!openingIndices is ARRAY)

  do !openingIdx value !openingIndices
    !opening = !this.pltFrmData.openings[!openingIdx]
    !this.pltFrmData.openings.deleteFrom(!openingIdx, 1)
    !this.pltFrmData.openingsHandraStatus.deleteFrom(!openingIdx, 1)
  enddo
  !this.pltFrmData.openings.compress()
  !this.pltFrmData.openingsHandraStatus.compress()

endmethod
-- End of method

