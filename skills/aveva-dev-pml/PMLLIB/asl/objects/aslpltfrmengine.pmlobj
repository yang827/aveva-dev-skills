--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addGate(POSITION)                -                   adds a new gate to the gate stack
--  addOpening(PROFILE)              -                   adds a new opening to the opening stack
--  aslPltFrmEngine()                -                   default constructor
--  drawAccess()                     -                   draws access points
--  drawOpenings()                   -                   draws openings
--  evaluateGate(POSITION)           GATE                evaluates a gates
--  evaluateHandRa()                 -                   evaluates handrail elements
--  getError()                       BOOLEAN             returns the error status
--  getGates()                       ARRAY               returns an array of gates
--  getHandRaTmplReference()         DBREF               returns the template of handrail
--  getHeight()                      REAL                gets the height
--  getJustification()               STRING              get top/bottom justification
--  getOpenings()                    ARRAY               returns an array of openings
--  getOpeningsHandraStatus()        ARRAY
--  getPltFrmTmplReference()         DBREF               returns the template of the platform
--  getRefe()                        DBREF               returns the reference
--  getSettingReference()            STRING              gets the setting
--  getShape()                       PROFILE             gets the shape from the data level
--  mergeCriteria()                  -                   merges central standard with fabricator standard
--  mergeOpenings(ARRAY)             -                   merge Openings
--  mergePlatForm(ASLPLTFRMENGINE)   -
--  mergePlatforms(ARRAY)            -                   merge Platforms
--  newDefaults(DBREF,DBREF)         -                   sets the attributes for a new platform (defaults
--  remGates(ARRAY)                  -                   removes gates from the gate stack
--  remOpenings(ARRAY)               -                   removes openings from the openings stack
--  replaceGate(GATE,REAL)           -                   replaces an existing gate by a new one
--  replaceGate(POSITION,REAL)       -                   replaces an existing gate by a new one
--  replaceOpening(PROFILE,REAL)     -                   replaces an existing opening by a new one
--  resetError()                     -                   resets error status
--  setCriteria()                    -                   sets the criteria from the current central standard
--  setGates(ARRAY)                  -                   sets all gates
--  setHeight(REAL)                  -                   sets the height
--  setJustification(STRING)         -                   set top/bottom justification
--  setOpenings(ARRAY)               -                   sets all openings
--  setOpeningsHandraStatus(ARRAY)   -
--  setSettingReference()            -                   sets the setting
--  setSettingReference(STRING)      -                   sets the setting
--  setShape(PROFILE)                -                   sets the shape on data level
--  setTmplReferences(DBREF,DBREF)   -                   sets the template references
--  updateDB()                       -                   update the db with the form settings
--  updateDataObj(DBREF)             -                   reads the data from db
--

-- Define object
define object ASLPLTFRMENGINE

  -- public members
  ---------------------------------------------------------------------------
  -- container for the platform data
  member .pltFrmData          is ASLPLTFRMDATA

  -- private members
  ---------------------------------------------------------------------------
  -- contains the criteria set for handrail elements (including fabricator standard)
  member .handRaCriteria      is ASLHANDRACRITERIA

  -- contains the criteria set for handrail elements (excluding fabricator standard)
  member .handRaCriteriaBasis is ASLHANDRACRITERIA

  -- contains the criteria set for platform elements (including fabricator standard)
  member .pltFrmCriteria      is ASLPLTFRMCRITERIA

  -- contains the criteria set for platform elements (excluding fabricator standard)
  member .pltFrmCriteriaBasis is ASLPLTFRMCRITERIA

  -- contains a copy of stair landing data before modify
  member .pltFrmDataOld       is ASLPLTFRMDATA

endobject
-- End of object definition for aslPltFrmEngine

