------------------------------------------------------------------------
--
-- Method:      setJustification
--
-- Description: set top/bottom justification
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      TOP/BOTTOM
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setJustification(!justification is STRING)

  !this.pltFrmData.justification = !justification

endmethod
-- End of method

------------------------------------------------------------------------
