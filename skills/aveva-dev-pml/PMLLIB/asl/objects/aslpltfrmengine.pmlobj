-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslPltFrmEngine()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addGate
--
-- Description: adds a new gate to the gate stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position of the access
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .addGate(!position is POSITION)

  !gate = !this.evaluateGate(!position)
  !this.pltFrmData.gates.append(!gate)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addOpening
--
-- Description: adds a new opening to the opening stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     gate
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .addOpening(!opening is PROFILE)

  !plane       = !this.pltFrmData.shape.plane()
  !position    = !plane.near(!opening.position)
  !projOpening = !opening
  !projOpening.position = !position
  !this.pltFrmData.openings.append(!projOpening)
  !this.pltFrmData.openingsHandraStatus.append(true)

endmethod
-- End of method

