-- Created:         Tue Dec 09 15:15:00 IST 2008
--
--
-- Description:
--   Object for holding Spec detail fo the stair landing definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslPltSpec(STRING,STRING,ASLSTRLNGDATA) -                   Constructor
--  show()                           -                   Show selection form
--

define object ASLPLTSPEC

  -- Title of selection form
  member .title           is STRING

  -- Action to be carried out on Apply
  member .action          is STRING

  -- Profile catalogue data
  member .strLngData      is ASLSTRLNGDATA

  --template reference
  member .handRaTmplReference is DBREF

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      aslPltSpec
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Title to be shown on form
--    2   R      STRING      Action to be carried out on "Apply"
--    3   R      STRING      Stair landing data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslPltSpec(!title is STRING, !action is STRING, !strLngData is ASLSTRLNGDATA)

  !this.title        =  !title
  !this.action       =  !action
  !this.strLngData   =  !strLngData

endmethod

------------------------------------------------------------------------
--
-- Method:      show
--
-- Description: Show selection form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .show()

  -- Load the data for selection and the form if required
  if(undefined(!!pltSpecification)) then
    pml reload form !!pltSpecification
  endif

  -- Setup form
  !!pltSpecification.setup(!this.title, !this.action, !this.strLngData)

endmethod
-- End of method definition
