-- Created:         Thu Sep 20 15:07:21 GMT 2007
--
-- Description:     Object to hold RPATH definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  anyCurve2Thru(ANY,POSITION,POSITION) ARRAY               convert curve of any type to type THRU
--  arcLength(ARC,REAL)              ARC                 return new arc with passed length based on passed arc maintaining the start position
--  aslRpath()                       -                   default Constructor
--  aslRpath(ARRAY)                  -                   Constructor
--  aslRpath(ARRAY,ARRAY,ARRAY)      -                   Constructor
--  aslRpath(ARRAY,ARRAY,ARRAY,ARRAY) -                   Constructor
--  aslRpath(ARRAY,ARRAY,ARRAY,ARRAY,ARRAY) -                   Constructor
--  aslRpath(ARRAY,DIRECTION)        -                   Constructor
--  aslRpath(DBREF,STRING)           -                   Constructor
--  aslRpath(DIRECTION)              -                   default constructor
--  aslRpath(PROFILE)                -                   Constructor
--  close()                          -                   add last point at the same position as first point
--  curve2edge(ANY,POSITION,POSITION) ARRAY               map CURVE element to arc and/or line(s)
--  dbWrite(DBREF)                   DBREF               apply object data to RPATH
--  draw(REAL,REAL,REAL,BOOLEAN)     ASLRPATH            draw object as aid graphic
--  edge2Vertex(ARRAY,REAL)          ARRAY
--  edgeOf(REAL,BOOLEAN)             ARRAY               edge associated with vertex
--  edges(BOOLEAN)                   ARRAY               get the edges of the object
--  edges(REAL,REAL,BOOLEAN)         ARRAY               get the edges of the object
--  endOfCurve(REAL)                 BOOLEAN             return true if POINTR is at the start/end of curved segment
--  endOfCurve(REAL,STRING)          BOOLEAN             return true if POINTR is at the passed end of curved segment
--  eq(ASLRPATH)                     BOOLEAN             compare equality of two objects
--  facetEdges(BOOLEAN)              ARRAY               facet all curved edges
--  getCurveAtt(DBREF)               ARRAY
--  getRemovedRef()                  DBREF               remove first item from removedRef array and return it. Nulref is returned if array is empty
--  getSegmentEnd(ANY,STRING)        POINTVECTOR         get endpoint of either LINE or ARC
--  insertVertex(STRING,REAL,POSITION,ANY,DBREF) ARRAY
--  isClosed()                       BOOLEAN             return true if object is a valid shape (PROFILE) that can be closed
--  isFillet(ARRAY,REAL)             BOOLEAN             is the given edge a fillet
--  isFillet(ARRAY,REAL,REAL)        BOOLEAN             is the given edge a fillet - arc radius must be less then specified
--  isFillet(REAL,BOOLEAN)           BOOLEAN             is the given vertex a fillet
--  loadPoints(ARRAY,STRING)         -                   load array of POINTR/CURVE into object
--  merge(ASLRPATH)                  ASLRPATH            merge two ASLRPATH objects
--  mergeVertices(REAL,REAL)         ARRAY               remove redundant vertices that are on the edge (i.e. not corner making)
--  near(POSITION,BOOLEAN)           ARRAY               returns the nearest edge to given position
--  nextPointOf(REAL)                REAL                return next POINTR vertex of passed index (jumps over CURVEs)
--  offset(DIRECTION,REAL)           ASLRPATH            return ASLRPATH object moved by given distance in given direction
--  prevPointOf(REAL)                REAL                return previous POINTR vertex of passed index (jumps over CURVEs)
--  profile(BOOLEAN)                 PROFILE             convert object to PROFILE
--  profile(BOOLEAN,POSITION,ORIENTATION) PROFILE             convert object to PROFILE object with explicit orientation and position
--  radius(REAL)                     -                   apply radius to all POINTRs
--  removeVertex(REAL)               ARRAY
--  segment(BOOLEAN)                 -                   calculate rpath segments and store them temporarily not to be calculate each time they are needed
--  segmentLength(REAL)              REAL                return length of segment of passed index
--  set()                            BOOLEAN             returns true if object is set
--  size()                           REAL                return number of vertices
--  snap2edge(POSITION,BOOLEAN)      ARRAY               project passed position to edge of rpath
--  split(POSITION,BOOLEAN,REAL)     ARRAY               split ASLRPATH objects
--  updateGeometry()                 REAL                align each vertex with its sigref (if set)
--  vertex2Edge(REAL,POSITION)       ARRAY               convert vertex to the edge (LINE, ARC) leading to it from previous
--
define object ASLRPATH

  -- reference numbers
  member .refe               is ARRAY

  -- vertices
  member .vertex             is ARRAY

  -- vertex details
  member .detail             is ARRAY

  -- types
  member .type               is ARRAY

  -- Z direction
  member .zdir               is DIRECTION

  -- reference to POINTR in another RPATH
  member .sigref             is ARRAY

  -- path segments (filleting arcs excluded)
  member .segment            is ARRAY

  -- removed ref. numbers to be repeated
  member .removedRef         is ARRAY

  -- type of owner of rpath, currently only HANDRA is relevant
  member .ownerType          is STRING

endobject
-- End of object definition for Criterion

------------------------------------------------------------------------
--
-- Method:      aslRpath
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslRpath()

  !this.ownerType = ''
  !this.zdir = U wrt world
  !this.vertex.clear()
  !this.detail.clear()
  !this.type.clear()
  !this.sigref.clear()
  do !refe values !this.refe
    if !refe.set() then
      !this.removedRef.append(!refe)
    endif
  enddo
  !this.refe.clear()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aslRpath
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   Normal to general plane of rpath
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslRpath(!zdir is DIRECTION)

  !this.aslRpath()
  !this.zdir = !zdir.wrt(world)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aslRpath
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of LINEs, ARCs or POSITIONs OR any objects that have member .position
--    2   R      DIRECTION   normal to general plane of rpath
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslRpath(!edgearray is ARRAY,!zdir is DIRECTION)

  !this.aslRpath(!zdir)

  !pos = ARRAY()
  !type = ARRAY()
  !detail = ARRAY()

  -- convert array members that are not LINE, ARC or POSITION to position
  !edges = !edgearray
  do !c indices !edgearray
    !objtype = !edgearray[!c].objectType()
    if !objtype.eq('LINE').or(!objtype.eq('ARC')).or(!objtype.eq('POSITION')).not() then
      !edges[!c].delete()
      !pos = !edgearray[!c].position
      handle NONE
        !edges[!c] = !pos
      elsehandle ANY
      endhandle
    endif
  enddo
  !edges.compress()

  -- then get close flag
  !firstpos = !this.getSegmentEnd(!edges[1],'start').position
  !lastpos = !this.getSegmentEnd(!edges.last(),'end').position
  !lasttype = !edges.last().objectType()
  !closeFlag = !firstpos.eq(!lastpos).and(!lasttype.neq('ARC'))

  -- get first vertex if first edge is a LINE
  if !edges[1].objectType().eq('LINE') then
    if !lasttype.eq('ARC') then
      if !this.isFillet(!edges,!edges.maxIndex(),500mm) then
        !vertex = !this.edge2vertex(!edges,!edges.maxIndex())
        !pos[1] = !vertex[1]
        !type[1] = !vertex[2]
        !detail[1] = !vertex[3]
        !closeFlag = true
      else
        !pos[1] = !edges[1].startposition
        !type[1] = 'POINTR'
        !detail[1] = 0
      endif
    else
      !pos[1] = !edges[1].startposition
      !type[1] = 'POINTR'
      !detail[1] = 0
    endif
  endif

  do !c indices !edges
    skip if !closeFlag.and(!c.eq(!edges.size()))
    !vertex = !this.edge2vertex(!edges,!c)
    if defined(!vertex[1]) then
       !pos.append(!vertex[1])
       !type.append(!vertex[2])
       !detail.append(!vertex[3])
    endif
    if defined(!vertex[4]) then
       !pos.append(!vertex[4])
       !type.append(!vertex[5])
       !detail.append(!vertex[6])
    endif
    if defined(!vertex[7]) then
       !pos.append(!vertex[7])
       !type.append(!vertex[8])
       !detail.append(!vertex[9])
    endif
  enddo


  !this.aslRpath(!pos, !type, !detail)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aslRpath
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of LINEs, ARCs or POSITIONs OR any objects that have member .position
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslRpath(!edgearray is ARRAY)

  !zdir = U wrt world

  !this.aslRpath(!edgearray, !zdir)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      aslRpath
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     profile object
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslRpath(!profile is PROFILE)

  !edges = !profile.edges()

  -- special treatment if profile is a circle
  if !profile.isCircle() then
    !circle = !edges[1]
    !circle.startangle = 0
    !circle.endangle = 360
    !vertex[1] = !circle.anglePosition(0)
    !vertex[2] = !circle.anglePosition(90)
    !vertex[3] = !circle.anglePosition(180)
    !vertex[4] = !circle.anglePosition(270)
    !vertex[5] = !circle.anglePosition(0)
    !type[1] = 'POINTR'
    !type[2] = 'CURVE'
    !type[3] = 'POINTR'
    !type[4] = 'CURVE'
    !type[5] = 'POINTR'
    !curveDetail[1] = 'THRU'
    !curveDetail[2] = 0
    !curveDetail[3] = e0
    !curveDetail[4] = 0
    !curveDetail[5] = true
    !detail[1] = 0
    !detail[2] = !curveDetail
    !detail[3] = 0
    !detail[4] = !curveDetail
    !detail[5] = 0
    !this.aslRpath(!vertex, !type, !detail)
    return
  endif

  !this.aslRpath(!edges,!profile.orientation.zdir())

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      aslRpath
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of positions
--    2   R      ARRAY       array of vertex types
--    3   R      ARRAY       either array of radiuses of POINTRs or array of detail arrays of CURVE (curve type, radius, bulgefactor, etc.)
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslRpath(!vertex is ARRAY, !type is ARRAY, !detail is ARRAY)

  -- init
  !sigref = ARRAY()
  do !c indices !type
    !sigref[!c] = nulref
  enddo

  !this.aslRpath(!vertex, !type, !detail, !sigref)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aslRpath
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of positions
--    2   R      ARRAY       array of vertex types
--    3   R      ARRAY       either array of radiuses of POINTRs or array of detail arrays of CURVE (curve type, radius, bulgefactor, etc.)
--    4   R      ARRAY       reference to another point (SIGREF - dbref array)
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslRpath(!vertex is ARRAY, !type is ARRAY, !detail is ARRAY, !sigref is ARRAY)

  --init
  !refe = ARRAY()
  do !c indices !vertex
    !refe[!c] = !this.getRemovedRef()
  enddo


  !this.aslRpath(!vertex, !type, !detail, !sigref, !refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aslRpath
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of positions
--    2   R      ARRAY       array of vertex types
--    3   R      ARRAY       either array of radiuses of POINTRs or array of detail arrays of CURVE (curve type, radius, bulgefactor, etc.)
--    4   R      ARRAY       reference to another point (SIGREF - dbref array)
--    5   R      ARRAY       array of vertex references
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslRpath(!vertex is ARRAY, !type is ARRAY, !detail is ARRAY, !sigref is ARRAY, !refe is ARRAY)

  if !this.zdir.unset() then
    !this.aslRpath()
  endif

  !this.vertex    = !vertex
  !this.detail    = !detail
  !this.type      = !type
  !this.sigref    = !sigref
  !this.refe      = !refe

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aslRpath
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Any item that can own RPATH, SPINE, LOOP, PLOO or any item below them
--    2   R      STRING      operation mode - "load" (to load existing RPATH) or "track" (to copy existing any path)
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslRpath(!ref is DBREF,!mode is STRING)

  !rpath = object DBREF()

  -- permissible types
  !vertex[1] = 'POINTR'
  !vertex[2] = 'POINSP'
  !vertex[3] = 'CURVE'
  !vertex[4] = 'VERT'
  !vertex[5] = 'PAVE'
  !owner[1] = 'RPATH'
  !owner[2] = 'SPINE'
  !owner[3] = 'LOOP'
  !owner[4] = 'PLOO'

  -- check type of !ref
  if !vertex.findfirst(!ref.type).set() then
    !rpath = !ref.owner
  elseif !owner.findfirst(!ref.type).set() then
    !rpath = !ref
  else
    do !owntyp values !owner
      !rpath = !!dtbMemberOfType(!ref,!owntyp,1)
      break if !rpath.set()
    enddo
  endif

  if !rpath.unset() then
    return error 1 'Cannot  construct  ASLRPATH  from this element'
  endif

  -- get zdir and type from owner
  !this.zdir = !rpath.owner.orientation.zdir().wrt(world)
  !this.ownerType = !rpath.owner.type

  -- load vertices
  !this.loadPoints(!rpath.memb,!mode)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      eq
--
-- Description: compare equality of two objects
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLRPATH    Compared object
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .eq(!that is ASLRPATH) is BOOLEAN

  -- only the principal members are compared here
  if !this.vertex.neq(!that.vertex) then
    return FALSE
  elseif !this.detail.neq(!that.detail) then
    return FALSE
  elseif !this.type.neq(!that.type) then
    return FALSE
  elseif !this.sigref.neq(!that.sigref) then
    return FALSE
  endif

  return true

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      loadPoints
--
-- Description: load array of POINTR/CURVE into object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       dbref array
--    2   R      STRING      operation mode - "load" or "track"
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadPoints(!points is ARRAY,!mode is STRING)

  -- init
  !vertex = ARRAY()
  !detail = ARRAY()
  !type = ARRAY()
  !sigref = ARRAY()
  !refe = ARRAY()

  -- store and remove existing references
  do !c indices !this.refe
    !refno = !this.refe[!c]
    if !refno.set() then
      !this.removedRef.append(!refno)
    endif
  enddo


--  do !member values !points
  do !c indices !points
    !member = !points[!c]
    !load = !mode.upcase().eq('LOAD')
    if !load then
      !sigr = !member.sigref
      handle ANY
        !sigr = nulref
      endhandle
    else
      !sigr = !member
    endif
    if !member.type.eq('CURVE') then
    -- CURVE
      if !load then
        !vertex.append(!member.position.wrt(world))
        !type.append('CURVE')
        !detail.append(!this.getCurveAtt(!member))
        !sigref.append(!sigr)
        !refe.append(!member)
      else
        !prevpos = !vertex.last()
        !nextpos = !points[!c + 1].pos.wrt(world)
        !convCurve = !this.anyCurve2Thru(!member,!prevpos,!nextpos)
        !vertex.appendarray(!convCurve[1])
        !type.appendarray(!convCurve[2])
        !detail.appendarray(!convCurve[3])
        do !cc indices !convCurve[2]
          if !convCurve[2][!cc].eq('POINTR') then
            !sigref.append(nulref)
          else
            !sigref.append(!sigr)
          endif
          !refe.append(!this.getRemovedRef())
        enddo
      endif
    elseif !member.type.eq('POINSP') then
    -- POINSP - has no fillet radius
      !vertex.append(!member.position.wrt(WORLD))
      !type.append('POINTR')
      !detail.append(0)
      !sigref.append(!sigr)
      if !load then
        !refe.append(!member)
      else
        !refe.append(!this.getRemovedRef())
      endif
    else
    -- other types ( PAVE, VERT, POINTR ) can have fillet radius
      !vertex.append(!member.position.wrt(WORLD))
      !type.append('POINTR')
      !detail.append(!member.fradi)
      !sigref.append(!sigr)
      if !load then
        !refe.append(!member)
      else
        !refe.append(!this.getRemovedRef())
      endif
    endif
  enddo

  -- merge coincident vertices
  !indxsToRemove = ARRAY()
  do !c indices !vertex
    skip if !type[!c].eq('CURVE')
    !indxs = !vertex.find(!vertex[!c])
    if !indxs.size().gt(1) then
      !indxs.removeFirst()
      do !cc values !indxs
        skip if !cc.eq(!vertex.maxIndex())
        skip if !type[!cc].eq('CURVE')
        !indxsToRemove.append(!cc)
      enddo
    endif
  enddo
  !indxsToRemove.sortunique()
  !indxsToRemove.invert()
  do !c values !indxsToRemove
    !vertex.remove(!c)
    !type.remove(!c)
    !detail.remove(!c)
    !sigref.remove(!c)
    !refe.remove(!c)
  enddo

  !isHandrail = !this.ownerType.eq('HANDRA')

  if !vertex.set() then
    !rpath = !points.first().owner
    !maxindx = !vertex.maxIndex()
    if defined(!type[!maxindx - 1]) then
      !beforelast = !type[!maxindx - 1]
      -- remove last vertex only if same as first vertex and rpath owner is handrail ad previous vertex is not a curve
      if !vertex.first().eq(!vertex.last()).and(!beforelast.neq('CURVE')).and(!isHandrail) then
        !vertex[!maxindx].delete()
        !type[!maxindx].delete()
        !detail[!maxindx].delete()
        !sigref[!maxindx].delete()
        !refe[!maxindx].delete()
      endif
    endif
  endif

  !this.aslRpath(!vertex, !type, !detail, !sigref, !refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      size
--
-- Description: return number of vertices
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        number of vertices
--
------------------------------------------------------------------------

define method .size() is REAL

  return !this.vertex.size()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbWrite
--
-- Description: apply object data to RPATH
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       the element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dbWrite(!ref is DBREF) is DBREF

  !oldRef = !!ce

  if !ref.badref() then
    if !ref.unset() then
      new RPATH
    else
      new RPATH REF $!ref
    endif
  else
    !!ce = !ref
  endif

  -- store rpath refno to be returned
  !rpathRef = !!ce

  delete RPATH members

  do !c indices !this.vertex
    !type = !this.type[!c]
    -- repeat refno
    if !this.refe[!c].set() then
      !refno = 'REF ' & !this.refe[!c]
    else
      !refno = ''
    endif
    new $!type $!refno
    !this.refe[!c] = !!ce

    !!ce.position = !this.vertex[!c]
    if !!ce.type.eq('POINTR') then
      !!ce.frad = !this.detail[!c]
      if !this.sigref[!c].badref().not() then
        !!ce.sigref = !this.sigref[!c]
        handle ANY
        endhandle
      endif
    elseif !!ce.type.eq('CURVE') then
      !curtyp = !this.detail[!c][1]
      !bulgef = !this.detail[!c][2]
      !cpos = !this.detail[!c][3]
      !radi = !this.detail[!c][4]
      !radsetf = !this.detail[!c][5]
      if !curtyp.eq('BULG') then
        !!ce.bulgef = !bulgef
        !!ce.cpos = !cpos
      elseif !curtyp.eq('RADI') then
        !!ce.radi = !radi
        !!ce.cpos = !cpos
        !!ce.radsetf = !radsetf
      elseif !curtyp.eq('FILL') then
        !!ce.radi = !radi
        !!ce.radsetf = !radsetf
      elseif !curtyp.eq('CENT') then
        !!ce.radi = !radi
        !!ce.cpos = !cpos
      endif
      !!ce.curtyp = !curtyp
    endif
  enddo

  !!ce = !oldRef

  return !rpathRef

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateGeometry
--
-- Description: align each vertex with its sigref (if set)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        number of modified vertices
--
------------------------------------------------------------------------

define method .updateGeometry() is REAL

  -- init
  !modified = 0
  !vertex = !this.vertex

  do !c indices !vertex
    skip if !this.sigref[!c].badref()
    skip if !this.type[!c].neq('POINTR')
    skip if !this.sigref[!c].owner.owner.type.eq('STRFLT')
    !refpos = !this.sigref[!c].pos
    if !refpos.near(!vertex[!c],1mm).not() then
      !vertex[!c] = !refpos
      !modified = !modified + 1
    endif
  enddo

  !this.vertex = !vertex

  return !modified

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      radius
--
-- Description: apply radius to all POINTRs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        radius
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .radius(!radius is REAL)

  --process all pointers
  do !c indices !this.vertex
    skip if !this.type[!c].neq('POINTR')
    !this.detail[!c] = !radius
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: draw object as aid graphic
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        aid graphic ID number
--    2   R      REAL        linetype
--    3   R      REAL        colour
--    4   R      BOOLEAN     close flag
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw(!number is REAL, !lineType is REAL, !colour is REAL, !closef is BOOLEAN) is ASLRPATH

  !edges = !this.edges(!closef)
  do !edge values !edges
    !edge.draw(!number, !lineType, !colour)
    handle ANY
    endhandle
  enddo

  return !this

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      facetEdges
--
-- Description: facet all curved edges
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     close flag
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       return segment data
--
------------------------------------------------------------------------

define method .facetEdges(!closeFlag is  BOOLEAN) is ARRAY

  -- init
  !this.segment(!closeFlag)
  !segment =!this.segment

  do !c indices !segment
    !tmpsegm = ARRAY()
    do !cc indices !segment[!c]
      if !segment[!c][!cc].objectType().eq('LINE') then
        !tmpsegm.append(!segment[!c][!cc])
      else
        !facet = !segment[!c][!cc].length() / 200mm
        !splitArc = !segment[!c][!cc].split(!facet.int())
        do !tmpArc values !splitArc
          !tmpLine = !tmpArc.anglePosition(!tmpArc.startangle).line(!tmpArc.anglePosition(!tmpArc.endangle))
          !tmpsegm.append(!tmpLine)
        enddo
      endif
    enddo
    !segment[!c] = !tmpsegm
  enddo

  return !segment

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      edges
--
-- Description: get the edges of the object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Close flag
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] array of LINEs and ARCs
--                [2] index array of associated vertices
--
------------------------------------------------------------------------

define method .edges(!from is REAL, !to is REAL, !closeFlag is BOOLEAN) is ARRAY

  -- init
  !edges = ARRAY()
  !index = ARRAY()
  !result[1] = ARRAY()
  !result[2] = ARRAY()

  if !this.unset() then
    return !result
  endif

  !prevpos = !this.vertex[1]

  -- copy close flag to local variable
  !isClosed = !closeFlag

  -- switch closeFlag off if there are less than three vertices or when last and first vertex is coincident - it is closed anyway
  if !this.vertex.size().lt(3).or(!this.vertex.last().eq(!this.vertex.first())) then
    !isClosed = FALSE
  endif

  -- start main loop
  do !c indices !this.vertex

    !edge = ARRAY()
    if !c.eq(1) then

    -- first vertex
      if !isClosed then
      -- edge to first vertex is last one
        !lastedge = !this.vertex2Edge(1,!this.vertex.last())
        !prevpos = !this.getSegmentEnd(!lastedge.last(),'end').position
      endif

    else

    -- other vertices
      !edge = !this.vertex2Edge(!c,!prevpos)
      if !c.eq(!this.vertex.size()) then
      -- last vertex
        if !isClosed then
          !lastpos = !this.getSegmentEnd(!edge.last(),'end').position
          handle NONE
            !lastedge[1].startposition = !lastpos
          elsehandle ANY
          endhandle
        else
          if defined(!edge[2]) then
            !edge[1].endposition = !this.vertex[!c]
            !edge[2].delete()
          endif
        endif
      endif

    endif

    skip if !edge.empty()
    !edges.appendarray(!edge)

    -- assign vertex index to each component of !edge array
    do !cc indices !edge
      if !c.eq(1) then
        !index.append(!c)
      else
        !index.append(!c - 1)
      endif
    enddo
    !prevpos = !this.getSegmentEnd(!edges.last(),'end').position
    handle ANY
    endhandle

  -- end of main loop
  enddo

  if !isClosed then
    !edges.appendarray(!lastedge)
    do !c indices !lastedge
      !index.append(!this.vertex.size())
    enddo
  endif
  !edges.compress()

  !startIndx = !index.findfirst(!from)
  !endIndx = !index.find(!to).last()
  handle ANY
    !endIndx = !index.find(!to - 1).last()
      handle ANY
        !endIndx = !index.find(!to - 2).last()
      endhandle
  endhandle
  if !endIndx.lt(!startIndx) then
    !maxIndex = !index.maxIndex()
    !minIndex = !index.minIndex()
    do !c from !startIndx to !maxIndex
      !result[1].append(!edges[!c])
      !result[2].append(!index[!c])
    enddo

    do !c from !minIndex to !endIndx
      !result[1].append(!edges[!c])
      !result[2].append(!index[!c])
    enddo
  else
    do !c from !startIndx to !endIndx
      !result[1].append(!edges[!c])
      !result[2].append(!index[!c])
    enddo
  endif

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      edges
--
-- Description: get all edges of the object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Close flag
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of LINEs and ARCs
--
------------------------------------------------------------------------

define method .edges(!closeFlag is BOOLEAN) is ARRAY

  !from = 1
  !to = !this.vertex.size()

  !edges = !this.edges(!from,!to,!closeFlag)

  return !edges[1]

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      profile
--
-- Description: convert object to PROFILE object with default orientation and position
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Close flag
-- Return:
--   [Data Type] [Description]
--    PROFILE     profile - first vertex is used for position
------------------------------------------------------------------------

define method .profile(!closeFlag is BOOLEAN) is PROFILE

  !ori = object ORIENTATION('Z is ' & !this.zdir)
  !pos = !this.vertex[1]

  !profile = !this.profile(!closeFlag,!pos,!ori)

  return !profile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      profile
--
-- Description: convert object to PROFILE object with explicit orientation and position
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Close flag
--    2   R      POSITION    profile position
--    3   R      ORIENTATION profile orientation
-- Return:
--   [Data Type] [Description]
--    PROFILE     profile
------------------------------------------------------------------------

define method .profile(!closeFlag is BOOLEAN,!pos is POSITION,!ori is ORIENTATION) is PROFILE

  !profile = object PROFILE(!pos,!ori,!this.edges(!closeFlag))

  return !profile

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: return ASLRPATH object moved by given distance in given direction
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   Moving direction
--    2   R      REAL        Moving distance
--
-- Return:
--   [Data Type] [Description]
--    ASLRPATH    Offset object
--
------------------------------------------------------------------------

define method .offset(!dir is DIRECTION, !dist is REAL) is ASLRPATH

  -- copy this object
  !rpath = !this
  !rpath.removedRef.clear()

  do !c indices !rpath.vertex
    !rpath.vertex[!c] = !rpath.vertex[!c].offset(!dir, !dist)
    !rpath.sigref[!c] = nulref
    !rpath.refe[!c] = nulref
    if !rpath.type[!c].eq('CURVE') then
      do !cc indices !rpath.detail[!c]
        if !rpath.detail[!c][!cc].objectType().eq('POSITION') then
          !rpath.detail[!c][!cc] = !rpath.detail[!c][!cc].offset(!dir, !dist)
        endif
      enddo
    endif
  enddo

  return !rpath

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      merge
--
-- Description: merge two ASLRPATH objects
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLRPATH    Object to be merged
-- Return:
--   [Data Type] [Description]
--    ASLRPATH    Merged object
--
------------------------------------------------------------------------

define method .merge(!rpath is ASLRPATH) is ASLRPATH

  -- init
  !result = !this
  !vertex = !rpath.vertex
  !type   = !rpath.type
  !detail = !rpath.detail
  !sigref = !rpath.sigref
  !refe   = !rpath.refe

  -- find the nearest end of path to be merged
  !dist[1] = !result.vertex.last().distance(!rpath.vertex.first())
  !dist[2] = !result.vertex.last().distance(!rpath.vertex.last())
  !dist[3] = !result.vertex.first().distance(!rpath.vertex.last())
  !dist[4] = !result.vertex.first().distance(!rpath.vertex.first())

  !nearest = !dist.sortedIndices()[1]
  if !nearest.eq(2).or(!nearest.eq(4)) then
    !vertex.invert()
    !type.invert()
    !detail.invert()
    !sigref.invert()
    !refe.invert()
  endif

  if !nearest.leq(2) then
    if !result.vertex.last().near(!vertex.first(),1mm) then
      !vertex.remove(1)
      !type.remove(1)
      !detail.remove(1)
      !sigref.remove(1)
      !refe.remove(1)
    endif
    !result.vertex.appendarray(!vertex)
    !result.type.appendarray(!type)
    !result.detail.appendarray(!detail)
    !result.sigref.appendarray(!sigref)
    !result.refe.appendarray(!refe)
  else
    if !result.vertex.first().near(!vertex.last(),1mm) then
      !vertex.removeLast()
      !type.removeLast()
      !detail.removeLast()
      !sigref.removeLast()
      !refe.removeLast()
    endif
    !result.vertex.insertarray(1,!vertex)
    !result.type.insertarray(1,!type)
    !result.detail.insertarray(1,!detail)
    !result.sigref.insertarray(1,!sigref)
    !result.refe.insertarray(1,!refe)
  endif

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      split
--
-- Description: split ASLRPATH objects
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position on split - must be on the edge!
--    2   R      BOOLEAN     closeFlag
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       ASLRPATH objects
--
------------------------------------------------------------------------

define method .split(!splitpos is POSITION, !closeFlag is BOOLEAN, !gapWidth is REAL) is ARRAY

  -- init
  !result = ARRAY()
  !newindex = ARRAY()
  !path1 = !this
  !path2 = !this
  !path1.removedRef.clear()
  !path2.removedRef.clear()

  -- get proper segment of rpath and starting vertex index
  !edgearray = !this.near(!splitpos,!closeFlag)
  !edge = !edgearray.first()
  !index = !edgearray.minIndex()

  -- get direction from start to end of the gap
  !gapDir = !edge.direction()
  -- get start/end of the gap
  !gapStart = !splitpos.offset(!gapDir.opposite(),!gapWidth * 0.5)
  !gapEnd = !gapStart.offset(!gapDir,!gapWidth)

  if !closeFlag then
  -- do not split rpath - just re-arrange vertices so that open side will be on split
    if !index.neq(!this.size()) then
      do !c from (!index + 1) to !this.size()
        !newindex.append(!c)
      enddo
      do !c from 1 to !index
        !newindex.append(!c)
      enddo
      !path1.vertex.reindex(!newindex)
      !path1.type.reindex(!newindex)
      !path1.detail.reindex(!newindex)
      !path1.sigref.reindex(!newindex)
      !path1.refe.reindex(!newindex)
    endif
    -- add vertices at both ends of the gap
    !path1.insertVertex('POINTR',!path1.size(),!gapStart,0,nulref)
    !path1.insertVertex('POINTR',0,!gapEnd,0,nulref)
    !result[1] = !path1
  else
  -- split rpath
    !path2.vertex = !path1.vertex.deleteFrom(!index + 1)
    !path2.type = !path1.type.deleteFrom(!index + 1)
    !path2.detail = !path1.detail.deleteFrom(!index + 1)
    !path2.sigref = !path1.sigref.deleteFrom(!index + 1)
    !path2.refe   = !path1.refe.deleteFrom(!index + 1)
    !path2.insertVertex('POINTR',0,!gapEnd,0,nulref)
    !path1.insertVertex('POINTR',!path1.size(),!gapStart,0,nulref)
    !result[1] = !path1
    !result[2] = !path2
  endif


  -- merge inline vertices
  do !c indices !result
    !result[!c].mergeVertices(1,!result[!c].size())
  enddo

  return !result

endmethod
-- End of method



------------------------------------------------------------------------
--
-- Method:      vertex2Edge
--
-- Description: convert vertex to the edge (LINE, ARC) leading to it from previous
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Vertex index
-- Return:
--   [Data Type] [Description]
--    ARRAY       previous edge of vertex
------------------------------------------------------------------------

define method .vertex2Edge(!index is REAL,!prev is POSITION) is ARRAY

  !edge = ARRAY()

  !vertex = !this.vertex[!index]
  !type = !this.type[!index]
  !detail = !this.detail[!index]

  if !index.eq(!this.vertex.size()) then
     !next = !this.vertex.first()
     !nexttype = !this.type.first()
  else
     !next = !this.vertex[!index + 1]
     !nexttype = !this.type[!index + 1]
  endif

  if !index.eq(1) then
    !prevtype = !this.type.last()
    !prevVertex = !this.vertex.last()
  else
    !prevVertex = !this.vertex[!index - 1]
    !prevtype = !this.type[!index - 1]
  endif

  if !type.eq('CURVE') then
    !attr = !this.detail[!index]
    !attr.append(!this.vertex[!index])
    !edge = !this.curve2edge(!attr,!prev,!next)
  elseif !type.eq('POINTR') then
    -- empty array is returned if previous point type is CURVE
    if !prevtype.eq('CURVE') then
      return !edge
    endif
    -- ignore radius if next point type is CURVE
    if !nexttype.eq('CURVE') then
      !radius = 0
    else
      !radius = !detail
    endif

    if !radius.boolean() then
      !zdir = !prev.plane(!vertex,!next).direction()
      handle ANY
      endhandle
      !edge[2] = !vertex.arcFillet(!prevVertex, !next, !zdir, !radius.abs())
      handle NONE
        if !radius.lt(0) then
          !arcstart = !edge[2].anglePosition(!edge[2].startangle)
          !arcend   = !edge[2].anglePosition(!edge[2].endangle)
          !edge[2] = !vertex.arc(!arcstart,!arcend)
          !edge[2] = !edge[2].startposition(!arcstart).endposition(!arcend)
        endif
        !vertex = !edge[2].anglePosition(!edge[2].startangle)
      elsehandle ANY
      endhandle
    endif
    !edge[1] = object LINE(!prev,!vertex)
  endif

  return !edge

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      segmentLength
--
-- Description: return length of segment of passed index
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
--    2   R      BOOLEAN     closeflag
--
-- Return:
--   [Data Type] [Description]
--    REAL        segment length
--
------------------------------------------------------------------------

define method .segmentLength(!index is REAL) is REAL

  -- IMPORTANT NOTE:
  -- the method .segment(boolean) must be run before this method is run

  -- init
  !length = 0
  !segment = !this.segment[!index]

  do !part values !segment
    !length = !length + !part.length()
    handle ANY
      skip
    endhandle
  enddo

  return !length

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSegmentEnd
--
-- Description: get endpoint of either LINE or ARC
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         LINE or ARC object
--    2   R      STRING      START or END keyword
-- Return:
--   [Data Type]     [Description]
--    POINTVECTOR    Start/end point of LINE or ARC
--
------------------------------------------------------------------------

define method .getSegmentEnd(!edge is ANY, !start is STRING) is POINTVECTOR

  if !edge.objectType().eq('LINE') then
    !pos = !edge.$!<start>position
    if !start.lowcase().eq('start') then
      !dir = !edge.direction().opposite()
    else
      !dir = !edge.direction()
    endif
  elseif !edge.objectType().eq('ARC') then
    !pos = !edge.anglePosition(!edge.$!<start>angle)
    !dir = !edge.$!<start>tangent()
  elseif !edge.objectType().eq('POSITION') then
    !pos = !edge
    !dir = !this.zdir
  endif

  !result = object POINTVECTOR(!pos,!dir)

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      edge2vertex
--
-- Description: convert edge (line or arc) to vertex
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of edges - lines and arcs
--    2   R      REAL        edge index
-- Return:
--   [Data Type]     [Description]
--    ARRAY           vertex description - [1] POSITION - vertex position
--                                         [2] STRING - vertex type
--                                         [3] ANY vertex details - depends on type
--
------------------------------------------------------------------------

define method .edge2Vertex(!profile is ARRAY, !index is REAL) is ARRAY

  !vertex = ARRAY()
  !edge = !profile[!index]
  -- maximum radius to interpreted as fillet - it should be obtained from elsewhere
  !maxRadius = 500mm

  !fillet = !this.isFillet(!profile,!index,!maxRadius)

  !nextIsFillet = !this.isFillet(!profile, !index + 1,!maxRadius)
  handle ANY
    !nextIsFillet = FALSE
  endhandle

  !dataType = !edge.objectType()

  if !dataType.eq('ARC') then
  -- handle ARCs
    if !fillet then
    -- output as vertex with radius
      !pos = !edge.pole()
      !type = 'POINTR'
      !detail = !edge.radius
    else
    -- if ARC is not a fillet then output as curve of type THRU
      if !edge.sense then
        !pos = !edge.anglePosition(!edge.proportion(0.5))
      else
        !pos = !edge.anglePosition(!edge.proportion(-0.5))
      endif
      !type = 'CURVE'
      !detail[1] = 'THRU'
      -- the rest is not relevant
      !detail[2] = 0
      !detail[3] = e0 n0 u0
      !detail[4] = 0
      !detail[5] = true
      !nextpos = !this.getSegmentEnd(!edge,'end').position
      !nexttype = 'POINTR'
      !nextdetail = 0
      !prevEdge = !profile[!index - 1]
        handle ANY
          !prevEdge = !profile.last()
        endhandle
      !startpos = !this.getSegmentEnd(!edge,'start').position
      if !startpos.distance(!this.getSegmentEnd(!prevEdge,'end').position).gt(0) then
      -- add another vertex if there is a gap between arc start position and last position
        !prevpos = !startpos
        !prevtype = 'POINTR'
        !prevdetail = 0
      endif
    endif
  elseif !dataType.eq('LINE') then
    if !nextIsFillet.not() then
        !pos = !edge.endposition
        !type = 'POINTR'
        !detail = 0
    endif
  elseif !dataType.eq('POSITION') then
    !ok = true
    if !index.gt(1) then
      !prevEdge = !profile[!index - 1]
      !ok = true
      if !this.getSegmentEnd(!prevEdge,'end').position.distance(!edge).lt(25mm) then
      -- ignore position if too close to endposition of previous edge - current tolerance is fixed to 25mm (1inch)
        !ok = FALSE
      endif
    endif
    if !ok then
      !pos = !edge
      !type = 'POINTR'
      !detail = 0
    endif
  endif

  if defined(!prevpos) then
    !vertex[1] = !prevpos
    !vertex[2] = !prevtype
    !vertex[3] = !prevdetail
  endif
  if defined(!pos) then
    !vertex.append(!pos)
    !vertex.append(!type)
    !vertex.append(!detail)
  endif
  if defined(!nextpos) then
    !vertex.append(!nextpos)
    !vertex.append(!nexttype)
    !vertex.append(!nextdetail)
  endif

  return !vertex

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      endOfCurve
--
-- Description: return true if POINTR is at the start/end of curved segment
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .endOfCurve(!index is REAL) is BOOLEAN

  !next = !index + 1
  if !next.gt(!this.vertex.maxIndex()) then
    !next = 1
  endif

  if !this.type[!next].eq('CURVE') then
    return true
  endif

  !prev = !index - 1
  if !prev.eq(0) then
    !prev = !this.vertex.maxIndex()
  endif

  if !this.type[!prev].eq('CURVE') then
    return true
  endif

  return FALSE

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      endOfCurve
--
-- Description: return true if POINTR is at the passed end of curved segment
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--    2   R      STRING      which end to be checked (start or end)
--
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .endOfCurve(!index is REAL,!whichEnd is STRING) is BOOLEAN

  if !whichEnd.eq('start') then
    !next = !index + 1
    if !next.gt(!this.vertex.maxIndex()) then
      !next = 1
    endif
  elseif !whichEnd.eq('end') then
    !next = !index - 1
    if !next.eq(0) then
      !next = !this.vertex.maxIndex()
    endif
  endif

  if !this.type[!next].eq('CURVE') then
    return true
  endif

  return FALSE

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      nextPointOf
--
-- Description: return next POINTR vertex of passed index (jumps over CURVEs)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        index of vertex
--
-- Return:
--   [Data Type] [Description]
--    REAL        next vertex
--
------------------------------------------------------------------------

define method .nextPointOf(!index is REAL) is REAL

  if !index.eq(!this.vertex.maxIndex()) then
    !next = 1
  else
    !next = !index + 1
  endif

  if !this.type[!next].eq('CURVE') then
    !next = !next + 1
  endif

  return !next

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      prevPointOf
--
-- Description: return previous POINTR vertex of passed index (jumps over CURVEs)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        index of vertex
--
-- Return:
--   [Data Type] [Description]
--    REAL        previous vertex
--
------------------------------------------------------------------------

define method .prevPointOf(!index is REAL) is REAL

  if !index.eq(1) then
    !prev = !this.vertex.maxIndex()
  else
    !prev = !index - 1
  endif

  if !this.type[!prev].eq('CURVE') then
    !prev = !prev - 1
  endif

  return !prev

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      segment
--
-- Description: calculate rpath segments and store them temporarily not to be calculate each time they are needed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     close flag
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .segment(!closeFlag is BOOLEAN)

  -- init
  !segment = ARRAY()
  !edges = ARRAY()
  if !this.set() then
    !edges = !this.edges(1,!this.vertex.size(),!closeFlag)
  endif

  do !c indices !this.vertex
    break if !edges.unset()
    !edge = ARRAY()
    !indx = !edges[2].find(!c)
    if !indx.set() then
      !edge = !edges[1].from(!indx[1],!indx.size())
      do !cc indices !edge
        if !edge[!cc].objectType().eq('ARC') then
          if !c.eq(!this.vertex.size()) then
            !isFillet = !this.isFillet(1,!closeFlag)
          else
            !isFillet = !this.isFillet(!c + 1,!closeFlag)
          endif
          if !isFillet then
            !edge[!cc].delete()
          endif
        endif
      enddo
      !edge.compress()
    endif
    !segment.append(!edge)
  enddo
  !this.segment = !segment

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      curve2edge
--
-- Description: map CURVE element to arc and/or line(s)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         DBREF or array holding CURVE attributes
--    2   R      POSITION    previous vertex
--    3   R      POSITION    next vertex
--
-- Return:
--   [Data Type]     [Description]
--    ARRAY          array with ARC and/or LINEs
--
------------------------------------------------------------------------

define method .curve2edge(!curve is ANY,!prev is POSITION,!next is POSITION) is ARRAY

  if !curve.objectType().eq('DBREF') then
    !attr = !this.getCurveAtt(!curve)
    !attr.append(!curve.pos)
  else
    !attr = !curve
  endif

  !edge = ARRAY()
  !curtyp = !attr[1]
  !bulgef = !attr[2]
  !cpos   = !attr[3]
  !radi   = !attr[4]
  !pos    = !attr[6]

  !zdir = !this.zdir
  !line = object LINE(!prev,!next)
  !localPlaneOri = object ORIENTATION('Y is ' & !line.direction() & ' and Z is ' & !zdir)
  !plane = object PLANE(!line.startposition,!localPlaneOri)

  if !curtyp.eq('LINE') then

    !edge[1] = !line

  elseif !curtyp.eq('THRU') then

    if !line.on(!pos) then
      !edge[1] = !line
    else
    !zdir = !prev.plane(!pos,!next).direction()
    !edge[1] = !prev.arcThru(!pos, !next, !zdir)
      if !edge[1].on(!pos).not() then
        !edge[1].sense = !edge[1].sense.not()
      endif
    endif

  elseif !curtyp.eq('RADI') then

    !isInside = !plane.xyOffset(!cpos).x.lt(0)
    !zdir = !prev.plane(!cpos,!next).direction()
    handle ANY
      !zdir = !this.zdir
    endhandle
    !edge[1] = !prev.arcRadius(!next,!cpos,!zdir,!radi,!isInside)

  elseif !curtyp.eq('BULG') then

    if !radi.eq(0) then
      !edge[1] = !line
    else
      !minorMajor = !bulgef.abs().geq(1)
      !zdir = !prev.plane(!cpos,!next).direction()
      if !bulgef.lt(0) then
      -- transform cpos
        !movedir = !cpos.direction(!line.startposition)
        !movedist = !cpos.distance(!line.startposition)
        !cpos = !cpos.offset(!movedir,!movedist * 2)
      endif
      !edge[1] = !prev.arcRadius(!next,!cpos,!zdir,!radi,!minorMajor)
    endif

  elseif !curtyp.eq('FILL') then

    if !line.on(!pos) then
      !edge[1] = !line
    else
      !zdir = !prev.plane(!pos,!next).direction()
      !arc = !pos.arcFillet(!prev,!next,!zdir,!radi)
      !arcstart = !arc.anglePosition(!arc.startangle)
      !arcend = !arc.anglePosition(!arc.endangle)
      if !prev.neq(!arcstart) then
        !edge[1] = object LINE(!prev,!arcstart)
      endif
      !edge.append(!arc)
      if !next.neq(!arcend) then
         !edge.append(object LINE(!arcend,!next))
      endif
    endif

  elseif !curtyp.eq('CENT') then

    !zdir = !prev.plane(!pos,!next).direction()
    handle ANY
      !zdir = !prev.plane(!cpos,!next).direction()
    endhandle

    !arc = object ARC(!pos, Z is $!zdir , 0, 360, !radi, true)
    if !arc.radius.eq(0) then
    --straight line only (RADI =0)
      !arc.delete()
      !line1 = !line
    elseif !arc.on(!prev).and(!arc.on(!next)) then
    -- arc only
      !plane.position = !pos
      !awaydir = !plane.orientation.xdir()
      if !plane.xyOffset(!cpos).x.lt(0) then
        !awaydir = !awaydir.opposite()
      endif
      !thrpos = !pos.offset(!awaydir, !radi)
      !arc = !prev.arcThru(!thrpos,!next,!zdir,!radi)
      handle ANY
        !arc = !prev.arcThru(!thrpos,!next,!zdir)
      endhandle
      if !arc.on(!thrpos).not() then
        !arc.sense = !arc.sense.not()
      endif

    elseif !arc.on(!prev).and(!arc.onProjected(!next)).or(!arc.on(!next).and(!arc.onProjected(!prev))) then
      if !arc.intersections(!line).size().eq(1) then
      -- straight line only
        !arc.delete()
        !line1 = !line
      else
      -- arc + one line only
        !plane.position = !pos
        !insideArc = !plane.xyOffset(!cpos).x.lt(0)
        if !insideArc then
        -- straight line only
          !arc.delete()
          !line1 = !line
        else
          if !arc.on(!prev) then
            !tangs = !arc.tangents(!next)
            !tmpLine1 = object LINE(!arc.anglePosition(!tangs[1]),!next)
            !tmpLine2 = object LINE(!arc.anglePosition(!tangs[2]),!next)
            if !tmpLine1.startposition.distance(!prev).gt(!tmpLine2.startposition.distance(!prev)) then
              !line2 = !tmpLine1
            else
              !line2 = !tmpLine2
            endif
            !midpos = !prev.midpoint(!line2.startposition)
            !thrpos = !pos.offset(!midpos.direction(!pos),!radi)
            !arc = !prev.arcThru(!thrpos,!line2.startposition,!zdir)
            if !arc.on(!thrpos).not() then
              !arc.sense = !arc.sense.not()
            endif
          else
            !tangs = !arc.tangents(!prev)
            !tmpLine1 = object LINE(!prev,!arc.anglePosition(!tangs[1]))
            !tmpLine2 = object LINE(!prev,!arc.anglePosition(!tangs[2]))
            if !tmpLine1.endposition.distance(!next).gt(!tmpLine2.endposition.distance(!next)) then
              !line1 = !tmpLine1
            else
              !line2 = !tmpLine2
            endif
            !midpos = !next.midpoint(!line1.endposition)
            !thrpos = !pos.offset(!midpos.direction(!pos),!radi)
            !arc = !line1.endposition.arcThru(!thrpos,!next,!zdir)
            if !arc.on(!thrpos).not() then
              !arc.sense = !arc.sense.not()
            endif
          endif
        endif
      endif
    elseif !arc.onProjected(!next).and(!arc.onProjected(!prev)) then
    -- other configurations
      if !arc.intersections(!line).size().eq(1) then
      -- straight line only
        !arc.delete()
        !line1 = !line
      elseif !arc.intersections(!line).size().eq(0) then
      -- circle does not touch or intersect line between prev and vertex
        !plane.position = !pos
        !awaydir = !line.proportion(0.5).direction(!pos)
        !thrpos = !pos.offset(!awaydir, !radi)
        !arc = !prev.arcThru(!thrpos,!next,!zdir,!radi)
        handle ANY
          !arc = !prev.arcThru(!thrpos,!next,!zdir)
        endhandle
        if !arc.on(!thrpos).not() then
          !arc.sense = !arc.sense.not()
        endif
        !line1 = object LINE(!prev,!arc.anglePosition(!arc.startangle))
        !line2 = object LINE(!arc.anglePosition(!arc.endangle),!next)
      else
      -- circle intersects the line between prev and next vertex
        !plane.position = !pos
        !awaydir = !line.proportion(0.5).direction(!pos)
        if !plane.xyOffset(!cpos).x.lt(0) then
          !awaydir = !awaydir.opposite()
        endif
        !thrpos = !pos.offset(!awaydir, !radi)
        !arc = !prev.arcThru(!thrpos,!next,!zdir,!radi)
        handle ANY
          !arc = !prev.arcThru(!thrpos,!next,!zdir)
        endhandle
        !line1 = object LINE(!prev,!arc.anglePosition(!arc.startangle))
        !line2 = object LINE(!arc.anglePosition(!arc.endangle),!next)
      endif
    endif

    if defined(!line1) then
      !edge.append(!line1)
    endif
    if defined(!arc) then
      !edge.append(!arc)
    endif
    if defined(!line2) then
      !edge.append(!line2)
    endif

  endif

  return !edge

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      getcurveatt
--
-- Description: returns CURVE attributes as array
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       CURVE element
--
-- Return:
--   [Data Type]     [Description]
--    ARRAY          array of CURVE attributes
--
------------------------------------------------------------------------

define method .getCurveAtt(!curve is DBREF) is ARRAY

    !attr[1] = !curve.curtyp
    !attr[2] = !curve.bulgef
    !attr[3] = !curve.cpos.wrt(world)
    !attr[4] = !curve.uradi
    !attr[5] = !curve.radsetflag

    return !attr

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      isFillet
--
-- Description: is the given edge a fillet
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of edges
--    2   R      REAL        number of edge
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if fillet
------------------------------------------------------------------------

define method .isFillet(!edges is ARRAY,!index is REAL) is BOOLEAN

  !result = FALSE

  !edge = !edges[!index]

  if !edge.objectType().eq('ARC') then
    !prev = !edges[!index - 1]
    handle ANY
      !prev = !edges.last()
    endhandle
    !next = !edges[!index + 1]
    handle ANY
      !next = !edges.first()
    endhandle
    if !edge.angle().lt(180) then
      !fillet[1] = !prev
      !fillet[2] = !edge
      !fillet[3] = !next
      !prfl = object PROFILE(!edge.position,!edge.orientation ,!fillet)
      !result = !prfl.isFillet(2)
    endif
  endif

  return !result

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      isFillet
--
-- Description: is the given edge a fillet - arc radius must be less then specified
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of edges
--    2   R      REAL        number of edge
--    3   R      REAL        limit radius
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if fillet
------------------------------------------------------------------------

define method .isFillet(!edges is ARRAY,!index is REAL,!radius is REAL) is BOOLEAN

  !result = FALSE

  !edge = !edges[!index]

  if !edge.objectType().eq('ARC') then
    !prev = !edges[!index - 1]
    handle ANY
      !prev = !edges.last()
    endhandle
    !next = !edges[!index + 1]
    handle ANY
      !next = !edges.first()
    endhandle
    if !edge.angle().lt(180) then
      !fillet[1] = !prev
      !fillet[2] = !edge
      !fillet[3] = !next
      !prfl = object PROFILE(!edge.position,!edge.orientation ,!fillet)
      !result = !prfl.isFillet(2)
    endif
    !result = !result.and(!edge.radius.lt(!radius))
  endif

  return !result

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      isFillet
--
-- Description: is the given vertex a fillet
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        vertex index
--    2   R      BOOLEAN     closeFlag
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if fillet
------------------------------------------------------------------------

define method .isFillet(!index is REAL,!closeFlag is BOOLEAN) is BOOLEAN

  !result = FALSE

  if !this.type[!index].eq('POINTR') then
    !last = !this.type.size()
    !isFirst = !index.eq(1)
    !isLast = !index.eq(!last)
    !isOpen = !closeFlag.not()
    !isClosed = !closeFlag
    !type = !this.type[!index]
    !pos = !this.vertex[!index]

    -- first and last vertex is never fillet when shape is not closed
    if !isLast.or(!isFirst).and(!isOpen) then
      return !result
    endif

    !nextIndex = !index + 1
    !prevIndex = !index - 1
    if !isFirst then
      !prevIndex = !last
    elseif !isLast then
      !nextIndex = 1
    endif

    !nexttype = !this.type[!nextIndex]
    !nextpos = !this.vertex[!nextIndex]
    !prevtype = !this.type[!prevIndex]
    !prevpos = !this.vertex[!prevIndex]
    if !prevtype.eq('CURVE').or(!nexttype.eq('CURVE')) then
    -- no fillet on start or end of curve
      return !result
    elseif !prevtype.eq('POINTR').and(!pos.eq(!prevpos)) then
    -- no fillet if coincident with previous POINTR
      return !result
    elseif !nexttype.eq('POINTR').and(!pos.eq(!nextpos)) then
    -- no fillet if coincident with next POINTR
      return !result
    endif

    -- is it a fillet
    !result = !this.detail[!index].boolean()

  endif

  return !result

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      isClosed
--
-- Description: return true if object is a valid shape (PROFILE) that can be closed
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .isClosed() is BOOLEAN

  -- convert object to closed PROFILE
  !shape = !this.profile(true)
  handle ANY
    return FALSE
  endhandle

  -- check if it is valid
  !isClosed = !shape.isValidClosed().and(!shape.area().gt(0))

  return !isClosed

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      arcLength
--
-- Description: return new arc with passed length based on passed arc maintaining the start position
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC         old arc
--    2   R      REAL        new length
--
-- Return:
--   [Data Type] [Description]
--    ARC         new arc
--
------------------------------------------------------------------------

define method .arcLength(!oldArc is ARC, !newLength is REAL) is ARC

  -- init
  !newArc = object ARC()
  if !oldArc.sense then
    !sense = 1
  else
    !sense = -1
  endif

  -- compute
  !angle = !oldArc.proportion(!newLength / !oldArc.length() * !sense)
  !endpos = !oldArc.anglePosition(!angle)
  !newArc = !oldArc.endposition(!endpos)

  return !newArc

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      anyCurve2Thru
--
-- Description: convert curve of any type to type THRU
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Curve definition (array OR dbref)
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of points in usual format (vertex, type, detail, sigref, ref)
--
------------------------------------------------------------------------

define method .anyCurve2Thru(!curve is ANY,!prev is POSITION,!next is POSITION) is ARRAY

  -- init
  !points = ARRAY()
  !vertex = ARRAY()
  !type = ARRAY()
  !detail = ARRAY()
  !sigref = ARRAY()
  !refe   = ARRAY()

  -- check argument object type
  if !curve.objectType().eq('DBREF') then
    !refno = !curve
    !curAtt = !this.getCurveAtt(!curve)
    !curAtt.append(!curve.pos)
  else
    !refno = nulref
    !curAtt = !curve
  endif

  -- exit if curve is THRU already
  if !curAtt[1].eq('THRU') then
    !vertex[1] = !curAtt[6]
    !type[1] = 'CURVE'
    !detail[1] = !curAtt
    !sigref[1] = nulref
    !refe[1] = !refno
  else
    !path = !this.curve2edge(!curve,!prev,!next)
    do !c indices !path
      if !path[!c].objectType().eq('ARC') then
        if !path[!c].sense then
          !pos = !path[!c].anglePosition(!path[!c].proportion(0.5))
        else
          !pos = !path[!c].anglePosition(!path[!c].proportion(-0.5))
        endif
        !data[1] = 'THRU'
        -- the rest is not relevant
        !data[2] = 0
        !data[3] = e0 n0 u0
        !data[4] = 0
        !data[5] = true
        !vertex.append(!pos)
        !type.append('CURVE')
        !detail.append(!data)
        !sigref.append(!refno)
        !refe.append(!refno)
      else
        if !c.eq(1) then
          !pos = !path[!c].endposition.wrt(world)
        else
          !pos = !path[!c].startposition.wrt(world)
        endif
        !vertex.append(!pos)
        !type.append('POINTR')
        !detail.append(0)
        !sigref.append(nulref)
        !refe.append(nulref)
      endif
    enddo
  endif

  !points[1] = !vertex
  !points[2] = !type
  !points[3] = !detail
  !points[4] = !sigref
  !points[5] = !refe

  return !points

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeVertex
--
-- Description: remove vertex of passed index
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        index of vertex
-- Return:
--   [Data Type] [Description]
--    ARRAY       two parallel arrays with old and new vertex indices
--
------------------------------------------------------------------------

define method .removeVertex(!index is REAL) is ARRAY

  -- init
  !indices = ARRAY()
  !oldindices = !this.vertex.indices().from(!index + 1)

  -- remove vertex
  !this.vertex.remove(!index)
  !this.type.remove(!index)
  !this.detail.remove(!index)
  !this.sigref.remove(!index)
  !remRef = !this.refe.remove(!index)
  if !remRef.set() then
    !this.removedRef.append(!remRef)
  endif

  -- get new indices
  !newindices = !this.vertex.indices().from(!index)

  -- compose result and return it
  !indices[1] = !oldindices
  !indices[2] = !newindices

  return !indices

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      insertvertex
--
-- Description: insert new vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of vertex
--    2   R      REAL        index of previous vertex
--    3   R      ANY         vertex details - array or real
--    4   R      DBREF       reference to POINTR in another path
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       two parallel arrays with old and new vertex indices
--
------------------------------------------------------------------------

define method .insertVertex(!type is STRING,!index is REAL,!pos is POSITION,!detail is ANY,!sigref is DBREF) is ARRAY

  -- init
  !indices = ARRAY()
  !newindex = !index + 1
  !oldindices = !this.vertex.indices().from(!newindex)

  -- insert new value into all arrays
  !this.vertex.insert(!newindex,!pos.wrt(world))
  !this.type.insert(!newindex,!type)
  !this.detail.insert(!newindex,!detail)
  !this.sigref.insert(!newindex,!sigref)
  !this.refe.insert(!newindex,!this.getRemovedRef())

  -- get new indices
  !newindices = !this.vertex.indices().from(!newindex + 1)

  -- compose result and return it
  !indices[1] = !oldindices
  !indices[2] = !newindices

  return !indices

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      mergeVertices
--
-- Description: remove redundant vertices that are on the edge (i.e. not corner making)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        index of start vertex
--    2   R      REAL        index of end vertex
-- Return:
--   [Data Type] [Description]
--    ARRAY       index array of removed vertices
--
------------------------------------------------------------------------
define method .mergeVertices(!fromVertex is REAL,!toVertex is REAL) is ARRAY

  -- init
  !vertex = !this.vertex
  !type = !this.type

  -- find out the redundant vertices and remove them
  !removed = ARRAY()
  do !c from !fromVertex to !toVertex
    skip if !c.eq(!fromVertex)
    skip if !c.eq(!toVertex)
    skip if !type[!c - 1].neq('POINTR')
    skip if !type[!c].neq('POINTR')
    skip if !type[!c + 1].neq('POINTR')
    !fromto = object LINE(!vertex[!c - 1],!vertex[!c + 1])
    !pos = !vertex[!c]
    !projpos = !fromto.near(!pos)
    skip if !fromto.onProjected(!projpos).not()
    if !pos.distance(!projpos).leq(1mm) then
      !removed.append(!c)
    endif
  enddo

  -- loop through indices to be removed in reverse order
  do !c values !removed.invert()
    !this.removeVertex(!c)
  enddo

  return !removed.invert()

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      getRemovedRef
--
-- Description: remove first item from removedRef array and return it. Nulref is returned if array is empty
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       dbref.
--
------------------------------------------------------------------------

define method .getRemovedRef() is DBREF

  !refno = nulref
  if !this.removedRef.set() then
    !refno = !this.removedRef.removeFirst()
  endif

  return !refno

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      edgeOf
--
-- Description: edge associated with vertex
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        index of vertex
-- Return:
--   [Data Type] [Description]
--    ANY         Associate vertex - LINE or ARC
------------------------------------------------------------------------

define method .edgeOf(!vertex is REAL,!closeFlag is BOOLEAN) is ARRAY

   !edge = ARRAY()

   -- get edges associated with vertex
   !edge = !this.edges(!vertex,!vertex,!closeFlag)[1]
   handle ANY
   endhandle

   -- remove filleting arc
   do !c indices !edge
     if !edge[!c].objectType().eq('ARC') then
       if !vertex.eq(!this.vertex.size()) then
         !isFillet = !this.isFillet(1,!closeFlag)
       else
         !isFillet = !this.isFillet(!vertex + 1,!closeFlag)
       endif
       if !isFillet then
         !edge[!c].delete()
       endif
     endif
   enddo

   !edge.compress()

   return !edge

endmethod
-- end of method


------------------------------------------------------------------------
--
-- Method:      near
--
-- Description: returns the nearest edge to given position
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position to snap
-- Return:
--   [Data Type] [Description]
--    ARRAY       nearest edge LINE - array with only one element where index is starting vertex number
--
------------------------------------------------------------------------

define method .near(!pos is POSITION,!closeFlag is BOOLEAN) is ARRAY

  -- init
  !result = ARRAY()
  !linearEdges = ARRAY()
  !dist = ARRAY()
  !tmpEdges = ARRAY()

  -- update segment array
  !this.segment(!closeFlag)

  -- avoid all non-linear edges
  do !c indices !this.vertex
    -- ignore curves
    skip if !this.type[!c].eq('CURVE')
    -- get edge(s) for this vertex
    !edges = !this.segment[!c]
    skip if !edges.unset()

    -- ignore complex curves (ARC & LINE(s) )
    skip if !edges.size().gt(1)
    -- ignore if edge is ARC
    skip if !edges[1].objectType().eq('ARC')
    !tmpEdges[!c] = !edges[1]
  enddo

  do !c indices !tmpEdges
    -- ignore edges that are invalid
    skip if !tmpEdges[!c].onProjected(!pos).not()
    !dist[!c] = !tmpEdges[!c].distance(!pos)
    !linearEdges[!c] = !tmpEdges[!c]
  enddo

  if !dist.set() then
    !newindex = !dist.sortedIndices()
    !first = !newindex[1]
    !result[!first] = !linearEdges[!first]
  endif

  return !result

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      snap2edge
--
-- Description: project passed position to edge of rpath
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position to be snapped to edge
--    2   R      BOOLEAN     close flag
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       one member position array with index pointing to the associated vertex
--
------------------------------------------------------------------------

define method .snap2edge(!snap is POSITION, !closeFlag is BOOLEAN) is ARRAY

  -- init
  !result = ARRAY()
  !dist = ARRAY()
  !pos  = ARRAY()

  -- update segment array
  !this.segment(!closeFlag)

  -- measure and store distance from all segments
  do !c indices !this.vertex
    -- get edge(s) for this vertex
    !edges = !this.segment[!c]
    skip if !edges.unset()

    !tmpdist = ARRAY()
    !tmppos = ARRAY()
    do !cc indices !edges
      if !edges[!cc].objectType().eq('LINE') then
        !tmppos[!cc] = !edges[!cc].near(!snap)
      else
        !angle = !edges[!cc].near(!snap)
        !tmppos[!cc] = !edges[!cc].anglePosition(!angle)
      endif
      -- ignore edges that are invalid
      skip if !edges[!cc].onProjected(!tmppos[!cc]).not()
      !tmpdist[!cc] = !snap.distance(!tmppos[!cc])
    enddo
    if !tmpdist.set() then
      !tmpindx = !tmpdist.sortedIndices()
      !tmpdist.reindex(!tmpindx)
      !tmppos.reindex(!tmpindx)
      !dist[!c] = !tmpdist.first()
      !pos[!c] = !tmppos.first()
    endif
  enddo

  if !dist.set() then
    !newindex = !dist.sortedIndices()
    !first = !newindex[1]
    !result[!first] = !pos[!first]
  endif

  return !result


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      set
--
-- Description: returns true if object is set
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--   BOOLEAN      logical result
--
------------------------------------------------------------------------

define method .set() is BOOLEAN

  return !this.vertex.size().gt(1)

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: add last point at the same position as first point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- IMPORTANT NOTE:
  -- this method should never be used on handrail rpath!

  -- check if it can be closed
  if !this.isClosed().not() then
    return
  endif

  -- check if isn't already closed
  if !this.vertex.first().eq(!this.vertex.last()) then
    return
  endif

  -- compose vertex point
  !pos = !this.vertex.first()
  !sigref = !this.sigref.first()
  !detail = !this.detail.first()
  !index = !this.size()

  -- append vertex
  !this.insertVertex('POINTR',!index,!pos,!detail,!sigref)

endmethod
-- End of method
