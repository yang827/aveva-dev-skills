------------------------------------------------------------------------
--
-- Method:      setURise
--
-- Description: sets the urise
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        urise
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setURise(!uRise is REAL)

  !this.uRise = !uRise

  do !i index !this.strFltEngines
    !this.strFltEngines[!i].setURise(!uRise)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setWidth
--
-- Description: sets the width
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        width
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setWidth(!width is REAL)

  !this.width = !width

  do !i index !this.strFltEngines
    !this.strFltEngines[!i].setWidth(!width)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showVolFeedback
--
-- Description: draws the element with aid lines
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showVolFeedback()

  do !strFltEngine value !this.strFltEngines
    !strFltEngine.strFltData.showVolFeedback()
  enddo

  do !strLngEngine value !this.strLngEngines
    !strLngEngine.strLngData.showVolFeedback()
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      unEnhance
--
-- Description: unenhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .unEnhance()

  do !strFltEngine value !this.strFltEngines
    !strFltEngine.strFltData.unEnhance()
  enddo

  do !strLngEngine value !this.strLngEngines
    !strLngEngine.strLngData.unEnhance()
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: creates/updates a stair flight
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDB()

  -- create undo mark
  if ( !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update stair segment')
    !undo.add()
  endif

  do !strFltEngine value !this.strFltEngines
    !strFltEngine.strFltData.updateDB()
  enddo

  do !strLngEngine value !this.strLngEngines
    !strLngEngine.strLngData.updateDB()
  enddo

  -- end undo mark
  if ( !this.undoable ) then
    !undo.endUndoable()
  endif

endmethod
-- End of method

