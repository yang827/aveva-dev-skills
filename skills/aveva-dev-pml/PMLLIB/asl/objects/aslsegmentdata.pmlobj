--
--
-- Description:     container for STRSET data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslSegmentData()                 -                   default constructor
--  enhance()                        -                   enhances the element
--  erase()                          -                   erases all traces
--  getClearance()                   REAL                returns the clearance
--  getError()                       BOOLEAN             returns the error status
--  getGoing()                       REAL                returns the going
--  getLRise()                       REAL                returns the lrise
--  getOGoing()                      REAL                returns the overall going
--  getOptima()                      ARRAY               returns the optima
--  getOptimumPitch()                REAL                returns the optimum pitch
--  getPitch()                       REAL                returns the pitch
--  getRise()                        REAL                returns the rise
--  getTreads()                      REAL                returns the treads
--  getURise()                       REAL                returns the urise
--  getValidTreads()                 ARRAY               returns a set of valids
--  reEvaluate()                     -                   re evaluates
--  resetError()                     -                   resets error status
--  setCriteria(ASLSTRFLTCRITERIA,ASLSTRFLTCRITERIA,ASLSTRLNGCRITERIA,ASLSTRLNGCRITERIA,ASLHANDRACRITERIA,ASLHANDRACRITERIA) -                   sets the criteria
--  setExtensionOption(STRING)       -                   sets the extension option
--  setGoing(REAL)                   -                   sets the going
--  setLExtension(REAL)              -                   sets the lower extension
--  setLPickType(STRING)             -                   sets the lower pick type
--  setLRise(REAL)                   -                   sets the lrise
--  setLock(STRING,BOOLEAN)          -                   sets the lock flag value
--  setOGoing(REAL)                  -                   sets the overall going
--  setPitch(REAL)                   -                   sets the pitch
--  setRise(REAL)                    -                   sets the rise
--  setSettingReference(STRING)      -                   sets the setting
--  setTmplReferences(DBREF,DBREF,DBREF) -                   sets the template references
--  setTreads(REAL)                  -                   sets the treads
--  setUExtension(REAL)              -                   sets the upper extension
--  setUPickType(STRING)             -                   sets the upper pick type
--  setURise(REAL)                   -                   sets the urise
--  setWidth(REAL)                   -                   sets the width
--  showVolFeedback()                -                   draws the element with aid lines
--  unEnhance()                      -                   unenhances the element
--  updateDB()                       -                   creates/updates a stair flight
--  updateDataObj()                  -                   creates/updates the strsetdata object for the element
--  useOptimum()                     -                   use the optimum value
--

-- Define object
define object ASLSEGMENTDATA

  -- public members
  ---------------------------------------------------------------------------
  -- direction
  member .direction             is DIRECTION

  -- extension option
  member .extensionOption       is STRING

  -- flight thickness
  member .fThickness            is REAL

  -- going
  member .going                 is REAL
  member .goingLock             is BOOLEAN

  -- reference to the central template for handrails
  member .handRaTmplReference   is DBREF

  -- lower cutplane
  member .lCutPlane             is DIRECTION

  -- overall length
  member .length                is REAL

  -- lower extension
  member .lExtension            is REAL
  member .lExtensionLock        is BOOLEAN

  -- rise of the lower tread
  member .lRise                 is REAL

  -- lower SOP
  member .lSOP                  is POSITION

  -- bottom pick type (LINE, PLANE)
  member .lPickType             is STRING

  -- lower pick position data
  member .lPosData              is EDGPOSITIONDATA

  -- lower working point
  member .lWP                   is POSITION

  -- overall going
  member .oGoing                is REAL
  member .oGoingLock            is BOOLEAN

  -- overall rise
  member .oRise                 is REAL

  -- overlap
  member .overlap               is REAL

  -- angle Data
  member .pitch                 is REAL
  member .pitchLock             is BOOLEAN

  -- rise
  member .rise                  is REAL
  member .riseLock              is BOOLEAN

  -- link to the uses setting
  member .settingReference      is STRING

  -- contains all stair flight engines
  member .strFltEngines         is ARRAY

  -- reference to the central template for  stair flight
  member .strFltTmplReference   is DBREF

  -- reference to the central template for intermediated landings
  member .strLngTmplReference   is DBREF

  -- contains all landing engines
  member .strLngEngines         is ARRAY

  -- number of treads
  member .treads                is REAL
  member .treadsLock            is BOOLEAN

  -- upper cutplane
  member .uCutPlane             is DIRECTION

  -- upper extension
  member .uExtension            is REAL
  member .uExtensionLock        is BOOLEAN

  -- top pick type (LINE, PLANE)
  member .uPickType             is STRING

  -- upper pick position data
  member .uPosData              is EDGPOSITIONDATA

  -- rise of the top tread
  member .uRise                 is REAL

  -- upper SOP
  member .uSOP                  is POSITION

  -- upper working point
  member .uWP                   is POSITION

  -- width
  member .width                 is REAL


  -- private member
  ---------------------------------------------------------------------------
  -- true if an error occurs
  member .error                 is BOOLEAN

  -- contains the range of progress
  member .progressRange         is REAL

  -- controls if the object uses the undo functionality
  member .undoable              is BOOLEAN

endobject
-- End of object definition for aslStrSetData

------------------------------------------------------------------------
--
-- Method:      aslSegmentData
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslSegmentData()


  -- inits locks
  do !attName value !this.attributes()
    if ( !attName.matchwild('*LOCK') ) then
      !this.attribute(!attName) = false
    endif
  enddo

  !this.error         = false
  !this.progressRange = 0
  !this.undoable      = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .enhance()

  do !strFltEngine value !this.strFltEngines
    !strFltEngine.enhance()
  enddo

  do !strLngEngine value !this.strLngEngines
    !strLngEngine.enhance()
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      erase
--
-- Description: erases all traces
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .erase()

  -- handles the stair flights
  do !strFltEngine value !this.strFltEngines
    !strFltEngine.erase()
  enddo

  -- handles the landings
  do !strLngEngine value !this.strLngEngines
    !strLngEngine.erase()
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getClearance
--
-- Description: returns the clearance
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        clearance
------------------------------------------------------------------------

define method .getClearance() is REAL

  !strFltEngine = !this.strFltEngines.first()
  return !strFltEngine.getClearance()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getError
--
-- Description: returns the error status
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     error status
------------------------------------------------------------------------

define method .getError() is BOOLEAN

  -- inits
  !error = !this.error

  -- handles the stair flights
  do !strFltEngine value !this.strFltEngines
    !error = !error or !strFltEngine.getError()
  enddo

  -- handles the landings
  do !strLngEngine value !this.strLngEngines
    !error = !error or !strLngEngine.getError()
  enddo

  return !error

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getGoing
--
-- Description: returns the going
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        going
------------------------------------------------------------------------

define method .getGoing() is REAL

  if ( !this.strFltEngines.empty().not() ) then
    !strFltEngine = !this.strFltEngines.first()
    !this.going   = !strFltEngine.getGoing()
  endif
  return !this.going

endmethod
-- End of method

