    !this.strFltEngines[!i].setLPickType(!lPickType)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLock
--
-- Description: sets the lock flag value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      name of the attribute
--    2   R      BOOLEAN     value of the lock flag
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLock(!attributeName is STRING, !lock is BOOLEAN)

  if ( !this.attributes().findFirst(!attributeName).set() ) then
    !this.attribute(!attributeName) = !lock
  endif

  do !i index !this.strFltEngines
    !this.strFltEngines[!i].setLock(!attributeName, !lock)
  enddo

endmethod
-- End of method

