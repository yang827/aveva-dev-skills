------------------------------------------------------------------------
--
-- Method:      reEvaluate
--
-- Description: reevaluates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .reEvaluate()

  do !i index !this.strFltEngines
    !this.strFltEngines[!i].evaluate()
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resetError
--
-- Description: resets error status
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .resetError()

  !this.error = false

  do !i index !this.strFltEngines
    !this.strFltEngines[!i].resetError()
  enddo

  do !i index !this.strLngEngines
    !this.strLngEngines[!i].resetError()
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setCriteria
--
-- Description: sets the criteria
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLSTRFLTCRITERIA
--                           merged criteria for stair flights
--    2   R      ASLSTRFLTCRITERIA
--                           standard criteria for stair flights
--    3   R      ASLSTRLNGCRITERIA
--                           merged criteria for landings
--    4   R      ASLSTRLNGCRITERIA
--                           standard criteria for landings
--    5   R      ASLHANDRACRITERIA
--                           merged criteria for handrails
--    6   R      ASLHANDRACRITERIA
--                           standard criteria for handrails
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setCriteria(!strFltCrit is ASLSTRFLTCRITERIA, !strFltCritBasis is ASLSTRFLTCRITERIA, !strLngCrit is ASLSTRLNGCRITERIA, !strLngCritBasis is ASLSTRLNGCRITERIA, !handRaCrit is ASLHANDRACRITERIA, !handRaCritBasis is ASLHANDRACRITERIA)

  -- stair flights
  ---------------------------------------------------------------------------
  do !i index !this.strFltEngines
    !this.strFltEngines[!i].strFltCriteria      = !strFltCrit
    !this.strFltEngines[!i].strFltCriteriaBasis = !strFltCritBasis

    !this.strFltEngines[!i].handRaCriteria      = !handRaCrit
    !this.strFltEngines[!i].handRaCriteriaBasis = !handRaCritBasis

    -- sets the width
    !width = !strFltCrit.getOptimumWidth()
    !this.strFltEngines[!i].setWidth(!width)
  enddo


  -- landings
  ---------------------------------------------------------------------------
  do !i index !this.strLngEngines
    !this.strLngEngines[!i].strLngCriteria      = !strLngCrit
    !this.strLngEngines[!i].strLngCriteriaBasis = !strLngCritBasis

    !this.strLngEngines[!i].handRaCriteria      = !handRaCrit
    !this.strLngEngines[!i].handRaCriteriaBasis = !handRaCritBasis

    -- sets the width
    !width = !strLngCrit.getOptimumWidth()
    !this.strLngEngines[!i].setWidth(!width)
  enddo

endmethod
-- End of method

