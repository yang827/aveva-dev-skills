------------------------------------------------------------------------
--
-- Method:      setSettingReference
--
-- Description: sets the setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      setting
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setSettingReference(!settingReference is STRING)

  !this.settingReference = !settingReference

  -- stair flights
  do !i index !this.strFltEngines
    !this.strFltEngines[!i].setSettingReference(!settingReference)
  enddo

  -- landings
  do !i index !this.strLngEngines
    !this.strLngEngines[!i].setSettingReference(!settingReference)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setTmplReferences
--
-- Description: sets the template references
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       template for stair flights
--    2   R      DBREF       template for landings
--    3   R      DBREF       template for handrails
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setTmplReferences(!strFltTmplReference is DBREF, !strLngTmplReference is DBREF, !handRaTmplReference is DBREF)

  -- stair flights
  !this.strFltTmplReference = !strFltTmplReference
  do !i index !this.strFltEngines
    !this.strFltEngines[!i].setTmplReferences(!strFltTmplReference, !handRaTmplReference)
  enddo

  -- landings
  !this.strLngTmplReference = !strLngTmplReference
  do !i index !this.strLngEngines
    !this.strLngEngines[!i].setTmplReferences(!strLngTmplReference, !handRaTmplReference)
  enddo

  -- handrails
  !this.handRaTmplReference = !handRaTmplReference

endmethod
-- End of method

