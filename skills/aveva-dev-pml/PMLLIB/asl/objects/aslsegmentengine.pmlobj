------------------------------------------------------------------------

define method .erase()

  !this.segmentData.erase()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluate
--
-- Description: evaluates segment
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluate()

  -- evaluates the max allowed rise for the segment
  if ( !this.strFltCriteria.oRise.max.gt(!this.segmentData.oRise) ) then
    !strFltORise = !this.segmentData.oRise
  else
    !strFltORise =!this.strFltCriteria.oRise.max
  endif

  -- predicts the minimum divisor
  !divisor = !this.segmentData.oRise / !strFltORise

  -- rounds divisor
  if ( !divisor.gt(!divisor.nint()) ) then
    !divisor = !divisor.int() + 1
  else
    !divisor = !divisor.nint()
  endif

  -- stores the start value of progress
  !startProgress = !!fmSys.progress()

--$P orise $!strFltORise  divisor $!divisor
  -- emergency exit
  !i = 100
  do
    -- updates the progress bar
    !currentProgress = !!fmSys.progress()
    !deltaProgress   = !currentProgress - !startProgress
    if ( !deltaProgress.lt(!this.segmentData.progressRange / 2) ) then
      !!fmSys.setProgress(!!fmSys.progress() + !this.segmentData.progressRange / 10)
    endif

    !i = !i - 1

    -- emergency break
    break if ( !i.leq(0) )
    -- corrects the stair flight orise value according the evaluated divisor
    !strFltORise = !this.segmentData.oRise / !divisor

    -- evaluates the stair flight length
    !strFltLength = ( !this.segmentData.length - !this.strLngCriteria.width.optimum *  ( !divisor - 1 ) ) / !divisor
--$P loop $!i  orise $!strFltORise  divisor $!divisor  length $!strFltLength
    break if ( !strFltLength.leq(0) )
    !uWP = !this.segmentData.lWP.offSet(U, !strFltORise)
    !uWP = !uWP.offSet(!this.segmentData.direction, !strFltLength)

    !strFltData                         = object ASLSTRFLTDATA()
    !strFltData.drawControlPoint        = false
    !strFltData.fThickness              = !this.segmentData.fThickness
    !strFltData.lPickType               = 'LINE'
    !strFltData.lWP                     = !this.segmentData.lWP
    !strFltData.settingReference        = !this.segmentData.settingReference
    !strFltData.strFltTmplReference     = !this.segmentData.strFltTmplReference
    !strFltData.handraTmplReference     = !this.segmentData.handraTmplReference
    !strFltData.uPickType               = 'LINE'
    !strFltData.uWP                     = !uWP
    !strFltData.deriveData()
    !strFltData.going                   = !this.segmentData.going
    !strFltData.lCutPlane               = !strFltData.direction
    !strFltData.lRise                   = !this.segmentData.lRise
    !strFltData.pitch                   = !this.segmentData.pitch
    !strFltData.rise                    = !this.segmentData.rise
    !strFltData.treads                  = !this.segmentData.treads
    !strFltData.uCutPlane               = !strFltData.direction
    !strFltData.uRise                   = !this.segmentData.uRise
    !strFltData.width                   = !this.segmentData.width


    -- evaluates locks
    ---------------------------------------------------------------------------
    -- evaluates all strflt locks
    !strFltLocks = object ARRAY()
    do !attName value !strFltData.attributes()
      if ( !attName.matchwild('*LOCK') ) then
        !strFltLocks.append(!attName)
      endif
    enddo

    -- evaluates all strflt locks
    !segmentLocks = object ARRAY()
    do !attName value !this.segmentData.attributes()
      if ( !attName.matchwild('*LOCK') ) then
        !segmentLocks.append(!attName)
      endif
    enddo

    -- evaluates and set intersection
    !locks = !segmentLocks.intersect(!strFltLocks)
    do !attName value !locks
      !strFltData.attribute(!attName) = !this.segmentData.attribute(!attName)
    enddo

    -- evaluates real values and stores the stair flight
    !strFltEngine                       = object ASLSTRFLTENGINE()
    !strFltEngine.strFltData            = !strFltData
    !strFltEngine.strFltCriteria        = !this.strFltCriteria
    !strFltEngine.strFltCriteriaBasis   = !this.strFltCriteriaBasis
    !strFltEngine                       = !!aslCentralData.evaluateStrFlt(!strFltEngine, 'STRSET')

    -- updates the progress bar
    !currentProgress = !!fmSys.progress()
    !deltaProgress   = !currentProgress - !startProgress
    if ( !deltaProgress.lt(!this.segmentData.progressRange / 2) ) then
      !!fmSys.setProgress(!!fmSys.progress() + !this.segmentData.progressRange / 5)
    endif

    break if (  !strFltEngine.getError().not() )

    !divisor = !divisor + 1
  enddo

  -- checks if it is possible to calculate
  if ( UNDEFINED(!strFltEngine) or $
       !strFltEngine.getError() ) then
    !!error.text = 'Unable to evaluate segment'
    !this.segmentData.error = true
    return
  endif

  -- updates the progress bar
  !!fmSys.setProgress(!startProgress + !this.segmentData.progressRange / 2)

  -- evaluates the different extension options
  !this.segmentData.lExtension = !strFltEngine.getLExtension() * !divisor
  !this.segmentData.uExtension = !strFltEngine.getUExtension() * !divisor

  do !i from 1 to !divisor

    -- stair flights
    ---------------------------------------------------------------------------
    !strFltEngine.strFltData = !strFltEngine.strFltData
    !this.segmentData.strFltEngines.append(!strFltEngine)


    -- intermediated landings
    ---------------------------------------------------------------------------
    if ( !i.between(2, !divisor) ) then
      !strLngEngine = object ASLSTRLNGENGINE()
      !this.segmentData.strLngEngines.append(!strLngEngine)
    endif
  enddo

  !!fmSys.setProgress(!!fmSys.progress() + !this.segmentData.progressRange / 4)
  !this.correctSegment()
  !this.evaluateHandra()
  !!fmSys.setProgress(!!fmSys.progress() + !this.segmentData.progressRange / 4)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateDirection
--
-- Description: evaluates and sets the direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateDirection()

  !line                       = object LINE(!this.segmentData.lWP, !this.segmentData.uWP)
  !orientation                = object ORIENTATION('Z is U')
  !plane                      = object PLANE(!this.segmentData.lWP, !orientation)
  !this.segmentData.direction = !line.direction().projected(!plane)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateExtensionsTotal
-- Description: evaluates the total of both extensions
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    return      total of both extensions
------------------------------------------------------------------------

define method .evaluateExtensionsTotal() is REAL

  !lExtension = !this.getLExtension()
  !uExtension = !this.getUExtension()

  return !lExtension + !uExtension

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateHandra
--
-- Description: evaluates the handrails
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateHandra()

  !numberOfStrFlts = !this.segmentData.strFltEngines.size()
  do !i from 1 to !numberOfStrFlts
    !this.segmentData.strFltEngines[!i].evaluateHandra()
  enddo

  !numberOfStrLngs = !this.segmentData.strLngEngines.size()
  do !i from 1 to !numberOfStrLngs
    !this.segmentData.strLngEngines[!i].evaluateHandra()
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLength
--
-- Description: evaluates and sets the length
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateLength()

  !line                    = object LINE(!this.segmentData.lWP, !this.segmentData.uWP)
  !orientation             = object ORIENTATION('Z is U')
  !plane                   = object PLANE(!this.segmentData.lWP, !orientation)
  !line                    = !line.projected(!plane)

  !this.segmentData.length = !line.length()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateORise
--
-- Description: evaluates and sets the oRise
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateORise()

  !this.segmentData.oRise = !this.segmentData.uWP.up - !this.segmentData.lWP.up

endmethod
-- End of method

