------------------------------------------------------------------------
--
-- Method:      getOptima
--
-- Description: returns the optima
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] angles
--                [2] treads
------------------------------------------------------------------------

define method .getOptima() is ARRAY

