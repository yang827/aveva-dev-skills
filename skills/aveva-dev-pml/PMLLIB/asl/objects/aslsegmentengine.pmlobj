------------------------------------------------------------------------
--
-- Method:      getLock
--
-- Description: returns the lock flag value
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      name of the attribute
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     value of the lock flag
------------------------------------------------------------------------

define method .getLock(!attributeName is STRING) is BOOLEAN

  if ( !this.segmentData.attributes().findFirst(!attributeName).set() ) then
    return !this.segmentData.attribute(!attributeName)
  else
    return false
  endif

endmethod
-- End of method

