--    2   R      BOOLEAN     value of the lock flag
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLock(!attributeName is STRING, !lock is BOOLEAN)

  if ( !this.segmentData.attributes().findFirst(!attributeName).set() ) then
   !this.segmentData.attribute(!attributeName) = !lock
  endif
  !this.segmentData.setLock(!attributeName, !lock)

endmethod
-- End of method

