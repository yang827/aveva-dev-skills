------------------------------------------------------------------------
--
-- Method:      setLCutPlane
--
-- Description: sets the lower cutplane
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   lower cutplane
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLCutPlane(!lCutPlane is DIRECTION)

  !this.segmentData.lCutPlane = !lCutPlane

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLExtension
--
-- Description: sets the lower extension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        lower extension
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLExtension(!extension is REAL)

  -- evaluates the total of extensions
  !extensionsTotal = !this.evaluateExtensionsTotal()

  -- corrects invalid values
  if ( !extension.lt(0) ) then
    !this.segmentData.lExtension = 0
  elseif ( !extension.gt(!extensionsTotal) ) then
    !this.segmentData.lExtension = !extensionsTotal
  else
    !this.segmentData.lExtension = !extension
  endif

  -- adapts the upper extension
  !this.segmentData.uExtension = !extensionsTotal - !this.segmentData.lExtension

  -- corrects the extensions options
  !this.correctExtensionOptions()
  !this.resetStrFlts()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLock
--
-- Description: sets the lock flag value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
