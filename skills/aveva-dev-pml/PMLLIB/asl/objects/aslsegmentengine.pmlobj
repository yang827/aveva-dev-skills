------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslSegmentEngine()               -                   Constructor
--  aslSegmentEngine(ASLSEGMENTDATA) -                   Constructor
--  correctExtensionOptions()        -                   corrects the selected extension option
--  correctSegment()                 -                   corrects the content of the segment
--  enhance()                        -                   enhances the element
--  erase()                          -                   erases all traces
--  evaluate()                       -                   evaluates segment
--  evaluateDirection()              -                   evaluates and sets the direction
--  evaluateExtensionsTotal()        REAL                evaluates the total of both extensions
--  evaluateHandra()                 -                   evaluates the handrails
--  evaluateLength()                 -                   evaluates and sets the length
--  evaluateORise()                  -                   evaluates and sets the oRise
--  getClearance()                   REAL                returns the clearance
--  getError()                       BOOLEAN             returns the error status
--  getExtensionOption()             STRING              returns the extension option
--  getGoing()                       REAL                returns the going
--  getLCutPlane()                   DIRECTION           returns the direction of the lower cutplane
--  getLExtension()                  REAL                returns the lower extension
--  getLRise()                       REAL                returns the lrise
--  getLWP()                         POSITION            returns the lower working point
--  getLock(STRING)                  BOOLEAN             returns the lock flag value
--  getOGoing()                      REAL                returns the overall going
--  getORise()                       REAL                returns the overall rise
--  getOptima()                      ARRAY               returns the optima
--  getOptimumPitch()                REAL                returns the optimum pitch
--  getPitch()                       REAL                returns the pitch
--  getRise()                        REAL                returns the rise
--  getSettingReference()            STRING              returns the setting
--  getTmplReference()               STRING              returns the template
--  getTreads()                      REAL                returns the treads
--  getUCutPlane()                   DIRECTION           returns the direction of the upper cutplane
--  getUExtension()                  REAL                returns the upper extension
--  getURise()                       REAL                returns the urise
--  getUWP()                         POSITION            returns the upper working point
--  getValidTreads()                 ARRAY               returns a set of valids
--  getWidth()                       REAL                returns the width
--  reEvaluate()                     -                   re evaluates
--  resetError()                     -                   resets error status
--  resetStrFlts()                   -                   resets the stair flight
--  setCriteria(ASLSTRFLTCRITERIA,ASLSTRFLTCRITERIA,ASLSTRLNGCRITERIA,ASLSTRLNGCRITERIA,ASLHANDRACRITERIA,ASLHANDRACRITERIA) -                   sets the criteria
--  setExtensionOption(STRING)       -                   sets the extension option
--  setGoing(REAL)                   -                   sets the going
--  setLCutPlane(DIRECTION)          -                   sets the lower cutplane
--  setLExtension(REAL)              -                   sets the lower extension
--  setLPickType(STRING)             -                   sets the lower pick type
--  setLRise(REAL)                   -                   sets the lrise
--  setLock(STRING,BOOLEAN)          -                   sets the lock flag value
--  setOGoing(REAL)                  -                   sets the overall going
--  setPitch(REAL)                   -                   sets the pitch
--  setRise(REAL)                    -                   sets the rise
--  setSettingReference(STRING)      -                   sets the setting
--  setTmplReferences(DBREF,DBREF,DBREF) -                   sets the template references
--  setTreads(REAL)                  -                   sets the treads
--  setUCutPlane(DIRECTION)          -                   sets the upper cutplane
--  setUExtension(REAL)              -                   sets the upper extension
--  setUPickType(STRING)             -                   sets the upper pick type
--  setURise(REAL)                   -                   sets the urise
--  setWidth(REAL)                   -                   sets the width
--  showVolFeedback()                -                   draws the element with aid lines
--  unEnhance()                      -                   unenhances the element
--  updateDB()                       -                   creates/updates a segment of a stair set
--  useOptimum()                     -                   use the optimum value
--

define object ASLSEGMENTENGINE

  -- public members
  ---------------------------------------------------------------------------
  -- container for the stair flight data
  member .segmentData         is ASLSEGMENTDATA

  -- private members
  ---------------------------------------------------------------------------
  -- contains the criteria set for handrail elements (including fabricator standard)
  member .handraCriteria      is ASLHANDRACRITERIA

  -- contains the criteria set for handrail elements (excluding fabricator standard)
  member .handraCriteriaBasis is ASLHANDRACRITERIA

  -- contains the criteria set for stair flight elements (including fabricator standard)
  member .strFltCriteria      is ASLSTRFLTCRITERIA

  -- contains the criteria set for stair flight elements (excluding fabricator standard)
  member .strFltCriteriaBasis is ASLSTRFLTCRITERIA

  -- contains the criteria set for landing elements (including fabricator standard)
  member .strLngCriteria      is ASLSTRLNGCRITERIA

  -- contains the criteria set for landing elements (excluding fabricator standard)
  member .strLngCriteriaBasis is ASLSTRLNGCRITERIA

  -- contains a copy of stair flight data before modify
  member .segmentDataOld      is ASLSEGMENTDATA

endobject
-- End of object definition for ASLSegmentEngine

------------------------------------------------------------------------
--
-- Method:      aslSegmentEngine
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslSegmentEngine()


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aslSegmentEngine
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLSEGMENTDATA  segment data
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslSegmentEngine(!segmentData is ASLSEGMENTDATA)

  !this.segmentData = !segmentData

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      correctExtensionOptions
--
-- Description: corrects the selected extension option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .correctExtensionOptions()

  !lExtension     = !this.getLExtension()
  !uExtension     = !this.getUExtension()
  !extensionTotal = !this.evaluateExtensionsTotal()

  -- evaluates the difference between the lower and the upper extensions
  !difference = !lExtension - !uExtension

  -- adapts the extension options
  if (  !difference.abs().between(0, 0.01) ) then
    !this.setExtensionOption('Upper extension = Lower extension')

  elseif (  !lExtension.between(0, 0.01) ) then
    !this.setExtensionOption('Lower extension = minimum')

  elseif (  !uExtension.between(0, 0.01) ) then
    !this.setExtensionOption('Upper extension = minimum')

  else
    !this.setExtensionOption('User defined')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      correctSegment
--
-- Description: corrects the content of the segment
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .correctSegment()

  -- evaluates the oRise of the first
  !strFltEngine = !this.segmentData.strFltEngines.first()
  !oGoing       = !strFltEngine.strFltData.oGoing
  !oRise        = !strFltEngine.strFltData.oRise

  -- evaluates the extensions
  !lExtension = 0
  !uExtension = 0

  do !strFltEngines value !this.segmentData.strFltEngines
    !lExtension = !lExtension + !strFltEngine.strFltData.lExtension
    !uExtension = !uExtension + !strFltEngine.strFltData.uExtension
  enddo
  !this.segmentData.lExtension = !lExtension
  !this.segmentData.uExtension = !uExtension

  !numberOfStrFlts = !this.segmentData.strFltEngines.size()
  do !i from 1 to !numberOfStrFlts
    ---------------------------------------------------------------------------
    -- stair flights
    ---------------------------------------------------------------------------
    !strFltData = !this.segmentData.strFltEngines[!i].strFltData

    -- defines the attributes for the lwp
    ---------------------------------------------------------------------------
    !strFltData.lWP = !this.segmentData.lWP.offSet(U, (!i - 1) * !oRise)
    !offSet         = (!i - 1) * (!oGoing + !this.strLngCriteria.width.optimum)

    -- lower cutplane for the lowest stair flight
    if ( !i.eq(1) ) then
      !strFltData.lCutPlane  = !this.segmentData.lCutPlane
      !strFltData.lExtension = !this.segmentData.lExtension

    -- any other intermediated landing
    else
      !strFltData.lCutPlane  = !strFltData.direction
      !strFltData.lExtension = 0
      !offSet                = !offSet + !this.segmentData.lExtension
    endif
    !strFltData.lWP = !strFltData.lWP.offSet(!strFltData.direction, !offSet)



    -- defines the attributes for the uwp
    ---------------------------------------------------------------------------
    !strFltData.uWP = !this.segmentData.lWP.offSet(U, !i * !oRise)
    !offSet         = !i * !oGoing + (!i - 1) * !this.strLngCriteria.width.optimum + !this.segmentData.lExtension

    -- upper cutplane for the highest stair flight
    if ( !i.eq(!numberOfStrFlts)  ) then
      !strFltData.uCutPlane  = !this.segmentData.uCutPlane
      !strFltData.uExtension = !this.segmentData.uExtension
      !offSet                = !offSet + !this.segmentData.uExtension

    -- any other intermediated landing
    else
      !strFltData.uCutPlane  = !strFltData.direction
      !strFltData.uExtension = 0
    endif
    !strFltData.uWP = !strFltData.uWP.offSet(!strFltData.direction, !offSet)



    -- derive data
    !strFltData.deriveData()
    !this.segmentData.strFltEngines[!i].strFltData = !strFltData

    -- intermediated landings
    ---------------------------------------------------------------------------
    if ( !i.between(2, !numberOfStrFlts) ) then
      -- evaluates the start position for the current landing
      !endPosition = !strFltData.lWP

      -- inits
      !strLngEngine                     = !this.segmentData.strLngEngines[!i - 1]
      !strLngEngine.strLngCriteria      = !this.strLngCriteria
      !strLngEngine.strLngCriteriaBasis = !this.strLngCriteriaBasis
      !strLngEngine.setArriveCutPlane(!strFltData.direction)
--TODO: clearance
      !clearance    = 2000mm
      !strLngEngine.setClearance(!clearance)
      !strLngEngine.setLeaveCutPlane(!strFltData.direction)
      !strLngEngine.setPosition(!startPosition.midpoint(!endPosition))
      !strLngEngine.setPurpose('ILNG')
      !strLngEngine.setSettingReference(!this.segmentData.settingReference)
      !strLngEngine.setTmplReferences(!this.segmentData.strLngTmplReference, !this.segmentData.handraTmplReference)
      !strLngEngine.setWidth(!this.segmentData.width)

      -- evaluates and sets the centre line
      !edges[1]   = object LINE(!startPosition, !endPosition)
      !centreLine = object PROFILE(!startPosition, Z is U, !edges)
      !strLngEngine.setCentreLine(!centreLine)

      -- evaluates the arrive and the leave connection point
      !strLngEngine.evaluateArrivePt()
      !strLngEngine.evaluateLeavePt()

      -- evaluates the shape of the
      !strLngEngine.evaluateShape()
      !this.segmentData.strLngEngines[!i - 1] = !strLngEngine
    endif

    -- stores the new start position for the next landing
    !startPosition = !strFltData.uWP

  enddo

endmethod
-- End of method

