------------------------------------------------------------------------
--
-- Method:      reEvaluate
--
-- Description: re evaluates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .reEvaluate()

  -- extends the available length of the stair flight to the maximum allowed length
  !this.resetStrFlts()

  -- evaluates stair flights
  !this.segmentData.reEvaluate()

  -- adapts the stair flight to the current extension option
  !this.correctSegment()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resetError
--
-- Description: resets error status
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .resetError()

  !this.segmentData.resetError()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resetStrFlts
--
-- Description: resets the stair flight
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .resetStrFlts()

  -- evaluates the number of stair flights
  !numberOfStairFlights = !this.segmentData.strFltEngines.size()


  -- evaluates the lower and the upper extension for stair flights
  !lExtension = !this.segmentData.lExtension / !numberOfStairFlights
  !uExtension = !this.segmentData.uExtension / !numberOfStairFlights

  -- handles all stair flights of the segment
  do !i index !this.segmentData.strFltEngines
    -- reduces the size of the expression
    !strFltData        = !this.segmentData.strFltEngines[!i].strFltData

    -- sets the new length of the current segment
    !strFltData.length     = !strFltData.oGoing + !lExtension + !uExtension
    !strFltData.lExtension = !lExtension
    !strFltData.uExtension = !uExtension

    -- adapts the position of upper working point
    !uWP               = !strFltData.uWP
    !uWP.east          = !strFltData.lWP.east
    !uWP.north         = !strFltData.lWP.north
    !uWP               = !uWP.offSet(!strFltData.direction, !strFltData.length)

    -- assigns the new data
    !this.segmentData.strFltEngines[!i].strFltData = !strFltData
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setCriteria
--
-- Description: sets the criteria
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLSTRFLTCRITERIA
--                           merged criteria for stair flights
--    2   R      ASLSTRFLTCRITERIA
--                           standard criteria for stair flights
--    3   R      ASLSTRLNGCRITERIA
--                           merged criteria for landings
--    4   R      ASLSTRLNGCRITERIA
--                           standard criteria for landings
--    5   R      ASLHANDRACRITERIA
--                           merged criteria for handrails
--    6   R      ASLHANDRACRITERIA
--                           standard criteria for handrails
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setCriteria(!strFltCrit is ASLSTRFLTCRITERIA, !strFltCritBasis is ASLSTRFLTCRITERIA, !strLngCrit is ASLSTRLNGCRITERIA, !strLngCritBasis is ASLSTRLNGCRITERIA, !handraCrit is ASLHANDRACRITERIA, !handraCritBasis is ASLHANDRACRITERIA)

  !this.strFltCriteria      = !strFltCrit
  !this.strFltCriteriaBasis = !strFltCritBasis
  !this.strLngCriteria      = !strLngCrit
  !this.strLngCriteriaBasis = !strLngCritBasis
  !this.handraCriteria      = !handraCrit
  !this.handraCriteriaBasis = !handraCritBasis
  !this.segmentData.setCriteria(!strFltCrit, !strFltCritBasis, !strLngCrit, !strLngCritBasis, !handraCrit, !handraCritBasis)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setExtensionOption
--
-- Description: sets the extension option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      extension option
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setExtensionOption(!extensionOption is STRING)

  -- sets the extensions options for the segment
  !this.segmentData.extensionOption = !extensionOption

  -- reads the values of the current extensions
  !lExtension = !this.getLExtension()
  !uExtension = !this.getUExtension()
  !extension  = !lExtension + !uExtension

  -- handles the different extension options
  if ( !this.segmentData.extensionOption.eq('Upper extension = minimum') ) then
    !this.segmentData.lExtension = !extension
    !this.segmentData.uExtension = 0

  elseif ( !this.segmentData.extensionOption.eq('Lower extension = minimum') ) then
    !this.segmentData.lExtension = 0
    !this.segmentData.uExtension =!extension

  elseif ( !this.segmentData.extensionOption.eq('Upper extension = Lower extension') ) then
    !this.segmentData.lExtension = !extension / 2
    !this.segmentData.uExtension = !extension / 2

  elseif ( !this.segmentData.extensionOption.eq('User defined') ) then

  endif

  !this.segmentData.setExtensionOption(!extensionOption)

endmethod
-- End of method

