------------------------------------------------------------------------
--
-- Method:      setUExtension
--
-- Description: sets the upper extension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        upper extension
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setUExtension(!extension is REAL)

  -- evaluates the total of extensions
  !extensionsTotal = !this.evaluateExtensionsTotal()

  -- corrects invalid values
  if ( !extension.lt(0) ) then
    !this.segmentData.uExtension = 0
  elseif ( !extension.gt(!extensionsTotal) ) then
    !this.segmentData.uExtension = !extensionsTotal
  else
    !this.segmentData.uExtension = !extension
  endif

  -- adapts the upper extension
  !this.segmentData.lExtension = !extensionsTotal - !this.segmentData.uExtension

    -- corrects the extensions options
  !this.correctExtensionOptions()

endmethod
-- End of method

