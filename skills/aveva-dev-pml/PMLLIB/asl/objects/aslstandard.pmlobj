-- Author:          Lars Leppin
-- Created:         Tue Aug 1 09:00:00 GMT 2006
--
--
-- Description:     container for standard data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStandard()                    -                   Constructor
--  string()                         STRING              returns description
--
define object ASLSTANDARD

  -- true if the standard is prepared to delete
  member .deleteFlag   is BOOLEAN

  -- name of the standard
  member .name         is STRING

  -- description of the standard
  member .description  is STRING

  --
  member .refe         is DBREF

  -- marker for the origin of the data (PDMSDFLTS or PROJDFLTS)
  member .originKey    is STRING

  -- substandards like Private, Public, Semi-Public
  member .subStandards is ARRAY

endobject
-- End of object definition for aslStandard

------------------------------------------------------------------------
--
-- Method:      aslStandard
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStandard()

  -- inits the delete status
  !this.deleteFlag = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      string
--
-- Description: Returns object name or object type if unset
--
-- Method Type: Function
-- Arguments:
-- Return:
--   [Data Type] [Description]
--    STRING      Returned string
------------------------------------------------------------------------

define method .string() is STRING

  if !this.name.unset() then
     return !this.objectType()
  else
     return !this.name
  endif

endmethod
-- end of method
