-- File:            aslstrfltcriteria.pmlobj
-- Type:            Object Definition
-- Group:           ASL Application
-- Keyword:         GEN
-- Module:          DESIGN
-- Replaces:
-- Author:          Lars Leppin
-- Created:         Tue Aug 1 09:00:00 GMT 2006
--
--
-- Description:     container for STRFLT criteria data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrFltCriteria()              -                   default constructor
--  checkValue(REAL,STRING)          -                   check value against criterion
--  complete()                       -                   completes all missing values
--

-- Define object
define object ASLSTRFLTCRITERIA

  -- stores the description of the object
  member .desc                   is STRING

  -- going
  member .going                  is CRITERION

  -- rise of bottom tread
  member .lRise                  is CRITERION

  -- Pitch (Angle)
  member .pitch                  is CRITERION

  -- Flight Thickness
  member .thickness              is CRITERION

  -- rise
  member .rise                   is CRITERION

  -- overall going
  member .oGoing                 is CRITERION

  -- overall Rise
  member .oRise                  is CRITERION

  -- number of treads
  member .treads                 is CRITERION

  -- rise of top tread
  member .uRise                  is CRITERION

  -- vertical clearance
  member .verticalClearance      is CRITERION

  -- width
  member .width                  is CRITERION

  -- Intermediate Landing Length
  member .fltIntLngLength        is CRITERION

endobject
-- End of object definition for aslStrFltCriteria

------------------------------------------------------------------------
--
-- Method:      aslStrFltCriteria
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrFltCriteria()

  !this.desc                            = 'Stair Flight'

  !this.going.description               = 'Going'
  !this.lRise.description               = 'Rise of bottom tread'
  !this.oGoing.description              = 'Overall going'
  !this.oRise.description               = 'Overall rise'
  !this.pitch.description               = 'Pitch'
  !this.thickness.description           = 'Thickness'
  !this.pitch.propertyType              = 'REAL'
  !this.rise.description                = 'Rise'
  !this.treads.description              = 'Number of treads'
  !this.treads.propertyType             = 'REAL'
  !this.uRise.description               = 'Rise of top tread'
  !this.verticalClearance.description   = 'Vertical clearance'
  !this.width.description               = 'Width'
  !this.fltIntLngLength.description     = 'Intermediate Landing Length'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      complete
--
-- Description: completes all missing values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .complete()

  !this.going.complete(150mm, 300mm)
  !this.oGoing.complete(1mm, 10000mm)
  !this.oRise.complete(1mm, 10000mm)
  !this.pitch.complete(1, 90)
  !this.thickness.complete(50mm, 250mm)
  !this.rise.complete(50mm, 300mm)
  !this.lRise.complete(50mm, 300mm)
  !this.verticalClearance.complete(2000mm, 5000mm)
  !this.fltIntLngLength.complete(300mm,5000mm)

  -- treads
  !this.treads.complete(1, 16)
  !this.treads.validValues = object ARRAY()
  do !value from !this.treads.min to !this.treads.max
    !this.treads.validValues.append(!value)
  enddo

  !this.width.complete(400mm, 1000mm)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      checkValue
--
-- Description: check value against criterion
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Value to be checked
--    2   R      STRING      Criterion name
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .checkValue(!value is REAL,!criterionName is STRING)

  -- get appropriate CRITERION and check the value
  !criterion = !this.attribute(!criterionName.upcase())
  !criterion.checkValue(!value)

endmethod
-- end of method
