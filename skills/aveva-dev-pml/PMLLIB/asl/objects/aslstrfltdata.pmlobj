--
--
-- Description:     container for STRFLT data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrFltData()                  -                   default constructor
--  buildExtension(POSITION,REAL)    -                   builds the extension
--  buildHandras()                   -                   build the handrails
--  buildTread(REAL,POSITION)        -                   builds treads
--  deriveData()                     -                   evaluates the main data
--  enhance()                        -                   enhances the element
--  erase()                          -                   erases all traces
--  evaluateDirection()              -                   evaluates and sets the direction
--  evaluateLSOP()                   -                   evaluates and sets the LSOP position
--  evaluateLWP()                    -                   evaluates and sets the LWP position
--  evaluateLength()                 -                   evaluates and sets the length
--  evaluateOGoing()                 -                   evaluates and sets the OGoing value
--  evaluateORise()                  -                   evaluates and sets the oRise value
--  evaluateUSOP()                   -                   evaluates and sets the USOP position
--  evaluateUWP()                    -                   evaluates and sets the UWP position
--  showVolFeedback()                -                   draws the element with aid lines
--  unEnhance()                      -                   un enhances the element
--  updateDB()                       -                   creates/updates a stair flight
--  updateDataObj(DBREF)             -
--

-- Define object
define object ASLSTRFLTDATA

  -- public members
  ---------------------------------------------------------------------------
  -- means the vertical clearance
  member .clearance           is REAL

  -- control point (TOP, BOTTOM)
  member .controlPoint        is STRING
  member .drawControlPoint    is BOOLEAN

  -- controls the behaviour of the extension
  member .extensionOption     is STRING

  -- flight thickness
  member .fThickness          is REAL

  -- going
  member .going               is REAL
  member .goingLock           is BOOLEAN

  -- all hand rails of the stair landing
  member .handRaEngines       is ARRAY

  -- reference to the central template for handrails
  member .handRaTmplReference is DBREF

  -- lower cutplane
  member .lCutPlane           is DIRECTION

  -- length
  member .length              is REAL

  -- lower extension
  member .lExtension          is REAL
  member .lExtensionLock      is BOOLEAN

  -- bottom pick type (LINE, PLANE)
  member .lPickType           is STRING

  -- rise of the bottom tread
  member .lRise               is REAL

  -- lower working point
  member .lwp                 is POSITION

   -- overall going
  member .oGoing              is REAL
  member .oGoingLock          is BOOLEAN

  -- overall rise
  member .oRise               is REAL

  -- overlap
  member .overlap             is REAL

  -- angle Data
  member .pitch               is REAL
  member .pitchLock           is BOOLEAN

  -- reference
  member .refe                is DBREF

  -- rise
  member .rise                is REAL
  member .riseLock            is BOOLEAN

  -- link to the uses setting
  member .settingReference    is STRING

  -- reference to the central template for stair flights
  member .strFltTmplReference is DBREF

  -- number of treads
  member .treads              is REAL
  member .treadsLock          is BOOLEAN

  -- upper cutplane
  member .uCutPlane           is DIRECTION

  -- upper extension
  member .uExtension          is REAL
  member .uExtensionLock      is BOOLEAN

  -- top pick type (LINE, PLANE)
  member .uPickType           is STRING

  -- rise of the top tread
  member .uRise               is REAL

  -- upper working point
  member .uwp                 is POSITION

  -- width
  member .width               is REAL

  -- private member
  ---------------------------------------------------------------------------
  -- direction
  member .direction           is DIRECTION

  -- true if an error occurs
  member .error               is BOOLEAN

  -- lower sop
  member .lSOP                is POSITION

  -- controls if the object uses the undo functionality
  member .undoable            is BOOLEAN

  -- upper sop
  member .uSOP                is POSITION

endobject
-- End of object definition for aslStrFltData

------------------------------------------------------------------------
--
-- Method:      aslStrFltData
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrFltData()

  -- initialise
  !this.controlPoint        = 'TOP'
  !this.drawControlPoint    = true
  !this.error               = false
  !this.extensionOption     = 'Upper extension = Lower extension'
  !this.fThickness          = 200mm
  !this.goingLock           = false
  !this.handRaEngines       = object ARRAY()
  !this.lExtension          = 0
  !this.lExtensionLock      = false
  !this.lPickType           = 'PLANE'
  !this.oGoingLock          = false
  !this.overlap             = 0
  !this.pitchLock           = false
  !this.riseLock            = false
  !this.treadsLock          = false
  !this.uExtension          = 0
  !this.uExtensionLock      = false
  !this.undoable            = false
  !this.uPickType           = 'PLANE'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      buildHandras()
--
-- Description: build the handrails
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildHandras()

  do !i index !this.handRaEngines
    !handRaEngine = !this.handRaEngines[!i]
    !handRaEngine.updateDB()
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      buildExtension
--
-- Description: builds the extension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    origin
--    2   R      REAL        length
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildExtension(!position is POSITION, !extension is REAL)

  NEW TREAD
  !!ce.position = !position

  NEW PANE
  NEW PLOO
  !!ce.height = 10mm
  !!ce.sjustification = 'TOP'

  !angle                       = !this.direction.angle(!this.lCutPlane)
  !width                       = !this.width / 2
  !lDistance                   = !angle.tangent() * !width
  !uDistance                   = 0
  !directionOpposite           = !this.direction.opposite()
  !directionOrthogonal         = !this.direction.orthogonal(D)
  !directionOrthogonalOpposite = !directionOrthogonal.opposite()

  -- lower extension
  if ( !position.up.eq(!this.lwp.up) ) then
    NEW PAVE
    !!ce.number   = 1
    !!ce.position = !position.offset(!directionOrthogonal,         !width).offset(!directionOpposite, !lDistance)

    NEW PAVE
    !!ce.number   = 2
    !!ce.position = !position.offset(!directionOrthogonalOpposite, !width).offset(!this.direction,    !lDistance)

    NEW PAVE
    !!ce.number   = 3
    !!ce.position = !position.offset(!directionOrthogonalOpposite, !width).offset(!this.direction,    !extension)

    NEW PAVE
    !!ce.number   = 4
    !!ce.position = !position.offset(!directionOrthogonal,         !width).offset(!this.direction,    !extension)

  -- upper extension
  else
    !angle     = !this.direction.angle(!this.uCutPlane)
    !lDistance = 0
    !uDistance = !angle.tangent() * !width

    NEW PAVE
    !!ce.number  = 1
    !!ce.position = !position.offset(!directionOrthogonal,         !width)

    NEW PAVE
    !!ce.number = 2
    !!ce.position = !position.offset(!directionOrthogonalOpposite, !width)

    NEW PAVE
    !!ce.number = 3
    !!ce.position = !position.offset(!directionOrthogonalOpposite, !width).offset(!this.direction, !extension).offset(!this.direction,    !uDistance)

    NEW PAVE
    !!ce.number = 4
    !!ce.position = !position.offset(!directionOrthogonal,         !width).offset(!this.direction, !extension).offset(!directionOpposite, !uDistance)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      buildTread
--
-- Description:  builds treads
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        number of treads
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildTread(!treadNo is REAL, !position is POSITION)

  NEW TREAD

  -- check if there is a tread in the catalogue
  !collection = object COLLECTION()
  !collection.scope(!this.strFltTmplReference)
  !collection.type('TREAD')
  !allStrTreads = !collection.results()

  -- there is a catalogue element, take it
  if ( !allStrTreads.empty().not() ) then
    -- if there are more than one tread they must alternate
    !size     = !allStrTreads.size()
    !division = !treadNo / !size
    !rounded  = !division.int()
    !index    = !treadNo - !rounded * !size + 1

    COPY $!allStrTreads[$!index]
    !!ce.position = !position

  -- there is none choose the default
  else
    !!ce.position                = !position
    !orthogonalDirection         = !this.direction.orthogonal(U)
    !orthogonalOppositeDirection = !orthogonalDirection.opposite()
    !width                       = !this.width / 2

    NEW PANE
    NEW PLOO
    !!ce.height = 10mm
    !!ce.sjustification = 'TOP'

    NEW PAVE
    !!ce.number  = 1
    !!ce.position = !position.offset(!orthogonalDirection,         !width)

    NEW PAVE
    !!ce.number = 2
    !!ce.position = !position.offset(!orthogonalOppositeDirection, !width)

    NEW PAVE
    !!ce.number = 3
    !!ce.position = !position.offset(!orthogonalOppositeDirection, !width).offset(!this.direction, !this.going + !this.overlap)

    NEW PAVE
    !!ce.number = 4
    !!ce.position = !position.offset(!orthogonalDirection,         !width).offset(!this.direction, !this.going + !this.overlap)
  endif

  TREAD

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deriveData
--
-- Description: evaluates the main data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deriveData()

  !this.evaluateDirection()
  !this.evaluateLSOP()
  !this.evaluateLength()
  !this.evaluateOGoing()
  !this.evaluateORise()
  !this.evaluateUSOP()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .enhance()

  call !!aslEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      erase
--
-- Description: erases all traces
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .erase()

  -- deletes the element
  call !!aslErase(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateDirection
--
-- Description: evaluates and sets the direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateDirection()

  !line           = object LINE(!this.lwp, !this.uwp)
  !orientation    = object ORIENTATION('Z is U')
  !plane          = object PLANE(!this.lwp, !orientation)
  !this.direction = !line.direction().projected(!plane)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLength
--
-- Description: evaluates and sets the length
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateLength()

  !line         = object LINE(!this.lwp, !this.uwp)
  !orientation  = object ORIENTATION('Z is U')
  !plane        = object PLANE(!this.lwp, !orientation)
  !line         = !line.projected(!plane)

  !this.length = !line.length()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLSOP
--
-- Description: evaluates and sets the LSOP position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateLSOP()

  !this.lSOP = !this.lwp.offset(!this.direction, !this.lExtension)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLWP
--
-- Description: evaluates and sets the LWP position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateLWP()

  !this.lwp = !this.uwp.offset(!this.direction.opposite(), !this.length).offset(D, !this.oRise)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateOGoing
--
-- Description: evaluates and sets the OGoing value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateOGoing()

  !this.oGoing = !this.length - !this.lExtension - !this.uExtension

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateORise
--
-- Description: evaluates and sets the oRise value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateORise()

  !this.oRise = !this.uwp.up - !this.lwp.up

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateUSOP
--
-- Description: evaluates and sets the USOP position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateUSOP()

  !this.uSOP = !this.uwp.offset(!this.direction.opposite(), !this.uExtension)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateUWP
--
-- Description: evaluates and sets the UWP position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateUWP()

  !this.uwp = !this.lwp.offset(!this.direction, !this.length).offset(U, !this.oRise)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showVolFeedback
--
-- Description: draws the element with aid lines
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showVolFeedback()

  -- reduces the length of the expression
  !width = !this.width / 2

  -- rise
  ---------------------------------------------------------------------------
  !bLineRise     = !this.lSOP.line(!this.uSOP)
  !bLineRise.draw(!!aslCentralData.aidVolCL, !!aslCentralData.lineStyleDashedThick, !!aslCentralData.colourCL)
  !leftLineRise  = !bLineRise.offset(!this.direction.orthogonal(U), !width)
  !leftLineRise.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  !rightLineRise = !bLineRise.offset(!this.direction.orthogonal(U).opposite(), !width)
  !rightLineRise.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  !orthLineRise1 = !leftLineRise.startPosition.line(!rightLineRise.startPosition)
  !orthLineRise1.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  !orthLineRise2 = !leftLineRise.endPosition.line(!rightLineRise.endPosition)
  !orthLineRise2.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)

  -- cross lines
  !crossLineRise1 = !leftLineRise.startPosition.line(!rightLineRise.endPosition)
  !crossLineRise1.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  !crossLineRise2 = !rightLineRise.startPosition.line(!leftLineRise.endPosition)
  !crossLineRise2.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)

  -- vertical lines
  !verticalLine = !leftLineRise.startPosition.line(!leftLineRise.startPosition.offset(U, !this.clearance))
  !verticalLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  !verticalLine = !leftLineRise.endPosition.line(!leftLineRise.endPosition.offset(U, !this.clearance))
  !verticalLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  !verticalLine = !rightLineRise.startPosition.line(!rightLineRise.startPosition.offset(U, !this.clearance))
  !verticalLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  !verticalLine = !rightLineRise.endPosition.line(!rightLineRise.endPosition.offset(U, !this.clearance))
  !verticalLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)

  -- envelope lines
  !envelopeLineLeft  = !leftLineRise.offset(U, !this.clearance)
  !envelopeLineLeft.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  !envelopeLineRight = !rightLineRise.offset(U, !this.clearance)
  !envelopeLineRight.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  !envelopeLine = !envelopeLineLeft.startPosition.line(!envelopeLineRight.startPosition)
  !envelopeLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  !envelopeLine = !envelopeLineLeft.endPosition.line(!envelopeLineRight.endPosition)
  !envelopeLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)

  -- lower extension
  ---------------------------------------------------------------------------
  !angle     = !this.direction.angle(!this.lCutPlane)
  !lDistance = !width / !angle.cosine()

  !bLineLow     = !this.lwp.line(!this.lSOP)
  if ( !bLineLow.length().gt(1) ) then
    !bLineLow.draw(!!aslCentralData.aidVolCL, !!aslCentralData.lineStyleDashedThick, !!aslCentralData.colourCL)
  endif
  !leftLineLow               = object LINE()
  !leftLineLow.startPosition = !this.lwp.offset(!this.lCutPlane.orthogonal(U), !lDistance)
  !leftLineLow.endPosition   = !this.lSOP.offset(!this.direction.orthogonal(U), !width)
  if ( !leftLineLow.length().gt(1) ) then
    !leftLineLow.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  endif
  !rightLineLow               = object LINE()
  !rightLineLow.startPosition = !this.lwp.offset(!this.lCutPlane.orthogonal(U).opposite(), !lDistance)
  !rightLineLow.endPosition   = !this.lSOP.offset(!this.direction.orthogonal(U).opposite(), !width)
  if ( !rightLineLow.length().gt(1) ) then
    !rightLineLow.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  endif

  -- cross lines
  !crossLineLow1 = !leftLineLow.startPosition.line(!rightLineLow.endPosition)
  if ( !crossLineLow1.length().gt(1) ) then
    !crossLineLow1.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  endif
  !crossLineLow2 = !rightLineLow.startPosition.line(!leftLineLow.endPosition)
  if ( !crossLineLow2.length().gt(1) ) then
    !crossLineLow2.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  endif

  -- vertical lines
  !verticalLineLeft = !leftLineLow.startPosition.line(!leftLineLow.startPosition.offset(U, !this.clearance))
  if ( !verticalLineLeft.length().gt(1) ) then
    !verticalLineLeft.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  endif
  !verticalLineRight = !rightLineLow.startPosition.line(!rightLineLow.startPosition.offset(U, !this.clearance))
  if ( !verticalLineRight.length().gt(1) ) then
    !verticalLineRight.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  endif

  -- envelope lines
  !envelopeLine = !verticalLineLeft.endPosition.line(!verticalLineRight.endPosition)
  if ( !envelopeLine.length().gt(1) ) then
    !envelopeLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  endif
  if ( !leftLineLow.length().gt(1) ) then
    !envelopeLine = !leftLineLow.offset(U, !this.clearance)
    !envelopeLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  endif
  if ( !rightLineLow.length().gt(1) ) then
    !envelopeLine = !rightLineLow.offset(U, !this.clearance)
    !envelopeLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  endif

  -- upper extension
  ---------------------------------------------------------------------------
  !angle     = !this.direction.angle(!this.uCutPlane)
  !uDistance = !width / !angle.cosine()

  !bLineUp     = !this.uwp.line(!this.uSOP)
  if ( !bLineUp.length().gt(1) ) then
    !bLineUp.draw(!!aslCentralData.aidVolCL, !!aslCentralData.lineStyleDashedThick, !!aslCentralData.colourCL)
  endif
  !leftLineUp               = object LINE()
  !leftLineUp.startPosition = !this.uwp.offset(!this.uCutPlane.orthogonal(U), !uDistance)
  !leftLineUp.endPosition   = !this.uSOP.offset(!this.direction.orthogonal(U), !width)
  if ( !leftLineUp.length().gt(1) ) then
    !leftLineUp.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  endif
  !rightLineUp               = object LINE()
  !rightLineUp.startPosition = !this.uwp.offset(!this.uCutPlane.orthogonal(U).opposite(), !uDistance)
  !rightLineUp.endPosition   = !this.uSOP.offset(!this.direction.orthogonal(U).opposite(), !width)
  if ( !rightLineUp.length().gt(1) ) then
    !rightLineUp.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  endif

  -- cross lines
  !crossLineUp1 = !leftLineUp.startPosition.line(!rightLineUp.endPosition)
  if ( !crossLineUp1.length().gt(1) ) then
    !crossLineUp1.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  endif
  !crossLineUp2 = !rightLineUp.startPosition.line(!leftLineUp.endPosition)
  if ( !crossLineUp2.length().gt(1) ) then
    !crossLineUp2.draw(!!aslCentralData.aidVolMain, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourMain)
  endif

  -- vertical lines
  !verticalLineLeft = !leftLineUp.startPosition.line(!leftLineUp.startPosition.offset(U, !this.clearance))
  if ( !verticalLineLeft.length().gt(1) ) then
    !verticalLineLeft.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  endif
  !verticalLineRight = !rightLineUp.startPosition.line(!rightLineUp.startPosition.offset(U, !this.clearance))
  if ( !verticalLineRight.length().gt(1) ) then
    !verticalLineRight.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  endif

  -- envelope lines
  !envelopeLine = !verticalLineLeft.endPosition.line(!verticalLineRight.endPosition)
  if ( !envelopeLine.length().gt(1) ) then
    !envelopeLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  endif
  if ( !leftLineUp.length().gt(1) ) then
    !envelopeLine = !leftLineUp.offset(U, !this.clearance)
    !envelopeLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  endif
  if ( !rightLineUp.length().gt(1) ) then
    !envelopeLine = !rightLineUp.offset(U, !this.clearance)
    !envelopeLine.draw(!!aslCentralData.aidVolEnvelope, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourEnvelope)
  endif

  -- control point
  ---------------------------------------------------------------------------
  if ( !this.drawControlPoint ) then
    if ( !this.controlPoint.eq('TOP') ) then
      !position = !this.uwp
    else
      !position = !this.lwp
    endif
    AID SPHERE NUMBER $!!<aslCentralData.aidVolWorkingPoint> $!position DIAM 250mm
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      unEnhance
--
-- Description: un enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .unEnhance()

  call !!aslUnEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: creates/updates a stair flight
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDB()

  -- create undo mark
  if ( !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update stair flight')
    !undo.add()
  endif

--  if(!!aslStoreTable.getStore('stairFlight').unset() or !!aslStoreTable.getStore('stairFlight').badref())then
--    !!alert.error('Storage area is not set. Stair Flight is generated under the current element.')
--  else
--    !!ce = !!aslStoreTable.getStore('stairFlight')
--  endif

  -- creates/updates the owner element
  !this.refe = !!aslCreate('STRFLT', !this.refe)

  -- flight attributes
  ---------------------------------------------------------------------------
  !!ce.pos           = !this.lSOP
  !!ce.fltDirection  = !this.direction
  !!ce.oRise         = !this.oRise
  !!ce.oGoing        = !this.oGoing
  !!ce.tWidth        = !this.width
  !!ce.rise          = !this.rise
  !!ce.lRise         = !this.lRise
  !!ce.headRoom      = !this.clearance
  !!ce.uExtnsion     = !this.uExtension
  !!ce.lExtnsion     = !this.lExtension
  !!ce.uCutDirection = !this.uCutPlane
  !!ce.lCutDirection = !this.lCutPlane
  !!ce.fThickness    = !this.fThickness


--TODO must be replaced by correct attributes
  !!ce.description   = !this.strFltTmplReference.string() & ' ' & !this.settingReference
  !!ce.function      = ''
  handle ANY
  endhandle

  -- treads
  ---------------------------------------------------------------------------

  -- check if there is a tread in the catalogue, if not do not create the treads
  !collection = object COLLECTION()
  !collection.scope(!this.strFltTmplReference)
  !collection.type('TREAD')
  !allStrTreads = !collection.results()
  if ( !allStrTreads.empty() ) then
    !collection.scope(!!ce)
    !collection.addType('TREADSET')
    !allTreads = !collection.results()
    do !tread value !allTreads
      !!ce = !tread
      handle ANY
        skip
      endhandle
      DELETE $!!ce.type
    enddo

  --catalogue requires detailed elements
  else

    NEW TREADSET

    -- handles the upper extension
    if ( !this.uExtension.between(0, 0.01) ) then
      !maxTreads = !this.treads - 1
    else
      !maxTreads = !this.treads
    endif

    do !treadNo from 1 to !maxTreads
      -- bottom and top tread rise might be different
      if ( !treadNo.eq(1) ) then
        !elevation = !this.lRise
      elseif ( !treadNo.lt(!this.treads - 1) ) then
        !elevation = !this.lRise + !this.rise * (!treadNo - 1)
      else
        !elevation = !this.lRise + !this.rise * (!treadNo - 2) + !this.uRise
      endif
      !position = !this.lSOP.offset(!this.direction, !this.going * !treadNo).offset(U, !elevation)

      !this.buildTread(!treadNo, !position)
    enddo

    -- lower extension
    if ( !this.lPickType.neq('PLANE') ) then
      !this.buildExtension(!this.lwp, !this.lExtension + !this.going + !this.overlap)
    endif

    -- upper extension
    if ( !this.uPickType.neq('PLANE') ) then
      !this.buildExtension(!this.uSOP, !this.uExtension)
    endif
  endif

  -- stringer
  ---------------------------------------------------------------------------

  -- check if there is a tread in the catalogue, if not do not create the treads
  !collection = object COLLECTION()
  !collection.scope(!this.strFltTmplReference)
  !collection.type('STRSTR')
  !allStrStrs = !collection.results()
  if ( !allStrStrs.empty() ) then
    !collection.scope(!!ce)
    !allStrs = !collection.results()
    do !strStr value !allStrs
      !!ce = !strStr
      handle ANY
        skip
      endhandle
      DELETE $!!ce.type
    enddo

  --catalogue requires detailed elements
  else
    do !strStr value !allStrStrs
      NEW STRSTR COPY $!strStr
    enddo
  endif


  -- handrail
  ---------------------------------------------------------------------------
  !this.buildHandras()
--  -- check if there is a tread in the catalogue, if not do not create the treads
--  !collection = object COLLECTION()
--  !collection.scope(!this.handRaTmplReference)
--  !collection.type('HANDRA')
--  !allHandrails = !collection.results()
--
--  if ( !allHandrails.empty() ) then
--    !collection.scope(!!ce)
--    !allHandrails = !collection.results()
--    do !handrail value !allHandrails
--      !!ce = !handrail
--      handle ANY
--        skip
--      endhandle
--      DELETE $!!ce.type
--    enddo
--
--  --catalogue requires detailed elements
--  else
--    do !handrail value !allHandrails
--      NEW HANDRA
--      DELETE HANDRA MEM
--      COPY $!handrail
--    enddo
--  endif


  !!ce     = !this.refe
  --RULE REXE


  -- end undo mark
  if ( !this.undoable ) then
    !undo.endUndoable()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateObj
--
-- Description: creates/updates the STRFLTDATA object for the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        reference element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  -- flight attributes
  !this.refe        = !refe
  !this.direction   = !this.refe.fltDirection
  !this.oRise       = !this.refe.oRise
  !this.oGoing      = !this.refe.oGoing
  !this.uExtension  = !this.refe.uExtnsion
  !this.lExtension  = !this.refe.lExtnsion
  !this.lSOP        = !this.refe.pos
  !this.lwp         = !this.lSOP.offset(!this.direction.opposite(), !this.lExtension)
  !this.uSOP        = !this.lSOP.offset(!this.direction, !this.oGoing).offset(U, !this.oRise)
  !this.uwp         = !this.uSOP.offset(!this.direction, !this.uExtension)
  !this.width       = !this.refe.tWidth
  !this.rise        = !this.refe.rise
  !this.lRise       = !this.refe.lRise
  !this.uRise       = !this.refe.uRise
  !this.clearance   = !this.refe.headRoom
  !this.uCutPlane   = !this.refe.uCutDirection
  !this.lCutPlane   = !this.refe.lCutDirection
  !this.fThickness  = !this.refe.fThickness
  !this.treads      = !this.refe.treadsNumber
  !this.going       = !this.refe.going
  !this.pitch       = !this.refe.pitch

  -- calculated members
  !lPlane           = object PLANE(!this.lwp, Y IS N AND Z IS U)
  !this.length      = !this.lwp.distance(!lPlane.near(!this.uwp))

--TODO must come from different attributes, or from the associations
  !this.strFltTmplReference = object DBREF(!this.refe.description.before(' '))
  !this.settingReference    = !this.refe.description.after(' ')
  !this.uPickType           = 'LINE'
  !this.lPickType           = 'LINE'

endmethod
-- End of method
