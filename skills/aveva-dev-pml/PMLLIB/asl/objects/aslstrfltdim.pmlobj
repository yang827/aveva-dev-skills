--
--
-- Description:     container for STRFLT dimension data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrfltDim()                   -                   default constructor
--

-- Define object
define object ASLSTRFLTDIM

  -- overall length
  member .length              is BOOLEAN

  -- overall height
  member .height              is BOOLEAN

  -- flight width
  member .width               is BOOLEAN

  -- flight thickness
  member .fThickness          is BOOLEAN

  -- Head Room (vertical clearance)
  member .headRoom            is BOOLEAN

  -- lower extension
  member .lExtension          is BOOLEAN

  -- upper extension
  member .uExtension          is BOOLEAN

  -- Lower Landing Length
  member .lLndgLength          is BOOLEAN

  -- Upper Landing Length
  member .uLndgLength          is BOOLEAN

  -- overall going
  member .oGoing              is BOOLEAN

  -- overall rise
  member .oRise               is BOOLEAN

  -- going
  member .going               is BOOLEAN

  -- rise
  member .rise                is BOOLEAN

  -- rise of the bottom tread
  member .lRise               is BOOLEAN

  -- angle Data
  member .pitch               is BOOLEAN

endobject
-- End of object definition for aslStrfltDim

------------------------------------------------------------------------
--
-- Method:      aslStrfltDim
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrfltDim()

  !this.length      = false
  !this.height      = false
  !this.width       = false
  !this.fThickness  = false
  !this.headRoom    = false

  !this.lExtension  = false
  !this.uExtension  = false

  !this.oGoing      = false
  !this.oRise       = false
  !this.going       = false
  !this.rise        = false
  !this.lRise       = false
  !this.pitch       = false

endmethod
-- End of method
