-- Method:      setControlPoint
--
-- Description: sets the keyword for the position of the control point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      keyword for the position of the control point
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setControlPoint(!controlPoint is STRING)

  !this.strFltData.controlPoint = !controlPoint

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setExtensionOption
--
-- Description: sets the extension option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      extension option
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setExtensionOption(!extensionOption is STRING)

  !this.strFltData.extensionOption = !extensionOption

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setExtensions
--
-- Description: set the values for the extension of the stair flight
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setExtensions()

  !extensionOption = !this.strFltData.extensionOption

  -- handles plane connections
  if ( !this.strFltData.lPickType.eq('PLANE') or  $
       !this.strFltData.uPickType.eq('PLANE') ) then
    if ( !extensionOption.eq('User defined') ) then
      if ( !this.strFltData.lPickType.eq('PLANE') ) then
        !this.strFltData.lExtension = 0
      elseif ( !this.strFltData.uPickType.eq('PLANE') ) then
        !this.strFltData.uExtension = 0
      endif
    else
      !this.strFltData.lExtension = 0
      !this.strFltData.uExtension = 0
    endif
    !this.strFltData.length     = !this.strFltData.oGoing + !this.strFltData.lExtension + !this.strFltData.uExtension
    if ( !this.strFltData.lPickType.neq('PLANE') ) then
      !this.strFltData.controlPoint = 'BOTTOM'
    elseif ( !this.strFltData.uPickType.neq('PLANE') ) then
      !this.strFltData.controlPoint = 'TOP'
    endif
    if ( !this.strFltData.controlPoint.eq('TOP') ) then
      !this.strFltData.evaluateLWP()
    else
      !this.strFltData.evaluateUWP()
    endif
    !this.strFltData.deriveData()

  --
  else
    if ( !extensionOption.eq('Upper extension = minimum') ) then
      !this.strFltData.uExtension = !this.getExtensionDifference(!this.strFltData.direction.opposite(), !this.strFltData.uCutPlane)
      !this.strFltData.lExtension = !this.strFltData.length - !this.strFltData.oGoing - !this.strFltData.uExtension

    elseif ( !extensionOption.eq('Lower extension = minimum') ) then
      !this.strFltData.lExtension = !this.getExtensionDifference(!this.strFltData.direction, !this.strFltData.lCutPlane)
      !this.strFltData.uExtension = !this.strFltData.length - !this.strFltData.oGoing - !this.strFltData.lExtension

    elseif ( !extensionOption.eq('Upper extension = Lower extension') ) then
      !this.strFltData.lExtension = (!this.strFltData.length - !this.strFltData.oGoing) / 2
      !this.strFltData.uExtension = !this.strFltData.lExtension

    elseif ( !extensionOption.eq('User defined') ) then
      if ( !this.strFltData.lExtensionLock ) then
        !this.strFltData.uExtension = !this.strFltData.length - !this.strFltData.oGoing - !this.strFltData.lExtension
      elseif ( !this.strFltData.uExtensionLock ) then
        !this.strFltData.lExtension = !this.strFltData.length - !this.strFltData.oGoing - !this.strFltData.uExtension
      else
        !this.strFltData.lExtension = (!this.strFltData.length - !this.strFltData.oGoing) / 2
        !this.strFltData.uExtension = !this.strFltData.lExtension
      endif
    endif
  endif

endmethod
-- End of method

