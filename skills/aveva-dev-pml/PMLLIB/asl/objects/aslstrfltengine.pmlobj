endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getValidTreads
--
-- Description: returns a set of valids
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY      number of treads
------------------------------------------------------------------------

define method .getValidTreads() is ARRAY

  -- make all valid tread numbers unique
  !treadNos = !this.tTreads
  !treadNos.unique()

  return !treadNos

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isValid
--
-- Description: checks if the data of the dataset are valid
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        going
--    2   R      REAL        oGoing
--    3   R      REAL        pitch
--    4   R      REAL        rise
--    5   R      REAL        number of treads
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     result of the data check
------------------------------------------------------------------------

define method .isValid(!going is REAL, !oGoing is REAL, !pitch is REAL, !rise is REAL, !treads is REAL) is BOOLEAN

  -- reduce the expression length
  !criteria = !this.strFltCriteria

  -- evaluates the relation value of the rise and going relationship
  !expression = object BLOCK(!criteria.relationship.value[1])
  !relation   = !expression.evaluate()

  -- evaluates the difference of oRise
  !oRise           = !rise * !treads
  !oRiseDifference = ABS(!this.strFltData.oRise - !oRise)

  -- evaluates the max possible rise tolerance
  !riseTolerance = !this.strFltCriteria.lRise.getTolerance() + !this.strFltCriteria.uRise.getTolerance()

  -- check the limits of the different values
  !isValid = !oRiseDifference.leq(!riseTolerance)                         and $
             !going.between(!criteria.going.min, !criteria.going.max)     and $
             !oGoing.between(!criteria.oGoing.min, !criteria.oGoing.max)  and $
             !pitch.between(!criteria.pitch.min, !criteria.pitch.max)     and $
             !rise.between(!criteria.rise.min, !criteria.rise.max)        and $
             !treads.between(!criteria.treads.min, !criteria.treads.max)  and $
             !relation.between(!criteria.relationship.min, !criteria.relationship.max)

  return !isValid

endmethod
-- End of method

