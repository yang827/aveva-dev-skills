------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrFltEngine()                -                   Constructor
--  aslStrFltEngine(ASLSTRFLTDATA)   -                   Constructor
--  enhance()                        -                   enhances the element
--  erase()                          -                   erases all traces
--  evaluate()                       -                   evaluates a valid stair flight
--  evaluateClearance()              -                   evaluates the clearance depends on the criteria and the pitch
--  evaluateDifference(REAL,REAL)    REAL                evaluates the differences between the first given value and the second given value
--  evaluateHandRa()                 -                   evaluates handrail elements
--  evaluateTable()                  -                   evaluates a table of values and some values for the ranking of the values
--  getClearance()                   REAL                returns the clearance
--  getControlPoint()                STRING              returns the keyword for the position
--  getError()                       BOOLEAN             returns the error status
--  getExtensionDifference(DIRECTION,DIRECTION) REAL                gets the difference of the extension for none orthogonal extensions
--  getExtensionOption()             STRING              returns the extension option
--  getGoing()                       REAL                returns the going
--  getHandRaTmplReference()         STRING              returns the template for the handrail
--  getLCutPlane()                   DIRECTION           returns the direction of the lower cutplane
--  getLExtension()                  REAL                returns the lower extension
--  getLRise()                       REAL                returns the lrise
--  getLock(STRING)                  BOOLEAN             returns the lock flag value
--  getOGoing()                      REAL                returns the overall going
--  getORise()                       REAL                returns the overall rise
--  getOptima()                      ARRAY               returns a set of optimal combination
--  getOptimumPitch()                REAL                returns the optimum pitch
--  getPitch()                       REAL                returns the pitch
--  getRange(ARRAY)                  ARRAY               evaluates the largest and the smallest value for the given array
--  getRise()                        REAL                returns the rise
--  getRise(REAL,REAL)               REAL                evaluates the rise according to the tolerance
--  getSettingReference()            STRING              returns the setting
--  getStrFltTmplReference()         STRING              returns the template for the stair flight
--  getTreads()                      REAL                returns the treads
--  getUCutPlane()                   DIRECTION           returns the direction of the upper cutplane
--  getUExtension()                  REAL                returns the upper extension
--  getURise()                       REAL                returns the urise
--  getValidTreads()                 ARRAY               returns a set of valids
--  getWidth()                       REAL                returns the width
--  isValid(REAL,REAL,REAL,REAL,REAL) BOOLEAN             checks if the data of the dataset are valid
--  resetError()                     -                   resets error status
--  setControlPoint(STRING)          -                   sets the keyword for the position of the control point
--  setExtensionOption(STRING)       -                   sets the extension option
--  setExtensions()                  -                   set the values for the extension of the stair flight
--  setGoing(REAL)                   -                   sets the going
--  setLExtension(REAL)              -                   sets the lower extension
--  setLPickType(STRING)             -                   sets the lower pick type
--  setLRise(REAL)                   -                   sets the lrise
--  setLock(STRING,BOOLEAN)          -                   sets the lock flag value
--  setOGoing(REAL)                  -                   sets the overall going
--  setPitch(REAL)                   -                   sets the pitch
--  setRise(REAL)                    -                   sets the rise
--  setRises()                       -                   sets the values for bottom rise and top rise
--  setSegmentIdx(REAL)              -                   sets the segment index
--  setSettingReference(STRING)      -                   sets the setting
--  setTmplReferences(DBREF,DBREF)   -                   sets the templates
--  setTreads(REAL)                  -                   sets the treads
--  setUExtension(REAL)              -                   sets the upper extension
--  setUPickType(STRING)             -                   sets the upper pick type
--  setURise(REAL)                   -                   sets the urise
--  setWidth(REAL)                   -                   sets the width
--  showVolFeedback()                -                   draws the element with aid lines
--  sortTable(STRING)                -                   sorts the ranking table
--  unEnhance()                      -                   unenhances the element
--  updateDB()                       -                   creates/updates a stair flight
--  useOptimum()                     -                   use the optimum value
--

define object ASLSTRFLTENGINE

  -- public members
  ---------------------------------------------------------------------------
  -- container for the stair flight data
  member .strFltData                     is ASLSTRFLTDATA

  -- private members
  ---------------------------------------------------------------------------
  -- contains the criteria set for handrail elements (including fabricator standard)
  member .handRaCriteria                 is ASLHANDRACRITERIA

  -- contains the criteria set for handrail elements (excluding fabricator standard)
  member .handRaCriteriaBasis            is ASLHANDRACRITERIA

  -- contains a copy of stair flight data before modify
  member .strFltDataOld                  is ASLSTRFLTDATA

  -- contains the criteria set for stair flight elements (including fabricator standard)
  member .strFltCriteria                 is ASLSTRFLTCRITERIA

  -- contains the criteria set for stair flight elements (excluding fabricator standard)
  member .strFltCriteriaBasis            is ASLSTRFLTCRITERIA

  -- values
  member .tGoing                         is ARRAY
  member .tOGoing                        is ARRAY
  member .tPitch                         is ARRAY
  member .tRelationship                  is ARRAY
  member .uRise                          is ARRAY
  member .tTreads                        is ARRAY

  -- difference from optimum
  member .tGoingDifferenceOptimum        is ARRAY
  member .tOGoingDifferenceOptimum       is ARRAY
  member .tPitchDifferenceOptimum        is ARRAY
  member .tRelationshipDifferenceOptimum is ARRAY
  member .uRiseDifferenceOptimum         is ARRAY
  member .tTreadsDifferenceOptimum       is ARRAY

endobject
-- End of object definition for aslStrFltEngine

------------------------------------------------------------------------
--
-- Method:      aslStrFltEngine
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrFltEngine()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aslStrFltEngine
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLSTRFLTDATA stair flight object
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrFltEngine(!strFltData is ASLSTRFLTDATA)

  -- assigns an existing stair flight
  !this.strFltData = !strFltData

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .enhance()

  !this.strFltData.enhance()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      erase
--
-- Description: erases all traces
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .erase()

  !this.strFltData.erase()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluate
--
-- Description: evaluates a valid stair flight
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluate()

  -- reduces size of expressions
  !oRise      = !this.strFltData.oRise
  !criteria   = !this.strFltCriteria
  !expression = object BLOCK(!criteria.relationship.value[1])

  -- locked value at least for going and oGoing
  ---------------------------------------------------------------------------
  if ( !this.strFltData.goingLock and $
       !this.strFltData.oGoingLock ) then
    -- assign
    !going  = !this.strFltData.going
    !oGoing = !this.strFltData.oGoing

    -- calculates
    !pitch  = ATAN(!oRise / !oGoing)
    !treads = !oGoing / !going
    !rise   = !this.getRise(!oRise / !treads, !treads)

    -- sets the data check marker
    !dataCheckOK = !this.isValid(!going, !oGoing, !pitch, !rise, !treads)

  -- locked value at least for going and pitch
  ---------------------------------------------------------------------------
  elseif ( !this.strFltData.goingLock and $
           !this.strFltData.pitchLock ) then
    --assign
    !going  = !this.strFltData.going
    !pitch  = !this.strFltData.pitch

    -- calculates
    !oGoing = !oRise / !pitch.tangent()
    !treads = !oGoing / !going
    !rise   = !this.getRise(!oRise / !treads, !treads)

    -- sets the data check marker
    !dataCheckOK = !this.isValid(!going, !oGoing, !pitch, !rise, !treads)

  -- locked value at least for going and rise
  ---------------------------------------------------------------------------
  elseif ( !this.strFltData.goingLock and $
           !this.strFltData.riseLock ) then
    -- assign
    !going  = !this.strFltData.going
    !rise   = !this.strFltData.rise

    -- calculates
    !treads = NINT(!oRise / !rise)
    !oGoing = !going * !treads
    !pitch  = ATAN(!oRise / !oGoing)

    -- sets the data check marker
    !dataCheckOK = !this.isValid(!going, !oGoing, !pitch, !rise, !treads)

  -- locked value at least for going and treads
  ---------------------------------------------------------------------------
  elseif ( !this.strFltData.goingLock and $
           !this.strFltData.treadsLock ) then
    -- assign
    !going  = !this.strFltData.going
    !treads = !this.strFltData.treads

    -- calculates
    !oGoing = !going * !treads
    !pitch  = ATAN(!oRise / !oGoing)
    !rise   = !this.getRise(!oRise / !treads, !treads)

    -- sets the data check marker
    !dataCheckOK = !this.isValid(!going, !oGoing, !pitch, !rise, !treads)

  -- locked value at least for oGoing and rise
  ---------------------------------------------------------------------------
  elseif ( !this.strFltData.oGoingLock and $
           !this.strFltData.riseLock ) then
    -- assign
    !rise   = !this.strFltData.rise
    !oGoing = !this.strFltData.oGoing

    -- calculates
    !treads = NINT(!oRise / !rise)
    !going  = !oGoing / !treads
    !pitch  = ATAN(!oRise / !oGoing)

    -- sets the data check marker
    !dataCheckOK = !this.isValid(!going, !oGoing, !pitch, !rise, !treads)

  -- locked value at least for oGoing and treads
  ---------------------------------------------------------------------------
  elseif ( !this.strFltData.oGoingLock and $
           !this.strFltData.treadsLock ) then
    -- assign
    !oGoing = !this.strFltData.oGoing
    !treads = !this.strFltData.treads

    -- calculates
    !pitch  = ATAN(!oRise / !oGoing)
    !going  = !oGoing / !treads
    !rise   = !this.getRise(!oRise / !treads, !treads)

    -- sets the data check marker
    !dataCheckOK = !this.isValid(!going, !oGoing, !pitch, !rise, !treads)

  -- locked value at least for pitch and rise
  ---------------------------------------------------------------------------
  elseif ( !this.strFltData.pitchLock and $
           !this.strFltData.riseLock ) then
    -- assign
    !pitch  = !this.strFltData.pitch
    !rise   = !this.strFltData.rise

    -- calculates
    !treads = NINT(!oRise / !rise)
    !oGoing = !oRise / !pitch.tangent()
    !going  = !oGoing / !treads

    -- sets the data check marker
    !dataCheckOK = !this.isValid(!going, !oGoing, !pitch, !rise, !treads)

  -- locked value at least for oGoing and pitch
  ---------------------------------------------------------------------------
  elseif ( !this.strFltData.oGoingLock and $
           !this.strFltData.pitchLock ) then
    -- assign
    !oGoing   = !this.strFltData.oGoing
    !pitch    = !this.strFltData.pitch

    -- evaluates the limits of the loop
    !treadss  = !this.tTreads.sort()
    !minTread = !treadss.first()
    !maxTread = !treadss.last()

    -- inits
    !dataCheckOK = false
    !tGoing      = object ARRAY()
    !tRelation   = object ARRAY()
    !uRise       = object ARRAY()
    !tTreads     = object ARRAY()

    do !treads from !minTread to !maxTread
      -- calculates
      !going  = !oGoing / !treads
      !rise   = !this.getRise(!oRise / !treads, !treads)

      -- checks the validity of the values
      skip if ( !this.isValid(!going, !oGoing, !pitch, !rise, !treads).not() )

      -- evaluates the relation value of the rise and going relationship
      !relation   = !expression.evaluate()

      -- stores the values
      !tGoing.append(!going)
      !tRelation.append(!relation)
      !uRise.append(!rise)
      !tTreads.append(!treads)
    enddo

    -- no valid values found
    if ( !tRelation.empty() ) then
      -- sets the check marker
      !dataCheckOK = false
      !treads      = -1
      !rise        = -1
      !going       = -1

    -- gets the values with the best relationship value
    else
      -- sets the check marker
      !dataCheckOK = true

      -- evaluates and sets the best values
      !sortedIndices = !tRelation.sortedIndices()
      !tGoing.reIndex(!sortedIndices)
      !uRise.reIndex(!sortedIndices)
      !tTreads.reIndex(!sortedIndices)
      !going         = !tGoing.first()
      !rise          = !uRise.first()
      !treads        = !tTreads.first()
    endif

  -- locked value at least for rise and treads
  ---------------------------------------------------------------------------
  elseif ( !this.strFltData.riseLock and $
           !this.strFltData.treadsLock ) then
    -- assign
    !treads   = !this.strFltData.treads
    !rise     = !this.strFltData.rise

    --evaluates the min pitch from table for the loop
    !pitches  = !this.tPitch.sort()
    !minPitch = !pitches.first().int()
    !maxPitch = INT(!pitches.last() + 1)

    -- inits
    !dataCheckOK = false
    !tGoing      = object ARRAY()
    !tOGoing     = object ARRAY()
    !tPitch      = object ARRAY()
    !tRelation   = object ARRAY()

    -- handles all possible pitches
    do !pitch from !minPitch to !maxPitch by 0.1
      -- calculates
      !oGoing = !oRise / !pitch.tangent()
      !going  = !oGoing / !treads

      -- checks the validity of the values
      skip if ( !this.isValid(!going, !oGoing, !pitch, !rise, !treads).not() )

      -- evaluates the relation value of the rise and going relationship
      !relation   = !expression.evaluate()

      -- stores the values
      !tGoing.append(!going)
      !tOGoing.append(!oGoing)
      !tPitch.append(!pitch)
      !tRelation.append(!relation)
    enddo

    -- no valid values found
    if ( !tRelation.empty() ) then
      -- sets the check marker
      !dataCheckOK = false
      !pitch       = -1
      !oGoing      = -1
      !going       = -1

    -- gets the values with the best relationship value
    else
      -- sets the check marker
      !dataCheckOK   = true

      -- evaluates and sets the best values
      !sortedIndices = !tRelation.sortedIndices()
      !tGoing.reIndex(!sortedIndices)
      !tOGoing.reIndex(!sortedIndices)
      !tPitch.reIndex(!sortedIndices)
      !going  = !tGoing.first()
      !oGoing = !tOGoing.first()
      !pitch  = !tPitch.first()
    endif

  -- locked value at least for oGoing and pitch
  ---------------------------------------------------------------------------
  elseif ( !this.strFltData.oGoingLock and $
           !this.strFltData.pitchLock ) then
    -- assign
    !oGoing   = !this.strFltData.oGoing
    !pitch    = !this.strFltData.pitch

    -- evaluates the min and max number of treads for the loop
    !treadss  = !this.tTreads.sort()
    !minTread = !treadss.first()
    !maxTread = !treadss.last()

    -- inits
    !dataCheckOK = false
    !tGoing      = object ARRAY()
    !tRelation   = object ARRAY()
    !uRise       = object ARRAY()
    !tTreads     = object ARRAY()

    -- handles all possible number of treads
    do !treads from !minTread to !maxTread
      -- calculates
      !going  = !oGoing / !treads
      !rise   = !this.getRise(!this.strFltData.rise / !treads, !treads)

      -- checks the validity of the values
      skip if ( !this.isValid(!going, !oGoing, !pitch, !rise, !treads).not() )

      -- evaluates the relation value of the rise and going relationship
      !relation   = !expression.evaluate()

      -- stores the values
      !tGoing.append(!going)
      !tRelation.append(!relation)
      !uRise.append(!rise)
      !tTreads.append(!treads)
    enddo

    -- no valid values found
    if ( !tRelation.empty() ) then
      -- sets the check marker
      !dataCheckOK = false
      !going       = -1
      !rise        = -1
      !treads      = -1

    -- gets the values with the best relationship value
    else
      -- sets the check marker
      !dataCheckOK   = true

      -- evaluates and sets the best values
      !sortedIndices = !tRelation.sortedIndices()
      !tGoing.reIndex(!sortedIndices)
      !uRise.reIndex(!sortedIndices)
      !tTreads.reIndex(!sortedIndices)
      !going  = !tGoing.first()
      !rise   = !uRise.first()
      !treads = !tTreads.first()
    endif

  -- locked value for going
  ---------------------------------------------------------------------------
  elseif ( !this.strFltData.goingLock ) then
    -- assign
    !going  = !this.strFltData.going
    !treads = !this.strFltData.treads

    -- calculates
    !oGoing = !going * !treads
    !pitch  = ATAN(!oRise / !oGoing)
    !rise   = !this.getRise(!oRise / !treads, !treads)

    -- sets the data check marker
    !dataCheckOK = !this.isValid(!going, !oGoing, !pitch, !rise, !treads)

  -- locked value for oGoing
  elseif ( !this.strFltData.oGoingLock ) then
    -- assign
    !oGoing = !this.strFltData.oGoing
    !treads = !this.strFltData.treads

    -- calculates
    !rise   = !this.getRise(!oRise / !treads, !treads)
    !going  = !oGoing / treads
    !pitch  = ATAN(!oRise / !oGoing)

    -- sets the data check marker
    !dataCheckOK = !this.isValid(!going, !oGoing, !pitch, !rise, !treads)

  -- locked value for rise
  elseif ( !this.strFltData.riseLock ) then
    -- assign
    !rise   = !this.strFltData.rise
    !oGoing = !this.strFltData.oGoing

    -- calculates
    !treads = NINT(!oRise / !rise)
    !pitch  = ATAN(!oRise / !oGoing)
    !going  = !oGoing / !treads

    -- sets the data check marker
    !dataCheckOK = !this.isValid(!going, !oGoing, !pitch, !rise, !treads)

  -- no locked values
  ---------------------------------------------------------------------------
  else

    !validMatches = !this.tGoing.indices()

    -- looking for lock attributes
    do !attributeName value !this.strFltData.attributes()

      -- ignores all none look attributes
      skip if ( !attributeName.matchwild('*LOCK').not() )

      -- ignores lock attributes with value false
      skip if ( !this.strFltData.attribute(!attributeName).not() )

      -- evaluates the name of the column
      !columnName = 'T' & !attributeName.before('LOCK')

      -- checks if a column with this name exists
      skip if ( !this.attributes().findFirst(!columnName).set().not() )

      -- evaluates the value of the attribute
      !attVal = !this.strFltData.attribute(!attributeName.before('LOCK'))

      -- evaluates all valid lines
      !matches = !this.attribute(!columnName).find(!attVal)

      -- intersection
      !validMatches = !validMatches.intersect(!matches)
    enddo

    -- inform the user of the status
    if ( !validMatches.empty() ) then
      !this.strFltData       = !this.strFltDataOld
      !this.strFltData.error = true
      return
    endif

    -- assign value
    ---------------------------------------------------------------------------
    !i      = !validMatches.first()
    !going  = !this.tGoing[!i]
    !oGoing = !this.tOGoing[!i]
    !pitch  = !this.tPitch[!i]
    !rise   = !this.uRise[!i]
    !treads = !this.tTreads[!i]

    -- sets the data check marker
    !dataCheckOK = true
  endif

  -- check locked values
  ---------------------------------------------------------------------------
  if ( !this.strFltData.goingLock           and $
       !this.strFltData.going.neq(!going)   or  $
       !this.strFltData.oGoingLock          and $
       !this.strFltData.oGoing.neq(!oGoing) or  $
       !this.strFltData.pitchLock           and $
       !this.strFltData.pitch.neq(!pitch)   or  $
       !this.strFltData.riseLock            and $
       !this.strFltData.rise.neq(!rise)     or  $
       !this.strFltData.treadsLock          and $
       !this.strFltData.treads.neq(!treads) or $
       !dataCheckOK.not() ) then
      !this.strFltData       = !this.strFltDataOld
      !this.strFltData.error = true
      return
  endif


  -- assign value
  ---------------------------------------------------------------------------
  !this.strFltData.going  = !going
  !this.strFltData.oGoing = !oGoing
  !this.strFltData.pitch  = !pitch
  !this.strFltData.rise   = !rise
  !this.strFltData.treads = !treads

  -- sets the values for top and bottom rise
  !this.setRises()

  -- handles the different types of extensions
  !this.setExtensions()


  !this.strFltData.evaluateLSOP()
  !this.strFltData.evaluateUSOP()
  !this.evaluateClearance()

  -- Synchronize original and copy
  !this.strFltDataOld = !this.strFltData

  !this.strFltData.error = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateClearance
--
-- Description: evaluates the clearance depends on the criteria and the pitch
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateClearance()

  -- sets a default value
  if ( !this.strFltData.pitch.unset() ) then
    !this.strFltData.pitch = 40
  endif

  -- get the vertical clearance from the sloped value
--TODO: where is the limit for slopeClearance and slopeClearanceShort
  if ( !this.strFltData.treads.set() and $
       !this.strFltData.treads.leq(4) ) then
    !verticalFromSloped = !this.strFltCriteria.slopeClearanceShort.min / !this.strFltData.pitch.cosine()
  else
    !verticalFromSloped = !this.strFltCriteria.slopeClearance.min      / !this.strFltData.pitch.cosine()
  endif

  -- take the maximum of the clearances
  !this.strFltData.clearance = !this.strFltCriteria.verticalClearance.min.max(!verticalFromSloped)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateDifference
--
-- Description: evaluates the differences between the first given value and the second given value
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        value
--    2   R      REAL        reference value
-- Return:
--   [Data Type] [Description]
--    REAL        difference between both parameter
------------------------------------------------------------------------

define method .evaluateDifference(!value is REAL, !referenceValue is REAL) is REAL

  if ( !referenceValue.set() ) then
    !difference = !referenceValue - !value
    return !difference.abs()
  else
    return 0
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateHandRa
--
-- Description: evaluates handrail elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateHandRa()

  -- get the values of the platform
  !strFltPos   = !this.strFltData.lWP
  !strFltOri   = object ORIENTATION('Y IS ' & !this.strFltData.direction & ' AND Z IS U')
  !strFltOrtho = !this.strFltData.direction.orthogonal(U)
  !strFltWidth = !this.strFltData.width / 2

  !lAngle      = !this.strFltData.direction.angle(!this.strFltData.lCutPlane)
  !ldistance   = !strFltWidth / !lAngle.cosine()
  !uAngle      = !this.strFltData.direction.angle(!this.strFltData.uCutPlane)
  !udistance   = !strFltWidth / !uAngle.cosine()

  ---------------------------------------------------------------------------
  -- left handrail
  !leftHandRailVertices = object ARRAY()
  !leftHandRailVertices.append(!this.strFltData.lWP.offset(!this.strFltData.lCutPlane.orthogonal(U), !ldistance))
  !leftHandRailVertices.append(!this.strFltData.lSOP.offset(!strFltOrtho, !strFltWidth))
  !leftHandRailVertices.append(!this.strFltData.uSOP.offset(!strFltOrtho, !strFltWidth))
  !leftHandRailVertices.append(!this.strFltData.uWP.offset(!this.strFltData.uCutPlane.orthogonal(U), !udistance))
  !leftHandRailVertices.compress()

  ---------------------------------------------------------------------------
  -- right handrail
  !rightHandRailVertices = object ARRAY()
  !rightHandRailVertices.append(!this.strFltData.lWP.offset(!this.strFltData.lCutPlane.orthogonal(U).opposite(), !ldistance))
  !rightHandRailVertices.append(!this.strFltData.lSOP.offset(!strFltOrtho.opposite(), !strFltWidth))
  !rightHandRailVertices.append(!this.strFltData.uSOP.offset(!strFltOrtho.opposite(), !strFltWidth))
  !rightHandRailVertices.append(!this.strFltData.uWP.offset(!this.strFltData.uCutPlane.orthogonal(U).opposite(), !udistance))
  !rightHandRailVertices.compress()

  -- radius is zero
  !handRailRadius = object ARRAY()
  !handRailRadius.append(0)
  !handRailRadius.append(0)
  !handRailRadius.append(0)
  !handRailRadius.append(0)

  -- evaluate the polylines of the handrails
  !leftHandRaEdges  = object POLYLINE(!strFltPos, !strFltOri, !leftHandRailVertices,  !handRailRadius)
  !rightHandRaEdges = object POLYLINE(!strFltPos, !strFltOri, !rightHandRailVertices, !handRailRadius)

  ---------------------------------------------------------------------------
  -- initialise the handrail data objects
  !this.strFltData.handRaEngines                                = object ARRAY()
  !this.strFltData.handRaEngines[1]                             = object ASLHANDRAENGINE()
  !this.strFltData.handRaEngines[1].handRaCriteriaBasis         = !this.handRaCriteriaBasis
  !this.strFltData.handRaEngines[1].handRaCriteria              = !this.handRaCriteria
  !this.strFltData.handRaEngines[1].handRaData.settingReference = !this.strFltData.settingReference

  -- selects the templates
  !this.strFltData.handRaEngines[1].setTmplReference(!this.strFltData.handRaTmplReference)

  -- combines general and fabricator standard
  !this.strFltData.handRaEngines[1].mergeCriteria()

  -- set default values
  !this.strFltData.handRaEngines[1].setDefaults()
  !this.strFltData.handRaEngines[2] = !this.strFltData.handRaEngines[1]

  -- set the profile as shape
  !this.strFltData.handRaEngines[1].setRouting(!leftHandRaEdges)
  !this.strFltData.handRaEngines[2].setRouting(!rightHandRaEdges)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateTable
--
-- Description:  evaluates a table of values and some values for the ranking of the values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateTable()

  -- reduce the expression length
  !criteria = !this.strFltCriteria

  -- inits
  ---------------------------------------------------------------------------
  -- values
  !this.tGoing                           = object ARRAY()
  !this.tOGoing                          = object ARRAY()
  !this.tPitch                           = object ARRAY()
  !this.tRelationship                    = object ARRAY()
  !this.uRise                            = object ARRAY()
  !this.tTreads                          = object ARRAY()

  -- difference from optimum
  !this.tGoingDifferenceOptimum          = object ARRAY()
  !this.tOGoingDifferenceOptimum         = object ARRAY()
  !this.tPitchDifferenceOptimum          = object ARRAY()
  !this.tRelationshipDifferenceOptimum   = object ARRAY()
  !this.uRiseDifferenceOptimum           = object ARRAY()
  !this.tTreadsDifferenceOptimum         = object ARRAY()

  -- evaluates the available length for the calculation
  ---------------------------------------------------------------------------
  -- if at least one of the picks is a plane then the length must not be a filtering criterion
  if ( !this.strFltData.lPickType.eq('PLANE') or $
       !this.strFltData.uPickType.eq('PLANE') ) then
    !length           = 100000
  else
    !lExtensionDiff   = !this.getExtensionDifference(!this.strFltData.direction,            !this.strFltData.lCutPlane)
    !uExtensionDiff   = !this.getExtensionDifference(!this.strFltData.direction.opposite(), !this.strFltData.uCutPlane)
    !length           = !this.strFltData.length - !lExtensionDiff - !uExtensionDiff
  endif

  -- analyze all possible combination of the different value
  ---------------------------------------------------------------------------
  -- treads
  do !treads value !criteria.treads.validValues
    -- evaluates the rise
    !rise = !this.getRise(!this.strFltData.oRise / !treads, !treads)

    -- ignores invalid rise values
    skip if ( !rise.lt(-1) )

    -- evaluates the limits
    ---------------------------------------------------------------------------
    !oGoingMin   = !criteria.oGoing.max * !treads
    !oGoingMax   = !criteria.oGoing.min * !treads
    !tanPitchMin = !this.strFltData.oRise / !oGoingMin
    !tanPitchMax = !this.strFltData.oRise / !oGoingMax
    !pitchMin    = !tanPitchMin.aTan().string('D1').real()
    !pitchMax    = !tanPitchMax.aTan().string('D1').real()
    if ( !pitchMin.gt(!criteria.pitch.min) ) then
      !min = !pitchMin
    else
      !min = !criteria.pitch.min
    endif
    if ( !pitchMax.lt(!criteria.pitch.max) ) then
      !max = !pitchMax
    else
      !max = !criteria.pitch.max
    endif

    -- pitch
    do !pitch from !min to !max by 0.1

      -- evaluates the oGoing value
      !oGoing =  !this.strFltData.oRise / !pitch.tangent()

      -- checks the validity of the oGoing value
      ---------------------------------------------------------------------------
      -- the oGoing value is invalid if it is outside the min and max limits or
      -- the oGoing value is greater than the length of the stair flight
      skip if ( !oGoing.between(!criteria.oGoing.min, !criteria.oGoing.max).not() or $
                !oGoing.gt(!length) )

      -- evaluates the going value
      !going  =  !oGoing / !treads

      -- checks the validity of the going value (the value is only valid between its min and max limits)
      skip if ( !going.between(!criteria.going.min, !criteria.going.max).not() )

      -- checks the extension condition
      !extensionOption = !this.strFltData.extensionOption
      skip if  ( !extensionOption inset ('Upper extension = minimum', 'Lower extension = minimum') and $
                 ( !length - !oGoing ) lt 0 )

      skip if ( !extensionOption.eq('User defined')                         and $
                ( !this.strFltData.lExtensionLock                           and $
                  ( !length - !oGoing - !this.strFltData.lExtension ) lt 0  or $
                !this.strFltData.uExtensionLock                             and $
                ( !length - !oGoing - !this.strFltData.uExtension ) lt 0 ))

      -- evaluates the relation value of the rise and going relationship
      !expression = object BLOCK(!criteria.relationship.value[1])
      if (defined(!relation)) then
        !relation.delete()
      endif
      !relation   = !expression.evaluate()
      if (!relation.objectType() eq 'STRING') then
        -- get !relation as a REAL
        !temporary = !relation
        !relation.delete()
        !relation = $!temporary
      endif

      -- check the validity of the relation result values
      skip if ( !relation.between(!criteria.relationship.min, !criteria.relationship.max).not() )

      -- adds only valid combinations into the table
      ---------------------------------------------------------------------------
      -- values
      !this.tGoing.append(!going.string('D1').real())
      !this.tOGoing.append(!oGoing.string('D1').real())
      !this.tPitch.append(!pitch.string('D1').real())
      !this.tRelationship.append(!relation.string('D1').real())
      !this.uRise.append(!rise.string('D1').real())
      !this.tTreads.append(!treads)

      -- difference from optimum
      !this.tGoingDifferenceOptimum.append(!this.evaluateDifference(!going, !criteria.going.optimum).string('D1').real())
      !this.tOGoingDifferenceOptimum.append(!this.evaluateDifference(!oGoing, !criteria.oGoing.optimum).string('D1').real())
      !this.tPitchDifferenceOptimum.append(!this.evaluateDifference(!pitch, !criteria.pitch.optimum).string('D1').real())
      !this.tRelationshipDifferenceOptimum.append(!this.evaluateDifference(!relation, !criteria.relationship.optimum).string('D1').real())
      !this.uRiseDifferenceOptimum.append(!this.evaluateDifference(!rise, !criteria.rise.optimum).string('D1').real())
      !this.tTreadsDifferenceOptimum.append(!this.evaluateDifference(!treads, !criteria.treads.optimum))
    enddo
  enddo

  -- sorts the results
  !this.sortTable('TRELATIONSHIPDIFFERENCEOPTIMUM')
  !this.sortTable('TTREADS')

endmethod
-- End of method

