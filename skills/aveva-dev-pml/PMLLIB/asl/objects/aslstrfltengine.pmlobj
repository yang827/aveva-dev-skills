------------------------------------------------------------------------
--
-- Method:      setRise
--
-- Description: sets the rise
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        rise
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setRise(!rise is REAL)

  !this.strFltData.rise = !rise

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setRises
--
-- Description: sets the values for bottom rise and top rise
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setRises()

  -- evaluates the difference
  !riseDifference = !this.strFltData.oRise - !this.strFltData.treads * !this.strFltData.rise

  -- evaluates the tolerance of the first and of the last tread
  !lRiseTolerance = !this.strFltCriteria.lRise.getTolerance()
  !uRiseTolerance = !this.strFltCriteria.uRise.getTolerance()

  -- handles difference greater than 0
  if ( !riseDifference.geq(0) ) then
    if ( !riseDifference.leq(!lRiseTolerance) ) then
      !this.strFltData.lRise = !this.strFltData.rise + !riseDifference
      !riseDifference        = 0
    else
      !this.strFltData.lRise = !this.strFltData.rise + !lRiseTolerance
      !riseDifference        = !riseDifference  - !lRiseTolerance
    endif
    !this.strFltData.uRise = !this.strFltData.rise + !riseDifference

  -- handles difference less than 0
  else
    !riseDifference = !riseDifference.abs()
    if ( !riseDifference.leq(!lRiseTolerance) ) then
      !this.strFltData.lRise = !this.strFltData.rise - !riseDifference
      !riseDifference        = 0
    else
      !this.strFltData.lRise = !this.strFltData.rise - !lRiseTolerance
      !riseDifference        = !riseDifference  - !lRiseTolerance
    endif
    !this.strFltData.uRise = !this.strFltData.rise - !riseDifference
  endif

endmethod
-- End of method

