------------------------------------------------------------------------

define method .getError() is BOOLEAN

  return !this.strFltData.error

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getExtensionDifference
--
-- Description: gets the difference of the extension for none orthogonal extensions
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   direction of the stair flight
--    2   R      DIRECTION   direction of the cutplane
-- Return:
--   [Data Type] [Description]
--    REAL        difference of the extension
------------------------------------------------------------------------

define method .getExtensionDifference(!stairDirection is DIRECTION, !cutPlaneDirection is DIRECTION) is REAL

  !angle      = !stairDirection.angle(!cutPlaneDirection)
  !difference = !this.strFltData.width / 2 * !angle.tangent().abs()

  return !difference

endmethod
-- End of method

