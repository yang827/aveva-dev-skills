-- End of method

------------------------------------------------------------------------
--
-- Method:      getOptima
--
-- Description: returns a set of optimal combination
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY      Stair Data (number of treads and pitches)
------------------------------------------------------------------------

define method .getOptima() is ARRAY

  -- inits
  ---------------------------------------------------------------------------
  -- number of treads
  !data[1]   = object ARRAY()
  -- pitch
  !data[2]   = object ARRAY()

  -- handles all possible tread numbers
  !validTreads =  !this.getValidTreads()
  do !treads value !validTreads
    -- evaluates the first occurrence of the tread number
    !matchIdx = !this.tTreads.findFirst(!treads)

    -- any difference greater than 40 can not be offer as an optimum
    skip if ( !this.tRelationshipDifferenceOptimum[!matchIdx].gt(20) )

    -- stores the tread number and the assigned pitch
    !data[1].append(!this.tPitch[!matchIdx])
    !data[2].append(!treads)
  enddo

  return !data

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOptimumPitch
--
