------------------------------------------------------------------------
--
-- Method:      useOptimum
--
-- Description: use the optimum value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .useOptimum()

  -- stores the status of the pitch and treads lock marker
  !pitchLock  = !this.strFltData.pitchLock
  !treadsLock = !this.strFltData.treadsLock

  -- locks the pitch and treads
  !this.strFltData.pitchLock  = true
  !this.strFltData.treadsLock = true

  -- evaluate nearest value next to the optimum
  !sortedIndices = !this.tRelationshipDifferenceOptimum.sortedIndices()
  !pitches       = !this.tPitch
  !pitches.reIndex(!sortedIndices)
  !treads        = !this.tTreads
  !treads.reIndex(!sortedIndices)

  -- sets the most optimum value
  !this.strFltData.pitch  = !pitches.first()
  !this.strFltData.treads = !treads.first()

  -- evaluates all other parameters
  !this.evaluate()

  -- restores the previous status of the pitch lock and treads marker
  !this.strFltData.pitchLock  = !pitchLock
  !this.strFltData.treadsLock = !treadsLock

endmethod
-- End of method
