------------------------------------------------------------------------
--
-- Method:      sortTable
--
-- Description: sorts the ranking table
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array with key values for the sort procedure
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .sortTable(!keyValues is STRING)

  !sortedIndices = !this.attribute(!keyValues).sortedIndices()
  !this.tGoing.reIndex(!sortedIndices)
  !this.tOGoing.reIndex(!sortedIndices)
  !this.tPitch.reIndex(!sortedIndices)
  !this.tRelationship.reIndex(!sortedIndices)
  !this.uRise.reIndex(!sortedIndices)
  !this.tTreads.reIndex(!sortedIndices)

  !this.tGoingDifferenceOptimum.reIndex(!sortedIndices)
  !this.tOGoingDifferenceOptimum.reIndex(!sortedIndices)
  !this.tPitchDifferenceOptimum.reIndex(!sortedIndices)
  !this.tRelationshipDifferenceOptimum.reIndex(!sortedIndices)
  !this.uRiseDifferenceOptimum.reIndex(!sortedIndices)
  !this.tTreadsDifferenceOptimum.reIndex(!sortedIndices)

endmethod
-- End of method

