endmethod
-- End of method

---------------------------------------------------------------------
--
-- Method:      getRange
--
-- Description: evaluates the largest and the smallest value for the given array
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       unsorted array of real values
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] = min / [2] = max
------------------------------------------------------------------------

define method .getRange(!validValues is ARRAY) is ARRAY

  !sortedValidValues = !validValues
  !sortedValidValues.sortUnique()
  !range[1]          = !sortedValidValues.first()
  !range[2]          = !sortedValidValues.last()

  return !range

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPitch
--
-- Description: returns the pitch
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        pitch
------------------------------------------------------------------------

define method .getPitch() is REAL

  return !this.strFltData.pitch

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getRise
--
-- Description: returns the rise
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        rise
------------------------------------------------------------------------

define method .getRise() is REAL

  return !this.strFltData.rise

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getRise
--
-- Description: evaluates the rise according to the tolerance
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        rise
--    2   R      REAL        number of treads
-- Return:
--   [Data Type] [Description]
--    REAL        rise
------------------------------------------------------------------------

define method .getRise(!rise is REAL, !treads is REAL) is REAL

  -- reduce the expression length
  !criteria      = !this.strFltCriteria

  -- evaluates the max possible rise tolerance
  !riseTolerance = !this.strFltCriteria.lRise.getTolerance() + !this.strFltCriteria.uRise.getTolerance()

  -- checks the validity of the rise value
  ---------------------------------------------------------------------------
  -- if the rise value is outside of the limits try to handle this with the tolerance values of the bottom and of the top step
  if ( !rise.gt(!criteria.rise.max) ) then
    -- evaluates the contravention of the limit
    !deficit = (!rise - !criteria.rise.max) * !treads
    !newRise = !criteria.rise.max

  elseif ( !rise.lt(!criteria.rise.min) ) then
    -- evaluates the lower deviation of the limit
    !deficit = (!criteria.rise.min - !rise) * !treads
    !newRise = !criteria.rise.min

  else
    !deficit = 0
    !newRise = !rise
  endif

  -- checks the deficit size
  if ( !deficit.gt(!riseTolerance) ) then
    return -1
  else
    return !newRise
  endif

endmethod
-- End of method

