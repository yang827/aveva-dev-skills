--     Keyword:     GEN
--   Module:        DESIGN
--   Replaces:
-- Author:          Lars Leppin
-- Created:         Tue Aug 1 09:00:00 GMT 2006
--
--
-- Description:     container for STRLNG criteria data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrLngCriteria()              -
--  checkValue(REAL,STRING)          -                   check value against criterion
--  complete()                       -                   completes all missing values
--  getOptimumWidth()                REAL                returns the optimum width
--  string()                         STRING              returns description
--

-- Define object
define object ASLSTRLNGCRITERIA

  -- stores the description of the object
  member .desc   is STRING

  -- length
  member .length is CRITERION

  -- width
  member .width  is CRITERION

  --height
  member .height is CRITERION

endobject
-- End of object definition for aslStrLngCriteria

------------------------------------------------------------------------
--
-- Method:      aslStrLngCriteria
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrLngCriteria()

  !this.desc               = 'Stair Landing'

  !this.length.description = 'Landing length'
  !this.width.description  = 'Landing width'
  !this.height.description = 'Landing Thickness'

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      complete
--
-- Description: completes all missing values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .complete()

  !this.length.complete(1000mm, 1000mm)
  !this.width.complete(1000mm, 1000mm)
  !this.height.complete(50mm, 250mm)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getOptimumWidth
--
-- Description: returns the optimum width
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        optimum width
------------------------------------------------------------------------

define method .getOptimumWidth() is REAL

  return !this.width.optimum

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      string
--
-- Description: returns description when converted to string
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Object description
------------------------------------------------------------------------

define method .string() is STRING

  return !this.desc

endmethod
-- end of method



------------------------------------------------------------------------
--
-- Method:      checkValue
--
-- Description: check value against criterion
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Value to be checked
--    2   R      STRING      Criterion name
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .checkValue(!value is REAL,!criterionName is STRING)

  -- get appropriate CRITERION and check the value
  !criterion = !this.attribute(!criterionName.upcase())
  !criterion.checkValue(!value)

endmethod
-- end of method
