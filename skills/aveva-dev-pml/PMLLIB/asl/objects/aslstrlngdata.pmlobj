------------------------------------------------------------------------
--
-- Method:      modifyFourLngHandraDB
--
-- Description: modifies the handrail the element for two stairs
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .modifyFourLngHandraDB(!resultLng is DBREF, !elevIndex is REAL, !keyWord is STRING)

  --get the defaults for calculation
  !prmDir        = !!aslStrTwr.meStrTwrEngine.strTwrData.prmDirection
  !pos           = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !xLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.xLength
  !yLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.yLength
  !zLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.zLength
  !clxLen        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltClXSpacing
  !clyLen        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltClYSpacing
  !fltWdt        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltWidth
  !upPos         = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !lngWidth      = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
  !lngLength     = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
  !fflLevelElev  = !!aslStrTwr.neFflLevel.getrows()
  !senSe         = !!aslStrTwr.meStrTwrEngine.strTwrData.clockWise
  !width         = !this.lngWidth
  !length        = !this.lngLength
  !ori           = y is $!prmDir

  --update based on the sense
  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  if ( !resultLng.desc.upcase().matchwild('*FOUR STAIRS') and ( !keyWord.upcase().eq('ONE') ) ) then
    --collect HANDRA for ce
    !collHandra = object COLLECTION()
    !collHandra.scope(!resultLng)
    !collHandra.type('HANDRA')
    !resultHandra = !collHandra.results()

    if ( !resultHandra.empty() ) then
      --!!alert.error('No Handrail to Modify')
      --return
    endif

    --shorter handrail on left
    !this.handraProfile = object ARRAY()
    !proLine  = object ARRAY()

    --longer handrail
    if ( !this.updateHandrail.eq(true) ) then
      !line0 = object LINE()
      !line0.startPosition = !pos.offset( !prmDir1, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir.opposite(), ( ( !yLen / 2 ) - !length ) )
      !line0.endPosition   = !pos.offset( !prmDir1, ( !xLen / 2 ) ).offset( !prmDir.opposite(), ( ( !yLen / 2 ) - !length ) )
      if ( !line0.startPosition.neq(!line0.endPosition) and !line0.length().gt(100mm)) then
        !proLine.append(!line0)
      endif
    endif

    --shorter handrail on left
    !proLine  = object ARRAY()
    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 ) ).offset( !prmDir.opposite(), ( ( !yLen / 2 ) - !length ) )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), !length )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir2, !width )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)

    if ( !this.updateHandrail.eq(true) ) then
      !line3 = object LINE()
      !line3.startPosition = !pos.offset( !prmDir1, ( ( !xLen / 2 ) - !width ) ).offset( !prmDir.opposite(), !yLen / 2 )
      !line3.endPosition   = !pos.offset( !prmDir.opposite(), ( ( !clyLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir1, ( !xLen / 2 - !width ) )
      if ( !line3.startPosition.neq(!line3.endPosition) and !line3.length().gt(100mm)) then
        !proLine.append(!line3)
      endif
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex].real() )

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    do !j from 1 to !this.handraProfile.size()
      if (!resultHandra[!j].set() ) then
        !!ce = !resultHandra[!j]
      else
        return
      endif
      !modHandraObj = !this.meHandraEngine
      !modHandraObj.aslHandrail(!resultHandra[!j])
      !modHandraObj.rpath.aslRpath(!this.handraProfile[!j])
        if ( !senSe.eq(false) ) then
          !modHandraObj.xoffset = -1
        elseif ( !senSe.eq(true) ) then
          !modHandraObj.xoffset = 1
        endif
      !modHandraObj.tmplReference(!this.handRaTmplReference)
      !!ce = !modHandraObj.updateDb()
      !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
    enddo

  elseif ( !resultLng.desc.upcase().matchwild('*FOUR STAIRS') and ( !keyWord.eq('TWO') ) ) then

    --collect HANDRA for ce
    !collHandra = object COLLECTION()
    !collHandra.scope(!resultLng)
    !collHandra.type('HANDRA')
    !resultHandra = !collHandra.results()

    if ( !resultHandra.empty() ) then
      --!!alert.error('No Handrail to Modify')
      --return
    endif

   --shorter handrail on left
    !this.handraProfile = object ARRAY()
    !proLine  = object ARRAY()

    if ( !this.updateHandrail.eq(true) ) then
      !line0 = object LINE()
      !line0.startPosition = !pos.offset( !prmDir, ( ( !clyLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir1, ( !xLen / 2 - !width ) )
      !line0.endPosition   = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
      if ( !line0.startPosition.neq(!line0.endPosition) and !line0.length().gt(100mm)) then
        !proLine.append(!line0)
      endif
    endif

    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir1, !width )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir.opposite(), !length )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)

    if ( !this.updateHandrail.eq(true) ) then
      !line3 = object LINE()
      !line3.startPosition = !pos.offset( !prmDir1, !xLen / 2 ).offset( !prmDir, ( !yLen / 2 ) - !length )
      !line3.endPosition   = !pos.offset( !prmDir1, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      if ( !line3.startPosition.neq(!line3.endPosition) and !line3.length().gt(100mm)) then
        !proLine.append(!line3)
      endif
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex].real() )

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    do !j from 1 to !this.handraProfile.size()
      if (!resultHandra[!j].set() ) then
        !!ce = !resultHandra[!j]
      else
        return
      endif
      !modHandraObj = !this.meHandraEngine
      !modHandraObj.aslHandrail(!resultHandra[!j])
      !modHandraObj.rpath.aslRpath(!this.handraProfile[!j])
        if ( !senSe.eq(false) ) then
          !modHandraObj.xoffset = -1
        elseif ( !senSe.eq(true) ) then
          !modHandraObj.xoffset = 1
        endif
      !modHandraObj.tmplReference(!this.handRaTmplReference)
      !!ce = !modHandraObj.updateDb()
      !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
    enddo

  elseif ( !resultLng.desc.upcase().matchwild('*FOUR STAIRS') and ( !keyWord.eq('THREE') ) ) then

    --collect HANDRA for ce
    !collHandra = object COLLECTION()
    !collHandra.scope(!resultLng)
    !collHandra.type('HANDRA')
    !resultHandra = !collHandra.results()

    if ( !resultHandra.empty() ) then
      --!!alert.error('No Handrail to Modify')
      --return
    endif

    --shorter handrail on left
    !this.handraProfile = object ARRAY()
    !proLine  = object ARRAY()

    if ( !this.updateHandrail.eq(true) ) then
      !line0 = object LINE()
      !line0.startPosition = !pos.offset( !prmDir2, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      !line0.endPosition   = !pos.offset( !prmDir2, !xLen / 2 ).offset( !prmDir, ( !yLen / 2 - !length ) )
      if ( !line0.startPosition.neq(!line0.endPosition) and !line0.length().gt(100mm)) then
        !proLine.append(!line0)
      endif
    endif

    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir2, !xLen / 2 ).offset( !prmDir, ( !yLen / 2 - !length ) )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir, !length )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir1, !width )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)

    if ( !this.updateHandrail.eq(true) ) then
      !line3 = object LINE()
      !line3.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
      !line3.endPosition   = !pos.offset( !prmDir, ( ( !clyLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir2, ( !xLen / 2 - !width ) )
      if ( !line3.startPosition.neq(!line3.endPosition) and !line3.length().gt(100mm)) then
        !proLine.append(!line3)
      endif
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex].real() )

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    do !j from 1 to !this.handraProfile.size()
      if (!resultHandra[!j].set() ) then
        !!ce = !resultHandra[!j]
      else
        return
      endif
      !modHandraObj = !this.meHandraEngine
      !modHandraObj.aslHandrail(!resultHandra[!j])
      !modHandraObj.rpath.aslRpath(!this.handraProfile[!j])
        if ( !senSe.eq(false) ) then
          !modHandraObj.xoffset = -1
        elseif ( !senSe.eq(true) ) then
          !modHandraObj.xoffset = 1
        endif
      !modHandraObj.tmplReference(!this.handRaTmplReference)
      !!ce = !modHandraObj.updateDb()
      !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
    enddo

  elseif ( !resultLng.desc.upcase().matchwild('*FOUR STAIRS') and ( !keyWord.eq('FOUR') ) ) then

    --collect HANDRA for ce
    !collHandra = object COLLECTION()
    !collHandra.scope(!resultLng)
    !collHandra.type('HANDRA')
    !resultHandra = !collHandra.results()

    if ( !resultHandra.empty() ) then
      --!!alert.error('No Handrail to Modify')
      --return
    endif

    --shorter handrail on left
    !this.handraProfile = object ARRAY()
    !proLine  = object ARRAY()

    if ( !this.updateHandrail.eq(true) ) then
      !line0 = object LINE()
      !line0.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir.opposite(), ( ( !clyLen / 2 ) + ( !fltWdt / 2 ) ) )
      !line0.endPosition   = !pos.offset( !prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir.opposite(), !yLen / 2 )
      if ( !line0.startPosition.neq(!line0.endPosition) and !line0.length().gt(100mm)) then
        !proLine.append(!line0)
      endif
    endif

    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir.opposite(), !yLen / 2 )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir2, !width )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir, !length )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)

    if ( !this.updateHandrail.eq(true) ) then
      !line3 = object LINE()
      !line3.startPosition = !pos.offset( !prmDir2, !xLen / 2 ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line3.endPosition   = !pos.offset( !prmDir2, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      if ( !line3.startPosition.neq(!line3.endPosition) and !line3.length().gt(100mm)) then
        !proLine.append(!line3)
      endif
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex].real() )

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    do !j from 1 to !this.handraProfile.size()
      if (!resultHandra[!j].set() ) then
        !!ce = !resultHandra[!j]
      else
        return
      endif
      !modHandraObj = !this.meHandraEngine
      !modHandraObj.aslHandrail(!resultHandra[!j])
      !modHandraObj.rpath.aslRpath(!this.handraProfile[!j])
        if ( !senSe.eq(false) ) then
          !modHandraObj.xoffset = -1
        elseif ( !senSe.eq(true) ) then
          !modHandraObj.xoffset = 1
        endif
      !modHandraObj.tmplReference(!this.handRaTmplReference)
      !!ce = !modHandraObj.updateDb()
      !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
    enddo
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateHandraToFltSpacing
--
-- Description: read the handrail and update to match the flight spacing
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type]    [Description]
--    1     R     DBREF        reference element
--
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateHandraToFltSpacing()

  --get the defaults for calculation
  !prmDir        = !!aslStrTwr.meStrTwrEngine.strTwrData.prmDirection
  !pos           = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !xLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.xLength
  !yLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.yLength
  !zLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.zLength
  !upPos         = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !lngWidth      = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
  !lngLength     = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
  !fflLevelElev  = !!aslStrTwr.neFflLevel.getrows()
  !senSe         = !!aslStrTwr.meStrTwrEngine.strTwrData.clockWise
  !width         = !this.lngWidth
  !length        = !this.lngLength
  !ori           = y is $!prmDir

  --update based on the sense
  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  if ( !resultLng.desc.upcase().matchwild('*NORTH') ) then

    --collect HANDRA for ce
    !collHandra = object COLLECTION()
    !collHandra.scope(!resultLng)
    !collHandra.type('HANDRA')
    !resultHandra = !collHandra.results()

    if ( !resultHandra.empty() ) then
      --!this.updateHandrailProfile()
      --!!alert.error('No Handrail to Modify')
      --return
    endif

    --initialise the variables
    !this.handraProfile = object ARRAY()
    !proLine  = object ARRAY()
    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir1, !width )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir.opposite(), !yLen )

    !line3 = object LINE()
    !line3.startPosition = !line2.endPosition
    !line3.endPosition   = !line3.startPosition.offset( !prmDir2, !xLen )

    !line4 = object LINE()
    !line4.startPosition = !line3.endPosition
    !line4.endPosition   = !line4.startPosition.offset( !prmDir, !yLen )

    !line5 = object LINE()
    !line5.startPosition = !line4.endPosition
    !line5.endPosition   = !line5.startPosition.offset( !prmDir1, !width )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)
    !proLine.append(!line3)
    !proLine.append(!line4)
    !proLine.append(!line5)

    !pos = !this.refe.pos.offset(U, !upPos[!elevIndex] )

    --create a profile
    !profile = object PROFILE(!pos, !ori, !proLine)
    !this.handraProfile.append(!profile)

    --inner handrail profile
    !proLine  = object ARRAY()
    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), ( !yLen - 2 * !length ) )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir2, ( !xLen - 2 * !width ) )

    !line3 = object LINE()
    !line3.startPosition = !line2.endPosition
    !line3.endPosition   = !line3.startPosition.offset( !prmDir, ( !xLen - 2 * !length ) )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)
    !proLine.append(!line3)

    !pos = !this.refe.pos.offset(U, !upPos[!elevIndex].real() )

    --create a profile
    !profile = object PROFILE(!pos, !ori, !proLine)
    !this.handraProfile.append(!profile)

    do !j from 1 to !this.handraProfile.size()
      if (!resultHandra[!j].set() ) then
        !!ce = !resultHandra[!j]
      else
        return
      endif
      !modHandraObj = !this.meHandraEngine
      !modHandraObj.aslHandrail(!resultHandra[!j])
      !modHandraObj.rpath.aslRpath(!this.handraProfile[!j])
      !modHandraObj.tmplReference(!this.handRaTmplReference)
      !!ce = !modHandraObj.updateDb()
      !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
    enddo
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateOneStrLngDB
--
-- Description: creates/updates STRLNG element
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type]           [Description]
--    1    R      ARRAY               FFL level of STRTWR
--    2    R      ARRAY               template reference from assembly
--    3    R      POSITION            STRTWR POSITION
--    4    R      ASLTWRBEAMPROFILE   tie beam profile data
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateOneStrLngDB(!upPos is ARRAY, !resultTemplate is ARRAY, !pos is POSITION, !tieBeamProfData is ASLTWRBEAMPROFILE)

  !this.landingRefe = object ARRAY()

  --copy the template reference
  new STRLNG copy $!resultTemplate[1]

  --update the attributes
  !this.landingRefe[1]                 =  (!!ce)
  !this.landingRefe[1].pos             =  !pos.offset(U, !upPos[1] )
  !this.landingRefe[1].lfaoffset       =  !this.lngLength
  !this.landingRefe[1].lfboffset       =  !this.lngWidth
  !this.landingRefe[1].asstmpreference =  !resultTemplate[1]
  !this.landingRefe[1].thickn          =  !this.lngThk

  --set the thickness and other attributes to panel
  if ( !this.strLngTmplReference.purpose.eq('PANE') ) then

    !collPanel = object COLLECTION()
    !collPanel.scope(!this.landingRefe[1])
    !collPanel.type('PANE')
    !resultPanel = !collPanel.results()

    if ( !resultPanel.empty().not() ) then
      if ( !this.lngSpec.badref().not() ) then
        !resultPanel[1].spref = !this.lngSpec
      else
        !!ce = !resultPanel[1]
        spref nulref
      endif

      --collect the ploop and set the thickness
      !collPloo = object COLLECTION()
      !collPloo.scope(!resultPanel[1])
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()

      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    endif

  endif

  --navigate to gensec to change the spec
  !collGensec = object COLLECTION()
  !collGensec.scope(!this.landingRefe[1])
  !collGensec.type('GENSEC')
  !result = !collGensec.results()

  do !gensec values !result
    !gensec.spref            = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensec.jusline          = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensec.pos              = E0 N0 D $!this.lngThk WRT STRLNG
  enddo

  if ( !!aslStrTwr.createTwrStl.val.eq(false) ) then

    --first long gensec along the edge
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk WRT STRLNG

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = U

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) N ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    --second long gensec along the edge
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk WRT STRLNG

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = U

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( E ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( E ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) N ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    --third long gensec along the edge
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk WRT STRLNG

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = U

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( ATTRIB OPLENGTH OF STRTWR  / 2 ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( E ( ATTRIB OPLENGTH OF STRTWR  / 2 ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    --first short gensec along the edge
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk WRT STRLNG

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = U

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG ) N ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( ATTRIB OPLENGTH OF STRTWR  / 2 ) N ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    --second short gensec along the edge
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk WRT STRLNG

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = U

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( E ( ATTRIB OPLENGTH OF STRTWR  / 2 ) N ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( E ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG ) N ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

  endif

  --execute the rules
  !!ce = !this.landingRefe[1]
  RULE REXE

  --create the handrail
  !this.updateHandraDB()

  --create other landings
  do !i from 2 to !upPos.size()
    new STRLNG copy $!this.landingRefe[1]
    !this.landingRefe[!i]       =  (!!ce)
    !this.landingRefe[!i].pos   =  !pos.offset(U, !upPos[!i])
    !!fmsys.setProgress( ( !i * 3 ) + 45 )
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      updateTwoStrLngDB
--
-- Description: creates/updates STRLNG element
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW]   [Data type]         [Description]
--    1    R      ARRAY               ffl level of STRTWR
--    2    R      ARRAY               template reference from assembly
--    3    R      POSITION            STRTWR POSITION
--    4    R      ASLTWRBEAMPROFILE   tie beam profile data
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateTwoStrLngDB(!upPos is ARRAY, !resultTemplate is ARRAY, !pos is POSITION, !tieBeamProfData is ASLTWRBEAMPROFILE)

  !this.landingRefe = object ARRAY()

  --copy the template reference
  new STRLNG copy $!resultTemplate[1]

  --update the attributes
  !this.landingRefe[1]                 =  (!!ce)
  !this.landingRefe[1].pos             =  !pos.offset(U, !upPos[1] )
  !this.landingRefe[1].lfaoffset       =  !this.lngLength
  !this.landingRefe[1].lfboffset       =  !this.lngWidth
  !this.landingRefe[1].asstmpreference =  !resultTemplate[1]
  !this.landingRefe[1].thickn          =  !this.lngThk

  --set the thickness and other attributes to panel
  if ( !this.strLngTmplReference.purpose.eq('PANE') ) then

    !collPanel = object COLLECTION()
    !collPanel.scope(!this.landingRefe[1])
    !collPanel.type('PANE')
    !resultPanel = !collPanel.results()

    if ( !resultPanel.empty().not() ) then
      if ( !this.lngSpec.badref().not() ) then
        !resultPanel[1].spref = !this.lngSpec
      else
        !!ce = !resultPanel[1]
        spref nulref
      endif

      --collect the ploop and set the thickness
      !collPloo = object COLLECTION()
      !collPloo.scope(!resultPanel[1])
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()

      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    endif

  endif

  --navigate to gensec to change the spec
  !collGensec = object COLLECTION()
  !collGensec.scope(!this.landingRefe[1])
  !collGensec.type('GENSEC')
  !result = !collGensec.results()

  do !gensec values !result
    !gensec.spref            = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensec.jusline          = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensec.pos              = E0 N0 D $!this.lngThk WRT STRLNG
  enddo

  if ( !!aslStrTwr.createTwrStl.val.eq(false) ) then

    --first long gensec along the edge
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk WRT STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D
    !spineRefe.drnstart = E
    !spineRefe.drnend   = W

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( ATTRIB OPLENGTH OF STRTWR  / 2 ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( E ( ATTRIB OPLENGTH OF STRTWR  / 2 ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    --second gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk WRT STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D
    !spineRefe.drnstart = N
    !spineRefe.drnend   = S

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ( ATTRIB LFAOFFSET OF STRLNG ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2  ) )

    --third gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk WRT STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D
    !spineRefe.drnstart = N
    !spineRefe.drnend   = S

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( E ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2  ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( E ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ( ATTRIB LFAOFFSET OF STRLNG ) ) )

  endif

  --execute the rules
  !!ce = !this.landingRefe[1]
  RULE REXE

  --create the handrail
  !this.updateHandraDB()

  --create other landings
  do !i from 3 to !upPos.size() by 2
    new STRLNG copy $!this.landingRefe[1]
    !this.landingRefe[!i]           = (!!ce)
    !this.landingRefe[!i].pos       = !pos.offset(U, !upPos[!i] )
    ORIENTATION Y is N and Z is U wrt STRTWR
    !!fmsys.setProgress( ( !i * 3 ) + 45 )
  enddo

  do !i from 2 to !upPos.size() by 2
    new STRLNG copy $!this.landingRefe[1]
    !this.landingRefe[!i]           = (!!ce)
    !this.landingRefe[!i].pos       = !pos.offset(U, !upPos[!i] )
    ORIENTATION Y is S and Z is U wrt STRTWR
    !!fmsys.setProgress( ( !i * 2 ) + 80 )
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      updateThreeStrLngDB
--
-- Description: creates/updates STRLNG element
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW]   [Data type]         [Description]
--    1    R      ARRAY               ffl level of STRTWR
--    2    R      ARRAY               template reference from assembly
--    3    R      POSITION            Strtwr POSITION
--    4    R      ASLTWRBEAMPROFILE   tie beam profile data
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateThreeStrLngDB(!upPos is ARRAY, !resultTemplate is ARRAY, !pos is POSITION, !tieBeamProfData is ASLTWRBEAMPROFILE)

  !this.landingRefe = object ARRAY()

  --copy the template reference
  new STRLNG copy $!resultTemplate[1]

  --update the attributes
  !this.landingRefe[1]                 =  (!!ce)
  !this.landingRefe[1].pos             =  !pos.offset(U, !upPos[1] )
  !this.landingRefe[1].lfaoffset       =  !this.lngLength
  !this.landingRefe[1].lfboffset       =  !this.lngWidth
  !this.landingRefe[1].asstmpreference =  !resultTemplate[1]
  !this.landingRefe[1].thickn          =  !this.lngThk

  --set the thickness and other attributes to panel
  if ( !this.strLngTmplReference.purpose.eq('PANE') ) then

    !collPanel = object COLLECTION()
    !collPanel.scope(!this.landingRefe[1])
    !collPanel.type('PANE')
    !resultPanel = !collPanel.results()

    if ( !resultPanel.empty().not() ) then
      if ( !this.lngSpec.badref().not() ) then
        !resultPanel[1].spref = !this.lngSpec
      else
        !!ce = !resultPanel[1]
        spref nulref
      endif

      --collect the ploop and set the thickness
      !collPloo = object COLLECTION()
      !collPloo.scope(!resultPanel[1])
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()

      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    endif

  endif

  --navigate to gensec to change the spec
  !collGensec = object COLLECTION()
  !collGensec.scope(!this.landingRefe[1])
  !collGensec.type('GENSEC')
  !result = !collGensec.results()

  do !gensec values !result
    !gensec.spref            = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensec.jusline          = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensec.pos              = E0 N0 D $!this.lngThk wrt STRLNG
  enddo

  if ( !!aslStrTwr.createTwrStl.val.eq(false) ) then

    --first long gensec along the edge
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 ) S ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( E ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 ) S ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    --second gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) S ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 - ( ATTRIB LFAOFFSET OF STRLNG ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) S ( ATTRIB COLYSP[1 ] OF STRTWR  / 2  ) )

    --third gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( E ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) S ( ATTRIB COLYSP[1 ] OF STRTWR  / 2  ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( E ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) S ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 - ( ATTRIB LFAOFFSET OF STRLNG ) ) )

  endif

  --execute the rules
  !!ce = !this.landingRefe[1]
  RULE REXE

  --second landing
  --copy the template reference
  new STRLNG copy $!resultTemplate[2]

  --update the attributes
  !this.landingRefe[2]                 =  (!!ce)
  !this.landingRefe[2].pos             =  !pos.offset(U, !upPos[2] )
  !this.landingRefe[2].lfaoffset       =  !this.lngWidth
  !this.landingRefe[2].lfboffset       =  !this.lngLength
  !this.landingRefe[2].asstmpreference =  !resultTemplate[2]
  !this.landingRefe[2].thickn          =  !this.lngThk

  --set the thickness and other attributes to panel
  if ( !this.strLngTmplReference.purpose.eq('PANE') ) then

    !collPanel = object COLLECTION()
    !collPanel.scope(!this.landingRefe[2])
    !collPanel.type('PANE')
    !resultPanel = !collPanel.results()

    if ( !resultPanel.empty().not() ) then
      if ( !this.lngSpec.badref().not() ) then
        !resultPanel[1].spref = !this.lngSpec
      else
        !!ce = !resultPanel[1]
        spref nulref
      endif

      --collect the ploop and set the thickness
      !collPloo = object COLLECTION()
      !collPloo.scope(!resultPanel[1])
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()

      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    endif

  endif

  --navigate to gensec to change the spec
  !collGensec = object COLLECTION()
  !collGensec.scope(!this.landingRefe[2])
  !collGensec.type('GENSEC')
  !result = !collGensec.results()

  do !gensec values !result
    !gensec.spref       = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensec.jusline     = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensec.pos         = E0 N0 D $!this.lngThk wrt STRLNG
  enddo

  if ( !!aslStrTwr.createTwrStl.val.eq(false) ) then

    --first gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set pos Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) N ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set pos Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) N ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  ) )

    --second gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set pos Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  ) ) N ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set pos Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 ) ) N ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

  endif

  --execute the rules
  !!ce = !this.landingRefe[2]
  RULE REXE

  --third landing
  --copy the template reference
  new STRLNG copy $!resultTemplate[3]

  --update the attributes
  !this.landingRefe[3]                 =  (!!ce)
  !this.landingRefe[3].pos             =  !pos.offset(U, !upPos[3] )
  !this.landingRefe[3].lfaoffset       =  !this.lngWidth
  !this.landingRefe[3].lfboffset       =  !this.lngLength
  !this.landingRefe[3].asstmpreference =  !resultTemplate[3]
  !this.landingRefe[3].thickn          =  !this.lngThk

  --set the thickness and other attributes to panel
  if ( !this.strLngTmplReference.purpose.eq('PANE') ) then

    !collPanel = object COLLECTION()
    !collPanel.scope(!this.landingRefe[3])
    !collPanel.type('PANE')
    !resultPanel = !collPanel.results()

    if ( !resultPanel.empty().not() ) then
      if ( !this.lngSpec.badref().not() ) then
        !resultPanel[1].spref = !this.lngSpec
      else
        !!ce = !resultPanel[1]
        spref nulref
      endif

      --collect the ploop and set the thickness
      !collPloo = object COLLECTION()
      !collPloo.scope(!resultPanel[1])
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()

      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    endif

  endif

  --navigate to gensec to change the spec
  !collGensec = object COLLECTION()
  !collGensec.scope(!this.landingRefe[3])
  !collGensec.type('GENSEC')
  !result = !collGensec.results()

  do !gensec values !result
    !gensec.spref            = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensec.jusline          = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensec.pos              = E0 N0 D $!this.lngThk wrt STRLNG
  enddo

  if ( !!aslStrTwr.createTwrStl.val.eq(false) ) then

    --first gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set pos Static Rule ( E ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) N ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set pos Static Rule ( E ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) N ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 ) )

    --second gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set pos Static Rule ( E ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 ) ) N ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set pos Static Rule ( E ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB COLXSP[1 ] OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  ) ) N ( ATTRIB COLYSP[1 ] OF STRTWR  / 2 ) )

  endif

  --execute the rules
  !!ce = !this.landingRefe[3]
  RULE REXE

  --create the handrail
  !this.updateHandraDB()

  --create other landings
  do !i from 4 to !upPos.size() by 3
    new STRLNG copy $!this.landingRefe[1]
    !this.landingRefe[!i]           = (!!ce)
    !this.landingRefe[!i].pos       = !pos.offset(U, !upPos[!i])
    !!fmsys.setProgress( ( !i * 2.5 ) + 45 )
  enddo

  do !i from 5 to !upPos.size() by 3
    new STRLNG copy $!this.landingRefe[2]
    !this.landingRefe[!i]           = (!!ce)
    !this.landingRefe[!i].pos       = !pos.offset(U, !upPos[!i])
    !!fmsys.setProgress( ( !i * 2 ) + 70 )
  enddo

  do !i from 6 to !upPos.size() by 3
    new STRLNG copy $!this.landingRefe[3]
    !this.landingRefe[!i]           = (!!ce)
    !this.landingRefe[!i].pos       = !pos.offset(U, !upPos[!i])
    !!fmsys.setProgress( ( !i * 1.5 ) + 80 )
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      updateFourStrLngDB
--
-- Description: creates/updates STRLNG element
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW]   [Data type]         [Description]
--    1    R      ARRAY               ffl level of STRTWR
--    2    R      ARRAY               template reference from assembly
--    3    R      POSITION            Strtwr POSITION
--    4    R      ASLTWRBEAMPROFILE   tie beam profile data
--    5    R      DIRECTION           stair tower primary direction
--    6    R      BOOLEAN             installation senSe
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateFourStrLngDB(!upPos is ARRAY, !resultTemplate is ARRAY, !pos is POSITION, !tieBeamProfData is ASLTWRBEAMPROFILE, !prmDir is DIRECTION, !senSe is BOOLEAN )

  --initialise
  !this.landingRefe = object ARRAY()

  --update based on the sense
  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  --copy the template reference
  new STRLNG copy $!resultTemplate[1]

  --update the attributes
  !this.landingRefe[1]                 =  (!!ce)
  !this.landingRefe[1].pos             =  !pos.offset(U, !upPos[1] )
  !this.landingRefe[1].lfaoffset       =  !this.lngLength
  !this.landingRefe[1].lfboffset       =  !this.lngWidth
  !this.landingRefe[1].asstmpreference =  !resultTemplate[1]
  !this.landingRefe[1].thickn          =  !this.lngThk

  --set the thickness and other attributes to panel
  if ( !this.strLngTmplReference.purpose.eq('PANE') ) then

    !collPanel = object COLLECTION()
    !collPanel.scope(!this.landingRefe[1])
    !collPanel.type('PANE')
    !resultPanel = !collPanel.results()

    if ( !resultPanel.empty().not() ) then
      if ( !this.lngSpec.badref().not() ) then
        !resultPanel[1].spref = !this.lngSpec
      else
        !!ce = !resultPanel[1]
        spref nulref
      endif

      --collect the ploop and set the thickness
      !collPloo = object COLLECTION()
      !collPloo.scope(!resultPanel[1])
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()

      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    endif

  endif

  --navigate to gensec to change the spec
  !collGensec = object COLLECTION()
  !collGensec.scope(!this.landingRefe[1])
  !collGensec.type('GENSEC')
  !result = !collGensec.results()

  do !gensec values !result
    !gensec.spref            = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensec.jusline          = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensec.pos              = E0 N0 D $!this.lngThk wrt STRLNG
  enddo

  if ( !!aslStrTwr.createTwrStl.val.eq(false) ) then

    --first gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 ) )

    --second gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

  endif

  --execute the Rule
  !!ce = !this.landingRefe[1]
  RULE REXE

  --second landing
  new STRLNG copy $!resultTemplate[1]
  !this.landingRefe[2]                 = (!!ce)
  !this.landingRefe[2].pos             = !pos.offset(U, !upPos[2] ).offset( !prmDir, ( !this.refe.opWidth.real() - !this.lngLength ) )
  !this.landingRefe[2].lfaoffset       = !this.lngLength
  !this.landingRefe[2].lfboffset       = !this.lngWidth
  !this.landingRefe[2].asstmpreference = !resultTemplate[1]
  !this.landingRefe[2].thickn          =  !this.lngThk

  --set the thickness and other attributes to panel
  if ( !this.strLngTmplReference.purpose.eq('PANE') ) then

    !collPanel = object COLLECTION()
    !collPanel.scope(!this.landingRefe[2])
    !collPanel.type('PANE')
    !resultPanel = !collPanel.results()

    if ( !resultPanel.empty().not() ) then
      if ( !this.lngSpec.badref().not() ) then
        !resultPanel[1].spref = !this.lngSpec
      else
        !!ce = !resultPanel[1]
        spref nulref
      endif

      --collect the ploop and set the thickness
      !collPloo = object COLLECTION()
      !collPloo.scope(!resultPanel[1])
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()

      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    endif

  endif

  --navigate to gensec to change the spec
  !collGensec = object COLLECTION()
  !collGensec.scope(!!ce)
  !collGensec.type('GENSEC')
  !result = !collGensec.results()

  do !j from 1 to !result.size()
    !result[!j].spref            = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !result[!j].jusline          = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !result[!j].pos              = !result[!j].pos.offset( D, !this.lngThk )

    --collect the POINSP
    !collPspine         = object COLLECTION()
    !collPspine.scope(!result[!j])
    !collPspine.type('POINSP')
    !resultPspine       = !collPspine.results()

    !oldCe              = !!ce
    do !k from 1 to !resultPspine.size()
      --eval the pos Rule
      if ( !j.eq(1) and !k.eq(1) ) then
        --set the pose Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  + DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 ) )
      elseif ( !j.eq(1) and !k.eq(2) ) then
        --set the pos Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  + DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  ) )
      elseif ( !j.eq(2) and !k.eq(1) ) then
        --set the pose Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )
      elseif ( !j.eq(2) and !k.eq(2) ) then
        --set the pose Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ATTRIB OPLENGTH OF STRTWR  / 2 ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )
      endif
    enddo

  enddo

  !!ce = !oldCe

  if ( !!aslStrTwr.createTwrStl.val.eq(false) ) then

    --first gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 ) )

    --second gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ATTRIB OPLENGTH OF STRTWR  / 2 ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  + ATTRIB PARA[2 ] OF GENSEC  / 2 ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  + ATTRIB PARA[2 ] OF GENSEC  / 2 ) )
  endif

  --execute the Rule
  !!ce = !this.landingRefe[2]
  RULE REXE

  -- third landing
  new STRLNG copy $!resultTemplate[1]
  !this.landingRefe[3]                 = (!!ce)
  !this.landingRefe[3].pos             = !pos.offset( U, !upPos[3] ).offset( !prmDir, ( !this.refe.opWidth.real() - !this.lngLength ) ).offset( !prmDir2, ( !this.refe.opLength.real() - !this.lngWidth ) )
  !this.landingRefe[3].lfaoffset       = !this.lngLength
  !this.landingRefe[3].lfboffset       = !this.lngWidth
  !this.landingRefe[3].asstmpreference = !resultTemplate[1]
  !this.landingRefe[3].thickn          =  !this.lngThk

  --set the thickness and other attributes to panel
  if ( !this.strLngTmplReference.purpose.eq('PANE') ) then

    !collPanel = object COLLECTION()
    !collPanel.scope(!this.landingRefe[3])
    !collPanel.type('PANE')
    !resultPanel = !collPanel.results()

    if ( !resultPanel.empty().not() ) then
      if ( !this.lngSpec.badref().not() ) then
        !resultPanel[1].spref = !this.lngSpec
      else
        !!ce = !resultPanel[1]
        spref nulref
      endif

      --collect the ploop and set the thickness
      !collPloo = object COLLECTION()
      !collPloo.scope(!resultPanel[1])
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()

      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    endif

  endif

  --navigate to gensec to change the spec
  !collGensec = object COLLECTION()
  !collGensec.scope(!!ce)
  !collGensec.type('GENSEC')
  !result = !collGensec.results()

  do !j from 1 to !result.size()
    !result[!j].spref            = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !result[!j].jusline          = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !result[!j].pos              = !result[!j].pos.offset( D, !this.lngThk )

    --collect the POINSP
    !collPspine         = object COLLECTION()
    !collPspine.scope(!result[!j])
    !collPspine.type('POINSP')
    !resultPspine       = !collPspine.results()

    !oldCe              = !!ce
    do !k from 1 to !resultPspine.size()
      --eval the pos Rule
      if ( !j.eq(1) and !k.eq(1) ) then
        --set the pose Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 ) )
      elseif ( !j.eq(1) and !k.eq(2) ) then
        --set the pos Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  ) )
      elseif ( !j.eq(2) and !k.eq(1) ) then
        --set the pose Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ATTRIB OPLENGTH OF STRTWR  / 2 ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )
      elseif ( !j.eq(2) and !k.eq(2) ) then
        --set the pose Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )
      endif
    enddo

  enddo

  !!ce = !oldCe

  if ( !!aslStrTwr.createTwrStl.val.eq(false) ) then

    --first gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  + ATTRIB PARA[2 ] OF GENSEC  / 2 ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ATTRIB OPLENGTH OF STRTWR  / 2 ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  + ATTRIB PARA[2 ] OF GENSEC  / 2 ) )

    --second gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  + DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2  ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG + DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 )  ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  ) )

  endif

  --execute the Rule
  !!ce = !this.landingRefe[3]
  RULE REXE

  -- fourth landing
  new STRLNG copy $!resultTemplate[1]
  !this.landingRefe[4]                 = (!!ce)
  !this.landingRefe[4].pos             = !pos.offset(U, !upPos[4] ).offset( !prmDir2, ( !this.refe.opLength.real() - !this.lngWidth ) )
  !this.landingRefe[4].lfaoffset       = !this.lngLength
  !this.landingRefe[4].lfboffset       = !this.lngWidth
  !this.landingRefe[4].asstmpreference = !resultTemplate[1]
  !this.landingRefe[4].thickn          = !this.lngThk

  --set the thickness and other attributes to panel
  if ( !this.strLngTmplReference.purpose.eq('PANE') ) then

    !collPanel = object COLLECTION()
    !collPanel.scope(!this.landingRefe[4])
    !collPanel.type('PANE')
    !resultPanel = !collPanel.results()

    if ( !resultPanel.empty().not() ) then
      if ( !this.lngSpec.badref().not() ) then
        !resultPanel[1].spref = !this.lngSpec
      else
        !!ce = !resultPanel[1]
        spref nulref
      endif

      --collect the ploop and set the thickness
      !collPloo = object COLLECTION()
      !collPloo.scope(!resultPanel[1])
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()

      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    endif

  endif

  --navigate to gensec to change the spec
  !collGensec = object COLLECTION()
  !collGensec.scope(!!ce)
  !collGensec.type('GENSEC')
  !result = !collGensec.results()

  do !j from 1 to !result.size()
    !result[!j].spref            = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !result[!j].jusline          = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !result[!j].pos              = !result[!j].pos.offset( D, !this.lngThk )

    --collect the POINSP
    !collPspine         = object COLLECTION()
    !collPspine.scope(!result[!j])
    !collPspine.type('POINSP')
    !resultPspine       = !collPspine.results()

    !oldCe              = !!ce
    do !k from 1 to !resultPspine.size()
      --eval the pos Rule
      if ( !j.eq(1) and !k.eq(1) ) then
        --set the pose Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 ) )
      elseif ( !j.eq(1) and !k.eq(2) ) then
        --set the pos Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  ) )
      elseif ( !j.eq(2) and !k.eq(1) ) then
        --set the pose Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  + DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )
      elseif ( !j.eq(2) and !k.eq(2) ) then
        --set the pose Rule
        !!ce = !resultPspine[!k]
        RULE set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ATTRIB OPLENGTH OF STRTWR  / 2 ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG  + DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )
      endif
    enddo

  enddo
  !!ce = !oldCe

  if ( !!aslStrTwr.createTwrStl.val.eq(false) ) then

    --first gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG  ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ATTRIB OPLENGTH OF STRTWR  / 2 ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) )

    --second gensec along the sides
    !gensecRefe         = object DBREF()
    !gensecRefe         = !!aslCreate('GENSEC', !gensecRefe )
    !gensecRefe.spref   = /$!tieBeamProfData.twrStlTieBeamProfile[1].sprefsteeltieup
    !gensecRefe.jusline = !tieBeamProfData.twrStlTieBeamProfile[1].tplinejustification
    !gensecRefe.pos     = E0 N0 D $!this.lngThk wrt STRLNG
    !gensecRefe.bang    = 180

    !spineRefe          = object DBREF()
    !spineRefe          = !!aslCreate('SPINE', !spineRefe)
    !spineRefe.ydir     = D

    !poinspRefe1        = object DBREF()
    !poinspRefe1        = !!aslCreate('POINSP', !poinspRefe1)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG + DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 - ATTRIB LFAOFFSET OF STRLNG   ) )

    !poinspRefe2        = object DBREF()
    !poinspRefe2        = !!aslCreate('POINSP', !poinspRefe2)
    rule set POS Static Rule ( W ( IFTRUE ( ATTRIB INTSEN OF STRTWR  , 1 , -1 ) * ( ATTRIB OPLENGTH OF STRTWR  / 2 - ATTRIB LFBOFFSET OF STRLNG + DISTCONVERT( ATTRIB RPRO WIDT OF GENSEC  / 2 ) ) ) S ( ATTRIB OPWIDTH OF STRTWR  / 2 ) )

  endif

  --execute the Rule
  !!ce = !this.landingRefe[4]
  RULE REXE

  --create the handrail
  !this.updateHandraDB()

  --create other landings
  do !i from 5 to !upPos.size() by 4
    new STRLNG copy $!this.landingRefe[1]
    !this.landingRefe[!i]           = (!!ce)
    !this.landingRefe[!i].pos       = !pos.offset(U, !upPos[!i])
    !!fmsys.setProgress( ( !i * 1.5 ) + 45 )
  enddo

  do !i from 6 to !upPos.size() by 4
    new STRLNG copy $!this.landingRefe[2]
    !this.landingRefe[!i]           = (!!ce)
    !this.landingRefe[!i].pos       = !pos.offset(U, !upPos[!i] ).offset( !prmDir, ( !this.refe.opWidth - !this.lngLength ) )
    !!fmsys.setProgress( ( !i * 1.5 ) + 65 )
  enddo

  do !i from 7 to !upPos.size() by 4
    new STRLNG copy $!this.landingRefe[3]
    !this.landingRefe[!i]           = (!!ce)
    !this.landingRefe[!i].pos       = !pos.offset( U, !upPos[!i] ).offset( !prmDir, ( !this.refe.opWidth - !this.lngLength ) ).offset( !prmDir2, ( !this.refe.opLength.real() - !this.lngWidth ) )
    !!fmsys.setProgress( ( !i * 1.25 ) + 75 )
  enddo
  !!fmsys.setProgress(65)
  do !i from 8 to !upPos.size() by 4
    new STRLNG copy $!this.landingRefe[4]
    !this.landingRefe[!i]           = (!!ce)
    !this.landingRefe[!i].pos       = !pos.offset(U, !upPos[!i] ).offset( !prmDir2, ( !this.refe.opWidth - !this.lngWidth ) )
    !!fmsys.setProgress( ( !i * 1 ) + 85 )
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      modifyOneStrLngDb
--
-- Description: modify the landing configuration based on the template selection
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type]    [Description]
--    1     R     ARRAY        FFL Elevation
--    2     R     ARRAY        landing to be modified
--    3     R     ARRAY        Landing template
--    4     R     POSITION     Stair tower position
--
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .modifyOneStrLngDb(!upPos is ARRAY, !resultLng is ARRAY, !resultTemplate is ARRAY, !pos is POSITION)

  --check if the up pos is less than the result landing then delete it
  if ( !upPos.size().lt(!resultLng.size()) ) then
    do !i from ( !upPos.size() + 1 ) to !resultLng.size()
      !!ce = !resultLng[!i]
      delete STRLNG
    enddo
  elseif ( !upPos.size().gt(!resultLng.size()) ) then
    do !i from ( !resultLng.size() + 1 ) to !upPos.size()
      new STRLNG copy $!resultLng[1]
      !resultLng.append(!!ce)
    enddo
  endif

  --change the model and update it
  do !i from 1 to !upPos.size()
    --navigate to the first element
    !!ce = !resultLng[!i]
    !this.landingRefe[!i]                 = (!!ce)
    !this.landingRefe[!i].pos             = !pos.offset(U, !upPos[!i])
    !this.landingRefe[!i].lfaoffset       = !this.lngLength
    !this.landingRefe[!i].lfboffset       = !this.lngWidth
    !oldStrLngTmplReference               = !this.landingRefe[!i].asstmpreference

    --copy the panel if the catalogue has been changed to Panel
    if ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then

      --make the thickness to zero
      !this.landingRefe[!i].thickn        = 0

      --collect the panel for copying
      !collPane = object COLLECTION()
      !collPane.scope(!resultTemplate[1])
      !collPane.type('PANE')
      !resultTmplPane = !collPane.results()

      --collect the pane for the landing
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.set() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif
      elseif ( !resultPanel.empty() ) then
        --copy the panel
        new PANE copy $!resultTmplPane[1]
        !!ce.spref = !this.lngSpec
      endif

      --set the thickness and other attributes to panel
      !collPloo = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    --remove the panel if the template has been changed to Concrete
    elseif ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('CONC') ) then
      --update the thickness
      !this.landingRefe[!i].thickn  = !this.lngThk
      --collect the panel for deletion
      !collPane   = object COLLECTION()
      !collPane.scope(!this.landingRefe[!i])
      !collPane.type('PANE')
      !resultPane = !collPane.results()
      --delete the pane
      if ( !resultPane.set() ) then
        !!ce      = !resultPane[1]
        delete PANE
      endif
    elseif ( !this.strLngTmplReference.eq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then
      --change the SPEC
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.empty().not() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif

        --collect the ploop and set the thickness
        !collPloo = object COLLECTION()
        !collPloo.scope(!resultPanel[1])
        !collPloo.type('PLOO')
        !resultPloo = !collPloo.results()

        --set the spref and the thickness for the panel
        if ( !resultPloo.empty().not() ) then
          !!ce        = !resultPloo[1]
          !!ce.height = !this.lngThk
        endif
      endif
    endif

    !this.landingRefe[!i].asstmpreference = !resultTemplate[1]
      !this.landingRefe[!i].description     = !resultTemplate[1].description

    --change the up position for the gensec
    !collGensec = object COLLECTION()
    !collGensec.scope(!this.landingRefe[!i])
    !collGensec.type('GENSEC')
    !resultGensec = !collGensec.results()

    !gensec = object ARRAY()
    do !m values !resultGensec
      if ( !m.own.type.eq('STRLNG') ) then
        !gensec.append(!m)
      endif
    enddo

    if ( !gensec.empty().not() ) then
      do !k from 1 to !gensec.size()
        --update the up position
        !gensec[!k].position = E0 N0 D $!this.lngThk WRT STRLNG
      enddo
    endif

    !!fmsys.setProgress( ( !i * 3 ) + 35 )
    --modify the handrail
    !this.modifyOneLngHandraDB(!resultLng[!i], !i)

    --execute the rule
    !!ce = !resultLng[!i]
    RULE REXE

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyTwoStrLngDb
--
-- Description: modify the landing configuration based on the template selection
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type]    [Description]
--    1     R     ARRAY        FFL Elevation
--    2     R     ARRAY        landing to be modified
--    3     R     ARRAY        Landing template
--    4     R     POSITION     Stair tower position
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .modifyTwoStrLngDb(!upPos is ARRAY, !resultLng is ARRAY, !resultTemplate is ARRAY, !pos is POSITION)

  --check if the up pos is less than the result landing then delete it
  if ( !upPos.size().lt(!resultLng.size()) ) then
    do !i from ( !upPos.size() + 1 ) to !resultLng.size()
      !!ce = !resultLng[!i]
      delete STRLNG
    enddo
  elseif ( !upPos.size().gt(!resultLng.size()) ) then
    do !i from ( !resultLng.size() + 1 ) to !upPos.size()
      new STRLNG copy $!resultLng[1]
      !resultLng.append(!!ce)
    enddo
  endif

  --change the model and update it (inwards Landing)
  do !i from 1 to !upPos.size() by 2
    --navigate to the first element
    !!ce                                  = !resultLng[!i]
    !side                                 = 'INNER'
    !this.landingRefe[!i]                 = (!!ce)
    !this.landingRefe[!i].pos             = !pos.offset(U, !upPos[!i])
    !this.landingRefe[!i].orientation     = Y is N wrt owner
    !this.landingRefe[!i].lfaoffset       = !this.lngLength
    !this.landingRefe[!i].lfboffset       = !this.lngWidth
    !oldStrLngTmplReference               = !this.landingRefe[!i].asstmpreference

    --copy the panel if the catalogue has been changed to Panelised
    if ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then

      --make the thickness to zero
      !this.landingRefe[!i].thickn        = 0

      --collect the panel for copying
      !collPane = object COLLECTION()
      !collPane.scope(!resultTemplate[1])
      !collPane.type('PANE')
      !resultTmplPane = !collPane.results()

      --collect the pane for the landing
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.set() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif
      elseif ( !resultPanel.empty() ) then
        --copy the panel
        new PANE copy $!resultTmplPane[1]
        !!ce.spref = !this.lngSpec
      endif

      --set the thickness and other attributes to panel
      !collPloo = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    --remove the panel if the template has been changed to Concrete
    elseif ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('CONC') ) then
      --update the thickness
      !this.landingRefe[!i].thickn  = !this.lngThk
      --collect the panel for deletion
      !collPane   = object COLLECTION()
      !collPane.scope(!this.landingRefe[!i])
      !collPane.type('PANE')
      !resultPane = !collPane.results()
      --delete the pane
      if ( !resultPane.set() ) then
        !!ce      = !resultPane[1]
        delete PANE
      endif
    elseif ( !this.strLngTmplReference.eq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then
      --change the SPEC
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.empty().not() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif

        --collect the ploop and set the thickness
        !collPloo = object COLLECTION()
        !collPloo.scope(!resultPanel[1])
        !collPloo.type('PLOO')
        !resultPloo = !collPloo.results()

        --set the spref and the thickness for the panel
        if ( !resultPloo.empty().not() ) then
          !!ce        = !resultPloo[1]
          !!ce.height = !this.lngThk
        endif
      endif
    endif

    !this.landingRefe[!i].asstmpreference = !resultTemplate[1]
    !this.landingRefe[!i].description     = !resultTemplate[1].description

    --change the up position for the gensec
    !collGensec = object COLLECTION()
    !collGensec.scope(!this.landingRefe[!i])
    !collGensec.type('GENSEC')
    !resultGensec = !collGensec.results()

    !gensec = object ARRAY()
    do !m values !resultGensec
      if ( !m.own.type.eq('STRLNG') ) then
        !gensec.append(!m)
      endif
    enddo

    if ( !gensec.empty().not() ) then
      do !k from 1 to !gensec.size()
        --update the up position
        !gensec[!k].position = E0 N0 D $!this.lngThk WRT STRLNG
      enddo
    endif

    !!fmsys.setProgress( ( !i * 3 ) + 35 )
    --modify the handrail
    !this.modifyTwoLngHandraDB(!resultLng[!i], !i, !side)

    --execute the rule
    !!ce  = !resultLng[!i]
    RULE REXE

  enddo


  --change the model and update it (outward landing)
  do !i from 2 to !upPos.size() by 2
    --navigate to the first element
    !!ce                                  = !resultLng[!i]
    !side                                 = 'OUTER'
    !this.landingRefe[!i]                 = (!!ce)
    !this.landingRefe[!i].pos             = !pos.offset(U, !upPos[!i])
    !this.landingRefe[!i].orientation     = Y is S wrt owner
    !this.landingRefe[!i].lfaoffset       = !this.lngLength
    !this.landingRefe[!i].lfboffset       = !this.lngWidth
    !oldStrLngTmplReference               = !this.landingRefe[!i].asstmpreference

    --copy the panel if the catalogue has been changed to Panelised
    if ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then

      --make the thickness to zero
      !this.landingRefe[!i].thickn        = 0

      --collect the panel for copying
      !collPane = object COLLECTION()
      !collPane.scope(!resultTemplate[1])
      !collPane.type('PANE')
      !resultTmplPane = !collPane.results()

      --collect the pane for the landing
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.set() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif
      elseif ( !resultPanel.empty() ) then
        --copy the panel
        new PANE copy $!resultTmplPane[1]
        !!ce.spref = !this.lngSpec
      endif

      --set the thickness and other attributes to panel
      !collPloo = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    --remove the panel if the template has been changed to Concrete
    elseif ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('CONC') ) then
      --update the thickness
      !this.landingRefe[!i].thickn  = !this.lngThk
      --collect the panel for deletion
      !collPane   = object COLLECTION()
      !collPane.scope(!this.landingRefe[!i])
      !collPane.type('PANE')
      !resultPane = !collPane.results()
      --delete the pane
      if ( !resultPane.set() ) then
        !!ce      = !resultPane[1]
        delete PANE
      endif
    elseif ( !this.strLngTmplReference.eq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then
      --change the SPEC
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.empty().not() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif

        --collect the ploop and set the thickness
        !collPloo = object COLLECTION()
        !collPloo.scope(!resultPanel[1])
        !collPloo.type('PLOO')
        !resultPloo = !collPloo.results()

        --set the spref and the thickness for the panel
        if ( !resultPloo.empty().not() ) then
          !!ce        = !resultPloo[1]
          !!ce.height = !this.lngThk
        endif
      endif
    endif

    !this.landingRefe[!i].asstmpreference = !resultTemplate[1]
    !this.landingRefe[!i].description     = !resultTemplate[1].description

    --change the up position for the gensec
    !collGensec = object COLLECTION()
    !collGensec.scope(!this.landingRefe[!i])
    !collGensec.type('GENSEC')
    !resultGensec = !collGensec.results()

    !gensec = object ARRAY()
    do !m values !resultGensec
      if ( !m.own.type.eq('STRLNG') ) then
        !gensec.append(!m)
      endif
    enddo

    if ( !gensec.empty().not() ) then
      do !k from 1 to !gensec.size()
        --update the up position
        !gensec[!k].position = E0 N0 D $!this.lngThk WRT STRLNG
      enddo
    endif

    RULE REXE

    !!fmsys.setProgress( ( !i * 3 ) + 35 )
    --modify the handrail
    !this.modifyTwoLngHandraDB(!resultLng[!i], !i, !side)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyThreeStrLngDb
--
-- Description: modify the landing configuration based on the template selection
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type]    [Description]
--    1     R     ARRAY        FFL Elevation
--    2     R     ARRAY        landing to be modified
--    3     R     ARRAY        Landing template
--    4     R     POSITION     Stair tower position
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .modifyThreeStrLngDb(!upPos is ARRAY, !resultLng is ARRAY, !resultTemplate is ARRAY, !pos is POSITION)

  --check if the up position is less than the result landing then delete it
  if ( !upPos.size().lt(!resultLng.size()) ) then
    do !i from ( !upPos.size() + 1 ) to !resultLng.size()
      !!ce = !resultLng[!i]
      delete STRLNG
    enddo
  endif

  !purpBottom = object EXPRESSION( 'matchwild(desc,|*Bottom| )' )
  !purpLeft   = object EXPRESSION( 'matchwild(desc,|*Left| )' )
  !purpRight  = object EXPRESSION( 'matchwild(desc,|*Right| )' )

  !collBottom   = object COLLECTION()
  !collBottom.scope(!this.refe)
  !collBottom.filter(!purpBottom)
  !resultBottom = !collBottom.results()

  !collLeft    = object COLLECTION()
  !collLeft.scope(!this.refe)
  !collLeft.filter(!purpLeft)
  !resultLeft  = !collLeft.results()

  !collRight   = object COLLECTION()
  !collRight.scope(!this.refe)
  !collRight.filter(!purpRight)
  !resultRight = !collRight.results()

  --change the model and update it
  !j = 1
  do !i from 1 to !upPos.size() by 3
    --navigate to the first element
    if ( !i.gt(!resultLng.size()) ) then
      new STRLNG copy $!resultLng[1]
      !resultBottom.append(!!ce)
    endif

    !!ce                                  = !resultBottom[!j]
    !this.landingRefe[!i]                 = (!!ce)
    !this.landingRefe[!i].pos             = !pos.offset(U, !upPos[!i])
    !this.landingRefe[!i].orientation     = Y is N wrt owner
    !this.landingRefe[!i].lfaoffset       = !this.lngLength
    !this.landingRefe[!i].lfboffset       = !this.lngWidth
    !oldStrLngTmplReference               = !this.landingRefe[!i].asstmpreference

    --copy the panel if the catalogue has been changed to Panelised
    if ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then

      --make the thickness to zero
      !this.landingRefe[!i].thickn        = 0

      --collect the panel for copying
      !collPane = object COLLECTION()
      !collPane.scope(!resultTemplate[1])
      !collPane.type('PANE')
      !resultTmplPane = !collPane.results()

      --collect the pane for the landing
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.set() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif
      elseif ( !resultPanel.empty() ) then
        --copy the panel
        new PANE copy $!resultTmplPane[1]
        !!ce.spref = !this.lngSpec
      endif

      --set the thickness and other attributes to panel
      !collPloo = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    --remove the panel if the template has been changed to Concrete
    elseif ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('CONC') ) then
      --update the thickness
      !this.landingRefe[!i].thickn  = !this.lngThk
      --collect the panel for deletion
      !collPane   = object COLLECTION()
      !collPane.scope(!this.landingRefe[!i])
      !collPane.type('PANE')
      !resultPane = !collPane.results()
      --delete the pane
      if ( !resultPane.set() ) then
        !!ce      = !resultPane[1]
        delete PANE
      endif
    elseif ( !this.strLngTmplReference.eq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then
      --set the thickness and other attributes to panel
      !collPloo    = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo  = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !!ce        = !resultPloo[1]
        !!ce.height = !this.lngThk
      endif
    endif

    !this.landingRefe[!i].asstmpreference = !resultTemplate[1]
    !this.landingRefe[!i].description     = !resultTemplate[1].description

    --change the up position for the gensec
    !collGensec = object COLLECTION()
    !collGensec.scope(!this.landingRefe[!i])
    !collGensec.type('GENSEC')
    !resultGensec = !collGensec.results()

    !gensec = object ARRAY()
    do !m values !resultGensec
      if ( !m.own.type.eq('STRLNG') ) then
        !gensec.append(!m)
      endif
    enddo

    if ( !gensec.empty().not() ) then
      do !k from 1 to !gensec.size()
        --update the up position
        !gensec[!k].position = E0 N0 D $!this.lngThk WRT STRLNG
      enddo
    endif

    --modify the handrail
    !this.modifyThreeLngHandraDB(!resultBottom[!j], !i)

    --execute the rule
    !!ce  =  !resultBottom[!j]
    RULE REXE

    !j = !j + 1

  enddo

  !j = 1
  do !i from 2 to !upPos.size() by 3

    --navigate to the first element
    if ( !i.gt(!resultLng.size()) ) then
      new STRLNG copy $!resultLeft[1]
      !resultLeft.append(!!ce)
    endif

    !!ce                                  = !resultLeft[!j]
    !this.landingRefe[!i]                 = (!!ce)
    !this.landingRefe[!i].pos             = !pos.offset(U, !upPos[!i])
    !this.landingRefe[!i].orientation     = Y is N wrt owner
    !this.landingRefe[!i].lfboffset       = !this.lngLength
    !this.landingRefe[!i].lfaoffset       = !this.lngWidth
    !oldStrLngTmplReference               = !this.landingRefe[!i].asstmpreference

    --copy the panel if the catalogue has been changed to Panelised
    if ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then

      --make the thickness to zero
      !this.landingRefe[!i].thickn        = 0

      --collect the panel for copying
      !collPane = object COLLECTION()
      !collPane.scope(!resultTemplate[2])
      !collPane.type('PANE')
      !resultTmplPane = !collPane.results()

      --collect the pane for the landing
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.set() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif
      elseif ( !resultPanel.empty() ) then
        --copy the panel
        new PANE copy $!resultTmplPane[1]
        !!ce.spref = !this.lngSpec
      endif

      --set the thickness and other attributes to panel
      !collPloo = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    --remove the panel if the template has been changed to Concrete
    elseif ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('CONC') ) then
      --update the thickness
      !this.landingRefe[!i].thickn  = !this.lngThk
      --collect the panel for deletion
      !collPane   = object COLLECTION()
      !collPane.scope(!this.landingRefe[!i])
      !collPane.type('PANE')
      !resultPane = !collPane.results()
      --delete the pane
      if ( !resultPane.set() ) then
        !!ce      = !resultPane[1]
        delete PANE
      endif
    elseif ( !this.strLngTmplReference.eq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then
      --set the thickness and other attributes to panel
      !collPloo    = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo  = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !!ce        = !resultPloo[1]
        !!ce.height = !this.lngThk
      endif
    endif

    !this.landingRefe[!i].asstmpreference = !resultTemplate[1]
    !this.landingRefe[!i].description     = !resultTemplate[2].description

    --change the up position for the gensec
    !collGensec = object COLLECTION()
    !collGensec.scope(!this.landingRefe[!i])
    !collGensec.type('GENSEC')
    !resultGensec = !collGensec.results()

    !gensec = object ARRAY()
    do !m values !resultGensec
      if ( !m.own.type.eq('STRLNG') ) then
        !gensec.append(!m)
      endif
    enddo

    if ( !gensec.empty().not() ) then
      do !k from 1 to !gensec.size()
        --update the up position
        !gensec[!k].position = E0 N0 D $!this.lngThk WRT STRLNG
      enddo
    endif

    --modify the handrail
    !this.modifyThreeLngHandraDB(!resultLeft[!j], !i)

    --execute the rule
    !!ce  =  !resultLeft[!j]
    RULE REXE

    !j = !j + 1
  enddo

  !j = 1
  do !i from 3 to !upPos.size() by 3
    --navigate to the first element
    if ( !i.gt(!resultLng.size()) ) then
      new STRLNG copy $!resultRight[1]
      !resultRight.append(!!ce)
    endif

    !!ce                                  = !resultRight[!j]
    !this.landingRefe[!i]                 = (!!ce)
    !this.landingRefe[!i].pos             = !pos.offset(U, !upPos[!i])
    !this.landingRefe[!i].orientation     = Y is N wrt owner
    !this.landingRefe[!i].lfboffset       = !this.lngLength
    !this.landingRefe[!i].lfaoffset       = !this.lngWidth
    !oldStrLngTmplReference               = !this.landingRefe[!i].asstmpreference

    --copy the panel if the catalogue has been changed to Panelised
    if ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then

      --make the thickness to zero
      !this.landingRefe[!i].thickn        = 0

      --collect the panel for copying
      !collPane = object COLLECTION()
      !collPane.scope(!resultTemplate[3])
      !collPane.type('PANE')
      !resultTmplPane = !collPane.results()

      --collect the pane for the landing
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.set() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif
      elseif ( !resultPanel.empty() ) then
        --copy the panel
        new PANE copy $!resultTmplPane[1]
        !!ce.spref = !this.lngSpec
      endif

      --set the thickness and other attributes to panel
      !collPloo = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    --remove the panel if the template has been changed to Concrete
    elseif ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('CONC') ) then
      --update the thickness
      !this.landingRefe[!i].thickn  = !this.lngThk
      --collect the panel for deletion
      !collPane   = object COLLECTION()
      !collPane.scope(!this.landingRefe[!i])
      !collPane.type('PANE')
      !resultPane = !collPane.results()
      --delete the pane
      if ( !resultPane.set() ) then
        !!ce      = !resultPane[1]
        delete PANE
      endif
    elseif ( !this.strLngTmplReference.eq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then
      --set the thickness and other attributes to panel
      !collPloo    = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo  = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !!ce        = !resultPloo[1]
        !!ce.height = !this.lngThk
      endif
    endif

    !this.landingRefe[!i].asstmpreference = !resultTemplate[1]
    !this.landingRefe[!i].description     = !resultTemplate[3].description

    --change the up position for the gensec
    !collGensec = object COLLECTION()
    !collGensec.scope(!this.landingRefe[!i])
    !collGensec.type('GENSEC')
    !resultGensec = !collGensec.results()

    !gensec = object ARRAY()
    do !m values !resultGensec
      if ( !m.own.type.eq('STRLNG') ) then
        !gensec.append(!m)
      endif
    enddo

    if ( !gensec.empty().not() ) then
      do !k from 1 to !gensec.size()
        --update the up position
        !gensec[!k].position = E0 N0 D $!this.lngThk WRT STRLNG
      enddo
    endif

    --modify the handrail
    !this.modifyThreeLngHandraDB(!resultRight[!j], !i)

    --execute the rule
    !!ce  =  !resultRight[!j]
    RULE REXE

    !j = !j + 1
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyFourStrLngDb
--
-- Description: modify the landing configuration based on the template selection
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type]    [Description]
--    1     R     ARRAY        FFL Elevation
--    2     R     ARRAY        landing to be modified
--    3     R     ARRAY        Landing template
--    4     R     POSITION     Stair tower position
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .modifyFourStrLngDb(!upPos is ARRAY, !resultLng is ARRAY, !resultTemplate is ARRAY, !pos is POSITION)

  --update based on the sense
  !senSe     = !this.refe.intSen
  !prmDir    = !this.refe.prmDirection
  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  --check if the up pos is less than the result landing then delete it
  if ( !upPos.size().lt(!resultLng.size()) ) then
    do !i from ( !upPos.size() + 1 ) to !resultLng.size()
      !!ce = !resultLng[!i]
      delete STRLNG
    enddo
  elseif ( !upPos.size().gt(!resultLng.size()) ) then
    do !i from ( !resultLng.size() + 1 ) to !upPos.size()
      new STRLNG copy $!resultLng[1]
      !resultLng.append(!!ce)
    enddo
  endif

  --inwards Landing
  do !i from 1 to !upPos.size() by 4

    --navigate to the first element
    !key                                  = 'ONE'
    !!ce                                  = !resultLng[!i]
    !this.landingRefe[!i]                 = (!!ce)
    !this.landingRefe[!i].pos             = !pos.offset(U, !upPos[!i] )
    !this.landingRefe[!i].lfaoffset       = !this.lngLength
    !this.landingRefe[!i].lfboffset       = !this.lngWidth
    !oldStrLngTmplReference               = !this.landingRefe[!i].asstmpreference

    --copy the panel if the catalogue has been changed to Panelised
    if ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then

      --make the thickness to zero
      !this.landingRefe[!i].thickn        = 0

      --collect the panel for copying
      !collPane = object COLLECTION()
      !collPane.scope(!resultTemplate[1])
      !collPane.type('PANE')
      !resultTmplPane = !collPane.results()

      --collect the pane for the landing
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.set() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif
      elseif ( !resultPanel.empty() ) then
        --copy the panel
        new PANE copy $!resultTmplPane[1]
        !!ce.spref = !this.lngSpec
      endif

      --set the thickness and other attributes to panel
      !collPloo = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    --remove the panel if the template has been changed to Concrete
    elseif ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('CONC') ) then
      --update the thickness
      !this.landingRefe[!i].thickn  = !this.lngThk
      --collect the panel for deletion
      !collPane   = object COLLECTION()
      !collPane.scope(!this.landingRefe[!i])
      !collPane.type('PANE')
      !resultPane = !collPane.results()
      --delete the pane
      if ( !resultPane.set() ) then
        !!ce      = !resultPane[1]
        delete PANE
      endif
    elseif ( !this.strLngTmplReference.eq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then
      --set the thickness and other attributes to panel
      !collPloo    = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo  = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !!ce        = !resultPloo[1]
        !!ce.height = !this.lngThk
      endif
    endif

    !this.landingRefe[!i].asstmpreference = !resultTemplate[1]
    !this.landingRefe[!i].description     = !resultTemplate[1].description

    --change the up position for the gensec
    !collGensec = object COLLECTION()
    !collGensec.scope(!this.landingRefe[!i])
    !collGensec.type('GENSEC')
    !resultGensec = !collGensec.results()

    !gensec = object ARRAY()
    do !m values !resultGensec
      if ( !m.own.type.eq('STRLNG') ) then
        !gensec.append(!m)
      endif
    enddo

    if ( !gensec.empty().not() ) then
      do !j from 1 to !gensec.size()
        --update the up position
        !gensec[!j].position = E0 N0 D $!this.lngThk WRT STRLNG
      enddo
    endif

    --modify the handrail
    !this.modifyFourLngHandraDB(!resultLng[!i], !i, !key)

    --execute the rule
    !!ce  =  !resultLng[!i]
    RULE REXE

  enddo

  do !i from 2 to !upPos.size() by 4

    --navigate to the first element
    !key                                  = 'TWO'
    !!ce                                  = !resultLng[!i]
    !this.landingRefe[!i]                 = (!!ce)
    !this.landingRefe[!i].pos             = !pos.offset(U, !upPos[!i] ).offset( !prmDir, ( !this.refe.opWidth.real() - !this.lngLength ) )
    !this.landingRefe[!i].lfaoffset       = !this.lngLength
    !this.landingRefe[!i].lfboffset       = !this.lngWidth
    !oldStrLngTmplReference               = !this.landingRefe[!i].asstmpreference

    --copy the panel if the catalogue has been changed to Panelised
    if ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then

      --make the thickness to zero
      !this.landingRefe[!i].thickn        = 0

      --collect the panel for copying
      !collPane = object COLLECTION()
      !collPane.scope(!resultTemplate[1])
      !collPane.type('PANE')
      !resultTmplPane = !collPane.results()

      --collect the pane for the landing
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.set() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif
      elseif ( !resultPanel.empty() ) then
        --copy the panel
        new PANE copy $!resultTmplPane[1]
        !!ce.spref = !this.lngSpec
      endif

      --set the thickness and other attributes to panel
      !collPloo = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    --remove the panel if the template has been changed to Concrete
    elseif ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('CONC') ) then
      --update the thickness
      !this.landingRefe[!i].thickn  = !this.lngThk
      --collect the panel for deletion
      !collPane   = object COLLECTION()
      !collPane.scope(!this.landingRefe[!i])
      !collPane.type('PANE')
      !resultPane = !collPane.results()
      --delete the pane
      if ( !resultPane.set() ) then
        !!ce      = !resultPane[1]
        delete PANE
      endif
    elseif ( !this.strLngTmplReference.eq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then
      --set the thickness and other attributes to panel
      !collPloo    = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo  = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !!ce        = !resultPloo[1]
        !!ce.height = !this.lngThk
      endif
    endif

    !this.landingRefe[!i].asstmpreference = !resultTemplate[1]
    !this.landingRefe[!i].description     = !resultTemplate[1].description

    --change the up position for the gensec
    !collGensec = object COLLECTION()
    !collGensec.scope(!this.landingRefe[!i])
    !collGensec.type('GENSEC')
    !resultGensec = !collGensec.results()

    !gensec = object ARRAY()
    do !m values !resultGensec
      if ( !m.own.type.eq('STRLNG') ) then
        !gensec.append(!m)
      endif
    enddo

    if ( !gensec.empty().not() ) then
      do !j from 1 to !gensec.size()
        --update the up position
        !gensec[!j].position = E0 N0 D $!this.lngThk WRT STRLNG
      enddo
    endif

   --modify the handrail
    !this.modifyFourLngHandraDB(!resultLng[!i], !i, !key)

    --execute the rule
    !!ce  =  !resultLng[!i]
    RULE REXE

  enddo

  do !i from 3 to !upPos.size() by 4

    !key                                  = 'THREE'
    !!ce                                  = !resultLng[!i]
    !this.landingRefe[!i]                 = (!!ce)
    !this.landingRefe[!i].pos             = !pos.offset(U, !upPos[!i]).offset( !prmDir, ( !this.refe.opWidth.real() - !this.lngLength ) ).offset( !prmDir2, ( !this.refe.opLength.real() - !this.lngWidth ) )
    !this.landingRefe[!i].lfaoffset       = !this.lngLength
    !this.landingRefe[!i].lfboffset       = !this.lngWidth
    !oldStrLngTmplReference               = !this.landingRefe[!i].asstmpreference

    --copy the panel if the catalogue has been changed to Panelised
    if ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then

      --make the thickness to zero
      !this.landingRefe[!i].thickn        = 0

      --collect the panel for copying
      !collPane = object COLLECTION()
      !collPane.scope(!resultTemplate[1])
      !collPane.type('PANE')
      !resultTmplPane = !collPane.results()

      --collect the pane for the landing
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.set() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif
      elseif ( !resultPanel.empty() ) then
        --copy the panel
        new PANE copy $!resultTmplPane[1]
        !!ce.spref = !this.lngSpec
      endif

      --set the thickness and other attributes to panel
      !collPloo = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    --remove the panel if the template has been changed to Concrete
    elseif ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('CONC') ) then
      --update the thickness
      !this.landingRefe[!i].thickn  = !this.lngThk
      --collect the panel for deletion
      !collPane   = object COLLECTION()
      !collPane.scope(!this.landingRefe[!i])
      !collPane.type('PANE')
      !resultPane = !collPane.results()
      --delete the pane
      if ( !resultPane.set() ) then
        !!ce      = !resultPane[1]
        delete PANE
      endif
    elseif ( !this.strLngTmplReference.eq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then
      --set the thickness and other attributes to panel
      !collPloo    = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo  = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !!ce        = !resultPloo[1]
        !!ce.height = !this.lngThk
      endif
    endif

    !this.landingRefe[!i].asstmpreference = !resultTemplate[1]
    !this.landingRefe[!i].description     = !resultTemplate[1].description

    --change the up position for the gensec
    !collGensec = object COLLECTION()
    !collGensec.scope(!this.landingRefe[!i])
    !collGensec.type('GENSEC')
    !resultGensec = !collGensec.results()

    !gensec = object ARRAY()
    do !m values !resultGensec
      if ( !m.own.type.eq('STRLNG') ) then
        !gensec.append(!m)
      endif
    enddo

    if ( !gensec.empty().not() ) then
      do !j from 1 to !gensec.size()
        --update the up position
        !gensec[!j].position = E0 N0 D $!this.lngThk WRT STRLNG
      enddo
    endif

    --modify the handrail
    !this.modifyFourLngHandraDB(!resultLng[!i], !i, !key)

    --execute the rule
    !!ce  =  !resultLng[!i]
    RULE REXE

  enddo

  do !i from 4 to !upPos.size() by 4

    !key                                  = 'FOUR'
    !!ce                                  = !resultLng[!i]
    !this.landingRefe[!i]                 = (!!ce)
    !this.landingRefe[!i].pos             = !pos.offset(U, !upPos[!i]).offset( !prmDir2, ( !this.refe.opLength.real() - !this.lngWidth ) )
    !this.landingRefe[!i].lfaoffset       = !this.lngLength
    !this.landingRefe[!i].lfboffset       = !this.lngWidth
    !oldStrLngTmplReference               = !this.landingRefe[!i].asstmpreference

    --copy the panel if the catalogue has been changed to Panelised
    if ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then

      --make the thickness to zero
      !this.landingRefe[!i].thickn        = 0

      --collect the panel for copying
      !collPane = object COLLECTION()
      !collPane.scope(!resultTemplate[1])
      !collPane.type('PANE')
      !resultTmplPane = !collPane.results()

      --collect the pane for the landing
      !collPanel = object COLLECTION()
      !collPanel.scope(!this.landingRefe[!i])
      !collPanel.type('PANE')
      !resultPanel = !collPanel.results()

      if ( !resultPanel.set() ) then
        if ( !this.lngSpec.badref().not() ) then
          !resultPanel[1].spref = !this.lngSpec
        else
          !!ce = !resultPanel[1]
          spref nulref
        endif
      elseif ( !resultPanel.empty() ) then
        --copy the panel
        new PANE copy $!resultTmplPane[1]
        !!ce.spref = !this.lngSpec
      endif

      --set the thickness and other attributes to panel
      !collPloo = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !resultPloo[1].height = !this.lngThk
      endif

    --remove the panel if the template has been changed to Concrete
    elseif ( !this.strLngTmplReference.neq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('CONC') ) then
      --update the thickness
      !this.landingRefe[!i].thickn  = !this.lngThk
      --collect the panel for deletion
      !collPane   = object COLLECTION()
      !collPane.scope(!this.landingRefe[!i])
      !collPane.type('PANE')
      !resultPane = !collPane.results()
      --delete the pane
      if ( !resultPane.set() ) then
        !!ce      = !resultPane[1]
        delete PANE
      endif
    elseif ( !this.strLngTmplReference.eq(!oldStrLngTmplReference) and !this.strLngTmplReference.purpose.eq('PANE') ) then
      --set the thickness and other attributes to panel
      !collPloo    = object COLLECTION()
      !collPloo.scope(!!ce)
      !collPloo.type('PLOO')
      !resultPloo  = !collPloo.results()
      --set the spref and the thickness for the panel
      if ( !resultPloo.empty().not() ) then
        !!ce        = !resultPloo[1]
        !!ce.height = !this.lngThk
      endif
    endif

    !this.landingRefe[!i].asstmpreference = !resultTemplate[1]
    !this.landingRefe[!i].description     = !resultTemplate[1].description

    --change the up position for the gensec
    !collGensec = object COLLECTION()
    !collGensec.scope(!this.landingRefe[!i])
    !collGensec.type('GENSEC')
    !resultGensec = !collGensec.results()

    !gensec = object ARRAY()
    do !m values !resultGensec
      if ( !m.own.type.eq('STRLNG') ) then
        !gensec.append(!m)
      endif
    enddo

    if ( !gensec.empty().not() ) then
      do !j from 1 to !gensec.size()
        --update the up position
        !gensec[!j].position = E0 N0 D $!this.lngThk WRT STRLNG
      enddo
    endif

    --modify the handrail
    !this.modifyFourLngHandraDB(!resultLng[!i], !i, !key)

    --execute the rule
    !!ce  =  !resultLng[!i]
    RULE REXE

  enddo

endmethod
-- End of method
