  !prmDir    = !!aslStrTwr.meStrTwrEngine.strTwrData.prmDirection
  !prmDirOpp = !prmDir.opposite()
  --create the HANDRA
  !!ce = !this.landingRefe[1]
  do !j from 1 to !this.handraProfile.size()
    !handraObj = !this.meHandraEngine
    !this.handraProfile[!j].position = !pos.offset(U, !upPos[1])
    !handraObj.rpath.aslRpath(!this.handraProfile[!j])
      if ( !senSe.eq(false) ) then
        !handraObj.xoffset = -1
      elseif ( !senSe.eq(true) ) then
        !handraObj.xoffset = 1
      endif
    !handraObj.tmplReference(!handraObj.tmplReference)
    !!ce = !handraObj.updateDb()
    !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateThreeLngHandraDB
--
-- Description: updates the handrail the element for Three stairs
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateThreeLngHandraDB()

  --get the position details
  !upPos   = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !pos     = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !senSe   = !!aslStrTwr.meStrTwrEngine.strTwrData.clockWise

  !!ce = !this.landingRefe[1]
  do !j from 1 to 2
    !handraObj = !this.meHandraEngine
    --update the handrail profile data
    !this.handraProfile[!j].position = !pos.offset(U, !upPos[1])
    !handraObj.rpath.aslRpath(!this.handraProfile[!j])
      if ( !senSe.eq(false) ) then
        !handraObj.xoffset = -1
      elseif ( !senSe.eq(true) ) then
        !handraObj.xoffset = 1
      endif
    !handraObj.tmplReference(!handraObj.tmplReference)
    !!ce = !handraObj.updateDb()
    !!ce.purpose      = 'ILNG'
    if ( !j.eq(1) ) then
      !!ce.desc   = 'OUTER'
    elseif ( !j.eq(2) ) then
      !!ce.desc   = 'INNER'
    endif
  enddo

  --create the landing on the shorter left sides
  !!ce = !this.landingRefe[2]
  !handraObj = !this.meHandraEngine
  --update the handrail profile data
  !this.handraProfile[3].position = !pos.offset(U, !upPos[2])
  !handraObj.rpath.aslRpath(!this.handraProfile[3])
    if ( !senSe.eq(false) ) then
      !handraObj.xoffset = -1
    elseif ( !senSe.eq(true) ) then
      !handraObj.xoffset = 1
    endif
  !handraObj.tmplReference(!handraObj.tmplReference)
  !!ce = !handraObj.updateDb()
  !!ce.purpose      = 'ILNG'
  if ( !j.eq(1) ) then
    !!ce.desc   = 'OUTER'
  elseif ( !j.eq(2) ) then
    !!ce.desc   = 'INNER'
  endif

  --create the landing on the shorter left sides
  !!ce = !this.landingRefe[3]
  !handraObj = !this.meHandraEngine
  --update the handrail profile data
  !this.handraProfile[4].position = !pos.offset(U, !upPos[3])
  !handraObj.rpath.aslRpath(!this.handraProfile[4])
    if ( !senSe.eq(false) ) then
      !handraObj.xoffset = -1
    elseif ( !senSe.eq(true) ) then
      !handraObj.xoffset = 1
    endif
  !handraObj.tmplReference(!handraObj.tmplReference)
  !!ce = !handraObj.updateDb()
  !!ce.purpose      = 'ILNG'
  if ( !j.eq(1) ) then
    !!ce.desc   = 'OUTER'
  elseif ( !j.eq(2) ) then
    !!ce.desc   = 'INNER'
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateFourLngHandraDB
--
-- Description: updates the handrail the element for Four stairs
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateFourLngHandraDB()

  --get the position details
  !upPos   = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !pos     = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !senSe   = !!aslStrTwr.meStrTwrEngine.strTwrData.clockWise

  do !i from 1 to !this.landingRefe.size()
    --create the landing on the west sides corner
    !!ce = !this.landingRefe[!i]
    !handraObj = !this.meHandraEngine
    --update the handrail profile data
    !this.handraProfile[!i].position = !pos.offset(U, !upPos[!i])
    !handraObj.rpath.aslRpath(!this.handraProfile[!i])
      if ( !senSe.eq(false) ) then
        !handraObj.xoffset = -1
      elseif ( !senSe.eq(true) ) then
        !handraObj.xoffset = 1
      endif
    !handraObj.tmplReference(!handraObj.tmplReference)
    !!ce = !handraObj.updateDb()
    !!ce.purpose      = 'ILNG'
    !!ce.desc         = 'OUTER'
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyStrLngDB
--
-- Description: updates the handrail element which is already defined
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .modifyStrLngDB(!resultLng is ARRAY)

  --initialise the variables
  !pos             = !this.refe.pos
  !tieBeamProfData = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile
  !upPos           = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr

  --update the this.refe
  !this.refe.colxspacing[1] = !!aslStrTwr.meStrTwrEngine.strTwrData.xLength
  !this.refe.colyspacing[1] = !!aslStrTwr.meStrTwrEngine.strTwrData.yLength

  --initialise for collection
  !install = !this.installationOption.split()
  !instOpt = !install[1].upcase().trim()
  !tempRef = !this.strLngTmplReference

  -- check that the stair Landing exists
  !purposeTemplate = object EXPRESSION()
  !purposeTemplate.expression('FUNC eq !instOpt')

  !collectionTemplate = object COLLECTION()
  !collectionTemplate.scope(!tempRef)
  !collectionTemplate.type('STRLNG')
  !collectionTemplate.filter(!purposeTemplate)
  !resultTemplate = !collectionTemplate.results()

  --check for the equality of the collection
  if ( !this.installationOption.eq('One stair, stair north') ) then
    !this.modifyOneStrLngDb( !upPos, !resultLng, !resultTemplate, !pos )
  elseif( !this.installationOption.eq('Two stairs, platform north and south') ) then
    !this.modifyTwoStrLngDb( !upPos, !resultLng, !resultTemplate, !pos )
  elseif( !this.installationOption.eq('Three stairs, platform south') ) then
    !this.modifyThreeStrLngDb( !upPos, !resultLng, !resultTemplate, !pos )
  elseif( !this.installationOption.eq('Four stairs') ) then
    !this.modifyFourStrLngDb( !upPos, !resultLng, !resultTemplate, !pos )
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyOneLngHandraDB
--
-- Description: modifies the handrail the element for two stairs
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .modifyOneLngHandraDB(!resultLng is DBREF, !elevIndex is REAL)

  --get the defaults for calculation
  !prmDir        = !!aslStrTwr.meStrTwrEngine.strTwrData.prmDirection
  !pos           = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !xLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.xLength
  !yLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.yLength
  !zLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.zLength
  !clxLen        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltClXSpacing
  !clyLen        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltClYSpacing
  !fltWdt        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltWidth
  !upPos         = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !lngWidth      = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
  !lngLength     = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
  !fflLevelElev  = !!aslStrTwr.neFflLevel.getrows()
  !senSe         = !!aslStrTwr.meStrTwrEngine.strTwrData.clockWise
  !width         = !this.lngWidth
  !length        = !this.lngLength
  !ori           = y is $!prmDir

  --update based on the sense
  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  if ( !resultLng.desc.upcase().matchwild('*NORTH') ) then

    --collect handra for ce
    !collHandra = object COLLECTION()
    !collHandra.scope(!resultLng)
    !collHandra.type('HANDRA')
    !resultHandra = !collHandra.results()

    if ( !resultHandra.empty() ) then
      --!this.updateHandrailProfile()
      --!!alert.error('No Handrail to Modify')
      --return
    endif

    --initialise the variables
    !this.handraProfile = object ARRAY()
    !proLine  = object ARRAY()

    if ( !this.updateHandrail.eq(true) ) then
      !line0 = object LINE()
      !line0.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, ( ( !clyLen / 2 ) + ( !fltWdt / 2 ) ) )
      !line0.endPosition   = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
      if ( !line0.startPosition.neq(!line0.endPosition) and !line0.length().gt(100mm)) then
        !proLine.append(!line0)
      endif
    endif

    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir1, !width )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir.opposite(), !yLen )

    !line3 = object LINE()
    !line3.startPosition = !line2.endPosition
    !line3.endPosition   = !line3.startPosition.offset( !prmDir2, !xLen )

    !line4 = object LINE()
    !line4.startPosition = !line3.endPosition
    !line4.endPosition   = !line4.startPosition.offset( !prmDir, !yLen )

    !line5 = object LINE()
    !line5.startPosition = !line4.endPosition
    !line5.endPosition   = !line5.startPosition.offset( !prmDir1, !width )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)
    !proLine.append(!line3)
    !proLine.append(!line4)
    !proLine.append(!line5)

    if ( !this.updateHandrail.eq(true) ) then
      !line6 = object LINE()
      !line6.startPosition = !line5.endPosition
      !line6.endPosition   = !pos.offset( !prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir, ( ( !clyLen / 2 ) + ( !fltWdt / 2 ) ) )
      if ( !line6.startPosition.neq(!line6.endPosition) and !line6.length().gt(100mm)) then
        !proLine.append(!line6)
      endif
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex] )

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    --inner handrail profile
    if ( !this.updateHandrail.eq(false) ) then

      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), ( !yLen - 2 * !length ) )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir1, ( !xLen - 2 * !width ) )

      !line3 = object LINE()
      !line3.startPosition = !line2.endPosition
      !line3.endPosition   = !line3.startPosition.offset( !prmDir, ( !yLen - 2 * !length ) )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)
      !proLine.append(!line3)

    elseif ( !this.updateHandrail.eq(true) ) then

      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir, ( ( !clyLen / 2 ) - ( !fltWdt / 2 ) ) )
      !line1.endPosition   = !pos.offset( !prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir.opposite(), ( ( !yLen / 2 ) - !length ) )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir1, ( !xLen - 2 * !width ) )

      !line3 = object LINE()
      !line3.startPosition = !line2.endPosition
      !line3.endPosition   = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, ( ( !clyLen / 2 ) - ( !fltWdt / 2 ) ) )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)
      !proLine.append(!line3)

    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex].real() )

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    do !j from 1 to !this.handraProfile.size()
      if (!resultHandra[!j].set() ) then
        !!ce = !resultHandra[!j]
      else
        return
      endif
      !modHandraObj = !this.meHandraEngine
      !modHandraObj.aslHandrail(!resultHandra[!j])
      !modHandraObj.rpath.aslRpath(!this.handraProfile[!j])
        if ( !senSe.eq(false) ) then
          !modHandraObj.xoffset = -1
        elseif ( !senSe.eq(true) ) then
          !modHandraObj.xoffset = 1
        endif
      !modHandraObj.tmplReference(!this.handRaTmplReference)
      !!ce = !modHandraObj.updateDb()
      !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
    enddo
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyTwoLngHandraDB
--
-- Description: modifies the handrail the element for two stairs
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .modifyTwoLngHandraDB(!resultLng is DBREF, !elevIndex is REAL, !keyWord is STRING)

  --get the defaults for calculation
  !prmDir        = !!aslStrTwr.meStrTwrEngine.strTwrData.prmDirection
  !pos           = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !xLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.xLength
  !yLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.yLength
  !zLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.zLength
  !clxLen        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltClXSpacing
  !clyLen        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltClYSpacing
  !fltWdt        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltWidth
  !upPos         = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !lngWidth      = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
  !lngLength     = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
  !fflLevelElev  = !!aslStrTwr.neFflLevel.getrows()
  !senSe         = !!aslStrTwr.meStrTwrEngine.strTwrData.clockWise
  !width         = !this.lngWidth
  !length        = !this.lngLength
  !ori           = y is $!prmDir

  --update based on the sense
  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  if ( !resultLng.desc.upcase().matchwild('*TWO STAIRS') and ( !keyWord.upcase().eq('INNER') ) ) then
    --collect HANDRA for ce
    !collHandra = object COLLECTION()
    !collHandra.scope(!resultLng)
    !collHandra.type('HANDRA')
    !resultHandra = !collHandra.results()

    if ( !resultHandra.empty() ) then
      --!this.updateHandrailProfile()
      --!!alert.error('No Handrail to Modify')
      --return
    endif

    --initialise the variables
    !this.handraProfile = object ARRAY()
    !proLine  = object ARRAY()

    --outer handrail profile
    if ( !this.updateHandrail.eq(true) ) then
      !line0 = object LINE()
      !line0.startPosition = !pos.offset( !prmDir1, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line0.endPosition   = !pos.offset( !prmDir1, ( !xLen / 2 ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      if ( !line0.startPosition.neq(!line0.endPosition) and !line0.length().gt(100mm)) then
        !proLine.append(!line0)
      endif
    endif

    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), !length )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir2, !xLen )

    !line3 = object LINE()
    !line3.startPosition = !line2.endPosition
    !line3.endPosition   = !line3.startPosition.offset( !prmDir, !length )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)
    !proLine.append(!line3)

    if ( !this.updateHandrail.eq(true) ) then
      !line4 = object LINE()
      !line4.startPosition = !pos.offset( !prmDir2, !xLen / 2 ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line4.endPosition   = !pos.offset( !prmDir2, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      if ( !line4.startPosition.neq(!line4.endPosition) and !line4.length().gt(100mm)) then
        !proLine.append(!line4)
      endif
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex] )

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    --inner handrail profile
    !proLine  = object ARRAY()

    if ( !this.updateHandrail.eq(true) ) then
      !line1 = object LINE()
      !line1.startPosition  = !pos.offset( !prmDir2, ( ( !clxLen / 2 ) - ( !fltWdt / 2 ) ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line1.endPosition    = !pos.offset( !prmDir1, ( ( !clxLen / 2 ) - ( !fltWdt / 2 ) ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      if ( !line1.startPosition.neq(!line1.endPosition) and !line1.length().gt(100mm)) then
        !proLine.append(!line1)
      endif
    elseif ( !this.updateHandrail.eq(false) ) then
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !length ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir1, ( !xLen - 2 * !length ) )
      --append the lines
      !proLine.append(!line1)
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex])

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    -- refresh the handrail profile
    do !j from 1 to !this.handraProfile.size()
      if (!resultHandra[!j].set() ) then
        !!ce = !resultHandra[!j]
      else
        return
      endif

      !modHandraObj = !this.meHandraEngine
      !modHandraObj.aslHandrail(!resultHandra[!j])
      !modHandraObj.rpath.aslRpath(!this.handraProfile[!j])
        if ( !senSe.eq(false) ) then
          !modHandraObj.xoffset = -1
        elseif ( !senSe.eq(true) ) then
          !modHandraObj.xoffset = 1
        endif
      !modHandraObj.tmplReference(!this.handRaTmplReference)
      !!ce = !modHandraObj.updateDb()
      !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
    enddo
  elseif ( !resultLng.desc.upcase().matchwild('*TWO STAIRS') and ( !keyWord.upcase().eq('OUTER') ) ) then

    --collect HANDRA for ce
    !collHandra = object COLLECTION()
    !collHandra.scope(!resultLng)
    !collHandra.type('HANDRA')
    !resultHandra = !collHandra.results()

    if ( !resultHandra.empty() ) then
      --!this.updateHandrailProfile()
      --!!alert.error('No Handrail to Modify')
      --return
    endif

    --initialise the variables
    !this.handraProfile = object ARRAY()
    !proLine  = object ARRAY()

    --outer handrail profile
    if ( !this.updateHandrail.eq(true) ) then
      !line0 = object LINE()
      !line0.startPosition = !pos.offset( !prmDir2, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      !line0.endPosition   = !pos.offset( !prmDir2, ( !xLen / 2 ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      if ( !line0.startPosition.neq(!line0.endPosition) and !line0.length().gt(100mm)) then
        !proLine.append(!line0)
      endif
    endif

    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir, !length )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir1, !xLen )

    !line3 = object LINE()
    !line3.startPosition = !line2.endPosition
    !line3.endPosition   = !line3.startPosition.offset( !prmDir.opposite(), !length )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)
    !proLine.append(!line3)

    if ( !this.updateHandrail.eq(true) ) then
      !line4 = object LINE()
      !line4.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      !line4.endPosition   = !pos.offset( !prmDir1, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      if ( !line4.startPosition.neq(!line4.endPosition) and !line4.length().gt(100mm)) then
        !proLine.append(!line4)
      endif
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex] )

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    --inner handrail profile
    !proLine  = object ARRAY()

    if ( !this.updateHandrail.eq(true) ) then
      !line1 = object LINE()
      !line1.startPosition  = !pos.offset( !prmDir1, ( ( !clxLen / 2 ) - ( !fltWdt / 2 ) ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      !line1.endPosition    = !pos.offset( !prmDir2, ( ( !clxLen / 2 ) - ( !fltWdt / 2 ) ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      if ( !line1.startPosition.neq(!line1.endPosition) and !line1.length().gt(100mm)) then
        !proLine.append(!line1)
      endif
    elseif ( !this.updateHandrail.eq(false) ) then
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 - !length ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir2, ( !xLen - 2 * !length ) )
      --append the lines
     !proLine.append(!line1)
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex])

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    -- refresh the handrail profile
    do !j from 1 to !this.handraProfile.size()
      if (!resultHandra[!j].set() ) then
        !!ce = !resultHandra[!j]
      else
        return
      endif

      !modHandraObj = !this.meHandraEngine
      !modHandraObj.aslHandrail(!resultHandra[!j])
      !modHandraObj.rpath.aslRpath(!this.handraProfile[!j])
        if ( !senSe.eq(false) ) then
          !modHandraObj.xoffset = -1
        elseif ( !senSe.eq(true) ) then
          !modHandraObj.xoffset = 1
        endif
      !modHandraObj.tmplReference(!this.handRaTmplReference)
      !!ce = !modHandraObj.updateDb()
      !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
    enddo

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyThreeLngHandraDB
--
-- Description: modifies the handrail the element for two stairs
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .modifyThreeLngHandraDB(!resultLng is DBREF, !elevIndex is REAL)

  --get the defaults for calculation
  !prmDir        = !!aslStrTwr.meStrTwrEngine.strTwrData.prmDirection
  !pos           = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !xLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.xLength
  !yLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.yLength
  !zLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.zLength
  !clxLen        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltClXSpacing
  !clyLen        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltClYSpacing
  !fltWdt        = !!aslStrTwr.meStrTwrEngine.strTwrData.fltWidth
  !upPos         = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !lngWidth      = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
  !lngLength     = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
  !fflLevelElev  = !!aslStrTwr.neFflLevel.getrows()
  !senSe         = !!aslStrTwr.meStrTwrEngine.strTwrData.clockWise
  !width         = !this.lngWidth
  !length        = !this.lngLength
  !ori           = y is $!prmDir

  --update based on the sense
  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  --get the position details
  if ( !resultLng.desc.upcase().matchwild('*BOTTOM') ) then

    --collect HANDRA for ce
    !collHandra = object COLLECTION()
    !collHandra.scope(!resultLng)
    !collHandra.type('HANDRA')
    !resultHandra = !collHandra.results()

    if ( !resultHandra.empty() ) then
      --!this.updateHandrailProfile()
      --!!alert.error('No Handrail to Modify')
      --return
    endif

    --initialise the variables
    !this.handraProfile = object ARRAY()
    !proLine  = object ARRAY()

    --longer handrail
    if ( !this.updateHandrail.eq(true) ) then
      !line0 = object LINE()
      !line0.startPosition = !pos.offset( !prmDir1, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line0.endPosition   = !pos.offset( !prmDir1, ( !xLen / 2 ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      if ( !line0.startPosition.neq(!line0.endPosition) and !line0.length().gt(100mm)) then
        !proLine.append(!line0)
      endif
    endif

    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), !length )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir2, !xLen )

    !line3 = object LINE()
    !line3.startPosition = !line2.endPosition
    !line3.endPosition   = !line3.startPosition.offset( !prmDir, !length )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)
    !proLine.append(!line3)

    if ( !this.updateHandrail.eq(true) ) then
      !line4 = object LINE()
      !line4.startPosition = !pos.offset( !prmDir2, !xLen / 2 ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line4.endPosition   = !pos.offset( !prmDir2, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      if ( !line4.startPosition.neq(!line4.endPosition) and !line4.length().gt(100mm)) then
        !proLine.append(!line4)
      endif
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex])

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    --inner handrail profile
    !proLine  = object ARRAY()

    if ( !this.updateHandrail.eq(true) ) then
      !line1 = object LINE()
      !line1.startPosition  = !pos.offset( !prmDir2, ( ( !clxLen / 2 ) - ( !fltWdt / 2 ) ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line1.endPosition    = !pos.offset( !prmDir1, ( ( !clxLen / 2 ) - ( !fltWdt / 2 ) ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      if ( !line1.startPosition.neq(!line1.endPosition) and !line1.length().gt(100mm)) then
        !proLine.append(!line1)
      endif
    endif

    if ( !this.updateHandrail.eq(false) ) then
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !length ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir1, ( !xLen - 2 * !length ) )
      --append the lines
     !proLine.append(!line1)
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex])

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    do !j from 1 to !this.handraProfile.size()
      if (!resultHandra[!j].set() ) then
        !!ce = !resultHandra[!j]
      else
        return
      endif
      !modHandraObj = !this.meHandraEngine
      !modHandraObj.aslHandrail(!resultHandra[!j])
      !modHandraObj.rpath.aslRpath(!this.handraProfile[!j])
        if ( !senSe.eq(false) ) then
          !modHandraObj.xoffset = -1
        elseif ( !senSe.eq(true) ) then
          !modHandraObj.xoffset = 1
        endif
      !modHandraObj.tmplReference(!this.handRaTmplReference)
      !!ce = !modHandraObj.updateDb()
      !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
    enddo

  elseif ( !resultLng.desc.upcase().matchwild('*BOTTOM LEFT') ) then

    --collect HANDRA for ce
    !collHandra = object COLLECTION()
    !collHandra.scope(!resultLng)
    !collHandra.type('HANDRA')
    !resultHandra = !collHandra.results()

    if ( !resultHandra.empty() ) then
      --!!alert.error('No Handrail to Modify')
      --return
    endif

    --shorter handrail on left
    !this.handraProfile = object ARRAY()
    !proLine  = object ARRAY()

    if ( !this.updateHandrail.eq(true) ) then
      !line0 = object LINE()
      !line0.startPosition = !pos.offset( !prmDir, ( ( !clyLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir1, ( !xLen / 2 - !width ) )
      !line0.endPosition   = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
      if ( !line0.startPosition.neq(!line0.endPosition) and !line0.length().gt(100mm)) then
        !proLine.append(!line0)
      endif
    endif

    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir1, !width )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir.opposite(), !length )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)

    if ( !this.updateHandrail.eq(true) ) then
      !line4 = object LINE()
      !line4.startPosition = !pos.offset( !prmDir1, !xLen / 2 ).offset( !prmDir, ( !yLen / 2 ) - !length )
      !line4.endPosition   = !pos.offset( !prmDir1, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      if ( !line4.startPosition.neq(!line4.endPosition) and !line4.length().gt(100mm)) then
        !proLine.append(!line4)
      endif
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex])

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    do !j from 1 to !this.handraProfile.size()
      if (!resultHandra[!j].set() ) then
        !!ce = !resultHandra[!j]
      else
        return
      endif
      !modHandraObj = !this.meHandraEngine
      !modHandraObj.aslHandrail(!resultHandra[!j])
      !modHandraObj.rpath.aslRpath(!this.handraProfile[!j])
        if ( !senSe.eq(false) ) then
          !modHandraObj.xoffset = -1
        elseif ( !senSe.eq(true) ) then
          !modHandraObj.xoffset = 1
        endif
      !modHandraObj.tmplReference(!this.handRaTmplReference)
      !!ce = !modHandraObj.updateDb()
      !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
    enddo

  elseif ( !resultLng.desc.upcase().matchwild('*RIGHT') ) then

    --collect HANDRA for ce
    !collHandra = object COLLECTION()
    !collHandra.scope(!resultLng)
    !collHandra.type('HANDRA')
    !resultHandra = !collHandra.results()

    if ( !resultHandra.empty() ) then
      --!!alert.error('No Handrail to Modify')
      --return
    endif

    --shorter handrail on right
    !this.handraProfile = object ARRAY()
    !proLine  = object ARRAY()

    if ( !this.updateHandrail.eq(true) ) then
      !line0 = object LINE()
      !line0.startPosition = !pos.offset( !prmDir2, ( ( !clxLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      !line0.endPosition   = !pos.offset( !prmDir2, !xLen / 2 ).offset( !prmDir, ( !yLen / 2 - !length ) )
      if ( !line0.startPosition.neq(!line0.endPosition) and !line0.length().gt(100mm)) then
        !proLine.append(!line0)
      endif
    endif

    !line1 = object LINE()
    !line1.startPosition = !pos.offset( !prmDir2, !xLen / 2 ).offset( !prmDir, ( !yLen / 2 - !length ) )
    !line1.endPosition   = !line1.startPosition.offset( !prmDir, !length )

    !line2 = object LINE()
    !line2.startPosition = !line1.endPosition
    !line2.endPosition   = !line2.startPosition.offset( !prmDir1, !width )

    --append the lines
    !proLine.append(!line1)
    !proLine.append(!line2)

    if ( !this.updateHandrail.eq(true) ) then
      !line4 = object LINE()
      !line4.startPosition = !pos.offset(!prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2)
      !line4.endPosition   = !pos.offset(!prmDir, ( ( !clyLen / 2 ) + ( !fltWdt / 2 ) ) ).offset( !prmDir2, ( !xLen / 2 - !width ))
      if ( !line4.startPosition.neq(!line4.endPosition) and !line4.length().gt(100mm)) then
        !proLine.append(!line4)
      endif
    endif

    !posi = !this.refe.pos.offset(U, !upPos[!elevIndex].real() )

    --create a profile
    !profile = object PROFILE(!posi, !ori, !proLine)
    !this.handraProfile.append(!profile)

    do !j from 1 to !this.handraProfile.size()
      if (!resultHandra[!j].set() ) then
        !!ce = !resultHandra[!j]
      else
        return

      endif
      !modHandraObj = !this.meHandraEngine
      !modHandraObj.aslHandrail(!resultHandra[!j])
      !modHandraObj.rpath.aslRpath(!this.handraProfile[!j])
        if ( !senSe.eq(false) ) then
          !modHandraObj.xoffset = -1
        elseif ( !senSe.eq(true) ) then
          !modHandraObj.xoffset = 1
        endif
      !modHandraObj.tmplReference(!this.handRaTmplReference)
      !!ce = !modHandraObj.updateDb()
      !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
    enddo

  endif

endmethod
