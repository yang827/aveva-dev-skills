------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrlngData()                  -                   default constructor
--  drawHandraAids()                 -
--  drawHandraAidsFourStair()        -                   updates the handrail profile aids
--  drawHandraAidsOneStair()         -                   updates the handrail profile aids
--  drawHandraAidsThreeStair()       -                   updates the handrail profile aids
--  drawHandraAidsTwoStair()         -                   updates the handrail profile aids
--  modifyFourLngHandraDB(DBREF,REAL,STRING) -                   modifies the handrail the element for two stairs
--  modifyFourStrLngDb(ARRAY,ARRAY,ARRAY,POSITION) -                   modify the landing configuration based on the template selection
--  modifyOneLngHandraDB(DBREF,REAL) -                   modifies the handrail the element for two stairs
--  modifyOneStrLngDb(ARRAY,ARRAY,ARRAY,POSITION) -                   modify the landing configuration based on the template selection
--  modifyStrLngDB(ARRAY)            -                   updates the handrail element which is already defined
--  modifyThreeLngHandraDB(DBREF,REAL) -                   modifies the handrail the element for two stairs
--  modifyThreeStrLngDb(ARRAY,ARRAY,ARRAY,POSITION) -                   modify the landing configuration based on the template selection
--  modifyTwoLngHandraDB(DBREF,REAL,STRING) -                   modifies the handrail the element for two stairs
--  modifyTwoStrLngDb(ARRAY,ARRAY,ARRAY,POSITION) -                   modify the landing configuration based on the template selection
--  updateDataObj(DBREF)             -                   reads the values from the end STRLNG
--  updateFourLngHandraDB()          -                   updates the handrail the element for Four stairs
--  updateFourStrLngDB(ARRAY,ARRAY,POSITION,ASLTWRBEAMPROFILE,DIRECTION,BOOLEAN) -
--  updateHandraDB()                 -                   updates the handrail the element
--  updateHandraToFltSpacing()       -                   read the handrail and update to match the flight spacing
--  updateHandrailLngProfile()       -                   updates the handrail profile
--  updateOneLngHandraDB()           -                   updates the handrail the element for one stairs
--  updateOneStrLngDB(ARRAY,ARRAY,POSITION,ASLTWRBEAMPROFILE) -                   creates/updates STRLNG element
--  updateStrLngDB()                 -                   creates/updates STRLNG element
--  updateThreeLngHandraDB()         -                   updates the handrail the element for Three stairs
--  updateThreeStrLngDB(ARRAY,ARRAY,POSITION,ASLTWRBEAMPROFILE) -                   creates/updates STRLNG element
--  updateTwoLngHandraDB()           -                   updates the handrail the element for two stairs
--  updateTwoStrLngDB(ARRAY,ARRAY,POSITION,ASLTWRBEAMPROFILE) -                   creates/updates STRLNG element
--

-- Define object
define object ASLSTRLNGDATA

  --member
  ---------------------------------------------------------------------------

  -- reference to the central template for handrail
  member .handRaTmplReference   is DBREF

  -- reference
  member .refe                  is DBREF

  -- link to the uses setting
  member .settingReference     is STRING

  -- reference to the central template for landings
  member .strLngTmplReference  is DBREF

  --landing thickness
  member .lngThk                is REAL

  --landing spec
  member .lngSpec               is DBREF

  --landing width
  member .lngWidth              is REAL

  --landing length
  member .lngLength             is REAL

  --installation option
  member .installationOption    is STRING

  -- contains for the handrail data
  member .meHandraEngine        is ASLHANDRAIL

  -- contains the handrail profile data
  member .handraProfile         is ARRAY

  --contains the handrail reference
  member .handraRefe            is ARRAY

  --contains the landing DBREF
  member .landingRefe           is ARRAY

  -- controls if the object uses the undo functionality
  member .undoable              is BOOLEAN

  --profile of the lading
  member .lngProfile            is ARRAY

  -- controls if the object uses the undo functionality
  member .updateHandrail        is BOOLEAN

  --flag to suppress landing
  member .suppressLandings       is BOOLEAN

endobject
-- End of object definition for aslStrlngData

------------------------------------------------------------------------
--
-- Method:      aslStrlngData
--
-- Description: default constructor
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .aslStrlngData()

  -- init
  !this.undoable            = false
  !this.installationOption  = 'Two stairs, platform north and south'
  !this.updateHandrail      = false
  !this.suppressLandings    = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: reads the values from the end STRLNG
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type]    [Description]
--    1     R     DBREF        reference element
--
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  --update the refe
  !this.refe = !refe
  !this.installationOption = !refe.instOpt

  -- evaluates the landing details
  !collection = object COLLECTION()
  !collection.type('STRLNG')
  !collection.scope(!this.refe)
  !lngRefes = !collection.results()

  if ( !lngRefes.empty().not() ) then

    -- set the general attributes
    !!ce = !lngRefes.first()

    if ( !!ce.lfaoffset.set() and !!ce.lfaoffset.neq(0) ) then
      !this.lngLength           = !!ce.lfaoffset
    endif

    if ( !!ce.lfboffset.set() and !!ce.lfboffset.neq(0) ) then
      !this.lngWidth            = !!ce.lfboffset
    endif

    if ( !!ce.asstmpreference.set() ) then
      !this.strLngTmplReference = !!ce.asstmpreference.own
    endif

    -- evaluates the landing details
    !collection = object COLLECTION()
    !collection.type('PLOO')
    !collection.scope(!!ce)
    !plooRefes = !collection.results()

    if ( !plooRefes.set() ) then
      !this.lngThk              = !plooRefes.first().height
      !this.lngSpec             = !plooRefes.first().spref
    else
      if ( !!ce.thickn.set() and !!ce.thickn.neq(0) ) then
        !this.lngThk              = !!ce.thickn
      endif
    endif

    -- evaluates the handrail details
    !collection = object COLLECTION()
    !collection.type('HANDRA')
    !collection.scope(!!ce)
    !handraRefes = !collection.results()

    if ( !handraRefes.empty().not() ) then
      !!ce = !handraRefes.first()
      !this.handRaTmplReference = !!ce.asstmpreference
      !this.meHandraEngine.tmplReference(!this.handRaTmplReference)
    endif

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateHandrailLngProfile
--
-- Description: updates the handrail profile
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
--
--
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateHandrailLngProfile()

  --get the defaults for calculation
  !prmDir        = !!aslStrTwr.meStrTwrEngine.strTwrData.prmDirection
  !pos           = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !xLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.xLength
  !yLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.yLength
  !zLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.zLength
  !lngWidth      = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
  !lngLength     = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
  !fflLevelElev  = !!aslStrTwr.neFflLevel.getrows()
  !senSe         = !!aslStrTwr.meStrTwrEngine.strTwrData.clockWise
  !width         = !this.lngWidth
  !length        = !this.lngLength
  !ori           = y is $!prmDir

  --update based on the sense
  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  if ( !this.installationOption.eq('One stair, stair north') ) then

      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir1, !width )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir.opposite(), !yLen )

      !line3 = object LINE()
      !line3.startPosition = !line2.endPosition
      !line3.endPosition   = !line3.startPosition.offset( !prmDir2, !xLen )

      !line4 = object LINE()
      !line4.startPosition = !line3.endPosition
      !line4.endPosition   = !line4.startPosition.offset( !prmDir, !yLen )

      !line5 = object LINE()
      !line5.startPosition = !line4.endPosition
      !line5.endPosition   = !line5.startPosition.offset( !prmDir1, !width )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)
      !proLine.append(!line3)
      !proLine.append(!line4)
      !proLine.append(!line5)

      --create a profile
      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile = object ARRAY()
      !this.handraProfile.append(!profile)

      --inner handrail profile
      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir, ( !yLen / 2 - !length ) )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), ( !yLen - 2 * !length ) )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir1, ( !xLen - 2 * !width ) )

      !line3 = object LINE()
      !line3.startPosition = !line2.endPosition
      !line3.endPosition   = !line3.startPosition.offset( !prmDir, ( !yLen - 2 * !length ) )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)
      !proLine.append(!line3)

      --create a profile
      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile.append(!profile)

    elseif ( !this.installationOption.eq('Two stairs, platform north and south') ) then

      --upper handrail profile
      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), !length )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir2, !xLen )

      !line3 = object LINE()
      !line3.startPosition = !line2.endPosition
      !line3.endPosition   = !line3.startPosition.offset( !prmDir, !length )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)
      !proLine.append(!line3)

      --create a profile
      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile = object ARRAY()
      !this.handraProfile.append(!profile)

      --inner handrail profile
      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !length ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir1, ( !xLen - 2 * !length ) )

      --append the lines
      !proLine.append(!line1)

      --create a profile
      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile.append(!profile)

    elseif ( !this.installationOption.eq('Three stairs, platform south') ) then

      --longer handrail
      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), !length )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir2, !xLen )

      !line3 = object LINE()
      !line3.startPosition = !line2.endPosition
      !line3.endPosition   = !line3.startPosition.offset( !prmDir, !length )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)
      !proLine.append(!line3)

      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile = object ARRAY()
      !this.handraProfile.append(!profile)

      --inner handrail profile
      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !length ) ).offset( !prmDir.opposite(), ( !yLen / 2 - !length ) )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir1, ( !xLen - 2 * !length ) )

      --append the lines
      !proLine.append(!line1)

      --create a profile
      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile.append(!profile)

      --shorter handrail on left
      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir1, !width )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir.opposite(), !length )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)

      --create a profile
      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile.append(!profile)

      --shorter handrail on right
      !proLine  = object ARRAY()

      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir2, !xLen / 2 ).offset( !prmDir, ( !yLen / 2 - !length ) )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir, !length )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir1, !length )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)

      --create a profile
      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile.append(!profile)

    elseif ( !this.installationOption.eq('Four stairs') ) then

      --shorter handrail on left
      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 ) ).offset( !prmDir.opposite(), ( ( !yLen / 2 ) - !length ) )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), !length )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir2, !width )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)

      --create a profile
      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile = object ARRAY()
      !this.handraProfile.append(!profile)

      --shorter handrail on left
      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir1, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir1, !width )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir.opposite(), !length )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)

      --create a profile
      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile.append(!profile)

      --shorter handrail on left
      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir, !yLen / 2 )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir2, !width )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir.opposite(), !length )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)

      --create a profile
      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile.append(!profile)

      --shorter handrail on left
      !proLine  = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir2, ( !xLen / 2 - !width ) ).offset( !prmDir.opposite(), !yLen / 2 )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir2, !width )

      !line2 = object LINE()
      !line2.startPosition = !line1.endPosition
      !line2.endPosition   = !line2.startPosition.offset( !prmDir, !length )

      --append the lines
      !proLine.append(!line1)
      !proLine.append(!line2)

      --create a profile
      !profile = object PROFILE(!pos, !ori, !proLine)
      -- refresh the handrail profile
      !this.handraProfile.append(!profile)

    endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateHandraAids
--
-- Description: updates the handrail profile aids
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
--
--
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .drawHandraAids()

  !lngInstallOption = !this.installationOption

  if ( !lngInstallOption.eq('One stair, stair north') ) then
    !this.drawHandraAidsOneStair()
  elseif( !lngInstallOption.eq('Two stairs, platform north and south') ) then
    !this.drawHandraAidsTwoStair()
  elseif ( !lngInstallOption.eq('Three stairs, platform south') ) then
    !this.drawHandraAidsThreeStair()
  elseif ( !lngInstallOption.eq('Four stairs') ) then
    !this.drawHandraAidsFourStair()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawHandraAidsOneStair
--
-- Description: updates the handrail profile aids
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
--
--
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .drawHandraAidsOneStair()

  !upPos   = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !pos     = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !this.meHandraEngine.autoUpdateDB = false

  --set the template and HANDRA attributes
  !!fmsys.setProgress(10)
    do !i values !upPos
      do !j from 1 to !this.handraProfile.size()
        !handrailObj = !this.meHandraEngine
        !!fmsys.setProgress( !i * 2.5 + 40 )
        !handrailObj.removeGeometry()
        !this.handraProfile[!j].position = !pos.offset( U, !i )
        !handrailObj.rpath.aslRpath(!this.handraProfile[!j])
        !handrailObj.rpath.radius(!handrailObj.radius)
        !handrailObj.reBuild()
        !handrailObj.draw(!!aslCentralData.aidVolHandra, !!aslCentralData.lineStyleDashedThin, !!aslCentralData.colourHandra)
      enddo
    enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawHandraAidsTwoStair
--
-- Description: updates the handrail profile aids
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
--
--
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .drawHandraAidsTwoStair()

  !upPos     = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !pos       = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !prmDir    = !!aslStrTwr.meStrTwrEngine.strTwrData.prmDirection
  !prmDirOpp = !prmDir.opposite()
  !this.meHandraEngine.autoUpdateDB = false

  --set the template and HANDRA attributes
    do !i from 1 to !upPos.size()
      !!fmsys.setProgress( !i * 3 + 60 )
      do !j from 1 to !this.handraProfile.size()
        !handrailObj = !this.meHandraEngine
        !this.handraProfile[!j].position = !pos.offset( U, !upPos[!i] )
        if ( ( !i / 2 ) eq (NINT ( !i / 2 ) ) ) then
          !this.handraProfile[!j].orientation = Y is $!prmDirOpp
        elseif ( ( !i / 2 ) neq (NINT ( !i / 2 ) ) ) then
          !this.handraProfile[!j].orientation = Y is $!prmDir
        endif
        !handrailObj.removeGeometry()
        !handrailObj.rpath.aslRpath(!this.handraProfile[!j])
        !handrailObj.rpath.radius(!handrailObj.radius)
        !handrailObj.reBuild()
        !handrailObj.draw(!!aslCentralData.aidVolHandra, !!aslCentralData.lineStyleDashedThin, !!aslCentralData.colourHandra)
      enddo
    enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawHandraAidsThreeStair
--
-- Description: updates the handrail profile aids
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
--
--
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .drawHandraAidsThreeStair()

  !upPos     = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !pos       = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !this.meHandraEngine.autoUpdateDB = false

  --set the template and HANDRA attributes
  do !i from 1 to !upPos.size() by 3
    !!fmsys.setProgress( !i * 1.25 + 60 )
    do !j from 1 to 2
      !handrailObj = !this.meHandraEngine
      !handrailObj.removeGeometry()
      !this.handraProfile[!j].position = !pos.offset( U, !upPos[!i] )
      !handrailObj.rpath.aslRpath(!this.handraProfile[!j])
      !handrailObj.rpath.radius(!handrailObj.radius)
      !handrailObj.reBuild()
      !handrailObj.draw(!!aslCentralData.aidVolHandra, !!aslCentralData.lineStyleDashedThin, !!aslCentralData.colourHandra)
    enddo
  enddo

  do !i from 2 to !upPos.size() by 3
    !handrailObj = !this.meHandraEngine
    !handrailObj.removeGeometry()
    !!fmsys.setProgress( !i * 1.25 + 75 )
    !this.handraProfile[3].position = !pos.offset( U, !upPos[!i] )
    !handrailObj.rpath.aslRpath(!this.handraProfile[3])
    !handrailObj.rpath.radius(!handrailObj.radius)
    !handrailObj.reBuild()
    !handrailObj.draw(!!aslCentralData.aidVolHandra, !!aslCentralData.lineStyleDashedThin, !!aslCentralData.colourHandra)
  enddo

  do !i from 3 to !upPos.size() by 3
    !handrailObj = !this.meHandraEngine
    !handrailObj.removeGeometry()
    !!fmsys.setProgress( !i * 1 + 90 )
    !this.handraProfile[4].position = !pos.offset( U, !upPos[!i] )
    !handrailObj.rpath.aslRpath(!this.handraProfile[4])
    !handrailObj.rpath.radius(!handrailObj.radius)
    !handrailObj.reBuild()
    !handrailObj.draw(!!aslCentralData.aidVolHandra, !!aslCentralData.lineStyleDashedThin, !!aslCentralData.colourHandra)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawHandraAidsFourStair
--
-- Description: updates the handrail profile aids
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
--
--
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .drawHandraAidsFourStair()

  !upPos     = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !pos       = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !this.meHandraEngine.autoUpdateDB = false

  --set the template and HANDRA attributes
  do !i from 1 to !upPos.size() by 4
    !handrailObj = !this.meHandraEngine
    !handrailObj.removeGeometry()
    !!fmsys.setProgress( !i * 1.25 + 60 )
    !this.handraProfile[1].position = !pos.offset( U, !upPos[!i] )
    !handrailObj.rpath.aslRpath(!this.handraProfile[1])
    !handrailObj.rpath.radius(!handrailObj.radius)
    !handrailObj.reBuild()
    !handrailObj.draw(!!aslCentralData.aidVolHandra, !!aslCentralData.lineStyleDashedThin, !!aslCentralData.colourHandra)
  enddo

  do !i from 2 to !upPos.size() by 4
    !handrailObj = !this.meHandraEngine
    !handrailObj.removeGeometry()
    !!fmsys.setProgress( !i * 1 + 75 )
    !this.handraProfile[2].position = !pos.offset( U, !upPos[!i] )
    !handrailObj.rpath.aslRpath(!this.handraProfile[2])
    !handrailObj.rpath.radius(!handrailObj.radius)
    !handrailObj.reBuild()
    !handrailObj.draw(!!aslCentralData.aidVolHandra, !!aslCentralData.lineStyleDashedThin, !!aslCentralData.colourHandra)
  enddo

  do !i from 3 to !upPos.size() by 4
    !handrailObj = !this.meHandraEngine
    !handrailObj.removeGeometry()
    !!fmsys.setProgress( !i * 0.5 + 85 )
    !this.handraProfile[3].position = !pos.offset( U, !upPos[!i] )
    !handrailObj.rpath.aslRpath(!this.handraProfile[3])
    !handrailObj.rpath.radius(!handrailObj.radius)
    !handrailObj.reBuild()
    !handrailObj.draw(!!aslCentralData.aidVolHandra, !!aslCentralData.lineStyleDashedThin, !!aslCentralData.colourHandra)
  enddo

  do !i from 4 to !upPos.size() by 4
    !handrailObj = !this.meHandraEngine
    !handrailObj.removeGeometry()
    !!fmsys.setProgress( !i * 0.5 + 90 )
    !this.handraProfile[4].position = !pos.offset( U, !upPos[!i] )
    !handrailObj.rpath.aslRpath(!this.handraProfile[4])
    !handrailObj.rpath.radius(!handrailObj.radius)
    !handrailObj.reBuild()
    !handrailObj.draw(!!aslCentralData.aidVolHandra, !!aslCentralData.lineStyleDashedThin, !!aslCentralData.colourHandra)
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      updateStrLngDB
--
-- Description: creates/updates STRLNG element
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateStrLngDB()

  -- create undo mark
  if ( !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update stair landing')
    !undo.add()
  endif

  -- initialise
  !this.refe       = !!aslStrTwr.meStrTwrEngine.strTwrData.refe
  !prmDir          = !this.refe.prmDirection
  !senSe           = !this.refe.intSen
  !pos             = !this.refe.position
  !upPos           = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !tieBeamProfData = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile

  --initialise the variables
  !this.meHandraEngine.refe            = object DBREF()
  !this.meHandraEngine.rpathRef        = object DBREF()
  !this.meHandraEngine.rpath.refe      = object ARRAY()
  !this.landingRefe                    = object ARRAY()
  !!fmsys.setProgress(35)

  --initialise for collection
  !install = !this.installationOption.split()
  !instOpt = !install[1].upcase().trim()
  !tempRef = !this.strLngTmplReference

  -- collect the assembly template reference
  !purposeTemplate = object EXPRESSION()
  !purposeTemplate.expression('FUNC eq !instOpt')

  !collectionTemplate = object COLLECTION()
  !collectionTemplate.scope(!tempRef)
  !collectionTemplate.type('STRLNG')
  !collectionTemplate.filter(!purposeTemplate)
  !resultTemplate = !collectionTemplate.results()

  --check for the change in installation option
  if ( !this.refe.instOpt.neq(!this.installationOption) ) then
    !purposeLng   = object EXPRESSION()
    !purposeLng.expression('PURP eq |ILNG|')

    !collectLng = object COLLECTION()
    !collectLng.scope(!this.refe)
    !collectLng.type('STRLNG')
    !collectLng.filter(!purposeLng)
    !resultLng = !collectLng.results()

    if (!resultLng.set() ) then
      do !i from 1 to !resultLng.size()
        !!ce = !resultLng[!i]
        delete STRLNG
      enddo
    endif
  endif

  --set the expression filter for the collection
  !purposeLng   = object EXPRESSION()
  !purposeLng.expression('PURP eq |ILNG|')

  -- check  for stair landing in the Hierarchy
  !collectLng = object COLLECTION()
  !collectLng.scope(!this.refe)
  !collectLng.type('STRLNG')
  !collectLng.filter(!purposeLng)
  !resultLng = !collectLng.results()

  if ( !resultLng.empty().not() ) then
    !this.installationOption  = !this.refe.instoptions
  elseif ( !resultLng.empty() ) then
    !this.refe.instoptions    = !this.installationOption
  endif

  --navigate to the stair tower level to create the stair landing
  !!ce = !this.refe

  if ( !resultLng.empty() and !this.installationOption.eq('One stair, stair north') ) then
    !this.updateOneStrLngDB(!upPos, !resultTemplate, !pos, !tieBeamProfData)
  elseif ( !resultLng.empty() and !this.installationOption.eq('Two stairs, platform north and south') ) then
    !this.updateTwoStrLngDB(!upPos, !resultTemplate, !pos, !tieBeamProfData)
  elseif ( !resultLng.empty() and !this.installationOption.eq('Three stairs, platform south') ) then
    !this.updateThreeStrLngDB(!upPos, !resultTemplate, !pos, !tieBeamProfData)
  elseif ( !resultLng.empty() and !this.installationOption.eq('Four stairs') ) then
    !this.updateFourStrLngDB(!upPos, !resultTemplate, !pos, !tieBeamProfData, !prmDir, !senSe )
  elseif( !resultLng.empty().not() ) then
    !this.modifyStrLngDB(!resultLng)
  endif

  -- end undo mark
  if ( !this.undoable ) then
    !undo.endUndoable()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateHandraDB
--
-- Description: updates the handrail the element
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateHandraDB()

  --create the handrail
  if ( !this.landingRefe.unset() ) then
    !!alert.error('No Landings to Create the Handrails')
    return
  endif
  !!fmsys.setProgress(25)
  --set the expression filter for the collection
  !purposeHandra   = object EXPRESSION()
  !purposeHandra.expression('PURP eq |ILNG|')

  -- check  for stair landing in the Hierarchy
  !collectHandra = object COLLECTION()
  !collectHandra.scope(!this.refe)
  !collectHandra.type('HANDRA')
  !collectHandra.filter(!purposeHandra)
  !resultHandra = !collectHandra.results()

  --unset the HANDRA reference
  !this.handraRefe = object ARRAY()

  if ( !resultHandra.empty() ) then
    --get the defaults for calculation
    !prmDir        = !!aslStrTwr.meStrTwrEngine.strTwrData.prmDirection
    !pos           = !!aslStrTwr.meStrTwrEngine.strTwrData.position
    !xLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.xLength
    !yLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.yLength
    !zLen          = !!aslStrTwr.meStrTwrEngine.strTwrData.zLength
    !lngWidth      = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
    !lngLength     = !!aslStrTwr.meStrTwrEngine.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength
    !fflLevelElev  = !!aslStrTwr.neFflLevel.getrows()
    !senSe         = !!aslStrTwr.meStrTwrEngine.strTwrData.clockWise
    !width         = !this.lngWidth
    !length        = !this.lngLength
    !ori           = y is $!prmDir

    --update based on the sense
    if ( !senSe.eq(true) ) then
      --manipulation for the first level
      !prmDir1 = !prmDir.orthogonal(U).opposite()
      !prmDir2 = !prmDir.orthogonal(U)
    elseif ( !senSe.eq(false) ) then
      --manipulation for the first level
      !prmDir1 = !prmDir.orthogonal(U)
      !prmDir2 = !prmDir.orthogonal(U).opposite()
    endif

    if ( !this.installationOption.eq('Two stairs, platform north and south') ) then
      --create the handrail
      !this.updateTwoLngHandraDB()
      !!fmsys.setProgress(40)
    elseif ( !this.installationOption.eq('One stair, stair north') ) then
      --create the handrail
      !this.updateOneLngHandraDB()
      !!fmsys.setProgress(40)
    elseif ( !this.installationOption.eq('Three stairs, platform south') ) then
      --create the handrail
      !this.updateThreeLngHandraDB()
      !!fmsys.setProgress(40)
    elseif ( !this.installationOption.eq('Four stairs') ) then
      --update the aids
      !this.updateFourLngHandraDB()
      !!fmsys.setProgress(40)
    endif
  else


  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateOneLngHandraDB
--
-- Description: updates the handrail the element for one stairs
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateOneLngHandraDB()

  --get the position details
  !upPos   = !!aslStrTwr.meStrTwrEngine.strTwrData.fflLevelStrTwr
  !pos     = !!aslStrTwr.meStrTwrEngine.strTwrData.position
  !senSe   = !!aslStrTwr.meStrTwrEngine.strTwrData.clockWise
  --create the HANDRA
  !!ce = !this.landingRefe[1]
  do !j from 1 to !this.handraProfile.size()
    !handraObj = !this.meHandraEngine
    !this.handraProfile[!j].position = !pos.offset(U, !upPos[1])
    !handraObj.rpath.aslRpath(!this.handraProfile[!j])
      if ( !senSe.eq(false) ) then
        !handraObj.xoffset = -1
      elseif ( !senSe.eq(true) ) then
        !handraObj.xoffset = 1
      endif
    !handraObj.tmplReference(!handraObj.tmplReference)
    !!ce = !handraObj.updateDb()
    !!ce.purpose      = 'ILNG'
      if ( !j.eq(1) ) then
        !!ce.desc   = 'OUTER'
      elseif ( !j.eq(2) ) then
        !!ce.desc   = 'INNER'
      endif
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateTwoLngHandraDB
--
-- Description: updates the handrail the element for two stairs
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type] [Description]
-- Return:
