--
--
-- Description:     Object definition driver engine for the landing
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrLngEngine(ASLSTRLNGDATA)   -                   Constructor
--  getHandRaTmplReference()         STRING              returns the template of the handrail
--  getStrLngTmplReference()         STRING              returns the template of the landing
--  setCriteria(ASLSTRLNGCRITERIA,ASLSTRLNGCRITERIA) -                   sets the criteria
--  setSettingReference(STRING)      -                   sets the setting
--  setTmplReferences(DBREF,DBREF)   -                   sets the templates
--

-- Define object
define object ASLSTRLNGENGINE

  -- public members
  ---------------------------------------------------------------------------
  -- container for the landing data
  member .strLngData          is ASLSTRLNGDATA

  -- private members
  -- contains the criteria set for landing elements (including fabricator standard)
  member .strLngCriteria      is ASLSTRLNGCRITERIA

  -- contains the criteria set for landing elements (excluding fabricator standard)
  member .strLngCriteriaBasis is ASLSTRLNGCRITERIA

  -- contains a copy of landing data before modify
  member .strLngDataOld       is ASLSTRLNGDATA

endobject
-- End of object definition for ASLEngineSTRLNG

------------------------------------------------------------------------
--
-- Method:      aslStrLngEngine
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ASLSTRLNGDATA
--                           stair landing object
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrLngEngine(!strLngData is ASLSTRLNGDATA)

  -- assigns an existing landing
  !this.strLngData = !strLngData

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setCriteria
--
-- Description: sets the criteria
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLSTRLNGCRITERIA
--                           merged criteria
--    2   R      ASLSTRLNGCRITERIA
--                           standard criteria
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setCriteria(!strLngCriteria is ASLSTRLNGCRITERIA, !strLngCriteriaBasis is ASLSTRLNGCRITERIA)

  !this.strLngCriteria      = !strLngCriteria
  !this.strLngCriteriaBasis = !strLngCriteriaBasis

endmethod

-- End of method
------------------------------------------------------------------------
--
-- Method:      setSettingReference
--
-- Description: sets the setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      setting
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setSettingReference(!settingReference is STRING)

  !this.strLngData.settingReference = !settingReference
  !this.strLngCriteriaBasis         = !!aslCentralData.getCriteriaSet(!settingReference, 'ASLSTRLNGCRITERIA')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setTmplReferences
--
-- Description: sets the templates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      landing template reference
--    2   R      DBREF      handrail template reference
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setTmplReferences(!strLngTmplReference is DBREF, !handRaTmplReference is DBREF)

  !this.strLngData.strLngTmplReference = !strLngTmplReference
  !this.strLngData.handRaTmplReference = !handRaTmplReference

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      getHandRaTmplReference
--
-- Description: returns the template of the handrail
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      template of the handrail
------------------------------------------------------------------------

define method .getHandRaTmplReference() is STRING

  return this.strLngData.handRaTmplReference

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      getStrLngTmplReference
--
-- Description: returns the template of the landing
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      template of the landing
------------------------------------------------------------------------

define method .getStrLngTmplReference() is STRING

  return this.strLngData.strLngTmplReference

endmethod
-- End of method
