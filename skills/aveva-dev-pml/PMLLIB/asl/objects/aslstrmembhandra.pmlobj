--
-- Author:          naresh kumar
-- Created:         Tue Mar 25 10:48:00 IST 2008
--
--
-- Description:
--   Object for holding handrail data information for asl
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrMembHandra(STRING,STRING,ASLHANDRAIL) -                   Constructor
--  meHandraEngine(DBREF)            -                   Set handrail data
--  show()                           -                   Show selection form
--

define object ASLSTRMEMBHANDRA

  -- Title of selection form
  member .title           is STRING

  -- Action to be carried out on Apply
  member .action          is STRING

  -- Profile catalogue data
  member .meHandraEngine  is ASLHANDRAIL

  --template reference
  member .handRaTmplReference is DBREF

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      aslStrMembHandra
--
-- Description: Constructor
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Title to be shown on form
--    2   R      STRING      Action to be carried out on "Apply"
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslStrMembHandra(!title is STRING, !action is STRING, !handRaTmplReference is ASLHANDRAIL)
  !this.title               = !title
  !this.action              = !action
  !this.meHandraEngine      = !handRaTmplReference
endmethod

------------------------------------------------------------------------
--
-- Method:      meHandraEngine
--
-- Description: Set handrail data
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type]             [Description]
--    1   R     meHandraEngine    handrail profile data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .meHandraEngine(!handRaTmplReference is DBREF)

  !this.meHandraEngine.tmplReference =  !handRaTmplReference
  !this.handRaTmplReference          =  !handRaTmplReference

endmethod

------------------------------------------------------------------------
--
-- Method:      show
--
-- Description: Show selection form
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .show()

  -- Load section profile selection form if required
  if(undefined(!!aslStrHandraDetails)) then
    pml reload form !!aslStrHandraDetails
  endif

  -- Setup form
  !!aslStrHandraDetails.setup(!this.title, !this.action, !this.meHandraEngine)

  -- Show form
  show !!aslStrHandraDetails

endmethod
-- End of method definition
