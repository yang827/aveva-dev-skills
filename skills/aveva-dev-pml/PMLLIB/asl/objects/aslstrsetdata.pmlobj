------------------------------------------------------------------------
--
-- Method:      remGates
--
-- Description: removes gates from the gate stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       indices of gates
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .remGates(!gateIndices is ARRAY)

  do !gateIdx value !gateIndices
    !gate = !this.gates[!gateIdx]
    !this.gates.deleteFrom(!gateIdx, 1)
  enddo
  !this.gates.compress()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reorderPicks
--
-- Description: reorder the picks
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .reorderPicks()

  !lPos = !this.lPosData.position.wrt(World)
  !uPos = !this.uPosData.position.wrt(World)

  if( !lPos.up.gt(!uPos.up) ) then
    !tempPosData   = !this.lPosData
    !this.lPosData = !this.uPosData
    !this.uPosData = !tempPosData
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      replaceGate
--
-- Description: replaces an existing gate by a new one
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GATE        gate
--    2   R      REAL        gate index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .replaceGate(!gate is GATE, !gateIdx is REAL)

  !this.gates[!gateIdx] = !gate
  !this.sortGates()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resetError
--
-- Description: resets error status
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .resetError()

  -- upper landing
  if ( !this.lStrLng ) then
    !this.lStrLngEngine.resetError()
  endif

  -- segments
  do !i index !this.segmentEngines
    !this.segmentEngines[!i].resetError()
  enddo

  -- gate landings
  do !i index !this.gateLngEngines
    !this.gateLngEngines[!i].resetError()
  enddo

  -- upper landing
  if ( !this.uStrLng ) then
    !this.uStrLngEngine.resetError()
  endif

endmethod
-- End of method

