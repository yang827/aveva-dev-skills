--    3   R      ASLSTRLNGCRITERIA
--                           merged criteria for landings
--    4   R      ASLSTRLNGCRITERIA
--                           standard criteria for landings
--    5   R      ASLHANDRACRITERIA
--                           merged criteria for handrails
--    6   R      ASLHANDRACRITERIA
--                           standard criteria for handrails
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setSegmentCriteria(!strFltC is ASLSTRFLTCRITERIA, !strFltCBasis is ASLSTRFLTCRITERIA, !strLngC is ASLSTRLNGCRITERIA, !strLngCBasis is ASLSTRLNGCRITERIA, !handRaC is ASLHANDRACRITERIA, !handRaCBasis is ASLHANDRACRITERIA)

  do !segmentIdx index !this.segmentEngines
    !this.segmentEngines[!segmentIdx].setCriteria(!strFltC, !strFltCBasis, !strLngC, !strLngCBasis, !handRaC, !handRaCBasis)
  enddo

