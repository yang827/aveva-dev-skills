------------------------------------------------------------------------
--
-- Method:      setWidth
--
-- Description: sets the width for the machine
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        width
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setWidth(!width is REAL)

  !this.width = !width

  -- lower landing
  if ( !this.lStrLng ) then
    !this.lStrLngEngine.setWidth(!width)
  endif

  -- segments
  do !segmentIdx index !this.segmentEngines
    !this.segmentEngines[!segmentIdx].setWidth(!width)
  enddo

  -- upper landing
  if ( !this.uStrLng ) then
    !this.uStrLngEngine.setWidth(!width)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showVolFeedback
--
-- Description: draws the element with aid lines
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showVolFeedback()

  -- lower landing
  if ( !this.lStrLng ) then
    !this.lStrLngEngine.showVolFeedback()
  endif

  -- segments
  do !segmentEngine value !this.segmentEngines
    !segmentEngine.showVolFeedback()
  enddo

  -- gates
  do !gate value !this.gates
    !gate.showVolFeedback()
  enddo

  -- gate landings
  do !gateLngEngine value !this.gateLngEngines
    !gateLngEngine.showVolFeedback()
  enddo

  -- upper landing
  if ( !this.uStrLng ) then
    !this.uStrLngEngine.showVolFeedback()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showVolFeedback
--
-- Description: draws the element with aid lines for the machine with the given segment index
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showVolFeedback(!segmentIdx is REAL)

  !this.segmentEngines[!segmentIdx].showVolFeedback()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sortGates
--
-- Description: sorts the gates by the distance from the lower working point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .sortGates()

  -- initialize
  !distances = object ARRAY()

  -- evaluates the distances
  do !gate value !this.gates
    !distance = !this.lwp.distance(!gate.position)
    !distances.append(!distance)
  enddo

  -- sort
  !sortedIndices = !distances.sortedIndices()
  !this.gates.reIndex(!sortedIndices)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sortSegments
--
-- Description: sorts the segments by the up position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .sortSegments()

  -- initialize
  !upPositions = object ARRAY()

  -- evaluates the up positions
  do !segmentEngine value !this.segmentEngines
    !lwp = !segmentEngine.getLWP()
    !upPositions.append(!lwp.up)
  enddo

  -- sort
  !sortedIndices = !upPositions.sortedIndices()
  !this.segmentEngines.reIndex(!sortedIndices)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      unEnhance
--
-- Description: un enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .unEnhance()

  call !!aslUnEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: creates/updates a stair flight
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDB()

  -- create undo mark
  if ( !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update stair set')
    !undo.add()
  endif

  !edges = object ARRAY()

  -- creates/updates the owner element
  !!fmSys.setProgress(75)
   !this.refe              = !!aslCreate('STRFLT', !this.refe)

  !this.refe.fltDirection  =  !this.direction
  !this.refe.tWidth       = !this.width
  !this.refe.fThickness    =  !this.fThickness

   !this.refe.lRise        =  !this.getLRise(1)
   !this.refe.rise         =  !this.getRise(1)

  -- lower landing
  if ( !this.lStrLng ) then
    !!fmSys.setProgress(76)
     !this.lStrLngEngine.evaluateHandra()
     !this.lStrLngEngine.strLngData.buildHandras()
     !edges.appendarray(!this.uStrLngEngine.strLngData.centreLine.edges())
  endif

  -- all intermediated stair flights
  !!fmSys.setProgress(77)
  do !segmentIdx index !this.segmentEngines
    !this.segmentEngines[!segmentIdx].evaluateHandra()
    do !fltIdx index !this.segmentEngines[!segmentIdx].segmentData.strFltEngines
       !strFltData= !this.segmentEngines[!segmentIdx].segmentData.strFltEngines[!fltIdx].strFltData

       !lSOP  = !strFltData.lSOP
       !uSOP  = !strFltData.uSOP
       !dir   = !strFltData.direction
       !lExtn = !strFltData.lExtension
       !uExtn = !strFltData.uExtension
       !lEnd  = !lSOP.offset(!dir.opposite() , !lExtn)
       !uEnd  = !uSOP.offset(!dir, !uExtn)

       !edges.append(!lEnd)
       !edges.append(!lSOP)
       !edges.append(!uSOP)
       !edges.append(!uEnd)
       !strFltData.buildHandras()
    enddo
    do !fltIdx index !this.segmentEngines[!segmentIdx].segmentData.strLngEngines
         !strLngData = !this.segmentEngines[!segmentIdx].segmentData.strLngEngines[!fltIdx].strLngData
         !strLngData.buildHandras()
    enddo
  enddo


  -- gate landings
  !!fmSys.setProgress(83)

  -- upper landing
  if ( !this.uStrLng ) then
    !!fmSys.setProgress(84)
     !edges.appendarray(!this.uStrLngEngine.strLngData.centreLine.edges())
     !this.uStrLngEngine.evaluateHandra()
     !this.uStrLngEngine.strLngData.buildHandras()
 --  !this.uStrLngEngine.updateDB()
  endif


 !!edge = !edges
  -- create rpath of stair flights
  !this.updateRpath()

  -- end undo mark
  if ( !this.undoable ) then
    !undo.endUndoable()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updatePosData
--
-- Description: update the position data from the element itself
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updatePosData()

  !this.lPosData          = object EDGPOSITIONDATA()
  !this.lPosData.position = !this.lwp
  !direction              = !this.lCutPlane.orthogonal(U)
  !this.lPosData.line     = object LINE(!this.lPosData.position.offset(!direction, 1000mm), !this.lPosData.position.offset(!direction.opposite(), 1000mm))

  !this.uPosData          = object EDGPOSITIONDATA()
  !this.uPosData.position = !strFltData.uWP
  !direction              = !strFltData.uCutPlane.orthogonal(U)
  !this.uPosData.line     = object LINE(!this.uPosData.position.offset(!direction, 1000mm), !this.uPosData.position.offset(!direction.opposite(), 1000mm))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: creates/updates the stair set data object for the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  -- general attributes
  ---------------------------------------------------------------------------
  !this.directionOption     = 'Derived direction'
  !this.extensionOption     = 'User defined'
  !this.lPickType           = 'PLANE'
  !this.lPositionOption     = 'Explicit lower position...'
  !this.refe                = !refe
  !this.uPickType           = 'PLANE'
  !this.uPositionOption     = 'Explicit upper position...'


  -- gates landings
  ---------------------------------------------------------------------------
  -- collects all gate landings
  !collection  = object COLLECTION()
  !expression  = object EXPRESSION('FUNCTION EQ |GATE|')
  !collection.filter(!expression)
  !collection.scope(!refe)
  !collection.type('STRLNG')
  !gStrLngRefes = !collection.results()

   -- sorts the landings by their up position
  !upPosition              = object ARRAY()
  do !strLngRefe value !gStrLngRefes
    !upPosition.append(!strLngRefe.position.up)
  enddo
  !sortedIndices = !upPosition.sortedIndices()
  !gStrLngRefes.reIndex(!sortedIndices)

  -- assigns the gate landings
  !this.gateLngEngines      = object ARRAY()
  do !strLngRefe value !gStrLngRefes
    !strLngData   = object ASLSTRFLTDATA()
    !strLngData.updateDataObj(!strLngRefe, !this.direction)
    !strLngEngine = object ASLSTRFLTENGINE(!strLngData)
    !this.gateLngEngines.append(!strLngEngine)
  enddo

  -- handrails
  ---------------------------------------------------------------------------
  -- collects all handrails
  !collection = object COLLECTION()
  !collection.scope(!refe)
  !collection.type('HANDRA')
  !handRaRefes = !collection.results()

  -- intermediated landings
  ---------------------------------------------------------------------------
  -- collects all intermediated landings
  !collection = object COLLECTION()
  !expression = object EXPRESSION('FUNCTION EQ |ILNG|')
  !collection.filter(!expression)
  !collection.scope(!refe)
  !collection.type('STRLNG')
  !iStrLngRefes = !collection.results()

  -- sorts the landings by their up position
  !upPosition    = object ARRAY()
  do !strLngRefe value !iStrLngRefes
    !upPosition.append(!strLngRefe.position.up)
  enddo
  !sortedIndices = !upPosition.sortedIndices()
  !iStrLngRefes.reIndex(!sortedIndices)

  -- stair flights
  ---------------------------------------------------------------------------
  -- collects all stair flights
  !collection = object COLLECTION()
  !collection.scope(!refe)
  !collection.type('STRFLT')
  !strFltRefes = !collection.results()

  -- gets the direction from the stair flight
  !this.direction           = !strFltRefes.first().fltDirection

  -- sorts the stair flights by their up position
  !upPosition    = object ARRAY()
  do !strFltRefe value !strFltRefes
    !upPosition.append(!strFltRefe.lwp.up)
  enddo
  !sortedIndices = !upPosition.sortedIndices()
  !strFltRefes.reIndex(!sortedIndices)

  -- evaluates further attributes from stair flights
  if ( !strFltRefes.empty().not() ) then
    !this.fThickness = !strFltRefes.first().fThickness
    !this.width      = !strFltRefes.first().tWidth
    !this.oRise      = ABS(!strFltRefes.first().lwp.up - !strFltRefes.last().uWP.up)
  endif

  -- end landings
  ---------------------------------------------------------------------------
  -- lower end landing
  !collection = object COLLECTION()
  !expression = object EXPRESSION('FUNCTION EQ |LLNG|')
  !collection.filter(!expression)
  !collection.scope(!refe)
  !collection.type('STRLNG')
  !lStrLngRefes = !collection.results()
  if ( !lStrLngRefes.empty() ) then
    !this.lStrLngEngine = object ASLSTRLNGENGINE()
  else
    !strLngData         = object ASLSTRLNGDATA()
    !leavePosition     = !strFltRefes.first().lwp.offset(!strFltRefes.first().fltDirection.opposite(), !strFltRefes.first().lExtnsion)
    !strLngData.updateDataObj(!lStrLngRefes.first(), !this.direction, !lStrLngRefes.first().position, !leavePosition)
    !this.lStrLngEngine = object ASLSTRLNGENGINE(!strLngData)
  endif

  -- upper end landing
  !collection = object COLLECTION()
  !expression = object EXPRESSION('FUNCTION EQ |ULNG|')
  !collection.filter(!expression)
  !collection.scope(!refe)
  !collection.type('STRLNG')
  !uStrLngRefes = !collection.results()
  if ( !uStrLngRefes.empty() ) then
    !this.uStrLngEngine = object ASLSTRLNGENGINE()
  else
    !strLngData         = object ASLSTRLNGDATA()
    !arrivePosition    = !strFltRefes.last().uWP.offset(!strFltRefes.last().fltDirection, !strFltRefes.last().uExtnsion)
    !strLngData.updateDataObj(!uStrLngRefes.first(), !this.direction, !arrivePosition, !uStrLngRefes.first().position)
    !this.uStrLngEngine = object ASLSTRLNGENGINE(!strLngData)
  endif

  -- derive attributes
  ---------------------------------------------------------------------------
  -- setting
  !this.settingReference    = !strFltRefes.first().description.after(' ')
  !setting                  = !!aslCentralData.getSetting(!this.settingReference)

  -- stair flight template
  !this.strFltTmplReference = object DBREF(!strFltRefes.first().description.before(' '))

  -- landing template
  if ( !iStrLngRefes.empty().not() ) then
    !this.strLngTmplReference = object DBREF(!iStrLngRefes.first().description.before(' '))
  elseif ( !lStrLngRefes.empty().not() ) then
    !this.strLngTmplReference = object DBREF(!lStrLngRefes.first().description.before(' '))
  elseif ( !uStrLngRefes.empty().not() ) then
    !this.strLngTmplReference = object DBREF(!uStrLngRefes.first().description.before(' '))
  elseif ( !gStrLngRefes.empty().not() ) then
    !this.strLngTmplReference = object DBREF(!gStrLngRefes.first().description.before(' '))
  else
    !this.strLngTmplReference = !setting.collectAll('STRLNG').first()
  endif

  -- handrail template
  !this.handRaTmplReference   = !setting.collectAll('HANDRA').first()

  -- segments
  ---------------------------------------------------------------------------
  -- initialize
  !this.segmentEngines      = object ARRAY()

  -- evaluates the limits
  !from = 1
  !to   = !gStrLngRefes.size() + 1

  -- creates number of gates plus one segment
  do !i from !from to !to
    -- initialize  new segments
    !segmentEngine = object ASLSEGMENTENGINE()
    !segmentData   = !segmentEngine.segmentData


    -- analyse the a gate landing
    if ( DEFINED(!gStrLngRefes[!i]) ) then
      !gUpPosition = !gStrLngRefes[!i].position.up

      -- handles all stair flights
      do !j index !strFltRefes
        -- evaluates the distance of the up positions
        !distance = !gUpPosition - !strFltRefes[!j].lwp.up

        -- ignores stair flights of the next segment
        break if ( !distance.gt(0) )

        -- add elements of the current segment
        !strFltData   = object ASLSTRFLTDATA()
        !strFltData.updateDataObj(!strFltRefes[!j])
        !strFltEngine = object ASLSTRFLTENGINE(!strFltData)
        !segmentData.strFltEngines.append(!strFltEngine)

        -- removes the current element from stack
        !strFltRefes[!j].delete()
      enddo

      -- handles all landings
      do !j index !iStrLngRefes
        -- evaluates the distance of the up positions
        !distance = !gUpPosition - !iStrLngRefes[!j].position.up

        -- ignores stair flights of the next segment
        break if ( !distance.gt(0) )

        -- add elements of the current segment
        !strLngData   = object ASLSTRLNGDATA()
        !strLngData.updateDataObj(!iStrLngRefes[!j], !this.direction)
        !strLngEngine = object ASLSTRLNGENGINE(!strLngData)
        !segmentData.strLngEngines.append(!strLngEngine)

        -- removes the current element from stack
        !iStrLngRefes[!j].delete()
      enddo
    else

      -- handles all stair flights
      do !strFltRefe value !strFltRefes

        -- add elements of the current segment
        !strFltData   = object ASLSTRFLTDATA()
        !strFltData.updateDataObj(!strFltRefe)
        !strFltEngine = object ASLSTRFLTENGINE(!strFltData)
        !segmentData.strFltEngines.append(!strFltEngine)
      enddo

      -- handles all landings
      do !iStrLngRefe value !iStrLngRefes
        -- add elements of the current segment
        !strLngData   = object ASLSTRLNGDATA()
        !strLngData.updateDataObj(!iStrLngRefe, !this.direction)
        !strLngEngine = object ASLSTRLNGENGINE(!strLngData)
        !segmentData.strLngEngines.append(!strLngEngine)
      enddo

    endif

    -- reduce the length of the expressions
    ---------------------------------------------------------------------------
    -- stair flight
    !strFltEngines = !segmentData.strFltEngines
    if ( !strFltEngines.empty() ) then
      return
    endif
    !firstStrFltData = !strFltEngines.first().strFltData
    !lastStrFltData  = !strFltEngines.last().strFltData

    -- evaluates the current setting
    !setting = !!aslCentralData.getSetting(!firstStrFltData.settingReference)

    -- evaluates the landing template
    !strLngEngines = !segmentData.strLngEngines
    if ( !strLngEngines.empty() ) then
      !strLngTmplReference = !setting.collectAll('STRLNG').first()
    else
      !firstStrLngData     = !strLngEngines.first().strLngData
      !strLngTmplReference = !firstStrLngData.strLngTmplReference
    endif

    -- evaluate the handrail
    !collection  = object COLLECTION()
    !collection.scope(!firstStrFltData.refe)
    !collection.type('HANDRA')
    !handRaRefes = !collection.results()
    if ( !handRaRefes.empty() ) then
      !handRaTmplReference = !setting.collectAll('HANDRA').first()
    else
      !handRaData          = object ASLHANDRADATA()
      !handRaData.updateDataObj(!handRaRefes.first())
      !handRaTmplReference = !handRaData.tmplReference
    endif


    !segmentData.direction           = !this.direction
    !segmentData.extensionOption     = !this.extensionOption
    !segmentData.fThickness          = !firstStrFltData.fThickness
    !segmentData.going               = !firstStrFltData.going
    !segmentData.goingLock           = false
    !segmentData.lCutPlane           = !firstStrFltData.lCutPlane

    !orientation                     = object ORIENTATION('Z is U')
    !plane                           = object PLANE(!firstStrFltData.lwp, !orientation)
    !projectedPosition               = !plane.near(!lastStrFltData.uWP)
    !segmentData.length              = !firstStrFltData.lwp.distance(!projectedPosition)

    !segmentData.lExtension          = !firstStrFltData.lExtension
    !segmentData.lExtensionLock      = false
    !segmentData.lPickType           = 'LINE'
    !segmentData.lPosData.position   = !firstStrFltData.lwp
    !segmentData.lRise               = !firstStrFltData.lRise
    !segmentData.lSOP                = !firstStrFltData.lwp.offset(!this.direction, !segmentData.lExtension)
    !segmentData.lwp                 = !firstStrFltData.lwp
    !segmentData.oGoing              = !firstStrFltData.oGoing
    !segmentData.oGoingLock          = false

    !plane                           = object PLANE(!firstStrFltData.lwp, !orientation)
    !projectedPosition               = !plane.near(!lastStrFltData.uWP)
    !segmentData.oRise               = !lastStrFltData.uWP.distance(!projectedPosition)

    !segmentData.overlap             = !firstStrFltData.overlap
    !segmentData.pitch               = !firstStrFltData.pitch
    !segmentData.pitchLock           = false
    !segmentData.rise                = !firstStrFltData.rise
    !segmentData.riseLock            = false
    !segmentData.settingReference    = !firstStrFltData.settingReference
    !segmentData.strFltTmplReference = !firstStrFltData.strFltTmplReference
    !segmentData.handRaTmplReference = !firstStrFltData.handRaTmplReference
    !segmentData.strLngTmplReference = !strLngTmplReference
    !segmentData.treads              = !firstStrFltData.treads
    !segmentData.treadsLock          = false
    !segmentData.uCutPlane           = !lastStrFltData.uCutPlane
    !segmentData.uExtension          = !lastStrFltData.uExtension
    !segmentData.uExtensionLock      = false
    !segmentData.uPickType           = 'LINE'
    !segmentData.uPosData.position   = !lastStrFltData.uWP
    !segmentData.uRise               = !firstStrFltData.uRise
    !segmentData.uSOP                = !lastStrFltData.uWP.offset(!this.direction.opposite(), !segmentData.uExtension)
    !segmentData.uWP                 = !lastStrFltData.uWP
    !segmentData.width               = !firstStrFltData.width

    !segmentEngine.segmentData       = !segmentData

    !handRaCriteriaBasis             = !!aslCentralData.getCriteriaSet(!segmentData.settingReference, 'ASLHANDRACRITERIA')
    !handRaCriteria                  = !!getCriteriaSetIntersection(!handRaCriteriaBasis, !segmentData.handRaTmplReference)
    !handRaCriteria.complete()

    !strFltCriteriaBasis             = !!aslCentralData.getCriteriaSet(!segmentData.settingReference, 'ASLSTRFLTCRITERIA')
    !strFltCriteria                  = !!getCriteriaSetIntersection(!strFltCriteriaBasis, !segmentData.strFltTmplReference)
    !strFltCriteria.complete()

    !strLngCriteriaBasis             = !!aslCentralData.getCriteriaSet(!segmentData.settingReference, 'ASLSTRLNGCRITERIA')
    !strLngCriteria                  = !!getCriteriaSetIntersection(!strLngCriteriaBasis, !segmentData.strLngTmplReference)
    !strLngCriteria.complete()

    !segmentEngine.setCriteria(!strFltCriteria, !strFltCriteriaBasis, !strLngCriteria, !strLngCriteriaBasis, !handRaCriteria, !handRaCriteriaBasis)
    !this.segmentEngines[!i]         = !segmentEngine
  enddo

  -- gates
  ---------------------------------------------------------------------------
--  !collection = object COLLECTION()
--  !collection.scope(!refe)
--  !collection.type('STREXT')
--  !gateRefes = !collection.results()
--  !this.gates               = object ARRAY()
--  do !gateRefe value !gateRefes
--    !gate                   = object GATE(!gateRefe)
--    !this.gates.append(!gate)
--  enddo
--  !this.sortGates()


  !strFltRefe                 = !strFltRefes.first()
  if ( !this.lStrLngEngine.strLngData.centreLine.set() ) then
    !this.lwp                 = !this.lStrLngEngine.strLngData.position
    !this.lSOP                = !this.lStrLngEngine.strLngData.leavePt
    !this.lCutPlane           = !this.lStrLngEngine.strLngData.arriveCutPlane
    !planeOrientation         = object ORIENTATION('Z is ' & !strFltRefe.fltDirection.orthogonal(U))
    !plane                    = object PLANE(!this.lSOP, !planeOrientation)
    !projectedPosition        = !plane.near(!this.lwp)
    !this.lOffset             = !this.lwp.distance(!projectedPosition)
    !this.lStrLng             = true
    !angle                    = !strFltRefe.fltDirection.angle(!this.lCutPlane.orthogonal(U))
    if ( !angle.lt(90) ) then
      !this.lStrLngAngle      = 90
    else
      !this.lStrLngAngle      = -90
    endif
  else
    !this.lwp                 = !strFltRefe.lwp
    !this.lSOP                = !this.lwp.offset(!strFltRefe.fltDirection, !strFltRefe.lExtnsion)
    !this.lCutPlane           = !strFltRefe.lCutDirection
    !this.lOffset             = 0
    !this.lStrLng             = false
    !this.lStrLngAngle        = 0
  endif


  !strFltRefe                 = !strFltRefes.last()
  if ( !this.uStrLngEngine.strLngData.centreLine.set() ) then
    !this.uWP                 = !this.uStrLngEngine.strLngData.position
    !this.uSOP                = !this.uStrLngEngine.strLngData.arrivePt
    !this.uCutPlane           = !this.uStrLngEngine.strLngData.leaveCutPlane

    !planeOrientation         = object ORIENTATION('Z is ' & !strFltRefe.fltDirection.orthogonal(U))
    !plane                    = object PLANE(!this.uSOP, !planeOrientation)
    !projectedPosition        = !plane.near(!this.uWP)
    !this.uOffset             = !this.uWP.distance(!projectedPosition)
    !this.uStrLng             = true

    !angle                    = !strFltRefe.fltDirection.angle(!this.uCutPlane.orthogonal(D))
    if ( !angle.lt(90) ) then
      !this.uStrLngAngle      = 90
    else
      !this.uStrLngAngle      = -90
    endif
  else
    !this.uWP                 = !strFltRefe.uWP
    !this.uSOP                = !this.uWP.offset(!strFltRefe.fltDirection.opposite(), !strFltRefe.uExtnsion)
    !this.uCutPlane           = !strFltRefe.uCutDirection
    !this.uOffset             = 0
    !this.uStrLng             = false
    !this.uStrLngAngle        = 0
  endif

  -- evaluates the install option
  ---------------------------------------------------------------------------
  -- lower angle = -90
  if ( !this.lStrLngAngle.between(-90.01, -89.99) ) then
    -- upper angle = -90
    if ( !this.uStrLngAngle.between(-90.01, -89.99) ) then
      !this.installationOption  = 'Parallel to lines, flight left, exit backwards'

    -- upper angle = 0
    elseif ( !this.uStrLngAngle.between(-.01, 0.01) ) then
      !this.installationOption  = 'Parallel to lower line, flight left, exit front'

    -- upper angle = 90
    elseif ( !this.uStrLngAngle.between(89.99, 90.01) ) then
      !this.installationOption  = 'Parallel to lines, flight left, exit front'
    endif

  -- lower angle = 0
  elseif ( !this.lStrLngAngle.between(-.01, 0.01) ) then
    -- upper angle = -90
    if ( !this.uStrLngAngle.between(-90.01, -89.99) ) then
      !this.installationOption  = 'Parallel to upper line, exit left'

    -- upper angle = 0
    elseif ( !this.uStrLngAngle.between(-.01, 0.01) ) then
      !this.installationOption  = 'Standard installation'

    -- upper angle = 90
    elseif ( !this.uStrLngAngle.between(89.99, 90.01) ) then
      !this.installationOption  = 'Parallel to upper line, exit right'
    endif

  -- lower angle = 90
  elseif ( !this.lStrLngAngle.between(89.99, 90.01) ) then
    -- upper angle = -90
    if ( !this.uStrLngAngle.between(-90.01, -89.99) ) then
      !this.installationOption  = 'Parallel to lines, flight right, exit front'
    -- upper angle = 0
    elseif ( !this.uStrLngAngle.between(-.01, 0.01) ) then
      !this.installationOption  = 'Parallel to lower line, flight right, exit front'
    -- upper angle = 90
    elseif ( !this.uStrLngAngle.between(89.99, 90.01) ) then
      !this.installationOption  = 'Parallel to lines, flight right, exit backwards'
    endif
  endif

  !planeOrientation         = object ORIENTATION('Z is U')
  !plane                    = object PLANE(!this.lSOP, !planeOrientation)
  !projectedPosition        = !plane.near(!this.uSOP)
  !this.length              = !this.lSOP.distance(!projectedPosition)

  !direction                = !this.lCutPlane.orthogonal(U)
  !line                     = object LINE(!this.lwp.offset(!direction, 50mm), !this.lwp.offset(!direction.opposite(), 50mm))
  !this.lPosData.line       = !line
  !this.lPosData.position   = !this.lwp

  !direction                = !this.uCutPlane.orthogonal(U)
  !line                     = object LINE(!this.uWP.offset(!direction, 50mm), !this.uWP.offset(!direction.opposite(), 50mm))
  !this.uPosData.line       = !line
  !this.uPosData.position   = !this.uWP

  !this.error               = false
  !this.undoable            = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useOptimum
--
-- Description: use the optimum value for the machine with the given segment index
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .useOptimum(!segmentIdx is REAL)

  !this.segmentEngines[!segmentIdx].useOptimum()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateRpath
--
-- Description: creates/updates the stair flight data object for the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        reference element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateRpath()

 !oldRef = !!ce

 !!ce = !this.refe

 new Rpath

 !ref = !!ce

 !this.updateRpath(!ref)

 endmethod
 ------------------------------------------------------------------------
--
-- Method:      updateRpath
--
-- Description: creates/updates the stair flight data object for the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        reference element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateRpath(!rpathRef is DBREF)

 !oldRef = !!ce
 !dir = !this.direction
 !tempRpath = object ASLRPATH(!!edge)
 !rpath = object POLYLINE(!this.LWP, y is $!dir , !tempRpath.edges(f))
 !rpath.mergeLines()

 !rpath.dbWrite(!rpathRef)

 !!ce = !oldRef
endmethod

------------------------------------------------------------------------
