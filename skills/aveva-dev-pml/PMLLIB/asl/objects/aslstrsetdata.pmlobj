------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addGate(GATE)                    -                   adds a new gate to the gate stack
--  aslStrSetData()                  -                   default constructor
--  correctPickData(EDGPICKDATA)     EDGPOSITIONDATA     corrects the pick position data
--  enhance(REAL)                    -                   enhances the element for the machine with the given segment index
--  erase()                          -                   erases all traces
--  erase(REAL)                      -                   erases all traces for the machine with the given segment index
--  evaluateSegment(REAL)            -                   evaluates the given segment and return true if the evaluation was successful
--  getClearance(REAL)               REAL                returns the clearance
--  getError()                       BOOLEAN             returns the error status
--  getExtensionOption(REAL)         STRING              returns the extension option for the machine with the given segment index
--  getGates(REAL)                   ARRAY               returns an array of gates with the up position an the same level as the given up position
--  getGoing(REAL)                   REAL                returns the going for the machine with the given segment index
--  getLCutPlane(REAL)               DIRECTION           returns the direction of the lower cutplane for the machine with the given segment index
--  getLExtension()                  REAL                returns the lower extension for the machine with the given segment index
--  getLExtension(REAL)              REAL                returns the lower extension for the machine with the given segment index
--  getLRise(REAL)                   REAL                returns the lrise for the machine with the given segment index
--  getLWP(REAL)                     POSITION            returns the position of the LWP for the machine with the given segment index
--  getLock(STRING,REAL)             BOOLEAN             returns the lock flag value for the machine with the given segment index
--  getOGoing(REAL)                  REAL                returns the overall going for the machine with the given segment index
--  getORise(REAL)                   REAL                returns the overall rise for the machine with the given segment index
--  getOptima(REAL)                  ARRAY               returns the optima for the machine with the given segment index
--  getOptimumPitch(REAL)            REAL                returns the optimum pitch for the machine with the given segment index
--  getPitch(REAL)                   REAL                returns the pitch for the machine with the given segment index
--  getRise(REAL)                    REAL                returns the rise for the machine with the given segment index
--  getSettingReference(REAL)        STRING              returns the setting for the machine with the given segment index
--  getStrFltData(REAL)              ASLSTRFLTDATA       gets the stair flight data for the machine with the given segment index
--  getTreads(REAL)                  REAL                returns the treads for the machine with the given segment index
--  getUCutPlane(REAL)               DIRECTION           returns the direction of the upper cutplane for the machine with the given segment index
--  getUExtension()                  REAL                returns the upper extension
--  getUExtension(REAL)              REAL                returns the upper extension for the machine with the given segment index
--  getURise(REAL)                   REAL                returns the urise for the machine with the given segment index
--  getUWP(REAL)                     POSITION            returns the position of the UWP for the machine with the given segment index
--  getValidTreads(REAL)             ARRAY               returns valid treads for the machine with the given segment index
--  getWidth(REAL)                   ARRAY               returns width for the machine with the given segment index
--  remGates(ARRAY)                  -                   removes gates from the gate stack
--  reorderPicks()                   -                   reorder the picks
--  replaceGate(GATE,REAL)           -                   replaces an existing gate by a new one
--  resetError()                     -                   resets error status
--  setExtensionOption(STRING,REAL)  -                   sets the extension option for the machine with the given segment index
--  setGoing(REAL,REAL)              -                   sets the going for the machine with the given segment index
--  setLCutPlane(DIRECTION,REAL)     -                   sets the lower cutplane for the machine with the given segment index
--  setLExtension(REAL,REAL)         -                   sets the lower extension for the machine with the given segment index
--  setLLngCriteria(ASLSTRLNGCRITERIA,ASLSTRLNGCRITERIA) -                   sets the criteria for the lower landing
--  setLLngSettingReference(STRING)  -                   sets the setting reference for the lower landing
--  setLLngTmplReference(DBREF,DBREF) -                   sets the template reference for the lower landing
--  setLRise(REAL,REAL)              -                   sets the lrise for the machine with the given segment index
--  setLock(STRING,BOOLEAN,REAL)     -                   sets the lock flag value for the machine with the given segment index
--  setOGoing(REAL,REAL)             -                   sets the overall going for the machine with the given segment index
--  setPitch(REAL,REAL)              -                   sets the pitch for the machine with the given segment index
--  setRise(REAL,REAL)               -                   sets the rise for the machine with the given segment index
--  setSegmentCriteria(ASLSTRFLTCRITERIA,ASLSTRFLTCRITERIA,ASLSTRLNGCRITERIA,ASLSTRLNGCRITERIA,ASLHANDRACRITERIA,ASLHANDRACRITERIA) -                   sets the criteria for segments
--  setSegmentSettingReference(STRING) -                   sets the setting reference for segments
--  setSegmentTmplReferences(DBREF,DBREF,DBREF) -                   sets the template references for segments
--  setTreads(REAL,REAL)             -                   sets the treads for the machine with the given segment index
--  setUCutPlane(DIRECTION,REAL)     -                   sets the upper cutplane for the machine with the given segment index
--  setUExtension(REAL,REAL)         -                   sets the upper extension for the machine with the given segment index
--  setULngCriteria(ASLSTRLNGCRITERIA,ASLSTRLNGCRITERIA) -                   sets the criteria for the upper landing
--  setULngSettingReference(STRING)  -                   sets the setting reference for the upper landing
--  setULngTmplReference(DBREF,DBREF) -                   sets the template reference for the upper landing
--  setURise(REAL,REAL)              -                   sets the urise for the machine with the given segment index
--  setWidth(REAL)                   -                   sets the width for the machine
--  showVolFeedback()                -                   draws the element with aid lines
--  showVolFeedback(REAL)            -                   draws the element with aid lines for the machine with the given segment index
--  sortGates()                      -                   sorts the gates by the distance from the lower working point
--  sortSegments()                   -                   sorts the segments by the up position
--  unEnhance()                      -                   un enhances the element
--  updateDB()                       -                   creates/updates a stair flight
--  updateDataObj(DBREF)             -                   creates/updates the stair set data object for the element
--  updatePosData()                  -                   update the position data from the element itself
--  updateRpath()                    -                   creates/updates the stair flight data object for the element
--  updateRpath(DBREF)               -                   creates/updates the stair flight data object for the element
--  useOptimum(REAL)                 -                   use the optimum value for the machine with the given segment index
--

-- Define object
define object ASLSTRSETDATA

  -- public members
  ---------------------------------------------------------------------------
  -- direction
  member .direction             is DIRECTION

  -- direction option
  member .directionOption       is STRING

  -- extension option
  member .extensionOption       is STRING

  -- flight thickness
  member .fThickness            is REAL

  -- contains all gates
  member .gates                 is ARRAY

  -- contains all gate landings
  member .gateLngEngines        is ARRAY

  -- reference to the central template for handrail
  member .handRaTmplReference   is DBREF

  -- installation option
  member .installationOption    is STRING

  -- lower cutplane
  member .lCutPlane             is DIRECTION

  -- overall length
  member .length                is REAL

  -- lower offset
  member .lOffset               is REAL

  -- lower pick type (LINE, PLANE)
  member .lPickType             is STRING

  -- lower pick position data
  member .lPosData              is EDGPOSITIONDATA

  -- position option
  member .lPositionOption       is STRING

  -- lower SOP
  member .lSOP                  is POSITION

  -- lower landing
  member .lStrLngEngine         is ASLSTRLNGENGINE

  -- lower working point
  member .lwp                   is POSITION

  -- overall rise
  member .oRise                 is REAL

  -- reference
  member .refe                  is DBREF

  -- contains all segment engines
  member .segmentEngines        is ARRAY

  -- link to the uses setting
  member .settingReference      is STRING

  -- reference to the central template for landings
  member .strLngTmplReference   is DBREF

  -- reference to the central template for  stair flight
  member .strFltTmplReference   is DBREF

  -- upper cutplane
  member .uCutPlane             is DIRECTION

  -- upper offset
  member .uOffset               is REAL

  -- upper pick type (LINE, PLANE)
  member .uPickType             is STRING

  -- upper pick position data
  member .uPosData              is EDGPOSITIONDATA

  -- upper position option
  member .uPositionOption       is STRING

  -- upper SOP
  member .uSOP                  is POSITION

  -- upper landing
  member .uStrLngEngine         is ASLSTRLNGENGINE

  -- upper working point
  member .uWP                   is POSITION

  -- width
  member .width                 is REAL


  -- private member
  ---------------------------------------------------------------------------
  -- true if an error occurs
  member .error                 is BOOLEAN

  -- marker if a lower landing is required
  member .lStrLng               is BOOLEAN

  -- leave direction after the lower landing if there is a lower landing
  member .lStrLngAngle          is REAL

  -- marker if a upper landing is required
  member .uStrLng               is BOOLEAN

  -- leave direction after the upper landing if there is a lower landing
  member .uStrLngAngle          is REAL

  -- controls if the object uses the undo functionality
  member .undoable              is BOOLEAN

endobject
-- End of object definition for aslStrSetData

------------------------------------------------------------------------
--
-- Method:      aslStrSetData
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrSetData()

  !this.error           = false
  !this.extensionOption = 'Upper extension = Lower extension'
  !this.fThickness      = 200mm
  !this.lOffset         = 0
  !this.lPickType       = 'PLANE'
  !this.lStrLng         = false
  !this.lStrLngAngle    = 0
  !this.undoable        = false
  !this.uOffset         = 0
  !this.uPickType       = 'PLANE'
  !this.uStrLng         = false
  !this.uStrLngAngle    = 0
  !this.width           = 0

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addGate
--
-- Description: adds a new gate to the gate stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GATE        gate
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .addGate(!gate is GATE)

  !this.gates.append(!gate)
  !this.sortGates()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      correctPickData
--
-- Description: corrects the pick position data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA     pick data
-- Return:
--   [Data Type] [Description]
--    EDGPOSITIONDATA
--                pick position data
------------------------------------------------------------------------

define method .correctPickData(!pickData is EDGPICKDATA) is EDGPOSITIONDATA

  !posData = !pickData.positionData()
  if( !posData.position.unset() ) then
    if( !posData.plane.set() ) then
      !posData.position = !posData.plane.intersection(!posData.pointVector)

    else
      !posData.position = !posData.line.intersection(!posData.pointVector)
    endif
  endif

  return !posData

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: enhances the element for the machine with the given segment index
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .enhance(!segmentIdx is REAL)

  -- unenhance all
  !this.unEnhance()

  -- enhance the segment
  !this.segmentEngines[!segmentIdx].enhance()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      erase
--
-- Description: erases all traces
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .erase()

  -- upper landing
  if ( !this.lStrLng ) then
    !this.lStrLngEngine.erase()
  endif
  !this.lStrLngEngine = object ASLSTRLNGENGINE()

  -- segments
  do !segmentEngine value !this.segmentEngines
    !segmentEngine.erase()
  enddo
  !this.segmentEngines = object ARRAY()

  -- gates
  do !gate value !this.gates
--    !gate.erase()
  enddo

  -- gate landings
  do !gateLngEngine value !this.gateLngEngines
    !gateLngEngine.erase()
  enddo
  !this.gateLngEngines = object ARRAY()

  -- upper landing
  if ( !this.uStrLng ) then
    !this.uStrLngEngine.erase()
  endif
  !this.uStrLngEngine = object ASLSTRLNGENGINE()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      erase
--
-- Description: erases all traces for the machine with the given segment index
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .erase(!segmentIdx is REAL)

  !this.segmentEngines[!segmentIdx].erase()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateSegment
--
-- Description: evaluates the given segment and return true if the evaluation was successful
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateSegment(!segmentIdx is REAL)

  !this.segmentEngines[!segmentIdx].reEvaluate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getClearance
--
-- Description: returns the clearance
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
--    REAL        clearance
------------------------------------------------------------------------

define method .getClearance(!segmentIdx is REAL) is REAL

  return !this.segmentEngines[!segmentIdx].getClearance()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getError
--
-- Description: returns the error status
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     error status
------------------------------------------------------------------------

define method .getError() is BOOLEAN

  -- initialize
  !error = !this.error

  -- upper landing
  if ( !this.lStrLng ) then
    !error = !error or !this.lStrLngEngine.getError()
  endif

  -- segments
  do !segmentEngine value !this.segmentEngines
    !error = !error or !segmentEngine.getError()
  enddo

  -- gate landings
  do !gateLngEngine value !this.gateLngEngines
    !error = !error or !gateLngEngine.getError()
  enddo

  -- upper landing
  if ( !this.uStrLng ) then
    !error = !error or !this.uStrLngEngine.getError()
  endif

  return !error

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getExtensionOption
--
-- Description: returns the extension option for the machine with the given segment index
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
--    STRING      extension option
------------------------------------------------------------------------

define method .getExtensionOption(!segmentIdx is REAL) is STRING

  if ( !this.segmentEngines.size().lt(!segmentIdx) ) then
    return 'Upper extension = Lower extension'
  else
    return !this.segmentEngines[!segmentIdx].getExtensionOption()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getGates
--
-- Description: returns an array of gates with the up position an the same level as the given up position
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        up position
-- Return:
--   [Data Type] [Description]
--    ARRAY       an array of gates
------------------------------------------------------------------------

define method .getGates(!upPosition is REAL) is ARRAY

  -- initialize
  !gates = object ARRAY()

  -- checks all gates
  do !gate value !this.gates
    if ( !gate.position.up.eq(!upPosition) ) then
      !gates.append(!gate)
    endif
  enddo

  return !gates

endmethod
-- End of method

