--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
--    REAL        upper extension
------------------------------------------------------------------------

define method .getUExtension(!segmentIdx is REAL) is REAL

  return !this.segmentEngines[!segmentIdx].getUExtension()

endmethod
-- End of method

