--
--
-- Description:     container for STRFLT dimension data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrSetDim()                   -                   default constructor
--

-- Define object
define object ASLSTRSETDIM

  -- means the vertical clearance
  member .clearance           is BOOLEAN

  -- flight thickness
  member .fThickness          is BOOLEAN

  -- going
  member .going               is BOOLEAN

  -- length
  member .length              is BOOLEAN

  -- lower extension
  member .lExtension          is BOOLEAN

  -- rise of the bottom tread
  member .lRise               is BOOLEAN

  -- angle Data
  member .pitch               is BOOLEAN

  -- overall going
  member .oGoing              is BOOLEAN

  -- overall rise
  member .oRise               is BOOLEAN

  -- rise
  member .rise                is BOOLEAN

  -- width
  member .width               is BOOLEAN

  -- upper extension
  member .uExtension          is BOOLEAN

  -- rise of the top tread
  member .uRise               is BOOLEAN

endobject
-- End of object definition for aslStrSetDim

------------------------------------------------------------------------
--
-- Method:      aslStrSetDim
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrSetDim()

  !this.clearance   = false
  !this.fThickness  = false
  !this.going       = false
  !this.length      = false
  !this.lExtension  = false
  !this.lRise       = false
  !this.pitch       = false
  !this.oGoing      = false
  !this.oRise       = false
  !this.rise        = false
  !this.width       = false
  !this.uExtension  = false
  !this.uRise       = false

endmethod
-- End of method
