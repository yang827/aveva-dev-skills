------------------------------------------------------------------------

define method .erase()

  !this.strSetData.erase()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      erase
--
-- Description: erases all traces for the machine with the given segment index
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .erase(!segmentIdx is REAL)

  !this.strSetData.erase(!segmentIdx)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluate
--
-- Description: evaluates the whole stair set and returns if the evaluation was successful
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluate()

  -- remove all traces
--  !this.erase()

  -- set the working points of the stair flight
  !this.setWorkingPoints()

  if ( !this.strSetData.installationOption.matchwild('Parallel to lines, flight *, exit *') and $
       !this.strSetData.lOffset.between(0, 0.01)                                            and $
       !this.strSetData.uOffset.between(0, 0.01) ) then
    !this.strSetData.lOffset = !this.initOffset('BOTTOM')
    !this.strSetData.uOffset = !this.initOffset('TOP')
  endif

  -- evaluates some main attributes
  !this.evaluateLength()
  !this.evaluateORise()

  -- control point at the lower position
  if ( !this.strSetData.lStrLng.not() and $
       !this.strSetData.uStrLng.not() or  $
       !this.strSetData.lStrLng) then
    -- evaluates the lower SOP
    !this.evaluateLSOP()

    -- reduces the length of expressions
    !line   = !this.strSetData.uPosData.line
    !strLng = !this.strSetData.uStrLng
    !sop    = !this.strSetData.lsop
    !wp     = !this.strSetData.uwp

  -- control point at the upper position
  else
    -- evaluates the upper SOP
    !this.evaluateusop()

    -- reduces the length of expressions
    !line   = !this.strSetData.lPosData.line
    !strLng = !this.strSetData.lStrLng
    !sop    = !this.strSetData.usop
    !wp     = !this.strSetData.lwp
  endif

  -- evaluates the plane for the projection
  !planeDirection   = !this.strSetData.direction.orthogonal(U)
  !planeOrientation = object ORIENTATION('Z is ' & !planeDirection)
  !plane            = object PLANE(!sop, !planeOrientation)

  -- evaluates the projected position
  if ( !line.set() and $
       !strLng.not() ) then
    !projectedPosition = !plane.intersection(!line)
  else
    !projectedPosition = !plane.near(!wp)
  endif

  -- control point at the lower position
  if ( !this.strSetData.lStrLng.not() and $
       !this.strSetData.uStrLng.not() or  $
       !this.strSetData.lStrLng) then

    -- handles additional upper landing
    if ( !this.strSetData.uStrLng ) then
      !this.strSetData.usop = !projectedPosition.offset(!this.strSetData.direction.opposite(), !this.strSetData.width)
    else
      !this.strSetData.usop = !projectedPosition
    endif

  -- control point at the lower position
  else
    -- handles additional lower landing
    if ( !this.strSetData.lStrLng ) then
      !this.strSetData.lsop = !projectedPosition.offset(!this.strSetData.direction, !this.strSetData.width)
    else
      !this.strSetData.lsop = !projectedPosition
    endif
  endif

  !this.evaluateLOffset()
  !this.evaluateUOffset()

  !this.checkSegments()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluatedCutPlaneExtensionOffset
--
-- Description: evaluates the extension offset in case of none orthogonal cutplanes
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     lower landing required
--    2   R      REAL        angle keyword
--    3   R      DIRECTION   cutplane
-- Return:
--   [Data Type] [Description]
--    REAL        extension offset
------------------------------------------------------------------------

define method .evaluateCutPlaneExtensionOffset(!strLng is BOOLEAN, !strLngAngle is REAL, !cutPlane is DIRECTION) is REAL

  -- evaluates the direction of the landing
  !lngDirection = !this.evaluateLngDirection(!strLng, !strLngAngle)

  -- evaluates the angle between the landing direction and the cutplane
  !angle           = !lngDirection.angle(!cutPlane)
  !width           = !this.strSetData.width / 2

  -- evaluates the extension offset
  !extensionOffset = !width * !angle.tangent()

  return !extensionOffset

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateGateLngs
--
-- Description: evaluates the gate landings according to the existing gates
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       set of gate landings according to the existing gates
------------------------------------------------------------------------

define method .evaluateGateLngs() is ARRAY

  -- inits
  !gateLngEngines = object ARRAY()
  !upPositions    = object ARRAY()

  -- collects the up positions of all gates
  do !gate value !this.strSetData.gates
    !upPositions.append(!gate.position.up)
  enddo

  -- remove duplicates
  !upPositionsUnique = !upPositions
  !upPositionsUnique.sortUnique()

  -- handles all storeys
  do !upPosition value !upPositionsUnique

    -- ignore landing on the lower and upper landing
    skip if ( !this.strSetData.lStrLng                and $
              !this.strSetData.lwp.up.eq(!upPosition) or  $
              !this.strSetData.uStrLng                and $
              !this.strSetData.uwp.up.eq(!upPosition) )

    -- inits
    !strLngEngine = object ASLSTRLNGENGINE()
    !strLngEngine.strLngCriteria = !this.strLngCriteria
    !strLngEngine.setArriveCutPlane(!this.strSetData.direction)
--TODO: clearance
    !clearance    = 2000
    !strLngEngine.setClearance(!clearance)
    !strLngEngine.setLeaveCutPlane(!this.strSetData.direction)
    !strLngEngine.setPurpose('GATE')
    !strLngEngine.setSettingReference(!this.strSetData.settingReference)
    !strLngEngine.setTmplReferences(!this.strSetData.strLngTmplReference, !this.strSetData.handRaTmplReference)
    !strLngEngine.setWidth(!this.strSetData.width)


    -- evaluates all gates on the same level
    !matches      = !upPositions.find(!upPosition)

    -- evaluates the data of the first gate of the current level
    !firstMatch   = !matches.first()
    !gate         = !this.strSetData.gates[!firstMatch]
    !firstPos     = !gate.position
    !direction    = !this.strSetData.direction.opposite()
    !startPos     = !firstPos.offset(!direction, !gate.arriveOffset)

    -- evaluates the data of the last gate of the current level
    !lastMatch    = !matches.last()
    !gate         = !this.strSetData.gates[!lastMatch]
    !lastPos      = !gate.position
    !direction    = !this.strSetData.direction
    !endPos       = !lastPos.offset(!direction, !gate.leaveOffset)

    -- evaluates the centre line
    !edges[1]   = object LINE(!startPos, !endPos)

    -- set the position
    !strLngEngine.setPosition(!startPos.midpoint(!endPos))

    -- evaluates the centre line
    !centreLine = object PROFILE(!startPos, Z is U, !edges)
    !strLngEngine.setCentreLine(!centreLine)

    -- evaluates the arrive and the leave connection point
    !strLngEngine.evaluateArrivePt()
    !strLngEngine.evaluateLeavePt()

    -- evaluates the shape of the
    !strLngEngine.evaluateShape()
    !strLngEngine.evaluateHandra()

    !gateLngEngines.append(!strLngEngine)
  enddo

  -- set the gate members of the landing objects
  !this.assignGatesToLandings()

  return !gateLngEngines

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLength
--
-- Description: evaluates the length
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateLength()

  -- projection A
  !planeOrientation       = object ORIENTATION('Z is U')
  !plane                  = object PLANE(!this.strSetData.lwp, !planeOrientation)
  !projectedPosition      = !plane.near(!this.strSetData.uwp)

  -- projection B
  !planeOrientation       = object ORIENTATION('Z is ' & !this.strSetData.direction.orthogonal(U))
  !plane                  = object PLANE(!this.strSetData.lwp, !planeOrientation)
  !projectedPosition      = !plane.near(!projectedPosition)

  !this.strSetData.length = !this.strSetData.lwp.distance(!projectedPosition)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLngDirection
--
-- Description: evaluates the landing direction
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     lower landing required
--    2   R      REAL        angle keyword
-- Return:
--   [Data Type] [Description]
--    DIRECTION   direction of the landing
------------------------------------------------------------------------

define method .evaluateLngDirection(!strLng is BOOLEAN, !strLngAngle is REAL) is DIRECTION

  -- project the stair flight direction onto the plane
  !plane        = object PLANE(E0, Z is U)
  !lngDirection = !this.strSetData.direction.projected(!plane)

  -- in case of the existence of a lower quarter landing uses the arrive direction of the landing
  if ( !strLng ) then

    -- handle the different installation options
    ---------------------------------------------------------------------------
    -- stair flight right
    if ( !strLngAngle.eq(90) ) then
      !lngDirection = !lngDirection.orthogonal(U)

    -- stair flight left
    elseif ( !strLngAngle.eq(-90) ) then
      !lngDirection = !lngDirection.orthogonal(U).opposite()
    endif
  endif

  return !lngDirection

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLOffset
--
-- Description: evaluates the lower offset
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateLOffset()

  !planeOrientation        = object ORIENTATION('Z is ' & !this.strSetData.direction.orthogonal(U))
  !plane                   = object PLANE(!this.strSetData.lsop, !planeOrientation)
  !projectedPosition       = !plane.near(!this.strSetData.lwp)
  !this.strSetData.lOffset =!projectedPosition.distance(!this.strSetData.lwp)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLPickType
--
-- Description: evaluates the lower pick type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateLPickType()

  !this.strSetData.lPickType = !this.evaluatePickType(!this.strSetData.lPosData)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateLSOP
--
-- Description: evaluates the position of the LSOP
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateLSOP()

  -- evaluates the additional cutplane extension off set
  !extension = !this.evaluateCutPlaneExtensionOffset(!this.strSetData.lStrLng, !this.strSetData.lStrLngAngle, !this.strSetData.lCutPlane)

  -- half stair flight width
  !halfStrFltWidth = !this.strSetData.width / 2

  -- handles a lower and a upper end landing
  if ( !this.strSetData.lStrLng and $
       !this.strSetData.uStrLng ) then
    !extension            = !extension + !this.strSetData.lOffset
    !offsetDirection      = !this.strSetData.direction.orthogonal(D)
    !angle                = !offsetDirection.angle(!this.strSetData.lCutPlane)
    if ( !angle.gt(90) ) then
      !offsetDirection    = !offsetDirection.opposite()
    endif
    !basisPosition        = !this.strSetData.lwp.offset(!offsetDirection, !extension)
    !this.strSetData.lsop = !basisPosition.offset(!this.strSetData.direction, !halfStrFltWidth)

  -- there is a lower end landing
  elseif ( !this.strSetData.lStrLng  ) then
    -- defines the plane for the projection operation
    !planeDirection       = !this.strSetData.direction.orthogonal(U)
    !planeOrientation     = object ORIENTATION('Z is ' & !planeDirection)
    !plane                = object PLANE(!this.strSetData.uwp, !planeOrientation)

    -- projects the lower working point onto the plane and moves along the stair flight direction by
    -- the half stair flight width
    !projectedPosition    = !plane.near(!this.strSetData.lwp)
    !this.strSetData.lsop = !projectedPosition.offset(!this.strSetData.direction, !halfStrFltWidth)

  -- there is no end landing
  else
    !this.strSetData.lsop =  !this.strSetData.lwp.offset(!this.strSetData.direction, !extension)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateORise
--
-- Description: evaluates the ORise
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateORise()

  !this.strSetData.oRise = !this.strSetData.uwp.up - !this.strSetData.lwp.up

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluatePickType
--
-- Description: evaluates a pick type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA
--                           pick position data
-- Return:
--   [Data Type] [Description]
--    STRING      pick type
------------------------------------------------------------------------

define method .evaluatePickType(!posData is EDGPOSITIONDATA) is STRING

  if ( !posData.line.set() ) then
    return 'LINE'
  else
    return 'PLANE'
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateSegment
--
-- Description: evaluates the given segment and return true if the evaluation was successful
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateSegment(!segmentIdx is REAL)

  !this.strSetData.evaluateSegment(!segmentIdx)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateSegmentPts
--
-- Description: evaluates the start and end positions of segments
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of arrays with start and end positions of segments
------------------------------------------------------------------------

define method .evaluateSegmentPts() is ARRAY

  -- inits
  !startPositions = object ARRAY()
  !endPositions   = object ARRAY()

  -- checks the lower end landing
  if ( !this.strSetData.lStrLng ) then
    !position = !this.strSetData.lStrLngEngine.getLeavePt()
  else
    !position = !this.strSetData.lwp
  endif
  !startPositions.append(!position)

  -- checks the intermediated gate landings
  do !gateLngEngine value !this.strSetData.gateLngEngines
    !position = !gateLngEngine.getArrivePt()

    -- ignores
    skip if ( !this.strSetData.lwp.up.eq(!position.up) )
    !endPositions.append(!position)
    !position = !gateLngEngine.getLeavePt()
    !startPositions.append(!position)
  enddo

  -- checks the upper end landing
  if ( !this.strSetData.uStrLng ) then
    !position = !this.strSetData.uStrLngEngine.getArrivePt()
  else
    !position = !this.strSetData.uwp
  endif
  !endPositions.append(!position)

  !result[1] = !startPositions
  !result[2] = !endPositions

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateUOffset
--
-- Description: evaluates the upper offset
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateUOffset()

  !planeOrientation        = object ORIENTATION('Z is ' & !this.strSetData.direction.orthogonal(U))
  !plane                   = object PLANE(!this.strSetData.usop, !planeOrientation)
  !projectedPosition       = !plane.near(!this.strSetData.uwp)
  !this.strSetData.uOffset = !projectedPosition.distance(!this.strSetData.uwp)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      evaluateUPickType
--
-- Description: evaluates the upper pick type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateUPickType()

  !this.strSetData.uPickType = !this.evaluatePickType(!this.strSetData.uPosData)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateusop
--
-- Description: evaluates the position of the LSOP
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateusop()

  -- evaluates the additional cutplane extension off set
  !extension = !this.evaluateCutPlaneExtensionOffset(!this.strSetData.uStrLng, !this.strSetData.uStrLngAngle, !this.strSetData.uCutPlane)

  -- half stair flight width
  !halfStrFltWidth = !this.strSetData.width / 2

  -- handles a lower and a upper end landing
  if ( !this.strSetData.lStrLng and $
       !this.strSetData.uStrLng ) then
    !extension            = !extension + !this.strSetData.uOffset
    !offsetDirection      = !this.strSetData.direction.orthogonal(D)
    !angle                = !offsetDirection.angle(!this.strSetData.uCutPlane)
    if ( !angle.lt(90) ) then
      !offsetDirection    = !offsetDirection.opposite()
    endif

    !basisPosition        = !this.strSetData.uwp.offset(!offsetDirection, !extension)
    !this.strSetData.usop = !basisPosition.offset(!this.strSetData.direction.opposite(), !halfStrFltWidth)

  -- there is a upper end landing
  elseif ( !this.strSetData.uStrLng  ) then

    -- defines the plane for the projection operation
    !planeDirection       = !this.strSetData.direction.orthogonal(U)
    !planeOrientation     = object ORIENTATION('Z is ' & !planeDirection)
    !plane                = object PLANE(!this.strSetData.lwp, !planeOrientation)

    -- projects the lower working point onto the plane and moves against the stair flight direction by
    -- the half stair flight width
    !projectedPosition    = !plane.near(!this.strSetData.uwp)
    !this.strSetData.usop = !projectedPosition.offset(!this.strSetData.direction.opposite(), !halfStrFltWidth)

  -- there is no end landing
  else
    !this.strSetData.usop = !this.strSetData.uwp.offset(!this.strSetData.direction, !extension)
  endif

endmethod
-- End of method

