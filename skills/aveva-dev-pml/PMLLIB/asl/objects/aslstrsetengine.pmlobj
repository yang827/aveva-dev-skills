------------------------------------------------------------------------

define method .aslStrSetEngine()



endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addGate
--
-- Description: adds a new gate to the gate stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GATE        gate
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .addGate(!gate is GATE)

  -- adds the new gate
  !this.strSetData.addGate(!gate)

  -- checks the existing segments and recalculates the if it is necessary
  !this.checkSegments()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      assignGatesToLandings
--
-- Description: assign the gates to the landings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .assignGatesToLandings()

  -- clear all gates
  do !i index !this.strSetData.strLngEngines
    !this.strSetData.strLngEngines[!i].strLngData.gates = ARRAY()
  enddo

  do !gate value !this.strSetData.gates
    do !i index !this.strSetData.strLngEngines
      !upStrLng = !this.strSetData.strLngEngines[!i].strLngData.shape.position.wrt(WORLD).up
      !upGate   = !gate.position.wrt(WORLD).up
      !distance = ABS(!upStrLng - !upGate)

      if ( !distance.lt(1) ) then
        !this.strSetData.strLngEngines[!i].strLngData.gates.append(!gate)
      endif
    enddo
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkSegments
--
-- Description: checks the validity of the segments
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .checkSegments()

  -- updates the required landings
  !!fmSys.setProgress(5)
  !this.updateGateLngs()
  !!fmSys.setProgress(6)
  !this.updateLLng()
  !!fmSys.setProgress(7)
  !this.updateULng()

  -- evaluates the start and end positions of segments
  !result         = !this.evaluateSegmentPts()
  !startPositions = !result[1]
  !endPositions   = !result[2]

  -- checks all existing segments
  !!fmSys.setProgress(8)
  do !segmentIdx index !this.strSetData.segmentEngines
    -- evaluates the start and end position of the current segment
    !segmentEngine = !this.strSetData.segmentEngines[!segmentIdx]
    !startPosition = !segmentEngine.getLWP()
    !endPosition   = !segmentEngine.getUWP()

    -- search the start and end position within the start and end position stack
    !startPosMatch = !startPositions.find( !startPosition)
    !endPosMatch   = !endPositions.find(!endPosition)

    -- evaluates the common matches
    !commonMatches = !startPosMatch.intersect(!endPosMatch)

    -- deletes the invalid segment
    if ( !commonMatches.empty() ) then
      !this.strSetData.segmentEngines[!segmentIdx].erase()
      !this.strSetData.segmentEngines[!segmentIdx].delete()

    -- removes the current pair of start and end position as already connected
    else
      !firstMatch = !commonMatches.first()
      !startPositions[!firstMatch].delete()
      !endPositions[!firstMatch].delete()
    endif
  enddo

  -- creates missing segments
  !!fmSys.setProgress(10)
  !progressRange = 65
  do !i index !startPositions

    -- inits
    !segmentData                      = object ASLSEGMENTDATA()
    !segmentData.direction            = !this.strSetData.direction
    !segmentData.extensionOption      = !this.strSetData.extensionOption
    !segmentData.fThickness           = !this.strSetData.fThickness

    !segmentData.lPickType            = 'LINE'
    !segmentData.lExtension           = 0
    !segmentData.lwp                  = !startPositions[!i]
    !segmentData.lsop                 = !segmentData.lwp
    !segmentData.oGoing               = 0
    !segmentData.progressRange        = !progressRange / !startPositions.size()
    !segmentData.setSettingReference(!this.strSetData.settingReference)
    !segmentData.setTmplReferences(!this.strSetData.strFltTmplReference, !this.strSetData.strLngTmplReference, !this.strSetData.handRaTmplReference)
    !segmentData.uPickType            = 'LINE'
    !segmentData.uExtension = 0
    !segmentData.uwp                  = !endPositions[!i]
    !segmentData.usop                 = !segmentData.uwp
    !segmentData.width                = !this.strSetData.width

    -- handles gates on the extensions
    do !gateLngEngine value !this.strSetData.gateLngEngines
      if ( !segmentData.lwp.up.eq(!gateLngEngine.strLngData.position.up) ) then
        !segmentData.lExtension = !segmentData.lwp.distance(!gateLngEngine.strLngData.leavePt)
        !segmentData.lsop       = !gateLngEngine.strLngData.leavePt
      endif

      if ( !segmentData.uwp.up.eq(!gateLngEngine.strLngData.position.up) ) then
        !segmentData.uExtension = !segmentData.uwp.distance(!gateLngEngine.strLngData.arrivePt)
        !segmentData.usop       = !gateLngEngine.strLngData.arrivePt
      endif
    enddo

    -- assigns and evaluates
    !segmentEngine                     = object ASLSEGMENTENGINE()
    !segmentEngine.setCriteria(!this.strFltCriteria, !this.strFltCriteriaBasis, !this.strLngCriteria, !this.strLngCriteriaBasis, !this.handRaCriteria, !this.handRaCriteriaBasis)

    !segmentEngine.segmentData = !segmentData
    !segmentEngine.evaluateLength()
    !segmentEngine.evaluateORise()

    -- sets the lower cutplane and the lower additional extension offset
    if ( !this.strSetData.lStrLng or $
         !segmentData.lwp.up.neq(!this.strSetData.lwp.up) ) then
      !segmentEngine.setLCutPlane(!this.strSetData.direction)
    else
      !segmentEngine.setLCutPlane(!this.strSetData.lCutPlane)
    endif

    -- sets the upper cutplane
    if ( !this.strSetData.uStrLng or $
         !segmentData.uwp.up.neq(!this.strSetData.uwp.up) ) then
      !segmentEngine.setUCutPlane(!this.strSetData.direction)
    else
      !segmentEngine.setUCutPlane(!this.strSetData.uCutPlane)
    endif

    !segmentEngine.evaluate()

    !this.strSetData.segmentEngines.append(!segmentEngine)
  enddo

  -- sorts the segments
  !this.strSetData.sortSegments()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      correctCutPlanes
--
-- Description: corrects cutplanes according the selected install option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .correctCutPlanes()

  -- lower end landing
  ---------------------------------------------------------------------------
  -- leave direction left
  if ( !this.strSetData.lStrLngAngle.eq(-90) ) then
    !direction = !this.strSetData.direction.orthogonal(D)

  -- leave direction forward (no lower end landing)
  elseif ( !this.strSetData.lStrLngAngle.eq(0) ) then
    !direction = !this.strSetData.direction

  -- leave direction right
  elseif ( !this.strSetData.lStrLngAngle.eq(90) ) then
    !direction = !this.strSetData.direction.orthogonal(U)
  endif

  -- check for flip
  !angle = !direction.angle(!this.strSetData.lCutPlane)
  if ( !angle.lt(90) ) then
    !this.strSetData.lCutPlane = !this.strSetData.lCutPlane.opposite()
  endif



  -- upper end landing
  ---------------------------------------------------------------------------
  -- leave direction left
  if ( !this.strSetData.uStrLngAngle.eq(-90) ) then
    !direction = !this.strSetData.direction.orthogonal(U)

  -- leave direction forward (no upper end landing)
  elseif ( !this.strSetData.uStrLngAngle.eq(0) ) then
    !direction = !this.strSetData.direction

  -- leave direction right
  elseif ( !this.strSetData.uStrLngAngle.eq(90) ) then
    !direction = !this.strSetData.direction.orthogonal(D)
  endif

  -- check for flip
  !angle = !direction.angle(!this.strSetData.uCutPlane)
  if ( !angle.lt(90) ) then
    !this.strSetData.uCutPlane = !this.strSetData.uCutPlane.opposite()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      correctPickedLines
--
-- Description: corrects picked Lines according the selected install option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .correctPickedLines()

  -- evaluates the derived direction
  ---------------------------------------------------------------------------
  !horiPlane = object PLANE(E0, Z is U)
  !direction = !this.strSetData.lPosData.position.direction(!this.strSetData.uPosData.position)
  if ( !direction.eq(U) ) then
    !derivedDirection = N
  else
    !derivedDirection = !direction.projected(!horiPlane)
  endif

  -- corrects the lower line
  ---------------------------------------------------------------------------
  !cross = !derivedDirection.orthogonal(!this.strSetData.lPosData.line.direction())
  if ( !cross.angle(U).lt(90) ) then
    !this.strSetData.lPosData.line = !this.strSetData.lPosData.line.reverseSense()
  endif

  -- corrects the upper line
  ---------------------------------------------------------------------------
  !cross = !derivedDirection.orthogonal(!this.strSetData.uPosData.line.direction())
  if ( !cross.angle(U).lt(90) ) then
    !this.strSetData.uPosData.line = !this.strSetData.uPosData.line.reverseSense()
  endif

endmethod
-- End of method

