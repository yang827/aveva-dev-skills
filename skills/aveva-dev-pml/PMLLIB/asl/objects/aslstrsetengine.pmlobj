endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getLPositionOptions
--
-- Description: returns all allowed position options for the lower working point
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       description and pixmap of options
------------------------------------------------------------------------

define method .getLPositionOptions() is ARRAY

  -- inits
  !positionLabels  = object ARRAY()
  !positionPixmaps = object ARRAY()

  -- reduces the size of the expressions
  !lPosData        = !this.strSetData.lPosData
  !uPosData        = !this.strSetData.uPosData

  -- two lines
  ---------------------------------------------------------------------------
  if ( !lPosData.line.set() and $
       !uPosData.line.set() ) then

    -- is the left or the right end of the line nearer to the pick?
    if ( !lPosData.position.distance(!lPosData.line.startPosition).lt(!lPosData.position.distance(!lPosData.line.endPosition)) ) then
      !positionLabels.append('Right align with lower line')
      !positionPixmaps.append(!!pml.getPathName('aslpositionsituation01-16.png'))
      !positionLabels.append('Left align with lower line')
      !positionPixmaps.append(!!pml.getPathName('aslpositionsituation02-16.png'))
    else
      !positionLabels.append('Left align with lower line')
      !positionPixmaps.append(!!pml.getPathName('aslpositionsituation02-16.png'))
      !positionLabels.append('Right align with lower line')
      !positionPixmaps.append(!!pml.getPathName('aslpositionsituation01-16.png'))
    endif

    !positionLabels.append('Centre align with lower line')
    !positionPixmaps.append(!!pml.getPathName('aslpositionsituation03-16.png'))

  -- one line and one point
  ---------------------------------------------------------------------------
  elseif ( !lPosData.line.set()   and $
           !uPosData.line.unset() or  $
           !lPosData.line.unset() and $
           !uPosData.line.set() ) then

    -- is the left or the right end of the line nearer to the pick?
    if ( !lPosData.line.set() ) then
      if (  !lPosData.position.distance(!lPosData.line.startPosition).lt(!lPosData.position.distance(!lPosData.line.endPosition)) ) then
        !positionLabels.append('Left align with lower line')
        !positionPixmaps.append(!!pml.getPathName('aslpositionsituation02-16.png'))
        !positionLabels.append('Right align with lower line')
        !positionPixmaps.append(!!pml.getPathName('aslpositionsituation01-16.png'))
      else
        !positionLabels.append('Right align with lower line')
        !positionPixmaps.append(!!pml.getPathName('aslpositionsituation01-16.png'))
        !positionLabels.append('Left align with lower line')
        !positionPixmaps.append(!!pml.getPathName('aslpositionsituation02-16.png'))
      endif
      !positionLabels.append('Centre align with lower line')
      !positionPixmaps.append(!!pml.getPathName('aslpositionsituation03-16.png'))
    endif
  endif

  -- derived position and explicit position
  !positionLabels.append('Derived lower position')
  !positionPixmaps.append(!!pml.getPathName('aslpositionsituation09-16.png'))
  !positionLabels.append('Explicit lower position...')
  !positionPixmaps.append(!!pml.getPathName('aslpositionsituation07-16.png'))


  !positionOptions = object ARRAY()
  !positionOptions.append(!positionLabels)
  !positionOptions.append(!positionPixmaps)

  return !positionOptions

endmethod
-- End of method

