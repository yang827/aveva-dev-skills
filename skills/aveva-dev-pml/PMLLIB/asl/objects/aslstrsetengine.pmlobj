-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: reads the stair flight data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        reference element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  !this.strSetData.updateDataObj(!refe)

  do !i index !this.strSetData.segmentEngines
    if ( !i.eq(1) ) then
      !this.strFltCriteriaBasis  = !this.strSetData.segmentEngines[!i].strFltCriteriaBasis
      !this.strLngCriteriaBasis  = !this.strSetData.segmentEngines[!i].strLngCriteriaBasis
      !this.handRaCriteriaBasis  = !this.strSetData.segmentEngines[!i].handRaCriteriaBasis
      !this.mergeCriteria()
    endif

    -- saves the data from the existing landings and stair flights
    !strFltEngines = !this.strSetData.segmentEngines[!i].segmentData.strFltEngines
    !strLngEngines = !this.strSetData.segmentEngines[!i].segmentData.strLngEngines

    -- clear the object
    !this.strSetData.segmentEngines[!i].segmentData.strFltEngines = object ARRAY()
    !this.strSetData.segmentEngines[!i].segmentData.strLngEngines = object ARRAY()

    -- evaluates
    !this.strSetData.segmentEngines[!i].evaluate()

    -- integrates the existing landings and stair flights
    do !j index !strFltEngines
      !this.strSetData.segmentEngines[!i].segmentData.strFltEngines[!j].strFltData = !strFltEngines[!j].strFltData
    enddo

    do !j index !strLngEngines
      !this.strSetData.segmentEngines[!i].segmentData.strLngEngines[!j].strLngData = !strLngEngines[!j].strLngData
    enddo
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateLLng
--
-- Description: updates the lower landing
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateLLng()

  -- evaluates the new lower landing
  if ( !this.strSetData.lStrLng ) then

    -- inits
    !strLngEngine = object ASLSTRLNGENGINE()
    !strLngEngine.setArriveCutPlane(!this.strSetData.lCutPlane)
--TODO: clearance
    !clearance    = 2000mm
    !strLngEngine.setClearance(!clearance)
    !strLngEngine.setLeaveCutPlane(!this.strSetData.direction)
    !strLngEngine.setPurpose('LLNG')
    !strLngEngine.setSettingReference(!this.strSetData.settingReference)
    !strLngEngine.setTmplReferences(!this.strSetData.strLngTmplReference, !this.strSetData.handRaTmplReference)
    !strLngEngine.setWidth(!this.strSetData.width)


    -- evaluates the origin position of the landing
    !direction   = !this.strSetData.direction.orthogonal(D)
    !orientation = object ORIENTATION('Z is ' & !direction)
    !plane       = object PLANE(!this.strSetData.lsop, !orientation)
    !position    = !plane.near(!this.strSetData.lwp)

    !strLngEngine.setPosition(!this.strSetData.lwp)

    -- evaluates the gates on the same level
    !gates = !this.strSetData.getGates(!this.strSetData.lwp.up)

    -- no gates
    if ( !gates.empty() ) then
      !endPosition = !this.strSetData.lsop

    -- analyse gates
    else
      !gate        = !gates.last()
      !direction   = !this.strSetData.direction
      !offset      = !gate.leaveOffset
      !endPosition = !gate.position.offset(!direction, !offset)
    endif


    -- evaluates and sets the centre line
    !edges[1]   = object LINE(!this.strSetData.lwp, !position)
    !edges[2]   = object LINE(!position, !endPosition)
    !centreLine = object PROFILE(!this.strSetData.lwp, Z is U, !edges)
    !strLngEngine.setCentreLine(!centreLine)

    -- evaluates the arrive and the leave connection point
    !strLngEngine.evaluateArrivePt()
    !strLngEngine.evaluateLeavePt()

    -- evaluates the shape of the
    !strLngEngine.evaluateShape()
    !strLngEngine.evaluateHandra()

    -- compare the existing and the currently evaluated lower landing
    !currentProfile   = !strLngEngine.getShape()
    !referenceProfile = !this.strSetData.lStrLngEngine.getShape()
    if ( !currentProfile.neq(!referenceProfile) ) then
      -- overwrite the existing landing with the new landing
      !this.strSetData.lStrLngEngine.erase()
      !this.strSetData.lStrLngEngine = !strLngEngine
    endif
  else
    !this.strSetData.lStrLngEngine.erase()
    !this.strSetData.lStrLngEngine = object ASLSTRLNGENGINE()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateGateLngs
--
-- Description: updates the gate landing stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateGateLngs()

  !newLngEngines            = !this.evaluateGateLngs()
  !newCurrLngEnginesIndices = object ARRAY()
  !oldCurrLngEnginesIndices = object ARRAY()
  !oldLngEngines            = !this.strSetData.gateLngEngines

  -- evaluates the indices of all unchanged gate landings
  ---------------------------------------------------------------------------
  -- handles all new evaluated landings
  do !i index !newLngEngines
    -- reduces the length of the expressions
    !newLngData = !newLngEngines[!i].strLngData

    -- handles all existing landings
    do !j index !oldLngEngines
      -- reduces the length of the expressions
      !oldLngData = !oldLngEngines[!j].strLngData

      -- checks the significant attribute of the landings
      skip if ( !newLngData.centreLine.neq(!oldLngData.centreLine) )

      !newCurrLngEnginesIndices.append(!i)
      !oldCurrLngEnginesIndices.append(!j)
    enddo
  enddo

  -- evaluates the indices for the delete landing process
  !indices = !oldLngEngines.indices().difference(!oldCurrLngEnginesIndices)

  -- delete landings
  do !i value !indices
    !this.strSetData.gateLngEngines[!i].erase()
    !this.strSetData.gateLngEngines[!i].delete()
  enddo

  -- removes the gaps after delete
  !this.strSetData.gateLngEngines.compress()

  -- evaluates the indices for the create landing process
  !indices = !newLngEngines.indices().difference(!newCurrLngEnginesIndices)

  -- add landings
  do !i value !indices
    !this.strSetData.gateLngEngines.append(!newLngEngines[!i])
  enddo

  -- sorts the landings
  ---------------------------------------------------------------------------
  -- inits
  !distancesFromLSOP = object ARRAY()

  -- evaluates the distances of all landing from the lower SOP
  do !gateLngEngine value !this.strSetData.gateLngEngines
    !distance = !this.strSetData.lsop.distance(!gateLngEngine.strLngData.position)
    !distancesFromLSOP.append(!distance)
  enddo

  -- change order
  !sortedIndices = !distancesFromLSOP.sortedIndices()
  !this.strSetData.gateLngEngines.reIndex(!sortedIndices)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateULng
--
-- Description: updates the upper landing
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateULng()

  -- evaluates the new lower landing
  if ( !this.strSetData.uStrLng ) then
    -- inits
    !strLngEngine = object ASLSTRLNGENGINE()
    !strLngEngine.setArriveCutPlane(!this.strSetData.direction)
--TODO: clearance
    !clearance    = 2000mm
    !strLngEngine.setClearance(!clearance)
    !strLngEngine.setLeaveCutPlane(!this.strSetData.uCutPlane)
    !strLngEngine.setPurpose('ULNG')
    !strLngEngine.setSettingReference(!this.strSetData.settingReference)
    !strLngEngine.setTmplReferences(!this.strSetData.strLngTmplReference, !this.strSetData.handRaTmplReference)
    !strLngEngine.setWidth(!this.strSetData.width)

    -- evaluates the origin position of the landing
    !direction   = !this.strSetData.direction.orthogonal(D)
    !orientation = object ORIENTATION('Z is ' & !direction)
    !plane       = object PLANE(!this.strSetData.usop, !orientation)
    !position    = !plane.near(!this.strSetData.uwp)

    -- evaluates the gates on the same level
    !gates = !this.strSetData.getGates(!this.strSetData.uwp.up)

    -- no gates
    if ( !gates.empty() ) then
      !startPosition = !this.strSetData.usop

    -- analyse gates
    else
      !gate          = !gates.first()
      !direction     = !this.strSetData.direction.oppostite()
      !offset        = !gate.arriveOffset
      !startPosition = !gate.position.offset(!direction, !offset)
    endif

    !strLngEngine.setPosition(!startPosition)

    -- evaluates and sets the centre line
    !edges[1]   = object LINE(!startPosition, !position)
    !edges[2]   = object LINE(!position, !this.strSetData.uwp)

    !centreLine = object PROFILE(!startPosition, Z is U, !edges)
    !strLngEngine.setCentreLine(!centreLine)

    -- evaluates the arrive and the leave connection point
    !strLngEngine.evaluateArrivePt()
    !strLngEngine.evaluateLeavePt()

    -- evaluates the shape of the
    !strLngEngine.evaluateShape()
    !strLngEngine.evaluateHandra()

    -- compare the existing and the currently evaluated lower landing
    !currentProfile   = !strLngEngine.getShape()
    !referenceProfile = !this.strSetData.uStrLngEngine.getShape()
    if ( !currentProfile.neq(!referenceProfile) ) then
      -- overwrite the existing landing with the new landing
      !this.strSetData.uStrLngEngine.erase()
      !this.strSetData.uStrLngEngine = !strLngEngine
    endif
  else
    !this.strSetData.uStrLngEngine.erase()
  endif

endmethod
-- End of method

