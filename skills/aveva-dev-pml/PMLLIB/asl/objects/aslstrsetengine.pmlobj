------------------------------------------------------------------------
--
-- Method:      setGates
--
-- Description: sets all gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of all gates
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setGates(!gates is ARRAY)

  -- evaluates the added and the removed gates
  !addGates = !gates.difference(!this.strSetData.gates)
  !unusedRemGates = !this.strSetData.gates.difference(!gates)
  !oldGates = !this.strSetData.gates.intersect(!gates)

  -- assigns the gates to the gate stack
  !this.strSetData.gates = !oldGates
  !this.strSetData.gates.appendArray(!addGates)

  -- sorts the gate stack
  !this.strSetData.sortGates()

endmethod
-- End of method

