------------------------------------------------------------------------
--
-- Method:      initOffset
--
-- Description: evaluates the extension offset in case of uturn for the given location key
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      location
-- Return:
--   [Data Type] [Description]
--    REAL        extension offset
------------------------------------------------------------------------

define method .initOffset(!location is STRING) is REAL

  -- evaluates the plane
  !planePosition    = !this.strSetData.lwp
  !planeDirection   = !this.strSetData.direction.orthogonal(U)
  !planeOrientation = object ORIENTATION('Z is ' & !planeDirection.string())
  !plane            = object PLANE(!planePosition, !planeOrientation)

  -- project the upper working point onto the plane
  !projectedWP      = !plane.near(!this.strSetData.uwp)
  !line             = object LINE(!this.strSetData.uwp, !projectedWP)
  !lineLength       = !line.length()

  if ( !this.strSetData.installationOption.matchwild('Parallel to lines, flight *, exit backwards') ) then
    !angle = !this.strSetData.lCutPlane.angle(!line.direction())
    if ( !angle.gt(90) ) then
      if ( !location.eq('BOTTOM') ) then
        !offset = !lineLength + !this.strSetData.width / 2

      else
        !offset = !this.strSetData.width / 2
      endif

    else
      if ( !location.eq('BOTTOM') ) then
        !offset = !this.strSetData.width / 2

      else
        !offset = !lineLength + !this.strSetData.width / 2
      endif
    endif

  elseif ( !this.strSetData.installationOption.matchwild('Parallel to lines, flight *, exit front') ) then
    !offset = !lineLength / 2
  endif

  return !offset

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mergeCriteria
--
-- Description: merges central standard with fabricator standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergeCriteria()

  -- gets the values for the stair flights from the substandard
  !this.strFltCriteria = !!getCriteriaSetIntersection(!this.strFltCriteriaBasis, !this.strSetData.strFltTmplReference)
  !this.strFltCriteria.complete()

  -- gets the values for the end landing from the substandard
  !this.strLngCriteria  = !!getCriteriaSetIntersection(!this.strLngCriteriaBasis, !this.strSetData.strLngTmplReference)
  !this.strLngCriteria.complete()

  -- gets the values for the end landing from the substandard
  !this.handRaCriteria  = !!getCriteriaSetIntersection(!this.handRaCriteriaBasis, !this.strSetData.handRaTmplReference)
  !this.handRaCriteria.complete()

  -- sets criteria and template data
  !this.setMainData()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      newDefaults
--
-- Description: sets the attributes for a new stair set (defaults)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       the strflt tmpl reference
--    2   R      DBREF       the intermediate landing tmpl reference
--    3   R      DBREF       the handrail tmpl reference
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .newDefaults(!strFltTmplReference is DBREF, !strLngTmplReference is DBREF, !handRaTmplReference is DBREF)

  -- sets the criteria
  !this.setCriteria()

  -- sets the reference to the central template
  !this.setSettingReference()

  -- if the dbref is part of the current standard use it, otherwise take the first best of the standard
  !allStrFlts = !!aslCentralData.currSetting.collectAll('STRFLT')
  if ( !allStrFlts.findFirst(!strFltTmplReference).set() ) then
    !strFltTmpl = !strFltTmplReference
  else
    !strFltTmpl = !allStrFlts.first()
  endif

  !allStrLngs = !!aslCentralData.currSetting.collectAll('STRLNG')
  if ( !allStrLngs.findFirst(!strLngTmplReference).set() ) then
    !strLngTmpl = !strLngTmplReference
  else
    !strLngTmpl = !allStrLngs.first()
  endif

  -- if the dbref is part of the current standard use it, otherwise take the first best of the standard
  !allHandRas = !!aslCentralData.currSetting.collectAll('HANDRA')
  if ( !allHandRas.findFirst(!handRaTmplReference).set() ) then
    !handRaTmpl = !handRaTmplReference
  else
    !handRaTmpl = !allHandRas.first()
  endif

  -- selects the templates
  !this.setTmplReferences(!strFltTmpl, !strLngTmpl, !handRaTmpl)

  -- combines general and fabricator standard
  !this.mergeCriteria()

  -- set the optimum width
  !this.setOptimumWidth()

endmethod
-- End of method

