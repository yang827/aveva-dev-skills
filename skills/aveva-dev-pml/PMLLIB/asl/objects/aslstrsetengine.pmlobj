------------------------------------------------------------------------
--
-- Method:      setLPositionOption
--
-- Description: sets the lower position option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      lower position option
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLPositionOption(!lPositionOption is STRING)

  !this.strSetData.lPositionOption = !lPositionOption

  -- analyses the position option
  ---------------------------------------------------------------------------
  -- evaluates the mid point of the lower line
  if ( !this.strSetData.lPositionOption.eq('Centre align with lower line') ) then
    !line                = !this.strSetData.lPosData.line
    !this.strSetData.lwp = !line.proportion(0.5)

  -- uses the lower pick position
  elseif ( !this.strSetData.lPositionOption.eq('Derived lower position') ) then
    !this.strSetData.lwp = !this.strSetData.lPosData.position

  -- uses user input for the lower position
  elseif ( !this.strSetData.lPositionOption.eq('Explicit lower position...') ) then

  -- uses the start point of the lower line
  elseif ( !this.strSetData.lPositionOption.eq('Left align with lower line') ) then
    !line                = !this.strSetData.lPosData.line
    !this.strSetData.lwp = !line.startPosition

  -- uses the end point of the lower line
  elseif ( !this.strSetData.lPositionOption.eq('Right align with lower line') ) then
    !line                = !this.strSetData.lPosData.line
    !this.strSetData.lwp = !line.endPosition
  endif

  if ( !this.strSetData.installationOption.eq('Standard installation') ) then
    !this.strSetData.uPositionOption = ''
  endif

endmethod
-- End of method

-------------------------------------------------------------------------
--
-- Method:      setMainData
--
-- Description: sets the main data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setMainData()

  -- handles the lower end landing
  ---------------------------------------------------------------------------
  if (  !this.strSetData.lStrLng ) then
    !this.strSetData.setLLngCriteria(!this.strLngCriteria, !this.strLngCriteriaBasis, !this.handRaCriteria, !this.handRaCriteriaBasis)
    !this.strSetData.setLLngSettingReference(!this.strSetData.settingReference)
    !this.strSetData.setLLngTmplReference(!this.strSetData.strLngTmplReference, !this.strSetData.handRaTmplReference)
  endif


  -- handles all segments
  ---------------------------------------------------------------------------
  !this.strSetData.setSegmentCriteria(!this.strFltCriteria, !this.strFltCriteriaBasis, !this.strLngCriteria, !this.strLngCriteriaBasis, !this.handRaCriteria, !this.handRaCriteriaBasis)
  !this.strSetData.setSegmentSettingReference(!this.strSetData.settingReference)
  !this.strSetData.setSegmentTmplReferences(!this.strSetData.strFltTmplReference, !this.strSetData.strLngTmplReference, !this.strSetData.handRaTmplReference)


  -- handles the upper end landing
  ---------------------------------------------------------------------------
  if (  !this.strSetData.uStrLng ) then
    !this.strSetData.setULngCriteria(!this.strLngCriteria, !this.strLngCriteriaBasis, !this.handRaCriteria, !this.handRaCriteriaBasis)
    !this.strSetData.setULngSettingReference(!this.strSetData.settingReference)
    !this.strSetData.setULngTmplReference(!this.strSetData.strLngTmplReference, !this.strSetData.handRaTmplReference)
  endif

endmethod
-- End of method

