------------------------------------------------------------------------
--
-- Method:      setUOffset
--
-- Description: sets the upper offset
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        offset extension
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setUOffset(!offset is REAL)

  -- allows only positive values
  if ( !offset.leq(0) ) then
    !validOffset =  !this.strSetData.width / 2
  else
    !validOffset = !offset + !this.strSetData.width / 2
  endif

  -- flight left or right exit backwards
  if ( !this.strSetData.installationOption.matchwild('Parallel to lines, flight *, exit backwards') ) then
    -- evaluates the delta between the old and the new offset
    !deltaOffset = !validOffset - !this.strSetData.uOffset

    -- evaluates the new value for the upper offset temporary
    !lOffset     = !this.strSetData.lOffset + !deltaOffset

    -- checks the validity of the required offset
    if ( !lOffset.geq(!this.strSetData.width / 2) ) then
      !this.strSetData.lOffset = !lOffset
      !this.strSetData.uOffset = !validOffset
    else
      !this.strSetData.lOffset = !this.strSetData.width / 2
      !this.strSetData.uOffset = !validOffset - !lOffset + !this.strSetData.width / 2
    endif

  -- flight left or right exit front
  elseif ( !this.strSetData.installationOption.matchwild('Parallel to lines, flight *, exit front') ) then
    -- evaluates the available distance for offsets
    !availableDistance = !this.strSetData.lOffset + !this.strSetData.uOffset
    -- checks the validity of the required offset
    if ( !availableDistance.gt(!validOffset) ) then
      !this.strSetData.lOffset = !availableDistance - !validOffset
      !this.strSetData.uOffset = !validOffset

    else
      !this.strSetData.lOffset = !this.strSetData.width / 2
      !this.strSetData.uOffset = !availableDistance - !this.strSetData.width
    endif
  endif

  !this.evaluateLSOP()
  !this.evaluateusop()

  !this.checkSegments()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setUPosData
