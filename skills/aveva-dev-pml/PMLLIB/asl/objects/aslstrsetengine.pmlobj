--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addGate(GATE)                    -                   adds a new gate to the gate stack
--  aslStrSetEngine()                -                   Constructor
--  assignGatesToLandings()          -                   assign the gates to the landings
--  checkSegments()                  -                   checks the validity of the segments
--  correctCutPlanes()               -                   corrects cutplanes according the selected install option
--  correctPickedLines()             -                   corrects picked Lines according the selected install option
--  enhance()                        -                   enhances the element
--  enhance(REAL)                    -                   enhances the element with the for the machine with the given segment index
--  erase()                          -                   erases all traces
--  erase(REAL)                      -                   erases all traces for the machine with the given segment index
--  evaluate()                       -                   evaluates the whole stair set and returns if the evaluation was successful
--  evaluateCutPlaneExtensionOffset(BOOLEAN,REAL,DIRECTION) REAL
--  evaluateGateLngs()               ARRAY               evaluates the gate landings according to the existing gates
--  evaluateLOffset()                -                   evaluates the lower offset
--  evaluateLPickType()              -                   evaluates the lower pick type
--  evaluateLSOP()                   -                   evaluates the position of the LSOP
--  evaluateLength()                 -                   evaluates the length
--  evaluateLngDirection(BOOLEAN,REAL) DIRECTION           evaluates the landing direction
--  evaluateORise()                  -                   evaluates the ORise
--  evaluatePickType(EDGPOSITIONDATA) STRING              evaluates a pick type
--  evaluateSegment(REAL)            -                   evaluates the given segment and return true if the evaluation was successful
--  evaluateSegmentPts()             ARRAY               evaluates the start and end positions of segments
--  evaluateUOffset()                -                   evaluates the upper offset
--  evaluateUPickType()              -                   evaluates the upper pick type
--  evaluateusop()                   -                   evaluates the position of the LSOP
--  getClearance(REAL)               REAL                returns the clearance for the position of the control point for the machine with the given segment index
--  getDirection()                   DIRECTION           returns the direction
--  getDirectionOption()             STRING              returns the direction option
--  getError()                       BOOLEAN             returns the error status
--  getExplicitPosition()            POSITION            returns the position of the LWP or UWP depending on the selected position option
--  getExtensionOption()             STRING              returns the extension option
--  getExtensionOption(REAL)         STRING              returns the extension option for the machine with the given segment index
--  getExtensionOptions()            ARRAY               returns all allowed extension options
--  getFThickness()                  REAL                returns the flight thickness
--  getGates()                       ARRAY               returns an array of gates
--  getGoing(REAL)                   REAL                returns the going for the machine with the given segment index
--  getHandRaTmplReference()         DBREF               returns the reference to the central template for handrails
--  getInstallationOption()          STRING              sets the installation option
--  getInstallationOptions()         ARRAY               returns all allowed installation options
--  getLCutPlane()                   DIRECTION           gets the lower cutplane
--  getLCutPlane(REAL)               DIRECTION           returns the direction of the lower cutplane for the machine with the given segment index
--  getLExtension(REAL)              REAL                returns the lower extension for the machine with the given segment index
--  getLOffset()                     REAL                returns the lower offset
--  getLPickType()                   STRING              returns the lower pick type
--  getLPosData()                    EDGPOSITIONDATA     returns the lower position data
--  getLPositionOption()             STRING              returns the lower position option
--  getLPositionOptions()            ARRAY               returns all allowed position options for the lower working point
--  getLRise(REAL)                   REAL                returns the lrise for the machine with the given segment index
--  getLWP()                         POSITION            returns the position of the LWP
--  getLength()                      REAL                returns the length
--  getLock(STRING)                  BOOLEAN             returns the lock flag value
--  getLock(STRING,REAL)             BOOLEAN             returns the lock flag value for the machine with the given segment index
--  getNumberOfSegments()            REAL                returns the number of segments
--  getOGoing(REAL)                  REAL                returns the overall going for the machine with the given segment index
--  getORise()                       REAL                returns the overall rise
--  getORise(REAL)                   REAL                returns the overall rise for the machine with the given segment index
--  getOptima(REAL)                  ARRAY               returns the optima for the machine with the given segment index
--  getOptimumPitch(REAL)            REAL                returns the optimum pitch for the machine with the given segment index
--  getPitch(REAL)                   REAL                returns the pitch for the machine with the given segment index
--  getRefe()                        DBREF               returns the reference of the stair set
--  getRise(REAL)                    REAL                returns the rise for the machine with the given segment index
--  getSettingReference()            STRING              returns the setting
--  getStrFltTmplReference()         DBREF               returns the reference to the central template for  stair flight
--  getStrLngTmplReference()         DBREF               returns the reference to the central template for landings
--  getTreads(REAL)                  REAL                returns the treads for the machine with the given segment index
--  getUCutPlane()                   DIRECTION           gets the upper cutplane
--  getUCutPlane(REAL)               DIRECTION           returns the direction of the upper cutplane for the machine with the given segment index
--  getUExtension(REAL)              REAL                returns the upper extension for the machine with the given segment index
--  getUOffset()                     REAL                returns the upper offset
--  getUPickType()                   STRING              returns the upper pick type
--  getUPosData()                    EDGPOSITIONDATA     returns the upper position data
--  getUPositionOption()             STRING              returns the upper position option
--  getUPositionOptions()            ARRAY               returns all allowed position options for the upper working point
--  getURise(REAL)                   REAL                returns the urise for the machine with the given segment index
--  getUWP()                         POSITION            returns the position of the UWP
--  getValidTreads(REAL)             ARRAY               returns valid treads for the machine with the given segment index
--  getWidth()                       REAL                returns the width
--  initOffset(STRING)               REAL                evaluates the extension offset in case of uturn for the given location key
--  mergeCriteria()                  -                   merges central standard with fabricator standard
--  newDefaults(DBREF,DBREF,DBREF)   -                   sets the attributes for a new stair set (defaults)
--  remGates(ARRAY)                  -                   removes gates from the gate stack
--  reorderPicks()                   -                   reorder the picks
--  replaceGate(GATE,REAL)           -                   replaces an existing gate by a new one
--  resetError()                     -                   resets error status
--  setControlPoint(STRING,REAL)     -                   sets the keyword for the position of the control point for the machine with the given segment index
--  setCriteria()                    -                   sets the criteria from the current central standard
--  setDirectionOption(DIRECTION)    -
--  setDirectionOption(STRING)       -                   sets the direction option
--  setExplicitPosition(POSITION)    -                   sets the position of the LWP or UWP depending on the selected position option
--  setExtensionOption(STRING,REAL)  -                   sets the extension option for the machine with the given segment index
--  setFThickness(REAL)              -                   sets the flight thickness
--  setGates(ARRAY)                  -                   sets all gates
--  setGoing(REAL,REAL)              -                   sets the going for the machine with the given segment index
--  setInstallationOption(STRING)    -                   sets the installation option
--  setLCutPlane(DIRECTION)          -                   sets the lower cutplane
--  setLCutPlane(DIRECTION,REAL)     -                   sets the lower cutplane for the machine with the given segment index
--  setLExtension(REAL,REAL)         -                   sets the lower extension for the machine with the given segment index
--  setLOffset(REAL)                 -                   sets the lower offset
--  setLPosData(EDGPICKDATA)         -                   sets the lower position data
--  setLPositionOption(STRING)       -                   sets the lower position option
--  setLRise(REAL,REAL)              -                   sets the lrise for the machine with the given segment index
--  setLength(REAL)                  -                   sets the length
--  setLock(STRING,BOOLEAN)          -                   sets the lock flag value
--  setLock(STRING,BOOLEAN,REAL)     -                   sets the lock flag value for the machine with the given segment index
--  setMainData()                    -                   sets the main data
--  setNumberOfSegments()            -                   sets the number of segments
--  setOGoing(REAL,REAL)             -                   sets the overall going for the machine with the given segment index
--  setORise(REAL)                   -                   sets the overall rise
--  setOptimumWidth()                -                   sets the optimum width
--  setPitch(REAL,REAL)              -                   sets the pitch for the machine with the given segment index
--  setRise(REAL,REAL)               -                   sets the rise for the machine with the given segment index
--  setSettingReference()            -                   sets the setting and criteria from the current central standard
--  setTmplReferences(DBREF,DBREF,DBREF) -                   sets the template references
--  setTreads(REAL,REAL)             -                   sets the treads for the machine with the given segment index
--  setUCutPlane(DIRECTION)          -                   sets the upper cutplane
--  setUCutPlane(DIRECTION,REAL)     -                   sets the upper cutplane for the machine with the given segment index
--  setUExtension(REAL,REAL)         -                   sets the upper extension for the machine with the given segment index
--  setUOffset(REAL)                 -                   sets the upper offset
--  setUPosData(EDGPICKDATA)         -                   sets the upper position data
--  setUPositionOption(STRING)       -                   sets the upper position option
--  setURise(REAL,REAL)              -                   sets the urise for the machine with the given segment index
--  setWidth(REAL)                   -                   sets the width
--  setWorkingPoints()               -                   set Working Points depending on the selected option
--  showDimFeedback(REAL)            -                   shows dimension
--  showVolFeedback()                -                   draws the element with aid lines
--  unEnhance()                      -                   unenhances the element
--  unEnhance(REAL)                  -                   unenhances the element with the for the machine with the given segment index
--  updateDB()                       -                   creates/updates a stair flight
--  updateDataObj(DBREF)             -                   reads the stair flight data
--  updateGateLngs()                 -                   updates the gate landing stack
--  updateLLng()                     -                   updates the lower landing
--  updateULng()                     -                   updates the upper landing
--  useOptimum(REAL)                 -                   use the optimum value for the machine with the given segment index
--

define object ASLSTRSETENGINE

  -- public members
  ---------------------------------------------------------------------------
  -- container for the stair set data
  member .strSetData           is ASLSTRSETDATA

  -- container for the stair set dimension flags
  member .strSetDim            is ASLSTRSETDIM



  -- private members
  ---------------------------------------------------------------------------
  -- contains the criteria set for handrail elements (including fabricator standard)
  member .handRaCriteria       is ASLHANDRACRITERIA

  -- contains the criteria set for handrail elements (excluding fabricator standard)
  member .handRaCriteriaBasis  is ASLHANDRACRITERIA

  -- contains the criteria set for stair flight elements (including fabricator standard)
  member .strFltCriteria       is ASLSTRFLTCRITERIA

  -- contains the criteria set for stair flight elements (excluding fabricator standard)
  member .strFltCriteriaBasis  is ASLSTRFLTCRITERIA

  -- contains the criteria set for landing elements (including fabricator standard)
  member .strLngCriteria       is ASLSTRLNGCRITERIA

  -- contains the criteria set for landing elements (excluding fabricator standard)
  member .strLngCriteriaBasis  is ASLSTRLNGCRITERIA

  -- contains a copy of stair set data before modify
  member .strSetDataOld        is ASLSTRSETDATA

endobject
-- End of object definition for aslStrSetEngine

