------------------------------------------------------------------------

define method .getFThickness() is REAL

  return !this.strSetData.fThickness

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getGates
--
-- Description: returns an array of gates
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       an array of gates
------------------------------------------------------------------------

define method .getGates() is ARRAY

  return !this.strSetData.gates

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getGoing
--
-- Description: returns the going for the machine with the given segment index
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
