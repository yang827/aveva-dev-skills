endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setInstallationOption
--
-- Description: sets the installation option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      installation option
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setInstallationOption(!installationOption is STRING)

  !this.strSetData.installationOption = !installationOption

  -- reset
  !this.strSetData.lOffset = 0
  !this.strSetData.uOffset = 0

  -- analyses the install option
  ---------------------------------------------------------------------------
  if ( !this.strSetData.installationOption.eq('Standard installation') ) then
    !this.strSetData.lStrLng      = false
    !this.strSetData.lStrLngAngle = 0
    !this.strSetData.uStrLng      = false
    !this.strSetData.uStrLngAngle = 0
    !this.setLPositionOption('Left align with lower line')

  elseif ( !this.strSetData.installationOption.eq('Parallel to lower line, flight left')  ) then
    !this.strSetData.lStrLng      = true
    !this.strSetData.lStrLngAngle = -90
    !this.strSetData.uStrLng      = false
    !this.strSetData.uStrLngAngle = 0
    !this.setLPositionOption('Right align with lower line')
    !this.setUPositionOption('Left align with upper line')

  elseif ( !this.strSetData.installationOption.eq('Parallel to lower line, flight right') ) then
    !this.strSetData.lStrLng      = true
    !this.strSetData.lStrLngAngle = 90
    !this.strSetData.uStrLng      = false
    !this.strSetData.uStrLngAngle = 0
    !this.setLPositionOption('Left align with lower line')
    !this.setUPositionOption('Right align with upper line')

  elseif ( !this.strSetData.installationOption.eq('Parallel to upper line, exit left') ) then
    !this.strSetData.lStrLng      = false
    !this.strSetData.lStrLngAngle = 0
    !this.strSetData.uStrLng      = true
    !this.strSetData.uStrLngAngle = -90
    !this.setLPositionOption('Left align with lower line')
    !this.setUPositionOption('Right align with upper line')

  elseif ( !this.strSetData.installationOption.eq('Parallel to upper line, exit right') ) then
    !this.strSetData.lStrLng      = false
    !this.strSetData.lStrLngAngle = 0
    !this.strSetData.uStrLng      = true
    !this.strSetData.uStrLngAngle = 90
    !this.setLPositionOption('Right align with lower line')
    !this.setUPositionOption('Left align with upper line')

  elseif ( !this.strSetData.installationOption.eq('Parallel to lines, flight left, exit front') ) then
    !this.strSetData.lStrLng      = true
    !this.strSetData.lStrLngAngle = -90
    !this.strSetData.uStrLng      = true
    !this.strSetData.uStrLngAngle = 90
    !this.setLPositionOption('Right align with lower line')
    !this.setUPositionOption('Left align with upper line')

  elseif ( !this.strSetData.installationOption.eq('Parallel to lines, flight right, exit front') ) then
    !this.strSetData.lStrLng      = true
    !this.strSetData.lStrLngAngle = 90
    !this.strSetData.uStrLng      = true
    !this.strSetData.uStrLngAngle = -90
    !this.setLPositionOption('Left align with lower line')
    !this.setUPositionOption('Right align with upper line')

  elseif ( !this.strSetData.installationOption.eq('Parallel to lines, flight left, exit backwards') ) then
    !this.strSetData.lStrLng      = true
    !this.strSetData.lStrLngAngle = -90
    !this.strSetData.uStrLng      = true
    !this.strSetData.uStrLngAngle = -90
    !this.setLPositionOption('Right align with lower line')
    !this.setUPositionOption('Left align with upper line')

  elseif ( !this.strSetData.installationOption.eq('Parallel to lines, flight right, exit backwards') ) then
    !this.strSetData.lStrLng      = true
    !this.strSetData.lStrLngAngle = 90
    !this.strSetData.uStrLng      = true
    !this.strSetData.uStrLngAngle = 90
    !this.setLPositionOption('Left align with lower line')
    !this.setUPositionOption('Right align with upper line')
  endif

  -- corrects the cutplanes according to the selected install option
  if ( !this.strSetData.direction.set() ) then
    !this.correctCutPlanes()
  endif

endmethod
-- End of method

