------------------------------------------------------------------------
--
-- Method:      setWorkingPoints
--
-- Description: set Working Points depending on the selected option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setWorkingPoints()

  -- Initialise Variables
  !strSetData = !this.strSetData

  -- lower working point
  ---------------------------------------------------------------------------
  -- define the lower/upper position depending on the option selection
  if ( !strSetData.lPositionOption.eq('Left align with lower line') ) then
    !lPosition = !strSetData.lPosData.line.startPosition.wrt(World).offset(!strSetData.lPosData.line.direction(), !strSetData.width / 2)

  elseif ( !strSetData.lPositionOption.eq('Right align with lower line') ) then
    !lPosition = !strSetData.lPosData.line.endPosition.wrt(World).offset(!strSetData.lPosData.line.direction().opposite(), !strSetData.width / 2)

  elseif ( !strSetData.lPositionOption.eq('Centre align with lower line') ) then
    !lPosition = !strSetData.lPosData.line.proportion(0.5)

  elseif ( !strSetData.lPositionOption.eq('Derived lower position') ) then
    !lPosition = !strSetData.lPosData.position.wrt(World)

  elseif ( !strSetData.lPositionOption.eq('Explicit lower position...') ) then
    !lPosition = !strSetData.lPosData.position.wrt(world)
  endif

  -- upper working point
  ---------------------------------------------------------------------------
  -- define the lower/upper position depending on the option selection
  if ( !strSetData.uPositionOption.eq('Right align with upper line') ) then
    !uPosition = !strSetData.uPosData.line.endPosition.wrt(World).offset(!strSetData.uPosData.line.direction().opposite(), !strSetData.width / 2)

  elseif ( !strSetData.uPositionOption.eq('Left align with upper line') ) then
    !uPosition = !strSetData.uPosData.line.startPosition.wrt(World).offset(!strSetData.uPosData.line.direction(), !strSetData.width / 2)

  elseif ( !strSetData.uPositionOption.eq('Centre align with upper line') ) then
    !uPosition = !strSetData.uPosData.line.proportion(0.5)

  elseif ( !strSetData.uPositionOption.eq('Derived upper position') ) then
    !uPosition = !strSetData.uPosData.position.wrt(World)

  elseif ( !strSetData.uPositionOption.eq('Explicit upper position...' ) ) then
    !uPosition = !strSetData.uPosData.position.wrt(world)
  endif


  -- define the second position depending on the first point and the direction selection
  if ( !strSetData.directionOption.matchwild('Orthogonal to lines*') ) then
    !direction = !strSetData.lPosData.line.direction().orthogonal(U)

  elseif ( !strSetData.directionOption.matchwild('Orthogonal to lower line*') ) then
    !direction = !strSetData.lPosData.line.direction().orthogonal(U)

  elseif ( !strSetData.directionOption.matchwild('Orthogonal to upper line*') ) then
    !direction = !strSetData.uPosData.line.direction().orthogonal(U)

  elseif ( !strSetData.directionOption.matchwild('Parallel to lines*') ) then
    !direction = !strSetData.lPosData.line.direction()

  elseif ( !strSetData.directionOption.matchwild('Parallel to lower line*') ) then
    !direction = !strSetData.lPosData.line.direction()

  elseif ( !strSetData.directionOption.matchwild('Parallel to upper line*') ) then
    !direction = !strSetData.uPosData.line.direction()

  elseif ( !strSetData.directionOption.eq('Derived direction') ) then
    !direction = !strSetData.lPosData.position.direction(!strSetData.uPosData.position).projected(object PLANE(E0, Z IS U))

  elseif ( !strSetData.directionOption.eq('Explicit direction...') ) then
    !direction = !strSetData.direction

  elseif ( !strSetData.directionOption inset ('North', 'South', 'East', 'West','X','-X','Y','-Y') ) then
    !direction = object DIRECTION(!strSetData.directionOption)
  endif

  if ( !direction.angle(!strSetData.lPosData.position.direction(!strSetData.uPosData.position)).gt(90) ) then
    !direction = !direction.opposite()
  endif

  -- after picking use the picked data
  ---------------------------------------------------------------------------
  if ( !strSetData.uPositionOption.eq('') ) then
    !orientation = object ORIENTATION('Z is ' & !direction.orthogonal(U))
    !plane       = object PLANE(!strSetData.lPosData.position, !orientation)

    -- if the second pick is a line, take the intersection
    if ( !strSetData.uPosData.line.set() ) then
      !uPosition = !plane.intersection(!strSetData.uPosData.line)

    -- if the second pick is a position, project the position on the line resulting from the lower position and the direction
    -- and then project that position on the up plane
    else
      !uPlane    = object PLANE(!strSetData.uPosData.position, Z is U)
      !lLine     = object LINE(!lPosition, !lPosition.offset(!direction, 100))
      !uPosition = !uPlane.near(!lLine.near(!strSetData.uPosData.position))
    endif

  elseif ( !strSetData.lPositionOption.eq('') ) then
  	!orientation = object ORIENTATION('Z is ' & !direction.orthogonal(U))
    !plane     = object PLANE(!strSetData.uPosData.position, !orientation )

    -- if the second pick is a line, take the intersection
    if ( !strSetData.lPosData.line.set() ) then
      !lPosition = !plane.intersection(!strSetData.lPosData.line)

    -- if the second pick is a position, project the position on the line resulting from the lower position and the direction
    -- and then project that position on the up plane
    else
      !lPlane    = object PLANE(!strSetData.lPosData.position, Z is U)
      !uLine     = object LINE(!uPosition, !uPosition.offset(!direction, 100))
      !lPosition = !lPlane.near(!uLine.near(!strSetData.lPosData.position))
    endif
  endif

  -- Initialise Variables
  !strSetData.lwp = !lPosition
  !strSetData.uwp = !uPosition

  -- Lower reference plane
  ---------------------------------------------------------------------------
  !lPlane    = object PLANE(!lPosition, Z is U)
  !direction = !direction.projected(!lPlane)

  -- set the cutplanes depending on the picked elements
  if ( !strSetData.lPosData.line.unset() ) then
    !strSetData.lCutPlane = !direction
  endif
  if ( !strSetData.uCutPlane.unset() ) then
    !strSetData.uCutPlane = !direction
  endif

  !strSetData.direction = !direction


  -- update the central object
  !this.strSetData = !strSetData

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showDimFeedback
--
-- Description: shows dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimFeedback(!segmentIdx is REAL)

  -- first remove all dimension
  !!aslCentralData.clearDimFeedback()

  -- get information about the stairflight and strSet
  !strSetData     = !this.strSetData
  !strSetDim      = !this.strSetDim
  !strFltData     = !this.strSetData.segmentEngines[!segmentIdx].segmentData.strFltEngines.first().strFltData
  !lastStrFltData = !this.strSetData.segmentEngines[!segmentIdx].segmentData.strFltEngines.last().strFltData
  !aidDim         = !!aslCentralData.aidDim
  !sDirection     = !strFltData.direction

  -- get direction of the stairflight
  !centreLine     = object LINE(!strFltData.lsop, !strFltData.usop)
  !orthoDir       = !centreLine.direction().orthogonal(U)

  if ( !strSetDim.clearance ) then
    !label    = 'Clearance = ' & !strFltData.clearance
    !fPos     = !strFltData.usop.offset(UP, !strFltData.clearance)
    !dimObj   = object DISPLAYDIMENSION(!label, !sDirection, !strFltData.usop, !fPos, 1200mm, !aidDim)
  endif

  if ( !strSetDim.fThickness ) then
    !label      = 'Flight thickness = ' & !strFltData.fThickness

    !dimPos1    = !centreLine.proportion(0.7)
    !dimDir     = !centreLine.direction().orthogonal(!orthoDir)
    !dimPos2    = !dimPos1.offset(!dimDir, !strFltData.fThickness)
    !dimObj     = object DISPLAYDIMENSION(!label, !orthoDir, !dimPos1, !dimPos2, 800mm, !aidDim)
  endif

  if ( !strSetDim.going ) then
    !label     = 'Going = ' & !strFltData.going
    !tempPos   = !strFltData.lsop.offset(UP, !strFltData.lRise)
    !fPosTread = !tempPos.offset(!sDirection, !strFltData.going)
    !tempPos   = !fPosTread.offset(!sDirection, !strFltData.going)
    !sPosTread = !tempPos.offset(UP, !strFltData.rise)
    !dimObj    = object DISPLAYDIMENSION(!label, UP, !fPosTread, !sPosTread, 400mm, !aidDim)
  endif

  if ( !strSetDim.length ) then
    !label    = 'Overall Length = ' & !strSetData.length
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !strSetData.lwp, !strSetData.uwp, 1200mm, !aidDim)
  endif

  if ( !strSetDim.lExtension ) then
    !label    = 'Lower Extension = ' & !strFltData.lExtension
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !strFltData.lwp, !strFltData.lsop, 1200mm, !aidDim)
  endif

  if ( !strSetDim.lRise ) then
    !label     = 'Bottom Rise = ' & !strFltData.lRise
    !fPosTread = !strFltData.lsop.offset(!sDirection, !strFltData.going)
    !tempPos   = !fPosTread.offset(!sDirection, !strFltData.going)
    !sPosTread = !tempPos.offset(UP, !strFltData.lRise)
    !dimObj    = object DISPLAYDIMENSION(!label, !sDirection, !fPosTread, !sPosTread, 400mm, !aidDim)
  endif

  if ( !strSetDim.oGoing ) then
    !label    = 'Overall Going = ' & !strFltData.oGoing
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !strFltData.lsop, !strFltData.usop, 800mm, !aidDim)
  endif

  if ( !strSetDim.oRise ) then
    !label    = 'Overall Rise = ' & !strSetData.oRise
    !dimObj   = object DISPLAYDIMENSION(!label, !sDirection, !strSetData.lwp, !strSetData.uwp, 1200mm, !aidDim)
  endif

  if ( !strSetDim.pitch ) then
    !label    = 'Angle = ' & !strFltData.pitch & 'deg'

    -- angle is defined by three positions - get the missing one
    !horiPos  = !strFltData.lsop.offset(!sDirection, !strFltData.length)
    !radius   = !strFltData.length / 3
    !dimObj   = object DISPLAYDIMENSION(!label, !strFltData.lsop, !horiPos, !strFltData.usop, !radius, !aidDim)
  endif

  if ( !strSetDim.rise ) then
    !label     = 'Rise = ' & !strFltData.rise
    !tempPos   = !strFltData.lsop.offset(UP, !strFltData.lRise)
    !fPosTread = !tempPos.offset(!sDirection, 2 * !strFltData.going)
    !tempPos   = !fPosTread.offset(!sDirection, !strFltData.going)
    !sPosTread = !tempPos.offset(UP, !strFltData.rise)
    !dimObj    = object DISPLAYDIMENSION(!label, !sDirection, !fPosTread, !sPosTread, 400mm, !aidDim)
  endif

  if ( !strSetDim.uRise ) then
    !label     = 'Top Rise = ' & !lastStrFltData.uRise
    !tempPos   = !lastStrFltData.usop.offset(Down, !lastStrFltData.uRise)
    !fPosTread = !tempPos.offset(!sDirection.opposite(), !lastStrFltData.going)
    !dimObj    = object DISPLAYDIMENSION(!label, !sDirection.opposite(), !fPosTread, !lastStrFltData.usop, 400mm, !aidDim)
  endif

  if ( !strSetDim.uExtension ) then
    !label    = 'Upper Extension = ' & !strFltData.uExtension
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !strFltData.usop, !strFltData.uwp, 800mm, !aidDim)
  endif

  if ( !strSetDim.width ) then
    !label      = 'Width = ' & !strFltData.width

    !halfPos    = !centreLine.proportion(0.5)
    !halfWidth  = !strFltData.width / 2

    -- define the border positions
    !fPosition  = !halfPos.offset(!orthoDir, !halfWidth)
    !sPosition  = !halfPos.offset(!orthoDir.opposite(), !halfWidth)
    !dimObj     = object DISPLAYDIMENSION(!label, UP, !fPosition, !sPosition, 800mm, !aidDim)
  endif

endmethod
-- End of method

