-- Method:      setUPositionOption
--
-- Description: sets the upper position option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      upper position option
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setUPositionOption(!uPositionOption is STRING)

  !this.strSetData.uPositionOption = !uPositionOption

  -- analyses the position option
  ---------------------------------------------------------------------------
  -- evaluates the mid point of the upper line
  if ( !this.strSetData.uPositionOption.eq('Centre align with upper line') ) then
    !line                = !this.strSetData.uPosData.line
    !this.strSetData.uwp = !line.proportion(0.5)

  -- uses the upper pick position
  elseif ( !this.strSetData.uPositionOption.eq('Derived upper position') ) then
    !this.strSetData.uwp = !this.strSetData.uPosData.position

  -- uses user input for the upper position
  elseif ( !this.strSetData.uPositionOption.eq('Explicit upper position...') ) then

  -- uses the start point of the upper line
  elseif ( !this.strSetData.uPositionOption.eq('Left align with upper line') ) then
    !line                = !this.strSetData.uPosData.line
    !this.strSetData.uwp = !line.startPosition

  -- uses the end point of the upper line
  elseif ( !this.strSetData.uPositionOption.eq('Right align with upper line') ) then
    !line                = !this.strSetData.uPosData.line
    !this.strSetData.uwp = !line.endPosition
  endif

  if ( !this.strSetData.installationOption.eq('Standard installation') ) then
    !this.strSetData.lPositionOption = ''
  endif

endmethod
