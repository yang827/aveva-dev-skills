------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description: sets the direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   direction
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setDirectionOption(!direction is DIRECTION)

  !this.strSetData.direction = !direction

  -- analyses the direction option
  ---------------------------------------------------------------------------
  -- evaluates the derived direction
  !startPoint       = !this.strSetData.lPosData.position
  !endPoint         = !this.strSetData.uPosData.position
  !line             = object LINE(!startPoint, !endPoint)
  !derivedDirection = !line.direction()


  -- evaluates the direction for the pick position data
  if ( !this.strSetData.directionOption.eq('Derived direction') ) then
    !this.strSetData.direction = !derivedDirection

  -- direction E
  elseif ( !this.strSetData.directionOption inset ('East','X') ) then
    !this.strSetData.direction = E

  -- direction N
  elseif ( !this.strSetData.directionOption inset ('North','Y') ) then
    !this.strSetData.direction = N

  -- evaluates the direction orthogonal from any line
  elseif ( !this.strSetData.directionOption.eq('Orthogonal to lines') ) then
    !line                      = !this.strSetData.lPosData.line
    !this.strSetData.direction = !line.direction().orthogonal(U)

  -- evaluates the direction orthogonal from the lower line
  elseif ( !this.strSetData.directionOption.eq('Orthogonal to lower line') ) then
    !line                      = !this.strSetData.lPosData.line
    !this.strSetData.direction = !line.direction().orthogonal(U)

  -- evaluates the direction orthogonal from the upper line
  elseif ( !this.strSetData.directionOption.eq('Orthogonal to upper line') ) then
    !line                      = !this.strSetData.uPosData.line
    !this.strSetData.direction = !line.direction().orthogonal(U)

  -- evaluates the direction from any line
  elseif ( !this.strSetData.directionOption.eq('Parallel to lines') ) then
    !line                      = !this.strSetData.lPosData.line
    !this.strSetData.direction = !line.direction()

  -- evaluates the direction from the lower line
  elseif ( !this.strSetData.directionOption.eq('Parallel to lower line') ) then
    !line                      = !this.strSetData.lPosData.line
    !this.strSetData.direction = !line.direction()


  elseif ( !this.strSetData.directionOption.eq('Parallel to lower line, orthogonal to upper line') ) then
    !line                      = !this.strSetData.lPosData.line
    !this.strSetData.direction = !line.direction()

  -- evaluates the direction from the upper line
  elseif ( !this.strSetData.directionOption.eq('Parallel to upper line') ) then
    !line                      = !this.strSetData.uPosData.line
    !this.strSetData.direction = !line.direction()

  elseif ( !this.strSetData.directionOption.eq('Parallel to upper line, orthogonal to lower line') ) then
    !line                      = !this.strSetData.uPosData.line
    !this.strSetData.direction = !line.direction()

  -- direction S
  elseif ( !this.strSetData.directionOption inset ('South','-Y') ) then
    !this.strSetData.direction = S

  -- direction W
  elseif ( !this.strSetData.directionOption inset ('West','-X') ) then
    !this.strSetData.direction = W
  endif

  -- corrects the stair flight direction
  if ( not !this.strSetData.directionOption inset ('East', 'North', 'South', 'West','X','-X','Y','-Y') and $
       !this.strSetData.direction.angle(!derivedDirection).gt(90) ) then
    !this.strSetData.direction = !this.strSetData.direction.opposite()
  endif

endmethod
-- End of method

