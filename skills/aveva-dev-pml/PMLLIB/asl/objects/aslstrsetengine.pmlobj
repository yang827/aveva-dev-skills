------------------------------------------------------------------------
--
-- Method:      setLExtension
--
-- Description: sets the lower extension for the machine with the given segment index
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        lower extension
--    2   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLExtension(!lExtension is REAL, !segmentIdx is REAL)

  !this.strSetData.setLExtension(!lExtension, !segmentIdx)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLOffset
--
-- Description: sets the lower offset
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        lower offset
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLOffset(!offset is REAL)

  -- allows only positive values
  if ( !offset.leq(0) ) then
    !validOffset =  !this.strSetData.width / 2
  else
    !validOffset = !offset + !this.strSetData.width / 2
  endif

  -- flight left or right exit backwards
  if ( !this.strSetData.installationOption.matchwild('Parallel to lines, flight *, exit backwards') ) then
    -- evaluates the delta between the old and the new offset
    !deltaOffset = !validOffset - !this.strSetData.lOffset

    -- evaluates the new value for the upper offset temporary
    !uOffset     = !this.strSetData.uOffset + !deltaOffset

    -- checks the validity of the required offset
    if ( !uOffset.geq(!this.strSetData.width / 2) ) then
      !this.strSetData.lOffset = !validOffset
      !this.strSetData.uOffset = !uOffset
    else
      !this.strSetData.lOffset = !validOffset - !uOffset + !this.strSetData.width / 2
      !this.strSetData.uOffset = !this.strSetData.width / 2
    endif

  -- flight left or right exit front
  elseif ( !this.strSetData.installationOption.matchwild('Parallel to lines, flight *, exit front') ) then

    -- evaluates the available distance for offsets
    !availableDistance = !this.strSetData.lOffset + !this.strSetData.uOffset

    -- checks the validity of the required offset
    if ( !availableDistance.gt(!validOffset) ) then
      !this.strSetData.lOffset = !validOffset
      !this.strSetData.uOffset = !availableDistance - !validOffset

    else
      !this.strSetData.lOffset = !availableDistance - !this.strSetData.width

      !this.strSetData.uOffset = !this.strSetData.width / 2
    endif
  endif

  !this.evaluateLSOP()
  !this.evaluateusop()

  !this.checkSegments()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setLength
--
-- Description: sets the length
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        length
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setLength(!length is REAL)

  !this.strSetData.length = !length

  -- control point at the lower position
  if ( !this.strSetData.lStrLng.not() and $
       !this.strSetData.uStrLng.not() or  $
       !this.strSetData.lStrLng) then
    !position            = !this.strSetData.lwp.offset(U, !this.strSetData.oRise)
    !this.strSetData.uwp = !position.offset(!this.strSetData.direction, !this.strSetData.length)

  -- control point at the upper position
  else
    !position            = !this.strSetData.uwp.offset(D, !this.strSetData.oRise)
    !this.strSetData.uwp = !position.offset(!this.strSetData.direction.opposite(), !this.strSetData.length)
  endif

endmethod
-- End of method

