------------------------------------------------------------------------
--
-- Method:      getExplicitPosition
--
-- Description: returns the position of the LWP or UWP depending on the selected position option
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    position of the LWP or UWP
------------------------------------------------------------------------

define method .getExplicitPosition()is POSITION

  if ( !this.strSetData.positionOption.matchwild('* lower *') ) then
    return !this.strSetData.lwp
  else
    return !this.strSetData.uwp
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getExtensionOption
--
-- Description: returns the extension option
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      extension option
------------------------------------------------------------------------

define method .getExtensionOption() is STRING

  return !this.strSetData.extensionOption

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getExtensionOption
--
-- Description: returns the extension option for the machine with the given segment index
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        segment index
-- Return:
--   [Data Type] [Description]
--    STRING      extension option
------------------------------------------------------------------------

define method .getExtensionOption(!segmentIdx is REAL) is STRING

  return !this.strSetData.getExtensionOption(!segmentIdx)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getExtensionOptions
--
-- Description: returns all allowed extension options
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       description of options
------------------------------------------------------------------------

define method .getExtensionOptions() is ARRAY

  -- inits
  !extensionLabels  = object ARRAY()
  !extensionPixmaps = object ARRAY()

  -- evaluates the pick position data
  !lPosData = !this.strSetData.lPosData
  !uPosData = !this.strSetData.uPosData

  if ( !lPosData.line.set() and $
       !uPosData.line.set() ) then
    !extensionLabels.append('Upper extension = minimum')
    !extensionPixmaps.append(!!pml.getPathName('aslextensionsituation01-16.png'))
    !extensionLabels.append('Lower extension = minimum')
    !extensionPixmaps.append(!!pml.getPathName('aslextensionsituation02-16.png'))
    !extensionLabels.append('Upper extension = Lower extension')
    !extensionPixmaps.append(!!pml.getPathName('aslextensionsituation03-16.png'))
    !extensionLabels.append('User defined')
    !extensionPixmaps.append(!!pml.getPathName('aslextensionsituation04-16.png'))

  elseif ( !lPosData.line.set() and $
           !uPosData.line.unset() ) then
    !extensionLabels.append('Lower extension = minimum')
    !extensionPixmaps.append(!!pml.getPathName('aslextensionsituation01-16.png'))
    !extensionLabels.append('User defined')
    !extensionPixmaps.append(!!pml.getPathName('aslextensionsituation04-16.png'))

  elseif ( !lPosData.line.unset() and $
           !uPosData.line.set() ) then
    !extensionLabels.append('Upper extension = minimum')
    !extensionPixmaps.append(!!pml.getPathName('aslextensionsituation02-16.png'))
    !extensionLabels.append('User defined')
    !extensionPixmaps.append(!!pml.getPathName('aslextensionsituation04-16.png'))
  endif

  !extensionOptions = object ARRAY()
  !extensionOptions.append(!extensionLabels)
  !extensionOptions.append(!extensionPixmaps)

  return !extensionOptions

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getFThickness
--
-- Description: returns the flight thickness
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
