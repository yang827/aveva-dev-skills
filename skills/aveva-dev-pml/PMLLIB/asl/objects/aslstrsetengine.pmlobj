------------------------------------------------------------------------

define method .getGoing(!segmentIdx is REAL) is REAL

  return !this.strSetData.getGoing(!segmentIdx)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getHandRaTmplReference
--
-- Description: returns the reference to the central template for handrails
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       reference to the central template for handrails
------------------------------------------------------------------------

define method .getHandRaTmplReference() is DBREF

  return !this.strSetData.handRaTmplReference

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getInstallationOption
--
-- Description: sets the installation option
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      installation option
------------------------------------------------------------------------

define method .getInstallationOption() is STRING

  return !this.strSetData.installationOption

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getInstallationOptions
--
-- Description: returns all allowed installation options
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       description and pixmap of option
------------------------------------------------------------------------

define method .getInstallationOptions() is ARRAY

  -- inits
  !installationLabels  = object ARRAY()
  !installationPixmaps = object ARRAY()

  -- evaluates the pick position data
  !lPosData = !this.strSetData.lPosData
  !uPosData = !this.strSetData.uPosData

  -- some derived data
  !derivedHeight = !uPosData.position.up - !lPosData.position.up
  !plane         = object PLANE(!lPosData.position, Z IS U)

  if ( !lPosData.line.set() and $
       !uPosData.line.set() ) then
    !upperOnLower          = !plane.near(!uPosData.position)

    -- distance between the lines
    !linePlane             = !lPosData.line.plane()
    !derivedDistance       = !lPosData.position.distance(!linePlane.near(!upperOnLower))
    !derivedDirection      = !lPosData.position.direction(!linePlane.near(!upperOnLower))

    -- offset between the two pick points on the lower plane
    !lineOrthoOrientation  = object ORIENTATION('Z IS ' & !lPosData.line.direction().orthogonal(U))
    !orthoPlane            = object PLANE(!lPosData.position, !lineOrthoOrientation)
    !derivedOffset         = !lPosData.position.distance(!orthoPlane.near(!upperOnLower))

    -- offset direction
    if ( !derivedOffset.gt(0) ) then
      !offsetDir           = !lPosData.position.direction(!orthoPlane.near(!upperOnLower))
    endif

    -- clearance
    !projectedLine         = !uPosData.line.projected(!plane)
    !projectedLine         = !projectedLine.projected(!orthoPlane)

    if ( !projectedLine.length().gt(0) and $
         !projectedLine.direction() inset (!lPosData.line.direction(), !lPosData.line.direction().opposite()) and $
         !projectedLine.overLap(!lPosData.line).set() ) then
      !clearance = 0
    else
      !start1    = !projectedLine.startPosition
      !start2    = !lPosData.line.startPosition
      !end1      = !projectedLine.endPosition
      !end2      = !lPosData.line.endPosition
      !clearance = !start1.distance(!start2).min(!start1.distance(!end2)).min(!end1.distance(!start2)).min(!end1.distance(!end2))
    endif
  else
    !derivedDistance  = !lPosData.position.distance(!plane.near(!uPosData.position))
  endif

  !derivedAngleVert = ATAN(!derivedHeight / !derivedDistance)
  handle ANY
    !derivedAngleVert = 90
  endhandle

  -- two lines
  ---------------------------------------------------------------------------
  if ( !lPosData.line.set() and $
       !uPosData.line.set() ) then
    !derivedAngleHori = !lPosData.line.direction().angle(!uPosData.line.direction())

    -- Parallel lines (up to 70 degrees)
    if( !derivedAngleHori.between(70, 110).not() ) then
      if ( !derivedAngleVert.lt(60) and $
           !derivedOffset / !derivedDistance lt 1) then
        !installationLabels.append('Standard installation')
        !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation01-16.png'))
      endif

      if ( !derivedOffset.geq(2000)   and $
           !derivedDistance.geq(800)  and $
           !derivedOffset / !derivedDistance gt 1 ) then
        !crossDir = !offsetDir.orthogonal(!derivedDirection)
        if ( !crossDir.angle(U).lt(5) ) then
          !installationLabels.append('Parallel to lines, flight right, exit front')
          !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation02-16.png'))
        elseif ( !crossDir.angle(D).lt(5) ) then
          !installationLabels.append('Parallel to lines, flight left, exit front')
          !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation03-16.png'))
        endif
      endif

      if ( !derivedDistance.eq(0) or $
           !derivedOffset / !derivedDistance gt 1 ) then
        !installationLabels.append('Parallel to lines, flight right, exit backwards')
        !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation04-16.png'))
        !installationLabels.append('Parallel to lines, flight left, exit backwards')
        !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation05-16.png'))
      endif
    endif

    -- orthogonal lines (down to 20 degrees)
    if( !derivedAngleHori.between(20, 170) ) then
      -- intersection point
      !lPlane       = object PLANE(!lPosData.position, Z IS U)
      !uPosOnLPlane = !lPlane.near(!uPosData.position)
      !intersection = !lPosData.line.intersection(!uPosData.line)
      !crossLine1   = object LINE(!intersection, !lPosData.position)
      !crossLine2   = object LINE(!intersection, !uPosOnLPlane)
      !crossDir     = !crossLine1.direction().cross(!crossLine2.direction())

      if ( !crossDir.eq(U) ) then
        !installationLabels.append('Parallel to upper line, exit left')
        !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation06-16.png'))
        !installationLabels.append('Parallel to lower line, flight left')
        !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation08-16.png'))
      else
        !installationLabels.append('Parallel to upper line, exit right')
        !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation07-16.png'))
        !installationLabels.append('Parallel to lower line, flight right')
        !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation09-16.png'))
      endif
    endif

  -- one line and one point
  elseif ( !lPosData.line.set()   and $
           !uPosData.line.unset() or  $
           !lPosData.line.unset() and $
           !uPosData.line.set() ) then

    -- is the left or the right end of the line nearer to the pick?
    if ( !lPosData.line.set() ) then
      !installationLabels.append('Standard installation')
      !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation11-16.png'))
      !installationLabels.append('Parallel to lower line, flight left')
      !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation13-16.png'))
      !installationLabels.append('Parallel to lower line, flight right')
      !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation14-16.png'))

    -- upper line is set
    else
      !installationLabels.append('Standard installation')
      !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation10-16.png'))
      !installationLabels.append('Parallel to upper line, exit left')
      !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation15-16.png'))
      !installationLabels.append('Parallel to upper line, exit right')
      !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation16-16.png'))
    endif

  -- two points
  elseif ( !lPosData.set() ) then
    !installationLabels.append('Standard installation')
    !installationPixmaps.append(!!pml.getPathName('aslinstallationsituation12-16.png'))
  endif

  !installationOptions = object ARRAY()
  !installationOptions.append(!installationLabels)
  !installationOptions.append(!installationPixmaps)

  return !installationOptions

endmethod
-- End of method

