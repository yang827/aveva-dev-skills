--
--
-- Description:     container for STRTWR criteria data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrTwrCriteria()              -                   default constructor
--  checkValue(REAL,STRING)          -                   check value against criterion
--  complete()                       -                   completes all missing values
--

-- Define object
define object ASLSTRTWRCRITERIA

  -- stores the description of the object
  member .desc         is STRING

  -- cl spacing x
  member .clXSpacing   is CRITERION

  -- cl spacing y
  member .clYSpacing   is CRITERION

  -- height
  member .height       is CRITERION

  -- length
  member .length       is CRITERION

  -- width
  member .width        is CRITERION

  -- Landing Interval
  member .landingLevel is CRITERION

endobject
-- End of object definition for aslStrTwrCriteria

------------------------------------------------------------------------
--
-- Method:      aslStrTwrCriteria
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrTwrCriteria()

  !this.desc                     = 'Stair Tower'
  !this.clXSpacing.description   = 'Centre line spacing width'
  !this.clYSpacing.description   = 'Centre line spacing length'
  !this.height.description       = 'Height'
  !this.length.description       = 'Length'
  !this.width.description        = 'Width'
  !this.landingLevel.description = 'Default TOS Elevation'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      complete
--
-- Description: completes all missing values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .complete()

  --!this.flightEdgGap.complete(1mm, 10000mm)
  !this.height.complete(5000mm, 50000mm)
  !this.length.complete(5000mm, 50000mm)
  !this.width.complete(5000mm, 50000mm)
  !this.clXSpacing.complete(4000mm, 50000mm)
  !this.clYSpacing.complete(4000mm, 50000mm)
  !this.landingLevel.complete(2500mm,50000mm)
  --!this.minimumGap.complete(600mm,  1000mm)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      checkValue
--
-- Description: check value against criterion
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Value to be checked
--    2   R      STRING      Criterion name
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .checkValue(!value is REAL,!criterionName is STRING)

  -- get appropriate CRITERION and check the value
  !criterion = !this.attribute(!criterionName.upcase())
  !criterion.checkValue(!value)

endmethod
-- end of method
