-- End of method

------------------------------------------------------------------------
--
-- Method:      sortBeamLevel
--
-- Description: sorts the beam Level by the up position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .sortBeamLevel()

  -- initialise
  !beamLevelTower = object ARRAY()

  -- evaluates the up positions
  do !beamLevelStrTwr value !this.beamLevelStrTwr
    !beamLevelTower.append(!beamLevelStrTwr)
  enddo

  -- sort
  !sortedIndices = !beamLevelTower.sortedIndices()
  !this.beamLevelStrTwr.reIndex(!sortedIndices)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sortFflLevel
--
-- Description: sorts the FFL Level by the up position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .sortFflLevel()

  -- initialise
  !fflLevelTower = object ARRAY()

  -- evaluates the up positions
  do !fflLevelStrTwr value !this.fflLevelStrTwr
    !fflLevelTower.append(!fflLevelStrTwr)
  enddo

  -- sort
  !sortedIndices = !fflLevelTower.sortedIndices()
  !this.fflLevelStrTwr.reIndex(!sortedIndices)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sortDeckLevel
--
-- Description: sorts the beam Level by the up position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .sortDeckLevel()

  -- initialise
  !deckLevel = object ARRAY()

  -- evaluates the up positions
  do !deckLevelStrWay value !this.deckLevelStrWay
    !deckLevel.append(!deckLevelStrWay)
  enddo

  -- sort
  !sortedIndices = !deckLevel.sortedIndices()
  !this.deckLevelStrWay.reIndex(!sortedIndices)

  --make the array unique
  !this.deckLevelStrWay.unique()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sortDeckProfile
--
-- Description: sorts the Deck profile by the up position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .sortDeckProfile()

  -- initialise
  !elev = object ARRAY()

  -- evaluates the up positions
  do !profElev value !this.deckProfile
    !elev.append(!profElev.position.up)
  enddo

  --make the elevation unique
  !elev.unique()
  !this.deckLevelStrWay = !elev

  --sort the deck Level
  !this.sortDeckLevel()

  -- sort
  !sortedIndices = !elev.sortedIndices()
  !this.deckProfile.reIndex(!sortedIndices)

  --make the array unique
  !this.deckProfile.unique()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      replaceBeamLevel
--
-- Description: replaces an existing beam level by a new one
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Beam level
--    2   R       REAL        index
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .replaceBeamLevel(!editBmLevel is REAL, !index is REAL)

  !this.beamLevelStrTwr[!index] = !editBmLevel
  -- Sort the beam level
  !this.sortBeamLevel()

endmethod
-- End of method

