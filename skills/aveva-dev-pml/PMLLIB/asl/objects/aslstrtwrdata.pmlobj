------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: initialise the object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .init()

  !this.undoable           = false
