  -- set the initial beam level for the stair tower
  !this.beamLevelStrTwr = object ARRAY()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      remBeamLevel
--
-- Description: removes a beam from the stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       gates
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .remBeamLevel(!beamIndices is ARRAY)

  --loop through and update the beam Level stair tower member
  do !i from 1 to !beamIndices.size()
    !indices = (!beamIndices[!i][1].real())
    !this.beamLevelStrTwr[!indices].delete()
  enddo

  --compress the result
  !this.beamLevelStrTwr.compress()

  -- sort the beam Level stair tower member array
  !this.sortBeamLevel()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      remDeckLevel
--
-- Description: removes a Deck from the stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       gates
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .remDeckLevel(!deckIndices is ARRAY)

  --loop through and update the beam Level Stair Tower member
  do !i from 1 to !deckIndices.size()
    !indices = (!deckIndices[!i][1].real())
    !this.deckLevelStrWay[!indices].delete()
  enddo

  --compress the result
  !this.deckLevelStrWay.compress()

  -- sort the Deck Level of the stair way
  !this.sortDeckLevel()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      remDeckProfile
--
-- Description: removes a Deck from the stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       gates
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .remDeckProfile(!deckIndices is ARRAY)

  --loop through and update the beam LevelStrTwr member
  do !i from 1 to !deckIndices.size()
    !indices = (!deckIndices[!i][1].real())
    !this.deckProfile[!indices].delete()

    --compress the result
    !this.deckProfile.compress()

    --sort the deck Profile of the stair way
    !this.sortDeckProfile()

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      remFflLevel
--
-- Description: removes a landing from the stack
--
-- Method Type: Procedure
