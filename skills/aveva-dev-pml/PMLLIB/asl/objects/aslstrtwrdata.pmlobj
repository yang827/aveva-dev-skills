------------------------------------------------------------------------

define method .remFflLevel(!fflIndices is ARRAY)

  --loop through and update the beamLevelStrTwr member
  do !i from 1 to !fflIndices.size()
    !indices = (!fflIndices[!i][1].real())
    !this.fflLevelStrTwr[!indices].delete()
  enddo

  --compress the result
  !this.fflLevelStrTwr.compress()

