------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: reads the values from the STRTWR
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       Stair tower
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  -- Setting the Init for Stair Tower
  !this.refe                   = !refe
  !this.settingReference       = !refe.strStd
  !this.prmDirection           = !refe.prmDirection.wrt(worl)
  !this.orientation            = object ORIENTATION('Z is U and Y is $!this.prmDirection')

  -- Setting the General attributes
  if ( !this.refe.opWidth.neq(0) ) then
    !this.xLength                = !refe.opLength
  endif
  if ( !this.refe.opLength.neq(0) ) then
    !this.yLength                = !refe.opWidth
  endif
  if ( !this.refe.opheight.neq(0) ) then
    !this.zLength                = !refe.opheight
  endif

  -- Setting the centreline attribute for Stair tower Detailed attributes
  if ( !this.refe.colXSpacing.set() ) then
    !this.clXSpacing             = !refe.colXSpacing.first()
  endif
  if ( !this.refe.colYSpacing.set() ) then
    !this.clYSpacing             = !refe.colYSpacing.first()
  endif

  -- setting the centreline attribute for stair flight
  if ( !this.refe.fClXSpacing.set() ) then
    !this.fltClXSpacing          = !refe.fClXSpacing.first()
  endif
  if ( !this.refe.fClYSpacing.set() ) then
    !this.fltClYSpacing          = !refe.fClYSpacing.first()
  endif

  -- setting the installation option
  if ( !this.refe.intsen.set() ) then
    !this.clockwise              = !refe.intsen
  endif
  if ( !this.refe.instOpt.set() ) then
    !this.installationOption     = !refe.instOpt
  endif

  --beam level
  if ( !this.refe.bmLevels.set() ) then
    !this.beamLevelStrTwr        = !refe.bmLevels
  else
    if ( !this.refe.lndLevels.set() ) then
      !beamLevel = object ARRAY()
      do !i from 2 to !this.refe.lndLevels.size()
        !level = !this.refe.lndLevels[!i] - !this.refe.lndLevels[1]
        !beamLevel.append(!level)
      enddo
      !beamLevel.append(!this.zLength)
      !this.beamLevelStrTwr = !beamLevel
    else
      !this.deriveBeamLevelStrtwr(!!aslStrTwr.meStrTwrEngine.strTwrCriteria.landingLevel.optimum())
    endif
  endif

  --finished floor levels
  if ( !this.refe.lndLevels.set() ) then
    !this.fflLevelStrTwr         = !refe.lndLevels
  endif

  --Tower steel column data attributes
  !this.columnProfile.updateDataObj(!refe)

  --Tower steel beam data attributes
  !this.beamProfile.updateDataObj(!refe)

  --stair Landing attributes
  !this.tieBeamProfile.meStrLngEngine.strLngData.updateDataObj(!refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateStrTwrDB
--
-- Description: creates/updates STRTER element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateStrTwrDB()

  !!fmsys.setProgress(10)
  -- create undo mark
  if ( !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update stair tower')
    !undo.add()
  endif

  if(!!aslStoreTable.getStore('stairTower').set() and !!aslStoreTable.getStore('stairTower').badRef().not())then
    !!ce = !!aslStoreTable.getStore('stairTower')
  endif

  if ( !this.refe.set() ) then
    !collection = object COLLECTION()
    !collection.scope(!this.refe)
    !collection.type('STRTWR')
    !result = !collection.results()
    if ( !result.empty() ) then
      -- creates/updates the owner element
      !strTwrRefe = object DBREF()
      !strTwrRefe = !!aslCreate('STRTWR', !strTwrRefe)
      !this.refe = !strTwrRefe
    else
      --initialise the refe
      !strTwrRefe = !this.refe
    endif
  elseif ( !this.refe.unset() ) then
    !strTwrRefe = object DBREF()
    !strTwrRefe = !!aslCreate('STRTWR', !strTwrRefe)
    !this.refe = !strTwrRefe
  endif

  -- stair tower attributes
  ---------------------------------------------------------------------------
  !this.refe.pos          = !this.position
  !this.refe.prmDirection = !this.prmDirection
  !this.refe.strStd       = !this.settingReference
  !!fmsys.setProgress(25)
  if (!!aslStrTwr.dbName.val.set()) then
    !this.refe.name         = !!aslStrTwr.dbName.val
  endif
  if (!!aslStrTwr.dbDescription.val.set()) then
    !this.refe.description  = !!aslStrTwr.dbDescription.val
  endif

  !this.refe.area         = !!aslStrTwr.dbArea.val
  !this.refe.number       = !!aslStrTwr.dbNumber.val

  -- end undo mark
  if ( !this.undoable ) then
    !undo.endUndoable()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateStrWayDB
--
-- Description: creates/updates STRTER element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateStrWayDB()

  !!fmsys.setProgress(10)
  -- create undo mark
  if ( !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update stair Way')
    !undo.add()
  endif

  if(!!aslStoreTable.getStore('stairTower').set() and !!aslStoreTable.getStore('stairTower').badRef().not())then
    !!ce = !!aslStoreTable.getStore('stairTower')
  endif

  if ( !this.refe.set() ) then
    !collection = object COLLECTION()
    !collection.scope(!this.refe)
    !collection.type('STRTWR')
    !result = !collection.results()
    if ( !result.empty() ) then
      -- creates/updates the owner element
      !strWayRefe = object DBREF()
      !strWayRefe = !!aslCreate('STRTWR', !strWayRefe)
      !this.refe = !strWayRefe
    else
      --initialise the refe
      !strWayRefe = !this.refe
    endif
  elseif ( !this.refe.unset() ) then
    !strWayRefe = object DBREF()
    !strWayRefe = !!aslCreate('STRTWR', !strWayRefe)
    !this.refe = !strWayRefe
  endif

  -- stair Way attributes
  ---------------------------------------------------------------------------
  !this.refe.pos          = !this.position
  !this.refe.prmDirection = !this.prmDirection
  !this.refe.strStd       = !this.settingReference
  !!fmsys.setProgress(25)
  if (!!aslStrWay.dbName.val.set()) then
    !this.refe.name         = !!aslStrWay.dbName.val
  endif
  if (!!aslStrWay.dbDescription.val.set()) then
    !this.refe.description  = !!aslStrWay.dbDescription.val
  endif

  !this.refe.area         = !!aslStrWay.dbArea.val
  !this.refe.number       = !!aslStrWay.dbNumber.val

  -- end undo mark
  if ( !this.undoable ) then
    !undo.endUndoable()
  endif

endmethod
-- End of method

