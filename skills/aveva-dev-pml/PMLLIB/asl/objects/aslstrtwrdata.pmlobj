------------------------------------------------------------------------
--
-- Method:      updateStrLngDB
--
-- Description: updates the Landing details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateStrLngDB()

  !!fmsys.setProgress(15)

  --set the installation senSe
  !this.refe.intsen       = !this.clockwise

  --update the stair tower data element
  !this.refe.opheight       = !this.zLength
  !this.refe.opWidth        = !this.yLength
  !this.refe.opLength       = !this.xLength
  !this.refe.colXSpacing[1] = !this.clXSpacing
  !this.refe.colYSpacing[1] = !this.clYSpacing
  !this.refe.lndLevels      = !this.fflLevelStrTwr

  !this.tieBeamProfile.meStrLngEngine.strLngData.refe = !this.refe

  --create the landing DB element
  !this.tieBeamProfile.updateStrLngDB()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateColumnProfileDb
--
-- Description: creates the column details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateColumnProfileDb()

  !!fmsys.setProgress(30)

  --update the stair tower data element
  !this.refe.opheight = !this.zLength
  !this.refe.opWidth  = !this.yLength
  !this.refe.opLength = !this.xLength

  --update the column data
  !this.columnProfile.updateColumnProfileDb(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateBeamProfileDb
--
-- Description: creates the beam details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateBeamProfileDb()

  --update the stair tower data element
  !this.refe.opheight = !this.zLength
  !this.refe.opWidth  = !this.yLength
  !this.refe.opLength = !this.xLength
  !this.refe.bmLevels = !this.beamLevelStrTwr

  --create the beam DB element
  !this.beamProfile.updateBeamProfileDb(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawDatum
--
-- Description: creates the datum details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawDatum()

  --init the pos and dir
  !prmDir   = !this.prmDirection.string().before(' WRT')
  !orthoDir = !prmDir.direction().orthogonal(U)
  !position = !this.position.offset(!prmDir.direction() , 1500mm).offset(!prmDir.direction().orthogonal(U) , 100mm)
  !posText  = !this.position.string(!!distanceFmt).before(' WRT')

  --adding a detail at the default position
  AID text   NUMBER $!!<aslCentralData.aidVolDatum> (|$!prmDir|)      at $!position
  AID sphere NUMBER $!!<aslCentralData.aidVolDatum> $!<this.position>                                                 DIAM    250mm
  AID text   NUMBER $!!<aslCentralData.aidVolDatum> (|$!posText|)     at $!<this.position>
  AID arrow  NUMBER $!!<aslCentralData.aidVolDatum>                   at $!<this.position> DIR $!<this.prmDirection>  HEIGHT 1500mm
  AID arrow  NUMBER $!!<aslCentralData.aidVolDatum>                   at $!<this.position> DIR $!<orthoDir>           HEIGHT 1500mm
  AID arrow  NUMBER $!!<aslCentralData.aidVolDatum>                   at $!<this.position> DIR U                      HEIGHT 1500mm

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawCentreLines
--
-- Description: creates the centre line details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawCentreLines()

  --init the pos and dir
  !posStartX1   = !this.position.offset( !this.orientation.xDir() , !this.clXSpacing / 2 ).offset( !this.orientation.yDir().opposite() , ( ( !this.clYSpacing / 2) + !this.tieBeamProfile.meStrLngEngine.strLngData.lngLength ) )
  !posEndX1     = !posStartX1.offset( !this.orientation.yDir() , (!this.clYSpacing + ( 2 * !this.tieBeamProfile.meStrLngEngine.strLngData.lngLength ) ) )
  !posStartX2   = !this.position.offset( !this.orientation.xDir().opposite() , !this.clXSpacing / 2).offset( !this.orientation.yDir().opposite() , ( ( !this.clYSpacing / 2) + !this.tieBeamProfile.meStrLngEngine.strLngData.lngLength ) )
  !posEndX2     = !posStartX2.offset( !this.orientation.yDir() , (!this.clYSpacing + ( 2 * !this.tieBeamProfile.meStrLngEngine.strLngData.lngLength ) ) )
  !posStartY1   = !this.position.offset( !this.orientation.yDir().opposite(), !this.clYSpacing / 2 ).offset( !this.orientation.xDir(), ( ( !this.clXSpacing / 2 ) + !this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth ) )
  !posEndY1     = !posStartY1.offset( !this.orientation.xDir().opposite(), ( !this.clXSpacing + ( 2 * !this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth ) ) )
  !posStartY2   = !this.position.offset( !this.orientation.yDir(), !this.clYSpacing / 2 ).offset( !this.orientation.xDir(), ( ( !this.clXSpacing / 2 )  + !this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth ) )
  !posEndY2     = !posStartY2.offset( !this.orientation.xDir().opposite(), ( !this.clXSpacing + ( 2 * !this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth ) ) )

  do !j from 1 to !this.fflLevelStrTwr.size()
    do !k from 1 to 2
      !line = object LINE()
      !start = !posStartX$!k
      !line.startPosition = !start.offset( U, !this.fflLevelStrTwr[$!j].real() )
      !end = !posEndX$!k
      !line.endPosition   = !end.offset( U, !this.fflLevelStrTwr[$!j].real() )
      !line.draw(!!aslCentralData.aidVolLineColumn, !!aslCentralData.lineStyleDashedThick, !!aslCentralData.colourMain)
    enddo
  enddo

  do !j from 1 to !this.fflLevelStrTwr.size()
    do !k from 1 to 2
      !line = object LINE()
      !start = !posStartY$!k
      !line.startPosition = !start.offset( U, !this.fflLevelStrTwr[$!j].real() )
      !end = !posEndY$!k
      !line.endPosition   = !end.offset( U, !this.fflLevelStrTwr[$!j].real() )
      !line.draw(!!aslCentralData.aidVolLineColumn, !!aslCentralData.lineStyleDashedThick, !!aslCentralData.colourMain)
    enddo
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawFltCentreLines
--
-- Description: creates the centre line details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawFltCentreLines()

  --init the pos and dir
  !posStartX1   = !this.position.offset( !this.orientation.xDir() , !this.fltClXSpacing / 2 ).offset( !this.orientation.yDir().opposite() , ( ( !this.fltClYSpacing / 2) + !this.tieBeamProfile.meStrLngEngine.strLngData.lngLength ) )
  !posEndX1     = !posStartX1.offset( !this.orientation.yDir() , (!this.fltClYSpacing + ( 2 * !this.tieBeamProfile.meStrLngEngine.strLngData.lngLength ) ) )
  !posStartX2   = !this.position.offset( !this.orientation.xDir().opposite() , !this.fltClXSpacing / 2).offset( !this.orientation.yDir().opposite() , ( ( !this.fltClYSpacing / 2) + !this.tieBeamProfile.meStrLngEngine.strLngData.lngLength ) )
  !posEndX2     = !posStartX2.offset( !this.orientation.yDir() , (!this.fltClYSpacing + ( 2 * !this.tieBeamProfile.meStrLngEngine.strLngData.lngLength ) ) )
  !posStartY1   = !this.position.offset( !this.orientation.yDir().opposite(), !this.fltClYSpacing / 2 ).offset( !this.orientation.xDir(), ( ( !this.fltClXSpacing / 2 ) + !this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth ) )
  !posEndY1     = !posStartY1.offset( !this.orientation.xDir().opposite(), ( !this.fltClXSpacing + ( 2 * !this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth ) ) )
  !posStartY2   = !this.position.offset( !this.orientation.yDir(), !this.fltClYSpacing / 2 ).offset( !this.orientation.xDir(), ( ( !this.fltClXSpacing / 2 )  + !this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth ) )
  !posEndY2     = !posStartY2.offset( !this.orientation.xDir().opposite(), ( !this.fltClXSpacing + ( 2 * !this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth ) ) )

  do !j from 1 to !this.fflLevelStrTwr.size()
    do !k from 1 to 2
      !line = object LINE()
      !start = !posStartX$!k
      !line.startPosition = !start.offset( U, !this.fflLevelStrTwr[$!j].real() )
      !end = !posEndX$!k
      !line.endPosition   = !end.offset( U, !this.fflLevelStrTwr[$!j].real() )
      !line.draw(!!aslCentralData.aidVolLineColumn, !!aslCentralData.lineStyleDashedThick, !!aslCentralData.colourMain)
    enddo
  enddo

  do !j from 1 to !this.fflLevelStrTwr.size()
    do !k from 1 to 2
      !line  = object LINE()
      !start = !posStartY$!k
      !line.startPosition = !start.offset( U, !this.fflLevelStrTwr[$!j].real() )
      !end   = !posEndY$!k
      !line.endPosition   = !end.offset( U, !this.fflLevelStrTwr[$!j].real() )
      !line.draw(!!aslCentralData.aidVolLineColumn, !!aslCentralData.lineStyleDashedThick, !!aslCentralData.colourMain)
    enddo
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawTowerVolume
--
-- Description: creates the volume details of the Tower
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawTowerVolume()

  --Bottom Rectangle
  !posLinex11 = !this.position.offset( !this.orientation.xDir(), !this.xLength / 2 ).offset( !this.orientation.yDir().opposite(), !this.yLength / 2 )
  !posLinex12 = !posLinex11.offset( !this.orientation.xDir().opposite(), !this.xLength)
  !posLinex13 = !posLinex12.offset( !this.orientation.yDir(), !this.yLength )
  !posLinex14 = !posLinex13.offset( !this.orientation.xDir(), !this.xLength )

  !line = object LINE()
  !line.startPosition = !posLinex11
  !line.endPosition   = !posLinex12
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

  !line = object LINE()
  !line.startPosition = !posLinex12
  !line.endPosition   = !posLinex13
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

  !line = object LINE()
  !line.startPosition = !posLinex13
  !line.endPosition   = !posLinex14
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

  !line = object LINE()
  !line.startPosition = !posLinex14
  !line.endPosition   = !posLinex11
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

  --top Rectangle
  !posLinex21 = !posLinex11.offset( U, !this.zLength )
  !posLinex22 = !posLinex12.offset( U, !this.zLength )
  !posLinex23 = !posLinex13.offset( U, !this.zLength )
  !posLinex24 = !posLinex14.offset( U, !this.zLength )

  !line = object LINE()
  !line.startPosition = !posLinex21
  !line.endPosition   = !posLinex22
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

  !line = object LINE()
  !line.startPosition = !posLinex22
  !line.endPosition   = !posLinex23
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

  !line = object LINE()
  !line.startPosition = !posLinex23
  !line.endPosition   = !posLinex24
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

  !line = object LINE()
  !line.startPosition = !posLinex24
  !line.endPosition   = !posLinex21
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

  --joining lines from bottom to top
  !posLinextb11 = !posLinex11
  !posLinextb12 = !posLinex21

  !posLinextb22 = !posLinex12
  !posLinextb21 = !posLinex22

  !posLinextb33 = !posLinex13
  !posLinextb31 = !posLinex23

  !posLinextb44 = !posLinex14
  !posLinextb41 = !posLinex24

  !line = object LINE()
  !line.startPosition = !posLinextb11
  !line.endPosition   = !posLinextb12
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

  !line = object LINE()
  !line.startPosition = !posLinextb22
  !line.endPosition   = !posLinextb21
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

  !line = object LINE()
  !line.startPosition = !posLinextb33
  !line.endPosition   = !posLinextb31
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

  !line = object LINE()
  !line.startPosition = !posLinextb44
  !line.endPosition   = !posLinextb41
  !line.draw(!!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleStrTwr, !!aslCentralData.colourStrTwr)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawFflLevelAid
--
-- Description: creates the AID details of the landing
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawFflLevelAid()

  --calculate the corner position
  !posStart  = object ARRAY()
  !posEnd    = object ARRAY()

  !pos1Start = !this.position.offset( !this.orientation.xDir(), !this.xLength / 2 ).offset( !this.orientation.yDir().opposite(), !this.yLength / 2 )
  !pos1End   = !pos1Start.offset( !this.orientation.yDir(), !this.yLength )

  !pos2Start = !pos1End
  !pos2End   = !pos2Start.offset( !this.orientation.xDir().opposite(), !this.xLength )

  !pos3Start = !pos2End
  !pos3End   = !pos3Start.offset( !this.orientation.yDir().opposite(), !this.yLength )

  !pos4Start = !pos3End
  !pos4End   = !pos1Start

  !posStart.append(!pos1Start)
  !posStart.append(!pos2Start)
  !posStart.append(!pos3Start)
  !posStart.append(!pos4Start)

  !posEnd.append(!pos1End)
  !posEnd.append(!pos2End)
  !posEnd.append(!pos3End)
  !posEnd.append(!pos4End)

  --draw the aid graphics
  do !i from 1 to !this.fflLevelStrTwr.size()
    -- aid text for the up pos of the landing level
    !position = !this.position.offset(!this.orientation.yDir().opposite() , !this.yLength / 2 ).offset( U , !this.fflLevelStrTwr[$!i].real() ).offset( !this.orientation.xDir(), !this.xLength / 2 )
    !posUp    = !this.fflLevelStrTwr[!i].string(!!distanceFmt)
    AID TEXT NUMBER $!!<aslCentralData.aidVolLineBeam> (|FFL Elev $!posUp |) AT $!position
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateStrFltObject
--
-- Description: calculate the position for the stair flight and
--              object definition
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateStrFltObject()

  !installOption = !this.tieBeamProfile.meStrLngEngine.strLngData.installationOption
  !senSe         = !this.clockwise
  !prmDir        = !this.prmDirection
  !upPos         = !this.fflLevelStrTwr
  !xLength       = !this.xLength
  !yLength       = !this.yLength
  !fltClXSpacing = !this.fltClXSpacing
  !fltClYSpacing = !this.fltClYSpacing
  !length        = !this.tieBeamProfile.meStrLngEngine.strLngData.lngLength
  !width         = !this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth

  !!fmsys.setProgress(20)

  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  --initialise the variable
  !this.strFltPos = object ARRAY()
  !this.strFltObj = object ARRAY()

  --collect the stair flights
  !collFlt = object COLLECTION()
  !collFlt.scope(!this.refe)
  !collFlt.type('STRFLT')
  !resFlt  = !collFlt.results()

  --calculate the LWP and UWP based on the installation option
  if ( !installOption.eq('One stair, stair north') ) then
    do !i from 1 to ( !upPos.size() - 1 )
      !posArray           = object ARRAY()
      !flightLwp          = object EDGPOSITIONDATA()
      !flightUwp          = object EDGPOSITIONDATA()
      !flightLwp.position = !this.refe.pos.offset( !prmDir, !fltClYSpacing / 2 ).offset( !prmDir1, !xLength / 2 - !width ).offset( U, !upPos[!i] )
      !flightUwp.position = !this.refe.pos.offset( !prmDir, !fltClYSpacing / 2 ).offset( !prmDir2, !xLength / 2 - !width ).offset( U, !upPos[!i + 1] )
      !posArray.append(!flightLwp)
      !posArray.append(!flightUwp)
      --add the position data to the member
      !this.strFltPos[!i] = !posArray
      !!fmsys.setProgress( ( !i * 3 ) + 30)
      !key = 'ONE'
      --update the object definition
      if ( !this.evaluateSuccess and !resFlt.empty().not() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key, !resFlt[!i])
      elseif ( !this.evaluateSuccess and !resFlt.empty() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key)
      else
        return
      endif
    enddo

  elseif ( !installOption.eq('Two stairs, platform north and south') ) then
    do !i from 1 to ( !upPos.size() - 1 ) by 2
      !posArray           = object ARRAY()
      !flightLwp          = object EDGPOSITIONDATA()
      !flightUwp          = object EDGPOSITIONDATA()
      !flightLwp.position = !this.refe.pos.offset( !prmDir.opposite(), ( !yLength / 2 ) - !length ).offset( !prmDir1, ( !fltClXSpacing / 2 ) ).offset( U, !upPos[!i] )
      !flightUwp.position = !this.refe.pos.offset( !prmDir, ( !yLength / 2 ) - !length ).offset( !prmDir1, ( !fltClXSpacing / 2 ) ).offset( U, !upPos[!i + 1] )
      !posArray.append(!flightLwp)
      !posArray.append(!flightUwp)
      --add the position data to the member
      !this.strFltPos[!i] = !posArray
      !!fmsys.setProgress( ( !i * 2 ) + 30)
      --update the object definition
      !key = 'ODD'
      --update the object definition
      if ( !this.evaluateSuccess and !resFlt.empty().not() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key, !resFlt[!i])
      elseif ( !this.evaluateSuccess and !resFlt.empty() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key)
      else
        return
      endif
    enddo

    do !i from 2 to ( !upPos.size() - 1 ) by 2
      !posArray           = object ARRAY()
      !flightLwp          = object EDGPOSITIONDATA()
      !flightUwp          = object EDGPOSITIONDATA()
      !flightLwp.position = !this.refe.pos.offset( !prmDir, ( !yLength / 2 ) - !length ).offset( !prmDir2, ( !fltClXSpacing / 2 ) ).offset( U, !upPos[!i] )
        !flightUwp.position = !this.refe.pos.offset( !prmDir.opposite(), ( !yLength / 2 ) - !length ).offset( !prmDir2, ( !fltClXSpacing / 2 ) ).offset( U, !upPos[!i + 1] )
      !posArray.append(!flightLwp)
      !posArray.append(!flightUwp)
      --add the position data to the member
      !this.strFltPos[!i] = !posArray
      !!fmsys.setProgress( ( !i * 2.5 ) + 60)
      --update the object definition
      !key = 'EVEN'
      --update the object definition
      if ( !this.evaluateSuccess and !resFlt.empty().not() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key, !resFlt[!i])
      elseif ( !this.evaluateSuccess and !resFlt.empty() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key)
      else
        return
      endif
    enddo

  elseif ( !installOption.eq('Three stairs, platform south') ) then
    do !i from 1 to ( !upPos.size() - 1 ) by 3
      !posArray           = object ARRAY()
      !flightLwp          = object EDGPOSITIONDATA()
      !flightUwp          = object EDGPOSITIONDATA()
      !flightLwp.position = !this.refe.pos.offset( !prmDir.opposite(), ( !yLength / 2 - !length ) ).offset( !prmDir1, !fltClXSpacing / 2 ).offset( U, !upPos[!i] )
      !flightUwp.position = !this.refe.pos.offset( !prmDir, ( !yLength / 2 - !length ) ).offset( !prmDir1, !fltClXSpacing / 2 ).offset( U, !upPos[!i + 1] )
      !posArray.append(!flightLwp)
      !posArray.append(!flightUwp)
      --add the position data to the member
      !this.strFltPos[!i] = !posArray
      !!fmsys.setProgress( ( !i * 2 ) + 30)
      --update the object definition
      !key = 'SOUTH'
      --update the object definition
      if ( !this.evaluateSuccess and !resFlt.empty().not() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key, !resFlt[!i])
      elseif ( !this.evaluateSuccess and !resFlt.empty() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key)
      else
        return
      endif
    enddo

    do !i from 2 to ( !upPos.size() - 1 ) by 3
      !posArray           = object ARRAY()
      !flightLwp          = object EDGPOSITIONDATA()
      !flightUwp          = object EDGPOSITIONDATA()
      !flightLwp.position = !this.refe.pos.offset( !prmDir, ( !fltClYSpacing / 2 ) ).offset( !prmDir1, !xLength / 2 - !width ).offset( U, !upPos[!i] )
      !flightUwp.position = !this.refe.pos.offset( !prmDir, ( !fltClYSpacing / 2 ) ).offset( !prmDir2, !xLength / 2 - !width ).offset( U, !upPos[!i + 1] )
      !posArray.append(!flightLwp)
      !posArray.append(!flightUwp)
      --add the position data to the member
      !this.strFltPos[!i] = !posArray
      !!fmsys.setProgress( ( !i * 2 ) + 60)
      --update the object definition
      !key = 'WEST'
      --update the object definition
      if ( !this.evaluateSuccess and !resFlt.empty().not() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key, !resFlt[!i])
      elseif ( !this.evaluateSuccess and !resFlt.empty() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key)
      else
        return
      endif
    enddo

    do !i from 3 to ( !upPos.size() - 1 ) by 3
      !posArray           = object ARRAY()
      !flightLwp          = object EDGPOSITIONDATA()
      !flightUwp          = object EDGPOSITIONDATA()
      !flightLwp.position = !this.refe.pos.offset( !prmDir, ( !yLength / 2 - !length ) ).offset( !prmDir2, !fltClXSpacing / 2 ).offset( U, !upPos[!i] )
      !flightUwp.position = !this.refe.pos.offset( !prmDir.opposite(), ( !yLength / 2 - !length ) ).offset( !prmDir2, !fltClXSpacing / 2 ).offset( U, !upPos[!i + 1] )
      !posArray.append(!flightLwp)
      !posArray.append(!flightUwp)
      --add the position data to the member
      !this.strFltPos[!i] = !posArray
      !!fmsys.setProgress( ( !i * 2 ) + 80)
      --update the object definition
      !key = 'NORTH'
      --update the object definition
      if ( !this.evaluateSuccess and !resFlt.empty().not() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key, !resFlt[!i])
      elseif ( !this.evaluateSuccess and !resFlt.empty() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key)
      else
        return
      endif
    enddo

  elseif ( !installOption.eq('Four stairs') ) then
    !!fmsys.setProgress(30)
    do !i from 1 to ( !upPos.size() - 1 ) by 4
      !posArray           = object ARRAY()
      !flightLwp          = object EDGPOSITIONDATA()
      !flightUwp          = object EDGPOSITIONDATA()
      !flightLwp.position = !this.refe.pos.offset( !prmDir.opposite(), !yLength / 2 - !length ).offset( !prmDir1, ( !fltClXSpacing / 2 ) ).offset( U, !upPos[!i] )
      !flightUwp.position = !this.refe.pos.offset( !prmDir, !yLength / 2 - !length ).offset( !prmDir1, ( !fltClXSpacing / 2 ) ).offset( U, !upPos[!i + 1] )
      !posArray.append(!flightLwp)
      !posArray.append(!flightUwp)
      --add the position data to the member
      !this.strFltPos[!i] = !posArray
      !!fmsys.setProgress( ( !i * 1.5 ) + 30)
      --update the object definition
      !key = 'SOUTH'
      --update the object definition
      if ( !this.evaluateSuccess and !resFlt.empty().not() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key, !resFlt[!i])
      elseif ( !this.evaluateSuccess and !resFlt.empty() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key)
      else
        return
      endif
    enddo

    do !i from 2 to ( !upPos.size() - 1 ) by 4
      !posArray           = object ARRAY()
      !flightLwp          = object EDGPOSITIONDATA()
      !flightUwp          = object EDGPOSITIONDATA()
      !flightLwp.position = !this.refe.pos.offset( !prmDir, ( !fltClYSpacing / 2 ) ).offset( !prmDir1, !xLength / 2 - !width ).offset( U, !upPos[!i] )
      !flightUwp.position = !this.refe.pos.offset( !prmDir, ( !fltClYSpacing / 2 ) ).offset( !prmDir2, !xLength / 2 - !width ).offset( U, !upPos[!i + 1] )
      !posArray.append(!flightLwp)
      !posArray.append(!flightUwp)
      --add the position data to the member
      !this.strFltPos[!i] = !posArray
      !!fmsys.setProgress( ( !i * 1.5 ) + 45)
      --update the object definition
      !key = 'WEST'
      --update the object definition
      if ( !this.evaluateSuccess and !resFlt.empty().not() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key, !resFlt[!i])
      elseif ( !this.evaluateSuccess and !resFlt.empty() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key)
      else
        return
      endif
    enddo

    do !i from 3 to ( !upPos.size() - 1 ) by 4
      !posArray           = object ARRAY()
      !flightLwp          = object EDGPOSITIONDATA()
      !flightUwp          = object EDGPOSITIONDATA()
      !flightLwp.position = !this.refe.pos.offset( !prmDir, !yLength / 2 - !length ).offset( !prmDir2, ( !fltClXSpacing / 2 ) ).offset( U, !upPos[!i] )
      !flightUwp.position = !this.refe.pos.offset( !prmDir.opposite(), !yLength / 2 - !length ).offset( !prmDir2, ( !fltClXSpacing / 2  ) ).offset( U, !upPos[!i + 1] )
      !posArray.append(!flightLwp)
      !posArray.append(!flightUwp)
      --add the position data to the member
      !this.strFltPos[!i] = !posArray
      !!fmsys.setProgress( ( !i * 1.5 ) + 65)
      --update the object definition
      !key = 'NORTH'
      --update the object definition
      if ( !this.evaluateSuccess and !resFlt.empty().not() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key, !resFlt[!i])
      elseif ( !this.evaluateSuccess and !resFlt.empty() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key)
      else
        return
      endif
    enddo

    do !i from 4 to ( !upPos.size() - 1 ) by 4
      !posArray           = object ARRAY()
      !flightLwp          = object EDGPOSITIONDATA()
      !flightUwp          = object EDGPOSITIONDATA()
      !flightLwp.position = !this.refe.pos.offset( !prmDir.opposite(), ( !fltClYSpacing / 2 ) ).offset( !prmDir2, !xLength / 2 - !width ).offset( U, !upPos[!i] )
      !flightUwp.position = !this.refe.pos.offset( !prmDir.opposite(), ( !fltClYSpacing / 2 ) ).offset( !prmDir1, !xLength / 2 - !width ).offset( U, !upPos[!i + 1] )
      !posArray.append(!flightLwp)
      !posArray.append(!flightUwp)
      --add the position data to the member
      !this.strFltPos[!i] = !posArray
      !!fmsys.setProgress( ( !i * 1.5 ) + 85)
      --update the object definition
      !key = 'EAST'
      --update the object definition
      if ( !this.evaluateSuccess and !resFlt.empty().not() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key, !resFlt[!i])
      elseif ( !this.evaluateSuccess and !resFlt.empty() ) then
        !this.evaluateStrFlt(!this.strFltPos[!i], !i, !key)
      else
        return
      endif
    enddo
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evaluateStrFlt
--
-- Description: evaluates the stair flight for criteria
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evaluateStrFlt(!posArray is ARRAY, !i is REAL, !key is STRING)

  --initialise the data
  !installOption = !this.tieBeamProfile.meStrLngEngine.strLngData.installationOption

  -- update the object definition
  if ( !installOption.eq('One stair, stair north') and !key.upcase().eq('ONE') ) then
    !strFltObjDefinition                         = object DBEASLSTRFLT(!!aslCentralData.currSetting.description)
    !strFltObjDefinition.setPickedPositionData(!posArray)
    !strFltObjDefinition.setTemplateReference(!this.strFltTmplReference)
    !strFltObjDefinition.noExtension             = true
    !strFltObjDefinition.extnOption              = 0
    !strFltObjDefinition.width                   = !this.fltWidth
    !strFltObjDefinition.lHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !strFltObjDefinition.rHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !this.evaluateSuccess = !strFltObjDefinition.evaluate('STRAIGHT')

    --append the object to the member
    !this.strFltObj[!i] = !strFltObjDefinition

  elseif ( !installOption.eq('Two stairs, platform north and south') and ( !key.upcase() inset('ODD' , 'EVEN' ) ) ) then
    !strFltObjDefinition                         = object DBEASLSTRFLT(!!aslCentralData.currSetting.description)
    !strFltObjDefinition.setPickedPositionData(!posArray)
    !strFltObjDefinition.setTemplateReference(!this.strFltTmplReference)
    !strFltObjDefinition.noExtension             = true
    !strFltObjDefinition.extnOption              = 0
    !strFltObjDefinition.width                   = !this.fltWidth
    !strFltObjDefinition.lHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !strFltObjDefinition.rHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !this.evaluateSuccess = !strFltObjDefinition.evaluate('STRAIGHT')

    --append the object to the member
    !this.strFltObj[!i] = !strFltObjDefinition

  elseif ( !installOption.eq('Three stairs, platform south') and ( !key.upcase() inset ('SOUTH' , 'WEST', 'NORTH') ) ) then
    !strFltObjDefinition                         = object DBEASLSTRFLT(!!aslCentralData.currSetting.description)
    !strFltObjDefinition.setPickedPositionData(!posArray)
    !strFltObjDefinition.setTemplateReference(!this.strFltTmplReference)
    !strFltObjDefinition.noExtension             = true
    !strFltObjDefinition.extnOption              = 0
    !strFltObjDefinition.width                   = !this.fltWidth
    !strFltObjDefinition.lHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !strFltObjDefinition.rHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !this.evaluateSuccess = !strFltObjDefinition.evaluate('STRAIGHT')

    --append the object to the member
    !this.strFltObj[!i] = !strFltObjDefinition

  elseif ( !installOption.eq('Four stairs') and ( !key.upcase() inset ('SOUTH', 'NORTH', 'WEST', 'EAST') ) ) then
    !strFltObjDefinition                         = object DBEASLSTRFLT(!!aslCentralData.currSetting.description)
    !strFltObjDefinition.setPickedPositionData(!posArray)
    !strFltObjDefinition.setTemplateReference(!this.strFltTmplReference)
    !strFltObjDefinition.noExtension             = true
    !strFltObjDefinition.extnOption              = 0
    !strFltObjDefinition.width                   = !this.fltWidth
    !strFltObjDefinition.lHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !strFltObjDefinition.rHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !this.evaluateSuccess = !strFltObjDefinition.evaluate('STRAIGHT')

    --append the object to the member
    !this.strFltObj[!i] = !strFltObjDefinition

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evaluateStrFlt
--
-- Description: evaluates the stair flight for criteria
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evaluateStrFlt(!posArray is ARRAY, !i is REAL, !key is STRING, !resFlt is DBREF)

  !installOption = !this.tieBeamProfile.meStrLngEngine.strLngData.installationOption
  -- update the object definition
  if ( !installOption.eq('One stair, stair north') and !key.upcase().eq('ONE') ) then
    !strFltObjDefinition                         = object DBEASLSTRFLT(!!aslCentralData.currSetting.description)
    !strFltObjDefinition.dbeaslstrflt(!resFlt)
    !strFltObjDefinition.setPickedPositionData(!posArray)
    !strFltObjDefinition.setTemplateReference(!this.strFltTmplReference)
    !strFltObjDefinition.noExtension             = true
    !strFltObjDefinition.extnOption              = 0
    !strFltObjDefinition.width                   = !this.fltWidth
    !strFltObjDefinition.lHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !strFltObjDefinition.rHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !this.evaluateSuccess = !strFltObjDefinition.evaluate('STRAIGHT')

    --append the object to the member
    !this.strFltObj[!i] = !strFltObjDefinition

  elseif ( !installOption.eq('Two stairs, platform north and south') and ( !key.upcase() inset('ODD' , 'EVEN' ) ) ) then
    !strFltObjDefinition                         = object DBEASLSTRFLT(!!aslCentralData.currSetting.description)
    !strFltObjDefinition.dbeaslstrflt(!resFlt)
    !strFltObjDefinition.setPickedPositionData(!posArray)
    !strFltObjDefinition.setTemplateReference(!this.strFltTmplReference)
    !strFltObjDefinition.noExtension             = true
    !strFltObjDefinition.extnOption              = 0
    !strFltObjDefinition.width                   = !this.fltWidth
    !strFltObjDefinition.lHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !strFltObjDefinition.rHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !this.evaluateSuccess = !strFltObjDefinition.evaluate('STRAIGHT')

    --append the object to the member
    !this.strFltObj[!i] = !strFltObjDefinition

  elseif ( !installOption.eq('Three stairs, platform south') and ( !key.upcase() inset ('SOUTH' , 'WEST', 'NORTH') ) ) then
    !strFltObjDefinition                         = object DBEASLSTRFLT(!!aslCentralData.currSetting.description)
    !strFltObjDefinition.dbeaslstrflt(!resFlt)
    !strFltObjDefinition.setPickedPositionData(!posArray)
    !strFltObjDefinition.setTemplateReference(!this.strFltTmplReference)
    !strFltObjDefinition.noExtension             = true
    !strFltObjDefinition.extnOption              = 0
    !strFltObjDefinition.width                   = !this.fltWidth
    !strFltObjDefinition.lHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !strFltObjDefinition.rHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !this.evaluateSuccess = !strFltObjDefinition.evaluate('STRAIGHT')

    --append the object to the member
    !this.strFltObj[!i] = !strFltObjDefinition

  elseif ( !installOption.eq('Four stairs') and ( !key.upcase() inset ('SOUTH', 'NORTH', 'WEST', 'EAST') ) ) then
    !strFltObjDefinition                         = object DBEASLSTRFLT(!!aslCentralData.currSetting.description)
    !strFltObjDefinition.dbeaslstrflt(!resFlt)
    !strFltObjDefinition.setPickedPositionData(!posArray)
    !strFltObjDefinition.setTemplateReference(!this.strFltTmplReference)
    !strFltObjDefinition.noExtension             = true
    !strFltObjDefinition.extnOption              = 0
    !strFltObjDefinition.width                   = !this.fltWidth
    !strFltObjDefinition.lHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !strFltObjDefinition.rHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !this.evaluateSuccess = !strFltObjDefinition.evaluate('STRAIGHT')

    --append the object to the member
    !this.strFltObj[!i] = !strFltObjDefinition

  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      updateStrFltDB
--
-- Description: create the stair flight
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateStrFltDB()

  --update the this.refe
  !this.refe.fClXSpacing[1]    = !this.fltClXSpacing
  !this.refe.fClYSpacing[1]    = !this.fltClYSpacing

  !!fmsys.setProgress(30)

  --collect the stair flights
  !collFlt = object COLLECTION()
  !collFlt.scope(!this.refe)
  !collFlt.type('STRFLT')
  !resFlt = !collFlt.results()

  if ( !resFlt.set() ) then
    if ( !this.strFltObj.size().gt(!resFlt.size() ) ) then
      do !j from !resFlt.size() + 1 to !this.strFltObj.size()
        !!fmsys.setProgress( ( !j * 3 ) + 15 )
        !this.strFltObj[!j].width = !this.fltWidth
        !this.strFltObj[!j].dbwrite(!this.refe)
      enddo
    elseif ( !this.strFltObj.size().lt(!resFlt.size() ) ) then
      do !k from !this.strFltObj.size() + 1 to !resFlt.size()
        !!fmsys.setProgress( ( !k * 3 ) + 15 )
        !!ce = !resFlt[!k]
        delete STRFLT
      enddo
    endif
  endif

  --sort the stair flight based on elevation
  !strFltPos = object ARRAY()
  do !strFlight values !resFlt
    !strFltPos.append(!strFlight.pos.up)
  enddo

  --sort the stair flight based on pos
  !strFltSortedIndices = !strFltPos.sortedIndices()
  !resFlt.reIndex(!strFltSortedIndices)

  if ( !resFlt.empty().not() ) then
    --modify the existing element
    do !i from 1 to !this.strFltObj.size()
      !!fmsys.setProgress( ( !i * 3 ) + 55 )
      !this.strFltObj[!i].updatedb(!resFlt[!i])
    enddo

  elseif ( !resFlt.empty() ) then
    -- create the flight
    do !i from 1 to !this.strFltObj.size()
      !!fmsys.setProgress( ( !i * 5 ) + 15 )
      !this.strFltObj[!i].dbwrite(!this.refe)
    enddo
  endif

  !!fmsys.setProgress(0)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      evaluateStrFltAtt
--
-- Description: evaluate the strflt attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateStrFltAtt()

  !xEnvelopeSpacing = !this.xLength
  !yEnvelopeSpacing = !this.yLength

  !fltClXSpacing = !this.fltClXSpacing
  !fltClYSpacing = !this.fltClYSpacing
  !fltWidth      = !this.fltWidth
  !instOpt       = !this.tieBeamProfile.meStrLngEngine.strLngData.installationOption

  if ( !instOpt.eq('Two stairs, platform north and south') ) then
    !totalLength = !fltClXSpacing + !fltWidth
    if ( !fltClXSpacing.gt(!xEnvelopeSpacing) ) then
      !!alert.error( 'Stair Flight CL X Spacing is greater than the X Length of the Stair Tower')
      !this.evaluateStrFltAtt = false
      return
    elseif ( !totalLength.gt(!xEnvelopeSpacing) ) then
      !!alert.error('Stair Flight exceeds the X Length Limit of the Stair Tower.')
      !this.evaluateStrFltAtt = false
      return
    elseif ( !fltClXSpacing.leq (2 * !fltWidth) ) then
      !!alert.error('No sufficient space available for Routing the Stair Flights.')
      !this.evaluateStrFltAtt = false
      return
    endif
  elseif ( !instOpt.eq( 'One stair, stair north') ) then
    !totalLength = !fltClYSpacing + !fltWidth
    if ( !fltClYSpacing.gt(!yEnvelopeSpacing) ) then
      !!alert.error( 'Stair Flight CL Y Spacing is greater than the Y Length of the Stair Tower')
      !this.evaluateStrFltAtt = false
      return
    elseif ( !totalLength.gt(!xEnvelopeSpacing) ) then
      !!alert.error('Stair Flight exceeds the Y Length Limit of the Stair Tower.')
      !this.evaluateStrFltAtt = false
      return
    endif
  elseif ( !instOpt inset( 'Three stairs, platform south', 'Four stairs' ) ) then
    !length        = !this.tieBeamProfile.meStrLngEngine.strLngData.lngLength
    !width         = !this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
    !totalXLength = !fltClXSpacing + !fltWidth
    !totalYLength = !fltClYSpacing + !fltWidth
    if ( !fltClXSpacing.gt(!xEnvelopeSpacing) ) then
      !!alert.error ('Stair Flight CL X Spacing is greater than the X Length of the Stair Tower')
      !this.evaluateStrFltAtt = false
      return
    elseif ( !totalXLength.gt(!xEnvelopeSpacing) ) then
      !!alert.error('Stair Flight exceeds the X Length Limit of the Stair Tower.')
      !this.evaluateStrFltAtt = false
      return
    elseif ( ( !fltClXSpacing - !fltWidth ) lt ( !xEnvelopeSpacing - ( 2 * !width ) ) ) then
      !!alert.error('Stair Flight not within the limits of the Intermediate Stair Landing Length.')
      !this.evaluateStrFltAtt = false
      return
    elseif ( !fltClYSpacing.gt(!yEnvelopeSpacing) ) then
      !!alert.error ('Stair Flight CL Y Spacing is greater than the Y Length of the Stair Tower')
      !this.evaluateStrFltAtt = false
      return
    elseif ( !totalYLength.gt(!yEnvelopeSpacing) ) then
      !!alert.error('Stair Flight Exceeds the Y Length Limit of the Stair Tower.')
      !this.evaluateStrFltAtt = false
      return
    elseif ( ( !fltClYSpacing - !fltWidth ) lt ( !yEnvelopeSpacing - ( 2 * !length ) ) ) then
      !!alert.error('Stair Flight not within the limits of the Intermediate Stair Landing Width.')
      !this.evaluateStrFltAtt = false
      return
    endif
  endif

  !this.evaluateStrFltAtt = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateStrFltProfile
--
-- Description: evaluate the strflt Profile
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluateStrFltProfile()

  --check for the landing Profile
  if ( !this.deckProfile.size().leq(1) ) then
    return error 1 'Insufficient Deck Levels to Route Stair Flights!'
  endif

  --initialise the variable
  !clSpacing      = !this.fltClXSpacing
  !prmDir         = !this.prmDirection
  !position       = !this.position
  !senSe          = !this.clockwise
  !this.strFltPos = object ARRAY()

  --update based on the senSe
  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level.
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  --construct the line object to intersect
  !line1 = object LINE()
  !line1.startPosition = !position.offset( !prmDir1, !clSpacing / 2 ).offset( !prmDir, !clSpacing )
  !line1.endPosition   = !position.offset( !prmDir1, !clSpacing / 2 ).offset( !prmDir.opposite(), !clSpacing )

  !line2 = object LINE()
  !line2.startPosition = !position.offset( !prmDir2, !clSpacing / 2 ).offset( !prmDir, !clSpacing )
  !line2.endPosition   = !position.offset( !prmDir2, !clSpacing / 2 ).offset( !prmDir.opposite(), !clSpacing )

  --find the LWP and UWP form the profile
  do !i from 1 to !this.deckProfile.size() by 2
    -- find the intersection points
    skip if ( undefined(!this.deckProfile[!i + 1]) )

    !intersect1 = !this.deckProfile[!i].intersections(!line1)
    !intersect2 = !this.deckProfile[!i + 1].intersections(!line1)

    --find the shortest distance from the origin to derive the LWP from the intersected position
    !lwpDistance = object ARRAY()
    do !intersectPos values !intersect1
      !lwpDistance.append(!position.distance(!intersectPos))
    enddo

    --make the array unique
    !lwpIntersection  = !lwpDistance.unique()
    !sortedIndices    = !lwpDistance.sortedIndices()

    !intersect1.reIndex(!sortedIndices)
    !lwpPosition          = object EDGPOSITIONDATA()
    !lwpPosition.position = !intersect1.first()
    handle ANY
      return error 1 'Evaluation Failed'
    endhandle

    --find the shortest distance from the origin to derive the UWP from the intersected position
    !uwpDistance = object ARRAY()
    do !intersectPos values !intersect2
      !uwpDistance.append(!position.distance(!intersectPos))
    enddo

    --make the array unique
    !uwpIntersection  = !uwpDistance.unique()
    !sortedIndices    = !uwpDistance.sortedIndices()

    !intersect2.reIndex(!sortedIndices)
    !uwpPosition          = object EDGPOSITIONDATA()
    !uwpPosition.position = !intersect2.first()

    --define the array object and append the LWP & UWP position
    !posArray  = object ARRAY()
    !posArray.append(!lwpPosition)
    !posArray.append(!uwpPosition)

    --update the position member
    !this.strFltPos.append(!posArray)

  enddo

  do !i from 2 to !this.deckProfile.size() - 1  by 2
    -- find the intersection points
    skip if ( undefined(!this.deckProfile[!i + 1]) )

    !intersect1 = !this.deckProfile[!i].intersections(!line2)
    !intersect2 = !this.deckProfile[!i + 1].intersections(!line2)


    --find the shortest distance from the origin to derive the LWP from the intersected position
    !lwpDistance = object ARRAY()
    do !intersectPos values !intersect1
      !lwpDistance.append(!position.distance(!intersectPos))
    enddo

    --make the array unique
    !lwpIntersection  = !lwpDistance.unique()
    !sortedIndices    = !lwpDistance.sortedIndices()

    !intersect1.reIndex(!sortedIndices)
    !lwpPosition          = object EDGPOSITIONDATA()
    !lwpPosition.position = !intersect1.first()

    --find the shortest distance from the origin to derive the UWP from the intersected position
    !uwpDistance = object ARRAY()
    do !intersectPos values !intersect2
      !uwpDistance.append(!position.distance(!intersectPos))
    enddo

    --make the array unique
    !uwpIntersection  = !uwpDistance.unique()
    !sortedIndices    = !uwpDistance.sortedIndices()

    !intersect2.reIndex(!sortedIndices)
    !uwpPosition          = object EDGPOSITIONDATA()
    !uwpPosition.position = !intersect2.first()

    --define the array object and append the LWP & UWP position
    !posArray  = object ARRAY()
    !posArray.append(!lwpPosition)
    !posArray.append(!uwpPosition)

    --update the position member
    !this.strFltPos.append(!posArray)

  enddo

  --pass the boolean
  !this.evaluateStrFltProfile = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateStrWayFltObject
--
-- Description: calculate the position for the stair flight and
--              object definition
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateStrWayFltObject()

  !installOption = !this.tieBeamProfile.meStrLngEngine.strLngData.installationOption
  !senSe         = !this.clockwise
  !prmDir        = !this.prmDirection
  !upPos         = !this.fflLevelStrTwr
  !xLength       = !this.xLength
  !yLength       = !this.yLength
  !fltClXSpacing = !this.fltClXSpacing
  !fltClYSpacing = !this.fltClYSpacing
  !length        = !this.tieBeamProfile.meStrLngEngine.strLngData.lngLength
  !width         = !this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth

  !!fmsys.setProgress(20)

  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  --initialise the variable
  !this.strFltObj = object ARRAY()

  do !i from 1 to !this.strFltPos.size()
    !strFltObjDefinition                         = object DBEASLSTRFLT(!!aslCentralData.currSetting.description)
    !strFltObjDefinition.setPickedPositionData(!this.strFltPos[!i])
    !strFltObjDefinition.setTemplateReference(!this.strFltTmplReference)
    !strFltObjDefinition.width                   = !this.fltWidth
    !strFltObjDefinition.lHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !strFltObjDefinition.rHandrail.tmplReference = !this.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference
    !this.evaluateSuccess = !strFltObjDefinition.evaluate('NOEXTENSION')

    if ( !this.evaluateSuccess ) then
      --append the object to the member
      !this.strFltObj[!i] = !strFltObjDefinition
    else
      return
    endif
  enddo

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      deriveBeamLevelStrtwr
--
-- Description: derive the landing levels based on the stair tower height
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       landing elevation
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .deriveBeamLevelStrtwr(!defaultLevel is REAL)

  --initialise the array
  !this.beamLevelStrTwr = object ARRAY()

  -- find the consecutive levels based on the stair tower height
  !strTwrHeight = !this.zLength
  !landingLevel = !defaultLevel
  !factorValue  = INT ( !strTwrHeight / !landingLevel )

  do !i from 1 to !factorValue
    --check condition for the last Level
    --skip if ( !i.eq(!factorValue) )

    !consecutiveLevel = !i * !landingLevel
    !this.beamLevelStrTwr.append(!consecutiveLevel)
  enddo

  --check the last level eq to stair tower height
  !value = !factorValue * !landingLevel
  if ( !value.neq(!strTwrHeight) ) then
    -- add the stair tower height as the last Level
    !this.beamLevelStrTwr.append(!strTwrHeight)
  endif

endmethod
-- End of method
