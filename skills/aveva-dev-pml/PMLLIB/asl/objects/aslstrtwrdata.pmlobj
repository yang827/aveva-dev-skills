-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateColumnProfileData()

  --pass the values
  !prmDir    = !this.prmDirection
  !pos       = !this.position
  !xlen      = !this.xLength
  !ylen      = !this.yLength
  !zlen      = !this.zLength
  !beamLevel = !!aslStrTwr.neBeamLevel.getRows()
  !refe      = !this.refe

  !this.columnProfile.updateColumnProfileData(!prmDir, !pos, !xlen, !ylen, !zlen, !beamLevel, !refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateBeamProfileData
