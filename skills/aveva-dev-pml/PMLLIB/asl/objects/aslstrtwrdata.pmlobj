--
-- Description:     container for STRTWR data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrTwrData()                  -                   default constructor
--  deriveBeamLevelStrtwr(REAL)      -                   derive the landing levels based on the stair tower height
--  drawCentreLines()                -                   creates the centre line details
--  drawDatum()                      -                   creates the datum details
--  drawFflLevelAid()                -                   creates the AID details of the landing
--  drawFltCentreLines()             -                   creates the centre line details
--  drawHandraAids()                 -                   updates the handrail profile aids
--  drawTWR()                        -                   draws the stair tower with aid elements
--  drawTowerVolume()                -                   creates the volume details of the Tower
--  enhance()                        -                   enhances the element
--  erase()                          -                   erases all traces
--  evaluateStrFlt(ARRAY,REAL,STRING) -                   evaluates the stair flight for criteria
--  evaluateStrFlt(ARRAY,REAL,STRING,DBREF) -                   evaluates the stair flight for criteria
--  evaluateStrFltAtt()              -                   evaluate the strflt attribute
--  evaluateStrFltProfile()          -                   evaluate the strflt Profile
--  init()                           -                   init the object
--  newBeamLevel(REAL)               -
--  newDeckLevel(REAL)               -                   adds a new Deck Level
--  newDeckProfile(PROFILE)          -                   adds a new Deck profile
--  newFflLevel(REAL)                -                   adds a new Ffl  Level
--  remBeamLevel(ARRAY)              -                   removes a beam from the stack
--  remDeckLevel(ARRAY)              -                   removes a Deck from the stack
--  remDeckProfile(ARRAY)            -                   removes a Deck from the stack
--  remFflLevel(ARRAY)               -                   removes a landing from the stack
--  replaceBeamLevel(REAL,REAL)      -                   replaces an existing beam level by a new one
--  replaceDeckLevel(REAL,REAL)      -                   replaces an existing Deck level by a new one
--  replaceDeckProfile(PROFILE,REAL) -                   replaces an existing Deck Profile by a new one
--  replaceFflLevel(REAL,REAL)       -                   replaces an existing FFL level by a new one
--  showVolFeedback()                -                   draws the stair tower with aid elements
--  sortBeamLevel()                  -                   sorts the beam Level by the up position
--  sortDeckLevel()                  -                   sorts the beam Level by the up position
--  sortDeckProfile()                -                   sorts the Deck profile by the up position
--  sortFflLevel()                   -                   sorts the FFL Level by the up position
--  updateBeamProfileData()          -                   updates the beam details
--  updateBeamProfileDb()            -                   creates the beam details
--  updateColumnProfileData()        -                   updates the column details
--  updateColumnProfileDb()          -                   creates the column details
--  updateDataObj(DBREF)             -                   reads the values from the STRTWR
--  updateHandrailLngProfile()       -                   updates the handrail profile details
--  updateStrFltDB()                 -                   create the stair flight
--  updateStrFltObject()             -                   calculate the position for the stair flight and
--  updateStrLngDB()                 -                   updates the Landing details
--  updateStrTwrDB()                 -                   creates/updates STRTER element
--  updateStrWayDB()                 -                   creates/updates STRTER element
--  updateStrWayFltObject()          -                   calculate the position for the stair flight and
--  updateTieBeamProfileData()       -                   updates the Tie beam details
--
define object ASLSTRTWRDATA

  -- public members
  ---------------------------------------------------------------------------
  -- control the working direction within a  stair tower
  member .clockwise             is BOOLEAN

  -- stair tower primary direction
  member .prmDirection          is DIRECTION

  -- cl x spacing
  member .clXSpacing            is REAL

  -- cl y spacing
  member .clYSpacing            is REAL

  -- flight cl x spacing
  member .fltClXSpacing         is REAL

  -- flight cl y spacing
  member .fltClYSpacing         is REAL

  -- flight width
  member .fltWidth              is REAL

  -- installation option
  member .installationOption    is STRING

  -- orientation
  member .orientation           is ORIENTATION

  -- position
  member .position              is POSITION

  -- the reference
  member .refe                  is DBREF

  -- link to the uses setting
  member .settingReference      is STRING

  -- reference to the stair flight template
  member .strFltTmplReference   is  DBREF

  -- the width of the stair flights
  member .strFltWidth           is REAL

  -- length
  member .xLength               is REAL

  -- width
  member .yLength               is REAL

  -- height
  member .zLength               is REAL

  -- member for landing levels
  member .beamLevelStrTwr       is ARRAY

  -- member for finished floor levels
  member .fflLevelStrTwr        is ARRAY

  -- member for finished floor levels
  member .deckLevelStrWay       is ARRAY

  -- member for finished floor levels
  member .deckProfile           is ARRAY

  -- member for column profile
  member .columnProfile         is ASLTWRCOLUMNPROFILE

  -- member for beam profile
  member .beamProfile           is ASLTWRBEAMPROFILE

  --member for tie-beam profile
  member .tieBeamProfile        is ASLTWRBEAMPROFILE

  --stair flight positions
  member .strFltPos             is ARRAY

  --stair flight object Definition
  member .strFltObj             is ARRAY

  --success boolean for the evaluation of the stair flight
  member .evaluateSuccess       is BOOLEAN

  --success boolean for the evaluation of the spacing attribute
  member .evaluateStrFltAtt     is BOOLEAN

  --success boolean for the evaluation of the spacing attribute
  member .evaluateStrFltProfile is BOOLEAN

  -- controls if the object uses the undo functionality
  member .undoable              is BOOLEAN

endobject
-- End of object definition for aslStrTwrData
------------------------------------------------------------------------
--
-- Method:      aslStrTwrData
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrTwrData()

  !this.init()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawTWR
--
-- Description: draws the stair tower with aid elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawTWR()

  -- reduce the size of the expression
  !xDir = !this.orientation.xDir()
  !yDir = !this.orientation.yDir()

  -- evaluates the points
  !p1 = !this.position.offset(!xDir, !this.xLength * -0.5).offset(!yDir,  !this.yLength * -0.5)
  !p2 = !this.position.offset(!xDir, !this.xLength * -0.5).offset(!yDir,  !this.yLength *  0.5)
  !p3 = !this.position.offset(!xDir, !this.xLength *  0.5).offset(!yDir,  !this.yLength *  0.5)
  !p4 = !this.position.offset(!xDir, !this.xLength *  0.5).offset(!yDir,  !this.yLength * -0.5)
  !p5 = !p1.offset(Z, !this.zLength)
  !p6 = !p2.offset(Z, !this.zLength)
  !p7 = !p3.offset(Z, !this.zLength)
  !p8 = !p4.offset(Z, !this.zLength)

  !this.drawRect(!p1, !p2, !p3, !p4, !!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleSolidThickTwr, !!aslCentralData.colourStrTwr)
  !this.drawRect(!p5, !p6, !p7, !p8, !!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleSolidThickTwr, !!aslCentralData.colourStrTwr)

  !this.drawRect(!p1, !p4, !p8, !p5, !!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleSolidThickTwr, !!aslCentralData.colourStrTwr)
  !this.drawRect(!p2, !p3, !p7, !p6, !!aslCentralData.aidVolStrTwr, !!aslCentralData.lineStyleSolidThickTwr, !!aslCentralData.colourStrTwr)

  AID SPHERE NUMBER $!!<aslCentralData.aidVolStrTwr> $!<this.position> DIAM 250mm
  AID ARROW  NUMBER $!!<aslCentralData.aidVolStrTwr> AT $!<this.position> DIR U HEIGHT 1500mm
  AID ARROW  NUMBER $!!<aslCentralData.aidVolStrTwr> AT $!<this.position> DIR D HEIGHT 1500mm
  !xDir    = !this.orientation.xDir()
  !xDirNeg = !xDir.opposite()
  !yDir    = !xDir.orthogonal(U)
  !yDirNeg = !xDirNeg.orthogonal(U)
  AID ARROW  NUMBER $!!<aslCentralData.aidVolStrTwr> AT $!<this.position> DIR $!<xDir>    HEIGHT 1500mm
  AID ARROW  NUMBER $!!<aslCentralData.aidVolStrTwr> AT $!<this.position> DIR $!<xDirNeg> HEIGHT 1500mm
  AID ARROW  NUMBER $!!<aslCentralData.aidVolStrTwr> AT $!<this.position> DIR $!<yDir>    HEIGHT 1500mm
  AID ARROW  NUMBER $!!<aslCentralData.aidVolStrTwr> AT $!<this.position> DIR $!<yDirNeg> HEIGHT 3000mm

  -- text position
  !textPosition = !this.position.offset(!yDirNeg, 2500mm).offset(U, 500mm)
  !text         = !yDirNeg.string().before(' WRT')
  AID TEXT   NUMBER $!!<aslCentralData.aidVolStrTwr> '$!text' AT $!textPosition

endmethod
-- End of method

