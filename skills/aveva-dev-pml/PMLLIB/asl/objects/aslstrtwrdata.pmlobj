-- Description: updates the beam details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateBeamProfileData()

  --pass the values
  !prmDir        = !this.prmDirection
  !pos           = !this.position
  !xlen          = !this.xLength
  !ylen          = !this.yLength
  !zlen          = !this.zLength
  !beamLevelElev = !!aslStrTwr.neBeamLevel.getRows()

  --update the tower beam data
  !this.beamProfile.updateBeamProfileData(!prmDir, !pos, !xlen, !ylen, !zlen, !beamLevelElev)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateTieBeamProfileData
--
-- Description: updates the Tie beam details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateTieBeamProfileData()

  --data to be passed
  !data = object ARRAY()
  !data.append(!this.refe.prmDir)
  !data.append(!this.position)
  !data.append(!this.xLength)
  !data.append(!this.yLength)
  !data.append(!this.zLength)
  !data.append(!this.clockwise)
  !data.append(!this.tieBeamProfile.meStrLngEngine.strLngData.installationOption)
  !data.append(!this.tieBeamProfile.meStrLngEngine.strLngData.lngWidth)
  !data.append(!this.tieBeamProfile.meStrLngEngine.strLngData.lngLength)
  !data.append(!this.fflLevelStrTwr)

  --draw the graphics for the floor levels
  !this.tieBeamProfile.updateTieBeamProfileData(!data)

endmethod
-- End of method

