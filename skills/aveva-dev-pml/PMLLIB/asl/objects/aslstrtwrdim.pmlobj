--
--
-- Description:     container for STRTWR dimension data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrSetDim()                   -                   default constructor
--

-- Define object
define object ASLSTRTWRDIM

  -- stair tower cl x spacing
  member .clXSpacing              is BOOLEAN

  -- stair tower cl y spacing
  member .clYSpacing              is BOOLEAN

  -- stair flight cl x spacing
  member .fltClXSpacing           is BOOLEAN

  -- stair flight cl y spacing
  member .fltClYSpacing           is BOOLEAN

  -- the thickness of the stair flights
  member .fThickness              is BOOLEAN

  -- the width of the stair flights
  member .strFltWidth             is BOOLEAN

  -- the "wished" pitch of the stair flights
  member .strFltPitch             is BOOLEAN

  -- length
  member .xLength                 is BOOLEAN

  -- width
  member .yLength                 is BOOLEAN

  -- height
  member .zLength                 is BOOLEAN

  -- gate dimension
  member .gates                   is BOOLEAN

  -- length of stair landing
  member .lngLength               is BOOLEAN

  -- width of stair landing
  member .lngWidth                is BOOLEAN

  --thickness of stair landing
  member .lngThk                  is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      aslStrSetDim
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrSetDim()

  !this.clXSpacing      =    false
  !this.clYSpacing      =    false
  !this.fltClXSpacing   =    false
  !this.fltClYSpacing   =    false
  !this.fThickness      =    false
  !this.strFltWidth     =    false
  !this.strFltPitch     =    false
  !this.xLength         =    false
  !this.yLength         =    false
  !this.zLength         =    false
  !this.gates           =    false
  !this.lngLength       =    false
  !this.lngWidth        =    false
  !this.lngThk          =    false


endmethod
-- End of method
