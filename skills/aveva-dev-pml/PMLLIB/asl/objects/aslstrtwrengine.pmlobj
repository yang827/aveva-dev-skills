------------------------------------------------------------------------
--
-- Method:      pickPosition
--
-- Description: Setup EDG pick event for picking position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPosition()

  -- Initialise Variables
  !prompt               = 'Pick origin'
  !packet               = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.description   = !this.edgDescription
  !packet.remove        = true
  !packet.action        = '!!aslmain.meStrTwrEngine.position(!this.return[1])'

  -- Add event to system
  !!edgCntrl.add(!packet)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPOSITIONDATA  EDG Picked position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!data is EDGPOSITIONDATA)

  -- Initialise Variables
  !position = !data.position.wrt(World)

  -- Set position
  !this.position(!position)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Set input gadgets
  !!aslmain.strTwrPosControl.xyz(!position.east, !position.north, !position.up)
  !this.setPosition(!position)

  --Updates the stair tower position in the graphics
  !!aslmain.modifystrtwr(!!aslmain.frLocDirStrtwr,||)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      dfltTempRef
--
-- Description: sets the template reference
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       stair flight template
--    2   R      DBREF       landing template
--    3   R      DBREF       handrail template
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dfltTempRef(!strFlt is DBREF, !strLng is DBREF, !handRa is DBREF)

  -- sets the reference to the central template
  !this.setSettingReference()

  -- if the dbref is part of the current standard use it, otherwise take the first best of the standard
  !allStrFlts = !!aslCentralData.currSetting.collectAll('STRFLT')
  if ( !allStrFlts.findFirst(!strFlt).set() ) then
    !strFltTmpl = !strFlt
  else
    !strFltTmpl = !allStrFlts.first()
  endif
  !allStrLngs = !!aslCentralData.currSetting.collectAll('STRLNG')
  !allStrLngsTemplate = object ARRAY()
  do !i values !allStrLngs
    !allStrLngsTemplate.append(!i.owner)
  enddo
  !allStrLngs = !allStrLngsTemplate.unique()
  if ( !allStrLngs.findFirst(!strLng).set() ) then
    !strLngTmpl = !strLng
  else
    !strLngTmpl = !allStrLngs.first()
  endif
  !allHandRas = !!aslCentralData.currSetting.collectAll('HANDRA')
  if ( !allHandRas.findFirst(!handRa).set() ) then
    !handRaTmpl = !handRa
  else
    !handRaTmpl = !allHandRas.first()
  endif

  -- selects the templates
  !this.setTmplReferences(!strFltTmpl, !strLngTmpl, !handRaTmpl)

  -- combines general and fabricator standard
  !this.mergeCriteria()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      dfltTempRef
--
-- Description: sets the template reference
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       stair flight template
--    2   R      DBREF       handrail template
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dfltTempRef(!strFlt is DBREF, !handRa is DBREF)

  -- sets the reference to the central template
  !this.setSettingReference()

  -- if the dbref is part of the current standard use it, otherwise take the first best of the standard
  !allStrFlts = !!aslCentralData.currSetting.collectAll('STRFLT')
  if ( !allStrFlts.findFirst(!strFlt).set() ) then
    !strFltTmpl = !strFlt
  else
    !strFltTmpl = !allStrFlts.first()
  endif

  !allHandRas = !!aslCentralData.currSetting.collectAll('HANDRA')
  if ( !allHandRas.findFirst(!handRa).set() ) then
    !handRaTmpl = !handRa
  else
    !handRaTmpl = !allHandRas.first()
  endif

  -- selects the templates
  !this.setTmplReferences(!strFltTmpl, !handRaTmpl)

  -- combines general and fabricator standard
  !this.mergeCriteria()

endmethod
-- End of method
