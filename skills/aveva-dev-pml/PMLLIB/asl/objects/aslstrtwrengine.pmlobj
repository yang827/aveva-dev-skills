------------------------------------------------------------------------
--
-- Method:      getBeamLevelStrTwr
--
-- Description: returns the position
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION     the position of the strtwr
------------------------------------------------------------------------

define method .getBeamLevelStrTwr() is ARRAY

  -- default landing height
  !defaultLevel = !this.strTwrCriteria.landingLevel.optimum()

  --pass the default level and derive the consecutive levels
  !this.strTwrData.deriveBeamLevelStrtwr(!defaultLevel)

  return !this.strTwrData.beamLevelStrTwr

endmethod
