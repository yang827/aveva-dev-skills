------------------------------------------------------------------------

define method .setXLength(!xLength is REAL)

  !this.strTwrData.xLength      = !xLength
  !this.strTwrData.refe.opWidth = !xLength

  --calculate the centreline X spacing
  !clXSpacing = !this.strTwrData.xLength - !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth
