  !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.meHandraEngine.aslHandrail(!!aslCentralData.currSetting.description)
  !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.meHandraEngine.tmplReference(!handRaTmplReference)

