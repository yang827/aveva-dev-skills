--
-- Method:      setFThickness
--
-- Description: sets the thickness of the stair flights
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        thickness of the stair flights
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setFflLevelStrTwr()

  --init the ffl Level
  !this.strTwrData.fflLevelStrTwr = object ARRAY()
  !this.strTwrData.fflLevelStrTwr.append( !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk )

  do !i from 1 to ( !this.strTwrData.beamLevelStrTwr.size() - 1 )
    !tempFflLevel = ( !this.strTwrData.beamLevelStrTwr[!i] + !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk )
    !this.strTwrData.fflLevelStrTwr.append( !tempFflLevel )
  enddo

endmethod
