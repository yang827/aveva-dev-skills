------------------------------------------------------------------------
--
-- Method:      getDefaults
--
-- Description: returns the Defaults for the stair tower data
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        zlength of the stair tower
------------------------------------------------------------------------

define method .getDefaults()

  --Initialise values for first time form run
  !this.strTwrData.xLength                                            = !this.strTwrCriteria.width.optimum
  !this.strTwrData.yLength                                            = !this.strTwrCriteria.length.optimum
  !this.strTwrData.zLength                                            = !this.strTwrCriteria.height.optimum
  !this.strTwrData.clXSpacing                                         = !this.strTwrCriteria.clXSpacing.optimum
  !this.strTwrData.clYSpacing                                         = !this.strTwrCriteria.clYSpacing.optimum
  !this.strTwrData.strFltWidth                                        = !this.strTwrCriteria.width.optimum
  !this.strTwrData.clockwise                                          = true
  !this.strTwrData.prmDirection                                       = N
  !this.strTwrData.orientation                                        = y is $!this.strTwrData.prmDirection
  !this.strTwrData.position                                           = E0mm N0mm U0mm
  !this.strTwrData.fltClXSpacing                                      = !this.strTwrCriteria.clXSpacing.optimum
  !this.strTwrData.fltClYSpacing                                      = !this.strTwrCriteria.clYSpacing.optimum
  !this.strTwrData.fltWidth                                           = !this.strFltCriteria.width.optimum
  !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngWidth  = !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngCriteria.width.optimum
  !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk    = !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngCriteria.height.optimum
  !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngLength = !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngCriteria.length.optimum

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      mergeCriteria
--
-- Description: merges central standard with fabricator standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergeCriteria()

  -- if there is a fabricator standard it must be taken into account
  !this.strTwrCriteria = !!getCriteriaSetIntersection(!this.strTwrCriteriaBasis, !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.strLngTmplReference)
  !this.strTwrCriteria.complete()

  -- local criteria for strflt and landings
  !this.strFltCriteria = !!getCriteriaSetIntersection(!this.strFltCriteriaBasis, !this.strTwrData.strFltTmplReference)
  !this.strFltCriteria.complete()

  -- gets the values for the intermediated landing from the substandard
  !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngCriteria = !!getCriteriaSetIntersection(!this.strLngCriteriaBasis, !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.strLngTmplReference)
  !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngCriteria.complete()

endmethod
-- End of method
