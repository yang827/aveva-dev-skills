--
-- Method:      getInstallationOption
--
-- Description: sets the installation option
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      installation option
------------------------------------------------------------------------

define method .getInstallationOption() is STRING

  return !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.installationOption

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getInstallationOptions
--
-- Description: returns all allowed installation options
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       description and pixmap of option
------------------------------------------------------------------------

define method .getInstallationOptions() is ARRAY

  -- init
  !installationLabels  = object ARRAY()
  !installationPixMaps = object ARRAY()

  !installationLabels.append('One stair, stair north')
  !installationPixMaps.append(!!pml.getPathName('aslinstallationsituationstrtwr02-24.png'))

  !installationLabels.append('Two stairs, platform north and south')
  !installationPixMaps.append(!!pml.getPathName('aslinstallationsituationstrtwr05-24.png'))

  !installationLabels.append('Three stairs, platform south')
  !installationPixMaps.append(!!pml.getPathName('aslinstallationsituationstrtwr10-24.png'))

  !installationLabels.append('Four stairs')
  !installationPixMaps.append(!!pml.getPathName('aslinstallationsituationstrtwr11-24.png'))

  !installationOptions = object ARRAY()
  !installationOptions.append(!installationLabels)
  !installationOptions.append(!installationPixMaps)

  return !installationOptions

endmethod
-- End of method

