------------------------------------------------------------------------
--
-- Method:      setSettingReference
--
-- Description: sets the setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setSettingReference()

  --initialise the criteria set values for stair tower
  if ( !!aslCentralData.currSetting.description.set() ) then
    !this.strTwrCriteriaBasis    = !!aslCentralData.getCriteriaSet(!!aslCentralData.currSetting.description, 'ASLSTRTWRCRITERIA')
    !this.strTwrCriteriaBasis.complete()

    !this.strFltCriteriaBasis    = !!aslCentralData.getCriteriaSet(!!aslCentralData.currSetting.description, 'ASLSTRFLTCRITERIA')
    !this.strFltCriteriaBasis.complete()

    !this.strLngCriteriaBasis    = !!aslCentralData.getCriteriaSet(!!aslCentralData.currSetting.description, 'ASLSTRLNGCRITERIA')
    !this.strLngCriteriaBasis.complete()
  else
    return error 1 'No Setting to use from. Contact your ASL administrator'
  endif

  !this.strTwrData.settingReference = !!aslCentralData.currSetting.description

endmethod
