------------------------------------------------------------------------
--
-- Method:      setTmplReferences
--
-- Description: sets the template references
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      stair flight template reference
--    2   R      DBREF      intermediated landing template reference
--    3   R      DBREF      handrail template reference
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setTmplReferences(!strFltTmplReference is DBREF, !strLngTmplReference is DBREF, !handRaTmplReference is DBREF)

  !this.strTwrData.strFltTmplReference                                           = !strFltTmplReference
  !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.strLngTmplReference  = !strLngTmplReference
  !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.handRaTmplReference  = !handRaTmplReference
  !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.meHandraEngine.aslHandrail(!!aslCentralData.currSetting.description)
  !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.meHandraEngine.tmplReference(!handRaTmplReference)

  --set the handrail attributes
  !handraEngine = !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData.meHandraEngine
  !handraEngine.posts = !handraEngine.getPosts()
  !handraEngine.rails = !handraEngine.getRails()
  !handraEngine.kickPlates = !handraEngine.getKickplates()
  !handraEngine.panels()

endmethod
-- End of method
