------------------------------------------------------------------------
--
-- Method:      showDimTwrStl
--
-- Description: shows dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimTwrStl()

  -- first remove all dimension
  !!aslCentralData.clearFeedback('AIDDIM')

  -- get information about the stair flight
  !strTwrData     = !this.strTwrData
  !strTwrDim      = !this.strTwrDim
  !aidDim         = !!aslCentralData.aidDim
  !topPos         = !strTwrData.position.offset(UP, !strTwrData.zLength)

  if ( !strTwrDim.xLength ) then
    !label    = 'Tower X Length = ' & !strTwrData.xLength
    !topPosL  = !topPos.offset(!strTwrData.orientation.xDir(), !strTwrData.xLength / 2)
    !topPosR  = !topPos.offset(!strTwrData.orientation.xDir().opposite(), !strTwrData.xLength / 2)
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !topPosL, !topPosR, !strTwrData.xLength * 0.5, !aidDim)
  endif

  if ( !strTwrDim.yLength ) then
    !label    = 'Tower Y Length = ' & !strTwrData.yLength
    !topPosL  = !topPos.offset(!strTwrData.orientation.yDir(), !strTwrData.yLength / 2)
    !topPosR  = !topPos.offset(!strTwrData.orientation.yDir().opposite(), !strTwrData.yLength / 2)
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !topPosL, !topPosR, !strTwrData.yLength * 1, !aidDim)
  endif

  if ( !strTwrDim.zLength ) then
    !label    = 'Tower Z Height = ' & !strTwrData.zLength
    !topPosD  = !strTwrData.position.offset(!strTwrData.orientation.xDir(), !strTwrData.xLength / 2)
    !topPosU  = !topPos.offset(!strTwrData.orientation.xDir(), !strTwrData.xLength / 2)
    !dimObj   = object DISPLAYDIMENSION(!label, !strTwrData.orientation.xDir(), !topPosD, !topPosU, !strTwrData.xLength, !aidDim)
  endif


endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      showDimStrLng
--
-- Description: shows dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimStrLng()

  -- first remove all dimension
  !!aslCentralData.clearFeedback('AIDDIM')

  -- get information about the stair flight
  !strTwrData     = !this.strTwrData
  !strLngData     = !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData
  !upPos          = !this.getFflLevelStrTwr()
  !strTwrDim      = !this.strTwrDim
  !aidDim         = !!aslCentralData.aidDim
  !topPos         = !strTwrData.position.offset(UP, !strTwrData.zLength)
  !position       = !strTwrData.position
  !senSe          = !this.strTwrData.clockwise
  !prmDir         = !this.strTwrData.prmDirection

  --update based on the senSe
  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  if ( !strTwrDim.xLength ) then
    !label    = 'Tower X Length = ' & !strTwrData.xLength
    !topPosL  = !topPos.offset(!prmDir2, !strTwrData.xLength / 2)
    !topPosR  = !topPos.offset(!prmDir1, !strTwrData.xLength / 2)
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !topPosL, !topPosR, !strTwrData.zLength * 0.3, !aidDim)
  endif

  if ( !strTwrDim.yLength ) then
    !label    = 'Tower Y Length = ' & !strTwrData.yLength
    !topPosL  = !topPos.offset(!prmDir, !strTwrData.yLength / 2)
    !topPosR  = !topPos.offset(!prmDir.opposite(), !strTwrData.yLength / 2)
    !dimObj   = object DISPLAYDIMENSION(!label, UP, !topPosL, !topPosR, !strTwrData.zLength * 0.4, !aidDim)
  endif

  if ( !strTwrDim.zLength ) then
    !label    = 'Tower Z Height = ' & !strTwrData.zLength
    !topPosD  = !strTwrData.position.offset(!prmDir2, !strTwrData.xLength / 2)
    !topPosU  = !topPos.offset(!prmDir2, !strTwrData.xLength / 2)
    !dimObj   = object DISPLAYDIMENSION(!label, !prmDir2, !topPosD, !topPosU, !strTwrData.xLength, !aidDim)
  endif

  if ( !strTwrDim.clYSpacing ) then
    !label    = 'Centre Line (Y) Spacing =' & !strTwrData.clYSpacing
    !topPosL1 = !position.offset(!prmDir2, ( !strTwrData.clXSpacing / 2 )  )
    !topPosL  = !topPosL1.offset(!prmDir.opposite(), ( !strTwrData.clYSpacing / 2 ) ).offset( !prmDir2, ( !strLngData.lngWidth + 100mm ) )
    !topPosR  = !topPosL.offset(!prmDir, ( !strTwrData.clYSpacing ) )
    !dimObj   = object DISPLAYDIMENSION(!label, !prmDir2, !topPosL, !topPosR, !strTwrData.clXSpacing * 0.4, !aidDim)
  endif

  if ( !strTwrDim.clXSpacing ) then
    !label    = 'Centre Line (X) Spacing =' & !strTwrData.clXSpacing
    !topPosL1 = !position.offset(!prmDir, ( !strTwrData.clYSpacing / 2 ) )
    !topPosL  = !topPosL1.offset(!prmDir2, ( !strTwrData.clXSpacing / 2 ) ).offset( !prmDir, ( !strLngData.lngLength + 100mm ) )
    !topPosR  = !topPosL.offset(!prmDir1, ( !strTwrData.clXSpacing ) )
    !dimObj   = object DISPLAYDIMENSION(!label, !prmDir , !topPosL, !topPosR, !strTwrData.clYSpacing * 0.2, !aidDim)
  endif

  if ( !strTwrDim.lngLength ) then
    !label    = 'Landing Length =' & !strLngData.lngLength
    !topPosL1 = !position.offset(!prmDir.opposite(), ( ( !strTwrData.yLength / 2 ) - ( !strLngData.lngLength ) ) ).offset( U, !upPos[1])
    !topPosL  = !topPosL1.offset(!prmDir1, ( !strTwrData.xLength / 2 ) ).offset( !prmDir1, 100mm )
    !topPosR  = !topPosL.offset(!prmDir.opposite(), ( !strLngData.lngLength ) ).offset( !prmDir1, 100mm )
    !dimObj   = object DISPLAYDIMENSION(!label, !prmDir1, !topPosL, !topPosR, !strTwrData.xLength * 0.3, !aidDim)
  endif

  if ( !strTwrDim.lngWidth ) then
      !label    = 'Landing Width =' & !strLngData.lngWidth
      !topPosL1 = !position.offset(!prmDir, ( !strTwrData.yLength / 2 ) ).offset( U, !upPos[2])
      !topPosL  = !topPosL1.offset(!prmDir1, ( !strTwrData.xLength / 2 ) - !strLngData.lngWidth ).offset( !prmDir, 100mm )
      !topPosR  = !topPosL.offset(!prmDir1, !strLngData.lngWidth ).offset( !prmDir, 100mm )
      !dimObj   = object DISPLAYDIMENSION(!label, !prmDir, !topPosL, !topPosR, !strTwrData.xLength * 0.3, !aidDim)
  endif

  if ( !strTwrDim.lngThk ) then
    !label    = 'Landing Thickness =' & !strLngData.lngThk
    !topPosL1 = !position.offset(!strTwrData.orientation.yDir().opposite(), ( !strTwrData.yLength / 2 + ( 0.5 * !strLngData.lngLength ) ) )
    !topPosL  = !topPosL1.offset(!strTwrData.orientation.xDir().opposite(), ( ( !strTwrData.xLength / 2 ) - 0.5 * !strLngData.lngWidth ) ).offset( !strTwrData.orientation.yDir().opposite(), 50mm ).offset( !strTwrData.orientation.yDir(), 0.5 * !strLngData.lngLength )
    !topPosR  = !topPosL.offset( U, !upPos[1].real() ).offset( !strTwrData.orientation.yDir().opposite(), 0.5 * !strLngData.lngLength )
    !dimObj   = object DISPLAYDIMENSION(!label, !strTwrData.orientation.yDir().opposite(), !topPosL, !topPosR, !strTwrData.xLength * 0.15, !aidDim)
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      showDimStrFlt
--
-- Description: shows dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showDimStrFlt()

  -- first remove all dimension
  !!aslCentralData.clearFeedback('AIDDIM')

  -- get information about the stair flight
  !strTwrData     = !this.strTwrData
  !strLngData     = !this.strTwrData.tieBeamProfile.meStrLngEngine.strLngData
  !upPos          = !this.getFflLevelStrTwr()
  !strTwrDim      = !this.strTwrDim
  !aidDim         = !!aslCentralData.aidDim
  !topPos         = !strTwrData.position.offset(UP, !strTwrData.zLength)
  !position       = !strTwrData.position
  !senSe          = !this.strTwrData.clockwise
  !prmDir         = !this.strTwrData.prmDirection

  --update based on the senSe
  if ( !senSe.eq(true) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U).opposite()
    !prmDir2 = !prmDir.orthogonal(U)
  elseif ( !senSe.eq(false) ) then
    --manipulation for the first level
    !prmDir1 = !prmDir.orthogonal(U)
    !prmDir2 = !prmDir.orthogonal(U).opposite()
  endif

  if ( !strTwrDim.strFltWidth ) then
    !label    = 'Stair Flight Width =' & !strTwrData.fltWidth
    !topPosL  = !strTwrData.strFltPos[1][1].position.offset(!prmDir1, !strTwrData.fltWidth / 2 )
    !topPosR  = !topPosL.offset( !prmDir2, ( !strTwrData.fltWidth ) )
    !dimObj   = object DISPLAYDIMENSION( !label, !prmDir , !topPosL, !topPosR, !strTwrData.fltClXSpacing * 0.2, !aidDim)
  endif

  if ( !strTwrDim.fltClXSpacing ) then
    !label    = 'Stair Flight CL (X) Spacing =' & !strTwrData.fltClXSpacing
    !topPosL1 = !position.offset(!prmDir.opposite(), ( !strTwrData.fltClYSpacing / 2 ) ).offset( U, !strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk )
    !topPosL  = !topPosL1.offset(!prmDir2, ( !strTwrData.fltClXSpacing / 2 ) ).offset( !prmDir.opposite(), ( !strLngData.lngLength + 100mm ) )
    !topPosR  = !topPosL.offset(!prmDir1, ( !strTwrData.fltClXSpacing ) )
    !dimObj   = object DISPLAYDIMENSION(!label, !prmDir.opposite() , !topPosL, !topPosR, !strTwrData.fltClXSpacing * 0.2, !aidDim)
  endif

  if ( !strTwrDim.fltClYSpacing ) then
    !label    = 'Stair Flight CL (Y) Spacing =' & !strTwrData.fltClYSpacing
    !topPosL1 = !position.offset(!prmDir2, ( !strTwrData.fltClXSpacing / 2 ) ).offset( U, !strTwrData.tieBeamProfile.meStrLngEngine.strLngData.lngThk )
    !topPosL  = !topPosL1.offset(!prmDir.opposite(), ( !strTwrData.fltClYSpacing / 2 ) ).offset( !prmDir2, ( !strLngData.lngWidth + 100mm ) )
    !topPosR  = !topPosL.offset(!prmDir, ( !strTwrData.fltClYSpacing ) )
    !dimObj   = object DISPLAYDIMENSION(!label, !prmDir2, !topPosL, !topPosR, !strTwrData.fltClYSpacing * 0.4, !aidDim)
  endif

endmethod
