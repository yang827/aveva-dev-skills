------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslStrTwrEngine()                -                   default constructor
--  dfltTempRef(DBREF,DBREF)         -                   sets the template reference
--  dfltTempRef(DBREF,DBREF,DBREF)   -                   sets the template reference
--  enhance()                        -                   enhances the element
--  getBeamLevelStrTwr()             ARRAY               returns the position
--  getCLXSpacing()                  REAL                returns the centre line x spacing
--  getCLYSpacing()                  REAL                returns the centre line y spacing
--  getClockwise()                   BOOLEAN             returns the senSe
--  getDeckLevelStrWay()             ARRAY               returns the position
--  getDefaults()                    -                   returns the Defaults for the stair tower data
--  getError()                       BOOLEAN             returns the error status
--  getFThickness()                  REAL                returns the thickness of the stair flight
--  getFflLevelStrTwr()              ARRAY
--  getFltCLXSpacing()               REAL                returns the flight centre line X spacing
--  getFltCLYSpacing()               REAL                returns the flight centre line Y spacing
--  getFltWidth()                    REAL                returns the flight centre line Y spacing
--  getHandRaTmplReference()         DBREF               returns the reference to the central template for handrails
--  getInstallationOption()          STRING              sets the installation option
--  getInstallationOptions()         ARRAY               returns all allowed installation options
--  getOrientation()                 ORIENTATION         returns the orientation
--  getPosition()                    POSITION            returns the position
--  getRefe()                        DBREF               returns the reference of the stair tower
--  getSettingReference()            STRING              returns the setting
--  getStrFltTmplReference()         DBREF               returns the reference to the central template for  stair flight
--  getStrLngThk()                   REAL                returns the thickness of the strlng
--  getStrLngTmplReference()         DBREF               returns the reference to the central template for intermediate landings
--  getStrLngWidth()                 REAL                returns the width of the stair landing
--  getStrlngLength()                REAL                returns the length of the stair landing
--  getXLength()                     REAL                returns the xLength of the stair tower
--  getYLength()                     REAL                returns the yLength of the stair tower
--  getZLength()                     REAL                returns the zlength of the stair tower
--  mergeCriteria()                  -                   merges central standard with fabricator standard
--  newBeamLevel(REAL)               -                   adds a new Beam Level
--  newDeckLevel(REAL)               -                   adds a new Deck Level
--  newDeckProfile(PROFILE)          -                   adds a new Deck profile
--  newFflLevel(REAL)                -                   adds a new ffl Level
--  pickPosition()                   -                   Setup EDG pick event for picking position
--  position(EDGPOSITIONDATA)        -                   Set position
--  position(POSITION)               -                   Set position
--  remBeamLevel(ARRAY)              -                   removes a Beam detail
--  remDeckLevel(ARRAY)              -                   removes a Deck detail
--  remDeckProfile(ARRAY)            -                   removes a Deck detail
--  remFflLevel(ARRAY)               -                   removes a landing detail
--  replaceBeamLevel(REAL,REAL)      -                   replaces an existing beam level by a new one
--  replaceDeckLevel(REAL,REAL)      -                   replaces an existing Deck level by a new one
--  replaceDeckProfile(PROFILE,REAL) -                   replaces an existing Deck profile by a new one
--  replaceFflLevel(REAL,REAL)       -                   replaces an existing FFL level by a new one
--  resetError()                     -                   resets error status
--  setCLXSpacing(REAL)              -                   sets the centre line x spacing
--  setCLYSpacing(REAL)              -                   sets the centre line y spacing
--  setClockwise(BOOLEAN)            -                   sets the senSe
--  setFflLevelStrTwr()              -
--  setFltCLXSpacing(REAL)           -                   sets the centre line x spacing
--  setFltCLYSpacing(REAL)           -                   sets the centre line x spacing
--  setFltWidth(REAL)                -                   sets the flight spacing
--  setHandraReferences(DBREF)       -                   sets the Handrail template references
--  setInstallationOption(STRING)    -                   sets the installation option
--  setOrientation(ORIENTATION)      -                   sets the orientation
--  setPosition(POSITION)            -                   sets the position
--  setSettingReference()            -                   sets the setting
--  setStrFltReferences(DBREF)       -                   sets the Handrail template references
--  setStrLngTemplateReferences(DBREF) -
--  setStrLngThk(REAL)               -                   sets the thickness of the stair landing
--  setStrLngWidth(REAL)             -                   sets the width of the stair landing
--  setStrlngLength(REAL)            -                   sets the length of the stair landing
--  setTmplReferences(DBREF,DBREF)   -                   sets the template references
--  setTmplReferences(DBREF,DBREF,DBREF) -                   sets the template references
--  setXLength(REAL)                 -                   sets the xLength of the stair tower
--  setYLength(REAL)                 -                   sets the yLength of the stair tower
--  setZLength(REAL)                 -                   sets the zlength of the stair tower
--  showDimStrFlt()                  -                   shows dimension
--  showDimStrLng()                  -                   shows dimension
--  showDimTwrStl()                  -                   shows dimension
--  unEnhance()                      -                   unEnhance the element
--  updateDB()                       -                   update the db with the form settings
--  updateDataObj(DBREF)             -                   reads the ladder data
--  updateStrFltDB()                 -                   create the stair flight
--  updateStrFltObject()             -                   calculate the position for the stair flight and
--  updateStrWayFltObject()          -                   calculate the position for the stair flight and
--

-- Define object
define object ASLSTRTWRENGINE

  -- public members
  ---------------------------------------------------------------------------
  -- contains the criteria set for handrail elements (including fabricator standard)
  member .handRaCriteria      is ASLHANDRACRITERIA

  -- contains the criteria set for handrail elements (excluding fabricator standard)
  member .handRaCriteriaBasis is ASLHANDRACRITERIA

  -- container for stair tower criteria (including fabricator standard)
  member .strTwrCriteria      is ASLSTRTWRCRITERIA

  -- container for basis stair tower criteria (excluding fabricator standard)
  member .strTwrCriteriaBasis is ASLSTRTWRCRITERIA

  -- container for stair flight criteria (including fabricator standard)
  member .strFltCriteria      is ASLSTRFLTCRITERIA

  -- container for basis stair flight criteria (excluding fabricator standard)
  member .strFltCriteriaBasis is ASLSTRFLTCRITERIA

  -- container for stair landing criteria (including fabricator standard)
  member .strLngCriteria      is ASLSTRLNGCRITERIA

  -- container for basis stair landing criteria (excluding fabricator standard)
  member .strLngCriteriaBasis is ASLSTRLNGCRITERIA

  -- container for stair tower data
  member .strTwrData          is ASLSTRTWRDATA

  -- container for the stair tower dimension flags
  member .strTwrDim           is ASLSTRTWRDIM

  -- EDG Description
  member .edgDescription    is STRING

endobject
-- End of object definition for aslStrTwrEngine

------------------------------------------------------------------------
--
-- Method:      aslStrTwrEngine
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslStrTwrEngine()

  -- EDG Description
  !this.edgDescription    = 'Stair Tower Definition'

  -- sets the criteria
  !this.mergeCriteria()

  -- sets the reference to the central template
  !this.setSettingReference()

endmethod
