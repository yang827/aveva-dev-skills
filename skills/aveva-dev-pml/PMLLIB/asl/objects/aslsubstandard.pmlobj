-- File:            aslsubstandard.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        DESIGN
--   Replaces:
-- Author:          Lars Leppin
-- Created:         Tue Aug 1 09:00:00 GMT 2006
--
--
-- Description:     container for asl substandard data (like STRFLT or STRTRD data)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslSubStandard()                 -                   Constructor
--  string()                         STRING              Returns object name or object type if unset
--

-- Define object
define object ASLSUBSTANDARD

  -- true if the substandard is prepared to delete
  member .deleteFlag   is BOOLEAN

  -- name of the substandard
  member .name               is STRING

  -- Description of the substandard
  member .description  			 is STRING

  --
  member .refe         is DBREF

  -- container of handrail standard data
  member .aslHandRaCriteria   is ASLHANDRACRITERIA

  -- container of ladder standard data
  member .aslLadderCriteria   is ASLLADDERCRITERIA

  -- container of pipe bridge standard data
--TODO: activates aslPipeBDGCriteria
--  member .aslPipeBDGCriteria is ASLPIPEBDGCRITERIA

  -- container of platform standard data
  member .aslPltFrmCriteria  is ASLPLTFRMCRITERIA

  -- container of stair flight standard data
  member .aslStrFltCriteria  is ASLSTRFLTCRITERIA

  -- container of stair landing standard data
--TODO: activates aslStrLngCriteria
  member .aslStrLngCriteria  is ASLSTRLNGCRITERIA

  -- container of stair tower standard data
  member .aslStrTwrCriteria  is ASLSTRTWRCRITERIA

  -- container of walkway standard data
--  member .aslWWayCriteria    is ASLWWAYCRITERIA

endobject
-- End of object definition for aslSubStandard

------------------------------------------------------------------------
--
-- Method:      aslSubStandard
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslSubStandard()

  -- inits the delete status
  !this.deleteFlag = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      string
--
-- Description: Returns object name or object type if unset
--
-- Method Type: Function
-- Arguments:
-- Return:
--   [Data Type] [Description]
--    STRING      Returned string
------------------------------------------------------------------------

define method .string() is STRING

  if !this.name.unset() then
     return !this.objectType()
  else
     return !this.name
  endif

endmethod
-- end of method
