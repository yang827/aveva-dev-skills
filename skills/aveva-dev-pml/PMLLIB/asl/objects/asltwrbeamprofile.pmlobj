--
--   Description:
--    Object for handling Tower Steel Beam Creation definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslTwrBeamProfile()              -                   Constructor
--  connect(DBREF)                   -                   connect the Section to establish connections
--  disConnect(DBREF)                -
--  updateBeamProfileAids(DIRECTION,REAL,POSITION) -                   updates the column details aids
--  updateBeamProfileData(DIRECTION,POSITION,REAL,REAL,REAL,ARRAY) -
--  updateBeamProfileDb(DBREF)       -                   updates the beam details in database
--  updateDataObj(DBREF)             -                   reads the values from the end STRLNG
--  updateFflProfileAids(PROFILE)    -                   updates the column details aids
--  updateStrLngDB()                 -
--  updateTieBeamProfileData(ARRAY)  -                   updates the Tie beam details
--


define object ASLTWRBEAMPROFILE

  --position definition for points in the gensec spines
  member .startPosition          is ARRAY
  member .endPosition            is ARRAY

  --catalogue details
  member .sprefSteelBeam         is STRING
  member .sprefSteelTieUp        is STRING

  member .bPLineJustification    is STRING
  member .tPLineJustification    is STRING

  --direction detail for orientation
  member .yDirSpine              is DIRECTION

  --beam profile
  member .twrStlBeamProfile      is ARRAY

  --tie-up beam profile
  member .twrStlTieBeamProfile   is ARRAY

  --landing engine
  member .meStrLngEngine         is ASLSTRLNGENGINE

---------------------------------------------------------------------------
  -- Members for connecting sections
  member .twrStlColRefe                   is ARRAY
  member .twrStlGensecRefe                is ARRAY
  member .twrStlBeamRefe                  is ARRAY

endobject

------------------------------------------------------------------------
--
-- Method:     aslTwrBeamProfile
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslTwrBeamProfile()

  -- Initialise Spec (catalogue) Variables
  !this.sprefSteelBeam      = 'BS-SPEC/203x133x30kg/m'
  !this.sprefSteelTieUp     = 'BS-SPEC/203x133x30kg/m'

  --Initialise justification Variables
  !this.bPLineJustification = 'TOS'
  !this.tPLineJustification = 'TOS'

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: reads the values from the end STRLNG
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type]    [Description]
--    1     R     DBREF        reference element
--
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  -- evaluates the panel tower Steel
  var !resTwrStlTieup coll all TWRSTL with PURP eq |BEAM| for $!refe

  if ( !resTwrStlTieup.set() ) then
    -- set the general attributes
    !!ce = !resTwrStlTieup[1].dbref()
    var !resGensec coll all with (type eq |GENSEC| and PURP eq |ASL|) for ce
    if ( !resGensec.set() ) then
      !!ce = !resGensec[1].dbref()
    endif
    !!aslStrTwr.profileSectB.val = !!ce.spref.flnm.after('/')
    !!aslStrTwr.profileJustB.val = !!ce.jusLine
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateBeamProfileData
--
-- Description: updates the beam details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateBeamProfileData(!prmDir is DIRECTION, !pos is POSITION, !xlen is REAL, !ylen is REAL, !zlen is REAL, !beamLevelElev is ARRAY )

  --initialise the variable
  !this.twrStlBeamProfile = object ARRAY()
  !!fmsys.setProgress(90)
  --manipulation for the first column
  do !i values !beamLevelElev

    !newTwrStlBeamProfile                     = object ASLTWRBEAMPROFILE()

    --manipulation for the first beam
    !newTwrStlBeamProfile.sprefSteelBeam      = !this.sprefSteelBeam
    !newTwrStlBeamProfile.bPLineJustification = !this.bPLineJustification
    !newTwrStlBeamProfile.yDirSpine           = U

    !newTwrStlBeamProfile.startPosition.append( !pos.offset( !prmDir.orthogonal(U), !xlen / 2 ).offset( !prmDir.opposite() , !ylen / 2 ).offset( U , object REAL (!i[2], !!distanceFmt) ) )
    !newTwrStlBeamProfile.endPosition.append( !newTwrStlBeamProfile.startPosition[1].offset( !prmDir , !ylen ) )

    --manipulation for the second beam
    !newTwrStlBeamProfile.startPosition.append( !newTwrStlBeamProfile.endPosition[1] )
    !newTwrStlBeamProfile.endPosition.append( !newTwrStlBeamProfile.startPosition[2].offset( !prmDir.orthogonal(U).opposite() , !xlen ) )

    --manipulation for the third beam
    !newTwrStlBeamProfile.startPosition.append( !newTwrStlBeamProfile.endPosition[2] )
    !newTwrStlBeamProfile.endPosition.append( !newTwrStlBeamProfile.startPosition[3].offset( !prmDir.opposite() , !ylen ) )

    --manipulation for the fourth column
    !newTwrStlBeamProfile.startPosition.append( !newTwrStlBeamProfile.endPosition[3] )
    !newTwrStlBeamProfile.endPosition.append(!newTwrStlBeamProfile.startPosition[1] )

    !this.twrStlBeamProfile.append(!newTwrStlBeamProfile)

  enddo

  if ( !beamLevelElev.empty().not() ) then
    -- update the aid graphics
    !this.updateBeamProfileAids(!prmDir, !xlen, !pos)
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateTieBeamProfileData
--
-- Description: updates the Tie beam details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateTieBeamProfileData(!data is ARRAY)

  --values
  !ori          = Y is $!data[1]
  !prmDir       = !data[1]
  !pos          = !data[2]
  !xlen         = !data[3]
  !ylen         = !data[4]
  !zlen         = !data[5]
  !senSe        = !data[6]
  !installOpt   = !data[7]
  !lngWidth     = !data[8]
  !lngLength    = !data[9]
  !fflLevelElev = !data[10]

  --initialise the variable
  !this.twrStlTieBeamProfile = object ARRAY()
  !this.meStrLngEngine.strLngData.lngProfile = object ARRAY()

  if ( !installOpt eq  'Two stairs, platform north and south' ) then
    --update the alternate landings ( from 1...by step 2)
    do !i from 1 to !fflLevelElev.size() by 2
      !newTwrStlTieBeamProfile                     = object ASLTWRBEAMPROFILE()
      --manipulation for the first beam
      !newTwrStlTieBeamProfile.sprefSteelTieUp     = !this.sprefSteelTieUp
      !newTwrStlTieBeamProfile.tPLineJustification = !this.tPLineJustification
      !newTwrStlTieBeamProfile.yDirSpine           = U

      !linesArray = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir.orthogonal(U), !xlen / 2 ).offset( !prmDir.opposite() , ( !ylen / 2 )- !lngLength ).offset( U, !fflLevelElev[!i] )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.orthogonal(U).opposite() , !xlen )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[1].endPosition
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), !lngLength )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[2].endPosition
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.orthogonal(U), !xlen )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[3].endPosition
      !line1.endPosition   = !linesArray[1].startPosition
      !linesArray.append(!line1)

      !profileData = object PROFILE()
      !position = !pos.offset( U, !fflLevelElev[!i] )
      !profileData = object PROFILE( !position, !ori, !linesArray )

      --update the landing engine and Data
      !this.meStrLngEngine.strLngData.lngProfile.append(!profileData)

      --draw the profile graphics
      !this.updateFflProfileAids(!profileData)

      --update the member
      !newTwrStlTieBeamProfile.startPosition.append( !pos.offset( !prmDir.orthogonal(U), !xlen / 2 ).offset( !prmDir.opposite() , ( !ylen / 2 )- !lngWidth ).offset( U, !fflLevelElev[!i] ) )
      !newTwrStlTieBeamProfile.endPosition.append( !newTwrStlTieBeamProfile.startPosition[1].offset( !prmDir.orthogonal(U).opposite() , !xlen ) )
      !!fmsys.setProgress( ( !i * 2 ) + 20)
     --update the member
      !this.twrStlTieBeamProfile.append(!newTwrStlTieBeamProfile)
    enddo

    --update the alternate landings ( from 2...by step 2)
    do !i from 2 to !fflLevelElev.size() by 2
      !newTwrStlTieBeamProfile                     = object ASLTWRBEAMPROFILE()
      --manipulation for the first beam
      !newTwrStlTieBeamProfile.sprefSteelTieUp     = !this.sprefSteelTieUp
      !newTwrStlTieBeamProfile.tPLineJustification = !this.tPLineJustification
      !newTwrStlTieBeamProfile.yDirSpine           = U

      !linesArray = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir.orthogonal(U), !xlen / 2 ).offset( !prmDir, ( !ylen / 2 ) - !lngLength ).offset( U, !fflLevelElev[!i] )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.orthogonal(U).opposite() , !xlen )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[1].endPosition
      !line1.endPosition   = !line1.startPosition.offset( !prmDir, !lngLength )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[2].endPosition
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.orthogonal(U), !xlen )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[3].endPosition
      !line1.endPosition   = !linesArray[1].startPosition
      !linesArray.append(!line1)

      --create a profile
      !profileData = object PROFILE()
      !position = !pos.offset( U, !fflLevelElev[!i] )
      !profileData = object PROFILE( !position, !ori, !linesArray )

      --update the landing engine and Data
      !this.meStrLngEngine.strLngData.lngProfile.append(!profileData)

      --draw the profile graphics
      !this.updateFflProfileAids(!profileData)

      --update the member
      !newTwrStlTieBeamProfile.startPosition.append( !pos.offset( !prmDir.orthogonal(U), !xlen / 2 ).offset( !prmDir, ( !ylen / 2 ) - !lngWidth ).offset( U, !fflLevelElev[!i] ) )
      !newTwrStlTieBeamProfile.endPosition.append( !newTwrStlTieBeamProfile.startPosition[1].offset( !prmDir.orthogonal(U).opposite() , !xlen ) )
      !!fmsys.setProgress( ( !i * 3 ) + 40)
      --update the member
      !this.twrStlTieBeamProfile.append(!newTwrStlTieBeamProfile)
    enddo

  elseif ( !installOpt eq  'One stair, stair north' ) then

    do !i from 1 to !fflLevelElev.size()
      !newTwrStlTieBeamProfile                     = object ASLTWRBEAMPROFILE()
      --general tie beam Data
      !newTwrStlTieBeamProfile.sprefSteelTieUp     = !this.sprefSteelTieUp
      !newTwrStlTieBeamProfile.tPLineJustification = !this.tPLineJustification
      !newTwrStlTieBeamProfile.yDirSpine           = U

      !linesArray = object ARRAY()
      !line1 = object LINE()
      !line1.startPosition = !pos.offset( !prmDir, !ylen / 2 ).offset( !prmDir.orthogonal(U).opposite(), ( ( !xlen / 2 ) - !lngWidth ) ).offset( U, !fflLevelElev[!i] )
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), ( !ylen - !lngLength ) )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[1].endPosition
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.orthogonal(U), ( !xlen - ( 2 * !lngWidth ) ) )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[2].endPosition
      !line1.endPosition   = !line1.startPosition.offset( !prmDir, ( !ylen - !lngLength ) )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[3].endPosition
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.orthogonal(U), !lngWidth )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[4].endPosition
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.opposite(), !ylen )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[5].endPosition
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.orthogonal(U).opposite(), !xlen )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[6].endPosition
      !line1.endPosition   = !line1.startPosition.offset( !prmDir, !ylen )
      !linesArray.append(!line1)

      !line1 = object LINE()
      !line1.startPosition = !linesArray[7].endPosition
      !line1.endPosition   = !line1.startPosition.offset( !prmDir.orthogonal(U), !lngWidth )
      !linesArray.append(!line1)

      --create a profile
      !profileData = object PROFILE()
      !position = !pos.offset( U, !fflLevelElev[!i] )
      !profileData = object PROFILE( !position, !ori, !linesArray )

      --update the landing engine and Data
      !this.meStrLngEngine.strLngData.lngProfile.append(!profileData)

      --draw the profile graphics
      !this.updateFflProfileAids(!profileData)

      --manipulation for the beam running from Primary direction to its opposite side on orthogonal(U)[Beam 1]
      !newTwrStlTieBeamProfile.startPosition.append( !pos.offset( !prmDir, !ylen / 2 ).offset( !prmDir.orthogonal(U).opposite(), ( ( !xlen / 2 ) - !lngWidth ) ).offset( U, !fflLevelElev[!i] ) )
      !newTwrStlTieBeamProfile.endPosition.append( !newTwrStlTieBeamProfile.startPosition[1].offset( !prmDir.opposite(), !ylen ) )

      !newTwrStlTieBeamProfile.startPosition.append( !newTwrStlTieBeamProfile.endPosition[1].offset( !prmDir, !lngWidth ) )
      !newTwrStlTieBeamProfile.endPosition.append( !newTwrStlTieBeamProfile.startPosition[2].offset( !prmDir.orthogonal(U), ( !xlen - ( 2 * !lngWidth ) ) ) )

      !newTwrStlTieBeamProfile.startPosition.append( !newTwrStlTieBeamProfile.endPosition[2].offset( !prmDir.opposite(), !lngWidth ) )
      !newTwrStlTieBeamProfile.endPosition.append( !newTwrStlTieBeamProfile.startPosition[3].offset( !prmDir, !ylen ) )

      --update the member
      !this.twrStlTieBeamProfile.append(!newTwrStlTieBeamProfile)
      !!fmsys.setProgress( ( !i * 3 ) + 30)
    enddo

  elseif ( !installOpt eq  'Four stairs' ) then

    --update based on the sense
    if ( !senSe.eq(true) ) then
      --manipulation for the first level
      !angle = -90
      !prmDir1 = !prmDir.orthogonal(U).opposite()
      !prmDir2 = !prmDir.orthogonal(U)
    elseif ( !senSe.eq(false) ) then
      --manipulation for the first level
      !angle = 90
      !prmDir1 = !prmDir.orthogonal(U)
      !prmDir2 = !prmDir.orthogonal(U).opposite()
    endif

    --line 1
    !linesLevel = object ARRAY()
    !line = object LINE()
    !line.startPosition = !pos.offset( !prmDir.opposite(), !ylen / 2 ).offset( !prmDir1, ( ( !xlen / 2 ) - !lngWidth ) )
    !line.endPosition   = !line.startPosition.offset( !prmDir, !lngLength )
    !linesLevel.append(!line)

    --line 2
    !line = object LINE()
    !line.startPosition = !linesLevel[1].endPosition
    !line.endPosition   = !line.startPosition.offset( !prmDir1, !lngWidth )
    !linesLevel.append(!line)

    --line 3
    !line = object LINE()
    !line.startPosition = !linesLevel[2].endPosition
    !line.endPosition   = !line.startPosition.offset( !prmDir.opposite(), !lngLength )
    !linesLevel.append(!line)

    --line 4
    !line = object LINE()
    !line.startPosition = !linesLevel[3].endPosition
    !line.endPosition   = !line.startPosition.offset( !prmDir2, !lngWidth )
    !linesLevel.append(!line)

    --create a profile
    !profileData1 = object PROFILE( !pos, !ori, !linesLevel )

    --find out consecutive level by 4
    !j = 1
    do !i from 1 to !fflLevelElev.size() by 4
      !newTwrStlTieBeamProfile                     = object ASLTWRBEAMPROFILE()
      --general tie beam Data
      !newTwrStlTieBeamProfile.sprefSteelTieUp     = !this.sprefSteelTieUp
      !newTwrStlTieBeamProfile.tPLineJustification = !this.tPLineJustification
      !newTwrStlTieBeamProfile.yDirSpine           = U

      --create a profile
      !profileData = object PROFILE()
      !profileData = !profileData1
      !profileData.position = !pos.offset( U, !fflLevelElev[!i] )

      --update the landing engine and Data
      !this.meStrLngEngine.strLngData.lngProfile.append(!profileData)

      --draw the profile graphics
      !this.updateFflProfileAids(!profileData)

      !positionData = object ARRAY()
      !positionData = !profileData.edges()

      !newTwrStlTieBeamProfile.startPosition.append(!positionData[1].startPosition)
      !newTwrStlTieBeamProfile.startPosition.append(!positionData[2].startPosition)

      !newTwrStlTieBeamProfile.endPosition.append(!positionData[1].endPosition)
      !newTwrStlTieBeamProfile.endPosition.append(!positionData[2].endPosition)
      !!fmsys.setProgress( ( !i * 1.25 ) + 20)
      --update the member
      !this.twrStlTieBeamProfile.append(!newTwrStlTieBeamProfile)
      !j = !j + 1
    enddo

    --find out the second levels based on the first level and consecutive level by 4
    !j = 1
    do !i from 2 to !fflLevelElev.size() by 4
      !newTwrStlTieBeamProfile                     = object ASLTWRBEAMPROFILE()
      --general tie beam Data
      !newTwrStlTieBeamProfile.sprefSteelTieUp     = !this.sprefSteelTieUp
      !newTwrStlTieBeamProfile.tPLineJustification = !this.tPLineJustification
      !newTwrStlTieBeamProfile.yDirSpine           = U

      --create a profile
      !profileData = object PROFILE()
      !profileData = !profileData1
      !profileData.position = !pos.offset( U, !fflLevelElev[!i] ).offset( !prmDir, ( !ylen - !lngLength ) )

      --update the landing engine and Data
      !this.meStrLngEngine.strLngData.lngProfile.append(!profileData)

      --draw the profile graphics
      !this.updateFflProfileAids(!profileData)

      !positionData = object ARRAY()
      !positionData = !profileData.edges()

      !newTwrStlTieBeamProfile.startPosition.append(!positionData[1].startPosition)
      !newTwrStlTieBeamProfile.startPosition.append(!positionData[2].startPosition)

      !newTwrStlTieBeamProfile.endPosition.append(!positionData[1].endPosition)
      !newTwrStlTieBeamProfile.endPosition.append(!positionData[2].endPosition)
      !!fmsys.setProgress( ( !i * 1.25 ) + 35)
      --update the member
      !this.twrStlTieBeamProfile.append(!newTwrStlTieBeamProfile)
      !j = !j + 1
    enddo

    --find out the third levels based on the first level and consecutive level by 4
    !j = 1
    do !i from 3 to !fflLevelElev.size() by 4
      !newTwrStlTieBeamProfile                     = object ASLTWRBEAMPROFILE()
      --general tie beam Data
      !newTwrStlTieBeamProfile.sprefSteelTieUp     = !this.sprefSteelTieUp
      !newTwrStlTieBeamProfile.tPLineJustification = !this.tPLineJustification
      !newTwrStlTieBeamProfile.yDirSpine           = U

      --create a profile
      !profileData = object PROFILE()
      !profileData = !profileData1
      !profileData.position = !pos.offset( U, !fflLevelElev[!i] ).offset( !prmDir, ( !ylen - !lngLength ) ).offset( !prmDir2, ( !xlen - !lngWidth ) )

      --update the landing engine and Data
      !this.meStrLngEngine.strLngData.lngProfile.append(!profileData)

      --draw the profile graphics
      !this.updateFflProfileAids(!profileData)


      !positionData = object ARRAY()
      !positionData = !profileData.edges()

      !newTwrStlTieBeamProfile.startPosition.append(!positionData[1].startPosition)
      !newTwrStlTieBeamProfile.startPosition.append(!positionData[2].startPosition)

      !newTwrStlTieBeamProfile.endPosition.append(!positionData[1].endPosition)
      !newTwrStlTieBeamProfile.endPosition.append(!positionData[2].endPosition)
      !!fmsys.setProgress( ( !i * 1.25 ) + 45)
      --update the member
      !this.twrStlTieBeamProfile.append(!newTwrStlTieBeamProfile)
      !j = !j + 1
    enddo

    --find out the fourth levels based on the first level and consecutive level by 4
    !j = 1
    do !i from 4 to !fflLevelElev.size() by 4
      !newTwrStlTieBeamProfile                     = object ASLTWRBEAMPROFILE()
      --general tie beam Data
      !newTwrStlTieBeamProfile.sprefSteelTieUp     = !this.sprefSteelTieUp
      !newTwrStlTieBeamProfile.tPLineJustification = !this.tPLineJustification
      !newTwrStlTieBeamProfile.yDirSpine           = U

      --create a profile
      !profileData = object PROFILE()
      !profileData = !profileData1
      !profPosition = !pos.offset( U, !fflLevelElev[!i] )
      !profileData.position = !profPosition.offset( !prmDir2, ( !xlen - !lngWidth ) )

      --update the landing engine and Data
      !this.meStrLngEngine.strLngData.lngProfile.append(!profileData)

      --draw the profile graphics
      !this.updateFflProfileAids(!profileData)

      !positionData = object ARRAY()
      !positionData = !profileData.edges()

      !newTwrStlTieBeamProfile.startPosition.append(!positionData[1].startPosition)
      !newTwrStlTieBeamProfile.startPosition.append(!positionData[2].startPosition)

      !newTwrStlTieBeamProfile.endPosition.append(!positionData[1].endPosition)
      !newTwrStlTieBeamProfile.endPosition.append(!positionData[2].endPosition)
      !!fmsys.setProgress( ( !i * 1.5 ) + 60)
      --update the member
      !this.twrStlTieBeamProfile.append(!newTwrStlTieBeamProfile)
      !j = !j + 1
    enddo

  elseif ( !installOpt.eq( 'Three stairs, platform south' ) ) then
    --update the alternate landings ( from 1...by step 3)
    do !i from 1 to !fflLevelElev.size() by 3
      !newTwrStlTieBeamProfile                     = object ASLTWRBEAMPROFILE()
      --manipulation for the first beam
      !newTwrStlTieBeamProfile.sprefSteelTieUp     = !this.sprefSteelTieUp
      !newTwrStlTieBeamProfile.tPLineJustification = !this.tPLineJustification
      !newTwrStlTieBeamProfile.yDirSpine           = U

      --line 1
      !linesLevel = object ARRAY()
      !line = object LINE()
      !line.startPosition = !pos.offset( !prmDir.orthogonal(U), !xlen / 2 ).offset( !prmDir.opposite() , ( ( !ylen / 2 ) - !lngLength ) ).offset( U, !fflLevelElev[!i] )
      !line.endPosition   = !line.startPosition.offset( !prmDir.orthogonal(U).opposite() , !xlen )
      !linesLevel.append(!line)

      --line 2
      !line = object LINE()
      !line.startPosition = !linesLevel[1].endPosition
      !line.endPosition   = !line.startPosition.offset( !prmDir.opposite(), !lngLength )
      !linesLevel.append(!line)

      --line 3
      !line = object LINE()
      !line.startPosition = !linesLevel[2].endPosition
      !line.endPosition   = !line.startPosition.offset( !prmDir.orthogonal(U), !xlen )
      !linesLevel.append(!line)

      --line 4
      !line = object LINE()
      !line.startPosition = !linesLevel[3].endPosition
      !line.endPosition   = !line.startPosition.offset( !prmDir, !lngLength )
      !linesLevel.append(!line)

      --create a profile
      !profileData = object PROFILE()
      !position = !pos.offset( U, !fflLevelElev[!i] )
      !profileData = object PROFILE( !position, !ori, !linesLevel )

      --update the landing engine and Data
      !this.meStrLngEngine.strLngData.lngProfile.append(!profileData)

      --draw the profile graphics
      !this.updateFflProfileAids(!profileData)

      !newTwrStlTieBeamProfile.startPosition.append( !pos.offset( !prmDir.orthogonal(U), !xlen / 2 ).offset( !prmDir.opposite() , ( ( !ylen / 2 ) - !lngWidth ) ).offset( U, !fflLevelElev[!i] ) )
      !newTwrStlTieBeamProfile.endPosition.append( !newTwrStlTieBeamProfile.startPosition[1].offset( !prmDir.orthogonal(U).opposite() , !xlen ) )
      !!fmsys.setProgress( ( !i * 1.5 ) + 20)
      --update the member
      !this.twrStlTieBeamProfile.append(!newTwrStlTieBeamProfile)
    enddo

    --update based on the sense
    if ( !senSe.eq(true) ) then
      --manipulation for the first level
      !prmDir1 = !prmDir.orthogonal(U).opposite()
      !prmDir2 = !prmDir.orthogonal(U)
    elseif ( !senSe.eq(false) ) then
      --manipulation for the first level
      !prmDir1 = !prmDir.orthogonal(U)
      !prmDir2 = !prmDir.orthogonal(U).opposite()
    endif
    --update the alternate landings ( from 2...by step 3)
    do !j from 2 to !fflLevelElev.size() by 3
      --line 1
      !linesLevel = object ARRAY()
      !line = object LINE()
      !line.startPosition = !pos.offset( !prmDir, !ylen / 2 ).offset( !prmDir1, ( ( !xlen / 2 ) - !lngWidth ) )
      !line.endPosition   = !line.startPosition.offset( !prmDir.opposite(), !lngLength )
      !linesLevel.append(!line)

      --line 2
      !line = object LINE()
      !line.startPosition = !linesLevel[1].endPosition
      !line.endPosition   = !line.startPosition.offset( !prmDir1, !lngWidth )
      !linesLevel.append(!line)

      --line 3
      !line = object LINE()
      !line.startPosition = !linesLevel[2].endPosition
      !line.endPosition   = !line.startPosition.offset( !prmDir, !lngLength )
      !linesLevel.append(!line)

      --line 4
      !line = object LINE()
      !line.startPosition = !linesLevel[3].endPosition
      !line.endPosition   = !line.startPosition.offset( !prmDir2, !lngWidth )
      !linesLevel.append(!line)

      --create a profile
      !position = !pos.offset( U, !fflLevelElev[!j] )
      !profileData = object PROFILE( !position, !ori, !linesLevel )

      --update the landing engine and Data
      !this.meStrLngEngine.strLngData.lngProfile.append(!profileData)

      --draw the profile graphics
      !this.updateFflProfileAids(!profileData)

      !newTwrStlTieBeamProfile                     = object ASLTWRBEAMPROFILE()
      --general tie beam Data
      !newTwrStlTieBeamProfile.sprefSteelTieUp     = !this.sprefSteelTieUp
      !newTwrStlTieBeamProfile.tPLineJustification = !this.tPLineJustification
      !newTwrStlTieBeamProfile.yDirSpine           = U

      !positionData = object ARRAY()
      !positionData = !profileData.edges()

      --get the position details
      !newTwrStlTieBeamProfile.startPosition.append(!positionData[1].startPosition)
      !newTwrStlTieBeamProfile.startPosition.append(!positionData[2].startPosition)

      !newTwrStlTieBeamProfile.endPosition.append(!positionData[1].endPosition)
      !newTwrStlTieBeamProfile.endPosition.append(!positionData[2].endPosition)
      !!fmsys.setProgress( ( !i * 1.5 ) + 35)
      --update the member
      !this.twrStlTieBeamProfile.append(!newTwrStlTieBeamProfile)

    enddo

    --update the alternate landings ( from 3...by step 3)
    do !j from 3 to !fflLevelElev.size() by 3
      --line 1
      !linesLevel = object ARRAY()
      !line = object LINE()
      !line.startPosition = !pos.offset( !prmDir, !ylen / 2 ).offset( !prmDir2, ( ( !xlen / 2 ) - !lngWidth ) )
      !line.endPosition   = !line.startPosition.offset( !prmDir.opposite(), !lngLength )
      !linesLevel.append(!line)

      --line 2
      !line = object LINE()
      !line.startPosition = !linesLevel[1].endPosition
      !line.endPosition   = !line.startPosition.offset( !prmDir2, !lngWidth )
      !linesLevel.append(!line)

      --line 3
      !line = object LINE()
      !line.startPosition = !linesLevel[2].endPosition
      !line.endPosition   = !line.startPosition.offset( !prmDir, !lngLength )
      !linesLevel.append(!line)

      --line 4
      !line = object LINE()
      !line.startPosition = !linesLevel[3].endPosition
      !line.endPosition   = !line.startPosition.offset( !prmDir1, !lngWidth )
      !linesLevel.append(!line)

      --create a profile
      !position = !pos.offset( U, !fflLevelElev[!j] )
      !profileData = object PROFILE( !position, !ori, !linesLevel )

      --update the landing engine and Data
      !this.meStrLngEngine.strLngData.lngProfile.append(!profileData)

      --draw the profile graphics
      !this.updateFflProfileAids(!profileData)

      !newTwrStlTieBeamProfile                     = object ASLTWRBEAMPROFILE()
      --general tie beam Data
      !newTwrStlTieBeamProfile.sprefSteelTieUp     = !this.sprefSteelTieUp
      !newTwrStlTieBeamProfile.tPLineJustification = !this.tPLineJustification
      !newTwrStlTieBeamProfile.yDirSpine           = U

      !positionData = object ARRAY()
      !positionData = !profileData.edges()

      --get the position details
      !newTwrStlTieBeamProfile.startPosition.append(!positionData[1].startPosition)
      !newTwrStlTieBeamProfile.startPosition.append(!positionData[2].startPosition)

      !newTwrStlTieBeamProfile.endPosition.append(!positionData[1].endPosition)
      !newTwrStlTieBeamProfile.endPosition.append(!positionData[2].endPosition)
      !!fmsys.setProgress( ( !i * 1 ) + 50)
      --update the member
      !this.twrStlTieBeamProfile.append(!newTwrStlTieBeamProfile)

    enddo

  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateBeamProfileAids
--
-- Description: updates the column details aids
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateBeamProfileAids(!prmDir is DIRECTION, !xlen is REAL, !pos is POSITION)

  -- draws the beam profile frame
  ---------------------------------------------------------------------------
  do !i values !this.twrStlBeamProfile
    do !j index !i.startPosition
      !line               = object LINE()
      !line.startPosition = !i.startPosition[!j]
      !line.endPosition   = !i.endPosition[!j]
      !line.draw(!!aslCentralData.aidVolLineBeam, !!aslCentralData.lineStyleDashedThick, !!aslCentralData.colourSteelBeam)
    enddo

    !tempposUp    = !line.endPosition.up - !pos.up
    !posUp        = !tempposUp.string(!!distanceFmt)
    !position     = !pos.offset(!prmDir.orthogonal(U) , !xlen / 2 ).offset( U , object REAL (!posUp, !!distanceFmt) )
    AID TEXT NUMBER $!!<aslCentralData.aidVolLineBeam> (|Beam TOS $!posUp |) AT $!position
  enddo

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateFflProfileAids
--
-- Description: updates the column details aids
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateFflProfileAids(!profileData  is PROFILE)

  -- draws the beam profile frame
  ---------------------------------------------------------------------------
  !profileData.draw( !!aslCentralData.aidVolLineFfl, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourFflAid )
  !!fmsys.setProgress(0)
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateBeamProfileDb
--
-- Description: updates the beam details in database
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateBeamProfileDb(!reference is DBREF)
  !!fmsys.setProgress(60)
  --collecting the beams with purpose set to BEAM if exists
  !purpose = object EXPRESSION()
  !purpose.expression('PURP eq |BEAM|')

  !collection = object COLLECTION()
  !collection.scope(!reference)
  !collection.type('TWRSTL')
  !collection.filter(!purpose)
  !result = !collection.results()

  --initialise count
  !count = 0

  --if the collection for TWRSTL is empty then create the fresh DB element
  if ( !result.empty()) then
    do !steelBeam values !this.twrStlBeamProfile
      !twrStlRefe   = object DBREF()
      !twrStlRefe   = !!aslCreate('TWRSTL', !twrStlRefe)
      !twrStlRefe.purpose  = 'BEAM'
      !twrStlRefe.function = '$!steelBeam.startPosition[1].up'
        do !i index !steelBeam.startPosition
          !twrStlGensec = object DBREF()
          !twrStlGensec = !!aslCreate('GENSEC', !twrStlGensec)
          !twrStlGensec.spref = /$!steelBeam.sprefSteelBeam
          !twrStlGensec.jusLine = '$!steelBeam.bPLineJustification'
          !twrStlGensec.purpose = 'ASL'

          !twrStlSpine  = object DBREF()
          !twrStlSpine  = !!aslCreate('SPINE' , !twrStlSpine)
          !twrStlSpine.ydir = !steelBeam.yDirSpine

          !twrstlPoinsp = object DBREF()
          !twrstlPoinsp = !!aslCreate('POINSP' , !twrstlPoinsp)
          !twrstlPoinsp.position = !steelBeam.startPosition[$!i]

          !twrstlPoinsp = object DBREF()
          !twrstlPoinsp = !!aslCreate('POINSP' , !twrstlPoinsp)
          !twrstlPoinsp.position = !steelBeam.endPosition[$!i]
        enddo
    enddo
  --if the collection for tower steel is not empty and equal to the beam profile member then refresh the DB element
  elseif ( !result.size() eq !this.twrStlBeamProfile.size() )then
    do !steelBeam values !this.twrStlBeamProfile
      !twrStlRefe = object DBREF()
      !count = !count + 1
      !twrStlRefe = !result[!count]
        if (!twrStlRefe.purpose.eq('BEAM')) then
          do !i index !steelBeam.startPosition
            var !collection coll all with (type eq 'GENSEC') for $!twrStlRefe
            if ( !collection.size() gt 4 ) then
              do !m from 5 to !collection.size()
                !refe = object STRING()
                !refe = !collection[$!m].dbref().type
                !!ce = !collection[!m]
                DELETE $!refe
                !collection[$!m].delete()
              enddo
            elseif ( !collection.size() lt 4 ) then
              do !p from !collection.size() to 4
                !twrStlGensec = object DBREF()
                !!ce = !twrStlRefe
                !twrStlGensec = !!aslCreate('GENSEC', !twrStlGensec)
                !collection.append(!twrStlGensec)
              enddo
            elseif ( !collection.empty() ) then
              do !q from 1 to 4
                !twrStlGensec = object DBREF()
                !!ce = !twrStlRefe
                !twrStlGensec = !!aslCreate('GENSEC', !twrStlGensec)
                !collection.append(!twrStlGensec)
              enddo
            endif
            --compress the result
            !collection.compress()


            !twrStlGensec = object DBREF()
            !twrStlGensec = !collection[!i].dbref()
            !twrStlGensec.spref = /$!steelBeam.sprefSteelBeam
            !twrStlGensec.jusLine = '$!steelBeam.bPLineJustification'
            !twrStlGensec.purpose = 'ASL'

            !spineColl = object COLLECTION()
            !spineColl.scope(!twrStlGensec)
            !spineColl.type('SPINE')
            !spineResult = !spineColl.results()

            if ( !spineResult.size() gt 1 ) then
              do !l from 2 to !spineResult.size()
                !refe = object STRING()
                !refe = !spineResult[$!l].type
                !!ce = !spineResult[$!l]
                DELETE $!refe
                !spineResult[$!l].delete()
              enddo
            elseif( !spineResult.empty() ) then
              !twrStlSpine = object DBREF()
              !!ce = !twrStlGensec
              !twrStlSpine = !!aslCreate('SPINE', !twrStlSpine)
              !spineResult.append(!twrStlSpine)
            endif
            --compress the result
            !spineResult.compress()

            do !k from 1 to !spineResult.size()
              !twrStlSpine  = object DBREF()
              !twrStlSpine  = !spineResult[$!k]
              !twrStlSpine.ydir = !steelBeam.yDirSpine

              !poinsp = object COLLECTION()
              !poinsp.scope(!twrStlSpine)
              !poinsp.type('POINSP')
              !poinspResult = !poinsp.results()

              if ( !poinspResult.empty() ) then
                do !n from 1 to 2
                  !twrstlPoinsp = object DBREF()
                  !!ce = !twrStlSpine
                  !twrstlPoinsp = !!aslCreate('POINSP', !twrstlPoinsp)
                  !poinspResult.append(!twrstlPoinsp)
                enddo
              elseif( !poinspResult.size() gt 2 ) then
                do !m from 3 to !poinspResult.size()
                  !refe = object STRING()
                  !refe = !poinspResult[$!m].type
                  !!ce = !poinspResult[$!m]
                  DELETE $!refe
                  !poinspResult[$!m].delete()
                enddo
              elseif( !poinspResult.size() eq 1 ) then
                !twrstlPoinsp = object DBREF()
                !!ce = !twrStlSpine
                !twrstlPoinsp = !!aslCreate('POINSP', !twrstlPoinsp)
                !poinspResult.append(!twrstlPoinsp)
              endif
              --compress the result
              !poinspResult.compress()

              !twrstlPoinsp = object DBREF()
              !twrstlPoinsp = !poinspResult[1]
              !twrstlPoinsp.position = !steelBeam.startPosition[$!i]

              !twrstlPoinsp = object DBREF()
              !twrstlPoinsp = !poinspResult[2]
              !twrstlPoinsp.position = !steelBeam.endPosition[$!i]
            enddo
          enddo

        endif
    enddo
  --if the collection for TWRSTL is not empty less than the beam profile member then refresh the existing DB element and create the new one
  elseif ( !result.size() lt !this.twrStlBeamProfile.size() ) then
    !diffBeam = !this.twrStlBeamProfile.size() - !result.size()
      --create the added TWRSTL beam member and append the same to the result
      do !i from 1 to !diffBeam
        !refe = object DBREF()
        !refe = !!aslCreate('TWRSTL', !refe)
        !refe.purpose = 'BEAM'
        !result.append(!refe)
          do !j from 1 to 4
            !twrStlGensec = object DBREF()
            !twrStlGensec = !!aslCreate('GENSEC', !twrStlGensec)

            !twrStlSpine  = object DBREF()
            !twrStlSpine  = !!aslCreate('SPINE' , !twrStlSpine)

            !twrstlPoinsp = object DBREF()
            !twrstlPoinsp = !!aslCreate('POINSP' , !twrstlPoinsp)

            !twrstlPoinsp = object DBREF()
            !twrstlPoinsp = !!aslCreate('POINSP' , !twrstlPoinsp)
          enddo
      enddo
      !!fmsys.setProgress(70)
      --update the existing element
      do !steelBeam values !this.twrStlBeamProfile
        !twrStlRefe = object DBREF()
        !count = !count + 1
        !twrStlRefe = !result[!count]

          if (!twrStlRefe.purpose.eq('BEAM')) then
            do !i index !steelBeam.startPosition
            var !collection coll all with (type eq 'GENSEC') for $!twrStlRefe
            if ( !collection.size() gt 4 ) then
              do !m from 5 to !collection.size()
                !refe = object STRING()
                !refe = !collection[$!m].dbref().type
                !!ce = !collection[$!m]
                DELETE $!refe
                !collection[$!m].delete()
              enddo
            elseif ( !collection.size() lt 4 ) then
              do !p from !collection.size() to 4
                !twrStlGensec = object DBREF()
                !!ce = !twrStlRefe
                !twrStlGensec = !!aslCreate('GENSEC', !twrStlGensec)
                !collection.append(!twrStlGensec)
              enddo
            elseif ( !collection.empty() ) then
              do !q from 1 to 4
                !twrStlGensec = object DBREF()
                !!ce = !twrStlRefe
                !twrStlGensec = !!aslCreate('GENSEC', !twrStlGensec)
                !collection.append(!twrStlGensec)
              enddo
            endif
              --compress the result
              !collection.compress()

              !twrStlGensec = object DBREF()
              !twrStlGensec = !collection[!i].dbref()
              !twrStlGensec.spref = /$!steelBeam.sprefSteelBeam
              !twrStlGensec.jusLine = '$!steelBeam.bPLineJustification'
              !twrStlGensec.purpose = 'ASL'

              !spineColl = object COLLECTION()
              !spineColl.scope(!twrStlGensec)
              !spineColl.type('SPINE')
              !spineResult = !spineColl.results()

              if ( !spineResult.size() gt 1 ) then
                do !l from 2 to !spineResult.size()
                  !refe = object STRING()
                  !refe = !spineResult[$!l].type
                  !!ce = !spineResult[!l]
                  DELETE $!refe
                  !spineResult[$!l].delete()
                enddo
              elseif( !spineResult.empty() ) then
                !twrStlSpine = object DBREF()
                !!ce = !twrStlGensec
                !twrStlSpine = !!aslCreate('SPINE', !twrStlSpine)
                !spineResult.append(!twrStlSpine)
              endif
              --compress the result
              !spineResult.compress()

              do !k from 1 to !spineResult.size()
                !twrStlSpine  = object DBREF()
                !twrStlSpine  = !spineResult[$!k]
                !twrStlSpine.ydir = !steelBeam.yDirSpine

                !poinsp = object COLLECTION()
                !poinsp.scope(!twrStlSpine)
                !poinsp.type('POINSP')
                !poinspResult = !poinsp.results()

                if ( !poinspResult.empty() ) then
                  do !n from 1 to 2
                    !twrstlPoinsp = object DBREF()
                    !!ce = !twrStlSpine
                    !twrstlPoinsp = !!aslCreate('POINSP', !twrstlPoinsp)
                    !poinspResult.append(!twrstlPoinsp)
                  enddo
                elseif( !poinspResult.size() gt 2 ) then
                  do !m from 3 to !poinspResult.size()
                    !refe = object STRING()
                    !refe = !poinspResult[$!m].type
                    !!ce = !poinspResult[!m]
                    DELETE $!refe
                    !poinspResult[$!m].delete()
                  enddo
                elseif( !poinspResult.size() eq 1 ) then
                  !twrstlPoinsp = object DBREF()
                  !!ce = !twrStlSpine
                  !twrstlPoinsp = !!aslCreate('POINSP', !twrstlPoinsp)
                  !poinspResult.append(!twrstlPoinsp)
                endif
                --compress the result
                !poinspResult.compress()

                !twrstlPoinsp = object DBREF()
                !twrstlPoinsp = !poinspResult[1]
                !twrstlPoinsp.position = !steelBeam.startPosition[$!i]

                !twrstlPoinsp = object DBREF()
                !twrstlPoinsp = !poinspResult[2]
                !twrstlPoinsp.position = !steelBeam.endPosition[$!i]
              enddo
            enddo
          endif
      enddo
  --if the collection for TWRSTL is not empty greater than the beam profile member then refresh the existing DB element and delete the void one
  elseif ( !result.size() gt !this.twrStlBeamProfile.size() ) then
      --delete the removed level of the tower steel member and update the result
      do !i from !this.twrStlBeamProfile.size() + 1 to !result.size()
        !refe = object STRING()
        !refe = !result[!i].type
        !!ce = !result[!i]
        DELETE $!refe
      enddo
      --compress the result
      !result.compress()
      --update the existing element
      do !steelBeam values !this.twrStlBeamProfile
        !twrStlRefe = object DBREF()
        !count = !count + 1
        !twrStlRefe = !result[!count]

          if (!twrStlRefe.purpose.eq('BEAM')) then
            do !i index !steelBeam.startPosition
            var !collection coll all with (type eq 'GENSEC') for $!twrStlRefe
            if ( !collection.size() gt 4 ) then
              do !m from 5 to !collection.size()
                !refe = object STRING()
                !refe = !collection[$!m].dbref().type
                !!ce = !collection[!m]
                DELETE $!refe
                !collection[$!m].delete()
              enddo
            elseif ( !collection.size() lt 4 ) then
              do !p from !collection.size() to 4
                !twrStlGensec = object DBREF()
                !!ce = !twrStlRefe
                !twrStlGensec = !!aslCreate('GENSEC', !twrStlGensec)
                !collection.append(!twrStlGensec)
              enddo
            elseif ( !collection.empty() ) then
              do !q from 1 to 4
                !twrStlGensec = object DBREF()
                !!ce = !twrStlRefe
                !twrStlGensec = !!aslCreate('GENSEC', !twrStlGensec)
                !collection.append(!twrStlGensec)
              enddo
            endif

              --compress the result
              !collection.compress()

              !twrStlGensec = object DBREF()
              !twrStlGensec = !collection[!i].dbref()
              !twrStlGensec.spref = /$!steelBeam.sprefSteelBeam
              !twrStlGensec.purpose = 'ASL'
              !twrStlGensec.jusLine = '$!steelBeam.bPLineJustification'

              !spineColl = object COLLECTION()
              !spineColl.scope(!twrStlGensec)
              !spineColl.type('SPINE')
              !spineResult = !spineColl.results()

              if ( !spineResult.size() gt 1 ) then
                do !l from 2 to !spineResult.size()
                  !refe = object STRING()
                  !refe = !spineResult[$!l].type
                  !!ce = !spineResult[!l]
                  DELETE $!refe
                  !spineResult[$!l].delete()
                enddo
              elseif( !spineResult.empty() ) then
                !twrStlSpine = object DBREF()
                !!ce = !twrStlGensec
                !twrStlSpine = !!aslCreate('SPINE', !twrStlSpine)
                !spineResult.append(!twrStlSpine)
              endif
              --compress the result
              !spineResult.compress()

              do !k from 1 to !spineResult.size()
                !twrStlSpine  = object DBREF()
                !twrStlSpine = !spineResult[$!k]
                !twrStlSpine.ydir = !steelBeam.yDirSpine

                !poinsp = object COLLECTION()
                !poinsp.scope(!twrStlSpine)
                !poinsp.type('POINSP')
                !poinspResult = !poinsp.results()

                if ( !poinspResult.empty() ) then
                  do !n from 1 to 2
                    !twrstlPoinsp = object DBREF()
                    !!ce = !twrStlSpine
                    !twrstlPoinsp = !!aslCreate('POINSP', !twrstlPoinsp)
                    !poinspResult.append(!twrstlPoinsp)
                  enddo
                elseif( !poinspResult.size() gt 2 ) then
                  do !m from 3 to !poinspResult.size()
                    !refe = object STRING()
                    !refe = !poinspResult[!m].type
                    !!ce = !poinspResult[!m]
                    DELETE $!refe
                    !poinspResult[$!m].delete()
                  enddo
                elseif( !poinspResult.size() eq 1 ) then
                  !twrstlPoinsp = object DBREF()
                  !!ce = !twrStlSpine
                  !twrstlPoinsp = !!aslCreate('POINSP', !twrstlPoinsp)
                  !poinspResult.append(!twrstlPoinsp)
                endif
                --compress the result
                !poinspResult.compress()

                !twrstlPoinsp = object DBREF()
                !twrstlPoinsp = !poinspResult[1]
                !twrstlPoinsp.position = !steelBeam.startPosition[!i]

                !twrstlPoinsp = object DBREF()
                !twrstlPoinsp = !poinspResult[2]
                !twrstlPoinsp.position = !steelBeam.endPosition[!i]
              enddo
            enddo
          endif
      enddo
  endif
  !!fmsys.setProgress(75)
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateLandingDb
--
-- Description: updates the Landing details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateStrLngDB()

  !!fmsys.setProgress(20)
  -- create the stair Landing
  !this.meStrLngEngine.strLngData.updateStrLngDB()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      connect
--
-- Description: connect the Section to establish connections
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    RW      DBREF     all gensec
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .connect(!element is DBREF)

  --prompt
  prompt 'Collecting sections to connect...'

  --collect the tower steel element with columns
  !collectTwrStlCol = object COLLECTION()
  !collectTwrStlCol.scope(!element)
  !collectTwrStlCol.type('TWRSTL')
  !expTwrStlCol = object EXPRESSION('purp eq |COLU|')
  !collectTwrStlCol.filter(!expTwrStlCol)
  !resTwrStlCol = !collectTwrStlCol.results()

  !this.twrStlColRefe = !resTwrStlCol

  --collect the gensec below it
  !collectGensecCol = object COLLECTION()
  !collectGensecCol.scope(!this.twrStlColRefe[1])
  !collectGensecCol.type('GENSEC')
  !expGensecCol = object EXPRESSION('purp eq |ASL|')
  !collectGensecCol.filter(!expGensecCol)
  !resTwrStlGensecCol = !collectGensecCol.results()

  !this.twrStlGensecRefe = !resTwrStlGensecCol

   --collect all the tower steel element for the beams
  !collectTwrStlBeam = object COLLECTION()
  !collectTwrStlBeam.scope(!element)
  !collectTwrStlBeam.type('TWRSTL')
  !expTwrStl = object EXPRESSION('purp eq |BEAM|')
  !collectTwrStlBeam.filter(!expTwrStl)
  !resTwrStlBeam = !collectTwrStlBeam.results()

  !this.twrStlBeamRefe = !resTwrStlBeam

  --collect all the gensec and connect them to the column
  !beamLevel    = !element.bmlevels
  !newBeamLevel = object ARRAY()
  do !i from 1 to !beamLevel.size()
    !newBeamLevel.append(!beamLevel[!i].string())
  enddo

  !beamLevel = object ARRAY()
  !beamLevel = !newBeamLevel

  --prompt
  prompt 'Connecting primary sections to external sections...'

  do !i from 1 to !beamLevel.size()
    !collectGensecBeam = object COLLECTION()
    !collectGensecBeam.scope(!this.twrStlBeamRefe[!i])
    !collectGensecBeam.type('gensec')
    !expGensecBeam = object EXPRESSION('PURP eq |ASL|')
    !collectGensecBeam.filter(!expGensecBeam)
    !resTwrStlGensecBeam = !collectGensecBeam.results()

    do !j from 1 to !resTwrStlGensecBeam.size()
      !sectionEnd[1] = 'START'
      !sectionEnd[2] ='END'
      if ( !j.eq(1) ) then
        !primarySection[1] = !this.twrStlGensecRefe[1]
        !primarySection[2] = !this.twrStlGensecRefe[2]

        !secondarySection  = !resTwrStlGensecBeam[1]

        !conn = object SECTIONCONNECTIONMANAGER()
        !conn.setplinerule('ccon eq ''ANY''')
        !conn.localPlineRulePriority = true
        !conn.connectSections(!sectionEnd[1], !secondarySection, !primarySection[1])
        !conn.connectSections(!sectionEnd[2], !secondarySection, !primarySection[2])
      endif

      if ( !j.eq(2) ) then
        !primarySection[1] = !this.twrStlGensecRefe[2]
        !primarySection[2] = !this.twrStlGensecRefe[3]

        !secondarySection  = !resTwrStlGensecBeam[2]

        !conn = object SECTIONCONNECTIONMANAGER()
        !conn.setplinerule('ccon eq ''ANY''')
        !conn.localPlineRulePriority = true
        !conn.connectSections(!sectionEnd[1], !secondarySection, !primarySection[1])
        !conn.connectSections(!sectionEnd[2], !secondarySection, !primarySection[2])
      endif

      if ( !j.eq(3) ) then
        !primarySection[1] = !this.twrStlGensecRefe[3]
        !primarySection[2] = !this.twrStlGensecRefe[4]

        !secondarySection  = !resTwrStlGensecBeam[3]

        !conn = object SECTIONCONNECTIONMANAGER()
        !conn.setplinerule('ccon eq ''ANY''')
        !conn.localPlineRulePriority = true
        !conn.connectSections(!sectionEnd[1], !secondarySection, !primarySection[1])
        !conn.connectSections(!sectionEnd[2], !secondarySection, !primarySection[2])
      endif
    enddo

  enddo

  --prompt dismiss
  prompt dismiss

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      connect
--
-- Description: disconnect the Section
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    RW      DBREF     all gensec
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .disConnect(!element is DBREF)

  --old ce
  !oldCe = !!ce

  --collect the JLDATU and delete it
  !collTwrStl = object COLLECTION()
  !collTwrStl.scope(!element)
  !collTwrStl.type('TWRSTL')
  !resultSteel = !collTwrStl.results()

  do !twrStl values !resultSteel
    !collectJldatu = object COLLECTION()
    !collectJldatu.scope(!twrStl)
    !collectJldatu.type('JLDATU')
    !resultJldatu = !collectJldatu.results()

    do !i from 1 to !resultJldatu.size()
      --delete the JLDATU
      !!ce = !resultJldatu[!i]
      delete JLDATU
    enddo
  enddo

  --set back the old ce
  !!ce = !oldCe

endmethod
-- End of method
