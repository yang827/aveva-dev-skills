--
--   Description:
--    Object for handling Tower Steel Creation definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslTwrColumnProfile()            -                   Constructor
--  updateColumnProfileAids()        -                   updates the column aid lines
--  updateColumnProfileData(DIRECTION,POSITION,REAL,REAL,REAL,ARRAY,DBREF) -
--  updateColumnProfileDb(DBREF)     -                   updates the column details in database
--  updateDataObj(DBREF)             -                   reads the values from the end STRLNG
--

define object ASLTWRCOLUMNPROFILE

  --position definition for points in the gensec spines
  member .startPosition          is POSITION
  member .endPosition            is POSITION

  --catalogue details
  member .sprefSteelColumn       is STRING

  -- column pline justification
  member .cPLineJustification    is STRING

  --direction detail for orientation
  member .yDirSpine              is DIRECTION

  --column profile
  member .twrStlColumnProfile    is ARRAY

  --current element
  member .refe                   is DBREF

endobject

------------------------------------------------------------------------
--
-- Method:     aslTwrColumnProfile
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aslTwrColumnProfile()

  -- Initialise position Variables
  !this.startPosition       = E0mm N0mm U0mm
  !this.endPosition         = E0mm N0mm U2000mm

  -- Initialise Spec (catalogue) Variables
  !this.sprefSteelColumn    = 'BS-SPEC/254x254x107kg/m'

  --Initialise justification Variables
  !this.cPLineJustification = 'NA'

  --set the directional Variables
  !this.yDirSpine           = N

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: reads the values from the end STRLNG
--
-- Method type: Procedure
-- Arguments:
--   [#] [R/RW] [Data type]    [Description]
--    1     R     DBREF        reference element
--
-- Return:
--   [Data type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  -- evaluates the panel tower Steel
  var !resTwrStl coll all TWRSTL with PURP eq |COLU| for $!refe

  if ( !resTwrStl.set() ) then
    -- set the general attributes
    !!ce = !resTwrStl[1].dbref()
    var !resGensec coll all with (type eq |GENSEC| and PURP eq |ASL|) for ce
    if ( !resGensec.set() ) then
      !!ce = !resGensec[1].dbref()
    endif
    !!aslStrTwr.profileSectA.val = !!ce.spref.flnm.after('/')
    !!aslStrTwr.profileJustA.val = !!ce.jusLine
    !!aslStrTwr.createTwrStl.val = true
  elseif( !resTwrStl.empty() ) then
    !!aslStrTwr.createTwrStl.val = false
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateColumnProfileData
--
-- Description: updates the column details
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateColumnProfileData(!prmDir is DIRECTION, !pos is POSITION, !xlen is REAL, !ylen is REAL, !zlen is REAL, !beamLevel is ARRAY, !refe is DBREF )
  !!fmsys.setProgress(65)

  --initialise the variable
  !this.refe  = !refe
  !this.twrStlColumnProfile = object ARRAY()

  --manipulation for the first column
  !newTwrStlColumnProfile                     = object ASLTWRCOLUMNPROFILE()
  !newTwrStlColumnProfile.startPosition       = !pos.offset( !prmDir.orthogonal(U), !xlen / 2 ).offset( !prmDir.opposite() , !ylen / 2 )
  !newTwrStlColumnProfile.endPosition         = !newTwrStlColumnProfile.startPosition.offset( U , !zlen )
  !newTwrStlColumnProfile.sprefSteelColumn    = !this.sprefSteelColumn
  !newTwrStlColumnProfile.cPLineJustification = !this.cPLineJustification
  !newTwrStlColumnProfile.yDirSpine           = !prmDir

  !this.twrStlColumnProfile.append(!newTwrStlColumnProfile)

  --manipulation for the second column
  !newTwrStlColumnProfile                     = object ASLTWRCOLUMNPROFILE()
  !newTwrStlColumnProfile.startPosition       = !pos.offset( !prmDir.orthogonal(U), !xlen / 2 ).offset( !prmDir , !ylen / 2 )
  !newTwrStlColumnProfile.endPosition         = !newTwrStlColumnProfile.startPosition.offset( U , !zlen )
  !newTwrStlColumnProfile.sprefSteelColumn    = !this.sprefSteelColumn
  !newTwrStlColumnProfile.cPLineJustification = !this.cPLineJustification
  !newTwrStlColumnProfile.yDirSpine           = !prmDir

  !this.twrStlColumnProfile.append(!newTwrStlColumnProfile)

  --manipulation for the third column
  !newTwrStlColumnProfile                     = object ASLTWRCOLUMNPROFILE()
  !newTwrStlColumnProfile.startPosition       = !pos.offset( !prmDir.orthogonal(U).opposite(), !xlen / 2 ).offset( !prmDir , !ylen / 2 )
  !newTwrStlColumnProfile.endPosition         = !newTwrStlColumnProfile.startPosition.offset( U , !zlen )
  !newTwrStlColumnProfile.sprefSteelColumn    = !this.sprefSteelColumn
  !newTwrStlColumnProfile.cPLineJustification = !this.cPLineJustification
  !newTwrStlColumnProfile.yDirSpine           = !prmDir

  !this.twrStlColumnProfile.append(!newTwrStlColumnProfile)

  --manipulation for the fourth column
  !newTwrStlColumnProfile                     = object ASLTWRCOLUMNPROFILE()
  !newTwrStlColumnProfile.startPosition       = !pos.offset( !prmDir.orthogonal(U).opposite() , !xlen / 2 ).offset( !prmDir.opposite(), !ylen / 2 )
  !newTwrStlColumnProfile.endPosition         = !newTwrStlColumnProfile.startPosition.offset( U , !zlen )
  !newTwrStlColumnProfile.sprefSteelColumn    = !this.sprefSteelColumn
  !newTwrStlColumnProfile.cPLineJustification = !this.cPLineJustification
  !newTwrStlColumnProfile.yDirSpine           = !prmDir

  !this.twrStlColumnProfile.append(!newTwrStlColumnProfile)

    --clear aids if ANY
  !!aslCentralData.clearFeedback('AIDVOLLINECOLUMN')
  !!aslCentralData.clearFeedback('AIDVOLLINEBEAM')
  !!aslCentralData.clearFeedback('AIDDIM')

  if ( !beamLevel.empty().not() ) then
    -- update the aid graphics
    !this.updateColumnProfileAids()
  endif


endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateColumnProfileAids
--
-- Description: updates the column details aids
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateColumnProfileAids()

  -- draws the column profile frame
  ---------------------------------------------------------------------------
  do !i values !this.twrStlColumnProfile
    !line               = object LINE()
    !line.startPosition = !i.startPosition
    !line.endPosition   = !i.endPosition
    !line.draw(!!aslCentralData.aidVolLineColumn, !!aslCentralData.lineStyleSolidThick, !!aslCentralData.colourSteelColumn)
  enddo

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      updateColumnProfileDb
--
-- Description: updates the column details in database
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateColumnProfileDb(!refe is DBREF)

  --collecting the column with purpose set to COLU if exists
  !purpose = object EXPRESSION()
  !purpose.expression('PURP eq |COLU|')

  !collection = object COLLECTION()
  !collection.scope(!refe)
  !collection.type('TWRSTL')
  !collection.filter(!purpose)
  !result = !collection.results()

  --if the collection for TWRSTL is empty then create the fresh DB element
  if ( !result.empty()) then
    !twrStlRefe   = object DBREF()
    !twrStlRefe   = !!aslCreate('TWRSTL', !twrStlRefe)
    !twrStlRefe.purpose = 'COLU'
      do !steelColumn values !this.twrStlColumnProfile
        !twrStlGensec = object DBREF()
        !twrStlGensec = !!aslCreate('GENSEC', !twrStlGensec)
        !twrStlGensec.spref = /$!steelColumn.sprefSteelColumn
        !twrStlGensec.jusLine = '$!steelColumn.cPLineJustification'
        !twrStlGensec.purpose = 'ASL'

        !twrStlSpine  = object DBREF()
        !twrStlSpine  = !!aslCreate('SPINE' , !twrStlSpine)
        !twrStlSpine.ydir = !steelColumn.yDirSpine

        !twrstlPoinsp = object DBREF()
        !twrstlPoinsp = !!aslCreate('POINSP' , !twrstlPoinsp)
        !twrstlPoinsp.position = !steelColumn.startPosition

        !twrstlPoinsp = object DBREF()
        !twrstlPoinsp = !!aslCreate('POINSP' , !twrstlPoinsp)
        !twrstlPoinsp.position = !steelColumn.endPosition
      enddo
  else
  --if the collection for TWRSTL is not empty and equal to the column profile member then refresh the DB element
    do !i from 1 to !result.size()
      !twrStlRefe = object DBREF()
      !twrStlRefe = !result[$!i]

      if (!twrStlRefe.purpose.eq('COLU')) then
        !count = 0
        do !steelColumn values !this.twrStlColumnProfile
          var !collection coll all with (type eq 'GENSEC') for $!twrStlRefe
          if ( !collection.size() gt 4 ) then
            do !m from 5 to !collection.size()
              !refe = object STRING()
              !refe = !collection[$!m].dbref().type
              !!ce = !collection[!m]
              DELETE $!refe
              !collection[$!m].delete()
            enddo
          elseif ( !collection.size() lt 4 ) then
            do from !collection.size() to 4
              !twrStlGensec = object DBREF()
              !!ce = !twrStlRefe
              !twrStlGensec = !!aslCreate('GENSEC', !twrStlGensec)
              !collection.append(!twrStlGensec)
            enddo
          elseif ( !collection.empty() ) then
            do from 1 to 4
              !twrStlGensec = object DBREF()
              !!ce = !twrStlRefe
              !twrStlGensec = !!aslCreate('GENSEC', !twrStlGensec)
              !collection.append(!twrStlGensec)
            enddo
          endif
          --compress the result
          !collection.compress()

          !count = !count + 1
          !twrStlGensec = object DBREF()
          !twrStlGensec = !collection[!count].dbref()
          !twrStlGensec.spref   = /$!steelColumn.sprefSteelColumn
          !twrStlGensec.jusLine = '$!steelColumn.cPLineJustification'
          !twrStlGensec.purpose = 'ASL'

          !spineColl = object COLLECTION()
          !spineColl.scope(!twrStlGensec)
          !spineColl.type('SPINE')
          !spineResult = !spineColl.results()
          !!fmsys.setProgress(40)
          if ( !spineResult.size() gt 1 ) then
            do !l from 2 to !spineResult.size()
              !refe = object STRING()
              !refe = !spineResult[$!l].type
              !!ce = !spineResult[!l]
              DELETE $!refe
              !spineResult[$!l].delete()
            enddo
          elseif( !spineResult.empty() ) then
            !twrStlSpine = object DBREF()
            !!ce = !twrStlGensec
            !twrStlSpine = !!aslCreate('SPINE', !twrStlSpine)
            !spineResult.append(!twrStlSpine)
          endif
          --compress the result
          !spineResult.compress()

          do !k from 1 to !spineResult.size()
            !twrStlSpine = object DBREF()
            !twrStlSpine = !spineResult[$!k]
            !twrStlSpine.ydir = !steelColumn.yDirSpine

            !poinsp = object COLLECTION()
            !poinsp.scope(!twrStlSpine)
            !poinsp.type('POINSP')
            !poinspResult = !poinsp.results()

            if ( !poinspResult.empty() ) then
              do from 1 to 2
                !twrstlPoinsp = object DBREF()
                !!ce = !twrStlSpine
                !twrstlPoinsp = !!aslCreate('POINSP', !twrstlPoinsp)
                !poinspResult.append(!twrstlPoinsp)
              enddo
            elseif( !poinspResult.size() gt 2 ) then
              do !m from 3 to !poinspResult.size()
                !refe = object STRING()
                !refe = !poinspResult[$!m].type
                !!ce = !poinspResult[!m]
                DELETE $!refe
                !poinspResult[$!m].delete()
              enddo
            elseif( !poinspResult.size() eq 1 ) then
              !twrstlPoinsp = object DBREF()
              !!ce = !twrStlSpine
              !twrstlPoinsp = !!aslCreate('POINSP', !twrstlPoinsp)
              !poinspResult.append(!twrstlPoinsp)
            endif
            --compress the result
            !poinspResult.compress()

            !twrstlPoinsp = object DBREF()
            !twrstlPoinsp = !poinspResult[1]
            !twrstlPoinsp.position = !steelColumn.startPosition

            !twrstlPoinsp = object DBREF()
            !twrstlPoinsp = !poinspResult[2]
            !twrstlPoinsp.position = !steelColumn.endPosition
          enddo
        enddo
      endif
    enddo
  endif
  !!fmsys.setProgress(50)
endmethod
-- End of method
