--
-- Description:     container for WWAY criteria data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslWWayCriteria()                -                   default constructor
--  complete()                       -                   completes all missing values
--

-- Define object
define object ASLWWAYCRITERIA

  -- stores the description of the object
  member .desc             is STRING

  -- clearance width
  member .clearanceWidth   is CRITERION

  -- headroom distance
  member .headRoomDistance is CRITERION

  -- thickness
  member .thickness        is CRITERION

  -- width
  member .width            is CRITERION

endobject
-- End of object definition for aslWWayCriteria

------------------------------------------------------------------------
--
-- Method:      aslWWayCriteria
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslWWayCriteria()

  !this.desc                         = 'Walkway'

  !this.clearanceWidth.description   = 'Clearance width'
  !this.headRoomDistance.description = 'Headroom distance'
  !this.thickness.description        = 'Thickness'
  !this.width.description            = 'Width'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      complete
--
-- Description: completes all missing values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .complete()



endmethod
-- End of method
