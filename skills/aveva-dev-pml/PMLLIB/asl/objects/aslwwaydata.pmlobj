--
--
-- Description:     container for WWAY data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aslWWayData()                    -                   default constructor
--  buildHandras()                   -                   build the handrails
--  drawAccess()                     -                   draws gates
--  enhance()                        -                   enhances the element
--  erase()                          -                   erases all traces
--  getError()                       BOOLEAN             returns the error status
--  resetError()                     -                   resets error status
--  showVolFeedback()                -                   draws the element with aid lines
--  unEnhance()                      -                   unenhances the element
--  updateDB()                       -                   creates/updates WWAY element
--  updateDataObj(DBREF)             -                   reads the values from the WALKWAY
--

-- Define object
define object ASLWWAYDATA

  -- public members
  ---------------------------------------------------------------------------
  -- means the vertical clearance
  member .clearance             is REAL

  -- contains all gates
  member .gates                 is ARRAY

  -- all hand rails of the stair landing
  member .handRaEngines         is ARRAY

  -- reference to the central template
  member .handRaTmplReference   is DBREF

  -- height / thickness
  member .height                is REAL

  -- orientation
  member .orientation           is ORIENTATION

  -- position
  member .position              is POSITION

  -- reference
  member .refe                  is DBREF

  -- routing
  member .routing               is POLYLINE

  -- link to the uses setting
  member .settingReference      is STRING

  -- shape
  member .shape                 is ARRAY

  -- reference to the central template
  member .wWaytmplReference     is DBREF

  -- width
  member .width                 is REAL



  -- private members
  ---------------------------------------------------------------------------
  -- true if an error occurs
  member .error                is BOOLEAN

  -- controls if the object uses the undo functionality
  member .undoable             is BOOLEAN

endobject
-- End of object definition for aslWWayData

------------------------------------------------------------------------
--
-- Method:      aslWWayData
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslWWayData()

  -- inits
  !this.error         = false
  !this.handRaEngines = object ARRAY()
  !this.undoable      = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      buildHandras()
--
-- Description: build the handrails
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .buildHandras()



endmethod

------------------------------------------------------------------------
--
-- Method:      drawAccess
--
-- Description: draws gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawAccess()

  do !i index !this.gates
    !position  = !this.gates[!i].position
    !label     = 'Access point: ' & !i.string()
    !aidNumber = !!aslCentralData.aidDim
    AID TEXT NUMBER $!aidNumber '$!label' AT $!position
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: enhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .enhance()

  call !!aslEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      erase
--
-- Description: erases all traces
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .erase()

  -- deletes the element
  call !!aslErase(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getError
--
-- Description: returns the error status
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     error status
------------------------------------------------------------------------

define method .getError() is BOOLEAN

  -- inits
  !error = !this.error

  return !error

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      resetError
--
-- Description: resets error status
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .resetError()

  !this.error = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showVolFeedback
--
-- Description: draws the element with aid lines
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .showVolFeedback()



endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      unEnhance
--
-- Description: unenhances the element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .unEnhance()

  call !!aslUnEnhance(!this.refe)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: creates/updates WWAY element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDB()

  -- create undo mark
  if ( !this.undoable ) then
    !undo = object UNDOABLE()
    !undo.description('Create/update walk way')
    !undo.add()
  endif

  -- creates/updates the owner element
--  !this.refe = !!aslCreate('WWAY', !this.refe)
--TODO: switch to the correct type STRLNG -> WWAY
  !this.refe = !!aslCreate('STRLNG', !this.refe)

--  -- create the handrails
--  !this.buildHandras()

  -- end undo mark
  if ( !this.undoable ) then
    !undo.endUndoable()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDataObj
--
-- Description: reads the values from the WALKWAY
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       reference element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDataObj(!refe is DBREF)

  -- evaluates the panel loop
  !collection = object COLLECTION()
  !collection.type('PLOO')
  !collection.scope(!refe.members)
  !result     = !collection.results()

  if ( !result.empty().not() ) then
--TODO: updateDataObj clearance
    !this.clearance         = 2000mm
--TODO: updateDataObj gates
    !this.gates             = object ARRAY()
--TODO: updateDataObj handRas
    !this.handRaEngines     = object ARRAY()
    !this.height            = !result.first().height
    !this.orientation       = !refe.orientation
    !this.position          = !refe.position
    !this.refe              = !refe
--TODO: updateDataObj routing
    !this.routing           = object POLYLINE()
    !this.settingReference  = !refe.description.after(' ')
--TODO: updateDataObj shape
    !this.shape             = object ARRAY()
    !this.wWaytmplReference = object DBREF(!refe.description.before(' '))
--TODO: updateDataObj width
    !this.width             = 1000mm
  endif

endmethod
-- End of met
