------------------------------------------------------------------------
--
-- Method:      setCriteria
--
-- Description: sets the criteria from the current central standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setCriteria()

  !this.wWayCriteriaBasis = !!aslCentralData.currSubStandard.aslWWayCriteria

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setGates
--
-- Description: sets all gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of all gates
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setGates(!gates is ARRAY)

  -- evaluates the added and the removed gates
  !addGates = !gates.difference(!this.wWayData.gates)
  !remGates = !this.wWayData.gates.difference(!gates)
  !oldGates = !this.wWayData.gates.intersect(!gates)

  -- assigns the gates to the gate stack
  !this.wWayData.gates = !oldGates
  !this.wWayData.gates.appendArray(!addGates)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setHeight
--
-- Description: sets the height
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        height
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setHeight(!height is REAL)

  !this.wWayData.height = !height

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setRouting
--
-- Description: sets the routing
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POLYLINE    routing
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setRouting(!routing is POLYLINE)

  !edges = !routing.edges()

  -- if there was no routing at all, use the new routing and set all alignments to centre
  if ( !this.wWayData.routing.unset() ) then
    !this.wWayData.routing   = !routing
    !this.wWayData.alignment = ARRAY()
    do !i index !edges
      !this.wWayData.alignment[!i] = 'CENTRE'
    enddo

  -- the routing was set, try to keep the alignments
  elseif ( !this.wWayData.routing.set() ) then
    !oldEdges                = !this.wWayData.routing.edges()
    !oldAlignment            = !this.wWayData.alignment
    !this.wWayData.routing   = !routing
    !this.wWayData.alignment = ARRAY()

    do !i index !edges
      !index = !oldEdges.findFirst(!edges[!i])
      if ( !index.set() ) then
        !this.wWayData.alignment[!i] = !oldAlignment[!index]
      else
        !this.wWayData.alignment[!i] = 'CENTRE'
      endif
    enddo
  endif

  -- calculate the shape from the alignment
  !this.setShape()

endmethod
-- End of method

------------------------------------------------------------------------
