------------------------------------------------------------------------

define method .setTmplReference(!wWayTmplReference is DBREF, !handRaTmplReference is DBREF)

  !this.wWayData.wWayTmplReference   = !wWayTmplReference
  !this.wWayData.handRaTmplReference = !handRaTmplReference

endmethod
-- End of method

