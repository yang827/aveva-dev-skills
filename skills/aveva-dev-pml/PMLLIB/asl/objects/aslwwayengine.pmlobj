-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .drawAccess()

  !this.wWayData.drawAccess()

endmethod

------------------------------------------------------------------------
--
-- Method:      evaluate
--
-- Description: evaluates WWAY elements according to the existing criterion set
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .evaluate()



endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateGate
--
-- Description: evaluates a gates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position of the access
-- Return:
--   [Data Type] [Description]
--    GATE        gate
------------------------------------------------------------------------

define method .evaluateGate(!position is POSITION) is GATE

  -- evaluates the nearest edges
  !edgeIdx      = !this.wWay.routing.nearEdges(!position).first()
  !edges        = !this.wWay.routing.edges()
  !nearestEdge  = !edges[!edgeIdx]

  -- evaluates the position projected on the nearest edge
  !nearPosition = !nearestEdge.near(!position)

  -- assumption of the entry direction
  !entryDir     = !nearestEdge.direction().orthogonal(U)

  !gate = object GATE(!nearPosition, !entryDir, !entryDir.opposite())

  return !gate

endmethod
-- End of method

