-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .aslWWayEngine()



endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addGate
--
-- Description: adds a new gate to the gate stack
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position of the access
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .addGate(!position is POSITION)

  !gate = !this.evaluateGate(!position)
  !this.wWayData.gates.append(!gate)

endmethod
-- End of method

