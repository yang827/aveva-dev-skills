------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addGate(POSITION)                -                   adds a new gate to the gate stack
--  aslWWayEngine()                  -                   default constructor
--  drawAccess()                     -                   draws gates
--  evaluate()                       -                   evaluates WWAY elements according to the existing criterion set
--  evaluateGate(POSITION)           GATE                evaluates a gates
--  getError()                       BOOLEAN             returns the error status
--  getGates()                       ARRAY               returns an array of gates
--  getHandRaTmplReference()         DBREF               returns the template of the handrails
--  getHeight()                      REAL                gets the height
--  getRefe()                        DBREF               returns the reference
--  getRouting()                     POLYLINE            gets the routing
--  getSettingReference()            STRING              gets the setting
--  getShape()                       PROFILE             gets the shape
--  getWWayTmplReference()           DBREF               returns the template of the walkway
--  getWidth()                       REAL                gets the width
--  mergeCriteria()                  -                   merges central standard with fabricator standard
--  newDefaults(DBREF,DBREF)         -                   sets the attributes for a new platform (defaults
--  remGates(ARRAY)                  -                   removes gates from the gate stack
--  replaceGate(GATE,REAL)           -                   replaces an existing gate by a new one
--  replaceGate(POSITION,REAL)       -                   replaces an existing gate by a new one
--  resetError()                     -                   resets error status
--  setCriteria()                    -                   sets the criteria from the current central standard
--  setGates(ARRAY)                  -                   sets all gates
--  setHeight(REAL)                  -                   sets the height
--  setRouting(POLYLINE)             -                   sets the routing
--  setSettingReference()            -                   sets the setting
--  setSettingReference(STRING)      -                   sets the setting
--  setShape()                       -                   calculates the shape from the routing, the width and the alignment
--  setTmplReference(DBREF,DBREF)    -
--  setWidth(REAL)                   -                   sets the width
--  updateDB()                       -                   update the db with the form settings
--  updateDataObj(DBREF)             -                   reads the data from db
--

-- Define object
define object ASLWWAYENGINE

  -- public members
  ---------------------------------------------------------------------------
  -- container for the walkway data
  member .wWayData          is ASLWWAYDATA



  -- private members
  ---------------------------------------------------------------------------
  -- contains the criteria set for walkway elements (including fabricator standard)
  member .wWayCriteria      is ASLWWAYCRITERIA

  -- contains the criteria set for walkway elements (excluding fabricator standard)
  member .wWayCriteriaBasis is ASLWWAYCRITERIA

  -- contains a copy of walkway data before modify
  member .wWayDataOld       is ASLWWAYDATA

endobject
-- End of object definition for aslWWayEngine

