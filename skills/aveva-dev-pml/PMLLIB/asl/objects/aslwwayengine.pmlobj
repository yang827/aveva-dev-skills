endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setShape
--
-- Description: calculates the shape from the routing, the width and the alignment
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .setShape()

  !width     = !this.wWayData.width
  !alignment = !this.wWayData.alignment
  !edges     = !this.wWayData.routing.edges()

  !this.wWayData.shape = !shape

endmethod
-- End of method

