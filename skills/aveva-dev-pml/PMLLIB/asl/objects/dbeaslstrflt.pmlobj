------------------------------------------------------------------------
--
-- Method:      sum
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sum(!values is ARRAY) is  REAL

  !sum = 0
  do !i indices !values
     !sum = !sum + !values[!i]
  enddo

  return !sum

endmethod
-- End of method definition

--------------------------------------------------------------------------
-- Method:      spineWrite
--
-- Description: update the Gensec with the new Data
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       the element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .spineWrite(!ref is DBREF , !spinePath is ASLRPATH) is DBREF

  !oldRef = !!ce

  if !ref.badref() then
    if !ref.unset() then
      new SPINE
    else
      new SPINE REF $!ref
    endif
  else
    !!ce = !ref
  endif

  -- store rpath refno to be returned
  !rpathRef = !!ce

  delete SPINE members

  do !c indices !spinePath.vertex
    !type = !spinePath.type[!c]

    if !type.eq('POINTR') then
      !type = 'POINSP'
    endif
    new $!type
   !!ce.position = !spinePath.vertex[!c]
    if !!ce.type.eq('CURVE') then
      !curtyp = !spinePath.detail[!c][1]
      !bulgef = !spinePath.detail[!c][2]
      !cpos = !spinePath.detail[!c][3]
      !radi = !spinePath.detail[!c][4]
      !radsetf = !spinePath.detail[!c][5]
      if !curtyp.eq('BULG') then
        !!ce.bulgef = !bulgef
        !!ce.cpos = !cpos
      elseif !curtyp.eq('RADI') then
        !!ce.radi = !radi
        !!ce.cpos = !cpos
        !!ce.radsetf = !radsetf
      elseif !curtyp.eq('FILL') then
        !!ce.radi = !radi
        !!ce.radsetf = !radsetf
      elseif !curtyp.eq('CENT') then
        !!ce.radi = !radi
        !!ce.cpos = !cpos
      endif
      !!ce.curtyp = !curtyp
    endif
  enddo

  !!ce = !oldRef

  return !rpathRef

endmethod
-- End of method

--------------------------------------------------------------------------
-- Method:      endCutDir
--
-- Description: update the Gensec with the new Data
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       the element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .endCutDir(!firEdge is LINE , !secEdge is LINE ) is DIRECTION

       !firPos = !firEdge.startposition
       !secPos = !secEdge.endposition

   !intPt  = !firEdge.intersection(!secEdge)
   handle ANY
    -- May be collinear
    !endDir = !firEdge.direction()
    return !endDir
   endhandle
   !angle  = !firEdge.direction().opposite().angle(!secEdge.direction() )

   !taperAng = !angle
   !taperAng =  atan ( ( sin (!angle) / ((cos (!angle)) + 1 )))

   !gplane = object GMFPLANE()
   !cmnPlane = !gplane.through3points(!intPt, !firPos , !secPos  )

   !ori = !cmnPlane.orientation
   !zdir = !ori.zdir()

   !rad = !intPt.distance(!firPos )
    -- evaluating the position at the same length in the second line
   !secLine = object LINE(!intPt , !secPos)
   !secLineRadPos = !secLine.setlengthstart(!rad).endposition

   -- Creating a semicircle
   !arc = object ARC( !intPt , !ori , 0 , 180 , 100 , F)

   -- Finding the pie in the arc segment of the semicircle between the sections
   !arc = !arc.startposition(!firPos)
   !arc.radius = !rad
   !arc = !arc.endposition(!secLineRadPos)

   -- Check the sense
   !senseAng = !arc.startangle + !angle

   if (!arc.angleposition(!senseAng) neq !secLineRadPos  ) then
       !arc.sense = T
   endif

  !taperAng = !taperAng + !arc.startangle

  !endDir =  !arc.angledirection(!taperAng).orthogonal(!zdir)

  return !endDir

endmethod
-- End of method


------------------------------------------------------------------------
-- Method:      getIntlandingInnerBeam
--
-- Description: update the Gensec with the new Data
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       the element
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .getIntlandingInnerBeam() is ARRAY

if (!this.sense ) then
	!outerEdges = !this.lRpath.edges(false)
  !innerEdges = !this.rRpath.edges(false)
else
	!outerEdges = !this.rRpath.edges(false)
  !innerEdges = !this.lRpath.edges(false)
endif

!innerEdgesEndPos = !innerEdges.evaluate(object BLOCK(|!innerEdges[!evalIndex].endposition.up.string('D2').real()|))

!intBeam    = ARRAY()
!intBeamCnt = ARRAY()
do !inx indices !outerEdges

 !currDir = !this.horizDirection(!outerEdges[!inx])
 if(!inx.gt(1) ) then
 	
   if (!currDir.neq(!prevDir) ) then
   	!firIndx = !innerEdgesEndPos.findfirst(!outerEdges[!inx].endposition.up.string('D2').real())
   	do !indx from !firIndx
   	  if ( abs (!outerEdges[!inx].endposition.up.string('D2').real() - !innerEdges[!indx].endposition.up.string('D2').real() ) leq 1 )  then   	  	
           !inEdgeDir = !this.horizDirection(!innerEdges[!indx])
         if (!prevDir.angle(!inEdgeDir).gt(1) ) then
   	       break	
   	     endif
   	  else
   	    break
   	  endif   	
   	enddo
   	
    !edgetoExtend =  !innerEdges[!indx - 1]
    !intpoint =  !outerEdges[!inx].near(!edgetoExtend.endposition)
    !newlines =  object LINE(!edgetoExtend.endposition , !intpoint)
    !intBeamCnt.append(!indx - 1)
    !intBeam.append(!newlines)
   endif

 endif
 !prevDir = !currDir

enddo

if (!intBeam.size().gt(0) ) then
  !intBeamDetails[1] = !intBeamCnt
  !intBeamDetails[2] = !intBeam
  return !intBeamDetails
else
  return ARRAY()
endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:genTreadPoints
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .genTreadPoints() is ARRAY

   !treadPoints = ARRAY()
   !flightTreadPoints = ARRAY()

    !edges     = !this.rpath.edges(FALSE)
    !lriseFlag = TRUE
     do !edge values !edges
       !flightTreadPoints.clear()
       if ( !edge.direction().up.eq(0) ) then
         skip
       elseif (!edge.direction().up.lt(0) ) then
         !edge.reverseSense()
       endif
       if (!lriseFlag) then
         !lriseFlag = FALSE
         !cutPlanePt = !edge.startposition.offset(u , !this.lRise)
       else
         !cutPlanePt = !edge.startposition.offset(u , !this.rise)
       endif
       do !i
         !cuttingPlane = object PLANE(!cutPlanePt , z is u)
         !intersecPt = !edge.intersection(!cuttingPlane)
         !diff = abs(!edge.endposition.up - !intersecPt.up)
        if ( (!diff geq !this.rise) ) then
           !flightTreadPoints.append(!intersecPt)
           !cutPlanePt = !cutPlanePt.offset(u,!this.rise)
         else
          -- create a point at the top surface as well.
          -- not checking whether tmplReference is set as the form const itself is setting it
          if (!diff.distance().real().eq(0) and !this.tmplReference.description.upcase().matchwild('*CONCRETE*') ) then
                !flightTreadPoints.append(!intersecPt)
          endif
           break
         endif
       enddo
       !treadPoints.append(!flightTreadPoints)
     enddo

  return !treadPoints

endmethod
-- End of method definition
-----------------------------------------------------------------------
--
-- Method:generateLanding
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generateLanding( !lndgCentreLine is ASLRPATH , !offsetDist is REAL) is PROFILE

  !edges       = !lndgCentreLine.edges(FALSE)
  !vertDirection[1]      =  D
  !vertDirection[2]      =  U

  do !dirIndx indices !vertDirection
    do !i indices !edges
      if (!edges[!i].objectType().eq('LINE') )then
        !lineDir = !this.horizDirection(!edges[!i])
         handle ANY
          -- it may be a coincident point
          skip
         endhandle
        !newEdges[!i] = !edges[!i].offset(!lineDir.orthogonal(!vertDirection[!dirIndx]), !offsetDist )
      endif
    enddo

    !edgesToRemove = ARRAY()
    -- manage the place where there is change in direction
    do !j indices !newEdges
       if ( (!j.gt( 1) )and  (!newEdges[!j].direction().isParallel(!newEdges[!j - 1 ].direction()).not()  ) )then
         !interSectPt = !newEdges[!j - 1].intersection(!newEdges[!j])
         if ((!newEdges[!j - 1].startposition.distance(!interSectPt).gt(0))  and (!newEdges[!j - 1].startposition.direction(!interSectPt).isParallel(!newEdges[!j - 1].direction() ) ) )then
            !newEdges[!j - 1].endposition = !interSectPt
         else
            !edgesToRemove.append(!newEdges[!j - 1])
         endif
         if ( (!interSectPt.distance(!newEdges[!j].endposition).gt(0) )  and (!interSectPt.direction(!newEdges[!j].endposition).isParallel(!newEdges[!j].direction()) ) )then
            !newEdges[!j].startposition     = !interSectPt
         else
            !edgesToRemove.append(!newEdges[!j])
         endif
        endif
    enddo

    if (defined(!newEdges) and !newEdges.size().gt(0) ) then
      !boundaryEdges = !newEdges.difference(!edgesToRemove)
    else
      skip
    endif

    if (!dirIndx.eq(1) ) then
      !profBoundary = !boundaryEdges
    elseif(!dirIndx.eq(2) ) then
      do !k indices !boundaryEdges
        !boundaryEdges[!k] = !boundaryEdges[!k].reverseSense()
      enddo
      !profBoundary.appendarray(!boundaryEdges.invert())
    endif

  enddo

  if (defined(!profBoundary) and !profBoundary.set() ) then
     !prof = object PROFILE(!profBoundary[1].startposition , z is u , !profBoundary)
  else
    !prof = object PROFILE()
  endif

  return !prof

  endmethod
------------------------------------------------------------------------
--
-- Method:getUshapedOgoing
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getUshapedOptOgoing()

-- Calculate number of rises
  !treadsInStrFlt  = !this.oRise / !this.criteria.rise.optimum()
  !treadsInStrFlt  = !treadsInStrFlt.nint()

  -- store the optimum going to reduce expression
  !optGoing        = !this.criteria.going.optimum()
  !numberOfFlts    = !this.calcNumOfFlts(!treadsInStrFlt)

  -- with this tread number work out the going
  -- 2 half widths on either side
  !primDirGoing           = !this.getGoing(!this.pickedPosData[1].position , !this.pickedPosData[2].position , !this.flightLegs[2].fltDirection)
  -- subtract the sum of 2 half widths at both landings
  !availableGoing        = !primDirGoing -   !this.width

  -- check how many Intermediate landings are necessary
  do !flightCnt from 1
     -- max number of steps in each segment and the intermediate landing
     !segmentGoing = (!flightCnt * !this.criteria.treads.max() * !optGoing)  + ( ( !flightCnt - 1)   * !this.criteria.fltIntLngLength.optimum() )
         if (!availableGoing.leq(!segmentGoing) ) then
           !primDirLandingCnt = !flightCnt - 1
           break
         endif
       enddo

  -- going for treads excluding landing
       !availableGoing           = !availableGoing - (!primDirLandingCnt *  !this.criteria.fltIntLngLength.optimum() )
       !stepsAlongPrimary     = !availableGoing / !this.criteria.going.optimum()
       !stepsAlongPrimary     = !stepsAlongPrimary.nint()

       !goingVal              = !availableGoing / !stepsAlongPrimary

  if (!this.isValid('GOING', !goingVal).neq(0) ) then
  	return error 1 'Unable to Suggest the Overall going along the Normal Direction, Provide a suitable value.'  	
  endif  	
  	
  	
       !remainingSteps        = !treadsInStrFlt - !stepsAlongPrimary
  if (!remainingSteps.leq(0) ) then
  	!fltDirection = !this.flightLegs[2].fltDirection
  	write ('Overall going along $!fltDirection is quite long. If a U-Shaped is really necessary, provide suitable Normal Direction Length')
  	return error 2 'Overall going along $!fltDirection is quite long. Provide a suitable value for Normal Direction Length'
  endif 	

  !lPos                =  !this.pickedPosData[1].position
  !uPos                =  !this.pickedPosData[2].position

  -- create a plane parallel to Normal Plane at lwp
  !planeDir          = !this.utypeNorPlane.direction()
  !tempNorPlane      = object PLANE(!lPos , Z is $!planeDir )

  -- calculate the dist from UWP to this plane which is the difference in length
  !diffDist          = !tempNorPlane.near(!uPos).distance(!this.pickedPosData[2].position)
  !stepsForDiff      = !diffDist / !goingVal
  !stepsForDiff      = !stepsForDiff.nint()


  !stepsNormal       = (!remainingSteps - !stepsForDiff)   / 2
	
       !numberOfFlts          = !this.calcNumOfFlts(!stepsNormal)
  !normalDirGoing    = !stepsNormal * !goingVal + (!this.width ) + !numberOfFlts *  !this.criteria.fltIntLngLength.optimum()
  !offsetDist        = !normalDirGoing  + (!stepsForDiff * !goingVal)

  if (!this.extnOption.eq(3) ) then
    !offsetDist = !offsetDist + !this.criteria.fltIntLngLength.min
  endif

  !newPlnPos         = !lPos.offset(!this.flightLegs[1].fltDirection , !offsetDist)
  -- this is not the utypeNorPlane but one offset in excess by a distance of going number of times !stepsForDiff
  !tempNorPlane.position       = !newPlnPos

  !upPerpDist = !tempNorPlane.near(!uPos).distance(!this.pickedPosData[2].position)

  if (!upPerpDist.gt(!offsetDist) ) then
    -- add the extra length to the top side
    !going[1] = !normalDirGoing
    !this.utypeNorPlane.position =  !this.utypeNorPlane.position.offset(!this.utypeNorPlane.direction() , !normalDirGoing)
  else
   	!going[1] = !offsetDist           	
    !this.utypeNorPlane.position =  !lPos.offset(!this.utypeNorPlane.direction() , !offsetDist)
  endif	

  !this.showNormalPlane(!this.utypeNorPlane)

  !going[2]   = !this.getGoing(!lPos , !uPos , !this.flightLegs[2].fltDirection)
  !going[3]   = !this.getGoing(!uPos , !this.utypeNorPlane.position    , !this.flightLegs[3].fltDirection)

  !this.utypeNorLength =  !this.utypeNorPlane.near(!lPos).distance(!lPos)

  !oGoing = 0
  do !i indices !this.flightLegs
     !this.flightLegs[!i].oGoing = !going[!i]
     !oGoing =  !oGoing + !this.flightLegs[!i].oGoing
  enddo

  !this.oGoing = !oGoing
endmethod
