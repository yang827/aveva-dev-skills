--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assignValues()                   BOOLEAN
--  buildLegs(DIRECTION)             STRING              Set directions of the Legs (Leg - series of flights along a direction)
--  calcFlightSteps(REAL,REAL,BOOLEAN) ARRAY
--  calcFlightsGoing()               -
--  calcFlightsRise()                -
--  calcLegGoing(REAL,REAL,REAL,REAL,REAL) ARRAY
--  calcNumOfFlts(REAL)              REAL
--  calcNumOfFlts(REAL,REAL)         REAL
--  calcNumOfSteps()                 REAL
--  calcNumOfSteps(REAL)             REAL
--  calcNumOfSteps(REAL,REAL)        REAL
--  calcRiseGoing(REAL)              BOOLEAN             rise value is used recursively and get the going based on the number of treads calculated from the rise
--  calcTreadRise()                  REAL
--  calcTreadRise(REAL)              REAL
--  calcTreadRise(REAL,BOOLEAN)      REAL
--  checkOgoing (REAL)               BOOLEAN
--  cordDir(DIRECTION)               DIRECTION
--  createRpath()                    -
--  createSingleFlights(STRING,ARRAY) -
--  dbWrite(DBREF)                   -
--  dbeAslStrflt()                   -
--  dbeAslStrflt(DBREF)              -
--  dbeAslStrflt(STRING)             -                   Constructor
--  dbeAslStrfltData(DBREF)          -                   Constructor
--  endCutDir(LINE,LINE)             DIRECTION
--  evalGoing(REAL)                  BOOLEAN
--  evalLandingPath()                ARRAY
--  evalSegments()                   BOOLEAN             Engine that calculates the flights based on the criteria
--  evaluate(STRING)                 BOOLEAN
--  flightLegsUpdate()               -
--  flightsUpdate()                  -
--  genTreadPoints()                 ARRAY
--  generateLanding(ASLRPATH,REAL)   PROFILE
--  getFlightDirection()             DIRECTION
--  getFlightDirection(POSITION,POSITION) DIRECTION
--  getFlightThickness()             REAL
--  getFlights()                     ARRAY
--  getGoing(POSITION,POSITION)      REAL
--  getGoing(POSITION,POSITION,DIRECTION) REAL
--  getHandrailTmplReference()       DBREF
--  getIntlandingInnerBeam()         ARRAY
--  getLeftHandrail()                ASLHANDRAIL
--  getName()                        STRING
--  getOverallLength()               REAL
--  getPickedPositions()             ARRAY
--  getPitch()                       REAL
--  getPosition()                    POSITION
--  getRightHandrail()               ASLHANDRAIL
--  getRise(POSITION,POSITION)       REAL
--  getStrfltTmplReference()         DBREF
--  getTemplates()                   ARRAY               get list of Stair Flights  available in current context
--  getUshapedOptOgoing()            -
--  getWidth()                       REAL
--  handrailPath()                   -
--  horizDirection(LINE)             DIRECTION
--  isValid(STRING,REAL)             REAL
--  mergeCriteria()                  -                   merges central standard with fabricator standard
--  modifyElevation(REAL,REAL)       BOOLEAN
--  modifyLandings()                 -
--  reEvaluate(STRING,ANY)           BOOLEAN
--  readElements(STRING)             ARRAY               collects elements of passed type from the owner element
--  readElements(STRING,DBREF)       ARRAY
--  readElements(STRING,STRING,DBREF) ARRAY
--  readFlights()                    -
--  sense()                          BOOLEAN
--  sense(DIRECTION,DIRECTION)       BOOLEAN
--  setDirection()                   BOOLEAN
--  setExtensions()                  BOOLEAN
--  setFlightDirection(DIRECTION)    -
--  setFlightThickness(REAL)         -
--  setHeadRoom(REAL)                -
--  setMinExtensions()               BOOLEAN
--  setPickedPositionData(ARRAY)     -
--  setSense(BOOLEAN)                BOOLEAN
--  setTemplateReference(DBREF)      -
--  setWidth(REAL)                   -
--  settingReference(STRING)         -                   sets the setting
--  shiftTreads(REAL,REAL)           -
--  showNormalPlane(PLANE)           -
--  showVolFeedback()                -
--  spineWrite(DBREF,ASLRPATH)       DBREF
--  stringerPath()                   -
--  sum(ARRAY)                       REAL
--  tmplReference(DBREF)             -
--  updateDb(DBREF)                  -
--

define object DBEASLSTRFLT

  member .refe             is DBREF
  member .rpathRef         is DBREF
  member .name             is STRING
  member .tmplReference    is DBREF
  member .settingReference is STRING
  member .position         is POSITION
  member .orientation      is ORIENTATION
  member .lwp              is POSITION
  member .uwp              is POSITION
  member .elevations       is ARRAY

  member .fltDirection     is DIRECTION
  member .lCutDirection    is DIRECTION
  member .uCutDirection    is DIRECTION

  -- Direction from work point to end
  member .lExtnDirection   is DIRECTION
  member .uExtnDirection   is DIRECTION

  member .pitch            is REAL

  member .going            is REAL
  member .oGoing           is REAL

  member .oRise            is REAL
  member .rise             is REAL
  member .lRise            is REAL

  member .width            is REAL

  member .uExtension       is REAL
  member .lExtension       is REAL

  member .fThickness       is REAL
  member .headRoom         is REAL

  member .stringers        is ARRAY
  member .treads           is ARRAY

  member .stringerTemplates is ARRAY
  member .treadTemplates    is ARRAY

  member .criteria         is ASLSTRFLTCRITERIA
  member .criteriaBasis    is ASLSTRFLTCRITERIA

  member .handRailOption   is STRING
  member .rpath            is ASLRPATH
  member .lRpath           is ASLRPATH
  member .rRpath           is ASLRPATH

  member .autoDraw         is BOOLEAN
  member .aidColour        is REAL
  member .aidNumber        is REAL

  member .instOptions      is STRING

  -- turn direction Right is TRUE
  member .sense           is BOOLEAN

  --option of Lower and upper Extensions
  member .noExtension is BOOLEAN
  member .extnOption is REAL


  -- number of flight segments
  member .numberOfFlts     is REAL

  -- Total number of steps in flights
  member .numberOfSteps    is REAL

  -- ARRAY of legs in a flight
  member .flightLegs       is ARRAY

  -- ARRAY of individual tread sets
  member .flights          is ARRAY

  -- HANRAIL on the Left
  member .lHandrail is ASLHANDRAIL

  -- HANRAIL on the Left
  member .rHandrail is ASLHANDRAIL

  -- Array of picked positions (sorted with the elevation)
  member  .pickedPosData     is ARRAY

  -- offset distance from the rpath
  -- set positive value  if the pick point is the landing and negative if it is TOS
  member  .lowLandingOffset is REAL
  member  .upLandingOffset  is REAL

  member .landingThickness is REAL

  -- Length in Normal direction for U-Shaped
  member .utypeNorLength    is REAL

  -- plane in Normal direction for U-Shaped
  member .utypeNorPlane    is PLANE

endobject
-- End of object

------------------------------------------------------------------------
--
-- Method:      dbeaslstrflt
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dbeAslStrflt()

  --** -- set default values for object members
  !this.refe              = object DBREF()
  !this.name              = ''
  !this.tmplReference     = object DBREF()
  !this.settingReference  = !!aslCentralData.currsetting.description
  !this.position          = E0
  !this.orientation       = Y is N
  !this.lwp               = E0
  !this.uwp               = E0

  !this.numberOfSteps =  0

    -- Landing data
  !this.lExtension     = 0
  !this.uExtension     = 0

  !this.fltDirection      = N
  !this.lCutDirection     = N
  !this.uCutDirection     = N
  !this.lExtnDirection    = N
  !this.uExtnDirection    = N

  !this.lowLandingOffset = 0
  !this.upLandingOffset  = 0
  !this.landingThickness = 50mm

  !this.sense            = TRUE

  !this.utypeNorLength   = 0

  -- handrails on  both sides
  !this.handRailOption = 'LR'

  !this.noExtension = FALSE
  !this.extnOption  = 3

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      dbeaslstrflt
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dbeAslStrflt(!strFlt is DBREF)

  -- check type
  if !strFlt.type.neq('STRFLT') then
    STRFLT
    handle (2,111)
     return error 1 'You must be at STRFLT or below'
    endhandle
    !strFlt = !!ce
  endif

  -- read the attributes excluding geometry from the element
  !this.dbeAslStrfltData(!strFlt)

    -- set the setting reference
  !this.settingReference(!!aslCentralData.currsetting.description)

  -- store the rpath reference
  !this.rpathRef       = !!dtbMemberOfType(!strFlt,'RPATH',1)
  if(!this.rpathRef.unset()) then
    return error 2 'Stair flight do not have any RPATH.'
  endif

   -- load the rpath data
  !this.rpath = object ASLRPATH(!strFlt,'load')
  if(!this.rpath.size().leq(1) ) then
     return error 3 'Stair Flight Path does not have sufficient number of members to modify'
  endif

  !intLndgs = !this.readElements('PLOO' , 'OHTYPE OF OWNER EQ |INTLNG|' , !strFlt)
 if (!intLndgs.size().gt(0) ) then
   do !intLndgLoop values !intLndgs
     -- get  the height from one of the loop
     if (!intLndgLoop.height.set() ) then
      !intLndgThk = !intLndgLoop.height
      break
     endif
   enddo
 else
    !intLndgThk = 160mm
 endif

  !this.landingThickness = !intLndgThk
  handle ANY
      -- if the loops still have unset height value
   !this.landingThickness = 160mm
  endhandle

  !this.flights.clear()

  -- read the geometry of rpath and store as flights
  !this.readFlights()

  !this.sense = !this.sense()

  if (!strFlt.assTmpReference.set() )  then
    !this.tmplReference = !strFlt.assTmpReference
    !this.setTemplateReference(!this.tmplReference)
  else
    return error 4 'Template reference attribute - ASSTMPREFERENCE is unset, Unable to modify Stair Flight $!strFlt'
  endif

  !stringers = !this.readElements('GENSEC' , 'OHTYPE  EQ |STRSTR|' ,  !this.refe)
  if (!stringers.size().gt(0) and !intLndgs.size().gt(0) ) then
  	
      -- collect the elevations of the Intermediate Landing panels
 !intLndgElev = !intLndgs.evaluate(object BLOCK('!intLndgs[!evalIndex].owner.position.wrt(world).up'))
 !intLndgElev = !intLndgElev.sort()

  	  -- use the landing thickness for consistency
  	  -- use the stringer and landing elevations in combination to get the landing offset
      !stringerPath = object ASLRPATH(!stringers[1] , 'load')
      if (!stringerPath.vertex[1].up.lt(!this.rpath.vertex[1].up) ) then
         !this.lowLandingOffset = -1 * !this.landingThickness
      elseif (!intLndgElev[1].gt(!this.lwp.up) ) then
         !this.lowLandingOffset = !this.landingThickness
      endif

      !stringerPath = object ASLRPATH(!stringers.last() , 'load')
      if (!stringerPath.vertex.last().up.lt(!this.rpath.vertex.last().up ) ) then
         !this.upLandingOffset = -1 * !this.landingThickness
      elseif (!intLndgElev.last().gt(!this.uwp.up) ) then
         !this.upLandingOffset = !this.landingThickness
      endif
  endif

 !handraSides =''
  -- collect and assign the handrail data on the appropriate side
  !handRails = !this.readElements('HANDRA' , !this.refe)

  !edges           = !this.rpath.edges(FALSE)
  !primDir         = !this.horizDirection(!edges[1])

 do !handra values !handRails
    !handraRpath = object ASLRPATH(!handra,'load')
    if (!handraRpath.size().eq(0) )  then
      skip
    endif

    -- find the direction between the first point in Stair Flight rpath and  nearest point from the point in the side path
   !crossDir   = !this.getFlightDirection(!handraRpath.near(!this.rpath.vertex[1], FALSE)[1].near(!this.rpath.vertex[1]) , !this.rpath.vertex[1])

   if ( !primDir.cross(!crossDir) eq DOWN ) then
        !this.lHandrail.aslHandRail(!handra)
        !handraSides = !handraSides & 'L'
   elseif ( !primDir.cross(!crossDir) eq UP ) then
       !this.rHandrail.aslHandRail(!handra)
      !handraSides = !handraSides & 'R'
   endif

 enddo

  -- it may be LR/RL  so assign directly
 if (!handraSides.length().gt(1) )  then
    !handraSides = 'LR'
 endif

 !this.handRailOption = !handraSides

  -- set left/right path only (there is no need to re-route handrails as they have been just loaded from db)
  !this.stringerPath()

endmethod
-- End of method aslStrflt

------------------------------------------------------------------------
--
-- Method:      dbeAslStrflt
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Setting reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeAslStrflt(!setting is STRING)
  -- Constructor
  !this.dbeAslStrflt()

  -- set the setting reference
  !this.settingReference(!setting)

  -- get first available stair flight template
  !tmplRef = !this.getTemplates()[1]
  handle ANY
    return error 2 'There is no Stair Flight in ASL selection. Contact your ASL administrator'
  endhandle

  -- apply template data
  !this.tmplReference(!tmplRef)

  -- set the handrail templates
  !this.lHandrail.aslHandRail(!setting)

  !this.rHandrail = !this.lHandrail

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      dbeAslStrfltData
--
-- Description: Method to read the stored attributes from the Stair Flight method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      element to modify
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbeAslStrfltData(!strFltRefe  is DBREF)

  !strFlt = !strFltRefe

  -- read data from DB
  !this.refe           = !strFlt
  if(!strFlt.isNamed) then
    !this.name           = !strFlt.namn
  else
    !this.name           = ''
  endif

  !this.position       = !strFlt.position.wrt(world)
  !this.fltDirection   = !strFlt.fltDirection
  !this.fThickness     = !strFlt.fThickness
  !this.headRoom       = !strFlt.headRoom
  !this.rise           = !strFlt.rise
  !this.lRise          = !strFlt.lRise
  !this.width          = !strFlt.tWidth

  !this.tmplReference  = !strFlt.assTmpReference
  !this.instOptions    = !strFlt.instOptions

endmethod

-- End of method
------------------------------------------------------------------------
--
-- Method:      settingReference
--
-- Description: sets the setting
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      setting
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .settingReference(!settingReference is STRING)

  !this.criteriaBasis    = !!aslCentralData.getCriteriaSet(!settingReference, 'ASLSTRFLTCRITERIA')
  handle ANY
    return error 1 'Stair Flight criteria not set for setting reference "$!settingReference". Contact your ASL administrator'
  endhandle
  !this.settingReference = !settingReference
  !this.criteriaBasis.complete()

endmethod

-- End of method settingReference
------------------------------------------------------------------------
--
-- Method:      tmplReference
--
-- Description: sets the template reference and loads some default data from the settings and templates to avoid unset data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       stair flight template reference
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .tmplReference(!tmplReference is DBREF)

  -- gets the values for the Stair Flight  from the substandard
  !this.mergeCriteria()

  !this.setTemplateReference(!tmplReference)

  -- object has been just created so get defaults from ASLSTRFLTCRITERIA object
  !this.width         = !this.criteria.width.optimum()
  !this.fThickness    = !this.criteria.thickness.optimum()
  !this.headRoom      = !this.criteria.verticalClearance.optimum()

  !this.oGoing        = !this.criteria.oGoing.optimum()
  !this.oRise         = !this.criteria.oRise.optimum()
  !this.going         = !this.criteria.going.optimum()
  !this.rise          = !this.criteria.rise.optimum()
  !this.lRise         = !this.criteria.lRise.optimum()
  !this.pitch         = !this.criteria.pitch.optimum()

  -- try to get settings from template
  if !tmplReference.rise.gt(0) then
    !this.rise = !tmplReference.rise
  endif
  if !tmplReference.lRise.gt(0) then
    !this.lRise = !tmplReference.lRise
  endif
  if !tmplReference.tWidth.gt(0) then
    !this.width = !tmplReference.tWidth
  endif
  if !tmplReference.fThickness.gt(0) then
    !this.fThickness = !tmplReference.fThickness
  endif

endmethod
-- End of method tmplReference
------------------------------------------------------------------------
--
-- Method:      mergeCriteria
--
-- Description: merges central standard with fabricator standard
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .mergeCriteria()

  -- gets the values for the stair flight from the substandard
  !this.criteria  = !!getCriteriaSetIntersection(!this.criteriaBasis, !this.tmplReference)
  !this.criteria.complete()

endmethod
-- End of method mergeCriteria
------------------------------------------------------------------------
--
-- Method:      getTemplates
--
-- Description: get list of Stair Flights  available in current context
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]  [Description]
--    ARRAY        dbref array of Stair Flight  template
--
------------------------------------------------------------------------

define method .getTemplates() is ARRAY

  !templates = ARRAY()

  -- get subSetting data from central data
  !subSetting = !!aslCentralData.getSetting(!this.settingReference).subSettings
  !indx = !subSetting.evaluate(object BLOCK('!subSetting[!evalIndex].purpose')).findfirst('STRFLT')
  if(!indx.unset()) then
     !!alert.error('Current Setting does not have templates for STRFLT')
     return
  endif

  !settingData = !subSetting[!indx].settingData

  do !data values !settingData
      !tmplRef = !data.value.dbref()
      !templates.append(!tmplRef)
  enddo

  return !templates

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      setTemplateReference
--
-- Description: Sets Template Reference, Stringer  Template and Tread Template
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]  [Description]
--    DBREF       Stair Flight  template
--
------------------------------------------------------------------------
define method .setTemplateReference(!tmplReference is DBREF)

  -- set tmpl ref.
  !this.tmplReference = !tmplReference

 --get the elements in  Template reference
  !this.stringerTemplates = !this.readElements('GENSEC' , !tmplReference)
  !this.treadTemplates     = !this.readElements('TREAD' ,!tmplReference)

    if !this.lHandrail.rpath.set() then
      -- re-route handrail as stringers may have been changed
      !this.handrailPath()
    endif

endmethod

-- End of method
------------------------------------------------------------------------
--
-- Method:      readElements
--
-- Description: collects elements of passed type from the owner element
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]  [Description]
--    STRING        type of elements to collect
--    DBREF          scope element under which element of type are collected
------------------------------------------------------------------------
define method .readElements(!type is STRING) is ARRAY

  -- collect elements
  !elements = !this.readElements(!type , '' , !this.refe)

  return !elements

endmethod

-- End of method
------------------------------------------------------------------------
--
-- Method:      readElements
--
-- Description: collects elements of passed type from the owner element
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]  [Description]
--    STRING        type of elements to collect
--    DBREF          scope element under which element of type are collected
------------------------------------------------------------------------
define method .readElements(!type is STRING , !scope  is DBREF) is ARRAY

  -- collect elements
  !elements = !this.readElements(!type , '' , !scope)

  return !elements

endmethod

-- End of method
------------------------------------------------------------------------
--
-- Method:      readElements
--
-- Description: collects elements of passed type that satisfies the filter from the owner element
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]  [Description]
--    STRING        type of elements to collect
--    STRING        filter for collection
--    DBREF          scope element under which element of type are collected
------------------------------------------------------------------------
define method .readElements(!type is STRING , !filter is STRING , !scope  is DBREF) is ARRAY

  !coll              = object COLLECTION()

  !typeFilter        = 'TYPE eq |$!type|'

  -- include filter along with filter for type.
  -- collection type does not
  if(!filter.empty().not() ) then
    !expString         = !typeFilter & | AND | & !filter
  else
    !expString         = !typeFilter
  endif

  !filterExpression  = object EXPRESSION(!expString)

  !coll.scope(!scope)
  !coll.filter(!filterExpression)

  !elements          = !coll.results()

  return !elements

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:             evalSegments
--
-- Description:   Engine that calculates the flights based on the criteria
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evalSegments()  is BOOLEAN

    -- calculate the going along each leg
    !this.calcFlightsGoing()
     handle any
     	return FALSE
     endhandle	

    -- calculate the oRise along each leg based on going. Need to adjust  later based on calculated rise
    !this.calcFlightsRise()
    handle any
    	return FALSE
    endhandle 	

    !this.setMinExtensions()

  -- Calculate number of flights and treads also
  !treadRise         = !this.calcTreadRise()
  if (!treadRise.eq(0) ) then
     return FALSE
     !!alert.error('Not able to evaluate rise for a tread')
  endif

  if (!this.calcRiseGoing(!treadRise).not() ) then
   return FALSE
  endif

  if (!this.rise.set() ) then
    !evalSuccess = TRUE
  else
    !evalSuccess = FALSE
  endif

  return !evalSuccess

 endmethod
------------------------------------------------------------------------
--
-- Method: calcRiseGoing
--
-- Description: rise value is used recursively and get the going based on the number of treads calculated from the rise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calcRiseGoing(!rise is REAL) is BOOLEAN

  if  ( !this.checkOgoing(!rise) ) then
     if  ( !this.evalGoing(!rise ) ) then
        !this.rise  = !rise
        !this.lRise = !rise
        !this.assignValues()
     else
        !oNumSteps    = !this.numberOfSteps + 1
        !calcRise     = !this.oRise / !oNumSteps
        !rise         = !this.calcTreadRise(!calcRise , TRUE)
        if (!this.isValid('RISE' , !rise).eq(0) ) then
           !this.calcRiseGoing(!rise)
        endif
        return  FALSE
     endif
  else
    return FALSE
  endif

  return TRUE

 endmethod

------------------------------------------------------------------------
--
-- Method:checkOgoing
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkOgoing (!rise is REAL ) is BOOLEAN

 !treadRise            = !rise

  -- going available for flights excluding  than the turns
  !availableGoing    = !this.oGoing - ( (!this.flightLegs.size() - 1) * !this.width )

  --exclude length necessary for turns if the extensions are not along the flight direction of attached flights
  if (!this.lExtension.gt(0) and !this.lExtnDirection.opposite().neq(!this.flightLegs[1].fltDirection) )then
    !availableGoing = !availableGoing - (!this.width / 2)
  endif
  if (!this.uExtension.gt(0) and !this.uExtnDirection.neq(!this.flightLegs.last().fltDirection) )then
    !availableGoing = !availableGoing - (!this.width / 2)
  endif

  -- Calculate the minimum required so that have enough going to create flights
  !minGoingByPitch   = !this.oRise / tan(!this.criteria.pitch.max())
  -- *** dependent on the steps
  !minGoingByTreads  = (!this.numberOfSteps * !this.criteria.going.min())
  !minGoing          = max ( !minGoingByPitch , !minGoingByTreads )
  !minGoing          = !minGoing + ( (!this.numberOfFlts - !this.flightLegs.size()) * !this.criteria.fltIntLngLength.min() )
   -- return if the available going is not sufficient
  if (!minGoing.gt(!availableGoing) ) then
    !oGoing          = !this.oGoing.string('D2').real()
    !fltDirString    = ''
    do !legInx indices !this.flightLegs
      !fltDirString  = !fltDirString & ' ' & !this.flightLegs[!legInx].fltDirection.string() & ' '
    enddo
    !!alert.error('Available going is less than the required minimum going along direction $!fltDirString')
    return false
  endif

  return true

endmethod
------------------------------------------------------------------------

define method .evalGoing(!rise is REAL) is BOOLEAN

   -- flag for individual Leg no Extension
   do !legCnt indices !this.flightLegs
     !noExtensionFlag[!legCnt] = FALSE
   enddo

   -- set the last Leg no Extension flag  ( No Extension / Bottom)
   if (!this.extnOption.eq(1) or !this.extnOption.eq(0)  ) then
       !noExtensionFlag[!noExtensionFlag.maxIndex()] = TRUE
   endif

   -- set the first Leg no Extension flag  ( No Extension / Top)
   if (!this.extnOption.eq(2) or !this.extnOption.eq(0)  ) then
       !noExtensionFlag[1] = TRUE
   endif

  -- start with minimum going and Intermediate Landing Length
do !legInx indices !this.flightLegs

    !availableLegGoing    = !this.flightLegs[!legInx].oGoing
    if (!legInx.eq(1) and !this.lExtension.gt(0) and !this.lExtnDirection.isParallel(!this.flightLegs[1].fltDirection).not()  )then
        !availableLegGoing = !availableLegGoing - (!this.width / 2)
    endif
    if (!legInx.eq(!this.flightLegs.maxIndex()) and !this.uExtension.gt(0) and !this.uExtnDirection.neq(!this.flightLegs.last().fltDirection) )then
      !availableLegGoing = !availableLegGoing - (!this.width / 2)
    endif
    if ( defined ( !this.flightLegs[!legInx - 1] ) ) then
      !availableLegGoing = !availableLegGoing  - (!this.width / 2)
    endif
    if ( defined ( !this.flightLegs[!legInx + 1] ) ) then
      !availableLegGoing = !availableLegGoing  - (!this.width / 2)
    endif

    !numOfTreads      = !this.flightLegs[!legInx].numOfTreads
    --1
    if (!numOfTreads.gt(0) ) then
      !flightsInLeg     = !this.calcNumOfFlts(!numOfTreads)
      !goingVal           =  !this.criteria.going.min()
      !lngLength          = !this.criteria.fltIntLngLength.min()

      !minLegGoing =    ( (!numOfTreads  * !goingVal ) +  ( (!flightsInLeg - 1)  * !lngLength) )

      if (!minLegGoing.gt(!availableLegGoing) ) then
         !fltLegDirection = !this.flightLegs[!legInx].fltDirection
         !!alert.error('Available going is less than the required minimum going along the direction $!fltLegDirection')
         return false
      endif

      -- use optimum going if it is less than the available going, remaining length will be Extension
      !optimumGoing =  ( (!numOfTreads  * !this.criteria.going.optimum() ) +  ( (!flightsInLeg - 1)  * !this.criteria.fltIntLngLength.optimum() ) )
        if (!availableLegGoing.gt(!optimumGoing) and (!noExtensionFlag[!legInx].not() ) ) then

        !goingVal = !this.criteria.going.optimum()
        !lngLength = !this.criteria.fltIntLngLength.optimum()

        !this.flightLegs[!legInx].going = !goingVal
        !this.flightLegs[!legInx].uLndgLength = !lngLength
        !success     = TRUE

        !this.rise  = !rise
        !this.lRise = !rise
      else
        -- loops through and finds the Intermediate landing length and going for this leg
        -- remember rise is common for all legs
        !val =  !this.calcLegGoing(!availableLegGoing , !goingVal , !lngLength, !numOfTreads , !flightsInLeg)

         if (!val[1].eq(TRUE) ) then
           !this.flightLegs[!legInx].going = !val[2]
           !this.flightLegs[!legInx].uLndgLength = !val[3]
           !success = TRUE
         else
           !success = FALSE
           return FALSE
        endif
      endif
    endif
   enddo


   if(undefined (!success ) ) then
     !success = FALSE
   else
     !success = TRUE
     !this.assignValues()
   endif

    return !success

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assignValues()  is BOOLEAN
   do !i indices !this.flightLegs
       !lngLengths[!i] = !this.flightLegs[!i].uLndgLength
   enddo
   !this.flights.clear()
   -- create individual flights from calculated values
  !this.createSingleFlights('CREATE'  , !lngLengths)
  !this.setExtensions()

   return TRUE

 endmethod
------------------------------------------------------------------------
--
-- Method: setMinExtensions
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMinExtensions() is BOOLEAN

   !minExtn = !this.criteria.fltIntLngLength.min()

   -- set the lower Extension
   if ( (!this.extnOption.eq(1) or !this.extnOption.eq(3)  ) and (!this.lExtnDirection.isParallel(!this.flightLegs[1].fltDirection)) ) then
       !this.lExtension = !minExtn
       !firstLeg = !this.flightLegs[1]
       !firstLeg.oGoing = !firstLeg.oGoing - !minExtn
       !this.flightLegs[1] = !firstLeg
   endif

   -- set the upper Extension
   if ((!this.extnOption.eq(2) or !this.extnOption.eq(3) ) and (!this.uExtnDirection.isParallel(!this.flightLegs.last().fltDirection)))then
       !this.uExtension = !minExtn
       !lastLeg = !this.flightLegs.last()
       !lastLeg.oGoing = !lastLeg.oGoing - !minExtn
       !this.flightLegs[!this.flightLegs.maxIndex()] = !lastLeg
   endif


endmethod
------------------------------------------------------------------------
--
-- Method: setExtensions
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setExtensions() is BOOLEAN

   -- calculate the remaining Length of  the Leg other than the flight going and landing length and assign as Extension
   !fltCount = 0
   do !i indices !this.flightLegs

       !length = 0
        !fltStartCnt = !fltCount + 1
        do !j to  !this.flightLegs[!i].numOfFlights
         !fltCount = !fltCount + 1
         !flight   = !this.flights[!fltCount]
         !length   = !length +  !flight.lLndgLength  + !flight.oGoing + !flight.uLndgLength
       enddo

       -- calculate the difference
     !diff[!i] = !this.flightLegs[!i].oGoing - !length

   enddo

  !fltCount = 0
   do !i indices !this.flightLegs
       -- first flight in the leg
       !fltStartCnt = !fltCount + 1
       -- last flight  in the leg
       !fltCount    = !fltCount + !this.flightLegs[!i].numOfFlights

       -- any thing other than the first and last  split to the top and bottom
   if (!i.neq(1) and !i.neq(!this.flightLegs.size() ) ) then
       !this.flights[!fltStartCnt].lLndgLength  = !this.flights[!fltStartCnt].lLndgLength + ( !diff[!i] / 2)
       !this.flights[!fltCount].uLndgLength     = !this.flights[!fltCount].uLndgLength + ( !diff[!i] / 2)
   else
     -- work out for the first and last segments
     -- if it is just one leg then both first and last are the same
     if (!this.flightLegs.size().eq(1)  and (!this.extnOption.eq(0) or !this.extnOption.eq(3) ) ) then
       !legDiff = !diff[!i] / 2
     else
       !legDiff = !diff[!i]
     endif

     if (!this.extnOption.eq(0) ) then
         if (!i.eq(1))  then
          -- last flight of first leg
           !this.flights[!fltCount].uLndgLength = !this.flights[!fltCount].uLndgLength + !legDiff
         endif
         if (!i.eq(!this.flightLegs.size()) ) then
          -- first flight of last leg
          !this.flights[!fltStartCnt].lLndgLength  = !this.flights[!fltStartCnt].lLndgLength + !legDiff
         endif
     elseif (!this.extnOption.eq(1) ) then
         if (!i.eq(1) or !i.eq(!this.flightLegs.size()) )  then
          !this.flights[!fltStartCnt].lLndgLength    = !this.flights[!fltStartCnt].lLndgLength + !legDiff
         endif
     elseif (!this.extnOption.eq(2) ) then
         if (!i.eq(1) or !i.eq(!this.flightLegs.size()) )  then
          !this.flights[!fltCount].uLndgLength    = !this.flights[!fltCount].uLndgLength + !legDiff
         endif
     elseif (!this.extnOption.eq(3) ) then
         if (!i.eq(1) ) then
           !this.flights[!fltStartCnt].lLndgLength = !this.flights[!fltStartCnt].lLndgLength + !legDiff
         endif
         if (!i.eq(!this.flightLegs.size()) ) then
           !this.flights[!fltCount].uLndgLength    = !this.flights[!fltCount].uLndgLength + !legDiff
         endif
     endif
   endif

   enddo

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:        evaluate
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .evaluate(!flightOption is STRING ) is BOOLEAN

   !this.flights.clear()
   !this.flightLegs.clear()

   if(!flightOption.eq('')) then
     !!alert.error('Flight configuration not set.')
     return
   endif

   if(!this.pickedPosData.unset() ) then
     !!error.text  = 'LWP and UWP not defined for Stair flight'
     return false
   elseif(!this.pickedPosData.size() eq 1 ) then
     !!error.text  = 'Either LWP or UWP not defined for Stair flight'
     return false
   endif

  -- Calculate the Overall rise
   !oRise     = !this.getRise(!this.pickedPosData[1].position , !this.pickedPosData[2].position)

   if (!oRise.eq(0) ) then
     !!alert.error('LWP and UWP are at the same elevation')
     return FALSE
   endif

   if (!this.isValid('ORISE' , !oRise).neq(0) ) then
   	 !!alert.error(!!error.text)
     return FALSE
   else
     !this.oRise = !oRise
   endif	

   -- direction between picked points
   !dirBetweenPicks    = !this.getFlightDirection(!this.pickedPosData[1].position , !this.pickedPosData[2].position)
   handle ANY
     !!alert.error('Cannot create Stair Flight in vertical direction. Provide horizontal offset for Going')
     return FALSE
   endhandle

   -- Having checked the basic assign the type of flight
   !this.instOptions = !flightOption

   -- create legs based on Overall dimensions. Basis from which individual flights are calculated
   !this.buildLegs(!dirBetweenPicks)

   if ( !this.evalSegments().not() ) then
     return FALSE
   endif

   -- create RPATH from calculated Flights
   !this.createRpath()

   -- update additional attributes of a flight
   !this.flightsUpdate()

  -- generate left/right stringer path
  !this.stringerPath()

   -- generate handrail path from the rpath and width
   !this.handrailPath()

  -- display graphics
   !this.showVolFeedback()

   return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reEvaluate
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reEvaluate(!lockedAtt is STRING , !value is ANY) is BOOLEAN

 !this.oRise     = !this.getRise(!this.uwp , !this.lwp)

 if (!this.flightLegs.set().not() ) then
    !this.flightLegsUpdate()
    !this.numberOfFlts = !this.flights.size()
 endif

 !this.fltDirection = !this.flights[1].fltDirection

 !this.flights.clear()

 if(!lockedAtt.upcase().eq('RISE') ) then
 -- work out the tread rises and lrise first
   !treadRise = !value
   !numOfSteps       =   !this.calcNumOfSteps(!treadRise)

   -- remaining height to be set as lRise

   -- calculate the rise for the steps excluding the first step and calculate the lrise
   !lRise           = !this.oRise - ((  !numOfSteps - 1) *    !treadRise )


 else
    !treadRise    = !this.rise
    !lRise        = !this.lRise
 endif

-- adjust the Overall Rise for each leg
 do !i indices !this.flightLegs

   if (!i.eq(1) ) then
      !this.flightLegs[!i].oRise = !this.flightLegs[!i].oRise - !lRise
   endif

   !stepsInLeg[!i]          = NINT(!this.flightLegs[!i].oRise / !treadRise)
   !numOfFlts[!i]           = !this.calcNumOfFlts(!stepsInLeg[!i])
   !fltSteps[!i]            = !this.calcFlightSteps(!numOfFlts[!i] , !stepsInLeg[!i] , FALSE)
   !stepsInLeg[!i]          = !this.sum(!fltSteps[!i])

   -- assign the values to the leg
   !this.flightLegs[!i].numOfTreads   = !stepsInLeg[!i]
   !this.flightLegs[!i].numOfFlights  = !numOfFlts[!i]

   if (!i.eq(1) ) then
     !this.flightLegs[!i].oRise  = ( !stepsInLeg[!i]  * !treadRise)    + !lRise
     !stepsInLeg[!i]             = !stepsInLeg[!i]+ 1
   else
     !this.flightLegs[!i].oRise  = ( !this.flightLegs[!i].numOfTreads  * !treadRise)
   endif

  enddo
  -- assign to the
  !numberOfFlts    = !this.sum(!numOfFlts)
  !numberOfSteps   = !this.sum( !stepsInLeg)

  if (!numberOfSteps.neq(!numOfSteps ) ) then
    !!alert.message('Spread out steps not equal with the required number of steps. Inform your administrator.')
  endif

 !this.numberOfSteps = !numberOfSteps
 !this.numberOfFlts  = !numberOfFlts

 if  ( !this.checkOgoing(!treadRise).not()  ) then
   return FALSE
 endif

  -- going with optimum values
  !optimumGoing       =  (!numberOfSteps  * !this.criteria.going.optimum() ) +  ( (!numberOfFlts - !this.flightLegs.size()) * !this.criteria.fltIntLngLength.optimum()) + ( (!this.flightLegs.size() - 1 ) * !this.width)

  -- start with minimum going and Intermediate Landing Length
  !goingVal           =  !this.criteria.going.min()
  !lngLength          = !this.criteria.fltIntLngLength.min()

  -- main  calculation starts here
  do !legInx  indices !this.flightLegs
    !availableLegGoing   = !this.flightLegs[!legInx].oGoing
    if ( defined ( !this.flightLegs[!legInx - 1] ) ) then
      !availableLegGoing = !availableLegGoing  - (!this.width / 2)
    endif
    if ( defined ( !this.flightLegs[!legInx + 1] ) ) then
       !availableLegGoing = !availableLegGoing  - (!this.width / 2)
    endif

    -- number of treads in the Leg
    !numOfTreads      = !this.flightLegs[!legInx].numOfTreads

    if (!numOfTreads.gt(0) ) then

      !flightsInLeg     = !this.calcNumOfFlts(!numOfTreads)
      !minLegGoing =    ( (!numOfTreads  * !goingVal ) +  ( (!flightsInLeg - 1)  * !lngLength) )
      if (!minLegGoing.gt(!availableLegGoing) ) then
         !fltLegDirection = !this.flightLegs[!legInx].fltDirection
         !!alert.error('Available going $!availableLegGoing is less than the required minimum going $!minLegGoing along the direction $!fltLegDirection')
         return false
      endif

      -- use optimum going if it is less than the available going, remaining length will be Extension
      !optimumLegGoing =  ( (!numOfTreads  * !this.criteria.going.optimum() ) +  ( (!flightsInLeg - 1)  * !this.criteria.fltIntLngLength.optimum()) )
      if(!availableLegGoing.gt(!optimumLegGoing) ) then
        !goingVal = !this.criteria.going.optimum()
        !lngLength = !this.criteria.fltIntLngLength.optimum()

        !this.flightLegs[!legInx].going = !goingVal
        !this.flightLegs[!legInx].uLndgLength = !lngLength
      else
         -- loops through and finds the Intermediate landing length and going for this leg
         -- remember rise is common for all legs
         !val = !this.calcLegGoing(!availableLegGoing , !goingVal , !lngLength, !numOfTreads , !flightsInLeg)
         if (!val[1].eq(TRUE)  or !this.noExtension.not() ) then
           !this.flightLegs[!legInx].going = !val[2]
           !this.flightLegs[!legInx].uLndgLength = !val[3]
           !success = TRUE
         endif
      endif

    else
      !fltDirection = !this.flightLegs[!legInx].fltDirection
      !!alert.error('Zero steps along the direction $!fltDirection, Can not create stair flight')
      return FALSE
    endif

  enddo

  -- assign calculated values to the object
  !this.rise =  !treadRise
  !this.lRise  = !lRise
  !this.going =  !goingVal
  !this.fltDirection = !this.flightLegs[1].fltDirection

  !this.assignValues()

   -- create RPATH from calculated Flights
  !this.createRpath()

   -- update additional attributes of a flight
   !this.flightsUpdate()

  -- generate left/right stringer path
  !this.stringerPath()

   -- generate handrail path from the rpath and width
  !this.handrailPath()

  -- display graphics
 !this.showVolFeedback()

 return true

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      setSense(mode is BOOLEAN)
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSense(!turn is BOOLEAN ) is BOOLEAN

  !this.sense = !this.sense()
  handle ANY
    return FALSE
  endhandle

  if (!this.sense.set() and !this.sense.neq(!turn) and !this.flightLegs.size().gt(1) and !this.flights.set() ) then
    if (!this.flightLegs.size().eq(2) ) then
      !temp = !this.flightLegs[2].fltDirection
      !this.flightLegs[2].fltDirection = !this.flightLegs[1].fltDirection
      !this.flightLegs[1].fltDirection = !temp
    else
      !temp = !this.flightLegs[3].fltDirection
      !this.flightLegs[3].fltDirection = !this.flightLegs[1].fltDirection
      !this.flightLegs[1].fltDirection = !temp

      !this.utypeNorPlane.position = !this.pickedPosData[1].position.offset(!this.flightLegs[1].fltDirection , !this.utypeNorLength)
      !oriYdir                     = !this.utypeNorPlane.orientation.ydir()
      !oriZdir                     = !this.utypeNorPlane.direction().opposite()
      !newOri                      = object ORIENTATION( |y is $!oriYdir and z is $!oriZdir| )
      !this.utypeNorPlane.orientation  = !newOri

    endif

    !this.lExtnDirection             = !this.flightLegs[1].fltDirection.opposite()

    -- setting the direction of the last flight leg
    !this.uExtnDirection             = !this.flightLegs.last().fltDirection

    !this.flights.clear()
    !this.rpath.aslRpath()

    if (!this.evalSegments().not() ) then
    	return FALSE
    endif	

    -- create RPATH from calculated Flights
    !this.createRpath()

    -- update additional attributes of a flight
    !this.flightsUpdate()

    -- generate left/right stringer path
    !this.stringerPath()

    -- generate handrail path from the rpath and width
    !this.handrailPath()

    -- display graphics
    !this.showVolFeedback()
  endif

  !this.sense = !turn

  return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      setSense(mode is BOOLEAN)
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDirection() is BOOLEAN

  	!entryPoint      = !this.pickedPosData[1].position
    !exitPoint       = !this.pickedPosData[2].position

    !fltDirection    = !this.getFlightDirection(!entryPoint , !exitPoint)

    !this.flights.clear()
    !this.rpath.aslRpath()

   -- create legs based on Overall dimensions. Basis from which individual flights are calculated
   !this.buildLegs(!fltDirection)

   if ( !this.evalSegments().not() ) then
     return FALSE
   endif

   -- create RPATH from calculated Flights
   !this.createRpath()

   -- update additional attributes of a flight
   !this.flightsUpdate()

  -- generate left/right stringer path
  !this.stringerPath()

   -- generate handrail path from the rpath and width
   !this.handrailPath()

  -- display graphics
   !this.showVolFeedback()

   return true

endmethod
------------------------------------------------------------------------
--
-- Method:      modifyElevation
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyElevation(!elevIndx is REAL , !newElev is REAL) is BOOLEAN

 -- Height of the flight is reduced
 if (!this.flights[!elevIndx].uwp.up.gt(!newElev))  then
   if (!this.flights[!elevIndx].lwp.up.gt(!newElev)) then
     !!alert.error('Elevation lies lower than the Lower Working Point of the Flight')
     return false
   endif

 else
   -- Height of the flight is increased
   if (!this.flights[!elevIndx + 1].uwp.up.lt(!newElev))  then
     !!alert.error('Elevation lies above the Upper Working Point of the next Flight')
     return FALSE
   endif
 endif

 !flightsToModify = !this.flights.from( !elevIndx , 2)

 !botFlightSteps = !this.calcNumOfSteps( abs (!flightsToModify[1].lwp.up - !newElev ) , !this.rise)
 !topFlightSteps = !this.calcNumOfSteps( abs (!newElev - !flightsToModify[2].lwp.up) , !this.rise)

 if (!this.isValid('TREADS' , !botFlightSteps).neq(0) ) then
  !!alert.error('Number of Steps in the flight on the lower side does not match the Criteria')
  return FALSE
 endif

 if (!this.isValid('TREADS' , !topFlightSteps).neq(0) ) then
    !!alert.error('Number of Steps in the flight on the upper side after modification does not match the Criteria')
    return FALSE
 endif

 !intPlanePos     = !flightsToModify[1].uwp
 !intPlanePos.up  = !newElev
 !intPlane        = object PLANE(!intPlanePos , z is U)

 !botVector       = object POINTVECTOR(!flightsToModify[1].lwp , (!flightsToModify[1].lwp.direction(!flightsToModify[1].uwp) ) )
 !topVector       = object POINTVECTOR(!flightsToModify[2].uwp , (!flightsToModify[2].uwp.direction(!flightsToModify[2].lwp) ) )

 !botUwp          = !intPlane.intersection(!botVector)
 !topLwp          = !intPlane.intersection(!topVector)

 !this.flights[!elevIndx].uwp = !botUwp
 !this.flights[!elevIndx + 1].lwp = !topLwp

 !this.flights[!elevIndx].update()
 !this.flights[!elevIndx + 1].update()

 !this.flightLegsUpdate()

 !this.createRpath()

 !this.stringerPath()

 !this.handrailPath()

 !this.showVolFeedback()

 return TRUE

endmethod

--------------------------------------------------------------------------
-- Method:shiftTreads
--
-- Description:used to shift particular number of treads from one flight to one above it
--             remember it may be positive or negative
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .shiftTreads(!lowFlightIndx is REAL , !treadsToShift is REAL)

  !botFlight     = !this.flights[!lowFlightIndx]
  -- offset number of times of rise and going
  !botFlightUwp  = !botFlight.uwp.offset(!botFlight.fltDirection , (!treadsToShift * !botFlight.going )).offset(u , (!treadsToShift * !this.rise ))

  -- work out the offset direction and distance for the next flight and landings
  !shiftDir      = !botFlight.uwp.direction(!botFlightUwp)
  handle ANY
   -- to handle an issue in grid-control gadget of the form
   return	
  endhandle	
  !shiftDist     = !botFlight.uwp.distance(!botFlightUwp)


  !this.flights[!lowFlightIndx].uwp = !botFlightUwp

  !this.flights[!lowFlightIndx].ulndg = !this.flights[!lowFlightIndx].ulndg.offset(!shiftDir , !shiftDist)
  handle ANY
  endhandle 	

  !topFlightIndx = !lowFlightIndx + 1
  !this.flights[!topFlightIndx].lwp         = !this.flights[!topFlightIndx].lwp.offset(!shiftDir , !shiftDist)

  !this.flights[!topFlightIndx].llndg       = !this.flights[!topFlightIndx].llndg.offset(!shiftDir.opposite() , !shiftDist)
  handle ANY
  endhandle

  !this.flights[!lowFlightIndx].numOfTreads = !this.flights[!lowFlightIndx].numOfTreads + !treadsToShift
  !this.flights[!topFlightIndx].numOfTreads = !this.flights[!topFlightIndx].numOfTreads - !treadsToShift

  !this.flights[!lowFlightIndx].update()
  !this.flights[!topFlightIndx].update()

  !this.modifyLandings()

endmethod
--------------------------------------------------------------------------
-- Method:      modifyLandings
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyLandings()

 !this.flightLegsUpdate()

 !this.createRpath()

  -- generate left/right stringer path
  !this.stringerPath()

 !this.handrailPath()

 !this.showVolFeedback()

 endmethod
------------------------------------------------------------------------
--
-- Method:      isValid
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isValid(!property is STRING , !value is REAL) is REAL

  -- reduce the expression length
  !criterion   = !this.criteria.attribute(!property.upcase())
  !criterion.checkValue(!value)
  handle 1
     return 1
  elsehandle 2
    return 2
  elsehandle 3
    return 3
  elsehandle NONE
     return 0
  endhandle
endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      calcFlightsGoing
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calcFlightsGoing()

  if (!this.instOptions.neq('U-SHAPED') ) then
      do !j indices !this.flightLegs
       !this.flightLegs[!j].oGoing = !this.getGoing(!this.pickedPosData[1].position , !this.pickedPosData[2].position , !this.flightLegs[!j].fltDirection)
      enddo
  else
      -- method called does calculation of the Overall Going of all the Legs and summing up so need not come to this method again.
      if ( !this.utypeNorLength.eq(0)) then
      !this.getUshapedOptOgoing()
      return
      endif

    !entryPoint      = !this.pickedPosData[1].position
    !exitPoint       = !this.pickedPosData[2].position

    -- position the Normal Plane
    !this.utypeNorPlane.position = !entryPoint.offset(!this.flightLegs[1].fltDirection , !this.utypeNorLength)

    !botPerpPt       = !this.utypeNorPlane.near(!entryPoint)
    !topPerpPt       = !this.utypeNorPlane.near(!exitPoint)

    if (!topPerpPt.direction(!exitPoint).neq(!this.flightLegs[3].fltDirection ) )then
      write ('Cannot create Stair Flight with provided direction and Normal Length')
      return error 1 'Cannot create Stair Flight with provided direction and Normal Length'
    endif

    !this.flightLegs[1].oGoing =   !this.getGoing(!entryPoint , !botPerpPt)
    !this.flightLegs[2].oGoing =   !this.getGoing(!botPerpPt , !topPerpPt)
    !this.flightLegs[3].oGoing =   !this.getGoing(!exitPoint , !topPerpPt)

  endif

 !oGoing = 0
 do !i indices !this.flightLegs
    !oGoing =  !oGoing + !this.flightLegs[!i].oGoing
 enddo

 if (!this.isValid('OGOING' , !oGoing).neq(0) ) then
 	  !errorText = !!error.text
     return error 2  |$!errorText|
 else
   !this.oGoing = !oGoing
 endif

 endmethod
-- End of method definition

-------------------------------------------------------------------------
--
-- Method:      calcFlightsRise
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
 ------------------------------------------------------------------------

define method .calcFlightsRise()

!availableGoing = 0
do !legInx indices !this.flightLegs

    !availableLegGoing[!legInx]    = !this.flightLegs[!legInx].oGoing

    if (!legInx.eq(1) and !this.lExtension.gt(0) and !this.lExtnDirection.isParallel(!this.flightLegs[1].fltDirection) )then
        !availableLegGoing[!legInx] = !availableLegGoing[!legInx] - (!this.width / 2)
    endif
    if (!legInx.eq(!this.flightLegs.maxIndex()) and !this.uExtension.gt(0) and !this.uExtnDirection.isParallel(!this.flightLegs.last().fltDirection) )then
      !availableLegGoing[!legInx] = !availableLegGoing[!legInx] - (!this.width / 2)
    endif
    if ( defined ( !this.flightLegs[!legInx - 1] ) ) then
      !availableLegGoing[!legInx] = !availableLegGoing[!legInx]  - (!this.width / 2)
    endif
    if ( defined ( !this.flightLegs[!legInx + 1] ) ) then
       !availableLegGoing[!legInx] = !availableLegGoing[!legInx]  - (!this.width / 2)
    endif
    !availableGoing = !availableGoing + !availableLegGoing[!legInx]
 enddo

 do !legInx indices !this.flightLegs
    !this.flightLegs[!legInx].oRise  = ( !availableLegGoing[!legInx] / !availableGoing ) *  !this.oRise
 enddo

 endmethod
--End of method definition

------------------------------------------------------------------------
-- Method:      readFlights
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readFlights()

 !this.flights.clear()
 !this.flightLegs.clear()

  -- Set extensions to zero as default
 !this.lExtension  =  0
 !this.uExtension = 0

  !edges = !this.rpath.edges(FALSE)
  !fltNum = 0
  !rise     = TRUE
  !planeEdges = ARRAY()
  do !edge values  !edges
     if (!rise ) then
         if (!this.flights.size().gt(0) )then
            !planeEdges.append(!lndgEdges)
        endif
       !fltNum                            = !fltNum + 1
        !lndgEdges  = object ARRAY()
     endif

     if (!edge.objectType().eq('LINE') ) then
       if (!edge.direction().up.neq(0) ) then
         -- it is a rise
         !rise   = TRUE
         !flight  =  object ASLFLIGHT()
         -- store so that single tread set without landings is not missed in the do loop of Levels
         !flight.lwp = !edge.startposition
         !flight.uwp = !edge.endposition
         !flight.fltDirection = !flight.evalFltDirection()
         !this.flights.append(!flight)
       else
         !rise  = FALSE
        !lndgEdges.append(!edge)
      endif
    endif
  enddo

  -- add edges of the last landing
  if (!lndgEdges.set() ) then
     !planeEdges.append(!lndgEdges)
  endif

  if ( (!planeEdges.size() - 1) neq ( !this.flights.size() ) ) then
    !planeEdges[!planeEdges.maxIndex()  + 1] = ARRAY()
  endif

  if (!planeEdges.unset() ) then
     if ( !this.flights.size().eq(1) ) then
         !this.flights[1].lLndgLength = 0
         !this.flights[1].uLndgLength = 0
      endif
  endif

 if (!planeEdges[1].size().gt(0))  then
   !extnLine      = !planeEdges[1][1]
   if (!extnLine.direction().isParallel(!this.flights[1].fltDirection ).not() ) then
   !this.lExtension =  !extnLine.length()
   !this.lExtnDirection =!extnLine.direction().opposite()
   !planeEdges[1].removeFirst()
 endif
 endif

 if(!planeEdges.size().eq(!this.flights.size() + 1 ) ) then
      if (!planeEdges.last().size().gt(0))  then
           !lLndgEdges = !planeEdges.last()
           !extnLine   = !lLndgEdges.last()
           if (!extnLine.direction().isParallel(!this.flights.last().fltDirection).not() ) then
           !this.uExtension =  !lLndgEdges.last().length()
           !this.uExtnDirection = !lLndgEdges.last().direction()
           !lLndgEdges.removeLast()
           !planeEdges[!planeEdges.maxIndex()]   = !lLndgEdges
      endif
 endif
 endif

 --planeEdges will be one less in number if there is no upper landing
-- first array will be empty if there is no lower extension
 do !i indices !planeEdges
    if (!planeEdges[!i].size().gt(0))  then
       !edges  = !planeEdges[!i]
        if (!i.eq(!planeEdges.size() ) ) then
             !this.flights[!i - 1].addulndg(!edges)
             !this.flights[!i - 1].uLndgDir = !edges[1].direction()
             !this.flights[!i - 1].uLndgLength = !edges[1].length()
             skip
        elseif(!i.neq(1) ) then
          -- setting the first segment alone as upper landing of prev flight provided it is not the first flight
          !this.flights[!i - 1].addulndg(!edges[1])
          !this.flights[!i - 1].uLndgDir = !edges[1].direction()
          !this.flights[!i - 1].uLndgLength = !edges[1].length()
          !edges.removeFirst()
        endif

        -- set from the second segment as lower landing
        if(!edges.size().gt(0) ) then
           !this.flights[!i].addllndg(!edges)
           !this.flights[!i].lLndgDir = !edges.last().direction().opposite()
           !this.flights[!i].lLndgLength = !edges.last().length()
        else
           -- only segment is already assigned as lower upper landing of previous flight
           !this.flights[!i].lLndgLength = 0
        endif

    else
       if (!i.neq(!planeEdges.size())) then
          !this.flights[!i].lLndgLength    = 0
       endif
       if (!i.gt(1)) then
         !this.flights[!i - 1].uLndgLength    = 0
        endif
    endif
 enddo

 -- calculate legs
  !this.lwp  = !this.flights[1].lwp
  !this.uwp = !this.flights.last().uwp

  !this.flightsUpdate()

  !this.flightLegsUpdate()

  -- update the sense
  if (!this.flightLegs.size().gt(1) ) then
   !this.sense = !this.sense()
  endif

    -- update the Normal Plane
  if (!this.flightLegs.size().eq(3) ) then
  	
   !lPos        =     !this.rpath.vertex[1]
   !normalDir   = !this.flights[1].fltDirection

   -- first flight in the middle leg
   !midLegBotFlight = !this.flights[!this.flightLegs[1].numOfFlights + 1 ]
   !normalPt        = !midLegBotFlight.lwp

   !normalPlane            = object PLANE(!normalPt , z is $!normalDir )
   !this.utypeNorLength    = !normalPlane.near(!lPos).distance(!lPos)

   !normalPlane.position   =  !lPos.offset(!normalDir , !this.utypeNorLength)
   !this.utypeNorPlane     = !normalPlane

  endif

  -- Calculate the overall Rise and Going
  !this.oRise = !this.getRise(!this.uwp,!this.lwp)

  -- Calculate the overall Going
  !oGoing = 0
  do !i indices !this.flightLegs
     !oGoing = !oGoing + !this.flightLegs[!i].oGoing
  enddo

  if(!this.lExtnDirection.set() ) then
    if (!this.lExtnDirection.isParallel(!this.flights[1].fltDirection) ) then
      !oGoing = !oGoing + !this.lExtension
    endif
  else
   !this.lExtnDirection = !this.flights[1].fltDirection.opposite()
   !this.lExtension     = 0
  endif
  if(!this.uExtnDirection.set() ) then
    if (!this.uExtnDirection.isParallel(!this.flights.last().fltDirection) ) then
      !oGoing = !oGoing + !this.uExtension
    endif
  else
     !this.uExtnDirection = !this.flights.last().fltDirection
     !this.uExtension     = 0
  endif

  !this.oGoing = !oGoing

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      flightsUpdate
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flightsUpdate()

  !this.numberOfFlts     = !this.flights.size()
  !numOfSteps = 0
  do !i indices !this.flights
     !this.flights[!i].update()
     !numTreads  =  (!this.flights[!i].oRise / !this.rise) - 0.4999
     !this.flights[!i].numOfTreads = !numTreads.nint()
     !numOfSteps = !numOfSteps + !this.flights[!i].numOfTreads
     !this.flights[!i].going = !this.flights[!i].oGoing / !numTreads.nint()
  enddo
  !this.numberOfSteps = !numOfSteps

endmethod

-- End of method definition

------------------------------------------------------------------------
--
-- Method:      flightLegsUpdate
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flightLegsUpdate()

  !this.flightLegs.clear()

  !rise    = 0
  !going  = 0
  !numOfSteps = 0
  !numberOfFlts = 0
   do !i indices !this.flights
      !flight = !this.flights[!i]
      if (!i.eq(1) ) then
        !this.flightLegs[1] = object ASLFLIGHT()
        !this.flightLegs[1].fltDirection  = !flight.fltDirection
       endif
       if ( !flight.fltDirection.string().direction().neq( !this.flightLegs.last().fltDirection.string().direction() ) ) then
         !prevLeg = !this.flightLegs.last()
         !prevLeg.oRise  = !rise
         !prevLeg.oGoing = !going
         !prevLeg.numOfTreads = !numOfSteps
         !prevLeg.numOfFlights  = !numberOfFlts
         !this.flightLegs[!this.flightLegs.maxIndex()] = !prevLeg
         !flightLeg =  object ASLFLIGHT()
         !flightLeg.fltDirection  = !flight.fltDirection
         !this.flightLegs.append(!flightLeg)
         !rise    = !flight.oRise
         !going   = !flight.lLndgLength + !flight.oGoing + !flight.uLndgLength
         !numOfSteps = !flight.numOfTreads
         !numberOfFlts =   1
       else
         !rise  = !rise  + !flight.oRise
         !going = !going + !flight.lLndgLength + !flight.oGoing + !flight.uLndgLength
         !numOfSteps = !numOfSteps + !flight.numOfTreads
        !numberOfFlts = !numberOfFlts + 1
       endif
   enddo
  !lastLeg = !this.flightLegs.last()
  !lastLeg.oRise  = !rise
  !lastLeg.oGoing = !going + !this.uExtension
  !lastLeg.numOfTreads = !numOfSteps
  !lastLeg.numOfFlights  = !numberOfFlts
  !this.flightLegs[!this.flightLegs.maxIndex()] = !lastLeg

  -- add the lower extension also with the going

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      buildLegs
--
-- Description:Set directions of the Legs (Leg - series of flights along a direction)
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .buildLegs(!direction is DIRECTION) is STRING

  !config = !this.instOptions

  -- in-case the extensions are already defined unset them
  !this.lExtension = 0
  !this.uExtension = 0

  if (!config.eq('L-SHAPED') ) then

    !pickDirComp     = !direction.string().before('WRT').trim().split()
    if(!pickDirComp.size().gt(1) ) then

      do !i to  2
        !this.flightLegs[!i] = object ASLFLIGHT()
      enddo

      !this.flightLegs[1].fltDirection = !pickDirComp[1].direction()
      !this.flightLegs[2].fltDirection = !pickDirComp[3].direction()

      !calcSense = !this.sense()

      if (!calcSense.neq(!this.sense ) ) then
        -- swap the leg directions
           !this.flightLegs[1].fltDirection = !pickDirComp[3].direction()
           !this.flightLegs[2].fltDirection = !pickDirComp[1].direction()
      endif

    else
       -- assume this as a straight
      !!alert.warning('Points are along the Principal Axis, changing to STRAIGHT configuration')
      !this.flightLegs[1]             = object ASLFLIGHT()
      !this.flightLegs[1].fltDirection = !direction
      !config = 'STRAIGHT'
    endif

    !this.lExtnDirection = !this.flightLegs[1].fltDirection.opposite()
    !this.uExtnDirection = !this.flightLegs.last().fltDirection

  elseif(!config.eq('S-SHAPED') ) then

    !cordDir = !this.cordDir(!direction)
    if (!cordDir.neq(!direction) ) then
       !this.flightLegs[1]             = object ASLFLIGHT()
       !this.flightLegs[1].fltDirection = !cordDir
       !entryPoint      = !this.pickedPosData[1].position
       !exitPoint       = !this.pickedPosData[2].position
       !horVector       = object POINTVECTOR(!entryPoint  , !cordDir)
       !perpPlaneOri    = object ORIENTATION(|y is u and z is $!cordDir|)
       !topPtPerpPlane  = object PLANE( !exitPoint ,!perpPlaneOri)
       !topPt           =  !topPtPerpPlane.intersection(!horVector)

       -- point in the top plane calculated from  flight Direction  of entry. Need to get the extensions and locate the top working point
       !topPt.up        = !exitPoint.up
       !this.uExtnDirection  = !topPt.direction(!exitPoint)
       !this.lExtnDirection  = !this.uExtnDirection.opposite()
       !gap                  = !exitPoint.distance(!topPt)
       !this.lExtension      = !gap / 2
       !this.uExtension      = !gap / 2

    else
      -- assume this as a straight along Cardinal direction
      !!alert.warning('Points are along a Cardinal Axis $!cordDir, changing to STRAIGHT configuration')
      !this.flightLegs[1]             = object ASLFLIGHT()
      !this.flightLegs[1].fltDirection = !direction
      !config = 'STRAIGHT'
    endif

  elseif(!config.eq('U-SHAPED') ) then
  	
  	!entryPoint      = !this.pickedPosData[1].position
    !exitPoint       = !this.pickedPosData[2].position
    !fltDirection    = !this.getFlightDirection(!entryPoint , !exitPoint)
    if (!this.utypeNorPlane.unset() ) then
     if (!this.sense ) then
        !planeDir  = !direction.cross(D)
     else
        !planeDir  = !direction.cross(U)
     endif

     !plane = object PLANE(!entryPoint ,  Z is $!planeDir )
     !this.utypeNorPlane = !plane
    endif

    !firAscendDir  = !this.utypeNorPlane.direction()   	
    !lastAscendDir = !firAscendDir.opposite()

    !botPerpPt  = !this.utypeNorPlane.near(!entryPoint)
    !topPerpPt  = !this.utypeNorPlane.near(!exitPoint)

    !this.flightLegs[1]              = object ASLFLIGHT()
    !this.flightLegs[1].fltDirection = !firAscendDir
    !this.flightLegs[2]              = object ASLFLIGHT()
    !this.flightLegs[2].fltDirection = !this.getFlightDirection(!botPerpPt,!topPerpPt)
    !this.flightLegs[3]              = object ASLFLIGHT()
    !this.flightLegs[3].fltDirection = !lastAscendDir

    !this.lExtnDirection = !firAscendDir.opposite()
    !this.uExtnDirection = !lastAscendDir

  else
  -- assume this as a straight
    !this.flightLegs[1]             = object ASLFLIGHT()
    !this.flightLegs[1].fltDirection = !direction
    !this.lExtnDirection = !direction.opposite()
    !this.uExtnDirection = !direction
  endif

  !this.sense = !this.sense()

  return !config

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:Sense()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sense() is BOOLEAN

  if (!this.flightLegs.size().gt(1) ) then
    !firDir = !this.flightLegs[1].fltDirection
    !secDir = !this.flightLegs[2].fltDirection
    return !this.sense(!firDir , !secDir)
 else
     -- return unset value
     !bool = BOOLEAN()
     return !bool
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:Sense()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sense(!firDirection is DIRECTION , !secDirection is DIRECTION) is BOOLEAN

  !cenPt  = E0
  !startPT = !cenPt.offset(!firDirection , 100mm)
  !endPt   = !cenPt.offset(!secDirection , 100mm)

  -- Arc is just to find whether it is right or left
  !tempArc = object ARC( !cenPt, Z is U, 0 , 45.37 , 100mm , FALSE)
   -- reset the arc with the points in that direction
  !tempArc  = !tempArc.startposition(!startPT)
  !tempArc  = !tempArc.endposition(!endPt)

  if (!firDirection.angle(!secDirection).neq(!tempArc.angle() ) ) then
     return FALSE
  else
    return TRUE
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:createSingleFlights()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createSingleFlights( !mode is STRING , !landingLengths is ARRAY)

 -- Lower Extension is handled later to accommodate the left over leg length
 !treadRise = !this.rise

  do !i indices !this.flightLegs

    !fltsInLeg    = !this.calcNumOfFlts(!this.flightLegs[!i].numOfTreads)
     if (!mode.upcase().eq('CREATE') ) then
        !treadNum[!i]  = !this.calcFlightSteps(!fltsInLeg , !this.flightLegs[!i].numOfTreads , TRUE)
        if ( !i.eq(1)  ) then
          !treadNum[1][1]      = !treadNum[!i][1] - 1
        endif
      else
        if (!i.eq(1) ) then
          !riseToSplit  =   !this.flightLegs[!i].oRise - !this.lRise
        else
         !riseToSplit  =   !this.flightLegs[!i].oRise
        endif
        !treadNum[!i]  = !this.calcFlightSteps(!fltsInLeg , (!riseToSplit / !treadRise) , FALSE)
      endif
    -- create flights from Legs and calculate values
    do !j from 1 to !fltsInLeg
      !flightSegment               = object ASLFLIGHT()
      !flightSegment.fltDirection  = !this.flightLegs[!i].fltDirection
      !flightSegment.lLndgDir      = !flightSegment.fltDirection.opposite()
      !flightSegment.uLndgDir      = !flightSegment.fltDirection
      !flightSegment.going         = !this.flightLegs[!i].going

      -- Work out the landing and extensions on the bottom side
      if ( (!i.eq(1) and !j.eq(1))  and (!this.lExtnDirection.isParallel(!flightSegment.lLndgDir).not() ) )  then
        !flightSegment.lLndgLength = !this.width / 2
      elseif(!i.gt(1) and !j.eq(1) ) then
        !flightSegment.lLndgLength = !this.width / 2
      else
        !flightSegment.lLndgLength = 0
      endif
      -- Work out the sloped portion
      if (!i.eq(1)  and (!j.eq(1) ) ) then
        !flightSegment.oRise       = (!treadNum[!i][!j] * !treadRise) + !this.lRise
        !flightSegment.numOfTreads = !treadNum[!i][!j] + 1
      else
       !flightSegment.oRise      = !treadNum[!i][!j] * !treadRise
       -- assign calculate number of Treads
      !flightSegment.numOfTreads = !treadNum[!i][!j]

      endif
      !flightSegment.oGoing    = !flightSegment.numOfTreads * !this.flightLegs[!i].going

      -- Work out the landing and extensions on the upper side
      if(!j.neq(!fltsInLeg) ) then
        !flightSegment.uLndgLength = !landingLengths[!i]
      else
          if(!i.neq(!this.flightLegs.size()) )  then
             !flightSegment.uLndgLength = !this.width / 2
          else

              if(!this.uExtnDirection.neq(!flightSegment.fltDirection) )  then
                 !flightSegment.uLndgLength = !this.width / 2
              else
                 !flightSegment.uLndgLength = 0
              endif

          endif
      endif
      !this.flights.append(!flightSegment)

    enddo
  enddo

 endmethod
------------------------------------------------------------------------

-- Method:      createRpath
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createRpath()

  !rpathPts = object ARRAY()
  !connPt    = !this.pickedPosData[1].position
  !rpathPts[1] = !connPt
    if (!this.lExtension.gt(0)  ) then
       !connPt = !connPt.offset(!this.lExtnDirection.opposite() , !this.lExtension)
       !rpathPts.append(!connPt)
    endif
    do !fltNum indices !this.flights
     !flight = !this.flights[!fltNum]
     -- add the lwp
     !connPt = !connPt.offset(!flight.lLndgDir.opposite() , !flight.lLndgLength)
     !rpathPts.append(!connPt)
     !this.flights[!fltNum].lwp = !connPt

     -- add the uwp
     !connPt = !connPt.offset(!flight.fltDirection,!flight.oGoing).offset(u,!flight.oRise)
     !rpathPts.append(!connPt)
     !this.flights[!fltNum].uwp = !connPt

     !connPt = !connPt.offset(!flight.uLndgDir , !flight.uLndgLength)
     !rpathPts.append(!connPt)
   enddo
   if (!this.uExtension.gt(0)  ) then
       !connPt = !connPt.offset(!this.uExtnDirection , !this.uExtension)
       !rpathPts.append(!connPt)
   endif

   !this.lwp  = !this.flights[1].lwp
   !this.uwp = !this.flights.last().uwp

  !this.rpath.aslRpath(!rpathPts , u)

  !this.rpath.mergeVertices(1, !this.rpath.size())

 endmethod
 -- End of method definition

------------------------------------------------------------------------
-- Method:      evalLandingPath
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .evalLandingPath() is ARRAY

   !edges = !this.rpath.edges(FALSE)

   !landingPaths = ARRAY()
   !lndgEdges = ARRAY()

   do !edge values !edges
     if (!edge.objectType().eq('LINE') ) then
        if (!edge.direction().up.neq(0) ) then
          -- it is a rise
          if (!lndgEdges.size().gt(0) ) then
            -- extend the last edge of the centreline  in a landing
            !newEdge = !lndgEdges.last()
            !newEdge.endposition  = !newEdge.endposition.offset(!newEdge.direction() , !this.criteria.going.optimum())
            !lndgEdges[!lndgEdges.maxIndex()] = !newEdge
            !lndgPath = object ASLRPATH(!lndgEdges)
            !landingPaths.append(!lndgPath)
            !lndgEdges.clear()
          endif
        else
         !lndgEdges.append(!edge)
        endif
     endif
   enddo

   if (!lndgEdges.size().gt(0) ) then
     !lndgPath = object ASLRPATH(!lndgEdges )
     !landingPaths.append(!lndgPath)
   endif

 return !landingPaths

 endmethod
-- End of method definition

------------------------------------------------------------------------
 --
-- Method:      cordDir
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
  ------------------------------------------------------------------------
define method .cordDir(!direction is DIRECTION ) is DIRECTION

    !angFactor = 90
    !dirPicks    =  !direction

    !pickDirComp     = !dirPicks.string().before('WRT').trim().split()
    if(!pickDirComp.size() eq 3) then
      !pickAng     = !pickDirComp[2].real()
      !angle       = (Nint (!pickAng / !angFactor ) ) * !angFactor
      !cordDirStr  = (!pickDirComp[1] + ' ' + !angle.string() + !pickDirComp[3])
      !cordDir     = !cordDirStr.direction()
    else
      !cordDir = !dirPicks
    endif

   return !cordDir

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      getFlightDirection
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getFlightDirection(!firstPt is POSITION, !secondPt is POSITION) is DIRECTION

    !inclDir     =  !firstPt.direction(!secondPt)
    if (!inclDir.isParallel(U).not() ) then
      !inclDir.up  = 0
      !inclDir     = !inclDir.string().direction()
    else
      return error 1  'Points are  along Vertical direction'
    endif

    return  !inclDir

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      horizDirection
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .horizDirection(!edge is LINE) is DIRECTION

    !lineDir     =  !edge.direction()
    !lineDir.up  = 0
    !lineDir     = !lineDir.string().direction()
    handle(2,813)
      return error 1  'Passed Line is a Vertical line'
    endhandle

    return  !lineDir

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      getFlightThickness
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getFlightThickness() is REAL

  return !this.fThickness

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      getRise
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getRise(!firstPt is POSITION, !secondPt is POSITION) is REAL

   !oRise  = abs (!firstPt.up  - !secondPt.up)

   return !oRise

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      getGoing
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getGoing(!firstPt is POSITION, !secondPt is POSITION) is REAL

  !derivedDir    = !this.getFlightDirection(!firstPt , !secondPt)
  !going           = !this.getGoing(!firstPt , !secondPt , !derivedDir)

  return !going

endmethod
-- End of method definition

------------------------------------------------------------------------
-- Method:      getGoing
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getGoing(!firstPt is POSITION, !secondPt is POSITION, !dirToMeasure is DIRECTION) is REAL

  !horVector         = object POINTVECTOR( !firstPt,!dirToMeasure)
  !perpPlaneOri    = object ORIENTATION(|y is u and z is $!dirToMeasure|)
  !secondPtPerpPlane = object PLANE( !secondPt,!perpPlaneOri)

  !goingPt    =  !secondPtPerpPlane.intersection(!horVector)
  -- point in the top plane calculated from  flight tDirection  of entry. Need to get the extensions and locate the top working point
  !going  = !firstPt.distance(!goingPt)

  return !going

endmethod
-- End of method definition
------------------------------------------------------------------------------
-- Method:  calcNumOfFlts
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calcNumOfFlts( !oNumberOfTreads is REAL )  is REAL

  !numberOfFlights =  (!oNumberOfTreads / !this.criteria.treads.max() ) + 0.4999

  return !numberOfFlights.nint()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:  calcNumOfFlts
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calcNumOfFlts( !oNumberOfTreads is REAL , !rise is REAL ) is REAL

  !numberOfFlights =  (!oNumberOfTreads / !rise ) + 0.4999

  return !numberOfFlights.nint()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:  calcNumOfSteps
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calcNumOfSteps()  is REAL

  !numberOfSteps =  !this.calcNumOfSteps(!this.criteria.rise.optimum())

  return !numberOfSteps

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:  calcNumOfSteps
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calcNumOfSteps(!rise is REAL ) is REAL

  !numberOfSteps =  !this.calcNumOfSteps(!this.oRise , !rise)

  return !numberOfSteps.nint()

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:  calcNumOfSteps
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calcNumOfSteps( !oRise is REAL , !rise is REAL)  is REAL

  !numberOfSteps =  (!oRise / !rise)  + 0.4999

  return !numberOfSteps.nint()

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:    calcFlightSteps
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calcFlightSteps( !fltNum is REAL , !steps is REAL , !equalFlag is BOOLEAN)  is ARRAY

  !fltStep   =  (!steps / !fltNum)

  if (!equalFlag) then
    !fltStep  = !fltStep + 0.4999
    !fltStep  = !fltStep.nint()
    do !i to !fltNum
       !fltSteps[!i] = !fltStep
    enddo
  else
    !fltStep  = nint (!fltStep  - 0.4999)
    !diff = !steps - (!fltNum * !fltStep)
    do !i to !fltNum
       !fltSteps[!i] = !fltStep
       if(!diff.gt(0) ) then
        !fltSteps[!i]   = !fltStep + 1
        !diff           = !diff - 1
       endif
    enddo
  endif

  return !fltSteps

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      calcTreadRise
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calcTreadRise() is REAL

   -- Calculate the number of Steps from the rise and optimum rise
 !numOfSteps   =  !this.calcNumOfSteps()
 !calcRise      = !this.oRise / !numOfSteps

 !treadRise = !this.calcTreadRise(!calcRise)

 return !treadRise

 endmethod

 ------------------------------------------------------------------------
--
-- Method:      calcTreadRise
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .calcTreadRise(!rise is REAL) is REAL

 !treadRise = !this.calcTreadRise(!rise , TRUE)

 return !treadRise

endmethod
------------------------------------------------------------------------
--
-- Method:      calcTreadRise
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .calcTreadRise(!rise is REAL , !equalSplit is BOOLEAN) is REAL

 !treadRise = !rise

 !availableGoing = !this.oGoing - ( (!this.flightLegs.size() - 1) * !this.width )

!numberOfTreads = 0
!numberOfFlts   = 0

 do !i indices  !this.flightLegs

    !treadsInLeg  = !this.flightLegs[!i].oRise / !treadRise
    if (!treadsInLeg.lt(1) ) then
       !treadRise = 0
       !fltDirection = !this.flightLegs[!i].fltDirection
       !!alert.error('Cannot create treads in the flight along the direction $!fltDirection' )
       return 0
    endif

    !fltsInLeg    = !this.calcNumOfFlts(!treadsInLeg)
    !treadNum     = !this.calcFlightSteps(!fltsInLeg, !treadsInLeg, !equalSplit)

    !this.flightLegs[!i].numOfFlights  = !fltsInLeg
    !treadSum = 0
    do !fltIndx indices !treadNum
        !treadSum = !treadSum + !treadNum[!fltIndx]
    enddo
    !this.flightLegs[!i].numOfTreads  = !treadSum

    !numberOfTreads   = !numberOfTreads + !this.flightLegs[!i].numOfTreads
    !numberOfFlts     = !numberOfFlts + !fltsInLeg
 enddo

 !treadRise = !this.oRise / !numberOfTreads

 !this.numberOfFlts      = !numberOfFlts
 !this.numberOfSteps   = !numberOfTreads

 return !treadRise

 endmethod

-- End of method definition
------------------------------------------------------------------------
--
-- Method:          calcLegGoing
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
-- using passed by reference do not change the name of the passed variables
------------------------------------------------------------------------
define method .calcLegGoing(!availableGoing is REAL , !goingVal is REAL , !lngLength is REAL , !numberOfSteps is REAL , !numberOfFlts is REAL)    is ARRAY

    !factor = 10
    !counter = 1
    !minGoing = !numberOfSteps * !goingVal
    do
     !diff = !availableGoing -  ((!numberOfSteps  * !goingVal ) +  ( (!numberOfFlts - 1) * !lngLength ) )
      break if (!diff.abs().leq(0.1) )

      if ( !diff.leq(0)) then
        !lngLength = !lngLength - !factor
        !goingVal  = !goingVal - !factor
        !factor      = !factor / 10
      else
        !goingVal  = !goingVal + !factor
        !lngLength  = !lngLength + !factor
        if (!lngLength.gt(!this.criteria.fltIntLngLength.max) ) then
           !lngLength  = !lngLength - !factor
           !lngMax     = true
        else
           !lngMax     = false
        endif
        if (!goingVal.gt(!this.criteria.going.max)) then
            !goingVal  = !goingVal - !factor
            !goingMax     = true
        else
           !goingMax     = false
        endif
        if (!goingMax and !lngMax) then
          !success =  FALSE

          !lngGoingVal[1] = !success
          !lngGoingVal[2] = !goingVal
          !lngGoingVal[3] = !lngLength

          return !lngGoingVal
        endif
      endif

      !counter = !counter + 1
      break if (!counter.gt(100))

   enddo

    if (!diff.abs().leq(0.1) ) then
    !success=  TRUE
    else
      !success = FALSE
    endif

    !lngGoingVal[1] = !success
    !lngGoingVal[2] = !goingVal
    !lngGoingVal[3] = !lngLength

    return !lngGoingVal
 endmethod

-- End of method definition
------------------------------------------------------------------------
--
-- Method: showVolFeedback
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showVolFeedback()

  !fltSideEdges = ARRAY()

 !fltSideEdges.append(!this.lRpath.edges(FALSE))
 !fltSideEdges.append(!this.rRpath.edges(FALSE))

  if ( !this.handRailOption.eq('L') ) then
    !this.lHandrail.draw(!!aslCentralData.aidVolHandRa,!!aslCentralData.lineStyleDotDashedThick,!!aslCentralData.colourHandRa)
  elseif (!this.handRailOption.eq('R') ) then
    !this.rHandrail.draw(!!aslCentralData.aidVolHandRa,!!aslCentralData.lineStyleDotDashedThick,!!aslCentralData.colourHandRa)
  elseif(!this.handRailOption.eq('LR')) then
    !this.lHandrail.draw(!!aslCentralData.aidVolHandRa,!!aslCentralData.lineStyleDotDashedThick,!!aslCentralData.colourHandRa)
    !this.rHandrail.draw(!!aslCentralData.aidVolHandRa,!!aslCentralData.lineStyleDotDashedThick,!!aslCentralData.colourHandRa)
  endif

  do !j indices !fltSideEdges
    do !k indices !fltSideEdges[!j]
      !fltSideEdges[!j][!k].draw(!!aslCentralData.aidVolEnvelope,!!aslCentralData.lineStyleDashedThick,!!aslCentralData.colourEnvelope)
      if(!this.headRoom.gt(0)) then
        !topEdges = !fltSideEdges[!j][!k].offset(u,!this.headRoom)
        !topEdges.draw(!!aslCentralData.aidVolMain,!!aslCentralData.lineStyleDashedThin,!!aslCentralData.colourMain)

        !startPtVertLine =  !fltSideEdges[!j][!k].startposition.line(!fltSideEdges[!j][!k].startposition.offset(u,!this.headRoom) )
        !startPtVertLine.draw(!!aslCentralData.aidVolStrflt,!!aslCentralData.lineStyleSolidThick,!!aslCentralData.colourStrflt)

        !endPtVertLine  =  !fltSideEdges[!j][!k].endposition.line(!fltSideEdges[!j][!k].endposition.offset(u,!this.headRoom) )
        !endPtVertLine.draw(!!aslCentralData.aidVolStrflt,!!aslCentralData.lineStyleSolidThick,!!aslCentralData.colourStrflt)
      endif
     enddo
  enddo

  !treadPts = !this.genTreadPoints()
    do !fltInx indices !treadPts
       !ydirStr  = !this.flights[!fltInx].fltDirection.wrt(world).string()
       !treadOri =  object ORIENTATION(|Y is $!ydirStr and Z is U WRT WORLD|)
       !fltGoing = !this.flights[!fltInx].going
       do !treadInx indices !treadPts[!fltInx]
         !treadPos = !treadPts[!fltInx][!treadInx].offset(!this.flights[!fltInx].fltDirection.wrt(world) , (!fltGoing / 2))
         AID BOX NUMBER $!!<aslCentralData.aidVolStrflt> AT $!<treadPos> ORIENTATION $!<treadOri> XLENGTH $!<this.width> YLENGTH $!<fltGoing> ZLENGTH 1mm FILLED off
       enddo
   enddo

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:showNormalPlane
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showNormalPlane(!norPlane is PLANE)

     !normalGphPlane = object GPHPLANE(!norPlane)
     !normalGphPlane.filled(TRUE)
     !normalGphPlane.x = 1500mm
     !normalGphPlane.y = 1500mm
     !normalGphPlane.draw(!!aslCentralData.aidVolPlanes)

endmethod
------------------------------------------------------------------------
--
-- Method:     dbWrite
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
 ------------------------------------------------------------------------

define method .dbWrite(!owner is DBREF)

  -- navigate to the element under which the element need to be created
  !!ce = !owner
  handle(2,822)
    !!alert.error('Element $!owner is an invalid Reference. May be deleted after opening the form. Go back to Main tasks')
    return error 1 noalert
  endhandle

  NEW STRFLT

  !this.refe           = !!ce

  !this.updateDb(!this.refe)

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:     updateDb
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateDb(!element is DBREF)

  !!ce            = !element
  if(!this.name.set() and !this.name.empty().not()) then
    !!ce.name  = '/' & !this.name
  endif

  !!ce.position   = !this.lwp
  !!ce.fThickness = !this.fThickness
  !!ce.lRise      = !this.lRise
  !!ce.rise       = !this.rise
  !!ce.fltDirection = !this.fltDirection
  !!ce.tWidth     = !this.width
  !!ce.headRoom   = !this.headRoom
  !!ce.instOptions  = !this.instOptions
  !!ce.assTmpReference = !this.tmplReference


  !strPath     = !!dtbMemberOfType(!element, 'RPATH', 1)
  if (!strPath.unset() ) then
    NEW RPATH
    !strPath = !!ce
  else
    !!ce = !strPath
  endif

  -- write data into the rpath
  !this.rpath.dbWrite(!strPath)

  -- collect the existing GENSEC to modify later
  !stringers = !this.readElements('GENSEC', 'OHTYPE EQ |STRSTR|' , !this.refe)
  do !c indices !stringers
    !!ce = !stringers[!c]
    delete GENSEC
  enddo

  if (!this.stringerTemplates.size().gt(0)) then
    !strStr     = !!dtbMemberOfType(!element, 'STRSTR', 1)
    if (!strStr.unset() ) then
      NEW STRSTR
      !strStr = !!ce
    else
      !!ce = !strStr
    endif

    -- collect and use the GENSEC templates
    !stringerTmpl = !this.stringerTemplates
    if (!stringerTmpl.size().eq(1) ) then
    -- use the second one if there is no explicit first
        !stringerTmpl[2]  = !stringerTmpl[1]
    endif

    -- assign to a temporary var to use in stringers
    !rStringerPath = !this.rRpath
    !lStringerPath = !this.lRpath

    !tolAng = 0.01
    -- adjust the landing offset set by TOS / FFL selection
    if (!this.lowLandingOffset.lt(0) ) then
     !lowLandingOffset = -1 * !this.lowLandingOffset
      -- offset the terminal points first
      -- offset the bottom edge by landing offsets if there is extension
     !leftBotEdgeDir = !lStringerPath.vertex[1].direction(!lStringerPath.vertex[2])
     handle ANY
     elsehandle NONE
       !lStringerPath.vertex[1] = !lStringerPath.vertex[1].offset( D , !lowLandingOffset)
       if (!leftBotEdgeDir.up.abs().lt(!tolAng) ) then
         !lStringerPath.vertex[2] = !lStringerPath.vertex[2].offset( D , !lowLandingOffset)
       endif
     endhandle

     -- work out the right side
     !rightBotEdgeDir = !rStringerPath.vertex[1].direction(!rStringerPath.vertex[2])
     handle ANY
     elsehandle NONE
       !rStringerPath.vertex[1] = !rStringerPath.vertex[1].offset( D , !lowLandingOffset)
       if (!rightBotEdgeDir.up.abs().lt(!tolAng) ) then
         !rStringerPath.vertex[2] = !rStringerPath.vertex[2].offset( D , !lowLandingOffset)
       endif
     endhandle

   endif

   -- offset the top edge of the stringer based on the landing offsets
   if (!this.upLandingOffset.lt(0)  ) then
   	 !upLandingOffset = -1 * !this.upLandingOffset
     !maxIndex       = !lStringerPath.vertex.maxIndex()
     !leftTopEdgeDir = !lStringerPath.vertex[!maxIndex - 1].direction(!lStringerPath.vertex[!maxIndex])
       handle ANY
       elsehandle NONE
        !lStringerPath.vertex[!maxIndex]     = !lStringerPath.vertex[!maxIndex].offset( D , !upLandingOffset)
        if (!leftTopEdgeDir.up.eq(0) ) then
          !lStringerPath.vertex[!maxIndex - 1] = !lStringerPath.vertex[!maxIndex - 1].offset( D , !upLandingOffset)
        endif
       endhandle

     -- work out the right side
     !maxIndex        = !rStringerPath.vertex.maxIndex()
     !rightTopEdgeDir = !rStringerPath.vertex[!maxIndex - 1].direction(!rStringerPath.vertex[!maxIndex])
        handle ANY
        elsehandle NONE
        !rStringerPath.vertex[!maxIndex]     = !rStringerPath.vertex[!maxIndex].offset( D , !upLandingOffset)
         if (!rightTopEdgeDir.up.eq(0) ) then
           !rStringerPath.vertex[!maxIndex - 1] = !rStringerPath.vertex[!maxIndex - 1].offset( D , !upLandingOffset)
         endif
        endhandle
   endif

  -- get into an array to process in  a loop
  !stringerPath[1] = !rStringerPath
  !stringerPath[2] = !lStringerPath

 !prevProfiles = ARRAY()
  -- create the data for the reinforcement beam at the intermediate landing
	 !intBeamFlag = false
  if (!this.flightLegs.size().gt(1) ) then
     !intBeamDetail  = !this.getIntlandingInnerBeam()
     if (!intBeamDetail.size().gt(0) ) then
     	 !intBeamFlag = true
     	 !intBeamPrevIndx =!intBeamDetail[1]
     endif	

     if (!this.sense ) then
	       !strTemplIndx = 1
     else
	       !strTemplIndx = 2
     endif
  endif

     -- get the edges in the rpath
     do !strPathInx indices !stringerPath
     -- get the edges in the rpath
     !spinePath = !stringerPath[!strPathInx]
     !edges = !spinePath.edges(f)

     do !inx indices !edges
       if (!stringers.size().gt(0) ) then
         !oldRef = !stringers.removeFirst()
         --delete GENSEC
         NEW GENSEC ref $!oldRef
       else
         NEW GENSEC
       endif

       if (!intBeamFlag and (!strPathInx.eq(!strTemplIndx)) and (!intBeamPrevIndx.findfirst(!inx).set()) ) then
         !prevProfiles.append(!!ce.ref)
       endif

       copy $!stringerTmpl[$!strPathInx]
       !curGen = !!ce
       FIR SPINE
        handle(2,113)
          NEW SPINE
        elsehandle NONE        	
          !curSpine = !!ce
        endhandle

       -- convert the segment to an array  and create individual sctn pieces for each edge
       !strEdge[1] = !edges[!inx]
       !strEdg = object ASLRPATH(!strEdge)
       !this.spineWrite( !curSpine , !strEdg)

       !edge     =  !edges[!inx]

       if (!inx.eq(!edges.size() ) ) then
         if (!edges.size().gt(1)) then
            -- stored value from Previous edge
           !curGen.drns = !prevDrnsDir
         endif
         !lastEdgeCutDir     = !this.horizDirection(!edge)
         !curGen.drne        = !lastEdgeCutDir
         skip
       else
          !nexEdge  =  !edges[!inx + 1]
          !cutDir    = !this.endCutDir(!edge , !nexEdge )

          !curGen.drne = !cutDir
          if (!inx.eq(1) ) then
            !startEdgeCutDir  = !this.horizDirection(!edge)
            !curGen.drns        = !startEdgeCutDir
          else
            !curGen.drns = !prevDrnsDir
          endif
           -- calculate the end dir for the next
           !prevDrnsDir = !cutDir.opposite()
       endif
     enddo
  enddo

  if  (!intBeamFlag ) then
     !intBeams = !intBeamDetail[2]
     do !intBeamIndx indices !intBeams
       if (!stringers.size().gt(0) ) then
         !oldRef = !stringers.removeFirst()
         --delete GENSEC
         NEW GENSEC ref $!oldRef
       else
          NEW GENSEC
       endif

       if (!this.sense ) then
	       !strTemplIndx = 1
       else
	       !strTemplIndx = 2
       endif

       copy $!stringerTmpl[$!strTemplIndx]
       !curGen = !!ce

       !prevStringerEdge = !stringerPath[!strTemplIndx].edges(f)[!intBeamPrevIndx[!intBeamIndx]]
       !prevDir         = !this.horizDirection(!prevStringerEdge)
       !intBeamDir  = !this.horizDirection(!intBeams[!intBeamIndx])

       if (!prevDir.eq(!intBeamDir) ) then
         !endCutDir = !this.endCutDir( !stringerPath[!strTemplIndx].edges(f)[!intBeamPrevIndx[!intBeamIndx]] , !intBeams[!intBeamIndx] )
           handle ANY
           	skip
           endhandle
         !curGen.drns = !endCutDir
         !prevProfiles[!intBeamIndx].drne = !endCutDir.opposite()
       endif

       FIR SPINE
        handle(2,113)
          NEW SPINE
        elsehandle NONE        	
          !curSpine = !!ce
        endhandle

       !strEdge[1] = !intBeams[!intBeamIndx]
       !strEdg = object ASLRPATH(!strEdge)
       !this.spineWrite( !curSpine , !strEdg)

     enddo
    endif
--  endif
 else
 -- delete the stair stringer as there is no stringer element
  !stairSinger = !this.readElements('STRSTR' , !this.refe)
  if (!stairSinger.size().gt(0) ) then
    do !strStr values   !stairSinger
       !!ce = !strStr
       delete STRSTR
    enddo
  endif

 endif

  if ( !this.treadTemplates.size().gt(0)   ) then

   !treads     = !this.readElements('TREAD' , !this.refe)
   !treadSet  = !!dtbMemberOfType(!element, 'TREADS', 1)

   if (!treadSet.unset() ) then
     NEW TREADS
     !treadSet = !!ce
   else
     !!ce = !treadSet
   endif

   -- work out  creation of  treads
   !treadTmpl = !this.treadTemplates

   if (!treadTmpl.size().eq(1) ) then
     !treadTmpl[2]  = !treadTmpl[1]
   endif

   !treadPts     = !this.genTreadPoints()

    do !fltInx indices !treadPts
      -- id to use in alternate treads
      !tmplID = 1
      !ydirStr  = !this.flights[!fltInx].fltDirection.wrt(world).string()
      !treadOri =  object ORIENTATION(|Y is $!ydirStr and Z is U WRT WORLD|)
      do !treadInx indices !treadPts[!fltInx]
        if (!treads.size().gt(0) ) then
         !oldRef = !treads.removeFirst()
          !!ce = !oldRef
          delete TREAD
          NEW TREAD ref $!oldRef
        else
          NEW TREAD
        endif

      copy $!treadTmpl[$!tmplID]
      !!ce.pos = !treadPts[!fltInx][!treadInx]
      !!ce.assTmpReference = !treadTmpl[!tmplID]
      ORI $!treadOri

        if ( !treadInx.eq(1) ) then
           !lriseTread = !!ce
           !riseRuleColl              = object COLLECTION()
           -- collect all treads that have at least one rule
           !filterExpression          = object EXPRESSION('RCOU GT 0')
           !riseRuleColl.scope(CE)
           !riseRuleColl.filter(!filterExpression)
           !elements          = !riseRuleColl.results()
           do !treadMem values !elements
             !!ce = !treadMem
             var !rule rule
             !rule = !rule.replace(' RISE' , ' LRISE')
             RULE SET $!rule
           enddo
          !!ce = !lriseTread
        endif

        if (!tmplID.eq(1) ) then
         !tmplID = 2
        else
         !tmplID = 1
        endif
      enddo
    enddo

    if (!treads.empty().not() ) then
      -- Delete  extra  treads
      do !delTread values !treads
        !!ce =  !delTread
        delete TREAD
      enddo
    endif


    -- calculate the landing path of all Intermediate landings
  !intLngProfiles = !this.evalLandingPath()

  !collection = object COLLECTION()
  !collection.scope(STRFLT)
  !filter = object EXPRESSION(' TYPE EQ |PANE|  AND OHTYPE EQ |INTLNG| ' )
  !collection.filter(!filter)
  !landings =  !collection.results()

   -- use the  attributes of Tread Panel
    !intLngTmpl = !!dtbMemberOfType(!treadTmpl[1], 'PANE', 1)
    if (!intLngTmpl.set() ) then
      !intLngTmplFlag = TRUE
    else
      !intLngTmplFlag = FALSE
    endif

    !lndgProfiles = ARRAY()

    do !intLngIndx indices !intLngProfiles
      !halfWidth = (!this.width / 2)
      if ( (!intLngIndx.eq(1) and (!intLngProfiles[!intLngIndx].vertex[1].up.eq(!this.lwp.up)) and !this.lowLandingOffset.gt(0)  ) or $
       (!intLngIndx.eq(!intLngProfiles.size() ) and (!intLngProfiles[!intLngIndx].vertex[1].up.eq(!this.uwp.up)) and !this.upLandingOffset.gt(0)  ) ) then
       	  -- offset in the upward direction
         !intLngProfiles[!intLngIndx] = !intLngProfiles[!intLngIndx].offset(UP, !this.landingThickness)
      endif
      !lndgProfiles.append(!this.generateLanding(!intLngProfiles[!intLngIndx] , !halfWidth))
    enddo

    do !lndgInx indices !lndgProfiles

        if (!landings.size().gt(0) ) then
          !oldRef = !landings.removeFirst()
          !!ce = !oldRef
          delete PANEL
          NEW PANEL ref $!oldRef
        else
          NEW INTLNG
           handle ANY
             !!ce = !this.refe
             NEW INTLNG
           endhandle
          NEW PANEL
        endif

        if (!intLngTmplFlag ) then
          copy attribute of $!intLngTmpl
        endif

        !ploop  = !!dtbMemberOfType(!!ce, 'PLOO', 1)
        if (!ploop.unset()) then
           NEW PLOO
           !ploop = !!ce
        endif

        !!ce = !ploop
        !lndgProfiles[!lndgInx].dbWrite(!ploop)
         SJUST DTOP

        !!ce.height = !this.landingThickness

    enddo

    if (!landings.empty().not() ) then
      -- Delete  extra  treads
      do !delLanding values !landings
        !!ce =  !delLanding
        delete PANEL
      enddo
    endif

    else
      !treadSetToDel = !this.readElements('TREADS' , !this.refe)
      if (!treadSetToDel.size().gt(0) ) then
      do !treadSet values   !treadSetToDel
          !!ce = !treadSet
          delete TREADS
      enddo
    endif

    !intLngToDel = !this.readElements('INTLNG' , !this.refe)
    if (!intLngToDel.size().gt(0) ) then
      do !intLng values   !intLngToDel
          !!ce = !intLng
          delete INTLNG
      enddo
    endif

  endif

  !!ce = !this.refe

   RULE REXE

  !start = !this.rpath.refe.first()
  !end = !this.rpath.refe.last()
  if !this.lHandrail.rpath.sigref.unset() then
    !this.lHandrail.rpath.sigref[1] = !start
    !this.lHandrail.rpath.sigref[!this.lHandrail.rpath.size()] = !end
  endif
  if !this.rHandrail.rpath.sigref.unset() then
    !this.rHandrail.rpath.sigref[1] = !start
    !this.rHandrail.rpath.sigref[!this.rHandrail.rpath.size()] = !end
  endif

  if (!this.handRailOption.eq('LR')  or !this.handRailOption.eq('L') ) then
      !this.lHandrail.updateDb()
  else
     -- delete the handrail if it exists
      if ( !this.lHandrail.refe.badref().not() ) then
          !handRailToDel = !this.lHandrail.refe
          !!ce = !handRailToDel
          DELETE HANDRA
      endif
  endif
  if (!this.handRailOption.eq('LR')  or !this.handRailOption.eq('R') ) then
      !this.rHandrail.updateDb()
  else
     -- delete the handrail if it exists
      if ( !this.rHandrail.refe.badref().not() ) then
          !handRailToDel = !this.rHandrail.refe
          !!ce = !handRailToDel
          DELETE HANDRA
      endif
  endif

  !!ce = !this.refe

 endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:    handrailPath
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .handrailPath()

  -- set up handrail objects
  !this.lHandrail.xOffset(-1)
  !this.lHandrail.build(!this,'L')
  !this.rHandrail.build(!this,'R')

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Calculate the path of stringers
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stringerPath()

  -- set left/right stringer path
  !lpath = !!aslGetStrfltEdge(!this,'L', 0 ,false)
  !rpath = !!aslGetStrfltEdge(!this,'R', 0 ,false)
  !this.lRpath.aslRpath(!lpath[2],!lpath[1],!lpath[3])
  !this.rRpath.aslRpath(!rpath[2],!rpath[1],!rpath[3])

endmethod
-- End of method

-- End of method definition
