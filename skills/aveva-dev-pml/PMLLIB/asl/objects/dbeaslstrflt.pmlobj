--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setWidth(!width is REAL)

  !this.width  = !width

  if (!this.calcRiseGoing(!this.rise).not() ) then
     return error 1 'Can not calculate the going for this width'
  endif

  -- generate left/right stringer path
  !this.stringerPath()

  !this.handrailPath()

  !this.showVolFeedback()

endmethod
