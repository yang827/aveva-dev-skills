--
-- Description:     container for platform grid data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addGensec(REAL)                  DBREF               add gensec to the frame
--  boundary(PROFILE)                -                   populate boundary by passed PROFILE
--  dbeExtFrm()                      -
--  dbeExtFrm(DBREF)                 BOOLEAN             Constructor
--  dbeExtFrm(PROFILE)               -
--  detailPresent()                  BOOLEAN             return true if detail exists or can be created
--  elevation(REAL)                  -                   move object in its z-direction
--  getEdgeEnd(ANY)                  POSITION            return end position of LINE/ARC
--  getEdgeStart(ANY)                POSITION            return start position of LINE/ARC
--  getRef()                         DBREF               get free refno from remove list
--  mitreGensec(DBREF,DBREF)         -                   mitre two connected gensec
--  orientation()                    ORIENTATION         return object orientation
--  orientation(ORIENTATION)         -                   modify object orientation
--  position()                       POSITION            return current object position
--  position(POSITION)               -                   modify object position
--  removeGensec(REAL)               DBREF               remove gensec from list
--  sense()                          BOOLEAN             return true if sense is anti-clockwise
--  sense(BOOLEAN)                   -                   set sense
--  sense(DBREF)                     BOOLEAN             return true if sense is anti-clockwise
--  tmplReference(DBREF)             -                   set assembly template ref.
--  updateDb()                       -                   create/update platform external frame
--

-- Define object
define object DBEEXTFRM

  -- DB Element referenced
  member .dbElement       is DBREF

  -- Name
  member .name            is STRING

  -- Function
  member .function        is STRING

  member .description     is STRING

  member .matref          is DBREF

  member .purpose         is STRING

  member .profile         is PROFILE

  --member .gensec          is DBREF
  member .gensec          is ARRAY

  member .removedGensec   is ARRAY

  member .spref           is DBREF

  member .justification   is STRING

  member .bangle          is REAL

  member .tmplReference   is DBREF

  member .defaultSize     is EXPRESSION

  member .size            is EXPRESSION

endobject
-- End of object definition for DBEEXTFRM

------------------------------------------------------------------------
--
-- Method:      dbeExtFrm
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dbeExtFrm()

  !this.name          = STRING()
  !this.function      = ''
  !this.description   = ''
  !this.purpose      = 'ASLA'
  !this.profile.position = e0 n0 u0 wrt world
  !this.profile.orientation = Y is N wrt world
  !this.gensec.clear()
  !this.removedGensec.clear()
  !this.bangle = 0

  !this.defaultSize.expression('( PARA[1] )')
  !this.size = !this.defaultSize

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbeExtFrm
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     shape of PLTGRD
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dbeExtFrm(!shape is PROFILE)

  -- load defaults
  !this.dbeExtFrm()

  -- add shape
  !this.profile = !shape
  !this.profile.close()
  if !this.profile.sense() then
    !this.profile.reverse()
  endif

  if !this.profile.isCircle() then
    !this.gensec[1] = nulref
  else
    do !c from 1 to !shape.numberEdges()
      !this.gensec[!c] = nulref
    enddo
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      detailPresent
--
-- Description: return true if detail exists or can be created
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .detailPresent() is BOOLEAN

  if !this.dbElement.badref() then
    return false
  endif

  return !this.dbElement.memb.set()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbeExtFrm
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .dbeExtFrm(!dbElement is DBREF) is BOOLEAN

  -- Load defaults
  !this.dbeExtFrm()

  -- Verify type of the element passed
  if !dbElement.fulltype.neq('EXTFRM')  then
    !!error.text    = 'Element ' & !dbElement.namn & ' is not a EXTFRM.'
     return false
  endif

  -- Set db element
  !this.dbElement         = !dbElement

  -- Get attributes of the element
  if(!this.dbElement.isNamed) then
    !this.name        = !this.dbElement.namn
  else
    !this.name = STRING()
  endif

  !this.description     = !this.dbElement.description
  !this.function        = !this.dbElement.function
  !this.matref          = !this.dbElement.matref
  if !this.dbElement.assTmp.badref().not() then
    !this.tmplReference   = !this.dbElement.assTmp
    !extFrm = !this.tmplReference
  else
    !this.tmplReference   = nulref
    !extFrm = !dbElement
  endif

  -- gen sense of frame
  !sense = !this.sense(!extFrm)

  -- get profile from RPATH of owning platform
  !rPath  = !!dtbMemberOfType(!dbElement.owner,'RPATH',1)
  !tmp = object PROFILE(!rPath)

  !this.profile = object PROFILE(!dbElement.owner.pos.wrt(world),!dbElement.owner.ori.wrt(world),!tmp.edges())
  !this.profile.close()

  if !this.profile.sense().neq(!sense) then
    !this.profile.reverse()
  endif

  -- get spref justification bangle and matref
  !gensec = !!collectAllFor('GENSEC','',!dbElement)
  if !gensec.set() then
    !this.bangle = !gensec.first().bangle
    !this.justification = !gensec.first().jusl
    !this.matref = !!collectAllFor('GENSEC','(not (badref (matref) ))',!dbElement).first().matref
    handle ANY
    endhandle
    !this.spref = !!collectAllFor('GENSEC','(not (badref (spref) ))',!dbElement).first().spref
    handle ANY
    endhandle
  endif

  if !this.tmplReference.badref().not() then
    !tmplGensec = !!collectAllFor('GENSEC','(not (badref (spref) ))',!this.tmplReference)
    !first = !tmplGensec.first()
    handle NONE
      if !this.spref.badref() then
        !setNewSpref = false
      else
        !setNewSpref = !this.spref.owner.neq(!first.spref.owner)
      endif
      if !setNewSpref then
        !this.spref = !first.spref
      endif
      !this.bangle = !first.bangle
      !this.justification = !first.jusl
    elsehandle ANY
    endhandle
    -- get expression for size
    !ddat = !!collectAllFor('DDAT','type of owner of DDSE eq ''PLTFRM'' and desc eq ''EXTERNALSIZE''',!this.tmplReference.owner)
    if !ddat.set() then
      !expr = object EXPRESSION(!ddat[1].ddpr)
      handle ANY
        !this.size = !this.defaultSize
      elsehandle NONE
        !this.size = !expr
      endhandle
    endif
  endif

  -- get gensec
  !edges = !this.profile.edges()
  !indx = 1
  do !c indices !edges
    skip if undefined(!gensec[!indx])
    !start = !this.getEdgeStart(!edges[!c])
    !end = !this.getEdgeEnd(!edges[!c])
    !poss = !this.profile.near(!gensec[!indx].poss).wrt(world)
    !pose = !this.profile.near(!gensec[!indx].pose).wrt(world)
    if !poss.near(!start,15mm).and(!pose.near(!end,25mm)) then
      !this.gensec[!c] = !gensec[!indx]
      !indx = !indx + 1
    endif
  enddo

  if !gensec.set().and(!this.gensec.unset()) then
    !this.removedGensec.appendArray(!gensec)
    do !c indices !edges
      !this.gensec[!c] = !this.getRef()
    enddo
  endif

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundary
--
-- Description: populate boundary by passed PROFILE
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     PROFILE     new boundary
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boundary(!shape is PROFILE)

  !shape.mergepoints()
  !shape.close()

  !numberOfEdges = !shape.numberEdges()
  !newGensec = ARRAY()
  do !c indices !this.gensec
    if !c.gt(!numberOfEdges) then
      if !this.gensec[!c].set() then
        !this.removedGensec.append(!this.gensec[!c])
      endif
    else
      !newGensec[!c] = !this.gensec[!c]
    endif
  enddo

  !nextGensecIndex = !newGensec.maxIndex() + 1

  do !c from !nextGensecIndex to !numberOfEdges
    !newGensec[!c] = !this.getRef()
  enddo

  -- set members
  !this.gensec = !newGensec
  !this.profile = !shape

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeGensec
--
-- Description: remove gensec from list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       |gensec to be removed
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeGensec(!index is REAL) is DBREF

  !removed = nulref
  if undefined(!this.gensec[!index]) then
    return !removed
  endif

  if !index.set() then
    !removed = !this.gensec[!index]
    if !removed.set() then
      !this.removedGensec.append(!removed)
    endif
    !this.gensec[!index].delete()
  endif

  return !removed

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addGensec
--
-- Description: add gensec to the frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        index of segment where the gensec to be added to
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addGensec(!index is REAL) is DBREF

  if defined(!this.gensec[!index]) then
    return
  endif

  !this.gensec[!index] = !this.getRef()

  return !this.gensec[!index]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getRef
--
-- Description: get free refno from remove list
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference number
--
------------------------------------------------------------------------

define method .getRef() is DBREF

  !refno = nulref
  if !this.removedGensec.set() then
    !refno = !this.removedGensec.removeFirst()
  endif

  return !refno

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sense
--
-- Description: return true if sense is anti-clockwise
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Logical result
--
------------------------------------------------------------------------

define method .sense() is BOOLEAN

  !sense = !this.profile.sense()

  return !sense

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sense
--
-- Description: return true if sense is anti-clockwise
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       EXTFRM element
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Logical result
--
------------------------------------------------------------------------

define method .sense(!extFrm is DBREF) is BOOLEAN

  !sense = false
  !gensec = !!collectAllFor('GENSEC','',!extFrm)
  if !gensec.set() then
    !edges = ARRAY()
    do !memb values !gensec
      !spine = !!dtbMemberOfType(!memb,'SPINE',1)
      !tmpProf = object PROFILE(!spine)
      !edges.appendArray(!tmpProf.edges())
    enddo
    !tmp = object PROFILE(!extFrm.owner.pos,!extFrm.owner.ori,!edges)
    handle NONE
      !tmp.mergepoints()
      !tmp.close()
      if !tmp.isValidClosed() then
        !sense = !tmp.sense()
      endif
    elsehandle ANY
    endhandle
  endif

  return !sense

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sense
--
-- Description: set sense
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     sense (true = anti-clockwise/false = clockwise)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sense(!sense is BOOLEAN)

  if !sense.eq(!this.sense()) then
    return
  endif

  -- reverse profile
  !this.profile.reverse()

  -- reverse gensec array accordingly
  !edges = !this.profile.edges().size()
  if !this.profile.isCircle() then
    !edges = 1
  endif
  !gensec = ARRAY()
  !indices = !this.gensec.indices().invert()
  do !c values !indices
    !gensec[!edges - !c + 1] = !this.gensec[!c]
  enddo

  !this.gensec = !gensec

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getEdgeStart
--
-- Description: return start position of LINE/ARC
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         LINE of ARC
--
-- Return:
--   [Data Type] [Description]
--    POSITION    start position of LINE/ARC
--
------------------------------------------------------------------------

define method .getEdgeStart(!edge is ANY) is POSITION

  if !edge.objectType().eq('LINE') then
    !startPos = !edge.startposition.wrt(world)
  elseif !edge.objectType().eq('ARC') then
    !startPos = !edge.anglePosition(!edge.startangle).wrt(world)
  endif

  return !startPos

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getEdgeEnd
--
-- Description: return end position of LINE/ARC
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         LINE of ARC
--
-- Return:
--   [Data Type] [Description]
--    POSITION    end position of LINE/ARC
--
------------------------------------------------------------------------

define method .getEdgeEnd(!edge is ANY) is POSITION

  if !edge.objectType().eq('LINE') then
    !endPos = !edge.endposition.wrt(world)
  elseif !edge.objectType().eq('ARC') then
    !endPos = !edge.anglePosition(!edge.endangle).wrt(world)
  endif

  return !endPos

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mitreGensec
--
-- Description: mitre two connected gensec
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       first gensec
--    2   R      DBREF       second gensec
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mitreGensec(!gensec1 is DBREF,!gensec2 is DBREF)

  if !gensec1.pose.near(!gensec2.poss,1mm) then
    !drne = !gensec1.drne.bisect(!gensec2.drns.opposite())
    !drns = !gensec2.drns.bisect(!gensec1.drne.opposite())
    !gensec1.drne = !drne
    !gensec2.drns = !drns
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDb
--
-- Description: create/update platform external frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateDb()

  -- create/recreate frame
  if !this.dbElement.badref() then
    if !this.dbElement.unset() then
      new EXTFRM
      !this.dbElement = !!ce
    else
      new EXTFRM ref $!this.dbElement
    endif
  else
    !!ce = !this.dbElement
  endif

  assTmp $!<this.tmplReference>

  delete EXTFRM members
  !!ce.func = !this.function
  !!ce.desc = !this.description
  matref $!<this.matref>
  if !this.name.set() then
    !!ce.name = !this.name
    handle ANY
    endhandle
  endif

  if !this.spref.badref().not() then
    !edges = !this.profile.edges()
    !pos = !this.profile.position
    !ori = !this.profile.orientation
    !edgeArr = ARRAY()
    do !c indices !edges
      skip if undefined(!this.gensec[!c])
      !edgeArr.clear()
      !edgeArr[1] = !edges[!c]
      !edge = object PROFILE(!pos,!ori,!edgeArr)
      if !this.gensec[!c].set() then
        !refno = !this.gensec[!c]
        new GENSEC ref $!<refno>
      else
        new GENSEC
        !this.gensec[!c] = !!ce
      endif
      if !edge.isCircle().not() then
        !!ce.pos = !this.getEdgeStart(!edges[!c])
      endif
      new SPINE
      !edge.dbWrite(ce)
      !!ce = !this.gensec[!c]
      !!ce.spref = !this.spref
      !!ce.jusl  = !this.justification
      !!ce.bang = !this.bangle
      !!ce.purp = !this.purpose
      !!ce.gtyp = !!ce.catr.gtyp
      matref $!<this.matref>
    enddo
  endif

  !gensec = !this.gensec
  !gensec.compress()
  do !c indices !gensec
    if !c.eq(!gensec.size()) then
      break if !c.eq(1)
      !nextGensec = !gensec[1]
    else
      !nextGensec = !gensec[!c + 1]
    endif
    !this.mitreGensec(!gensec[!c],!nextGensec)
    handle ANY
    endhandle
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: modify object position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    new object position
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!pos is POSITION)

  -- init
  !oldPos = !this.position()
  !newPos = !pos.wrt(world)
  if !oldPos.eq(!newPos) then
    return
  endif

  !this.profile.position = !newPos

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: return current object position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    POSITION    object position
--
------------------------------------------------------------------------

define method .position() is POSITION

  return !this.profile.position.wrt(world)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: move object in its z-direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        distance
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elevation(!dist is REAL)

  !dir = !this.orientation().zdir()
  !newPos = !this.position().offset(!dir,!dist)

  !this.position(!newPos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: return object orientation
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ORIENTATION object orientation
--
------------------------------------------------------------------------

define method .orientation() is ORIENTATION

  !ori = !this.profile.orientation.wrt(world)
  handle ANY
    !ori = object ORIENTATION()
  endhandle

  return !ori

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: modify object orientation
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      ORIENTATION  new object orientation
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .orientation(!newOri is ORIENTATION)

  -- init
  !oldOri = !this.orientation()

  if !oldOri.eq(!newOri.wrt(world)) then
    return
  endif

  !this.profile.orientation = !newOri.wrt(world)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tmplReference
--
-- Description: set assembly template ref.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Assembly template
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmplReference(!tmpl is DBREF)

  -- exit if template is the same
  if !this.tmplReference.eq(!tmpl) then
    return
  endif

  !this.tmplReference = !tmpl
  !size = !this.defaultSize

  if !tmpl.badref().not() then
    !gensec = !!collectAllFor('GENSEC','(not (badref (spref) ))',!tmpl).first()
    handle NONE
      !this.spref = !gensec.spref
      !this.justification = !gensec.jusl
      !this.bangle = !gensec.bangl
      !sense = !this.sense(!tmpl)
      !this.sense(!sense)
    elsehandle ANY
    endhandle
    -- get expression for size
    !ddat = !!collectAllFor('DDAT','type of owner of DDSE eq ''PLTFRM'' and desc eq ''EXTERNALSIZE''',!this.tmplReference.owner)
    if !ddat.set() then
      !size = object EXPRESSION(!ddat[1].ddpr)
      handle ANY
      endhandle
    endif
  endif

  !this.size = !size

endmethod
-- End of method
