------------------------------------------------------------------------
--
-- Method:     gridOffset
--
-- Description: Modify grid XYOffset using passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridOffset(!position is POSITION) is XYPOSITION

  -- Map position on the ceiling grid plane
  !xyPosition = !this.plane.xyOffset(!position)

  -- Get XYOffset of position
  return !this.gridOffset(!xyPosition)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridOffset
--
-- Description: Modify grid XYOffset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        X offset
--    2   R      REAL        Y offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridOffset(!xOffset is REAL, !yOffset is REAL) is XYPOSITION

  !xyPos = object XYPOSITION(!xOffset,!yOffset)
  handle ANY
    !xyPos = object XYPOSITION()
  endhandle

  return !this.gridOffset(!xyPos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridOffset
--
-- Description: Modify grid offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION  Grid offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridOffset(!xyPosition is XYPOSITION) is XYPOSITION

  -- init
  !oldXY = !this.grid.gridXYPosition()

  if !xyPosition.x.unset().or(!xyPosition.y.unset()) then
    return !oldXY
  endif

  if !xyPosition.eq(!oldXY) then
    return !oldXY
  endif

  -- Modify object
  !this.grid.gridXYPosition(!xyPosition)

  -- Redraw grid
  !this.draw()

  return !this.grid.gridXYPosition()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      openings
--
-- Description: return openings as PROFILE objects
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of PROFILE objects
--
------------------------------------------------------------------------

define method .openings() is ARRAY

  !openings = !this.grid.innerBoundaries()

  -- loop through profiles to get rid of zero length lines
  do !c indices !openings
    !opening = !openings[!c]
    !edges = !opening.edges()
    do !cc indices !edges
      skip if !edges[!cc].length().neq(0)
      !edges[!cc].delete()
    enddo
    -- reset profile
    !opening = object PROFILE(!opening.position.wrt(world),!opening.orientation.wrt(world),!edges)
    if !opening.sense().neq(!this.flipOpening) then
      !opening.reverse()
    endif
    !openings[!c] = !opening
  enddo

  return !openings

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getRemovedRef
--
-- Description: remove db reference from registry of deleted gensec and return it
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference number
--
------------------------------------------------------------------------

define method .getRemovedRef() is DBREF

  !refno = nulref

  if !this.removedGensecs.set() then
    !refno = !this.removedGensecs.removeFirst()
  endif

  return !refno

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPrimary
--
-- Description: return primary sections
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       array of GENSEC's
--
------------------------------------------------------------------------

define method .getPrimary() is ARRAY

  if !this.dbElement.badref() then
    return ARRAY()
  endif

  !primary = !!collectAllFor('GENSEC','purp eq ''$!<this.purpose>'' and (part(function,1) eq ''X'' )',!this.dbElement)

  return !primary

endmethod
-- End of method
