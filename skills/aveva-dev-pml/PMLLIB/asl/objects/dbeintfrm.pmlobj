--
-- Description:     Container for internal frame (INTFRM) data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidNumbers(REAL,REAL,REAL)       -                   Set aid numbers
--  aidNumbersUnsetX()               -                   Unset aid numbers
--  aidNumbersUnsetY()               -                   Unset aid numbers
--  boundary()                       PROFILE             return boundary as PROFILE object
--  checkLength(DBREF)               BOOLEAN             check gensec length against minimum length
--  connectSections()                -                   Create connection between sections
--  connectSections(DBREF,DBREF,SECTIONCONNECTIONMANAGER) -                   create connection between two sections
--  connectSections(SECTIONCONNECTIONMANAGER) -
--  connectSections(STRING,DBREF,DBREF,SECTIONCONNECTIONMANAGER) -                   create connection between two sections
--  dbeIntFrm()                      -                   default constructor
--  dbeIntFrm(DBREF)                 BOOLEAN             Constructor
--  dbeIntFrm(PROFILE)               -                   default constructor
--  deleteGensec(DBREF)              -                   disconnect and delete GENSEC and store refno in .removedGensec member
--  detailPresent()                  BOOLEAN             return true if detail exists or can be created
--  draw()                           -                   Draw internal frame
--  elevation(REAL)                  -                   move object in its z-direction
--  flipOpening()                    BOOLEAN             returns true if opening(s) is/are flipped
--  flipOpening(BOOLEAN)             -
--  flipPrimary()                    -                   set primary section flip status
--  flipSecondary()                  -                   set secondary section flip status
--  gensecStatus(DBREF)              STRING              return gensec status (primary,secondary,etc...)
--  getExternal()                    ARRAY               get external frame sections
--  getJointData(DBREF)              ANYDATASET          extract connection details from joint (fixing)
--  getOpeningSections()             ARRAY               return opening frame sections
--  getPrimary()                     ARRAY               return primary sections
--  getRemovedRef()                  DBREF               remove db reference from registry of deleted gensec and return it
--  getSecondary()                   ARRAY               return secondary sections
--  getTmplOpening()                 ARRAY               get opening sections from template
--  getTmplPrimary()                 ARRAY               get primary sections from template
--  getTmplSecondary()               ARRAY               get secondary sections from template
--  gridAngle(REAL)                  -                   Modify grid angle
--  gridAngle(REAL,REAL)             -                   Modify grid angle
--  gridOffset(POSITION)             XYPOSITION          Modify grid XYOffset using passed position
--  gridOffset(REAL,REAL)            XYPOSITION          Modify grid XYOffset
--  gridOffset(XYPOSITION)           XYPOSITION          Modify grid offset
--  gridSpacing(ARRAY,ARRAY)         ARRAY               set XY grid spacing
--  openings()                       ARRAY               return openings as PROFILE objects
--  orientation()                    ORIENTATION         return object orientation
--  orientation(ORIENTATION)         -                   modify object orientation
--  position()                       POSITION            return current object position
--  position(POSITION)               -                   modify object position
--  roundOffPosition(POSITION)       POSITION            round off position according current units setting
--  setConnDetails(ARRAY,ARRAY,ARRAY,ARRAY,STRING) -                   extract and set catalogue and connection details from sections
--  setJointData(DBREF,ANYDATASET)   -                   apply attribute data to joint
--  stringSpacing(STRING)            STRING              return passed spacing as a string
--  tidy()                           -                   Tidy up aid graphics
--  tmplReference(DBREF)             -                   set assembly template ref.
--  updateDB()                       -                   creates/updates PltFrm element
--  xGridlines()                     ARRAY               return array of grid's y-lines where lines coincident with external frame are removed
--  yGridLines()                     ARRAY               return array of grid's y-lines split by x-lines
--

-- Define object
define object DBEINTFRM

  -- DB Element referenced
  member .dbElement              is DBREF

  -- Name
  member .name                   is STRING

  -- Function
  member .function               is STRING

  member .description            is STRING

  member .number                 is REAL

  member .matref                 is DBREF

  member .purpose                is STRING

  member .grid                   is RECTANGULARGRID

  member .sprefPrimary           is DBREF

  member .justificationPrimary   is STRING

  member .flipPrimary            is BOOLEAN

  member .banglePrimary          is REAL

  member .sprefSecondary         is DBREF

  member .justificationSecondary is STRING

  member .flipSecondary          is BOOLEAN

  member .bangleSecondary        is REAL

  member .sprefOpeningFrame      is DBREF

  member .justificationOpening   is STRING

  member .flipOpening           is BOOLEAN

  member .bangleOpening          is REAL

  -- NB: this a thickness  of plates not actual platform thickness
  member .platformThickness      is REAL

  member .posType is STRING

  member .tmplReference  is DBREF

  member .jointOnPrimary         is ARRAY
  member .jointOnExternalPrim    is ANYDATASET
  member .jointOnExternalSec     is ANYDATASET
  member .jointOnOpeningPrim     is ANYDATASET
  member .jointOnOpeningSec      is ANYDATASET

  -- minimum length expressions
  member .primaryMinLeng         is EXPRESSION
  member .secondaryMinLeng       is EXPRESSION
  member .defaultMinLeng         is EXPRESSION

  --size definition expressions - they are evaluated against SPCOM
  member .primarySize            is EXPRESSION
  member .secondarySize          is EXPRESSION
  member .openingSize            is EXPRESSION
  member .defaultSize            is EXPRESSION

  -- controls if the sections to be connected
  member .connectSections        is BOOLEAN

  -- register of removed frame members
  member .removedGensecs         is ARRAY

  -- Aid number
  member .aidAxes                is REAL
  member .aidNumberLines         is REAL
  member .aidNumberOuter         is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      dbeIntFrm
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dbeIntFrm()

  !this.name          = STRING()
  !this.function      = ''
  !this.description   = ''
  !this.number        = 0
  !this.purpose      = 'ASLA'
  !this.sprefPrimary = nulref
  !this.sprefSecondary = nulref
  !this.sprefOpeningFrame = nulref
  !this.flipPrimary   = false
  !this.flipSecondary = false
  !this.flipOpening   = false
  !this.banglePrimary = 0
  !this.bangleSecondary = 0
  !this.bangleOpening = 0

  !this.defaultMinLeng.expression('( PARA[1] )')
  !this.primaryMinLeng = !this.defaultMinLeng
  !this.secondaryMinLeng = !this.defaultMinLeng

  !this.defaultSize.expression('( PARA[1] )')
  !this.primarySize = !this.defaultSize
  !this.secondarySize = !this.defaultSize
  !this.openingSize = !this.defaultSize

  !this.grid = object RECTANGULARGRID()
  !xy[1] = 600mm
  !this.grid.gridXSpacings(!xy)
  !this.grid.gridYSpacings(!xy)
  !this.grid.gridAngle(0)

  !this.connectSections = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbeIntFrm
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     shape of PLTGRD
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dbeIntFrm(!shape is PROFILE)

  -- load defaults
  !this.dbeIntFrm()

  -- add shape
  !this.grid.position(!shape.position)
  !this.grid.orientation(!shape.orientation)
  !this.grid.outerBoundary(!shape)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tmplReference
--
-- Description: set assembly template ref.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       assembly template ref.
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmplReference(!tmpl is DBREF)

  -- exit if template is the same
  if !this.tmplReference.eq(!tmpl) then
    return
  endif

  !primary = !this.getPrimary()
  !secondary = !this.getSecondary()
  !opening = !this.getOpeningSections()

  if !tmpl.badref() then
    !this.tmplReference = nulref
    !external = ARRAY()
  else
    !this.tmplReference = !tmpl
    !tmpPrimary = !this.getTmplPrimary()
    if !tmpPrimary.set() then
      !primary = !tmpPrimary
    endif
    !tmpSecondary = !this.getTmplSecondary()
    if !tmpSecondary.set() then
      !secondary = !tmpSecondary
    endif
    !tmpOpening = !this.getTmplOpening()
    if !tmpOpening.set() then
      !opening = !tmpOpening
    endif
    !external = !this.getExternal()
  endif

  !this.setConnDetails(!primary,!secondary,!opening,!external,'change')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setConnDetails
--
-- Description: extract and set catalogue and connection details from sections
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Primary sections
--    2   R      ARRAY       Secondary sections
--    3   R      ARRAY       Opening sections
--    4   R      ARRAY       External sections
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setConnDetails(!primary is ARRAY,!secondary is ARRAY,!opening is ARRAY,!external is ARRAY,!mode is STRING)

  -- store original settings
  !sprefPrimary = !this.sprefPrimary
  !sprefSecondary = !this.sprefSecondary
  !sprefOpening = !this.sprefOpeningFrame

  !newData = true
  if !mode.eq('change').and(!this.tmplReference.unset()) then
    !newData = false
  endif

  -- get catalogue details
  if !primary.set() then
    if !newData then
      !this.sprefPrimary  = !primary[1].spref
      !this.justificationPrimary  = !primary[1].jusl
      !this.banglePrimary = !primary[1].bangle
    endif
  endif
  if !secondary.set() then
    if !newData then
      !this.sprefSecondary  = !secondary[1].spref
      !this.justificationSecondary  = !secondary[1].jusl
      !this.bangleSecondary = !secondary[1].bangle
    endif
  endif
  if !opening.set() then
    if !newData then
      !this.sprefOpeningFrame = !opening[1].spre
      !this.justificationOpening = !opening[1].jusl
      !this.bangleOpening = !opening[1].bangle
      -- get flip status
      !spine = spine 1 of $!<opening[1]>
      handle ANY
        !flip = false
      elsehandle NONE
        !tmp = object PROFILE(!opening[1].pos,!opening[1].ori,!spine.memb.evaluate(object BLOCK('!spine.memb[!evalIndex].pos')))
        !flip = !tmp.sense()
      endhandle
      !this.flipOpening = !flip
    endif
  endif

  if !mode.eq('init').and(!this.tmplReference.set()) then
  -- replace the default sprefs from template with the actual ones from design instance
    if !sprefPrimary.set() then
      !this.sprefPrimary = !sprefPrimary
    endif
    if !sprefSecondary.set() then
      !this.sprefSecondary = !sprefSecondary
    endif
    if !sprefOpening.set() then
      !this.sprefOpeningFrame = !sprefOpening
    endif
  endif

  -- connection details
  -- clear previous settings
  !this.jointOnPrimary.clear()
  !this.jointOnExternalPrim = object ANYDATASET()
  !this.jointOnOpeningPrim = object ANYDATASET()
  !this.jointOnExternalSec = object ANYDATASET()
  !this.jointOnOpeningSec = object ANYDATASET()
  !this.primaryMinLeng = !this.defaultMinLeng
  !this.secondaryMinLeng = !this.defaultMinLeng
  !this.primarySize = !this.defaultSize
  !this.secondarySize = !this.defaultSize
  !this.openingSize = !this.defaultSize

  -- exit if assembly template not set
  if !this.tmplReference.unset() then
    return
  endif

  -- get minimum length expressions
  !ddat = !!collectAllFor('DDAT','desc eq ''PRIMARYMINLENG''',!this.tmplReference.owner)
  if !ddat.set() then
    !this.primaryMinLeng.expression(!ddat[1].ddpr)
    handle ANY
      !this.primaryMinLeng = !this.defaultMinLeng
    endhandle
  endif
  !ddat = !!collectAllFor('DDAT','desc eq ''SECONDARYMINLENG''',!this.tmplReference.owner)
  if !ddat.set() then
    !this.secondaryMinLeng.expression(!ddat[1].ddpr)
    handle ANY
      !this.secondaryMinLeng = !this.defaultMinLeng
    endhandle
  endif

  -- get expression for size definition
  !ddat = !!collectAllFor('DDAT','type of owner of DDSE eq ''PLTFRM'' and desc eq ''PRIMARYSIZE''',!this.tmplReference.owner)
  if !ddat.set() then
    !expr = object EXPRESSION(!ddat[1].ddpr)
    handle NONE
      !this.primarySize = !expr
    elsehandle ANY
    endhandle
  endif

  !ddat = !!collectAllFor('DDAT','type of owner of DDSE eq ''PLTFRM'' and desc eq ''SECONDARYSIZE''',!this.tmplReference.owner)
  if !ddat.set() then
    !expr = object EXPRESSION(!ddat[1].ddpr)
    handle NONE
      !this.secondarySize = !expr
    elsehandle ANY
    endhandle
  endif

  !ddat = !!collectAllFor('DDAT','type of owner of DDSE eq ''PLTFRM'' and desc eq ''OPENINGSIZE''',!this.tmplReference.owner)
  if !ddat.set() then
    !expr = object EXPRESSION(!ddat[1].ddpr)
    handle NONE
      !this.openingSize = !expr
    elsehandle ANY
    endhandle
  endif

  -- process primary section(s)
  if !primary.set() then
    !jldatu = !!dtbMemberOfType(!primary[1],'JLDATU',1)
    -- secondary to primary connection details
    if !jldatu.set() then
      !fixing = !!collectAllFor('FIXING','type of owner of owner of owner of owner eq ''INTFRM''',!jldatu)
      if !fixing.size().geq(2) then
        !jointOnPrimary[1] = !this.getJointData(!fixing[1])
        !jointOnPrimary[2] = !this.getJointData(!fixing[2])
        !this.jointOnPrimary = !jointOnPrimary
      endif
    endif

    !jointOnOpening = object ANYDATASET()
    !jointOnExternal = object ANYDATASET()
    -- primary to external and opening connection details
    do !gensec values !primary
      !jois = !gensec.jois
      !joie = !gensec.joie
      if !jois.badref().not() then
        if !external.find(!jois.owner.owner.owner).set() then
          if !jointOnExternal.unset() then
            !jointOnExternal = !this.getJointData(!jois)
          endif
        elseif !opening.find(!jois.owner.owner.owner).set() then
          if !jointOnOpening.unset() then
            !jointOnOpening = !this.getJointData(!jois)
          endif
        endif
      endif
      if !gensec.joie.badref().not() then
        if !external.find(!joie.owner.owner.owner).set() then
          if !jointOnExternal.unset() then
            !jointOnExternal = !this.getJointData(!joie)
          endif
        elseif !opening.find(!joie.owner.owner.owner).set() then
          if !jointOnOpening.unset() then
            !jointOnOpening = !this.getJointData(!joie)
          endif
        endif
      endif
      break if !jointOnExternal.set().and(!jointOnOpening.set())
    enddo
    if !jointOnExternal.set() then
      !this.jointOnExternalPrim = !jointOnExternal
    endif
    if !jointOnOpening.set() then
      !this.jointOnOpeningPrim = !jointOnOpening
    endif
  endif

  -- secondary to external and opening connection details
  if !secondary.set() then
    !jointOnOpening = object ANYDATASET()
    !jointOnExternal = object ANYDATASET()
    do !gensec values !secondary
      !jois = !gensec.jois
      !joie = !gensec.joie
      if !jois.badref().not() then
        if !external.find(!jois.owner.owner.owner).set() then
          if !jointOnExternal.unset() then
            !jointOnExternal = !this.getJointData(!jois)
          endif
        elseif !opening.find(!jois.owner.owner.owner).set() then
          if !jointOnOpening.unset() then
            !jointOnOpening = !this.getJointData(!jois)
          endif
        endif
      endif
      if !joie.badref().not() then
        if !external.find(!joie.owner.owner.owner).set() then
          if !jointOnExternal.unset() then
            !jointOnExternal = !this.getJointData(!joie)
          endif
        elseif !opening.find(!joie.owner.owner.owner).set() then
          if !jointOnOpening.unset() then
            !jointOnOpening = !this.getJointData(!joie)
          endif
        endif
      endif
      break if !jointOnExternal.set().and(!jointOnOpening.set())
    enddo
    if !jointOnExternal.set() then
      !this.jointOnExternalSec = !jointOnExternal
    endif
    if !jointOnOpening.set() then
      !this.jointOnOpeningSec = !jointOnOpening
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getJointData
--
-- Description: extract connection details from joint (fixing)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       fixing
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getJointData(!joint is DBREF) is ANYDATASET

  !data = object ANYDATASET('=0/0')
  !data.setAttribute('posli',!joint.owner.posli)
  !data.setAttribute('spref',!joint.spref)
  !data.setAttribute('desp',!joint.desp)
  !data.setAttribute('cutb',!joint.cutb)
  !data.setAttribute('jline',!joint.jline)
  !data.setAttribute('xdir',!joint.ori.xdir().wrt(world))
  !data.setAttribute('joint',!joint)
  !data.setAttribute('orrf',!joint)

  !data.description = !joint.spref.tmpr.description
  handle ANY
    !data.description = !joint.catref.name
    handle ANY
    endhandle
  endhandle


  -- extract rules if any
  !rlist = !joint.rlist
  !attr = ARRAY()
  !index = ARRAY()
  !expr = ARRAY()
  !stat = ARRAY()
  do !ruleName values !rlist
    !!ce = !joint
    var !rule rule of $!<ruleName>
    !!ce = same
    !sRule = !rule.splitString(!ruleName & ' NUM')
    if !sRule.size().eq(1) then
      !rule = !rule.after('Rule').trim()
      !status = !sRule[1].split()[2]
      !attr.append(!ruleName)
      !expr.append(!rule)
      !stat.append(!status)
      !index.append('')
    else
      do !c indices !sRule
        !rule = !sRule[!c].trim()
        skip if !rule.empty()
        !split = !rule.split()
        !numb = !split[1].real()
        !rule = !rule.after('Rule').trim()
        !status = !split[2]
        !attr.append(!ruleName)
        !expr.append(!rule)
        !stat.append(!status)
        !index.append('NUM ' & !numb)
      enddo
    endif
  enddo

  if !attr.set() then
    !rules[1] = !attr
    !rules[2] = !index
    !rules[3] = !stat
    !rules[4] = !expr
    !data.setAttribute('rules',!rules)
  endif

  return !data

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      detailPresent
--
-- Description: return true if detail exists or can be created
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .detailPresent() is BOOLEAN

  if !this.dbElement.badref() then
    return false
  endif

  return !this.dbElement.memb.set()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbeIntFrm
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .dbeIntFrm(!dbElement is DBREF) is BOOLEAN

   -- Load defaults
   !this.dbeIntFrm()

   -- Verify type of the element passed
   if(!dbElement.fulltype.neq('INTFRM'))then
     !!error.text    = 'Element ' & !dbElement.namn & ' is not an INTFRM.'
      return false
   endif

  -- Set db element
  !this.dbElement         = !dbElement

  -- template ref.
  if !dbElement.assTmp.badref() then
    !this.tmplReference = nulref
  else
    !this.tmplReference = !dbElement.assTmp
  endif

  -- Get attributes of the element
  if(!this.dbElement.isNamed) then
    !this.name        = !this.dbElement.namn
  else
    !this.name        = STRING()
  endif

  !this.description     = !this.dbElement.description
  !this.function        = !this.dbElement.function
  !this.number          = !this.dbElement.number

  -- matref
  !this.matref          = !this.dbElement.matref
  !gensecWithMatr = !!collectAllFor('GENSEC','(not(badref(matref)))',!dbElement)
  if !gensecWithMatr.set() then
  -- override matref with one set on gensec
    !this.matref = !gensecWithMatr.first().matref
  endif

  !primary = !this.getPrimary()
  if !primary.set() then
    !firstPrimary = !primary.first()
  endif
  !secondary = !this.getSecondary()
  if !secondary.set() then
    !firstSecondary = !secondary.first()
  endif
  !openingGensec = !this.getOpeningSections()
  !external = ARRAY()
  if !this.tmplReference.set() then
    !tmpPrimary = !this.getTmplPrimary()
    if !tmpPrimary.set() then
      !primary = !tmpPrimary
    endif
    !tmpSecondary = !this.getTmplSecondary()
    if !tmpSecondary.set() then
      !secondary = !tmpSecondary
    endif
    !tmpOpenings = !this.getTmplOpening()
    if !tmpOpenings.set() then
      !openingGensec = !tmpOpenings
    endif
    !external = !this.getExternal()
  endif


  !this.setConnDetails(!primary,!secondary,!openingGensec,!external,'init')

  !refe = !!ce

  !!ce = !this.dbElement

  !this.grid = object RECTANGULARGRID(ce)

  -- set primary flip status
  if defined(!firstPrimary) then
    !lineDir = !this.grid.xGridlines()[1][2].direction().wrt(world)
    handle NONE
      !primaryDir = !firstPrimary.poss.direction(!firstPrimary.pose).wrt(world)
      !this.flipPrimary = !primaryDir.neq(!lineDir)
    elsehandle ANY
    endhandle
  endif

  -- set secondary flip status
  if defined(!firstSecondary) then
    !lineDir = !this.yGridLines()[1][2].direction().wrt(world)
    handle NONE
      !secondaryDir = !firstSecondary.poss.direction(!firstSecondary.pose).wrt(world)
      !this.flipSecondary = !secondaryDir.neq(!lineDir)
    elsehandle ANY
    endhandle
  endif

  !!ce = !refe

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      flipPrimary
--
-- Description: set primary section flip status
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flipPrimary()

  !this.flipPrimary = !this.flipPrimary.not()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      flipSecondary
--
-- Description: set secondary section flip status
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flipSecondary()

  !this.flipSecondary = !this.flipSecondary.not()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      flipOpening
--
-- Description: returns true if opening(s) is/are flipped
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .flipOpening() is BOOLEAN

  -- init
  !openings = !this.openings()

  if !openings.set() then
  -- get value from first opening
    !flip = !openings.first().sense()
  else
  -- get value from object member
    !flip = !this.flipOpening
  endif

  return !flip

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      flipOpenings
--
-- Description: flip opening frame(s)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     flip (true = flipped/false = non-flipped)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .flipOpening(!flip is BOOLEAN)

  -- init
  if !flip.eq(!this.flipOpening()) then
    return
  endif

  -- set sense
  !this.flipOpening = !flip

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridAngle
--
-- Description: Modify grid angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridAngle(!angle is REAL)

  -- Modify object
  !this.grid.gridAngle(!angle)

  -- Redraw grid
  !this.draw()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:     gridAngle
--
-- Description: Modify grid angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridAngle(!angle is REAL,!spanAxis is REAL)

  if !spanAxis.eq(2) then
    !gridAngle = !angle + 90
  else
    !gridAngle = !angle
  endif

  -- Modify object
  !this.gridAngle(!gridAngle)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xGridlines
--
-- Description: return array of grid's y-lines where lines coincident with external frame are removed
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       returned grid lines
--
------------------------------------------------------------------------

define method .xGridlines() is ARRAY

  !xGridlines = !this.grid.xGridlines()
  !boundary = !this.grid.outerBoundary().mergepoints().mergearcs().edges()

  -- remove arc edges
  do !c indices !boundary
    if !boundary[!c].objectType().eq('ARC') then
      !boundary[!c].delete()
    endif
  enddo
  -- remove coincident lines
  do !c indices !xGridlines
    do !cc from 2 to !xGridlines[!c].size()
      skip if !xGridlines[!c][!cc].length().eq(0)
      !tmpLine = !xGridlines[!c][!cc]
      do !edge values !boundary
        skip if !edge.length().eq(0)
        if !tmpLine.direction().isParallel(!edge.direction()).and(!tmpLine.distance(!edge).lt(50mm)) then
          --remove gridline if it is parallel to the boundary segment and the distance between then is less than 50mm
          --there should be some configurable default/criterion
          !xGridlines[!c][!cc].delete()
          break
        endif
      enddo
      skip if undefined(!xGridlines[!c][!cc])
    enddo
    !xGridlines[!c].compress()
    if !xGridlines[!c].size().eq(1) then
      !xGridlines[!c].delete()
    endif
  enddo
  !xGridlines.compress()

  return !xGridlines

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      yGridLines
--
-- Description: return array of grid's y-lines split by x-lines
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       returned grid lines
--
------------------------------------------------------------------------

define method .yGridLines() is ARRAY

  -- get gridlines from RECTANGULARGRID object
  !yGridLines = !this.grid.yGridLines()
  !xGridlines = !this.xGridlines()

  -- remove arc edges
  !boundary = !this.grid.outerBoundary().mergepoints().mergearcs().edges()
  do !c indices !boundary
    if !boundary[!c].objectType().eq('ARC') then
      !boundary[!c].delete()
    endif
  enddo

  -- remove lines coincident with boundary
  do !c indices !yGridLines
    do !cc from 2 to !yGridLines[!c].size()
      skip if !yGridLines[!c][!cc].length().eq(0)
      !tmpLine = !yGridLines[!c][!cc]
      do !edge values !boundary
        skip if !edge.length().eq(0)
        if !tmpLine.direction().isParallel(!edge.direction()).and(!tmpLine.distance(!edge).lt(50mm)) then
          --remove gridline if it is parallel to the boundary segment and the distance between then is less than 50mm
          --there should be some configurable default/criterion
          !yGridLines[!c][!cc].delete()
          break
        endif
      enddo
      skip if undefined(!yGridLines[!c][!cc])
    enddo
    !yGridLines[!c].compress()
    if !yGridLines[!c].size().eq(1) then
      !yGridLines[!c].delete()
    endif
  enddo
  !yGridLines.compress()

  -- split secondary Y lines
  !yLines = ARRAY()
  !linesOnSplit = ARRAY()
  do !c indices !xGridlines
    do !cc from 2 to !xGridlines[!c].size()
      !linesOnSplit[!c] = !xGridlines[!c][!cc]
    enddo
  enddo
  !openings = !this.openings()
  do !c indices !yGridLines
    !numb = !yGridLines[!c][1]
    !yLineSplit = ARRAY()
    !yLineSplit[1] = !numb
    !tmpYgridLines = !yGridLines[!c].from(2).invert()
    do !i indices !tmpYgridLines
      !yLine = !tmpYgridLines[!i]
      do !cc indices !linesOnSplit
        skip if !yLine.length().eq(0)
        !intersection = !yLine.intersection(!linesOnSplit[!cc])
        skip if !yLine.onProjected(!intersection).not()
        !newline = !yLine.from(!intersection)
        skip if !newline.length().eq(0)
        !yLine = !yLine.to(!intersection)
        -- check line against openings
        !tmpLineArr[1] = !newline
        !newlineProfile = object PROFILE(!newline.startPosition,object ORIENTATION('Y is ' & !newline.direction()),!tmpLineArr)
        do !opening values !openings
          if !opening.onProfile(!newline.startPosition).and(!opening.onProfile(!newline.endPosition)) then
            !newline.delete()
          elseif !opening.onProfile(!newline.startPosition).and(!opening.onProfile(!newline.endPosition).not()) then
            !intPos = !opening.intersections(!newlineProfile)
            !newline.startPosition = !intPos[1]
            handle ANY
            endhandle
          elseif !opening.onProfile(!newline.startPosition).not().and(!opening.onProfile(!newline.endPosition)) then
            !intPos = !opening.intersections(!newlineProfile)
            !newline.endPosition = !intPos[1]
            handle ANY
            endhandle
          endif
        enddo
        if defined(!newline) then
          !yLineSplit.append(!newline)
        endif
      enddo
      if !yLine.length().boolean() then
        !yLineSplit.append(!yLine)
      endif
    enddo
    !yLines.append(!yLineSplit)
  enddo

  return !yLines

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      roundOffPosition
--
-- Description: round off position according current units setting
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position to rounded off
--
-- Return:
--   [Data Type] [Description]
--    POSITION    rounded off position
--
------------------------------------------------------------------------

define method .roundOffPosition(!pos is POSITION) is POSITION

 !rounded = !pos
 !rounded.east = !rounded.east.string(!!distanceFmt).real(!!distanceFmt)
 !rounded.north = !rounded.north.string(!!distanceFmt).real(!!distanceFmt)
 !rounded.up = !rounded.up.string(!!distanceFmt).real(!!distanceFmt)

 return !rounded

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundary
--
-- Description: return boundary as PROFILE object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    PROFILE     Platform boundary
--
------------------------------------------------------------------------

define method .boundary() is PROFILE

  !boundary = !this.grid.outerBoundary().mergepoints().mergearcs()
  if !boundary.set() then
    !boundary.position = !boundary.position.wrt(world)
    handle ANY
      return !boundary
    endhandle
    !boundary.orientation = !boundary.orientation.wrt(world)
    handle ANY
      return !boundary
    endhandle
  endif

  return !boundary

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      stringSpacing
--
-- Description: return passed spacing as a string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      spacing identifier (X/Y)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stringSpacing(!xy is STRING) is STRING

  -- init
  !result = ''
  !strSpacing = ARRAY()
  if !xy.upcase().eq('X') then
    !spacing = !this.grid.gridXSpacings()
  elseif !xy.upcase().eq('Y') then
    !spacing = !this.grid.gridYSpacings()
  endif

  -- units
  !fmt = !!distanceFmt
  -- Round down to nearest mm (only for current units MM)
  if (!!isImperialLength('DIST').not()) then
    !testUnit = 1mm
    !unitQualifier = !testUnit.units().unitQualifier().upcase()
    if( !unitQualifier eq 'MM' ) then
      !fmt.dp = 0
    elseif( !unitQualifier eq 'METRE' ) then
      !fmt.dp = 3
    else
      !fmt.dp = 2
    endif
  endif

  !blankSpaceFound = false
  do !space values !spacing
    !strSpace = !space.string(!fmt).trim()
    if !strSpace.match(' ').boolean() then
      !blankSpaceFound = true
    endif
    !strSpacing.append(!strSpace)
  enddo

  if !blankSpaceFound then
    !delim = ' ; '
  else
    !delim = ' '
  endif

  do !space values !strSpacing
    !result = !result & !delim & !space
  enddo

  !result = !result.trim().trim('L',';').trim()
  if !result.empty() then
    !result = STRING(0,!fmt)
  endif

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gridSpacing
--
-- Description: set XY grid spacing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     ARRAY       X spacings real array
--    2   R     ARRAY       Y spacings real array
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       New spacing as string
--
------------------------------------------------------------------------

define method .gridSpacing(!xSpacing is ARRAY,!ySpacing is ARRAY) is ARRAY

  -- init
  !result[1] = !this.stringSpacing('x')
  !result[2] = !this.stringSpacing('y')
  !x = ARRAY()
  !y = ARRAY()
  !oldX = !this.grid.gridXSpacings()
  !oldY = !this.grid.gridYSpacings()

  if !xSpacing.unset() then
    return error 1 'At least one numeric value must be given for Secondary Spacing'
  endif
  if !ySpacing.unset() then
    return error 1 'At least one numeric value must be given for Primary Spacing'
  endif

  -- check for zero or negative values
  do !space values !xSpacing
    if !space.gt(0) then
      !x.append(!space)
    endif
  enddo
  do !space values !ySpacing
    if !space.gt(0) then
      !y.append(!space)
    endif
  enddo

  if !x.unset() then
    return error 2 'Secondary Spacing must not contain zero or negative value'
  endif
  if !y.unset() then
    return error 2 'Primary Spacing must not contain zero or negative value'
  endif

  if !x.eq(!oldX).and(!y.eq(!oldY)) then
    return !result
  endif

  !this.grid.gridXSpacings(!x)
  !this.grid.gridYSpacings(!y)

  !this.draw()

  !result[1] = !this.stringSpacing('x')
  !result[2] = !this.stringSpacing('y')

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     draw
--
-- Description: Draw internal frame
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  if !this.grid.outerBoundary().unset() then
    return
  endif

  -- Remove current graphics
  !this.tidy()

  -- Get boundary information
  !outerBoundary    = !this.grid.outerBoundary()
  !dir = !outerBoundary.orientation.zdir()
  !dist = !this.platformThickness
  !outerBoundary.position = !outerBoundary.position.offset(!dir,!dist)
  !outerBoundary.draw(!this.aidNumberOuter, 1, 5)

  if(!this.aidNumberLines.unset().not())then

    -- Get gridlines
    !gridLines        = !this.grid.xGridlines()

    do !lines values !gridLines
      do !j indices !lines
        skip if(!j.eq(1))
        skip if !lines[!j].length().eq(0)
        !lines[!j].offset(!dir,!dist).draw(!this.aidNumberLines, 2, 6)
      enddo
    enddo

  endif

  if(!this.aidAxes.unset().not())then

    !gridLines        = !this.grid.yGridLines()

    do !lines values !gridLines
      do !j indices !lines
        skip if(!j.eq(1))
        skip if !lines[!j].length().eq(0)
        !lines[!j].offset(!dir,!dist).draw(!this.aidAxes, 2, 2)
      enddo
    enddo

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDB
--
-- Description: creates/updates INTFRM element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .updateDB()

  -- init
  !removeShort = true

  -- create/recreate frame
  if !this.dbElement.badref() then
    if !this.dbElement.unset() then
       new INTFRM
       !this.dbElement = !!ce
    else
       new INTFRM ref $!this.dbElement
    endif
  else
    !!ce = !this.dbElement
    -- delete all gensec and store their references
    !allMemb = !!ce.memb
    do !memb values !allMemb
      skip if !memb.type.neq('GENSEC')
      skip if !memb.purp.neq(!this.purpose)
      -- remove external references
      if !memb.jois.badref().not() then
        if !memb.jois.ownls.findfirst(!memb.owner).unset() then
          !!disconnectGensec(!memb,'start')
        endif
      endif
      if !memb.joie.badref().not() then
        if !!dtbGetOwnerType(!memb.joie,'INTFRM').neq(!memb.owner) then
          !!disconnectGensec(!memb,'end')
        endif
      endif
      !!ce = !memb
      -- store refno in registry
      !this.removedGensecs.append(!memb)
      -- then delete it
      delete GENSEC
    enddo
  endif

  assTmp $!<this.tmplReference>

  -- align frame position and orientation
  !!ce.pos = !this.position()
  !!ce.ori = !this.orientation()
  matref $!<this.matref>

  if !this.name.set() then
    !!ce.name = !this.name
    handle ANY
    endhandle
  endif

  -- apply object settings to db element
  !!ce.function    = !this.function
  !!ce.purpose     = !this.purpose
  !!ce.description = !this.description
  !!ce.number      = !this.number

  !!ce.gAngle      = !this.grid.gridAngle()
  !!ce.grdXSpacing = !this.grid.gridXSpacings()
  !!ce.grdYSpacing = !this.grid.gridYSpacings()
  !xyPosition                 = !this.grid.gridXYPosition()
  !offset[1]                  = !xyPosition.x
  !offset[2]                  = !xyPosition.y
  !!ce.gXYOffset   = !offset


  !validReferences = !this.sprefPrimary.set().and(!this.sprefSecondary.set()).and(!this.sprefOpeningFrame.set())
  if !validReferences then
    -- recreate gensec
    !xGridlines = !this.xGridlines()
    !yGridLines = !this.yGridLines()
    !primary = ARRAY()
    !secondary = ARRAY()
    -- X sections
    do !c indices !xGridlines
      !numb = !xGridlines[!c][1]
      !tmpX = !xGridlines[!c].from(2)
      do !cc indices !tmpX
        !ctrLine = !tmpX[!cc]
        if !this.flipPrimary then
          !ctrLine = !ctrLine.reverseSense()
        endif
        !refno = !this.getRemovedRef()
        !refString = ''
        if !refno.set() then
          !refString = 'ref ' & !refno
        endif
        new GENSEC $!<refString>
        !!ce.purp = !this.purpose
        !!ce.func = 'X ' & !numb & ' ' & !cc
        !!ce.spref    = !this.sprefPrimary
        !!ce.gtyp = !!ce.catr.gtyp
        matref $!<this.matref>
        !!ce.position = !ctrLine.startPosition
        NEW SPINE
        NEW POINSP
        NEW POINSP
        !!ce.position = !ctrLine.endPosition
        GENSEC
        if !removeShort then
          if !this.checkLength(!!ce).not() then
            !this.deleteGensec(!!ce)
            skip
          endif
        endif
        !!ce.jusl = !this.justificationPrimary
        !!ce.bang = !this.banglePrimary
        DRNS PERP DRNE PERP
        !primary.append(!!ce)
      enddo
    enddo
    -- Y sections
    do !c indices !yGridLines
      !numb = !yGridLines[!c][1]
      !tmpY = !yGridLines[!c].from(2)
      do !cc indices !tmpY
        !refno = !this.getRemovedRef()
        !refString = ''
        if !refno.set() then
          !refString = 'ref ' & !refno
        endif
        !ctrLine = !tmpY[!cc]
        if !this.flipSecondary then
          !ctrLine = !ctrLine.reverseSense()
        endif
        new GENSEC $!<refString>
        !!ce.purp = !this.purpose
        !!ce.func = 'Y ' & !numb & ' ' & !cc
        !!ce.spref    = !this.sprefSecondary
        !!ce.gtyp = !!ce.catr.gtyp
        matref $!<this.matref>
        !!ce.position = !ctrLine.startPosition
        NEW SPINE
        NEW POINSP
        NEW POINSP
        !!ce.position = !ctrLine.endPosition
        GENSEC
        if !removeShort then
          if !this.checkLength(!!ce).not() then
            !this.deleteGensec(!!ce)
            skip
          endif
        endif
        !!ce.jusl = !this.justificationSecondary
        !!ce.bang = !this.bangleSecondary
        DRNS PERP DRNE PERP
        !secondary.append(!!ce)
      enddo
    enddo


    -- recreate frame for openings
    !openings = !this.openings()
    do !opening values !openings
      !refno = !this.getRemovedRef()
      !refString = ''
      if !refno.set() then
        !refString = 'ref ' & !refno
      endif
      NEW GENSEC $!<refString>
      !!ce.purp = !this.purpose
      matref $!<this.matref>
      NEW SPINE
      !opening.dbWrite(ce)
      GENSEC
      !!ce.func = 'PLOPEN'
      !!ce.jusl = !this.justificationOpening
      !!ce.spref    = !this.sprefOpeningFrame
      !!ce.gtyp = !!ce.catr.gtyp
      !!ce.bang = !this.bangleOpening
      if !!ce.drne.isParallel(!!ce.drns).not() then
        !drns = !!ce.drns.bisect(!!ce.drne.opposite())
        !drne = !!ce.drne.bisect(!!ce.drns.opposite())
        !!ce.drns = !drns
        !!ce.drne = !drne
      endif
    enddo

    -- resolve internal/external connections
    !this.connectSections()

    if !removeShort then
      !allGensec = !primary
      !allGensec.appendArray(!secondary)
      do !gensec values !allGensec
        if !this.checkLength(!gensec).not() then
          !this.deleteGensec(!gensec)
        endif
      enddo
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      connectSections
--
-- Description: Create connection between sections
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectSections()

  if !this.connectSections.not() then
    return
  endif

  if !this.dbElement.badref() then
    return
  endif

  -- connection manager
  !conn = object SECTIONCONNECTIONMANAGER()
  --!conn.setPlineRule('ccon eq ''ANY''')
  if !this.tmplReference.set() then
    !conn.localPlineRulePriority = true
  endif

  prompt 'Collecting sections to connect...'
  !primarySect = !this.getPrimary()
  !secondarySect = !this.getSecondary()
  !openingSect = !this.getOpeningSections()
  !extFrame = !!dtbMemberOfType(!this.dbElement.owner,'EXTFRM',1)
  if !extFrame.set() then
    !externalSect = !!collectAllFor('GENSEC','',!extFrame)
  else
    !externalSect = ARRAY()
  endif

  !steps = !primarySect.size() * !secondarySect.size()
  !steps = !steps + ( !primarySect.size() * !openingSect.size() )
  !steps = !steps + ( !secondarySect.size() * !openingSect.size() )
  !steps = !steps + ( !primarySect.size() * !externalSect.size() )
  !steps = !steps + ( !secondarySect.size() * !externalSect.size() )

  !count = 0
  !percent = !steps / 100

  -- loop through primary sections to connect them to openings and external frame
  prompt 'Connecting primary sections to external frame and opening frames...'
  do !primary values !primarySect
    do !external values !externalSect
      !count = !count + 1
      !!fmsys.setProgress(!count / !percent)
      !intersections = !!gensecsIntersections(!primary,!external).unique()
      if !intersections.set() then
        if !intersections.size().gt(1) then
          !spine = !!dtbMemberOfType(!primary,'SPINE',1)
          skip if !spine.unset()
          !curves = !!collectAllFor('CURVE','',!spine).set()
          !countPoinsp = !!collectAllFor('POINSP','',!spine).size()
          if !curves.or(!countPoinsp.gt(2)) then
          endif
          !this.connectSections('Start',!primary,!external,!conn)
          !this.connectSections('End',!primary,!external,!conn)
        else
          !this.connectSections(!primary,!external,!conn)
        endif
      endif
    enddo
    do !opening values !openingSect
      !count = !count + 1
      !!fmsys.setProgress(!count / !percent)
      !intersections = !!gensecsIntersections(!primary,!opening).unique()
      if !intersections.set() then
        if !intersections.size().gt(1) then
          !this.connectSections('Start',!primary,!opening,!conn)
          !this.connectSections('End',!primary,!opening,!conn)
        else
          !this.connectSections(!primary,!opening,!conn)
        endif
      endif
    enddo
  enddo

  -- loop through secondary section
  prompt 'Connecting secondary sections....'
  do !secondary values !secondarySect
    do !primary values !primarySect
      !count = !count + 1
      !!fmsys.setProgress(!count / !percent)
      !intersections = !!gensecsIntersections(!secondary,!primary).unique()
      if !intersections.set() then
        !this.connectSections(!secondary,!primary,!conn)
      endif
    enddo
    do !opening values !openingSect
      !count = !count + 1
      !!fmsys.setProgress(!count / !percent)
      !intersections = !!gensecsIntersections(!secondary,!opening).unique()
      if !intersections.set() then
        !this.connectSections(!secondary,!opening,!conn)
      endif
    enddo
    do !external values !externalSect
      !count = !count + 1
      !!fmsys.setProgress(!count / !percent)
      !intersections = !!gensecsIntersections(!secondary,!external).unique()
      if !intersections.set() then
        if !intersections.size().gt(1) then
          !this.connectSections('Start',!secondary,!external,!conn)
          !this.connectSections('End',!secondary,!external,!conn)
        else
          !this.connectSections(!secondary,!external,!conn)
        endif
      endif
    enddo
  enddo
  prompt dismiss
  !!fmsys.setProgress(0)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      connectSections
--
-- Description: create connection between two sections
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Secondary section to be connected
--    2   R      DBREF       Primary section to be connected to
--    3   R      SECTIONCONNECTIONMANAGER
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectSections(!secondary is DBREF,!primary is DBREF,!conn is SECTIONCONNECTIONMANAGER)

  -- get connection end
  if !secondary.jois.badref().and(!secondary.joie.badref().not()) then
    !end = 'Start'
  elseif !secondary.joie.badref().and(!secondary.jois.badref().not()) then
    !end = 'End'
  else
    !end = ''
  endif

  -- connect sections
  !this.connectSections(!end,!secondary,!primary,!conn)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      make the detail connection
--
-- Description: connectSections
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      SECTIONCONNECTIONMANAGER
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectSections(!conn is SECTIONCONNECTIONMANAGER)

  -- get sections involved in connection
  !primary = !conn.primarySection
  !secondary = !conn.secondarySection
  !end = !conn.connectionEnd

  -- get type of secondary section
  -- secondary section can have only func set to X(main-primary) or Y(intermediate-secondary)
  if !secondary.func.match('X').eq(1) then
    !secType = 'PRIM'
  elseif !secondary.func.match('Y').eq(1) then
    !secType = 'SEC'
  else
    return
  endif

  -- get type of primary section
  if !primary.ohtype.eq('EXTFRM') then
    !primtype = 'EXTERNAL'
    !data = !this.attribute('JOINTONEXTERNAL' & !secType)
  elseif !primary.func.eq('PLOPEN') then
    !primtype = 'OPENING'
    !data = !this.attribute('JOINTONOPENING' & !secType)
  elseif !primary.func.match('X').eq(1) then
    !primtype = 'PRIM'
    !data = !this.jointOnPrimary
  else
    return
  endif

  -- return if no connection detail
  if !data.unset() then
    return
  endif

  -- make detail connection
  !joint = !secondary.attribute('joi' & !end)
  if !joint.badref() then
    return
  endif

  if !end.eq('Start') then
    !otherEnd = !secondary.pose.wrt(world)
  else
    !otherEnd = !secondary.poss.wrt(world)
  endif

  if !secType.eq('SEC').and(!primtype.eq('PRIM')) then
    do !c indices !data
      !posline[!c] = !data[!c].getAttribute('posli')
      handle ANY
      endhandle
    enddo
    if !posline.size().neq(2) then
      return
    endif
    !zdist = !joint.owner.owner.zdist
    var !plPos1  pplin $!posline[1] of $!<primary> dist $!<zdist> wrt world
    var !plPos2  pplin $!posline[2] of $!<primary> dist $!<zdist> wrt world
    !dist1 = !otherEnd.distance(!plPos1.position())
    !dist2 = !otherEnd.distance(!plPos2.position())
    if !dist1.lt(!dist2) then
      !indx = 1
    else
      !indx = 2
    endif
    !jointData = !data[!indx]
  else
    !jointData = !data
  endif

  !this.setJointData(!joint, !jointData)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      connectSections
--
-- Description: create connection between two sections
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      End of section to be connected (start/end)
--    2   R      DBREF       Secondary section to be connected
--    3   R      DBREF       Primary section to be connected to
--    4   R      SECTIONCONNECTIONMANAGER
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connectSections(!end is STRING,!secondary is DBREF,!primary is DBREF,!conn is SECTIONCONNECTIONMANAGER)

  -- exit if secondary section already connected
  if !secondary.jois.badref().not().and(!secondary.joie.badref().not()) then
    return
  endif

  -- connect sections
  !conn.connectSections(!end,!secondary,!primary)

  -- make up the detail connection
  !this.connectSections(!conn)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setJointData
--
-- Description: apply attribute data to joint
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setJointData(!joint is DBREF, !data is ANYDATASET)

  !posli = !data.getAttribute('posli')
  handle NONE
    !joint.owner.posli = !posli
  elsehandle ANY
  endhandle

  !xdir = !data.getAttribute('xdir')
  handle NONE
    !zdir = !joint.ori.zdir().wrt(world)
    !ori = object ORIENTATION('X is ' & !xdir & ' and Z is ' & !zdir)
    !joint.ori = !ori
  elsehandle ANY
  endhandle

  !data.copyAttributesTo(!joint)
  !!ce = !joint

  !rules = !data.getAttribute('rules')
  handle NONE
    do !c indices !rules[1]
      !attr = !rules[1][!c]
      !numb = !rules[2][!c]
      !stat = !rules[3][!c]
      !expr = !rules[4][!c]
      rule set $!<attr> $!<numb> $!<stat> $!<expr>
      handle ANY
      endhandle
    enddo
  elsehandle ANY
  endhandle

  !tmplJoint = !data.getAttribute('joint')
  handle NONE
    copy members of $!tmplJoint
  elsehandle ANY
  endhandle

  unlock all
  reconnect recalculate
  handle ANY
  endhandle

  rule rexe

endmethod
-- End of method

