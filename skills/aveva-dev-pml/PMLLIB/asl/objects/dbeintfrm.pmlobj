------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: modify object position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    new object position
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!pos is POSITION)

  -- init
  !oldPos = !this.position()
  !newPos = !pos.wrt(world)
  if !oldPos.eq(!newPos) then
    return
  endif

  !this.grid.position(!newPos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: return current object position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    POSITION    object position
--
------------------------------------------------------------------------

define method .position() is POSITION

  return !this.grid.position().wrt(world)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: move object in its z-direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        distance
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elevation(!dist is REAL)

  !dir = !this.orientation().zdir()
  !newPos = !this.position().offset(!dir,!dist)

  !this.position(!newPos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: return object orientation
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ORIENTATION object orientation
--
------------------------------------------------------------------------

define method .orientation() is ORIENTATION

  !ori = !this.grid.orientation().wrt(world)
  handle ANY
    !ori = object ORIENTATION()
  endhandle

  return !ori

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: modify object orientation
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      ORIENTATION  new object orientation
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .orientation(!newOri is ORIENTATION)

  -- init
  !oldOri = !this.orientation()

  if !oldOri.eq(!newOri.wrt(world)) then
    return
  endif

  !this.grid.orientation(!newOri.wrt(world))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteGensec
--
-- Description: disconnect and delete GENSEC and store refno in .removedGensec member
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       GENSEC to be deleted
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteGensec(!gensec is DBREF)

  !same = !!ce
  !!disconnectGensec(!gensec,'start')
  !!disconnectGensec(!gensec,'end')
  !this.removedGensecs.append(!gensec)
  !!ce = !gensec
  delete GENSEC
  !!ce = !same
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkLength
--
-- Description: check gensec length against minimum length
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       gensec to be checked
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if greater or equal to minimum
--
------------------------------------------------------------------------

define method .checkLength(!gensec is DBREF) is BOOLEAN

  -- init
  !minLeng = REAL()
  !gensecLeng = REAL()

  !status = !this.gensecStatus(!gensec)
  if !status.eq('PRIMARY').or(!status.eq('SECONDARY')).not() then
    return true
  endif

  -- NOTE: if any error occurs TRUE is returned (i.e. gensec passed through)
  !expr = !this.attribute(!status & 'MINLENG')
  if !expr.unset() then
    return false
  endif

  -- switch units to MM as we don't know in which units the result of expression is
  !savedUnits = object COMUNITS(true)
  UNITS MM DISTANCE
  !minLeng = !expr.evaluate(!gensec)
  handle ANY
  endhandle
  if(!minLeng.set()) then
    !minLeng = !!comConvertUnknownValue(!minLeng, 'mm')
  endif
  -- switch units back
  !savedUnits.restoreSavedUnitsByPtype('DIST')
  !gensecLeng = !gensec.leng
  handle ANY
  endhandle

  if !minLeng.unset().or(!gensecLeng.unset()) then
    return true
  endif

  !passed = !gensecLeng.geq(!minLeng)
  handle ANY
    return true
  endhandle

  return !passed

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      gensecStatus
--
-- Description: return gensec status (primary,secondary,etc...)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       gensec
--
-- Return:
--   [Data Type] [Description]
--    STRING      status of gensec (PRIMARY,SECONDARY,EXTERNAL,OPENING)
--
------------------------------------------------------------------------

define method .gensecStatus(!gensec is DBREF) is STRING

  !status = ''
  if !gensec.purp.neq(!this.purpose) then
    return !status
  endif

  if !gensec.func.part(1).eq('Y') then
    !status = 'SECONDARY'
  elseif !gensec.func.part(1).eq('X') then
    !status = 'PRIMARY'
  elseif !gensec.func.eq('PLOPEN') then
    !status = 'OPENING'
  elseif !gensec.ohtype.eq('EXTFRM') then
    !status = 'EXTERNAL'
  endif

  return !status

endmethod
-- End of method
