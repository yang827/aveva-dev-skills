--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidNumberLines)
  !!aidNumbers.hide(!this.aidNumberOuter)
  !!aidNumbers.hide(!this.aidAxes)
  return

endmethod
