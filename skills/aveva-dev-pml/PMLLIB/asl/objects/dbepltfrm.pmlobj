--
-- Description:     Container for PltFrm data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidNumbers(REAL,REAL)            -                   Set aid numbers
--  alignElev()                      -                   set elevation of platform members to zero (wrt platform)
--  build(ARRAY)                     -                   Build platform based on passed position array
--  build(ARRAY,ARRAY,ARRAY)         -                   Build platform based on passed vertices in usual format - array of type, position, data
--  checkOpenings(PROFILE,STRING)    ARRAY               check openings against the shape if they do not exceed it
--  createOpening()                  -                   build the openings
--  dbePltFrm()                      -
--  dbePltFrm(DBREF)                 BOOLEAN             Constructor
--  deleteOpening(REAL)              -                   delete opening
--  deleteVertex(REAL,REAL)          REAL                delete vertex
--  direction()                      DIRECTION           get primary direction platform
--  direction(DIRECTION)             DIRECTION           Set primary direction platform (normalised on plane)
--  draw()                           -
--  drawOpening(REAL)                -
--  getTemplates()                   ARRAY               get a list of assembly templates from current ASL settings
--  handrail()                       ARRAY               return handrails of platform as dbref array
--  height(REAL)                     -                   set object height and redraw object
--  innerHandrails()                 ARRAY               return handrails on inner opening edges of platform
--  innerHandrails(DBREF)            ARRAY               return handrails on inner opening edges of platform
--  insertVertex(REAL,REAL,POSITION) -                   insert new vertex
--  loadOpenings()                   -
--  modifyOpening(REAL)              -                   modify opening
--  moveEdge(REAL,REAL,DIRECTION,REAL) -                   move platform edge
--  moveVertex(REAL,REAL,POSITION)   -                   move vertex
--  openingShapes()                  ARRAY               return openings as PROFILE objects
--  orientation(ORIENTATION)         -                   Method to set object orientation
--  outerHandrail()                  ASLHANDRAIL         return handrail on outer edges of platform
--  outerHandrail(DBREF)             ASLHANDRAIL         return handrail on outer edges of platform
--  plane()                          PLANE               return PLANE using the object position and orientation
--  plateThickness(REAL)             -                   Set plate thickness of object
--  plateThickness(REAL,REAL)        -                   Set plate thickness of object
--  posType(STRING)                  -                   shift between TOS and FFL positioning datum
--  position(POSITION)               -
--  previewOpening()                 -                   draw shape of opening to be created
--  radius(REAL)                     REAL                return radius of platform/opening
--  radius(REAL,REAL)                -                   modify radius of circular platform (or opening
--  rpath(REAL)                      ASLRPATH            return rpath of passed id
--  rpath(REAL,ASLRPATH)             -                   populate rpath of passed id with passed rpath
--  shape()                          PROFILE             return shape of platform
--  shapeIsRectangle(PROFILE)        BOOLEAN             check if profile is rectangle
--  tagOpenings()                    -                   Tag openings with numbers
--  tidy()                           -                   Tidy up aid graphics
--  tidyOpening()                    -                   Tidy up aid graphics - opening
--  tmplReference(DBREF)             -                   Set template reference
--  transformPos(POSITION,ORIENTATION) POSITION            transform position from current coordinate system defined by object to one defined by new orientation
--  transformRpathPos(ASLRPATH,ORIENTATION) ASLRPATH            Transform rpath position
--  updateDb(BOOLEAN)                -                   create/modify platform
--  xyOpening(REAL,POSITION)         -                   move opening
--  xySize(REAL)                     XYPOSITION          returns XY size of platform/opening
--  xySize(REAL,REAL,REAL)           -                   set XY size of platform/opening
--

-- Define object
define object DBEPLTFRM

  -- public members
  ---------------------------------------------------------------------------
  -- DB Element referenced
  member .dbElement       is DBREF

  member .rpathRef        is DBREF

  -- Name
  member .name            is STRING

  -- Description
  member .description     is STRING

  -- number
  member .number          is REAL

  -- area
  member .area            is REAL

  -- platform height
  member .height                is REAL

  -- thickness of platform clad
  member .plateThickness        is REAL

  -- orientation
  member .orientation           is ORIENTATION

  -- position
  member .position              is POSITION

  -- link to the uses setting
  member .settingReference     is STRING

  -- reference to the central template for platforms
  member .tmplReference  is DBREF

  -- shape
  member .rpath                is ASLRPATH

  -- material reference
  member .matref                is DBREF

  -- openings
  member .openings              is ARRAY
  member .dbElementOpenings     is ARRAY
  member .openingsPos           is ARRAY

  -- temporary workspace for opening creation
  member .openingShape          is PROFILE

  member .posType is STRING

  member .intFrame is DBEINTFRM

  member .extFrame is DBEEXTFRM

  member .pltGrid is DBEPLTGRD

  -- private members
  ---------------------------------------------------------------------------

  -- Visualisation attributes
  -- Aid number
  member .aidAxes         is REAL
  member .aidNumber  is REAL
  member .aidColour  is REAL
  member .tagOrigin is BOOLEAN

endobject
-- End of object definition for ASLPltFrmData

------------------------------------------------------------------------
--
-- Method:      dbePltfrm
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dbePltFrm()

  -- initialise
  !this.orientation   = Y is N wrt /* and Z is U wrt /*
  !this.position      = E0 N0 U0 wrt /*
  !this.height        = 160mm
  !this.plateThickness = 0
  !this.name          = STRING()
  !this.description   = ''
  !this.area          = 0
  !this.number        = 0

  !this.openings      = ARRAY()
  !this.dbElementOpenings = ARRAY()
  !this.openingsPos      = ARRAY()
  !this.openingShape = object PROFILE()
  !this.openingShape.position = !this.position
  !this.openingShape.orientation = !this.orientation
  !this.rpath = object ASLRPATH()

  !this.posType = 'FFL'
  !tty = istty
  if !tty.not() then
  !this.aidColour = !!gphColOpt.aids().code
  endif

  !this.tagOrigin = true

  !this.intFrame = object DBEINTFRM()
  !this.extFrame = object DBEEXTFRM()
  !this.pltGrid = object DBEPLTGRD()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      dbePltFrm
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .dbePltFrm(!dbElement is DBREF) is BOOLEAN

   -- Load defaults
   !this.dbePltFrm()

   -- Verify type of the element passed
   if(!dbElement.fulltype.neq('PLTFRM'))then
     !!error.text    = 'Element ' & !dbElement.namn & ' is not a platform.'
      return false
   endif

  -- verify if under correct hierarchy
  if !dbElement.ahlis.find('APPLDA').set() then
    !error = !dbElement.namtyp & ' is the assembly template and cannot be modified this way!'
    return error 1 '$!<error>'
  endif

  -- Set db element
  !this.dbElement         = !dbElement

  -- Get attributes of the element
  if(!dbElement.isNamed) then
    !this.name        = !dbElement.name
  endif

  -- set assembly template ref.
  if !dbElement.asstmp.badref() then
    !this.tmplReference = nulref
  else
    !this.tmplReference = !dbElement.asstmp
  endif

  !this.description      = !dbElement.desc
  !this.number           = !dbElement.numb
  !this.area             = !dbElement.area
  !this.matref           = !dbElement.matref

  !this.height     = !dbElement.thickness

  !this.position      = !dbElement.position.wrt(world)

  -- Get orientation
  !this.orientation        = !this.dbElement.orientation.wrt(world)

  -- Boundary Line Information

  !this.rpathRef = !!dtbMemberOfType(!this.dbElement,'RPATH',1)
  if(!this.rpathRef.set()) then
    !this.rpath = object ASLRPATH(!this.rpathRef,'load')
    !this.rpath.close()
  endif

  if !this.rpath.unset() then
    return error 2 'Platform has no valid geometry'
  endif

  -- load openings
  !this.loadOpenings()
  !openingShapes = !this.openingShapes()
  !shape = !this.shape()

  -- load platform detail members
  -- internal frame
  !intFrame = !!dtbMemberOfType(!dbElement,'INTFRM',1)
  if !intFrame.set() then
    !this.intFrame = object DBEINTFRM(!intFrame)
  else
    !this.intFrame = object DBEINTFRM(!shape)
    !this.intFrame.grid.innerBoundaries(!openingShapes)
  endif

  -- external frame
  !extFrame = !!dtbMemberOfType(!dbElement,'EXTFRM',1)
  if !extFrame.set() then
    !this.extFrame = object DBEEXTFRM(!extFrame)
  else
    !this.extFrame = object DBEEXTFRM(!shape)
  endif

  -- plate grid
  !pltGrid = !!dtbMemberOfType(!dbElement,'PLTGRD',1)
  if !pltGrid.set() then
    !this.pltGrid = object DBEPLTGRD(!pltGrid)
  else
    !this.pltGrid = object DBEPLTGRD(!shape)
    !this.pltGrid.grid.innerBoundaries(!openingShapes)
  endif

  -- if opening frame specification reference not set take it over from external frame
  if !this.intFrame.sprefOpeningFrame.badref() then
    !this.intFrame.sprefOpeningFrame = !this.extFrame.spref
    !this.intFrame.justificationOpening = !this.extFrame.justification
  endif

  -- main platform members with sub-templates
  if !this.tmplReference.badref().not() then
    !extfrmTmpl = !!dtbMemberOfType(!this.tmplReference,'EXTFRM',1)
    !intfrmTmpl = !!dtbMemberOfType(!this.tmplReference,'INTFRM',1)
    !pltgrdTmpl = !!dtbMemberOfType(!this.tmplReference,'PLTGRD',1)
    if !this.intFrame.tmplReference.badref().and(!intfrmTmpl.set()) then
      !this.intFrame.tmplReference(!intfrmTmpl)
    endif
    if !this.extFrame.tmplReference.badref().and(!extfrmTmpl.set()) then
      !this.extFrame.tmplReference(!extfrmTmpl)
    endif
    if !this.pltGrid.tmplReference.badref().and(!pltgrdTmpl.set()) then
      !this.pltGrid.tmplReference(!pltgrdTmpl)
    endif
  endif

  -- get platform justification
  if defined(!dbElement.wdesp[1]) then
    !wdesp = !dbElement.wdesp[1]
    if !wdesp.eq('FFL').or(!wdesp.eq('TOS')) then
      !posType = !wdesp
    endif
  endif
  if undefined(!posType) then
    !posType = 'FFL'
    if !intFrame.set() then
      if !intFrame.pos.up.eq(0) then
        !posType = 'TOS'
      endif
    endif
  endif

  !plateThickness = !this.pltGrid.plateThickness
  -- make sure the elevation of objects is correct and populate them with justification and thickness
  !intZoffset = !this.intFrame.position().wrt(!dbElement).up * -1
  !pltZoffset = !this.pltGrid.position().wrt(!dbElement).up * -1
  if !posType.eq('FFL') then
    !this.extFrame.elevation(-!plateThickness)
    !this.intFrame.elevation(!intZoffset - !plateThickness)
    !this.pltGrid.elevation(!pltZoffset)
  elseif !posType.eq('TOS') then
    !this.intFrame.elevation(!intZoffset)
    !this.pltGrid.elevation(!pltZoffset  + !plateThickness)
  endif

  !this.posType = !posType
  !this.intFrame.posType = !posType
  !this.pltGrid.posType = !posType
  !this.plateThickness = !plateThickness
  !this.intFrame.platformThickness = !plateThickness

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      build
--
-- Description: Build platform based on passed position array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       vertex positions
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .build(!vertex is ARRAY)

  !type = ARRAY()
  !detail = ARRAY()
  do !c indices !vertex
    !type[!c] = 'POINTR'
    !detail[!c] = 0
  enddo

  !this.build(!type, !vertex, !detail)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      build
--
-- Description: Build platform based on passed vertices in usual format - array of type, position, data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     ARRAY       vertex types
--    2   RW     ARRAY       vertex positions
--    3   RW     ARRAY       vertex data
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .build(!type is ARRAY, !vertex is ARRAY, !detail is ARRAY)

  !this.openings.clear()
  !this.dbElementOpenings.clear()
  !this.openingsPos.clear()

  !path = object ASLRPATH(!vertex, !type, !detail)

  if !path.isClosed().not() then
    return error 1 'The shape is incorrect - platform cannot be built'
  endif

  !path.close()
  !this.rpath(0,!path)

  -- draw object
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tmplReference
--
-- Description: Set template reference
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       assembly template (PLTFRM)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmplReference(!tmpl is DBREF)

  !extfrm = !!dtbMemberOfType(!tmpl,'EXTFRM',1)
  !intfrm = !!dtbMemberOfType(!tmpl,'INTFRM',1)
  !pltgrd = !!dtbMemberOfType(!tmpl,'PLTGRD',1)

  !oldThickness = !this.plateThickness

  !this.tmplReference = !tmpl
  !this.extFrame.tmplReference(!extfrm)
  !this.intFrame.tmplReference(!intfrm)
  !this.pltGrid.tmplReference(!pltgrd)

  --!this.plateThickness(!this.pltGrid.plateThickness,!oldThickness)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plateThickness
--
-- Description: Set plate thickness of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        thickness
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plateThickness(!thickness is REAL, !oldThickness is REAL)

  -- init
  !diff = !thickness - !oldThickness

  --plate thickness
  !this.plateThickness = !thickness
  !this.pltGrid.plateThickness = !thickness
  !this.intFrame.platformThickness = !thickness
  if !this.pltGrid.posType.eq('FFL') then
    !this.intFrame.elevation(-!diff)
    !this.extFrame.elevation(-!diff)
  else
    !this.pltGrid.elevation(!diff)
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plateThickness
--
-- Description: Set plate thickness of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        thickness
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plateThickness(!thickness is REAL)

  -- init
  !oldThickness = !this.plateThickness
  !this.plateThickness(!thickness,!oldThickness)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createOpening()
--
-- Description: create opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        the percentage of the progress bar
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .createOpening()

  !openingProfile          = !this.openingShape

  !refe = !!ce
  !!ce = !this.dbElement

  PLFEAT 1
  handle ANY
    new PLFEAT
  endhandle

  if !!ce.mcount.gt(0) then
    !!ce = !!ce.memb.last()
  endif

  new PLOPEN
  !!ce.position = !this.openingShape.position
  !!ce.orientation = !this.openingShape.orientation
  NEW RPATH
  !openingProfile.dbWrite(!!ce)

  -- update object
  !this.loadOpenings()
  !shape = !this.shape()
  !openings = !this.openingShapes()

  if !this.intFrame.detailPresent() then
    !this.intFrame.grid = object RECTANGULARGRID(!this.intFrame.dbElement)
    !this.intFrame.grid.innerBoundaries(!openings)
    !this.intFrame.updateDb()
  endif

  if !this.pltGrid.detailPresent() then
    !this.pltGrid.grid = object RECTANGULARGRID(!this.pltGrid.dbElement)
    !this.pltGrid.grid.innerBoundaries(!openings)
    !this.pltGrid.updateDb()
  endif

  !!ce = !refe

endmethod
------------------------------------------------------------------------
--
-- Method:      modifyOpening()
--
-- Description: modify opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        opening number
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .modifyOpening(!number is REAL)

  -- init variables
  !shape = !this.shape()
  !openings = !this.openingShapes()

  -- check opening
  if !shape.isWithin(!openings[!number]).not() then
    return error 1 'Opening exceeds the platform boundary'
  endif
  !matchingOpenings = !this.checkOpenings(!openings[!number],'opening')
  if defined(!matchingOpenings[!number]) then
    !matchingOpenings[!number].delete()
  endif
  if !matchingOpenings.set() then
    return error 1 'Opening overlaps another opening(s)'
  endif

  !dbElement = !this.dbElementOpenings[!number]

  !dbElement.position = !this.openingsPos[!number]
  !path = !!dtbMemberOfType(!dbElement,'RPATH',1)
  !this.openings[!number].dbWrite(!path)

  -- update object
  !shape = !this.shape()
  !openings = !this.openingShapes()

  if !this.intFrame.detailPresent() then
    !this.intFrame.grid = object RECTANGULARGRID(!this.intFrame.dbElement)
    !this.intFrame.grid.innerBoundaries(!openings)
    !this.intFrame.updateDb()
  endif

  if !this.pltGrid.detailPresent() then
    !this.pltGrid.grid = object RECTANGULARGRID(!this.pltGrid.dbElement)
    !this.pltGrid.grid.innerBoundaries(!openings)
    !this.pltGrid.updateDb()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      deleteOpening
--
-- Description: delete opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        opening number
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteOpening(!number is REAL)

  !!ce = !this.dbElementOpenings[!number]
  delete PLOPEN
  if !!ce.memb.unset() then
    delete PLFEAT
  endif

  -- update object
  !this.loadOpenings()
  !shape = !this.shape()
  !openings = !this.openingShapes()

  if !this.intFrame.detailPresent() then
    !this.intFrame.grid = object RECTANGULARGRID(!this.intFrame.dbElement)
    !this.intFrame.grid.innerBoundaries(!openings)
    !this.intFrame.updateDb()
  endif

  if !this.pltGrid.detailPresent() then
    !this.pltGrid.grid = object RECTANGULARGRID(!this.pltGrid.dbElement)
    !this.pltGrid.grid.innerBoundaries(!openings)
    !this.pltGrid.updateDb()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      Draw
--
-- Description: Standard draw mechanism for object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .draw()

  -- Don't draw if there is no aid number
  if(!this.aidNumber.unset())then
    return
  endif

  if !this.rpath.isClosed().not() then
    return
  endif

  -- Remove current graphics
  !this.tidy()

  -- Draw the outer boundary

  !shapeToDraw = !this.rpath.profile(true)
  !dir = !shapeToDraw.orientation.zdir().opposite()
  if !this.posType.eq('TOS') then
    !shapeToDraw.position = !shapeToDraw.position.offset(!dir.opposite(),!this.plateThickness)
  endif

  !shapePos = !shapeToDraw.position
  !heig = !this.height + !this.plateThickness
  !shapeToDraw.draw(!this.aidNumber,1,!this.aidColour)

  !corners = !this.rpath.vertex
  do !c indices !corners
    skip if !this.rpath.type[!c].eq('POINTR')
    !corners[!c].delete()
  enddo
  do !vertex values !corners
    if !this.posType.eq('TOS') then
      !vertex = !vertex.offset(!dir.opposite(),!this.plateThickness)
    endif
    !vertex.line(!vertex.offset(!dir,!heig)).draw(!this.aidNumber,1,!this.aidColour)
  enddo

  !shapeToDraw.position = !shapePos.offset(!dir, !heig)
  !shapeToDraw.draw(!this.aidNumber,1,!this.aidColour)

  -- openings
  !openings = !this.openingShapes()
  do !c indices !openings
    !hole = !openings[!c]
    if !this.posType.eq('TOS') then
      !hole.position = !hole.position.offset(!dir.opposite(),!this.plateThickness)
    endif
    !corners = !this.openings[!c].vertex
    !hole.draw(!this.aidNumber,1,!this.aidColour)
    !hole.position = !hole.position.offset(!dir,!heig)
    !hole.draw(!this.aidNumber,1,!this.aidColour)
    do !cc indices !corners
      skip if !this.openings[!c].type[!cc].eq('POINTR')
      !corners[!cc].delete()
    enddo
    do !vertex values !corners
      if !this.posType.eq('TOS') then
        !vertex = !vertex.offset(!dir.opposite(),!this.plateThickness)
      endif
      !vertex.line(!vertex.offset(!dir,!heig)).draw(!this.aidNumber,1,!this.aidColour)
    enddo
  enddo

  -- Tag origin
  if !this.tagOrigin then
    if(!this.name.unset()) then
      !name = 'Platform'
    else
      !name = !this.name
    endif

    !point = !this.position
    !direction      = !this.orientation.yDir().wrt(World)

    !!drawAidText(!direction.string(),!point,!this.aidNumber)
    !!drawArrow(!direction,!point,!this.aidNumber,1000mm)
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      DrawOpening
--
-- Description: Standard draw mechanism for object, opening
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        opening sequence number
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .drawOpening(!id is REAL)

  -- exit if aid number unset
  if !this.aidNumber.unset() then
    return
  endif

  -- draw platform
  !this.draw()

  -- mark selected opening
  !name = 'Opening'
  !opening = !this.openingShapes()[!id]
  !dir = !opening.orientation.zdir()
  !dist = 0
  if !this.posType.eq('TOS') then
    !dist = !this.plateThickness
  endif
  !opening.position = !opening.position.offset(!dir,!dist)
  !point = !opening.position.wrt(!this.dbElement).offset(!dir,!dist)
  !!drawAidText(!name,!point,!this.aidNumber)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      previewOpening
--
-- Description: draw shape of opening to be created
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .previewOpening()

  -- exit if aid number unset
  if !this.aidNumber.unset() then
    return
  endif

  -- Remove current graphics
  !this.tidyOpening()

  --Draw opening
  !opening = !this.openingShape
  !dir = !opening.orientation.zdir()
  !dist = 0
  if !this.posType.eq('TOS') then
    !dist = !this.plateThickness
  endif
  !opening.position = !opening.position.offset(!dir,!dist)

  if !opening.edges().set() then
    !opening.draw(!this.aidNumber,1,!this.aidColour)
  endif

  !name = 'New Opening'

  !point = !opening.position.wrt(!this.dbElement).offset(!dir,!dist)
  !!drawAidText(!name,!point,!this.aidNumber)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tagOpenings
--
-- Description: Tag openings with numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .tagOpenings()

  !openings = !this.dbElementOpenings

  do !i index !openings

    !number = !i.string()
    !point = !openings[!i].position.wrt(!this.dbElement)

    AID TEXT NUMBER $!<this.aidNumber> '$!number' AT $!point

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Method to set object orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      ORIENTATION   New orientation
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .orientation(!newOri is ORIENTATION)

  -- first check if orientations differ
  if !this.orientation.eq(!newOri) then
    return
  endif

  -- then check rpath if isn't unset
  if !this.rpath.size().eq(0) then
    !this.orientation = !newOri
    return
  endif

  -- transform platform rpath
  !this.rpath = !this.transformRpathPos(!this.rpath,!newOri)

  -- transform opening rpaths
  do !c indices !this.openings
    !this.openings[!c] = !this.transformRpathPos(!this.openings[!c],!newOri)
    !this.openingsPos[!c] = !this.transformPos(!this.openingsPos[!c],!newOri)
  enddo

  -- set orientation of detail members
  !this.intFrame.orientation(!newOri)
  !this.extFrame.orientation(!newOri)
  !this.pltGrid.orientation(!newOri)

  -- set object orientation
  !this.orientation = !newOri

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      transformRpathPos
--
-- Description: Transform rpath position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASLRPATH    rpath to be transformed
--
-- Return:
--   [Data Type] [Description]
--    ASLRPATH    transformed rpath
--
------------------------------------------------------------------------

define method .transformRpathPos(!rpath is ASLRPATH,!newOri is ORIENTATION) is ASLRPATH

  -- init
  !result = !rpath

  -- transform positions
  do !c indices !result.vertex
    -- transform vertex position
    !curpos = !result.vertex[!c]
    !result.vertex[!c] = !this.transformPos(!curpos,!newOri)
    -- there are also some positions within detail array when point is CURVE so transform them too
    if !result.type[!c].eq('CURVE') then
      do !cc indices !result.detail[!c]
        if !result.detail[!c][!cc].objectType().eq('POSITION') then
          !curpos = !result.detail[!c][!cc]
          !result.detail[!c][!cc] = !this.transformPos(!curpos,!newOri)
        endif
      enddo
    endif
  enddo

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     direction
--
-- Description: Set primary direction platform (normalised on plane)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   new direction to be set
--
-- Return:
--   [Data Type] [Description]
--    DIRECTION   Direction projected onto platform plane
--
------------------------------------------------------------------------

define method .direction(!yDir is DIRECTION) is DIRECTION

  -- Initialise Variables
  !oldDir = !this.direction().wrt(world)
  !newDir = !yDir.projected(!this.plane())
  handle ANY
    return error 1 'Invalid direction has been specified'
  endhandle

  -- exit if new and old direction are the same
  if !oldDir.eq(!newDir) then
    return !oldDir
  endif

  -- Set new orientation
  !ori  = object ORIENTATION('Y is ' & !newDir)
  !this.orientation(!ori)

  -- Redraw
  !this.draw()

  return !newDir

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: get primary direction platform
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DIRECTION   direction returned
--
------------------------------------------------------------------------

define method .direction() is DIRECTION

  return !this.orientation.yDir()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      height
--
-- Description: set object height and redraw object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        platform height
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .height(!height is REAL)

  if !height.eq(0) then
    return error 1 'Platform Thickness must not be zero!'
  elseif !height.lt(0) then
    return error 2 'Platform Thickness must not be negative value!'
  endif

  !this.height = !height

  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aidNumbers
--
-- Description: Set aid numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .aidNumbers(!aidAxes is REAL, !aidNumber is REAL)

  -- Set Aid number
  !this.aidAxes         = !aidAxes
  !this.aidNumber  = !aidNumber

endmethod
-- End of method
------------------------------------------------------------------------------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method
------------------------------------------------------------------------------------------------------------------------------------------------
--
-- Method:      tidyOpening
--
-- Description: Tidy up aid graphics - opening
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .tidyOpening()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      Position
--
-- Description: Set position of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .position(!newpos is POSITION)

  -- if position is not set then set it
  if !this.position.unset() then
    !this.position        = !newpos
  endif

  -- exit if old and new position are the same
  if !this.position.wrt(world).eq(!newpos.wrt(world)) then
    return
  endif


  -- we need to move platform members
    -- get distance and direction of move
    !dist = !this.position.distance(!newpos)
    !dir  = !this.position.direction(!newpos)

  -- Set position
  !this.position        = !newpos.wrt(world)

  if !this.rpath.isClosed() then
    -- move rpath
    !this.rpath = !this.rpath.offset(!dir,!dist)
    -- move all openings
    do !c indices !this.openings
      -- move opening rpath
      !this.openings[!c] = !this.openings[!c].offset(!dir,!dist)
      -- move opening pos
      !this.openingsPos[!c] = !this.openingsPos[!c].offset(!dir,!dist)
    enddo
  endif

  -- move detail members
  !intPos = !this.intFrame.position().offset(!dir,!dist)
  !extPos = !this.extFrame.position().offset(!dir,!dist)
  !pltPos = !this.pltGrid.position().offset(!dir,!dist)
  !this.intFrame.position(!intPos)
  !this.extFrame.position(!extPos)
  !this.pltGrid.position(!pltPos)

  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description: return PLANE using the object position and orientation
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    PLANE       platform object plane
--
------------------------------------------------------------------------

define method .plane() is PLANE

  !result = object PLANE(!this.position,!this.orientation)

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      shape
--
-- Description: return shape of platform
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    PROFILE     platform shape
--
------------------------------------------------------------------------

define method .shape() is PROFILE

  if !this.rpath.isClosed() then
    !shape = !this.rpath.profile(true, !this.position.wrt(worl), !this.orientation.wrt(worl))
  else
    !shape =object PROFILE()
    !shape.position = !this.position
    !shape.orientation = !this.orientation
  endif

  return !shape

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      posType
--
-- Description: shift between TOS and FFL positioning datum
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .posType(!datum is STRING)

  -- init
  !thickness = !this.plateThickness

  -- set justification
  !this.posType = !datum

  !this.alignElev()
  -- move members
  if !datum.eq('FFL') then
    !this.extFrame.elevation(-!thickness)
    !this.intFrame.elevation(-!thickness)
  else
    !this.pltGrid.elevation(!thickness)
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadopenings
--
-- Description: Get and store platform openings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .loadOpenings()

  -- init
  !rpath = ARRAY()
  !ref  = ARRAY()
  !pos  = ARRAY()

  -- collect all PLOPEN for platform
  !openings = !!collectAllFor('PLOPEN','',!this.dbElement)
  -- process them
  do !plopen values !openings
    !tmpRpath = object ASLRPATH(!plopen,'load')
    handle ANY
      skip
    endhandle
    skip if !tmpRpath.isClosed().not()
    !rpath.append(!tmpRpath)
    !ref.append(!plopen)
    !pos.append(!plopen.pos)
  enddo

  -- store data at object
  !this.openings = !rpath
  !this.openingsPos = !pos
  !this.dbElementOpenings = !ref

endmethod

------------------------------------------------------------------------
--
-- Method:      updateDb
--
-- Description: create/modify platform
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     indicates if object geometry to be updated or not
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateDb(!updateGeom is BOOLEAN)

  -- init
  !new = !this.dbElement.badref()

  --  platform
  if !this.dbElement.badref() then
    if !this.dbElement.unset() then
      new PLTFRM
    else
      new PLTFRM ref $!<this.dbElement>
    endif
    !this.dbElement = !!ce
  else
    !!ce = !this.dbElement
  endif

  -- platform attributes
  if !this.name.set() then
    !this.dbElement.name      = !this.name
    handle ANY
    endhandle
  else
    UNNAME
  endif
  !!ce.description    = !this.description
  !!ce.numb       = !this.number
  !!ce.area       = !this.area
  !!ce.thickness   = !this.height
  !!ce.position    = !this.position
  !!ce.orientation = !this.orientation
  asstmp $!<this.tmplReference>
  desp $!this.posType
  matref $!<this.matref>

  -- boundary
  !this.rpathRef = !this.rpath.dbWrite(!this.rpathRef)

  -- openings
  do !c indices !this.openings
    !!ce = !this.dbElementOpenings[!c]
    !rpathRef = !!dtbMemberOfType(!!ce,'RPATH',1)
    !this.openings[!c].dbWrite(!rpathRef)
  enddo

  -- set int/ext/plateGrid objects when platform has been newly created
  if !new then
    !this.pltGrid.grid.outerBoundary(!this.shape())
    !this.intFrame.grid.outerBoundary(!this.shape())
    !this.extFrame.boundary(!this.shape())
  endif

  if !updateGeom then
    if !this.extFrame.spref.badref().or(!this.intFrame.sprefPrimary.badref()).or(!this.intFrame.sprefPrimary.badref()).not() then
      !this.extFrame.updateDb()
      !this.intFrame.updateDb()
      !this.pltGrid.updateDb()
    endif
    !handrails = !this.handrail()
    do !handraRef values !handrails
      !handra = object ASLHANDRAIL(!handraRef)
      handle ANY
        skip
      endhandle
      !handra.autoUpdateDb = true
      !handra.updateGeometry()
      handle ANY
      endhandle
    enddo
  else

    if !this.intFrame.dbElement.badref().not() then
      !!ce = !this.intFrame.dbElement
      !!ce.pos = !this.intFrame.position()
      !!ce.ori = !this.intFrame.orientation()
    endif

    if !this.extFrame.gensec.set() then
      !up = !this.extFrame.position().wrt(!this.dbElement).up
      do !gensec values !this.extFrame.gensec
        skip if !gensec.badref()
        !pos = !gensec.pos.wrt(!this.dbElement)
        !pos.up = !up
        !gensec.pos = !pos
      enddo
    endif

    if !this.pltGrid.dbElement.badref().not() then
      !!ce = !this.pltGrid.dbElement
      !!ce.pos = !this.pltGrid.position()
      !!ce.ori = !this.pltGrid.orientation()
    endif
  endif

  !!ce = !this.dbElement

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xyOpening
--
-- Description: move opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Opening id (sequence number or unset for new opening)
--    1   R      POSITION    New position where opening to be moved to
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .xyOpening(!id is REAL,!newpos is POSITION)

  !east = !newpos.wrt(!this.dbElement).east
  !north = !newpos.wrt(!this.dbElement).north

  if !id.unset() then
    !pos = !this.openingShape.position.wrt(!this.dbElement)
    !pos.east = !east
    !pos.north = !north
    !opening = !this.openingShape
    !opening.position = !pos.wrt(world)
  else
    !pos = !this.openingsPos[!id].wrt(!this.dbElement)
    !oldpos = !pos
    !pos.east = !east
    !pos.north = !north
    !openingPos = !pos.wrt(world)
    !opening = !this.openingShapes()[!id]
    !opening.position = !openingPos
  endif

  -- check shape
  !boundary = !this.rpath.profile(true)
  if !opening.edges().set() then
    if !boundary.isWithin(!opening).not() then
      return error 1 'Opening exceeds the platform boundary'
    endif
    !matchingOpenings = !this.checkOpenings(!opening,'opening')
    !matchingOpenings[!id].delete()
    handle ANY
    endhandle
    if !matchingOpenings.set() then
      return error 1 'Opening overlaps another opening(s)'
    endif
  else
    if !boundary.isWithout(!opening.position) then
      return error 1 'Opening origin is outside the platform boundary'
    endif
  endif

  if !id.unset() then
    !this.openingShape = !opening
    -- draw opening
    !this.previewOpening()
  else
    !this.openingsPos[!id] = !openingPos
    -- update rpath
    !dir = !oldpos.direction(!pos)
    !dist = !oldpos.distance(!pos)
    !path = !this.openings[!id].offset(!dir,!dist)
    !this.rpath(!id,!path)

    -- draw opening
    !this.drawOpening(!id)
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      outerHandrail
--
-- Description: return handrail on outer edges of platform
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        Handrail template
--
-- Return:
--   [Data Type]   [Description]
--    ASLHANDRAIL   Handrail object
--
------------------------------------------------------------------------

define method .outerHandrail(!tmplRef is DBREF) is ASLHANDRAIL

  -- init
  !handrail = object ASLHANDRAIL(!!aslCentralData.currSetting.description)

  if !this.shape().edges().unset() then
    return !handrail
  endif

  !handrail.tmplReference(!tmplRef)
  !handrail.closeFlag = true
  !rpath = !!dtbMemberOfType(!this.dbElement,'RPATH',1)
  !handrail.loadPoints(!rpath.memb)

  return !handrail

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      outerHandrail
--
-- Description: return handrail on outer edges of platform
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]   [Description]
--    ASLHANDRAIL   Handrail object
--
------------------------------------------------------------------------

define method .outerHandrail() is ASLHANDRAIL

  -- init
  !handrail = object ASLHANDRAIL(!!aslCentralData.currSetting.description)
  !tmplRef = !handrail.getTemplates().first()

  return !this.outerHandrail(!tmplRef)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      innerHandrails
--
-- Description: return handrails on inner opening edges of platform
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       handrail objects
--
------------------------------------------------------------------------

define method .innerHandrails() is ARRAY

  -- init
  !tmpHandrail = object ASLHANDRAIL(!!aslCentralData.currSetting.description)
  !tmplRef = !tmpHandrail.getTemplates().first()

  return !this.innerHandrails(!tmplRef)

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      innerHandrails
--
-- Description: return handrails on inner opening edges of platform
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Handrail template reference
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       handrail objects
--
------------------------------------------------------------------------

define method .innerHandrails(!tmplRef is DBREF) is ARRAY

  -- init
  !handrails = ARRAY()
  !tmpHandrail = object ASLHANDRAIL(!!aslCentralData.currSetting.description)
  !tmpHandrail.tmplReference(!tmplRef)
  !tmpHandrail.closeFlag = true
  do !hole values !this.dbElementOpenings
    !handrail = !tmpHandrail
    !rpath = !!dtbMemberOfType(!hole,'RPATH',1)
    !handrail.loadPoints(!rpath.memb)
    !handrails.append(!handrail)
  enddo

  return !handrails

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      transformPos
--
-- Description: transform position from current coordinate system defined by object to one defined by new orientation
--
-- Method Type: function
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      POSITION      current position
--    2   R      ORIENTATION   new orientation
--
-- Return:
--   [Data Type]  [Description]
--    POSITION     transformed position
--
------------------------------------------------------------------------

define method .transformPos(!pos is POSITION,!ori is ORIENTATION) is POSITION

  -- init
  !newpos = object POSITION()

  -- define planes
  -- plane with current orientation
  !curplane = !this.plane()

  -- plane with the new orientation
  !oriplane = object PLANE(!this.position,!ori)

  -- map vertex onto current plane
  !xy = !curplane.xyOffset(!pos)
  !z = !pos.distance(!curplane)
  -- if position does not lay on a plane then check whether it is above or below plane
  if !z.boolean() then
    if !curplane.position.direction(!pos).angle(!curplane.direction()).gt(90) then
    -- position is below plane so it is the negative
      !z = !z * -1
    endif
  endif

  !newpos = !oriplane.threeDPosition(!xy)
  !newpos = !newpos.offset(!oriplane.direction(),!z)

  return !newpos

endmethod
-- end of method

------------------------------------------------------------------------
--
-- Method:      insertVertex
--
-- Description: insert new vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Rpath id (0 - platform boundary, 1,2,3... opening boundary)
--    2   R      REAL        index of vertex to be inserted after
--    3   RW     POSITION    new vertex position
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insertVertex(!pathId is REAL,!index is REAL,!newpos is POSITION)

  -- copy rpath
  if !pathId.eq(0) then
    !tmpRpath = !this.rpath
    !entity = 'platform'
  else
    !tmpRpath = !this.openings[!pathId]
    !entity = 'opening'
  endif

  -- project position onto plane
  !newpos = !tmpRpath.profile(true).plane().near(!newpos)

  -- check if position isn't already there
  if !!findNearestPos(!tmpRpath.vertex,!newpos.wrt(world), 1mm).set() then
    return error 1 'There is a vertex already at the same position'
  endif

  -- check if the shape is correct after vertex insertion
  !tmpRpath.insertVertex('POINTR',!index,!newpos.wrt(world),0,nulref)
  if !tmpRpath.isClosed().not() then
    return error 2 'The inserted vertex does not make a correct shape of $!<entity>'
  endif

  -- check openings if they do not exceed
  if !pathId.eq(0) then
    if !this.checkOpenings(!tmpRpath.profile(true),'boundary').set() then
      !error = 'The vertex cannot be inserted as at least one opening exceeds the platform boundary'
    endif
  else
    !boundary = !this.rpath.profile(true)
    if !boundary.isWithin(!tmpRpath.profile(true)).not() then
      !error = 'The vertex cannot be inserted as the opening exceeds the platform boundary'
    endif
    !matchingOpenings = !this.checkOpenings(!tmpRpath.profile(true),'opening')
    !matchingOpenings[!pathId].delete()
    handle ANY
    endhandle
    if !matchingOpenings.set() then
      !error = 'The vertex cannot be inserted as the opening overlaps another opening(s)'
    endif
  endif

  if defined(!error) then
    return error 3 '$!<error>'
  endif

  -- store modified rpath
  !this.rpath(!pathId,!tmpRpath)

  -- draw object
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      moveVertex
--
-- Description: move vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Rpath id (0 - platform boundary, 1,2,3... opening boundary)
--    2   R      REAL        vertex index
--    3   RW     POSITION    vertex new position
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveVertex(!pathId is REAL,!index is REAL,!newpos is POSITION)

  -- copy rpath
  if !pathId.eq(0) then
    !tmpRpath = !this.rpath
    !entity = 'platform'
  else
    !tmpRpath = !this.openings[!pathId]
    !entity = 'opening'
  endif

  -- project position onto plane
  !newpos = !tmpRpath.profile(true).plane().near(!newpos)

  -- check if position isn't already there
  if !!findNearestPos(!tmpRpath.vertex,!newpos.wrt(world), 1mm).set() then
    return error 1 'There is a vertex already at the same position'
  endif

  -- check if the shape is correct after vertex move
  !tmpRpath.vertex[!index] = !newpos.wrt(world)
  if !index.eq(1) then
  -- move last vertex too
    !tmpRpath.vertex[!tmpRpath.vertex.maxIndex()] = !newpos.wrt(world)
  elseif !index.eq(!tmpRpath.vertex.maxIndex()) then
  -- move first vertex
    !tmpRpath.vertex[1] = !newpos.wrt(world)
  endif

  if !tmpRpath.isClosed().not() then
    return error 2 'The moved vertex does not make a correct shape of $!<entity>'
  endif

  -- check openings if they do not exceed
  if !pathId.eq(0) then
    if !this.checkOpenings(!tmpRpath.profile(true),'boundary').set() then
      !error = 'The vertex cannot be moved as at least one opening exceeds the platform boundary'
    endif
  else
    !boundary = !this.rpath.profile(true)
    if !boundary.isWithin(!tmpRpath.profile(true)).not() then
      !error = 'The vertex cannot be moved as the opening exceeds the platform boundary'
    endif
    !matchingOpenings = !this.checkOpenings(!tmpRpath.profile(true),'opening')
    !matchingOpenings[!pathId].delete()
    handle ANY
    endhandle
    if !matchingOpenings.set() then
      !error = 'The vertex cannot be moved as the opening overlaps another opening(s)'
    endif
  endif

  if defined(!error) then
    return error 3 '$!<error>'
  endif

  -- store modified rpath
  !this.rpath(!pathId,!tmpRpath)

  -- draw object
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      radius
--
-- Description: modify radius of circular platform (or opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        radius
--    2   R      REAL        path id (id=0 for platform, id>0 for openings)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .radius(!radius is REAL, !pathId is REAL)

  -- get shape and path
  if !pathId.eq(0) then
    !shape = !this.shape()
    !path = !this.rpath
  else
    !shape = !this.openingShapes()[!pathId]
    !path = !this.openings[!pathId]
  endif

  -- check if shape is a circle
  if !shape.isCircle().not() then
    return
  endif

  -- check radius
  if !radius.leq(0) then
    return error 1 'Radius must be a positive value'
  endif

  -- extract circle and modify radius
  !edges = !shape.edges()
  !edges[1].radius = !radius
  !shape.profile(!shape.position,!shape.orientation,!edges)

  -- modify path
  !newPath = object ASLRPATH(!shape)
  !path.vertex = !newPath.vertex

  -- apply modified rpath
  !this.rpath(!pathId,!path)

  -- draw object
  if !pathId.eq(0) then
    !this.draw()
  else
    !this.drawOpening(!pathId)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      radius
--
-- Description: return radius of platform/opening
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        path id (0 for platform, >0 fo openings)
--
-- Return:
--   [Data Type] [Description]
--    REAL        returned radius
--
------------------------------------------------------------------------

define method .radius(!pathId is REAL) is REAL

  -- get shape
  if !pathId.eq(0) then
    !shape = !this.shape()
  else
    !shape = !this.openingShapes()[!pathId]
  endif

  -- check if shape is a circle
  if !shape.isCircle().not() then
    return REAL()
  endif

  -- extract circle and radius
  !circle = !shape.edges()[1]
  !radius = !circle.radius

  return !radius

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xySize
--
-- Description: returns XY size of platform/opening
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        path id (0 for platform, >0 fo openings)
--
-- Return:
--   [Data Type] [Description]
--    XYPOSITION  XY size
--
------------------------------------------------------------------------

define method .xySize(!pathId is REAL) is XYPOSITION

  -- init variables
  !xy = object XYPOSITION()

  -- get shape
  if !pathId.eq(0) then
    !shape = !this.shape()
  else
    !shape = !this.openingShapes()[!pathId]
  endif

  -- check if shape is rectangle
  if !this.shapeIsRectangle(!shape) then
    !edges = !shape.edges()
    !xy.x = !edges[1].length()
    !xy.y = !edges[2].length()
  endif

  return !xy

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      xySize
--
-- Description: set XY size of platform/opening
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        X size
--    2   R      REAL        Y size
--    3   R      REAL        path id
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .xySize(!xsize is REAL, !ysize is REAL,!pathId is REAL)

  -- get shape
  if !pathId.eq(0) then
    !shape = !this.shape()
    !path = !this.rpath
  else
    !shape = !this.openingShapes()[!pathId]
    !path = !this.openings[!pathId]
  endif

  -- check if shape is rectangle
  if !this.shapeIsRectangle(!shape).not() then
    return
  endif

  -- check passed sizes
  if !xsize.leq(0) then
    return error 1 'Xlength must be a positive value'
  elseif !ysize.leq(0) then
    return error 2 'Ylength must be a positive value'
  endif

  !edges = !shape.edges()
  !xtension = !xsize - !edges[1].length()
  !ytension = !ysize - !edges[2].length()
  !xDir = !edges[1].direction()
  !yDir = !edges[2].direction()

  if !shape.position.near(!edges[1].startposition,1mm) then
    !edges[1] = !edges[1].extendEnd(!xtension)
  elseif !shape.position.near(!edges[2].startposition,1mm) then
    !edges[1] = !edges[1].extendStart(!xtension)
  elseif !shape.position.near(!edges[3].startposition,1mm) then
    !edges[1] = !edges[1].extendStart(!xtension).offset(!yDir,-!ytension)
  elseif !shape.position.near(!edges[4].startposition,1mm) then
    !edges[1] = !edges[1].extendEnd(!xtension).offset(!yDir,-!ytension)
  else
    !halfXtension = !xtension / 2
    !halfYtension = !ytension / 2
    !edges[1] = !edges[1].extendStart(!halfXtension).extendEnd(!halfXtension).offset(!yDir,-!halfYtension)
  endif

  -- do the rest
  !endPos = !edges[1].endposition
  !edges[2] = object LINE(!endPos,!endPos.offset(!yDir,!ysize))
  !endPos = !edges[2].endposition
  !edges[3] = object LINE(!endPos,!endPos.offset(!xDir, -!xsize))
  !edges[4] = object LINE(!edges[3].endposition,!edges[1].startposition)

  -- apply edges to shape
  !shape.profile(!shape.position,!shape.orientation,!edges)

  -- check shape
  if !pathId.eq(0) then
    if !this.checkOpenings(!shape,'boundary').set() then
      !error = 'At least one opening exceeds the platform boundary'
    endif
  else
    if !this.shape().isWithin(!shape).not() then
      !error = 'Opening exceeds the platform boundary'
    endif
    !matchingOpenings = !this.checkOpenings(!shape,'opening')
    if defined(!matchingOpenings[!pathId]) then
      !matchingOpenings[!pathId].delete()
    endif
    if !matchingOpenings.set() then
      !error = 'Opening overlaps another opening(s)'
    endif
  endif

  -- exit in case of error
  if defined(!error) then
    return error 3 '$!<error>'
  endif

  -- apply shape to path
  !newPath = object ASLRPATH(!shape)
  !newPath.close()
  !path.vertex = !newPath.vertex

  -- apply modified rpath
  !this.rpath(!pathId,!path)

  -- draw object
  if !pathId.eq(0) then
    !this.draw()
  else
    !this.drawOpening(!pathId)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      shapeIsRectangle
--
-- Description: check if profile is rectangle
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     profile to checked
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .shapeIsRectangle(!shape is PROFILE) is BOOLEAN

  -- check shape
  !edges = !shape.edges()

  if !shape.isValidClosed().not() then
    return false
  endif

  if !edges.size().neq(4) then
    return false
  endif

  if !edges.evaluate(object BLOCK('!edges[!evalindex].objectType()'))[1].neq('LINE') then
    return false
  endif

  if !edges[1].length().eq(!edges[3].length()).and(!edges[2].length().eq(!edges[4].length())).not() then
    return false
  endif

  if !edges[1].direction().angle(!edges[2].direction()).between(89.5,90.5).not() then
    return false
  endif

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteVertex
--
-- Description: delete vertex
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Rpath id (0 - platform boundary, 1,2,3... opening boundary)
--    2   R      REAL        index of vertex to be deleted
--
-- Return:
--   [Data Type] [Description]
--    REAL        new index
--
------------------------------------------------------------------------

define method .deleteVertex(!pathId is REAL,!index is REAL) is REAL

  -- copy rpath
  if !pathId.eq(0) then
    !tmpRpath = !this.rpath
    !entity = 'platform'
  else
    !tmpRpath = !this.openings[!pathId]
    !entity = 'opening'
  endif

  -- check if the shape is correct after vertex deletion
  !tmpRpath.removeVertex(!index)
  if !index.eq(1) then
  -- remove last vertex too
    !tmpRpath.removeVertex(!tmpRpath.vertex.maxIndex())
  elseif !index.eq(!tmpRpath.vertex.maxIndex()) then
  -- remove first vertex too
    !tmpRpath.removeVertex(1)
  endif
  if !tmpRpath.isClosed().not() then
    return error 1 'The vertex cannot be deleted as the shape of $!<entity> becomes invalid'
  endif

  -- check openings if they do not exceed
  if !pathId.eq(0) then
    if !this.checkOpenings(!tmpRpath.profile(true),'boundary').set() then
      !error = 'The vertex cannot be deleted as at least one opening exceeds the platform boundary'
    endif
  else
    !boundary = !this.rpath.profile(true)
    if !boundary.isWithin(!tmpRpath.profile(true)).not() then
      !error = 'The vertex cannot be deleted as the opening exceeds the platform boundary'
    endif
    !matchingOpenings = !this.checkOpenings(!tmpRpath.profile(true),'opening')
    !matchingOpenings[!pathId].delete()
    handle ANY
    endhandle
    if !matchingOpenings.set() then
      !error = 'The vertex cannot be deleted as the opening overlaps another opening(s)'
    endif
  endif

  if defined(!error) then
    return error 2 '$!<error>'
  endif

  -- store modified rpath
  !this.rpath(!pathId,!tmpRpath)

  -- draw object
  !this.draw()

  -- get new index
  if !this.rpath.size().boolean() then
    !newIndex = !index - 1
    if defined(!this.rpath.vertex[!newIndex]) then
      if !this.rpath.type[!newIndex].eq('CURVE') then
        !newIndex = !index - 2
      endif
    else
      !newIndex = 0
    endif
  else
    !newIndex = 0
  endif

  return !newIndex

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      moveEdge
--
-- Description: move platform edge
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Rpath id (0 - platform boundary, 1,2,3... opening boundary)
--    2   R      REAL        index of starting vertex of the edge
--    3   RW     DIRECTION   moving direction
--    4   R      REAL        distance to be moved along
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .moveEdge(!pathId is REAL,!index is REAL,!dir is DIRECTION,!dist is REAL)

  -- copy rpath
  if !pathId.eq(0) then
    !tmpRpath = !this.rpath
    !entity = 'platform'
  else
    !tmpRpath = !this.openings[!pathId]
    !entity = 'opening'
  endif

  -- project direction onto plane
  !dir = !dir.projected(!tmpRpath.profile(true).plane())
  handle ANY
    return error 1 'Invalid direction to move the edge of $!<entity>'
  endhandle

  -- check if any of openings does not exceed the platform boundary
  !startPos = !tmpRpath.vertex[!index]
  !next = !tmpRpath.nextPointOf(!index)
  !endPos = !tmpRpath.vertex[!next]
  !tmpRpath.vertex[!index] = !startPos.offset(!dir,!dist)
  !tmpRpath.vertex[!next] = !endPos.offset(!dir,!dist)

  -- check openings if they do not exceed
  if !pathId.eq(0) then
    if !this.checkOpenings(!tmpRpath.profile(true),'boundary').set() then
      !error = 'The edge cannot be moved as at least one opening exceeds the platform boundary'
    endif
  else
    !boundary = !this.rpath.profile(true)
    if !boundary.isWithin(!tmpRpath.profile(true)).not() then
      !error = 'The edge cannot be moved as the opening exceeds the platform boundary'
    endif
    !matchingOpenings = !this.checkOpenings(!tmpRpath.profile(true),'opening')
    !matchingOpenings[!pathId].delete()
    handle ANY
    endhandle
    if !matchingOpenings.set() then
      !error = 'The edge cannot be moved as the opening overlaps another opening(s)'
    endif
  endif

  if defined(!error) then
    return error 2 '$!<error>'
  endif

  -- store modified rpath
  !this.rpath(!pathId,!tmpRpath)

  -- draw
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkOpenings
--
-- Description: check openings against the shape if they do not exceed it
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     shape to be checked
--    2   R      STRING      type of shape (boundary or opening)
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       indices of exceeding openings
--
------------------------------------------------------------------------

define method .checkOpenings(!shape is PROFILE,!shapeType is STRING) is ARRAY

  -- init
  !result = ARRAY()
  if !shapeType.eq('boundary') then
    !command = object BLOCK('!shape.isWithin(!this.openings[!c].profile(true)).not()')
  elseif !shapeType.eq('opening') then
    !command = object BLOCK('!shape.isWithout(!this.openings[!c].profile(true)).not()')
  endif

  do !c indices !this.openings
    if !command.evaluate() then
      !result[!c] = !c
    endif
    handle ANY
    endhandle
  enddo

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rpath
--
-- Description: return rpath of passed id
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        rpath id (0 - platform, 1,2,3... opening)
--
-- Return:
--   [Data Type] [Description]
--    ASLRPATH    returned rpath
--
------------------------------------------------------------------------

define method .rpath(!rpathId is REAL) is ASLRPATH

  if !rpathId.eq(0) then
    !rpath = !this.rpath
  else
    !rpath = !this.openings[!rpathId]
  endif

  return !rpath

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rpath
--
-- Description: populate rpath of passed id with passed rpath
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        rpath id (0 - platform, 1,2,3... opening)
--    2   ASLRPATH           passed rpath
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rpath(!rpathId is REAL,!rpath is ASLRPATH)

  if !rpathId.eq(0) then
    !this.rpath = !rpath
    !shape = !this.shape()
    !this.intFrame.grid.outerBoundary(!shape)
    !boffset = !this.pltGrid.grid.outerBoundaryOffset()
    !this.pltGrid.grid.outerBoundary(!shape)
    !this.pltGrid.grid.outerBoundaryOffset(!boffset)
    if !this.posType.eq('FFL') then
    -- position correction to reflect plate thickness
      !dir = !this.orientation.zdir().opposite()
      !shape.position = !shape.position.offset(!dir,!this.plateThickness)
    endif
    !this.extFrame.boundary(!shape)
  else
    !this.openings[!rpathId] = !rpath
    !holes = !this.openingShapes()
    !this.intFrame.grid.innerBoundaries(!holes)
    !this.pltGrid.grid.innerBoundaries(!holes)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      openingShapes()
--
-- Description: return openings as PROFILE objects
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       openings as PROFILEs
--
------------------------------------------------------------------------

define method .openingShapes() is ARRAY

  -- init
  !shapes = ARRAY()

  do !c indices !this.openings
    !edges = !this.openings[!c].profile(true).edges()
    handle ANY
      skip
    endhandle
    !shape = object PROFILE(!this.openingsPos[!c].wrt(worl),Y is N wrt world ,!edges)
    !shapes.append(!shape)
  enddo

  return !shapes

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      handrail
--
-- Description: return handrails of platform as dbref array
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of handrail
--
------------------------------------------------------------------------

define method .handrail() is ARRAY

  --init
  !handra = ARRAY()
  if !this.dbElement.badref() then
    return !handra
  endif

  !handra = !!collectAllFor('HANDRA','',!this.dbElement)

  return !handra

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      alignElev
--
-- Description: set elevation of platform members to zero (wrt platform)
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .alignElev()

  !elev = !this.position.wrt(world).up
  !extPos = !this.extFrame.position()
  !extPos.up = !elev
  !this.extFrame.position(!extPos)

  !intPos = !this.intFrame.position()
  !intPos.up = !elev
  !this.intFrame.position(!intPos)

  !pltPos = !this.pltGrid.position()
  !pltPos.up = !elev
  !this.pltGrid.position(!pltPos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getTemplates
--
-- Description: get a list of assembly templates from current ASL settings
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       list of assemblies (dbref ARRAY)
--
------------------------------------------------------------------------

define method .getTemplates() is ARRAY

  !setting = !!aslCentralData.currSetting.description
  !templates[1] = nulref
  !templates.appendArray(!!aslCentralData.getTemplates(!setting,'PLTFRM'))
  handle ANY
  endhandle

  do !c indices !templates
    !tmpl = !templates[!c]
    skip if !tmpl.badref()
    !intfrm = !!dtbMemberOfType(!tmpl,'INTFRM',1)
    !extfrm = !!dtbMemberOfType(!tmpl,'EXTFRM',1)
    !pltgrd = !!dtbMemberOfType(!tmpl,'PLTGRD',1)
    if !intfrm.unset().or(!extfrm.unset()).or(!pltgrd.unset()) then
      !templates[!c].delete()
      skip
    endif

    !external = !!collectAllFor('GENSEC','(not (badref (spref) ))',!extfrm)
    !primary = !!collectAllFor('GENSEC','(upcase(function) eq ''PRIMARY'')',!intfrm)
    !secondary = !!collectAllFor('GENSEC','(upcase(function) eq ''SECONDARY'')',!intfrm)
    !opening = !!collectAllFor('GENSEC','(upcase(function) eq ''OPENING'')',!intfrm)
    !panels = !!collectAllFor('PANE','',!pltgrd)

    if !external.unset().or(!primary.unset()).or(!secondary.unset()).or(!opening.unset()).or(!panels.unset()) then
      !templates[!c].delete()
      skip
    endif
  enddo

  return !templates

endmethod
-- End of method
