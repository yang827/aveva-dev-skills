--
-- Description:     container for platform grid data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidNumbers(REAL,REAL,REAL)       -                   Set aid numbers
--  aidNumbersUnset()                -                   Unset aid numbers
--  boundaryOffset()                 REAL                return boundary offset
--  boundaryOffset(REAL)             BOOLEAN             set boundary offset
--  dbePltGrd()                      -                   default constructor
--  dbePltGrd(DBREF)                 BOOLEAN             Constructor
--  dbePltGrd(PROFILE)               -                   default constructor
--  detailPresent()                  BOOLEAN             return true if detail exists or can be created
--  draw()                           -                   Draw grid
--  elevation(REAL)                  -                   move object in its z-direction
--  getRemovedRef()                  DBREF               remove dbreference from registry of deleted panels and return it
--  gridAngle(REAL)                  -                   Modify grid angle
--  gridAngle(REAL,REAL)             -                   Modify grid angle
--  gridOffset(POSITION)             XYPOSITION          Modify grid XYOffset using passed position
--  gridOffset(REAL,REAL)            XYPOSITION          Modify grid XYOffset
--  gridOffset(XYPOSITION)           XYPOSITION          Modify grid XYOffset
--  gridSpacing(ARRAY,ARRAY)         ARRAY               set XY grid spacing
--  hide(BOOLEAN)                    -                   Add/remove db PLTGRD to/from drawlist
--  openings()                       ARRAY               return openings as PROFILE objects
--  orientation()                    ORIENTATION         return object orientation
--  orientation(ORIENTATION)         -                   modify object orientation
--  position()                       POSITION            return current object position
--  position(POSITION)               -                   modify object position
--  splitOnGrid(BOOLEAN)             -                   enable/disable split on grid
--  stringSpacing(STRING)            STRING              return passed spacing as a string
--  tagCells(ARRAY,STRING)           -                   Tag cells
--  tagPanes()                       -                   Tag panes
--  tidy()                           -                   Tidy up aid graphics
--  tmplReference(DBREF)             -                   set assembly template reference
--  updateDb()                       -                   create/update PLTGRD
--

-- Define object
define object DBEPLTGRD

  -- public members
  ---------------------------------------------------------------------------
  -- DB Element referenced
  member .dbElement       is DBREF

  -- Name
  member .name            is STRING

  -- Function
  member .function        is STRING

  member .description     is STRING

  member .number          is REAL

  member .matref          is DBREF

  -- panel specification reference
  member .spref           is DBREF

  member .posType is STRING

  member .purpose         is STRING

  member .grid            is RECTANGULARGRID

  -- reference to the template for platform grid
  member .tmplReference  is DBREF

  member .plateThickness  is REAL

  member .splitOnGrid     is BOOLEAN

  -- private members
  ---------------------------------------------------------------------------

  -- if TRUE remove db element from drawlist
  member .hide            is BOOLEAN

  -- registry of removed refs.
  member .removedRef        is ARRAY

  -- Aid number
  member .aidTags         is REAL
  member .aidNumberLines  is REAL
  member .aidNumberOuter  is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      dbePltGrd
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dbePltGrd()

  !this.name          = STRING()
  !this.function      = ''
  !this.description   = ''
  !this.number        = 0
  !this.purpose      = 'ASLA'
  !this.plateThickness = 30mm

  !this.grid = object RECTANGULARGRID()
  !xy[1] = 600mm
  !this.grid.gridXSpacings(!xy)
  !this.grid.gridYSpacings(!xy)
  !this.grid.gridAngle(0)

  !this.splitOnGrid = true
  !this.hide = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbePltGrd
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PROFILE     shape of PLTGRD
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .dbePltGrd(!shape is PROFILE)

  -- load defaults
  !this.dbePltGrd()

  -- add shape
  !this.grid.position(!shape.position)
  !this.grid.orientation(!shape.orientation)
  !this.grid.outerBoundary(!shape)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbePltGrd
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .dbePltGrd(!dbElement is DBREF) is BOOLEAN

   -- Load defaults
   !this.dbePltGrd()

   -- Verify type of the element passed
   if(!dbElement.fulltype.neq('PLTGRD'))then
     !!error.text    = 'Element ' & !dbElement.namn & ' is not a PLTGRD.'
      return false
   endif

  -- Set db element
  !this.dbElement         = !dbElement

  -- set assembly template
  if !dbElement.asstmp.badref() then
    !this.tmplReference = nulref
  else
    !this.tmplReference = !dbElement.asstmp
  endif

  -- Get attributes of the element
  if(!this.dbElement.isNamed) then
    !this.name        = !this.dbElement.name
  endif

  !this.description     = !this.dbElement.description
  !this.function        = !this.dbElement.function
  !this.number          = !this.dbElement.number
  !this.matref          = !this.dbElement.matref

  !panel = !!collectAllFor('PANE','',!dbElement)
  !matrefSet = false
  !sprefSet = false
  !thkSet = false
  !splitSet = false
  do !pane values !panel
    break if !matrefSet.and(!sprefSet).and(!thkSet).and(!splitSet)
    if !matrefSet.not() then
      if !pane.matref.badref().not() then
        !this.matref = !pane.matref
        !matrefSet = true
      endif
    endif
    if !sprefSet.not() then
      if !pane.spref.badref().not() then
        !this.spref = !pane.spref
        !sprefSet = true
        if !this.spref.spown.matref.badref().not() then
        -- override matref with one from spec.
          !this.matref = !this.spref.spown.matref
          !matrefSet = true
        endif
      endif
    endif
    if !thkSet.not() then
      !this.plateThickness = !pane.lohe
      handle NONE
        !thkSet = true
      elsehandle ANY
      endhandle
    endif
    if !splitSet.not() then
      if !pane.func.eq('SNGL') then
        !this.splitOnGrid = false
        !splitSet = true
      endif
    endif
  enddo

  if !sprefSet.and(!thkSet.not()) then
    !this.plateThickness = !!comConvertUnknownValue(!this.spref.answ, 'MM')
  endif

  !this.grid = object RECTANGULARGRID(!this.dbElement)

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      openings
--
-- Description: return openings as PROFILE objects
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of PROFILE objects
--
------------------------------------------------------------------------

define method .openings() is ARRAY

  !openings = !this.grid.innerBoundaries()

  -- loop through profiles to get rid off zero length lines
  do !c indices !openings
    !opening = !openings[!c]
    !edges = !opening.edges()
    do !cc indices !edges
      skip if !edges[!cc].objectType().eq('ARC')
      skip if !edges[!cc].length().neq(0)
      !edges[!cc].delete()
    enddo
    -- reset profile
    !opening = object PROFILE(!opening.position,!opening.orientation,!edges)
    !openings[!c] = !opening
  enddo

  return !openings

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridAngle
--
-- Description: Modify grid angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridAngle(!angle is REAL)

  -- Modify object
  !this.grid.gridAngle(!angle)

  -- Redraw grid
  !this.draw()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridAngle
--
-- Description: Modify grid angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridAngle(!angle is REAL,!spanAxis is REAL)

  if !spanAxis.eq(2) then
    !gridAngle = !angle + 90
  else
    !gridAngle = !angle
  endif

  -- Modify object
  !this.gridAngle(!gridAngle)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundaryOffset
--
-- Description: set boundary offset
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        boundary offset
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if boundary is a correct shape and the action was successful
--
------------------------------------------------------------------------

define method .boundaryOffset(!offset is REAL) is BOOLEAN


  if !this.grid.outerBoundaryOffset(!offset).not() then
    return false
  endif

  -- Redraw grid
  !this.draw()

  -- exit with success
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      boundaryOffset
--
-- Description: return boundary offset
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        boundary offset value
--
------------------------------------------------------------------------

define method .boundaryOffset() is REAL

  return !this.grid.outerBoundaryOffset()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     tagPanes
--
-- Description: Tag panes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagPanes()

  -- Initialise Variables

  !trimmed  = !this.grid.listOfTrimmedcells()

  !untrimmed  = !this.grid.listOfUntrimmedcells()

  -- Tag trimmed tiles
  do !cell values !trimmed

    !tagPosition  = !this.grid.cellPosition(!cell[1], !cell[2])
    AID TEXT NUMBER $!<this.aidTags> 'T:$!cell[1]:$!cell[2]' AT $!<tagPosition>
  enddo

  -- Tag untrimmed tiles
  do !cell values !untrimmed
    !tagPosition  = !this.grid.cellPosition(!cell[1], !cell[2])
    AID TEXT NUMBER $!<this.aidTags> '$!cell[1]:$!cell[2]' AT $!<tagPosition>
  enddo

endmethod
-- End of method
  ------------------------------------------------------------------------
--
-- Method:     tagCells
--
-- Description: Tag cells
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tagCells(!cells is ARRAY,!aidText is STRING)

  -- Initialise Variables

  -- Tag trimmed tiles
  do !cell values !cells

    !tagPosition  = !this.grid.cellPosition(!cell[1], !cell[2])
    AID TEXT NUMBER $!<this.aidTags> '$!aidText:$!cell[1]:$!cell[2]' AT $!<tagPosition>
  enddo

endmethod
-- End of method


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     draw
--
-- Description: Draw grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Don't draw if there is no aid number
  if(!this.aidNumberLines.unset())then
    return
  endif

  if !this.grid.outerBoundary().unset() then
    return
  endif

  -- Remove current graphics
  !this.tidy()

  -- Get boundary information
  !outerBoundary    = !this.grid.offsetedOuterBoundary()
  !outerBoundary.draw(!this.aidNumberOuter, 1, 5)

  if !this.splitOnGrid then
    -- Get gridlines
    !gridLines        = !this.grid.xGridlines()

    do !lines values !gridLines
      do !j indices !lines
        skip if(!j.eq(1))
        skip if !lines[!j].length().eq(0)
        !lines[!j].draw(!this.aidNumberLines, 1, 4)
      enddo
    enddo

    !gridLines        = !this.grid.yGridlines()

    do !lines values !gridLines
      do !j indices !lines
        skip if(!j.eq(1))
        skip if !lines[!j].length().eq(0)
        !lines[!j].draw(!this.aidNumberLines, 1, 4)
      enddo
    enddo
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      aidNumbers
--
-- Description: Set aid numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .aidNumbers(!aidAxes is REAL, !aidNumberLines is REAL, !aidNumberOuter is REAL)

  -- Set Aid number
  !this.aidTags         = !aidAxes
  !this.aidNumberLines  = !aidNumberLines
  !this.aidNumberOuter  = !aidNumberOuter

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      aidNumbersUnset
--
-- Description: Unset aid numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .aidNumbersUnset()

  -- Set Aid number
  --!this.aidAxes         = !aidAxes
  !this.aidNumberLines  = REAL()
  !this.aidNumberOuter  = REAL()

endmethod
-- End of method
------------------------------------------------------------------------------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy up aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid graphics
  --TODO axes too?
  if(!this.aidNumberLines.unset().not())then
    AID CLEAR ALL $!<this.aidNumberLines>
  endif
  if(!this.aidNumberOuter.unset().not())then
    AID CLEAR ALL $!<this.aidNumberOuter>
  endif
  AID CLEAR ALL $!<this.aidTags>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      splitOnGrid
--
-- Description: enable/disable split on grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     split on grid flag
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .splitOnGrid(!splitOnGrid is BOOLEAN)

  if !this.splitOnGrid.eq(!splitOnGrid) then
    return
  endif

  !this.splitOnGrid = !splitOnGrid

  if !this.splitOnGrid then
    !this.draw()
  else
    !this.tidy()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridOffset
--
-- Description: Modify grid XYOffset using passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridOffset(!position is POSITION) is XYPOSITION

  -- Map position on the platform grid plane
  !xyPosition = !this.plane.xyOffset(!position)

  -- Get XYOffset of position
  return !this.gridOffset(!xyPosition)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridOffset
--
-- Description: Modify grid XYOffset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        X offset
--    2   R      REAL        Y offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridOffset(!xOffset is REAL, !yOffset is REAL) is XYPOSITION

  !xyPos = object XYPOSITION(!xOffset,!yOffset)
  handle ANY
    !xyPos = object XYPOSITION()
  endhandle

  return !this.gridOffset(!xyPos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     gridOffset
--
-- Description: Modify grid XYOffset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION  Grid offset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridOffset(!xyPosition is XYPOSITION) is XYPOSITION

  -- init
  !oldXY = !this.grid.gridXYPosition()

  if !xyPosition.x.unset().or(!xyPosition.y.unset()) then
    return !oldXY
  endif

  if !xyPosition.eq(!oldXY) then
    return !oldXY
  endif

  -- Modify object
  !this.grid.gridXYPosition(!xyPosition)

  -- Redraw grid
  !this.draw()

  return !this.grid.gridXYPosition()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gridSpacing
--
-- Description: set XY grid spacing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     ARRAY       X spacings real array
--    2   R     ARRAY       Y spacings real array
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       New spacing as string
--
------------------------------------------------------------------------

define method .gridSpacing(!xSpacing is ARRAY,!ySpacing is ARRAY) is ARRAY

  -- init
  !result[1] = !this.stringSpacing('x')
  !result[2] = !this.stringSpacing('y')
  !x = ARRAY()
  !y = ARRAY()
  !oldX = !this.grid.gridXSpacings()
  !oldY = !this.grid.gridYSpacings()

  if !xSpacing.unset() then
    return error 1 'At least one numeric value must be given for X Size'
  endif
  if !ySpacing.unset() then
    return error 1 'At least one numeric value must be given for Y Size'
  endif

  -- check for zero or negative values
  do !space values !xSpacing
    if !space.gt(0) then
      !x.append(!space)
    endif
  enddo
  do !space values !ySpacing
    if !space.gt(0) then
      !y.append(!space)
    endif
  enddo

  if !x.unset() then
    return error 2 'X Size must not contain zero or negative value'
  endif
  if !y.unset() then
    return error 2 'Y Size must not contain zero or negative value'
  endif

  if !x.eq(!oldX).and(!y.eq(!oldY)) then
    return !result
  endif

  !this.grid.gridXSpacings(!x)
  !this.grid.gridYSpacings(!y)

  !this.draw()

  !result[1] = !this.stringSpacing('x')
  !result[2] = !this.stringSpacing('y')

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      detailPresent
--
-- Description: return true if detail exists or can be created
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .detailPresent() is BOOLEAN

  if !this.dbElement.badref() then
    return false
  endif

  return !this.dbElement.memb.set()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateDb
--
-- Description: create/update PLTGRD
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateDb()

  -- store CE
  !oldCE = !!ce

  -- create/recreate frame
  if !this.dbElement.badref() then
    if !this.dbElement.unset() then
      new PLTGRD
      !this.dbElement = !!ce
    else
      new PLTGRD ref $!this.dbElement
    endif
  else
    !!ce = !this.dbElement
    -- delete all PANELs and store their reference numbers
    !allMemb = !!ce.memb
    do !memb values !allMemb
      skip if !memb.type.neq('PANE')
      skip if !memb.purp.neq(!this.purpose)
      !!ce = !memb
      -- store refno in registry
      !this.removedRef.append(!memb)
      -- then delete it
      delete PANE
    enddo
  endif

  assTmp $!<this.tmplReference>

  -- general definition
  if !this.name.set() then
    !!ce.name      = !this.name
    handle ANY
    endhandle
  endif
  !!ce.function    = !this.function
  !!ce.description = !this.description
  !!ce.purpose     = !this.purpose
  !!ce.number      = !this.number
  matref $!<this.matref>

  !!ce.gAngle      = !this.grid.gridAngle()
  !!ce.grdXSpacing = !this.grid.gridXSpacings()
  !!ce.grdYSpacing = !this.grid.gridYSpacings()

  !xyPosition                 = !this.grid.gridXYPosition()
  !offset[1]                  = !xyPosition.x
  !offset[2]                  = !xyPosition.y
  !!ce.gXYOffset   = !offset
  !!ce.bndoff      = !this.boundaryOffset()

  -- set position and orientation
  !!ce.pos = !this.position()
  !!ce.ori = !this.orientation()

  if !this.splitOnGrid then
    !cells = !this.grid.listOfUntrimmedcells()
    !cells.appendarray(!this.grid.listOfTrimmedcells())
    do !c indices !cells
      !index1 = !cells[!c][1]
      !index2 = !cells[!c][2]
      !func = !index1 & ' ' & !index2
      !profiles = !this.grid.cellprofile(!index1,!index2)
      handle ANY
        skip
      endhandle
      do !profile values !profiles
        !refno = !this.getRemovedRef()
        if !refno.set() then
          !setRef = 'ref ' & !refno
        else
          !setRef = ''
        endif
        NEW PANE $!<setRef>
        !!ce.purp = !this.purpose
        !!ce.func = !func
        matref $!<this.matref>
        spref $!<this.spref>
        NEW PLOO
        !!ce.height = !this.plateThickness
        !!ce.sjus = 'TOP'
        !profile.dbWrite(CE)
      enddo
    enddo
  else
    !refno = !this.getRemovedRef()
    if !refno.set() then
      !setRef = 'ref ' & !refno
    else
      !setRef = ''
    endif
    NEW PANE $!<setRef>
    !!ce.purp = !this.purpose
    !!ce.func = 'SNGL'
    matref $!<this.matref>
    spref $!<this.spref>
    NEW PLOO
    !!ce.height = !this.plateThickness
    !!ce.sjus = 'TOP'
    !profile = !this.grid.offsetedOuterBoundary()
    !profile.dbWrite(CE)
    -- openings
    do !opening values !this.openings()
      new NXTRU
      !!ce.height = !this.plateThickness + 10
      new LOOP
      !opening.dbWrite(!!ce)
      !!ce = !!ce.owner
      by d (heig)
    enddo
  endif

  !!ce = !this.dbElement

  !!ce = !oldCE
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getRemovedRef
--
-- Description: remove dbreference from registry of deleted panels and return it
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       reference number
--
------------------------------------------------------------------------

define method .getRemovedRef() is DBREF

  !refno = nulref

  if !this.removedRef.set() then
    !refno = !this.removedRef.removeFirst()
  endif

  return !refno

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      stringSpacing
--
-- Description: return passed spacing as a string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      spacing identifier (X/Y)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stringSpacing(!xy is STRING) is STRING

  -- init
  !result = ''
  !strSpacing = ARRAY()
  if !xy.upcase().eq('X') then
    !spacing = !this.grid.gridXSpacings()
  elseif !xy.upcase().eq('Y') then
    !spacing = !this.grid.gridYSpacings()
  endif

  -- units
  -- setup formatting objects
  !fmt = !!distanceFmt
  -- Round down to nearest mm (only for current units MM)
  if (!!isImperialLength('DIST').not()) then
    !testUnit = 1mm
    !unitQualifier = !testUnit.units().unitQualifier().upcase()
    if( !unitQualifier eq 'MM' ) then
      !fmt.dp = 0
    elseif( !unitQualifier eq 'METRE' ) then
      !fmt.dp = 3
    else
      !fmt.dp = 2
    endif
  endif

  !blankSpaceFound = false
  do !space values !spacing
    !strSpace = !space.string(!fmt).trim()
    if !strSpace.match(' ').boolean() then
      !blankSpaceFound = true
    endif
    !strSpacing.append(!strSpace)
  enddo

  if !blankSpaceFound then
    !delim = ' ; '
  else
    !delim = ' '
  endif

  do !space values !strSpacing
    !result = !result & !delim & !space
  enddo

  !result = !result.trim().trim('L',';').trim()
  if !result.empty() then
    !result = STRING(0,!fmt)
  endif

  return !result

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: modify object position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    new object position
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!pos is POSITION)

  -- init
  !oldPos = !this.position()
  !newPos = !pos.wrt(world)
  if !oldPos.eq(!newPos) then
    return
  endif

  !this.grid.position(!newPos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: return current object position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    POSITION    object position
--
------------------------------------------------------------------------

define method .position() is POSITION

  return !this.grid.position().wrt(world)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      elevation
--
-- Description: move object in its z-direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        distance
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .elevation(!dist is REAL)

  !dir = !this.orientation().zdir()
  !newPos = !this.position().offset(!dir,!dist)

  !this.position(!newPos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: return object orientation
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ORIENTATION object orientation
--
------------------------------------------------------------------------

define method .orientation() is ORIENTATION

  !ori = !this.grid.orientation().wrt(world)
  handle ANY
    !ori = object ORIENTATION()
  endhandle

  return !ori

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: modify object orientation
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      ORIENTATION  new object orientation
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .orientation(!newori is ORIENTATION)

  -- init
  !oldori = !this.orientation()

  if !oldori.eq(!newori.wrt(world)) then
    return
  endif

  !this.grid.orientation(!newori.wrt(world))

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      hide
--
-- Description: Add/remove db PLTGRD to/from drawlist
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     removed if true
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hide(!remove is BOOLEAN)

  !this.hide = !remove

  if !this.dbElement.badref().not() then
    if !remove then
      !addRem = 'remove'
    else
      !addRem = 'add'
    endif
    var !drawlist split drawlist
    if !drawlist.find(!this.dbElement.owner.name).set() then
      $!addRem all (PANE GENSEC) for $!this.dbElement
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      tmplReference
--
-- Description: set assembly template reference
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       assembly template ref.
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmplReference(!tmpl is DBREF)

  -- exit if template is the same
  if !this.tmplReference.eq(!tmpl) then
    return
  endif

  if !tmpl.badref() then
    !this.tmplReference = nulref
    return
  else
    !this.tmplReference = !tmpl
  endif

  !panel = !!collectAllFor('PANE','',!this.tmplReference)
  !matref = nulref
  !spref = nulref
  !thickness = REAL()
  do !pane values !panel
    break if !matref.set().and(!spref.set()).and(!thickness.set())
    if !matref.unset() then
      if !pane.matref.badref().not() then
        !matref = !pane.matref
      endif
    endif
    if !spref.unset() then
      if !pane.spref.badref().not() then
        !spref = !pane.spref
        if !spref.spown.matref.badref().not() then
        -- override matref with one from spec.
          !matref = !spref.spown.matref
        endif
        -- override thickness with one from spref
        !thkInMM = object BLOCK(!spref.answ & 'mm')
        !thickness = !thkInMM.evaluate()
      endif
    endif
    if !thickness.unset() then
      !thickness = !pane.lohe
      handle ANY
      endhandle
    endif
  enddo

  !this.matref = !matref
  !this.spref = !spref
  if !thickness.set() then
    !this.plateThickness = !thickness
  endif

endmethod
-- End of method
