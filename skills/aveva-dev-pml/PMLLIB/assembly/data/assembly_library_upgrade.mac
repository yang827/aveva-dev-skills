-- Update the Assembly ADP Project Libraries to use the assembly orientation workaround at 12.0.SP5 and later

-- To be run from HULL DRAFTING or OUTFITTING DRAFT

$P
$P Assembly ADP Library change 12.0.SP5.2 starts...
$P

-- Check whether already upgraded
!firstTask =  /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask1
if (!firstTask.pmlFunction.eq('!!assyOriView(!array)')) then
  $P The Assembly ADP Library has already been upgraded. Aborting...
  return
endif

$P Add a new orientation task to each view
$P DRTMLB Type-1
TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask5
NAME /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask6

TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask4
NAME /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask5

TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask3
NAME /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask4

TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask2
NAME /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask3

TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask1
NAME /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask2

LAYE /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/USER_Tags
VIEW 

NEW TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A2/S1/V1/VTask1
 SPPURP VTASK
 FUNC 'Orientate View to Assembly'
 PMLFUN '!!assyOriView(!array)' 

TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/VTask5
NAME /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/VTask6

TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/VTask4
NAME /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/VTask5

TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/VTask3
NAME /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/VTask4

TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/VTask2
NAME /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/VTask3

TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/VTask1
NAME /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/VTask2

LAYE /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/USER_Tags
VIEW 

NEW TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V1/VTask1
 SPPURP VTASK
 FUNC 'Orientate View to Assembly'
 PMLFUN '!!assyOriView(!array)' 

TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V2/VTask1
NAME /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V2/VTask2

LAYE /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V2/USER_Tags
VIEW 

NEW TASK /TT/AssemblyADP/DrawingTemplate/Type-1/A3/S1/V2/VTask1
 SPPURP VTASK
 FUNC 'Orientate View to Assembly'
 PMLFUN '!!assyOriView(!array)' 

$P DRTMLB Type-2
TASK /TT/AssemblyADP/DrawingTemplate/Type-2/A2/S1/V1/VTask5
