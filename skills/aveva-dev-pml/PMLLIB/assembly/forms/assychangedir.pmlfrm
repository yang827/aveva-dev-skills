--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         03 February 2010
--
-- Description:
-- The form for updating a view after a change in look direction
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyChangeDir()                  -                   Constructor method
--  cancel()                         -                   Cancel this form
--  checkDir()                       -                   Check the entered direction
--  close()                          -                   Close the form
--  getViews()                       -                   Get views for the displayed drawing
--  highlightView(STRING)            -                   Highlight views
--  init()                           -                   Method to initialize the form
--  selectIcon()                     -                   Select the icon for for the current direction
--  setButtonIcon(GADGET)            -                   Set the button icon for selected
--  setButtonIconOff()               -                   Set the button icons to off
--  setCurrDir()                     -                   Set the button icon for selected
--  updateView(STRING,GADGET)        -                   Update the view
--
------------------------------------------------------------------------
--
setup form !!assyChangeDir

  -- Form members
  !this.formtitle  = 'Change the Look Direction'
  !this.callback   = '!this.init()'
  !this.cancelCall = '!this.cancel()'
  !this.quitCall   = '!this.close()'

  -- Members
  member .module   is ASSYMODULE
  member .sheeRefe is DBREF
  member .allViews is ARRAY
  member .currDir  is STRING

  para .for text 'For View' width 6

  -- All views for the currently displayed sheet
  option .assyViewList width 3

  para   .to text 'set the direction to:' width 12

  text   .assyDir width 14 STRING

  -- Available look directions
  if (!this.module.module.productFamily.upcase().eq('MARINE')) then
    !forwardTxt  = 'Look Forward '
    !aftText     = 'Look Aft '
    !portsideTxt = 'Look Portside '
  else
    !forwardTxt  = 'Look East '
    !aftText     = 'Look West '
    !portsideTxt = 'Look North '
	endif

  button .assyForward   tooltip '$!forwardTxt'  pixmap width 20 height 20
  button .assyAft       tooltip '$!aftText'     pixmap width 20 height 20
  button .assyPortside  tooltip '$!portsideTxt' pixmap width 20 height 20
  button .assyDown      tooltip 'Look Down '    pixmap width 20 height 20
  button .assyIso1      tooltip 'Look Iso 1 '   pixmap width 20 height 20
  button .assyIso2      tooltip 'Look Iso 2 '   pixmap width 20 height 20
  button .assyIso3      tooltip 'Look Iso 3 '   pixmap width 20 height 20
  button .assyIso4      tooltip 'Look Iso 4 '   pixmap width 20 height 20

exit

------------------------------------------------------------------------
--
-- Method:      .assyChangeDir()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyChangeDir()

  -- Form callbacks
  !this.assyViewList.callback  = '!this.highlightView(|ON|)'
  !this.assyDir.callback       = '!this.checkDir()'
  !this.assyForward.callback   = '!this.updateView(|X|,!this.assyForward)'
  !this.assyAft.callback       = '!this.updateView(|-X|,!this.assyAft)'
  !this.assyPortside.callback  = '!this.updateView(|Y|,!this.assyPortside)'
  !this.assyDown.callback      = '!this.updateView(|-Z|,!this.assyDown)'
  !this.assyIso1.callback      = '!this.updateView(|ISO1|,!this.assyIso1)'
  !this.assyIso2.callback      = '!this.updateView(|ISO2|,!this.assyIso2)'
  !this.assyIso3.callback      = '!this.updateView(|ISO3|,!this.assyIso3)'
  !this.assyIso4.callback      = '!this.updateView(|ISO4|,!this.assyIso4)'

endmethod
-- End of method definition for .assyChangeDir()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Get all valid views
  !this.getViews()

  -- Highlight the first view in the list
  !this.highlightView('ON')

  -- Set the current direction
  !this.setCurrDir()

  -- Display the current direction
  !this.assyDir.val = !this.currDir

  -- Select a direction icon
  !this.selectIcon()

endmethod
-- End of method .init()

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  -- Switch any highlighted view off
  !this.highlightView('OFF')

  -- Hide this form
  !this.hide()

endmethod
-- End of method .cancel()

-----------------------------------------------------------------------
--
-- Method:      .checkDir()
--
-- Description: Check the entered direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkDir()

  -- Check that the entered direction is valid
  !inputDir = object DIRECTION(!this.assyDir.val)
    handle (2,813)
      -- Cannot convert string to DIRECTION
      !!alert.warning('The entered direction is not valid. Please try again.')

      -- Reset the focus
      !this.assyDir.setFocus()

      return

    elsehandle none
      !direction = !inputDir.string().before(' WRT')

    endhandle

  -- Check if the entered direction is the same
  if (!inputDir.eq(object DIRECTION(!this.currDir))) then
    return
  endif

  -- Store the direction
  !this.currDir = !direction

  -- Access the selected view
  !!ce = !this.allViews[!this.assyViewList.val]

  -- Set the direction
  DIR $!direction
  TITLE |$!direction|

  -- Update the tasks
  !!assyUpdateTasks(!!ce)

  -- Re-highlight the view
  !this.highlightView('ON')

endmethod
-- End of method .checkDir()

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- Switch any highlighted view off
  !this.highlightView('OFF')

  -- Hide this form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      .getViews()
--
-- Description: Get views for the displayed drawing
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getViews()

  -- Initialise variables
  !this.allViews.clear()
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Get all views for the current sheet
  VAR !allViews COLL ALL VIEW FOR $!this.sheeRefe

  -- Build view data
  do !index ind !allViews

  	-- Initialise variables
  	!viewRefe = !allViews[!index].dbref()

  	-- Ignore any views with unset drawlist or has no members or is a symbolic view
  	skip if (!viewRefe.idln.unset())
  	skip if (!viewRefe.mem.size().eq(0))
  	skip if (!viewRefe.spPurpose.eq('HULSYM'))

  	-- We want this view
  	!this.allViews.append(!viewRefe)

  	-- Build the option gadget texts
  	!dtext.append(!viewRefe.flnm.after(!viewRefe.owne.flnm).after('/'))
    !rtext.append(!allViews[!index])

  enddo

  -- Populate the view list gadget
  !this.assyViewList.dtext = !dtext
  !this.assyViewList.rtext = !rtext

endmethod
-- End of method definition for .getViews()

------------------------------------------------------------------------
--
-- Method:      .highlightView()
--
-- Description: Highlight views
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Highlighting ON or OFF
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlightView(!onOff is STRING)

  -- Read the selected view
  !selectedViewRefe = !this.allViews[!this.assyViewList.val]

  -- Set the current direction
  !this.setCurrDir()

  -- Display the current direction
  !this.assyDir.val = !this.currDir

  -- Select a direction icon
  !this.selectIcon()

  -- Look for hull drafting
  if (!this.module.description.eq('MARINE')) then

    -- Load the marine api
    import 'marapi'
      handle( 1000, 0 )
        -- This error means that marapi has already been imported, ignore this error and continue.
      endhandle

    using namespace 'AVEVA.Marine.Drafting'

    -- Initialise mar api variables
    !mDrafting  = object MARDRAFTING()

    -- Close all highlighting display files
    !mDrafting.highlightOff(0)

    -- Find the view in the drawing object that matches the selected one and highlight it
    do !count from 1 to 999

    	-- Get the first view
    	if (!count.eq(1)) then
        !viewObject = !mDrafting.elementChildFirstGet()
          handle (1000,0)
          	--Exception has been thrown by the target of an invocation
          	-- i.e. there are no child elements
          	break
          endhandle

      else
        !viewObject = !mDrafting.elementSiblingNextGet(!viewObject)
          handle (1000,0)
          	--Exception has been thrown by the target of an invocation
          	-- i.e. there are no more sibling elements
          	break
          endhandle

      endif

      -- Check that the element is a VIEW
      skip if (!mDrafting.elementIsView(!viewObject).not())

      -- Get the DO view reference
      !viewRefeStrg = !mDrafting.elementPADDDbrefGet(!viewObject)

      -- Highlight the selected view
      if (!onOff.eq('ON') and !viewRefeStrg.eq(!selectedViewRefe.string())) then
        !mDrafting.elementHighlight(!viewObject)
    	endif

    enddo

    -- Repaint the graphics
    !mDrafting.dwgRepaint()

  -- For Outfitting or PDMS Draft
  else

    -- Ensure any previous view is not highlighted
    UNENHANCE ALL

    -- Highlight the selected view
    if (!onOff.eq('ON')) then

      ENHANCE $!selectedViewRefe

    endif

	endif

endmethod
-- End of method definition for .highlightView()

------------------------------------------------------------------------
--
-- Method:      .selectIcon()
--
-- Description: Select the icon for for the current direction
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectIcon()

  -- Set all button icons to OFF
  !this.setButtonIconOff()

  -- Forward, X
  if (!this.currDir.eq('X')) then
    !this.assyForward.addPixmap(!!pml.getPathName('ad_look_forward_on.png'))

  -- Aft, -X
  elseif (!this.currDir.eq('-X')) then
    !this.assyAft.addPixmap(!!pml.getPathName('ad_look_aft_on.png'))

  -- Portside, Y
  elseif (!this.currDir.eq('Y')) then
    !this.assyPortside.addPixmap(!!pml.getPathName('ad_look_portside_on.png'))

  -- Down -Z
  elseif (!this.currDir.eq('-Z')) then
    !this.assyDown.addPixmap(!!pml.getPathName('ad_look_down_on.png'))

  -- Iso1
  elseif (!this.currDir.eq('-X 45 -Y 35.26 -Z')) then
    !this.assyIso1.addPixmap(!!pml.getPathName('ad_look_iso1_on.png'))

  -- Iso2
  elseif (!this.currDir.eq('-X 45 Y 35.26 -Z')) then
    !this.assyIso2.addPixmap(!!pml.getPathName('ad_look_iso2_on.png'))

  -- Iso3
  elseif (!this.currDir.eq('X 45 Y 35.26 -Z')) then
    !this.assyIso3.addPixmap(!!pml.getPathName('ad_look_iso3_on.png'))

  -- Iso4
  elseif (!this.currDir.eq('X 45 -Y 35.26 -Z')) then
    !this.assyIso4.addPixmap(!!pml.getPathName('ad_look_iso4_on.png'))

  endif

endmethod
-- End of method definition for .selectIcon()

------------------------------------------------------------------------
--
-- Method:      .setCurrDir()
--
-- Description: Set the button icon for selected
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCurrDir()

  -- Get the current direction, which isstored in the view title attribute
  -- This is because the actual DIR is not the LOOK direction
  !setDirection = !this.allviews[!this.assyViewList.val].title
  !testDirection = object DIRECTION(!setDirection)
    handle (2,813)
      -- Cannot convert string to DIRECTION
      !this.currDir = ''

    elsehandle none
      !this.currDir = !setDirection

    endhandle

endmethod
-- End of method definition for .setCurrDir()

------------------------------------------------------------------------
--
-- Method:      .setButtonIcon()
--
-- Description: Set the button icon for selected
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget to be set
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setButtonIcon(!gadget is GADGET)

  -- Set all button icons to OFF
  !this.setButtonIconOff()

  -- Test for no gadget to represent the set direction
  if (!gadget.unset()) then

  	-- Done
  	return

  endif

  -- Forward, East
  if (!gadget.name().eq('ASSYFORWARD')) then
    !this.assyForward.addPixmap(!!pml.getPathName('ad_look_forward_on.png'))

  -- Aft, West
  elseif (!gadget.name().eq('ASSYAFT')) then
    !this.assyAft.addPixmap(!!pml.getPathName('ad_look_aft_on.png'))

  -- Portside, North
  elseif (!gadget.name().eq('ASSYPORTSIDE')) then
    !this.assyPortside.addPixmap(!!pml.getPathName('ad_look_portside_on.png'))

  -- Down
  elseif (!gadget.name().eq('ASSYDOWN')) then
    !this.assyDown.addPixmap(!!pml.getPathName('ad_look_down_on.png'))

  -- Iso1
  elseif (!gadget.name().eq('ASSYISO1')) then
    !this.assyIso1.addPixmap(!!pml.getPathName('ad_look_iso1_on.png'))

  -- Iso2
  elseif (!gadget.name().eq('ASSYISO2')) then
    !this.assyIso2.addPixmap(!!pml.getPathName('ad_look_iso2_on.png'))

  -- Iso3
  elseif (!gadget.name().eq('ASSYISO3')) then
    !this.assyIso3.addPixmap(!!pml.getPathName('ad_look_iso3_on.png'))

  -- Iso4
  elseif (!gadget.name().eq('ASSYISO4')) then
    !this.assyIso4.addPixmap(!!pml.getPathName('ad_look_iso4_on.png'))

  endif

endmethod
-- End of method definition for .setButtonIcon()

------------------------------------------------------------------------
--
-- Method:      .setButtonIconOff()
--
-- Description: Set the button icons off
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      The gadget to be set
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setButtonIconOff()

  -- Set all button icons to OFF
  !this.assyForward.addPixmap(!!pml.getPathName('ad_look_forward.png'))
  !this.assyAft.addPixmap(!!pml.getPathName('ad_look_aft.png'))
  !this.assyPortside.addPixmap(!!pml.getPathName('ad_look_portside.png'))
  !this.assyDown.addPixmap(!!pml.getPathName('ad_look_down.png'))
  !this.assyIso1.addPixmap(!!pml.getPathName('ad_look_iso1.png'))
  !this.assyIso2.addPixmap(!!pml.getPathName('ad_look_iso2.png'))
  !this.assyIso3.addPixmap(!!pml.getPathName('ad_look_iso3.png'))
  !this.assyIso4.addPixmap(!!pml.getPathName('ad_look_iso4.png'))

endmethod
-- End of method definition for .setButtonIconOff()

------------------------------------------------------------------------
--
-- Method:      .updateView(STRING,GADGET)
--
-- Description: Update the view
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Look Direction
--    2   R      GADGET      The gadget being pressed
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateView(!lookDir is STRING, !gadget is GADGET)

  -- Access the selected view
  !!ce = !this.allViews[!this.assyViewList.val]

  -- Set the direction
  DIR $!lookDir

  -- Store the set direction in the title
  -- For isometric views hard set the direction as we will use this to identify it later
  -- In otherwords don't leave it to the system to calculate it always the same
  if (!lookDir.eq('ISO1')) then
    TITLE |-X 45 -Y 35.26 -Z|

  elseif (!lookDir.eq('ISO2')) then
    TITLE |-X 45 Y 35.26 -Z|

  elseif (!lookDir.eq('ISO3')) then
    TITLE |X 45 Y 35.26 -Z|

  elseif (!lookDir.eq('ISO4')) then
    TITLE |X 45 -Y 35.26 -Z|

  else
    !setDirection = !!ce.dir.string().before(' WRT')
    TITLE |$!setDirection|

  endif

  -- Update the tasks
  !!assyUpdateTasks(!!ce)

  -- Re-highlight the view
  !this.highlightView('ON')

  -- Set the button icon
  !this.setButtonIcon(!gadget)

  -- Select a direction icon
  !this.selectIcon()

  -- Fresh the Marine graphics
  if (!this.module.description.eq('MARINE')) then

    -- Load the marine api
    import 'marapi'
      handle( 1000, 0 )
        -- This error means that marapi has already been imported, ignore this error and continue.
      endhandle

    using namespace 'AVEVA.Marine.Drafting'

    -- Initialise mar api variables
    !mDrafting  = object MARDRAFTING()

    -- Repaint the graphics
    !mDrafting.dwgRepaint()

  endif

endmethod
-- End of method definition for .updateView(STRING,GADGET)
