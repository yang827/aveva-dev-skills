--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         13 Feb 2006
--
--
-- Description:
-- Form for choosing the database in which to create the libraries
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Create the batch macro
--  assyDbs()                        -                   Constructor method
--  cancel()                         -                   Cancel this form
--  init()                           -                   Method to initialize the form
--
------------------------------------------------------------------------
setup form !!assyDbs

  -- Form members
  !this.formTitle = 'Assembly ADP Library'
  !this.callback  = '!this.init()'
  !this.quitCall  = '!this.cancel()'

  -- Reason for the form
  para .explain at x1 ymax text 'Create Assembly ADP Library here:'

  -- The list
  frame .fr 'Available Drafting Dbs' at x0 ymax

    list .listDbs at x1 ymax-0.2 single width 30 height 10

  exit

  -- Actions
  button .apply  'Apply'  at xmin           ymax+0.2 tooltip 'Create the Library '
  button .cancel 'Cancel' at xmax form-size ymin


  -- Members
  member .allDbs  is ARRAY
  member .created is BOOLEAN

exit

------------------------------------------------------------------------
--
-- Method:      .assyDbs()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyDbs()

  -- Form callbacks
  !this.apply.callback  = '!this.apply()'
  !this.cancel.callback = '!this.cancel()'

endmethod
-- End of method definition for .assyDbs()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !session  = CURRENT SESSION
  !draftDbs = ARRAY()

  -- Get current databases
  !mdb          = !session.mdb()
  !this.allDbs  = !mdb.current()
  !mode         = !mdb.mode()

  -- For each current db
  do !index ind !this.allDbs

    -- Get database
    !db = !this.allDbs[!index]

    -- Look for local draft db's open in RW
    if (!db.type.upCase().eq('PADD') and !db.foreign.upCase().eq('LOCAL') and !mode[!index].eq('RW')) then

      !draftDbs.append(!db.name)

    endif

  enddo

  -- Populate list gadget
  if (!draftDbs.size().eq(0)) then
    !!alert.error('There are no Drafting databases available. Please contact your System Administrator.')

  else
    !this.listDbs.dtext = !draftDbs
  endif

  -- Mark the library as not created
  !this.created = false

endmethod
-- End of method .init()

-----------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Create the batch macro
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- Initialise variables
  !world = /*
  !ptwlRefe = object DBREF()

    -- Find the point world within the selected db
  do !elemRefe val !world.mem

    if (!elemRefe.dbName.eq(!this.listDbs.selection('RTEXT')) and !elemRefe.type.upCase().eq('PTWL')) then

      -- We have the correct point
      !ptwlRefe = !elemRefe
      break

    endif

  enddo

  -- Access the point world
  if (!ptwlRefe.badref()) then
    !!alert.error('The system cannot load the Assembly ADP Library macro since there is no suitable location in the database. Please contact your System Administrator.')

  else

    -- Double check that the library does not exist
    VAR !existsLib EXISTS /TT/AssemblyADP/Libraries
    VAR !existsStdLib EXISTS /TT/AssemblyADP/StdLibrary

    -- Create the Assembly ADP library
    if (!existsLib.eq('FALSEA') and !existsStdLib.eq('FALSEA')) then

      -- Access the ptwl
      !!ce = !ptwlRefe

      -- Set macro depending on the units
      if (!!isImperialLength('DIST')) then
        !command = '$M %PMLLIB%\assembly\data\assembly_adp_library_imperial.txt'
      else
        !command = '$M %PMLLIB%\assembly\data\assembly_adp_library.txt'
      endif

      -- Call the supplied macro
      $!command
        handle any
          !!alert.error('There has been an error loading the Assembly ADP Library macro. Please contact your System Administrator.')

        elsehandle none

          !this.created = true

          !this.cancel()

          DEPT

        endhandle

    else
      if (!existsLib.eq('TRUEA')) then
        !!alert.error('The system cannot load the Assembly ADP Library since the LIBY /TT/AssemblyADP/Libraries already exists. Please contact your System Administrator.')
      else
        !!alert.error('The system cannot load the Assembly ADP Library since the LIBY /TT/AssemblyADP/StdLibrary already exists. Please contact your System Administrator.')
      endif
    endif

  endif

  if (defined(!!assyDrwgMain)) then
    -- Load main application object
    if (!!assyDrwgMain.assyDrwgApp.load()) then

      -- Stop when any load errors & deactivate the toolbar and main menu option
      !!assyDrwgMain.assyDrwgApp.active(false)
      return

    endif

    -- Load application default settings
    !!assyDrwgMain.assyDrwgApp.setDefaults()

    -- Set the application active status
    !!assyDrwgMain.assyDrwgApp.appForm.mbcreate.setFieldProperty('AssyLiby','visible',false)
  endif

endmethod
-- End of method .apply()

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  -- Check with the user
  if (!this.created.not()) then

    !answer = !!alert.confirm('The Assembly ADP Library will not be created. Are you sure you wish to cancel?')

    if (!answer.eq('NO')) then
      return
    endif

  endif

  !this.hide()

endmethod
-- End of method .cancel()
