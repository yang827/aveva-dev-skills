--
-- Description:
-- The main form for creating Assembly Planning deliverables
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arrange()                        -                   Rerun any arrange label TASK
--  assyDisplay()                    -                   Constructor method
--  browser(GADGET)                  -                   Show standard browser
--  cancel()                         -                   Cancel this form
--  ce()                             -                   Set form to report on the current element
--  ce(DBREF)                        -                   Set form to report on the current element
--  changeProjection()               -                   Display a form to modify a view direction
--  checkName()                      -                   Check the entered name
--  clear()                          -                   Close the form
--  close()                          -                   Close the form
--  cycleSheets(STRING)              -                   Cycle through the available sheets
--  display(REAL)                    -                   Display the selected items
--  findDate(DBREF)                  STRING              Find today's date that matches the DEPT format
--  gotoAssy()                       -                   Goto the ASMBLY associated with the selected drawing entry
--  gotoDrwg()                       -                   Goto the DRWG associated with the selected drawing entry
--  init()                           -                   Method to initialize the form
--  loadDrawings(ARRAY)              -                   Load the passed drawings for display
--  netAfterSelectChange(ARRAY)      -                   Callback on grid control after select change
--  netBeforeCellUpdate(ARRAY)       -                   Callback on grid control before cell update
--  netPopup(ARRAY)                  -                   Pop-up for grid control
--  numberCopies(STRING)             -                   Raise or lower the number of print copies
--  print()                          -                   Print the selected drawings
--  runSearch()                      -                   Run the report
--  saveToFile()                     -                   Save report to file
--  selAll()                         -                   Select all entries in the grid control
--  setActive(BOOLEAN)               -                   Set gadget active status
--  setCollate()                     -                   Set collage image
--  setDisplay()                     -                   Set whether drawings should be displayed when picked
--  setDisplay(BOOLEAN)              -                   Set whether drawings should be displayed when picked
--  setDrwg(DBREF)                   -                   Store passed drawing
--  setExcel(FILE)                   -                   Set file to that returned from the file browser and save the report to Excel
--  setFile(FILE)                    -                   Set file to that returned from the file browser and save the report
--  setIcon(REAL,ARRAY)              -                   Set the specified column cell icons
--  switchMode(STRING)               -                   Switch to a particular mode
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!assyDisplay dialog dock left

  -- Format
  !!format    = object FORMAT()
  !!format.dp = 0

  -- Form members
  !this.formtitle     = 'Assembly Drawings'
  !this.callback      = '!this.init()'
  !this.cancelCall    = '!this.cancel()'
  !this.quitCall      = '!this.close()'

  -- Drafting element below which to search
  para   .eTitle  anchor left + top         at x0.5     ymin text 'Drafting element to search under:'
  text   .ceName  anchor left + right + top at xmin     ymax width 44 scroll 90 STRING
  button .ce 'CE' anchor right + top        at xmax+0.5 ymin tooltip 'Current Element '

  -- Filter the search
  para   .foPara at x0.5 ymax+0.2 text 'Filter the drawings for:'
  option .filterOption anchor top + left + right at xmin ymax width 37
  button .search 'Search' anchor top + right at xmax+1.2 ymin

  -- Assembly List for display
  container .netFrame PMLNetCONTROL 'NET' anchor left + right + top + bottom at x0 ymax+0.5 width 50 height 15

  -- Cycle through sheets
  button .prev  tooltip 'Previous' anchor left + bottom at x1   ymax+0.3 pixmap width 16 height 16
  button .next  tooltip 'Next'     anchor left + bottom at xmax ymin pixmap width 16 height 16

  -- Sheet number being displayed
  para   .sheetA anchor left + bottom at x1          ymin width 32
  para   .sheetB anchor left + bottom at xmax.next+1 ymin width 32

  -- Save grid
  button .saveToExcel anchor right + bottom  at xmax.netFrame-5 ymin  tooltip 'Save List to Excel File ' pixmap width 19 height 19
--  button .saveToFile  anchor right + bottom  at xmin-2 ymin  tooltip 'Save List to Text File  ' pixmap width 19 height 19

  -- Print
  frame .print foldUpPanel 'Print' anchor left + right + bottom at x0 ymax+0.2 width.netFrame

    para   .pCopies anchor left + bottom  at x1       ymax+0.1  text 'Number of Copies:'
    text   .copies  anchor left + bottom  at xmax-5   ymin      width 3 is REAL format !!format
    button .up      anchor left + bottom  at xmax     ymin      pixmap width 7 height 6
    button .down    anchor left + bottom  at xmin     ymax+0.05 pixmap width 7 height 6

    para   .pColl             anchor right + top at xmax+3   ymin.pCopies pixmap width 16 height 16
    toggle .collate 'Collate' anchor right + top at xmax+2   ymax-0.5

    toggle .fit     'Fit'     anchor right + top at xmax-2.5 ymin-0.6
    toggle .bw      'B/W'     anchor right + top at xmin     ymin.collate+0.2

    button .submit  'Print'   anchor right + top at xmax ymin tooltip 'Submit to Default Printer'

  exit

  -- Members
  member .drawings     is ARRAY
  member .searchFilter is STRING
  member .headings     is ARRAY
  member .ceRefe       is DBREF

  -- My .net control
  using namespace 'Aveva.Pdms.Presentation'
  member .displayCtrl  is NETGRIDCONTROL

  member .rowSet       is ARRAY

  member .drgNos       is ARRAY
  member .drgIndex     is REAL
  member .shtNo        is REAL

  -- Grid output
  member .saveFile     is FILE
  member .saveExcel    is FILE

  -- Sheets printed
  member .printed      is ARRAY

  -- Display drawing when selected in agrid
  member .displayDrwg  is BOOLEAN

  -- Module
  member .module       is ASSYMODULE

exit

------------------------------------------------------------------------
--
-- Method:      .assyDisplay()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyDisplay()

  -- Pixmaps
  !this.prev.addPixmap(!!pml.getPathName('ad_t_013.png'))
  !this.next.addPixmap(!!pml.getPathName('ad_t_014.png'))
--  !this.saveToFile.addPixmap(!!pml.getPathName('ad_t_010.png'))
  !this.saveToExcel.addPixmap(!!pml.getPathName('ad_t_011.png'))
  !this.pColl.addPixmap(!!pml.getPathName('ad_t_016.png'))
  !this.up.addPixmap(!!pml.getPathName('uparrow7x6.png'))
  !this.down.addPixmap(!!pml.getPathName('downarrow7x6.png'))

  -- Define pop-up menu
  !menu = !this.newMenu('defPopUp')
    !menu.add('callback', 'Select All', '!this.selAll()')
    !menu.add('separator')
    !menu.add('callback', 'Goto Drawing', '!this.gotoDrwg()')
    !menu.add('callback', 'Goto Assembly', '!this.gotoAssy()')
    !menu.add('separator')

    -- Print option not for Marine Drafting
    if (!this.module.description.neq('MARINE')) then
      !menu.add('callback', 'Print Selection', '!this.print()')
      !menu.add('separator')
    endif

    !menu.add('callback', 'Change Projection', '!this.changeProjection()')
    !menu.add('callback', 'Rerun Arrange', '!this.arrange()')
    !menu.add('separator')
    !menu.add('toggle', 'Display Drawing', '!this.setDisplay()')

  -- Form callbacks
  !this.ce.callback           = '!this.ce()'
  !this.ceName.callback       = '!this.checkName()'
  !this.filterOption.callback = '!this.searchFilter = !this.filterOption.selection(|RTEXT|)'
  !this.search.callback       = '!this.runSearch()'
  !this.prev.callback         = '!this.cycleSheets(|PREV|)'
  !this.next.callback         = '!this.cycleSheets(|NEXT|)'
--  !this.saveToFile.callback = '!this.browser(!this.saveToFile)'
  !this.saveToExcel.callback  = '!this.browser(!this.saveToExcel)'
  !this.up.callback           = '!this.numberCopies(|UP|)'
  !this.down.callback         = '!this.numberCopies(|DOWN|)'
  !this.collate.callback      = '!this.setCollate()'
  !this.submit.callback       = '!this.print()'

  -- Create instance of .net control
  using namespace 'Aveva.Pdms.Presentation'
  !this.displayCtrl = object NETGRIDCONTROL()

  -- Add PML event handlers to .net control
  !this.displayCtrl.addeventhandler('OnPopup', !this, 'netPopup')
  !this.displayCtrl.addeventhandler('AfterSelectChange', !this, 'netAfterSelectChange')
  !this.displayCtrl.addeventhandler('BeforeCellUpdate', !this, 'netBeforeCellUpdate')

  -- Add .net control to PML container
  !this.netFrame.control = !this.displayCtrl.handle()

  !this.displayCtrl.columnExcelFilter(false)
  !this.displayCtrl.outlookGroupStyle(false)
  !this.displayCtrl.fixedHeaders(true)
  !this.displayCtrl.fixedRows(true)
  !this.displayCtrl.gridHeight(1000.0)
  !this.displayCtrl.editableGrid(true)
  !this.displayCtrl.singleRowSelection(true)

  -- Set default print output as black & white and scale to fit
  !this.bw.val  = true
  !this.fit.val = true

endmethod
-- End of method definition for .assyDisplay()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialize the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
  -- Initialise variables
  !worldRefe  = /*
  !dtext      = ARRAY()
  !rtext      = ARRAY()

  -- Set defaults search point as the world
  !this.ce(!worldRefe)

  -- Set grid control headings
  !this.headings.append('Drg No')
  !this.headings.append('Assembly')
  !this.headings.append('Type')
  !this.headings.append('Author')
  !this.headings.append('Date')
  !this.headings.append('Template')
  !this.headings.append('Size')
  !this.headings.append('Access')

  -- Set search pull-down options
  -- Set filter options
  !dtext.append('All Drawings')
  !rtext.append('ALL')
  if (!this.module.description.eq('MARINE')) then
    !dtext.append('Marine Drawings')
    !rtext.append('MARINE')
  else
    !dtext.append('Outfitting Drawings')
    !rtext.append('OUTFIT')
  endif
  !dtext.append('Those drawn by me')
  !rtext.append('DRAWN BY ME')
  !dtext.append('Those drawn by me today')
  !rtext.append('DRAWN BY ME TODAY')
  !dtext.append('Bad Assembly Reference')
  !rtext.append('BADREF')
  !this.filterOption.dtext = !dtext
  !this.filterOption.rtext = !rtext

  -- Read search filter option
  !this.searchFilter = !this.filterOption.selection()

  -- Set default save directory and file
  !this.saveFile  = object FILE('%PDMSUSER%\assembly drawing report.txt')
  !this.saveExcel = object FILE('%PDMSUSER%\assembly drawing report.xls')

  -- Close print panel & set default copies
  !this.print.expanded = false
  !this.copies.val     = 1

  -- Set gadgets not active
  !this.setActive(false)

  -- Clear the grid and data object
  !this.clear()

  -- Set the print option off for Marine Drafting
  if (!this.module.description.eq('MARINE')) then
    !this.print.visible = false
  endif

  -- Set the auto-display option on
  !this.defPopUp.select('Display Drawing',true)
  !this.setDisplay(true)

endmethod
-- End of method .init()

-----------------------------------------------------------------------
--
-- Method:      .arrange()
--
-- Description: Rerun any arrange label TASK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .arrange()

  -- Find the first selected drawing
  !drwgObj  = !this.drawings[!this.displayCtrl.getSelectedRowTags()[1].real()]

  -- Look for any arrange task
  VAR !allTasks COLL ALL TASK Wi SPPURP EQ 'VTASK' AND FUNC EQ 'Arrange Tags' FOR $!<drwgObj.reference>

  -- Run the found tasks
  do !task val !allTasks

    -- Initialise variables
    !taskRefe = !task.dbref()

    -- Build the task object
    !taskObj = object ASSYTASK(!taskRefe)

    -- Get into position as the function requires the laye to be the ce
    VAR !tagLaye COLL ALL LAYE WI SPPURP EQ 'PRTTAG' FOR $!<taskRefe.owne>

    -- Test for delete laye
    if (!tagLaye.empty()) then
      skip
    else
      !!ce = !tagLaye[1].dbref()
    endif

    -- Execute the task
    !taskObj.execute()

  enddo

endmethod
-- End of method .arrange()

-----------------------------------------------------------------------
--
-- Method:      .browser(GADGET)
--
-- Description: Show standard browser
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget requiring the selected file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browser(!gadget is GADGET)

  import 'pmlFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !browser = object PMLFILEBROWSER('SAVE')

  -- Save to text file
  if (!gadget.name().eq('SAVETOFILE')) then

    -- Initialise variables
    !directory       = !this.saveFile.directory().fullName()
    !seedFile        = !this.saveFile.entry()
    !title           = 'Save Drawing Report as Text'
    !extensionString = 'txt files (*.txt)|*.txt'

  -- Save to excel file
  elseif (!gadget.name().eq('SAVETOEXCEL')) then

    -- Initialise variables
    !directory       = !this.saveFile.directory().fullName()
    !seedFile        = !this.saveExcel.entry()
    !title           = 'Save Drawing Report as Excel'
    !extensionString = 'xls files (*.xls)|*.xls'

  endif

  -- Show Browser
  !browser.show(!directory, !seedFile, !title, false ,!extensionString , 2)

  -- Test for no returned file name
  if (!browser.file().neq('')) then

    -- Write the output file
    if (!gadget.name().eq('SAVETOFILE')) then

      !this.setFile(object FILE(!browser.file()))

    elseif (!gadget.name().eq('SAVETOEXCEL')) then

      !this.setExcel(object FILE(!browser.file()))

    endif

  endif

endmethod
-- End of method .browser(GADGET)

