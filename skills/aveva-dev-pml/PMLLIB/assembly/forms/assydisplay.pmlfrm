------------------------------------------------------------------------
--
-- Method:      .ce()
--
-- Description: Set form to report on the current element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ce()

  -- Initialise variables
  !type = !!ce.hardType.upcase()

  -- Check current element is world, dept, regi or drwg
  if (!type.neq('WORL') and !type.neq('DEPT') and !type.neq('REGI') and !type.neq('DRWG')) then

    -- User warning
    !!alert.warning('Cannot report drawings from this position in the hierarchy')

    -- Give a list of things they can report from?

  endif

  -- Add ce
  !this.ceRefe     = !!ce
  !this.ceName.val = !this.ceRefe.flnn

endmethod
-- End of method definition for .ce()

------------------------------------------------------------------------
--
-- Method:      .ce(DBREF)
--
-- Description: Set form to report on the current element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ce(!element is DBREF)

  -- Add ce
  !this.ceRefe     = !element
  !this.ceName.val = !this.ceRefe.flnn

endmethod
-- End of method definition for .ce(DBREF)

------------------------------------------------------------------------
--
-- Method:      .changeProjection()
--
-- Description: Display a form to modify a view direction
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeProjection()

  -- Load the marine api
  import 'marapi'
    handle( 1000, 0 )
      -- This error means that marapi has already been imported, ignore this error and continue.
    endhandle

  using namespace 'AVEVA.Marine.Drafting'

  -- Initialise mar api variables
  !mDrafting  = object MARDRAFTING()

  -- Get index of selected element in the array
  !this.drgIndex = !this.displayCtrl.getSelectedRowTags()[1].real()

  -- Get the relevant sheet
  !drwgObj  = !this.drawings[!this.drgIndex]
  !sheeRefe = !drwgObj.sheets[!this.shtNo]

	-- Ensure the change direction form is loaded
	if (undefined(!!assyChangeDir)) then
		pml load form !!assyChangeDir
	endif

	-- Get the current displayed sheet if any
	!sheetRefeStrg = !mDrafting.dwgNameGet()
	  handle (1000,0)
	  endhandle

	-- For a displayed sheet
	if (defined(!sheetRefeStrg)) then

		-- Display the sheet only if it is different to the currently displayed one
		if (!sheetRefeStrg.neq(!sheeRefe.string())) then
	    !this.module.displaySheet(!sheeRefe)
	  endif

	-- As there is no sheet displayed then display the selected one
	else
	  !this.module.displaySheet(!sheeRefe)

	endif

	-- Set the form for the current selected sheet
	!!assyChangeDir.sheeRefe = !sheeRefe

	-- Display the form
	if (!!assyChangeDir.shown().not()) then
	  show !!assyChangeDir

	-- Re-initialise the form
	else
	  !!assyChangeDir.init()

  endif

endmethod
-- End of method definition for .changeProjection()

------------------------------------------------------------------------
--
-- Method:      .checkName()
--
-- Description: Check the entered name
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkName()

  -- Initialise variables
  !entered  = !this.ceName.val

  -- Trim any leading or trailing blanks
  !entered = !entered.trim('LR')

  -- Get leading character
  !leadChar = !entered.substring(1,1)

  -- Check for leading slash
  if (!leadChar.neq('=') and !leadChar.neq('/')) then
    !fullName    = '/' & !entered
    !noSlashName = !entered
  else
    !fullName    = !entered
    !noSlashName = !entered.substring(2)
  endif

  -- Check name exists
  VAR !exists EXIST $!fullName
  if (!exists.eq('FALSEA')) then
    !!alert.error('The name you have entered is not valid. Please check and try again.')
    return
  endif

  -- Add ce
  !this.ceRefe = !fullName.dbref()

  -- Check for leading equals
  if (!leadChar.eq('=')) then
    !noSlashName = !this.ceRefe.flnn
  endif

  -- Display name
  !this.ceName.val = !noSlashName

endmethod
-- End of method definition for .checkName()

