------------------------------------------------------------------------
--
-- Method:      .cycleSheets()
--
-- Description: Cycle through the available sheets
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Direction to cycle PREV or NEXT
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cycleSheets(!direction is STRING)

  -- Check for no drawing displayed
  if (!this.drawings.unset() or !this.drawings.empty()) then
    return
  endif

  -- Get displayed drawing
  !drawingObj = !this.drawings[!this.drgIndex]

  -- Check for only a single drawing, as it is already displayed
  if (!drawingObj.sheets.size().eq(1)) then
    return
  endif

  -- Cycle through the sheets from the current one
  if (!direction.eq('PREV')) then

    -- Test for the first
    if (!this.shtNo.eq(1)) then
      !index = !drawingObj.sheets.size()
    else
      !index = !this.shtNo - 1
    endif

  else

    -- Test for the last
    if (!this.shtNo.eq(!drawingObj.sheets.size())) then
      !index = 1
    else
      !index = !this.shtNo + 1
    endif

  endif

  -- Display the sheet
  !this.display(!index)

endmethod
-- End of method definition for .cycleSheets()

------------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Display the selected items
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Which sheet number to display
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display(!shtNo is REAL)

  -- For more than one selected use only the first
  -- Get index of selected element in the array
  !this.drgIndex = !this.displayCtrl.getSelectedRowTags()[1].real()

  -- Get drawing data and first sheet
  !drwgObj  = !this.drawings[!this.drgIndex]
  !numbSheets = !drwgObj.sheets.size()
  !sheeRefe = !drwgObj.sheets[!shtNo]

  -- Test if drwg has been deleted since the search was made
  if (!sheeRefe.badref()) then
    !answer = !!alert.confirm(|The DRWG | & |'| & !drwgObj.drawingNo & |'| & | has been deleted. Do you wish to refresh the list (it may take some time)?|)
    if (!answer.eq('YES')) then
      !this.runSearch()
    endif
  else

    -- Put sheet into the main Draft display
    if (!this.displayDrwg) then
      !this.module.displaySheet(!sheeRefe)
    endif

    -- Get to padd db commands
  !this.switchMode('PADD')

    -- Set display text & switch on/off the page cycling buttons
    if (!numbSheets.eq(1)) then
      !this.sheetA.val     = 'Displaying: Sheet ' & !shtNo & ' of ' & !numbSheets
      !this.sheetA.visible = true
      !this.sheetB.visible = false
      !this.setActive(false)
    else
      !this.sheetB.val     = 'Displaying: Sheet ' & !shtNo & ' of ' & !numbSheets
      !this.sheetA.visible = false
      !this.sheetB.visible = true
      !this.setActive(true)
    endif

    -- Store the sheet number being displayed
    !this.shtNo = !shtNo

  endif

	-- Check for the change direction form
	if (defined(!!assyChangeDir)) then

	  if (!!assyChangeDir.shown()) then

	    -- Set the form to use the current sheet
	    !!assyChangeDir.sheeRefe = !sheeRefe

	    -- Re-initialise the form
	    !!assyChangeDir.init()

	  endif

  endif

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:        .findDate(BOOLEAN)
--
-- Description:   Find today's date that matches the DEPT format
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The drawing element
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .findDate(!drwgRefe is DBREF) is STRING

  -- Initialise variables
  !dateTime  = object DATETIME()
  !day       = !dateTime.date()
  !month     = !dateTime.month()
  !monthWord = !dateTime.monthString()
  !year      = !dateTime.year()

  -- Read date format from the owning DEPT
  !deptRefe   = DEPT OF $!drwgRefe
  !dateFormat = !deptRefe.dateFormat

  -- 09/30/2006
  if (!dateFormat.eq('DDMMYYYY')) then

    !today = !day & '/' & !month & '/' & !year

  -- 09/30/06
  elseif (!dateFormat.eq('DDMMYY')) then

    !today = !day & '/' & !month & '/' & !year.string().substring(3)

  -- 30/09/2006
  elseif (!dateFormat.eq('MMDDYYYY')) then

    !today = !month & '/' & !day & '/' & !year

  -- 30/09/06
  elseif (!dateFormat.eq('MMDDYY')) then

    !today = !month & '/' & !day & '/' & !year.string().substring(3)

  -- 30 SEP 2006
  elseif (!dateFormat.eq('DDMONYYYY')) then

    !today = !day & ' ' & !monthWord.substring(1,3) & ' ' & !year

  -- 30 SEP 06
  elseif (!dateFormat.eq('DDMONYY')) then

    !today = !day & ' ' & !monthWord.substring(1,3) & ' ' & !year.string().substring(3)

  endif

  return !today

endmethod
-- End of method definition for .findDate()

------------------------------------------------------------------------
--
-- Method:      .gotoDrwg()
--
-- Description: Goto the DRWG associated with the selected drawing entry
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .gotoDrwg()

  -- For more than one selected only take the first
  -- Get index of selected element in the array
  !this.drgIndex = !this.displayCtrl.getSelectedRowTags()[1].real()

  -- Get drawing data and first sheet
  !drwgObj  = !this.drawings[!this.drgIndex]

  -- Test if drwg has been deleted since the search was made
  if (!drwgObj.reference.badref()) then
    !answer = !!alert.confirm(|The DRWG | & |'| & !drwgObj.drawingNo & |'| & | has been deleted. Do you wish to refresh the list (it may take some time)?|)
    if (!answer.eq('YES')) then
      !this.runSearch()
    endif
  else

    -- Access the DRWG
    !!ce = !drwgObj.reference

  endif

endmethod
-- End of method definition for .gotoDrwg()

------------------------------------------------------------------------
--
-- Method:      .gotoAssy()
--
-- Description: Goto the ASMBLY associated with the selected drawing entry
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .gotoAssy()

  -- For more than one selected only take the first
  -- Get index of selected element in the array
  !this.drgIndex = !this.displayCtrl.getSelectedRowTags()[1].real()

  -- Get drawing data and first sheet
  !drwgObj  = !this.drawings[!this.drgIndex]

  -- Test if asmbly has been deleted since the search was made
  if (!drwgObj.asmblyRefe.badref()) then
    !answer = !!alert.confirm(|The ASMBLY | & |'| & !drwgObj.rowSet[!this.drgIndex][2] & |'| & | has been deleted. Do you wish to refresh the list (it may take some time)?|)
    if (!answer.eq('YES')) then
      !this.runSearch()
    endif
  else

    -- Access the ASMBLY
    !!ce = !drwgObj.asmblyRefe

  endif

endmethod
-- End of method definition for .gotoAssy()

------------------------------------------------------------------------
--
-- Method:      .loadDrawings()
--
-- Description: Load the passed drawings for display
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadDrawings(!drwgRefes is ARRAY)

  -- Clear all data
  !this.clear()

  -- Load each drawing
  do !drwgRefe val !drwgRefes
    !this.setDrwg(!drwgRefe)
  enddo

  -- Sort the drawings by drawing number
  !sorted = !this.drgNos.sortedIndices()
  !this.drawings.reindex(!sorted)
  !this.rowSet.reindex(!sorted)

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.displayCtrl.bindToDataSource(object NETDATASOURCE('Assembly Drawings', !this.headings, !this.rowSet, '^Drg No'))

  -- Display the first
  !select[1] = 1
  !this.displayCtrl.setSelectedRowTags(!select)

  -- Select the drawn by me today option
  !this.filterOption.select('RTEXT','DRAWN BY ME TODAY')

endmethod
-- End of method definition for .loadDrawings()

------------------------------------------------------------------------
--
-- Method:      .netAfterSelectChange()
--
-- Description: Callback on grid control after select change
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelectChange(!array is ARRAY)

  -- Display a drawing if it exists
  if (!this.displayCtrl.getSelectedRowTags().set()) then
    !this.display(1)
  endif

endmethod
-- End of method definition for .netAfterSelectChange()

------------------------------------------------------------------------
--
-- Method:      .netBeforeCellUpdate()
--
-- Description: Callback on grid control before cell update
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      STRING      The new value selected from the option list
--                           or if string does not match any of those in the list
--                           the entered string
--    1   R      BOOLEAN     A return argument to confirm valid field - false aborts the update
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netBeforeCellUpdate(!array is ARRAY)

  -- Test returned value is valid for this entry
  if (!array[0].neq('1') and !array[0].neq('2') and !array[0].neq('3')) then
    !!alert.error('Invalid value. Please try again')
    !array[1] = false
  endif

endmethod
-- End of method definition for .netBeforeCellUpdate()

------------------------------------------------------------------------
--
-- Method:      .netPopup()
--
-- Description: Pop-up for grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopup(!array is ARRAY)

  -- Show the pop-up
   !this.netFrame.popup = !this.defPopUp
   !this.netFrame.showPopup(!array[0], !array[1])

endmethod
-- End of method definition for .netPopup()

------------------------------------------------------------------------
--
-- Method:      .numberCopies(STRING)
--
-- Description: Raise or lower the number of print copies
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .numberCopies(!direction is STRING)

  -- Raise
  if (!direction.eq('UP')) then

    -- Raise the number by 1
    !number = !this.copies.val + 1

    -- Test for 999
    if (!number.eq(999)) then
      !this.copies.val = 1
    else
      !this.copies.val = !number
    endif

  -- Lower
  else

    -- Lower the number by 1
    !number = !this.copies.val - 1

    -- Check when zero
    if (!number.eq(0)) then
      !this.copies.val = 1
    else
      !this.copies.val = !number
    endif

  endif

endmethod
-- End of method definition for .numberCopies(STRING)

------------------------------------------------------------------------
--
-- Method:      .print()
--
-- Description: Print the selected drawings
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .print()

  -- Initialise variables
  !toBePrinted  = ARRAY()

  -- Set colour output
  if (!this.bw.val) then

    -- Print in black & white
    !colourOption = 'COL BW'

  else

    -- Print colours, but switch any white to black
    !colourOption = 'COL COLOURPLUS'

  endif

  -- Set scale
  if (!this.fit.val) then

    -- Scale to fit the printer paper size
    !scaleOption = ', REDUCE'

  else

    -- Print full size
    !scaleOption = ''

  endif

  -- For each selected drawing
  do !count ind !this.displayCtrl.getSelectedRowTags()

    -- Initialise variables
    !index = !this.displayCtrl.getSelectedRowTags()[!count].real()

    -- Test if drwg has been deleted since the search was made
    if (!this.drawings[!index].reference.badref()) then
      !answer = !!alert.confirm(|The DRWG | & |'| & !drwgObj.drawingNo & |'| & | has been deleted. Do you wish to refresh the list (it may take some time)?|)
      if (!answer.eq('YES')) then
        !this.runSearch()
      endif
      return
    endif

    -- For each selected sheet
    do !shtNum ind !this.drawings[!index].sheets

      -- Get the sheet
      !sheeRefe = !this.drawings[!index].sheets[!shtNum]

      -- Test if the sheet has been deleted since the search was made
      if (!sheeRefe.badref()) then
        !!alert.error('SHEE ' & !shtNum & ' of DRWG No ' & !this.drawings[!index].drawingNo & ' has been deleted and hence ignored')
        break
      endif

      -- FUTURE: Check if the sheet has already been printed

      -- Store sheet for printing
      !toBePrinted.append(!sheeRefe)

    enddo
  enddo

  -- Print the sheets
  if (!this.collate.val) then

    -- Print one copy of each sheet at a time
    -- For each copy
    do !count from 1 to !this.copies.val

      -- Submit the sheet for printing
      do !shtNumber index !toBePrinted

        -- Get sheet
        !sheeRefe = !toBePrinted[!shtNumber]

        -- Set the option to display the printer dialog for first time only
        if (!count.eq(1) and !shtNumber.eq(1)) then
          !dialogOption = ''
        else
          !dialogOption = ', NODIALOG'
        endif

        !this.module.submitToPrinter(!sheeRefe, !colourOption, !dialogOption, !scaleOption)

      enddo

    enddo

  else

    -- Print all copies of each sheet at the same time
    do !index ind !toBePrinted

      -- Submit the sheet for printing
      do !count from 1 to !this.copies.val

        -- Set the option to display the printer dialog for first time only
        if (!index.eq(1) and !count.eq(1)) then
          !dialogOption = ''
        else
          !dialogOption = ', NODIALOGUE'
        endif

        !this.module.submitToPrinter(!toBePrinted[!index], !colourOption, !dialogOption, !scaleOption)

      enddo

    enddo

  endif

  -- Store sheets as having been printed
  !this.printed.clear()
  !this.printed = !toBePrinted

endmethod
-- End of method definition for .print()

-----------------------------------------------------------------------
--
-- Method:      .runSearch()
--
-- Description: Run the report
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .runSearch()

  -- Initialise variables
  !session  = current session
  !userName = !session.login.upcase()
  !elemRefe = !this.ceRefe

  -- Clear the grid and data object
  !this.clear()

  -- Get all drawing members of the passed element, while checking for the world
  -- The result includes the current element
  if (!this.ceRefe.hardType.upcase().eq('WORL')) then
    VAR !allDrwg COLL ALL DRWG WI SPPURP EQ 'ASYADP'
  else
    VAR !allDrwg COLL ALL DRWG WI SPPURP EQ 'ASYADP' FOR $!elemRefe
  endif

  -- Test each drawing against the filter option
  do !drwg val !allDrwg

    -- Initialise variables
    !drwgRefe   = !drwg.dbref()
    !asmblyRefe = !drwgRefe.idln

    -- Drawing Type
    if (!this.searchFilter.eq('MARINE') or !this.searchFilter.eq('OUTFIT')) then

      -- Get all drwgs with a particular marptype
      if (!asmblyRefe.set() and !asmblyRefe.badref().not()) then

        -- Get the sheets owned by the drawing
        VAR !allSheet COLL ALL SHEE FOR $!drwgRefe

        -- Test for any sheet marptype
        if (!allSheet.set()) then

          -- Marine Drawings
          if (!this.searchFilter.eq('MARINE') and !allSheet[1].dbref().marPtype.neq(0)) then
            !this.setDrwg(!drwgRefe)

          -- Outfitting Drawings
          elseif (!this.searchFilter.eq('OUTFIT') and !allSheet[1].dbref().marPtype.eq(0)) then
            !this.setDrwg(!drwgRefe)
          endif

        endif

      endif

    -- Drawn by the user
    elseif (!this.searchFilter.eq('DRAWN BY ME')) then

      -- Get all drwgs produced by this user
      if (!asmblyRefe.set() and !asmblyRefe.badref().not() and !drwgRefe.auth.upcase().eq(!userName)) then
        !this.setDrwg(!drwgRefe)
      endif

    -- Drawn by the user today
    elseif (!this.searchFilter.eq('DRAWN BY ME TODAY')) then

      -- Get all drwgs produced by this user today
      if (!asmblyRefe.set() and !asmblyRefe.badref().not() and !drwgRefe.auth.upcase().eq(!userName) and !drwgRefe.date.eq(!this.findDate(!drwgRefe))) then
        !this.setDrwg(!drwgRefe)
      endif

    -- Those drawings with a bad reference to an assembly
    elseif (!this.searchFilter.eq('BADREF')) then

      if (!asmblyRefe.set() and !asmblyRefe.badref()) then
        !this.setDrwg(!drwgRefe)
      endif

    -- All drawings
    else
      !this.setDrwg(!drwgRefe)
    endif

  enddo

  -- Sort the drawings by drawing number
  !sorted = !this.drgNos.sortedIndices()
  !this.drawings.reindex(!sorted)
  !this.rowSet.reindex(!sorted)

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.displayCtrl.bindToDataSource(object NETDATASOURCE('Assembly Drawings', !this.headings, !this.rowSet, '^Drg No'))

  -- Set the cells for assembly valid contents
  !this.setIcon(2, !this.drawings)

endmethod
-- End of method .runSearch()

-----------------------------------------------------------------------
--
-- Method:      .saveToFile()
--
-- Description: Save report to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveToFile()

  -- Initialise variables
  !fileObj    = !this.saveFile
  !date       = object DATETIME()
  !project    = CURRENT PROJECT
  !title      = 'Assembly Drawings Report'
  !session    = CURRENT SESSION
  !underLine  = '_'
  !separator  = '___'
  !content    = ARRAY()
  !body       = ARRAY()
  !data       = ARRAY()

  -- Build header names
  !heading[1] = 'Drg No'
  !heading[2] = 'Assembly'
  !heading[2] = 'Type'
  !heading[3] = 'Author'
  !heading[4] = 'Date'
  !heading[5] = 'Template'
  !heading[6] = 'Size'
  !heading[7] = 'Access'

  -- Set mode
  if (!fileObj.exists()) then
    !mode = 'OVERWRITE'
  else
    !mode = 'WRITE'
  endif

  -- Get report body
  do !index ind !this.drawings

    -- Build the drawing object and extract the data
    !drwgObj  = !this.drawings[!index]
    !drwgData = !drwgObj.getData()

    -- Build the arrays
    do !count ind !drwgData
      !data[!count][!index] = !drwgData[!count]
    enddo

  enddo

  -- Add the header text and a space
  do !index ind !data
    !data[!index].insert(1,!heading[!index])
    !data[!index].insert(2,' ')
  enddo

  -- Get report column maximum widths
  !maxA = !data[1].width() + 3
  !maxB = !data[2].width()
  !maxC = !data[3].width()
  !maxD = !data[4].width()
  !maxE = !data[5].width()
  !maxF = !data[6].width()

  -- Compose and add the body data
  do !index from 1 to !data[1].size()

    VAR !composed COMPOSE |   $!data[1][$!index]| WIDTH $!maxA SPACES 3 $
|$!data[2][$!index]| WIDTH $!maxB SPACES 3 $
|$!data[3][$!index]| WIDTH $!maxC SPACES 3 $
|$!data[4][$!index]| WIDTH $!maxD SPACES 3 $
|$!data[5][$!index]| WIDTH $!maxE SPACES 3 $
|$!data[6][$!index]| WIDTH $!maxF SPACES 3 $
|$!data[7][$!index]|

    !body.appendArray(!composed)

  enddo

  -- Calculate body width and build separator line
  !maxBody = !body.width()
  do from 1 to !maxBody
    !separator = !separator & !underLine
  enddo

  -- Build report header
  !content.append(!separator)
  !content.append(' ')
  !content.append('                        ' & !title)
  !content.append(' ')
  !content.append(!separator)
  !content.append(' ')
  !content.append(' Project: ' & !project.code() & ' ' & !project.name())
  !content.append(' Date:    ' & !date.string())
  !content.append(' User:    ' & !session.login)
  !content.append(' ')
  !content.append(!separator)
  !content.append(' ')
  !content.append('   Reporting assembly drawing in: ' & !this.ceName.val)
  !content.append('   Filtered to show:              ' & !this.filterOption.selection('dtext'))
  !content.append(!separator)
  !content.append(' ')

  -- Add body text
  !content.appendArray(!body)

  -- Add report footer
  !content.append(' ')
  !content.append(!separator)
  !content.append(' End')

  -- Write file
  !fileObj.writefile(!mode,!content)

endmethod
-- End of method .saveToFile()

-----------------------------------------------------------------------
--
-- Method:      .selAll()
--
-- Description: Select all entries in the grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selAll()

  -- Initialise variables
  !select = ARRAY()

  -- FUTURE: When selecting all do we want to switch off the 'display a drawing' option?

  -- Build array of all rows
  do !index index !this.displayCtrl.getRows()
    !select.append(!index)
  enddo

  -- Select all rows
  !this.displayCtrl.setSelectedRowTags(!select)

endmethod
-- End of method .selAll()

-----------------------------------------------------------------------
--
-- Method:      .setActive(BOOLEAN)
--
-- Description: Set gadget active status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether to make buttons active or not
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setActive(!active is BOOLEAN)

  -- Set active
  !this.prev.active = !active
  !this.next.active = !active

  -- Set hidden
  !this.prev.visible = !active
  !this.next.visible = !active

endmethod
-- End of method .setActive(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .setCollate()
--
-- Description: Set collate image
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCollate()

  -- Set collate image depending on collate state
  if (!this.collate.val) then
    !this.pColl.val = !!pml.getPathName('ad_t_017.png')
  else
    !this.pColl.val = !!pml.getPathName('ad_t_016.png')
  endif

endmethod
-- End of method .setCollate()

-----------------------------------------------------------------------
--
-- Method:      .setDisplay()
--
-- Description: Set whether drawings should be displayed when picked
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDisplay()

  -- Check pop-up setting
  if (!this.defPopUp.selected('Display Drawing')) then
    !this.displayDrwg = true
  else
    !this.displayDrwg = false
  endif

endmethod
-- End of method .setDisplay()

-----------------------------------------------------------------------
--
-- Method:      .setDisplay(BOOLEAN)
--
-- Description: Set whether drawings should be displayed when picked
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDisplay(!on is BOOLEAN)

  -- Check pop-up setting
  if (!on) then
    !this.displayDrwg = true
  else
    !this.displayDrwg = false
  endif

endmethod
-- End of method .setDisplay(BOOLEAN)

-----------------------------------------------------------------------
--
-- Method:      .setDrwg(DBREF)
--
-- Description: Store passed drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDrwg(!drwgRefe is DBREF)

  -- Construct drawing object
  !drwgObj = object ASSYDISPLAYDRWG(!drwgRefe)

  -- Store it and the drawing number
  !this.drawings.append(!drwgObj)
  !this.drgNos.append(!drwgObj.drawingNo)

  -- Store the row data
  !this.rowSet.append(!drwgObj.rowData)

endmethod
-- End of method .setDrwg(DBREF)

------------------------------------------------------------------------
--
-- Method:        .setExcel(FILE)
--
-- Description:   Set file to that returned from the file browser and save the report to Excel
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File object for the save file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setExcel(!fileObj is FILE)

  -- Store browser settings on this form
  !this.saveExcel = !fileObj

  -- Save report to excel
  !this.displayCtrl.saveGridToExcel(!this.saveExcel.directory().fullName() & '\' & !this.saveExcel.entry())

endmethod
-- End of method definition for .setExcel(FILE)

------------------------------------------------------------------------
--
-- Method:        .setFile(FILE)
--
-- Description:   Set file to that returned from the file browser and save the report
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File object for the save file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFile(!fileObj is FILE)

  -- Store browser settings on this form
  !this.saveFile = !fileObj

  -- Save report
  !this.saveToFile()

endmethod
-- End of method definition for .setFile(FILE)

-----------------------------------------------------------------------
--
-- Method:      .setIcon(REAL,ARRAY)
--
-- Description: Set the specified column cell icons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setIcon(!column is REAL, !drawings is ARRAY)

  -- For each cell
  do !index ind !drawings

    -- NOT OK
    if (!drawings[!index].asmblyRefe.badref()) then
      !this.displayCtrl.setCellImage(!index, !column, !!pml.getPathName('ad_t_019.png'))
    endif

  enddo

endmethod
-- End of method .setIcon(REAL,ARRAY)
-----------------------------------------------------------------------
--
-- Method:      .switchMode()
--
-- Description: Switch to a particular mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      PADD
--                           DESI
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .switchMode(!requiredType is STRING)

  -- Get current database type
  !dbType = !!ce.dbType

  -- Access required type
  if (!requiredType.upcase().eq('DESI') and !dbType.eq('PADD')) then
    CONTEXT DESIGN
  elseif (!requiredType.upcase().eq('PADD') and !dbType.eq('DESI')) then
    CONTEXT DRAWING
  endif

endmethod
-- End of method .switchMode()
