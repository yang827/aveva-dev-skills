--
-- File:            assydrwgconfig.pmlfrm
--   Type:          Form Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         Sun 04 February 2007
--
--
-- Description:
-- Used to edit and maintain the assembly drawing configuration file
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyDrwgConfig()                 -                   Constructor
--  browser(GADGET)                  -                   Show standard browser
--  cancel()                         -                   Cancel any form changes
--  checkFile(GADGET)                -                   Check the entered file
--  checkResult(STRING,STRING)       -                   Check the entered expression
--  getDrawingTypes()                ARRAY               Get drawing template types
--  getLalb()                        -                   Get all parts list label libraries
--  getLalbNames()                   ARRAY               Get label library names
--  getSettings()                    ARRAY               Get all form settings
--  getTemplates()                   -                   Get drawing template elements
--  init()                           -                   form initialisation
--  restore()                        -                   Reset form to original values
--  save()                           -                   Save the complete configuration to the main object
--  saveSettings()                   -                   Save form settings to form object
--  selSize()                        -                   Select the sizes for the selected drawing type
--  setGadgets()                     -                   Set the form gadgets to the configuration settings
--  setModified(BOOLEAN)             -                   Set this form modified status
--  setOutput(STRING,GADGET)         -                   Set file to that returned from the file browser and save the report
--  setType()                        -                   Set the chosen type of drawing template
--
------------------------------------------------------------------------
-- Define form
setup form !!assyDrwgConfig dialog dock left

  -- Form callbacks
  !this.formTitle  = 'Assembly Drawing Preferences'
  !this.callback   = '!this.init()'
  !this.cancelCall = '!this.saveChanges(|CLOSE|)'

  -- Department Settings
  frame .deptSettings foldUpPanel ' Department & Registry ' width 52

    text  .assemblyPurp  'DEPT and REGI SpPurpose  ' at x1    ymax width 10 STRING
    para  .pDeptRootName at xmin ymax text 'New Department Rootname'
    text  .deptRootName  at xmin+1 ymax width 48 scroll 90 STRING

  exit

  -- Drawing Settings
  frame .drawingSettings foldUpPanel ' Drawing ' at xmin ymax width 52

    -- Create a drawing
    toggle .createDrawing 'Create a Drawing' at x1 ymax-0.2

    -- Search rule to find libraries that contain the drawing templates
    para   .pLr at xmin ymax text 'Search for DRTMLB with this rule:'
    text   .libraryRule at xmin+1 ymax width 44 scroll 90 STRING
    button .checkLs     at xmax+1 ymin pixmap width 16 height 16 tooltip 'Validate '

    -- The Drtmlb attribute used as the template description
    option .drtmlbAtt 'DRTMLB Description Attribute' at x1 ymax+0.5 width 17

    -- Preferred type
    para   .pPrefType     at x1   ymax text 'Create a drawing using this preferred type:'
    option .preferredType at xmin+1 ymax width 45

    -- Preferred size
    option .preferredSize 'Preferred Size  ' at x1 ymax+0.3 width 3

    -- Drawing Number Attribute
    option .drgNoAtt      'Drg No Attribute' at x1 ymax+0.3 width 17

    -- Create Pdf
    toggle .drawingPdf 'Create a PDF formatted file' at x1 ymax+0.3

    -- Pdf file location folder
    para   .pPdfFolder at x1     ymax text 'Create PDF files in this location:'
    text   .pdfFolder  at xmin+1 ymax width 44 scroll 90 STRING
    button .pdfBrowse  tooltip 'Browse Folders ' at xmax+1 ymin pixmap width 16 height 16

  exit

  -- Parts List Settings
  frame .partsListSettings foldUpPanel ' Parts List ' at xmin ymax width 52

    -- Create a Parts List
    toggle .createPartsList 'Create a Parts List' at x1 ymax-0.2

    -- Search rule to find libraries that contain the parts list definitions LALB
    para   .pPartsListRule at x1   ymax text 'Search for LALB with this rule:'
    text   .partsListRule  at xmin+1 ymax width 44 scroll 90 STRING
    button .checkPl        at xmax+1 ymin pixmap width 16 height 16 tooltip 'Validate '

    -- The Lalb attribute used as the definition description
    option .lalbAtt 'LALB Description Attribute  ' at x1 ymax+0.5 width 17

    -- Preferred type
    para   .pPrefPart     at x1   ymax+0.3 text 'Create a parts list using this preferred type:'
    option .preferredPart at xmin+1 ymax width 45

    -- The search rule used to find the SYTM that holds the assembly attributes
    para   .pAsmblyAttRule at x1   ymax+0.3 text 'Search for ASMBLY Attribute SYTM with this rule:'
    text   .asmblyAttRule  at xmin+1 ymax width 44 scroll 90 STRING
    button .checkAr        at xmax+1 ymin pixmap width 16 height 16 tooltip 'Validate '

    -- The search rule used to find the SYTM that holds the parts list attributes
    para   .pPartsAttRule at x1   ymax+0.3 text 'Search for Parts Attribute SYTM with this rule:'
    text   .partsAttRule  at xmin+1 ymax width 44 scroll 90 STRING
    button .checkPr       at xmax+1 ymin pixmap width 16 height 16 tooltip 'Validate '

    -- Output Formats
    para .outFormats at x1 ymax+0.5 text 'Output Formats'
    toggle .partsTxt '.txt' at xmax   ymin
    toggle .partsCsv '.csv' at xmax+1 ymin
    toggle .partsXls '.xls' at xmax+1 ymin

    -- Location
    para   .pOutputFolder at x1     ymax text 'Create formatted output in this location:'
    text   .outputFolder  at xmin+1 ymax width 44 scroll 90 STRING
    button .outputBrowse  tooltip 'Browse Folders ' at xmax+1 ymin pixmap width 16 height 16

  exit

  -- Administration Settings
  frame .adminSettings foldUpPanel ' Administration ' at xmin ymax width 52

    -- Log File location
    para   .pLogFolder at x1     ymax-0.2 text 'Create Log files in this location:'
    text   .logFolder  at xmin+1 ymax width 44 scroll 90 STRING
    button .logBrowse  tooltip 'Browse Folders ' at xmax+1 ymin pixmap width 16 height 16

    -- Batch File location
    para   .pBatchFolder at x1     ymax+0.3 text 'Create Batch files in this location:'
    text   .batchFolder  at xmin+1 ymax width 44 scroll 90 STRING
    button .batchBrowse  tooltip 'Browse Folders ' at xmax+1 ymin pixmap width 16 height 16

    -- The search rule used to find the LINK DOC location
    para   .plinkDescRule at x1     ymax+0.3 text 'Search for Link Document location with this rule:'
    text   .linkDescRule  at xmin+1 ymax width 44 scroll 90 STRING
    button .checkLink     at xmax+1 ymin pixmap width 16 height 16 tooltip 'Validate '

  exit

  -- Save, restore & cancel
  button .save    'Save'    tooltip 'Save Changes '     at x0             ymax+0.3
  button .restore 'Restore' tooltip 'Restore Settings ' at xmax+15        ymin
  button .cancel  'Cancel'  tooltip 'Cancel Changes '   at xmax form-size ymin


  -- Member Definitions
  -- This form title
  member .titleString is STRING

  -- The object holding the configuration file settings
  member .settings    is ASSYDRWGCONFIG

  -- All drawing templates
  member .allDrtmlb   is ARRAY

  -- All label libraries
  member .allLalb     is ARRAY

  -- Whether the form has been modified
  member .modified    is BOOLEAN

exit
-- End of form definition for !!assyDrwgConfig

------------------------------------------------------------------------
--
-- Method:      .assyDrwgConfig()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .assyDrwgConfig()

  -- Store form title
  !this.titleString = !this.formTitle

  -- Pixmaps
  !this.checkLs.addPixmap(!!pml.getPathName('ad_t_020.png'))
  !this.pdfBrowse.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.checkPl.addPixmap(!!pml.getPathName('ad_t_020.png'))
  !this.checkAr.addPixmap(!!pml.getPathName('ad_t_020.png'))
  !this.checkPr.addPixmap(!!pml.getPathName('ad_t_020.png'))
  !this.checkLink.addPixmap(!!pml.getPathName('ad_t_020.png'))
  !this.outputBrowse.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.logBrowse.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.batchBrowse.addPixmap(!!pml.getPathName('ad_t_012.png'))

  -- Callbacks
  !this.assemblyPurp.callback    = '!this.saveSettings()'
  !this.deptRootName.callback    = '!this.saveSettings()'
  !this.createDrawing.callback   = '!this.saveSettings()'
  !this.libraryRule.callback     = '!this.saveSettings()'
  !this.checkLs.callback         = '!this.checkResult(|DRTMLB|,!this.libraryRule.val)'
  !this.drtmlbAtt.callback       = '!this.saveSettings()'
  !this.preferredType.callback   = '!this.setType()'
  !this.preferredSize.callback   = '!this.saveSettings()'
  !this.drgNoAtt.callback        = '!this.saveSettings()'
  !this.drawingPdf.callback      = '!this.saveSettings()'
  !this.pdfFolder.callback       = '!this.checkFile(!this.pdfFolder)'
  !this.pdfBrowse.callback       = '!this.browser(!this.pdfFolder)'
  !this.createPartsList.callback = '!this.saveSettings()'
  !this.partsListRule.callback   = '!this.saveSettings()'
  !this.checkPl.callback         = '!this.checkResult(|LALB|,!this.partsListRule.val)'
  !this.lalbAtt.callback         = '!this.saveSettings()'
  !this.preferredPart.callback   = '!this.saveSettings()'
  !this.asmblyAttRule.callback   = '!this.saveSettings()'
  !this.checkAr.callback         = '!this.checkResult(|SYTM|,!this.asmblyAttRule.val)'
  !this.partsAttRule.callback    = '!this.saveSettings()'
  !this.checkPr.callback         = '!this.checkResult(|SYTM|,!this.partsAttRule.val)'
  !this.partsTxt.callback        = '!this.saveSettings()'
  !this.partsCsv.callback        = '!this.saveSettings()'
  !this.partsXls.callback        = '!this.saveSettings()'
  !this.outputFolder.callback    = '!this.checkFile(!this.outputFolder)'
  !this.outputBrowse.callback    = '!this.browser(!this.outputFolder)'
  !this.logFolder.callback       = '!this.checkFile(!this.logFolder)'
  !this.logBrowse.callback       = '!this.browser(!this.logFolder)'
  !this.batchFolder.callback     = '!this.checkFile(!this.batchFolder)'
  !this.batchBrowse.callback     = '!this.browser(!this.batchFolder)'
  !this.linkDescRule.callback    = '!this.saveSettings()'
  !this.checkLink.callback       = '!this.checkResult(||,!this.linkDescRule.val)'
  !this.save.callback            = '!this.save()'
  !this.restore.callback         = '!this.restore()'
  !this.cancel.callback          = '!this.cancel()'

  -- Expanded state
  !this.drawingSettings.expanded   = false
  !this.partsListSettings.expanded = false
  !this.adminSettings.expanded     = false

  -- Set form as unmodified
  !this.setModified(false)

endmethod
-- End of method definition for .assyDrwgConfig()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: form initialisation
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Get the main configuration object
  !this.settings = !!assyDrwgMain.assyDrwgApp.config

  -- Check if the file has been modified since the time the configuration file was read
  if (!this.settings.file.dtm().neq(!this.settings.lastMod)) then

    -- Question user for an update
    if (!!alert.confirm('The configuration file has been modified outside of PDMS. Would you like to reload the settings?').eq('YES')) then

      -- Read the modified configuration file
      !this.settings.read(!this.settings.file)

      -- Set form as modified
      !this.setModified(true)

    endif

  endif

  -- Get all relevant existing drawing templates & label libraries
  !this.getTemplates()
  !this.getLalb()

  -- Set form gadget values from the settings object
  !this.setGadgets()

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .browser(GADGET)
--
-- Description: Show standard browser
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget requiring the selected file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browser(!gadget is GADGET)

  import 'PMLFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !folderBrowser = object PMLFOLDERBROWSER()

  -- Show the folder browser
  !folderBrowser.show('Select Output Folder',true)

  -- Use the selected folder
  !this.setOutput(!folderBrowser.selectedPath(), !gadget)

  -- Save settings
  !this.saveSettings()

endmethod
-- End of method .browser()

------------------------------------------------------------------------
--
-- Method:        .cancel()
--
-- Description:   Cancel any form changes
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  -- Check for a modified form
  if (!this.modified) then
    if (!!alert.confirm('The settings on this form have been modified. Are you sure you wish to cancel?').eq('NO')) then
      return
    endif
  endif

  -- Reset the form
  !this.restore()

  -- Close the form
  !this.hide()

endmethod
-- End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      .checkFile(GADGET)
--
-- Description: Check the entered file
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget making the call
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkFile(!gadget is GADGET)

  -- Initialise variables
  !file = object FILE(!gadget.val)

  -- Check if file exists
  if (!file.exists().not()) then
    !!alert.error('Destination folder does not exist!')
  else

    -- Save settings
    !this.saveSettings()

  endif

endmethod
-- End of method definition for .checkFile(GADGET)

------------------------------------------------------------------------
--
-- Method:      .checkResult(STRING,STRING)
--
-- Description: Check the entered expression
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type for which to search
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkResult(!type is STRING, !expression is STRING)

  -- Try to find any of the passed type using the passed expression
  VAR !all COLL ALL $!type $!expression
    handle (47,15)

      -- CP: Syntax error
      !!alert.warning('This expression is invalid and would produce a syntax error!')

      return

    endhandle

  -- Test for none
  if (!all.empty()) then
    !!alert.warning('This expression does not yield any results!')
  else
    !!alert.message('This expression successfully produces a result.')
  endif

endmethod
-- End of method definition for .checkResult(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:        .getDrawingTypes()
--
-- Description:   Get drawing template types
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDrawingTypes() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- For each drtmplb
  do !drtmlbObj val !this.allDrtmlb
    !array.append(!drtmlbObj.description)
  enddo

  -- Sort arrays by description
  !sorted = !array.sortedIndices()
  !array.reIndex(!sorted)
  !this.allDrtmlb.reIndex(!sorted)

  return !array

endmethod
-- End of method definition for .getDrawingTypes()

------------------------------------------------------------------------
--
-- Method:        .getLalb()
--
-- Description:   Get all parts list label libraries
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getLalb()

  -- Initialise variables
  !this.allLalb.clear()

  -- Collect all label libraries with a configuration purpose
  VAR !allLalb COLL ALL LALB $!<this.settings.partsListRule>

  -- Build the object for each found library
  do !lalb val !allLalb
    !this.allLalb.append(object ASSYDRWGLALB(!lalb.dbref(), !this.settings.partsListDesc))
  enddo

endmethod
-- End of method definition for .getLalb()

------------------------------------------------------------------------
--
-- Method:        .getLalbNames()
--
-- Description:   Get label library names
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Dept names as STRINGs
--
------------------------------------------------------------------------
define method .getLalbNames() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- For each library
  do !lalbObj val !this.allLalb
    !array.append(!lalbObj.name)
  enddo

  -- Sort arrays by library name
  !sorted = !array.sortedIndices()
  !array.reIndex(!sorted)
  !this.allLalb.reIndex(!sorted)

  return !array

endmethod
-- End of method definition for .getLalbNames()

------------------------------------------------------------------------
--
-- Method:        .getSettings()
--
-- Description:   Get all form settings
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       All gadget values
--
------------------------------------------------------------------------
define method .getSettings() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- Append these gadget values
  !array.append(!this.createDrawing.val)
  !array.append(!this.libraryRule.val)
  !array.append(!this.drtmlbAtt.selection())
  !array.append(!this.preferredType.selection())
  !array.append(!this.preferredSize.selection())
  !array.append(!this.drgNoAtt.selection())
  !array.append(!this.assemblyPurp.val)
  !array.append(!this.drawingPdf.val)
  !array.append(object FILE(!this.pdfFolder.val))
  !array.append(!this.createPartsList.val)
  !array.append(!this.partsListRule.val)
  !array.append(!this.lalbAtt.selection())
  !array.append(!this.preferredPart.selection())
  !array.append(!this.asmblyAttRule.val)
  !array.append(!this.partsAttRule.val)
  !array.append(!this.partsTxt.val)
  !array.append(!this.partsCsv.val)
  !array.append(!this.partsXls.val)
  !array.append(object FILE(!this.outputFolder.val))
  !array.append(!this.deptRootName.val)
  !array.append(object FILE(!this.logFolder.val))
  !array.append(object FILE(!this.batchFolder.val))
  !array.append(!this.linkDescRule.val)
  !array.append(!this.settings.considerStatus)
  !array.append(!this.settings.statusAttribute)
  !array.append(!this.settings.detailStatusAt)

  return !array

endmethod
-- End of method definition for .getSettings()

------------------------------------------------------------------------
--
-- Method:        .getTemplates()
--
-- Description:   Get drawing template elements
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTemplates()

  -- Initialise variables
  !this.allDrtmlb.clear()

  -- Get all drawing template libraries with the passed purpose
  -- Each library relates directly to a drawing type
  VAR !allLiby COLL ALL DRTMLB $!<this.settings.libraryRule>

  -- Build the object for each found library
  do !liby val !allLiby
    !this.allDrtmlb.append(object ASSYDRWGDRTMLB(!liby.dbref(), !this.settings.descAttribute))
  enddo

endmethod
-- End of method definition for .getTemplates()

------------------------------------------------------------------------
--
-- Method:      .restore()
--
-- Description: Reset form to original values
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .restore()

  -- Get the main configuration object
  !this.settings = !!assyDrwgMain.assyDrwgApp.config

  -- Get all relevant existing drawing templates & label libraries
  !this.getTemplates()
  !this.getLalb()

  -- Set form gadget values from the settings object
  !this.setGadgets()

  -- Set form as unmodified
  !this.setModified(false)

endmethod
-- End of method definition for .restore()

-----------------------------------------------------------------------
--
-- Method:      .save()
--
-- Description: Save the complete configuration to the main object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .save()

  -- Save these configuration settings to the main application
  !!assyDrwgMain.init()

  -- Save to file
  !this.settings.write()

  -- Mark the form as unmodified
  !this.setModified(false)

endmethod
-- End of method .save()

-----------------------------------------------------------------------
--
-- Method:      .saveSettings()
--
-- Description: Save form settings to form object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveSettings()

  -- Run the settings object save
  !this.settings.save(!this.getSettings())

  -- Mark the form as modified
  !this.setModified(true)

endmethod
-- End of method .saveSettings()

-----------------------------------------------------------------------
--
-- Method:      .selSize()
--
-- Description: Select the sizes for the selected drawing type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selSize()

  -- Set gadget text
  !this.preferredSize.dtext = !this.allDrtmlb[!this.preferredType.val].getSizes()

  -- Attempt to select the default setting
  if (!this.preferredSize.dtext.find(!this.settings.preferredSize).set()) then
    !this.preferredSize.select('DTEXT', !this.settings.preferredSize)
  endif

endmethod
-- End of method .selSize()

-----------------------------------------------------------------------
--
-- Method:      .setGadgets()
--
-- Description: Set the form gadgets to the configuration settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setGadgets()

  -- Assembly purpose
  !this.assemblyPurp.val    = !this.settings.assemblyPurp

  -- Department root name
  !this.deptRootName.val    = !this.settings.deptRootName

  -- Whether to create a drawing
  !this.createDrawing.val   = !this.settings.createDrawing

  --Search rule for DRTMLB elements
  !this.libraryRule.val     = !this.settings.libraryRule

  -- Drawing Types and select preferred type
  !this.preferredType.dtext = !this.getDrawingTypes()
  if (!this.preferredType.dtext.find(!this.settings.preferredType).set()) then
    !this.preferredType.select('DTEXT', !this.settings.preferredType)
  endif

  -- Preferred size
  !this.selSize()

  -- Drtmpl attributes
  if (defined(!this.allDrtmlb[1].alldrtmpl[1])) then
    !this.drtmlbAtt.dtext   = !this.allDrtmlb[1].alldrtmpl[1].reference.attlist
    if (!this.drtmlbAtt.dtext.find(!this.settings.descAttribute).set()) then
      !this.drtmlbAtt.select('DTEXT', !this.settings.descAttribute)
    endif
  else
    !dtext[1]               = 'None'
    !this.drtmlbAtt.dtext   = !dtext
  endif

  -- Attribute to hold drawing number
  VAR !allDrwg COLL ALL DRWG
  if (defined(!allDrwg[1])) then
    !this.drgNoAtt.dtext    = !allDrwg[1].dbref().attlist
    if (!this.drgNoAtt.dtext.find(!this.settings.drgNoAttribute).set()) then
      !this.drgNoAtt.select('DTEXT', !this.settings.drgNoAttribute)
    endif
  else
    !dtext[1]               = 'None'
    !this.drgNoAtt.dtext    = !dtext
  endif

  -- Create a PDF output file
  !this.drawingPdf.val      = !this.settings.drawingPdf

  -- Folder location for PDF output file
  !this.pdfFolder.val       = !this.settings.drawingDirectory.string()

  -- Create a Parts List
  !this.createPartsList.val = !this.settings.createPartsList

  -- Search rule for LALB elements
  !this.partsListRule.val   = !this.settings.partsListRule

  -- Parts list type and select preferred type
  !this.preferredPart.dtext = !this.getLalbNames()
  if (!this.preferredPart.dtext.find(!this.settings.preferredPart).set()) then
    !this.preferredPart.select('DTEXT', !this.settings.preferredPart)
  endif

  -- Lalb attributes
  if (defined(!this.allLalb[1])) then
    !this.lalbAtt.dtext     = !this.allLalb[1].reference.attlist
    if (!this.lalbAtt.dtext.find(!this.settings.partsListDesc).set()) then
      !this.lalbAtt.select('DTEXT', !this.settings.partsListDesc)
    endif
  else
    !dtext[1]               = 'None'
    !this.lalbAtt.dtext     = !dtext
  endif

  !this.asmblyAttRule.val   = !this.settings.asmblyAttRule
  !this.partsAttRule.val    = !this.settings.partsAttRule
  !this.partsTxt.val        = !this.settings.partsListTxt
  !this.partsCsv.val        = !this.settings.partsListCsv
  !this.partsXls.val        = !this.settings.partsListXls
  !this.outputFolder.val    = !this.settings.partsListDir.string()

  -- Link doc rule
  !this.linkDescRule.val    = !this.settings.linkDescRule

  !this.logFolder.val       = !this.settings.logFileDir.string()
  !this.batchFolder.val     = !this.settings.batchFileDir.string()

endmethod
-- End of method .setGadgets()

------------------------------------------------------------------------
--
-- Method:        .setModified(BOOLEAN)
--
-- Description:   Set this form modified status
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether modified or not
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setModified(!modified is BOOLEAN)

  -- Set modified status
  !this.modified  = !modified

  -- Set title
  if (!modified) then
    !this.formTitle = !this.titleString & '*'
  else
    !this.formTitle = !this.titleString
  endif

endmethod
-- End of method definition for .setModified(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .setOutput(STRING,GADGET)
--
-- Description:   Set file to that returned from the file browser and save the report
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Directory pathname returned from the browser
--    2   R      GADGET      Gadget to receive the selected file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setOutput(!directory is STRING,!gadget is GADGET)

  -- Set the gadget
  !gadget.val = !directory

endmethod
-- End of method definition for .setFile(STRING,STRING)

------------------------------------------------------------------------
--
-- Method:        .setType()
--
-- Description:   Set the chosen type of drawing template
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setType()

  -- Save the settings
  !this.saveSettings()

  -- Display the available sheet sizes
  !this.preferredSize.dtext = !this.allDrtmlb[!this.preferredType.val].getSizes()

endmethod
-- End of method definition for .setType()
