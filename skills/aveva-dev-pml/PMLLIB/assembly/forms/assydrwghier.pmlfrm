-- Created:         13 Feb 2006
--
--
-- Description:
-- The main form for creating Assembly hierarchy
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  accept()                         -                   Accept elements
--  assyDrwgHier()                   -                   Constructor method
--  cancel()                         -                   Cancel this form
--  ce()                             -                   Use the current DEPT for creating the REGI
--  checkName(STRING,GADGET)         BOOLEAN             Check the entered name
--  close()                          -                   Close the form
--  create(STRING)                   -                   Create elements
--  getName(STRING)                  STRING              Determine starting element name
--  init()                           -                   Method to initialise the form
--  setAttr(STRING)                  -                   Call the standard appware for setting the relevant attributes
--  setAutoRegi(GADGET)              -                   Set auto-create registry gadgets to required state
--
------------------------------------------------------------------------
setup form !!assyDrwgHier dialog

  -- Form members
  !this.formtitle     = 'Create Assembly Hierarchy'
  !this.callback      = '!this.init()'
  !this.cancelCall    = '!this.cancel()'
  !this.quitCall      = '!this.close()'

  -- Department
  para   .pDept            at x0.5     ymin text 'Department:'
  text   .deptName         at xmin+0.5 ymax width 32 scroll 90 STRING
  button .dCreate 'Create' at xmax+0.5 ymin tooltip 'Create Department '
  button .dCe     'CE'     at xmax+0.1 ymin tooltip 'Use current Department '

  toggle .rAuto 'Automatically Create Registry' at xmin.deptName+5 ymax+0.3

  button .dAttr 'Attributes' at xmax form-size ymin tooltip 'Department Attributes '

  -- Registry
  para   .pRegi            at x0.5     ymax+0.1 text 'Registry:  '
  text   .regiName         at xmin+0.5 ymax width 32 scroll 90 STRING
  button .rCreate 'Create' at xmax+0.5 ymin tooltip 'Create Registry '

  button .rAttr 'Attributes' at xmax form-size ymax+0.3 tooltip 'Registry Attributes '

  -- Line
  frame .line at x0 ymax+0.5 width 47
  exit

  -- OK and Cancel
  button .ok     'OK'     at x0.5         ymax+0.2 ok
  button .cancel 'Cancel' at xmax form-size ymin

  -- Form members
  member .deptFullname is STRING
  member .deptRefe     is DBREF
  member .regiFullname is STRING
  member .regiRefe     is DBREF
  member .created      is ARRAY

exit

------------------------------------------------------------------------
--
-- Method:      .assyDrwgHier()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyDrwgHier()

  -- Form callbacks
  !this.dCreate.callback  = '!this.create(|DEPT|)'
  !this.dCe.callback      = '!this.ce()'
  !this.rAuto.callback    = '!this.setAutoRegi(!this.rAuto)'
  !this.dAttr.callback    = '!this.setAttr(|DEPT|)'
  !this.rCreate.callback  = '!this.create(|REGI|)'
  !this.rAttr.callback    = '!this.setAttr(|REGI|)'
  !this.ok.callback       = '!this.accept()'
  !this.cancel.callback   = '!this.cancel()'

endmethod
-- End of method definition for .assyDrwgHier()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Find a department and registry offered name
  !this.deptName.val = !this.getName('DEPT')
  !this.regiName.val = !this.getName('REGI')

  -- Set auto-create registry to on
  !this.rAuto.val = true
  !this.setAutoRegi(!this.rAuto)

  -- Set attribute gadget active status
  !this.dCreate.active = true
  !this.dAttr.active   = false
  !this.rAttr.active   = false

  -- Clear created array
  !this.created.clear()

endmethod
-- End of method .init()

------------------------------------------------------------------------
--
-- Method:      .accept()
--
-- Description: Accept elements
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .accept()

  -- Update the main assembly object to include the new elements
  !!assyDrwgMain.assyDrwgApp.getDept()

  -- For a shown main form update the gadgets
  if (!!assyDrwgMain.shown()) then
    !!assyDrwgMain.setGadget()
  endif

  -- Check for a shown assembly main form
  if (!!assyDrwgMain.shown()) then
    !!assyDrwgMain.setDept()
    !!assyDrwgMain.setRegi()
  endif

  -- Update the main toolbar
  !!assyDrwgMain.assyDrwgApp.setActive()

  -- Activate the toolbar and main menu option if not already active
  if (!!assyDrwgMain.assyDrwgApp.active.not()) then
    !!assyDrwgMain.assyDrwgApp.active(true)
    !!assyDrwgMain.assyDrwgApp.setDefaults()
  endif

endmethod
-- End of method .accept()

------------------------------------------------------------------------
--
-- Method:      .ce()
--
-- Description: Use the current DEPT for creating the REGI
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ce()

  -- Try to get to a DEPT
  DEPT
    handle (2,111)
      -- Cannot access element type DEPT from the level of...
      !!alert.error('Cannot access a Department from this position in the hierarchy. Please select one and try again.')
      return
    endhandle

  -- Set the create button inactive
  !this.dCreate.active  = false

  -- Set the text gadget to reflect the current department element
  !this.deptName.val    = !!ce.flnn
  !this.deptFullname    = !!ce.flnm

  -- Get the REGI name
  !name                 = !!assyBuildName('REGI', !this.deptFullname & '/', true)
  !this.regiName.val    = !name.substring(2)
  !this.regiFullname    = !name

  -- Set Auto create regi off
  !this.rAuto.val       = false

  -- Make attribute, name and create regi gadgets active
  !this.regiName.active = true
  !this.rAttr.active    = true
  !this.rCreate.active  = true

endmethod
-- End of method .ce()

------------------------------------------------------------------------
--
-- Method:      .checkName(STRING,GADGET)
--
-- Description: Check the entered name
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name string
--    2   R      GADGET      Gadget making the request
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN      Check if name (DEPT or REGI) already exists (FALSE)
--
------------------------------------------------------------------------
define method .checkName(!name is STRING, !gadget is GADGET) is BOOLEAN

  -- Trim any leading or trailing blanks
  !entered = !name.trim('LR')

  -- Check for leading slash character
  if (!entered.substring(1,1).eq('/')) then
    !fullName    = !entered
    !noSlashName = !entered.substring(2)

  -- Add a leading slash character
  else
    !fullName    = '/' & !entered
    !noSlashName = !entered
  endif

  -- Check name exists
  VAR !exists EXIST $!fullName
  if (!exists.eq('TRUEA')) then
    !!alert.error('The name you have entered already exists. Please try again.')
    return false
  endif

  -- Store element name
  if (!gadget.name().eq('DEPTNAME')) then
    !this.deptFullname = !fullName
  else
    !this.regiFullname = !fullName
  endif

  -- Display the name
  !gadget.val = !noSlashName

  return true

endmethod
-- End of method definition for .checkName()

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      PADD
--                           DESI
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  -- Delete the created elements
  if (!this.created.set()) then

    -- Check with user
    !answer = !!alert.confirm('Are your sure you want to remove all created elements?')

    -- For each created element
    do !elemRefe val !this.created

      -- Check whether element has not been deleted outside of this form
      if (!elemRefe.badref().not()) then

        if (!answer.eq('YES')) then

          !!ce = !elemRefe

          DELETE $!!<ce.type>

          !this.close()

        endif

      else
        !this.close()
      endif

    enddo

  else
    !this.close()
  endif

endmethod
-- End of method .cancel()

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- Update the application object with departments
  !!assyDrwgMain.assyDrwgApp.getDept()

  -- Update the department toolbar
  !!assyDrwgMain.assyDrwgApp.setActive()

  -- Close this form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      .create(STRING)
--
-- Description: Create elements
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      DEPT
--                           REGI
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .create(!elemType is STRING)

  -- Initialise variables
  !session = CURRENT SESSION

  -- Check db is open in RW
  if (!session.mode()[!session.current().findFirst(object DB(!!ce.dbname))].neq('RW')) then
    !!alert.error('You do not have permission to create a new department in this database. Please access a suitable db and try again')
    return
  endif

  -- Get the assembly purpose from the configuration settings
  !assemblyPurp = !!assyDrwgMain.assyDrwgApp.config.assemblyPurp

  -- Access PADD db if necessary
  if (!!ce.dbType.upcase().neq('PADD')) then
    CONTEXT DRAWING
  endif

  -- Create department
  if (!elemType.eq('DEPT')) then
    if (!this.checkName(!this.deptName.val,!this.deptName).not()) then
       return
    endif

    -- Initialise variables
    !name = !this.deptFullname

    NEW DEPT $!name
     SPPURP $!assemblyPurp
     FUNC 'Assembly Drawings'

    -- Initialise variables
    !this.deptRefe = !!ce
    !elemRefe      = !!ce

    -- Make attribute gadget active
    !this.dAttr.active = true

    -- Prevent another dept being created
    !this.dCreate.active = false

    -- For auto creation of a registry
    if (!this.rAuto.val) then
      !this.create('REGI')
    else
      !this.setAutoRegi(!this.rAuto)
    endif


  -- Create registry
  elseif (!elemType.eq('REGI')) then
    if (!this.checkName(!this.regiName.val,!this.regiName).not()) then
       return
    endif

    -- Initialise variables
    !name = !this.regiFullname

    -- Test for DEPT members, and hence force creation point at the end
    if (!!ce.mem.size().gt(0)) then
      LAST MEM
    endif

    NEW REGI $!name
     SPPURP $!assemblyPurp
     FUNC 'Assembly Drawings'

    -- Initialise variables
    !this.regiRefe = !!ce
    !elemRefe      = !!ce

    -- Make attribute and name gadgets active
    !this.regiName.active = true
    !this.rAttr.active    = true

    -- Prevent another regi being created
    !this.rCreate.active = false

  endif

  -- Add element to created array
  !this.created.append(!elemRefe)

endmethod
-- End of method definition for .create(STRING)

-----------------------------------------------------------------------
--
-- Method:      .getName(STRING)
--
-- Description: Determine starting element name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      Element type either DEPT or REGI
--
------------------------------------------------------------------------
define method .getName(!elemType is STRING) is STRING

  -- Get the root name from the configuration settings
  !rootName = !!assyDrwgMain.assyDrwgApp.config.deptRootName

  -- Store name
  if (!elemType.eq('DEPT')) then
    !name              = !!assyBuildName(!elemType, !rootName, true)
    !this.deptFullname = !name
  else
    !name              = !!assyBuildName(!elemType, !this.deptFullname & '\', true)
    !this.regiFullname = !name
  endif

  -- Return the name without the slash
    return !name.substring(2)

endmethod
-- End of method .getName(STRING)

-----------------------------------------------------------------------
--
-- Method:      .setAttr(STRING)
--
-- Description: Call the standard appware for setting the relevant attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .setAttr(!option is STRING)

  -- Load dependant objects and forms
  if (undefined(!!cdrdeptatt)or undefined(!!cdrregiatt)) then

    -- Global objects
    if (undefined(!!backHandler)) then
      !!backHandler = object DRABACKHANDLER()
    endif
    if (undefined(!!draColStyle)) then
      !!draColStyle = object DRACOLSTYLEHANDLER()
    endif
    if (undefined(!!fontManager)) then
      !!fontManager = object ADMFONTMANAGER()
    endif

    -- Forms
    if (undefined(!!cdrdfltsheet)) then
      $M "%PDMSUI%\dra\gen\fdfltsheet"
    endif
    if (undefined(!!cdrudflts)) then
      $M "%PDMSUI%\dra\gen\fudflts"
    endif
    if (undefined(!!cdrdeptatt)) then
      $M "%PDMSUI%\dra\gen\fdeptatt"
    endif
    if (undefined(!!cdrregi)) then
   	  $M "%PDMSUI%\dra\gen\fregi"
    endif
    if (undefined(!!cdrregiatt)) then
   	  $M "%PDMSUI%\dra\gen\fregiatt"
    endif
      	      	      	
  endif

  -- For a department
  if (!option.eq('DEPT')) then

    -- Test the dept reference
    if (!this.deptRefe.badref()) then

      !!alert.warning('The Department has been deleted. This form is being refreshed.')
      !this.init()
      return

    else

      -- Access the department
      !!ce = !this.deptRefe

      -- Call dept attribute form
      show !!cdrdeptatt

    endif

  -- For a registry
  else

    -- Test the regi reference
    if (!this.regiRefe.badref()) then

      -- User warning
      !!alert.warning(|The Registry has been deleted. Please press the 'Create' button to recreate it or 'Cancel' to quit.|)

      -- Set gadgets active status
      !this.rCreate.active = true
      !this.rAttr.active = false

      return

    else

      -- Access the department
      !!ce = !this.regiRefe

      -- Call regi attribute form
      show !!cdrregiatt

    endif
  endif

endmethod
-- End of method .setAttr(STRING)

-----------------------------------------------------------------------
--
-- Method:      .setAutoRegi(GADGET)
--
-- Description: Set auto-create registry gadgets to required state
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Toggle gadget being set
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAutoRegi(!gadget is GADGET)

  -- For auto on
  if (!gadget.val) then

    !this.pRegi.active    = false
    !this.regiName.active = false
    !this.rCreate.active  = false

  else

    !this.pRegi.active    = true
    !this.regiName.active = true
    !this.rCreate.active  = true

  endif

endmethod
-- End of method .setAutoRegi(GADGET)
