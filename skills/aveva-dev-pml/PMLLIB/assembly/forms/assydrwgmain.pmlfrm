endmethod
-- End of method .cancel()

------------------------------------------------------------------------
--
-- Method:      .ce()
--
-- Description: Set form to report on the current element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ce()

  -- Initialise variables
  !type = !!ce.hardType.upcase()

  -- Check current element is world, group world or assembly
  if (!type.neq('WORL') and !type.neq('ASWL') and !type.neq('ASMBLY')) then

    -- User warning
    !!alert.warning('Cannot report assemblies from this position in the hierarchy')

    -- Give a list of things they can report from?

  endif

  -- Add ce
  !this.ceRefe   = !!ce
  !this.ceName.val = !this.ceRefe.flnn

endmethod
-- End of method definition for .ce()

------------------------------------------------------------------------
--
-- Method:      .ce(DBREF)
--
-- Description: Set form to report on the current element
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ce(!element is DBREF)

  -- Add ce
  !this.ceRefe     = !element
  !this.ceName.val = !this.ceRefe.flnn

endmethod
-- End of method definition for .ce(DBREF)

------------------------------------------------------------------------
--
-- Method:      .ceRegi()
--
-- Description: Add current regi element to the list of registries
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .ceRegi()

  -- Check that the element is a registry
  if (!!ce.hardType.upcase().neq('REGI')) then
    !!alert.warning('You can only add REGI elements. Please try again.')
    return
  endif

  -- Check if the registry is marked for assemblies
  if (!!ce.spPurp.neq(!this.assyDrwgApp.config.assemblyPurp)) then
    !answer = !!alert.confirm('The selected Registry is not marked for Assembly use. Do you wish to continue?')
    if (!answer.eq('NO')) then
      return
    endif
  endif

  -- Add the selected registry to the object list
  !this.assyDrwgApp.addDept(!!ce)

  -- Update this form
  !this.setGadget()

  -- Select the chosen registry parent department
  !this.adDept.select('RTEXT',!!ce.owne.string())

  -- Select the chosen registry
  !this.selRegi()
  !this.adRegi.select('RTEXT',!!ce.string())

endmethod
-- End of method definition for .ceRegi()

------------------------------------------------------------------------
--
-- Method:      .checkFile(GADGET)
--
-- Description: Check the entered file
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget making the call
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkFile(!gadget is GADGET)

  -- Set file object
  if (!gadget.name().eq('ADFOLD')) then
    !this.drwgFolder = object FILE(!gadget.val)
  else
    !this.partFolder = object FILE(!gadget.val)
  endif

  -- Save settings
  !this.saveSettings()

endmethod
-- End of method definition for .checkFile(GADGET)

------------------------------------------------------------------------
--
-- Method:      .checkName()
--
-- Description: Check the entered name
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkName()

  -- Initialise variables
  !entered  = !this.ceName.val

  -- Trim any leading or trailing blanks
  !entered = !entered.trim('LR')

  -- Get leading character
  !leadChar = !entered.substring(1,1)

  -- Check for leading slash
  if (!leadChar.neq('=') and !leadChar.neq('/')) then
    !fullName    = '/' & !entered
    !noSlashName = !entered
  else
    !fullName    = !entered
    !noSlashName = !entered.substring(2)
  endif

  -- Check name exists
  VAR !exists EXIST $!fullName
  if (!exists.eq('FALSEA')) then
    !!alert.error('The name you have entered is not valid. Please check and try again.')
    return
  endif

  -- Add ce
  !this.ceRefe = !fullName.dbref()

  -- Check for leading equals
  if (!leadChar.eq('=')) then
    !noSlashName = !this.ceRefe.flnn
  endif

  -- Display name
  !this.ceName.val = !noSlashName

endmethod
-- End of method definition for .checkName()

------------------------------------------------------------------------
