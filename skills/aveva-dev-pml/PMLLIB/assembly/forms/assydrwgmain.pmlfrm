--
-- Description:
-- The main form for creating Assembly Planning deliverables
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyDrwgMain()                   -                   Constructor method
--  browse(FILE)                     -                   Start windows browser for output
--  browser(GADGET)                  -                   Show standard browser
--  cancel()                         -                   Cancel this form
--  ce()                             -                   Set form to report on the current element
--  ce(DBREF)                        -                   Set form to report on the current element
--  ceRegi()                         -                   Add current regi element to the list of registries
--  checkFile(GADGET)                -                   Check the entered file
--  checkName()                      -                   Check the entered name
--  close()                          -                   Close the form
--  deselectAll()                    -                   Deselect all selections in the grid
--  display()                        -                   Display the selected items
--  display3D()                      -                   Display the selected assembly in 3D
--  getColNumbs()                    ARRAY               Get columns numbers for DRAWN & MODE depending on whether status is used
--  goToAsmbly()                     -                   Navigate to the assembly
--  init()                           -                   Method to initialise the form
--  netAfterSelectChange(ARRAY)      -                   Callback on grid control after select change
--  netBeforeCellUpdate(ARRAY)       -                   Callback on grid control before cell update
--  netPopup(ARRAY)                  -                   Pop-up for grid control
--  processNow()                     -                   Create drawings now
--  refresh()                        -                   Refresh the grid to use the modified data
--  remove(STRING)                   -                   Remove assemblies from the detail list
--  runSearch()                      -                   Run the report
--  saveSettings()                   -                   Save key form settings to main object
--  saveToFile()                     -                   Save report to file
--  selAll()                         -                   Select all entries in the grid control
--  selDept()                        -                   Set the registries for the selected department
--  selLalb()                        -                   Select the label libraries
--  selRegi()                        -                   Select the chosen registry
--  selSize()                        -                   Select the sizes for the selected drawing type
--  setDept()                        -                   Select the departments
--  setDisplay()                     -                   Set whether drawings should be displayed when picked
--  setDisplay(BOOLEAN)              -                   Set whether drawings should be displayed when picked
--  setExcel(FILE)                   -                   Set file to that returned from the file browser and save the report to excel
--  setFile(FILE)                    -                   Set file to that returned from the file browser and save the report
--  setGadget()                      -                   Set gadgets to the configuration settings
--  setIcon(REAL,ARRAY)              -                   Set the specified column cell icons
--  setOutput(STRING,GADGET)         -                   Set file to that returned from the file browser
--  setRegi()                        -                   Select the registries for the selected department
--  showBatch()                      -                   Start batch macro form
--  switchMode(STRING)               -                   Switch to a particular mode
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!assyDrwgMain dialog dock right

  -- Form members
  !this.formtitle     = 'Assembly Planning Deliverables'
  !this.callback      = '!this.init()'
  !this.cancelCall    = '!this.cancel()'
  !this.quitCall      = '!this.close()'

  -- Assembly element below which to search
  para   .eTitle  anchor left + top         at x0.5     ymin text 'Assembly element to search under:'
  text   .ceName  anchor left + right + top at xmin     ymax width 44 scroll 90 STRING
  button .ce 'CE' anchor right + top        at xmax+0.5 ymin tooltip 'Current Element '

  -- Filter the search
  para   .foPara at x0.5 ymax+0.2 text 'Filter the assemblies for:'
  option .filterOption anchor top + left + right at xmin ymax width 37
  button .search 'Search' anchor top + right at xmax+1.2 ymin

  -- Assembly List for processing
  container .netFrame PMLnetCONTROL 'net' anchor left + right + top at x0 ymax+0.5 width 50 height 15

  -- Location for drawing element
  para   .adLoc  anchor left + top  at x0.5  ymax+0.5 text 'Create drawings in this location'
  option .adDept 'Dept' anchor left + right + top  at xmin+0.5 ymax+0.1 tooltip 'In which Department? ' width 35
  option .adRegi 'Regi' anchor left + right + top  at xmin     ymax+0.3 tooltip 'In which Registry? '   width 35
  button .adHier      tooltip 'Create Department '        anchor right + top at xmax.adDept+0.6 ymin.adDept pixmap width 16 height 16
  button .adCe   'CE' tooltip 'Use the current Registry ' anchor right + top at xmax.adRegi+0.6 ymin.adRegi

  line  .drLine anchor left + right + top  at x0 ymax horizontal width.netFrame height 1

  -- Process
  para   .procWord          anchor left + top    at x0.5     ymax text 'Process'
  button .procNow   'Now'   anchor right + top   at xmax+0.5 ymin tooltip 'Create Drawing Now '
  button .procBatch 'Batch' anchor right + top   at xmax+0.5 ymin tooltip 'Write a Batch Macro '

--  button .saveToFile  anchor right + top  at xmax+15 ymin  tooltip 'Save Detail List to Text File  ' pixmap width 19 height 19
  button .saveToExcel anchor right + top  at xmax+15  ymin  tooltip 'Save Detail List to Excel File ' pixmap width 19 height 19

  -- Assembly Drawing
  frame .assemblyDrawing foldUpPanel 'Drawing'  anchor left + top + right at x0 ymax+0.4 width.netFrame

    toggle .assyDrwg 'Create Drawing' at x0.5 ymax-0.3

    option .adType   'Type' anchor left + right + top  at xmin+0.5 ymax+0.2 tooltip 'Create which Type? '  width 40
    option .adSize   'Size' anchor left + top          at xmin     ymax+0.3 tooltip 'With what Size? '     width 4

    toggle .drawingPDF 'Output PDF' at x1.5 ymax+1.5
    button .browsePDF at xmax-2 ymin tooltip 'Browse for PDF files' pixmap width 16 height 16

    para   .view  anchor left + top at xmax.adSize+15 ymin.adSize pixmap width 140 height 100

    para   .adFile   anchor left + top          at xmin.adSize ymax-0.5 text 'Create PDF files in this location'
    text   .adFold   anchor left + right + top  at xmin+0.5    ymax+0.1 tooltip 'In which Folder? ' width 44 scroll 90 STRING

    button .adBrowse tooltip 'Browse Folders ' anchor right + top at xmax.adFold+0.2 ymin.adFold+0.1 pixmap width 16 height 16

  exit

  -- Parts List
  frame .partsList foldUpPanel 'Parts List' anchor left + top + right at x0 ymax.assemblyDrawing width.assemblyDrawing

    toggle .partsLst 'Create Parts List' at x0.5 ymax-0.3

    option .plTmpl 'Type' anchor left + right + top at xmin+0.5 ymax+0.2 tooltip 'Create which Type? ' width 40

    frame .plFrame ' Output Formats ' anchor left + right + top  at x6 ymax+0.5 width 32

      toggle .partsTxt '.txt' at x2     ymin
      toggle .partsCsv '.csv' at xmax+1 ymin
      toggle .partsXls '.xls' at xmax+1 ymin

    exit

    button .browseParts tooltip 'Browse for Parts List files' anchor right + top at xmax ymin+0.7pixmap width 16 height 16

    para .plFile  anchor left + top         at xmin.plTmpl ymax+0.7 text 'Create parts list in this location'
    text .plFold  anchor left + right + top at xmin+0.5    ymax+0.1 tooltip 'In which Folder? ' width 44 scroll 90 STRING

    button .plBrowse tooltip 'Browse Folders' anchor right + top  at xmax.plFold+0.2 ymin+0.1 pixmap width 16 height 16

  exit

  -- Members
  member .saveFile     is FILE
  member .saveExcel    is FILE
  member .ceRefe       is DBREF
  member .asmblyData   is ASMBLYDATA
  member .exState      is BOOLEAN
  member .displayDrwg  is BOOLEAN
  member .assyDrwgApp  is ASSYDRWGAPPLICATION
  member .drwgFolder   is FILE
  member .partFolder   is FILE
  member .selectedRows is ARRAY
  member .searchFilter is STRING
  member .headings     is ARRAY

  -- My .net control
  using namespace 'Aveva.Pdms.Presentation'
  member .detailCtrl is NETGRIDCONTROL

exit

------------------------------------------------------------------------
--
-- Method:      .assyDrwgMain()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyDrwgMain()

  -- Initialise variables
  !options = ARRAY()

  -- Pixmaps
  !this.adHier.addPixmap(!!pml.getPathName('ad_t_002.png'))
--  !this.saveToFile.addPixmap(!!pml.getPathName('ad_t_010.png'))
  !this.saveToExcel.addPixmap(!!pml.getPathName('ad_t_011.png'))
  !this.browsePDF.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.adBrowse.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.browseParts.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.plBrowse.addPixmap(!!pml.getPathName('ad_t_012.png'))
  !this.view.addPixmap(!!pml.getPathName('001.png'))

  -- Define pop-up menu
  !menu = !this.newMenu('defPopUp')
    !menu.add('callback', 'Select All', '!this.selAll()')
    !menu.add('separator')
    !menu.add('callback', 'Deselect All', '!this.deselectAll()')
    !menu.add('separator')
    !menu.add('callback', 'Remove Selected', '!this.remove(|SELECTED|)')
    !menu.add('callback', 'Remove All', '!this.remove(|ALL|)')
    !menu.add('separator')
    !menu.add('callback', 'Goto Assembly', '!this.goToAsmbly()')
    !menu.add('separator')
    !menu.add('callback', 'Display Assembly', '!this.display3D()')
    !menu.add('separator')
    !menu.add('toggle', 'Display Drawing', '!this.setDisplay()')

  -- Form callbacks
  !this.adHier.callback       = '!!assyDrwgHier.show()'
  !this.ce.callback           = '!this.ce()'
  !this.ceName.callback       = '!this.checkName()'
  !this.filterOption.callback = '!this.searchFilter = !this.filterOption.selection(|RTEXT|)'
  !this.search.callback       = '!this.runSearch()'

  !this.adDept.callback       = '!this.selDept()'
  !this.adRegi.callback       = '!this.selRegi()'

  !this.procNow.callback      = '!this.processNow()'
  !this.procBatch.callback    = '!this.showBatch()'
--  !this.saveToFile.callback   = '!this.browser(!this.saveToFile)'
  !this.saveToExcel.callback  = '!this.browser(!this.saveToExcel)'

  !this.assyDrwg.callback     = '!this.saveSettings()'
  !this.adType.callback       = '!this.selSize()'
  !this.adSize.callback       = '!this.saveSettings()'
  !this.drawingPDF.callback   = '!this.saveSettings()'
  !this.browsePDF.callback    = '!this.browse(!this.drwgFolder)'
  !this.adFold.callback       = '!this.checkFile(!this.adFold)'
  !this.adCe.callback         = '!this.ceRegi()'
  !this.adBrowse.callback     = '!this.browser(!this.adFold)'

  !this.partsLst.callback     = '!this.saveSettings()'
  !this.plTmpl.callback       = '!this.saveSettings()'
  !this.partsTxt.callback     = '!this.saveSettings()'
  !this.partsCsv.callback     = '!this.saveSettings()'
  !this.partsXls.callback     = '!this.saveSettings()'
  !this.browseParts.callback  = '!this.browse(!this.partFolder)'
  !this.plFold.callback       = '!this.checkFile(!this.plFold)'
  !this.plBrowse.callback     = '!this.browser(!this.plFold)'

  -- Expanded state
  !this.assemblyDrawing.expanded = false
  !this.partsList.expanded       = false

  -- Create instance of .net control
  using namespace 'Aveva.Pdms.Presentation'
  !this.detailCtrl = object NETGRIDCONTROL()

  -- Create mode column drop-down options
  !options[1] = 'Update'
  !options[2] = 'Recreate'
  !this.detailCtrl.createValueList('Mode', !options)

  -- Add PML event handlers to .net control
  !this.detailCtrl.addeventhandler('onPopup', !this, 'netPopup')
  !this.detailCtrl.addeventhandler('afterSelectChange', !this, 'netAfterSelectChange')
  !this.detailCtrl.addeventhandler('beforeCellUpdate', !this, 'netBeforeCellUpdate')

  -- Add .net control to PML container
  !this.netFrame.control = !this.detailCtrl.handle()

  !this.detailCtrl.columnExcelFilter(false)
  !this.detailCtrl.outlookGroupStyle(false)
  !this.detailCtrl.fixedHeaders(true)
  !this.detailCtrl.fixedRows(true)
  !this.detailCtrl.gridHeight(1000.0)
  !this.detailCtrl.editableGrid(true)

endmethod
-- End of method definition for .assyDrwgMain()

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !worldRefe  = /*
  !dtext      = ARRAY()
  !rtext      = ARRAY()
  !this.headings.clear()

  -- Set defaults search point as the world
  !this.ce(!worldRefe)

  -- Display drawing when picked from the detail list
  !this.defPopUp.select('Display Drawing',true)
  !this.setDisplay(true)

  -- Set default save directory and file
  !this.saveFile  = object FILE('%PDMSUSER%\assembly report.txt')
  !this.saveExcel = object FILE('%PDMSUSER%\assembly report.xls')

  -- Load application settings
  !errors = !this.assyDrwgApp.load()
  if (!errors) then
    -- Stop when any load errors
    return
  endif

  -- Set gadgets according to the main object and configuration file settings
  !this.setGadget()

  -- Save the setting to the application main object
  !this.saveSettings()

  -- Set grid control headings
  !this.headings.append('Name')
  if (!this.assyDrwgApp.config.considerStatus) then
    !this.headings.append('Status')
  endif
  !this.headings.append('Valid')
  !this.headings.append('Drawn')
  !this.headings.append('Access')
  !this.headings.append('Mode')

  -- Set search pull-down options
  -- Set filter options
  if (!this.assyDrwgApp.config.considerStatus) then
    !dtext.append('Those ready to be drawn')
    !rtext.append('READY')
  endif
  !dtext.append('Those not drawn')
  !rtext.append('NOT DRAWN')
  !dtext.append('Those drawn')
  !rtext.append('DRAWN')
  !dtext.append('Those drawn by me')
  !rtext.append('DRAWN BY ME')
  !dtext.append('Bad Drawing Reference')
  !rtext.append('BADREF')
  !dtext.append('All Assemblies')
  !rtext.append('ALL')
  !this.filterOption.dtext = !dtext
  !this.filterOption.rtext = !rtext

  -- Read search filter option
  !this.searchFilter = !this.filterOption.selection()

endmethod
-- End of method .init()

-----------------------------------------------------------------------
--
-- Method:      .browse(FILE)
--
-- Description: Start windows browser for output
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        Folder to open
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browse(!folder is FILE)

  -- Open Windows Explorer view of the passed folder
  !command = 'explorer /root,"' & !folder.fullName() & '"'
  SYSCOM '$!command'

endmethod
-- End of method definition for .browse(FILE)

-----------------------------------------------------------------------
--
-- Method:      .browser(GADGET)
--
-- Description: Show standard browser
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget requiring the selected file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browser(!gadget is GADGET)

  import 'pmlFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Save to text file
  if (!gadget.name().eq('SAVETOFILE') or !gadget.name().eq('SAVETOEXCEL')) then

    -- Initialise variables
    !fileBrowser   = object PMLFILEBROWSER('SAVE')

    if (!gadget.name().eq('SAVETOFILE')) then

      -- Check for anything to save
      if (!this.detailCtrl.getRows().unset()) then
        !!alert.warning('There are no entries in the detail list to save!')
        return
      endif

      -- Initialise variables
      !directory       = !this.saveFile.directory().fullName()
      !seedFile        = !this.saveFile.entry()
      !title           = 'Save Assembly Report as Text'
      !extensionString = 'txt files (*.txt)|*.txt'

    -- Save to excel file
    elseif (!gadget.name().eq('SAVETOEXCEL')) then

      -- Check for anything to save
      if (!this.detailCtrl.getRows().unset()) then
        !!alert.warning('There are no entries in the detail list to save!')
        return
      endif

      -- Initialise variables
      !directory       = !this.saveFile.directory().fullName()
      !seedFile        = !this.saveExcel.entry()
      !title           = 'Save Assembly Report as Excel'
      !extensionString = 'xls files (*.xls)|*.xls'

    endif

    -- Show Browser
    !fileBrowser.show(!directory, !seedFile, !title, false ,!extensionString , 2)

    -- Test for no returned file name
    if (!fileBrowser.file().neq('')) then

      -- Write the output file
      if (!gadget.name().eq('SAVETOFILE')) then

        !this.setFile(object FILE(!fileBrowser.file()))

      elseif (!gadget.name().eq('SAVETOEXCEL')) then

        !this.setExcel(object FILE(!fileBrowser.file()))

      endif

    endif

  else

    -- Initialise variables
    !folderBrowser = object PMLFOLDERBROWSER()

    -- Show the folder browser
    !folderBrowser.show('Select Output Folder',true)

    -- Use the selected folder
    !this.setOutput(!folderBrowser.selectedPath(), !gadget)
    !this.checkFile(!gadget)

  endif

  -- Save settings
  !this.saveSettings()

endmethod
-- End of method .browser(GADGET)

-----------------------------------------------------------------------
