endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      .deselectAll()
--
-- Description: Deselect all selections in the grid
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deselectAll()

  !this.detailCtrl.clearRowSelection()

endmethod
-- End of method definition for .deselectAll()

------------------------------------------------------------------------
--
-- Method:      .display()
--
-- Description: Display the selected items
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW]  [Data Type]  [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display()

  -- Test menu option
  if (!this.displayDrwg and !this.detailCtrl.getSelectedRowTags().empty().not()) then

    -- If more than one then take the first that has an associated drawing
    -- Get index of selected element in the array
    !index = !this.detailCtrl.getSelectedRowTags()[1].real()

    -- For an drawn assembly
    if (!this.asmblyData.dwgRefs[!index].badref()) then

      -- Test for an associated drawing
      if (!this.asmblyData.drawn[!index].upcase().match('YES').neq(0)) then
        !!alert.message(|The DRWG | & |'| & !this.asmblyData.dwgNames[!index] & |'| & | has been deleted.|)
      endif

    else

      -- Get first sheet
      !drwgRefe = !this.asmblyData.dwgRefs[!index]

      !sheeRefe = object DBREF()
      !sheeRefe = SHEE 1 OF $!drwgRefe
      handle any
      endhandle

      -- Check if already loaded

      -- Get to padd db commands
      !this.switchMode('PADD')

      -- Put sheet into the main Draft display
      !this.assyDrwgApp.module.displaySheet(!sheeRefe)

    endif

  endif

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      .display3D()
--
-- Description: Display the selected assembly in 3D
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display3D()

  -- Clear design drawlist
  DESREM ALL

  -- Test for model view form
  if (undefined(!!assyModelView)) then
    pml load form !!assyModelView
  endif

  -- Load 3D autocolours
  !!assyAutoColour()

  -- Initialise variable
  !gphView = object GPHVIEWS()
  !view    = !!assyModelView.view

  -- For multiple selections goto the first asmbly
  -- Get index of selected element in the array
  !index = !this.detailCtrl.getSelectedRowTags()[1].real()

  -- Find the assembly in the data object
  !asmblyRefe = !this.asmblyData.dbRefes[!index]

  -- Add asmbly to view
  DESADD $!asmblyRefe
    handle (16,212)
      -- Not a usable item
    endhandle

  -- Calculate volume
  !volume    = object VOLUME(!asmblyRefe)

  -- Test for unset volume i.e. no limits, probably an empty asmbly
  if (!volume.from.unset() or !volume.to.unset()) then
    if (!asmblyRefe.sexpnd.size().eq(0)) then
      !!alert.message('The ASMBLY cannot be displayed because it does not contain any elements')
    else
      !!alert.message('The ASMBLY cannot be displayed because it does not have any limits')
    endif
    return
  else

    -- Model view limits
    !gphView.limits(!view, !volume)

    -- Set shaded graphics
    !!assyModelView.view.shaded = true

    -- Set iso as default view dir

    -- Display the model view form
    if (!!assyModelView.shown().not()) then
      !!assyModelView.show()
    endif

  endif

endmethod
-- End of method definition for .display3D()

------------------------------------------------------------------------
--
-- Method:      .getColNumbs()
--
-- Description: Get columns numbers for DRAWN & MODE depending on whether status is used
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] The number for the column which contains the drawn values
--                [2] The number for the column which contains the mode values
--
------------------------------------------------------------------------
define method .getColNumbs() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- If status is used
  if (!this.assyDrwgApp.config.considerStatus) then
    !drawnIndex = 4
    !modeIndex  = 6

  else
    !drawnIndex = 3
    !modeIndex  = 5
  endif

  -- Build array
  !array.append(!drawnIndex)
  !array.append(!modeIndex)

  return !array

endmethod
-- End of method definition for .getColNumbs()

------------------------------------------------------------------------
--
-- Method:      .goToAsmbly()
--
-- Description: Navigate to the assembly
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .goToAsmbly()

  -- For multiple selections goto the first
  -- Get index of selected element in the array
  !index = !this.detailCtrl.getSelectedRowTags()[1].real()

  -- Find the assembly in the data object
  !asmblyRefe = !this.asmblyData.dbRefes[!index]

  -- Access the assembly
  if (!asmblyRefe.badref()) then
    !!alert.message(|The ADSMBLY | & |'| & !this.asmblyData.names[!index] & |'| & | has been deleted since the report was made.|)
  else
    !!ce = !asmblyRefe
  endif

endmethod
-- End of method definition for .goToAsmbly()

------------------------------------------------------------------------
--
-- Method:      .netAfterSelectChange()
--
-- Description: Callback on grid control after select change
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelectChange(!array is ARRAY)

  -- Display a drawing if it exists
  !this.display()

endmethod
-- End of method definition for .netAfterSelectChange()

------------------------------------------------------------------------
--
-- Method:      .netBeforeCellUpdate()
--
-- Description: Callback on grid control before cell update
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      STRING      The new value selected from the option list
--    3   R      BOOLEAN     Whether the entering value is allow
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netBeforeCellUpdate(!array is ARRAY)

  -- Test returned value is valid for this entry
  if (!array[0].upcase().neq('UPDATE') and !array[0].upcase().neq('RECREATE')) then
    !!alert.error('Invalid value. Please try again')
    !array[3] = false
  endif

endmethod
-- End of method definition for .netBeforeCellUpdate()

------------------------------------------------------------------------
--
-- Method:      .netPopup()
--
-- Description: Pop-up for grid control
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    0   R      REAL      Cursor position X
--    1   R      REAL      Cursor position Y
--    2   R      ARRAY     Array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopup(!array is ARRAY)

  -- Show the pop-up
   !this.netFrame.popup = !this.defPopUp
   !this.netFrame.showPopup(!array[0], !array[1])

  -- Return the selected elements
  !this.selectedRows = !array[2]

endmethod
-- End of method definition for .netPopup()

------------------------------------------------------------------------
--
-- Method:      .processNow()
--
-- Description: Create drawings now
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .processNow()

  -- Initialise variables
  !selected       = !this.detailCtrl.getSelectedRowTags()
  !selectedArray  = !this.detailCtrl.getSelectedRows()
  !removeArray    = ARRAY()
  !partsListFiles = ARRAY()
  !ceRefe         = !!ce

  -- Check if there is anything to produce
  if (!selected.empty()) then
    !!alert.message('There is nothing to produce! You have not chosen any assemblies.')
    return
  endif

  -- Check if there is anything to produce
  if (!this.assyDrwg.val.not() and !this.partsLst.val.not()) then
    !!alert.message('There is nothing to produce! You have chosen neither a drawing nor a parts list for output.')
    return
  endif

  -- Check if the chosen REGI has been deleted since the application was loaded
  if (!this.assyDrwgApp.drwgRegi.badref()) then
    !!alert.error('The chosen registry REGI does not exist, please reselect and try again.')
    !this.assyDrwgApp.resetDept()
    return
  endif

  -- Initiate a log file
  !!assyLog = object ASSYLOG()
  !!assyLog.initialise(!this.assyDrwgApp.config.logFileDir)

  -- Show progress form
  !!assyProgress.show('CEN',0.5,0.5)

  -- Send message
  !!assyPrompt('Processing, Please Wait...',1)

  -- Initialise variables
  !this.assyDrwgApp.clear()
  !asmblyDeleted = false

  -- Get columns numbers for DRAWN & MODE depending on whether status is used
  !colNumbs = !this.getColNumbs()

  -- Get the assemblies for detailing
  do !index ind !selected

    -- Initialise variables
    !rowArray = !selectedArray[!index]

    -- Get assembly
    !asmblyRefe = !this.asmblyData.dbRefes[!selected[!index].real()]

    -- Check if asmbly element still exists
    VAR !exists EXISTS $!asmblyRefe

    -- Alert user to a deleted assembly
    if (!exists.eq('FALSEA')) then
      !!assyLog.add('ASMBLY ' & !rowArray[1] & ' has been deleted and will therefore be ignored')
      !asmblyDeleted = true

    -- Alert the user to a lack of access rights to existing drawings
    elseif (!rowArray[!colNumbs[2]].match('No').neq(0)) then
      !!assyLog.add('You do not have access rights to modify the drawing for ASMBLY ' & !rowArray[1] & ' and it will therefore be ignored')

    -- Pass assembly element for detailing
    else
      !this.assyDrwgApp.assemblies.append(!asmblyRefe)
    endif

    -- Get update type for existing drawings
    if (!rowArray[!colNumbs[1]].match('Yes').neq(0)) then

      -- Update the drawing
      if (!rowArray[!colNumbs[2]].eq('1') or !rowArray[!colNumbs[2]].upcase().eq('UPDATE')) then
        !this.assyDrwgApp.updates.append(true)

      -- Recreate the drawing
      else
        !this.assyDrwgApp.updates.append(false)
      endif

    -- Create the drawing
    else
      !this.assyDrwgApp.updates.append(false)
    endif

  enddo

  -- Make the drawings
  if (!this.assyDrwg.val) then

    -- Get created drawings
    !dwgRefs = !this.assyDrwgApp.makeDrawings()

    -- Get the selected rows & set each with its associated drwg
    !selRows = !this.detailCtrl.getSelectedRowTags()
    do !index ind !selRows
      !this.asmblyData.dwgRefs[!selRows[!index].real()] = !dwgRefs[!index]
      !removeArray.append(!selRows[!index])
    enddo

  endif

  -- Make the separate parts List
  if (!this.partsLst.val) then
    !this.assyDrwgApp.range = 'SINGLE'
    !partsListFiles = !this.assyDrwgApp.makePartsList()
  endif

  -- Link the produced documents to the assembly
  if (!this.assyDrwg.val) then
    !this.assyDrwgApp.linkDocs(!partsListFiles)
  endif

  -- Hide the progress form
  !!assyPrompt('DISMISS',1)
  !!assyProgress.hide()
  !!fmsys.setProgress(0)

  -- Terminate the log file
  !!assyLog.stop()

  -- Store log file for a toolbar call
  !this.assyDrwgApp.log = !!assyLog

  -- Return to the original element if possible
  if (!ceRefe.badref().not()) then
    !!ce = !ceRefe
  endif

  -- Display the first drawing
  if (!this.assyDrwg.val) then

    -- Display the drawings via the search tool if available
    if (!!assyDisplay.shown()) then

      !!assyDisplay.loadDrawings(!dwgRefs)

    -- Display the first drawing directly
    else

      !this.setDisplay(true)
      !this.display()

    endif

    -- Remove the drawn assemblies if required
    if (!this.searchFilter.neq('DRAWN') and !this.searchFilter.neq('DRAWN BY ME')) then
      !this.asmblyData.remove(!removeArray, !this.assyDrwgApp.config.considerStatus)
    endif

    -- Refresh the display
    !this.refresh()

  endif

  -- Update the detail list if an assembly has been deleted
  if (!asmblyDeleted) then
    !this.runSearch()
  endif

endmethod
-- End of method definition for .processNow()

-----------------------------------------------------------------------
--
-- Method:      .refresh()
--
-- Description: Refresh the grid to use the modified data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refresh()

  -- Build row data
  !rowSet = !this.asmblyData.buildData(!this.assyDrwgApp.config.considerStatus)

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.detailCtrl.bindToDataSource(object NETDATASOURCE('Assemblies', !this.headings, !rowSet, '^Name'))

  -- Set the cells for assembly valid contents
  !this.setIcon(2, !this.asmblyData.contents)

endmethod
-- End of method definition for .refresh()

-----------------------------------------------------------------------
--
-- Method:      .remove(STRING)
--
-- Description: Remove assemblies from the detail list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Remove ALL or only those SELECTED
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remove(!arg is STRING)

  -- Remove the selected elements from the list
  if (!arg.eq('SELECTED')) then

    -- Remove the selected elements from the data
    !this.asmblyData.remove(!this.detailCtrl.getSelectedRowTags(), !this.assyDrwgApp.config.considerStatus)

    -- Build row data
    !rowSet = !this.asmblyData.buildData(!this.assyDrwgApp.config.considerStatus)

    -- Set list
    using namespace 'Aveva.Pdms.Presentation'
    !this.detailCtrl.bindToDataSource(object NETDATASOURCE('Assemblies', !this.headings, !rowSet, '^Name'))

    -- Set the cells for assembly valid contents
    !this.setIcon(2, !this.asmblyData.contents)

  else

    -- Check before clearing the list
    !answer = !!alert.question('Are you sure you want to remove all assemblies from the list?')
    if (!answer.upcase()eq('YES')) then
      !this.detailCtrl.clearGrid()
      !this.asmblyData.clear()
    endif

  endif

endmethod
-- End of method .remove(STRING)

-----------------------------------------------------------------------
--
-- Method:      .runSearch()
--
-- Description: Run the report
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .runSearch()

  -- Clear the grid and data object
  !this.detailCtrl.clearGrid()
  !this.asmblyData.clear()

  -- Get the assembly data for the current element
  if (!this.assyDrwgApp.config.considerStatus) then
    !this.asmblyData.getData(!this.ceRefe, !this.searchFilter,!this.assyDrwgApp.config.detailStatusAt,!this.assyDrwgApp.config.statusAttribute,!this.assyDrwgApp.config.statusDesc)
  else
    !this.asmblyData.getData(!this.ceRefe, !this.searchFilter)
  endif

  -- Build row data
  !rowSet = !this.asmblyData.buildData(!this.assyDrwgApp.config.considerStatus)

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.detailCtrl.bindToDataSource(object NETDATASOURCE('Assemblies', !this.headings, !rowSet, '^Name'))

  -- Set the editable columns except for the mode column, which will be handled next
  if (!this.assyDrwgApp.config.considerStatus) then
    !this.detailCtrl.setEditableColumn(1,false)
    !this.detailCtrl.setEditableColumn(2,false)
    !this.detailCtrl.setEditableColumn(3,false)
    !this.detailCtrl.setEditableColumn(4,false)
    !this.detailCtrl.setEditableColumn(5,false)
    if (!this.searchFilter.eq('DRAWN') or !this.searchFilter.eq('DRAWN BY ME')) then
      !this.detailCtrl.setEditableColumn(6,true)
    else
      !this.detailCtrl.setEditableColumn(6,false)
    endif
  else
    !this.detailCtrl.setEditableColumn(1,false)
    !this.detailCtrl.setEditableColumn(2,false)
    !this.detailCtrl.setEditableColumn(3,false)
    !this.detailCtrl.setEditableColumn(4,false)
    if (!this.searchFilter.eq('DRAWN') or !this.searchFilter.eq('DRAWN BY ME') or !this.searchFilter.eq('ALL')) then
      !this.detailCtrl.setEditableColumn(5,true)
    else
      !this.detailCtrl.setEditableColumn(5,false)
    endif
  endif

  -- Assign drop-down options to the mode column, for the filters 'Drawn', 'Drawn by me' and 'All'
  if (!this.searchFilter.eq('DRAWN') or !this.searchFilter.eq('DRAWN BY ME') or !this.searchFilter.eq('ALL')) then

    -- Get mode column number
    !modeColumnNumber = !this.getColNumbs()[2]

    -- Add the update/regenerate value list only to those rows where the drawing exists and is accessible
    do !rowNumber index !rowSet

      -- Get the row array
      !row = !rowSet[!rowNumber]


      -- If the assembly is drawn and the user has access to it
      if (!row[3].trim().boolean() and !row[4].trim().boolean()) then

        -- Set cell editable status
        !this.detailCtrl.setEditableCell(!rowNumber,!modeColumnNumber,true)

        -- Add the mode options
        !this.detailCtrl.assignValueListToCell('Mode', !rowNumber, !modeColumnNumber)

      -- Otherwise, the user can only create the drawing
      else
        !this.detailCtrl.setCellValue(!rowNumber, !modeColumnNumber, 'Create')

      endif

    enddo

  endif

  -- Set the cells for assembly valid contents
  !this.setIcon(2, !this.asmblyData.contents)

endmethod
-- End of method .runSearch()

-----------------------------------------------------------------------
--
-- Method:      .saveSettings()
--
-- Description: Save key form settings to main object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveSettings()

  -- Initialise variables
  !array = ARRAY()

  -- [1] The department
  !array.append(!this.adDept.val)

  -- [2] The registry
  !array.append(!this.adRegi.val)

  -- [3] The drawing type
  !array.append(!this.adType.val)

  -- [4] The drawing size
  !array.append(!this.adSize.val)

  -- [5] Create drawings
  !array.append(!this.assyDrwg.val)

  -- [6] Drawing PDF output
  !array.append(!this.drawingPDF.val)

  -- [7] Plot destination folder
  !array.append(!this.drwgFolder)

  -- [8] The parts list output
  !array.append(!this.partsLst.val)

  -- [9] The parts list type
  !array.append(!this.plTmpl.val)

  -- [10-12] The parts list output types
  !array.append(!this.partsTxt.val)
  !array.append(!this.partsCsv.val)
  !array.append(!this.partsXls.val)

  -- [13] The Parts List destination folder
  !array.append(!this.partFolder)

  -- Run object save
  !this.assyDrwgApp.saveSettings(!array)

endmethod
-- End of method .saveSettings()

-----------------------------------------------------------------------
--
-- Method:      .saveToFile()
--
-- Description: Save report to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveToFile()

  -- Initialise variables
  !fileObj    = !this.saveFile
  !date       = object DATETIME()
  !project    = CURRENT PROJECT
  !title      = 'Assembly Drawings Report'
  !session    = CURRENT SESSION
  !underLine  = '_'
  !separator  = '___'
  !content    = ARRAY()
  !body       = ARRAY()

  -- Build header names
  if (!this.assyDrwgApp.config.considerStatus) then
    !heading[1] = 'Assembly Name'
    !heading[2] = 'Status'
    !heading[3] = 'Valid Contents'
    !heading[4] = 'Drawing Name'
    !heading[5] = 'Access Rights'
    !heading[6] = 'Update Mode'
  else
    !heading[1] = 'Assembly Name'
    !heading[2] = 'Valid Contents'
    !heading[3] = 'Drawing Name'
    !heading[4] = 'Access Rights'
    !heading[5] = 'Update Mode'
  endif

  -- Set mode
  if (!fileObj.exists()) then
    !mode = 'OVERWRITE'
  else
    !mode = 'WRITE'
  endif

  -- Get report body
  !data = !this.asmblyData.getData(!this.assyDrwgApp.config.considerStatus)

  -- Add the header text and a space
  do !index ind !data
    !data[!index].insert(1,!heading[!index])
    !data[!index].insert(2,' ')
  enddo

  -- Get report column maximum widths
  !maxA = !data[1].width() + 3
  !maxB = !data[2].width()
  !maxC = !data[3].width()
  !maxD = !data[4].width()

  -- Consider status
  if (!this.assyDrwgApp.config.considerStatus) then

    -- Additional column
    !maxE = !data[5].width()

    -- Compose and add the body data
    do !index from 1 to !data[1].size()
      VAR !composed COMPOSE |   $!data[1][$!index]| WIDTH $!maxA SPACES 3 $
|$!data[2][$!index]| WIDTH $!maxB SPACES 3 $
|$!data[3][$!index]| WIDTH $!maxC SPACES 3 $
|$!data[4][$!index]| WIDTH $!maxD SPACES 3 $
|$!data[5][$!index]| WIDTH $!maxE SPACES 3 $
|$!data[6][$!index]|
      !body.appendArray(!composed)
    enddo

  else

    -- Compose and add the body data
    do !index from 1 to !data[1].size()
      VAR !composed COMPOSE |   $!data[1][$!index]| WIDTH $!maxA SPACES 3 $
|$!data[2][$!index]| WIDTH $!maxB SPACES 3 $
|$!data[3][$!index]| WIDTH $!maxC SPACES 3 $
|$!data[4][$!index]| WIDTH $!maxD SPACES 3 $
|$!data[5][$!index]|
      !body.appendArray(!composed)
    enddo

  endif

  -- Calculate body width and build separator line
  !maxBody = !body.width()
  do from 1 to !maxBody
    !separator = !separator & !underLine
  enddo

  -- Build report header
  !content.append(!separator)
  !content.append(' ')
  !content.append('                        ' & !title)
  !content.append(' ')
  !content.append(!separator)
  !content.append(' ')
  !content.append(' Project: ' & !project.code() & ' ' & !project.name())
  !content.append(' Date:    ' & !date.string())
  !content.append(' User:    ' & !session.login)
  !content.append(' ')
  !content.append(!separator)
  !content.append(' ')
  !content.append('   Reporting assemblies in: ' & !this.ceName.val)
  !content.append('   Filtered to show:        ' & !this.filterOption.selection('dtext'))
  !content.append(!separator)
  !content.append(' ')

  -- Add body text
  !content.appendArray(!body)

  -- Add report footer
  !content.append(' ')
  !content.append(!separator)
  !content.append(' End')

  -- Write file
  !fileObj.writefile(!mode,!content)

endmethod
-- End of method .saveToFile()

-----------------------------------------------------------------------
--
-- Method:      .selAll()
--
-- Description: Select all entries in the grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selAll()

  -- Initialise variables
  !select = ARRAY()

  -- When selecting all remember to switch of the 'display a drawing' option

  -- Build array of all rows
  do !index index !this.detailCtrl.getRows()
    !select.append(!index)
  enddo

  -- Select all rows
  !this.detailCtrl.setSelectedRowTags(!select)

endmethod
-- End of method .selAll()

-----------------------------------------------------------------------
--
-- Method:      .selDept()
--
-- Description: Set the registries for the selected department
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selDept()

  -- Get department names and refs
  !dtext = !this.assyDrwgApp.allDept[!this.adDept.val].getRegiNames()
  !rtext = !this.assyDrwgApp.allDept[!this.adDept.val].getRegiStrgRefs()

  -- Sort text
  !sorted = !dtext.sortedIndices()
  !dtext.reindex(!sorted)
  !rtext.reindex(!sorted)

  -- Set gadget text
  !this.adRegi.dtext = !dtext
  !this.adRegi.rtext = !rtext

  -- Save the first registry as the active one
  !this.saveSettings()

  -- Update the active toolbar
  !this.assyDrwgApp.appForm.assySelectType.val = 2
  !this.assyDrwgApp.deptIndex                  = !this.adDept.val
  !this.assyDrwgApp.selectList()

endmethod
-- End of method .selDept()

-----------------------------------------------------------------------
--
-- Method:      .selLalb()
--
-- Description: Select the label libraries
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selLalb()

  -- Set gadget text
  !this.plTmpl.dtext = !this.assyDrwgApp.getLalbNames()
  !this.plTmpl.rtext = !this.assyDrwgApp.getLalbRefs()

endmethod
-- End of method .seLalb()

-----------------------------------------------------------------------
--
-- Method:      .selRegi()
--
-- Description: Select the chosen registry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selRegi()

  -- Save the settings
  !this.saveSettings()

  -- Update the active toolbar
  !this.assyDrwgApp.appForm.assySelectType.val = 2
  !this.assyDrwgApp.appForm.assyTypeList.val = !this.adRegi.val

endmethod
-- End of method .selRegi()

-----------------------------------------------------------------------
--
-- Method:      .selSize()
--
-- Description: Select the sizes for the selected drawing type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selSize()

  -- Initialise variables
  !settings = ARRAY()

  -- Set gadget text
  !this.adSize.dtext = !this.assyDrwgApp.getDrawingSizes(!this.adType.val)

  -- Attempt to select the default setting
  if (!this.adSize.dtext.find(!this.assyDrwgApp.config.preferredSize).set()) then
    !this.adSize.select('DTEXT', !this.assyDrwgApp.config.preferredSize)
  endif

  -- Save the choice
  !settings.append(!this.adType.val)
  !settings.append(!this.adSize.val)
  !this.assyDrwgApp.saveTemplate(!settings)

  -- Set the icon
  !icon = !!pml.getPathName(!this.assyDrwgApp.allDrtmlb[!this.adType.val].icon)
    handle(44,33)
      --FNF:File not found
      !this.view.addPixmap(!!pml.getPathName('unset.png'))
    elsehandle none
      !this.view.addPixmap(!icon)
    endhandle

endmethod
-- End of method .selSize()

-----------------------------------------------------------------------
--
-- Method:      .setDept()
--
-- Description: Select the departments
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDept()

  -- Set gadget text
  !this.adDept.dtext = !this.assyDrwgApp.getDeptNames()
  !this.adDept.rtext = !this.assyDrwgApp.getDeptRefs()

  -- Check for active department toolbar
  if (!this.assyDrwgApp.appForm.assyDeptToolbar.visible and !this.assyDrwgApp.deptIndex.set()) then

    -- Set the department to the same one as the toolbar
    !this.adDept.val = !this.assyDrwgApp.deptIndex

  endif

endmethod
-- End of method .setDept()

-----------------------------------------------------------------------
--
-- Method:      .setDisplay()
--
-- Description: Set whether drawings should be displayed when picked
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDisplay()

  -- Check pop-up setting
  if (!this.defPopUp.selected('Display Drawing')) then
    !this.displayDrwg = true
  else
    !this.displayDrwg = false
  endif

endmethod
-- End of method .setDisplay()

-----------------------------------------------------------------------
--
-- Method:      .setDisplay(BOOLEAN)
--
-- Description: Set whether drawings should be displayed when picked
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDisplay(!on is BOOLEAN)

  -- Check pop-up setting
  if (!on) then
    !this.displayDrwg = true
  else
    !this.displayDrwg = false
  endif

endmethod
-- End of method .setDisplay(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .setExcel(FILE)
--
-- Description:   Set file to that returned from the file browser and save the report to excel
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File object for the save file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setExcel(!fileObj is FILE)

  -- Store browser settings on this form
  !this.saveExcel = !fileObj

  -- Save report to excel
  !this.detailCtrl.saveGridToExcel(!this.saveExcel.directory().fullName() & '\' & !this.saveExcel.entry())

endmethod
-- End of method definition for .setExcel(FILE)

------------------------------------------------------------------------
--
-- Method:        .setFile(FILE)
--
-- Description:   Set file to that returned from the file browser and save the report
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File object for the save file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFile(!fileObj is FILE)

  -- Store browser settings on this form
  !this.saveFile = !fileObj

  -- Save report
  !this.saveToFile()

endmethod
-- End of method definition for .setFile(FILE)

-----------------------------------------------------------------------
--
-- Method:      .setGadget()
--
-- Description: Set gadgets to the configuration settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setGadget()

  -- Whether to produce a drawing
  !this.assyDrwg.val = !this.assyDrwgApp.config.createDrawing

  -- Drawing Types and select preferred type
  !this.adType.dtext = !this.assyDrwgApp.getDrawingTypes()
  if (!this.adType.dtext.find(!this.assyDrwgApp.config.preferredType).set()) then
    !this.adType.select('DTEXT', !this.assyDrwgApp.config.preferredType)
  endif

  -- Drawing Sizes and select preferred size
  !this.selSize()

  -- Drawing department location
  !this.setDept()

  -- Drawing registry location
  !this.setRegi()

  -- Drawing PDF Output
  !this.drawingPDF.val = !this.assyDrwgApp.config.drawingPDF

  -- Drawing plot directory
  !this.adFold.val = !this.assyDrwgApp.config.drawingDirectory.name()
  !this.drwgFolder   = !this.assyDrwgApp.config.drawingDirectory

  -- Whether to produce a separate parts list
  !this.partsLst.val = !this.assyDrwgApp.config.createPartsList

  -- Parts list template
  !this.selLalb()
  if (!this.plTmpl.dtext.find(!this.assyDrwgApp.config.preferredPart).set()) then
    !this.plTmpl.select('DTEXT', !this.assyDrwgApp.config.preferredPart)
  endif

  -- Parts list output formats
  !this.partsTxt.val = !this.assyDrwgApp.config.partsListTxt
  !this.partsCsv.val = !this.assyDrwgApp.config.partsListCsv
  !this.partsXls.val = !this.assyDrwgApp.config.partsListXls

  -- Parts list files destination folder
  !this.plFold.val   = !this.assyDrwgApp.config.partsListDir.name()
  !this.partFolder   = !this.assyDrwgApp.config.partsListDir

endmethod
-- End of method .setGadget()

-----------------------------------------------------------------------
--
-- Method:      .setIcon(REAL,ARRAY)
--
-- Description: Set the specified column cell icons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setIcon(!column is REAL, !cellValues is ARRAY)

  -- For each cell
  do !index ind !cellValues

    -- OK
    if (!cellValues[!index]) then
      !this.detailCtrl.setCellImage(!index, !column, !!pml.getPathName('ad_t_018.png'))

    -- NOT OK
    else
      !this.detailCtrl.setCellImage(!index, !column, !!pml.getPathName('ad_t_019.png'))
    endif

  enddo

endmethod
-- End of method .setIcon(REAL,ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .setRegi()
--
-- Description: Select the registries for the selected department
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setRegi()

  -- Set gadget text
  !this.adRegi.dtext = !this.assyDrwgApp.allDept[!this.adDept.val].getRegiNames()
  !this.adRegi.rtext = !this.assyDrwgApp.allDept[!this.adDept.val].getRegiStrgRefs()

  -- Check for active department toolbar
  if (!this.assyDrwgApp.appForm.assyDeptToolbar.visible and !this.assyDrwgApp.drwgRegi.set()) then

    -- Select the registry to be the same as the toolbar
    !this.adRegi.select('RTEXT', !this.assyDrwgApp.drwgRegi.string())

  endif

endmethod
-- End of method .setRegi()

------------------------------------------------------------------------
--
-- Method:        .setOutput(STRING,GADGET)
--
-- Description:   Set file to that returned from the file browser
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Directory pathname from the browser
--    2   R      GADGET      Gadget to receive the selected file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setOutput(!directory is STRING,!gadget is GADGET)

  -- Set the gadget
  !gadget.val = !directory

endmethod
-- End of method definition for .setOutput(STRING,GADGET)

-----------------------------------------------------------------------
--
-- Method:      .showBatch()
--
-- Description: Start batch macro form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      PADD
--                           DESI
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showBatch()

  -- Initialise variables
  !selectedRows    = !this.detailCtrl.getSelectedRows()
  !selectedRowTags = !this.detailCtrl.getSelectedRowTags()

  -- Check if there is anything to produce
  if (!this.assyDrwg.val.not() and !this.partsLst.val.not()) then
    !!alert.message('There is nothing to produce! You have chosen neither a drawing nor a parts list for output.')
    return
  endif

  -- Get columns numbers for DRAWN & MODE depending on whether status is used
  !colNumbs = !this.getColNumbs()

  -- Clear the batch form
  !!assyBatch.clear()

  -- Get the assemblies for detailing
  do !index ind !selectedRowTags

    -- Initialise variables
    !stringNumb = !selectedRowTags[!index]

    -- Get assembly
    !asmblyRefe = !this.asmblyData.dbRefes[!stringNumb.real()]

    -- Check if asmbly element still exists
    VAR !exists EXISTS $!asmblyRefe

    -- Alert user
    if (!exists.eq('FALSEA')) then
      !!alert.error('ASMBLY ' & !asmblyRefe.flnn & ' has been deleted and will therefore be ignored')

    -- Alert the user to a lack of access rights to existing drawings
    elseif (!selectedRows[!index][4].match('No').neq(0)) then
      !!assyLog.add('You do not have access rights to modify the drawing for ASMBLY ' & !asmblyRefe.flnn & ' and will therefore be ignored')

    -- Pass assembly element for detailing
    else
      !!assyBatch.assemblies.append(!asmblyRefe)
    endif

    -- Get update type for existing drawings
    if (!selectedRows[!index][!colNumbs[1]].match('Yes').neq(0)) then

      -- Update the drawing
      if (!selectedRows[!index][!colNumbs[2]].eq('1') or !selectedRows[!index][!colNumbs[2]].upcase().eq('UPDATE')) then
        !!assyBatch.updates.append(true)

      -- Recreate the drawing
      else
        !!assyBatch.updates.append(false)
      endif

    -- Create the drawing
    else
      !!assyBatch.updates.append(false)
    endif

  enddo

  -- Pass application settings
  !!assyBatch.settings(!this.assyDrwgApp.getSettings())

  -- Show the form
  !!assyBatch.show()

endmethod
-- End of method .showBatch()

-----------------------------------------------------------------------
--
-- Method:      .switchMode()
--
-- Description: Switch to a particular mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      PADD
--                           DESI
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .switchMode(!requiredType is STRING)

  -- Get current database type
  !dbType = !!ce.dbType

  -- Access required type
  if (!requiredType.upcase().eq('DESI') and !dbType.eq('PADD')) then
    CONTEXT DESIGN
  elseif (!requiredType.upcase().eq('PADD') and !dbType.eq('DESI')) then
    CONTEXT DRAWING
  endif

endmethod
-- End of method .switchMode()
