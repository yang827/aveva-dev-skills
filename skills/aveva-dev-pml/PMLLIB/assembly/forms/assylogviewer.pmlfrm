-- File:            assylogviewer.pmlfrm
--   Type:          Form Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         01 December 2006
--
--
-- Description:
-- Used to display the cats & specs loader log
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyLogViewer()                  -                   Constructor
--  close()                          -                   Close the form
--  init()                           -                   Form initialisation
--  read(FILE)                       -                   Read a passed file
--
------------------------------------------------------------------------
-- Define form
setup form !!assyLogViewer resize

  -- Form callbacks
  !this.callback   = '!this.init()'
  !this.cancelCall = '!this.close()'

  -- Display
  textPane .display anchor left + right + top + bottom at xmin ymax width 60 height 30

  -- Members
  -- File to display
  member .log  is ASSYLOG

  -- Form title
  member .title is STRING

exit
-- End of form definition for !!assyLogViewer

------------------------------------------------------------------------
--
-- Method:      .assyLogViewer()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .assyLogViewer()

  -- Set form title
  !this.title  = 'Assembly Drawing Log Viewer'

  -- Set textpane as non-editable
  !this.display.setEditable(false)

endmethod
-- End of method definition for .assyLogViewer()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Form initialisation
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Test log file still exists
  if (!this.log.file.exists()) then

    -- Display file
    !this.display.val = !this.log.contents

    -- Set form title
    !this.formTitle   = !this.title & ': ' & !this.log.file.fullName()

  else
    !this.formTitle   = !this.title
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      .read(FILE)
--
-- Description: Read a passed file
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File to be opened
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .read(!file is FILE)

  -- Set the log file
  !this.log.read(!file)

endmethod
-- End of method definition for .read(FILE)
