-- File:            assymodelview.pmlfrm
--   Type:          Form Definition
--   Group:         common
--     Keyword:     3D
--   Module:        DRAFT
--   Replaces:
--
-- Author:          M.Barlow
-- Created:         Tue Sep 09 9:27:03 "GMT 2003
--
--
-- Description:
-- 3D View in Draft
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyModelView()                  -                   Constructor
--  close()                          -                   Close the form
--  initialise()                     -                   Determine current view from ce, and make it the selected view
--
------------------------------------------------------------------------
setup form !!assyModelView dialog resizable

  !this.formTitle = 'Assembly Model View'

  -- View save and restore commands
  view .view prompt .prompt GIVolume height 15 width 50

  exit

  -- Form Members
  member .currentDraftView      is DBREF

  -- Local copy of Draft View idList
  member .opList                is ARRAY
  member .refList               is ARRAY
  member .originList            is ARRAY

  -- Scale members
  member .scales                is ARRAY
  member .scaleFactors          is ARRAY
  member .activeScale           is REAL

  -- View finder member
  member .viewFinder            is VIEWFINDER

  -- Explorer add member
  member .explorerAddIdlist     is BOOLEAN

exit
------------------------------------------------------------------------
--
-- Method:      .assyModelView
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyModelView()

  !this.initcall   = '!this.initialise()'
  !this.cancelCall = '!this.close()'

  -- Set view defaults
  !this.view.background = 'black'
  !this.view.shaded     = TRUE

endmethod

------------------------------------------------------------------------
--
-- Method:      .initialise
--
-- Description: Determine current view from ce, and make it the selected view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- Empty local copy of Draft View idList
  !this.opList =  ARRAY()
  !this.refList =  ARRAY()
  !this.originList =  ARRAY()

  AID CLEAR ALL
  AID TRANSL 50

  -- Switch on autocolours
  !!assyAutoColour()

endmethod

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  -- Set form title
  !this.formTitle = !this.origTitle

  UNENHANCE ALL

endmethod
