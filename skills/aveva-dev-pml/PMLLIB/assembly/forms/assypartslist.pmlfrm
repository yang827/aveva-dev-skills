-- Created:         13 Feb 2006
--
--
-- Description:
-- The dummy form for holding parts list reports
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyPartsList()                  -                   Constructor method
--  cancel()                         -                   Cancel this form
--  close()                          -                   Close the form
--  init()                           -                   Method to initialise the form
--  saveToExcel(STRING)              -                   Save the report to excel
--  setData(FILE)                    -                   Sets passed data in this form
--  setData(STRING)                  -                   Sets passed data in this form
--  setDataList(ARRAY)               -                   Set the attribute grid control with the row set
--  setPartsHeadings(ARRAY)          -                   Set the parts list grid control headings
--  setPartsList(ARRAY)              -                   Set the parts list grid control with the row set
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

setup form !!assyPartsList dialog resizable

  -- Form members
  !this.formtitle     = 'Assembly Parts List'
  !this.callback      = '!this.init()'
  !this.cancelCall    = '!this.cancel()'
  !this.quitCall      = '!this.close()'

  -- Tab set
  frame .tabs tabset anchor all at xmin ymin

    -- Assembly data
    frame .dataFrame 'Assembly Data' dock fill at xmin ymin

      -- Assembly data
      container .datanetFrame PMLnetCONTROL  'net' dock fill at xmin ymin width 50 height 15

    exit

    -- Parts List
    frame .partsFrame 'Parts List' dock fill at xmin ymin

      -- Assembly parts
      container .partsnetFrame PMLnetCONTROL 'net' dock fill at xmin ymin width 50 height 15

    exit

  exit

  -- Members
  member .partFolder   is FILE
  member .rootName     is STRING
  member .aHeadings    is ARRAY
  member .pHeadings    is ARRAY

  -- My .net control
  using namespace 'Aveva.Pdms.Presentation'
  member .dataCtrl  is NETGRIDCONTROL
  member .partsCtrl is NETGRIDCONTROL

exit

------------------------------------------------------------------------
--
-- Method:      .assyPartsList()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyPartsList()

  -- Create instance of .net control
  using namespace 'Aveva.Pdms.Presentation'
  !this.dataCtrl  = object NETGRIDCONTROL()
  !this.partsCtrl = object NETGRIDCONTROL()

  -- Add .net control to PML containers
  !this.datanetFrame.control  = !this.dataCtrl.handle()
  !this.partsnetFrame.control = !this.partsCtrl.handle()

  !this.dataCtrl.columnExcelFilter(false)
  !this.dataCtrl.outlookGroupStyle(false)
  !this.dataCtrl.fixedHeaders(true)
  !this.dataCtrl.fixedRows(true)
  !this.dataCtrl.gridHeight(1000.0)
  !this.dataCtrl.editableGrid(true)
  !this.dataCtrl.columnSummaries(true)

  !this.partsCtrl.columnExcelFilter(false)
  !this.partsCtrl.outlookGroupStyle(false)
  !this.partsCtrl.fixedHeaders(true)
  !this.partsCtrl.fixedRows(true)
  !this.partsCtrl.gridHeight(1000.0)
  !this.partsCtrl.editableGrid(true)
  !this.partsCtrl.columnSummaries(true)

endmethod
-- End of method definition for .assyDrwgMain()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Set assembly data headings
  !this.aHeadings.append('Attribute')
  !this.aHeadings.append('Value')

endmethod
-- End of method .init()

-----------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  !this.hide()

endmethod
-- End of method .cancel()

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:        .setData(STRING)
--
-- Description:   Sets passed data in this form
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Assembly root name for output file naming
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!rootName is STRING)

  !this.rootName   = !rootName

endmethod
-- End of method definition for .setData(STRING)

------------------------------------------------------------------------
--
-- Method:        .setData(FILE)
--
-- Description:   Sets passed data in this form
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        Output folder
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!partFolder is FILE)

  !this.partFolder = !partFolder

endmethod
-- End of method definition for .setData(STRING,FILE)

------------------------------------------------------------------------
--
-- Method:        .saveToExcel(STRING)
--
-- Description:   Save the report to excel
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Which report to save DATA or PARTS
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveToExcel(!report is STRING)

  -- Save Assembly Attribute report to excel file
  if (!report.eq('DATA')) then
    !this.dataCtrl.saveGridToExcel(!this.partFolder.fullname() & '\' & !this.rootName & '_Data' & '.xls')
      handle (1000,0)
        -- Exception has been thrown by the target of an invocation
        !!alert.error('The system failed in attempting to write to an open file. Please close MS Excel and try again.')
      endhandle

  -- Save Parts List report to excel file
  elseif (!report.eq('PARTS')) then
    !this.partsCtrl.saveGridToExcel(!this.partFolder.fullname() & '\' & !this.rootName & '_Parts' & '.xls')
      handle (1000,0)
        -- Exception has been thrown by the target of an invocation
        !!alert.error('The system failed in attempting to write to an open file. Please close MS Excel and try again.')
      endhandle
  endif

endmethod
-- End of method definition for .setExcel(STRING)

------------------------------------------------------------------------
--
-- Method:        .setDataList(ARRAY)
--
-- Description:   Set the attribute grid control with the row set
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    2   R      ARRAY       Row set
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDataList(!rowSet is ARRAY)

  -- Clear the grid and data object
  !this.dataCtrl.clearGrid()

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.dataCtrl.bindToDataSource(object NETDATASOURCE('Assembly Attributes', !this.aHeadings, !rowSet, '^Attribute'))

endmethod
-- End of method definition for .setDataList(ARRAY)

------------------------------------------------------------------------
--
-- Method:        .setPartsHeadings(ARRAY)
--
-- Description:   Set the parts list grid control headings
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    2   R      ARRAY       Row set
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPartsHeadings(!headings is ARRAY)

  !this.pHeadings.clear()
  !this.pHeadings.appendArray(!headings)

endmethod
-- End of method definition for .setPartsHeadings(ARRAY)

------------------------------------------------------------------------
--
-- Method:        .setPartsList(ARRAY)
--
-- Description:   Set the parts list grid control with the row set
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    2   R      ARRAY       Row set
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPartsList(!rowSet is ARRAY)

  -- Clear the grid and data object
  !this.partsCtrl.clearGrid()

  -- Set list
  using namespace 'Aveva.Pdms.Presentation'
  !this.partsCtrl.bindToDataSource(object NETDATASOURCE('Parts List', !this.pHeadings, !rowSet, '^Attribute'))

endmethod
-- End of method definition for .setPartsList(ARRAY)
