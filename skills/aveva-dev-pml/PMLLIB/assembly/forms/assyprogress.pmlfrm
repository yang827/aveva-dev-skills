-- File:            assyprogress.pmlfrm
--   Type:          Function Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         130 November 2006
--
--
-- Description:
-- Show the progress of the drawing creation/update process
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyProgress()                   -                   Constructor method
--  cancel()                         -                   Cancel this form
--  close()                          -                   Close the form
--  init()                           -                   Method to initialise the form
--  setMeter(REAL)                   -                   Set the meter to the passed percentage
--  setPercent(REAL)                 -                   Set the form to store a drawing percentage
--  setText(STRING,REAL)             -                   Set the display text
--
------------------------------------------------------------------------
setup form !!assyProgress noQuit

  -- Form members
  !this.formtitle     = 'Assembly ADP Progress Monitor'
  !this.callback      = '!this.init()'
  !this.cancelCall    = '!this.cancel()'
  !this.quitCall      = '!this.close()'

  frame .frame at x0.5 y0
    para .dialog1 at x1 ymax+0.1 width 40 line 1
    para .dialog2 at x1 ymax-0.3 width 40 line 1
  exit

  button .stop  at xmax+1   y0.5 pixmap width 16 height 16
  para   .pStop at xmin-0.4 ymax text 'Stop'

  -- Percentage complete
  member .percentage      is REAL
  member .percentComplete is REAL

  -- Set interrupt
  !!FMSYS.setInterrupt(!this.stop)

exit

------------------------------------------------------------------------
--
-- Method:      .assyProgress()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyProgress()

  -- Pixmaps
  !this.stop.addPixmap(!!pml.getPathName('ad_t_015.png'))

  -- Set interrupt
  !!FMSYS.setInterrupt(!this.stop)

endmethod
-- End of method definition for .assyProgress()

-----------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Initialise members
  !this.percentage      = 0
  !this.percentComplete = 0

endmethod
-- End of method .init()

-----------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

endmethod
-- End of method .cancel()

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      .setMeter()
--
-- Description: Set the meter to the passed percentage
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        The percentage complete so far
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMeter(!percent is REAL)

  -- Store percentage
  !this.percentComplete = !percent

endmethod
-- End of method definition for .setMeter()

------------------------------------------------------------------------
--
-- Method:      .setPercent()
--
-- Description: Set the form to store a drawing percentage
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        The percentage of the job to create 50% of one drawing
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPercent(!percent is REAL)

  -- Store percentage
  !this.percentage = !percent

endmethod
-- End of method definition for .setPercent()

------------------------------------------------------------------------
--
-- Method:      .setText(STRING,REAL)
--
-- Description: Set the display text
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setText(!text is STRING, !row is REAL)

  -- Set the gadget text
  !gadgetString = '!this.dialog' & !row
  !gadget       = $!gadgetString
  !gadget.val   = !text
  !gadget.refresh()

  -- Refresh the interrupt
  refresh !!assyProgress.stop
  !!FMSYS.setInterrupt(!this.stop)

endmethod
-- End of method definition for .setText(STRING,REAL)
