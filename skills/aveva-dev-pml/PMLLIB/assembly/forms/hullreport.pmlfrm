--
-- Author:          mats.ridderman
-- Created:         Tue Sept 12    13:57:36  2007
--
-- Description:
-- Form to display Hull material values
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assemblySelectionHandler(ARRAY)  -                   assemblySelectionHandler
--  browser()                        -                   Show standard browser
--  cleanup()                        -                   Cleanup of the form
--  clear()                          -                   Close the form
--  getData()                        -                   Get data
--  hullReport()                     -                   Constructor
--  init()                           -                   Initialisation of the form
--  run()                            -                   Run the report
--  runSelection()                   -                   Update form based on selected assembly
--  setExcel(FILE)                   -                   Set file to that returned from the file browser and save the report to Excel
--
------------------------------------------------------------------------
import 'GridControl'
  handle any
  endhandle

import 'Aveva.Marine.AssemblyPlanning.Utilities'
  handle any
  endhandle

setup form !!hullReport

  para .selectedName at xmax+1 ymin width 35 lines 1

  frame .matFrame 'Material' at x0 ymax+0.2

    -- Container gadget for the Grid Control
    container .netFrame PMLNetCONTROL 'NET' at x1 ymax width 40 height 7

  exit

  frame .dataFrame '' at xmin.matFrame ymax.matFrame

    para .cofg   at x1   y0.5 width 40 lines 1
    -- para .area   at xmin ymax width 40 lines 1
    para .weight  at xmin ymax width 40 lines 1

  exit

  button .ok | OK | at xmin ymax+0.2 OK
  button .saveToExcel at xmax+3 ymin  tooltip 'Save List to Excel File ' pixmap width 16 height 16

  -- Members
  member .selected       is DBREF
  member .headings       is ARRAY
  member .rowSet         is ARRAY
  member .totalNumber    is REAL
  member .totalWeight    is REAL
  member .assemblyHandle is REAL

  -- My .net control
  using namespace 'Aveva.Pdms.Presentation'
  member .displayCtrl  is NETGRIDCONTROL

  -- Grid output
  member .saveExcel    is FILE

  -- Current Assembly Selection in AP GUI
  using namespace 'Aveva.Marine.AssemblyPlanning.Utilities'
  member .currentSelection is ASSEMBLYSELECTION

exit
-- End of form definition for !!hullReport
------------------------------------------------------------------------
--
-- Method:      hullReport()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hullReport()

  -- form setup
  !this.formTitle    = 'Hull Material Summary'
  !this.iconTitle    = 'material'
  !this.cancelCall   = ''
  !this.okCall       = '!this.cleanup()'
  !this.quitCall     = '!this.cleanup()'
  !this.callback     = '!this.init()'
  !this.formRevision = '$Revision: 1.0 $ '

  -- Pixmaps
  !this.saveToExcel.addPixmap(!!pml.getPathName('ad_t_011.png'))

  -- Callbacks
  !this.saveToExcel.callback  = '!this.browser()'

  -- Create instance of .net control
  using namespace 'Aveva.Pdms.Presentation'
  !this.displayCtrl = object NETGRIDCONTROL()

  -- Add PML event handlers to .net control
  !this.displayCtrl.addeventhandler('AfterSelectChange', !this, 'netAfterSelectChange')

  -- Add .net control to PML container
  !this.netFrame.control = !this.displayCtrl.handle()

  -- Add grid control style
  !this.displayCtrl.columnExcelFilter(false)
  !this.displayCtrl.outlookGroupStyle(false)
  !this.displayCtrl.fixedHeaders(true)
  !this.displayCtrl.fixedRows(true)
  !this.displayCtrl.gridHeight(1000.0)
  !this.displayCtrl.editableGrid(false)
  !this.displayCtrl.columnSummaries(true)
endmethod
-- End of method definition for .hullReport()

------------------------------------------------------------------------
--
-- Method:      assemblySelectionHandler
--
-- Description: assemblySelectionHandler
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      arguments
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------

define method .assemblySelectionHandler(!array is ARRAY)

  --For debugging purposes to test that this event handler not is running after form is closed.
  --this.currentSelection.remove() must be invoked when closing the form
  --!args = !this.formtitle + ': ' + !array[0] + ' ' + !array[1]
  --$P $!args

  !this.runSelection()

endmethod
-- End of method for assemblySelectionHandler

------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: Initialisation of the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Set default save directory and file
  !this.saveExcel = object FILE('%PDMSUSER%\hull report.xls')

  -- Set grid control headings
  !this.headings.append('Type')
  !this.headings.append('Quantity')
  !this.headings.append('Weight (Kg)')

  -- Add PML event handler for assembly selections, important to this.currentSelection.remove() when closing the form
  using namespace 'Aveva.Marine.AssemblyPlanning.Utilities'
  !this.currentSelection = object AssemblySelection(!this.formTitle)
  !this.assemblyHandle = !this.currentSelection.addeventhandler('AssemblySelectionEvent', !this, 'assemblySelectionHandler')
  -- Get selection and update form
  !this.runSelection()

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      .browser(GADGET)
--
-- Description: Show standard browser
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browser()

  import 'pmlFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !browser         = object PMLFILEBROWSER('SAVE')
  !directory       = !this.saveExcel.directory().fullName()
  !seedFile        = !this.saveExcel.entry()
  !title           = 'Save Report as Excel'
  !extensionString = 'xls files (*.xls)|*.xls'

  -- Show Browser
  !browser.show(!directory, !seedFile, !title, false ,!extensionString , 2)

  -- Test for no returned file name
  if (!browser.file().neq('')) then

    -- Write the output file
    !this.setExcel(object FILE(!browser.file()))

  endif

endmethod
-- End of method .browser(GADGET)

------------------------------------------------------------------------
--
-- Method:      .runSelection()
--
-- Description: Get the current selected assembly (in assembly addin)
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .runSelection()

  !sel = !this.currentSelection.assemblies()
  if (!sel.empty()) then
     !this.selected = object DBREF()
     !this.selectedName.val = 'No assembly selected'
  else
     !this.selected = !sel[1].dbref()
     !this.selectedName.val = !this.selected.flnn
  endif

  -- Run report
  !this.run()

endmethod
-- End of method definition for .runSelection()

------------------------------------------------------------------------
--
-- Method:      .clear()
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  -- Clear the grid
  !this.displayCtrl.clearGrid()

  -- Clear the data
  !this.rowSet.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      getData()
--
-- Description: Get data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getData()

  -- Initialise variables
  !assembly    = !this.selected
  !plateData   = ARRAY()
  !bracketData = ARRAY()
  !profileData = ARRAY()
  !clipData    = ARRAY()
  !totalNumber = 0
  !totalWeight = 0

  !allPlates   = ARRAY()
  !allBrackets = ARRAY()
  !allProfiles = ARRAY()
  !allClips    = ARRAY()

  if (!assembly.set()) then
     -- Get all plates, brackets, profiles and clips
     VAR !allPlates   COLL ALL HPLATE FOR $!assembly
     VAR !allBrackets COLL ALL HBRCKT FOR $!assembly
     VAR !allProfiles COLL ALL HSTIFF FOR $!assembly
     VAR !allClips    COLL ALL HCLIP  FOR $!assembly
  endif

  -- Set data array for each element type
  -- PLATES
  -- Type
  !plateData.append('Plates')

  -- Number of Plates
  !plateData.append(!allPlates.size())
  !totalNumber = !totalNumber + !allPlates.size()

  -- Weight of plates
  !weight = 0
  do !plate val !allPlates
    !weight = !weight + !plate.dbref().nwei
  enddo
  !plateData.append(!weight.int())
  !totalWeight = !totalWeight + !weight

  -- BRACKETS
  -- Type
  !bracketData.append('Brackets')

  -- Number of Brackets
  !bracketData.append(!allBrackets.size())
  !totalNumber = !totalNumber + !allBrackets.size()

  -- Weight of Brackets
  !weight = 0
  do !bracket val !allBrackets
    !weight = !weight + !bracket.dbref().nwei
  enddo
  !bracketData.append(!weight.int())
  !totalWeight = !totalWeight + !weight

  -- PROFILES
  -- Type
  !profileData.append('Profiles')

  -- Number of Profiles
  !profileData.append(!allProfiles.size())
  !totalNumber = !totalNumber + !allProfiles.size()

  -- Weight of Profiles
  !weight = 0
  do !profile val !allProfiles
    !weight = !weight + !profile.dbref().nwei
  enddo
  !profileData.append(!weight.int())
  !totalWeight = !totalWeight + !weight

  -- CLIPS
  -- Type
  !clipData.append('Clips')

  -- Number of Clips
  !clipData.append(!allClips.size())
  !totalNumber = !totalNumber + !allClips.size()

  -- Weight of Clips
  !weight = 0
  do !clip val !allClips
    !weight = !weight + !clip.dbref().nwei
  enddo
  !clipData.append(!weight.int())
  !totalWeight = !totalWeight + !weight

  -- Build row set for the grid
  !this.rowSet.append(!plateData)
  !this.rowSet.append(!bracketData)
  !this.rowSet.append(!profileData)
  !this.rowSet.append(!clipData)

  -- Store total weight
  !this.totalNumber = !totalNumber
  !this.totalWeight = !totalWeight

endmethod
-- End of method definition for .getData()

-----------------------------------------------------------------------
--
-- Method:      .run()
--
-- Description: Run the report
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .run()

  -- Clear the grid and data object
  !this.clear()

  -- Get data
  !this.getData()

  -- Set grid
  using namespace 'Aveva.Pdms.Presentation'
  !this.displayCtrl.bindToDataSource(object NETDATASOURCE('Hull Material', !this.headings, !this.rowSet, '^Type'))

  -- Set totals
  !this.weight.val = 'Total Weight for ' & !this.totalNumber & ' elements: ' & !this.totalWeight.int()

  !formatCof = object FORMAT()
  !formatCof.units = 'M'

  !cof = !this.selected.gcof
  handle any
    !cof = object POSITION()
  endhandle

  !cofStr = ''
  if (!cof.unset().not()) then
    !xCof = !cof.east.string(!formatCof)
    !yCof = !cof.north.string(!formatCof)
    !zCof = !cof.up.string(!formatCof)
    !cofStr = 'x: ' & !xCof & '  y: ' & !yCof & '  z: ' & !zCof & ' m'
  endif

  -- Set cofg and area
  !this.cofg.val = 'Centre of Gravity:   ' & !cofStr
  -- !this.area.val = 'Area of Hull Elements: 0.00 m2'

endmethod
-- End of method .run()

------------------------------------------------------------------------
--
-- Method:        .setExcel(FILE)
--
-- Description:   Set file to that returned from the file browser and save the report to Excel
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File object for the save file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setExcel(!fileObj is FILE)

  -- Store browser settings on this form
  !this.saveExcel = !fileObj

  -- Save report to excel
  !this.displayCtrl.saveGridToExcel(!this.saveExcel.directory().fullName() & '\' & !this.saveExcel.entry())

endmethod
-- End of method definition for .setExcel(FILE)

------------------------------------------------------------------------
--
-- Method:      .cleanup()
--
-- Description: Cleanup of the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cleanup()

  !this.currentSelection.remove()
  !this.currentSelection.removeeventhandler('AssemblySelectionEvent', !this.assemblyHandle)

endmethod
-- End of method definition for .cleanup()
