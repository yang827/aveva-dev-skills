-- File:            assybuildname.pmlfnc
--   Type:          Function Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2006
--
--
-- Description:
-- Assembly Drawing Application Startup
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type - currently limited to DEPT and REGI
--    2   R      STRING      The root name
--                           Elements will be named in the format <rootname><type><index>
--    3   R      BOOLEAN     Result required with or without the leading slash character
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!assyBuildName(!elemType is STRING, !rootName is STRING, !withSlash is BOOLEAN) is STRING

  -- Initialise variables
  !startCount = 1

  -- Set default name
  if (!elemType.eq('DEPT')) then
    !defaultName       = !rootName & 'Dept'
    !tryName           = !defaultName & !startCount
  else
    !defaultName       = !rootName & 'Regi'
    !tryName           = !defaultName & !startCount
  endif

  -- Test for existing default name
  VAR !exists EXIST $!tryName

  -- When the default name does not exist, use it
  if (!exists.eq('FALSEA')) then

    !name = !tryName

  -- Create new name
  else

    -- Find a new name
    do !count from !startCount to 9999

      -- Build new name
      !newName = !defaultName & !count

      -- When a new name does not exist
      VAR !exists EXIST $!newName
      if (!exists.eq('FALSEA')) then

        -- Use the new name
        !name = !newName

        -- Done
        break

      endif

    enddo

  endif

  -- Return name
  if (!withSlash) then
    return !name
  else
    return !name.substring(2)
  endif

endfunction
-- End of function !!assyBuildName
