--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Calculates the centre of a RECT or TABL element
--
-- LIMITATIONS
-- Does not take into account ADEG
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      DBREF        The element reference
--
-- Return:
--   [Data Type] [Description]
--    POSITION    Centre position
--
------------------------------------------------------------------------
define function !!assyCalcCentre(!elemRefe is DBREF) is POSITION

  -- Initialise variables
  !ocode     = !elemRefe.ocode
  !origin    = !elemRefe.ptrf.xypo
  !halfXlen  = !elemRefe.xLen / 2
  !halfYlen  = !elemRefe.yLen / 2
  !direEast  = object DIRECTION('E')
  !direNorth = object DIRECTION('N')
  !direWest  = object DIRECTION('W')
  !direSouth = object DIRECTION('S')

  -- Calculate centre depending on ocode position
  -- Top Left
  if (!ocode.upCase().eq('TOPLEFT')) then
    !offset = !origin.offset(!direEast,!halfXlen)
    !centre = !offset.offset(!direSouth,!halfYlen)

  -- Top Right
  elseif (!ocode.upCase().eq('TOPRIGHT')) then
    !offset = !origin.offset(!direWest,!halfXlen)
    !centre = !offset.offset(!direSouth,!halfYlen)

  -- Bottom Left
  elseif (!ocode.upCase().eq('BOTTOMLEFT')) then
    !offset = !origin.offset(!direEast,!halfXlen)
    !centre = !offset.offset(!direNorth,!halfYlen)

  -- Bottom Right
  elseif (!ocode.upCase().eq('BOTTOMRIGHT')) then
    !offset = !origin.offset(!direWest,!halfXlen)
    !centre = !offset.offset(!direNorth,!halfYlen)

  -- Top Side
  elseif (!ocode.upCase().eq('TOPSIDE')) then
    !centre = !origin.offset(!direSouth,!halfYlen)

  -- Bottom Side
  elseif (!ocode.upCase().eq('BOTTOMSIDE')) then
    !centre = !origin.offset(!direNorth,!halfYlen)

  -- Left Side
  elseif (!ocode.upCase().eq('LEFTSIDE')) then
    !centre = !origin.offset(!direEast,!halfXlen)

  -- Right Side
  elseif (!ocode.upCase().eq('RIGHTSIDE')) then
    !centre = !origin.offset(!direWest,!halfXlen)

  -- Centre
  else
    !centre = !origin
  endif

  -- Return centre position
  return !centre

endfunction
-- End of function !!assyCalcCentre
