-- Created:         25 Jan 2006
--
--
-- Description:
-- Call a macro that contains comments which are not acceptable to $M
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Macro to call
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!assyCallMacro(!macro is STRING)

  -- Initialise variables
  !file    = object FILE(!macro)

  -- If the file exists
  if (!file.exists()) then

    -- Read the file
    !contents = !file.readfile()

    -- Load the file
    do !line val !contents

      -- Skip spurious characters
      skip if (!line.match('#').eq(1) or !line.upcase().match('DEVPEN').gt(0) or !line.upcase().match('COLOUR CONTROL FILE').gt(0))

      -- Run the line command
      $!line

    enddo

  endif

endfunction
-- End of function !!assyCallMacro(STRING)
