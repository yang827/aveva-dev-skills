--
--
-- Description:
-- Assembly Drawing Application Startup
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!assyDraStartup()

  -- Initialise variables
  !module = object MODULE()

  -- This application should not run in PDMS
  if (!module.productFamily.upcase().eq('PLANT')) then
    return
  endif
  -- Access PADD db
  if (!!ce.dbType.eq('DESI')) then
    CONTEXT DRAWING
  endif

  -- Load application forms
  pml load form !!assyDrwgMain
  pml load form !!assyDrwgHier
  pml load form !!assyPartsList
  pml load form !!assyModelView
  pml load form !!assyDisplay
  pml load form !!assyProgress
  pml load form !!assyLogViewer
  pml load form !!assyBatch
  pml load form !!assyDbs

  -- Load main application object
  if (!!assyDrwgMain.assyDrwgApp.load()) then

    -- Stop when any load errors & deactivate the toolbar and main menu option
    !!assyDrwgMain.assyDrwgApp.active(false)
    return

  endif

  -- Load application default settings
  !!assyDrwgMain.assyDrwgApp.setDefaults()

endfunction
-- End of function !!assyDraStartup
