--
-- Author:          Steve Wilson
-- Created:         25 Jan 2006
--
--
-- Description:
-- Find the owned assemblies for a known assembly
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      Element
--    2    R     STRING     Object type required DBREF or STRING
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!assyDrwgAsmbly(!elemRefe is DBREF, !type is STRING) is ARRAY

  -- Initialise variables
  !assemblies = ARRAY()

  -- Get all assembly members of the passed element, while checking for the world
  -- The result includes the current element
  if (!elemRefe.hardType.upcase().eq('WORL')) then

    -- Find all Assembly Worlds
    VAR !allAsmblyWorlds COLL ALL ASWL

    -- Add all assemblies for each world
    do !asmblyWorld val !allAsmblyWorlds
      VAR !allAsmbly APPEND COLL ALL ASMBLY FOR $!asmblyWorld
    enddo

  else
    VAR !allAsmbly COLL ALL ASMBLY FOR $!elemRefe
  endif

  -- Turn the array of strings into dbrefs
  if (defined(!allAsmbly)) then

    if (!type.upcase().eq('DBREF')) then

      !extractDbref = object BLOCK('!allAsmbly[!evalIndex].dbref()')
      !assemblies   = !allAsmbly.evaluate(!extractDbref)

    else
      !assemblies = !allAsmbly
    endif

  endif

  -- Return the array of dbrefs
  return !assemblies

endfunction
-- End of function !!assyDrwgAsmbly
