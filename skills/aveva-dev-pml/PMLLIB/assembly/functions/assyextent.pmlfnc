-- File:            assyextent.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
--
-- Description:
-- Split the ce atext into parts
--
-- ASSUMPTIONS:
-- The current element is the SLAB being tested
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       The ce atext split into parts
--
-------------------------------------------------------------------------
define function !!assyExtent(!limit is REAL, !index is REAL) is ARRAY

  -- Initialise variables
  !sentence = !!ce.atex
  !parts    = ARRAY()

  -- Read current max extent position for checking against the limit
  VAR !extent SPLIT EXTENT BTEX

  -- Read the relevant array index
  !currMax = $!extent[$!index]

  -- Test for the extent exceeding the limit
  if (!currMax.gt(!limit)) then

    -- Split the atext so that it fits into the column
    -- Do this by reducing the length as is quicker than building up
    !atexBits  = !sentence.split(' ')
    !bitLength = 0

    do !count from !atexBits.size() to 1 by -1

        -- Calculate bit length by which to reduce the atex
        !bitLength = !bitLength + !atexBits[!count].length() + 1

        -- Reduce atex
        !reduced = !sentence.substring(1,!sentence.length() - !bitLength)

        -- Set slab atex and read new extent
        ATEX |$!reduced|
        VAR !extent SPLIT EXTENT BTEXT

        -- Test the new extent against the next
        if (!extent[!index].real().leq(!limit)) then
          !parts.append(!reduced)
          !remaining = !sentence.after(!reduced).trim('L')
          !parts.append(!remaining)
          break
        endif

    enddo

  else

    -- Always return the sentence
    !parts.append(!sentence)

  endif

  -- Set the atex to the remaining text
  if (defined(!remaining)) then
    ATEX |$!remaining|
  endif

  return !parts

endfunction
-- End of function !!assyExtent
