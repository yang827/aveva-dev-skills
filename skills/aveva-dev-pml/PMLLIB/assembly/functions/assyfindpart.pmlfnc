--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Find a member part that is NOT an assembly
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      DBREF        Element reference
--
-- Return:
--   [Data Type] [Description]
--    DBREF       The found part element
--
------------------------------------------------------------------------
define function !!assyFindPart(!partRefe is DBREF) is DBREF

  -- For an assembly
  if (!partRefe.hardType.upCase().eq('ASMBLY')) then

    -- Initialise variables
    !parts = !partRefe.smemb
    !partRefe = object DBREF()

    -- Check for any parts that are not an assembly
    do !part val !parts

      -- Ignore any non-modelled elements
      skip if !part.hardType.upCase().eq('SPCO')
      skip if !part.hardType.upCase().eq('GPART')
      skip if !part.actType.upCase().eq(':NMPART')

      -- For an assembly
      if (!part.hardType.upCase().eq('ASMBLY')) then

        -- Check this assembly members
        !partRefe = !!assyFindPart(!part)

      else
        !partRefe = !part
        break
      endif

    enddo

  endif

  -- For any found spool part
  if (!partRefe.badref().not()) then

    -- For a Pipe spool get the first component
    if (!partRefe.hardType.upCase().eq('PSPOOL')) then

      !pipeSpoolManager = object PIPESPOOLMANAGER()
      !partRefe = !pipeSpoolManager.getBranchElements(!partRefe)[1]

    -- For HVAC spool get the first component
    elseif (!partRefe.hardType.upCase().eq('HSPOOL')) then

      !hvacSpoolManager = object HVACSPOOLMANAGER()
      !partRefe = !hvacSpoolManager.getMtoElementsForSpool(!partRefe)[1]

    -- For a Pipe or HVAC piece get the first component
    elseif (!partRefe.hardType.upCase().eq('PPIECE') or !partRefe.hardType.upCase().eq('HPIECE')) then

      if (!partRefe.aelrfa[1].set()) then
        !partRefe = !partRefe.aelrfa[1]
      else
        !partRefe = object DBREF()
      endif

    endif

  endif

  -- Return found part
  return !partRefe

endfunction
-- End of function !!assyFindPart
