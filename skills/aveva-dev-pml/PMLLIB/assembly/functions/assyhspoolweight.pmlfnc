-- Created:         12 October 2006
--
--
-- Description:
-- Get the weight of a HVAC spool from it's constituent parts
--
--
-- ASSUMPTIONS
-- The current element is the SHEE
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      DBREFY       The hvac spool element
--
-- Return:
--   [Data Type] [Description]
--    REAL        The weight of the hvac spool
--
------------------------------------------------------------------------
define function !!assyHspoolWeight(!hSpoolRefe is DBREF) is REAL

  -- Initialise variables
  !hvacSpoolManager = object HVACSPOOLMANAGER()
  !totalWeight      = 0

  -- Get the hvac spool components
  !components = !hvacSpoolManager.getMtoElementsForSpool(!hSpoolRefe)

  -- Get the weight each component
  do !compRefe val !components

    -- Read the weight
    !weight = !compRefe.nwei

    -- Add weight to the total
    !totalWeight = !totalWeight + !weight

  enddo

  -- Return the weight
  return !totalWeight

endfunction
-- End of function !!assyHspoolWeight
