--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Martin Ward
-- Created:         June 2010
--
--
-- Description:
-- Initialise the assembly application and run the required action
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      String      Action to run
--
------------------------------------------------------------------------
define function !!assyInit(!action is STRING)

  if (undefined(!!assyDrwgMain)) then
    -- Load the Assembly Deliverables application
    !!assyDraStartup()
    !mod = !!module()
    if (!mod.appkey.upcase() eq 'MARDRA') then
      !form = !!appMDraMain
    else
      !form = !!appDraMain
    endif
    !form.assyHierarchy.active  = TRUE
    !form.assyMultiDrwg.active  = TRUE
    !form.assyQuickDrwg.active  = TRUE
    !form.assyAllDrwg.active    = TRUE
    !form.assySearch.active     = TRUE
    !form.assyLog.active        = TRUE
    !form.assySelectType.active = TRUE
    !form.assyTypeList.active   = TRUE
  endif

  if (!action eq 'MAIN') then
    !!assyDrwgMain.show()
  endif

endfunction
-- End of function !!assyFindPart
