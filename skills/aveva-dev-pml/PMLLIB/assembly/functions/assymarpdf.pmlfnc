--
-- File:            assymarpdf.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--
-- Author:          Tomasz Lisowski
-- Created:         14 April 2009
--
--
-- Description:
-- Submit drawing to an installed PDF print server
-- This is an example only and relies upon a BULLZIP PDF print server being installed
-- See website http://www.bullzip.com/
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   R      DBREF             The sheet being printed
--    2   R      STRING            The output pdf file name including the path
--
------------------------------------------------------------------------
define function !!assyMarPdf(!sheeRefe is DBREF, !pdfPathName is STRING)

  import 'marapi'
    handle (1000,0)
    endhandle

  using namespace 'Aveva.Marine.Drafting'
  !drafting = object MARDRAFTING()

  -- Make sure the drawing is current
  if (!drafting.dwgCurrent().not()) then

    -- Open the passed drawing
    !drafting.dwgOpen(!sheeRefe.string(),4)
      handle any
        !!assyLog.add('    A PDF file cannot be created as it was not possible to open the drawing')
        return
      endhandle

  endif

  -- Get the drawing extents to determine the orientation later
  !rect   = !drafting.elementExtentGet()
  !width  = !rect.corner2().x() - !rect.corner1().x()
  !height = !rect.corner2().y() - !rect.corner1().y()

  -- Set printer options
  !options  = object MARPRINTOPTIONS()
  !options.printerName('Bullzip PDF Printer')

  -- Center the drawing on page
  !options.centerOnPagePML(1)

  -- Print the drawing form (and its contents), ignoring the graphics outside it
  !options.effPrintAreaPML(1)

  -- Configure the driver
  SYSCOM '"C:\Program Files\BullZip\PDF Printer\api\EXE\config.exe" /S output $!pdfPathName'
  SYSCOM '"C:\Program Files\BullZip\PDF Printer\api\EXE\config.exe" /S showsettings never'
  SYSCOM '"C:\Program Files\BullZip\PDF Printer\api\EXE\config.exe" /S showpdf no'
  SYSCOM '"C:\Program Files\BullZip\PDF Printer\api\EXE\config.exe" /S confirmoverwrite yes'
  SYSCOM '"C:\Program Files\BullZip\PDF Printer\api\EXE\config.exe" /S showprogressfinished no'

  -- Specify that one copy is required
  !options.noOfCopiesPML(1)

  -- Specify orientation
  if (!width.geq(!height)) then
    !options.orientationPML(2)
  else
    !options.orientationPML(1)
  endif

  -- Specify paper size
  !options.paperName('A4')

  -- Request scaling to fit the paper size
  !options.scaleToFitPML(1)

  -- Print the current drawing
  !drafting.dwgPrint(!options)
    handle any
      !!assyLog.add('    A PDF file cannot be created as there was some unknown printer error')
    endhandle

  -- Close the drwg
  !drafting.dwgClose()

endfunction
-- End of function !!assyMarPdf
