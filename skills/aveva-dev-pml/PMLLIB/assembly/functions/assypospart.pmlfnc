-- File:            assypospart.pmlfnc
--   Type:          Function Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Find a position for the passed element
--
--
-- ASSUMPTIONS
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      DBREF        Symbolic Label reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!assyPosPart(!elemRefe is DBREF)

  -- Initialise variables
  !ce = !!ce

  WARNINGS OFF

  -- Get the local volume
  !lVol = !elemRefe.ddnm.lVol

  -- Calculate the midpoint of the box
  !firstCorner  = object POSITION('E' & !lVol[1] & ' N' & !lVol[2] & ' U' & !lVol[3])
  !secondCorner = object POSITION('E' & !lVol[4] & ' N' & !lVol[5] & ' U' & !lVol[6])
  !midPoint     = !firstCorner.midPoint(!secondCorner)

  -- Get the mid point paper position
  VAR !midShtPos SHPOS OF E $!<midPoint.east> N $!<midPoint.north> U $!<midPoint.up>

  -- Access the slab
  !!ce = !elemRefe

  -- Place the slab at the location of the ddnm
  XYPO $!midShtPos

  -- Read paper position
  !xyPos = !!ce.xypo
  !apoff = !xyPos.east & ' ' & !xyPos.north

  -- Set apoff
  APOFF $!apoff

  -- Return to original element
  !!ce = !ce

  WARNINGS ON

endfunction
-- End of function !!assyPosPart
