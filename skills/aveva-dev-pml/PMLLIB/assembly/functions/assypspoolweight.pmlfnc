--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Get the weight of a pipe spool from it's constituent parts
--
--
-- ASSUMPTIONS
-- The current element is the SHEE
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      DBREFY       The pipe spool element
--
-- Return:
--   [Data Type] [Description]
--    REAL        The weight of the pipe spool
--
------------------------------------------------------------------------
define function !!assyPspoolWeight(!pSpoolRefe is DBREF) is REAL

  -- Initialise variables
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  !totalWeight      = 0

  -- Get the pipe spool components
  !components = !pipeSpoolManager.getBranchElements(!pSpoolRefe)

  -- Get the weight each component
  do !compRefe val !components

    -- Initialise variables
    !weight = 0

    -- Get tube mto status
    if (!compRefe.hardType.eq('TUBI')) then

      -- Get the actual owner of the IL TUB
      -- The actual owner is only held in the string name of the tube e.g. IL TUB OF FLAN 1 OF BRAN /PIPE1/B1
      !tubeOwnerRefe = !compRefe.name.upCase().after('OF ').dbref()

      -- Test for tube owner
      if (!tubeOwnerRefe.hardType.eq('BRAN')) then
        !mtoStatus = !tubeOwnerRefe.mtoh
      else
        !mtoStatus = !tubeOwnerRefe.mtot
      endif

    -- Get component mto status
    else
      !mtoStatus = !compRefe.mtoc
    endif

    -- Elements that have been switched off from the material list are not transferred to be considered
    skip if (!mtoStatus.upCase().eq('OFF') or !mtoStatus.upCase().eq('DOTD') or !mtoStatus.upCase().eq('DOTU'))

    -- Calculate the weight for tube
    if (!compRefe.hardType.upCase().eq('TUBI')) then

      -- Test for bad spref and cmpref
      if (!compRefe.spre.badref()) then
        skip
      else
        if (!compRefe.spre.cmpr.badref()) then
          skip
        else
          !unitWeight = !compRefe.spre.cmpr.uwei.real()
        endif
      endif

      -- Calculate weight
      !weight = !compRefe.itle * !unitWeight

    -- Pulled bends
    elseif (!compRefe.hardType.upCase().eq('BEND') and !!assyPulledBend(!compRefe)) then

      -- Get component tube
      !tubeRefe   = ILEAVE TUBE OF $!compRefe

      -- Get bend equivalent length of tube
      !clLength   = !!assyBendLength(!compRefe)

      -- Test for bad spref and cmpref
      if (!tubeRefe.spre.badref()) then
        skip
      else
        if (!tubeRefe.spre.cmpr.badref()) then
          skip
        else
          !unitWeight = !tubeRefe.spre.cmpr.uwei.real()
        endif
      endif

      -- Calculate bend weight
      !weight = !clLength * !unitWeight

    -- All other components
    else

      -- Test for bad spref and cmpref
      if (!compRefe.spre.badref()) then
        skip
      else
        if (!compRefe.spre.cmpr.badref()) then
          skip
        else
          !weight = !compRefe.spre.cmpr.cwei.real()
        endif
      endif

    endif

    -- Add weight to the total
    !totalWeight = !totalWeight + !weight

  enddo

  return !totalWeight

endfunction
-- End of function !!assyPspoolWeight
