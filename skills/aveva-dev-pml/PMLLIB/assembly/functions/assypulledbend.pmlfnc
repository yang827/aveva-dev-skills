-- Author:          Steve Wilson
-- Created:         Wed February 06
--
--
-- Description:
-- Function to test whether a BEND component is made of tube
--
-- This is determined by testing the skey used to represent it
-- To be a pulled bend in Isodraft term, the skey will be one of
-- PB+D, BU+D, TB+D where the + is an integer that gives the
-- multiples of the diameter to determine the radius
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component reference
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Result of the test, TRUE if a pulled bend
--
------------------------------------------------------------------------
-- Define function
define function !!assyPulledBend(!compRefe is DBREF) is BOOLEAN

  -- Initialise variables
  !pulledBend = false

  -- Test for a bad spref
  if (!compRefe.spref.badref()) then
    return false
  endif

  -- Test for bad detref
  if (!compRefe.spref.detref.badref()) then
    return false
  endif

  -- Test for unset skey
  if (!compRefe.spref.detref.skey.eq('') or !compRefe.spref.detref.skey.eq(' ')) then

    -- Check the property for tube or component type
    if (!compRefe.spre.cmpr.badref()) then
      return false
    else
      if (!compRefe.spre.cmpr.type.upCase().eq('TUBD')) then
        return true
      else
        return false
      endif
    endif

  else

    -- Get skey bits
    !skey = !compRefe.spref.detref.skey
    !bitA = !skey.substring(1,2)
    !bitB = !skey.substring(4,1)

    -- Test skey for pulled bend
    if (!bitA.eq('PB') and !bitB.eq('D')) then
      !pulledBend = true
    elseif (!bitA.eq('BU') and !bitB.eq('D')) then
      !pulledBend = true
    elseif (!bitA.eq('TB') and !bitB.eq('D')) then
      !pulledBend = true
    endif

  endif

  return !pulledBend

endfunction
-- End of function definition for !assyPulledBend()
