--
-- Author:          Steve Wilson
-- Created:         Wed December 21 11:03:23 BST 2004
--
--
-- Description:
-- Function to calculate the radius of an BEND or ELBO
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       ELBO or BEND
--
--
-- Return:
--   [Data Type] [Description]
--    REAL        Centreline length
--
------------------------------------------------------------------------
-- Define function
define function !!assyBendLength(!compRefe is DBREF) is REAL

  -- Initialise variables
  !pupLength = 0
  !oneEighty = false

  -- Get skey bits
  !skey = !compRefe.spref.detref.skey
  !bitA = !skey.substring(1,2)
  !bitB = !skey.substring(4,1)

  -- Test skey for a 180 degree pulled bend
  if (!bitA.eq('BU') and !bitB.eq('D')) then
    !oneEighty = true
  endif

  -- Calculate leg length using catalogue property for arrive face ppoint, in case of elbow with pipe pups
  !pArrive = !compRefe.prop.afac
    handle (2,207)
      -- Required property not found
      -- Use the current arrive point
      !pArrive   = !compRefe.arrive
    elsehandle none
      -- Check to see if the specified pPoint is the same as the arrive pPoint
      -- If not then calculate the distance between them to add as a pup length
      if (!pArrive.real().neq(!compRefe.arrive)) then
        !pupLength = !compRefe.ppos[!pArrive.real()].distance(!compRefe.apos)
      endif
    endhandle

  -- Calculate angle using catalogue property for leave face ppoint, in case of elbow with pipe pups
  !pLeave = !compRefe.prop.lfac
    handle (2,207)
      -- Required property not found
      -- Use the current leave point
      !pLeave   = !compRefe.leave
    elsehandle none
      if (!pLeave.real().neq(!compRefe.leave)) then
        !pupLength = !compRefe.ppos[!pLeave.real()].distance(!compRefe.lpos)
      endif
    endhandle

  -- For a 180 degree bend
  if (!oneEighty) then

    -- Calculate the radius using the arrive leg (P1 through P4 to P3)
    -- Calculate the angle
    !angle = !compRefe.pdir[!pArrive.real()].opposite().angle(!compRefe.ppos[4].direction(!compRefe.ppos[3]))

    -- Calculate the leg length
    !legLength = !compRefe.ppos[!pArrive.real()].distance(!compRefe.ppos[4])

  -- For a 90 degree bend or less
  else

    -- Calculate leg length
    !legLength = !compRefe.ppos[!pArrive.real()].distance(!compRefe.pos)

    -- Calculate the angle
    !angle = !compRefe.pdir[!pArrive.real()].opposite().angle(!compRefe.pdir[!pLeave.real()])

  endif

  -- For unset radius calculate it
  if (!compRefe.radius.eq(0)) then

    -- Calculate radius
    !radius    = (!legLength.real() / tan(!angle / 2))

  else

    -- Use radius attribute value
    !radius = !compRefe.radius

  endif

  -- Calculate the centreline length
  -- For a 180 degree bend
  if (!oneEighty) then

    -- Calculate the centreline length by calculating each half
    -- Using the arrive leg from above
    !aLength = (2 * 3.142 * !radius.real() / 360 * !angle )

    -- Using the leave leg
    !lAngle  = !compRefe.pdir[!pLeave.real()].opposite().angle(!compRefe.ppos[5].direction(!compRefe.ppos[3]))
    !lLength = (2 * 3.142 * !radius.real() / 360 * !lAngle )

    -- Add the pup lengths
    !clLength = (!aLength + !lLength) + (2 * !pupLength)

  else

    -- Add the pup lengths
    !clLength  = (2 * 3.142 * !radius.real() / 360 * !angle ) + (2 * !pupLength)

  endif

  return !clLength

endfunction
-- End of function definition for !assyBendLength()
