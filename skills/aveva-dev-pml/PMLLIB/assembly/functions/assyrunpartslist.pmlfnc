--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Run the Parts List for the current assembly
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      STRING       CE current Assembly only or ALL assemblies below the current node
--    2   R      STRING       A SINGLE report or TOTALS report
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of arrays containing the produced files
--
------------------------------------------------------------------------
define function !!assyRunPartsList(!type is STRING, !range is STRING) is ARRAY

  -- Initialise variables
  !assemblies = ARRAY()
  !allFiles   = ARRAY()

  -- Check the current element is valid
  if (!type.upCase().eq('CE') and !!ce.hardType.upCase().neq('ASMBLY')) then

    !!alert.message('It is not possible to create a parts list from the current element. Please select an assembly and try again')
    return

  elseif (!type.upCase().eq('ALL')) then

    if(!!ce.hardType.upCase().neq('ASWL') and !!ce.hardType.upCase().neq('ASMBLY')) then
      !!alert.message('It is not possible to create a parts list from the current element. Please select an assembly world or assembly and try again')
      return
    endif

  endif

  -- Type of report
  if (!type.eq('CE')) then
    !assemblies.append(!!ce)

  -- Get all assemblies below the current element
  elseif (!type.eq('ALL')) then
    !assemblies.appendArray(!!assyDrwgAsmbly(!!ce, 'DBREF'))

  else
    !!alert.error('Not a valid argument. Choose either CE or ALL.')
  endif

  -- Load the application object and the configuration file setting
  -- We will run this as though it was TTY mode since some modules will not contain the relevant toolbars
  !assyDrwgApp        = object ASSYDRWGAPPLICATION()
  !assyDrwgApp.device = 'TTY'
  !assyDrwgApp.range  = !range
  !assyDrwgApp.load()
  !assyDrwgApp.setDefaults()

  -- Add the assemblies to the object
  do !asmbly val !assemblies
    !assyDrwgApp.assemblies.append(!asmbly)
  enddo

  -- Produce the parts list(s)
  !allFiles.append(!assyDrwgApp.makePartsList())

  -- Return the created files
  return !allFiles

endfunction
-- End of function !!assyRunPartsList
