--
--
-- Description:
-- Read the defaults file DRA-GEN-SYSTEM for sheet size lookup
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Of strings in the format 'SHEETSIZE 1189 841  A0'
--
------------------------------------------------------------------------
define function !!assySizeLookUp()is ARRAY

  -- Read DRAFT system defaults file for size look-up
  !defaultFile = object FILE('%PDMSDFLTS%\DRA-GEN-SYSTEM')
  !contents    = !defaultFile.readFile()

  -- Extract sizes
  !start     = !contents.findFirst('# Sheet sizes and option gadget descriptions')
  !end       = !contents.findFirst('# Name Convention')
  !sizeList  = !contents.from(!start + 1,!end - !start - 2)

  return !sizeList

endfunction
-- End of function !!assySizeLookUp
