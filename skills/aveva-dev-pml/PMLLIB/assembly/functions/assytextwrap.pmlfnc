-- File:            assytextwrap.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 March 2001
--
--
-- Description:
-- Word wraps a cell value
--
-- ASSUMPTIONS:
-- The current element is the SLAB being tested
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       The modified passed array of row data
--
-------------------------------------------------------------------------
define function !!assyTextWrap(!dire is STRING, !limit is REAL) is ARRAY

  -- Initialise variables
  !parts = ARRAY()

  -- Determine corner for max extents
  if (!dire.eq('-Y') or !dire.eq('Y')) then
    !index = 6
  elseif (!dire.eq('-X') or !dire.eq('X')) then
    !index = 8
  endif

  -- Split the sentence down into suitably sized chunks
  do !count from 1 to 99

    -- Split the sentence into chunks
    !chunks = !!assyExtent(!limit, !index)

    -- Test for first chunk, in which case set the atex to this chunk
    if (!count.eq(1)) then
      !firstChunk = !chunks[1]
    else
      !parts.append(!chunks[1])
    endif

    -- Test for text reduced sufficiently
    if (undefined(!chunks[2])) then
      break
    endif

  enddo

  -- Set the atex to the very first chunk
  if (defined(!firstChunk)) then
    ATEX |$!firstChunk|
  endif

  return !parts

endfunction
-- End of function !!assyTextWrap
