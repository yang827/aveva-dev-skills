------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  asmblyData()                     -                   Construct
--  buildData(BOOLEAN)               ARRAY               Build data arrays for use in a column list gadget
--  clear()                          -                   Clear the object
--  getData(BOOLEAN)                 ARRAY               Get trimmed data
--  getData(DBREF,STRING)            -                   Get assembly data
--  getData(DBREF,STRING,REAL,STRING,ARRAY) -                   Get assembly data
--  remove(ARRAY,BOOLEAN)            -                   Remove entries from the data arrays
--  setDrawn(DBREF)                  -                   Set report column data
--
------------------------------------------------------------------------
------------------------------------------------------------------------
define object ASMBLYDATA

  member .dbRefes  is ARRAY

  member .sysRefs  is ARRAY

  member .names    is ARRAY

  member .status   is ARRAY

  member .drawn    is ARRAY

  member .dwgRefs  is ARRAY

  member .dwgNames is ARRAY

  member .access   is ARRAY

  member .mode     is ARRAY

  member .contents is ARRAY

  member .errors   is ARRAY

endobject
-- End of object definition for ASMBLYDATA

------------------------------------------------------------------------
--
-- Method:        .asmblyData()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .asmblyData()


endmethod
-- End of method definition for .asmblyData()

------------------------------------------------------------------------
--
-- Method:        .clear()
--
-- Description:   Clear the object
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  !this.dbRefes.clear()
  !this.sysRefs.clear()
  !this.names.clear()
  !this.status.clear()
  !this.drawn.clear()
  !this.dwgRefs.clear()
  !this.dwgNames.clear()
  !this.access.clear()
  !this.mode.clear()
  !this.contents.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:        .buildData(BOOLEAN)
--
-- Description:   Build data arrays for use in a column list gadget
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Whether the status is being reported
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .buildData(!considerStatus is BOOLEAN) is ARRAY

  -- Initialise variables
  !rowSet = ARRAY()

  -- Construct arrays
  do !index ind !this.dbRefes

    -- Initialise variables
    !row = ARRAY()

    -- Extract data for each column
    -- Name
    !row.append(!this.names[!index])

    -- Stats
    if (!considerStatus) then
      !row.append(!this.status[!index])
    endif

    -- Valid contents set to blank as an icon will be used later
    !row.append('')

    -- Drawn
    !row.append(!this.drawn[!index])

    -- User access to drawing
    !row.append(!this.access[!index])

    -- Create/update mode
    !row.append(!this.mode[!index])

    -- Add row to the row set
    !rowSet.append(!row)

  enddo

  -- Return array
  return !rowSet

endmethod
-- End of method definition for .buildData()

------------------------------------------------------------------------
--
-- Method:        .getData(BOOLEAN)
--
-- Description:   Get trimmed data
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Include STATUS or not
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getData(!includeStatus is BOOLEAN) is ARRAY

  -- Initialise variables
  if (!includeStatus) then
    !data[1]      = ARRAY()
    !data[2]      = ARRAY()
    !data[3]      = ARRAY()
    !data[4]      = ARRAY()
    !data[5]      = ARRAY()
    !dataArray[1] = !this.names
    !dataArray[2] = !this.status
    !dataArray[3] = !this.dwgNames
    !dataArray[4] = !this.access
    !dataArray[5] = !this.mode
    !dataArray[6] = !this.contents
  else
    !data[1]      = ARRAY()
    !data[2]      = ARRAY()
    !data[3]      = ARRAY()
    !data[4]      = ARRAY()
    !dataArray[1] = !this.names
    !dataArray[2] = !this.dwgNames
    !dataArray[3] = !this.access
    !dataArray[4] = !this.mode
    !dataArray[5] = !this.contents
  endif

  -- Remove leading and trailing spaces and build arrays
  do !index ind !dataArray

    do !value val !dataArray[!index]

      !data[!index].append(!value.trim('LR'))

    enddo

  enddo

  return !data

endmethod
-- End of method definition for .getData()

------------------------------------------------------------------------
--
-- Method:        .getData(DBREF,STRING)
--
-- Description:   Get assembly data
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB search point
--    2   R      STRING      Filter options
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getData(!elemRefe is DBREF, !filter is STRING)

  -- Get all assemblies
  !allAsmbly = !!assyDrwgAsmbly(!elemRefe, 'STRING')

  -- For each assembly get data Name, Status, Drwg reference, Access to drawing and update mode
  do !index ind !allAsmbly

    -- Initialise variables
    !asmblyRefe = !allAsmbly[!index].dbref()
    !links      = !!assyGetDocLink(!asmblyRefe)
    !drwgRefe   = !links[1]
    !lndescRefe = !links[2]

    -- Filter the assemblies as required
    if (!filter.eq('NOT DRAWN')) then
      if (!drwgRefe.set().not() and !drwgRefe.unset() and !drwgRefe.badref()) then
        !this.setDrawn(!asmblyRefe)
      else
        skip
      endif
    elseif (!filter.eq('DRAWN')) then
      if (!drwgRefe.set() and !drwgRefe.badref().not()) then
        !this.setDrawn(!asmblyRefe)
      else
        skip
      endif
    elseif (!filter.eq('DRAWN BY ME')) then

      -- Get this user
      !session = current session
      !userName = !session.login.upcase()

      -- Get all drwn drwgs by this user
      if (!drwgRefe.set() and !drwgRefe.badref().not() and !drwgRefe.auth.upcase().eq(!userName)) then
        !this.setDrawn(!asmblyRefe)
      else
        skip
      endif

    elseif (!filter.eq('BADREF')) then
      if (!lndescRefe.set()) then
        if (!drwgRefe.badref() and !lndescRefe.lnkref.set()) then
          !this.setDrawn(!asmblyRefe)
        else
          skip
        endif
      else
        skip
      endif

    else
      !this.setDrawn(!asmblyRefe)
    endif

    -- Store string values
    !this.sysRefs.append(!allAsmbly[!index])

    -- Store the system reference as a dbref
    !this.dbRefes.append(!asmblyRefe)

    -- Name
    if (!asmblyRefe.asname.eq('')) then
      !this.names.append(!asmblyRefe.string())
    else
      !this.names.append(!asmblyRefe.flnn)
    endif

    -- Check the assembly contents for any valid elements
    if (!asmblyRefe.sexpnd.size().eq(0)) then
      !this.contents.append(false)
    else
      !this.contents.append(true)
    endif

  enddo

endmethod
-- End of method definition for .getData(DBREF,STRING)

------------------------------------------------------------------------
--
-- Method:        .getData(DBREF,STRING,REAL,STRING,ARRAY)
--
-- Description:   Get assembly data
--
-- Method Type:   Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB search point
--    2   R      STRING      Filter options
--    3   R      REAL        Configuration status stage for drwgs that are ready for detailing
--    4   R      STRING      The ASMBLY attribute holding the status
--    5   R      ARRAY       The status stage descriptions
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getData(!elemRefe is DBREF, !filter is STRING, !status is REAL, !statusAttribute is STRING, !statusDesc is ARRAY)

  -- Get all assemblies
  !allAsmbly = !!assyDrwgAsmbly(!elemRefe, 'DBREF')

  -- For each assembly get data Name, Status, Drwg reference, Access to drawing and update mode
  do !index ind !allAsmbly

    -- Initialise variables
    !asmblyRefe = !allAsmbly[!index]
    !links      = !!assyGetDocLink(!asmblyRefe)
    !drwgRefe   = !links[1]
    !lndescRefe = !links[2]

    -- Filter the assemblies as required
    if (!filter.eq('READY')) then
      if (!drwgRefe.set().not() and !drwgRefe.unset() and !drwgRefe.badref() and !asmblyRefe.attribute(!statusAttribute).eq(!status)) then
        !this.setDrawn(!asmblyRefe)
      else
        skip
      endif
    elseif (!filter.eq('NOT DRAWN')) then
      if (!drwgRefe.set().not() and !drwgRefe.unset() and !drwgRefe.badref()) then
        !this.setDrawn(!asmblyRefe)
      else
        skip
      endif
    elseif (!filter.eq('DRAWN')) then
      if (!drwgRefe.set() and !drwgRefe.badref().not()) then
        !this.setDrawn(!asmblyRefe)
      else
        skip
      endif
    elseif (!filter.eq('DRAWN BY ME')) then

      -- Get this user
      !session = current session
      !userName = !session.login.upcase()

      -- Get all drwn drwgs by this user
      if (!drwgRefe.set() and !drwgRefe.badref().not() and !drwgRefe.auth.upcase().eq(!userName)) then
        !this.setDrawn(!asmblyRefe)
      else
        skip
      endif

    elseif (!filter.eq('BADREF')) then
      if (!lndescRefe.set()) then
        if (!drwgRefe.badref() and !lndescRefe.lnkref.set()) then
          !this.setDrawn(!asmblyRefe)
        else
          skip
        endif
      else
        skip
      endif

    else
      !this.setDrawn(!asmblyRefe)
    endif

    -- Store string values
    !this.sysRefs.append(!allAsmbly[!index])

    -- Store the system reference as a dbref
    !this.dbRefes.append(!asmblyRefe)

    -- Name
    if (!asmblyRefe.asname.eq('')) then
      !this.names.append(!asmblyRefe.string())
    else
      !this.names.append(!asmblyRefe.asname)
    endif

    -- Contents
    if (!asmblyRefe.sexpnd.size().eq(0)) then
      !this.contents.append(false)
    else
      !this.contents.append(true)
    endif

    -- Status
    !this.status.append(!statusDesc[!asmblyRefe.attribute(!statusAttribute)])

  enddo

endmethod
-- End of method definition for .getData(DBREF,STRING,REAL,STRING,ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .remove(ARRAY)
--
-- Description: Remove entries from the data arrays
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       The selected row data
--    2   R      BOOLEAN     Whether to consider status
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remove(!mainArray is ARRAY, !considerStatus is BOOLEAN)

  -- Build array of indices to remove
  !getReal = object BLOCK('!mainArray[!evalIndex].real()')
  !indices = !mainArray.evaluate(!getReal)

  -- Remove each element index from the arrays
  do !index val !indices
    !this.dbRefes.deleteFrom(!index,1)
    !this.sysRefs.deleteFrom(!index,1)
    !this.names.deleteFrom(!index,1)
    if (!considerStatus) then
      !this.status.deleteFrom(!index,1)
    endif
    !this.drawn.deleteFrom(!index,1)
    !this.dwgRefs.deleteFrom(!index,1)
    !this.dwgNames.deleteFrom(!index,1)
    !this.access.deleteFrom(!index,1)
    !this.mode.deleteFrom(!index,1)
    !this.contents.deleteFrom(!index,1)
  enddo

  -- Compress all arrays
  !this.dbRefes.compress()
  !this.sysRefs.compress()
  !this.names.compress()
  if (!considerStatus) then
    !this.status.compress()
  endif
  !this.drawn.compress()
  !this.dwgRefs.compress()
  !this.dwgNames.compress()
  !this.access.compress()
  !this.mode.compress()
  !this.contents.compress()

endmethod
-- End of method .remove(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .setDrawn(DBREF,REAL)
--
-- Description: Set report column data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Assembly element
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDrawn(!asmblyRefe is DBREF)

  -- Get any linked drawing
  !drwgRefe = !!assyGetDocLink(!asmblyRefe)[1]

  -- Has the assembly been drawn?
  -- No, it has not
  if (!drwgRefe.unset()) then
    !this.drawn.append('   No')
    !this.dwgRefs.append(object DBREF())
    !this.dwgNames.append('   -')
    !this.access.append('   -')
    !this.mode.append('Create')

  -- Does it have a bad drawing reference
  elseif (!drwgRefe.badref()) then
    !this.drawn.append('   Badref')
    !this.dwgRefs.append(object DBREF())
    !this.dwgNames.append('   Bad Reference')
    !this.access.append('   - ')
    !this.mode.append('Create')

  -- Yes, it has
  else

    -- Set drawn as yes
    !this.drawn.append('   Yes')

    -- Get access rights
    if (!asmblyRefe.dbwrite) then
      !this.access.append('   Yes')
    else
      !this.access.append('   No')
    endif

    -- Set update mode
    !this.mode.append('Update')

    -- Store drwg reference
    !this.dwgRefs.append(!drwgRefe)

    -- Store drwg name
    !this.dwgNames.append(!drwgRefe.flnn)

  endif

endmethod
-- End of method .setDrawn(DBREF,REAL)
