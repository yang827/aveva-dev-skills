--
-- Author:          Steve Wilson
-- Created:         15 December 2004
--
--
-- Description:
-- Object to define the Assembly Drawing DRAFT Add-in
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  modifyForm()                     -                   Modify Form
--  modifyMenus()                    -                   Modify menus
--  toolbars()                       -                   Creates toolbars for this application
--
------------------------------------------------------------------------
-- Define object
define object ASSEMBLYDRAWING

  member .module is MODULE

endobject

------------------------------------------------------------------------
--
-- Method:        .modifyForm()
--
-- Description:   Modify Form
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()

  -- Load the toolbars but only in Marine
  if (!this.module.productFamily.upcase().eq('MARINE')) then
    !this.toolbars()
  endif

endmethod
-- End of object definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Modify menus
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()

  -- Only for Marine
  if (!this.module.productFamily.upcase().eq('MARINE')) then

    -- Check for the existence of the standard library
    VAR !libyExists EXISTS /TT/AssemblyADP/Libraries

    -- Add to the Create menu option within the core ADP application
    !menu = object APPMENU('MBCREATE')
    !menu.insertAfter('GeneralADP', 'CALLBACK', |Assembly Deliverables...|, '!!assyDrwgMain.show()', 'Assembly')

    if (!libyExists.eq('FALSEA')) then
      !menu.insertAfter('GeneralADP', 'CALLBACK', |Assembly ADP Library...|, '!!assyDbs.show()', 'AssyLiby')
    endif

    !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

  endif

endmethod
-- End of object definition for .modifyMenus()

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()

  -- Get main form
  if (!this.module.modKey.upcase().eq('MARDRA')) then
    !form = !!appMDraMain
  else
    !form = !!appDraMain
  endif

  -- Assembly Drawing Toolbar
  frame .assyDrwgToolbar toolbar 'Assembly Drafting'

    button .assyMultiDrwg tooltip 'Multiple Drawings '   pixmap width 16 height 16
    button .assyQuickDrwg tooltip 'Draw this Assembly '  pixmap width 16 height 16
    button .assyAllDrwg   tooltip 'Draw All Assemblies ' pixmap width 16 height 16
    button .assySearch    tooltip 'Find a Drawing '      pixmap width 16 height 16
    button .assyLog       tooltip 'View Log  '           pixmap width 16 height 16

    -- Check for administrator user
    if (!!cdAdmin.boolean()) then
      button .assyTools     tooltip 'Modify Preferences '     pixmap width 16 height 16
    endif

    -- Check for Marine Drafting
    if (!this.module.modKey.upcase().neq('MARDRA')) then
      button .assyPrint     tooltip 'Print Drawing '       pixmap width 16 height 16
    endif

  exit

  -- Active Department Toolbar
  frame .assyDeptToolbar toolbar 'Assembly Department'

    button .assyHierarchy   tooltip 'Create Department '        pixmap width 16 height 16
    option .assySelectType  at xmax+0.5 width 8
    option .assyTypeList                width 35

  exit

  -- Callbacks
  !form.assyHierarchy.callback   = '!!assyDrwgHier.show()'
  !form.assyMultiDrwg.callback   = '!!assyDrwgMain.show()'
  !form.assyQuickDrwg.callback   = '!!assyDrwgMain.assyDrwgApp.quickDrwg(|CE|)'
  !form.assyAllDrwg.callback     = '!!assyDrwgMain.assyDrwgApp.quickDrwg(|ALL|)'
  !form.assySearch.callback      = '!!assyDisplay.show()'
  !form.assyLog.callback         = '!!assyDrwgMain.assyDrwgApp.showLog(|OPEN|)'

  if (!!cdAdmin.boolean()) then
  endif

  !form.assySelectType.callback  = '!!assyDrwgMain.assyDrwgApp.selectList()'
  !form.assyTypeList.callback    = '!!assyDrwgMain.assyDrwgApp.saveActive()'

  -- Add main Draft form icons
  !form.assyHierarchy.addPixmap(!!pml.getPathName('ad_t_002.png'))
  !form.assyMultiDrwg.addPixmap(!!pml.getPathName('ad_t_003.png'))
  !form.assyQuickDrwg.addPixmap(!!pml.getPathName('ad_t_004.png'))
  !form.assyAllDrwg.addPixmap(!!pml.getPathName('ad_t_005.png'))
  !form.assySearch.addPixmap(!!pml.getPathName('ad_t_006.png'))
  !form.assyLog.addPixmap(!!pml.getPathName('ad_t_009.png'))

  -- Add administrator option to modify application configuration
  if (!!cdAdmin.boolean()) then

    !form.assyTools.callback  = '!!assyDrwgMain.assyDrwgApp.showTools()'
    !form.assyTools.addPixmap(!!pml.getPathName('ad_t_007.png'))

  endif

  -- Add specific non Marine Drafting options
  if (!this.module.modKey.upcase().neq('MARDRA')) then

    -- Add printer option
    !form.assyPrint.callback = '!!assyDrwgMain.assyDrwgApp.print()'
    !form.assyPrint.addPixmap(!!pml.getPathName('ad_t_008.png'))

    -- Add toolbar
    !!appTbarCntrl.addToolbar('assyDrwgToolbar', 'ADPCORE', true)
    !!appTbarCntrl.addToolbar('assyDeptToolbar', 'ADPCORE', true)

  endif

endmethod
-- End of object definition for .toolbars()
