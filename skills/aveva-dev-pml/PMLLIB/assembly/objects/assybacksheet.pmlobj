-- Created:         Tue 03 Aug 2006
--
--
-- Description:
-- The backing sheet data, in particular the reserved areas
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getReserved(DBREF)               -                   Get data for all backing sheet reserved areas
--
------------------------------------------------------------------------
define object ASSYBACKSHEET

  -- BACK properties
  member .reference is DBREF
  member .size is ARRAY

  -- Assembly properties table
  member .asmblyArea    is DBREF
  member .asmblyOrigin  is POSITION
  member .asmblyXlen    is REAL
  member .asmblyYlen    is REAL
  member .asmblyCentre  is POSITION

  -- Parts List properties table
  member .partsArea     is DBREF
  member .partsOrigin   is POSITION
  member .partsXlen     is REAL
  member .partsYlen     is REAL
  member .partsCentre   is POSITION
  member .partsFDir     is STRING
  member .partsEntries  is REAL
  member .partsRSpa     is REAL

  -- Revision block
  member .reviArea      is DBREF
  member .reviOrigin    is POSITION
  member .reviXlen      is REAL
  member .reviYlen      is REAL
  member .reviCentre    is POSITION
  member .reviFDir      is STRING
  member .reviEntries   is REAL
  member .reviRSpa      is REAL

endobject

-----------------------------------------------------------------------
--
-- Method:      .getReserved(DBREF)
--
-- Description: Get data for all backing sheet reserved areas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getReserved(!backRefe is DBREF)

  -- Initialise
  !this.reference = !backRefe
  !this.size      = !backRefe.size

  -- Get data from the assembly attribute reserved area
  VAR !asmblyArea COLL ALL TABL WI (UPCASE(spPurp)) EQ 'ASMBLY' FOR $!backRefe
  !this.asmblyArea    = !asmblyArea[1].dbref()
  !this.asmblyOrigin  = !this.asmblyArea.ptrf.xypo
  !this.asmblyXlen    = !this.asmblyArea.xlen
  !this.asmblyYlen    = !this.asmblyArea.ylen

  -- Get the centre of the reserved area
  !this.asmblyCentre = !!assyCalcCentre(!this.asmblyArea)

  -- Get data from the parts list reserved area
  VAR !partsArea COLL ALL TABL WI (UPCASE(spPurp)) EQ 'PARTSL' FOR $!backRefe
  !this.partsArea   = !partsArea[1].dbref()
  !this.partsOrigin = !this.partsArea.ptrf.xypo
  !this.partsXlen   = !this.partsArea.xlen
  !this.partsYlen   = !this.partsArea.ylen
  !this.partsFDir   = !this.partsArea.fillDirection

  -- Get the centre of the reserved area
  !this.partsCentre = !!assyCalcCentre(!this.partsArea)

  -- Get the maximum number of entries in this table from the nrow or ncol
  -- and calculate the column width or row height
  if (!this.partsFDir.eq('RIGHT') or !this.partsFDir.eq('LEFT')) then
    !maxEntries = !this.partsArea.ncol
    !spacing    = !this.partsXlen / !maxEntries
    if (!this.partsFDir.eq('LEFT')) then
      !spacing = !spacing * -1
    endif
  elseif (!this.partsFDir.eq('UP') or !this.partsFDir.eq('DOWN')) then
    !maxEntries = !this.partsArea.nrow
    !spacing    = !this.partsYlen / !maxEntries
    if (!this.partsFDir.eq('DOWN')) then
      !spacing = !spacing * -1
    endif
  else
    !maxEntries = 0
    !spacing    = 0
  endif
  !this.partsEntries = !maxEntries.int()
  !this.partsRSpa    = !spacing

  -- Make parts list table fill direction values that can be used in commands
  if (!this.partsFDir.eq('UP') or !this.partsFDir.eq('DOWN')) then
    !this.partsFDir = 'Y'
  else
    !this.partsFDir = 'X'
  endif

  -- Get data from the revision reserved area
  VAR !reviArea COLL ALL TABL WI (UPCASE(spPurp)) EQ 'REVISI' FOR $!backRefe
  !this.reviArea   = !reviArea[1].dbref()
  !this.reviOrigin = !this.reviArea.ptrf.xypo
  !this.reviXlen   = !this.reviArea.xlen
  !this.reviYlen   = !this.reviArea.ylen
  !this.reviFDir   = !this.reviArea.fillDirection

  -- Get the centre of the reserved area
  !this.reviCentre = !!assyCalcCentre(!this.reviArea)

  -- Get the maximum number of entries in this table from the nrow or ncol
  -- and calculate the column width or row height
  if (!this.reviFDir.eq('RIGHT') or !this.reviFDir.eq('LEFT')) then
    !maxEntries = !this.reviArea.ncol
    !spacing    = !this.reviXlen / !maxEntries
    if (!this.reviFDir.eq('LEFT')) then
      !spacing = !spacing * -1
    endif
  elseif (!this.reviFDir.eq('UP') or !this.reviFDir.eq('DOWN')) then
    !maxEntries = !this.reviArea.nrow
    !spacing    = !this.reviYlen / !maxEntries
    if (!this.reviFDir.eq('DOWN')) then
      !spacing = !spacing * -1
    endif
  else
    !maxEntries = 0
    !spacing    = 0
  endif
  !this.reviEntries = !maxEntries.int()
  !this.reviRSpa    = !spacing

  -- Make revision table fill direction positive for use in commands
  if (!this.reviFDir.eq('UP') or !this.reviFDir.eq('DOWN')) then
    !this.reviFDir = 'Y'
  else
    !this.reviFDir = 'X'
  endif

endmethod
-- End of method definition for .getReserved(DBREF)
