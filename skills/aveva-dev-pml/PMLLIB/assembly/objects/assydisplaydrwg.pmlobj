-- File:            assydisplaydrwg.pmlobj
--   Type:          Object Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         Tue 03 Aug 2006
--
--
-- Description:
-- Holds the data for the drawing for display purposes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyDisplayDrwg(DBREF)           -                   Construct
--  getData()                        ARRAY               Get object data
--  getSizeCode()                    STRING              Get the drawing size code
--
------------------------------------------------------------------------
------------------------------------------------------------------------
define object ASSYDISPLAYDRWG

  member .reference  is DBREF

  member .drawingNo  is STRING

  member .asmblyRefe is DBREF

  member .type       is STRING

  member .author     is STRING

  member .date       is STRING

  member .drtmplRef  is DBREF

  member .size       is STRING

  member .access     is BOOLEAN

  member .sheets     is ARRAY

  member .rowData    is ARRAY

endobject

------------------------------------------------------------------------
--
-- Method:        .assyDisplayDrwg(DBREF)
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The drawing element
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyDisplayDrwg(!drwgRefe is DBREF)

  -- Initialise variables
  !drgNoAttrib = !!assyDrwgMain.assyDrwgApp.config.drgNoAttribute

  -- Attributes
  !this.reference  = !drwgRefe
  !this.asmblyRefe = !drwgRefe.idln
  !this.author     = !drwgRefe.auth
  !this.date       = !drwgRefe.date
  !this.drtmplRef  = !drwgRefe.linkref

  -- Get drawing type
  VAR !allSheet COLL ALL SHEE FOR $!drwgRefe
  if (!allSheet.set()) then

    -- Marine Drawing
    if (!allSheet[1].dbref().marPtype.neq(0)) then
      !this.type = 'Marine'

    -- Outfitting Drawing
    elseif (!allSheet[1].dbref().marPtype.eq(0)) then
      !this.type = 'Outfitting'
    endif

  else
    !this.type = 'Unknown'
  endif

  -- Get size from the drwg attribute, but if unset try the drtmpl
  if (!drwgRefe.size.unset()) then
    if (!drwgRefe.linkref.badref()) then
      !this.size = '0 0'
    else
      if (!drwgRefe.linkref.size.unset()) then
        !this.size = '0 0'
      else
        !this.size = !drwgRefe.linkref.size[1] & ' ' &  !drwgRefe.linkref.size[2]
      endif
    endif
  else
    !this.size = !drwgRefe.size[1] & ' ' &  !drwgRefe.size[2]
  endif

  -- Drawing number
  !this.drawingNo = !drwgRefe.attribute(!drgNoAttrib)

  -- Member Sheets
  VAR !allSheets COLL ALL SHEE WI SPPURP EQ 'ASYADP' FOR $!drwgRefe
  !extractDbref = object BLOCK('!allSheets[!evalIndex].dbref()')
  !this.sheets  = !allSheets.evaluate(!extractDbref)

  -- Get access rights
  !this.access = !drwgRefe.dbwrite

  -- Build row data
  -- Drawing number
  !this.rowData.append(!this.drawingNo)

  -- Assembly name
  if (!this.asmblyRefe.badref()) then
      !this.rowData.append('Unset')
  else
    if (!this.asmblyRefe.asname.eq('')) then
      !this.rowData.append(!this.asmblyRefe.string())
    else
      !this.rowData.append(!this.asmblyRefe.flnn)
    endif
  endif

  -- Drawing type
  !this.rowData.append(!this.type)

  -- Drawing author
  !this.rowData.append(!this.author)

  -- date drawing created
  !this.rowData.append(!this.date)

  -- Drawing template
  if (!this.drtmplRef.badref()) then
    !this.rowData.append('Bad DRWG attribute value for LinkRef')
  else
    !this.rowData.append(!this.drtmplRef.flnn)
  endif

  -- Drawing size
  !this.rowData.append(!this.getSizeCode())

  -- User access to the drawing
  if (!this.access) then
    !this.rowData.append('Yes')
  else
    !this.rowData.append('No')
  endif

endmethod
-- End of method definition for .assyDisplayDrwg(DBREF,STRING)

------------------------------------------------------------------------
--
-- Method:        .getData()
--
-- Description:   Get object data
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The drawing element
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Of ARRAYS containing report data
--
------------------------------------------------------------------------
define method .getData() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- Build array
  -- Drawing number
  !array.append(!this.drawingNo)

  -- Assembly name
  if (!this.asmblyRefe.asname.eq('')) then
    !array.append(!this.asmblyRefe.string())
  else
    !array.append(!this.asmblyRefe.asname)
  endif

  -- Drawing type
  !array.append(!this.type)

  -- Drawing author
  !array.append(!this.author)

  -- Date drawing created
  !array.append(!this.date)

  -- Drawing Template
  !array.append(!this.drtmplRef.flnn)

  -- Drawing size
  !array.append(!this.getSizeCode())

  return !array

endmethod
-- End of method definition for .getData()

------------------------------------------------------------------------
--
-- Method:        .getSizeCode()
--
-- Description:   Get the drawing size code
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      Size code e.g. 'A3'
--
------------------------------------------------------------------------
define method .getSizeCode() is STRING

  !sizeCode = STRING()

  -- Scan DRAFT system defaults file size list array for a matching size
  do !sizeDesc val !!assySizeLookUp()
    if (!sizeDesc.match(!this.size).neq(0)) then
      !sizeCode = !sizeDesc.after(!this.size).trim('lr')
      break
    endif
  enddo

  return !sizeCode

endmethod
-- End of method definition for .getSizeCode()
