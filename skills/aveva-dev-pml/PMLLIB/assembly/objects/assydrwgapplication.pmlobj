--  Created:         Mon Jul 23 17:12:41 2007

--
--  Description:     -- Assembly Main Application calls--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  active(BOOLEAN)                  -                   Make the application toolbar and main menu options active
--  addDept(DBREF)                   -                   Add the passed department and registries
--  assyDrwgApplication()            -                   Construct
--  batch(ARRAY,ARRAY,ARRAY)         -                   Run as batch
--  clear()                          -                   Clear all necessary arrays
--  createDept()                     BOOLEAN             Create a department and registry
--  getDept()                        BOOLEAN             Get all assembly departments and registries
--  getDeptNames()                   ARRAY               Get departments names
--  getDeptRefs()                    ARRAY               Get departments references
--  getDrawingSizes(REAL)            ARRAY               Get drawing template sizes for the selected type
--  getDrawingTypes()                ARRAY               Get drawing template types
--  getLalb()                        -                   Get all parts list label libraries
--  getLalbNames()                   ARRAY               Get label library names
--  getLalbRefs()                    ARRAY               Get label library references
--  getSettings()                    ARRAY               Get settings necessary for a batch run
--  getTemplates()                   BOOLEAN             Get drawing template elements
--  linkDocs(ARRAY)                  -                   Link the assembly to the produced documents
--  load()                           BOOLEAN             Load assembly drawing essentials
--  loadConfig()                     -                   Load configuration settings
--  makeDrawings()                   ARRAY               Create the drawings
--  makePartsList()                  ARRAY               Create the parts list output
--  pdf()                            -                   Create pdf output files
--  print()                          -                   Print the current displayed sheet
--  quickDrwg(STRING)                -                   Create a drawing for the current assembly
--  readConfig()                     -                   Read in relevant configuration settings
--  resetDept()                      -                   Load the dept & regi lists and refresh the toolbar & form
--  saveActive()                     -                   Save the chosen active department toolbar
--  saveSettings(ARRAY)              -                   Save the settings
--  saveTemplate(ARRAY)              -                   Save the chosen drawing template
--  selectList()                     -                   Select the list for the active department toolbar
--  setActive()                      -                   Populate the active department toolbar
--  setDefaults()                    -                   Set this object to the configuration settings
--  showLog(STRING)                  -                   Show log viewer with current log file
--  showTools()                      -                   Show the configuration settings editor
--  switchMode(STRING)               -                   Switch to a particular mode
--
-----------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            assydrwgapplication.pmlobj
--   Type:          Object Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
--
-- Description:
-- Assembly Main Application calls
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
define object ASSYDRWGAPPLICATION

  -- List of assemblies for detailing
  member .assemblies      is ARRAY
  member .updates         is ARRAY

  -- Current selected department
  member .deptIndex       is REAL

  -- Current selected registry
  member .drwgRegi        is DBREF

  -- Current selected drawing template
  member .drwgTmpl        is DBREF

  -- Create Drawing
  member .createDrawing   is BOOLEAN

  -- Drawing PDF Output
  member .drawingPdf      is BOOLEAN

  -- Plot destination folder
  member .drwgFold        is FILE

  -- Parts List Output
  member .createPartsList is BOOLEAN

  -- The parts list type
  member .plTmpl          is DBREF

  -- The parts list output types
  member .partsTxt        is BOOLEAN
  member .partsCsv        is BOOLEAN
  member .partsXls        is BOOLEAN

  -- The Parts List destination folder
  member .plFold          is FILE

  -- Data
  member .config          is ASSYDRWGCONFIG
  member .allDrtmlb       is ARRAY
  member .allDept         is ARRAY
  member .allLalb         is ARRAY

  -- Drawings
  member .drawings        is ARRAY
  member .numOfSheet      is ARRAY

  -- Parts Lists
  member .partsLists      is ARRAY

  -- Log File
  member .log             is ASSYLOG

  -- Link element
  member .linkRefe        is DBREF

  -- Device
  member .device          is STRING

  -- Module
  member .module          is ASSYMODULE

  -- Main application form
  member .appForm         is FORM

  -- Created PDF files
  member .pdfFiles        is ARRAY

  -- Is this application active?
  -- If there were no suitable departments available at start-up it will not be
  member .active          is BOOLEAN

  -- Extent of Parts List reporting when called independently of ADP
  member .range           is STRING

endobject

------------------------------------------------------------------------
--
-- Method:        .assyDrwgApplication()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyDrwgApplication()

  -- Determine the device
  VAR !device DEVICE
  !this.device = !device

  -- Determine the drafting module in which we are running
  if (!this.module.module.modkey.upCase().neq('MARHDES') and !this.module.module.modkey.upCase().neq('MARODES')) then
    if (!this.device.upCase().eq('GRAPHICS')) then
      if (!this.module.module.ddlType.eq('PADD')) then
        if (!this.module.description.eq('MARINE')) then
          !this.appForm = !!appMDraMain
        else
          !this.appForm = !!appDraMain
        endif
      endif
    endif
  endif

  -- Set the application as being active
  !this.active = true

endmethod
-- End of method definition for .assyDrwgApplication()

------------------------------------------------------------------------
--
-- Method:        .active(BOOLEAN)
--
-- Description:   Make the application toolbar and main menu options active
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Make active or inactive
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .active(!active is BOOLEAN)

  -- This application
  !this.active = !active

  -- Toolbar
  !this.appForm.assySelectType.active  = !active
  !this.appForm.assyTypeList.active    = !active
  !this.appForm.assyMultiDrwg.visible  = !active
  !this.appForm.assyQuickDrwg.visible  = !active
  !this.appForm.assyAllDrwg.visible    = !active

  -- Main menu option
  if (defined(!this.appForm.mbcreate)) then
    !this.appForm.mbcreate.setFieldProperty('Assembly','active',!active)
  endif

endmethod
-- End of method definition for .active(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .addDept(DBREF)
--
-- Description:   Add the passed department and registries
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       REGI element to add to the dept and regi options
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addDept(!regiRefe is DBREF)

  !newDept  = true
  -- Department already in list of departments
  do !deptObj val !this.allDept
     if (!deptObj.identical(!regiRefe.owne)) then
        !newDept  = false
        break
     endif
  enddo

  if (!newDept) then
     -- Build the object for the owning department
     !this.allDept.append(object ASSYDRWGDEPT(!regiRefe.owne))

     -- Sort arrays by department name
     !sorted = !this.getDeptNames().sortedIndices()
     !this.allDept.reIndex(!sorted)
  endif

  do !index ind !this.allDept
     if (!this.allDept[!index].identical(!regiRefe.owne)) then
        !this.deptIndex = !index
        break
     endif
  enddo
  !this.drwgRegi = !regiRefe

endmethod
-- End of method definition for .addDept(DBREF)

------------------------------------------------------------------------
--
-- Method:        .batch(ARRAY,ARRAY)
--
-- Description:   Run as batch
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of ASMBLY dbrefs
--    2   R      ARRAY       Array of run-time settings
--                           [1]  DBREF   The registry where to create drawings
--                           [2]  DBREF   The drawing template
--                           [3]  BOOLEAN Create Drawings?
--                           [4]  BOOLEAN Drawing PDF output?
--                           [5]  FILE    Plot destination folder
--                           [6]  BOOLEAN Create Parts List?
--                           [7]  DBREF   The parts list type library
--                           [8]  BOOLEAN Output .txt file?
--                           [9]  BOOLEAN Output .csv file?
--                           [10] BOOLEAN Output .xls file?
--                           [11] FILE    The Parts List destination folder
--    3   R      ARRAY       Array of update type for each assembly drawing, true or false
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .batch(!assemblies is ARRAY, !settings is ARRAY, !updates is ARRAY)

  -- Load this object
  !errors = !this.load()
  if (!errors) then
    -- Stop when any load errors
    !!assyLog.add('  There were problems loading because an Assembly DEPT could not be found or created, processing has been aborted')
    !!assyLog.stop()
    return
  endif

  -- Set the defaults
  !this.setDefaults()

  -- Check if the chosen REGI has been deleted since the batch file was written
  if (!settings[1].badref()) then
    !!assyLog.add('  The chosen registry REGI does not exist, processing has been aborted')
    !!assyLog.stop()
    return
  endif

  -- Load the run time settings
  !this.drwgRegi        = !settings[1]
  !this.drwgTmpl        = !settings[2]
  !this.createDrawing   = !settings[3]
  !this.drawingPdf      = !settings[4]
  !this.drwgFold        = !settings[5]
  !this.createPartsList = !settings[6]
  !this.plTmpl          = !settings[7]
  !this.partsTxt        = !settings[8]
  !this.partsCsv        = !settings[9]
  !this.partsXls        = !settings[10]
  !this.plFold          = !settings[11]

  -- Initiate the log file
  !!assyLog = object ASSYLOG()
  !!assyLog.initialise(!this.config.logFileDir)

  -- Add the assemblies to this object
  !this.assemblies.appendArray(!assemblies)

  -- Add the update types
  !this.updates = !updates

  -- Make the drawings
  if (!this.createDrawing) then
    !this.makeDrawings()
  endif

  -- Make the separate parts List
  !this.range = 'SINGLE'
  if (!this.createPartsList) then
   !partsListFiles = !this.makePartsList()
  endif

  -- Link the produced documents to the assembly
  !this.linkDocs(!partsListFiles)

  -- Terminate the log file
  !!assyPrompt('Assembly ADP processing is complete.',1)
  !!assyLog.stop()

endmethod
-- End of method definition for .batch(ARRAY,ARRAY)

------------------------------------------------------------------------
--
-- Method:        .clear()
--
-- Description:   Clear all necessary arrays
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  !this.assemblies.clear()
  !this.updates.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:        .createDept()
--
-- Description:   Create a department and registry
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if any load errors encountered
--
------------------------------------------------------------------------
define method .createDept() is BOOLEAN

  -- Initialise variables
  !session = CURRENT SESSION

  -- Get the assembly purpose and the root name from the configuration settings
  !assemblyPurp = !this.config.assemblyPurp
  !rootName     = !this.config.deptRootName

  -- Build the dept and regi names
  !deptName = !!assyBuildName('DEPT', !rootName, true)
  !regiName = !!assyBuildName('REGI', !rootName, true)

  -- Check db is open in RW
  if (!session.mode()[!session.current().findFirst(object DB(!!ce.dbname))].eq('RW')) then

    -- Access PADD db if necessary
    if (!!ce.dbType.upCase().neq('PADD')) then
      CONTEXT DRAWING
    endif

    -- Create department
    NEW DEPT $!deptName
     SPPURP $!assemblyPurp
     FUNC 'Assembly Drawings'

    NEW REGI $!regiName
     SPPURP $!assemblyPurp
     FUNC 'Assembly Drawings'

    -- Add the dept to the array
    !this.addDept(!!ce)

    -- Output a message
    !!alert.message('There were no existing departments for assemblies, therefore one has been created for you: $!deptName')

  -- Error cannot write to the first db
  else

     -- Output a message
     !!alert.error('There were no existing departments for assemblies, but it is not possible to write to the first database. Please create a department in a suitable db and start the application again.')
     return true

  endif

  return false

endmethod
-- End of method definition for .createDept()

------------------------------------------------------------------------
--
-- Method:        .getDept()
--
-- Description:   Get all assembly departments and registries
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if any load errors encountered
--
------------------------------------------------------------------------
define method .getDept() is BOOLEAN

  -- Initialise variables
  !session = CURRENT SESSION
  !errors  = false
  !this.allDept.clear()

  -- Collect all departments with a configuration purpose
  VAR !allDept COLL ALL DEPT WI SPPURP EQ '$!<this.config.assemblyPurp>'

  -- For no found departments, we need to set the toolbars active status
  if (!allDept.empty()) then

    !this.active = false
    !errors      = true

  -- For any existing departments
  else

    -- Build the object for each found department that is open in WRITE mode
    do !dept val !allDept

      if (!session.mode()[!session.current().findFirst(object DB(!dept.dbref().dbname))].eq('RW')) then
        !this.allDept.append(object ASSYDRWGDEPT(!dept.dbref()))
      endif

    enddo

    -- For no found departments, we need to set the toolbars active status
    if (!this.allDept.empty()) then
      !this.active = false
      !errors      = true
    endif

  endif

  -- Sort arrays by department name
  !sorted = !this.getDeptNames().sortedIndices()
  !this.allDept.reIndex(!sorted)

  return !errors

endmethod
-- End of method definition for .getDept()

------------------------------------------------------------------------
--
-- Method:        .getDeptNames()
--
-- Description:   Get departments names
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Dept names as STRINGs
--
------------------------------------------------------------------------
define method .getDeptNames() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- For each department
  do !deptObj val !this.allDept
    !array.append(!deptObj.name)
  enddo

  return !array

endmethod
-- End of method definition for .getDeptNames()

------------------------------------------------------------------------
--
-- Method:        .getDeptRefs()
--
-- Description:   Get departments references
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Dept references as STRINGs
--
------------------------------------------------------------------------
define method .getDeptRefs() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- For each department
  do !deptObj val !this.allDept
    !array.append(!deptObj.reference.string())
  enddo

  return !array

endmethod
-- End of method definition for .getDeptRefs()

------------------------------------------------------------------------
--
-- Method:        .getDrawingSizes(REAL)
--
-- Description:   Get drawing template sizes for the selected type
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index of selected drawing type for
--                           which to find sizes
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Drawing sizes
--
------------------------------------------------------------------------
define method .getDrawingSizes(!index is REAL) is ARRAY

  return !this.allDrtmlb[!index].getSizes()

endmethod
-- End of method definition for .getDrawingSizes(REAL)

------------------------------------------------------------------------
--
-- Method:        .getDrawingTypes()
--
-- Description:   Get drawing template types
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Drawing template descriptions
--
------------------------------------------------------------------------
define method .getDrawingTypes() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- For each drtmplb
  do !drtmlbObj val !this.allDrtmlb
    !array.append(!drtmlbObj.description)
  enddo

  return !array

endmethod
-- End of method definition for .getDrawingTypes()

------------------------------------------------------------------------
--
-- Method:        .getLalb()
--
-- Description:   Get all parts list label libraries
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getLalb()

  -- Initialise variables
  !this.allLalb.clear()

  -- Collect all label libraries with a configuration purpose
  VAR !allLalb COLL ALL LALB $!<this.config.partsListRule>

  -- Build the object for each found library
  do !lalb val !allLalb
    !this.allLalb.append(object ASSYDRWGLALB(!lalb.dbref(), !this.config.partsListDesc))
  enddo

  -- Sort arrays by library name
  !sorted = !this.getLalbNames().sortedIndices()
  !this.allLalb.reIndex(!sorted)

endmethod
-- End of method definition for .getLalb()

------------------------------------------------------------------------
--
-- Method:        .getLalbNames()
--
-- Description:   Get label library names
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Dept names as STRINGs
--
------------------------------------------------------------------------
define method .getLalbNames() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- For each library
  do !lalbObj val !this.allLalb
    !array.append(!lalbObj.name)
  enddo

  return !array

endmethod
-- End of method definition for .getLalbNames()

------------------------------------------------------------------------
--
-- Method:        .getLalbRefs()
--
-- Description:   Get label library references
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Dept references as STRINGs
--
------------------------------------------------------------------------
define method .getLalbRefs() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- For each department
  do !lalbObj val !this.allLalb
    !array.append(!lalbObj.reference.string())
  enddo

  return !array

endmethod
-- End of method definition for .getLalbRefs()

-----------------------------------------------------------------------
--
-- Method:      .getSettings()
--
-- Description: Get settings necessary for a batch run
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Form settings
--                [1]  The registry where to create drawings
--                [2]  The drawing template
--                [3]  Create Drawings?
--                [4]  Drawing PDF output?
--                [5]  Plot destination folder
--                [6]  Create Parts List?
--                [7]  The parts list type library
--                [8]  Output .txt file?
--                [9]  Output .csv file?
--                [10] Output .xls file?
--                [11] The Parts List destination folder
--                [12] The Batch file destination folder
--
------------------------------------------------------------------------
define method .getSettings() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- Registry
  !array.append(!this.drwgRegi)

  -- Drawing Template
  !array.append(!this.drwgTmpl)

  -- Drawing and Pdf output
  !array.append(!this.createDrawing)
  !array.append(!this.drawingPdf)
  !array.append(!this.drwgFold)

  -- Parts List output
  !array.append(!this.createPartsList)
  !array.append(!this.plTmpl)
  !array.append(!this.partsTxt)
  !array.append(!this.partsCsv)
  !array.append(!this.partsXls)
  !array.append(!this.plFold)

  -- Batch file folder
  !array.append(!this.config.batchFileDir)

  return !array

endmethod
-- End of method .getSettings()

------------------------------------------------------------------------
--
-- Method:        .getTemplates()
--
-- Description:   Get drawing template elements
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if any load errors encountered
--
------------------------------------------------------------------------
define method .getTemplates() is BOOLEAN

  -- Initialise variables
  !errors = false

  -- Get all drawing template libraries with the passed purpose
  -- Each library relates directly to a drawing type
  VAR !allLiby COLL ALL DRTMLB $!<this.config.libraryRule>

  -- Build the object for each found library
  do !liby val !allLiby
    !this.allDrtmlb.append(object ASSYDRWGDRTMLB(!liby.dbref(), !this.config.descAttribute))
  enddo

  -- When some templates have been found
  if (!this.allDrtmlb.empty()) then
    !errors = true
  endif

  return !errors

endmethod
-- End of method definition for .getTemplates()

------------------------------------------------------------------------
--
-- Method:        .linkDocs()
--
-- Description:   Link the assembly to the produced documents
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Parts List file objects
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .linkDocs(!partsListFiles is ARRAY)

  -- Initialise variables
  !linkDescRule = !this.config.linkDescRule
  !lnfoldName = '/Assembly/Document-Links/ADP'

  -- Get the link location
  VAR !linkDoc COLL ALL $!linkDescRule

  -- Access the found link location
  if (!linkDoc.empty()) then
    !!assyLog.add('  WARNING: Unable to create the document link in the location set by the configuration settings.')

    -- Try to find any writable document link world
    VAR !linkWorld COLL ALL LINKWL WITH DBWRITE EQ TRUE

    if (!linkWorld.empty()) then
      !!assyLog.add('  WARNING: Unable to find any writable Link World. Aborting linking...')
      return
    endif

    -- Access the link world
    !!ce = !linkWorld[1].dbref()

    -- Create a new folder for the links
    NEW LNFOLD
      DESC 'Assembly ADP Links'
      FUNC 'Assembly ADP'

    -- Name the folder if possible
    NAME $!lnfoldName
      handle (41,12)
        -- Name already used
      endhandle

    !!assyLog.add('  WARNING: Document links have been created in ' & !!ce.flnm)

  else
    !!ce = !linkDoc[1].dbref()
  endif

  -- Create the link from the assembly to the drawing and parts lists
  -- This is regarded as a user function as they might wish to modify its methodology
  !!assyPrompt('Building links between the assemblies and their associated documents.',1)
  !!assyLog.add('  Building links between the assemblies and their associated documents.')
  !!assyDocLink(!this.assemblies, !this.drawings, !this.updates, !partsListFiles, !this.pdfFiles)

  -- Keep the created links in case of later errors
  SAVEWORK

endmethod
-- End of method definition for .linkDocs()

------------------------------------------------------------------------
--
-- Method:        .load()
--
-- Description:   Load assembly drawing essentials
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if any load errors encountered
--
------------------------------------------------------------------------
define method .load() is BOOLEAN

  -- Initialise variables
  !this.allDrtmlb.clear()

  -- Load configuration file
  !this.loadConfig()

  -- Read configuration settings
  !this.readConfig()

  -- Find drawing templates
  if (!this.getTemplates()) then
    -- Stop when no templates have been found
    if (!this.device.upCase().eq('GRAPHICS')) then
      !!alert.warning('  Could not locate the Assembly ADP libraries. Please contact your System Administrator.')
    else
      !!assyLog.add('  Could not locate the Assembly ADP libraries. Please contact your System Administrator.')
    endif
    return true
  endif

  -- Find Parts List Label Libraries
  !this.getLalb()

  -- Find Department and registries
  if (!this.getDept()) then
    -- Stop when any department errors i.e. No db's to create a default one
    return true
  endif

  -- Set the toolbars active status
  if (!this.deptIndex.unset() and !this.device.neq('TTY')) then
    !this.active(true)
    !this.setActive()
  endif

  return false

endmethod
-- End of object definition for .load()

------------------------------------------------------------------------
--
-- Method:        .loadConfig()
--
-- Description:   Load configuration settings
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadConfig()

  -- Initialise variables
  !configFile = object FILE('%PDMSDFLTS%\assembly\assydrwg.cfg')

  -- Read configuration file
  if (!configFile.exists()) then
    !this.config.read(!configFile)
  else
    !!alert.warning('Unable to find the configuration file %PDMSDFLTS%\assembly\assydrwg.cfg. Using system defaults')
    !this.config.system()
  endif

endmethod
-- End of object definition for .loadConfig()

------------------------------------------------------------------------
--
-- Method:        .makeDrawings()
--
-- Description:   Create the drawings
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Drwg references
--
------------------------------------------------------------------------
define method .makeDrawings() is ARRAY

  -- Initialise variables
  !this.drawings.clear()
  !drwgRefs = ARRAY()

  -- Access Registry
  REGIS $!<this.drwgRegi>

  -- Store 50% of a drawing
  if (!this.device.upCase().eq('GRAPHICS')) then
    !!assyProgress.setPercent(1 / !this.assemblies.size() * 50)
  endif

  -- For each assembly
  do !index ind !this.assemblies

    -- Send message
    !!assyPrompt('Processing Drawing ' & !index & ' of ' & !this.assemblies.size(),1)
    !!assyPrompt(' ',2)

    -- Producing the drawing constitutes 50% of each completed drwg and the other 50% is update design
    if (!this.device.upCase().eq('GRAPHICS')) then

      -- Set the progress
      !percentComplete = !!assyProgress.percentComplete + !!assyProgress.percentage
      !!assyProgress.setMeter(!percentComplete)
      !!fmsys.setProgress(!percentComplete)

      -- Check for interrupt
      if (!!fmsys.interrupt()) then
        if !!alert.confirm('Sure you want to quit the task?',0.5, 0.5) eq 'YES' then
          break
        endif
      endif

    endif

    -- Initialise variables
    !asmblyRefe = !this.assemblies[!index]

    -- Build drawing object and create the drwg
    !drwgObj = object ASSYDRWG(!this.drwgTmpl, !asmblyRefe, !this.updates[!index])
    !this.drawings.append(!drwgObj)

    -- Get drwg reference
    !drwgRefs.append(!drwgObj.reference)

  enddo

  -- Output drawing to pdf
  if (!this.drawingPdf) then
    !this.pdf()
  endif

  -- Return drawing references for display
  return !drwgRefs

endmethod
-- End of object definition for .makeDrawings()

------------------------------------------------------------------------
--
-- Method:        .makePartsList()
--
-- Description:   Create the parts list output
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY        ARRAY of the created Excel files grouped by assembly
--
------------------------------------------------------------------------
define method .makePartsList() is ARRAY

  -- Initialise variables
  !files = ARRAY()
  !this.partsLists.clear()

  -- Ensure that the destination folder exists
  if (!this.plFold.exists().not()) then

    -- Create the folder
    !folderPath = !this.plFold.directory().fullName() & '\' & !this.plFold.entry()
    SYSCOM 'mkdir "$!folderPath"'

  endif

  -- For each assemblies
  do !index ind !this.assemblies

    -- Initialise variables
    !files[!index] = ARRAY()

    -- Send message
    !!assyPrompt('Producing Parts List ' & !index & ' of ' & !this.assemblies.size(),1)
    !!assyPrompt(' ',2)

    -- Set the progress
    if (!this.device.upCase().eq('GRAPHICS')) then
      !percentComplete = (100 / !this.assemblies.size()) * !index
      !!assyProgress.setMeter(!percentComplete)
      !!fmsys.setProgress(!percentComplete)
    endif

    -- Initialise variables
    !asmblyRefe = !this.assemblies[!index]

    -- Build root name and pass to the parts list form
    !rootName = !!assyRootName(!asmblyRefe)

    -- Build object
    !partsListObj            = object ASSYPARTSLIST(!this.plFold, !rootName)
    !partsListObj.range      = !this.range
    !partsListObj.asmblyRefe = !asmblyRefe

    -- Build the parts list data
    !partsListObj.build(!this.plTmpl, !this.config.asmblyAttRule, !this.config.partsAttRule, !this.partsXls)

    -- Output report to text file .txt
    if (!this.partsTxt) then
      !files[!index].append(!partsListObj.saveToTxt())
    endif

    -- Output report to comma separated variable file .csv
    if (!this.partsCsv) then
      !files[!index].appendArray(!partsListObj.saveToCsv())
    endif

    -- Output report to Excel file .xls
    if (!this.partsXls) then

      !files[!index].appendArray(!partsListObj.saveToExcel())

      -- FOR TESTING ONLY, the data is written and displayed in a form
--    !reportForm = !!assyPartsList
--    !reportForm.setData(!rootName)
--    !reportForm.setData(!this.plFold)
--    !reportForm.saveToExcel('DATA')
--    !reportForm.saveToExcel('PARTS')

    endif

    -- Store object here in case they are needed later
    !this.partsLists.append(!partsListObj)

  enddo

  return !files

endmethod
-- End of object definition for .makePartsList()

------------------------------------------------------------------------
--
-- Method:        .pdf(DBREF)
--
-- Description:   Create pdf output files
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pdf()

  -- Initialise variables
  !this.pdfFiles.clear()

  -- Build folder path name
  !folderPath = !this.drwgFold.directory().fullName() & '\' & !this.drwgFold.entry()

  -- Ensure that the destination folder exists
  if (!this.drwgFold.exists().not()) then

    -- Create the folder
    SYSCOM 'mkdir "$!folderPath"'

  endif

  -- For each drawing
  do !index ind !this.drawings

    -- Send message
    !!assyPrompt('Producing PDF file ' & !index & ' of ' & !this.drawings.size(),1)
    !!assyPrompt(' ',2)

    -- Initialise variables
    !drwgObj = !this.drawings[!index]
    !allPdfs = ARRAY()

    -- For each sheet
    do !sheetObj val !drwgObj.sheets

      -- Build plotfile path name
      !sheetRefe     = !sheetObj.reference
      !sheetName     = !sheetRefe.flnn.replace('\','_').replace('/','_').replace('.','_')
      !pdfPathName   = !folderPath & '\' & !sheetName & '_' & !!assyDateStamp() & '.pdf'

      -- Plot to PDF depending upon module
      -- Marine Drafting
      if (!this.module.description.eq('MARINE')) then

        !!assyMarPdf(!sheetRefe, !pdfPathName)

      -- Outfitting Draft
      else

        -- Plot sheet, whilst converting any white colours to black
        PLOT $!sheetRefe PDF /$!pdfPathName 'COL COLOURPLUS' OVERWRITE

      endif

      -- Store the sheet pdf file for this drawing
      !allPdfs.append(!pdfPathName)

    enddo

    -- Store all pdfs for this drawing
    !this.pdfFiles.append(!allPdfs)

  enddo

endmethod
-- End of object definition for .pdf(DBREF)

-----------------------------------------------------------------------
--
-- Method:      .print()
--
-- Description: Print the current displayed sheet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .print()

  -- Get the displayed sheet
  !sheeRefe = !!cdrcadcga1.n1addName.dbref()

  -- Test for empty display
  if (!sheeRefe.unset()) then

    -- Try for the current element
    if (!!ce.type.upCase().eq('SHEE')) then
      !answer = !!alert.confirm('Unable to find a displayed sheet. Do you want to print the current sheet?')
      if (!answer.eq('YES')) then
        !sheeRefe = !!ce
      else
        return
      endif
    else
      !answer = !!alert.warning('Unable to find a sheet to print. Please select one and try again.')
      return
    endif
  endif

  -- No need to set the dialog option
  !dialogOption = ''

  -- Set colour output
  if (!!assyDisplay.bw.val) then

    -- Print in black & white
    !colourOption = 'COL BW,'

  else

    -- Print colours, but switch any white to black
    !colourOption = 'COL COLOURPLUS,'

  endif

  -- Set scale
  if (!!assyDisplay.fit.val) then

    -- Scale to fit the printer paper size
    !scaleOption = 'REDUCE'

  else

    -- Print full size
    !scaleOption = ''

  endif

  -- Submit the currently displayed sheet to printer
  !this.module.submitToPrinter(!sheeRefe, !colourOption, !dialogOption, !scaleOption)

endmethod
-- End of method .print()

------------------------------------------------------------------------
--
-- Method:        .quickDrwg()
--
-- Description:   Create a drawing for the current assembly
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      CE  Create a drawing for the current element only
--                           ALL Create drawings for all assembly in the hierarchy below the current element
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .quickDrwg(!what is STRING)

  -- Initialise variables
  !partsListFiles = ARRAY()
  !ceRefe         = !!ce

  -- Check the current element is valid
  if (!what.eq('CE') and !!ce.hardType.upCase().neq('ASMBLY')) then
    !!alert.message('The current element is not an assembly. Please select one and try again')
    return

  elseif (!what.eq('ALL')) then

    if(!!ce.hardType.upCase().neq('ASWL') and !!ce.hardType.upCase().neq('ASMBLY')) then
      !!alert.message('It is not possible to create assembly drawings from the current element. Please select an assembly and try again')
      return
    endif

  endif

  -- Initiate a log file
  !!assyLog = object ASSYLOG()
  !!assyLog.initialise(!this.config.logFileDir)

  -- Initialise variables
  !this.assemblies.clear()
  !this.updates.clear()

  -- For current element only
  if (!what.eq('CE')) then

    -- Get any linked drawing
    !drwgRefe = !!assyGetDocLink(!!ce)[1]

    -- Test whether this assembly has already been drawn
    if (!drwgRefe.badref()) then
      !this.assemblies.append(!!ce)
    else
      !!alert.error('This assembly already has an associated drawing. See DRWG ' & !drwgRefe.flnm)
      !!assyLog.add('  The assembly ' & !!ce.flnm & ' already has an associated drawing.')
      !!assyLog.add('   See DRWG ' & !drwgRefe.flnm)
      !!assyLog.add('    Creation process has been aborted.')
      !!assyLog.stop()
      !this.log = !!assyLog

      !!ce = !drwgRefe
      return
    endif

  -- Get all assemblies below the current element
  else

    -- Check whether any drawings have already been drawn, in which case ignore them
    do !asmblyRefe val !!assyDrwgAsmbly(!!ce, 'DBREF')

      -- Get any linked drawing
      !drwgRefe = !!assyGetDocLink(!asmblyRefe)[1]

      -- If not drawn
      if (!drwgRefe.badref()) then
        !this.assemblies.append(!asmblyRefe)
      else
        !!assyLog.add('  The assembly ' & !asmblyRefe.flnm & ' already has an associated drawing and has been ignored.')
        !!assyLog.add('    See DRWG ' & !drwgRefe.flnm)
        skip
      endif

    enddo

  endif

  -- Check if the chosen REGI has been deleted since the application was loaded
  if (!this.drwgRegi.badref()) then

    -- Prompt and log messages
    !!alert.error('The chosen registry REGI does not exist, please reselect and try again.')
    !!assyLog.add('  The chosen registry REGI does not exist, processing has been aborted')

    -- Stop the log
    !!assyLog.stop()
    !this.log = !!assyLog

    -- Reload the dept & regi list
    !this.resetDept()

    -- Done
    return

  endif

  -- Show progress form
  !!assyProgress.show('CEN',0.5,0.5)
  !!assyProgress.show('CEN',0.5,0.5)

  -- Send message
  !!assyPrompt('Processing, Please Wait...',1)

  -- Set each assembly update mode to false as we are only creating drawings via this option
  do from 1 to !this.assemblies.size()
   !this.updates.append(false)
  enddo

  -- Make drawings
  if (!this.createDrawing) then
    !drwgRefs = !this.makeDrawings()
  endif

  -- Make the separate parts List
  !this.range = 'SINGLE'
  if (!this.createPartsList) then
    !partsListFiles = !this.makePartsList()
  endif

  -- Link the produced documents to the assembly
  !this.linkDocs(!partsListFiles)

  -- Stop the log file
  !!assyLog.stop()

  -- Store log file for a toolbar call
  !this.log = !!assyLog

  -- Hide the progress form
  !!assyPrompt('DISMISS',1)
  !!assyProgress.hide()
  !!fmsys.setProgress(-1)

  -- Return to the original element
  if (!ceRefe.badref().not()) then
    !!ce = !ceRefe
  endif

  -- Display the first drawing
  if (!this.createDrawing) then

    -- Display the drawings via the search tool if available
    if (!!assyDisplay.shown()) then

      !!assyDisplay.loadDrawings(!drwgRefs)

    -- Display the first drawing directly
    else

      -- Get first sheet of first drawing
      !sheeRefe = SHEE 1 OF $!drwgRefs[1]

      -- Get to padd db commands
      !this.switchMode('PADD')

      -- Put sheet into the main Draft display
      !this.module.displaySheet(!sheeRefe)

    endif

  endif

endmethod
-- End of object definition for .quickDrwg(DBREF)

-----------------------------------------------------------------------
--
-- Method:      .readConfig()
--
-- Description: Read in relevant configuration settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readConfig()

  -- Create drawings
  !this.createDrawing   = !this.config.createDrawing

  -- Drawing PDF Output
  !this.drawingPdf      = !this.config.drawingPdf

  -- Plot destination folder
  !this.drwgFold        = !this.config.drawingDirectory

  -- Parts List Output
  !this.createPartsList = !this.config.createPartsList

  -- The parts list output types
  !this.partsTxt        = !this.config.partsListTxt
  !this.partsCsv        = !this.config.partsListCsv
  !this.partsXls        = !this.config.partsListXls

  -- The Parts List destination folder
  !this.plFold          = !this.config.partsListDir

endmethod
-- End of object definition for .readConfig()

-----------------------------------------------------------------------
--
-- Method:      .resetDept()
--
-- Description: Load the dept & regi lists and refresh the toolbar & form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .resetDept()

  -- Reload the dept & regi list
  !this.getDept()

  -- Reset the toolbar
  !this.setActive()

  -- Reset the main form
  !!assyDrwgMain.setDept()
  !!assyDrwgMain.setRegi()

endmethod
-- End of object definition for .resetDept()

-----------------------------------------------------------------------
--
-- Method:      .saveActive()
--
-- Description: Save the chosen active department toolbar
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveActive()

  -- Initialise variables
  !index = !this.appForm.assyTypeList.val

  -- Department
  if (!this.appForm.assySelectType.selection().upCase().eq('DEPARTMENT')) then

    -- Save this department and it's first registry as the active ones
    !this.deptIndex = !index
    !this.drwgRegi  = !this.allDept[!index].allRegi[1]

  -- Registry
  -- Populate the list with the available registries for the selected department
  else

    -- Save this registry as the active one
    !this.drwgRegi = !this.allDept[!this.deptIndex].allRegi[!index]

  endif

  -- Update the main form
  if (!!assyDrwgMain.shown()) then
    !!assyDrwgMain.setDept()
    !!assyDrwgMain.setRegi()
  endif

endmethod
-- End of object definition for .saveActive()

------------------------------------------------------------------------
--
-- Method:        .saveSettings(ARRAY)
--
-- Description:   Save the settings
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       [1]  REAL Index of selected department
--                           [2]  REAL Index of selected drawing template library
--                           [3]  REAL Index of selected drawing template library
--                           [4]  REAL Index of selected drawing size
--                           [5]  BOOLEAN Whether to create assembly drawings
--                           [6]  BOOLEAN Whether to create a drawing in pdf format
--                           [7]  FILE Destination folder for drawing plots
--                           [8]  BOOLEAN Whether to create a parts list
--                           [9]  REAL Index of selected parts list type
--                           [10] BOOLEAN Whether to create a parts list in txt format
--                           [11] BOOLEAN Whether to create a parts list in csv format
--                           [12] BOOLEAN Whether to create a parts list in xls format
--                           [13] FILE Destination folder for parts list files
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveSettings(!settings is ARRAY)

  -- The registry
  !this.drwgRegi        = !this.allDept[!settings[1]].allRegi[!settings[2]]

  -- Get the drawing template from the type and size
  !this.drwgTmpl        = !this.allDrtmlb[!settings[3]].allDrtmpl[!settings[4]].reference

  -- Create assembly drawings
  !this.createDrawing   = !settings[5]

  -- Create a drawing in PDF output
  !this.drawingPdf      = !settings[6]

  -- Plot destination folder
  !this.drwgFold        = !settings[7]

  -- Create a parts list
  !this.createPartsList = !settings[8]

  -- The parts list type
  !this.plTmpl = !this.allLalb[!settings[9]].reference

  -- The output types
  !this.partsTxt        = !settings[10]
  !this.partsCsv        = !settings[11]
  !this.partsXls        = !settings[12]

  -- The Parts List destination folder
  !this.plFold          = !settings[13]

endmethod
-- End of object definition for .saveSettings(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .saveTemplate()
--
-- Description: Save the chosen drawing template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      [1]  REAL Index of selected drawing template library
--                          [2]  REAL Index of selected drawing size
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveTemplate(!settings is ARRAY)

  -- Get the drawing template from the type and size
  !this.drwgTmpl = !this.allDrtmlb[!settings[1]].allDrtmpl[!settings[2]].reference

endmethod
-- End of object definition for .saveTemplate(ARRAY)

-----------------------------------------------------------------------
--
-- Method:      .selectList()
--
-- Description: Select the list for the active department toolbar
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectList()

  -- Department
  -- Populate the list with available departments
  if (!this.appForm.assySelectType.selection().upCase().eq('DEPARTMENT')) then

    -- Get department names and refs
    !dtext = !this.getDeptNames()
    !rtext = !this.getDeptRefs()

    -- Sort text
    !sorted = !dtext.sortedIndices()
    !dtext.reIndex(!sorted)
    !rtext.reIndex(!sorted)

    -- Populate gadget
    !this.appForm.assyTypeList.dtext = !dtext
    !this.appForm.assyTypeList.rtext = !rtext

    -- Save first department and it's first registry as the active ones
    !this.deptIndex = 1

  -- Registry
  -- Populate the list with the available registries for the selected department
  else

    -- Get registry names and refs
    !dtext = !this.allDept[!this.deptIndex].getRegiNames()
    !rtext = !this.allDept[!this.deptIndex].getRegiStrgRefs()

    -- Sort text
    !sorted = !dtext.sortedIndices()
    !dtext.reIndex(!sorted)
    !rtext.reIndex(!sorted)

    -- Populate the gadget
    !this.appForm.assyTypeList.dtext = !dtext
    !this.appForm.assyTypeList.rtext = !dtext

  endif

  -- Save first registry as the active one
  !this.drwgRegi = !this.allDept[!this.deptIndex].allRegi[1]

  -- Update the main form
  if (!!assyDrwgMain.shown()) then
    !!assyDrwgMain.setDept()
    !!assyDrwgMain.setRegi()
  endif

endmethod
-- End of object definition for .selectList()

-----------------------------------------------------------------------
--
-- Method:      .setActive()
--
-- Description: Populate the active department toolbar
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setActive()

  -- Initialise variables
  !dtext = ARRAY()

  -- Set Type options
  !dtext.append('Department')
  !dtext.append('Registry')
  !this.appForm.assySelectType.dtext = !dtext

  -- Populate the type list with the departments
  !this.appForm.assyTypeList.dtext = !this.getDeptNames()
  !this.appForm.assyTypeList.rtext = !this.getDeptRefs()

  -- Save first department and it's first registry as the active ones
  !this.deptIndex = 1
  !this.drwgRegi  = !this.allDept[!this.deptIndex].allRegi[1]

endmethod
-- End of object definition for .setActive()

-----------------------------------------------------------------------
--
-- Method:      .setDefaults()
--
-- Description: Set this object to the configuration settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDefaults()

  -- Initialise variables
  !array = ARRAY()

  -- [1] The department
  !array.append(1)

  -- [2] The registry
  !array.append(1)

  -- [3] The drawing type
  !allTypes = !this.getDrawingTypes()
  if (!allTypes.find(!this.config.preferredType).set()) then
    !typeIndex = !allTypes.find(!this.config.preferredType)[1]
    !array.append(!typeIndex)
  else
    !typeIndex = 1
    !array.append(1)
  endif

  -- [4] The drawing size
  !allSizes = !this.getDrawingSizes(!typeIndex)
  if (!allSizes.find(!this.config.preferredSize).set()) then
    !array.append(!allSizes.find(!this.config.preferredSize)[1])
  else
    !array.append(1)
  endif

  -- [5] Create Drawings
  !array.append(!this.config.createDrawing)

  -- [6] Drawing PDF Output
  !array.append(!this.config.drawingPdf)

  -- [7] Plot destination folder
  !array.append(!this.config.drawingDirectory)

  -- [8] The parts list output
  !array.append(!this.config.createPartsList)

  -- [9] The parts list type
  !allNames = !this.getLalbNames()
  if (!allNames.find(!this.config.preferredPart).set()) then
    !array.append(!allNames.find(!this.config.preferredPart)[1])
  else
    !array.append(1)
  endif

  -- [10-12] The parts list output types
  !array.append(!this.config.partsListTxt)
  !array.append(!this.config.partsListCsv)
  !array.append(!this.config.partsListXls)

  -- [13] The Parts List destination folder
  !array.append(!this.config.partsListDir)

  -- Run object save
  !this.saveSettings(!array)

endmethod
-- End of method .setDefaults()

-----------------------------------------------------------------------
--
-- Method:      .showLog(STRING)
--
-- Description: Show log viewer with current log file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      OPEN   Attempt to open the log file
--                           BROWSE Browse for a log file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showLog(!option is STRING)

  import 'pmlFileBrowser'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  -- Test for no current log file, in which case browse for one
  if (!this.log.file.exists().not() or !this.log.file.unset() or !option.eq('BROWSE')) then

    -- Initialise variables
    !browser = object PMLFILEBROWSER('OPEN')
    !folder  = !this.config.logFileDir

    -- Create the configuration folder if necessary
    if (!folder.exists().not()) then
      !folderPath = !folder.directory().fullName() & '\' & !folder.entry()
      SYSCOM 'mkdir "$!folderPath"'
    endif

    -- Initialise variables
    !directory       = !this.config.logFileDir.fullName()
    !seedFile        = ' '
    !title           = 'Assembly Drawing Log File'
    !extensionString = 'txt files (*.txt)|*.txt'

    -- Show Browser
    !browser.show(!directory, !seedFile, !title, false ,!extensionString , 2)

    -- Test for no returned file name
    if (!browser.file().neq('')) then

      -- Read the log file and display the log file viewer
      !!assyLogViewer.read(object FILE(!browser.file()))
      !!assyLogViewer.show(|CEN|,0.5,0.25)

    endif

  else

    -- Pass the log object
    !!assyLogViewer.log = !this.log

    -- Show form
    !!assyLogViewer.show('CEN',0.5,0.25)

  endif

endmethod
-- End of method .showLog(STRING)

-----------------------------------------------------------------------
--
-- Method:      .showTools()
--
-- Description: Show the configuration settings editor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showTools()

  -- Test for unload form
  if (undefined(!!assyDrwgConfig)) then
    pml load form !!assyDrwgConfig
  endif

  -- Show form
  !!assyDrwgConfig.show()

endmethod
-- End of method .showTools()

-----------------------------------------------------------------------
--
-- Method:      .switchMode()
--
-- Description: Switch to a particular mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      PADD
--                           DESI
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .switchMode(!requiredType is STRING)

  -- Get current database type
  !dbType = !!ce.dbType

  -- Access required type
  if (!requiredType.upCase().eq('DESI') and !dbType.eq('PADD')) then
    CONTEXT DESIGN
  elseif (!requiredType.upCase().eq('PADD') and !dbType.eq('DESI')) then
    CONTEXT DRAWING
  endif

endmethod
-- End of method .switchMode()
