-- File:            assydrwgconfig.pmlobj
--   Type:          Object Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         04 August 2006
--
--
-- Description:
-- Object to define the configuration settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyDrwgConfig()                 -                   Construct
--  getSettings()                    ARRAY               Get Configuration settings
--  read(FILE)                       -                   Read passed configuration file
--  save(ARRAY)                      -                   Save passed settings
--  setStatus()                      -                   Set the status descriptions
--  system()                         -                   Use system defaults
--  write()                          -                   Write the configuration settings to file
--
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Define object
define object ASSYDRWGCONFIG

  -- Configuration file
  member .file       is FILE

  -- Configuration settings
  member .createDrawing    is BOOLEAN
  member .libraryRule      is STRING
  member .descAttribute    is STRING
  member .preferredType    is STRING
  member .preferredSize    is STRING
  member .drgNoAttribute   is STRING
  member .assemblyPurp     is STRING
  member .drawingPdf       is BOOLEAN
  member .drawingDirectory is FILE
  member .createPartsList  is BOOLEAN
  member .partsListRule    is STRING
  member .partsListDesc    is STRING
  member .preferredPart    is STRING
  member .asmblyAttRule    is STRING
  member .partsAttRule     is STRING
  member .partsListTxt     is BOOLEAN
  member .partsListCsv     is BOOLEAN
  member .partsListXls     is BOOLEAN
  member .partsListDir     is FILE
  member .deptRootName     is STRING
  member .logFileDir       is FILE
  member .batchFileDir     is FILE
  member .linkDescRule     is STRING

  -- Status, used to filter the assembly list
  -- This is temporary for 12.0 until F537 becomes available
  member .considerStatus   is BOOLEAN
  member .statusAttribute  is STRING
  member .detailStatusAt   is REAL
  member .statusDesc       is ARRAY

  -- Comment lines
  member .comments         is ARRAY

  -- Settings
  member .setLocs          is ARRAY

  -- Date when the configuration file was last modified
  member .lastMod          is DATETIME

endobject
-- End of object definition for ASSYDRWGCONFIG

------------------------------------------------------------------------
--
-- Method:        .assyDrwgConfig()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyDrwgConfig()

endmethod
-- End of method definition for .assyDrwgConfig()

------------------------------------------------------------------------
--
-- Method:      .getSettings()
--
-- Description: Get Configuration settings
--
-- Method Type: Method/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array containing configuration settings
--
------------------------------------------------------------------------
-- Define method
define method .getSettings() is ARRAY

  -- Initialise variables
  !settings = ARRAY()

  -- Build array
  !settings.append(!this.createDrawing)
  !settings.append(!this.libraryRule)
  !settings.append(!this.descAttribute)
  !settings.append(!this.preferredType)
  !settings.append(!this.preferredSize)
  !settings.append(!this.drgNoAttribute)
  !settings.append(!this.assemblyPurp)
  !settings.append(!this.drawingPdf)
  !settings.append(!this.drawingDirectory)
  !settings.append(!this.createPartsList)
  !settings.append(!this.partsListRule)
  !settings.append(!this.partsListDesc)
  !settings.append(!this.preferredPart)
  !settings.append(!this.asmblyAttRule)
  !settings.append(!this.partsAttRule)
  !settings.append(!this.partsListTxt)
  !settings.append(!this.partsListCsv)
  !settings.append(!this.partsListXls)
  !settings.append(!this.partsListDir)
  !settings.append(!this.deptRootName)
  !settings.append(!this.logFileDir)
  !settings.append(!this.batchFileDir)
  !settings.append(!this.linkDescRule)
  !settings.append(!this.considerStatus)
  !settings.append(!this.statusAttribute)
  !settings.append(!this.detailStatus)

  -- Return array
  return !settings

endmethod
-- End of method definition for .getSettings()

------------------------------------------------------------------------
--
-- Method:      .read(FILE)
--
-- Description: Read passed configuration file
--
-- Method Type: Method/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        The configuration file object
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .read(!file is FILE)

  -- Initialise variables
  !this.comments.clear()
  !this.setLocs.clear()
  !this.statusDesc.clear()
  !contents = ARRAY()

  -- Store configuration file
  !this.file = !file

  -- Read file
  !content = !this.file.readfile()

  -- Look for status stage descriptions
  -- We do this before we strip out the comment lines beginning with a hash code
  -- as the start and end of the status definitions are comments in themselves
  -- Read first line of status definition
  !start = !content.findFirst('# <Start of status descriptions>')
  if (!start.unset()) then
    !this.setStatus()
  else

    -- Read last line of status definition
    !end  = !content.findFirst('# <End of status descriptions>')
    if (!end.unset()) then
      !this.setStatus()
    else

      -- Load the status definitions
      do !index from !start + 1 to !end - 1
        !this.statusDesc.append(!content[!index].after('=').trim('lr'))
      enddo

    endif

  endif

  -- Process the configuration file
  do !index ind !content

    -- Initialise variables
    !entry = !content[!index]

    -- Get location of all comment lines #
    if (!entry.substring(1,1).eq('#')) then

      !this.comments[!index] = !entry

    -- Store settings
    else

      !contents.append(!entry)
      !this.setLocs.append(!index)

    endif

  enddo

  -- Set object members to configuration file values
  !this.createDrawing    = !contents[1].after('=').trim('lr').eq('YES')
  !this.libraryRule      = !contents[2].after('=').trim('lr')
  !this.descAttribute    = !contents[3].after('=').trim('lr')
  !this.preferredType    = !contents[4].after('=').trim('lr').trim('lr',|'|)
  !this.preferredSize    = !contents[5].after('=').trim('lr')
  !this.drgNoAttribute   = !contents[6].after('=').trim('lr')
  !this.assemblyPurp     = !contents[7].after('=').trim('lr')
  !this.drawingPdf       = !contents[8].after('=').trim('lr').eq('YES')
  !this.drawingDirectory = object FILE(!contents[9].after('=').trim('lr'))
  !this.createPartsList  = !contents[10].after('=').trim('lr').eq('YES')
  !this.partsListRule    = !contents[11].after('=').trim('lr')
  !this.partsListDesc    = !contents[12].after('=').trim('lr')
  !this.preferredPart    = !contents[13].after('=').trim('lr').trim('lr',|'|)
  !this.asmblyAttRule    = !contents[14].after('=').trim('lr')
  !this.partsAttRule     = !contents[15].after('=').trim('lr')
  !this.partsListTxt     = !contents[16].after('=').trim('lr').eq('YES')
  !this.partsListCsv     = !contents[17].after('=').trim('lr').eq('YES')
  !this.partsListXls     = !contents[18].after('=').trim('lr').eq('YES')
  !this.partsListDir     = object FILE(!contents[19].after('=').trim('lr'))
  !this.deptRootName     = !contents[20].after('=').trim('lr')
  !this.logFileDir       = object FILE(!contents[21].after('=').trim('lr'))
  !this.batchFileDir     = object FILE(!contents[22].after('=').trim('lr'))
  !this.linkDescRule     = !contents[23].after('=').trim('lr')
  !this.considerStatus   = !contents[24].after('=').trim('lr').eq('YES')
  !this.statusAttribute  = !contents[25].after('=').trim('lr')
  !this.detailStatusAt   = !contents[26].after('=').trim('lr').real()
    handle any
      !this.detailStatusAt = 6
    endhandle

  -- Set the date when the configuration file was last modified
  !this.lastMod = !this.file.dtm()

endmethod
-- End of method definition for .read(FILE)

------------------------------------------------------------------------
--
-- Method:      .save(ARRAY)
--
-- Description: Save passed settings
--
-- Method Type: Method/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Member values
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .save(!array is ARRAY)

  -- Set object members to the passed values
  !this.createDrawing    = !array[1]
  !this.libraryRule      = !array[2]
  !this.descAttribute    = !array[3]
  !this.preferredType    = !array[4]
  !this.preferredSize    = !array[5]
  !this.drgNoAttribute   = !array[6]
  !this.assemblyPurp     = !array[7]
  !this.drawingPdf       = !array[8]
  !this.drawingDirectory = !array[9]
  !this.createPartsList  = !array[10]
  !this.partsListRule    = !array[11]
  !this.partsListDesc    = !array[12]
  !this.preferredPart    = !array[13]
  !this.asmblyAttRule    = !array[14]
  !this.partsAttRule     = !array[15]
  !this.partsListTxt     = !array[16]
  !this.partsListCsv     = !array[17]
  !this.partsListXls     = !array[18]
  !this.partsListDir     = !array[19]
  !this.deptRootName     = !array[20]
  !this.logFileDir       = !array[21]
  !this.batchFileDir     = !array[22]
  !this.linkDescRule     = !array[23]
  !this.considerStatus   = !array[24]
  !this.statusAttribute  = !array[25]
  !this.detailStatusAt   = !array[26]

endmethod
-- End of method definition for .save(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .setStatus()
--
-- Description: Set the status descriptions
--
-- Method Type: Method/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setStatus()

  !this.statusDesc.clear()

  !this.statusDesc.append('Created only')
  !this.statusDesc.append('Working')
  !this.statusDesc.append('Preliminary')
  !this.statusDesc.append('Being Modified')
  !this.statusDesc.append('For Check')
  !this.statusDesc.append('Checked')
  !this.statusDesc.append('Approved')
  !this.statusDesc.append('Being Detailed')
  !this.statusDesc.append('Issued')
  !this.statusDesc.append('Hold')
  !this.statusDesc.append('Deleted')

endmethod
-- End of method definition for .setStatus()

------------------------------------------------------------------------
--
-- Method:      .system()
--
-- Description: Use system defaults
--
-- Method Type: Method/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .system()

  -- Set object members to configuration file values
  !this.createDrawing    = true
  !this.libraryRule      = |WI SPPURPOSE EQ 'ASTMPL'|
  !this.descAttribute    = |FUNCTION|
  !this.preferredType    = |Standard Assembly Drawing AD-001|
  !this.preferredSize    = |A3|
  !this.drgNoAttribute   = |DrwgNu|
  !this.assemblyPurp     = |ASMBLY|
  !this.drawingPdf       = true
  !this.drawingDirectory = object FILE('%PDMSUSER%\Assembly-Drawings')
  !this.createPartsList  = true
  !this.partsListRule    = |WI SPPURPOSE EQ 'ASPLST'|
  !this.partsListDesc    = |FUNCTION|
  !this.preferredPart    = |Standard Instruction Document ID-001|
  !this.asmblyAttRule    = |WITH SPPURPOSE EQ 'ASMBLY'|
  !this.partsAttRule     = |WITH SPPURPOSE EQ 'PARTS'|
  !this.partsListTxt     = true
  !this.partsListCsv     = true
  !this.partsListXls     = true
  !this.partsListDir     = object FILE('%PDMSUSER%\Assembly-Parts-List')
  !this.deptRootName     = |/Assembly-|
  !this.logFileDir       = object FILE('%PDMSUSER%\Assembly-Logs')
  !this.batchFileDir     = object FILE('%PDMSUSER%\Assembly-Batch-Files')
  !this.linkDescRule     = |LNFOLD WITH FUNCTION EQ 'Assembly ADP'|
  !this.considerStatus   = false
  !this.statusAttribute  = |:assyStatus|
  !this.detailStatusAt   = 6

  !this.setStatus()

endmethod
-- End of method definition for .system()

-----------------------------------------------------------------------
--
-- Method:      .write()
--
-- Description: Write the configuration settings to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .write()

  -- Initialise variables
  !settings = ARRAY()
  !contents = !this.comments

  -- Initialise boolean settings to YES or NO
  if (!this.createDrawing) then
    !createDrawing = 'YES'
  else
    !createDrawing = 'NO'
  endif

  if (!this.drawingPdf) then
    !drawingPdf = 'YES'
  else
    !drawingPdf = 'NO'
  endif

  if (!this.createPartsList) then
    !createPartsList = 'YES'
  else
    !createPartsList = 'NO'
  endif

  if (!this.partsListTxt) then
    !partsListTxt = 'YES'
  else
    !partsListTxt = 'NO'
  endif

  if (!this.partsListCsv) then
    !partsListCsv = 'YES'
  else
    !partsListCsv = 'NO'
  endif

  if (!this.partsListXls) then
    !partsListXls = 'YES'
  else
    !partsListXls = 'NO'
  endif

  if (!this.considerStatus) then
    !considerStatus = 'YES'
  else
    !considerStatus = 'NO'
  endif

  -- Build contents array
  !settings.append('createDrawing = ' & !createDrawing)
  !settings.append('libraryRule = ' & !this.libraryRule)
  !settings.append('descAttribute = ' & !this.descAttribute)
  !settings.append(|preferredType = '| & !this.preferredType & |'|)
  !settings.append('preferredSize = ' & !this.preferredSize)
  !settings.append('drgNoAttribute = ' & !this.drgNoAttribute)
  !settings.append('assemblyPurp = ' & !this.assemblyPurp)
  !settings.append('drawingPdf = ' & !drawingPdf)
  !settings.append('drawingDirectory = ' & !this.drawingDirectory)
  !settings.append('createPartsList = ' & !createPartsList)
  !settings.append('partsListRule = ' & !this.partsListRule)
  !settings.append('partsListDesc = ' & !this.partsListDesc)
  !settings.append(|preferredPart = '| & !this.preferredPart & |'|)
  !settings.append('asmblyAttRule = ' & !this.asmblyAttRule)
  !settings.append('partsAttRule  = ' & !this.partsAttRule)
  !settings.append('partsListTxt = ' & !partsListTxt)
  !settings.append('partsListCsv = ' & !partsListCsv)
  !settings.append('partsListXls = ' & !partsListXls)
  !settings.append('partsListDir = ' & !this.partsListDir)
  !settings.append('deptRootName = ' & !this.deptRootName)
  !settings.append('logFileDir = ' & !this.logFileDir)
  !settings.append('batchFileDir = ' & !this.batchFileDir)
  !settings.append('linkDescRule = ' & !this.linkDescRule)
  !settings.append('considerStatus = ' & !considerStatus)
  !settings.append('statusAttribute = ' & !this.statusAttribute)
  !settings.append('detailStatusAt = ' & !this.detailStatusAt)

  -- Add settings to the comments to build the contents
  !count = 0
  do !index val !this.setLocs
    !count            = !count + 1
    !contents[!index] = !settings[!count]
  enddo

  -- Write file
  !this.file.writefile('OVER',!contents)

  -- Set the modified date
  !this.lastMod = !this.file.dtm()

endmethod
-- End of method .write()
