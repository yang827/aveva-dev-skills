-- Created:         04 August 2006
--
--
-- Description:
-- Object to define a department
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyDrwgDept(DBREF)              -                   Construct
--  getRegiNames()                   ARRAY               Read owned registries names
--  getRegiStrgRefs()                ARRAY               Read owned registries references
--  identical(DBREF)                 BOOLEAN
--
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Define object
define object ASSYDRWGDEPT

  -- Department attributes
  member .reference  is DBREF
  member .name       is STRING

  -- Owned registries
  member .allRegi is ARRAY

endobject
-- End of object definition for assyDrwgDept

------------------------------------------------------------------------
--
-- Method:        .assyDrwgDept()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Drawing Template reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyDrwgDept(!deptRefe is DBREF)

  -- Initialise variables
  !this.allRegi.clear()

  -- This element
  !this.reference = !deptRefe

  -- Get name
  !this.name = !this.reference.flnn

  -- Owned registries that have the same purpose as this dept
  do !elemObj val !deptRefe.mem
    if (!elemObj.hardtype.upcase().eq('REGI') and !elemObj.spPurp.eq(!deptRefe.spPurp)) then
      !this.allRegi.append(!elemObj)
    endif
  enddo

  -- Sort registries by name
  !sorted = !this.getRegiNames().sortedIndices()
  !this.allRegi.reIndex(!sorted)

endmethod
-- End of method definition for .assyDrwgDept()

------------------------------------------------------------------------
--
-- Method:        .identical(DBREF) is BOOLEAN
--
-- Description:   Check if DBREF is identical with this DBREF
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Drawing Template reference
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if identical
--
------------------------------------------------------------------------
define method .identical(!deptRefe is DBREF) is BOOLEAN

  return (!this.reference.string().eq(!deptRefe.string()))

endmethod
-- End of method definition for .identical()

------------------------------------------------------------------------
--
-- Method:        .getRegiNames()
--
-- Description:   Read owned registries names
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Registries names
--
------------------------------------------------------------------------
define method .getRegiNames() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- For each owned regi
  do !regiRefe val !this.allRegi
    !array.append(!regiRefe.flnn)
  enddo

  return !array

endmethod
-- End of method definition for .getRegiNames()

------------------------------------------------------------------------
--
-- Method:        .getRegiStrgRefs()
--
-- Description:   Read owned registries references
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Registries references as STRINgs
--
------------------------------------------------------------------------
define method .getRegiStrgRefs() is ARRAY

  -- Initialise variables
  !array = ARRAY()

  -- For each owned regi
  do !regiRefe val !this.allRegi
    !array.append(!regiRefe.string())
  enddo

  return !array

endmethod
-- End of method definition for .getRegiStrgRefs()
