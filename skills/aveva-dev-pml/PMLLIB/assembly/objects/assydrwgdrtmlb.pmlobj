-- File:            assydrwgdrtmlb.pmlobj
--   Type:          Object Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         04 August 2006
--
--
-- Description:
-- Object to define the configuration settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyDrwgDrtmlb(DBREF,STRING)     -                   Construct
--  getSizes()                       ARRAY               Read size code
--
------------------------------------------------------------------------
-- Define object
define object ASSYDRWGDRTMLB

  -- Template attributes
  member .reference   is DBREF
  member .description is STRING

  -- Owned drawing templates
  member .allDrtmpl   is ARRAY
  member .drtmplSizes is ARRAY

  -- Icon
  member .icon      is STRING

endobject
-- End of object definition for assyDrwgDrtmlb

------------------------------------------------------------------------
--
-- Method:        .assyDrwgDrtmlb()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Drawing Template Library reference
--    2   R      STRING      The attribute holding the type description
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyDrwgDrtmlb(!dbref is DBREF, !descAttribute is STRING)

  -- Read DRAFT system defaults file for size look-up
  !sizeList = !!assySizeLookUp()

  -- Set object attributes
  !this.reference   = !dbref
  !libraryStrg      = !this.reference.string()
  !this.description = !this.reference.attribute(!descAttribute)
  !this.icon        = !this.reference.ntext

  -- Get all drawing templates for the passed library
  VAR !allDrtmpl COLL ALL DRTMPL FOR $!libraryStrg

  -- Build the object for each owned drawing template
  do !drtmpl val !allDrtmpl
    !drtmplObj = object ASSYDRWGDRTMPL(!drtmpl.dbref(), !sizeList)
    !this.allDrtmpl.append(!drtmplObj)
  enddo

endmethod
-- End of method definition for .assyDrwgDrtmlb()

------------------------------------------------------------------------
--
-- Method:        .getSizes()
--
-- Description:   Read size code
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Size codes of available drtmpl elements
--
------------------------------------------------------------------------
define method .getSizes() is ARRAY

  -- Initialise variables
  !this.drtmplSizes.clear()

  -- For each drtmpl
  do !drtmplObj val !this.allDrtmpl
    !this.drtmplSizes.append(!drtmplObj.getSizeCode())
  enddo

  -- Sort owned drtmpl array by size code
  !sorted = !this.drtmplSizes.sortedIndices()
  !this.drtmplSizes.reIndex(!sorted)
  !this.allDrtmpl.reIndex(!sorted)

  return !this.drtmplSizes

endmethod
-- End of method definition for .getSizes()
