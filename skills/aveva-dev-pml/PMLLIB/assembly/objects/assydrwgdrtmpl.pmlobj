-- File:            assydrwgdrtmpl.pmlobj
--   Type:          Object Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         04 August 2006
--
--
-- Description:
-- Object to define the configuration settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyDrwgDrtmpl(DBREF,ARRAY)      -                   Construct
--  getSizeCode()                    STRING              Read size code
--  setSizeCode()                    -                   Get drawing template size in standard code format e.g. A3
--
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Define object
define object ASSYDRWGDRTMPL

  -- Template attributes
  member .reference  is DBREF
  member .sizeCode   is STRING

  -- Owned sheets
  member .sheets     is ARRAY

  -- Sizes and codes
  member .sizeList   is ARRAY

endobject
-- End of object definition for assyDrwgDrtmpl

------------------------------------------------------------------------
--
-- Method:        .assyDrwgDrtmpl()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Drawing Template reference
--    2   R      ARRAY       List of drawing sizes and their equivalent codes
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyDrwgDrtmpl(!dbref is DBREF, !sizeList is ARRAY)

  -- This element
  !this.reference = !dbref

  -- Size list
  !this.sizeList = !sizeList

  -- Get sheet size code
  !this.setSizeCode()

endmethod
-- End of method definition for .assyDrwgDrtmpl()

------------------------------------------------------------------------
--
-- Method:        .setSizeCode()
--
-- Description:   Get drawing template size in standard code format e.g. A3
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSizeCode()

  -- Initialise variables
  !sheetSize = !this.reference.size[1] & ' ' & !this.reference.size[2]

  -- Scan size list array for a matching size
  do !sizeDesc val !this.sizeList
    if (!sizeDesc.match(!sheetSize).neq(0)) then
      !this.sizeCode = !sizeDesc.after(!sheetSize).trim('lr')
      break
    endif
  enddo

endmethod
-- End of method definition for .setSizeCode()

------------------------------------------------------------------------
--
-- Method:        .getSizeCode()
--
-- Description:   Read size code
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      Size code
--
------------------------------------------------------------------------
define method .getSizeCode() is STRING

  return !this.sizeCode

endmethod
-- End of method definition for .getSizeCode()
