--
-- Description:
-- Object to define a label library
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyDrwgLalb(DBREF,STRING)       -                   Construct
--
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Define object
define object ASSYDRWGLALB

  -- Department attributes
  member .reference is DBREF
  member .name      is STRING

endobject
-- End of object definition for ASSYDRWGLALB

------------------------------------------------------------------------
--
-- Method:        .assyDrwgLalb(DBREF,STRING)
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Label Library reference
--    2   R      STRING      The attribute holding the type description
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyDrwgLalb(!lalbRefe is DBREF, !descAttribute is STRING)

  -- This element
  !this.reference = !lalbRefe

  -- Get descriptive name for use in any UI
  !this.name = !this.reference.attribute(!descAttribute)

endmethod
-- End of method definition for .assyDrwgLalb(DBREF,STRING)
