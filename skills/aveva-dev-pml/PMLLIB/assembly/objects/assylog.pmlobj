--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         Tue 03 Aug 2006
--
--
-- Description:
-- Assembly View Data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(STRING)                      -                   Add a message to the log
--  alphaEnd()                       -                   Closes and cleans the alpha log runtime warnings
--  assyLog()                        -                   Construct
--  clear()                          -                   Clear this object
--  footer()                         -                   Adds a footer to the file contents
--  header()                         -                   Adds a header to the file contents
--  initialise(FILE)                 -                   Initialise the object
--  read(FILE)                       -                   Read a passed log file
--  stop()                           -                   Stops the log file recording
--
------------------------------------------------------------------------
------------------------------------------------------------------------
define object ASSYLOG

  member .folder    is FILE

  member .file      is FILE

  member .alphaLog  is FILE

  member .dateTime  is DATETIME

  member .contents  is ARRAY

endobject
-- End of object definition for ASSYLOG

------------------------------------------------------------------------
--
-- Method:        .assyLog()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyLog()

  -- Initialise variables
  !this.dateTime = object DATETIME()

endmethod
-- End of object definition for .assyLog()

------------------------------------------------------------------------
--
-- Method:      .add(STRING)
--
-- Description: Add a message to the log
--
-- Method Type: Construct
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .add(!message is STRING)

  !this.contents.append(!message)

endmethod
-- End of object definition for .add(STRING)

------------------------------------------------------------------------
--
-- Method:      .alphaEnd()
--
-- Description: Closes and cleans the alpha log runtime warnings
--
-- Method Type: Construct
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------
define method .alphaEnd()

  -- Close the alpha log file
  ALPHA LOG END
    handle (61,278)
    endhandle

  -- Read alpha file
  !contents = !this.alphaLog.readFile()

  -- Remove file
  !this.alphaLog.deleteFile()

  -- Add separator line
  !this.contents.append(' ')
  !this.contents.append('_________________________________________________________________________')
  !this.contents.append(' ')

  -- Add only required bits to the pdms array
  do !text value !contents

    skip if (!text.eq(''))
    skip if (!text.match('F&M').neq(0))
    skip if (!text.match('may have changed').neq(0))

    !this.contents.append(!text.replace('Warning:','').replace('(64,151)','').replace('(64,153)',''))

  enddo

endmethod
-- End of method definition for .alphaEnd()

------------------------------------------------------------------------
--
-- Method:        .clear()
--
-- Description:   Clear this object
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  !this.contents.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:        .footer()
--
-- Description:   Adds a footer to the file contents
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .footer()

  -- Initialise variables
  !date = object DATETIME()

  -- Build footer
  !this.contents.append(' ')
  !this.contents.append('_________________________________________________________________________')
  !this.contents.append(' ')
  !this.contents.append(' Processing complete ' & !date.string())
  !this.contents.append(' ')
  !this.contents.append('Log Ends')

endmethod
-- End of object definition for .footer()

------------------------------------------------------------------------
--
-- Method:        .header()
--
-- Description:   Adds a header to the file contents
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .header()

  -- Initialise variables
  !project = CURRENT PROJECT

  -- Get project data
  !projectName = !project.name()
  if (!projectName.unset()) then
    !projectName = ' '
  endif

  -- Header
  !this.contents.append('_________________________________________________________________________')
  !this.contents.append(' ')
  !this.contents.append('                        Assembly Drawing & Parts Lists Production')
  !this.contents.append(' ')
  !this.contents.append('_________________________________________________________________________')
  !this.contents.append(' ')
  !this.contents.append(' Project: ' & !project.code() & ' ' & !projectName)
  !this.contents.append(' Started Processing ' & !this.dateTime.string())
  !this.contents.append('_________________________________________________________________________')
  !this.contents.append(' ')

endmethod
-- End of object definition for .header()

------------------------------------------------------------------------
--
-- Method:        .initialise(FILE)
--
-- Description:   Initialise the object
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        The directory where the log file will be written
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise(!directory is FILE)

  -- Initialise variables
  !this.dateTime = object DATETIME()
  !this.clear()

  -- Check that the directory exists
  if (!directory.exists().not()) then

    -- Create the folder
    !folderPath = !directory.directory().fullname() & '\' & !directory.entry()
    SYSCOM 'mkdir "$!folderPath"'

  endif

  -- Store directory
  !this.folder = !directory

  -- Build the log file object
  !this.file = object FILE(!directory.fullname() & '\Assembly-Drawing-Log_' & !!assyDateStamp() & '.txt')

  -- Set temporary alpha log file
  !this.alphaLog = object FILE('%PDMSUSER%\assembly_drawing_alphaLog.txt')

  -- Start the alpha log
  ALPHA LOG "$!<this.alphaLog>"  OVER
    handle (61,275)
      ALPHA LOG END
      ALPHA LOG "$!<this.alphaLog>"  OVER
    endhandle

  -- Add header
  !this.header()

endmethod
-- End of object definition for .initialise(FILE)

------------------------------------------------------------------------
--
-- Method:        .read(FILE)
--
-- Description:   Read a passed log file
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        Log file object
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .read(!file is FILE)

  !this.file     = !file

  !this.folder   = !this.file.directory()

  !this.contents = !this.file.readFile()

endmethod
-- End of object definition for .read(FILE)

------------------------------------------------------------------------
--
-- Method:        .stop()
--
-- Description:   Stops the log file recording
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stop()

  -- Stop the alpha log
  !this.alphaEnd()

  -- Add footer
  !this.footer()

  -- Write the log
  !this.file.writefile('OVERWRITE',!this.contents)

endmethod
-- End of object definition for .stop()
