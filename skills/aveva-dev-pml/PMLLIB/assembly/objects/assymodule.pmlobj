--
--
-- Description:
-- Commands specific to the module in which the application is running
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyModule()                     -                   Construct
--  displaySheet(DBREF)              -                   Display a sheet
--  marPtype()                       -                   Set the marine drawing type
--  submitToPrinter(DBREF,STRING,STRING,STRING) -                   Submit a sheet to a printer
--
------------------------------------------------------------------------
------------------------------------------------------------------------

define object ASSYMODULE

  member .module      is MODULE

  member .description is STRING

endobject

------------------------------------------------------------------------
--
-- Method:        .assyModule()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyModule()

  -- Get module description
  if (!this.module.modKey.upcase().eq('MARDRA')) then
     !this.description = 'MARINE'
  else
     !this.description = 'OUTFITTING'
  endif

endmethod
-- End of method definition for .assyModule()

------------------------------------------------------------------------
--
-- Method:        .displaySheet(DBREF)
--
-- Description:   Display a sheet
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       SHEE reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displaySheet(!sheeRefe is DBREF)

  -- PDMS Draft
  if (!this.description.eq('OUTFITTING') and !sheeRefe.set()) then
      -- initialise variables
      !sheetName = !sheeRefe.flnm

      -- Access the shee
      !!ce = !sheeRefe

      -- Set form title
      !!cdrcadcga1.formTitle = !!cdrcadcga1.n1formTitle & '   SHEET  ' & !sheetName

      -- Display sheet in the main Draft display
      edit !!cdrcadcga1.n1 AREA
        PUT $!sheetName
          handle any
          endhandle
      exit

      -- Store put sheet in form member
      !!cdrcadcga1.n1addName = '$!sheetName'

  elseif (!this.description.eq('MARINE')) then
    !!openMarineSheet('', !sheeRefe)
  endif

endmethod
-- End of object definition for .displaySheet(DBREF)

------------------------------------------------------------------------
--
-- Method:        .marPtype()
--
-- Description:   Set the marine drawing type
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .marPtype()

  -- Check for hull modules
  if (!this.description.eq('MARINE')) then

    -- P-20309: The marptype attribute can only be modified using the PROTECTION OFF syntax
    PROTECTION OFF

    -- Set the drawing type to allow it to be filtered by the 'Drawing Type = Assembly Drawings' in the hull form 'Open Drawing'
    MARPTYPE 28

    -- Switch PROTECTION back ON
    PROTECTION ON

  endif

endmethod
-- End of object definition for .marPtype()

------------------------------------------------------------------------
--
-- Method:        .submitToPrinter(DBREF,STRING,STRING,STRING)
--
-- Description:   Display a sheet
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Sheet DB Reference
--    2   R      STRING      Printing Colour Option
--    3   R      STRING      Printing Dialogue Option
--    4   R      STRING      Printing Scale Option
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .submitToPrinter(!sheeRefe is DBREF, !colourOption is STRING, !dialogOption is STRING, !scaleOption is STRING)

  -- PDMS Draft
  if (!this.description.eq('OUTFITTING')) then

    -- Test if the passed sheet exists
    VAR !exists EXISTS $!sheeRefe
    if (!exists.eq('FALSEA')) then
      !!alert.error('There is nothing displayed hence nothing to print!')
      return
    endif

    -- Submit to printer
    PLOT $!sheeRefe PRINT '$!colourOption $!dialogOption $!scaleOption'

  elseif (!this.description.eq('MARINE')) then

    -- TO BE DONE <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

  endif

endmethod
-- End of object definition for .submitToPrinter(DBREF,STRING,STRING,STRING)
