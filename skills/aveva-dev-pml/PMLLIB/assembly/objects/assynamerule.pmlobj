--
--
-- Description:
-- Object to hold the system default naming settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyNameRule()                   -                   Construct
--
------------------------------------------------------------------------
-- Define object
define object ASSYNAMERULE

  member .drwgNameRule    is STRING

  member .sheeNameRule    is STRING

  member .viewNameRule    is STRING

endobject
-- End of object definition for assyNameRule

------------------------------------------------------------------------
--
-- Method:        .assyNameRule()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyNameRule()

  -- Read DRAFT system defaults file for size look-up
  !defaultFile = object FILE('%PDMSDFLTS%\DRA-GEN-SYSTEM')

  -- Test for existing file
  if (!defaultFile.exists()) then

    -- Read file
    !contents    = !defaultFile.readFile()

    -- Extract general naming convention
    !start    = !contents.findFirst('# Mandatory Names')
    !end      = !contents.findFirst('# Optional Names')
    !nameList = !contents.from(!start + 1,!end - !start - 1)

    -- Store found naming data
    do !nameRule val !nameList

      -- Test for any invalid entry e.g. comment
      skip if (!nameRule.match('NAMECONVMAN').eq(0))

      -- Look for relevant element settings
      if (!nameRule.match('NAMECONVMAN DRWG').neq(0)) then
        !this.drwgNameRule = !nameRule.after('DRWG').trim('lr')

      elseif (!nameRule.match('NAMECONVMAN SHEE').neq(0)) then
        !this.sheeNameRule = !nameRule.after('SHEE').trim('lr')

      elseif (!nameRule.match('NAMECONVMAN VIEW').neq(0)) then
        !this.viewNameRule = !nameRule.after('VIEW').trim('lr')

      endif

    enddo

  -- Hard set defaults
  else

    !this.drwgNameRule = 'DR'
    !this.sheeNameRule = 'S'
    !this.viewNameRule = 'V'

  endif

endmethod
-- End of method definition for .assyNameRule()
