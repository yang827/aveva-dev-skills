--  Created:         Wed Nov 30 14:47:40 2011

--
--  Description:     -- This object is meant to represent an assembled part. It can represent an individual part or a set of identical parts.-- An object representing identical parts holds a storage of all parts found as identical.-- The functions assyPartValidForAccumulation and assyPartsIdenticalForAccumulation determines if a part is to be considered -- for accumulation and if identical. --
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assypart(DBREF,BOOLEAN,DBREF)    -                   Construct
--  identical(DBREF)                 BOOLEAN             Return true if identical
--  increment(DBREF,DBREF)           -                   Add DBREF to storage of identical parts
--  mainPartRef()                    DBREF               The DBREF (first DBREF if accumulated) part to subpart above
--  partRef()                        DBREF               The DBREF (first DBREF if accumulated) part/subpart
--  summary()                        REAL
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            assypart.pmlobj
--   Type:          Object Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
--
-- Description:
-- This object is meant to represent an assembled part. It can represent an individual part or a set of identical parts.
-- An object representing identical parts holds a storage of all parts found as identical.
-- The functions assyPartValidForAccumulation and assyPartsIdenticalForAccumulation determines if a part is to be considered
-- for accumulation and if identical.
--
------------------------------------------------------------------------
--
-----------------------------------------------------------------------
define object ASSYPART
  member .partRefs     is ARRAY
  member .cumulative   is BOOLEAN
  member .mainPartRefs is ARRAY
endobject
-- End of object definition for ASSYPART

------------------------------------------------------------------------
--
-- Method:        .assypart(DBREF,BOOLEAN,DBREF)
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Assembled part/subpart
--    1   R      BOOLEAN     Accumulate identical parts
--    1   R      DBREF       Main part if subpart above
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assypart(!partRef is DBREF, !sumUp is BOOLEAN, !mainPartRef is DBREF)
  !this.partRefs.append(!partRef)
  !this.mainPartRefs.append(!mainPartRef)
  !this.cumulative = !!assyPartValidForAccumulation(!partRef) and !sumUp
endmethod
-- End of method definition for .assypart(DBREF, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .identical(DBREF) is BOOLEAN
--
-- Description:   Determine if the DBREF is identical
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Assembled part
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if identical
--
------------------------------------------------------------------------
define method .identical(!part is DBREF) is BOOLEAN
  return (!!assyPartsIdenticalForAccumulation(!this.partRef(),!part))
endmethod
-- End of method definition for .identical(DBREF)

------------------------------------------------------------------------
--
-- Method:        .increment(DBREF)
--
-- Description:   Append DBREF in set of identical parts and thereby enumerate the summary
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Assembled part
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .increment(!partRef is DBREF, !mainPartRef is DBREF)
  if (!this.cumulative) then
    !this.partRefs.append(!partRef)
    !this.mainPartRefs.append(!mainPartRef)
  endif
endmethod
-- End of method definition for .increment(DBREF)

------------------------------------------------------------------------
--
-- Method:        .summary() is REAL
--
-- Description:   Return summary of identical parts
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        Summary
--
------------------------------------------------------------------------
define method .summary() is REAL
  return (!this.partRefs.size())
endmethod
-- End of method definition for .summary()

------------------------------------------------------------------------
--
-- Method:        .partRef() is DBREF
--
-- Description:   Returns the DBREF that constitutes the ASSYPART object
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       The DBREF (first in set if accumulated)
--
------------------------------------------------------------------------
define method .partRef() is DBREF
  return !this.partRefs.first()
endmethod
-- End of method definition for .partRef()
------------------------------------------------------------------------
--
-- Method:        .mainPartRef() is DBREF
--
-- Description:   Returns the DBREF that constitutes the ASSYPART object
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       The DBREF (first in set if accumulated)
--
------------------------------------------------------------------------
define method .mainPartRef() is DBREF
  return !this.mainPartRefs.first()
endmethod
-- End of method definition for .mainPartRef()
