--
--  Description:     -- This object is meant to keep the assembled parts of an assembly as ASSYPART objects. A mechanism is provided -- to control whether:--   + all parts should be treated as individual (ASSYPART) items  --   + identical items should be represented by a common (ASSYPART) item--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(ARRAY)                       -                   Add array of elements
--  append(DBREF,DBREF)              -                   Append an element
--  assyparts(ARRAY,BOOLEAN)         -                   Construct
--  assyparts(BOOLEAN)               -                   Construct
--  findIncrement(ASSYPART)          BOOLEAN
--
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            assyparts.pmlobj
--   Type:          Object Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
--
-- Description:
-- This object is meant to keep the assembled parts of an assembly as ASSYPART objects. A mechanism is provided
-- to control whether:
--   + all parts should be treated as individual (ASSYPART) items
--   + identical items should be represented by a common (ASSYPART) item
--
------------------------------------------------------------------------
--
-----------------------------------------------------------------------
define object ASSYPARTS
  member .parts          is ARRAY
  member .sumUp          is BOOLEAN
endobject
-- End of object definition for ASSYPARTS

------------------------------------------------------------------------
--
-- Method:        .assyparts(BOOLEAN)
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Identify and keep only one instance of identical ASSYPART items and for which a summary then is kept.
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyparts(!sumUp is BOOLEAN)
   !this.sumUp = !sumUp
endmethod
-- End of method definition for .assyparts(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .assyparts(ARRAY, BOOLEAN)
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Assembled parts of an assembly as DBREF(s)
--    2   R      BOOLEAN     Identify and keep only one instance of identical ASSYPART items and for which a summary then is kept.
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyparts(!partRefs is ARRAY, !sumUp is BOOLEAN)
   !this.sumUp = !sumUp
   !this.add(!partRefs)
endmethod
-- End of method definition for .assyparts(ARRAY, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .add(ARRAY)
--
-- Description:   Add array of DBREF parts (public)
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Assembled parts of an assembly as DBREF(s)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add(!partRefs is ARRAY)
  !unset = object DBREF()
  do !index ind !partRefs
    !partRef = !partRefs[!index]
    !this.append( !partRef, !unset)
    !subPartRefs = !!assyExpandSubParts(!partRef)
    do !subIndex ind !subPartRefs
      !subPartRef = !subPartRefs[!subIndex].dbref()
      !this.append( !subPartRef, !partRef)
    enddo
  enddo
endmethod
-- End of method definition for .add(ARRAY)

------------------------------------------------------------------------
--
-- Method:        .append(DBREF, DBREF)
--
-- Description:   Append part either as individual or accumulated item (internal)
--
--                If identical with other parts, update the counter for the representative ASSYPART
--                Otherwise, append to the list of ASSYPART objects
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       part/subpart
--    2   R      DBREF       unset if first arg is part, owning part if first arg is subpart
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .append(!partRef is DBREF, !mainPartRef is DBREF)
  !assyPart = object ASSYPART( !partRef, !this.sumUp, !mainPartRef)
  if (!assyPart.cumulative) then
    if (not !this.findIncrement(!assyPart)) then
      !this.parts.append( !assyPart)
    endif
  else
    !this.parts.append( !assyPart)
  endif
endmethod
-- End of method definition for .append(DBREF, DBREF)

------------------------------------------------------------------------
--
-- Method:        .findIncrement(ASSYPART) is BOOLEAN
--
-- Description:   Enumerate summary of part identified as identical (internal)
--
--                Look through the list of ASSYPART objects for an instance
--                identical with the one provided as candidate. If found similar,
--                just update the counter value for the ASSYPART. If not found
--                return false.
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASSYPART    Assembled part
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if encountered an identical part and provided that configured to enumerate identical parts
--
------------------------------------------------------------------------
define method .findIncrement(!candidate is ASSYPART) is BOOLEAN
  !partRef = !candidate.partRef()
  !mainPartRef = !candidate.mainPartRef()
  do !index ind !this.parts
    if (!this.parts[!index].cumulative) then
      if (!this.parts[!index].identical(!partRef)) then
        !this.parts[!index].increment(!partRef, !mainPartRef)
        return true
      endif
    endif
  enddo
  return false
endmethod
-- End of method definition for .findIncrement(ASSYPART)
