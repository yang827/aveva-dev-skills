------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  asitem(ASSYPART)                 DBREF               Returns the DBREF for ASITEM to the ASSYPART object
--  assyPartsList(FILE,STRING)       -                   Construct
--  build(DBREF,STRING,STRING,BOOLEAN) -                   Build report data
--  clear()                          -                   Clear the object
--  getAsmblyAtts(DBREF,STRING)      -                   Build an array of attributes held by the replacement text
--  getPartsList(DBREF,STRING)       -                   Build an array of attributes held by the replacement text
--  saveToCSV()                      ARRAY               Save data to two CSV files
--  saveToExcel()                    ARRAY               Save data to an XLS file
--  saveToTxt()                      FILE                Save data to a text file
--
------------------------------------------------------------------------
define object ASSYPARTSLIST

  member .asmblyRefe       is DBREF

  member .asmblyDataRowSet is ARRAY

  member .asmblyDataColSet is ARRAY

  member .asmblyHeaders    is ARRAY

  member .partsDataRowSet  is ARRAY

  member .partsDataColSet  is ARRAY

  member .partsHeaders     is ARRAY

  member .partFolder       is FILE

  member .rootName         is STRING

  member .range            is STRING

  member .module           is ASSYMODULE

endobject
-- End of object definition for ASSYPARTSLIST

------------------------------------------------------------------------
--
-- Method:        .assyPartsList(FILE,STRING)
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        Report destination folder
--    2   R      STRING      Root name for output files
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyPartsList(!plFold is FILE, !rootName is STRING)

  !this.partFolder = !plFold
  !this.rootName   = !rootName

endmethod
-- End of method definition for .assyPartsList()

------------------------------------------------------------------------
--
-- Method:        .build(DBREF,STRING,STRING,BOOLEAN)
--
-- Description:   Build report data
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Label Library reference
--    2   R      STRING      The rule used to collect the SYTM that holds the assembly attributes
--    3   R      STRING      The rule used to collect the SYTM that holds the parts list attributes
--    4   R      BOOLEAN     Whether to extract to XLS file
--
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .build(!lalbRefe is DBREF, !asmblyAttRule is STRING, !partsAttRule is STRING, !dummyXLSOut is BOOLEAN)

  -- Initialise variables
  !this.clear()

  -- Set assembly headers
  !this.asmblyHeaders.append('Attribute')
  !this.asmblyHeaders.append('Value')

  -- Build assembly attribute row sets for each assembly
  !this.getAsmblyAtts(!lalbRefe, !asmblyAttRule)

  -- Build parts list row sets for each assembly
  !this.getPartsList(!lalbRefe, !partsAttRule)

  -- For output to Excel only - FOR TEST PURPOSES, The output is shown in a dummy form
--  if (!dummyXLSOut) then

--    !form = !!assyPartsList
--    !!assyPartsList.show()
--    !form.setDataList(!this.asmblyDataRowSet)
--    !form.setPartsHeadings(!this.partsHeaders)
--    !form.setPartsList(!this.partsDataRowSet)

--  endif

endmethod
-- End of method definition for .buildRows(DBREF,STRING,STRING,BOOLEAN)

------------------------------------------------------------------------
--
-- Method:        .clear()
--
-- Description:   Clear the object
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clear()

  !this.asmblyDataRowSet.clear()
  !this.asmblyDataColSet.clear()
  !this.partsDataRowSet.clear()
  !this.partsDataColSet.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:        .getAsmblyAtts(DBREF,STRING)
--
-- Description:   Build an array of attributes held by the replacement text
--                attribute of a series of TEXP elements in the library
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       LALB reference
--    2   R      STRING      The rule used to collect the SYTM
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAsmblyAtts(!lalbRefe is DBREF, !rule is STRING)

  -- Initialise variables
  !project = current project

  -- Read assembly attribute texp elements
  VAR !allSytm COLL ALL SYTM $!rule FOR $!<lalbRefe.flnm>

  -- Get attribute information from the texp elements
  VAR !allTexp COLL ALL TEXP FOR $!allSytm[1]

  -- Build a row of data for the assembly
  -- The data will be reported in the same order as the TEXP elements in the db
  do !index ind !allTexp

    -- Initialise variables
    !texpRefe = !allTexp[!index].dbref()
    !row      = ARRAY()

    -- Get the required attribute for the column from the TEXP replacement text
    !attrib = !texpRefe.attribute('ETEX')

    -- Check for special options
    -- PROJECT^NUMBER         - Project number
    -- PROJECT^NAME           - Project name
    -- PROJECT^DESCRIPTION    - Project description
    -- PROJECT^MESSAGE        - Project message
    -- PROJECT^CODE           - Project code
    if (!attrib.match('PROJECT').neq(0)) then

      -- Attribute name
      !attribName = !attrib.replace('^',' ')
      !row.append(!attribName)
      !this.asmblyDataColSet[1][!index] = !attribName

      -- Attribute value
      if (!attrib.eq('PROJECT^NUMBER')) then
        !proNum = !project.number()
        if (!proNum.unset()) then
          !proNum = 'Unset'
        endif
        !row.append(!proNum)
        !this.asmblyDataColSet[2][!index] = !proNum
      elseif (!attrib.eq('PROJECT^NAME')) then
        !projName = !project.name()
        if (!projName.unset()) then
          !projName = 'Unset'
        endif
        !row.append(!projName)
        !this.asmblyDataColSet[2][!index] = !projName
      elseif (!attrib.eq('PROJECT^DESCRIPTION')) then
        !projDesc = !project.description()
        if (!projDesc.unset()) then
          !projDesc = 'Unset'
        endif
        !row.append(!projDesc)
        !this.asmblyDataColSet[2][!index] = !projDesc
      elseif (!attrib.eq('PROJECT^MESSAGE')) then
        !projMess = !project.message()
        if (!projMess.unset()) then
          !projMess = 'Unset'
        endif
        !row.append(!projMess)
        !this.asmblyDataColSet[2][!index] = !projMess
      elseif (!attrib.eq('PROJECT^CODE')) then
        !projCode = !project.code()
        if (!projCode.unset()) then
          !projCode = 'Unset'
        endif
        !row.append(!projCode)
        !this.asmblyDataColSet[2][!index] = !projCode
      endif

    else

      -- Attribute name
      !attribName = !texpRefe.btex
      !row.append(!attribName)
      !this.asmblyDataColSet[1][!index] = !attribName

      -- Attribute value
      !commandString = '!this.asmblyRefe.' & !attrib
      !attribValue   = $!commandString
        handle any
          !attribValue = 'Unset'
        endhandle
      !row.append(!attribValue)
      !this.asmblyDataColSet[2][!index] = !attribValue

      -- Clean up as attribute type may change
      !attribValue.delete()

    endif

    -- Store assembly attribute row data
    !this.asmblyDataRowSet.append(!row)

  enddo

endmethod
-- End of method definition for .getAsmblyAtts(DBREF,STRING)

------------------------------------------------------------------------
--
-- Method:        .getPartsList(DBREF,STRING)
--
-- Description:   Build an array of attributes held by the replacement text
--                attribute of a series of TEXP elements in the library
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       LALB reference
--    2   R      STRING      The rule used to collect the SYTM
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPartsList(!lalbRefe is DBREF, !rule is STRING)

  -- Read parts list texp elements
  VAR !allSytm COLL ALL SYTM $!rule FOR $!<lalbRefe.flnm>

  -- Get attribute information from the texp elements
  VAR !allTexp COLL ALL TEXP FOR $!allSytm[1]
  !block     = object BLOCK('!allTexp[!evalIndex].dbref()')
  !texpRefs  = !allTexp.evaluate(!block)

  -- If any assySummary function, then cumulative part counting mode
  VAR !sumUpFunctions COLL ALL TEXTP WI MATCHWILD (ETEXT,'*assySummary*') FOR $!allSytm[1]
  !sumUp = !sumUpFunctions.size() gt 0

  -- Get assembly parts
  -- The variables PARTREFE & ASITEM must exist as they are mandatory arguments to each function to be called
  -- The part is the ASSYPART object (with one or more accumulated elements) for which the data is to be extracted
  -- The asitem is the referencing secondary hierarchy element holding data in it's own right such as quantity
  -- For an individual report
  !assyPartsObj = object ASSYPARTS(!sumUp)
  if (!this.range.eq('SINGLE')) then

    -- Get the members of the assembly
    !assyPartsObj.add(!this.asmblyRefe.smemb)

  -- For a totals report
  else

    -- Initialise variables
    !asmblyRefe = !this.asmblyRefe

    -- Get all offspring of the assembly
    !assyPartsObj.add(!asmblyRefe.sexpnd)
  endif

  !assyParts = !assyPartsObj.parts

  -- Build headers
  do !index ind !texpRefs

    -- Header text is held in the BTEX attribute
    -- Replace any XYZ for Plant product
    if (!this.module.module.productFamily.upcase().eq('MARINE')) then
      !btex = !texpRefs[!index].btex
    else
      !btex = !texpRefs[!index].btex.replace('CoG X','CoG E').replace('CoG Y','CoG N').replace('CoG Z','CoG U')
    endif

    -- For rows
    !this.partsHeaders.append(!btex)

    -- For columns
    !this.partsDataColSet[!index][1] = !btex

  enddo

  -- Build rows of data for each part
  -- The data will be reported in the same order as the TEXP elements in the db
  do !count ind !assyParts

    -- Initialise variable
    -- NOTE: !partRefe and !asitem are not UNUSED - they may be referred to in !commandString
    --       !partRefe is an ASSYPART object
    !partRefe = !assyParts[!count]
    !asitem   = !this.asitem(!partRefe)
    !row      = ARRAY()

    -- For each attribute extract the data by running the related PML function
    do !index ind !texpRefs

      -- PML Function value
      !commandString = !texpRefs[!index].attribute('ETEX')
      !functionValue = $!commandString
        handle any
          !functionValue = 'Unset'
        endhandle

      -- Test for string value
      if (!functionValue.objectType().eq('STRING')) then
        !functionValue = !functionValue.replace('##','#')
      endif

      -- Add the result to the arrays
      !row.append(!functionValue)
      !this.partsDataColSet[!index].append(!functionValue)

      -- Clean up variables as attribute type may change
      !functionValue.delete()

    enddo

    -- Store assembly attribute row data
    !this.partsDataRowSet.append(!row)

  enddo

endmethod
-- End of method definition for .getPartsList(DBREF,STRING)

------------------------------------------------------------------------
--
-- Method:        .saveToCSV()
--
-- Description:   Save data to two CSV files
--                _1 will contain the parts list data
--                _2 will contain the assembly attribute data
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Files objects for the created files
--
------------------------------------------------------------------------
define method .saveToCSV() is ARRAY

  -- Initialise variables
  !partContent = ARRAY()
  !attrContent = ARRAY()
  !files       = ARRAY()

  -- Build output files
  !partFileObj = object FILE(!this.partFolder.fullname() & '\' & !this.rootName & '_1.csv')
  !attrFileObj = object FILE(!this.partFolder.fullname() & '\' & !this.rootName & '_2.csv')

  -- Set modes
  if (!partFileObj.exists()) then
    !partMode = 'OVERWRITE'
  else
    !partMode = 'WRITE'
  endif

  if (!attrFileObj.exists()) then
    !attrMode = 'OVERWRITE'
  else
    !attrMode = 'WRITE'
  endif

  -- Build the Parts List section
  !data = !this.partsDataColSet

  -- Format and add the parts data
  do !index from 1 to !data[1].size()

    -- Skip the first index because it contains the header text which is unwanted here
    skip if (!index.eq(1))

    -- Build formatted string
    do !count from 1 to !data.size()
      if (!count.eq(1)) then
        !formatted = !data[!count][!index]
      else
        !formatted = !formatted & ';' & !data[!count][!index]
      endif
    enddo

    -- Add the final separator
    !formatted = !formatted & ';'

    -- Add formatted string to the content
    !partContent.append(!formatted)

  enddo

  -- Write file
  !partFileObj.writefile(!partMode,!partContent)

  -- Build the Assembly Attribute section
  !data = !this.asmblyDataColSet

  -- Format and add the attribute data
  do !index from 1 to !data[1].size()
    !attrContent.append(!data[1][!index] & ';' & !data[2][!index] & ';')
  enddo

  -- Write file
  !attrFileObj.writefile(!attrMode,!attrContent)

  -- Build return array
  !files.append(!partFileObj)
  !files.append(!attrFileObj)

  return !files

endmethod
-- End of method definition for .saveToCSV()

------------------------------------------------------------------------
--
-- Method:        .saveToExcel()
--
-- Description:   Save data to an XLS file
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       The Excel file objects
--
------------------------------------------------------------------------
define method .saveToExcel() is ARRAY

  -- Initialise variables
  !files = ARRAY()

  --Create Grid Control Objects
  import 'GridControl'
    handle (1000,0)
    endhandle

  using namespace 'Aveva.Pdms.Presentation'

  !asmblyDbCtrl = object NETGRIDCONTROL()
  !partsDbCtrl  = object NETGRIDCONTROL()

  --Bind the Data Sources to the Grid Control Objects
  !asmblyDbCtrl.bindToDataSource(object NETDATASOURCE('Assembly Attributes', !this.asmblyHeaders, !this.asmblyDataRowSet))
  !partsDbCtrl.bindToDataSource(object NETDATASOURCE('Parts List', !this.partsHeaders, !this.partsDataRowSet))

  -- For the moment until we have the relevant functionality, the two grids have to be saved to two separate files
  -- Export the assembly attribute data
  !asmblyDbCtrl.saveGridToExcel(!this.partFolder.fullname() & '\' & !this.rootName & '_Data' & '.xls')
--  !asmblyDbCtrl.saveGridToExcel(!this.partFolder.fullname() & '\' & !this.rootName & '.xls','1') <<<<<<<<<<<<<<<<<<<<<<<<<<<< BUG, OVERWRITES FILE
    handle (1000,0)
      -- Exception has been thrown by the target of an invocation
      !!alert.error('The system failed in attempting to write to an open file. Please close MS Excel and try again.')
    endhandle

  -- Export the parts list data
  !partsDbCtrl.saveGridToExcel(!this.partFolder.fullname() & '\' & !this.rootName & '_Parts' & '.xls')
--  !partsDbCtrl.saveGridToExcel(!this.partFolder.fullname() & '\' & !this.rootName & '.xls','2') <<<<<<<<<<<<<<<<<<<<<<<<<<<< BUG, OVERWRITES FILE
    handle (1000,0)
      !!alert.error('The system failed in attempting to write to an open file. Please close MS Excel and try again.')
    endhandle

  -- Return the parts list files, but we really want a single file later.
  -- Cannot currently do this as there are problems with overwriting the file instead of adding a sheet
  !files.append(object FILE(!this.partFolder.fullname() & '\' & !this.rootName & '_Data' & '.xls'))
  !files.append(object FILE(!this.partFolder.fullname() & '\' & !this.rootName & '_Parts' & '.xls'))

  return !files

endmethod
-- End of method definition for .saveToExcel()

------------------------------------------------------------------------
--
-- Method:        .saveToTxt()
--
-- Description:   Save data to a text file
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    FILE        The created file
--
------------------------------------------------------------------------
define method .saveToTxt() is FILE

  -- Initialise variables
  !underLine  = '_'
  !separator  = '___'
  !content    = ARRAY()
  !widths     = ARRAY()
  !partsList  = ARRAY()

  -- Build output file
  !fileObj = object FILE(!this.partFolder.fullname() & '\' & !this.rootName & '.txt')

  -- Set mode
  if (!fileObj.exists()) then
    !mode = 'OVERWRITE'
  else
    !mode = 'WRITE'
  endif

  -- Add a starting blank line
  !content.append(' ')

  -- Build Assembly Attribute section
  !data = !this.asmblyDataColSet

  -- Get attribute columns maximum widths
  !maxA = !data[1].width() + 3

  -- Compose and add the attribute data
  do !index from 1 to !data[1].size()
    VAR !composed COMPOSE |   $!data[1][$!index]| WIDTH $!maxA SPACES 3 $
|$!data[2][$!index]|
    !content.appendArray(!composed)
  enddo

  -- Add blank line
  !content.append(' ')

  -- Build Parts List section
  !data = !this.partsDataColSet

  -- Get parts data columns maximum widths
  do !index ind !data

    -- Test for last column
    if (!index.eq(!data.size())) then
      !widths.append(!data[!index].width())
    else
      !widths.append(!data[!index].width() + 3)
    endif

  enddo

  -- Compose and add the parts data
  do !index from 1 to !data[1].size()

    -- Build composed command
    do !count from 1 to !data.size()

      -- Test for first column
      if(!count.eq(1)) then
        !composedCommand = '|   ' & !data[!count][!index] & '|' & ' WIDTH ' & !widths[!count] & ' SPACES 2 '
      elseif (!count.eq(!data.size())) then
        !composedCommand = !composedCommand & '|' & !data[!count][!index] & '|'
      else
        !composedCommand = !composedCommand &  '|' & !data[!count][!index] & '|' & ' WIDTH ' & !widths[!count] & ' SPACES 2 '
      endif

    enddo

    -- Action composed command
    VAR !composed COMPOSE $!composedCommand

    -- Add composed string to the parts list array
    !partsList.appendArray(!composed)

  enddo

  -- Calculate parts list width and build separator line
  !maxBody = !partsList.width()
  do from 1 to !maxBody
    !separator = !separator & !underLine
  enddo

  -- Insert separator between the header line and the body
  !partsList.insert(1,!separator)
  !partsList.insert(2,' ')
  !partsList.insert(4,!separator)
  !partsList.insert(5,' ')

  -- Add the parts list to the content
  !content.appendArray(!partsList)

  -- Add final separator line
  !content.append(!separator)
  !content.append(' ')

  -- Write file
  !fileObj.writefile(!mode,!content)

  return !fileObj

endmethod
-- End of method definition for .saveToTxt()

------------------------------------------------------------------------
--
-- Method:        .asitem()
--
-- Description:   Returns the DBREF for ASITEM to the ASSYPART object
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASSYPART    Assembled part
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .asitem(!assyPart is ASSYPART) is DBREF
  !findPart = !assyPart.mainPartRef()
  if (!findPart.unset()) then
    !findPart = !assyPart.partRef()
  endif
  if (!findPart.hardType.upCase().eq('ASMBLY')) then
    return !findPart
  else
    return !findPart.asiown[1]
  endif
endmethod
-- End of method definition for .asitem(ASSYPART)
