--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  asitem(ASSYPART)                 DBREF               Returns the DBREF for ASITEM to the ASSYPART object
--  readTableData(DBREF)             -                   Read label library table symbolic templates
--  runFunctions(DBREF)              -                   Run the function for the part and extract the cell value
--  setPurp(STRING,STRING,STRING,STRING,STRING,STRING) -                   Set element purposes
--
-----------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            assyparttable.pmlobj
--   Type:          Object Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
--
-- Description:
-- Assembly Application calls
--
------------------------------------------------------------------------
define object ASSYPARTTABLE

  -- Symbolic templates
  member .titleSytm       is DBREF
  member .headerSytm      is DBREF
  member .rowSytm         is DBREF
  member .overflowSytm    is DBREF
  member .cellSytms       is ARRAY

  -- Purposes
  member .titlePurpose    is STRING
  member .headerPurpose   is STRING
  member .rowPurpose      is STRING
  member .overflowPurpose is STRING
  member .cellPurpose     is STRING

  -- Table fill direction
  member .fillDir         is STRING

  -- Cell word wrapping
  member .cellTextWrap    is ARRAY

  -- Cell limits
  member .cellLimits      is ARRAY

  -- Cell parts references
  member .partsRefes      is ARRAY

  -- Cell source data
  member .functions       is ARRAY

  -- Cell values
  member .values          is ARRAY

  -- Sum up identical parts
  member .sumUp           is BOOLEAN

  -- Parts
  member .assyPartsObj    is ASSYPARTS

endobject
-- End of object definition for ASSYPARTTABLE

------------------------------------------------------------------------
--
-- Method:        .readTableData(DBREF)
--
-- Description:   Read label library table symbolic templates
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF      The LALB to read
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .readTableData(!lalbRefe is DBREF)

  -- Initialise variables
  !this.cellLimits.clear()
  !this.cellSytms.clear()
  !this.functions.clear()
  !this.cellTextWrap.clear()

  -- Get title sytm
  VAR !allTitleSytm COLL ALL SYTM WI SPPURP EQ '$!<this.titlePurpose>' FOR $!lalbRefe
  !this.titleSytm = !allTitleSytm[1].dbref()

  -- Get header sytm
  VAR !allHdrSytm COLL ALL SYTM WI SPPURP EQ '$!<this.headerPurpose>' FOR $!lalbRefe
  !this.headerSytm = !allHdrSytm[1].dbref()

  -- Get row lines sytm
  VAR !allRowSytm COLL ALL SYTM WI SPPURP EQ '$!<this.rowPurpose>' FOR $!lalbRefe
  !this.rowSytm = !allRowSytm[1].dbref()

  -- Get row overflow lines sytm
  VAR !allOverSytm COLL ALL SYTM WI SPPURP EQ '$!<this.overflowPurpose>' FOR $!lalbRefe
  !this.overflowSytm = !allOverSytm[1].dbref()

  -- Use the overflow symbol to extract the limits of each cell, which depends upon table fill direction
  -- Use the sytm origin as the initial position
  if (!this.fillDir.eq('X') or !this.fillDir.eq('-X')) then

    -- Use the Y axis position value
    !cellPosition = !this.overflowSytm.xypo.north

  elseif (!this.fillDir.eq('Y') or !this.fillDir.eq('-Y')) then

    -- Use the X axis position value
    !cellPosition = !this.overflowSytm.xypo.east

  endif

  -- Read the distance between each cell separator
  VAR !allStra COLL ALL STRA FOR $!allOverSytm[1]
  do !stra val !allStra

    -- Initialise variables
    !straRefe = !stra.dbref()

    -- Get stra position
    if (!this.fillDir.eq('X') or !this.fillDir.eq('-X')) then
      !distance = !cellPosition - !straRefe.ptfa[1].xypo.north
    elseif (!this.fillDir.eq('Y') or !this.fillDir.eq('-Y')) then
      !distance = !cellPosition - !straRefe.ptfa[1].xypo.east
    endif
    !this.cellLimits.append(!distance.abs())

  enddo

  -- Get cell sytms
  VAR !allCellSytm COLL ALL SYTM WI SPPURP EQ '$!<this.cellPurpose>' FOR $!lalbRefe

  -- Read parts cell header text and functions
  do !cellSytm val !allCellSytm

    -- Initialise variables
    !cellRefe = !cellSytm.dbref()
    !texpRefe = !cellRefe.memb[1]

    -- Store SYTM
    !this.cellSytms.append(!cellRefe)

    -- Store PML function
    !this.functions.append(!texpRefe.attribute('ETEX'))

    -- Store cell text wrapping required
    !this.cellTextWrap.append(!cellRefe.txSplit)

  enddo

endmethod
-- End of method definition for .readTableData(DBREF)

------------------------------------------------------------------------
--
-- Method:        .runFunctions(DBREF)
--
-- Description:   Run the function for the part and extract the cell value
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       ASMBLY being detailed
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .runFunctions(!asmblyRefe is DBREF)

  -- Initialise variables
  !this.assyPartsObj = object ASSYPARTS(!asmblyRefe.smemb, !this.sumUp)
  !assyParts = !this.assyPartsObj.parts

  -- For each assembly part
  do !index ind !assyParts

    -- Initialise variable
    -- The variables PARTREFE & ASITEM must exist as they are mandatory arguments to each function to be called
    -- The part is the ASSYPART object (with one or more accumulated elements) for which the data is to be extracted
    -- The asitem is the referencing secondary hierarchy element holding data in it's own right such as quantity
    !partRefe    = !assyParts[!index]
    !asitem      = !this.asitem(!partRefe)
    !partValues  = ARRAY()

    -- For each replacement text
    -- Either run the PML function or just use the set hash text
    -- Look for special keywords
    do !count ind !this.functions

      -- Initialise variables
      !function     = !this.functions[!count]

      -- Part Number
      -- Used to identify the part in the graphical view
      if (!function.upCase().eq( 'PART NUMBER')) then
        !partValues.append(!index)

      -- Hash code
      elseif (!function.substring(1,1).eq('#')) then
        !partValues.append(!function)

      -- PML function
      else

        -- PML Function value
        -- Returned value from the function must always be a STRING
        !functionValue = $!function
          handle any
            !functionValue = 'Error'
              !!assyLog.add('  There is an error in the function ' & !function)
              !!assyLog.add('   ' & !!error.text)
              !!assyLog.add(|   The value 'Error' is being output for row| & !index & ' cell' & !count)
          endhandle

        !partValues.append(!functionValue)

      endif

    enddo

    !this.values.append(!partValues)

  enddo

endmethod
-- End of method definition for .runFunctions(DBREF)

------------------------------------------------------------------------
--
-- Method:        .setPurp(STRING,STRING,STRING,STRING,STRING,STRING)
--
-- Description:   Set element purposes
--
-- Function Type: Function/Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPurp(!titlePurp is STRING, !hdrPurp is STRING, !rowPurp is STRING, !overPurp is STRING, !cellPurp is STRING, !sumUp is STRING)

  !this.titlePurpose    = !titlePurp
  !this.headerPurpose   = !hdrPurp
  !this.rowPurpose      = !rowPurp
  !this.overflowPurpose = !overPurp
  !this.cellPurpose     = !cellPurp
  !this.sumUp = (!sumUp.eq('ACCUMULATE'))

endmethod
-- End of method definition for .setPurp(STRING,STRING,STRING,STRING,STRING)

------------------------------------------------------------------------
--
-- Method:        .asitem()
--
-- Description:   Returns the DBREF for ASITEM to the ASSYPART object
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ASSYPART    Assembled part
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .asitem(!assyPart is ASSYPART) is DBREF
  !findPart = !assyPart.mainPartRef()
  if (!findPart.unset()) then
    !findPart = !assyPart.partRef()
  endif
  if (!findPart.hardType.upCase().eq('ASMBLY')) then
    return !findPart
  else
    return !findPart.asiown[1]
  endif
endmethod
-- End of method definition for .asitem(ASSYPART)
