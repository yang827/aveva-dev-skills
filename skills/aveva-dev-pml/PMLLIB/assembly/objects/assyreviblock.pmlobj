-- Created:         30 July 2002
--
--
-- Description:
-- The revision block data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getData(DBREF)                   -                   Get library revision block data
--  getExtra(DBREF)                  -                   Get library revision extra data
--  getReserved(DBREF)               -                   Get library revision reserved areas
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
define object ASSYREVIBLOCK

  -- Revision libraries
  member .entryLibRefe is DBREF
  member .extraLibRefe is DBREF

  -- Reserved areas
  member .reserved is ARRAY
  member .move     is REAL
  member .dire     is STRING

  -- Revision block cell data
  member .cellSytm     is ARRAY
  member .cellColumn   is ARRAY
  member .cellBtext    is ARRAY
  member .cellWidth    is ARRAY
  member .cellDescr    is ARRAY
  member .cellCode     is ARRAY
  member .cellChei     is ARRAY
  member .cellJust     is ARRAY
  member .cellAlig     is ARRAY
  member .cellTpen     is ARRAY
  member .cellSPos     is ARRAY
  member .cellTPos     is ARRAY

  -- Extra revision field data
  member .extraFunc    is ARRAY
  member .extraDesc    is ARRAY
  member .extraPurp    is ARRAY
  member .extraCode    is ARRAY
  member .extraGName   is ARRAY
  member .extraWidth   is REAL
  member .extraPML     is ARRAY

endobject

------------------------------------------------------------------------
--
-- Method:      .getData(DBREF)
--
-- Description: Get library revision block data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The standard library for the MTO extraction
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getData(!stdLibyRefe is DBREF)

  -- Initialise variables
  !widths = ARRAY()

  -- Get revision table template library
  VAR !entryLib COLL ALL LALB WI FUNC EQ 'Revision Table Display' FOR $!stdLibyRefe

  -- Read cells for text data
  VAR !allSytm COLL ALL SYTM WI :PURP EQ 'Entry Display' FOR $!entryLib[1]
  VAR !allColumn EVAL :Column FOR ALL FROM !allSytm

  -- Get cell note data from the TEXP under each SYTM
  -- Only works for x1 TEXP per SYTM
  do !sytm value !allSytm
    var !texp COLL ALL TEXP FOR $!sytm
    !this.cellBtext.append(!texp[1].dbref().btex)
    !this.cellChei.append(!texp[1].dbref().chei)
    !this.cellJust.append(!texp[1].dbref().just)
    !this.cellAlig.append(!texp[1].dbref().alig)
    !this.cellTpen.append(!texp[1].dbref().tpen)
    !this.cellTPos.append(!texp[1].dbref().ptrf.xypo)
    !this.cellSPos.append(!sytm.dbref().xypo)
  enddo

  -- Sort the data by column number
  -- Only works up to 9 columns since 10 gets sorted to index 2
  !sorted = !allColumn.sortedIndices()
  !allSytm.reIndex(!sorted)

  -- Get cell data
  do !index ind !allSytm

    -- Initialise variables
    !sytmRefe = !allSytm[!index].dbref()

    -- Get cell widths
    if (!index.eq(1)) then
      if (!sytmRefe.:description.upCase().eq('DATE')) then
        !number = !sytmRefe.:End
        !widths.append(!number.int())
      else
        !number = !sytmRefe.:End / 2
        !this.cellWidth.append(!number.int())
      endif
    else
      !prevRefe = !allSytm[!index - 1].dbref()
      if (!sytmRefe.:description.upCase().eq('DATE')) then
        !number = (!sytmRefe.:End - !prevRefe.:End)
        !this.cellWidth.append(!number.int())
      else
        !number = (!sytmRefe.:End - !prevRefe.:End) / 2
        !this.cellWidth.append(!number.int())
      endif
    endif

    -- Get cell descriptions
    !this.cellDescr.append(!sytmRefe.:description)

    -- Get current values of latest revision from the sheet object
    -- Determine if a gadget is active depending on whether the gadget data comes from the revision element or elsewhere
    !attrib = !sytmRefe.:Func.after('#')
    if (!attrib.match('FR').neq(0)) then
      !this.cellCode.append(!attrib.before('<'))
    else
      !this.cellCode.append(!attrib)
    endif

  enddo

  -- Set these members
  !this.entryLibRefe = !entryLib[1].dbref()
  !this.cellSytm     = !allSytm
  !this.cellColumn   = !allColumn
  !this.move         = !this.entryLibRefe.attribute(':Move')
  !this.dire         = !this.entryLibRefe.attribute(':Dire')

endmethod
-- End of method definition for .getData(DBREF)

------------------------------------------------------------------------
--
-- Method:      .getExtra(DBREF)
--
-- Description: Get library revision extra data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The standard library for the MTO extraction
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getExtra(!stdLibyRefe is DBREF)

  -- Get the extra revision data
  VAR !extraLib COLL ALL LALB WI FUNC EQ 'Extra Revision Data' FOR $!stdLibyRefe
  VAR !allSytm COLL ALL SYTM FOR $!extraLib[1]
  VAR !funcs EVAL :func FOR ALL FROM !allSytm
  VAR !descs EVAL :description FOR ALL FROM !allSytm
  VAR !purps EVAL :purp FOR ALL FROM !allSytm
  var !pml   EVAL FUNC FOR ALL FROM !allSytm

  -- Get codes
  do !index ind !allSytm

    -- Initialise variables
    !attrib = !funcs[!index].after('#')

    -- Get current values of latest revision from the sheet object
    -- Determine if a gadget is active depending on whether the gadget data comes from the revision element or elsewhere
    !attrib = !funcs[!index].after('#')
    if (!attrib.match('FR').neq(0)) then
      !this.extraCode.append(!attrib.before('<'))
      else
        !this.extraCode.append(!attrib)
      endif

      -- Test for udas
      if (!this.extraCode[!index].match(':').neq(0)) then
        !this.extraGName.append(!this.extraCode[!index].after(':'))
      else
        !this.extraGName.append(!this.extraCode[!index])
      endif

  enddo

  -- Set these members
  !this.extraFunc  = !funcs
  !this.extraDesc  = !descs
  !this.extraPurp  = !purps
  !this.extraWidth = !extraLib[1].dbref().attribute(':Move')
  !this.extraPML   = !pml

endmethod
-- End of method definition for .getExtra(DBREF)

------------------------------------------------------------------------
--
-- Method:      .getReserved(DBREF)
--
-- Description: Get library revision reserved areas
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       BACK reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getReserved(!backRefe is DBREF)

  -- Get revision block reserved areas
  VAR !allRect COLL ALL RECT WI SPPURP OF OWNE EQ 'RESERV' AND :FUNC EQ 'Revision' FOR $!backRefe

  -- For each rectangle build a table object
  do !rect value !allRect
    !this.reserved.append(object LALTABLE(!rect.dbref(), !this.move, !this.dire))
  enddo

endmethod
-- End of method definition for .getReserved(DBREF)
