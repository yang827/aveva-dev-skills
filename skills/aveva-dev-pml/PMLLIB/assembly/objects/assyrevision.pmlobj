-- Created:         30 July 2002
--
--
-- Description:
-- The drawing revision data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getData(DBREF)                   -                   Set this object members
--  lalRevision()                    -
--  setData()                        -                   Set attributes to object member values
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
define object ASSYREVISION

  member .reviRefe is DBREF

  member .revD is STRING
  member .appD is STRING
  member .rvsN is STRING
  member .rvAu is STRING
  member .appr is STRING
  member .appr2 is STRING
  member .appr3 is STRING
  member .jobNo is STRING
  member .preRevision is STRING
  member .checkedBy is STRING
  member .description is STRING
  member .discEng is STRING
  member .projEng is STRING
  member .engg is STRING
  member .cert is STRING
  member .pmt is STRING
  member .oprns is STRING
  member .intExt is STRING

endobject

------------------------------------------------------------------------
--
-- Method:      .revision()
--
-- Description: Set this object members to null string
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .lalRevision()

  !this.revD        = ' '
  !this.appD        = ' '
  !this.rvsN        = ' '
  !this.rvAu        = ' '
  !this.appr        = ' '
  !this.appr2       = ' '
  !this.appr3       = ' '
  !this.jobNo       = ' '
  !this.preRevision = ' '
  !this.checkedBy   = ' '
  !this.description = ' '
  !this.discEng     = ' '
  !this.projEng     = ' '
  !this.engg        = ' '
  !this.cert        = ' '
  !this.pmt         = ' '
  !this.oprns       = ' '
  !this.intExt      = ' '

endmethod
-- End of method definition for .lalRevision()

------------------------------------------------------------------------
--
-- Method:      .getData(DBREF)
--
-- Description: Set this object members
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       REVIsion reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getData(!reviRefe is DBREF)

  !this.reviRefe    = !reviRefe

  !this.revD        = !reviRefe.revD
  !this.appD        = !reviRefe.appD
  !this.rvsN        = !reviRefe.rvsN
  !this.rvAu        = !reviRefe.rvAu
  !this.appr        = !reviRefe.appr
  !this.appr2       = !reviRefe.attribute(':approver2')
  !this.appr3       = !reviRefe.attribute(':approver3')
  !this.jobNo       = !reviRefe.attribute(':jobNo')
  !this.preRevision = !reviRefe.attribute(':preRevision')
  !this.checkedBy   = !reviRefe.attribute(':checkedBy')
  !this.description = !reviRefe.attribute(':description')
  !this.discEng     = !reviRefe.attribute(':discEng')
  !this.projEng     = !reviRefe.attribute(':projEng')
  !this.engg        = !reviRefe.attribute(':engg')
  !this.cert        = !reviRefe.attribute(':cert')
  !this.pmt         = !reviRefe.attribute(':pmt')
  !this.oprns       = !reviRefe.attribute(':oprns')
  !this.preFin      = !reviRefe.attribute(':intExt')

endmethod
-- End of method definition for .getData(DBREF)

------------------------------------------------------------------------
--
-- Method:      .setData()
--
-- Description: Set attributes to object member values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData()

  !!ce = !this.reviRefe

  !revD        = !this.revD
  !appD        = !this.appD
  !rvsN        = !this.rvsN
  !rvAu        = !this.rvAu
  !appr        = !this.appr
  !jobNo       = !this.jobNo
  !preRevision = !this.preRevision
  !checkedBy   = !this.checkedBy
  !description = !this.description
  !discEng     = !this.discEng
  !projEng     = !this.projEng
  !engg        = !this.engg
  !cert        = !this.cert
  !pmt         = !this.pmt
  !oprns       = !this.oprns
  !preFin      = !this.preFin

  REVD  '$!revD'
  APPD  '$!appD'
  RVSN  '$!rvsN'
  RVAU  '$!rvAu'
  APPR  '$!appr'
  :jobNo  '$!jobNo'
  :preRevision  '$!preRevision'
  :checkedBy  '$!checkedBy'
  :description  '$!description'
  :discEng  '$!discEng'
  :projEng  '$!projEng'
  :engg  '$!engg'
  :cert  '$!cert'
  :pmt  '$!pmt'
  :oprns  '$!oprns'
  :preFin  $!preFin

endmethod
-- End of method definition for .setData()
