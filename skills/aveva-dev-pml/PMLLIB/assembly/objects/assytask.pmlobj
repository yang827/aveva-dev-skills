--
-- Description:
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assyTask(DBREF)                  -                   Construct
--  execute()                        -                   Execute this task
--
------------------------------------------------------------------------
------------------------------------------------------------------------
define object ASSYTASK

  -- Task attributes
  member .reference   is DBREF
  member .purpose     is STRING
  member .description is STRING
  member .pmlFunction is STRING

  -- Task parameters
  member .paramVal    is ARRAY
  member .paramType   is ARRAY
  member .paramPurp   is ARRAY
  member .paramDesc   is ARRAY

endobject

------------------------------------------------------------------------
--
-- Method:        .assyTask()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The Task reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assyTask(!reference is DBREF)

  -- Set attributes
  !this.reference   = !reference
  !this.purpose     = !this.reference.spPurpose
  !this.description = !this.reference.function
  !this.pmlFunction = !this.reference.pmlFunction

  -- Get parameters
  do !tkPara val !this.reference.memb
    !this.paramVal.append(!tkPara.tpValue)
    !this.paramType.append(!tkPara.pType)
    !this.paramPurp.append(!tkPara.spPurpose)
    !this.paramDesc.append(!tkPara.function)
  enddo

endmethod
-- End of method definition for .assyTask(DBREF)

------------------------------------------------------------------------
--
-- Method:      .execute()
--
-- Description: Execute this task
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .execute()

  -- Initialise variables
  !array = ARRAY()

  -- Store current hierarchy location
  !location = !!ce

  -- Read task parameter values
  !array = !this.paramVal

  -- Execute the pml function
  $!<this.pmlFunction>

  -- Return to original hierarchy position
  !!ce = !location
    handle (2,822)
      -- Cannot set current element to an unset reference
    endhandle

endmethod
-- End of method definition for .execute()
