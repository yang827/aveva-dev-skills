--
-- File:            assyarrange.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2006
--
--
-- Description:
-- Arrange labels around the owning view limits
--
-- LIMITATIONS
-- The line created to represent the leaderline is not accurate
-- when the template is a TXTM or GLAB.
-- This is because it's end point is at the bottom or top of the gbox
-- and not at the label xypo since the core program can switch this point
-- automatically.
-- This produces a minute error which may cause undetermined intersections.
-- The solution used here, is to set the bpof and lsha to give a short
-- line (0.1mm long) at the label to enable the end point to be predicted.
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      Argument 1 to 4 are the sides for arranging labels
--                                    1 = Top; 2 = Bottom; 3 = Left; 4 = Right
--                                    Values can be ON/OFF or YES/NO
--                           Argument 5 is the Margin from view limit to label origin
--                           Argument 6 is the Minimum gap between labels
--
-- ASSUMPTIONS
-- The current element must be the LAYE to be processed
--
------------------------------------------------------------------------
define function !!assyArrange(!arguments is ARRAY)

  -- Remember layer
  !layeRefe = !!ce

  -- Initialise variables for the VIEW
  VIEW
  !view = !!ce
  !viewXpos   = !view.xypo.east
  !viewYpos   = !view.xypo.north
  !rcode      = !view.rcode
  !margin     = !arguments[5].real(!!distanceFMT)
  !gap        = !arguments[6].real(!!distanceFMT)
  !xIsLongest = false
  !yIsLongest = false
  !triTRUp    = ARRAY()
  !triTRRight = ARRAY()
  !triTLUp    = ARRAY()
  !triTLLeft  = ARRAY()
  !triBRDown  = ARRAY()
  !triBRRight = ARRAY()
  !triBLDown  = ARRAY()
  !triBLLeft  = ARRAY()
  !numbSides  = 0

  -- Set side switches
  !sides[1] = !arguments[1].boolean()
  !sides[2] = !arguments[2].boolean()
  !sides[3] = !arguments[3].boolean()
  !sides[4] = !arguments[4].boolean()

  -- Set side data (margin and gap)
  -- -------------------------------------------------------------------------------------
  -- CURRENTLY THE MARGIN & GAP ARE USED FOR ALL SIDES BUT WE COULD ALLOW DIFFERENT VALUES
  -- -------------------------------------------------------------------------------------
   !viewSide[1] = object ASSYTAGSIDE()
   !viewSide[1].desc = 'top'
   !viewSide[1].gap = !gap
   !viewSide[1].margin = !margin
   !viewSide[1].just = 'L'
   !viewSide[2] = object ASSYTAGSIDE()
   !viewSide[2].desc = 'bottom'
   !viewSide[2].gap = !gap
   !viewSide[2].margin = !margin
   !viewSide[2].just = 'R'
   !viewSide[3] = object ASSYTAGSIDE()
   !viewSide[3].desc = 'left'
   !viewSide[3].gap = !gap
   !viewSide[3].margin = !margin
   !viewSide[3].just = 'R'
   !viewSide[4] = object ASSYTAGSIDE()
   !viewSide[4].desc = 'right'
   !viewSide[4].gap = !gap
   !viewSide[4].margin = !margin
   !viewSide[4].just = 'L'

  -- Set arrays with orientation data
   if (!rcode.upCase().eq('UP') or !rcode.upCase().eq('DOWN')) then
     !viewSide[1].coord = 'east'
     !viewSide[1].length = !view.size[1] + (!margin * 2)
     !viewSide[2].coord = 'east'
     !viewSide[2].length = !view.size[1] + (!margin * 2)
     !viewSide[3].coord = 'north'
     !viewSide[3].length = !view.size[2] + (!margin * 2)
     !viewSide[4].coord = 'north'
     !viewSide[4].length = !view.size[2] + (!margin * 2)
   else
     !viewSide[1].coord = 'north'
     !viewSide[1].length = !view.size[2] + (!margin * 2)
     !viewSide[2].coord = 'north'
     !viewSide[2].length = !view.size[2] + (!margin * 2)
     !viewSide[3].coord = 'east'
     !viewSide[3].length = !view.size[1] + (!margin * 2)
     !viewSide[4].coord = 'east'
     !viewSide[4].length = !view.size[1] + (!margin * 2)
   endif

   if (!rcode.upCase().eq('UP')) then
      !viewSide[1].angle = 90
      !viewSide[2].angle = 90
      !viewSide[3].angle = 0
      !viewSide[4].angle = 0
   elseif (!rcode.upCase().eq('DOWN')) then
      !viewSide[1].angle = -90
      !viewSide[2].angle = -90
      !viewSide[3].angle = 180
      !viewSide[4].angle = 180
   elseif (!rcode.upCase().eq('LEFT')) then
      !viewSide[1].angle = 0
      !viewSide[2].angle = 0
      !viewSide[3].angle = -90
      !viewSide[4].angle = -90
   elseif (!rcode.upCase().eq('RIGHT')) then
      !viewSide[1].angle = 180
      !viewSide[2].angle = 180
      !viewSide[3].angle = 90
      !viewSide[4].angle = 90
   endif

  -- Calculate longest side
   if (!view.size[1].gt(!view.size[2])) then
     !xIsLongest = true
   else
     !yIsLongest = true
   endif

  -- Calculate corner positions of a rectangle representing the view limits plus margin
   if (!view.rcode.upCase().eq('UP') or !view.rcode.upCase().eq('DOWN')) then
     !sideX = !view.size[1] / 2 + !margin
     !sideY = !view.size[2] / 2 + !margin
   else
     !sideX = !view.size[2] / 2 + !margin
     !sideY = !view.size[1] / 2 + !margin
   endif
   !topRight = object POSITION('X' & (!viewXpos + !sideX) & ' Y' & (!viewYpos + !sideY))
   !topLeft = object POSITION('X' & (!viewXpos - !sideX) & ' Y' & (!viewYpos + !sideY))
   !bottomRight = object POSITION('X' & (!viewXpos + !sideX) & ' Y' & (!viewYpos - !sideY))
   !bottomLeft = object POSITION('X' & (!viewXpos - !sideX) & ' Y' & (!viewYpos - !sideY))

  -- Set side start coordinates
   !viewSide[1].startXPos = !topLeft.east
   !viewSide[1].startYPos = !topLeft.north
   !viewSide[2].startXPos = !bottomLeft.east
   !viewSide[2].startYPos = !bottomLeft.north
   !viewSide[3].startXPos = !bottomLeft.east
   !viewSide[3].startYPos = !bottomLeft.north
   !viewSide[4].startXPos = !bottomRight.east
   !viewSide[4].startYPos = !bottomRight.north

  -- Build directions to break down the rectangle into triangles
   !diagonalTR = !view.xypo.direction(!topRight)
   !diagonalTL = !view.xypo.direction(!topLeft)
   !diagonalBR = !view.xypo.direction(!bottomRight)
   !diagonalBL = !view.xypo.direction(!bottomLeft)

  -- Get labels
   VAR !allLabels COLL ALL (SLAB GLAB) FOR $!layeRefe

  -- Check for only one side selected since this means that all labels
  -- will be arranged on this side and hence will not need to be grouped
   do !index ind !sides
     if (!sides[!index]) then
       !numbSides = !numbSides + 1
     endif
   enddo

  -- For no sides
   if (!numbSides.eq(0)) then
     !!alert.error('Cannot arrange labels - No sides have been selected')
     return
   endif

  -- Group labels
   if (!numbSides.gt(1)) then

     -- Put labels into the relevant triangle group
     do !label val !allLabels

       -- Put each label at zero offset from ddnm & get page position
       -- If apoff is set use that offset for xypo, but unfortunately,
       -- have to use var syntax since !!ce.apof returns -1 if unset
       !!ce = !label.dbref()
       VAR !apof APOF

       OSET TRUE
         handle any
         endhandle
       if (!apof.upCase().neq('UNSET') and !apof.upCase().neq('')) then
         XYPO $!apof
       else
         XYPO 0 0
       endif
       OSET FALSE
         handle any
         endhandle

       if (!label.dbref().hardType.upCase().eq('SLAB')) then
         -- Set attributes to use template values
         TPEN TEMP  CHEI TEMP  LFPEN TEMP
       endif

       -- Initialise variables
       !thisLabel = object ASSYLABEL()
       !thisLabel.reference = !label.dbref()
       !thisLabel.direction = !view.xypo.direction(!thisLabel.reference.xypo)
         handle (2,891)
           !thisLabel.direction = object DIRECTION('E')
         endhandle
       !thisLabel.startPoint = !thisLabel.reference.xypo
       !labelDir = !thisLabel.direction

       -- Test against all triangles
       -- Allow for position exactly on triangle edge - in which case add to longest view side
       if (!label.dbref().xypo.north.gt(!viewYpos)) then

         -- Top
         if (not !labelDir.east.lt(!diagonalTR.east) and !labelDir.north.lt(!diagonalTR.north)) then
           !triTRRight.append(!thisLabel)
         elseif (not !labelDir.east.lt(0) and not !labelDir.north.lt(!diagonalTR.north)) then
           !triTRUp.append(!thisLabel)
         elseif (!labelDir.east.lt(0) and not !labelDir.north.lt(!diagonalTL.north)) then
           !triTLUp.append(!thisLabel)
         elseif (!labelDir.east.lt(0) and !labelDir.north.lt(!diagonalTL.north)) then
           !triTLLeft.append(!thisLabel)
         elseif !labelDir.east.eq(!diagonalTR.east) then
           if (!xIsLongest) then
             !triTRUp.append(!thisLabel)
           else
             !triTRRight.append(!thisLabel)
           endif
         elseif !labelDir.east.eq(!diagonalTL.east) then
           if (!xIsLongest) then
             !triTLUp.append(!thisLabel)
           else
             !triTLLeft.append(!thisLabel)
           endif
         elseif !labelDir.east.eq(0) then
           !triTRUp.append(!thisLabel)
         elseif !labelDir.east.eq(-1) then
           !triTLLeft.append(!thisLabel)
         elseif !labelDir.east.eq(1) then
           !triTRRight.append(!thisLabel)
         endif

       else

         -- Bottom
         if (not !labelDir.east.lt(!diagonalBR.east) and not !labelDir.north.lt(!diagonalBR.north)) then
           !triBRRight.append(!thisLabel)
         elseif (not !labelDir.east.lt(0) and !labelDir.north.lt(!diagonalBR.north)) then
           !triBRDown.append(!thisLabel)
         elseif (!labelDir.east.lt(0) and !labelDir.north.lt(!diagonalBL.north)) then
           !triBLDown.append(!thisLabel)
         elseif (!labelDir.east.lt(0) and not !labelDir.north.lt(!diagonalBL.north)) then
           !triBLLeft.append(!thisLabel)
         elseif !labelDir.east.eq(!diagonalBR.east) then
           if (!xIsLongest) then
             !triBRDown.append(!thisLabel)
           else
             !triBRRight.append(!thisLabel)
           endif
         elseif !labelDir.east.eq(!diagonalBL.east) then
           if (!xIsLongest) then
             !triBLDown.append(!thisLabel)
           else
             !triBLLeft.append(!thisLabel)
           endif
         elseif !labelDir.east.eq(0) then
           !triBRDown.append(!thisLabel)
         elseif !labelDir.east.eq(-1) then
           !triBLLeft.append(!thisLabel)
         elseif !labelDir.east.eq(1) then
           !triBRRight.append(!thisLabel)
         endif

       endif

     enddo

     -- Group triangle groups into side groups
     -- Top side
     if (!sides[1]) then

       !viewSide[1].labels.appendArray(!triTRUp)
       !viewSide[1].labels.appendArray(!triTLUp)

       -- If no left
       if (not !sides[3]) then
         !viewSide[1].labels.appendArray(!triTLLeft)

         -- If no bottom
         if (not !sides[2]) then
            !viewSide[1].labels.appendArray(!triBLLeft)
         endif
       endif

       -- If no right
       if (not !sides[4]) then
         !viewSide[1].labels.appendArray(!triTRRight)

         -- If no bottom
         if (not !sides[2]) then
            !viewSide[1].labels.appendArray(!triBRRight)
         endif
       endif

     endif

     -- Bottom side
     if (!sides[2]) then

       !viewSide[2].labels.appendArray(!triBRDown)
       !viewSide[2].labels.appendArray(!triBLDown)

       -- If no left
       if (not !sides[3]) then
         !viewSide[2].labels.appendArray(!triBLLeft)

         -- If no top
         if (not !sides[1]) then
            !viewSide[2].labels.appendArray(!triTLLeft)
         endif
       endif

       -- If no right
       if (not !sides[4]) then
         !viewSide[2].labels.appendArray(!triBRRight)

         -- If no top
         if (not !sides[1]) then
            !viewSide[2].labels.appendArray(!triTRRight)
         endif
       endif

     endif

     -- Left side
     if (!sides[3]) then

       !viewSide[3].labels.appendArray(!triTLLeft)
       !viewSide[3].labels.appendArray(!triBLLeft)

       -- If no top
       if (not !sides[1]) then
         !viewSide[3].labels.appendArray(!triTLUp)

         -- If no right
         if (not !sides[4]) then
            !viewSide[3].labels.appendArray(!triTRUp)
         endif
       endif

       -- If no bottom
       if (not !sides[2]) then
         !viewSide[3].labels.appendArray(!triBLDown)

         -- If no right
         if (not !sides[4]) then
            !viewSide[3].labels.appendArray(!triBRDown)
         endif
       endif

     endif

     -- Right side
     if (!sides[4]) then

       !viewSide[4].labels.appendArray(!triTRRight)
       !viewSide[4].labels.appendArray(!triBRRight)

       -- If no top
       if (not !sides[1]) then
         !viewSide[4].labels.appendArray(!triTRUp)

         -- If no left
         if (not !sides[3]) then
            !viewSide[4].labels.appendArray(!triTLUp)
         endif
       endif

       -- If no bottom
       if (not !sides[2]) then
         !viewSide[4].labels.appendArray(!triBRDown)

         -- If no left
         if (not !sides[3]) then
            !viewSide[4].labels.appendArray(!triBLDown)
         endif
       endif

     endif

   else

     -- Group labels for single selected side
     do !count from 1 to 4
       if (!sides[!count]) then
         do !label val !allLabels

           -- Put each label at zero offset from ddnm & get page position
           !!ce = !label.dbref()

           OSET TRUE
           XYPO 0 0
             handle (2,201)
               -- For any tagged element that does not have a position eg FRMK
               skip
             endhandle
           OSET FALSE

           if (!label.dbref().hardType.upCase().eq('SLAB')) then
             -- Set attributes to use template values
             TPEN TEMP  CHEI TEMP  LFPEN TEMP
           endif

           -- Initialise variables
           !thisLabel = object LABEL()
           !thisLabel.reference = !label.dbref()
           !thisLabel.direction = !view.xypo.direction(!thisLabel.reference.xypo)
           !thisLabel.startPoint = !thisLabel.reference.xypo

           !viewSide[!count].labels.append(!thisLabel)

         enddo
       endif
     enddo

   endif

  -- Process each side
  do !count from 1 to 4

    -- Make arrangement first pass by sorting label startpoints
    !points = !viewSide[!count].readPos(!viewSide[!count].coord)
    !order = !points.sortedIndices()
    !viewSide[!count].labels.reIndex(!order)

    -- Calculate side spacings
    if (!viewSide[!count].labels.size().gt(0)) then
      !viewSide[!count].spacing = !viewSide[!count].length / !viewSide[!count].labels.size()
    endif

    -- Calculate all label positions
    do !index ind !viewSide[!count].labels

      -- Calculate end position
      if (!index.eq(1)) then

        -- First point
        -- Test for top, bottom
        if (!count.eq(1) or !count.eq(2)) then
          !xStart = (!viewSide[!count].startXPos + (!viewSide[!count].spacing / 2))
          !position = 'X' & !xStart & ' Y' & !viewSide[!count].startYPos
        else
          !yStart = (!viewSide[!count].startYPos + (!viewSide[!count].spacing / 2))
          !position = 'X' & !viewSide[!count].startXPos & ' Y' & !yStart
        endif

      else

        -- Incremental point
        -- Test for top, bottom
        if (!count.eq(1) or !count.eq(2)) then
          !xStart = !xStart + !viewSide[!count].spacing
          !position = 'X' & !xStart & ' Y' & !viewSide[!count].startYPos
        else
          !yStart = !yStart + !viewSide[!count].spacing
          !position = 'X' & !viewSide[!count].startXPos & ' Y' & !yStart
        endif

      endif

      -- Store end point position
      !viewSide[!count].labels[!index].endPoint = object POSITION(!position)

      -- Store end point offset from the label origin to label frame (CPOF)
      -- For a TXTM this is rectangular and hence the value relates to the GBOX attribute
      -- If an SYTM were required then a more sophisticated approach would be necessary.
      if (!viewSide[!count].labels[!index].reference.hardType.upCase().eq('GLAB')) then
        !viewSide[!count].labels[!index].cpof[1] = !viewSide[!count].labels[!index].reference.sorf.tmrf.gbox
        !viewSide[!count].labels[!index].cpof[2] = 0
      elseif (!viewSide[!count].labels[!index].reference.tmrf.hardType.upCase().eq('TXTM')) then
        !viewSide[!count].labels[!index].cpof[1] = !viewSide[!count].labels[!index].reference.tmrf.gbox
        !viewSide[!count].labels[!index].cpof[2] = 0
      elseif (!viewSide[!count].labels[!index].reference.hardType.upCase().eq('SLAB')) then
        !viewSide[!count].labels[!index].cpof[1] = 0
        !viewSide[!count].labels[!index].cpof[2] = 0
      endif

    enddo

    -- Check for intersections
    !viewSide[!count].tagSwitch(!count)

    -- Position labels
    do !index ind !viewSide[!count].labels

      -- Access label
      !!ce = !viewSide[!count].labels[!index].reference

      -- Set position, orientation & justification
      !eastPoint = !viewSide[!count].labels[!index].endPoint.east
      !northPoint = !viewSide[!count].labels[!index].endPoint.north
      !position = 'X' & !eastPoint.value() & ' Y' & !northPoint.value()

      XYPO $!position
--      ADEG $!viewSide[$!count].angle
--      JUST $!viewSide[$!count].just
--      LSHA STRA
--      ALIG HB
      CPOF STANDARD

      -- Check for footprint overlap
      if (!index.eq(1)) then

        var !extent split extent btex
        if (!count.eq(1) or !count.eq(2)) then
          !width = !extent[14].real(!!distanceFMT) - !extent[2].real(!!distanceFMT)
        else
          !width = !extent[4].real(!!distanceFMT) - !extent[16].real(!!distanceFMT)
        endif

        -- Calculate the clearance between labels
        !clear = !viewSide[!count].spacing - !width
        !clearInt = !clear.nint()
        if (!clear.lt(!viewSide[!count].gap)) then
          !!assyLog.add('   Warning! - The gap between arranged labels ($!clearInt) is less than specified')
        endif

      endif

    enddo

  enddo

  -- Return to LAYE
  !!ce = !layeRefe

endfunction
-- End of function !!assyArrange(ARRAY)
