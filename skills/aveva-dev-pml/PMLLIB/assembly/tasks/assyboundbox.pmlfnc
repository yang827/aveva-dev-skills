--
-- File:            assyboundbox.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Build the Assembly Bounding Box
--
--
-- ASSUMPTIONS
-- The current element is the VIEW
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        [1] WORLD or LOCAL volume
--                            [2] Line Colour
--                            [3] Line Style
--                            [4] Dimension Text ON or OFF
--                            [5] Text character height
--                            [6] Text Colour
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!assyBoundBox(!arguments is ARRAY)

  -- Initialise variables
  !viewRefe  = !!ce
  !sheeRefe  = !viewRefe.owne
  !drwgRefe  = !viewRefe.owne.owne
  !coords    = !arguments[1]
  !nlColour  = !arguments[2]
  !nlStyle   = !arguments[3]
  !textOn    = !arguments[4].upCase().eq('ON')
  !chei      = !arguments[5]
  !txColour  = !arguments[6]

  WARNINGS OFF

  -- Get view direction as a string
  VAR !vDir DIR

  -- Get into position in hierarchy by finding an existing layer
  VAR !propertyLaye COLL ALL LAYE WI SPPURP EQ 'ASBBOX' FOR $!viewRefe

  -- Get the assembly being detailed from the DRWG IDLN
  if (!drwgRefe.idln.badref()) then
    !!assyLog.add('  Cannot produce the bounding box since cannot access assembly due to bad reference DRWG IDLN. Aborting...')
    return
  else

    -- Use the referenced assembly
    !asmblyRefe = !drwgRefe.idln

    -- Check if the assembly has any members
    if (!asmblyRefe.sexpnd.empty()) then
      !!assyLog.add('  Cannot produce the bounding box since the assembly does not contain any parts. Aborting...')
      return
    endif

  endif

  -- Check for an assembly orientation of upright.Any other will give a bad result,
  -- since the volume query does not take the orientation into account, so stop here
  if (!asmblyRefe.asori.neq(0) and !asmblyRefe.asori.neq(1)) then
    !!assyLog.add('  Cannot produce the bounding box since the assembly has an orientation other than Upright. Aborting...')

    -- Delete any existing bounding box
    if (!propertyLaye.empty().not()) then

      -- Access the existing laye and delete all existing elements
      !!ce = !propertyLaye[1].dbref()
      DELETE LAYE MEM

    endif

    -- Stop here
    return

  endif

  -- Get the assembly volume
  if (!coords.upCase().eq('WORLD')) then
    !limits = !asmblyRefe.wvol
  else
    !limits = !asmblyRefe.lvol
  endif

  -- Test for valid limits
  if (!limits.unset() or (!limits[1].leq(0) and !limits[2].leq(0) and !limits[3].leq(0))) then

    -- Get the assembly volume from the drawlist
    if (!coords.upCase().eq('WORLD')) then
      !limits = !sheeRefe.idln.wvol
    else
      !limits = !sheeRefe.idln.lvol
    endif

  endif

  -- Build a suitable layer
  if (!propertyLaye.empty()) then

    -- Create the laye
    !layeName = !viewRefe.flnm & '/Laye/BoundingBox'
    NEW LAYE $!layeName
    SPPURP ASBBOX  PURP ADAX

    -- Switch cascading off
    REPSTYLE CASCADING OFF

    -- Set line style and colour
    NLSTYLE $!nlStyle
    NLCOLOUR $!nlColour
      handle (61,604)
        -- F&M: Requested colour not found in colour dictionary
        !!assyLog.add('  Could not set the axes line colour ' & !nlColour & '. Setting to 4 (Yellow).')
          NLCOLOUR 4
      endhandle

  -- Clear the layer
  else

    -- Access the existing laye and delete all existing elements
    !!ce = !propertyLaye[1].dbref()
    DELETE LAYE MEM

  endif

  -- Create a new view note
  NEW VNOT
    NLCOLOUR DEF
    NLSTYLE  DEF

  -- Create the straights for each side of the box
  -- S,D,E-W
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[1] N $!limits[2] U $!limits[3]
      handle (2,303)
        -- Value out of range of this machine
        VNOT DELETE VNOT
        !!assyLog.add('  Cannot produce the bounding box since the assembly has bad limits. Aborting...')
        return
      endhandle
    TPT POS E $!limits[4] N $!limits[2] U $!limits[3]
      handle (2,303)
        -- Value out of range of this machine
        VNOT DELETE VNOT
        !!assyLog.add('  Cannot produce the bounding box since the assembly has bad limits. Aborting...')
        return
      endhandle
  TCODE MID
--  !adeg = !!ce.adeg
  VAR !adeg ADEG
  !leng = !limits[4] -  !limits[1]
  !leng = !leng.nint()

  -- Add this side length text
  if (!vDir.neq('E') and !vDir.neq('W') and !textOn) then
    NEW TEXP CHEI $!chei BTEX '$!leng' ADEG $!adeg JUST C ALIG TB
      TXCOLOUR $!txColour
        handle (61,604)
          -- F&M: Requested colour not found in colour dictionary
          !!assyLog.add('  Could not set the axes text colour ' & !txColour & '. Setting to 6 (Cyan).')
            TXCOLOUR 6
        endhandle

  endif

  -- S,U,E-W
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[1] N $!limits[2] U $!limits[6]
    TPT POS E $!limits[4] N $!limits[2] U $!limits[6]

  -- N,D,E-W
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[1] N $!limits[5] U $!limits[3]
    TPT POS E $!limits[4] N $!limits[5] U $!limits[3]

  -- N,U,E-W
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[1] N $!limits[5] U $!limits[6]
    TPT POS E $!limits[4] N $!limits[5] U $!limits[6]

  -- W,D,N-S
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[1] N $!limits[2] U $!limits[3]
    TPT POS E $!limits[1] N $!limits[5] U $!limits[3]

  -- W,U,N-S
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[1] N $!limits[2] U $!limits[6]
    TPT POS E $!limits[1] N $!limits[5] U $!limits[6]

  -- E,D,N-S
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[4] N $!limits[2] U $!limits[3]
    TPT POS E $!limits[4] N $!limits[5] U $!limits[3]

  -- E,U,N-S
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[4] N $!limits[2] U $!limits[6]
    TPT POS E $!limits[4] N $!limits[5] U $!limits[6]
  TCODE MID
--  !adeg = !!ce.adeg + 180
  VAR !adeg delete
  VAR !aDegrees ADEG
  !adeg = !aDegrees.real() + 180

  !leng = !limits[5] -  !limits[2]
  !leng = !leng.nint()

  -- Add this side length text
  if (!vDir.neq('N') and !vDir.neq('S') and !textOn) then
    NEW TEXP CHEI $!chei BTEX '$!leng' ADEG $!adeg JUST C ALIG BB
      TXCOLOUR $!txColour
        handle (61,604)
          -- F&M: Requested colour not found in colour dictionary
          !!assyLog.add('  Could not set the axes text colour ' & !txColour & '. Setting to 6 (Cyan).')
            TXCOLOUR 6
        endhandle
  endif

  -- W,S,U-D
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[1] N $!limits[2] U $!limits[3]
    TPT POS E $!limits[1] N $!limits[2] U $!limits[6]

  -- W,N,U-D
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[1] N $!limits[5] U $!limits[3]
    TPT POS E $!limits[1] N $!limits[5] U $!limits[6]

  -- E,S,U-D
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[4] N $!limits[2] U $!limits[3]
    TPT POS E $!limits[4] N $!limits[2] U $!limits[6]
  TCODE MID
--  !adeg = !!ce.adeg
  VAR !adeg delete
  VAR !adeg ADEG
  !leng = !limits[6] -  !limits[3]
  !leng = !leng.nint()

  -- Add this side length text
  if (!vDir.neq('U') and !vDir.neq('D') and !textOn) then
    NEW TEXP CHEI $!chei BTEX '$!leng' ADEG $!adeg JUST C ALIG TB
      TXCOLOUR $!txColour
        handle (61,604)
          -- F&M: Requested colour not found in colour dictionary
          !!assyLog.add('  Could not set the axes text colour ' & !txColour & '. Setting to 6 (Cyan).')
            TXCOLOUR 6
        endhandle
  endif

  -- E,N,U-D
  NEW STRA
    NLCOLOUR DEF  NLSTYLE DEF
    FPT POS E $!limits[4] N $!limits[5] U $!limits[3]
    TPT POS E $!limits[4] N $!limits[5] U $!limits[6]

  -- Return to View
  !!ce = !viewRefe

endfunction
-- End of function !!assyBoundBox
