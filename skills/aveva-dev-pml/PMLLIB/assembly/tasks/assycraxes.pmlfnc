-- File:            assycraxes.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 May 1999
--
--
-- Description:
-- Create the axes symbol in the view
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1    R     ARRAY of STRINGs Index [1]  Principal Axis ON, OFF
--                                      [2]  Type PDMS, MARINE
--                                      [3]  Location relative to the View Centre C, TL, TR, BL, BR, TC, BC, LC, RC
--                                      [4]  Scale Factor (10)
--                                      [5]  Terminator OFF, ARR, DOT, OBL, OPENA, NARR, WIDE, SLAS, OPEND
--                                      [6]  Terminator Size (3)
--                                      [7]  Font (1)
--                                      [8]  Character Height (4mm)
--                                      [9]  Text Colour (Grey)
--                                      [10] Line Style (Solid)
--                                      [11] Line Colour (Grey)
--                                      [12] Visible ON, OFF
--                                      [13] Associate to the assembly YES, NO
--
-- ASSUMPTIONS
-- The current element must be the VIEW to be processed
--
------------------------------------------------------------------------
define function !!assyCrAxes(!arguments is ARRAY)

  -- Set warnings off
  WARNINGS OFF

  -- Initialise variables
  !princAxis   = !arguments[1]
  !axesType    = !arguments[2]
  !offsetCode  = !arguments[3]
  !scaleFactor = !arguments[4]
  !termType    = !arguments[5]
  !termSize    = !arguments[6]
  !font        = !arguments[7]
  !chei        = !arguments[8]
  !textCol     = !arguments[9]
  !lineStyle   = !arguments[10]
  !lineCol     = !arguments[11]
  !visible     = !arguments[12].eq('ON')
  !associate   = !arguments[13].eq('YES')

  -- Try to reach the view
  VIEW
    handle (2,111)
      -- Cannot access element type VIEW from the level
      !!assyLog.add('  Could not create the axes symbol since could not locate the VIEW.')
      return
    endhandle
  !viewRefe = !!ce

  -- Get view data
  !viewNam  = !viewRefe.flnm
  !viewSize = !viewRefe.size
  !viewHX   = !viewSize[1] / 2
  !viewHY   = !viewSize[2] / 2

  -- Get assembly
  !asmblyRefe = !viewRefe.owne.owne.idln

  -- Calculate the symbol paper position
  if (!offsetCode.eq('C')) then
    !xPos = 0
    !yPos = 0
  elseif (!offsetCode.eq('TL')) then
    !xPos = - !viewHX
    !yPos = !viewHY
  elseif (!offsetCode.eq('TR')) then
    !xPos = !viewHX
    !yPos = !viewHY
  elseif (!offsetCode.eq('BL')) then
    !xPos = - !viewHX
    !yPos = - !viewHY
  elseif (!offsetCode.eq('BR')) then
    !xPos = !viewHX
    !yPos = - !viewHY
  elseif (!offsetCode.eq('TC')) then
    !xPos = 0
    !yPos = !viewHY
  elseif (!offsetCode.eq('BC')) then
    !xPos = 0
    !yPos = - !viewHY
  elseif (!offsetCode.eq('LC')) then
    !xPos = - !viewHX
    !yPos = 0
  elseif (!offsetCode.eq('RC')) then
    !xPos = !viewHX
    !yPos = 0
  else
    !xPos = 0
    !yPos = 0
  endif

  -- Get the axes laye
  var !allLaye COLL ALL LAYE WI SPPURP EQ 'AXES' FOR $!viewRefe

  -- Test for any Layer
  if (!allLaye.unset() or !allLaye.empty()) then

    -- Construct laye name using the view name as a prefix
    !layeNam = !viewNam & '/AssemblyAxes'

    -- Test for name existing
    VAR !exists EXIST $!layeNam
    if (!exists.eq('FALSEA')) then

      -- Create layer
      NEW LAYE $!layeNam
      SPPURP AXES
      FUNC 'Assembly Axes'

    endif

  else

    -- Access the first existing layer
    LAYE $!allLaye[1]

    -- Delete any existing axes
    if (!associate) then
      VAR !allAxeSym COLL ALL AXESYM WI ASMBLX NEQ '' FOR CE

    else
      VAR !allAxeSym COLL ALL AXESYM WI ASMBLX EQ '' FOR CE

    endif

    do !axeSym val !allAxeSym
    	
      !!ce = !axeSym.dbref()
      DELETE AXESYM

    enddo

  endif

  -- Create the axes symbol
  NEW AXESYM
    handle any
    endhandle

  -- Associate the axes symbol to the assembly
  if (!associate) then
    ASMBLR $!asmblyRefe
  endif

  -- Switching View Graphics transformation to ASMBLY ORI off until the core code catches up
  --  AXSPRINc $!princAxis
  AXSPRINc OFF

  AXSTYPE $!axesType
  AXSSIZE $!scaleFactor
  XYPO $!xPos $!yPos
  LTERM $!termType
  TSIZE $!termSize
  FONT $!font
  CHEI $!chei
  LVIS $!visible
  NLSTYLE $!lineStyle

  -- Set colours, while testing for device
  TXCOLOUR $!textCol
    handle (61,604)
      -- F&M: Requested colour not found in colour dictionary
      !!assyLog.add('  Could not set the axes text colour ' & !textCol & '. Setting to 10 (White).')
        TXCOLOUR 10
    endhandle

  NLCOLOUR $!lineCol
    handle (61,604)
      -- F&M: Requested colour not found in colour dictionary
      !!assyLog.add('  Could not set the axes line colour ' & !lineCol & '. Setting to 7 (Blue).')
        NLCOLOUR 7
    endhandle


  -- Return to view
  !!ce = !viewRefe

  -- Set warnings on
  WARNINGS ON

endfunction
