--  File:            assyoriview.pmlfnc
--    Type:          Function Definition
--    Group:         Assembly ADP
--      Keyword:     Task
--   Module:        Draft
-- Author:          Steve Wilson
--  Created:         Wed Jan 27 12:19:37 2010
--
-- Description:
-- Modify the VIEW attributes to simulate the assembly orientation transformation
--
--
-- ASSUMPTIONS
-- The current element is the VIEW
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        Empty for future use if necessary
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!assyOriView(!array is ARRAY)

  -- Initialise variables
  !unusedDummyArray = !array

  -- Test for a current view
  VIEW
  	handle(2,111)
  		-- Cannot access element type VIEW from this level
      !!assyLog.add('    Cannot set the view orientation since the view cannot be found. Aborting....')
  		return
  	endhandle

  -- Initialise variables
  !viewRefe   = !!ce
  !asmblyRefe = !!ce.owne.owne.idln
  	
  import 'DraftAssemblyOriAddin'
    handle any
    endhandle

  using namespace 'Aveva.Pdms.Presentation.DraftAssemblyOriAddin'

  !asmblyObj = object DRAFTASSEMBLYORIADDIN(!asmblyRefe.string(),!viewRefe.string())
  !assyDir   = !asmblyObj.isoViewDirection()
  !assyAdeg  = !asmblyObj.isoViewADegress()

  !assyDirNAxis = !assyDir.replace('AXIS ', '')
  DIR $!assyDirNAxis
  ADEG $!assyAdeg

  AUTO
  handle any
  endhandle

  UPDATE DESI
  handle any
  endhandle

endfunction
-- End of function assyOriView(ARRAY)
