--
-- File:            assyproperties.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Build the Assembly Properties Table on the drawing
--
--
-- ASSUMPTIONS
-- The current element is the SHEE
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      ARRAY        [1] SpPurpose of the Label Library containing the symbolic templates
--                            [2] SpPurpose of the Symbolic Template used for the table
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!assyProperties(!arguments is ARRAY)

  -- Initialise variables
  !sheeRefe   = !!ce
  !drwgRefe   = !sheeRefe.owne
  !lalbSpPurp = !arguments[1]
  !sytmSpPurp = !arguments[2]

  -- Get the current coordinate system
  !coordinates = object COORDSTRANSFER()

  WARNINGS OFF

  -- Access last view so that the new one is created below it in the hierarchy
  LAST VIEW
    handle (2,113)
      -- List exhausted
    endhandle

  -- Get the assembly being detailed from the DRWG IDLN
  !asmblyRefe = !drwgRefe.idln

  -- Read backing sheet reserved area to determine table location
  !backSheet = object ASSYBACKSHEET()
  !backSheet.getReserved(!sheeRefe.bsrf)

  -- Build view size and position
  !size     = !backSheet.asmblyXlen & ' ' & !backSheet.asmblyYlen
  !position = 'X ' & !backSheet.asmblyCentre.east & ' Y ' & !backSheet.asmblyCentre.north

  -- Get into position in hierarchy by finding an existing view
  VAR !propertyView COLL ALL VIEW WI SPPURP EQ 'PROPVW' FOR $!sheeRefe
  if (!propertyView.empty()) then

    -- Create the view
    !viewName = !sheeRefe.flnm & '/Properties'
    NEW VIEW $!viewName IDLN =0
      SIZE $!size  XYPO $!position  SPPURP PROPVW

    -- Set the positions format
    if (!coordinates.isXYZ()) then
      POSFORMAT XYZ
    else
      POSFORMAT ENU
    endif

  else

    -- Access the existing view
    !!ce = !propertyView[1].dbref()

  endif
  !viewRefe = !!ce

  -- Get into position in hierarchy by finding an existing layer
  VAR !propertyLaye COLL ALL LAYE WI SPPURP EQ 'ASPROP' FOR $!viewRefe
  if (!propertyLaye.empty()) then

    -- Create the laye
    !layeName = !viewRefe.flnm & '/Laye'
    NEW LAYE $!layeName
    SPPURP ASPROP  PURP ADAP

    -- Set the positions format to allow the symbolic template hash codes to operate on numbers
    POSFORMAT NUMBER

  else

    -- Access the existing laye and delete all existing elements
    !!ce = !propertyLaye[1].dbref()
    DELETE LAYE MEM

  endif
  !layeRefe = !!ce

  -- Get the label library containing the table definition
  VAR !allLalb TSEARCH SPPURPOSE $!lalbSpPurp LALB

  -- Get the symbolic template from the lalb
  VAR !allAssySytm COLL ALL SYTM WI SPPURP EQ '$!sytmSpPurp' FOR $!allLalb[1]

  -- Calculate the table position
  !xyPos = 'X' & !backSheet.asmblyOrigin.east & ' ' & 'Y' & !backSheet.asmblyOrigin.north

  -- Build the table
  -- Table Title
  !tableName = !layeRefe.flnm & '/AssemblyTable'
  NEW SLAB $!tableName  TMRF $!allAssySytm[1]  OSET FALS
    LLEA FALS  FONT TEMP  TXCOLOUR TEMP  LFSTYLE TEMP

    ON $!asmblyRefe  XYPO $!xyPos

  SHEE

endfunction
-- End of function !!assyProperties
