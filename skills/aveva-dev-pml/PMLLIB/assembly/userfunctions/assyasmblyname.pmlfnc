--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Extract data from the model element for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ASSYPART            Object holding one or several "identical" parts
--    2   R      DBREF               Secondary Hierarchy element ASITEM reference
--
------------------------------------------------------------------------
define function !!assyAsmblyName(!assyPart is ASSYPART, !asitem is DBREF) is STRING

  !elemRefe = !assyPart.partRef()
  if (!elemRefe.asmbld) then
    !parent = !elemRefe
    do
      if (!parent.hardtype.eq('WORL')) then
        break
      elseif (!parent.asmown.unset()) then
        !parent = !parent.own
      else
        return !elemRefe.asmown[1].name
      endif
    enddo
  elseif (!elemRefe.hardtype.eq('ASMBLY')) then
    return !elemRefe.own.name
  endif

  return ''

endfunction
-- End of function !!assyAsmblyName
