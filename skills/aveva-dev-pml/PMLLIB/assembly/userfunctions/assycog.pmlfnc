--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Extract data from the model element for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ASSYPART            Object holding one or several "identical" parts
--    2   R      DBREF               Secondary Hierarchy element ASITEM reference
--    3   R      STRING              CoG Component to report
--
------------------------------------------------------------------------
define function !!assyCoG(!assyPart is ASSYPART, !asitem is DBREF, !component is STRING) is STRING

  !elemRefe = !assyPart.partRef()

  -- Initialise variables
  !format    = object FORMAT()
  !format.dimension = 'L'
  if( !!isImperialLength('DIST') ) then
    !format.units = 'INCH'
  else
    !format.units = 'MM'
  endif
  !format.dp = 0

  -- Centre of Gravity
  if (!component.eq('X')) then
    !cog = !elemRefe.gcofg.east
      handle any
        !cog = 0mm
      endhandle

  elseif (!component.eq('Y')) then
    !cog = !elemRefe.gcofg.north
      handle any
        !cog = 0mm
      endhandle

  elseif (!component.eq('Z')) then
    !cog = !elemRefe.gcofg.up
      handle any
        !cog = 0mm
      endhandle

  else
    !cog = 0mm
  endif

  -- Return value
  return !cog.string(!format)

endfunction
-- End of function !!assyCoG
