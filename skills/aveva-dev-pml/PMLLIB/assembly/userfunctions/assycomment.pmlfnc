--
-- File:            assycomment.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Extract data from the model element for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ASSYPART            Object holding one or several "identical" parts
--    2   R      DBREF               Secondary Hierarchy element ASITEM reference
--
------------------------------------------------------------------------
define function !!assyComment(!assyPart is ASSYPART, !asitem is DBREF) is STRING

  !elemRefe = !assyPart.partRef()

  -- Get discipline description from the ZONE
  !discipline = PURP OF ZONE OF $!elemRefe
    handle (2,111)
      -- Cannot access element type ZONE from this level
      !discipline = 'Unknown'
    endhandle

  -- COMMENT
  -- Assemblies
  if  (!elemRefe.hardType.eq('ASMBLY')) then
    !comment = !elemRefe.attribute(':comment')
      handle (2,204) (99,532)
        -- User defined attribute not valid for this element; Undefined UDA or undefined UDET
        !comment = ''
      endhandle

  -- Panels
  elseif (!elemRefe.hardType.eq('PANE')) then
    !comment = !elemRefe.attribute(':comment')
      handle (2,204) (99,532)
        !comment = ''
      endhandle

  -- Gensec
    !comment = !elemRefe.attribute(':comment')
      handle (2,204) (99,532)
        !comment = ''
      endhandle

  -- Hull
  elseif (!elemRefe.hardType.eq('HBRCKT') or !elemRefe.hardType.eq('HDOPLA') or !elemRefe.hardType.eq('HFLANG') or !elemRefe.hardType.eq('HPILLR') or !elemRefe.hardType.eq('HPLATE') or !elemRefe.hardType.eq('HSTIFF')) then
    !comment = !elemRefe.comnt
      handle any
        !comment = ''
      endhandle

  -- Polyhe
  elseif (!elemRefe.hardType.eq('POLYHE')) then
    !comment = !elemRefe.func

  -- Piping components
  elseif (!elemRefe.owne.hardType.eq('BRAN') and !discipline.match('PIPE').neq(0)) then
    if (!elemRefe.spre.badref()) then
      !comment = ''
    else
      !comment = !elemRefe.spre.comment
    endif

  -- HVAC components
  elseif (!elemRefe.owne.hardType.eq('HVAC') and !discipline.match('HVAC').neq(0)) then
    if (!elemRefe.spre.badref()) then
      !comment = ''
    else
      !comment = !elemRefe.spre.comment
    endif

  -- Cable Tray components
  elseif (!elemRefe.owne.hardType.eq('CWAY') and !discipline.match('CABLE').neq(0)) then
    if (!elemRefe.spre.badref()) then
      !comment = ''
    else
      !comment = !elemRefe.spre.comment
    endif

  -- Piping spools
  elseif (!elemRefe.hardType.eq('PSPOOL') and !elemRefe.owne.hardType.eq('PIPE') and !discipline.match('PIPE').neq(0)) then
    !comment = !elemRefe.attribute(':comment')
      handle (2,204) (99,532)
        !comment = ''
      endhandle

  -- HVAC spools
  elseif (!elemRefe.hardType.eq('HSPOOL') and !elemRefe.owne.hardType.eq('HVAC') and !discipline.match('HVAC').neq(0)) then
    !comment = !elemRefe.attribute(':comment')
      handle (2,204) (99,532)
        !comment = ''
      endhandle

  -- Cable Tray
  elseif (!elemRefe.hardType.eq('CWAY')) then
    !comment = !elemRefe.attribute(':comment')
      handle (2,204) (99,532)
        !comment = ''
      endhandle

  -- Equipment
  elseif (!elemRefe.hardType.upCase().eq('EQUI')) then
    !comment = !elemRefe.attribute(':comment')
      handle (2,204) (99,532)
        !comment = ''
      endhandle

  -- SPCO, PART, UDET :NMPART
  -- These can be used to get to non-modelled items
  elseif (!elemRefe.hardType.eq('SPCO') or !elemRefe.hardType.eq('GPART') or !elemRefe.actType.eq(':NMPART')) then
    !comment = !elemRefe.comment

  else
    !comment = !elemRefe.attribute(':comment')
      handle (2,204) (99,532)
        !comment = ''
      endhandle

  endif

  -- Test for blank value
  if (!comment.eq('') or !comment.unset()) then
    !comment = '-'
    !!assyLog.add(|    WARNING: Element | & !elemRefe.flnm & | has an unset comment, using '-'|)
  endif

  -- Return value
  return !comment

endfunction
-- End of function !!assyComment
