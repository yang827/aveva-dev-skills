--
-- Description:
-- Extract data from the model element for the Parts List
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      Date Time Stamp
--
------------------------------------------------------------------------
define function !!assyDateStamp() is STRING

  -- Initialise variables
  !dateTime = object DATETIME()

  -- Build time stamp
  !dateStamp = !dateTime.date() & !dateTime.month() & !dateTime.year().string().substring(3)

  -- Return value
  return !dateStamp

endfunction
-- End of function !!assyDateStamp
