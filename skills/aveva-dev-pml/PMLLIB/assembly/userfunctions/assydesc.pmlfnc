-- File:            assydesc.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Extract data from the model element for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ASSYPART            Object holding one or several "identical" parts
--    2   R      DBREF               Secondary Hierarchy element ASITEM reference
--
------------------------------------------------------------------------
define function !!assyDesc(!assyPart is ASSYPART, !asitem is DBREF) is STRING

  !elemRefe = !assyPart.partRef()

  -- Get discipline description from the ZONE
  !discipline = PURP OF ZONE OF $!elemRefe
    handle (2,111)
      -- Cannot access element type ZONE from this level
      !discipline = 'Unknown'
    endhandle

  -- DESCRIPTION
  -- Assemblies
  if  (!elemRefe.hardType.eq('ASMBLY')) then
    !description = !elemRefe.desc

  -- Panels
  elseif (!elemRefe.hardType.eq('PANE')) then
    !description = !elemRefe.desc

  -- Gensec
  elseif (!elemRefe.hardType.eq('GENSEC')) then
    !description = !elemRefe.desc

  -- Polyhe
  elseif (!elemRefe.hardType.eq('POLYHE')) then
    !description = !elemRefe.desc

  -- Pipes
  elseif (!elemRefe.hardType.eq('PIPE') and !discipline.match('Piping').neq(0)) then
    !description = !elemRefe.desc

  -- Piping components
  elseif (!elemRefe.owne.hardType.eq('BRAN') and !discipline.match('Piping').neq(0)) then

    -- Test for valid detref
    if (!elemRefe.detr.badref().not()) then
      !description = !elemRefe.dtxr.replace('#','##')
    else
      !description = ''
    endif

  -- SPCO
  -- These can be used to get to non-modelled items
  elseif (!elemRefe.hardType.eq('SPCO')) then

    -- Test for valid detref
    if (!elemRefe.detr.badref().not()) then
      !description = !elemRefe.detr.rtex.replace('#','##') & !elemRefe.detr.stex.replace('#','##') & !elemRefe.detr.ttex.replace('#','##')
    else
      !description = ''
    endif

  -- Hull
  elseif (!elemRefe.hardType.eq('HBRCKT') or !elemRefe.hardType.eq('HDOPLA') or !elemRefe.hardType.eq('HFLANG') or !elemRefe.hardType.eq('HPILLR') or !elemRefe.hardType.eq('HPLATE') or !elemRefe.hardType.eq('HSTIFF')) then
    !description = !elemRefe.desc

  -- Equipment
  elseif (!elemRefe.hardType.upCase().eq('EQUI')) then
    !description = !elemRefe.desc

  -- PART
  -- These can be used to get to non-modelled items
  elseif (!elemRefe.hardType.eq('GPART')) then

    -- Test for valid detref
    if (!elemRefe.detr.badref().not()) then
      !description = !elemRefe.detr.rtex.replace('#','##') & !elemRefe.detr.stex.replace('#','##') & !elemRefe.detr.ttex.replace('#','##')
    else
      !description = !elemRefe.desc
    endif

  -- UDET :NMPART
  -- These can be used to get to non-modelled items
  elseif (!elemRefe.actType.eq(':NMPART')) then

    -- Test for valid detref
    if (!elemRefe.detr.badref().not()) then
      !description = !elemRefe.detr.rtex.replace('#','##') & !elemRefe.detr.stex.replace('#','##') & !elemRefe.detr.ttex.replace('#','##')
    else
      !description = !elemRefe.desc
    endif

  -- Piping components
  elseif (!elemRefe.owne.hardType.eq('BRAN') and !discipline.match('PIPE').neq(0)) then
    !description = !elemRefe.dtxr.replace('#','##')
      handle any
        !description = ''
      endhandle

  -- HVAC components
  elseif (!elemRefe.owne.hardType.eq('HVAC') and !discipline.match('HVAC').neq(0)) then
    !description = !elemRefe.dtxr.replace('#','##')
      handle any
        !description = ''
      endhandle

  -- Cable Tray components
  elseif (!elemRefe.owne.hardType.eq('CWAY') and !discipline.match('CABLE').neq(0)) then
    !description = !elemRefe.dtxr.replace('#','##')
      handle any
        !description = ''
      endhandle

  -- Piping spools
  elseif (!elemRefe.hardType.eq('PSPOOL')) then
      !description = !elemRefe.desc
        handle any
          -- Element does not have attribute DESC
          !description = ''
        endhandle

  -- HVAC spool
  elseif (!elemRefe.hardType.eq('HSPOOL')) then
      !description = !elemRefe.desc
        handle any
          -- Element does not have attribute DESC
          !description = ''
        endhandle

  -- Cable Tray
  elseif (!elemRefe.hardType.eq('CWAY')) then
      !description = !elemRefe.desc
        handle any
          -- Element does not have attribute DESC
          !description = ''
        endhandle

  else
    !description = !elemRefe.desc
      handle any
        !description = ''
      endhandle
  endif

  -- Test for unset
  if (!description.eq('')) then
    !description = '-'
    !!assyLog.add(|    WARNING: Element | & !elemRefe.flnm & | has an unset description, using '-'|)
  endif

  -- Return value
  return !description

endfunction
-- End of function !!assyDesc
