--
-- File:            assydoclink.pmlfnc
--   Type:          Function Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2006
--
--
-- Description:
-- Set document links between elements
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       ARRAY of ASMBLY elements
--    2   R      ARRAY       ARRAY of the associated DRWG elements
--    3   R      ARRAY       Drawing Update status
--                            TRUE  - update existing drawing links
--                            FALSE - create non-existing drawing links, recreate existing ones
--    4   R      ARRAY       ARRAY of ARRAYS holding the parts list filenames for each assembly
--    5   R      ARRAY       ARRAY of the associated PDF files
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!assyDocLink(!assemblies is ARRAY, !drawings is ARRAY, !updateStatus is ARRAY, !allPartsLists is ARRAY, !allPdfFiles is ARRAY)

  -- The current element is a link folder
  !linkFoldRefe = !!ce

  -- For each assembly
  do !index ind !assemblies

    -- Initialise variables
    !asmblyRefe = !assemblies[!index]
    !drwgRefe   = !drawings[!index].reference
    !update     = !updateStatus[!index]

    -- Find any existing link descriptor for this assembly
    !linkDesc = !!assyGetDocLink(!asmblyRefe)[2]

    -- Create or modify links depending on the update status of each drawing
    -- When updating a drawing, use any found link folder
    if (!update and !linkDesc.set()) then

      -- Find the existing link folder and add links for any new parts lists
      !!ce = !linkDesc.owne

    else

      -- When no existing link descriptor, create a new folder and link descriptor
      if (!linkDesc.badref()) then

        -- Build link folder name
        !linkFoldName = !asmblyRefe.flnm & '/Links'

        -- Access the top-level link folder
         !!ce = !linkFoldRefe

        -- Create a new link folder to hold the assembly associated drawings
        NEW LNFOLD
         DESC 'Assembly ADP - Drawing Folder'
         FUNC 'ASSEMBLY'

        -- Name the folder if possible
        NAME $!linkFoldName
          handle (41,303)(41,12)
            -- Too many values specified for attribute NAME
            -- Name already used
            -- Unname it as any system truncation may duplicate the name
            UNNAME
          endhandle

        NEW LNDESC
         DESC 'Assembly ADP - Drawing Link'
         FUNC 'ASSEMBLY'

      -- Access the found link descriptor
      else
        !!ce = !linkDesc

      endif

      -- Attempt to add the assembly to the link array, although there should only be a single entry
      -- This would fail with an error when updating an existing link descriptor
      DLADD $!asmblyRefe
        handle (2,856)
          -- Element to be INCLUDED is already owned by the current element
        endhandle

      -- Set the link to the drawing
      LNKREF $!drwgRefe

    endif

    -- Link the assembly to the external pdf files
    -- This should be done on all update types
    if (defined(!allPdfFiles[!index])) then

      -- For each assembly drawing
      do !pdfFileString val !allPdfFiles[!index]

        -- Get the pdf file
        !pdfFile = object FILE(!pdfFileString)

        -- For an existing pdf file
        if (!pdfFile.exists()) then

          -- Build URL string
          !url = 'file:///' & !pdfFileString

          -- Check the link folder for any descriptors linked to the same file
          -- But only if we found a link descriptor related to this assembly
          if (!linkDesc.badref().not()) then
            !linkFold = !linkDesc.owne
            VAR !existingLink COLL ALL LNDESC WITH URL EQ '$!url' FOR $!linkFold
            skip if (!existingLink.set())
          endif

          NEW LNDESC
           DLADD $!asmblyRefe
           DESC 'Assembly ADP - PDF Link'
           FUNC 'ASSEMBLY'
           URL '$!url'

       endif

     enddo

    endif

    -- Link the assembly to the external parts list files
    -- This should be done on all update types
    if (defined(!allPartsLists[!index])) then

      do !fileObj val !allPartsLists[!index]

        -- Build URL string
        !url = 'file:///' & !fileObj.fullname()

        -- Check the link folder for any descriptors linked to the same file
        -- But only if we found a link descriptor related to this assembly
        if (!linkDesc.badref().not()) then
          !linkFold = !linkDesc.owne
          VAR !existingLink COLL ALL LNDESC WITH URL EQ '$!url' FOR $!linkFold
          skip if (!existingLink.set())
        endif

        NEW LNDESC
         DLADD $!asmblyRefe
         DESC 'Assembly ADP - Parts List Link'
         FUNC 'ASSEMBLY'
         URL '$!url'

      enddo

    endif

  enddo

  SAVEWORK

endfunction
-- End of function !!assyDocLink
