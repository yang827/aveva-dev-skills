--
-- File:            assydrwgno.pmlfnc
--   Type:          Function Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2006
--
--
-- Description:
-- Set assembly drawing number
-- Format = <prefix> + separator + <assembly name> + separator + !index + separator + <suffix>
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       [1] STRING Use the Name Sequence database YES or NO
--                           [2] STRING The attribute used to hold the drawing number
--                           [3] STRING Prefix
--                           [4] STRING Suffix
--                           [5] STRING Start number for the index
--                           [6] STRING Separator character
--
-- If you are using a sequence db, argument 5 will not be used as the default start number will be zero.
-- If you are using the db to determine the number, then this argument would be the full index e.g. '0001'.
-- The reasons for the difference is simply to illustrate the ways in which you might extract a drawing number.
--
-- ASSUMPTIONS
-- The DRWG being modified is the current element
------------------------------------------------------------------------
define function !!assyDrwgNo(!arguments is ARRAY)

  -- Initialise variables
  !useNameSeq = !arguments[1].eq('YES')
  !attribute  = !arguments[2]
  !prefix     = !arguments[3]
  !suffix     = !arguments[4]
  !startNumb  = !arguments[5]
  !separator  = !arguments[6]
  !removeLead = false
  !drwgRefe   = !!ce

  -- Get the assembly name from the drawing IDLN
  !asmblyName = !drwgRefe.idln.asname

  -- Import name sequence object
  import 'aveva.pdms.nameseq'
    handle (1000,0)
      -- Already loaded
    endhandle

  using namespace 'aveva.pdms.nameseq'

  -- Define a name sequence object with an identifier for this application
  !nameSeq = object NAMESEQ('ASSEMBLYADP')

  -- Start the sequence, making sure we do not restart it
  if (!nameSeq.getCurrent().lt(!startNumb.real())) then
    !nameSeq.setStart(!startNumb.real())
  endif

  -- Test if a name sequence db is returning a current value or not to be used
  -- If not get the next number by testing for an unused drwg name
  if (!nameSeq.getCurrent().eq(-1) or !useNameSeq.not()) then

    -- Check starting index for leading zeros e.g. '0001'
    if (!startNumb.substring(1,1).eq('0')) then

      -- Add a temporary number to the front
      !numbStrg   = '1' & !startNumb
      !startIndex = !numbStrg.real()
      !removeLead = true

    else
      !startIndex = !startNumb.real()

    endif

    -- Set end index to a fairly large number
    !endIndex   = !startIndex + 99999

    -- Build the drawing number
    do !index from !startIndex to !endIndex

      -- Test for leader number removal
      if (!removeLead) then
        !number = !index.string().substring(2)
      else
        !number = !index
      endif

      -- Build the drawing number
      !drwgNo = !prefix & !separator & !asmblyName & !separator & !number & !separator & !suffix

      -- Test whether the number has been used
      VAR !used COLL ALL DRWG WI MATCHWILD ($!attribute,'*$!number*')
      if (!used.unset()) then
        break
      endif

    enddo

  -- Use the name sequence db for the next number
  else

    -- Get the next sequence number
    !nextNumber = !nameSeq.next().after('ASSEMBLYADP')
    !length     = !nextNumber.string().length()

    -- Test for the length of the required leading zeros to give 0000
    if (!length.eq(1)) then
      !zeros = '000'
    elseif (!length.eq(2)) then
      !zeros = '00'
    elseif (!length.eq(3)) then
      !zeros = '0'
    else
      !zeros = ''
    endif

    -- Build the drawing number
    !drwgNo = !prefix & !separator & !asmblyName & !separator & !zeros & !nextNumber & !separator & !suffix

  endif

  -- Have to re-access the DRWG since the name sequence seems to be changing what the core thinks is the CE
  -- If this is not done then a crash will occur
  !!ce = !drwgRefe

  -- Set the relevant attribute
  $!attribute |$!drwgNo|

endfunction
