--
--
-- Description:
-- The functions below is used by Assembly ADP to determine if an assembly
-- should be expanded to include subparts in partslist files and partslist
-- table in generated drawing
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      DBREF               element
--
------------------------------------------------------------------------
define function !!assyExpandSubParts(!partRef is DBREF) is ARRAY

   !result = ARRAY()

-- If HBRCKT is collected to an assembly, check for subordinate HBRSTI and HBRFLA

   if (!partRef.hardType.upCase().eq('HBRCKT')) then
      VAR !sti COLLECT ALL HBRSTI FOR $!partRef
--    VAR !fla COLLECT ALL HBRFLA FOR $!partRef
   endif

   do !index ind !sti
     !result.append(!sti[!index])
   enddo
-- do !index ind !fla
--   !result.append(!fla[!index])
-- enddo

   return !result

endmethod
-- End of function !!assyExpandSubParts
