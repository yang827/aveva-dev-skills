--
--
-- Description:
-- Extract size from the model element using local volume for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      DBREF        Element reference
--
------------------------------------------------------------------------
define function !!assyLvol(!elemRefe is DBREF) is STRING

  -- Initialise variables
  !format    = object FORMAT()
  !format.dp = 0

  -- Get element local volume
  !lvol = !elemRefe.lvol
    handle any
      !size = 'Unset'
    endhandle

  -- Calculate box sides
  !xLen = !lvol[1] - !lvol[4]
  !yLen = !lvol[2] - !lvol[5]
  !zLen = !lvol[3] - !lvol[6]

  -- Format the values
  !x = object STRING(!xLen.abs(),!format)
  !y = object STRING(!yLen.abs(),!format)
  !z = object STRING(!zLen.abs(),!format)

  -- Build size string
  !size = !x & 'x' & !y & 'x' & !z

  -- Return size
  return !size

endfunction
-- End of function !!assyLvol
