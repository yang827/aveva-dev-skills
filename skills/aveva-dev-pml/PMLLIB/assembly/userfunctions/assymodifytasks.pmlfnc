--
-- File:            assymodifytasks.pmlfnc
--   Type:          Function Definition
--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         21 Sep 2011
--
--
-- Description:
-- Update tasks as necessary
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!assyModifyTasks()

  -- Remember hierarchy location
  !ce = !!ce

  -- Write a header
  WRITE |-----------------------------------------------------------------------------------------------------------------------------------|
  WRITE | Modifying the Assembly Library and any existing Assembly Drawing|
  WRITE |-----------------------------------------------------------------------------------------------------------------------------------|

  -- Set the drawing number task purpose for no update.
  -- To do this we will add the character 'X' to the end of the task sppurpose.
  -- This will then be recognised by the appware and allows the user some rudimentary control
  -- Also set the use of the NSEQ database as the default

  -- Get all drawing number tasks
  VAR !allTasks COLLECT ALL TASK WITH FUNCTION EQ 'Format Drawing Number'

  -- For each drawing number task
  do !task val !allTasks

    -- Initialise variables
    !taskRefe   = !task.dbref()
    !taskName   = !taskRefe.flnn
    !taskSppurp = !taskRefe.sppurp

    -- Get the parameter used to determine index extraction method
    VAR !allTkpara COLLECT ALL TKPARA WITH FUNCTION EQ 'Use the Name Sequence database' FOR $!task
    !tkparaOneRefe    = !allTkpara[1].dbref()
    !tkparaOneName    = !tkparaOneRefe.flnn
    !tkparaOneTpvalue = !tkparaOneRefe.tpvalue

    -- Set the drawing number task to no update
    if (!taskRefe.dbwrite) then

      !!ce = !taskRefe

      SPPURP DTASKX
      WRITE |Modifying TASK $!taskName - Attribute SPPURP from $!taskSppurp to DTASKX|

    endif

    -- Set to use the NSEQ for the drawing index number as the default
    if (!tkparaOneRefe.dbwrite) then

      !tkparaOneRefe.attribute('TPValue') = 'YES'
      WRITE |Modifying $!tkparaOneName - Attribute TPValue from '$!tkparaOneTpvalue' to 'YES'|

    endif

    -- Add separator for easy reading
    if (!taskRefe.dbwrite or !tkparaOneRefe.dbwrite) then
      WRITE |-----------------------------------------------------------------------------------------------------------------------------------|
    endif

  enddo

  -- Set the assembly orientation workaround tasks for no update
  -- Get all assembly orientation and axes tasks
  VAR !allTasks COLLECT ALL TASK WITH FUNCTION EQ 'Orientate View to Assembly'
  VAR !allTasks APPEND COLLECT ALL TASK WITH FUNCTION EQ 'Create Local Axes'
  VAR !allTasks APPEND COLLECT ALL TASK WITH FUNCTION EQ 'Create World Axes'

  -- For each view task
  do !task val !allTasks

    -- Initialise variables
    !taskRefe   = !task.dbref()
    !taskName   = !taskRefe.flnn
    !taskSppurp = !taskRefe.sppurp

    -- Set the drawing number task to no update
    if (!taskRefe.dbwrite) then

      !!ce = !taskRefe

      SPPURP VTASKX
      WRITE |Modifying TASK $!taskName - Attribute SPPURP from $!taskSppurp to VTASKX|
      WRITE |-----------------------------------------------------------------------------------------------------------------------------------|

    endif

  enddo

  -- Return to original hierarchy location
  !!ce = !ce

endfunction
-- End of function !!assyModifyTasks
