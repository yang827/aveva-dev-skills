--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Extract data from the model element for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ASSYPART            Object holding one or several "identical" parts
--    2   R      DBREF               Secondary Hierarchy element ASITEM reference
--
------------------------------------------------------------------------
define function !!assyMq(!assyPart is ASSYPART, !asitem is DBREF) is STRING

  !elemRefe = !assyPart.partRef()

  -- Material Quality
  !mq = !elemRefe.attribute('quaTxt')
    handle (2,805)(2,201)
      -- Is not a valid attribute name
      !mq = '-'
      !!assyLog.add(|    WARNING: Element | & !elemRefe.flnm & | has an unset MQ, using '-'|)
    endhandle

  -- Test for unset
  if (!mq.unset()) then
    !mq = '-'
  endif

  -- Return value
  return !mq

endfunction
-- End of function !!assyMq
