-- File:            assyname.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Extract data from the model element for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ASSYPART            Object holding one or several "identical" parts
--    2   R      DBREF               Secondary Hierarchy element ASITEM reference
--
------------------------------------------------------------------------
define function !!assyName(!assyPart is ASSYPART, !asitem is DBREF) is STRING

  !commonName = ''
  !identicalNames = true
  do !index ind !assyPart.partRefs
    !elemRefe = !assyPart.partRefs[!index]

    -- Assembly
    if  (!elemRefe.hardType.eq('ASMBLY')) then
      !nameString = !elemRefe.asName
    -- All others
    else
      -- Try for hull part name
      !nameString = !elemRefe.parnam
        handle (2,201)
          -- Element does not have attribute PARNAM
          -- Use the name attribute
          if (!elemRefe.hardType.eq('GPART')) then
            !nameString = !elemRefe.flnn.after(':')
          else
            !nameString = !elemRefe.flnn
          endif
        endhandle
      if (!nameString.unset()) then
        !nameString = !elemRefe.flnn
      endif
    endif

    if (!commonName.eq('')) then
      !commonName = !nameString
    else
      !commonLen = !commonName.length()
      !minLen = MIN(!commonLen,!nameString.length())
      do !count from 1 to !minLen
        !str1 = SUBS(!commonName, 1,!count)
        !str2 = SUBS(!nameString, 1, !count)
        if (!str1.neq(!str2)) then
          !identicalNames = false
          !commonName = SUBS(!commonName, 1,!count - 1)
          break
        endif
      enddo
    endif
  enddo

  -- Return value
  if (not !identicalNames) then
    !commonName = !commonName + '*'
  endif
  return !commonName

endfunction
-- End of function !!assyName
