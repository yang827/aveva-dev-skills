--   Group:         Assembly
--     Keyword:     Drawing
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         25 Jan 2006
--
--
-- Description:
-- Set assembly drawing name
-- Format = "/" + <assembly name> + "/" + <system defaults rule> + !index
--
-- ASSUMPTIONS
-- The current element is the DRWG being named
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The drawing
--    1    R     STRING      The naming rule from the system defaults
--
-- Return:
--   [Data Type] [Description]
--    STRING      Root name
--
------------------------------------------------------------------------
define function !!assyNameDrwg(!drwgRefe is DBREF, !nameRule is STRING) is STRING

  -- Initialise variables
  !asmblyName = !drwgRefe.idln.name

  -- Test for a leading forward slash character
  if (!asmblyName.substring(1,1).neq('/')) then
    !asmblyName = '/' & !asmblyName
  endif

  -- Build the drawing number
  do !index from 0 to 9999

    -- Build the drawing name
    if (!index.eq(0)) then
      !drwgName  = !asmblyName & '/' & !nameRule
      !startname = !drwgName
    else
      !drwgName = !asmblyName & '/' & !nameRule & !index
    endif

    -- Test whether the name has been used
    VAR !exists EXISTS $!drwgName
    if (!exists.eq('FALSEA')) then
      break
    endif

  enddo

  -- Set the relevant attribute
  NAME $!drwgName

  -- If the starting name is not the same as the actual name
  -- then warn the user that a drawing already exists for this assembly and that another has been created.
  -- This should not happen as it is checked before processing, but in case of a bad drawing...
  if (!drwgName.neq(!startname)) then
    !!assyLog.add(' WARNING: A drawing ' & !startname & ' already exists for the ASMBLY ' & !asmblyName)
  endif

  -- Return rootname
  return !drwgName

endfunction
