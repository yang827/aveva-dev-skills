-- Created:         12 October 2006
--
--
-- Description:
-- Extract size from the model element using parameters for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      DBREF        Element reference
--
------------------------------------------------------------------------
define function !!assyParam(!elemRefe is DBREF) is STRING

  -- Initialise variables
  !format    = object FORMAT()
  !format.dp = 0
  !size      = ''

  -- Test for no catalogue reference
  if (!elemRefe.spre.badref()) then
    !size = ''
    !!assyLog.add('    WARNING: Element ' & !elemRefe.flnm & ' has an unset SPRE')
  else

    -- Get parameters
    do !index ind !elemRefe.param

      if (!index.eq(1)) then
        !size = !elemRefe.param[!index].string()
      else
        !size = !size & 'x' & !elemRefe.param[!index]
      endif

    enddo

    -- Add total length
    !size = !size & ' L=' & !elemRefe.totLen.nint()

  endif

  -- Return size
  return !size

endfunction
-- End of function !!assyParam
