------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      DBREF               element
--
------------------------------------------------------------------------
define function !!assyPartCompareAttsForAccumulation(!elemRefe is DBREF, !posNo is REAL, !type is STRING, !asm is STRING, !wei is REAL) is BOOLEAN

  if (!elemRefe.owne.hardtype.neq('HPANEL')) then
    return false
  endif

  !posNo = !elemRefe.posNo
  handle any
    return false
  endhandle

  !type = !elemRefe.hardtype
  handle any
    return false
  endhandle

  !asm = !elemRefe.asmown[1].name
  handle any
    return false
  endhandle

  !wei = !elemRefe.nwei
  handle any
    return false
  endhandle

  return true

endmethod
-- End of function !!assyPartCompareAttsForAccumulation
