-- File:            assypartsidenticalforaccumulation.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- The functions below constitutes the set of functions that Assembly ADP use
-- to determine if a part can be considered for accumulation of identical parts,
-- used by parts list generation.
--   assyPartValidForAccumulation:
--     Determine if a an element at all should be considered for comparison.
--   assyPartsIdenticalForAccumulation
--     Compare to parts to determine if identical.
--   assyPartCompareAttsForAccumulation
--     This is the function that actually do the job for assyPartValidForAccumulation
--     above, but here the actual element types and attributes are specified.
--
--   This separation into three functions is made in a way that you should be able to
--   make customization without having to change elsewhere in Assembly ADP. I.e.
--   1. Change assyPartCompareAttsForAccumulation as you like
--   2. Adjust assyPartValidForAccumulation and assyPartsIdenticalForAccumulation accordingly
--      The assyPartCompareAttsForAccumulation function is not used elsewhere.
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      DBREF               element
--    2   R      DBREF               element
--
------------------------------------------------------------------------
define function !!assyPartsIdenticalForAccumulation(!elemRefe1 is DBREF, !elemRefe2 is DBREF) is BOOLEAN

  !posNo1 = 0
  !posNo2 = 0
  !type1 = ''
  !type2 = ''
  !asm1 = ''
  !asm2 = ''
  !wei1 = 0
  !wei2 = 0

  !valid1 = !!assyPartCompareAttsForAccumulation(!elemRefe1, !posNo1, !type1, !asm1, !wei1)
  !valid2 = !!assyPartCompareAttsForAccumulation(!elemRefe2, !posNo2, !type2, !asm2, !wei2)

  !diff = !wei1 - !wei2

  return ((!valid1) and (!valid2) and (!diff.abs() lt 0.05) and (!posNo1.eq(!posNo2)) and (!type1.eq(!type2)) and (!asm1.eq(!asm2)))
endmethod
-- End of function !!assyPartsIdenticalForAccumulation
