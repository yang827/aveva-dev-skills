define function !!assyPartValidForAccumulation(!elemRefe is DBREF) is BOOLEAN

  !posNo = 0
  !type = ''
  !asm = ''
  !wei = 0

  return (!!assyPartCompareAttsForAccumulation(!elemRefe, !posNo, !type, !asm, !wei))

endmethod
-- End of function !!assyPartValidForAccumulation
