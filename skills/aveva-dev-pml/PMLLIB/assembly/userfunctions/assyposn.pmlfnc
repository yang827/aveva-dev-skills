--
-- File:            assyposn.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Extract data from the model element for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ASSYPART            Object holding one or several "identical" parts
--    2   R      DBREF               Secondary Hierarchy element ASITEM reference
--
-- Return:
--   [Data Type] [Description]
--    STRING      The position number
--
------------------------------------------------------------------------
define function !!assyPosN(!assyPart is ASSYPART, !asitem is DBREF) is STRING

  !elemRefe = !assyPart.partRef()

  -- Initialise variables
  !unusedDummyDbref = !asitem

  -- Get discipline description from the ZONE
  !discipline = PURP OF ZONE OF $!elemRefe
    handle (2,111)
      -- Cannot access element type ZONE from this level
      !discipline = 'Unknown'
    endhandle

  -- POSITION NUMBER
  -- Assemblies
  if  (!elemRefe.hardType.eq('ASMBLY')) then
    !posN = 0

  -- Panels
  elseif (!elemRefe.hardType.eq('PANE')) then
    !posN = !elemRefe.attribute(':posNumber')
      handle (2,204) (99,532)
        -- User defined attribute not valid for this element
        -- Undefined UDA or undefined UDET
        !posN = 0
      endhandle

  -- Gensec
  elseif (!elemRefe.hardType.eq('GENSEC')) then
    !posN = !elemRefe.attribute(':posNumber')
      handle (2,204) (99,532)
        !posN = 0
      endhandle

  -- Polyhe
  elseif (!elemRefe.hardType.eq('POLYHE')) then
    !posN = 0

  -- Hull
  elseif (!elemRefe.hardType.eq('HBRCKT') or !elemRefe.hardType.eq('HDOPLA') or !elemRefe.hardType.eq('HFLANG') or !elemRefe.hardType.eq('HPILLR') or !elemRefe.hardType.eq('HPLATE') or !elemRefe.hardType.eq('HSTIFF')) then
    !posN = !elemRefe.posNo
      handle any
        !posN = 0
      endhandle

  -- Equipment
  elseif (!elemRefe.hardType.eq('EQUI')) then
    !posN = !elemRefe.number

  -- Piping components
  elseif (!elemRefe.owne.hardType.eq('BRAN') and !discipline.match('PIPE').neq(0)) then
    !posN = !elemRefe.ptno
      handle any
        !posN = 0
      endhandle

  -- HVAC components
  elseif (!elemRefe.owne.hardType.eq('HVAC') and !discipline.match('HVAC').neq(0)) then
    !posN = !elemRefe.ptno
      handle any
        !posN = 0
      endhandle

  -- Cable Tray components
  elseif (!elemRefe.owne.hardType.eq('CWAY') and !discipline.match('CABLE').neq(0)) then
    !posN = !elemRefe.ptno
      handle any
        !posN = 0
      endhandle

  -- SPCO, PART, UDET :NMPART
  -- These can be used to get to non-modelled items
  elseif (!elemRefe.hardType.eq('SPCO') or !elemRefe.hardType.eq('GPART') or !elemRefe.actType.eq(':NMPART')) then
    !posN = 0

  -- Piping spools
  elseif (!elemRefe.hardType.eq('PSPOOL')) then
    !posN = !elemRefe.seq

  -- HVAC spools
  elseif (!elemRefe.hardType.eq('HSPOOL')) then
    !posN = !elemRefe.seq

  -- Cable Tray
  elseif (!elemRefe.hardType.eq('CWAY')) then
    !posN = !elemRefe.seq

  else
    !posN = !elemRefe.attribute('posNo')
      handle any
        !posN = 0
      endhandle

  endif

  -- Return value
  if (!posN.eq(0)) then
     return '-'
  endif
  return !posN.string()

endfunction
-- End of function !!assyPosN
