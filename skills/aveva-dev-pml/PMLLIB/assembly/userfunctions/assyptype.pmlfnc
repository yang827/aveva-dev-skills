-- File:            assyptype.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Extract data from the model element for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ASSYPART            Object holding one or several "identical" parts
--    2   R      DBREF               Secondary Hierarchy element ASITEM reference
--
------------------------------------------------------------------------
define function !!assyPtype(!assyPart is ASSYPART, !asitem is DBREF) is STRING

  !elemRefe = !assyPart.partRef()

  -- Get discipline description from the ZONE
  !discipline = PURP OF ZONE OF $!elemRefe
    handle (2,111)
      -- Cannot access element type ZONE from this level
      !discipline = 'Unknown'
    endhandle

  -- Ptype
  -- Assembly
  if (!elemRefe.hardType.upCase().eq('ASMBLY')) then
    !pType = 'Assembly'

  -- Outfit Panel
  elseif (!elemRefe.hardType.upCase().eq('PANE')) then
    !pType = 'Panel'

  -- Outfit General Section
  elseif (!elemRefe.hardType.upCase().eq('GENSEC')) then
    !pType = 'Structure'

  -- Outfit Section
  elseif (!elemRefe.hardType.upCase().eq('SCTN')) then
    !pType = !elemRefe.gtyp

  -- Outfit Fixing
  elseif (!elemRefe.hardType.upCase().eq('FIXING')) then
    !pType = 'Ancillary'

  -- Outfit Polyhedron
  elseif (!elemRefe.hardType.upCase().eq('POLYHE')) then
    !pType = !elemRefe.func

  -- Hull Bracket
  elseif (!elemRefe.hardType.eq('HBRCKT')) then
    !pType = 'Bracket'

  -- Hull Bracket Stiffener
  elseif (!elemRefe.hardType.eq('HBRSTI')) then
    !pType = 'Bracket Stiffener'

  -- Hull Bracket Flange
  elseif (!elemRefe.hardType.eq('HBRFLA')) then
    !pType = 'Bracket Flange'

  -- Hull Doubling Plate
  elseif (!elemRefe.hardType.eq('HDOPLA')) then
    !pType = 'Doubling Plate'

  -- Hull Flange
  elseif (!elemRefe.hardType.eq('HFLANG')) then
    !pType = 'Flange'

  -- Hull Pillar
  elseif (!elemRefe.hardType.eq('HPILLR')) then
    !pType = 'Pillar'

  -- Hull Plate
  elseif (!elemRefe.hardType.eq('HPLATE')) then
    !pType = 'Plate'

  -- Hull Stiffener
  elseif (!elemRefe.hardType.eq('HSTIFF')) then
    !pType = 'Stiffener'

  -- Hull Clip
  elseif (!elemRefe.hardType.eq('HCLIP')) then
    !pType = 'Clip'

  -- Pipe
  elseif (!elemRefe.hardType.eq('PIPE') and !discipline.match('PIPE').neq(0)) then
    !pType = 'Pipe'

  -- HVAC
  elseif (!elemRefe.hardType.eq('HVAC') and !discipline.match('HVAC').neq(0)) then
    !pType = 'Hvac'

  -- Cable Tray
  elseif (!elemRefe.hardType.eq('CWAY') and !discipline.match('CABLE').neq(0)) then
    !pType = 'Cable Tray'

  -- Piping components
  elseif (!elemRefe.owne.hardType.eq('BRAN') and !discipline.match('PIPE').neq(0)) then
    !pType = !elemRefe.type

  -- HVAC components
  elseif (!elemRefe.owne.hardType.eq('HVAC') and !discipline.match('HVAC').neq(0)) then
    !pType = !elemRefe.type

  -- Cable Tray components
  elseif (!elemRefe.owne.hardType.eq('CWAY') and !discipline.match('CABLE').neq(0)) then
    !pType = !elemRefe.type

  -- Pipe Spool
  elseif (!elemRefe.hardType.upCase().eq('PSPOOL')) then
    !pType = 'Pipe Spool'

  -- HVAC Spool
  elseif (!elemRefe.hardType.upCase().eq('HSPOOL')) then
    !pType = 'Hvac Spool'

  -- Equipment
  elseif (!elemRefe.hardType.upCase().eq('EQUI')) then
    !pType = 'Equipment'

  -- Non-modelled parts using the PART element
  elseif (!elemRefe.hardType.upCase().eq('GPART')) then
    !pType = 'Loose'

  -- Non-modelled parts using the SPCO element or UDET :NMPART
  elseif (!elemRefe.hardType.upCase().eq('SPCO') or !elemRefe.actType.eq(':NMPART')) then
    !pType = 'Loose'

  else

    -- Look for the function attribute
    !pType = !elemRefe.function
      handle (2,201)
        -- Element does not have attribute function
        !pType = '-'
        !!assyLog.add(|    WARNING: Element | & !elemRefe.flnm & | has an unset pType, using '-'|)
      endhandle

  endif

  -- Return value
  return !pType

endfunction
-- End of function !!assyPtype
