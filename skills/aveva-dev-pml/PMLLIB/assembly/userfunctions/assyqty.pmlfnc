--
-- File:            assyqty.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Extract data from the model element for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ASSYPART            Object holding one or several "identical" parts
--    2   R      DBREF               Secondary Hierarchy element ASITEM reference
--
------------------------------------------------------------------------
define function !!assyQty(!assyPart is ASSYPART, !asitem is DBREF) is STRING

  !elemRefe = !assyPart.partRef()

  -- Set output accuracy
  !format    = object FORMAT()
  !format.dp = 0

  -- Get discipline description from the ZONE
  !discipline = PURP OF ZONE OF $!elemRefe
    handle (2,111)
      -- Cannot access element type ZONE from this level
      !discipline = 'Unknown'
    endhandle

  -- QUANTITY
  -- Assemblies
  if  (!elemRefe.hardType.eq('ASMBLY')) then
    !quantity = '1'

  -- Panels
  elseif (!elemRefe.hardType.eq('PANE')) then

    -- Get ploo height
    !ploo   = PLOO 1 OF $!elemRefe
    !height = !ploo.height

    !quantity = !elemRefe.psize[1].string(!format) & ' x ' & !elemRefe.psize[2].string(!format) & ' x ' & !height.string(!format)

  -- Gensec
  elseif (!elemRefe.hardType.eq('GENSEC')) then
    !quantity = !elemRefe.length.int().string()

  -- Polyhe
  elseif (!elemRefe.hardType.eq('POLYHE')) then

    -- Get the size using the local volume
    !quantity = !!assyLvol(!elemRefe)

  -- Hull Bracket
  elseif (!elemRefe.hardType.eq('HBRCKT')) then

    -- Get the size using the local volume
    !quantity = !!assyLvol(!elemRefe)

  -- Hull Doubling Plate
  elseif (!elemRefe.hardType.eq('HDOPLA')) then

    -- Get the size using the local volume
    !quantity = !!assyLvol(!elemRefe)

  -- Hull Flange
  elseif (!elemRefe.hardType.eq('HFLANG')) then

    -- Get the size from the parameters
    !quantity = !!assyParam(!elemRefe)

  -- Hull Pillar
  elseif (!elemRefe.hardType.eq('HPILLR')) then

    -- Get the size from the parameters
    !quantity = !!assyParam(!elemRefe)

  -- Hull Plate
  elseif (!elemRefe.hardType.eq('HPLATE')) then

    -- Get the size using the local volume
    !quantity = !!assyLvol(!elemRefe)

  -- Hull Stiffener
  elseif (!elemRefe.hardType.eq('HSTIFF')) then

    -- Get the size from the parameters
    !quantity = !!assyParam(!elemRefe)

  -- Pipe
  elseif (!elemRefe.hardType.eq('PIPE') and !discipline.match('PIPE').neq(0)) then
    !quantity = '1'

  -- HVAC
  elseif (!elemRefe.hardType.eq('HVAC') and !discipline.match('HVAC').neq(0)) then
    !quantity = '1'

  -- Cable Tray
  elseif (!elemRefe.hardType.eq('CWAY') and !discipline.match('CABLE').neq(0)) then
    !quantity = '1'

  -- Piping components
  elseif (!elemRefe.owne.hardType.eq('BRAN') and !discipline.match('Piping').neq(0)) then
    !quantity = '1'

  -- Piping spools
  elseif (!elemRefe.hardType.eq('PSPOOL')) then
    !quantity = '1'

  -- HVAC spools
  elseif (!elemRefe.hardType.eq('HSPOOL')) then
    !quantity = '1'

  -- Cable Tray
  elseif (!elemRefe.hardType.eq('CWAY')) then
    !quantity = '1'

  -- PART
  -- These can be used to get to non-modelled items
  elseif (!elemRefe.type.eq('GPART')) then

    -- Initialise variables
    !gType = ''

    -- Get to gtyp from the catref
    if (!elemRefe.catr.badref().not()) then
      !gType = !elemRefe.catr.gType
    endif

    -- Old Bolting
    if (!gType.eq('BOLT') or !gType.eq('')) then

      -- Test for valid bolt reference
      if (!elemRefe.bltr.badref().not()) then

        -- Get quantity at asitem
        if (!asitem.asiqua.eq(0)) then
          !noff     = !elemRefe.bltr.noff
        else
          !noff     = !elemRefe.bltr.noff * !asitem.asiqua
        endif

        !quantity = !noff & ' off x ' & !elemRefe.bltr.bdia.real().int() & ' dia x ' & !elemRefe.bltr.length.int() & ' long'

      else
        !quantity = ''
      endif

    -- Everything else
    else

      -- Look for the quantity held at the asitem
      if (!asitem.asiqua.eq(0)) then
        !quantity = '1'
      else
        !quantity = !asitem.asiqua.string()
          handle any
            !quantity = ''
          endhandle
      endif

    endif

  -- SPCO
  -- These are used to get to non-modelled items
  elseif (!elemRefe.type.eq('SPCO')) then

    -- Initialise variables
    !testRefe = !elemRefe
    !gType    = ''

    -- Get to gtyp, last SELE in the hierarchy before the SPEC
    do from 1 to 20

      -- Test for when we reach the last level in the hierarchy before the specification
      -- Which means we will be at the Type question
      if (!testRefe.owne.type.eq('SPEC')) then
        !gType = !testRefe.tans
        break
      else
        !testRefe = !testRefe.owne
      endif

    enddo

    -- Old Bolting
    if (!gType.eq('BOLT')) then

      -- Test for valid bolt reference
      if (!elemRefe.bltr.badref().not()) then

        -- Get quantity at asitem
        if (!asitem.asiqua.eq(0)) then
          !noff     = !elemRefe.bltr.noff
        else
          !noff     = !elemRefe.bltr.noff * !asitem.asiqua
        endif

        !quantity = !noff & ' off x ' & !elemRefe.bltr.bdia.real().int() & ' dia x ' & !elemRefe.bltr.length.int() & ' long'

      else
        !quantity = ''
      endif

    -- Everything else
    else

      -- Look for the quantity held at the asitem
      if (!asitem.asiqua.eq(0)) then
        !quantity = '1'
      else
        !quantity = !asitem.asiqua.string()
          handle any
            !quantity = ''
          endhandle
      endif

    endif

  else
    !quantity = '1'

  endif

  -- Test for unset quantity
  if (!quantity.eq('')) then
    !quantity = '-'
    !!assyLog.add(|    WARNING: Element | & !elemRefe.flnm & | has an unset quantity, using '-'|)
  endif

  -- Return value
  return !quantity

endfunction
-- End of function !!assyQty
