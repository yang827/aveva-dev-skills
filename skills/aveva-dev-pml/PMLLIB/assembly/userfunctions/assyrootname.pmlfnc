-- Created:         25 Jan 2006
--
--
-- Description:
-- Construct the root name of an assembly for use when creating file names
--
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      Element
--
-- Return:
--   [Data Type] [Description]
--    STRING      The rootname to be used when setting file names
--
------------------------------------------------------------------------
define function !!assyRootName(!asmblyRefe is DBREF) is STRING

  -- Initialise variables
  !asmblyName = !asmblyRefe.name

  -- Build date stamp
  !dateStamp = !!assyDateStamp()

  -- Get root name
  if (!asmblyName.substring(1,1).eq('/')) then
    !rootName = !asmblyName.substring(2)
  else
    !rootName = !asmblyName
  endif

  -- Construct root name by replacing the ' ', '\', ',' and '.' with dash, and adding the datestamp
  !rootName = !rootName.replace(' ','-').replace('\','-').replace('/','-').replace('.','-') & '_' & !dateStamp

  -- Return the file name
  return !rootName

endfunction
-- End of function !!assyRootName
