-- File:            assyweight.pmlfnc
--   Type:          Function Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Steve Wilson
-- Created:         12 October 2006
--
--
-- Description:
-- Extract data from the model element for the Parts List
------------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ASSYPART            Object holding one or several "identical" parts
--    2   R      DBREF               Secondary Hierarchy element ASITEM reference
--
------------------------------------------------------------------------
define function !!assyWeight(!assyPart is ASSYPART, !asitem is DBREF) is STRING

  !totalWeight = 0
  do !index ind !assyPart.partRefs
    !elemRefe = !assyPart.partRefs[!index]

    -- Get discipline description from the ZONE
    !discipline = PURP OF ZONE OF $!elemRefe
      handle (2,111)
        -- Cannot access element type ZONE from this level
        !discipline = 'Unknown'
      endhandle

    -- ASMBLY
    if (!elemRefe.hardType.eq('ASMBLY')) then
      !weight =!elemRefe.nweight

    -- HBRCKT
    elseif (!elemRefe.hardType.eq('HBRCKT')) then
      !weight = !elemRefe.nweight
      !subPartRefs = !!assyExpandSubParts(!elemRefe)
      do !subIndex ind !subPartRefs
        !subPartRef = !subPartRefs[!subIndex].dbref()
        !weight = !weight - !subPartRef.nweight
      enddo
        handle any
          !weight = 0
        endhandle

    -- EQUI
    elseif (!elemRefe.hardType.eq('EQUI')) then
      !weight = !elemRefe.nweight
        handle any

          -- Try the user weight
          !userWeight = !elemRefe.usrweight

          if (!userWeight.unset()) then
            !weight = 0
          else
            !weight = !userWeight[1]
          endif

        endhandle

    -- SPCO, PART
    -- These can be used to get to non-modelled items
    elseif (!elemRefe.hardType.eq('SPCO') or !elemRefe.type.eq('GPART')) then

      -- Test for valid property
      if (!elemRefe.cmpr.badref().not()) then

        -- Get property
        !property   = !elemRefe.cmpr

        -- Test for property type
        -- Component
        if(!property.type.eq('CMPD')) then
          !weight = !elemRefe.cmpre.cwei

        -- Tube
        else
          !weight = !elemRefe.cmpre.uwei * !elemRefe.number
        endif

      else
        !weight = 0
      endif

    -- Piping spools
    elseif (!elemRefe.hardType.eq('PSPOOL')) then
      !weight = !elemRefe.brwei
        handle any
          !weight = !!assyPspoolWeight(!elemRefe)
        endhandle

    -- HVAC spools
    elseif (!elemRefe.hardType.eq('HSPOOL')) then
      !weight = !elemRefe.brwei
        handle any
          !weight = !!assyHspoolWeight(!elemRefe)
        endhandle

    -- All other element types
    else
      !weight = !elemRefe.nwei
        handle any
          !weight = 0
        endhandle

    endif

    -- Give a warning message
    if (!weight.eq(0)) then
      !!assyLog.add(|    WARNING: Element | & !elemRefe.flnm & | has an zero weight|)
    endif
    !totalWeight = !totalWeight + !weight
  enddo

  -- Return value without label for backwards compatibility
  if( defined(!!massFmt) ) then
    !format    = !!massFmt
  else
    -- Set output accuracy
    !format    = object FORMAT()
    !format.dp = 2
    !format.dimension = 'MASS'
  endif
  !format.label = ''
  return !totalWeight.string(!format)

endfunction
-- End of function !!assyWeight
