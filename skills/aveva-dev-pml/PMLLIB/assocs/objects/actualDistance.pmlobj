--
-- Description:
--   Object used to verify that 2 objects are >, < or = to a distance supplied
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  TestEv()                         BOOLEAN             Make sure that at least one ASSMBR exists and AMEMRF is set
--  actualDistance()                 -                   Constructor method
--
------------------------------------------------------------------------

define object actualDistance

 -- MEMBER names are compulsory to tie in with ASSOCIATIONS
 -- COMPONENT = RESTRICTION element
   member .ASSOCIATION is DBREF
   member .COMPONENT is DBREF

   member .actDistMem1 is DBREF
   member .actDistMem2 is DBREF
   member .mbrActDistMem1 is DBREF
   member .mbrActDistMem2 is DBREF

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      actualDistance
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .actualDistance()

-- Constructor not used at present

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      TestEv
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .TestEv() is BOOLEAN

!checkPos = !this.mbrActDistMem1.posev.east
if (!checkPos.unset()) then
  return FALSE
endif
!checkPos = !this.mbrActDistMem2.posev.east
if (!checkPos.unset()) then
  return FALSE
endif

var !d const dist $!this.mbrActDistMem1.posev to $!this.mbrActDistMem2.posev
!dist = int(!d.real())
!checkDist = !this.association.ldpr.dist

if (!dist eq !checkdist ) then
  return TRUE
else
  return FALSE
endif

endmethod
-- End of method
