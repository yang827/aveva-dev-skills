 AMEMRF $!dbref1
 if (!taref1.set()) then
   TARF $!taref1
 endif
 $!synt1
 NEW ASSMBR
 LNAME /av-coincident-ref2
 AMEMRF $!dbref2
 if (!taref2.set()) then
   TARF $!taref2
 endif
 $!synt2
 !!ce = !ce
 return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      pointInProfile
--
-- Description: Action to create standard AVEVA association to point is within the bounds of a profile
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointInProfile(!assoRef is dbref, !taref1 is dbref, !dbref1 is dbref, !syntax2 is STRING, !taref2 is dbref, !dbref2 is dbref ) is BOOLEAN

-- Check the assoRef exists and is a ASSOGP
 !check = !this.checkaAssoGpExists(!assoRef)
 if (!check.not()) then
   return FALSE
 endif

 -- Check the definition exists
 !assdefExists = !this.testAvevaAssdef('/av-pt-in-prfl')
 if (!assDefExists.not()) then
   !this.error.append('Aveva association definition does not exist')
   return FALSE
 endif

 -- check that the arguments are OK
 !testRefs = !this.checkRefs(!taref1,!taref2,!dbref1,!dbref2)
 if (!testRefs.not()) then
   !this.error.append('The method called contained invalid references')
   return FALSE
 endif

  -- if the target references are set make sure they are owned by the relevant dbref
 if (!taref1.set()) then
   !check = !this.checkDbrefOwnsTarf(!taref1,!dbref1)
   if (!check.not()) then
     return FALSE
   endif
   -- Check that the tarf is a valid profile
   !testP = object profile(!taref1)
   handle (2,839) $* cant make a profile of the object
     !this.error.append('The target reference is not a valid profile')
     return FALSE
   endhandle
 else
   !testP = object profile(!dbref1)
   handle (2,839) $* cant make a profile of the object
     !this.error.append('The member reference is not a valid profile')
     return FALSE
   endhandle
 endif

 if (!taref2.set()) then
 !check = !this.checkDbrefOwnsTarf(!taref2,!dbref2)
   if (!check.not()) then
     return FALSE
   endif
 endif

 !syntax = !syntax2
 !check=!this.checkSyntax(!syntax,!taref2,!dbref2)
 if (!check.not()) then
   return FALSE
 endif
 !synt2 = !syntax

 -- navigate to the required db location
 !ce = !!ce
 !!ce = !assoRef
 NEW ASSOC
 handle any
   !this.error.append(!!error.text)
   !!ce = !ce
   return FALSE
 endhandle
 ADEFRF /av-pt-in-prfl

 NEW RESTRI
 -- Set association definition reference

 LNAME /av-pt-in-prfl-rd1
 NEW MBRMAP
 LNAME /av-pt-in-prfl-mem1
 AMAPNME /av-pt-in-prfl-ref1
 NEW MBRMAP
 LNAME /av-pt-in-prfl-mem2
 AMAPNME /av-pt-in-prfl-ref2
 NEW ASSMBR
 DESC 'Profile'
 LNAME /av-pt-in-prfl-ref1
 AMEMRF $!dbref1
 if (!taref1.set()) then
   TARF $!taref1
 endif
 NEW ASSMBR
 DESC 'Point'
 LNAME /av-pt-in-prfl-ref2
 AMEMRF $!dbref2
 if (!taref2.set()) then
   TARF $!taref2
 endif
 $!synt2
 !!ce = !ce
 return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Action to create standard AVEVA association to check that 2 points are in the same, opposite or normal direction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction(!option is STRING, !assoRef is dbref, !syntax1 is STRING, !taref1 is dbref, !dbref1 is dbref, !syntax2 is STRING, !taref2 is dbref, !dbref2 is dbref ) is BOOLEAN

-- Check option
if (!option.upcase() eq 'SAME') then
  !part1 = 'same'
elseif (!option.upcase() eq 'NORM') then
  !part1 = 'norm'
elseif (!option.upcase() eq 'OPP') then
  !part1 = 'opp'
elseif (!option.upcase() eq 'PARALLEL') then
  !part1 = 'parallel'
else
  !this.error.append('Invalid option given it should be same, norm, opp or parallel')
  return FALSE
endif

!lname = '/av-' & !part1 & 'Dir'

-- Check the assoRef exists and is a ASSOGP
 !check = !this.checkaAssoGpExists(!assoRef)
 if (!check.not()) then
   return FALSE
 endif

 -- Check the definition exists
 !assdefExists = !this.testAvevaAssdef(!lname)
 if (!assDefExists.not()) then
   !this.error.append('Aveva association definition does not exist')
   return FALSE
 endif

 -- check that the arguments are OK
 !testRefs = !this.checkRefs(!taref1,!taref2,!dbref1,!dbref2)
 if (!testRefs.not()) then
   !this.error.append('The method called contained invalid references')
   return FALSE
 endif

  -- if the target references are set make sure they are owned by the relevant dbref
 if (!taref1.set()) then
 !check = !this.checkDbrefOwnsTarf(!taref1,!dbref1)
   if (!check.not()) then
     return FALSE
   endif
 endif
 if (!taref2.set()) then
 !check = !this.checkDbrefOwnsTarf(!taref2,!dbref2)
   if (!check.not()) then
     return FALSE
   endif
 endif

 !syntax = !syntax1
 !check=!this.checkSyntax(!syntax,!taref1,!dbref1)
 if (!check.not()) then
   return FALSE
 endif

 !synt1 = !syntax

 !syntax = !syntax2
 !check=!this.checkSyntax(!syntax,!taref2,!dbref2)
 if (!check.not()) then
   return FALSE
 endif
 !synt2 = !syntax

 -- navigate to the required db location
 !ce = !!ce
 !!ce = !assoRef
 NEW ASSOC
 handle any
   !this.error.append(!!error.text)
   !!ce = !ce
   return FALSE
 endhandle
 ADEFRF $!lname

 NEW RESTRI
 -- Set association definition reference

 LNAME $!lname$n-rd1
 NEW MBRMAP
 LNAME $!lname$n-mem1
 AMAPNME $!lname$n-ref1
 NEW MBRMAP
 LNAME $!lname$n-mem2
 AMAPNME $!lname$n-ref2
 NEW ASSMBR
 LNAME $!lname$n-ref1
 AMEMRF $!dbref1
 if (!taref1.set()) then
   TARF $!taref1
 endif
 $!synt1
 NEW ASSMBR
 LNAME $!lname$n-ref2
 AMEMRF $!dbref2
 if (!taref2.set()) then
   TARF $!taref2
 endif
 $!synt2
 !!ce = !ce
 return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      existsMulti
--
-- Description: Action to create standard AVEVA association between multiple objects
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .existsMulti(!assoRef is DBREF, !references is ARRAY ) is BOOLEAN

-- Check the assoRef exists and is a ASSOGP
 !check = !this.checkaAssoGpExists(!assoRef)
 if (!check.not()) then
   return FALSE
 endif

 !assdefExists = !this.testAvevaAssdef('/av-existsMulti')
 if (!assDefExists.not()) then
   !this.error.append('Aveva association definition does not exist')
   return FALSE
 endif
 -- navigate to the required db location
 !ce = !!ce
 !!ce = !assoRef
 NEW ASSOC
 handle any
   !this.error.append(!!error.text)
   !!ce = !ce
   return FALSE
 endhandle

 -- Set association definition reference
 ADEFRF /av-existsMulti

 NEW RESTRI
 LNAME /av-existsMulti-rd1
 do !i values !references
   NEW ASSMBR
   AMEMRF $!i
 enddo

 !!ce = !ce
 return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      testAvevaAssdef
--
-- Description: Check that the Standard aveva assdef exists
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .testAvevaAssdef(!assdef is STRING ) is BOOLEAN

  !exists = !!checkName(!assdef, 'OLD')
  if (!exists.unset()) then
    return FALSE
  else
    return TRUE
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      addExistsMulti
--
-- Description: Action to add another item to an assoc
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addExistsMulti(!assoRef is DBREF, !ref is DBREF ) is BOOLEAN


 !ce = !!ce
 !!ce = !assoRef
-- Must be at an assoc that points to /av-existsMulti
 !type = type
 if (!type neq 'ASSOC') then
   !this.error.append('You must be positioned at an ASSOC that points to the multiExists association definition in the hierarchy')
   !!ce = !ce
   return FALSE
 else
   !adefrf = adefrf
   if (!adefrf.name neq '/av-existsMulti' ) then
     !this.error.append('You must be positioned at an ASSOC that points to the multiExists association definition in the hierarchy')
     !!ce = !ce
     return FALSE
   endif
 endif

 -- Make sure the item isn't already in the assoc
 var !assmbr coll all assmbr for ce
 var !amemrf eval amemrf for all from !assmbr
 if (!amemrf.findFirst(!ref.name).set() ) then
   !this.error.append('$!ref.name is already included in the ASSOC')
   return FALSE
 endif
 LAS MEM
 NEW ASSMBR
 AMEMRF $!ref

 !!ce = !ce
 return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      remExistsMulti
--
-- Description: Action to remove an item from an assoc
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remExistsMulti(!assoRef is DBREF, !ref is DBREF ) is BOOLEAN

 !ce = !!ce
 !!ce = !assoRef
-- Must be at an assoc that points to /av-existsMulti
 !type = type
 if (!type neq 'ASSOC') then
   !this.error.append('You must supply an ASSOC that points to the multiExists association definition in the hierarchy')
   !!ce = !ce
   return FALSE
 else
   !adefrf = adefrf
   if (!adefrf.name neq '/av-existsMulti' ) then
     !this.error.append('You must supply an ASSOC that points to the multiExists association definition in the hierarchy')
     !!ce = !ce
     return FALSE
   endif
 endif

 -- Make sure the item is already in the assoc
 var !assmbr coll all assmbr for ce
 var !amemrf eval amemrf for all from !assmbr
 if (!amemrf.findFirst(!ref.name).unset() ) then
   !this.error.append('$!ref.name is not included in the ASSOC')
   !!ce = !ce
   return FALSE
 endif
 !!ce = !assmbr[!amemrf.findFirst(!ref.name)].dbref()
 DELETE ASSMBR

 !!ce = !ce
 return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      testDesignPoint
--
-- Description: Check that the design point supplied exists
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .testDesignPoint(!num is REAL, !dbref is DBREF ) is BOOLEAN

!test = !dbref.dpps[!num]
handle (2,201) $* design point number does not exist
  return FALSE
elsehandle none
  return TRUE
endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      testPPoint
--
-- Description: Check that the p point supplied exists
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .testPPoint(!num is REAL, !dbref is DBREF ) is BOOLEAN

!test = !dbref.ppos[!num]
handle (2,201) $* ppoint number does not exist
  return FALSE
elsehandle none
  return TRUE
endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      testPkey
--
-- Description: Check that the pkey supplied exists
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .testPkey(!name is STRING, !dbref is DBREF ) is BOOLEAN

!test = !dbref.plst.$!name
handle (2,224) $* pkey does not exist
  return FALSE
elsehandle none
  return TRUE
endhandle

endmethod
------------------------------------------------------------------------
--
-- Method:      checkRefs
--
-- Description: Check that the reference are OK
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkRefs(!taref1 is DBREF, !taref2 is DBREF, !dbref1 is DBREF, !dbref2 is DBREF ) is BOOLEAN

!return = TRUE
-- The tarefs and dbrefs must valid
if (!taref1.set()) then
  if (badref(!taref1)) then
    !this.error.append('The first target reference is invalid')
    !return = FALSE
  endif
endif

if (!taref2.set()) then
  if (badref(!taref2)) then
    !this.error.append('The second target reference is invalid')
    !return = FALSE
  endif
endif
if (badref(!dbref1)) then
  !this.error.append('The first member reference is invalid')
  !return = FALSE
endif
if (badref(!dbref2)) then
  !this.error.append('The second member reference is invalid')
  !return = FALSE
endif

-- The dbrefs must be set
if (!dbref1.unset()) then
  !this.error.append('The first member reference is unset')
  !return = FALSE
endif
if (!dbref2.unset()) then
  !this.error.append('The second member reference is unset')
  !return = FALSE
endif

return !return

endmethod
------------------------------------------------------------------------
--
-- Method:      checkRefs
--
-- Description: Check that the reference are OK
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkRefs(!taref1 is DBREF, !dbref1 is DBREF ) is BOOLEAN

!return = TRUE
-- The tarefs and dbrefs must valid
if (!taref1.set()) then
  if (badref(!taref1)) then
    !this.error.append('The first target reference is invalid')
    !return = FALSE
  endif
endif

if (badref(!dbref1)) then
  !this.error.append('The first member reference is invalid')
  !return = FALSE
endif

-- The dbrefs must be set
if (!dbref1.unset()) then
  !this.error.append('The first member reference is unset')
  !return = FALSE
endif

return !return

endmethod
------------------------------------------------------------------------
--
-- Method:      checkdbrefownstarf
--
-- Description: Check that the target is owned by the dbref
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkDbrefOwnsTarf(!taref is DBREF, !dbref is DBREF ) is BOOLEAN

!return = TRUE
!tarefOwners=!taref.ownlst
if (!tarefOwners.findFirst(!dbref).unset()) then
	!errorString = 'The target reference ' & !taref.name & ' is not owned by the member reference ' !dbref.name
  !this.error.append(!errorString)
  return FALSE
endif

return !return

endmethod
------------------------------------------------------------------------
--
-- Method:      checkaAssoGpExists
--
-- Description: Check that the association group supplied exists
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkaAssoGpExists(!dbref is DBREF ) is BOOLEAN

if (!dbref.unset()) then
  !this.error.append('The association group reference is unset')
  return FALSE
endif
if (badref(!dbref)) then
  !this.error.append('The association group reference is invalid')
  return FALSE
endif
if (!dbref.type neq 'ASSOGP') then
  !this.error.append('The database reference supplied is not an association group')
  return FALSE
endif
return TRUE

endmethod

------------------------------------------------------------------------
--
-- Method:      checkSyntax
--
-- Description: Check that the syntax will work
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkSyntax(!syntax is STRING , !taref is DBREF , !dbref is DBREF ) is BOOLEAN

if (!syntax eq '') then
  return TRUE
endif
 -- Check numbers supplied are OK
 !opt=!syntax.split()
 if (!opt[1].upcase() eq 'PPNU') then
   if (!taref.set()) then
     !test=!this.testPPoint(!opt[2].real(),!taref)
     if (!test.not()) then
       !this.error.append('Target reference $!taref.name does not contain a ppoint number $!opt[2]')
       return FALSE
     endif
   else
     !test=!this.testPPoint(!opt[2].real(),!dbref)
     if (!test.not()) then
       !this.error.append('Member reference $!dbref.name does not contain a ppoint number $!opt[2]')
       return FALSE
     endif
   endif
   !syntax = 'PPNU ' & !opt[2]
 elseif(!opt[1].upcase() eq 'NUM') then
   if (!taref.set()) then
     !test=!this.testDesignPoint(!opt[2].real(),!taref)
     if (!test.not()) then
       !this.error.append('Target reference $!taref.name does not contain a design point number $!opt[2]')
       return FALSE
     endif
   else
     !test=!this.testDesignPoint(!opt[2].real(),!dbref)
     if (!test.not()) then
       !this.error.append('Member reference $!dbref.name does not contain a design point number $!opt[2]')
       return FALSE
     endif
   endif
   !syntax = 'NUM ' & !opt[2]
 elseif(!opt[1].upcase() eq 'PKEY') then
   if (!taref.set()) then
     if (!taref.type neq 'SCTN') then
       !this.error.append('Target reference $!taref.name is not a SCTN')
       return FALSE
     endif
     !test=!this.testPkey(!opt[2],!taref)
     if (!test.not()) then
       !this.error.append('Target reference $!taref.name does not contain a PKEY of type $!opt[2]')
       return FALSE
     endif
   else
     if (!dbref.type neq 'SCTN') then
       !this.error.append('Member reference $!dbref.name is not a SCTN')
       return FALSE
     endif
     !test=!this.testPkey(!opt[2],!dbref)
     if (!test.not()) then
       !this.error.append('Member reference $!dbref.name does not contain a PKEY of type $!opt[2]')
       return FALSE
     endif
   endif
   if (defined(!opt[3])) then
     if (!opt[3].real() lt 0 or !opt[3].real() gt 1 ) then
       !this.error.append('The PKDIST must be between 0 and 1')
       return FALSE
     endif
   else
     !opt[3] = '0'
   endif
   !syntax = 'PKEY ' & !opt[2] & ' PKDIST ' & !opt[3]
 else
   !this.error.append('The syntax $!syntax is not in the correct format')
   return FALSE
 endif

return TRUE

endmethod

------------------------------------------------------------------------
--
-- Method:      planeDistance
--
-- Description: Action to create standard AVEVA association to check that 2 items
--              are a certain distance apart in a particular direction
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .planeDistance(!dir is STRING, !option is STRING, !assoRef is dbref, !syntax1 is STRING, !taref1 is dbref, !dbref1 is dbref, !syntax2 is STRING, !taref2 is dbref, !dbref2 is dbref, !dist is REAL ) is BOOLEAN

-- Check directions
if (!dir.upcase() eq 'E' or !dir.upcase() eq 'X') then
  !part2 = 'x'
elseif (!dir.upcase() eq 'N' or !dir.upcase() eq 'Y') then
  !part2 = 'y'
elseif (!dir.upcase() eq 'U' or !dir.upcase() eq 'Z') then
  !part2 = 'z'
else
  !this.error.append('Invalid direction given')
  return FALSE
endif

-- Check option
if (!option eq '>' or !option.upcase() eq 'GT' ) then
  !part1 = 'gt'
elseif (!option eq '<' or !option.upcase() eq 'LT' ) then
  !part1 = 'lt'
elseif (!option eq '=' or !option.upcase() eq 'EQ' or !option eq '' ) then
  !part1 = ''
else
  !this.error.append('Invalid option given it should be >, gt, <, lt, = ,eq or blank')
  return FALSE
endif

!lname = '/av-' &  !part1 & 'dist' & '-' & !part2
-- Check the assoRef exists and is a ASSOGP
 !check = !this.checkaAssoGpExists(!assoRef)
 if (!check.not()) then
   return FALSE
 endif
 -- Check the definition exists
 !assdefExists = !this.testAvevaAssdef(!lname)
 if (!assDefExists.not()) then
   !this.error.append('Aveva association definition does not exist')
   return FALSE
 endif

 -- check that the arguments are OK
 !testRefs = !this.checkRefs(!taref1,!taref2,!dbref1,!dbref2)
 if (!testRefs.not()) then
   !this.error.append('The method called contained invalid references')
   return FALSE
 endif

 -- if the target references are set make sure they are owned by the relevant dbref
 if (!taref1.set()) then
 !check = !this.checkDbrefOwnsTarf(!taref1,!dbref1)
   if (!check.not()) then
     return FALSE
   endif
 endif
 if (!taref2.set()) then
 !check = !this.checkDbrefOwnsTarf(!taref2,!dbref2)
   if (!check.not()) then
     return FALSE
   endif
 endif

 !syntax = !syntax1
 !check=!this.checkSyntax(!syntax,!taref1,!dbref1)
 if (!check.not()) then
   return FALSE
 endif

 !synt1 = !syntax

 !syntax = !syntax2
 !check=!this.checkSyntax(!syntax,!taref2,!dbref2)
 if (!check.not()) then
   return FALSE
 endif
 !synt2 = !syntax


 -- navigate to the required db location
 !ce = !!ce
 !!ce = !assoRef
 NEW ASSOC
 handle any
   !this.error.append(!!error.text)
   !!ce = !ce
   return FALSE
 endhandle
 ADEFRF $!lname
 DESP $!dist

 NEW DDSE
 NEW DDAT
 DKEY DIST
 DDDF ( 0 )
 DDPR ( DESP 1 OF ASSOC )
 PURP DESP
 DESC 'Plane Distance between points'

 NEW RESTRI
 -- Set association definition reference

 LNAME $!lname$n-rd1
 NEW MBRMAP
 LNAME $!lname$n-mem1
 AMAPNME $!lname$n-ref1
 NEW MBRMAP
 LNAME $!lname$n-mem2
 AMAPNME $!lname$n-ref2
 NEW ASSMBR
 LNAME $!lname$n-ref1
 AMEMRF $!dbref1
 if (!taref1.set()) then
   TARF $!taref1
 endif
 $!synt1
 NEW ASSMBR
 LNAME $!lname$n-ref2
 AMEMRF $!dbref2
 if (!taref2.set()) then
   TARF $!taref2
 endif
 $!synt2
 !!ce = !ce
 return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      specificDir
--
-- Description: Action to create standard AVEVA association to check that 2 items are coincident
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specificDir(!assoRef is dbref, !syntax1 is STRING, !taref1 is dbref, !dbref1 is dbref, !dir is DIRECTION ) is BOOLEAN

-- Check the assoRef exists and is a ASSOGP
 !check = !this.checkaAssoGpExists(!assoRef)
 if (!check.not()) then
   return FALSE
 endif

 -- Check the definition exists
 !assdefExists = !this.testAvevaAssdef('/av-specificDir')
 if (!assDefExists.not()) then
   !this.error.append('Aveva association definition does not exist')
   return FALSE
 endif

 -- check that the arguments are OK
 !testRefs = !this.checkRefs(!taref1, !dbref1 )
 if (!testRefs.not()) then
   !this.error.append('The method called contained invalid references')
   return FALSE
 endif

  -- if the target references are set make sure they are owned by the relevant dbref
 if (!taref1.set()) then
 !check = !this.checkDbrefOwnsTarf(!taref1,!dbref1)
   if (!check.not()) then
     return FALSE
   endif
 endif
 !syntax = !syntax1
 !check=!this.checkSyntax(!syntax,!taref1,!dbref1)
 if (!check.not()) then
   return FALSE
 endif
 !synt1 = !syntax

 -- navigate to the required db location
 !ce = !!ce
 !!ce = !assoRef
 NEW ASSOC
 handle any
   !this.error.append(!!error.text)
   !!ce = !ce
   return FALSE
 endhandle
 ADEFRF /av-specificDir
 NEW DDSE
 NEW DDAT
 DKEY DIR
 DDPR ( '$!dir' )
 PURP DIR
 DESC 'Specific Direction'

 NEW RESTRI
 -- Set association definition reference

 LNAME /av-specificDir-rd1
 NEW MBRMAP
 LNAME /av-specificDir-mem1
 AMAPNME /av-specificDir-ref1
 NEW ASSMBR
 LNAME /av-specificDir-ref1
 AMEMRF $!dbref1
 if (!taref1.set()) then
   TARF $!taref1
 endif
 $!synt1

 !!ce = !ce
 return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      horizontal
--
-- Description: Action to create standard AVEVA association to check if an item is horizontal
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .horizontal(!assoRef is dbref, !syntax1 is STRING, !taref1 is dbref, !dbref1 is dbref ) is BOOLEAN

-- Check the assoRef exists and is a ASSOGP
 !check = !this.checkaAssoGpExists(!assoRef)
 if (!check.not()) then
   return FALSE
 endif

 -- Check the definition exists
 !assdefExists = !this.testAvevaAssdef('/av-horiz')
 if (!assDefExists.not()) then
   !this.error.append('Aveva association definition does not exist')
   return FALSE
 endif

 -- check that the arguments are OK
 !testRefs = !this.checkRefs(!taref1, !dbref1 )
 if (!testRefs.not()) then
   !this.error.append('The method called contained invalid references')
   return FALSE
 endif

  -- if the target references are set make sure they are owned by the relevant dbref
 if (!taref1.set()) then
 !check = !this.checkDbrefOwnsTarf(!taref1,!dbref1)
   if (!check.not()) then
     return FALSE
   endif
 endif
 !syntax = !syntax1
 !check=!this.checkSyntax(!syntax,!taref1,!dbref1)
 if (!check.not()) then
   return FALSE
 endif
 !synt1 = !syntax

 -- navigate to the required db location
 !ce = !!ce
 !!ce = !assoRef
 NEW ASSOC
 handle any
   !this.error.append(!!error.text)
   !!ce = !ce
   return FALSE
 endhandle
 ADEFRF /av-horiz

 NEW RESTRI
 -- Set association definition reference

 LNAME /av-horiz-rd1
 NEW MBRMAP
 LNAME /av-horiz-mem1
 AMAPNME /av-horiz-ref1
 NEW ASSMBR
 LNAME /av-horiz-ref1
 AMEMRF $!dbref1
 if (!taref1.set()) then
   TARF $!taref1
 endif
 $!synt1

 !!ce = !ce
 return TRUE

endmethod

