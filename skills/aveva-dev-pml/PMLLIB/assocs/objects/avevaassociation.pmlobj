------------------------------------------------------------------------
--
-- Method:      exists2
--
-- Description: Action to create standard AVEVA association between 2 objects
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exists2(!assoRef is dbref, !dbref1 is dbref, !dbref2 is dbref ) is BOOLEAN

-- Check the assoRef exists and is a ASSOGP
 !check = !this.checkaAssoGpExists(!assoRef)
 if (!check.not()) then
   return FALSE
 endif

 !assdefExists = !this.testAvevaAssdef('/av-exists2')

 if (!assDefExists.not()) then
   !this.error.append('Aveva association definition does not exist')
   return FALSE
 endif

	 -- navigate to the required db location
 !ce = !!ce
 !!ce = !assoRef
 NEW ASSOC
 handle any
   !this.error.append(!!error.text)
   !!ce = !ce
   return FALSE
 endhandle
 ADEFRF /av-exists2


 NEW RESTRI
 -- Set association definition reference

 LNAME /av-exists2-rd1
 NEW MBRMAP
 LNAME /av-exists2-mem1
 AMAPNME /av-exists2-ref1
 NEW MBRMAP
 LNAME /av-exists2-mem2
 AMAPNME /av-exists2-ref2
 NEW ASSMBR
 LNAME /av-exists2-ref1
 AMEMRF $!dbref1
 NEW ASSMBR
 LNAME /av-exists2-ref2
 AMEMRF $!dbref2

 !!ce = !ce
 return TRUE

endmethod
------------------------------------------------------------------------
--
-- Method:      actualDistance
--
-- Description: Action to create standard AVEVA association to check that 2 items are a specific distance apart
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .actualDistance(!option is STRING, !assoRef is dbref, !syntax1 is STRING, !taref1 is dbref, !dbref1 is dbref, !syntax2 is STRING, !taref2 is dbref, !dbref2 is dbref, !dist is REAL ) is BOOLEAN

-- Check option
if (!option eq '>' or !option.upcase() eq 'GT' ) then
  !part1 = 'gt'
elseif (!option eq '<' or !option.upcase() eq 'LT' ) then
  !part1 = 'lt'
elseif (!option eq '=' or !option.upcase() eq 'EQ' or !option eq '' ) then
  !part1 = ''
else
  !this.error.append('Invalid option given it should be >, gt, <, lt, = ,eq or blank')
  return FALSE
endif

!lname = '/av-' & !part1 & 'ActualDist'
-- Check the assoRef exists and is a ASSOGP
 !check = !this.checkaAssoGpExists(!assoRef)
 if (!check.not()) then
   return FALSE
 endif

 -- Check the definition exists
 !assdefExists = !this.testAvevaAssdef(!lname)

 if (!assDefExists.not()) then
   !this.error.append('Aveva association definition does not exist')
   return FALSE
 endif

 -- check that the arguments are OK
 !testRefs = !this.checkRefs(!taref1,!taref2,!dbref1,!dbref2)
 if (!testRefs.not()) then
   !this.error.append('The method called contained invalid references')
   return FALSE
 endif

  -- if the target references are set make sure they are owned by the relevant dbref
 if (!taref1.set()) then
 !check = !this.checkDbrefOwnsTarf(!taref1,!dbref1)
   if (!check.not()) then
     return FALSE
   endif
 endif
 if (!taref2.set()) then
 !check = !this.checkDbrefOwnsTarf(!taref2,!dbref2)
   if (!check.not()) then
     return FALSE
   endif
 endif

 !syntax = !syntax1
 !check=!this.checkSyntax(!syntax,!taref1,!dbref1)
 if (!check.not()) then
   return FALSE
 endif

 !synt1 = !syntax

 !syntax = !syntax2
 !check=!this.checkSyntax(!syntax,!taref2,!dbref2)
 if (!check.not()) then
   return FALSE
 endif
 !synt2 = !syntax

 -- navigate to the required db location
 !ce = !!ce
 !!ce = !assoRef
 NEW ASSOC
 handle any
   !this.error.append(!!error.text)
   !!ce = !ce
   return FALSE
 endhandle
 ADEFRF $!lname
 DESP $!dist

 NEW DDSE
 NEW DDAT
 DKEY DIST
 DDDF ( 0 )
 DDPR ( DESP 1 OF ASSOC )
 PURP DESP
 DESC 'Actual Distance between points'

 NEW RESTRI
 -- Set association definition reference

 LNAME $!lname$n-rd1
 NEW MBRMAP
 LNAME $!lname$n-mem1
 AMAPNME $!lname$n-ref1
 NEW MBRMAP
 LNAME $!lname$n-mem2
 AMAPNME $!lname$n-ref2
 NEW ASSMBR
 LNAME $!lname$n-ref1
 AMEMRF $!dbref1
 if (!taref1.set()) then
   TARF $!taref1
 endif
 $!synt1
 NEW ASSMBR
 LNAME $!lname$n-ref2
 AMEMRF $!dbref2
 if (!taref2.set()) then
   TARF $!taref2
 endif
 $!synt2
 !!ce = !ce
 return TRUE

endmethod
------------------------------------------------------------------------
