--
-- Description:
--   Object used to verify an association multiple items exist
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  CheckMemberElements()            BOOLEAN             Make sure that at least two ASSMBR elements exist
--  TestEv()                         BOOLEAN             Make sure that at least one ASSMBR exists and AMEMRF is set
--  existsMulti()                    -                   Constructor method
--
------------------------------------------------------------------------

define object existsMulti

 -- MEMBER names are compulsory to tie in with ASSOCIATIONS
 -- COMPONENT = RESTRICTION element
   member .ASSOCIATION is DBREF
   member .COMPONENT is DBREF

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      existsMulti
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .existsMulti()

-- Constructor not used at present

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      TestEv
--
-- Description: Make sure that at least one ASSMBR exists and AMEMRF is set
--              Make sure that each ASSMBR has AMEMRF set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .TestEv() is BOOLEAN

-- Basic check on quantity and type of members referenced
  if ( NOT !this.CheckMemberElements() ) then
    return FALSE
  endif

-- Further checks should be added here - for example based on hole type (PIPE, TRAY, DUCT)
--  if ( !this.Association.Desc.eq('PIPE') ) then
--    return FALSE
--  endif


-- Once all checks completed successfully...
  return TRUE

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      CheckMemberElements
--
-- Description: Make sure that at least two ASSMBR elements exist
--              Make sure that each ASSMBR has the AMEMRF attribute set
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .CheckMemberElements() is BOOLEAN

  !check = object COLLECTION()
  !check.addtype('ASSMBR')
  !check.scope(!this.ASSOCIATION.members)

-- Verify that at least one ASSMBR element exists
  !total = !check.results().size()

-- Add conditional check to verify that each ASSMBR has a valid reference set
  !check.filter(object EXPRESSION(|not BADREF(AMEMRF)|) )
  !totalset = !check.results().size()

-- Must be at least two ASSMBR and all ASSMBR must have AMEMRF set
  if (!total.lt(2) OR !totalset.neq(!total) ) then
    return FALSE
  endif

  return TRUE
endmethod
-- End of method
