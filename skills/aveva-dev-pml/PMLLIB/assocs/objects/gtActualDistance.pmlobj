--
-- Description:
--   Object used to verify that 2 objects are >, < or = to a distance supplied
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  TestEv()                         BOOLEAN             Make sure that the distance is greater than the one supplied
--  gtActualDistance()               -                   Constructor method
--
------------------------------------------------------------------------

define object gtActualDistance

 -- MEMBER names are compulsory to tie in with ASSOCIATIONS
 -- COMPONENT = RESTRICTION element
   member .ASSOCIATION is DBREF
   member .COMPONENT is DBREF

   member .gtActDistMem1 is DBREF
   member .gtActDistMem2 is DBREF
   member .mbrGtActDistMem1 is DBREF
   member .mbrGtActDistMem2 is DBREF

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      gtActualDistance
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gtActualDistance()

-- Constructor not used at present

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      TestEv
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .TestEv() is BOOLEAN

!checkPos = !this.mbrGtActDistMem1.posev.east
if (!checkPos.unset()) then
  return FALSE
endif
!checkPos = !this.mbrGtActDistMem2.posev.east
if (!checkPos.unset()) then
  return FALSE
endif

var !d const dist $!this.mbrGtActDistMem1.posev to $!this.mbrGtActDistMem2.posev
!dist = int(!d.real())
!checkDist = !this.association.ldpr.dist

if (!dist gt !checkdist ) then
  return TRUE
else
  return FALSE
endif

endmethod
-- End of method
