--
-- Description:
--   Object used to verify that a points is in a horizontal direction
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  TestEv()                         BOOLEAN             Check that the direction is horizontal
--  horizontal()                     -                   Constructor method
--
------------------------------------------------------------------------

define object horizontal

 -- MEMBER names are compulsory to tie in with ASSOCIATIONS
 -- COMPONENT = RESTRICTION element
   member .ASSOCIATION is DBREF
   member .COMPONENT is DBREF

   member .horizontalMem1 is DBREF
   member .mbrHorizontalMem1 is DBREF

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      horizontal
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .horizontal()

-- Constructor not used at present

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      TestEv
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .TestEv() is BOOLEAN

!checkDir = !this.mbrHorizontalMem1.direv.east
if (!checkDir.unset()) then
  return FALSE
endif

!dir1 = !this.mbrHorizontalMem1.direv
!dir2 = object direction()
!dir2 = u

if (!dir1.angle(!dir2) eq 90 ) then
  return TRUE
else
  return FALSE
endif

endmethod
-- End of method
