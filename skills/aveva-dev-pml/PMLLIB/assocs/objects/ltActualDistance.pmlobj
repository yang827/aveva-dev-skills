--
-- Description:
--   Object used to verify that 2 objects are >, < or = to a distance supplied
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  TestEv()                         BOOLEAN             Check that the distance is less than the one supplied
--  ltActualDistance()               -                   Constructor method
--
------------------------------------------------------------------------

define object ltActualDistance

 -- MEMBER names are compulsory to tie in with ASSOCIATIONS
 -- COMPONENT = RESTRICTION element
   member .ASSOCIATION is DBREF
   member .COMPONENT is DBREF

   member .ltActDistMem1 is DBREF
   member .ltActDistMem2 is DBREF
   member .mbrLtActDistMem1 is DBREF
   member .mbrLtActDistMem2 is DBREF

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      ltActualDistance
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ltActualDistance()

-- Constructor not used at present

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      TestEv
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .TestEv() is BOOLEAN

!checkPos = !this.mbrLtActDistMem1.posev.east
if (!checkPos.unset()) then
  return FALSE
endif
!checkPos = !this.mbrLtActDistMem2.posev.east
if (!checkPos.unset()) then
  return FALSE
endif

var !d const dist $!this.mbrLtActDistMem1.posev to $!this.mbrLtActDistMem2.posev
!dist = int(!d.real())
!checkDist = !this.association.ldpr.dist

if (!dist lt !checkdist ) then
  return TRUE
else
  return FALSE
endif

endmethod
-- End of method
