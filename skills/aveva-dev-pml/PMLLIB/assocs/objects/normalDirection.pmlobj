--
-- Description:
--   Object used to verify that 2 objects are >, < or = to a distance supplied
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  TestEv()                         BOOLEAN             Check that the directions are normal
--  normalDirection()                -                   Constructor method
--
------------------------------------------------------------------------

define object normalDirection

 -- MEMBER names are compulsory to tie in with ASSOCIATIONS
 -- COMPONENT = RESTRICTION element
   member .ASSOCIATION is DBREF
   member .COMPONENT is DBREF

   member .normDirMem1 is DBREF
   member .normDirMem2 is DBREF
   member .mbrNormDirMem1 is DBREF
   member .mbrNormDirMem2 is DBREF

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      normalDirection
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .normalDirection()

-- Constructor not used at present

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      TestEv
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .TestEv() is BOOLEAN

!checkDir = !this.mbrNormDirMem1.direv.east
if (!checkDir.unset()) then
  return FALSE
endif
!checkDir = !this.mbrNormDirMem2.direv.east
if (!checkDir.unset()) then
  return FALSE
endif

!dir1 = !this.mbrNormDirMem1.direv
!dir2 = !this.mbrNormDirMem2.direv

if (int(!dir1.angle(!dir2)) eq 90 ) then
  return TRUE
else
  return FALSE
endif

endmethod
-- End of method
