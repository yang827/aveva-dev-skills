--   Group:
--     Keyword:     Associations
--   Module:        All
-- Author:          Martin Ward
--  Created:        April 07
--
-- Description:
--   Object used to verify that 2 objects are >, < or = to a distance supplied
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  TestEv()                         BOOLEAN             Check that the directions are opposite
--  oppositeDirection()              -                   Constructor method
--
------------------------------------------------------------------------

define object oppositeDirection

 -- MEMBER names are compulsory to tie in with ASSOCIATIONS
 -- COMPONENT = RESTRICTION element
   member .ASSOCIATION is DBREF
   member .COMPONENT is DBREF

   member .oppDirMem1 is DBREF
   member .oppDirMem2 is DBREF
   member .mbrOppDirMem1 is DBREF
   member .mbrOppDirMem2 is DBREF

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      oppositeDirection
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .oppositeDirection()

-- Constructor not used at present

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      TestEv
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .TestEv() is BOOLEAN

!checkDir = !this.mbrOppDirMem1.direv.east
if (!checkDir.unset()) then
  return FALSE
endif
!checkDir = !this.mbrOppDirMem2.direv.east
if (!checkDir.unset()) then
  return FALSE
endif

!dir1 = !this.mbrOppDirMem1.direv
!dir2 = !this.mbrOppDirMem2.direv.opposite()

if (!dir1 eq !dir2 ) then
  return TRUE
else
  return FALSE
endif

endmethod
-- End of method
