--  Created:        April 07
--
-- Description:
--   Object used to verify that 2 points are parallel
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  TestEv()                         BOOLEAN             Check that the directions are opposite
--  parallelDirection()              -                   Constructor method
--
------------------------------------------------------------------------

define object parallelDirection

 -- MEMBER names are compulsory to tie in with ASSOCIATIONS
 -- COMPONENT = RESTRICTION element
   member .ASSOCIATION is DBREF
   member .COMPONENT is DBREF

   member .parallelDirMem1 is DBREF
   member .parallelDirMem2 is DBREF
   member .mbrParallelDirMem1 is DBREF
   member .mbrParallelDirMem2 is DBREF

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      parallelDirection
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .parallelDirection()

-- Constructor not used at present

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      TestEv
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .TestEv() is BOOLEAN

!checkDir = !this.mbrParallelDirMem1.direv.east
if (!checkDir.unset()) then
  return FALSE
endif
!checkDir = !this.mbrParallelDirMem2.direv.east
if (!checkDir.unset()) then
  return FALSE
endif

!dir1 = !this.mbrParallelDirMem1.direv
!dir2 = !this.mbrParallelDirMem2.direv
!dir3 = !this.mbrParallelDirMem2.direv.opposite()

if (!dir1 eq !dir2 or !dir1 eq !dir3) then
  return TRUE
else
  return FALSE
endif

endmethod
-- End of method
