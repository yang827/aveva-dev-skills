--
-- Description:
--   Object used to verify that 2 objects are >, < or = to a distance supplied
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  TestEv()                         BOOLEAN             Check that the directions are opposite
--  pointInProfile()                 -                   Constructor method
--
------------------------------------------------------------------------

define object pointInProfile

 -- MEMBER names are compulsory to tie in with ASSOCIATIONS
 -- COMPONENT = RESTRICTION element
   member .ASSOCIATION is DBREF
   member .COMPONENT is DBREF

   member .pointInProfileMem1 is DBREF
   member .pointInProfileMem2 is DBREF
   member .mbrPointInProfileMem1 is DBREF
   member .mbrPointInProfileMem2 is DBREF

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      pointInProfile
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointInProfile()

-- Constructor not used at present

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      TestEv
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .TestEv() is BOOLEAN

-- Check which member has been set as the profile
if (!this.mbrPointInProfileMem1.desc neq 'Profile' and !this.mbrPointInProfileMem2.desc neq 'Point') then
  return FALSE
endif

!profile = object profile(!this.mbrPointInProfileMem1.tarf)
handle (2,839) $* cant make a profile of the object
  return FALSE
endhandle

!checkPos = !this.mbrPointInProfileMem2.posev.east
if (!checkPos.unset()) then
  return FALSE
endif

!pos = !this.mbrPointInProfileMem2.posev
!testev = !profile.isWithin(!pos)

return !testev

endmethod
-- End of method
