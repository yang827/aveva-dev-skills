--
-- Description:
--   Object used to verify that a points is in a specific direction
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  TestEv()                         BOOLEAN             Check that the directions are opposite
--  specificDirection()              -                   Constructor method
--
------------------------------------------------------------------------

define object specificDirection

 -- MEMBER names are compulsory to tie in with ASSOCIATIONS
 -- COMPONENT = RESTRICTION element
   member .ASSOCIATION is DBREF
   member .COMPONENT is DBREF

   member .specificDirMem1 is DBREF
   member .mbrSpecificDirMem1 is DBREF

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      specificDirection
--
-- Description: Constructor method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .specificDirection()

-- Constructor not used at present

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      TestEv
--
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .TestEv() is BOOLEAN

!checkDir = !this.mbrSpecificDirMem1.direv.east
if (!checkDir.unset()) then
  return FALSE
endif

!dir1 = !this.mbrSpecificDirMem1.direv
!dir2 = !this.association.depr.dir

if (!dir1 eq !dir2.direction()) then
  return TRUE
else
  return FALSE
endif

endmethod
-- End of method
