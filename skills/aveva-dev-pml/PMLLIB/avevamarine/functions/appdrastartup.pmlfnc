define function !!appDraStartup()

  -- Test for Marine product
  VAR !marine EVAR 'AVEVA_MARINE'
    handle any
      !marine = 'NO'
    endhandle

  !isMarine = !marine.upcase().eq('YES')

  -- Run the marine application initialisations
  if (!isMarine) then

    -- Add any calls here

  endif

endfunction
-- End of function !!appDraStartup
