import 'PMLFileBrowser'
handle any
endhandle

import 'GridControl'
handle (1000,0)
endhandle

import 'MarApi'
handle (1000,0)
endhandle

--define function !!blockAdminTemplate()

using namespace 'Aveva.Marine.Utility'
!util = object MarUtil()
!path = !util.TBEnvironmentGet('SB_SHIPDATA')

using namespace 'Aveva.Pdms.Presentation'
!browser = object PMLFILEBROWSER('SAVE')
!browser.show(!path, 'blockAdminCreate.xls', 'title', false, 'Excel Files (*.xls)|*.xls',1)
if (!browser.file().eq('')) then
  return
endif

!ngc = object NETGRIDCONTROL()
!table = ARRAY()

-- Define columns
!headings = '#KEYWORD Owning_team Name Description Type Claim_mode Number'
!heads = !headings.split()

!dbNo = 6000
!lastInd = 0
var !col collect all (SPMBSA) for $!!CE

onerror continue
do !X TO !col.SIZE()
  !row = ARRAY()
  --DATABASE
  !row[1] = 'DATABASE'
  --TEAM
  !row[2] = 'HULL'
  --DB name substring /ARR_S0001 -> S0001
  !nodeName = FLNN of own of $!col[$!X]
  !arrSubstrings =!nodeName.split('_')
  !lastInd = !arrSubstrings.MaxIndex()
  !row[3] = !arrSubstrings[!lastInd]
  --Description
  !row[4] = DESCRIPTION of $!col[$!X]
  --Type
  !row[5] = 'DESI'
  --Claim mode
  !row[6] = 'IMPLICIT'
  --Number
  !dbNo = !dbNo + 1
  !row[7] = String(!dbNo.INT())


  !table[$!X] = ARRAY()
  !table[$!X].AppendArray( !row)
enddo

!data = object NETDATASOURCE('source', !heads, !table, FALSE)
!ngc.bindToDataSource( !data)

!ngc.SaveGridToExcel( !browser.file())

--endfunction
