import 'PMLFileBrowser'
handle any
endhandle

import 'MarApi'
handle (1000,0)
endhandle

--define function !!blockTopeTemplate()

using namespace 'Aveva.Marine.Utility'
!util = object MarUtil()
!path = !util.TBEnvironmentGet('SB_SHIPDATA')

using namespace 'Aveva.Pdms.Presentation'
!browser = object PMLFILEBROWSER('SAVE')
!browser.show(!path, 'blockTopeCreate.pmlfnc', 'title', false, 'Pml Files (*.pmlfnc)|*.pmlfnc',1)
if (!browser.file().eq('')) then
  return
endif
!outFile = object File( !browser.file())
!outFile.Open('WRITE')


var !col collect all (SPMBSA) for $!!CE

onerror continue
do !X TO !col.SIZE()

  !nodeName = FLNN of own of $!col[$!X]
  !arrSubstrings =!nodeName.split('_')
  !lastInd = !arrSubstrings.MaxIndex()
  !row = '!!hullnewblock('''
  !row = !row + !arrSubstrings[!lastInd]
  --Team/DB
  !row = !row + ''',''HULL/'
  !row = !row + !arrSubstrings[!lastInd]
  !row = !row + ''')'
  !outFile.WriteRecord( !row)
enddo

!outFile.Close()

--endfunction
