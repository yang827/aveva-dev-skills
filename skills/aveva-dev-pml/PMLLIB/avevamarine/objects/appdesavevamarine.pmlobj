--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appDesAvevaMarine()              -                   Construct
--  modifyMenus()                    -                   Modify menus in design applications
--
define object APPDESAVEVAMARINE

  member .assembly is ASSEMBLYDRAWING

  member .isMarine is BOOLEAN

endobject

------------------------------------------------------------------------
--
-- Method:        .appDesAvevaMarine()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appDesAvevaMarine()

  -- Test for Marine product
  VAR !marine EVAR 'AVEVA_MARINE'
    handle any
      !marine = 'NO'
    endhandle

  !this.isMarine = !marine.upcase().eq('YES')

endmethod
-- End of method definition for .appDesAvevaMarine()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Modify menus in design applications
--
-- Method Type: Procedure
-- Arguments: None
-- Return: None
--
------------------------------------------------------------------------
define method .modifyMenus()

  -- Insert license check here and use result (No specific licensed for VM)
  -- to control visibility of menu entry at module load
--  !license = TRUE

  -- Add pipe production checks to utilities menu
--  !menu = object APPMENU('SYSUTIL')
--  !menu.insertAfter('ShowPipeSystem', 'TOGGLE', |Production Checks|, '', 'Pipe Checking')

--  !!appMenuCntrl.addMenu(!menu, 'PIPE')

--  !!appdesmain.sysUtil.setFieldProperty('Pipe Checking', 'ACTIVE', !license)

-- ********** The above code has been moved to standard PDMS. However retain this file for future AVEVA Marine addins.

  if (!this.isMarine) then
    -- Add Ship Reference Grid to utilities menu
    !menu = object APPMENU('SYSUTIL')
    !menu.insertAfter('Constructs', 'CALLBACK', |Ship Reference Grids...|, 'show !!shipReferenceGrids', 'shipReferenceGrids')

    !!appMenuCntrl.addMenu(!menu, 'ALL')

    -- Add ship positioning form to all positioning menus
     !menu = object APPMENU('POSITION')
     !menu.insertAfter('Explicitly', 'CALLBACK', |Using Ship References...|, 'show !!shipReferencePosition', 'shipReferencePosition')

    !!appMenuCntrl.addMenu(!menu, 'ALL')
  endif

endmethod
