-- Description:     Object for AVEVA Marine application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appDraAvevaMarine()              -                   Construct
--  modifyForm()                     -                   Modify Form
--  modifyMenus()                    -                   Modify menus in draft applications
--
define object APPDRAAVEVAMARINE

  member .isMarine    is BOOLEAN

endobject
------------------------------------------------------------------------
--
-- Method:        .appDraAvevaMarine()
--
-- Description:   Construct
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appDraAvevaMarine()

  -- Test for Marine product
  VAR !marine EVAR 'AVEVA_MARINE'
    handle any
      !marine = 'NO'
    endhandle

  !this.isMarine = !marine.upcase().eq('YES')

endmethod
-- End of method definition for .appDraAvevaMarine()
------------------------------------------------------------------------
