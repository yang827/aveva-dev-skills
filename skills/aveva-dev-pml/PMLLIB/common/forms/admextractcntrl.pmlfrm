-- Author:          A.Kirkland
-- Created:         Tue Oct 5 11:31:06 BST 1999
--
--
-- Description:
-- form to handle and control extract issuing and claiming
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action(STRING)                   -                   setup form for action to take on list
--  admExtractCntrl()                -                   Constructor
--  apply()                          -                   run command on selected elements in list
--  buildList()                      -                   Build the list for partial from DB Elements
--  clearList()                      -                   Clear the list for partial from DB Elements
--  close()                          -                   Close the form
--  fullOrPartial()                  -                   Set up form for full (DBS) or Partial (Elements)
--  getExtracts(ARRAY,DBREF)         ARRAY               Collect extract databases in the current MDB
--  getRwDbs()                       ARRAY               Collect databases in the current MDB that are read/write
--  initialise()                     -                   Initialisation for form
--
------------------------------------------------------------------------

setup form !!admExtractCntrl

  !this.formTitle     = 'Extract Control'
  !this.iconTitle     = 'ExtCntrl'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = '!this.close()'
  !this.formRevision  = ' $Revision: 1.15 $ '

  -- Body of form definition
  path down
  rgroup .mode 'Control Mode' at x 1 frame HORIZONTAL
    add tag 'Databases     '   SELECT 'FULL'
    add tag 'DB Elements   '   SELECT 'PARTIAL'
  exit

  path right
  option .elements 'Elements' at xmax+1 ymin+0.5  width 12
  button .addElements   ' Add '
  button .clearElements 'Clear List' at xmin.elements+9 ymax+0.5
  path down

  frame .frame |Element List       | at xmin.mode ymax
    list   .list at xmin.mode+1 ymax MULTIPLE height 10 width 66

    option .dbSort   |Sort By| at xmin.list ymax.list width 12

    text   .dbFilter |Filter|  at xmax+2 ymin  width 15 STRING

    button .clear    |Clear Selection|   at xmax form-size ymin
  exit

--   rgroup .action 'Action' at xmin.frame ymax+0.5 frame HORIZONTAL
--     add tag 'Get Changes  '   SELECT 'REFRESH'
--     add tag 'Save Changes  '  SELECT 'FLUSH'
--     add tag 'Abort Changes '  SELECT 'DROP'
--     add tag 'Issue Changes'   SELECT 'ISSUE'
--   exit
  frame .action 'Action' at xmin.frame ymax+0.5
    path right
    toggle .actionRefresh 'Get Changes  '   STATES 'false' 'true'
    toggle .actionFlush   'Save Changes  '  STATES 'false' 'true'
    toggle .actionDrop    'Abort Changes '  STATES 'false' 'true'
    toggle .actionIssue   'Issue Changes'   STATES 'false' 'true'
  exit

  toggle .release at xmin+27 ymax+0.5 'Release Claim' STATES 'false' 'true'

  button .apply |Apply| at xmin.mode ymax call |!this.apply()| APPLY

  button .dismiss at xmax form-size ymin |Dismiss| OK

  -- The String of the Command required

  member .command       is STRING
  member .triedWorl     is REAL
  member .actionList    is ARRAY

exit
-- End of form definition for !!admExtractCntrl
------------------------------------------------------------------------
--
-- Method:      constructor
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .admExtractCntrl()

  -- Callbacks
  !this.mode.callback          = |!this.initialise()|
  !this.addElements.callback   = |!this.buildList()|
  !this.clearElements.callback = |!this.clearList()|
  !this.dbSort.callback        = |!this.fullOrPartial()|
  !this.dbFilter.callback      = |!this.fullOrPartial()|
  !this.clear.callback         = |!this.list.clearSelection()|
--  !this.action.callback        = |!this.action(!this.action.selection())|
  !this.dismiss.callback       = |!this.close()|
  !this.actionRefresh.callback = |!this.action('REFRESH')|
  !this.actionFlush.callback   = |!this.action('FLUSH')|
  !this.actionDrop.callback    = |!this.action('DROP')|
  !this.actionIssue.callback   = |!this.action('ISSUE')|
  !this.triedWorl              = 0
  !list[1] = 'CE'
  !list[2] = 'CE Members'
  !list[3] = 'Current List'
  !list[4] = 'Claimlist'
--  !list[5] = 'Clear List'

  !this.elements.dText = !list

  !this.dbFilter.val   = |*|
  !!admDbSortGadg(!this.dbSort)

endmethod
-- End of method definition for .admExtractCntrl()
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- set form for mode working in
  !this.fullOrPartial()

  -- set the action selection up
  if( !this.actionRefresh.val ) then
    !action = 'REFRESH'
  elseif( !this.actionFlush.val ) then
    !action = 'FLUSH'
  elseif( !this.actionDrop.val ) then
    !action = 'DROP'
  elseif( !this.actionIssue.val ) then
    !action = 'ISSUE'
  else
    -- none set - .action will sort out a default if given 'REFRESH'
    !action = 'REFRESH'
  endif
  !this.action(!action)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      getRwDbs
--
-- Description: Collect databases in the current MDB that are read/write
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [Array of dbs that are RW in the current MDB]
--
------------------------------------------------------------------------

define method .getRwDbs() is ARRAY

-- initialise variables
  !session     = CURRENT SESSION
  !currentDbs  = !session.current()
  !status      = !session.status()
  !dbs         = ARRAY()

  -- get dbs that are read/write
  do !i indices !status
    if(!status[!i].upcase().eq('RW')) then
      !dbs.append(!currentDbs[!i])
    endif
  enddo

  -- return the dbs in the current mdb that are RW.
  return !dbs

endmethod
-- End of method definition for .getRwDbs() ARRAY

------------------------------------------------------------------------
--
-- Method:      getExtracts
--
-- Description: Collect extract databases in the current mdb
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [ARRAY]     [List of dbs to get extracts from]
--   [2] [R]    [DBREF]     [Current Location]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [Array of extract dbs]
--
------------------------------------------------------------------------

define method .getExtracts(!dbs is ARRAY, !location is DBREF) is ARRAY

  -- initialise variables
  !extractDbs = ARRAY()

  do !i values !dbs
    skip if (!i.access.upcase() NEQ |MULTIWRITE|)
    !temp = !i.refno.dbref()
    skip if (!temp.extown.unset() or !temp.extown eq !temp)

    if(!!glbIsGlobal())then
      -- check if primary at given location
      skip if (!temp.mem[1].locrf NEQ !location)
    endif
    !extractDbs.append(!i)
  enddo

  return !extractDbs
endmethod
-- End of method definition for .getExtracts(ARRAY, DBREF) ARRAY
------------------------------------------------------------------------
--
-- Method:      fullOrPartial
--
-- Description: Set up form for full (DBS) or Partial (Elements)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fullOrPartial()

  if(!this.mode.selection().upcase().eq('FULL')) then

    !this.actionRefresh.active = TRUE
    !this.dbSort.active        = TRUE
    !this.dbFilter.active      = TRUE

    !this.elements.active      = FALSE
    !this.addElements.active   = FALSE
    !this.clearElements.active = FALSE
    !this.frame.tag = 'List of Databases'

    -- These lines are very messy, they get the location the user is at!
    if(!!glbIsGlobal())then
      !users = USERS
      !location = !users[1].refno.dbref().own.own.curLoc
    else
      !location = object DBREF()
    endif

    -- Must now get DBs ; yes but from the session not the whole project (AK)

    !dbs        = !this.getRwDbs()
    !extractDbs = !this.getExtracts(!dbs,!location)

    -- don't know what this is for (AK) but leave it in
    !format              = object DBLISTATTR()
    !format.name         = TRUE
    !format.typeDb       = TRUE
    !format.dbno         = TRUE
    !format.description  = TRUE
    !format.access       = TRUE
    !format.claim        = TRUE
    !format.fileName     = FALSE

    !displayList         = !!adminFilterSort(!extractDbs, !this.dbSort, !this.dbFilter)

    -- build the list of db's

    !!adminDbTxtList(!displayList, !this.list, !format, TRUE , !location)

    -- select first in list
    if(!this.list.dText.size().gt(0)) then
      !this.list.val = 1
    endif

  else

    -- Partial
    !this.actionRefresh.active = FALSE
    !this.dbSort.active        = FALSE
    !this.dbFilter.active      = FALSE
    !this.elements.active      = TRUE
    !this.addElements.active   = TRUE
    !this.clearElements.active = TRUE
    !this.frame.tag = 'List of DB Elements'
    !this.list.clear()
--    !this.buildList()

  endif

endmethod
-- End of method definition for .fullOrPartial()
------------------------------------------------------------------------
--
-- Method:      buildList
--
-- Description: Build the list for partial from DB Elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .buildList()

  !listDstore      = !this.list.dText
  !listRstore      = !this.list.rText

  !listElements    = ARRAY()
  !extractElements = ARRAY()

  !whichElement    = !this.elements.selection().upcase()

  if(!whichElement eq 'CE') then
    !item = !!ce
    -- don't add it to the list
    if(!item.hardtype eq 'WORL') then
      if(!this.triedWorl.gt(0)) then
        return error 1 'Cannot action any changes on the WORLD Level, select elements below WORLD for the list'
      endif
     !this.triedWorl = !this.triedWorl + 1
    else
      !listElements[1] = !item
    endif

  elseif(!whichElement eq 'CE MEMBERS') then
    !listElements = !!ce.members

  elseif(!whichElement eq 'CURRENT LIST') then
    !listElements = !!lstcurrentlist()

  elseif(!whichElement eq 'CLAIMLIST') then
    var !listElements COLLECT ALL WITH (TYPE NEQ 'SPST') FROM CLAIMLIST EXTRACT

  else
    -- should not get here
    !this.list.clear()
    return

  endif

  -- check that everything in the list is in an extract DB
  -- The elements tested may be DBREF or STRING references
  !listType = !listElements[1].objectType()
  handle any
    !listType = ''
  endhandle
  !badElement = false
  do !element values !listElements
    if( !listType eq 'STRING' ) then
      !elementRef = !element.dbref()
    else
      !elementRef = !element
    endif
    !in = object DBREF('/*' + !elementRef.dbname)
    if( !in.extown.set() and !in.extown ne !in ) then
      -- in an extract
      !extractElements.append(!elementRef.string())
    else
      !badElement = true
    endif
  enddo

  if( !extractElements.empty() ) then
    !!alert.warning('No elements selected that are in an extract DB, or extract DB is empty')
  else
    -- some elements found in extracts
    !listRstore.appendArray(!extractElements)
    !listRstore.unique()
    var !listDstore EVALUATE FULLNAME FOR ALL FROM !listRstore

    !this.list.dText = !listDstore
    !this.list.rText = !listRstore
    if( !badElement ) then
      !!alert.warning('One or more of the selected elements was not added to the list because they were not in an Extract DB')
    endif
  endif

  -- select first in list
  if(!this.list.dText.size().gt(0)) then
    !this.list.val = 1
  endif

endmethod
-- End of method definition for .buildList()
------------------------------------------------------------------------
--
-- Method:      clearList
--
-- Description: Clear the list for partial from DB Elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearList()

    !this.list.clear()

endmethod
-- End of method definition for .clearList()
------------------------------------------------------------------------
--
-- Method:      action
--
-- Description: setup form for action to take on list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [What action to take]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .action(!action is STRING)

  !this.actionRefresh.val = FALSE
  !this.actionFlush.val   = FALSE
  !this.actionDrop.val    = FALSE
  !this.actionIssue.val   = FALSE
  if(!action.eq('REFRESH')) then
    !this.release.active  = FALSE
    !this.release.val     = FALSE
    -- this option only valid for FULL
    !this.actionRefresh.val = !this.mode.selection().eq('FULL')
  elseif(!action.eq('FLUSH')) then
    !this.release.active  = TRUE
    !this.release.val     = FALSE
    !this.actionFlush.val = TRUE
  elseif(!action.eq('DROP')) then
    !this.release.active  = TRUE
    !this.release.val     = FALSE
    !this.actionDrop.val  = TRUE
  elseif(!action.eq('ISSUE')) then
    !this.release.active  = FALSE
    !this.release.val     = TRUE
    !this.actionIssue.val = TRUE
  endif

  -- if all are false then must be a DB element with REFRESH set. Default to flush
  if( not ( !this.actionRefresh.val or !this.actionFlush.val or !this.actionDrop.val or !this.actionIssue.val ) ) then
    !this.release.active  = TRUE
    !this.release.val     = FALSE
    !this.actionFlush.val = TRUE
  endif

endmethod
-- End of method definition for .action(STRING)
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: run command on selected elements in list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [What action to take]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- this has to be a global variable so that admCommand function can access the value
  !!listExtractCntrl = !this.list.selection()
  -- true for DB, false for elements
  !mode = !this.mode.selection() eq 'FULL'

  -- get action to be carried out.
  if(!this.actionIssue.val) then
    !action = 'ISSUE'
  elseif(!this.actionFlush.val) then
    !action = 'FLUSH'
  elseif(!this.actionDrop.val) then
    !action = 'DROP'
  else
    !action = 'REFRESH'
  endif

  if(!mode) then

    -- Operation on DB
    do !i values !!listExtractCntrl
      !temp = !i.dbref()
      !name = 'DB ' & !temp.name.substring(3)

      -- run command (these do not work yet in core)
       call !!admCommand(|EXTRACT $!action $!name|)
      handle any
        !!alert.error(!!error.text)
      elsehandle none
        if(defined (!!lstClaim) and !!lstClaim.shown()) then
          !!lstClaim.update()
        endif
--         call !!admCommand(|GETWORK|)
      endhandle

      if(!action inset('FLUSH','DROP') and (!this.release.val)) then
       call !!admCommand(|EXTRACT RELEASE $!name|)
        handle any
          -- unexpected error
          !!alert.error(!!error.text)
        elsehandle none
          if(defined (!!lstClaim) and !!lstClaim.shown()) then
            !!lstClaim.update()
          endif
        endhandle
      endif
    enddo

  else

    -- Operation on individual elements, grouped into a single operation
    call !!admCommand(|EXTRACT $!action ALL FROM !!listExtractCntrl|)
    handle any
      !!alert.error(!!error.text)
    elsehandle none
      if(defined (!!lstClaim) and !!lstClaim.shown()) then
        !!lstClaim.update()
      endif
--      call !!admCommand(|GETWORK|)
    endhandle

    if(!action inset('FLUSH','DROP') and (!this.release.val)) then
     call !!admCommand(|EXTRACT RELEASE ALL FROM !!listExtractCntrl|)
      handle any
        -- unexpected error
        !!alert.error(!!error.text)
      elsehandle none
        if(defined (!!lstClaim) and !!lstClaim.shown()) then
          !!lstClaim.update()
        endif
      endhandle
    endif

  endif

  -- garbage COLLECT global variable
  !!listExtractCntrl.delete()
  handle any
  endhandle

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.triedWorl = 0

endmethod
-- End of method definition for .close()
