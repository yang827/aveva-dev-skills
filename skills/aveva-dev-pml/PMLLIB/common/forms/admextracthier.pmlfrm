-- Created:         Tue Oct 5 11:31:06 BST 1999
--
--
-- Description:
-- Shows extract claim hierarchy information
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  admExtractHier()                 -                   Constructor
--  backPage()                       -                   Move to previous page of results
--  initialise()                     -                   Initialisation for form
--  navigate()                       -                   Navigate to selected element from the list
--  nextPage()                       -                   Move to next page of results
--  page(REAL)                       -                   Display results page with first entry as !startAt
--  samePage()                       -                   Reconstruct this page of results
--
------------------------------------------------------------------------

setup form !!admExtractHier resize

  !this.formTitle     = 'Extract Claim List'
  !this.iconTitle     = 'ExtList'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition
  path right

  button    .refresh | Update | at x0.2 y0.5 call |!this.initialise()| tooltip 'Show extract hierarchy for the current element'
  paragraph .numberResults       at xmax+15 ymin width 18
  option    .number              at xmax    ymin   call |!this.samePage()| width 3

  frame .listfilt 'List Filters' at x0      ymax+0.2 width 50
      paragraph .extClaimList    at x1      ymin+1                          width 10
      option    .optList         at xmax    ymin   call |!this.initialise()| width 6
      paragraph .extdbList       at xmax+2  ymin                           width 8
      option    .dbNameList      at xmax    ymin   call |!this.initialise()| width 10
  exit

  paragraph .numberElements     at xmin.refresh ymax width 30
  path right
  button    .back               at xmax.numberElements+7 ymin call |!this.backPage()| pixmap width 8 height 8 tooltip 'Back one page of results'
  button    .forward                               call |!this.nextPage()| pixmap width 8 height 8 tooltip 'Forward one page of results'
  paragraph .pageNumber     width 8

  list      .list               at xmin.refresh ymax+0.2 call |!this.navigate()| anchor all width 48 length 10

  -- The String of the Command required
  member  .extClaimHier   is ARRAY
  -- used for paging the results
  member  .firstNumber    is REAL
  member  .lastNumber     is REAL

exit
-- End of form definition
-----------------------------------------------------------------------
--
-- Method:      admExtractHier
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .admExtractHier()

  -- set number of results per page options
  !listDtext[1] = ' 10'
  !listDtext[2] = ' 20'
  !listDtext[3] = ' 50'
  !listDtext[4] = '100'
  !this.number.dtext = !listDtext
  !this.number.rtext = !listDtext
  !this.lastNumber   = 0
  !this.firstNumber  = 0
  !this.forward.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !this.back.addPixmap(!!pml.getPathName('leftarrow16.png'))

  !optListdtex[1] = 'CE'
  !optListdtex[2] = 'MDB'
  !optListdtex[3] = 'DBs'
  !this.optList.dtext = !optListdtex
  !this.extClaimList.val = 'Extract Claim'
  !this.extdbList.val = 'Extract DBs'
  !this.numberResults.val = 'Number of results per page'
  !e1 = ARRAY()
  !module = !!module()
  !a = CURRENT SESSION
  !d = !a.current()
  do !j indices !d
    if (!module.ddlType eq !d[!j].type ) then
      if (!d[!j].refno.dbref().extowner.unset().eq(FALSE)) then
        !e = !d[!j].name
        !e1.append(!e)
      endif
    endif
  enddo
  !this.dbNameList.dtext = !e1

endmethod
-- End of method definition for .admExtractHier()
-----------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  if (!this.optList.selection('DTEXT').eq('DBs')) then
      !this.dbNameList.active = TRUE
      !this.extdbList.active = TRUE
    else
      !this.dbNameList.active = FALSE
      !this.extdbList.active = FALSE
  endif

  -- set form for mode working in
  prompt 'Collecting extract claim hierarchy data...'
  EXTRACT CLAIM LATEST

  if(!this.optList.selection('DTEXT').eq('MDB') or !!ce.type.eq('WORL')) then
     var !coll coll all from claimlist extract
     !this.extClaimHier = !coll
    if (!this.optList.selection('DTEXT').eq('DBs')) then
      !seldb = !!admExtractHier.dbNameList.selection('dtext')
      var !coll coll all with (TYPE NEQ 'SPST' and DBNAME EQ !seldb ) from claimlist extract
      !this.extClaimHier = !coll
    endif
  elseif (!this.optList.selection('DTEXT').eq('DBs')) then
    !seldb = !!admExtractHier.dbNameList.selection('dtext')
    var !coll coll all with (TYPE NEQ 'SPST' and DBNAME EQ !seldb ) from claimlist extract
    !this.extClaimHier = !coll
  else
    !this.extClaimHier       = !!ce.exclhi
  endif

  prompt dismiss
  !this.firstNumber        = 0
  !this.lastNumber         = 0
  !this.numberElements.val = 'Number of claimed elements: ' + !this.extClaimHier.size().string()
  !this.nextPage()

endmethod
-- End of method definition for .initialise()
-----------------------------------------------------------------------
--
-- Method:      nextPage
--
-- Description: Move to next page of results
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nextPage()

  !pageSize = !this.number.selection().real()
  !startAt  = !this.lastNumber + 1
  if( !startAt gt !this.extClaimHier.size() ) then
    !startAt = 1
  endif
  !this.page(!startAt)

endmethod
-- End of method definition for .nextPage()
-----------------------------------------------------------------------
--
-- Method:      backPage
--
-- Description: Move to previous page of results
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backPage()

  !pageSize = !this.number.selection().real()
  !startAt  = max(1, !this.firstNumber - !pageSize)
  !this.page(!startAt)

endmethod
-- End of method definition for .backPage()
-----------------------------------------------------------------------
--
-- Method:      samePage
--
-- Description: Reconstruct this page of results
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .samePage()

  !this.page(!this.firstNumber)

endmethod
-- End of method definition for .samePage()
-----------------------------------------------------------------------
--
-- Method:      page
--
-- Description: Display results page with first entry as !startAt
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .page( !startAt is REAL )

  -- set form for mode working in
  !listRtext = ARRAY()
  !listDtext = ARRAY()
  !this.list.clear()
  if( !this.extClaimHier.empty() ) then
    !this.pageNumber.val = ''
    return
  endif
  !listSize  = !this.extClaimHier.size()

  !pageSize = !this.number.selection().real()
  !endAt = !startAt + !pageSize - 1
  if( !endAt gt !listSize ) then
    !endAt = !listSize
  endif
  !this.firstNumber = !startAt
  !this.lastNumber  = !endAt

  !project     = current project
  !currentUser = !project.currentSession().user().string()
  do !i from !startAt to !endAt
    if(!this.extClaimHier[!i].objectType().eq('STRING')) then
       !element = !this.extClaimHier[!i].dbRef()
    else
       !element = !this.extClaimHier[!i]
    endif
    !listRtext.append(!element.string())
    -- Get string showing claim status
    if( !element.expmod ) then
      !symbol2 = 'M'
    else
      !symbol2 = ' '
    endif
    -- Third letter is X if element is primary and claimed from this extract
    if( !element.exclfr and !element.userClaim ne !currentUser ) then
      !symbol3 = 'X'
    else
      !symbol3 = ' '
    endif
    -- First letter is E if element is primary and claimed to this extract
    !symbol  = 'E' + !symbol2 + !symbol3 + ' '
    !listDtext.append(!symbol + !element.flnn)
  enddo
  !this.list.dtext = !listDtext
  !this.list.rtext = !listRtext

  -- update page number
  !pageTotal  = int( (!listSize - 1) / !pageSize ) + 1
  !pageNumber = int( ( !startAt - 1) / !pageSize ) + 1
  !this.pageNumber.val = 'Page ' + !pageNumber.string() + ' of ' + !pageTotal.string()

endmethod
-- End of method definition for .page()
------------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description: Navigate to selected element from the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigate()

--  !!ce = !this.members.selection('RTEXT').dbref()
  !!ce = !this.list.selection('RTEXT').dbref()

  !nav = !this.list.selection('RTEXT')
  !!admextractcntrol.list.select('RTEXT',!nav)
  handle any
    -- if element on the form is deleted then keep same CE
  endhandle

endmethod
-- End of method definition for .navigate()
