--
--
-- Description:
-- Construction Aid Main Form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidConstructs()                  -                   Constructor
--  constructRepeat(MENU,STRING)     -                   Allow construct action to be recursive
--  initialise()                     -                   Initialise the form
--  load()                           -                   Load graphics from file
--  save()                           -                   Save graphics to file
--  setupForm()                      -                   Setup form to current settings
--
------------------------------------------------------------------------

setup form !!aidConstructs size 46 0
Import 'pmlfilebrowser'
handle any
endhandle

  !!aidConstructs.formTitle     = '3D Aid Constructs'
  !!aidConstructs.iconTitle     = ''
  !!aidConstructs.callback      = '!this.initialise()'
  !!aidConstructs.formRevision  = ' $Revision: 1.14 $ '

  -- Body of form definition
  bar
  exit

  -- Form members

exit
-- End of form definition for !!aidConstructs

------------------------------------------------------------------------
--
-- Method:      aidConstructs
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidConstructs()

  -- Load aid constructors, if they haven't already been loaded
  if(undefined(!!aidConstructors)) then
    !aidConstructors = object AIDCONSTRUCTORS()
    !aidConstructors.globalInstance()
  endif

  -- Load aid list form
  if(undefined(!!aidItemList)) then
    pml load form !!aidItemList
  endif

  -- Define Bar Menu
  !bar  = !this.bar
    !bar.add('Control',       'controlMenu')
    !bar.add('Settings',      'settingsMenu')
    !bar.add('Create',        'createMenu')
    !bar.add('Modify',        'modifyMenu')
    !bar.add('Delete',        'deleteMenu')

  -- Control Menu
  !menu = !this.newMenu('controlMenu')
    !menu.add('CALLBACK', 'List...', 'show !!aidItemList')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Save...', '!this.save()')
    !menu.add('CALLBACK', 'Load...', 'call !!fileBrowser(|%PDMSUSER%|, ''*.pmldat'', ''Load Construction Graphics'', true, ''!!aidItemList.load()'')')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Close',   '!this.hide()')

  -- Picktype setting Menu
  !menu = !this.newMenu('settingsMenu')
    !menu.add('TOGGLE',   'Repeat',             '!this.constructRepeat(')
    !menu.add('CALLBACK', 'Size...',            'show !!aidBlobSize')

  -- Constructor Menu
  !menu = !this.newMenu('createMenu')
    !menu.add('MENU',    'Copy',                'copyMenu')
    !menu.add('MENU',    'Circle',              'circleMenu')
    !menu.add('MENU',    'Line',                'lineMenu')
    !menu.add('MENU',    'Work Point',          'wpMenu')
    !menu.add('MENU',    'Plane',               'planeMenu')
    !menu.add('MENU',    'Grids',               'gridMenu')

    -- Circle Constructors
    !menu = !this.newMenu('circleMenu')
      !menu.add('CALLBACK','Toolbar...',                            'show !!edgTBarCircles')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Through 3 points',                     '!!edgCntrl.add(!!aidConstructors.circlePacket(''3pnt''))')
      !menu.add('CALLBACK', 'Fillet...',                            '!!edgCntrl.add(!!aidConstructors.circlePacket(''fillet''))')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Point to tangent',                     '!!edgCntrl.add(!!aidConstructors.circlePacket(''pnttan''))')
      !menu.add('CALLBACK', 'Point to tangent, radius <val>...',    '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixedradiuspnttan''))')
      !menu.add('CALLBACK', 'Tangent to 2 points, radius <val>...', '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixedradiuspntpnt''))')
      !menu.add('CALLBACK', 'Tangent to tangent...',                '!!edgCntrl.add(!!aidConstructors.circlePacket(''tantan''))')
      !menu.add('CALLBACK', 'Tangential to 3 lines',                '!!edgCntrl.add(!!aidConstructors.circlePacket(''tan3lines''))')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Diameter 3 points',                    '!!edgCntrl.add(!!aidConstructors.circlePacket(''diameter3d''))')
      !menu.add('CALLBACK', 'Diameter <val> 3 points...',           '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixeddiameter3d''))')
      !menu.add('CALLBACK', 'Diameter 2 points',                    '!!edgCntrl.add(!!aidConstructors.circlePacket(''diameter2d''))')
      !menu.add('CALLBACK', 'Diameter <val> centre...',             '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixeddiameter2d''))')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Radius 3 points',                      '!!edgCntrl.add(!!aidConstructors.circlePacket(''radius3d''))')
      !menu.add('CALLBACK', 'Radius <val> 3 points...',             '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixedradius3d''))')
      !menu.add('CALLBACK', 'Radius 2 points',                      '!!edgCntrl.add(!!aidConstructors.circlePacket(''radius2d''))')
      !menu.add('CALLBACK', 'Radius <val> centre...',               '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixedradius2d''))')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Derive',                               '!!edgCntrl.add(!!aidConstructors.circlePacket(''derive''))')
      !menu.add('CALLBACK', 'Explicit...',                          '!!aidConstructors.explicit(''CIRCLE'')')

    -- Line Constructors
    !menu = !this.newMenu('lineMenu')
      !menu.add('CALLBACK', 'Toolbar...',            'show !!edgTBarLines')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Between 2 points',      '!!edgCntrl.add(!!aidConstructors.linePacket(''pntpnt''))')
      !menu.add('CALLBACK', 'Angle from line...',    '!!edgCntrl.add(!!aidConstructors.linePacket(''angle''))')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Two planes',            '!!edgCntrl.add(!!aidConstructors.linePacket(''twoplanes''))')
      !menu.add('CALLBACK', 'Bisect two lines',      '!!edgCntrl.add(!!aidConstructors.linePacket(''bisect''))')
      !menu.add('CALLBACK', 'Point to tangent',      '!!edgCntrl.add(!!aidConstructors.linePacket(''pnttan''))')
      !menu.add('CALLBACK', 'Tangent to tangent',    '!!edgCntrl.add(!!aidConstructors.linePacket(''tantan''))')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Derive',                '!!edgCntrl.add(!!aidConstructors.linePacket(''derive''))')
      !menu.add('CALLBACK', 'Explicit...',           '!!aidConstructors.explicit(''LINE'')')

    -- Working Point Constructors
    !menu = !this.newMenu('wpMenu')
      !menu.add('CALLBACK', 'Toolbar...',            'show !!edgTBarPoints')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Derived position',      '!!edgCntrl.add(!!aidConstructors.pointPacket(''pnt''))')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Explicit...',           '!!aidConstructors.explicit(''POINT'')')

    -- Plane Constructors
    !menu = !this.newMenu('planeMenu')
      !menu.add('CALLBACK', 'Toolbar...',            'show !!edgTBarPlanes')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Through 3 points',      '!!edgCntrl.add(!!aidConstructors.planePacket(''3pnts''))')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Explicit...',           '!!aidConstructors.explicit(''PLANE'')')

    -- Grid Constructors
    !menu = !this.newMenu('gridMenu')
      !menu.add('CALLBACK','Toolbar...',            'show !!edgTBarGrids')
      !menu.add('separator')
      !menu.add('CALLBACK', 'Linear...',            '!!edgCntrl.add(!!aidConstructors.linearGridPacket(object GPHLINEARGRID()))')
      !menu.add('CALLBACK', 'Radial...',            '!!edgCntrl.add(!!aidConstructors.radialGridPacket(object GPHRADIALGRID()))')
      !menu.add('CALLBACK', 'Plant...',             '!!edgCntrl.add(!!aidConstructors.plantGridPacket(object GPHPLANTGRID()))')

  -- Modify Constructors
  !menu = !this.newMenu('modifyMenu')
    !menu.add('MENU',     'Move',          'moveMenu')
    !menu.add('CALLBACK', 'Cut',           '!!edgCntrl.add(!!aidConstructors.deletePacket())')
    !menu.add('CALLBACK', 'Copy',          '!!edgCntrl.add(!!aidConstructors.copyPacket())')
    !menu.add('CALLBACK', 'Paste...',      '!!edgCntrl.add(!!aidConstructors.pastePacket())')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Toolbar...',          'show !!edgTBarModify')
    !menu.add('CALLBACK', 'Definition...',       '!!edgCntrl.add(!!aidConstructors.editPacket())')
    !menu.add('CALLBACK', 'Position',            '!!edgCntrl.add(!!aidConstructors.modifyPacket(''position''))')
    !menu.add('CALLBACK', 'Radius',              '!!edgCntrl.add(!!aidConstructors.modifyPacket(''radius''))')
    !menu.add('CALLBACK', 'Extend',              '!!edgCntrl.add(!!aidConstructors.modifyPacket(''length''))')
    !menu.add('CALLBACK', 'Project onto Plane', '!!edgCntrl.add(!!aidConstructors.orientatePacket(''workingPlane''))')

  -- Delete Constructors
  !menu = !this.newMenu('deleteMenu')
    !menu.add('CALLBACK', 'Pick',           '!!edgCntrl.add(!!aidConstructors.deletePacket())')
    !menu.add('CALLBACK', 'All Constructs', '!!aidConstructors.remove()')

  -- Copy Constructors
  !menu = !this.newMenu('copyMenu')
    !menu.add('CALLBACK', 'Offset...',           'show !!aidCopyOffset
!!aidCopyOffset.option(|COPY|)')
    !menu.add('CALLBACK', 'Rotate...',           'show !!aidCopyRotate
!!aidCopyRotate.option(|COPY|)')
    !menu.add('CALLBACK', 'Mirror...',           'show !!aidCopyMirror
!!aidCopyMirror.option(|COPY|)')

  -- Move Constructors
  !menu = !this.newMenu('moveMenu')
    !menu.add('CALLBACK', 'Offset...',           'show !!aidCopyOffset
!!aidCopyOffset.option(|MOVE|)')
    !menu.add('CALLBACK', 'Rotate...',           'show !!aidCopyRotate
!!aidCopyRotate.option(|MOVE|)')
    !menu.add('CALLBACK', 'Mirror...',           'show !!aidCopyMirror
!!aidCopyMirror.option(|MOVE|)')

endmethod
-- End of method definition for .aidConstructs()

------------------------------------------------------------------------
--
-- Method:     initialise
--
-- Description:
--   Initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables

  -- Setup form
  !this.setupForm()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description:
--   Setup form to current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupForm()

  -- Initialise Variables

  -- Modify Menu Settings
  !menu = !this.modifyMenu
  !menu.setActive('Project onto Plane', !!edgPosCntrl.activePlane)

  -- Settings Menu Settings
  !menu = !this.settingsMenu
  !menu.select('Repeat',             !!aidConstructors.recursive)

endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:     save
--
-- Description:
--   Save graphics to file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .save()

  Using Namespace 'Aveva.Pdms.Presentation'
  !browser = object PMLFILEBROWSER('save')

  !browser.show('%PDMSUSER%', '*.pmldat', 'Save Construction Graphics', false, 'PMLDAT Files (*.pmldat)|*.pmldat',1)
  -- Initialise Variables
  !file     = !!file(!browser.file())

  -- Load file into aid constructor system
  if(!file.set()) then
    !!aidConstructors.save(!file)
  endif

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:     load
--
-- Description:
--   Load graphics from file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .load()

  -- Initialise Variables
  !file     = !!fileBrowser.file

  -- Load file into aid constructor system
  !!aidConstructors.load(!file)

  -- Update list
  !this.selectType()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      constructRepeat
--
-- Description:
--   Allow construct action to be recursive
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Form bar menu selected from
--    2   R      STRING      Select state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .constructRepeat(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  if(!selected eq 'SELECT') then
    !flag = true
  else
    !flag = false
  endif

  -- Set recursion flag for constructors
  !!aidConstructors.recursion(!flag)

endmethod
-- End of method definition for .constructRepeat(MENU, STRING)
