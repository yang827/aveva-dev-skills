--
-- File:            alertonceconfirm.pmlfrm
--   Type:          Form Definition
--   Group:         Alerts
--
--     Keyword:     CONFIRM
--   Module:        ALL
--   Replaces:
--
-- Description:
-- Form to switch off confirmation if requested
--
--  Created:         Wed Mar 25 16:22:43 2009
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  alertOnceConfirm()               -                   Constructor
--  caption(STRING)                  -                   close form
--  close()                          -                   close form
--  confirm(STRING)                  -                   Set the confirm flag for continuing or stopping
--  dontAskMe()                      -                   Method to set the global switch from the toggle
--  initialise()                     -                   initialise
--  result()                         STRING              close form
--  showAgain()                      BOOLEAN             Return true to show again, false to not show again
--
------------------------------------------------------------------------
setup form !!alertOnceConfirm  blocking

member .confirm      is BOOLEAN
member .default      is STRING
   -- Using .globalSwitch returning result is maintained for backwards compatibility
   -- but not recommended. Use method .showAgain() instead
member .globalSwitch is STRING

para .icon pixmap

para .question at xmax.icon+3 ymin+0.5 text ' ' width 22 lines 3
toggle .dontAskMeAgain at x2 ymax |Don't ask me again to confirm this action| tagwidth 26
-- OK and Cancel are not working in blocking forms
button .yes at x0 ymax+0.2   '  Yes  '

button .no at xmax form-size   '  No   '

exit
-- End of form definition for !!alertOnceConfirm
------------------------------------------------------------------------
--
-- Method:      alertOnceConfirm()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .alertOnceConfirm()

-- form setup
   !this.formTitle               = 'Confirm'
   !this.iconTitle               = 'Confirm'
   !this.cancelCall              = '!this.close()'
   !this.callback                = '!this.initialise()'
   !this.icon.addPixmap(!!pml.getPathname('qm35.png'))


   !this.yes.callback            = '!this.confirm(|YES|)'
   !this.no.callback             = '!this.confirm(|NO|)'
   !this.confirm                 = FALSE
   !this.dontAskMeAgain.callback = '!this.dontAskMe()'
   !this.default                 = 'YES'
   -- This method of returning result is maintained for backwards compatibility
   -- but not recommended. Use method .showAgain() instead
   -- This is set by the calling function/method
   !this.globalSwitch            = ''

endmethod
-- End of method definition for .alertOnceConfirm()
------------------------------------------------------------------------
--
-- Method:      initialise()
--
-- Description: initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !this.attribute(!this.default).setFocus()

  -- This method of returning result is maintained for backwards compatibility
  -- but not recommended. Use method .showAgain() instead
  -- check to see if  gvar is string or the gvar in total
  if( !this.globalSwitch.empty().not() ) then
    if(!this.globalSwitch.match('!').eq(0)) then
       !gvar = '!!' + !this.globalSwitch
    else
       !gvar = !this.globalSwitch
    endif
    -- set the global variable so this form is not shown again for this gvar
    if(defined($!gvar) and $!gvar) then
       !this.dontAskMeAgain.val = TRUE
    else
       !this.dontAskMeAgain.val = FALSE
    endif
  else
    -- the new method is to force the calling code to remember whether the
    -- user wants confirmation to be displayed
    !this.dontAskMeAgain.val    = false
  endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:     caption
--
-- Description: close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .caption( !caption is STRING)

  !this.question.val = !caption

endmethod
-- End of method definition for showAgain()

------------------------------------------------------------------------
--
-- Method:     showAgain
--
-- Description: Return true to show again, false to not show again
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true to show again, false to not show again
--
------------------------------------------------------------------------
define method .showAgain() is BOOLEAN

  return !this.dontAskMeAgain.val.not()

endmethod
-- End of method definition for showAgain()

------------------------------------------------------------------------
--
-- Method:     result
--
-- Description: close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true to show again. false to not show again
--
------------------------------------------------------------------------
define method .result() is STRING

  if( !this.confirm ) then
    return 'YES'
  else
    return 'NO'
  endif

endmethod
-- End of method definition for result()

------------------------------------------------------------------------
--
-- Method:     confirm
--
-- Description: Set the confirm flag for continuing or stopping
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Confirmation YES or NO]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .confirm(!yesOrNo is STRING)

  if(!yesOrNo.eq('YES')) then
   !this.confirm = TRUE
  else
   !this.confirm = FALSE
  endif

  !this.close()

endmethod
-- End of method definition for confirm()
------------------------------------------------------------------------
--
-- Method:     dontAskMe
--
-- Description: Method to set the global switch from the toggle
-- =========================================================================
-- This method of returning result is maintained for backwards compatibility
-- but not recommended. Use method .showAgain() instead
-- =========================================================================
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dontAskMe()

  if( !this.globalSwitch.empty() ) then
    return
  endif

-- check to see if passed as a gvar string or the gvar in total
   if(!this.globalSwitch.match('!').eq(0)) then
      !gvar = '!!' + !this.globalSwitch
   else
      !gvar = !this.globalSwitch
   endif
-- set the global variable, so as not to show this form again
   if(!this.dontAskMeAgain.val) then
      $!gvar = TRUE
   else
      $!gvar = FALSE
   endif

endmethod
-- End of method definition for dontAskMe()
------------------------------------------------------------------------
--
-- Method:     close
--
-- Description: close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

!this.hide()

endmethod
-- End of method definition for close()
