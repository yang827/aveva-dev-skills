-- File:            aspcompcmd.pmlfrm
--   Type:          Form Definition
--   Group:         Aspect Comparator external call command form
--     Keyword:     COMPARATOR
--   Module:        design
--   Replaces:
--
-- Author:          P.Forrest
-- Created:         Mon Sep 19 19:25:13 GMT 2001
--
-- Description:
-- Form for an external call for Comparator.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aspCompCmd()                     -                   Constructor
--  event(REAL,STRING)               -                   External command
--  firstShow()                      -
--  limitsCe(FORM)                   -                   Method to set limits_ce
--  limitsDrawlist(FORM)             -                   Method to auto limits the drawlist if it has one.
--  limitsReflist(FORM,ARRAY)        -                   Method to auto limits the list if it has one.
--  rotateCe(FORM)                   -                   Method to set rotate origin
--  rotatePos(FORM,POSITION)         -                   Method to set rotate origin
--
------------------------------------------------------------------------
setup form !!aspCompCmd

-- dummy string to size the form
 !this.formTitle =  '3DMM Command Line Interface for project XXX XXXX-XXXXX         '

exit
-- End of form definition for !!aspCompCmd

------------------------------------------------------------------------
--
-- Method:      aspCompCmd()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .aspCompCmd()

 !project = current project
 !code    = !project.code()
 var !uniqueId UNIQUE

 !this.formTitle =  '3DMM Command Line Interface for project ' & !code & ' ' & !uniqueId
  !this.firstShownCall = '!!aspCompCmd.firstShow()'
  !this.externalCall   = '!!aspCompCmd.event('

endmethod
-- End of method definition for .aspCompCmd()
------------------------------------------------------------------------
--
-- Method:     firstShow
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [REAL]      [Integer needed for external call]
--   [2] [R]    [STRING]    [Macro name and argument list to run]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .firstShow()

  -- This form should remain invisible so does not want to appear in the windows menu
  !this.hide()

endmethod
-- End of method definition for .firstShow()
------------------------------------------------------------------------
--
-- Method:     event
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [REAL]      [Integer needed for external call]
--   [2] [R]    [STRING]    [Macro name and argument list to run]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .event(!dummy is REAL, !command is STRING)

 -- Run the passed command
 $!command

endmethod
-- End of method definition for .event()
------------------------------------------------------------------------
--
-- Method:      limitsDrawlist
--
-- Description: Method to auto limits the drawlist if it has one.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [FORM]      [Graphics form to update]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .limitsDrawlist(!form is FORM)

  !view = !form.view

  VAR !collection COLLECT ALL FROM DRAWLIST

  if(!collection.empty()) then
    return
  endif

  !block    = object BLOCK('!collection[!evalIndex].dbref()')
  !list     = !collection.evaluate(!block)
  !volume   = object VOLUME(!list)

-- test for error setting the volume
  !unusedVolTest = !volume.from.set()
  handle ANY
    return
  endhandle

  if(!volume.from.set().not()) then
     return
  endif

  if(!volume.from.distance(!volume.to).eq(0)) then
   return
  endif

  !!gphViews.limits(!view, !volume)

endmethod
-- End of method definition for .limitsDrawlist(!form)
------------------------------------------------------------------------
--
-- Method:      limitsCe
--
-- Description: Method to set limits_ce
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [FORM]      [Graphics form to update]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .limitsCe(!form is FORM)
  if (!!ce.type eq 'WORL') then
     return
  endif
  !view = !form.view
  !volume   = object VOLUME(!!ce)
  if (!volume.from.set().not()) then
     return
  endif
  if(!volume.from.distance(!volume.to).eq(0)) then
   return
  endif
  !!gphViews.limits(!view, !volume)
endmethod
-- End of method definition for .limitsCe(!form)
------------------------------------------------------------------------
--
-- Method:      rotateCe
--
-- Description: Method to set rotate origin
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [FORM]      [Graphics form to update]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .rotateCe(!form is FORM)
  !view = !form.view
  if (!!ce.type eq 'WORL') then
     return
  endif
  !volume   = object VOLUME(!!ce)
  if (!volume.from.set().not()) then
     return
  endif
  if(!volume.from.distance(!volume.to).eq(0)) then
   return
  endif
  !pos = !volume.from.midpoint(!volume.to)
  !!gphViews.rotate(!view, !pos)
endmethod
-- End of method definition for .rotateCe(!form)
------------------------------------------------------------------------
--
-- Method:      rotatePos
--
-- Description: Method to set rotate origin
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [FORM]      [Graphics form to update]
--   [2] [R]    [POSITION]  [Position to rotate]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .rotatePos(!form is FORM, !pos is POSITION)
  !view = !form.view
  !!gphViews.rotate(!view, !pos)
endmethod
-- End of method definition for .rotatePos(!form,!pos)
------------------------------------------------------------------------
--
-- Method:      limitsReflist
--
-- Description: Method to auto limits the list if it has one.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [FORM]      [Graphics form to update]
--   [2] [R]    [ARRAY]     [List of elements to limit]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .limitsReflist(!form is FORM, !list is ARRAY)

  !view = !form.view

  if(!list.empty()) then
    return
  endif

  !volume   = object VOLUME(!list)
  if (!volume.from.set().not()) then
     return
  endif

  if(!volume.from.distance(!volume.to).eq(0)) then
   return
  endif

  !!gphViews.limits(!view, !volume)

endmethod
-- End of method definition for .limitsReflist(!form, !list)
