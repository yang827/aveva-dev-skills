--
--  Description:     --   Manage Association worlds and groups.--   This is a general association management tool. Specific applications--   may need to provide their own association manager.--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyGroup()                     -                   Save changes to group attributes
--  applyWorld()                     -                   Save changes to world attributes
--  assBrowser()                     -                   Constructor
--  assGroup()                       DBREF               Returns currently selected ASSOGP
--  assWorld()                       DBREF               Returns currently selected ASSOWL
--  chkName(GADGET,STRING)           -                   Name callback. Check name of element
--  createAssGroup()                 -                   Create Association group
--  createAssWorld()                 -                   Create Association world
--  deleteAssGroup()                 -                   Perform delete action for selected element
--  deleteAssWorld()                 -                   Perform delete action for selected element
--  exploreGroups(DBREF)             -                   Locate ASSOGP from current element
--  exploreWorlds(DBREF)             -                   Locate ASSOWL from current element
--  initialise()                     -                   Track db changes.
--  loadAssGroupAttributes()         -                   Load Association group attributes
--  loadAssGroups()                  -                   Load Association Groups for the current world
--  loadAssWorldAttributes()         -                   Load Association world attributes
--  loadAssWorlds()                  -                   Load Association worlds list
--  modifyAssGroup()                 -                   Modify Association group attributes
--  modifyAssWorld()                 -                   Modify Association world attributes
--  popupAssGroup(ARRAY)             -                   Pop-up callback for ASSOGP
--  popupAssWorld(ARRAY)             -                   Pop-up callback for ASSOWL
--  popupMenus()                     -                   Setup popup menus
--  reloadAssGroups()                -                   Reload ASSOGP list
--  reloadAssGroups(DBREF)           -                   Reload ASSOGP into the system
--  reloadAssWorlds()                -                   Reload ASSOWL list
--  reloadAssWorlds(DBREF)           -                   Reload ASSOWL into the system
--  selectAssGroup(ARRAY)            -                   Select ASSOGP from grid
--  selectAssWorld(ARRAY)            -                   Select ASSOWL from grid
--  validateName(GADGET,STRING)      -                   Validate name field
--
------------------------------------------------------------------------
--
-- Description:
--   Manage Association worlds and groups.
--   This is a general association management tool. Specific applications
--   may need to provide their own association manager.
--
------------------------------------------------------------------------
--

import 'GridControl'
handle any
endhandle

setup form !!assBrowser dialog docking right

  -- Tracking
  --track 'DBCHANGED' call '!this.track()'

  !this.formTitle     = 'Organise Association Store'
  !this.iconTitle     = 'AssStore'
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = ''

  -- PML Container to host grid control for Association worlds
  frame .assWorldFrame panel                                        anchor all                    at x0.5  ymax   height 16 width 48
    container .conAssWorlds PMLNetCONTROL 'NET' dock fill
  exit

  frame .assGroupFrame panel                                        anchor all                    at x0.5  ymin   height 16 width 48
    container .conAssGroups PMLNetCONTROL 'NET' dock fill
  exit

  frame .assWorldTaskFrame panel                                     anchor left + bottom          at x0.5  ymax
    button .butWorldCreate   linkLabel  'Create Association World'   anchor left + bottom          at xmin  ymax     callback '!this.createAssWorld()'
    button .butWorldModify   linkLabel  'Modify Association World'   anchor left + bottom          at xmin  ymax     callback '!this.modifyAssWorld()'
    button .butWorldDelete   linkLabel  'Delete Association World'   anchor left + bottom          at xmin  ymax+0.5 callback '!this.deleteAssWorld()'
    button .butWorldGroups   linkLabel  'Show Association Groups'    anchor left + bottom          at xmin  ymax+0.5 callback '!this.loadAssGroups()'
  exit

  frame .assWorldAttrFrame panel                                     anchor left + bottom + right  at x0.5  ymin
    text   .worldName                   'Name'                       anchor left + bottom + right  at xmin  ymax+0.2 callback '!this.chkName('  tagwidth 12 width 30 is STRING
    path down
    text   .worldPurpose                'Purpose'                    anchor left + bottom + right                                tagwidth 12 width 6  is STRING
    text   .worldDescription            'Description'                anchor left + bottom + right                                tagwidth 12 width 30 is STRING
    text   .worldFunction               'Function'                   anchor left + bottom + right                                tagwidth 12 width 30 is STRING
    button .worldBack                   'Back'                       anchor left + bottom          at x0.5  ymax+0.2 callback '!this.loadAssWorlds()'
    button .worldApply                  'Apply Changes'              anchor        bottom + right  at xmax.worldFunction-size  ymin   callback '!this.applyWorld()'
  exit

  frame .assGroupTaskFrame panel                                     anchor left + bottom          at x0.5  ymin
    button .butGroupCreate   linkLabel  'Create Association Group'   anchor left + bottom          at xmin  ymax     callback '!this.createAssGroup()'
    button .butGroupModify   linkLabel  'Modify Association Group'   anchor left + bottom          at xmin  ymax     callback '!this.modifyAssGroup()'
    button .butGroupDelete   linkLabel  'Delete Association Group'   anchor left + bottom          at xmin  ymax+0.5 callback '!this.deleteAssGroup()'
    button .butGroupBack     linkLabel  'Back to Association Worlds' anchor left + bottom          at xmin  ymax+0.5 callback '!this.loadAssWorlds()'
  exit

  frame .assGroupAttrFrame panel                                     anchor left + bottom + right  at x0.5  ymin
    text   .groupName                   'Name'                       anchor left + bottom + right  at xmin  ymax+0.2 callback '!this.chkName('  tagwidth 12 width 30 is STRING
    path down
    text   .groupPurpose                'Purpose'                    anchor left + bottom + right                                tagwidth 12 width 6  is STRING
    text   .groupDescription            'Description'                anchor left + bottom + right                                tagwidth 12 width 30 is STRING
    text   .groupFunction               'Function'                   anchor left + bottom + right                                tagwidth 12 width 30 is STRING
    button .groupBack                   'Back'                       anchor left + bottom          at x0.5  ymax+0.2 callback '!this.loadAssGroups()'
    button .groupApply                  'Apply Changes'              anchor        bottom + right  at xmax.worldFunction-size  ymin   callback '!this.applyGroup()'
  exit

  -- Form members

  -- Current active elements
  member .currentElement      is DBREF
  member .assWorld            is DBREF
  member .assGroup            is DBREF
  member .assGroupOwner       is DBREF

  -- Current Active Panel
  member .currentPanel        is GADGET

  -- Grid data
  member .assWorldCollection  is COLLECTION
  member .assWorldAttributes  is ARRAY
  member .assGroupCollection  is COLLECTION
  member .assGroupAttributes  is ARRAY

  -- Aid text
  member .aidNumber           is REAL

  -- Grid control
  using namespace 'Aveva.Pdms.Presentation'
  member .assWorldGrid        is NetGridControl
  member .assGroupGrid        is NetGridControl

  -- save name of element to restore if illegal name entered
  member .savedName           is STRING

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      assBrowser
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .assBrowser()

  -- Aid number
  !this.aidNumber = !!aidNumbers.add('Association Browser')

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('Name')
  !attributes.append('Purpose')
  !attributes.append('Description')
  !attributes.append('Function')
  !attributes.append('DBNAME')

  -- Collection definitions
  !this.assWorldCollection      = object COLLECTION()
  !this.assWorldCollection.addType('ASSOWL')
  !this.assWorldAttributes      = !attributes

  -- Attributes
  !attributes     = ARRAY()
  !attributes.append('Name')
  !attributes.append('Purpose')
  !attributes.append('Description')
  !attributes.append('Function')

  !this.assGroupCollection      = object COLLECTION()
  !this.assGroupCollection.addType('ASSOGP')
  !this.assGroupAttributes      = !attributes

  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- Add .Net control to PML container for Association Worlds
  !this.assWorldGrid            = object netGridControl()
  !this.conAssWorlds.control    = !this.assWorldGrid.handle()

  -- Events handled
  !this.assWorldGrid.addEventHandler('onPopup',           !this, 'popupAssWorld')
  !this.assWorldGrid.addEventHandler('afterSelectChange', !this, 'selectAssWorld')

  -- Add .Net control to PML container for Association Groups
  !this.assGroupGrid            = object netGridControl()
  !this.conAssGroups.control    = !this.assGroupGrid.handle()
  !this.assGroupGrid.addEventHandler('onPopup',           !this, 'popupAssGroup')
  !this.assGroupGrid.addEventHandler('afterSelectChange', !this, 'selectAssGroup')

  -- Set Active Panel
  !this.currentPanel              = !this.assWorldFrame
  !this.assWorldFrame.visible     = true
  !this.assGroupFrame.visible     = false
  !this.assWorldTaskFrame.visible = true
  !this.assGroupTaskFrame.visible = false
  !this.assWorldAttrFrame.visible = false
  !this.assGroupAttrFrame.visible = false

  -- Setup popup-menus
  !this.popupMenus()

  -- Validate names
  !this.worldName.validateCall = '!this.validateName('
  !this.groupName.validateCall = '!this.validateName('

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      popupMenus
--
-- Description: Setup popup menus
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .popupMenus()

  -- Initialise Variables

  -- Popup Menus for assWorld Grid
  !popup = !this.newMenu('popupAssWorld')
  !popup.add('callback', 'Create',            '!this.createAssWorld()',   'assowlCreate')
  !popup.add('callback', 'Modify',            '!this.modifyAssWorld()',   'assowlModify')
  !popup.add('separator')
  !popup.add('callback', 'Delete',            '!this.deleteAssWorld()',           'assowlDelete')
  !popup.add('separator')
  !popup.add('callback', 'Show Groups',       '!this.loadAssGroups()',    'assowlShowGroups')
  !popup.add('separator')
  !popup.add('callback', 'Navigate to',       '!!ce = !this.assWorld',    'assowlNavigateTo')
  !popup.add('callback', 'Locate from Explorer',  '!this.exploreWorlds(!!ce)',  'assowlCE')
  !this.conAssWorlds.popup   = !popup

  -- Popup Menu for assGroup Grid
  !popup = !this.newMenu('popupAssGroup')
  !popup.add('callback', 'Create',            '!this.createAssGroup()',   'assogpCreate')
  !popup.add('callback', 'Modify',            '!this.modifyAssGroup()',   'assogpModify')
  !popup.add('separator')
  !popup.add('callback', 'Delete',            '!this.deleteAssGroup()',           'assogpDelete')
  !popup.add('separator')
  !popup.add('callback', 'Navigate to',    '!!ce = !this.assGroup',       'assogpNavigateTo')
  !popup.add('callback', 'Locate from Explorer',  '!this.exploreGroups(!!ce)', 'assogpCE')
  !this.conAssGroups.popup   = !popup

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Track db changes.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Load Data grid with elements
  !this.loadAssWorlds()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reloadAssWorlds
--
-- Description: Reload ASSOWL list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reloadAssWorlds()

  !this.assWorld  = object DBREF()
  !this.loadAssWorlds()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reloadAssWorlds
--
-- Description: Reload ASSOWL into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       ASSOWL element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reloadAssWorlds(!element is DBREF)

  -- Check ASSOWL has been passed
  if(!element.hardtype.neq('ASSOWL')) then
    return
  endif

  -- Initialise Variables
  !this.assWorld  = !element
  !this.loadAssWorlds()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reloadAssGroups
--
-- Description: Reload ASSOGP list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reloadAssGroups()

  !this.assGroup  = object DBREF()
  !this.loadAssGroups()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      reloadAssGroups
--
-- Description: Reload ASSOGP into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       ASSOGP element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reloadAssGroups(!element is DBREF)

  -- Check ASSOGP has been passed
  if(!element.hardtype.neq('ASSOGP')) then
    return
  endif

  -- Initialise Variables
  !this.assWorld  = !element.owner
  !this.assGroup  = !element
  !this.loadAssGroups()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadAssWorlds
--
-- Description: Load Association worlds list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadAssWorlds()

  -- Initialise Variables
  !this.currentPanel.visible      = false
  !this.currentPanel              = !this.assWorldFrame
  !this.assWorldFrame.visible     = true
  !this.assGroupFrame.visible     = false
  !this.assWorldTaskFrame.visible = true
  !this.assGroupTaskFrame.visible = false
  !this.assWorldAttrFrame.visible = false
  !this.assGroupAttrFrame.visible = false
  !this.butWorldGroups.active     = true
  !this.butWorldModify.active     = true
  !this.butWorldDelete.active     = true

  -- Get all ASSOWL
  !myCollection         = !this.assWorldCollection.results()
  !block                = object BLOCK('!myCollection[!evalIndex].string()')
  !dbNames              = !myCollection.evaluate(!block)

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds                  = object NetDataSource('AssWorld', !this.assWorldAttributes, !dbNames)
  !this.assWorldGrid.bindToDataSource(!nds)

  if( !myCollection.empty() ) then
    !this.assWorld = object DBREF()
    !this.butWorldGroups.active = false
    !this.butWorldModify.active = false
    !this.butWorldDelete.active = false
    return
  endif

  -- Select current ASSOWL or first if its empty
  if( badref(!this.assWorld) ) then
    !this.assWorldGrid.selectRow(1)
    handle ANY
      !this.assWorld  = object DBREF()
    elsehandle none
      !this.assWorld  = !myCollection[1]
    endhandle
  else
    !elementList[1]     = !this.assWorld.string()
    !this.assWorldGrid.setSelectedRowTags(!elementList)
    handle ANY
      !this.assWorldGrid.selectRow(1)
      handle ANY
      endhandle
      !this.assWorld = object DBREF()
    endhandle
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadAssWorldAttributes
--
-- Description: Load Association world attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadAssWorldAttributes()

  -- Initialise Variables
  !this.currentPanel.visible      = false
  !this.currentPanel              = !this.assWorldAttrFrame
  !this.assWorldFrame.visible     = true
  !this.assGroupFrame.visible     = false
  !this.assWorldTaskFrame.visible = false
  !this.assGroupTaskFrame.visible = false
  !this.assWorldAttrFrame.visible = true
  !this.assGroupAttrFrame.visible = false

  if( badref(!this.assWorld) ) then
    return
  else
    if( !this.assWorld.isNamed ) then
      !this.worldName.val        = !this.assWorld.namn
    else
      !this.worldName.val        = ''
    endif
    !this.worldPurpose.val     = !this.assWorld.purpose
    !this.worldDescription.val = !this.assWorld.description
    !this.worldFunction.val    = !this.assWorld.function
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyAssWorld
--
-- Description: Modify Association world attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyAssWorld()

  if( badref(!this.assWorld) ) then
    return
  endif

  !this.loadAssWorldAttributes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modifyAssGroup
--
-- Description: Modify Association group attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyAssGroup()

  if( badref(!this.assGroup) ) then
    return
  endif

  !this.loadAssGroupAttributes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createAssWorld
--
-- Description: Create Association world
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createAssWorld()

  !saveRef = !!ce
  -- create new group after the current group
  if( badref( !this.assWorld ) ) then
    -- create as first element under the current World
    NEW ASSOWL
    handle any
      !!alert.error( !!error.text )
      !!ce = saveRef
      return
    endhandle
  else
    -- create after current world
    !!ce = !this.assWorld
    NEW ASSOWL
    handle any
      !!alert.error( !!error.text )
      !!ce = saveRef
      return
    endhandle
  endif

  -- make the new world the current group
  !this.assWorld = !!ce
  !this.reloadAssWorlds(!this.assWorld)

  -- restore the CE
  !!ce = !saveRef
  -- load the edit page
  !this.loadAssWorldAttributes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createAssGroup
--
-- Description: Create Association group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createAssGroup()

  !saveRef = !!ce
  !!ce     = !this.assWorld
  -- create new group after the current group
  if( badref( !this.assGroup ) ) then
    -- create as first element under the current World
    NEW ASSOGP
    handle any
      !!alert.error( !!error.text )
      !!ce = saveRef
      return
    endhandle
  else
    -- create after current group
    !currentGroup = !this.assGroup
    NEW ASSOGP AFTER $!<currentGroup>
    handle any
      !!alert.error( !!error.text )
      !!ce = saveRef
      return
    endhandle
  endif

  -- make the new group the current group
  !this.assGroup = !!ce
  !this.reloadAssGroups(!this.assGroup)

  -- restore the CE
  !!ce = !saveRef
  -- load the edit page
  !this.loadAssGroupAttributes()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadAssGroups
--
-- Description: Load Association Groups for the current world
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadAssGroups()

  -- Initialise Variables
  !this.currentPanel.visible      = false
  !this.currentPanel              = !this.assGroupFrame
  !this.assWorldFrame.visible     = false
  !this.assGroupFrame.visible     = true
  !this.assWorldTaskFrame.visible = false
  !this.assGroupTaskFrame.visible = true
  !this.assWorldAttrFrame.visible = false
  !this.assGroupAttrFrame.visible = false
  !this.butGroupModify.active     = true
  !this.butGroupDelete.active     = true

  -- Get all levels
  !this.assGroupOwner   = !this.assWorld
  !this.assGroupCollection.scope(!this.assWorld)
  !myCollection         = !this.assGroupCollection.results()
  !block                = object BLOCK('!myCollection[!evalIndex].string()')
  !dbNames              = !myCollection.evaluate(!block)

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds                  = object NetDataSource('AssWorld', !this.assGroupAttributes, !dbNames)
  !this.assGroupGrid.bindToDataSource(!nds)

  -- handle ASSOWL with no members
  if( !myCollection.empty() ) then
    !this.assGroup = object DBREF()
    !this.butGroupModify.active = false
    !this.butGroupDelete.active = false
    return
  endif

  -- Select current ASSOGP or first if its empty
  if( badref(!this.assGroup) ) then
    !this.assGroupGrid.selectRow(1)
    handle ANY
      !this.assGroup = object DBREF()
    elsehandle none
      !this.assGroup = !myCollection[1]
    endhandle
  else
    !elementList[1]  = !this.assGroup.string()
    !this.assGroupGrid.setSelectedRowTags(!elementList)
    handle ANY
      !this.assGroupGrid.selectRow(1)
      handle ANY
      endhandle
      !this.assGroup = object DBREF()
    endhandle
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadAssGroupAttributes
--
-- Description: Load Association group attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadAssGroupAttributes()

  -- Initialise Variables
  !this.currentPanel.visible      = false
  !this.currentPanel              = !this.assGroupAttrFrame
  !this.assWorldFrame.visible     = false
  !this.assGroupFrame.visible     = true
  !this.assWorldTaskFrame.visible = false
  !this.assGroupTaskFrame.visible = false
  !this.assWorldAttrFrame.visible = false
  !this.assGroupAttrFrame.visible = true

  if( badref(!this.assGroup) ) then
    return
  else
    if( !this.assGroup.isNamed ) then
      !this.groupName.val        = !this.assGroup.namn
    else
      !this.groupName.val        = ''
    endif
    !this.groupPurpose.val     = !this.assGroup.purpose
    !this.groupDescription.val = !this.assGroup.description
    !this.groupFunction.val    = !this.assGroup.function
    !this.savedName            = !this.assGroup.name
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      applyGroup
--
-- Description: Save changes to group attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyGroup()

  -- check that user can update this element
  if( not !!dbRefUpdatable(!this.assGroup) ) then
    return
  endif

  !success = true
  !name = !this.groupName.val.trim()
  if( !name.empty() ) then
    -- have to unname the element
    !saveRef = !!ce
    !!ce     = !this.assGroup
    UNNAME
    handle any
    endhandle
    !!ce = !saveRef
  else
    !name = '/' + !name
    !this.assGroup.name        = !name
    handle any
      !!alert.error(!!error.text)
      !success = false
    endhandle
  endif
  !this.assGroup.purpose     = !this.groupPurpose.val
  handle any
    !!alert.error('Purpose: ' + !!error.text)
    !success = false
  endhandle
  !this.assGroup.description = !this.groupDescription.val
  handle any
    !!alert.error('Description: ' + !!error.text)
    !success = false
  endhandle
  !this.assGroup.function    = !this.groupFunction.val
  handle any
    !!alert.error('Function: ' + !!error.text)
    !success = false
  endhandle

  if( !success ) then
    -- reload page
    !this.reloadAssGroups(!this.assGroup)
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      applyWorld
--
-- Description: Save changes to world attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyWorld()

  -- check that user can update this element
  if( not !!dbRefUpdatable(!this.assWorld) ) then
    return
  endif

  !success = true
  !name = !this.worldName.val.trim()
  if( !name.empty() ) then
    -- have to unname the element
    !saveRef = !!ce
    !!ce     = !this.assWorld
    UNNAME
    handle any
    endhandle
    !!ce = !saveRef
  else
    !name = '/' + !name
    !this.assWorld.name        = !name
    handle any
      !!alert.error(!!error.text)
      !success = false
    endhandle
  endif
  !this.assWorld.purpose     = !this.worldPurpose.val
  handle any
    !!alert.error('Purpose: ' + !!error.text)
    !success = false
  endhandle
  !this.assWorld.description = !this.worldDescription.val
  handle any
    !!alert.error('Description: ' + !!error.text)
    !success = false
  endhandle
  !this.assWorld.function    = !this.worldFunction.val
  handle any
    !!alert.error('Function: ' + !!error.text)
    !success = false
  endhandle

  if( !success ) then
    -- reload page
    !this.reloadAssWorlds(!this.assWorld)
  endif

endmethod

