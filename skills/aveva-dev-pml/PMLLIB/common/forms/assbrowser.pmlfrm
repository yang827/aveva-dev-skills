------------------------------------------------------------------------
--
-- Method:      selectAssWorld
--
-- Description: Select ASSOWL from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectAssWorld(!passedArray is ARRAY)

  -- Initialise Variable
  !elements               = !this.assWorldGrid.getSelectedRowTags()

  -- No ASSOWL selected
  if(!elements.empty().not()) then
    !this.assWorld        = !elements[1].dbref()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      selectAssGroup
--
-- Description: Select ASSOGP from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return array from selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectAssGroup(!passedArray is ARRAY)

  -- Initialise Variable
  !elements               = !this.assGroupGrid.getSelectedRowTags()

  -- No ASSOGP selected
  if(!elements.empty().not()) then
    !this.assGroup        = !elements[1].dbref()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      deleteAssWorld
--
-- Description: Perform delete action for selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteAssWorld()

  -- Delete current element
  !saveRef = !!ce
  !!ce = !this.assWorld
  handle any
    !!alert.warning('No Association World selected')
    return
  endhandle
  !!deleteCE()
  if( badref(!this.assWorld) ) then
    -- delete was successful - refresh
    !this.reloadAssWorlds()
  endif
  !!ce=!saveRef
  handle any
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      deleteAssGroup
--
-- Description: Perform delete action for selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteAssGroup()

  -- Delete current element
  !saveRef = !!ce
  !!ce = !this.assGroup
  handle any
    !!alert.warning('No Association Group selected')
    return
  endhandle
  !!deleteCE()
  if( badref(!this.assGroup) ) then
    -- delete was successful - refresh
    !this.reloadAssGroups()
  endif
  !!ce=!saveRef
  handle any
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      exploreWorlds
--
-- Description: Locate ASSOWL from current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exploreWorlds(!reference is DBREF)

  -- check to see if this element is an assowl
  if( !reference.hardtype eq 'ASSOWL' ) then
    !this.reloadAssWorlds(!reference)
    return
  endif

  -- Get owning element information
  !owningTypes  = !reference.ahList
  !owners       = !reference.ownLst

  -- Get element type from navigator
  !groupIndex = !owningTypes.findFirst('ASSOWL')

  -- Work backwards up the tree, i.e. bottom up
  if (!groupIndex.set()) then

    !element    = !owners[!groupIndex]
    !this.reloadAssWorlds(!element)

  else

    -- look for direct association membership
    !associations = !reference.dAssos
    handle any
      !associations = ARRAY()
    endhandle
    if( !associations.empty() ) then
      -- look for indirect association membership
      !associations = !reference.assos
      handle any
        !associations = ARRAY()
      endhandle
    endif
    if( !associations.empty().not() ) then
      !this.exploreWorlds(!associations[1])
    endif

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      exploreGroups
--
-- Description: Locate ASSOGP from current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exploreGroups(!reference is DBREF)

  -- check to see if this element is an assogp
  if( !reference.hardtype eq 'ASSOGP' ) then
    !this.reloadAssGroups(!reference)
    return
  endif

  -- Get owning element information
  !owningTypes  = !reference.ahList
  !owners       = !reference.ownLst

  -- Get element type from navigator
  !groupIndex = !owningTypes.findFirst('ASSOGP')

  -- Work backwards up the tree, i.e. bottom up
  if (!groupIndex.set()) then

    !element    = !owners[!groupIndex]
    !this.reloadAssGroups(!element)

  else

    -- look for direct association membership
    !associations = !reference.dAssos
    handle any
      !associations = ARRAY()
    endhandle
    if( !associations.empty() ) then
      -- look for indirect association membership
      !associations = !reference.assos
      handle any
        !associations = ARRAY()
      endhandle
    endif
    if( !associations.empty().not() ) then
      !this.exploreGroups(!associations[1])
    endif

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      chkName
--
-- Description: Name callback. Check name of element
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      gadget name (open callback)
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .chkName(!gadget is GADGET, !action is STRING)

  if( !action eq 'SELECT' ) then
    return
  endif

  -- Check name
  !name                         = !!checkName(!gadget.val, 'NEW')

  -- Update gadget with name
  if(!name.set()) then
    !name                       = !name.subString(2)
    !gadget.val                 = !name
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      validateName
--
-- Description: Validate name field
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateName(!gadget is GADGET, !action is STRING)

  -- return if not a VALIDATE action
  if ( !action.upcase() ne 'VALIDATE' ) then
    return
  endif

  -- nothing to do if empty
  !newName = !gadget.val.trim()
  if( !newName.empty() ) then
    return
  endif

  -- check old name
  if( !gadget eq !this.worldName ) then
    if( !this.assWorld.isNamed ) then
      !oldName = !this.assWorld.name
    else
      !oldName = ''
    endif
  else
    if( !this.assGroup.isNamed ) then
      !oldName = !this.assGroup.name
    else
      !oldName = ''
    endif
  endif

  if( !newName neq !oldName ) then
    if( ( '/' + !newName ) neq !oldName ) then
      -- name has changed - test it as a new name
      !name  = !!checkName(!newName, 'NEW')
      if ( !name.unset() ) then
        return error 1 noalert
      else
        !gadget.val = !name.subString(2)
      endif
    endif
  endif


endmethod
-- End of method definition
