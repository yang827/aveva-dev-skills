------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  assmbrInfo(DBREF)                STRING              find out more details about the assmbr
--  assocRightClick(ARRAY)           -                   Right click options
--  associationManager()             -
--  close()                          -                   Close form event handler
--  deleteAssoc()                    -                   Delete the association
--  detailRightClick(ARRAY)          -                   Right click options
--  init()                           -                   Initialise form
--  navAssoc()                       -                   Navigate to the association
--  navAssocItem1()                  -                   Navigate to the association member1
--  navAssocItem2()                  -                   Navigate to the association member2
--  navTarget()                      -                   Navigate to the association
--  onFilterBySelected()             -
--  restriRightClick(ARRAY)          -                   Right click options
--  showAssocs(GADGET,STRING)        -                   display association info
--  showDetails(ARRAY)               -                   After selection change
--  showRestriDetails(ARRAY)         -                   After selection change
--  viewAssoc()                      -                   Add Items into a local assoc View
--


import 'GridControl'
handle any
endhandle
Import 'pmlfilebrowser'
handle any
endhandle

-- Define form
setup form !!associationManager varchars resize
using namespace 'Aveva.Pdms.Presentation'

   -- Form members
   member .assocMemGrid is NETGRIDCONTROL
   member .detailMemGrid is NETGRIDCONTROL
   member .restriMemGrid is NETGRIDCONTROL
   member .assocs    is ARRAY
   member .restrics  is ARRAY
   member .assoc     is DBREF
   member .graphView is BOOLEAN
   member .form      is FORM
   member .token     is REAL
   -- save filter selection
   member .savedFilter  is STRING
   member .savedPurpose is STRING
   -- aid number for this form
   member .aidNumber is REAL

   frame .filterFrame at xmin ymax anchor t+l+r 'Association Filter' width 70
     path down
     option .filterBy anchor t+l+r 'Show:' width 30
     path right
     option .purp anchor t+r 'Purpose:' tagwid 8 width 8
     button .refresh at xmax.filterFrame-5 anchor t+r   pixmap width 16 height 16 tooltip 'Refresh'
   exit

   frame .assocsFrame |Associations| at xmin ymax anchor all width.filterFrame
     container .netAssocFrame nobox PmlNetControl 'Associations' dock fill height 12
   exit
   frame .restriFrame |Restrictions| at xmin ymax anchor b+l+r width.filterFrame
     container .netRestriFrame nobox PmlNetControl 'Restrictions' dock fill height 6
   exit
   frame .detailFrame |Association Detail| at xmin ymax anchor b+l+r width.filterFrame
     container .netDetailFrame nobox PmlNetControl 'Association Detail' dock fill height 6
   exit

   button .dismissButton 'Dismiss'  anchor b+r at xmax form-9 ymax+.25 width 8 cancel

menu .pmlAssocPopup popup
  !this.pmlAssocPopup.add( 'CALLBACK', 'View Association Elements', '!this.viewAssoc()', 'viewAssoc' )
  !this.pmlAssocPopup.add( 'MENU', 'Navigate To', 'PMLAssocPopupNavigate', 'navigateTo' )
  !this.pmlAssocPopup.add( 'SEPARATOR' )
  !this.pmlAssocPopup.add( 'CALLBACK', 'Delete Association', '!this.deleteAssoc()', 'deleteAssoc' )
  !this.pmlAssocPopup.add( 'SEPARATOR' )
  !this.pmlAssocPopup.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.assocMemGrid, ||, |Save Association Data As|)', 'EXCEL' )
  !this.pmlAssocPopup.add( 'callback', 'Print Preview...', '!this.assocMemGrid.printpreview()', 'PRINT' )
menu .pmlAssocPopupNavigate popup
  !this.pmlAssocPopupNavigate.add( 'CALLBACK', 'Association', '!this.navAssoc()', 'navAssoc' )
  !this.pmlAssocPopupNavigate.add( 'CALLBACK', 'First Associated Element', '!this.navAssocItem1()' , 'navAssoc1' )
  !this.pmlAssocPopupNavigate.add( 'CALLBACK', 'Second Associated Element', '!this.navAssocItem2()' , 'navAssoc2' )
menu .pmlDetailPopup popup
  !this.pmlDetailPopup.add( 'CALLBACK', 'Navigate To Target', '!this.navTarget()' , 'tarf')
  !this.pmlDetailPopup.add( 'SEPARATOR' )
  !this.pmlDetailPopup.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.detailMemGrid, ||, |Save As|)', 'EXCEL' )
  !this.pmlDetailPopup.add( 'callback', 'Print Preview...', '!this.detailMemGrid.printpreview()', 'PRINT' )

exit

-- End of form definition for !!associationManager

------------------------------------------------------------------------
--
-- Method:      systemHierarchy
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .associationManager()

  using namespace 'Aveva.Pdms.Presentation'


  -- Tooltips
  !this.refresh.setTooltip('Refresh')
  !this.dismissButton.setTooltip('Dismiss')

  -- icons
  !this.refresh.addPixmap(!!pml.getPathName('refresh16.png'))


  -- Add instances of .Net control
  !this.assocMemGrid = object NETGRIDCONTROL()
  !this.detailMemGrid = object NETGRIDCONTROL()
  !this.restriMemGrid = object NETGRIDCONTROL()

  -- Add .Net controls to PML containers
  !this.netAssocFrame.control = !this.assocMemGrid.handle()
  !this.netDetailFrame.control = !this.detailMemGrid.handle()
  !this.netRestriFrame.control = !this.restriMemGrid.handle()

  !this.assocMemGrid.addeventhandler('OnPopup', !this, 'assocRightClick')
  !this.assocMemGrid.addeventhandler('afterSelectChange', !this, 'showDetails')

  !this.detailMemGrid.addeventhandler('OnPopup', !this, 'detailRightClick')

	!this.restriMemGrid.addeventhandler('OnPopup', !this, 'restriRightClick')
  !this.restriMemGrid.addeventhandler('afterSelectChange', !this, 'showRestriDetails')

  !this.formTitle = 'Association Manager'
  !this.iconTitle = 'AssocMan'
  !this.initCall  = '!this.init()'
  !this.quitCall  = '!this.close()'

  --!this.filterBy.callback = |!this.showAssocs(|
  !this.filterBy.callback = |!this.onFilterBySelected()|
  !this.refresh.callback  = |!this.showAssocs(|
  --!this.purp.callback     = |!this.showAssocs(|

  -- Set parameters
  !this.assocMemGrid.columnExcelFilter(FALSE)
  !this.assocMemGrid.outlookGroupStyle(TRUE)
  !this.assocMemGrid.fixedHeaders(TRUE)
  !this.assocMemGrid.fixedRows(TRUE)
  !this.assocMemGrid.columnSummaries(FALSE)
  !this.assocMemGrid.editableGrid(FALSE)
  !this.assocMemGrid.singleRowSelection(TRUE)
  !this.assocMemGrid.setalternaterowcolor('lightgray')

  -- Set parameters
  !this.detailMemGrid.columnExcelFilter(FALSE)
  !this.detailMemGrid.outlookGroupStyle(FALSE)
  !this.detailMemGrid.fixedHeaders(FALSE)
  !this.detailMemGrid.fixedRows(FALSE)
  !this.detailMemGrid.columnSummaries(FALSE)
  !this.detailMemGrid.editableGrid(FALSE)
  !this.detailMemGrid.singleRowSelection(TRUE)
  -- Set parameters
  !this.restriMemGrid.columnExcelFilter(FALSE)
  !this.restriMemGrid.outlookGroupStyle(FALSE)
  !this.restriMemGrid.fixedHeaders(FALSE)
  !this.restriMemGrid.fixedRows(FALSE)
  !this.restriMemGrid.columnSummaries(FALSE)
  !this.restriMemGrid.editableGrid(FALSE)
  !this.restriMemGrid.singleRowSelection(TRUE)

  !dtext = ARRAY()
  !dtext.append('All Associations')
  !dtext.append('Current Element')
  !dtext.append('Selected Purpose')
  !dtext.append('Failed')
  !dtext.append('Invalid')
  !dtext.append('Contain Invalid References')
  !this.filterBy.dtext = !dtext
  !this.filterBy.rtext = !dtext
  !this.savedFilter    = 'All Associations'
  !this.savedPurpose   = ''

  !this.purp.active = false
  !this.graphView   = false

  -- aids
  !this.aidNumber   = !!aidNumbers.add('AssociationManager')

endmethod

-- End of method definition for .associationManager()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !this.filterBy.select('DTEXT',!this.savedFilter)
  var !assocPurp coll all assogp with (purp neq 'HOLE')
  var !purp eval PURP for all from !assocPurp
  !purp.unique()
  !this.purp.dtext = !purp
  !index           = !purp.findFirst(!this.savedPurpose)
  if( !index.set() ) then
    !this.purp.val = !index
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form event handler
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !!aidNumbers.hide(!this.aidNumber)
  -- Close graphical view
  if (!this.graphView) then
    -- clean up the drawlist
    !!gphDrawlists.detachAllViews(!this.token)
    handle any
    endhandle
    -- close form
    !!gphviews.close(!this.form)
    handle any
    endhandle
    -- Create the next valid drawlist
    !this.graphView = false
    !this.form      = object FORM()
    !this.token     = 0
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      showAssocs
--
-- Description: display association info
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showAssocs(!dummyGadget is GADGET, !action is STRING)

  if( !action eq 'UNSELECT' ) then
    return
  endif

  using namespace  'Aveva.Pdms.Presentation'

  -- Clear any existing data
  !this.assocMemGrid.clearGrid()
  !this.assocs.clear()

  !headings = ARRAY()
  !headings.append('Association')
  !headings.append('Description')
  !headings.append('Purpose')
  !headings.append('Status')
  !headings.append('First Associated Element')
  !headings.append('Second Associated Element')

	!filterBy         = !this.filterBy.selection()
  !this.savedFilter = !filterBy

  -- Leave out hole associations as it has it's own manager

  -- Set extended filter if filtered by purpose
  if (!filterBy eq 'Selected Purpose') then
    !purpose           = !this.purp.selection()
    !this.savedPurpose = !purpose
    var !assoc coll all assoc with (purp of owner eq |$!purpose|)
  elseif (!filterBy eq 'Current Element') then
    !assos = assos
    !assoc = ARRAY()
    do !i values !assos
      !assoc.append(!i.string())
    enddo
  else
    var !assoc coll all assoc with (purp of owner neq 'HOLE')
  endif

  !count = 1
  !assocInfo = ARRAY()
  do !i values !assoc
    !testev = !i.dbref().testev
    handle any
      !status = 'Invalid'
    elsehandle none
      if (!testev) then
        !status='Passed'
      else
        !status='Failed'
      endif
    endhandle
    !info= ARRAY()
    !info.append(!i.dbref().fullname)
    !description = !i.dbref().adefrf.desc
    handle any
      !description = ' '
    endhandle
    !info.append(!description)
    !purpose = !i.dbref().owner.purp
    handle any
      !purpose = ' '
    endhandle
    !info.append(!purpose)
    !info.append(!status)
    -- find out the assmbr elements
    !mem = !i.dbref().mem
    !assmbr = ARRAY()
    !invalidRef = FALSE
    do !j values !mem
      if (!j.type eq 'ASSMBR') then
        !assmbr.append(!j)
        !amemrfName = !j.amemrf.name
        handle any
          !amemrfName = 'Invalid'
          !invalidRef = TRUE
        endhandle
        !info.append(!amemrfName)
      endif
    enddo
    if (!assmbr.size() eq 1 ) then
      !info.append('None')
    endif

    -- Apply filter if required
    if (!filterBy inset('All Associations', 'Selected Purpose', 'Current Element')) then
      !this.assocs.append(!i.dbref())
      !assocInfo[!count] = ARRAY()
      !assocInfo[!count] = !info
      !count = !count + 1
    elseif (!filterBy eq 'Failed' and !status eq 'Failed') then
      !this.assocs.append(!i.dbref())
      !assocInfo[!count] = ARRAY()
      !assocInfo[!count] = !info
      !count = !count + 1
    elseif (!filterBy eq 'Invalid' and !status eq 'Invalid') then
      !this.assocs.append(!i.dbref())
      !assocInfo[!count] = ARRAY()
      !assocInfo[!count] = !info
      !count = !count + 1
    elseif (!filterBy eq 'Contain Invalid References' and !invalidRef ) then
      !this.assocs.append(!i.dbref())
      !assocInfo[!count] = ARRAY()
      !assocInfo[!count] = !info
      !count = !count + 1
    else
      skip
    endif
  enddo
  !nds = object NETDATASOURCE('Associations', !headings, !assocInfo )
  !this.assocMemGrid.bindToDataSource(!nds)

-- Highlight any FAILED or Invalid validations with RED cell background
  do !column from 1 to !this.assocMemGrid.getnumberColumns()
    do !row from 1 to !this.assocMemGrid.getNumberRows()
      if (!this.assocMemGrid.getCell(!row, !column) eq 'Invalid' or !this.assocMemGrid.getCell(!row, !column) eq 'Failed' ) then
        !this.assocMemGrid.setCellColor(!row, !column, 'salmon')
        !iconFile = !!pml.getPathName('exclamation-16.png')
        handle ANY
-- Icon file does not exist
          if (!this.debug) then
            !!alert.error(|Cannot assign missing icon file (exclamation-16.png)|)
          endif
        elsehandle NONE
          !this.assocMemGrid.setCellImage(!row, !column, !iconFile)
          handle any
            !!alert.error(|Error setting cell icon - | + !!error.text)
          endhandle
        endhandle
      endif

    enddo
  enddo
endmethod

define method .onFilterBySelected()
  !this.purp.active = !this.filterBy.selection() eq 'Selected Purpose'
endmethod

------------------------------------------------------------------------
--
-- Method:      assocRightClick
--
-- Description: Right click options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .assocRightClick(!data is ARRAY)

	if (!this.assocMemGrid.getRows().size() eq 0 or !this.assocMemGrid.getSelectedRows().empty()) then
		!this.pmlAssocPopup.setFieldProperty('EXCEL','ACTIVE',FALSE)
		!this.pmlAssocPopup.setFieldProperty('PRINT','ACTIVE',FALSE)
		!this.pmlAssocPopup.setFieldProperty('viewAssoc','ACTIVE',FALSE)
	  !this.pmlAssocPopup.setFieldProperty('deleteAssoc','ACTIVE',FALSE)
	  !this.pmlAssocPopupNavigate.setFieldProperty('navAssoc','ACTIVE',FALSE)
	  !this.pmlAssocPopupNavigate.setFieldProperty('navAssoc1','ACTIVE',FALSE)
		!this.pmlAssocPopupNavigate.setFieldProperty('navAssoc2','ACTIVE',FALSE)
	else
	
	  if (!this.assocMemGrid.getSelectedRows()[1][5] eq 'Invalid' or !this.assocMemGrid.getSelectedRows()[1][5] eq 'None') then
	    !this.pmlAssocPopupNavigate.setFieldProperty('navAssoc1','ACTIVE',FALSE)
	  else
	    !this.pmlAssocPopupNavigate.setFieldProperty('navAssoc1','ACTIVE',TRUE)
	  endif
	
	  if (!this.assocMemGrid.getSelectedRows()[1][6] eq 'Invalid' or !this.assocMemGrid.getSelectedRows()[1][6] eq 'None') then
	    !this.pmlAssocPopupNavigate.setFieldProperty('navAssoc2','ACTIVE',FALSE)
	  else
	    !this.pmlAssocPopupNavigate.setFieldProperty('navAssoc2','ACTIVE',TRUE)
	  endif
	
	  !this.pmlAssocPopup.setFieldProperty('viewAssoc','ACTIVE',TRUE)
	  !this.pmlAssocPopup.setFieldProperty('deleteAssoc','ACTIVE',TRUE)
	  !this.pmlAssocPopup.setFieldProperty('EXCEL','ACTIVE',TRUE)
		!this.pmlAssocPopup.setFieldProperty('PRINT','ACTIVE',TRUE)
		!this.pmlAssocPopupNavigate.setFieldProperty('navAssoc','ACTIVE',TRUE)
		
	endif
	
	!this.netAssocFrame.popup = !this.pmlAssocPopup
  !this.netAssocFrame.showPopup(!data[0], !data[1])

  if (!this.assocMemGrid.getRows().size() gt 0 and not !this.detailMemGrid.getSelectedRows().empty()) then
  	!this.assoc = !this.assocs[!data[2][1].real()]
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      detailRightClick
--
-- Description: Right click options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .detailRightClick(!data is ARRAY)

	if (!this.detailMemGrid.getRows().size() eq 0 or !this.detailMemGrid.getSelectedRows().empty()) then
		!this.pmlDetailPopup.setFieldProperty('tarf','ACTIVE',FALSE)
		!this.pmlDetailPopup.setFieldProperty('EXCEL','ACTIVE',FALSE)
		!this.pmlDetailPopup.setFieldProperty('PRINT','ACTIVE',FALSE)
	else
	
	  if (!this.detailMemGrid.getSelectedRows()[1][1] eq 'Invalid' or !this.detailMemGrid.getSelectedRows()[1][1] eq 'N/A') then
	    !this.pmlDetailPopup.setFieldProperty('tarf','ACTIVE',FALSE)
	  else
	    !this.pmlDetailPopup.setFieldProperty('tarf','ACTIVE',TRUE)
	  endif
	
	  !this.pmlDetailPopup.setFieldProperty('EXCEL','ACTIVE',TRUE)
		!this.pmlDetailPopup.setFieldProperty('PRINT','ACTIVE',TRUE)
	
	endif

  !this.netDetailFrame.popup = !this.pmlDetailPopup
  !this.netDetailFrame.showPopup(!data[0], !data[1])


endmethod


------------------------------------------------------------------------
--
-- Method:      restriRightClick
--
-- Description: Right click options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .restriRightClick(!data is ARRAY)

	if (!this.restriMemGrid.getRows().size() eq 0 ) then
		!this.pmlAssocPopupNavigate.setFieldProperty('navAssoc','ACTIVE',FALSE)
	  !this.pmlAssocPopupNavigate.setFieldProperty('navAssoc1','ACTIVE',FALSE)
		!this.pmlAssocPopupNavigate.setFieldProperty('navAssoc2','ACTIVE',FALSE)
	else
		!this.pmlAssocPopupNavigate.setFieldProperty('navAssoc','ACTIVE',TRUE)
	  !this.pmlAssocPopupNavigate.setFieldProperty('navAssoc1','ACTIVE',TRUE)
		!this.pmlAssocPopupNavigate.setFieldProperty('navAssoc2','ACTIVE',TRUE)
	endif
	
  !this.netRestriFrame.popup = !this.pmlAssocPopupNavigate
  !this.netRestriFrame.showPopup(!data[0], !data[1])

endmethod

------------------------------------------------------------------------
--
-- Method:      showDetails
--
-- Description: After selection change
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showDetails(!data is ARRAY)

  using namespace  'Aveva.Pdms.Presentation'
  -- Clear any existing data
  !this.detailMemGrid.clearGrid()
  !this.restriMemGrid.clearGrid()
  !this.restrics.clear()
  if (!data[0].size() eq 0 ) then
    return
  endif
  !this.assoc = !this.assocs[!data[0][1].real()]
  !mem = !this.assoc.mem
  !restriInfo = ARRAY()

  -- Show the restriction details
  !headings = ARRAY()
  !headings.append('Restriction Description')
  !headings.append('Status')
  !restriInfo = ARRAY()
  !count = 1
  do !i values !mem
    if (!i.type eq 'RESTRI') then
    	!restriInfo[!count] = ARRAY()
    	!this.restrics.append(!i)
    	!desc = !i.desc
      if (!desc eq '') then
        !desc = !i.owner.adefrf.desc
        handle any
          !desc = ''
        endhandle
      endif
      !restriInfo[!count].append(!desc)
      !restriTest = !i.testev
      handle any
        !testev = 'Invalid'
      elsehandle none
        if (!restriTest) then
          !testev = 'Passed'
        else
          !testev = 'Failed'
        endif
      endhandle
      !restriInfo[!count].append(!testev)
      !count = !count + 1
    endif
  enddo

  !nds = object NETDATASOURCE('Details', !headings, !restriInfo )
  !this.restriMemGrid.bindToDataSource(!nds)

  !pos = ARRAY()
  !headings = ARRAY()
  !headings.append('Target')
  !headings.append('Position')
  !headings.append('Direction')
  -- Find out if there is a data dist in the assoc
  !distQualifier = !this.assoc.ldpr.dist
  handle (2,207) $* No such property
    !distance = FALSE
  elsehandle none
    !distance = TRUE
    !headings.append('Distance Qualifier')
  endhandle
  !detailInfo = ARRAY()
  !count = 0
  do !i values !mem
    if (!i.type eq 'ASSMBR') then
    	-- If the tarf is unset use the amemrf
      !count = !count + 1
      !detailInfo[!count] = ARRAY()
      --need to set a ref here.
      -- if possible, try to set it to the TARF
      -- if this fails, try the ASSTAR
      --and if this fails try the AMEMRF
      --if all fail, ref is invalid

      !ref = 'Invalid'
    	--try to set ref to the TARF
      if (!i.tarf.unset()) then
      --fall back to ASSTAR
        if (!i.asstar.unset()) then
        --fall back to AMEMRF
     	    if (!i.amemrf.unset()) then
            !ref = 'Invalid'
          elseif (!i.amemrf.badref().not()) then
            !ref = !i.amemrf.fullname
            handle any
              !ref = 'Invalid'
            endhandle
          endif
        elseif (!i.asstar.badref().not()) then
          !ref = !i.asstar.fullname
          handle any
            !ref = 'Invalid'
          endhandle
        endif
      elseif (!i.tarf.badref().not()) then
        !ref = !i.tarf.fullname
        handle any
          !ref = 'Invalid'
        endhandle
      endif
      if (!ref eq 'Invalid') then
        !detailInfo[!count].append('Invalid')
        !detailInfo[!count].append('N/A')
        !detailInfo[!count].append('N/A')
    	else
    	  !extraInfo = !this.assmbrInfo(!i)
    	  !outputString = !extraInfo & !ref
    	  !detailInfo[!count].append(!outputString)
    	  !test = !i.posEv.east
    	  if (!test.set()) then
    	    !pos.append(!i.posEv)
    	  endif
    	  if (!i.posEv.unset()) then
    	    !posEv = 'unset'
    	  else
          !posEv = !i.posEv.wrt(world).string(!!distanceFmt)
          !posEv = !posEv.before('WRT')
        endif
        !detailInfo[!count].append(!posEv)
        if (!i.dirEv.unset()) then
    	    !dirEv = 'unset'
    	  else
          !dirEv = !i.dirEv.wrt(world).string(!!distanceFmt)
          !dirEv = !dirEv.before('WRT')
        endif
        !detailInfo[!count].append(!dirEv)
      endif
      if (!distance) then
        !detailInfo[!count].append(!distQualifier.string())
      endif
    endif
  enddo
  if (!pos.size() eq 2) then
    !headings.append('X Distance')
    !headings.append('Y Distance')
    !headings.append('Z Distance')
    !headings.append('Actual Distance')
    !xDist = (abs(!pos[1].east - !pos[2].east))
    !yDist = (abs(!pos[1].north - !pos[2].north))
    !zDist = (abs(!pos[1].up - !pos[2].up))

    !actDist = !pos[1].distance(!pos[2])
    do !numRows from 1 to !count
      !detailInfo[!numRows].append(!xDist.string(!!distanceFmt))
      !detailInfo[!numRows].append(!yDist.string(!!distanceFmt))
      !detailInfo[!numRows].append(!zDist.string(!!distanceFmt))
      !detailInfo[!numRows].append(!actDist.string(!!distanceFmt))
    enddo
  endif
  !nds = object NETDATASOURCE('Details', !headings, !detailInfo )
  !this.detailMemGrid.bindToDataSource(!nds)
-- Highlight any FAILED or Invalid validations with RED cell background
  do !column from 1 to !this.restriMemGrid.getnumberColumns()
    do !row from 1 to !this.restriMemGrid.getNumberRows()
      if (!this.restriMemGrid.getCell(!row, !column) eq 'Invalid' or !this.restriMemGrid.getCell(!row, !column) eq 'Failed' ) then
        !this.restriMemGrid.setCellColor(!row, !column, 'salmon')
        !iconFile = !!pml.getPathName('exclamation-16.png')
        handle ANY
-- Icon file does not exist
          if (!this.debug) then
            !!alert.error(|Cannot assign missing icon file (exclamation-16.png)|)
          endif
        elsehandle NONE
          !this.restriMemGrid.setCellImage(!row, !column, !iconFile)
          handle any
            !!alert.error(|Error setting cell icon - | + !!error.text)
          endhandle
        endhandle
      endif

    enddo
  enddo
-- Highlight any FAILED or Invalid validations with RED cell background
  do !column from 1 to !this.detailMemGrid.getnumberColumns()
    do !row from 1 to !this.detailMemGrid.getNumberRows()
      if (!this.detailMemGrid.getCell(!row, !column) eq 'Invalid' or !this.detailMemGrid.getCell(!row, !column) eq 'Failed' ) then
        !this.detailMemGrid.setCellColor(!row, !column, 'salmon')
        !iconFile = !!pml.getPathName('exclamation-16.png')
        handle ANY
-- Icon file does not exist
          if (!this.debug) then
            !!alert.error(|Cannot assign missing icon file (exclamation-16.png)|)
          endif
        elsehandle NONE
          !this.detailMemGrid.setCellImage(!row, !column, !iconFile)
          handle any
            !!alert.error(|Error setting cell icon - | + !!error.text)
          endhandle
        endhandle
      endif

    enddo
  enddo

endmethod

------------------------------------------------------------------------
-- Method:      viewAssoc
-- Description: Add Items into a local assoc View
-- Method Type: PML Event
-- Arguments:   Empty array
------------------------------------------------------------------------
define method .viewAssoc()


  -- Create the next available view if there isn't one already created
  if (!this.graphView.unset() or !this.graphView.not()) then
    !form = !!gphviews.addDesignform()
    -- Create the next valid drawlist
    !this.graphView = TRUE
    !this.form = !form
    !token =!!gphDrawlists.createDrawlist()
    !this.token = !token
  endif

  -- Create view and drawlist
  !!gphDrawlists.attachView(!this.token,!this.form.view)
  handle (61,113) $* user has manually deleted the view
    !form = !!gphviews.addDesignform()
    !this.form = !form
    !token=!!gphDrawlists.createDrawlist()
    !this.token = !token
    !!gphDrawlists.attachView(!this.token,!this.form.view)
  endhandle

  -- Populate elements in drawlist
  !drawlist = !!gphDrawlists.drawlist(!this.token)
  -- find out the assmbr elements
  !drawlist.removeAll()
  !!aidNumbers.hide(!this.aidNumber)
  !mem             = !this.assoc.mem
  !count           = 1
  !viewElementList = ARRAY()
  do !i values !mem
    if (!i.type eq 'ASSMBR') then
    	!col = !count + 1
      !drawlist.add(!i.amemrf)
      !drawlist.colour(!i.tarf,!col)
      !viewElementList.append(!i.amemrf)
      -- Replace with MB assmbr object
      if( !i.posEv.east.unset() or !i.dirEv.east.unset() ) then
        skip
      endif

      -- set point vector from posEv and dirEv
      !pv = object POINTVECTOR(!i.posEv, !i.dirEv)

      -- initialise feedback
      !plane = !pv.plane()
      !gphPlane               = object GPHPLANE(!plane)
      !gphPlane.tag           = true
      !gphPlane.detail        = false
      !gphPlane.x             = 150mm
      !gphPlane.y             = 150mm
       --  !gphPlane.description = !this.plane.description
      !gphPlane.filled(true)
      !targetPurpose          = !i.amemrf.purpose
      handle any
        !targetPurpose        = ''
      endhandle
      if( !targetPurpose.empty() ) then
        !gphPlane.description = 'MYFA'
      else
        !gphPlane.description = !targetPurpose
     endif

     -- Aid Number
     !gphPlane.draw(!this.aidNumber, false)

     !gphPV                 = object GPHPOINTVECTOR(!pv)
     !gphPV.tag             = false
     !gphPV.detail          = false
     !gphPlane.description  = ' '

     -- Aid Number
     !gphPV.draw(!this.aidNumber, false)
     !count = !count + 1

    endif
  enddo

  -- change scale of view to contain content
  !viewVolume = object VOLUME(!viewElementList)
  handle any
  elsehandle none
    !!gphviews.limits(!this.form.view, !viewVolume)
    handle any
    endhandle
  endhandle

endmethod
-- End of event callback definition for viewAssoc

------------------------------------------------------------------------
--
-- Method:      navAssoc
--
-- Description: Navigate to the association
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navAssoc()

!!ce=!this.assoc

endmethod

------------------------------------------------------------------------
--
-- Method:      navTarget
--
-- Description: Navigate to the association
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navTarget()

!!ce=!this.assoc
if (!this.detailMemGrid.getSelectedRowTags()[1] eq '1') then
  assmbr 1
else
  assmbr 2
endif

GOTO TARF
handle any
  GOTO ASSTAR
  handle any
    GOTO AMEMRF
    handle any
      !!alert.error('Unable to navigate to the selected element.')
    endhandle
  endhandle
endhandle


endmethod

------------------------------------------------------------------------
--
-- Method:      navAssocItem1
--
-- Description: Navigate to the association member1
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navAssocItem1()

!!ce=!this.assoc
assmbr 1
goto amemrf
handle any
  !!alert.error('Unable to navigate to the selected element.')
endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      navAssocItem2
--
-- Description: Navigate to the association member2
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navAssocItem2()

!!ce=!this.assoc
assmbr 2
handle any
  !!alert.error('Unable to navigate to the selected element.')
  return
endhandle
goto amemrf
handle any
  !!alert.error('Unable to navigate to the selected element.')
endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      deleteAssoc
--
-- Description: Delete the association
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteAssoc()

!ce=!!ce

!!ce=!this.assoc

DELETE ASSOC

!!ce= !ce
handle any
endhandle

!this.showAssocs(!this.filterBy,'')

endmethod
------------------------------------------------------------------------
--
-- Method:     assmbrInfo
--
-- Description: find out more details about the assmbr
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      String      Extra info about the assmbr
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .assmbrInfo(!ref is DBREF) is STRING

if (!ref.ppnu eq -1 and !ref.numb eq -1 and !ref.pkey eq '') then
  !returnString = 'Origin of '
elseif(!ref.ppnu neq -1) then
  !ppnu = !ref.ppnu.string()
  !returnString = 'PPoint' & !ppnu & ' of '
elseif(!ref.numb neq -1) then
  !numb = !ref.numb.string()
  !returnString = 'DPoint' & !numb & ' of '
elseif(!ref.pkey neq '') then
  !pkey = !ref.pkey
  !pkdi = !ref.pkdi
  !returnString = 'PLINE ' & !pkey & ' Distance ' & !pkdi & ' of '
endif

return !returnString

endmethod

------------------------------------------------------------------------
--
-- Method:      showRestriDetails
--
-- Description: After selection change
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showRestriDetails(!data is ARRAY)

  using namespace  'Aveva.Pdms.Presentation'
  !this.detailMemGrid.clearGrid()
  if (!data[0].size() eq 0 ) then
    return
  endif
  -- Clear any existing data
  !restri = !this.restrics[!data[0][1].real()]
  !mem = !restri.mem

  !pos = ARRAY()
  !headings = ARRAY()
  !headings.append('Target')
  !headings.append('Position')
  !headings.append('Direction')
  -- Find out if there is a data dist in the assoc
  !distQualifier = !this.assoc.ldpr.dist
  handle (2,207) $* No such property
    !distance = FALSE
  elsehandle none
    !distance = TRUE
    !headings.append('Distance Qualifier')
  endhandle

  !detailInfo = ARRAY()
  !count = 1
  do !i values !mem
    if (!i.type eq 'MBRMAP') then
    	!detailInfo[!count] = ARRAY()
    	-- Find out the alternative ID
      !lname = !i.lname
      !assmbr = AMLNID $!<lname> OF $!<restri>
      handle any
        !!alert.error('Restriction details cannot be found')
      endhandle

      --need to set a ref here.
      -- if possible, try to set it to the TARF
      -- if this fails, try the ASSTAR
      --and if this fails try the AMEMRF
      --if all fail, ref is invalid

      !ref = 'Invalid'
      if (defined(!assmbr)) then
      	--try to set ref to the TARF
        if (!assmbr.tarf.unset()) then
          --fall back to ASSTAR
          if (!assmbr.asstar.unset()) then
            --fall back to AMEMRF
            if (!assmbr.amemrf.unset()) then
              !ref = 'Invalid'
            elseif (!assmbr.amemrf.badref().not()) then
              !ref = !assmbr.amemrf.fullname
              handle any
                !ref = 'Invalid'
              endhandle
            endif
          elseif (!assmbr.asstar.badref().not()) then
            !ref = !assmbr.asstar.fullname
            handle any
              !ref = 'Invalid'
            endhandle
          endif
        elseif (!assmbr.tarf.badref().not()) then
          !ref = !assmbr.tarf.fullname
          handle any
            !ref = 'Invalid'
          endhandle
        endif
      endif
      if (!ref eq 'Invalid') then
        !detailInfo[!count].append('Invalid')
        !detailInfo[!count].append('N/A')
        !detailInfo[!count].append('N/A')
      else
    	  !extraInfo = !this.assmbrInfo(!assmbr)
    	  !outputString = !extraInfo & !ref
    	  !detailInfo[!count].append(!outputString)
    	  !test = !assmbr.posEv.east
    	  if (!test.set()) then
    	    !pos.append(!assmbr.posEv)
    	  endif
        !posEv = !assmbr.posEv.string()
        !posEv = !posEv.before('WRT')
        !detailInfo[!count].append(!posEv)
        !dirEv = !assmbr.dirEv.string()
        !dirEv = !dirEv.before('WRT')
        !detailInfo[!count].append(!dirEv)
      endif
      if (!distance) then
        !detailInfo[!count].append(!distQualifier.string())
      endif
      !count = !count + 1
    endif
  enddo
  if (!count eq 2 ) then
    !detailInfo[2].append('N/A')
    !detailInfo[2].append('N/A')
    !detailInfo[2].append('N/A')
  endif
  if (!pos.size() eq 2) then
    !headings.append('X Distance')
    !headings.append('Y Distance')
    !headings.append('Z Distance')
    !headings.append('Actual Distance')
    !xDist = (int(abs(!pos[1].east - !pos[2].east)))
    !yDist = (int(abs(!pos[1].north - !pos[2].north)))
    !zDist = (int(abs(!pos[1].up - !pos[2].up)))

    !actDist = int(!pos[1].distance(!pos[2]))
    !detailInfo[1].append(!xDist)
    !detailInfo[2].append(!xDist)
    !detailInfo[1].append(!yDist)
    !detailInfo[2].append(!yDist)
    !detailInfo[1].append(!zDist)
    !detailInfo[2].append(!zDist)
    !detailInfo[1].append(!actDist.string())
    !detailInfo[2].append(!actDist.string())
  endif
  !nds = object NETDATASOURCE('Details', !headings, !detailInfo )
  !this.detailMemGrid.bindToDataSource(!nds)

-- Highlight any FAILED or Invalid validations with RED cell background
  do !column from 1 to !this.detailMemGrid.getnumberColumns()
    do !row from 1 to !this.detailMemGrid.getNumberRows()
      if (!this.detailMemGrid.getCell(!row, !column) eq 'Invalid' or !this.detailMemGrid.getCell(!row, !column) eq 'Failed' ) then
        !this.detailMemGrid.setCellColor(!row, !column, 'salmon')
        !iconFile = !!pml.getPathName('exclamation-16.png')
        handle ANY
   Icon file does not exist
          if (!this.debug) then
            !!alert.error(|Cannot assign missing icon file (exclamation-16.png)|)
          endif
        elsehandle NONE
          !this.detailMemGrid.setCellImage(!row, !column, !iconFile)
          handle any
            !!alert.error(|Error setting cell icon - | + !!error.text)
          endhandle
        endhandle
      endif

    enddo
  enddo

endmethod
