--
--
-- Description:
-- Attribute List form.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!attlib

-- Define form
setup form !!attlib

  !!attlib.formTitle     = 'Attribute List Form'
  !!attlib.iconTitle     = 'Attlib'
  !!attlib.callback      = ''
  !!attlib.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition

  -- Search Criteria
  text .searchString 'String String' at xmin y0.2 width 20 string
  button .search     'Search'        at xmax+1 ymin call 'call !!attlibFind()'

  -- Available Attributes
  list .list 'Attributes' at x0.5 ymax+0.5 call 'call !!attlibData()' width 20 length 17

  -- Navigation on search
  button .previous '<' at xmin           ymax call 'call !!attlibMove(''PREVIOUS'')'
  button .next     '>' at xmax.list-size ymin call 'call !!attlibMove(''NEXT'')'
  !!attlib.previous.active = false
  !!attlib.next.active     = false
  para   .numberOff at xmax.previous ymin width 18 lines 1

  -- Detail
  path down
  halign right
  frame .detailFrame 'Information' at xmax.list+1 ymin.list+0.25

    -- Definition
    para .nameText  at x6 y1 text 'Attribute : '
    para .qtxtText  text 'Member Name : '
    para .rptxText  text 'Report Text : '
    para .defiText  text 'Definition : '
    para .typeText  text 'Type : '
    para .dTypText  text 'Database Type : '
    para .sizeText  text 'Size : '
    para .unitText  text 'Units : '
    para .visiText  text 'Visible : '
    para .qSetText  text 'Settable : '

    para .name  at xmax .nameText  ymin .nameText  width 42 lines 1
    para .qtxt  at xmax .qtxtText  ymin .qtxtText  width 42 lines 1
    para .rptx  at xmax .rptxText  ymin .rptxText  width 42 lines 1
    para .defi  at xmax .defiText  ymin .defiText  width 42 lines 1
    para .type  at xmax .typeText  ymin .typeText  width 42 lines 1
    para .dTyp  at xmax .dTypText  ymin .dTypText  width 42 lines 1
    para .size  at xmax .sizeText  ymin .sizeText  width 42 lines 1
    para .unit  at xmax .unitText  ymin .unitText  width 42 lines 1
    para .visi  at xmax .visiText  ymin .visiText  width 42 lines 1
    para .qSet  at xmax .qSetText  ymin .qSetText  width 42 lines 1

  exit

  -- Dismiss
  halign right
  button .dismiss 'Dismiss' ok

  -- Form members
    -- All attributes available
    member .attList    is ARRAY

    -- Processed Attributes
    member .attributes is ARRAY

    -- Currently selected attributes
    member .selection  is ARRAY
    member .selected   is REAL

    -- Reference Arrays
    member .defiArray  is ARRAY
    member .typeArray  is ARRAY
    member .copyArray  is ARRAY

exit
-- End of form definition for !!attlib

-- Load form
  !!attlib.defiArray = !!attlibConstants('DEFI')
  !!attlib.typeArray = !!attlibConstants('TYPE')
  !!attlib.copyArray = !!attlibConstants('COPY')

  call !!attlibLoad()
