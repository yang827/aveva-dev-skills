--
--
-- Description:
-- Form used by AVEVA core CHOOSE utilities (Form name cannot been changed)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cadcChoose()                     -                   Constructor for form
--
setup form !!cadcChoose blockingdialog resize noalign at xr 0.2 yr 0.2

  title 'CHOOSE'
  path down
  vdist 0
  !width = 40
  para .bore width $!width lines 2
--  para .conn width $!width
  para .conn at ymin+1.35   width $!width
  para .header width $!width
--  para .header at ymin+0.8  width $!width

  list .list anchor ALL single width $!width lines 5
--  list .list anchor ALL columns single width $!width lines 5
--  list .LIST at ymin+0.8 anchor ALL single width $!width lines 5

  button .ok |OK| at xmin form anchor L+B width 6 OK
  button .cancel |CANCEL| at xmax form-size ymin anchor R+B width 6 CANCEL

exit

-- End of form definition for !!cadcChoose
------------------------------------------------------------------------
--
-- Method:      cadcChoose
--
-- Description: Constructor for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cadcChoose()

  !this.bore.val = 'bore'
  !this.conn.val = 'conn'
  !this.header.val = 'header'

endmethod
-- End of method definition for .cadcChoose()
------------------------------------------------------------------------
