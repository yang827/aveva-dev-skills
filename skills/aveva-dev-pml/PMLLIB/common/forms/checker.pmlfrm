--
-- File:            checker.pmlfrm
--   Type:          Form Definition
--   Group:         Checking routines
--     Keyword:     CHECK
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Feb 20 10:59:43 GMT 1997
--
--
-- Description:
-- Main form for common checking utility.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checker()                        -                   Constructor
--  chkFilename()                    -                   Check the Filename Gadget
--  setFilename(FILE)                -                   Set the Filename Gadget
--
------------------------------------------------------------------------

-- Kill existing form definition
-- kill !!checker

-- Define form
setup form !!checker
Import 'pmlfilebrowser'
handle any
endhandle

  !!checker.formTitle     = |Checker|
  !!checker.iconTitle     = |Checker|
  !!checker.callback      = |call !!checkerInit()|
  !!checker.formRevision  = | $Revision: 1.10 $ |

  -- Body of form definition
  -- Hierarchy Position Check of From
  button .ceButton |CE| at xmin ymax call |call !!checkerInit()|
  para   .name at xmax+1 ymin width 98 lines 1

  -- Checks
  frame  .groupFrame at xmin_ceButton ymax |Check Options|

    -- Class (Disciplines)
    option .class  |Class | at x2 y1 call |call !!checkerSet('CLASS')| width 30
    path down
    halign right

    -- Group (Sub-type)
    option .group  |Group | call |call !!checkerSet('TYPE')| width 30

    -- Permissible Checks
    list   .list   |Available Checks| at x1 ymax+0.25 multi width 40 length 10

    -- Check button
    button .check  |Check| call |call !!checker()|

    -- Re-load functions
    button .reLoad |Re-Load| at xmin.list ymin call |call !!checkerLoad()|

  exit

  -- Check Report
  frame .reportFrame |Results| at xmax.groupFrame+1 ymin.groupFrame

    -- Counts for Passed
    para .passedCount at x1 y1 width 50 lines 1

    -- List of Item passed check
    list .passed at xmin ymax  call |call !!checkerMove(_passed)| width 50 length 8

    -- Counts for Passed
    para .failedCount at xmin ymax width 50 lines 1

    -- List of Items failing any check
    list .failed at xmin ymax call |call !!checkerMove(_failed)| width 50 length 10

  exit

  -- Save Data
  frame .saveFrame |Save Results| at xmin.groupFrame ymax.groupFrame+0.4
    text   .file |File | at x1 y1 call |!!checker.chkFilename()| width 36 string
    path down
    halign right
    button .save |Save| call |call !!checkerSave()|
    path left
    button .browser 'Browse...' call |!!fileBrowser('%PDMSUSER%', 'checker-results.txt', 'Data Checker - Save Result in file...', false,$
    '!!checker.setFilename(!!fileBrowser.file)')|
    exit

  -- Dismiss
  button .dismiss |Dismiss| at xmax form-size ymax form+0.2 ok

  -- Members
    -- Current Element
    member .ce           is DBREF
    -- Available Checks
    member .checks       is ARRAY

    -- Last Checks performed
    member .checkList    is ARRAY

    -- Element lists
    member .itemsChecked is ARRAY
    member .itemsPassed  is ARRAY
    member .itemsFailed  is ARRAY

exit
-- End of form definition for !!checker
------------------------------------------------------------------------
--
-- Method:      checker
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .checker()

  -- Load available check
  call !!checkerLoad()

endmethod
-- End of method definition for .checker()

------------------------------------------------------------------------
--
-- Method:      setFilename
--
-- Description:
--   Set the Filename Gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        Filename
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------

-- Define method
define method .setFilename(!file is FILE)

  !this.file.val = !file.name()

  -- Check the filename
  !this.chkFilename()

endmethod
-- End of method definition for .setFilename(FILE)
------------------------------------------------------------------------
--
-- Method:      chkFilename
--
-- Description:
--   Check the Filename Gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------

-- Define method
define method .chkFilename()

  if (!this.file.val.trim().length() eq 0) then
    !this.save.active = false
  else
    !this.save.active = true
  endif

endmethod
-- End of method definition for .chkFilename()
