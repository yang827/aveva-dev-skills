--   Group:         Checking routines
--     Keyword:     CHK
--   Module:        common
--   Replaces:
--
-- Author:          S.Bentley
-- Created:         Fri Jun 12 10:54:50 BST 1998
--
--
-- Description:
--   Report form for common checking utility.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Unenhance and aid clear all on closing the form
--  initialise()                     -                   Initialisation
--  navigate(GADGET,STRING)          -                   navigate to the checked element
--
------------------------------------------------------------------------

-- Define form
setup form !!chkResultsView

  !!chkResultsView.formTitle     = |Checker Results|
  !!chkResultsView.iconTitle     = |ChkResults|
  !!chkResultsView.callback      = |!this.initialise()|
  !!chkResultsView.formRevision  = | $Revision: 1.6 $ |


  -- Check Report
  frame .reportFrame |Results| at xmin ymax

    -- Counts for Passed
    para .passedCount at x1 y1 width 50 lines 1

    -- List of Item passed check
    list .passed at xmin ymax call |!this.navigate(| width 50 length 8

    -- Counts for Passed
    para .failedCount at xmin ymax width 50 lines 1

    -- List of Items failing any check
    list .failed at xmin ymax call |!this.navigate(| width 50 length 10

  exit

  -- Members

    -- Element lists
    member .itemsChecked is ARRAY
    member .itemsPassed  is ARRAY
    member .itemsFailed  is ARRAY

    -- Used Class, Group and definitions
    member .class        is STRING
    member .group        is STRING
    member .definitions  is ARRAY

exit
-- End of form definition for !!chkResultsView
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  -- EmptyChecker display forms
  !this.passed.clear()
  !this.failed.clear()
  !this.itemsFailed.clear()
  !this.itemsPassed.clear()
  !this.itemsChecked.clear()

  -- Passed/Failed
  !this.passedCount.val  = 'Passed'
  !this.failedCount.val  = 'Failed'

  -- add a cancel callback
  !this.cancelCall = '!this.close()'
  !this.quitCall   = '!this.close()'

endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description:
--   navigate to the checked element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET        gadget
--    2   R      STRING
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------

-- Define method
define method .navigate(!gadget is GADGET, !dummySelect is STRING)

  -- Initialise Variables
  !item = !gadget.selection('RTEXT').dbRef()
  if(!item eq Nulref) then
    return
  endif
  !!ce  = !item

endmethod
-- End of method definition for .navigate(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Unenhance and aid clear all on closing the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------

-- Define method
define method .close()

  -- Unhighlight all listed elements
  !!chkStoreView.unenhanceAllElements()
  AID CLEAR ALL

endmethod
-- End of method definition for .close()
