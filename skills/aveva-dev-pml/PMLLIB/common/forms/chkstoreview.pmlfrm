--
--
-- Description:
--    Checker form for chkstore object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addDbRef(DBREF)                  -                   Add Current element to the List and Display
--  addDbRefMem(DBREF)               -                   Add Current element member to the List and Display
--  addFailed()                      -                   Add Failed elements to the List and Display
--  addPicked(DBREF)                 -                   Add Picked element to the List and Display
--  apply()                          -                   Apply the check
--  check()                          -                   Select a check
--  chkFunction(DBREF,CHKDEFINITION) CHKRETURN
--  chkStoreView()                   -                   Constructor
--  chosenColour(STRING)             -                   Set the highlight colour
--  class()                          -                   Select a class
--  close()                          -                   Close the form down
--  colours(STRING)                  -                   Highlight colours
--  display()                        -                   Maintain the display of the elements list
--  group()                          -                   Select a group
--  initialise()                     -                   Initialise form
--  listLst(STRING,STRING)           -                   Add /remove elements from the selected Collection list
--  loadChecks()                     -                   Load Checks via the original Checker form
--  loadFailed()                     -                   Load failed element and setup form to the defined test
--  loadFailures(ARRAY,STRING,STRING,ARRAY) -                   Wrapper for Failed Items, Class, Group, and Definitions used.
--  pick(MENU,STRING)                -                   Setup Pick mode to Add/Remove items
--  pullDowns()                      -                   Maintain the pull-downs
--  removeAll()                      -                   Remove all elements
--  removeDbRef(DBREF)               -                   Remove Current Element List
--  removeDbRefMem(DBREF)            -                   Remove Current Element members List
--  removePicked(DBREF)              -                   Remove Picked element from the List and unhighlight
--  removeSelected()                 -                   Remove selected items List
--  save()                           -                   Save results from a check
--  saveFailed()                     -                   Save failed element and the check information so that they can be
--  selectItem(GADGET,STRING)        -                   Selected entry from checkItems
--  setupForm()                      -                   Setup form
--  tidy()                           -
--  unenhanceAllElements()           -                   Unenhance all elements
--  unenhanceSelection()             -
--  update()                         -                   Maintain the List menu
--
------------------------------------------------------------------------

setup form !!chkStoreView
Import 'PMLFILEBROWSER'
handle any
endhandle

  !!chkStoreView.formTitle     = 'Checker'
  !!chkStoreView.iconTitle     = 'Checker'
  !!chkStoreView.callback      = '!this.initialise()'
  !!chkStoreView.formRevision  = ' $Revision: 1.28 $ '

  -- Body of form definition

  -- Bar menu
  bar
  exit

  -- Items to check
  list .checkItems 'Check Items' at xmin ymax   callback '!this.selectItem(' multiple width 40 lines 7

  -- List of check classes (usually applications)
  option .classes  'Classes' at xmin ymax         callback '!this.class()' width 30

  -- List of check groups in the class
  path down
  halign right
  option .groups   'Groups'                       callback '!this.group()' width 30

  -- List of check
  list .check      'Checks'  at xmin.classes ymax callback '!this.check()' multiple width 40 lines 6

  -- Action check
  button .apply    'Check...'   at xmin ymax+0.2     callback '!this.apply()'

  -- Dismiss
  button .dismiss  'Dismiss' at xmax form-size ymin  callback '!this.close()' ok

  -- Highlighting toggle
--  toggle .highlight 'Highlight' at x14 ymin

  -- Form members

  -- Selected Items
  member .selectionList is ARRAY

  -- Element list
  member .elements      is ARRAY

  -- List of element to check (result of the search of types with rule from
  -- the check group object)
  -- this is where the loadFailed data need to be loaded
  member .checkList      is ARRAY

  -- List of passed element
  member .passedList     is ARRAY

  -- List of failed element
  member .failedList     is ARRAY

  -- Design based modules edg/enhance available
  member .designModule   is BOOLEAN

  -- Highlight Colours
  member .elementColour   is REAL
  member .passedColour    is REAL
  member .failedColour    is REAL
  member .passedColToggle is BOOLEAN
  member .failedColToggle is BOOLEAN

exit
-- End of form definition for !!chkStoreView

------------------------------------------------------------------------
--
-- Method:      chkStoreView
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .chkStoreView()

  !this.quitCall = '!this.tidy()'

  -- Define Bar menu
  !bar = !this.bar
  !bar.add('Control',   'fileMenu')
  !bar.add('Add',       'addMenu')
  !bar.add('Remove',    'removeMenu')
  !bar.add('Highlight', 'highlightMenu')

  -- File menu
  !menu = !this.newMenu('fileMenu')
    !menu.add('menu',     'Save',               'saveMenu')
    !menu.add('menu',     'Load',               'loadMenu')
    !menu.add('separator')
    !menu.add('callback', 'Reload Checks',      '!this.loadChecks()')
--    !menu.add('callback', 'Display Results...', 'show !!chkResultsView')

  -- Save menu
  !menu = !this.newMenu('saveMenu')
    !menu.add('callback', 'Results...', '!this.save()')
    !menu.add('callback', 'Failed Reference...', '!this.saveFailed()')

  -- Load menu
  !menu = !this.newMenu('loadMenu')
    !menu.add('callback', 'Failed Reference...', 'call !!fileBrowser(''%PDMSUSER%'', ''*.pmldat'', ''Load Failed Checks & Elements'', true, ''!!chkStoreView.loadFailed()'')')

   -- Add menu
  !menu = !this.newMenu('addMenu')
    !menu.add('callback', 'CE',              '!this.addDbRef(!!ce)')
    !menu.add('callback', 'CE Members',      '!this.addDbRefMem(!!ce)')
    !menu.add('separator')
    !menu.add('toggle',   'Pick',            '!this.pick(')
    !menu.add('callback', 'Failed List',     '!this.addFailed()')
    !menu.add('menu',     'List',       'addListMenu')

  -- Remove menu
  !menu = !this.newMenu('removeMenu')
    !menu.add('callback', 'All',        '!this.removeAll()')
    !menu.add('callback', 'Selected',   '!this.removeSelected()')
    !menu.add('separator')
    !menu.add('callback', 'CE',         '!this.removeDbRef(!!ce)')
    !menu.add('callback', 'CE Members', '!this.removeDbRefMem(!!ce)')
    !menu.add('separator')
    !menu.add('toggle', 'Pick',   '!this.pick(')
    !menu.add('menu',     'List',  'removeListMenu')

  -- Add Lists
  !menu = !this.newMenu('addListMenu')

  -- Remove Lists
  !menu = !this.newMenu('removeListMenu')

  -- Update the Add Lists menu and Remove Lists menu
  !this.update()

  -- Highlight menu
  !menu = !this.newMenu('highlightMenu')
    !menu.add('callback', 'Elements...',     '!this.colours(|Elements|)')
    !menu.add('toggle',   'Passed',          '!this.colours(|PassedToggle|)')
    !menu.add('toggle',   'Failed',          '!this.colours(|FailedToggle|)')
    !menu.add('menu',     'Colours',         'colourMenu')
    !menu.add('menu',     'Clear',           'unhighlightMenu')

  -- Colour menu
  !menu = !this.newMenu('colourMenu')
    !menu.add('callback', 'Passed...',       '!this.colours(|Passed|)')
    !menu.add('callback', 'Failed...',       '!this.colours(|Failed|)')

  -- Unhighlight menu
  !menu = !this.newMenu('unhighlightMenu')
    !menu.add('callback', 'Selection', '!this.unenhanceSelection()')
    !menu.add('callback', 'All',       '!this.unenhanceAllElements()')

  -- Define global object, if it doesn't exist
  if(undefined(!!chkStore)) then
    call !!comDefineGlobal(object CHKSTORE())
  endif

  -- Highlight Colours defaults
  !elementColour = object COLOUR('Turquoise')
  !passedColour  = object COLOUR('Green')
  !failedColour  = object COLOUR('BrightRed')
  !this.elementColour = !elementColour.code
  !this.passedColour  = !passedColour.code
  !this.failedColour  = !failedColour.code
  !this.passedColToggle = false
  !this.failedColToggle = false

  -- Load the Checker form
  pml load form !!checker

  -- Load Classes,Groups and checks on this form via Checker forms
  !this.loadChecks()

  -- Load the chkResultsView form
  pml load form !!chkResultsView

endmethod
-- End of method definition for .chkStoreView()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Setup form
  !this.setupForm()

  -- Maintain pulldowns
  !this.pullDowns()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description:
--  Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupForm()


  -- If there are no selection, then grey all relevant buttons out
  if(!this.check.selection().empty().not() and !this.elements.size() gt 0) then
    !this.apply.active        = true
  else
    !this.apply.active        = false

  endif
  -- If both passed & failed lists are empty grey-out saveMenu
  if(!this.passedList.empty() and !this.failedList.empty()) then
    !this.fileMenu.setActive('Save', false)
    !this.addMenu.setActive('Failed List', false)
  -- If there no data to save
  elseif (!this.failedList.empty()) then
    !this.fileMenu.setActive('Save', true)
    !this.saveMenu.setActive('Failed Reference...', false)
    !this.addMenu.setActive('Failed List', false)
  else
    !this.fileMenu.setActive('Save', true)
    !this.saveMenu.setActive('Failed Reference...', true)
    !this.addMenu.setActive('Failed List', true)
  endif

endmethod
-- End of method definition for .setupForm()
------------------------------------------------------------------------
--
-- Method:      addDbRef
--
-- Description:
--   Add Current element to the List and Display
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Dbref       Element to be added into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addDbRef(!item is DBREF)

  -- Add item to list
  !this.elements.append(!item)

  -- Re Display
  !this.display()

endmethod
-- End of method definition for .addDbRef(DBREF)
------------------------------------------------------------------------
--
-- Method:      addDbRefMem
--
-- Description:
--   Add Current element member to the List and Display
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be added into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addDbRefMem(!item is DBREF)

  -- Add item to list
  !this.elements.appendArray(!item.members)

  -- Re Display
  !this.display()

endmethod
-- End of method definition for .addDbRefMem(DBREF)

------------------------------------------------------------------------
--
-- Method:      addFailed
--
-- Description:
--   Add Failed elements to the List and Display
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addFailed()

  -- Add item to list
  !this.elements.appendArray(!this.failedList)

  -- Re Display
  !this.display()

endmethod
-- End of method definition for .addFailed()
------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description:
--   Setup Pick mode to Add/Remove items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option  = !menu.pickedField

if(!option.upcase() eq 'PICK') then

  if(!selected eq 'SELECT') then

    -- Define edg Packet for picking elements
    !packet             = object EDGPACKET()

    if (!menu.name().upcase() eq 'ADDMENU') then
      !packet.elementPick('Pick element to Add')
      !packet.remove      = false
      !packet.description = 'Data Checker Packet'
      !packet.action      = '!!chkStoreView.addPicked(!this.return[1].item)'
      !this.removeMenu.select('Pick',false)
      !packet.close       = '!!chkStoreView.addMenu.select(''Pick'',false)'
    else
      !packet.elementPick('Pick element to Remove')
      !packet.remove      = false
      !packet.description = 'Data Checker Packet'
      !packet.action      = '!!chkStoreView.removePicked(!this.return[1].item)'
      !this.addMenu.select('Pick',false)
      !packet.close       = '!!chkStoreView.removeMenu.select(''Pick'',false)'
    endif

    !!edgCntrl.add(!packet)

  else
    !!edgCntrl.remove('Data Checker Packet')
  endif

endif

endmethod
-- End of method definition for .pick(MENU, STRING)
------------------------------------------------------------------------
--
-- Method:      addPicked
--
-- Description:
--   Add Picked element to the List and Display
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be added into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addPicked(!picked is DBREF)

  -- Add item to list
  !this.elements.append(!picked)

  -- Re Display
  !this.display()

endmethod
-- End of method definition for .addPicked(DBREF)
------------------------------------------------------------------------
--
-- Method:      removePicked
--
-- Description:
--   Remove Picked element from the List and unhighlight
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be removed into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removePicked(!picked is DBREF)

   -- If passed item exists in list, the remove it
  !index = !this.elements.findFirst(!picked)
  if(!index.set()) then
    UNENHANCE $!picked
    !this.elements[!index].delete()
  endif

  -- Re Display
  !this.display()

endmethod
-- End of method definition for .removePicked(DBREF)

------------------------------------------------------------------------
--
-- Method:      listLst
--
-- Description:
--   Add /remove elements from the selected Collection list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       ADD or REMOVE
--    1   R      STRING       list number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .listLst(!option is STRING, !listData is STRING)

    !entries = ARRAY()

    -- Get list
    !entriesString  = '!!' & 'CDLIST' & !listData

    do !i indices $!entriesString
      !entries[!i] = $!entriesString[$!i].dbRef()
    enddo

    -- Option
    if(!option.upcase() eq 'ADD') then

      -- Add item to list
      !this.elements.appendArray(!entries)

      -- Re Display
      !this.display()

    elseif (!option.upcase() eq 'REMOVE') then

      -- Difference
      !newList     = !this.elements.difference(!entries)
      !this.elements = !newList

      -- Display
      !this.display()

    endif

endmethod
-- End of method definition for .listLst(STRING, STRING)


------------------------------------------------------------------------
--
-- Method:      removeDbRef
--
-- Description:
--   Remove Current Element List
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be removed into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removeDbRef(!item is DBREF)

    -- If passed item exists in list, the remove it
  !index = !this.elements.findFirst(!item)
  if(!index.set()) then
    !this.elements[!index].delete()
  endif

  -- Re Display
  !this.display()

endmethod
-- End of method definition for .removeDbRef(DBREF)

------------------------------------------------------------------------
--
-- Method:      removeDbRefMem
--
-- Description:
--   Remove Current Element members List
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element which members are to be removed into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removeDbRefMem(!item is DBREF)

  -- Get members of Item
  !itemMembers = !item.members

  -- Difference
  !newList     = !this.elements.difference(!itemMembers)
  !this.elements = !newList

  -- Display
  !this.display()

endmethod
-- End of method definition for .removeDbRefMem(DBREF)

------------------------------------------------------------------------
--
-- Method:      removeSelected
--
-- Description:
--   Remove selected items List
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removeSelected()

  -- Check there are some selections
  if(!this.checkItems.selection().unset()) then
    !!messageFile.warning(149,006)
    return
  endif

  -- Remove entries List
  do !i values !this.checkItems.val
    !selection = !this.checkItems.rText[!i]
    UNENHANCE $!selection
    !this.elements[!i].delete()
  enddo

  -- Display
  !this.display()

endmethod
-- End of method definition for .removeSelected()

------------------------------------------------------------------------
--
-- Method:      removeAll
--
-- Description:
--   Remove all elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removeAll()

  -- Remove all entries List
  !this.unenhanceAllElements()
  !this.elements.clear()

  -- Display
  !this.display()

endmethod
-- End of method definition for .removeAll()

------------------------------------------------------------------------
--
-- Method:      selectItem
--
-- Description:
--   Selected entry from checkItems
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget (Menu)
--    2   R      STRING      Selected/Unselected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .selectItem(!listGadget is GADGET, !select is STRING)



  -- If select, then move to item
  if(!select.upcase() eq 'SELECT') then
    !picked  = !listGadget.pickedField
    !!ce = !this.checkItems.rText[!picked].dbRef()
    handle any
      !!alert.error(!!error.text)
    endhandle
  endif

endmethod
-- End of method definition for .selectItem(GADGET, STRING)
------------------------------------------------------------------------
--
-- Method:      display
--
-- Description:
--   Maintain the display of the elements list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display()

  -- Re-build list
  if(!this.elements.set()) then

    -- Remove Duplications
    !this.elements.unique()

    do !i indices !this.elements
      !listString[!i]   = !this.elements[!i].string()
      !listName[!i]     = !listString[!i].dbRef().fullName
    enddo

    !this.checkItems.dText = !listName
    !this.checkItems.rText = !listString

  else
    !this.checkItems.dText = ARRAY()
  endif

  -- Maintain Pull-Downs for current list
  !this.pullDowns()
  !this.setupForm()

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      pullDowns
--
-- Description:
--   Maintain the pull-downs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pullDowns()

  !bar  = !this.bar
  !menu = !this.removeMenu

  -- Get module information
  !module            = !!module()
  !this.designModule = !module.appkey.upcase() inset('DES')

  -- If there are no members, then grey-out remove options
  if(!this.checkItems.dText.size() eq 0 ) then
    !bar.setActive('Remove', false)
    !bar.setActive('Highlight', false)

    -- Also switch off any remove picking edg
    if (!this.designModule) then
      !!edgCntrl.remove('Output report packet')
    endif

  else
    !bar.setActive('Remove', true)
    !bar.setActive('Highlight', true)
    !menu.setActive('All',        true)
    !menu.setActive('Selected',   true)
    !menu.setActive('CE',         true)
    !menu.setActive('CE Members', true)
    !menu.setActive('Pick',       true)

  endif

  if (!this.designModule.not()) then
    !bar.setActive('Highlight', false)
    --!this.highlight.active = false
    !menu = !this.addMenu
    !menu.setActive('Pick', false)
    !menu = !this.removeMenu
    !menu.setActive('Pick', false)
  endif

  -- Maintain colour pulldowns
  if (!this.passedColToggle) then
    !this.colourMenu.setActive('Passed...', true)
  else
    !this.colourMenu.setActive('Passed...', false)
  endif
  if (!this.failedColToggle) then
    !this.colourMenu.setActive('Failed...', true)
  else
    !this.colourMenu.setActive('Failed...', false)
  endif

endmethod
-- End of method definition for .pullDowns()
------------------------------------------------------------------------
--
-- Method:      colours
--
-- Description:
--   Highlight colours
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element,Passed or Failed
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------

-- Define method
define method .colours(!mode is STRING)

  if (!mode eq 'PassedToggle') then
    if (!this.passedColToggle) then
      !this.passedColToggle = false
      !this.colourMenu.setActive('Passed...', false)
    else
      !this.passedColToggle = true
      !this.colourMenu.setActive('Passed...', true)
    endif
  elseif (!mode eq 'FailedToggle') then
    if (!this.failedColToggle) then
      !this.failedColToggle = false
      !this.colourMenu.setActive('Failed...', false)
    else
      !this.failedColToggle = true
      !this.colourMenu.setActive('Failed...', true)
    endif
  endif

  if     (!mode eq 'Elements') then
  !command   = '!!chkStoreView.chosenColour(|Elements|)'
  !title     = 'Elements Colour'
  !refColour = !this.elementColour
  call !!colourSelectLoad(!command, !title, !refColour)

  elseif (!mode eq 'Passed' and !this.passedColToggle) then
  !command   = '!!chkStoreView.chosenColour(|Passed|)'
  !title     = 'Passed Colour'
  !refColour = !this.passedColour
  call !!colourSelectLoad(!command, !title, !refColour)

  elseif (!mode eq 'Failed' and !this.failedColToggle) then
  !command   = '!!chkStoreView.chosenColour(|Failed|)'
  !title     = 'Failed Colour'
  !refColour = !this.failedColour
  call !!colourSelectLoad(!command, !title, !refColour)

  endif

endmethod
-- End of method definition for .colours(STRING)
------------------------------------------------------------------------
--
-- Method:      chosenColour
--
-- Description:
--   Set the highlight colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element,Passed or Failed
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------

-- Define method
define method .chosenColour(!mode is STRING)

  if     (!mode eq 'Elements') then
    !this.elementColour = !!colourSelect.currentColour.background
  do !i indices !this.elements
    !element = !this.elements[!i]
    !colour = !this.elementColour
    ENHANCE $!element COLOUR $!colour
  enddo
  elseif (!mode eq 'Tested') then
    !this.testedColour = !!colourSelect.currentColour.background
  elseif (!mode eq 'Passed') then
    !this.passedColour = !!colourSelect.currentColour.background
  elseif (!mode eq 'Failed') then
    !this.failedColour = !!colourSelect.currentColour.background
  endif

endmethod
-- End of method definition for .chosenColour(STRING)
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Apply the check
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()


  -- Initialise Variables
  !checks     = ARRAY()
  !failedList = ARRAY()
  !passedList = ARRAY()
  !failedItem = ARRAY()
  !passedItem = ARRAY()

  -- Clear Passed & Failed Lists
  !this.failedList.clear()
  !this.passedList.clear()
  !this.checkList.clear()

  -- Get all selected checks
  !selected = !this.check.selection('RTEXT')

  -- If there are no checks selected, then don't do anything
  if(!selected.unset()) then
    !!messageFile.warning(142, 001)
    return
  endif

  -- Initialise Collection List
  !refCollection = ARRAY()

  -- Collect all items in the check list
  do !indexStr values !selected

    -- Set index string to a numeric
    !i = !indexStr.real()

    -- Get the selected class and selected group
    !class = !this.classes.val
    if (!class eq 0) then
      !class = 1
    endif
    !group = !this.groups.val
    if (!group eq 0) then
      !group = 1
    endif

    -- Get types !types is ARRAY
    !typesa = !!chkStore.classes[!class].groups[!group].types
    !types = ''
    -- convert array to be a string
    do !j indices !typesa
      !types = !types & ' ' & !typesa[!j] & ' '
    enddo

    -- Get any selection rules
    !rule = 'true'
    if(!!chkStore.classes[!class].groups[!group].rule.set()) then
      if(!!chkStore.classes[!class].groups[!group].rule.empty().not()) then
        !rule = !!chkStore.classes[!class].groups[!group].rule
      endif
    endif

    -- Collect all items
    --    !collection = !collection.union(!!collectAllFor(!types, !rule, !!checker.ce))
    !coll = ARRAY()
    do !k indices !this.checkItems.rText
      -- First condition allows for collection without a specific type and specific rule
      if (!types.trim() eq '' and !rule.trim() eq 'true') then
        !coll.append(!this.checkItems.rText[!k])
        handle any
          !!alert.error(!!error.text)
          skip
        endhandle
      -- Second condition allows for collection without a specific type
      elseif (!types.trim() eq '' and !rule.trim() neq 'true') then
        var !coll APPEND COLLECT ALL WITH ( $!rule ) FOR $!this.checkItems.rText[$!k]
        handle any
          !!alert.error(!!error.text)
          skip
        endhandle
      else
        var !coll APPEND COLLECT ALL ( $!types ) WITH ( $!rule ) FOR $!this.checkItems.rText[$!k]
        handle any
          !!alert.error(!!error.text)
          skip
        endhandle
      endif
      -- Accumulate collection
      !refCollection.appendArray(!coll)
    enddo

    -- Load check into array
    !checks.append(!!chkStore.classes[!class].groups[!group].checks[!i])

  enddo

  -- Remove duplications
--  !collection.unique()
--  var !sortColl SORT UNIQUE !refCollection DESCENDING
  !refCollection.unique()
  !collection = ARRAY()
  do !index indices !refCollection
    !collection.append(!refCollection[!index].dbRef())
  enddo

  -- General Information about item
  do !indexColl indices !refCollection
    !fullName[!indexColl] = !collection[!indexColl].flnn
  enddo

  -- Extract Information from Checks array
  do !indexChecks indices !checks
    !functions[!indexChecks] = !checks[!indexChecks].function
    !titles[!indexChecks]    = !checks[!indexChecks].description
--    !passed[!indexChecks]    = !checks[!indexChecks].passed
--    !failed[!indexChecks]    = !checks[!indexChecks].failed
    !fTypes[!indexChecks]    = !types
  enddo

  -- Loop through all element and their checks
  do !i indices !collection

    -- Processing Prompt
    !rootPrompt = 'Checking :' & !fullName[!i]
    PROMPT '$!rootPrompt'

    -- Initialise Data for each item checked
    !checkFailed = ARRAY()
    !failures    = ARRAY()

    -- Loop through the functions
    do !fi from 1 to !functions.size()

      -- Ignore id Element type is not in permissible function type
      if(!fTypes[!fi].match(!collection[!i].type) ne 0 or !fTypes[!fi].trim() eq '') then

        !prompt = !titles[!fi] & ' - ' & !fullName[!i]
        PROMPT '$!prompt'

        -- Action function
        !checkReturn = !this.chkFunction(!collection[!i], !checks[!fi])

        -- Skip is check passed
        skip if(!checkReturn.passed)

        -- Load message
        !display = '  ' & !titles[!fi] & ' - '
        !padding = substring('                              ',1,!display.length())

        -- Loop through all message string
        do !j indices !checkReturn.messages

          -- First line
          if(!j eq 1) then
            !checkFailed.append(!display & !checkReturn.messages[!j])

          -- Subsequent lines
          else
            !checkFailed.append(!padding & !checkReturn.messages[!j])
          endif

          -- Element failure refers to
          !failures.append(!collection[!i].string())
        enddo
      endif
    enddo

    -- Items with any failure
    if(!checkFailed.set()) then

      -- Item Name Failed
      !failedList.append('Element: ' & !fullName[!i])
      !failedItem.append(!collection[!i].string())

      -- Reasons for failure
      !failedList.appendArray(!checkFailed)
      !failedItem.appendArray(!failures)

      -- Blank Line
      !failedList.append('')
      !failedItem.append('')
      !this.failedList.append(!collection[!i])

    -- Items that have passed all checks
    else

      -- Item Name Passed
      !passedList.append(!fullName[!i])
      !passedItem.append(!collection[!i].string())
      !this.passedList.append(!collection[!i])
    endif

  enddo

  !this.checkList = !collection

  -- Clear Prompt
  PROMPT DISMISS

  show !!chkResultsView

  -- Populate Passed/Failed lists on the Results form
  !!chkResultsView.passed.dText = !passedList
  !!chkResultsView.passed.rText = !passedItem
  !!chkResultsView.failed.dText = !failedList
  !!chkResultsView.failed.rText = !failedItem

  -- transfer the Failed and Passed lists to the results form
  !!chkResultsView.itemsChecked = !this.checkList
  !!chkResultsView.itemsPassed  = !this.passedList
  !!chkResultsView.itemsFailed  = !this.failedList

  -- Display passed and failed
  !!chkResultsView.passedCount.val  = 'Passed (' & !!chkResultsView.itemsPassed.size() & ')'
  !!chkResultsView.failedCount.val  = 'Failed (' & !!chkResultsView.itemsFailed.size() & ')'

  -- Write current selected tests to CheckList
--  !!chkStoreView.checkList   = !selected

  -- Record the Class, group and Definitions used
  !!chkResultsView.class = !!chkStoreView.classes.dText[!class]
  !!chkResultsView.group = !!chkStoreView.groups.dText[!group]
  !!chkResultsView.definitions = !titles

  -- Highlight passed/failed elements if highlight toggle on
  if (!this.passedColToggle) then
    do !i indices !!chkResultsView.itemsPassed
      !ipassed  = !!chkResultsView.itemsPassed[!i]
      !pcolour = !this.passedColour
      UNENHANCE $!ipassed
      ENHANCE $!ipassed COLOUR $!pcolour
    enddo
      !!chkResultsView.passedCount.background = !this.passedColour
    else
      !!chkResultsView.passedCount.background = !!chkResultsView.background
  endif

  if (!this.failedColToggle) then
    do !i indices !!chkResultsView.itemsFailed
      !ifailed  = !!chkResultsView.itemsFailed[!i]
      !fcolour = !this.failedColour
      UNENHANCE $!ifailed
      ENHANCE $!ifailed COLOUR $!fcolour
    enddo
      !!chkResultsView.failedCount.background = !this.failedColour
    else
      !!chkResultsView.failedCount.background = !!chkResultsView.background
  endif

  -- Update the form set-up gadgets
  !this.setupForm()

endmethod
-- End of method definition for .apply()
------------------------------------------------------------------------
--
-- Method:      chkFunction
--
-- Description:
--   -- Executes the passed check functions on the given item and returns
-- the any errors via the PROCERROR object.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1   R      DBREF          Item to be checked
--    2   R      CHKDEFINITION  Check object

-- Return:
--   [Data Type] [Description]
--   CHKRETURN   Return object from check functions
--
------------------------------------------------------------------------

define method .chkFunction(!item is DBREF, !check is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return        = object CHKRETURN()
  !return.passed = false
  !function      = !check.function

  -- Check Item
  !return  = $!<function>(!item, !check)
  handle any
      -- !return.messages[1] = !!messageFile.messageString(142, 002, !check.function)
      -- Above line modified to give a more specific error
      !return.messages[1] = !!error.text & ' (' & !check.function & ')'

    !return.passed      = false
    return !return
  endhandle

  -- Check if the function passed
  return !return

endmethod
-- End of method definition for .chkFunction(DBREF, CHKDEFINITION) CHKRETURN

------------------------------------------------------------------------
--
-- Method:      class
--
-- Description:
--   Select a class
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .class()

  -- populate the groups gadget
  !!chkStore.classes[!this.classes.selection().real()].listGroups(!this.groups)
  !this.group()

endmethod
-- End of method definition for .class()

------------------------------------------------------------------------
--
-- Method:      group
--
-- Description:
--   Select a group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .group()

  -- populate the Checks gadget
  !!chkStore.classes[!this.classes.selection().real()].groups[!this.groups.selection().real()].listChecks(!this.check)

endmethod
-- End of method definition for .group()

------------------------------------------------------------------------
--
-- Method:      check
--
-- Description:
--   Select a check
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .check()

  -- Setup form
  !this.setupForm()

endmethod
-- End of method definition for .check()

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description:
--   Save results from a check
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .save()

  Using Namespace 'Aveva.Pdms.Presentation'
  !browser = object PMLFILEBROWSER('save')

  !browser.show(|%PDMSUSER%|, '*.txt', 'Save Check Results', false, 'Text File (*.txt)|*.txt', 1)
  -- Initialise Variables
  !file     = !!file(!browser.file())

  if(!file.unset()) then
    return
  endif

  -- Time and User information
  !dateTime = object DATETIME()
  !session  = CURRENT SESSION

  -- Open the file
  !file.open('WRITE')

  -- File header
  !file.writeRecord('Check Report File')
  !file.writeRecord('')
  !file.writeRecord('  Created By : ' & !session.name)
  !file.writeRecord('        Date : ' & !dateTime)
  !file.writeRecord('')

  -- Check Performed
  !file.writeRecord('Checks Performed')
  !file.writeRecord('   Class : ' & !!chkResultsView.class )
  !file.writeRecord('   Group : ' & !!chkResultsView.group )

  -- Loop through checker performed (at check time)
  do !i indices !!chkResultsView.definitions
    !file.writeRecord('           [' & !i & '] ' & !!chkResultsView.definitions[!i] )
  enddo

  !file.writeRecord('')

  -- Summary
  !file.writeRecord('')
  !file.writeRecord('Summary of Checks')
  !file.writeRecord('')
  !file.writeRecord('           Elements passed all tests : ' & !!chkResultsView.itemsPassed.size())
  !file.writeRecord('    Elements failed on or more tests : ' & !!chkResultsView.itemsFailed.size())
  !file.writeRecord('                               Total : ' & !!chkResultsView.itemsChecked.size())
  !file.writeRecord('')

  -- Passed Element
    !file.writeRecord('Element that have passed all checks: ' & !!chkResultsView.itemsPassed.size())

    -- Indent by 4 character
    !file.writeRecord('')
    do !i indices !!chkResultsView.passed.dText
      !file.writeRecord('    ' & !!chkResultsView.passed.dText[!i] )
    enddo
    !file.writeRecord('')

  -- Failed Elements
    !file.writeRecord('Element that have failed one or more checks: '& !!chkResultsView.itemsFailed.size())

    -- Indent by 4 character
    !file.writeRecord('')
    do !i indices !!chkResultsView.failed.dText
      !file.writeRecord('    ' & !!chkResultsView.failed.dText[!i] )
    enddo
    !file.writeRecord('')


  -- Footer
  !file.writeRecord('')
  !file.writeRecord('End of Check Report File')

  -- Close the file
  !file.close()

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      loadFailures
--
-- Description:
--   Wrapper for Failed Items, Class, Group, and Definitions used.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       Array of recorded failures
--    2    R     STRING      Class used
--    3    R     STRING      Group used
--    4    R     ARRAY       Array of Check definitions used
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadFailures(!failures is ARRAY, !class is STRING, !group is STRING, !definitions is ARRAY)

  -- Clear the Check Items List
  !this.removeAll()

  -- Populate Check Items List
  do !i indices !failures
    !this.addDbRef(!failures[!i].dbRef())
  enddo

  -- Populate Classes Option
  !this.classes.select('DTEXT', !class)
  !this.class()

  -- Populate Groups Option
  !this.groups.select('DTEXT', !group)

  -- load list with current group list (--AK--)
     !!chkStore.classes[!this.classes.selection().real()].groups[!this.groups.selection().real()].listChecks(!this.check)
  -- Populate Checks List
  do !i indices !definitions
    !this.check.select('DTEXT', !definitions[!i])
  enddo

  -- Maintain gadgets List
  !this.pullDowns()
  !this.setupForm()

endmethod
-- End of method definition for .loadFailures(ARRAY, STRING, STRING, ARRAY)

------------------------------------------------------------------------
--
-- Method:      saveFailed
--
-- Description:
--   Save failed element and the check information so that they can be
--   reloaded, then re-tested
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .saveFailed()

  Using Namespace 'Aveva.Pdms.Presentation'
  !browser = object PMLFILEBROWSER('save')

  !browser.show(|%PDMSUSER%|, '*.pmldat', 'Save Elements Failing Checks', false, 'PMLDAT Files (*.pmldat)|*.pmldat', 1)

  -- Initialise Variables
  !file     = !!file(!browser.file())

  if(!file.unset()) then
    return  	
  endif

  -- Time and User information
  !dateTime = object DATETIME()
  !session  = CURRENT SESSION

  -- Open the file
  !file.open('WRITE')

  -- File header
  !file.writeRecord('--  Checker Failure Record')
  !file.writeRecord('')
  !file.writeRecord('--  Created By : ' & !session.name)
  !file.writeRecord('--        Date : ' & !dateTime)
  !file.writeRecord('')
  !file.writeRecord('')

  --
  !file.writeRecord('-- Populate the Checker form gadgets.')
  !file.writeRecord('')
  !file.writeRecord('-- Build an Array of all the Failed items.')
  !file.writeRecord('!failures = ARRAY()')
  do !i indices !!chkResultsView.itemsFailed
    !file.writeRecord('!failures.append(|' & !!chkResultsView.itemsFailed[!i] & '|)')
  enddo

  -- Record the Class
  !file.writeRecord('')
  !file.writeRecord('-- Classes Option')
  !file.writeRecord('!class = |' & !!chkResultsView.class & '|')

  -- Record the Group
  !file.writeRecord('')
  !file.writeRecord('-- Groups Option')
  !file.writeRecord('!group = |' & !!chkResultsView.group & '|')

  -- Record the Checks performed at check time
  !file.writeRecord('')
  !file.writeRecord('-- Checks List')
  !file.writeRecord('!checks = ARRAY()')
  do !i indices !!chkResultsView.definitions
    !file.writeRecord('!checks.append(|' & !!chkResultsView.definitions[!i] & '|)')
  enddo

  -- Call the Loading Method
  !file.writeRecord('')
  !file.writeRecord('-- Load the Failed items, Class, Group and Checks ')
  !file.writeRecord('!!chkStoreView.loadFailures(!failures, !class, !group, !checks)')
  -- Footer
  !file.writeRecord('')
  !file.writeRecord('-- End of Checker Failure Record')

  -- Close the file
  !file.close()

endmethod
-- End of method definition for .saveFailed()

------------------------------------------------------------------------
--
-- Method:      loadFailed
--
-- Description:
--   Load failed element and setup form to the defined test
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadFailed()

  -- Initialise Variables
  !file     = !!fileBrowser.file

  if (!file.name().unset()) then
    !!messageFile.warning(146,028)
    return
  endif

  -- Read the first line of the file
  !file.open('READ')
  !line = !file.readRecord()
  !file.close()

  -- Check to see if its a Checker Failure record
  if (!line eq '--  Checker Failure Record') then
    !macro = !file.fullName()
    $M "$!macro"
  else
    !!alert.error('Not a suitable file.')
  endif

endmethod
-- End of method definition for .loadFailed()
------------------------------------------------------------------------
--
-- Method:      loadChecks
--
-- Description:
--   Load Checks via the original Checker form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .loadChecks()

  -- Load chkDefinitions using the original checker load mechanism
  call !!checkerLoad()

  if (!!chkStore.set()) then
    !!chkStore.delete()
  endif

  !!comDefineGlobal(object chkstore())
  !!chkStore.upgrade()


  -- populate the classes gadget
  !!chkStore.listClasses(!this.classes)
  if (!!chkStore.classes.size() gt 0) then
    !this.class()
  endif

  -- Maintain the list gadgets
  !this.update()

  -- Check that the class/group/check descriptions are set
  do !i indices !!chkStore.classes
    if (!!chkStore.classes[!i].description.trim().length() eq 0) then
      !!alert.error('Class title is unset.')
    endif
    do !j indices !!chkStore.classes[!i].groups
      if (!!chkStore.classes[!i].groups[!j].description.trim().length() eq 0) then
        !!alert.error('Group title is unset.')
      endif
      do !k indices !!chkStore.classes[!i].groups[!j].checks
      if (!!chkStore.classes[!i].groups[!j].checks[!k].description.trim().length() eq 0) then
        !!alert.error('Check title is unset.')
      endif
      enddo
    enddo
  enddo

endmethod
-- End of method definition for .loadChecks()
------------------------------------------------------------------------
--
-- Method:      update
--
-- Description:
--   Maintain the List menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update()

  -- Populate addListMenu and removeListMenu
  -- Add Lists
  !menu = !this.addListMenu
  if (!!module().appName.upcase() neq 'ADMIN') then
    !listForm = !!cdcList
    !menu.clear()
    do !i indices !listForm.name.dText
      !menu.add('callback', '$!listForm.name.dText[$!i]', '!this.listLst(|ADD|, |$!i|)')
    enddo
    !this.addMenu.setActive('List', true)
  else
    !menu.clear()
    !menu.add('CALLBACK', 'No list', '')
    !this.addMenu.setActive('List', false)
  endif


  -- Remove Lists
  !menu = !this.removeListMenu
  if (!!module().appName.upcase() neq 'ADMIN') then
    !listForm = !!cdcList
    !menu.clear()
    do !i indices !listForm.name.dText
      !menu.add('callback', '$!listForm.name.dText[$!i]', '!this.listLst(|REMOVE|, |$!i|)')
    enddo
    !this.removeMenu.setActive('List', true)
  else
    !menu.clear()
    !menu.add('CALLBACK', 'No list', '')
    !this.removeMenu.setActive('List', false)
  endif


  -- Activate the List menu as required
  !menu = !this.addListMenu
    !menu.setActive('No list', false)
    handle any
    endhandle
  !menu = !this.removeListMenu
    !menu.setActive('No list', false)
    handle any
    endhandle

endmethod
-- End of method definition for .update()
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close the form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Cease the event driven graphics
  if (!this.designModule) then
    !!edgCntrl.remove('Data Checker Packet')
  endif

  -- Remove all entries List
  !this.unenhanceAllElements()

  -- Remove all and hide the form
  !this.removeAll()
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description:  Tidy the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tidy()

  -- Remove all entries List
  !this.unenhanceAllElements()

  -- Remove all and hide the form
  !this.removeAll()
  !this.hide()


endmethod
------------------------------------------------------------------------
--
-- Method:      unenhanceSelection
--
-- Description:  Unenhance selected elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .unenhanceSelection()

  do !i values !this.checkItems.val
    !selection = !this.checkItems.rText[!i]
    UNENHANCE $!selection
  enddo

endmethod
------------------------------------------------------------------------
--
-- Method:      unenhanceAllElements
--
-- Description:  Unenhance all elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .unenhanceAllElements()

  -- Unhighlight listed elements
  do !i indices !this.elements
    UNENHANCE $!!chkStoreView.elements[$!i]
  enddo

endmethod
