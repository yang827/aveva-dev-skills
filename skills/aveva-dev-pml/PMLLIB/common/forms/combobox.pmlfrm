--
-- Description:
-- comboBox form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   action callback for list selection
--  init()                           -                   form initialisation
--
------------------------------------------------------------------------

-- Define form
setup form !!comboBox

  !!comboBox.formTitle     = ''
  !!comboBox.iconTitle     = ''
  !!comboBox.callback      = '!!comboBox.init()'
  !!comboBox.formRevision  = ' $Revision: 1.5 $ '

  member .textGadget is GADGET

  list .list  at xmin ymin callback '!!comboBox.action()' width 35 height 10

exit
-- End of form definition for !!comboBox

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  if (!this.textGadget.val.unset().not()) then
    -- does the text in the text gadget match any entry in the list
    do !i indices !this.list.dText
      if (!this.list.dText[!i].upcase().matchWild(!this.textGadget.val.upcase() + '*')) then
        !this.list.val = !i
        break
      endif
    enddo
  endif

endmethod
-- End of method definition for .init()


------------------------------------------------------------------------
--
-- Method:      !action()
--
-- Description: action callback for list selection
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .action()

  -- set the text gadget to the selected entry
  !this.textGadget.val = !this.list.selection()

  -- hide the form
  !this.hide()

endmethod
-- End of method definition for .action()
