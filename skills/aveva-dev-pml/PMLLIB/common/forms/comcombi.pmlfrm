-- Created:         Tue Apr 12    10:39:52  2005
--
--
-- Description:
-- Form to simulate a combi gadget
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  comCombi()                       -                   Constructor
--  init(STRING,ARRAY)               -                   Initialisation of the form
--  selectValue()                    -                   method to add the selected to the calling form
--
------------------------------------------------------------------------

setup form !!comCombi resize

list .list at x0 y0 anchor all  width 38 height 10

member .title is STRING
member .gadget is GADGET
member .arrayOfValues is ARRAY

exit
-- End of form definition for !!comCombi
------------------------------------------------------------------------
--
-- Method:      comCombi()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .comCombi()

-- form setup
   !this.formTitle         = 'to be set by the calling form'
   !this.iconTitle         = 'Combi'
   !this.callback          = '!this.init(!this.title, !this.arrayOfValues)'
   !this.cancelCall        = ''
   !this.list.callback     = '!this.selectValue()'

endmethod
-- End of method definition for .comCombi()
------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: Initialisation of the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init(!title is STRING, !arrayOfValues is ARRAY)

!this.formTitle  = !title
!this.list.dText = !arrayOfValues
!this.list.rText = !arrayOfValues

endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
--
-- Method:     selectValue()
--
-- Description: method to add the selected to the calling form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectValue()

if(!this.list.selection().neq('None Found')) then
   !this.gadget.val = !this.list.selection()
endif

!this.hide()

endmethod
-- End of method definition for .selectValue()
