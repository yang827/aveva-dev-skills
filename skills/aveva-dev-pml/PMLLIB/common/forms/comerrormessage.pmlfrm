-- Created:         Fri Jan 17 9:29:13 BST 2003
--
--
-- Description:
-- Error message form for displaying information to the user
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   close the form
--  comErrorMessage()                -
--  init()                           -                   Initialise Form with the message to be displayed
--

-- Define form
setup form !!comErrorMessage BLOCKING resize

-- Message
 frame   .displayFrame at xmin ymax anchor all
  list   .displayMessage at xmin+1 ymax+.2 anchor all width 80 height 15
 exit
  button .dismiss at xmax form-size ymax+0.25 anchor b+r width 8 'Dismiss' cancel
  member .message is ARRAY

-- End of form definition for !!comErrorMessage
exit
------------------------------------------------------------------------
--
-- Method:      .equCreateStd()
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .comErrorMessage()

  !this.callback = '!this.init()'
  !this.formTitle = 'Information Message Panel'
  !this.iconTitle = 'InfoPanel'

  !this.cancelCall          = '!this.close()'
  !this.dismiss.callback    = '!this.close()'

  !dText[1] = ''
  !dText[2] = ''
  !dText[3] = ''
  !dText[4] = '            No Message          '

  !this.displayMessage.dText = !dText

endmethod
-- End of method definition for .commErrorMessage()
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise Form with the message to be displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--
------------------------------------------------------------------------
define method .init()

if( !this.message.empty() ) then
  !this.displayMessage.dText = !this.message
else
  if( !this.message[1].objecttype() eq 'ARRAY' ) then
    !this.displayMessage.setRows(!this.message)
  else
    !this.displayMessage.dText = !this.message
  endif
endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .close()
--
-- Description: close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--
------------------------------------------------------------------------
define method .close()

  !dText = ARRAY()
  !this.message.clear()
  !this.displayMessage.dText = !dText

endmethod
-- End of method definition for .close()
