--
-- Description:
-- Expression builder
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addEntry(STRING)                 -                   add entry to text pane
--  comExprBuilder()                 -                   Constructor
--  init(STRING,ARRAY,ARRAY,ARRAY,GADGET) -                   initialise form
--  ok()                             -                   ok form
--  recordStep()                     -                   record a step
--  removeStep()                     -                   remove a step
--

-- Define form
setup form !!comExprBuilder blocking

  member .gadget is GADGET
  member .textSteps is ARRAY
  member .curPosSteps is ARRAY

  -- Main text pane
  textpane .text 'Expression' at xmin ymax width 65 height 4

  -- Properties frame
  frame .properties 'Properties' at xmin ymax+0.5
    option .reference at xmin+1 ymax width 8
    list   .despList at xmin ymax width 6 height 8
    list   .exprList at xmax+1 ymin width 6 height 8
  exit

  frame .lnames 'Local Names' at xmax+1 ymin
    option .lnidType at xmin+1 ymin.reference width 8
    list   .lnidList at xmin ymax width 15 height 8
  exit

  frame .functions 'Functions' at xmax+1 ymin
    list   .funcList at xmin+1 ymin.lnidList width 8 height 8
  exit

  frame .operators 'Operators' at xmax+1 ymin
    list   .operList at xmin+1 ymin.lnidList width 8 height 8
  exit

  button .ok '  OK  ' at xmin.text ymax+0.5

  button .back ' Back ' at xmax+40 ymin

  button .cancel 'Cancel' at xmax form-size ymin cancel

exit
-- end form definition

------------------------------------------------------------------------
--
-- Method:      .comExprBuilder()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .comExprBuilder()

  -- populate option gadgets
  !dText[1] = 'Current'
  !rText[1] = 'CDPR'
  !dText[2] = 'Local'
  !rText[2] = 'LDPR'
  !dText[3] = 'Template'
  !rText[3] = 'TDPR'

  !this.reference.dText = !dText
  !this.reference.rText = !rText

  !dText.clear()
  !rText.clear()

  !dText[1] = 'Template'
  !rText[1] = 'LNID'
  !dText[2] = 'Dataset'
  !rText[2] = 'MLNID'

  !this.lnidType.dText = !dText
  !this.lnidType.rText = !rText

  ----------------------------------------------------------------
  -- List of functions
  ----------------------------------------------------------------
  !dText.clear()
  !rText.clear()

  var !coordinate coordinate
  if !coordinate.eq('XYZ') then
   !dText[1]  = 'X'
   !dText[2]  = '-X'
   !dText[3]  = 'Y'
   !dText[4]  = '-Y'
   !dText[5]  = 'Z'
   !dText[6]  = '-Z'
  else
  !dText[1]  = 'N'
  !dText[2]  = 'S'
  !dText[3]  = 'E'
  !dText[4]  = 'W'
  !dText[5]  = 'U'
  !dText[6]  = 'D'
  endif
  !dText[7]  = 'AT'
  !dText[8]  = 'POLAR'
  !dText[9]  = 'FROM'
  !dText[10] = 'LOCATE'
  !dText[11] = 'OF TMPL'
  !dText[12] = 'OF PANE'

  !this.funcList.dText = !dText

  ----------------------------------------------------------------
  -- List of operators
  ----------------------------------------------------------------
  !dText.clear()
  !rText.clear()

  !dText[1]  = '+'
  !dText[2]  = '-'
  !dText[3]  = '*'
  !dText[4]  = '/'
  !dText[5]  = '('
  !dText[6]  = ')'
  !dText[7]  = 'SIN'
  !dText[8]  = 'COS'
  !dText[9]  = 'TAN'
  !dText[10] = 'POWER'
  !dText[11] = 'SQRT'
  !dText[12] = 'INT'
  !dText[13] = 'NINT'
  !dText[14] = 'MAX'
  !dText[15] = 'MIN'

  !this.operList.dText = !dText

  -- Set callbacks
  !this.despList.callback  = |!this.addEntry('DESP')|
  !this.exprList.callback  = |!this.addEntry('EXPR')|
  !this.lnidList.callback  = |!this.addEntry('LNID')|
  !this.funcList.callback  = |!this.addEntry('FUNC')|
  !this.operList.callback  = |!this.addEntry('OPER')|
  !this.reference.callback = '!this.text.setFocus()'
  !this.lnidType.callback  = '!this.text.setFocus()'

  !this.back.callback = '!this.removeStep()'

  !this.ok.callback = '!this.ok()'

endmethod
-- End of method definition for .comExprBuilder()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialise form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init(!formTitle is STRING, !desps is ARRAY, !exprs is ARRAY, !lnids is ARRAY, !gadget is GADGET)

  !this.textSteps.clear()
  !this.curPosSteps.clear()

  !this.gadget = !gadget
  !this.formTitle = !formTitle

  if (!desps.set()) then
    !this.despList.dText = !desps
  else
    !this.despList.clear()
  endif
  if (!exprs.set()) then
    !this.exprList.dText = !exprs
  else
    !this.exprList.clear()
  endif
  if (!lnids.set()) then
    if(!lnids[1].upcase() eq 'UNSET') then
      !this.lnidType.active = false
      !this.lnidType.val = 1
      !this.lnidList.clear()
    else
      !this.lnidType.active = true
      !this.lnidType.val = 1
      !this.lnidList.dText = !lnids
    endif
  else
    !this.lnidType.active = false
    !this.lnidType.val = 1
    !this.lnidList.clear()
  endif

  !contents[1] = !gadget.val
  if (!contents[1].unset()) then
    !contents[1] = ''
  endif
  !this.text.val = !contents

  !curPos[1] = 1
  !curPos[2] = !contents[1].length()
  !this.text.setFocus()
  !this.text.setCurPos(!curPos)

  !this.recordStep()

endmethod
-- End of method definition for .init(STRING, ARRAY, ARRAY, ARRAY, GADGET)

------------------------------------------------------------------------
--
-- Method:      .addEntry()
--
-- Description: add entry to text pane
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .addEntry(!type is STRING)

  if (!this.text.val ne !this.textSteps.last()) then
    !this.recordStep()
  endif

  !backSpace = 0

  if (!type eq 'DESP') then
    !newText = '( ' + !this.reference.selection() + ' ' + !this.despList.selection() + ' )'

  elseif (!type eq 'EXPR') then
    !newText = '( ' + !this.reference.selection() + ' ' + !this.exprList.selection() + ' )'

  elseif (!type eq 'LNID') then
    !newText = !this.lnidType.selection() + ' ' + !this.lnidList.selection()

  elseif (!type eq 'OPER') then
    !excludedList = '+-*/()'
    !newText = !this.operList.selection()
    if (!excludedList.match(!newText) eq 0) then
      !newText = !newText + '(  )'
      !backSpace = 2
    endif
  elseif (!type eq 'FUNC') then
      !newText = !this.funcList.selection()
  endif

  -- get the current textpane position
  !curPos = !this.text.curPos()

  !contents = !this.text.val
  if (undefined(!contents[!curPos[1]])) then
    !contents[!curPos[1]] = ''
  endif

  !line = !contents[!curPos[1]]

  if (!line.subString(!curPos[2], 1).trim() ne '') then
    !firstSpace = ' '
  else
    !firstSpace = ''
  endif
  if (!line.subString(!curPos[2] + 1, 1) ne ' ') then
    !secondSpace = ' '
    if (!backSpace ne 0) then
      !backSpace = !backSpace + 1
    endif
  else
    !secondSpace = ''
  endif

  !newLine = !line.subString(1, !curPos[2]) + !firstSpace + !newText + !secondSpace + !line.subString(!curPos[2] + 1)
  !contents[!curPos[1]] = !newLine

  !this.text.val = !contents
  !curPos[2] = !curPos[2] + !newText.length() + !firstSpace.length() + !secondSpace.length() - !backSpace
  !this.text.setCurPos(!curPos)
  !this.text.setFocus()

  !this.recordStep()

endmethod
-- End of method definition for .addEntry(STRING)

------------------------------------------------------------------------
--
-- Method:      .recordStep()
--
-- Description: record a step
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .recordStep()

  !this.textSteps.append(!this.text.val)
  !this.curPosSteps.append(!this.text.curPos())

endmethod
-- End of method definition for .recordStep()

------------------------------------------------------------------------
--
-- Method:      .removeStep()
--
-- Description: remove a step
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .removeStep()

  if (!this.textSteps.size() gt 1) then
    if (!this.text.val eq !this.textSteps.last()) then
      !this.textSteps.removeLast()
      !this.curPosSteps.removeLast()
    endif
  endif

  !this.text.val = !this.textSteps.last()
  !this.text.setCurPos(!this.curPosSteps.last())

  !this.text.setFocus()

endmethod
-- End of method definition for .removeStep()


------------------------------------------------------------------------
--
-- Method:      .ok()
--
-- Description: ok form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- concatenate the textpane contents
  !expression = ''
  do !t values !this.text.val
    if (!t.trim() eq '') then
      !spaces = ''
    else
      !spaces = ' '
    endif
    !expression = !expression + !t + !spaces
  enddo

-- find out were the gadget is from (POS, ORI, REAL.....etc)

  !cart = 'XYZ'

  if(!this.gadget.owner().name().match('ORI').neq(0) and  !cart.match(!this.gadget.name()).neq(0)) then
     !type = 'ORI'
  elseif(!this.gadget.name().eq('POSI') and !this.gadget.owner().name().match('POS').neq(0)) then
     !type = 'EXPLICIT'
  elseif(!this.gadget.name().eq('REAL')) then
     !type = 'REAL'
  elseif(!this.gadget.name().eq('DIR')) then
     !type = 'DIR'
  elseif(!cart.match(!this.gadget.name()).neq(0)) then
     !type = 'CARTESIAN'
  else
     !type = 'NOCHECK'
  endif

-- test the expression is correct

  call !!tmpexpressionchk(!!cdtmppdef.memb.selection().dbref(),!expression,!type)

  !this.gadget.val = !expression
  !this.gadget = object GADGET()

  !this.hide()

endmethod
-- End of method definition for .ok()
