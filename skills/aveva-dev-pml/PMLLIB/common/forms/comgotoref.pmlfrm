--
-- Description:
-- Define a New List
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  comGotoRef()                     -
--  goto()                           -
--  init()                           -
--

setup form !!comGotoRef

  !!comGotoRef.formTitle = 'GoTo Reference'
  !!comGotoRef.iconTitle = 'GoTo Reference'
  !!comGotoRef.callback = '!!comGotoRef.init()'

  -- Use MULTIPLE list so can have no initial selection
  list .refs multiple width 20 length 6

  track 'DESICE' 'CATACE' 'PROPCE' 'ISODCE' 'PADDCE' 'DICTCE' callback '!this.init()'

exit
------------------------------------------------------------------------
define method .comGotoRef()
  !this.refs.callback  = '!!comGotoRef.goto()'
endmethod
-- End of method definition for .comGotoRef()
------------------------------------------------------------------------
-- Populate list with all reference attributes
define method .init()
  !da = ARRAY()
  !ra = ARRAY()
  !atts = !!ce.attributes()
  do !a values !atts
    skip if (!a.trim().length() eq 0)
    !el = !!ce.attribute(!a)
    if ( !el.objectType() eq 'DBREF' and not !el.unset() ) then
      !da.append( !a & '  ' & !el.name )
      !ra.append( !el.string() )
    endif
    !el.delete()
  enddo
  !this.refs.dText = !da
  !this.refs.rText = !ra
endmethod
-- End of method definition for .init()
------------------------------------------------------------------------
define method .goto()
  !where = !this.refs.selection()[1]
  $!where
endmethod
-- End of method definition for .goto()
------------------------------------------------------------------------
