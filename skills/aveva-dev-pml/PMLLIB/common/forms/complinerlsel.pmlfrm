-- Created:         Mon Dec 15 18:19:40 GMT 1997
--
--
-- Description:
-- pline rule selection form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  define()                         -                   define rules callback
--  init()                           -                   form initialisation
--  ok()                             -                   action callback for list selection
--
------------------------------------------------------------------------

-- Define form
setup form !!comPlineRlSel

  !!comPlineRlSel.formTitle     = 'Pline Filter'
  !!comPlineRlSel.iconTitle     = 'Pline Filter'
  !!comPlineRlSel.callback      = '!!comPlineRlSel.init()'
  !!comPlineRlSel.formRevision  = ' $Revision: 1.5 $ '

  member .function is STRING

  list .list 'Available Rules' at xmin ymax+0.6 width 35 height 6

  button .define 'Define Rules...' at xmax-17 ymin-0.4 callback '!!comPlineRlSel.define()'

  button .ok     '  OK  ' at xmin.list ymax.list+0.2 callback '!!comPlineRlSel.ok()' ok
  button .cancel 'Cancel' at xmax form-size ymin  cancel

exit
-- End of form definition for !!comPlineRlSel

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  !dText[1] = 'No Rule'

  !dText.appendArray(!!ruleStore.pLine.getRules())

  !this.list.dText = !dText

  -- if the form owner has an Pline filter then try to select it
  !this.list.select('dtext', !this.owner().pLineFilter)
  handle any
  endhandle

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !define()
--
-- Description: define rules callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .define()

  !!ruleStore.pLine.edit('!!comPlineRlSel.init()')

endmethod
-- End of method definition for .define()


------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: action callback for list selection
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  $!<this.function>

  !this.function = ''

  -- hide the form
  !this.hide()

endmethod
-- End of method definition for .ok()
