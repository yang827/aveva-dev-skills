--
-- File:            comreprules.pmlfrm
--   Type:          Form Definition
--   Group:         Graphic View
--
--    Keyword:      Representation
--    Module:       General
--
-- Author:          Mac Lewis
-- Created:         Mon Jan 05   11:40:01  2009
--
-- Description:
-- Form for setting representation rules
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activate(REAL)                   -                   Activate buttons according to data
--  add()                            -                   Add the rule to the list
--  apply()                          -                   Apply the rules to the current drawlist
--  cancel()                         -                   Cancel form
--  checkForUnsavedChanges()         -                   Give user opportunity to save pending changes
--  colour()                         -                   Select display colour
--  colour(REAL)                     -                   Set display colour
--  comRepRules()                    -                   Constructor
--  expression()                     -                   Test expression
--  init()                           -                   Initialisation
--  list()                           -                   Actions on select in list
--  load()                           -                   Load rules from the selected location
--  load(FILE)                       -                   Load rules from the selected location
--  loadPrevious()                   -                   Load rules from the last selected location
--  ok()                             -                   Ok form
--  remove()                         -                   Remove the selected rule from the list
--  reorder(GADGET,STRING)           -                   Reorder selected row in list
--  replace()                        -                   Replace the rule in the list
--  resetDisplay()                   -                   Reset display to global default representation
--  save()                           -                   Save rules to the selected location
--  save(FILE)                       -                   Save rules to the selected location
--  unsetNegZeroCheck(GADGET,REAL)   -                   Validation
--
------------------------------------------------------------------------

setup form !!comRepRules resize

  !!comRepRules.formTitle = |Representation Rules|
  !!comRepRules.callback  = |!this.init()|

  bar
    add |File| .fileMenu
  exit

  -- Icons
  !downIcon     = !!pml.getPathName(|downarrow16.png|)
  !downDownIcon = !!pml.getPathName(|downdownarrow16.png|)
  !upIcon       = !!pml.getPathName(|uparrow16.png|)
  !upUpIcon     = !!pml.getPathName(|upuparrow16.png|)
  !deleteIcon   = !!pml.getPathName(|deletece16.png|)

  -- Current filename
  path down
  frame .fileFrame |Current File| anchor top+left+right
    text .filename anchor top+left+right at xmin+1.5 width 70 is STRING
  exit

  -- Representation rules
  frame .ruleFrame |Representation Settings| anchor top+left+right at ymax+0.5

    path right
    option .gtype        |Gtype|           anchor top+left tagwidth 5 width 6
    text   .expression   |Rule Expression| anchor top+left+right at xmax+6.2 tagwidth 12 width 40 is STRING

    path down
    button .colour | |  anchor top+left at xmin.gtype+5 ymax+0.8 width 2
    para   .colourName  anchor top+left at xmax+0.2 ymin width 10 lines 1

    toggle .tube         |Tube|          anchor top+left at xmin.expression+0.5 ymax.expression+0.2 tagwidth 7
    toggle .centreline   |Centreline|    anchor top+left tagwidth 7
    option .insulation   |Insulation|    anchor top+left at xmax+3 ymin.tube tooltip |Insulation visibility/translucency| tagwidth 8 width 4
    option .obstruction  |Obstruction|   anchor top+left tooltip |Obstruction visibility/translucency| tagwidth 8 width 4
    text   .level        |Level|         anchor top+left at xmax+4 ymin.tube tagwidth 10 width 3 is REAL format !!integerFmt
    text   .arcTolerance |Arc Tolerance| anchor top+left tagwidth 10 width 8 is REAL format !!distanceFmt

    button .replace      |Replace Selection|  anchor top+left at xmin.gtype ymax form+0.2 width 12
    path right
    button .add          |Add to End of List| anchor top+left width 12

  exit

  -- Representation list
  path down
  frame .listFrame |Representation List| anchor all at ymax+0.5

    list .list anchor all tooltip |Select row to edit rule| columns single zerosel width 66 length 16

    -- Reordering buttons
    button .upUp     tooltip |Move to top|    anchor top+right pixmap "$!<upUpIcon>"     width 16 height 16 at xmax+1 ymin+2
    button .up       tooltip |Move up|        anchor top+right pixmap "$!<upIcon>"       width 16 height 16 at ymax+1
    button .remove   tooltip |Delete|         anchor top+right pixmap "$!<deleteIcon>"   width 16 height 16 at ymax+1
    button .down     tooltip |Move down|      anchor top+right pixmap "$!<downIcon>"     width 16 height 16 at ymax+1
    button .downDown tooltip |Move to bottom| anchor top+right pixmap "$!<downDownIcon>" width 16 height 16 at ymax+1

  exit

  -- Buttons
  path down
  button    .resetDisplay |Reset Display| anchor bottom+left  at xmin form width 12
  path right
  button    .apply        | Apply|        anchor bottom+right at xmax form-size
  path left
  button    .cancel       |Cancel|        anchor bottom+right cancel
  button    .ok           |  OK  |        anchor bottom+right ok

  -- Members
  member .comRepRuleSet     is COMREPRULESET
  member .currentColour     is REAL


exit

------------------------------------------------------------------------
-- Method:      comRepRules
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .comRepRules()

  -- Callbacks
  !this.colour.callback        = |!this.colour()|
  !this.level.callback         = |!this.unsetNegZeroCheck(!this.level, 10)|
  !this.arcTolerance.callback  = |!this.unsetNegZeroCheck(!this.arcTolerance, 10mm)|
  !this.expression.callback    = |!this.expression()|
  !this.list.callback          = |!this.list()|
  !this.upUp.callback          = |!this.reorder(|
  !this.up.callback            = |!this.reorder(|
  !this.down.callback          = |!this.reorder(|
  !this.downDown.callback      = |!this.reorder(|
  !this.add.callback           = |!this.add()|
  !this.replace.callback       = |!this.replace()|
  !this.remove.callback        = |!this.remove()|
  !this.okCall                 = |!this.apply()|
  !this.cancelCall             = |!this.cancel()|
  !this.apply.callback         = |!this.apply()|
  !this.resetDisplay.callback  = |!this.resetDisplay()|

  -- File menu
  !this.newMenu(|fileMenu|)
  !this.fileMenu.add(|callback|, |Save|, |!this.save()|)
  !this.fileMenu.add(|callback|, |Load|, |!this.load()|)
  !this.filename.active = FALSE

  -- Headings
  !headings = ARRAY()
  !headings.append(|Gtype|)
  !headings.append(|Rule|)
  !headings.append(|Colour|)
  !headings.append(|Tube|)
  !headings.append(|Centreline|)
  !headings.append(|Insulation|)
  !headings.append(|Obstruction|)
  !headings.append(|Level|)
  !headings.append(|Arc Tolerance|)
  !this.list.setHeadings(!headings)

  -- Allowable selections
  !this.gtype.dtext       = !this.comRepRuleSet.allowableGtypes()
  !this.insulation.dtext  = !this.comRepRuleSet.translucencySettings()
  !this.obstruction.dtext = !this.comRepRuleSet.translucencySettings()

  -- Defaults
  !this.colour(1)
  !this.tube.val         = TRUE
  !this.centreline.val   = FALSE
  !this.level.val        = 10
  !this.arcTolerance.val = 10mm

  -- Load last used rules
  !this.loadPrevious()
  handle any
    -- Ignore any error from the load
  endhandle

endmethod

------------------------------------------------------------------------
-- Method:      init
--
-- Description:
--   Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .init()

  -- Button activation and gadget initialisation
  !this.activate(1)
  !this.list()

endmethod

------------------------------------------------------------------------
--
-- Method:      unsetNegZeroCheck
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unsetNegZeroCheck(!gadget is GADGET, !default is REAL)

  -- Prevent unset or negative
  if (!gadget.val.unset()) then
    !!alert.error(|Number required|)
    !gadget.val = !default
  elseif (!gadget.val le 0) then
    !!alert.error(|Number must be positive|)
    !gadget.val = !default
  endif

endmethod

------------------------------------------------------------------------
-- Method:      expression
--
-- Description:
--   Test expression
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .expression()

  -- Test the rule expression
  if (!this.expression.val.trim() ne ||) then
    !unusedExpression = object EXPRESSION(!this.expression.val)
  endif

endmethod

------------------------------------------------------------------------
-- Method:      colour
--
-- Description:
--   Select display colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .colour()

  -- Display colour selection form
  call !!colourSelectLoad(|!!comRepRules.colour(!!colourSelectGet())|, |Colour|, !this.currentColour)

endmethod

------------------------------------------------------------------------
-- Method:      colour
--
-- Description:
--   Set display colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .colour(!colour is REAL)

  -- Set colour
  !useColour              = !colour
  !this.colourName.val    = !!colourName(!useColour)
  handle any
    -- If colour is not a named colour then default to colour 1 grey
    !useColour            = 1
    !this.colourName.val  = !!colourName(!useColour)
  endhandle
  !this.currentColour     = !useColour
  !this.colour.background = !useColour
  !this.colourName.refresh()

endmethod

------------------------------------------------------------------------
-- Method:      list
--
-- Description:
--   Actions on select in list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .list()

  -- Button activation
  !this.activate(0)

  -- Update edit gadgets
  if (!this.list.val gt 0 ) then
    !this.gtype.select(      |Dtext|, !this.comRepRuleSet.gtype(!this.list.val))
    !this.insulation.select( |Dtext|, !this.comRepRuleSet.insulation(!this.list.val))
    !this.obstruction.select(|Dtext|, !this.comRepRuleSet.obstruction(!this.list.val))
    !this.expression.val        =     !this.comRepRuleSet.expression(!this.list.val)
    !this.tube.val              =     !this.comRepRuleSet.tube(!this.list.val)
    !this.centreline.val        =     !this.comRepRuleSet.centreline(!this.list.val)
    !this.level.val             =     !this.comRepRuleSet.level(!this.list.val)
    !this.arcTolerance.val      =     !this.comRepRuleSet.arcTolerance(!this.list.val)
    !this.colour(!this.comRepRuleSet.colour(!this.list.val))
  endif

endmethod

------------------------------------------------------------------------
-- Method:      add
--
-- Description:
--   Add the rule to the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .add()

  -- Add rule to end of list and select row just added
  !this.comRepRuleSet.add(!this.gtype.selection(), !this.expression.val, !this.currentColour, !this.tube.val, !this.centreline.val, !this.insulation.selection(), !this.obstruction.selection(), !this.level.val, !this.arcTolerance.val)
  !this.list.setRows(!this.comRepRuleSet.ruleData())
  !this.activate(!this.list.dtext.size())

endmethod

------------------------------------------------------------------------
-- Method:      replace
--
-- Description:
--   Replace the rule in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .replace()

  -- Replace selected rule and select row just replaced
  !initialPosition = !this.list.val
  !this.comRepRuleSet.replace(!this.list.val, !this.gtype.selection(), !this.expression.val, !this.currentColour, !this.tube.val, !this.centreline.val, !this.insulation.selection(), !this.obstruction.selection(), !this.level.val, !this.arcTolerance.val)
  !this.list.setRows(!this.comRepRuleSet.ruleData())
  !this.activate(!initialPosition)

endmethod

------------------------------------------------------------------------
-- Method:      remove
--
-- Description:
--   Remove the selected rule from the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .remove()

  -- Remove selected rule
  if (!!alert.confirm(|Delete the selected row?|) eq |YES|) then
    !this.comRepRuleSet.remove(!this.list.val)
    !this.list.setRows(!this.comRepRuleSet.ruleData())
    !this.activate(1)
  endif

endmethod

------------------------------------------------------------------------
-- Method:      reorder
--
-- Description:
--   Reorder selected row in list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .reorder(!gadget is GADGET, !dummyAction is STRING)

  -- Determine new position in list
  !newPosition = 0
  if (!gadget eq !this.upUp) then
    !newPosition = 1
  elseif (!gadget eq !this.up) then
    !newPosition = !this.list.val - 1
  elseif (!gadget eq !this.down) then
    !newPosition = !this.list.val + 1
  elseif (!gadget eq !this.downDown) then
    !newPosition = !this.list.dtext.size()
  endif

  -- Reorder rows and select row that has moved
  if (!newPosition gt 0) then
    !this.comRepRuleSet.reorder(!this.list.val, !newPosition)
    !this.list.setRows(!this.comRepRuleSet.ruleData())
    !this.activate(!newPosition)
  endif

endmethod

------------------------------------------------------------------------
-- Method:      load
--
-- Description:
--   Load rules from the selected location
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .load()

  -- Check for unsaved changes
  !continue = TRUE
  if (!this.comRepRuleSet.unsavedChanges()) then
    if (!!alert.confirm(|Discard unsaved changes?|) eq |NO|) then
      !continue = FALSE
    endif
  endif

  -- Display file browser to select load file
  if (!continue) then
    !!fileBrowser(!this.comRepRuleSet.directory(), |*.pmldat|, |Representation Rule Sets|, TRUE, |!!comRepRules.load(!!fileBrowser.file)|)
  endif

endmethod

------------------------------------------------------------------------
-- Method:      load
--
-- Description:
--   Load rules from the selected location
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File to be loaded
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .load(!file is FILE)

  -- Load rules from file
  !this.comRepRuleSet.load(!file)
  !this.filename.val = !file.string()
  !this.list.setRows(!this.comRepRuleSet.ruleData())
  !this.activate(1)
  !this.list()

endmethod

------------------------------------------------------------------------
-- Method:      loadPrevious
--
-- Description:
--   Load rules from the last selected location
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .loadPrevious()

  -- Load rules from file
  !this.comRepRuleSet.load()
  !this.filename.val = !this.comRepRuleSet.currentFilename()
  !this.list.setRows(!this.comRepRuleSet.ruleData())
  !this.activate(1)
  !this.list()

endmethod

------------------------------------------------------------------------
-- Method:      save
--
-- Description:
--   Save rules to the selected location
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .save()

  -- Display file browser to select save file
  !!fileBrowser(!this.comRepRuleSet.directory(), |*.pmldat|, |Representation Rule Sets|, FALSE, |!!comRepRules.save(!!fileBrowser.file)|)

endmethod

------------------------------------------------------------------------
-- Method:      save
--
-- Description:
--   Save rules to the selected location
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        File to be saved
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .save(!file is FILE)

  -- Save rules to file
  !this.comRepRuleSet.save(!file)
  !this.filename.val = !this.comRepRuleSet.currentFilename()

endmethod

------------------------------------------------------------------------
-- Method:      activate
--
-- Description:
--   Activate buttons according to data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Row to select in list
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .activate(!position is REAL)

  -- Select row if available
  if (!position gt 0 and !position le !this.list.dtext.size()) then
    !this.list.val = !position
  endif

  -- Activate buttons that act on list selection
  !this.replace.active  = (!this.list.val gt 0)
  !this.upUp.active     = (!this.list.val gt 1)
  !this.up.active       = (!this.list.val gt 1)
  !this.remove.active   = (!this.list.val gt 0)
  !this.down.active     = (!this.list.val gt 0 and !this.list.val lt !this.list.dtext.size())
  !this.downDown.active = (!this.list.val gt 0 and !this.list.val lt !this.list.dtext.size())
  !this.apply.active    = (!this.list.dtext.size() gt 0)
  !this.ok.active       = (!this.list.dtext.size() gt 0)

endmethod

------------------------------------------------------------------------
-- Method:      checkForUnsavedChanges
--
-- Description:
--   Give user opportunity to save pending changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .checkForUnsavedChanges()

  -- Check for unsaved changes
  if (!this.comRepRuleSet.unsavedChanges()) then
    if (!!alert.confirm(|Save changes?|) eq |YES|) then
      !this.save()
    endif
  endif

endmethod

------------------------------------------------------------------------
-- Method:      resetDisplay
--
-- Description:
--   Reset display to global default representation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .resetDisplay()

  -- Reset display to global default representation
  !this.comRepRuleSet.resetDisplay()

endmethod

------------------------------------------------------------------------
-- Method:      apply
--
-- Description:
--   Apply the rules to the current drawlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .apply()

  -- Apply rules to drawlist
  !this.comRepRuleSet.apply()

endmethod

------------------------------------------------------------------------
-- Method:      ok
--
-- Description:
--   Ok form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .ok()

  -- Check for unsaved changes and apply form
  !this.checkForUnsavedChanges()
  !this.apply()

endmethod

------------------------------------------------------------------------
-- Method:      cancel
--
-- Description:
--   Cancel form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .cancel()

  -- Check for unsaved changes
  !this.checkForUnsavedChanges()

endmethod
