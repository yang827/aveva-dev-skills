--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  comSetLoad()                     -                   constructor
--  init()                           -                   form initialisation
--
------------------------------------------------------------------------
setup form !!comSetLoad blocking

  member .module is STRING

  frame .frame1 'Load Appware' at xmin ymax+0.1
    list .list at xmin+1 ymax+0.1 width 30 height 4
  exit

  -- Bottom Line
  path   down
  vdist  0.5
  halign right

  button .ok '  OK  ' at x0 ymax+1 ok

  button .cancel 'Cancel' at xmax.list-size ymin cancel

exit
-- End of form definition for !!comSetLoad

------------------------------------------------------------------------
--
-- Method:      !comSetLoad()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .comSetLoad()

  !this.callback = '!this.init()'
  !this.iconTitle = 'Select Binary'

  -- get the moduleswitch.pmlfnc macro
  !moduleSwitch = '$m ' + '"' + !!pml.getPathName('moduleswitch.pmlfnc') + '"'

  !this.okCall = !moduleSwitch + ' $$!<this.module> $$!<this.list> TRUE'

  !this.module = ''

endmethod
-- End of method definition for .comSetLoad()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  !dText = ARRAY()
  !rText = ARRAY()

  !this.formTitle = 'Select ' + !this.module + ' Application Binary'

  !sessionData    = CURRENT SESSION
  !user           = !sessionData.user().name

  -- check if USER binary for module exists
  !binFile = object FILE('%PDMSUSER%/' + !this.module.upcase() + !user + '.bin')
  if (!binFile.exists()) then
    !dText.append(!user + '''s Binary')
    !rText.append('USER')
  endif

  -- check if DEFAULT binary for module exists
  !binFile = object FILE('%PDMSDFLTS%/' + !this.module.upcase() + '.bin')
  if (!binFile.exists()) then
    !dText.append('Default Binary')
    !rText.append('DEFAULT')
  endif

  -- get list of binary files matching passed module name
  !binFileString = '"%PDMSUSER%/' + !this.module.upcase() + '*.bin"'
  var !fileArray SPLIT DIRECTORY $!<binFileString>
  handle any
    !fileArray = ARRAY()
  endhandle

  -- loop through files in list
  do !binFileString values !fileArray
    !name  = !binFileString.after(!this.module.upcase()).before('.bin')
    if(!name ne !user and !name.empty().not()) then
      !dText.append(!name + '''s Binary')
      !rText.append('NAME\' + !name)
    endif
  enddo

  !dText.append('MACRO Files')
  !rText.append('MACROS')

  !this.list.dText = !dText
  !this.list.rText = !rText

endmethod
-- End of method definition for .init()
