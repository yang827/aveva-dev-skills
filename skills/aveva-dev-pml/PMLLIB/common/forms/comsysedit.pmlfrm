-- File:            comsysedit.pmlfrm
--   Type:          Form Definition
--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        common
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Thu Feb 12 07:46:20 GMT 1998
--
--
-- Description:
-- Form to edit options available in all modules
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  comSysEdit()                     -                   Constructor
--  display()                        -                   Display settings after init/load
--  init()                           -                   Initialisation
--  load()                           -                   load the defaults
--  ok()                             -                   action for ok callback
--  save()                           -                   save the settings
--
------------------------------------------------------------------------

-- Define form
setup form !!comSysEdit

  !!comSysEdit.formTitle     = 'System Settings'
  !!comSysEdit.iconTitle     = 'System'
  !!comSysEdit.callback      = '!!comSysEdit.init()'
  !!comSysEdit.formRevision  = ' $Revision: 1.11 $ '

  -- local form data store
  member .data is COMSYSOPT

  -- Body of form definition
  bar
    add 'File' .fileMenu
  exit

  frame .options 'System Options' at xmin ymax+0.2 width 24
    toggle .alarm ' Beep On Error' at xmin+1 ymax
    toggle .mainToolBar ' Show Main Toolbar' at xmin ymax+0.2
    toggle .largeIcons 'Large Icons ' at xmin ymax+0.2
    toggle .clickPop 'Click window to raise' at xmin ymax+0.2
  exit

  button .ok     '  OK  ' at x0 ymax+0.5 ok
  button .cancel 'Cancel' at xmax form-size ymin  cancel

exit
-- End of form definition for !!comSysEdit

------------------------------------------------------------------------
--
-- Method:      !comSysEdit()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   None
--
------------------------------------------------------------------------

define method .comSysEdit()

  -- build menu bar
  !this.newMenu('fileMenu')
  !this.fileMenu.add('callback', 'Save', '!!comSysEdit.save()')
  !this.fileMenu.add('callback', 'Load', '!!comSysEdit.load()')

  -- set gadget callbacks
  !this.alarm.callback = '!!comSysEdit.data.alarm(!!comSysEdit.alarm.val)'
  !this.mainToolBar.callback = '!!comSysEdit.data.mainToolBar(!!comSysEdit.mainToolBar.val)'
  !this.largeIcons.callback = '!!comSysEdit.data.largeIcons(!!comSysEdit.largeIcons.val)'
  !this.clickPop.callback = '!!comSysEdit.data.clickPop(!!comSysEdit.clickPop.val)'
  !this.okCall = '!!comSysEdit.ok()'

endmethod
-- End of method definition for .comSysEdit()

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: Display settings after init/load
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .display()

  -- (re)initialise form gadgets to main data settings
  !this.alarm.val = !this.data.alarm()
  !this.mainToolBar.val = !this.data.mainToolBar()
  !this.largeIcons.val = !this.data.largeIcons()
  !this.clickPop.val = !this.data.clickPop()

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Initialisation
--
-- Method Type: Procedure
-- Arguments:
--   None
--
------------------------------------------------------------------------

define method .init()

  -- copy the current global settings and unset the global flag
  !this.data = !!comSysOpt.localCopy()

  -- initialise form gadgets to main data settings
  !this.display()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: save the settings
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .save()

  -- save all the data
  !this.data.save()

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load the defaults
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- load the data
  !this.data.load()

  -- reinitialise form gadgets to main data settings
  !this.display()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: action for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- set all the global representation options
  !this.data.copyToGlobal()

endmethod
-- End of method definition for .ok()
