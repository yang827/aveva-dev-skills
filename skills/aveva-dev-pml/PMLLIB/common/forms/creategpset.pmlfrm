--
--
-- Description:
-- Create System
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  createGpset()                    -
--  initialise()                     -                   Initialise form
--  name()                           -                   check the name is ok
--  ok()                             -                   create the Gpset
--

-- Define form
setup form !!createGpset

  member .owner is DBREF

-- Body of form
  text .name 'Name       ' width 20 scroll 40 is STRING
  path down
  text .func 'Function   ' width 20 scroll 40 is STRING
  text .desc 'Description' width 20 scroll 40 is STRING

  -- Apply/Dismiss
  button .ok      ' OK '   at xmin form-0    ymax+0.25 ok
  button .cancel  'Cancel' at xmax form-size ymin      cancel

exit

-- End of form definition for !!createGpset

------------------------------------------------------------------------
--
-- Method:      CreateGpset
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createGpset()

  !this.formTitle     = 'Create Group'
  !this.iconTitle     = 'Gpset'
  !this.initcall      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1 $ '

  !this.ok.callback     = '!this.ok()'
  !this.name.callback   = '!this.name()'

endmethod

-- End of method definition for .createGpset()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Check Write Access of the database owning the current element.
  !dbwrite = dbwrite
  if (!dbwrite.not()) then
    return error 1 'Read Only Database'
  endif

 if (!!ce.hardType neq 'GPWL' and !!ce.hardType neq 'GPSET') then
   return error 1 'You can only create Group Sets below a Group World (GPWL) or another Group Set(GPSET)'
 endif
 !this.name.val= 'unset'
 !this.func.val= 'unset'
 !this.desc.val= 'unset'
 -- Store where we are in the database
 !this.owner=!!ce

endmethod

-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      name
--
-- Description: check the name is ok
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .name()

 !name = !!checkName(!this.name.val,'NEW')
 if (!name.unset()) then
  !this.name.val = 'unset'
  !this.name.setFocus()
 else
  !this.name.val=!name
 endif

endmethod

-- End of method definition for .name()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description: create the Gpset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ok()

 !!ce=!this.owner

if (!this.name.val.unset()) then
  !answer=!!alert.confirm('Is it OK to leave the Group unnamed')
  if (!answer eq 'YES') then
    NEW Gpset
  else
    hide !!createGpset
    show !!createGpset
    return
  endif
else
  NEW GPSET $!this.name.val
endif

if (!this.func.val.set()) then
  FUNC '$!this.func.val'
endif
if (!this.desc.val.set()) then
  DESC '$!this.desc.val'
endif

!!group.init()

endmethod

-- End of method definition for .ok()
