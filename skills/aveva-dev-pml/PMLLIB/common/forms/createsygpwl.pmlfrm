--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          M.A.Ward
-- Created:         Feb 2007
--
--
-- Description:
-- Create System Group World
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  createSyGpwl()                   -
--  initialise()                     -                   Initialise form
--  name()                           -                   check the name is ok
--  ok()                             -                   create the sygpwl
--

-- Define form
setup form !!createSyGpwl

  member .owner is DBREF

-- Body of form
  text .name 'Name       ' width 20 scroll 40 is STRING
  path down
  text .func 'Function   ' width 20 scroll 40 is STRING
  text .desc 'Description' width 20 scroll 40 is STRING
  text .purp 'Purpose    ' width 4 is STRING

  -- Apply/Dismiss
  button .ok      ' OK '   at xmin form-0    ymax+0.25 ok
  button .cancel  'Cancel' at xmax form-size ymin      cancel

exit

-- End of form definition for !!createSyGpwl

------------------------------------------------------------------------
--
-- Method:      CreateSyGpwl
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createSyGpwl()

  !this.formTitle     = 'Create System Group World'
  !this.iconTitle     = 'SyGpwl'
  !this.initcall      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1 $ '

  !this.ok.callback     = '!this.ok()'
  !this.name.callback   = '!this.name()'

endmethod

-- End of method definition for .createSyGpwl()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

 !this.name.val= 'unset'
 !this.func.val= 'unset'
 !this.desc.val= 'unset'
 !this.purp.val= 'unset'
 -- Store where we are in the database
 !this.owner=!!ce
endmethod

-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      name
--
-- Description: check the name is ok
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .name()

 !name = !!checkName(!this.name.val,'NEW')
 if (!name.unset()) then
  !this.name.val = 'unset'
  !this.name.setFocus()
 else
  !this.name.val=!name
 endif

endmethod

-- End of method definition for .name()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description: create the sygpwl
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ok()

 !!ce=!this.owner

if (!this.name.val.unset()) then
  !answer=!!alert.confirm('Is it OK to leave the System Group World unnamed')
  if (!answer eq 'YES') then
    NEW SYGPWL
  else
    hide !!createSyGpwl
    show !!createSyGpwl
    return
  endif
else
  NEW SYGPWL $!this.name.val
endif
!newEle = !!ce
!ownerName = !!ce.owner.name

if (!this.func.val.set()) then
  FUNC '$!this.func.val'
endif
if (!this.desc.val.set()) then
  DESC '$!this.desc.val'
endif
if (!this.purp.val.set()) then
  PURP $!this.purp.val
endif

END

if (!!systemHierarchy.trackCE.val) then
  !!systemHierarchy.trackNewElement(!newEle)
else
	!!systemHierarchy.systemExplorer.selectElement(!ownerName)
endif
endmethod
-- End of method definition for .ok()
