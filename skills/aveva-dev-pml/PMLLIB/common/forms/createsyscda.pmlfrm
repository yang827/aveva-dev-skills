--
--
-- Description:
-- Create System
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkRef(GADGET,STRING)          -                   check the reference name exists and is of the correct type
--  createSyscda()                   -
--  initialise()                     -                   Initialise form
--  name()                           -                   check the name is ok
--  ok()                             -                   create the Syscda
--

-- Define form
setup form !!createSyscda

  member .owner is DBREF

-- Body of form
  text .name 'Name           ' width 20 scroll 40 is STRING
  path down
  text .func 'Function       ' width 20 scroll 40 is STRING
  text .desc 'Description    ' width 20 scroll 40 is STRING
  text .tspe 'Tracing Spec   ' width 20 scroll 40 is STRING
  text .pspe 'Piping Spec    ' width 20 scroll 40 is STRING
  text .ispe 'Insulation Spec' width 20 scroll 40 is STRING
  text .flur 'Fluid Reference' width 20 scroll 40 is STRING
  text .ptsp 'Paint Spec     ' width 20 scroll 40 is STRING

  -- Apply/Dismiss
  button .ok      ' OK '   at xmin form-0    ymax+0.25 ok
  button .cancel  'Cancel' at xmax form-size ymin      cancel

exit

-- End of form definition for !!createSyscda

------------------------------------------------------------------------
--
-- Method:      CreateSyscda
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createSyscda()

  !this.formTitle     = 'Create System Schematic Data'
  !this.iconTitle     = 'Syscda'
  !this.initcall      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1 $ '

  !this.ok.callback     = '!this.ok()'
  !this.name.callback   = '!this.name()'
  !this.tspe.callback   = '!this.checkRef('
  !this.pspe.callback   = '!this.checkRef('
  !this.ispe.callback   = '!this.checkRef('
  !this.flur.callback   = '!this.checkRef('

endmethod

-- End of method definition for .createSyscda()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

 !this.name.val= 'unset'
 !this.func.val= 'unset'
 !this.desc.val= 'unset'
 !this.tspe.val= 'unset'
 !this.pspe.val= 'unset'
 !this.ispe.val= 'unset'
 !this.flur.val= 'unset'
 !this.ptsp.val= 'unset'
 -- Store where we are in the database
 !this.owner=!!ce

endmethod

-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      name
--
-- Description: check the name is ok
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .name()

 !name = !!checkName(!this.name.val,'NEW')
 if (!name.unset()) then
  !this.name.val = 'unset'
  !this.name.setFocus()
 else
  !this.name.val=!name
 endif

endmethod

-- End of method definition for .name()

------------------------------------------------------------------------
--
-- Method:      ok
--
-- Description: create the Syscda
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ok()

 !!ce=!this.owner

if (!this.name.val.unset()) then
  !answer=!!alert.confirm('Is it OK to leave the System schematic data unnamed')
  if (!answer eq 'YES') then
    NEW SYSCDA
  else
    hide !!createSyscda
    show !!createSyscda
    return
  endif
else
  NEW SYSCDA $!this.name.val
endif
!newEle = !!ce
!ownerName = !!ce.owner.name

if (!this.func.val.set()) then
  FUNC '$!this.func.val'
endif
if (!this.desc.val.set()) then
  DESC '$!this.desc.val'
endif

if (!this.tspe.val.set()) then
  TSPE $!this.tspe.val
endif
if (!this.pspe.val.set()) then
  PSPE $!this.pspe.val
endif
if (!this.ispe.val.set()) then
  ISPE $!this.ispe.val
endif
if (!this.flur.val.set()) then
  FLUR $!this.flur.val
endif
PTSPE '$!this.ptsp.val'

END

if (!!systemHierarchy.trackCE.val) then
  !!systemHierarchy.trackNewElement(!newEle)
else
	!!systemHierarchy.systemExplorer.selectElement(!ownerName)
endif
endmethod

-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      checkRef
--
-- Description: check the reference name exists and is of the correct type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkRef(!gadget is GADGET, !dummyAction is STRING)

 !name = !!checkName(!gadget.val,'OLD')
 if (!name.unset()) then
  !gadget.val = 'unset'
  !gadget.setFocus()
 else
  -- Is the name of the correct type
  !gadget.val=!name
  !type = !name.dbref().type
  if (!gadget.tag.matchwild('*Spec*')) then
    if (!type neq 'SPEC') then
      !!alert.error('Name entered is not a Spec')
      !gadget.val = 'unset'
      !gadget.setFocus()
    endif
  elseif (!gadget.tag.matchwild('*Flui*')) then
    if (!type neq 'FLUI') then
      !!alert.error('Name entered is not a Fluid')
      !gadget.val = 'unset'
      !gadget.setFocus()
    endif
  endif
 endif

endmethod
-- End of method definition for .name()
