--
-- File:            dbchanges.pmlfrm
--   Type:          Form Definition
--   Group:         Searching for elements in the database
--     Keyword:     FIND
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Jul 16 10:47:26 BST 1997
--
--
-- Description:
-- Generates a list of changed/created from the current
-- hierarchical position.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!dbChanges

-- Define form
setup form !!dbChanges

  !!dbChanges.formTitle     = 'Changes'
  !!dbChanges.iconTitle     = ''
  !!dbChanges.callback      = 'call !!dbChangesInit()'
  !!dbChanges.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition

  -- Frame
  frame .dateFrame |Dates/Times| at xmin y0.5

    frame .afterFrame |After|
      text .afterHours |Time (hh:mm)| call |call !!dbChangesDate('AFTER')| width 2 scroll 2 integer min 0 max 23
      text .afterMins |:| at xmax ymin call |call !!dbChangesDate('AFTER')| width 2 scroll 2 integer min 0 max 59

      text .afterDay |Date |at xmax.afterHours-size ymax+0.25 call |call !!dbChangesDate('AFTER')| width 2 scroll 2 integer min 1 max 31
      option .afterMonth at xmax+1 ymin call |call !!dbChangesDate('AFTER')| width 8
      text .afterYear  at xmax+1 ymin call |call !!dbChangesDate('AFTER')| width 4 scroll 4 integer min 1996 max 2020

      frame .aSesFrame |Session Data| at xmin.afterHours ymax+0.25
        path down
        para .aSesData    width 36 lines 1
        para .aSesDate    width 36 lines 1
        para .aSesTag     text 'Comment :'
        para .aSesComment at xmax ymin width 25 lines 2
      exit
    exit

    frame .beforeFrame |Before| at xmin.afterFrame ymax+0.25
      text .beforeHours |Time (hh:mm)| call |call !!dbChangesDate('BEFORE')| width 2 scroll 2 integer min 0 max 23
      text .beforeMins |:| at xmax ymin  call |call !!dbChangesDate('BEFORE')| width 2 scroll 2 integer min 0 max 59

      text .beforeDay |Date | at xmax.beforeHours-size ymax+0.25 call |call !!dbChangesDate('BEFORE')| width 2 scroll 2 integer min 1 max 31
      option .beforeMonth at xmax+1 ymin call |call !!dbChangesDate('BEFORE')| width 8
      text .beforeYear at xmax+1 ymin call |call !!dbChangesDate('BEFORE')| width 4 scroll 4 integer min 1996 max 2020

      frame .bSesFrame |Session Data| at xmin.beforeHours ymax+0.25
        path down
        para .bSesData    width 36 lines 1
        para .bSesDate    width 36 lines 1
        para .bSesTag     text 'Comment :'
        para .bSesComment at xmax ymin width 25 lines 2
      exit
    exit
  exit

  -- List of elements
  list .list |Change List| at xmax.dateFrame+0.5 ymin.dateFrame-0.25 width 39 length 19

  -- Information
  frame .infoFrame |Information| at xmin.list ymax.list

    para .totTag text |Elements Processed : |
    path down
    halign right
    para .modTag text |Modified : |
    para .crtTag text |Created  : |

    para .total    at xmax.totTag ymin.totTag width 18 lines 1
    para .modTotal at xmax.modTag ymin.modTag width 18 lines 1
    para .crtTotal at xmax.crtTag ymin.crtTag width 18 lines 1

  exit


  -- Dismiss
  button .dismiss |Dismiss| at xmax form-size ymax form+0.2 cancel
  button .search  |Search| at xmin form-0 ymin call |call !!dbChanges()|

  -- Form Members
  member .fromSession is REAL
  member .toSession   is REAL

exit
-- End of form definition for !!dbChanges
