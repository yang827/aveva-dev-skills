--
--
-- Description:
-- Graphic plane definition.
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close form and tidy
--  definePlane()                    -                   Constructor
--  initialise()                     -                   Constructor
--  pickOrientation(STRING)          -                   Setup to define orientation using edg
--  preview()                        -                   Preview the plane
--  runAction()                      -                   Action carried out on applying form
--  setWrt()                         -                   Set up with new wrt item
--  setup(STRING,STRING,PLANE)       -                   Setup data for form to be shown
--  setupForm()                      -                   Setup form to current grid definition
--
------------------------------------------------------------------------

-- Define form
setup form !!definePlane

  !!definePlane.formTitle     = 'Define Plane'
  !!definePlane.iconTitle     = 'PlaneDef'
  !!definePlane.callback      = '!!definePlane.initialise()'
  !!definePlane.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition
  -- Positioning Gadgets
  frame .positionFrame 'Position' at x1 ymax
    path down
    option .ew width 5
    option .ns width 5
    option .ud width 5
    text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
    text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
    text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
--     text   .x     at xmax+1 ymin.ew width 14 is REAL
--     text   .y     at xmin   ymin.ns width 14 is REAL
--     text   .z     at xmin   ymin.ud width 14 is REAL
    toggle .xFlag at xmax+1 ymin.ew
    toggle .yFlag at xmin   ymin.ns
    toggle .zFlag at xmin   ymin.ud

  exit

  -- Orientation Gadgets and Setting
  frame .orientationFrame 'Orientation' at xmin ymax

    -- EDG Set orientation
    button .edgOri3 pixmap width 24 height 24  callback '!!definePlane.pickOrientation(''3picks'')'
    path right
    button .edgOri2 pixmap width 24 height 24  callback '!!definePlane.pickOrientation(''2picks'')'

    text .yDir 'Y is ' at x1   ymax+0.25 width 24 is STRING
    text .zDir 'Z is ' at xmin ymax width 24 is STRING
    halign right
    path down
    paragraph .xDir width 31 lines 1
    halign left
  exit

  --  Reference (wrt)
  halign right
  text .wrt 'wrt' callback '!!definePlane.setWrt()' width 26 string

  -- Apply/Dismiss
  button .apply   ' OK '   at xmin form-0    ymax form+0.25 callback '!!definePlane.runAction()' ok
  button .dismiss 'Cancel' at xmax form-size ymin           callback '!!definePlane.close()' cancel

  -- Form Members
  -- Plane definition
  member .plane        is PLANE

  -- Aid numbers for position & axes
  member .aidNumber    is REAL

  -- Form Control Members
  -- Position
  member .position     is POSITIONLINK
  -- Orientation
  member .orientation  is ORIENTATIONLINK

  -- Plane Size
  member .planeSize    is REAL
  !!definePlane.planeSize = 5000mm

  -- Description
  member .description  is STRING
  !!definePlane.description = 'Default Plane Definition'

  -- Action on apply
  member .action       is STRING

  -- Has form been shown before
  member .shownBefore  is BOOLEAN
  !!definePlane.shownBefore = false

exit
-- End of form definition for !!definePlane

------------------------------------------------------------------------
--
-- Method:      definePlane
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definePlane()

  -- set icons
  !this.edgOri3.addPixmap(!!pml.getPathName('ori3points24.png'))
  !this.edgOri2.addPixmap(!!pml.getPathName('ori2points24.png'))

   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!definePlane.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!definePlane.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!definePlane.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!definePlane.preview()')

  -- Link Orientation Gadgets to Object
  !this.orientation.linkInput('!!definePlane.orientation', 'Y', !this.yDir, 'Z', !this.zDir, 'X', !this.xDir)

  -- Set Orientation Action
  !this.orientation.setAction('!!definePlane.preview()')
  !this.shownBefore = true

  -- Aid Lines Number
  if(!this.aidNumber.unset()) then
    !this.aidNumber = !!aidNumbers.add(!this.plane)
  endif

endmethod
-- End of method definition for .definePlane()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Form has not been shown before, run constructor
  if(!this.shownBefore.not()) then
    !this.definePlane()
  endif

  -- Setup form
  !this.setupForm()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description:
--   Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)
  !this.orientation.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Hide Modification Plane
  !!aidNumbers.hide(!this.aidNumber)

  -- Revert the edg graphics back
  !!edgCntrl.retrieve()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      runAction
--
-- Description:
--   Action carried out on applying form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .runAction()

  -- Write gadget data for form plane object
  !this.plane.position    = !this.position.get()
  !this.plane.orientation = !this.orientation.get()

  -- Action
  $!this.action

  -- Close
  !this.close()

endmethod
-- End of method definition for .runAction()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Description
--    2   R      STRING      Action to be carried out on apply
--    3   R      PLANE       Reference plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!dummyDescription is STRING, !actionCommand is STRING, !newPlane is PLANE)

  -- If form is already shown, don't allow it to be shown again.
  if(!this.shown()) then
    !!alert.error('Plane definition form is already in use (' & !this.description & ')')
    return error 1 noalert
  endif

  -- Remove Aid numbers for position and orientation tags
  !this.action = !actionCommand
  !this.plane  = !newPlane

  -- If already shown, then re-initialise
  if(!this.shown()) then
    !this.setupForm()
  endif

endmethod
-- End of method definition for .setup(STRING, STRING, PLANE)

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description:
--   Setup form to current grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupForm()

  -- Link Position Option Gadgets to the current co-ordinate system
  var !coordinate coordinate
  !this.position.linkOption('!!definePlane.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- If plane is unset, then initialise it to default 000
  if(!this.plane.unset()) then
    !this.plane.position    = object POSITION('E0 N0 U0')
    !this.plane.orientation = object ORIENTATION('Y is N')
  endif

  -- Set with respect to
  !this.position.setWrt(!this.plane.position.origin)
  !this.orientation.setWrt(!this.plane.position.origin)

  -- Load form with plane definition
  !this.position.setPositionForce(!this.plane.position)
  !this.orientation.setOrientation(!this.plane.orientation)

  -- Set form wrt gadget
  !this.setWrt()

endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description:
--   Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Write data to plane member
  -- Reference plane
  !newPlane = object PLANE()
  !newPlane.position    = !this.position.get()
  !newPlane.orientation = !this.orientation.get()

  -- Replace current definition
  !!aidNumbers.replace(!this.aidNumber, !newPlane)

  -- Display Plane
  !gphPlane = object GPHPLANE()
  !gphPlane.gphPlane(!newPlane,!this.aidNumber)
  !gphPlane.filled(true)
  !gphPlane.draw()

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      pickOrientation
--
-- Description:
--   Setup to define orientation using edg
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Ori definition type  3picks
--                                                2picks
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pickOrientation(!type is STRING)

  -- Define a pickpacket
  !packet          = object EDGPACKET()
  !packet.orientationLink('!!definePlane.orientation', 'Orientate Plane')

  -- Two pick plane
  if(!type.upcase() eq '2PICKS') then
    -- Define specific for "definePlane" orientation
    !packet.pickPacket.plane2Pnts(!this.position.get())
  endif

  !packet.remove   = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickOrientation(STRING)
