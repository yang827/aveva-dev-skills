--
--
-- Description:
-- Display grid system
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  allocateGrid()                   -                   Find grid number in display list or add grid to display list and allocate aid numbers
--  deleteGrid()                     -                   Delete grid system
--  displayGrids()                   -                   Constructor
--  gridSystemList()                 -                   Update/create passed aid number with grid definition
--  initialise()                     -                   Initialisation of form
--  labelType()                      -                   Change label type
--  modifyGrid()                     -                   Modify grid system
--  pickPos()                        -                   Pick position to display grid coords
--  pickReturn(ANY)                  -                   Process result of pick
--  plantGridPacket(GPHTHREEDPLANTGRID) EDGPACKET           Plant Grid Definition Packet
--  preview()                        -                   Preview the grid
--  radialGridPacket(GPHTHREEDRADIALGRID) EDGPACKET           Radial Grid Definition Packet
--  reinitialise(DBREF)              -                   Initialisation of form following modify or create
--  remove()                         -                   Remove currently displayed grid from arrays
--  selectAxes()                     -                   Change label type
--  setGridNumber()                  -                   Set position in displayed grid array for currently selected grid
--  setLimits()                      -                   Set view limits to grid
--  tidy()                           -                   Hide currently displayed grid
--
------------------------------------------------------------------------

-- Define form
setup form !!displayGrids resize

  !!displayGrids.formTitle     = 'User Grid Systems'
  !!displayGrids.iconTitle     = 'Gridsystem'
  !!displayGrids.formRevision  = ' $Revision: 1.0 $ '

  -- Bar menu
  bar
  exit

  -- Grid systems
  list .gridSystemList |Grid Systems| anchor all width 24 length 8

  -- Currently displayed grid system
  frame .gridNameTitle |Displaying grid system| anchor left+right+bottom at xmin ymax+0.2
    para .gridName anchor left+right+bottom width 24 lines 1
    button .hide 'Hide' anchor left+bottom at xmin ymax width 5
  exit

  -- Options
  frame .labelType 'Display' anchor left+bottom at xmin+3 ymax+0.2
    path down
    rtoggle .axes    ' Axes only'       states || |AXES|
    rtoggle .id      ' Gridline IDs'    states || |ID|
    rtoggle .offset  ' Spacings'        states || |OFFSET|
    rtoggle .enu     ' Coordinates'     states || |ENU|
  exit

  -- Display axes
  button .selectAxes 'Select display axes...' anchor left+bottom at xmin ymax+0.2 width 18

  -- Set limits
  button .setLimits 'Set View Limits to Grid' anchor left+bottom at xmin ymax+0.2 width 18

  -- Apply/Dismiss
  button .apply   'Display' anchor left+bottom at xmin form ymax+0.2 width 6
  button .dismiss 'Close' anchor right+bottom at xmax form-size ymin width 6 ok

  -- Grid definitions
  member .gridType         is STRING
  member .plantGrid        is GPHTHREEDPLANTGRID
  member .radialGrid       is GPHTHREEDRADIALGRID

  -- Display grid refs
  member .displayedGrids   is ARRAY

  -- Flags to show which grids currently displayed
  member .gridShown        is ARRAY

  -- Aid numbers for grids
  member .aidNumber        is ARRAY

  -- Aid numbers for plantgrids
  member .aidNumberGridxy  is ARRAY
  member .aidNumberGridxz  is ARRAY
  member .aidNumberGridzy  is ARRAY

  -- Grid systems
  member .gridSystems      is ARRAY

  -- Current grid
  member .systemGrid       is DBREF
  member .gridNumber       is REAL

  -- Axes offsets for drawing (0 is draw thru grid position, n is draw thru offset n)
  member .xPlaneDraw       is BOOLEAN
  member .yPlaneDraw       is BOOLEAN
  member .zPlaneDraw       is BOOLEAN
  member .xOffsetThru      is REAL
  member .yOffsetThru      is REAL
  member .zOffsetThru      is REAL

exit
-- End of form definition for !!plantGrids

------------------------------------------------------------------------
--
-- Method:      displayGrids
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayGrids()

  -- Bar menu
  !this.bar.add(|Display|, |displayMenu|)
  !menu = !this.newMenu(|displayMenu|)
  !menu.add(|CALLBACK|, |Picked position in grid coords...|, |!this.pickPos()|)
  !this.bar.add(|Create|, |createMenu|)
  !menu = !this.newMenu(|createMenu|)
  !menu.add(|CALLBACK|, |3D Rectangular Grid...|,  |!!edgCntrl.add(!!displayGrids.plantGridPacket(object  GPHTHREEDPLANTGRID()))  |)
  !menu.add(|CALLBACK|, |3D Radial Grid...|, |!!edgCntrl.add(!!displayGrids.radialGridPacket(object GPHTHREEDRADIALGRID())) |)
  !this.bar.add(|Modify|, |modifyMenu|)
  !menu = !this.newMenu(|modifyMenu|)
  !menu.add(|CALLBACK|, |Selected Grid System...|, |!this.modifyGrid()|)
  !this.bar.add(|Delete|, |deleteMenu|)
  !menu = !this.newMenu(|deleteMenu|)
  !menu.add(|CALLBACK|, |Selected Grid System...|, |!this.deleteGrid()|)

  -- Texts
  !this.gridName.val = |NONE|

  -- Callbacks
  !this.callback                = |!this.initialise()|
  !this.hide.callback           = |!this.tidy()|
  !this.setLimits.callback      = |!this.setLimits()|
  !this.apply.callback          = |!this.preview()|
  !this.labelType.callback      = |!this.labelType()|
  !this.gridSystemList.callback = |!this.gridSystemList()|
  !this.selectAxes.callback     = |!this.selectAxes()|

endmethod
-- End of method definition for .displayGrids()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Reset grid type flag to force selection from grid system list
  !this.gridType = STRING()

  -- Populate list with grid systems
  var !gridSystems collect all GRIDSY
  var !gridSyNames evaluate namn for all from !gridSystems
  !this.gridSystems.clear()
  !this.gridSystemList.clear()
  do !i indices !gridSystems
    !this.gridSystems.append(!gridSystems[!i].dbref())
    !this.gridSystemList.add(!gridSyNames[!i])
  enddo

  -- Attempt to reselect saved grid system
  if (!this.systemGrid.set()) then
    !val = !this.gridSystems.findFirst(!this.systemGrid)
    if (!val.set()) then
      !this.gridSystemList.val = !val
    endif
  endif

  -- Initialise label type
  !this.axes.val = TRUE

  -- Action callback on selected grid system
  !this.gridSystemList()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      reinitialise
--
-- Description: Initialisation of form following modify or create
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Newly created or modified system grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reinitialise(!systemGrid is DBREF)

  -- Initialise form with this grid system
  !this.systemGrid = !systemGrid
  !this.initialise()
  !this.preview()

endmethod
-- End of method definition for .reinitialise(DBREF)

------------------------------------------------------------------------
--
-- Method:      plantGridPacket
--
-- Description: Plant Grid Definition Packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANTGRID  Grid definition to setup with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plantGridPacket(!grid is GPHTHREEDPLANTGRID) is EDGPACKET

  -- Initialise Variables

  -- Check radial grid form is defined
  if(undefined(!!plant3dGrids)) then
    pml reload form !!plant3dGrids
  endif

  -- Define Packet Data
  !packet                = object EDGPACKET()
  !packet.positionLink('!!plant3dGrids.position', 'Define 3D Rectangular Grid')
  !packet.key            = 'plantGridPacket'
  !packet.type           = 'construct'
  !packet.input[1]       = !grid
  !packet.initialisation = |!!plant3dGrids.setup('Reference 3D Rectangular Grid','!!aidNumbers.add(!!plant3dGrids.grid)',!this.input[1])|
  !packet.description    = 'Reference 3D Rectangular Grid'
  !packet.form           = !!plant3dGrids
  !packet.close          = '!!plant3dGrids.tidy()'

  !packet.priority       = 2
  !packet.remove         = false
  !packet.type           = 'aidNumbers'

  -- Return
  return !packet

endmethod
-- End of method definition for .plantGridPacket(GPHTHREEDPLANTGRID) EDGPACKET

------------------------------------------------------------------------
--
-- Method:      radialGridPacket
--
-- Description: Radial Grid Definition Packet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      RADIALGRID  Grid definition to setup with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .radialGridPacket(!grid is GPHTHREEDRADIALGRID) is EDGPACKET

  -- Initialise Variables

  -- Check radial grid form is defined.form
  if(undefined(!!radial3dGrids)) then
    pml reload form !!radial3dGrids
  endif

  -- Define Packet Data
  !packet                = object EDGPACKET()
  !packet.positionLink('!!radial3dGrids.position', 'Define 3D Radial Grid')
  !packet.key            = 'radialGridPacket'
  !packet.type           = 'construct'
  !packet.input[1]       = !grid
  !packet.initialisation = |!!radial3dGrids.setup('Reference 3D Radial Grid','!!aidNumbers.add(!!radial3dGrids.grid)',!this.input[1])|
  !packet.description    = 'Reference 3D Radial Grid'
  !packet.form           = !!radial3dGrids
  !packet.close          = '!!radial3dGrids.tidy()'

  !packet.priority       = 2
  !packet.remove         = false
  !packet.type           = 'aidNumbers'

  -- Return
  return !packet

endmethod
-- End of method definition for .radialGridPacket(GPHTHREEDRADIALGRID) EDGPACKET

------------------------------------------------------------------------
--
-- Method:      modifyGrid
--
-- Description: Modify grid system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .modifyGrid()

  -- Hide any already displayed grid
  !this.tidy()

  -- Use selected grid system
  if (!this.gridSystems.empty()) then
    return error 1 |No grid system available|
  endif
  !this.systemGrid = !this.gridSystems[!this.gridSystemList.val]

  -- Check for write access
  if (!this.systemGrid.dbwrit.not()) then
    return error 1 |You do not have write access to the selected Grid System|
  endif

  -- Invoke the appropriate grid form
  if (!this.systemGrid.purpose eq |AXIS|) then
    if(undefined(!!plant3dGrids)) then
      pml reload form !!plant3dGrids
    endif
    !!plant3dGrids.setup(!this.systemGrid)
    show !!plant3dGrids

  elseif (!this.systemGrid.purpose eq |RADI|) then
    if(undefined(!!radial3dGrids)) then
      pml reload form !!radial3dGrids
    endif
    !!radial3dGrids.setup(!this.systemGrid)
    show !!radial3dGrids

  elseif (!this.systemGrid.purpose eq |SHIP|) then
    return error 1 |Modification of SHIP Grid System not permitted here|

  else
    return error 1 |Only Grid Systems with Purpose AXIS or RADI may be modified here|

  endif

endmethod
-- End of method definition for .modifyGrid()

------------------------------------------------------------------------
--
-- Method:      deleteGrid
--
-- Description: Delete grid system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .deleteGrid()

  -- Use selected grid system
  if (!this.gridSystems.empty()) then
    return error 1 |No grid system available|
  endif
  !this.systemGrid = !this.gridSystems[!this.gridSystemList.val]

  -- Check for write access
  if (!this.systemGrid.dbwrit.not()) then
    return error 1 |You do not have write access to the selected Grid System|
  endif

  -- Delete the grid
  if (!this.systemGrid.purpose inset(|AXIS|,|RADI|)) then
    if (!!alert.confirm(|Ok to delete Grid System | & !this.systemGrid.name & | ?|) eq |YES|) then

      -- Hide any already displayed grid and remove it from the arrays
      !this.tidy()
      !this.remove()

      !!ce = !this.systemGrid
      DELETE GRIDSY
      !this.initialise()
    endif

  elseif (!this.systemGrid.purpose eq |SHIP|) then
    return error 1 |Deletion of SHIP Grid System not permitted here|

  else
    return error 1 |Only Grid Systems with Purpose AXIS or RADI may be deleted here|

  endif

endmethod
-- End of method definition for .deleteGrid()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Hide currently displayed grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide currently displayed grid
  !this.setGridNumber()
  if (!this.gridNumber ne 0) then
    if (!this.gridShown[!this.gridNumber]) then
      !!aidNumbers.hide(!this.aidNumber[!this.gridNumber])
      !!aidNumbers.hide(!this.aidNumberGridxy[!this.gridNumber])
      !!aidNumbers.hide(!this.aidNumberGridxz[!this.gridNumber])
      !!aidNumbers.hide(!this.aidNumberGridzy[!this.gridNumber])
    endif
    !this.gridShown[!this.gridNumber] = FALSE
  endif

  -- Activate buttons
  !this.apply.active     = TRUE
  !this.hide.active      = FALSE
  !this.setLimits.active = FALSE

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove currently displayed grid from arrays
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .remove()

  -- Hide currently displayed grid
  !this.setGridNumber()
  if (!this.gridNumber ne 0) then
    !this.displayedGrids[!this.gridNumber].delete()
    !this.aidNumber[!this.gridNumber].delete()
    !this.aidNumberGridxy[!this.gridNumber].delete()
    !this.aidNumberGridxz[!this.gridNumber].delete()
    !this.aidNumberGridzy[!this.gridNumber].delete()
    !this.gridShown[!this.gridNumber].delete()
    !this.gridNumber = 0
  endif

endmethod
-- End of method definition for .remove()

------------------------------------------------------------------------
--
-- Method:      setGridNumber
--
-- Description: Set position in displayed grid array for currently selected grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setGridNumber()

  -- Find if grid already displayed
  !this.gridNumber = 0
  if (!this.systemGrid.set()) then
    do !i indices !this.displayedGrids
      if (!this.displayedGrids[!i] eq !this.systemGrid) then
        !this.gridNumber = !i
        break
      endif
    enddo
  endif

endmethod
-- End of method definition for .setGridNumber()

------------------------------------------------------------------------
--
-- Method:      allocateGrid
--
-- Description: Find grid number in display list or add grid to display list and allocate aid numbers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .allocateGrid()

  -- If not already displayed, add grid and allocate aid numbers
  !this.setGridNumber()
  if (!this.gridNumber eq 0) then
    if (!this.systemGrid.set()) then
      !this.displayedGrids.append(!this.systemGrid)
      !this.gridShown.append(FALSE)
      !this.aidNumber.append(!!aidNumbers.add(|Display grid|))
      !this.aidNumberGridxy.append(!!aidNumbers.add(|Display gridxy|))
      !this.aidNumberGridxz.append(!!aidNumbers.add(|Display gridxz|))
      !this.aidNumberGridzy.append(!!aidNumbers.add(|Display gridzy|))
      !this.gridNumber = !this.displayedGrids.size()
    endif
  endif

endmethod
-- End of method definition for .allocateGrid()

------------------------------------------------------------------------
--
-- Method:      pickPos
--
-- Description:
--   Pick position to display grid coords
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPos()

  -- Use selected grid system
  if (!this.gridSystems.empty()) then
    return error 1 |No grid system available|
  endif

  -- Pick using position control
  !packet = object EDGPACKET()
  !packet.definePosition(|Pick position|)
  !packet.action = |!!displayGrids.pickReturn(!this.return[1])|
  !packet.remove  = true
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickPos()

------------------------------------------------------------------------
--
-- Method:      pickReturn
--
-- Description: Process result of pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickReturn(!data is ANY)

  -- Load form if not previously loaded so can initialise its members
  if(undefined(!!posInPlantGrid)) then
    pml load form !!posInPlantGrid
  endif

  -- Get position from picked data
  if (!data.objectType() eq |POSITION|) then
    !position = !data
  else
    !position = !data.position
    handle ANY
      -- Does not have position member
      return
    endhandle
  endif

  -- Setup and display form
  !!posInPlantGrid.setup(!this.gridSystems[!this.gridSystemList.val], !position)
  show !!posInPlantGrid

endmethod
-- End of method definition for .pickReturn(ANY)

------------------------------------------------------------------------
--
-- Method:      gridSystemList
--
-- Description: Reset form gadgets for selection in grid system list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .gridSystemList()

  -- Hide axes selection forms as if shown will apply to previously selected grid
  hide !!plantGridAxes
  handle ANY
  endhandle
  hide !!radialGridAxes
  handle ANY
  endhandle

  -- Set selected grid system
  !this.systemGrid   = object DBREF()
  !this.gridName.val = ||
  if (!this.gridSystems.empty().not()) then
    !this.systemGrid   = !this.gridSystems[!this.gridSystemList.val]
    !this.gridName.val = !this.systemGrid.namn
  endif

  -- Reset any previous display axes selection
  !this.xPlaneDraw  = FALSE
  !this.yPlaneDraw  = FALSE
  !this.zPlaneDraw  = TRUE
  !this.xOffsetThru = 0
  !this.yOffsetThru = 0
  !this.zOffsetThru = 0

  -- See if currently selected grid is displayed
  !shown = FALSE
  !this.setGridNumber()
  if (!this.gridNumber ne 0) then
    !shown = !this.gridShown[!this.gridNumber]
  endif

  -- Activate buttons
  !this.apply.active      = (!this.gridSystems.empty().not() and !this.systemGrid.set() and !shown.not())
  !this.labelType.active  = !this.gridSystems.empty().not()
  !this.selectAxes.active = !this.gridSystems.empty().not()
  !this.hide.active       = (!this.systemGrid.set() and !shown)
  !this.setLimits.active  = (!this.systemGrid.set() and !shown)

endmethod
-- End of method definition for .gridSystemList()

------------------------------------------------------------------------
--
-- Method:      labelType
--
-- Description: Change label type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .labelType()

  -- Activate apply button
  !this.apply.active = TRUE

endmethod
-- End of method definition for .labelType()

------------------------------------------------------------------------
--
-- Method:      selectAxes
--
-- Description: Change label type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .selectAxes()

  -- Use selected grid system
  if (!this.gridSystems.empty()) then
    return error 1 |No grid system available|
  endif
  !systemGrid = !this.gridSystems[!this.gridSystemList.val]

  -- Get grid number and allocate aid numbers if not already done so
  !this.allocateGrid()

  -- Hide currently displayed grid
  !this.tidy()

  -- Initialise grid object and show axes selection form
  if (!systemGrid.purpose eq |RADI|) then
    !this.gridType = 'gphThreeDRadialGrid'
    !this.radialGrid = object GPHTHREEDRADIALGRID(!systemGrid)
    !this.plantGrid = object GPHTHREEDPLANTGRID()
    show !!radialGridAxes
  else
    !this.gridType = 'gphThreeDPlantGrid'
    !this.plantGrid = object GPHTHREEDPLANTGRID(!systemGrid)
    !this.radialGrid = object GPHTHREEDRADIALGRID()
    show !!plantGridAxes
  endif

endmethod
-- End of method definition for .selectAxes()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview the grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Use selected grid system
  if (!this.gridSystems.empty()) then
    return error 1 |No grid system available|
  endif
  !this.systemGrid = !this.gridSystems[!this.gridSystemList.val]

  -- Get grid number and allocate aid numbers if not already done so
  !this.allocateGrid()

  -- Initialise grid object and aid number
  if (!this.systemGrid.purpose eq |RADI|) then

    -- Initialise grid object
    !this.gridType = 'gphThreeDRadialGrid'
    !this.radialGrid = object GPHTHREEDRADIALGRID(!this.systemGrid)
    !this.plantGrid = object GPHTHREEDPLANTGRID()

    -- Set to display separate plantgrid for EDG interaction
    !this.radialGrid.drawForEDG(TRUE, !this.aidNumberGridxy[!this.gridNumber])

    -- Axes only means switch off grid detail flag
    !this.radialGrid.detail = !this.axes.val.not()

    -- Grid label setting only used if grid detail flag is on (i.e. not axes only)
    if(!this.id.val) then
      !this.radialGrid.labelId()
    elseif(!this.enu.val) then
      !this.radialGrid.labelEnu()
    elseif(!this.offset.val) then
      !this.radialGrid.labelOffset()
    endif

    -- Display axes selection
    !this.radialGrid.zOffsetThru = !this.zOffsetThru

    -- Replace current definition aid graphics
    !!aidNumbers.replace(!this.aidNumber[!this.gridNumber], !this.radialGrid)

  else

    -- Initialise grid object
    !this.gridType = 'gphThreeDPlantGrid'
    !this.plantGrid = object GPHTHREEDPLANTGRID(!this.systemGrid)
    !this.radialGrid = object GPHTHREEDRADIALGRID()

    -- Set to display separate plantgrids for EDG interaction
    !this.plantGrid.drawForEDG(TRUE, !this.aidNumberGridxy[!this.gridNumber], !this.aidNumberGridxz[!this.gridNumber], !this.aidNumberGridzy[!this.gridNumber])

    -- Axes only means switch off grid detail flag
    !this.plantGrid.detail = !this.axes.val.not()

    -- Grid label setting only used if grid detail flag is on (i.e. not axes only)
    if(!this.id.val) then
      !this.plantGrid.labelId()
    elseif(!this.enu.val) then
      !this.plantGrid.labelEnu()
    elseif(!this.offset.val) then
      !this.plantGrid.labelOffset()
    endif

    -- Display axes selection
    !this.plantGrid.xPlaneDraw  = !this.xPlaneDraw
    !this.plantGrid.yPlaneDraw  = !this.yPlaneDraw
    !this.plantGrid.zPlaneDraw  = !this.zPlaneDraw
    !this.plantGrid.xOffsetThru = !this.xOffsetThru
    !this.plantGrid.yOffsetThru = !this.yOffsetThru
    !this.plantGrid.zOffsetThru = !this.zOffsetThru

    -- Replace current definition aid graphics
    !!aidNumbers.replace(!this.aidNumber[!this.gridNumber], !this.plantGrid)

  endif
  !this.gridShown[!this.gridNumber] = TRUE

  -- Activate buttons
  !this.apply.active     = FALSE
  !this.hide.active      = TRUE
  !this.setLimits.active = TRUE

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      setLimits
--
-- Description: Set view limits to grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setLimits()

  -- Use selected grid system
  if (!this.gridSystems.empty()) then
    return error 1 |No grid system available|
  endif
  !systemGrid = !this.gridSystems[!this.gridSystemList.val]

  -- Get grid number and allocate aid numbers if not already done so
  !this.allocateGrid()

  -- Set view limits so grid not clipped
  if (!systemGrid.purpose eq |RADI|) then
    !this.gridType = 'gphThreeDRadialGrid'
    !this.radialGrid = object GPHTHREEDRADIALGRID(!systemGrid)
    !this.plantGrid = object GPHTHREEDPLANTGRID()
    !this.radialGrid.setLimits()
  else
    !this.gridType = 'gphThreeDPlantGrid'
    !this.plantGrid = object GPHTHREEDPLANTGRID(!systemGrid)
    !this.radialGrid = object GPHTHREEDRADIALGRID()
    !this.plantGrid.setLimits()
  endif

endmethod
-- End of method definition for .setLimits()
