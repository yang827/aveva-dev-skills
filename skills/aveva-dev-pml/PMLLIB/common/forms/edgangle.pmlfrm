-- File:            edgangle.pmlfrm
--   Type:          Form Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Feb 17 13:16:26 WAT 1998
--
--
-- Description:
-- Define an angle
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  derive()                         -                   Derive the input angle, allows <val> taken as degrees, <val> in <val>
--  measure(ARC)                     -                   Setup to measure angle
--  setMeasure()                     -                   Setup to measure angle
--
------------------------------------------------------------------------

-- Define form
setup form !!edgAngle

  !!edgAngle.formTitle     = 'Angle'
  !!edgAngle.iconTitle     = ''
  !!edgAngle.callback      = ''
  !!edgAngle.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition

  -- Body of form definition
--  text .diameter 'Angle' width 14 is REAL format !!realFmt
  text .angleString 'Angle' callback '!!edgAngle.derive()' width 10 is STRING
  !!edgAngle.angleString.val = '0'

  -- Measure Angle
  button .measure 'Measure' at xmax ymin callback '!!edgAngle.setMeasure()'

  -- Angle derived
  member .angle is REAL
  !!edgAngle.angle = 0

exit
-- End of form definition for !!edgAngle

------------------------------------------------------------------------
--
-- Method:      derive
--
-- Description:
--   Derive the input angle, allows <val> taken as degrees, <val> in <val>
--   or <val>%
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .derive()

  -- Check for "IN"
  if(!this.angleString.val.upcase().match('IN').boolean()) then

    -- Convert into angle
    !a     = !this.angleString.val.upcase().before('IN').trim()
    !b     = !this.angleString.val.upcase().after('IN').trim()
    !angle = ATAN(!a.real() / !b.real())


  -- Check for %
  elseif (!this.angleString.val.trim().subString(-1,1).eq('%')) then

    -- Get value before %
    !a     = !this.angleString.val.before('%').trim().real()
    !angle = ATAN(!a / 100)

  -- Assume degrees (real)
  else

    !angle = !this.angleString.val.trim().real()
    handle any
      return
    endhandle
  endif

  -- Write data to gadget and member
  !this.angle           = !angle
  !this.angleString.val = !angle.string()

endmethod
-- End of method definition for .derive()

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure()

  -- Define the measure packet
  !packet        = object EDGPACKET()
  !packet.defineMeasure('angle')
  !packet.action = '!!edgAngle.measure(!this.return[1])'
  !!edgCntrl.add(!packet)

  -- Make measure inactive, until we have the data
  !this.measure.active = false

endmethod
-- End of method definition for .setMeasure()

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description:
--   Setup to measure angle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    Arc         Return
--
------------------------------------------------------------------------

define method .measure(!arc is ARC)

  -- Allow measure to be picked again
  !this.measure.active = true

  -- Write angle to form
  !this.angle           = !arc.angle()
  !this.angleString.val = !arc.angle().string()

endmethod
-- End of method definition for .measure(ARC)
