--
--
-- Description:
-- Specify a diameter.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgDiameter()                    -                   Constructor
--  measure(LINE)                    -                   Setup to measure distance
--  setMeasure(GADGET,STRING)        -                   Setup to measure offset
--  setMeasure(MENU,STRING)          -                   Setup to measure offset
--
------------------------------------------------------------------------

-- Define form
setup form !!edgDiameter

  !!edgDiameter.formTitle     = 'Diameter'
  !!edgDiameter.iconTitle     = 'Diam'
  !!edgDiameter.callback      = ''
  !!edgDiameter.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition
  text .diameter 'Diameter' width 14 is REAL format !!distanceFmt
  !!edgDiameter.diameter.val = 0

  -- Measure Distance
  button .measure 'Measure' at xmax ymin callback '!!edgDiameter.setMeasure('

exit
-- End of form definition for !!edgDiameter

------------------------------------------------------------------------
--
-- Method:      edgDiameter
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgDiameter()

  -- Define right-mouse buttons
  -- Distance
  !menu = !this.newMenu('distanceMenu')
    !menu.add('CALLBACK', 'Measure',          '!this.setMeasure(')
    !menu.add('CALLBACK', 'Measure Shortest', '!this.setMeasure(')
  !this.diameter.setPopup(!this.distanceMenu)

endmethod
-- End of method definition for .edgDiameter()

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('DISTANCE')
    !packet.action = '!!edgDiameter.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

    -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('SHORTEST')
    !packet.action = '!!edgDiameter.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .setMeasure(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!dummy is GADGET, !selected is STRING)

  -- Initialise Variables
  -- Define the measure packet
  !packet        = object EDGPACKET()
  !packet.defineMeasure('DISTANCE')
  !packet.action = '!!edgDiameter.measure(!this.return[1])'
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .setMeasure(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description:
--   Setup to measure distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measure(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.diameter.val = 0
  else
    !this.diameter.val = !line.length()
  endif

endmethod
-- End of method definition for .measure(LINE)
