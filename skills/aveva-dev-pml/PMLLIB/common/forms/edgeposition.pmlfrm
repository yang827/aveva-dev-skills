--   Group:         Event Driven Graphics

--     Keyword:     EDG
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Sep 14 14:46:03 BST 1999
--
--
-- Description:
-- Define explicit position for event positioning picks.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply position
--  initialise()                     -
--
------------------------------------------------------------------------

setup form !!edgePosition

  !this.formTitle     = 'Explicit Position'
  !this.iconTitle     = 'EPosition'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  path right
  text   .x 'E' width 14 is REAL format !!distanceFmt
  text   .y 'N' width 14 is REAL format !!distanceFmt
  text   .z 'U' width 14 is REAL format !!distanceFmt

  -- Apply
  button .apply 'Apply' tooltip 'Use defined position' callback '!this.apply()' apply

exit

!this.x.val = 0
!this.y.val = 0
!this.z.val = 0

-- End of form definition for !!edgePosition

------------------------------------------------------------------------
--
-- Method:      Initialise
--
-- Description: Initialises form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

 var !coordinate coordinate
 if(!coordinate.eq('ENU'))then
  !this.x.tag = 'E'
  !this.y.tag = 'N'
  !this.z.tag = 'U'
 else
  !this.x.tag = 'X'
  !this.y.tag = 'Y'
  !this.z.tag = 'Z'
 endif
endmethod

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables

  -- Handle unset values
  if(!this.x.val.unset()) then
    !!alert.warning('X value is unset.')
    return
  endif
  if(!this.y.val.unset()) then
    !!alert.warning('Y value is unset.')
    return
  endif
  if(!this.z.val.unset()) then
    !!alert.warning('Z value is unset.')
    return
  endif

  -- Define Position
  !position       = N0
  !position.east  = !this.x.val
  !position.north = !this.y.val
  !position.up    = !this.z.val

  -- Pass position to event system
  !!edgCntrl.explicitPosition(!position)

endmethod
-- End of method definition for .apply()
