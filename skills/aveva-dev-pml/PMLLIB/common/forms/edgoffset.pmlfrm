--
--
-- Description:
-- Define an offset
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Carry out action
--  direction(DIRECTION)             -                   Setup to direction of offset
--  edgOffset()                      -                   Constructor
--  edit(DIRECTION,REAL,STRING)      -                   Setup form
--  measure(LINE)                    -                   Setup to measure distance
--  setDirection(GADGET,STRING)      -                   Setup to direction offset
--  setDirection(MENU,STRING)        -                   Setup to direction of offset
--  setMeasure(GADGET,STRING)        -                   Setup to measure offset
--  setMeasure(MENU,STRING)          -                   Setup to measure offset
--
------------------------------------------------------------------------

-- Define form
setup form !!edgOffset

  !!edgOffset.formTitle     = 'Offset (Distance & Direction)'
  !!edgOffset.iconTitle     = 'Offset'
  !!edgOffset.callback      = ''
  !!edgOffset.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition

  -- Direction
  text .direction 'Direction ' width 20 is DIRECTION
  !!edgOffset.direction.val = N

  -- Distance
  path down
  halign right
  text .distance  'Distance '  width 20 is REAL format !!distanceFmt
  !!edgOffset.distance.val = 0

  -- Pick Direction
  button .pick    'Pick'    at xmax.direction+1 ymin.direction callback '!!edgOffset.setDirection('

  -- Measure Distance
  button .measure 'Measure' at xmax.distance+1  ymin.distance  callback '!!edgOffset.setMeasure('

  -- Members
  member .action    is STRING

exit
-- End of form definition for !!edgOffset

------------------------------------------------------------------------
--
-- Method:      edgOffset
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgOffset()

  -- Define right-mouse buttons
  -- Direction
  !menu = !this.newMenu('directionMenu')
    !menu.add('CALLBACK', 'Pick',        '!!edgOffset.setDirection(')
    !menu.add('CALLBACK', 'X Direction', '!!edgOffset.setDirection(')
    !menu.add('CALLBACK', 'Y Direction', '!!edgOffset.setDirection(')
    !menu.add('CALLBACK', 'Z Direction', '!!edgOffset.setDirection(')
    !menu.add('CALLBACK', 'Opposite',    '!!edgOffset.setDirection(')
  !this.direction.setPopup(!this.directionMenu)

  -- Distance
  !menu = !this.newMenu('distanceMenu')
    !menu.add('CALLBACK', 'Measure',          '!!edgOffset.setMeasure(')
    !menu.add('CALLBACK', 'Measure Shortest', '!!edgOffset.setMeasure(')
  !this.distance.setPopup(!this.distanceMenu)

endmethod
-- End of method definition for .edgOffset()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!direction is DIRECTION, !distance is REAL, !action is STRING)

  -- Initialise Variables
  !this.direction.val  = !direction
  !this.distance.val   = !distance
  !this.action         = !action

  -- If action is set, then assign to the callback
  if(!this.action.set()) then
    !this.distance.callback  = !this.action
    !this.direction.callback = !this.action
  endif

  -- Show form
  show !!edgOffset

endmethod
-- End of method definition for .edit(DIRECTION, REAL, STRING)

------------------------------------------------------------------------
--
-- Method:      action
--
-- Description:
--   Carry out action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .action()

  -- Action
  $!<this.action>
  handle any
  endhandle

endmethod
-- End of method definition for .action()

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('distance')
    !packet.action = '!!edgOffset.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

    -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('shortest')
    !packet.action = '!!edgOffset.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .setMeasure(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!gadget is GADGET, !selected is STRING)

  -- Initialise Variables
  -- Define the measure packet
  !packet        = object EDGPACKET()
  !packet.defineMeasure('distance')
  !packet.action = '!!edgOffset.measure(!this.return[1])'
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .setMeasure(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description:
--   Setup to measure distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measure(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.distance.val = 0
  else
    !this.distance.val = !line.length()
  endif

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .measure(LINE)

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Pick Direction
  if(!option eq 'PICK') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineDirection('')
    !packet.action = '!!edgOffset.direction(!this.return[1])'
    !!edgCntrl.add(!packet)
    return

  -- Opposite  Direction
  elseif (!option eq 'OPPOSITE') then
    !this.direction.val = !this.direction.val.opposite()

  -- Direction
  else

    -- Check we have an orientation
    !unusedOrientation = !!ce.orientation
    handle any
      return
    endhandle

     -- Extract the direction
    if(!option.match('X').boolean()) then
      !this.direction.val = !!ce.orientation.xDir().wrt(World)
    elseif (!option.match('Y').boolean()) then
      !this.direction.val = !!ce.orientation.yDir().wrt(World)
    else
      !this.direction.val = !!ce.orientation.zDir().wrt(World)
    endif

  endif

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .setDirection(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description:
--   Setup to direction offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection(!gadget is GADGET, !selected is STRING)

  -- Initialise Variables
  -- Define the direction packet
  !packet        = object EDGPACKET()
  !packet.defineDirection('')
  !packet.action = '!!edgOffset.direction(!this.return[1])'
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .setDirection(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)

  -- Write angle to form
  !this.direction.val = !direction

  -- Carry out action
  !this.action()
endmethod
-- End of method definition for .direction(DIRECTION)
