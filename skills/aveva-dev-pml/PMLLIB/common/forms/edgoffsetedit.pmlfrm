--
-- File:            edgoffsetedit.pmlfrm
--   Type:          Form Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Apr 24 16:23:21 WAT 1998
--
--
-- Description:
-- Edit the edg positional offset values.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  edgOffsetEdit()                  -                   Constructor
--  initialise()                     -
--
------------------------------------------------------------------------

setup form !!edgOffsetEdit

  !!edgOffsetEdit.formTitle     = 'Offset Values'
  !!edgOffsetEdit.iconTitle     = 'SetOffset'
  !!edgOffsetEdit.callback      = '!this.initialise()'
  !!edgOffsetEdit.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition

  -- Offset XYZ
  frame .xyzFrame 'XYZ (ENU) Offset'

    -- Define XYZ data
    path down
    option .ewxyz    at x3     ymax         width 2
    option .nsxyz                           width 2
    option .udxyz                           width 2
    text   .xxyz     at xmax+1 ymin.ewxyz   width 14 is REAL format !!distanceFmt
    text   .yxyz     at xmin   ymin.nsxyz   width 14 is REAL format !!distanceFmt
    text   .zxyz     at xmin   ymin.udxyz   width 14 is REAL format !!distanceFmt

  exit

  -- Offset XYZ
  frame .xyFrame 'XY Offset in plane' at xmin ymax

    -- Define XY data
    path down
    option .ewxy    at x3     ymax        width 2
    option .nsxy                          width 2
    text   .xxy     at xmax+1 ymin.ewxy   width 14 is REAL format !!distanceFmt
    text   .yxy     at xmin   ymin.nsxy   width 14 is REAL format !!distanceFmt

  exit

  -- Distance and Direction
  frame .distDirFrame 'Direction & Distance' at xmin ymax
    path down
    halign right
    text .distance  'Distance '   at x1.5 ymax width 14 is REAL format !!distanceFmt
    text .direction 'Direction '  width 14 is DIRECTION
  exit

  -- Surface offset
  frame .surfaceFrame 'Offset from Surface' at xmin ymax
    text .surface  'Distance ' at x1 ymax width 14 is REAL format !!distanceFmt
  exit


 -- Bottom line
  button .apply   'Apply'   at xmin form-0    ymax form+0.25 callback '!this.apply()'
  button .dismiss 'Dismiss' at xmax form-size ymin cancel

  -- Position XYZ Offset
  member .xyz is POSITIONLINK

  -- Position XY Offset
  member .xy  is XYPOSITIONLINK

exit
-- End of form definition for !!edgOffsetEdit

------------------------------------------------------------------------
--
-- Method:      edgOffsetEdit
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgOffsetEdit()

  -- XYZ Offset
  !this.xyz.linkInput('!!edgOffsetEdit.xyz',!this.xxyz, !this.yxyz, !this.zxyz)
  !this.xyz.linkOption('!!edgOffsetEdit.xyz',!this.ewxyz, !this.nsxyz, !this.udxyz, 'XYZ')
  !this.xyz.setAction('')

  -- XY Plane Offset
  !this.xy.linkInput('!!edgOffsetEdit.xy',!this.xxy, !this.yxy)
  !this.xy.linkOption('!!edgOffsetEdit.xy',!this.ewxy, !this.nsxy, 'XY')

  -- Direction/Distance Offset
  !this.direction.val = !!edgPosCntrl.offsetDirection
  !this.distance.val  = !!edgPosCntrl.offsetDistance

  -- Surface Offset
  !this.surface.val   = !!edgPosCntrl.offsetSurface

endmethod
-- End of method definition for .edgOffsetEdit()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  !this.xyz.setPosition(!!edgPosCntrl.offsetXyz)
  !this.xy.setPosition(!!edgPosCntrl.offsetXy)

  -- Direction/Distance Offset
  !this.direction.val = !!edgPosCntrl.offsetDirection
  !this.distance.val  = !!edgPosCntrl.offsetDistance

  -- Surface Offset
  !this.surface.val   = !!edgPosCntrl.offsetSurface

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  !!edgPosCntrl.offsetXyz = !this.xyz.get()
  !!edgPosCntrl.offsetXy  = !this.xy.get()

  -- Direction/Distance Offset
  !!edgPosCntrl.offsetDirection = !this.direction.val
  !!edgPosCntrl.offsetDistance  = !this.distance.val

  -- Surface Offset
  !!edgPosCntrl.offsetSurface   = !this.surface.val

endmethod
-- End of method definition for .apply()
