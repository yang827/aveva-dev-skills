-- File:            edgoffsetenu.pmlfrm
--   Type:          Form Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Jun 26 15:16:58 BST 1998
--
--
-- Description:
-- ENU offset definition.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Carry out action
--  edgOffsetENU()                   -                   Constructor
--  edit(POSITION,STRING)            -                   Setup form
--  initialise()                     -                   Initialise Form
--  measure(STRING,LINE)             -                   Setup to measure distance
--  setMeasure(STRING,STRING)        -                   Setup to measure offset
--
------------------------------------------------------------------------

setup form !!edgOffsetENU

  !!edgOffsetENU.formTitle     = 'Offset (E/N/U)'
  !!edgOffsetENU.iconTitle     = ''
  !!edgOffsetENU.callback      = '!this.initialise()'
  !!edgOffsetENU.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition
  -- Define XYZ data
  path down
  option .xOption  at xmin ymax           width 5
  option .yOption                           width 5
  option .zOption                           width 5
  text   .x        at xmax ymin.xOption   width 14 is REAL format !!distanceFmt
  text   .y        at xmin ymin.yOption   width 14 is REAL format !!distanceFmt
  text   .z        at xmin ymin.zOption   width 14 is REAL format !!distanceFmt

  -- Position XYZ Offset
  member .position is POSITIONLINK

  -- Action
  member .action   is STRING

exit
-- End of form definition for !!edgOffsetENU

------------------------------------------------------------------------
--
-- Method:      edgOffsetENU
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgOffsetENU()

  -- XYZ Offset
  var !coordinate coordinate
  !this.position.linkInput('!!edgOffsetENU.position',!this.x, !this.y, !this.z)
  !this.position.linkOption('!!edgOffsetENU.position',!this.xOption, !this.yOption, !this.zOption, !coordinate)

  -- Distance
  !menu = !this.newMenu('distanceMenuX')
    !menu.add('CALLBACK', 'Measure',          '!!edgOffsetENU.setMeasure(''MEASURE'',''East'')')
    !menu.add('CALLBACK', 'Measure Shortest', '!!edgOffsetENU.setMeasure(''SHORTEST'',''East'')')
  !menu = !this.newMenu('distanceMenuY')
    !menu.add('CALLBACK', 'Measure',          '!!edgOffsetENU.setMeasure(''MEASURE'',''North'')')
    !menu.add('CALLBACK', 'Measure Shortest', '!!edgOffsetENU.setMeasure(''SHORTEST'',''North'')')
  !menu = !this.newMenu('distanceMenuZ')
    !menu.add('CALLBACK', 'Measure',          '!!edgOffsetENU.setMeasure(''MEASURE'',''Up'')')
    !menu.add('CALLBACK', 'Measure Shortest', '!!edgOffsetENU.setMeasure(''SHORTEST'',''Up'')')
  !this.x.setPopup(!this.distanceMenuX)
  !this.y.setPopup(!this.distanceMenuY)
  !this.z.setPopup(!this.distanceMenuZ)

endmethod
-- End of method definition for .edgOffsetENU()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: Initialise Form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  var !coordinate coordinate
  !this.position.linkInput('!!edgOffsetENU.position',!this.x, !this.y, !this.z)
  !this.position.linkOption('!!edgOffsetENU.position',!this.xOption, !this.yOption, !this.zOption, !coordinate)

endmethod

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!position is POSITION,  !action is STRING)

  -- Initialise Variables
  !this.position.position(!position)
  !this.action = !action

  -- If action is set, then assign to the callback
  if(!this.action.set()) then
    !this.position.setAction(!this.action)
  endif

  -- Show form
  show !!edgOffsetENU

endmethod
-- End of method definition for .edit(POSITION,  STRING)

------------------------------------------------------------------------
--
-- Method:      action
--
-- Description:
--   Carry out action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .action()

  -- Action
  $!<this.action>
  handle any
  endhandle

endmethod
-- End of method definition for .action()

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!option is STRING, !gadget is STRING)

  -- Initialise Variables

  -- Measure (point to point)
  if(!option eq 'MEASURE') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('distance')
    !packet.action = '!!edgOffsetENU.measure(''' & !gadget & ''', !this.return[1])'
    !!edgCntrl.add(!packet)

    -- Measure parallel
  elseif (!option eq 'SHORTEST') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('shortest')
    !packet.action = '!!edgOffsetENU.measure(''' & !gadget & ''', !this.return[1])'
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .setMeasure(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description:
--   Setup to measure distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measure(!gadget is STRING, !line is LINE)

  -- Initialise Variables
  !position = !this.position.position()

  -- Unset line, is zero
  if(!line.unset()) then
    !value = 0
  else
    !value = !line.length()
  endif

  -- Define new position
  !position.$!<gadget> = !value
  !this.position.position(!position)

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .measure(STRING, LINE)
