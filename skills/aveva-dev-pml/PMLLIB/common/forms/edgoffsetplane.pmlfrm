-- File:            edgoffsetplane.pmlfrm
--   Type:          Form Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Jun 26 15:16:58 BST 1998
--
--
-- Description:
-- Plane offset definition.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Carry out action
--  edgOffsetPlane()                 -                   Constructor
--  edit(XYPOSITION,STRING)          -                   Setup form
--  measure(STRING,LINE)             -                   Setup to measure distance
--  setMeasure(STRING,STRING)        -                   Setup to measure offset
--
------------------------------------------------------------------------

setup form !!edgOffsetPlane

  !!edgOffsetPlane.formTitle     = 'Offset (Plane)'
  !!edgOffsetPlane.iconTitle     = ''
  !!edgOffsetPlane.callback      = ''
  !!edgOffsetPlane.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition
  -- Define XYZ data
  path down
  option .xOption  at xmin ymax           width 5
  option .yOption                         width 5
  text   .x        at xmax ymin.xOption   width 14 is REAL format !!distanceFmt
  text   .y        at xmin ymin.yOption   width 14 is REAL format !!distanceFmt

  -- Position XYZ Offset
  member .xyPosition is XYPOSITIONLINK

  -- Action
  member .action   is STRING

exit
-- End of form definition for !!edgOffsetPlane

------------------------------------------------------------------------
--
-- Method:      edgOffsetPlane
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgOffsetPlane()

  -- XYZ Offset
  !this.xyPosition.linkInput('!!edgOffsetPlane.xyPosition',!this.x, !this.y)
  !this.xyPosition.linkOption('!!edgOffsetPlane.xyPosition',!this.xOption, !this.yOption, 'EN')

  -- Distance
  !menu = !this.newMenu('distanceMenuX')
    !menu.add('CALLBACK', 'Measure',          '!!edgOffsetPlane.setMeasure(''MEASURE'',''x'')')
    !menu.add('CALLBACK', 'Measure Shortest', '!!edgOffsetPlane.setMeasure(''SHORTEST'',''x'')')
  !menu = !this.newMenu('distanceMenuY')
    !menu.add('CALLBACK', 'Measure',          '!!edgOffsetPlane.setMeasure(''MEASURE'',''y'')')
    !menu.add('CALLBACK', 'Measure Shortest', '!!edgOffsetPlane.setMeasure(''SHORTEST'',''y'')')
  !this.x.setPopup(!this.distanceMenuX)
  !this.y.setPopup(!this.distanceMenuY)

endmethod
-- End of method definition for .edgOffsetPlane()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!xyPosition is XYPOSITION,  !action is STRING)

  -- Initialise Variables
  !this.xyPosition.xyPosition(!xyPosition)
  !this.action = !action

  -- If action is set, then assign to the callback
  if(!this.action.set()) then
    !this.xyPosition.setAction(!this.action)
  endif

  -- Show form
  show !!edgOffsetPlane

endmethod
-- End of method definition for .edit(XYPOSITION,  STRING)

------------------------------------------------------------------------
--
-- Method:      action
--
-- Description:
--   Carry out action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .action()

  -- Action
  $!<this.action>
  handle any
  endhandle

endmethod
-- End of method definition for .action()

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!option is STRING, !gadget is STRING)

  -- Initialise Variables

  -- Measure (point to point)
  if(!option eq 'MEASURE') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('distance')
    !packet.action = '!!edgOffsetPlane.measure(''' & !gadget & ''', !this.return[1])'
    !!edgCntrl.add(!packet)

    -- Measure parallel
  elseif (!option eq 'SHORTEST') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('shortest')
    !packet.action = '!!edgOffsetPlane.measure(''' & !gadget & ''', !this.return[1])'
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .setMeasure(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description:
--   Setup to measure distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measure(!gadget is STRING, !line is LINE)

  -- Initialise Variables
  !xyPosition = !this.xyPosition.xyPosition()

  -- Unset line, is zero
  if(!line.unset()) then
    !value = 0
  else
    !value = !line.length()
  endif

  -- Define new position
  !xyPosition.$!<gadget> = !value
  !this.xyPosition.xyPosition(!xyPosition)

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .measure(STRING, LINE)
