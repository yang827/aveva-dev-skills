-- File:            edgoffsets.pmlfrm
--   Type:          Form Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Feb 17 13:17:18 WAT 1998
--
--
-- Description:
-- Define Nth number of offsets.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  measure(LINE)                    -                   Setup to measure distance
--  setMeasure()                     -                   Setup to measure offset
--
------------------------------------------------------------------------

-- Define form
setup form !!edgOffsets

  !!edgOffsets.formTitle     = 'offsets'
  !!edgOffsets.iconTitle     = 'Offsets'
  !!edgOffsets.callback      = ''
  !!edgOffsets.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  text .number 'Number' width 10 is REAL
  !!edgOffsets.number.val = 0

  text .offset 'Offset' width 14 is REAL format !!distanceFmt
  !!edgOffsets.offset.val = 0

  -- Measure Distance
  button .measure 'Measure' at xmax ymin callback '!!edgOffsets.setMeasure()'

exit
-- End of form definition for !!edgOffsets

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure()

  -- Define the measure packet
  !packet        = object EDGPACKET()
  !packet.defineMeasure('distance')
  !packet.action = '!!edgOffsets.measure(!this.return[1])'
  !!edgCntrl.add(!packet)

  -- Make measure inactive, until we have the data
  !this.measure.active = false

endmethod
-- End of method definition for .setMeasure()

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description:
--   Setup to measure distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measure(!line is LINE)

  -- Allow measure to be picked again
  !this.measure.active = true

  -- Write angle to form
  !this.offset.val = !line.length()

endmethod
-- End of method definition for .measure(LINE)
