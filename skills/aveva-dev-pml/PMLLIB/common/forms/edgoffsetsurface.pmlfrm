-- File:            edgoffsetsurface.pmlfrm
--   Type:          Form Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Jun 26 15:16:58 BST 1998
--
--
-- Description:
-- Plane offset definition.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Carry out action
--  edgOffsetSurface()               -                   Constructor
--  edit(REAL,STRING)                -                   Setup form
--  measure(LINE)                    -                   Setup to measure distance
--  setMeasure(MENU,STRING)          -                   Setup to measure offset
--
------------------------------------------------------------------------

setup form !!edgOffsetSurface

  !!edgOffsetSurface.formTitle     = 'Offset (from Surface)'
  !!edgOffsetSurface.iconTitle     = ''
  !!edgOffsetSurface.callback      = ''
  !!edgOffsetSurface.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition
  -- Define XYZ data
  text .distance  'Distance '  width 14 is REAL format !!distanceFmt
  !!edgOffset.distance.val = 0

  -- Action
  member .action   is STRING

exit
-- End of form definition for !!edgOffsetSurface

------------------------------------------------------------------------
--
-- Method:      edgOffsetSurface
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgOffsetSurface()

  -- Distance
  !menu = !this.newMenu('distanceMenu')
    !menu.add('CALLBACK', 'Measure',          '!!edgOffsetSurface.setMeasure(')
    !menu.add('CALLBACK', 'Measure Shortest', '!!edgOffsetSurface.setMeasure(')
  !this.distance.setPopup(!this.distanceMenu)

endmethod
-- End of method definition for .edgOffsetSurface()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!distance is REAL, !action is STRING)

  -- Initialise Variables
  !this.distance.val   = !distance
  !this.action         = !action

  -- If action is set, then assign to the callback
  if(!this.action.set()) then
    !this.distance.callback  = !this.action
  endif

  -- Show form
  show !!edgOffsetSurface

endmethod
-- End of method definition for .edit(REAL, STRING)

------------------------------------------------------------------------
--
-- Method:      action
--
-- Description:
--   Carry out action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .action()

  -- Action
  $!<this.action>
  handle any
  endhandle

endmethod
-- End of method definition for .action()

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!menu is MENU, !dummySelected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('distance')
    !packet.action = '!!edgOffsetSurface.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

    -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('shortest')
    !packet.action = '!!edgOffsetSurface.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .setMeasure(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description:
--   Setup to measure distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measure(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.distance.val = 0
  else
    !this.distance.val = !line.length()
  endif

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .measure(LINE)
