--
--
-- Description:
-- Panel setting form edg package.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Write settings to system
--  initialise()                     -
--  setSnap()                        -
--
------------------------------------------------------------------------

setup form !!edgPanelEdit

  !!edgPanelEdit.formTitle     = 'Panel/Floor Pick Settings'
  !!edgPanelEdit.iconTitle     = ''
  !!edgPanelEdit.callback      = '!!edgPanelEdit.initialise()'
  !!edgPanelEdit.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  -- Pick Justification
  rgroup .pickPlane 'Surface/Plane' at xmin ymax+0.25 frame vertical
    add tag ' Plane through visible surface'   select 'VISIBLE'
    add tag ' Plane through opposite surface'  select 'INVISIBLE'
    add tag ' Plane through origin'            select 'ORIGIN'
    add tag ' Plane through centre'            select 'MIDDLE'

  exit

  -- Offset from derived plane
  path   down
  halign right
  text .offset 'Offset from plane ' width 14 is REAL format !!distanceFmt

  -- Snap points
  frame .snapFrame 'Significant Snap Settings' at xmin.pickPlane ymax+0.25

    -- Project end
    rgroup .snap 'Items' callback '!!edgPanelEdit.setSnap()' frame horizontal
      add tag ' Edges'      select 'TRUE'
      add tag ' Members'    select 'FALSE'
    exit

    -- Project Plines
    path right
    frame .projectionFrame 'Components' at xmin ymax
      toggle .vertices ' Vertices' states 'FALSE' 'TRUE'
      toggle .fittings ' Fittings' states 'FALSE' 'TRUE'
    exit

  exit

  -- Apply/Dismiss
  button .apply   'Apply'   at xmin           ymax+0.25 callback '!!edgPanelEdit.apply()'
  button .dismiss 'Dismiss' at xmax form-size ymin ok
  button .reset   'Reset'   at xcen form-4    ymin      callback '!!edgPanelEdit.initialise()'

  -- Form Members
  member .panelSettings   is EDGPANEL

exit
-- End of form definition for !!edgPanelEdit

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Copy Current settings
  !this.panelSettings = !!edgTypes.panel

  -- Set Snap components
  !this.snap.select(!this.panelSettings.edges.string().upcase())

  !this.vertices.val  = !this.panelSettings.vertex
  !this.fittings.val  = !this.panelSettings.fitting

  -- Offset
  !this.offset.val    = !this.panelSettings.offset

  -- Set pick plane
  !this.pickPlane.select(!this.panelSettings.pickSurface().upcase())

  -- Set snap
  !this.setSnap()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setSnap
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSnap()

  -- Grey in/out snap toggles
  if(!this.snap.selection().boolean()) then
    !this.vertices.active = false
    !this.fittings.active = false
  else
    !this.vertices.active = true
    !this.fittings.active = true
  endif

endmethod
-- End of method definition for .setSnap()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Write settings to system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Copy relevant setting data to !!edgTypes.sctn object
  !!edgTypes.panel.edges         = !this.snap.selection().boolean()
  !!edgTypes.panel.vertex        = !this.vertices.val
  !!edgTypes.panel.fitting       = !this.fittings.val
  -- Offset
  !!edgTypes.panel.offset        = !this.offset.val

  !!edgTypes.panel.pickSurface(!this.pickPlane.selection())

endmethod
-- End of method definition for .apply()
