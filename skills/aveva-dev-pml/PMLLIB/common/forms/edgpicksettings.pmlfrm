--
-- Author:          J. Brunning
-- Created:         Thu Nov 20 2003
--
--
-- Description:
-- Settings for picking from the graphical view
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   action for click on Apply or OK
--  applyPanelsFloors()              -                   Write panels and floors settings to system
--  applyPickFilters(STRING,RULESTOREDATA,REAL) -                   called on Apply to set pick filters
--  applySectionsWalls()             -                   Write panels and floors settings to system
--  displayElementFilters()          -                   updates the Element Filters gadgets with the current settings
--  displayPanelsFloors()            -                   updates the Panels & Floors gadgets with the current settings
--  displayPlineFilters()            -                   updates the Pline Filters gadgets with the current settings
--  displayPpointFilters()           -                   updates the PPoint Filters gadgets with the current settings
--  displaySectionsWalls()           -                   updates the Sections & Walls gadgets with the current settings
--  edgPickSettings()                -                   constructor
--  frameSectionsWalls()             -                   constructor for Sections & Walls frame
--  initialise()                     -                   initialisation called when form opened
--  selectFrame(STRING)              -                   replace currently active frame by one selected from list
--  setProjected()                   -                   Set whether the ends are projected
--  setSnap()                        -                   activate/deactivate component snap gadgets
--  showForm(STRING)                 -                   open form with particular frame showing
--
------------------------------------------------------------------------
setup form !!edgPickSettings
  title 'Snap Settings'
  !framePos = 'at x0 y0 width 18 height 9'

  frame .tabset tabset at x0.3 y0.15 width 28
    frame .frameElementFilters 'Element Filters' $!framePos
      path down
      -- Current Filter list
      list .elementFilters 'Element Filters' width 45 length 10

      -- Define a new rule
      button .elementDefine 'Define Rule...' callback '!!ruleStore.element.edit(''!!edgPickSettings.displayElementFilters()'')'
    exit

    frame .framePlineFilters 'Pline Filters' $!framePos
      -- Current Filter list
      list .plineFilters 'Pline Filters' width 45 length 10

      -- Define a new rule
      button .plineDefine 'Define Rule...' callback '!!ruleStore.pLine.edit(''!!edgPickSettings.displayPlineFilters()'')'
    exit

    frame .framePpointFilters 'Ppoint Filters' $!framePos
      -- Current Filter list
      list .ppointFilters 'Ppoint Filters' width 45 length 10

      -- Define a new rule
      button .ppointDefine 'Define Rule...' callback '!!ruleStore.point.edit(''!!edgPickSettings.displayPpointFilters()'')'
    exit

    frame .frameSectionsWalls 'Sections & Walls' $!framePos
      path down
      -- paragraph .sectionEnds text 'Section Ends'
      -- Section end projection
      -- Project end
      rgroup .projected 'Section End Position' callback '!this.setProjected()' frame horizontal
        add tag 'Projected    ' select 'TRUE'
        add tag 'Start/End                 ' select 'FALSE'
      exit
      -- Project Plines
      frame .projectionFrame 'Projection' width 47
        -- Owning
        $(
        rgroup .projectOwning   'Section Line' frame vertical
        -- Line
          add tag 'Justification x' select 'JUSLINE'
          add tag 'Member'        select 'MEMLINE'
          add tag 'Joint'         select 'JLINE'
        exit
         -- Attached
        rgroup .projectAttached 'Attached Line' frame vertical at xmax ymin
          --  Line
          add tag 'Justification x' select 'JUSLINE'
          add tag 'Member'        select 'MEMLINE'
          add tag 'Joint'         select 'JLINE'
        exit
        $)
        option .projectOwning   'Section Line ' width 13
        halign right
        option .projectAttached 'Attached Line' width 13
        halign left
      exit
      -- Pline Extend: Cut/Uncut end
      rgroup .pLines 'Pline End Position' frame vertical
        add tag 'Uncut (Intersect with cutplane)           ' select 'FALSE'
        -- tooltip 'Intersect with cutplane'
        add tag 'Cut (Use end preparation)'   select 'TRUE'
        -- tooltip 'Use end preparation geometry'
      exit
      -- Intermediate Snap
      frame .SWsnapFrame 'Significant Snap Points' width 47
        path right
        toggle .fitting 'Fittings'
        toggle .joint   'Joints  '
        toggle .node    'Nodes   '
      exit
    exit

    frame .framePanelsFloors 'Panels & Floors' $!framePos
      rgroup .pickPlane 'Surface/Plane' frame vertical
        add tag 'Plane through visible surface'   select 'VISIBLE'
        add tag 'Plane through opposite surface            '  select 'INVISIBLE'
        add tag 'Plane through origin'            select 'ORIGIN'
        add tag 'Plane through centre'            select 'MIDDLE'
      exit
      -- Offset from derived plane
      path   down
      text .offset 'Offset from plane' width 14 is REAL format !!distanceFmt

      -- Snap points
      -- frame .PFsnapFrame 'Significant Snap Settings'
      paragraph .sigSnapSettings text 'Significant Snap Settings'
        -- Project end
        rgroup .snap 'Items' at ymax callback '!this.setSnap()' frame vertical spacing 0.25
          add tag 'Edges'   select 'TRUE'
          add tag 'Members       ' select 'FALSE'
        exit
        -- Project Plines
        path right
        frame .componentFrame 'Components' at ymin height 3.15
          path down
          vdist 0
          toggle .vertices 'Vertices      '
          vdist 0.25
          toggle .fittings 'Fittings'
        exit
      -- exit
    exit
  exit

  -- OK/Cancel/Apply buttons
  path left
  button .apply   'Apply '  at xmax form - size ymax form + 0.2 callback '!this.apply()'
  button .dismiss 'Cancel'                                                               CANCEL
  button .OK      '  OK  '                                      callback '!this.apply()' OK

  -- Form Members
  member .sectionSettings is EDGSCTN
  member .pLineSettings   is EDGPLINE
  member .panelSettings   is EDGPANEL

  -- members to store current rules
  member .elementRule     is RULE
  member .plineRule       is RULE
  member .ppointRule      is RULE

  member .currentFrame    is STRING
  member .frames          is ARRAY

exit
-- End of form definition for !!edgPickSettings

------------------------------------------------------------------------
--
-- Method:      edgPickSettings
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .edgPickSettings()
  -- set up initialisation call
  !this.initcall = '!this.initialise()'

  -- set up options on menu
  !frames = array()
  !frames.append('FRAMEELEMENTFILTERS')
  !frames.append('FRAMEPLINEFILTERS')
  !frames.append('FRAMEPPOINTFILTERS')
  !frames.append('FRAMESECTIONSWALLS')
  !frames.append('FRAMEPANELSFLOORS')
  !this.frames = !frames

  -- execute construction methods for individual frames
  !this.frameSectionsWalls()
  -- !this.framePanelsFloors()

  -- set current frame
  !this.currentFrame = 'FRAMEELEMENTFILTERS'

endmethod
-- End of method definition for .edgPickSettings

------------------------------------------------------------------------
--
-- Method:      .frameSectionsWalls()
--
-- Description: constructor for Sections & Walls frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .frameSectionsWalls()
  !dtext = array()               !rtext = array()
  !dtext.append('Justification') !rtext.append('JUSLINE')
  !dtext.append('Member')        !rtext.append('MEMLINE')
  !dtext.append('Joint')         !rtext.append('JLINE')
  !this.projectOwning.dtext = !dtext
  !this.projectOwning.rtext = !rtext
  !this.projectAttached.dtext = !dtext
  !this.projectAttached.rtext = !rtext
endmethod
-- End of method definition for .frameSectionsWalls()

------------------------------------------------------------------------
--
-- Method:      showForm
--
-- Description:
--   open form with particular frame showing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      string containing name of frame to show
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showForm(!frameName is STRING)
  !frameNameUC = !frameName.upcase()
  if (!this.frames.findFirst(!frameNameUC).set()) then
    !this.show()
    !this.selectFrame(!frameNameUC)
  elseif (!this.frames.findFirst('FRAME' & !frameNameUC).set()) then
    !this.show()
    !this.selectFrame('FRAME' & !frameNameUC)
  else
    !error = 'Frame ' & !frameName & ' not found on form'
    return error 1 '$!error'
  endif
endmethod
-- End of method definition for .showForm(STRING)

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   initialisation called when form opened
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  -- get current settings
  !this.sectionSettings = !!edgTypes.sctn
  !this.pLineSettings   = !!edgTypes.pLine
  !this.panelSettings   = !!edgTypes.panel

  !this.displaySectionsWalls()
  !this.displayPanelsFloors()
  !this.displayElementFilters()
  !this.displayPlineFilters()
  !this.displayPpointFilters()

  -- set list to correct value
  -- !this.settingsList.select('RTEXT', !this.currentFrame)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      selectFrame
--
-- Description:
--   replace currently active frame by one selected from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectFrame(!frameName is STRING)
  -- !frameName = !this.settingsList.selection('RTEXT')
  !this.attribute(!frameName).visible = TRUE
  !this.currentFrame = !frameName
endmethod
-- End of method definition for .selectFrame(STRING)

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description:
--   updates the gadgets with the current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      .displaySectionsWalls()
--
-- Description: updates the Sections & Walls gadgets with the current settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displaySectionsWalls()
  -- Set Section projection to current setting
  !this.projected.select(!this.sectionSettings.project.string())
  -- !this.projectOwning.select(!this.sectionSettings.owningLine.upcase())
  -- !this.projectAttached.select(!this.sectionSettings.attachedLine.upcase())
  !this.projectOwning.select('RTEXT', !this.sectionSettings.owningLine.upcase())
  !this.projectAttached.select('RTEXT', !this.sectionSettings.attachedLine.upcase())


  -- Set Pline to current settings
  !this.pLines.select(!this.pLineSettings.cut.string().upcase())

  -- Set intermediate snaps
  !this.fitting.val = !this.sectionSettings.fitting
  !this.joint.val   = !this.sectionSettings.joint
  !this.node.val    = !this.sectionSettings.node

  -- Setup projection gadgets
  !this.setProjected()
endmethod
-- End of method definition for .displaySectionsWalls()

------------------------------------------------------------------------
--
-- Method:      .displayPanelsFloors()
--
-- Description: updates the Panels & Floors gadgets with the current settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayPanelsFloors()
  -- Set Snap components
  !this.snap.select(!this.panelSettings.edges.string().upcase())

  !this.vertices.val  = !this.panelSettings.vertex
  !this.fittings.val  = !this.panelSettings.fitting

  -- Offset
  !this.offset.val    = !this.panelSettings.offset

  -- Set pick plane
  !this.pickPlane.select(!this.panelSettings.pickSurface().upcase())

  -- Set snap
  !this.setSnap()
endmethod
-- End of method definition for .displayPanelsFloors()

------------------------------------------------------------------------
--
-- Method:      .displayElementFilters()
--
-- Description: updates the Element Filters gadgets with the current settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayElementFilters()
  -- Initialise Variables
  !rules    = ARRAY()
  !rules[1] = '>> No Rule <<'
  -- get the currently defined element rules
  !rules.appendArray(!!ruleStore.element.getRules())
  -- Display Rules
  !this.elementFilters.dText = !rules
  -- Setup form to current rule
  if(!this.elementRule.name.set()) then
    !this.elementFilters.select('DTEXT', !this.elementRule.name)
  endif
endmethod
-- End of method definition for .displayElementFilters()

------------------------------------------------------------------------
--
-- Method:      .displayPlineFilters()
--
-- Description: updates the Pline Filters gadgets with the current settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayPlineFilters()
  -- Initialise Variables
  !rules    = ARRAY()
  !rules[1] = '>> No Rule <<'
  -- get the currently defined element rules
  !rules.appendArray(!!ruleStore.pLine.getRules())
  -- Display Rules
  !this.plineFilters.dText = !rules
  -- Setup form to current rule
  if(!this.plineRule.name.set()) then
    !this.plineFilters.select('DTEXT', !this.plineRule.name)
  endif
endmethod
-- End of method definition for .displayPlineFilters()

------------------------------------------------------------------------
--
-- Method:      .displayPpointFilters()
--
-- Description: updates the PPoint Filters gadgets with the current settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayPpointFilters()
  -- Initialise Variables
  !rules    = ARRAY()
  !rules[1] = '>> No Rule <<'
  -- get the currently defined element rules
  !rules.appendArray(!!ruleStore.point.getRules())
  -- Display Rules
  !this.ppointFilters.dText = !rules
  -- Setup form to current rule
  if(!this.ppointRule.name.set()) then
    !this.ppointFilters.select('DTEXT', !this.ppointRule.name)
  endif
endmethod
-- End of method definition for .displayPpointFilters()

------------------------------------------------------------------------
--
-- Method:      setProjected
--
-- Description:
--   Set whether the ends are projected
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setProjected()

  -- Grey in/out projection lines
  if(!this.projected.selection().boolean()) then
    -- !this.projectOwning.active    = true
    -- !this.projectAttached.active  = true
    !this.projectionFrame.active  = true
    !this.sectionSettings.project = true
  else
    -- !this.projectOwning.active    = false
    -- !this.projectAttached.active  = false
    !this.projectionFrame.active  = false
    !this.sectionSettings.project = false
  endif

endmethod
-- End of method definition for .setProjected()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   action for click on Apply or OK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  !this.applySectionsWalls()
  !this.applyPanelsFloors()
  !this.applyPickFilters(!this.elementFilters.selection(), !!ruleStore.element, 3)
  !this.applyPickFilters(!this.plineFilters.selection(), !!ruleStore.pline, 1)
  !this.applyPickFilters(!this.ppointFilters.selection(), !!ruleStore.point, 2)
  -- Apply filters to currently active "design" views
  !!edgCntrl.setFilters()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      applySectionsWalls
--
-- Description:
--   Write panels and floors settings to system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applySectionsWalls()
  -- Copy relevant setting data to !!edgTypes.sctn object
  !!edgTypes.sctn.project        = !this.sectionSettings.project
  !!edgTypes.sctn.attachedLine   = !this.projectAttached.selection()
  !!edgTypes.sctn.owningLine     = !this.projectOwning.selection()

  -- Set intermediate snaps
  !!edgTypes.sctn.fitting        = !this.fitting.val
  !!edgTypes.sctn.joint          = !this.joint.val
  !!edgTypes.sctn.node           = !this.node.val

  -- Copy relevant setting data to !!edgTypes.sctn object
  !!edgTypes.stwall.project      = !this.sectionSettings.project
  !!edgTypes.stwall.attachedLine = !this.projectAttached.selection()
  !!edgTypes.stwall.owningLine   = !this.projectOwning.selection()

  -- Set intermediate snaps
  !!edgTypes.stwall.fitting      = !this.fitting.val
  !!edgTypes.stwall.joint        = !this.joint.val
  !!edgTypes.stwall.node         = !this.node.val

  -- Copy relevant setting data to !!edgTypes.pLine object
  !!edgTypes.pLine.cut           = !this.pLines.selection().boolean()

  -- Set intermediate snaps
  !!edgTypes.pLine.fitting       = !this.fitting.val
  !!edgTypes.pLine.joint         = !this.joint.val
  !!edgTypes.pLine.node          = !this.node.val
endmethod
-- End of method definition for .applySectionsWalls()

------------------------------------------------------------------------
--
-- Method:      applyPanelsFloors
--
-- Description:
--   Write panels and floors settings to system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyPanelsFloors()

  -- Copy relevant setting data to !!edgTypes.sctn object
  !!edgTypes.panel.edges    = !this.snap.selection().boolean()
  !!edgTypes.panel.vertex   = !this.vertices.val
  !!edgTypes.panel.fitting  = !this.fittings.val
  -- Offset
  !!edgTypes.panel.offset   = !this.offset.val

  !!edgTypes.panel.pickSurface(!this.pickPlane.selection())

endmethod
-- End of method definition for .applyPanelsFloors()

------------------------------------------------------------------------
--
-- Method:      setSnap
--
-- Description: activate/deactivate component snap gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSnap()
  -- Grey in/out snap toggles
  if(!this.snap.selection().boolean()) then
    -- !this.vertices.active = false
    -- !this.fittings.active = false
    !this.componentFrame.active = false
  else
    -- !this.vertices.active = true
    -- !this.fittings.active = true
    !this.componentFrame.active = true
  endif
endmethod
-- End of method definition for .setSnap()

------------------------------------------------------------------------
--
-- Method:      applyPickFilters
--
-- Description:
--   called on Apply to set pick filters
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyPickFilters(!ruleStr is STRING, !ruleStore is RULESTOREDATA, !pos is REAL)

  -- Get selected rule
  if(!ruleStr ne '>> No Rule <<') then
    !rule = !ruleStore.getRule(!ruleStr)

  -- ">> No Rule <<" selected
  else
    !rule = object RULE()
  endif

  -- Setup Types
  if(!rule.types.set() and !rule.types.empty().not()) then
    !inTypes   = !rule.types.trim('LMR').replace(' ',''',''')
    !inTypes   = 'TYPE inset(''' & !inTypes & ''')'
  -- No Specific Element
  else
    !inTypes   = ''
  endif

   -- Setup Rule
  if(!rule.rule.set() and !rule.rule.empty().not()) then
    if(!inTypes.empty().not()) then
      !inRule    = ' AND (' & !rule.rule & ')'
    else
      !inRule    = !rule.rule
    endif
  -- No Rule Define
  else
    !inRule   = ''
  endif

  -- Inmode filter
  !inMode     = !inTypes & !inRule

  !!edgCntrl.inmodeData[!pos] = !inMode
endmethod
-- End of method definition for .applyPickFilters()
