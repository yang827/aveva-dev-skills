--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jun 1 10:35:20 BST 1998
--
--
-- Description:
-- Current EDG point filter.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edit()                           -                   Select a filter
--  initialise()                     -                   Initialisation for form
--  select()                         -                   Select a filter
--  update()                         -                   Update current list of filters
--
------------------------------------------------------------------------

setup form !!edgPointFilter

  !!edgPointFilter.formTitle     = 'Point Filter'
  !!edgPointFilter.iconTitle     = 'Filter'
  !!edgPointFilter.callback      = '!this.initialise()'
  !!edgPointFilter.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition

  -- Current Filter list
  list .filters 'Available Filters' at xmin y1 callback '!this.select()' width 35 length 10

  -- Define a new rule
  button .define 'Define Rule...' at xmax form-size ymin-1 callback '!!ruleStore.point.edit(''!!edgPointFilter.update()'')'

  -- Form members

  -- Current selected rule
  member .rule       is RULE

  -- Expanded rules for different mechanisms
  member .pick       is STRING
  member .collection is STRING
  member .inMode     is STRING

exit
-- End of form definition for !!edgPointFilter

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialisation for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Update list with current rules
  !this.update()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description:
--   Update current list of filters
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  -- Initialise Variables
  !rules    = ARRAY()
  !rules[1] = '>> No Rule <<'

  -- get the currently defined element rules
  !rules.appendArray(!!ruleStore.point.getRules())

  -- Display Rules
  !this.filters.dText = !rules

  -- Setup form to current rule
  if(!this.rule.name.set()) then
    !this.filters.select('DTEXT', !this.rule.name)
  endif

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description:
--   Select a filter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select()

  -- Get selected rule
  if(!this.filters.selection() ne '>> No Rule <<') then
    !rule = !!ruleStore.point.getRule(!this.filters.selection())

  -- ">> No Rule <<" selected
  else
    !rule = object RULE()
  endif

  -- Assign selected rule to current selected rule
  !this.rule = !rule

  -- Setup Types
  if(!this.rule.types.set() and !this.rule.types.empty().not()) then
    !inTypes   = !this.rule.types.trim('LMR').replace(' ',''',''')
    !inTypes   = 'TYPE inset(''' & !inTypes & ''')'
    !pickTypes = 'ALL (' & !this.rule.types & ')'

    -- No Specific Element
  else
    !inTypes   = ''
    !pickTypes = ''
  endif

   -- Setup Rule
  if(!this.rule.rule.set() and !this.rule.rule.empty().not()) then
    if(!inTypes.empty().not()) then
      !inRule    = ' AND (' & !this.rule.rule & ')'
    else
      !inRule    = !this.rule.rule
    endif

    if(!pickTypes.empty().not()) then
      !pickRule  = ' WITH (' & !this.rule.rule & ')'
    else
      !pickRule  = !this.rule.rule
    endif

  -- No Rule Define
  else
    !inRule   = ''
    !pickRule = ''
  endif

  -- Derive "other" types of rule
  !this.pick       = !pickTypes & !pickRule
  !this.collection = !pickTypes & !pickRule

  -- Inmode filter
  !this.inMode     = !inTypes & !inRule

  -- Apply filters to currently active "design" views
  !!edgCntrl.setFilters()

  -- Hide form
  !this.hide()

endmethod
-- End of method definition for .select()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Select a filter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit()

  -- Show form
  show !!edgPointFilter

endmethod
-- End of method definition for .edit()
