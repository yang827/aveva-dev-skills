--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgPositioning()                 -                   Constructor
--
------------------------------------------------------------------------

-- Define form
setup form !!edgPositioning at xr0.9 yr0.0

  !!edgPositioning.formTitle     = 'Positioning Control'
  !!edgPositioning.iconTitle     = 'PosCntrl'
  !!edgPositioning.callback      = ''
  !!edgPositioning.formRevision  = ' $Revision: 1.18 $ '

  -- Body of form definition
  if(defined(!!cadcOldPosForm)) then

    -- Pick Type Selection
    option .pick              at xmin+2 ymax+0.25 tooltip 'Type of cursor pick'         width 8
    path down
    halign right
    option .pickType                              tooltip 'Method of deriving position' width 10

    -- Input value
    text   .input       ' '   at xmax ymin        tooltip 'Value applied to "Option"'   width 10 is REAL format !!edgFormat
    path up
    halign right
    button .explicit                              tooltip 'Explicit Position'         pixmap width 16 height 16 callback 'show !!edgEPosition free'
    valign centre
    path left
    hdist 1
    button .wp toggle                             tooltip 'Turn working plane on/off' pixmap width 16 height 16 callback '!!edgPosCntrl.activePlane(_wp.val)'

  -- Default
  else
    button .wp toggle tooltip 'Working Plane' pixmap width 16 height 16 callback '!!edgPosCntrl.activePlane(_wp.val)'
    path right
    valign bottom
    hdist 0
    option .pick      tooltip 'Pick Type'         width 8
    option .pickType  tooltip 'Pick Method' width 10
    text   .input     tooltip 'Method Value'   width 10 is REAL format !!edgFormat
    button .explicit  tooltip 'Explicit Position'    pixmap width 16 height 16 callback 'show !!edgEPosition free'
  endif

exit
-- End of form definition for !!edgPositioning

------------------------------------------------------------------------
--
-- Method:      edgPositioning
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgPositioning()

  -- Set icon to form
  !this.explicit.addPixmap(!!pml.getPathName('xyz16.png'))
  !this.wp.addPixmap(!!pml.getPathName('workingplaneoff16.png'), !!pml.getPathName('workingplaneon16.png'))

  -- Real Format
  if(undefined(!!realFmt)) then
    !!realFmt              = object FORMAT()
    !!realFmt.dimension    = 'NONE'
    !!realFmt.dp           = 2
  endif

  -- Integer Format
  if(undefined(!!integerFmt)) then
    !!integerFmt           = object FORMAT()
    !!integerFmt.dimension = 'NONE'
    !!integerFmt.dp        = 0
  endif

  -- Register method in edgPosCntrl object for working plane
--  !!edgPosCntrl.wpMethod('!!edgPositioning.updateGadgets()')

endmethod
-- End of method definition for .edgPositioning()
