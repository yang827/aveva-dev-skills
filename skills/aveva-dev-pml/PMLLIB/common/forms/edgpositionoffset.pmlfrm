--
--  Description:     Undefined
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgPositionOffset()              -                   Constructor method
--  initialise()                     -                   Initialise when shown
--  setOffset()                      -                   Offset position changed
--
layout form !!edgPositionOffset at xr0.9 yr0.0

  path down

  para .heading       at x1 y0 text 'Enter offset to be applied to subsequent picks'
  frame .offset panel
    text   .x  'X'   tagwidth 3 width 20 is REAL format !!distanceFmt
    text   .y  'Y'   tagwidth 3 width 20 is REAL format !!distanceFmt
    text   .z  'Z'   tagwidth 3 width 20 is REAL format !!distanceFmt
  exit

  -- Position XYZ Offset
  member .position     is POSITIONLINK
  -- store last offset so that form can be reinitialised when show
  member .lastPosition is POSITION

exit

------------------------------------------------------------------------
--
-- Method:      .edgPositionOffset()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--
define method .edgPositionOffset()

  !this.formTitle     = 'Pick Offset'
  !this.iconTitle     = 'Offset'
  !this.cancelcall    = '!!edgPosCntrl.offsetToggle(false)'
  !this.killingcall   = '!!edgPosCntrl.offsetToggle(false)'
  !this.callback      = '!this.initialise()'

  !this.position.linkInput('!!edgpositionOffset.position', !this.x, !this.y, !this.z)

  !this.x.val = 0mm
  !this.y.val = 0mm
  !this.z.val = 0mm

  !this.position.initialise()
  !this.lastPosition = !this.position.get()

  -- callback for position change
  !this.position.setAction('!!edgPositionOffset.setOffset()')

  endmethod

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: Initialise when shown
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !this.position.setPositionNoAct(!this.lastPosition)
  !this.setOffset()

endmethod

------------------------------------------------------------------------
--
-- Method:      .setOffset()
--
-- Description: Offset position changed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setOffset()

  -- Handle unset values
  if(!this.x.val.unset()) then
    !this.x.val = 0mm
  endif

  if(!this.y.val.unset()) then
    !this.y.val = 0mm
  endif

  if(!this.z.val.unset()) then
    !this.z.val = 0mm
  endif

  !this.lastPosition = !this.position.get()
  !!edgPosCntrl.setOffset(!this.lastPosition)

endmethod
