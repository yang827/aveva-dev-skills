setup form !!edgPosOffset

  !!edgPosOffset.formTitle     = 'Offset Position'
  !!edgPosOffset.iconTitle     = 'PosOffset'
  !!edgPosOffset.callback      = ''
  !!edgPosOffset.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  text .distance  'Distance ' width 14 is IS REAL format !!distanceFmt
  text .direction 'Direction '


exit
-- End of form definition for !!edgPosOffset
