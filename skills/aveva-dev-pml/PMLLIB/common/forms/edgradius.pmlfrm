--
--
-- Description:
-- Specify a radius.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgRadius()                      -                   Constructor
--  measure(LINE)                    -                   Setup to measure distance
--  setMeasure(GADGET,STRING)        -                   Setup to measure offset
--  setMeasure(MENU,STRING)          -                   Setup to measure offset
--  setradius()                      -
--
------------------------------------------------------------------------

-- Define form
setup form !!edgRadius

  !!edgRadius.formTitle     = 'Radius'
  !!edgRadius.iconTitle     = ''
  !!edgRadius.callback      = ''
  !!edgRadius.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition
  text .radius 'Radius' callback '!this.setRadius()' width 14  is REAL format !!distanceFmt
  !!edgRadius.radius.val = 0

  -- Measure Distance
  button .measure 'Measure' at xmax ymin callback '!!edgRadius.setMeasure('

exit
-- End of form definition for !!edgRadius

------------------------------------------------------------------------
--
-- Method:      edgRadius
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgRadius()

  -- Define right-mouse buttons
  -- Distance
  !menu = !this.newMenu('distanceMenu')
    !menu.add('CALLBACK', 'Measure',          '!this.setMeasure(')
    !menu.add('CALLBACK', 'Measure Shortest', '!this.setMeasure(')
  !this.radius.setPopup(!this.distanceMenu)

endmethod
-- End of method definition for .edgRadius()

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('DISTANCE')
    !packet.action = '!!edgRadius.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

    -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('SHORTEST')
    !packet.action = '!!edgRadius.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .setMeasure(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!dummyGadget is GADGET, !selected is STRING)

  -- Initialise Variables
  -- Define the measure packet
  !packet        = object EDGPACKET()
  !packet.defineMeasure('DISTANCE')
  !packet.action = '!!edgRadius.measure(!this.return[1])'
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .setMeasure(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description:
--   Setup to measure distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measure(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.radius.val = 0
  else
    !this.radius.val = !line.length()
  endif

endmethod
-- End of method definition for .measure(LINE)


------------------------------------------------------------------------
define method .setradius()
  -- called when user types radius value
  if(!this.radius.val.unset()) then
    !this.radius.val = 0
  endif

endmethod
