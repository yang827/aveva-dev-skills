-- File:            edgsettings.pmlfrm
--   Type:          Form Definition
--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Jul 23 09:41:06 BST 1998
--
--
-- Description:
-- Setting control form for edgPicking.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Carry out action
--  direction(DIRECTION)             -                    Set up direction of offset
--  edgSettings()                    -                   Constructor method
--  editDD(DIRECTION,REAL,STRING)    -                   set to Direction/Distance frame
--  editENU(POSITION,STRING)         -                   sets frame to E/N/U
--  editNone()                       -                   sets frame to None
--  editPlane(XYPOSITION,STRING)     -                   sets Frame to Plane
--  editSurface(REAL,STRING)         -                   set form to Surface frame
--  initialise()                     -                   Initialise Form
--  measureDD(LINE)                  -                   called by EDG when measure finished
--  measureENU(STRING,LINE)          -                   called by EDG when measure finished
--  measurePlane(STRING,LINE)        -                   called by EDG when measure finished
--  measureSurface(LINE)             -                   called by EDG when measure finished
--  offset()                         -                   sets offset type
--  offsetDD()                       -                   constructor for Offset Distance/Direction frame
--  offsetENU()                      -                   constructor for Offset E/N/U frame
--  offsetPlane()                    -                   constructor for Offset Plane frame
--  offsetSurface()                  -                   constructor for Offset Surface frame
--  openSettings(STRING)             -                   opens the settings form on the correct tab
--  setDirection(GADGET,STRING)      -                    Set up direction of offset
--  setDirection(MENU,STRING)        -                    Set up direction of offset
--  setMeasureDD(GADGET,STRING)      -                   Setup to measure offset
--  setMeasureDD(MENU,STRING)        -                   Setup to measure offset
--  setMeasureENU(STRING,STRING)     -
--  setMeasurePlane(STRING,STRING)   -                   Setup to measure offset
--  setMeasureSurface(MENU,STRING)   -                   Setup to measure Surface offset
--  snap()                           -                   Set significant snap mode on picking
--
------------------------------------------------------------------------
layout form !!edgSettings
--setup form !!edgSettings

  !this.formTitle     = 'Picking Control'
  !this.iconTitle     = 'Pick Cntrl'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition
  !framePos = 'at x0 ymax.offset+0.2 wid 24 height 4.5'
  path down

  -- Significant Snap
  toggle .snap 'Significant Snaps' callback '!this.snap()' states 'false' 'true'
  paragraph .sectionSettings      width 17 lines 1
  button    .setSection 'Set...'  at xmax ymin callback 'show !!edgSection'
  paragraph .panelSettings        at x0 width 17 lines 1
  button    .setPanel   'Set...'  at xmax ymin callback 'show !!edgPanelEdit'

  --button .settings 'Snap Settings...' at x0 callback '!this.openSettings(|SECTIONSWALLS|)'

  -- Offset Settings (hard coded, even though !!edgPosCntrl holds the different types
  frame .offset 'Offset' at x0 width 24
   rToggle .noneOnly 'None'               states '' 'NONE'
   rToggle .enu      'East/North/Up'      states '' 'ENU'
   rToggle .onPlane  'On Plane'           states '' 'PLANE'
   rToggle .disDir   'Distance Direction' states '' 'DIST&DIR'
   rToggle .fromDir  'From Direction'     states '' 'SURFACE'
  exit

  frame .offsetNone 'None' $!framePos
    para .none text 'No offset from the picked position.' wid to max height 3
  exit


  frame .offsetENU 'E/N/U' $!framePos
    option .xOptionENU                            width 5
    option .yOptionENU                            width 5
    option .zOptionENU                            width 5
    text   .xENU        at xmax ymin.xOptionENU   width 13 is REAL format !!distanceFmt
    text   .yENU        at xmin ymin.yOptionENU   width 13 is REAL format !!distanceFmt
    text   .zENU        at xmin ymin.zOptionENU   width 13 is REAL format !!distanceFmt

    -- Position XYZ Offset
    member .positionENU is POSITIONLINK
  exit

  frame .offsetPlane 'Plane' $!framePos

    -- Define XYZ data
    option .xOptionPlane                              width 5
    option .yOptionPlane                              width 5
    text   .xPlane        at xmax ymin.xOptionPlane   width 13 is REAL format !!distanceFmt
    text   .yPlane        at xmin ymin.yOptionPlane   width 13 is REAL format !!distanceFmt

    -- Position XYZ Offset
    member .positionPlane is XYPOSITIONLINK
  exit

  frame .offsetDD 'Distance & Direction' $!framePos
    -- Direction
    text .directionDD 'Direction' width 13 is DIRECTION
    !this.directionDD.val = N

    -- Distance
    path down
    halign right
    text .distanceDD  'Distance '  width 13 is REAL format !!distanceFmt
    !this.distanceDD.val = 0

    -- Pick Direction
    -- button .pick    'Pick'    at xmax.directionDD+1 ymin.directionDD callback '!this.setDirection('

    -- Measure Distance
    -- button .measure 'Measure' at xmax.distanceDD+1  ymin.distanceDD  callback '!this.setMeasureDD('
  exit

  frame .offsetSurface 'From Surface' $!framePos
    -- Define XYZ data
    text .distanceSurface  'Distance '  width 13 is REAL format !!distanceFmt
    !this.distanceSurface.val = 0
  exit

  -- action of form
  member .action is STRING

  -- current frame
  member .currentFrame is REAL

  -- contains names of frames
  member .frames is ARRAY

exit
-- End of form definition for !!edgSettings

------------------------------------------------------------------------
--
-- Method:      .edgSettings()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .edgSettings()

  !frames = ARRAY()
  !frames[1] = 'offsetNone'
  !frames[2] = 'offsetENU'
  !frames[3] = 'offsetPlane'
  !frames[4] = 'offsetDD'
  !frames[5] = 'offsetSurface'
  !this.frames = !frames

  !this.offsetENU()
  !this.offsetPlane()
  !this.offsetDD()
  !this.offsetSurface()

  !this.sectionSettings.val = 'Section and wall settings'
  !this.panelSettings.val   = 'Panel and floor settings'

  !this.offset.callback = '!this.offset()'
  !this.noneOnly.val = true
endmethod
-- End of method definition for .edgSettings()

------------------------------------------------------------------------
--
-- Method:      .editNone()
--
-- Description: sets frame to None
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .editNone()
  !this.action = STRING()
endmethod
-- End of method definition for .editNone()

------------------------------------------------------------------------
--
-- Method:      .offsetENU()
--
-- Description: constructor for Offset E/N/U frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .offsetENU()
  -- XYZ Offset
  var !coordinate coordinate
  !this.positionENU.linkInput('!!edgSettings.positionENU', !this.xENU, !this.yENU, !this.zENU)
  !this.positionENU.linkOption('!!edgSettings.positionENU', !this.xOptionENU, !this.yOptionENU, !this.zOptionENU, !coordinate)

  -- Distance
  !menu = !this.newMenu('distanceMenuXenu')
  !menu.add('CALLBACK', 'Measure',          '!this.setMeasureENU(''MEASURE'',''East'')')
  !menu.add('CALLBACK', 'Measure Shortest', '!this.setMeasureENU(''SHORTEST'',''East'')')
  !this.xENU.setPopup(!menu)

  !menu = !this.newMenu('distanceMenuYenu')
  !menu.add('CALLBACK', 'Measure',          '!this.setMeasureENU(''MEASURE'',''North'')')
  !menu.add('CALLBACK', 'Measure Shortest', '!this.setMeasureENU(''SHORTEST'',''North'')')
  !this.yENU.setPopup(!menu)

  !menu = !this.newMenu('distanceMenuZenu')
  !menu.add('CALLBACK', 'Measure',          '!this.setMeasureENU(''MEASURE'',''Up'')')
  !menu.add('CALLBACK', 'Measure Shortest', '!this.setMeasureENU(''SHORTEST'',''Up'')')
  !this.zENU.setPopup(!menu)
endmethod
-- End of method definition for .offsetENU()

------------------------------------------------------------------------
--
-- Method:      .editENU()
--
-- Description: sets frame to E/N/U
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION
--    2   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .editENU(!position is POSITION,  !action is STRING)

  -- Initialise Variables
  !this.positionENU.position(!position)
  !this.action = !action

  -- If action is set, then assign to the callback
  if(!this.action.set()) then
    !this.positionENU.setAction(!this.action)
  endif

endmethod
-- End of method definition for .edit(POSITION,  STRING)

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description:
--   Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMeasureENU(!option is STRING, !gadget is STRING)

  -- Initialise Variables

  -- Measure (point to point)
  if(!option eq 'MEASURE') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('distance')
    !packet.action = '!!edgSettings.measureENU(''' & !gadget & ''', !this.return[1])'
    !!edgCntrl.add(!packet)

    -- Measure parallel
  elseif (!option eq 'SHORTEST') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('shortest')
    !packet.action = '!!edgSettings.measureENU(''' & !gadget & ''', !this.return[1])'
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .setMeasureENU(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .measureENU()
--
-- Description: called by EDG when measure finished
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      LINE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .measureENU(!gadget is STRING, !line is LINE)

  -- Initialise Variables
  !position = !this.positionENU.position()

  -- Unset line, is zero
  if(!line.unset()) then
    !value = 0
  else
    !value = !line.length()
  endif

  -- Define new position
  !position.$!<gadget> = !value
  !this.positionENU.position(!position)

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .measure(STRING, LINE)

------------------------------------------------------------------------
--
-- Method:      .offsetPlane()
--
-- Description: constructor for Offset Plane frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .offsetPlane()
  -- XYZ Offset
  var !coordinate coordinate
  if(!coordinate eq 'ENU')then
   !plane = before('$!coordinate','U')
  else
   !plane = before('$!coordinate','Z')
  endif
  !this.positionPlane.linkInput('!!edgSettings.positionPlane',!this.xPlane, !this.yPlane)
  !this.positionPlane.linkOption('!!edgSettings.positionPlane',!this.xOptionPlane, !this.yOptionPlane, !plane)

  -- Distance
  !menu = !this.newMenu('distanceMenuXplane')
  !menu.add('CALLBACK', 'Measure',          '!this.setMeasurePlane(''MEASURE'',''x'')')
  !menu.add('CALLBACK', 'Measure Shortest', '!this.setMeasurePlane(''SHORTEST'',''x'')')
  !this.xPlane.setPopup(!menu)

  !menu = !this.newMenu('distanceMenuYplane')
  !menu.add('CALLBACK', 'Measure',          '!this.setMeasurePlane(''MEASURE'',''y'')')
  !menu.add('CALLBACK', 'Measure Shortest', '!this.setMeasurePlane(''SHORTEST'',''y'')')
  !this.yPlane.setPopup(!menu)
endmethod
-- End of method definition for .offsetPlane()

------------------------------------------------------------------------
--
-- Method:      .editPlane()
--
-- Description: sets Frame to Plane
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      XYPOSITION
--    2   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .editPlane(!xyPosition is XYPOSITION,  !action is STRING)

  -- Initialise Variables
  !this.positionPlane.xyPosition(!xyPosition)
  !this.action = !action

  -- If action is set, then assign to the callback
  if(!action.set()) then
    !this.positionPlane.setAction(!action)
  endif

endmethod
-- End of method definition for .edit(XYPOSITION,  STRING)

------------------------------------------------------------------------
--
-- Method:      .setMeasurePlane()
--
-- Description: Setup to measure offset
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
