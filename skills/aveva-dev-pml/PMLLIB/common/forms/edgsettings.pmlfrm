------------------------------------------------------------------------
--
-- Method:      .measurePlane()
--
-- Description: called by EDG when measure finished
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      LINE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .measurePlane(!gadget is STRING, !line is LINE)

  -- Initialise Variables
  !xyPosition = !this.positionPlane.xyPosition()

  -- Unset line, is zero
  if(!line.unset()) then
    !value = 0
  else
    !value = !line.length()
  endif

  -- Define new position
  !xyPosition.$!<gadget> = !value
  !this.positionPlane.xyPosition(!xyPosition)

