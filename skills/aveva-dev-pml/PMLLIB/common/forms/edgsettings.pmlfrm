-- End of method definition for .measurePlane(STRING, LINE)

------------------------------------------------------------------------
--
-- Method:      .offsetDD()
--
-- Description: constructor for Offset Distance/Direction frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .offsetDD()
  -- Define right-mouse buttons
  -- Direction
  !menu = !this.newMenu('directionMenuDD')
  !menu.add('CALLBACK', 'Pick',        '!this.setDirection(')
  !menu.add('CALLBACK', 'X Direction', '!this.setDirection(')
  !menu.add('CALLBACK', 'Y Direction', '!this.setDirection(')
  !menu.add('CALLBACK', 'Z Direction', '!this.setDirection(')
  !menu.add('CALLBACK', 'Opposite',    '!this.setDirection(')
  !this.directionDD.setPopup(!menu)

  -- Distance
  !menu = !this.newMenu('distanceMenuDD')
  !menu.add('CALLBACK', 'Measure',          '!this.setMeasureDD(')
  !menu.add('CALLBACK', 'Measure Shortest', '!this.setMeasureDD(')
  !this.distanceDD.setPopup(!menu)

endmethod
-- End of method definition for .offsetDD()
------------------------------------------------------------------------
--
-- Method:      .editDD()
--
-- Description: set to Direction/Distance frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION
--    2   R      REAL
--    3   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .editDD(!direction is DIRECTION, !distance is REAL, !action is STRING)

  -- Initialise Variables
  !this.directionDD.val  = !direction
  !this.distanceDD.val   = !distance
  !this.action           = !action

  -- If action is set, then assign to the callback
  if(!action.set()) then
    !this.distanceDD.callback  = !action
    !this.directionDD.callback = !action
  endif

endmethod
-- End of method definition for .edit(DIRECTION, REAL, STRING)

------------------------------------------------------------------------
--
-- Method:      .setMeasureDD()
--
-- Description: Setup to measure offset
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU
--    2   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMeasureDD(!menu is MENU, !selected is STRING)
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('distance')
    !packet.action = '!!edgSettings.measureDD(!this.return[1])'
    !!edgCntrl.add(!packet)

    -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('shortest')
    !packet.action = '!!edgSettings.measureDD(!this.return[1])'
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .setMeasureDD(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      .setMeasureDD()
--
-- Description: Setup to measure offset
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET
--    2   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMeasureDD(!gadget is GADGET, !selected is STRING)
--    1   R      GADGET      Menu selected from
--    2   R      STRING      Selection state

  -- Initialise Variables
  -- Define the measure packet
  !packet        = object EDGPACKET()
  !packet.defineMeasure('distance')
  !packet.action = '!!edgSettings.measureDD(!this.return[1])'
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .setMeasureDD(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      .measureDD()
--
-- Description: called by EDG when measure finished
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .measureDD(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.distanceDD.val = 0
  else
    !this.distanceDD.val = !line.length()
  endif

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .measureDD(LINE)

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description:
--   Set up direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDirection(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Pick Direction
  if(!option eq 'PICK') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineDirection('')
    !packet.action = '!!edgSettings.direction(!this.return[1])'
    !!edgCntrl.add(!packet)
    return

  -- Opposite  Direction
  elseif (!option eq 'OPPOSITE') then
    !this.directionDD.val = !this.directionDD.val.opposite()

  -- Direction
  else

    -- Check we have an orientation
    !unusedOrientation = !!ce.orientation
    handle any
      return
    endhandle

     -- Extract the direction
    if(!option.match('X').boolean()) then
      !this.directionDD.val = !!ce.orientation.xDir().wrt(World)
    elseif (!option.match('Y').boolean()) then
      !this.directionDD.val = !!ce.orientation.yDir().wrt(World)
    else
      !this.directionDD.val = !!ce.orientation.zDir().wrt(World)
    endif

  endif

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .setDirection(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description:
--   Set up direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDirection(!gadget is GADGET, !selected is STRING)

  -- Initialise Variables
  -- Define the direction packet
  !packet        = object EDGPACKET()
  !packet.defineDirection('')
  !packet.action = '!!edgSettings.direction(!this.return[1])'
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .setDirection(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description:
--   Set up direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------
define method .direction(!direction is DIRECTION)

  -- Write angle to form
  !this.directionDD.val = !direction

  -- Carry out action
  !this.action()
endmethod
-- End of method definition for .direction(DIRECTION)

------------------------------------------------------------------------
--
-- Method:      .offsetSurface()
--
-- Description: constructor for Offset Surface frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .offsetSurface()
  -- Distance
  !menu = !this.newMenu('distanceMenuSurface')
  !menu.add('CALLBACK', 'Measure',          '!this.setMeasureSurface(')
  !menu.add('CALLBACK', 'Measure Shortest', '!this.setMeasureSurface(')
  !this.distanceSurface.setPopup(!menu)
endmethod
-- End of method definition for .offsetSurface()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: Initialise Form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !this.currentFrame = !!edgPosCntrl.offsetTypes.findFirst(!!edgPosCntrl.offsetType)

  -- Initialise Variables
  !this.snap.val = !!edgPosCntrl.intermediate

  do !i indices !this.frames
    skip if (!i eq !this.currentFrame)
    !frameName = !this.frames[!i]
    !this.attribute(!frameName).visible = false
  enddo

  !this.attribute(!this.frames[!this.currentFrame]).visible = true

  var !coordinate coordinate
  !this.positionENU.linkInput('!!edgSettings.positionENU', !this.xENU, !this.yENU, !this.zENU)
  !this.positionENU.linkOption('!!edgSettings.positionENU', !this.xOptionENU, !this.yOptionENU, !this.zOptionENU, !coordinate)

  if(!coordinate eq 'ENU')then
   !plane = before('$!coordinate','U')
  else
   !plane = before('$!coordinate','Z')
  endif
  !this.positionPlane.linkInput('!!edgSettings.positionPlane',!this.xPlane, !this.yPlane)
  !this.positionPlane.linkOption('!!edgSettings.positionPlane',!this.xOptionPlane, !this.yOptionPlane, !plane)
  if (!coordinate eq 'ENU')then
   	!this.offsetENU.tag = 'E/N/U'
   	!this.enu.tag = 'East/North/Up'
  else
    !this.offsetENU.tag = 'X/Y/Z'
    !this.enu.tag = 'X/Y/Z'
  endif

endmethod
--End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      .editSurface()
--
-- Description: set form to Surface frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL
--    2   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .editSurface(!distance is REAL, !action is STRING)

  -- Initialise Variables
  !this.distanceSurface.val   = !distance
  !this.action                = !action

  -- If action is set, then assign to the callback
  if(!action.set()) then
    !this.distanceSurface.callback  = !action
  endif

endmethod
-- End of method definition for .editSurface(REAL, STRING)

------------------------------------------------------------------------
--
-- Method:      .setMeasureSurface()
--
-- Description: Setup to measure Surface offset
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMeasureSurface(!menu is MENU, !dummySelected is STRING)
  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('distance')
    !packet.action = '!!edgSettings.measureSurface(!this.return[1])'
    !!edgCntrl.add(!packet)

    -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('shortest')
    !packet.action = '!!edgSettings.measureSurface(!this.return[1])'
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .setMeasureSurface(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      .measureSurface()
--
-- Description: called by EDG when measure finished
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .measureSurface(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.distanceSurface.val = 0
  else
    !this.distanceSurface.val = !line.length()
  endif

  -- Carry out action
  !this.action()

endmethod
-- End of method definition for .measureSurface(LINE)

------------------------------------------------------------------------
--
-- Method:      .action()
--
-- Description: Carry out action
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .action()

  -- Action
  $!<this.action>
  handle any
  endhandle

endmethod
-- End of method definition for .action()

------------------------------------------------------------------------
--
-- Method:      .openSettings()
--
-- Description: opens the settings form on the correct tab
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .openSettings(!type is STRING)
  loadform !!edgpicksettings
  !!edgpicksettings.showForm(!type)
endmethod
-- End of method definition for .openSettings(STRING)

------------------------------------------------------------------------
--
-- Method:      snap
--
-- Description: Set significant snap mode on picking
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .snap()

  -- Initialise Variables
  -- Set recursion flag for constructors
  !!edgPosCntrl.intermediate = !this.snap.val

  -- Update prompt
  !!edgCntrl.state.updatePrompt()

endmethod
-- End of method definition for .snap()

------------------------------------------------------------------------
--
-- Method:      .offset()
--
-- Description: sets offset type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .offset()
  -- Set offset Type
  !selection = !this.offset.rtoggle(!this.offset.val).onvalue
  !!edgPosCntrl.offsetType(!selection)

  !this.initialise()

endmethod
-- End of method definition for .offset()
