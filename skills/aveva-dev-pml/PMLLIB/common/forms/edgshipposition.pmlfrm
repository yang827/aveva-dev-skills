--
--  Description:     Ship positioning linked to EDG
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply position
--  edgShipPosition()                -                   Initialises form
--  initialise()                     -                   initialise position control
--
------------------------------------------------------------------------

import 'PositionControl'
handle ANY
endhandle

setup form !!edgShipPosition resize

  -- Body of form definition
  frame .frmPosition panel                           anchor all  at x1   ymax+0.2
    container .netPositionFrame PMLNetCONTROL 'NET'  anchor all  at x0.5 ymax      width 36    height 4
  exit

  -- Apply
  button .apply 'Apply'  anchor B+R at xmax form-size ymax+0.2 apply

  -- PMLNet Position control
  using namespace 'Aveva.Pdms.Presentation'
  member .posControl      is POSITIONCONTROL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      edgShipPosition
--
-- Description: Initialises form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .edgShipPosition()

 !this.formTitle      = 'Ship Position'
 !this.iconTitle      = 'ShipPos'
 !this.callback       = '!this.initialise()'
 !this.apply.callback = '!this.apply()'

endmethod

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: initialise position control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- declare namespace where position control exists
  using namespace 'Aveva.Pdms.Presentation'

  -- create new instance of position control
  !this.posControl      = object POSITIONCONTROL()

  -- Load ship grid data
  !grid                  = object SHIPGRID()

  -- Only populate the grid data if a ship reference grid is available
  if(!grid.xID.set()) then
    do !i indices !grid.xID
      !xGridData[!i][1]     = !grid.xID[!i]
      !xGridData[!i][2]     = !grid.xOffset[!i]
    enddo

    do !i indices !grid.yID
      !yGridData[!i][1]     = !grid.yID[!i]
      !yGridData[!i][2]     = !grid.yOffset[!i]
    enddo

    do !i indices !grid.zID
      !zGridData[!i][1]     = !grid.zID[!i]
      !zGridData[!i][2]     = !grid.zOffset[!i]
    enddo

    -- Set grid data
    !this.posControl.gridData(!xGridData,!yGridData,!zGridData)

    -- Initialize as grid control and Specify tags
    --!this.posControl.gridFormat(!grid.xTag, !grid.yTag, !grid.zTag)

    -- Set position column heading
    !this.posControl.heading('World Position')

  else
    -- Set position column heading
    !this.posControl.heading('')
    !this.posControl.gridVisible(FALSE)
  endif

  var !coordinate coordinate
  if(!grid.xID.set() and (!coordinate.eq('XYZ'))) then
   !this.posControl.gridFormat()
  elseif(!coordinate.eq('XYZ')) then
   !this.posControl.xyzFormat()
  else
   !this.posControl.enuformat()
  endif

  -- Add PMLNet control to PML frame
  !this.netPositionFrame.control  = !this.posControl.handle()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  !posArray  = !this.posControl.xyz()
  !east      = !posArray[0].string()
  !north     = !posArray[1].string()
  !up        = !posArray[2].string()
  !position = object POSITION('E ' + !east + ' N ' + !north + ' U ' + !up + ' wrt /* ')

  -- Pass position to event system
  !!edgCntrl.explicitPosition(!position)

  !this.hide()

endmethod
-- End of method
