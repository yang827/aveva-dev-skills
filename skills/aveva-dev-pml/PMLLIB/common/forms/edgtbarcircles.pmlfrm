--
-- Description:
-- Toolbar for circle creation.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgTBarCircles()                 -                   Constructor
--
------------------------------------------------------------------------

setup form !!edgTBarCircles

  !!edgTBarCircles.formTitle     = 'Circles'
  !!edgTBarCircles.iconTitle     = ''
  !!edgTBarCircles.callback      = ''
  !!edgTBarCircles.formRevision  = ' $Revision: 1.13 $ '

  -- Body of form definition
  hdist 0
  button .cir3Pnt        pixmap width 24 height 24 tooltip 'Through 3 points'                       callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''3pnt''))'
  button .cirCopy        pixmap width 24 height 24 tooltip 'Derive from a picked item'              callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''derive''))'
  button .cirFillet      pixmap width 24 height 24 tooltip 'Fillet'                                 callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''fillet''))'
  button .cirTan3Lines   pixmap width 24 height 24 tooltip 'Tangential to 3 lines'                  callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''tan3lines''))'
  button .cirFRadPntTan  pixmap width 24 height 24 tooltip 'Fixed radius, tangential to a circle'   callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixedradiuspnttan''))'
  button .cirFRad2PntTan pixmap width 24 height 24 tooltip 'Fixed radius, passing through 2 points' callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixedradiuspntpnt''))'
  button .cirPntTan      pixmap width 24 height 24 tooltip 'Tangential to a circle'                 callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''pnttan''))'
  button .cirTanTan      pixmap width 24 height 24 tooltip 'Tangential to 2 circles'                callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''tantan''))'
  button .cirDia3D       pixmap width 24 height 24 tooltip 'Derived diameter'                       callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''diameter3d''))'
  button .cirDia2D       pixmap width 24 height 24 tooltip 'Derived diameter on working plane'      callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''diameter2d''))'
  button .cirFDia3D      pixmap width 24 height 24 tooltip 'Fixed diameter'                         callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixeddiameter3d''))'
  button .cirFDia2D      pixmap width 24 height 24 tooltip 'Fixed diameter on working plane'        callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixeddiameter2d''))'
  button .cirRad3D       pixmap width 24 height 24 tooltip 'Derived radius'                         callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''radius3d''))'
  button .cirRad2D       pixmap width 24 height 24 tooltip 'Derived radius on working plane'         callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''radius2d''))'
  button .cirFRad3D      pixmap width 24 height 24 tooltip 'Fixed radius'                           callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixedradius3d''))'
  button .cirFRad2D      pixmap width 24 height 24 tooltip 'Fixed radius on working plane'          callback '!!edgCntrl.add(!!aidConstructors.circlePacket(''fixedradius2d''))'
  button .cirExplicit    pixmap width 24 height 24 tooltip 'Define explicitly'                      callback '!!aidConstructors.explicit(''CIRCLE'')'

exit
-- End of form definition for !!edgTBarCircles

------------------------------------------------------------------------
--
-- Method:      edgTBarCircles
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgTBarCircles()

  !!edgTBarCircles.cir3Pnt.addPixmap(!!pml.getPathName('circle3pnt24.png'))
  !!edgTBarCircles.cirCopy.addPixmap(!!pml.getPathName('circlecopy24.png'))
  !!edgTBarCircles.cirFillet.addPixmap(!!pml.getPathName('circlefillet24.png'))
  !!edgTBarCircles.cirTan3Lines.addPixmap(!!pml.getPathName('circletan3lines24.png'))
  !!edgTBarCircles.cirFRadPntTan.addPixmap(!!pml.getPathName('circlefixradpnttan24.png'))
  !!edgTBarCircles.cirFRad2PntTan.addPixmap(!!pml.getPathName('circlefrad2pnttan24.png'))
  !!edgTBarCircles.cirPntTan.addPixmap(!!pml.getPathName('circlepnttan24.png'))
  !!edgTBarCircles.cirTanTan.addPixmap(!!pml.getPathName('circletantan24.png'))
  !!edgTBarCircles.cirDia3D.addPixmap(!!pml.getPathName('circledia3d24.png'))
  !!edgTBarCircles.cirDia2D.addPixmap(!!pml.getPathName('circledia2d24.png'))
  !!edgTBarCircles.cirFDia3D.addPixmap(!!pml.getPathName('circlefixdia3d24.png'))
  !!edgTBarCircles.cirFDia2D.addPixmap(!!pml.getPathName('circlefixdia2d24.png'))
  !!edgTBarCircles.cirRad3D.addPixmap(!!pml.getPathName('circlerad3d24.png'))
  !!edgTBarCircles.cirRad2D.addPixmap(!!pml.getPathName('circlerad2d24.png'))
  !!edgTBarCircles.cirFRad3D.addPixmap(!!pml.getPathName('circlefixrad3d24.png'))
  !!edgTBarCircles.cirFRad2D.addPixmap(!!pml.getPathName('circlefixrad2d24.png'))
  !!edgTBarCircles.cirExplicit.addPixmap(!!pml.getPathName('constructexplicit24.png'))

endmethod
-- End of method definition for .edgTBarCircles()
