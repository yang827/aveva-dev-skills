--
--
-- Description:
-- Toolbar for grid creation.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgTBarGrids()                   -                   Constructor
--
------------------------------------------------------------------------

setup form !!edgTBarGrids

  !!edgTBarGrids.formTitle     = 'Grids'
  !!edgTBarGrids.iconTitle     = ''
  !!edgTBarGrids.callback      = ''
  !!edgTBarGrids.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition

  hdist 0
  button .linear  pixmap width 24 height 24 tooltip 'Create linear grid' callback '!!edgCntrl.add(!!aidConstructors.linearGridPacket(object GPHLINEARGRID()))'
  button .radial  pixmap width 24 height 24 tooltip 'Create radial grid' callback '!!edgCntrl.add(!!aidConstructors.radialGridPacket(object GPHRADIALGRID()))'
  button .plant   pixmap width 24 height 24 tooltip 'Create plant grid'  callback '!!edgCntrl.add(!!aidConstructors.plantGridPacket(object GPHPLANTGRID()))'

exit
-- End of form definition for !!edgTBarGrids

------------------------------------------------------------------------
--
-- Method:      edgTBarGrids
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .edgTBarGrids()

  !!edgTBarGrids.linear.addPixmap(!!pml.getPathName('lineargrid24.png'))
  !!edgTBarGrids.radial.addPixmap(!!pml.getPathName('radialgrid24.png'))
  !!edgTBarGrids.plant.addPixmap(!!pml.getPathName('plantgrid24.png'))

endmethod
-- End of method definition for .edgTBarGrids()
