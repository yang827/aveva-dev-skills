--
-- Description:
-- Toolbar for line creation.
--
------------------------------------------------------------------------

setup form !!edgTBarLines

  !!edgTBarLines.formTitle     = 'Lines'
  !!edgTBarLines.iconTitle     = ''
  !!edgTBarLines.callback      = ''
  !!edgTBarLines.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition
  hdist 0
  button .linePntPnt    pixmap width 24 height 24 tooltip 'Between two points'         callback '!!edgCntrl.add(!!aidConstructors.linePacket(''pntpnt''))'
  button .lineAngle     pixmap width 24 height 24 tooltip 'Angled from copied'         callback '!!edgCntrl.add(!!aidConstructors.linePacket(''angle''))'
  button .lineCopy      pixmap width 24 height 24 tooltip 'Derive from a picked item'  callback '!!edgCntrl.add(!!aidConstructors.linePacket(''derive''))'
  button .lineBisect    pixmap width 24 height 24 tooltip 'Bisect the picked lines'    callback '!!edgCntrl.add(!!aidConstructors.linePacket(''bisect''))'
  button .linePntTan    pixmap width 24 height 24 tooltip 'Point to circle tangent'    callback '!!edgCntrl.add(!!aidConstructors.linePacket(''pnttan''))'
  button .lineTanTan    pixmap width 24 height 24 tooltip 'Tangential to 2 circles'    callback '!!edgCntrl.add(!!aidConstructors.linePacket(''tantan''))'
  button .lineExplicit  pixmap width 24 height 24 tooltip 'Define explicitly'          callback '!!aidConstructors.explicit(''LINE'')'

exit
-- End of form definition for !!edgTBarLines

-- set icons
!!edgTBarLines.linePntPnt.addPixmap(!!pml.getPathName('linepntpnt24.png'))
!!edgTBarLines.lineAngle.addPixmap(!!pml.getPathName('lineangle24.png'))
!!edgTBarLines.lineCopy.addPixmap(!!pml.getPathName('linecopy24.png'))
!!edgTBarLines.lineBisect.addPixmap(!!pml.getPathName('linebisect24.png'))
!!edgTBarLines.linePntTan.addPixmap(!!pml.getPathName('linepnttan24.png'))
!!edgTBarLines.lineTanTan.addPixmap(!!pml.getPathName('linetantan24.png'))
!!edgTBarLines.lineExplicit.addPixmap(!!pml.getPathName('constructexplicit24.png'))
