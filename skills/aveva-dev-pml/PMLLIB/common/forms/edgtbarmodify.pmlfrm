--   Group:         Event Driven Graphics
--     Keyword:     EDG
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Feb 26 17:51:08 WAT 1998
--
--
-- Description:
-- Toolbar for Modifying Aid Constructors
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgTBarModify()                  -                   Constructor
--
------------------------------------------------------------------------

setup form !!edgTBarModify

  !!edgTBarModify.formTitle     = 'Modify'
  !!edgTBarModify.iconTitle     = ''
  !!edgTBarModify.callback      = ''
  !!edgTBarModify.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition
  hdist 0
  button .edgDelete     pixmap width 24 height 24 tooltip 'Delete picked aid item'           callback '!!edgCntrl.add(!!aidConstructors.deletePacket())'
  button .editPos       pixmap width 24 height 24 tooltip 'Reposition picked aid item'       callback '!!edgCntrl.add(!!aidConstructors.modifyPacket(''position''))'
  button .editRad       pixmap width 24 height 24 tooltip 'Redefine radius of picked circle' callback '!!edgCntrl.add(!!aidConstructors.modifyPacket(''radius''))'
  button .editLength    pixmap width 24 height 24 tooltip 'Extend end of picked line'        callback '!!edgCntrl.add(!!aidConstructors.modifyPacket(''length''))'

exit
-- End of form definition for !!edgTBarModify

------------------------------------------------------------------------
--
-- Method:      edgTBarModify
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .edgTBarModify()

  !!edgTBarModify.edgDelete.addPixmap(!!pml.getPathName('delete24.png'))
  !!edgTBarModify.editPos.addPixmap(!!pml.getPathName('editposition24.png'))
  !!edgTBarModify.editRad.addPixmap(!!pml.getPathName('editradius24.png'))
  !!edgTBarModify.editLength.addPixmap(!!pml.getPathName('extend24.png'))

endmethod
-- End of method definition for .edgTBarModify()
