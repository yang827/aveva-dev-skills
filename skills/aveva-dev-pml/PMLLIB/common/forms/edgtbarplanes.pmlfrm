--
--
-- Description:
-- Toolbar for plane creation.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgTBarPlanes()                  -                   Constructor
--
------------------------------------------------------------------------

setup form !!edgTBarPlanes

  !!edgTBarPlanes.formTitle     = 'Planes'
  !!edgTBarPlanes.iconTitle     = ''
  !!edgTBarPlanes.callback      = ''
  !!edgTBarPlanes.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition
  hdist 0
  button .plane3Pnt     pixmap width 24 height 24 tooltip 'Through 3 points'  callback '!!edgCntrl.add(!!aidConstructors.planePacket(''3pnts''))'
  button .planeExplicit pixmap width 24 height 24 tooltip 'Define explicitly' callback '!!aidConstructors.explicit(''PLANE'')'
--  button .planeCopy     pixmap width 24 height 24 callback '!!edgCntrl.add(!!aidConstructors.planePacket(''copy''))'

exit
-- End of form definition for !!edgTBarPlanes

------------------------------------------------------------------------
--
-- Method:      edgTBarPlanes
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .edgTBarPlanes()

  !!edgTBarPlanes.plane3Pnt.addPixmap(!!pml.getPathName('plane3pnt24.png'))
  !!edgTBarPlanes.planeExplicit.addPixmap(!!pml.getPathName('constructexplicit24.png'))

endmethod
-- End of method definition for .edgTBarPlanes()
