--
--
-- Description:
-- Toolbar for points creation.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  edgTBarPoints()                  -                   Constructor
--
------------------------------------------------------------------------

setup form !!edgTBarPoints

  !!edgTBarPoints.formTitle     = 'Points'
  !!edgTBarPoints.iconTitle     = ''
  !!edgTBarPoints.callback      = ''
  !!edgTBarPoints.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition
  hdist 0
  button .point     pixmap width 24 height 24 tooltip 'Derive position'   callback '!!edgCntrl.add(!!aidConstructors.pointPacket(''pnt''))'
  button .explicit  pixmap width 24 height 24 tooltip 'Define explicitly' callback '!!aidConstructors.explicit(''POINT'')'

exit
-- End of form definition for !!edgTBarPoints

------------------------------------------------------------------------
--
-- Method:      edgTBarPoints
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .edgTBarPoints()

  !!edgTBarPoints.point.addPixmap(!!pml.getPathName('pnt24.png'))
  !!edgTBarPoints.explicit.addPixmap(!!pml.getPathName('constructexplicit24.png'))

endmethod
-- End of method definition for .edgTBarPoints()
