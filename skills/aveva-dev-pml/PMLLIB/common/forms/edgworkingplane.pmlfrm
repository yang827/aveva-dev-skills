--
--
-- Description:
-- Working Plane.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  define(STRING)                   -                   Define an active plane
--  edgWorkingPlane()                -                   Constructor
--  grid()                           -                   Set active plane grid settings
--  initialise()                     -                   Initialise Form
--  position(POSITION)               -                   Repositioning active plane
--  setPlane(EDGPICKDATA)            -                   Set active plane
--
------------------------------------------------------------------------

setup form !!edgWorkingPlane

  !!edgWorkingPlane.formTitle     = 'Working Plane'
  !!edgWorkingPlane.iconTitle     = ''
  !!edgWorkingPlane.callback      = '!this.initialise()'
  !!edgWorkingPlane.formRevision  = ' $Revision: 1.12 $ '

  -- Body of form definition
  bar
  exit

  -- Working plane settings
  frame .planeFrame 'Settings'

    -- Plane Settings
    path down
    toggle .activeState ' Active'  at x2 ymax callback '!!edgPosCntrl.activePlane(!this.activeState.val)' states 'false' 'true'
    toggle .visible ' Visible'            callback '!!edgPosCntrl.visiblePlane(!this.visible.val)' states 'false' 'true'

    -- Working Plane is a grid
    rgroup .grid 'Working Grid snap' at x0.5 ymax+0.2 callback '!this.grid()' frame vertical
      add tag ' On'     select 'ON'
      add tag ' Off'    select 'OFF'
      add tag ' Centre' select 'CENTRE'
    exit
  exit

exit
-- End of form definition for !!edgWorkingPlane

------------------------------------------------------------------------
--
-- Method:      edgWorkingPlane
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edgWorkingPlane()

  -- Define Bar Menu
  !bar  = !this.bar
    !bar.add('Control', 'controlMenu')
    !bar.add('Define',  'defineMenu')

  -- Control Menu
  !menu = !this.newMenu('controlMenu')
    !menu.add('CALLBACK', 'Close',   '!this.hide()')

  -- Define Plane Menu
  !menu = !this.newMenu('defineMenu')
    !menu.add('CALLBACK','Pick',            '!this.define(''PICK'')')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Reposition',     '!this.define(''POSITION'')')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Plane...',       '!this.define(''PLANE'')')
    !menu.add('CALLBACK', 'Linear Grid...', '!this.define(''LINEAR'')')
    !menu.add('CALLBACK', 'Radial Grid...', '!this.define(''RADIAL'')')
    !menu.add('CALLBACK', 'Plant Grid...',  '!this.define(''PLANT'')')

  -- Check the aid constructs form is built
  if(undefined(!!aidConstructs)) then
    pml reload form !!aidConstructs
  endif

  -- Register method in edgPosCntrl object for working plane
  !!edgPosCntrl.wpMethod('!!edgWorkingPlane.initialise()')

endmethod
-- End of method definition for .edgWorkingPlane()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.activeState.val  = !!edgPosCntrl.activePlane
  !this.visible.val = !!edgPosCntrl.visiblePlane
  !menu = !this.defineMenu

  -- Set active state of active button
  if(!!edgPosCntrl.workPlane.set()) then
    !menu.setActive('Reposition', true)
    !this.activeState.active  = true
  else
    !menu.setActive('Reposition', false)
    !this.activeState.active  = false
  endif

  -- Set active state of visible button
  if(!!edgPosCntrl.activePlane) then
    !this.visible.active = true
    if(!!edgPosCntrl.gridType.upcase() ne 'NONE') then
      !this.grid.active    = true
    else
      !this.grid.active    = false
    endif
  else
    !this.visible.active = false
    !this.grid.active    = false
  endif

  -- Set grid settings
  if(!!edgPosCntrl.activeGrid) then
    !this.grid.select('ON')
  elseif (!!edgPosCntrl.activeGridC) then
    !this.grid.select('CENTRE')
  else
    !this.grid.select('OFF')
  endif

  -- Don't like this, but its the only way I can update the
  -- menu entry
  !menu = !!aidConstructs.modifyMenu
  !menu.setActive('Project onto Plane', !!edgPosCntrl.activePlane)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      grid
--
-- Description: Set active plane grid settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .grid()

  -- Initialise Variables
  if(!this.grid.selection() eq 'OFF') then
    !!edgPosCntrl.activeGrid  = false
    !!edgPosCntrl.activeGridC = false

  elseif (!this.grid.selection() eq 'ON') then
    !!edgPosCntrl.activeGrid  = true
    !!edgPosCntrl.activeGridC = false

  elseif (!this.grid.selection() eq 'CENTRE') then
    !!edgPosCntrl.activeGrid  = false
    !!edgPosCntrl.activeGridC = true

  endif

endmethod
-- End of method definition for .grid()

------------------------------------------------------------------------
--
-- Method:      define
--
-- Description: Define an active plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Plane Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .define(!option is STRING)

   -- Initialise Variables
  !packet                = object EDGPACKET()

  -- Display Relevant 2D Plane Form
  -- Flat plane
  if(!option.upcase() eq 'PLANE') then

    -- If !!gphPlaneEdit is not defined, then build it
    if(undefined(!!gphPlaneEdit)) then
      pml reload form !!gphPlaneEdit
    endif

    -- Show definePlane
    !!gphPlaneEdit.setup('Working Plane', '!!edgPosCntrl.activePlane(!!gphPlaneEdit.plane)', !!edgPosCntrl.referencePlane)

    -- Define EDG positional pick
    !packet.positionLink('!!gphPlaneEdit.position', 'Define Plane')
    !packet.form           = !!gphPlaneEdit
    !packet.close          = '!!gphPlaneEdit.tidy()'
    !packet.description    = 'Working Plane'

  -- Linear Grid
  elseif (!option.upcase() eq 'LINEAR') then

    -- If !!linearGrids is not defined, then build it
    if(undefined(!!linearGrids)) then
      pml reload form !!linearGrids
    endif

    -- Show Linear Grid
    !!linearGrids.setup('Working Plane - Linear Grid', '!!edgPosCntrl.activePlane(!!linearGrids.grid)', !!edgPosCntrl.linearGrid)

    -- Define EDG positional pick
    !packet.positionLink('!!linearGrids.position', 'Define Linear Grid')
    !packet.form           = !!linearGrids
    !packet.close          = '!!linearGrids.tidy()'
    !packet.description    = 'Working Plane - Linear Grid'

  -- Radial Grid
  elseif (!option.upcase() eq 'RADIAL') then

    -- If !!radialGrids is not defined, then build it
    if(undefined(!!radialGrids)) then
      pml reload form !!radialGrids
    endif

    -- Show Radial Grid
    !!radialGrids.setup('Working Plane - Radial Grid', '!!edgPosCntrl.activePlane(!!radialGrids.grid)', !!edgPosCntrl.radialGrid)

    -- Define EDG positional pick
    !packet.positionLink('!!radialGrids.position', 'Define Radial Grid')
    !packet.form           = !!radialGrids
    !packet.close          = '!!radialGrids.tidy()'
    !packet.description    = 'Working Plane - Radial Grid'

  -- Plant Grid
  elseif (!option.upcase() eq 'PLANT') then

    -- If !!plantGrids is not defined, then build it
    if(undefined(!!plantGrids)) then
      pml reload form !!plantGrids
    endif

    -- Show Plant Grid
    !!plantGrids.setup('Working Plane - Plant Grid', '!!edgPosCntrl.activePlane(!!plantGrids.grid)', !!edgPosCntrl.plantGrid)

    -- Define EDG positional pick
    !packet.positionLink('!!plantGrids.position', 'Define Plant Grid')
    !packet.form           = !!plantGrids
    !packet.close          = '!!plantGrids.tidy()'
    !packet.description    = 'Working Plane - Plant Grid'

  -- Pick Plane Packet
  elseif (!option.upcase() eq 'PICK') then

    -- Set Data
    !packet.description    = 'Make picked plane/grid current active plane'
    !packet.action         = '!!edgWorkingPlane.setPlane(!this.return[1])'
    !packet.remove         = true
    !packet.pickPacket.stdAny('Pick plane/grid to be made "Active"')
    !packet.pickPacket.picks[1].prompt         = STRING()
    !packet.pickPacket.picks[1].pick.cursor    = 'DOUBLECROSS'
    !packet.pickPacket.picks[1].pick.stdGraphics()
    !packet.pickPacket.picks[1].pick.input[1]  = 'PKEY eq ''rubbish'''
    !packet.pickPacket.picks[1].pick.input[2]  = 'NUMB eq -99'
    !packet.pickPacket.picks[1].pick.input[6]  = 'FACET EDGE'
    !packet.pickPacket.picks[1].pick.input[10] = /*
    !packet.pickPacket.picks[1].pick.input[11] = 'PKOWNER'

  -- Reposition Plane Packet
  elseif (!option.upcase() eq 'POSITION') then

    -- Define Packet
    !packet = object EDGPACKET()
    !packet.definePosition('Re-Position working plane')
    !packet.action         = '!!edgWorkingPlane.position(!this.return[1].position)'
    !packet.remove         = true
    !packet.description    = 'Reposition working plane'

  endif

  -- Set Common Data
  !packet.key            = 'planePacket'
  !packet.priority       = 2
  !packet.type           = 'edgPlane'

  -- Add Packet to edg system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .define(STRING)

------------------------------------------------------------------------
--
-- Method:      setPlane
--
-- Description: Set active plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      EDGPICKDATA  Picked Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPlane(!pickData is EDGPICKDATA)

  -- Initialise Variables

  -- Special Case Picks (ie items that can be used as a plane in their
  -- own right)
  if(!pickData.type eq 'DESIGNAID') then
    if(!!aidNumbers.numbers[!pickData.point].objectType() inset('GPHPLANE','GPHLINEARGRID','GPHPLANTGRID','GPHRADIALGRID')) then
      !!edgPosCntrl.activePlane(!!aidNumbers.numbers[!pickData.point])
    else
      !!alert.error('Unable to derive plane from picked element.')
    endif

  -- Use "plane" picked
  else

    -- If there are no facets, then we can't derive a plane
    if(!pickData.facetCount gt 0) then

      -- Derived plane from picked plane
      !plane    = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[3])
      -- Try 4th facet
      handle any
        !plane  = !pickData.facets[1].plane(!pickData.facets[2], !pickData.facets[4])
      endhandle

      !plane.position = !plane.intersection(!pickData.pickLine)

      -- Define Graphic Plane (use current reference plane so we get all settings of it, e.g. tagged, etc)
      !gphPlane       = !!edgPosCntrl.referencePlane
      !gphPlane.plane = !plane

      -- Make plane active
      !!edgPosCntrl.activePlane(!gphPlane)

    --
    else
       !!alert.error('Unable to derive plane from picked element.')
    endif
  endif

endmethod
-- End of method definition for .setPlane(EDGPICKDATA)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Repositioning active plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New Position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!position is POSITION)

  -- Initialise Variables
  !!edgPosCntrl.rePosition(!position)

endmethod
-- End of method definition for .position(POSITION)
