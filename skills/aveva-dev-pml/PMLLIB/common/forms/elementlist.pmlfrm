--
--
-- Description:
-- General form used to display element names with message, when the
-- element is selected, then it will navigate to the item.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!elementList

-- Define form
setup form !!elementList

  !!elementList.formTitle     = 'Element List'
  !!elementList.iconTitle     = ''
  !!elementList.callback      = 'call !!elementListInit()'
  !!elementList.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition

  list .list |Elements| call |call !!elementList()| width 50 length 10

  -- Detail text
  frame .detailFrame |Details| at xmin ymax+0.25

    para .detail width 51 lines 3

  exit

  -- Dismiss
  button .dismiss |Dismiss| at xmax form-size ymax +0.2 cancel

  -- Detail Descriptions (this must be an array of DBrefText elements.
  member .details is ARRAY

exit
-- End of form definition for !!elementList
