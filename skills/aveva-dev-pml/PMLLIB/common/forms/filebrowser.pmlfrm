--
-- Description:
-- Form definition for File Browser form.
--
------------------------------------------------------------------------

-- Define form
setup form !!fileBrowser at xr 0 yr 0 blocking

  !!fileBrowser.formTitle     = 'File Browser'
  !!fileBrowser.iconTitle     = 'FILES'
  !!fileBrowser.callback      = ''
  !!fileBrowser.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition

  -- Frame for directory subdirectories
  para .mode at x0 y0 width 45 line 1

  frame .directoryFrame at x 0.1 ymax+0.2 |Directory|

    text .path   at xmin+1 ymin+1   |Path |           callback |call !!fileBrowserDir(_path.val)|                  width 34 string
    list .subDir at xmin   ymax+0.2 |Sub-directories| callback |call !!fileBrowserDir(_subDir.selection('RTEXT'))| width 45 length 8

  exit

  -- Frame for directory file contents
  frame .fileFrame at x 0.1 ymax.directoryFrame+0.5 |Files|

    text .filter   at xmin+1 ymin+1   |Filter | callback |call !!fileBrowserFile(!!fileBrowser.directory)| width 34 string
    list .fileList at xmin   ymax+0.2           callback |call !!fileBrowserSel(_fileList)|                width 45 length 12

  exit

  -- Selected file
  text .selectedFile at xmin.filter ymax+0.5 |Selection | callback |call !!fileBrowserSel(_selectedFile)| width 34 string

  -- Buttons
  button .ok     |  OK  | at x 0            ymax+0.5 ok
  button .cancel |Cancel| at xmax form-size ymin     cancel

  -- Members
    -- Directory for which contents are displayed
    member .directory is STRING
    member .file      is FILE
    member .existFlag is BOOLEAN

exit
-- End of form definition for !!fileBrowser
