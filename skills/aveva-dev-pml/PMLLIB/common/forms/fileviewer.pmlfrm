--
-- Description:
-- Form definition to view the contents of a text file.
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!fileViewer

-- Define form
setup form !!fileViewer

  !!fileViewer.formTitle     = 'File Viewer'
  !!fileViewer.iconTitle     = 'FVIEW'
  !!fileViewer.callback      = ''
  !!fileViewer.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  textpane .contents at x 0 ymax |Contents| width 80 height 20
  _contents.setEditable(false)

  frame .searchFrame at xmin ymax-0.5 |Search|

    text .search at xmin+1 ymin+1 |Search for string| width 40 STRING
    button .next at xmax+2 ymin |Forwards| call |call !!fileViewerSearch(true)|
    button .last at xmax+1 ymin |Backwards| call |call !!fileViewerSearch(false)|

  exit

  paragraph .lineCount at xmin ymax+0.5 width 50 line 1

  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

  -- Member definitions
    -- Previous search string
    member .prevString is STRING

exit
-- End of form definition for !!fileViewer
