--
-- Description:     Set Offset form for graphical manipulation
--
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Most of the gadgets on this form are controlled by core code
-- Do not change their identifiers (e.g. .cancel, .ok) or remove the CORE
-- keyword as this will stop the form from working!
------------------------------------------------------------------------
setup form !!gfxsetENUoffset blocking core
  title 'Set Offset'

  text .xMove core 'X ' width 26 is REAL format !!distancefmt

  path down
  text .yMove core 'Y ' width 26 is REAL format !!distancefmt
  text .zMove core 'Z ' width 26 is REAL format !!distancefmt

  button .preview at xmin.zMove ymax.zMove + 0.5 core 'Preview '
  path right
  button .ok      core '   OK   ' ok
  button .cancel  core ' Cancel ' cancel
exit
