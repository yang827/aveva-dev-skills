--
--
-- Description:     Set Position form for graphical manipulation
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  gfxSetXYZPosition()              -                   Constructor method
--
------------------------------------------------------------------------
-- Most of the gadgets on this form are controlled by core code
-- Do not change their identifiers (e.g. .cancel, .ok) or remove the CORE
-- keyword as this will stop the form from working!
------------------------------------------------------------------------
setup form !!gfxSetXYZPosition blocking core
  title 'Set Position'

  option .ewCyc core width 5
  text .ewPos   core width 18 is REAL format !!distancefmt

  path down
  option .nsCyc core at xmin.ewCyc width 5
  path right
  text .nsPos   core width 18 is REAL format !!distancefmt

  path down
  option .udCyc core at xmin.ewCyc width 5
  path right
  text .udPos   core width 18 is REAL format !!distancefmt

  button .preview at xmin.ewCyc ymax.udCyc + 0.5 core 'Preview '
  path right
  button .ok      core '   OK   ' ok
  button .cancel  core ' Cancel ' cancel
exit

------------------------------------------------------------------------
--
-- Method:      .gfxSetXYZPosition()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .gfxSetXYZPosition()
  !dtext[1] = 'X'
  !dtext[2] = '-X'
  !rtext[1] = 'ECYCLE'
  !rtext[2] = 'WCYCLE'
  !this.ewCyc.dtext = !dtext
  !this.ewCyc.rtext = !rtext

  !dtext[1] = 'Y'
  !dtext[2] = '-Y'
  !rtext[1] = 'NCYCLE'
  !rtext[2] = 'SCYCLE'
  !this.nsCyc.dtext = !dtext
  !this.nsCyc.rtext = !rtext

  !dtext[1] = 'Z'
  !dtext[2] = '-Z'
  !rtext[1] = 'UCYCLE'
  !rtext[2] = 'DCYCLE'
  !this.udCyc.dtext = !dtext
  !this.udCyc.rtext = !rtext
endmethod
-- End of method definition for .gfxSetXYZPosition()
