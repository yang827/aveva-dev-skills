--
-- Description:     Constrained Move form for graphical manipulation
--
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Most of the gadgets on this form are controlled by core code
-- Do not change their identifiers (e.g. .cancel, .ok) or remove the CORE
-- keyword as this will stop the form from working!
------------------------------------------------------------------------
setup form !!gfxsetconstrainedmove blocking core
  title 'Constrained Move'

  text .offset core 'Offset ' width 21 is REAL format !!distancefmt

  button .preview at xmin.offset ymax.offset + 0.5 core 'Preview '
  path right
  button .ok      core '   OK   ' ok
  button .cancel  core ' Cancel ' cancel
exit
