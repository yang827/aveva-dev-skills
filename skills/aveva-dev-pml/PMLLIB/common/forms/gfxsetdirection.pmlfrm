------------------------------------------------------------------------
-- Most of the gadgets on this form are controlled by core code
-- Do not change their identifiers (e.g. .cancel, .ok) or remove the CORE
-- keyword as this will stop the form from working!
------------------------------------------------------------------------
setup form !!gfxsetdirection blocking core
  title 'Enter Direction for Axis'

  -- gadget is type STRING as if it's of type direction then WRT /* gets added on to the
  -- value automatically. This causes problems when trying to parse the input
  text .direction core 'Direction ' width 20 is STRING

  button .preview at xmin.direction ymax.direction + 0.5 core 'Preview '
  path right
  button .ok      core '   OK   ' ok
  button .cancel  core ' Cancel ' cancel
exit
