--
-- Description:     Set distance offset form for graphical manipulation
-- with no preview
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Most of the gadgets on this form are controlled by core code
-- Do not change their identifiers (e.g. .cancel, .ok) or remove the CORE
-- keyword as this will stop the form from working!
------------------------------------------------------------------------
setup form !!gfxsetdistancenoprev blocking core
  title 'Set Distance                  '

  text .distance    core 'Enter value    ' width 11 is REAL format !!distancefmt

  button .ok at xmin.distance ymax.distance + 0.5 core '   OK   ' ok
  button .cancel at xmax.distance ymax.distance + 0.5   core ' Cancel ' cancel
exit
