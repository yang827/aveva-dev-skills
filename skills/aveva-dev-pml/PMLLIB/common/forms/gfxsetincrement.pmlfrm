--
-- Description:     Set Increments form for graphical manipulation
--
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Most of the gadgets on this form are controlled by core code
-- Do not change their identifiers (e.g. .cancel, .ok) or remove the CORE
-- keyword as this will stop the form from working!
------------------------------------------------------------------------
setup form !!gfxsetincrement blocking core
  title 'Set Increments'

  text .linIncrement     core 'Linear increment     ' width 12 is REAL format !!distancefmt

  path down
  text .fineLinIncrement core 'Fine linear increment' width 12 is REAL format !!distancefmt
  text .angIncrement     core 'Angular increment    ' width 12 is REAL format !!anglefmt
  path right

  button .ok core at xmax form-10-size ymax + 0.5 '   OK   ' ok
  button .cancel core ' Cancel ' cancel
exit
