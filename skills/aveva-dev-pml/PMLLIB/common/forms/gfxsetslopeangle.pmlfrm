--
-- Description:     Set Slope Angle form for graphical manipulation
--
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Most of the gadgets on this form are controlled by core code
-- Do not change their identifiers (e.g. .cancel, .ok) or remove the CORE
-- keyword as this will stop the form from working!
------------------------------------------------------------------------
setup form !!gfxsetslopeangle blocking core
  title 'Set Slope Angle'

  text .slopeAngle core 'Sloping Angle ' width 12 is REAL format !!anglefmt

  button .ok core at xmin.slopeAngle ymax.slopeAngle + 0.5  '   OK   ' ok
  path right
  button .cancel  core ' Cancel ' cancel
exit
