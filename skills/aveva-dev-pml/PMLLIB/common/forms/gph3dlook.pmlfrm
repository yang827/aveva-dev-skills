--
-- File:            gph3dlook.pmlfrm
--   Type:          Form Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Apr 9 09:51:13 WAT 1998
--
--
-- Description:
-- Set look direction for a 3D Graphical View.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  direction(DIRECTION)             -                   Setup to direction of offset
--  gph3DLook()                      -                   Constructor
--  initialise()                     -                   Initialise form to current view
--  setDirection(MENU,STRING)        -                   Setup to direction of offset
--  setView(GADGET)                  -                   set rotation position
--
------------------------------------------------------------------------

setup form !!gph3DLook

  !!gph3DLook.formTitle     = ''
  !!gph3DLook.iconTitle     = 'Look'
  !!gph3DLook.callback      = '!this.initialise()'
  !!gph3DLook.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition

  -- View Direction
  text   .direction 'Direction ' width 20 is DIRECTION

  -- Apply/Dismiss buttons
  button .apply   'Apply'   at xmin form-0    ymax form+0.2 callback '!!gphViews.look(!this.view, !this.direction.val)'
  button .dismiss 'Dismiss' at xmax form-size ymin          ok

  -- Form Members

  -- View to be updated
  member .view        is GADGET

exit
-- End of form definition for !!gph3DLook

------------------------------------------------------------------------
--
-- Method:      gph3DLook
--
-- Description:
--  Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gph3DLook()

  -- Define right-mouse buttons
  -- Direction
  !menu = !this.newMenu('directionMenu')
    !menu.add('CALLBACK', 'Pick',        '!this.setDirection(')
    !menu.add('CALLBACK', 'X Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Y Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Z Direction', '!this.setDirection(')
    !menu.add('CALLBACK', 'Opposite',    '!this.direction(_direction.val)')
  !this.direction.setPopup(!this.directionMenu)


endmethod
-- End of method definition for .gph3DLook()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialise form to current view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  -- Get through position
  !directionArray     = !this.view.direction
  !direction          = object DIRECTION('N')
  !direction.east     = !directionArray[1]
  !direction.north    = !directionArray[2]
  !direction.up       = !directionArray[3]

  -- Load Form with direction
  !this.direction.val = !direction

  -- Set title
  !this.formTitle = 'Look - ' & !this.view.owner().formTitle

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setView
--
-- Description:
--   set rotation position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget look direction is to be applied to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setView(!gadget is GADGET)

  -- Set view gadget
  !this.view = !gadget

endmethod
-- End of method definition for .setView(GADGET)

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection(!menu is MENU, !dummySelected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure
  if(!option eq 'PICK') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineDirection('')
    !packet.action = '!!gph3DLook.direction(!this.return[1])'
    !!edgCntrl.add(!packet)


  -- Direction
  else

    -- Check we have an orientation
    !orientation = !!ce.orientation
    handle any
      return
    endhandle

    -- Extract the direction
    if(!option.match('X').boolean()) then
      !this.direction.val = !orientation.xDir().wrt(World)
    elseif (!option.match('Y').boolean()) then
      !this.direction.val = !orientation.yDir().wrt(World)
    else
      !this.direction.val = !orientation.zDir().wrt(World)
    endif

  endif

endmethod
-- End of method definition for .setDirection(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description:
--   Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)

  -- Write angle to form
  !this.direction.val = !direction.opposite()

endmethod
-- End of method definition for .direction(DIRECTION)
