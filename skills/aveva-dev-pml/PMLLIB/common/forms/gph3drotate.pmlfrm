-- Created:         Thu Dec 4 17:14:27 WAT 1997
--
--
-- Description:
-- Specify rotation position.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   close form down
--  gph3DRotate()                    -                   Constructor
--  initialise()                     -
--  setRotation()                    -                   set rotation position
--  setView(GADGET)                  -                   set rotation position
--  tag()                            -                   tag rotation position
--
------------------------------------------------------------------------

-- Define form
setup form !!gph3DRotate

  !!gph3DRotate.formTitle     = ''
  !!gph3DRotate.iconTitle     = 'Rotate'
  !!gph3DRotate.callback      = '!this.initialise()'
  !!gph3DRotate.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition

  -- Positioning Gadgets
  path down
  option .ew width 5
  option .ns width 5
  option .ud width 5
  text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
  text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
  text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
  toggle .xFlag at xmax+1 ymin.ew
  toggle .yFlag at xmin   ymin.ns
  toggle .zFlag at xmin   ymin.ud

  -- Apply/Dismiss buttons
  button .apply   'Apply'   at xmin form-0    ymax form+0.2 callback '!this.setRotation()'
  button .dismiss 'Dismiss' at xmax form-size ymin          callback '!this.close()' ok

  -- Form Members

  -- Position
  member .position    is POSITIONLINK

  -- View to be updated
  member .view        is GADGET

  -- Aid Number
  member .aidNumber   is REAL

exit
-- End of form definition for !!gph3DRotate

------------------------------------------------------------------------
--
-- Method:      gph3DRotate
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .gph3DRotate()

  -- Link Input Gadgets to Objects
  !this.position.linkInput('!!gph3DRotate.position',!this.x, !this.y, !this.z)

  -- Link Lock Gadgets to Objects
  !this.position.linkLock('!!gph3DRotate.position',!this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!gph3DRotate.position',!this.ew, !this.ns, !this.ud, !coordinate)

  -- Set tagging method up
  !this.position.setAction('!!gph3DRotate.tag()')

  -- Get aid number
  !this.aidNumber = !!aidNumbers.add('Rotate Position')

endmethod
-- End of method definition for .gph3DRotate()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- Set with respect to
  !this.position.setWrt(World)

  -- Get through position
  !array = !this.view.through
  !rotatePosition       = object POSITION('N0')
  !rotatePosition.east  = !array[1]
  !rotatePosition.north = !array[2]
  !rotatePosition.up    = !array[3]

  -- Load with position
  !this.position.setPositionForce(!rotatePosition)
  var !coordinate coordinate
  !this.position.linkOption('!!gph3DRotate.position',!this.ew, !this.ns, !this.ud, !coordinate)

  -- Set title
  !this.formTitle = 'Rotate - ' & !this.view.owner().formTitle

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setView
--
-- Description:
--   set rotation position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget rotate is to be applied to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setView(!gadget is GADGET)

  -- Set view gadget
  !this.view = !gadget

endmethod
-- End of method definition for .setView(GADGET)

------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description:
--   tag rotation position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tag()

   -- Get tag position wrt world
  !rotatePosition = !this.position.get().wrt(World)

  -- Tag Text
  AID CLEAR TEXT $!this.aidNumber
  handle any
  endhandle
  AID TEXT NUMBER $!this.aidNumber 'Rotate' AT $!rotatePosition

endmethod
-- End of method definition for .tag()

------------------------------------------------------------------------
--
-- Method:      setRotation
--
-- Description:
--   set rotation position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setRotation()

  -- Get position
  !rotatePosition = !this.position.get()

  -- Set rotation
  !!gphViews.rotate(!this.view, !rotatePosition)

endmethod
-- End of method definition for .setRotation()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Tag Text
  AID CLEAR TEXT $!this.aidNumber
  handle any
  endhandle

  -- Take rotate edg off the stack
  !!edgCntrl.remove(!this.formTitle)

endmethod
-- End of method definition for .close()
