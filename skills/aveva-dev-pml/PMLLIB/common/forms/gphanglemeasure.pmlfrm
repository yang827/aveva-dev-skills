------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close form down
--  gphAngleMeasure()                -                   Constructor
--  initialise()                     -                   Initialisation form
--  preview()                        -                   Preview the plane
--  setMeasure(ARC)                  -                   Set form to passed line (used to define a dimension)
--  setWrt()                         -                   Change wrt
--  setup()                          -                   Setup data for form to be shown for default measure
--  setup(REAL)                      -                   Setup data for form to be shown
--  setupForm()                      -                   Setup form to current grid definition
--  tidy()                           -                   Tidy form data
--
------------------------------------------------------------------------

setup form !!gphAngleMeasure resize

  !!gphAngleMeasure.formTitle     = 'Measure Angle'
  !!gphAngleMeasure.iconTitle     = 'Measure Angle'
  !!gphAngleMeasure.callback      = '!this.initialise()'
  !!gphAngleMeasure.formRevision  = ' $Revision: 1.00 $ '

  -- Body of form definition
  path down
  frame .measureFrame 'Measure' anchor all

    text      .wrt   'wrt '    anchor left + top + right   callback '!this.setWrt()'    tagwidth 4 width 23 is STRING
    textpane  .one   fixchars  anchor all   width 28 height 5

  exit

  -- Dismiss
  button .dismiss 'Close'      anchor bottom + right at xmax form-size ymax+0.25 callback '!this.close()'  width 8 cancel

  -- Form Members
  -- Measurement Object
  member .dimension    is GPHANGLEDIMENSION

  -- Aid number being modified
  member .aidDimension is REAL

  -- Aid number
  member .aidNumber    is REAL

exit
-- End of form definition for !!gphAngleMeasure

------------------------------------------------------------------------
--
-- Method:      gphAngleMeasure
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphAngleMeasure()

  -- Allocate aid number
  !this.aidNumber      = !!aidNumbers.add('AngleMeasure')

  -- Set initialise direction
  !white               = object COLOUR('white')
  !this.one.background = !white.code
  !this.one.setEditable(false)
  !this.wrt.val        = 'World'

endmethod
-- End of method definition for .gphAngleMeasure()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()
  -- Setup form
  !this.setupForm()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:  Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Remove aid numbers
  !this.tidy()

  -- Take rotate edg off the stack
  !!edgCntrl.remove('Define an angular dimension')

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description:  Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid numbers
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown for default measure
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup()

  -- Set form data
  !this.aidDimension  = !this.aidNumber
  !this.dimension     = object GPHANGLEDIMENSION()

endmethod
-- End of method definition for .setup()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number being modified/created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Set form data
  !this.aidDimension  = !aidNumber
  !this.dimension     = !!aidNumbers.numbers[!aidNumber]
  handle any
    !this.dimension   = object GPHANGLEDIMENSION()
  endhandle

endmethod
-- End of method definition for .setup(REAL)

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description: Setup form to current grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupForm()

  -- If plane is unset, then initialise it to default
  if(!this.dimension.unset()) then
    !gphAngleDimension         = object GPHANGLEDIMENSION()
    !gphAngleDimension.tag     = true
    !gphAngleDimension.detail  = true
    !this.dimension       = !gphAngleDimension
  endif

  !dimensionProperties    = ARRAY()
  if( !this.dimension.arc.radius eq 0 ) then
    !dimensionProperties[1] = 'Angle..... '
    !dimensionProperties[2] = 'Direction1 '
    !dimensionProperties[3] = 'Direction2 '
  else
    !angle          = !this.dimension.arc.angle()
    --Directions
    !armDirection    = !this.dimension.arc.angleDirection(!this.dimension.arc.startAngle).wrt(!this.dimension.wrt)
    !firstDirection  = !armDirection.string().before('WRT').trim()
    !armDirection    = !this.dimension.arc.angleDirection(!this.dimension.arc.endAngle).wrt(!this.dimension.wrt)
    !secondDirection = !armDirection.string().before('WRT').trim()
    -- populate dimension property list
    !dimensionProperties[1] = 'Angle.....  ' + !angle.string(!!angleFmt)
    !dimensionProperties[2] = 'Direction1  ' + !firstDirection
    !dimensionProperties[3] = 'Direction2  ' + !secondDirection
  endif

  !this.one.val = !dimensionProperties

  -- Show Plane
  !this.preview()

endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Replace current definition
  !!aidNumbers.replace(!this.aidNumber, !this.dimension)

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description:  Change wrt
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- Assume world as reference
  if(!wrtItem.unset()) then
    !wrtItem = WORLD
  endif

  -- Set tagging method up
  !this.dimension.wrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

  -- Preview
  !this.setupForm()

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description: Set form to passed line (used to define a dimension)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!arc is ARC)

  if( !arc.unset() ) then
    -- there was a problem with the picks
    !!alert.error('An angular dimension could not be constructed from the three points selected')
  else
    -- Write the measurement (line is used as this give the from/to positions) to
    -- the gphAngleDimension object
    !this.dimension.setDimension(!arc)
  endif

  -- Draw the dimension
  !this.setupForm()

endmethod
-- End of method definition for .setMeasure(ARC)
