------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description: Setup event to pick item to tag with axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option : PICK or OWNER
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick(!option is STRING)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  if(!option.upcase() eq 'OWNER') then
    !packet.elementPick('Pick item, whose owner is to be tagged with axes.')
    !packet.action       = '!!gphAxesEdit.setupOwner(!this.return[1])'
  else
    !packet.anyPick('Pick item to be tagged with axes')
    !packet.action       = '!!gphAxesEdit.setup(!this.return[1])'

  endif

  !packet.key            = 'editAxes'
  !packet.description    = !this.edgDescription
  !packet.priority       = 1
  !packet.remove         = true
  !packet.type           = 'tag'

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pick(STRING)
