-- Created:         Fri May 15 17:12:19 WAT 1998
--
--
-- Description:
-- Edit a graphical axes.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close(BOOLEAN)                   -                   Close form down
--  elementAxes(DBREF)               GPHAXES             Returns the axes of the passed element (returns element used via <args> if passed element can not be used to derive an axes)
--  gphAxesEdit()                    -                   Constructor
--  initialise()                     -                   Initialisation for form
--  pick(STRING)                     -                   Setup event to pick item to tag with axes
--  preview()                        -                   Preview the plane
--  setup()                          -                   Default setup
--  setup(DBREF)                     -                   Setup data for form for passed element
--  setup(EDGPICKDATA)               -                   Setup form with data from EDGPICK
--  setup(REAL)                      -                   Setup data for form to be shown
--  setupForm()                      -                   Setup form to current grid definition
--  setupOwner(EDGPICKDATA)          -                   Setup form with data from EDGPICK (makes picked items owner the item)
--
------------------------------------------------------------------------

setup form !!gphAxesEdit

  !!gphAxesEdit.formTitle     = 'Define Axes'
  !!gphAxesEdit.iconTitle     = 'Axes'
  !!gphAxesEdit.callback      = '!this.initialise()'
  !!gphAxesEdit.formRevision  = ' $Revision: 1.10 $ '

  -- Body of form definition
  bar
  exit

  -- Options
  frame .tagFrame 'Tag' at xmin ymax
    -- Tagging
    toggle .label  ' Label '              at x2    ymax callback '!this.preview()' states 'FALSE' 'TRUE'
    toggle .detail ' Cardinal Directions' at xmin  ymax callback '!this.preview()' states 'FALSE' 'TRUE'

  exit

  -- Axes size
  path down
  halign right
  text   .size   ' Size'                                callback '!this.preview()' width 14  is REAL format !!distanceFmt

  -- Form Members

  -- Type of axes (aid element or DB axes)
  member .axesAid        is BOOLEAN

  -- Ppoint
  member .directionAid   is BOOLEAN

  -- Axes definition
  member .axes           is GPHAXES

  -- Direction point
  member .direction      is GPHPOINTVECTOR

  -- Aid number being modified
  member .aidAxes        is REAL

  -- Aid numbers for position & axes
  member .aidNumber      is REAL

  -- Edg Description
  member .edgDescription is STRING

exit
-- End of form definition for !!gphAxesEdit

------------------------------------------------------------------------
--
-- Method:      gphMeasure
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphAxesEdit()

  -- Selection method
  !bar = !this.bar
  !bar.add('Close',  'menuClose')
  !bar.add('Select', 'menuSelect')

  -- Select Menu
  !menu = !this.newMenu('menuClose')
    !menu.add('CALLBACK', 'Retain axes', '!this.close(false)')
    !menu.add('CALLBACK', 'Remove axes', '!this.close(true)')

  -- Select Menu
  !menu = !this.newMenu('menuSelect')
    !menu.add('CALLBACK', 'CE',         '!this.setup(!!ce)')
    !menu.add('CALLBACK', 'Owner',      '!this.setup(!!ce.owner)')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Pick',       '!this.pick(''PICK'')')
    !menu.add('CALLBACK', 'Pick Owner', '!this.pick(''OWNER'')')

  -- Define default axes
  !gphAxes             = object GPHAXES()
  !gphAxes.tag         = false
  !gphAxes.detail      = true
  !gphAxes.position    = object POSITION('N0')
  !gphAxes.orientation = object ORIENTATION('Y is N')

  !this.axes           = !gphAxes
  !this.size.val       = !gphAxes.height

  -- Edg Description
  !this.edgDescription = 'Define Axes'

  -- Cancel callback
  !this.cancelCall     = '!this.close(false)'

endmethod
-- End of method definition for .gphAxesEdit()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Setup form
  !this.setupForm()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Remove aid axes
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close(!hide is BOOLEAN)

  -- Remove aid numbers
  if(!hide) then

    -- Changing aid axes
    if(!this.axesAid) then
      !!aidNumbers.hide(!this.aidNumber)

    -- Changing axes of db element
    else
      !!aidNumbers.remove(!this.aidNumber)
      !this.aidNumber = REAL()
    endif
  endif

  -- Take rotate edg off the stack
  !!edgCntrl.remove(!this.edgDescription)

  -- Close form
  !this.hide()

endmethod
-- End of method definition for .close(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:Default setup
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup()

  -- Allocate aid number
  if(!this.aidNumber.unset()) then
    !this.aidNumber        = !!aidNumbers.add('Axes')

    -- Set form data
    !this.setup(!!ce)

  -- If aidNumber is currently in the aid index system, then we will just
  -- redisplay the axes.
  else

    !axes = !!aidNumbers.get(!this.aidNumber)

    if(!axes.objectType() inset('GPHAXES', 'GPHPOINTVECTOR')) then

      if(!axes.objectType() eq 'GPHAXES') then
        !this.axes         = !axes
        !this.direction    = object GPHPOINTVECTOR()
        !this.axesAid      = true
        !this.directionAid = false
      else
        !this.axes         = object GPHAXES()
        !this.direction    = !axes
        !this.axesAid      = false
        !this.directionAid = true
      endif

      !this.preview()

    else

      -- Allocate new aid number
      !this.aidNumber        = !!aidNumbers.add('Axes')

      -- Set form data
      !this.setup(!!ce)

    endif

  endif

endmethod
-- End of method definition for .setup()


------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form for passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!element is DBREF)

  -- Allocate aid number
  if(!this.aidNumber.unset()) then
    !this.aidNumber      = !!aidNumbers.add('Axes')
  endif

  -- Element axes
  !axes                  = !this.elementAxes(!element)

    if(!axes.position.unset()) then
    !!alert.warning('Unable to derive axes of element "' & !element.flnn & '".')
    return
  endif

  -- Set form data
  !this.axesAid          = false
  !this.directionAid     = false
  !this.aidAxes          = !this.aidNumber
  !this.axes             = !axes

  -- Description
  !this.axes.description = 'Element ' & !element.flnn

  -- Display item
  !this.preview()

endmethod
-- End of method definition for .setup(DBREF)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number being modified/created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Set form data
  !this.axesAid          = true
  !this.directionAid     = false
  !this.aidAxes          = !aidNumber
  !this.axes             = !!aidNumbers.numbers[!aidNumber]
  handle any
    !this.axes           = object GPHAXES(N0, Y is N)
  endhandle

  -- Description
  !this.axes.description = 'Aid axes number [' & !aidNumber & ']'

  -- Display item
  !this.preview()

endmethod
-- End of method definition for .setup(REAL)

------------------------------------------------------------------------
--
-- Method:      setupOwner
--
-- Description: Setup form with data from EDGPICK (makes picked items owner the item)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Event pick data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupOwner(!data is EDGPICKDATA)

  -- Initialise Variables
--  !tempElement = !!comNavToSig(!data.item)
  !tempElement = !data.item
  !data.item = !tempElement.owner

  -- Setup with data
  !this.setup(!data)

endmethod
-- End of method definition for .setupOwner(EDGPICKDATA)

------------------------------------------------------------------------
--
-- Method:      elementAxes
--
-- Description: Returns the axes of the passed element (returns element used via <args> if passed element can not be used to derive an axes)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element
-- Return:
--   [Data Type] [Description]
--    GPHAXES     Graphical axes
--
------------------------------------------------------------------------

define method .elementAxes(!newElement is DBREF) is GPHAXES

  -- Initialise Variables
  !element = !newElement

  -- Get position of item
  do !i from 1 to 10

    -- Derived first
    !position    = !element.drps
    handle any
      -- Position attribute
      !position  = !element.position
      handle any
        !element = !element.owner
        skip
      endhandle
    endhandle
    break if(!position.east.set())
    if(!element.type eq 'WORL') then
      return object GPHAXES()
    endif
    !element = !element.owner
  enddo

  -- Get orientation of item (some instance elements have an position but no ori)
  -- Text element
  !oriElement     = !element
  do !i from 1 to 10
    !orientation  = !oriElement.orientation
    handle ANY
    	 !orientation = object ORIENTATION()
    endhandle
    break if(!orientation.alpha.set())
    if(!oriElement.type eq 'WORL') then
      return object GPHAXES()
    endif
    !oriElement = !oriElement.owner
  enddo

  -- Return
  if(!position.east.set() and !orientation.alpha.set()) then
    !newElement = !element
    return object GPHAXES(!position, !orientation)
  else
    return object GPHAXES()
  endif

endmethod
-- End of method definition for .elementAxes(DBREF) GPHAXES

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form with data from EDGPICK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Event pick data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!passedData is EDGPICKDATA)

  -- Initialise Variables
  !data    = !passedData
--  !element = !!comNavToSig(!data.item)
  !element = !data.item

  -- Type of pick
  -- Element pick
  if(!data.type eq 'ELEMENT') then

    -- Element axes
    !axes                  = !this.elementAxes(!element)
    if(!axes.position.unset()) then
      !!alert.warning('Unable to derive axes of element "' & !element.flnn & '".')
      return
    endif

    -- Set default data
    !position    = !axes.position
    !orientation = !axes.orientation

    -- Description
    !description = 'Element - ' & !element.flnn

    -- Special case elements
    --   Section
    if(!element.hardType eq 'SCTN') then
      !line      = !!edgTypes.sctn.line(!element)
      !position  = !line.intersection(!data.pickLine)

    -- Panel
    elseif (!element.hardType eq 'PANE') then
      !plane     = !!edgTypes.panel.plane(!element)
      !position  = !plane.intersection(!data.pickLine)

    endif

  -- Pline pick
  elseif (!data.type eq 'PLINE') then
    !description = 'Pline ' & !data.pLine & ' of ' & !element.flnn
    !orientation = !element.plOrientation.attribute(!data.pLine)
    !start       = !element.plStart.attribute(!data.pLine)
    !end         = !element.plEnd.attribute(!data.pLine)
    !position    = !data.pickLine.intersection(object LINE(!start, !end))

  -- Point Pick
  elseif (!data.type eq 'PPOINT') then
    !description = 'Ppoint - ' & !data.point & ' of ' & !element.flnn
    !position    = !element.pPosition[!data.point]
    !direction   = !element.pDirection[!data.point]
    handle any
      !!alert.warning('Unable to derive direction as picked point does not have a direction.')
      return
    endhandle

  -- Graphical Point
  elseif (!data.type eq 'DESIGNAID') then


    -- Get core object of design aid
    !designAid  = !!aidNumbers.get(!data.point)
    handle any
      !!alert.warning('Unable to derive axes or direction of picked aid graphics.')
      return
    endhandle

    -- Description
    !description = 'Aid - ' & !designAid.objectType() & ' [' & !data.point & ']'

    -- Does object have orientation of direction attribute
    -- ( a bit of flock of geese code)
    !orientation = !designAid.orientation
    handle any
      !direction = !designAid.direction
      handle any
        -- Core object definition
        !coreObject = !designAid.coreObject()
        handle any
        elsehandle none
          !orientation = !coreObject.orientation()
          handle any
            !orientation = !coreObject.orientation
            handle any
              !direction = !coreObject.direction()
              handle any
                !direction = !coreObject.direction
                handle any
                  !!alert.warning('Unable to derive orientation or direction of picked aid graphics.')
                  return
                endhandle
              endhandle
            endhandle
          endhandle
        endhandle
      endhandle
    endhandle

    -- Core object has been defined (this should make life easier)
    if(defined(!coreObject)) then

      -- Description
      !description = 'Aid - ' & !coreObject.objectType() & ' [' & !data.point & ']'

      -- Line picked
      if(!coreObject.objectType() eq 'LINE') then
        !position  = !coreObject.intersection(!data.pickLine)

      -- Grid based object
      elseif (!coreObject.objectType() inset('LINEARGRID','PLANTGRID','RADIALGRID')) then
        !position  = !coreObject.snap(!data.pickLine)
      endif

    endif

    -- If no position has been defined, then try the long method
    if(undefined(!position)) then
      !position = !designAid.position
      handle any
        !position = !designAid.startPosition
        handle any
          !coreObject = !designAid.coreObject()
          handle any
          elsehandle none
            !position = !coreObject.position()
            handle any
              !position = !coreObject.position
              handle any
                !!alert.warning('Unable to derive position of picked aid graphics.')
                return
              endhandle
            endhandle
          endhandle
        endhandle
      endhandle
    endif
  endif


  -- Define aid axes
  if(defined(!position) and defined(!orientation)) then
    !this.axes                  = object GPHAXES(!position, !orientation)
    !this.axes.description      = !description
    !this.direction             = object GPHPOINTVECTOR()
    !this.axesAid               = false
    !this.directionAid          = false

  -- Define aid direction
  elseif (defined(!position) and defined(!direction)) then
    !this.axes                  = object GPHAXES()
    !this.direction             = object GPHPOINTVECTOR(object POINTVECTOR(!position, !direction))
    !this.direction.description = !description
    !this.axesAid               = false
    !this.directionAid          = true

  -- Unable to derive axes
  else
    !!alert.warning('Unable to derive axes/direction of picked item.')
    return
  endif

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .setup(EDGPICKDATA)

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description: Setup form to current grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupForm()

  -- Set Graphic item data
  if(!this.directionAid) then
    !this.label.val   = !this.direction.tag
    !this.detail.val  = !this.direction.detail
    !this.size.val    = !this.direction.length
  else
    !this.label.val   = !this.axes.tag
    !this.detail.val  = !this.axes.detail
    !this.size.val    = !this.axes.height
  endif

  -- Show Plane
  !this.preview()

endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Set Graphic item data
  if(!this.directionAid) then
    !this.direction.tag     = !this.label.val
    !this.direction.detail  = !this.detail.val
    !this.direction.length  = !this.size.val

    -- Replace current definition
    !!aidNumbers.replace(!this.aidAxes, !this.direction)
  else
    !this.axes.tag          = !this.label.val
    !this.axes.detail       = !this.detail.val
    !this.axes.height       = !this.size.val

    -- Replace current definition
    !!aidNumbers.replace(!this.aidAxes, !this.axes)
  endif

endmethod
-- End of method definition for .preview()

