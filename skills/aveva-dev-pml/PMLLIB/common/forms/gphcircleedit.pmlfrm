-- File:            gphcircleedit.pmlfrm
--   Type:          Form Definition
--   Group:         Aid element handlers
--     Keyword:     AID
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu May 7 15:49:15 WAT 1998
--
--
-- Description:
-- Graphic circle definition
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Action carried out on applying form
--  circleData()                     -                   Set circle data
--  close()                          -                   Close form and tidy
--  gphCircleEdit()                  -                   Constructor
--  initialise()                     -                   Initialisation of Form
--  pickOrientation(STRING)          -                   Setup to define orientation using edg
--  positionType()                   -                   Set positionType
--  preview()                        -                   Preview the plane
--  setOrientation()                 -                   Set orientation data
--  setPosition()                    -                   Set position data
--  setPosition(POSITION)            -                   Set position data
--  setWrt()                         -                   Set up with new wrt item
--  setup(REAL)                      -                   Setup data for form to be shown
--  tidy()                           -                   Tidy form data
--  updateAid(REAL)                  -                   Update/create passed aid number with plane definition
--  updateGadgets()                  -                   Update length and direction gadgets with current settings
--
------------------------------------------------------------------------

setup form !!gphCircleEdit

  !!gphCircleEdit.formTitle     = 'Modify Circle'
  !!gphCircleEdit.iconTitle     = 'Circle'
  !!gphCircleEdit.callback      = '!this.initialise()'
  !!gphCircleEdit.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition

  frame .settingsFrame 'Settings' at xmin ymax width 36

    -- Radius
    text .radius      'Radius ' at x1 ymax callback '!this.circleData()' width 14 is REAL format !!distanceFmt

    -- Angles
    frame .angleFrame 'Angles' at xmin ymax
      text .startAngle 'Start ' at x1 ymax callback '!this.circleData()' width 14 is REAL  format !!angleFmt
      path down
      halign right
      text .endAngle   'End '              callback '!this.circleData()' width 14 is REAL  format !!angleFmt
    exit
  exit

  -- Positioning Gadgets
  frame .posOriFrame 'Position & Orientation' at xmin ymax+0.2 width 36

    -- Positioning Gadgets
    frame .positionFrame 'Position' at x1 ymax width 34

      -- Position being modified
      option .positionType callback '!this.positionType()' width 12

      path down
      halign left
      option .ew width 5
      option .ns width 5
      option .ud width 5
      text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
      text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
      text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
      toggle .xFlag at xmax+1 ymin.ew
      toggle .yFlag at xmin   ymin.ns
      toggle .zFlag at xmin   ymin.ud

      para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'
    exit

    -- Orientation Gadgets and Setting
    frame .orientationFrame 'Orientation' at xmin ymax width 34

      -- EDG Set orientation
      button .edgOri3 pixmap width 24 height 24  callback '!this.pickOrientation(''3picks'')'
      path right
      button .edgOri2 pixmap width 24 height 24  callback '!this.pickOrientation(''2picks'')'

      text .yDir 'Y is ' at x1   ymax+0.25 width 24 is STRING
      text .zDir 'Z is ' at xmin ymax width 24 is STRING
      halign right
      path down
      paragraph .xDir width 31 lines 1
      halign left
    exit

    --  Reference (wrt)
    halign right
    text .wrt 'wrt' callback '!this.setWrt()' width 26 string
  exit

  -- Apply/Dismiss
  button .apply   ' OK '   at xmin form-0    ymax form+0.25 callback '!this.apply()' ok
  button .dismiss 'Cancel' at xmax form-size ymin           callback '!this.close()' cancel

  -- Form Members
  -- Circle definition
  member .circle       is GPHCIRCLE

  -- Aid number being modified
  member .aidCircle    is REAL

  -- Aid numbers for position & axes
  member .aidNumber    is REAL

  -- Form Control Members
  -- Position
  member .position     is POSITIONLINK
  -- Orientation
  member .orientation  is ORIENTATIONLINK

exit
-- End of form definition for !!gphCircleEdit

------------------------------------------------------------------------
--
-- Method:      gphCircleEdit
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphCircleEdit()

  -- Define position types that can be modified
  !dText[1] = 'Origin'
  !rText[1] = 'ORIGIN'
  !dText[2] = 'Radius'
  !rText[2] = 'RADIUS'
  !dText[3] = 'Start Angle'
  !rText[3] = 'START'
  !dText[4] = 'End Angle'
  !rText[4] = 'END'
  !this.positionType.dText = !dText
  !this.positionType.rText = !rText

  -- set icons
  !this.edgOri3.addPixmap(!!pml.getPathName('ori3points24.png'))
  !this.edgOri2.addPixmap(!!pml.getPathName('ori2points24.png'))

   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!gphCircleEdit.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!gphCircleEdit.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!gphCircleEdit.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!gphCircleEdit.setPosition()')

  -- Link Orientation Gadgets to Object
  !this.orientation.linkInput('!!gphCircleEdit.orientation', 'Y', !this.yDir, 'Z', !this.zDir, 'X', !this.xDir)

  -- Set Orientation Action
  !this.orientation.setAction('!!gphCircleEdit.setOrientation()')

  -- Aid Lines Number
  if(!this.aidNumber.unset()) then
    !this.aidNumber = !!aidNumbers.add(!this.circle)
  endif

endmethod
-- End of method definition for .gphCircleEdit()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Link Position Option Gadgets with current coordinate system
  var !coordinate coordinate
  !this.position.linkOption('!!gphCircleEdit.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Unset actions, so we don't run the tag action
  !this.position.setAction('')
  !this.orientation.setAction('')

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- Set with respect to
  !this.setWrt()

  -- Get current definition
  !circle = !this.circle.coreObject()

  -- Unset object definition
  if(!circle.unset()) then
    !circle             = object ARC(N0, Y is N, 0, 180, 1000mm, true)
    !this.circle.tag    = false
    !this.circle.detail = true
    !this.circle.circle = !circle
  endif

  -- Initialise form gadgets
  !this.updateGadgets()

  -- Set default position type
  !this.positionType.select('RTEXT', 'ORIGIN')
  !this.positionType()

  -- Set orientation
  !this.orientation.setOrientation(!circle.orientation)

  -- Redefine Actions
  !this.position.setAction('!!gphCircleEdit.setPosition()')
  !this.orientation.setAction('!!gphCircleEdit.setOrientation()')

  -- Draw circle
  !this.preview()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)
  !this.orientation.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Action carried out on applying form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Update Graphics
  !!aidNumbers.replace(!this.aidCircle, !this.circle)

  -- Close
  !this.close()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Hide Modification Plane
  !this.tidy()

  -- Remove event
  !!edgCntrl.remove('Edit aid circle definition')

endmethod
-- End of method definition for .close()

--------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide Modification Plane
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()
----------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number being modified/created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Set form data
  !this.aidCircle = !aidNumber
  !this.formTitle = 'Modify Circle [' & !aidNumber & ']'
  !this.circle    = !!aidNumbers.numbers[!aidNumber]

endmethod
-- End of method definition for .setup(REAL)
------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Update length and direction gadgets with current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateGadgets()

  -- Set gadget data
  !this.startAngle.val  = !this.circle.circle.startAngle
  !this.endAngle.val    = !this.circle.circle.endAngle
  !this.radius.val      = !this.circle.circle.radius

endmethod
-- End of method definition for .updateGadgets()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition()

  -- Use form position
  !this.setPosition(!this.position.get())

endmethod
-- End of method definition for .setPosition()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    New derived position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition(!position is POSITION)

  -- Modify circle to information for new position
  !type = !this.positionType.selection()

  -- Origin position
  if(!type eq 'ORIGIN') then
    !newPosition                 = !position
    !this.circle.circle.position = !newPosition

  -- Start position
  elseif (!type eq 'START') then
    !circle               = !this.circle.circle.startPosition(!position)
    !this.circle.circle   = !circle
    !newPosition          = !this.circle.circle.anglePosition(!this.circle.circle.startAngle)

  -- End position
  elseif (!type eq 'END') then
    !circle               = !this.circle.circle.endPosition(!position)
    !this.circle.circle   = !circle
    !newPosition          = !this.circle.circle.anglePosition(!this.circle.circle.endAngle)

  -- Radius position (assume zero degrees)
  else

    -- Map position onto arc plane
    !plane                = object PLANE(!this.circle.circle.position, !this.circle.circle.orientation)
    !newPosition          = !plane.near(!position)

    -- Calculate distance from origin to new position
    !radius                    = !this.circle.circle.position.distance(!newPosition)
    !this.circle.circle.radius = !radius
    !newPosition               = !this.circle.circle.anglePosition(0)

  endif

  -- Assign passed position to form
  !this.position.setPositionNoAct(!newPosition)

  -- Update no position gadgets
  !this.updateGadgets()

  -- Show arc
  !this.preview()

endmethod
-- End of method definition for .setPosition(POSITION)

------------------------------------------------------------------------
--
-- Method:      setOrientation
--
-- Description: Set orientation data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setOrientation()

  -- Set circle to orientation object
  !this.circle.circle.orientation = !this.orientation.get()

  -- Set position data to current settings
  !this.positionType()

  -- Preview arc
  !this.preview()

endmethod
-- End of method definition for .setOrientation()

------------------------------------------------------------------------
--
-- Method:      positionType
--
-- Description: Set positionType
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionType()

  -- Get current selection
  !type = !this.positionType.selection()

  -- Origin position
  if(!type eq 'ORIGIN') then
    !this.position.setPositionNoAct(!this.circle.circle.position)

  -- Start position
  elseif (!type eq 'START') then
    !this.position.setPositionNoAct(!this.circle.circle.anglePosition(!this.circle.circle.startAngle))

  -- End position
  elseif (!type eq 'END') then
    !this.position.setPositionNoAct(!this.circle.circle.anglePosition(!this.circle.circle.endAngle))

  -- Radius position (assume zero degrees)
  else
    !this.position.setPositionNoAct(!this.circle.circle.anglePosition(0))
  endif

endmethod
-- End of method definition for .positionType()

------------------------------------------------------------------------
--
-- Method:      circleData
--
-- Description: Set circle data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .circleData()

  -- Set circle data to form settings
  !this.circle.circle.radius     = !this.radius.val
  !this.circle.circle.startAngle = !this.startAngle.val
  !this.circle.circle.endAngle   = !this.endAngle.val

  -- Set position data to current settings
  !this.positionType()

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .circleData()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description:  Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Replace current definition
  !!aidNumbers.replace(!this.aidNumber, !this.circle)

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      pickOrientation
--
-- Description: Setup to define orientation using edg
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Ori definition type  3picks
--                                                2picks
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pickOrientation(!type is STRING)

  -- Define a pickpacket
  !packet          = object EDGPACKET()
  !packet.orientationLink('!!gphCircleEdit.orientation', 'Orientate Circle')

  -- Two pick plane
  if(!type.upcase() eq '2PICKS') then
    -- Define specific for "gphPlaneEdit" orientation
    !packet.pickPacket.plane2Pnts(!this.position.get())
  endif

  !packet.remove   = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickOrientation(STRING)

------------------------------------------------------------------------
--
-- Method:      updateAid
--
-- Description: Update/create passed aid number with plane definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateAid(!aidNumber is REAL)

  -- Update aid system
  !!aidNumbers.replace(!aidNumber, !this.plane)

endmethod
-- End of method definition for .updateAid(REAL)
