--
-- File:            gphclipboxedit.pmlfrm
--   Type:          Form Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Apr 20 10:09:38 WAT 1998
--
--
-- Description:
-- Modify clipbox for a view
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Write new clipbox definition back to form
--  close()                          -                   Close clipbox form down
--  gphClipBoxEdit()                 -
--  initialise()                     -                   Initialise form
--  offset()                         -                   Extend dimensions of clipping box
--  pickOrientation(STRING)          -                   Setup to define orientation using edg
--  setWrt()                         -                   Set up with new wrt item
--  setup(GPHCLIPBOX)                -                   Initialise form
--  tag()                            -                   Tag clipbox
--
------------------------------------------------------------------------

setup form !!gphClipBoxEdit

  !!gphClipBoxEdit.formTitle     = 'Clipping Box'
  !!gphClipBoxEdit.iconTitle     = 'Clipbox'
  !!gphClipBoxEdit.callback      = '!this.initialise()'
  !!gphClipBoxEdit.formRevision  = ' $Revision: 1.10 $ '

  -- Body of form definition
  para .view width 20 lines 1

  -- Box size
  frame .boxFrame 'Size' at xmin ymax+0.2
    path down
    text .xLength 'Xlength ' callback '!this.tag()' width 14 is REAL format !!distanceFmt
    text .yLength 'Ylength ' callback '!this.tag()' width 14 is REAL format !!distanceFmt
    text .zLength 'Zlength ' callback '!this.tag()' width 14 is REAL format !!distanceFmt
  exit

  -- Positioning Gadgets
  frame .positionFrame 'Position' at xmin ymax+0.2
    path down
    option .ew width 5
    option .ns width 5
    option .ud width 5
    text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
    text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
    text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
    toggle .xFlag at xmax+1 ymin.ew
    toggle .yFlag at xmin   ymin.ns
    toggle .zFlag at xmin   ymin.ud
  exit

  -- Orientation Gadgets and Setting
  frame .orientationFrame 'Orientation' at xmin ymax+0.2

    -- EDG Set orientation
    button .edgOri3 pixmap width 24 height 24  callback '!this.pickOrientation(''3picks'')'
    path right
    button .edgOri2 pixmap width 24 height 24  callback '!this.pickOrientation(''2picks'')'

    text .yDir 'Y is ' at x1   ymax+0.25 width 24 is STRING
    text .zDir 'Z is ' at xmin ymax width 24 is STRING
    halign right
    path down
    paragraph .xDir width 31 lines 1
    halign left

  exit

  --  Reference (wrt)
  halign right
  text .wrt 'wrt' callback '!this.setWrt()' width 26 string

  -- Extend dimensions
  text .offset |Extend clipped volume by| tagwidth 17 width 14 is REAL format !!distanceFmt

  -- Apply/Dismiss
  button .apply   'Apply'   at xmin form-0    ymax form+0.25 callback '!this.apply()'
  button .dismiss 'Dismiss' at xmax form-size ymin           callback '!this.close()' cancel

  -- Form Members

    -- Aid numbers
    member .aidNumber    is REAL

    -- Clipbox
    member .clipbox      is GPHCLIPBOX

    -- Form Control Members
    -- Position
    member .position     is POSITIONLINK
    -- Orientation
    member .orientation  is ORIENTATIONLINK

exit
-- End of form definition for !!gphClipBoxEdit

------------------------------------------------------------------------
--
-- Method:      gphClipbox
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphClipBoxEdit()

  !this.edgOri3.addPixmap(!!pml.getPathName('ori3points24.png'))
  !this.edgOri2.addPixmap(!!pml.getPathName('ori2points24.png'))
  !this.offset.callback  = |!this.offset()|

  -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!gphClipBoxEdit.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!gphClipBoxEdit.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!gphClipBoxEdit.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Link Orientation Gadgets to Object
  !this.orientation.linkInput('!!gphClipBoxEdit.orientation', 'Y', !this.yDir, 'Z', !this.zDir, 'X', !this.xDir)

  -- Aid Lines Number
  !this.aidNumber = !!aidNumbers.add('Clipbox')

endmethod
-- End of method definition for .gphClipBoxEdit()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Set Actions so we don't do anything until we have populated the form
  !this.position.setAction('')
  !this.orientation.setAction('')

  -- Set with respect to
  !this.position.setWrt(World)
  !this.orientation.setWrt(World)

  -- Load with position
  !this.position.setPositionForce(!this.clipbox.box.position)
  !this.orientation.setOrientation(!this.clipbox.box.orientation)

  --Set xyz lengths
  !this.xLength.val  = !this.clipbox.box.xLength
  !this.yLength.val  = !this.clipbox.box.yLength
  !this.zLength.val  = !this.clipbox.box.zLength

  -- Set form wrt gadget
  !this.wrt.val = 'World'

  -- Set view name
  !this.view.val = 'Clipping box for ' & !this.clipbox.view.owner().formTitle

  -- Set Actions
  !this.position.setAction('!!gphClipBoxEdit.tag()')
  !this.orientation.setAction('!!gphClipBoxEdit.tag()')

  -- Draw the clipbox
  !this.clipbox.draw(!this.aidNumber)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GPHCLIPBOX  Clipbox box to set form with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!clipbox is GPHCLIPBOX)

  !this.clipbox = !clipbox

endmethod
-- End of method definition for .setup(GPHCLIPBOX)

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Write new clipbox definition back to form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Drawclip box and set clipbox data
  !this.tag()

  -- Copy the current states from the form, just in case its changed
  !this.clipbox.capping = !this.clipbox.view.owner().clipbox.capping
  !this.clipbox.active  = !this.clipbox.view.owner().clipbox.active

  -- Write clipbox to relevant form
  !this.clipbox.view.owner().clipbox = !this.clipbox

  -- Action the clipbox
  !this.clipbox.view.owner().clipbox.set()

  -- Enable clip
  !this.clipbox.view.owner().clipbox.enable()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close clipbox form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Remove aid lines
  !!aidNumbers.hide(!this.aidNumber)

  -- Remove from the edg system
  !!edgCntrl.remove('Graphic Clipbox')

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description:
--   Tag clipbox
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tag()

  -- Write data to local clipbox object
  !this.clipbox.box.position    = !this.position.get()
  !this.clipbox.box.orientation = !this.orientation.get()

  -- Write clip dimensions to local clipbox object
  !this.clipbox.box.xLength     = !this.xLength.val
  !this.clipbox.box.yLength     = !this.yLength.val
  !this.clipbox.box.zLength     = !this.zLength.val

  -- Draw the clipbox
  !this.clipbox.draw(!this.aidNumber)

endmethod
-- End of method definition for .tag()

------------------------------------------------------------------------
--
-- Method:      pickOrientation
--
-- Description:
--   Setup to define orientation using edg
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Ori definition type  3picks
--                                                2picks
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pickOrientation(!type is STRING)

  -- Define a pickpacket
  !packet          = object EDGPACKET()
  !packet.orientationLink('!!gphClipBoxEdit.orientation', 'Orientate Clipbox')

  -- Two pick plane
  if(!type.upcase() eq '2PICKS') then
    -- Define specific for "definePlane" orientation
    !packet.pickPacket.plane2Pnts(!this.position.get())
  endif

  !packet.remove   = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickOrientation(STRING)
------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description:
--   Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)
  !this.orientation.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description:
--   Extend dimensions of clipping box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .offset()

  -- Extend dimensions
  if (!this.offset.val.set()) then
    !this.xLength.val = !this.xLength.val + !this.offset.val
    !this.yLength.val = !this.yLength.val + !this.offset.val
    !this.zLength.val = !this.zLength.val + !this.offset.val
    !this.tag()
  endif

endmethod
-- End of method definition for .offset()
