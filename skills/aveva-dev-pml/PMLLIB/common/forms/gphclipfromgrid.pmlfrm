--
------------------------------------------------------------------------

define method .pickTo()

  -- Use selected grid system
  if (!this.gridSystems.empty()) then
    return error 1 |No grid system available|
  endif

  -- Pick using position control
  !packet = object EDGPACKET()
  !packet.definePosition(|Pick limits to|)
  !packet.action = |!!gphClipFromGrid.pickToReturn(!this.return[1])|
  !packet.remove  = true
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickTo()

------------------------------------------------------------------------
--
-- Method:      pickToReturn
--
-- Description: Process result of clipping pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Result of pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickToReturn(!data is ANY)

  -- Get position from picked data
  if (!data.objectType() eq |POSITION|) then
    !toPos = !data
  else
    !toPos = !data.position
    handle ANY
      -- Does not have position member
      return
    endhandle
  endif

  -- Get grid lines nearest to position
  !posInGrid = object POSINGRID(!this.gridSystems[!this.gridSystemList.val], !toPos)
  !this.xTo.select(|Dtext|, !this.grid.xAxisLabel & !posInGrid.xNearest.grdid)
  !this.yTo.select(|Dtext|, !this.grid.yAxisLabel & !posInGrid.yNearest.grdid)
  !this.zTo.select(|Dtext|, !this.grid.zAxisLabel & !posInGrid.zNearest.grdid)

  -- Get offsets
  !this.xToOff.val = !posInGrid.xCoord.after(| |).replace(| |,||).real(!!distanceFmt)
  if (!this.xToOff.val.unset()) then
    !this.xToOff.val = 0
  endif
  !this.yToOff.val = !posInGrid.yCoord.after(| |).replace(| |,||).real(!!distanceFmt)
  if (!this.yToOff.val.unset()) then
    !this.yToOff.val = 0
  endif
  !this.zToOff.val = !posInGrid.zCoord.after(| |).replace(| |,||).real(!!distanceFmt)
  if (!this.zToOff.val.unset()) then
    !this.zToOff.val = 0
  endif

  -- Update form and graphics
  !this.update(!this.pickTo, ||)

endmethod
-- End of method definition for .pickToReturn(ANY)

------------------------------------------------------------------------
--
-- Method:      gridSystemList
--
-- Description: Populate grid lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .gridSystemList()

  -- Deactivate apply until grid data processed
  !this.apply.active = FALSE
  !gridOk = TRUE

  -- Populate axes offsets from parent form grid object
  !this.grid = object GPHTHREEDPLANTGRID(!this.gridSystems[!this.gridSystemList.val])

  -- X axis
  !dTexts = ARRAY()
  !rTexts = ARRAY()
  !gridTexts = !this.grid.list(|X|)
  do !i indices !gridTexts
    !dTexts.append(!gridTexts[!i])
    !rTexts.append(!i.string())
  enddo
  !this.xFrom.dText = !dTexts
  !this.xFrom.rText = !rTexts
  !this.xTo.dText   = !dTexts
  !this.xTo.rText   = !rTexts
  !this.xTo.select(|Rtext|, !rTexts.last())
  handle any
    -- Empty array
    !gridOk = FALSE
  endhandle

  -- Y axis
  !dTexts = ARRAY()
  !rTexts = ARRAY()
  !gridTexts = !this.grid.list(|Y|)
  do !i indices !gridTexts
    !dTexts.append(!gridTexts[!i])
    !rTexts.append(!i.string())
  enddo
  !this.yFrom.dText = !dTexts
  !this.yFrom.rText = !rTexts
  !this.yTo.dText   = !dTexts
  !this.yTo.rText   = !rTexts
  !this.yTo.select(|Rtext|, !rTexts.last())
  handle any
    -- Empty array
    !gridOk = FALSE
  endhandle

  -- Z axis
  !dTexts = ARRAY()
  !rTexts = ARRAY()
  !gridTexts = !this.grid.list(|Z|)
  do !i indices !gridTexts
    !dTexts.append(!gridTexts[!i])
    !rTexts.append(!i.string())
  enddo
  !this.zFrom.dText = !dTexts
  !this.zFrom.rText = !rTexts
  !this.zTo.dText   = !dTexts
  !this.zTo.rText   = !rTexts
  !this.zTo.select(|Rtext|, !rTexts.last())
  handle any
    -- Empty array
    !gridOk = FALSE
  endhandle

  -- Update form and graphics and activate apply
  if (!gridOk) then
    !this.update(!this.pickFr, ||)
    !this.apply.active = TRUE
  else
    !!alert.error(|Grid system has an axis with no grid lines defined|)
  endif

endmethod
-- End of method definition for .gridSystemList()

------------------------------------------------------------------------
--
-- Method:      unsetCheck
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Actioned gadget
--    2   R      REAL        Default value if unset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unsetCheck(!gadget is GADGET, !default is REAL)

  -- Prevent unset value
  if (!gadget.val.unset()) then
    !!alert.error(|Number required|)
    !gadget.val = !default
  endif

endmethod
-- End of method definition for .unsetCheck()

------------------------------------------------------------------------
--
-- Method:      data
--
-- Description: Pack grid line and offset data into array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Grid line and offset data
--
------------------------------------------------------------------------

-- Define method
define method .data() is ARRAY

  -- Pack data for the selected grid lines
  !data = ARRAY()
  !data[1]  = !this.xFrom.selection().real()
  !data[2]  = !this.yFrom.selection().real()
  !data[3]  = !this.zFrom.selection().real()
  !data[4]  = !this.xTo.selection().real()
  !data[5]  = !this.yTo.selection().real()
  !data[6]  = !this.zTo.selection().real()
  !data[7]  = !this.xFrOff.val
  !data[8]  = !this.yFrOff.val
  !data[9]  = !this.zFrOff.val
  !data[10] = !this.xToOff.val
  !data[11] = !this.yToOff.val
  !data[12] = !this.zToOff.val
  return !data

endmethod
-- End of method definition for .data() is ARRAY

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Update form and graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Actioned gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update(!gadget is GADGET, !action is STRING)

  -- Ignore unselect action
  if (!action eq |UNSELECT|) then
    return
  endif

  -- Unset check on offsets
  if (!gadget eq !this.xFrOff or !gadget eq !this.yFrOff or !gadget eq !this.zFrOff) then
    !this.unsetCheck(!gadget, 0)
  endif
  if (!gadget eq !this.xToOff or !gadget eq !this.yToOff or !gadget eq !this.zToOff) then
    !this.unsetCheck(!gadget, 0)
  endif

  -- Calculate and display the clipped volume (ignore return data)
  !unusedMoreData = !this.grid.clippingPlanes(!this.data(), !this.aidNumber, TRUE)

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Save settings
  !this.xFromSelect = !this.xFrom.selection()
  !this.xToSelect   = !this.xTo.selection()
  !this.yFromSelect = !this.yFrom.selection()
  !this.yToSelect   = !this.yTo.selection()
  !this.zFromSelect = !this.zFrom.selection()
  !this.zToSelect   = !this.zTo.selection()

  -- Apply the selected grid lines
  !this.parentForm.sixPlanes(!this.grid.clippingPlanes(!this.data(), !this.aidNumber, TRUE))

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Tidy up on close
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidNumber)
  if (defined(!!posInPlantGrid)) then
    !!posInPlantGrid.close()
  endif

  -- Clear parent form and reset title so form has to be re-setup
  !this.parentForm = object FORM()
  !this.formTitle  = 'Limits From Grid'

endmethod
-- End of method definition for .close()
