--
-- Description:
-- Display grid system
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  close()                          -                   Tidy up form
--  data()                           ARRAY               Pack grid line and offset data into array
--  gphClipFromGrid()                -                   Constructor
--  gridSystemList()                 -                   Populate grid lines
--  initialise()                     -                   Initialisation of form
--  pickFrom()                       -                   Pick clip limits for grid lines
--  pickFromReturn(ANY)              -                   Process result of clipping pick
--  pickPos()                        -                   Pick position for grid coords
--  pickPosReturn(ANY)               -                   Process result of position pick
--  pickTo()                         -                   Pick clip limits for grid lines
--  pickToReturn(ANY)                -                   Process result of clipping pick
--  setup(FORM,STRING)               -                   Setup form before show
--  unsetCheck(GADGET,REAL)          -                   Validation
--  update(GADGET,STRING)            -                   Update form and graphics
--
------------------------------------------------------------------------

-- Define form
setup form !!gphClipFromGrid resize

  !!gphClipFromGrid.formTitle     = 'Limits From Grid'
  !!gphClipFromGrid.iconTitle     = 'Grid'
  !!gphClipFromGrid.formRevision  = ' $Revision: 1.0 $ '

  -- Bar menu
  bar
  exit

  -- Grid systems
  list .gridSystemList |Grid Systems| anchor all width 56 length 6

  -- Grid Lines
  frame .fromFrame |Limits From| anchor left+bottom at xmin ymax+0.5
    button .pickFr |Pick| width 4
    option .xFrom  at xmin ymax+0.2 width 5
    option .yFrom  at xmin ymax+0.2 width 5
    option .zFrom  at xmin ymax+0.2 width 5
    text   .xFrOff at xmax.xFrom+1 ymin.xFrom width 16 is REAL format !!distanceFmt
    text   .yFrOff at xmin ymin.yFrom width 16 is REAL format !!distanceFmt
    text   .zFrOff at xmin ymin.zFrom width 16 is REAL format !!distanceFmt
    para   .frOff  at xmin.xFrOff ymin.pickFr+0.1 text |+/-| width 5
  exit
  frame .toFrame |To| anchor left+bottom at xmax+1 ymin
    button .pickTo |Pick| width 4
    option .xTo    at xmin ymin.xFrom width 5
    option .yTo    at xmin ymin.yFrom width 5
    option .zTo    at xmin ymin.zFrom width 5
    text   .xToOff at xmax.xTo+1 ymin.xTo width 16 is REAL format !!distanceFmt
    text   .yToOff at xmin ymin.yTo width 16 is REAL format !!distanceFmt
    text   .zToOff at xmin ymin.zTo width 16 is REAL format !!distanceFmt
    para   .toOff  at xmin.xToOff ymin.pickTo+0.1 text |+/-| width 5
  exit

  -- Apply/Dismiss
  button .apply 'Apply' anchor left+bottom  at xmin form ymax+0.5
  button .close 'Close' anchor right+bottom at xmax form-size ymin ok

  -- Calling form (must have sixPlanes method)
  member .parentForm  is FORM

  -- Grid systems
  member .gridSystems is ARRAY

  -- Selected grid system
  member .grid        is GPHTHREEDPLANTGRID

  -- Saved settings on last apply
  member .xFromSelect is STRING
  member .xToSelect   is STRING
  member .yFromSelect is STRING
  member .yToSelect   is STRING
  member .zFromSelect is STRING
  member .zToSelect   is STRING

  -- Aid numbers
  member .aidNumber   is REAL

exit
-- End of form definition for !!gphClipFromGrid

------------------------------------------------------------------------
--
-- Method:      gphClipFromGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphClipFromGrid()

  -- Bar menu
  !this.bar.add(|Display|, |toolsMenu|)
  !menu = !this.newMenu(|toolsMenu|)
  !menu.add(|CALLBACK|, |Picked position in grid coords...|, |!this.pickPos()|)

  -- Callbacks
  !this.callback                = |!this.initialise()|
  !this.gridSystemList.callback = |!this.gridSystemList()|
  !this.xFrom.callback          = |!this.update(|
  !this.yFrom.callback          = |!this.update(|
  !this.zFrom.callback          = |!this.update(|
  !this.xFrOff.callback         = |!this.update(|
  !this.yFrOff.callback         = |!this.update(|
  !this.zFrOff.callback         = |!this.update(|
  !this.xTo.callback            = |!this.update(|
  !this.yTo.callback            = |!this.update(|
  !this.zTo.callback            = |!this.update(|
  !this.xToOff.callback         = |!this.update(|
  !this.yToOff.callback         = |!this.update(|
  !this.zToOff.callback         = |!this.update(|
  !this.pickFr.callback         = |!this.pickFrom()|
  !this.pickTo.callback         = |!this.pickTo()|
  !this.apply.callback          = |!this.apply()|
  !this.close.callback          = |!this.close()|

  -- Tooltips
  !this.pickFr.setToolTip(|Pick position in view to select nearest grid lines|)
  !this.pickTo.setToolTip(|Pick position in view to select nearest grid lines|)

  -- Aid Number
  !this.aidNumber = !!aidNumbers.add(|Clipgrid|)

  -- Initial values
  !this.xFrOff.val = 0
  !this.yFrOff.val = 0
  !this.zFrOff.val = 0
  !this.xToOff.val = 0
  !this.yToOff.val = 0
  !this.zToOff.val = 0

endmethod
-- End of method definition for .gphClipFromGrid()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form before show
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Parent form
--    2   R      STRING      Form title
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!parentForm is FORM, !formTitle is STRING)

  -- Store parent form
  !this.parentForm = !parentForm
  !this.formTitle  = !formTitle

endmethod
-- End of method definition for .setup(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Check form has been setup
  if (!this.parentForm.unset()) then
    return error 1 |Limits from Grid form has not been setup|
  endif

  -- Deactivate apply
  !this.apply.active = FALSE
  !this.fromFrame.active = true
  !this.toFrame.active   = true

  -- Populate list with grid systems
  var !gridSystems collect all GRIDSY
  var !gridSyNames evaluate namn for all from !gridSystems
  var !gridPurpose evaluate purpose for all from !gridSystems
  !this.gridSystems.clear()
  !this.gridSystemList.clear()
  do !i indices !gridSystems
    if (!gridPurpose[!i] ne |RADI|) then
      !this.gridSystems.append(!gridSystems[!i].dbref())
      !this.gridSystemList.add(!gridSyNames[!i])
    endif
  enddo


  -- Try to give same selections if already previous apply had settings for this grid
  !found = FALSE
  do !i indices !this.gridSystems
    if (!this.gridSystems[!i] eq !this.grid.gridSystem) then

      -- Select this grid from list and populate its gridlines
      !found = TRUE
      !this.gridSystemList.val = !i
      handle ANY
      elsehandle NONE
        !this.gridSystemList()

        -- Set previous selections if still valid
        !this.xFrom.select(|Rtext|, !this.xFromSelect)
        handle ANY
        endhandle
        !this.xTo.select(|Rtext|, !this.xToSelect)
        handle ANY
        endhandle
        !this.yFrom.select(|Rtext|, !this.yFromSelect)
        handle ANY
        endhandle
        !this.yTo.select(|Rtext|, !this.yToSelect)
        handle ANY
        endhandle
        !this.zFrom.select(|Rtext|, !this.zFromSelect)
        handle ANY
        endhandle
        !this.zTo.select(|Rtext|, !this.zToSelect)
        handle ANY
        endhandle

      endhandle
      break
    endif
  enddo

  -- Populate with first grid system data if previous selection not found
  if (!found.not()) then
    if (!this.gridSystems.empty().not()) then
      !this.gridSystemList()
    else
      -- no grid system to populate
      !this.fromFrame.active = false
      !this.toFrame.active   = false
    endif
  endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      pickPos
--
-- Description:
--   Pick position for grid coords
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPos()

  -- Use selected grid system
  if (!this.gridSystems.empty()) then
    return error 1 |No grid system available|
  endif

  -- Pick using position control
  !packet = object EDGPACKET()
  !packet.definePosition(|Pick position|)
  !packet.action = |!!gphClipFromGrid.pickPosReturn(!this.return[1])|
  !packet.remove  = true
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickPos()

------------------------------------------------------------------------
--
-- Method:      pickPosReturn
--
-- Description: Process result of position pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Result of pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickPosReturn(!data is ANY)

  -- Get position from picked data
  if (!data.objectType() eq |POSITION|) then
    !position = !data
  else
    !position = !data.position
    handle ANY
      -- Does not have position member
      return
    endhandle
  endif

  -- Setup form to display position in world and grid coords
  if (undefined(!!posInPlantGrid)) then
    pml load form !!posInPlantGrid
  endif
  !!posInPlantGrid.setup(!this.gridSystems[!this.gridSystemList.val], !position)
  show !!posInPlantGrid

endmethod
-- End of method definition for .pickPosReturn(ANY)

------------------------------------------------------------------------
--
-- Method:      pickFrom
--
-- Description:
--   Pick clip limits for grid lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickFrom()

  -- Use selected grid system
  if (!this.gridSystems.empty()) then
    return error 1 |No grid system available|
  endif

  -- Pick using position control
  !packet             = object EDGPACKET()
  !packet.definePosition(|Pick limits from|)
  !packet.action = |!!gphClipFromGrid.pickFromReturn(!this.return[1])|
  !packet.remove  = true
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickFrom()

------------------------------------------------------------------------
--
-- Method:      pickFromReturn
--
-- Description: Process result of clipping pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Result of pick
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickFromReturn(!data is ANY)

  -- Get position from picked data
  if (!data.objectType() eq |POSITION|) then
    !fromPos = !data
  else
    !fromPos = !data.position
    handle ANY
      -- Does not have position member
      return
    endhandle
  endif

  -- Get grid lines nearest from position
  !posInGrid = object POSINGRID(!this.gridSystems[!this.gridSystemList.val], !fromPos)
  !this.xFrom.select(|Dtext|, !this.grid.xAxisLabel & !posInGrid.xNearest.grdid)
  !this.yFrom.select(|Dtext|, !this.grid.yAxisLabel & !posInGrid.yNearest.grdid)
  !this.zFrom.select(|Dtext|, !this.grid.zAxisLabel & !posInGrid.zNearest.grdid)

  -- Get offsets
  !this.xFrOff.val = !posInGrid.xCoord.after(| |).replace(| |,||).real(!!distanceFmt)
  if (!this.xFrOff.val.unset()) then
    !this.xFrOff.val = 0
  endif
  !this.yFrOff.val = !posInGrid.yCoord.after(| |).replace(| |,||).real(!!distanceFmt)
  if (!this.yFrOff.val.unset()) then
    !this.yFrOff.val = 0
  endif
  !this.zFrOff.val = !posInGrid.zCoord.after(| |).replace(| |,||).real(!!distanceFmt)
  if (!this.zFrOff.val.unset()) then
    !this.zFrOff.val = 0
  endif

  -- Update form and graphics
  !this.update(!this.pickFr, ||)

endmethod
-- End of method definition for .pickFromReturn(ANY)

------------------------------------------------------------------------
--
-- Method:      pickTo
--
-- Description:
--   Pick clip limits for grid lines
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
