-- File:            gphclipplaneedit.pmlfrm
--   Type:          Form Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        common
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Mon Nov 06 10:09:38 WAT 2006
--
--
-- Description:
-- Define clip planes for a view
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  changed()                        -                   Action on plane input data being changed
--  clearAll()                       -                   Clear all planes
--  close()                          -                   Close form
--  deriveFromBox()                  -                   Derive 6 planes from currently defined clipping box
--  deriveFromGrid()                 -                   Derive 6 planes from grid system
--  disable()                        -                   Disable clip plane or discard changes
--  displayDirection(ANY)            -                   Display direction of anything with a direction member
--  displayPosition(ANY)             -                   Display position of anything with a position member
--  displayZdir(ANY)                 -                   Display Z direction of anything with an orientation member
--  draw()                           -                   Show aid graphics
--  enable()                         -                   Write new clip plane definition back to form
--  gphClipPlaneEdit()               -                   Constructor
--  initialise()                     -                   Initialise form
--  offset(GADGET,STRING)            -                   Move plane in or out
--  pick()                           -                   Pick item to define plane
--  pickReturn(ANY)                  -                   Process result of pick
--  plane()                          -                   Display plane definition
--  reverse()                        -                   Reverse direction
--  setWrt()                         -                   Set up with new wrt item
--  setup(FORM)                      -                   Initialise form
--  sixPlanes(ARRAY)                 -                   Apply 6 planes from positions and directions
--  sixPlanes(ARRAY,ARRAY)           -                   Apply 6 planes from positions and directions
--  slide(GADGET,STRING)             -                   Slide plane in or out
--  slideActive(BOOLEAN)             -                   Set activation of slider frame gadgets
--  valid()                          BOOLEAN             Validate for apply
--
------------------------------------------------------------------------

setup form !!gphClipPlaneEdit

  !!gphClipPlaneEdit.formTitle     = |Clipping Planes|
  !!gphClipPlaneEdit.iconTitle     = |Clip Planes|
  !!gphClipPlaneEdit.callback      = |!this.initialise()|
  !!gphClipPlaneEdit.formRevision  = | $Revision: 1.0 $ |

  -- Bar menu
  bar
  exit

  -- View name
  para .view width 20 lines 1

  -- Select clipping plane to define
  option .plane |Define clipping plane| at xmin ymax+0.2 tagwidth 14 width 3
  button .pick  |Pick|                  at xmax+1 ymin

  -- Position
  frame .positionFrame |Position| at xmin.plane ymax+0.2
    path down
    option .ew width 5
    option .ns width 5
    option .ud width 5
    text   .x  at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
    text   .y  at xmin   ymin.ns width 14 is REAL format !!distanceFmt
    text   .z  at xmin   ymin.ud width 14 is REAL format !!distanceFmt
  exit

  -- Direction
  frame .directionFrame |Direction| at xmin ymax+0.2
    text .zDir width 24 is STRING
    button .reverse |Reverse|
  exit

  --  Reference (wrt)
  text .wrt |wrt| at xmin+2 ymax+0.2 tagwidth 3 width 20 STRING

  -- Enable or disable plane (allow wider tag as tag is changed dynamically)
  button .enable  | Enable plane  | at xmin.plane ymax+0.5 width 12
  button .disable | Disable plane | at xmax form-size ymin width 12

  -- Slide plane in or out
  frame .slideFrame |Slide plane out or in| at xmin.plane ymax+0.5
    button .out pixmap at xmin+6 ymax width 9 height 12
    para   .nudge at xmax ymin-0.1 text |Nudge out or in| width 10 lines 1
    button .in pixmap at xmax ymin.out width 9 height 12
    text   .offset |Slide by| at xmin.out-3 ymax+0.3 tagwidth 6 width 14 is REAL format !!distanceFmt
    slider .slide horizontal at xmin.out-5 range -2000 +2000 step 50 val 0 width 25
    para   .outTag at xmin ymax text |Out| width 3 lines 1
    para   .midTag at xmax+8.8 ymin text |0| width 1 lines 1
    para   .inTag at xmax.slide-size ymin text |In| width 2 lines 1
  exit

  -- Apply/Dismiss
  button .close |Close| at xmax form-size ymax+0.5 cancel

  -- Graphics view form
  member .parentForm   is FORM

  -- Aid numbers
  member .aidNumber    is REAL

  -- Initial position and direction for slider gadget
  member .planePos     is POSITION
  member .planeDir     is DIRECTION

exit
-- End of form definition for !!gphClipBoxEdit

------------------------------------------------------------------------
--
-- Method:      gphClipPlaneEdit
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphClipPlaneEdit()

  -- Bar menu
  !this.bar.add(|Tools|, |toolsMenu|)
  !menu = !this.newMenu(|toolsMenu|)
  !menu.add(|CALLBACK|, |Derive 6 planes from grid lines...|, |!this.deriveFromGrid()|)
  !menu.add(|CALLBACK|, |Derive 6 planes from clip box...|, |!this.deriveFromBox()|)
  !menu.add(|CALLBACK|, |Clear all clip planes...|, |!this.clearAll()|)

  -- Callbacks
  !this.plane.callback    = |!this.plane()|
  !this.pick.callback     = |!this.pick()|
  !this.ew.callback       = |!this.changed()|
  !this.ns.callback       = |!this.changed()|
  !this.ud.callback       = |!this.changed()|
  !this.x.callback        = |!this.changed()|
  !this.y.callback        = |!this.changed()|
  !this.z.callback        = |!this.changed()|
  !this.zDir.callback     = |!this.changed()|
  !this.reverse.callback  = |!this.reverse()|
  !this.wrt.callback      = |!this.setWrt()|
  !this.enable.callback   = |!this.enable()|
  !this.disable.callback  = |!this.disable()|
  !this.out.callback      = |!this.offset(|
  !this.in.callback       = |!this.offset(|
  !this.offset.callback   = |!this.offset(|
  !this.slide.callback    = |!this.slide(|
  !this.close.callback    = |!this.close()|
  !this.cancelcall        = |!this.close()|

  -- Tooltips
  !this.out.setToolTip(|Slide the plane out a small amount to enlarge the clipped volume|)
  !this.in.setToolTip(|Slide the plane in a small amount to shrink the clipped volume|)
  !this.offset.setToolTip(|Enter a negative value to enlarge the clipped volume or a positive value to shrink the clipped volume|)
  !this.slide.setToolTip(|Slide the plane out to enlarge the clipped volume or in to shrink the clipped volume|)

  -- Options
  !planes = ARRAY()
  do !i to 6
    !planes.append(!i.string())
  enddo
  !this.plane.dtext = !planes
  !axes = ARRAY()
  !axes[1] = |East|
  !axes[2] = |West|
  !this.ew.dtext    = !axes
  !axes[1] = |North|
  !axes[2] = |South|
  !this.ns.dtext    = !axes
  !axes[1] = |Up|
  !axes[2] = |Down|
  !this.ud.dtext    = !axes

  -- Pixmaps
  !this.out.addPixmap(!!PML.getPathName(|leftarrow9x12.png|))
  !this.in.addPixmap(!!PML.getPathName(|rightarrow9x12.png|))


  -- Aid Number
  !this.aidNumber = !!aidNumbers.add(|Clipplanes|)

endmethod
-- End of method definition for .gphClipPlaneEdit()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Set view name
  !this.view.val = 'Clipping planes for ' & !this.parentForm.formTitle

  -- Initialise display variables
  var !coordinate coordinate
  !axes = ARRAY()
  if(!coordinate eq 'ENU')then
    !axes[1] = |East|
    !axes[2] = |West|
    !this.ew.dtext    = !axes
    !axes[1] = |North|
    !axes[2] = |South|
    !this.ns.dtext    = !axes
    !axes[1] = |Up|
    !axes[2] = |Down|
    !this.ud.dtext    = !axes
  else
    !axes[1] = |X|
    !axes[2] = |-X|
    !this.ew.dtext    = !axes
    !axes[1] = |Y|
    !axes[2] = |-Y|
    !this.ns.dtext    = !axes
    !axes[1] = |Z|
    !axes[2] = |-Z|
    !this.ud.dtext    = !axes
  endif
  if(!coordinate eq 'ENU')then
  !this.ew.select(|Dtext|, |East|)
  !this.ns.select(|Dtext|, |North|)
  !this.ud.select(|Dtext|, |Up|)
  else
    !this.ew.select(|Dtext|, |X|)
    !this.ns.select(|Dtext|, |Y|)
    !this.ud.select(|Dtext|, |Z|)
  endif
  !this.x.val = 0
  !this.y.val = 0
  !this.z.val = 0
  !this.zDir.val    = ||
  !this.wrt.val     = ||
  !this.slide.val   = 0
  !this.offset.val  = 0
  !this.enable.tag  = |Enable plane|
  !this.disable.tag = |Disable plane|

  -- Check if first plane has been defined
  if (!this.parentForm.clipPlanes[1].notDefined().not()) then

    -- Get first plane settings
    !this.displayPosition(!this.parentForm.clipPlanes[1])
    !this.displayDirection(!this.parentForm.clipPlanes[1])
    !this.draw()

    -- Gadget activation allows for plane to be defined but not enabled in the view
    !this.enable.active  = !this.parentForm.clipPlanes[1].enabledInView().not()
    !this.disable.active = !this.enable.active.not()
    !this.slideActive(!this.disable.active)

  else

    -- First plane not defined
    !this.enable.active  = FALSE
    !this.disable.active = FALSE
    !this.slideActive(FALSE)

  endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Parent form (with graphical view)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!form is FORM)

  -- Set parent form, must be done before form is shown, called from gphviews.pmlobj
  !this.parentForm = !form

endmethod
-- End of method definition for .setup(FORM)

------------------------------------------------------------------------
--
-- Method:      slideActive
--
-- Description:
--   Set activation of slider frame gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Parent form (with graphical view)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .slideActive(!active is BOOLEAN)

  -- Set activation of slider frame gadgets
  !this.slideFrame.active = !active
  !this.slide.active      = !active
  !this.offset.active     = !active
  !this.nudge.active      = !active
  !this.out.active        = !active
  !this.in.active         = !active
  !this.outTag.active     = !active
  !this.midTag.active     = !active
  !this.inTag.active      = !active

endmethod
-- End of method definition for .slideActive(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      plane
--
-- Description:
--   Display plane definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plane()

  -- Initialise display variables
  var !coordinate coordinate
  if(!coordinate eq 'ENU')then
  !this.ew.select(|Dtext|, |East|)
  !this.ns.select(|Dtext|, |North|)
  !this.ud.select(|Dtext|, |Up|)
  else
   !this.ew.select(|Dtext|, |X|)
   !this.ns.select(|Dtext|, |Y|)
   !this.ud.select(|Dtext|, |Z|)
  endif
  !this.x.val = 0
  !this.y.val = 0
  !this.z.val = 0
  !this.zDir.val    = ||
  !this.wrt.val     = ||
  !this.slide.val   = 0
  !this.offset.val  = 0
  !this.enable.tag  = |Enable plane|
  !this.disable.tag = |Disable plane|

  -- Check if  selected plane has been defined
  if (!this.parentForm.clipPlanes[!this.plane.val].notDefined().not()) then

    -- Get selected plane settings
    !this.displayPosition(!this.parentForm.clipPlanes[!this.plane.val])
    !this.displayDirection(!this.parentForm.clipPlanes[!this.plane.val])
    !this.draw()

    -- Gadget activation
    !this.enable.active = !this.parentForm.clipPlanes[!this.plane.val].enabledInView().not()
    !this.disable.active = !this.enable.active.not()
    !this.slideActive(!this.disable.active)

  else

    -- Selected plane not defined
    !this.enable.active  = FALSE
    !this.disable.active = FALSE
    !this.slideActive(FALSE)

    -- Remove aid graphics
    !!aidNumbers.hide(!this.aidNumber)

  endif

endmethod
-- End of method definition for .plane()

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description:
--   Pick item to define plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pick()

  -- Pick using position control
  !packet = object EDGPACKET()
  !packet.definePosition(|Pick position|)
  !packet.action = |!!gphClipPlaneEdit.pickReturn(!this.return[1])|
  !packet.remove  = true
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pick()

------------------------------------------------------------------------
--
-- Method:      pickReturn
--
-- Description: Process result of pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pickReturn(!data is ANY)

  -- Get position from standard position form and direction from picked item
  !this.displayPosition(!data)
  !this.displayZdir(!data.item)
  !this.draw()

    -- Gadget activation
  !this.enable.tag     = |Enable plane|
  !this.disable.tag    = |Disable plane|
  !this.enable.active  = !this.valid()
  !this.disable.active = !this.enable.active.not()
  !this.slideActive(FALSE)

endmethod
-- End of method definition for .pickReturn(ANY)

------------------------------------------------------------------------
--
-- Method:      deriveFromGrid
--
-- Description:
--   Derive 6 planes from grid system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deriveFromGrid()

  -- Initialise and pass control to grid form
  if (undefined(!!gphClipFromGrid)) then
    pml load form !!gphClipFromGrid
  elseif (!!gphClipFromGrid.shown()) then
    hide !!gphClipFromGrid
  endif
  !!gphClipFromGrid.setup(!this, |Clip from Grid|)
  show !!gphClipFromGrid

endmethod
-- End of method definition for .deriveFromGrid()

------------------------------------------------------------------------
--
-- Method:      deriveFromBox
--
-- Description:
--   Derive 6 planes from currently defined clipping box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deriveFromBox()

  -- Warn if any clip planes already defined
  do !i to 6
    if (!this.parentForm.clipPlanes[!i].notDefined().not()) then
      if (!!alert.confirm(|Ok to replace current clipping plane definitions?|) eq |NO|) then
        return
      endif
      break
    endif
  enddo

  -- Get clip box data
  !clipBox    = !this.parentForm.clipBox.box
  !directions    = ARRAY()
  !directions[1] = !clipBox.orientation.xDir()
  !directions[2] = !clipBox.orientation.xDir().opposite()
  !directions[3] = !clipBox.orientation.yDir()
  !directions[4] = !clipBox.orientation.yDir().opposite()
  !directions[5] = !clipBox.orientation.zDir()
  !directions[6] = !clipBox.orientation.zDir().opposite()
  !positions     = ARRAY()
  !positions[1]  = !clipBox.position.offset(!directions[2], !clipBox.xLength / 2)
  !positions[2]  = !clipBox.position.offset(!directions[1], !clipBox.xLength / 2)
  !positions[3]  = !clipBox.position.offset(!directions[4], !clipBox.yLength / 2)
  !positions[4]  = !clipBox.position.offset(!directions[3], !clipBox.yLength / 2)
  !positions[5]  = !clipBox.position.offset(!directions[6], !clipBox.zLength / 2)
  !positions[6]  = !clipBox.position.offset(!directions[5], !clipBox.zLength / 2)

  -- Define and enable the planes
  !this.sixPlanes(!positions, !directions)

endmethod
-- End of method definition for .deriveFromBox()

------------------------------------------------------------------------
--
-- Method:      sixPlanes
--
-- Description:
--   Apply 6 planes from positions and directions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Position direction, position direction, ... x 6
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sixPlanes(!data is ARRAY)

  -- Define and enable the planes
  do !i to 6
    !this.parentForm.clipPlanes[!i].define(!data[!i * 2 - 1], !data[!i * 2])
    !this.parentForm.clipPlanes[!i].enable(TRUE)
  enddo

  -- Initialise form to first plane
  !this.plane.val = 1
  !this.plane()

endmethod
-- End of method definition for .sixPlanes(ARRAY, ARRAY)

------------------------------------------------------------------------
--
-- Method:      sixPlanes
--
-- Description:
--   Apply 6 planes from positions and directions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       6 positions
--    2   R      ARRAY       6 directions
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sixPlanes(!positions is ARRAY, !directions is ARRAY)

  -- Define and enable the planes
  do !i to 6
    !this.parentForm.clipPlanes[!i].define(!positions[!i], !directions[!i])
    !this.parentForm.clipPlanes[!i].enable(TRUE)
  enddo

  -- Initialise form to first plane
  !this.plane.val = 1
  !this.plane()

endmethod
-- End of method definition for .sixPlanes(ARRAY, ARRAY)

------------------------------------------------------------------------
--
-- Method:      clearAll
--
-- Description:
--   Clear all clip planes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearAll()

  -- Warn if any clip planes already defined
  do !i to 6
    if (!this.parentForm.clipPlanes[!i].notDefined().not()) then
      if (!!alert.confirm(|Ok to clear current clipping plane definitions?|) eq |NO|) then
        return
      endif
      break
    endif
  enddo

  -- Disable and clear all defined clipping planes
  do !i to 6
    if (!this.parentForm.clipPlanes[!i].notDefined().not()) then
      !this.parentForm.clipPlanes[!i].enable(FALSE)
      !this.parentForm.clipPlanes[!i].clear()
    endif
  enddo

  -- Initialise form to first plane
  !this.plane.val = 1
  !this.plane()

endmethod
-- End of method definition for .clearAll()

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description:
--   Show aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .draw()

  -- Update aid graphics if input data is valid
  if (!this.valid()) then

    -- Remove aid graphics
    !!aidNumbers.hide(!this.aidNumber)

    -- Get form data (this is before it has been passed to a clip plane member)
    !position = object POSITION(!this.ew.selection() & !this.x.val & | | & !this.ns.selection() & !this.y.val & | | & !this.ud.selection() & !this.z.val & | WRT | & !this.wrt)
    !direction = object DIRECTION(!this.zDir.val & | WRT | & !this.wrt)

    -- Mark position of clip plane
    !arrowHeight = 1000mm
    !text = |Clip Plane | & !this.plane.val
    AID CLEAR ALL $!<this.aidNumber>
    AID ARROW NUMBER $!<this.aidNumber> AT $!position DIR $!direction HEIGHT $!arrowHeight
    AID TEXT NUMBER $!<this.aidNumber> |$!text| AT $!position

  endif

endmethod
-- End of method definition for .draw()

------------------------------------------------------------------------
--
-- Method:      changed
--
-- Description:
--   Action on plane input data being changed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changed()

  -- Update aid graphics
  !this.draw()

    -- Gadget activation
  !this.enable.tag     = |Apply changes|
  !this.disable.tag    = |Discard changes|
  !this.enable.active  = !this.valid()
  !this.disable.active = TRUE
  !this.slideActive(FALSE)

endmethod
-- End of method definition for .changed()

------------------------------------------------------------------------
--
-- Method:      slide
--
-- Description:
--   Slide plane in or out
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Actioned gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .slide(!gadget is GADGET, !action is STRING)

  -- Slide plane in or out to include/exclude item on clipping plane
  !i = !this.plane.val

  if (!action eq |START|) then

    -- Not valid if clip plane not enabled
    if (!this.parentForm.clipPlanes[!i].enabled.not()) then
      return error 1 |Clip plane is not enabled|
    endif

    -- Get initial plane position and direction
    !this.planePos = !this.parentForm.clipPlanes[!i].position
    !this.planeDir = !this.parentForm.clipPlanes[!i].direction

  elseif (!action eq |STOP|) then

    -- Confirm and display new clipping plane position
    if (!this.offset.val ne 0) then
      !this.displayPosition(!this.parentForm.clipPlanes[!i])
      !this.draw()
    endif

    -- Set the gadgets back to zero ready for further adjustment
    !this.slideActive(TRUE)
    !this.enable.active = FALSE
    pause 1
    !this.slide.val  = 0
    !this.offset.val = 0

  elseif (!action eq |MOVE|) then

    -- Redefine and enable clipping plane at shifted position
    !this.offset.val = $!<this.slide.val>mm
    !this.offset.refresh()
    !position  = !this.planePos.offset(!this.planeDir, !this.offset.val)
    !this.parentForm.clipPlanes[!i].define(!position, !this.planeDir)
    !this.parentForm.clipPlanes[!i].enable(TRUE)
    !this.parentForm.view.refresh()

  endif

endmethod
-- End of method definition for .slide(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description:
--   Move plane in or out
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Actioned gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!gadget is GADGET, !action is STRING)

  -- Move plane in or out to include/exclude item on clipping plane
  !i = !this.plane.val

  -- Not valid if clip plane not enabled
  if (!this.parentForm.clipPlanes[!i].enabled.not()) then
    return error 1 |Clip plane is not enabled|
  endif

  -- Get initial plane position and direction
  !this.planePos = !this.parentForm.clipPlanes[!i].position
  !this.planeDir = !this.parentForm.clipPlanes[!i].direction

  -- Offset is from text gadget or arrow button
  if (!gadget eq !this.in) then
    if (!!distanceFmt.units eq |MM|) then
      !offset = 50mm
    else
      !offset = 2inch
    endif
  elseif (!gadget eq !this.out) then
    if (!!distanceFmt.units eq |MM|) then
      !offset = -50mm
    else
      !offset = -2inch
    endif
  else
    !offset = !this.offset.val
  endif

  -- Redefine and enable clipping plane at shifted position
  !position  = !this.planePos.offset(!this.planeDir, !offset)
  !this.parentForm.clipPlanes[!i].define(!position, !this.planeDir)
  !this.parentForm.clipPlanes[!i].enable(TRUE)
  !this.parentForm.view.refresh()

  -- Confirm and display new clipping plane position
  if (!offset ne 0) then
    !this.displayPosition(!this.parentForm.clipPlanes[!i])
    !this.draw()
  endif

  -- Set the gadgets back to zero ready for further adjustment
  !this.slideActive(TRUE)
  !this.enable.active = FALSE
  if (!gadget eq !this.offset and !this.offset.val ne 0) then
    pause 1
  endif
  !this.offset.val = 0

endmethod
-- End of method definition for .offset()

------------------------------------------------------------------------
--
-- Method:      displayPosition
--
-- Description: Display position of anything with a position member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Object that has position or is a position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayPosition(!item is ANY)

  -- Get position from item
  if (!item.objectType() eq |POSITION|) then
    !position = !item
  else
    !position = !item.position
    handle ANY
      -- Does not have position member
      return
    endhandle
  endif

  var !coordinate coordinate
  -- Display position
  if (!position.set()) then
  	if(!coordinate eq 'XYZ')then
  		if (!position.east lt 0) then
       !this.ew.select(|Dtext|, |-X|)
       !this.x.val = 0 - !position.east
      else
        !this.ew.select(|Dtext|, |X|)
        !this.x.val = !position.east
      endif
      if (!position.north lt 0) then
        !this.ns.select(|Dtext|, |-Y|)
        !this.y.val = 0 - !position.north
      else
        !this.ns.select(|Dtext|, |Y|)
        !this.y.val = !position.north
      endif
      if (!position.up lt 0) then
        !this.ud.select(|Dtext|, |-Z|)
        !this.z.val = 0 - !position.up
      else
        !this.ud.select(|Dtext|, |Z|)
        !this.z.val = !position.up
      endif
      !this.wrt.val = !position.origin.name
  	else
    if (!position.east lt 0) then
      !this.ew.select(|Dtext|, |West|)
      !this.x.val = 0 - !position.east
    else
      !this.ew.select(|Dtext|, |East|)
      !this.x.val = !position.east
    endif
    if (!position.north lt 0) then
      !this.ns.select(|Dtext|, |South|)
      !this.y.val = 0 - !position.north
    else
      !this.ns.select(|Dtext|, |North|)
      !this.y.val = !position.north
    endif
    if (!position.up lt 0) then
      !this.ud.select(|Dtext|, |Down|)
      !this.z.val = 0 - !position.up
    else
      !this.ud.select(|Dtext|, |Up|)
      !this.z.val = !position.up
    endif
    !this.wrt.val = !position.origin.name
    endif
  endif

endmethod
-- End of method definition for displayPosition(ANY)

------------------------------------------------------------------------
--
-- Method:      displayZdir
--
-- Description: Display Z direction of anything with an orientation member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Object that has orientation or is an orientation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayZdir(!item is ANY)

  -- Get orientation from item
  if (!item.objectType() eq |ORIENTATION|) then
    !orientation = !item
  else
    !orientation = !item.orientation
    handle ANY
      -- Does not have orientation member
      return
    endhandle
  endif

  -- Display direction from item's Z axis
  if (!orientation.set()) then
    !this.zDir.val = !orientation.zDir().string().before(| WRT|)
  endif

endmethod
-- End of method definition for displayZdir(ANY)

------------------------------------------------------------------------
--
-- Method:      displayDirection
--
-- Description: Display direction of anything with a direction member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Object that has direction or is a direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayDirection(!item is ANY)

  -- Get direction from item
  if (!item.objectType() eq |DIRECTION|) then
    !direction = !item
  else
    !direction = !item.direction
    handle ANY
      -- Does not have direction member
      return
    endhandle
  endif

  if (!direction.set()) then
    !this.zDir.val = !direction.string().before(| WRT|)
  endif

endmethod
-- End of method definition for displayDirection(ANY)

------------------------------------------------------------------------
--
-- Method:      reverse
--
-- Description:
--   Reverse direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reverse()

  -- Reverse direction
  !direction = object DIRECTION(!this.zDir.val)
  !this.zDir.val = !direction.opposite().string().before(| WRT|)

  -- Mark as changed and update graphics
  !this.changed()

endmethod
-- End of method definition for .reverse()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description:
--   Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- Check wrt reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !this.wrt.val = ||
    return error 1 |Invalid origin for position and direction|
  endhandle
  !this.wrt.val = !wrtItem.name

  -- Mark as changed and update graphics
  !this.changed()

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      valid
--
-- Description:
--   Validate for apply
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Validation of input data
--
------------------------------------------------------------------------

-- Define method
define method .valid() is BOOLEAN

  -- Validate input data
  return (!this.zDir.val.trim() ne || and !this.wrt.val.trim() ne ||)

endmethod
-- End of method definition for .valid()

------------------------------------------------------------------------
--
-- Method:      enable
--
-- Description:
--   Write new clip plane definition back to form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .enable()

  -- Validation
  if (!this.zDir.val.trim() eq || ) then
    return error 1 |Direction not specified|
  endif
  if (!this.wrt.val.trim() eq || ) then
    return error 1 |Wrt not specified|
  endif

  -- Clip plane settings
  !position = object POSITION(!this.ew.selection() & !this.x.val & | | & !this.ns.selection() & !this.y.val & | | & !this.ud.selection() & !this.z.val & | WRT | & !this.wrt)
  !direction = object DIRECTION(!this.zDir.val & | WRT | & !this.wrt)

  -- Define and enable the plane
  !this.parentForm.clipPlanes[!this.plane.val].define(!position, !direction)
  !this.parentForm.clipPlanes[!this.plane.val].enable(TRUE)

    -- Gadget activation (after either enable plane or apply changes)
  !this.enable.tag  = |Enable plane|
  !this.disable.tag = |Disable plane|
  !this.enable.active  = FALSE
  !this.disable.active = TRUE
  !this.slideActive(TRUE)

endmethod
-- End of method definition for .enable()

------------------------------------------------------------------------
--
-- Method:      disable
--
-- Description:
--   Disable clip plane or discard changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .disable()

  if (!this.disable.tag eq |Disable plane|) then

    -- Disable the plane
    !this.parentForm.clipPlanes[!this.plane.val].enable(FALSE)

    -- Gadget activation
    !this.enable.active  = TRUE
    !this.disable.active = FALSE
    !this.slideActive(FALSE)

  elseif (!this.disable.tag eq |Discard changes|) then

    -- Reset display of current plane
    !this.plane()

  endif

endmethod
-- End of method definition for .disable()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Remove aid graphics
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .close()
