-- Created:         Mon Oct 13 16:38:54 BST 1997
--
--
-- Description:
-- Form to control auto colour rules for spooling module
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clearInput()                     -                   reset the input gadgets
--  colour()                         -                   set the colour for the current autocolour rule
--  colourType()                     -                   control the active status of colour input gadgets
--  copy()                           -                   copy action
--  cut()                            -                   cut action
--  gphColAutoRlEdit()               -                   Constructor
--  init()                           -                   Initialisation method for form
--  inputData()                      GPHAUTOCOLOUR       method to return input data as gphColAutoRlEdit object
--  insert()                         -                   insert action
--  listRules(REAL)                  -                   method to display auto colour rules on form
--  ok()                             -                   ok action
--  replace()                        -                   replace action
--  rule()                           -                   check the rule name input
--  ruleDisplay()                    -                   method to display detail of selected autocolour rule
--  ruleSelect()                     -                   show a combo box selection form with rules
--
------------------------------------------------------------------------

-- Define form
setup form !!gphColAutoRlEdit

  !!gphColAutoRlEdit.formTitle     = 'Auto Colour Rules'
  !!gphColAutoRlEdit.iconTitle     = 'Auto Colour'
  !!gphColAutoRlEdit.callback      = '!!gphColAutoRlEdit.init()'
  !!gphColAutoRlEdit.formRevision  = ' $Revision: 1.17 $ '

  member .main is FORM

  member .autoColourRules is ARRAY

  member .localColour is COLOUR

  -- Body of form definition
  frame .input 'Data Input'

    frame .ruleInput 'Rule'                 at xmin+1 ymax        width 70
      text   .rule       'Rule Name '       at xmin+1 ymax        width 30 is STRING
      button .ruleSelect                    at xmax   ymin pixmap width 9 height 12
      button .ruleDefine 'Element Rules...' at xmax+3 ymin
    exit

    frame .colourFrame 'Colour' at xmin                  ymax width 67
      option    .colourType     at xmin+1                ymax width 10
      button    .colour '  '    at xmax.colourType+1     ymin
      text      .colourExp      at xmax+1                ymin width 34 is STRING
      paragraph .lblTranslVal   at xmin.colourType       ymax+0.5       text 'Translucency'
      option    .optTranslVal   at xmax.lblTranslVal+1.5 ymin width 7
      paragraph .lblEdges       at xmax+2.5              ymin           text 'Edges'
      toggle    .tglEdge        at xmax +3               ymin
    exit

  exit

  button .cut     '  Cut  ' at xmin+20 ymax+0.5
  button .copy    ' Copy  ' at xmax+1  ymin
  button .replace 'Replace' at xmax+1  ymin
  button .insert  'Insert ' at xmax+1  ymin
  option .insertOpt         at xmax    ymin width 6

  frame .display 'Data Display' at xmin.input ymax+0.4 width 69
    list  .ruleDisplay 'Rules'  at xmin+1     ymax     width 30 height 10
    frame .colText 'Colour For Selected Rule' at xmax+1 ymin+0.1
      paragraph .colTextP  at xmin+1         ymax             text 'Specific  '
      paragraph .colDisp   at xmax           ymin     width 2 height 1
      paragraph .colName   at xmax+1         ymin     width 15 height 1
      paragraph .expTextP  at xmin.colTextP  ymax+0.2         text 'Expression'
      text .colExpDisp     at xmin           ymax     width 30 is STRING
      paragraph .lblTransl at xmin           ymax+0.2         text 'Translucency'
      paragraph .valTransl at xmax+1         ymin     width 5 height 1
      paragraph .lblEdge   at xmin.lblTransl ymax             text 'Edges'
      paragraph .valEdge   at xmax+8         ymin     width 3 height 1

    exit
  exit

  button .ok     '  OK  ' at x0             ymax+0.5 ok
  button .cancel 'Cancel' at xmax form-size ymin     cancel

exit
-- End of form definition for !!gphColAutoRlEdit

------------------------------------------------------------------------
--
-- Method:      !gphColAutoRlEdit()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .gphColAutoRlEdit()

  -- set icons
  !this.ruleSelect.addPixmap(!!pml.getPathName('comboboxarrow9x12.png'))

  -- define callbacks
  !this.rule.callback        = '!!gphColAutoRlEdit.rule()'
  !this.ruleSelect.callback  = '!!gphColAutoRlEdit.ruleSelect()'
  !this.ruleDefine.callback  = '!!ruleStore.element.edit(||)'
  !this.colourType.callback  = '!!gphColAutoRlEdit.colourType()'
  !this.colour.callback      = |!!colourSelectLoad('!!gphColAutoRlEdit.colour()', 'Colour for AutoColour Rule', !!gphColAutoRlEdit.localColour.code)|

  !this.cut.callback         = '!!gphColAutoRlEdit.cut()'
  !this.copy.callback        = '!!gphColAutoRlEdit.copy()'
  !this.replace.callback     = '!!gphColAutoRlEdit.replace()'
  !this.insert.callback      = '!!gphColAutoRlEdit.insert()'

  !this.ruleDisplay.callback = '!!gphColAutoRlEdit.ruleDisplay()'

  !this.okCall = '!!gphColAutoRlEdit.ok()'

  !dText[1] = 'Before'
  !rText[1] = 'BEFORE'
  !dText[2] = 'After'
  !rText[2] = 'AFTER'
  !this.insertOpt.dText = !dText
  !this.insertOpt.rText = !rText

  --list option for colours
  !dText[1] = 'Specific'
  !dText[2] = 'Expression'
  !rText[1] = 'SPECIFIC'
  !rText[2] = 'EXPRESSION'

  !this.colourType.dText = !dText
  !this.colourType.rText = !rText

  --list translucency value for the option gadget
  !dText[1] = 'SOLID'
  !dText[2] = '12%'
  !dText[3] = '25%'
  !dText[4] = '50%'
  !dText[5] = '75%'
  !dText[6] = '87%'

  !rText[1] = '0'
  !rText[2] = '12'
  !rText[3] = '25'
  !rText[4] = '50'
  !rText[5] = '75'
  !rText[6] = '87'

  !this.optTranslVal.dText = !dText
  !this.optTranslVal.rText = !rText


endmethod
-- End of method definition for .gphColAutoRlEdit()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description:  Initialisation method for form
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------
define method .init()

  -- link to main form
  !this.main = !this.owner()

  -- copy the main form data to the local member
  !this.autoColourRules = !this.main.colourData.autoColourRules
  if (!this.autoColourRules.empty().not()) then
     -- temp. array to store autoColourRules object which rule is unset
     !tmp = object ARRAY()
     do !index indices !this.autoColourRules
        if (!this.autoColourRules[!index].rule.unset()) then
           !tmp.append(!index)
        endif
     enddo

     -- delete those rule object which rule is unset
     if(!tmp.empty().not()) then
        do !i indices !tmp
           !this.autoColourRules.remove(!tmp[!i])
        enddo
     endif
     !tmp.delete()
  endif



  -- display the data
  !this.listRules(1)

  -- initialise the input gadgets
  !this.clearInput()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !listRules()
--
-- Description: method to display auto colour rules on form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .listRules(!index is REAL)

  -- Populate list with auto colour rules
  !dText = ARRAY()

  do !value values !this.autoColourRules
    !dText.append(!value.rule)
  enddo

  if (!this.autoColourRules.empty()) then
    !dText.append('No Rules')
  endif

  !this.ruleDisplay.dText = !dText

  -- select the specified rule
  -- if index is greater than the number of list entries then
  -- set it to the number of the last list entry
  if (!index gt !this.ruleDisplay.dText.size() and !this.ruleDisplay.dText.size() ne 0) then
    !this.ruleDisplay.val = !this.ruleDisplay.dText.size()
  elseif  (!this.ruleDisplay.dText.size() ne 0) then
    !this.ruleDisplay.val = !index
  endif

  !this.ruleDisplay()

endmethod
-- End of method definition for .listRules(REAL)

------------------------------------------------------------------------
--
-- Method:      !ruleDisplay()
--
-- Description: method to display detail of selected autocolour rule
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ruleDisplay()

  if (!this.ruleDisplay.selection().upcase() eq 'NO RULES') then
    !this.colDisp.background = !this.background
    !this.colName.val = ''
    !this.colExpDisp.val = STRING()

    !this.colTextP.active = false
    !this.expTextP.active = false
    !this.colExpDisp.active = false
    !this.lblTransl.active = false
    !this.valTransl.val = ''
    !this.lblEdge.active = false
    !this.valEdge.val = ''

  else
    -- get the colour for the selected rule
    !colourExpValue = !this.autoColourRules[!this.ruleDisplay.val].colourExp

    if (!this.autoColourRules[!this.ruleDisplay.val].translucency eq 0 ) then
      !translVal = 'SOLID'

    else
      !translVal = !this.autoColourRules[!this.ruleDisplay.val].translucency.string()+'%'

    endif

    if (!this.autoColourRules[!this.ruleDisplay.val].edgeOn) then
      !edgeVal ='On'

    else
      !edgeVal = 'Off'

    endif

    !this.lblTransl.active = true
    !this.valTransl.val = !translVal
    !this.lblEdge.active = true
    !this.valEdge.val = !edgeVal

    if (!colourExpValue.unset()) then
      !colourObj = !this.autoColourRules[!this.ruleDisplay.val].colour
      -- set the colour display paragraph
      !this.colDisp.background = !colourObj.code
      !this.colName.val = !colourObj.name

      !this.colExpDisp.val = STRING()

      !this.colTextP.active = true
      !this.expTextP.active = false
      !this.colExpDisp.active = false

    else
      -- set the colour expression display paragraph
      !this.colDisp.background = !this.background
      !this.colName.val = ''

      !this.colExpDisp.val = !colourExpValue

      !this.colTextP.active = false
      !this.expTextP.active = true
      !this.colExpDisp.active = true

    endif
  endif

endmethod
-- End of method definition for .ruleDisplay()

------------------------------------------------------------------------
--
-- Method:      !cut()
--
-- Description: cut action
--
-- Method Type: Procedure

--
------------------------------------------------------------------------
define method .cut()

  -- copy the data
  !this.copy()

  -- remove the current entry
  if (!this.autoColourRules.empty().not() and (!this.ruleDisplay.val LE !this.autoColourRules.maxIndex())) then
     !this.autoColourRules.remove(!this.ruleDisplay.val)
  endif

  -- re-display the rule list
  !this.listRules(!this.ruleDisplay.val)

endmethod
-- End of method definition for .cut()

------------------------------------------------------------------------
--
-- Method:      !copy()
--
-- Description: copy action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .copy()

   if (!this.autoColourRules.empty().not()) then
      !this.rule.val = !this.autoColourRules[!this.ruleDisplay.val].rule
      !trnVal = !this.autoColourRules[!this.ruleDisplay.val].translucency.string()
      !this.optTranslVal.select('rText',!trnVal)
      !edgVal = !this.autoColourRules[!this.ruleDisplay.val].edgeOn
      !colourExpValue = !this.autoColourRules[!this.ruleDisplay.val].colourExp
      !this.tglEdge.val = !edgVal
      if (!colourExpValue.unset()) then
         !colourObj = !this.autoColourRules[!this.ruleDisplay.val].colour
         !this.colourType.val = 1
         !this.colourType()
         !this.localColour = !colourObj
         !this.colour.background = !this.localColour.code
         !this.colourExp.val = !this.localColour.name
      else
         !this.colourType.val = 2
         !this.colourType()
         !this.colour.background = !this.background
         !this.colourExp.val = !colourExpValue
      endif
   endif

endmethod
-- End of method definition for .copy()

------------------------------------------------------------------------
--
-- Method:      !replace()
--
-- Description: replace action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .replace()

   -- Check validity of rule
   if(!!ruleStore.element.badName(!this.rule.val).not() or !this.rule.val.unset()) then
     !!messageFile.warning(152, 007,  !this.rule.val)
     return
   endif

  -- get a rule object from the input gadgets and overwrite the current rule
  if (!this.inputData().rule.unset().not()) then
     !this.autoColourRules[!this.ruleDisplay.val] = !this.inputData()

     -- re-display the rule list
     !this.listRules(!this.ruleDisplay.val)
  endif

endmethod
-- End of method definition for .replace()

------------------------------------------------------------------------
--
-- Method:      !insert()
--
-- Description: insert action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .insert()

   -- Check validity of rule
   if(!!ruleStore.element.badName(!this.rule.val).not() or !this.rule.val.unset()) then
     !!messageFile.warning(152, 007,  !this.rule.val)
     return
   endif

   -- check gphAutoColour's member rule is set before append the member array
   -- the !this.inputData() return a gphAutoColour object
   if (!this.inputData().rule.set()) then

      -- set the insert index
      if (!this.insertOpt.selection() eq 'AFTER') then
         if (!this.autoColourRules.empty()) then
            !index = 1
         else
            !index = !this.ruleDisplay.val + 1
         endif
      else
         !index = !this.ruleDisplay.val
      endif

      -- get a rule object from the input gadgets and insert
      !this.autoColourRules.insert(!index, !this.inputData())

      -- re-display the rule list
      !this.listRules(!index)
   endif

endmethod
-- End of method definition for .insert()

------------------------------------------------------------------------
--
-- Method:      !inputData()
--
-- Description: method to return input data as gphColAutoRlEdit object
--
-- Method Type: Function
-- Return:
--   [gphColAutoRlEdit] [gphColAutoRlEdit object containing input data]
--
------------------------------------------------------------------------
define method .inputData() is GPHAUTOCOLOUR

  !tempObject = object GPHAUTOCOLOUR()
  !translVal = !this.optTranslVal.selection().real()
  !edgeOn = !this.tglEdge.val
  if (!this.colourType.val eq 1) then
    !tempCol = !this.localColour
  else
    !tempCol = !this.colourExp.val
  endif

  !tempObject.gphAutoColour(!this.rule.val, !tempCol, !translVal,!edgeOn)

  return !tempObject

endmethod
-- End of method definition for .inputData() GPHAUTOCOLOUR

------------------------------------------------------------------------
--
-- Method:      !ruleSelect()
--
-- Description: show a combo box selection form with rules
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ruleSelect()

  -- get the currently defined element rules
  !rules = !!ruleStore.element.getRules()

  -- store the combo box selection form title
  !title = 'Select an Auto Colour Rule'

  if (defined(!!comboBox)) then
    if (!!comboBox.shown()) then
      hide !!comboBox
      return
    endif
  endif

  -- show the combo box selection form
  !!comboBox(!this.rule, !title, !rules)

endmethod
-- End of method definition for .ruleSelect()

------------------------------------------------------------------------
--
-- Method:      !colour()
--
-- Description: set the colour for the current autocolour rule
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .colour()

  -- get the colour that has just been selected
  !this.localColour.colour(!!colourSelectGet())

  -- set the form gadgets
  !this.colour.background = !this.localColour.code
  !this.colourExp.val = !this.localColour.name

endmethod
-- End of method definition for .colour()

------------------------------------------------------------------------
--
-- Method:      !colourType()
--
-- Description: control the active status of colour input gadgets
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .colourType()

  -- set the active status of colour input gadgets depending on
  -- the selected colour type from the option gadget
  !colSel = !this.colourType.selection()
  if (!colSel eq 'SPECIFIC') then
    !this.colour.active = true
    if(!this.localColour.code.unset().not()) then
      !this.colour.background = !this.localColour.code
    endif
    !this.colourExp.val =!this.localColour.name
    !this.colourExp.active = true
    !this.colourExp.setEditable(false)

  else
    !this.colour.active = false
    !this.colour.background = !this.background
    !this.colourExp.val = STRING()
    !this.colourExp.active = true
    !this.colourExp.setEditable(true)
  endif

endmethod
-- End of method definition for .colourType()

------------------------------------------------------------------------
--
-- Method:      !clearInput()
--
-- Description: reset the input gadgets
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .clearInput()

  -- select the colour type
  !this.colourType.val = 1
  !this.colourType()

  -- set the default colour to grey
  !this.localColour.colour(1)
  !this.colour.background = !this.localColour.code
  !this.colourExp.val = !this.localColour.name


  -- initialise gadgets
  !this.rule.val = STRING()
  !this.optTranslVal.val = 1
  !this.tglEdge.val = false
endmethod
-- End of method definition for .clearInput()

------------------------------------------------------------------------
--
-- Method:      !rule()
--
-- Description: check the rule name input
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .rule()

  -- check if the defined rule name is valid
  if (!this.rule.val.trim() eq '') then
    !this.rule.val = STRING()

  elseif (!!ruleStore.element.badName(!this.rule.val).not()) then
    -- bad rule name, ask user if they want to use it
    !!messageFile.warning(152, 007,  !this.rule.val)
  endif

endmethod
-- End of method definition for .rule()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: ok action
--
-- Method Type: Procedure

--
------------------------------------------------------------------------
define method .ok()

  -- copy data to main form
  !this.main.colourData.autoColourRules(!this.autoColourRules)

endmethod
-- End of method definition for .ok()
