--
-- File:            gphcoledit.pmlfrm
--   Type:          Form Definition
--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Dec 15 18:19:40 GMT 1997
--
--
-- Description:
-- form to edit colour options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  active()                         -                   set the active colour
--  aids()                           -                   set the aids colour
--  autoCol()                        -                   action for auto colour toggle callback
--  ce()                             -                   set the ce colour
--  display()                        -                   display settings after init/load
--  dynamicCol()                     -                   action for dynamic colour toggle callback
--  gphColEdit()                     -                   Constructor
--  highlight()                      -                   set the highlight colour
--  init()                           -                   form initialisation
--  load()                           -                   load the defaults
--  ok()                             -                   action for ok callback
--  save()                           -                   save the defaults
--  visible()                        -                   set the visible colour
--
------------------------------------------------------------------------

-- Define form
setup form !!gphColEdit

  !!gphColEdit.formTitle     = 'Colours'
  !!gphColEdit.iconTitle     = 'Colours'
  !!gphColEdit.callback      = '!!gphColEdit.init()'
  !!gphColEdit.formRevision  = ' $Revision: 1.17 $ '

  -- local form data store
  member .data is GPHCOLOPT

  -- Body of form definition
  bar
    add 'File' .fileMenu
  exit

  frame .general 'General Colours' at xmin ymax
    -- ce colour gadgets
    paragraph .ceColTextG at xmin+1 ymax+0.2 text 'CE        '
    button    .ceColourG '  ' at xmax ymin
    paragraph .ceColNameG at xmax+1 ymin width 19 lines 1
    -- active colour gadgets
    paragraph .activeColTextG at xmin.ceColTextG ymax+0.2 text 'Active    '
    button    .activeColourG '  ' at xmax ymin
    paragraph .activeColNameG at xmax+1 ymin width 19 lines 1
    -- visible colour gadgets
    paragraph .visibleColTextG at xmin.ceColTextG ymax+0.2 text 'Visible   '
    button    .visibleColourG '  ' at xmax ymin
    paragraph .visibleColNameG at xmax+1 ymin width 19 lines 1
    -- aids colour gadgets
    paragraph .aidsColTextG at xmin.ceColTextG ymax+0.2 text 'Aids      '
    button    .aidsColourG '  ' at xmax ymin
    paragraph .aidsColNameG at xmax+1 ymin width 19 lines 1
    -- highlight colour gadgets
    paragraph .highColTextG at xmin.ceColTextG ymax+0.2 text 'Highlight '
    button    .highColourG '  ' at xmax ymin
    paragraph .highColNameG at xmax+1 ymin width 19 lines 1
  exit

  frame .autoColFrame 'Auto Colour' at xmin ymax+0.1
    toggle .autoColourG 'On/Off' at xmin+1 ymax
    toggle .tglDynamic 'Dynamic' at xmax+3 ymin
    button .autoColRulesG 'Rules...' at xmax+3 ymin
  exit

  button .ok     '  OK  ' at x0 ymax+0.5 ok
  button .cancel 'Cancel' at xmax form-size ymin  cancel

exit
-- End of form definition for !!gphColEdit

------------------------------------------------------------------------
--
-- Method:      !gphColEdit()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .gphColEdit()

  -- build menu bar
  !this.newMenu('fileMenu')
  !this.fileMenu.add('callback', 'Save', '!!gphColEdit.save()')
  !this.fileMenu.add('callback', 'Load', '!!gphColEdit.load()')

  -- define callbacks
  !this.ceColourG.callback      = |!!colourSelectLoad('!!gphColEdit.ce()', 'Colour for Current Element', !!gphColEdit.data.ce.code)|
  !this.activeColourG.callback  = |!!colourSelectLoad('!!gphColEdit.active()', 'Colour for Active Elements', !!gphColEdit.data.active.code)|
  !this.visibleColourG.callback = |!!colourSelectLoad('!!gphColEdit.visible()', 'Colour for Visible Elements', !!gphColEdit.data.visible.code)|
  !this.aidsColourG.callback    = |!!colourSelectLoad('!!gphColEdit.aids()', 'Colour for Graphical Aids', !!gphColEdit.data.aids.code)|
  !this.highColourG.callback    = |!!colourSelectLoad('!!gphColEdit.highlight()', 'Colour for Graphical Highlight', !!gphColEdit.data.highlight.code)|
  !this.autoColourG.callback    = '!this.autoCol()'
  !this.tglDynamic.callback     = '!this.dynamicCol()'
  !this.autoColRulesG.callback  = 'show !!gphColAutoRlEdit'
  !this.okCall = '!!gphColEdit.ok()'

    -- set autocolour gadgets to inactive if in paragon module
  !module = !!module()
  if (!module.appkey.upcase() eq 'CAT') then
    !this.autoColourG.active = false
    !this.autoColRulesG.active = false
  endif

endmethod
-- End of method definition for .gphColEdit()

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: display settings after init/load
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .display()

  -- (re)initialise form gadgets to main data settings
  !this.ceColourG.background = !this.data.ce().code
  !this.ceColNameG.val = !this.data.ce().name
  !this.activeColourG.background = !this.data.active().code
  !this.activeColNameG.val = !this.data.active().name
  !this.visibleColourG.background = !this.data.visible().code
  !this.visibleColNameG.val = !this.data.visible().name
  !this.aidsColourG.background = !this.data.aids().code
  !this.aidsColNameG.val = !this.data.aids().name
  !this.highColourG.background = !this.data.highlight().code
  !this.highColNameG.val = !this.data.highlight().name
  !this.autoColourG.val = !this.data.autoColour()

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  -- copy the current global settings and unset the global flag
  !this.data = !!gphColOpt.localCopy()

  -- initialise form gadgets to main data settings
  !this.display()
  var !stat autoColour dynamic
  !this.tglDynamic.val = !stat.boolean()
  !this.tglDynamic.active = !this.autoColourG.val.boolean()
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: save the defaults
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .save()

  -- save all the data
  !this.data.save()

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load the defaults
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- load the data
  !this.data.load()

  -- reinitialise form gadgets to main data settings
  !this.display()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: set the ce colour
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ce()

  -- get the colour that has just been selected
  !this.data.ce(!!colourSelectGet())

  -- set the form gadgets
  !this.ceColourG.background = !this.data.ce().code
  !this.ceColNameG.val = !this.data.ce().name

endmethod
-- End of method definition for .ce()

------------------------------------------------------------------------
--
-- Method:      !active()
--
-- Description: set the active colour
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .active()

  -- get the colour that has just been selected
  !this.data.active(!!colourSelectGet())

  -- set the form gadgets
  !this.activeColourG.background = !this.data.active().code
  !this.activeColNameG.val = !this.data.active().name

endmethod
-- End of method definition for .active()

------------------------------------------------------------------------
--
-- Method:      !visible()
--
-- Description: set the visible colour
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .visible()

  -- get the colour that has just been selected
  !this.data.visible.colour(!!colourSelectGet())

  -- set the form gadgets
  !this.visibleColourG.background = !this.data.visible().code
  !this.visibleColNameG.val = !this.data.visible().name

endmethod
-- End of method definition for .visible()

------------------------------------------------------------------------
--
-- Method:      !aids()
--
-- Description: set the aids colour
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .aids()

  -- get the colour that has just been selected
  !this.data.aids(!!colourSelectGet())

  -- set the form gadgets
  !this.aidsColourG.background = !this.data.aids().code
  !this.aidsColNameG.val = !this.data.aids().name

endmethod
-- End of method definition for .aids()

------------------------------------------------------------------------
--
-- Method:      !highlight()
--
-- Description: set the highlight colour
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .highlight()

  -- get the colour that has just been selected
  !this.data.highlight(!!colourSelectGet())

  -- set the form gadgets
  !this.highColourG.background = !this.data.highlight().code
  !this.highColNameG.val = !this.data.highlight().name

endmethod
-- End of method definition for .highlight()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: action for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- set all the global representation options
  !this.data.copyToGlobal()

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      !autoCol()
--
-- Description: action for auto colour toggle callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .autoCol()

   !stat = !this.autoColourG.val
   !this.tglDynamic.active = !stat
   !this.data.autoColour = !this.autoColourG.val

endmethod
-- End of method definition for .autoCol()
------------------------------------------------------------------------
--
-- Method:      !dynamicCol()
--
-- Description: action for dynamic colour toggle callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dynamicCol()

   !stat = !this.tglDynamic.val
   if (!stat) then
      autocolour dynamic on
   else
      autocolour dynamic off
   endif
endmethod
-- End of method definition for .dynamicCol()
