-- Created:         Fri Apr 3 13:47:31 WAT 1998
--
--
-- Description:
-- Graphical control form for 3D views
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  background()                     -                   Open colour picker to set background colour to selected forms
--  gphControl()                     -                   Constructor
--  initialise()                     -                   Initialisation for form
--  limits(STRING)                   -                   Set limits
--  remove()                         -                   Remove selected entries
--  select(GADGET,STRING)            -                   Select/Unselect entry
--  selectAll()                      -                   selects all views in the list
--  setBackground()                  -                   Set background colour to selected forms
--  setupMenus()                     -                   Set up menus for form
--  viewSettings()                   -                   Set background colour to selected forms
--
------------------------------------------------------------------------
setup form !!gphControl dialog dock

  !this.formTitle     = '3D View Control'
  !this.iconTitle     = '3DViews'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.16 $ '

  -- List of available views
  list .view anchor all callback '!this.select(' multiple width 25 height 6
  path down
  button .bg          'Background...' anchor bottom+left callback '!this.background()'
  path right
  button .delete      'Delete' anchor bottom+left     callback '!this.remove()'
  path down
  frame .viewFrame at xmin.bg 'New Views' anchor bottom+left width 25
    path right
    button .create      'Create'      anchor bottom+left callback '!!gphViews.addDesign()'
    button .settings    'Settings...' anchor bottom+left callback '!this.viewSettings()'
  exit

exit
-- End of form definition for !!gphControl

------------------------------------------------------------------------
--
-- Method:      .gphControl()
--
-- Description: Constructor
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .gphControl()
  !menu = !this.newMenu('listPop')
  !menu.add('CALLBACK', 'Select All', '!this.selectAll()', 'selectAll')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Background colour...', '!this.background()', 'backgroundColour')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Delete', '!this.remove()', 'deleteSelection')

  !this.view.setPopup(!menu)
endmethod
-- End of method definition for .gphControl()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: Initialisation for form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- Initialise Variables
  !design       = ARRAY()
  !designForm   = ARRAY()
  !navigate     = ARRAY()
  !navigateForm = ARRAY()

  -- Populate the list with currently defined views
  do !i indices !!gphViews.views

    !form = !!gphViews.views[!i].owner()

    -- Just in case a form is defined with no member type
    !unusedType = !form.type
    handle any
      skip
    endhandle

    -- Get form name/title
    if(!form.type.upcase() eq 'DESIGN') then
      !design[!i]       = !form.formTitle
      !designForm[!i]   = !form.string()
    elseif (!form.type.upcase() eq 'NAVIGATE') then
      !navigate[!i]     = !form.formTitle
      !navigateForm[!i] = !form.string()
    endif

  enddo

  -- Sort into order
  !design.compress()
  !designForm.compress()
  !navigate.compress()
  !navigateForm.compress()

  -- Add forms to view
  !dtext           = !design
  !rtext           = !designForm
  !dtext.appendArray(!navigate)
  !rtext.appendArray(!navigateForm)
  !this.view.dtext = !dtext
  !this.view.rtext = !rtext

  -- Setup menu
  !this.setupMenus()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      .setupMenus()
--
-- Description: Set up menus for form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setupMenus()

  -- Initialise Variables

  -- Make delete options inactive
  if(!this.view.selection().empty()) then
    !active = false
  else
    !active = true
  endif

  !this.listPop.setFieldProperty('deleteSelection', 'ACTIVE', !active)
  !this.listPop.setFieldProperty('backgroundColour', 'ACTIVE', !active)

  !this.bg.active = !active
  !this.delete.active = !active

endmethod
-- End of method definition for .setupMenus()

------------------------------------------------------------------------
--
-- Method:      .select()
--
-- Description: Select/Unselect entry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget
--    2   R      STRING      Select/Unselect
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .select(!list is GADGET, !selected is STRING)

  -- Initialise Variables
  !form   = !list.owner()
  !entry  = !list.pickedField

  -- Entry selected
  if(!selected eq 'SELECT') then
    !formString = '!!' & !this.view.rtext[!entry]
    !form       = $!<formString>

    -- Show form, if not shown
    if(!form.shown().not()) then
      !form.show('FREE')
    endif
  endif

  -- Setup menu
  !this.setupMenus()

endmethod
-- End of method definition for .select(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description:
--   Remove selected entries
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remove()

  -- Initialise Variables
  !entries = !this.view.selection('RTEXT')

  -- Entry must be selected
  if(!entries.size() eq 0) then
    !!messageFile.warning(147,1)
    return error 1 noalert
  endif

  -- Remove each form
  do !i indices !entries

    !formString = '!!' & !entries[!i]
    !form       = $!<formString>
    if(defined(!form.view)) then
      !!gphViews.remove(!form.view)
    endif
  enddo

endmethod
-- End of method definition for .remove()

------------------------------------------------------------------------
--
-- Method:      limits
--
-- Description:
--   Set limits
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Limit option
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .limits(!option is STRING)

  -- Initialise Variables
  !entries = !this.view.selection('RTEXT')

  -- Entry must be selected
  if(!entries.size() eq 0) then
    !!alert.error('You must select an entry or entries before using this command.')
    return error 1 noalert
  endif

  -- Setting to obstruction/drawlist box
  if(!option inset('OBSTRUCTION','DRAWLIST')) then

    -- Get List
    if(!option eq 'DRAWLIST') then
      var !collection COLLECT ALL FROM DRAWLIST
    else
      var !collection COLLECT ALL FROM OBST
    endif

    -- Check we have some items in the list
    if(!collection.unset()) then
      !!messageFile.warning(149, 8, !menu.pickedField)
      return
    endif

    -- Convert !collection array into array of dbRefs
    !block    = object BLOCK('!collection[!evalIndex].dbRef()')
    !list     = !collection.evaluate(!block)
    !volume   = !!volumeOfList(!list)

  endif


  -- Remove each form
  do !i indices !entries

    !formString = '!!' & !entries[!i]
    !form       = $!<formString>
    if(defined(!form.view)) then

      if(!option eq 'CE') then
        !!gphViews.limits(!form.view, !!ce)

      elseif (!option eq 'OWNER') then

        !!gphViews.limits(!form.view, !!ce.owner)
      elseif (!option eq 'DRAWLIST') then
        !this.limits(!form.view, !volume)

      elseif (!option eq 'OBSTRUCTION') then
        !this.limits(!form.view, !volume)

      elseif (!option eq 'CLIPBOX') then
        -- Convert clip box definition into a volume object
        !volume             = object VOLUME()
        !volume.from.east   = !form.clipbox.position.east  - !form.clipbox.xLength / 2
        !volume.from.north  = !form.clipbox.position.north - !form.clipbox.yLength / 2
        !volume.from.up     = !form.clipbox.position.up    - !form.clipbox.zLength / 2
        !volume.to.east     = !form.clipbox.position.east  + !form.clipbox.xLength / 2
        !volume.to.north    = !form.clipbox.position.north + !form.clipbox.yLength / 2
        !volume.to.up       = !form.clipbox.position.up    + !form.clipbox.zLength / 2
        !this.limits(!form.view, !volume)

      elseif (!option eq 'RESTORE') then
        !form.view.limits = !form.view.limits

      endif

    endif
  enddo

endmethod
-- End of method definition for .limits(STRING)

------------------------------------------------------------------------
--
-- Method:      background
--
-- Description: Open colour picker to set background colour to selected forms
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .background()

  -- Initialise Variables
  !command   = '!!gphControl.setBackground()'
  !title     = 'Background Colour'
  !colour    = 206

  -- Display colour selection form
  call !!colourSelectLoad(!command, !title, !colour)

endmethod
-- End of method definition for .background()

------------------------------------------------------------------------
--
-- Method:      setBackground
--
-- Description: Set background colour to selected forms
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setBackground()

  -- Initialise Variables

  !entries = !this.view.selection('RTEXT')

  -- Entry must be selected
  if(!entries.size() eq 0) then
    !!messageFile.warning(147,1)
    return
  endif

  -- Remove each form
  do !i indices !entries

    !formString = '!!' & !entries[!i]
    !form       = $!<formString>
    if(defined(!form.view)) then
      !form.view.background = !!colourSelectGet()
    endif
  enddo


endmethod
-- End of method definition for .setBackground()

------------------------------------------------------------------------
--
-- Method:      viewSettings
--
-- Description: Set background colour to selected forms
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewSettings()
  loadform !!gphsettings
  !!gphsettings.showForm('3DVIEW')
endmethod
-- End of method definition for .viewSettings()

------------------------------------------------------------------------
--
-- Method:      .selectAll()
--
-- Description: selects all views in the list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectAll()
  !this.view.select('RTEXT', !this.view.rtext)
  !this.setupMenus()
endmethod
-- End of method definition for .selectAll()
