--
--
-- Description:
-- Manage drawlist
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply display changes to selected elements
--  getNearest(REAL)                 STRING              Find nearest selection to translucency value
--  gphDrawlistRep()                 -                   Constructor
--  initialise()                     -                   Initialise form
--  setAfterApplyCallback(STRING)    -                   Sets a callback to be evaluated after apply is called
--  setup(GADGET)                    -                   Setup form
--
------------------------------------------------------------------------

-- Define form
setup form !!gphDrawlistRep

  !!gphDrawlistRep.formTitle     = 'Graphics Representation'
  !!gphDrawlistRep.iconTitle     = 'Representation'
  !!gphDrawlistRep.formRevision  = ' $Revision: 1.0 $ '
  !!gphDrawlistRep.initcall      = '!this.initialise()'

  path down

  -- Basic representations
  toggle .tubeG          |Tube|
  toggle .centrelineG    |Centreline|    at xmin ymax
  toggle .holesG         |Holes Drawn|   at xmin ymax
  option .insulationG    |Insulation |   at xmin ymax+0.2 tagwidth 8 width 5
  option .obstructionG   |Obstruction|   at xmin ymax+0.2 tagwidth 8 width 5

  -- Drawing levels
  frame .level |Level| at xmax+2.5 ymin.tubeG
    text .pipeLevelG     |Pipe     | tagwidth 7 width 3 is REAL
    text .nozzLevelG     |Nozzle   | tagwidth 7 width 3 is REAL
    text .struLevelG     |Structure| tagwidth 7 width 3 is REAL
    text .generalLevelG  |Others   | tagwidth 7 width 3 is REAL
  exit

  text .arcToleranceG |Arc Tolerance| at xmin.tubeG+4 ymax+0.2 tagwidth 10 width 12 is REAL format !!distanceFmt

  -- Nodes, Plines and Ppoints
  frame .nodes |Nodes| at xmin.tubeG ymax.arcToleranceG+0.3
    toggle .pNodesG |Primary|   tagwidth 7
    toggle .sNodesG |Secondary| tagwidth 7 at xmin ymax
  exit

  frame .plines |Plines| at xmax+1 ymin
    toggle .pLinesG     |Display| tagwidth 5
    toggle .pLinesPkeyG |Pkey|    tagwidth 5 at xmin ymax
  exit

  frame .ppoints |Ppoints| at xmax+1 ymin
    toggle .pPointsG        |Display| tagwidth 6
    toggle .pPointsNumbersG |Numbers| tagwidth 6 at xmin ymax
  exit

  -- World Axes
  toggle .showAxes at xmin.tubeG ymax+0.2 'Show World Axes'

  -- Buttons
  button .apply |Apply| at xmin.tubeG ymax+0.5
  button .close |Close| at xmax form-size ymin ok

  -- View from which form was invoked
  member .view            is GADGET

  -- Drawlist to which this view is attached
  member .drawlist        is DRAWLIST

  -- member mm format used for conversion to/from mm stored values
  member .fmm             is FORMAT

  -- Function to call after an apply
  member .afterApply      is STRING

exit
-- End of form definition for !!drawlist

------------------------------------------------------------------------
--
-- Method:      gphDrawlistRep
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphDrawlistRep()

  -- Transparency menus
  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext.append('Off')
  !dtext.append('Solid')
  !dtext.append('12%')
  !dtext.append('25%')
  !dtext.append('50%')
  !dtext.append('75%')
  !dtext.append('87%')
  !rtext.append('-1')
  !rtext.append('0')
  !rtext.append('12')
  !rtext.append('25')
  !rtext.append('50')
  !rtext.append('75')
  !rtext.append('87')
  !this.insulationG.dtext  = !dtext
  !this.insulationG.rtext  = !rtext
  !this.obstructionG.dtext = !dtext
  !this.obstructionG.rtext = !rtext

  -- Tooltips
  !this.insulationG.setToolTip(|Insulation visibility/translucency|)
  !this.obstructionG.setToolTip(|Obstruction visibility/translucency|)

  -- Callbacks
  !this.apply.callback = |!this.apply()|
  !this.cancelCall     = |!this.afterApply = ''|
  !this.okCall         = !this.cancelCall
  !this.afterApply     = ''

endmethod
-- End of method definition for .gphDrawlistRep()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Set title
  !this.formTitle = 'Represent - ' & !this.view.owner().formTitle

  -- Get drawlist that has this view attached
  !this.drawlist = !!gphdrawlists.drawlist(!this.view)

  -- Basic settings
  !this.tubeG.val         = !this.drawlist.tube()
  !this.centrelineG.val   = !this.drawlist.centreline()
  !this.holesG.val        = !this.drawlist.holes()

  -- Levels
  !this.pipeLevelG.val    = !this.drawlist.pipeLevel()
  !this.nozzLevelG.val    = !this.drawlist.nozzLevel()
  !this.struLevelG.val    = !this.drawlist.struLevel()
  !this.generalLevelG.val = !this.drawlist.level()

-- arctol is always in mm.  must convert it to current units
--  !this.fmm.units = 'mm'
--  !this.fmm.label = 'mm'
  !this.arcToleranceG.val = !this.drawlist.arcTol().currentUnits('DIST')

  -- Insulation
  if (!this.drawlist.insulation()) then
    !this.insulationG.select(|Rtext|, !this.getNearest(!this.drawlist.insulationTrans()))
  else
    !this.insulationG.select(|Rtext|, |-1|)
  endif

  -- Obstruction
  if (!this.drawlist.obstruction()) then
    !this.obstructionG.select(|Rtext|, !this.getNearest(!this.drawlist.obstructionTrans()))
  else
    !this.obstructionG.select(|Rtext|, |-1|)
  endif

  -- Nodes, Plines and Ppoints
  !this.pNodesG.val         = !this.drawlist.pnode()
  !this.sNodesG.val         = !this.drawlist.snode()
  !this.pPointsG.val        = !this.drawlist.ppoints()
  !this.pPointsNumbersG.val = !this.drawlist.ppointNumbers()
  !this.pLinesG.val         = !this.drawlist.pline()
  !this.pLinesPkeyG.val     = !this.drawlist.pkey()

  -- World axes
  !this.showAxes.val = !this.view.showAxes

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!view is GADGET)

  -- Set view, must be done before form is shown, called from gphviews.pmlobj
  !this.view = !view

endmethod
-- End of method definition for .setup(GADGET)

------------------------------------------------------------------------
--
-- Method:      getNearest
--
-- Description:
--   Find nearest selection to translucency value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Translucency
-- Return:
--   [Data Type] [Description]
--    STRING      Translucency selection
--
------------------------------------------------------------------------

define method .getNearest(!translucency is REAL) is STRING

  -- Find nearest selection to translucency value
  if (!translucency lt 1) then
    !selection = |0|
  elseif (!translucency lt 19) then
    !selection = |12|
  elseif (!translucency lt 38) then
    !selection = |25|
  elseif (!translucency lt 63) then
    !selection = |50|
  elseif (!translucency lt 82) then
    !selection = |75|
  else
    !selection = |87|
  endif
  return !selection

endmethod
-- End of method definition for .getNearest(GADGET)

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply display changes to selected elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Basic settings
  !this.drawlist.tube(!this.tubeG.val)
  !this.drawlist.centreline(!this.centrelineG.val)
  !this.drawlist.holes(!this.holesG.val)

  -- Levels
  !this.drawlist.pipeLevel(!this.pipeLevelG.val.real())
  !this.drawlist.nozzLevel(!this.nozzLevelG.val.real())
  !this.drawlist.struLevel(!this.struLevelG.val.real())
  !this.drawlist.level(!this.generalLevelG.val.real())

  -- convert tolerance to MM
  !mmArcTol = !!comValueConvert(!this.arcToleranceG.val,'MM')
  !this.drawlist.arcTol(!mmArcTol)

  -- Insulation
  !insulation = !this.insulationG.selection()
  if (!insulation eq |-1|) then
    !this.drawlist.insulation(FALSE)
    !this.drawlist.insulationTrans(0)
  else
    !this.drawlist.insulation(TRUE)
    !this.drawlist.insulationTrans(!insulation.real())
  endif

  -- Obstruction
  !obstruction = !this.obstructionG.selection()
  if (!obstruction eq |-1|) then
    !this.drawlist.obstruction(FALSE)
    !this.drawlist.obstructionTrans(0)
  else
    !this.drawlist.obstruction(TRUE)
    !this.drawlist.obstructionTrans(!obstruction.real())
  endif

  -- Nodes, Plines and Ppoints
  !this.drawlist.pnode(!this.pNodesG.val)
  !this.drawlist.snode(!this.sNodesG.val)
  !this.drawlist.ppoints(!this.pPointsG.val)
  !this.drawlist.ppointNumbers(!this.pPointsNumbersG.val)
  !this.drawlist.pline(!this.pLinesG.val)
  !this.drawlist.pkey(!this.pLinesPkeyG.val)

  -- Update
  !this.drawlist.update()

  -- World Axes
  !this.view.showAxes = !this.showAxes.val
  if (defined(!this.view.owner().axesButton)) then
    !this.view.owner().axesButton.val = !this.showAxes.val
  endif

  -- Evaluate apply callback
  if (not !this.afterApply.empty()) then
    $!<this.afterApply>
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      setAfterApplyCallback
--
-- Description:
--   Sets a callback to be evaluated after apply is called
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Callback to invoke
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAfterApplyCallback(!callback is STRING)

  !this.afterApply  = !callback

endmethod
-- End of method definition for .setAfterApplyCallback
