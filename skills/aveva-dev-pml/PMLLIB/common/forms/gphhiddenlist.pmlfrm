--
--
-- Description:
-- Show hidden objects
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply display changes to selected elements
--  gphHiddenList()                  -                   Constructor
--  gridPopupClick(MENU,STRING)      -                   Process selection in grid control
--  gridRightClick(ARRAY)            -                   Process selection in grid control
--  initialise()                     -                   Initialise form
--  select(ARRAY)                    -                   Process selection in grid control
--  setup(GADGET)                    -                   Initialise form
--
------------------------------------------------------------------------

import 'GridControl'
handle any
endhandle

-- Define form
setup form !!gphHiddenList resize

  !!gphHiddenList.formTitle     = 'Hidden Objects'
  !!gphHiddenList.iconTitle     = 'Hidden'
  !!gphHiddenList.formRevision  = ' $Revision: 1.0 $ '
  !!gphHiddenList.initcall      = '!this.initialise()'

  using namespace 'Aveva.Pdms.Presentation'

  -- Refresh lists
  button .refresh |Refresh| at x33 ymin

  -- Hidden List
  frame .hiddenListFrame |Drawlist| at xmin form ymax anchor ALL width 42 height 20
    -- PML Container to host .Net control
    container .netHiddenListFrame PmlNetControl |Hidden List| dock fill
  exit

  -- Popup menu
  menu .gridPopup popup

    -- Button to unhide selected objects
  button .apply  |Show Objects| anchor bottom+left at xmin ymax+0.5 width 10

  -- .Net grid controls
  member .hiddenListGrid  is NETGRIDCONTROL

  -- Selected elements in grid
  member .gridSelection   is ARRAY

  -- View from which form was invoked
  member .view            is GADGET

  -- Drawlist to which this view is attached
  member .drawlist        is DRAWLIST

-- End of form definition for !!gphHiddenList

------------------------------------------------------------------------
--
-- Method:      gphHiddenList
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphHiddenList()

  using namespace 'Aveva.Pdms.Presentation'

  -- Add instance of .Net control
  !this.hiddenListGrid = object NETGRIDCONTROL()

  -- Add PML event handlers to .Net controls
  !this.hiddenListGrid.addeventhandler('OnPopup', !this, 'gridRightClick')
  !this.gridPopup.add(|callback|, |Show|, |!this.gridPopupClick(| )

  -- Add .Net controls to PML containers
  !this.netHiddenListFrame.control = !this.hiddenListGrid.handle()

  -- Callbacks
  !this.refresh.callback        = |!this.initialise()|
  !this.apply.callback          = |!this.apply()|
  !this.hiddenListGrid.addeventhandler('AfterSelectChange', !this, 'select')

  -- Tooltips
  !this.apply.setTooltip(|Show previously hidden objects in graphical view|)

endmethod
-- End of method definition for .gphHiddenList()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  using namespace  'Aveva.Pdms.Presentation'

  -- Set title
  !this.formTitle = 'Hidden Objects - ' & !this.view.owner().formTitle

  -- Set parameters
  !this.hiddenListGrid.columnExcelFilter(TRUE)
  !this.hiddenListGrid.outlookGroupStyle(TRUE)
  !this.hiddenListGrid.fixedHeaders(TRUE)
  !this.hiddenListGrid.fixedRows(TRUE)
  !this.hiddenListGrid.gridHeight(1000.0)
  !this.hiddenListGrid.columnSummaries(TRUE)

  -- Clear any existing data
  !this.hiddenListGrid.clearGrid()
  !this.gridSelection.clear()

  -- Set headings
  !headings = ARRAY()
  !headings[1] = 'Name'
  !headings[2] = 'Type'

  -- Get hidden objects for this view
  !this.drawlist = !!gphdrawlists.drawlist(!this.view)
  !itemlist = ARRAY()
  do !element values !this.drawlist.hidden()
    !itemlist.append(!element.name)
  enddo

  -- Populate drawlist with standard TOOLTIP text (name, type & description)
  !title = 'Hidden List'
  !nds = object NETDATASOURCE(!title, !headings, !itemlist)
  !this.hiddenListGrid.bindToDataSource(!nds)

  -- Deactivate apply button until an object is selected
  !this.apply.active = FALSE

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!view is GADGET)

  -- Set view, must be done before form is shown, called from gphviews.pmlobj
  !this.view = !view

endmethod
-- End of method definition for .setup(GADGET)

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Process selection in grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!data is ARRAY)

  -- Initialise data
  !this.gridSelection.clear()

  -- Get selected elements
  do !item values !data[0]
    !element = !item.dbref()
    !this.gridSelection.append(!element)
  enddo

  -- Activate apply button now an object is selected
  !this.apply.active = TRUE

endmethod
-- End of method definition for .select(ARRAY)

------------------------------------------------------------------------
--
-- Method:      gridRightClick
--
-- Description: Process selection in grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridRightClick(!data is ARRAY)

  -- Catch right click and show pml popup menu at same coords
  !this.netHiddenListFrame.popup = !this.gridPopup
  !this.netHiddenListFrame.showPopup(!data[0], !data[1])

endmethod
-- End of method definition for .gridRightClick(ARRAY)

------------------------------------------------------------------------
--
-- Method:      gridPopupClick
--
-- Description: Process selection in grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu
--    2   R      STRING      Selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridPopupClick(!menu is MENU, !dummySelected is STRING)

  using namespace 'Aveva.Pdms.Presentation.MyDataAddin'

  -- Selected action
  if (!menu.pickedField eq |Show|) then
    !this.apply()
  endif

endmethod
-- End of method definition for .gridPopupClick(MENU,STRING)

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply display changes to selected elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Show all selected elements
  do !element values !this.gridSelection
    !this.drawlist.visibility(!element, TRUE)
  enddo

  -- Refresh form
  !this.initialise()

endmethod
-- End of method definition for .apply()
