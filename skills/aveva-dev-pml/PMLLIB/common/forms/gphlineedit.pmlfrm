--
-- File:            gphlineedit.pmlfrm
--   Type:          Form Definition
--   Group:         Aid element handlers
--     Keyword:     AID
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Apr 20 17:51:22 WAT 1998
--
--
-- Description:
-- Edit an aid line.
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  close()                          -                   Close form down
--  direction()                      -                   Changes lines start/end position so the lines lies in the defined direction
--  gphLineEdit()                    -                   Constructor
--  initialise()                     -                   Initialise form
--  length()                         -                   Set length
--  positionType()                   -                   Set position type
--  preview()                        -                   Preview new definition
--  setPosition()                    -                   Set position data
--  setPosition(POSITION)            -                   Return position data
--  setWrt()                         -                   Set up with new wrt item
--  setup(REAL)                      -                   Setup form with pointer to aid number being modified
--  tidy()                           -                   Tidy form data
--  updateGadgets()                  -                   Update length and direction gadgets with current settings
--
------------------------------------------------------------------------

setup form !!gphLineEdit

  !!gphLineEdit.formTitle     = 'Modify Line'
  !!gphLineEdit.iconTitle     = 'Line'
  !!gphLineEdit.callback      = '!this.initialise()'
  !!gphLineEdit.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition

  -- Positions
  frame .positionFrame 'Position' width 35

    -- Position being modified
    option .positionType callback '!this.positionType()' width 12

    path down
    halign left
    option .ew width 5
    option .ns width 5
    option .ud width 5
    text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
    text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
    text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
    toggle .xFlag at xmax+1 ymin.ew
    toggle .yFlag at xmin   ymin.ns
    toggle .zFlag at xmin   ymin.ud

    --  Reference (wrt)
    halign right
    text .wrt 'wrt' callback '!this.setWrt()' width 20 string

    para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'

  exit

  -- Secondary settings
  frame .settingFrame 'Settings' at xmin ymax width 35

    -- Length
    text .length  'Length '      at xmin+4 ymax     callback '!this.length()'    width 14 is REAL format !!distanceFmt

    -- Direction of line
    text .direction 'Direction ' at x1     ymax+0.2 callback '!this.direction()' width 20 is DIRECTION

  exit

  -- Apply dismiss
  button .apply   ' OK '   at xmin form-0    ymax form+0.25 callback '!this.apply()' ok
  button .dismiss 'Cancel' at xmax form-size ymin           callback '!this.close()' cancel

  -- Form Members
  -- Aid line number being modified
  member .aidLine     is REAL

  -- Aid Number
  member .aidNumber   is REAL

  -- Line definition
  member .line        is GPHLINE

  -- From/To position
  member .position    is POSITIONLINK

exit
-- End of form definition for !!gphLineEdit

------------------------------------------------------------------------
--
-- Method:      gphLineEdit
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphLineEdit()

  -- Set positioning types
  !dText[1] = 'Centre'
  !rText[1] = 'CENTRE'
  !dText[2] = 'Start'
  !rText[2] = 'START'
  !dText[3] = 'End'
  !rText[3] = 'END'

  !this.positionType.dText = !dText
  !this.positionType.rText = !rText

  -- Link Input Gadgets to Objects
  !this.position.linkInput('!!gphLineEdit.position',!this.x, !this.y, !this.z)

  -- Link Lock Gadgets to Objects
  !this.position.linkLock('!!gphLineEdit.position',!this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!gphLineEdit.position',!this.ew, !this.ns, !this.ud, !coordinate)

  -- Set tagging method up
  !this.position.setAction('!!gphLineEdit.preview()')

  -- Get aid number
  !this.aidNumber = !!aidNumbers.add('Edit Line')

endmethod
-- End of method definition for .gphLineEdit()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  -- Link Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!gphLineEdit.position',!this.ew, !this.ns, !this.ud, !coordinate)

  -- Unset actions, so we don't run the tag action
  !this.position.setAction('')

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- Set with respect to
  !this.setWrt()

  -- Get current definition
  !line = !this.line.coreObject()

  -- Unset object definition
  if(!line.unset()) then
    !line             = object LINE(N0, N1000mm)
    !this.line.line   = !line
  endif

  !this.line.description = 'Modified Line'
  !this.line.tag         = true
  !this.line.detail      = true

  -- Initialise form gadgets
  !this.updateGadgets()

  -- Select default position type
  !this.positionType.select('RTEXT', 'CENTRE')
  !this.positionType()

  -- Set tagging method up
  !this.position.setAction('!!gphLineEdit.setPosition()')

  -- Draw Line
  !this.preview()

endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  !this.line.description = !!aidNumbers.numbers[!this.aidLine].description
  !this.line.tag         = !!aidNumbers.numbers[!this.aidLine].tag
  !this.line.detail      = !!aidNumbers.numbers[!this.aidLine].detail

  -- Replace current definition
  !!aidNumbers.replace(!this.aidLine, !this.line)

  -- Close
  !this.close()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Hide aid elements
  !this.tidy()

  -- Remove event
  !!edgCntrl.remove('Edit aid line definition')

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide aid elements
  !!aidNumbers.hide(!this.aidNumber)


endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form with pointer to aid number being modified
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number / line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Set form data
  !this.aidLine   = !aidNumber
  !this.formTitle = 'Modify Line [' & !aidNumber & ']'
  !this.line      = !!aidNumbers.numbers[!aidNumber]

endmethod
-- End of method definition for .setup(REAL)

------------------------------------------------------------------------
--
-- Method:      updateGadgets
--
-- Description: Update length and direction gadgets with current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateGadgets()

  -- Set gadget data
  !this.direction.val = !this.line.line.direction()
  !this.length.val    = !this.line.line.length()

endmethod
-- End of method definition for .updateGadgets()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition()

  -- Use form position
  !this.setPosition(!this.position.get())

endmethod
-- End of method definition for .setPosition()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Return position data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    New derived position
--
------------------------------------------------------------------------

define method .setPosition(!position is POSITION)

  -- Modify circle to information for new position
  !type = !this.positionType.selection()


  -- Assign passed position to form
  !this.position.position(!position, false, false)

  -- Start position
  if(!type eq 'START') then
    !this.line.line.startPosition = !this.position.position()

  -- End position
  elseif (!type eq 'END') then
    !this.line.line.endPosition   = !this.position.position()

  -- Centre position
  else
    !this.line.line = !!appMathLib.gmfLine.copyAt(!this.line.line, !this.position.position())

  endif

  -- Update no position gadgets
  !this.updateGadgets()

  -- Show arc
  !this.preview()

endmethod
-- End of method definition for .setPosition(POSITION)

------------------------------------------------------------------------
--
-- Method:      positionType
--
-- Description: Set position type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionType()

  -- Get current selection
  !type = !this.positionType.selection()

  -- Origin position
  if(!type eq 'START') then
    !this.position.position(!this.line.line.startPosition, false, true)

  -- Start position
  elseif (!type eq 'END') then
    !this.position.position(!this.line.line.endPosition, false, true)

  -- Centre position
  else
    !this.position.position(!this.line.line.proportion(0.5), false, true)
  endif

endmethod
-- End of method definition for .positionType()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview new definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Replace current definition
  !!aidNumbers.replace(!this.aidNumber, !this.line)

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Changes lines start/end position so the lines lies in the defined direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .direction()

  -- Get current selection
  !type = !this.positionType.selection()

  -- Origin position
  if(!type eq 'START') then
    !line = !this.line.line.direction(!this.direction.val)

  -- Start position
  elseif (!type eq 'END') then
    !line = !this.line.line.reverseSense().direction(!this.direction.val.opposite()).reverseSense()

  -- Centre position
  else

    -- Move line to the centre of the current definition
    !line = object LINE(!this.line.line.proportion(0.5), !this.line.line.endPosition)
    !line = !line.direction(!this.direction.val).setLengthStart(!this.line.line.length())

  endif

  !this.line.line = !line

  -- Redefine position gadgets
  !this.updateGadgets()

  -- Update position gadget
  !this.positionType()

  -- Preview line
  !this.preview()

endmethod
-- End of method definition for .direction()

------------------------------------------------------------------------
--
-- Method:      length
--
-- Description: Set length
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .length()

   if (!this.length.val.unset() or !this.length.val le 0 ) then
       !this.length.val = !this.line.line.length()
   endif
  -- Get current selection
  !type = !this.positionType.selection()

  -- Origin position
  if(!type eq 'START') then
    !line = !this.line.line.setLengthEnd(!this.length.val)

  -- Start position
  elseif (!type eq 'END') then
    !line = !this.line.line.setLengthStart(!this.length.val)

  -- Centre position
  else

    -- Move line to the centre of the current definition
    !line = !this.line.line.offset(!this.line.line.direction(), !this.line.line.length() / 2)
    !line = !line.setLengthEnd(!this.length.val / 2)
    !line = !line.setLengthStart(!this.length.val)

  endif

  !this.line.line = !line

  -- Redefine unposition gadgets
  !this.updateGadgets()

  -- Update position gadget
  !this.positionType()

  -- Preview line
  !this.preview()

endmethod
-- End of method definition for .length()
