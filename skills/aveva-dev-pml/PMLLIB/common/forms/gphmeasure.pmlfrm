-- File:            gphmeasure.pmlfrm
--   Type:          Form Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Sun Mar 22 16:03:14 WAT 1998
--
--
-- Description:
-- Standard graphical measure form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  changeUnitType()                 -                   Change system of units presented to user
--  close()                          -                   Close form down
--  gphMeasure()                     -                   Constructor
--  initialise()                     -                   Initialisation form
--  perpendicularSetup()             -                   Set form for perpendicular dimension
--  preview()                        -                   Preview the plane
--  selectUnitType()                 -                   Select unit for the measure
--  setMeasure(LINE)                 -                   Set form to passed line (used to define a dimension)
--  setPerpendicular()               -                   Set measure object to perpendicular pick mode
--  setPerpendicularMeasure(ARC)     -                   Set form to passed arc (used to define a perpendicular dimension)
--  setWrt()                         -                   Change wrt
--  setup()                          -                   Setup data for form to be shown for default measure
--  setup(REAL)                      -                   Setup data for form to be shown
--  setupForm()                      -                   Setup form to current grid definition
--  standardSetup()                  -                   Setup form to current grid definition
--  tidy()                           -                   Tidy form data
--
------------------------------------------------------------------------

setup form !!gphMeasure dialog dock resize

  !!gphMeasure.formTitle     = 'Measure Distance'
  !!gphMeasure.iconTitle     = 'Measure Distance'
  !!gphMeasure.callback      = '!this.initialise()'
  !!gphMeasure.formRevision  = ' $Revision: 1.12 $ '

  -- Body of form definition
  vdist 0.25
  path down

  -- Distances
  frame .distanceFrame 'Units' anchor left + top + right
    option .unitSystem  'Unit Type'     anchor left + top + right   at x0.5 ymax  callback '!this.changeUnitType()'   tagwidth 9 width 17
    option .unitDisplay 'Display Unit'  anchor left + top + right                 callback '!this.selectUnitType()'   tagwidth 9 width 17

  exit

  path down
  frame .offsetFrame 'Measure' anchor all

    toggle    .showLinear      ' Show linear dimension' anchor left + top at xmin.unitSystem+9 ymax-0.3 callback '!this.setupForm()' tagwidth 16
    toggle    .perpendicularTo ' Perpendicular To'      anchor left + top at xmin.unitSystem+9 ymax     callback '!this.setPerpendicular()' tagwidth 16
    text      .wrt   'wrt '    anchor left + top + right                             at xmin.unitSystem callback '!this.setWrt()'    tagwidth 9 width 19 is STRING
    textpane  .one   fixchars  anchor all   width 29 height 6

  exit

  -- Dismiss
  button .dismiss 'Close'      anchor bottom + right at xmax form-size ymax+0.25 callback '!this.close()'  width 8 cancel

  -- Form Members
  -- Measurement Object
  member .dimension    is GPHDIMENSION

  -- Aid number being modified
  member .aidDimension is REAL

  -- Aid number
  member .aidNumber    is REAL

  -- remember previous selections
  member .lastMetricSelection   is REAL
  member .lastImperialSelection is REAL

  -- current display format
  member .measureFormat         is FORMAT

exit
-- End of form definition for !!gphMeasure

------------------------------------------------------------------------
--
-- Method:      gphMeasure
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphMeasure()

  -- initialise format object for this form
  !this.measureFormat    = !!distanceFmt

  !white                 = object COLOUR('white')
  !this.one.background   = !white.code
  !this.one.setEditable(false)
  !this.perpendicularTo.val = false
  !this.showLinear.val   = true

  !dTextUnitsSystem[1]   = 'Default'
  !dTextUnitsSystem[2]   = 'Metric'
  !dTextUnitsSystem[3]   = 'Imperial'
  !this.unitSystem.dText = !dTextUnitsSystem

  -- Allocate aid number
  !this.aidNumber        = !!aidNumbers.add('Measuring')

  !this.wrt.val          = 'World'

endmethod
-- End of method definition for .gphMeasure()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- set up units and set up form
  !this.changeUnitType()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:  Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Remove aid numbers
  !this.tidy()

  -- Take rotate edg off the stack
  !!edgCntrl.remove('Define a linear dimension')

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description:  Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidy()

  -- Remove aid numbers
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown for default measure
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup()

  -- Set form data
  !this.aidDimension  = !this.aidNumber
  !this.dimension     = object GPHDIMENSION()

endmethod
-- End of method definition for .setup()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number being modified/created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Set form data
  !this.aidDimension = !aidNumber
  !this.dimension  = object GPHDIMENSION()

endmethod
-- End of method definition for .setup(REAL)

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description: Setup form to current grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupForm()

  -- If plane is unset, then initialise it to default
  if(!this.dimension.coreObject().unset()) then
    !gphDimension         = object GPHDIMENSION()
    !gphDimension.tag     = true
    !gphDimension.detail  = true
    !this.dimension       = !gphDimension
  endif
  !this.dimension.format          = !this.measureFormat
  !this.dimension.dimensionLabel  = ''
  !this.dimension.orthogonalOnly  = !this.showLinear.val.not()

  if( !this.perpendicularTo.val ) then
    !this.perpendicularSetup()
  else
    !this.standardSetup()
  endif

endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:      standardSetup
--
-- Description: Setup form to current grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .standardSetup()

  -- Set distance
  !distance          = !this.dimension.from.distance(!this.dimension.to)

  -- Direction
  if(!distance eq 0) then
    !directionString = '--'
  else
    !direction       = !this.dimension.from.direction(!this.dimension.to).wrt(!this.dimension.wrt)
    !directionString = !direction.string().before('WRT').trim()
  endif

  -- get dimension offsets
  !offset            = !this.dimension.offset()

  -- initialise labels for co-ordinate system
  var !coordinate coordinate
  if(!coordinate.eq('ENU'))then
    !x = |X   |
    !y = |Y   |
    !z = |Z   |
  else
    !x = |U   |
    !y = |V   |
    !z = |W   |
  endif

  -- populate dimension property list
  !dimensionProperties = ARRAY()
  !dimensionProperties[1] = 'Distance   '   + !distance.string(!this.measureFormat)
  !dimensionProperties[2] = 'Offset ' + !x  + !offset[1].string(!this.measureFormat)
  !dimensionProperties[3] = 'Offset ' + !y  + !offset[2].string(!this.measureFormat)
  !dimensionProperties[4] = 'Offset ' + !z  + !offset[3].string(!this.measureFormat)
  !dimensionProperties[5] = 'Direction  '   + !directionString
  !this.one.val = !dimensionProperties

  -- Show Plane
  !this.preview()

endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:      setPerpendicular
--
-- Description: Set measure object to perpendicular pick mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setPerpendicular()

  -- Replace current definition
  if(!this.dimension.coreObject().set()) then
    !this.dimension.setPerpendicular(!this.perpendicularTo.val)
  endif

  !this.wrt.active = !this.perpendicularTo.val.not()

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Replace current definition
  !!aidNumbers.replace(!this.aidNumber, !this.dimension)

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description:  Change wrt
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- Assume world as reference
  if(!wrtItem.unset()) then
    !wrtItem = WORLD
  endif

  -- Set tagging method up
  !this.dimension.wrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

  -- Preview
  !this.setupForm()

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description: Set form to passed line (used to define a dimension)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Dimension line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!line is LINE)

  -- Write the measurement (line is used as this give the from/to positions) to
  -- the gphDimension object
  !this.dimension.setDimension(!line.startPosition, !line.endPosition)

  -- Draw the dimension
  !this.setupForm()

endmethod
-- End of method definition for .setMeasure(LINE)

------------------------------------------------------------------------
--
-- Method:      setPerpendicularMeasure
--
-- Description: Set form to passed arc (used to define a perpendicular dimension)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARC        ARC representing dimension line and plane of dimension
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPerpendicularMeasure(!definition is ARC)

  if( !definition.unset() ) then
    !!alert.warning('Cannot draw dimension line. Perpendicular distance is 0')
    !this.dimension = object GPHDIMENSION()
  else
    -- Write the measurement (arc used to give the from/to positions and plane) to
    -- the gphDimension object
   !this.dimension.setDimension(!definition)
  endif

  -- Draw the dimension
  !this.setupForm()

endmethod
-- End of method definition for .setPerpendicularMeasure(ARC)

------------------------------------------------------------------------
--
-- Method:      perpendicularSetup
--
-- Description: Set form for perpendicular dimension
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .perpendicularSetup()

  -- Set distance
  !from              = !this.dimension.from
  !to                = !this.dimension.to
  !distance          = !from.distance(!to)

  -- Direction
  if(!distance eq 0) then
    !directionString = '--'
  else
    !direction       = !from.direction(!to).wrt(!this.dimension.wrt)
    !directionString = !direction.string().before('WRT').trim()
  endif

  -- calculate horizontal and vertical
  !vertical          = abs(!from.wrt(world).up - !to.wrt(world).up)
  !horizontal        = sqrt(!distance * !distance - !vertical * !vertical)

  -- populate dimension property list
  !dimensionProperties    = ARRAY()
  !dimensionProperties[1] = 'Distance   ' + !distance.string(!this.measureFormat)
  !dimensionProperties[2] = 'Vertical   ' + !vertical.string(!this.measureFormat)
  !dimensionProperties[3] = 'Horizontal ' + !horizontal.string(!this.measureFormat)
  !dimensionProperties[4] = 'Direction  ' + !directionString
  !this.one.val           = !dimensionProperties

  -- Show Plane
  !this.preview()

endmethod
-- End of method definition for .perpendicularSetup()

------------------------------------------------------------------------
--
-- Method:      changeUnitType
--
-- Description: Change system of units presented to user
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .changeUnitType()

  if( !this.unitSystem.val eq 1 ) then
    -- use current distance format
    !this.measureFormat      = !!distanceFmt
    !this.unitDisplay.active = false
    !this.setupForm()
    return
  endif

  !this.unitDisplay.active = true

  !dTextImperial[1] = 'Inch'
  !dTextImperial[2] = 'Feet & Inches'
  !dTextImperial[3] = 'Feet'
  !rTextImperial[1] = 'IN'
  !rTextImperial[2] = 'FINC'
  !rTextImperial[3] = 'FT'
  !dTextMetric[1]   = 'Millimetres'
  !dTextMetric[2]   = 'Centimetres'
  !dTextMetric[3]   = 'Metres'
  !rTextMetric[1]   = 'MM'
  !rTextMetric[2]   = 'CM'
  !rTextMetric[3]   = 'METRE'

  if( !this.unitDisplay.dText.empty() ) then
    !this.lastMetricSelection   = 1
    !this.lastImperialSelection = 1
  endif

  -- set unit system according to current units
  if( !this.unitSystem.val eq 3 ) then
    !this.unitDisplay.dText = !dTextImperial
    !this.unitDisplay.rText = !rTextImperial
    !this.unitDisplay.val   = !this.lastImperialSelection
  else
    !this.unitDisplay.dText = !dTextMetric
    !this.unitDisplay.rText = !rTextMetric
    !this.unitDisplay.val   = !this.lastMetricSelection
  endif

  !this.selectUnitType()

endmethod
-- End of method definition for .changeUnitType()

------------------------------------------------------------------------
--
-- Method:      selectUnitType
--
-- Description: Select unit for the measure
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .selectUnitType()

  !selection          = !this.unitDisplay.selection()
  !this.measureFormat = !!distanceFmt

  -- set unit system according to current units
  if( !this.unitSystem.val eq 3 ) then
    !this.lastImperialSelection = !this.unitDisplay.val
    !formatManager              = object COMFORMATS()
    !this.measureFormat         = !formatManager.distanceFormat(!selection)
  elseif( !this.unitSystem.val eq 2 ) then
    !this.lastMetricSelection   = !this.unitDisplay.val
    !formatManager              = object COMFORMATS()
    !this.measureFormat         = !formatManager.distanceFormat(!selection)
  endif

  !this.setupForm()

endmethod
-- End of method definition for .selectUnitType()
