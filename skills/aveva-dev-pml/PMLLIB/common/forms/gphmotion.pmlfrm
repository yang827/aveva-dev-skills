-- File:            gphmotion.pmlfrm
--   Type:          Object Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Apr 14 11:15:59 WAT 1998
--
--
-- Description:
-- View motion object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  close()                          -                   Close form down
--  gphMotion()                      -                   Constructor
--  initialise()                     -                   Initialisation of the form
--

setup form !!gphMotion

  !this.formTitle     = 'View Motion'
  !this.iconTitle     = ''
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  toggle .zoom    'Zoom'       at x2   ymax states 'false' 'true'
  toggle .wobble  'Wobble'     at xmin ymax states 'false' 'true'
  toggle .rotate  'Rotate'     at xmin ymax states 'false' 'true'

  -- Zoom settings
  text   .zoomVal 'Increment ' at xmax+1         ymin.zoom   width 10 is REAL format !!distanceFmt
  text   .zoomMax 'Max'        at xmax           ymin        width  4 is REAL format !!integerFmt

  -- Spin settings
  text   .spinVal 'Increment ' at xmax.rotate+1  ymin.rotate width  4 is REAL format !!integerFmt

  -- Apply
  button .apply   'Apply'      at xmin form-0    ymax form+0.25 callback '!this.apply()'

  -- Stop the motion
  button .stop    'Stop'       at xcen form-3.5  ymin           callback '!this.initialise()'

  -- Dismiss
  button .dismiss 'Dismiss'    at xmax form-size ymin           callback '!this.close()'

  -- Form Variables
  -- View to control
  member .view   is GADGET

exit
-- End of form definition for !!gphMotion

------------------------------------------------------------------------
--
-- Method:      gphMotion
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphMotion()

  -- Initialise Variables
  !this.view        = !!gph3DDesign1.view
  !this.zoomVal.val = 100mm
  !this.zoomMax.val = 4
  !this.spinVal.val = 1

endmethod
-- End of method definition for .gphMotion()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Initialise Variables
  !this.stop.active = false

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise Variables
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables
  !dirAngle         = 45
  !elevAngle        = 35
  !elevIncrement    = 1
  !upper            = 60
  !lower            = -10
  !viewRadius       = !this.view.radius
  !viewDirection    = !this.view.direction

  !radius           = !viewRadius
  !radiusIncrement  = !this.zoomVal.val
  !viewRadiusMax    = !viewRadius * !this.zoomMax.val
  !viewRadiusMin    = !viewRadius * 0.9

  -- If there is no setting, don't do anything
  if(!this.wobble.val.not() and !this.rotate.val.not() and !this.zoom.val.not()) then
    return
  endif

  -- Elevation angle
  !direction        = object DIRECTION('N')
  !direction.east   = !viewDirection[1]
  !direction.north  = !viewDirection[2]
  !direction.up     = !viewDirection[3]

  -- Direction projected onto a Horizontal Plane
  !plane            = object PLANE(N0, Y is N)
  !planeDirection   = !direction.projected(!plane)

  -- Calculate elevation angle
  !elevAngle        = !planeDirection.angle(!direction)

  -- Calculate direction angle
  !dirAngle         = !direction.angle(!plane.orientation.ydir())

  -- Setup interrupt
  !!fmSys.setInterrupt(!this.stop)
  !this.stop.active = true
  REFRESH
  !j = 0
  do !i
    !j = !j + !i

    -- Break
    break if(!!fmSys.interrupt())
    REFRESH

    -- View Rotate Direction
    if(!this.rotate.val) then
      !dirAngle        = !dirAngle + !this.spinVal.val
    endif

    -- View Wobble
    if(!this.wobble.val) then
      !elevAngle       = !elevAngle + !elevIncrement

      if(!elevAngle gt !upper) then
        !elevIncrement = -1
      elseif (!elevAngle lt !lower) then
        !elevIncrement = 1
      endif

    endif

    if(!this.rotate.val or !this.wobble.val) then
      !direction       = N $!dirAngle E $!elevAngle D
      !array[1]        = !direction.east
      !array[2]        = !direction.north
      !array[3]        = !direction.up
      !this.view.direction = !array
    endif

    -- View Radius
    if(!this.zoom.val) then
      !radius          = !radius + !radiusIncrement
      if(!radius gt !viewRadiusMax) then
        !radiusIncrement = -1 * !this.zoomVal.val
      elseif (!radius lt !viewRadiusMin) then
        !radiusIncrement = !this.zoomVal.val
      endif
      !this.view.radius = !radius
    endif

  enddo
  PROMPT DISMISS

  !this.view.direction = !viewDirection
  !this.view.radius    = !viewRadius

endmethod
-- End of method definition for .apply()
