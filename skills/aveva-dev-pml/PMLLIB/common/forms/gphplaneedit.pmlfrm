--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Feb 4 10:17:53 WAT 1998
--
--
-- Description:
-- Graphic plane definition.
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Action carried out on applying form
--  close()                          -                   Close form and tidy
--  gphPlaneEdit()                   -                   Constructor
--  initialise()                     -                   Constructor
--  pickOrientation(STRING)          -                   Setup to define orientation using edg
--  preview()                        -                   Preview the plane
--  setWrt()                         -                   Set up with new wrt item
--  setup(REAL)                      -                   Setup data for form to be shown
--  setup(STRING,STRING,GPHPLANE)    -                   Setup data for form to be shown
--  setupForm()                      -                   Setup form to current grid definition
--  tidy()                           -                   Close form and tidy
--  updateAid(REAL)                  -                   Update/create passed aid number with plane definition
--
------------------------------------------------------------------------

-- Define form
setup form !!gphPlaneEdit

  !!gphPlaneEdit.formTitle     = 'Define Plane'
  !!gphPlaneEdit.iconTitle     = 'PlaneDef'
  !!gphPlaneEdit.callback      = '!this.initialise()'
  !!gphPlaneEdit.formRevision  = ' $Revision: 1.10 $ '

  -- Body of form definition

  -- Options
  frame .optionFrame 'Options' at x0.5 ymax
    -- Tagging
    toggle .label  ' Label ' at x2    ymax callback '!this.preview()' states 'FALSE' 'TRUE'
    toggle .detail ' Axes'   at xmin  ymax callback '!this.preview()' states 'FALSE' 'TRUE'
    toggle .filled ' Filled' at xmin  ymax callback '!this.preview()' states 'FALSE' 'TRUE'

    frame .sizeFrame 'Size' at xmax.label+2 ymin.label
      text .xSize 'X ' at x1   ymax callback '!this.preview()' width 14  is REAL format !!distanceFmt
      text .ySize 'Y ' at xmin ymax callback '!this.preview()' width 14  is REAL format !!distanceFmt
    exit
  exit

  -- Positioning Gadgets
  frame .posOriFrame 'Position & Orientation' at xmin ymax+0.2
    -- Positioning Gadgets
    frame .positionFrame 'Position' at x1 ymax
      path down
      option .ew at x1 y1.5 width 5
      option .ns width 5
      option .ud width 5
      text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
      text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
      text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
      toggle .xFlag at xmax+1 ymin.ew
      toggle .yFlag at xmin   ymin.ns
      toggle .zFlag at xmin   ymin.ud

      para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'
    exit

    -- Orientation Gadgets and Setting
    frame .orientationFrame 'Orientation' at xmin ymax

      -- EDG Set orientation
      button .edgOri3 pixmap width 24 height 24 tooltip 'Through three points' callback '!this.pickOrientation(''3picks'')'
      path right
      button .edgOri2 pixmap width 24 height 24 tooltip 'Through origin and two points'   callback '!this.pickOrientation(''2picks'')'

      text .yDir 'Y is ' at x1   ymax+0.25 width 24 is STRING
      text .zDir 'Z is ' at xmin ymax width 24 is STRING
      halign right
      path down
      paragraph .xDir width 31 lines 1
      halign left
    exit
  exit

  --  Reference (wrt)
  halign right
  text .wrt 'wrt' callback '!this.setWrt()' width 26 string

  -- Apply/Dismiss
  button .apply   ' OK '   at xmin form-0    ymax form+0.25 callback '!this.apply()' ok
  button .dismiss 'Cancel' at xmax form-size ymin           callback '!this.close()' cancel

  -- Form Members
  -- Plane definition
  member .plane        is GPHPLANE

  -- Aid number being modified
  member .aidPlane     is REAL

  -- Aid numbers for position & axes
  member .aidNumber    is REAL

  -- Form Control Members
  -- Position
  member .position     is POSITIONLINK
  -- Orientation
  member .orientation  is ORIENTATIONLINK

  -- Plane Size
  member .planeSize    is REAL
  !!gphPlaneEdit.planeSize = 5000mm

  -- Description
  member .description  is STRING
  !!gphPlaneEdit.description = 'Default Plane Definition'

  -- Action on apply
  member .action       is STRING

exit
-- End of form definition for !!gphPlaneEdit

------------------------------------------------------------------------
--
-- Method:      gphPlaneEdit
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPlaneEdit()

  -- set icons
  !this.edgOri3.addPixmap(!!pml.getPathName('ori3points24.png'))
  !this.edgOri2.addPixmap(!!pml.getPathName('ori2points24.png'))

   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!gphPlaneEdit.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!gphPlaneEdit.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!gphPlaneEdit.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!gphPlaneEdit.preview()')

  -- Link Orientation Gadgets to Object
  !this.orientation.linkInput('!!gphPlaneEdit.orientation', 'Y', !this.yDir, 'Z', !this.zDir, 'X', !this.xDir)

  -- Set Orientation Action
  !this.orientation.setAction('!!gphPlaneEdit.preview()')

  -- Aid Lines Number
  if(!this.aidNumber.unset()) then
    !this.aidNumber = !!aidNumbers.add(!this.plane)
  endif

endmethod
-- End of method definition for .gphPlaneEdit()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Link Position Option Gadgets to Objects with current coordinate system
  var !coordinate coordinate
  !this.position.linkOption('!!gphPlaneEdit.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Actions to null so nothing happens
  !this.position.setAction('')
  !this.orientation.setAction('')

  -- Setup form
  !this.setupForm()

  -- Redefine Actions
  !this.position.setAction('!!gphPlaneEdit.preview()')
  !this.orientation.setAction('!!gphPlaneEdit.preview()')

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description:
--   Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)
  !this.orientation.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Hide Modification Plane
  !this.tidy()

  -- Revert the edg graphics back
  !!edgCntrl.remove(!this.plane.description)

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description:
--   Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide Modification Plane
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Action carried out on applying form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Current Data
  !position    = !this.position.get()
  !orientation = !this.orientation.get()

  -- Write data to plane member
  !this.plane.x      = !this.xSize.val
  !this.plane.y      = !this.ySize.val
  !this.plane.tag    = !this.label.val
  !this.plane.detail = !this.detail.val
  !this.plane.filled(!this.filled.val)
  !this.plane.position(!position)
  !this.plane.orientation(!orientation)

  -- Modifying an aid or carry out an action
  if(!this.aidPlane.set()) then
    !!aidNumbers.replace(!this.aidPlane, !this.plane)

  -- Carry out action
  else
    $!this.action
  endif

  -- Close
  !this.close()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number being modified/created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Initialise form action
  !this.action            = STRING()

  -- Set form data
  !this.aidPlane          = !aidNumber
  !this.formTitle         = 'Modify plane [' & !aidNumber & ']'
  !this.plane             = !!aidNumbers.numbers[!aidNumber]

  -- Handle unset descriptions
  if(!this.plane.description.unset()) then
    !this.plane.description  = 'Plane Definition [' & !aidNumber & ']'
  endif

endmethod
-- End of method definition for .setup(REAL)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Form title
--    2   R      STRING      Action to be carried out on apply
--    3   R      GPHPLANE    Basic definition
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!description is STRING, !actionCommand is STRING, !newPlane is GPHPLANE)

  -- Define Action on apply
  !this.action            = !actionCommand

  -- Set form data
  !this.aidPlane          = REAL()
  !this.plane             = !newPlane
  !this.formTitle         = !description
  !this.plane.description = !description

endmethod
-- End of method definition for .setup(STRING, STRING, GPHPLANE)

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description:
--   Setup form to current grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupForm()

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- If plane is unset, then initialise it to default 000
  if(!this.plane.coreObject().unset()) then
    !plane = object PLANE(N0, Y is N)
    !gphPlane             = object GPHPLANE(!plane)
    !gphPlane.tag         = true
    !gphPlane.detail      = true
    !gphPlane.description = !this.plane.description
    !gphPlane.filled(true)
    !this.plane           = !gphPlane
  endif

  !plane = !this.plane.coreObject()

  -- Set with respect to
  !this.position.setWrt(!plane.position.origin)
  !this.orientation.setWrt(!plane.position.origin)

  -- Load form with plane definition
  !this.position.setPositionForce(!plane.position)
  !this.orientation.setOrientation(!plane.orientation)

  -- Set form wrt gadget
  !this.setWrt()

  -- Set Option gadget of form
  !this.xSize.val  = !this.plane.x
  !this.ySize.val  = !this.plane.y
  !this.label.val  = !this.plane.tag
  !this.detail.val = !this.plane.detail
  !this.filled.val = !this.plane.filled()

  -- Show Plane
  !this.preview()

endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description:
--   Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Current Data
  !position    = !this.position.get()
  !orientation = !this.orientation.get()

  -- Check values
  if (!this.xSize.val.unset() or !this.xSize.val le 0) then
      !this.xSize.val = !this.plane.x
  endif
  if (!this.ySize.val.unset() or !this.ySize.val le 0) then
      !this.ySize.val = !this.plane.y
  endif

  -- Write data to plane member
  !this.plane.x      = !this.xSize.val
  !this.plane.y      = !this.ySize.val
  !this.plane.tag    = !this.label.val
  !this.plane.detail = !this.detail.val
  !this.plane.filled(!this.filled.val)
  !this.plane.position(!position)
  !this.plane.orientation(!orientation)

  -- Replace current definition
  !!aidNumbers.replace(!this.aidNumber, !this.plane)

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      pickOrientation
--
-- Description:
--   Setup to define orientation using edg
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Ori definition type  3picks
--                                                2picks
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pickOrientation(!type is STRING)

  -- Define a pickpacket
  !packet          = object EDGPACKET()
  !packet.orientationLink('!!gphPlaneEdit.orientation', 'Orientate Plane')

  -- Two pick plane
  if(!type.upcase() eq '2PICKS') then
    -- Define specific for "gphPlaneEdit" orientation
    !packet.pickPacket.plane2Pnts(!this.position.get())
  endif

  !packet.remove   = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickOrientation(STRING)

------------------------------------------------------------------------
--
-- Method:      updateAid
--
-- Description:
--   Update/create passed aid number with plane definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateAid(!aidNumber is REAL)

  -- Update aid system
  !!aidNumbers.replace(!aidNumber, !this.plane)

endmethod
-- End of method definition for .updateAid(REAL)
