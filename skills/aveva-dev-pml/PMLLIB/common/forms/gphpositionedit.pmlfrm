-- File:            gphpositionedit.pmlfrm
--   Type:          Form Definition
--   Group:         Aid element handlers
--     Keyword:     AID
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon May 11 09:54:01 WAT 1998
--
--
-- Description:
-- Graphic position definition
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Action carried out on applying form
--  close()                          -                   Close form and tidy
--  gphPositionEdit()                -                   Constructor
--  initialise()                     -                   Initialise form
--  preview()                        -                   Preview the plane
--  setWrt()                         -                   Set up with new wrt item
--  setup(REAL)                      -                   Setup data for form to be shown
--  tidy()                           -                   Tidy form data
--  updateAid(REAL)                  -                   Update/create passed aid number with plane definition
--
------------------------------------------------------------------------

setup form !!gphPositionEdit

  !!gphPositionEdit.formTitle     = 'Modify Working Point'
  !!gphPositionEdit.iconTitle     = 'WorkPnt'
  !!gphPositionEdit.callback      = '!this.initialise()'
  !!gphPositionEdit.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition

  -- Positioning Gadgets
  frame .positionFrame 'Position' width 34

    path down
    option .ew at x1 y1.5 width 5
    option .ns width 5
    option .ud width 5
    text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
    text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
    text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
    toggle .xFlag at xmax+1 ymin.ew
    toggle .yFlag at xmin   ymin.ns
    toggle .zFlag at xmin   ymin.ud

    --  Reference (wrt)
    halign right
    text .wrt 'wrt' callback '!this.setWrt()' width 20 string

    para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'
  exit

  -- Apply/Dismiss
  button .apply   ' OK '   at xmin form-0    ymax form+0.25 callback '!this.apply()' ok
  button .dismiss 'Cancel' at xmax form-size ymin           callback '!this.close()' cancel

  -- Form Members
  -- Position definition
  member .workPoint    is GPHPOSITION

  -- Aid number being modified
  member .aidPosition  is REAL

  -- Aid numbers for position & axes
  member .aidNumber    is REAL

  -- Form Control Members
  -- Position
  member .position     is POSITIONLINK

exit
-- End of form definition for !!gphPositionEdit

------------------------------------------------------------------------
--
-- Method:      gphPositionEdit
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphPositionEdit()


   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!gphPositionEdit.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!gphPositionEdit.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!gphPositionEdit.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!gphPositionEdit.preview()')

  -- Aid Lines Number
  if(!this.aidNumber.unset()) then
    !this.aidNumber = !!aidNumbers.add(!this.workPoint)
  endif

endmethod
-- End of method definition for .gphPositionEdit()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Link Position Option Gadgets to Objects with Current coordinate system
  var !coordinate coordinate
  !this.position.linkOption('!!gphPositionEdit.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- Set with respect to
  !this.setWrt()

  -- Get current definition
  !position = !this.workPoint.coreObject()

  -- Unset object definition
  if(!position.unset()) then
    !position                = N0
    !this.workPoint.position = !position
  endif

  -- Set tagging
  !this.workPoint.description = 'New Position'
  !this.workPoint.tag         = true

  -- Set Position
  !this.position.setPositionNoAct(!position)

  -- Draw circle
  !this.preview()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Action carried out on applying form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Set tagging
  !this.workPoint.description = !!aidNumbers.numbers[!this.aidPosition].description
  !this.workPoint.tag         = !!aidNumbers.numbers[!this.aidPosition].tag
  !this.workPoint.diameter    = !!aidConstructors.blobSize

  -- Update Graphics
  !!aidNumbers.replace(!this.aidPosition, !this.workPoint)

  -- Close
  !this.close()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Tidy form data
  !this.tidy()

  -- Remove event
  !!edgCntrl.remove('Edit aid position definition')

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide Modification Plane
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number being modified/created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Set form data
  !this.aidPosition = !aidNumber
  !this.formTitle   = 'Modify Work Point [' & !aidNumber & ']'
  !this.workPoint   = !!aidNumbers.numbers[!aidNumber]

endmethod
-- End of method definition for .setup(REAL)

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Get position
  !this.workPoint.position = !this.position.get()
  !this.workPoint.diameter = !!aidConstructors.blobSize

  -- Replace current definition
  !!aidNumbers.replace(!this.aidNumber, !this.workPoint)

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      updateAid
--
-- Description: Update/create passed aid number with plane definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateAid(!aidNumber is REAL)

  -- Update aid system
  !!aidNumbers.replace(!aidNumber, !this.plane)

endmethod
-- End of method definition for .updateAid(REAL)
