--
-- File:            gphrepdflts.pmlfrm
--   Type:          Form Definition
--   Group:         General Application

--     Keyword:     GEN
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Apr 6 12:21:26 BST 1999
--
--
-- Description:
--   Representation default for level and obstructions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  close()                          -                   Close for down
--  gphRepDflts()                    -                   Constructor
--  setup(GPHREPDEFINITION,STRING,BOOLEAN) -                   Setup form
--
------------------------------------------------------------------------

setup form !!gphRepDflts

  !this.formTitle     = 'Representation'
  !this.iconTitle     = ''
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition

  -- Description
  option .description 'Description ' at xmin y0.2 tooltip 'Predefined representation settings' callback '!this.predefined()' width 22

  -- Level & Obstruction
  frame .levelObstFrame 'Settings' at xmin ymax
    text .from 'Levels' tooltip 'Lower drawing level' width 2 is REAL
    hdist 0
    text .to            tooltip 'Upper drawing level' width 2 is REAL
    hdist 1
    option .obstruction 'Obstruction' tooltip 'Obstruction value' callback '!this.obstruction()' width 4
  exit

  -- Bottom Line
  button .apply   'Apply'   at xmin form-0    ymax+0.25 callback '!this.apply()'
  button .dismiss 'Dismiss' at xmax form-size ymin      callback '!this.close()'

  -- Form Members

  -- Action carried out on apply
  member .action  is STRING

  -- Form OK/CANCEL
  member .ok      is BOOLEAN

  -- Graphical Representation Link object
  member .link    is GPHREPLINK

exit
-- End of form definition for !!gphRepDflts

------------------------------------------------------------------------
--
-- Method:      gphRepDflts
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphRepDflts()

  -- Initialise Variables

  -- Link gadgets
  !this.link.obstruction(!this.obstruction)
  !this.link.level(!this.from, !this.to)
  !this.link.predefined(!this.description)
  !this.link.setup()

endmethod
-- End of method definition for .gphRepDflts()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GPHREPDEFINITION Representation definition to setup with
--    2   R      STRING       Action to carry out
--    3   R      BOOLEAN      True for OK/CANCEL command
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!representation is GPHREPDEFINITION, !action is STRING, !ok is BOOLEAN)

  -- Initialise Variables
  !this.action = !action
  !this.ok     = !ok

  -- OK/CANCEL
  if(!ok) then
    !this.apply.tag   = ' OK '
    !this.dismiss.tag = 'Cancel'
  else
    !this.apply.tag   = 'Apply'
    !this.dismiss.tag = 'Dismiss'
  endif

  -- Setup representation
  !this.link.setup(!representation)

  -- Show form
  !this.show()

endmethod
-- End of method definition for .setup(GPHREPDEFINITION, STRING, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close for down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise Variables
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Initialise Variables
  !representation = !this.link.representation()

  -- Carry out action
  $!<this.action>
  handle any
    !!alert.warning(!!error.text)

  elsehandle none

    -- Close form down
    if(!this.ok) then
      !this.hide()
    endif
  endhandle

endmethod
-- End of method definition for .apply()
