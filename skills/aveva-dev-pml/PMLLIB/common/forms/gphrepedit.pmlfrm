--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Dec 15 18:19:40 GMT 1997
--
--
-- Description:
-- form to edit representation options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  gphRepEdit()                     -                   Constructor
--  init()                           -                   form initialisation
--  insulation(REAL)                 -                   action for insulation callback
--  load()                           -                   load the defaults
--  obstruction(REAL)                -                   action for obstruction callback
--  ok()                             -                   action for ok callback
--  save()                           -                   save the defaults
--
------------------------------------------------------------------------

-- Define form
setup form !!gphRepEdit

  !!gphRepEdit.formTitle     = 'Representation'
  !!gphRepEdit.iconTitle     = 'Representation'
  !!gphRepEdit.callback      = '!!gphRepEdit.init()'
  !!gphRepEdit.formRevision  = ' $Revision: 1.12 $ '

  -- local form data store
  member .data is GPHREPOPT

  -- Body of form definition
  bar
    add 'File' .fileMenu
  exit

  -- General settings
  frame .general 'General'               at xmin       ymax
    toggle .tubeG        'Tube '         at x7         ymax
    toggle .centrelineG  'Centreline '   at xmin       ymax

    option .insulationG                  at x1         ymax tooltip 'Insulation visibility/translucency'  width 5
    path down
    halign right
    option  .obstructionG                                   tooltip 'Obstruction visibility/translucency' width 5

    paragraph .insulationT  at xmax.insulationG  ymin.insulationG  text 'Insulation'
    paragraph .obstructionT at xmax.obstructionG ymin.obstructionG text 'Obstruction'

    toggle .holesG       'Holes Drawn'   at xmin.tubeG ymax

    frame .darc          'Arc Tolerance' at x2         ymax
      text   .arcToleranceG ''           at xmin+2     ymax     width 14 is REAL format !!distanceFmt
    exit
  exit

  -- Specific settings
  frame .others 'Specific'               at xmin       ymax width 40
    button .steelworkG   'Steel... '     at xmin+2     ymax
    button .pPointsG     'Ppoint...'     at xmax+3     ymin
    button .pLinesG      'Pline... '     at xmax+3     ymin
  exit

  -- Drawing levels
  frame .level 'Level'                   at xmax.general+1 ymin.general
    text .pipeLevelG     'Pipe '         at xmin+7         ymax width 3 is REAL
    path down
    halign right
    text .nozzLevelG     'Nozzle '     width 3 is REAL
    text .struLevelG     'Structure '  width 3 is REAL
    text .generalLevelG  'Others '     width 3 is REAL
    text .massLevelG     'Mass '       width 3 is REAL
  exit

  toggle .update 'update all Graphics' at x2  ymax.others

  button .ok     '  OK  ' at x0             ymax ok
  button .cancel 'Cancel' at xmax form-size ymin     cancel

exit
-- End of form definition for !!gphRepEdit

------------------------------------------------------------------------
--
-- Method:      !gphRepEdit()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .gphRepEdit()

  -- Obstruction and Insulation
  !dtext    = ARRAY()
  !rtext    = ARRAY()
  !dtext.append('Off')
  !rtext.append('-1')
  !dtext.append('Solid')
  !rtext.append('0')
  !dtext.append('12%')
  !rtext.append('12')
  !dtext.append('25%')
  !rtext.append('25')
  !dtext.append('50%')
  !rtext.append('50')
  !dtext.append('75%')
  !rtext.append('75')
  !dtext.append('87%')
  !rtext.append('87')
  !this.insulationG.dtext      = !dtext
  !this.insulationG.rtext      = !rtext
  !this.obstructionG.dtext     = !dtext
  !this.obstructionG.rtext     = !rtext
  !this.insulationG.callback   = '!this.insulation(!this.insulationG.selection(|RTEXT|).real())'
  !this.obstructionG.callback  = '!this.obstruction(!this.obstructionG.selection(|RTEXT|).real())'

  -- build menu bar
  !this.newMenu('fileMenu')
  !this.fileMenu.add('callback', 'Save', '!!gphRepEdit.save()')
  !this.fileMenu.add('callback', 'Load', '!!gphRepEdit.load()')

  -- define callbacks
  !this.tubeG.callback         = '!!gphRepEdit.data.tube(!!gphRepEdit.tubeG.val)'
  !this.centrelineG.callback   = '!!gphRepEdit.data.centreline(!!gphRepEdit.centrelineG.val)'
  !this.holesG.callback        = '!!gphRepEdit.data.holes(!!gphRepEdit.holesG.val)'
  !this.arcToleranceG.callback = '!!gphRepEdit.data.arcTolerance(!!gphRepEdit.arcToleranceG.val)'

  !this.steelworkG.callback    = 'show !!gphRepSteelEdit'
  !this.pPointsG.callback      = 'show !!gphRepPointEdit'
  !this.pLinesG.callback       = 'show !!gphRepPlineEdit'

  !this.pipeLevelG.callback    = '!!gphRepEdit.data.pipeLevel(!!gphRepEdit.pipeLevelG.val)'
  !this.nozzLevelG.callback    = '!!gphRepEdit.data.nozzLevel(!!gphRepEdit.nozzLevelG.val)'
  !this.struLevelG.callback    = '!!gphRepEdit.data.struLevel(!!gphRepEdit.struLevelG.val)'
  !this.generalLevelG.callback = '!!gphRepEdit.data.generalLevel(!!gphRepEdit.generalLevelG.val)'
  !this.massLevelG.callback    = '!!gphRepEdit.data.massLevel(!!gphRepEdit.massLevelG.val)'

  !this.okCall                 = '!!gphRepEdit.ok()'

endmethod
-- End of method definition for .gphRepEdit()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  -- copy the current global settings and unset the global flag
  !this.data = !!gphRepOpt.localCopy()

  -- initialise form gadgets to main data settings,
  !this.pipeLevelG.val    = !this.data.pipeLevel()
  !this.nozzLevelG.val    = !this.data.nozzLevel()
  !this.struLevelG.val    = !this.data.struLevel()
  !this.generalLevelG.val = !this.data.generalLevel()
  !this.massLevelG.val    = !this.data.massLevel()

  !this.tubeG.val         = !!gphRepEdit.data.tube()
  !this.centrelineG.val   = !!gphRepEdit.data.centreline()
  !this.holesG.val        = !this.data.holes()
  !this.arcToleranceG.val = !this.data.arcTolerance()

  -- Set insulation
  if(!this.data.insulation()) then
    if(!this.data.insulationTrans().set()) then
      !insulationValue   = !this.data.insulationTrans()
    else
      !insulationValue   = 0
    endif
  else
    !insulationValue     = -1
  endif
  !this.insulationG.select('RTEXT', !insulationValue.string())

  -- Set obstruction
  if(!this.data.obstruction()) then
    if(!this.data.obstructionTrans().set()) then
      !obstructionValue  = !this.data.obstructionTrans()
    else
      !obstructionValue = 0
    endif
  else
    !obstructionValue   = -1
  endif
  !this.obstructionG.select('RTEXT', !obstructionValue.string())

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: save the defaults
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .save()

  -- save all the data
  !this.data.save()

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load the defaults
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- load the data
  !this.data.load()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: action for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- set all the global representation options
  !this.data.copyToGlobal()

  -- update the representation if requested
  if (!this.update.val) then
    !!gphRepOpt.update()
  endif

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      !insulation(REAL)
--
-- Description: action for insulation callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .insulation(!value is REAL)

  -- Initialise Variables

  if(!value lt 0) then
    !this.data.insulation(false)
  elseif (!value eq 0) then
    !this.data.insulation(true)
  elseif (!value gt 0) then
    !this.data.insulationTrans(!value)
  endif

endmethod
-- End of method definition for .insulation(REAL)

------------------------------------------------------------------------
--
-- Method:      !obstruction(REAL)
--
-- Description: action for obstruction callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .obstruction(!value is REAL)

  -- Initialise Variables
  if(!value lt 0) then
    !this.data.obstruction(false)
  elseif (!value eq 0) then
    !this.data.obstruction(true)
  elseif (!value gt 0) then
    !this.data.obstructionTrans(!value)
  endif

endmethod
-- End of method definition for .obstruction(REAL)
