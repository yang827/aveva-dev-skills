-- File:            gphreppipeedit.pmlfrm
--   Type:          Form Definition
--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Dec 15 18:23:22 GMT 1997
--
--
-- Description:
-- edit form for representation nodes options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  gphRepPipeEdit()                 -                   Constructor
--  init()                           -                   form initialisation
--  ok()                             -                   method for ok callback
--
------------------------------------------------------------------------

-- Define form
setup form !!gphRepPipeEdit

  !!gphRepPipeEdit.formTitle     = 'Pipe Representation'
  !!gphRepPipeEdit.iconTitle     = 'Pipe Representation'
  !!gphRepPipeEdit.callback      = '!!gphRepPipeEdit.init()'
  !!gphRepPipeEdit.formRevision  = ' $Revision: 1.7 $ '

  -- owning form, it is necessary to store this as a form member, as .owner()
  -- does not work in a method that is run, after the form is hidden e.g. .ok()
  member .main is FORM

  -- Body of form definition
  frame .pipeFrame 'Pipe' at xmin ymax
    toggle .pipeTubeG 'Tube       ' at xmin+1 ymax
    toggle .pipeClG   'Centreline ' at xmin ymax+0.1
    toggle .pipeInsuG 'Insulation ' at xmax.pipeTubeG+2 ymin.pipeTubeG
    toggle .pipeObstG 'Obstruction' at xmin.pipeInsuG ymin.pipeClG
  exit

  button .ok     '  OK  ' at xmin ymax+0.4 ok
  button .cancel 'Cancel' at xmax form-size ymin cancel

exit
-- End of form definition for !!gphRepPipeEdit

------------------------------------------------------------------------
--
-- Method:      !gphRepPipeEdit()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .gphRepPipeEdit()

  -- define callbacks
  !this.okCall = '!!gphRepPipeEdit.ok()'

endmethod
-- End of method definition for .gphRepPipeEdit()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  -- set link to owning form
  !this.main = !this.owner()

  -- initialise form gadgets to main data settings,
  !this.pipeTubeG.val = !this.main.data.pipeTube()
  !this.pipeClG.val   = !this.main.data.pipeCl()
  !this.pipeInsuG.val = !this.main.data.pipeInsu()
  !this.pipeObstG.val = !this.main.data.pipeObst()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: method for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- set the local representation options
  !this.main.data.pipeTube(!this.pipeTubeG.val)
  !this.main.data.pipeCl(!this.pipeClG.val)
  !this.main.data.pipeInsu(!this.pipeInsuG.val)
  !this.main.data.pipeObst(!this.pipeObstG.val)

endmethod
-- End of method definition for .ok()
