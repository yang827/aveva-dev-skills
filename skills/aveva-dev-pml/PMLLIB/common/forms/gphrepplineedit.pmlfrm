-- File:            gphrepplineedit.pmlfrm
--   Type:          Form Definition
--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Dec 15 18:23:57 GMT 1997
--
--
-- Description:
-- edit for representation ppoint options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  gphRepPlineEdit()                -                   constructor
--  init()                           -                   form initialisation
--  ok()                             -                   method for ok callback
--
------------------------------------------------------------------------

-- Define form
setup form !!gphRepPlineEdit

  !!gphRepPlineEdit.formTitle     = 'Pline Representation'
  !!gphRepPlineEdit.iconTitle     = 'Pline Representation'
  !!gphRepPlineEdit.callback      = '!!gphRepPlineEdit.init()'
  !!gphRepPlineEdit.formRevision  = ' $Revision: 1.10 $ '

  -- owning form, it is necessary to store this as a form member, as .owner()
  -- does not work in a method that is run, after the form is hidden e.g. .ok()
  member .main is FORM

  -- Body of form definition
  frame .pLinesFrame 'Ppoints' at xmin ymax
    toggle .pLinesG 'Display' at xmin+1 ymax
    toggle .pLinesPkeyG  'Pkey   ' at xmin ymax+0.2
    text   .pLinesLengthG 'Length' at xmax+4 ymin width 12 is REAL format !!distanceFmt
  exit

  button .ok     |  OK  | at xmin ymax+0.4 callback |!!gphRepPlineEdit.ok()| ok
  button .cancel |Cancel| at xmax form-size ymin cancel

exit
-- End of form definition for !!gphRepPlineEdit

------------------------------------------------------------------------
--
-- Method:      !gphRepPlineEdit()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .gphRepPlineEdit()

  -- define callbacks
  !this.okCall = '!!gphRepPlineEdit.ok()'

endmethod
-- End of method definition for .gphRepPlineEdit()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  -- set link to owning form
  !this.main = !!gphRepPlineEdit.owner()

  -- initialise form gadgets to main data settings,
  !this.pLinesG.val       = !this.main.data.pLines()
  !this.pLinesPkeyG.val   = !this.main.data.pLinesPkey()
  !pLinesLength = !this.main.data.pLinesLength()
  !this.pLinesLengthG.val = $!<pLinesLength>

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: method for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- set the local representation options
  !this.main.data.pLines(!this.pLinesG.val)
  !this.main.data.pLinesPkey(!this.pLinesPkeyG.val)
  !this.main.data.pLinesLength(!this.pLinesLengthG.val)

endmethod
-- End of method definition for .ok()
