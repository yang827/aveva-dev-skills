-- File:            gphreppointedit.pmlfrm
--   Type:          Form Definition
--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Dec 15 18:23:57 GMT 1997
--
--
-- Description:
-- edit for representation ppoint options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  gphRepPointEdit()                -                   constructor
--  init()                           -                   form initialisation
--  ok()                             -                   method for ok callback
--
------------------------------------------------------------------------

-- Define form
setup form !!gphRepPointEdit

  !!gphRepPointEdit.formTitle     = 'Ppoint Representation'
  !!gphRepPointEdit.iconTitle     = 'Ppoint Representation'
  !!gphRepPointEdit.callback      = '!!gphRepPointEdit.init()'
  !!gphRepPointEdit.formRevision  = ' $Revision: 1.10 $ '

  -- owning form, it is necessary to store this as a form member, as .owner()
  -- does not work in a method that is run, after the form is hidden e.g. .ok()
  member .main is FORM

  -- Body of form definition
  frame .pPointsFrame 'Ppoints' at xmin ymax
    toggle .pPointsG 'Display' at xmin+1 ymax
    toggle .pPointsNumbersG  'Numbers' at xmin ymax+0.2
    text   .pPointsLengthG 'Length' at xmax+4 ymin width 12 is REAL format !!distanceFmt
  exit

  button .ok     |  OK  | at xmin ymax+0.4 callback |!!gphRepPointEdit.ok()| ok
  button .cancel |Cancel| at xmax form-size ymin cancel

exit
-- End of form definition for !!gphRepPointEdit

------------------------------------------------------------------------
--
-- Method:      !gphRepPointEdit()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .gphRepPointEdit()

  -- define callbacks
  !this.okCall = '!!gphRepPointEdit.ok()'

endmethod
-- End of method definition for .gphRepPointEdit()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  -- set link to owning form
  !this.main = !this.owner()

  -- initialise form gadgets to main data settings,
  !this.pPointsG.val        = !this.main.data.pPoints()
  !this.pPointsNumbersG.val = !this.main.data.pPointsNumbers()
  !pPointsLength = !this.main.data.pPointsLength()
  !this.pPointsLengthG.val  = $!<pPointsLength>

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: method for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- set the local representation options
  !this.main.data.pPoints(!this.pPointsG.val)
  !this.main.data.pPointsNumbers(!this.pPointsNumbersG.val)
  !this.main.data.pPointsLength(!this.pPointsLengthG.val)

endmethod
-- End of method definition for .ok()
