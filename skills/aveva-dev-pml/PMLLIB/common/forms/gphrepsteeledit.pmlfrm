--
-- File:            gphrepsteeledit.pmlfrm
--   Type:          Form Definition
--   Group:         Option file routines
--     Keyword:     OPT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Dec 15 18:22:54 GMT 1997
--
--
-- Description:
-- edit for steelwork representation options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  gphRepSteelEdit()                -                   constructor
--  init()                           -                   form initialisation
--  obstruction(REAL)                -                   action for obstruction callback
--  ok()                             -                   ok action for form
--  pNodesColour()                   -                   action for the pnodes colour selection gadget
--  snodesColour()                   -                   action for the snodes colour selection gadget
--
------------------------------------------------------------------------

-- Define form
setup form !!gphRepSteelEdit

  -- local form data store
  member .data is GPHREPOPT

  -- Body of form definition
  !!gphRepSteelEdit.formTitle     = 'Steelwork Representation'
  !!gphRepSteelEdit.iconTitle     = 'Steelwork Representation'
  !!gphRepSteelEdit.callback      = '!!gphRepSteelEdit.init()'
  !!gphRepSteelEdit.formRevision  = ' $Revision: 1.11 $ '

  -- owning form, it is necessary to store this as a form member, as .owner()
  -- does not work in a method that is run, after the form is hidden e.g. .ok()
  member .main is FORM

  -- members to store colour objects for representation colours
  member .pNodesColour is COLOUR
  member .snodesColour is COLOUR

  -- Body of form definition
  frame .profileFrame 'Steelwork' at xmin ymax
    toggle .profileG     'Profile    ' at xmin+1 ymax
    toggle .profileClG   'Centreline ' at xmin ymax+0.1
    toggle .profileInsuG 'Insulation ' at xmax.profileG+8 ymin.profileG

    option  .profileObstG at xmin.profileInsuG-6 ymin.profileClG  tooltip 'Profile Obstruction visibility/translucency' width 5
    paragraph .profileObstT at xmax.profileObstG ymin.profileClG text 'Obstruction'
  exit

  frame .pNodesFrame 'Primary Nodes' at xmin ymax
    toggle    .pNodesG     'Display' at xmin+1 ymax
    text      .pNodesSizeG 'Size' at xmax+3 ymin width 12 is REAL format !!distanceFmt
    paragraph .pnodColourTextG at xmin.pNodesG ymax+0.2 text 'Colour '
    button    .pNodesColourG '  ' at xmax ymin
    paragraph .pNodesColNameG at xmax ymin width 19 lines 1
  exit

  frame .snodesFrame 'Secondary Nodes' at xmin ymax
    toggle    .snodesG     'Display' at xmin+1 ymax
    text      .snodesSizeG 'Size' at xmax+3 ymin width 12 is REAL format !!distanceFmt
    paragraph .snodColourTextG at xmin.snodesG ymax+0.2 text 'Colour '
    button    .snodesColourG '  ' at xmax ymin
    paragraph .snodesColNameG at xmax ymin width 19 lines 1
  exit

  button .ok     '  OK  ' at xmin ymax+0.4 ok
  button .cancel 'Cancel' at xmax form-size ymin cancel

exit
-- End of form definition for !!gphRepSteelEdit

------------------------------------------------------------------------
--
-- Method:      !gphRepSteelEdit()
--
-- Description: constructor
--
-- Method Type: Procedure

--
------------------------------------------------------------------------

-- Define method
define method .gphRepSteelEdit()

  -- Obstruction translucency
  !dtext    = ARRAY()
  !rtext    = ARRAY()
  !dtext.append('Off')
  !rtext.append('-1')
  !dtext.append('Solid')
  !rtext.append('0')
  !dtext.append('25%')
  !rtext.append('25')
  !dtext.append('50%')
  !rtext.append('50')
  !dtext.append('75%')
  !rtext.append('75')
  !dtext.append('87%')
  !rtext.append('87')
  !this.profileObstG.dtext     = !dtext
  !this.profileObstG.rtext     = !rtext
  !this.profileObstG.callback  = '!this.obstruction(!this.profileObstG.selection(|RTEXT|).real())'

  -- define callbacks
  !this.pNodesColourG.callback = |!!colourSelectLoad('!!gphRepSteelEdit.pNodesColour()', 'Colour for Primary Nodes', !!gphRepSteelEdit.pNodesColour.code)|
  !this.snodesColourG.callback = |!!colourSelectLoad('!!gphRepSteelEdit.snodesColour()', 'Colour for Secondary Nodes', !!gphRepSteelEdit.snodesColour.code)|
  !this.okCall = '!!gphRepSteelEdit.ok()'

endmethod
-- End of method definition for .gphRepSteelEdit()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  -- set link to owning form
  !this.main = !this.owner()

  -- initialise form gadgets to main data settings,
  !this.profileG.val       = !this.main.data.profile()
  !this.profileClG.val     = !this.main.data.profileCl()
  !this.profileInsuG.val   = !this.main.data.profileInsu()
  -- Set obstruction
  if(!this.main.data.profileObst()) then
    if(!this.main.data.profileObstTrans().set()) then
      !obstructionValue  = !this.main.data.profileObstTrans()
    else
      !obstructionValue = 0
    endif
  else
    !obstructionValue   = -1
  endif
  !this.profileObstG.select('RTEXT', !obstructionValue.string())


  !this.pNodesG.val        = !this.main.data.pNodes()
  !pNodesSize = !this.main.data.pNodesSize()
  !this.pNodesSizeG.val    = $!<pNodesSize>
  !this.pNodesColour       = !this.main.data.pNodesColour()
  !this.pNodesColourG.background  = !this.main.data.pNodesColour().code
  !this.pNodesColNameG.val = !this.main.data.pNodesColour().name
  !this.snodesG.val        = !this.main.data.snodes()
  !snodesSize = !this.main.data.snodesSize()
  !this.snodesSizeG.val    = $!<snodesSize>
  !this.snodesColour       = !this.main.data.snodesColour()
  !this.snodesColourG.background  = !this.main.data.snodesColour().code
  !this.snodesColNameG.val = !this.main.data.snodesColour().name

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !pNodesColour()
--
-- Description: action for the pnodes colour selection gadget
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .pNodesColour()

  -- get the colour that has just been selected
  !this.pNodesColour.colour(!!colourSelectGet())

  -- set the form gadgets
  !this.pNodesColourG.background = !this.pNodesColour.code
  !this.pNodesColNameG.val = !this.pNodesColour.name

endmethod
-- End of method definition for .pNodesColour()

------------------------------------------------------------------------
--
-- Method:      !snodesColour()
--
-- Description: action for the snodes colour selection gadget
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .snodesColour()

  -- get the colour that has just been selected
  !this.snodesColour.colour(!!colourSelectGet())

  -- set the form gadgets
  !this.snodesColourG.background = !this.snodesColour.code
  !this.snodesColNameG.val = !this.snodesColour.name

endmethod
-- End of method definition for .snodesColour()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: ok action for form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- set the local representation options
  !this.main.data.profile(!this.profileG.val)
  !this.main.data.profileCl(!this.profileClG.val)
  !this.main.data.profileInsu(!this.profileInsuG.val)
  if (!this.profileObstG.selection(|RTEXT|).real() lt 0 ) then
     !this.main.data.profileObst(false)
  elseif (!this.profileObstG.selection(|RTEXT|).real() eq 0 ) then
     !this.main.data.profileObst(true)
     !this.main.data.profileObstTrans(0)
  else
     !this.main.data.profileObstTrans(!this.profileObstG.selection(|RTEXT|).real())
  endif
  !this.main.data.pNodes(!this.pNodesG.val)
  !this.main.data.pNodesSize(!this.pNodesSizeG.val)
  !this.main.data.pNodesColour(!this.pNodesColour)
  !this.main.data.snodes(!this.snodesG.val)
  !this.main.data.snodesSize(!this.snodesSizeG.val)
  !this.main.data.snodesColour(!this.snodesColour)

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      !obstruction(REAL)
--
-- Description: action for obstruction callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .obstruction(!value is REAL)

  -- Initialise Variables
  if(!value lt 0) then
    !this.data.profileObst(false)
  else
    !this.data.profileObstTrans(!value)
  endif

endmethod
-- End of method definition for .obstruction(REAL)
