--   Module:        Common
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Fri Jan 30 15:34:57 2004
--
--
-- Description:     Form for Graphics Settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   action for click on Apply or OK
--  arcToleranceValidate(GADGET,STRING) -                   Validate input to tolerance gadgets
--  autoCol()                        -                   action for auto colour toggle callback
--  display()                        -                   updates the gadgets with the current settings
--  display3DView()                  -                   updates the 3D View Settings frame with the current settings
--  displayCable()                   -                   updates the Cable Representation Settings frame with the current settings
--  displayColour()                  -                   updates the Colour Settings frame with the current settings
--  displayPlinesPpoints()           -                   updates the Pline & Ppoint Representation Settings frame with the current settings
--  displayRepresentation()          -                   updates the Representation Settings frame with the current settings
--  displaySteelwork()               -                   updates the Steelwork Representation Settings frame with the current settings
--  eyemode(GADGET,STRING)           -                   callback to maintain coupling of walkthrough and rotate settings
--  frame3Dview()                    -                   constructor for 3D View Settings frame
--  frameCable()                     -                   constructor for Cable Representation Settings frame
--  frameColour()                    -                   constructor for Colour Settings frame
--  framePlinesPpoints()             -                   constructor for Plines and Ppoints Settings frame
--  frameRepresentation()            -                   constructor for Representation Settings frame
--  frameSteelwork()                 -                   constructor for Steelwork Representation Settings frame
--  gphSettings()                    -                   Constructor method
--  initialise()                     -                   initialisation called when form opened
--  load(BOOLEAN,BOOLEAN,BOOLEAN)    -                   load the defaults
--  save(BOOLEAN,BOOLEAN,BOOLEAN)    -                   save the defaults
--  selectFrame(STRING)              -                   replace currently active frame by one selected from list
--  setColour(STRING)                -                   Set colour of colour settings button
--  setVolumeOption()                -                   callback to set the volume option to either Design or Production
--  showForm(STRING)                 -                   open form with particular frame showing
--
------------------------------------------------------------------------
layout form !!gphSettings dialog
--setup form !!gphSettings dialog

  title 'Graphics Settings'

  -- current module
  member .framesVisible is ARRAY
  member .module is STRING

  -- set so that all frames are used
  do !i from 1 to 5
    !this.framesVisible[!i] = true
  enddo

  -- find current module (used so 3D View tab isn't shown in Paragon)
  !this.module = !!module().appkey.upCase()
  if (!this.module eq 'CAT') then
    !this.framesVisible[1] = false
  elseif (!this.module eq 'DRA') then
    !this.framesVisible[1] = false
    !this.framesVisible[2] = false
  endif

  -- set string to be used to position each of the frames
  path down

  frame .tabset tabset expand width 50 height 10
    -- Developer note: frame names are of the form .frameXXX (used for recognition later in code)
    ------------------------------------------------------------------------
    if (!this.framesVisible[1]) then
      frame .frame3Dview '3D Views'
        paragraph .note text 'Defaults: existing views not modified.'
        -- paragraph .note text 'These settings only apply to new 3D views.'
        text .title 'Title' callback '!this.viewData.title = !this.title.val' width 30 string
        -- View type
        rgroup .projection 'View Type' callback '!this.viewData.projection = !this.projection.selection()' frame vertical
          add tag 'Parallel'    select 'PARALLEL'
          add tag 'Perspective' select 'PERSPECTIVE'
        exit
        path right
        -- Rotate about eye/model
        rgroup .rotate 'Rotate' callback '!this.eyemode(' frame vertical
          add tag 'about Model' select 'TRUE'
          add tag 'about Eye'   select 'FALSE'
        exit

        path down
        toggle .shaded at xmin.projection 'Shaded' callback '!this.viewData.shaded = !this.shaded.val'
        toggle .borders                  'Borders' callback '!this.viewData.borders = !this.borders.val'
        toggle .walkThrough          'Walkthrough' callback '!this.eyemode('
        -- toggle .longMenus         'Long Menus'  callback '!this.viewData.longMenus = !this.longMenus.val'

        -- Colours
        path right
        valign centre
        paragraph .bgText at xmin.rotate ymax.rotate+0.4  text 'Background Colour'
        button    .bgColButton ' ' wid 2

        -- World Axes
        toggle .showAxes at xmin.bgText ymin.walkThrough 'Show World Axes' callback '!this.viewData.showAxes = !this.showAxes.val'
      exit
    endif
    ------------------------------------------------------------------------
    if (!this.framesVisible[2]) then
      frame .frameColour 'Colour'
        frame .general 'General Colours'
          !wtag = 10
          !vert = 0.5
          path right
          valign centre
          -- ce colour gadgets
          paragraph .ceColText text 'CE' wid $!wtag
          button    .ceColButton ' ' wid 2
          -- active colour gadgets
          paragraph .activeColText at xmin.ceColText ymax+$!vert text 'Active'  wid $!wtag
          button    .activeColButton ' ' wid 2
          -- visible colour gadgets
          paragraph .visibleColTextG at xmin.ceColText ymax+$!vert text 'Visible' wid $!wtag
          button    .visibleColButton ' ' wid 2
          -- aids colour gadgets
          paragraph .aidsColText at xmax.ceColText + 10 ymin.ceColText text 'Aids' wid $!wtag
          button    .aidsColButton ' ' wid 2
          -- highlight colour gadgets
          paragraph .highColText at xmin.aidsColText ymax+$!vert text 'Highlight'  wid $!wtag
          button    .highColButton ' ' wid 2
        exit

        toggle .autoColour 'Auto Colour'
        toggle .tglDynamic 'Dynamic Auto Colour'
        button .autoColRules 'Auto Colour Rules...'
        paragraph .usingRuleSet text ' ' width 30
      exit
    endif
    ------------------------------------------------------------------------
    frame .frameRepresentation 'Representation'
      toggle .tubeG       'Tube'
      toggle .centrelineG 'Centreline'
      toggle .holesG      'Holes Drawn'
      !wtag = 10
      option .insulationG  at ymax tagwid $!wtag 'Insulation ' tooltip 'Insulation visibility/translucency' width 5
      option .obstructionG at ymax tagwid $!wtag 'Obstruction' tooltip 'Obstruction visibility/translucency' width 5

      -- Drawing levels
      frame .level 'Level' at xmax.insulationG + 2 ymin.tubeG
        !wtag = 10
        text .pipeLevelG     tagwid $!wtag 'Pipe'      width 3 is REAL  format !!integerFmt
        text .nozzLevelG     tagwid $!wtag 'Nozzle'    width 3 is REAL  format !!integerFmt
        text .struLevelG     tagwid $!wtag 'Structure' width 3 is REAL format !!integerFmt
        text .generalLevelG  tagwid $!wtag 'Others'    width 3 is REAL format !!integerFmt
        text .massLevelG     tagwid $!wtag 'Mass'      width 3 is REAL format !!integerFmt
        text .cableLevelG    tagwid $!wtag 'Cable'     width 3 is REAL format !!integerFmt
      exit
      text .arcToleranceG at xmin.tubeG tagwid 14 'Arc Tolerance' width 14 is REAL format !!distanceFmt
      text .massArcToleranceG at xmin.tubeG tagwid 14 'Mass Arc Tolerance' width 14 is REAL format !!massArcToleranceFmt
      button .advanced |Advanced...| at xmax+0.25 ymin callback |show !!comRepRules free| width 9
    exit
    ------------------------------------------------------------------------
    frame .frameSteelwork 'Steelwork'
      -- members to store colour objects for representation colours
      toggle .profileG     'Profile' at x 3
      toggle .profileInsuG 'Insulation' at xmax.profileG + 11 ymin

      --paragraph .profileObstT at xmin.profileG text 'Obstruction'
      option .profileObstG 'Obstruction' at xmin.profileG tooltip 'Profile Obstruction visibility/translucency' width 5

      frame .pNodesFrame 'Primary Nodes' at xmin.profileG - 1
        path right
        valign centre
        toggle    .pNodesG     'Display'
        text      .pNodesSizeG 'Size' width 8 is REAL format !!distanceFmt
        paragraph .pnodColourTextG text 'Colour'
        button    .pNodesColourG ' ' wid 2
      exit
      frame .sNodesFrame 'Secondary Nodes'
        path right
        valign centre
        toggle    .sNodesG     'Display'
        text      .sNodesSizeG 'Size' width 8 is REAL format !!distanceFmt
        paragraph .sNodColourTextG text 'Colour'
        button    .sNodesColourG ' ' wid 2
      exit

      --P-22243 - Add Volume Option but only when in Marine and design or draft
      !module = !!module()
      if (!module.productFamily.upCase().eq('MARINE')) then
      	path down
        frame .volumeOption 'Volume Option'
        	path right
          rtoggle .hullDesign tagWidth 10 'Hull Design' callback '!this.setVolumeOption()' states '' 'Design' $
          				tooltip 'Volumetric Query Will Return Design Data'
          rtoggle .hullProduction tagwidth 10 'Hull Production' callback '!this.setVolumeOption()' states '' 'Production' $
          				tooltip 'Volumetric Query Will Return Production Data'
        exit
        --Initialise the toggles, we have to get the volumeOption value.
        var !hullDes VOLUMEOPTION HULL DESIGN
        if (!hullDes.after(': ').eq('ON')) then
          !this.hullDesign.val = TRUE
        else
        	!this.hullProduction.val = TRUE
        endif
      endif
      --End of P-22243.

    exit
    ------------------------------------------------------------------------
    frame .frameCable 'Cabling'

      --paragraph .cwbranObstT at xmin.profileG text 'Cableway Branch obstruction'
      !wtag = 20
      option .cableObstG tagwid $!wtag 'Cableway Branch obstruction' at at x 3 tooltip 'Cableway Branch Obstruction visibility/translucency' width 5
      toggle .centrelineC 'Centreline' at xmin+$!wtag

      frame .hAttasFrame 'Head & Tail Attachments' at xmin.cableObstG - 1
        path right
        valign centre
        toggle    .hAttasG     'Display'
        text      .hAttasSizeG 'Size' width 8 is REAL format !!distanceFmt
        paragraph .hAttasColourTextG text 'Colour'
        button    .hAttasColourG ' ' wid 2
      exit

      path down

      frame .rAttasFrame 'Route Attachments' at xmin.cableObstG - 1
        path right
        valign centre
        toggle    .rAttasG     'Display'
        text      .rAttasSizeG 'Size' width 8 is REAL format !!distanceFmt
        paragraph .rAttasColourTextG text 'Colour'
        button    .rAttasColourG ' ' wid 2
      exit

      path down

      frame .rNodesFrame 'Route Nodes' at xmin.cableObstG - 1
        path right
        valign centre
        toggle    .rNodesG     'Display'
        text      .rNodesSizeG 'Size' width 8 is REAL format !!distanceFmt
        paragraph .rNodesColourTextG text 'Colour'
        button    .rNodesColourG ' ' wid 2
      exit

    exit
    ------------------------------------------------------------------------
    frame .framePlinesPpoints 'Plines & Ppoints'
      frame .pLinesFrame 'Plines'
        toggle .pLinesG 'Display'
        toggle .pLinesPkeyG 'Pkey'
        text .pLinesLengthG 'Length' at xmax + 8 ymin width 12 is REAL format !!distanceFmt
      exit
      frame .pPointsFrame 'Ppoints'
        toggle .pPointsG 'Display'
        toggle .pPointsNumbersG 'Numbers'
        text .pPointsLengthG 'Length' at xmax + 5 ymin width 12 is REAL format !!distanceFmt
      exit
    exit
    ------------------------------------------------------------------------
  exit

  -- Load/Save buttons
  button .loadButton 'Load' callback '!this.load(true, true, true)' width 8
  path right
  hdist 0.4
  button .saveButton 'Save' callback '!this.save(true, true, true)' width 8

  -- OK/Cancel/Apply buttons
  path left
  button .apply   'Apply'  width 8 at xmax form-size  callback '!this.apply()'
  button .dismiss 'Cancel' width 8 CANCEL
  button .ok      'OK'     width 8 callback '!this.apply()' OK
  ------------------------------------------------------------------------

  -- Form Members
  if (!this.framesVisible[1]) then
    member .viewData     is GPHVIEWOPT
  endif
  if (!this.framesVisible[2]) then
    member .colourData   is GPHCOLOPT
  endif
  member .repData      is GPHREPOPT

  -- member .currentFrame is GADGET
  member .currentFrame is STRING

  -- names of frames on form
  member .frames       is ARRAY

  -- members to store rtext and dtext of translucency menu
  member .transDtext   is ARRAY
  member .transRtext   is ARRAY


exit

------------------------------------------------------------------------
--
-- Method:      .gphSettings()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .gphSettings()
  -- set up initialisation call
  !this.initcall = '!this.initialise()'

  -- create list of frames on this form
  -- execute construction methods for individual frames
  -- set current frame
  if (!this.framesVisible[1]) then
    !frames[1] = 'FRAME3DVIEW'
    !this.frame3DView()
  endif
  if (!this.framesVisible[2]) then
    !frames[2] = 'FRAMECOLOUR'
    !this.frameColour()
  endif
  !frames[3] = 'FRAMEREPRESENTATION'
  !frames[4] = 'FRAMESTEELWORK'
  !frames[5] = 'FRAMEPLINESPPOINTS'
  !frames[5] = 'FRAMEPCABLE'

  !this.frames = !frames

  !this.frameRepresentation()
  !this.frameSteelwork()
  !this.framePlinesPpoints()
  !this.frameCable()

  -- set frame that's shown initially
  !this.currentFrame = !frames.first()

  !!massArcToleranceFmt = object FORMAT()
  !!massArcToleranceFmt = !!distanceFmt

endmethod
-- End of method definition for .gphSettings()

------------------------------------------------------------------------
--
-- Method:      .frame3Dview()
--
-- Description: constructor for 3D View Settings frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .frame3Dview()
  -- create new instance of graphical view options if none present
  if(undefined(!!gphViewOpt)) then
    !gphViewOpt = object GPHVIEWOPT()
    !gphViewOpt.globalInstance()
  endif

  -- callback for colour buttons
  !this.bgColButton.callback = |!!colourSelectLoad('!!gphSettings.setColour(''bg'')', '3D View Background Colour', !this.viewData.background.code)|
endmethod
-- End of method definition for .frame3Dview()

------------------------------------------------------------------------
--
-- Method:      .frameColour()
--
-- Description: constructor for Colour Settings frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .frameColour()
  -- define callbacks for colour buttons
  !this.ceColButton.callback      = |!!colourSelectLoad('!!gphSettings.setColour(''ce'')', 'Current Element Colour', !this.colourData.ce.code)|
  !this.activeColButton.callback  = |!!colourSelectLoad('!!gphSettings.setColour(''active'')', 'Active Element Colour', !this.colourData.active.code)|
  !this.visibleColButton.callback = |!!colourSelectLoad('!!gphSettings.setColour(''visible'')', 'Visible Element Colour', !this.colourData.visible.code)|
  !this.aidsColButton.callback    = |!!colourSelectLoad('!!gphSettings.setColour(''aids'')', 'Graphical Aid Colour', !this.colourData.aids.code)|
  !this.highColButton.callback    = |!!colourSelectLoad('!!gphSettings.setColour(''high'')', 'Graphical Highlight Colour', !this.colourData.highlight.code)|

  !this.autoColour.callback    = '!this.autoCol()'
  !this.tglDynamic.callback     = '!this.colourData.dynamicAutoColour(!this.tglDynamic.val)'
  !this.autoColRules.callback  = 'show !!gphColAutoRlEdit'

  -- set autocolour gadgets to inactive if in Paragon module
  !module = !!module()
  if (!module.appkey.upCase() eq 'CAT') then
    !this.autoColour.active = false
    !this.autoColRules.active = false
  endif
endmethod
-- End of method definition for .frameColour()

------------------------------------------------------------------------
--
-- Method:      .frameRepresentation()
--
-- Description: constructor for Representation Settings frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .frameRepresentation()
  -- create menu options for transparency menus
  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext.append('Off')
  !rtext.append('-1')
  !dtext.append('Solid')
  !rtext.append('0')
  !dtext.append('12%')
  !rtext.append('12')
  !dtext.append('25%')
  !rtext.append('25')
  !dtext.append('50%')
  !rtext.append('50')
  !dtext.append('75%')
  !rtext.append('75')
  !dtext.append('87%')
  !rtext.append('87')
  -- store in form member so it can be used later on
  !this.transDtext = !dtext
  !this.transRtext = !rtext
  !this.insulationG.dtext      = !this.transDtext
  !this.insulationG.rtext      = !this.transRtext
  !this.obstructionG.dtext     = !this.transDtext
  !this.obstructionG.rtext     = !this.transRtext
  -- add callbacks to menus
  !this.insulationG.callback   = '!this.repData.insulation(!this.insulationG.selection(|RTEXT|).real())'
  !this.obstructionG.callback  = '!this.repData.obstruction(!this.obstructionG.selection(|RTEXT|).real())'

  -- define callbacks
  !this.tubeG.callback         = '!this.repData.tube(!this.tubeG.val)'
  !this.centrelineG.callback   = '!this.repData.centreline(!this.centrelineG.val)'
  !this.holesG.callback        = '!this.repData.holes(!this.holesG.val)'
  !this.arcToleranceG.callback = '!this.repData.arcTolerance(!this.arcToleranceG.val)'
  !this.massArcToleranceG.callback = '!this.repData.massArcTolerance(!this.massArcToleranceG.val)'
  !this.arcToleranceG.validateCall = '!this.arcToleranceValidate('
  !this.massArcToleranceG.validateCall = '!this.arcToleranceValidate('

  !this.pipeLevelG.callback    = '!this.repData.pipeLevel(!this.pipeLevelG.val)'
  !this.nozzLevelG.callback    = '!this.repData.nozzLevel(!this.nozzLevelG.val)'
  !this.struLevelG.callback    = '!this.repData.struLevel(!this.struLevelG.val)'
  !this.generalLevelG.callback = '!this.repData.generalLevel(!this.generalLevelG.val)'
  !this.massLevelG.callback    = '!this.repData.massLevel(!this.massLevelG.val)'
  !this.cableLevelG.callback = '!this.repData.cableLevel(!this.cableLevelG.val)'
endmethod
-- End of method definition for .frameRepresentation()

------------------------------------------------------------------------
--
-- Method:      .frameSteelwork()
--
-- Description: constructor for Steelwork Representation Settings frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .frameSteelwork()
  -- add options to transparency menu
  !this.profileObstG.dtext     = !this.transDtext
  !this.profileObstG.rtext     = !this.transRtext
  !this.profileObstG.callback  = '!this.repData.profileObst(!this.profileObstG.selection(|RTEXT|).real())'

  -- define callbacks
  !this.profileG.callback      = '!this.repData.profile(!this.profileG.val)'
  !this.profileInsuG.callback  = '!this.repData.profileInsu(!this.profileInsuG.val)'
  !this.pNodesColourG.callback = |!!colourSelectLoad('!!gphSettings.setColour(''pnode'')', 'Primary Node Colour', !this.repData.pNodesColour.code)|
  !this.sNodesColourG.callback = |!!colourSelectLoad('!!gphSettings.setColour(''snode'')', 'Secondary Node Colour', !this.repData.sNodesColour.code)|
  !this.pNodesG.callback       = '!this.repData.pNodes(!this.pNodesG.val)'
  !this.pNodesSizeG.callback   = '!this.repData.pNodesSize(!this.pNodesSizeG.val)'
  !this.sNodesG.callback       = '!this.repData.sNodes(!this.sNodesG.val)'
  !this.sNodesSizeG.callback   = '!this.repData.sNodesSize(!this.sNodesSizeG.val)'
endmethod
-- End of method definition for .frameSteelwork()

------------------------------------------------------------------------
--
-- Method:      .framePlinesPpoints()
--
-- Description: constructor for Plines and Ppoints Settings frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .framePlinesPpoints()
  !this.pPointsG.callback        = '!this.repData.pPoints(!this.pPointsG.val)'
  !this.pPointsNumbersG.callback = '!this.repData.pPointsNumbers(!this.pPointsNumbersG.val)'
  !this.pPointsLengthG.callback  = '!this.repData.pPointsLength(!this.pPointsLengthG.val)'

  !this.pLinesG.callback         = '!this.repData.pLines(!this.pLinesG.val)'
  !this.pLinesPkeyG.callback     = '!this.repData.pLinesPkey(!this.pLinesPkeyG.val)'
  !this.pLinesLengthG.callback   = '!this.repData.pLinesLength(!this.pLinesLengthG.val)'
endmethod
-- End of method definition for .framePlinesPpoints()

------------------------------------------------------------------------
--
-- Method:      .frameCable()
--
-- Description: constructor for Cable Representation Settings frame
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .frameCable()

  -- define callbacks
  !this.cableObstG.dtext     = !this.transDtext
  !this.cableObstG.rtext     = !this.transRtext
  !this.cableObstG.callback  = '!this.repData.cableObst(!this.cableObstG.selection(|RTEXT|).real())'
	!this.centrelineC.callback   = '!this.repData.cableCentreline(!this.centrelineC.val)'
	
  !this.hAttasColourG.callback = |!!colourSelectLoad('!!gphSettings.setColour(''hAtta'')', 'Head & Tail Attachments Colour', !this.repData.hAttasColour.code)|
  !this.hAttasG.callback       = '!this.repData.hAttas(!this.hAttasG.val)'
  !this.hAttasSizeG.callback   = '!this.repData.hAttasSize(!this.hAttasSizeG.val)'

  !this.rAttasColourG.callback = |!!colourSelectLoad('!!gphSettings.setColour(''ratta'')', 'Route Attachments Colour', !this.repData.rAttasColour.code)|
  !this.rAttasG.callback       = '!this.repData.rAttas(!this.rAttasG.val)'
  !this.rAttasSizeG.callback   = '!this.repData.rAttasSize(!this.rAttasSizeG.val)'

  !this.rNodesColourG.callback = |!!colourSelectLoad('!!gphSettings.setColour(''rnode'')', 'Route Node Colour', !this.repData.rNodesColour.code)|
  !this.rNodesG.callback       = '!this.repData.rNodes(!this.rNodesG.val)'
  !this.rNodesSizeG.callback   = '!this.repData.rNodesSize(!this.rNodesSizeG.val)'

endmethod
-- End of method definition for .frameCable()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   initialisation called when form opened
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  -- load data into form objects

  -- 3D View settings
  if (!this.framesVisible[1]) then
    !this.viewData = !!gphViewOpt
  endif

  -- Colour settings
  -- copy the current global settings and unset the global flag
  if (!this.framesVisible[2]) then
    !this.colourData = !!gphColOpt.localCopy()
  endif

  -- Representation settings
  -- copy the current global settings and unset the global flag
  !this.repData = !!gphRepOpt.localCopy()

  -- and update display
  !this.display()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      showForm
--
-- Description:
--   open form with particular frame showing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      string containing name of frame to show
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showForm(!frameName is STRING)
  if (!frameName.unset()) then
    !frameNameUC = ''
  else
    !frameNameUC = !frameName.upCase()
  endif
  if (!frameNameUC.trim().empty() or !frameNameUC eq 'CURRENT') then
    !this.show('FREE')
  elseif (!this.frames.findFirst(!frameNameUC).set()) then
    !this.show('FREE')
    !this.selectFrame(!frameNameUC)
  elseif (!this.frames.findFirst('FRAME' & !frameNameUC).set()) then
    !this.show('FREE')
    !this.selectFrame('FRAME' & !frameNameUC)
  else
    return error 1 'Frame $!frameName not found on form'
  endif
endmethod
-- End of method definition for .showForm(STRING)

------------------------------------------------------------------------
--
-- Method:      selectFrame
--
-- Description:
--   replace currently active frame by one selected from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectFrame(!frameName is STRING)
  !this.attribute(!frameName).visible = TRUE
  !this.currentFrame = !frameName
endmethod
-- End of method definition for .selectFrame()

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description:
--   updates the gadgets with the current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display()
  if (!this.framesVisible[1]) then
    !this.display3DView()
  endif
  if (!this.framesVisible[2]) then
    !this.displayColour()
  endif
  !this.displayRepresentation()
  !this.displaySteelwork()
  !this.displayCable()
  !this.displayPlinesPpoints()
endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      display3DView
--
-- Description:
--   updates the 3D View Settings frame with the current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .display3DView()
  -- set colours
  !this.bgColButton.background = !this.viewData.background.code
  !this.bgColButton.setTooltip(!this.viewData.background.name)

  -- allow title to be modified (or not)
  !this.title.val              = !this.viewData.title
  !this.title.active           = !this.viewData.titleModifiable

  -- set options
  !this.shaded.val             = !this.viewData.shaded
  !this.borders.val            = !this.viewData.borders
  !this.walkThrough.val        = !this.viewData.walkThrough
  !this.showAxes.val           = !this.viewData.showAxes

  -- view type
  !this.projection.select(!this.viewData.projection)

  -- rotate (is coupled to walkthrough in the core properties of the view)
  --!this.rotate.select(!this.viewData.rotate.string())
  !this.rotate.select(!this.walkThrough.val.not().string())

endmethod
-- End of method definition for .display3DView()

------------------------------------------------------------------------
--
-- Method:      displayColour
--
-- Description:
--   updates the Colour Settings frame with the current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayColour()
  -- set colours
  !this.ceColButton.background = !this.colourData.ce().code
  !this.activeColButton.background = !this.colourData.active().code
  !this.visibleColButton.background = !this.colourData.visible().code
  handle (61,615)
    -- Unset colour code, either unset colour or unnamed colour
    !this.colourData.visible('lightgrey')
    !this.visibleColButton.background = !this.colourData.visible().code
  endhandle
  !this.aidsColButton.background = !this.colourData.aids().code
  !this.highColButton.background = !this.colourData.highlight().code
  -- set tool tips
  !this.ceColButton.setTooltip(!this.colourData.ce().name)
  !this.activeColButton.setTooltip(!this.colourData.active().name)
  !this.visibleColButton.setTooltip(!this.colourData.visible().name)
  !this.aidsColButton.setTooltip(!this.colourData.aids().name)
  !this.highColButton.setTooltip(!this.colourData.highlight().name)

  -- autocolour gadget
  !this.autoColour.val = !this.colourData.autoColour()
  -- grey out dynamic autocolour if autocolour is turned off
  !this.tglDynamic.active = !this.colourData.autoColour()
  -- set dynamic autocolour toggle
  !this.tglDynamic.val = !this.colourData.dynamicAutoColour()
  -- set colour rules location
  if( !this.colourData.optionsFileType eq 'DEFAULT' ) then
    !message = 'Using System defined colour rules'
  elseif( !this.colourData.optionsFileType eq 'PROJ' ) then
    !message = 'Using Project defined colour rules'
  else
    !message = 'Using User defined colour rules'
  endif
  !this.usingRuleSet.val = !message
endmethod
-- End of method definition for .displayColour()

------------------------------------------------------------------------
--
-- Method:      displayRepresentation
--
-- Description:
--   updates the Representation Settings frame with the current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayRepresentation()
  -- initialise form gadgets to main data settings
  !this.pipeLevelG.val    = !this.repData.pipeLevel()
  !this.nozzLevelG.val    = !this.repData.nozzLevel()
  !this.struLevelG.val    = !this.repData.struLevel()
  !this.generalLevelG.val = !this.repData.generalLevel()
  !this.massLevelG.val    = !this.repData.massLevel()
  !this.cableLevelG.val   = !this.repData.cableLevel()

  !this.tubeG.val         = !this.repData.tube()
  !this.centrelineG.val   = !this.repData.centreline()
  !this.holesG.val        = !this.repData.holes()
  !this.arcToleranceG.val = !this.repData.arcTolerance()
  !this.massArcToleranceG.val = !this.repData.massArcTolerance()

  -- Set insulation
  if(!this.repData.insulation()) then
    if(!this.repData.insulationTrans().set()) then
      !insulationValue = !this.repData.insulationTrans()
    else
      !insulationValue = 0
    endif
  else
    !insulationValue   = -1
  endif
  !this.insulationG.select('RTEXT', !insulationValue.string())

  -- Set obstruction
  if(!this.repData.obstruction()) then
    if(!this.repData.obstructionTrans().set()) then
      !obstructionValue = !this.repData.obstructionTrans()
    else
      !obstructionValue = 0
    endif
  else
    !obstructionValue   = -1
  endif
  !this.obstructionG.select('RTEXT', !obstructionValue.string())
endmethod
-- End of method definition for .displayRepresentation()

------------------------------------------------------------------------
--
-- Method:      displaySteelwork
--
-- Description:
--   updates the Steelwork Representation Settings frame with the current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displaySteelwork()
  -- initialise form gadgets to main data settings,
  !this.profileG.val       = !this.repData.profile()
  !this.profileInsuG.val   = !this.repData.profileInsu()
  -- set obstruction
  if(!this.repData.profileObst()) then
    if(!this.repData.profileObstTrans().set()) then
      !obstructionValue  = !this.repData.profileObstTrans()
    else
      !obstructionValue = 0
    endif
  else
    !obstructionValue   = -1
  endif
  !this.profileObstG.select('RTEXT', !obstructionValue.string())

  !this.pNodesG.val        = !this.repData.pNodes()
  !this.pNodesSizeG.val    = !this.repData.pNodesSize()
  !this.pNodesColourG.background  = !this.repData.pNodesColour().code
  !this.sNodesG.val        = !this.repData.sNodes()
  !this.sNodesSizeG.val    = !this.repData.sNodesSize()
  !this.sNodesColourG.background  = !this.repData.sNodesColour().code
endmethod
-- End of method definition for .displaySteelwork()

------------------------------------------------------------------------
--
-- Method:      displayCable
--
-- Description:
--   updates the Cable Representation Settings frame with the current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayCable()

  -- set obstruction
  if(!this.repData.cableObst()) then
    if(!this.repData.cableObstTrans().set()) then
      !obstructionValue  = !this.repData.cableObstTrans()
    else
      !obstructionValue = 0
    endif
  else
    !obstructionValue   = -1
  endif

  !this.cableObstG.select('RTEXT', !obstructionValue.string())
  !this.centrelineC.val   = !this.repData.cableCentreline()

  !this.hAttasG.val        = !this.repData.hAttas()
  !this.hAttasSizeG.val    = !this.repData.hAttasSize()
  !this.hAttasColourG.background  = !this.repData.hAttasColour().code

  !this.rAttasG.val        = !this.repData.rAttas()
  !this.rAttasSizeG.val    = !this.repData.rAttasSize()
  !this.rAttasColourG.background  = !this.repData.rAttasColour().code

  !this.rNodesG.val        = !this.repData.rNodes()
  !this.rNodesSizeG.val    = !this.repData.rNodesSize()
  !this.rNodesColourG.background  = !this.repData.rNodesColour().code

endmethod
-- End of method definition for .displayCable()

------------------------------------------------------------------------
--
-- Method:      displayPlinesPpoints
--
-- Description:
--   updates the Pline & Ppoint Representation Settings frame with the current settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayPlinesPpoints()
  !this.pPointsG.val        = !this.repData.pPoints()
  !this.pPointsNumbersG.val = !this.repData.pPointsNumbers()
  !this.pPointsLengthG.val  = !this.repData.pPointsLength()

  !this.pLinesG.val       = !this.repData.pLines()
  !this.pLinesPkeyG.val   = !this.repData.pLinesPkey()
  !this.pLinesLengthG.val = !this.repData.pLinesLength()
endmethod
-- End of method definition for .displayPlinesPpoints()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   action for click on Apply or OK
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- 3D View Settings
  -- copy data to global instance
  if (!this.framesVisible[1] and !!gphViewOpt ne !this.viewData) then
    !!gphViewOpt = !this.viewData
  endif

  if (!this.framesVisible[2]) then
    !this.colourData.global = true
    if (!!gphColOpt ne !this.colourData) then
      !this.colourData.copyToGlobal()
    endif
    !this.colourData.global = false
  endif

  -- Representation Settings (and Steelwork, Plines & Ppoints)
  !this.repData.global = true
  if (!!gphRepOpt ne !this.repData) then
    !this.repData.copyToGlobal()
    -- update the representation (there used to be a toggle on the form to turn this on and off)
    !!gphRepOpt.update()
  endif
  !this.repData.global = false

  -- Apply to views
  --do !i indices !!gphViews.views
    -- The view tab should not update existing views (there is a paragraph on it that says this)
    --!this.viewData.applyToView(!!gphViews.views[!i])
    --handle (2,759)
    --  -- Added this handle for loca Drawlist in the new Paragon interface, seems to work ok just avoiding this call.
    --  -- Should work for standard global draw lists if someone creates one.
    --endhandle
  --enddo

  -- Steelwork Settings
  -- done with Representation Settings

  -- Plines & Ppoints Settings
  -- done with Representation Settings

  -- set core highlight colour
  !anyDrawlist = object drawlist()
  !anyDrawlist.highlightColour(!!gphColOpt.highlight.code)
endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      setColour
--
-- Description:
--   Set colour of colour settings button
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      code corresponding to button being changed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setColour(!colour is STRING)
  !colCode = !!colourSelectGet()
  if (!colour eq 'bg') then
    !this.viewData.background.colour(!colCode)
    !this.bgColButton.background = !colCode
    !this.bgColButton.setTooltip(!this.viewData.background.name)
  elseif (!colour eq 'ce') then
    !this.colourData.ce(!colCode)
    !this.ceColButton.background = !colCode
    !this.ceColButton.setTooltip(!this.colourData.ce().name)
  elseif (!colour eq 'active') then
    !this.colourData.active(!colCode)
    !this.activeColButton.background = !colCode
    !this.activeColButton.setTooltip(!this.colourData.active().name)
  elseif (!colour eq 'visible') then
    !this.colourData.visible(!colCode)
    !this.visibleColButton.background = !colCode
    !this.visibleColButton.setTooltip(!this.colourData.visible().name)
  elseif (!colour eq 'aids') then
    !this.colourData.aids(!colCode)
    !this.aidsColButton.background = !colCode
    !this.aidsColButton.setTooltip(!this.colourData.aids().name)
  elseif (!colour eq 'high') then
    !this.colourData.highlight(!colCode)
    !this.highColButton.background = !colCode
    !this.highColButton.setTooltip(!this.colourData.highlight().name)
  elseif (!colour eq 'pnode') then
    !this.repData.pNodesColour(!colCode)
    !this.pNodesColourG.background = !colCode
    !this.pNodesColourG.setTooltip(!this.colourData.ce().name)
  elseif (!colour eq 'snode') then
    !this.repData.sNodesColour(!colCode)
    !this.sNodesColourG.background = !colCode
    !this.sNodesColourG.setTooltip(!this.colourData.ce().name)
  elseif (!colour eq 'hAtta') then
    !this.repData.hAttasColour(!colCode)
    !this.hAttasColourG.background = !colCode
    !this.hAttasColourG.setTooltip(!this.colourData.ce().name)
  elseif (!colour eq 'ratta') then
    !this.repData.rAttasColour(!colCode)
    !this.rAttasColourG.background = !colCode
    !this.rAttasColourG.setTooltip(!this.colourData.ce().name)
  elseif (!colour eq 'rnode') then
    !this.repData.rNodesColour(!colCode)
    !this.rNodesColourG.background = !colCode
    !this.rNodesColourG.setTooltip(!this.colourData.ce().name)
  endif
endmethod
-- End of method definition for .setColour(STRING)

------------------------------------------------------------------------
--
-- Method:      .autoCol()
--
-- Description: action for auto colour toggle callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .autoCol()
   !stat = !this.autoColour.val
   !this.tglDynamic.active = !stat
   !this.colourData.autoColour(!stat)
endmethod
-- End of method definition for .autoCol()

------------------------------------------------------------------------
--
-- Method:      .save()
--
-- Description: save the defaults
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN
--    2   R      BOOLEAN
--    3   R      BOOLEAN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .save(!saveView is BOOLEAN, !saveColour is BOOLEAN, !saveRep is BOOLEAN)
  -- save all the data
  if (!this.framesVisible[1] and !saveView) then
    !this.viewData.save()
  endif
  if (!this.framesVisible[2] and !saveColour) then
    !this.colourData.save()
    -- set colour rules location
    if( !this.colourData.optionsFileType eq 'DEFAULT' ) then
      !message = 'Using System defined colour rules'
    elseif( !this.colourData.optionsFileType eq 'PROJ' ) then
      !message = 'Using Project defined colour rules'
    else
      !message = 'Using User defined colour rules'
    endif
    !this.usingRuleSet.val = !message
  endif
  if (!saveRep) then
    !this.repData.save()
  endif
endmethod
-- End of method definition for .save(BOOLEAN, BOOLEAN, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .load()
--
-- Description: load the defaults
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN
--    2   R      BOOLEAN
--    3   R      BOOLEAN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .load(!loadView is BOOLEAN, !loadColour is BOOLEAN, !loadRep is BOOLEAN)
  -- load the data and set gadgets to correct values
  if (!this.framesVisible[1] and !loadView) then
    !this.viewData.load()
    !this.display3DView()
  endif
  if (!this.framesVisible[2] and !loadColour) then
    !this.colourData.load()
    !this.displayColour()
  endif
  if (!loadRep) then
    !this.repData.load()
    !this.displayRepresentation()
    !this.displaySteelwork()
    !this.displayCable()
    !this.displayPlinesPpoints()
  endif
endmethod
-- End of method definition for .load(BOOLEAN, BOOLEAN, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .eyemode()
--
-- Description: callback to maintain coupling of walkthrough and rotate settings
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .eyemode(!gadget is GADGET, !dummyAction is STRING)

  -- These two gadgets need to reflect the coupling of eyemode and walkthrough settings in core for the view
  if (!gadget eq !this.walkThrough) then
    !this.rotate.select(!this.walkThrough.val.not().string())
  elseif (!gadget eq !this.rotate) then
    !this.walkThrough.val = !this.rotate.selection().boolean().not()
  endif
  !this.viewData.walkThrough = !this.walkThrough.val
  !this.viewData.rotate = !this.rotate.selection().boolean()

endmethod
-- End of method definition for .eyemode()
------------------------------------------------------------------------
--
-- Method:      .setVolumeOption()
--
-- Description: callback to set the volume option to either Design or Production
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--P-22243 - Sets the volumeOption to hull design on or hull production on.
define method .setVolumeOption()
	
	if (!this.hullDesign.val) then
		VOLUMEOPTION HULL DESIGN ON
		VOLUMEOPTION HULL PRODUCTION OFF
	elseif (!this.hullProduction.val) then
		VOLUMEOPTION HULL DESIGN OFF
		VOLUMEOPTION HULL PRODUCTION ON
	endif

endmethod
-- End of method definition for .setVolumeOption()

------------------------------------------------------------------------
--
-- Method:      arcToleranceValidate
--
-- Description: Validate input to tolerance gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   !gadget is GADGET - the control that is being validated
--   !dummyString is STRING - unused
-- Return:
--   void
--
------------------------------------------------------------------------
define method .arcToleranceValidate(!gadget is GADGET, !dummyString is STRING)

  if (!gadget.name().eq('ARCTOLERANCEG')) then
    !minimum = 0.1mm
  elseif (!gadget.name().eq('MASSARCTOLERANCEG')) then
    !minimum = 0.25mm
  else
    return
  endif
  !val = !gadget.val

  if (!val.unset()) then
    return error 1 |A value must be provided for tolerance|
  elseif (!val lt !minimum) then
    return error 1 |Minimum value for this tolerance is $!minimum |
  endif

endmethod
