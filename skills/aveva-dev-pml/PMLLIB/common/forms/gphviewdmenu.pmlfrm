--
-- File:            gphviewdmenu.pmlfrm
--   Type:          Form Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Apr 3 15:30:11 WAT 1998
--
--
-- Description:
-- Design menu settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Write data back to gphViewEdit form
--  display()                        -                   Display settings to form
--  initialise()                     -                   Initialisation for form
--
------------------------------------------------------------------------

setup form !!gphViewDMenu

  !!gphViewDMenu.formTitle     = 'Design Menus'
  !!gphViewDMenu.iconTitle     = ''
  !!gphViewDMenu.callback      = '!this.initialise()'
  !!gphViewDMenu.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition

  -- Permissible bar menu elements
  path down
  frame .mainFrame 'Main Bar'
    toggle .query     'Query' at x1 ymax      states 'FALSE' 'TRUE'
    toggle .look      'Look'                  states 'FALSE' 'TRUE'
    toggle .iso       'Isometric'             states 'FALSE' 'TRUE'
    toggle .limits    'Limits'                states 'FALSE' 'TRUE'
    toggle .rotate    'Rotate'                states 'FALSE' 'TRUE'
    toggle .clipping  'Clipping'              states 'FALSE' 'TRUE'
  exit

  frame .subFrame 'Sub Bar' at xmax+1 ymin
    toggle .construct 'Constructs' at x1 ymax states 'FALSE' 'TRUE'
    toggle .drawlist  'Drawlist'              states 'FALSE' 'TRUE'
  exit

  -- Apply/Dismiss
  button .apply  '  OK  ' at x0.5           ymax form+0.25 callback '!this.apply()' ok
  button .cancel 'Cancel' at xmax form-size ymin           cancel

  -- Form Members
  member .data    is GPHVIEWOPT

exit
-- End of form definition for !!gphViewDMenu

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialisation for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Load defaults into the form
  !this.data = !!gphViewEdit.data

  -- Set display
  !this.display()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Write data back to gphViewEdit form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Copy relevant data to gphViewEdit to gphViewOpt data object
  !!gphViewEdit.data.designQuery     = !this.query.val
  !!gphViewEdit.data.designLook      = !this.look.val
  !!gphViewEdit.data.designIso       = !this.iso.val
  !!gphViewEdit.data.designLimits    = !this.limits.val
  !!gphViewEdit.data.designRotate    = !this.rotate.val
  !!gphViewEdit.data.designClipping  = !this.clipping.val
  !!gphViewEdit.data.designConstruct = !this.construct.val
  !!gphViewEdit.data.designDrawlist  = !this.drawlist.val

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description:
--   Display settings to form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display()

  -- Set toggles
  !this.query.val     = !this.data.designQuery
  !this.look.val      = !this.data.designLook
  !this.iso.val       = !this.data.designIso
  !this.limits.val    = !this.data.designLimits
  !this.rotate.val    = !this.data.designRotate
  !this.clipping.val  = !this.data.designClipping
  !this.construct.val = !this.data.designConstruct
  !this.drawlist.val  = !this.data.designDrawlist

endmethod
-- End of method definition for .display()
