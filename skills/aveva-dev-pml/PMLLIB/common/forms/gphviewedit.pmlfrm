--
-- File:            gphviewedit.pmlfrm
--   Type:          Form Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Apr 3 14:40:13 WAT 1998
--
--
-- Description:
-- Edit for view options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Initialisation for form
--  bgColour()                       -                   Set current background colour
--  display()                        -                   Initialisation for form
--  gphViewEdit()                    -                   Constructor
--  hgColour()                       -                   Set current highlight colour
--  initialise()                     -                   Initialisation for form
--  load()                           -                   Load the defaults from file
--  save()                           -                   Save the defaults to file
--
------------------------------------------------------------------------

setup form !!gphViewEdit

  !!gphViewEdit.formTitle     = '3D View Options'
  !!gphViewEdit.iconTitle     = '3DOpts'
  !!gphViewEdit.callback      = '!this.initialise()'
  !!gphViewEdit.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition

  bar
  exit

  path down

  -- Default Title
  text .title 'Title ' at xmin y0.5 callback '!this.data.title = !this.title.val' width 30 string

--   -- View size
--   frame .sizeFrame 'View Size' at xmin ymax
--     text .width  'Width '                 width 3 is REAL
--     text .height 'Height ' at xmax+2 ymin width 2 is REAL
--   exit
--
  -- Default Settings
  frame .flagFrame 'View Settings' at x0.5 ymax+0.25

    toggle .shaded       ' Shaded'  at x2 y1 callback '!this.data.shaded      = !this.shaded.val'
    toggle .borders      ' Borders'          callback '!this.data.borders     = !this.borders.val'
    toggle .walkThrough  ' Walkthrough'      callback '!this.data.walkThrough = !this.walkThrough.val'
    toggle .longMenus    ' Long Menus'       callback '!this.data.longMenus   = !this.longMenus.val'

    -- Bar menu Data
--     frame .menuSettings 'Menus' at x1 ymax+0.25
--       button .design   '  Design...  '  at x1   ymax      callback 'show !!gphViewDMenu'
--       button .navigate ' Navigate... '  at xmin ymax+0.76 callback 'show !!gphViewNMenu'
--     exit

    -- View type
    rgroup .projection  'View Type' at xmax+1 ymin.shaded callback '!this.data.projection = !this.projection.selection()' frame vertical
      add tag ' Parallel'      select 'PARALLEL'
      add tag ' Perspective'   select 'PERSPECTIVE'
    exit

    -- Rotate about eye/model
    rgroup .rotate 'Rotate' at xmin ymax.walkThrough+0.5 callback '!this.data.rotate = !this.rotate.selection().boolean()'  frame vertical
      add tag ' about Model' select 'TRUE'
      add tag ' about Eye'   select 'FALSE'
    exit

    -- Colours
    frame .colours 'Colours' at x1 ymax.walkThrough+4
      path right
      paragraph .bgText at x1 ymax text 'Background'
      button    .bgColourButton '  '
      paragraph .bgColourText width 17 lines 1
      paragraph .hgText at xmin.bgText ymax text 'Highlight '
      button    .hgColourButton '  '
      paragraph .hgColourText width 17 lines 1

    exit

  exit

  -- Apply/Dismiss
  button .apply   '  OK  ' at x0.5           ymax form+0.25 callback '!this.apply()' ok
  button .dismiss 'Cancel' at xmax form-size ymin           callback '' cancel

  -- Form Members
  member .data    is GPHVIEWOPT

exit
-- End of form definition for !!gphViewEdit

------------------------------------------------------------------------
--
-- Method:      gphViewEdit
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphViewEdit()

  -- Load dependencies
  if(undefined(!!gphViewOpt)) then
    !gphViewOpt = object GPHVIEWOPT()
    !gphViewOpt.globalInstance()

    -- Load global instance with current settings
    -- !!gphViewOpt.load()
  endif

  -- Define Bar Menu
  !bar = !this.bar
  !bar.add('File', 'fileMenu')

  -- File Menu
  !menu = !this.newMenu('fileMenu')
    !menu.add('CALLBACK', 'Save', '!this.save()')
    !menu.add('CALLBACK', 'Load', '!this.load()')

    -- Callback for colour buttons
    !this.bgColourButton.callback = '!!colourSelectLoad(''!!gphViewEdit.bgColour()'', ''3D View Background Colour'', !!gphViewEdit.data.background.code)'
    !this.hgColourButton.callback = '!!colourSelectLoad(''!!gphViewEdit.hgColour()'', ''3D View Highlight Colour'', !!gphViewEdit.data.highlight.code)'

endmethod
-- End of method definition for .gphViewEdit()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialisation for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Load defaults into the form
  !this.data = !!gphViewOpt

  -- Set display
  !this.display()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Initialisation for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Copy data to global instance
  !!gphViewOpt = !this.data

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description:
--   Initialisation for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display()

  -- Set colours
  !this.bgColourButton.background = !this.data.background.code
  !this.bgColourText.val          = !this.data.background.name
  !this.hgColourButton.background = !this.data.highlight.code
  !this.hgColourText.val          = !this.data.highlight.name

  -- Allow title to be modified
  !this.title.val                 = !this.data.title
  !this.title.active              = !this.data.titleModifiable

  -- Set options
  !this.shaded.val                = !this.data.shaded
  !this.borders.val               = !this.data.borders
  !this.walkThrough.val           = !this.data.walkThrough
  !this.longMenus.val             = !this.data.longMenus

  -- View Type
  !this.projection.select(!this.data.projection)

  -- Rotate
  !this.rotate.select(!this.data.rotate.string())

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      bgColour
--
-- Description:
--   Set current background colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .bgColour()

  -- Get selected colour
  !this.data.background.colour(!!colourSelectGet())

  -- Set colours
  !this.bgColourButton.background = !this.data.background.code
  !this.bgColourText.val          = !this.data.background.name

endmethod
-- End of method definition for .bgColour()

------------------------------------------------------------------------
--
-- Method:      hgColour
--
-- Description:
--   Set current highlight colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .hgColour()

  -- Get selected colour
  !this.data.highlight.colour(!!colourSelectGet())

  -- Set colours
  !this.hgColourButton.background = !this.data.highlight.code
  !this.hgColourText.val          = !this.data.highlight.name

endmethod
-- End of method definition for .hgColour()

------------------------------------------------------------------------
--
-- Method:      save
--
-- Description:
--   Save the defaults to file
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .save()

  -- save all the data
  !this.data.save()

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      load
--
-- Description:
--   Load the defaults from file
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- Load  defaults
  !this.data.load()

  -- Redisplay settings
  !this.display()

endmethod
-- End of method definition for .load()
