--
--
-- Description:
-- Limits from grid system dummy form for old F3DVOL form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  deriveFromGrid()                 -                   Derive 6 planes from grid system
--  sixPlanes(ARRAY)                 -                   Apply limits from positions and directions
--
------------------------------------------------------------------------

-- Define form
setup form !!gphVolFromGrid resize

  !!gphVolFromGrid.formTitle     = 'Limits From Grid'
  !!gphVolFromGrid.iconTitle     = 'Grid'
  !!gphVolFromGrid.formRevision  = ' $Revision: 1.0 $ '

exit
-- End of form definition for !!gphVolFromGrid

------------------------------------------------------------------------
--
-- Method:      deriveFromGrid
--
-- Description:
--   Derive 6 planes from grid system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deriveFromGrid()

  -- Initialise and pass control to grid form
  if (undefined(!!gphClipFromGrid)) then
    pml load form !!gphClipFromGrid
  elseif (!!gphClipFromGrid.shown()) then
    hide !!gphClipFromGrid
  endif
  !!gphClipFromGrid.setup(!!gphVolFromGrid, |Volume from Grid|)
  show !!gphClipFromGrid

endmethod
-- End of method definition for .deriveFromGrid()

------------------------------------------------------------------------
--
-- Method:      sixPlanes
--
-- Description:
--   Apply limits from positions and directions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Position direction, position direction, ... x 6
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sixPlanes(!data is ARRAY)

  -- Apply the limits
  !worldName = |/*|
  !world = !worldName.dbref()
  !!CDRARTN[1] = !data[1].wrt(!world).east.string()
  !!CDRARTN[2] = !data[5].wrt(!world).north.string()
  !!CDRARTN[3] = !data[9].wrt(!world).up.string()
  !!CDRARTN[4] = !data[3].wrt(!world).east.string()
  !!CDRARTN[5] = !data[7].wrt(!world).north.string()
  !!CDRARTN[6] = !data[11].wrt(!world).up.string()
  !!runSynonym(|CALLIBD I3DVOL INTS SIXPLANES|)

endmethod
-- End of method definition for .sixPlanes(ARRAY, ARRAY)
