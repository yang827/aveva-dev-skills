--
--
-- Description:
-- Graphics volume edit.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Action carried out on applying form
--  close()                          -                   Close form and tidy
--  edit(GADGET)                     -                   Edit a view volume
--  gphVolumeEdit()                  -
--  init()                           -                   Action carried out on applying form
--  pick(STRING)                     -                   Set volume to item
--  positionType()                   -                   Set positionType
--  preview()                        -                   Preview the plane
--  setPosition()                    -                   Set new position
--  setup(DBREF)                     -                   Setup form with passed element
--  setup(GADGET)                    -                   Setup form with passed element
--  setup(VOLUME)                    -                   Setup form with passed element
--
------------------------------------------------------------------------

setup form !!gphVolumeEdit

  !!gphVolumeEdit.formTitle     = 'Define Volume'
  !!gphVolumeEdit.iconTitle     = 'Volume'
  !!gphVolumeEdit.callback      = '!this.init()'
  !!gphVolumeEdit.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition
  bar
  exit

  -- Positions
  frame .positionFrame 'Position'

    -- Position being modified
    option .positionType at x1 ymax callback '!this.positionType()' width 12

    path down
    halign left
    option .ew width 5
    option .ns width 5
    option .ud width 5
    text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
    text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
    text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
    toggle .xFlag at xmax+1 ymin.ew
    toggle .yFlag at xmin   ymin.ns
    toggle .zFlag at xmin   ymin.ud


    para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'

  exit

  -- Apply dismiss
  button .apply   'Apply'   at xmin form-0    ymax form+0.25 callback '!this.apply()'
  button .dismiss 'Dismiss' at xmax form-size ymin           callback '!this.close()' cancel

  -- Form Members
  member .description is STRING

  -- Aid Number
  member .aidNumber   is REAL

  -- Line definition
  member .volume      is GPHVOLUME
  -- Original
  member .original    is GPHVOLUME

  -- From/To position
  member .position    is POSITIONLINK

  -- Type of Volume
  member .view        is GADGET

exit
-- End of form definition for !!gphVolumeEdit

------------------------------------------------------------------------
--
-- Method:      gphLineEdit
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gphVolumeEdit()

  -- Selection method
  !bar = !this.bar
  !bar.add('Select', 'menuSelect')

  !menu = !this.newMenu('menuSelect')
    !menu.add('CALLBACK', 'CE',         '!this.setup(!!ce)')
    !menu.add('CALLBACK', 'Owner',      '!this.setup(!!ce.owner)')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Pick',       '!this.pick(''PICK'')')
    !menu.add('CALLBACK', 'Pick Owner', '!this.pick(''OWNER'')')

  -- Set positioning types
  !dText[1] = 'From'
  !rText[1] = 'FROM'
  !dText[2] = 'To'
  !rText[2] = 'TO'

  !this.positionType.dText = !dText
  !this.positionType.rText = !rText

  -- Link Input Gadgets to Objects
  !this.position.linkInput('!!gphVolumeEdit.position',!this.x, !this.y, !this.z)

  -- Link Lock Gadgets to Objects
  !this.position.linkLock('!!gphVolumeEdit.position',!this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Option Gadgets to Objects
var !coordinate coordinate
 !this.position.linkOption('!!gphVolumeEdit.position',!this.ew, !this.ns, !this.ud, !coordinate)

  -- Set tagging method up
  !this.position.setAction('!!gphVolumeEdit.setPosition()')

  -- Get aid number
  !this.aidNumber = !!aidNumbers.add('Edit Volume')

endmethod
-- End of method definition for .gphVolumeEdit()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--   Action carried out on applying form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .init()

-- Link Option Gadgets to Objects the current coordinate system
 var !coordinate coordinate
 !this.position.linkOption('!!gphVolumeEdit.position',!this.ew, !this.ns, !this.ud, !coordinate)


endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Action carried out on applying form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Set Volume

  -- Set view limits
  if(!this.view.set()) then
    !!gphViews.limits(!this.view, !this.volume.volume)
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Hide Modification Plane
  !!aidNumbers.hide(!this.aidNumber)

  -- Remove event
  !!edgCntrl.remove('Define Volume')

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Edit a view volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .edit(!view is GADGET)

  -- Setup form
  --!this.setup(!view)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  !packet.positionLink('!!gphVolumeEdit.position', 'Volume')
  !packet.close          = '!!aidNumbers.hide(!!gphVolumeEdit.aidNumber)'
  !packet.key            = 'volumeDefinition'
  !packet.description    = 'Define Volume'
  !packet.form           = !!gphVolumeEdit
  !packet.priority       = 2
  !packet.remove         = false
  !packet.type           = 'gph'

  -- Add into EDG packet
  if(!!edgCntrl.add(!packet)) then
    !this.setup(!view)
  endif

endmethod
-- End of method definition for .edit(GADGET)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup form with passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element volume is to be derived from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!element is DBREF)

  -- Initialise Variables
  !volume = object VOLUME(!element)

  -- Setup with volume
  !this.setup(!volume)

endmethod
-- End of method definition for .setup(DBREF)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup form with passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      View gadget to be changed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!view is GADGET)

  -- Initialise Variables
  !volume            = object VOLUME(!view)
  !this.description  = !view.owner().type & '[' & !view.owner().number & ']'
  !this.formTitle    = 'Volume - ' & !this.description

  -- Set volume type
  !this.view         = !view

  -- Setup with volume
  !this.setup(!volume)

endmethod
-- End of method definition for .setup(GADGET)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup form with passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VOLUME      Volume
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!volume is VOLUME)

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- Initialise Variables
  !this.volume   = object GPHVOLUME(!volume)
  !this.original = !this.volume

  -- Get current select datum
  !this.position.position(!this.volume.volume.attribute(!this.positionType.selection()), false, true)

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .setup(VOLUME)

------------------------------------------------------------------------
--
-- Method:      positionType
--
-- Description:
--   Set positionType
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .positionType()

  -- Get current selection
  !type = !this.positionType.selection()

  -- From position
  if(!type eq 'FROM') then
    !this.position.position(!this.volume.volume.from, true, true)

  -- To position
  else
    !this.position.position(!this.volume.volume.to, true, true)
  endif

endmethod
-- End of method definition for .positionType()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description:
--   Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Get position
  !position  = !this.position.get()

  -- Display new position
  !!aidNumbers.replace(!this.aidNumber, !this.volume)

  -- Tag Position
  !datum = !this.positionType.selection('DTEXT')
  AID TEXT NUMB $!this.aidNumber '$!datum - $!this.description' AT $!position

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description:
--   Set new position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setPosition()

  -- Initialise Variables
  !this.volume.volume.attribute(!this.positionType.selection()) = !this.position.get()

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .setPosition()

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description:
--   Set volume to item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option : PICK or OWNER
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick(!option is STRING)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  if(!option.upcase() eq 'OWNER') then
    !packet.elementPick('Pick item, which owner is to be used for volume')
    !packet.action       = '!!gphVolumeEdit.setup(!this.return[1].item.owner)'
  else
    !packet.elementPick('Pick item to be used for volume')
    !packet.action       = '!!gphVolumeEdit.setup(!this.return[1].item)'
  endif

  !packet.key            = 'defineVolume'
  !packet.description    = 'Volume'
  !packet.priority       = 3
  !packet.remove         = true
  !packet.type           = 'gph'

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pick(STRING)
