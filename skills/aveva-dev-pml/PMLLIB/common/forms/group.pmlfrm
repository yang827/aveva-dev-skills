------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addAllToView(BOOLEAN)            -                   add all grid items to the view
--  addCE()                          -                   add the explorer item to the group
--  addCEMem()                       -                   add the explorer item members to the group
--  addList()                        -                   add items from the current list
--  addSelToView(BOOLEAN)            -                   add the selected grid items to the view
--  changeSelection(ARRAY)           -                   Navigate the element which is selected in the explorer Control
--  gpses()                          -                   find out the members of the gpses
--  gpsets()                         -                   find out the members of the gpsets
--  gridSelection()                  ARRAY               Return selection for currently displayed grid
--  group()                          -                   Constructor
--  init()                           -                   initialise the form
--  navigate()                       -                   navigate to the first selected grid member
--  remList()                        -                   rem items from the current list
--  removeAll()                      -
--  removeCE()                       -                   remove the explorer item from the group
--  removeCEMem()                    -                   remove the explorer item members to the group
--  removeSel()                      -
--  rightClickExplorer(ARRAY)        -                   set up the popup menus for the explorer
--  rightClickGrid(ARRAY)            -                   set up the popup menus for the grid
--  track()                          -                   set the PML explorer if the design explorer is changed
--

import 'GridControl'
handle any
endhandle
import 'ExplorerAddin'
handle any
endhandle

using namespace 'Aveva.Pdms.Presentation'

setup form !!group dialog dock R

   member .groupMemGrid is NETGRIDCONTROL
   member .designExplorer  is PMLEXPLORERCONTROL
   member .explorerMember is DBREF

  bar
  exit
  track    |DESICE| call |!this.track()|

  container .explorerFrame nobox PMLNETCONTROL 'NET' anchor t+l+b  width 30 height 26

  menu .pmlpopupexplorer
  !this.pmlpopupexplorer.add( 'CALLBACK', 'Add Current Element',            '!this.addCE()'  ,'addce')
  !this.pmlpopupexplorer.add( 'CALLBACK', 'Add Current Element Members',    '!this.addCEMem()' , 'addcemem' )
  !this.pmlpopupexplorer.add( 'CALLBACK', 'Remove Current Element',         '!this.removeCE()' , 'remce' )
  !this.pmlpopupexplorer.add( 'CALLBACK', 'Remove Current Element Members', '!this.removeCEMem()','remcemem')
  !this.pmlpopupexplorer.add( 'CALLBACK', 'Add From Current List',          '!this.addList()','addlist' )
  !this.pmlpopupexplorer.add( 'CALLBACK', 'Remove From Current List',       '!this.remList()' , 'remlist')
  !this.pmlpopupexplorer.add( 'SEPARATOR')
  !this.pmlpopupexplorer.add( 'MENU', '3D View',                            'PMLexplorerSub' )
  !this.pmlpopupexplorer.add( 'SEPARATOR')
  !this.pmlpopupexplorer.add( 'form', 'Create Group world...',          'creategpwl' ,'cregpwl')
  !this.pmlpopupexplorer.add( 'form', 'Create Group Sets...',           'creategpset','cregpset' )

  menu .pmlpopupgrid
  !this.pmlpopupgrid.add( 'CALLBACK', 'Remove All From Group',               '!this.removeAll()' )
  !this.pmlpopupgrid.add( 'CALLBACK', 'Remove Selected From Group',          '!this.removeSel()' )
  !this.pmlpopupgrid.add( 'SEPARATOR')
  !this.pmlpopupgrid.add( 'MENU', '3D View',                                 'PMLPopupSub' )
  !this.pmlpopupgrid.add( 'CALLBACK', 'Navigate',                            '!this.navigate()' )
  !this.pmlpopupgrid.add('separator')
  !this.pmlpopupgrid.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.groupMemGrid, ||, |Save Group Data As|)' )
  !this.pmlpopupgrid.add( 'callback', 'Print Preview...', '!this.groupMemGrid.printpreview()' )
  menu .pmlpopupsub
  !this.pmlpopupsub.add( 'CALLBACK', 'Add All',                     '!this.addAllToView(TRUE)' )
  !this.pmlpopupsub.add( 'CALLBACK', 'Add Selected',                '!this.addSelToView(TRUE)' )
  !this.pmlpopupsub.add( 'CALLBACK', 'Remove All',                  '!this.addAllToView(FALSE)' )
  !this.pmlpopupsub.add( 'CALLBACK', 'Remove Selected',             '!this.addSelToView(FALSE)' )
  menu .pmlexplorersub
  !this.pmlexplorersub.add( 'CALLBACK', 'Add CE',                    'ADD $$!this.explorermember' )
  !this.pmlexplorersub.add( 'CALLBACK', 'Remove CE',                 'REM $$!this.explorermember' )

  path right

  list .gpsets  |Available group sets :| anchor r+t+l width 50 length 5
  path down
  container .netGroupMemFrame nobox PmlNetControl |Group Members:| anchor all width 50 height 20
exit

------------------------------------------------------------------------
--
-- Method:      group()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .group()

  using namespace 'Aveva.Pdms.Presentation'

  !this.designExplorer = object PMLEXPLORERCONTROL()
  -- Add .Net controls to PML containers
  !this.explorerFrame.control = !this.designExplorer.handle()
  !this.designExplorer.addeventhandler('OnPopup', !this, 'rightClickExplorer')
  !this.designExplorer.addeventhandler('OnSelectionChanged',!this,'changeSelection')

  -- Add instances of .Net control
  !this.groupMemGrid = object NETGRIDCONTROL()

  -- Add .Net controls to PML containers
  !this.netGroupMemFrame.control = !this.groupMemGrid.handle()

   -- add PML event handlers to .Net control
   !this.groupMemGrid.addeventhandler('OnPopup', !this, 'rightClickGrid')

  !this.designExplorer.initialise('/*','')

-- Define bar menu
  !bar = !this.bar
  !bar.add('Create','create')

  !menu = !this.newMenu('create')
  !menu.add('FORM',     'Group World...',    'creategpwl',    'crgpwl')
  !menu.add('FORM',     'Group Set...',    'creategpset',     'crgpset')


-- form setup
   !this.formTitle       = 'Groups'
   !this.iconTitle       = 'GROUP'
   !this.callback        = '!this.init()'
   !this.formRevision    = ' '

-- callbacks
   !this.gpsets.callback = '!this.gpsets()'

endmethod


------------------------------------------------------------------------
--
-- Method:     init()
--
-- Description: initialise the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

 using namespace  'Aveva.Pdms.Presentation'

-- Reset DB root
 !this.designExplorer.resetRoot('/*')

  -- Set parameters
!this.groupMemGrid.columnExcelFilter(TRUE)
!this.groupMemGrid.outlookGroupStyle(TRUE)
!this.groupMemGrid.fixedHeaders(TRUE)
!this.groupMemGrid.fixedRows(TRUE)
!this.groupMemGrid.columnSummaries(TRUE)

  -- Clear any existing data
!this.groupMemGrid.clearGrid()
!this.designExplorer.selectElement(!!ce.name)
!this.gpses()

endmethod

-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:     gpses()
--
-- Description: find out the members of the gpses
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gpses()

  !gpsetDtext = ARRAY()
  !gpsetRtext = ARRAY()

  var !gpse coll all gpset for world
  do !i values !gpse
    !gpsetDtext.append(!i.dbref().fullname)
    !gpsetRtext.append(!i.dbref().name)
  enddo

  !this.gpsets.dtext = !gpsetDtext
  !this.gpsets.rtext = !gpsetRtext
  if (!gpse.size() neq 0 ) then
    !this.gpsets()
  endif

endmethod
-- End of method definition for .gpses()
------------------------------------------------------------------------
--
-- Method:     gpsets()
--
-- Description: find out the members of the gpsets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gpsets()

  using namespace  'Aveva.Pdms.Presentation'
    -- Set headings
  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('Type')

  !groupMemNames=ARRAY()
  !select = !this.gpsets.selection()
  if (!select eq '') then
    !this.gpsets.val = 1
  endif
  !element = !this.gpsets.selection().dbref()
  !groupMem=!element.mem
  !errors = 0
  do !i values !groupMem
    if(!i.type.eq ('GPSET'))then
    	!cemem = !i.sexpnd
    	do !j values !cemem
    	  if(!j.badref().not())then
    	  	!groupMemNames.append(!j.name)
    	  endif
    	enddo
    endif
    if (!i.type.eq('GPITEM') and !i.sitem.badref().not()) then
    	if(!i.sitem.type.eq('GPSET'))then
    		!members = !i.sitem.mem
    		do !mems values !members
    		  !groupMemNames.append(!mems.sitem.name)
    		enddo
    	else
    		!groupMemNames.append(!i.sitem.name)
    	endif
    else
      if (!i.type.eq('GPITEM')) then
        !errors = !errors + 1
        -- warn only once that there is a badref group item
        if (!errors eq 1) then
          !!alert.warning('There is at least 1 group item with a bad reference')
        endif
      endif
    endif
  enddo
  !ti = 'Group Members'
  !mainGridElements  = object ARRAY()
  !groupMemNames.unique()
  do !i indices !groupMemNames
    !mainGridElements[!i][1] = !groupMemNames[!i].dbref().name
    !mainGridElements[!i][2] = !groupMemNames[!i].dbref().acttype
  enddo

  !nds = object NETDATASOURCE(!ti, !headings, !mainGridElements)
  !this.groupMemGrid.bindToDataSource(!nds)
  !this.groupMemGrid.setNameColumnImage()
  handle any
  endhandle

endmethod
-- End of method definition for .gpsets()
------------------------------------------------------------------------
--
-- Method:     addCE()
--
-- Description: add the explorer item to the group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addCE()

!!ce = !this.explorerMember
!item = !!ce
!!ce = !this.gpsets.selection().dbref()
gadd $!item
!this.gpsets()
!!ce = !this.explorerMember

endmethod
-- End of method definition for .addCE()
------------------------------------------------------------------------
--
-- Method:     removeCE()
--
-- Description: remove the explorer item from the group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeCE()

!!ce = !this.explorerMember
!item = !!ce
!!ce = !this.gpsets.selection().dbref()
grem $!item
!this.gpsets()
!!ce = !this.explorerMember

endmethod
-- End of method definition for .addCE()

------------------------------------------------------------------------
--
-- Method:      rightClickExplorer
--
-- Description: set up the popup menus for the explorer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rightClickExplorer(!data is ARRAY)

  if (!this.gpsets.count eq 0) then
    !this.pmlpopupexplorer.setFieldProperty('addce','ACTIVE',FALSE)
    !this.pmlpopupexplorer.setFieldProperty('addcemem','ACTIVE',FALSE)
    !this.pmlpopupexplorer.setFieldProperty('remce','ACTIVE',FALSE)
    !this.pmlpopupexplorer.setFieldProperty('remcemem','ACTIVE',FALSE)
    !this.pmlpopupexplorer.setFieldProperty('addlist','ACTIVE',FALSE)
    !this.pmlpopupexplorer.setFieldProperty('remlist','ACTIVE',FALSE)
  else
    !this.pmlpopupexplorer.setFieldProperty('addce','ACTIVE',TRUE)
    !this.pmlpopupexplorer.setFieldProperty('addcemem','ACTIVE',TRUE)
    !this.pmlpopupexplorer.setFieldProperty('remce','ACTIVE',TRUE)
    !this.pmlpopupexplorer.setFieldProperty('remcemem','ACTIVE',TRUE)
    !this.pmlpopupexplorer.setFieldProperty('addlist','ACTIVE',TRUE)
    !this.pmlpopupexplorer.setFieldProperty('remlist','ACTIVE',TRUE)

  endif
  !this.explorerFrame.popup = !this.pmlpopupexplorer
  !this.explorerFrame.showPopup(!data[0], !data[1])
  !this.explorerMember = !data[2].dbref()
  handle (2,118) $* Illegal Reference
	endhandle
	
endmethod
-- End of method definition for .rightClickExplorer()


------------------------------------------------------------------------
--
-- Method:      changeSelection
--
-- Description: Navigate the element which is selected in the explorer Control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeSelection(!data is ARRAY)
	
	!this.explorerMember = !data[0].dbref()	
  handle (2,118) $* Illegal Reference
	endhandle
	!!ce = !this.explorerMember
	if(!!ce.type eq 'GPWL' or !!ce.type eq 'GPSET')then
		!this.pmlpopupexplorer.setFieldProperty('cregpset','visible',true)
		!this.gpses()
	else
	  !this.pmlpopupexplorer.setFieldProperty('cregpset','visible',false)
	endif
	
endmethod
-- End of method definition for .changeSelection()



------------------------------------------------------------------------
--
-- Method:      rightClickGrid
--
-- Description: set up the popup menus for the grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rightClickGrid(!data is ARRAY)

  !this.netGroupMemFrame.popup = !this.pmlpopupgrid
  !this.netGroupMemFrame.showPopup(!data[0], !data[1])

endmethod
-- End of method definition for .rightClickExplorer()

------------------------------------------------------------------------
--
-- Method:     addCEMem()
--
-- Description: add the explorer item members to the group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addCEMem()

!!ce = !this.explorerMember
!mem = !!ce.members
!!ce = !this.gpsets.selection().dbref()

do !i values !mem
  gadd $!i
enddo

!this.gpsets()
!!ce = !this.explorerMember

endmethod
-- End of method definition for .addCEMem()
------------------------------------------------------------------------
--
-- Method:     removeCEMem()
--
-- Description: remove the explorer item members to the group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeCEMem()

!!ce = !this.explorerMember
!mem = !!ce.members
!!ce = !this.gpsets.selection().dbref()

do !i values !mem
  grem $!i
enddo

!this.gpsets()
!!ce = !this.explorerMember

endmethod
-- End of method definition for .removeCEMem()

------------------------------------------------------------------------
--
-- Method:      gridSelection
--
-- Description: Return selection for currently displayed grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Selection for currently displayed grid
--
------------------------------------------------------------------------

define method .gridSelection() is ARRAY

 !gridSelection = !this.groupMemGrid.getSelectedRowTags()
 !selectedGridValues  = object ARRAY()
 do !selectedValues index !gridSelection
   !selectedGridValues.append(!this.groupMemGrid.getSelectedRows()[!selectedValues][1])
  enddo
  return !selectedGridValues

endmethod
-- End of method definition for .gridSelection() is ARRAY

------------------------------------------------------------------------
--
-- Method:     RemoveSel()
--
-- Description: remove the selected grid items from the group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeSel()

!arrayOfTags=object ARRAY()
--!arrayOfTags = !this.gridSelection()
!ind 				= !this.groupMemGrid.getSelectedRows()
do !value values !ind
   !arrayOfTags.append(!value[1])
enddo
!ce=!!ce
!!ce = !this.gpsets.selection().dbref()
do !i values !arrayOfTags
  grem $!i
enddo

!this.gpsets()
!!ce = !ce

endmethod
-- End of method definition for .removeSel()
------------------------------------------------------------------------
--
-- Method:     addSelToView()
--
-- Description: add the selected grid items to the view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addSelToView(!mode is BOOLEAN)

!arrayOfTags=!this.gridSelection()
do !i values !arrayOfTags
  if !mode then
  add $!i
  else
    rem $!i
  endif
enddo

endmethod
-- End of method definition for .removeSel()
------------------------------------------------------------------------
--
-- Method:     RemoveAll()
--
-- Description: remove all grid items from the group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeAll()

!num=!this.groupMemGrid.getNumberRows()
do !i to !num
  !this.groupMemGrid.selectRow(!i)
enddo
!this.removeSel()

endmethod
-- End of method definition for .removeSel()
------------------------------------------------------------------------
--
-- Method:     addAllToView()
--
-- Description: add all grid items to the view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addAllToView(!mode is BOOLEAN)

!num=!this.groupMemGrid.getNumberRows()
do !i to !num
  !this.groupMemGrid.selectRow(!i)
enddo
!this.addSelToView(!mode)

endmethod
-- End of method definition for .removeSel()
------------------------------------------------------------------------
--
-- Method:     navigate()
--
-- Description: navigate to the first selected grid member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigate()

  !arrayOfTags=!this.gridSelection()
  if (defined(!arrayOfTags[1])) then
    if (not badref(!arrayOfTags[1].dbref())) then
      !!ce = !arrayOfTags[1].dbref()
    endif
  endif

endmethod
-- End of method definition for .navigate()
------------------------------------------------------------------------
--
-- Method:     track()
--
-- Description: set the PML explorer if the design explorer is changed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track()

!this.designExplorer.selectElement(!!ce.name)

endmethod
-- End of method definition for .track()
------------------------------------------------------------------------
--
-- Method:     addList()
--
-- Description: add items from the current list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addList()

if (!!cdclist.name.dtext[1] eq 'No list') then
  !!alert.error('No Lists defined')
  if (!!cdclist.shown().not()) then
    show !!cdclist
  endif
else
  !listNum = !!cdclist.name.val.string()
  !list = '!!cdlist' & !listNum
  if (undefined($!list)) then
    !!alert.error('No items in the current list')
    if (!!cdclist.shown().not()) then
      show !!cdclist
    endif
  else
    !ce = !!ce
    !!ce = !this.gpsets.selection().dbref()
    do !i values $!list
      gadd $!i
      handle (2,856)$* Item already added
      elsehandle any
        !!alert.error(!!error.text)
      endhandle
    enddo
    !this.gpsets()
    !!ce=!ce
  endif
endif

endmethod
-- End of method definition for .addList()
------------------------------------------------------------------------
--
-- Method:     remList()
--
-- Description: rem items from the current list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remList()

if (!!cdclist.name.dtext[1] eq 'No list') then
  !!alert.error('No Lists defined')
  if (!!cdclist.shown().not()) then
    show !!cdclist
  endif
else
  !listNum = !!cdclist.name.val.string()
  !list = '!!cdlist' & !listNum
  if (undefined($!list)) then
    !!alert.error('No items in the current list')
    if (!!cdclist.shown().not()) then
      show !!cdclist
    endif
  else
    !ce = !!ce
    !!ce = !this.gpsets.selection().dbref()
    do !i values $!list
      grem $!i
    enddo
    !this.gpsets()
    !!ce=!ce
  endif
endif

endmethod
-- End of method definition for .addList()
