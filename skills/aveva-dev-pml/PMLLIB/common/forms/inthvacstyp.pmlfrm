import 'MMServices'
handle any
endhandle
----------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
--  File:            inthvacstyp.pmlfrm
--    Type:          Form Definition
--    Group:         Integrator
--      Keyword:     Integrator
--    Module:        Integrator
--  Author:          Mac Lewis
--  Created:         Tue Mar 26 10:15:09 2008

--
--  Description:     Set appropriate SCSTYP on SCHVFI
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Set scstyp
--  ductShape(REAL)                  STRING              Check duct shape is legal
--  init()                           -                   Initialisation for form
--  intHvacStyp()                    -                   Constructor
--  track()                          -                   Track CE callback
--  track(GADGET,STRING)             -                   Track CE option
--  trnsShape(STRING,STRING)         STRING              Return shape code for transition piece
--

-- Define form
setup form !!intHvacStyp dialog docking

  !this.formTitle     = 'Schematic HVAC Fitting Scstyp'
  !this.iconTitle     = 'Styp'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.00 $ '

  -- CE button and label
  button .schCE  |CE|    anchor top+left
  toggle .track  |Track| anchor top+left at xmax+1 ymin tagwidth 5 states |FALSE| |TRUE|
  para   .name anchor top+left at xmin.schCE ymax+0.2 width 50 lines 1
  para   .gtyp anchor top+left at xmin.name ymax width 10 lines 1
  para   .styp anchor top+left at xmax ymin width 12 lines 1
  para   .shape anchor top+left at xmax ymin width 18 lines 1
  path down

  -- Scstyp list
  list .scstyp |Available Scstyps| anchor all at xmin.schCE ymax+0.2 width 50 height 6

  -- Buttons
  button .apply |Apply| anchor bottom+left at xmin ymax+0.2 width 5
  button .close |Close| anchor bottom+right at xmax form-size ymin width 5 ok

  -- Track CE
  track |SCHECE| call |!this.track()|

  -- Form element
  member .element   is DBREF

exit

-- End of form definition for !!intHvacStyp

------------------------------------------------------------------------
--
-- Method:      .intHvacStyp()
--
-- Description: Constructor
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .intHvacStyp()

  -- Callbacks
  !this.schCE.callback  = |!this.init()|
  !this.track.callback  = |!this.track(|
  !this.apply.callback  = |!this.apply()|

  -- Set headings
  !headText = ARRAY()
  !headText.append(|Default|)
  !headText.append(|STYP|)
  !headText.append(|Description|)
  !this.scstyp.setHeadings(!headText)

endmethod
-- End of method definition for .intHvacStyp()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialisation for form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  using namespace 'Aveva.Pdms.MMServices'

  -- Initialise
  !this.element   = !!ce
  !this.name.val  = ||
  !this.gtyp.val  = ||
  !this.styp.val  = ||
  !this.shape.val = ||
  !this.scstyp.clear()
  !this.apply.active  = FALSE
  !this.scstyp.active = FALSE

  -- Get HVAC fitting details
  if (!this.element.type eq |SCHVFI|) then
    !this.name.val  = !this.element.flnm
    !this.gtyp.val  = |Gtyp | & !this.element.gtyp
    !this.styp.val  = |Scstyp | & !this.element.scstyp
    !this.shape.val = |Ductshape | & !this.ductShape(1)
    if (!this.element.gtyp eq |TRNS|) then
      !this.shape.val = !this.shape.val & | | & !this.ductShape(2)
    endif

    -- Populate list with available scstyps
    !stypes = ARRAY()
    !hvacTable = object HVACSTYPETABLE()
    !hvacStypes = !hvacTable.stypesForGtypeAndShape(!this.element.gtyp, !this.ductShape(1))
    handle any
      return error 1 |Integrator HVAC stypes table is not available|
    endhandle
    do !hvacStype values !hvacStypes
       -- Get default flag, scstyp and description for list
      !stype = ARRAY()
      if (!hvacStype.isDefault()) then
        !stype[1] = |Default|
      else
        !stype[1] = ||
      endif
      !stype[2] = !hvacStype.scstype()
      !stype[3] = !hvacStype.description()
      !stypes.append(!stype)
    enddo
    -- Replacement text is scstyp
    !rtext = ARRAY()
    do !stype val !stypes
      !rtext.append(!stype[2])
    enddo
    !this.scstyp.setRows(!stypes)
    !this.scstyp.rtext = !rtext

    -- Select current scstyp
    if (!this.element.gtyp eq |TRNS|) then
      -- Transition piece determined by shapes
      !scstyp = !this.trnsShape(!this.ductShape(1), !this.ductShape(2))
    elseif (!this.element.scstyp.trim() eq ||) then
      -- Default scstyp
      !scstyp = ||
      !hvacStype = !hvacTable.defaultStype(!this.element.gtyp, !this.ductShape(1))
      handle any
        -- No value returned
      elsehandle none
        if (!hvacStype.set()) then
          !scstyp = !hvacStype.scstype()
        endif
      endhandle
    else
      -- Objects own scstyp
      !scstyp = !this.element.scstyp
    endif
    !this.scstyp.select(|Rtext|, !scstyp)
    handle any
    endhandle

    -- Activate gadgets
    !this.scstyp.active = TRUE
    !this.apply.active  = (!this.scstyp.rtext.size() gt 0 and !this.element.gtyp ne |TRNS|)
  endif

endmethod
-- End of method definition for .init()

-----------------------------------------------------------------------
--
-- Method:      ductShape
--
-- Description:
--   Check duct shape is legal
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Ppoint
-- Return:
--   [Data Type] [Description]
--    STRING      Modified shape
--
------------------------------------------------------------------------
define method .ductShape(!ppoint is REAL) is STRING

  -- Check duct shape is legal
  !shape = |unset|
  !conn = !this.element.conarray[!ppoint]
  handle any
    !conn = ||
  endhandle
  if (!conn inset(|RECT|, |OVAL|, |CIRC|)) then
    !shape = !conn
  endif
  return !shape

endmethod
-- End of method definition for ductShape(REAL) is STRING

------------------------------------------------------------------------
--
-- Method:      trnsShape
--
-- Description:
--   Return shape code for transition piece
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Ppoint1 shape
--    2   R      STRING      Ppoint2 shape
-- Return:
--   [Data Type] [Description]
--    STRING      Shape code
--
------------------------------------------------------------------------
define method .trnsShape(!conArri is STRING, !conLeav is STRING) is STRING

  -- Get duct shape code (arri and leav indexes here are used 1 and 2)
  if (!conArri eq |RECT| and !conLeav eq |CIRC|) then
    !ductShape = |SQRD|
  elseif (!conArri eq |RECT| and !conLeav eq |OVAL|) then
    !ductShape = |SQFO|
  elseif (!conArri eq |OVAL| and !conLeav eq |CIRC|) then
    !ductShape = |FORD|
  elseif (!conArri eq |OVAL| and !conLeav eq |OVAL|) then
    !ductShape = |FOFO|
  else
    !ductShape = ||
  endif
  return !ductShape

endmethod
-- End of method definition for trnsShape(STRING, STRING) is STRING

------------------------------------------------------------------------
--
-- Method:      .track()
--
-- Description: Track CE callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .track()

  -- Track CE
  if (!this.track.val) then
    !this.init()
  endif

endmethod
-- End of method definition for .track()

------------------------------------------------------------------------
--
-- Method:      .track()
--
-- Description: Track CE option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .track(!dummyGadget is GADGET, !dummyAction is STRING)

  -- Tracking and CE buttons are mutually exclusive
  !this.schCE.active = !this.track.val.not()
  !this.init()

endmethod
-- End of method definition for .track()

------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Set scstyp
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- Set scstyp and refresh form
  !this.element.scstyp = !this.scstyp.selection()
  !dbpos = !!ce
  !!ce = !this.element
  !this.init()
  !!ce = !dbpos

endmethod
-- End of method definition for .apply()
