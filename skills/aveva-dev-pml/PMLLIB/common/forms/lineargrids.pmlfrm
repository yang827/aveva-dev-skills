--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jan 12 10:44:49 WAT 1998
--
--
-- Description:
-- Linear Grid Definition.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Carried out action on applying form
--  close()                          -                   Close form and tidy
--  initialise()                     -                   Initialisation of form
--  lineNumber()                     -                   Setup to define orientation using edg
--  linearGrids()                    -                   Constructor
--  pickOrientation(STRING)          -                   Setup to define orientation using edg
--  preview(BOOLEAN)                 -                   Preview the plane
--  setWrt()                         -                   Set up with new wrt item
--  setup(REAL)                      -                   Setup data for form to be shown
--  setup(STRING,STRING,GPHLINEARGRID) -                   Show the form and set up with passed data
--  setupForm()                      -                   Setup form to current grid definition
--  tidy()                           -                   Tidy form data
--  updateAid(REAL)                  -                   Update/create passed aid number with plane definition
--
------------------------------------------------------------------------

-- Define form
setup form !!linearGrids

  !!linearGrids.formTitle     = 'Linear Grids'
  !!linearGrids.iconTitle     = 'LGrids'
  !!linearGrids.callback      = '!this.initialise()'
  !!linearGrids.formRevision  = ' $Revision: 1.15 $ '

  -- Body of form definition
  -- Options
  frame .optionFrame 'Options' at x0.2  ymax

    toggle .label     ' Label ' at x2   ymax states 'FALSE' 'TRUE'
    toggle .detail    ' Detail' at xmin ymax states 'FALSE' 'TRUE'

    text   .nLines    'Number of visible lines ' at xmin+4 ymax callback '!this.lineNumber()' width 3 is REAL format !!integerFmt

    -- Spacing
    frame .spacingFrame 'Spacing' at xmin ymax
      text .xSpaces 'X ' width 14 is REAL format !!distanceFmt
      path down
      text .ySpaces 'Y ' width 14 is REAL format !!distanceFmt
    exit

    -- Preview Change
    path right
    valign bottom
    button .previewSpacing 'Preview' callback '!this.preview(false)'

  exit

  -- Positioning Gadgets
  frame .posOriFrame 'Position & Orientation' at xmin ymax+0.2
    -- Positioning Gadgets
    frame .positionFrame 'Position' at x1 ymax+0.2
      path down
      option .ew at x1 y1.5 width 5
      option .ns width 5
      option .ud width 5
      text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
      text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
      text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
      toggle .xFlag at xmax+1 ymin.ew
      toggle .yFlag at xmin   ymin.ns
      toggle .zFlag at xmin   ymin.ud
      para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'

    exit

    -- Orientation Gadgets and Setting
    frame .orientationFrame 'Orientation' at xmin ymax+0.2

      -- EDG Set orientation
      button .edgOri3 pixmap width 24 height 24 tooltip 'Through three points'  callback '!this.pickOrientation(''3picks'')'
      path right
      button .edgOri2 pixmap width 24 height 24 tooltip 'Through origin and two points'  callback '!this.pickOrientation(''2picks'')'

      text .yDir 'Y is ' at x1   ymax+0.25 width 24 is STRING
      text .zDir 'Z is ' at xmin ymax width 24 is STRING
      halign right
      path down
      paragraph .xDir width 31 lines 1
      halign left
    exit
  exit

  --  Reference (wrt)
  halign right
  text .wrt 'wrt' callback '!!linearGrids.setWrt()' width 26 string

  -- Apply/Dismiss
  button .apply   ' OK '   at xmin form-0    ymax form+0.25 callback '!this.apply()' ok
  button .dismiss 'Cancel' at xmax form-size ymin           callback '!this.close()' cancel

  -- Form Members
  -- Plane definition
  member .grid         is GPHLINEARGRID

  -- Aid number being modified
  member .aidGrid      is REAL

  -- Aid numbers for position & axes
  member .aidNumber    is REAL

  -- Form Control Members
  -- Position
  member .position     is POSITIONLINK
  -- Orientation
  member .orientation  is ORIENTATIONLINK

  -- Description
  member .description  is STRING
  !!linearGrids.description = 'Default Linear Grid Definition'

  -- Action on apply
  member .action       is STRING

exit
-- End of form definition for !!linearGrids

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Link Position Option Gadgets to Objects with current coordinate system

  var !coordinate coordinate
  !this.position.linkOption('!!linearGrids.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Actions to null so nothing happens
  !this.position.setAction('')
  !this.orientation.setAction('')

  -- Setup form
  !this.setupForm()

  -- Set Actions
  !this.position.setAction('!!linearGrids.preview(true)')
  !this.orientation.setAction('!!linearGrids.preview(true)')
  !!linearGrids.preview(true)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      linearGrids
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .linearGrids()

  -- set icons
  !this.edgOri3.addPixmap(!!pml.getPathName('ori3points24.png'))
  !this.edgOri2.addPixmap(!!pml.getPathName('ori2points24.png'))

   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!linearGrids.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!linearGrids.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!linearGrids.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Link Orientation Gadgets to Object
  !this.orientation.linkInput('!!linearGrids.orientation', 'Y', !this.yDir, 'Z', !this.zDir, 'X', !this.xDir)

  -- Set Orientation Action
  !this.orientation.setAction('!!linearGrids.preview(true)')

  -- Aid Lines Number
  if(!this.aidNumber.unset()) then
    !this.aidNumber = !!aidNumbers.add(!this.grid)
  endif

endmethod
-- End of method definition for .linearGrids()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)
  !this.orientation.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Tidy form data
  !this.tidy()

  -- Revert the edg graphics back
  !!edgCntrl.remove(!this.description)

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide Modification Grid
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:   Carried out action on applying form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Current Data
  !position    = !this.position.get()
  !orientation = !this.orientation.get()

  -- Write data to plane member
  !this.grid.tag           = !this.label.val
  !this.grid.detail        = !this.detail.val
  !this.grid.basic         = false
  !this.grid.position(!position)
  !this.grid.orientation(!orientation)
  !this.grid.grid.xSpacing = !this.xSpaces.val
  !this.grid.grid.ySpacing = !this.ySpaces.val

  -- Modifying an aid or carry out an action
  if(!this.aidGrid.set()) then
    !!aidNumbers.replace(!this.aidGrid, !this.grid)

  -- Carry out action
  else
    $!this.action
  endif

  -- Close
  !this.close()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number being modified/created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Initialise form action
  !this.action            = STRING()

  -- Set form data
  !this.aidGrid           = !aidNumber
  !this.formTitle         = 'Modify grid [' & !aidNumber & ']'
  !this.grid              = !!aidNumbers.numbers[!aidNumber]
  !this.description       = 'Edit aid linear grid definition'

  -- If already shown, then re-initialise
  if(!this.shown()) then
    !this.setupForm()
  endif

endmethod
-- End of method definition for .setup(REAL)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Show the form and set up with passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      STRING        Description
--    2   R      STRING        Action to be carried out on apply
--    3   R      GPHLINEARGRID Reference plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!description is STRING, !actionCommand is STRING, !newGrid is GPHLINEARGRID)

  -- Define Action on apply
  !this.action           = !actionCommand

  -- Set form data
  !this.aidGrid          = REAL()
  !this.grid             = !newGrid
  !this.formTitle        = !description
  !this.description      = !description

  -- If already shown, then re-initialise
  if(!this.shown()) then
    !this.setupForm()
  endif

endmethod
-- End of method definition for .setup(STRING, STRING, GPHLINEARGRID)

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description: Setup form to current grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupForm()

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- If plane is unset, then initialise it to default 000
  if(!this.grid.coreObject().unset()) then
    !this.grid.position(object POSITION('E0 N0 U0'))
    !this.grid.orientation(object ORIENTATION('Y is N'))
    !this.grid.x             = 10
    !this.grid.y             = 10
  endif

  -- Set spacing, if unset
  if(!this.grid.grid.ySpacing.unset()) then
    !this.grid.grid.xSpacing = 1000mm
    !this.grid.grid.ySpacing = 1000mm
  endif

  -- Get basic core object
  !plane = !this.grid.plane()

  -- Set display toggles
  !this.label.val  = !this.grid.tag
  !this.detail.val = !this.grid.detail

  -- Set with respect to
  !this.position.setWrt(!plane.position.origin)
  !this.orientation.setWrt(!plane.position.origin)

  -- Load form with plane definition
  !this.position.setPositionForce(!plane.position)
  !this.orientation.setOrientation(!plane.orientation)

  -- Set spacing
  !this.xSpaces.val = !this.grid.grid.xSpacing
  !this.ySpaces.val = !this.grid.grid.ySpacing

  -- Set display options
  !this.label.val   = !this.grid.tag
  !this.detail.val  = !this.grid.detail
  !this.nLines.val  = !this.grid.x

  -- Set form wrt gadget
  !this.setWrt()

endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for Basic representation of grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview(!basic is BOOLEAN)

  -- Current Data
  !position    = !this.position.get()
  !orientation = !this.orientation.get()

  -- Write data to plane member
  !this.grid.tag          = !this.label.val
  !this.grid.detail       = !this.detail.val
  !this.grid.basic        = !basic
  !this.grid.position(!position)
  !this.grid.orientation(!orientation)
  !this.grid.grid.xSpacing = !this.xSpaces.val
  !this.grid.grid.ySpacing = !this.ySpaces.val
  !this.grid.x             = !this.nLines.val
  !this.grid.y             = !this.nLines.val

  -- Replace current definition
  !!aidNumbers.replace(!this.aidNumber, !this.grid)

endmethod
-- End of method definition for .preview(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      pickOrientation
--
-- Description: Setup to define orientation using edg
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Ori definition type  3picks
--                                                2picks
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pickOrientation(!type is STRING)

  -- Define a pickpacket
  !packet          = object EDGPACKET()
  !packet.orientationLink('!!linearGrids.orientation', 'Orientate Plane')

  -- Two pick plane
  if(!type.upcase() eq '2PICKS') then
    -- Define specific for "definePlane" orientation
    !packet.pickPacket.plane2Pnts(!this.position.get())
  endif

  !packet.remove   = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickOrientation(STRING)

------------------------------------------------------------------------
--
-- Method:      lineNumber
--
-- Description: Setup to define orientation using edg
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .lineNumber()

  -- Check for sensible input
  if (!this.nLines.val.between(2,1000).not()) then
    !!alert.error('Number must be between 2 and 1000')
    !this.nLines.val = 10
    return
  endif

  -- Return an even number
  !value           = INT(!this.nLines.val / 2) * 2
  !this.nLines.val = !value

  -- Set grid definition
  !this.grid.x     = !value
  !this.grid.y     = !value

endmethod
-- End of method definition for .lineNumber()

------------------------------------------------------------------------
--
-- Method:      updateAid
--
-- Description: Update/create passed aid number with plane definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateAid(!aidNumber is REAL)

  -- Update aid system
  !!aidNumbers.replace(!aidNumber, !this.grid)

endmethod
-- End of method definition for .updateAid(REAL)
