-- File:            lock.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Mon Mar 9 14:59:34 GMT 1998
--
--
-- Description:
-- Lock or unlock element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply lock
--  init()                           -                   initialisation
--  lock()                           -                   Constructor
--
------------------------------------------------------------------------

setup form !!lock

  !!lock.formTitle     = 'Modify Lock'
  !!lock.iconTitle     = 'Lock'
  !!lock.callback      = '!!lock.init()'
  !!lock.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition

  -- stores the element that is current to the form
  member .ce is DBREF

  -- CE button, initialises form to the current element
  button .setCe 'CE' at xmin ymax

  -- gadget to display name of forms current element
  paragraph .ceText at xmax+1 ymin width 36 lines 1

  -- lock option
  option .newLock at xmin.setCe+9 ymax+0.5 width 19

  -- control buttons
  button .apply ' Apply ' at xmin.setCe ymax+0.5
  button .dismiss 'Dismiss' at xmax form-size ymin cancel

exit
-- End of form definition for !!lock

------------------------------------------------------------------------
--
-- Method:      !lock()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .lock()

  -- options
  !dText = ARRAY()
  !dText[1] = 'Lock CE'
  !dText[2] = 'Lock CE and below'
  !dText[3] = 'Unlock CE'
  !dText[4] = 'Unlock CE and below'
  !rText = ARRAY()
  !rText[1] = 'lock'
  !rText[2] = 'lock all'
  !rText[3] = 'unlock'
  !rText[4] = 'unlock all'
  !this.newLock.dText = !dText
  !this.newLock.rText = !rText

  -- set callbacks
  !this.setCe.callback = |!!lock.init()|
  !this.apply.callback = |!!lock.apply()|

endmethod
-- End of method definition for .lock()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  -- connect form to current element
  !this.ce = !!ce
  !this.ceText.val = !this.ce.fullName

  -- select lock ce by default
  !this.newLock.select('RTEXT', 'lock')

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !apply()
--
-- Description: apply lock
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .apply()

  -- lock/unlock form's ce
  !!ce = !this.ce
  !action = !this.newLock.selection()
  $!action

endmethod
-- End of method definition for .apply()
