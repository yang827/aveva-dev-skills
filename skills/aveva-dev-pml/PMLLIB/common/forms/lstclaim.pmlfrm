--
--
-- Description:
--   Standard Claimlist list handler.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addPicked(DBREF)                 -                   Add Picked element to the Claimlist
--  backPage()                       -                   Move to previous page of results
--  chosenCol()                      -                   Enhance elements
--  claimCeHier(DBREF)               -                   Claim CE
--  claimCeMembH(DBREF)              -                   Claim CE Members
--  claimCeMembO(DBREF)              -                   Claim CE Members Only
--  claimCeOnly(DBREF)               -                   Claim CE Only
--  close()                          -                   Close the form down
--  colours()                        -                   Highlighting colours
--  dbAddMenu(MENU,STRING)           -                   Select database for claimlist
--  highlightDef(BOOLEAN)            -
--  initialise()                     -                   Initialisation for the form
--  listLst(STRING,STRING)           -                   Add List elements to the Claimlist
--  lstClaim()                       -                   Constructor
--  nextPage()                       -                   Move to next page of results
--  page(REAL,REAL)                  -
--  pageSize()                       REAL                Get current page length. Maximum size applied if long list
--  pick(MENU,STRING)                -                   Setup Pick-mode to Add/Remove items
--  pullDowns()                      -                   Maintain the pull-downs for the list
--  removePicked(DBREF)              -                   Remove Picked element from the Claimlist
--  samePage()                       -                   Reconstruct this page of results, getting new page size
--  selectList()                     -                   Select list and make current active
--  selectMember(GADGET,STRING)      -                   Selected entry from Members
--  setList(STRING)                  -                   Select list and make current active
--  unclaimAll()                     -                   Remove all elements
--  unclaimElement(DBREF)            -                   Remove Current Element from Claimlist
--  unclaimElementO(DBREF)           -                   Remove Current Element only from the Claimlist
--  unclaimMembers(DBREF)            -                   Remove Current Element members from the Claimlist
--  unclaimMembersO(DBREF)           -                   Remove Current Element members only from the Claimlist
--  unclaimSelected()                -                   Remove selected items List
--  update()                         -                   Update The Claimlists
--
------------------------------------------------------------------------

setup form !!lstClaim resize

  !this.formTitle     = 'Multiwrite Claim Lists'
  !this.iconTitle     = 'Claimlists'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.55 $ '

  -- Body of form definition

  -- Bar Menu
  bar
  exit

  -- Currently Available Lists
  option    .lists   'Claim List ' at xmin ymax call '!this.selectList()' width 40
  path down
  button    .back     call |!this.backPage()| pixmap width 16 height 16 tooltip 'Back one page of results'
  path right
  button    .forward  call |!this.nextPage()| pixmap width 16 height 16 tooltip 'Forward one page of results'
  paragraph .pageNumber     width 18
  option    .number  |Number of results per page | call |!this.samePage()| width 3
  paragraph .numberElements at x0 ymax.back width 34
  path right
  -- paragraph for db selection
  para      .dbPara   text       'for MDB          ' width 27 lines 1

  -- Current List Contents
  list   .members    at x0 ymax call '!this.selectMember(' anchor all multi width 60 length 15

  -- Current claimlist to be displayed in paged window - Array of string reference numbers
  member .claimListStr     is ARRAY
  -- EXTRCLAIM info for each member of .claimListStr
  member .otherExtrClaims  is ARRAY
  -- USERCLAIM info for each member of .claimListStr
  member .otherUserClaims  is ARRAY

  -- Current List
  member .listName         is STRING

   -- Highlight Colours
  member .claimColour      is REAL

  -- Design based modules edg/enhance available
  member .designModule     is BOOLEAN

  -- Is the Project Global
  member .isGlobal     is BOOLEAN

  -- Database selection
  member .dbList           is STRING

  -- used for paging the results
  -- index into results array of first entry in the current page
  member  .firstNumber     is REAL
  -- index into results array of last entry in the current page
  member  .lastNumber      is REAL
  -- Current page size as a String (Could be 'ALL')
  member  .pageSizeStr     is STRING
  -- maximum page size - set to stop very large result sets from being processed and displayed
  member  .maxPageSize     is REAL

exit
-- End of form definition for !!lstClaim

------------------------------------------------------------------------
--
-- Method:      lstClaim
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lstClaim()

 !module = !!module()
 !this.designModule = !module.appkey.upcase().eq('DES')

  -- Define Bar Menu
  !bar = !!lstClaim.bar
    !bar.add('Control',  'ControlMenu')
    !bar.add('Claim',    'ClaimMenu')
    !bar.add('Unclaim',  'UnClaimMenu')
    !bar.add('Colour', 'HighlightMenu')
    !bar.add('Databases', 'DatabaseMenu')

  -- Control Menu
  !menu = !!lstClaim.newMenu('ControlMenu')
    !menu.add('CALLBACK', 'Update', '!!lstClaim.update()')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Close',  '!!lstClaim.close()')

  -- Add Menu
  !menu = !!lstClaim.newMenu('ClaimMenu')
    !menu.add('CALLBACK', 'CE',   '!!lstClaim.claimCeHier(!!ce)')
    !menu.add('CALLBACK', 'CE Members', '!!lstClaim.claimCeMembH(!!ce)')
    !menu.add('separator')
    !menu.add('CALLBACK', 'CE only',              '!!lstClaim.claimCeOnly(!!ce)')
    !menu.add('CALLBACK', 'CE Members only',      '!!lstClaim.claimCeMembO(!!ce)')
    !menu.add('separator')
    !menu.add('TOGGLE', 'Pick',                 '!!lstClaim.pick(')
    !menu.add('MENU',     'List',  'AddListMenu')

  -- Remove Menu
  !menu = !!lstClaim.newMenu('UnClaimMenu')
    !menu.add('CALLBACK', 'All',        '!!lstClaim.unclaimAll()')
    !menu.add('CALLBACK', 'Selected',   '!!lstClaim.unclaimSelected()')
    !menu.add('separator')
    !menu.add('CALLBACK', 'CE',         '!!lstClaim.unclaimElement(!!ce)')
    !menu.add('CALLBACK', 'CE Members', '!!lstClaim.unclaimMembers(!!ce)')
    !menu.add('separator')
    !menu.add('CALLBACK', 'CE only',              '!!lstClaim.unclaimElementO(!!ce)')
    !menu.add('CALLBACK', 'CE Members only',      '!!lstClaim.unclaimMembersO(!!ce)')
    !menu.add('separator')
    !menu.add('TOGGLE', 'Pick',       '!!lstClaim.pick(')
    !menu.add('MENU',     'List',  'RemoveListMenu')

       -- Highlight Menu
  !menu = !!lstClaim.newMenu('HighlightMenu')
    !menu.add('CALLBACK', 'Highlight...',  '!!lstClaim.colours()')
    !menu.add('MENU',   'Unhighlight',  'UnhighlightMenu')

    -- Unhighlight Menu
  !menu = !!lstClaim.newMenu('UnHighlightMenu')
    !menu.add('CALLBACK', 'CE',         'UNENHANCE CE')
    !menu.add('CALLBACK', 'Elements',   '!!lstClaim.highlightDef(false)')
    !menu.add('CALLBACK', 'All',        'UNENHANCE ALL')

  -- Database Menu
  !menu = !!lstClaim.newMenu('DatabaseMenu')
    !menu.add('CALLBACK', 'MDB',    '!!lstClaim.dbAddMenu(')
    !menu.add('MENU',     'DBs', 'DatabaseListMenu')
    !menu.setActive('DBs', false)

  -- Default value for BDList member
  !this.dbList = 'MDB'

  -- Database List Menu
  !menu = !!lstClaim.newMenu('DatabaseListMenu')
    !menu.clear()
--     -- find own session
--     !a = ARRAY()
--     !b = REAL()
--     !a = session
--     do !i indices !a
--       -- find the current session
--       if !a[!i].isCurrent then
--         !b = !i
--       endif
--     enddo
--     -- create a list of all dbs of ddl type
--     !d = !a[!b].current()
    !a = CURRENT SESSION
    !d = !a.current()
    do !j indices !d
      if (!module.ddlType eq !d[!j].type ) then
        if (!d[!j].claim eq 'Implicit' or !d[!j].claim eq 'Explicit' ) then
          !e = !d[!j].name
          !!lstClaim.databaseListMenu.add('CALLBACK', '$!e',  '!!lstClaim.dbAddMenu(')
          !menu = !!lstClaim.databaseMenu
          !menu.setActive('DBs', true)
        endif
      endif
    enddo

   -- Add Lists
   !menu = !!lstClaim.newMenu('AddListMenu')

   -- Remove Lists
   !menu = !!lstClaim.newMenu('RemoveListMenu')

  -- Generate Linkage to List
--  call !!lstAddLinkMenu('DBREFS', !!lstClaim.addListMenu,    false, ARRAY(), ARRAY(), '!!lstClaim.listLst(''ADD'',')
--  call !!lstAddLinkMenu('DBREFS', !!lstClaim.removeListMenu, false, ARRAY(), ARRAY(), '!!lstClaim.listLst(''REMOVE'',')

  -- Initialise only certain list allowed on this form
  !choice[1]         = 'Active Claimlist'
  !choice[2]         = 'Others Claimlist'
  !this.lists.dText  = !choice

  -- set number of results per page options
  !listDtext[1]      = ' 15'
  !listDtext[2]      = ' 50'
  !listDtext[3]      = '100'
  !listDtext[4]      = 'All'
  !this.number.dText = !listDtext
  !this.number.rText = !listDtext
  !this.pageSizeStr  = !listDtext[1]
  !this.lastNumber   = 0
  !this.firstNumber  = 0
  !this.maxPageSize  = 500
  !this.forward.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !this.back.addPixmap(!!pml.getPathName('leftarrow16.png'))

  -- Is the project global
  !project = CURRENT PROJECT
  !this.isGlobal = !project.isGlobal()

endmethod
-- End of method definition for .lstClaim()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialisation for the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Set a Default colour for Claimlists
  if (!this.claimColour.unset() ) then
    !this.claimColour = 10
  endif

    -- Get module information
  !module            = !!module()
  !this.designModule = !module.appkey.upcase().eq('DES')

  -- Set the list value for use on reshowing
  !this.lists.val = !this.lists.pickedField
  handle any
    -- if Initial entry then there's no PickedField
  endhandle

  -- Populate Members list
  !this.update()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      pullDowns
--
-- Description:
--   Maintain the pull-downs for the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pullDowns()

  !bar  = !this.bar
  !menu = !this.claimMenu

  -- Check if there are any lists (allow Add/Remove options)
  if(!this.lists.val eq 1 ) then

    !bar.setActive('Claim', true)
    !bar.setActive('Unclaim', true)
    !bar.setActive('Colour', true)
    !menu.setActive('CE Only', true)
    !menu.setActive('CE', true)
    !menu.setActive('CE Members Only', true)
    !menu.setActive('CE Members', true)
    !menu.setActive('Pick', true)
--    !menu.setActive('Select...', true)

  -- Disallow Add/Remove Options
  else
    !bar.setActive('Unclaim', false)
    !bar.setActive('Colour', false)
    !menu.setActive('CE Only', false)
    !menu.setActive('CE', false)
    !menu.setActive('CE Members Only', false)
    !menu.setActive('CE Members', false)
    !menu.setActive('Pick', false)
--    !menu.setActive('Select...', false)
  endif

  -- Select Remove Menu
  !menu = !this.unclaimMenu

  -- If there are no members, then grey-out remove options
  if(!this.members.dText.size() eq 0 ) then
    !bar.setActive('Unclaim', false)
    !bar.setActive('Colour', false)
    -- Also switch off any unclaim picking edg
    if (!this.designModule) then
      !!edgCntrl.remove('Claim list packet')
    endif

  else
    !bar.setActive('Unclaim', true)
    !bar.setActive('Colour', true)
  endif

  -- If this is a claimlist other, then grey out claim and unclaim
  if(!this.lists.val gt 1 ) then
    !bar.setActive('Claim',   false)
    !bar.setActive('Unclaim', false)
  endif

  if (!this.designModule.not()) then
    !bar.setActive('Colour', false)
    !menu = !this.claimMenu
    !menu.setActive('Pick', false)
    !menu = !this.unclaimMenu
    !menu.setActive('Pick', false)
  endif

  !this.lists.val = !this.lists.pickedField
  handle any
    -- if Initial entry then there's no PickedField
  endhandle

endmethod
-- End of method definition for .pullDowns()

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description:
--   Update The Claimlists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .update()

  !rememberListVal = !this.lists.selection()
  -- reset page indices so that the first page of a new results set is shown
  !this.lastNumber   = 0
  !this.firstNumber  = 0

  if(!this.lists.val eq 1 ) then

    -- Update the Displayed Claimlist
    if (!this.dbList eq 'MDB') then
      var !claimListStr COLLECT ALL WITH (TYPE NEQ 'SPST') FROM CLAIMLIST
    else
      var !claimListStr COLLECT ALL WITH (TYPE NEQ 'SPST' and DBNAME EQ '$!this.dbList') FROM CLAIMLIST
    endif

  elseif(!this.lists.val eq 2 ) then

    PROMPT 'Finding Other Users Claimed Elements. Please Wait...'

    -- Update the Displayed Claimlist of Others
    if (!this.dbList eq 'MDB') then
      var !claimListStr COLLECT ALL WITH (TYPE NEQ 'SPST') FROM CLAIMLIST OTHER
    else
      var !claimListStr COLLECT ALL WITH (TYPE NEQ 'SPST' and DBNAME EQ '$!this.dbList') FROM CLAIMLIST OTHER
    endif

    -- Get all users for other claims
    VAR !claimUsersArr EVALUATE (USERCLAIM) FOR ALL FROM !claimListStr
    !this.otherUserClaims = !claimUsersArr

    -- Strip down the list of users
    !claimUsersArr.unique()

    -- find any unset users
    !unsetUser = !claimUsersArr.findFirst('unset')

    !claimExtrDtext = ARRAY()
    !claimExtrRtext = ARRAY()

    if(!unsetUser.set()) then

      -- unset user found - look for extracts
      VAR !claimExtrArr EVALUATE (EXTRCLAIM) FOR ALL FROM !claimListStr
      !this.otherExtrClaims = !claimExtrArr
      -- Strip down the list of extracts
      !claimExtrArr.unique()
      -- get rid of unset user
      !claimUsersArr.remove(!unsetUser)
      -- fill array for option gadget with extract name and condition to use in collection
      -- to select all elements for the chosen extract
      do !i indices !claimExtrArr
        !claimExtrDtext[!i] = 'EXTRACT ' + !claimExtrArr[!i]
        !claimExtrRtext[!i] = 'EXTRCLAIM eq |' + !claimExtrArr[!i] + '|'
      enddo

    else

      !claimExtrArr         = ARRAY()
      !this.otherExtrClaims = ARRAY()

    endif

    -- fill array for option gadget with user name and condition to use in collection
    -- to select all elements for the chosen user
    !claimUsersDtext = ARRAY()
    !claimUsersRtext = ARRAY()
    do !i indices !claimUsersArr
      !claimUsersDtext[!i] = 'USER ' + !claimUsersArr[!i] + ' Claimlist'
      !claimUsersRtext[!i] = 'USERC eq |' + !claimUsersArr[!i] + '|'
    enddo
    !claimUsersDtext.appendArray(!claimExtrDtext)
    !claimUsersRtext.appendArray(!claimExtrRtext)

    -- Only certain list allowed on this form
    !dText[1] = 'Active Claimlist'
    !dText[2] = 'Others Claimlist'
    !rText = !dText

    !dText.appendArray(!claimUsersDtext)
    !rText.appendArray(!claimUsersRtext)

    -- Extend the list gadget
    !this.lists.dText = !dText
    !this.lists.rText = !rText

    PROMPT DISMISS
    -- Reset the selection to 2
    !this.lists.val = 2
  else
    PROMPT 'Finding Other Users Claimed Elements. Please Wait...'

    -- Update the Displayed Claimlist of Others
    !userChoice = !this.lists.rText[!this.lists.pickedField ]
--    !userChoice = !userChoice.part(1, ' ')
    if (!this.dbList eq 'MDB') then
      var !claimListStr COLLECT ALL WITH ($!userChoice AND TYPE NEQ 'SPST') FROM CLAIMLIST OTHER
    else
      var !claimListStr COLLECT ALL WITH ($!userChoice AND TYPE NEQ 'SPST' AND DBNAME EQ '$!this.dbList') FROM CLAIMLIST OTHER
    endif

    PROMPT DISMISS

  endif

  !this.numberElements.val = 'Number of claimed elements: ' + !claimListStr.size().string()

  -- save the current claimlist to be presented in pages
  !this.claimListStr = !claimListStr

  -- stop very large numbers of claims being displayed in a single page
  if( !this.number.selection().trim().upcase() eq 'ALL' and !claimListStr.size() gt 700 ) then
    !this.number.select('RTEXT','100')
  endif

  -- Re-build list on the form
  !this.nextPage()

  !this.lists.select('RTEXT','$!rememberListVal')
  handle any
    -- in case initialisation
    !this.lists.val = 1
  endhandle

  -- Populate AddListMenu and RemoveListMenu
  -- Add Lists
   !menu = !this.addListMenu
   if (!!module().appName.upcase() neq 'ADMIN') then
     !listForm = !!cdcList
     !menu.clear()
     do !i indices !listForm.name.dText
       !menu.add('CALLBACK', '$!listForm.name.dText[$!i]', '!!lstClaim.listLst(|ADD|, |$!i|)')
     enddo
     !this.claimMenu.setActive('List', true)
   else
     !menu.clear()
     !menu.add('CALLBACK', 'No list', '')
     !this.claimMenu.setActive('List', false)
   endif

   -- Remove Lists
   !menu = !this.removeListMenu
   if (!!module().appName.upcase() neq 'ADMIN') then
     !listForm = !!cdcList
     !menu.clear()
     do !i indices !listForm.name.dText
       !menu.add('CALLBACK', '$!listForm.name.dText[$!i]', '!!lstClaim.listLst(|REMOVE|, |$!i|)')
     enddo
     !this.unclaimMenu.setActive('List', true)
   else
     !menu.clear()
     !menu.add('CALLBACK', 'No list', '')
     !this.unclaimMenu.setActive('List', false)
   endif

  !menu = !this.addListMenu
    !menu.setActive('No list', false)
    handle any
    endhandle
  !menu = !this.removeListMenu
    !menu.setActive('No list', false)
    handle any
    endhandle

    -- Update pulldown menus
    !this.pullDowns()

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close the form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Cease the event driven graphics
  if (!this.designModule) then
    !!edgCntrl.remove('Claim list packet')
  endif

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      claimCeHier
--
-- Description:
--   Claim CE
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be added into list
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .claimCeHier(!item is DBREF)

  if( !!ce eq WORLD ) then
    !reply = !!alert.confirm( 'You are trying to claim the world element. Do you wish to continue with this claim?')
    if( !reply ne 'YES' ) then
      return
    endif
  endif

  -- Find out if we are in a extract database
  !isExtract = !!ce.dbRef.isExtr
  handle (2,201)
    !isExtract = false
  endhandle
  if (!isExtract) then
    -- Add item to list
    EXTRACT CLAIM CE HIERARCHY
    handle ANY
      -- 607 'You do not have permission to claim #F'
      -- 613 'Unable to claim #F as element is altered in a later session. Please GETWORK and try again'
      -- 614 'Unable to claim #F as element is already claimed by #N from extract #N'
      -- 623 'Unable to claim #F into  extract #N as element is altered in a $
      --      later session in the parent extract. Please EXTRACT REFRESH DB and try again'
      -- 631 'Unable to claim #F from parent extract #N as element has been deleted $
      --      in a later session.'
      -- 635 'Unable to claim #F from parent extract #N'
      !!alert.message(!!error.text )
      return
    endhandle
  endif

  CLAIM CE HIERARCHY
  handle (2,603)
    -- already claimed
  elsehandle (2,614)
    -- less than 5 claimed by others
    !!alert.message(!!error.text )
  elsehandle (2,616)
    -- more than 5 claimed by others
    !!alert.message('Found 5 items claimed by others. Further claims terminated.')
  elsehandle (2,633)
    if (!this.isGlobal) then
      !!alert.message('An Extract Claim command has been issued! A Local Claim will not be available $
                       until the Extract Claim is Complete. Use the Transactions Utility to check progress.')
    else
    -- should not come to this
    !!alert.message(!!error.text )
    endif
  endhandle
  -- Update the Displayed Claimlist
  !this.update()

  -- Highlight
  if (!this.designModule) then
    var !user USER
    ENHANCE CE WHERE (LCLM EQ TRUE AND USERC EQ '$!user' ) FROM DRAWLIST COLOUR $!this.claimColour
  endif

endmethod
-- End of method definition for .claimCeHier(DBREF)

------------------------------------------------------------------------
--
-- Method:      claimCeOnly
--
-- Description:
--   Claim CE Only
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be added into list
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .claimCeOnly(!item is DBREF)

  if( !!ce eq WORLD ) then
    !reply = !!alert.confirm( 'You are trying to claim the world element. Do you wish to continue with this claim?')
    if( !reply ne 'YES' ) then
      return
    endif
  endif

  -- Find out if we are in a extract database
  !isExtract = !!ce.dbRef.isExtr
  handle (2,201)
    !isExtract = false
  endhandle
  if (!isExtract) then
    -- Add item to list
    EXTRACT CLAIM CE
    handle ANY
      -- 607 'You do not have permission to claim #F'
      -- 613 'Unable to claim #F as element is altered in a later session. Please GETWORK and try again'
      -- 614 'Unable to claim #F as element is already claimed by #N from extract #N'
      -- 623 'Unable to claim #F into  extract #N as element is altered in a $
      --      later session in the parent extract. Please EXTRACT REFRESH DB and try again'
      -- 631 'Unable to claim #F from parent extract #N as element has been deleted $
      --      in a later session.'
      -- 635 'Unable to claim #F from parent extract #N'
      !!alert.message(!!error.text )
      return
    endhandle
  endif

  CLAIM CE
  handle (2,603)
    -- already claimed
  elsehandle (2,633)
    if (!this.isGlobal) then
      !!alert.message('An Extract Claim command has been issued! A Local Claim will not be available $
                       until the Extract Claim is Complete. Use the Transactions Utility to check progress.')
    else
    -- should not come to this
    !!alert.message(!!error.text )
    endif
  endhandle

  -- Update the Displayed Claimlist
  !this.update()

  -- Highlight
  if (!this.designModule) then
    var !user USER
    ENHANCE CE WHERE (LCLM EQ TRUE AND USERC EQ '$!user' ) FROM DRAWLIST COLOUR $!this.claimColour
  endif

endmethod
-- End of method definition for .claimCeOnly(DBREF)

------------------------------------------------------------------------
--
-- Method:      claimCeMembO
--
-- Description:
--   Claim CE Members Only
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be added into list
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .claimCeMembO(!item is DBREF)

  -- Find out if we are in a extract database
  !isExtract = !!ce.dbRef.isExtr
  handle (2,201)
    !isExtract = false
  endhandle
  if (!isExtract) then
    -- Add item to list
    EXTRACT CLAIM CE MEM
    handle ANY
      -- 607 'You do not have permission to claim #F'
      -- 613 'Unable to claim #F as element is altered in a later session. Please GETWORK and try again'
      -- 614 'Unable to claim #F as element is already claimed by #N from extract #N'
      -- 623 'Unable to claim #F into  extract #N as element is altered in a $
      --      later session in the parent extract. Please EXTRACT REFRESH DB and try again'
      -- 631 'Unable to claim #F from parent extract #N as element has been deleted $
      --      in a later session.'
      -- 635 'Unable to claim #F from parent extract #N'
      !!alert.message(!!error.text )
      return
    endhandle
  endif

  CLAIM CE MEM
  handle (2,603)
    -- already claimed
  elsehandle (2,614)
    -- less than 5 claimed by others
    !!alert.message(!!error.text )
  elsehandle (2,616)
    -- more than 5 claimed by others
    !!alert.message('Found 5 items claimed by others. Further claims terminated.')
  elsehandle (2,633)
    if (!this.isGlobal) then
      !!alert.message('An Extract Claim command has been issued! A Local Claim will not be available $
                       until the Extract Claim is Complete. Use the Transactions Utility to check progress.')
    else
    -- should not come to this
    !!alert.message(!!error.text )
    endif
  endhandle

  -- Update the Displayed Claimlist
  !this.update()

  -- Highlight
  if (!this.designModule) then
    var !user USER
    ENHANCE CE MEM WHERE (LCLM EQ TRUE AND USERC EQ '$!user' ) FROM DRAWLIST COLOUR $!this.claimColour
  endif

endmethod
-- End of method definition for .claimCeMembO(DBREF)

------------------------------------------------------------------------
--
-- Method:      claimCeMembH
--
-- Description:
--   Claim CE Members
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be added into list
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .claimCeMembH(!item is DBREF)

  -- Find out if we are in a extract database
  !isExtract = !item.dbRef.isExtr
  handle (2,201)
    !isExtract = false
  endhandle
  if (!isExtract) then
    -- Add item to list
    EXTRACT CLAIM $!item.type MEM HIERARCHY
    handle ANY
      -- 607 'You do not have permission to claim #F'
      -- 613 'Unable to claim #F as element is altered in a later session. Please GETWORK and try again'
      -- 614 'Unable to claim #F as element is already claimed by #N from extract #N'
      -- 623 'Unable to claim #F into  extract #N as element is altered in a $
      --      later session in the parent extract. Please EXTRACT REFRESH DB and try again'
      -- 631 'Unable to claim #F from parent extract #N as element has been deleted $
      --      in a later session.'
      -- 635 'Unable to claim #F from parent extract #N'
      !!alert.message(!!error.text )
      return
    endhandle
  endif

  CLAIM $!item.type MEM HIERARCHY
  handle (2,603)
    -- already claimed
  elsehandle (2,614)
    -- less than 5 claimed by others
    !!alert.message(!!error.text )
  elsehandle (2,616)
    -- more than 5 claimed by others
    !!alert.message('Found 5 items claimed by others. Further claims terminated.')
  elsehandle (2,633)
    if (!this.isGlobal) then
      !!alert.message('An Extract Claim command has been issued! A Local Claim will not be available $
                       until the Extract Claim is Complete. Use the Transactions Utility to check progress.')
    else
    -- should not come to this
    !!alert.message(!!error.text )
    endif
  endhandle

  -- Update the Displayed Claimlist
  !this.update()

  -- Highlight
  if (!this.designModule) then
    var !user USER
    ENHANCE CE MEM WHERE (LCLM EQ TRUE AND USERC EQ '$!user' ) FROM DRAWLIST COLOUR $!this.claimColour
  endif

endmethod
-- End of method definition for .claimCeMembH(DBREF)

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description:
--   Setup Pick-mode to Add/Remove items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Open callback
--    2   R      STRING      Open callback
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pick(!menu is MENU, !selected is STRING)

  -- Initialise Variables
--  !form    = !menu.owner()
  !option  = !menu.pickedField

if(!option.upcase() eq 'PICK') then

  if(!selected eq 'SELECT') then

    -- Define edg Packet for picking elements
    !packet             = object EDGPACKET()

    if (!menu.name().upcase() eq 'CLAIMMENU') then
      !packet.elementPick('Pick element to claim')
      !packet.remove      = false
      !packet.description = 'Claim list packet'
      !packet.action      = '!!lstClaim.addPicked(!this.return[1].item)'
      !this.unclaimMenu.select('Pick',false)
      !packet.close       = '!!lstClaim.claimMenu.select(''Pick'',false)'
      -- Pick qualifier
      !packet.pickPacket.picks[1].pick.modifiable = false
      !packet.pickPacket.picks[1].pick.input[3] = 'OKCLAIM'

      else
      !packet.elementPick('Pick element to unclaim')
      !packet.remove      = false
      !packet.description = 'Claim list packet'
      !packet.action      = '!!lstClaim.removePicked(!this.return[1].item)'
      !this.claimMenu.select('Pick',false)
      !packet.close       = '!!lstClaim.unclaimMenu.select(''Pick'',false)'
      -- Pick qualifier
      !packet.pickPacket.picks[1].pick.modifiable = false
      !packet.pickPacket.picks[1].pick.input[3] = 'OKRELEASE'

    endif

    !!edgCntrl.add(!packet)

  else
    !!edgCntrl.remove('Claim list packet')


  endif

endif

endmethod
-- End of method definition for .pick(MENU, STRING)
------------------------------------------------------------------------
--
-- Method:      addPicked
--
-- Description:
--   Add Picked element to the Claimlist
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be added into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addPicked(!claimPicked is DBREF)

  -- Find out if we are in a extract database
  !isExtract = !claimPicked.dbRef.isExtr
  handle (2,201)
    !isExtract = false
  endhandle
  if (!isExtract) then
    -- Add item to list
    EXTRACT CLAIM $!claimPicked
    handle ANY
      -- 607 'You do not have permission to claim #F'
      -- 613 'Unable to claim #F as element is altered in a later session. Please GETWORK and try again'
      -- 614 'Unable to claim #F as element is already claimed by #N from extract #N'
      -- 623 'Unable to claim #F into  extract #N as element is altered in a $
      --      later session in the parent extract. Please EXTRACT REFRESH DB and try again'
      -- 631 'Unable to claim #F from parent extract #N as element has been deleted $
      --      in a later session.'
      -- 635 'Unable to claim #F from parent extract #N'
      !!alert.message(!!error.text )
      return
    endhandle
  endif

  CLAIM $!claimPicked
  handle (2,603)
    -- already claimed
  elsehandle (2,633)
    if (!this.isGlobal) then
      !!alert.message('An Extract Claim command has been issued! A Local Claim will not be available $
                       until the Extract Claim is Complete. Use the Transactions Utility to check progress.')
    else
    -- should not come to this
    !!alert.message(!!error.text )
    endif
  endhandle

  -- Highlight
  if (!this.designModule) then
    var !user USER
    ENHANCE $!claimPicked WHERE (LCLM EQ TRUE AND USERC EQ '$!user' ) FROM DRAWLIST COLOUR $!this.claimColour
  endif

  -- Re Display
  !this.update()

endmethod
-- End of method definition for .addPicked(DBREF)
------------------------------------------------------------------------
--
-- Method:      removePicked
--
-- Description:
--   Remove Picked element from the Claimlist
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be removed from list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removePicked(!claimPicked is DBREF)

  UNCLAIM $!claimPicked
  handle (2,604)
    -- element not claimed
  endhandle

  -- UnHighlight
  if (!this.designModule) then
    UNENHANCE $!claimPicked WHERE (LCLM EQ FALSE ) from DRAWLIST
  endif

  -- Re Display
  !this.update()

endmethod
-- End of method definition for .removePicked(DBREF)

------------------------------------------------------------------------
--
-- Method:      listLst
--
-- Description:
--   Add List elements to the Claimlist
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      ADD or REMOVE
--    2   R      STRING      Active List Name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .listLst(!option is STRING, !listData is STRING)

  !numExtractErrors = 0
  !numExtractMessages = 0
  !numErrors = 0

  -- Remember where we are
  !memory = !!ce

    -- Get list
    !entries  = '!!cdList' & !listData
    !entriesStr  = '$$' & '!!cdList' & !listData

    -- Option
    if(!option.upcase() eq 'ADD') then

      do !i indices $!entries
        -- Navigate to the each entry
        $!entriesStr[$!i]
        -- Find out if we are in a extract database
        !isExtract = !!ce.dbRef.isExtr
        handle (2,201)
          !isExtract = false
        endhandle
        if (!isExtract) then
          -- Add item to list
          EXTRACT CLAIM $!entriesStr[$!i]
          handle ANY
            -- 607 'You do not have permission to claim #F'
            -- 613 'Unable to claim #F as element is altered in a later session. Please GETWORK and try again'
            -- 614 'Unable to claim #F as element is already claimed by #N from extract #N'
            -- 623 'Unable to claim #F into  extract #N as element is altered in a $
            --      later session in the parent extract. Please EXTRACT REFRESH DB and try again'
            -- 631 'Unable to claim #F from parent extract #N as element has been deleted $
            --      in a later session.'
            -- 635 'Unable to claim #F from parent extract #N'
            !!alert.message(!!error.text )
            !numExtractErrors = !numExtractErrors + 1
            skip
            -- if we get to 5 error then let us abort
            if (!numExtractErrors eq 5 ) then
              !!alert.message('Found 5 items that cannot be extract claimed. Further claims terminated.')
              break
            endif
          endhandle
        endif

        CLAIM $!entriesStr[$!i]
        handle (2,603)
          -- already claimed
        elsehandle (2,633)
          if (!this.isGlobal) then
            !numExtractMessages = !numExtractMessages + 1
            -- Only output this message once
            if (!numExtractMessages eq 1) then
              !!alert.message('Extract Claim commands has been issued! Local Claims will not be available $
                       until the Extract Claims are Complete. Use the Transactions Utility to check progress.')
            endif
          else
            -- should not come to this
            !!alert.message(!!error.text )
          endif
        elsehandle (2,614)
          -- claimed by someone else
          !numErrors = !numErrors + 1
          !!alert.message(!!error.text )
          if (!numErrors eq 5 ) then
            !!alert.message('Found 5 items claimed by others. Further claims terminated.')
            break
          endif
        endhandle
        -- Highlight Active Claimlist
        if (!this.designModule) then
          var !user USER
          ENHANCE $!entriesStr[$!i] WHERE (LCLM EQ TRUE AND USERC EQ '$!user' ) FROM DRAWLIST COLOUR $!this.claimColour
        endif
      enddo

      -- Re Display
      !this.update()

    elseif (!option.upcase() eq 'REMOVE') then

      do !i indices $!entries
        UNCLAIM $!entriesStr[$!i]
        handle (2,604)
          -- element not claimed
        elsehandle (2,615)
          !numErrors = !numErrors + 1
          !!alert.message(!!error.text )
          if (!numErrors eq 5 ) then
            !!alert.message('Found 5 items that cannot be unclaimed. Further unclaiming terminated.')
            break
          endif
        endhandle
        -- UnHighlight
        if (!this.designModule) then
          UNENHANCE $!entriesStr[$!i] WHERE (LCLM EQ FALSE ) FROM DRAWLIST
        endif
      enddo

      -- Display
      !this.update()

    endif

    -- Navigate back to original element
    !!ce = !memory

endmethod
-- End of method definition for .listLst(STRING, STRING)


------------------------------------------------------------------------
--
-- Method:      unclaimElement
--
-- Description:
--   Remove Current Element from Claimlist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be removed from list
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unclaimElement(!item is DBREF)

  UNCLAIM CE HIERARCHY
  handle (2,604)
    -- element not claimed
  elsehandle (2,615)
    !!alert.message(!!error.text )
    -- Update the Displayed Claimlist
    !this.update()
    return
  endhandle

  -- Update the Displayed Claimlist
  !this.update()

  -- UnHighlight
  if (!this.designModule) then
    UNENHANCE CE WHERE (LCLM EQ FALSE ) FROM DRAWLIST
  endif

endmethod
-- End of method definition for .unclaimElement(DBREF)

