-- End of method definition for .colours()
------------------------------------------------------------------------
--
-- Method:      chosenCol
--
-- Description:
--   Enhance elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------

define method .chosenCol()

  if (!this.designModule) then
    !this.claimColour = !!colourSelect.setColour
    !claims = !this.claimListStr
    ENHANCE ALL FROM !claims COLOUR $!this.claimColour
  endif

endmethod
-- End of method definition for .chosenCol()
-----------------------------------------------------------------------
--
-- Method:      pageSize
--
-- Description: Get current page length. Maximum size applied if long list
-- and 'ALL' selected.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Current page size
--
------------------------------------------------------------------------

define method .pageSize() is REAL

  if( !this.pageSizeStr eq 'ALL') then
    if( !this.claimListStr.size() gt !this.maxPageSize ) then
      !pageSize = !this.maxPageSize
    else
      !pageSize = !this.claimListStr.size()
    endif
  else
    !pageSize = !this.pageSizeStr.real()
  endif

  return !pageSize

endmethod
-- End of method definition for .pageSize()
-----------------------------------------------------------------------
--
-- Method:      nextPage
--
-- Description: Move to next page of results
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nextPage()

  !startAt  = !this.lastNumber + 1
  if( !startAt gt !this.claimListStr.size() ) then
    !startAt = 1
  endif
  !this.page(!startAt, !this.pageSize())

endmethod
-- End of method definition for .nextPage()
-----------------------------------------------------------------------
--
-- Method:      backPage
--
-- Description: Move to previous page of results
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .backPage()

  !pageSize = !this.pageSize()
  !startAt  = max(1, !this.firstNumber - !pageSize)
  !this.page(!startAt, !pageSize)

endmethod
-- End of method definition for .backPage()
-----------------------------------------------------------------------
--
-- Method:      samePage
--
-- Description: Reconstruct this page of results, getting new page size
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .samePage()

  !this.pageSizeStr = !this.number.selection().trim().upcase()
  !this.page(!this.firstNumber, !this.pageSize())

endmethod
-- End of method definition for .samePage()
-----------------------------------------------------------------------
--
-- Method:      page
--
-- Description: Display results page with first entry as !startAt
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Start index into results array for this page
--    2   R      REAL        Number of entries in this page
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .page( !startAt is REAL, !pageSize is REAL )

  -- set form for mode working in
  !listRtext     = ARRAY()
  !listDtext     = ARRAY()
  !claimNamesArr = ARRAY()
  !claimUsersArr = ARRAY()

  !this.members.clear()
  if( !this.claimListStr.empty() ) then
    !this.pageNumber.val = ''
    return
  endif
  !listSize = !this.claimListStr.size()

  -- find start and end indexes into results array for this page
  !endAt    = !startAt + !pageSize - 1
  if( !endAt gt !listSize ) then
    !endAt  = !listSize
  endif
  !this.firstNumber = !startAt
  !this.lastNumber  = !endAt

  -- build page of element output
  if(!this.lists.val eq 2 ) then

    -- others claimlist - output user or extract with the claimed element
    do !i from !startAt to !endAt
      !element = !this.claimListStr[!i].dbRef()
      handle any
        skip
      endhandle
      !user    = !this.otherUserClaims[!i]
      if( !user eq 'unset' ) then
        -- use extract if user claim is empty
        !user  = 'EXTRACT ' + !this.otherExtrClaims[!i]
      else
        !user  = 'USER ' + !user
      endif
      !claimNamesArr.append(!element.flnn)
      !listRtext.append(!this.claimListStr[!i])
      !claimUsersArr.append(!user)
    enddo

    !colWidth = !claimNamesArr.width()
    VAR !listDtext  COMPOSE COLUMN VALUES !claimNamesArr WIDTH $!colWidth SPACES 1 COLUMN VALUES !claimUsersArr

  else

    -- named claimlist
     do !i from !startAt to !endAt
      !element = !this.claimListStr[!i].dbRef()
      handle any
        skip
      endhandle
      !listDtext.append(!element.flnn)
      !listRtext.append(!this.claimListStr[!i])
    enddo

  endif

  !this.members.dText = !listDtext
  !this.members.rText = !listRtext

  -- update page number
  !pageTotal  = int( (!listSize - 1) / !pageSize ) + 1
  !pageNumber = int( ( !startAt - 1) / !pageSize ) + 1
  !this.pageNumber.val = 'Page ' + !pageNumber.string() + ' of ' + !pageTotal.string()

endmethod
-- End of method definition for .page()
