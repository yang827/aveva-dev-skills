------------------------------------------------------------------------
--
-- Method:      unclaimSelected
--
-- Description:
--   Remove selected items List
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unclaimSelected()

  -- Check there are some selections
  if(!this.members.selection().unset()) then
    !!messageFile.warning(149, 006)
    return
  endif

  -- Remove entries List
  do !i values !this.members.val
    !!ce = !this.members.rText[!i].dbRef()
    UNCLAIM $!!ce
    handle (2,604)
      -- element not claimed
    elsehandle (2,615)
      !!alert.message(!!error.text )
      -- Update the Displayed Claimlist
      !this.update()
      return
    endhandle
    -- UnHighlight
    if (!this.designModule) then
      UNENHANCE CE WHERE (LCLM EQ FALSE ) FROM DRAWLIST
    endif
  enddo

  -- Update the Displayed Claimlist
  !this.update()

endmethod
-- End of method definition for .unclaimSelected()

------------------------------------------------------------------------
--
-- Method:      unclaimAll
--
-- Description:
--   Remove all elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unclaimAll()

  -- UnHighlight Active Claimlist
  if (!this.designModule) then
    var !user USER
    UNENHANCE ALL WHERE (LCLM EQ TRUE AND USERC EQ '$!user' ) FROM DRAWLIST
  endif

  UNCLAIM ALL

    handle (2,604)
      -- element not claimed

    elsehandle (2,615) (2,630)
      -- Unable to release all elements, use Q CLAIMLIST to determine...
      !!alert.message(!!error.text)

      -- Update the Displayed Claimlist
      !this.update()
      return

    endhandle

  -- Update the Displayed Claimlist
  !this.update()

endmethod
-- End of method definition for .unclaimAll()

