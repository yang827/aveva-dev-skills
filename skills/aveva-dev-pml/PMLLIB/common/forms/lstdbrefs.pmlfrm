--
-- Description:
--   Standard DbRef list handler.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addClaimlist(DBREF)              -
--  addDrawlist(DBREF)               -
--  addElement(DBREF)                -                   Add Current element to the active list
--  addList()                        -                   Add a new list
--  addMembers(DBREF)                -                   Add Current element Members to the active list
--  close()                          -                   Close the form down
--  display()                        -                   Select list and make current active
--  initialise()                     -                   Initialisation for the form
--  lstDbRefs()                      -                   Constructor
--  pick(BOOLEAN)                    -                   Setup Pickmode to Add/Remove items to active list
--  pullDowns()                      -                   Maintain the pull-downs for the list
--  removeAll()                      -                   Remove all elements
--  removeElement(DBREF)             -
--  removeList()                     -                   Remove current list from store
--  removeMembers(DBREF)             -                   Remove Current Element members from current active list
--  removeSelected()                 -                   Remove selected items from list
--  selectList()                     -                   Select list and make current active
--  selectMember(GADGET,STRING)      -                   Selected entry from Members
--  selection(STRING)                -                   Show selection form
--  setList(STRING)                  -                   Select list and make current active
--  update()                         -                   Update all Linked gadgets for list store
--
------------------------------------------------------------------------

-- Kill existing form definition
-- kill !!lstDbRefs

-- Define form
setup form !!lstDbRefs

  !!lstDbRefs.formTitle     = 'DB Reference Lists'
  !!lstDbRefs.iconTitle     = 'DbRefLst'
  !!lstDbRefs.callback      = '!!lstDbRefs.initialise()'
  !!lstDbRefs.formRevision  = ' $Revision: 1.13 $ '

  -- Body of form definition

  -- Bar Menu
  bar
  exit

  -- Currently Available Lists
  option .lists   'Available Lists ' at xmin ymax call '!!lstDbRefs.selectList()' width 20

  -- Current List Contents
  list   .members 'Elements'         at xmin ymax call '!!lstDbRefs.selectMember(' multi width 40 length 15

  -- Form Members
    -- Has form been shown before
    member .shownBefore is BOOLEAN
    !!lstDbRefs.shownBefore = false

    -- Element list
    member .elements    is ARRAY

    -- Current List
    member .listName    is STRING

    -- Element List Update Flag
    member .updated     is BOOLEAN
    !!lstDbRefs.updated = false

exit

-- End of form definition for !!lstDbRefs

  -- Define Bar Menu
  !bar = !!lstDbRefs.bar
  !bar.add('Control',  'ControlMenu')
  !bar.add('Add',      'AddMenu')
  !bar.add('Remove',   'RemoveMenu')
--  !bar.add('Settings', 'SettingsMenu')

  -- Control Menu
  !menu = !!lstDbRefs.newMenu('ControlMenu')
    !menu.add('CALLBACK', 'Update',        '!!lstDbRefs.update()')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Close',         '!!lstDbRefs.close()')
    !menu.add('CALLBACK', 'Reload Form' ,  ' kill !!lstDbRefs
       !!lstGlobalStore.delete()
       pml rehash
       show !!lstDbRefs ')

  -- Add Menu
  !menu = !!lstDbRefs.newMenu('AddMenu')
    !menu.add('CALLBACK', 'CE',         '!!lstDbRefs.addElement(!!ce)')
    !menu.add('CALLBACK', 'CE Members', '!!lstDbRefs.addMembers(!!ce)')
    !menu.add('CALLBACK', 'Pick',       '!!lstDbRefs.pick(true)')
    !menu.add('CALLBACK', 'Select...',  '!!lstDbRefs.selection(''ADD'')')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Claimlist',  '!!lstDbRefs.addClaimlist(World)')
    !menu.add('CALLBACK', 'Drawlist',   '!!lstDbRefs.addDrawlist(World)')
    !menu.add('separator')
    !menu.add('CALLBACK', 'List...',    '!!lstDbRefs.addList()')

  -- Remove Menu
  !menu = !!lstDbRefs.newMenu('RemoveMenu')
    !menu.add('CALLBACK', 'All',        '!!lstDbRefs.removeAll()')
    !menu.add('CALLBACK', 'Selected',   '!!lstDbRefs.removeSelected()')
    !menu.add('separator')
    !menu.add('CALLBACK', 'CE',         '!!lstDbRefs.removeElement(!!ce)')
    !menu.add('CALLBACK', 'CE Members', '!!lstDbRefs.removeMembers(!!ce)')
    !menu.add('CALLBACK', 'Pick',       '!!lstDbRefs.pick(false)')
    !menu.add('CALLBACK', 'Select...',  '!!lstDbRefs.selection(''REMOVE'')')
    !menu.add('separator')
    !menu.add('CALLBACK', 'List',       '!!lstDbRefs.removeList()')


 -- Settings Menu
 -- !menu = !!lstDbRefs.newMenu('SettingsMenu')
 --   !menu.add('TOGGLE', 'Fullname',           '')
 --   !menu.add('TOGGLE', 'Sorted',             '')
 --   !menu.add('TOGGLE', 'Allow Duplications', '')
 --   !menu.add('separator')
 --   !menu.add('CALLBACK', 'Update', '!!lstDbRefs.display()')


-- Constructor
--!!lstDbRefs.lstDbRefs()

------------------------------------------------------------------------
--
-- Method:      lstDbRefs
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .lstDbRefs()

  -- Link Option gadget of form to list store
  call !!lstAddLinkList('DBREFS', !!lstDbRefs.lists, true, ARRAY(), ARRAY())

endmethod
-- End of method definition for .lstDbRefs()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialisation for the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  -- Form has not been shown before, then link run constructor
  if(!this.shownBefore.not()) then
    !this.lstDbRefs()
    !this.shownBefore = true
  endif

  -- Populate Members list
  !this.selectList()

  -- Maintain Pull-Downs for current list
  !this.pullDowns()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      pullDowns
--
-- Description:
--   Maintain the pull-downs for the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pullDowns()

  !bar  = !this.bar
  !menu = !this.addMenu

  -- Check if there are any lists (allow Add/Remove options)
  if(!this.lists.active) then

    !bar.setActive('Remove', true)
    !menu.setActive('CE',         true)
    !menu.setActive('CE Members', true)
    !menu.setActive('Pick',       true)
    !menu.setActive('Select...',  true)
    !menu.setActive('Claimlist',  true)
    !menu.setActive('Drawlist',   true)

  -- Disallow Add/Remove Options
  else
    !bar.setActive('Remove',false)
    !menu.setActive('CE',         false)
    !menu.setActive('CE Members', false)
    !menu.setActive('Pick',       false)
    !menu.setActive('Select...',  false)
    !menu.setActive('Claimlist',  false)
    !menu.setActive('Drawlist',   false)

  endif

  -- Select Remove Menu
  !menu = !this.removeMenu

  -- If there are no members, the grey-out remove options
  if(!this.members.dText.size() eq 0) then
    !menu.setActive('All',        false)
    !menu.setActive('Selected',   false)
    !menu.setActive('CE',         false)
    !menu.setActive('CE Members', false)
    !menu.setActive('Pick',       false)
    !menu.setActive('Select...',  false)
  else
    !menu.setActive('All',        true)
    !menu.setActive('Selected',   true)
    !menu.setActive('CE',         true)
    !menu.setActive('CE Members', true)
    !menu.setActive('Pick',       true)
    !menu.setActive('Select...',  true)
  endif

  -- Certain menu options are not available in certain modules
  -- and this form may be used in Design, Paragon and Draft.
  !module = !!module().appName.upcase()
  if (!module eq 'PARAGON') then
    !bar  = !this.bar
    !menu = !this.addMenu
      !menu.setActive('Pick',       false)
      !menu.setActive('Claimlist',  false)
      !menu.setActive('Drawlist',   false)
    !menu = !this.removeMenu
      !menu.setActive('Pick',       false)
  elseif (!module eq 'DRAFT') then
    !bar  = !this.bar
    !menu = !this.addMenu
      !menu.setActive('Pick',       false)
      !menu.setActive('Drawlist',   false)
    !menu = !this.removeMenu
      !menu.setActive('Pick',       false)
  endif

endmethod
-- End of method definition for .pullDowns()

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description:
--   Update all Linked gadgets for list store
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .update()

  -- Check is list has been updated
  if(!this.updated) then

    -- Set update flag to false
    !this.updated = false

    -- Check we want to update the list store
    if(!!alert.confirm(!!messageFile.messageString(149,005)).boolean()) then
      call !!lstReplaceList('DBREFS', !this.listName, !this.elements)

      -- Update list links, in case we have removed/add entries to empty ones
      call !!lstUpdate('DBREFS')

    endif
  endif

endmethod
-- End of method definition for .update()

------------------------------------------------------------------------
--
-- Method:      addList
--
-- Description:
--   Add a new list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addList()

  -- Reload the !!lstNew.frm
  pml reload form !!lstNew

  !!lstNew.setupForm('DBREFS', 'Create New DbRef List', '!!lstDbRefs.setList(!!lstNew.listTitle())')

endmethod
-- End of method definition for .addList()

------------------------------------------------------------------------
--
-- Method:      removeList
--
-- Description:
--   Remove current list from store
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removeList()

  -- Get list from DBREFS store
  call !!lstRemoveList('DBREFS', !this.listName)

  !this.selectList()

endmethod
-- End of method definition for .removeList()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close the form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  !this.update()
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      addElement
--
-- Description:
--   Add Current element to the active list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be added into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addElement(!item is DBREF)

  -- Add item to list
  !this.elements.append(!item)
  !this.updated  = true

  -- Display List
  !this.display()

endmethod
-- End of method definition for .addElement(DBREF)

------------------------------------------------------------------------
--
-- Method:      addMembers
--
-- Description:
--   Add Current element Members to the active list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element which members are to be added into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addMembers(!item is DBREF)

  -- Add Members of item to list
  !this.elements.appendArray(!item.members)
  !this.updated  = true

  -- Display List
  !this.display()

endmethod
-- End of method definition for .addMembers(DBREF)

------------------------------------------------------------------------
-- Define method
define method .addClaimlist(!item is DBREF)

  -- Add claimed Elements of item to list

   var !claimlistStr COLLECT ALL FROM CLAIMLIST

   if (!claimlistStr.unset()) then

   else

     do !indx indices !claimlistStr
       !claimlistDbRefs[!indx] = !claimlistStr[!indx].dbRef()
     enddo

     !this.elements.appendArray(!claimlistDbRefs)

     !this.updated  = true

     -- Display List
     !this.display()

   endif

endmethod
-- End of method definition for .addClaimlist(DBREF)

------------------------------------------------------------------------
-- Define method
define method .addDrawlist(!item is DBREF)

  -- Add Drawlist Elements of item to list

  var !drawlistStr COLLECT ALL FROM DRAWLIST

  if (!drawlistStr.unset()) then

  else

    do !indx indices !drawlistStr
      !drawlistDbRefs[!indx] = !drawlistStr[!indx].dbRef()
    enddo

    !this.elements.appendArray(!drawlistDbRefs)

    !this.updated  = true

    -- Display List
    !this.display()

  endif

endmethod
-- End of method definition for .addDrawlist(DBREF)

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description:
--   Setup Pickmode to Add/Remove items to active list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True add picked items to list
--                           False for removing items from list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick(!dummyType is BOOLEAN)

   write('Set up view into EDG mode')

endmethod
-- End of method definition for .pick(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      removeCe
--
-- Description:
--   Remove Current Element from current active list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element which members are to be added into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removeElement(!item is DBREF)

  -- If passed item exists in list, the remove it
  !index = !this.elements.findFirst(!item)
  if(!index.set()) then
    !this.elements[!index].delete()
    !this.updated  = true

    -- Display
    !this.display()

  endif

endmethod
-- End of method definition for .removeElement(DBREF)

------------------------------------------------------------------------
--
-- Method:      removeMembers
--
-- Description:
--   Remove Current Element members from current active list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element which members are to be added into list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removeMembers(!item is DBREF)

  -- Get members of Item
  !itemMembers = !item.members

  -- Difference
  !newList     = !this.elements.difference(!itemMembers)
  !this.elements = !newList

  -- Display
  !this.display()

  !this.updated  = true

endmethod
-- End of method definition for .removeMembers(DBREF)

------------------------------------------------------------------------
--
-- Method:      removeSelected
--
-- Description:
--   Remove selected items from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removeSelected()

  -- Check there are some selections
  if(!this.members.selection().unset()) then
    !!messageFile.warning(149, 006)
    return
  endif

  -- Remove entries from list
  do !i values !this.members.val
    !this.elements[!i].delete()
  enddo

  !this.updated  = true

  -- Display
  !this.display()

endmethod
-- End of method definition for .removeSelected()

------------------------------------------------------------------------
--
-- Method:      removeAll
--
-- Description:
--   Remove all elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .removeAll()

  -- Check there are some selections
  if(!this.members.dText.size() eq 0) then
    !!messageFile.warning(149, 007)
    return
  endif

  -- Remove all entries from list
  !this.elements.clear()

  !this.updated  = true

  -- Display
  !this.display()

endmethod
-- End of method definition for .removeAll()

------------------------------------------------------------------------
--
-- Method:      selectList
--
-- Description:
--   Select list and make current active
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .selectList()

  -- If update flag is set, then do we want to save changed?
  !this.update()

   -- Check we have a list to do something with
  if(!this.lists.active) then

    -- Get list from DBREFS store
    !this.listName = !this.lists.selection('RTEXT').part(2,'\')
    !this.elements = !!lstGetMembers('DBREFS', !this.listName)
    !this.updated  = false

  else
    !this.elements = ARRAY()
  endif

  -- Display List Selected into Members
  !this.display()

  -- Setup pull-downs
  !this.pullDowns()

endmethod
-- End of method definition for .selectList()

------------------------------------------------------------------------
--
-- Method:      setList
--
-- Description:
--   Select list and make current active
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List Name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setList(!tag is STRING)

  -- Select List
  !this.lists.select('DTEXT', !tag)

  -- Display selection
  !this.selectList()

endmethod
-- End of method definition for .setList(STRING)

------------------------------------------------------------------------
--
-- Method:      display
--
-- Description:
--   Select list and make current active
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .display()

  -- Re-build list
  if(!this.elements.set()) then

    -- Remove Duplications
    !this.elements.unique()

    -- Build Display and replacement text
    !block   = object BLOCK('!this.elements[!evalIndex].string()')
    !rList   = !this.elements.evaluate(!block)
    !block   = object BLOCK('!this.elements[!evalIndex].flnn')
    !dList   = !this.elements.evaluate(!block)

    -- Sort Display List
    !indices = !dList.sortedIndices()

    !block   = object BLOCK('!dList[!indices[!evalIndex]]')
    !newDl   = !dList.evaluate(!block)
    !block   = object BLOCK('!rList[!indices[!evalIndex]]')
    !newRl   = !rList.evaluate(!block)

    -- Display List
    !this.members.dText = !newDl
    !this.members.rText = !newRl

    -- Rebuild Elements list from RText members list
    !block              = object BLOCK('!newRl[!evalIndex].dbRef()')
    !this.elements      = !newRl.evaluate(!block)

  else
    !this.members.dText = ARRAY()

  endif

  -- Update pulldowns
  !this.pullDowns()

endmethod
-- End of method definition for .display()


------------------------------------------------------------------------
--
-- Method:      selectMember
--
-- Description:
--   Selected entry from Members
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget (Menu)
--    2   R      STRING      Selected/Unselected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .selectMember(!listGadget is GADGET, !select is STRING)

  -- If select, then move to item
  if(!select.upcase() eq 'SELECT') then
    !picked  = !listGadget.pickedField
    !!ce = !this.elements[!picked]
  endif

endmethod
-- End of method definition for .selectMember(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      selection
--
-- Description:
--   Show selection form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Method of showing selection form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .selection(!mode is STRING)

  !message = 'selection method not implemented: mode = ' + !mode
  write(!message)

endmethod
-- End of method definition for .selection(STRING)
