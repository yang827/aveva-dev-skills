--
-- File:            lstnew.pmlfrm
--   Type:          Form Definition
--   Group:         Form List Maintenance
--     Keyword:     LST
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Oct 27 16:36:57 WAT 1997
--
--
-- Description:
-- Define a New List
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check()                          -                   Check if a list already exists
--  create()                         -                   Create a new list
--  listTitle()                      STRING              Title of list
--  setupForm(STRING,STRING,STRING)  -                   Setup form to add to list
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!lstNew

-- Define form
setup form !!lstNew

  !!lstNew.formTitle     = 'Define New List'
  !!lstNew.iconTitle     = 'Newlst'
  !!lstNew.callback      = ''
  !!lstNew.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  text .list 'List Name ' at xmin ymax call '!!lstNew.check()' width 20 scroll 20 string

  -- Create/Dismiss
  button .ok     ' OK '   at xmin           ymax+0.2  call '!!lstNew.create()' ok
  button .cancel 'Cancel' at xmax form-size ymin cancel

  -- Form Members

    -- List Title
    member .title  is STRING

    -- Store we are looking at
    member .store  is STRING

    -- Action on OK
    member .action is STRING

exit
-- End of form definition for !!lstNew

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description:
--   Setup form to add to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Store to be added into
--    2   R      STRING      Title of form
--    3   R      STRING      Action on OK
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupForm(!storeType is STRING, !tag is STRING, !okAction is STRING)

  -- Initialise Variables
  !this.formTitle = !tag
  !this.store     = !storeType
  !this.action    = !okAction
  !this.title     = STRING()

  -- If form not shown, show it
  if(!this.shown().not()) then
    show !!lstNew
  endif

  !!lstNew.list.setFocus()

endmethod
-- End of method definition for .setupForm(STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      check
--
-- Description:
--   Check if a list already exists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .check()

  -- Check if there is already a list for the current store
  if(!!lstExists(!this.store, !this.list.val)) then
    !!messageFile.warning(149, 003, !this.list.val)

    -- Reset listname
    !this.list.val = ''

  endif

endmethod
-- End of method definition for .check()

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description:
--   Create a new list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .create()

  -- Add list to list store
  if(!this.list.val.trim().empty().not()) then

    !this.title = !this.list.val

    call !!lstAddList(!this.store, !this.title, ARRAY())

    -- If there an action, carry it out
    if(!this.action.trim().empty().not()) then
      $!this.action
    endif

  endif

endmethod
-- End of method definition for .create()

------------------------------------------------------------------------
--
-- Method:      listTitle
--
-- Description:
--   Title of list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      List Title
--
------------------------------------------------------------------------

-- Define method
define method .listTitle() is STRING

  return !this.title

endmethod
-- End of method definition for .listTitle() STRING
