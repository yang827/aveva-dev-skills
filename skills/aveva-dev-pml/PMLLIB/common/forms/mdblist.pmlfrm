--
-- Description:
-- Form to display project MDB data
--
------------------------------------------------------------------------

-- Define form
setup form !!mdbList resize

  !!mdbList.formTitle     = |MDB List|
  !!mdbList.iconTitle     = |MDB LIST|
  !!mdbList.callback      = |call !!mdbListInit()|
  !!mdbList.formRevision  = | $Revision: 1.4 $ |

  -- Body of form definition
  list .mdbs     at x 0 y 0.5 anchor left+top+bottom call |call !!mdbListSelect(!!mdbList.mdbs)| width 12 length 14

  para .mDesc    at xmax+1 y 0.4 anchor top+left width 43 lines 1

  list .current  at xmin.mDesc ymax |Current DBs|  anchor all width 43 length 4
  list .deferred at xmin.mDesc ymax |Deferred DBs| anchor bottom+left+right width 43 length 4

  button .dismiss at xmax form-size ymax |Dismiss| anchor bottom+right OK

exit
-- End of form definition for !!mdbList
