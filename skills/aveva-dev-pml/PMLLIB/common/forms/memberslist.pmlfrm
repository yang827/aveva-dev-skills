-- Kill existing form definition
kill !!membersList

-- Define form
setup form !!membersList

  !!membersList.formTitle     = 'Members'
  !!membersList.iconTitle     = ''
  !!membersList.callback      = 'call !!membersList()'
  !!membersList.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  option .worldType |World Type | call |call !!membersList()| width 10

  -- Display List
  list .members at xmin.worldType ymax+0.25 call |call !!membersDisplay(_members.selection().dbRef())| width 60 length 26

  -- Navigate on pick
  path right
  rgroup .navigate at xmax.worldType+5 ymin.worldType call |call !!membersListSet()|
    add tag |No Navigate| sel |false|
    add tag |Navigate| sel |true|
  exit

  -- Selected Item
  member .current is DBREF
  member .world   is DBREF

exit

-- Load WorldType
   !types[1] = 'DESI'
   !types[2] = 'CATA'
   !types[3] = 'PROP'
   !types[4] = 'SCHE'
   !desc[1]  = 'Design'
   !desc[2]  = 'Catalogue'
   !desc[3]  = 'Properties'
   !desc[4]  = 'Schematic'
   !!membersList.worldType.dText = !desc
   !!membersList.worldType.rText = !types

-- Select the correct DB type
   !module   = !!module()
   !!membersList.worldType.select('RTEXT',!module.ddlType)
   handle any
     -- DDL type not handled by members list yet, no action
   endhandle

-- End of form definition for !!membersList
