  !this.moduleTitles[159]  = 'Access Stairs and Ladders Application'

  -- Populate Module List
  !modules = !!messageFile.modules()

  !dText   = ARRAY()
  !rText   = ARRAY()

  do !i indices !modules
    !modNumber = '      ' & !modules[!i]
    !modNumber = !modNumber.subString(-1,-5)
    if(defined(!this.moduleTitles[!modules[!i]])) then
      !dText[!i] = !modNumber & ' - ' & !this.moduleTitles[!modules[!i]]
    else
      !dText[!i] = !modNumber & ' - No Description'
    endif
    !rText[!i] = !modules[!i].string()
  enddo

  -- Write to List gadget
  !this.moduleList.dText = !dText
  !this.moduleList.rText = !rText

  -- Select message for module
  !this.module(0)

endmethod
-- End of method definition for .messageList()

------------------------------------------------------------------------
--
-- Method:      module
--
-- Description:
--   Module Selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .module()

  -- Initialise Variables
  !entry = !this.moduleList.selection().real()
  !dText = ARRAY()

  -- Build Display List if not shown before
  !this.addModule(!entry)

  -- Load message into Display
  !this.messageList.dText = !this.messages[!entry]
  !this.moduleNumber      = !entry

  -- Select first message
  !this.message()

endmethod
-- End of method definition for .module()

------------------------------------------------------------------------
--
-- Method:      module
--
-- Description:
--   Module Selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Specific module
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .module(!entry is REAL)

  -- Initialise Variables
  !dText = ARRAY()

  !this.moduleList.select('RTEXT',!entry.string())
  handle any
    return
  endhandle

  -- Build Display List if not shown before
  !this.addModule(!entry)

  -- Load message into Display
  !this.messageList.dText = !this.messages[!entry]
  !this.moduleNumber      = !entry

  -- Select first message
  !this.message()

endmethod
-- End of method definition for .module(REAL)

------------------------------------------------------------------------
--
-- Method:      addModule
--
-- Description:
--   Add a module to the messages list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Module Number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addModule(!entry is REAL)

  -- Only load empty modules into message list
  if(defined(!this.messages[!entry])) then
    return
  endif

  -- Initialise Variables
  !dText = ARRAY()

  -- Get message for system
  !messages = !!messageFile.messages(!entry)

  -- Loop through defined messages
  do !i indices !messages
    !msgNumber = '     ' & !messages[!i].string()
    !message   = !!messageFile.getMessage(!entry, !messages[!i])
    !message   = !message.replace('
','<cr>')
    if(!message.length().gt(120)) then
      !message = !message.subString(1,110) & '...'
    endif
    !dText[!i] = !msgNumber.subString(-1,-5) & ' - ' & !message
  enddo
  !this.messages[!entry] = !dText

endmethod
-- End of method definition for .addModule(REAL)

------------------------------------------------------------------------
--
-- Method:      message
--
-- Description:
--   Message Selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .message()

  !this.messageNumber = !this.messageList.selection().part(1).real()

endmethod
-- End of method definition for .message()

------------------------------------------------------------------------
--
-- Method:      search
--
-- Description:
--   Search a module for the passed message (CASE IS NOT CHECKED)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Module number
--    2   R      STRING      Search String
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of message string
--
------------------------------------------------------------------------

define method .search(!module is REAL, !searchString is STRING) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()
  !newString   = !searchString.upcase()

  -- Load module into system
  !this.addModule(!module)

  -- Loop through messages
  do !i indices !this.messages[!module]
    !flag = !this.messages[!module][!i].upcase().matchWild(!newSearch)
    handle any
      !newSearch = !newString.replace('*?','~^')
      !flag = !this.messages[!module][!i].upcase().matchWild(!newSearch,'~','^')
      skip
    endhandle
    if(!flag) then
      !returnArray.append(!this.messages[!module][!i])
    endif
  enddo

  -- Return messages
  return !returnArray

endmethod
-- End of method definition for .search(REAL, STRING) ARRAY

------------------------------------------------------------------------
--
-- Method:      moduleTitle
--
-- Description:
--   Returns module title
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Module number
-- Return:
--   [Data Type] [Description]
--    STRING      Module Title
--
------------------------------------------------------------------------

define method .moduleTitle(!module is REAL) is STRING

  -- Initialise Variables
  !return = STRING()

  if(defined(!this.moduleTitles[!module])) then
    !return = !module & ' - ' & !this.moduleTitles[!module]
  else
    !return = !module & ' - No Description'
  endif

  -- Return messages
  return !return

endmethod
-- End of method definition for .moduleTitle(REAL) STRING
