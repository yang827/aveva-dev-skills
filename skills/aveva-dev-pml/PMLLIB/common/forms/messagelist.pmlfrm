--
--
-- Description:
--   List of all Application Messages.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addModule(REAL)                  -                   Add a module to the messages list
--  message()                        -                   Message Selection
--  messageList()                    -                   Constructor
--  module()                         -                   Module Selection
--  module(REAL)                     -                   Module Selection
--  moduleTitle(REAL)                STRING              Returns module title
--  search(REAL,STRING)              ARRAY               Search a module for the passed message (CASE IS NOT CHECKED)
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!messageList

-- Define form
setup form !!messageList

  !!messageList.formTitle     = 'Message List'
  !!messageList.iconTitle     = 'MsgLst'
  !!messageList.callback      = ''
  !!messageList.formRevision  = ' $Revision: 1.14 $ '

  -- Body of form definition

  -- List of Applications
  list .moduleList  'Module' at xmin ymin call '!!messageList.module()' width 60 length 8

  -- List of Error for selected application
  list .messageList 'Message (Codes)' at xmin ymax callback '!!messageList.message()' width 60 length 16

  -- Search for a message
  button .search 'Search...' at xmax-size ymax callback 'show !!messageSearch'

  -- Example
  frame .exampleFrame 'Example'  at x0.5 ymin
    button .error    'Error...'   at x1 y1 callback '!!messageFile.error(!!messageList.moduleNumber, !!messageList.messageNumber)'
    path right
    button .message  'Message...'                  callback '!!messageFile.message(!!messageList.moduleNumber, !!messageList.messageNumber)'
    button .warning  'Warning...'                  callback '!!messageFile.warning(!!messageList.moduleNumber, !!messageList.messageNumber)'

    button .prompt   'Prompt...'    at x1 ymax+0.5 callback '!!messageFile.prompt(!!messageList.moduleNumber, !!messageList.messageNumber)'
    button .confirm  'Confirm...'                  callback '!!alert.confirm(!!messageFile.messageString(!!messageList.moduleNumber, !!messageList.messageNumber))'
    button .question 'Question...'                 callback '!!alert.question(!!messageFile.messageString(!!messageList.moduleNumber, !!messageList.messageNumber))'

    button .soft     'Soft Message' at x1 ymax+0.5 callback '!!messageFile.softMessage(!!messageList.moduleNumber, !!messageList.messageNumber)'
    button .noalert  'Error No Alert'              callback '!!messageFile.errorNoAlert(!!messageList.moduleNumber, !!messageList.messageNumber)'

  exit

  -- Dismiss
  button .dismiss 'Dismiss' at xmax form-size ymax ok

  -- Members

  -- Message Descriptions
  member .moduleTitles  is ARRAY

  -- Messages for each module (loaded and retained)
  member .messages      is ARRAY

  member .moduleNumber  is REAL
  member .messageNumber is REAL

exit
-- End of form definition for !!messageList

------------------------------------------------------------------------
--
-- Method:      messageList
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

