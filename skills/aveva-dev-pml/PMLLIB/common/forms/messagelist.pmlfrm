  !this.moduleTitles[33]   = 'ISOMETRIC DETAILING MODULE'
  !this.moduleTitles[34]   = 'ISOSPOOL'
  !this.moduleTitles[35]   = 'FLEXlm system messages'
  !this.moduleTitles[36]   = 'DABACON INTEGRITY CHECKER INITIALISATION'
  !this.moduleTitles[37]   = 'Integrity Errors'
  !this.moduleTitles[38]   = 'VOLCAL MESSAGES'
  !this.moduleTitles[39]   = 'MONITOR'
  !this.moduleTitles[40]   = 'DETAILING LIBRARY'
  !this.moduleTitles[41]   = 'Barebone Constructor Library'
  !this.moduleTitles[42]   = 'PPOINT AND DESIGN CONSTRUCTOR LIBRARIES'
  !this.moduleTitles[43]   = 'MDB LIBRARY  AND ADMIN LIBRARY'
  !this.moduleTitles[44]   = 'FILE HANDLING ERRORS'
  !this.moduleTitles[45]   = 'STRESS LIBRARY'
  !this.moduleTitles[46]   = 'Messages for Programmable Macro Language (PML)'
  !this.moduleTitles[47]   = 'Command Processor'
  !this.moduleTitles[48]   = 'COMISO'
  !this.moduleTitles[58]   = 'ASKAPIPE STRESS INTERFACE'
  !this.moduleTitles[61]   = 'INTREPID and DESIGN Messages'
  !this.moduleTitles[62]   = 'INTERPIPE QUERY'
  !this.moduleTitles[63]   = 'ALL PDMS ATTRIBUTES FOR NEW QUERY SYSTEM'
  !this.moduleTitles[64]   = 'DRAFT'
