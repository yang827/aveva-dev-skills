  !this.moduleTitles[10]   = 'CLASHER'
  !this.moduleTitles[11]   = 'RACKO'
  !this.moduleTitles[12]   = 'GROUT'
  !this.moduleTitles[13]   = 'GROUTB'
  !this.moduleTitles[14]   = 'DATAL'
  !this.moduleTitles[15]   = 'DATACON'
  !this.moduleTitles[16]   = 'CATCON / INTERCAT'
  !this.moduleTitles[17]   = 'SPECON'
  !this.moduleTitles[20]   = 'Character font interface for GINO modules'
  !this.moduleTitles[21]   = 'REPORTER'
