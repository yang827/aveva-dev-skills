--
--
-- Description:
-- Form for searching the message system.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  search()                         -                   Search
--
------------------------------------------------------------------------

setup form !!messageSearch

  !!messageSearch.formTitle     = 'Search For a Message'
  !!messageSearch.iconTitle     = ''
  !!messageSearch.callback      = ''
  !!messageSearch.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition
  -- Options
  frame .optionFrame 'Search Options'

    text .string  'String ' at xmin+2 ymax width 44 is STRING
    path down
    halign right
    text .modules 'Modules '               width 44 is STRING
    button .search 'Search' at xmax+1 ymin callback '!!messageSearch.search()'
  exit

  -- List of found messages
  list .messages 'Messages' at x1 ymax+0.5 width 60 length 20

  -- Dismiss
  button .dismiss 'Dismiss' at xmax form-size ymax ok

exit
-- End of form definition for !!messageSearch

------------------------------------------------------------------------
--
-- Method:      search
--
-- Description: Search
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .search()

  -- Initialise Variables
  !moduleString = !this.modules.val
  !moduleList   = !!messageFile.modules()
  !modules      = ARRAY()

  -- Scan all Appware modules
  if(!moduleString.upcase().match('APPWARE').boolean()) then
    !moduleList.removeFrom(1,!moduleList.findFirst(141))
    !modules  = !moduleList

  -- Scan all modules
  elseif (!moduleString.upcase().match('ALL').boolean()) then
    !modules  = !moduleList

  -- Scan all modules
  elseif (!moduleString.upcase().match('CORE').boolean()) then
    !modules  = !moduleList.removeFrom(1,!moduleList.findFirst(141))

  -- Split list into individual modules
  else
    !list = !moduleString.split()
    do !i indices !list
      !modules.append(!list[!i].real())
      handle any
      endhandle
    enddo
  endif

  -- Make unique entries and sort
  !modules.unique().sort()

  -- Loop through message
  !messages = ARRAY()

  do !i indices !modules
    !moduleMessages = !!messageList.search(!modules[!i], !this.string.val)

    -- Skip if no messages
    skip if(!moduleMessages.unset())

    -- Put header in
    !moduleHeader   = !!messageList.moduleTitle(!modules[!i])
    !messages.append('')
    !messages.append(!moduleHeader)
    !messages.appendArray(!moduleMessages)

  enddo

  if(!messages.unset()) then
    !messages[1] = 'No Messages containing search string in passed specified modules'
  endif

  -- Write to form
  !this.messages.dText = !messages

endmethod
-- End of method definition for .search()
