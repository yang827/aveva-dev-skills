--
-- Description:
-- Modify a design items systems
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addSyst()                        -                   add ce in the system
--  addSyst(DBREF)                   -                   add ce in the system
--  databaseItemRightClick(ARRAY)    -                   Add
--  initialise()                     -                   Initialise form
--  makePrimary()                    -                   Makes the selected system the primary system
--  modifySystem()                   -                   Constructor
--  okCall()                         -                   Action set all the attributes
--  populateDbItemListGadgets(ARRAY) -                   Populate the dbItem list gadget with the values
--  removeSysMembers()               -                   Populate the Systems Members Lists
--  removeSyst()                     -                   remove the selected system from the
--  setPopupSysList()                -                   set up the popup for the Systems Lists
--  systemMemRightClick(ARRAY)       -                   Add
--  updateSystemData(ARRAY)          -                   Selection of new system update data
--  updateSystemMembList()           -                   Populate the Systems Members Lists
--

import 'ExplorerAddin'
handle any
endhandle

-- Import .Net Grid Control
import 'GridControl'
handle any
endhandle

-- Define form
layout form !!modifySystem resize
--setup form !!modifySystem resize

  member .apply is BOOLEAN
  member .modified is BOOLEAN
  member .select is REAL

  track 'DESICE' callback  '!this.initialise()'

  frame .dbElement |Database Items| anchor l+t+b width 35 height 10
    frame .databaseItemFrame panel anchor l+t+b width 35 heig 12
    -- PML Container to host .Net control
      container .netDatabaseItemFrame NOBOX pmlNetControl dock fill
    exit
    path down
    frame .tabset TABSET |tabset|  anchor l+b height 9
      frame .mdSysfFrame |Main Systems| width 30 height 3
        list .mdSysf dock fill
      exit
      frame .inSystFrame |Owning Systems| width 30 height 3
        list .inSyst dock fill
      exit
    exit
  exit

  frame .sysExplorer |System Explorer| at xmax.dbElement+1 ymin.dbElement anchor all
    container .explorerFrame NOBOX PmlNetControl 'NET' anchor t+l+r  width 30 height 11
    path down
    frame .systMemFrame |System Members|  at xmin.explorerFrame ymax.explorerFrame+0.2 anchor all width 30 height 10
    -- PML Container to host .Net control
      container .netSystMemFrame NOBOX pmlNetControl dock fill
    exit
  exit

  path down

  frame .attributes  |Attributes| at xmin.dbElement+1 ymax.sysExplorer anchor L+R+B
    text .desc |Description|  anchor l+b width 20 scroll 40 is STRING
    path right
    text .func |Function   | anchor l+b width 20 scroll 40 is STRING
  exit

  button .ok      'Apply Attributes'  anchor r+b  at xmax form-size   ymax+0.25
  path left
  button .cancel  'Close' anchor r+b at xmin.ok-10 ymin.ok width 8

   using namespace 'Aveva.Pdms.Presentation'

   -- Form members
   member .systemExplorer      is PMLEXPLORERCONTROL
   member .systemMemGrid       is NETGRIDCONTROL
   member .databaseItemGrid    is NETGRIDCONTROL
   member .system is DBREF

   --Pop up menu for Explorer control

  menu .pmlPopupDatabaseItem
  !this.pmlPopupDatabaseItem.add( 'CALLBACK','Add Selected Element(s) to this System ', '!this.addSyst()' ,'addCe')
  !this.pmlPopupDatabaseItem.add( 'separator')
  !this.pmlPopupDatabaseItem.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.databaseItemGrid, ||, |Save As|)' )
  !this.pmlPopupDatabaseItem.add( 'callback', 'Print Preview...', '!this.databaseItemGrid.printpreview()' )
  --
  menu .pmlPopupSysList
  !this.pmlPopupSysList.add( 'CALLBACK',      'Remove Element from this System',                '!this.removeSyst()' ,  'remCe' )
  !this.pmlPopupSysList.add( 'CALLBACK',      'Make this System Primary', '!this.makePrimary()',  'makePrimary')

  menu .pmlPopupSysMemList
  !this.pmlPopupSysMemList.add( 'CALLBACK',   'Remove Selected Element(s) from this System ', '!this.removeSysMembers()' ,'remSysMem')
  !this.pmlPopupSysMemList.add( 'CALLBACK',   'Apply Attributes ', '!this.okCall()')
  !this.pmlPopupSysMemList.add( 'separator')
  !this.pmlPopupSysMemList.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.systemMemGrid, ||, |Save As|)' )
  !this.pmlPopupSysMemList.add( 'callback', 'Print Preview...', '!this.systemMemGrid.printpreview()' )

exit

-- End of form definition for !!modifySystem

------------------------------------------------------------------------
--
-- Method:      modifySystem
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifySystem()

  !this.formTitle     = 'Modify Design System'
  !this.iconTitle     = 'ModSys'
  !this.initcall          = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1 $ '

--  !this.dbItem.callback   = '!this.populateDbItemListGadgets('
  !this.mdSysf.callback   = '!this.setPopupSysList()'
  !this.ok.callback = '!this.okCall()'
  !this.cancel.callback   = '!this.hide()'

   using namespace 'Aveva.Pdms.Presentation'

  !this.systemExplorer = object PMLEXPLORERCONTROL()
  -- Add .Net controls to PML containers
  !this.explorerFrame.control = !this.systemExplorer.handle()
  !this.systemExplorer.addeventhandler('OnSelectionChanged', !this, 'updateSystemData')
  !this.systemExplorer.initialise('/*','System')

  -- Add instances of .Net control
  !this.systemMemGrid = object NETGRIDCONTROL()
  !this.databaseItemGrid = object NETGRIDCONTROL()

  -- Add .Net controls to PML containers
  !this.netSystMemFrame.control = !this.systemMemGrid.handle()
  !this.netDatabaseItemFrame.control = !this.databaseItemGrid.handle()

   -- add PML event handlers to .Net control
   !this.systemMemGrid.addeventhandler('OnPopup', !this, 'systemMemRightClick')
   !this.databaseItemGrid.addeventhandler('AfterSelectChange', !this, 'populateDbItemListGadgets')
   !this.databaseItemGrid.addeventhandler('OnPopup', !this, 'databaseItemRightCLick')


  !headings=ARRAY()
  !headings.append('System')
  !headings.append('Description')
  !headings.append('Status')

  !this.mdSysf.setHeadings(!headings)
  !this.inSyst.setHeadings(!headings)

  !this.mdSysf.active=false
  !this.inSyst.active=false

endmethod

-- End of method definition for .modifySystem()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  using namespace  'Aveva.Pdms.Presentation'


  -- Set parameters
  !this.systemMemGrid.columnExcelFilter(TRUE)
  !this.systemMemGrid.outlookGroupStyle(FALSE)
  !this.systemMemGrid.fixedHeaders(FALSE)
  !this.systemMemGrid.headerSort(TRUE)
  !this.systemMemGrid.fixedRows(FALSE)
  !this.systemMemGrid.columnSummaries(FALSE)
  !this.systemMemGrid.singleRowSelection(FALSE)

  !this.databaseItemGrid.columnExcelFilter(FALSE)
  !this.databaseItemGrid.outlookGroupStyle(FALSE)
  !this.databaseItemGrid.fixedHeaders(FALSE)
  !this.databaseItemGrid.headerSort(TRUE)
  !this.databaseItemGrid.fixedRows(FALSE)
  !this.databaseItemGrid.columnSummaries(FALSE)
  !this.databaseItemGrid.singleRowSelection(FALSE)

  var !systemGpwls coll all sygpwl
  if (!systemGpwls.size() eq 0) then
    return error 1 'There is no system hierarchy present in the current MDB'
  endif

   !validElements = object ARRAY()
   !elements    = !!ce.mem
   !elements.insert(1, !!ce)
   do !element values !elements
      if (!element.attributes().findFirst('Mdsysf').set()) then
        !validElements.append(!element)
      endif
   enddo

   !grid = object ARRAY()
   do !memb values !validElements
     !row = ARRAY()
     !row.append(!memb.fullname)
     if (!memb.primsyst.set()) then
       !row.append(!memb.primsyst.fullname)
     else
       !row.append('Unset')
     endif
     !grid.append(!row)
   enddo

   !tableName = 'Design Items'
   !headings = ARRAY()
   !headings.append('Name')
   !headings.append('Primary System')

   !nds = object NETDATASOURCE(!tableName, !headings, !grid)
   !this.databaseItemGrid.bindToDataSource(!nds)
   !this.databaseItemGrid.setNameColumnImage()

   !this.databaseItemGrid.selectRow(1)
   !this.updateSystemMembList()

endmethod

-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      populateDbItemListGadgets()
--
-- Description: Populate the dbItem list gadget with the values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateDbItemListGadgets(!data is ARRAY)

   !element = !this.databaseItemGrid.getSelectedRows()

   !mdSysfDtext=ARRAY()
   !mdSysfRtext=ARRAY()
   !inSystDtext=ARRAY()
   !inSystRtext=ARRAY()
   if (!element.size() neq 1 ) then
     !this.mdSysf.active = FALSE
     !this.inSyst.active = FALSE
   else

     !inSyst=!element[1][1].dbref().inSyst
     !mdSysf=!element[1][1].dbref().mdSysf

     !c = 1
     do !i values !inSyst
       !namn=!i.namn
       !desc=!i.desc
       if (!c eq 1) then
         !mdSysfStatus='Primary'
       else
         !mdSysfStatus=''
       endif
       !test=!mdSysf.findFirst(!i)
       if (!test.unset()) then
         !inSystStatus='Owning System'
            !text=!namn & '	' & !desc & '	' & !inSystStatus
         !inSystDtext.append(!text)
         !inSystRtext.append(!i.name)
       else
         !inSystStatus='Main System'
         !text=!namn & '	' & !desc & '	' & !mdSysfStatus
         !mdSysfDtext.append(!text)
         !mdSysfRtext.append(!i.name)
         !text=!namn & '	' & !desc & '	' & !inSystStatus
         !inSystDtext.append(!text)
         !inSystRtext.append(!i.name)
       endif
       !c = !c + 1
     enddo

     !this.mdSysf.active=true
     !this.inSyst.active=true

   endif

   !this.mdSysf.dtext=!mdSysfDtext
   !this.mdSysf.rtext=!mdSysfRtext
   !this.inSyst.dtext=!inSystDtext
   !this.inSyst.rtext=!inSystRtext

endmethod

-- End of method definition for .populateDbItemListGadgets()

------------------------------------------------------------------------
--
-- Method:      removeSyst
--
-- Description: remove the selected system from the
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeSyst()

  !this.select = !this.databaseItemGrid.getSelectedRowTags()[1].real()
  handle ANY
    !!alert.message('Please select an element in the Database items list')
    return
  endhandle
  !element = !this.databaseItemGrid.getSelectedRows()[1][1].dbref()
  !n = !this.mdSysf.rtext.findFirst(!this.mdSysf.selection())
  !mdSysf = !this.mdSysf.rtext
  !mdSysf.remove(!n)
  !mdSysfDbref = ARRAY()
  do !index index !mdSysf
    !mdSysfDbref.append(!mdSysf[!index].dbref())
  enddo

  if (!mdSysfDbref.size() eq 0) then
    !ce = !!ce
    !!ce = !element
    MDSYSF unset
    !!ce = !ce
  else
    !element.mdSysf = !mdSysfDbref
  endif
  !this.updateSystemMembList()
  !data = ARRAY()
  !this.populateDbItemListGadgets(!data)

endmethod

-- End of method definition for .removeSyst()

------------------------------------------------------------------------
--
-- Method:      makePrimary
--
-- Description: make the currently selected system the primary system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .makePrimary()


  !this.select = !this.databaseItemGrid.getSelectedRowTags()[1].real()
  !element = !this.databaseItemGrid.getSelectedRows()[1][1].dbref()
  !n = !this.mdSysf.rtext.findFirst(!this.mdSysf.selection())
  !mdSysf = !this.mdSysf.rtext
  !mdSysf.remove(!n)
  !mdSysf.insert(1,!this.mdSysf.selection())
  !mdSysfDbref = ARRAY()
  do !index index !mdSysf
    !mdSysfDbref.append(!mdSysf[!index].dbref())
  enddo

  if (!mdSysfDbref.size() eq 0) then
    !ce = !!ce
    !!ce = !element
    MDSYSF unset
    !!ce = !ce
  else
    !element.mdSysf = !mdSysfDbref
  endif
  !this.updateSystemMembList()
  !data = ARRAY()
  !this.populateDbItemListGadgets(!data)

endmethod

-- End of method definition for .makePrimary()

------------------------------------------------------------------------
--
-- Method:      updateSystemData
--
-- Description: Selection of new system update data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Reference of element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateSystemData(!data is ARRAY)

  !this.system = !data[0].dbref()
  !this.updateSystemMembList()

endmethod

-- End of method definition for .updateSystemData()
------------------------------------------------------------------------
--
-- Method:      addSyst
--
-- Description: add ce in the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The element which is to be included into current system.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addSyst()
  -- We need to get the selected in Database/List order
  !sortedArray = !this.databaseItemGrid.getSelectedRowTags().sort()
  !this.select = !this.databaseItemGrid.getSelectedRowTags()[1].real()
  do !i indices !sortedArray
    !this.addSyst(!this.databaseItemGrid.getCell(!sortedArray[!i].real(), 1).dbref())
  enddo
  !this.updateSystemMembList()
  !data = ARRAY()
  !this.populateDbItemListGadgets(!data)
endmethod

-- End of method definition for .addSyst()
------------------------------------------------------------------------
--
-- Method:      addSyst
--
-- Description: add ce in the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       The element which is to be included into current system.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addSyst(!ce is DBREF)

-- Go back to the design item
   !mdSysf = !ce.mdSysf
   !inSyst = !ce.inSyst

   -- Check that is not already part of this system
   if (!mdSysf.findFirst(!this.system).set()) then
     !!alert.error(!ce.name & ' is already assigned to this system')
     return
   endif

   -- Check that is not already part of this system by virtue of it's owner
   if (!inSyst.findFirst(!this.system).set()) then
     !!alert.error(!ce.name & ' is already part of this system by virtue of its owner ')
     return
   endif

   !mdSysf.append(!this.system)
   !ce.mdSysf       = !mdSysf
   !this.modified   = true
   !this.apply      = FALSE

endmethod

-- End of method definition for .addSyst()
------------------------------------------------------------------------
--
-- Method:      setPopupSysList
--
-- Description: set up the popup for the Systems Lists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPopupSysList()

    if(!this.mdSysf.dtext.size().eq(0)) then
      !this.pmlPopupSysList.setFieldProperty('remCe' , 'active' , false)
      !this.pmlPopupSysList.setFieldProperty('makePrimary','active', false)
    elseif(!this.mdSysf.dtext.size().eq(1)) then
      !this.pmlPopupSysList.setFieldProperty('remCe' , 'active' , true)
      !this.pmlPopupSysList.setFieldProperty('makePrimary','active', false)
    else
     !this.pmlPopupSysList.setFieldProperty('remCe' , 'active' , true)
     !this.pmlPopupSysList.setFieldProperty('makePrimary','active', true)
    endif
    if (!this.mdSysf.val eq 1 ) then
      !this.pmlPopupSysList.setFieldProperty('makePrimary','active', false)
    endif
    !this.mdSysf.popup = !this.pmlPopupSysList

endmethod
-- End of method definition for .setPopupSysList()
------------------------------------------------------------------------
--
-- Method:      updateSystemMembList
--
-- Description: Populate the Systems Members Lists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateSystemMembList()

  using namespace  'Aveva.Pdms.Presentation'

  !grid = object ARRAY()
  --P30975 stops an error if the system group has been deleted whilst the form is visible
  if !this.system.badref() then
    return
  endif


  if(!this.system.set() and !this.system.type eq 'SYSGRP')then
    !members = !this.system.smemb
    do !memb values !members
      !row = ARRAY()
      !row.append(!memb.fullname)
      !row.append(!memb.type)
      !row.append(!memb.desc)
      !row.append(!memb.func)
      !grid.append(!row)
    enddo
    !this.desc.val = !this.system.desc
    !this.func.val = !this.system.func
  endif

  !tableName = 'System Members'
  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('Type')
  !headings.append('Description')
  !headings.append('Function')

  !nds = object NETDATASOURCE(!tableName, !headings, !grid)
  !this.systemMemGrid.bindToDataSource(!nds)
  !this.systemMemGrid.setNameColumnImage()

endmethod
-- End of method definition for .updateSystemMembList()
------------------------------------------------------------------------
--
-- Method:      removeSysMembers()
--
-- Description: Populate the Systems Members Lists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeSysMembers()

  !errorAtt = FALSE
  !errorWrite = FALSE
  !systemMemRow = !this.systemMemGrid.getSelectedRows()
  do !row values !systemMemRow
    !element = !row[1].dbref()
    !mdSysf = !element.mdSysf
    handle(2,201)
      -- item is in marine diagrams
      !errorAtt = TRUE
    elsehandle NONE
    	!write = !!dbrefUpdatable(!element)
    	if (!write) then
        !number = !mdSysf.findFirst(!this.system)
        !mdSysf.deleteFrom(!number,1)
        !mdSysf.compress()
        if (!mdSysf.size() eq 0) then
          !ce = !!ce
          !!ce = !element
          MDSYSF unset
          !!ce = !ce
        else
          !element.mdSysf = !mdSysf
        endif
      else
        !errorWrite = TRUE
      endif
    endhandle
  enddo

  if (!errorAtt) then
    !errorString = 'Marine diagram items have not been removed from System. '
  else
    !errorString = ''
  endif
  if (!errorWrite) then
    !errorString = !errorString & 'Some items could not be removed as they could not be written to'
  else
    !errorString = ''
  endif

  if (!errorAtt or !errorWrite) then
    !!alert.error(!errorString)
  endif

  -- Initialise the whole form to update all gadgets
  !this.initialise()

endmethod
-- End of method definition for .removeSysMembers()
------------------------------------------------------------------------
--
-- Method:      systemMemRightClick
--
-- Description: Add
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .systemMemRightClick(!data is ARRAY)

  !systemMemRow = !this.systemMemGrid.getSelectedRows()

  !removable = FALSE
  do !row values !systemMemRow
    !element = !row[1].dbref()
    !test = !element.mdSysf
    handle (2,201)
      -- item does not have a mdSysf attribute
    elsehandle NONE
      if (!element.dbwrite) then
        !removable = TRUE
      endif
    endhandle
  enddo

  if (!removable) then
  	!this.pmlPopupSysMemList.setFieldProperty('remSysMem','ACTIVE',TRUE)
  else
  	!this.pmlPopupSysMemList.setFieldProperty('remSysMem','ACTIVE',FALSE)
  endif
  !this.netSystMemFrame.popup = !this.pmlPopupSysMemList
  !this.netSystMemFrame.showPopup(!data[0], !data[1])

endmethod

------------------------------------------------------------------------
--
-- Method:      databaseItemRightClick
--
-- Description: Add
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .databaseItemRightClick(!data is ARRAY)


  if (!this.system.type eq 'SYSGRP') then
  	!this.pmlPopupDatabaseItem.setFieldProperty('addCe','ACTIVE',TRUE)
  else
  	!this.pmlPopupDatabaseItem.setFieldProperty('addCe','ACTIVE',FALSE)
  endif
  !this.netDatabaseItemFrame.popup = !this.pmlPopupDatabaseItem
  !this.netDatabaseItemFrame.showPopup(!data[0], !data[1])

endmethod

------------------------------------------------------------------------
--
-- Method:      okCall
--
-- Description: set the function and description and leave the mdSysf alone!
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .okCall()

  !errorWrite = FALSE

  !systemMemRow = !this.systemMemGrid.getSelectedRows()

  do !row values !systemMemRow
    !element = !row[1].dbref()
    !write = !!dbrefUpdatable(!element)
    if (!write) then
    	!element.desc = !this.desc.val
    	!element.func = !this.func.val
    else
      !errorWrite = TRUE
    endif
  enddo

  -- What if no elements selected? - Also give an alert
  if (!systemMemRow.size() eq 0) then
  	!!alert.error('No System Members selected')
  	return  	
  endif
  	
  if (!errorWrite) then
    !errorString = 'Some items could not be modified as they could not be written to'
  else
    !errorString = ''
  endif

  if (!errorWrite) then
    !!alert.error(!errorString)
  endif
  !this.updateSystemMembList()

endmethod

-- End of method definition for .okCall()
