--
-- Description:
-- Store session message for extract operations
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Savework and session comment
--  initialise()                     -                   Initialise
--
------------------------------------------------------------------------

setup form !!msgExtractCntrol blocking
-- background gold

  !this.formTitle     = 'Extract Session Comment'
  !this.iconTitle     = 'ExtractSession'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.2 $ '

  -- Body of form definition
  para     .question     at x0.5 y0.5 width 40 lines 2

  textpane .sessionComment 'Session Comment '  at x1 ymax width 40 height 5

  -- Create/Dismiss
  button .yes ' YES  '   at x0.5  ymax  call '!this.apply()' ok
  button .no  '  NO  '   at xmax form-size ymin cancel

exit
-- End of form definition for !this

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1     RW     REAL       -1, 0 or 1 identifiers for -, current or + button pressed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()


--if (!a[!b].modified()) then
--  !this.question.val = 'Savework!     Are You Sure?  '
--  !this.question.background = 4
--  !this.yes.tag = ' YES  '
--  !this.no.tag  = '  NO  '
--else
--  !this.question.val = 'No changes made this session!'
--  !this.question.background = 4
--  !this.yes.tag = '  OK  '
--  !this.no.tag  = 'Cancel'
--endif

  var !sessText COMPOSE |$!!admExtractCntrol.sessionComment| WIDTH 40
  !this.sessionComment.val = !sessText
  !this.question.val       = !!admExtractCntrol.sessionQuestion
  !this.sessionComment.setFocus()

endmethod
-- End of method definition for .initialise(REAL)

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Savework and session comment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Session comment in pdms must be 1 line string input
  !sessCText = ''
  do !i from 1 to !this.sessionComment.count
    !sessC = !sessCText & ' ' & !this.sessionComment.line(!i)
    !sessCText = !sessC
  enddo

  !sessCText = !sessCText.replace('|',':')
  !!admExtractCntrol.sessionComment  = !sessCText
  !callback = !!admExtractCntrol.sessionCallback
  $!callback

endmethod
-- End of method definition for .apply()
