--
-- Description:
-- Define a New List
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Savework and session comment
--  initialise(REAL)                 -                   Initialise
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!msgSavework

-- Define form
setup form !!msgSavework blocking
-- background gold

  !!msgSavework.formTitle     = 'Savework / Session Comment'
  !!msgSavework.iconTitle     = 'SaveSession'
  !!msgSavework.callback      = '!this.initialise(0)'
  !!msgSavework.formRevision  = ' $Revision: 1.24 $ '

  -- Body of form definition
  para     .question     at x5 y0.5  text      'Savework!     Are You Sure?  '

  textpane .sessionComment 'Session Comment :-'  at x1 ymax width 35 height 5

  -- Other Session Comments
  para   .others              at x0    ymax text 'DB Session Comments :-  '
  button .prevCom  '-'        at xmax_others  ymin call '!this.initialise(-1)'
  button .current  'Current'  at xmax         ymin call '!this.initialise(0)'
  button .nextCom  '+'        at xmax         ymin call '!this.initialise(1)'

  -- Create/Dismiss
  button .yes ' YES  '   at x0  ymax+0.5  call '!this.apply()' ok
  button .no  '  NO  ' at xmax form-size ymin cancel


  -- Form Members
  member .time    is STRING
  member .date    is STRING
  member .sessNum is REAL
  member .sessMax is REAL
  member .sessCur is BOOLEAN

exit
-- End of form definition for !!msgSavework

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1     RW     REAL       -1, 0 or 1 identifiers for -, current or + button pressed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise(!preComment is REAL)

  !a = ARRAY()
  !b = REAL()
  !a = SESSION
  -- Check to see if anything has been modified
  do !i indices !a
    -- find the current session
    if !a[!i].isCurrent then
      !b = !i
    endif
  enddo

if (!a[!b].modified()) then
  !this.question.val = 'Savework!     Are You Sure?  '
  !this.question.background = 4
  !this.yes.tag = ' YES  '
  !this.no.tag  = '  NO  '
else
  !this.question.val = 'No changes made this session!'
  !this.question.background = 4
  !this.yes.tag = '  OK  '
  !this.no.tag  = 'Cancel'
endif

  -- set the session comment
  if (!preComment eq 0) then
    -- Standard initialisation or Current button
    var !sessC SESSCOMMENT -1
    !this.prevCom.active = true
    !this.nextCom.active = false
    !this.sessCur        = true
    -- Read the time now
    var !clockStr CLOCK
    !clockArr = !clockStr.split()
    !this.time = !clockArr[4]
    !this.date = !clockArr[1] & ' ' & !clockArr[2] & ' ' & !clockArr[3]
    -- Set Session number
    var !sessDnum SESSION ON $!this.time $!this.date
    !sessDnumReal = !sessDnum.real()
    !this.sessNum = !sessDnumReal
    !this.sessMax = !sessDnumReal

  elseif (!preComment eq -1) then
    -- - button pressed
    if (!this.sessCur) then
      -- displayed comment must be current not max
      -- These are different so SessNum is raised by 1
      -- So that the + and - buttons can switch correctly.
      !this.sessNum = !this.sessNum + 1
    endif
    !this.sessNum = !this.sessNum - 1
    !this.nextCom.active = true
    if (!this.sessNum neq 1) then
      var !sessC SESSCOMMENT $!this.sessNum
      handle (2,1)
        -- handle number less than zero
        var !clockStr CLOCK
        !clockArr = !clockStr.split()
        !this.time = !clockArr[4]
        !this.date = !clockArr[1] & ' ' & !clockArr[2] & ' ' & !clockArr[3]
        -- Set Session number
        var !sessDnum SESSION ON $!this.time $!this.date
        !sessDnumReal = !sessDnum.real()
        !this.sessNum = !sessDnumReal
        var !sessC SESSCOMMENT -1
        !this.nextCom.active = false
        !this.sessCur        = true
      elsehandle (2,201)
        -- merged session number ie sessions 1 2 3 4 could be sessions 1 4
        -- where 2 and 3 have been merged into 4
        do !merged from 1 to !this.sessNum
          !this.sessNum = !this.sessNum - 1
          var !sessC SESSCOMMENT $!this.sessNum
          handle any
            -- ignore any errors
          elsehandle none
            break
          endhandle
        enddo
      endhandle
      !this.sessCur        = false
    else
      var !sessC SESSCOMMENT 1
      !this.prevCom.active = false
      !this.sessCur        = false
    endif

  elseif (!preComment eq 1) then
    -- + button pressed
    if (!this.sessCur) then
      -- displayed comment must be current not max
      -- These are different so SessNum is raised by 1
      -- So that the + and - buttons can switch correctly.
      !this.sessNum = !this.sessNum + 1
    endif
    if (!this.sessNum eq !this.sessMax ) then
      var !clockStr CLOCK
      !clockArr = !clockStr.split()
      !this.time = !clockArr[4]
      !this.date = !clockArr[1] & ' ' & !clockArr[2] & ' ' & !clockArr[3]
      -- Set Session number
      var !sessDnum SESSION ON $!this.time $!this.date
      !sessDnumReal = !sessDnum.real()
      !this.sessNum = !sessDnumReal
      var !sessC SESSCOMMENT -1
      !this.nextCom.active = false
      !this.sessCur        = true
    else
      !this.sessNum = !this.sessNum + 1
      !this.prevCom.active = true
      !this.sessCur        = false

      var !sessC SESSCOMMENT $!this.sessNum
      handle (2,201)
        -- handle number higher than current session
        -- Should not be possible to go higher than max because the button
        -- will be greyed out
        -- merged session number ie sessions 1 2 3 4 could be sessions 1 4
        -- where 2 and 3 have been merged into 4do !merged from 1 to !this.sessNum
        do !merged from 1 to !this.sessMax
          !this.sessNum = !this.sessNum + 1
          var !sessC SESSCOMMENT $!this.sessNum
          handle any
            -- ignore any errors
          elsehandle none
            break
          endhandle
        enddo
      endhandle
    endif

  endif

  !sessC = !sessC.replace('|','||')
  var !sessText COMPOSE |$!sessC| WIDTH 35

  !!msgSavework.sessionComment.val = !sessText

  !!msgSavework.yes.setFocus()

endmethod
-- End of method definition for .initialise(REAL)

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Savework and session comment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Session comment in pdms must be 1 line string input
  !sessCText = STRING()
  !sessCText = ''
  do !i from 1 to !this.sessionComment.count
    if (!i eq 1) then
     !sessC = !this.sessionComment.line(!i)
     !sessCText = !sessC
    else
     !sessC = !sessCText & ' ' & !this.sessionComment.line(!i)
     !sessCText = !sessC
    endif
  enddo

  !sessCText = !sessCText.replace('|','||')
  SESSION COMMENT |$!sessCText|

  if (!this.yes.tag eq ' YES  ') then
    SAVEWORK
    SESSION COMMENT 'Unset'
  endif

endmethod
-- End of method definition for .apply()
