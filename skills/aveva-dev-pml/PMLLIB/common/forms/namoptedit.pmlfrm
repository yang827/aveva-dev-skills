--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Thu Apr 3 09:11:01 BST 1997
--
--
-- Description:
-- form to edit naming settings
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -                   form initialisation
--  load()                           -                   load the defaults
--  mode()                           -                   action for the mode radio group
--  namOptEdit()                     -                   Constructor
--  ok()                             -                   action for ok callback
--  save()                           -                   save the defaults
--
------------------------------------------------------------------------

-- Define form
setup form !!namOptEdit
import 'pmlfilebrowser'
handle any
endhandle

  !!namOptEdit.formTitle     = 'Naming Settings'
  !!namOptEdit.iconTitle     = 'Naming'
  !!namOptEdit.callback      = '!!namOptEdit.init()'
  !!namOptEdit.formRevision  = ' $Revision: 1.8 $ '

  -- local form data store
  member .data is NAMOPT

  -- Body of form definition
  bar
    add 'File' .fileMenu
  exit

  toggle .auto 'Auto Naming On/Off' at x1

  path down
  vdist 0.25
  button .rules 'Define Naming Rules...'
  paragraph .usingRuleSet text ' ' width 25

  rgroup .mode 'Naming Mode' frame horizontal
    add tag 'Infill  '
    add tag 'Append  '
  exit

  button .ok     'OK'     width 8 at xmin form ok
  button .cancel 'Cancel' width 8 at xmax form-size ymin  cancel

exit
-- End of form definition for !!namOptEdit

------------------------------------------------------------------------
--
-- Method:      !namOptEdit()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .namOptEdit()

 --Create global instance for the object NAMOPT if it is undefined
  if(undefined(!!namOpt))then
    call !!comDefineGlobal(object NAMOPT())
  endif

  --Create global instance for the object RULESTORE if it is undefined
  if(undefined(!!ruleStore))then
    call !!comDefineGlobal(object RULESTORE())
  endif

  -- build menu bar
  !this.newMenu('fileMenu')
  !this.fileMenu.add('callback', 'Save', '!!namOptEdit.save()', 'namOptEditSave')
  !this.fileMenu.add('callback', 'Load', '!!namOptEdit.load()')

  -- define callbacks
  !this.auto.callback = '!!namOptEdit.data.auto(!!namOptEdit.auto.val)'
  !this.rules.callback = 'show !!namOptRulesEdit'
  !this.mode.callback = '!!namOptEdit.mode()'

  !this.okCall = '!!namOptEdit.ok()'

  -- prevent non-Admin user from saving naming rules
  !this.fileMenu.setFieldProperty('namOptEditSave', 'ACTIVE',!!comAdminStatus())

endmethod
-- End of method definition for .namOptEdit()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  -- copy the current global settings and unset the global flag
  !this.data = !!namOpt.localCopy()

  -- initialise form gadgets to main data settings
  !this.auto.val = !this.data.auto

  !this.load()

  if (!this.data.mode.upcase() ne 'APPEND') then
    !this.mode.val = 1
  else
    !this.mode.val = 2
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: save the defaults
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .save()

  -- save all the data
  !this.data.save()
  -- set name rules location
  if( !this.data.optionsFileType eq 'DEFAULT' ) then
    !message = 'Using System defined naming rules'
  elseif( !this.data.optionsFileType eq 'PROJ' ) then
    !message = 'Using Project defined naming rules'
  else
    !message = 'Using User defined naming rules'
  endif
  !this.usingRuleSet.val = !message

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load the defaults
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- load the data
  !this.data.load()
  -- set name rules location
  if( !this.data.optionsFileType eq 'DEFAULT' ) then
    !message = 'Using System defined naming rules'
  elseif( !this.data.optionsFileType eq 'PROJ' ) then
    !message = 'Using Project defined naming rules'
  else
    !message = 'Using User defined naming rules'
  endif
  !this.usingRuleSet.val = !message

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      !mode()
--
-- Description: action for the mode radio group
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .mode()

  if (!this.mode.val eq 1) then
    !this.data.mode('INFILL')
  else
    !this.data.mode('APPEND')
  endif

endmethod
-- End of method definition for .mode()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: action for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  !this.data.save()

  -- set all the global naming settings
  !this.data.copyToGlobal()

endmethod
-- End of method definition for .ok()
