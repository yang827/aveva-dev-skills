--
--
-- Description:
-- form to edit autonaming rules
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clearInput()                     -                   reset the input gadgets
--  copy()                           -                   copy action
--  cut()                            -                   cut action
--  init()                           -                   form initialisation
--  inputData()                      NAMOPTRULE          method to return input data as NAMOPTRULE object
--  insert()                         -                   insert action
--  listRules(REAL)                  -                   method to display naming rules on form
--  namOptRulesEdit()                -
--  ok()                             -                   action for ok callback
--  replace()                        -                   replace action
--  rule()                           -                   check the rule name input
--  ruleDisplay()                    -                   method to display detail of selected autocolour rule
--  ruleSelect()                     -                   show a combo box selection form with rules
--  test()                           -                   action for ok callback
--  validKey()                       -                   check the key is valid
--
------------------------------------------------------------------------

-- Define form
setup form !!namOptRulesEdit

  member .modified is BOOLEAN

  !!namOptRulesEdit.formTitle     = 'Naming Rules'
  !!namOptRulesEdit.iconTitle     = 'Naming'
  !!namOptRulesEdit.callback      = '!!namOptRulesEdit.init()'
  !!namOptRulesEdit.formRevision  = ' $Revision: 1.17 $ '

  -- owning form, it is necessary to store this as a form member, as .owner()
  -- does not work in a method that is run, after the form is hidden e.g. .ok()
  member .main is FORM

  -- local form data store
  member .data is NAMOPT

  -- Body of form definition
  frame .input 'Data Input' width 71
    text .key  'Key        ' at xmin+1 ymax+0.2 width 30 scroll 10 is STRING
    text .scan 'Scan Level' at xmax+4 ymin width 6 scroll 6 is STRING
    text .rule 'Rule Name  ' at xmin.key ymax+0.2 width 30 is STRING
    button .ruleSelect at xmax ycen-0.5 * size pixmap width 9 height 12
    button .ruleDefine 'Element Rules...' at xmax.rule+4 ymin
    text .description 'Description' at xmin.key ymax+0.2 width 56 scroll 56 is STRING
    text .format      'Format     ' at xmin ymax+0.2 width 56 scroll 200 is STRING
    text .indices     'Indices    ' at xmin ymax+0.2 width 6 scroll 5 is STRING
  exit

  button .cut    ' Cut  ' at xmax.input-46 ymax+0.5
  button .copy   ' Copy ' at xmax+1 ymin
  button .replace 'Replace' at xmax+1 ymin
  button .insert 'Insert' at xmax+1 ymin
  option .insertOpt at xmax ymin width 6

  frame .dataDisplay 'Data Display' at xmin.input ymax+0.4
    list .ruleDisplay 'Key' at xmin+1 ymax+0.2 width 30 height 9
    textpane .subDisplay 'Data' at xmax+2 ymin-0.2 width 35 height 11
  exit

  button .test ' Test ' at xmin.input ymax+0.5
  text .testReturn at xmax+1 ymin width 40 is STRING
  toggle .testRule 'Use Rule ' at xmax+1 ymin

  button .ok     '  OK  ' at x0 ymax+0.5 ok
  button .cancel 'Cancel' at xmax form-size ymin  cancel

exit
-- End of form definition for !!namOptRulesEdit

------------------------------------------------------------------------
--
-- Method:      !namOptEdit()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .namOptRulesEdit()

  -- set icons
  !this.ruleSelect.addPixmap(!!pml.getPathName('comboboxarrow9x12.png'))

  -- define callbacks
  !this.rule.callback = '!!namOptRulesEdit.rule()'
  !this.ruleSelect.callback = '!!namOptRulesEdit.ruleSelect()'
  !this.ruleDefine.callback = '!!ruleStore.element.edit(||)'

  !this.cut.callback = '!!namOptRulesEdit.cut()'
  !this.copy.callback = '!!namOptRulesEdit.copy()'
  !this.replace.callback = '!!namOptRulesEdit.replace()'
  !this.insert.callback = '!!namOptRulesEdit.insert()'

  !this.ruleDisplay.callback = '!!namOptRulesEdit.ruleDisplay()'

  !this.test.callback = '!!namOptRulesEdit.test()'

  !this.okCall = '!!namOptRulesEdit.ok()'

  !this.subDisplay.setEditable(false)

  !dText[1] = 'Before'
  !rText[1] = 'BEFORE'
  !dText[2] = 'After'
  !rText[2] = 'AFTER'
  !this.insertOpt.dText = !dText
  !this.insertOpt.rText = !rText

endmethod
-- End of method definition for .namOptRulesEdit()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  -- check that the user has admin status
  if (!!comAdminStatus()) then
    -- set link to owning form
    !this.main = !this.owner()

    -- copy the current settings from the owning form
    !this.data = !this.main.data

    -- initialise form gadgets to main data settings

    -- display the data
    !this.listRules(1)

    -- initialise the input gadgets
    !this.clearInput()

  else
    -- warn user that they are in the wrong team, but an error is needed to abort initialisation
    !!messageFile.warning(146, 55)
    !!messageFile.errorNoAlert(146, 55)
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !listRules()
--
-- Description: method to display naming rules on form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .listRules(!index is REAL)

  -- Populate list with auto colour rules
  !dText = ARRAY()

  do !value values !this.data.rules
    !dText.append(!value.key)
  enddo

  if (!this.data.rules.empty()) then
    !dText.append('No Rules')
  endif

  !this.ruleDisplay.dText = !dText

  -- select the specified rule
  -- if index is greater than the number of list entries then
  -- set it to the number of the last list entry
  if (!index gt !this.ruleDisplay.dText.size() and !this.ruleDisplay.dText.size() ne 0) then
    !this.ruleDisplay.val = !this.ruleDisplay.dText.size()
  elseif  (!this.ruleDisplay.dText.size() ne 0) then
    !this.ruleDisplay.val = !index
  endif

  !this.ruleDisplay()

endmethod
-- End of method definition for .listRules(REAL)

------------------------------------------------------------------------
--
-- Method:      !ruleDisplay()
--
-- Description: method to display detail of selected autocolour rule
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ruleDisplay()

  if (!this.ruleDisplay.selection().upcase() eq 'NO RULES') then
    !this.subDisplay.clear()

  else
    -- Populate list with auto colour rules
    !dText = ARRAY()

    !tempRule = !this.data.rules[!this.ruleDisplay.val]


    !dText.append('Key:		' + !tempRule.key)
    !dText.append('Description:	' + !tempRule.description)
    !dText.append('Rule Name:	' + !tempRule.rule)

    !tempRuleObj = !!ruleStore.element.getRule(!tempRule.rule)
    handle any
      -- rule not found
      !dText.append('Type:		RULE NOT FOUND')
      !dText.append('Rule:		RULE NOT FOUND')
    elsehandle none
      !dText.append('Type:		' + !tempRuleObj.types)
      !dText.append('Rule:		' + !tempRuleObj.rule)
    endhandle

    !dText.append('Scan:		' + !tempRule.scan)
    !dText.append('Format:		' + !tempRule.format)
    !dText.append('Indices:		' + !tempRule.indices)

    !this.subDisplay.val = !dText

  endif

endmethod
-- End of method definition for .ruleDisplay()

------------------------------------------------------------------------
--
-- Method:      !cut()
--
-- Description: cut action
--
-- Method Type: Procedure

--
------------------------------------------------------------------------
define method .cut()

	if (!this.data.rules.size() gt 0) then
	  -- copy the data
	  !this.copy()
	
	  -- remove the current entry
	  !this.data.rules.remove(!this.ruleDisplay.val)
	
	  -- re-display the rule list
	  !this.listRules(!this.ruleDisplay.val)
	endif

endmethod
-- End of method definition for .cut()

------------------------------------------------------------------------
--
-- Method:      !copy()
--
-- Description: copy action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .copy()

	if (!this.data.rules.size() gt 0) then
	  !this.key.val = !this.data.rules[!this.ruleDisplay.val].key
	  !this.scan.val = !this.data.rules[!this.ruleDisplay.val].scan
	  !this.rule.val = !this.data.rules[!this.ruleDisplay.val].rule
	  !this.description.val = !this.data.rules[!this.ruleDisplay.val].description
	  !this.format.val = !this.data.rules[!this.ruleDisplay.val].format
	  !this.indices.val = !this.data.rules[!this.ruleDisplay.val].indices
	endif

endmethod
-- End of method definition for .copy()

------------------------------------------------------------------------
--
-- Method:      !replace()
--
-- Description: replace action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .replace()

  -- check for an empty key
  if (!this.key.val.trim() eq '') then
  	!!alert.error('The Naming Rule key is undefined.')
  	return
  endif

  if (!this.rule.val.unset()) then
    !!alert.error('No rule name input')
    return
  endif

  if (!this.key.val.trim() ne !this.ruleDisplay.selection()) then
    -- check for duplicate key
    !this.validKey()
  endif

  -- get a rule object from the input gadgets and overwrite the current rule
  !this.data.rules[!this.ruleDisplay.val] = !this.inputData()

  -- re-display the rule list
  !this.listRules(!this.ruleDisplay.val)

endmethod
-- End of method definition for .replace()

------------------------------------------------------------------------
--
-- Method:      !insert()
--
-- Description: insert action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .insert()

  -- check for an empty key
  if (!this.key.val.trim() eq '') then
    !!alert.error('No key input')
    return
  endif

  if (!this.rule.val.unset()) then
    !!alert.error('No rule name input')
    return
  endif
  -- check for duplicate key
  !this.validKey()

  -- set the insert index
  if (!this.insertOpt.selection() eq 'AFTER') then
    if (!this.data.rules.empty()) then
      !index = 1
    else
      !index = !this.ruleDisplay.val + 1
    endif
  else
    !index = !this.ruleDisplay.val
  endif

  -- get a rule object from the input gadgets and insert
  !this.data.rules.insert(!index, !this.inputData())

  -- re-display the rule list
  !this.listRules(!index)

endmethod
-- End of method definition for .insert()

------------------------------------------------------------------------
--
-- Method:      !inputData()
--
-- Description: method to return input data as NAMOPTRULE object
--
-- Method Type: Function
-- Return:
--   [NAMOPTRULE] [object containing input data]
--
------------------------------------------------------------------------
define method .inputData() is NAMOPTRULE

  !tempObject = object NAMOPTRULE()

  !tempKey = !this.key.val
  !tempDesc = !this.description.val
  !tempRule = !this.rule.val
  !tempScan = !this.scan.val
  !tempFormat = !this.format.val
  !tempIndices = !this.indices.val

  !tempObject.namOptRule(!tempKey, !tempDesc, !tempRule, !tempScan, !tempFormat, !tempIndices)

  return !tempObject

endmethod
-- End of method definition for .inputData() NAMOPTRULE

------------------------------------------------------------------------
--
-- Method:      !ruleSelect()
--
-- Description: show a combo box selection form with rules
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ruleSelect()

  -- get the currently defined element rules
  !rules = !!ruleStore.element.getRules()

  -- store the combo box selection form title
  !title = 'Select a Naming Rule'

  -- show the combo box selection form
  !!comboBox(!this.rule, !title, !rules)

endmethod
-- End of method definition for .ruleSelect()

------------------------------------------------------------------------
--
-- Method:      !clearInput()
--
-- Description: reset the input gadgets
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .clearInput()

  !this.key.val = ''
  !this.description.val = ''
  !this.rule.val = ''
  !this.scan.val = ''
  !this.format.val = ''
  !this.indices.val = ''

endmethod
-- End of method definition for .clearInput()

------------------------------------------------------------------------
--
-- Method:      !rule()
--
-- Description: check the rule name input
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .rule()

  -- check if the defined rule name is valid
  if (!this.rule.val.set()) then
    if (!this.rule.val.trim() eq '') then
      !this.rule.val = STRING()

    elseif (!!ruleStore.element.badName(!this.rule.val).not()) then
      -- bad rule name warn the user
      !!messageFile.warning(152, 007,  !this.rule.val)
    endif
  else
    !!alert.error('The rule name must be set to a valid value')
  endif

endmethod
-- End of method definition for .rule()

------------------------------------------------------------------------
--
-- Method:      !validKey()
--
-- Description: check the key is valid
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .validKey()

  -- loop through the defined naming rules and search for a duplicate key
  do !nameRule values !this.data.rules
    if (!nameRule.key.upcase().trim() eq !this.key.val.upcase().trim()) then
      -- key has already been used
      !!messageFile.error(146, 35)
      break
    endif
  enddo


endmethod
-- End of method definition for .validKey()

------------------------------------------------------------------------
--
-- Method:      !test()
--
-- Description: action for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .test()

  !nameString = !this.data.nameString(!!ce, !this.ruleDisplay.selection(), !this.testRule.val, false)
  handle any
    !!alert.error(!!error.text)
    !this.testReturn.val = ''
    return
  --elsehandle none
  --  !this.testReturn.val = !nameString
  endhandle

  if(!nameString.unset() or !nameString.trim() eq '') then
     !this.testReturn.val = ''
  elseif(!nameString.occurs(' ').gt(0))then
     !!alert.warning('Name should not contain spaces.')
     !this.testReturn.val = ''
  else
    !this.testReturn.val = !nameString
  endif

endmethod
-- End of method definition for .test()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: action for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- set the rules on the owning form
  !this.main.data.rules = !this.data.rules

endmethod
-- End of method definition for .ok()
