-- File:            orielement.pmlfrm
--   Type:          Form Definition
--   Group:         Orientation

--     Keyword:     ORI
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Apr 8 11:20:01 BST 1999
--
--
-- Description:
-- Orientate elements X and Y axes.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  axes(STRING)                     -                   Setup axes
--  close()                          -                   Close form and tidy
--  direction(STRING,DIRECTION)      -                   Setup direction
--  direction(STRING,POSITION)       -                   Set direction of gadget to a direction from the origin towards the passed position
--  direction(STRING,STRING)         -                   Setup direction
--  lock(STRING,BOOLEAN)             -                   Setup lock
--  oriElement()                     -                   Constructor
--  orientation(DBREF)               -                   Set orientation from passed element
--  orientation(ORIENTATION)         -                   Set orientation to passed data
--  pick(STRING)                     -                   Pick element to update
--  pickOrientation(REAL)            -                   Pick axes of item
--  preview()                        -                   Preview axes
--  setDirection(STRING,STRING)      -                   Setup to direction of offset
--  setWrt()                         -                   Set up with new wrt item
--  setup(DBREF)                     -                   Setup form for passed element
--  setupDirections()                -                   Setup direction
--  setupDirections(STRING,STRING)   -                   Setup direction
--  setupOwner(DBREF)                -                   Setup form for owner of passed element
--  tidy()                           -                   Tidy form data
--
------------------------------------------------------------------------

setup form !!oriElement

  !this.formTitle     = 'Orientate'
  !this.iconTitle     = ''
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition
  -- Bar
  bar
  exit

  -- Current element
  text .ceName   ' '  at xmin ymax tooltip 'Element being modified' width 34 is STRING
  path down
  halign right
  vdist 0.1

  -- Orientation
  text      .aDirection 'is'                          callback '!this.direction(|a|, !this.aDirection.val)' tooltip 'Direction >' width 24 is STRING
  vdist 0
  text      .bDirection 'is'                          callback '!this.direction(|b|, !this.bDirection.val)' tooltip 'Direction >' width 24 is STRING
  paragraph .cDirection                                                                                     width 34 lines 1
  text      .wrtText 'wrt'                            callback '!this.setWrt()'                             tooltip 'Change with respect to' width 26 string
  option    .aAxes at xmin.ceName+2   ymin.aDirection callback '!this.axes(|a|)'                            width 2
  option    .bAxes at xmin.ceName+2   ymin.bDirection callback '!this.axes(|b|)'                            width 2

  -- Locks
  toggle .aLock    at xmax.aDirection ymin.aDirection callback '!this.lock(|a|, !this.aLock.val)' tooltip 'Lock' states 'false' 'true'
  toggle .bLock    at xmax.bDirection ymin.bDirection callback '!this.lock(|b|, !this.bLock.val)' tooltip 'Lock' states 'false' 'true'

  -- Apply/Dismiss
  button .apply   'Apply'   at xmin form-0    ymax form+0.25 callback '!this.apply()'
  button .dismiss 'Dismiss' at xmax form-size ymin           callback '!this.close()'

  -- Form Members

  -- Element
  member .element         is DBREF

  -- Frame of reference
  member .wrt             is DBREF

  -- Position of item
  member .position        is POSITION

  -- Relative offset from of box wrt to original plane
  member .xyOffset        is XYPOSITION
  member .zOffset         is REAL

  -- Local volume of item
  member .box             is GPHBOX

  -- Aid numbers for position & axes
  member .aidNumber       is REAL
  member .aidAxes         is REAL

  -- Orientation
  member .orientation     is ORIENTATION

  -- Edg Description
  member .edgDescription  is STRING

exit
-- End of form definition for !!oriElement

------------------------------------------------------------------------
--
-- Method:      oriElement
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .oriElement()

  -- Initialise Variables
  -- Aid Number
  !this.aidNumber      = !!aidNumbers.add('Orientation')
  !this.aidAxes        = !!aidNumbers.add('Orientation')

  -- Edg Description
  !this.edgDescription = 'Orientate Element'

  -- Bar
  !bar = !this.bar
  !bar.add('Select',   'menuSelect')
  !bar.add('Derive',   'menuDerive')

  -- Select Menu
  !menu = !this.newMenu('menuSelect')
    !menu.add('callback', 'CE',               '!this.setup(!!ce)')
    !menu.add('callback', 'Owner',            '!this.setupOwner(!!ce)')
    !menu.add('separator')
    !menu.add('callback', 'Pick',             '!this.pick(''PICK'')')
    !menu.add('callback', 'Pick Owner',       '!this.pick(''OWNER'')')

  -- Pick Menu
  !menu = !this.newMenu('menuDerive')
    !menu.add('callback', 'from CE',          '!this.orientation(!!ce)')
    !menu.add('callback', 'from Owner',       '!this.orientation(!!ce.owner)')
    !menu.add('separator')
    !menu.add('callback', 'Through 3 points', '!this.pickOrientation(3)')
    !menu.add('callback', 'Through 2 points', '!this.pickOrientation(2)')
    !menu.add('callback', 'from Picked',      '!this.pickOrientation(1)')

  -- Define right-mouse buttons
  -- Direction
  !menu = !this.newMenu('directionAMenu')
    !menu.add('CALLBACK', 'Toward',           '!this.setDirection(|a|, ''TOWARDS'')')
    !menu.add('CALLBACK', 'Pick',             '!this.setDirection(|a|, ''PICK'')')
    !menu.add('CALLBACK', 'X Direction',      '!this.setDirection(|a|, ''X'')')
    !menu.add('CALLBACK', 'Y Direction',      '!this.setDirection(|a|, ''Y'')')
    !menu.add('CALLBACK', 'Z Direction',      '!this.setDirection(|a|, ''Z'')')
    !menu.add('CALLBACK', 'Opposite',         '!this.setDirection(|a|, ''OPPOSITE'')')
  !this.aDirection.setPopup(!this.directionAMenu)

  -- Direction
  !menu = !this.newMenu('directionBMenu')
    !menu.add('CALLBACK', 'Toward',           '!this.setDirection(|b|, ''TOWARDS'')')
    !menu.add('CALLBACK', 'Pick',             '!this.setDirection(|b|, ''PICK'')')
    !menu.add('CALLBACK', 'X Direction',      '!this.setDirection(|b|, ''X'')')
    !menu.add('CALLBACK', 'Y Direction',      '!this.setDirection(|b|, ''Y'')')
    !menu.add('CALLBACK', 'Z Direction',      '!this.setDirection(|b|, ''Z'')')
    !menu.add('CALLBACK', 'Opposite',         '!this.setDirection(|b|, ''OPPOSITE'')')
  !this.bDirection.setPopup(!this.directionBMenu)

  -- Stop ceName being typed in
  !this.ceName.setEditable(false)

  -- Cancel callback
  !this.cancelCall  = '!this.tidy()'

  -- Set Options
  !dtext[1]         = ' X'
  !dtext[2]         = ' Y'
  !rtext[1]         = '1'
  !rtext[2]         = '2'
  !this.aAxes.dtext = !dtext
  !this.aAxes.rtext = !rtext
  !dtext[1]         = ' Y'
  !dtext[2]         = ' Z'
  !rtext[1]         = '2'
  !rtext[2]         = '3'
  !this.bAxes.dtext = !dtext
  !this.bAxes.rtext = !rtext

  !this.wrtText.val = 'World'
  !this.orientation = Y is N
  !this.setWrt()

endmethod
-- End of method definition for .oriElement()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Tidy form data
  !this.tidy()

  -- Revert the edg graphics back
  !!edgCntrl.remove(!this.edgDescription)

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide Modification Grid
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidAxes)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Check the WRT exists
  if(!this.element.badref() or !this.element eq nulref) then
    !!alert.warning('The element has been deleted! Aborting the orientation form.')
    !this.close()
    return
  endif

  -- Initialise Variables
  !!ce         = !this.element
  !orientation = !this.orientation
  ORIENTATION $!<orientation>
  handle any
    !!alert.warning(!!error.text)
  endhandle

  !this.setup(!this.element)

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Initialise Variables

  -- New reference plane
  !plane       = object PLANE(!this.position, !this.orientation)

  -- Get new position of box
  !position    = !plane.threeDPosition(!this.xyOffset)
  !position    = !position.offset(!plane.direction(), !this.zOffset)

  -- Redefine local volume
  !this.box.position(!position)
  !this.box.orientation(!this.orientation)

  -- Draw the local volume
  !this.box.draw(!this.aidNumber)

  -- Draw axes at the orientation
  !gAxes = object GPHAXES(!this.position, !this.box.orientation())
  !gAxes.draw(!this.aidAxes)

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      setupOwner
--
-- Description: Setup form for owner of passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to setup form with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupOwner(!element is DBREF)

  -- Initialise Variables

  -- Handle World
  if(!element.type eq 'WORL') then
    !!alert.warning('The world does not have an owner.')
    return
  endif

  -- Get owner
  !owner = !element.owner
  handle any
    !!alert.warning('The owner of ' & !element.flnn & ' does not have an owner.')
    return
  endhandle

  -- Setup form
  !this.setup(!owner)

endmethod
-- End of method definition for .setupOwner(DBREF)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form for passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to setup form with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!element is DBREF)

  -- Initialise Variables

  -- Check that element has an orientation
  !attribs         = !element.attributes()
  !evalBlock       = object BLOCK('!attribs[!evalIndex].upcase()')
  !attributes      = !attribs.evaluate(!evalBlock)

  if(!attributes.findFirst('ORIENTATION').unset()) then
    !!messageFile.warning(151, 2, !element.flnn)
    return
  endif

  -- Check we have access to modify element
  if(!!dbRefUpdatable(!element).not()) then
    !!alert.warning(!!error.text)
    return
  endif

  -- Check the WRT exists
  if(!this.wrt.badref() or !this.wrt eq nulref) then
    !this.wrtText.val = 'World'
    !this.orientation = Y is N
    !this.setWrt()
  endif

  -- Initialise Form data
  !this.element    = !element
  !this.ceName.val = !this.element.flnn
  !this.ceName.setTooltip(!this.element.flnn)
  !this.position   = !this.element.position

  -- Get local volume of item
  !localVolume     = object LOCALVOLUME(!element, !element)

  -- Define Box of the local volume
  !box             = !localVolume.box()
  !this.box.gphBox(!box)

  -- Reference plane
  !plane           = object PLANE(!this.element.position, !this.element.orientation)
  !offset          = !plane.near(!box.position)
  !this.xyOffset   = !plane.xyOffset(!box.position)
  !this.zOffset    = !offset.distance(!box.position)

  -- Derive the sign of offset, if distance > zero
  if(!this.zOffset ne 0) then

    -- Get the sign of the Z offset
    if(!offset.direction(!box.position) ne !plane.direction()) then
      !this.zOffset  = !this.zOffset * -1
    endif

  endif

  -- Update orientation
  !this.orientation  = !this.element.orientation.wrt(!this.wrt)

  -- Setup direction
  !this.setupDirections()

  -- Draw
  !this.preview()

  -- Show form
  !this.show()

endmethod
-- End of method definition for .setup(DBREF)

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description: Pick element to update
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option : PICK or OWNER
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick(!option is STRING)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  if(!option.upcase() eq 'OWNER') then
    !packet.elementPick('Pick item, which owner is to be orientated')
    !packet.action       = '!!oriElement.setup(!this.return[1].item.owner)'
  else
    !packet.elementPick('Pick item to be orientated')
    !packet.action       = '!!oriElement.setup(!this.return[1].item)'
  endif

  !packet.key            = 'orientationElement'
  !packet.description    = !this.edgDescription
  !packet.priority       = 3
  !packet.remove         = true
  !packet.type           = 'dbModify'

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pick(STRING)

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- Initialise Variables

  -- Get dbref of passed item
  !element = !this.wrtText.val.dbref()
  handle any
    !!alert.warning('Invalid element (' & !this.wrtText.val & ').')
    !this.wrtText.val = !this.wrt.flnm
    return
  endhandle

  -- Set new wrt
  !this.wrt           = !element

  -- Recalculate the orientation with the WRT
  !this.orientation   = !this.orientation.wrt(!this.wrt)

  -- Set gadget with name of item
  !this.wrtText.val   = !this.wrt.flnm

  -- Update the directions
  !this.setupDirections()

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      pickOrientation
--
-- Description: Pick axes of item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Number of picks
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pickOrientation(!number is REAL)

  -- Initialise Variables

  -- Define a pick packet
  !packet          = object EDGPACKET()

  -- Three picks
  if(!number eq 3) then
    !packet.pickPacket.plane3pnts()
    !packet.pickPacket.prompt = 'Orientate -'
    !packet.pickPacket.picks[1].prompt = 'base point'
    !packet.pickPacket.picks[2].prompt = 'X through point from base point'
    !packet.pickPacket.picks[3].prompt = 'Y towards point'
    !packet.action            = '!!oriElement.orientation(!this.return[1].orientation)'

  -- Define specific for "definePlane" orientation
  elseif (!number eq 2) then

    !packet.pickPacket.plane2pnts(!this.position)
    !packet.pickPacket.prompt = 'Orientate -'
    !packet.pickPacket.picks[1].prompt = 'X through point from origin'
    !packet.pickPacket.picks[2].prompt = 'Y towards point'
    !packet.action            = '!!oriElement.orientation(!this.return[1].orientation)'

  -- Pick element
  elseif (!number eq 1) then
    !packet.elementPick('Pick element to copy orientation from')
    !packet.action    = '!!oriElement.orientation(!this.return[1].item)'

  else
    return
  endif

  !packet.description = !this.edgDescription
  !packet.remove      = true
  !packet.priority    = 1
  !!packet   = !packet

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickOrientation(REAL)

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Set orientation from passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to get orientation from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .orientation(!element is DBREF)

  -- Initialise Variables
  !this.orientation(!element.orientation)
  handle any
    !!alert.warning('Unable to derive orientation.')
  endhandle

endmethod
-- End of method definition for .orientation(DBREF)

------------------------------------------------------------------------
--
-- Method:      orientation
--
-- Description: Set orientation to passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to get orientation from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .orientation(!orientation is ORIENTATION)

  -- Initialise Variables
  !this.orientation = !orientation.wrt(!this.wrt)

  -- Setup direction
  !this.setupDirections()

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .orientation(ORIENTATION)

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description: Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gadget
--    2   R      STRING      Option
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection(!identifier is STRING, !option is STRING)

  -- Initialise Variables

  -- Measure
  if(!option eq 'PICK') then
    -- Define the measure packet
    !packet             = object EDGPACKET()
    !packet.defineDirection('')
    !packet.description = !this.edgDescription
    !packet.action      = '!!oriElement.direction(|' & !identifier & '|, !this.return[1])'
    !!edgCntrl.add(!packet)

  -- Direction
  elseif (!option eq 'TOWARDS') then

    -- Define the measure packet
    !packet             = object EDGPACKET()
    !packet.definePosition('Point to which direction if to point')
    !packet.description = !this.edgDescription
    !packet.remove      = true
    !packet.action      = '!!oriElement.direction(|' & !identifier & '|, !this.return[1].position)'
    !!edgCntrl.add(!packet)

  -- Direction
  elseif (!option eq 'OPPOSITE') then
    if(!identifier eq 'a') then
      !direction      = object DIRECTION(!this.aDirection.val)
    else
      !direction      = object DIRECTION(!this.bDirection.val)
    endif
    !direction.origin = !this.wrt
    !this.direction(!identifier, !direction.opposite())

  -- Get elements XYZ direction
  else

    -- Check we have an orientation
    !orientation = !!ce.orientation

    if(!orientation.alpha.unset()) then
      !!messageFile.warning(151,2, !!ce.flnn)
      return
    endif

    -- Extract the direction
    if(!option.match('X').boolean()) then
      !direction = !orientation.xDir()
    elseif (!option.match('Y').boolean()) then
      !direction = !orientation.yDir()
    else
      !direction = !orientation.zDir()
    endif
    !this.direction(!identifier, !direction)

  endif

endmethod
-- End of method definition for .setDirection(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      axes
--
-- Description: Setup axes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gadget to selected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .axes(!identifier is STRING)

  -- Initialise Variables

  -- A axes
  if(!identifier eq 'a') then
    !gadget      = !this.aAxes
    !otherGadget = !this.bAxes
  -- B axes
  else
    !gadget      = !this.bAxes
    !otherGadget = !this.aAxes
  endif

  !value         = !gadget.selection()
  !otherValue    = !otherGadget.selection()

  -- Don't allow the gadgets to be the same
  if(!value eq !otherValue) then

    -- Check if other is locked
    if(!otherGadget.active.not()) then
      !!alert.warning(!gadget.selection('DTEXT').trim() & ' is locked, unable to change axes.')
      if(!gadget.val eq 1) then
        !gadget.val    = 2
      else
        !gadget.val    = 1
      endif
      return
    endif

    if(!otherGadget.val eq 1) then
      !otherGadget.val = 2
    else
      !otherGadget.val = 1
    endif
  endif

  -- Setup gadgets
  !this.setupDirections()

endmethod
-- End of method definition for .axes(STRING)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Setup direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gadget to selected
--    2   R      DIRECTION   Direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction(!identifier is STRING, !direction is DIRECTION)

  -- Initialise Variables
  !newDirection = !direction.wrt(!this.wrt)

  -- Update orientation object
  !this.direction(!identifier, !newDirection.string().before('WRT'))

endmethod
-- End of method definition for .direction(STRING, DIRECTION)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Set direction of gadget to a direction from the origin towards the passed position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gadget to update
--    2   R      POSITION    Position direction is to be derived from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction(!identifier is STRING, !position is POSITION)

  -- Initialise Variables
  !direction = !this.position.direction(!position).wrt(!this.wrt)

  -- Update orientation object
  !this.direction(!identifier, !direction.string().before('WRT'))

endmethod
-- End of method definition for .direction(STRING, POSITION)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Setup direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gadget to selected
--    2   R      STRING      Direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction(!identifier is STRING, !direction is STRING)

  -- Initialise Variables

  -- If both axes are lock, don't allow any changes
  if(!this.aAxes.active.not() and !this.bAxes.active.not()) then
    !!alert.warning('Unable to change orientation, as both axes are lock.')
    return
  endif

  -- A axes
  if(!identifier eq 'a') then
    !primaryGadget    = !this.aAxes
    !secondaryGadget  = !this.bAxes
    !primaryString    = !direction.trim().upcase()
    !secondaryString  = !this.bDirection.val.trim().upcase()

  -- B axes
  else
    !primaryGadget    = !this.bAxes
    !secondaryGadget  = !this.aAxes
    !primaryString    = !direction.trim().upcase()
    !secondaryString  = !this.aDirection.val.trim().upcase()
  endif

  -- Do we need to switch the order of the gadgets
  if(!secondaryGadget.active.not()) then
    !aGadget          = !primaryGadget
    !aString          = !primaryString
    !primaryGadget    = !secondaryGadget
    !primaryString    = !secondaryString
    !secondaryGadget  = !aGadget
    !secondaryString  = !aString
  endif

  !primaryDirection   = !primaryString.direction()
  handle any
    !!alert.warning(!!error.text.after(')').trim())
    return
  endhandle
  !secondaryDirection = !secondaryString.direction()
  handle any
    !!alert.warning(!!error.text.after(')').trim())
    return
  endhandle

  -- Check we have valid
  if(!primaryDirection.unset() or !secondaryDirection.unset()) then
    !!alert.warning('Unable to handle unset directions.')
    return
  endif

  -- Check for equal/parallel directions of the primary and secondary
  -- if equal, then use the third component
  !primaryAxes        = !primaryGadget.selection('DTEXT').trim()
  !secondaryAxes      = !secondaryGadget.selection('DTEXT').trim()

  if(!primaryDirection.isParallel(!secondaryDirection)) then
    !secondaryAxes    = !this.cDirection.val.before('is').trim().upcase()

    -- This is done this way, just in case the direction is to big to fit in the paragraph
    !list[1]          = 'X'
    !list[2]          = 'Y'
    !list[3]          = 'Z'
    !directions[1]    = !this.orientation.xDir().string().before(' WRT')
    !directions[2]    = !this.orientation.yDir().string().before(' WRT')
    !directions[3]    = !this.orientation.zDir().string().before(' WRT')
    !secondaryString  = !directions[!list.findFirst(!secondaryAxes)]
  endif

  -- Derive the orientation
  !primary            = !primaryString & ' wrt ' & !this.wrt
  !secondary          = !secondaryString & ' wrt ' & !this.wrt

  -- Define orientation
  !orientation        = object ORIENTATION(!primaryAxes & ' is ' & !primary & ' and ' & !secondaryAxes & ' is ' & !secondary)

  -- Setup orientation
  !this.orientation   = !orientation.wrt(!this.wrt)

  -- Setup gadget
  !this.setupDirections()

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .direction(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      lock
--
-- Description: Setup lock
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Gadget to selected
--    2   R      BOOLEAN     Lock
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .lock(!identifier is STRING, !lock is BOOLEAN)

  -- A axes
  if(!identifier eq 'a') then
    !this.aAxes.active      = !lock.not()
    !this.aDirection.active = !lock.not()

  -- B axes
  else
    !this.bAxes.active      = !lock.not()
    !this.bDirection.active = !lock.not()
  endif

  -- Grey out derive gadgets if both are locked
  !this.bar.setActive('Derive', !this.aDirection.active.and(!this.bDirection.active))

endmethod
-- End of method definition for .lock(STRING, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      setupDirection
--
-- Description: Setup direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupDirections()

  -- Initialise Variables
  !a = !this.aAxes.selection('DTEXT').trim()
  !b = !this.bAxes.selection('DTEXT').trim()

  -- Set tool tips
  !this.aDirection.setTooltip('Direction of ' & !a & ' >')
  !this.bDirection.setTooltip('Direction of ' & !b & ' >')

  -- Setup gadgets
  !this.setupDirections(!a, !b)

endmethod
-- End of method definition for .setupDirections()


------------------------------------------------------------------------
--
-- Method:      setupDirection
--
-- Description: Setup direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      A axes
--    2   R      STRING      B axes
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupDirections(!a is STRING, !b is STRING)

  -- Initialise Variables
  !list[1]      = 'X'
  !list[2]      = 'Y'
  !list[3]      = 'Z'
  !direction[1] = !this.orientation.xDir().string().before(' WRT')
  !direction[2] = !this.orientation.yDir().string().before(' WRT')
  !direction[3] = !this.orientation.zDir().string().before(' WRT')

  !axes         = !list
  !aIndex       = !axes.findFirst(!a)
  !bIndex       = !axes.findFirst(!b)

  -- Get third direction
  !list[!list.findFirst(!a)].delete()
  !list[!list.findFirst(!b)].delete()
  !cIndex       = !axes.findFirst(!list.first())
  !c            = !axes[!cIndex]

  -- Get the Relevant components
  !this.aDirection.val = !direction[!aIndex]
  !this.bDirection.val = !direction[!bIndex]
  !this.cDirection.val = !c & ' is ' & !direction[!cIndex]

endmethod
-- End of method definition for .setupDirections(STRING, STRING)
