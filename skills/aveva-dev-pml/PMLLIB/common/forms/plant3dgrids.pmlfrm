-- Created:         Mon Jan 12 10:44:49 WAT 1998
--
--
-- Description:
-- plant Grid Definition.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  close()                          -                   Close form and tidy
--  convertToReal(ARRAY)             ARRAY               Converts passed array element into array of real, any element that can not be converted will be ignored
--  convertToString(ARRAY)           ARRAY               Converts passed array element into array of string, any element that can not be converted will be ignored
--  derive(STRING)                   -                   Derive grid
--  initialise()                     -                   Initialisation of form
--  labelType()                      -                   Change label type
--  pickOrientation(STRING)          -                   Setup to define orientation using edg
--  plant3dGrids()                   -                   Constructor
--  posPick(GADGET,STRING)           -
--  preview(BOOLEAN)                 -                   Preview the plane
--  setLimits()                      -                   Set view limits to grid
--  setWrt()                         -                   Set up with new wrt item
--  setup(DBREF)                     -                   Show the form and set up with passed data
--  setup(REAL)                      -                   Setup data for form to be shown
--  setup(STRING,STRING,GPHTHREEDPLANTGRID) -                   Show the form and set up with passed data
--  setupForm()                      -                   Setup form to current grid definition
--  tidy()                           -                   Tidy form data
--  updateAid(REAL)                  -                   Update/create passed aid number with grid definition
--  validate()                       -                   Validate data
--  writeObject(BOOLEAN)             -                   Write data to grid member
--
------------------------------------------------------------------------

-- Define form
setup form !!plant3dGrids resize

  !!plant3dGrids.formTitle     = 'Rectangular Grids'
  !!plant3dGrids.iconTitle     = 'LGrids'
  !!plant3dGrids.formRevision  = ' $Revision: 1.20 $ '

  -- Body of form definition

  frame .tabset TABSET 'tabset' anchor ALL

    -- Options
    frame .optionFrame 'Options' dock fill

      -- Options
      frame .labelType 'Display' at x3 ymax+0.2
        rtoggle .axes    ' Axes only'    at xmin+1 ymin+0.8 tagwidth 8 states || |AXES|
        rtoggle .id      ' Gridline IDs'                    tagwidth 8 states || |ID|
        rtoggle .offset  ' Spacings'                        tagwidth 8 states || |OFFSET|
        rtoggle .enu     ' Coordinates'                     tagwidth 8 states || |ENU|
      exit

      -- X axis label, IDs and offsets
      frame .xFrame 'X Axis' at x1 ymax+0.5 anchor top+bottom+left
        text .xAxisLabel 'Label' at xmin+0.5 ymin+0.8 tagwidth 5 width 6 is STRING
        textpane .xAxisIDs 'IDs' at xmin ymax+0.2 anchor top+bottom width 5 length 12
        textpane .xOffsets 'Offsets' at xmax+0.5 ymin anchor top+bottom width 10 length 12
      exit

      path right

      -- Y axis label, IDs and offsets
      frame .yFrame 'Y Axis' anchor top+bottom+left
        text .yAxisLabel 'Label' at xmin+0.5 ymin+0.8 tagwidth 5 width 6 is STRING
        textpane .yAxisIDs 'IDs' at xmin ymax+0.2 anchor top+bottom width 5 length 12
        textpane .yOffsets 'Offsets' at xmax+0.5 ymin anchor top+bottom width 10 length 12
      exit

      -- Z axis label, IDs and offsets
      frame .zFrame 'Z Axis' anchor top+bottom+left
        text .zAxisLabel 'Label' at xmin+0.5 ymin+0.8 tagwidth 5 width 6 is STRING
        textpane .zAxisIDs 'IDs' at xmin ymax+0.2 anchor top+bottom width 5 length 12
        textpane .zOffsets 'Offsets' at xmax+0.5 ymin anchor top+bottom width 10 length 12
      exit

      -- Autofill grid ids and offsets
      button .autoFill 'Autofill...' at xmin.xFrame ymax+0.2 anchor left+bottom width 8

      -- Set limits
      button .setLimits 'Set View Limits to Grid' at xmax.yFrame-size ymin anchor left+bottom width 16

      -- Preview Change
      button .preview 'Preview' at xmax.zFrame-size ymin anchor left+bottom width 8

    exit

    -- Positioning Gadgets
    frame .posOriFrame 'Position & Orientation' at 0 0 dock fill
      frame .positionFrame 'Position' at x1 ymax

        path down
        option .ew at x1 ymax width 5
        option .ns width 5
        option .ud width 5
        text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
        text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
        text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
        toggle .xFlag at xmax+1 ymin.ew
        toggle .yFlag at xmin   ymin.ns
        toggle .zFlag at xmin   ymin.ud

        para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'
      exit

      -- Orientation Gadgets and Setting
      frame .orientationFrame 'Orientation' at xmin ymax+0.2

        -- EDG Set orientation
        button .edgOri3 pixmap width 24 height 24 tooltip 'Through three points'
        path right
        button .edgOri2 pixmap width 24 height 24 tooltip 'Through origin and two points'

        text .yDir 'Y is ' at x1   ymax+0.25 width 24 is STRING
        text .zDir 'Z is ' at xmin ymax      width 24 is STRING
        halign right
        path down
        paragraph .xDir width 31 lines 1
        halign left
      exit

      --  Reference (wrt)
      halign right
      text .wrt 'wrt' width 26 string
    exit

  exit

  -- Grid system name
  text .gridSystemName |Name| at xmin form+10 ymax+0.2 anchor left+bottom tagwidth 5 width 30 is STRING

  -- Apply/Dismiss
  button .apply   'Save'  at xmin form ymax+0.2  anchor left+bottom  width 5
  button .dismiss 'Close' at xmax form-size ymin anchor right+bottom width 5 ok

  -- Form Members
  -- Plane definition
  member .grid         is GPHTHREEDPLANTGRID

  -- Aid number being modified
  member .aidGrid      is REAL

  -- Aid numbers for position & axes
  member .aidNumber    is REAL

  -- Form Control Members
  -- Position
  member .position     is POSITIONLINK
  -- Orientation
  member .orientation  is ORIENTATIONLINK

  -- Description
  member .description  is STRING

  -- Action on apply
  member .action       is STRING

exit
-- End of form definition for !!plant3dGrids

------------------------------------------------------------------------
--
-- Method:      plant3dGrids
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plant3dGrids()

  -- Set icons
  !this.edgOri3.addPixmap(!!pml.getPathName('ori3points24.png'))
  !this.edgOri2.addPixmap(!!pml.getPathName('ori2points24.png'))

  -- Callbacks
  !this.callback           = |!this.initialise()|
  !this.labelType.callback = |!this.labelType()|
  !this.autoFill.callback  = |show !!plantGridsAutofill|
  !this.preview.callback   = |!this.preview(FALSE)|
  !this.setLimits.callback = |!this.setLimits()|
  !this.dismiss.callback   = |!this.close()|
  !this.cancelcall         = |!this.close()|
  !this.apply.callback     = |!this.apply()|
  !this.edgOri3.callback   = |!this.pickOrientation('3picks')|
  !this.edgOri2.callback   = |!this.pickOrientation('2picks')|
  !this.wrt.callback       = |!this.setWrt()|
   !this.posOriFrame.callback = '!this.posPick('

   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!plant3dGrids.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!plant3dGrids.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!plant3dGrids.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Link Orientation Gadgets to Object
  !this.orientation.linkInput('!!plant3dGrids.orientation', 'Y', !this.yDir, 'Z', !this.zDir, 'X', !this.xDir)

  -- Set Orientation Action
  !this.orientation.setAction('!!plant3dGrids.preview(true)')

  -- Member data
  !this.description = 'Default plant Grid Definition'

  -- Aid Lines Number
  if(!this.aidNumber.unset()) then
    !this.aidNumber = !!aidNumbers.add(!this.grid)
  endif

endmethod
-- End of method definition for .plant3dGrids()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!plant3dGrids.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Actions to null so nothing happens
  !this.position.setAction('')

  -- Setup form
  !this.setupForm()

  -- Set Position Action
  !this.position.setAction('!!plant3dGrids.preview(true)')

  !this.optionFrame.visible = true

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)
  !this.orientation.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Tidy form data
  !this.tidy()

  -- Revert the edg graphics back
  !!edgCntrl.remove(!this.description)

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide Modification Grid
  !!aidNumbers.hide(!this.aidNumber)

--  !!edgCntrl.remove('Edit system Grid definition')
--  handle ANY
--  endhandle

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Validate data
  !this.validate()

  -- Write data to grid member
  !this.writeObject(FALSE)

  -- Save grid object to database
  !this.grid.saveAsGridSystem(!this.gridSystemName.val)

  -- Tidy up
  !this.close()

  -- Reinitialise display grids form if shown
  if (defined(!!displayGrids)) then
    if (!!displayGrids.shown()) then
      !!displayGrids.reinitialise(!this.grid.gridSystem)
    endif
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number being modified/created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Initialise form action
  !this.action            = STRING()

  -- Set form data
  !this.aidGrid           = !aidNumber
  !this.formTitle         = 'Modify grid [' & !aidNumber & ']'
  !this.grid              = !!aidNumbers.numbers[!aidNumber]
  !this.description       = 'Edit aid plant grid definition'

  -- If already shown, then re-initialise
  if(!this.shown()) then
    !this.setupForm()
  endif

endmethod
-- End of method definition for .setup(REAL)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Show the form and set up with passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Description
--    2   R      STRING      Action to be carried out on apply
--    3   R      GPHTHREEDPLANTGRID Reference plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!description is STRING, !actionCommand is STRING, !newGrid is GPHTHREEDPLANTGRID)

  -- Define Action on apply
  !this.action           = !actionCommand

  -- Set form data
  !this.aidGrid          = REAL()
  !this.grid             = !newGrid
  !this.formTitle        = !description
  !this.description      = !description

  -- If already shown, then re-initialise
  if(!this.shown()) then
    !this.setupForm()
  endif

endmethod
-- End of method definition for .setup(STRING, STRING, GPHTHREEDPLANTGRID)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Show the form and set up with passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       GRIDSY element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!systemGrid is DBREF)

  -- Initialise form action
  !this.action             = STRING()

  -- Set form data
  !this.aidGrid            = REAL()
  !this.formTitle          = 'Modify grid [' & !systemGrid.name & ']'
  !this.description        = 'Edit system grid definition'
  !this.grid               = object GPHTHREEDPLANTGRID(!systemGrid)
  !this.gridSystemName.val = !systemGrid.namn

  -- If already shown, then re-initialise
  if(!this.shown()) then
    !this.setupForm()
  endif

endmethod
-- End of method definition for .setup(DBREF)

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description: Setup form to current grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupForm()

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- If there is no defined grid, then use a default
  if(!this.grid.position.unset()) then
    !this.grid.position(object POSITION('E0 N0 U0'))
    !this.grid.orientation(object ORIENTATION('Y is N'))
  endif

  -- Get basic core object
  !plane = !this.grid.plane()

  -- Set display toggles
  if (!this.grid.detail) then
    if (!this.grid.labelType eq 'ID') then
      !this.id.val = TRUE
    elseif (!this.grid.labelType eq 'ENU') then
      !this.enu.val = TRUE
    elseif (!this.grid.labelType eq 'OFFSET') then
      !this.offset.val = TRUE
    endif
  else
    !this.axes.val = TRUE
  endif

  -- Set offsets and labels
  !this.xAxisLabel.val = !this.grid.xAxisLabel
  !this.yAxisLabel.val = !this.grid.yAxisLabel
  !this.zAxisLabel.val = !this.grid.zAxisLabel
  !this.xOffsets.val   = !this.convertToString(!this.grid.xOffsets)
  !this.yOffsets.val   = !this.convertToString(!this.grid.yOffsets)
  !this.zOffsets.val   = !this.convertToString(!this.grid.zOffsets)
  !this.xAxisIDs.val   = !this.grid.xAxisIDs
  !this.yAxisIDs.val   = !this.grid.yAxisIDs
  !this.zAxisIDs.val   = !this.grid.zAxisIDs

  -- Set with respect to
  !this.position.setWrt(!plane.position.origin)
  !this.orientation.setWrt(!plane.position.origin)

  -- Load form with plane definition
  !this.position.setPositionForce(!plane.position)
  !this.orientation.setOrientation(!plane.orientation)

  -- Set form wrt gadget
  !this.setWrt()

  -- Don't allow rename from this form for modification of system grid
  !this.gridSystemName.active = !this.grid.gridSystem.unset()

endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:      labelType
--
-- Description: Change label type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .labelType()

  -- Axes only means switch off grid detail flag
  !this.grid.detail = !this.axes.val.not()

  -- Grid label setting only used if grid detail flag is on (i.e. not axes only)
  if(!this.id.val) then
    !this.grid.labelId()
  elseif(!this.enu.val) then
    !this.grid.labelEnu()
  elseif(!this.offset.val) then
    !this.grid.labelOffset()
  endif

endmethod
-- End of method definition for .labelType()

------------------------------------------------------------------------
--
-- Method:      validate
--
-- Description: Validate data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .validate()

  -- Remove null or blank values from ends of id and offset lists
  !ids = !this.xAxisIDs.val
  do !i from !this.xAxisIDs.val.size() to 1 by -1
    break if (!ids[!i].trim() ne ||)
    !ids[!i].delete()
  enddo
  !this.xAxisIDs.val = !ids

  !ids = !this.yAxisIDs.val
  do !i from !this.yAxisIDs.val.size() to 1 by -1
    break if (!ids[!i].trim() ne ||)
    !ids[!i].delete()
  enddo
  !this.yAxisIDs.val = !ids

  !ids = !this.zAxisIDs.val
  do !i from !this.zAxisIDs.val.size() to 1 by -1
    break if (!ids[!i].trim() ne ||)
    !ids[!i].delete()
  enddo
  !this.zAxisIDs.val = !ids

  !offsets = !this.xOffsets.val
  do !i from !this.xOffsets.val.size() to 1 by -1
    break if (!offsets[!i].trim() ne ||)
    !offsets[!i].delete()
  enddo
  !this.xOffsets.val = !offsets

  !offsets = !this.yOffsets.val
  do !i from !this.yOffsets.val.size() to 1 by -1
    break if (!offsets[!i].trim() ne ||)
    !offsets[!i].delete()
  enddo
  !this.yOffsets.val = !offsets

  !offsets = !this.zOffsets.val
  do !i from !this.zOffsets.val.size() to 1 by -1
    break if (!offsets[!i].trim() ne ||)
    !offsets[!i].delete()
  enddo
  !this.zOffsets.val = !offsets

  -- Check for null or blank values in id lists
  do !id values !this.xAxisIDs.val
    if (!id.trim() eq ||) then
      return error 1 |X axis IDs must not be blank|
    endif
  enddo

  do !id values !this.yAxisIDs.val
    if (!id.trim() eq ||) then
      return error 1 |Y axis IDs must not be blank|
    endif
  enddo

  do !id values !this.zAxisIDs.val
    if (!id.trim() eq ||) then
      return error 1 |Z axis IDs must not be blank|
    endif
  enddo

  -- Check for null offset values
  do !x values !this.xOffsets.val
    if (!x.trim() eq ||) then
      return error 1 |X axis offset values must be numbers|
    endif
    !offset = !x.real(!!distanceFmt)
    handle (2,441) (2,813)
      -- Unable to convert string to number
      return error 1 |X axis offset values must be numbers|
    endhandle
  enddo

  do !x values !this.yOffsets.val
    if (!x.trim() eq ||) then
      return error 1 |Y axis offset values must be numbers|
    endif
    !offset = !x.real(!!distanceFmt)
    handle (2,441) (2,813)
      -- Unable to convert string to number
      return error 1 |Y axis offset values must be numbers|
    endhandle
  enddo

  do !x values !this.zOffsets.val
    if (!x.trim() eq ||) then
      return error 1 |Z axis offset values must be numbers|
    endif
    !offset = !x.real(!!distanceFmt)
    handle (2,441) (2,813)
      -- Unable to convert string to number
      return error 1 |Z axis offset values must be numbers|
    endhandle
  enddo

  -- Check for id/offset mismatch
  if (!this.xAxisIDs.val.size() ne !this.xOffsets.val.size()) then
    return error 1 |Number of X axis IDs does not match number of X axis offsets|
  endif

  if (!this.yAxisIDs.val.size() ne !this.yOffsets.val.size()) then
    return error 1 |Number of Y axis IDs does not match number of Y axis offsets|
  endif

  if (!this.zAxisIDs.val.size() ne !this.zOffsets.val.size()) then
    return error 1 |Number of Z axis IDs does not match number of Z axis offsets|
  endif

  -- Check for duplicate ids and offsets within a single axis
  !ids = !this.xAxisIDs.val
  !ids.unique()
  if (!ids.size() ne !this.xAxisIDs.val.size()) then
    return error 1 |X axis IDs must not contain duplicates|
  endif

  !ids = !this.yAxisIDs.val
  !ids.unique()
  if (!ids.size() ne !this.yAxisIDs.val.size()) then
    return error 1 |Y axis IDs must not contain duplicates|
  endif

  !ids = !this.zAxisIDs.val
  !ids.unique()
  if (!ids.size() ne !this.zAxisIDs.val.size()) then
    return error 1 |Z axis IDs must not contain duplicates|
  endif

  !offsets = !this.xOffsets.val
  !offsets.unique()
  if (!offsets.size() ne !this.xOffsets.val.size()) then
    return error 1 |X axis offsets must not contain duplicates|
  endif

  !offsets = !this.yOffsets.val
  !offsets.unique()
  if (!offsets.size() ne !this.yOffsets.val.size()) then
    return error 1 |Y axis offsets must not contain duplicates|
  endif

  !offsets = !this.zOffsets.val
  !offsets.unique()
  if (!offsets.size() ne !this.zOffsets.val.size()) then
    return error 1 |Z axis offsets must not contain duplicates|
  endif

  -- Sort offsets and apply sorted indices to ids
  !offsets           = !this.convertToReal(!this.xOffsets.val)
  !ids               = !this.xAxisIDs.val
  !sortedIndices     = !offsets.sortedIndices()
  !offsets.reindex(!sortedIndices)
  !ids.reindex(!sortedIndices)
  !this.xOffsets.val = !this.convertToString(!offsets)
  !this.xAxisIDs.val = !ids

  !offsets           = !this.convertToReal(!this.yOffsets.val)
  !ids               = !this.yAxisIDs.val
  !sortedIndices     = !offsets.sortedIndices()
  !offsets.reindex(!sortedIndices)
  !ids.reindex(!sortedIndices)
  !this.yOffsets.val = !this.convertToString(!offsets)
  !this.yAxisIDs.val = !ids

  !offsets           = !this.convertToReal(!this.zOffsets.val)
  !ids               = !this.zAxisIDs.val
  !sortedIndices     = !offsets.sortedIndices()
  !offsets.reindex(!sortedIndices)
  !ids.reindex(!sortedIndices)
  !this.zOffsets.val = !this.convertToString(!offsets)
  !this.zAxisIDs.val = !ids

endmethod
-- End of method definition for .validate()

------------------------------------------------------------------------
--
-- Method:      writeObject
--
-- Description: Write data to grid member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for Basic representation of grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .writeObject(!basic is BOOLEAN)

  -- Write data to grid member
  !this.grid.position(!this.position.get())
  !this.grid.orientation(!this.orientation.get())
  !this.grid.detail       = !this.axes.val.not()
  !this.grid.basic        = !basic
  !this.grid.xAxisLabel   = !this.xAxisLabel.val
  !this.grid.yAxisLabel   = !this.yAxisLabel.val
  !this.grid.zAxisLabel   = !this.zAxisLabel.val
  !this.grid.xOffsets     = !this.convertToReal(!this.xOffsets.val)
  !this.grid.yOffsets     = !this.convertToReal(!this.yOffsets.val)
  !this.grid.zOffsets     = !this.convertToReal(!this.zOffsets.val)
  !this.grid.xAxisIDs     = !this.xAxisIDs.val
  !this.grid.yAxisIDs     = !this.yAxisIDs.val
  !this.grid.zAxisIDs     = !this.zAxisIDs.val

endmethod
-- End of method definition for .writeObject(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for Basic representation of grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview(!basic is BOOLEAN)

  -- Validate data
  !this.validate()

  -- Write data to grid member
  !this.writeObject(!basic)

  -- Redraw grid graphics
  !!aidNumbers.replace(!this.aidNumber, !this.grid)

endmethod
-- End of method definition for .preview(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      setLimits
--
-- Description: Set view limits to grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setLimits()

  -- Set view limits so grid not clipped
  !this.preview(FALSE)
  !this.grid.setLimits()

endmethod
-- End of method definition for .setLimits()

------------------------------------------------------------------------
--
-- Method:      pickOrientation
--
-- Description: Setup to define orientation using edg
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Ori definition type  3picks
--                                                2picks
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pickOrientation(!type is STRING)

  -- Define a pickPacket
  !packet          = object EDGPACKET()
  !packet.orientationLink('!!plant3dGrids.orientation', 'Orientate Plane')

  -- Two pick plane
  if(!type.upcase() eq '2PICKS') then
    -- Define specific for "definePlane" orientation
    !packet.pickPacket.plane2Pnts(!this.position.get())
  endif

  !packet.remove   = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickOrientation(STRING)

------------------------------------------------------------------------
--
-- Method:      convertToReal
--
-- Description:  Converts passed array element into array of real, any element that can not be converted will be ignored
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array to be converted
-- Return:
--   [Data Type] [Description]
--    ARRAY       Converted array
--
------------------------------------------------------------------------

-- Define method
define method .convertToReal(!input is ARRAY) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()

  -- Loop through input array
  do !entry values !input
    !returnArray.append(!entry.real(!!distanceFmt))
    handle any
    endhandle
  enddo

  -- Return Data
  return !returnArray

endmethod
-- End of method definition for .convertToReal(ARRAY) ARRAY

------------------------------------------------------------------------
--
-- Method:      convertToString
--
-- Description:  Converts passed array element into array of string, any element that can not be converted will be ignored
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array to be converted
-- Return:
--   [Data Type] [Description]
--    ARRAY       Converted array
--
------------------------------------------------------------------------

-- Define method
define method .convertToString(!input is ARRAY) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()

  -- Loop through input array
  do !entry values !input
    !returnArray.append(!entry.string(!!distanceFmt))
    handle any
    endhandle
  enddo

  -- Return Data
  return !returnArray

endmethod
-- End of method definition for .convertToString(ARRAY) ARRAY

------------------------------------------------------------------------
--
-- Method:      updateAid
--
-- Description: Update/create passed aid number with grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateAid(!aidNumber is REAL)

  -- Update aid system
  !!aidNumbers.replace(!aidNumber, !this.grid)

endmethod
-- End of method definition for .updateAid(REAL)

------------------------------------------------------------------------
--
-- Method:      derive
--
-- Description: Derive grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of derive
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .derive(!passedType is STRING)

  -- Initialise Variables
  !type = !passedType.upcase()

  -- Derive from columns beneath current element
  if(!type eq 'COLUMNS') then

    -- Collect all columns (if length is distance between the Z positions, we'll
    -- assume them to be columns)
    var !collection COLLECT ALL SCTN WITH (abs(POSS[3] - POSE[3]) EQ DER LENGTH) FOR CE

    -- If there are no sections, then we can't derive the
    if(!collection.empty()) then
      !!alert.warning('No "columns" found beneath the current element.')
      return
    endif

    -- Convert all sections to lines
    do !i indices !collection
      !section   = !collection[!i].dbRef()
      !lines[!i] = object LINE(!section.posStart, !section.posEnd)
    enddo

    -- Derive a grid from the passed line
    !grid        = !this.grid.derive(!lines)

    -- Update list
    !this.xOffsets.val = !this.convertToString(!grid.xSpacings)
    !this.yOffsets.val = !this.convertToString(!grid.ySpacings)

    -- Update position
    !this.position.position(!grid.position.wrt(!this.wrt.val.dbRef()))

  endif

endmethod
-- End of method definition for .derive(STRING)
------------------------------------------------------------------------
--
-- Method:      posPick
--
-- Description: Derive grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of derive
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .posPick(!dummyFrame is GADGET , !action is STRING)

  if (!this.description.eq('Reference 3D Rectangular Grid')) then
  	return
  endif	

  if (!action.eq('SHOWN') ) then
  	
  -- Define Packet Data
   !packet                = object EDGPACKET()
   !packet.positionLink('!!plant3dGrids.position', 'Edit Rectangular Grid')
   !packet.key            = 'plantGridPacket'
   !packet.type           = 'Modify position'
   !packet.input[1]       = !this.grid
   !packet.description    = 'Edit system Grid definition'
   !packet.close          = '!!plant3dGrids.tidy()'

   !packet.priority       = 2
   !packet.remove         = false
   !packet.type           = 'aidNumbers'
   !!edgCntrl.add(!packet)

     -- Redraw grid graphics
   !this.description      = 'Edit system Grid definition'
   !this.grid.position(!this.position.get())
   !!aidNumbers.replace(!this.aidNumber, !this.grid)
 else
   !!edgCntrl.remove('Edit system Grid definition')
   handle ANY
   endhandle   	
 endif

endmethod
