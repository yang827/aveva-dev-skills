--
--
-- Description:
-- Select display planes for plant grid
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply display settings
--  initialise()                     -                   Initialisation of form
--  plantGridAxes()                  -                   Constructor
--
------------------------------------------------------------------------

-- Define form
setup form !!plantGridAxes

  !!plantGridAxes.formTitle     = 'Plant Grid Axes'
  !!plantGridAxes.iconTitle     = 'Gridsystem'
  !!plantGridAxes.formRevision  = ' $Revision: 1.0 $ '

  -- Axes selection
  frame .axes |Axes selection|
    path right
    toggle .xPlaneDraw                         at x0.5 y0.8               states |FALSE| |TRUE|
    option .xOffset    |Display plane through X axis offset at| tagwidth 24 width 8
    toggle .yPlaneDraw                         at xmin.xPlaneDraw ymax+0.2 states |FALSE| |TRUE|
    option .yOffset    |Display plane through Y axis offset at| tagwidth 24 width 8
    toggle .zPlaneDraw                         at xmin.xPlaneDraw ymax+0.2 states |FALSE| |TRUE|
    option .zOffset    |Display plane through Z axis offset at| tagwidth 24 width 8
  exit

  -- Apply/Dismiss
  button .ok     ' OK ' at xmin form ymax+0.2 ok
  button .cancel 'Cancel' at xmax form-size ymin cancel

  -- Member to retain some settings
  member .grid    is GPHTHREEDPLANTGRID

exit

-- End of form definition for !!plantGridAxes

------------------------------------------------------------------------
--
-- Method:      plantGridAxes
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plantGridAxes()

  -- Callbacks
  !this.callback      = |!this.initialise()|
  !this.ok.callback   = |!this.apply()|

  -- Set some initial values that can be overwritten on subsequent shows
  !this.xPlaneDraw.val = FALSE
  !this.yPlaneDraw.val = FALSE
  !this.zPlaneDraw.val = TRUE

endmethod
-- End of method definition for .plantGridAxes()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Populate axes offsets from parent form grid object
  !grid = !!displayGrids.plantGrid

  -- Save any previous settings
  !xSelect = !this.xOffset.selection()
  !ySelect = !this.yOffset.selection()
  !zSelect = !this.zOffset.selection()

  -- X axis
  !dTexts = ARRAY()
  !rTexts = ARRAY()
  !gridTexts = !grid.list(|X|)
  do !i indices !gridTexts
    !dTexts.append(!gridTexts[!i])
    !rTexts.append(!i.string())
  enddo
  !this.xOffset.dText = !dTexts
  !this.xOffset.rText = !rTexts

  -- Y axis
  !dTexts = ARRAY()
  !rTexts = ARRAY()
  !gridTexts = !grid.list(|Y|)
  do !i indices !gridTexts
    !dTexts.append(!gridTexts[!i])
    !rTexts.append(!i.string())
  enddo
  !this.yOffset.dText = !dTexts
  !this.yOffset.rText = !rTexts

  -- Z axis
  !dTexts = ARRAY()
  !rTexts = ARRAY()
  !gridTexts = !grid.list(|Z|)
  do !i indices !gridTexts
    !dTexts.append(!gridTexts[!i])
    !rTexts.append(!i.string())
  enddo
  !this.zOffset.dText = !dTexts
  !this.zOffset.rText = !rTexts

  -- Try to give same selections if already had settings for this grid
  if (!grid.gridSystem eq !this.grid.gridSystem) then
    !this.xOffset.select(|Rtext|, !xSelect)
    handle ANY
    endhandle
    !this.yOffset.select(|Rtext|, !ySelect)
    handle ANY
    endhandle
    !this.zOffset.select(|Rtext|, !zSelect)
    handle ANY
    endhandle
  endif

  -- Save new grid for next time
  !this.grid = !grid

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply display settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Set parent form axes selections
  !!displayGrids.xPlaneDraw  = !this.xPlaneDraw.val
  !!displayGrids.yPlaneDraw  = !this.yPlaneDraw.val
  !!displayGrids.zPlaneDraw  = !this.zPlaneDraw.val
  !!displayGrids.xOffsetThru = !this.xOffset.selection().real()
  !!displayGrids.yOffsetThru = !this.yOffset.selection().real()
  !!displayGrids.zOffsetThru = !this.zOffset.selection().real()

  -- Activate parent form apply button
  !!displayGrids.apply.active = TRUE

endmethod
-- End of method definition for .apply()
