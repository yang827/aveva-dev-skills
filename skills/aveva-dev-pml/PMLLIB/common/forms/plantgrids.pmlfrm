-- Created:         Mon Jan 12 10:44:49 WAT 1998
--
--
-- Description:
-- plant Grid Definition.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  close()                          -                   Close form and tidy
--  convertToReal(ARRAY)             ARRAY               Converts passed array element into array of reals, any element that can not be converted will be ignored
--  convertToString(ARRAY)           ARRAY               Converts passed array element into array of string, any element that can not be converted will be ignored
--  derive(STRING)                   -                   Derive grid
--  initialise()                     -                   Initialisation of form
--  labelType()                      -                   Change label type
--  pickOrientation(STRING)          -                   Setup to define orientation using edg
--  plantGrids()                     -                   Constructor
--  preview(BOOLEAN)                 -                   Preview the plane
--  setWrt()                         -                   Set up with new wrt item
--  setup(REAL)                      -                   Setup data for form to be shown
--  setup(STRING,STRING,GPHPLANTGRID) -                   Show the form and set up with passed data
--  setupForm()                      -                   Setup form to current grid definition
--  tidy()                           -                   Tidy form data
--  updateAid(REAL)                  -                   Update/create passed aid number with grid definition
--
------------------------------------------------------------------------

-- Define form
setup form !!plantGrids

  !!plantGrids.formTitle     = 'plant Grids'
  !!plantGrids.iconTitle     = 'LGrids'
  !!plantGrids.callback      = '!this.initialise()'
  !!plantGrids.formRevision  = ' $Revision: 1.20 $ '

  -- Body of form definition
  -- Options
  frame .optionFrame 'Options' at x0.2  ymax

    -- Tagging
    toggle .label     ' Label ' at x2   ymax states 'FALSE' 'TRUE'
    toggle .detail    ' Detail' at xmin ymax states 'FALSE' 'TRUE'

var !coordinate coordinate
if (!coordinate.eq('XYZ') ) then
    !enutag =  ' X/Y/Z'
else
   !enutag = ' East/North/Up'
endif

    -- Labelling
    rgroup .labelType 'Detail'   at xmax.label+1 ymin.label callback '!this.labelType()' frame vertical
      add tag ' Spacing'           select 'OFFSET'
      add tag  ' $!enutag'    select 'ENU'
    exit

    -- Spacing
    frame .spacingFrame 'Spacing' at x1 ymax
      textpane .xSpacings 'X Spacing' width 11 length 5
      path right
      textpane .ySpacings 'Y Spacing' width 11 length 5

    exit

    -- Preview Change
    button .previewSpacing 'Preview' at xmax-size ymax+0.2 callback '!this.preview(false)'

  exit

  -- Positioning Gadgets
  frame .posOriFrame 'Position & Orientation' at xmin ymax+0.2
    frame .positionFrame 'Position' at x1 ymax
      path down
      option .ew at x1 y1.5 width 5
      option .ns width 5
      option .ud width 5
      text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
      text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
      text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
      toggle .xFlag at xmax+1 ymin.ew
      toggle .yFlag at xmin   ymin.ns
      toggle .zFlag at xmin   ymin.ud

      para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'
    exit

    -- Orientation Gadgets and Setting
    frame .orientationFrame 'Orientation' at xmin ymax+0.2

      -- EDG Set orientation
      button .edgOri3 pixmap width 24 height 24 tooltip 'Through three points'  callback '!this.pickOrientation(''3picks'')'
      path right
      button .edgOri2 pixmap width 24 height 24 tooltip 'Through origin and two points'  callback '!this.pickOrientation(''2picks'')'

      text .yDir 'Y is ' at x1   ymax+0.25 width 24 is STRING
      text .zDir 'Z is ' at xmin ymax      width 24 is STRING
      halign right
      path down
      paragraph .xDir width 31 lines 1
      halign left
    exit

    --  Reference (wrt)
    halign right
    text .wrt 'wrt' callback '!!plantGrids.setWrt()' width 26 string
  exit

  -- Apply/Dismiss
  button .apply   ' OK '   at xmin form-0    ymax form+0.25 callback '!this.apply()' ok
  button .dismiss 'Cancel' at xmax form-size ymin           callback '!this.close()' cancel

  -- Form Members
  -- Plane definition
  member .grid         is GPHPLANTGRID

  -- Aid number being modified
  member .aidGrid      is REAL

  -- Aid numbers for position & axes
  member .aidNumber    is REAL

  -- Form Control Members
  -- Position
  member .position     is POSITIONLINK
  -- Orientation
  member .orientation  is ORIENTATIONLINK

  -- Description
  member .description  is STRING
  !!plantGrids.description = 'Default plant Grid Definition'

  -- Action on apply
  member .action       is STRING

exit
-- End of form definition for !!plantGrids

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Link Position Option Gadgets to Objects in current coordinate system
  var !coordinate coordinate
  !this.position.linkOption('!!plantGrids.position', !this.ew, !this.ns, !this.ud, !coordinate)


  -- Set Actions to null so nothing happens
  !this.position.setAction('')

  -- Setup form
  !this.setupForm()

  -- Set Position Action
  !this.position.setAction('!!plantGrids.preview(true)')

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      plantGrids
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plantGrids()

  -- set icons
  !!plantGrids.edgOri3.addPixmap(!!pml.getPathName('ori3points24.png'))
  !!plantGrids.edgOri2.addPixmap(!!pml.getPathName('ori2points24.png'))

   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!plantGrids.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!plantGrids.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!plantGrids.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Link Orientation Gadgets to Object
  !this.orientation.linkInput('!!plantGrids.orientation', 'Y', !this.yDir, 'Z', !this.zDir, 'X', !this.xDir)

  -- Set Orientation Action
  !this.orientation.setAction('!!plantGrids.preview(true)')

  -- Define default plant grid
  !plantGrid             = object PLANTGRID()
  !plantGrid.position    = object POSITION('N0')
  !plantGrid.orientation = object ORIENTATION('Y is N')

  !this.grid.gphPlantGrid(!plantGrid)

  -- Aid Lines Number
  if(!this.aidNumber.unset()) then
    !this.aidNumber = !!aidNumbers.add(!this.grid)
  endif

endmethod
-- End of method definition for .plantGrids()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)
  !this.orientation.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Tidy form data
  !this.tidy()

  -- Revert the edg graphics back
  !!edgCntrl.remove(!this.description)

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide Modification Grid
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Current Data
  !position    = !this.position.get()
  !orientation = !this.orientation.get()

  -- Write data to plane member
  !this.grid.tag          = !this.label.val
  !this.grid.detail       = !this.detail.val
  !this.grid.basic        = false
  !this.grid.position(!position)
  !this.grid.orientation(!orientation)
  !this.grid.grid.xSpacings = !this.convertToReal(!this.xSpacings.val)
  !this.grid.grid.ySpacings = !this.convertToReal(!this.ySpacings.val)

  -- Modifying an aid or carry out an action
  if(!this.aidGrid.set()) then
    !!aidNumbers.replace(!this.aidGrid, !this.grid)

  -- Carry out action
  else
    $!this.action
  endif

  -- Close
  !this.close()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number being modified/created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Initialise form action
  !this.action            = STRING()

  -- Set form data
  !this.aidGrid           = !aidNumber
  !this.formTitle         = 'Modify grid [' & !aidNumber & ']'
  !this.grid              = !!aidNumbers.numbers[!aidNumber]
  !this.description       = 'Edit aid plant grid definition'

  -- If already shown, then re-initialise
  if(!this.shown()) then
    !this.setupForm()
  endif

endmethod
-- End of method definition for .setup(REAL)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Show the form and set up with passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Description
--    2   R      STRING      Action to be carried out on apply
--    3   R      plantGrid Reference plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!description is STRING, !actionCommand is STRING, !newGrid is GPHPLANTGRID)

  -- Define Action on apply
  !this.action           = !actionCommand

  -- Set form data
  !this.aidGrid          = REAL()
  !this.grid             = !newGrid
  !this.formTitle        = !description
  !this.description      = !description

  -- If already shown, then re-initialise
  if(!this.shown()) then
    !this.setupForm()
  endif

endmethod
-- End of method definition for .setup(STRING, STRING, GPHPLANTGRID)

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description: Setup form to current grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupForm()

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- If there is no defined grid, then use a default
  if(!this.grid.grid.position.unset()) then
    -- Define default plant grid
    !plantGrid             = object PLANTGRID()
    !plantGrid.position    = object POSITION('N0')
    !plantGrid.orientation = object ORIENTATION('Y is N')

    !this.grid.gphPlantGrid(!plantGrid)
  endif

  -- Get basic core object
  !plane = !this.grid.plane()

  -- Set display toggles
  !this.label.val  = !this.grid.tag
  !this.detail.val = !this.grid.detail
  !this.labelType.select(!this.grid.labelType)

  -- Set spacing
  !this.xSpacings.val = !this.convertToString(!this.grid.grid.xSpacings)
  !this.ySpacings.val = !this.convertToString(!this.grid.grid.ySpacings)

  -- Set with respect to
  !this.position.setWrt(!plane.position.origin)
  !this.orientation.setWrt(!plane.position.origin)

  -- Load form with plane definition
  !this.position.setPositionForce(!plane.position)
  !this.orientation.setOrientation(!plane.orientation)

  -- Set form wrt gadget
  !this.setWrt()

endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:      labelType
--
-- Description: Change label type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .labelType()

  if(!this.labelType.selection() eq 'ENU') then
    !this.grid.labelEnu()
  else
    !this.grid.labelOffset()
  endif

endmethod
-- End of method definition for .labelType()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for Basic representation of grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview(!basic is BOOLEAN)

  -- Current Data
  !position    = !this.position.get()
  !orientation = !this.orientation.get()

  -- Write data to plane member
  !this.grid.tag            = !this.label.val
  !this.grid.detail         = !this.detail.val
  !this.grid.basic          = !basic
  !this.grid.position(!position)
  !this.grid.orientation(!orientation)
  !this.grid.grid.xSpacings = !this.convertToReal(!this.xSpacings.val)
  !this.grid.grid.ySpacings = !this.convertToReal(!this.ySpacings.val)

  -- Update original list
  !this.xSpacings.val       = !this.convertToString(!this.grid.grid.xSpacings)
  !this.ySpacings.val       = !this.convertToString(!this.grid.grid.ySpacings)

  -- Replace current definition
  !!aidNumbers.replace(!this.aidNumber, !this.grid)

endmethod
-- End of method definition for .preview(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      pickOrientation
--
-- Description: Setup to define orientation using edg
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Ori definition type  3picks
--                                                2picks
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pickOrientation(!type is STRING)

  -- Define a pickpacket
  !packet          = object EDGPACKET()
  !packet.orientationLink('!!plantGrids.orientation', 'Orientate Plane')

  -- Two pick plane
  if(!type.upcase() eq '2PICKS') then
    -- Define specific for "definePlane" orientation
    !packet.pickPacket.plane2Pnts(!this.position.get())
  endif

  !packet.remove   = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickOrientation(STRING)

------------------------------------------------------------------------
--
-- Method:      convertToReal
--
-- Description:  Converts passed array element into array of reals, any element that can not be converted will be ignored
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array to be converted
-- Return:
--   [Data Type] [Description]
--    ARRAY       Converted array
--
------------------------------------------------------------------------

-- Define method
define method .convertToReal(!input is ARRAY) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()

  -- Loop through input array
  do !entry values !input
    -- Ignore null entry in textpane
    skip if (!entry.trim() eq ||)
    !returnArray.append(!entry.real(!!distanceFmt))
    handle any
    endhandle
  enddo

  -- Return Data
  return !returnArray

endmethod
-- End of method definition for .convertToReal(ARRAY) ARRAY

------------------------------------------------------------------------
--
-- Method:      convertToString
--
-- Description:  Converts passed array element into array of string, any element that can not be converted will be ignored
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array to be converted
-- Return:
--   [Data Type] [Description]
--    ARRAY       Converted array
--
------------------------------------------------------------------------

-- Define method
define method .convertToString(!input is ARRAY) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()

  -- Loop through input array
  do !entry values !input
    !returnArray.append(!entry.string(!!distanceFmt))
    handle any
    endhandle
  enddo

  -- Return Data
  return !returnArray

endmethod
-- End of method definition for .convertToString(ARRAY) ARRAY

------------------------------------------------------------------------
--
-- Method:      updateAid
--
-- Description: Update/create passed aid number with grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateAid(!aidNumber is REAL)

  -- Update aid system
  !!aidNumbers.replace(!aidNumber, !this.grid)

endmethod
-- End of method definition for .updateAid(REAL)

------------------------------------------------------------------------
--
-- Method:      derive
--
-- Description: Derive grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of derive
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .derive(!passedType is STRING)

  -- Initialise Variables
  !type = !passedType.upcase()

  -- Derive from columns beneath current element
  if(!type eq 'COLUMNS') then

    -- Collect all columns (if length is distance between the Z positions, we'll
    -- assume them to be columns)
    var !collection COLLECT ALL SCTN WITH (abs(POSS[3] - POSE[3]) EQ DER LENGTH) FOR CE

    -- If there are no sections, then we can't derive the
    if(!collection.empty()) then
      !!alert.warning('No "columns" found beneath the current element.')
      return
    endif

    -- Convert all sections to lines
    do !i indices !collection
      !section   = !collection[!i].dbRef()
      !lines[!i] = object LINE(!section.posStart, !section.posEnd)
    enddo

    -- Derive a grid from the passed line
    !grid        = !this.grid.derive(!lines)

    -- Update list
    !this.xSpacings.val = !this.convertToString(!grid.xSpacings)
    !this.ySpacings.val = !this.convertToString(!grid.ySpacings)

    -- Update position
    !this.position.position(!grid.position.wrt(!this.wrt.val.dbRef()))

  endif

endmethod
-- End of method definition for .derive(STRING)
