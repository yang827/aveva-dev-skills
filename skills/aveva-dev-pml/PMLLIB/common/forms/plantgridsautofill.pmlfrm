--
--
-- Description:
-- Autofill plant grid IDs and offsets
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  idFormat(GADGET,GADGET,GADGET)   -                   Validation
--  idFrom(GADGET,GADGET)            -                   Validation
--  idOrder(GADGET,GADGET)           -                   Validation
--  initialise()                     -                   Initialisation of form
--  plantGridsAutofill()             -                   Constructor
--  unsetCheck(GADGET,REAL)          -                   Validation
--  unsetNegZeroCheck(GADGET,REAL)   -                   Validation
--  writeBack(GADGET,GADGET,GADGET,GADGET,GADGET,GADGET,GADGET,GADGET,GADGET,GADGET,GADGET) -                   Write data back to parent form
--
------------------------------------------------------------------------

-- Define form
setup form !!plantGridsAutofill

  !!plantGridsAutofill.formTitle     = 'Autofill Rectangular Grid System'
  !!plantGridsAutofill.iconTitle     = 'Gridsystem'
  !!plantGridsAutofill.formRevision  = ' $Revision: 1.0 $ '

  -- X axis
  frame .xFrame 'X Axis' anchor top+bottom+left

    text .xAxisLabel      'Label'        at xmin+0.5 ymin+0.8 tagwidth 9 width 10 is STRING
    path right

    text .xOffsetFrom     'Offsets from' at xmin ymax+0.2 tagwidth 9 width 14 is REAL format !!distanceFmt
    text .xOffsetTo       'to'           width 14 is REAL format !!distanceFmt
    text .xOffsetInterval 'interval'     tagwidth 6 width 7 is REAL format !!distanceFmt

    option .xIdFormat     'IDs format'   at xmin.xAxisLabel ymax+0.2 tagwidth 9 width 7
    option .xIdOrder                     width 8
    text   .xIdFrom       'from'         at xmax.xOffsetTo-size tagwidth 4 width 4 is STRING
    text   .xIdInterval   'interval'     at xmax.xOffsetInterval-size tagwidth 6 width 7 is REAL

  exit
  path down

  -- Y axis
  frame .yFrame 'Y Axis' anchor top+bottom+left

    text .yAxisLabel      'Label'        at xmin+0.5 ymin+0.8 tagwidth 9 width 10 is STRING
    path right

    text .yOffsetFrom     'Offsets from' at xmin ymax+0.2 tagwidth 9 width 14 is REAL format !!distanceFmt
    text .yOffsetTo       'to'           width 14 is REAL format !!distanceFmt
    text .yOffsetInterval 'interval'     tagwidth 6 width 7 is REAL format !!distanceFmt

    option .yIdFormat     'IDs format'   at xmin.yAxisLabel ymax+0.2 tagwidth 9 width 7
    option .yIdOrder                     width 8
    text   .yIdFrom       'from'         at xmax.yOffsetTo-size tagwidth 4 width 4 is STRING
    text   .yIdInterval   'interval'     at xmax.yOffsetInterval-size tagwidth 6 width 7 is REAL

  exit
  path down

  -- Z axis
  frame .zFrame 'Z Axis' anchor top+bottom+left

    text .zAxisLabel      'Label'        at xmin+0.5 ymin+0.8 tagwidth 9 width 10 is STRING
    path right

    text .zOffsetFrom     'Offsets from' at xmin ymax+0.2 tagwidth 9 width 14 is REAL format !!distanceFmt
    text .zOffsetTo       'to'           width 14 is REAL format !!distanceFmt
    text .zOffsetInterval 'interval'     tagwidth 6 width 7 is REAL format !!distanceFmt

    option .zIdFormat     'IDs format'   at xmin.zAxisLabel ymax+0.2 tagwidth 9 width 7
    text   .zIdFrom       'from'         at xmax.zOffsetTo-size tagwidth 4 width 4 is STRING
    text   .zIdInterval   'interval'     at xmax.zOffsetInterval-size tagwidth 6 width 7 is REAL

  exit

  -- ok/cancel
  button .ok     ' OK '   anchor left+bottom at xmin form ymax+0.5 ok
  button .cancel 'Cancel' anchor right+bottom at xmax form-size ymin cancel

  -- Alphabet data
  member .alphabet     is STRING
  member .alphaArray   is ARRAY

  -- Units based defaults
  member .metHorizSpacing   is REAL
  member .metHorizExtent    is REAL
  member .metVertSpacing    is REAL
  member .metVertExtent     is REAL
  member .impHorizSpacing   is REAL
  member .impHorizExtent    is REAL
  member .impVertSpacing    is REAL
  member .impVertExtent     is REAL
  member .horizSpacing      is REAL
  member .horizExtent       is REAL
  member .vertSpacing       is REAL
  member .vertExtent        is REAL

exit
-- End of form definition for !!plantGrids

------------------------------------------------------------------------
--
-- Method:      plantGridsAutofill
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plantGridsAutofill()

  -- Units based defaults
  !this.metHorizSpacing = 5000mm
  !this.metHorizExtent  = 50000mm
  !this.metVertSpacing  = 4000mm
  !this.metVertExtent   = 20000mm
  !this.impHorizSpacing = 18'
  !this.impHorizExtent  = 180'
  !this.impVertSpacing  = 15'
  !this.impVertExtent   = 75'

  -- Select default values appropriate to units
  if (!!distanceFmt.units eq |MM|) then
    !this.horizSpacing = !this.metHorizSpacing
    !this.horizExtent  = !this.metHorizExtent
    !this.vertSpacing  = !this.metVertSpacing
    !this.vertExtent   = !this.metVertExtent
  else
    !this.horizSpacing = !this.impHorizSpacing
    !this.horizExtent  = !this.impHorizExtent
    !this.vertSpacing  = !this.impVertSpacing
    !this.vertExtent   = !this.impVertExtent
  endif

  -- Callbacks
  !this.callback                 = |!this.initialise()|
  !this.ok.callback              = |!this.apply()|
  !this.xOffsetFrom.callback     = |!this.unsetCheck(!this.xOffsetFrom, 0)|
  !this.yOffsetFrom.callback     = |!this.unsetCheck(!this.yOffsetFrom, 0)|
  !this.zOffsetFrom.callback     = |!this.unsetCheck(!this.zOffsetFrom, 0)|
  !this.xOffsetTo.callback       = |!this.unsetCheck(!this.xOffsetTo, !this.horizExtent)|
  !this.yOffsetTo.callback       = |!this.unsetCheck(!this.yOffsetTo, !this.horizExtent)|
  !this.zOffsetTo.callback       = |!this.unsetCheck(!this.zOffsetTo, !this.vertExtent)|
  !this.xOffsetInterval.callback = |!this.unsetNegZeroCheck(!this.xOffsetInterval, !this.horizSpacing)|
  !this.yOffsetInterval.callback = |!this.unsetNegZeroCheck(!this.yOffsetInterval, !this.horizSpacing)|
  !this.zOffsetInterval.callback = |!this.unsetNegZeroCheck(!this.zOffsetInterval, !this.vertSpacing)|
  !this.xIdFormat.callback       = |!this.idFormat(!this.xIdFormat, !this.xIdFrom, !this.xIdInterval)|
  !this.yIdFormat.callback       = |!this.idFormat(!this.yIdFormat, !this.yIdFrom, !this.yIdInterval)|
  !this.zIdFormat.callback       = |!this.idFormat(!this.zIdFormat, !this.zIdFrom, !this.zIdInterval)|
  !this.xIdOrder.callback        = |!this.idOrder(!this.xIdOrder, !this.xIdFrom)|
  !this.yIdOrder.callback        = |!this.idOrder(!this.yIdOrder, !this.yIdFrom)|
  !this.xIdFrom.callback         = |!this.idFrom(!this.xIdFormat, !this.xIdFrom)|
  !this.yIdFrom.callback         = |!this.idFrom(!this.yIdFormat, !this.yIdFrom)|
  !this.zIdFrom.callback         = |!this.idFrom(!this.zIdFormat, !this.zIdFrom)|
  !this.xIdInterval.callback     = |!this.unsetNegZeroCheck(!this.xIdInterval, 1)|
  !this.yIdInterval.callback     = |!this.unsetNegZeroCheck(!this.yIdInterval, 1)|
  !this.zIdInterval.callback     = |!this.unsetNegZeroCheck(!this.zIdInterval, 1)|

  -- Options
  !formats = ARRAY()
  !formats.append(|Numeric|)
  !formats.append(|Alphabetic|)
  !this.xIdFormat.dtext = !formats
  !this.yIdFormat.dtext = !formats
  !this.zIdFormat.dtext = !formats
  !orders = ARRAY()
  !orders.append(|Ascending|)
  !orders.append(|Descending|)
  !this.xIdOrder.dtext = !orders
  !this.yIdOrder.dtext = !orders

  -- Alphabet
  !this.alphabet = |ABCDEFGHIJKLMNOPQRSTUVWXYZ|
  do !i to 26
    !this.alphaArray.append(!this.alphabet.substring(!i, 1))
  enddo

endmethod
-- End of method definition for .plantGridsAutofill()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Set some initial x axis values
  !this.xAxisLabel.val      = |X|
  !this.xOffsetFrom.val     = 0
  !this.xOffsetTo.val       = !this.horizExtent
  !this.xOffsetInterval.val = !this.horizSpacing
  !this.xIdFormat.select(|Dtext|, |Numeric|)
  !this.xIdOrder.select(|Dtext|,  |Ascending|)
  !this.xIdFrom.val         = |0|
  !this.xIdInterval.val     = 1
  !this.idFormat(!this.xIdFormat, !this.xIdFrom, !this.xIdInterval)

  -- Set some initial y axis values
  !this.yAxisLabel.val      = |Y|
  !this.yOffsetFrom.val     = 0
  !this.yOffsetTo.val       = !this.horizExtent
  !this.yOffsetInterval.val = !this.horizSpacing
  !this.yIdFormat.select(|Dtext|, |Alphabetic|)
  !this.yIdOrder.select(|Dtext|,  |Ascending|)
  !this.yIdFrom.val         = |A|
  !this.yIdInterval.val     = 1
  !this.idFormat(!this.yIdFormat, !this.yIdFrom, !this.yIdInterval)

  -- Set some initial x axis values
  !this.zAxisLabel.val      = |EL|
  !this.zOffsetFrom.val     = 0
  !this.zOffsetTo.val       = !this.vertExtent
  !this.zOffsetInterval.val = !this.vertSpacing
  !this.zIdFormat.select(|Dtext|, |Numeric|)
  !this.zIdFrom.val         = |0|
  !this.zIdInterval.val     = 1
  !this.idFormat(!this.zIdFormat, !this.zIdFrom, !this.zIdInterval)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      unsetCheck
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unsetCheck(!gadget is GADGET, !default is REAL)

  -- Prevent unset value
  if (!gadget.val.unset()) then
    !!alert.error(|Number required|)
    !gadget.val = !default
  endif

endmethod
-- End of method definition for .unsetCheck()

------------------------------------------------------------------------
--
-- Method:      unsetNegZeroCheck
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unsetNegZeroCheck(!gadget is GADGET, !default is REAL)

  -- Prevent unset or negative
  if (!gadget.val.unset()) then
    !!alert.error(|Number required|)
    !gadget.val = !default
  elseif (!gadget.val le 0) then
    !!alert.error(|Number must be positive|)
    !gadget.val = !default
  endif

endmethod
-- End of method definition for .unsetNegZeroCheck()

------------------------------------------------------------------------
--
-- Method:      idFormat
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .idFormat(!formatGadget is GADGET, !fromGadget is GADGET, !intervalGadget is GADGET)

  -- Control activation of interval gadget
  if (!formatGadget.selection() eq |Numeric|) then
    !fromGadget.val        = |0|
    !intervalGadget.val    = 1
    !intervalGadget.active = TRUE
  elseif (!formatGadget.selection() eq |Alphabetic|) then
    !fromGadget.val        = |A|
    !intervalGadget.val    = 1
    !intervalGadget.active = FALSE
  endif

endmethod
-- End of method definition for .idFormat()

------------------------------------------------------------------------
--
-- Method:      idOrder
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .idOrder(!orderGadget is GADGET, !fromGadget is GADGET)

  -- Control activation of interval gadget
  if (!orderGadget.selection() eq |Ascending|) then
    !fromGadget.tag = |from|
  elseif (!orderGadget.selection() eq |Descending|) then
    !fromGadget.tag = |  to|
  endif

endmethod
-- End of method definition for .idOrder()

------------------------------------------------------------------------
--
-- Method:      idFrom
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .idFrom(!formatGadget is GADGET, !fromGadget is GADGET)

  -- Prevent unset value
  if (!fromGadget.val.trim().empty()) then
    if (!formatGadget.selection() eq |Numeric|) then
      !!alert.error(|Number required|)
      !fromGadget.val = |0|
    elseif (!formatGadget.selection() eq |Alphabetic|) then
      !!alert.error(|Letter required|)
      !fromGadget.val = |A|
    endif
  endif

  -- Prevent inconsistent value
  if (!formatGadget.selection() eq |Numeric|) then
    !unusedTest = !fromGadget.val.real()
    handle (2,441) (2,813)
      -- Unable to convert string to number
      !!alert.error(|Number required|)
      !fromGadget.val = |0|
    endhandle
  elseif (!formatGadget.selection() eq |Alphabetic|) then
    if (!this.alphabet.match(!fromGadget.val) eq 0 or !fromGadget.val.length() gt 1) then
      !!alert.error(|Single alphabetic character required|)
      !fromGadget.val = |A|
    endif
  endif

endmethod
-- End of method definition for .idFrom()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Z axis does not have order gadget
  !nullGadget = object GADGET()

  -- Write data back to plant3dgrids form
  !this.writeBack(!!plant3dGrids.xAxisLabel, !!plant3dGrids.xOffsets, !!plant3dGrids.xAxisIds, !this.xAxisLabel, !this.xOffsetFrom, !this.xOffsetTo, !this.xOffsetInterval, !this.xIdFormat, !this.xIdOrder, !this.xIdFrom, !this.xIdInterval)
  !this.writeBack(!!plant3dGrids.yAxisLabel, !!plant3dGrids.yOffsets, !!plant3dGrids.yAxisIds, !this.yAxisLabel, !this.yOffsetFrom, !this.yOffsetTo, !this.yOffsetInterval, !this.yIdFormat, !this.yIdOrder, !this.yIdFrom, !this.yIdInterval)
  !this.writeBack(!!plant3dGrids.zAxisLabel, !!plant3dGrids.zOffsets, !!plant3dGrids.zAxisIds, !this.zAxisLabel, !this.zOffsetFrom, !this.zOffsetTo, !this.zOffsetInterval, !this.zIdFormat, !nullGadget,    !this.zIdFrom, !this.zIdInterval)

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      writeBack
--
-- Description: Write data back to parent form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .writeBack(!parentLabel is GADGET, !parentOffsets is GADGET, !parentIds is GADGET, !label is GADGET, !offsetFrom is GADGET, !offsetTo is GADGET, !offsetInterval is GADGET, !idFormat is GADGET, !idOrder is GADGET, !idFrom is GADGET, !idInterval is GADGET)

  -- Axis label
  !parentLabel.val = !label.val

  -- Axis offsets
  !offsets = ARRAY()
  do !offset from !offsetFrom.val to !offsetTo.val by !offsetInterval.val
    !offsets.append(!offset.string(!!distanceFmt))
  enddo
  !parentOffsets.val = !offsets

  -- Axis IDs
  !ids = ARRAY()
  !count = 0
  if (!idFormat.selection() eq |Numeric|) then
    do !id from !idFrom.val.real() by !idInterval.val
      !ids.append(!id.string())
      !count = !count + 1
      break if (!count eq !offsets.size())
    enddo
  elseif (!idFormat.selection() eq |Alphabetic|) then
    do !i from !this.alphabet.match(!idFrom.val)
      -- Extend array on demand like Excel columns (...,X,Y,Z,AA,AB,AC,...,BA,BB,BC,...)
      if (!i gt !this.alphaArray.size()) then
        !prefix = int(!this.alphaArray.size() / 26)
        do !j to 26
          !this.alphaArray.append(!this.alphabet.substring(!prefix, 1) & !this.alphabet.substring(!j, 1))
        enddo
      endif
      !ids.append(!this.alphaArray[!i])
      !count = !count + 1
      break if (!count eq !offsets.size())
    enddo
  endif

  -- Reverse order if descending (calculated in ascending order first so no need to count backwards to target value)
  if (!idOrder.set()) then
    if (!idOrder.selection() eq |Descending|) then
      !ids = !ids.invert()
    endif
  endif
  !parentIds.val = !ids

endmethod
-- End of method definition for .writeBack()
