--
--
-- Description:
-- Plotfile viewer
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  browse()                         -                   Invoke browser for plotfile viewer
--  filename()                       -                   View plotfile from filename typed in
--  foreground(REAL)                 -                   set foreground (colour 1 for plotfile)
--  plotView()                       -                   Constructor
--  reset()                          -                   Reset limits for plotfile viewer
--  view(FILE)                       -                   Display plotfile in viewer
--
------------------------------------------------------------------------

setup form !!plotView resize VarChars NoAlign
Import 'pmlfilebrowser'
handle any
endhandle

  !!plotView.formTitle     = 'View Plotfile'
  !!plotView.iconTitle     = 'Plotfile'
  !!plotView.callback      = ''
  !!plotView.formRevision  = ' $Revision: 1.10 $ '

  -- Body of form definition
  member .file is FILE
  member .lastViewed is FILE
  member .foreground is REAL

  -- Form control
  bar
    add 'Control' .controlMenu
  exit

  -- Plotfile name and view

  path down
  vdist 0.5
  paragraph .label text 'Filename'
  text .filename at xmin.label anchor T+L+R width 60 is STRING
  vdist 0
  frame .fview anchor all width.filename
    view .plot at 1 1 plot
      width 10
      height 15
      borders on
    exit
  exit
  path right
  valign centre
  button .browse 'Browse...' at xmax form-size ymin.label anchor T+R

exit
-- End of form definition for !!plotView

------------------------------------------------------------------------
--
-- Method:      !plotView()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .plotView()

  -- bar menu
  !this.newMenu('ControlMenu')
  !this.controlMenu.add('callback', 'Reset', '!!plotView.reset()')
  !this.controlMenu.add('callback', 'Background Colour...', |!!colourSelectLoad('!!plotView.plot.background = !!colourSelectGet()', 'Background Colour', !!plotView.plot.background)|)
  -- !this.controlMenu.add('callback', 'Foreground Colour...', |!!colourSelectLoad('!!plotView.foreground(!!colourSelectGet())', 'Foreground Colour', !!plotView.foreground)|)
  !this.controlMenu.add('separator')
  !this.controlMenu.add('callback', 'Close', '!!plotView.hide()')

  -- callbacks
  !this.browse.callback = '!!plotView.browse()'
  !this.filename.callback = '!!plotView.filename()'

  -- default background and foreground colours
  !this.plot.background = 'black'
  !this.foreground = 1

endmethod
-- End of method definition for .plotView()

------------------------------------------------------------------------
--
-- Method:      !view()
--
-- Description: Display plotfile in viewer
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FILE] [plotfile]
--
------------------------------------------------------------------------

define method .view(!plotfile is FILE)

  -- clear first in case of error
  !this.plot.clear()
  !this.filename.val = ''

  if (!plotfile.unset().not()) then
    if (!plotfile.exists()) then

      -- Display plotfile
      !this.plot.add('/' & !plotfile.fullName())

      -- Store plotfile details
      !this.file = !plotfile
      !this.filename.val = !plotfile.fullName()

      -- Store name of any plotfile viewed so that we can get an initial
      -- browse path after the first
      !this.lastViewed = !plotfile

    endif
  endif

endmethod
-- End of method definition for .view(FILE)

------------------------------------------------------------------------
--
-- Method:      !filename()
--
-- Description: View plotfile from filename typed in
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .filename()

  if (!this.filename.val.trim() ne '') then
    -- Test if file exists
    !testFile = object FILE(!this.filename.val)
    if (!testFile.exists().not()) then
      !this.plot.clear()
      -- Retain focus if filename is incorrect
      !this.filename.setFocus()
      -- 'File #name does not exist'
      !!messageFile.error(146, 9, !testFile.fullName())
    else
      -- View file if it exists
      !this.view(!testFile)
    endif
  endif

endmethod
-- End of method definition for .filename()

------------------------------------------------------------------------
--
-- Method:      !browse()
--
-- Description: Invoke browser for plotfile viewer
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .browse()

  -- Set default directory path for file browser
  if (!this.lastViewed.unset()) then
    !path = '%PDMSUSER%'
  else
    !path = !this.lastViewed.pathName()
  endif
  !!fileBrowser(!path, |*.plt|, |View Plotfile|, TRUE, |!!plotView.view(!!fileBrowser.file)|)

endmethod
-- End of method definition for .browse()

------------------------------------------------------------------------
--
-- Method:      !reset()
--
-- Description: Reset limits for plotfile viewer
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .reset()

  -- Add plotfile again
  if (!this.file.unset().not()) then
    !this.view(!this.file)
  endif

endmethod
-- End of method definition for .reset()

------------------------------------------------------------------------
--
-- Method:      !foreground()
--
-- Description: set foreground (colour 1 for plotfile)
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [REAL] [colour number]
--
------------------------------------------------------------------------

define method .foreground(!colourNo is REAL)

  -- set colour 1 to foreground colour
  var !newColour COLOUR $!colourNo
  COLOUR 1 $!newColour

endmethod
-- End of method definition for .foreground(REAL)
