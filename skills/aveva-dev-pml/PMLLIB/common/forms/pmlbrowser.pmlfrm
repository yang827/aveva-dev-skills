--
--
-- Description:
--   PML File definition browser.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close Form
--  definition()                     PMLDEFINITION       Returns selected definition
--  display()                        -                   Load display
--  file()                           FILE                Returns selected file
--  fileHide()                       -                   Hide form
--  fileKill()                       -                   Show form
--  fileLoad()                       -                   Reload file
--  fileOpen(STRING)                 -                   Open the current file
--  fileShow()                       -                   Show form
--  fileView(REAL,REAL)              -                   View the current file
--  filter()                         -                   Set filter
--  globalVariable()                 -                   Show global variable form
--  initialise()                     -                   Initialise Form
--  load()                           -
--  load(REAL)                       -
--  pmlBrowser()                     -                   constructor
--  selectDefinition()               -                   Select definition
--  selectIndex()                    -                   Select definition
--  selectMethod()                   -                   Select definition
--  selectType()                     -                   Select Type
--  setupFileMenu()                  -                   Setup file menu
--  sortMethods()                    -                   Set sort
--  sortMethods(STRING)              -                   Set sort for methods
--

setup form !!pmlBrowser resize

  !this.formTitle     = 'PML Browser'
  !this.iconTitle     = ''
  !this.callback      = '!this.initialise()'
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.10 $ '

  -- Bar Menu
  bar
  exit
  vdist 0.1

    -- Definition Indices
  list .index 'PML Search Paths'         at xmin   ymax                callback '!this.selectIndex()' multi  width 30 length 4

    -- Definition Types
    path down
    halign right
  option .types 'File type' tagwidth 6                          callback '!this.selectType()'         width 9

    -- Filter
  text .filter 'Filter'     tagwidth 4                          callback '!this.filter()'             width 26 is STRING

    -- Definition Files
    vdist 0.8
  list .pmlDefinitions  'PML Definitions' anchor left + top + bottom  at xmin.index ymax+1 callback '!this.selectDefinition()'   width 30 length 20

  -- Method arguments

    -- Definition File data
  list .definition  'Definition File Information' anchor left + right + top at xmax.index+1   ymin.index                                            width 50 length 16

    -- Available Methods
  list .methods 'Methods'  anchor left + top + bottom at xmin ymax   callback '!this.selectMethod()'        width 16 length 13
    path right
    -- Method arguments
  list .methodDefinition 'I/O'  anchor all at xmax+1 ymin width 31 length 13

  -- Form Variables
  -- Current definition
  member .current    is PMLDEFINITION

  -- Tables are two dimension, each entry is for each index
  -- Definition File Tables
  member .form       is ARRAY
  member .object     is ARRAY
  member .function   is ARRAY
  member .data       is ARRAY
  member .macro      is ARRAY
  member .icon       is ARRAY

  -- Quick Look up Tables
  member .forms      is ARRAY
  member .objects    is ARRAY
  member .functions  is ARRAY
  member .datas      is ARRAY
  member .macros     is ARRAY
  member .icons      is ARRAY

  -- Index Files
  member .indices    is ARRAY
  member .indexFile  is ARRAY

  -- Method Sort
  member .methodSort is STRING

exit
-- End of form definition

----------------------------------------------------------------------
--
-- Method:      pmlBrowser
--
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pmlBrowser()

  -- Initialise Variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Menu
  !bar = !this.bar
    !bar.add('Control',    'menuControl')
    !bar.add('Index',      'menuIndex')
    !bar.add('Definition', 'menuDefinition')
    !bar.add('Utilities',  'menuUtilities')

  -- Control Menu
  !menu = !this.newMenu('menuControl')
    !menu.add('callback', 'Close',       '!this.close()')

  -- Index Menu
  !menu = !this.newMenu('menuIndex')
    !menu.add('callback', 'Reload',      '!this.load()')
    !menu.add('separator')
    !menu.add('callback', 'Rehash',      'PML REHASH')
    !menu.add('callback', 'Rehash All',  'PML REHASH ALL')
    !menu.add('separator')
    !menu.add('callback', 'Reindex',     'PML INDEX')

  -- Definition File Menu
  !menu = !this.newMenu('menuDefinition')
    !menu.add('menu',     'View',        'menuView')
    !menu.add('menu',     'Open with',   'menuOpen')
    !menu.add('separator')
    !menu.add('callback', 'Reload',      '!this.fileLoad()')
    !menu.add('callback', 'Show',        '!this.fileShow()')
    !menu.add('callback', 'Hide',        '!this.fileHide()')
    !menu.add('callback', 'Kill',        '!this.fileKill()')

    -- View Menu
    -- Open Menu
    !menu = !this.newMenu('menuView')
      !menu.add('callback', ' 80x50...',     '!this.fileView(80, 50)')
      !menu.add('callback', '120x60...',     '!this.fileView(120, 60)')
      !menu.add('callback', ' 80x30...',     '!this.fileView(80, 30)')
      !menu.add('callback', ' 60x30...',     '!this.fileView(60, 30)')

    -- Open Menu
    !menu = !this.newMenu('menuOpen')

    !menu.add('callback', 'Pfe',     '!this.fileOpen(|pfe32|)')
    !menu.add('callback', 'Emacs',   '!this.fileOpen(|emacs|)')

  -- Utilities Menu
  !menu = !this.newMenu('menuUtilities')
    !menu.add('callback', 'Active Forms...',          'show !!pmlForms')
    !menu.add('callback', 'Global Variable Query...', '!this.globalVariable()')

  -- Sort Menus
  --   Properties
  !menu = !this.newMenu('menuMethods')
    !menu.add('toggle', 'File order',         '!this.sortMethods(|file|)')
    !menu.add('toggle', 'Alphabetic',         '!this.sortMethods(|alphabetic|)')

  !this.methods.setPopup(!this.menuMethods)
  !this.sortMethods('file')

  -- Option
  !dtext.append('All')
  !rtext.append('all')
  !dtext.append('Forms')
  !rtext.append('form')
  !dtext.append('Objects')
  !rtext.append('object')
  !dtext.append('Functions')
  !rtext.append('function')

  !this.types.dtext = !dtext
  !this.types.rtext = !rtext

  -- Set Filter
  !this.filter.val  = '*'

  -- Tool Tips
  !this.index.setTooltip('Current "pml.index" paths')
  !this.types.setTooltip('Definition types displayed')
  !this.filter.setTooltip('Name filter')
  !this.pmlDefinitions.setTooltip('Available definitions')
  !this.definition.setTooltip('Definition of file')
  !this.methods.setTooltip('Available methods')
  !this.methodDefinition.setTooltip('Method return data and Input arguments')

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Load the indexes

  -- If there are no indexes, the load
  if(!this.indexFile.empty()) then
    !this.load()
  endif

  -- Setup file menu
  !this.setupFileMenu()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()
  !this.hide()
endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      setupFileMenu
--
-- Description: Setup file menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupFileMenu()

  -- Initialise Variables

  -- If there is no current type, then grey-out the file menu
  if(!this.current.type.unset()) then
    !this.bar.setActive('Definition', false)

  -- Set file bar menu up
  else
    !this.bar.setActive('Definition', true)
    !this.menuDefinition.setActive('Reload', !this.current.type.eq('form').or(!this.current.type.eq('object')))
    !this.menuDefinition.setActive('Show',   !this.current.type.eq('form'))
    !this.menuDefinition.setActive('Hide',   !this.current.type.eq('form'))
    !this.menuDefinition.setActive('Kill',   !this.current.type.eq('form'))

  endif

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      Load
--
-- Description: Load Indices
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .load()

  -- Initialise Variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Clear tables
  !this.form.clear()
  !this.object.clear()
  !this.function.clear()
  !this.data.clear()
  !this.macro.clear()
  !this.icon.clear()

  !this.forms.clear()
  !this.objects.clear()
  !this.functions.clear()
  !this.datas.clear()
  !this.macros.clear()
  !this.icons.clear()

  -- Index file lists
  !this.indices.clear()
  !this.indexFile.clear()

  -- Clear gadgets
  !this.pmlDefinitions.clear()
  !this.definition.clear()
  !this.methods.clear()
  !this.methodDefinition.clear()

  -- Initialise Current
  !this.current = object PMLDEFINITION()

  -- Load Environment variables
     !env = !!evarSplit('PMLLIB')

  -- Get the pml.index from each of the paths
  do !i indices !env
    !path        = !env[!i]

    -- Get pml index file
    !index       = object FILE(!path & '/pml.index')
    -- ignore if index file does not exist
    skip if !index.exists().not()

    !this.indices.append(false)
    !this.indexFile.append(!index)
    !dtext.append(!env[!i])
    !rtext.append(!index.fullname())

  enddo

  -- Load index table
  !this.index.dtext = !dtext
  !this.index.rtext = !rtext

  -- Setup file menu
  !this.setupFileMenu()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      Load
--
-- Description: Load passed index
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Pointer to index file
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .load(!index is REAL)

  -- Initialise Variables
  !indexFile      = !this.indexFile[!index]
  !indexPath      = !this.indexFile[!index].pathName()
  !path           = !indexPath
  !this.formTitle = 'Loading index ' & !indexFile.fullname()

  -- Read index file
  !definitions    = !indexFile.readFile()

  -- Loop through the index file
  do !file values !definitions

    -- Ignore files starting with a "."
    skip if(!file.substring(1,1) eq '.')

    -- Define current path
    if(!file.substring(1,1) eq '/') then
      !path      = !indexPath & !file
      skip
    endif

    -- Determine file type
    !filename    = !path & !file

    -- Get definition of file
    !definition  = object PMLDEFINITION(!indexFile, !filename)

    -- Ignore undefined files
    skip if(!definition.type.unset() or !definition.name.trim().empty())

    -- Initialise Lists
    if(undefined(!this.attribute(!definition.type)[!index])) then
      !this.attribute(!definition.type)[!index]       = ARRAY()
      !this.attribute(!definition.type & 's')[!index] = ARRAY()
    endif

    -- Save into list
    !this.attribute(!definition.type)[!index].append(!definition)
    !this.attribute(!definition.type & 's')[!index].append(!definition.name)

  enddo

  -- Form Header
  !this.formTitle = 'PML Browser'

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      display
--
-- Description: Load display
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .display()

  -- Initialise Variables
  !types         = ARRAY()
  !names         = ARRAY()
  !pointers      = ARRAY()

  -- Table types
  if(!this.types.selection() eq 'all') then
    !types.append('form')
    !types.append('object')
    !types.append('function')
  else
    !types.append(!this.types.selection())
  endif

  -- Build list of display items

  -- Loop through the index files
  do !i values !this.index.val

    -- Loop though the lists
    do !j indices !types

      do !k indices !this.attribute(!types[!j] & 's')[!i]
        !name = !this.attribute(!types[!j] & 's')[!i][!k]

        -- Check for wild card
        skip if(!name.matchwild(!this.filter.val).not())

        !names.append(!name)
        !pointers.append(!i & '\' & !types[!j] & '\' & !k)
      enddo

    enddo

  enddo

  -- Sort list by name
  !sort = !names.sortedIndices()
  !names.reIndex(!sort)
  !pointers.reIndex(!sort)

  -- Build list
  !this.pmlDefinitions.dtext = !names
  !this.pmlDefinitions.rtext = !pointers

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      selectIndex
--
-- Description: Select definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectIndex()

  -- Initialise Variables
  !index      = !this.index.pickedField
  !lastPicked = !this.index.rtext[!index]
  !selection  = !this.index.selection()

  -- If last picked is in selection, then we have added the last picked
  -- to the selection list
  if(!selection.findFirst(!lastPicked).set()) then

    -- Load index if not loaded
    if(!this.indices[!index].not()) then
      !this.load(!index)
      !this.indices[!index] = true
    endif

  endif

  -- Display
  !this.display()

  -- Select Definition
  --!this.selectDefinition()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      selectType
--
-- Description: Select Type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectType()

  -- Initialise Variables

  -- Display
  !this.display()

  -- Select Definition
  --!this.selectDefinition()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      filter
--
-- Description: Set filter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .filter()

  -- Initialise Variables

  -- Handle empty filter
  if(!this.filter.val.trim().empty()) then
    !this.filter.val = '*'
  else
    !this.filter.val = !this.filter.val.trim()
  endif

  -- Display
  !this.display()

  -- Select Definition
  --!this.selectDefinition()

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      selectDefinition
--
-- Description: Select definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectDefinition()

  -- Initialise Variables
  !selection    = !this.pmlDefinitions.selection('RTEXT')

  -- Get data
  !index        = !selection.part(1, '\').real()
  !type         = !selection.part(2, '\')
  !entry        = !selection.part(3, '\').real()

  -- Definition
  !this.attribute(!type)[!index][!entry].read()
  handle ANY
    return
  endhandle
  !this.current = !this.attribute(!type)[!index][!entry]

  -- Initialise Variables
  !this.methods.clear()
  !this.definition.clear()

  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Load method
  if(!this.current.methods.empty().not() and !this.current.type ne 'function') then

    -- Build display list
    do !i indices !this.current.methods
      !dtext[!i] = !this.current.methods[!i].name
      !rtext[!i] = !this.current.methods[!i].start.string()
    enddo

    !this.methods.dtext = !dtext
    !this.methods.rtext = !rtext

    -- Sort Method
    !this.sortMethods()

  endif

  -- File definition information
  !this.definition.clear()
  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext.append('  Name : ' & !this.current.name)
  !dtext.append('  Type : ' & !this.current.type)
  !dtext.append('  File : ' & !this.current.file.fullname())
  !dtext.append('   DTM : ' & !this.current.file.dtm())
  !dtext.append(' Index : ' & !this.current.index.pathName())

  -- Function Data
  if(!this.current.methods.empty().not() and !this.current.type eq 'function') then

    !dtext.append('')
    !dtext.append('Returns ' & !this.current.methods.first().return())

    !dtext.append('Arguments:')
    !dtext.appendArray(!this.current.methods.first().arguments())

  endif

  -- If Members are defined
  if(!this.current.members.empty().not()) then
    !display = ARRAY()
    !dtext.append('')
    !dtext.append('Members:')
    do !i indices !this.current.members
      !display.append('  ' & !this.current.members[!i])
    enddo

    !display.sort()
    !dtext.appendArray(!display)

  endif

  -- Load definition
  !this.definition.dtext = !dtext

  -- Setup file menu
  !this.setupFileMenu()

  -- Select Method
  !this.selectMethod()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      selectMethod
--
-- Description: Select definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectMethod()

  -- Initialise Variables
  !dtext     = ARRAY()
  !rtext     = ARRAY()

  !this.methodDefinition.clear()

  -- Get selection
  !selection = !this.methods.val

  -- No methods
  if(!selection eq 0) then
    return
  endif

  -- Get method
  !method    = !this.current.methods[!selection]

  !dtext.append('Returns ' & !method.return())

  !dtext.append('Arguments:')
  !dtext.appendArray(!method.arguments())

  -- Update gadget
  !this.methodDefinition.dtext = !dtext

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      sortMethods
--
-- Description: Set sort for methods
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Sort method type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sortMethods(!sortType is STRING)

  -- Initialise Variables
  !this.methodSort = !sortType

  -- Sort by FILE
  if(!sortType eq 'file') then
    !this.menuMethods.select('File order', true)
    !this.menuMethods.select('Alphabetic', false)

  -- Sort by TYPE
  else
    !this.menuMethods.select('File order', false)
    !this.menuMethods.select('Alphabetic', true)

  endif

  -- Sort Methods
  !this.sortMethods()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      sortMethods
--
-- Description: Set sort
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sortMethods()

  -- Initialise Variables
  !selection = !this.methods.selection()
  !dtext     = !this.methods.dtext
  !rtext     = !this.methods.rtext

  -- Sort by FILE
  if(!this.methodSort eq 'file') then

    !block = object BLOCK('!rtext[!evalIndex].real()')
    !index = !rtext.evaluate(!block)
    !sort  = !index.sortedIndices()

  -- Sort by name
  else
    !sort  = !dtext.sortedIndices()
  endif

  !dtext.reIndex(!sort)
  !rtext.reIndex(!sort)

  !this.methods.dtext = !dtext
  !this.methods.rtext = !rtext

  !this.methods.select('RTEXT', !selection)
  handle ANY
  endhandle

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      fileView
--
-- Description: View the current file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fileView(!x is REAL, !y is REAL)

  -- Initialise Variables
  --!file     = !this.file()
  --!fullname = !file.fullname()

  -- Handle unselected files
  if(!this.current.file.unset()) then
    !!alert.warning('No definition file selected.')
    return
  endif

  !!pmlFileViewSize[1] = !x
  !!pmlFileViewSize[2] = !y

  -- Re load form using new size
  pml reload form !!pmlFileView

  -- Load form
  !!pmlFileView.setup(!this.current)

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      fileOpen
--
-- Description: Open the current file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Executable
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fileOpen(!executable is STRING)

  -- Initialise Variables
  !file     = !this.file()
  !fullname = !file.fullname()

  SYSCOM '$!<executable> $!<fullname> &'

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      fileShow
--
-- Description: Show form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fileShow()

  -- Initialise Variables
  !formName = '!!' & !this.current.name

  -- Show form
  show $!<formName>

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      fileHide
--
-- Description: Hide form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fileHide()

  -- Initialise Variables
  !formName = '!!' & !this.current.name

  -- Show form
  hide $!<formName>

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      fileKill
--
-- Description: Show form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fileKill()

  -- Initialise Variables
  !formName = '!!' & !this.current.name

  -- Show form
  kill $!<formName>

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      fileLoad
--
-- Description: Reload file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .fileLoad()

  -- Initialise Variables

  -- Reload form
  if(!this.current.type eq 'form') then

    !formName = '!!' & !this.current.name
    pml reload form $!<formName>

  -- Reload object
  elseif (!this.current.type eq 'object') then
    !objectName = !this.current.name
    pml reload object $!<objectName>

  endif

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      file
--
-- Description: Returns selected file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .file() is FILE

  -- Initialise Variables
  return !this.definition().file

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      globalVariable
--
-- Description: Show global variable form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .globalVariable()

  -- Initialise Variables

  -- Build form
  if(undefined(!!pmlVariable)) then
    pml reload form !!pmlVariable
  endif

  -- Show form
  if(!this.current.type eq 'form') then
    !formName = !this.current.name
    !!pmlVariable.setup(!formName)
  else
    !!pmlVariable.setup('')
  endif

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Returns selected definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .definition() is PMLDEFINITION

  -- Initialise Variables
  !selection  = !this.pmlDefinitions.selection('RTEXT')

  -- Get data
  !index      = !selection.part(1, '\').real()
  !type       = !selection.part(2, '\')
  !entry      = !selection.part(3, '\').real()

  return !this.attribute(!type)[!index][!entry]

endmethod
-- End of method
