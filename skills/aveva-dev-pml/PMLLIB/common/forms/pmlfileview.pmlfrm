-- Description:
-- test form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  line()                           -                   Move to specific line
--  pmlFileView()                    -                   Constructor
--  search(BOOLEAN)                  -                   Search for a specific string
--  setup(FILE)                      -                   setup
--  setup(PMLDEFINITION)             -                   setup
--  setup(STRING)                    -                   setup
--

setup form !!pmlFileView

  -- Form size
  if(defined(!!pmlFileViewSize)) then
    !x = !!pmlFileViewSize[1]
    !y = !!pmlFileViewSize[2]
  else
    !x = 80
    !y = 50
  endif

  !this.formTitle     = 'View File'
  !this.iconTitle     = ''
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.6 $ '

  -- Line number
  text   .line   'Line ' at xmin y0.15                     tooltip 'Move to line'  callback '!this.line()'       width 6  is REAL format !!integerFmt
  path right
  text   .search 'Search '                                 tooltip 'Search string' callback '!this.search(true)' width 16 is STRING
  button .up     at xmax ymin-0.15 pixmap height 3 width 7 tooltip 'Search up'     callback '!this.search(false)'
  button .down   at xmin ymax      pixmap height 3 width 7 tooltip 'Search down'   callback '!this.search(true)'

  toggle .case 'Match case' at xmax+0.5  ymin.line states 'false' 'true'

  -- Body of form definition
  list .records             at xmin.line ymax.line+0.15   callback '!this.line.val = !this.records.val' width $!<x> lines $!<y>

  -- Form members

  -- Pml File Definition
  member .definition  is PMLDEFINITION

exit
-- End of form definition

----------------------------------------------------------------------
--
-- Method:      pmlFileView
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pmlFileView()

  -- Icons
  !this.up.addPixmap(!!pml.getPathName('uparrow7x3.png'))
  !this.down.addPixmap(!!pml.getPathName('downarrow7x3.png'))

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: setup
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!definition is PMLDEFINITION)

  -- Initialise Variables

  -- Set current definition
  !this.definition = !definition

  -- Read the file, if required
  !this.definition.read()

  -- Form title
  !this.formTitle  = 'File - ' & !this.definition.file.fullname()

  -- Define popup menu
  if(!this.definition.methods.empty().not()) then

    if(defined(!this.menuMethods)) then
      !menu = !this.menuMethods
      !menu.clear()
    else
      !menu = !this.newMenu('menuMethods')
    endif

    do !i indices !this.definition.methods
      !menu.add('callback', !this.definition.methods[!i].definition, '!this.records.val = ' & !this.definition.methods[!i].start)
    enddo

    !this.records.setPopup(!this.menuMethods)
  else
    !this.records.removePopup()
  endif

  -- Read file
  !records = !this.definition.file.readFile()

  -- Add into text pane
  !this.records.dtext = !records

  -- Set line
  !this.line.val      = !this.records.val

  -- Show form
  !this.show()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: setup
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!filename is STRING)

  -- Initialise Variables
  !file = object FILE(!filename)

  -- Setup file
  !this.setup(!file)

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: setup
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!file is FILE)

  -- Initialise Variables
  !definition = object PMLDEFINITION(!file)

  -- Setup
  !this.setup(!definition)

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      line
--
-- Description: Move to specific line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .line()

  -- Initialise Variables

  -- Ignore unset lines
  if(!this.line.val.unset()) then
    return
  endif

  -- Check the number of lines
  !size = !this.records.dtext.size()
  if(!this.line.val gt !size) then
    !this.line.val    = !this.records.dtext.size()
  elseif (!this.line.val le 0) then
    !this.line.val    = 1
  endif

  -- Move to line
  !this.records.val   = !this.line.val
  !this.line.setFocus()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      search
--
-- Description: Search for a specific string
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Direction of search
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .search(!down is BOOLEAN)

  -- Initialise Variables
  !case  = !this.case.val
  !this.search.setFocus()

  -- Ignore no search
  if(!this.search.val.unset() or !this.search.val.trim().empty()) then
    return
  endif

  -- Search forward
  if(!down) then
    !index     = !this.records.val + 1
    !increment = 1
    !end       = !this.records.rtext.size()
    !text      = 'End of file'
  else
    !index     = !this.records.val - 1
    !increment = -1
    !end       = 1
    !text      = 'Beginning of file'
  endif
  !found       = false

  -- Loop until we reach the end
  do !i from !index to !end by !increment

    if(!case) then
      if(!this.records.rtext[!i].match(!this.search.val).boolean()) then
        !found = true
        break
      endif
    else
      if(!this.records.rtext[!i].upcase().match(!this.search.val.upcase()).boolean()) then
        !found = true
        break
      endif
    endif

  enddo

  -- Found
  if(!found) then
    !this.records.val = !i
    !this.line.val    = !i

  -- Alert
  else
    !!alert.warning(!text)
  endif

endmethod
-- End of method
