--     Keyword:     GEN
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Sep 28 9:48:16 BST 1999
--
--
-- Description:
-- Currently loaded PML forms
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arrayDefinition(ARRAY)           ARRAY               Returns array data definition
--  definition(ANY)                  ARRAY               Returns string of passed data type
--  displayToGadget(ANY,GADGET,ARRAY,STRING) -                   Define the display data and write to gadget
--  form()                           FORM                Selected form
--  formFile(FORM)                   FILE                Get the form definition file
--  load()                           -                   Load form
--  objectDefinition(ANY)            ARRAY               Returns object data definition
--  openForm()                       -                   Open the current form
--  pmlForms()                       -                   Constructor
--  select(GADGET,STRING)            -                   Select data element of current data
--  selectData(GADGET,STRING)        -                   Select Gadget/Member data and expand
--  selectForm()                     -                   Select Form
--  showForm()                       -                   Show the current form
--  sort(MENU,STRING)                -                   Set sort
--  viewForm()                       -                   View the current form
--

setup form !!pmlForms

  !this.formTitle     = 'Forms'
  !this.iconTitle     = 'Forms'
  !this.callback      = '!this.load()'
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.9 $ '

  -- Body of form definition
  -- List of Forms
  list   .forms   'Forms'          at xmin            y0.5           callback '!this.selectForm()'       width 50 length 17
  toggle .shown   'Only shown form'at xmax-size       ymax-0.5       callback '!this.load()'

  button .load    'Load'           at xmax.forms-size ymin.forms-0.4 callback '!this.load()'
  path left
  text   .filter  'Filter'                                           callback '!this.load()'             width 25 is STRING

  -- Gadgets of the form
  list   .gadget  'Form Gadgets'   at xmin.forms      ymax.forms     callback '!this.selectData('        width 50 length 15
  path down
  vdist 0

  -- Members of the form
  list   .member  'Form Members'                                     callback '!this.selectData('        width 50 length 15

  -- Properties of the form
  list   .properties 'Properties'  at xmax.forms      ymin.forms                                         width 70 length 17

  -- Gadget Properties
  list   .gadgetData 'Properties'  at xmax.gadget     ymin.gadget    callback '!this.select('            width 70 length 15

  -- Member Properties
  list   .memberData 'Properties'  at xmax.member     ymin.member    callback '!this.select('            width 70 length 15


  -- Form Members
  --   Available forms
  member .availableForms is ARRAY

  -- Sort criteria
  member .propertiesSort  is STRING
  member .gadgetSort      is STRING
  member .gadgetDataSort  is STRING
  member .memberSort      is STRING
  member .memberDataSort  is STRING

  -- Variable Paths
  member .gadgetPath      is ARRAY
  member .gadgetDataPath  is ARRAY
  member .memberPath      is ARRAY
  member .memberDataPath  is ARRAY

exit
-- End of form definition

----------------------------------------------------------------------
--
-- Method:      pmlForms
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pmlForms()

  -- Popup for form gadget
  !menu = !this.newMenu('menuForms')
    !menu.add('callback', 'View...',              '!this.viewForm()')
    !menu.add('callback', 'Show...',              '!this.showForm()')
    !menu.add('callback', 'Open...',              '!this.openForm()')

  !this.forms.setPopup(!this.menuForms)

  -- Sort Menus
  --   Properties
  !menu = !this.newMenu('menuProperties')
    !menu.add('toggle', 'Sort by Name',         '!this.sort(')
    !menu.add('toggle', 'Sort by Type',         '!this.sort(')

  !this.properties.setPopup(!this.menuProperties)
  !this.sort(!this.menuProperties, 'NAME')

  --   Gadgets
  !menu = !this.newMenu('menuGadget')
    !menu.add('toggle', 'Sort by Name',         '!this.sort(')
    !menu.add('toggle', 'Sort by Type',         '!this.sort(')

  !this.gadget.setPopup(!this.menuGadget)
  !this.sort(!this.menuGadget, 'NAME')

  --   Gadget Data
  !menu = !this.newMenu('menuGadgetData')
    !menu.add('toggle', 'Sort by Name',         '!this.sort(')
    !menu.add('toggle', 'Sort by Type',         '!this.sort(')

  !this.gadgetData.setPopup(!this.menuGadgetData)
  !this.sort(!this.menuGadgetData, 'NAME')

  --   Members
  !menu = !this.newMenu('menuMember')
    !menu.add('toggle', 'Sort by Name',         '!this.sort(')
    !menu.add('toggle', 'Sort by Type',         '!this.sort(')

  !this.member.setPopup(!this.menuMember)
  !this.sort(!this.menuMember, 'NAME')

  --   Member Data
  !menu = !this.newMenu('menuMemberData')
    !menu.add('toggle', 'Sort by Name',         '!this.sort(')
    !menu.add('toggle', 'Sort by Type',         '!this.sort(')

  !this.memberData.setPopup(!this.menuMemberData)
  !this.sort(!this.menuMemberData, 'NAME')


  -- Tool tips
  !this.load.setTooltip('Reload forms')
  !this.filter.setTooltip('Filter forms')

  -- Defaults
  !this.filter.val = '*'

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      load
--
-- Description: Load form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .load()

  -- Initialise Variables
  !forms            = ARRAY()
  !filter           = !this.filter.val.trim().upcase()

  -- Clear all lists
  !this.forms.clear()
  !this.properties.clear()
  !this.gadget.clear()
  !this.gadgetData.clear()
  !this.member.clear()
  !this.memberData.clear()

  -- Get forms
  if(!this.shown.val) then
    !foundForms     = !!fmSys.shownForms()
  else
    !foundForms     = !!fmSys.forms()
  endif

  -- Load all forms, i.e. filter of * or empty
  if(!filter.empty() or !filter eq '*') then
    !forms          = !foundForms

  -- Filter the forms
  else

    -- Sort for forms conforming to the filter
    do !i indices !foundForms
      skip if(!foundForms[!i].name().matchwild(!filter).not())
      !forms.append(!foundForms[!i])
    enddo

  endif

  -- If there are no forms, then return
  if(!forms.empty()) then
    !!alert.warning('No forms found.')
    return
  endif

  -- Get Data
  do !i indices !forms
    !formNames[!i]  = !forms[!i].name()
    !formTitles[!i] = !forms[!i].formTitle
  enddo

  -- Sort form names
  !sortIndex    = !formNames.sortedIndices()
  !formNames.reindex(!sortIndex)
  !formTitles.reindex(!sortIndex)
  !forms.reindex(!sortIndex)

  -- Get widths
  !nWidth       = !formNames.width()
  !tWidth       = !formTitles.width()

  -- Build display list
  do !i indices !formNames

    var !dprt COMPOSE space 2 '$!formNames[$!i]' width $!<nWidth> r space 2 '$!formTitles[$!i]'
    !dtext[!i]  = !dprt[1]
    !rtext[!i]  = !i.string()

  enddo

  -- Forms
  !this.availableForms = !forms
  !this.forms.dtext    = !dtext
  !this.forms.rtext    = !rtext

  -- Select Form
  !this.selectForm()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      selectForm
--
-- Description: Select Form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectForm()

  -- Initialise Variables
  !properties = ARRAY()
  !gadgets    = ARRAY()
  !members    = ARRAY()

  !this.gadgetData.clear()
  !this.memberData.clear()
  !this.gadgetDataPath.clear()
  !this.memberDataPath.clear()

  -- Form index
  !form       = !this.form()

  -- Get Path file has come form
  !file = !this.formFile(!form)

  -- If file is not defined, then grey-out the open/view gadgets
  if(!file.unset()) then
    !this.formTitle = 'Forms : ' & !form.name() & ' (Old style form)'

    !this.menuForms.clear()
    !menu = !this.menuForms
      !menu.add('callback', 'Show...',              '!this.showForm()')

  else
    !this.formTitle = 'Forms : ' & !form.name() & ' (' & !file.fullname() & ')'

    !this.menuForms.clear()
    !menu = !this.menuForms
      !menu.add('callback', 'Show...',              '!this.showForm()')
      !menu.add('callback', 'View...',              '!this.viewForm()')
      !menu.add('callback', 'Open...',              '!this.openForm()')
  endif

  -- Get Attributes
  !attributes = !form.attributes()

  -- Loop through attributes
  do !i indices !attributes

    !type      = !form.attribute(!attributes[!i]).objectType()

    -- Form Properties
    if(!type eq 'FMPROP') then
      !properties.append(!attributes[!i])

    -- Form Gadget
    elseif (!type inset ('GADGET','MENU')) then
      !gadgets.append(!attributes[!i])

    -- Form Member
    else
      !members.append(!attributes[!i])

    endif

  enddo

  -- Load Properties lists
  !this.displayToGadget(!form, !this.properties, !properties, !this.propertiesSort)

  -- Load gadgets list
  !this.displayToGadget(!form, !this.gadget, !gadgets, !this.gadgetSort)

  -- Load members list
  !this.displayToGadget(!form, !this.member, !members, !this.memberSort)

  -- Select Data for gadget and member
  !this.selectData(!this.gadget, '')
  !this.selectData(!this.member, '')

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      selectData
--
-- Description: Select Gadget/Member data and expand
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectData(!gadget is GADGET, !dummy is STRING)

  -- Initialise Variables
  !member     = !gadget.selection('RTEXT').part(2,'\')

  -- Form gadgets/members
  !dataGadget = !this.attribute(!gadget.name() & 'Data')
  !dataGadget.clear()

  -- Return if there is no member or it is empty
  if(!member.empty()) then
    return
  endif

  -- Empty dataPath
  !this.attribute(!gadget.name() & 'DataPath').clear()

  -- Get definition of object
  !definition = !this.objectDefinition(!this.form().attribute(!member))

  -- If there is not definition, then don't do anything
  if(!definition.empty()) then

    return
  endif

  -- Update Data Gadget
  !dataGadget.dtext = !definition[1]
  !dataGadget.rtext = !definition[2]

  -- Set data path
  !this.attribute(!gadget.name() & 'DataPath').append(!this.form().attribute(!member))

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select data element of current data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!gadget is GADGET, !dummyString is STRING)

  -- Initialise Variables
  !member     = !gadget.selection('RTEXT').part(2,'\')

  -- If member is a number, then we are looking at an element of an array
  !index      = !member.real()

  -- Get Attribute
  handle ANY
    !data = !this.attribute(!gadget.name() & 'Path').last().attribute(!member)

  -- Get Member of array
  elsehandle NONE

    !data = !this.attribute(!gadget.name() & 'Path').last()[!index]
    -- Return if there is an error, including the case when !index isn't an integer (it can be 'unset')
    handle ANY
      return
    endhandle

  endhandle

  !definition = !this.objectDefinition(!data)

  -- Return if there is no definition
  if(!definition.empty()) then
    return
  endif

  -- Remember data
  !this.attribute(!gadget.name() & 'Path').append(!data)

  -- Update the gadgets
  !gadget.dtext = !definition[1]
  !gadget.rtext = !definition[2]


endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      sort
--
-- Description: Set sort
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sort(!menu is MENU, !select is STRING)

  -- Initialise Variables
  !name = !menu.name()

  -- Used passed sort type
  if(!select inset('NAME','TYPE')) then
    !sort = !select

  -- User picked menu field
  else
    !sort = !menu.pickedField.part(-1).upcase()
  endif

  -- Sort by NAME
  if(!sort eq 'NAME') then
    !menu.select('Sort by Name', true)
    !menu.select('Sort by Type', false)

  -- Sort by TYPE
  elseif (!sort eq 'TYPE') then
    !menu.select('Sort by Name', false)
    !menu.select('Sort by Type', true)

  endif

  -- Get Gadget Names
  !gadgetName  = !name.after('MENU').upcase()
  !gadget      = !this.attribute(!gadgetName)

  -- Set the sort member
  !this.attribute(!gadgetName & 'Sort') = !sort

  -- If there are no forms, then we must be initialising the form
  if(!this.availableForms.empty() or !gadget.dtext.empty()) then
    return
  endif

  -- Get current display and replacement text
  !dtext       = !gadget.dtext
  !rtext       = !gadget.rtext

  -- If there is no data, then don't bother doing any sorts

  -- Split rtext into type/name
  do !i indices !rtext
    !types[!i] = !rtext[!i].part(1,'\')
    !names[!i] = !rtext[!i].part(2,'\')
  enddo

  -- Sort by name
  if(!sort eq 'NAME') then
    !sortIndex = !names.sortedIndices()

  -- Sort by type
  elseif (!sort eq 'TYPE') then
    !sortIndex = !types.sortedIndices()
  endif

  -- Regenerate text
  !dtext.reindex(!sortIndex)
  !rtext.reindex(!sortIndex)

  -- Update gadget
  !gadget.dtext = !dtext
  !gadget.rtext = !rtext

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      formFile
--
-- Description: Get the form definition file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form to get file for
-- Return:
--   [Data Type] [Description]
--    FILE        Definition file of form
--
------------------------------------------------------------------------

define method .formFile(!form is FORM) is FILE

  -- Path name
  !formPath = !!pml.getPathName(!form.name().lowcase() & '.pmlfrm')
  handle ANY
    return object FILE()
    return
  endhandle

  -- Return file
  return object FILE(!formPath)

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      viewForm
--
-- Description: View the current form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .viewForm()

  -- Initialise Variables
  !form = !this.form()

  -- Path name
  !formPath = !!pml.getPathName(!form.name().lowcase() & '.pmlfrm')
  handle ANY
    !!alert.warning('Unable to open form ' & !form.name() & ' is in the OLD PDMSUI directory hierarchy.')
    return
  endhandle

  -- Check pml file view is loaded
  if(undefined(!!pmlFileView)) then
    pml reload form !!pmlFileView
  endif

  -- Load form
  !!pmlFileView.setup(!formPath)

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      showForm
--
-- Description: Show the current form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showForm()

  -- Initialise Variables
  !form = !this.form()

  -- Show form
  !form.show()
  handle ANY
  endhandle

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      openForm
--
-- Description: Open the current form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .openForm()

  -- Initialise Variables
  !form = !this.form()

  -- Path name
  !formPath = !!pml.getPathName(!form.name().lowcase() & '.pmlfrm')
  handle ANY
    !!alert.warning('Unable to open form ' & !form.name() & ' is in the OLD PDMSUI directory hierarchy.')
    return
  endhandle

  -- Open file
  syscom 'PFE32.EXE $!<formPath> &'

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      form
--
-- Description: Selected form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .form() is FORM
  return !this.availableForms[!this.forms.selection('RTEXT').real()]
endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      displayToGadget
--
-- Description: Define the display data and write to gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayToGadget(!reference is ANY, !gadget is GADGET, !passedAttributes is ARRAY, !sortType is STRING)

  -- Initialise Variables
  !attributes         = !passedAttributes
  !data[1]            = STRING()

  !displayName        = ARRAY()
  !displayType        = ARRAY()
  !displayDescription = ARRAY()

  -- Clear Gadget
  !gadget.clear()

  -- If there are no attribute, then return
  if(!attributes.empty()) then
    return
  endif

  -- Loop through the attributes
  do !attribute values !attributes

    !definition  = !this.definition(!reference.attribute(!attribute))

    !description = !definition[1]
    !dataType    = !definition[3]

    !displayName.append(!attribute)
    !displayType.append(!dataType)
    !displayDescription.append(!description)

  enddo

  -- Display Data
  !dtext        = ARRAY()
  !rtext        = ARRAY()

  -- Get Width
  !nWidth       = !displayName.width()
  !tWidth       = !displayType.width() + 2

  -- Sort
  if(!sortType eq 'NAME') then
    !sortIndex  = !displayName.sortedIndices()
  elseif(!sortType eq 'TYPE') then
    !sortIndex  = !displayType.sortedIndices()
  endif

  !displayName.reindex(!sortIndex)
  !displayType.reindex(!sortIndex)
  !displayDescription.reindex(!sortIndex)

  -- Compose the display text
  do !i indices !displayName
    var !dprt COMPOSE space 1 |$!displayName[$!i]| width $!<nWidth> r space 1 |<$!displayType[$!i]>| width $!<tWidth> l space 1 |$!displayDescription[$!i]|
    !dtext.append(!dprt[1])
    !rtext.append(!displayType[!i] & '\' & !displayName[!i])
  enddo

  -- Load gadget
  !gadget.dtext = !dtext
  !gadget.rtext = !rtext

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      objectDefinition
--
-- Description: Returns object data definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] Display text as array of strings
--                [2] Replacement text as array of strings
--
------------------------------------------------------------------------

define method .objectDefinition(!object is ANY) is ARRAY

  -- Initialise Variables
  !results         = ARRAY()
  !dataAttributes  = ARRAY()
  !dataTypes       = ARRAY()
  !dataDefinitions = ARRAY()

  -- Get Object data
  !definition      = !this.definition(!object)

  -- If true type of object if ARRAY, then get array data
  if(!definition[3] eq 'ARRAY') then
    return !this.arrayDefinition(!object)
  endif

  -- Get the attributes of the object
  !attributes   = !object.attributes()
  handle ANY
    return ARRAY()
  endhandle

  -- Loop through the attributes
  do !attribute values !attributes
    !definition          = !this.definition(!object.attribute(!attribute))
    !dataAttributes.append(!attribute)
    !dataDefinitions.append(!definition[1])
    !dataTypes.append(!definition[3])
  enddo

  -- Get widths
  !aWidth = !dataAttributes.width()
  !dWidth = !dataTypes.width() + 2

  do !i indices !dataTypes
    !description = !dataDefinitions[!i]
    !description = !description.replace('|','||')
    var !dprt compose space 1 |$!dataAttributes[$!i]| width $!<aWidth> r space 1 |<$!dataTypes[$!i]$n>| width $!<dWidth> l space 1 |$!description|
    !results[1][!i] = !dprt[1]
    !results[2][!i] = !dataTypes[!i] & '\' & !dataAttributes[!i]
  enddo

  -- Return
  return !results

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      arrayDefinition
--
-- Description: Returns array data definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] Display text as array of strings
--                [2] Replacement text as array of strings
--
------------------------------------------------------------------------

define method .arrayDefinition(!referenceArray is ARRAY) is ARRAY

  -- Initialise Variables
  !dataTypes       = ARRAY()
  !dataDefinitions = ARRAY()

  -- Return if there are no element
  if(!referenceArray.empty()) then
    return ARRAY()
  endif

  -- Loop through the attributes
  do !i indices !referenceArray
    !definition          = !this.definition(!referenceArray[!i])
    !dataDefinitions[!i] = !definition[1]
    !dataTypes[!i]       = !definition[3]
  enddo

  -- Get widths
  !dWidth = !dataTypes.width()   + 2

  do !i indices !dataTypes
    var !dprt compose space 1 |[$!i]| width 6 r space 1 |<$!dataTypes[$!i]$n>| width $!<dWidth> c space 1 |$!dataDefinitions[$!i]|
    !results[1][!i] = !dprt[1]
    !results[2][!i] = !dataTypes[!i] & '\' & !i
  enddo

  -- Return
  return !results

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Returns string of passed data type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] String result of passed data
--                [2] Initial data type of element (GADGET or FMPROP)
--                [3] True data type (REAL, STRING, etc.)
--
------------------------------------------------------------------------

define method .definition(!data is ANY) is ARRAY

  -- Initialise Variables
  !dataType   = !data.objectType()
  !results    = ARRAY()
  !results[2] = !dataType
  !results[3] = !dataType

  -- Special case for clip box objects as we have a .set() method in them
  -- that does other thing, other than check to see if the object is set.
  if(!dataType inset('GPHCLIPBOX','CLIPBOX')) then
    !results[1] = ''
    return !results
  endif

  -- Return if not data passed
  if(!data.unset()) then
    !results[1] = 'Unset'
    return !results
  endif

  -- Menu
  if(!dataType eq 'MENU') then

    if(!data.set()) then
      !description = ''
    else
      !description = '<unset>'
    endif

  -- Gadget
  elseif (!dataType eq 'GADGET') then

    -- Determine the gadget type
    if(!data.set()) then

      -- Special case for the main bar menu
      if(!data.name() inset('BAR')) then
        !dataType      = 'MAIN BAR'
        !description   = ''

      else

        -- Gadget type
        !gadgetType    = !data.type()

        -- Special case for bar menu
        if(!gadgetType inset('BAR','MENU')) then
          !dataType    = !gadgetType
          !description = ''

        -- Get Description
        else
          !dataType      = !gadgetType

          !description   = !data.tag
          handle ANY
            !description = ''
          endhandle

          -- If tag is same as name, then don't show it
          if(!description eq !gadgetType) then
            !description = ''
          else
            !description = '"' & !description & '"'
          endif

        endif

      endif

    -- Data is unset
    else
      !description = '<unset>'
    endif


    if(!data.set()) then
      !description = !data.name()
    else
      !description = '<unset>'
    endif

  -- Form
  elseif (!dataType eq 'FORM') then

    if(!data.set()) then
      !description = !data.name()
    else
      !description = '<unset>'
    endif

  -- Array
  elseif (!dataType inset('ARRAY')) then
    !description   = !data.size().string()

  -- Any other object type
  else

    if(!data.set()) then
      !description = !data.string()
    else
      !description = '<unset>'
    endif

  endif

  -- Define the true data type
  !results[3]  = !dataType

  -- Replace any dollars
  !description = !description.replace('$$','$$$$')
  !results[1]  = !description.trim()

  -- Return
  return !results

endmethod
-- End of method
