--
--
-- Description:
--   Pml Variable Browser
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arrayDefinition(STRING,ARRAY,REAL) ARRAY               Returns array data definition
--  definition(ANY)                  ARRAY               Returns string of passed data type
--  objectDefinition(STRING,ANY,REAL) ARRAY               Returns object data definition
--  pmlVariable()                    -                   constructor
--  select()                         -                   Select member of Variable
--  setup()                          -                   Load form with variable
--  setup(STRING)                    -                   Load form with variable
--

setup form !!pmlVariable dialog dock

  !this.formTitle     = 'PML Variable'
  !this.iconTitle     = 'PML Var'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.9 $ '

  -- Variable
  button .reload    'Variable'                                      callback '!this.setup()'
  path right
  text .variable    anchor left + right + top                       callback '!this.setup()'  width 46 is STRING
  option .sort      'Sort' anchor right + top                       callback '!this.setup()'  width 4

  -- Definition
  --paragraph .definition anchor right + top                          width 40 lines 1

  -- Variable Data
  list .members anchor all    at xmin.reload ymax+0.2               callback '!this.select()' columns single zeroSelection width 70 length 40

  -- Form Member

  -- Variable Name
  member .name          is STRING

  -- Path name
  member .file          is FILE

  -- Indent
  member .indent        is REAL

  -- Definition of variable
  member .data          is ARRAY

  -- Member Name
  member .member        is ARRAY
  member .type          is ARRAY
  member .value         is ARRAY
  member .depth         is ARRAY
  member .fullname      is ARRAY

  -- Last selection
  member .lastSelection is STRING

exit
-- End of form definition

----------------------------------------------------------------------
--
-- Method:      pmlVariable
--
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pmlVariable()

  -- Initialise Variables
  !this.variable.val  = 'ce'

  !this.indent        = 4

   -- Header
  !headings[1]        = 'Name'
  !headings[2]        = 'Type'
  !headings[3]        = 'Value'
  !this.members.setHeadings(!headings)

  -- Sort options
  !dtext[1]           = 'Name'
  !dtext[2]           = 'Type'
  !this.sort.dtext    = !dtext

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Load form with variable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!variable is STRING)

  -- Initialise Variables
  !this.variable.val = !variable

  -- Setup
  !this.setup()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Load form with variable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Initialise Variables
  !variableName           = !this.variable.val

  -- Initialise Data
  !this.name              = ''
  !this.formTitle         = 'PML Variable'
  !this.members.clear()
  !this.data.clear()

  -- Check for unset name
  if(!variableName.unset() or !variableName.empty()) then
    !this.show()
    return
  endif

  -- Get variable name (remove any ! from the name) and add !!
  !name                   = !variableName.replace('!','').trim()
  !variableName           = '!!' & !name

  -- Check for variable
  if(undefined($!<variableName>)) then
    !!alert.warning('Variable ' & !variableName & ' is undefined.')
    return
  endif

  -- Set form variables
  !this.name              = !variableName

  -- Set variable to variable
  !this.data[1]           = $!<variableName>

  -- Get Data Type
  !dataType               = !this.data[1].objectType()

  -- If object type if FORM, then see if its a "new" pml form
  if(!dataType eq 'FORM') then

    !path                 = !!pml.getPathName(!name.lowcase() & '.pmlfrm')
    -- Old style form
    handle ANY
      !title              = 'Form defined in the %PDMSUI% Appware structure'

    -- New form definition
    elsehandle NONE
      !file               = object FILE(!path)
      !title              = 'PML Form - File (' & !file.entry() & ')'
    endhandle

  -- See if variable if user defined data type
  else

    !path                 = !!pml.getPathName(!dataType.lowcase() & '.pmlobj')

    -- Standard Object definition
    handle ANY
      !title              = 'PDMS data type ' & !dataType

    -- User defined object
    elsehandle NONE
      !file               = object FILE(!path)
      !title              = 'PML object '  & !dataType & ' - File (' & !file.entry() & ')'
    endhandle

  endif

  !this.formTitle         = !title

  -- Select
  !this.select()

  -- Show form
  !this.show()

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select member of Variable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select()

  -- Initialise Variables
  !selection              = !this.members.selection()
  !this.lastSelection     = !selection

  -- If selection is empty, then we will populate with the variable
  if(!selection.empty()) then

    !definition           = !this.objectDefinition(!this.name, !this.data[1], 0)

    -- Populate array
    if(!definition.empty().not()) then
      !this.member        = !definition[1]
      !this.type          = !definition[2]
      !this.value         = !definition[3]
      !this.fullname      = !definition[4]
      !this.depth         = !definition[5]

      !columns[1]         = !definition[1]
      !columns[2]         = !definition[2]
      !columns[3]         = !definition[3]
      !this.members.setColumns(!columns)
      !this.members.rtext = !this.fullname

    endif

  -- Get members of object
  else
    !index                = !this.members.val
    !next                 = !index + 1
    !max                  = !this.members.dtext.size()
    !open                 = true

    -- If next elements depth is gt then current, then we are opening
    if(!next.lt(!this.depth.size())) then
      !open               = !this.depth[!index].geq(!this.depth[!next])
      !close              = !open.not()
    endif

    -- Open branch
    if(!open) then

      -- Get Definition
      !variable           = !this.fullname[!index].substring(!this.name.length() + 2)
      !data               = $!<this.fullname[$!<index>]>
      !definition         = !this.objectDefinition(!this.fullname[!index], !data, !this.depth[!index] + 1)

      -- Insert array
      if(!definition.empty().not().and(!variable.neq('USERDATA'))) then
        !this.member.insertArray(!next, !definition[1])
        !this.type.insertArray(!next, !definition[2])
        !this.value.insertArray(!next, !definition[3])
        !this.fullname.insertArray(!next, !definition[4])
        !this.depth.insertArray(!next, !definition[5])
        !columns[1]       = !this.member
        !columns[2]       = !this.type
        !columns[3]       = !this.value
        !this.members.setColumns(!columns)
        !this.members.rtext = !this.fullname
      endif

    -- Close branch
    elseif (!close) then
      !depths             = !this.depth
      !depths.append(0)

      -- Identify the next equal or higher level to collapse to
      -- slow method until I find a better more robust solution
      !end                = !max
      do !i from !next to !max + 1
        if(!depths[!i].leq(!depths[!index])) then
          !end            = !i
          break
        endif
      enddo

      -- Get the next depth equal to current
      --!sameDepth          = !this.depth.find(!this.depth[!index])
      --!sameIndex          = !sameDepth.findFirst(!index)
      --!sameDepthSize      = !sameDepth.size()

      -- If sameIndex is same as same depth then ?
      --if(!sameIndex.eq(!sameDepthSize)) then
      --  !end              = !sameDepth[!sameIndex] + 1
      --else
      --  !end              = !sameDepth[!sameIndex + 1]
      --endif
      !from               = !next
      !to                 = !end - !from

      -- Remove from list
      !this.member.removeFrom(!from, !to)
      !this.type.removeFrom(!from, !to)
      !this.value.removeFrom(!from, !to)
      !this.fullname.removeFrom(!from, !to)
      !this.depth.removeFrom(!from, !to)

      !columns[1]       = !this.member
      !columns[2]       = !this.type
      !columns[3]       = !this.value
      !this.members.setColumns(!columns)
      !this.members.rtext = !this.fullname

    endif

    !this.members.setFocus()
    !this.members.select('RTEXT',!selection)
    handle ANY
      QUERY VAR!!error.text
    endhandle

  endif

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      objectDefinition
--
-- Description: Returns object data definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name of member
--    2   R      ANY         Object
--    3   R      REAL        Depth
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] Attribute name
--                [2] Data type
--                [3] Value
--                [4] Full name
--                [5] Depth
--
------------------------------------------------------------------------

define method .objectDefinition(!name is STRING, !object is ANY, !depth is REAL) is ARRAY

  -- Initialise Variables
  !results                = ARRAY()
  !dataAttributes         = ARRAY()
  !dataTypes              = ARRAY()
  !dataDefinitions        = ARRAY()

  -- Get Object data
  !definition             = !this.definition(!object)

  -- If true type of object if ARRAY, then get array data
  if(!definition[3] eq 'ARRAY') then
    return !this.arrayDefinition(!name, !object, !depth)
  endif

  -- Get the attributes of the object
  !attributes             = !object.attributes()
  handle ANY
    return ARRAY()
  endhandle

   -- Indent
  !tab                    = !depth * !this.indent
  !tabString              = substring('                                                                                                                                        ' ,1 ,!tab)

  -- Loop through the attributes
  do !attribute values !attributes
    !definition           = !this.definition(!object.attribute(!attribute))
    !dataAttributes.append(!attribute)
    !dataDefinitions.append(!definition[1])
    !dataTypes.append(!definition[3])
  enddo

  -- Sort into order
  if(!this.sort.selection().eq('Name')) then
  !sortIndex              = !dataAttributes.sortedIndices()
  else
    !sortIndex            = !dataTypes.sortedIndices()
  endif
  !dataAttributes.reindex(!sortIndex)
  !dataDefinitions.reindex(!sortIndex)
  !dataTypes.reindex(!sortIndex)

  !results[2]             = !dataTypes
  !results[3]             = !dataDefinitions

  do !i indices !dataTypes
    !results[1][!i]       = !tabString & !dataAttributes[!i]
    !results[4][!i]       = !name & '.' & !dataAttributes[!i]
    !results[5][!i]       = !depth
  enddo

  -- Return
  return !results

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      arrayDefinition
--
-- Description: Returns array data definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name of member
--    2   R      ARRAY       Array information
--    3   R      REAL        Depth
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] Attribute name
--                [2] Data type
--                [3] Value
--                [4] Full name
--                [5] Depth
--
------------------------------------------------------------------------

define method .arrayDefinition(!name is STRING, !referenceArray is ARRAY, !depth is REAL) is ARRAY

  -- Initialise Variables
  !dataTypes              = ARRAY()
  !dataDefinitions        = ARRAY()

  -- Return if there are no element
  if(!referenceArray.empty()) then
    return ARRAY()
  endif

  -- Indent
  !tab                    = !depth * !this.indent
  !tabString              = substring('                                                                                                                                        ' ,1 ,!tab)

  -- Loop through the attributes
  do !i indices !referenceArray
    !definition           = !this.definition(!referenceArray[!i])
    !dataAttributes[!i]   = !tabString & '[' & !i & ']'
    !dataDefinitions[!i]  = !definition[1]
    !dataTypes[!i]        = !definition[3]
  enddo

  !results[1]             = !dataAttributes
  !results[2]             = !dataTypes
  !results[3]             = !dataDefinitions

  do !i indices !dataTypes
    !results[4][!i]       = !name & '[' & !i & ']'
    !results[5][!i]       = !depth
  enddo

  -- Return
  do !i indices !results
    !results[!i].compress()
  enddo

  return !results

endmethod
-- End of method

----------------------------------------------------------------------
--
-- Method:      definition
--
-- Description: Returns string of passed data type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] String result of passed data
--                [2] Initial data type of element (GADGET or FMPROP)
--                [3] True data type (REAL, STRING, etc.)
--
------------------------------------------------------------------------

define method .definition(!data is ANY) is ARRAY

  -- Initialise Variables
  !dataType               = !data.objectType()
  !results                = ARRAY()
  !results[2]             = !dataType
  !results[3]             = !dataType

  -- Special case for clip box objects as we have a .set() method in them
  -- that does other thing, other than check to see if the object is set.
  if(!dataType inset('GPHCLIPBOX','CLIPBOX')) then
    !results[1]           = ''
    return !results
  endif

  -- Return if not data passed
  if(!data.unset()) then
    !results[1]           = 'Unset'
    return !results
  endif

  -- Menu
  if(!dataType eq 'MENU') then

    if(!data.set()) then
      !description        = ''
    else
      !description        = '<unset>'
    endif

  -- Gadget
  elseif (!dataType eq 'GADGET') then

    -- Determine the gadget type
    if(!data.set()) then

      -- Special case for the main bar menu
      if(!data.name() inset('BAR')) then
        !dataType         = 'MAIN BAR'
        !description      = ''

      else

        -- Gadget type
        !gadgetType       = !data.type()

        -- Special case for bar menu
        if(!gadgetType inset('BAR','MENU')) then
          !dataType       = !gadgetType
          !description    = ''

        -- Get Description
        else
          !dataType       = !gadgetType

          !description    = !data.tag
          handle ANY
            !description  = ''
          endhandle

          -- If tag is same as name, then don't show it
          if(!description eq !gadgetType) then
            !description  = ''
          else
            !description  = '"' & !description & '"'
          endif

        endif

      endif

    -- Data is unset
    else
      !description        = '<unset>'
    endif


    if(!data.set()) then
      !description        = !data.name()
    else
      !description        = '<unset>'
    endif

  -- Form
  elseif (!dataType eq 'FORM') then

    if(!data.set()) then
      !description        = !data.name()
    else
      !description        = '<unset>'
    endif

  -- Array
  elseif (!dataType inset('ARRAY')) then
    !description          = !data.size().string()

  -- Any other object type
  else

    if(!data.set()) then
      !description        = !data.string()
    else
      !description        = '<unset>'
    endif

  endif

  -- Define the true data type
  !results[3]             = !dataType

  -- Replace any dollars
  !description            = !description.replace('$$','$$$$')
  !results[1]             = !description.trim()

  -- Return
  return !results

endmethod
-- End of method
