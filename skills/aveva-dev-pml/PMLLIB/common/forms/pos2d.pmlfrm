--
-- File:            pos2d.pmlfrm
--   Type:          Form Definition
--   Group:         2D Positioning

--     Keyword:     POS2D
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jan 24 9:27:03 "GMT 2000
--
--
-- Description:
-- Generic 2D Positioning form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Action on picking
--  close()                          -                   Close form
--  pos2D()                          -                   Constructor
--  position()                       POSITION            Return position
--  preview()                        -                   Preview position (tag it)
--  recursive(BOOLEAN)               -                   Setup forms OK/Apply Cancel/Dismiss buttons
--  setPosition(EDGPOSITIONDATA)     -                   Redefine start position
--  setup(STRING,PLANE,XYPOSITION,STRING,STRING) -                   Setup form as standard position/OK form
--  setup(STRING,PLANE,XYPOSITION,STRING,STRING,BOOLEAN,STRING) -                   Setup form as standard position passing recursive flag (Apply = true, OK = false)
--
------------------------------------------------------------------------

setup form !!pos2D

  !this.formTitle     = '2D Position'
  !this.iconTitle     = ''
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition

  path down
  option .ew at x1 y1 width 5
  option .ns width 5
  text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
  text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
  toggle .xFlag at xmax+1 ymin.ew
  toggle .yFlag at xmin   ymin.ns

  para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'

  -- Apply/Dismiss
  button .apply    'Apply'   at xmin form-0    ymax form+0.5 callback '!this.apply()'
  button .dismiss  'Dismiss' at xmax form-size ymin          callback '!this.close()' ok

  -- Aid numbers for position & axes
  member .aidNumber      is REAL

  -- Reference plane
  member .plane          is PLANE

  -- Position
  member .xyPosition     is XYPOSITIONLINK

 -- Tag
  member .tag            is STRING
  -- Action
  member .action         is STRING

  -- Recursive
  member .recursive      is BOOLEAN

  -- EDG Description
  member .description    is STRING

exit
-- End of form definition for !!pos2D


------------------------------------------------------------------------
--
-- Method:      pos2D
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pos2D()


  -- Link Position Input Gadgets to Objects
  !this.xyPosition.linkInput('!!pos2D.xyPosition', !this.x, !this.y)

  -- Link Position Lock Gadgets to Objects
  !this.xyPosition.linkLock('!!pos2D.xyPosition', !this.xFlag, !this.yFlag)

  -- Link Position Option Gadgets to Objects
  !this.xyPosition.linkOption('!!pos2D.xyPosition', !this.ew, !this.ns, 'XY')

  -- Set Position Action
  !this.xyPosition.setAction('!!pos2D.preview()')

  -- Aid Lines Number
  !this.aidNumber = !!aidNumbers.add('Position')

  -- Set defaults for form
  !this.xyPosition.xyPosition(object XYPOSITION(0,0), false, true)

  -- Set action buttons
  !this.recursive(false)

endmethod
-- End of method definition for .pos2D()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form as standard position/OK form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on OK
--    2   R      PLANE       Reference plane
--    3   R      POSITION    Default position
--    4   R      STRING      Prompt
--    5   R      STRING      Tag on picking
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!action is STRING, !plane is PLANE, !xyPosition is XYPOSITION, !prompt is STRING, !tag is STRING)

  !this.setup(!action, !plane, !xyPosition, !prompt, !tag, false, 'Define Position')

endmethod
-- End of method definition for .setup(STRING, PLANE, XYPOSITION, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form as standard position passing recursive flag (Apply = true, OK = false)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on OK
--    2   R      PLANE       Reference plane
--    3   R      POSITION    Default position
--    4   R      STRING      Prompt
--    5   R      STRING      Tag on picking
--    6   R      BOOLEAN     True if Apply (recursive
--    7   R      STRING      Packet description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!action is STRING, !plane is PLANE, !xyPosition is XYPOSITION, !prompt is STRING, !tag is STRING, !recursive is BOOLEAN, !description is STRING)

  -- Set up form
  !this.recursive(!recursive)

  -- Define packet for section creation
  !packet                = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.action         = '!!pos2D.setPosition(!this.return[1])'
  !packet.key            = 'pos2D'
  !packet.description    = !description
  !this.description      = !description
  !packet.type           = 'pos2D'
  !packet.priority       = 1
  !packet.close          = '!!aidNumbers.hide(!!pos2D.aidNumber)'
  !packet.remove         = false
  !packet.form           = !!pos2D

  -- Add to system
  if(!!edgCntrl.add(!packet)) then

    -- Set the plane
    !this.plane     = !plane

    -- Form title (same a prompt)
    !this.formTitle = !prompt

    -- Define callback action
    !this.action    = !action

    -- Tag
    !this.tag       = !tag

    -- Assign passed position
    !this.xyPosition.xyPosition(!xyPosition, true, true)

  endif

endmethod
-- End of method definition for .setup(STRING, PLANE, XYPOSITION, STRING, STRING, BOOLEAN, STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Hide Aid number
  !!aidNumbers.hide(!this.aidNumber)

  -- Remove event
  !!edgCntrl.remove(!this.description)

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Action on picking
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Get positions
  !xyPosition = !this.xyPosition.xyPosition()
  !position   = !this.position()

  -- Carry out action
  $!<this.action>
  handle any
  endhandle

  -- Close form down
  if(!this.recursive.not()) then
    !this.close()
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview position (tag it)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Initialise Variables
  !position = !this.plane.threeDPosition(!this.xyPosition.xyPosition())

  -- Tag position
  !!aidNumbers.hide(!this.aidNumber)
  AID TEXT NUMBER $!<this.aidNumber> '$!this.tag' AT $!<position>

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Redefine start position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition(!data is EDGPOSITIONDATA)

  -- Define position
  !xyPosition = !this.plane.xyOffset(!data.position)
  !this.xyPosition.xyPosition(!xyPosition, true, false)

endmethod
-- End of method definition for .setPosition(EDGPOSITIONDATA)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Return position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Define position
--
------------------------------------------------------------------------

-- Define method
define method .position() is POSITION

  !xyPosition = !this.xyPosition.xyPosition()
  !position   = !this.plane.threeDPosition(!xyPosition)
  return !position

endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      recursive
--
-- Description: Setup forms OK/Apply Cancel/Dismiss buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Recursion flag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .recursive(!flag is BOOLEAN)

  -- Initialise Variables
  !this.recursive = !flag

  -- Set OK/Apply Cancel/Dismiss buttons
  if(!flag) then
    !this.apply.tag   = 'Apply'
    !this.dismiss.tag = 'Dismiss'
  else
    !this.apply.tag   = ' OK '
    !this.dismiss.tag = 'Cancel'
  endif

endmethod
-- End of method definition for .recursive(BOOLEAN)
