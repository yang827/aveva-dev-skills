--
-- File:            pos2drelative.pmlfrm
--   Type:          Form Definition
--   Group:         2D Positioning

--     Keyword:     POS2D
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jan 24 9:27:03 "GMT 2000
--
--
-- Description:
-- Generic 2D Positioning form
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Action on picking
--  close()                          -                   Close form
--  pos2DRelative()                  -                   Constructor
--  preview()                        -                   Preview position (tag it)
--  recursive(BOOLEAN)               -                   Setup forms OK/Apply Cancel/Dismiss buttons
--  setup(STRING,PROFILE,STRING,STRING) -                   Setup form as standard position/OK form
--  setup(STRING,PROFILE,STRING,STRING,BOOLEAN,STRING) -                   Setup form as standard position passing recursive flag (Apply = true, OK = false)
--  xyPosition()                     XYPOSITION
--
------------------------------------------------------------------------

setup form !!pos2DRelative

  !this.formTitle     = '2D Relative'
  !this.iconTitle     = ''
  !this.callback      = ''
  !this.cancelCall    = '!this.close()'
  !this.formRevision  = ' $Revision: 1.4 $ '

  -- Body of form definition
  text .x 'X ' at x1 ymax width 14 is REAL format !!distanceFmt
  path down
  halign right
  text .y 'Y '       width 14 is REAL format !!distanceFmt

  -- Apply/Dismiss
  button .apply    'Apply'   at xmin form-0    ymax form+0.5 callback '!this.apply()'
  button .dismiss  'Dismiss' at xmax form-size ymin          callback '!this.close()' ok

  -- Aid numbers for position & axes
  member .aidNumber      is REAL

  -- Reference plane
  member .plane          is PLANE

  -- Profile to show change
  member .profile        is PROFILE

 -- Tag
  member .tag            is STRING
  -- Action
  member .action         is STRING

  -- Recursive
  member .recursive      is BOOLEAN

  -- EDG Description
  member .edgDescription    is STRING

exit
-- End of form definition for !!pos2DRelative


------------------------------------------------------------------------
--
-- Method:      pos2DRelative
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pos2DRelative()

  -- Setup callback
  !this.x.callback = '!this.preview()'
  !this.y.callback = '!this.preview()'

  -- Aid Lines Number
  !this.aidNumber  = !!aidNumbers.add('Position')

  -- Set action buttons
  !this.recursive(false)

endmethod
-- End of method definition for .pos2DRelative()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form as standard position/OK form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on OK
--    2   R      PROFILE     Reference profile
--    3   R      STRING      Prompt
--    4   R      STRING      Tag on picking
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!action is STRING, !profile is PROFILE, !prompt is STRING, !tag is STRING)

  !this.setup(!action, !profile, !prompt, !tag, false, 'Define XY Offset')

endmethod
-- End of method definition for .setup(STRING, PROFILE, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form as standard position passing recursive flag (Apply = true, OK = false)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on OK
--    2   R      PROFILE     Reference profile
--    3   R      STRING      Prompt
--    4   R      STRING      Tag on picking
--    5   R      BOOLEAN     True if Apply (recursive
--    6   R      STRING      Packet description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!action is STRING, !profile is PROFILE, !prompt is STRING, !tag is STRING, !recursive is BOOLEAN, !description is STRING)

  -- Set up form
  !this.recursive(!recursive)

  -- Set profile
  !this.profile        = object PROFILE(!profile)

  -- Set the plane
  !this.plane          = !profile.plane()

  -- Form title (same a prompt)
  !this.formTitle      = !prompt

  -- Define callback action
  !this.action         = !action

  -- Tag
  !this.tag            = !tag
  !this.edgDescription = !description

  -- Setup input
  !this.x.val          = 0
  !this.y.val          = 0

  -- Draw
  !this.preview()

  -- Show form
  !this.show()

endmethod
-- End of method definition for .setup(STRING, PROFILE, STRING, STRING, BOOLEAN, STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Hide Aid number
  !!aidNumbers.hide(!this.aidNumber)

  -- Remove event
  -- Futures  !!edgCntrl.remove(!this.edgDescription)

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Action on picking
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Get positions
  !xyPosition   = object XYPOSITION()
  !xyPosition   = !this.xyPosition()

  -- Carry out action
  $!<this.action>
  handle any
  endhandle

  -- Close form down
  if(!this.recursive.not()) then
    !this.close()
  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview position (tag it)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Initialise Variables
  !!aidNumbers.hide(!this.aidNumber)

  -- Draw offset profile
  if(!this.profile.edges().empty().not()) then
    !profile = object PROFILE(!this.profile)
    !profile.translate(!this.x.val, !this.y.val)
    !profile.draw(!this.aidNumber, 2, 4)
  endif

  -- Get position
  !position = !this.plane.threeDPosition(!this.xyPosition())

  -- Tag position
  AID TEXT NUMBER $!<this.aidNumber> '$!this.tag' AT $!<position>

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Return position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    XYPOSITION  Define position
--
------------------------------------------------------------------------

-- Define method
define method .xyPosition() is XYPOSITION
  return object XYPOSITION(!this.x.val, !this.y.val)
endmethod
-- End of method definition for .xyPosition() XYPOSITION

------------------------------------------------------------------------
--
-- Method:      recursive
--
-- Description: Setup forms OK/Apply Cancel/Dismiss buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Recursion flag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .recursive(!flag is BOOLEAN)

  -- Initialise Variables
  !this.recursive = !flag

  -- Set OK/Apply Cancel/Dismiss buttons
  if(!flag) then
    !this.apply.tag   = 'Apply'
    !this.dismiss.tag = 'Dismiss'
  else
    !this.apply.tag   = ' OK '
    !this.dismiss.tag = 'Cancel'
  endif

endmethod
-- End of method definition for .recursive(BOOLEAN)
