--
-- File:            pos3d.pmlfrm
--   Type:          Form Definition
--   Group:         3D Positioning
--     Keyword:     POS3D
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Jun 30 13:38:06 BST 1998
--
--
-- Description:
-- Generic positioning form, all actions must be passed to it.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Action on picking
--  close()                          -                   Close form
--  edit(STRING,POSITION,STRING,STRING) -                   Setup form as standard position/OK form
--  edit(STRING,POSITION,STRING,STRING,BOOLEAN,STRING) -                   Setup form as standard position passing recursive flag (Apply = true, OK = false)
--  initialise()                     -
--  pos3D()                          -                   Constructor
--  position()                       POSITION            Return position
--  positionData()                   EDGPOSITIONDATA     Return position pick data
--  preview()                        -                   Preview position (tag it)
--  recursive(BOOLEAN)               -                   Setup forms OK/Apply Cancel/Dismiss buttons
--  remove()                         -
--  setPosition(EDGPOSITIONDATA)     -                   Redefine start position
--  setWrt()                         -                   Set up with new wrt item
--
------------------------------------------------------------------------

setup form !!pos3D

  !!pos3D.formTitle     = 'Position'
  !!pos3D.iconTitle     = ''
  !!pos3D.callback      = '!this.initialise()'
  !!pos3D.formRevision  = ' $Revision: 1.10 $ '

  -- Body of form definition
  -- Positioning Gadgets
  path down
  option .ew at x1 y1 width 5
  option .ns width 5
  option .ud width 5
  text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
  text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
  text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
  toggle .xFlag at xmax+1 ymin.ew
  toggle .yFlag at xmin   ymin.ns
  toggle .zFlag at xmin   ymin.ud

  --  Reference (wrt)
  halign right
  text .wrt 'wrt' at xmin.ud ymax+0.3 callback '!this.setWrt()' width 26 string

  para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'

  -- Apply/Dismiss
  button .apply    'Apply'   at xmin form-0    ymax form+0.5 callback '!this.action()'
  button .dismiss  'Dismiss' at xmax form-size ymin          callback '!this.close()' ok

  -- Aid numbers for position & axes
  member .aidNumber      is REAL

  -- Position
  member .position       is POSITIONLINK
  member .positionData   is EDGPOSITIONDATA

  -- Wrt Element
  member .wrtElement     is DBREF

  -- Tag
  member .tag            is STRING
  -- Action
  member .action         is STRING

  -- Recursive
  member .recursive      is BOOLEAN

  -- EDG Description
  member .description    is STRING

exit
-- End of form definition for !!pos3D

------------------------------------------------------------------------
--
-- Method:      pos3D
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pos3D()


  -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!pos3D.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!pos3D.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!pos3D.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!pos3D.preview()')

  -- Aid Lines Number
  !this.aidNumber = !!aidNumbers.add('Position')

  -- Set defaults for form
  !this.position.position(object POSITION('N0'), false, true)
  !this.wrtElement = World
  !this.wrt.val    = 'World'

  -- Set action buttons
  !this.recursive(false)

endmethod
-- End of method definition for .pos3D()
------------------------------------------------------------------------
--
-- Method: init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()
 -- Link Position Option Gadgets to Objects to Current coordinate system
  var !coordinate coordinate
  !this.position.linkOption('!!pos3D.position', !this.ew, !this.ns, !this.ud, !coordinate)

 endmethod
------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Setup form as standard position/OK form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on OK
--    2   R      POSITION    Default position
--    3   R      STRING      Prompt
--    4   R      STRING      Tag on picking
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!action is STRING, !position is POSITION, !prompt is STRING, !tag is STRING)

  !this.edit(!action, !position, !prompt, !tag, false, 'Define Position')

endmethod
-- End of method definition for .edit(STRING, POSITION, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Setup form as standard position passing recursive flag (Apply = true, OK = false)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on OK
--    2   R      POSITION    Default position
--    3   R      STRING      Prompt
--    4   R      STRING      Tag on picking
--    5   R      BOOLEAN     True if Apply (recursive
--    6   R      STRING      Packet description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!action is STRING, !position is POSITION, !prompt is STRING, !tag is STRING, !recursive is BOOLEAN, !description is STRING)

  -- Set up form
  !this.recursive(!recursive)

  -- Define packet for section creation
  !packet                = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.action         = '!!pos3D.setPosition(!this.return[1])'
  !packet.key            = 'POS3D'
  !packet.description    = !description
  !this.description      = !description
  !packet.type           = 'pos3D'
  !packet.priority       = 1
  !packet.close          = '!!aidNumbers.hide(!!pos3D.aidNumber)'
  !packet.remove         = false
  !packet.form           = !!pos3D

  -- Add to system
  if(!!edgCntrl.add(!packet)) then

    -- Form title (same a prompt)
    !this.formTitle = !prompt

    -- Define callback action
    !this.action = !action

    -- Tag
    !this.tag    = !tag

    -- Assign passed position
    !this.position.position(!position, true, true)

  endif

endmethod
-- End of method definition for .edit(STRING, POSITION, STRING, STRING, BOOLEAN, STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Hide Aid number
  !!aidNumbers.hide(!this.aidNumber)

  -- Remove event
  !!edgCntrl.remove(!this.description)

  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      action
--
-- Description: Action on picking
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .action()

  -- Make sure the position is transferred (for manual input)
  !this.positionData.position = !this.position.position()

  -- Carry out action
  $!<this.action>
  handle any
  endhandle

  -- Close form down
  if(!this.recursive.not()) then
    if (undefined(!!stlTolerances)) then
      !this.close()
    elseif (!!stlTolerances.maxLengthLock.not() and !!stlTolerances.minLengthLock.not()) then
      !this.close()
    else
      !this.remove()
    endif
  endif

endmethod
-- End of method definition for .action()

define method .remove()

  -- Hide Aid number
  !!aidNumbers.hide(!this.aidNumber)

endmethod

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview position (tag it)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Initialise Variables
  !position = !this.position.position()

  -- Tag position
  !!aidNumbers.hide(!this.aidNumber)
  AID TEXT NUMBER $!<this.aidNumber> '$!this.tag' AT $!<position>

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Redefine start position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition(!data is EDGPOSITIONDATA)

  -- Define position
  !this.position.position(!data.position, true, false)
  !this.positionData          = !data
  !this.positionData.position = !this.position.position()

endmethod
-- End of method definition for .setPosition(EDGPOSITIONDATA)

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtElement   = !this.wrt.val.dbRef()
  handle any
    !wrtElement = object DBREF()
  endhandle

  -- use current positions origin if it null
  if(!wrtElement.unset()) then
    !wrtElement      = !this.wrtElement
  else
    !this.wrtElement = !wrtElement
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtElement)

  -- Set gadget with name of item
  !this.wrt.val = !wrtElement.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Return position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Define position
--
------------------------------------------------------------------------

-- Define method
define method .position() is POSITION

  return !this.position.position()

endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      positionData
--
-- Description: Return position pick data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    EDGPOSITIONDATA    Position data
--
------------------------------------------------------------------------

-- Define method
define method .positionData() is EDGPOSITIONDATA

  !this.positionData.position = !this.position.position()
  return !this.positionData

endmethod
-- End of method definition for .positionData() EDGPOSITIONDATA

------------------------------------------------------------------------
--
-- Method:      recursive
--
-- Description: Setup forms OK/Apply Cancel/Dismiss buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Recursion flag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .recursive(!flag is BOOLEAN)

  -- Initialise Variables
  !this.recursive = !flag

  -- Set OK/Apply Cancel/Dismiss buttons
  if(!flag) then
    !this.apply.tag   = 'Apply'
    !this.dismiss.tag = 'Dismiss'
  else
    !this.apply.tag   = ' OK '
    !this.dismiss.tag = 'Cancel'
  endif

endmethod
-- End of method definition for .recursive(BOOLEAN)
