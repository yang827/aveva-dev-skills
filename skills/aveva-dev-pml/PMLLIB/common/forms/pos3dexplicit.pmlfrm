-- File:            pos3dexplicit.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue May 19 10:59:55 WAT 1998
--
--
-- Description:
-- Standard 3D Element positioning form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Action carried out on applying form
--  close()                          -                   Close form and tidy
--  datum(BOOLEAN)                   -                   Change datum for position
--  edit(DBREF)                      -                   Setup data for form to be shown
--  initialise()                     -                   Initialise form
--  moveNode(MENU,STRING)            -                   Set new position
--  pick(STRING)                     -                   Set new position
--  pos3DExplicit()                  -                   Constructor
--  preview()                        -                   Preview the plane
--  setDesignation(POSITION)         -                   Set designation position
--  setPosition()                    -                   Set new position
--  setWrt()                         -                   Set up with new wrt item
--  setup(DBREF)                     BOOLEAN             Setup form with passed element
--  setupMenus()                     -                   Setup pulldown menus for form
--  setupOwner(DBREF)                -                   Setup form with data from EDGPICK (makes picked items owner the item)
--  tidy()                           -                   Hide all aid graphics
--  undoEvent()                      -                   Undo/Redo action for the apply button
--
------------------------------------------------------------------------

setup form !!pos3DExplicit

  !!pos3DExplicit.formTitle     = 'Explicit Position'
  !!pos3DExplicit.iconTitle     = 'Position'
  !!pos3DExplicit.callback      = '!this.initialise()'
  !!pos3DExplicit.formRevision  = ' $Revision: 1.22 $ '

  -- Body of form definition
  bar
  exit

  -- Element name
  paragraph .ceName at xmin ymin width 34 lines 1

  -- Positioning Reference
  option .refDatum 'Datum ' at xmin.ceName ymax callback '!this.datum(true)' width 20

  -- Positioning Gadgets
  frame .positionFrame 'Position' at xmin.ceName ymax width 34

    path down
    option .ew at x1 y1.5 width 5
    option .ns width 5
    option .ud width 5
    text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
    text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
    text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
    toggle .xFlag at xmax+1 ymin.ew
    toggle .yFlag at xmin   ymin.ns
    toggle .zFlag at xmin   ymin.ud

    --  Reference (wrt)
    halign right
    text .wrt 'wrt' at xmin.ud ymax+0.3 callback '!this.setWrt()' width 26 string

    para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'
  exit

  -- Apply/Dismiss
  button .apply   'Apply'   at xmin form-0    ymax form+0.25 callback '!this.apply()' apply
  button .dismiss 'Dismiss' at xmax form-size ymin           callback '!this.close()' cancel

  -- Form Members
  member .element        is DBREF
  member .wrtElement     is DBREF

  -- Aid numbers for position & axes
  member .aidNumber      is REAL
  member .aidAxes        is REAL

  -- Form Control Members
  -- Position
  member .position       is POSITIONLINK

  -- True new position of item
  member .newPosition    is POSITION

  -- Offset From origin to reference position
  member .distance       is REAL
  member .direction      is DIRECTION

  -- Offsets of graphic representations from origin of item
  member .gphDistance    is REAL
  member .gphDirection   is DIRECTION
  member .gphBoxOriginal is GPHBOX

  -- Graphic box used to represent item being repositioned
  member .gphBox         is GPHBOX

  -- Designate Flag (are we currently defining the offset point)
  member .designate      is BOOLEAN

  -- Move node flag
  member .moveNode       is BOOLEAN

  -- Undo object for apply method
  member .undoApply      is UNDOABLE

exit
-- End of form definition for !!pos3DExplicit

------------------------------------------------------------------------
--
-- Method:      pos3DExplicit
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pos3DExplicit()

  -- Selection method
  !bar = !this.bar
  !bar.add('Select',   'menuSelect')
  !bar.add('Settings', 'menuSettings')

  !menu = !this.newMenu('menuSelect')
    !menu.add('CALLBACK', 'CE',         '!this.setup(!!ce)')
    !menu.add('CALLBACK', 'Owner',      '!this.setup(!!ce.owner)')
    !menu.add('separator')
    !menu.add('CALLBACK', 'Pick',       '!this.pick(''PICK'')')
    !menu.add('CALLBACK', 'Pick Owner', '!this.pick(''OWNER'')')

  !menu = !this.newMenu('menuSettings')
    !menu.add('TOGGLE', 'Move attached node(s)',    '!this.moveNode(')
    !menu.select('Move attached node(s)', true)
    !this.moveNode = true

--    !menu.add('TOGGLE', 'Move attached element(s)', '')
  var !coordinate coordinate
  -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!pos3DExplicit.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!pos3DExplicit.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  !this.position.linkOption('!!pos3DExplicit.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!pos3DExplicit.setPosition()')

  -- Aid Lines Number
  !this.aidNumber = !!aidNumbers.add('Modify Elements Position')
  !this.aidAxes   = !!aidNumbers.add('Modify Elements Position')

  -- Set defaults for form
  !this.position.position(object POSITION('N0'), false, true)
  !this.wrtElement = World
  !this.wrt.val    = 'World'

    -- Initialise create button undo
  !this.undoApply.description('Apply Position Change')
  !this.undoApply.undoAction(|!!pos3dexplicit.undoEvent()|)
  !this.undoApply.redoAction(|!!pos3dexplicit.undoEvent()|)
  !this.apply.setUndoable(!this.undoApply)

endmethod
-- End of method definition for .pos3DExplicit()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  var !coordinate coordinate
  -- Link Position Option Gadgets to Objects
  !this.position.linkOption('!!pos3DExplicit.position', !this.ew, !this.ns, !this.ud, !coordinate)
  !this.position.position(!this.newPosition, false, true)

endmethod

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description:
--   Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  !elementName  = !!checkName(!this.wrt.val, 'OLD')

  if (!elementName.set()) then
    -- re-defined reference
    !this.wrtElement = !elementName.dbRef()
  else
    -- no element found with that name; use current element
  endif

  -- Set tagging method up
  !this.position.setWrt(!this.wrtElement)

  -- Set gadget with name of item
  !this.wrt.val = !this.wrtElement.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Action carried out on applying form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Initialise Variables
  !reference = !!ce
  !position  = !this.position.get()

  -- Move to item
  !!ce       = !this.element

  -- Special Case position handles
  if(!this.element.hardType eq 'SCTN') then
    !selection = !this.refDatum.selection()
    if(!selection eq 'START') then
      POSSTART $!<position>
    elseif (!selection eq 'END') then
      POSEND   $!<position>
    else
      POSITION $!<this.newPosition>
    endif

  -- Special Case for Fittings and Joints
  elseif (!this.element.hardType inset('FITT', 'CMFI')) then

    -- Move item along pline until its inline with the new position
    DELP N0
    ZDIST THROUGH $!<this.newPosition>
    !newPosition = !!ce.position

    -- Get plane of pline
    !pLineOrientation         = !this.element.orientation
    !pLinePlane               = object PLANE(!newPosition, !pLineOrientation)
    !zOffset                  = !pLinePlane.near(!this.newPosition).distance(!this.newPosition)
    !xyOffset                 = !pLinePlane.xyOffset(!this.newPosition)

    DELP  X$!<xyOffset.x> Y$!<xyOffset.y> Z$!<zOffset>

  -- Reposition
  else
    POSITION $!<this.newPosition>
  endif

  -- Re-positioning of attached nodes
  if(!this.element.hardType inset('SCTN', 'GENSEC') and !this.moveNode) then

    -- Determine which ends we need to reposition
    !selection = !this.refDatum.selection()

    -- Move Start Node
    if(!selection ne 'END') then
      if(!this.element.joiStart.set() and !this.element.joiStart.owner.hardType eq 'PNOD') then
        if(!!dbRefUpdatable(!this.element.joiStart.owner)) then

          -- Start Position
          !position = !this.element.posStart
          !!ce      = !this.element.joiStart.owner
          POSITION $!<position>

        endif
      endif
    endif

    -- Move End Node
    if (!selection ne 'START') then
      if(!this.element.joiEnd.set() and !this.element.joiEnd.owner.hardType eq 'PNOD') then
        if(!!dbRefUpdatable(!this.element.joiEnd.owner)) then

          -- End Position
          !position = !this.element.posEnd
          !!ce      = !this.element.joiEnd.owner
          POSITION $!<position>
        endif
      endif
    endif

  endif


  -- Return to where we came from
  !!ce       = !reference

  -- Redefine the form
  !this.setup(!this.element)

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Hide Modification Plane
  !this.tidy()

  -- Remove event
  !!edgCntrl.remove('Explicit Positioning')
  if(!this.designate) then
    !!edgCntrl.remove('Designate Positioning')
  endif
endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description:
--   Hide all aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide Modification Plane
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidAxes)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      setupOwner
--
-- Description: Setup form with data from EDGPICK (makes picked items owner the item)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      EDGPICKDATA Event pick data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setupOwner(!element is DBREF)

  -- Initialise Variables
--  !tempElement = !!comNavToSig(!element)
  !tempElement = !!ce
  !owningElement = !tempElement.owner

  -- Setup with data
  !this.setup(!owningElement)

endmethod
-- End of method definition for .setupOwner(DBREF)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup form with passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if we can set up with item
--
------------------------------------------------------------------------

-- Define method
define method .setup(!passedElement is DBREF) is BOOLEAN

  -- Initialise Variables
--  !element = !!comNavToSig(!passedElement)
  !element = !passedElement

  -- If the passed element is the same as the current element, then
  -- we only need set certain bits of data
  if(!element eq !this.element and !this.element.set()) then

  -- Difference Element
  else

    -- Initialise Variables
    !dText          = ARRAY()
    !rText          = ARRAY()
    !this.designate = false

    -- Handle Element without a position
    if(!element.attributes().findFirst('Position').unset()) then
      if(not !element.hardType inset('SCTN', 'GENSEC', 'FITT', 'CMFI','ROOM','BLEVEL','CEILIN','CLNPNG','FLRCOV','ELFITT','INFITT','HVACFI','WLFITT','FURNIT','FIXTUR')) then
        !!alert.error('Unable to position element (' & !element.flnn & ') with this utility.')
        return false
      endif
    endif

    -- Check we have access to modify the position
    if(!!dbRefUpdatable(!element).not()) then
      !!alert.error('Unable to Modify element, (' & !!error.text & ').')
      return false
    endif

    -- Check element has a position
    !position = !element.position
    handle any
      !!alert.error('Element (' & !element.flnn & ') does not have a position attribute.')
      return false
    endhandle

    -- Set Element
    !this.element = !element

    -- Section
    if(!element.hardType eq 'SCTN') then
      !dText[1] = 'Start'
      !rText[1] = 'START'
      !dText[2] = 'Centre'
      !rText[2] = 'CENTRE'
      !dText[3] = 'End'
      !rText[3] = 'END'


    -- Standard Position
    else

      -- Special case for spine point or spine curve beneath a "ring" gensec
      if(!element.hardType inset('POINSP', 'CURVE')) then

        if(!element.owner.owner.function.upcase() eq 'RING') then
          !element      = !element.owner.owner
          !this.element = !element
        endif

      endif

      -- Set default positions
      !dText[1] = 'Origin'
      !rText[1] = 'ORIGIN'

      -- Does the element have a "PPoint List"
      !pplist = !element.ppvis
      handle any
        -- Handle added for 11.3 - Change in core behaviour
        !pplist = ARRAY()
      endhandle

      -- Element has Ppoint list
      if(!pplist.set()) then

        do !i indices !pplist
          !dText.append('Ppoint - ' & !pplist[!i])
          !rText.append('PPOINT ' & !pplist[!i])
        enddo

      -- See is the element has any ddl defined ppoints
      else

        do !i
          !pnumber = !element.pPosition[!i]
          handle any
            break
          endhandle
          break if(!pnumber.up.unset())
          !dText.append('Ppoint - ' & !i)
          !rText.append('PPOINT ' & !i)
        enddo

      endif

    endif

    -- Maintain the pull-down
    !this.setupMenus()

    -- Designate Position
    !dText.append('Designate Position')
    !rText.append('DESIGNATE')

    -- Define datum option
    !this.refDatum.dText = !dText
    !this.refDatum.rText = !rText

    -- Unlock all gadgets
    !this.position.unlockAll()

    -- Display element being modified
    !this.ceName.val = !this.element.flnn

  endif

  -- Define Graphic Object
  !volume              = object LOCALVOLUME(!this.element, !this.element)

  -- If volume then use the origin of the item (expanded)
  if(!volume.unset()) then
    !volume            = object LOCALVOLUME()
    !volume.wrt        = !this.element
    !volume.from       = !this.element.position
    !volume.from.east  = !volume.from.east  - 353.5mm
    !volume.from.north = !volume.from.north - 353.5mm
    !volume.from.up    = !volume.from.up    - 353.5mm

    !volume.to         = !this.element.position
    !volume.to.east    = !volume.to.east    + 353.5mm
    !volume.to.north   = !volume.to.north   + 353.5mm
    !volume.to.up      = !volume.to.up      + 353.5mm
  endif

  !box                 = !volume.box()
  !this.gphBox         = object GPHBOX(!box)
  !this.gphBoxOriginal = !this.gphBox

  !!aidNumbers.hide(!this.aidNumber)

  -- Offset from origin to graphic box
  !this.gphDistance    = !this.element.position.distance(!box.position)
  if(!this.gphDistance ne 0) then
    !this.gphDirection = !this.element.position.direction(!box.position)
  else
    !this.gphDirection = U
  endif

  -- Setup positions, etc with the selected datum
  !this.datum(false)

  -- Return
  return true

endmethod
-- End of method definition for .setup(DBREF) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      setupMenus
--
-- Description:
--   Setup pulldown menus for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupMenus()

  -- Initialise Variables
  !this.menuSettings.setActive('Move attached node(s)', false)
--  !this.menuSettings.setActive('Move attached element(s)', false)

  -- Settings Pulldown
  if(!this.element.hardType inset('SCTN','GENSEC')) then
    !this.menuSettings.setActive('Move attached node(s)', true)
  endif

endmethod
-- End of method definition for .setupMenus()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .edit(!element is DBREF)

  -- Setup form
  if(!this.setup(!element)) then

    -- Define EDG positional pick
    !packet                = object EDGPACKET()
    !packet.positionLink('!!pos3DExplicit.position', 'Modify Position')
    !packet.close          = '!!pos3DExplicit.tidy()'
    !packet.key            = 'explicitPosition'
    !packet.description    = 'Explicit Positioning'
    !packet.form           = !!pos3DExplicit
    !packet.priority       = 1
    !packet.remove         = false
    !packet.type           = 'dbModify'

    -- Add into EDG packet
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .edit(DBREF)

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description:
--   Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Get position
  !position  = !this.position.get()

  -- Display new position
  !!aidNumbers.replace(!this.aidNumber, !this.gphBox)
  --Check if the element has been deleted.
  if !this.wrtElement.badref() then
    !this.close()
    kill !!pos3DExplicit
    !!pos3DExplicit()
    return
  endif

  -- Check if the element name has a valid orientation
  !orientation = !this.wrtElement.orientation
  handle (2,211)
    !errorString = !this.wrtElement.name & ' is of type ' & !this.wrtElement.type & ' and can not be used for positioning'
    !!alert.error(!errorString)
    !!ce = !this.element
    !this.initialise()
    !this.wrtElement = /*
    !this.wrt.val = 'World'
    return
  endhandle
  !gphAxes        = object GPHAXES(!position, !orientation)
  !gphAxes.detail = false
  !gphAxes.xyz    = false
  !gphAxes.height = 250mm
  !!aidNumbers.replace(!this.aidAxes, !gphAxes)

  -- Tag Position
  !datum = !this.refDatum.selection('DTEXT')
  AID TEXT NUMB $!this.aidNumber '$!datum' AT $!position

endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      datum
--
-- Description:
--   Change datum for position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .datum(!select is BOOLEAN)

  -- Initialise Variables
  !selection = !this.refDatum.selection()

  -- Are we currently designating the offset point
  if(!this.designate) then
    !!edgCntrl.remove('Designate Positioning')
  endif

  -- Initialise Defaults
  !this.designate = false

  -- Section Start
  if(!selection eq 'START') then
    !position     = !this.element.posStart.wrt(!this.wrtElement)
    !this.distance  = 0
    !this.direction = object DIRECTION('U')

  -- End of Section
  elseif (!selection eq 'END') then
    !position       = !this.element.posEnd.wrt(!this.wrtElement)
    !this.distance  = !this.element.position.distance(!position)
    !this.direction = !this.element.position.direction(!position).opposite()

  -- Centre of Section
  elseif (!selection eq 'CENTRE') then
    !line           = object LINE(!this.element.posStart, !this.element.posEnd)
    !position       = !line.proportion(0.5).wrt(!this.wrtElement)
    !this.distance  = !this.element.position.distance(!position)
    !this.direction = !this.element.position.direction(!position).opposite()

  -- PPoint
  elseif (!selection.part(1) eq 'PPOINT') then
    !position       = !this.element.pPosition[!selection.part(2).real()].wrt(!this.wrtElement)
    !this.distance  = !this.element.position.distance(!position)
    !this.direction = !this.element.position.direction(!position).opposite()
    handle any
      !this.direction = D
    endhandle

  -- Origin
  elseif (!selection eq 'ORIGIN') then
    !position       = !this.element.position.wrt(!this.wrtElement)
    !this.distance  = 0
    !this.direction = object DIRECTION('U')

  -- Designate a position
  elseif (!selection eq 'DESIGNATE') then

    -- Set up edg to designate the positioning position
    if(!select) then

      -- Define EDG positional pick
      !packet                = object EDGPACKET()
      !packet.definePosition('Designate reference position')
      !packet.key            = 'designatePosition'
      !packet.description    = 'Designate Positioning'
      !packet.action         = '!!pos3DExplicit.setDesignation(!this.return[1].position)'
      !packet.priority       = 3
      !packet.remove         = true
      !packet.type           = 'dbModify'

      -- Set definition data
      !this.designate        = true

      -- Add to edg system
      !!edgCntrl.add(!packet)
      return
    endif
    !position = !this.position.get()
  endif

  -- Set position
  !this.newPosition = !position
  !this.position.position(!position, false, true)

  -- Re-define original box volume
  !this.gphBox = !this.gphBoxOriginal

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .datum(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      setDesignation
--
-- Description:
--   Set designation position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Offset position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setDesignation(!position is POSITION)

  -- Initialise Variables
  !this.distance  = !this.element.position.distance(!position)
  if(!this.distance ne 0) then
    !this.direction = !this.element.position.direction(!position).opposite()
  else
    !this.direction = U
  endif
  !this.position.position(!position, true, true)

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .setDesignation(POSITION)

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description:
--   Set new position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setPosition()

  -- Initialise Variables
  !selection = !this.refDatum.selection()

  -- Get current position
  !position = !this.position.get()

  -- Special Case for sections
  if(!this.element.hardType eq 'SCTN') then
    !selection = !this.refDatum.selection()
    !position  = !this.position.get()

    -- line between old SCTN start and end
    !oldLine         = !this.element.posStart.line(!this.element.posEnd)
    !midPointOldLine = !oldLine.proportion(0.5)

    -- find offset between SCTN and original box centre - create new line for box centre
    !offsetDistance  = !midPointOldLine.distance(!this.gphBoxOriginal.box.position)
    if( !offsetDistance gt 0 ) then
      !offsetDirection = !midPointOldLine.direction(!this.gphBoxOriginal.box.position)
      !newLine         = !oldLine.offset(!offsetDirection, !offsetDistance)
    else
      !newLine         = !oldLine
    endif

    if(!selection inset('START', 'END')) then
      if(!selection eq 'START') then
        !otherEnd = !this.element.posEnd

        -- Find the shift in position and also move the relevant end of the line
        !shiftBy  = !this.element.posStart.distance(!position)
        if (!shiftBy.gt(0)) then
          !shiftDir = !this.element.posStart.direction(!position)
          !newLine.startPosition = !newLine.startPosition.offset(!shiftDir, !shiftBy)
        endif

      elseif (!selection eq 'END') then
        !otherEnd = !this.element.posStart

        -- Find the shift in position and also move the relevant end of the line
        !shiftBy  = !this.element.posEnd.distance(!position)
        if (!shiftBy.gt(0)) then
          !shiftDir = !this.element.posEnd.direction(!position)
          !newLine.endPosition = !newLine.endPosition.offset(!shiftDir, !shiftBy)
        endif

      else

      -- Find the shift in position and also move the relevant end of the line
      !shiftBy  = !midPointOldLine.distance(!position)
      if (!shiftBy.gt(0)) then
        !shiftDir = !midPointOldLine.direction(!position)
        !newLine  = !newLine.offset(!shiftDir, !shiftBy)
      endif

      endif

      -- length of line is the new height of the box and the mid point is the new centre of the box
      -- the direction of the line us new direction of box
      !distance = !newLine.length()
      if(!distance ne 0) then
        !midPoint  = !newLine.proportion(0.5)
        !direction = !newLine.direction()
      else
        !midPoint  = !position
        !direction = U
      endif

      -- re-draw the aid box
      !this.gphBox.box.orientation = object ORIENTATION('Z is ' & !direction)
      !this.gphBox.box.position    = !midPoint
      !this.gphBox.box.zLength     = !distance

    else
      -- New Position
      !this.newPosition         = !position.offset(!this.direction, !this.distance)
      !this.gphBox.box.position = !this.newPosition.offset(!this.gphDirection, !this.gphDistance)
    endif

  -- Special Case for Panel Fittings
  elseif (!this.element.hardType inset('PFIT','CMPF')) then

    -- Plane, through item
    !plane                    = object PLANE(!this.element.position, !this.element.owner.orientation)
    !position                 = !plane.near(!position)
    !this.position.position(!position, false, true)
    !this.newPosition         = !position.offset(!this.direction, !this.distance)

    !this.gphBox.box.position = !this.newPosition.offset(!this.gphDirection, !this.gphDistance)

  -- Reposition
  else

    -- New Position
    !this.newPosition         = !position.offset(!this.direction, !this.distance)
    !this.gphBox.box.position = !this.newPosition.offset(!this.gphDirection, !this.gphDistance)

  endif
  -- Preview
  !this.preview()

endmethod
-- End of method definition for .setPosition()

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description:
--   Set new position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option : PICK or OWNER
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick(!option is STRING)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  if(!option.upcase() eq 'OWNER') then
    !packet.elementPick('Pick item, which owner is to be repositioned')
    !packet.action       = '!!pos3DExplicit.setupOwner(!this.return[1].item)'
  else
    !packet.elementPick('Pick item to be re-positioned')
    !packet.action       = '!!pos3DExplicit.setup(!this.return[1].item)'
  endif

  !packet.key            = 'repositionElement'
  !packet.description    = 'Positioning'
  !packet.priority       = 3
  !packet.remove         = true
  !packet.type           = 'dbModify'

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pick(STRING)

------------------------------------------------------------------------
--
-- Method:      moveNode
--
-- Description:
--   Set new position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu
--    2   R      STRING      Selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .moveNode(!menu is MENU, !select is STRING)

  if(!select eq 'SELECT') then
    !this.moveNode = true
  else
    !this.moveNode = false
  endif

endmethod
-- End of method definition for .moveNode(MENU, STRING)
------------------------------------------------------------------------
--
-- Method:      undoEvent
--
-- Description:
--   Undo action for apply button
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .undoEvent()

  if(!this.shown().not()) then
    return
  endif

  !this.setup(!this.element)

endmethod
-- End of method definition
