--
-- File:            pos3doffset.pmlfrm
--   Type:          Form Definition
--   Group:         3D Positioning
--     Keyword:     POS3D
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Jun 30 17:54:52 BST 1998
--
--
-- Description:
-- Define a position relative to another point using a distance
-- and direction.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Action on picking
--  close()                          -                   Close form
--  direction(DIRECTION)             -                   Setup to direction of offset
--  edit(STRING,POSITION,POSITION,STRING,STRING) -                   Setup form as standard position/OK form
--  edit(STRING,POSITION,POSITION,STRING,STRING,BOOLEAN,STRING) -                   Setup form as standard position/OK form
--  measure(LINE)                    -                   Setup to measure distance
--  newPosition()                    -                   Derive new position
--  pos3DOffset()                    -                   Constructor
--  position()                       POSITION            Return position
--  positionData()                   EDGPOSITIONDATA     Return position pick data
--  preview()                        -                   Preview new position
--  recursive(BOOLEAN)               -                   Setup forms OK/Apply Cancel/Dismiss buttons
--  setDirection(MENU,STRING)        -                   Setup to direction of offset
--  setMeasure(MENU,STRING)          -                   Setup to measure offset
--  setPosition(EDGPOSITIONDATA)     -                   Redefine start position
--
------------------------------------------------------------------------

setup form !!pos3DOffset

  !!pos3DOffset.formTitle     = 'Offset Position'
  !!pos3DOffset.iconTitle     = ''
  !!pos3DOffset.callback      = ''
  !!pos3DOffset.formRevision  = ' $Revision: 1.12 $ '

  -- Body of form definition
  -- Direction
  text .direction 'Direction ' callback '!this.newPosition()' at xmin y1 width 20 is DIRECTION
  !!pos3DOffset.direction.val = N

  -- Distance
  path down
  halign right
  text .distance  'Distance '  callback '!this.newPosition()'            width 20 is REAL format !!distanceFmt
  !!pos3DOffset.distance.val = 0

  -- Lock buttons
  toggle .directionLock at xmax.direction+1 ymin.direction callback '!this.direction.active = !this.directionLock.val.not()' states 'false' 'true'
  toggle .distanceLock  at xmax.distance+1  ymin.distance  callback '!this.distance.active  = !this.distanceLock.val.not()'  states 'false' 'true'

  paragraph .lockText at xmin.directionLock-1 ymin.directionLock-1 text 'Lock'

  -- Apply/Dismiss
  button .apply    'Apply'   at xmin form-0    ymax form+0.5 callback '!this.action()'
  button .dismiss  'Dismiss' at xmax form-size ymin          callback '!this.close()'  ok

  -- Aid numbers for position & axes
  member .aidNumber      is REAL

  -- Position
  member .position       is POSITION
  member .reference      is POSITION

  -- Pick Data
  member .positionData   is EDGPOSITIONDATA

  -- Tag
  member .tag            is STRING
  -- Action
  member .action         is STRING

  -- Recursive
  member .recursive      is BOOLEAN

  -- EDG Description
  member .description    is STRING

exit
-- End of form definition for !!pos3DOffset

------------------------------------------------------------------------
--
-- Method:      pos3DOffset
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pos3DOffset()

  -- Aid Lines Number
  !this.aidNumber = !!aidNumbers.add('Position')

  -- Direction
  !menu = !this.newMenu('directionMenu')
    !menu.add('CALLBACK', 'Pick',        '!!pos3DOffset.setDirection(')
    !menu.add('CALLBACK', 'X Direction', '!!pos3DOffset.setDirection(')
    !menu.add('CALLBACK', 'Y Direction', '!!pos3DOffset.setDirection(')
    !menu.add('CALLBACK', 'Z Direction', '!!pos3DOffset.setDirection(')
    !menu.add('CALLBACK', 'Opposite',    '!!pos3DOffset.setDirection(')
  !this.direction.setPopup(!this.directionMenu)

  -- Distance
  !menu = !this.newMenu('distanceMenu')
    !menu.add('CALLBACK', 'Measure',          '!!pos3DOffset.setMeasure(')
    !menu.add('CALLBACK', 'Measure Shortest', '!!pos3DOffset.setMeasure(')
  !this.distance.setPopup(!this.distanceMenu)

  -- Set action buttons
  !this.recursive(false)

endmethod
-- End of method definition for .pos3DOffset()

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Setup form as standard position/OK form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on OK
--    2   R      POSITION    Reference position
--    3   R      POSITION    Default position
--    4   R      STRING      Prompt
--    5   R      STRING      Tag on picking
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!action is STRING, !reference is POSITION, !position is POSITION, !prompt is STRING, !tag is STRING)

  !this.edit(!action,!reference, !position, !prompt, !tag, false, 'Define Position')

endmethod
-- End of method definition for .edit(STRING, POSITION, POSITION, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description: Setup form as standard position/OK form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action on OK
--    2   R      POSITION    Reference position
--    3   R      POSITION    Default position
--    4   R      STRING      Prompt
--    5   R      STRING      Tag on picking
--    6   R      BOOLEAN     True if Apply (recursive
--    7   R      STRING      Packet description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!action is STRING, !reference is POSITION, !position is POSITION, !prompt is STRING, !tag is STRING, !recursive is BOOLEAN, !description is STRING)

  -- Set up form
  !this.recursive(!recursive)

  -- Define packet for section creation
  !packet                = object EDGPACKET()
  !packet.definePosition(!prompt)
  !packet.action         = '!!pos3DOffset.setPosition(!this.return[1])'
  !packet.key            = 'POS3D'
  !packet.description    = !description
  !this.description      = !description
  !packet.type           = 'pos3D'
  !packet.priority       = 1
  !packet.close          = '!!aidNumbers.hide(!!pos3DOffset.aidNumber)'
  !packet.remove         = false
  !packet.form           = !!pos3DOffset

  -- Add to system
  if(!!edgCntrl.add(!packet)) then

    -- Form title (same a prompt)
    !this.formTitle = !prompt

    -- Define callback action
    !this.action    = !action

    -- Tag
    !this.tag       = !tag

    -- Reference position
    !this.reference = !reference
    !this.position  = !position

    -- Distance
    !this.distance.val = !reference.distance(!position)
    if(!this.distance.val eq 0) then
      !this.direction.val = U
    else
      !this.direction.val = !reference.direction(!position)
    endif

    !this.preview()

  endif

endmethod
-- End of method definition for .edit(STRING, POSITION, POSITION, STRING, STRING, BOOLEAN, STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Hide Aid number
  !!aidNumbers.hide(!this.aidNumber)

  -- Remove event
  !!edgCntrl.remove(!this.description)

  -- Hide form
  !this.hide()

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      action
--
-- Description: Action on picking
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .action()

  -- Carry out action
  $!<this.action>
  handle any
  endhandle

  -- Close form down
  if(!this.recursive.not()) then
    !this.close()

  -- Setup form with new positions
  else
    !this.reference = !this.position
    !this.position  = !this.position.offset(!this.direction.val, !this.distance.val)
    !this.preview()
  endif

endmethod
-- End of method definition for .action()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview new position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Initialise Variables

  -- Tag position
  !!aidNumbers.hide(!this.aidNumber)
  AID TEXT NUMBER $!<this.aidNumber> '$!this.tag' AT $!<this.position>
  AID LINE NUMBER $!<this.aidNumber> $!<this.reference> TO $!<this.position>
endmethod
-- End of method definition for .preview()

------------------------------------------------------------------------
--
-- Method:      newPosition
--
-- Description: Derive new position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .newPosition()

  -- Derive position
  !this.position = !this.reference.offset(!this.direction.val, !this.distance.val)

  -- Preview
  !this.preview()

endmethod
-- End of method definition for .newPosition()

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Redefine start position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition(!data is EDGPOSITIONDATA)

  -- Define position
  !this.positionData   = !data

  -- Remove reference items
  !this.positionData.item = object DBREF()
  !this.positionData.items.clear()

  -- Set position
  !position            = !data.position
  !distance            = !position.distance(!this.reference)

  -- Set Distance value
  if(!this.distanceLock.val.not()) then

    -- If direction is locked, then workout intersection of line with
    -- plane passing through the derived position
    if(!this.directionLock.val) then
      !plane             = object PLANE(!position, object ORIENTATION(' Z is ' & !this.direction.val))
      !newPosition       = !plane.intersection(object LINE(!this.reference, !this.reference.offset(!this.direction.val, 1000mm)))
      !this.distance.val = !newPosition.distance(!this.reference)
    else
      !this.distance.val = !distance
    endif
  endif

  -- Set direction
  if(!this.directionLock.val.not()) then
    if(!distance eq 0) then
      !this.direction.val = U
    else
      !this.direction.val = !this.reference.direction(!position)
    endif
  endif

  -- Redefine Position
  !this.position              = !this.reference.offset(!this.direction.val, !this.distance.val)
  !this.positionData.position = !this.position

  -- Preview data
  !this.preview()

endmethod
-- End of method definition for .setPosition(EDGPOSITIONDATA)

------------------------------------------------------------------------
--
-- Method:      setMeasure
--
-- Description: Setup to measure offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMeasure(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Measure (point to point)
  if(!option eq 'MEASURE') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('distance')
    !packet.action = '!!pos3DOffset.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

    -- Measure parallel
  elseif (!option eq 'MEASURE SHORTEST') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineMeasure('shortest')
    !packet.action = '!!pos3DOffset.measure(!this.return[1])'
    !!edgCntrl.add(!packet)

  endif

endmethod
-- End of method definition for .setMeasure(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      measure
--
-- Description: Setup to measure distance
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .measure(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.distance.val = 0
  else
    !this.distance.val = !line.length()
  endif

  -- Derive new position
  !this.newPosition()

endmethod
-- End of method definition for .measure(LINE)

------------------------------------------------------------------------
--
-- Method:      setDirection
--
-- Description: Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu selected from
--    2   R      STRING      Selection state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setDirection(!menu is MENU, !selected is STRING)

  -- Initialise Variables
  !option = !menu.pickedField.upcase()

  -- Pick Direction
  if(!option eq 'PICK') then

    -- Define the measure packet
    !packet        = object EDGPACKET()
    !packet.defineDirection('')
    !packet.action = '!!pos3DOffset.direction(!this.return[1])'
    !!edgCntrl.add(!packet)
    return

  -- Opposite  Direction
  elseif (!option eq 'OPPOSITE') then
    !this.direction.val = !this.direction.val.opposite()

  -- Direction
  else

    -- Check we have an orientation
    !unusedOrientation = !!ce.orientation
    handle any
      return
    endhandle

     -- Extract the direction
    if(!option.match('X').boolean()) then
      !this.direction.val = !!ce.orientation.xDir().wrt(World)
    elseif (!option.match('Y').boolean()) then
      !this.direction.val = !!ce.orientation.yDir().wrt(World)
    else
      !this.direction.val = !!ce.orientation.zDir().wrt(World)
    endif

  endif

  -- Derive new position
  !this.newPosition()

endmethod
-- End of method definition for .setDirection(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      direction
--
-- Description: Setup to direction of offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    LINE         Return
--
------------------------------------------------------------------------

define method .direction(!direction is DIRECTION)

  -- Write angle to form
  !this.direction.val = !direction

  -- Derive new position
  !this.newPosition()

endmethod
-- End of method definition for .direction(DIRECTION)

------------------------------------------------------------------------
--
-- Method:      position
--
-- Description: Return position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    POSITION    Define position
--
------------------------------------------------------------------------

-- Define method
define method .position() is POSITION

  return !this.position

endmethod
-- End of method definition for .position() POSITION

------------------------------------------------------------------------
--
-- Method:      positionData
--
-- Description: Return position pick data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    EDGPOSITIONDATA    Position data
--
------------------------------------------------------------------------

-- Define method
define method .positionData() is EDGPOSITIONDATA

  !this.positionData.position = !this.position
  return !this.positionData

endmethod
-- End of method definition for .positionData() EDGPOSITIONDATA

------------------------------------------------------------------------
--
-- Method:      recursive
--
-- Description: Setup forms OK/Apply Cancel/Dismiss buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Recursion flag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .recursive(!flag is BOOLEAN)

  -- Initialise Variables
  !this.recursive = !flag

  -- Set OK/Apply Cancel/Dismiss buttons
  if(!flag) then
    !this.apply.tag   = 'Apply'
    !this.dismiss.tag = 'Dismiss'
  else
    !this.apply.tag   = ' OK '
    !this.dismiss.tag = 'Cancel'
  endif

endmethod
-- End of method definition for .recursive(BOOLEAN)
