--
--
-- Description:
-- Standard relative 3D Element positioning form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Action carried out on applying form
--  close()                          -                   Close form and tidy
--  edit(DBREF)                      -                   Setup data for form to be shown
--  isMoveable(DBREF)                BOOLEAN             Check to see if passed item is moveable
--  move(ARRAY)                      -                   Move passed list of element
--  moveElements()                   -                   Move elements in current element list
--  pick(STRING)                     -                   Set new position
--  pos3DRelative()                  -                   Constructor
--  preview()                        -                   Preview the plane
--  referencePosition(DBREF)         POSITION            Return reference position of passed element
--  select()                         -                   Select option
--  selectElement(DBREF)             -                   Select passed element
--  setPosition()                    -                   Set new position, input via the input gadgets
--  setPosition(LINE)                -                   Set position by passing a line (derived from a measure)
--  setWrt()                         -                   Set up with new wrt item
--  setup()                          -                   Setup form with passed element
--  setup(DBREF)                     BOOLEAN             Setup form with passed element
--  tidy()                           -                   Hide all aid graphics
--  undoAction()                     -
--

setup form !!pos3DRelative

  !this.formTitle     = 'Position By'
  !this.iconTitle     = 'By'
  !this.callback      = '!this.setup()'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Option
  option .ce callback '!this.select()' width 8

  -- Element name
  paragraph .ceName at xmax ymin width 17 lines 3


  -- Positioning Gadgets
  frame .positionFrame 'Offset' at xmin.ce ymax width 28
    path down
    option .ew at x1 y1.5 width 5
    option .ns width 5
    option .ud width 5
    text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
    text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
    text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
    toggle .xFlag at xmax+1 ymin.ew
    toggle .yFlag at xmin   ymin.ns
    toggle .zFlag at xmin   ymin.ud

    --  Reference (wrt)
    halign right
    text .wrt 'wrt' at xmin.ud ymax+0.5 callback '!this.setWrt()' width 20 string

    para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'

  exit

  -- Apply/Dismiss
  button .apply   'Apply'   at xmin form-0    ymax form+0.25 callback '!this.apply()' apply
  button .dismiss 'Dismiss' at xmax form-size ymin           callback '!this.close()' cancel

  -- Form Members
  member .element         is DBREF
  member .wrtElement      is DBREF

  -- Aid numbers for position & axes
  member .aidNumber       is REAL
  member .aidFrom         is REAL
  member .aidTo           is REAL

  -- Form Control Members
  -- Position
  member .position        is POSITIONLINK

  -- Original position
  member .refPosition     is POSITION

  -- Offset (should be what is shown on the form)
  member .offset          is POSITION

  -- Offset From origin to reference position
  member .distance        is REAL

  -- Must be in the frame of reference of the WRT
  member .direction       is DIRECTION

  -- Last selection
  member .lastSelection   is REAL

  -- Element List
  member .elements        is ARRAY

  -- Coordinate system in use
  member .coordType       is STRING

  -- Undo member
  member .undo is UNDOABLE

exit

------------------------------------------------------------------------
--
-- Method:      pos3DRelative
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pos3DRelative()

  -- Reference info
  !this.offset          = N0
  !this.refPosition     = N0
  !this.distance        = 0
  !this.direction       = U

  -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!pos3DRelative.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!pos3DRelative.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!pos3DRelative.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('!!pos3DRelative.setPosition()')

  -- Options
  !dtext[1]             = 'CE'
  !dtext[2]             = 'Pick'
  !dtext[3]             = 'List'
  !dtext[4]             = 'Selection'
  !rtext[1]             = 'CE'
  !rtext[2]             = 'PICK'
  !rtext[3]             = 'LIST'
  !rtext[4]             = 'SELECTED'
  !this.ce.dtext        = !dtext
  !this.ce.rtext        = !rtext

  -- Aid Lines Number
  !this.aidNumber       = !!aidNumbers.add('Modify Elements Position')
  !this.aidFrom         = !!aidNumbers.add('Modify Elements Position')
  !this.aidTo           = !!aidNumbers.add('Modify Elements Position')

  -- Set defaults for form
  !this.position.position(!this.offset, false, true)
  !this.wrtElement      = World
  !this.wrt.val         = 'World'

  -- Last selection
  !this.lastSelection   = 1

  -- Set the undo member
  !this.undo = object UNDOABLE()
  !this.undo.description('Undo Move')
  !this.undo.undoAction('!!pos3dRelative.undoAction()')
  !this.undo.redoAction('!!pos3dRelative.undoAction()')
  !this.apply.setUndoable(!this.undo)
endmethod
------------------------------------------------------------------------
--
-- Method:      selectElement
--
-- Description: Select passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .selectElement(!element is DBREF)

  -- Initialise Variables
  !index = !this.elements.findFirst(!element)

  -- Remove element from list if its already in the list
  if(!index.set()) then
      UNENHANCE $!<element>
      !this.elements.remove(!index)

  -- Add element to list
  else

    -- Check if item is moveable
    if(!this.isMoveable(!element)) then
      ENHANCE $!<element> COLOUR RED
      !this.elements.append(!element)

    -- No moveable
    else
      !!alert.warning(!!error.text)
    endif

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description: Select option
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .select()

  -- Initialise Variables
  !selection  = !this.ce.selection('rtext')

  -- Current Element
  if(!selection.eq('CE')) then

    !reference = !this.element
    if(!this.setup(!!ce).not()) then
      !!ce     = !reference
    endif

    -- Setup form
    !this.setup()

  elseif (!selection.eq('LIST')) then

    -- Check for current list
    !listNumber = !!cdcList.name.selection().real()

    -- If zero, then there is no list
    if(!listNumber.unset() or !listNumber eq 0) then
      !this.ce.val = !this.lastSelection
      !!alert.warning('No list defined')
      return
    endif

    -- Current List
    !this.ceName.val = 'Current List'

  elseif (!selection.eq('SELECTED')) then

    -- Current selection
    !this.ceName.val = 'Current Selection'

  -- Set pick
  else
    -- Pick Elements
    !this.ceName.val = 'Pick Elements'

  endif

  !this.lastSelection   = !this.ce.val

endmethod

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup form with passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup()

 -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!pos3DRelative.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Initialise Variables

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- Display element being modified
  !this.ce.val = 1
  !this.ceName.val  = !this.element.flnn

  !this.distance          = 0
  !this.direction         = U

  !this.direction.origin  = !this.wrtElement
  !this.offset            = N0
  !this.offset.origin     = !this.wrtElement

  -- Set apply button to active
  !this.apply.active = true


  -- Setup position
  !this.position.position(!this.offset, true, true)

  --DDC Team. Bug fixing 04-Oct-05. Against defect log No.5457 code starts here
  --Error handled. Element reference changed. When the referred element is deleted.

  handle (2,202)
    --!!alert.message('Referred element deleted')
    !this.wrtElement = World
    !this.wrt.val         = 'World'
    !this.position.position(!this.offset, true, true)
  endhandle

  -- Coordinate system in use
  var !coordinate coordinate
  !this.coordType = !coordinate

  --Defect fix Error handled end here.

  -- Tag reference point
  !this.preview()

  -- Stop Apply being pressed again
  !this.apply.active     = true

endmethod

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup form with passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if we can set up with item
--
------------------------------------------------------------------------

-- Define method
define method .setup(!passedElement is DBREF) is BOOLEAN

  -- Initialise Variables
  !element = !passedElement

  -- Get position
  !position = !this.referencePosition(!passedElement)

  if(!position.set()) then

    -- Check we have access to modify the position
    if(!!dbRefUpdatable(!element).not()) then
      !!alert.error('Unable to Modify element, (' & !!error.text & ').')
      return false
    endif

    -- Set Element
    !this.element         = !element

    -- Reference position
    !this.refPosition     = !position.wrt(World)

  -- Get position
  else
    !!alert.warning(!!error.text)
    return false
  endif

  -- Return
  return true

endmethod

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
--  !wrtElement             = !this.wrt.val.dbRef()
--  handle any
--    !wrtElement           = object DBREF()
--  endhandle

  -- Check with respect to element
--  if(!wrtElement.unset()) then
--    !wrtElement           = !this.wrtElement
--  else
--    !this.wrtElement      = !wrtElement
--  endif

  !elementName  = !!checkName(!this.wrt.val, 'OLD')

 if (!elementName.set()) then

    -- re-defined reference

    !wrtElement  = !elementName.dbRef()
    !orientation =  !wrtElement.orientation
    handle (2,211)
      !!alert.error('Cannot position with respect to specified element type ' + !wrtElement.actType + ' which does not have an orientation')
      -- reset wrt gadget
      !this.wrt.val       = !this.wrtElement.name
      return
    endhandle
    !this.wrtElement = !wrtElement

  else

    -- no element found with that name; use current element

  endif

  -- Change frame of reference of direction
  !this.direction.origin  = !this.wrtElement
  !this.offset.origin     = !this.wrtElement

  -- Set position (doesn't use positionLink methods, as this would recalculate position)
  !this.position.wrt      = !this.wrtElement
  !this.position.position = !this.offset

  -- Set gadget with name of item
  !this.wrt.val           = !this.wrtElement.name

  -- Preview
  !this.preview()

endmethod

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description:
--   Action carried out on applying form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Initialise Variables
  !reference    = !!ce
  !selection    = !this.ce.selection('rtext')
  !elementList  = ARRAY()
  !badList      = ARRAY()

  -- Current Element
  if(!selection.eq('CE')) then

    !elementList.append(!this.element)

  -- Selection
  elseif (!selection.eq('LIST')) then

    -- Check for current list
    !listNumber = !!cdcList.name.selection().real()

    -- If zero, then there is no list
    if(!listNumber.unset() or !listNumber eq 0) then
      !!alert.warning('No list defined')
      return
    endif

    -- Get elements from the list
    !elements = !!cdList$!<listNumber>

    -- Loop through elements and check if we can modify them
    do !i indices !elements
      !element = !elements[!i].dbRef()

      if(!this.isMoveable(!element)) then
        if(!!dbRefUpdate(!element)) then
          !elementList.append(!element)
        else
          !badList.append(!element)
        endif
      else
        !badList.append(!element)
      endif

    enddo

  -- Graphical Selection
  elseif (!selection.eq('SELECTED')) then

    -- Check for graphical selection
    !s = object SELECTION()
    !s.getCurrent()

    -- Get elements from the selection
    !elements = !s.getSelection()

    -- If we have none then make ce our pseudo selection
    if (!elements.size() eq 0) then
    	!elements.append(!!ce)
    endif

    -- Loop through elements and check if we can modify them
    do !i indices !elements
      !element = !elements[!i]

      if(!this.isMoveable(!element)) then
        if(!!dbRefUpdate(!element)) then
          !elementList.append(!element)
        else
          !badList.append(!element)
        endif
      else
        !badList.append(!element)
      endif

    enddo

  -- Pick elements
  else

    -- Empty element list
    !this.elements.clear()

    -- Stop Apply being pressed again
    !this.apply.active     = false

    -- Define event packet for picking elements
    !packet                = object EDGPACKET()
    !packet.elementPick('Pick element to move (<ESC> to move)')
    !packet.action         = '!!pos3DRelative.selectElement(!this.return[1].item)'
    !packet.escape         = '!!pos3DRelative.moveElements()'
    !packet.key            = 'relativePositionPick'
    !packet.description    = 'Relative Positioning Pick'
    !packet.priority       = 2
    !packet.remove         = false
    !packet.type           = 'dbModify'

    -- Add into EDG packet
    !!edgCntrl.add(!packet)

    return

  endif

  -- Move elements
  !this.move(!elementList)

endmethod

------------------------------------------------------------------------
--
-- Method:      move
--
-- Description: Move passed list of element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of DBREF of elements to move
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .move(!list is ARRAY)

  -- Initialise Variables
  !reference = !!ce

  -- If offset is zero, then don't move anything
--  if(!this.refPosition.distance(!this.offset).eq(0)) then
--    return
--  endif

  -- Loop through each entry
  do !i indices !list

    !!ce = !list[!i]

    BY $!<this.offset>

  enddo

  -- Return to previous item
  !!ce = !reference

  -- Reset Reference Position
  !this.refPosition  = !this.referencePosition(!this.element)

  -- Set apply button to active
  !this.apply.active = true

  -- Preview
  !this.preview()

endmethod

------------------------------------------------------------------------
--
-- Method:      moveElements
--
-- Description: Move elements in current element list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .moveElements()

  -- Initialise Variables

  -- Unenhance all from list
  do !i indices !this.elements
    UNENHANCE $!this.elements[$!i]
  enddo

  -- Move elements
  !this.move(!this.elements)

  -- Set apply button to active
  !this.apply.active = true

endmethod

------------------------------------------------------------------------
--
-- Method:      isMoveable
--
-- Description: Check to see if passed item is moveable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to check
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if element is moveable
--
------------------------------------------------------------------------

-- Define method
define method .isMoveable(!element is DBREF) is BOOLEAN

  -- Initialise Variables
  !type = !element.hardType

  -- Does element have a position
  if(!element.attributes().findFirst('Position').unset()) then

    -- Exceptions to the normal
    if(not !type inset('SCTN','PALJ','SBFR','FRMW','BRAN','PIPE','HANG','LOOP','PLOO','PNOD','ROOM','BLEVEL','CEILIN','CLNPNG','FLRCOV','ELFITT','INFITT','HVACFI','WLFITT','FURNIT','FIXTUR')) then
      !!error.text = 'Unable to move element (' & !element.flnn & ') with this utility.'
      return false

    endif
  endif

  return true

endmethod

------------------------------------------------------------------------
--
-- Method:      referencePosition
--
-- Description: Return reference position of passed element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to check
-- Return:
--   [Data Type] [Description]
--    POSITION    Reference Position
--
------------------------------------------------------------------------

-- Define method
define method .referencePosition(!element is DBREF) is POSITION

  -- Initialise Variables
  !position = object POSITION()
  !type     = !element.hardType

  -- Check if item is moveable
  if(!this.isMoveable(!element)) then

    -- Get reference position for item
    if(!type eq 'SCTN') then
      !position = !element.posStart
    elseif (!type eq 'PNOD') then
      !position = !element.nPosition
    elseif (!type eq 'BRAN') then
      !position = !element.hPosition
    elseif (!type eq 'HANG') then
      !position = !element.hPosition
    elseif (!type eq 'PIPE') then
      if(!element.members.empty().not()) then
        if(!element.members[1].hardType.eq('BRAN')) then
          !position = !element.members[1].hPosition
        endif
      endif
    elseif (!type eq 'PALJ') then
      if(!element.members.empty().not()) then
        !position = !element.members[1].position
      endif
    endif

    -- If position is unset, then get the owner with a position
    if(!position.unset()) then

      -- Get first owner with a position
      !ownerList = !element.ownLst
      !ownerList.append(!element)
      !ownerList.invert()

      do !parent values !ownerList

        if(!parent.attributes().findFirst('Position').set()) then
          !position = !parent.position
          break
        endif

      enddo
    endif

  endif

  -- Return
  return !position


endmethod

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Hide Modification Plane
  !this.tidy()

  -- Unenhance all from list
  do !i indices !this.elements
    UNENHANCE $!this.elements[$!i]
  enddo

  -- Remove event
  !!edgCntrl.remove('Relative Positioning')
  !!edgCntrl.remove('Relative Positioning Pick')

endmethod

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Hide all aid graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

  -- Hide Modification Plane
  !!aidNumbers.hide(!this.aidNumber)
  !!aidNumbers.hide(!this.aidFrom)
  !!aidNumbers.hide(!this.aidTo)

endmethod

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be modified
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .edit(!element is DBREF)

  -- Setup form
  if(!this.setup(!element)) then

    -- Define EDG positional pick
    !packet                = object EDGPACKET()

    !packet.defineMeasure('DISTANCE')
    !packet.action         = '!!pos3DRelative.setPosition(!this.return[1])'

    !packet.close          = '!!pos3DRelative.tidy()'
    !packet.key            = 'relativePosition'
    !packet.description    = 'Relative Positioning'
    !packet.form           = !!pos3DRelative
    !packet.priority       = 1
    !packet.remove         = false
    !packet.type           = 'dbModify'

    -- Add into EDG packet
    !!edgCntrl.add(!packet)

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position by passing a line (derived from a measure)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R                  Distance measured
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setPosition(!line is LINE)

  -- Initialise Variables

  -- Handle zero length lines
  if(!line.length() eq 0) then
    !this.distance  = 0
    !this.direction = U

  -- Get distance and direction
  else
    !this.distance  = !line.length()
    !this.direction = !line.direction()
  endif

  -- Get offset
  !origin                   = N0
  !origin.origin            = !this.wrtElement
  !offset = !origin.offset(!this.direction, !this.distance).wrt(!this.wrtElement)

  -- Push new position into the form
  !this.position.position(!offset, false, false)

  -- Set Offset
  !this.offset = !this.position.get()

  -- Redefine offset
  !this.distance            = !origin.distance(!this.offset)
  if(!this.distance.eq(0)) then
    !this.direction         = U
    !this.direction.origin  = !this.wrtElement
  else
    !this.direction         = !origin.direction(!this.offset).wrt(!this.wrtElement)
  endif

  -- Preview
  !this.preview()

endmethod

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set new position, input via the input gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setPosition()

  -- Initialise Variables
  !origin                   = N0
  !origin.origin            = !this.wrtElement

  -- Get current position
  !position                 = !this.position.get()

  -- Determine direction and offset
  !this.distance            = !origin.distance(!position)
  if(!this.distance.eq(0)) then
    !this.direction         = U
    !this.direction.origin  = !this.wrtElement
  else
    !this.direction = !origin.direction(!position).wrt(!this.wrtElement)
  endif

  !this.offset              =  !position

  -- Preview
  !this.preview()

endmethod

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description:
--   Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview()

  -- Clear graphics
  !this.tidy()

  -- Display Reference position
  !orientation    = !this.wrtElement.orientation
  handle (2,211)
    !!alert.error('Cannot position with respect to this element because it has no orientation attribute. Please try another wrt element')
    return
  endhandle
  !gphAxes        = object GPHAXES(!this.refPosition, !orientation)
  !gphAxes.detail = false
  !gphAxes.xyz    = false
  !gphAxes.height = 250mm
  !!aidNumbers.replace(!this.aidFrom, !gphAxes)

  -- Display offset
  if(!this.distance gt 0) then
    !newPosition  = !this.refPosition.offset(!this.direction, !this.distance)
    !gphDimension = object GPHDIMENSION(!this.refPosition, !newPosition)
    !gphDimension.wrt(!this.wrtElement)

    if(!this.coordType eq 'ENU')then
    !gphDimension.labelENU()
    else
      !gphDimension.labelXYZ()
    endif

    !!aidNumbers.replace(!this.aidNumber, !gphDimension)
    AID TEXT NUMBER $!<this.aidTo> 'New Position' AT $!<newPosition>
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      pick
--
-- Description:
--   Set new position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option : PICK or OWNER
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pick(!option is STRING)

  -- Define EDG positional pick
  !packet                = object EDGPACKET()
  if(!option.upcase() eq 'OWNER') then
    !packet.elementPick('Pick item, which owner is to be repositioned')
    !packet.action       = '!!pos3DExplicit.setupOwner(!this.return[1].item)'
  else
    !packet.elementPick('Pick item to be re-positioned')
    !packet.action       = '!!pos3DExplicit.setup(!this.return[1].item)'
  endif

  !packet.key            = 'repositionElement'
  !packet.description    = 'Positioning'
  !packet.priority       = 3
  !packet.remove         = true
  !packet.type           = 'dbModify'

  -- Add to edg system
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      undo action
--
-- Description:
--   undo action
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .undoAction()

  if (!this.shown()) then
  	!this.tidy()
  	!this.setup(!!ce)
  endif

endmethod
