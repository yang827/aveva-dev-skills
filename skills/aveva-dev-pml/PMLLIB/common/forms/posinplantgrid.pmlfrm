-- Created:         Thu Nov 16 09:02:15 BST 2006
--
--
-- Description:
-- Display position in grid system coords
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close form and tidy
--  posInPlantGrid()                 -                   Constructor
--  setup(DBREF,POSITION)            -                   Setup form
--
------------------------------------------------------------------------

-- Define form
setup form !!posInPlantGrid

  !!posInPlantGrid.formTitle     = 'Display Grid Coords'
  !!posInPlantGrid.iconTitle     = 'Gridcoords'
  !!posInPlantGrid.formRevision  = ' $Revision: 1.0 $ '

  -- ENU position
  frame .enuFrame |In World|
    path down
    para .east  width 16 lines 1
    para .north width 16 lines 1
    para .up    width 16 lines 1
  exit

  -- Grid position
  frame .xyzFrame |In grid| at xmax.enuFrame+1 ymin.enuFrame
    path down
    para .xCoord width 20 lines 1
    para .yCoord width 20 lines 1
    para .zCoord width 20 lines 1
  exit

  -- Close
  button .close 'Close' at xmax form-size ymax+0.2 ok

  -- Position in grid object
  member .posInGrid   is POSINGRID

  -- Aid numbers for position & axes
  member .aidNumber    is REAL

exit
-- End of form definition for !!posInPlantGrid

------------------------------------------------------------------------
--
-- Method:      posInPlantGrid
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .posInPlantGrid()

  -- Callbacks
  !this.close.callback = |!this.close()|

  -- Aid Number
  !this.aidNumber = !!aidNumbers.add(|Gridcoords|)

endmethod
-- End of method definition for .posInPlantGrid()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Grid system
--    2   R      POSITION    Picked position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!gridSystem is DBREF, !position is POSITION)

  -- Process the position in to grid coords
  !this.posInGrid = OBJECT posInGrid(!gridSystem, !position)

  -- Display position in world
  !this.east.val  = !this.posInGrid.east
  !this.north.val = !this.posInGrid.north
  !this.up.val    = !this.posInGrid.up

  -- Display position in grid coords
  !this.xyzFrame.tag = |In | & !gridSystem.namn
  !this.xCoord.val = !this.posInGrid.xCoord
  !this.yCoord.val = !this.posInGrid.yCoord
  !this.zCoord.val = !this.posInGrid.zCoord

  -- Mark position
  !this.posInGrid.draw(!this.aidNumber)

endmethod
-- End of method definition for .setup()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Hide currently displayed grid
  if (!this.aidNumber.set()) then
    !!aidNumbers.hide(!this.aidNumber)
  endif

endmethod
-- End of method definition for .close()
