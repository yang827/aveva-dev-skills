--
--
-- Description:     Displays user's ACRs and element access rights
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  acrTxtList()                     -
--  displayAcr(DBREF,DBREF)          -                   Method which takes a dbref of a role and a scope and displays them this form.
--  displayAllData(ARRAY,ARRAY,STRING) ARRAY               compose display of the attributes and their errors
--  displayPerop()                   -                   Function to a) decide if to display form b) to display it
--  elementAccess()                  -                   Constructor for Element Access frame
--  getErrors()                      -                   Get Dac Errors for all the attributes of the element
--  getOpErrors()                    -                   Get operation errors of the dbref for the display
--  getOperations()                  -                   Get DAC Operators Claim,drop,issue,create,delete
--  initElementAccess(DBREF)         -                   Initialisation for the form
--  initElementAccess(STRING)        -                   Initialisation for the form from the CE Button
--  initUserAcrs()                   -
--  initialise()                     -
--  peropGet()                       ADMPEROP            Method to enable desperop to find out which perop is currently being viewed
--  peropTxtList()                   -
--  qryDac()                         -                   Constructor method
--  userAcrs()                       -
--
------------------------------------------------------------------------
setup form !!qryDac

  !this.formTitle     = 'Query Data Access Control'
  !this.iconTitle     = 'Query DAC'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.1 $ '

  !framePos = 'at x0 y0'

  -- Body of form definition
  para .dacState width 48
  path down
  frame .tabs tabset
    frame .userAcrs 'User Rights' $!framePos

      path down
      list .acr 'ACRs that apply to current user' call '!this.displayAcr(!this.admAcr[!this.acr.val].rolref, !this.admAcr[!this.acr.val].scoref)' width 47 height 4

      frame .role 'Role'
        text .roleName 'Name       ' width 34 scroll 32 STRING
        path down
        text .roleDesc 'Description' width 34 scroll 120 STRING
        list .listPerop 'Permissible Operations' callback '!this.displayPerop()' width 45 height 5
      exit
      frame .scope |Scope|
        text   .scopeName |Name       | width 34 scroll 32 STRING
        text   .scopeDesc |Description| width 34 scroll 120 STRING
        para   .scopSelTxt text |Scope Selection|
        text   .scopSel at ymax.scopSelTxt width 45 scroll 256 STRING
      exit
      -- members
      member .admAcr   is ARRAY
      member .admPerop is ARRAY
      member .dacIsOn  is BOOLEAN
    exit

    frame .elementAccess 'Element Access' $!framePos
      path right
      button .ce ' CE '
      text   .currentElem width 40 is STRING
      path down

      frame .cntrl at xmin.ce 'Error Messages'
        -- use tabbed lists here
        list .attList width 45 length 15
        list .opList  width 45 length 7
      exit

      -- form members

      member .dbref      is DBREF
      member .operations is ARRAY
      member .opErrors   is ARRAY
      member .attributes is ARRAY
      member .dacErrors  is ARRAY
    exit
  exit

  button .dismiss at xmax form-size ymax form+0.2 |Dismiss| CANCEL
exit

------------------------------------------------------------------------
--
-- Method:      .qryDac()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .qryDac()
  !this.userAcrs()
  !this.elementAccess()
endmethod
-- End of method definition for .qryDac()

------------------------------------------------------------------------
--
-- Method:      .userAcrs()
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .userAcrs()
  -- Setup the form
  !this.roleName.setEditable(FALSE)
  !this.roleDesc.setEditable(FALSE)
  !this.scopeName.setEditable(FALSE)
  !this.scopeDesc.setEditable(FALSE)
  !this.scopSel.setEditable(FALSE)
  !this.roleName.val = ''
  !this.roleDesc.val = ''
  !this.scopeName.val = ''
  !this.scopeDesc.val = ''
  !this.scopSel.val = ''
  !this.acr.clear()
  !this.listPerop.clear()
  if (undefined(!!qryPerop)) then
    pml load form !!qryPerop
  endif
endmethod
-- End of method definition for .userAcrs()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  !this.initUserAcrs()
  !this.initElementAccess(!!ce)
endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      .initUserAcrs()
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initUserAcrs()
  !prev = !!ce

  --IS dac on?
  if(!!qryDacState())then
    !this.dacState.val = |Data Access Control is currently active|
    !this.dacIsOn = TRUE

    -- activate frames
    !this.userAcrs.active = true
  else
    !this.dacState.val = |Data Access Control is currently inactive|
    !this.dacIsOn = FALSE

    !this.userAcrs.active = false
  endif

  -- Get the users details
  !wishful = CURRENT SESSION
  !dbref = !wishful.user().refNo.dbref()
  !!ce = !dbref
  !currUser = !!ce
  !this.admAcr.clear()
  !this.admPerop.clear()

  -- Get a list of Acrs
  !tempAcrs = !currUser.acrLi
  do !i values !tempAcrs
    if(!i.type EQ |ACR|)then
      !temp = object ADMACR()
      !temp.acr2AdmAcr(!i)
      !this.admAcr.append(!temp)
    elseif(!i.type EQ |ACRST|)then
      do !j values !i.acrGroup
        !temp = object ADMACR()
        !temp.acr2AdmAcr(!j)
        !this.admAcr.append(!temp)
      enddo
    endif
  enddo
  !this.admAcr.sort()
  !this.admAcr.unique()
  !config = object ADMDISPLAYCONFIG()
  !config.reset()
  if(!this.admAcr.size() GT 0)then
    -- !!admAcrTxtList(!this.admAcr, !this.acr, !config.acrFormat, TRUE)
    !this.acrTxtList()
    !scope = !this.admAcr[!this.acr.val].scoref
    !role = !this.admAcr[!this.acr.val].rolref
    !this.displayAcr(!role, !scope)
  endif

  !!ce = !prev
endmethod
-- End of method definition for .initUserAcrs()

------------------------------------------------------------------------
--
-- Method:      .acrTxtList()
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .acrTxtList()
  !admAcr = !this.admAcr
  !block = object BLOCK('!admAcr[!evalIndex].dbref.string()')
  !dbrefStrs = !admAcr.evaluate(!block)

  var !names eval ( substring(NAME, 2) ) for all from !dbrefStrs
  var !descs eval ( description ) for all from !dbrefStrs

  !block = object BLOCK('!names[!evalIndex] & |	| & !descs[!evalIndex]')
  !dtext = !names.evaluate(!block)

  !this.acr.dtext = !dtext
  !this.acr.rtext = !dbrefStrs
endmethod
-- End of method definition for .acrTxtList()

------------------------------------------------------------------------
--
-- Method: .peropGet()
--
-- Description: Method to enable desperop to find out which perop is currently being viewed
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--    ADMPEROP    The perop currently selected
--
------------------------------------------------------------------------
define method .peropGet() is ADMPEROP
  return !this.admPerop[!this.listPerop.val]
endmethod
-- End of method definition for .peropGet() ADMPEROP

------------------------------------------------------------------------
--
-- Method: .displayPerop()
--
-- Description: Function to a) decide if to display form
--                          b) to display it
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayPerop()
  if(!this.acr.dtext.size() GT 0)then
    if(!this.listPerop.dtext.size() GT 0)then
      !!qryPerop.displayPerop(!this.admPerop[!this.listPerop.val])
    else
      -- ##
      !!alert.error(|There are no perops for this Role, this is unusual!|)
    endif
  endif
endmethod
-- End of method definition for .displayPerop()

------------------------------------------------------------------------
--
-- Method: .displayAcr()
--
-- Description: Method which takes a dbref of a role and a scope and displays them
-- this form.
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      dbref       The Role to be displayed
--   2   R      dbref       The Scope to be displayed
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayAcr(!role is DBREF,!scope is DBREF)
  -- Assign Scope data
  if(!scope.set())then
    !this.scopeName.val   = !scope.name.substring(2)
    if (!scope.description.empty()) then
      !this.scopeDesc.val   = |unset|
    else
      !this.scopeDesc.val   = !scope.description
    endif
    if(!scope.scosel.set())then
      !saveCe = !!ce
      !!ce = !scope
      var !tempo SCOSEL
      !this.scopSel.val = !tempo.trim()
      !!ce = !saveCe
      !!ce
    else
      !this.scopSel.val = ||
    endif
  endif
  -- Get Role Data
  if(!role.set())then
    !this.roleName.val   = !role.name.substring(2)
    if (!role.description.empty()) then
      !this.roleDesc.val   = |unset|
    else
      !this.roleDesc.val   = !role.description
    endif
    -- Get the perops
    !this.admPerop.clear()
    -- I don't Like this although it is a fast and quick way of getting the perops (remembering the mem of a role are perops)
    !perops = !role.mem
    if(!perops.size() GT 0)then
      do !i values !perops
        !tempp = object ADMPEROP()
        !tempp.perop2AdmPerop(!i)
        !this.admPerop.append(!tempp)
      enddo
      -- this used to call !!admPeropTxtList, but we now need tabs rather than spaces
      -- !!admPeropTxtList can't be modified because it's used in Admin, where spaces are needed
      -- !!admPeropTxtList(!this.admPerop,!this.listPerop,TRUE)
      !this.peropTxtList()
    endif
  endif
  -- Reset Perop form (if shown)
  if(!!qryPerop.shown())then
    !this.displayPerop()
  endif
endmethod
-- End of method definition for .displayAcr(dbref,dbref)

------------------------------------------------------------------------
--
-- Method:      .peropTxtList()
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .peropTxtList()
  !dtext = ARRAY()
  !rtext = ARRAY()

  do !perop values !this.admPerop
    !name = !perop.name.substring(2)
    !acrMes = !perop.acrMessage
    if (!acrMes.empty()) then
      !acrMes = 'unset'
    endif

    -- !dtext.append('<PEROP> ' & !name & '' & !acrMes)
    !dtext.append(!name & '	' & !acrMes)
    !rtext.append(!perop.dbref.string())
  enddo

  !this.listPerop.dtext = !dtext
  !this.listPerop.rtext = !rtext

endmethod
-- End of method definition for .peropTxtList()


------------------------------------------------------------------------
--
-- Method:      .elementAccess
--
-- Description:
--   Constructor for Element Access frame
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .elementAccess()

  -- callbacks
  !this.ce.callback              = '!this.initElementAccess(!!ce)'
  !this.currentElem.callback     = '!this.initElementAccess(!this.currentElem.val)'

  -- Tooltips
  !this.ce.setTooltip('Load Form with the Current Element')
  !this.currentElem.setTooltip('Type in the Element Name Directly')
  !this.dismiss.setTooltip('Dismiss the form')

endmethod
-- End of method definition for .elementAccess()

------------------------------------------------------------------------
--
-- Method:      initElementAccess
--
-- Description:
--   Initialisation for the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initElementAccess(!dbref is DBREF)

  -- if dbref is unset
  if (!dbref.unset()) then
    !this.attList.clear()
    !this.opList.clear()
    return
  endif

  -- load form with CE details

  !this.dbref = !dbref
  !this.currentElem.val = !this.dbref.fullname

  -- load attributes for ce

  !this.attributes = !this.dbref.attributes()

  -- load errors for the attributes

  !this.getErrors()

  -- load the operations

  !this.getOperations()

  -- load errors for operations

  !this.getOpErrors()

  -- populate list with attributes and their values

  !this.attList.dtext = !this.displayAllData(!this.attributes, !this.dacErrors, 'Attribute')
  !this.attList.rtext = !this.displayAllData(!this.attributes, !this.dacErrors, 'Attribute')

  !this.opList.dtext = !this.displayAllData(!this.operations, !this.opErrors, 'Operation')
  !this.opList.rtext = !this.displayAllData(!this.operations, !this.opErrors, 'Operation')

endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:      initialise(name)
--
-- Description:
--   Initialisation for the form from the CE Button
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]     [Passed PDMS name from the text gadget on the form]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initElementAccess(!name is STRING)

  -- check it is a valid name

  !checkName = !!checkName(!name, 'OLD')
  if (!checkName.unset()) then
    !this.initElementAccess(object dbref())
    return
  endif

  !dbref = !checkName.dbref()
  handle ANY
    !this.currentElem.setFocus()
    return error 1 'PDMS name entered does not exist'
  endhandle

  -- load form with current element details from the text gadget
  !this.initElementAccess(!dbref)
endmethod
-- End of method definition for .initElementAccess(STRING)

------------------------------------------------------------------------
--
-- Method:      getErrors
--
-- Description:
--   Get Dac Errors for all the attributes of the element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getErrors()
  !this.dacErrors.clear()
  do !i values !this.attributes
    !attTest = !this.dbref.dacErr.attribute(!i)
    handle ANY
      -- above line don't work for :uda's
      !attTest = DACERR $!i of $!this.dbref
    endhandle
    if(!attTest.eq('')) then
      !dacError = 'Write access allowed to this attribute'
    else
      !dacError = !attTest
    endif
    !this.dacErrors.append(!dacError)
  enddo

endmethod
-- End of method definition for .getErrors()

------------------------------------------------------------------------
--
-- Method:      getOperations
--
-- Description:
--   Get DAC Operators Claim,drop,issue,create,delete
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getOperations()

  !this.operations[1] = 'Claim'
  !this.operations[2] = 'Issue'
  !this.operations[3] = 'Drop'
  !this.operations[4] = 'Create'
  !this.operations[5] = 'Delete'

endmethod
-- End of method definition for .getOperations()

------------------------------------------------------------------------
--
-- Method:      getOpErrors
--
-- Description:
--   Get operation errors of the dbref for the display
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getOpErrors()

  !this.opErrors.clear()

  -- PML 2 doesn't work on all operations
  do !i values !this.operations
    !dacErr = DACERR $!i of $!this.dbref
    if(!dacErr.eq('')) then
      !dacError = 'You have Access to this Operation'
    else
      var !dacError  DACERR $!i of $!this.dbref
    endif
    !this.opErrors.append(!dacError)
  enddo

endmethod
-- End of method definition for .getOpErrors()

------------------------------------------------------------------------
--
-- Method:     .displayAllData(ARRAY, ARRAY, STRING)
--
-- Description: compose display of the attributes and their errors
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [ARRAY]     [Array of attributes or operations]
--   [2] [R]    [ARRAY]     [Array of corresponding dac errors]
--   [3] [R]    [STRING]    [String to display in first column]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [Of output strings for displaying in the form]
--
------------------------------------------------------------------------
define method .displayAllData(!attOrOper is ARRAY, !dacError is ARRAY, !firstColumn is STRING) is ARRAY

  -- compose tabulated table of data for errors
  !output[1] = !firstColumn & '	DAC Error Message'

  do !i indices !attOrOper
    !output.append(!attOrOper[$!i] & '	' & !dacError[!i])
  enddo

  -- set list with the results
  return !output

endmethod
-- End of method definition for .displayAllData(ARRAY, ARRAY, STRING)
