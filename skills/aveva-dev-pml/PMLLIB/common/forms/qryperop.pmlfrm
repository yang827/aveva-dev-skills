--
--
-- Description:
-- Form to display user perops, called from form desUserAcr
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  displayPerop(ADMPEROP)           -                   initialise form
--  operationDesc(GADGET,STRING,STRING) -                   Display permissions for various operations
--  qryPerop()                       -                   Constructor method
--
------------------------------------------------------------------------
setup form !!qryPerop

  !this.formTitle     = 'Perop Properties'
  !this.iconTitle     = 'Perop'
  !this.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition
  text   .name   |Name|                        width 32 scroll 50 STRING
  path down
  list   .eclass |                           | width 35 height 6
  path right
  list   .aclass |                           | width 35 height 6
  path down
  text   .cond   at xmin.name |Qualifying Condition       |    width 46 scroll 200 STRING
  text   .acrMes              |Message (if access Refused)|    width 46 scroll 120 STRING
  frame  .operations |Operations| width 75
    vdist 0
    paragraph .modify at x20 ymax  text |Modify :                                     |
    paragraph .create   text |Create :                                     |
    paragraph .delete   text |Delete :                                     |
    paragraph .claim    text |Claim  :                                     |
    paragraph .issue    text |Issue  :                                     |
    paragraph .drop     text |Drop   :                                     |
  exit
  vdist 0.25
  button .dismiss at xmax form-size ymax+0.2 |Dismiss| CANCEL

  --Member Definitions
  member .perop is ADMPEROP

exit
-- End of form definition for !!qryPerop

------------------------------------------------------------------------
--
-- Method:      .qryPerop()
--
-- Description: Constructor method
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .qryPerop()
  !this.name.setEditable(FALSE)
  !this.cond.setEditable(FALSE)
  !this.acrMes.setEditable(FALSE)
--  !this.connect.setEditable(FALSE)
endmethod
-- End of method definition for .qryPerop()

------------------------------------------------------------------------
--
-- Method:      .displayPerop()
--
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayPerop(!object is ADMPEROP)
  if (!this.shown().not()) then
    !this.show()
  endif

  -- Set the form gadgets
  !this.name.val     = !object.name.subString(2)
  !this.eclass.dText = !object.eclass
  !this.aclass.dText = !object.aclass
  !tempCond          = !object.cond.subString(1,!object.cond.length() -  1)
  !tempCond          = !tempCond.subString(2)
  !this.cond.val     = !tempCond.trim()
  !this.acrMes.val   = !object.acrMessage
  -- operations
  !this.operationDesc( !this.modify, 'Modify', !object.modify )
  !this.operationDesc( !this.create, 'Create', !object.create )
  !this.operationDesc( !this.delete, 'Delete', !object.delete )
  !this.operationDesc( !this.claim,  'Claim',  !object.claim )
  !this.operationDesc( !this.issue,  'Issue',  !object.issue )
  !this.operationDesc( !this.drop,   'Drop',   !object.drop )
  -- NOT
  if( !object.eNot ) then
    !this.eclass.tag = 'Access to all elements except'
  else
    !this.eclass.tag = 'Access to elements           '
  endif
  if( !object.aNot ) then
    !this.aclass.tag = 'Access to all attributes except'
  else
    !this.aclass.tag = 'Access to attributes           '
  endif

endmethod
-- End of method definition for .displayPerop(ADMPEROP)

------------------------------------------------------------------------
--
--Method: .operationDesc()
--
-- Description: Display permissions for various operations
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .operationDesc( !gadget is GADGET, !operation is STRING, !opValue is STRING )

  !opCode    = !opValue.upcase()
  !opMessage = !operation + '        '
  !opMessage = !opMessage.subString(1,10)
  if( !opCode eq 'IGNORE' ) then
    !opMessage = !opMessage + ' permission not defined'
  elseif( !opCode eq 'ALLOW' ) then
    !opMessage = !opMessage + ' permission is granted '
  elseif( !opCode eq 'DISALLOW' ) then
    !opMessage = !opMessage + ' permission is denied  '
  else
    !opMessage = !opMessage + ' not defined'
  endif
  !gadget.val  = !opMessage

endmethod
-- End of method definition for .operationDesc()
