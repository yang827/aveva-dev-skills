-- Created:         Mon Jan 4 11:11:42 GMT 1999
--
--
-- Description:
-- A form to display user's ACRs
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  displayPerop()                   -                   Function to a) decide if to display form
--  displayThem(DBREF,DBREF)         -                   Method which takes a dbref of a role and a scope and displays them
--  init()                           -
--  peropGet()                       ADMPEROP            Method to enable desperop to find out which perop is currently being viewed
--  qryUserAcr()                     -                   Constructor
--
------------------------------------------------------------------------


setup form !!qryUserAcr

  !this.formTitle     = |User Rights|
  !this.iconTitle     = 'ACRS'
  !this.callback      = '!!qryUserAcr.init()'
  !this.formRevision  = ' $Revision: 1.12 $ '

  -- Body of form definition
  para .dacState at x 1 y 0.2 width 50
  list .acr at xmin ymax+0.5 |ACRs that apply to current user| call |!this.displayThem(!this.admAcr[!this.acr.val].rolref,!this.admAcr[!this.acr.val].scoref)| width 47 height 4

  frame .role at xmin ymax+0.2 |Role|
    text   .roleName at x 1 y 1          |Name        | width 20 scroll 32 STRING
    text   .roleDesc at xmin.roleName ymax+0.2 |Description | width 34 scroll 120 STRING
    frame  .rolePerop at xmin  ymax+0.5     |Permissible Operations|
      list .listPerop call |!this.displayPerop()| width 42 height 5
    exit
  exit
  frame .scope at xmin ymax+0.5 |Scope|
    text   .scopeName at x 1 y 1           |Name        | width 20 scroll 32 STRING
    text   .scopeDesc at xmin.scopeName ymax+0.2  |Description | width 34 scroll 120 STRING
    para   .scopSelTxt at xmin ymax+0.2 text |Scope Selection|
    text   .scopSel at xmin ymax+0.2 width 46 scroll 256 STRING
  exit

 -- button .Refresh at xmin ymax +0.2 |Refresh| call |!this.init()|
  button .dismiss at xmax form-size ymax.scope+0.5 |Dismiss| CANCEL

  -- members
  member .admAcr   is ARRAY
  member .admPerop is ARRAY
  member .dacIsOn  is BOOLEAN

exit
-- End of form definition for !!qryUserAcr
------------------------------------------------------------------------
--
-- Method:      qryUserAcr()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .qryUserAcr()

--IS dac on?
  if(!!qryDacState())then
    !this.dacState.val = |Data Access Control is currently active|
    !this.dacIsOn = TRUE
  else
    !this.dacState.val = |Data Access Control is currently inactive|
    !this.dacIsOn = FALSE
  endif

endmethod
-- End of method definition for .qryUserAcr()
------------------------------------------------------------------------
--
-- Method:  .init()
--
-- Description:
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
  -- Setup the form
 -- !this.dacState.setEditable(FALSE)
  !this.roleName.setEditable(FALSE)
  !this.roleDesc.setEditable(FALSE)
  !this.scopeName.setEditable(FALSE)
  !this.scopeDesc.setEditable(FALSE)
  !this.scopSel.setEditable(FALSE)
  !this.roleName.val = ''
  !this.roleDesc.val = ''
  !this.scopeName.val = ''
  !this.scopeDesc.val = ''
  !this.scopSel.val = ''
  !this.acr.clear()
  !this.listPerop.clear()
  pml load form !!qryPerop

  !prev = !!ce

  --IS dac on?
  if(!!qryDacState())then
    !this.dacState.val = |Data Access Control is currently active|
    !this.dacIsOn = TRUE
  else
    !this.dacState.val = |Data Access Control is currently inactive|
    !this.dacIsOn = FALSE
  endif

  -- Get the users details
  !wishful = CURRENT SESSION
  !dbRef = !wishful.user().refNo.dbRef()
  !!ce = !dbRef
  !currUser = !!ce
  !this.admAcr.clear()
  !this.admPerop.clear()

  -- Get a list of Acrs
  !tempAcrs = !currUser.acrLi
  do !i values !tempAcrs
    if(!i.type EQ |ACR|)then
      !temp = object ADMACR()
      !temp.acr2AdmAcr(!i)
      !this.admAcr.append(!temp)
    elseif(!i.type EQ |ACRST|)then
      do !j values !i.acrGroup
        !temp = object ADMACR()
        !temp.acr2AdmAcr(!j)
        !this.admAcr.append(!temp)
      enddo
    endif
  enddo
  !this.admAcr.sort()
  !this.admAcr.unique()
  !config = object ADMDISPLAYCONFIG()
  !config.reset()
  if(!this.admAcr.size() GT 0)then
    !!admAcrTxtList(!this.admAcr, !this.acr, !config.acrFormat, TRUE)
    !scope = !this.admAcr[!this.acr.val].scoref
    !role = !this.admAcr[!this.acr.val].rolref
    !this.displayThem(!role, !scope)
  endif

  !!ce = !prev
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method: .peropGet()
--
-- Description: Method to enable desperop to find out which perop is currently being viewed
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--    ADMPEROP    The perop currently selected
--
------------------------------------------------------------------------
define method .peropGet() is ADMPEROP
  return !this.admPerop[!this.listPerop.val]
endmethod
-- End of method definition for .peropGet() ADMPEROP
------------------------------------------------------------------------
--
-- Method: .displayPerop()
--
-- Description: Function to a) decide if to display form
--                          b) to display it
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayPerop()
  if(!this.acr.dText.size() GT 0)then
    if(!this.listPerop.dText.size() GT 0)then
      if( !!qryPerop.shown() ) then
        !!qryPerop.init()
      else
        show !!qryPerop
      endif
    else
      -- ##
      !!alert.error(|There are no perops for this Role, this is unusual!|)
    endif
  endif
endmethod
-- End of method definition for .displayPerop()
------------------------------------------------------------------------
--
-- Method: .displayThem()
--
-- Description: Method which takes a dbref of a role and a scope and displays them
-- this form.
--
-- Method Type: Function/ Procedure
-- Arguments:
--  [#] [R/RW] [Data Type] [Description]
--   1   R      DBREF       The Role to be displayed
--   2   R      DBREF       The Scope to be displayed
-- Return:
--  [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayThem(!role is DBREF,!scope is DBREF)
   -- Assign Scope data
  if(!scope.set())then
    !this.scopeName.val   = !scope.name.subString(2)
    if (!scope.description.empty()) then
      !this.scopeDesc.val   = |unset|
    else
      !this.scopeDesc.val   = !scope.description
    endif
    if(!scope.scosel.set())then
      !saveCe = !!ce
      !!ce = !scope
      var !tempo SCOSEL
      !this.scopSel.val = !tempo.trim()
      !!ce = !saveCe
      !!ce
    else
      !this.scopSel.val = ||
    endif
  endif
  -- Get Role Data
  if(!role.set())then
    !this.roleName.val   = !role.name.subString(2)
    if (!role.description.empty()) then
      !this.roleDesc.val   = |unset|
    else
      !this.roleDesc.val   = !role.description
    endif
    -- Get the perops
    !this.admPerop.clear()
    -- I don't Like this although it is a fast and quick way of getting the perops (remembering the mem of a role are perops)
    !perops = !role.mem
    if(!perops.size() GT 0)then
      do !i values !perops
        !tempp = object ADMPEROP()
        !tempp.perop2AdmPerop(!i)
        !this.admPerop.append(!tempp)
      enddo
      !!admPeropTxtList(!this.admPerop,!this.listPerop,TRUE)
    endif
  endif
  -- Reset Perop form (if shown)
  if(!!qryPerop.shown())then
    !!qryPerop.init()
  endif
endmethod
-- End of method definition for .displayThem(DBREF,DBREF)
