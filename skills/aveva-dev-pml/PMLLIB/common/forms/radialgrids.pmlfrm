--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Dec 11 10:58:29 WAT 1997
--
--
-- Description:
-- Definition form for radial grid(s).
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  anglesRead()                     -                   Read angles from grid and write them to the form "ANGLES" gadget
--  anglesWrite()                    -                   Write ANGLES from form to angles of grid
--  apply()                          -                   Apply form
--  close()                          -                   Close form and tidy
--  incrementAngles(REAL)            ARRAY               Returns array on increment angles from 0 to 360
--  initialise()                     -                   Initialisation of form
--  pcdRead()                        -                   Read PCD (radii) from grid and write them to the form "PCDS" gadget
--  pcdWrite()                       -                   Write PCDS from form to radii of grid
--  pickOrientation(STRING)          -                   Setup to define orientation using edg
--  preview(BOOLEAN)                 -                   Preview the plane
--  radialGrids()                    -                   Constructor
--  setAngles()                      -                   Set angles to increment
--  setWrt()                         -                   Set up with new wrt item
--  setup(REAL)                      -                   Setup data for form to be shown
--  setup(STRING,STRING,GPHRADIALGRID) -                   Show the form and set up with passed data
--  setupForm()                      -                   Setup form to current grid definition
--  tidy()                           -                   Tidy form data
--  updateAid(REAL)                  -                   Update/create passed aid number with plane definition
--
------------------------------------------------------------------------

-- Define form
setup form !!radialGrids

  !!radialGrids.formTitle     = 'Radial Grids'
  !!radialGrids.iconTitle     = 'RGrids'
  !!radialGrids.callback      = '!this.initialise()'
  !!radialGrids.formRevision  = ' $Revision: 1.19 $ '

  -- Body of form definition

  -- Options
  frame .optionFrame 'Options' at x0.2  ymax

    toggle .label     ' Label ' at x2     ymax states 'FALSE' 'TRUE'
    toggle .detail    ' Detail' at xmax+2 ymin states 'FALSE' 'TRUE'

    -- Settings
    frame .spacingFrame 'Settings' at x1 ymax

      -- Equal Angle
      text .angle 'Angle Increment'     at x1 y1 callback '!this.setAngles()' tagwidth 12 width 11 is REAL format !!angleFmt
      path down
      halign right
      vdist 0
      textpane .angles  'Angles'    at x1 ymax+0.1  width 14 length 5
      path right
      textpane .pcds    'Diameters' at xmax+1 ymin  width 14 length 5
      vdist 0.5
    exit

    -- Preview Change
    path down
    halign right
    button .previewSpacing 'Preview' callback '!this.preview(false)'

  exit

  -- Positioning Gadgets
  frame .posOriFrame 'Position & Orientation' at xmin ymax+0.2
    -- Positioning Gadgets
    frame .positionFrame 'Position' at x1 ymax
      path down
      option .ew at x1 y1.5 width 5
      option .ns width 5
      option .ud width 5
      text   .x     at xmax+1 ymin.ew width 14 is REAL format !!distanceFmt
      text   .y     at xmin   ymin.ns width 14 is REAL format !!distanceFmt
      text   .z     at xmin   ymin.ud width 14 is REAL format !!distanceFmt
      toggle .xFlag at xmax+1 ymin.ew
      toggle .yFlag at xmin   ymin.ns
      toggle .zFlag at xmin   ymin.ud

      para   .lock  at xmin.xFlag-1 ymin.xFlag-1 text 'Lock'
    exit

    -- Orientation Gadgets and Setting
    frame .orientationFrame 'Orientation' at xmin ymax+0.2

      -- EDG Set orientation
      button .edgOri3 pixmap width 24 height 24 tooltip 'Through three points'  callback '!this.pickOrientation(''3picks'')'
      path right
      button .edgOri2 pixmap width 24 height 24 tooltip 'Through origin and two points'  callback '!this.pickOrientation(''2picks'')'

      text .yDir 'Y is' at x1   ymax+0.25 width 23 is STRING
      text .zDir 'Z is' at xmin ymax+0.2  width 23 is STRING
      halign right
      path down
      paragraph .xDir at x1 ymax+0.2 width 28 lines 1
      halign left
    exit

    --  Reference (wrt)
    halign right
    text .wrt 'wrt' callback '!!radialGrids.setWrt()' at x2 ymax+0.2 width 25 string

  exit

  -- Apply/Dismiss
  button .apply   ' OK '   at xmin form-0    ymax form+0.25 callback '!this.apply()' ok
  button .dismiss 'Cancel' at xmax form-size ymin           callback '!this.close()' cancel

  -- Form Members
  -- Plane definition
  member .grid         is GPHRADIALGRID

  -- Aid number being modified
  member .aidGrid      is REAL

  -- Aid numbers for position & axes
  member .aidNumber    is REAL

  -- Form Control Members
  -- Position
  member .position     is POSITIONLINK
  -- Orientation
  member .orientation  is ORIENTATIONLINK

  -- Description
  member .description  is STRING
  !!radialGrids.description = 'Default plant Grid Definition'

  -- Action on apply
  member .action       is STRING

exit
-- End of form definition for !!radialGrids

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Link Position Option Gadgets to Objects in current coordinate system
  var !coordinate coordinate
  !this.position.linkOption('!!radialGrids.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Set Position Action
  !this.position.setAction('')

  -- Setup form
  !this.setupForm()

  -- Set Position Action
  !this.position.setAction('!!radialGrids.preview(true)')

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      radialGrids
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .radialGrids()

  -- set icons
  !this.edgOri3.addPixmap(!!pml.getPathName('ori3points24.png'))
  !this.edgOri2.addPixmap(!!pml.getPathName('ori2points24.png'))

   -- Link Position Input Gadgets to Objects
  !this.position.linkInput('!!radialGrids.position', !this.x, !this.y, !this.z)

  -- Link Position Lock Gadgets to Objects
  !this.position.linkLock('!!radialGrids.position', !this.xFlag, !this.yFlag, !this.zFlag)

  -- Link Position Option Gadgets to Objects
  var !coordinate coordinate
  !this.position.linkOption('!!radialGrids.position', !this.ew, !this.ns, !this.ud, !coordinate)

  -- Link Orientation Gadgets to Object
  !this.orientation.linkInput('!!radialGrids.orientation', 'Y', !this.yDir, 'Z', !this.zDir, 'X', !this.xDir)

  -- Set Orientation Action
  !this.orientation.setAction('!!radialGrids.preview(true)')

  -- Aid Lines Number
  if(!this.aidNumber.unset()) then
    !this.aidNumber = !!aidNumbers.add(!this.grid)
  endif

endmethod
-- End of method definition for .radialGrids()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description: Set up with new wrt item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.position.get().origin
  endif

  -- Set tagging method up
  !this.position.setWrt(!wrtItem)
  !this.orientation.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form and tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Tidy form data
  !this.tidy()

  -- Revert the edg graphics back
  !!edgCntrl.remove(!this.description)

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      tidy
--
-- Description: Tidy form data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tidy()

   -- Hide Modification Grid
  !!aidNumbers.hide(!this.aidNumber)

endmethod
-- End of method definition for .tidy()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Current Data
  !position    = !this.position.get()
  !orientation = !this.orientation.get()

  -- Write data to plane member
  !this.grid.tag          = !this.label.val
  !this.grid.detail       = !this.detail.val
  !this.grid.basic        = false
  !this.grid.position(!position)
  !this.grid.orientation(!orientation)
  !this.pcdWrite()
  !this.anglesWrite()

  -- Modifying an aid or carry out an action
  if(!this.aidGrid.set()) then
    !!aidNumbers.replace(!this.aidGrid, !this.grid)

  -- Carry out action
  else
    $!this.action
  endif

  -- Close
  !this.close()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup data for form to be shown
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number being modified/created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!aidNumber is REAL)

  -- Initialise form action
  !this.action            = STRING()

  -- Set form data
  !this.aidGrid           = !aidNumber
  !this.formTitle         = 'Modify grid [' & !aidNumber & ']'
  !this.grid              = !!aidNumbers.numbers[!aidNumber]
  !this.description       = 'Edit aid radial grid definition'

  -- If already shown, then re-initialise
  if(!this.shown()) then
    !this.setupForm()
  endif

endmethod
-- End of method definition for .setup(REAL)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Show the form and set up with passed data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]  [Description]
--    1   R      STRING       Description
--    2   R      STRING       Action to be carried out on apply
--    3   R      GPHPLANTGRID Reference plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setup(!description is STRING, !actionCommand is STRING, !newGrid is GPHRADIALGRID)

  -- Define Action on apply
  !this.action           = !actionCommand

  -- Set form data
  !this.aidGrid          = REAL()
  !this.grid             = !newGrid
  !this.formTitle        = !description
  !this.description      = !description

  -- If already shown, then re-initialise
  if(!this.shown()) then
    !this.setupForm()
  endif

endmethod
-- End of method definition for .setup(STRING, STRING, GPHRADIALGRID)

------------------------------------------------------------------------
--
-- Method:      setupForm
--
-- Description: Setup form to current grid definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setupForm()

  -- Unlock all gadgets
  !this.position.unlockAll()

  -- If plane is unset, then initialise it to default 000
  if(!this.grid.coreObject().unset()) then
    !this.grid.position(object POSITION('E0 N0 U0'))
    !this.grid.orientation(object ORIENTATION('Y is N'))
  endif

  -- Get basic core object
  !plane = !this.grid.plane()

  -- Set display toggles
  !this.label.val  = !this.grid.tag
  !this.detail.val = !this.grid.detail

  -- Set spacing
  !this.pcdRead()
  !this.anglesRead()

  -- Set with respect to
  !this.position.setWrt(!plane.position.origin)
  !this.orientation.setWrt(!plane.position.origin)

  -- Load form with plane definition
  !this.position.setPositionForce(!plane.position)
  !this.orientation.setOrientation(!plane.orientation)


  -- Set form wrt gadget
  !this.setWrt()

endmethod
-- End of method definition for .setupForm()

------------------------------------------------------------------------
--
-- Method:      preview
--
-- Description: Preview the plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     True for Basic representation of grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .preview(!basic is BOOLEAN)

  -- Current Data
  !position    = !this.position.get()
  !orientation = !this.orientation.get()

  -- Write data to plane member
  !this.grid.tag          = !this.label.val
  !this.grid.detail       = !this.detail.val
  !this.grid.basic        = !basic
  !this.grid.position(!position)
  !this.grid.orientation(!orientation)
  !this.pcdWrite()
  !this.anglesWrite()
  !this.pcdRead()
  !this.anglesRead()

  -- Replace current definition
  !!aidNumbers.replace(!this.aidNumber, !this.grid)
  -- !this.grid.draw(!this.aidNumber)

endmethod
-- End of method definition for .preview(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      pickOrientation
--
-- Description: Setup to define orientation using edg
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Ori definition type  3picks
--                                                2picks
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pickOrientation(!type is STRING)

  -- Define a pick packet
  !packet          = object EDGPACKET()
  !packet.orientationLink('!!radialGrids.orientation', 'Orientate Plane')

  -- Two pick plane
  if(!type.upcase() eq '2PICKS') then
    -- Define specific for "definePlane" orientation
    !packet.pickPacket.plane2Pnts(!this.position.get())
  endif

  !packet.remove   = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .pickOrientation(STRING)

------------------------------------------------------------------------
--
-- Method:      pcdRead
--
-- Description: Read PCD (radii) from grid and write them to the form "PCDS" gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pcdRead()

  -- Initialise Variables
  !pcds = ARRAY()

  -- Get radii
  do !radius values !this.grid.grid.radii
    !diameter = !radius * 2
    !pcds.append(!diameter.string(!!distanceFmt))
  enddo

  -- Write to form
  !this.pcds.val = !pcds

endmethod
-- End of method definition for .pcdRead()

------------------------------------------------------------------------
--
-- Method:      pcdWrite
--
-- Description: Write PCDS from form to radii of grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .pcdWrite()

  -- Initialise Variables
  !radii = ARRAY()

  -- Get pcds and make them unique
  !pcds  = !this.pcds.val
  !pcds.unique()

  -- Get radii
  do !diameters values !pcds
    -- Ignore null entry in textpane
    skip if (!diameters.trim() eq ||)
    !radius = !diameters.real(!!distanceFmt) / 2
    !radii.append(!radius)
  enddo

  !radii.sort()

  -- Write to form
  !this.grid.grid.radii = !radii

endmethod
-- End of method definition for .pcdWrite()

------------------------------------------------------------------------
--
-- Method:      anglesRead
--
-- Description: Read angles from grid and write them to the form "ANGLES" gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .anglesRead()

  -- Initialise Variables
  !angles = ARRAY()

  -- Get radii
  do !angle values !this.grid.grid.angles
    !angles.append(!angle.string())
  enddo

  -- Write to form
  !this.angles.val = !angles

endmethod
-- End of method definition for .anglesRead()

------------------------------------------------------------------------
--
-- Method:      anglesWrite
--
-- Description: Write ANGLES from form to angles of grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .anglesWrite()

  -- Initialise Variables
  !angles     = ARRAY()

  -- Get pcds and make them unique
  !anglesList = !this.angles.val
  !anglesList.unique()

  -- Get radii
  do !angle values !anglesList
    -- Ignore null entry in textpane
    skip if (!angle.trim() eq ||)
    !angles.append(!angle.real(!!angleFmt))
  enddo

  !angles.sort()

  -- Write to form
  !this.grid.grid.angles = !angles

endmethod
-- End of method definition for .anglesWrite()

------------------------------------------------------------------------
--
-- Method:      incrementAngles
--
-- Description: Returns array on increment angles from 0 to 360
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle increment
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of angles of increment
--
------------------------------------------------------------------------

-- Define method
define method .incrementAngles(!angle is REAL) is ARRAY

  -- Return, if none set
  if(!angle.unset()) then
    return
  endif

  -- Initialise Variables
  !angles = ARRAY()
  !angles.append('0')

  -- Define angles
  do !i from 1 to int(359.9 / !angle)
    !angles.append(string(!angle * !i))
  enddo

  return !angles

endmethod
-- End of method definition for .incrementAngles(REAL) ARRAY

------------------------------------------------------------------------
--
-- Method:      setAngles
--
-- Description: Set angles to increment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setAngles()

  -- Check we haven't put zero in
  if(!this.angle.val.between(1,360).not()) then
    !!alert.error('Value must be between 0 and 360')
    return
  endif

  !this.angles.val = !this.incrementAngles(!this.angle.val)

endmethod
-- End of method definition for .setAngles()

------------------------------------------------------------------------
--
-- Method:      updateAid
--
-- Description: Update/create passed aid number with plane definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .updateAid(!aidNumber is REAL)

  -- Update aid system
  !!aidNumbers.replace(!aidNumber, !this.grid)

endmethod
-- End of method definition for .updateAid(REAL)
