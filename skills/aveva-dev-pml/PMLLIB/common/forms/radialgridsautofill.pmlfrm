--
--
-- Description:
-- Autofill plant grid IDs and offsets
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  angleToCheck(GADGET,STRING)      -                   Validation
--  apply()                          -                   Apply form
--  idFormat(GADGET,GADGET,GADGET)   -                   Validation
--  idFrom(GADGET,GADGET)            -                   Validation
--  idOrder(GADGET,GADGET)           -                   Validation
--  initialise()                     -                   Initialisation of form
--  radialGridsAutofill()            -                   Constructor
--  unsetCheck(GADGET,REAL)          -                   Validation
--  unsetNegZeroCheck(GADGET,REAL)   -                   Validation
--  unsetNegativeCheck(GADGET,REAL)  -                   Validation
--  writeBack(GADGET,GADGET,GADGET,GADGET,GADGET,GADGET,GADGET,GADGET,GADGET,GADGET,GADGET) -                   Write data back to parent form
--
------------------------------------------------------------------------

-- Define form
setup form !!radialGridsAutofill

  !!radialGridsAutofill.formTitle     = 'Autofill Radial Grid System'
  !!radialGridsAutofill.iconTitle     = 'Gridsystem'
  !!radialGridsAutofill.formRevision  = ' $Revision: 1.0 $ '

  -- Angles
  frame .aFrame 'Angles' anchor top+bottom+left

    text .aAxisLabel      'Label'        at xmin+0.5 ymin+0.8 tagwidth 9 width 10 is STRING
    path right

    text .aOffsetFrom     'Angles from'  at xmin ymax+0.2 tagwidth 9 width 14 is REAL
    text .aOffsetTo       'to'           width 14 is REAL
    text .aOffsetInterval 'interval'     tagwidth 6 width 7 is REAL

    option .aIdFormat     'IDs format'   at xmin.aAxisLabel ymax+0.2 tagwidth 9 width 7
    option .aIdOrder                     width 8
    text   .aIdFrom       'from'         at xmax.aOffsetTo-size tagwidth 4 width 4 is STRING
    text   .aIdInterval   'interval'     at xmax.aOffsetInterval-size tagwidth 6 width 7 is REAL

  exit
  path down

  -- Radii
  frame .rFrame 'Radii' anchor top+bottom+left

    text .rAxisLabel      'Label'        at xmin+0.5 ymin+0.8 tagwidth 9 width 10 is STRING
    path right

    text .rOffsetFrom     'Radii from'   at xmin ymax+0.2 tagwidth 9 width 14 is REAL format !!distanceFmt
    text .rOffsetTo       'to'           width 14 is REAL format !!distanceFmt
    text .rOffsetInterval 'interval'     tagwidth 6 width 7 is REAL format !!distanceFmt

    option .rIdFormat     'IDs format'   at xmin.rAxisLabel ymax+0.2 tagwidth 9 width 7
    text   .rIdFrom       'from'         at xmax.rOffsetTo-size tagwidth 4 width 4 is STRING
    text   .rIdInterval   'interval'     at xmax.rOffsetInterval-size tagwidth 6 width 7 is REAL

  exit
  path down

  -- Z axis
  frame .zFrame 'Z Axis' anchor top+bottom+left

    text .zAxisLabel      'Label'        at xmin+0.5 ymin+0.8 tagwidth 9 width 10 is STRING
    path right

    text .zOffsetFrom     'Offsets from' at xmin ymax+0.2 tagwidth 9 width 14 is REAL format !!distanceFmt
    text .zOffsetTo       'to'           width 14 is REAL format !!distanceFmt
    text .zOffsetInterval 'interval'     tagwidth 6 width 7 is REAL format !!distanceFmt

    option .zIdFormat     'IDs format'   at xmin.zAxisLabel ymax+0.2 tagwidth 9 width 7
    text   .zIdFrom       'from'         at xmax.zOffsetTo-size tagwidth 4 width 4 is STRING
    text   .zIdInterval   'interval'     at xmax.zOffsetInterval-size tagwidth 6 width 7 is REAL

  exit

  -- ok/cancel
  button .ok     ' OK '   anchor left+bottom at xmin form ymax+0.5 ok
  button .cancel 'Cancel' anchor right+bottom at xmax form-size ymin cancel

  -- Alphabet data
  member .alphabet     is STRING
  member .alphaArray   is ARRAY

  -- Units based defaults
  member .metHorizSpacing   is REAL
  member .metHorizExtent    is REAL
  member .metVertSpacing    is REAL
  member .metVertExtent     is REAL
  member .impHorizSpacing   is REAL
  member .impHorizExtent    is REAL
  member .impVertSpacing    is REAL
  member .impVertExtent     is REAL
  member .horizSpacing      is REAL
  member .horizExtent       is REAL
  member .vertSpacing       is REAL
  member .vertExtent        is REAL

exit
-- End of form definition for !!plantGrids

------------------------------------------------------------------------
--
-- Method:      radialGridsAutofill
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .radialGridsAutofill()

  -- Units based defaults
  !this.metHorizSpacing = 5000mm
  !this.metHorizExtent  = 25000mm
  !this.metVertSpacing  = 4000mm
  !this.metVertExtent   = 20000mm
  !this.impHorizSpacing = 18'
  !this.impHorizExtent  = 90'
  !this.impVertSpacing  = 15'
  !this.impVertExtent   = 75'

  -- Select default values appropriate to units
  if (!!distanceFmt.units eq |MM|) then
    !this.horizSpacing = !this.metHorizSpacing
    !this.horizExtent  = !this.metHorizExtent
    !this.vertSpacing  = !this.metVertSpacing
    !this.vertExtent   = !this.metVertExtent
  else
    !this.horizSpacing = !this.impHorizSpacing
    !this.horizExtent  = !this.impHorizExtent
    !this.vertSpacing  = !this.impVertSpacing
    !this.vertExtent   = !this.impVertExtent
  endif

  -- Callbacks
  !this.callback                 = |!this.initialise()|
  !this.ok.callback              = |!this.apply()|
  !this.aOffsetFrom.callback     = |!this.unsetNegativeCheck(!this.aOffsetFrom, 0)|
  !this.aOffsetFrom.validateCall = |!this.angleToCheck(|
  !this.rOffsetFrom.callback     = |!this.unsetNegativeCheck(!this.rOffsetFrom, 0)|
  !this.zOffsetFrom.callback     = |!this.unsetCheck(!this.zOffsetFrom, 0)|
  !this.aOffsetTo.validateCall   = |!this.angleToCheck(|
  !this.rOffsetTo.callback       = |!this.unsetCheck(!this.rOffsetTo, !this.horizExtent)|
  !this.zOffsetTo.callback       = |!this.unsetCheck(!this.zOffsetTo, !this.vertExtent)|
  !this.aOffsetInterval.validateCall = |!this.angleToCheck(|
  !this.rOffsetInterval.callback = |!this.unsetNegZeroCheck(!this.rOffsetInterval, !this.horizSpacing)|
  !this.zOffsetInterval.callback = |!this.unsetNegZeroCheck(!this.zOffsetInterval, !this.vertSpacing)|
  !this.aIdFormat.callback       = |!this.idFormat(!this.aIdFormat, !this.aIdFrom, !this.aIdInterval)|
  !this.rIdFormat.callback       = |!this.idFormat(!this.rIdFormat, !this.rIdFrom, !this.rIdInterval)|
  !this.zIdFormat.callback       = |!this.idFormat(!this.zIdFormat, !this.zIdFrom, !this.zIdInterval)|
  !this.aIdOrder.callback        = |!this.idOrder(!this.aIdOrder, !this.aIdFrom)|
  !this.aIdFrom.callback         = |!this.idFrom(!this.aIdFormat, !this.aIdFrom)|
  !this.rIdFrom.callback         = |!this.idFrom(!this.rIdFormat, !this.rIdFrom)|
  !this.zIdFrom.callback         = |!this.idFrom(!this.zIdFormat, !this.zIdFrom)|
  !this.aIdInterval.callback     = |!this.unsetNegZeroCheck(!this.aIdInterval, 1)|
  !this.rIdInterval.callback     = |!this.unsetNegZeroCheck(!this.rIdInterval, 1)|
  !this.zIdInterval.callback     = |!this.unsetNegZeroCheck(!this.zIdInterval, 1)|

  -- Options
  !formats = ARRAY()
  !formats.append(|Numeric|)
  !formats.append(|Alphabetic|)
  !this.aIdFormat.dtext = !formats
  !this.rIdFormat.dtext = !formats
  !this.zIdFormat.dtext = !formats
  !orders = ARRAY()
  !orders.append(|Ascending|)
  !orders.append(|Descending|)
  !this.aIdOrder.dtext = !orders

  -- Alphabet
  !this.alphabet = |ABCDEFGHIJKLMNOPQRSTUVWXYZ|
  do !i to 26
    !this.alphaArray.append(!this.alphabet.substring(!i, 1))
  enddo

endmethod
-- End of method definition for .radialGridsAutofill()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation of form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  -- Set some initial angles values
  !this.aAxisLabel.val      = ||
  !this.aOffsetFrom.val     = 0
  !this.aOffsetTo.val       = 315
  !this.aOffsetInterval.val = 45
  !this.aIdFormat.select(|Dtext|, |Numeric|)
  !this.aIdOrder.select(|Dtext|,  |Ascending|)
  !this.aIdFrom.val         = |0|
  !this.aIdInterval.val     = 1
  !this.idFormat(!this.aIdFormat, !this.aIdFrom, !this.aIdInterval)

  -- Set some initial radius values
  !this.rAxisLabel.val      = |R|
  !this.rOffsetFrom.val     = 0
  !this.rOffsetTo.val       = !this.horizExtent
  !this.rOffsetInterval.val = !this.horizSpacing
  !this.rIdFormat.select(|Dtext|, |Alphabetic|)
  !this.rIdFrom.val         = |A|
  !this.rIdInterval.val     = 1
  !this.idFormat(!this.rIdFormat, !this.rIdFrom, !this.rIdInterval)

  -- Set some initial x axis values
  !this.zAxisLabel.val      = |EL|
  !this.zOffsetFrom.val     = 0
  !this.zOffsetTo.val       = !this.vertExtent
  !this.zOffsetInterval.val = !this.vertSpacing
  !this.zIdFormat.select(|Dtext|, |Numeric|)
  !this.zIdFrom.val         = |0|
  !this.zIdInterval.val     = 1
  !this.idFormat(!this.zIdFormat, !this.zIdFrom, !this.zIdInterval)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      angleToCheck
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .angleToCheck(!gadget is GADGET, !dummyString is STRING)

  -- Prevent unset value
  if (!gadget.val.unset() or !gadget.val lt 0 or !gadget.val gt 359) then
    return error 1 'Invalid input. Input a number 0 - 359'
  endif

endmethod
-- End of method definition for .angleToCheck()

------------------------------------------------------------------------
--
-- Method:      unsetCheck
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unsetCheck(!gadget is GADGET, !default is REAL)

  -- Prevent unset value
  if (!gadget.val.unset()) then
    !!alert.error(|Number required|)
    !gadget.val = !default
  endif

endmethod
-- End of method definition for .unsetCheck()

------------------------------------------------------------------------
--
-- Method:      unsetNegativeCheck
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unsetNegativeCheck(!gadget is GADGET, !default is REAL)

  -- Prevent unset or negative
  if (!gadget.val.unset()) then
    !!alert.error(|Number required|)
    !gadget.val = !default
  elseif (!gadget.val lt 0) then
    !!alert.error(|Number must not be negative|)
    !gadget.val = !default
  endif

endmethod
-- End of method definition for .unsetNegativeCheck()

------------------------------------------------------------------------
--
-- Method:      unsetNegZeroCheck
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unsetNegZeroCheck(!gadget is GADGET, !default is REAL)

  -- Prevent unset or negative
  if (!gadget.val.unset()) then
    !!alert.error(|Number required|)
    !gadget.val = !default
  elseif (!gadget.val le 0) then
    !!alert.error(|Number must be positive|)
    !gadget.val = !default
  endif

endmethod
-- End of method definition for .unsetNegZeroCheck()

------------------------------------------------------------------------
--
-- Method:      idFormat
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .idFormat(!formatGadget is GADGET, !fromGadget is GADGET, !intervalGadget is GADGET)

  -- Control activation of interval gadget
  if (!formatGadget.selection() eq |Numeric|) then
    !fromGadget.val        = |0|
    !intervalGadget.val    = 1
    !intervalGadget.active = TRUE
  elseif (!formatGadget.selection() eq |Alphabetic|) then
    !fromGadget.val        = |A|
    !intervalGadget.val    = 1
    !intervalGadget.active = FALSE
  endif

endmethod
-- End of method definition for .idFormat()

------------------------------------------------------------------------
--
-- Method:      idOrder
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .idOrder(!orderGadget is GADGET, !fromGadget is GADGET)

  -- Control activation of interval gadget
  if (!orderGadget.selection() eq |Ascending|) then
    !fromGadget.tag = |from|
  elseif (!orderGadget.selection() eq |Descending|) then
    !fromGadget.tag = |  to|
  endif

endmethod
-- End of method definition for .idOrder()

------------------------------------------------------------------------
--
-- Method:      idFrom
--
-- Description: Validation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .idFrom(!formatGadget is GADGET, !fromGadget is GADGET)

  -- Prevent unset value
  if (!fromGadget.val.trim().empty()) then
    if (!formatGadget.selection() eq |Numeric|) then
      !!alert.error(|Number required|)
      !fromGadget.val = |0|
    elseif (!formatGadget.selection() eq |Alphabetic|) then
      !!alert.error(|Letter required|)
      !fromGadget.val = |A|
    endif
  endif

  -- Prevent inconsistent value
  if (!formatGadget.selection() eq |Numeric|) then
    !unusedTest = !fromGadget.val.real()
    handle (2,441) (2,813)
      -- Unable to convert string to number
      !!alert.error(|Number required|)
      !fromGadget.val = |0|
    endhandle
  elseif (!formatGadget.selection() eq |Alphabetic|) then
    if (!this.alphabet.match(!fromGadget.val) eq 0 or !fromGadget.val.length() gt 1) then
      !!alert.error(|Single alphabetic character required|)
      !fromGadget.val = |A|
    endif
  endif

endmethod
-- End of method definition for .idFrom()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  -- Radii and Z axis do not have order gadget
  !nullGadget = object GADGET()

  -- Write data back to radial3dgrids form
  !this.writeBack(!!radial3dGrids.aAxisLabel, !!radial3dGrids.aOffsets, !!radial3dGrids.aAxisIds, !this.aAxisLabel, !this.aOffsetFrom, !this.aOffsetTo, !this.aOffsetInterval, !this.aIdFormat, !this.aIdOrder, !this.aIdFrom, !this.aIdInterval)
  !this.writeBack(!!radial3dGrids.rAxisLabel, !!radial3dGrids.rOffsets, !!radial3dGrids.rAxisIds, !this.rAxisLabel, !this.rOffsetFrom, !this.rOffsetTo, !this.rOffsetInterval, !this.rIdFormat, !nullGadget,    !this.rIdFrom, !this.rIdInterval)
  !this.writeBack(!!radial3dGrids.zAxisLabel, !!radial3dGrids.zOffsets, !!radial3dGrids.zAxisIds, !this.zAxisLabel, !this.zOffsetFrom, !this.zOffsetTo, !this.zOffsetInterval, !this.zIdFormat, !nullGadget,    !this.zIdFrom, !this.zIdInterval)

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      writeBack
--
-- Description: Write data back to parent form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .writeBack(!parentLabel is GADGET, !parentOffsets is GADGET, !parentIds is GADGET, !label is GADGET, !offsetFrom is GADGET, !offsetTo is GADGET, !offsetInterval is GADGET, !idFormat is GADGET, !idOrder is GADGET, !idFrom is GADGET, !idInterval is GADGET)

  -- Axis label
  !parentLabel.val = !label.val

  -- Axis offsets
  !offsets = ARRAY()
  -- Make sure To is greater than From
  if ((!offsetFrom.val gt !offsetTo.val) and (!offsetInterval.val ge 0)) then
  	!swap = !offsetFrom.val
  	!offsetFrom.val = !offsetTo.val
  	!offsetTo.val = !swap
  endif
  do !offset from !offsetFrom.val to !offsetTo.val by !offsetInterval.val
    if (!parentOffsets eq !!radial3dGrids.aOffsets) then
      -- No units for angle
      !offsets.append(!offset.string())
    else
      !offsets.append(!offset.string(!!distanceFmt))
    endif
  enddo
  !parentOffsets.val = !offsets

  -- Axis IDs
  !ids = ARRAY()
  !count = 0
  if (!idFormat.selection() eq |Numeric|) then
    do !id from !idFrom.val.real() by !idInterval.val
      !ids.append(!id.string())
      !count = !count + 1
      break if (!count eq !offsets.size())
    enddo
  elseif (!idFormat.selection() eq |Alphabetic|) then
    do !i from !this.alphabet.match(!idFrom.val)
      -- Extend array on demand like Excel columns (...,X,Y,Z,AA,AB,AC,...,BA,BB,BC,...)
      if (!i gt !this.alphaArray.size()) then
        !prefix = int(!this.alphaArray.size() / 26)
        do !j to 26
          !this.alphaArray.append(!this.alphabet.substring(!prefix, 1) & !this.alphabet.substring(!j, 1))
        enddo
      endif
      !ids.append(!this.alphaArray[!i])
      !count = !count + 1
      break if (!count eq !offsets.size())
    enddo
  endif

  -- Reverse order if descending (calculated in ascending order first so no need to count backwards to target value)
  if (!idOrder.set()) then
    if (!idOrder.selection() eq |Descending|) then
      -- If first angle is zero then keep its id as the first element to give clockwise order of angles
      !keepZeroFirst = FALSE
      if (!idOrder eq !this.aIdOrder) then
        if (!offsets.empty().not()) then
          if (!offsets.first().real() eq 0) then
            !keepZeroFirst = TRUE
          endif
        endif
      endif
      if (!keepZeroFirst) then
        -- Invert array apart from first element
        !newIds = !ids
        !newIds[1].delete()
        !newIds = !newIds.invert()
        !ids.deleteFrom(2)
        !ids.appendArray(!newIds)
      else
        -- Simple invert
        !ids = !ids.invert()
      endif
    endif
  endif
  !parentIds.val = !ids

endmethod
-- End of method definition for .writeBack()
