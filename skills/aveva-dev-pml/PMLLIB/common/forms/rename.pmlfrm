--
-- File:            rename.pmlfrm
--   Type:          Form Definition
--   Group:         Naming
--     Keyword:     NAME
--   Module:        common
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Mon Mar 9 13:51:44 GMT 1998
--
--
-- Description:
-- Rename element
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activateApply()                  -                   activates the apply button
--  apply()                          -                   apply new name
--  init()                           -                   initialisation
--  newName()                        -                   check new name
--  rename()                         -                   Constructor method
--
------------------------------------------------------------------------
setup form !!rename

  !!rename.formTitle     = 'Modify Name'
  !!rename.iconTitle     = 'Name'
  !!rename.callback      = '!this.init()'
  !!rename.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition

  -- stores the element that is current to the form
  member .ce is DBREF

  -- CE button, initialises form to the current element
  button .setCe 'CE' at xmin ymax

  -- Element Name
  text .newName 'Name' at xmin.setCe ymax+0.5 width 32 name

  -- options
  option .qualifier at xmax+1 ymin width 10

  -- control buttons
  button .apply ' Apply ' at xmin.setCe ymax+0.5
  button .dismiss 'Dismiss ' at xmax form-size ymin cancel

exit

------------------------------------------------------------------------
--
-- Method:      .rename()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .rename()

  -- options
  !dText = ARRAY()
  !dText[1] = 'Only'
  !dText[2] = 'Rename all'
  !dText[3] = 'Unname'
  !rText = ARRAY()
  !rText[1] = 'only'
  !rText[2] = 'all'
  !rText[3] = 'unname'
  !this.qualifier.dText = !dText
  !this.qualifier.rText = !rText

  -- set callbacks
  !this.setCe.callback = |!this.init()|
  !this.newName.callback = |!this.newName()|
  !this.qualifier.callback = |!this.activateApply()|
  !this.apply.callback = |!this.apply()|

endmethod
-- End of method definition for .rename()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: initialisation
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- connect form to current element
  !this.ce = !!ce

  -- display old name
  !oldName = !!ce.name
  if (!oldName.subString(1,1) eq '=') then
    !this.newName.val = 'unset'
  else
    !this.newName.val = !oldName
  endif

  -- set active status of Apply button
  !this.activateApply()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .newName()
--
-- Description: check new name
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .newName()

  -- entering a new name so unnaming is not wanted
  if (!this.qualifier.selection() eq 'unname') then
    !this.qualifier.select('RTEXT', 'only')
  endif

  -- check if new name is allowed
  !!nameGadget(!this.newName, 'NEW')

  -- activate apply button if name ok
  !this.apply.active = (!this.newName.val ne 'unset' and !this.newName.val ne !this.ce.name)

endmethod
-- End of method definition for .newName()

------------------------------------------------------------------------
--
-- Method:      .activateApply()
--
-- Description: activates the apply button
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .activateApply()
  !qualifier = !this.qualifier.selection()
  !newName = !this.newName.val

  -- for button to be active, we must be going to do one of the following:
  -- a) unname named element
  -- b) rename all for a named element (to a different set name)
  -- c) rename only for any element (to a different set name)
  !active = (!qualifier eq 'unname' and !this.ce.isNamed) $
         or (!qualifier eq 'all' and !this.ce.isNamed and !newName ne 'unset' and !newName ne !this.ce.name)    $
         or (!qualifier eq 'only' and !newName ne 'unset' and !newName ne !this.ce.name)
  !this.apply.active = !active
endmethod
-- End of method definition for .activateApply()

------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: apply new name
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- store CE so it can be put back after naming has taken place
  !ce = !!ce

  -- name has already been validated if apply button is activated
  !!ce = !this.ce

  if (!this.qualifier.selection() eq 'unname') then

    -- unname
    UNNAME
    !this.newName.val = 'unset'

  elseif (!this.qualifier.selection() eq 'all') then

    -- rename all
    if (!this.ce.isNamed) then
      RENAME ALL $!<this.ce.name> $!<this.newName.val>
    else
      if (!this.ce.members.size() eq 0) then
        NAME $!<this.newName.val>
      else
        !!alert.error('Cannot use this option on an unnamed element')
      endif
    endif

  else

    -- rename only
    NAME  $!<this.newName.val>

  endif

  -- deactivate apply button until new name entered
  !this.apply.active = false

  !!ce = !ce

endmethod
-- End of method definition for .apply()
