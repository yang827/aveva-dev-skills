-- Author:          Matt Robins
-- Created:
--
--
-- Description:     Reorder Hierarchy For Element
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getMembers()                     -                   Reorder Elements
--  init()                           -                   Init Call
--  reorder()                        -                   Reorder Elements
--  reorderHierarchy()               -                   Constructor
--
import 'GridControl'
handle any
endhandle

using namespace 'Aveva.Pdms.Presentation'

layout form !!reorderHierarchy dialog docking

  button .ceButton  'CE' at xmin ymin width 4
  para .cePara  at xmax+1 ymin text '' width 40

  frame .hierarchyFrame '' at xmin.ceButton ymax+.25 anchor t+l+r+b
    container .hierarchyContainer nobox PmlNetControl 'NET' at xmin ymin dock fill height 12 width 60
  exit

  frame .toggleFrame '' at xmin ymax+.25 anchor b+l+r width 61.5
    rtoggle .beforeToggle 'Reorder Before' at xmin ymin
    rtoggle .afterToggle  'Reorder After'  at xmax+2 ymin
  exit

  frame .newHierarchyFrame '' at xmin ymax+.25 anchor l+r+b
    container .newHierarchyContainer nobox PmlNetControl 'NET' at xmin ymin dock fill height 12 width 60
  exit

  button .okButton    'OK'    at xmax form-10-size ymax+.25 anchor b+r width 8 ok
  button .applyButton 'Apply' at xmax+1 ymin anchor b+r width 8

  -- Members
  member .hierarchyGrid is NETGRIDCONTROL
  member .newHierarchyGrid is NETGRIDCONTROL
  member .element is DBREF

exit

------------------------------------------------------------------------
--
-- Method:      reorderHierarchy()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reorderHierarchy()

  -- Form Properties
  !this.formTitle = 'Reorder Hierarchy'
  !this.initCall  = '!this.init()'

  -- Callbacks
  !this.ceButton.callback = '!this.init()'
  !this.okButton.callback = '!this.reorder()'
  !this.applyButton.callback = '!this.reorder()'

  -- Set PmlNetGridControl
  using namespace 'Aveva.Pdms.Presentation'
  !this.hierarchyGrid  = object NETGRIDCONTROL()
  !this.newHierarchyGrid = object NETGRIDCONTROL()
  !this.hierarchyContainer.control = !this.hierarchyGrid.handle()
  !this.newHierarchyContainer.control = !this.newHierarchyGrid.handle()

  -- Define Existing Hierarchy Grid
  !this.hierarchyGrid.fixedHeaders(false)
  !this.hierarchyGrid.outlookGroupStyle(FALSE)
  !this.hierarchyGrid.columnExcelFilter(FALSE)
  !this.hierarchyGrid.headerSort(true)
  !this.hierarchyGrid.columnSummaries(false)
  !this.hierarchyGrid.singleRowSelection(false)

  -- Define New Hierarchy Grid
  !this.newHierarchyGrid.fixedHeaders(false)
  !this.newHierarchyGrid.outlookGroupStyle(false)
  !this.newHierarchyGrid.columnExcelFilter(false)
  !this.newHierarchyGrid.headerSort(true)
  !this.newHierarchyGrid.columnSummaries(false)
  !this.newHierarchyGrid.singleRowSelection(true)

endmethod
------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: Init Call
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Set Element
  !this.element = !!ce

  -- Check If Not At World Level
  if (!this.element.type eq 'WORL') then
    !!alert.error('Reorder hierarchy cannot be ran at world level')
    return
  endif

  -- Set Toggle Default
  !this.beforeToggle.val = true

  -- Show Initialised Element
  !this.cePara.val = !this.element.name

  -- Get Member For Grids
  !this.getMembers()

endmethod
------------------------------------------------------------------------
--
-- Method:      getMembers()
--
-- Description: Reorder Elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getMembers()

  -- Headings
  !headings = ARRAY()
  !headings.append('Type')
  !headings.append('Name')

  -- Get Members
  !members = !!collectAllFor('', 'OWNER EQ $!this.element', !this.element)
  !data = ARRAY()
  do !member values !members
    !row[1] = !member.type
    !row[2] = !member.name
    !data.append(!row)
  enddo

  -- Bind Data To Grid
  using namespace  'Aveva.Pdms.Presentation'
  !nds = object NETDATASOURCE('Members', !headings, !data)
  !nds2 = object NETDATASOURCE('Members', !headings, !data)
  !this.hierarchyGrid.bindToDataSource(!nds)
  !this.newHierarchyGrid.bindToDataSource(!nds2)

  -- Select Row 1
  !this.hierarchyGrid.selectRow(1)
  !this.newHierarchyGrid.selectRow(1)

endmethod
------------------------------------------------------------------------
--
-- Method:      reorder(!dummyArray is ARRAY)
--
-- Description: Reorder Elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reorder()

  -- Save CE If Current Element Has Changed
  !ref = !!ce

  -- Get Reorder Option
  if (!this.beforeToggle.val) then
    !order = 'BEFORE'
  else
    !order = 'AFTER'
  endif

  -- Set CE To Apply Reorder Method
  !!ce = !this.element

  -- Get Selected Rows
  !selectedRows = !this.hierarchyGrid.getSelectedRows()

  -- Set Target
  !target = !this.newHierarchyGrid.getSelectedRows()[1][2].dbref()

  -- Invert ARRAY If Reorder Before
  if (!order eq 'BEFORE') then
    !selectedRows.invert()
  endif

  -- Reorder Hierarchy
  do !x values !selectedRows
    !source = !x[2].dbref()
    if (!x[2].dbref().lock eq true) then
      !!alert.message('Element ' + !x[2] + ' is locked and will be skipped.')
    endif
    REORDER $!source $!order $!target
    handle any
    elsehandle none
      !target = !source
    endhandle
  enddo

  -- Set CE Back
  !!ce = !ref

  -- Re-initialise Grid
  !this.getMembers()

endmethod
