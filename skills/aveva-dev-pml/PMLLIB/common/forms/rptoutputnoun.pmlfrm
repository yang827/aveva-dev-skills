--
--
-- Description:
-- Form for Output options
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -                   add element type to the list
--  apply()                          -                   apply the form
--  initialise()                     -
--  removeSelected()                 -                   remove the selected element type from the list
--  validate(STRING)                 BOOLEAN             Validate the input is a PDMS type.
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
-- Define form
setup form !!rptOutputNoun

  !!rptOutputNoun.formTitle     = 'Specific Types'
  !!rptOutputNoun.iconTitle     = 'OutputOnly'
  !!rptOutputNoun.callback      = '!!rptOutputNoun.initialise()'
  !!rptOutputNoun.formRevision  = ' $Revision: 1.12 $ '

  list .typeList at x0 ymax 'Element types' multi width 18 len 6
  text .typeText '' at x0 ymax call '!this.add()' width 15 string
  button .addButton 'Add' at xmax.typeText ymin.typeText call '!this.add()'
  button .removeSelected 'Remove selected' at x0 ymax+0.1  call '!this.removeSelected()'


  button .ok     '  OK  ' at x0 ymax+0.2 callback '!this.apply()' ok
  button .cancel 'Cancel' at xmax form-size ymin  cancel

  -- Form Members

exit
-- End of form definition for !!rptOutputNoun

------------------------------------------------------------------------
--
-- Method:      Initialise
--
-- Description: Initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()
  -- Make sure the string is defined
  if (!!rptOutputOpts.onlyElements.unset()) then
    !!rptOutputOpts.onlyElements = ''
  endif

  -- Split the options string member
  !array = !!rptOutputOpts.onlyElements.split()

  !this.typeList.dtext = !array

  !this.typeText.setFocus()
endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: add element type to the list
--
-- Method Type: Function/Procedure
-- Arguments: none
--
-- Return: none
--
--
------------------------------------------------------------------------
-- Define method
define method .add()
  !noun = !this.typeText.val
  !noun = !noun.trim()
  !noun = !noun.upCase()

  if (!this.validate(!noun)) then
    !dt = !this.typeList.dtext
    !dt.append(!noun)
    !dt = !dt.unique()
    !this.typeList.dtext = !dt
    !this.typeList.select('dtext',!noun)
    !this.typeText.val = ''
  endif

  !this.typeText.setFocus()
endmethod
-- End of method definition for .add()

------------------------------------------------------------------------
--
-- Method:      removeSelected
--
-- Description: remove the selected element type from the list
--
-- Method Type: Function/Procedure
-- Arguments: none
--
-- Return: none
--
--
------------------------------------------------------------------------
-- Define method
define method .removeSelected()
  !a = !this.typeList.val
  if (!a.size() LE 0) then
    return
  endif

  !a.sort()
  !aMax = !a.last()
  -- get the index of the next item after the last selected one
  !aNex = !aMax + 1
  !dt  = !this.typeList.dtext

  if (!aNex GT !dt.size()) then
    !searchString = STRING()
  else
    !searchString = !dt[!aNex]
  endif

  do !i values !a
    !dt[!i].delete()
  enddo
  !dt.compress()
  !this.typeList.dtext = !dt

  -- look for element found above if it exists
  if (!searchString.set()) then
    !this.typeList.select('dtext',!searchString)
  -- otherwise select the last item in the list
  elseif (!dt.size() ne 0) then
    !iSelect = !dt.size()
    !a = object ARRAY()
    !a.append(!iSelect)
    !this.typeList.val = !a
  endif

endmethod
-- End of method definition for .removeSelected()

------------------------------------------------------------------------
--
-- Method:      validate
--
-- Description: Validate the input is a PDMS type.
--
-- Method Type: Function/Procedure
-- Arguments:
--   1 RW STRING [Description]
-- Return:
--   [BOOLEAN] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .validate(!noun is STRING) is BOOLEAN

  if (!noun.length() gt 0) then
    var !nameString NOUNDEF $!noun NAME
    handle any
      -- must be an invalid type
      !!alert.error('Invalid input.  Please enter a valid element type.')
      return FALSE
    endhandle
    !noun = !nameString[1]
  else
   return FALSE
  endif

  return TRUE
endmethod
-- End of method definition for .validate(STRING)

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: apply the form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
-- Define method
define method .apply()

  !dt = !this.typeList.dtext

  !string = ''
  do !noun values !dt
    !string = !string & !noun & ' '
  enddo
  !string.trim()

  -- Set the output options form member
  !!rptOutputOpts.onlyElements = !string

endmethod
-- End of method definition for .apply()
