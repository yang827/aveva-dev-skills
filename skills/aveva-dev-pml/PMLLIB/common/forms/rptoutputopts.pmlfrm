--
--
-- Description:
-- Form for Output options
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  default()                        -
--  load()                           -                   load the defaults
--  rptOutputOpts()                  -                   Constructor
--  save()                           -                   save the defaults
--  stdSpecificLink(STRING)          -                   Link between all elements and specific elements - act as radio
--  stdUdaLink(STRING)               -                   Link between standard attributes and UDAs
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
-- Define form
setup form !!rptOutputOpts

  !!rptOutputOpts.formTitle     = 'Output Options'
  !!rptOutputOpts.iconTitle     = 'OutputOpts'
  !!rptOutputOpts.formRevision  = ' $Revision: 1.7 $ '

  bar
    add 'File' .fileMenu
  exit

   frame .output 'Output' at x0.25 ymax  width 33
     toggle .elements    |All Elements| at xmin+1 ymax     callback |!this.stdSpecificLink('STANDARD')|
     toggle .specific    |Specific Types| at xmin ymax  callback |!this.stdSpecificLink('SPECIFIC')|
     button .define      |Define...| at xmax.specific ymin callback |show !!rptOutputNoun |
   exit

   frame .attribs 'Attributes' at x0.25 ymax  width 33
     toggle .standard |Standard Attributes| at xmin+1 ymax   callback |!this.stdUdaLink('STANDARD')|
     toggle .udas     |User Defined Attributes| at xmin ymax callback |!this.stdUdaLink('UDA')|
     toggle .connections |References/Connections| at xmin ymax
   exit

   rgroup .createModify  |Re-input| at x0 ymax vertical frame
     add tag 'Create New Elements        '  select 'CREATE'
     add tag 'Modify Existing Elements   '  select 'MODIFY'
     --add tag 'Create with Same References'  select 'sameRef'
   exit

   frame .format 'Format' at x0.25 ymax width 33
     toggle .sameRef |Use Same Reference Numbers| at xmin+1 ymax
     toggle .comment |Comment Reference Numbers| at xmin ymax
     toggle .index   |Line Numbers| at xmin ymax
     option .tabs    |Tab Spacing| at xmin+8 ymax width 3
   exit

  button .ok     '  OK  ' at x0.25 ymax+0.5 callback '' ok
  button .cancel 'Cancel' at xmax form-size ymin  cancel

  -- Form Members

  -- String of elements type for specific output
  member .onlyElements is STRING

  -- current options file name
  member .filename is STRING

exit
-- End of form definition for !!rptOutputOpts
------------------------------------------------------------------------
--
-- Method:      rptOutputOpts
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .rptOutputOpts()

  !this.newMenu('fileMenu')

  !this.fileMenu.add('callback', 'Save', '!this.save()')
  !this.fileMenu.add('callback', 'Load', '!this.load()')
  !this.fileMenu.add('callback', 'Default', '!this.default()')

  -- Option gadgets settings
  !tab[1] = ' 0 '
  !tab[2] = ' 1 '
  !tab[3] = ' 2 '
  !tab[4] = ' 3 '
  !tab[5] = ' 4 '
  !tab[6] = ' 5 '
  !tab[7] = ' 6 '
  !this.tabs.dtext = !tab
  !this.tabs.rtext = !tab

  -- set file name
  !module = !!module()
  !this.filename = !module.appKey + '-output.pmldat'

  -- Load user settings
  !this.load()

endmethod
-- End of method definition for .rptOutputOpts()

------------------------------------------------------------------------
--
-- Method:      Default
--
-- Description: AVEVA default settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .default()

  -- AVEVA defaults
  !this.elements.val  = true
  !this.specific.val  = false
  !this.onlyElements  = ''
  !this.define.active = false

  !this.standard.val    = true
  !this.udas.val        = true
  !this.connections.val = true

  !this.createModify.select('CREATE')

  !this.sameRef.val  = false
  !this.comment.val  = false
  !this.index.val    = false
  !this.tabs.select('RTEXT', ' 0 ')

endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method:      stdSpecificLink
--
-- Description: Link between all elements and specific elements - act as radio
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      STANDARD or SPECIFIC
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .stdSpecificLink(!choice is STRING)

  -- All elements or Specific element can be output, not both.
  if (!choice eq 'STANDARD') then
    if (!this.elements.val) then
      !this.specific.val  = false
      !this.define.active = false
    else
      !this.specific.val  = true
      !this.define.active = true
    endif
  else
    if (!this.specific.val) then
      !this.elements.val  = false
      !this.define.active = true
    else
      !this.elements.val  = true
      !this.define.active = false
    endif
  endif

endmethod
-- End of method definition for .stdSpecificLink(STRING)

------------------------------------------------------------------------
--
-- Method:      stdUdaLink
--
-- Description: Link between standard attributes and UDAs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      STANDARD or UDA
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .stdUdaLink(!choice is STRING)

  -- Cannot output UDAs only.
  if (!choice eq 'UDA') then
    if (!this.standard.val.not()) then
      !this.udas.val  = false
    endif
  else
    if (!this.standard.val.not()) then
      !this.udas.val  = false
    endif
  endif

endmethod
-- End of method definition for .stdUdaLink(STRING)

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: save the defaults
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .save()

  -- save all the data

  -- initialise array to contain strings for options file
  !saveContents = ARRAY()

  -- write header information
  var !clock CLOCK
  var !user USER
  !saveContents.append('-- Data file for Output style options - ' & !clock & ' - User ' & !user)
  !saveContents.append('')

  !saveContents.append('!!rptOutputOpts.elements.val     = ' & !!rptOutputOpts.elements.val )
  !saveContents.append('!!rptOutputOpts.specific.val     = ' & !!rptOutputOpts.specific.val )
  !saveContents.append('!!rptOutputOpts.onlyElements     = |' & !!rptOutputOpts.onlyElements & ' |' )
  !saveContents.append('!!rptOutputOpts.define.active    = ' & !!rptOutputOpts.define.active )

  !saveContents.append('!!rptOutputOpts.standard.val     = ' & !!rptOutputOpts.standard.val )
  !saveContents.append('!!rptOutputOpts.udas.val         = ' & !!rptOutputOpts.udas.val )
  !saveContents.append('!!rptOutputOpts.connections.val  = ' & !!rptOutputOpts.connections.val )

  !saveContents.append('!!rptOutputOpts.createModify.select(|' & !!rptOutputOpts.createModify.selection() & '|)' )

  !saveContents.append('!!rptOutputOpts.sameRef.val      = ' & !!rptOutputOpts.sameRef.val )
  !saveContents.append('!!rptOutputOpts.comment.val      = ' & !!rptOutputOpts.comment.val )
  !saveContents.append('!!rptOutputOpts.index.val        = ' & !!rptOutputOpts.index.val )
  !saveContents.append('!!rptOutputOpts.tabs.select(|RTEXT|, |' & !!rptOutputOpts.tabs.selection() & '|)' )

  -- write footer information
  !saveContents.append('')
  !saveContents.append('-- End of Data file for Output style options')

  -- end of user options

  !!writeFile('%PDMSUSER%/' + !this.filename, 'OVERWRITE', !saveContents)

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load the defaults
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- load the data and display the selected settings
  !filename = !this.filename
  $m "%PDMSUSER%/$!filename"
  handle (44,33)
    -- file does not exist so ...
    -- Load the defaults
    !this.default()
  elsehandle any
    -- bad news
    !!alert.error(!!error.text)
  endhandle

endmethod
-- End of method definition for .load()
