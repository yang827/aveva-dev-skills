--
--
-- Description:
-- Form showing Session Comment
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  initialise()                     -                   Initialise
--
------------------------------------------------------------------------

-- Define form
setup form !!rptSessComment

  !!rptSessComment.formTitle     = 'Session No nnnnnn '
  !!rptSessComment.iconTitle     = 'SesComment'
  !!rptSessComment.callback      = '!!rptSessComment.initialise()'
  !!rptSessComment.formRevision  = ' $Revision: 1.20 $ '

  para     .sessDb     at x1 ymax  text 'Database Name  =  DBNAME/DBNAME' width 35 lines 2
  para     .sessReason at x1 ymax  text 'Reason for session  =  <text>' width 35 lines 2
  textpane .sessionComment 'Session No nnnnnn Comment :- )'  at x1 ymax width 35 height 5

  -- Form Members
  member .dbName is STRING

exit
-- End of form definition for !!rptSessComment

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  !this.dbName = WDBNAME
  handle any
  -- could be in admin
  !this.dbName = 'None'
  endhandle

  !this.sessionComment.setEditable(FALSE)

  !sessNumber = !!rptOutput.sessNum.val

  -- set the session comment
  var !sessC SESSCOMMENT $!sessNumber
    handle (2,1)
      -- handle number less than zero
      var !clockStr CLOCK
      !clockArr = !clockStr.split()
      !!rptOutput.time.val = !clockArr[4]
      !!rptOutput.date.val = !clockArr[1] & ' ' & !clockArr[2] & ' ' & !clockArr[3]

      -- Set Session number
      var !sessDnum SESSION ON $!!rptOutput.time.val $!!rptOutput.date.val
      !sessDnumReal = !sessDnum.real()
      !!rptOutput.sessNum.val = !sessDnumReal

      !sessNumber = !!rptOutput.sessNum.val
      var !sessC SESSCOMMENT $!sessNumber
    elsehandle (2,201)
      -- handle number higher than latest session
      !!rptOutput.sessNum.val = 0
      !sessNumber = !!rptOutput.sessNum.val
    endhandle

    if (!sessNumber eq 0) then
      !sessQuery = -1
      var !sessC SESSCOMMENT $!sessQuery
    else
      !sessQuery = $!sessNumber
    endif

  !this.formTitle          = 'Session No ' & !sessNumber
  !this.sessDb.val         = 'Database Name  =  ' & !this.dbName

  -- Reason for creation of session from DBSESS object
  !dbObj = object DB( !this.dbName )
  !sessObj = !dbObj.session( !sessQuery )
  handle any
      !this.sessReason.val = 'Reason for session unavailable'
  elsehandle none
      !this.sessReason.val = 'Reason for session  =  ' & !sessObj.reason
  endhandle

  !this.sessionComment.tag = 'Session No ' & !sessNumber & ' Comment :-'

  -- Split the actual session comment up to output in a text pane gadget
  !array[1] = !sessC
  -- use COLUMN VALUES instead of expanding a string using the $!str, avoids the string problems
  var !sessText COMPOSE COLUMN VALUES !array width 35
  !!rptSessComment.sessionComment.val = !sessText

endmethod
-- End of method definition for .initialise()
