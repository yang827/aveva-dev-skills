-- File:            ruledef.pmlfrm
--   Type:          Form Definition
--   Group:         Rule handling routines
--     Keyword:     RULES
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Dec 15 18:19:40 GMT 1997
--
--
-- Description:
-- form to edit representation options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  displayRule()                    -                   display a rule in the edit gadgets
--  include()                        -                   include a rule
--  init()                           -                   form initialisation
--  listRules()                      -                   list defined rules
--  load()                           -                   load the defaults
--  ok()                             -                   method to execute on ok callback
--  remove()                         -                   remove a rule
--  replace()                        -                   replace a rule
--  ruleDef()                        -                   constructor
--  save()                           -                   save the defaults
--  toggleLocation(MENU,STRING)      -                   toggle the location for saving rules
--
------------------------------------------------------------------------

-- Define form
setup form !!ruleDef

  !!ruleDef.formTitle     = 'Define Rules'
  !!ruleDef.iconTitle     = 'Define Rules'
  !!ruleDef.callback      = '!!ruleDef.init()'
  !!ruleDef.formRevision  = ' $Revision: 1.15 $ '

  -- current location
  member .currentLoc is STRING

  member .data is RULESTOREDATA

  -- store additional pml code to run on ok action
  member .function is STRING

  bar
    add 'File' .fileMenu
  exit

  -- Rule Title
  para .head at xmin ymax width 50 lines 1

  frame .frame |Definition| at xmin ymax

    path down
    vdist 0.2
    halign left

    -- Name (used as key)
    text .name '       Name' at xmin+1 ymax width 30 scroll 30 is STRING

    -- Generic Types
    text .types '      Types' width 45 is STRING

    -- Rules
    text .rule '       Rule'  width 45 is STRING

    -- Description
    text .description 'Description' at width 45 scroll 60 is STRING

    -- Include/Replace/Delete
    halign right
    button .remove  |Remove|  callback |!!ruleDef.remove()|
    path left
    button .replace |Replace| callback |!!ruleDef.replace()|
    button .include |Include| callback |!!ruleDef.include()|
  exit

  -- Available Rules
  list .list   |Defined| at xmin.head+1 ymax.frame+0.25 callback |!!ruleDef.displayRule()|  width 57 height 14

  -- Apply/Dismiss
  button .apply  |OK|   at xmin ymax+0.2 width 8  ok
  button .cancel |Cancel| at xmax form-size ymin width 8 cancel

exit
-- End of form definition for !!ruleDef

------------------------------------------------------------------------
--
-- Method:      !ruleDef()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ruleDef()

  !this.newMenu('fileMenu')

  !this.fileMenu.add('callback', 'Save', '!!ruleDef.save()','ruleDefinitionSave')
  !this.fileMenu.add('callback', 'Load', '!!ruleDef.load()')
  !this.fileMenu.add('separator')
  !this.fileMenu.add('menu', 'Location', 'locationMenu')

  !this.newMenu('locationMenu')
  !this.locationMenu.add('toggle', 'User'   , '!!ruleDef.toggleLocation(','ruleUserLocation')
  !this.locationMenu.add('toggle', 'Project', '!!ruleDef.toggleLocation(','ruleprojectLocation')
  !this.locationMenu.add('toggle', 'PDMS'   , '!!ruleDef.toggleLocation(','ruleDefaultLocation')

  !this.currentLoc = 'USER'
  !this.locationMenu.select('User', true)
  !this.okCall     = '!!ruleDef.ok()'

  -- check that the user has admin status
  if (!!comAdminStatus()) then
    -- allow Admin user to change anything
    !this.locationMenu.setFieldProperty('ruleProjectLocation','ACTIVE',true)
    !this.locationMenu.setFieldProperty('ruleDefaultLocation','ACTIVE',true)
  else
    -- Non-Admin user can only change user files
    !this.locationMenu.setFieldProperty('ruleProjectLocation','ACTIVE',false)
    !this.locationMenu.setFieldProperty('ruleDefaultLocation','ACTIVE',false)
  endif

endmethod
-- End of method definition for .ruleDef()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

    -- set the rule type paragraph
    !this.head.val = !this.data.ruleType.subString(1, 1).upcase() + !this.data.ruleType.subString(2) + ' Rules'

    -- set the type gadget status
    if (!this.data.ruleType.upcase() eq 'ELEMENT') then
      !this.types.active = true
    else
      !this.types.val = ''
      !this.types.active = false
    endif

    -- list the rules
    !this.listRules()

    -- display the selected rule
    !this.displayRule()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !listRules()
--
-- Description: list defined rules
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .listRules()

  !dText = ARRAY()
  !rText = ARRAY()

  if (!this.data.userNameTable.empty().not()) then
    !dText.append('User Defined Rules')
    !rText.append('NULL')
    do !i indices !this.data.user
      !dText.append('    ' + !this.data.user[!i].name)
      !rText.append(!this.data.userNameTable[!i])
    enddo
  endif

  if (!this.data.projNameTable.empty().not()) then
    !dText.append('Project Defined Rules')
    !rText.append('NULL')
    do !i indices !this.data.proj
      !dText.append('    ' + !this.data.proj[!i].name)
      !rText.append(!this.data.projNameTable[!i])
    enddo
  endif

  if (!this.data.pdmsNameTable.empty().not()) then
    !dText.append('PDMS Defined Rules')
    !rText.append('NULL')
    do !i indices !this.data.pdms
      !dText.append('    ' + !this.data.pdms[!i].name)
      !rText.append(!this.data.pdmsNameTable[!i])
    enddo
  endif

  if (!this.data.avevaNameTable.empty().not()) then
    !dText.append('AVEVA Supplied Rules')
    !rText.append('NULL')
    do !i indices !this.data.aveva
      !dText.append('    ' + !this.data.aveva[!i].name)
      !rText.append(!this.data.avevaNameTable[!i].upcase())
    enddo
  endif

  if (!dText.empty()) then
    !dText.append('< No Rule >')
    !rText.append('NULL')
  endif

  !this.list.dText = !dText
  !this.list.rText = !rText

endmethod
-- End of method definition for .listRules()

------------------------------------------------------------------------
--
-- Method:      !displayRule()
--
-- Description: display a rule in the edit gadgets
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .displayRule()

  !currentRtext = !this.list.selection()
  if (!currentRtext ne 'NULL') then
    -- get the rule
    !ruleObject = !this.data.getRule(!this.list.selection('dtext').trim())

    -- copy data to edit gadgets
    !this.name.val = !ruleObject.name
    !this.types.val = !ruleObject.types
    !this.rule.val = !ruleObject.rule
    !this.description.val = !ruleObject.description
    if (!this.currentLoc.upcase() eq !ruleObject.location.upcase()) then
      !this.replace.active = true
      !this.remove.active = true
    else
      !this.replace.active = false
      !this.remove.active = false
    endif
  else
    !this.name.val = ''
    !this.types.val = ''
    !this.rule.val = ''
    !this.description.val = ''

    !this.replace.active = false
    !this.remove.active = false
  endif


endmethod
-- End of method definition for .displayRule()

------------------------------------------------------------------------
--
-- Method:      !include()
--
-- Description: include a rule
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .include()

  -- check name is not empty
  if (!this.name.val.trim() eq '') then
	!!alert.warning('Name must be supplied')
    return
  endif

  -- get data for rule
  !ruleObject = object RULE()

  -- Check for valid rule
  if(!ruleObject.rule(!this.name.val.trim(), !this.rule.val, !this.types.val, !this.description.val).not()) then
	!!alert.warning('Problem creating rule: ' & !!error.text)
    return
  endif

  !ruleObject.location(!this.currentLoc)

  !this.data.include(!ruleObject)

  !this.listRules()

  !this.list.select('rtext', !ruleObject.name.upcase())
  handle any
  endhandle

  -- display the selected rule
  !this.displayRule()

endmethod
-- End of method definition for .include()

------------------------------------------------------------------------
--
-- Method:      !replace()
--
-- Description: replace a rule
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .replace()

  -- check name is not empty
  if (!this.name.val.trim() eq '') then
    -- error
  endif

  -- get data for rule
  !ruleObject = object RULE()

    -- Check for valid rule
  if(!ruleObject.rule(!this.name.val.trim(), !this.rule.val, !this.types.val, !this.description.val).not()) then
    !!alert.warning(!!error.text)
    return
  endif

  !ruleObject.location(!this.currentLoc)

  !this.data.replace(!this.list.selection('dtext').trim(), !ruleObject)

  !this.listRules()

  !this.list.select('rtext', !ruleObject.name.upcase())
  handle any
  endhandle

  -- display the selected rule
  !this.displayRule()

endmethod
-- End of method definition for .replace()

------------------------------------------------------------------------
--
-- Method:      !remove()
--
-- Description: remove a rule
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .remove()

  !this.data.remove(!this.list.selection('dtext').trim())

  !this.listRules()

endmethod
-- End of method definition for .remove()

------------------------------------------------------------------------
--
-- Method:      !toggleLocation()
--
-- Description: toggle the location for saving rules
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [MENU] [menu that has been picked]
--   [2] [R] [STRING] [user action]
--
------------------------------------------------------------------------
define method .toggleLocation(!menu is MENU, !dummyAction is STRING)

  -- get the last picked field
  !field = !menu.pickedField

  -- initialise all gadgets
  !menu.select('User', false)
  !menu.select('Project', false)
  !menu.select('PDMS', false)

  -- select the picked field
  !menu.select(!field, true)

  -- set the picked field
  if (!field eq 'User') then
    !this.currentLoc = 'USER'
  elseif (!field eq 'Project') then
    !this.currentLoc = 'PROJ'
  elseif (!field eq 'PDMS') then
    !this.currentLoc = 'PDMS'
  endif

  -- display the selected rule
  !this.displayRule()

endmethod
-- End of method definition for .toggleLocation(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: save the defaults
--
-- Method Type: Function
--
------------------------------------------------------------------------
define method .save()

  -- save all the data
  !this.data.save()

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load the defaults
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- load the data
  !this.data.load()

  -- display the data
  !this.listRules()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: method to execute on ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- save all the data
  !this.save()
  handle (12, 003)
    show !!ruleDef
  elsehandle none
    -- copy the data to the global ruleStore
    !this.data.copyToGlobal()
  endhandle

  -- run the additional pml code
  $!<this.function>
  !this.function = ''

endmethod
-- End of method definition for .ok()
