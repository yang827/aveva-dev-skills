--
-- File:            runmacro.pmlfrm
--   Type:          Form Definition
--   Group:         General
--     Keyword:     COMMON
--   Module:        common
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Fri May 21 10:39:47 2004
--
--
-- Description:     Form to allow user to edit macro within PDMS and run it
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  executeMacro()                   -                   Runs contents of textpane as a macro
--  runMacro()                       -                   Constructor method
--
------------------------------------------------------------------------
setup form !!runMacro resize
  title 'Run macro'
  textpane .macro anchor top + left + bottom + right at xmin ymin at x0 y0 width 40 height 20
  path down
  button .run anchor bottom + left 'Run macro' callback '!this.executeMacro()'
  path right
  button .clear 'Clear' anchor bottom + right at xmax form-size callback '!this.macro.clear()'

  member .filename is STRING
exit

------------------------------------------------------------------------
--
-- Method:      .runMacro()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .runMacro()
  !this.filename = '%PDMSUSER%\tmpmacro.mac'

  !file = object FILE(!this.filename)
  if (!file.exists()) then
    !lines = !file.readFile()
    !this.macro.val = !lines
  endif
endmethod
-- End of method definition for .executeMacro()

------------------------------------------------------------------------
--
-- Method:      .executeMacro()
--
-- Description: Runs contents of textpane as a macro
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .executeMacro()
  -- get contents of text pane
  !macro = !this.macro.val

  -- output them to a file
  !file = object FILE(!this.filename)
  !file.writeFile('OVERWRITE', !macro)

  -- run in the macro
  $m "$!this.filename"
endmethod
