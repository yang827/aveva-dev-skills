setup form !!shipReferenceGrids dialog dock size 42 9

  !this.formTitle     = 'Ship Reference Grids'
  !this.iconTitle     = 'Ship Grids'
  !this.callback      = '!this.setup()'
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision$ '

  -- Grids
  paragraph .gridTag                     anchor left + right + top        at xmin form          ymin          width 25.5 lines 1
  toggle .xyGrid 'X and Y Gridlines' tagwidth 20 anchor left + top        at x2                 ymax-0.2
  toggle .yzGrid 'Y and Z Gridlines' tagwidth 20 anchor left + top        at x2                 ymax
  toggle .xzGrid 'X and Z Gridlines' tagwidth 20 anchor left + top        at x2                 ymax

  -- Position & Tagging
  paragraph .positionTag                 anchor left + right + top        at xmin form          ymax          width 25.5 lines 1

  text .xTagLine   'Frame'      tagwidth 8   anchor left + top            at x2                 ymax-0.1      width 3  is REAL format !!integerFmt
  text .xIncrement 'Tag every ' tagwidth 7   anchor left + top            at xmax+1.5           ymin          width 3  is REAL format !!integerFmt
  paragraph .xColourT                        anchor left + top            at xmax+1.5           ymin text 'Colour'
  button    .xColourB ' '                    anchor left + top            at xmax+1             ymin
  text .yTagLine   'Lg (Horz)'  tagwidth 8   anchor left + top            at x2                 ymax+0.1      width 3  is REAL format !!integerFmt
  text .yIncrement 'Tag every ' tagwidth 7   anchor left + top            at xmax+1.5           ymin          width 3  is REAL format !!integerFmt
  paragraph .yColourT                        anchor left + top            at xmax+1.5           ymin          text 'Colour'
  button    .yColourB ' '                    anchor left + top            at xmax+1             ymin
  text .zTagLine   'Lg (Vert)'  tagwidth 8   anchor left + top            at x2                 ymax+0.1      width 3  is REAL format !!integerFmt
  text .zIncrement 'Tag every ' tagwidth 7   anchor left + top            at xmax+1.5           ymin          width 3  is REAL format !!integerFmt
  paragraph .zColourT                        anchor left + top            at xmax+1.5           ymin          text 'Colour'
  button    .zColourB ' '                    anchor left + top            at xmax+1             ymin

  -- Form Members

  -- Graphical Ship Reference Grids (ship ref grid is .grid of this object)
  member .shipGrids     is GPHSHIPGRID

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      shipReferenceGrids
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close form
--  displayXY()                      -                   Display XY grid plane
--  displayXZ()                      -                   Display XZ grid plane
--  displayYZ()                      -                   Display YZ grid plane
--  isGTzero(GADGET,STRING)          BOOLEAN             Is value greater than zero
--  isValidReference(GADGET,STRING)  BOOLEAN             Validate that tag line is in the range
--  setColour(STRING)                -                   Change grid line colour
--  setData()                        -
--  setIncrement()                   -                   Display XZ grid plane
--  setup()                          -                   Setup form
--  shipReferenceGrids()             -                   Constructor
--

define method .shipReferenceGrids()
 -- Initialise Variables
  !this.gridTag.val           					= 'Display Reference Grids for:'
  !this.positionTag.val       					= 'Position Grid Planes and Tags Through:'
                              					
  !gridDefined													= !this.shipGrids.grid.position.set()

  if(!gridDefined.not())then
  	!!alert.error('The MDB does not contain ship grids to display.')
    -- Cancel callback
    !this.cancelCall            			= '!this.close()'
    !this.xTagLine.callback						= '!!alert.error(|The MDB does not contain ship grids to display.|)'
 		!this.yTagLine.callback						= '!!alert.error(|The MDB does not contain ship grids to display.|)'
 		!this.zTagLine.callback						= '!!alert.error(|The MDB does not contain ship grids to display.|)'
 		
 		!this.xyGrid.callback     				= '!!alert.error(|The MDB does not contain ship grids to display.|)'
 		!this.yzGrid.callback     				= '!!alert.error(|The MDB does not contain ship grids to display.|)'
 		!this.xzGrid.callback     				= '!!alert.error(|The MDB does not contain ship grids to display.|)'
 		
 		-- Set Validation check for tag lines
 		!this.xIncrement.callback 				= '!!alert.error(|The MDB does not contain ship grids to display.|)'
 		!this.yIncrement.callback 				= '!!alert.error(|The MDB does not contain ship grids to display.|)'
 		!this.zIncrement.callback 				= '!!alert.error(|The MDB does not contain ship grids to display.|)'
 		
 		!this.xColourB.callback = '!!alert.error(|The MDB does not contain ship grids to display.|)'
 	  !this.yColourB.callback = '!!alert.error(|The MDB does not contain ship grids to display.|)'
 	  !this.zColourB.callback = '!!alert.error(|The MDB does not contain ship grids to display.|)'

	  return
  endif
 	-- Increments
 	!this.shipGrids.xIncrement  				= 5
 	!this.shipGrids.yIncrement  				= 1
 	!this.shipGrids.zIncrement  				= 1
 		
 	-- Graphical aid colours (get aid index from aidNumbers)
 	!this.shipGrids.baseAid     				= !!aidNumbers.add('Ship Reference Base lines')
 	!this.shipGrids.tagAid      				= !!aidNumbers.add('Ship Reference Tag Lines')
 	!this.shipGrids.gridAidXY   				= !!aidNumbers.add('Ship Reference Grid XY')
 	!this.shipGrids.gridAidYZ   				= !!aidNumbers.add('Ship Reference Grid YZ')
 	!this.shipGrids.gridAidXZ   				= !!aidNumbers.add('Ship Reference Grid XZ')
 	
 	-- Set Validation check for tag lines
 	!this.xTagLine.validateCall 				= '!this.isValidReference('
 	!this.yTagLine.validateCall 				= '!this.isValidReference('
 	!this.zTagLine.validateCall 				= '!this.isValidReference('
 	
 	-- Set Validation check for tag lines
 	!this.xIncrement.validateCall 			= '!this.isGTzero('
 	!this.yIncrement.validateCall 			= '!this.isGTzero('
 	!this.zIncrement.validateCall 			= '!this.isGTzero('
 	
 	--Callbacks for Increments
 	!this.xIncrement.callback 					= '!this.setIncrement()'
 	!this.yIncrement.callback 					= '!this.setIncrement()'
 	!this.zIncrement.callback 					= '!this.setIncrement()'		
 	
 	-- Load Tags
 	!this.xTagLine.tag    							= !this.shipGrids.grid.xTag
 	!this.yTagLine.tag    							= !this.shipGrids.grid.yTag
 	!this.zTagLine.tag    							= !this.shipGrids.grid.zTag
 	
 	--Callbacks for Taglines 		
 	!this.xTagLine.callback						= '!this.setData()'
 	!this.yTagLine.callback						= '!this.setData()'
 	!this.zTagLine.callback						= '!this.setData()'
 		
 	!this.xColourB.callback = |!!colourSelectLoad('!!shipReferenceGrids.setColour(''xLine'')', 'X Line Colour', !this.shipGrids.gridColourXY)|
 	!this.yColourB.callback = |!!colourSelectLoad('!!shipReferenceGrids.setColour(''yLine'')', 'Y Line Colour', !this.shipGrids.gridColourYZ)|
 	!this.zColourB.callback = |!!colourSelectLoad('!!shipReferenceGrids.setColour(''zLine'')', 'Z Line Colour', !this.shipGrids.gridColourXZ)|
 		 		
 	
 	!this.xyGrid.tag      = !this.shipGrids.grid.xTag & ' Gridlines'
 	!this.yzGrid.tag      = !this.shipGrids.grid.yTag & ' Gridlines'
 	!this.xzGrid.tag      = !this.shipGrids.grid.zTag & ' Gridlines'
 	
 	--Callbacks for toggle
 	!this.xyGrid.callback 				 			= '!this.displayXY()'
 	!this.yzGrid.callback				 			= '!this.displayYZ()'
 	!this.xzGrid.callback				 			= '!this.displayXZ()' 		

    -- Cancel callback
  !this.cancelCall            = '!this.close()'

  !this.xColourB.background  = !this.shipGrids.gridColourXY
  !this.yColourB.background  = !this.shipGrids.gridColourYZ
  !this.zColourB.background  = !this.shipGrids.gridColourXZ

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Remove base lines if there are no grids shown
  !remove = !this.shipGrids.xyVisible.not() and !this.shipGrids.yzVisible.not() and !this.shipGrids.xzVisible.not()
  if(!remove) then
    !this.shipGrids.hideBaseLines()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isValidReference
--
-- Description: Validate that tag line is in the range
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget invoked from
--    2   R      STRING      Selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isValidReference(!gadget is GADGET, !dummyString is STRING) is BOOLEAN

  -- Initialise Variables
  !value    = !gadget.val

  -- Assume 0 is always valid
  if(!value.eq(0)) then
    return true
  endif

  -- Check values are in range
  if(!gadget.name().eq('XTAGLINE')) then
    !range  = !this.shipGrids.grid.xRange()
  elseif (!gadget.name().eq('YTAGLINE')) then
    !range  = !this.shipGrids.grid.yRange()
  elseif (!gadget.name().eq('ZTAGLINE')) then
    !range  = !this.shipGrids.grid.zRange()
  endif

  -- Check value is valid
  if( !range[1] gt !range[2] ) then
    -- swap range if grid defined in opposite sense
    !temp     = !range[2]
    !range[2] = !range[1]
    !range[1] = !temp
  endif
  if(!gadget.val.between(!range[1], !range[2]).not()) then
    !!alert.warning('Value must lie between $!range[1] and $!range[2]')
    return false
  endif

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isGTzero
--
-- Description: Is value greater than zero
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget invoked from
--    2   R      STRING      Selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isGTzero(!gadget is GADGET, !dummyString is STRING) is BOOLEAN

  -- Initialise Variables
  !value    = !gadget.val

  -- Value
  if(!value.leq(0)) then
    !gadget.val = 1
    !!alert.warning('Value must be greater than zero.')
    return false
  endif

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Set Visible Grids
  !this.xyGrid.val      = !this.shipGrids.xyVisible
  !this.yzGrid.val      = !this.shipGrids.yzVisible
  !this.xzGrid.val      = !this.shipGrids.xzVisible

  -- Set default tag position line
  !this.xTagLine.val    = !this.shipGrids.xTagLine
  !this.yTagLine.val    = !this.shipGrids.yTagLine
  !this.zTagLine.val    = !this.shipGrids.zTagLine

  -- Set default tag increments
  !this.xIncrement.val  = !this.shipGrids.xIncrement
  !this.yIncrement.val  = !this.shipGrids.yIncrement
  !this.zIncrement.val  = !this.shipGrids.zIncrement

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      set
--
-- Description: Set values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setData()

  -- Set default tag position line
  !this.shipGrids.xTagLine    = !this.xTagLine.val
  !this.shipGrids.yTagLine    = !this.yTagLine.val
  !this.shipGrids.zTagLine    = !this.zTagLine.val

  -- Set default tag increments
  !this.shipGrids.xIncrement  = !this.xIncrement.val
  !this.shipGrids.yIncrement  = !this.yIncrement.val
  !this.shipGrids.zIncrement  = !this.zIncrement.val

  -- Display grids
  !this.displayXY()
  !this.displayYZ()
  !this.displayXZ()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      displayXY
--
-- Description: Display XY grid plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayXY()

  -- Display grid
  if(!this.xyGrid.val) then
    !this.shipGrids.drawXY()

  -- Hide grid
  else
    !this.shipGrids.hideXY()
  endif

  -- Show Tags and Base Lines
  !this.shipGrids.tagGrids()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      displayXZ
--
-- Description: Display XZ grid plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayXZ()

  -- Display grid
  if(!this.xzGrid.val) then
    !this.shipGrids.drawXZ()

  -- Hide grid
  else
    !this.shipGrids.hideXZ()
  endif

  -- Show Tags and Base Lines
  !this.shipGrids.tagGrids()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      displayYZ
--
-- Description: Display YZ grid plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayYZ()

  -- Display grid
  if(!this.yzGrid.val) then
    !this.shipGrids.drawYZ()

  -- Hide grid
  else
    !this.shipGrids.hideYZ()
  endif

  -- Show Tags and Base Lines
  !this.shipGrids.tagGrids()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setIncrement
--
-- Description: Display XZ grid plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setIncrement()

  -- Initialise Variables
  !this.shipGrids.xIncrement = !this.xIncrement.val
  !this.shipGrids.yIncrement = !this.yIncrement.val
  !this.shipGrids.zIncrement = !this.zIncrement.val

  !this.shipGrids.tagGrids()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setColour
--
-- Description: Change grid line colour
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setColour(!element is STRING)

	!colCode = !!colourSelectGet()

	if (!element eq 'xLine') then
    !this.xColourB.background = !colCode
    !this.shipGrids.gridColourXY = !colCode

    if(!this.xyGrid.val) then
    	!this.shipGrids.hideXY()
    	!this.shipGrids.drawXY()
    endif

  elseif (!element eq 'yLine') then
    !this.yColourB.background = !colCode
    !this.shipGrids.gridColourYZ = !colCode

    if(!this.yzGrid.val) then
    	!this.shipGrids.hideYZ()
    	!this.shipGrids.drawYZ()
    endif

  elseif (!element eq 'zLine') then
    !this.zColourB.background = !colCode
    !this.shipGrids.gridColourXZ = !colCode

    if(!this.xzGrid.val) then
    	!this.shipGrids.hideXZ()
    	!this.shipGrids.drawXZ()
    endif
  endif
	
endmethod
