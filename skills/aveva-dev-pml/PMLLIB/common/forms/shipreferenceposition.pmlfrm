setup form !!shipReferencePosition dialog dock size 33 7

  !this.formTitle     = 'Position - Ship Reference'
  !this.iconTitle     = 'Position'
  !this.callback      = '!this.track()'
  !this.cancelCall    = ''
  !this.formRevision  = ' $Revision$ '

  -- Look to tracking events
  track 'DESICE'    call '!this.track()'
  track 'SCHECE'    call '!this.track()'
  track 'DBCHANGED' call '!this.track()'

  -- Current Element
  paragraph .elementName                anchor left + right + top     at xmin               ymin      width 32 lines 1

  -- Frame information
  text .xGridline 'Frame'   tagwidth 8  anchor left + top             at x1                 ymax+0.65 callback '!this.setData()'      width 4  is REAL format !!integerFmt
  text .xOffset                         anchor left + top             at xmax+0.25          ymin      callback '!this.setData()'      width 8  is REAL format !!distanceFmt
  text .xPosition 'X'                   anchor left + right + top     at xmax+1             ymin      callback '!this.setPosition()'  width 13 is REAL format !!distanceFmt

  -- Horizontal Longitude information
  text .yGridline  'Lg (Horz)' tagwidth 8  anchor left + top          at x1                 ymax+0.1  callback '!this.setData()'      width 4  is REAL format !!integerFmt
  text .yOffset                         anchor left + top             at xmax+0.25          ymin      callback '!this.setData()'      width 8  is REAL format !!distanceFmt
  text .yPosition 'Y'                   anchor left + right + top     at xmax+1             ymin      callback '!this.setPosition()'  width 13 is REAL format !!distanceFmt

  -- Vertical Longitude information
  text .zGridline  'Lg (Vert)' tagwidth 8  anchor left + top          at x1                 ymax+0.1  callback '!this.setData()'      width 4  is REAL format !!integerFmt
  text .zOffset                         anchor left + top             at xmax+0.25          ymin      callback '!this.setData()'      width 8  is REAL format !!distanceFmt
  text .zPosition 'Z'                   anchor left + right + top     at xmax+1             ymin      callback '!this.setPosition()'  width 13 is REAL format !!distanceFmt

  -- Column headings
  paragraph .offsetTag                  anchor left + top             at xmin.xOffset+1.5   ymin.xOffset-0.8  text 'Offset'
  paragraph .positionTag                anchor left + right + top     at xmin.xPosition+2.5 ymin              width 9.5 lines 1

  -- Display
  --toggle .display ' Display Offset in 3D View' anchor left + top      at x1                 ymax.zPosition+0.1  callback '!this.drawOffset()'

  -- Reset
  button .reset 'Reset'                 anchor left + top             at xmin form          ymax.zPosition+0.1  callback '!this.setup()' width 7 height 1

  -- Apply
  button .apply 'Apply'                 anchor right + top            at xmax form-size     ymin      callback '!this.apply()' width 7 height 1

  -- Form Data

  -- Element
  member .element   is DBREF

  -- Ship Grid
  member .shipGrid  is SHIPGRID

  -- Offset of graphics from position
  member .offset    is POSITION

  -- Current position
  member .position  is POSITION

  -- Encapsulating box of element
  member .box       is GMFBOX

  -- Aid Number
  member .aidVolume is REAL
  member .aidOffset is REAL

  -- Undo for creation
  member .undo                  is UNDOABLE

  -- Flag for not tracking
  member .trackFlag   is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      shipReferencePosition
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply position to element
--  close()                          -                   Close form
--  drawOffset()                     -                   Draw offset
--  drawVolume()                     -                   Set values
--  isValidReference(GADGET,STRING)  BOOLEAN             Validate that tag line is in the range
--  setData()                        -
--  setPosition()                    -                   Set position
--  setup()                          -                   Setup for current element
--  shipReferencePosition()          -                   Constructor
--  track()                          -                   Handle tracking events
--

define method .shipReferencePosition()

  -- Initialise Variables
  !this.positionTag.val     = 'World Position'

  !this.xGridline.val       = 0
  !this.xOffset.val         = 0
  !this.xPosition.val       = 0
  !this.zGridline.val       = 0
  !this.yOffset.val         = 0
  !this.yPosition.val       = 0
  !this.zGridline.val       = 0
  !this.zOffset.val         = 0
  !this.zPosition.val       = 0

  -- Cancel callback
  !this.cancelCall          = '!this.close()'

  -- Set Validation check for tag lines
  !this.xGridline.validateCall  = '!this.isValidReference('
  !this.yGridline.validateCall  = '!this.isValidReference('
  !this.zGridline.validateCall  = '!this.isValidReference('

  -- Aid Number
  !this.aidVolume               = !!aidNumbers.add('Ship reference positioning')
  !this.aidOffset               = !!aidNumbers.add('Ship reference positioning')

  -- Load Tags
  !this.xGridline.tag       = !this.shipGrid.xTag
  !this.yGridline.tag       = !this.shipGrid.yTag
  !this.zGridline.tag       = !this.shipGrid.zTag

  -- Track Flag
  !this.trackFlag = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Clear graphics
  AID CLEAR ALL $!<this.aidVolume>
  AID CLEAR ALL $!<this.aidOffset>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply position to element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  -- Turn off tracking
  !this.trackFlag = false

  -- Define UNDO Information
  !this.undo.description('Modified position of ' & !this.element.flnn)
  !this.undo.add()

  -- Modify position
  !this.element.position  = !this.position
  -- also handle XYOFFSET elements such as room
  !hasOffset        = !!ce.attributes().findFirst('XYOffset').unset()
  if(!hasOffset.not() ) then
    !offset[1]   = !this.element.position.east
    !offset[2]   = !this.element.position.north
    !this.element.xyOffset  = !offset
  endif

  -- Mark end of Undo
  !this.undo.endUndoable()

  -- Turn on tracking
  !this.trackFlag = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isValidReference
--
-- Description: Validate that tag line is in the range
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .isValidReference(!gadget is GADGET, !dummyString is STRING) is BOOLEAN

  -- Initialise Variables
  !value    = !gadget.val

  -- Assume 0 is always valid
  if(!value.eq(0)) then
    return true
  endif

  -- Check values are in range
  if(!gadget.name().eq('XGRIDLINE')) then
    !range  = !this.shipGrid.xRange()
  elseif (!gadget.name().eq('YGRIDLINE')) then
    !range  = !this.shipGrid.yRange()
  elseif (!gadget.name().eq('ZGRIDLINE')) then
    !range  = !this.shipGrid.zRange()
  endif

  -- Check value is valid
  if( !range[1] gt !range[2] ) then
    -- swap range if grid defined in opposite sense
    !temp     = !range[2]
    !range[2] = !range[1]
    !range[1] = !temp
  endif
  if(!gadget.val.between(!range[1], !range[2]).not()) then
    return error 1 'Value must lie between $!range[1] and $!range[2]'
  endif

  -- Return
  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: Handle tracking events
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track()

  if (!this.trackFlag.not()) then
    !this.trackFlag = true
    return
  endif

  -- If element does not have a position attribute, then we will
  -- make the form inactive.
  !hasPosition        = !!ce.attributes().findFirst('Position').unset()
  if(!hasPosition) then
    -- also handle XYOFFSET elements such as room
    !hasPosition        = !!ce.attributes().findFirst('XYOffset').unset()
    if(!hasPosition) then
      !this.setActive(false)
      return
    else
      !this.setActive(true)
      !this.zGridline.active = false
      !this.zOffset.active = false
      !this.zPosition.active = false
    endif
  else
    !this.setActive(true)
    !this.zGridline.active = true
    !this.zOffset.active = true
    !this.zPosition.active = true
  endif

  -- Current elements
  !this.element       = !!ce

  -- Check element is modifiable, if it isn't don't allow apply
  !this.apply.active  = !!dbRefUpdatable(!this.element)

  -- Setup
  !this.setup()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description: Setup for current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Display element name
  !this.elementName.val = 'Position of Element: '& !this.element.flnn

  -- Position
  !this.position        = !this.element.position.wrt(World)
  !this.xPosition.val   = !this.position.east
  !this.yPosition.val   = !this.position.north
  !this.zPosition.val   = !this.position.up

  -- Get ship position
  !shipGridPosition     = !this.shipGrid.shipGridPosition(!this.position)
  !this.xGridline.val   = !shipGridPosition.xGridline
  !this.xOffset.val     = !shipGridPosition.xOffset
  !this.yGridline.val   = !shipGridPosition.yGridline
  !this.yOffset.val     = !shipGridPosition.yOffset
  !this.zGridline.val   = !shipGridPosition.zGridline
  !this.zOffset.val     = !shipGridPosition.zOffset

  -- Get volume of element
  !volume               = object VOLUME(!this.element)
  !this.box             = !volume.box()
  handle ANY
    !this.box.position    = !this.position
    !this.box.orientation = !this.orientation
    handle ANY
      !this.box.orientation = Y is N
    endhandle
    !this.box.xlength     = 100mm
    !this.box.ylength     = 100mm
    !this.box.zlength     = 100mm
    return
  endhandle

  -- Derive the offset between the graphics and position
  !this.offset          = N0
  !this.offset.east     = !this.position.east  - !this.box.position.east
  !this.offset.north    = !this.position.north - !this.box.position.north
  !this.offset.up       = !this.position.up    - !this.box.position.up

  -- Draw graphics
  !this.drawVolume()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPosition
--
-- Description: Set position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setPosition()

  -- Get position
  !this.position.east   = !this.xPosition.val
  !this.position.north  = !this.yPosition.val
  !this.position.up     = !this.zPosition.val

  -- Get ship position
  !shipGridPosition     = !this.shipGrid.shipGridPosition(!this.position)
  !this.xGridline.val   = !shipGridPosition.xGridline
  !this.xOffset.val     = !shipGridPosition.xOffset
  !this.yGridline.val   = !shipGridPosition.yGridline
  !this.yOffset.val     = !shipGridPosition.yOffset
  !this.zGridline.val   = !shipGridPosition.zGridline
  !this.zOffset.val     = !shipGridPosition.zOffset

  -- Draw graphics
  !this.drawVolume()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      set
--
-- Description: Set values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setData()

  -- Get new position
  !this.position      = !this.shipGrid.position(!this.xGridline.val,!this.xOffset.val, !this.yGridline.val, !this.yOffset.val, !this.zGridline.val, !this.zOffset.val)

  -- Update position gadgets
  !this.position      = !this.position.wrt(World)
  !this.xPosition.val = !this.position.east
  !this.yPosition.val = !this.position.north
  !this.zPosition.val = !this.position.up

  -- Draw graphics
  !this.drawVolume()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawVolume
--
-- Description: Set values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawVolume()

  !session            = CURRENT SESSION
  !module             = !session.module()

  if(!module neq 'DIAGRAMS') then
    -- Set new position
    !this.box.position.east   = !this.position.east   - !this.offset.east
    !this.box.position.north  = !this.position.north  - !this.offset.north
    !this.box.position.up     = !this.position.up     - !this.offset.up
    !graphicsBox              = object GPHBOX(!this.box)
    !graphicsBox.draw(!this.aidVolume)
    aid text number $!<this.aidVolume> 'Origin' at $!<this.position>

    -- Draw offset
    --!this.drawOffset()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      drawOffset
--
-- Description: Draw offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drawOffset()

  !session            = CURRENT SESSION
  !module             = !session.module()

  if(!module neq 'DIAGRAMS') then
    -- Clear graphics
    AID CLEAR ALL $!<this.aidOffset>

    -- Draw offset from grid lines
    if(!this.display.val) then

      -- Get position
      !start          = !this.shipGrid.position(!this.xGridline.val, !this.yGridline.val, !this.zGridline.val)
      !end            = !this.position
      !from           = !start
      !to             = !start

      -- X Offset
      if(!this.xOffset.val.neq(0)) then
        !to           = !from
        !to.east      = !end.east
        !line         = !from.line(!to)
        !line.draw(!this.aidOffset, 1, 4)
        !midPoint     = !from.midPoint(!to)
        !displayText  = 'X ' & !this.xOffset.val.string(!!distanceFmt)
        AID TEXT NUMBER $!<this.aidOffset> |$!displayText| AT $!<midPoint>
        !from         = !to
      endif

      -- Y Offset
      if(!this.yOffset.val.neq(0)) then
        !to           = !from
        !to.north     = !end.north
        !line         = !from.line(!to)
        !line.draw(!this.aidOffset, 1, 4)
        !midPoint     = !from.midPoint(!to)
        !displayText  = 'Y ' & !this.yOffset.val.string(!!distanceFmt)
        AID TEXT NUMBER $!<this.aidOffset> |$!displayText| AT $!<midPoint>
        !from         = !to
      endif

      -- Z Offset
      if(!this.zOffset.val.neq(0)) then
        !to           = !from
        !to.up        = !end.up
        !line         = !from.line(!to)
        !line.draw(!this.aidOffset, 1, 4)
        !midPoint     = !from.midPoint(!to)
        !displayText  = 'Z ' & !this.zOffset.val.string(!!distanceFmt)
        AID TEXT NUMBER $!<this.aidOffset> |$!displayText| AT $!<midPoint>
        !from         = !to
      endif

    endif
  endif
endmethod
-- End of method
