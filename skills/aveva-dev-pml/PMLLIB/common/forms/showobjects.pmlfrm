--
-- File:            showobjects.pmlfrm
--   Type:          Form Definition
--   Group:
--     Keyword:
--   Module:        COMMON
--   Application:
--   Replaces:      NONE
--
-- Author:          P.Mooney
-- Created:         Tue Mar 4 14:25:06 GMT 1997
--
--
-- Description:
-- Displays the Object selected in the command window of the form.
-- This is an aid to developers so they can see the state of their object
-- at any time.
-- They must call IncludeObject(OBJECT) for this form to know about it.
--
------------------------------------------------------------------------

kill       !!showObjects
setup form !!showObjects

  title    'Show Objects'
  iconti   'Objects'

  list   _list    'Objects;' at x1 y0call 'call !!queryObject(!!showObjects.list.selection(|RTEXT|))' width 55 length 10
  para   _newText   at xmin ymax text 'New Object;'    width 20 lines 1
  button _copy      '  Copy Object  '   at xmax+2  ymin call 'call !!notDoneYet()'
  button _delete    ' Delete Object ' at xmax+1  ymin call 'call !!deleteObject(!!showObjects.list.selection(|RTEXT|))'
  text   _newObject at xmin_newText ymax call |call !!includeObject(!!showObjects.newObject.val)| width 55 string

  -------------------------------------------------------------
  -- Display output goes to command line type gadget ALPHA VIEW
  -------------------------------------------------------------

  view _output at xmin_newObject-1 ymax_newObject alpha
     width 55
     height 15
     channel requests
  exit

  button _dismiss 'Dismiss' at xmax_output-9 ymax cancel

exit
