-- File:            spcedit.pmlfrm
--   Type:          Form Definition
--   Group:         Specification handling utilities
--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Jun 2 12:15:20 BST 1998
--
--
-- Description:
-- Edit a specification.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  answerAdd()                      -                   Add a new answer to the list
--  answerRemove()                   -                   Remove an answer to the list
--  answerReplace()                  -                   Replace the current answer to the list
--  answerType()                     -                   Grey in/out answer input gadgets
--  answerType(DBREF)                STRING              Returns answer "type" of item
--  answerType(GADGET,STRING)        -                   Select answer type
--  answers()                        -                   Generate list of current answers
--  defaultSet()                     -                   Make current selection the default
--  edit(DBREF)                      -                   Edit passed specifications
--  newDefault(GADGET,STRING)        -                   Check and set new default
--  newDescription()                 -                   Check and set new description
--  newName()                        -                   Check and set new name
--  newQualifier(GADGET,STRING)      -                   Check and set new qualifier
--  newQuestion()                    -                   Check and set new tQuestion
--  newQuestionKey()                 -                   Check and set new question
--  qualifierType()                  -                   Grey in/out qualifier input gadgets
--  qualifierType(GADGET,STRING)     -                   Select qualifier type
--  refreshAnswer()                  -                   Check and set new answer
--  select()                         -                   Grey in/out parent and select buttons
--  selectAnswer()                   -                   Select answer
--  setup()                          -                   Setup form to "current selector"
--  setup(DBREF)                     -                   Setup form to passed item
--
------------------------------------------------------------------------

setup form !!spcEdit

  !!spcEdit.formTitle     = 'Specification Editor'
  !!spcEdit.iconTitle     = ''
  !!spcEdit.callback      = ''
  !!spcEdit.formRevision  = ' $Revision: 1.15 $ '

  -- Body of form definition

  -- Specification
  button    .ce 'Specification' at xmin   ymax callback '!this.edit(SPEC)'
  paragraph .ceName  at xmax+1 ymin width 30 lines 1

  -- Attributes
  frame .attribFrame 'Attributes' at xmin.ce ymax width 60

    -- Name
    text .name        'Name ' at x8 y1 callback '!this.newName()'     width 40 is STRING

    -- Description
    path down
    halign right
    text .description 'Description '   callback '!this.newDescription()' width 40 is STRING

    -- Question Frame
    frame .questionFrame 'Question & Qualifiers' at x13 ymax+0.5

      -- Question
      text .question    'Display ' at x1     ymax callback '!this.newQuestion()'    width 30 scroll 30 is STRING
      text .questionKey 'Key '     at xmin+4 ymax callback '!this.newQuestionKey()' width 4  scroll 4  is STRING

      -- Qualifier
      frame .qualifierFrame 'Selection Qualifier' at xmin.question ymax+0.5

        -- Attribute Qualifier
        toggle .qualAttribType          at x1   ymax callback '!this.qualifierType(' states 'FALSE' 'TRUE'
        toggle .qualFuncType                         callback '!this.qualifierType(' states 'FALSE' 'TRUE'
        toggle .qualValueType                        callback '!this.qualifierType(' states 'FALSE' 'TRUE'
        text   .qualAttrib 'Attribute ' at xmax.qualAttribType   ymin.qualAttribType callback '!this.newQualifier(' width 22 is STRING
        text   .qualFunc   'Function '                                               callback '!this.newQualifier(' width 22 is STRING
        text   .qualValue  'Value '     at xmax.qualAttribType+4 ymin.qualValueType  callback '!this.newQualifier(' width 7  is REAL
      exit
    exit
  exit

  -- Answers
  frame .answerFrame 'Answers' at xmin.attribFrame ymax+0.25 width 60

    -- Members
    list .answers '        Definition                Description' at xmin+0.5 y1 callback '!this.selectAnswer()' width 55 length 10

    -- Navigate Buttons
    button .parent 'Parent' at xmax-size ymax-0.5 callback '!this.setup(!this.selector.owner)'
    path left
    button .select 'Select'                       callback '!this.setup(!this.answers.selection().dbRef())'
    path down

    -- Default
    frame .defaultFrame 'Default' at xmin.answers ymax.answers
      button .default     ' Use '      at x3             ymax callback '!this.defaultSet()'
      text   .defaultText 'Text '      at xmax+2         ymin callback '!this.newDefault('  width 22 is STRING
      text   .defaultVal  'Value '     at xmax.default+1 ymax callback '!this.newDefault('  width 7  is REAL
    exit

    -- Answers
    frame .answerFrameDef 'Definition' at xmin ymax+0.5

      -- Element Type
      option .type 'Element Type ' width 25
      !dText[1] = '(SELE) Selection'
      !rText[1] = 'SELE'
      !dText[2] = '(SPCO) Catalogue Pointer'
      !rText[2] = 'SPCO'
      _type.dText = !dText
      _type.rText = !rText

      -- Attribute Qualifier
      toggle .answerTextType    at x4   ymax callback '!this.answerType(' states 'FALSE' 'TRUE'
      toggle .answerValType                  callback '!this.answerType(' states 'FALSE' 'TRUE'
      toggle .answerRangeType                callback '!this.answerType(' states 'FALSE' 'TRUE'
      text   .answerText       'Text '   at xmax.answerTextType+2 ymin.answerTextType width 21 is STRING
      text   .answerVal        'Value '  at xmax.answerValType+1  ymin.answerValType  width 7 is REAL
      text   .answerRangeMin   'Rangle '                                              width 7 is REAL
      text   .answerRangeMax    ' to '   at xmax ymin                                 width 7 is REAL

      -- Modify
      frame .answerFrameEdit 'Action' at xmax.type+1 y0.5
        button .include ' Include ' at x1 y1 callback '!this.answerAdd()'
        button .replace ' Replace '          callback '!this.answerReplace()'
        button .remove  ' Remove  '          callback '!this.answerRemove()'
      exit
   exit

  exit

  -- Form Members
  member .specification  is DBREF
  member .selector       is DBREF

  -- Answer Type
  member .answerType     is STRING
  -- Default Type
  member .defaultType    is STRING

exit
-- End of form definition for !!spcEdit

------------------------------------------------------------------------
--
-- Method:      edit
--
-- Description:
--   Edit passed specifications
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Specification to edit
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .edit(!specification is DBREF)

  -- Check we have a spec
  if(!specification.type ne 'SPEC') then
    !!alert.error('Can only modify specifications.')
    !this.ce.setFocus()
    return
  endif

  -- Set form data
  !this.specification = !specification
  !this.selector      = !specification

  -- Set current name
  !this.ceName.val = !specification.flnn

  -- Setup form
  !this.setup()

  -- Display Form
  show !!spcEdit

endmethod
-- End of method definition for .edit(DBREF)

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup form to "current selector"
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup()

  -- Current Name
  if(!this.selector.name eq !this.selector.refNo.string()) then
    !this.name.val = ''
  else
    !this.name.val = !this.selector.flnn
  endif

  -- Set description
  if(!this.selector.description.set() and !this.selector.description.empty().not()) then
    !this.description.val = !this.selector.description
  else
    !this.description.val = ''
  endif

  !!ce = !this.selector

  -- Display Question
  !this.question.val    = !this.selector.tQuestion
  !this.questionKey.val = !this.selector.question
  -- Set question if its missing
  if(!this.question.val.empty() and !this.questionKey.val.empty().not()) then
    !this.question.val = !this.questionKey.val
    !this.newQuestion()
  elseif (!this.question.val.empty().not() and !this.questionKey.val.empty()) then
    !this.questionKey.val = !this.question.val.part(1)
    !this.newQuestionKey()
  endif

  -- Determine the Qualifier Type

  -- Qualifier Type
  if(!this.selector.tQualifier.set() and !this.selector.tQualifier.empty().not()) then

    -- What type of qualifier
    -- Function/Method
    if(!this.selector.tQualifier.subString(1,2) eq '!!') then
      !this.qualAttribType.val = false
      !this.qualFuncType.val   = true
      !this.qualValueType.val   = false
      !this.qualFunc.val       = !this.selector.tQualifier
      !this.qualAttrib.val     = STRING()
      !this.qualValue.val      = REAL()

    -- Assume Attribute
    else
      !this.qualAttribType.val = true
      !this.qualFuncType.val   = false
      !this.qualValueType.val  = false
      !this.qualAttrib.val     = !this.selector.tQualifier
      !this.qualFunc.val       = STRING()
      !this.qualValue.val      = REAL()
    endif

  -- Word Qualifier given
  elseif (!this.selector.qualifier.set() and !this.selector.qualifier ne 0) then
    !this.qualAttribType.val = false
    !this.qualFuncType.val   = false
    !this.qualValueType.val  = true
    !this.qualAttrib.val     = STRING()
    !this.qualFunc.val       = STRING()
    !this.qualValue.val      = !this.selector.qualifier

  -- No define qualifiers
  else
    !this.qualAttribType.val = false
    !this.qualFuncType.val   = true
    !this.qualValueType.val  = false
    !this.qualAttrib.val     = STRING()
    !this.qualFunc.val       = STRING()
    !this.qualValue.val      = REAL()

  endif

  -- Determine the Qualifier Type
  -- Text Default
  if(!this.selector.tDefault.set() and !this.selector.tDefault.empty().not()) then
    !this.defaultText.val = !this.selector.tDefault
    !this.defaultVal.val  = REAL()
    !this.defaultType     = 'STRING'

  -- Real Default
  elseif (!this.selector.default ne 0) then
    !this.defaultText.val = STRING()
    !this.defaultVal.val  = !this.selector.default
    !this.defaultType     = 'REAL'

  -- Assume Text Default
  else
    !this.defaultText.val = STRING()
    !this.defaultVal.val  = REAL()
    !this.defaultType     = 'STRING'
  endif

  -- Setup qualifiers
  !this.qualifierType()

  -- Update Answers
  !this.answers()

endmethod
-- End of method definition for .setup()

------------------------------------------------------------------------
--
-- Method:      setup
--
-- Description:
--   Setup form to passed item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item to set form up to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setup(!selector is DBREF)

  -- Set current selector
  !this.selector = !selector


  -- Setup form
  !this.setup()

endmethod
-- End of method definition for .setup(DBREF)

------------------------------------------------------------------------
--
-- Method:      select
--
-- Description:
--   Grey in/out parent and select buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select()

  -- Initialise Variables
  !this.parent.active = false
  !this.select.active = false

  -- Grey in/out parent button
  if(!this.selector.type ne 'SPEC') then
    !this.parent.active = true
  endif

  -- Grey in/out select button
  if(!this.answers.selection().empty().not()) then
    if(!this.answers.selection().dbRef().type eq 'SELE') then
      !this.select.active = true
    endif
    !this.default.active = true
  else
    !this.default.active = false
  endif

endmethod
-- End of method definition for .select()

------------------------------------------------------------------------
--
-- Method:      selectAnswer
--
-- Description:
--   Select answer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectAnswer()

  -- If there are no selection, then don't do anything
  if(!this.answers.selection().empty()) then

    -- Grey out replace & remove
    !this.replace.active = false
    !this.remove.active  = false

    -- Grey in/out parent and select buttons
    !this.select()
    return
  endif

  -- un-Grey replace & remove
  !this.replace.active = true
  !this.remove.active  = true

  -- Get selected element
  !selection = !this.answers.selection().dbRef()

  -- If item selected is a spco, don't allow it to be selected
  if(!selection.type eq 'SELE') then
    !this.select.active = true
    !this.type.select('RTEXT','SELE')
  else
    !this.type.select('RTEXT','SPCO')
  endif

  -- Determine Answer Type
  -- Text Answer
  if(!selection.tAnswer.set() and !selection.tAnswer.trim().empty().not()) then
    !this.answerType          = 'TEXT'
    !this.answerText.val      = !selection.tAnswer.trim()
    !this.answerVal.val       = REAL()
    !this.answerRangeMin.val  = REAL()
    !this.answerRangeMax.val  = REAL()
    !this.answerType(!this.answerTextType, 'SELECT')

  -- Range Answer
  elseif (!selection.answer ne !selection.maxAnswer) then
    !this.answerType          = 'RANGE'
    !this.answerText.val      = STRING()
    !this.answerVal.val       = REAL()
    !this.answerRangeMin.val  = !selection.answer
    !this.answerRangeMax.val  = !selection.maxAnswer
    !this.answerType(!this.answerRangeType, 'SELECT')

  -- Value Answer
  else
    !this.answerType          = 'VALUE'
    !this.answerText.val      = STRING()
    !this.answerVal.val       = !selection.answer
    !this.answerRangeMin.val  = REAL()
    !this.answerRangeMax.val  = REAL()
    !this.answerType(!this.answerValType, 'SELECT')
  endif


  -- Grey in/out answer input gadgets
  !this.answerType()

  -- Grey in/out parent and select buttons
  !this.select()

endmethod
-- End of method definition for .selectAnswer()

------------------------------------------------------------------------
--
-- Method:      newName
--
-- Description:
--   Check and set new name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .newName()

  -- Remove any leading slashes from the beginning
  !name = !this.name.val.trim('LMR').trim('L','/').replace(' ','_')

  -- Don't do anything if new name and old name are the same
  if(!this.selector.flnn eq !name or !name.empty()) then
    return
  endif

  -- Check if the new name is used already
  !unusedOldName = ID /$!name
  handle any

    -- Use new name
    !this.name.val = !name

    -- If selector is spec, update cdName
    if(!this.selector.type eq 'SPEC') then
      !this.ceName.val = !name
    endif

  elsehandle none

    !!messageFile.error(143, 6, !name)
    !this.name.setFocus()
    return
  endhandle

  -- Update element
  !ref = !!ce
  !!ce = !this.selector

  NAME /$!name
  handle any
  endhandle
  !!ce = !ref

endmethod
-- End of method definition for .newName()

------------------------------------------------------------------------
--
-- Method:      newDescription
--
-- Description:
--   Check and set new description
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .newDescription()

  -- Don't do anything if new name and old name are the same
  if(!this.selector.description eq !this.description.val.trim()) then
    return
  endif

  -- Remove any leading/multiple spaces
  !description = !this.description.val.trim('LMR')

  -- Replace single ' with ''
  !description = !description.replace('''','''''')

  -- Update element
  !ref = !!ce
  !!ce = !this.selector

  DESCRIPTION '$!description'
  handle any
  endhandle
  !!ce = !ref

endmethod
-- End of method definition for .newDescription()

------------------------------------------------------------------------
--
-- Method:      newQuestion
--
-- Description:
--   Check and set new tQuestion
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .newQuestion()

  -- Initialise Variables
  !ref = !!ce
  !!ce = !this.selector

  -- Check question
  !question = !this.question.val.trim('LMR')

  -- Don't do anything
  if(!question.unset() or !question.empty()) then
    return
  endif

  -- What is the question type
  !this.question.val    = !question

  -- Replace single ' with ''
  !question = !question.replace('''','''''')
  TQUESTION '$!question'

  -- If question is unset, then we'll use the first word of the display
  if(!this.questionKey.val.unset() or !this.questionKey.val.empty()) then
    !this.questionKey.val = !this.question.val.part(1)
    !this.newQuestionKey()
  endif

  -- Return to original position
  !!ce = !ref

endmethod
-- End of method definition for .newQuestion()

------------------------------------------------------------------------
--
-- Method:      newQuestionKey
--
-- Description:
--   Check and set new question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .newQuestionKey()

  -- Initialise Variables
  !ref = !!ce
  !!ce = !this.selector
  !key = !this.questionKey.val

  -- Don't do anything
  if(!key.empty()) then
    return
  endif

  -- Set attribute
  QUESTION $!key
  handle any
    -- Error
  elsehandle none
    !this.questionKey.val = !this.selector.question
  endhandle

  -- Return to original position
  !!ce = !ref

endmethod
-- End of method definition for .newQuestionKey()

------------------------------------------------------------------------
--
-- Method:      newQualifier
--
-- Description:
--   Check and set new qualifier
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget selected from
--    2   R      STRING      Selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .newQualifier(!gadget is GADGET, !select is STRING)

  -- Initialise Variables
  !ref = !!ce

  -- Return if gadget is unset
  if(!gadget.val.unset()) then
    return
  endif

  -- Qualifier Types
  -- Text Qualifier
  if(!gadget eq !this.qualAttrib or !gadget eq !this.qualFunc) then


    if(!gadget eq !this.qualAttrib ) then

      --- Check Qualifier
      !qualifier = !gadget.val.trim('LMR')

      -- Don't do anything
      if(!qualifier.empty()) then
        return
      endif

      var !attribute ATTDEF $!qualifier NAME
      handle any
        !!alert.error('Unknown attribute (' & !qualifier & ').')
        !gadget.setFocus()
        return
      endhandle

      -- Test for attribute
      !gadget.val = !attribute[1]
      !qualifier  = !attribute[1]

    -- Function
    elseif (!gadget eq !this.qualFunc) then

       --- Check Qualifier
      !qualifier = !gadget.val.trim('LMR')


      -- Don't do anything
      if(!qualifier.empty()) then
        return
      endif

      -- Check qualifier starts with !!
      if(!qualifier.subString(1,2) ne '!!') then
        !!alert.error('Functions MUST start with "!!".')
        !gadget.setFocus()
        return
      endif

      -- Determine if we are using a function or method
      !functionName = !qualifier.before('(')

      -- If there is no dot, then assume we are looking at a function
      if(!functionName.match('.') eq 0) then

        -- Check if function exist
        !test         = !functionName.after('!!').lowcase()
        !path         = !!pml.getPathName(!test & '.pml')
        handle any
          !path       = !!pml.getPathName(!test & '.pmlfnc')
          handle any
            !!alert.error('Unable to find function (' & !functionName & ').')
            !gadget.setFocus()
            return
          endhandle
        endhandle

        -- Check for argument list
        !arguments = !qualifier.after('(')

        -- If there are no arguments, then add '()'
        if(!arguments.empty()) then
          !arguments = '()'
        endif

        -- Reconstruct the qualifier
        !qualifier  = !functionName & '(' & !arguments

        -- Display revamped qualifier
        !gadget.val = !qualifier

      -- Assume we are looking for a global variable with a method?
      else

        !!alert.error('Unable to use methods of an object as a qualifier.')
        !gadget.setFocus()
        return

      endif

      -- Replace single ' with ''
      !qualifier = !qualifier.replace('''','''''')

    endif

    -- Set Data
    !!ce = !this.selector
    TQUALIFIER '$!qualifier'
    QUALIFIER  0

  -- Value Qualifier
  elseif (!gadget eq !this.qualValue) then

   !!ce = !this.selector
   TQUALIFIER UNSET
   QUALIFIER  $!gadget.val

  endif

  -- Return
  !!ce = !ref

endmethod
-- End of method definition for .newQualifier(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      newDefault
--
-- Description:
--   Check and set new default
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget selected from
--    2   R      STRING      Selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .newDefault(!gadget is GADGET, !select is STRING)

  -- Initialise Variables
  !ref  = !!ce

  -- Return on unset gadget
  if(!gadget.val.unset()) then
    return
  endif

  -- Check if gadget and current answer match
  if(!gadget.dataType ne !this.defaultType) then

    -- Do we want to change it?
    if(!!alert.confirm('Default given, is of a different data type to the current default. OK to change?').boolean().not()) then

      -- Replace with existing default
      if(!this.defaultType eq 'STRING') then
        !this.defaultText.val = !this.selector.tDefault
        !this.defaultVal.val  = REAL()
      else
        !this.defaultText.val = STRING()
        !this.defaultVal.val  = !this.selector.default
      endif

      return
    endif
    !this.defaultType = !gadget.dataType
  endif

  -- Move to item
  !!ce = !this.selector

  -- Replace String
  if(!this.defaultType eq 'STRING') then

    -- Remove any leading/multiple spaces
    !default              = !this.defaultText.val.trim('LMR')
    !this.defaultText.val = !default
    !this.defaultVal.val  = REAL()

    -- Replace single ' with ''
    !default              = !default.replace('''','''''')

    TDEFAULT '$!default'
    DEFAULT 0

  else

    DEFAULT $!this.defaultVal.val
    TDEFAULT UNSET
    !this.defaultText.val = STRING()
  endif

  -- Return to where we came from
  !!ce = !ref

endmethod
-- End of method definition for .newDefault(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      refreshAnswer
--
-- Description:
--   Check and set new answer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshAnswer()

  -- Just build the complete list at the moment
  !this.answers()

endmethod
-- End of method definition for .refreshAnswer()

------------------------------------------------------------------------
--
-- Method:      answerAdd
--
-- Description:
--   Add a new answer to the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .answerAdd()

  -- Initialise Variables
  !ref      = !!ce
  !selector = !this.selector

  -- If there is not selection, then make selector the current "selector"
  if(!this.answers.selection().empty()) then
    !move  = ''
  else
    !move  = !this.answers.selection().dbRef()
  endif

  -- Move to selector
  !!ce = !selector

  -- Create Relevant Type
  if(!this.type.selection() eq 'SELE') then
    NEW SELE AFTER $!move
  else
    NEW SPCO AFTER $!move
    handle any
    endhandle
  endif

  -- Change attributes
  -- Set Text
  if(!this.answerTextType.val) then
    if(!this.answerText.val.unset()) then
      return
    endif
    !answer = !this.answerText.val.replace('''', '''''')
    TANSWER '$!answer'
    ANSWER 0
    MAXANSWER 0

  -- Set Value
  elseif (!this.answerValType.val) then

    if(!this.answerVal.val.unset()) then
      return
    endif
    TANSWER UNSET
    ANSWER $!this.answerVal.val
    MAXANSWER $!this.answerVal.val

  -- Set Range
  elseif (!this.answerRangeType.val) then

    if(!this.answerRangeMin.val.unset() or !this.answerRangeMax.val.unset()) then
      return
    endif
    TANSWER UNSET
    ANSWER $!this.answerRangeMin.val
    MAXANSWER $!this.answerRangeMax.val
  endif

  -- Refresh answers
  !this.refreshAnswer()

  -- Return
  !!ce = !ref

  -- Refresh answers
  !this.refreshAnswer()

endmethod
-- End of method definition for .answerAdd()

------------------------------------------------------------------------
--
-- Method:      answerRemove
--
-- Description:
--   Remove an answer to the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .answerRemove()

  -- Initialise Variables
  !ref      = !!ce
  !selector = !this.answers.selection().dbRef()

  !!ce      = !selector
  !type     = !selector.type
  DELETE $!type

  !!ce = !ref
  handle any
  endhandle

  -- Refresh answers
  !this.refreshAnswer()

  -- Refresh answers
  !this.refreshAnswer()

endmethod
-- End of method definition for .answerRemove()

------------------------------------------------------------------------
--
-- Method:      answerReplace
--
-- Description:
--   Replace the current answer to the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .answerReplace()

  -- Initialise Variables
  !selector = !this.answers.selection().dbRef()
  !ref      = !!ce

  -- Move to selector
  !!ce = !selector

  -- Change attributes
  -- Set Text
  if(!this.answerTextType.val) then
    if(!this.answerText.val.unset()) then
      return
    endif
    !answer = !this.answerText.val.replace('''', '''''')
    TANSWER '$!answer'
    ANSWER 0
    MAXANSWER 0

  -- Set Value
  elseif (!this.answerValType.val) then

    if(!this.answerVal.val.unset()) then
      return
    endif
    TANSWER UNSET
    ANSWER $!this.answerVal.val
    MAXANSWER $!this.answerVal.val

  -- Set Range
  elseif (!this.answerRangeType.val) then

    if(!this.answerRangeMin.val.unset() or !this.answerRangeMax.val.unset()) then
      return
    endif
    TANSWER UNSET
    ANSWER $!this.answerRangeMin.val
    MAXANSWER $!this.answerRangeMax.val
  endif

  -- Refresh answers
  !this.refreshAnswer()

  -- Return
  !!ce = !ref

endmethod
-- End of method definition for .answerReplace()

------------------------------------------------------------------------
--
-- Method:      answers
--
-- Description:
--   Generate list of current answers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .answers()

  -- Initialise Variables
  !dText      = ARRAY()
  !rText      = ARRAY()
  !this.answers.clear()

  -- Get members of current selector
  !answers = !this.selector.members

  -- Loop through each member
  do !i indices !answers

    -- Ignore none spec elements
    skip if(not !answers[!i].type inset('SELE','SPCO'))

    !selector = !answers[!i]

    -- Build Display Data
    !type     = !this.answerType(!selector)

    if(!type eq 'TEXT') then
      !answer  = '"' & !selector.tAnswer & '"'

    elseif (!type eq 'VALUE') then
      !answer  = !selector.answer.string()

    elseif (!type eq 'RANGE') then
      !answer  = !selector.answer & ' to ' & !selector.maxAnswer
    endif

    -- If type of selector is a SPCO, show CATR or TMPL
    if(!selector.type eq 'SPCO') then
      if(!selector.catRef.set()) then
        !description = !selector.catRef.flnn
      elseif (!selector.tmpRef.set()) then
        !description = !selector.tmpRef.flnn
      else
        !description = '>> No Catalogue Reference <<'
      endif

      -- Use description
    else
      if(!selector.description.set()) then
        !description = !selector.description
      else
        !description = 'unset'
      endif
    endif

    var !dprt COMPOSE SPACE 2 '$!answer' WIDTH 16 R SPACE 6 '$!description'
    !dText.append(!dprt[1])

    !rText.append(!selector.string())

  enddo

  -- Build list of items



  -- Load answer with items
  !this.answers.dText = !dText
  !this.answers.rText = !rText

  -- Select answer from new list
  !this.selectAnswer()

endmethod
-- End of method definition for .answers()

------------------------------------------------------------------------
--
-- Method:      answerType
--
-- Description:
--   Returns the "type" of the answer of the passed item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Spec element
-- Return:
--   [Data Type] [Description]
--    STRING      Answer type
--
------------------------------------------------------------------------

define method .answerType(!selector is DBREF) is STRING

  -- Text Answer
  if(!selector.tAnswer.set() and !selector.tAnswer.trim().empty().not()) then
    return 'TEXT'

  -- Range Answer
  elseif (!selector.answer ne !selector.maxAnswer) then
    return 'RANGE'

  -- Value Answer
  else
    return 'VALUE'
  endif

endmethod
-- End of method definition for .answerType(DBREF) STRING

------------------------------------------------------------------------
--
-- Method:      answerType
--
-- Description:
--   Grey in/out answer input gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .answerType()

  -- Grey in/out input gadgets
  !this.answerText.active     = !this.answerTextType.val
  !this.answerVal.active      = !this.answerValType.val
  !this.answerRangeMin.active = !this.answerRangeType.val
  !this.answerRangeMax.active = !this.answerRangeType.val

endmethod
-- End of method definition for .answerType()

------------------------------------------------------------------------
--
-- Method:      answerType
--
-- Description:
--   Select answer type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget selected from
--    2   R      STRING      Selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .answerType(!gadget is GADGET, !select is STRING)

  -- Convert select into boolean
  if(!select eq 'SELECT') then
    !flag = true
  else
    !flag = false
  endif

  -- Select/Unselect
  !this.answerTextType.val  = false
  !this.answerValType.val   = false
  !this.answerRangeType.val = false
  !gadget.val               = !flag

  if(!this.answerTextType.val.not() and !this.answerValType.val.not() and !this.answerRangeType.val.not()) then
    !gadget.val = true
  endif

  -- Grey in/out input gadgets
  !this.answerType()

endmethod
-- End of method definition for .answerType(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      qualifierType
--
-- Description:
--   Grey in/out qualifier input gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .qualifierType()

  -- Grey in/out input gadgets
  !this.qualAttrib.active = !this.qualAttribType.val
  !this.qualFunc.active   = !this.qualFuncType.val
  !this.qualValue.active  = !this.qualValueType.val

endmethod
-- End of method definition for .qualifierType()

------------------------------------------------------------------------
--
-- Method:      qualifierType
--
-- Description:
--   Select qualifier type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget selected from
--    2   R      STRING      Selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .qualifierType(!gadget is GADGET, !select is STRING)

  -- Convert select into boolean
  if(!select eq 'SELECT') then
    !flag = true
  else
    !flag = false
  endif

  -- Select/Unselect
  !this.qualAttribType.val = false
  !this.qualFuncType.val   = false
  !this.qualValueType.val  = false
  !gadget.val              = !flag

  if(!this.qualAttribType.val.not() and !this.qualFuncType.val.not() and !this.qualValueType.val.not()) then
    !gadget.val = true

  -- Action the newQualifier
  else
    if(!this.qualAttribType.val) then
      !this.newQualifier(!this.qualAttrib, 'SELECT')
    elseif (!this.qualFuncType.val) then
      !this.newQualifier(!this.qualFunc, 'SELECT')
    elseif (!this.qualValueType.val) then
      !this.newQualifier(!this.qualValue, 'SELECT')
   endif

  endif

  -- Grey in/out input gadgets
  !this.qualifierType()

endmethod
-- End of method definition for .qualifierType(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      defaultSet
--
-- Description:
--   Make current selection the default
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defaultSet()

  -- Get the relevant "answer"
  -- Text Answer
  if(!this.answerType eq 'TEXT') then
    !this.defaultText.val = !this.answers.selection().dbRef().tAnswer

    !this.newDefault(!this.defaultText, 'SELECT')

  -- Value Answer
  elseif (!this.answerType eq 'VALUE') then
    !this.defaultVal.val  = !this.answers.selection().dbRef().answer
    !this.newDefault(!this.defaultVal, 'SELECT')

  -- Range Answer
  else
    !this.defaultVal.val  = (!this.answers.selection().dbRef().answer + !this.answers.selection().dbRef().maxAnswer) / 2
    !this.newDefault(!this.defaultVal, 'SELECT')
  endif



endmethod
-- End of method definition for .defaultSet()
