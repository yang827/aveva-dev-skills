--
-- File:            spcview.pmlfrm
--   Type:          Form Definition
--   Group:         Specification handling utilities
--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Jun 11 08:49:52 BST 1998
--
--
-- Description:
-- Spec viewing and selection form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  selection()                      -                   Switch between the two types of selection
--  spcView()                        -                   Constructor
--  view(DBREF)                      -
--  view(SPCSPECIFICATION)           -
--
------------------------------------------------------------------------

setup form !!spcView

  !!spcView.formTitle     = 'Specification View'
  !!spcView.iconTitle     = ''
  !!spcView.callback      = ''
  !!spcView.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition

  -- Specification
  option .spec 'Specification ' at xmin ymax width 25

  -- Current Selection List
  list .selection 'Current Selection' at xmin ymax width 40 length 6

  -- Question permissible items
  paragraph .question at xmin ymax width 40

  -- Permissibles list
  list .permissible at xmin ymax width 40 length 6

  -- Options
  frame .optionFrame 'Options' at xmin ymax
    path down
    halign left
    toggle .default    ' Choose default' at x3 ymax states 'FALSE' 'TRUE'

    -- Selection
    frame .selectFrame 'Selection' at x1 ymax
      rgroup .selectType 'Type' at x1 ymax callback '!this.selection()' frame horizontal
        add tag ' on choice' select 'CHOICE'
        add tag ' on demand' select 'DEMAND'
      exit
      toggle .autoSelect ' Choose best selection' at xmin+2 ymax states 'FALSE' 'TRUE'

      button .autoSelectItem 'Select best possible' at xmin+3 ymax+0.2

    exit

  exit

  -- Form members
  -- Linkage
  member .links         is SPCLINK

  -- Specification search criteria
  member .specSearch    is SPCSEARCH

exit
-- End of form definition for !!spcView

------------------------------------------------------------------------
--
-- Method:      spcView
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .spcView()

  -- Specification Type
  !this.specSearch = object SPCSEARCH()
  !this.specSearch.spwlType = 'STL'
  !this.specSearch.type     = 'ASL'
  !this.specSearch.search()

  -- Generate links
  -- Link specification display gadget with the spec search data for re-populate
  !this.links.specification(!this.spec, !this.specSearch)
  -- Link current selected spec item gadget
  !this.links.selection(!this.selection)
  -- Link permissible selection for current selection gadget
  !this.links.permissible(!this.permissible)
  -- Link question gadget
  !this.links.question(!this.question)
  -- Link default gadget
  !this.links.default(!this.default)
  -- Link autoSelect gadget
  !this.links.autoSelect(!this.autoSelect)

  -- Set action on selection
  !this.links.setAction('q var !!spcView.links.choice()')

endmethod
-- End of method definition for .spcView()

------------------------------------------------------------------------
--
-- Method:      view
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   R      SPCSPECIFICATION  Spec data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .view(!specData is SPCSPECIFICATION)

  -- Passed spec object to link object
  !this.links.setup(!specData)

  -- Show form
  show !!spcView

endmethod
-- End of method definition for .view(SPCSPECIFICATION)

------------------------------------------------------------------------
--
-- Method:      view
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   R      DBREF             Design element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .view(!element is DBREF)

  -- Passed spec object to link object
  !this.links.setup(!element)

  -- Show form
  show !!spcView

endmethod
-- End of method definition for .view(DBREF)

------------------------------------------------------------------------
--
-- Method:      selection
--
-- Description:
--   Switch between the two types of selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selection()

  -- Initialise Variables
  if(!this.selectType.selection() eq 'CHOICE') then
    !this.links.autoSelect(!this.autoSelect)
  else
    !this.links.autoSelect(!this.autoSelectItem)
  endif


endmethod
-- End of method definition for .selection()
