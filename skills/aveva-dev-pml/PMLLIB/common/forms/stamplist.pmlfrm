-- Created:         Mon Sept 03 10:48:13 GMT 2001
--
--
-- Description:
-- Form to display information on all stamps in the project.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getDetails()                     ARRAY               Report on the selected stamp
--  init()                           -                   Initialise the form
--
------------------------------------------------------------------------
-- Define form
setup form !!stampList resize

  !this.formTitle = |Stamp List|
  !this.callback = |!this.init()|

  list .stampList at x 0.5 ymax+0.5 anchor left+top+bottom call |!this.report.dtext = !this.getDetails()| width 24 length 17

  list .report at xmax+0.5 ymin anchor all width 50 length 17

  button .dismiss at xmax form-size ymax |Dismiss| anchor right+bottom OK

exit
-- End of form definition for !!stampList

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Method to initialise the data for the Stamp List form
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .init()

  -- Get all stamps
  VAR !allStamp COLL ALL STAMP

  -- Test for no stamps
  if (!allStamp.unset() or !allStamp.empty()) then

    -- Report that there are none
    !dtext[1] = 'None'
    !rtext[1] = 'NONE'
    !this.stampList.dtext = !dtext
    !this.stampList.rtext = !rtext

  else

    -- Get stamp data
    !getName = object BLOCK('!allStamp[!evalIndex].dbref().flnn')
    !allNames = !allStamp.evaluate(!getName)
    !sorted = !allNames.sortedIndices()
    !allNames.sort()
    !allStamp.reIndex(!sorted)

    -- Populate the stamp list
    !this.stampList.dtext = !allNames
    !this.stampList.rtext = !allStamp

    -- Get first report
    !this.report.dtext = !this.getDetails()

  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .getDetails()
--
-- Description: Method to report on the selected stamp
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .getDetails() is ARRAY

  -- Test for no stamps
  if (!this.stampList.selection().eq('NONE')) then
    !report[1] = ''
    return !report
  endif

  -- Initialise
  !stampRef = !this.stampList.selection().dbref()
  !setDate = !stampRef.setDat
  !description  = !stampRef.description
  !function = !stampRef.function
  !sessDate = ''
  !width1 = 0
  !width2 = 0
  !col1 = ARRAY()
  !col2 = ARRAY()
  !col3 = ARRAY()

  -- Test for unset attributes
  if (!setDate.eq('')) then
    !setDate = |-- no date --|
  endif
  if (!description.eq('')) then
    !description = |-- no description --|
  endif
  if (!function.eq('')) then
    !function  = |-- no function --|
  endif

  -- Get report details
  !report[1]   = !description
  !report.append(!function)
  !report.append(| |)
  !report.append(|Date: | & !setDate)
  !report.append(| |)

  !report.append(|Database List:|)
  do !stlst val !stampRef.mem

    if (!stlst.stlsf.badref().not()) then

      -- For no set date, get the session date
      if (!setDate.eq('-- no date --')) then
        !dbObj = object DB(!stlst.stlsf)
        !sessions = !dbObj.sessions()
         handle (43,409)
           -- Cannot open DB
         endhandle
        !getSessNum = object BLOCK('!sessions[!evalIndex].number')
        !sessNums = !sessions.evaluate(!getSessNum)
        !sessDate = |  | & !sessions[!sessNums.findFirst(!stlst.stsess)].date
      endif

    endif

    -- Get widest column
    !text1 = |    | & !stlst.stlsf.flnn.after('*')
    !text2 = !stlst.stsess.string()
    if (!text1.length().gt(!width1)) then
      !width1 = !text1.length()
    endif
    if (!text2.length().gt(!width2)) then
      !width2 = !text2.length()
    endif

    -- Store column data
    !col1.append(|    | & !stlst.stlsf.flnn.after('*'))
    !col2.append(!stlst.stsess.string())
    !col3.append(!sessDate)

  enddo

  -- Compose the report
  do !index ind !col1
    VAR !row COMPOSE |$!col1[$!index]| WIDTH $!width1 L SPACES 2 |$!col2[$!index]| WIDTH $!width2 R |$!col3[$!index]|
    !report.append(!row[1])
  enddo

  return !report

endmethod
-- End of method definition for .report()
