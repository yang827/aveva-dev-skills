--   Group:         Router application
--     Keyword:     RTR
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Wed Mar 4 18:10:24 GMT 1998
--
--
-- Description:
--
-- Cancel button on form to stop a process. By showing this form and
-- checking a status flag via F&M during a process you can stop the
-- code doing anything further. Example;
--
--     show !!stop
--     !!stop.setText('Press Cancel to abort Routing')
--
--     do !x
--
--       ...code...
--
--       if (!!fmsys.interrupt()) then
--         !!alert.warning('Routing aborted')
--         break
--       endif
--     enddo
--
--     hide !!stop
--
-- It is not expected that Cancel means undo anything already done, just
-- stop.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  setText(STRING)                  -
--

setup form !!stop

  !this.formTitle = 'Cancel Process'
  !this.iconTitle     = ''
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition


  para   .stopText  at x1 y1  text |Press Cancel to stop the Process|  width 50 lines 2

  button .stopButton |Cancel| at x22 y3

exit
-- End of form definition for !!stop

-----------------------------------------------------------------------
--
-- Method:      !setText()
--
-- Description:
--
-- Sets the text above the Cancel (stop) button.
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .setText(!text is STRING)

  !this.stopText.val = !text
  refresh !!stop.stopText

endmethod
-- End of method definition for .setText(STRING)
