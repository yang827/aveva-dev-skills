--
-- Description:
-- Generic Storage Area form
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!storageAreas

-- Define form
setup form !!storageAreas

  !!storageAreas.formTitle     = 'Storage Areas'
  !!storageAreas.iconTitle     = 'Stores'
  !!storageAreas.callback      = ''
  !!storageAreas.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  list   .area    |Stores|  at xmin ymax+0.25 call |call !!storageAreasSet(_area.selection().part(1), _area.selection().part(2), _option.selection())| width 50 length 10

  -- Setting Options
  frame .optionFrame |Options| at xmin ymax
    path down
    rgroup .option
      add tag | Select area by type only| select |NOCHECK|
      add tag | Auto select area|         select |CHECK|
      add tag | unset storage area|       select |UNSET|
    exit
  exit

  -- Reload
--  button .Load    |Re-Load| at xmax.area-size ymin.area-0.5 call |call !!storageAreasLoad()|

  -- Dismiss
  button .dismiss |Dismiss| at xmax form-size ymax form+0.25 ok

  -- Reset
  button .reset   |Undo|    at xmin.area+22 ymin call |call !!storageAreasUndo()|

  -- Storage Areas Objects
  member .stores     is ARRAY

  -- Previous storage areas
  member .prevStores is ARRAY

exit
-- End of form definition for !!storageAreas

call !!storageAreasLoad()
