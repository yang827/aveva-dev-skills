--   Group:         General Application

--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Thu Jan 21 17:48:44 "GMT 1999
--
--
-- Description:
--  Displays the $H query
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  buildList()                      -                   Build list of permissibles
--  close()                          -                   Close form down
--  helpIndex(STRING,STRING,ARRAY,ARRAY) BOOLEAN             Get help data for passed command and index
--  selectFromList()                 -                   Select list entry and build part list
--  syntaxHelp()                     -                   Constructor
--
------------------------------------------------------------------------

setup form !!syntaxHelp dialog dock

  !this.formTitle     = 'Syntax Help ($$H)'
  !this.iconTitle     = ''
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition

  -- Command string $h is to be applied to
  text   .command   'Command' anchor left + right + top callback '!this.buildList()'      width 67 is STRING

  -- Select
  button .buildList 'List'    anchor right + top        at xmax+0.5     ymin              callback '!this.buildList()'

  -- List of $H options
  list   .list                anchor all                at xmin.command ymax.command+0.2  callback '!this.selectFromList()' width 80 length 25

  -- Form Members

    -- Unique identifier for file
    member .unique    is STRING

    -- Help index
    member .helpIndex is STRING

exit
-- End of form definition for !!syntaxHelp

------------------------------------------------------------------------
--
-- Method:      syntaxHelp
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .syntaxHelp()

  -- Initialise Variables
  !session         = CURRENT SESSION
  !this.unique     = !session.uniqueId

  !this.helpIndex  = ''
  !this.cancelCall =  '!this.close()'

endmethod
-- End of method definition for .syntaxHelp()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  -- Initialise Variables
  !filename = '%PDMSUSER%/' & !this.unique
  !file     = object FILE(!filename)
  !file.deleteFile()
  handle any
  endhandle

endmethod
-- End of method definition for .close()

------------------------------------------------------------------------
--
-- Method:      buildList
--
-- Description: Build list of permissibles
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .buildList()

  -- Initialise Variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Get List data
  !flag  = !this.helpIndex(!this.command.val, '', !dtext, !rtext)
  if(!flag.not()) then
    !dtext[1] = 'Unknown command (' & !this.command.val & ')'
    !rtext[1] = ''
  endif
  !this.list.dtext = !dtext
  !this.list.rtext = !rtext

  -- Make command the focus again
  !this.command.setFocus()

endmethod
-- End of method definition for .buildList()

-------------------------------------------------------------------------
--
-- Method:      selectFromList
--
-- Description: Select list entry and build part list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectFromList()

  -- Initialise Variables
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Get number of selection
  !index = !this.list.selection()

  --
  if(!index.empty()) then
    return
  endif

  -- Get List data
  !flag  = !this.helpIndex(!this.command.val, !index, !dtext, !rtext)
  if(!flag) then
    !number  = !this.list.val
    !display = !this.list.dtext
    !replace = !this.list.rtext
--     !dtext.append(' ')
--     !rtext.append(' ')

    -- Make replacement entry null so it can not be selected again
    !replace[!number] = ''

    -- Update contents
    !display.insertArray(!number + 1, !dtext)
    !replace.insertArray(!number + 1, !rtext)
    !this.list.dtext = !display
    !this.list.rtext = !replace

    !this.list.val   = !number

  endif

  -- Make command the focus again
  !this.command.setFocus()

endmethod
-- End of method definition for .selectFromList()

-------------------------------------------------------------------------
--
-- Method:      helpIndex
--
-- Description: Get help data for passed command and index
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Command/syntax to get help data for
--    2   R      STRING      Help index
--    3   RW     ARRAY       Display text
--    4   RW     ARRAY       Replacement text (index identifiers)
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Permissible data
--
------------------------------------------------------------------------

define method .helpIndex(!passedCommand is STRING, !index is STRING, !dtext is ARRAY, !rtext is ARRAY) is BOOLEAN

  -- Initialise Variables
  !filename = '%PDMSUSER%/' & !this.unique
  !file     = object FILE(!filename)
  !array[1] = ''
  !file.writeFile('OVERWRITE',!array)
  !fullname = !file.fullname()

  -- Get Command
  if(!passedCommand.unset()) then
    !command = ''
  else
    !command  = !passedCommand
  endif

  -- Open alpha log of unique in PDMSUSER area and list the $h
  ALPHA LOG "$!<fullname>" OVER
  $!<command> $H$!<index>
  handle any
    ALPHA LOG END
    return false
  endhandle
  ALPHA LOG END

  !list  = !file.readfile()

  -- Process the data
  !block = object BLOCK('!list[!evalIndex].part(1)')
  !rtext = !list.evaluate(!block)
  !dtext = !list

  return true

endmethod
-- End of method definition for .helpIndex(STRING, STRING, ARRAY, ARRAY) BOOLEAN
