-- Created:         Feb 2007
--
--
-- Description:
-- Manage System Design Data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addto3dview()                    -                   Adds item from the grid to the 3d view
--  addto3dviewExp()                 -                   Adds item from the explorer to the 3d view
--  closecall()                      -                   close the system design form
--  enhance()                        -                   enhances item from the grid to the 3d view
--  enhanceExp()                     -                   enhances item from the explorer to the 3d view
--  gridSelection()                  ARRAY               returns the selected grid items
--  initialise(BOOLEAN)              -                   constructor
--  navigate()                       -                   navigates to the selected item from the grid
--  navigateExp()                    -                   navigates to the selected item in the explorer
--  remfrom3dview()                  -                   removes item from the grid to the 3d view
--  remfrom3dviewExp()               -                   removes item from the explorer to the 3d view
--  rightClickExplorer(ARRAY)        -                   Sets up the popup for the explorer
--  rightClickGrid(ARRAY)            -                   Sets up the popup for the grid
--  systemDesign()                   -                   constructor
--  unenhance()                      -                   unenhances item from the grid to the 3d view
--  unenhanceExp()                   -                   unenhances item from the explorer to the 3d view
--  updateDesignMemGrid(ARRAY)       -                   updates the grid with design members of the current explorer selection
--  visibleFrame()                   GADGET              Returns the visible frame (not really required as no tabs)
--

import 'GridControl'
handle any
endhandle
import 'ExplorerAddin'
handle any
endhandle

-- Define form
setup form !!systemDesign varchars dialog resize
using namespace 'Aveva.Pdms.Presentation'

   -- Form members
   member .designMemGrid is NETGRIDCONTROL
   member .systemExplorer      is PMLEXPLORERCONTROL

   member .system is DBREF
  path down
--  frame .expFrame |System Explorer| anchor t+l+b  width 30 height 20
--    container .explorerFrame PmlNetControl 'NET' dock fill
    container .explorerFrame nobox PmlNetControl 'NET' anchor t+l+b  width 30 height 20
--  exit
 path right
  -- System and Design Members List
    frame .designMemFrame |System Design Members|  anchor ALL width 50 height 20
      -- PML Container to host .Net control
      container .netDesignMemFrame nobox PmlNetControl |Design Members| dock fill
--      container .netDesignMemFrame nobox PmlNetControl |Design Members| anchor ALL width 50 height 20
    exit

	button .dismissButton 'Dismiss' tooltip 'Dismiss' at xmax form-9 ymax+.25 anchor b+r width 8 cancel

  menu .pmlGridPopup popup
   !this.pmlGridPopup.add( 'CALLBACK', 'Add to 3D View', '!this.addto3dview()' )
   !this.pmlGridPopup.add( 'CALLBACK', 'Remove from 3D View', '!this.remfrom3dview()' )
   !this.pmlGridPopup.add( 'CALLBACK', 'Enhance in 3D View', '!this.enhance()' )
   !this.pmlGridPopup.add( 'CALLBACK', 'Unenhance in 3D View', '!this.unenhance()' )
   !this.pmlGridPopup.add( 'CALLBACK', 'Navigate To', '!this.navigate()' )
   !this.pmlGridPopup.add('separator')
   !this.pmlGridPopup.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.designMemGrid, ||, |Save As|)' )
   !this.pmlGridPopup.add( 'callback', 'Print Preview...', '!this.designMemGrid.printpreview()' )
  menu .pmlExplorerPopup popup
   !this.pmlExplorerPopup.add( 'CALLBACK', 'Add to 3D View', '!this.addto3dviewExp()' )
   !this.pmlExplorerPopup.add( 'CALLBACK', 'Remove from 3D View', '!this.remfrom3dviewExp()' )
   !this.pmlExplorerPopup.add( 'CALLBACK', 'Enhance in 3D View', '!this.enhanceExp()' )
   !this.pmlExplorerPopup.add( 'CALLBACK', 'Unenhance in 3D View', '!this.unenhanceExp()' )
   !this.pmlExplorerPopup.add( 'CALLBACK', 'Navigate To', '!this.navigateExp()' )

exit

-- End of form definition for !!systemDesign

------------------------------------------------------------------------
--
-- Method:      systemDesign
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .systemDesign()

  using namespace 'Aveva.Pdms.Presentation'

  !this.systemExplorer = object PMLEXPLORERCONTROL()
  -- Add .Net controls to PML containers
  !this.explorerFrame.control = !this.systemExplorer.handle()

  !this.systemExplorer.addeventhandler('OnSelectionChanged', !this, 'updateDesignMemGrid')
  !this.systemExplorer.addeventhandler('OnPopup', !this, 'rightClickExplorer')

  -- Add instances of .Net control
  !this.designMemGrid = object NETGRIDCONTROL()

  -- Add .Net controls to PML containers
  !this.netDesignMemFrame.control = !this.designMemGrid.handle()

   -- add PML event handlers to .Net control
   !this.designMemGrid.addeventhandler('OnPopup', !this, 'rightClickGrid')
--   !this.DbCtrl.addeventhandler('BeforeCellUpdate', !this, 'NETBeforeCellUpdateCallback')

  !this.formTitle = 'System Design Members'
  !this.iconTitle = 'SysDemMem'
  !this.initcall  = '!this.initialise(TRUE)'
  !this.quitcall  = '!this.closecall()'

  !this.systemExplorer.initialise('/*','System')

endmethod

-- End of method definition for .systemDesign()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!init is BOOLEAN)

  using namespace  'Aveva.Pdms.Presentation'

  if (!init) then
    var !systemGpwls coll all sygpwl
    var !systemGpwlsNames eval name for all from !systemGpwls
    if (!systemGpwlsNames.size() eq 0) then
      return error 1 'No system hierarchies exist'
    endif
  endif

  -- Set parameters
  !this.designMemGrid.columnExcelFilter(TRUE)
  !this.designMemGrid.outlookGroupStyle(TRUE)
  !this.designMemGrid.fixedHeaders(TRUE)
  !this.designMemGrid.fixedRows(TRUE)
  !this.designMemGrid.columnSummaries(TRUE)

  -- Clear any existing data
  !this.designMemGrid.clearGrid()

    -- Populate design members with standard TOOLTIP text (name and type)

    -- Set headings
  !headings = ARRAY()
  !headings[1] = 'Name'
  !headings[2] = 'Type'
  !headings[3] = 'PrimSyst'
  !designMemNames=ARRAY()

  !name = !this.system.name
  !this.systemExplorer.selectElement(!name)

  !designMem = !this.system.sexpnd
    handle (2,201)
      -- Do nothing
    endhandle
    do !j values !designMem
      !designMemNames.append(!j.name)
    enddo
  !designMemNames.unique()

  !ti = 'Design Members'
  !nds = object NETDATASOURCE(!ti, !headings, !designMemNames)
  !this.designMemGrid.bindToDataSource(!nds)
  !this.designMemGrid.setNameColumnImage()
  handle any
  endhandle
endmethod

-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      updateDesignMemGrid
--
-- Description: Selection of new system updates designMem grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateDesignMemGrid(!data is ARRAY)
  using namespace  'Aveva.Pdms.Presentation'

  !this.designMemGrid.clearGrid()
  !designMemNames = ARRAY()
  !designMem = ARRAY()
  !this.system = !data[0].dbref()
  !designMem = !data[0].dbref().sexpnd
    handle (2,201)
      -- Do nothing
    endhandle
    do !j values !designMem
      !designMemNames.append(!j.name)
    enddo
  !designMemNames.unique()

    -- Populate design members with standard TOOLTIP text (name and type)

    -- Set headings
  !headings = ARRAY()
  !headings[1] = 'Name'
  !headings[2] = 'Type'
  !headings[3] = 'PrimSyst'

  !ti = 'Design Members'
  !nds = object NETDATASOURCE(!ti, !headings, !designMemNames)
  !this.designMemGrid.bindToDataSource(!nds)
  !this.designMemGrid.setNameColumnImage()
  handle any
  endhandle
endmethod

-- End of method definition for .updateDesignMemGrid()

------------------------------------------------------------------------
--
-- Method:      rightClickGrid
--
-- Description: right click popup for grid menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rightClickGrid(!data is ARRAY)

   !this.visibleFrame().popup = !this.pmlGridPopup
   !this.visibleFrame().showPopup(!data[0], !data[1])


endmethod
-- End of method definition for .rightClickGrid()


------------------------------------------------------------------------
--
-- Method:      rightClickExplorer
--
-- Description: right click popup for explorer menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rightClickExplorer(!data is ARRAY)

if (!data[2].dbref().type eq 'SYSGRP') then
 !this.explorerFrame.popup = !this.pmlExplorerPopup
 !this.explorerFrame.showPopup(!data[0], !data[1])
 !this.system = !data[2].dbref()
endif

endmethod
-- End of method definition for .rightClickGrid()

------------------------------------------------------------------------
--
-- Method:      visibleFrame
--
-- Description: Return currently displayed frame tab
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    GADGET      Currently displayed frame
--
------------------------------------------------------------------------

define method .visibleFrame() is GADGET

  -- Get visible grid
  if (!this.netDesignMemFrame.visible) then
    !frame = !this.netDesignMemFrame
  endif
  return !frame

endmethod
-- End of method definition for .visibleFrame() is GADGET

------------------------------------------------------------------------
--
-- Method:      gridSelection
--
-- Description: Return selection for currently displayed grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Selection for currently displayed grid
--
------------------------------------------------------------------------

define method .gridSelection() is ARRAY

  -- Get selection for visible grid
  if (!this.netDesignMemFrame.visible) then
    !gridSelection = !this.designMemGrid.getSelectedRowTags()
  endif
  return !gridSelection

endmethod
-- End of method definition for .gridSelection() is ARRAY

------------------------------------------------------------------------
--
-- Method:      addto3dview
--
-- Description: add selected elements to the drawlist
--
-- Method Type: Action
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addto3dview()

!arrayOfTags=!this.gridSelection()
do !i values !arrayOfTags
  ADD ONLY $!i
enddo

endmethod
-- End of method definition for .addto3dview()

------------------------------------------------------------------------
--
-- Method:      addto3dviewExp
--
-- Description: add selected system to the drawlist
--
-- Method Type: Action
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addto3dviewExp()

ADD $!this.system

endmethod
-- End of method definition for .addto3dview()

------------------------------------------------------------------------
--
-- Method:      remfrom3dview
--
-- Description: remove selected elements to the drawlist
--
-- Method Type: Action
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remfrom3dview()

!arrayOfTags=!this.gridSelection()
do !i values !arrayOfTags
  REM ONLY $!i
enddo

endmethod
-- End of method definition for .remfrom3dview()

------------------------------------------------------------------------
--
-- Method:      remfrom3dviewExp
--
-- Description: remove system from the drawlist
--
-- Method Type: Action
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remfrom3dviewExp()

REM $!this.system

endmethod
-- End of method definition for .remfrom3dview()

------------------------------------------------------------------------
--
-- Method:      enhance
--
-- Description: enhance selected elements in the drawlist
--
-- Method Type: Action
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .enhance()

!arrayOfTags=!this.gridSelection()
do !i values !arrayOfTags
  -- Enhance doesn't work at sysgrp level therefore expand to the design items
  if (!i.dbref().type eq 'SYSGRP') then
    !desMem = !i.dbref().sexpnd
    do !j values !desMem
      enhance $!j
    enddo
  else
    ENHANCE $!i
  endif
enddo

endmethod
-- End of method definition for .enhance()
------------------------------------------------------------------------
--
-- Method:      enhanceExp
--
-- Description: enhance system in the drawlist
--
-- Method Type: Action
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .enhanceExp()

  -- Enhance doesn't work at sysgrp level therefore expand to the design items
  !desMem = !this.system.sexpnd
  do !j values !desMem
    enhance $!j
  enddo

endmethod
-- End of method definition for .enhanceExp()

------------------------------------------------------------------------
--
-- Method:      unenhance
--
-- Description: unenhance selected elements in the drawlist
--
-- Method Type: Action
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unenhance()

!arrayOfTags=!this.gridSelection()
do !i values !arrayOfTags
  -- Unenhance doesn't work at sysgrp level therefore expand to the design items
  if (!i.dbref().type eq 'SYSGRP') then
    !desMem = !i.dbref().sexpnd
    do !j values !desMem
      unenhance $!j
    enddo
  else
    UNENHANCE $!i
  endif
enddo

endmethod
-- End of method definition for .unenhance()
------------------------------------------------------------------------
--
-- Method:      unenhanceExp
--
-- Description: unenhance system in the drawlist
--
-- Method Type: Action
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .unenhanceExp()

  -- Unenhance doesn't work at sysgrp level therefore expand to the design items
  !desMem = !this.system.sexpnd
  do !j values !desMem
    unenhance $!j
  enddo

endmethod
-- End of method definition for .unenhanceExp()
------------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description: navigate to the first item in a multiple selected list
--
-- Method Type: Action
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigate()

	!arrayOfTags=!this.gridSelection()
	
	if (!arrayOfTags.set()) then
		!!ce=!arrayOfTags[1].dbref()
	endif

endmethod

-- End of method definition for .navigate()
------------------------------------------------------------------------
--
-- Method:      navigateExp
--
-- Description: navigate to the system
--
-- Method Type: Action
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .navigateExp()

!!ce=!this.system

endmethod
-- End of method definition for .navigateExp()

------------------------------------------------------------------------
--
-- Method:      closecall
--
-- Description: close the system design form
--
-- Method Type: Action
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .closecall()

    !!appDesMain.explorersMenu.setFieldProperty('System Explorer','selected',false)

endmethod
-- End of method definition for .navigateExp()
