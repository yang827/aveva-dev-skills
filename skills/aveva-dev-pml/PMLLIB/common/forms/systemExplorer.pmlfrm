--
--
-- Description:
-- Explorer for the system hierarchy
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  initialise(BOOLEAN)              -                   Initialise form
--  okcall()                         -                   Action sets the current selected system on the design item
--  selectElement(STRING)            -                   update the explorer with supplied name
--  systemExplorer()                 -                   Constructor
--  updateSystemData(ARRAY)          -
--
import 'ExplorerAddin'
handle any
endhandle

-- Define form
setup form !!systemExplorer resize
using namespace 'Aveva.Pdms.Presentation'

   -- Form members
   member .systemExplorer      is PMLEXPLORERCONTROL
   member .system is DBREF

  path down
    container .explorerFrame PmlNetControl 'NET' anchor all  width 50 height 20
  button .ok      ' OK '  anchor l+b  at xmin form-0    ymax+0.25 ok
  button .cancel  'Cancel' anchor r+b at xmax form-size ymin      cancel
exit

-- End of form definition for !!systemHierarchy

------------------------------------------------------------------------
--
-- Method:      systemExplorer
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .systemExplorer()

  using namespace 'Aveva.Pdms.Presentation'

  !this.systemExplorer = object PMLEXPLORERCONTROL()
  -- Add .Net controls to PML containers
  !this.explorerFrame.control = !this.systemExplorer.handle()
  !this.systemExplorer.addeventhandler('OnSelectionChanged', !this, 'updateSystemData')

  !this.formTitle = 'System Explorer'
  !this.iconTitle = 'SysExp'
  !this.initcall  = '!this.initialise(TRUE)'
  !this.ok.callback = '!this.okcall()'
  !this.systemExplorer.initialise('/*','System')


endmethod

-- End of method definition for .systemHierarchy()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!init is BOOLEAN)

  using namespace  'Aveva.Pdms.Presentation'

  if (!init) then
    var !systemGpwls coll all sygpwl
    var !systemGpwlsNames eval name for all from !systemGpwls
    if (!systemGpwlsNames.size() eq 0) then
      return error 1 'There is no system hierarchy present in the current MDB'
    endif
  endif

  !name = !this.system.name
  !this.selectElement(!name)

  if (!this.system.type neq 'SYSGRP') then
    !this.ok.active = FALSE
  else
    !this.ok.active = TRUE
  endif

endmethod

-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      okcall
--
-- Description: Set the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .okcall()

   -- Go back to the design item
   !!ce=!!modifySystem.designItem
   !mdsysf = mdsysf
   !insyst = insyst

   -- Check that is not already part of this system
   if (!mdsysf.findFirst(!this.system).set()) then
     !!alert.error(' The current item is already assigned to this system')
     return
   endif

   -- Check that is not already part of this system by virtue of it's owner
   if (!insyst.findFirst(!this.system).set()) then
     !!alert.error(' The current item is already part of this system by virtue of its owner ')
     return
   endif


   if (!mdsysf.size() eq 0 ) then
     MDSYSF $!this.system
   else
     !mdsysf = !!modifySystem.mdsysf.rtext
     !selected = !!modifySystem.mdsysf.val
     !selected = !selected + 1
     !mdsysf.insert(!selected,!this.system.name)
       -- Unset the MDSYSF
     MDSYSF Unset
     do !i index !mdsysf
       MDSYSF NUM $!i $!mdsysf[$!i]
     enddo
   endif
   !!modifySystem.modified = TRUE
   !!modifySystem.apply 		= false
   !!modifySystem.initialise(FALSE)


endmethod

-- End of method definition for .okcall()


------------------------------------------------------------------------
--
-- Method:      updateSystemData
--
-- Description: Selection of new system update data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Reference of element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateSystemData(!data is ARRAY)

  !this.system = !data[0].dbref()
  if (!this.system.type neq 'SYSGRP' ) then
    !this.ok.active = false
  else
    !this.ok.active = true
  endif

endmethod

-- End of method definition for .updateSystemData()


------------------------------------------------------------------------
--
-- Method:      selectElement
--
-- Description: update the explorer with supplied name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectElement(!element is STRING)

  !this.systemExplorer.selectElement(!element)

endmethod

-- End of method definition for .updateSystemData()
