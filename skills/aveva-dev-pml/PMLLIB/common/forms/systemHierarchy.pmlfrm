--
--
-- Description:
-- Manage System Design Data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cellUpdateCallback(ARRAY)        -                   Modifies attributes based on grid input
--  deleteHier()                     -                   Deletes the selected item from the system hierarchy
--  gridSelection()                  ARRAY               Returns the selected data
--  initialise(BOOLEAN)              -                   Initialises form
--  rightClick(ARRAY)                -                   Sets up right click popups
--  rightClickGrid(ARRAY)            -                   right click popup for grid menu
--  systemHierarchy()                -                   Constructor
--  trackNewElement(DBREF)           -                   Check whether user has access to change data
--  updateSystemMemGrid(ARRAY)       -                   Selection of new system updates systemMem grid control
--  userAccess()                     BOOLEAN             Returns the access of the current user
--  visibleFrame()                   GADGET              Returns the visible frame (not really required as no tabs)
--

import 'GridControl'
handle any
endhandle
import 'ExplorerAddin'
handle any
endhandle

-- Define form
setup form !!systemHierarchy varchars dialog resize
using namespace 'Aveva.Pdms.Presentation'

   -- Form members
   member .systemMemGrid  is NETGRIDCONTROL
   member .systemExplorer is PMLEXPLORERCONTROL
   member .user           is BOOLEAN

  path down
  frame .hierarchyFrame 'System Hierarchy' anchor t+l+b
    toggle    .trackCE tagwid 20 'Track New Elements' at xmin+1 ymax+.25 anchor t+l
    container .explorerFrame nobox PmlNetControl 'NET' anchor t+l+b  width 30 height 19
  exit

  path right

    -- System  Members List
    frame .designMemFrame 'System Hierarchy Members'  anchor ALL at xmax.hierarchyFrame+.5 ymin.hierarchyFrame width 50 height 21.75
      -- PML Container to host .Net control
      container .netSystemMemFrame nobox PmlNetControl 'System Members' dock fill
    exit

  button .dismissButton 'Dismiss'  at xmax form-9 ymax+.25 anchor b+r width 8 cancel

menu .pmlPopupWorl
  !this.pmlPopupWorl.add( 'CALLBACK', 'Create System Group World', 'show !!createSygpwl' )
menu .pmlPopupSygpwl
  !this.pmlPopupSygpwl.add( 'CALLBACK', 'Create System Group Area', 'show !!createSygpar' )
  !this.pmlPopupSygpwl.add( 'CALLBACK', 'Delete System Group Area', '!this.deleteHier()' )
menu .pmlPopupSygpar
  !this.pmlPopupSygpar.add( 'CALLBACK', 'Create System', 'show !!createSysgrp' )
  !this.pmlPopupSygpar.add( 'CALLBACK', 'Delete System', '!this.deleteHier()' )
menu .pmlPopupSysgrp
  !this.pmlPopupSysgrp.add( 'CALLBACK', 'Create System', 'show !!createSysgrp' )
  !this.pmlPopupSysgrp.add( 'CALLBACK', 'Create System Model Data', 'show !!createSysmda' , 'mda' )
  !this.pmlPopupSysgrp.add( 'CALLBACK', 'Create System Schematic Data', 'show !!createSyscda' , 'cda' )
  !this.pmlPopupSysgrp.add( 'CALLBACK', 'Delete System Group', '!this.deleteHier()' )
menu .pmlPopupSysmda
  !this.pmlPopupSysmda.add( 'CALLBACK', 'Delete System Model Data', '!this.deleteHier()' )
menu .pmlPopupSyscda
  !this.pmlPopupSyscda.add( 'CALLBACK', 'Delete System Schematic Data', '!this.deleteHier()' )

menu .pmlGridPopup popup
 !this.pmlGridPopup.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.systemMemGrid, ||, |Save As|)' )
 !this.pmlGridPopup.add( 'callback', 'Print Preview...', '!this.systemMemGrid.printpreview()' )

exit

-- End of form definition for !!systemHierarchy

------------------------------------------------------------------------
--
-- Method:      systemHierarchy
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .systemHierarchy()

  using namespace 'Aveva.Pdms.Presentation'

  !this.systemExplorer = object PMLEXPLORERCONTROL()
  -- Add .Net controls to PML containers
  !this.explorerFrame.control = !this.systemExplorer.handle()
  !this.systemExplorer.addeventhandler('OnSelectionChanged', !this, 'updateSystemMemGrid')
  !this.systemExplorer.addeventhandler('OnPopup', !this, 'rightClick')
  -- Add instances of .Net control
  !this.systemMemGrid = object NETGRIDCONTROL()

  -- Add .Net controls to PML containers
  !this.netSystemMemFrame.control = !this.systemMemGrid.handle()

   -- add PML event handlers to .Net control
   !this.systemMemGrid.addeventhandler('BeforeCellUpdate', !this, 'cellUpdateCallback')
   !this.systemMemGrid.addeventhandler('OnPopup', !this, 'rightClickGrid')

  -- Tooltips
  !this.dismissButton.setTooltip('Dismiss')

  !this.formTitle = 'System Hierarchy'
  !this.iconTitle = 'SysHier'
  !this.initcall  = '!this.initialise(TRUE)'
  !this.systemExplorer.initialise('Design','/*','System')
  !this.user = !this.userAccess()
endmethod

-- End of method definition for .systemHierarchy()


------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise(!init is BOOLEAN)

  using namespace  'Aveva.Pdms.Presentation'

  -- Set parameters
  !this.systemMemGrid.columnExcelFilter(TRUE)
  !this.systemMemGrid.outlookGroupStyle(TRUE)
  !this.systemMemGrid.fixedHeaders(TRUE)
  !this.systemMemGrid.fixedRows(TRUE)
  !this.systemMemGrid.columnSummaries(TRUE)

  -- Clear any existing data
  !this.systemMemGrid.clearGrid()

    -- Populate system members with standard TOOLTIP text (name and type)


    -- Set headings
  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('Type')
  !headings.append('Desc')
  !headings.append('Func')
  !purp = false
  !sysType = !!ce.type
  if (!sysType eq 'WORL' or !sysType eq 'SYGPWL' ) then
    !purp = true
    !headings.append('Purp')
  elseif (!sysType eq 'SYSGRP') then
    var !sysCda mem sysCda count
    !sysCdaReal = !sysCda.real()
    if (!sysCdaReal ge 1 ) then
      !headings.append('Tspe')
      !headings.append('Pspe')
      !headings.append('Ispe')
      !headings.append('Flur')
      !headings.append('Ptsp')
    endif
  endif

  !systemMemNames=ARRAY()
  !systemMem=!!ce.mem
  do !i values !systemMem
    skip if (!i.type.substring(1,2) neq 'SY')
    !systemMemNames.append(!i.name)
  enddo
  !systemMemNames.unique()
  !ti = 'System Members'
  !nds = object NETDATASOURCE(!ti, !headings, !systemMemNames)
  !this.systemMemGrid.bindToDataSource(!nds)
  !this.systemMemGrid.setNameColumnImage()
  handle any
  endhandle

  -- make the system grid single selection
  !this.systemMemGrid.singleRowSelection(TRUE)
  -- make the grid editable if enough access
  if (!this.userAccess()) then
    !this.systemMemGrid.editableGrid(TRUE)
    -- make the name and type not editable
    !this.systemMemGrid.setEditableColumn(1,FALSE)
    !this.systemMemGrid.setEditableColumn(2,FALSE)
    -- set the purp to only allow 4 uppercase characters
    if (!purp) then
      !this.systemMemGrid.setColumnMask(5,'>AAAA')
    endif
  else
    !this.systemMemGrid.editableGrid(FALSE)
  endif
  if (!init) then
    !this.trackCE.val = FALSE
  endif
endmethod

-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      rightClickGrid
--
-- Description: right click popup for grid menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rightClickGrid(!data is ARRAY)

   !this.netSystemMemFrame.popup = !this.pmlGridPopup
   !this.netSystemMemFrame.showPopup(!data[0], !data[1])


endmethod
-- End of method definition for .rightClickGrid()

------------------------------------------------------------------------
--
-- Method:      updateSystemMemGrid
--
-- Description: Selection of new system updates systemMem grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Reference of element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateSystemMemGrid(!data is ARRAY)
  using namespace  'Aveva.Pdms.Presentation'

  !!ce=!data[0].dbref()
  !this.initialise(FALSE)

endmethod

-- End of method definition for .updateSystemMemGrid()

------------------------------------------------------------------------
--
-- Method:      rightClick
--
-- Description: Selection of new system updates designMem grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rightClick(!data is ARRAY)

if (!this.user) then
	!!ce=!data[2].dbref()
	!element=!!ce.type
	if (!!dbRefUpdatable(!!ce).not()) then
	  return
	endif
  if (!element.dbref().type eq 'WORL') then
    !this.explorerFrame.popup = !this.pmlPopupWorl
    !this.explorerFrame.showPopup(!data[0], !data[1])
  elseif (!element.dbref().type eq 'SYGPWL') then
    !this.explorerFrame.popup = !this.pmlPopupSygpwl
    !this.explorerFrame.showPopup(!data[0], !data[1])
  elseif (!element.dbref().type eq 'SYGPAR') then
    !this.explorerFrame.popup = !this.pmlPopupSygpar
    !this.explorerFrame.showPopup(!data[0], !data[1])
  elseif (!element.dbref().type eq 'SYSGRP') then
  	var !noMda mem sysmda count
  	!noMdaReal = !noMda.real()
  	if (!noMdaReal ge 1 ) then
  	  !this.pmlPopupSysgrp.setFieldProperty('mda','VISIBLE',FALSE)
  	else
  	  !this.pmlPopupSysgrp.setFieldProperty('mda','VISIBLE',TRUE)
  	endif
  	var !noCda mem syscda count
  	!noCdaReal = !noCda.real()
  	if (!noCdaReal ge 1 ) then
  	  !this.pmlPopupSysgrp.setFieldProperty('cda','VISIBLE',FALSE)
  	else
  	  !this.pmlPopupSysgrp.setFieldProperty('cda','VISIBLE',TRUE)
  	endif
    !this.explorerFrame.popup = !this.pmlPopupSysgrp
    !this.explorerFrame.showPopup(!data[0], !data[1])
  elseif (!element.dbref().type eq 'SYSMDA') then
    !this.explorerFrame.popup = !this.pmlPopupSysmda
    !this.explorerFrame.showPopup(!data[0], !data[1])
  elseif (!element.dbref().type eq 'SYSCDA') then
    !this.explorerFrame.popup = !this.pmlPopupSyscda
    !this.explorerFrame.showPopup(!data[0], !data[1])
  endif
endif

endmethod
-- End of method definition for .rightClick()

------------------------------------------------------------------------
--
-- Method:      visibleFrame
--
-- Description: Return currently displayed frame tab
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    GADGET      Currently displayed frame
--
------------------------------------------------------------------------

define method .visibleFrame() is GADGET

  -- Get visible grid
  if (!this.netSystemMemFrame.visible) then
    !frame = !this.netSystemMemFrame
  endif
  return !frame

endmethod
-- End of method definition for .visibleFrame() is GADGET

------------------------------------------------------------------------
--
-- Method:      gridSelection
--
-- Description: Return selection for currently displayed grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Selection for currently displayed grid
--
------------------------------------------------------------------------

define method .gridSelection() is ARRAY

  -- Get selection for visible grid
  if (!this.netSystemMemFrame.visible) then
    !gridSelection = !this.systemMemGrid.getSelectedRowTags()
  endif
  return !gridSelection

endmethod
-- End of method definition for .gridSelection() is ARRAY

------------------------------------------------------------------------
--
-- Method:      cellUpdateCallback
--
-- Description: Modification of data through the grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Return grid modified data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cellUpdateCallback(!data is ARRAY)

 !element         = !data[1]
 !dbref           = !element.dbref()
 if ( !data[2].upcase() eq 'NAME' ) then
   !name=!!checkName(!data[0],'NEW')
   if (!name.unset()) then
     !data[3] = FALSE
   else
     !dbref.name = !name
     !data[3] = TRUE
   endif
 else
   !dbref.$!data[2] = !data[0]
   handle(2,794) $* dbref
     !name=!!checkName(!data[0],'OLD')
     if (!name.unset()) then
       !data[3] = FALSE
     else
       -- Check it's of the correct type
       if (!data[2] inset('TSPE','PSPE','ISPE')) then
         if (!name.dbref().type neq 'SPEC') then
         	 !!alert.error('Item is not a spec')
           !data[3] = FALSE
         else
           !dbref.$!data[2] = !name.dbref()
           !data[3] = TRUE
         endif
       elseif (!data[2] eq 'FLUR') then
         if (!name.dbref().type neq 'FLUI') then
         	 !!alert.error('Item is not a Fluid')
         	 !data[3] = FALSE
         else
           !dbref.$!data[2] = !name.dbref()
           !data[3] = TRUE
         endif
       endif
     endif
   elsehandle any
   	 !!alert.error(!!error.text)
     !data[3] = FALSE
   elsehandle none
     !data[3] = TRUE
   endhandle
 endif
endmethod
-- End of method definition for .cellUpdateCallback()

------------------------------------------------------------------------
--
-- Method:      userAccess
--
-- Description: Check whether user has access to change data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R                 Has user access to modify data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .userAccess() is BOOLEAN

-- Only allow access to creation and modification for free users
var !u user
!user = object USER(!u)
if (!user.access.upcase() eq 'FREE') then
  return TRUE
else
  !teams = !user.teamList()
  do !team values !teams
    if (!team.name eq 'DESADMIN') then
      return TRUE
    endif
  enddo
  return FALSE
endif

endmethod

-- End of method definition for .userAccess()

------------------------------------------------------------------------
--
-- Method:      trackNewElement
--
-- Description: Check whether user has access to change data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R                 dbref of newly created element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .trackNewElement(!ele is DBREF)

	!this.systemExplorer.setFollowCE(true)
  !!ce = !ele
  !this.systemExplorer.selectElement(!!ce.name)
	!this.systemExplorer.setFollowCE(false)

endmethod

-- End of method definition for .trackNewElement()


------------------------------------------------------------------------
--
-- Method:      deleteHier
--
-- Description: delete the ce
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteHier()

!ce = !!ce
-- find out if the hierarchy contains any design members
!desMem = FALSE
if (!!ce.type eq 'SYGPWL') then
  if ( !!ce.mem.size() eq 0 ) then
    !desMem = FALSE
  else
    !sygpar=!!ce.members
    do !i values !sygpar
      !!ce=!i
      skip if ( !!ce.mem.size() eq 0 )
      !sysgrp=!!ce.members
      do !j values !sysgrp
        !!ce=!j
        if ( !!ce.sexpnd.size() neq 0 ) then
          !desMem = TRUE
          break
        endif
      enddo
    enddo
  endif
elseif (!!ce.type eq 'SYGPAR') then
  if ( !!ce.mem.size() eq 0 ) then
    !desMem = FALSE
  else
    !sysgrp=!!ce.members
    do !j values !sysgrp
      !!ce=!j
      if ( !!ce.sexpnd.size() neq 0 ) then
        !desMem = TRUE
        break
      endif
    enddo
  endif
elseif (!!ce.type eq 'SYSGRP') then
  if ( !!ce.sexpnd.size() neq 0 ) then
    !desMem = TRUE
  endif
endif

-- Go back to the selected item
!!ce=!ce
if (!desMem) then
  !text = 'The ' & !!ce.type & ' ' & !!ce.name & ' contains design members and can not be deleted.'
  !!alert.error(!text)
else
	!answer = !!alert.confirm('Are you sure you want to delete ' & !!ce.type & '?')
  if (!answer eq 'YES') then
  	DELETE $!!ce.type
  	!this.initialise(FALSE)
  endif
endif


endmethod
-- End of method definition for .deleteHier()
