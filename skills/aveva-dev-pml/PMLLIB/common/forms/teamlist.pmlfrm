-- Define form
setup form !!teamList resize

  !!teamList.formTitle     = |Team List|
  !!teamList.iconTitle     = |TEAM LIST|
  !!teamList.callback      = |call !!teamListInit()|
  !!teamList.formRevision  = | $Revision: 1.5 $ |

  -- Body of form definition
  para .tDesc at x1  y 0.4 width 43 lines 1
  list .teams 'Teams' at x 0 ymax anchor left+top+bottom call |call !!teamListSelect(!!teamList.teams)| width 12 length 19

  path right
  valign bottom
  list .dbs    |DBs| anchor all width 43 length 8
  button .dismiss at xmax form-size ymax |Dismiss| anchor right+bottom OK

  list .users at xmin.dbs ymin.teams |Users| anchor left+right+top width 43 length 8


exit
-- End of form definition for !!teamList
