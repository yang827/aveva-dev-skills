--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Dec 12 15:12:55 WAT 1997
--
--
-- Description:
-- Test form for OROLINK object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close and Tidy the form
--  initialise()                     -
--  setWrt()                         -                   Set the orientation to a new wrt
--  tag()                            -                   Tag orientation
--  testOriLink()                    -                   Constructor
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!testOriLink

-- Define form
setup form !!testOriLink

  !!testOriLink.formTitle     = '3D Orientation'
  !!testOriLink.iconTitle     = 'Or3D'
  !!testOriLink.callback      = '!!testOriLink.initialise()'
  !!testOriLink.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition

  button .init 'Initialise' call '!!testOriLink.initialise()'

  frame .oriFrame 'Orientation' at xmin ymax
    path down
    text   .yDir 'Y is ' at x2         y1        width 14 is STRING
    text   .zDir 'Z is ' at                      width 14 is STRING
    halign right
    paragraph .xDir width 21 lines 1
  exit

   -- Wrt for all positions
  text .wrt 'wrt' at xmin+2 ymax+0.2 callback '!!testOriLink.setWrt()' width 20 string

  -- Dismiss
  button .dismiss 'Dismiss' at xmax form-size ymax callback '!!testOriLink.close()' ok

  -- Form Members
  -- Orientation
  member .orientation is ORILINK

  -- Position (reference for axes)
  member .position    is POSITION

  -- Has form been shown before
  member .shownBefore is BOOLEAN
  !!testOriLink.shownBefore = false

exit
-- End of form definition for !!testOriLink

------------------------------------------------------------------------
--
-- Method:      testOriLink
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .testOriLink()

  -- Link Input Gadgets and third direction gadget (paragraph) to Objects
  !this.orientation.linkInput('!!testOriLink.orientation','Y',!this.yDir,'Z',!this.zDir,'X',!this.xDir)

  -- Set tagging method up
  !this.orientation.setAction('!!testOriLink.tag()')

  -- Set shown before flag
  !this.shownBefore = true

endmethod
-- End of method definition for .testOriLink()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  -- Form has not been shown before, then link run constructor
  if(!this.shownBefore.not()) then
    !this.testOriLink()
  endif

  --Reference Position
  !this.position = !!ce.position

  -- Set with respect to
  !this.setWrt(World)

  -- Load with position
  !this.orientation.setOrientation(!!ce.orientation,true)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description:
--   Set the orientation to a new wrt
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current elements origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.orientation.get().origin
    !!messageFile.warning(151, 005, !this.wrt.val, !wrtItem.name)
  endif

  -- Set tagging method up
  !this.orientation.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()


------------------------------------------------------------------------
--
-- Method:      tag
--
-- Description:
--   Tag orientation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tag()

  -- Draw Aid arrows
  AID CLEAR ARROW 100
  handle any
  endhandle
  !xDirection = !this.orientation.orientation.xDir()
  !yDirection = !this.orientation.orientation.yDir()
  !zDirection = !this.orientation.orientation.zDir()
  AID ARROW NUMBER 100 AT $!this.position DIRECTION $!xDirection height 200
  AID ARROW NUMBER 100 AT $!this.position DIRECTION $!yDirection height 300
  AID ARROW NUMBER 100 AT $!this.position DIRECTION $!zDirection height 100


endmethod
-- End of method definition for .tag()


------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   Close and Tidy the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Set shown before flag
  !this.shownBefore = true

endmethod
-- End of method definition for .close()
