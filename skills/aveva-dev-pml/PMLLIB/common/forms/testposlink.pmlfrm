-- File:            testposlink.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Oct 31 12:18:12 WAT 1997
--
--
-- Description:
-- Test form for standard 3D positioning link object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   close form down
--  initialise()                     -                   Initialisation for the form
--  setTag()                         -                   tag position as points
--  setWrt()                         -                   Set with respect to
--  tagBox()                         -                   tag position as a box
--  tagPoints()                      -                   tag position
--  testPosLink()                    -                   Constructor
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!testPosLink

-- Define form
setup form !!testPosLink

  !!testPosLink.formTitle     = '3D Positioning'
  !!testPosLink.iconTitle     = 'Pos3D'
  !!testPosLink.callback      = '!!testPosLink.initialise()'
  !!testPosLink.formRevision  = ' $Revision: 1.11 $ '

  -- Body of form definition

  button .init 'Initialise' call '!!testPosLink.initialise()'

  -- Tag Type Points or Box Volume
  frame .tagFrame 'Tag Type'
    rgroup .tagMethod at x1 ymax callback '!!testPosLink.setTag()' vertical
      add tag 'Points' select '!!testPosLink.tagPoints()'
      add tag 'Box'    select '!!testPosLink.tagBox()'
    exit
  exit

  -- Positioning Gadgets
  frame .posFrameA 'Position A' at xmin.init ymax

    button .usePosA 'CE Position' at x1 ymax callback '!!testPosLink.posA.setPosition(!!ce.position,false)'
    path down
    option .posAEW width 5
    option .posANS width 5
    option .posAUD width 5
--     text   .posAX     at xmax+1 ymin.posAEW width 14 is REAL format !!distanceFmt
--     text   .posAY     at xmin   ymin.posANS width 14 is REAL format !!distanceFmt
--     text   .posAZ     at xmin   ymin.posAUD width 14 is REAL format !!distanceFmt
    text   .posAX     at xmax+1 ymin.posAEW width 14 is REAL
    text   .posAY     at xmin   ymin.posANS width 14 is REAL
    text   .posAZ     at xmin   ymin.posAUD width 14 is REAL
    toggle .posAXflag at xmax+1 ymin.posAEW
    toggle .posAYflag at xmin   ymin.posANS
    toggle .posAZflag at xmin   ymin.posAUD

  exit

  frame .posFrameB 'Position B'

    button .posACopy 'Copy Position A' at x1 ymax call '!!testPosLink.posB.setPosition(!!testPosLink.posA.get(),false)'
    path down
    option .posBEW width 5
    option .posBNS width 5
    option .posBUD width 5
--     text   .posBX     at xmax+1 ymin.posBEW width 14 is REAL format !!distanceFmt
--     text   .posBY     at xmin   ymin.posBNS width 14 is REAL format !!distanceFmt
--     text   .posBZ     at xmin   ymin.posBUD width 14 is REAL format !!distanceFmt
    text   .posBX     at xmax+1 ymin.posBEW width 14 is REAL
    text   .posBY     at xmin   ymin.posBNS width 14 is REAL
    text   .posBZ     at xmin   ymin.posBUD width 14 is REAL
    toggle .posBXflag at xmax+1 ymin.posBEW
    toggle .posBYflag at xmin   ymin.posBNS
    toggle .posBZflag at xmin   ymin.posBUD

  exit

  -- Paragraph Gadgets
  frame .posFrameC 'Paragraphs'
    path down
    option    .posCEW width 5
    paragraph .posCX     at xmax+1 ymin.posCEW width 14 lines 1
    paragraph .posCY                           width 14 lines 1
    paragraph .posCZ                           width 14 lines 1
    toggle    .posCXflag at xmax+1 ymin.posCX
    toggle    .posCYflag at xmin   ymin.posCY
    toggle    .posCZflag at xmin   ymin.posCZ
  exit

  -- Wrt for all positions
  text .wrt 'wrt' at xmin+2 ymax+0.2 callback '!!testPosLink.setWrt()' width 20 string

  -- Dismiss
  button .dismiss 'Dismiss' at xmax form-size ymax callback '!!testPosLink.close()' ok

  -- Form Members
  member .posA        is POSLINK
  member .posB        is POSLINK
  member .posC        is POSLINK

  member .shownBefore is BOOLEAN
  !!testPosLink.shownBefore = false

exit
-- End of form definition for !!testPosLink

------------------------------------------------------------------------
--
-- Method:      testPosLink
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .testPosLink()

  -- Link Input Gadgets to Objects
  !this.posA.linkInput('!!testPosLink.posA',!this.posAX, !this.posAY, !this.posAZ)
  !this.posB.linkInput('!!testPosLink.posB',!this.posBX, !this.posBY, !this.posBZ)
  !this.posC.linkInput('!!testPosLink.posC',!this.posCX, !this.posCY, !this.posCZ)

  -- Link Lock Gadgets to Objects
  !this.posA.linkLock('!!testPosLink.posA',!this.posAXflag, !this.posAYflag, !this.posAZflag)
  !this.posB.linkLock('!!testPosLink.posB',!this.posBXflag, !this.posBYflag, !this.posBZflag)
  !this.posC.linkLock('!!testPosLink.posC',!this.posCXflag, !this.posCYflag, !this.posCZflag)

  -- Link Option Gadgets to Objects
  !this.posA.linkOption('!!testPosLink.posA',!this.posAEW, !this.posANS,  !this.posAUD,  'ENU')
  !this.posB.linkOption('!!testPosLink.posB',!this.posBEW, !this.posBNS,  !this.posBUD,  'XYZ')
  !this.posC.linkOption('!!testPosLink.posC',!this.posCEW, object GADGET(), object GADGET(), 'ENU')

  -- Set tagging method up
  !this.setTag()

endmethod
-- End of method definition for .testPosLink()


------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description:
--   Initialisation for the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .initialise()

  -- Form has not been shown before, then link run constructor
  if(!this.shownBefore.not()) then
    !this.testPosLink()
    !this.shownBefore = true
  endif

  -- Unlock all gadgets
  !this.posA.unlockAll()

  -- Set with respect to
  !this.posA.setWrt(World)

  -- Set form wrt gadget
  !this.setWrt()

  -- Load with position
  !this.posA.setPosition(!!ce.position,true)
  !this.posB.setPosition(object POSITION('N0'),true)
  !this.posC.setPosition(!!ce.position,true)

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      setWrt
--
-- Description:
--   Set with respect to
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setWrt()

  -- re-defined reference
  !wrtItem = !this.wrt.val.dbRef()
  handle any
    !wrtItem = object DBREF()
  endhandle

  -- use current posA origin if it null
  if(!wrtItem.unset()) then
    !wrtItem = !this.posA.get().origin
    !!messageFile.warning(151, 005, !this.wrt.val, !wrtItem.name)
  endif

  -- Set tagging method up
  !this.posA.setWrt(!wrtItem)
  !this.posB.setWrt(!wrtItem)
  !this.posC.setWrt(!wrtItem)

  -- Set gadget with name of item
  !this.wrt.val = !wrtItem.name

endmethod
-- End of method definition for .setWrt()

------------------------------------------------------------------------
--
-- Method:      setTag
--
-- Description:
--   tag position as points
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .setTag()

  -- Set tagging method up
  !this.posA.setAction(!this.tagMethod.selection())
  !this.posB.setAction(!this.tagMethod.selection())
  !this.posC.setAction('!!testPosLink.tagPoints()')

endmethod
-- End of method definition for .setTag()

------------------------------------------------------------------------
--
-- Method:      tagPoints
--
-- Description:
--   tag position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tagPoints()

  -- Tag both positions
  !positionA = !this.posA.get().wrt(World)
  !positionB = !this.posB.get().wrt(World)
  !positionC = !this.posC.get().wrt(World)

  -- Display Aid Text at Positions
  AID CLEAR TEXT 100
  handle any
  endhandle

  AID TEXT NUMB 100 'Position A' AT $!positionA
  AID TEXT NUMB 100 'Position B' AT $!positionB
  AID TEXT NUMB 100 'Position C' AT $!positionC

endmethod
-- End of method definition for .tagPoints()

------------------------------------------------------------------------
--
-- Method:      tagBox
--
-- Description:
--   tag position as a box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .tagBox()

  -- Tag both positions
  !positionA   = !this.posA.get().wrt(World)
  !positionB   = !this.posB.get().wrt(World)

  -- Box dimensions
  !xLength     = ABS(!positionA.east  - !positionB.east)
  !yLength     = ABS(!positionA.north - !positionB.north)
  !zLength     = ABS(!positionA.up    - !positionB.up)

  !newPosition        = !positionA
  !newPosition.east   = (!positionA.east  + !positionB.east)  / 2
  !newPosition.north  = (!positionA.north + !positionB.north) / 2
  !newPosition.up     = (!positionA.up    + !positionB.up)    / 2

  -- Display Aid BOX between Position
  AID CLEAR BOX 100
  handle any
  endhandle

  AID BOX NUMB 100 XLENGTH $!xLength YLENGTH $!yLength ZLENGTH $!zLength POSITION $!newPosition

  !this.tagPoints()

endmethod
-- End of method definition for .tagBox()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description:
--   close form down
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- Clear Aid Graphics
  AID CLEAR BOX 100
  handle any
  endhandle
  AID CLEAR TEXT 100
  handle any
  endhandle

endmethod
-- End of method definition for .close()
