-- Kill existing form definition
kill !!testStore

-- Define form
setup form !!testStore

  !!testStore.formTitle     = 'Test Storage Areas'
  !!testStore.iconTitle     = 'Storage'
  !!testStore.callback      = ''
  !!testStore.formRevision  = ' $Revision: 1.3 $ '

  -- Body of form definition

  path down

  -- List setting
  list   .list 'List Test' width 50 length 4

  -- Option setting
  option .option 'Option Test'  width 50

  -- Button/Paragraph
  button .button1 | Beams | at xmin         ymax
  para   .para              at xmax         ymin width 32 lines 1
  button .unset1  |Unset|   at xmax         ymin

  -- Button/textin
  button .button2 |Columns| at xmin.button1 ymax
  text   .text              at xmax         ymin width 30 string
  button .unset2  |Unset|   at xmax         ymin

exit

-- End of form definition for !!testStore

-- Link gadgets to group storage
call !!storageForGroup(!!testStore.list, 'STLWRK','NOCHECK')

call !!storageForGroup(!!testStore.option,'STLWRK','NOCHECK')

call !!storageForArea(!!testStore.button1, !!testStore.para, 'STLWRK', 'BEAM', 'NOCHECK')

call !!storageForArea(!!testStore.unset1, !!testStore.para, 'STLWRK', 'BEAM', 'UNSET')

call !!storageForArea(!!testStore.button2, !!testStore.text, 'STLWRK', 'COLUMN', 'NOCHECK')

call !!storageForArea(!!testStore.unset2, !!testStore.text, 'STLWRK', 'COLUMN', 'UNSET')

-- Load gadgets
call !!storageAreasDisp()
!!testStore.show()
