--
-- Description:     Form for Marine autosave application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -                   Initialise form
--  lastSave()                       -                   Outputs the last save time on the form
--  settings()                       -                   Collects autosave duration and savework/getwork options and
--  start()                          -                   Start Autosave service
--  stop()                           -                   Stop Autosave service
--  vmAutoSave()                     -                   Constructor
--
------------------------------------------------------------------------

--Define form
setup form !!vmAutoSave dialog

  !this.formTitle = 'AutoSave'

  paragraph .timePara   anchor left + right + top at x0 y0 line 1 width 30
  frame .frOpt   anchor left + top  at x0 ymax-0.2
    option .actOpt 'Operation' anchor left + top callback '!this.settings()' at x0.5 ymax+0.2 tagwidth 8 width 10
    path down
    option .minOpt 'Interval'  anchor left + top callback '!this.settings()'                  tagwidth 8 width 10
  exit

  button .start   'Start'   anchor left + bottom   callback '!this.start()' at xmin.frOpt  ymax.frOpt+0.2 width 5
  path right
  button .stop    'Stop'    anchor left + bottom   callback '!this.stop()'                                width 5

  button .dismiss 'Dismiss' anchor right + bottom  callback '!this.hide()'  at xmax form-size ymin.start

  -- Form Members
  -- Date form for last save display
 member .dateFormat is DATEFORMAT
 -- List of allowed intervals (minutes)
 member .intervals  is ARRAY

 exit
 -- End of form definition

------------------------------------------------------------------------
--
-- Method:      vmAutoSave
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .vmAutoSave()

  !this.initcall = '!this.init()'

  --Setting Option Garget.
  !actOpt[1] = 'Save'
  !actOpt[2] = 'Save/GetWork'
  !this.actOpt.dtext = !actOpt

  -- preset intervals
  !this.intervals[1] = 15
  !this.intervals[2] = 30
  !this.intervals[3] = 45
  !this.intervals[4] = 60

  -- set the interval option
  do !index indices !this.intervals
    !minOptRtext[!index] = !this.intervals[!index].string()
    !minOptDtext[!index] = !this.intervals[!index].string() + ' minutes'
  enddo
  !this.minOpt.dtext = !minOptDtext
  !this.minOpt.rtext = !minOptRtext
  !this.minOpt.val = 4

  -- set the date format for last interval start on the form
  !this.dateFormat = object DATEFORMAT('T D M Y')
  !this.dateFormat.month('BRIEF')
  !this.dateFormat.year(4)

endmethod
-- End of method definition

-----------------------------------------------------------------------
--
-- Method:      init
--
-- Description:
--   Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- Show current state of the interval
  !this.lastSave()

  -- show current timer settings
  !interval = 60
  !savework = true
  !getwork  = false
  !!appHsave.getSettings(!interval, !savework, !getwork)
  handle any
    return
  endhandle

  -- select interval
  !this.minOpt.select('Rtext', !interval.string())
  handle any
    !this.minOpt.val = 1
  endhandle

  -- select save option
  if( !getwork ) then
    !this.actOpt.val = 2
  else
    !this.actOpt.val = 1
  endif

  -- Activate the appropriate button
  !running = !!appHsave.autoSaveOn
  handle any
    !this.timePara.val = 'AutoSave utility not loaded'
    !this.start.active = false
    !this.stop.active  = false
    return
  endhandle
  if( !running ) then
    !this.start.active = false
    !this.stop.active  = true
  else
    !this.start.active = true
    !this.stop.active  = false
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      start
--
-- Description:
--   Start Autosave service
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .start()

  !!appHsave.initialise(true)
  handle any
    !!alert.error('AutoSave utility not loaded')
    !this.hide()
    return
  endhandle
  !this.settings()
  !this.init()

endmethod
-- End of method definition for .start

------------------------------------------------------------------------
--
-- Method:      stop
--
-- Description:
--   Stop Autosave service
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stop()

  !!appHsave.initialise(false)
  handle any
    !!alert.error('AutoSave utility not loaded')
  endhandle
  !this.init()

endmethod
-- End of method definition for .stop

------------------------------------------------------------------------
--
-- Method:      settings
--
-- Description:
--   Collects autosave duration and savework/getwork options and
--   informs the control object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settings()

  -- get autosave duration
  !option = !this.minOpt.selection()
  !minute = !option.real()
  handle any
     !minute = 15
  endhandle

  -- get savework/getwork options
  !savework = false
  !getwork  = false
  if(!this.actOpt.val eq 1) then
    !savework = true
  elseif(!this.actOpt.val eq 2) then
    !savework = true
    !getwork = true
--  elseif(!this.actOpt.val eq 3) then
--    !getwork = true
  else
    !savework = true
  endif

  -- set values in the control object
  !!appHsave.settings(!minute, !savework, !getwork)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      lastSave
--
-- Description:
--   Outputs the last save time on the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .lastSave()

  !running = !!appHsave.autoSaveOn
  handle any
    !this.timePara.val = 'AutoSave utility not loaded'
    return
  endhandle
  if( !running ) then
    !runningMessage = 'ACTIVE: '
  else
    !this.timePara.val = 'STOPPED'
    return
  endif

  if( not defined(!!lastSaveDateTime) ) then
    !this.timePara.val = !runningMessage + 'Last save: None'
    return
  endif
  if( !!lastSaveDateTime.unset() ) then
    !this.timePara.val = !runningMessage + 'Last save: None'
    return
  endif
  !this.timePara.val = !runningMessage + 'Interval Start: ' + !this.dateFormat.string(!!lastSaveDateTime)
  handle any
  endhandle

endmethod
-- End of method definition
