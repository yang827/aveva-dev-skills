--
-- Description:
-- Adds a check object to the checker system.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    R   R      CHECK       Check object to be included into the system
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!addCheckerCheck (!check is CHECK)

  -- Add check to checker list
  !!checker.checks.append(!check)

endfunction
-- End of function definition for !!addCheckerCheck
