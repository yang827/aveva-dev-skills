--
--
-- Description:
-- Adds the passed storage area to the storage area form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STORE       Storage Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!addStoreArea (!store is STORE)

  -- Initialise Variables

  -- Check if passed store is already been stored
  !block   = object BLOCK('!!storageAreas.stores[!evalIndex].name.upcase()')
  !groups  = !!storageAreas.stores.evaluate(!block)

  -- Create a group if required
  if(!groups.findFirst(!store.group.upcase()).unset()) then
    !group                = object STOREGROUP()
    !group.name           = !store.group.upcase()
    !group.title          = !store.group.upcase()
    !group.fileType       = !store.fileType
    call !!addStoreGroup(!group)
    !groups.append(!group.name)
  endif

  -- Get Group Position
  !gpos   = !groups.findFirst(!store.group.upcase())

  -- Check if passed store is already been stored
  !block   = object BLOCK('!!storageAreas.stores[!gpos].areas[!evalIndex].name.upcase()')
  !names   = !!storageAreas.stores[!gpos].areas.evaluate(!block)

  -- Check if the entry is already in the list.
  if(!names.findFirst(!store.name.upcase()).set()) then
    return
  endif

  -- Load into form
  !!storageAreas.stores[!gpos].areas.append(!store)

endfunction
-- End of function definition for !!addStoreArea
