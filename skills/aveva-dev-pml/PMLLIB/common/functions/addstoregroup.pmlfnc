--
--
-- Description:
-- Adds the passed storage group to the storage area form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STOREGROUP  Storage Group Data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!addStoreGroup (!group is STOREGROUP)

  -- Initialise Variables

  -- Check if passed storage group is already been defined
  !block  = object BLOCK('!!storageAreas.stores[!evalIndex].name')
  !names  = !!storageAreas.stores.evaluate(!block)

  -- Check if the entry is already in the list.
  if(!names.findFirst(!group.name.upcase()).set()) then
    return
  endif

  -- Load into form
  !!storageAreas.stores.append(!group)

endfunction
-- End of function definition for !!addStoreGroup
