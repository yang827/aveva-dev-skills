--
--
-- Description:
-- Executes a command with optional trace to the request window.
-- Errors must be handled by the caller.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!admCommand( !command is STRING )

  if( defined(!!admCommandTrace) ) then
    write('$!command')
    !!admCommandStack.append(!command)
    handle any
    endhandle
  endif

  $!command

endfunction
-- End of function definition for !!admCommand
