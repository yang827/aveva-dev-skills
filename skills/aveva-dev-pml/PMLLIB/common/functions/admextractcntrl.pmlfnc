--   Group:         General Application

--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          M.Barlow
-- Created:         Mon Feb 21 12:11:32 "GMT 2000
--
--
-- Description:
-- Invoke extract control form if RW extracts in current MDB
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!admExtractCntrl()

  !session       = CURRENT SESSION
  !currentDbs    = !session.current()
  !status        = !session.status()
  !readWriteDbs  = ARRAY()
  !currentDbRefs = ARRAY()

  -- get dbs that are read/write
  do !i indices !status
    if(!status[!i].upcase().eq('RW')) then
      !readWriteDbs.append(!currentDbs[!i].refno)
    endif
  enddo

  -- find extracts primary at this location
  var !dbs COLLECT ALL WITH ( NOT UNSET(EXTOWN) AND EXTOWN NE REFNO ) FROM !readWriteDbs
  !foundDbs = !dbs.empty().not()

  if(!!glbIsGlobal() and !foundDbs)then
    var !dbLocations EVALUATE (FULLNAME OF LOCRF of 1) FOR ALL FROM !dbs IGNORE ANY
    !location = !session.locationName
    !foundDbs = !dbLocations.findFirst(!location).set()
  endif

  -- show extract control form only if candidate extract or working extract DBS found
  if( !foundDbs ) then

    show !!admExtractCntrol

  else

    -- there might be working extracts in this MDB
    -- find all working extracts for this user
    !userRefNo    = !session.user().refno
    VAR !workExtOwners EVALUATE (REFNO OF EXTOWN) FOR ALL DB FOR $!userRefNo
    -- get array of current DB's to use in search
    do !i indices !currentDbs
      !currentDbRefs[!i] = !currentDbs[!i].refno
    enddo
    do !db values !workExtOwners
      -- search for DB in this MDB
      !foundDbs = !currentDbRefs.findFirst(!db).set()
      -- stop as soon as a working extract is found for a DB in this MDB
      break if( !foundDbs )
    enddo
    if( !foundDbs ) then
      show !!admExtractCntrol
    else
      !!alert.error('There are no Read/Write extract databases in your current MDB')
    endif

  endif

endfunction
-- End of function definition for !!admExtractCntrl
