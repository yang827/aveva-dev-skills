--
-- Author:          M.Barlow
-- Created:         Fri Feb 25 16:13:52 "GMT 2000
--
--
-- Description:
-- Name gadget check for Admin create/modify forms for elements with simple /name
-- This is not used for elements with /*name format
-- This should be replaced by a name object in future
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Name gadget
--    2   R      STRING      mode is CREATE or MODIFY
--    3   R      DBREF       dbref of the current element (or unset dbref)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!admGenNameChk(!gadget is GADGET, !mode is STRING, !curDbRef is DBREF)

   -- Initialise variables
  !name       = !gadget.val
  if( !name.substring(1,1) ne '/' ) then
    -- add a / for PDMS name
    !name     =  '/' + !name
  endif
  -- Check to see if name converts to a dbref
  !dbRef      = !name.dbRef()
  handle any
    !gadget.val = !name.substring(2)
    -- Element not found, so name not used
    return
  endhandle

  -- name has been used
  -- Check to see if dbref matches current ref
  if (!dbRef eq !curDbRef) then
    !gadget.val = !name.substring(2)
    return
  endif
  -- Element name already used (Bad)
  -- Reset value based on mode
  if (!mode eq 'CREATE') then
    !gadget.val      = |unset|
  elseif (!mode eq 'MODIFY') then
    if( not badref(!curDbRef) ) then
      -- Set the form gadgets
      !objectName = !curDbRef.name
      if( !objectName.substring(1,1) eq '=' ) then
        !gadget.val = 'unset'
      else
        !gadget.val = !objectName.substring(2)
      endif
    endif
  endif
  -- Raise error
  !!alert.error('Name ' + !dbRef.name + ' has already been used')
  !gadget.setFocus()


endfunction
-- End of function definition
