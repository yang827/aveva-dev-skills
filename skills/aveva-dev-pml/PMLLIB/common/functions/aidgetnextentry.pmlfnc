-- Created:         Wed Dec 17 11:32:08 WAT 1997
--
--
-- Description:
-- Gets next available graphic AID number for a specific type of aid group.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Group Identifier
--    2   R      STRING      Description for new aid number
-- Return:
--   [Data Type] [Description]
--    REAL        Aid number
--
------------------------------------------------------------------------

-- Define function
define function !!aidGetNextEntry(!group is STRING, !description is STRING) is REAL

  -- If global variable doesn't exist, then create it
  if(undefined(!!aidLst)) then
    call !!comDefineGlobal(object AIDLST())
  endif

  -- Get next entry for passed group
  return !!aidLst.getNextEntry(!group, !description)

endfunction
-- End of function definition for !!aidGetNextEntry
