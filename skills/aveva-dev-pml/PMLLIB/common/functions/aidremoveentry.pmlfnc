--
-- Description:
-- Remove the specified entry from a group.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number to remove
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is aid number has been removed
--
------------------------------------------------------------------------

-- Define function
define function !!aidRemoveEntry(!index is REAL) is BOOLEAN

  -- If global variable doesn't exist, then create it
  if(undefined(!!aidLst)) then
    call !!comDefineGlobal(object AIDLST())
  endif

  -- Get next entry for passed group
  return !!aidLst.removeEntry(!index)

endfunction
-- End of function definition for !!aidRemoveEntry
