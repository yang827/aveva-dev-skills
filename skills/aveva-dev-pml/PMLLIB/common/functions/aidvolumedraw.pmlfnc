--   Type:          Function Definition
--   Group:         Aid element handlers
--     Keyword:     AID
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Oct 31 15:05:25 WAT 1997
--
--
-- Description:
-- Draw an aid box for the volume passed, these are always wrt World.
-- The function w
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid Number
--    2   R      ANY         Object to have box draw
--                             <dbRef>    - Elements volume
--                             <volume>   - Explicit volume
--                             <gadget>   - Limits box of view gadget
--    3   R      BOOLEAN     Retain aid "box" of same Aid Number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aidVolumeDraw(!aidNumber is REAL, !data is ANY, !retainFlag is BOOLEAN)

  -- Initialise Variables
  -- Remove Aid Box
  if(!retainFlag.not()) then
    AID CLEAR BOX $!aidNumber
    handle any
    endhandle
  endif

  -- Database Element
  if(!data.objectType() eq 'DBREF') then

    !volume = !!volume(!data)

  -- Volume
  elseif (!data.objectType() eq 'VOLUME') then

    -- Load view limits with Volume
    !volume      = !data
    !volume.from = !volume.from.wrt(World)
    !volume.to   = !volume.to.wrt(World)

  --  Another view gadget
  elseif (!data.objectType() eq 'GADGET') then

    !array       = !data.limits

    !volume      = object VOLUME()
    !volume.from = object POSITION('N0')
    !volume.to   = object POSITION('N0')

    -- List Limits into volume
    !volume.from.east  = !array[1]
    !volume.from.north = !array[3]
    !volume.from.up    = !array[5]
    !volume.to.east    = !array[2]
    !volume.to.north   = !array[4]
    !volume.to.up      = !array[6]

    --Unhandled data type
  else
    return
  endif

  -- Define Box Object
  !xLength         = ABS(!volume.to.east   - !volume.from.east)
  !yLength         = ABS(!volume.to.north  - !volume.from.north)
  !zLength         = ABS(!volume.to.up     - !volume.from.up)
  !position        = object POSITION('N0')
  !position.east   = (!volume.to.east  + !volume.from.east)  / 2
  !position.north  = (!volume.to.north + !volume.from.north) / 2
  !position.up     = (!volume.to.up    + !volume.from.up)    / 2

  -- Draw Box
  AID BOX NUMBER $!aidNumber XLEN $!xLength YLEN $!yLength ZLEN $!zLength AT $!position
endfunction
-- End of function definition for !!aidVolumeDraw
