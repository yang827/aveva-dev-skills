-- File:            anyerror.pmlfnc
--   Type:          Function Definition
--   Group:         Error Handling
--     Keyword:     ERROR
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Apr 1 10:37:25 WAT 1997
--
--
-- Description:
-- Takes the passed error code and then execute the relevant function:
--
--    -ve    error codes will run the Warning functions (displays message
--           but doesn't stop the calling function)
--      0    has no action at all
--    +ve    uses the Error function (displays message and stops calling
--           function)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Error code
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!anyError (!messageCode is REAL)

  -- Warning Message
  if(!messageCode lt 0) then
    call !!warning(!messageCode.abs())
  elseif (!messageCode gt 0) then
    call !!error(!messageCode)
  endif

endfunction
-- End of function definition for !!anyError
