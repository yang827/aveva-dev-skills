-- Created:         Tue Mar 09 12:23:26 2004
--
--
-- Description:     Saves application state if required
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      name of current module
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!appSaveState(!moduleName is STRING)
  !moduleNameUC = !moduleName.upcase()
  if (!moduleNameUC inset ('ADMIN', 'MONITOR', 'LEXICON', 'DESIGN', 'DRAFT', 'PARAGON', 'SPOOLER', 'OUTFITTING', 'OUTFITTINGDRAFT', 'HULLDESIGN', 'MARINEDRAFTING', 'DIAGRAMS', 'SCHEMATICMODELMANAGER', 'TAGS')) then
     if(undefined(!!appCntrl)) then
      !!appCntrl = object APPCNTRL()
     endif
     !!appCntrl.saveApplicationState()
  endif
endfunction
