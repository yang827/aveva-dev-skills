-- Description:
-- Function to execute forms from outside PDMS
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!aspComparator(!where is STRING)

  -- Now just shows this form once only (it is then hidden in its firstShown call)
  if (undefined(!!aspCompCmd)) then
   show !!aspCompCmd free at xr -0.5 yr -0.5
endif

endfunction
-- End of function definition for !!aspComparator
