--
--
-- Description:
-- Load attribute list data from "attlib.dat" file.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Constant Group Name
--    2   R      REAL        Constant Number
-- Return:
--   [Data Type] [Description]
--    STRING      Description of Constant
--
------------------------------------------------------------------------

-- Define function
define function !!attlibConstant (!type is STRING, !number is REAL) is STRING

  -- Initialise Variables
  !return = STRING()

  --
  !list = !!attlibConstants(!type)

  -- Check for a return
  if(!list.set()) then

    if(define(!list[!number])) then
      !return = !list[!number]
    endif

  endif

  return !return

endfunction
-- End of function definition for !!attlibConstant
