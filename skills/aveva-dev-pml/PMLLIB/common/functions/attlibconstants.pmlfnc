--
--
-- Description:
-- Load attribute list data from "attlib.dat" file.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Constant Group
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!attlibConstants (!type is STRING) is ARRAY

  -- Initialise Variables
  !return = ARRAY()

  -- Definition Constants
  if(!type eq 'DEFI') then

    !return[1] = 'DDL'
    !return[2] = 'Dynamic'
    !return[3] = 'DDL or Dynamic'
    !return[4] = 'Pseudo'
    !return[5] = 'DDL or Pseudo'
    !return[6] = 'Dynamic or Pseudo'
    !return[7] = 'DDL or Dynamic or Pseudo'

  -- Type
  elseif (!type eq 'TYPE') then

    !return[0] = 'All'
    !return[1] = 'Integer'
    !return[2] = 'Real'
    !return[3] = 'Logical'
    !return[4] = 'Text'
    !return[5] = 'Reference'
    !return[6] = 'Word'
    !return[7] = 'Orientation'
    !return[8] = 'Position'
    !return[9] = 'Direction'

  -- Recursion
  elseif (!type eq 'RECURSION') then

    !return[1] = 'Point Set'
    !return[2] = 'Geometry Set'

  -- Copy
  elseif (!type eq 'COPY') then

    !return[0] = 'Always Copy'
    !return[1] = 'Do not copy in COPY LIKE'
    !return[2] = 'Never Copy'
    !return[3] = 'Connection - go via DT table'
    !return[4] = 'Specials'
    !return[5] = 'specials'

  -- Qualifiers
  elseif (!type eq 'QUAL') then

    !return[0] = 'No Qualifier Required'
    !return[1] = 'Integer Qualifier'
    !return[2] = 'Word Qualifier'
    !return[3] = 'Attribute Qualifier'
    !return[4] = 'Noun Qualifier'

  endif

  return !return

endfunction
-- End of function definition for !!attlibConstants
