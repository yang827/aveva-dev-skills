--
--
-- Description:
-- Gets current selection and extract data for it, insets it into
-- attribute list of form for further use
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!attlibData()

  -- Initialise Variables

  -- Selected Attribute
  !attribute = !!attlib.list.selection()

  -- Attribute number
  !attNumber = !!attlib.attList.findFirst(!attribute)

  -- If there is an entry in the Attribute list, use it
  -- otherwise get the  data
  if(defined(!!attlib.attributes[!attNumber])) then

    !attDef = !!attlib.attributes[!attNumber]

  -- Extract from definition
  else

    !attDef = !!attlibGet(!attribute)
    !!attlib.attributes[!attNumber] = !attDef
  endif

  -- Write Data to form
  !!attlib.name.val   = !attDef.name
  !!attlib.qtxt.val   = !attDef.member
  !!attlib.rptx.val   = !attDef.rptx
  !!attlib.defi.val   = !attDef.definition
  !!attlib.type.val   = !attDef.type
  !!attlib.dTyp.val   = !attDef.dbType
  !!attlib.size.val   = !attDef.size.string()
  !!attlib.unit.val   = !attDef.units
  !!attlib.visi.val   = !attDef.visible.string()
  !!attlib.qset.val   = !attDef.settable.string()

endfunction
-- End of function definition for !!attlibData
