--
--
-- Description:
-- Find attribute with string in it.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!attlibFind()

  -- Initialise Variables
  !currentSelection = !!attlib.list.val

  -- Get Search string
  !searchString = !!attlib.searchString.val

  -- Empty last selection
  !!attlib.selection.clear()
  !!attlib.selected = REAL()

  -- Grey out movement
  !!attlib.previous.active = false
  !!attlib.next.active     = false
  !!attlib.numberOff.val   = ''

  -- Do nothing if there is nothing to search on
  if(!searchString.trim().empty()) then
    return
  endif

  -- If there are no * or ? in the string, add * to the beginning/end
  if(!searchString.match('*') eq 0 and !searchString.match('?') eq 0) then
    !searchString = '*' & !searchString & '*'
    !!attlib.searchString.val = !searchString
  endif

  -- Loop through the list
  do !i indices !!attlib.attList

    if(!!attlib.attList[!i].upcase().matchWild(!!attlib.searchString.val.upcase())) then
      !!attlib.selection.append(!i)
    endif

  enddo

  -- If there are no selection, then give a warning
  if(!!attlib.selection.unset()) then
    !!alert.warning('Unable to find any Attribute member name with "' & !searchString & '" in it.')
    return
  endif

  !!attlib.previous.active = true
  !!attlib.next.active     = true

  -- Set selected entry to current selection, if permissible
  !!attlib.selected = !!attlib.selection.findFirst(!currentSelection)

  -- Display the selection
  call !!attlibMove('')

endfunction
-- End of function definition for !!attlibFind
