--
--
-- Description:
-- Load attribute list data from "attlib.dat" file.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Attribute
-- Return:
--   [Data Type] [Description]
--    ATTDEF      Attribute Definition
--
------------------------------------------------------------------------

-- Define function
define function !!attlibGet (!attribute is STRING) is ATTDEF

  -- Initialise Variables
  !return = object ATTDEF()

  -- Member
  !return.member = !attribute

  -- Name
  var !data ATTDEF $!<attribute> NAME NAME
  handle any
    return !return
  endhandle
  !return.name = !data[1]

  -- Report Text
  var !data ATTDEF $!<attribute> NAME RPTX
  !return.rptx = !data[!data.size()]

  var !data ATTDEF $!<attribute> NAME SIZE
  !return.size = !data[!data.size()].real()

  -- Definition
  var !code ATTDEF $!<attribute> NAME  DEFI
  handle any
    !code[!code.size()] = 0
  endhandle

  -- Write Data
  if(defined(!!attlib.defiArray[!code[!code.size()].real()])) then
    !return.definition = !!attlib.defiArray[!code[!code.size()].real()]
  else
    !return.definition = 'Unknown code (' & !code[!code.size()] & ').'
  endif

  -- Type
  var !code ATTDEF $!<attribute> NAME TYPE
  handle any
    !code[!code.size()] = 0
  endhandle

  -- Write Data
  if(defined(!!attlib.typeArray[!code[!code.size()].real()])) then
    !return.type = !!attlib.typeArray[!code[!code.size()].real()]
  else
    !return.type = 'Unknown code (' & !code[!code.size()] & ').'
  endif

  -- Database Type
  var !code ATTDEF $!<attribute> NAME DTYP
  handle any
    !code[!code.size()] = 0
  endhandle

  if(!code[!code.size()].trim().empty().not()) then
    -- Write Data
    if(defined(!!attlib.typeArray[!code[!code.size()].real()])) then
      !return.dbType = !!attlib.typeArray[!code[!code.size()].real()]
    else
      !return.dbType = 'Unknown code (' & !code[!code.size()] & ').'
    endif
  else
    !return.dbType = 'Unable to extract Database Type.'
  endif

  -- Units
  var !code ATTDEF $!<attribute> NAME UNIT
  handle any
    !code[!code.size()] = ''
  endhandle

  !unitsCode = !code.last()

  if(!unitsCode eq 'DIST') then
    !return.units = 'Distance'
  elseif (!unitsCode eq 'BORE') then
    !return.units = 'Bore'
  elseif (!unitsCode eq 'NONE') then
    !return.units = 'None'
  elseif (!unitsCode.empty()) then
    !return.units = 'N/A'
  else
    !return.units = !unitsCode
  endif

  -- Visible
  var !code ATTDEF $!<attribute> NAME VISI
  handle any
    !code[!code.size()] = 'Undefined'
  endhandle

  !return.visible = !code[!code.size()].boolean()

  -- Query
  var !code ATTDEF $!<attribute> NAME QSET
  handle any
    !code[!code.size()] = 'Undefined'
  endhandle

  !return.settable = !code[!code.size()].boolean()

  return !return

endfunction
-- End of function definition for !!attlibGet
