--
-- Description:
-- Load attribute list data from "attlib.dat" file.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!attlibLoad()

  -- Get Attlib file
  !files = !!searchPaths('attlib.dat')

  -- Load first attlib file found into array
  !list  = !files[1].file.readFile()
  !list.sort()

  -- Clear all attribute list data form
  !!attlib.attList.clear()
  !!attlib.attributes.clear()
  !!attlib.selection.clear()

  -- Load into Attribute List of form
  !!attlib.attList    = !list

  !!attlib.list.dText = !list

endfunction
-- End of function definition for !!attlibLoad
