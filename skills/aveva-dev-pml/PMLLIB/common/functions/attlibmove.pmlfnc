--
--
-- Description:
-- Move to attribute in list.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Direction of movement:
--                                      NEXT      Next selection
--                                      PREVIOUS  Previous selection
--                                      <null>    Current selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!attlibMove (!move is STRING)

  -- Setup to current selection
  if(!move.empty()) then

    -- If no selected item, then use the first
    if(!!attlib.selected.unset()) then
      !!attlib.selected = 1
    endif

  -- Move to next selection
  elseif (!move.upcase() eq 'NEXT') then

    if(!!attlib.selected eq !!attlib.selection.size()) then
      !!attlib.selected = 1
    else
      !!attlib.selected = !!attlib.selected + 1
    endif

  -- Move to previous selection
  else

    if(!!attlib.selected eq 1) then
      !!attlib.selected = !!attlib.selection.size()
    else
      !!attlib.selected = !!attlib.selected - 1
    endif


  endif

  -- Select item
  !!attlib.list.val = !!attlib.selection[!!attlib.selected]

  !size = !!attlib.selection.size()
  var !dprt COMPOSE '$!!attlib.selected of $!size' WIDTH 18 C

  !!attlib.numberOff.val = !dprt[1]

  call !!attlibData()

endfunction
-- End of function definition for !!attlibMove
