-- Description:
--    Show standard query form explorer
--
------------------------------------------------------------------------
--
define function !!attributes()

  -- Check if form has been defined
  if(undefined(!!queryAttributes)) then
    pml reload form !!queryAttributes
  endif

  -- Show standard query, with no tracking
  !!queryAttributes.track(!!CE)
  if(!!queryAttributes.shown()) then
    !!queryAttributes.query()
  else
    !!queryAttributes.show()
  endif

endfunction
-- End of function definition
