-- Created:         Wed Apr 30 12:51:36 WAT 1997
--
--
-- Description:
-- Tries and return the "correct" storage area for the passed
-- storage group and area.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF
--    2   R      STRING      Group Name
--    3   R      STRING      Area of Group
--    4   R      BOOLEAN     Check/Use auto select rule
-- Return:
--   [Data Type] [Description]
--    DBREF
--
------------------------------------------------------------------------

-- Define function
define function !!autoSelectStore (!item is DBREF, !groupName is STRING, !areaName is STRING, !check is BOOLEAN) is DBREF

  -- Initialise Variables
  !returnDbRef = object DBREF()

  -- Get Storage Data
  !store       = !!storageData(!groupName, !areaName)

  if(!store.unset()) then
    return !returnDbRef
  endif

  -- Check if item is a valid store, if not try one of its parents

  !owners       = !item.ownLst
  !owners.append(!item)

  !parent     = object DBREF()
-- Find first owner that matches list of allowed types
  !choices = !owners.invert()
  do !choice values !choices
        if (!store.owningTypes.findfirst(!choice.type).set() ) then
            !parent = !choice
            break
        endif
   enddo

  -- Auto check/select parent
  if(!check) then

    -- If there is a rule set, then we will test against it
    if(!store.autoSelectRule.set() and !store.autoSelectRule.empty().not()) then

      -- If parent is set, then does it conform to the rule
      if(!parent.set()) then

      -- Check Rule
       !refe = !!ce
       !!ce = !parent
        if ($!store.autoSelectRule  ) then
            !!ce = !refe
              if(!!dbRefUpdate(!parent).not()) then
                !!messageFile.warning(149, 103, !store.title, !!error.text)
                return !returnDbRef
              endif

              -- Return
              return !parent
        endif
       !!ce = !refe

        -- If we reach here, then the parent was not suitable
        -- we need to look for an item which is.

        -- Look from above the identified parent
        !owner = !parent.owner

        -- Collect all of the type of the parent and conform to the rule
        !items = !!collectMembersOf(!owner, 'TYPE eq |' & !parent.type & '| AND ( ' & !store.autoSelectRule & ' )')

        -- If there are amy items in the list, we'll use the first one
        if(!items.set()) then
          -- Loop through Items and check we have access to them
          do !i indices !items
            if(!!dbRefUpdate(!items[!i])) then
              return !items[!i]
            endif
          enddo
          !!messageFile.warning(149, 103, !store.title, !!error.text)
          return !returnDbRef
        endif

      -- No parent found, so we will look beneath the current position
      else

        -- Create List of item to look for
        !types = ''
        do !type values !store.owningTypes
          !types = !types & ' ' & !type
        enddo

        -- Collect all types with rule
        !items = !!collectAllFor(!types, !store.autoSelectRule, !item)

        -- If there are amy items in the list, we'll use the first one
        if(!items.set()) then

          -- Loop through Items and check we have access to them
          do !i indices !items
            if(!!dbRefUpdate(!items[!i])) then
              return !items[!i]
            endif
          enddo
          !!messageFile.warning(149, 103, !store.title, !!error.text)
          return !returnDbRef
        endif

      -- End of Parent validation
      endif

      !!messageFile.warning(149, 104, !store.title)
      return !returnDbRef

    -- End of Rule Checking
    endif

    !!messageFile.warning(149, 105, !store.title)
    return !returnDbRef

  -- End of Check
  endif

  -- No area found
  if(!parent.unset()) then
    !!messageFile.warning(149, 103, !store.title, 'You must be at the correct level or lower, in the hierarchy.')
    return !returnDbRef
  endif

  -- Check we have access to write to the item

  if(!!dbRefUpdate(!parent).not()) then
    !!messageFile.warning(149, 103, !store.title, !!error.text)
    return !returnDbRef
  endif

  -- Return
  return !parent

endfunction
-- End of function definition for !!autoSelectStore
