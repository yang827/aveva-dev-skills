--
--
-- Description:
-- Function to check that the AVEVA reference projects exist and can
-- be read.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if projects can be read.
--
------------------------------------------------------------------------

-- Define function
define function !!cadcRefProjects() is BOOLEAN

  -- Initialise variables
  !prjCodes     = ARRAY()
  !reference    = ARRAY()
  !projects     = PROJECTS
  !codeBlock    = object BLOCK(|!projects[!evalIndex].code()|)

  -- Set reference projects to find
  !reference[1] = 'MAS'
  !reference[2] = 'SAM'

  -- Build array of project codes
  !prjCodes     = !projects.evaluate(!codeBlock)

  -- Intersect the two arrays
  !foundCodes   = !prjCodes.intersect(!reference)

  -- Check that both projects have been found
  if (!foundCodes.size() eq !reference.size()) then

    -- All present in union
    return true

  else

    -- Not all present
    return false

  endif

endfunction
-- End of function definition for !!cadcRefProjects
