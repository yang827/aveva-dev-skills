-- File:            cadcsctnconn.pmlfnc
--   Type:          Function Definition
--   Group:         Checking routines
--     Keyword:     CHK
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Feb 25 08:30:31 GMT 1997
--
--
-- Description:
-- Check connections at ends of sections.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1   R      DBREF          Element to be checked
--    2   R      CHKDEFINITION  Check object
-- Return:
--   [Data Type] [Description]
--    CHKRETURN Return data from check function.
--
------------------------------------------------------------------------

-- Define function
define function !!cadcSctnConn (!element is DBREF, !dummyCheck is CHKDEFINITION) is CHKRETURN

  -- Initialise Variables
  !return             = object CHKRETURN()
  !return.passed      = true

  -- Check if both ends are connected
  if(!element.joiS neq Nulref and !element.joiE neq Nulref) then
    return !return
  endif

  -- Check if start is unconnected
  if (!element.joiS eq Nulref) then
    !return.messages.append(|Section Start is unconnected.|)
  endif

  -- Check if only start is connected
  if(!element.joiE eq Nulref) then
    !return.messages.append(|Section End is unconnected.|)
  endif

  !return.passed = false
  return !return

endfunction
-- End of function definition for !!cadcSctnConn
