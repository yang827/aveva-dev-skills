--
----------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   R      POSITION          start position of polyhedron
--    2   R      ORIENTATION       orientation of polyhedron
--    3   R      REAL              edge length
--    4   R      REAL              number of corners
--    5   R      REAL              angle wrt orientation of start edge
-- Return:
--   [Data Type] [Description]
--    PROFILE     the polyhedron
------------------------------------------------------------------------

define function !!calculatePolyhedron(!startPos is POSITION, !orientation is ORIENTATION, !edgeLength is REAL, !numberOfCorners is REAL, !startAngle is REAL) is PROFILE

  -- angle at one outer corner
  !outerAngle   = 180 * (!numberOfCorners - 2) / !numberOfCorners

  !points = ARRAY()
  !points.append(!startPos)

  !edgeArc   = object ARC(!startPos, !orientation, 0, 360, !edgeLength, false)
  !edgeEnd   = !edgeArc.anglePosition(!startAngle * -1)
  !edgeDir   = !startPos.direction(!edgeEnd)
  !points.append(!edgeEnd)

  do !i to (!numberOfCorners - 2)
    !edgeOri   = object ORIENTATION('X IS ' & !edgeDir.wrt(WORLD).string().before('WRT') & ' AND Z IS ' & !orientation.zDir().wrt(WORLD).string().before('WRT'))
    !edgeArc   = object ARC(!edgeEnd, !edgeOri, 0, 360, !edgeLength, true)
    !edgeStart = !edgeEnd
    !edgeEnd   = !edgeArc.anglePosition(180 - !outerAngle)
    !edgeDir   = !edgeStart.direction(!edgeEnd)
    !points.append(!edgeEnd)
  enddo

  -- create the profile object
  !profile = object PROFILE(!startPos, !orientation, !points)
  !profile.close()

  return !profile

endfunction
