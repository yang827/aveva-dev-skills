--
--
-- Description:
-- Associate callback function with a specified group and area
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!callbackForArea(!groupName is STRING, !areaName is STRING, !callback is STRING)

 -- Get Area Data
  !store      = !!storageData(!groupName, !areaName)

  -- Check that the callback is not already used
  !size = !!storageAreas.stores[!store.groupNumber].areas[!store.areaNumber].callbacks.size()
   if (!size gt 0) then
        do !index from 1 to !size
            if (!!storageAreas.stores[!store.groupNumber].areas[!store.areaNumber].callbacks[!index] eq !callback) then
                 return
            endif
        enddo
   endif
  -- Append callback to Area Store
  !!storageAreas.stores[!store.groupNumber].areas[!store.areaNumber].callbacks.append(!callback)

endfunction
-- End of function definition for !!callbackForArea
