--
-- File:            charactersymbol.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     UNICODE
--   Module:        common
--
-- Author:          M.Barlow
--  Created:         Mon Sep  5 16:16:49 2011--
--  Description:     Returns a symbolic character that is not in the Basic Latin (ASCII) set
--        Input argument is a code for the character
--        Empty string returned for unrecognised code
--        THIS FILE MUST BE SAVED AS UNICODE UTF-8 WITH BOM
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      STRING        Code for symbolic character
-- Return:
--   [STRING] [Unicode string for input code]
--
------------------------------------------------------------------------

define function !!characterSymbol(!code is STRING) is STRING

  !briefCode = !code.subString(1,4).upcase()
  if ( !briefCode eq 'DEGR' ) then
    -- degrees
    !return = |°|
  elseif ( !briefCode eq 'SECT' ) then
    -- section
    !return = |§|
  elseif ( !briefCode eq 'DIAM' ) then
    -- diameter
    !return = |ø|
  elseif ( !briefCode eq 'PARA' ) then
    -- paragraph
    !return = |¶|
  else
    -- default to ? if code not recognised
    !return = |?|
  endif

  return !return

endfunction
