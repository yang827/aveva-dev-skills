--
--
-- Description:
-- Check the number of strings in a csv record against an expected count
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [1] [R] [ARRAY] [String values from csv record]
--   [2] [R] [REAL] [Number of values expected]
--   [3] [R] [STRING] [Filename to go in message]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!checkCsvCount(!values is ARRAY, !noExpected is REAL, !filename is STRING) is BOOLEAN

  if (!values.size() lt !noExpected) then
    !record = ||
    do !i ind !values
      !record = !record & !values[!i]
      if (!i lt !values.maxIndex()) then
        !record = !record & |,|
      endif
    enddo
    !!alert.error(|Insufficient comma separated values found in | & !filename & | (Record: | & !record & |)|)
    return FALSE
  else
    return TRUE
  endif

endfunction
-- End of function definition for !!checkCsvCount
