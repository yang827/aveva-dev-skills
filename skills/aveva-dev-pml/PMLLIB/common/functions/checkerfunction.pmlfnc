-- File:            checkerfunction.pmlfnc
--   Type:          Function Definition
--   Group:         Checking routines
--     Keyword:     CHECK
--   Module:        design
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Feb 24 18:00:31 GMT 1997
--
--
-- Description:
-- Executes the passed check functions on the given item and returns
-- the any errors via the PROCERROR object
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item to be checked
--    2   R      CHECK       Check object
-- Return:
--   [Data Type] [Description]
--    CHECKRETURN Return object from check functions
--
------------------------------------------------------------------------

-- Define function
define function !!checkerFunction (!item is DBREF, !check is CHECK) is CHECKRETURN

  -- Initialise Variables
  !return        = object CHECKRETURN()
  !return.passed = false
  !function      = !check.function

  -- Check Item
  !return  = $!<function>(!item, !check)
  handle any
    !return.messages[1] = !!messageFile.messageString(142, 002, !check.function)
    !return.passed      = false
    return !return
  endhandle

  -- Check if the function passed
  return !return

endfunction
-- End of function definition for !!checkerFunction
