-- Define function
define function !!checkerInit()

  -- Initialise Variables
  !!checker.ce = !!ce

  -- Display CE
  if(!!ce.flnn.length() gt 98) then
    !!checker.name.val = !!ce.name
  else
    !!checker.name.val = !!ce.flnn
  endif

  -- Display Background so data has not been checked.
  !!checker.name.background = 255

  -- EmptyChecker display forms
  !!checker.passed.clear()
  !!checker.failed.clear()
  !!checker.checkList.clear()

  -- Passed/Failed
  !!checker.passedCount.val  = 'Passed'
  !!checker.failedCount.val  = 'Failed'

  -- Grey out Save Button
  !!checker.file.active      = false
  !!checker.save.active      = false
  !!checker.browser.active   = false
  !!checker.file.val         = ''

--  !!checker.save.background  = 255
--  !!checker.check.background = 'green'

endfunction
-- End of function definition for !!checkerInit
