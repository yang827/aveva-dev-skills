-- Author:          N.Holmes
-- Created:         Mon Feb 24 10:14:31 GMT 1997
--
--
-- Description:
-- Load all checking data file "<module>-Checks.dat" from the
-- standard search path areas
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!checkerLoad()

  -- Initialise Variables
  !!checker.checks.clear()

  -- Get Module
  !modData = !!module()
  !module  = !modData.appName

  -- Search Areas
  !paths = !!searchPaths('com-checks.pmldat')
  !paths.appendArray(!!searchPaths(!modData.appkey.lowcase() & '-checks.pmldat'))

  if (!paths.empty()) then
    !!comChecksDflt()

  else

    -- Cycle through list and load all files
    do !i indices !paths
      call !!runMacro(!paths[!i].file.fullName(),!paths[!i].defaultType)
      handle any
        !!alert.error(!!error.text & ' in ' & !paths[!i].file.fullName() & ' Checker loading is incomplete.')
      endhandle
    enddo
  endif

  -- Load form Checks into a processing array,
  !procArray = !!checker.checks

  -- Remove all no module checks
  do !i indices !procArray

    skip if(!procArray[!i].module.upcase().match(!module.upcase()) gt 0)
    !procArray[!i].delete()

  enddo

  -- Compress Array
  !procArray.compress()

  -- Re-Write checks array
  !!checker.checks = !procArray

  -- *********** Extensions to load for a later data ***********
  -- Remove duplications

  -- Display Permissible checks
  call !!checkerSet('MODULE')

endfunction
-- End of function definition for !!checkerLoad
