--
-- Description:
-- Navigates to the item defined in the passed gadget
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget containing item to move to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!checkerMove (!gadget is GADGET)

  -- Initialise Variables
  !item = !gadget.selection('RTEXT').dbRef()
  if(!item eq Nulref) then
    return
  endif
  !!ce  = !item

endfunction
-- End of function definition for !!checkerMove
