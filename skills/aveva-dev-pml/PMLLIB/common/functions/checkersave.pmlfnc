--
--
-- Description:
-- Save current check data to file.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!checkerSave()

  -- Initialise Variables

  -- User Information

  !session  = CURRENT SESSION
  !clock    = !!clock()

  -- Build Array
  !records  = ARRAY()

  -- File header
  !records.append('Check Report File')
  !records.append('')
  !records.append('  Created By : ' & !session.name)
  !records.append('        Date : ' & !clock.date)
  !records.append('')

  -- Check Performed
  !records.append('Checks Performed')
  !records.append('   Class : ' & !!checker.checks[!!checker.checkList[1].real()].class)
  !records.append('   Group : ' & !!checker.checks[!!checker.checkList[1].real()].group)

  -- Loop through checker performed (at check time)
  do !i indices !!checker.checkList
    !records.append('           [' & !i & '] ' & !!checker.checks[!!checker.checkList[!i].real()].title)
  enddo

  !records.append('')

  -- Summary
  !records.append('')
  !records.append('Summary of Checks')
  !records.append('')
  !records.append('           Elements passed all tests : ' & !!checker.itemsPassed.size())
  !records.append('    Elements failed on or more tests : ' & !!checker.itemsFailed.size())
  !records.append('                               Total : ' & !!checker.itemsChecked.size())
  !records.append('')



  -- Passed Element
    !records.append('Element that have passed all checks: ' & !!checker.itemsPassed.size())

    -- Indent by 4 character
    !block    = object BLOCK('|    | & !!checker.passed.dText[!evalIndex]')
    !records.append('')
    !records.appendArray(!!checker.passed.dText.evaluate(!block))
    !records.append('')

  -- Failed Elements

    !records.append('Element that have failed one or more checks: '& !!checker.itemsFailed.size())
    -- Indent by 4 character
    !block    = object BLOCK('|    | & !!checker.failed.dText[!evalIndex]')
    !records.append('')
    !records.appendArray(!!checker.failed.dText.evaluate(!block))
    !records.append('')


  -- Footer
  !records.append('')
  !records.append('End of Check Report File')

  -- Build up write array
  call !!writeFile(!!checker.file.val, 'WRITE', !records)

endfunction
-- End of function definition for !!checkerSave
