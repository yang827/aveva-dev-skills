--
--
-- Description:
-- Set the permissible checks for the current module, class or group
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of refresh MODULE, CLASS or GROUP
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!checkerSet(!type is STRING)

  -- Initialise Variables
  !classes = ARRAY()
  !groups  = ARRAY()
  !titles  = ARRAY()
  !checkNo = ARRAY()

  -- Collect all check class types
  !block   = object BLOCK('!!checker.checks[!evalIndex].class')
  !class   = !!checker.checks.evaluate(!block)

  -- Collect all check groups
  !block   = object BLOCK('!!checker.checks[!evalIndex].group')
  !group   = !!checker.checks.evaluate(!block)

  -- Collect all checks
  !block   = object BLOCK('!!checker.checks[!evalIndex].title')
  !title   = !!checker.checks.evaluate(!block)

  -- Type (MODULE)
  if(!type eq 'MODULE') then

    !classes = !class

    -- Remove Duplications and sort
    !classes.unique()
    !classes.sort()

    -- Write classes to gadget
    !!checker.class.dText = !classes
    !!checker.class.rText = !classes

  endif

  -- Load Groups up for current class (CLASS)
  if(!type eq 'MODULE' or !type eq 'CLASS') then

    -- Ignore groups for different classes
    do !i indices !class
      skip if(!class[!i] ne !!checker.class.selection('RTEXT'))
      !groups.append(!group[!i])
    enddo

    -- Remove Duplications and sort
    !groups.unique()
    !groups.sort()

    -- Write classes to gadget
    !!checker.group.dText = !groups
    !!checker.group.rText = !groups

  endif

  -- Load Available Check for selected Classes and Groups

  -- Ignore groups for different classes
  do !i indices !title

    skip if(!class[!i] ne !!checker.class.selection('RTEXT') or $
            !group[!i] ne !!checker.group.selection('RTEXT'))

    !titles.append(!title[!i])
    !checkNo.append(!i.string())

  enddo

  -- Sort Titles
--  !sort = !titles.sortedIndices()

  -- Write classes to gadget
  !!checker.list.dText = !titles
  !!checker.list.rText = !checkNo

endfunction
-- End of function definition for !!checkerSet
