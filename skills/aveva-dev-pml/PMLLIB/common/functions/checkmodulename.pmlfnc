--
--
-- Description:
-- Function to check if passed string is a valid module name
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Module Name
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Flag to indicate valid module name
--
------------------------------------------------------------------------

-- Define function
define function !!checkModuleName(!module is STRING) is BOOLEAN

  !validModule = false

  -- get module data
  !moduleDefaults = !!moduleData()

  -- find module name
  do !i indices !moduleDefaults
    if (!module.upcase() eq !moduleDefaults[!i].name.upcase()) then
      !validModule = true
      break
    endif
  enddo

  return !validModule

endfunction
-- End of function definition for !!checkModuleName
