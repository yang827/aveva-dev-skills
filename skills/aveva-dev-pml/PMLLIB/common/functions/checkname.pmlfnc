-- File:            checkname.pmlfnc
--   Type:          Function Definition
--   Group:         Naming
--     Keyword:     NAME
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Mar 26 12:16:33 WAT 1997
--
--
-- Description:
-- Check the passed name.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name string
--    2   R      STRING      Check for NEW or OLD name
-- Return:
--   [Data Type] [Description]
--    STRING      Processed name, unset is a failure.
--
------------------------------------------------------------------------

-- Define function
define function !!checkName (!name is STRING, !nameType is STRING) is STRING

  -- Initialise Variables
  !returnName       = STRING()
  !newName          = !name

  -- If no name has been supplied
  if(!name.unset() or !name.trim().empty()) then
    -- Null/Blank names are not permissible.
    !!messageFile.warning(143, 008)
    return !returnName
  endif

  -- Process New
  if(!nameType.subString(1,1).upcase() eq 'N') then

    -- Change any replacement characters
    -- Set replacement characters
    -- *
    if(!!ce.type.eq('WORL').not() and !newName.match('*').boolean()) then

      var !star STAR

      -- if STAR has not been set, use CE
      if(!star eq '*') then
        if (!!ce.isNamed) then
          -- "SetStar" is unset, do you want to use the current elements name?
          if(!!alert.confirm(!!messageFile.messageString(143, 10)).boolean().not()) then
            return !returnName
          endif
          !star  = !!ce.flnn
        else
          -- Unable to convert * as current element is unnamed.
          !!messageFile.warning(143, 005, '*', 'current element')
          return !returnName
        endif
      else
        -- remove leading slashes from name
        !star  = !star.trim('L','/')
      endif

      -- Replace the *
      !newName = !newName.replace('*',!star)

    endif

    -- ^
    if(!!ce.type.eq('WORL').not() and !newName.match('^').boolean()) then
      -- Error
      if(!!ce.owner.isNamed.not()) then
          -- Unable to convert ^ as parent element is unnamed.
        !!messageFile.warning(143, 005, '^', 'parent element')
        return !returnName
      endif
      !carat   = !!ce.owner.flnn
      !newName = !newName.replace('^',!carat)
    endif

    -- ~
    if(!newName.match('~').boolean()) then
      -- Error
      if(!!ce.isNamed.not()) then
        -- Unable to convert ~ as current element is unnamed.
        !!messageFile.warning(143, 005, '~', 'current element')
        return !returnName
      endif
      !tilde   = !!ce.flnn
      !newName = !newName.replace('~',!tilde)
    endif

    -- @
    if(!newName.match('$@').boolean()) then
      !!alert.warning('Please do not use $@ in a name.')
       return !returnName
    endif

    -- $
    if(!newName.match('$$').boolean()) then
      !!alert.warning('Please do not use $$ in a name.')
       return !returnName
    endif

    -- Remove all spaces and include a leading slash, if required.
    !newName   = !newName.replace(' ', '')
    if(!newName.subString(1,1) neq '/') then
      !newName = '/' & !newName
    endif

    -- Check if name can be used for new item
    var !useName USENAME $!newName
    if (!useName.boolean().not()) then
    --if (!!exists(!newName, STRING(), STRING())) then
      -- Name (---) already exists.
      !!messageFile.warning(143, 006, !newName)
      return !returnName
    endif

    !returnName = !newName

  else
    -- Old
    -- Convert to dbref

    !dbRef = !newName.dbRef()
    handle any
      !tryName = '/' & !name
      !dbRef = !tryName.dbRef()
      handle any
        -- Undefined name ---
        !!messageFile.warning(143, 007, !newName)
        return !returnName
      endhandle
    endhandle
    !returnName = !dbRef.fullName

  endif

  -- Finish
  return !returnName

endfunction
-- End of function definition for !!checkName
