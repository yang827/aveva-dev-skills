-- Author:          N.Holmes
-- Created:         Fri Feb 14 09:36:54 GMT 1997
--
--
-- Description:
-- Generic collection routine for collecting all items of give types
-- for a specific db element. World will assume all world.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List of elements to collect
--    2   R      STRING      Expression for search criteria
--    3   R      DBREF       Search start element
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of items collected
--
------------------------------------------------------------------------

-- Define function
define function !!collectAllFor (!types is STRING, !expr is STRING, !item is DBREF) is ARRAY

  -- Initialise Variables
  !collection = object COLLECT()

  -- If Item is world, don't set Collection.search
  if(!item.type neq |WORL|) then
    !collection.search = !item

  -- If we have passed a world
  else
    !refNo               = !!ce
    !!ce                 = !item
    !module              = !!module()
    !collection.dbType   = !module.ddlType
    !!ce                 = !refNo
  endif

  -- Set Expression and Types
  !collection.classes    = 'ALL'
  !collection.expression = !expr
  !collection.types      = !types

  -- Return Collected items
  return !!collect(!collection)

endfunction
-- End of function definition for !!collectAllFor
