--
--
-- Description:
-- Generic collection routine for collecting all items of given type
-- within a given volume for a specific db element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List of elements to collect
--    2   R      STRING      Expression for search criteria
--    3   R      POSITION    From Position
--    4   R      POSITION    To Position
--    5   R      ANY         Search start element (or 'WORL' for all db worlds in MDB)
--                           ANY really means STRING or DBREF in this case
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of items collected
--
------------------------------------------------------------------------

-- Define function
define function !!collectAllWithin (!types is STRING, !expr is STRING, !from is POSITION, !to is POSITION, !item is ANY) is ARRAY


  -- Initialise Variables
  !collection = object COLLECT()
  !volume     = object VOLUME()

  -- use passed volume limits
  !volume.from           = !from
  !volume.to             = !to

  -- Set Expression and Types
  !collection.classes    = 'ALL'
  !collection.types      = !types
  !collection.expression = !expr
  !collection.volume     = !volume

  -- If Item is world, don't set Collection.search
  if(!item.objectType() eq 'STRING' and (!item.upcase().trim() eq |WORL| or !item.upcase().trim() eq |WORLD| or !item.trim() eq |/*|)) then
    -- Do NOT set search
  elseif (!item.objectType() eq 'DBREF' and !item.type eq |WORL|) then
    -- Do NOT set search
  else
    -- Do set search
    if (!item.objectType() eq 'STRING') then
      !collection.search = !item.dbref()
      handle ANY
        -- Will not output error
      endhandle
    elseif (!item.objectType() eq 'DBREF') then
      !collection.search = !item
    endif
  endif

  -- Return Collected items
  return !!collect(!collection)

endfunction
-- End of function definition for !!collectAllWithin
