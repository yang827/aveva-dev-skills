--
--
-- Description:
-- Generic collection routine for collecting all member
-- for a specific db element. World will assume all world.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item, members are to be collected from
--    2   R      STRING      Expression for search
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of items collected
--
------------------------------------------------------------------------

-- Define function
define function !!collectMembersOf (!item is DBREF, !expr is STRING) is ARRAY

  -- Initialise Variables
  !collection = object COLLECT()

  -- If Item is world, don't set Collection.search
  if(!item.type neq |WORL|) then
    !collection.search = !item

  -- If we have passed a world
  else
    !collection.dbType = !item.dbType
  endif

  -- Set Expression and Types
  !collection.classes    = 'MEMBERS'
  !collection.expression = !expr

  -- Return Collected items
  return !!collect(!collection)

endfunction
-- End of function definition for !!collectMembersOf
