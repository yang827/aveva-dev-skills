-- File:            colourname.pmlfnc
--   Type:          Function Definition
--   Group:         Colour handling routines
--     Keyword:     COLOUR
--   Module:        common
--   Replaces:      CALLIB RCOLOUR
--
-- Author:          N.Holmes
-- Created:         Thu Mar 20 12:09:07 WAT 1997
--
--
-- Description:
-- Returns the colour name for the passed colour number. If no colour
-- number hs been found, then an unset string will be returned.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour Number
-- Return:
--   [Data Type] [Description]
--    STRING      Colour Name
--
------------------------------------------------------------------------

-- Define function
define function !!colourName (!colNumber is REAL) is STRING

  -- Search ColourSelect.colours list for entry containing passed ColNumber
  --!block   = object BLOCK('!!colourSelect.colours[!evalIndex].code')
  --!numbers = !!colourSelect.colours.evaluate(!block)
  --!x       = !numbers.findFirst(!colNumber)

-- [AK] the above block doesn't work, as !!colourSelect hasn't got a member colours

   !colour = object COLOUR(!colNumber)
   handle ANY
   -- not a valid colour
     !colourName  = STRING()
   elsehandle NONE
     !colourName = !colour.name
   endhandle


   return !colourName

endfunction
-- End of function definition for !!colourName
