-- File:            colournumber.pmlfnc
--   Type:          Function Definition
--   Group:         Colour handling routines
--     Keyword:     COLOUR
--   Module:        common
--   Replaces:      CALLIB RCOLOUR
--
-- Author:          N.Holmes
-- Created:         Thu Mar 20 12:09:42 WAT 1997
--
--
-- Description:
-- Returns the colour number for the passed colour name. If no colour name
-- is found, then the function returns an unset real.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Colour Name
-- Return:
--   [Data Type] [Description]
--    REAL        Colour Number
--
------------------------------------------------------------------------

-- Define function
define function !!colourNumber (!colName is STRING) is REAL

  -- Initialise Variables
  !colour = !colName.upcase()

  -- Search ColourSelect.colours list for entry containing passed ColNumber
  !block   = object BLOCK('!!colourSelect.colours[!evalIndex].name.upcase()')
  !names   = !!colourSelect.colours.evaluate(!block)
  !x       = !names.findFirst(!colour)

  -- Colour name not found
  if(!x.unset()) then
    return REAL()
  endif

  -- Return Colour Name from !!colourSelect.colours[x].code
  return !!colourSelect.colours[!x].code

endfunction
-- End of function definition for !!colourNumber
