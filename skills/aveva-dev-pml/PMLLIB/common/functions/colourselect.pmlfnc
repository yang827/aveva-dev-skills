--
--
-- Description:
-- Action the colour selection
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!colourSelect (!code is REAL)

  -- Set the selected colour
  call !!colourSelectSet(!code)

  -- Don't do anything if there is no action
  if(!!colourSelect.action.set()) then
    if(!!colourSelect.action.empty().not()) then
      -- Action Callback
      if(!!command(!!colourSelect.action).not()) then
        !!alert.error(!!error.text)
      endif
    endif
  endif

endfunction
-- End of function definition for !!colourSelect
