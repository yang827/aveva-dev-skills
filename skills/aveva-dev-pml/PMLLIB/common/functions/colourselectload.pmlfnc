-- Created:         Mon Feb 10 16:47:01 GMT 1997
--
--
-- Description:
-- Loads the ColourSelect form with the appropriate actions, titles, etc
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action to carry out when button select
--    2   R      STRING      Form title string
--    3   R      REAL        Colour code number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!colourSelectLoad (!action is STRING, !title is STRING, !code is REAL)

  -- set default colour
  if (!code.unset()) then
    var !col COLOUR NUMBER GREY
    !colCode = !col.real()
  else
    !colCode = !code
  endif

  -- check here for the colour selection form and load it if necessary.
  if (undefined(!!colourSelect)) then
    pml load form !!colourSelect
  endif

  -- Set Colour Code
  call !!colourSelectSet(!colCode)
  -- set colour to return to when reset button clicked
  !!colourSelect.original = !colCode

  -- Set the form title
  if(!title.empty()) then
    !!colourSelect.formTitle = 'Colour Selection'
  else
    !!colourSelect.formTitle = !title
  endif

  -- Set Action
  !!colourSelect.action = !action

  -- Show form
  show !!colourSelect

endfunction
-- End of function definition for !!colourSelectLoad
