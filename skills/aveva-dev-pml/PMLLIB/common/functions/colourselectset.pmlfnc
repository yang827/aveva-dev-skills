-- Description:
-- Initialisation for colour selection form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!colourSelectSet (!code is REAL)

  -- Set Colour Code
  !!colourSelect.setColour = !code

  !colour = object COLOUR(!code)

  -- Set display colour
  !!colourSelect.currentColour.val        = !colour.string()
  !!colourSelect.currentColour.background = !colour.code

endfunction
-- End of function definition for !!colourSelectSet
