--
-- Description:
-- Save the current lists to a file in the PDMSUSER directory
--
------------------------------------------------------------------------
--
-- Function Type:   Function
--
------------------------------------------------------------------------

-- Define function
define function !!comAddCurClaim()

  VAR !claimList SPLIT CLAIMLIST
  if (!claimList[1] eq 'none') then

    return error 1 'No items in claimlist'

  endif

  -- Find out the names of the current lists
  !listNames = !!cdcList.name.dText
  !listNum   = !!cdcList.name.rText

  if (!listNames[1] eq 'No list') then

   -- If no lists defined

   !listNames[1] = 'claimlist1'
   !listNum[1]   = '1'
   !newNum       = '1'

  else
    -- Make a new list called claimlist(n) and add it to the list

    do !x to 100
      if (!listNames.findFirst('claimlist$!x').unset()) then
        !listNames.append('claimlist$!x')
        !arraySize = arraySize(!listNames)
        !newNum    = !arraySize.string()
        !listNum.append(!newNum)
        break
      endif
    enddo
  endif

  !!cdcList.name.dText = !listNames
  !!cdcList.name.rText = !listNum
  !!cdList             = !listNames

  !tempList = !claimList

  -- This needs to be converted to database references for the list gadget to work correctly

  !block       = object BLOCK('!tempList[!evalIndex].dbRef().string()')
  !listDbRefs  = !tempList.evaluate(!block)

  !!cdList$!newNum = !listDbRefs

  -- Reinitialise the list form
  $M "%PDMSUI%/CLIB/FILES/ILIST"

endfunction
-- End of function definition for !!comAddCurClaim
