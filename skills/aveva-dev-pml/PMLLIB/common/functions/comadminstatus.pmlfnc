--
--
-- Description:
-- Check if user has administrator status for a module
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Return:
--   [BOOLEAN] [TRUE is user has admin status in current module]
--
------------------------------------------------------------------------

-- Define function
define function !!comAdminStatus() is BOOLEAN

  !session = current session
  !teamList = !session.user().teamList()
  !teamList = !teamList.evaluate(object BLOCK('!teamList[!evalIndex].name'))

  -- check if current user is in team MASTER or is a free user
  if(!teamList.findFirst('MASTER').set() OR !teamList.findFirst('(Free)').set())then
    !returnValue = true
  else
    -- check if current user is in a module specific administration team

    -- get module data
    !module = !!module()

    -- check for special case modules
    if (!module.appName.upcase() eq 'DRAFT') then
      !adminTeam = 'DRAFTADMIN'
    elseif (!module.appName.upcase() eq 'PARAGON') then
      !adminTeam = 'CATADMIN'
    else
      !adminTeam = !module.appKey.upcase() + 'ADMIN'
    endif

    if (!teamList.findFirst(!adminTeam).set()) then
      !returnValue = true
    else
      !returnValue = false
    endif
  endif

  return !returnValue

endfunction
-- End of function definition for !!comAdminStatus
