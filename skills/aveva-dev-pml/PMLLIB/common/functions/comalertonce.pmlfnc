--
--
-- Description:
-- Function to load !!alertOnce form
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Question you would like to display]
--   [2] [RW]   [BOOLEAN]   [Which answer has been pressed]
--   [3] [R]    [STRING]    [Name of global variable to trigger form to show]
--   [4] [R]    [FORM]      [Name of form to show]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!comAlertOnce(!question is STRING,  !answer is BOOLEAN, !questGlobal is STRING, !formType is STRING)

!form = !!alertOnce$!formType
handle ANY
-- load the alert form if not already loaded
  pml load form !!alertOnce$!formType
  !form = !!alertOnce$!formType
endhandle
-- initialise confirm form for this question
   !form.question.val       = !question
   !form.formTitle          = !formType.substring(1,1).upcase() + !formType.substring(2).lowcase()
   !form.globalSwitch       = '$!questGlobal'

   if(undefined($!questGlobal) or defined($!questGlobal)  and not($!questGlobal)) then
      waiton _$!form at xr0.4 yr0.45
   endif

     !answer = !form.confirm
     handle ANY
      -- when its not a confirm form
      !answer = TRUE
     endhandle

endfunction
-- End of function definition for !!comAlertOnce(STRING, BOOLEAN, STRING)
