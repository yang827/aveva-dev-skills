--
--
-- Description:
-- uses a combo box to populate a text gadget
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [1] [R] [GADGET] [text gadget that combo box is linked to]
--   [2] [R] [STRING] [title for combo box]
--   [3] [R] [ARRAY]  [data for combo box]
--
------------------------------------------------------------------------

-- Define function
define function !!comboBox(!textGadget is GADGET, !title is STRING, !data is ARRAY)

  -- check if the combo box form is defined
  if (undefined(!!comboBox)) then
    pml load form !!comboBox
  endif

  -- link the combo box to the text gadget
  !!comboBox.textGadget = !textGadget

  -- set the combo box titles
  !!comboBox.formTitle = !title
  !!comboBox.iconTitle = !title

  -- populate the list
  !!comboBox.list.dText = !data

  -- show the form
  show !!comboBox

endfunction
-- End of function definition for !!comboBox
