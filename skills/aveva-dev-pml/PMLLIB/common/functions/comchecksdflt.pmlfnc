define function !!comChecksDflt()

  !module = !!module()

  if (!module.appKey.upcase() eq 'DES') then

    !check = object CHECK()
    !check.name     = 'SCTNCONNECT'
    !check.title    = 'End Connections'
    !check.class    = 'Steelwork'
    !check.group    = 'Sections'
    !check.types    = 'SCTN'
    !check.function = '!!cadcSctnConn'
    !check.module   = 'Design'
    !check.fileType = 'CADC'
    !!addCheckerCheck(!check)

  endif

endfunction
-- End of function definition for !!comChecksDflt
