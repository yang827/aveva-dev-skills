--
-- Description:
-- Function to call the common combination list gadget functionality
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!comCombi(!title is STRING, !gadget is GADGET, !arrayOfValues is ARRAY)

-- load the form if it has not been loaded before
   if(undefined(!!comCombi)) then
      pml load form !!comCombi
   endif

   !!comCombi.title         = !title
   !!comCombi.gadget        = !gadget
   !!comCombi.arrayOfValues = !arrayOfValues

   show !!comCombi

endfunction
-- End of function definition for !!comCombi()
