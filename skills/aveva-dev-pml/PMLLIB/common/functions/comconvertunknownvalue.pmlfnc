-- File:            comconvertunknownvalue.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     UNITS
--   Module:        common
--  Created:         Thu Mar 11 13:53:00 2010
--
-- Description:
-- Convert given real value to requested unit. If value is not dimensioned
-- it is assumed to be a value in the requested unit, so same value
-- is returned with unit applied.
-- If value is already dimensioned then it is returned unchanged.
-- In this case the value must have the same dimension as the requested unit.
-- This function is intended for converting PARA, DESP, ANSW etc. that may
-- or may not have units applied.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      REAL        Original value (with or without dimension)
--    2   R      STRING      units for undimensioned value
-- Return:
--   [REAL] [Converted dimensioned value]
--
------------------------------------------------------------------------
define function !!comConvertUnknownValue(!value is REAL, !defaultUnits is STRING) is REAL

  if( !defaultUnits.empty() ) then
    -- original value without units
    !returnValue =  !value.value()
  elseif( !value.units().isNull() ) then
    -- value without units converted
    !returnValue = object REAL(!value.string() + ' ' + !defaultUnits)
    handle any
      !returnValue = !value
    endhandle
  else
    -- value with units simply returned
    !returnValue = !value
  endif

  return !returnValue

endfunction
-- End of function
