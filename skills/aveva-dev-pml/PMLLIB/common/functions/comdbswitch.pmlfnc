-- Description:
-- Control navigation around hierarchy
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!comDbSwitch(!dbType is STRING)

  -- get the current dbtype and store current element
  !!$!!<ce.dbType>CE = !!ce

  -- switch to new db type
  if (undefined(!!$!<dbType>CE)) then
    !!ce = !!dbeWorldGet(!dbType)
  else
    !!ce = !!$!<dbType>CE
    handle any
      !!ce = !!dbeWorldGet(!dbType)
    endhandle
  endif

endfunction
-- End of function definition for !!comDbSwitch
