define function !!comExprBuilder(!formTitle is STRING, !desps is ARRAY, !exprs is ARRAY, !lnids is ARRAY, !gadget is GADGET)

  if (undefined(!!comExprBuilder)) then
    pml load form !!comExprBuilder
  endif

  !!comExprBuilder.show()

  !!comExprBuilder.init(!formTitle, !desps, !exprs, !lnids, !gadget)

endfunction
-- End of function definition for !!comExprBuilder
