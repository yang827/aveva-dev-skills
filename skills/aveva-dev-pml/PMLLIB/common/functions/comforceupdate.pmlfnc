--
--
-- Description:
-- function to force an update on a template that has been instanced,
-- with subsequent changes made in the tpwl
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!comForceUpdate()

 !property = object COMPROP(!!ce)
 handle any
   !!alert.error('You must be at an element that owns a TMPL')
   return
 endhandle


 !property.forceUpdate(true)
 !property.setProperties()

 !property.deleteObject()
 !property.delete()

endfunction
-- End of function definition for !!comForceUpdate
