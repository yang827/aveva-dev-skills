--
--
-- Description:
-- Function to find out if a user form exists
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [FORM name to find]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [True if the form is found in the index]
--
------------------------------------------------------------------------

-- Define function
define function !!comFormExist(!form is STRING) is BOOLEAN

!return = FALSE

-- find out if its an old form (PML1) or new form (PML2)
   if(!form.substring(1,1).eq('_')) then
      -- old form
      var !unusedStatus form $!form display
      handle ANY
         !return = FALSE
         !!error.text = 'An existing form must be specified, and loaded.'
      elsehandle NONE
         !return = TRUE
         !!error.text = 'OK'
      endhandle
   elseif(!form.substring(1,2).eq('!!')) then
      -- new form
      !fileName = !form.after('!!')
      !unused = !!pml.getpathname(!fileName & '.pmlfrm')
      handle ANY
      -- file not makes the above line error
         !return = FALSE
         !!error.text = 'Form must exist in PMLLIB.'
      elsehandle NONE
         !return = TRUE
         !!error.text = 'OK'
         return !return
      endhandle
   else
    !!error.text = 'Form name entered is not the correct format, include "!!" at the beginning of the form name'
    !return = FALSE
   endif

return !return

endfunction
-- End of function definition for comFormExist(STRING)
