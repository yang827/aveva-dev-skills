--
--
-- Description:
-- function to measure a distance and put the result into a text gadget
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      ARRAY       Array of strings to populate list gadget
--    2   R      REAL        Height of list gadget
--    3   R      STRING      Form title
-- Return:
--   [FORM] [Form that has been created by this function]
--
------------------------------------------------------------------------
define function !!comGadgetMeasure(!function is STRING, !gadget is GADGET, !description is STRING, !prompt is STRING)

  !packet = object EDGPACKET()
  !packet.defineMeasure('DISTANCE')
  !packet.description = !description
  !packet.pickPacket.prompt = !prompt

  if (!function.set()) then
    !packet.action = !function + !gadget.fullName() + ', !this.return[1].length())'
  else
    !packet.action = !gadget.fullName() + '.val = !this.return[1].length()'
  endif

  !!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!comGadgetMeasure
