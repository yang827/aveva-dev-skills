--
-- Author:          C.Brown
-- Created:         Thu Dec 4 15:31:50 GMT 1997
--
--
-- Description:
-- finds the options file in system and user areas
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [1] [R] [STRING] [filename to search for]
-- Return:
--   [ARRAY] [First element holds system file as FILE object,  ]
--           [second element holds user file as FILE object.   ]
--
------------------------------------------------------------------------

-- Define function
define function !!comGetOptFiles(!filename is STRING) is ARRAY

  -- Get all locations of options file, this will return an
  -- array of objects, one object for each location of the
  -- options file, valid locations are CADC, PDMS, PROJ, USER
  !files = !!searchPaths(!filename)

  -- from the list of options files, extract the user options file
  -- and the last system options file

  !fileIndex = !files.size()

  !returnArray = ARRAY()

  do !unusedI from 1 to !files.size()

    if (!files[!fileIndex].defaultType eq 'USER')  then
      -- store the location and name of the users default file
      !returnArray[2] = !files[!fileIndex].file
    else
      !returnArray[1] = !files[!fileIndex].file
      break
    endif

    !fileIndex = !fileIndex - 1

  enddo


  return !returnArray

endfunction
-- End of function definition for !!comGetOptFiles
