--
--
-- Description:
-- A function to confirm and do a check work
-- .
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN    Confirmed yes or no
--
------------------------------------------------------------------------
-- Define function
define function !!comGetWork() is BOOLEAN

  -- Prompt the user
  !answer  = !!alert.confirm(|Get work - Are you sure?|)
  -- Get work if yes
  if (!answer.boolean()) then
    GETWORK
    -- Additional code at 11.5.SP1 for Repair functionality
    -- First check in case we are read only
    !memory = !!ce
    GOTO FRSTW SYST
    var !dbWrite DBWRITE
    if (!dbWrite.boolean()) then
      call !!admRepair(false)
    endif
    !!ce = !memory
    handle ANY
    endhandle
  endif

  return !answer.boolean()

endfunction
-- End of function definition for !!comGetWork
