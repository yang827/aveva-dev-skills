--     Keyword:     INPUT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Thu Aug 27 9:29:13 BST 1998
--
-- Description:
-- standard GUI input to select from a list of values
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      STRING      Form title
--    2   R      STRING      List gadget title
--    3   R      REAL        Height of list gadget
--    4   R      ARRAY       Array of strings to populate list gadget
--    5   R      STRING      Initial selection
-- Return:
--   [FORM] [Form that has been created by this function]
--
------------------------------------------------------------------------
define function !!comListInput(!formTitle is STRING, !gadgetTitle is STRING, !height is REAL,  !dText is ARRAY, !value is STRING) is STRING

  setup form !!comListInput blocking

    member .okFlag is BOOLEAN

    !!comListInput.formTitle = !formTitle

    -- get list width
    !width = MAX(!dText.width(), 12)

    if (!height eq 1) then
      option .list '$!<gadgetTitle>' at xmin ymax+0.2 width $!<width>
    else
      list .list '$!<gadgetTitle>' at xmin ymax+0.2 width $!<width> height $!<height>
    endif

    button .ok '  OK  ' at xmin ymax ok
    button .cancel 'Cancel' at xmax form-size ymin cancel

    !!comListInput.list.callback = '!this.ok.setFocus()'

    !!comListInput.okCall = '!this.okFlag = true'
    !!comListInput.cancelCall = '!this.okFlag = false'

    !!comListInput.list.dText = !dText
    !!comListInput.list.select('DTEXT', !value)
    handle any
      !!comListInput.list.val = 1
    endhandle

  exit

  -- show the input form
--  $p show the form
  waiton !!comListInput
--  $p finished waiton

  -- if (!!comListInput.okFlag) then
    !selection = !!comListInput.list.selection('DTEXT')
  -- else
  --   !selection = STRING()
  -- endif

  return !selection

endfunction
-- End of function definition for !!comListInput
