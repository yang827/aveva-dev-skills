--
--
-- Description:
-- create and load global option object
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [1] [R] [ANY] [object to load options from]
--
------------------------------------------------------------------------

-- Define function
define function !!comLoadGlobal(!object is ANY)

  !object.globalInstance()
  !object.load()
  !object.copyToGlobal()

endfunction
-- End of function definition for !!comLoadGlobal
