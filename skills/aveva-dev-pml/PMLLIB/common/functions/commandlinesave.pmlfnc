--
-- Description:
-- Function to savework automatically before each command
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!commandLineSave()

-- Savework in case the command you type in on the command
-- line crashes PDMS.

   SAVEWORK

-- Now execute the command actually typed in.

   $!!cadcBth.cadcCom.val

endfunction
-- End of function definition for !!commandLineSave
