--
--
-- Description:
--
--   Load standard CADCBTH command with popup menu
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!commandMenu()

  -- Initialise Variables
  !form   = !!cadcBth

  -- Check for existence of popup
  if(defined(!form.popupMenu)) then
    !menu = !form.popupMenu
    !menu.clear()
  else
    !menu = !form.newMenu('popupMenu')
  endif

  -- Define menu
  !menu.add('callback', 'Clear',          'alpha request clear')
  !menu.add('separator')
  !menu.add('menu',     'Trace On',       'traceMenu')
  !menu.add('callback', 'Trace Off',      '$$r')
  !menu.add('separator')
  !menu.add('menu',     'Start log file', 'logMenu')
  !menu.add('callback', 'Close log file', 'alpha log end')

  -- Check for existence of trace
  if(defined(!form.traceMenu)) then
    !menu = !form.traceMenu
    !menu.clear()
  else
    !menu = !form.newMenu('traceMenu')
  endif

  !menu.add('callback', 'Full trace (screen)', '$$r110')
  !menu.add('callback', 'Full trace (shell)',  '$$r100')
  !menu.add('callback', 'Entry/Exit',          '$$r66')

  -- Check for existence of log file
  if(defined(!form.logMenu)) then
    !menu = !form.logMenu
    !menu.clear()
  else
    !menu = !form.newMenu('logMenu')
  endif

  !menu.add('callback', 'log',  'alpha log "log" over')
  !menu.add('callback', 'logA', 'alpha log "logA" over')
  !menu.add('callback', 'logB', 'alpha log "logB" over')
  !menu.add('callback', 'logC', 'alpha log "logC" over')

  -- Apply popup to gadget
  !form.cadccom.setPopup(!form.popupMenu)

endfunction
-- End of function definition
