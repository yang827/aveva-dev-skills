--   Group:         General Application

--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          I.Clark
-- Created:         Mon May 17 9:46:31 BST 1999
--
--
-- Description:
-- A function to provide the functionality of REORDER command, simply!
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     REAL         the first index
--    2    R     REAL         the second index
--    3    R     DBREF        the dbref which requires some of its members
--                            to be swapped!
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!comMemberSwap(!x is REAL, !y is REAL, !parent is DBREF)
  !prev = !!ce
  !!ce = !parent
  !members = !!ce.mem
  !lastElement = !members.size()
  -- Quick check to make sure this is a valid call
  if( (!lastElement LEQ 1) OR (NOT !x.between(1, !lastElement)) OR (NOT !y.between(1, !lastElement)) OR (!x EQ !y) )then
    golabel /FINISH
  endif
  if( !x LT !y )then
    !pos = !x + 1
    REORDER $!y BEFORE $!x
    REORDER $!pos AFTER $!x
  elseif(!x GT !y)then
    !pos = !y + 1
    REORDER $!x BEFORE $!y
    REORDER $!pos AFTER $!x
  endif
  label /FINISH
  !!ce = !prev
endfunction
-- End of function definition for !!comMemberSwap
