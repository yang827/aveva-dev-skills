--
--
-- Description:
-- Create Macro to merge any sessions that have a Default session comment.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!comMergeSaves()

-- Find out the time and date now
var !clockStr CLOCK
!clockArr = !clockStr.split()
!time = !clockArr[4]
!date = !clockArr[1] & ' ' & !clockArr[2] & ' ' & !clockArr[3]

-- Set Session number to the time and date now
var !sessDnum SESSION ON $!time $!date
!sessDnumReal = !sessDnum.real()
!sessNum = !sessDnumReal

-- Database name
!dbName = DBNAME

-- Write a macro to run in ADMIN
!file = !!file('MergeSaves.mac')
!file.open('WRITE')
!file.writeRecord('-- Macro to merge sessions that have the Default session comment ')
!file.writeRecord(' ')

-- initialise some local variables
!in = 1
!ip = 1
!ipMemory = -1
!inMemory = 1

-- find the highest numbered commented session
do !l from 1 to !sessNum
 var !sessComment SESSC $!l
 handle any
   -- Already merged
   skip
 endhandle
 if (!sessComment eq 'Default session comment') then
   break
  else
   !inMemory = !l
  endif
enddo

-- Loop through all the session numbers in order to identify
-- all the commented session numbers that are interrupted
-- by non commented sessions. ie sessions created by savework.
-- The aim is to write a macro that will merge all the saveworks
-- into the key commented sessions.
-- --------------------------------------------------------------
do !i from 1 to !sessNum
  if (!in gt !i) then
    -- must have got past this session.
    skip
  endif
  var !sessCom SESSC $!i
  handle any
    -- Already merged
    skip
  endhandle

  -- not interested in savework session numbers
  if (!sessCom eq 'Default session comment') then
    skip
  endif

  -- redefine variable for next and previous sessions
  !ip = !i - 1
  !in = !i + 1

  -- jgap is used to for numerical difference between prev and
  -- current session when some sessions are already merged.
  !jgap = 1

  -- Find the previous session number that exist with a
  -- session comment not eq 'Default session comment'.
  do !j from !ip to 1 by -1
    var !sessComp SESSC $!j
    handle any
      -- Already merged
      !jgap = !jgap + 1
      skip
    endhandle
    if (!j eq 1 or !j eq !ipMemory) then
      break
    endif
    if (!sessComp neq 'Default session comment') then
      if ((!j + !jgap) neq !i) then
        -- this is not done if there are no intermediate default comments ie 200 and 201 both commented.
        !file.writeRecord('after session ' & !j )
        !ipMemory = !j
      endif
      break
    endif
  enddo

  -- kgap is used to for numerical difference between next and
  -- current session when some sessions are already merged.
  !kgap = 1

  -- Find the next session number that exist with a
  -- session comment not eq 'Default session comment'.
  do !k from !in to !sessNum by 1
    var !sessComn SESSC $!k
    handle any
      -- Already merged
      !kgap = !kgap + 1
      skip
    endhandle
     if (!i leq 1 or !k gt !sessNum) then
       break
    endif
    if (!sessComn neq 'Default session comment') then
      if ((!k - !kgap) neq !i) then
        -- this is not done if there are no intermediate default comments ie 200 and 201 both commented.
        !file.writeRecord('merge changes ' & !dbName & ' before session ' & !k & ' $$')
        !inMemory = !k
        !in = !k
      endif
      break
    endif
  enddo

enddo

!file.writeRecord('merge changes ' & !dbName & ' after session ' & !inMemory )
!file.writeRecord(' ')
!file.writeRecord('-- End of File ')
!file.close()

endfunction
-- End of function definition for !!comMergeSaves
