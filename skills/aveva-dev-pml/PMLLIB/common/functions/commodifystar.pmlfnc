--
--
-- Description:
-- Common function to add a * to a form title to indicate form is modified.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     FORM       Form to have title modified
--    2    R     BOOLEAN    Add or Remove *
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!comModifyStar(!form is FORM, !star is BOOLEAN)

  if (!star) then
    !form.formTitle = !form.formTitle.before('*') & '*'
  else
    !form.formTitle = !form.formTitle.before('*')
  endif

endfunction
-- End of function definition for !!comModifyStar
