--
--
-- Description:
-- Returns all specified common message files as an array.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Message file names, without their extension.
--
------------------------------------------------------------------------

-- Define function
define function !!commonMsgFiles() is ARRAY

  !returnArray = ARRAY()
  !returnArray.append('gen01')
  !returnArray.append('db02')
  !returnArray.append('adm03')
  !returnArray.append('lst04')
  !returnArray.append('edg05')
  !returnArray.append('posori07')
  !returnArray.append('gph08')
  !returnArray.append('chk10')
  !returnArray.append('spec11')
  !returnArray.append('rule12')
  return !returnArray

endfunction
-- End of function definition for !!commonMsgFiles
