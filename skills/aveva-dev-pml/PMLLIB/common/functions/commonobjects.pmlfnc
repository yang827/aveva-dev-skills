-- Define function
define function !!commonObjects()

  -- Load common objects
  call !!loadObject('formats')
  call !!loadObject('volume')
  call !!loadObject('arrow')
  call !!loadObject('check')
  call !!loadObject('checkreturn')
  call !!loadObject('collect')
  call !!loadObject('file')
  call !!loadObject('defaultfile')
  call !!loadObject('box')
  call !!loadObject('clock')
  call !!loadObject('colour')
  call !!loadObject('module')
  call !!loadObject('vector')
  call !!loadObject('finiteline')
  call !!loadObject('directory')
  call !!loadObject('dbreftext')
  call !!loadObject('formdata')
  call !!loadObject('message')
  call !!loadObject('messages')
  call !!loadObject('pickededge')
  call !!loadObject('pickedline')
  call !!loadObject('store')
  call !!loadObject('storegroup')
  call !!loadObject('modulebardata')
  call !!loadObject('pdmssettings')
  call !!loadObject('speclink')
  call !!loadObject('specdata')

endfunction
-- End of function definition for !!commonObjects
