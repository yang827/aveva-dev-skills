--
-- Description:
-- Control navigation around hierarchy
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Colour code number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!comNavigate(!action is STRING)

  if (!action.upcase() eq 'NEXT') then
    if (!!ce.type.upcase() eq 'WORL') then
      FIRST MEMBER
      handle any
      endhandle
    else
      NEXT
      handle any
      endhandle
    endif
  elseif (!action.upcase() eq 'PREVIOUS') then
    PREVIOUS
    handle any
    endhandle
  elseif (!action.upcase() eq 'OWNER') then
    OWNER
    handle any
    endhandle
  else
    FIRST MEMBER
    handle any
    endhandle
  endif

endfunction
-- End of function definition for !!comNavigate
