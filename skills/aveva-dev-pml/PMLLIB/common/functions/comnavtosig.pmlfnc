--
-- Description:
-- If there is a significant element navigation level then
-- return the significant element
--
------------------------------------------------------------------------
define function !!comNavToSig(!element is DBREF) is DBREF

  -- check for significant element navigation level

  -- currently, only the equipment application supports this
  -- functionality.  When more applications require this
  -- an object will be created to define significant element levels

  !sigNavLevel = ''
  if (!!appcntrl.currentApp() eq 'EQUI') then
    !sigNavLevel = !!appDesMain.mtbNavigation.selection()
  endif

  !sigTypes = !sigNavLevel.split()
  !owningElement = object DBREF()
  if (!sigTypes.set()) then
    !owningElement = !!dtbOwnerOfTypes(!element, !sigTypes)
  endif

  if (!owningElement.unset()) then
    !owningElement = !element
  endif

  return !owningElement

endfunction
-- End of function definition for !!comNavToSig
