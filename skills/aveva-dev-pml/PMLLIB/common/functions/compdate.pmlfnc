--
-- Author:          Steve Wilson
-- Created:         17 June 2001
--
--
-- Description:
-- Builds the form for selecting Change Comparison Date via STAMP elements
--
------------------------------------------------------------------------
define function !!compDate(!callType is STRING, !updateType is STRING)


  Layout form !!compDate dialog at xr0 yr0
  --setup form !!compDate at xr0 yr0

    !this.formTitle = 'Set Comparison Date'
    !this.initCall = |!this.formMethods.init('$!callType','$!updateType')|
    !this.cancelCall = '!this.formMethods.cancel()'

    -- Current Element
    if (!callType.eq('MENU') and !updateType.neq('SET')) then

      -- CE
      button .ce |CE| tooltip 'Current Element' call |!this.formMethods.ce()|

      -- Element name
      para .type width 4 lines 1
      para .name width 37 lines 1

      -- Frame
      frame .frame | Time & Date | at xmin.ce ymax

    else

      -- Frame
      frame .frame

    endif

      -- Stamp display mode
      para .modText at ymax+0.2 text |Display|
      option .mode at xmin ymax tooltip 'Display Mode' call |!this.formMethods.displayMode('$!updateType')| width 4

      -- Stamp list
      list .stampList at xmax+1 ymin.modText tooltip 'Use a Stamp Date' call |!this.formMethods.stampDate('$!callType')| width 35 height 5
      -- Define headings
      !a[1] = 'Stamp:'
      !this.stampList.setHeadings(!a)

      -- Now
      button .now |Now| at xmin.modText ymax-size call |!this.formMethods.stampDate('NOW')|

      -- Date format
      -- Hour
      para .dPara at xmin.modText ymax.stampList+0.2 text |Date: |
      button .upH at xmax ymin-0.05 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.hour,'UP','HOUR')|
      button .dnH at xmin ymax-0.05 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.hour,'DOWN','HOUR')|
      text .hour at xmax-0.1 ymin.upH+0.1 tooltip 'Hour' call |!this.formMethods.checkValue(!this.hour,'HOUR')| width 2 is STRING

      -- Mins
      para .colon at xmax ymin text |:|
      text .mins at xmax ymin tooltip 'Minutes' call |!this.formMethods.checkValue(!this.mins,'MINS')| width 2 is STRING
      button .upM at xmax+0.2 ymin-0.1 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.mins,'UP','MINS')|
      button .dnM at xmin ymax-0.05 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.mins,'DOWN','MINS')|

      -- Day
      option .day at xmax+1 ymin.mins tooltip 'Day' call |!this.formMethods.storeDate() !this.formMethods.selectStamp()| width 2

      -- Month
      option .month at xmax+1 ymin tooltip 'Month' call |!this.formMethods.month(true)| width 10

      -- Year
      text .year at xmax+1 ymin tooltip 'Year' call |!this.formMethods.checkValue(!this.year,'YEAR')| width 4 is REAL
      button .upY at xmax+0.2 ymin-0.1 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.year,'UP','YEAR')|
      button .dnY at xmin ymax-0.05 pixmap height 3 width 7 call |!this.formMethods.upDown(!this.year,'DOWN','YEAR')|

    exit

    -- Action
    if (!callType.eq('MENU') and !updateType.eq('DESIGN')) then
      button .apply |Update Design| at xmin form ymax+0.3 tooltip 'Set the Date' call |!this.formMethods.apply('$!callType','$!updateType')|
    elseif (!callType.eq('MENU') and !updateType.eq('ANNO')) then
      button .apply |Update Annotation| at xmin form ymax+0.3 tooltip 'Set the Date' call |!this.formMethods.apply('$!callType','$!updateType')|
    elseif (!callType.eq('MENU') and !updateType.eq('ALL')) then
      button .apply |Update All| at xmin form ymax+0.3 tooltip 'Set the Date' call |!this.formMethods.apply('$!callType','$!updateType')|
    else
      button .apply |OK| at xmin form ymax+0.3 tooltip 'Set the Date' call |!this.formMethods.apply('$!callType','$!updateType')| ok
    endif
    button .cancel |Cancel| at xmax form-size ymin tooltip 'Close' call |!this.formMethods.cancel()| cancel

    -- Members
    member .formMethods is COMPDATE
    member .callingForm is FORM
    member .ceRef is DBREF

    -- Set form in object
    !this.formMethods.form = !this

    -- Pixmaps
    !this.upH.addPixmap(!!PML.getPathName('uparrow7x3.png'))
    !this.dnH.addPixmap(!!PML.getPathName('downarrow7x3.png'))
    !this.upM.addPixmap(!!PML.getPathName('uparrow7x3.png'))
    !this.dnM.addPixmap(!!PML.getPathName('downarrow7x3.png'))
    !this.upY.addPixmap(!!PML.getPathName('uparrow7x3.png'))
    !this.dnY.addPixmap(!!PML.getPathName('downarrow7x3.png'))

    -- Populate Mode gadget
    !!admStampSortGadg(!this.mode,'SHORT')

    -- Populate Month gadget
    !text[1] = |January|
    !text[2] = |February|
    !text[3] = |March|
    !text[4] = |April|
    !text[5] = |May|
    !text[6] = |June|
    !text[7] = |July|
    !text[8] = |August|
    !text[9] = |September|
    !text[10] = |October|
    !text[11] = |November|
    !text[12] = |December|
    !this.month.dtext = !text

  exit
  -- End of form definition

  -- For setting the comparison date directly
  if (!updateType.eq('SET')) then
    !!compDate.show()
  endif

endfunction
-- End of function definition
