--
--  Description:     function for batch printing on design module
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!comPltBatchPrint(!actionType is STRING, !plotFileList is ARRAY)

  if (!actionType eq 'SETUP') then

    -- Write PDMS Plot Service to a temporary file
    do !i from 1
      !temporaryFile = object FILE('%PDMSWK%/tempFileToPrintSetup' & !i.string())
      if (!temporaryFile.exists()) then
        -- loop around again until we have one that doesn't exist
      else
        break
      endif
    enddo

    !fileText = ARRAY()
    -- Write the PDMS Plot Service commands to the temporary Job file
    !fileText.append(|ClearPrintList|)
    !fileText.append(|ShowPrintSetup|)
    !fileText.append(|EndJobAndDelete|)

    -- Write the files to print to a temporary file
    !temporaryFile.writeFile('OVERWRITE', !fileText)
    !temporaryFile.close()

    syscom 'PlotServCmd Job $!temporaryFile &'
    return
  endif

  !fileArrayToPrint = object ARRAY()
  do !pltFile values !plotFileList
    !fileToPrint = object FILE(!pltFile)

    if (!fileToPrint.exists().not()) then
      skip
    endif

    !fileArrayToPrint.append(!pltFile)
  enddo

  if (!fileArrayToPrint.unset()) then
    return
  endif

  -- Write PDMS Plot Service to a temporary file
  do !i from 1
    !temporaryFile = object FILE('%PDMSWK%tempFileToPrint' & !i.string())
    if (!temporaryFile.exists()) then
      -- loop around again until we have one that doesn't exist
    else
      break
    endif
  enddo

  !fileText = ARRAY()
--  !fileText.append(|ShowPrintSetupOnce|)
  !fileText.append(|ClearPrintList|)

  do !plotFile values !fileArrayToPrint
    !fileText.append(|AddPlotFile "| & !plotFile & |"|)
  enddo

  !fileText.append(|PrintListAndClear|)
  !fileText.append(|EndJobAndDelete|)

  -- Write the files to print to a temporary file
  !temporaryFile.writeFile('OVERWRITE', !fileText)
  !temporaryFile.close()
  !!PMLTRANSCFILE('$!temporaryFile', '', '', '', '')
  --syscom 'PlotServCmd startLog'
  --$P syscom 'PlotServCmd Job $!temporaryFile &'
  syscom 'PlotServCmd Job $!temporaryFile &'
endmethod
