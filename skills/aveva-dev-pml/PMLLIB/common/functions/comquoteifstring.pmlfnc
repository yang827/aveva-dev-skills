--
-- Author:          C.Brown
-- Created:         Thu Dec 4 15:31:50 GMT 1997
--
--
-- Description:
-- if the value is a real then return it as an unquoted string
-- otherwise return the value as a quoted string
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [1] [R] [ANY] [value to convert to string]
-- Return:
--   [STRING] [string to write to options file]
--
------------------------------------------------------------------------

-- Define function
define function !!comQuoteIfString(!value is ANY) is STRING

  if (!value.objectType() eq 'STRING') then
    !tempString = !value.replace('|', '||')
    !string = '|' + !tempString + '|'
  else
    !string = !value.string()
  endif

  return !string

endfunction
-- End of function definition for !!comQuoteIfString
