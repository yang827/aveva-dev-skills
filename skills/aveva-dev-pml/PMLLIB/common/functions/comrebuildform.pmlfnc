--
-- Description:
-- Function to Rebuild the form passed
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [FORM]      [form name to build]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [Of forms displayed]
--
------------------------------------------------------------------------

-- Define function
define function !!comRebuildForm(!form is FORM)

-- initialise variables
   !formName = !form.fullName()
   !showForm = !form.shown()

-- kill the old form
   kill $!formName
-- show the new form
   show $!formName

   return

endfunction
-- End of function definition for comRebuildForm(FORM)
