--   Group:         Common
--
--    Keyword:      Representation
--    Module:       General
--
-- Author:          M.Lewis
-- Created:         Wed Jan 21   14:09:01  2009
--
-- Description:
-- Apply current representation rule set to drawlist or reset to default representation
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action to perform: apply or reset
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!comRepRules(!action is STRING)

  -- Load the last used rule set if there was one
  if (undefined(!!comRepRules)) then
    pml load form !!comRepRules
  endif

  -- Perform the action
  if (!action.lowcase() eq |apply|) then
    !!comRepRules.apply()
  elseif (!action.lowcase() eq |reset|) then
    !!comRepRules.resetDisplay()
  endif

endfunction
