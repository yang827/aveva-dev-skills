--
-- Description:
-- Save the current lists to a file in the PDMSUSER directory
--
------------------------------------------------------------------------
--
-- Function Type:   Function
--
------------------------------------------------------------------------

-- Define function
define function !!comSaveLists()

  -- Find out current proj mdb and user name
   !proj = current project
   !sess = current session

  -- create a file in the current user directory
   !fileName = '%PDMSUSER%/' + !proj.code() + '-' + !sess.mdb().name.after('/') + '-' + !sess.user().name + '.svl'

   -- open file for lists

   !token = object FILE()
   !token.file(!fileName)

   !listNames = !!cdcList.name.dText

   -- Write out the names of the lists
   !token.writeFile('OVERWRITE',!listNames)
   !token.open('APPEND')
   !token.writeRecord('###')
   !token.close()

   do !x index !listNames
      !list$!x  = !!cdList$!x
      handle ANY
        -- No lists
      elsehandle NONE

        -- Write out the list contents + a start and finish indicator of the list contents
        !token.open('APPEND')
        !token.writeRecord('cdcList$!x')
        !token.close()

        !token.writeFile('APPEND',!list$!x)

        !token.open('APPEND')
        !token.writeRecord('cdcList$!x')
        !token.close()

      endhandle
   enddo
endfunction
-- End of function definition for !!comSaveLists
