--
-- Description:
-- Function to perform a savework on the current session.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!comSavework()

  -- Prompt the user
  !answer  = !!alert.confirm(|Savework - Are you sure?|)

  -- Savework if yes
  if (!answer.boolean()) then
    SAVEWORK
    SESSION COMMENT 'Unset'
  endif


endfunction
-- End of function definition for !!comSavework
