--
--
-- Description:
-- function to set colour gadgets
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--    1   RW      GADGET      Button to display colour as background
--    2   RW      GADGET      Paragraph to display colour name
--    3   R       ANY      Colour to set gadgets to
--
------------------------------------------------------------------------

define function !!comSetColGadget(!button is GADGET, !paragraph is GADGET, !colour is ANY)

  !colourObj = object COLOUR(!colour)

  !button.background = !colourObj.code
  !paragraph.val = !colourObj.name

endfunction
-- End of function definition for !!comSetColGadget
