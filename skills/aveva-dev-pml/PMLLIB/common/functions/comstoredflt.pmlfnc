--
-- Description:
-- Function containing Default storage areas for Design
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!comStoreDflt()

  !module = !!module()

  if (!module.appKey.upcase() eq 'DES') then

    -- Storage Area for Ladder
    !store                 = object STORE()
    !store.name            = 'ASL'
    !store.group           = 'ASL'
    !store.title           = 'ASL General'
    !store.elementType     = 'SBFR'
    !store.owningTypes[1]  = 'FRMW'
    !store.fileType        = 'CADC'
    call !!addStoreArea(!store)

    -- storage Area for Wall
    !store                 = object STORE()
    !store.name            = 'WALL'
    !store.group           = 'WANDF'
    !store.title           = 'Walls'
    !store.elementType     = 'STWALL WALL'
    !store.owningTypes[1]  = 'CWALL'
    !store.owningTypes[2]  = 'SBFR'
    !store.owningTypes[3]  = 'FRMW'
    !store.fileType        = 'CADC'
    call !!addStoreArea(!store)

    -- storage Area for Floor
    !store                 = object STORE()
    !store.name            = 'FLOOR'
    !store.group           = 'WANDF'
    !store.title           = 'Floors'
    !store.elementType     = 'FLOOR'
    !store.owningTypes[1]  = 'CFLOOR'
    !store.owningTypes[2]  = 'SBFR'
    !store.owningTypes[3]  = 'FRMW'
    !store.fileType        = 'CADC'
    call !!addStoreArea(!store)

    -- storage Area for Screed
    !store                 = object STORE()
    !store.name            = 'SCREED'
    !store.group           = 'WANDF'
    !store.title           = 'Screeds'
    !store.elementType     = 'SCREED'
    !store.owningTypes[1]  = 'CSCREE'
    !store.owningTypes[2]  = 'CFLOOR'
    !store.owningTypes[3]  = 'SBFR'
    !store.owningTypes[4]  = 'FRMW'
    !store.fileType        = 'CADC'
    call !!addStoreArea(!store)

    -- storage Area for Section
    !store                 = object STORE()
    !store.name            = 'SECTION'
    !store.group           = 'BANDC'
    !store.title           = 'Section'
    !store.elementType     = 'SCTN'
    !store.owningTypes[1]  = 'TMPL'
    !store.owningTypes[2]  = 'SBFR'
    !store.owningTypes[3]  = 'FRMW'
    !store.fileType        = 'CADC'
    call !!addStoreArea(!store)

    -- storage Area for Primary Nodes
    !store                 = object STORE()
    !store.name            = 'PNODE'
    !store.group           = 'BANDC'
    !store.title           = 'Primary Node'
    !store.elementType     = 'PNOD'
    !store.owningTypes[1]  = 'TMPL'
    !store.owningTypes[2]  = 'SBFR'
    !store.owningTypes[3]  = 'FRMW'
    !store.fileType        = 'CADC'
    call !!addStoreArea(!store)

    -- storage Area for Panels
    !store                 = object STORE()
    !store.name            = 'PANEL'
    !store.group           = 'PANDP'
    !store.title           = 'Panel'
    !store.elementType     = 'PANE'
    !store.owningTypes[1]  = 'TMPL'
    !store.owningTypes[2]  = 'SBFR'
    !store.owningTypes[3]  = 'FRMW'
    !store.fileType        = 'CADC'
    call !!addStoreArea(!store)

    -- storage Area for Primary Linear Joints
    !store                 = object STORE()
    !store.name            = 'PALJ'
    !store.group           = 'PANDP'
    !store.title           = 'Primary Linear Joint'
    !store.elementType     = 'PALJ'
    !store.owningTypes[1]  = 'SBFR'
    !store.owningTypes[2]  = 'FRMW'
    !store.fileType        = 'CADC'
    call !!addStoreArea(!store)

  endif

endfunction
-- End of function definition for !!comStoreDflt
