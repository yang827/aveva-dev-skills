--
--
-- Description:
-- Function containing Default storage groups for Design
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!comStoreGrpDflt()

  !module = !!module()

  if (!module.appKey.upcase() eq 'DES' or !module.appKey.upcase() eq 'CMP') then

    -- Storage Group for ASL application
    !group                = object STOREGROUP()
    !group.name           = 'ASL'
    !group.title          = 'Access, Stairs & Ladders'
    !group.fileType        = 'CADC'
    call !!addStoreGroup(!group)

    -- Storage Group for Walls and Floors application
    !group                = object STOREGROUP()
    !group.name           = 'WANDF'
    !group.title          = 'Walls and Floors'
    !group.fileType        = 'CADC'
    call !!addStoreGroup(!group)

    -- Storage Group Form Beams and Columns Application
    !group                = object STOREGROUP()
    !group.name           = 'BANDC'
    !group.title          = 'Beams and Columns'
    !group.fileType        = 'CADC'
    call !!addStoreGroup(!group)

    -- Storage Group Form Panels and Plates Application
    !group                = object STOREGROUP()
    !group.name           = 'PANDP'
    !group.title          = 'Panels and Plates'
    !group.fileType        = 'CADC'
    call !!addStoreGroup(!group)

  endif

endfunction
-- End of function definition for !!comStoreGrpDflt
