--
-- Description:
-- Check if user is a member of a team
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!comTeamCheck(!teams is ARRAY) is BOOLEAN

  var !user USER
  !userObject = object USER(!user)
  -- var !userData USER |$!<user>|
  --!userTeam = !userData.after(':').split()

  !userTeam = !userObject.teamList()

  !isMember = false
  do !checkTeam values !teams
    do !userTeamName values !userTeam
      if (!checkTeam eq !userTeamName.name) then
        !isMember = true
        break
      endif
    enddo
    break if (!isMember)
  enddo

  return !isMember

endfunction
-- End of function definition for !!comTeamCheck
