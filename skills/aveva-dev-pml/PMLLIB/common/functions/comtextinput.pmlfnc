-- File:            comtextinput.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     INPUT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Thu Aug 27 9:29:13 BST 1998
--
--
-- Description:
-- standard GUI input to select from a list of values
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      STRING      Form title
--    2   R      STRING      Gadget title
--    3   R      REAL        Width of input gadget
--    4   R      REAL        Maximum width of input value
--    5   R      STRING      Format type of input gadget (STRING/REAL/DISTANCE/BORE)
--    6   R      ANY         Initial value
--    7   R      REAL        Minimum value
--    8   R      REAL        Maximum value
-- Return:
--   [ANY] [Value entered by user]
--
------------------------------------------------------------------------
define function !!comTextInput(!formTitle is STRING, !gadgetTitle is STRING, !width is REAL, !scroll is REAL, !format is STRING, !value is ANY, !min is REAL, !max is REAL) is ANY

  setup form !!comTextInput blocking

    member .okFlag is BOOLEAN

    !!comTextInput.formTitle = !formTitle

    !ptyp = ''

    if (!format eq 'STRING') then
      text .text '$!<gadgetTitle>' at xmin ymax+0.2 scroll $!<scroll> width $!<width> is STRING
    elseif (!format eq 'REAL') then
      text .text '$!<gadgetTitle>' at xmin ymax+0.2 scroll $!<scroll> width $!<width> is REAL
    elseif (!format eq 'DISTANCE') then
      !ptyp = 'DIST'
      text .text '$!<gadgetTitle>' at xmin ymax+0.2 scroll $!<scroll> width $!<width> is REAL format !!distanceFmt
    elseif (!format eq 'BORE') then
      !ptyp = 'BORE'
      text .text '$!<gadgetTitle>' at xmin ymax+0.2 scroll $!<scroll> width $!<width> is REAL format !!boreFmt
    endif

    button .ok '  OK  ' at xmin ymax+0.5 ok
    button .cancel 'Cancel' at xmax form-size ymin cancel

  exit

  if (!format ne 'STRING' and !max.set() and !min.set()) then
    !!comTextInput.text.validateCall = '!!comValidateRange(!this.text.val, $!<max>, $!<min>)'
  endif

  !!comTextInput.text.callback = '!this.ok.setFocus()'

  !!comTextInput.okCall = '!this.okFlag = true'
  !!comTextInput.cancelCall = '!this.okFlag = false'

  if (!value.set()) then
    !!comTextInput.text.val = !value
  endif

  -- show the input form
  waiton !!comTextInput

  if (!!comTextInput.okFlag) then
    !text = !!comTextInput.text.val
  else
    if (!format eq 'STRING') then
      !text = STRING()
    else
      !text = REAL()
    endif
  endif

  return !text

endfunction
-- End of function definition for !!comTextInput
