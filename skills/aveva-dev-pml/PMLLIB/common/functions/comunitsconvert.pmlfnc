--   Group:         General Application
--     Keyword:     INPUT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Thu Aug 27 9:29:13 BST 1998
--
-- Description:
-- Convert real value in input units to value in output units
-- The real value returned is undimensioned
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      REAL        value to convert
--    2   R      STRING      units of input value
--    3   R      STRING      units of output value
-- Return:
--   [REAL] [Converted undimensioned value]
--
------------------------------------------------------------------------
define function !!comUnitsConvert(!value is REAL, !inputUnits is STRING, !outputUnits is STRING) is REAL

  -- Input units: Deal with special case of current distance or bore units
  if(!inputUnits.upcase().subString(1,4) eq 'DIST') then
    !tempFormat           = object FORMAT()
    !tempFormat.dimension = 'L'
    !tempFormat.dp        = 15
    !inputValue           = !value.string().real(!tempFormat)
  elseif(!inputUnits.upcase().subString(1,4) eq 'BORE') then
    !tempFormat           = object FORMAT()
    !tempFormat.dimension = 'L'
    !tempFormat.dp        = 15
    if( !!isImperialLength('BORE') ) then
      !tempFormat.units   = 'INCH'
    else
      !tempFormat.units   = 'MM'
    endif
    !inputValue           = !value.string().real(!tempFormat)
  else
    -- construct the unit qualified value as a string and convert it to real
    !inputValue           = object REAL( !value.string() + ' ' + !inputUnits )
    handle any
      return !value
    endhandle
  endif

  -- Output units: Deal with special case of current distance or bore units
  if(!outputUnits.upcase().subString(1,4) eq 'DIST') then
    -- check for consistent dimension
    return !inputValue.value()
  elseif(!outputUnits.upcase().subString(1,4) eq 'BORE') then
    -- check for consistent dimension
    !tempFormat           = object FORMAT()
    !tempFormat.dimension = 'L'
    !tempFormat.dp        = 15
    if( !!isImperialLength('BORE') ) then
      !tempFormat.units   = 'INCH'
    else
      !tempFormat.units   = 'MM'
    endif
    -- the next line tests that the dimension is correct and makes sure that value
    -- returned is not dimensioned, even if the input value is a FINCH string
    !outputValue          = !inputValue.string(!tempFormat).real()
    handle any
      !outputValue        = !value
    endhandle

    -- return undimensioned value in requested units
    return !outputValue
  else
    -- check validity of output units
    !tempValue = !inputValue.convertUnits(!outputUnits).value()
    handle any
      !tempValue = !value
    endhandle
    return !tempValue
  endif


endfunction
-- End of function
