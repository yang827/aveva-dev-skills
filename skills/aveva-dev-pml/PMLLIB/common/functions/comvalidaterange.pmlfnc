--   Group:         General Application
--     Keyword:     INPUT
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Thu Aug 27 9:29:13 BST 1998
--
-- Description:
-- function to validate that a value is in a define range
-- used primarily by validation callbacks on text gadgets
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      ARRAY       Array of strings to populate list gadget
--    2   R      REAL        Height of list gadget
--    3   R      STRING      Form title
-- Return:
--   [FORM] [Form that has been created by this function]
--
------------------------------------------------------------------------
define function !!comValidateRange(!value is REAL, !max is REAL, !min is REAL, !unitsType is STRING)

  !nMax = MAX(!max, !min)
  !nMin = MIN(!max, !min)

  if (!value lt !nMin or !value gt !nMax) then
    !format     = !!comFormats.getGlobalUnitsFormat(!unitsType)
    if( !format.unset() ) then
      !sMax = !nMax.queryString()
      !sMin = !nMin.queryString()
    else
      !sMax = !nMax.string(!format)
      handle (2,812)
        !sMax = !nMax.queryString()
      endhandle
      !sMin = !nMin.string(!format)
      handle (2,812)
        !sMin = !nMin.queryString()
      endhandle
    endif
    return error 1 |Value must be between $!<sMin> and $!<sMax>|
  endif

endfunction
-- End of function definition for !!comValidateRange
