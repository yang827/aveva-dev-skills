-- File:            comvalueconvert.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     UNITS
--   Module:        common
--  Created:         Thu Mar 11 13:53:28 2010
--
-- Description:
-- Convert given real to requested unit. If real is not dimensioned
-- it is assumed to be a value in the requested unit, so same value
-- is returned. Otherwise an undimensioned REAL value is returned
-- representing the conversion of the input value to the output unit.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      REAL        value to convert
--    2   R      STRING      units for output value conversion
-- Return:
--   [REAL] [Converted undimensioned value]
--
------------------------------------------------------------------------
define function !!comValueConvert(!value is REAL, !outputUnits is STRING) is REAL

  if( !value.units().isNull() ) then
    return !value
  elseif(!outputUnits inset('DIST','BORE')) then
    return !!comUnitsConvert(!value, !value.units().shortName(), !outputUnits)
  else
    return !value.convertUnits(!outputUnits).value()
  endif

endfunction
-- End of function
