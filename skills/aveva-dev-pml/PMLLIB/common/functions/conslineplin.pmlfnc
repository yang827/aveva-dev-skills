--
--
-- Description:
-- Construct a Line from a Pline
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       Element
--    2   R      String      Pkey of Pline
--    3   R      String      End of Element (Only relevant for GENSEC)
-- Return:
--   [Data Type] [Description]
--    Line        Pline as a line
--
------------------------------------------------------------------------

-- Define function
define function !!consLinePlin(!element is DBREF, !pLine is STRING, !end is STRING) is VECTOR

!return = object VECTOR()

if (!element.hardType eq |SCTN| ) then

     !return.position = !element.plStart.attribute(!pLine).wrt(WORLD)

     !return.direction = !element.plori.attribute(!pLine).yDir().wrt(WORLD)

else
     !elementString  = !element.string()
     if (!end.upcase() eq 'START') then
          var !dirString  PPLIN $!pLine Y DIRECTION  OF $!elementString
          var !posString  PPLIN $!pLine START OF $!elementString
     else
          var !dirString  PPLIN $!pLine Y DIRECTION  END OF $!elementString
          var !posString  PPLIN $!pLine  END OF $!elementString
     endif

     !return.position = !posString.position()

     !return.direction =  !dirString.direction()

endif

return !return

endfunction
-- End of function definition for !!consLinePlin
