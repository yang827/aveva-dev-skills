--
-- Description:
-- Calculate Mid Point of Two Other Positions
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Start Point
--    2   R      POSITION    End Point
-- Return:
--   [Data Type] [Description]
--    Position    Mid Point
--
------------------------------------------------------------------------

-- Define function
define function !!consMidPoint(!start is POSITION, !end is POSITION) is POSITION

!return = object  POSITION()

!return.east = ( !start.east + !end.east ) /  2
!return.north = ( !start.north + !end.north ) /  2
!return.up = ( !start.up + !end.up ) /  2
!return.origin = !start.origin

return !return

endfunction
-- End of function definition for !!consMidPoint
