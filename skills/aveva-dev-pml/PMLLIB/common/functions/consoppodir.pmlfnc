--
-- Description:
-- Construct Opposite Direction from one given
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Direction    Direction
-- Return:
--   [Data Type] [Description]
--    Direction   Opposite Direction
--
------------------------------------------------------------------------

-- Define function
define function !!consOppoDir(!direction is DIRECTION) is DIRECTION

!return = object DIRECTION()

!return.e = - !direction.e
!return.n = - !direction.n
!return.u = - !direction.u

return !return

endfunction
-- End of function definition for !!consOppoDir
