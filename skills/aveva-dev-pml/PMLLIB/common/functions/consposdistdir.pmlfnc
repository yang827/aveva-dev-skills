--
-- Description:
-- Construct Position from Distance and Direction
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Real        Distance
--    2   R      Direction   Direction
--    3   R      Position    Position
-- Return:
--   [Data Type] [Description]
--    Position    Position
--
------------------------------------------------------------------------

-- Define function
define function !!consPosDistDir(!distance is REAL, !direction is DIRECTION, !position is POSITION) is POSITION

!return = object POSITION()

!return.east = !direction.wrt(WORLD).east * !distance + !position.wrt(WORLD).east
!return.north = !direction.wrt(WORLD).north * !distance + !position.wrt(WORLD).north
!return.up = !direction.wrt(WORLD).up * !distance + !position.wrt(WORLD).up
!return.origin = WORLD

return !return

endfunction
-- End of function definition for !!consPosDistDir
