-- File:          daccheck.pmlfnc
-- Type:          Function Definition
-- Group:         General Application
-- Keyword:
-- Module:
-- Author:        J.Wyatt
-- Created:       March 2011
--
-- Description:
--       Function to query if all given attributes on a given element
--       can be modified.  Checks db write access and DAC.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   R      DBREF             Element to be modified
--    2   R      ARRAY OF STRINGS  Attributes to be modified
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if all given attributes on element can be modified
--
------------------------------------------------------------------------
define function !!dacCheck(!element is DBREF, !attributes is ARRAY) is BOOLEAN

  -- Check that element can be written to
  if !element.dbwrite.not() then
    !!alert.error('Unable to modify element ' & !element.name & ' as no write access is available')
    return FALSE
  endif

  !objAttribute = object ATTDEFINITION()
  !flag  = TRUE
  !error = 'Following attributes on ' & !element.name & ' cannot be set:
'

  -- Check that individual attributes are not protected by DAC
  do !attribute values !attributes
    !objAttribute.attLibGet(!attribute)
    if( !objAttribute.isValidAttribute ) then
      -- check that attribute can be modified
      !stringMessage = !element.moderr.attribute(!attribute)
      -- Valid attribute name
      if( !stringMessage.empty().not() ) then
        -- Get full attribute name with correct formatting rather than passed name
        !fullName = !objAttribute.qtxt
        !error = ('- ' & !error & !fullName & ' - ' & !stringMessage & ';
')
        !flag = FALSE
      endif
    else
      -- Invalid attribute name
      !error = ('- ' & !error & !attribute.upcase() & ' is not a valid attribute' & ';
')
      !flag = FALSE
    endif
  enddo

  if !flag then
    return TRUE
  else
    !error = !error.substring(1, !error.size() - 2)
    !!alert.error(!error)
    return FALSE
  endif

endfunction
