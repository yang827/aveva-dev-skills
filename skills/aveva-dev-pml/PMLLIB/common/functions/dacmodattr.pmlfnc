-- File:            dacmodattr.pmlfnc
--   Type:          Function Definition
--   Group:         GENERAL
--
--     Keyword:     DAC
--   Module:
--   Replaces:
--
--   Author:
--   Created:
--
--
--
-- Description:
--    Checks whether DAC rights prevent the user from modifying the
--    passed attributes
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dacModAttr(!dbElement is DBREF,!attributes is ARRAY) is ARRAY

   !retModifiable    =  ARRAY()

   -- Check for DAC on the attributes
   if(!attributes.unset())then
      !attributes    = !dbElement.attlist
   endif

   do !i indices !attributes
      !attIsModifiable     = !dbElement.dacmod.attribute(!attributes[!i])
      handle (2,6)
         skip
      elsehandle NONE
         if(!attIsModifiable)then
            !retModifiable.append(!attributes[!i])
         endif
      endhandle
   enddo

   return !retModifiable
endfunction
-- End of function definition for !!dacModAttr
