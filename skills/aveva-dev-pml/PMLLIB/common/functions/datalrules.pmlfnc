--
--
-- Description:
-- function to create a DATAL of rules
-- that can fed straight back in if required
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!datalRules(!dbRef is DBREF, !origin is STRING) is ARRAY
-- Initialise Variables
   !allRules = ARRAY()

-- get where we are
   !refe = !!ce
-- determine what argument was passed.


     !!ce = !dbRef
     !dbElement = !dbRef


 !allElements = !!collectAllFor('','(not type inset(|TMPL|, |DPSE|,|DDSE|,|DDAT|))',!dbElement)


do !indx indices !allElements
   !rules = !!getRules(!allElements[!indx])
   if(!rules.set()) then
      if(!origin.upcase().eq('ORIGIN')) then
         if(!allElements[!indx].orrf.set()) then
           !allRules.append(!allElements[!indx].orrf.flnn)
           !allRules.appendArray(!rules)
         endif
      else
      !allRules.append(!allElements[!indx].flnn)
      !allRules.appendArray(!rules)
      endif

   endif


enddo

-- set back to where we are
   !!ce=!refe

return !allRules

endfunction
-- End of function definition for !!datalRules
