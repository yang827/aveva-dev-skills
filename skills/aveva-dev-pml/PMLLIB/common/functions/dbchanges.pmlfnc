-- Author:          N.Holmes
-- Created:         Wed Jul 16 14:10:00 BST 1997
--
--
-- Description:
-- Collects all modified/created elements between the dates/times in
-- the changes form !!dbChanges. NOTE: elements modified in the current
-- active session (0) are not considered.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dbChanges()

  -- Initialise Variables
  !!dbChanges.list.clear()
  !fromSession = !!dbChanges.fromSession
  !toSession   = !!dbChanges.toSession

  -- Check the dates

  -- Collect all items beneath current element
  !collection = !!collectAllFor('PANE','History[1] ge ' & !fromSession & ' or History[1] le ' & !toSession,!!ce)

  -- No there are no element in the collection
  if(!collection.unset()) then
    !!dbChanges.total.val    = 'None'
    !!dbChanges.modTotal.val = 'None'
    !!dbChanges.crtTotal.val = 'None'
    return
  endif

  -- Initialise Process variables
  !dText    = ARRAY()
  !rText    = ARRAY()
  !modified = 0
  !created  = 0

  -- Loop through all collection elements
  do !i indices !collection

    -- Has it been created after the date
    !history = History of $!collection[$!i]

    -- Determine if Item has been Modified or Created since the date given.
    -- Created since date
    if(!history[!history.size()] ge !fromSession) then
      !created  = !created + 1

      -- If item has been created, then we can output data
      !dText.append('Created  ' & !collection[!i].flnn )
      !rText.append(!collection[!i].string())

    -- Modified since date
    else
      !modified  = !modified + 1

      !dText.append('Modified ' & !collection[!i].flnn )
      !rText.append(!collection[!i].string())

    endif

  enddo

  -- Display Information
  !!dbChanges.total.val    = !collection.size().string()
  !!dbChanges.modTotal.val = !modified.string()
  !!dbChanges.crtTotal.val = !created.string()

  -- Display the items
  !!dbChanges.list.dText = !dText
  !!dbChanges.list.rText = !rText



endfunction
-- End of function definition for !!dbChanges
