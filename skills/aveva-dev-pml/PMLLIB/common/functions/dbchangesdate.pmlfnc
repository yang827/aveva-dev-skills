--     Keyword:     FIND
--   Module:        aker
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Jul 16 14:10:00 BST 1997
--
--
-- Description:
-- Check date and sets session information for before/after dates
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Option : AFTER
--                                    BEFORE
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dbChangesDate (!option is STRING)

  -- Initialise Variables

  -- Get Session
  -- After Date
  if(!option.upcase() eq 'AFTER') then

    -- Set Date/Time Strings
    !date     = !!dbChanges.afterDay    & ' ' & !!dbChanges.afterMonth  & ' ' & !!dbChanges.afterYear
    !time     = !!dbChanges.afterHours  & ':' & !!dbChanges.afterMins
    !dateTime = !time & ' ' & !date

    -- Session for Date/Time
    var !sStr SESSIONS ON $!dateTime
    !session  = !sStr.real() + 1
    !unused     = SESSU $!session
    handle any
      return error 1 |No saved sessions after $!time $!date|
    endhandle

    -- Check that the session is before the before session
    if(!session ge !!dbChanges.toSession) then
      !session = !!dbChanges.toSession - 1
      !!alert.warning(|Date/Time give a session either the same as or after the "Before" date.|)
    endif

    !!dbChanges.fromSession = !session

  -- Before Date
  else
    !date     = !!dbChanges.beforeDay   & ' ' & !!dbChanges.beforeMonth & ' ' & !!dbChanges.beforeYear
    !time     = !!dbChanges.beforeHours & ':' & !!dbChanges.beforeMins
    !dateTime = !time   & ' ' & !date

    -- Session for Date/Time
    var !sStr SESSIONS ON $!dateTime
    !session  = !sStr.real()
    !!dbChanges.toSession   = !session

  endif

  -- Get Session Data
  !user    = SESSU $!session
  !date    = SESSD $!session
  !comment = SESSC $!session
  !data    = 'Number  : ' & !session & '  User : ' & !user
  !date    = 'Date    : ' & !date

  -- After Date
  if(!option.upcase() eq 'AFTER') then
    !!dbChanges.aSesData.val    = !data
    !!dbChanges.aSesDate.val    = !date
    !!dbChanges.aSesComment.val = !comment
  else
    !!dbChanges.bSesData.val    = !data
    !!dbChanges.bSesDate.val    = !date
    !!dbChanges.bSesComment.val = !comment
  endif

endfunction
-- End of function definition for !!dbChangesDate
