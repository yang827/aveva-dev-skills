-- Define function
define function !!dbChangesInit()

  -- Initialise Variables
  -- Full name
  !months[1]  = 'January'
  !months[2]  = 'February'
  !months[3]  = 'March'
  !months[4]  = 'April'
  !months[5]  = 'May'
  !months[6]  = 'June'
  !months[7]  = 'July'
  !months[8]  = 'August'
  !months[9]  = 'September'
  !months[10] = 'October'
  !months[11] = 'November'
  !months[12] = 'December'

  -- 3char name
  !block      = object BLOCK('!months[!evalIndex].subString(1,3)')
  !partName   = !months.evaluate(!block)
  !clock      = !!clock()

  -- After
  -- Load month into .month gadget
  !!dbChanges.afterMonth.dText  = !months
  !!dbChanges.afterMonth.rText  = !partName

  -- Default date
  !!dbChanges.afterHours.val    = '0'
  !!dbChanges.afterMins.val     = '0'
  !!dbChanges.afterDay.val      = !clock.dom.string()
  !!dbChanges.afterYear.val     = !clock.year.string()
  !!dbChanges.afterMonth.select('RTEXT',!clock.month)

  --Before
  -- Load month into .month gadget
  !!dbChanges.beforeMonth.dText = !months
  !!dbChanges.beforeMonth.rText = !partName

  -- Default date
  !!dbChanges.beforeHours.val   = !clock.time.before(':')
  !!dbChanges.beforeMins.val    = !clock.time.after(':')
  !!dbChanges.beforeDay.val     = !clock.dom.string()
  !!dbChanges.beforeYear.val    = !clock.year.string()
  !!dbChanges.beforeMonth.select('RTEXT',!clock.month)

  -- Set Session Dates
  call !!dbChangesDate('AFTER')
  call !!dbChangesDate('BEFORE')

endfunction
-- End of function definition for !!dbChangesInit
