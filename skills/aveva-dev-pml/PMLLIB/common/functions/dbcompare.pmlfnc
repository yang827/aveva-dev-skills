-- File:            dbcompare.pmlfnc
--   Type:          Function Definition
--   Group:         Searching for elements in the database
--     Keyword:     FIND
--   Module:        aker
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Wed Jul 16 14:10:00 BST 1997
--
--
-- Description:
-- Compares common attributes of the two passed elements. Returns an
-- array of the attribute which are different.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dbCompare (!object is DBREF, !target is DBREF) is ARRAY

  -- Initialise Variables
  !refItem = !!ce
  !return  = ARRAY()

  -- Goto  Object and get attribute list
  !!ce     = !object
  var !objectAttList ATTLIST

  -- Goto  Target and get attribute list
  !!ce     = !target
  var !targetAttList ATTLIST

  -- Return to we cam from
  !!ce     = !refItem

  -- Get an array of attributes common to both items
  !attList = !objectAttList.intersect(!targetAttList)

  -- Loop through
  do !i indices !attList

    skip if(!object.attribute(!attList[!i]) eq !target.attribute(!attList[!i]))
    !return.append(!attList[!i])

  enddo

  -- Return Difference
  return !return

endfunction
-- End of function definition for !!dbCompare
