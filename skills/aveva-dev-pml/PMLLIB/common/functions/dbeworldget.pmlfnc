--
-- Description:
-- Function to return world element for databases of a given type
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Database type]
--
-- Return:
--   [Data Type] [Description]
--   [DBREF]     [World element for first database of given type in the mdb]
--
------------------------------------------------------------------------

-- Define function
define function !!dbeWorldGet(!type is STRING) is DBREF

  !element = !!ce.frstw.$!<type>

  return !element

endfunction
-- End of function definition for !!dbeWorldGet
