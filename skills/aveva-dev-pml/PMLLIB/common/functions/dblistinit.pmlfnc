--
--
-- Description:
-- Function to initialise the Database List form based on the
-- current display mode.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dbListInit()

  !dbs = DBS

  -- Clear the current list of databases
  !!dbList.dbs.clear()

  -- Loop through the project database list
  do !i indices !dbs

    if (!!sessionSettings.showAs eq |DESC|) then
      !dbList[!i] = !dbs[!i].description
      if (!dbList[!i].unset() or !dbList[!i].empty()) then
        !dbList[!i] = !dbs[!i].name
      else
        !dbList[!i] = !dbList[!i].trim()
      endif
    else
      !dbList[!i] = !dbs[!i].name
    endif

    !replList[!i] = !dbs[!i].name

  enddo

  -- Sort the list of teams and place them in the list gadget
  !sortOrder = !dbList.sortedIndices()
  !dbDispList = ARRAY()
  !dbReplList = ARRAY()

  do !i values !sortOrder
    !dbDispList.append(!dbList[!i])
    !dbReplList.append(!replList[!i])
  enddo

  !!dbList.dbs.dText = !dbDispList
  !!dbList.dbs.rText = !dbReplList

  -- Call function to display selected users information
  call !!dbListSelect(!!dbList.dbs)

endfunction
-- End of function definition for !!dbListInit
