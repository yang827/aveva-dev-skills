--
--
-- Description:
-- Function to display information about the database selected in
-- the Database List form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget from which DB is selected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!dbListSelect(!list is GADGET)

  -- Get the current selected database object
  !dbs    = DBS
  if (!dbs.unset()) then
    return
  endif

  !dBlock = object BLOCK(|!dbs[!evalIndex].name|)
  !dPos   = !dbs.evaluate(!dBlock).findFirst(!list.selection('RTEXT'))
  !db     = !dbs[!dPos]

  -- Set the current DB's description text
  !desc = !db.description
  if (!desc.unset() or !desc.empty()) then
    !!dbList.dDesc.val = |-- no description --|
  else
    !desc = !desc.trim()
    if (!desc.length() gt 43) then
      !!dbList.dDesc.val = !desc.subString(1,41) + |>>|
    else
      !!dbList.dDesc.val = !desc
    endif
  endif

  -- Set the selected DB's team name
  !team = !db.team.name
  if (!!sessionSettings.showAs eq |DESC|) then
    !teamTx = !db.team.description
    if (!teamTx.unset() or !teamTx.empty()) then
      !!dbList.dTeam.val = !team
    else
      if (!teamTx.length() gt 35) then
        !!dbList.dTeam.val = !teamTx.subString(1,33) + |>>|
      else
        !!dbList.dTeam.val = !teamTx.trim()
      endif
    endif
  else
    !!dbList.dTeam.val = !team
  endif

  -- Display the selected DB's properties
  !dbType = !db.type
  !dbNumb = !db.number
  !dbSize = !db.size()
  !dbAcc  = !db.access
  !dbClm  = !db.claim
  !dbFor  = !db.foreign

  !!dbList.dType.val = !dbType.trim()
  !!dbList.dNumb.val = !dbNumb.trim()
  !!dbList.dSize.val = !dbSize.string()
  if (!dbClm.set()) then
    !!dbList.dAcc.val  = !dbAcc.trim() + ' ' + !dbClm
  else
    !!dbList.dAcc.val  = !dbAcc.trim()
  endif
  !!dbList.dSrc.val  = !dbFor.trim().subString(1,1) + !dbFor.trim().subString(2).lowcase()

  -- Process the selected DB's mdblist
  !mdbs = !db.mdbList()

  !!dbList.mdbs.clear()

  do !i indices !mdbs
    if (!!sessionSettings.showAs eq |DESC|) then
      !mdbList[!i] = !mdbs[!i].description
      if (!mdbList[!i].unset() or !mdbList[!i].empty()) then
        !mdbList[!i] = !mdbs[!i].name.after(|/|)
      endif
    else
      !mdbList[!i] = !mdbs[!i].name.after(|/|)
    endif
  enddo

  -- Display the constructed array if it has elements
  if (defined(!mdbList)) then
    !mdbList.sort()
    !!dbList.mdbs.dText = !mdbList
  endif

endfunction
-- End of function definition for !!dbListSelect
