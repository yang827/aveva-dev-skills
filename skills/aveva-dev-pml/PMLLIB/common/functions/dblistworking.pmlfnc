--
--
-- Description:
-- Return array of working extract DBs for this project
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       of DB objects - one element for each working extract
--
------------------------------------------------------------------------

define function !!dbListWorking() is ARRAY

  !workingExtracts = ARRAY()
  -- get a list of all users
  !userList = USERS
  -- collect working extracts for each user
  do !user values !userList
    !workDbs = !user.workingList()
    handle (2,109)
      -- skip an unnamed user
      skip
    endhandle
    !workingExtracts.appendArray(!workDbs)
  enddo

  return !workingExtracts

endfunction
-- End of function definition
