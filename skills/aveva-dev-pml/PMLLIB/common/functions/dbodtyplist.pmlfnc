-- Created:         Wed Jul 30 17:38:05 BST 1997
--
--
-- Description:
-- Function to return an array containing all valid database types
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Format for return array]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [ARRAY of database types]
--
------------------------------------------------------------------------

-- Define function
define function !!dboDTypList(!format is STRING) is ARRAY

  if (!format eq 'DESCRIPTION') then
    !dbTypes[1]  = 'Design'
    !dbTypes[2]  = 'Catalogue'
    !dbTypes[3]  = 'Properties'
    !dbTypes[4]  = 'Isodraft'
    !dbTypes[5]  = 'Draft'
    !dbTypes[6]  = 'Lexicon'
    !dbTypes[7]  = 'Comparator'
    !dbTypes[8]  = 'System'
  else
    !dbTypes[1]  = 'DESI'
    !dbTypes[2]  = 'CATA'
    !dbTypes[3]  = 'PROP'
    !dbTypes[4]  = 'ISOD'
    !dbTypes[5]  = 'PADD'
    !dbTypes[6]  = 'DICT'
    !dbTypes[7]  = 'COMP'
    !dbTypes[8]  = 'SYST'
  endif

  return !dbTypes

endfunction
-- End of function definition for !!dboDTypList
