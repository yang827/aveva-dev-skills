--
--
-- Description:
-- Checks whether the user has delete access to the passed item.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item to check if we have delete access to
--    2   RW     STRING      Return message, if we don't have access to item
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is we have delete access to item, false is we don't
--
------------------------------------------------------------------------

-- Define function
define function !!dbRefDelete (!item is DBREF, !message is STRING) is BOOLEAN

  -- Initialise Variables

  -- Check we have UPDATE access first
  if(!!dbRefUpdate(!item)) then

    -- Check if we have read/write access to the element
    if(!!exists(!item.string(),'','Delete').not()) then
      !message = !item.flnm + | is read only|
      return false
    endif

    return true

  endif

  -- Check if item has been claimed out by any other user
  if(!item.dbAccess eq 'MULTIWRITE') then

    -- Is the item claimed out by anyone else
    var !user USER

    if(!item.userC.trim().empty().not()) then

      !userC = !item.userC

      if(!user ne !userC) then
        !!error.text = 'Element ' & !item.flnn & ' is claimed out by user ' & !userC & '.'
        return false
      endif
    endif

  endif

  return false

endfunction
-- End of function definition for !!dbRefDelete
