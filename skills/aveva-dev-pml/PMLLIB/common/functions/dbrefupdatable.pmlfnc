-- File:            dbrefupdatable.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Mar 18 09:13:22 WAT 1997
--
--
-- Description:
--   Works the same as "dbRefUpdate", but DOES NOT claim the item if
--   it is in a multi-write database.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item to check if we have update access to
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is we have update access to item, false is we don't
--
------------------------------------------------------------------------

-- Define function
define function !!dbRefUpdatable(!item is DBREF) is BOOLEAN

  -- Is the item lock
  if(!item.lock) then
    !!error.text = !!messageFile.messageString(143, 20, !item.flnm)
    return false
  endif

  -- Check if we have read/write access to the element
  if(!!exists(!item.string(),'','Update').not()) then
    !!error.text = !!messageFile.messageString(143, 21, !item.flnm)
    return false
  endif

  -- Check if item has been claimed out by any other user
  if(!item.dbAccess eq 'MULTIWRITE') then
    if (not !item.okClaim and not !item.lclm) then
      !!error.text = !!messageFile.messageString(143, 22, !item.flnm, !item.userC)
      return false
    endif
  endif

  return true

endfunction
-- End of function definition for !!dbRefUpdatable
