--
--
-- Description:
-- Checks whether the user has access to update the specified item, return
-- failure message via the PUBLIC_ERROR !!error.text
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item to check if we have update access to
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is we have update access to item, false is we don't
--
------------------------------------------------------------------------

-- Define function
define function !!dbRefUpdate (!item is DBREF) is BOOLEAN

  if (!item.unset()) then
    return false
  endif

  -- Is the item lock
  if(!item.lock) then
    !!error.text = !!messageFile.messageString(143, 20, !item.flnm)
    return false
  endif

  -- Check if we have read/write access to the element
  if(!!exists(!item.string(),'','Update').not()) then
    !!error.text = !!messageFile.messageString(143, 21, !item.flnm)
    return false
  endif

  -- Check if item has been claimed out by any other user
  if(!item.dbAccess eq 'MULTIWRITE') then
    if (not !item.okClaim and not !item.lclm) then
      if( !item.userClaim.upcase().match('DEAD USE') eq 0 ) then
        -- user name given in !item.userClaim, so not an extract
        !!error.text = !!messageFile.messageString(143, 22, !item.flnm, !item.userClaim)
      else
        !!error.text = !!messageFile.messageString(143, 22, !item.flnm, 'UNIDENTIFIED - probably claimed to an extract DB')
        return false
      endif
    endif

    -- Claim the item if its in an implicit db -  **** FINAL ACTION *****
    if(!item.dbClaim eq 'IMPLICIT') then
      CLAIM $!item
      handle any
        -- you've already got it claimed
      endhandle
    endif
  endif

  return true

endfunction
-- End of function definition for !!dbRefUpdate
