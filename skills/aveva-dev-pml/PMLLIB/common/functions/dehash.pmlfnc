--
-- File:            dehash.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     DEHASH
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Tue Feb 15 17:12:00 BST 2000
--
--
-- Description:
-- Converts hash value into ASCII format of the text string.
--        !pHash    - I -   Hash value
--        !iAscii   - O -   String in ASCII format
--        !mAscii   - I -   Dimension of IASC
--        !nAscii   - O -   Significant length of IASC on output.
--
--        If the hashed real is out of range or if !iAscii is too short,
--        !nAscii is set to zero on exit. A hash value of zero is not
--        treated as an error but returns 'NUL '. Other out-of-range
--        values cause !iAscii to be set to '****' just in case the
--        value of !nAscii is not checked after calling.
--        If !iAscii is longer than necessary it IS padded with blanks
--        up to !mAscii characters, so don't call this routine with !mAscii
--        set to a ridiculous value like 120; 4 or 5 should be enough.
--        This feature has been included because dehashing is so often
--        followed by padding, prior to output.
--
--        Now also deals with UDA hashing(values greater than %ZZZZZZ)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      REAL        Hash value
-- Return:
--   [STRING] [String in ASCII format]
--
------------------------------------------------------------------------
define function !!dehash(!pHash is REAL) is STRING

  !kPack  = 27
  !kPack2 = 64
  !pMin   = 531442    $* Hash value for 'A'
  !pMax   = 387951929 $* Hash value for 'ZZZZZZ'
  !mAscii   = 6

  !iHash = REAL()
  !iRem  = REAL()
  !j     = REAL()
  !iNul  = ARRAY()   $* Array of REAL length 6
  !iAscii  = ARRAY()

  -- Initialise !iNul array
  !iNul[1] = !!ascii('N')
  !iNul[2] = !!ascii('U')
  !iNul[3] = !!ascii('L')
  !iNul[4] = !!ascii('L')
  !iNul[5] = !!ascii(' ')
  !iNul[6] = !!ascii(' ')


  -- Check if in range
  if (!pHash ge !pMin and !pHash le !pMax) then
    !iHash = !pHash - 531441

    do !j from 1 to !mAscii
      !iRem = !iHash - (int(!iHash / !kPack) * !kPack)
      if (!iRem gt 0 and !j le 6) then
        !iAscii[!j] = !!ascii('$@') + !iRem
        !nAscii = !j
      else
        !iAscii[!j] = !!ascii(' ')
      endif
      !iHash = !iHash / !kPack
    enddo

  elseif (!pHash gt !pMax) then
    !iHash = !pHash - !pMax
    !iHash = !iHash - (int(!iHash / !kPack2) * !kPack2)
    !iAscii[1] = !!ascii(':')

    do !j from 1 to min(!mAscii, 5)
      !iRem = !iHash - (int(!iHash / !kPack2) * !kPack2)
      if (!iRem gt 0 and !j le 5) then
        !iAscii[!j] = !iRem + 32
        !nAscii = !j
      else
        !iAscii[!j] = !!ascii(' ')
      endif
      !iHash = !iHash / !kPack2
    enddo

  endif

  -- Check if more characters have been packed than there is space in IASC
  if ( !iHash gt 1 or !pHash lt !pMin) then
    !nAscii = MIN(6,!mAscii)
    if (!pHash eq 0) then
      do !j from 1 to !nAscii
        !iAscii[!j] = !iNul[!j]
      enddo
    else
      do !j from 1 to !nAscii
        !iAscii[!j] = !!ascii('*')
      enddo
    endif
    do !j from !nAscii + 1 to !mAscii
      !iAscii[!j] = !!ascii(' ')
    enddo
    !nAscii = 0

  endif

  -- Convert !iAscii array into string
  !string = ''
  do !j indices !iAscii
    !string = !string + !!ascii(!iAscii[!j])
  enddo

  -- Remove @ characters
  !string = !string.before('$@')

  return !string

endfunction
-- End of function definition for !!dehash
