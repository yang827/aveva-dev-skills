--
-- Author:          A.Kirkland
-- Created:         Thu 22 Jan 07:51:28 BST 2004
--
--
-- Description:
-- Function to delete the currently selected element in the new browser
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!deleteCe()

  -- which module
  !session            = CURRENT SESSION
  !module             = !session.module()
  !commonModules      = 'DESIGN SPOOLER PARAGON DIAGRAMS OUTFITTING HULLDESIGN SCHEMATICMODELMANAGER TAGS LEXICON'


  -- Temporary function to fix problem described in P-5974 / P-867.
  -- Hull design elements should not be possible to delete from the explorer
  if (!!ismarineCe()) then
    !!alert.message('Deleting Hull model elements is not allowed')
    return
  endif

  -- Common modules
  if(!commonModules.match(!module).neq(0)) then
    -- Mark database
    !undo               = object UNDOABLE()
    !undo.description('Deleted element "' & !!ce.namn & '"')
    !undo.undoAction(|call !!deleteUndoActions()|)
    !undo.redoAction(|call !!deleteUndoActions()|)
    !undo.add()

    !file = object FILE('%PDMSUI%/CLIB/FILES/MDELCE')
    !!runMacro(!file.fullname() , 'CE TRUE')

    -- End undo mark
    !undo.endUndoable()

  -- Draft module
  elseif(!module.eq('DRAFT') or !module.eq('OUTFITTINGDRAFT')) then
    !file = object FILE('%PDMSUI%/DRA/GEN/MDELCE')
    !!runMacro(!file.fullname(), '')

  -- others ?
  else
  endif


endfunction
-- End of function definition
