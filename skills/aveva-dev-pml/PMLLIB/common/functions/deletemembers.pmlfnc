--
--
-- Description:
-- Function to delete all members of current element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!deleteMembers()

  -- Temporary function to fix problem described in P-5974 / P-867.
  -- Hull design elements should not be possible to delete from the explorer
  if (!!ismarineCe()) then
    !!alert.message('Deleting Hull model elements is not allowed')
    return
  endif

  -- Mark database
  !undo               = object UNDOABLE()
  !undo.description('Deleted members of "' & !!ce.namn & '"')
  !undo.add()

  -- Delete members
  !file = object FILE('%PDMSUI%/CLIB/FILES/MDELCE')
  !!runMacro(!file.fullname() , 'CE false $$<$$> true')

  -- End undo mark
  !undo.endUndoable()

endfunction
-- End of function definition
