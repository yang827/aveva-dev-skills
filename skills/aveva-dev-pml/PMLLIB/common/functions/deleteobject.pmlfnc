--
--
-- Description:
-- Deletes an object to the list gadget on the Show Object form. It remembers
-- which object was selected so it can set it again afterwards (if it
-- can).
--
-- WARNING: This function is case sensitive on which object it deletes
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      object in list to delete
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!deleteObject(!byeByeObject is STRING) is BOOLEAN

  !selected = STRING()
  !array    = ARRAY()

  !selected = !!showObjects.list.selection('RText')
  !array    = !!showObjects.list.dText

  !index    = !array.findFirst(!byeByeObject)
  !array.deleteTo(!index, 1)
  !array.compress()

  !!showObjects.list.dText = !array
  !!showObjects.list.rText = !array

  if(!selected neq !byeByeObject) then
    !!showObjects.list.select('RText', !selected)
  endif

endfunction
-- End of function definition for !!deleteObject
