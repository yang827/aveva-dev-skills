-- Created:         Thu Sep 2 15:00:00 GMT 2004
--
--
-- Description:
-- Function to delete selected elements
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!deleteSelection()

  -- Initialise Variables
  !reference          = !!ce
  !errors             = ARRAY()
  !selection          = object SELECTION()
  !selection.getCurrent()

  -- Selection list
  !selectionList      = !selection.getSelection()
  !elementList        = !selectionList

  -- If selection list is empty, don't do anything
  if(!selectionList.empty()) then
    return
  endif

  -- Mark database
  !undo               = object UNDOABLE()
  !undo.description('Deleted selection')
  !undo.add()

  -- Loop through selection and delete elements
  do !i indices !selectionList

    -- Ignore bad references (happens when we hit implied tube)
    if(badref(!selectionList[!i])) then
      !elementList[!i].delete()
      skip
    endif

    -- Ignore branches at this point
    skip if(!selectionList[!i].hardType eq 'BRAN')
    !element          = !selectionList[!i]
    !file             = object FILE('%PDMSUI%/CLIB/FILES/MDELCE')
    !!runMacro(!file.fullname() , !element.string() & ' true true false false')
    handle ANY
      !errors.append(!!error.text)
    endhandle
    !elementList[!i].delete()
  enddo

  -- Loop through the element list to see if there are any elements (branches) left
  if(!elementList.empty().not()) then
    !elementList.unique()
    do !i indices !elementList
      if(!elementList[!i].mcount eq 0) then
        !element      = !elementList[!i]
        !file         = object FILE('%PDMSUI%/CLIB/FILES/MDELCE')
        !!runMacro(!file.fullname() , !element.string() & ' true true false false')
        handle ANY
          !errors.append(!!error.text)
        endhandle
      endif
    enddo
  endif

  -- End undo mark
  !undo.endUndoable()

  -- Return to element
  if(not badref(!reference)) then
    !!ce              = !reference
  endif

endfunction
-- End of function definition
