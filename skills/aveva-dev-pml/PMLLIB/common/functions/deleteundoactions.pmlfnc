-- Description:
-- Function to undo / redo any !!deleteCE called deletion
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!deleteUndoActions()

  -- which module
  !session            = CURRENT SESSION
  !module             = !session.module()
-- Possible Modules are: 'DESIGN DRAFT SPOOLER PARAGON DIAGRAMS OUTFITTING OUTFITTINGDRAFT HULLDESIGN SCHEMATICMODELMANAGER TAGS'

 -- ************* Add any undo actions in below here ****************
  -- Design modules
  if (!module.eq('DESIGN') or !module.eq('OUTFITTING')) then

    -- ************* Add Design any undo actions in here ****************

    -- Standard Library Manager explorer deletions
    if (defined(!!stdLibraryMgr) and !!stdLibraryMgr.shown()) then
      !!stdLibraryMgr.selectAssembly(true)
      handle ANY
        -- You need to be certain no errors occur in your undo call or else UNDO gets upset
      endhandle
    endif

  -- Draft module ?
  elseif (!module.eq('DRAFT') or !module.eq('OUTFITTINGDRAFT')) then

  -- others ?
  else

  endif

endfunction
-- End of function definition
