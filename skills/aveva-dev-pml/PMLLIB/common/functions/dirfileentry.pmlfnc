-- File:            dirfileentry.pmlfnc
--   Type:          Function Definition
--   Group:          General
--     Keyword:
--   Module:
--   Replaces:      directory
--
--
-- Author:          G.Somasundaram
-- Created:        Wed  29 Aug 2007 05:00 GMT
--
--
-- Description:
--   in PML1 List gadget had provision to list all the files / directory of the passed path
--    var fileArray directory /C:\AVEVA files
--   this functions is used in place of that.
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      directory name
--    2   R      STRING      mode           - FILES / DIRS
-- Return:
--   [Data Type] [Description]
--    1   R      ARRAY   returns the files or directory list within the passed path even with space.
--
------------------------------------------------------------------------
define function !!dirFileEntry(!directory is STRING , !iMode is STRING) is ARRAY

   !fileObj = object FILE(!directory)
   !mode = !iMode.upcase()
   if (!fileObj.exists() ) then
      -- get the files
      if (!mode eq 'FILES') then
         !fileList = !fileObj.files()
       -- get the subdirectories
      elseif(!mode eq 'DIRS') then
         !fileList = !fileObj.subdirs()
      endif

      -- get only the name of the files excluding the parent path
      !block = object BLOCK(|!fileList[!evalIndex].entry()|)
      !fileArray = !fileList.evaluate(!block)

     return !fileArray

   else
      !fileArray = object ARRAY()
      return !fileArray
   endif

endfunction
