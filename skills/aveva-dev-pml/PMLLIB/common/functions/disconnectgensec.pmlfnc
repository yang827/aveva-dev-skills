--
--
--  Description:    Disconnect GENSEC at given end and delete connected JLDATU if empty
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--    1   R      STRING      GENSEC end identifier
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!disconnectGensec(!gensec is DBREF,!end is STRING)

  --store the Current element
  !ce = !!ce

  !fixing = !gensec.attribute('joi' & !end)

  if !fixing.badref() then
    return
  endif

  !!ce = !fixing
  delete FIXING
  if !!ce.memb.unset() then
    delete PLDATU
    if !!ce.memb.unset() then
      delete JLDATU
    endif
  endif

  if !ce.badref().not() then
    !!ce = !ce
  endif

endfunction
