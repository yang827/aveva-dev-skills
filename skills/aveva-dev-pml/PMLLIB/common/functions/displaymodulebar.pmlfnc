--
--
-- Description:
-- Function to set the exit action of the Module Bar and then
-- display the form. Function invoked as Bar Menu callback.
-- Function to be replaced by method !!moduleBar.display(STRING)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      String to be used as Exit Action when
--                           performing a module switch
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!displayModuleBar(!action is STRING)

  -- Display the Modules bar
  show !!moduleBar at xr 0 yr 0

  -- Set the Exit Action
  !!moduleBar.exitAction = !action
  handle any
    -- Dummy handle
    !!moduleBar.exitAction = ''
  endhandle


endfunction
-- End of function definition for !!displayModuleBar
