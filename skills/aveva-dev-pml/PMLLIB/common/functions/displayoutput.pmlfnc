--
--
-- Description:
-- Function to load/show the rptOutput form in different modes.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      String to be used as Display Mode
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!displayOutput(!action is STRING)

  -- If !!definePlane is not defined, then build it
  if(undefined(!!rptOutput)) then
    pml load form !!rptOutput
  endif

  -- Set the Display Mode
  !!rptOutput.mode(!action)

  -- Display the Modules bar
  if (!!rptOutput.shown()) then
  else
    show !!rptOutput
  endif


endfunction
-- End of function definition for !!displayOutput
