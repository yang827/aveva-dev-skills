--    Module:        design
--  Author:          Daniel(Jaehun Choi)
--  Created:
--
--  Description:     display progress bar
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        progress value (range 0 to maximum progress value)
--    2   R      REAL        maximum progress value
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!displayProgress(!value is REAL, !max is REAL)

  !percent = int(!value / !max * 100)
  if (!percent ge 100) then
    !!fmsys.setProgress(0)
  else
    !!fmsys.setProgress(!percent)
  endif

endfunction
