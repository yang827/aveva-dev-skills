--
--
-- Description:
-- Function to load/show the spcSbfiSpecSel form with different purposes.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      key word eg SBFI
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!displaySpecSbfi(!keyword is STRING, !passedMode is STRING)

  !mode = !passedMode

  -- Special SBFI for use on GWALLs
  -- ------------------------------
  if (!keyword.upcase() eq 'SBFI') then

    -- If form is not defined, then build it
    if(undefined(!!spcSbfiSpecSel)) then
      pml load form !!spcSbfiSpecSel
    endif

    -- Make sure lock toggle active
    !!spcSbfiSpecSel.elevation.active = !!spcSbfiSpecSel.elevnLock.val.not()

    -- Display the form
    if (!!spcSbfiSpecSel.shown()) then
    else
      show !!spcSbfiSpecSel
    endif

    -- Initialise the form in the correct mode
    !!spcSbfiSpecSel.init(!keyword, !mode )

  endif

endfunction
-- End of function definition for !!displaySpecSbfi
