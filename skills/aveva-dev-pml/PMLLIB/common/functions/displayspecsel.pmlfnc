-- Created:         Mon Oct 19 11:05:30 BST 1998
--
--
-- Description:
-- Function to load/show the spcSpecSelect form with different purposes.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      key word eg WALL or FLOOR
--    2    R     STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!displaySpecSel(!keyword is STRING, !passedMode is STRING)

  !mode = !passedMode

   -- FLOOR FITTINGS
   -- -----------------
   if (!keyword.upcase() eq 'FFIT') then

     -- If form is not defined, then build it
     if(undefined(!!spcFFitSpecSel)) then
       pml load form !!spcFFitSpecSel
     endif

      -- Make sure lock toggle active
     !!spcFFitSpecSel.xDistance.active  = !!spcFFitSpecSel.xDistLock.val.not()
     !!spcFFitSpecSel.yDistance.active  = !!spcFFitSpecSel.yDistLock.val.not()

     -- Display the form
     if (!!spcFFitSpecSel.shown()) then
     else
       show !!spcFFitSpecSel
     endif

     -- Initialise the form in the correct mode
     !!spcFFitSpecSel.init(!keyword, !mode )

   -- *************************************************************************

   -- WALL FITTINGS
   -- -----------------
   elseif (!keyword.upcase() eq 'WFIT') then

     -- If we are at a GWALL call the gwall fitting function
     if (!!ce.type eq 'GWALL') then
      call !!displaySpecSbfi('SBFI', !mode)
      return
    endif

     -- If form is not defined, then build it
     if(undefined(!!spcWFitSpecSel)) then
       pml load form !!spcWFitSpecSel
     endif

      -- Make sure lock toggle active
     !!spcWFitSpecSel.zDistance.active  = !!spcWFitSpecSel.zDistLock.val.not()
     !!spcWFitSpecSel.elevation.active  = !!spcWFitSpecSel.elevnLock.val.not()

     -- Display the form
     if (!!spcWFitSpecSel.shown()) then
     else
       show !!spcWFitSpecSel
     endif

     -- Initialise the form in the correct mode
     !!spcWFitSpecSel.init(!keyword, !mode )

   -- *************************************************************************

   -- HVAC FITTINGS
   -- -----------------
   elseif (!keyword.upcase() eq 'HVAC') then

     -- If form is not defined, then build it
     if(undefined(!!spcHvacSpecSel)) then
       pml load form !!spcHvacSpecSel
     endif

     if (!mode eq 'MODIFY') then
       !!spcHvacSpecSel.ce.select('RTEXT','MODIFY')
     elseif (!mode eq 'CREATE') then
       !!spcHvacSpecSel.ce.select('RTEXT','CREATE')
     else
       -- mode can be create modify or option
     endif

     -- Display the form
     if (!!spcHvacSpecSel.shown()) then
     else
       show !!spcHvacSpecSel
     endif

     -- Initialise the form in the correct mode
     !!spcHvacSpecSel.init(!keyword, !mode )

   -- *************************************************************************

   -- HVAC Penetrations
   -- -----------------
   elseif (!keyword.upcase() eq 'HPEN') then

     -- If form is not defined, then build it
     if(undefined(!!spcHvacPenSpecSel)) then
       pml load form !!spcHvacPenSpecSel
     endif

     if (!mode eq 'MODIFY') then
       !!spcHvacPenSpecSel.ce.select('RTEXT','MODIFY')
     elseif (!mode eq 'CREATE') then
       !!spcHvacPenSpecSel.ce.select('RTEXT','CREATE')
     else
       -- mode can be create modify or option
     endif

     -- Display the form
     if (!!spcHvacPenSpecSel.shown()) then
     else
       show !!spcHvacPenSpecSel
     endif

     -- Initialise the form in the correct mode
     !!spcHvacPenSpecSel.init(!keyword, !mode )

   endif

endfunction
-- End of function definition for !!displaySpecSel
