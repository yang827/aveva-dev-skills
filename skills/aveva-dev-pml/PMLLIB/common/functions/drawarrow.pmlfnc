--
-- Description:
-- Draws an arrow of fixed size in the passed direction at the give pos
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   Direction of Arrow
--    2   R      POSITION    Position of Arrow
--    3   R      REAL        Aid line number
--    4   R      REAL        Arrow Size
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!drawArrow (!dir is DIRECTION, !pos is POSITION, !number is REAL, !size is REAL)

  -- Remove previous Axes
  AID CLEAR ARROW $!number
  handle any
  endhandle

  -- Initialise Variables
  !arrow           = object ARROW()
  !arrow.dir       = !dir
  !arrow.pos       = !pos
  !arrow.ratio     = 0.25
  !arrow.length    = !size

  -- Draw Arrow
  call !!drawAidArrow(!number, !arrow)

endfunction
-- End of function definition for !!drawArrow
