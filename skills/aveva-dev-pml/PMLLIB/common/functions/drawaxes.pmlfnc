--
--
-- Description:
-- Draws a axes for the passed item
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item axes is to be displayed
--    2   R      REAL        Aid line number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!drawAxes (!item is DBREF, !number is REAL)

  -- Remove previous Axes
  AID CLEAR ARROW $!number
  handle any
  endhandle

  -- Initialise Variables
  !position        = !item.pos
  !xDir            = !item.ori.xDir()
  !yDir            = !item.ori.yDir()
  !zDir            = !item.ori.zDir()

  -- X
  !arrow           = object ARROW()
  !arrow.dir       = !xDir
  !arrow.pos       = !position
  !arrow.length    = 500mm
  !arrow.ratio     = 0.1
  call !!drawAidArrow(!number, !arrow)

  -- Z
  !arrow.dir       = !zDir
  call !!drawAidArrow(!number, !arrow)

  -- Y
  !arrow.dir       = !yDir
  !arrow.length    = 1000mm
  !arrow.ratio     = 0.2
  call !!drawAidArrow(!number, !arrow)

endfunction
-- End of function definition for !!drawAxes
