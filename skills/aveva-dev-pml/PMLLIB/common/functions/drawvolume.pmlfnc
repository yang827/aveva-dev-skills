--
--
-- Description:
-- Draws a box of the passed volume in the relevant axis system.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VOLUME      Volume of box
--    2   R      REAL        Aid line number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!drawVolume (!volume is VOLUME, !number is REAL)

  -- Remove previous Axes
  AID CLEAR BOX $!number
  handle any
  endhandle

  -- Initialise Variables
  !box             = object BOX()
  !box.x           = !volume.to.east   - !volume.from.east
  !box.y           = !volume.to.north  - !volume.from.north
  !box.z           = !volume.to.up     - !volume.from.up
  !position        = object POSITION()
  !position.east   = (!volume.to.east  + !volume.from.east)  / 2
  !position.north  = (!volume.to.north + !volume.from.north) / 2
  !position.up     = (!volume.to.up    + !volume.from.up)    / 2
  !position.origin = !volume.from.origin
  !box.pos         = !position
  !box.ori         = !position.origin.ori
  !box.wrt         = !volume.from.origin

  -- Draw Box
  call !!drawAidBox(!number, !box)

endfunction
-- End of function definition for !!drawVolume
