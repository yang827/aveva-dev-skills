-- Created:         Fri Aug 7 17:01:18 BST 1998
--
--
-- Description:
-- Returns the item in the parent structure of the passed element, that
-- has the passed ddl attribute, including itself.
--
-- NOTE, the attribute name as returned by .attributes() must be supplied
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to look from
--    2   R      STRING      Attribute name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!dtbDdlAttribute(!element is DBREF, !attribute is STRING) is DBREF

  -- Initialise Variables
  !attrib = !attribute.upcase().subString(1,1) & !attribute.lowcase().subString(2)
  !owner  = !element

  -- Loop through element until the attribute has been found
  do !i

    break if(!owner.attributes().findFirst(!attrib).set())
    handle any
    endhandle

    if(!owner.fullType eq 'WORLD') then
      return object DBREF()
    endif
    !owner = !owner.owner
    break if(!i gt 10)
  enddo

  return !owner

endfunction
-- End of function definition for !!dtbDdlAttribute
