--
-- Author:          M.Barlow
-- Created:         26 May 2011
--
--
-- Description:
-- Returns the element in the hierarchy whose type matches the given type.
-- The given type can be a UDET. The test can search for actual type only
-- or search for TYPE.
--
------------------------------------------------------------------------
define function !!dtbFindOwnerOfType(!element is DBREF, !type is STRING, !actualTypeOnly is BOOLEAN) is DBREF

  -- Initialise Variables
  !owner       = !element
  !elementType = !type.upcase()

  -- Loop until we hit an element that has correct type or we hit the top
  do
    -- hit world - element not found
    break if(!owner.fullType eq 'WORLD')
    -- check UDET type
    if( !owner.actType eq !elementType ) then
      return !owner
    endif

    if( !actualTypeOnly ) then
      -- check type
      if( !owner.type eq !elementType or !owner.fullType eq !elementType ) then
        return !owner
      endif
    endif

    !owner = !owner.owner
    handle any
      break
    endhandle

  enddo

  return object DBREF()

endfunction
