-- Author:          A.Kirkland
-- Created:         Mon Oct 19 09:21:19 BST 1998
--
--
-- Description:
-- function to return owner dbref from a list of types.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [Dbref of element to search]
--   [2] [R]    [list of element types to search for]
-- Return:
--   [Data Type] [Description]
--
--   [DBREF]     [Dbref of valid owner]
--
------------------------------------------------------------------------

define function !!dtbGetOwnerType(!element is DBREF, !list is ANY) is DBREF

  !owner = object DBREF()

-- handle passed argument as a string

  if(!list.objectType().eq('STRING')) then
    !arrayList = !list.split()
  else
    !arrayList = !list
  endif

  -- add passed ref to the inverted list

     !ownerList = !element.ownLst.invert()
     -- We need a special case for TUBI to add the BRAN (because for the TUBI from BRAN, BRAN is not normally in the .OWNLST)
     if (!element.type eq 'TUBI') then
     	 !ownerList.insert(1,!element.owner)
     endif
     !ownerList.insert(1,!element)

  -- loop through Owners and check if type exists in passed array

  do !owners values !ownerList

    !index = !arrayList.findFirst(!owners.type)

    if(!index.unset().not()) then
      !owner = !owners
      break
    endif
  enddo

  -- return the owner dbref (unset if not found)

     return !owner

endfunction
-- End of function definition for !!dtbGetOwnerType
