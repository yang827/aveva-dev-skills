-- Author:          N.Holmes
-- Created:         Fri Aug 21 16:44:30 BST 1998
--
--
-- Description:
-- Returns the <nth> offspring of the given type.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be searched
--    2   R      STRING      Element type to be searched for
--    3   R      REAL        <nth> occurrence of type
-- Return:
--   [Data Type] [Description]
--    DBREF       Element found
--
------------------------------------------------------------------------

define function !!dtbMemberOfType(!element is DBREF, !type is STRING, !index is REAL) is DBREF

  -- Initialise Variables

  -- Collect all element types if passed type
  !block = object BLOCK('!element.members[!evalIndex].type.upcase()')
  !types = !element.members.evaluate(!block)
  handle any
    return object DBREF()
  endhandle

  -- Return unset if there is no elements
  if(!types.empty()) then
    return object DBREF()
  endif

  -- Get all occurrences from the block of the passed type
  !indices = !types.find(!type)

  -- If there are no elements of the passed type in the list, then return unset
  if(!indices.empty()) then
    return object DBREF()
  endif


  -- If number is > than available, return unset
  if(!index gt !indices.size()) then
    return object DBREF()
  endif

  -- Return relevant item
  return !element.members[!indices[!index]]

endfunction
-- End of function definition for !!dtbMemberOfType
