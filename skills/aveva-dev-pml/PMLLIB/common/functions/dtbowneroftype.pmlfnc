--
--
-- Description:
-- Returns the element where the passed type can be created.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be tested
--    2   R      STRING      Element type to be created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!dtbOwnerOfType(!element is DBREF, !type is STRING) is DBREF

  -- Initialise Variables
  !owner       = !element
  !elementType = !type.upcase()

  -- Loop through until we hit an element that can have the "type" in
  -- its members or we hit the top
  do

    if(!owner.list.findFirst(!elementType).set()) then
      return !owner
    endif

    if(!owner.fullType eq 'WORLD') then
      return object DBREF()
    endif

    !owner = !owner.owner
  enddo

endfunction
-- End of function definition for !!dtbOwnerOfType
