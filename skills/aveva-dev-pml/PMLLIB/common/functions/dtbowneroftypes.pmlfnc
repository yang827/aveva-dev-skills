--     Keyword:     DTB
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Thu Aug 27 9:29:13 BST 1998
--
--
-- Description:
-- Get owner of passed element that matches one of the array of types passed
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to find owner of
--    2   R      ARRAY       ARRAY of permissible types to find in order of preference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!dtbOwnerOfTypes(!element is DBREF, !types is ARRAY) is DBREF

  -- set default no owner
  !owner = object DBREF()

  if (NOT !element.badref() ) then
    -- get number of owners
    !ownerList = !element.ownLst

    -- put the world at the top of the list
    !ownerList.insert(1, WORLD)

    -- invert the array and put the passed element at the top of the list
    !ownerList.invert()
    !ownerList.insert(1, !element)

    -- find the first element that matches one of the permissible types
    do !dbElement values !ownerList
      if (!types.findFirst(!dbElement.type.upcase()).set()) then
        !owner = !dbElement
        break
      endif
    enddo

  endif

  return !owner

endfunction
-- End of function definition for !!dtbOwnerOfTypes
