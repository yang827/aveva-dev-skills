--   Group:         Database routines
--     Keyword:     DTB
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Fri Aug 7 17:01:18 BST 1998
--
--
-- Description:
-- Returns the item in the parent structure of the passed element, that
-- has the passed attribute, including itself.
--
-- NOTE, this will look for pseudo attributes.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to look from
--    2   R      STRING      Attribute name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!dtbWithAttribute(!element is DBREF, !attribute is STRING) is DBREF

  -- Initialise Variables
  !attrib = !attribute.upcase()
  !owner  = !element

  -- Loop through element until the attribute has been found
  do

    !unusedData = !owner.attribute(!attrib)
    handle any
      if(!owner.fullType eq 'WORLD') then
        return object DBREF()
      endif
      !owner = !owner.owner
    elsehandle none
      return !owner
    endhandle
  enddo

endfunction
-- End of function definition for !!dtbWithAttribute
