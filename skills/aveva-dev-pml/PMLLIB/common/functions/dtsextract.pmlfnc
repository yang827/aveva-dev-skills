--
-- Author:          A.Kirkland
-- Created:         Thu Aug 28 14:36:29 BST 1997
--
--
-- Description:
-- Function to replace RDDSE
-- Get all data set elements for the given dbRef passed
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--   [1] [R]    [dbRef]   [Either TMPL/DDSE or SPCO reference to get data from]
--   [2] [RW]   [String]  [No Alert error message for Error Status]
--   [3] [RW]   [dbRef]   [Dataset element (DDSE) below TMPL]
--   [4] [RW]   [Array]   {Array of Dataset Records]
-- Return:
--   [Data Type] [Description]
--   [Boolean]   [Error Status if no DDAT are found]
--
------------------------------------------------------------------------

-- Define function
define function !!dtsExtract(!gidPassed is DBREF, !message is STRING, !dataset is DBREF, !dataRecords is ARRAY) is BOOLEAN


-- Initialise Status Variables

   !return = True

-- Clear RW argument list
   !message       = object STRING()
   !dataRecords   = object ARRAY()
   !dataset       = object DBREF()

-- See if we are at a DDSE or below one
-- ***** OLD SYTLE PML *****
   !ddse[1] = (DDSE of $!gidPassed )
   handle any

-- If the <gid> passed is to a SPCO, then we need to see
-- if we can get the DDSE of the TMPR of the item
-- ***** OLD SYTLE PML *****
   !ddse[1] = (DDSE1 of TMPR of $!gidPassed )
    handle any

-- if we are at a TMAR, then don't continue
    if(!gidPassed.type eq |TMAR|) then
       !return = False
       !message =    |No dataset found.|
        return false
    endif

-- If we are at a TMPL, then see if there is a DDSE beneath
     if(!gidPassed.type eq |TMPL| or !gidPassed.owner.type eq |DDAR|) then
-- ***** OLD SYTLE PML *****
        !ddse[1] = (DDSE 1 of $!gidPassed )
        handle any
         !return = False
         !message =   |No dataset found.|
         return false
        endhandle

-- See if item itself has a TMPL and/or a DDSE
     else

-- Get TMPL of item
-- ***** OLD SYTLE PML *****
       !ddse[1] = (DDSE 1 of TMPL 1 of $!gidPassed )
       handle any
       endhandle

     endif
    endhandle
   endhandle

-- No Data set found
 if(undefined(!ddse)) then
   !return = False
   !message =  |No dataset found.|
   return false
 endif


-- ***** OLD SYTLE PML *****
     var !ddat APPEND COLLECT ALL DDAT FOR $!ddse[1]

-- No Data element
 if(!ddat.size() eq 0) then
   !return = False
   !message =    |Dataset contains no members.|
 else
   !dataRecords = !ddat
 endif

-- return values via the argument list
   !dataset = !ddse[1]
   !message = 'Data Records successfully found.'

return  !return

endfunction
-- End of function definition for !!dtsExtract
