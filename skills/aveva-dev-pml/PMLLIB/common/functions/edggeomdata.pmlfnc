--
--
-- Description:
-- Wrapper for returns from EDG system to "PDMSUI" implementation of EDG
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Function to be executed
--    2   R      ARRAY       Return Data from new edg system
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!edgGeomData(!action is STRING, !results is ARRAY)

  -- Load _cdGeomData with the relevant information
  -- Empty Item line
  var list _cdGeomData_item clear
  exit
  -- Load Item list
  if(!results[1].items.size() gt 0) then
    do !i indices !results[1].items
      var list _cdGeomData_item add |$!results[1].items[$!i]| exit
    enddo
  elseif (!results[1].item.set()) then
    var list _cdGeomData_item add |$!results[1].item| exit
  endif

  -- Position
  !newPosition = !results[1].position.wrt(world)

  var _cdGeomData_x     |$!newPosition.east|
  var _cdGeomData_y     |$!newPosition.north|
  var _cdGeomData_z     |$!newPosition.up|

  var _cdGeomData_dir   |$!results[1].direction|
  !pickLine = |line | & !results[1].pointVector.direction & | through | & !results[1].pointVector.position
  var _cdGeomData_lin   |$!pickLine|
  var _cdGeomData_type  |$!!edgCntrl.pickData.type|

  if(!!edgCntrl.pickData.type eq |PLINE|) then
    var _cdGeomData_data |$!results[1].pLine|
  elseif (!!edgCntrl.pickData.type eq |PPOINT|) then
    var _cdGeomData_data |$!results[1].pPoint|
  endif

  -- Get full pathname for runSynonym.pmlmac
  !runSynonym = !!pml.getPathName('runsynonym.pmlmac')

  -- Execute Function
  $m "$!runSynonym" $<$!action$>

endfunction
-- End of function definition for !!edgGeomData
