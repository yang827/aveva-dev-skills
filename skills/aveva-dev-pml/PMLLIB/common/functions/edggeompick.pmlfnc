--
--
-- Description:
-- Wrapper for returns from EDG system to "PDMSUI" implementation of EDG
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Function to be executed
--    2   R      ARRAY       Return Data from new edg system
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!edgGeomPick(!action is STRING, !results is ARRAY)

  -- Load _cdGeomPick with the relevant information
  var _cdGeomPick_item '$!results[1].item'

  !pickLine = 'line ' & !results[1].pickLine.direction & ' through ' & !results[1].pickLine.position
  var _cdGeomPick_vec   |$!pickLine|
  var _cdGeomPick_type  '$!!edgCntrl.pickData.type'


  if(!!edgCntrl.pickData.type eq 'PLINE') then
    var _cdGeomPick_data '$!results[1].pLine'
  elseif (!!edgCntrl.pickData.type eq 'PPOINT') then
    var _cdGeomPick_data '$!results[1].point'
  endif

  -- Get full pathname for runSynonym.pmlmac
  !runSynonym = !!pml.getPathName('runsynonym.pmlmac')

  -- Execute Function
  $m "$!runSynonym" $<$!action$>

endfunction
-- End of function definition for !!edgGeomPick
