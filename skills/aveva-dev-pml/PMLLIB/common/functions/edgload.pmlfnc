-- Define function
define function !!edgLoad()

  -- Library  of appware functions/methods
  call !!comDefineGlobal(object APPMATHLIB())

  -- Edg Types object
  call !!comDefineGlobal(object EDGTYPES())

  -- Graphic View Control
  call !!comDefineGlobal(object GPHVIEWS())

  -- Create drawlists global variable
  call !!comDefineGlobal(object GPHDRAWLISTS())

  -- Graphic View Option
  call !!comDefineGlobal(object GPHVIEWOPT())

  -- Edg Control object
  call !!comDefineGlobal(object EDGCNTRL())

  -- Load Rule system

  -- Force load critical forms
  pml reload form !!edgElementFilter
  pml reload form !!edgPlineFilter
  pml reload form !!edgPointFilter

  -- Add design graphics view
if (defined(!!modLoadMethod)) then
 if (!!modLoadMethod) then
  !restore = true
  -- Add design graphics view if there have been no views recreated by the appformcntrl
  do !i values !!appFormCntrl.formsToConstruct
    if (!i.matchwild('GPH3DDESIGN*')) then
      !restore = false
      break
    endif
  enddo
  if (!restore) then
    !!gphViews.addDesign()
  endif
 else
  !!gphViews.addDesign()
 endif
else
 !!gphViews.addDesign()
endif

endfunction
-- End of function definition for !!edgLoad
