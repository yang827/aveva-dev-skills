--
--  Description:     Shows EDG ship position form for Marine and standard form for Plant
--
----------------------------------------------------------------------
define function !!edgPosition()

  !mm = object AVEVAMODULEMANAGER()
  if ( !mm.currentProductName().upcase().eq('HULL & OUTFITTING') ) then
    -- load ship grid position
    show !!edgShipPosition free
  else
    -- load PDMS position
    show !!edgEPosition free
  endif

endfunction
