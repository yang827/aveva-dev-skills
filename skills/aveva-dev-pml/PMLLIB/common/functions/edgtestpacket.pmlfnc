-- Define function
define function !!edgTestPacket() is EDGPACKET

  -- Define Packet
  !packet = object EDGPACKET()
  !packet.definePosition('Position')
  !packet.action = '!!edgTestAction(!this.return[1])'

  return !packet

--  !!edgCntrl.add(!packet)

endfunction
-- End of function definition for !!edgTestPacket
