--
--
-- Description:
-- Wrapper for returns from EDG system to !!edgGeomData object
-- (old edg handler).
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Function to be executed
--    2   R      ARRAY       Return Data from new edg system
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!edgWrapper(!action is STRING, !results is ARRAY)

  -- Define global object for old edg system
  if(undefined(!!edgGeomData)) then
    !!edgGeomData = object EDGGEOMDATA()
  endif

  -- Write results (edgPositionData) to !!edgGeomData object
  if(!results[1].objectType() eq 'EDGPOSITIONDATA') then
   !!edgGeomData.position   = !results[1].position
    !!edgGeomData.items      = !results[1].items
    !!edgGeomData.pickedItem = !results[1].item
    !!edgGeomData.pLineKey   = !results[1].pLine

    -- Write results (edgPickData) to !!edgGeomData object
  elseif (!results[1].objectType() eq 'EDGPICKDATA') then
    !!edgGeomData.pickedItem           = !results[1].item
    !!edgGeomData.pLineKey             = !results[1].pLine
    !!edgGeomData.number               = !results[1].point
    !!edgGeomData.pickVector.direction = !results[1].pickLine.direction
    !!edgGeomData.pickVector.position  = !results[1].pickLine.position

    -- If item picked is a panel/extrusion/negative extrusion
    -- and type is PPOINT, then populate nearest vertex
    if(!results[1].item.hardType inset('PANE','EXTRU','NXTR', 'REVO', 'NREV') and !results[1].type inset('PPOINT')) then

      -- Panel loop
      if(!results[1].item.hardType eq 'PANE') then
        !loop = PLOO 1 of $!results[1].item
      else
        !loop = LOOP 1 of $!results[1].item
      endif

      !!edgGeomData.nearestVertex  = !loop.member[!results[1].point]

    endif

  endif

  -- Execute Function
  call !!runSynonym(!action)

endfunction
-- End of function definition for !!edgWrapper
