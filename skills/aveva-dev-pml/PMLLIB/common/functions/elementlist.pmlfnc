--
-- Description:
-- Navigates to selected item and displays the detail text.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!elementList()

  -- Initialise Variables
  !index                   = !!elementList.list.selection('RTEXT').real()

  -- Navigate to the selected item
  !!ce                     = !!elementList.details[!index].element

  -- Display the
  !!elementList.detail.val = !!elementList.details[!index].detail

endfunction
-- End of function definition for !!elementList
