--
--
-- Description:
-- Loads the contents of the Detail list into the display gadgets.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!elementListInit()

  -- Initialise Variables
  !dText      = ARRAY()
  !rText      = ARRAY()

  -- Load DBREFTEXT elements into lists
  !block      = object BLOCK('!!elementList.details[!evalIndex].brief')
  !briefText  = !!elementList.details.evaluate(!block)
  !block      = object BLOCK('!!elementList.details[!evalIndex].element.flnn')
  !elements   = !!elementList.details.evaluate(!block)

  -- Max width of Brief description
  !maxWidth   = !briefText.width()

  -- Build list of brief + full element name to show
  do !i indices !elements

    var !display COMPOSE SPACE 2 |$!briefText[$!i]| WIDTH $!maxWidth C SPACE 2 |-| SPACE 2 |$!elements[$!i]|
    !dText[!i] = !display[1]
    !rText[!i] = !i.string()
  enddo

  -- Load Display
  !!elementList.list.dText = !dText
  !!elementList.list.rText = !rText

  -- Select the first item
  call !!elementList()

endfunction
-- End of function definition for !!elementListInit
