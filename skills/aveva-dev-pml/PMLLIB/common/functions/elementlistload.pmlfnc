--
--
-- Description:
-- Loads the Element List form with the elements, brief display
-- text and the detail text.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORMDATA    Form data
--    2   R      ARRAY       Array of element text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!elementListLoad (!form is FORMDATA, !list is ARRAY)

  -- Set form up
  !!elementList.formTitle = !form.formTitle

  -- Load Details with passed array
  !!elementList.details   = !list

  -- If show is passed and set to true, then display the form
  if(!form.show.set()) then
    if(!form.show) then

      if(!!elementList.shown()) then
        call !!elementListInit()
      else
        show !!elementList
      endif
    endif
  endif

endfunction
-- End of function definition for !!elementListLoad
