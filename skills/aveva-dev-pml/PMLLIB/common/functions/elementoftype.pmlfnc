--
-- File:            elementoftype.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:      NEXT/PREV <type> <val> OF <gid>
--
-- Author:          N.Holmes
-- Created:         Fri Apr 4 13:48:26 WAT 1997
--
--
-- Description:
-- Returns the <nth> item of the given <type> with respect to the passed
-- item.  If no type is given, the <nth> relative item  will be returned.
--   -ve value means search backwards (previous)
--   +ve value means search forwards  (next)
--
--    !item = !!elementOfType('',1,!!ce)           return the next item
--    !item = !!elementOfType('',-1,!!ce)          return the previous item
--    !item = !!elementOfType('ignored',0,!!ce)    return the item
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of item being searched for forwards/backwards
--    2   R      REAL        The <nth> instance of the type
--    3   R      DBREF       The element look from
-- Return:
--   [Data Type] [Description]
--    DBREF       Item found
--
------------------------------------------------------------------------

-- Define function
define function !!elementOfType (!type is STRING, !nthType is REAL, !rootItem is DBREF) is DBREF

  -- Initialise Variables
  !index       = !nthType
  !owner       = !rootItem.owner
  !returnDbRef = object DBREF()

  -- If NthType is zero, then return the current element
  if(!index eq 0) then
     return !owner
  endif

  -- Nth item is greater than the number of members, then return
  if(!index.abs() gt !owner.mCount) then
    return !returnDbRef
  endif

  -- Split Members list into items before/after Root

  -- Get items after Root
  if(!index gt 0) then
    !members = !owner.members.from(!rootItem.seq + 1)

  -- Get items before Root
  else
    !members = !owner.members.to(!rootItem.seq - 1)
    !members.invert()
    !index   = !index.abs()
  endif

  -- Return if index > Members list
  if(!index gt !members.size()) then
    return !returnDbRef
  endif

  -- If no Type is passed, then return the relevant entry
  if(!type.trim().empty()) then
    !returnDbRef = !members[!index]
    return !returnDbRef
  endif

  -- Get types of members of search item
  !block   = object BLOCK('!members[!evalIndex].type')
  !types   = !members.evaluate(!block)

  -- Get all entries of the passed type
  !instances = !types.find(!type.upcase())

  -- Return if there are no instances found
  if(!instances.size() lt !index) then
    return !returnDbRef
  endif

  -- Get the <nth> entry from the instance list
  !instance  = !instances[!index]
  !returnDbRef = !members[!instance]
  return !returnDbRef

endfunction
-- End of function definition for !!elementOfType
