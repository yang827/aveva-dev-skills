-- File:            evarsplit.pmlfnc
--   Type:          Function Definition
--   Group:          General
--     Keyword:
--   Module:
--   Replaces:      var !evar EVAR command
--                       !evars split  !evar
--
-- Author:          G.Somasundaram
-- Created:        Wed  29 Aug 2007 05:00 GMT
--
--
-- Description:
--  returns an array of values set for the passed Environment variable name (e.g) PDMSUI/ PDMSDFLTS
--  to handle settings delimited with spaces (where file name don't have spaces
--  and delimited with ; (where file names can have spaces
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Environment variable name
-- Return:
--   [Data Type] [Description]
--    1   R      STRING      values assigned to evar
--
------------------------------------------------------------------------

-- Define function
define function !!evarSplit(!evar is STRING) is ARRAY

  if (!evar.trim() eq ||) then
    !fields = object ARRAY()
  else
    var !row EVAR '$!evar'
    if (!row.match(|;|).gt(0) ) then
      !fields = !row.split(|;|)
    else
      !fields = !row.split()
    endif

    do !i indices !fields
       !file = object FILE(!fields[!i])
       if (!file.unset() ) then
          !fields.deletefrom(!i , 1)
        endif
    enddo
    !fields.compress()
  endif

  return !fields

endfunction
-- End of function definition for !!evar
