--
-- Description:
-- Export Grid data to Excel
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Pline
--    2   R      DBREF       Element
--    3   R      REAL        ZDistance
--    4   R      REAL        Number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

import 'PMLFileBrowser'
handle any
endhandle

import 'GridControl'
handle any
endhandle

define function !!exportToExcel(!dataGrid is ANY, !fileName is STRING, !title is STRING)

	using namespace 'Aveva.Pdms.Presentation'

	if (!title eq '') then
		!title = 'Save As'
	endif
	
	if !dataGrid.getNumberRows().eq(0) then
    !!alert.warning('No data to export.')
  else
    !browser = object PMLFILEBROWSER('SAVE')
    --!browser.show('%PDMSUSER%', !fileName, !title, false, 'Microsoft Excel Files (*.xls)|*.xls',1)
    --!browser.show('', !fileName, !title, false, 'Microsoft Excel Files (*.xls)|*.xls|CSV Files (*.csv)|*.csv',1)
    !browser.show('', !fileName, !title, false, 'Microsoft Excel Files (*.xls)|*.xls',1)
    -- Test for no returned filename (i.e. if cancel button is used)
    if (!browser.file().neq('')) then
      --!this.prevSaveLocation = !browser.file().replace(|\|, |\///|, -1, 1).before(|///|)
      !dataGrid.saveGridToExcel(!browser.file())
      handle (1000, 0)
        !!alert.warning('Unable to write to file.  File is in use.')
      endhandle
    endif
  endif
endfunction
