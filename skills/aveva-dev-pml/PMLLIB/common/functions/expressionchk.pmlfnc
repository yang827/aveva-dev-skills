--
--
-- Description:
-- function to check a valid expression for attribute setting
-- Uses the new !!error member .command to alert an invalid expression
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [ANY]     [Element to test the expression against]
--   [2] [R]    [STRING]    [Expression entered into the GADGET]
--   [3] [R]    [STRING]    [The Attribute to set the expression against]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!expressionchk(!element is ANY, !expression is STRING, !attribute is STRING)

-- save position in hierarchy
  !oldRef = !!ce

-- Pass either a DBREF or a Form definition to use the userdata reference
   if(!element.objectType().eq('DBREF')) then
     -- DBREF passed
        !ref = !element
   elseif(!element.objectType().eq('STRING') and !element.eq(||)) then
        !ref = !!ce
   else
     !ref = !element.dbRef()
     handle ANY
     -- form passed (this hack is to get the old userdata)
        !formName = '_' + !element.name()
        !elementAsString = '$$$!formName$n_userdata'
        $!elementAsString
         handle ANY
         endhandle
         !ref = !!ce
     endhandle

   endif

-- navigate to the dbRef
   !!ce = !ref

-- if the expression is null then no expression has been entered in the gadget
   if(!expression.eq('')) then
    -- nothing to check
       !!ce = !oldRef
       return
   endif

-- try the expression on the attribute
   var !oldValue $!attribute
   handle ANY
     -- in case too high up (GMSE etc.) and therefore the !ref will not have the attribute
   endhandle

-- special case for a LINE element          (There may be more)
   if(!attribute.upcase().eq('PTS')) then
      !realAttribute = 'SETPOINT'
   else
      !realAttribute = !attribute
   endif

  $!realAttribute $!expression
   handle (41,232)(2,25)
    -- in create mode (41,232) is not at correct element
    --                (2,25)   is Read Only DB
   elsehandle ANY
      !reason  = !!error.text
      !command = !!error.command
      !!ce     = !oldRef
       return error 1 '$!reason

 $!command'
   elsehandle NONE
     -- set the value back
     $!realAttribute $!oldValue
     handle ANY
       -- in case old value did not get set because too high up (GMSE etc.)
     endhandle
   endhandle

-- go back to the saved position
  !!ce = !oldRef

endfunction
-- End of function definition
