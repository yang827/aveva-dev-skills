--     Keyword:     COMMON
--   Module:        design
--   Replaces:
--
-- Author:          A.Kirkland
-- Created:         Wed sep 18 14:13:08 BST 2002
--
--
-- Description:
-- function to check a valid expression1 for the list form
-- Uses the new !!error member .command to alert an invalid expression1
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [ANY]       [Element to test the  collection]
--   [2] [R]    [STRING]    [expression1 entered into the GADGET (type)]
--   [3] [R]    [STRING]    [expression2 entered into the GADGET (with)]
--   [4] [R]    [GADGET]    [Gadget that is being tested]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!expressionListChk(!element is ANY, !expression1 is STRING, !expression2 is STRING, !gadget is GADGET)


-- get the element to collect on, if the data is set in the form (_ITEM)
   if(!element.eq('')) then

    -- create a temporary array to speed up collection

    !array = ARRAY()
    !string = ' from !array'

   else

      !ref = !element.dbRef()
      handle ANY
        -- in case doesn't exist
        !ref = !!ce
      endhandle
      -- convert to a PDMS name for easy reading

      !name = !ref.name
      !string = ' for $!name'
   endif


-- if the expressions are null then no expression has been entered in the gadget
   if(!gadget.name().upcase().eq('TYPE')) then
      if(!expression1.eq('')) then
       -- nothing to check
          return
      endif
   elseif(!gadget.name().upcase().eq('RULE')) then
      if(!expression2.eq('')) then
       -- nothing to check
          return
      endif
   endif

-- test the expression

if(!gadget.name().upcase().eq('TYPE')) then
   var !test COLL ALL ( $!expression1 ) $!string
      handle (47,15)
        !!alert.error('Enter any valid element type for this field')
        return
      elsehandle ANY
        !reason  = !!error.text
        !command = !!error.command
         return error 1 '$!reason

   $!command'
      endhandle
elseif(!gadget.name().upcase().eq('RULE')) then
  if(!expression1.upcase().eq('ALL')) then
    var !test COLL ALL  with ( $!expression2 ) $!string
       handle (47,15)
        !!alert.error('Enter any valid rule for this field')
        return
      elsehandle ANY
        !reason  = !!error.text
        !command = !!error.command
         return error 1 |$!reason

   $!command|
      endhandle
  else
     var !test COLL ALL ( $!expression1 ) with ( $!expression2 ) $!string
      handle (47,15)
        !!alert.error('Enter any valid element type or expression  for this field')
        return
      elsehandle ANY
        !reason  = !!error.text
        !command = !!error.command
         return error 1 |$!reason

   $!command|
      endhandle
  endif
endif

endfunction
-- End of function definition
