--
--
-- Description:
-- Function to display the files (against a filter) in the
-- selected directory using the file browser form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     Directory path
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!fileBrowserFile(!path is STRING)

  !directory = object FILE(!path)
  !files = !directory.files()

  ------
  -- Filter the created list
  ------
  -- Check that the filter value is not blank
  if (!!fileBrowser.filter.val.empty()) then

    !!fileBrowser.filter.val = |*|

  endif

  -- Loop through file list
  do !i indices !files
    -- See if file matches filter
    if (not !files[!i].entry().matchWild(!!fileBrowser.filter.val)) then
      -- Delete the entry from the list
      !files.deleteFrom(!i,1)
    endif
  enddo

  -- Reconstruct the file list
  !files.compress()

  !dText = ARRAY()
  do !file values !files
    !dText.append(!file.entry())
  enddo
  !!fileBrowser.fileList.dText = !dText

  -- Check the current file specification
  call !!fileBrowserSel(!!fileBrowser.selectedFile)

endfunction
-- End of function definition for !!fileBrowserFile
