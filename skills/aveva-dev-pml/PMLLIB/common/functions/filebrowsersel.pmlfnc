--
--
-- Description:
-- Function to resolve a file selection by the user.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!fileBrowserSel(!gadget is GADGET)

  -- Initialise variables

  !delimiter = '\'

  -- Check which gadget callback was made from
  if (!gadget.name() eq |FILELIST|) then

    !!fileBrowser.selectedFile.val = !!fileBrowser.fileList.selection(|DTEXT|)

  elseif (!gadget.name() eq |SELECTEDFILE|) then

    -- Try to select the current file
    !!fileBrowser.fileList.select(|DTEXT|,!gadget.val)
    handle any

      -- File does not exists in list
      !!fileBrowser.fileList.val = 1
      handle any

        if (!!fileBrowser.existFlag) then

          -- File must exist so blank it out
          !gadget.val = ||

        endif

      elsehandle none

        if (!!fileBrowser.existFlag) then

          -- Use first file in list
          !gadget.val = !!fileBrowser.fileList.selection(|DTEXT|)

        endif

      endhandle

    endhandle

  endif

  -- Set the filename form member
  if (!!fileBrowser.selectedFile.val.empty()) then

    -- No filename selected
    !!fileBrowser.file = !!file(||)
    !!fileBrowser.ok.active = false

  else

    -- Create full filename
    !!fileBrowser.file = !!file(!!fileBrowser.directory & !delimiter & !!fileBrowser.selectedFile.val)
    !!fileBrowser.ok.active = true

  endif

endfunction
-- End of function definition for !!fileBrowserSel
