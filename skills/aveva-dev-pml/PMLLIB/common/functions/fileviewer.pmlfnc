--   Module:        common
--   Replaces:
--
-- Author:          E.conba
-- Created:         Tue Apr 22 09:12:56 BST 1997
--
--
-- Description:
-- Function to display the contents of a text file.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Filename
--    1   R      STRING      Title of form (if blank will use file name)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!fileViewer(!filename is STRING, !title is STRING)

  -- Initialise variables
  !file    = object FILE()
  !lines   = ARRAY()

  -- Clear the old contents
  !!fileViewer.contents.clear()

  -- Check that the file is valid and exists
  !file.file(!filename)
  if (!file.exists().not() or !file.type() eq |DIRECTORY|) then

    -- Invalid file
    return

  endif

  -- Read the contents of the file
  !lines   = !file.readFile()
  handle (160,47)
    -- File Length has exceeded 10000 lines
    !!fileViewer.lineCount.val = |Total No. of Lines = 10000+|
    !!alert.message('File has exceeded 10000 lines. Cannot view ' + !file.name() + ' using the PDMS file viewer. Use a suitable editor')
    !file.close()
    return
  endhandle

  -- The 'Add the lines to the textpane' must remove trailing blank lines so we need to deal with this first.
  do
    if (!lines.size() gt 0 and !lines[!lines.size()] eq '') then
      !lines[!lines.size()].delete()
    else
      break
    endif
  enddo

  -- Add the lines to the textpane
  !!fileViewer.contents.val  = !lines
  !!fileViewer.lineCount.val = |Total No. of Lines = |& !!fileViewer.contents.count

  -- Check if file has been truncated because of the 32000 character limit
  !contents = !!fileViewer.contents.val
  if (!lines.size() gt !contents.size()) then
    !!alert.message('Screen view has been truncated at line ' + !contents.size().string() + ' of ' + !lines.size().string() + '. View the $
complete file ' + !file.name() + ' using a suitable editor.')
  endif

  -- Set the form title
  if (!title.empty()) then

    !!fileViewer.formTitle = |File Viewer: |& !file.fullName()

  else

    !!fileViewer.formTitle = !title

  endif

  -- Display the form
  show !!fileViewer
  if(!!fileViewer.contents.val.set())then
    -- Put cursor at top of file
    !position[1] = 1
    !position[2] = 0
    !!fileViewer.contents.setCurPos(!position)
    !!fileViewer.contents.setFocus()
  endif

endfunction
-- End of function definition for !!fileViewer
