--
--
-- Description:
-- Function search the displayed file for a specific string.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     true = forwards, false = reverse
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!fileViewerSearch(!direction is BOOLEAN)

  -- Initialise variables
  !currentPos   = !!fileViewer.contents.curPos()
  !currentLine  = !currentPos[1]
  !lineCount    = !!fileViewer.contents.count
  !searchString = |*|& !!fileViewer.search.val & |*|
  !found        = BOOLEAN()

  -- Check for empty string
  if (!searchString eq |**|) then
    return
  endif

  -- Set the previous string
  if (!!fileViewer.search.val eq !!fileViewer.prevString) then
    !next = true
  else
    !next = false
    !!fileViewer.prevString = !!fileViewer.search.val
  endif

  -- Search the file
  if (!direction) then

    -- Search Forwards
    !found       = false

    -- Loop from current position to end
    do !i from (!currentLine + 1) to !lineCount

      !line          = !!fileViewer.contents.line(!i)
      skip if (!line.empty())
      skip if (!line.match(|*|) gt 0)

      if (!line.matchWild(!searchString)) then
        !found       = true
        !newline     = !i
        break
      endif

    enddo

    -- If no match do the rest of the file
    if (not !found and !currentLine gt 1) then

      -- Loop from start to current position
      do !i from 1 to (!currentLine - 1)

        !line        = !!fileViewer.contents.line(!i)
        skip if (!line.empty())
        skip if (!line.match(|*|) gt 0)

        if (!line.matchWild(!searchString)) then
          !found       = true
          !newline     = !i
          break
        endif

      enddo

    endif

  else

    -- Search Backwards
    -- Search Forwards
    !found       = false

    -- Loop from current position to end
    if (!currentLine gt 1) then

      do !i from (!currentLine - 1) to 1 by -1

        !line          = !!fileViewer.contents.line(!i)
        skip if (!line.empty())
        skip if (!line.match(|*|) gt 0)

        if (!line.matchWild(!searchString)) then
          !found       = true
          !newline     = !i
          break
        endif

      enddo

    endif

    -- If no match do the rest of the file
    if (not !found and !currentLine gt 1) then

      -- Loop from start to current position
      do !i from !lineCount to (!currentLine + 1) by -1

        !line        = !!fileViewer.contents.line(!i)
        skip if (!line.empty())
        skip if (!line.match(|*|) gt 0)

        if (!line.matchWild(!searchString)) then
          !found       = true
          !newline     = !i
          break
        endif

      enddo

    endif

  endif

  -- Did we match a line
  if (!found) then

    -- Set the new current line position
    !currentPos[1] = !newline
    !currentPos[2] = 0
    !!fileViewer.contents.setFocus()
    !!fileViewer.contents.setCurPos(!currentPos)

  else

    -- No line was found
    if (!next) then
      !!alert.error(|No more occurrences found.|)
    else
      !!alert.error(|Search string not found in file.|)
    endif
    !!fileViewer.contents.setFocus()

  endif

endfunction
-- End of function definition for !!fileViewerSearch
