--
--  Description:
--
----------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      pointer to a range gadget
--    2   R      GADGET      pointer to a value gadget
--    3   R      CRITERION   criterion object
--   [Data Type] [Description]
-- Return:
------------------------------------------------------------------------

define function !!fillCriterionGadgets(!rangeGadget is GADGET, !valueGadget is GADGET, !criterion is CRITERION)

  -- evaluates the default value
  ---------------------------------------------------------------------------
  -- optimum
  if ( !criterion.optimum.set() ) then
    !value = !criterion.optimum()

  -- valid values
  elseif ( !criterion.validValues.set() ) then
    !value = !criterion.validValues.first()

  -- max
  elseif ( !criterion.max.set() ) then
    !value = !criterion.max()

  -- min
  elseif ( !criterion.min.set() ) then
    !value = !criterion.min()

  else
    !value = 0
  endif

  -- make the gadget decision
  ---------------------------------------------------------------------------
  -- use the value gadget
  if ( !criterion.validValues.set() or $
       !rangeGadget.unset() ) then

    if ( !rangeGadget.set() ) then
      !rangeGadget.visible = false
    endif
    !valueGadget.visible = true


    !dText = object ARRAY()
    if ( !criterion.validValues.set() ) then
      do !validValue value !criterion.validValues
        !dText.append(!validValue.string())
      enddo
    -- no range gadget, option gadget must be used
    elseif ( !rangeGadget.unset() ) then
      -- evaluates the maximum
      if ( !criterion.max.set() ) then
        !maxValue = !criterion.max()
      else
        !maxValue = 30
      endif

      -- evaluates the minimum
      if ( !criterion.min.set() ) then
        !minValue = !criterion.min()
      else
        !minValue = 1
      endif

      !dText = object ARRAY()
      do !i from !minValue to !maxValue
        !dText.append(!i.string())
      enddo
    endif

    if ( !valueGadget.dText.neq(!dText) ) then
      !valueGadget.dText = !dText
      !valueGadget.select('RTEXT', !value.string())
      handle ANY
      endhandle
    endif

  -- use the range gadget
  else
    !rangeGadget.visible = true
    if ( !valueGadget.set() ) then
      !valueGadget.visible = false
      !valueGadget.clear()
    endif

    -- evaluates the maximum
    if ( !criterion.max.set() ) then
      !maxValue = !criterion.max()
    else
      !maxValue = 1000000
    endif

    -- evaluates the minimum
    if ( !criterion.min.set() ) then
      !minValue = !criterion.min()
    else
      !minValue = 0
    endif

    -- assign the valid call
 --   !rangeGadget.validateCall = '!!criterionMinMax(' & !rangeGadget.fullName() & '.val , ' & !minValue & ',' & !maxValue & ')'
--    !rangeGadget.val          = !value
    -- checks the criterions


    !min       = !criterion.min()
    !max       = !criterion.max()
    !optimum   = !criterion.optimum()

    !format     = !rangeGadget.format

    if ( !criterion.setstatemax.set() and !criterion.setstatemin.set() ) then
      if ( !criterion.setstatemax and !criterion.setstatemin ) then
       !rangeGadget.setTooltip('Minimum: ' & ' ' & !min.string(!!$!<format>) & ' ' & 'Maximum: ' & ' ' & !max.string(!!$!<format>) )
      elseif ( !criterion.setstatemax and !criterion.setstatemin.not() ) then
       !rangeGadget.setTooltip('Minimum: 0 '  & ' ' & 'Maximum: ' & !max.string(!!$!<format>) )
      elseif ( !criterion.setstatemax.not() and !criterion.setstatemin ) then
       !rangeGadget.setTooltip('Minimum: ' & !min.string(!!$!<format>))
      elseif ( !criterion.setstatemax.not() and !criterion.setstatemin.not() ) then
       !rangeGadget.setTooltip('Minimum: 0 ' )
      endif
    endif

  endif

endfunction
