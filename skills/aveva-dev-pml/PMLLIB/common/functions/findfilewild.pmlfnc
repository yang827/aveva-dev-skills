-- File:            findfilewild.pmlfnc
--   Type:          Function Definition
--   Group:         File Handling
--     Keyword:     FILE
--   Module:        common
--   Replaces:
--
-- Author:          C.J.Fellows
-- Created:         28 Jan 1998
--
--
-- Description:
-- Returns an array of strings for all the files found in a given search-path
-- which may include wild-cards. This function does NOT create FILE objects,
-- since further processing may be required before the files are accessed
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name of directory to be scanned
--    2   R      STRING      Filename to be searched with wildcard characters
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of strings    Full name of Files found
--
------------------------------------------------------------------------

-- Define function
define function !!findFileWild (!dirName is STRING, !rootFile is STRING) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()

  !dir = object FILE(!dirName)

  -- P-31886 Ensure invalid paths are handled elegantly and reported
  if (!dir.exists().not()) then
		WRITE('Directory not found [$!dirName]')
		return !returnArray
  endif

  !rootFileUpcase = '*' & !rootFile.upcase()
  do !file values !dir.files()
    !fileName = !file.name()
    !fileNameUpcase = !file.name().upcase()
    skip if (!fileNameUpcase.matchWild(!rootFileUpcase).not())
    !returnArray.append(!fileName.replace('\','/'))
  enddo

  return !returnArray

endfunction
-- End of function definition for !!findFileWild
