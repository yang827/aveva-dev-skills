--
--
-- Description:
-- Return first member of specified element of given type or purpose
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref        Owner
--    2   R      string       Type of Member
--    3   R      string       Purpose of Member
--    4   RW     string       Status Message
-- Return:
--   [Data Type] [Description]
--   Object dbref First Member of Owner with given type
--
------------------------------------------------------------------------

-- Define function
define function !!findFirstMember(!owner is DBREF, !type is STRING, !purpose is STRING, !message is STRING) is DBREF

if (!owner.mCount() lt 1) then
-- No members
     !message = |Element | & !owner.name & | has no members|
     return nulref
elseif (!type.length() le 0 and !purpose.length() le 0) then
-- First member if no type or purpose specified
     return !owner.members[1]
else
-- Check each member in turn
     do !index from 1 to !owner.mCount()
     -- Type specified
          if (!type.length() gt 0) then
               if (!owner.members[!index].type eq !type) then
               -- Check Purpose
                    if(!purpose.length() gt 0) then
                         !thisPurpose = !owner.members[!index].purpose
                    -- This type of element does not have purpose
                         handle any
                              !message = |An | & !type & | Element does not have a purpose attribute|
                              return nulref
                         endhandle
                         if (!thisPurpose eq !purpose ) then
                              return !owner.members[!index]
                         endif
                    else
                    -- No need to check purpose
                         return !owner.members[!index]
                    endif
               endif
          -- Purpose Specified
         else
              !thisPurpose = !owner.members[!index].purpose
          -- This type of element does not have purpose
              handle any
                   skip
              endhandle
              if (!thisPurpose eq !purpose) then
                    return !owner.members[!index]
              endif
         endif
     enddo
-- No members of correct type found
     !message = |Element | & !owner.name & | has no members of type | & !type
     return nulref
endif

endfunction
-- End of function definition for !!findFirstMember
