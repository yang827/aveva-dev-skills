--
--
--  Description:    find nearest position in array to passed position within passed tolerance
--                  Similar to .findFirst() method of array but NEAR method is used instead of EQ for comparison
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--    1   R      ARRAY                 position array
--    2   R      POSITION              position to be found
--    3   R      REAL                  tolerance
--
-- Return:
--   [Data Type]          [Description]
--    REAL                 index of matching position in array
--
--------------------------------------------------------------------------------------------------------------
define function !!findNearestPos(!posArray is ARRAY, !pos is POSITION, !tolerance is REAL) is REAL

  -- init
  !index = REAL()

  do !c indices !posArray
    if !posArray[!c].near(!pos, !tolerance) then
      !index = !c
      break
    endif
  enddo

  return !index

endfunction
