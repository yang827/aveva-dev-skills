--
-- File:            findplines.pmlfnc
--   Type:          Function Definition
--   Group:         Finding information from database
--     Keyword:
--   Module:        common
--   Replaces:      RPLINES
--
-- Author:          S.Hudson,,,
-- Created:         Wed Feb 19 16:35:05 GMT 1997
--
--
-- Description:
-- Find all plines for identified element.
-- Can be used with SCTN, SPRO or SPRF elements.
-- Uses supplied rule for filtering.
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbref       Element
--    2   R      string      Pline Rule (No default)
--    3   RW     string      Status Message
--    4   RW     dbref       profile
--    5   RW     array       plines found
-- Return:
--   [Data Type] [Description]
--    Boolean     Status ( True for success )
--
------------------------------------------------------------------------

-- Define function
define function !!findPlines(!element is DBREF, !rule is STRING, !message is STRING, !profile is DBREF, !pLines is ARRAY  ) is BOOLEAN

-- Remember where we are

!refe = !!ce

-- Build up with clause

if (!rule.upcase() eq |NULL|) then
     !with = ||
else
     !with = !rule
endif

-- Find Pline Set

!!ce = !element
!!ce = !!ce.spref
handle any
endhandle
!!ce = !!ce.catRef
handle any
endhandle
!profile = !!ce
!!ce = !!ce.pstref
handle any
     !message = |Unable to find Profile with Plines|
     !!ce = !refe
     return false
endhandle

-- Collect all plines here

if (!rule.upcase() eq |NULL|) then
     var !stringArray COLLECT ALL PLIN FOR CE
else
     var !stringArray COLLECT ALL PLIN WITH $!rule FOR CE
endif

if (!stringArray.size() eq 0) then
     !message = |Unable to find any Plines|
     !!ce = !refe
     return false
endif

-- Convert strings
!pLines = object ARRAY()
!pkeys = object ARRAY()

do !string values !stringArray

     !pLines.append(!string.dbRef() )
     !pkeys.append(!string.dbRef().pkey)

enddo

-- Sort plines in order of PKEY

!order = !pkeys.sortedIndices()

!pLines.reIndex(!order)

!!ce = !refe

return true

endfunction
-- End of function definition for !!findPlines
