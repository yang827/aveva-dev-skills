-- Created:         Mon Feb 17 12:13:41 GMT 1997
--
--
-- Description:
-- Collect all the SPEC's that match given criteria
-- and return an array of dbref's
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Purpose of SpecWorld
--    2   R      STRING      Purpose of Spec
--    3   R      DBREF       Material Reference
--    4   RW     STRING      Status Message
--    5   RW     Array       Specifications
-- Return:
--   [Data Type] [Description]
--   Boolean        Status (True is Success)
--
------------------------------------------------------------------------

-- Define function
define function !!findSpecs(!worldPurpose is STRING, !specPurpose is STRING, !dummyMaterial is DBREF, !message is STRING, !specs is ARRAY) is BOOLEAN

!refe = !!ce
!specs.clear()
!spwls[1] = object DBREF()

if (!!findSpecWorlds(!worldPurpose, !message, !spwls ) ) then

-- For all valid specworlds
     do !index from 1 to !spwls.size()

          !with = |Purpose eq '| & !specPurpose & |'|

-- Material filtering removed  (6/8/98)
--           if ( Defined(!material) and Set(!material) ) then
--                 !with = !with & | and matref eq | & !material
--           endif

     -- Collect all valid specs
          !extraSpecs = !!collectAllFor(|SPEC|, !with, !spwls[!index] )
          if (!extraSpecs.size() gt 0) then
                 !specs.appendArray(!extraSpecs)
          endif
          !extraSpecs.clear()
     enddo
     if (!specs.size() gt 0) then
           !message = |Success|
            !!ce = !refe
           return true
     else
           !message = |No Specifications Found|
           !!ce = !refe
           return false
     endif

else
     !message = |No Spec Worlds Found|
     !!ce = !refe
     return false
endif
endfunction
-- End of function definition for !!findSpecs
