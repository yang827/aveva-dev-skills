-- Created:         Mon Feb 17 12:12:30 GMT 1997
--
--
-- Description:
-- Collect all the SPWL's that match given criteria
-- and return them as an array of dbrefs
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Purpose of SPWL required
--    2   RW     STRING      Status Message
--    3   RW     ARRAY       Dbref
-- Return:
--   [Data Type] [Description]
--    Boolean     Status Flag (Success is True)
--
------------------------------------------------------------------------

-- Define function
define function !!findSpecWorlds(!purpose is STRING, !message is STRING, !spwls is ARRAY) is BOOLEAN

!refe = !!ce
!spwls.clear()

!with = |Purpose eq '| & !purpose & |'|
!spwls = !!collectAllFor( |SPWL|, !with, WORLD )
if (arraySize (!spwls) eq 0) then
     !message = |No Spec Worlds have been found|
     !!ce = !refe
     return false
else
     !message = |Success|
     !!ce = !refe
     return true
endif

endfunction
-- End of function definition for !!findSpecWorlds
