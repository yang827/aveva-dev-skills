--
--
-- Description:
-- If there is a storage area return it otherwise return unset
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Group Name
--    2   R      STRING      Area of Group
-- Return:
--   [Data Type] [Description]
--    DBREF       Area to create elements
--
------------------------------------------------------------------------

-- Define function
define function !!findStorageArea(!groupName is STRING, !areaName is STRING) is DBREF

!return = object DBREF()

if (!!ifStorageData(!groupName, !areaName) ) then
     return !!getStorageArea( !groupName, !areaName )
else
     return !return
endif

endfunction
-- End of function definition for !!findStorageArea
