--
--
-- Description:
-- Returns the first owning element of the passed items which is
-- in the list of passed types.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of permissible element types (must
--                           be bottom up order).
--    2   R      DBREF       Item to start bottom up search from
-- Return:
--   [Data Type] [Description]
--    DBREF       First parent of one of the passed types
--
------------------------------------------------------------------------

-- Define function
define function !!firstParent (!types is ARRAY, !item is DBREF) is DBREF

  -- Initialise Variables
  !parent = object DBREF()

  !ownLst = !item.ownLst.invert()

  do !owners values !ownLst
    if (!types.findFirst(!owners.type).set()) then
      !parent = !owners
      break
    endif
  enddo

  return !parent

endfunction
-- End of function definition for !!firstParent
