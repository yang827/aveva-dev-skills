--
--
-- Description:
-- Loads formats data file into the formats forms and displays
-- the information.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!formatsLoad()

  -- Clear All existing permissibles from form
  !!formats.permissibles.clear()

  -- Load Current Module Data
  !modData = !!module()
  !module  = !modData.appName

  -- Search Areas
  !paths = !!searchPaths('com-formats.pmldat')
  !paths.appendArray(!!searchPaths(!module.appKey.lowcase() & '-formats.pmldat'))
  if (!paths.empty()) then
    !!comFormatsDflt()

  else

    -- Cycle through list and load all files
    do !i indices !paths
      call !!runMacro(!paths[!i].file.fullName(),!paths[!i].defaultType)
      handle any
      endhandle
    enddo
  endif

  -- Sort into lists
  !block = object BLOCK('!!formats.permissibles[!evalIndex].type')
  !types = !!formats.permissibles.evaluate(!block)
  !types.sort()
  !types.unique()

  -- Load Available Types with list
  !!formats.type.dText = !types
  !!formats.type.rText = !types

  -- Go though each of the unit types and set the global variables.
  do !i indices !types

    -- Loop through the permissibles list and load the first
    -- format to the gvar for the type
    do !j indices !!formats.permissibles

      if(!!formats.permissibles[!j].type eq !types[!i]) then
         !gvar  = !!formats.permissibles[!j].gvar
         $!<gvar> = !!formats.permissibles[!j].format
         break
      endif
    enddo

  enddo

  -- Select the first type
  call !!formatsType()

endfunction
-- End of function definition for !!formatsLoad
