--
-- Description:
-- Loads the formats types into the permissible list.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!formatsSet()

  -- Get Gvar of item
  !gvar = !!formats.permissibles[!!formats.formats.selection().real()].gvar

  -- Set Format
  $!gvar = !!formats.permissibles[!!formats.formats.selection().real()].format

endfunction
-- End of function definition for !!formatsSet
