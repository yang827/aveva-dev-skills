--
--
-- Description:
-- Loads the formats types into the permissible list.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!formatsType()

  -- Initialise Variables
  !types       = ARRAY()
  !number      = ARRAY()
  !displayText = ARRAY()

  -- Select all Permissibles with the selected type
  do !i indices !!formats.permissibles

    -- Ignore formats of different type
    skip if(!!formats.permissibles[!i].type ne !!formats.type.selection())
    !types.append(!!formats.permissibles[!i])
    !number.append(!i.string())

  enddo

  -- Extract all Descriptions
  !block        = object BLOCK('!types[!evalIndex].description')
  !descriptions = !types.evaluate(!block)
  !block        = object BLOCK('!types[!evalIndex].example')
  !examples     = !types.evaluate(!block)

  -- Max width of Examples
  !max = !examples.width()
  do !i indices !examples
    var !dprt COMPOSE |$!examples[$!i]| WIDTH $!max R SPACE 2 |$!descriptions[$!i]|
    !displayText.append(!dprt[1])
  enddo

  -- Display Permissibles
  !!formats.formats.dText = !displayText
  !!formats.formats.rText = !number

  -- Check if there is a current setting for the GVAR, if there is select
  -- the relevant one.
  !gvar = !!formats.permissibles[!!formats.formats.selection().real()].gvar

  -- If the Gvar defined
  if(defined($!gvar)) then

    -- Loop through the current RTEXT permissible selection, and see which
    -- is the format
    do !index values !!formats.formats.rText
      if(!!formats.permissibles[!index.real()].format eq $!gvar) then
        !!formats.formats.select('RTEXT',!index)
        break
      endif

    enddo

  -- Select the first Gvar
  else
    call !!formatsSet()
  endif

endfunction
-- End of function definition for !!formatsType
