-- Created:         Fri Apr 11 15:32:00 GMT 2008
--
--
--  Description:    return intersections of two GENSEC's.
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--    1   R      DBREF                 first GENSEC
--    2   R      DBREF                 second GENSEC
--
-- Return:
--   [Data Type]          [Description]
--    ARRAY                position array with intersections
--
--------------------------------------------------------------------------------------------------------------
define function !!gensecsIntersections(!first is DBREF,!second is DBREF) is ARRAY

  -- initialise
  !result = ARRAY()

  !firstPrfl = object PROFILE(SPINE 1 of $!<first>)
  handle ANY
    return !result
  endhandle

  !secondPrfl = object PROFILE(SPINE 1 of $!<second>)
  handle ANY
    return !result
  endhandle

  -- if gensec is linear then extend it by 1mm
  !edges = !firstPrfl.edges()
  if !edges.size().eq(1) then
    if !edges[1].objectType().eq('LINE') then
      !edges[1] = !edges[1].extendend(1mm).extendstart(1mm)
      !firstPrfl = object PROFILE(!firstPrfl.position,!firstPrfl.orientation,!edges)
    endif
  endif

  !edges = !secondPrfl.edges()
  if !edges.size().eq(1) then
    if !edges[1].objectType().eq('LINE') then
      !edges[1] = !edges[1].extendend(1mm).extendstart(1mm)
      !secondPrfl = object PROFILE(!secondPrfl.position,!secondPrfl.orientation,!edges)
    endif
  endif

  !intersection = !firstPrfl.intersections(!secondPrfl)
  handle ANY
    return !result
  endhandle

  !result = !intersection
  return !result

endfunction
