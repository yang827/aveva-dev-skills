--
-- Description:
-- Returns the current selected colour as a colour object.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!getColourSelect() is COLOUR

  -- Get current selection
  return !!colourSelect.colours[!!colourSelect.colour.val.real()]

endfunction
-- End of function definition for !!getColourSelect
