--
--  Description:
--
----------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]       [Description]
--    1   R      ANY              the "standard" criteriaset
--    2   R      DBREF            template reference that store the fabricator standard
-- Return:
--   [Data Type] [Description]
--    CRITERIASET the result of the intersection
------------------------------------------------------------------------

define function !!getCriteriaSetIntersection(!standardCriteria is ANY, !tmplReference is DBREF) is ANY

  -- no template reference --> no fabricator standard yet, maybe later
  if ( !tmplReference.badRef() ) then
    return !standardCriteria
  endif

  -- there is no fabricator standard in the template
  if ( !tmplReference.members.empty() or $
       !tmplReference.members[1].type.neq('DDSE') ) then
    return !standardCriteria
  endif
  !allDDSets[1] = !tmplReference.members[1]

  -- there is a fabricator standard, combine it
  do !attributeName value !standardCriteria.attributes()
    skip if ( !standardCriteria.attribute(!attributeName).objectType().neq('CRITERION') )

    !standardCriterion = !standardCriteria.attribute(!attributeName)

    -- get the equivalent element from the tmplreference
    !collection = object COLLECTION()
    !expression = object EXPRESSION('MATCHWILD(DESCRIPTION, |*' & !attributeName.upCase() & '|)')
    !collection.filter(!expression)
    !collection.scope(!allDDSets[1])
    !collection.type('DDAT')
    !allDDat = !collection.results()
    skip if ( !allDDat.empty() )

    -- check every single attribute and take the best of both
    if ( !standardCriterion.min.unset() ) then
      !standardCriterion.min = 0
    endif
    !standardCriterion.min = !standardCriterion.min.max(!allDDat[1].maxMin[1])
    if ( !standardCriterion.max.unset() ) then
      !standardCriterion.max = 100000
    endif
    !standardCriterion.max = !standardCriterion.max.min(!allDDat[1].maxMin[2])

    -- collects the vvalue
    !collection     = object COLLECTION()
    !collection.scope(!allDDat[1])
    !collection.type('VVALUE')
    !allValidValues = !collection.results()
    if ( !allValidValues.empty().not() ) then
      -- get the values from the database
      !vValues = ARRAY()
      do !validValue value !allValidValues
        !vValues.append(!validValue.validValue.after('(').before(')').real())
      enddo

      -- if the array in the object is unset take the fabricator standard
      if ( !standardCriterion.validValues.empty() ) then
        !standardCriterion.validValues = !vValues
      else
        !standardCriterion.validValues = !standardCriterion.validValues.intersect(!vValues)
      endif
    endif

    !standardCriteria.attribute(!attributeName) = !standardCriterion
  enddo

  return !standardCriteria

endfunction
