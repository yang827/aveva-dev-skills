-- Created:         Mon 5th February 2012  15:57
--
-- Description:
--    Gets the description for an element from its spref
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        element
--
-- Return:
--   [Data Type] [Description]
--    STRING      Description from SPREF
------------------------------------------------------------------------
define function !!getDescFromSpref(!element is DBREF) is STRING

  --Initialise description
  !desc = ''

  -- Check if the element passed exists
  if (!element.badRef()) then
   return ''
  endif

  -- Get the description from the template reference if set
  !desc = !element.tmpref.desc
  handle any
  endhandle

  -- If the template description is unset move to spref
  if (!desc.trim().empty()) then

    -- If spref is unset don't continue
    if (!element.spref.badRef()) then
      !desc = ''

    else

      -- Get the spref and the spref type
      !spref = !element.spref
      !type = !spref.type

      -- If the spref is a selection table item
      if (!type.eq('TABITE')) then

        -- Get the part reference
        !desc = !spref.prtref.desc
        handle any
          !desc = ''
        endhandle

        -- If part desc is unset then go to the catalogue item
        if (!desc.trim().empty()) then
          !desc = !spref.prtref.catref.desc
          handle any
           !desc = ''
          endhandle
        endif

      -- If the spref is a specification item
      elseif  (!type.eq('SPCO')) then

        -- Get the part reference description
        !desc = !spref.prtref.desc
        handle any
          !desc = ''
        endhandle

        -- If part desc unset then get go to the  catalogue item
        if (!desc.trim().empty()) then
          !desc = !spref.catref.desc
          handle any
            !desc = ''
          endhandle
        endif

      -- If the spref is a GPART
      elseif (!type.eq('GPART')) then

        -- Get the description from the gpart
        !desc = !spref.desc
        handle any
          !desc = ''
        endhandle

        -- If the gpart description is unset go to the catalogue item
        if (!desc.trim().empty()) then
          !desc = !spref.catref.desc
          handle any
            !desc = ''
          endhandle
        endif

      -- If the spref is a catalogue item
      elseif (!type.eq('SCOM')) then

        -- Get the description from the catalogue item
        !desc = !spref.desc
        handle any
          !desc = ''
        endhandle

      endif
    endif
  endif

  -- Return the description
  return !desc

endfunction
-- End of function definition
