define function !!getModuleData(!name is STRING) is MODULEBARDATA

  if (undefined(!!moduleDataCache)) then

    !!moduleData()

  endif

  return !!moduleDataCache.moduleData(!name)

endfunction
-- End of function definition for !!getModuleData
