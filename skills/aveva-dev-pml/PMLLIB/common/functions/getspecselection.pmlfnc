--
--
-- Description:
-- Returns the current selected spec item from the specification
-- gadgets passed via the SpecData object.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      SPECDATA    Spec data object contain all spec data
-- Return:
--   [Data Type] [Description]
--    DBREF       Spec selection held in the "Selected" spec gadget
--
------------------------------------------------------------------------

-- Define function
define function !!getSpecSelection (!specData is SPECDATA) is DBREF

  -- Initialise Variables
  !return = object DBREF()

  -- Is there a selection
  if(!specData.specLink.selected.selection().empty()) then
    return !return
  endif

  -- Set return initially to selected item
  !return = !specData.specLink.selected.selection().dbRef()

  -- No Standard Spec item (i.e. The SELE is the important item)
  if(!specData.standardSpec.not()) then

    -- If we part selection is permitted, then get the "PART" SPCO
    -- for the current selected level
    if(!specData.partSelection) then

      !partSPCO = !!collectMembersOf(!specData.specLink.selected.selection().dbRef(), 'TANS eq |PART|')
      if(!partSPCO.set()) then
        !return   = !partSPCO[1]
      endif
    endif
  endif

  -- Return spec selection
  return !return

endfunction
-- End of function definition for !!getSpecSelection
