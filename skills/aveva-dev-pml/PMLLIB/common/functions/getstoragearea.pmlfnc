--
-- Description:
-- Returns the specified storage area for the given group.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Group Name
--    2   R      STRING      Area of Group
-- Return:
--   [Data Type] [Description]
--    DBREF       Storage area
--
------------------------------------------------------------------------

-- Define function
define function !!getStorageArea (!groupName is STRING, !areaName is STRING) is DBREF

  -- Get Store
  !store = !!storageData(!groupName, !areaName)

  -- If the storage area is a bad reference, reset to unset
  if(!store.store.badRef()) then
    call !!storageAreasSet(!groupName, !areaName, 'unset')
    !store = !!storageData(!groupName, !areaName)
  endif

  return !store.store

endfunction
-- End of function definition for !!getStorageArea
