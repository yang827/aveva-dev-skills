-- File:            gph3ddesign.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     VIEW
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Jan 20 10:04:50 WAT 1998
--
--
-- Description:
--  Standard Design Graphic View
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Form number
-- Return:
--   [Data Type] [Description]
--    FORM        Form created
--
------------------------------------------------------------------------

-- Define function
define function !!gph3DDesign(!number is REAL) is FORM

  -- Initialise Variables
  !form   = '!!gph3DDesign' & !number
  !module = !!module()
  -- flag to deal with marine specific behaviour
  !isMarine = !module.productfamily.upcase().eq('MARINE')

  -- Define form
  setup form $!<form> resize DOCUMENT VarChars NoAlign

    $!<form>.formTitle      = 'Default'
    $!<form>.iconTitle      = '3DView'
    $!<form>.initCall       = '$!form$n.keyboardFocus = $!form$n.view'
    $!<form>.formRevision   = ' $Revision: 1.31 $ '
    $!<form>.cancelCall     = '!!gphViews.close(' & !form & ')'

    -- Body of form definition

    -- Define Prompt
    para .prompt anchor T+L+R width 80 lines 1
    path down
    vdist 0.2

    -- New model editor view
    if (!module.appName.lowcase().matchwild('*design*') ) then
      !volumeType = 'GIVolume'

      !autoCeIcon           = !!pml.getPathName('autocepopup16.png')
      !rotateCeIcon         = !!pml.getPathName('rotatece16.png')
      !mouseZoomRectIcon    = !!pml.getPathName('ng_zoomrectangle.png')
      !mouseZoomInOutIcon   = !!pml.getPathName('ng_zoominout.png')
      !mouseRotateIcon      = !!pml.getPathName('ng_rotatemode.png')
      !mousePanIcon         = !!pml.getPathName('ng_panmode.png')
      !mouseWalkIcon        = !!pml.getPathName('ng_walkmode.png')
      !mouseWalkIconOff     = !!pml.getPathName('ng_walkmode_off.png')
      !walkToDrawlistIcon   = !!pml.getPathName('ng_zoomtodrawlist.png')
      !zoomToSelectionIcon  = !!pml.getPathName('ng_zoomtoselection.png')

      !clippingIconOn       = !!pml.getPathName('clippingicon_on16.png')
      !clippingIconOff      = !!pml.getPathName('clippingicon_off16.png')
      !clipCE               = !!pml.getPathName('clipce16.png')
      !axesIconOn           = !!pml.getPathName('worldaxes16.png')
      !axesIconOff          = !!pml.getPathName('worldaxes16.png')
      !hide                 = !!pml.getPathName('hide16.png')
      !applyRepIcon         = !!pml.getPathName('refresh16.png')

      -- added from add-on pack (png files renamed)
      !saveRestoreIcon      = !!pml.getPathName('viewsaverestore.png')
      !advancedViewControlIcon = !!pml.getPathName('viewcontrol.png')
      !removeAllIcon           = !!pml.getPathName('removeall16.png')

----------------------------------------------------------------------------------------------------------------------------------
--  DO NOT ATTEMPT TO MODIFY THE NAMES OR DEFINITIONS OF ANY .core BUTTONS.  THESE ARE CONTROLLED BY PDMS DESIGN CORE.
----------------------------------------------------------------------------------------------------------------------------------
      -- define view control buttons
      button .autoCE                    tooltip 'Limits CE & Options'                   pixmap "$!<autoCeIcon>"          width 16 height 16   callback |!!gphViews.limits(!this.view, !!ce)|
      button .coreZoomToSelectionButton tooltip 'Zoom to Selection'                     pixmap "$!<zoomToSelectionIcon>" width 16 height 16
      button .coreWalkToDrawlistButton  tooltip 'Walk to Draw List'                     pixmap "$!<walkToDrawlistIcon>"  width 16 height 16
      button .coreCentreButton          tooltip 'Centre on Selection'                   pixmap "$!<rotateCeIcon>"        width 16 height 16       callback |!!gphAlwaysRotate(!this.view, !!ce)|

      -- Middle mouse button view manipulation modes
      button .coreZoomRectButton toggle at ymax+0.3 tooltip 'Middle mouse button: Zoom Rectangle'  pixmap "$!<mouseZoomRectIcon>"  width 16 height 16
      button .coreZoomInOutButton toggle tooltip 'Middle mouse button: Zoom In/Out'     pixmap "$!<mouseZoomInOutIcon>"            width 16 height 16
      button .coreRotateButton    toggle tooltip 'Middle mouse button: Rotate'          pixmap "$!<mouseRotateIcon>"               width 16 height 16
      button .corePanButton       toggle tooltip 'Middle mouse button: Pan'             pixmap "$!<mousePanIcon>"                  width 16 height 16
      button .coreWalkButton      toggle tooltip 'Middle mouse button: Walkthrough'     pixmap "$!<mouseWalkIcon>"       "$!<mouseWalkIcon>" "$!<mouseWalkIconOff>"  width 16 height 16

      button .clippingButton toggle at ymax+0.3     tooltip 'Clipping & Options'        pixmap "$!<clippingIconOff>" "$!<clippingIconOn>"  width 16 height 16 callback |!!gphViews.clipButton(|
      button .clippingCE      tooltip 'Clip CE'                                    pixmap "$!<clipCE>"           width 16 height 16      callback |!!gphViews.clipboxElement(!this.view, !!ce)|
      button .drawlistButton  tooltip 'Pick Object to Hide - or - Right Click for Drawlist Options'    pixmap "$!<hide>" width 16 height 16 callback |!!gphViews.drawlistButton(|
      button .applyRepButton  tooltip 'Apply Representation Rule Set'         pixmap "$!<applyRepIcon>"  width 16 height 16 callback |!!comRepRules('apply')|

      button .axesButton toggle  at ymax+0.3  tooltip 'World Axes'       pixmap "$!<axesIconOff>" "$!<axesIconOn>"  width 16 height 16 callback |!!gphViews.axesButton(|

      -- added from add-on pack
      button .btnSaveRestore    at ymax+0.1 tooltip 'Save & Restore View'   pixmap "$!<saveRestoreIcon>"          width 16 height 16 callback |!!gphViews.saveRestoreViews()|
      if( !isMarine ) then
        button .advancedViewControl     tooltip 'Advanced View Control' pixmap "$!<advancedViewControlIcon>"  width 16 height 16 callback |!!gphViews.advancedViewControl()|
      endif

      button .btnRemoveAll     at ymax+0.3 tooltip 'Remove All' pixmap "$!<removeAllIcon>" width 16 height 16 callback |!!gphViews.removeAll()|
    -- Standard Graphic View
    else
      !volumeType = 'Volume'

      !autoCeIcon       = !!pml.getPathName('autoce16.png')
      !rotateCeIcon     = !!pml.getPathName('rotatece16.png')
      !mouseZoomIcon    = !!pml.getPathName('ng_zoominout.png')
      !mousePanIcon     = !!pml.getPathName('ng_panmode.png')
      !mouseRotateIcon  = !!pml.getPathName('ng_rotatemode.png')
      !axesIconOn       = !!pml.getPathName('worldaxes16.png')
      !axesIconOff      = !!pml.getPathName('worldaxes16.png')
      !hide             = !!pml.getPathName('hide16.png')
      !restoreOneIcon   = !!pml.getPathName('ng_restoreview1.png')
      !restoreTwoIcon   = !!pml.getPathName('ng_restoreview2.png')
      !restoreThreeIcon = !!pml.getPathName('ng_restoreview3.png')
      !restoreFourIcon  = !!pml.getPathName('ng_restoreview4.png')

      -- define view control buttons
      button .autoCE at x0 ymax.prompt tooltip 'Limits CE' pixmap "$!<autoCeIcon>" width 16 height 16  callback |!!gphViews.limits(!this.view, !!ce)|
      button .rotateCE tooltip 'Rotate Origin CE' pixmap "$!<rotateCeIcon>" width 16 height 16 callback |!!gphViews.rotate(!this.view, !!ce.position)|

      button .mouseZoom at ymax+0.5 tooltip 'Zoom' pixmap "$!<mouseZoomIcon>" width 16 height 16 callback |!this.view.mouseMode = 'Zoom'|
      button .mousePan tooltip 'Pan' pixmap "$!<mousePanIcon>" width 16 height 16 callback |!this.view.mouseMode = 'Pan'|
      button .mouseRotate tooltip 'Rotate' pixmap "$!<mouseRotateIcon>" width 16 height 16 callback |!this.view.mouseMode = 'Rotate'|
      button .drawlistButton tooltip 'Drawlist' pixmap "$!<hide>" width 16 height 16 callback |!!gphViews.drawlist(!this.view)|
      button .axesButton toggle at ymax+0.3 tooltip 'World Axes' pixmap "$!<axesIconOff>" "$!<axesIconOn>" width 16 height 16 callback |!!gphViews.axesButton(|

      button .restoreView1 at ymax+0.5 tooltip 'Restore View 1' pixmap "$!<restoreOneIcon>" width 16 height 16 callback |!this.view.restoreView(1)|
      button .restoreView2 tooltip 'Restore View 2' pixmap "$!<restoreTwoIcon>" width 16 height 16 callback |!this.view.restoreView(2)|
      button .restoreView3 tooltip 'Restore View 3' pixmap "$!<restoreThreeIcon>" width 16 height 16 callback |!this.view.restoreView(3)|
      button .restoreView4 tooltip 'Restore View 4' pixmap "$!<restoreFourIcon>" width 16 height 16 callback |!this.view.restoreView(4)|

    endif

    -- Define graphics view
    view .view at xmax+0.2 ymax.prompt+0.2 prompt .prompt $!<volumeType>
    $*view .view at xmax+0.2 ymax.prompt prompt .prompt $!<volumeType>

      $*width $!!gphViewOpt.width height $!!gphViewOpt.height
      width to max.prompt height $!!gphViewOpt.height
      --borders on
      --statusline off
      limits local s5000mm w5000mm d5000mm to n5000mm e5000mm u5000mm

      -- Input Modes
        -- Navigate
        inmode create _navi       type |DES_NAVIGATE|
        -- Standard Element Pick
        inmode create _pick       type |DES_PICK|
        -- Pick Any (Element, Ppoint, Pline)
        inmode create _pAny       type |DES_PICK_ANY|
        -- Plines
        inmode create _pLine      type |DES_PICK_PLINE|
        -- Ppoints
        inmode create _point      type |DES_PICK_POINT|
        -- Screen Position
        inmode create _screen     type |DES_3D_LINE|
        -- Laser Model rays
        inmode create _pickxgeom  type |DES_PICK_XGEOM|
        -- Default (Navigation)
        inmode create _pickDetail type |DES_PICK_DETAIL|
        -- Default (Navigation)
        inmode create _default    type |DES_NAVIGATE|

    exit

    -- Set Defaults for Modes
    _view.navi.cursor     = 'Pointer'
    _view.navi.prompt     = 'Navigate : '

    _view.pick.cursor     = 'Pointer'
    _view.pick.prompt     = 'Pick Element : '

    _view.pAny.cursor     = 'Pointer'
    _view.pAny.prompt     = 'Pick Any : '

    _view.pLine.cursor    = 'Pointer'
    _view.pLine.prompt    = 'Pick Pline : '

    _view.point.cursor    = 'Pick'
    _view.point.prompt    = 'Point Ppoint : '

    _view.screen.cursor   = 'Crosshair'
    _view.screen.prompt   = 'Pick 3D Position : '

    _view.default.cursor  = 'Pointer'
    _view.default.prompt  = 'Navigate : '

    -- Form Members
    -- Clip Data
    member .clipbox  is GPHCLIPBOX
    member .clipPlanes is ARRAY

    -- Form Information
    member .type     is STRING
    member .number   is REAL

  -- Register the form
  !formName        = $!<form>
  !!appFormCntrl.registerForm(!formName)
  exit
  -- End of form definition

  -- Initialise Form Data
  !formName        = $!<form>
  !formName.type   = 'Design'
  !formName.number = !number
  !module          = !!module()

  -- start form maximised in MDI window
  !formName.maximised = true

  -- Assign defaults clipbox and clip planes
  !formName.clipbox.gphClipbox(!formName.view)
  !formName.clipPlanes.clear()
  do !i to 6
    !formName.clipPlanes.append(object GPHCLIPPLANE(!formName.view, !i))
  enddo

  -- New model editor view
  if(!module.appName.lowcase().matchwild('*design*'))  then

    !formName.newMenu('limitsMenu')
    !formName.limitsMenu.add('CALLBACK', 'Obstruction',   '!!gphViews.limitsList(')
    !formName.limitsMenu.add('CALLBACK', 'Clipbox',       '!!gphViews.limitsBox(')
    !formName.limitsMenu.add('CALLBACK', 'Explicit...',   '!!gphViews.limitsExplicit(')
    !formName.limitsMenu.add('separator')
    !formName.limitsMenu.add('CALLBACK', 'Restore',       '!!gphViews.limitsRestore(')
    !formName.limitsMenu.add('separator')
    !formName.limitsMenu.add('CALLBACK', 'Look Explicit...',   '!!gphViews.lookExplicit(')

    !formName.newMenu('lclippingMenu')
    !formName.lclippingMenu.add('toggle',   'Enable',      '!!gphViews.clipbox(')
    !formName.lclippingMenu.add('toggle',   'Capped',      '!!gphViews.clipbox(')
    !formName.lclippingMenu.add('callback', 'Colour...',   '!!gphViews.clipbox(')
    !formName.lclippingMenu.add('separator')
    !formName.lclippingMenu.add('callback', 'CE',          '!!gphViews.clipboxElement(')
    !formName.lclippingMenu.add('callback', 'Owner',       '!!gphViews.clipboxElement(')
    !formName.lclippingMenu.add('callback', 'Limits Box',  '!!gphViews.clipboxBox(')
    !formName.lclippingMenu.add('callback', 'Pick item',   '!!gphViews.clipboxPick(')
    !formName.lclippingMenu.add('callback', 'Pick limits', '!!gphViews.clipboxPick(')
    !formName.lclippingMenu.add('callback', 'Explicit...', '!!gphViews.clipboxExplicit(')
    !formName.lclippingMenu.add('separator')
    !formName.lclippingMenu.add('callback', 'Planes...',   '!!gphViews.clipPlanes(')

    !formName.newMenu('drawlistMenu')
    !formName.drawlistMenu.add('callback', 'Show Last Hidden Object(s)',  '!!gphViews.drawlistMenu(')
    !formName.drawlistMenu.add('callback', 'Show All Hidden Objects',     '!!gphViews.drawlistMenu(')
    !formName.drawlistMenu.add('callback', 'Show Hidden Objects...',      '!!gphViews.drawlistMenu(')
    !formName.drawlistMenu.add('callback', 'New Local View of Selection', '!!gphViews.drawlistMenu(')
    !formName.drawlistMenu.add('callback', 'New Clone View',              '!!gphViews.drawlistMenu(')
    !formName.drawlistMenu.add('callback', 'Drawlist...',                 '!!gphViews.drawlistMenu(')
    !formName.drawlistMenu.add('callback', 'Representation...',           '!!gphViews.drawlistMenu(')

    -- Associate limits menu with limits button
    !formName.autoCE.setPopup(!formName.limitsMenu)
    !formName.clippingButton.setPopup(!formName.lclippingMenu)
    !formName.drawlistButton.setPopup(!formName.drawlistMenu)

  -- Standard Graphics View
  else

    -- build popup menus for restore/save view buttons
    !formName.newMenu('saveView1')
    !formName.saveView1.add('callback', 'Save 1', '!this.view.saveView(1)')
    !formName.newMenu('saveView2')
    !formName.saveView2.add('callback', 'Save 2', '!this.view.saveView(2)')
    !formName.newMenu('saveView3')
    !formName.saveView3.add('callback', 'Save 3', '!this.view.saveView(3)')
    !formName.newMenu('saveView4')
    !formName.saveView4.add('callback', 'Save 4', '!this.view.saveView(4)')

    !formName.newMenu('drawlistMenu')
    !formName.drawlistMenu.add('callback', 'Drawlist...', '!!gphViews.drawlist(!this.view)')
    !formName.drawlistButton.setPopup(!formName.drawlistMenu)

    !formName.restoreView1.setPopup(!formName.saveView1)
    !formName.restoreView2.setPopup(!formName.saveView2)
    !formName.restoreView3.setPopup(!formName.saveView3)
    !formName.restoreView4.setPopup(!formName.saveView4)

    -- Load bar menus with standard pull down menus
    !!gphViews.bar(!formName)

  endif

  -- Set defaults
  !!gphViewOpt.applyToView(!formName.view)

  return !formName

endfunction
-- End of function definition for !!gph3DDesign
