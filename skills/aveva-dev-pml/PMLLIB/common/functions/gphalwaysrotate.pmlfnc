--
--
-- Description:
-- Function to get the position even if the CE hasn't got a position (ie (FRMW)
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [GADGET]    [View to modify centre position of]
--   [2] [R]    [DBREF]     [Element to centre on]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!gphAlwaysRotate(!view is GADGET, !dbRef is DBREF)

!posTest = !dbRef.position
handle ANY
  -- test for PADD db for the 3dview functionality
  !testDbType = !dbRef.dbType
  if(!testDbType.eq('PADD')) then
    switch
    !desRef  = !!ce
    !posTest = !!desFindCentrePos(!desRef)
    !!draSwitchtoPadd()
  else
  -- find the centre of the element
    !posTest = !!desFindCentrePos(!dbRef)
  endif
endhandle

!!gphViews.rotate(!view, !posTest)

endfunction
-- End of function definition for !!gphAlwaysRotate(GADGET, DBREF)
