--
--
-- Description:
-- Read colour definition file, and return names and numbers.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM       Colour File
--
------------------------------------------------------------------------

-- Define function
define function !!gphMinimumMenus(!form is FORM)

  !view = !form.view

  !form.newMenu('viewPopup')
  !form.newMenu('mouseMenu')
  !form.newMenu('settingsMenu')
  !form.newMenu('sLookMenu')
  !form.newMenu('sPlanMenu')

  !form.viewPopup.add('menu', 'View Control',  'mouseMenu')
  !form.viewPopup.add('separator')
  !form.viewPopup.add('menu', 'Settings',  'settingsMenu')

  !form.mouseMenu.add('callback', 'Zoom  F2', '!!gphViews.doMenuAction(')
  !form.mouseMenu.add('callback', 'Pan  F3', '!!gphViews.doMenuAction(')
  !form.mouseMenu.add('callback', 'Rotate  F5', '!!gphViews.doMenuAction(')
  !form.mouseMenu.add('callback', 'Walk  F6', '!!gphViews.doMenuAction(')

  !form.settingsMenu.callback = '!!gphViews.graphicsToggles('
  !form.settingsMenu.add('toggle', 'Eye  F7', '!!gphViews.doMenuAction(')
  !form.settingsMenu.add('toggle', 'Shaded  F8', '!!gphViews.doMenuAction(')
  !form.settingsMenu.add('toggle', 'Borders  F9', '!!gphViews.doMenuAction(')
  !form.settingsMenu.add('toggle', 'Perspective  F4', '!!gphViews.doMenuAction(')


  !form.viewPopup.add('menu', 'Look',      'sLookMenu')
  !form.viewPopup.add('menu', 'Plan',      'sPlanMenu')
  !form.viewPopup.add('menu', 'Isometric', 'sIsometric')

  var !coordinate coordinate
  if !coordinate.eq('XYZ') then
    !form.sLookMenu.add('callback', ' X',       '!!gphViews.look(')
    !form.sLookMenu.add('callback', '-X',       '!!gphViews.look(')
    !form.sLookMenu.add('callback', ' Y',       '!!gphViews.look(')
    !form.sLookMenu.add('callback', '-Y',       '!!gphViews.look(')
    !form.sLookMenu.add('callback', ' Z',       '!!gphViews.look(')
    !form.sLookMenu.add('callback', '-Z',       '!!gphViews.look(')

    !form.sPlanMenu.add('callback', ' Y',       '!!gphViews.plan(')
    !form.sPlanMenu.add('callback', '-Y',       '!!gphViews.plan(')
    !form.sPlanMenu.add('callback', ' X',       '!!gphViews.plan(')
    !form.sPlanMenu.add('callback', '-X',       '!!gphViews.plan(')
  else
    !form.sLookMenu.add('callback', 'Up',          '!!gphViews.look(')
    !form.sLookMenu.add('callback', 'Down',        '!!gphViews.look(')
    !form.sLookMenu.add('callback', 'North',       '!!gphViews.look(')
    !form.sLookMenu.add('callback', 'South',       '!!gphViews.look(')
    !form.sLookMenu.add('callback', 'East',        '!!gphViews.look(')
    !form.sLookMenu.add('callback', 'West',        '!!gphViews.look(')

    !form.sPlanMenu.add('callback', 'North',      '!!gphViews.plan(')
    !form.sPlanMenu.add('callback', 'South',      '!!gphViews.plan(')
    !form.sPlanMenu.add('callback', 'East',       '!!gphViews.plan(')
    !form.sPlanMenu.add('callback', 'West',       '!!gphViews.plan(')
   endif

  !form.sIsometric.add('callback', 'One',         '!!gphViews.isometric(')
  !form.sIsometric.add('callback', 'Two',         '!!gphViews.isometric(')
  !form.sIsometric.add('callback', 'Three',       '!!gphViews.isometric(')
  !form.sIsometric.add('callback', 'Four',        '!!gphViews.isometric(')

  !view.setPopup(!form.viewPopup)

endfunction
-- End of function definition for !!gphMinimumMenus
