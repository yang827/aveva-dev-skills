--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Pipe piece to highlight
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!highlightPipeElement(!element is DBREF)

  -- Unenhance all
  UNENHANCE ALL

  -- Get highlight colour
  !colour = !!gphcolopt.highlight()

  -- Pipe Piece
  if(!element.type.eq('PPIECE')) then

    -- Get Pipe Spool Components
    !elements   = !element.aelrfa
    !max        = !elements.size() - 1
    -- !max should be 1 at this point, since aelrfa is always size 2

    -- highlight boundary element
    do !i from 1 to !max

      -- Highlight head tube if arrive is a branch
      if(!elements[!i].type.eq('BRAN')) then
        ENHANCE TOTAL HEAD TUBE OF $!<elements[$!<i>]> COLOUR $!<colour.code>
        handle ANY
        endhandle
      else
        -- should we highlight the non-branch boundary element?
        ENHANCE $!<elements[$!<i>]> COLOUR $!<colour.code>
        ENHANCE TOTAL LEAVE TUBE OF $!<elements[$!<i>]> COLOUR $!<colour.code>
      endif
    enddo

    -- Loop through components in the pipe piece
    -- get the pipe piece components
    !elements   = !element.cmprfa
    !max        = !elements.size()
    do !i from 1 to !max
      -- Highlight bends and leave tube
      if(!elements[!i].type.eq('BEND')) then
        ENHANCE $!<elements[$!<i>]> COLOUR $!<colour.code>
        handle ANY
        endhandle
      endif
      ENHANCE TOTAL LEAVE TUBE OF $!<elements[$!<i>]> COLOUR $!<colour.code>
      handle ANY
      endhandle
    enddo

  -- Pipe Spool
  elseif (!element.type.eq('PSPOOL')) then

    !spool    = object PIPESPOOLMANAGER()
    !elements = !spool.getBranchElements(!element)

    -- Loop through starts/ends of spool
    --do !i indices !element.pssrfa
    --  !from   = !element.pssrfa[!i].sequence
    --  !to     = !element.pserfa[!i].sequence
    --  $P $!from - $!to
    --enddo

    -- Loop through component in the pipe
    do !i indices !elements

      -- Highlight head tube if arrive is a branch
      if(!elements[!i].type.eq('BRAN')) then
        ENHANCE TOTAL HEAD TUBE OF $!<elements[$!<i>]> COLOUR $!<colour.code>
        handle ANY
        endhandle

      -- Highlight bends and leave tube
      else
        ENHANCE $!<elements[$!<i>]> COLOUR $!<colour.code>
        handle ANY
        endhandle
          ENHANCE TOTAL ARRIVE TUBE OF $!<elements[$!<i>]> COLOUR $!<colour.code>
          handle ANY
          endhandle
        --else
          ENHANCE TOTAL LEAVE TUBE OF $!<elements[$!<i>]> COLOUR $!<colour.code>
          handle ANY
          endhandle
        --endif
      endif

    enddo

  -- Hvac Spool
  elseif (!element.type.eq('HSPOOL')) then

    !spool    = object PIPESPOOLMANAGER()
    !elements = !spool.getBranchElements(!element)

    -- Loop through starts/ends of spool
    --do !i indices !element.pssrfa
    --  !from   = !element.hssrfa[!i].sequence
    --  !to     = !element.hserfa[!i].sequence
    --  $P $!from - $!to
    --enddo

    -- Loop through component in the pipe
    do !i indices !elements
      skip if(!elements[!i].type.eq('TUBI'))

      -- Highlight head tube if arrive is a branch
      if(!elements[!i].type.eq('BRAN')) then
        ENHANCE TOTAL HEAD TUBE OF $!<elements[$!<i>]> COLOUR $!<colour.code>
        handle ANY
        endhandle

      -- Highlight bends and leave tube
      else
        ENHANCE $!<elements[$!<i>]> COLOUR $!<colour.code>
        handle ANY
        endhandle
        -  ENHANCE TOTAL ARRIVE TUBE OF $!<elements[$!<i>]> COLOUR $!<colour.code>
          handle ANY
          endhandle
        --else
          ENHANCE TOTAL LEAVE TUBE OF $!<elements[$!<i>]> COLOUR $!<colour.code>
          handle ANY
          endhandle
        --endif
      endif

    enddo
  -- All other element types
  else
    ENHANCE $!<element> COLOUR $!<colour.code>
  endif

endfunction
-- End of function definition
