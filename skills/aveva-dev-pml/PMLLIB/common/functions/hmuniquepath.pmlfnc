-- Created:         July 2007
--
-- Description:
-- Function to find the path of the file passed in the dflt directories
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Filename to find in either PDMSUSER, <proj>DFLTS or PDMSDFLTS]
--   [2] [R]    [STRING]    [Related project. Only required when "CURRENT PROJECT" doesn't work]
-- Return:
--   [Data Type] [Description]
--   [FILE]      [Return the file object of the file]
--
------------------------------------------------------------------------

-- Define function
define function !!hmUniquePath(!fileName is STRING, !projectMaybe is STRING) is FILE


-- get the project 3 character code
  if(!projectMaybe.eq('')) then
    !proj    = CURRENT PROJECT
    !project = !proj.code()
  else
    !project = !projectMaybe
  endif

  !projDflts = !project + 'DFLTS'

  -- First check the file in the PDMSUSER directory
  !fileToCheck = '%PDMSUSER%\' & !fileName

  !file = object FILE(!fileToCheck)
  if (!file.exists().not()) then
    -- If not there check the file in the PROJDFLTS directory
    !fileToCheck = '%' & !projDflts & '%\' & !fileName
    !file = object FILE(!fileToCheck)
    if (!file.exists().not()) then
      -- If not there check the file in the PDMSDFLTS directory
      !fileToCheck = '%PDMSDFLTS%\' & !fileName
      !file = object FILE(!fileToCheck)
      if (!file.exists().not()) then
        !file = object FILE()
      endif
    endif
  endif

  return !file

endfunction
-- End of function definition for !!hmUniquePath(STRING)
