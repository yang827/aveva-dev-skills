--
--
-- Description:
-- function to run the show icon form utility to display a whole directory
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Fullname of the directory]
--   [2] [R]    [STRING]    [Icon size to use]
--   [3] [R]    [STRING]    [Width of form in icons]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!iconDirectory(!dirString is STRING, !iconSize is REAL, !formWidth is REAL)


!directory  = object FILE(!dirString)
!files      = !directory.files()

call !!showIcons(!files,!iconSize,!formWidth)

endfunction
-- End of function definition for !!iconDirectory()
