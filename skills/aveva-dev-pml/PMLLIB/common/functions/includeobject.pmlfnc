--
--
-- Description:
-- Add an object to the list gadget on the Show Object form. It remembers
-- which object was selected so it can set it again afterwards.
--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!includeObject(!newObject is STRING) is BOOLEAN

  !selected = STRING()
  !array    = ARRAY()

  !selected = !!showObjects.list.selection('RText')
  handle any
    -- empty list
  endhandle

  !array    = !!showObjects.list.dText
  !array.append(!newObject)


  !!showObjects.list.dText = !array
  !!showObjects.list.rText = !array

  if(not (!selected.unset() or (!selected eq ''))) then
    !!showObjects.list.select('RText', !selected)
  endif

endfunction
-- End of function definition for !!includeObject
