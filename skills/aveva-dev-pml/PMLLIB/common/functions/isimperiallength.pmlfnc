--
-- Description:
-- Returns TRUE if the current distance or bore units are imperial/US units
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--    1   R      STRING      'DIST' or 'BORE'
-- Return:
--   [BOOLEAN] [TRUE if imperial units]
--
------------------------------------------------------------------------
define function !!isImperialLength(!unitType is STRING) is BOOLEAN

  -- Input unit type
  if( !unitType.upcase() eq 'DIST' ) then
    !v = 1mm
    return !v.units().isImperial()
  else
    -- BORE
    !commonUnits = object COMUNITS()
    !unit = !commonUnits.getCurrentUnitsByPtype( !unitType.upcase() )
    return  ( !unit.upcase() inset('IN', 'FINC', 'FT', 'YD') )
  endif

endfunction
-- End of function
