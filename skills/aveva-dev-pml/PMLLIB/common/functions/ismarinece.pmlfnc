--
--  Description:     Tests if CE is a Marine type element
--                   Implemented as a temporary solution for I-675.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!ismarineCe() is BOOLEAN

  !text     = 'BLOCK CCURVE CHOLE CPANBO CPANEL CPLANE CPLATE CPNISE CPOINT CPRCUT CPREND CPRHOL CPRMRK CPRNOT CPROF CPROTR CSEAM CSTIFF CSURF $
               HBEAD HBRABO HBRAPN HBRCKT HBRFLA HBRSTI HCLIP HCOMPT HCTOUT HCURVE HDOPLA HFLANG HHOLE HNOTCH HPANBI HPANBO HPANEL HPILLR $
               HPLATE HPOINT HPRCUT HPREND HPRHOL HPRNOT HRSO HRSOF HRSOL HSEAM HSTBRA HSTIFF HSUBPN HTAP MWELD MWLDJT MWLDTB $
               FEMODL HIBLO HIPAN HICPAN HIBOU HISEA HIPLA HIHOL HINOT HICUT HISTI HIFLA HIPIL HIBRA HIDOU HIPOI HICUR HMARK$
               MOGWLD MOGOBJ STDWLD RSOWLD SSOWLD COMWLD HBLWLD HCMWLD MWLWLD FEMWLD HMKWLD GICPLA GICSTI HICHOL HICPLA HICSTI'

  !marineElements = !text.split()

  -- Common modules
  if(!marineElements.findFirst(!!CE.type).unset().eq(FALSE)) then
     return TRUE
  elseif(!!CE.dbtype.eq('MANU')) then
     return TRUE
  else
     return FALSE
  endif

endfunction
-- End of function definition
