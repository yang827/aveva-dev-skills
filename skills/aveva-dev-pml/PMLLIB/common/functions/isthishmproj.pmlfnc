--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!isThisHmProj() is BOOLEAN

!proj       = CURRENT PROJECT
!project    = !proj.code()
!configFile = 'des-holemgt-config'

!testFile   = !!hmUniquePath(!configFile, !project)

if(!testFile.set()) then
   return TRUE
else
   return FALSE
endif

endfunction
-- End of function definition for !!isThisHmProj
