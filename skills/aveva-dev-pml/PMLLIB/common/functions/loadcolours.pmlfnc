-- Created:         Tue Feb 4 11:30:30 GMT 1997
--
--
-- Description:
-- Read colour definition file, and return names and numbers.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE      Colour File
-- Return:
--   [Data Type] [Description]
--    ARRAY       all colour definitions, array of COLOUR objects
--
------------------------------------------------------------------------

-- Define function
define function !!loadColours(!file is FILE) is ARRAY

  -- Initialise Variables
  !colArray = ARRAY()
  !stdColours = true

  -- Open file
  !records = !file.readFile()
  handle any
    return !!stdColours()
  endhandle

  -- If first record of file is not "Colour Control File", then
  -- give a message and load the standard colours
  if(!records[1] neq 'Colour Control File') then
    !!alert.message('File (' + !file + ') is not a colour control file, using the currently loaded colours.')
    return !!stdColours()
  endif

  -- Loop through all !records and load colours.
  do !i indices !records

    skip if(!records[!i].trim().subString(1,1) eq '#' or !records[!i].trim().empty() or !i eq 1)

    if (!records[!i].trim().upcase() eq 'HIDE_STANDARD_COLOURS') then
      !stdColours = false
      skip
    endif

    -- Split record into colour and code
    !colourCode = !records[!i].part(-1).real()
    handle any
      skip
    endhandle
    !colourName = !records[!i].trim().part(1)
    handle any
      skip
    endhandle

    COLOUR $!<colourCode> $!<colourName>

    !colArray.append(!colourCode)

  enddo

  if (!stdColours or !colArray.empty()) then
    !colArray.appendArray(!!stdColours())
  endif

  return !colArray

endfunction
-- End of function definition for !!loadColours
