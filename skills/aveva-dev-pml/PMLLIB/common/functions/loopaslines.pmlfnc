-- Created:         Mon Apr 7 16:33:13 WAT 1997
--
--
-- Description:
-- Converts all the edges (regardless of fillets) into a set of bounded
-- lines. Positions are mapped passed plane, if an unset plane is passed
-- then the extrusion is uses as a plane.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Loop/Ploop
--    2   R      VECTOR      Plane as vector
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of FINITELINE objects
--
------------------------------------------------------------------------

-- Define function
define function !!loopAsLines (!loop is DBREF, !plane is VECTOR) is ARRAY

  -- Initialise Variables
  !lines           = ARRAY()

  -- If loop does not have any vertices, then return
  if(!loop.mCount eq 0) then
    return !lines
  endif

  -- Get Members
  !members   = !!collectMembersOf(!loop,'')

  -- Get all position of items
  !block     = object BLOCK('!members[!evalIndex].pos')
  !positions = !members.evaluate(!block)
  !positions.append(!positions[1])

  -- Create an array of lines (zero Z component of position)
  do !i indices !members
    !lines[!i]                  = object FINITELINE()

    if(!plane.position.east.unset()) then
      !lines[!i].startPosition    = !positions[!i]
      !lines[!i].startPosition.up = 0
      !lines[!i].endPosition      = !positions[!i + 1]
      !lines[!i].endPosition.up   = 0
    else
      !lines[!i].startPosition    = !!positionOnPlane(!positions[!i],!plane)
      !lines[!i].endPosition      = !!positionOnPlane(!positions[!i + 1],!plane)
    endif
  enddo

  return !lines

endfunction
-- End of function definition for !!loopAsLines
