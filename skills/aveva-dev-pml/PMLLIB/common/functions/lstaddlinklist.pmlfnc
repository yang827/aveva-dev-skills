--
--
-- Description:
-- Add a List to the generic list storage system.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List register in Global Store
--    2   R      GADGET      List Gadget to be registered in store
--    3   R      BOOLEAN     Display empty list for gadget
--    4   R      ARRAY       Additional DText for List
--    5   R      ARRAY       RText for DText
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!lstAddLinkList (!store is STRING, !gadget is GADGET, !empty is BOOLEAN, !dText is ARRAY, !rText is ARRAY)

  -- Check if Global Store exist, if not create it
  if(undefined(!!lstGlobalStore)) then
    !!lstGlobalStore = object LSTGLOBAL()
  endif

  -- Check if Store exists
  if(!!lstGlobalStore.exists(!store).not()) then
    !!lstGlobalStore.add(!store)
  endif

  -- Add Gadget Link to Store
  !!lstGlobalStore.addLinkList(!store, !gadget, !empty, !dText, !rText)

endfunction
-- End of function definition for !!lstAddLinkList
