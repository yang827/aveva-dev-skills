--
-- Description:
-- Add a list to the
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List register in Global Store
--    2   R      STRING      List Name
--    3   R      ARRAY       List Contents
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!lstAddList(!store is STRING, !title is STRING, !list is ARRAY)

  -- Check if Global Store exist, if not create it
  if(undefined(!!lstGlobalStore)) then
    !!lstGlobalStore = object LSTGLOBAL()
  endif

  -- Check if Store exists
  if(!!lstGlobalStore.exists(!store).not()) then
    !!lstGlobalStore.add(!store)
  endif

  -- Get Store Number
  !storeNumber = !!lstGlobalStore.number(!store)

  -- Add List to Store
  !!lstGlobalStore.stores[!storeNumber].addList(!title, !list)

endfunction
-- End of function definition for !!lstAddList
