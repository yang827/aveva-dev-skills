define function !!lstBuild()
  !!lstGlobalStore.delete()
  handle any
  endhandle

  pml reload object LSTGLOBAL
  pml reload object LST
  pml reload object LSTLINKLIST
  pml reload object LSTLINKMENU
  pml reload object LSTSTORE

--   -- Load List Store with some data
--     -- Include Drawlist into list
--     !collection[1] = 'Element 1'
--     !collection[2] = 'Element 2'
--     !collection[3] = 'Element 3'
--     !collection[4] = 'Element 4'
--     !collection[5] = 'Element 5'
--     call !!lstAddList('DBREFS', 'Drawlist',        !collection)
--
--     -- Include Obstruction List into list
--     call !!lstAddList('DBREFS', 'Obstruction List', ARRAY())
--
--     -- Include Claim List into list
--     !collection[6] = 'Element 6'
--     !collection[7] = 'Element 7'
--     !collection[8] = 'Element 8'
--     !collection[9] = 'Element 9'
--     call !!lstAddList('DBREFS', 'Claim List',       !collection)

  -- Build Forms
  pml reload form   !!lstDbRefs
  pml reload form   !!lstNew
  pml reload form   !!testLst

  -- Show Forms
  show !!lstDbRefs
  show !!testLst

endfunction
-- End of function definition for !!lstBuild
