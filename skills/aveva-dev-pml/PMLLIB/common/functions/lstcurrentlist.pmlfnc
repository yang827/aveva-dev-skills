--
--
-- Description:
-- function to get the current list from the old form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   [ARRAY]     [Array of elements in the current list]
--
------------------------------------------------------------------------

define function !!lstCurrentList() is ARRAY

 !array = ARRAY()
 !form = !!cdcList
 !numb = !form.name


 !block = object BLOCK('!!cdList' & !numb)

 if(!block.string().lowcase().eq('!!cdlist0')) then
   return !array
 else
   !array = !block.evaluate()


   return !array

 endif

endfunction
-- End of function definition for !!lstCurrentList
