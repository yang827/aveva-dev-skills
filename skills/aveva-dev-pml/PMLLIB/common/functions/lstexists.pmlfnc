--
-- Description:
-- Check if the passed list exists in the store/
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List register in Global Store
--    2   R      STRING      List Name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!lstExists(!store is STRING, !title is STRING) is BOOLEAN

 -- Get Store Number
  !storeNumber = !!lstGlobalStore.number(!store)

  return !!lstGlobalStore.stores[!storeNumber].exists(!title)

endfunction
-- End of function definition for !!lstExists
