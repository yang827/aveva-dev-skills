--
--
-- Description:
-- Returns the list members for the give store and tag,
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List register in Global Store
--    2   R      STRING      List Tag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!lstGetMembers(!store is STRING, !tag is STRING) is ARRAY

  -- Get Store Number
  !storeNumber = !!lstGlobalStore.number(!store)

  -- Get the members of the list
  !members     = !!lstGlobalStore.stores[!storeNumber].members(!tag)

  return !members

endfunction
-- End of function definition for !!lstGetMembers
