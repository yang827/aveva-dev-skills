--
-- Description:
-- Remove list from relevant list store
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List register in Global Store
--    2   R      STRING      List Tag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!lstRemoveList(!store is STRING, !tag is STRING)

  -- Get Store Number
  !storeNumber = !!lstGlobalStore.number(!store)

  -- Remove list from Store
  !!lstGlobalStore.stores[!storeNumber].removeList(!tag)

endfunction
-- End of function definition for !!lstRemoveList
