--
--
-- Description:
-- Replaces the members of a list.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List register in Global Store
--    2   R      STRING      List Name
--    3   R      ARRAY       List Contents
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!lstReplaceList(!store is STRING, !title is STRING, !list is ARRAY)

  -- Get Store Number
  !storeNumber = !!lstGlobalStore.number(!store)

  -- Add List to Store
  !!lstGlobalStore.stores[!storeNumber].replaceList(!title, !list)

endfunction
-- End of function definition for !!lstReplaceList
