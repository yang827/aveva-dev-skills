--
-- Description:
-- Returns current lists for the passed storage area.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Store Identifier
-- Return:
--   [Data Type] [Description]
--    ARRAY       Defined Stores
--
------------------------------------------------------------------------

-- Define function
define function !!lstStoreLists(!store is STRING) is ARRAY

  return !!lstGlobalStore.storedLists(!store)

endfunction
-- End of function definition for !!lstStoreLists
