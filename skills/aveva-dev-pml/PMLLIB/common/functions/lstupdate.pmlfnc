--
-- Description:
-- Update all links for passed store type
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      List register in Global Store
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!lstUpdate(!store is STRING)

 -- Get Store Number
  !storeNumber = !!lstGlobalStore.number(!store)

  -- Update associations for list
  !!lstGlobalStore.stores[!storeNumber].update()

endfunction
-- End of function definition for !!lstUpdate
