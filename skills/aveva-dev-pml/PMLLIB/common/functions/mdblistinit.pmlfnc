--
-- Description:
-- Function to initialise the MDB List form based on the current
-- display mode.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!mdbListInit()

  -- Call function to set the contents of an MDB list gadget
  call !!mdbSetList('*',!!mdbList.mdbs)

  -- Call function to display selected MDB information
  call !!mdbListSelect(!!mdbList.mdbs)

endfunction
-- End of function definition for !!mdbListInit
