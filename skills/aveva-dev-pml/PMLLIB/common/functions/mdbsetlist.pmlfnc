-- Created:         Mon Jan 20 14:42:34 GMT 1997
--
--
-- Description:
-- Function to COLLECT the project MDBS and place the output in the
-- supplied list gadget name dependent on the display mode.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Filter string
--    2   RW     GADGET      List Gadget name to assign MDB List to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!mdbSetList(!filterValue is STRING, !outGadget is GADGET)

  -- This form should not be viewable while MDB selection
  -- takes place
  if (Defined (!!modifyMdb)) then
     if (!!modSessMdb.shown() and !outGadget.owner().name() eq 'SELECTMDB') then
       hide !!modifyMdb
     endif
  endif

  -- Get a list of MDBS
  !nameList = MDBS

  -- Get the list of MDB descriptions
  do !i indices !nameList

    !descList[!i] = !nameList[!i].description

    if (!descList[!i].empty()) then

      -- No description so use the name
      !descList[!i] = !nameList[!i].name.after(|/|)

    endif

  enddo

  -- Sort by name or description
  if (!!sessionSettings.showAs eq |NAME|) then

    !sort = !nameList.sortedIndices()

  elseif (!!sessionSettings.showAs eq |DESC|) then

    !sort = !descList.sortedIndices()

  endif

  -- Check we didn't receive an empty filter string
  if (!filterValue.empty()) then

    !filterValue = |*|

  endif

  -- Generate an array to assign to output list gadget
  !dispList = ARRAY()
  !replList = ARRAY()

  -- Process the sorted arrays
  do !j values !sort

    if (!!sessionSettings.showAs eq |NAME|) then

      -- Filter list on name
      !filterString = !nameList[!j].name.after(|/|)

    else

      -- Filter list on Mdb description
      !filterString = !descList[!j]

    endif

    -- Ignore line not matching the filter
    skip if (not !filterString.matchWild(!filterValue))

    -- Append to the display list
    if (!!sessionSettings.showAs eq |NAME|) then

      !dispList.append(!nameList[!j].name.after(|/|))

    elseif (!!sessionSettings.showAs eq |DESC|) then

      !dispList.append(!descList[!j])

    endif

    -- Append name to the replacement texts
    !replList.append(!nameList[!j].name)

  enddo

  -- Load the created array into the List Gadget
  !outGadget.clear()

  if (not !dispList.empty()) then

    !outGadget.dText = !dispList
    !outGadget.rText = !replList

  endif

endfunction
-- End of function definition for !!mdbSetList
