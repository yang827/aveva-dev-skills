--
-- File:            memberoftype.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:      <type> <val> OF <gid>
--
-- Author:          N.Holmes
-- Created:         Fri Apr 4 13:48:26 WAT 1997
--
--
-- Description:
-- Returns the <nth> item of the given <type> of the passed <item>.
-- If no type is given, the <nth> item will be returned, if a -ve value
-- is given, the <type> from the end of the list is return.
--
--    !item = !!memberOfType('',1,!!ce)           return the first item
--    !item = !!memberOfType('',-1,!!ce)          return the last item
--    !item = !!memberOfType('ignored',0,!!ce)    return the search item
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of item being searched for
--    2   R      REAL        The <nth> instance of the item
--    3   R      DBREF       The element members list to search
-- Return:
--   [Data Type] [Description]
--    DBREF       Item found
--
------------------------------------------------------------------------

-- Define function
define function !!memberOfType (!type is STRING, !nthType is REAL, !search is DBREF) is DBREF

  -- Initialise Variables
  !index       = !nthType
  !returnDbRef = object DBREF()

  -- If NthType is zero, then return the current element
  if(!index eq 0) then
     return !search
  endif

  -- Return if there is no members
  if(!search.mCount eq 0) then
    return !returnDbRef
  endif

  -- Nth item is greater than the number of members, then return
  if(!index.abs() gt !search.mCount) then
    return !returnDbRef
  endif

  -- If no Type is passed, then return the relevant entry
  if(!type.trim().empty()) then

    -- From top
    if(!index gt 0) then
       !returnDbRef = !search.members[!index]
       return !returnDbRef

    -- From bottom
    else
       !index = !search.mCount - (!index.abs() - 1)
       !returnDbRef = !search.members[!index]
       return !returnDbRef
    endif
  endif

  -- Members
  !members = !search.members

  -- Get types of members of search item
  !block   = object BLOCK('!members[!evalIndex].type')
  !types   = !members.evaluate(!block)

  -- Invert the list if we are looking from the end
  if(!index lt 0) then
    !members.invert()
    !types.invert()
    !index = !index.abs()
  endif

  -- Get all entries of the passed type
  !instances = !types.find(!type.upcase())

  -- Return if there are no instances found
  if(!instances.size() lt !index) then
    return !returnDbRef
  endif

  -- Get the <nth> entry from the instance list
  !instance    = !instances[!index]
  !returnDbRef = !members[!instance]
  return !returnDbRef

endfunction
-- End of function definition for !!memberOfType
