--
--
-- Description:
-- Displays the Members of the passed item in the correct position
-- of the members list.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item members are to be displayed for
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!membersDisplay (!passedItem is DBREF)

  -- Navigate
  if(!!membersList.navigate.selection().boolean()) then
    !!ce = !passedItem
    $!!ce
  endif

  -- Initialise Variables
  !item    = !passedItem
  !dbDepth = !item.ddepth + 1

  -- If there are no members, then return
  if(!item.members.unset()) then
    !!membersList.current = !passedItem
    return
  endif

  -- Load Dtext and Rtext into temporary lists
  !dText   = !!membersList.members.dText
  !rText   = !!membersList.members.rText

  !itemPos = !rText.findFirst(!passedItem.string())

  -- If Item and Current selection is the same, the we want to close
  -- the offspring if shown
  if(!item eq !!membersList.current) then

    -- Get The Owner
    if(!item.owner.type eq 'WORL') then
      !owner    = !!membersList.world
    else
      !owner    = !item.owner
    endif

    -- Items hierarchy position
    !sequence = !owner.members.findFirst(!item)

    -- If we are at the last item in the list, then get the next
    if (!sequence eq !owner.mCount) then
      !next     = !item

      -- Loop until we find the next item
      do

        -- If at world, use the first world
        break if(!next.owner.type eq 'WORL')

        !next     = !next.owner
        !sequence = !next.owner.members.findFirst(!next)

        skip if(!sequence eq !next.owner.mCount)
        !item     = !next
        break
      enddo

    endif

    -- We have a problem with where Owner is World
    if(!item.owner.type eq 'WORL') then
      !owner = !!membersList.world
    else
      !owner = !item.owner
    endif

    -- Get the "sequence from the owners members list"
    !sequence = !owner.members.findFirst(!item)

    -- Where the picked item is the last in the owners list (this should
    -- only happen for the last world member)

    if(!sequence eq !owner.mCount) then
      !nextPos = !rText.size() + 1

    -- Get Next element to item
    else
      !next  = !owner.members[!sequence + 1]

      -- Locate hierarchical position in the list RTEXT
      !nextPos = !rText.findFirst(!next.string())
    endif

    -- If there is item in the list, then display them
    if(!nextPos - !itemPos eq 1) then
      golabel /Build
    endif

    -- Remove the element
    !from    = !itemPos + 1
    !to      = !nextPos - !from
    !removed = !dText.removeFrom(!from, !to)
    !removed = !rText.removeFrom(!from, !to)

    golabel /Display
  endif

  -- Build Members List
  label /Build

  -- Select picked item
  !first   = !rText.findFirst(!passedItem.members[1].string())
  if(!first.set()) then
    !!membersList.current = !passedItem
    return
  endif

  -- Get Members of Item
  !block   = object BLOCK('!passedItem.members[!evalIndex].flnn')
  !name    = !passedItem.members.evaluate(!block)

  !block   = object BLOCK('!passedItem.members[!evalIndex].type')
  !type    = !passedItem.members.evaluate(!block)

  -- Format
  !padding = substring('                                        ',1,!dbDepth * 2)
  !block   = object BLOCK('!padding & substring(!type[!evalIndex] & |        |,1,8) & !name[!evalIndex]')
  !display = !name.evaluate(!block)
  !block   = object BLOCK('!passedItem.members[!evalIndex].string()')
  !replace = !passedItem.members.evaluate(!block)

  -- Insert the Display Text and Replacement text into the Dtext & Rtext
  !dText.insertArray(!!membersList.members.val + 1,!display)
  !rText.insertArray(!!membersList.members.val + 1,!replace)

  -- Display
  label /Display

  -- Load Gadget
  !!membersList.members.dText = !dText
  !!membersList.members.rText = !rText

  -- Select Item
  if(!passedItem.type eq 'WORL') then
    !!membersList.members.val = 1
  else
    !!membersList.members.select('RTEXT',!passedItem.string())
    !!membersList.current = !passedItem
  endif



endfunction
-- End of function definition for !!membersDisplay
