-- Define function
define function !!membersList()

  -- Initialise Variables
  !current = !!ce

  -- See which DB we want to look into
  !module = !!module()
  if(!module.ddlType eq !!membersList.worldType.selection('RTEXT')) then
    !world   = World

  -- Find the appropriate world
  else

    -- Design Worlds
    if(!!membersList.worldType.selection('RTEXT') eq 'DESI') then
      var !collect COLLECT ALL (SITE)

    -- Catalogue Worlds
    elseif (!!membersList.worldType.selection('RTEXT') eq 'CATA') then
      var !collect COLLECT ALL (CATA SPWL)

    -- Property Worlds
    elseif (!!membersList.worldType.selection('RTEXT') eq 'PROP') then
      var !collect COLLECT ALL (MATW CASW RUNW CMPW CONW)

    -- Schematic Worlds
    elseif (!!membersList.worldType.selection('RTEXT') eq 'SCHE') then
      var !collect COLLECT ALL (SCGROU)

    endif

    -- If there is no members in the selected, the we can't find a world
    if(undefined(!collect)) then
      !!alert.error(|Unable to find any Worlds (we're all alone).|)
      return
    endif

    -- Move to first item in the collection
    !!ce     = !collect[1].dbRef()
    !world   = !!ce.owner
    !!ce = !current
  endif

  -- Initialise Form List
  !!membersList.members.clear()
  !!membersList.current = object DBREF()
  !!membersList.world   = !world

  -- Display Members
  call !!membersDisplay(!world)

endfunction
-- End of function definition for !!membersList
