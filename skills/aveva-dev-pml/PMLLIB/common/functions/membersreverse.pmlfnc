--
-- Description:
-- Reorder members in reverse
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
--
------------------------------------------------------------------------

-- Define function
define function !!membersReverse()

  -- reorder members
  !memberCount = !!ce.members.size()
  if (!memberCount gt 1) then
    do !i from (!memberCount - 1) to 1 by -1
      REORDER $!i AFTER $!memberCount
    enddo
  endif

  -- branch requires further processing
  if (!!ce.type eq 'BRAN') then
    -- flip components and reselect tube
    do !i to !memberCount
      $!i
      FLIP
      RESELECT LSTU
      END
    enddo
    -- reverse head and tail data
    !href = !!ce.href
    !hbor = !!ce.hbor
    !hdir = !!ce.hdir
    !hpos = !!ce.hpos
    !hcon = !!ce.hcon
    !tRef = !!ce.tRef
    !tbor = !!ce.tbor
    !tdir = !!ce.tdir
    !tPos = !!ce.tPos
    !tcon = !!ce.tcon
    HREF $!tRef
    HBOR $!tbor
    HDIR $!tdir
    HPOS $!tPos
    HCON $!tcon
    TREF $!href
    TBOR $!hbor
    TDIR $!hdir
    TPOS $!hpos
    TCON $!hcon
    SELECT HSTU
  endif

endfunction
-- End of function definition for !!membersReverse
