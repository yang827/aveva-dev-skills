--
--
-- Description:
-- Function to clear all mms attributes from all control elements below an item
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [PDMS Element to clear attribute values]
-- Return:
--   [Data Type] [Description]
--   [BOOLEAN]   [True if function cleared the values successfully]
--
------------------------------------------------------------------------

-- Define function
define function !!mmsClearAll(!dbRef is DBREF) is BOOLEAN

-- check to see if the project is set-up for 3DMM
   !ref = !!ce
--   !projectData = CURRENT PROJECT
--   !project = !projectData.code()

   if(!!mmsIsThis3dmmProj().not()) then
      return FALSE
   endif

-- get the types from the config file
   !types = !!mmsConfig.objectType
   handle ANY
   -- mmsconfig not set
      var !controlElementList COLL ALL (SITE ZONE PIPE STRU HVAC EQUI INST SPLDRG CMPF CMFI) for $!dbRef
   elsehandle NONE
      !typesAsString = !!comArrayToString(!types)
      var !controlElementList COLL ALL (SITE ZONE $!typesAsString) for $!dbRef
   endhandle
-- check to see if the element is the correct type


   do !i values !controlElementList
       !!mmsClearAttributes(!i.dbRef(),!!error.text, 'SILENT')
   enddo

  !!ce = !ref

  return TRUE

endfunction
-- End of function definition for !!mmsClearAll()
