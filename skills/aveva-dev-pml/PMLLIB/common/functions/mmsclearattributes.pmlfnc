--
-- Author:          A.Kirkland
-- Created:         Thu 1 Aug 14:00 GMT 2002
--
--
-- Description:
-- Function to clear the values of the MMS control attribute UDAs
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [DBREF]     [PDMS Element to clear attribute values]
--   [2] [RW]   [STRING]    [Reason why the function could not complete]
-- Return:
--   [Data Type] [Description]
--   [BOOLEAN]   [True if function cleared the values successfully]
--
------------------------------------------------------------------------

-- Define function
define function !!mmsClearAttributes(!dbRef is DBREF, !errorMessage is STRING, !silent is STRING) is BOOLEAN

-- check to see if the project is set-up for 3DMM

--   !projectData = CURRENT PROJECT
--   !project     = !projectData.code()

   if(!!mmsIsThis3dmmProj().not()) then
      return FALSE
   endif

-- get the types from the config file
   !types = !!mmsConFig.objectType
   handle ANY
   -- mmsConFig not set (assume the list below if config not correct)
      !controlElementList = 'SITE ZONE PIPE STRU HVAC EQUI INST SPLDRG CMPF CMFI'
   elsehandle NONE
      !asString           = !!comArrayToString(!types)
      !controlElementList = 'SITE ZONE ' + !asString
   endhandle

-- check to see if the element is the correct type

   if(!controlElementList.match(!dbRef.hardType).eq(0)) then
      return FALSE
   endif

-- if it is named assume it IS controlled and don't allow to uncontrol
   if(!dbRef.isNamed and undefined(!!mmsOverride)) then
      !errorMessage = 'Element is named and therefore cannot be uncontrolled.'
      if(!silent.upcase().neq('SILENT')) then
         error '$!errorMessage'
      endif
      return FALSE
   endif

-- check to see if it can be claimed

   if(!!comClaimDac(!dbRef,'DACCLA','').not()) then
      !errorMessage = 'Not able to claim ' + !dbRef.fullname
      return FALSE
   endif

-- claim out the element (this is probably done by comclaimdac; check with Martin)

   EXTRACT CLAIM $!dbRef
   handle ANY
   -- in case in the master DB
   endhandle
   CLAIM $!dbRef
   handle ANY
   -- in case in an update DB
   endhandle

-- set array of control attributes to clear
   !ref = !!ce

   !!mmsAccess         = '3DMM ADMIN'
   !!ce = !dbRef

-- loop through each attribute and set the values
   if(!!mmsConFig.conAttributes.unset()) then
      write 'Config file has not loaded the control attributes correctly'
   endif

   do !i indices !!mmsConFig.conAttributes[1]
      $!!mmsConFig.conAttributes[1][$!i] $!!mmsConFig.conAttributes[2][$!i]
      handle ANY
      -- in case DACS are set-up incorrectly
         if(!silent.upcase().neq('SILENT')) then
            !expandString = !!mmsConFig.conAttributes[1][!i]
            write 'not able to reset $!expandString, check the new DACs have been run in to ADMIN'
         endif
      endhandle
   enddo

   !!mmsAccess.delete()

-- update the attribute display form if it is displayed
   if(!silent.upcase().neq('SILENT')) then
    if(defined (!!mmsDisplayAttributes) and !!mmsDisplayAttributes.shown()) then
        !!mmsDisplayAttributes.init()
    endif
   endif

  !!ce = !ref

  return TRUE

endfunction
-- End of function definition for !!mmsClearAttributes()
