--
--
-- Description:
-- Returns If using 3dmm
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!mmsIsThis3dmmProj() is BOOLEAN

!proj       = CURRENT PROJECT
!project    = !proj.code()
!configFile = !project & '.cfg'

!testFile   = !!mmsUniquePath(!configFile, !project)

-- defect 4228 if the config file <proj>.cfg is not found try and find clash_<proj>.cfg
    if(!testFile.unset()) then
      !configFile = 'clash_' + !project + '.cfg'
      !testFile   = !!mmsUniquePath(!configFile,'')
    endif

if(!testFile.set()) then
  -- check for availability of mms appware
  !path = !!pml.getPathName('mmsconfig.pmlobj')
  handle (44,33)
    -- file not found
    return FALSE
  elsehandle none
   return TRUE
  endhandle
else
   return FALSE
endif

endfunction
-- End of function definition for !!mmsIsThis3dmmProj
