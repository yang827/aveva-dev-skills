--
--
-- Description:
-- Function to find the path of the file passed in the dflt directories
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [Filename to find in either PDMSUSER, <proj>DFLTS or PDMSDFLTS]
--   [2] [R]    [STRING]    [Related project. Only required when "CURRENT PROJECT" doesn't work]
-- Return:
--   [Data Type] [Description]
--   [FILE]      [Return the file object of the file]
--
------------------------------------------------------------------------

-- Define function
define function !!mmsUniquePath(!fileName is STRING, !projectMaybe is STRING) is FILE

$(
   !files = !!uniquePath(!fileName, 'USER PROJ PDMS','',!project)
   !file = !files[1]
   handle ANY
    !file = object FILE()
   endhandle

   return !file
$)

-- get the project 3 character code
  if(!projectMaybe.eq('')) then
    !proj    = CURRENT PROJECT
    !project = !proj.code()
  else
    !project = !projectMaybe
  endif

  !projDflts = !project + 'DFLTS'

  !directoryName = !!mmsWhereIsFile(!fileName,'PDMSUSER')
  if(!directoryName.upcase().match('NOT FOUND').neq(0) or !directoryName.upcase().match('NOT EXIST').neq(0)) then
     !directoryName = !!mmsWhereIsFile(!fileName,!projDflts)
  endif

  if(!directoryName.upcase().match('NOT FOUND').neq(0) or !directoryName.upcase().match('NOT EXIST').neq(0)) then
     !directoryName = !!mmsWhereIsFile(!fileName,'PDMSDFLTS')
  endif

  if(!directoryName.upcase().match('NOT FOUND').neq(0) or !directoryName.upcase().match('NOT EXIST').neq(0)) then
    !file = object FILE()
  else
    !fullname = !directoryName + '\' + !fileName
    !file     = object FILE(!fullname)
  endif

  return !file

endfunction
-- End of function definition for !!mmsUniquePath(STRING)
