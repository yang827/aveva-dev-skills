--
--
-- Description:
-- Function to find a file in a evar
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [STRING]    [File Name to find]
--   [2] [R]    [STRING]    [Which Evar to search]
-- Return:
--   [Data Type] [Description]
--   [STRING]    [Path of the file]
------------------------------------------------------------------------

-- Define function
define function !!mmsWhereIsFile(!fileToFind is STRING, !evarToSearch is STRING) is STRING

-- initialise variables

   -- Combined to avoid problems with excessively long multi-path environment variable definitions
   --var !fullPath evar $!evarToSearch
   --!paths = !fullPath.split()
    !paths = !!evarSplit(!evarToSearch)

-- search the path for existence of the file.

   if(!paths.empty()) then
      !return = 'Environment Variable $!evarToSearch does not exist'
   else
   do !i indices !paths
      !fileName = !paths[!i] + '/' + !fileToFind
      !test = object FILE(!fileName)
      if(!test.exists()) then
         !return = '$!paths[$!i]'
         break
      else
         !return = 'File $!fileToFind not found'
      endif
   enddo
   endif

-- return the result of the search
   return  !return

endfunction
-- End of function definition for !!mmsWhereIsFile
