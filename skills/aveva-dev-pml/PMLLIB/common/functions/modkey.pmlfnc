--
-- Description:
-- return modkey for modules
--

-- Define function
define function !!modkey(!module is STRING) is STRING

  if (!module.upcase() eq 'DESIGN' or !module.upcase() eq 'OUTFITTING') then
    !modkey = 'des'
  elseif(!module.upcase() eq 'SPOOLER') then
    !modKey = 'spl'
  elseif(!module.upcase() eq 'DRAFT' or !module.upcase() eq 'OUTFITTINGDRAFT') then
    !modKey = 'dra'
  else
    !modKey = ''
  endif
  return !modkey
endfunction
-- End of function definition for !!modkey
