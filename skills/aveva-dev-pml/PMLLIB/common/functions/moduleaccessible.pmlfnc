--
-- Description:
-- Check whether the user can access the proposed module
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]        [Description]
--    1   R      MODULEBARDATA      Module
--
------------------------------------------------------------------------

-- Define function
define function !!moduleAccessible(!moduleDef is MODULEBARDATA) is BOOLEAN

  !mm = object AVEVAModuleManager()
  !m = !mm.FindInProduct(!moduleDef.name)
  !accessible = !m.Name().upcase() ne 'UNSET'

  return !accessible

endfunction
-- End of function definition for !!moduleAccessible
