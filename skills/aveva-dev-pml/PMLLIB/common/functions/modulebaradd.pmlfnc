--
--
-- Description:
-- Function to add a MODULEBARDATA object to the module data store.
-- Function to become a method !!moduleBar.add(object MODULEBARDATA)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MODULEBARDATA Module data to be stored.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!moduleBarAdd(!moduleData is MODULEBARDATA)

  -- Add module data to the store
  if (undefined(!!modules)) then
    !!modules.append(!moduleData)
  endif

endfunction
-- End of function definition for !!moduleBarAdd
