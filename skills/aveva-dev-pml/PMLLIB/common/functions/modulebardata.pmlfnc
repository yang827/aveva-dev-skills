--
--
-- Description:
-- Function to read the module bar defaults data.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name of Module Bar defaults data file.
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of MODULESBARDATA objects
--
------------------------------------------------------------------------

-- Define function
define function !!moduleBarData(!filename is STRING) is ARRAY

  -- Initialise variables
  !file        = object FILE()
  !main        = BOOLEAN()
  !sub         = BOOLEAN()
  !returnData  = ARRAY()

  -- Check that file exists
  !file.file(!filename)
  if (!file.exists().not()) then

    !!alert.error(|Defaults file | & !filename & | does not exist|)
    return !returnData

  endif

  --Read the entire defaults file before processing
  !records = !file.readFile()
  handle any

    !!alert.error(|Cannot open defaults file | & !filename)
    return !returnData

  endhandle

  -- Process the list of records
  do !i indices !records

    -- Skip blank lines
    skip if (!records[!i].empty())

    -- Process comment lines
    if (!records[!i].subString(1,1) eq |#|) then

      -- Check to see if following section is main headings
      if (!records[!i].match(|#Mainlist|) gt 0) then

        !main = true
        skip

      elseif (!records[!i].match(|#Sublist|) gt 0) then

        !sub     = true
        !subName = !records[!i].part(2).upcase()
        skip

      elseif (!records[!i].match(|#Endlist|) gt 0) then

        !main = false
        !sub  = false
        skip

      endif

      -- Skip other comment lines
      skip

    endif

    -- Create an empty object
    !data = object MODULEBARDATA()

    -- Set object members
    !data.name           = !records[!i].part(1,|\|).upcase()
    !data.command        = !records[!i].part(2,|\|)
    !data.description    = !records[!i].part(3,|\|)
    !data.gui            = !records[!i].part(4,|\|).boolean()
    !data.restricted     = !records[!i].part(5,|\|).boolean()
    !data.dbRw           = !records[!i].part(6,|\|).boolean()
    !data.directory      = !records[!i].part(7,|\|)

    -- Set the level in the menu
    if (!main) then

      !data.level = |main|

    elseif (!sub) then

      !data.level = !subName

    endif

    -- Append object to form member
    !returnData.append(!data)

  enddo

  return !returnData

endfunction
-- End of function definition for !!moduleBarData
