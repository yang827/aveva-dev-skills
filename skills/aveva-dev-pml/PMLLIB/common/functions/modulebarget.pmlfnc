--
--
-- Description:
-- Function to return a MODULEBARDATA object for the passed
-- module name. The returned data is extracted from the !!moduleBar
-- defaults array.
-- Function to be replaced by a method !!moduleBar.get(string MODULE)
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Module name
-- Return:
--   [Data Type] [Description]
--    MODULEBARDATA  Data about a module entry
--
------------------------------------------------------------------------

-- Define function
define function !!moduleBarGet(!module is STRING) is MODULEBARDATA

  !returnValue = object MODULEBARDATA()

  -- get module data
  !moduleDefaults = !!moduleData()

--  !searchBlock     = object BLOCK(|!moduleDefaults[!evalIndex].name|)
--  !moduleNames     = !moduleDefaults.evaluate(!searchBlock)

  do !i indices !moduleDefaults
    if (!moduleDefaults[!i].name.upcase() eq !module) then
      !returnValue = !moduleDefaults[!i]
    endif
  enddo

  -- Return the module data
  return !returnValue

endfunction
-- End of function definition for !!moduleBarGet
