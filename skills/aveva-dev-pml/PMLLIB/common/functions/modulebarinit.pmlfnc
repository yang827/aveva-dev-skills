--
--
-- Description:
-- Function to initials the Module Switch menu bar.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!moduleBarInit()

  -- Initialise variables
  !sessionData = CURRENT SESSION
  !access      = !sessionData.user().access
  --!module      = !sessionData.module()
  !module      = !!module().appName.upcase()

  !mdb         = !sessionData.mdb().name
  if (!mdb.unset()) then
    !mdb = 'unset'
  endif

  !project     = CURRENT PROJECT
  !levelBlock  = object BLOCK(|!!moduleBar.defaults[!evalIndex].level|)

  -- Set the form title
  !!moduleBar.formTitle = |PDMS - | & !access & | Access    Project : | & $
                          !project.code() & |  MDB : | & !mdb

  -- Process defaults list
  do !i indices !!moduleBar.defaults

    -- Initialise loop variable
    !restrict      = false
    !currentModule = false

    -- Skip sub-menu options
    skip if (!!moduleBar.defaults[!i].level.upcase() ne |MAIN|)

    -- Check to see if the item is the current module
    if (!!moduleBar.defaults[!i].name.upcase() eq !module) then

      -- Set flag to grey out module
      !currentModule = true

    endif

    -- Process items which display submenus
    if (!!moduleBar.defaults[!i].command eq |SUBMENU|) then

      -- Get subname name
      !menuName = !!moduleBar.defaults[!i].name

      -- See is sub-menu has members
      !subMenuItems = !!moduleBar.defaults.evaluate(!levelBlock).find(!menuName)
      if (unset(!subMenuItems)) then

        -- Empty menu so restrict it
        !restrict = true

      else

        -- Check to see if all sub-menu members are restricted
        !restrict = true
        do !j values !subMenuItems
          !restrict = (!!moduleBar.defaults[!j].restricted and !restrict)
        enddo

      endif

      !gadget = !menuName

    else

      -- Set the gadget properties
      !gadget   = !!moduleBar.defaults[!i].command
      !restrict = !!moduleBar.defaults[!i].restricted

    endif

    -- Set button states
    if (!currentModule or (!restrict and !access neq |Free|)) then

      -- Make button inactive
      !!moduleBar.$!<gadget>.active = false

    else

      -- Make button active
      !!moduleBar.$!<gadget>.active = true

    endif

  enddo

endfunction
-- End of function definition for !!moduleBarInit
