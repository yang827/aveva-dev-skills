-- Description:
-- Function to load the Module Defaults data file. The module data is
-- stored against the ModuleBar form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!moduleBarLoad()

  -- Initialise variables
  !!moduleBar.defaults = !!moduleData()

endfunction
-- End of function definition for !!moduleBarLoad
