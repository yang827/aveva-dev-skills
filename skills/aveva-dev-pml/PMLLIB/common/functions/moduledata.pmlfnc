--
--
-- Description:
-- Module definitions used by ModuleBar for module switches.
-- Icon names used on menu are derived as follows:-
--    Module<Command/Sub-menu Name>  - Main pixmap
--    Module<Command/Sub-menu Name>S - Selected pixmap
--    Module<Command/Sub-menu Name>I - Inactive pixmap
--
------------------------------------------------------------------------
define function !!moduleData() is ARRAY

  if (defined(!!moduleDataCache)) then
    if( !!moduleDataCache.modules.empty().not() ) then
      return !!moduleDataCache.modules
    endif
  endif

    !!moduleDataCache = object MODULEDATACACHE()

  !mm = object AVEVAModuleManager()

  !modules = !mm.ProductModuleList()

  do !i indices !modules
    skip if not !modules[!i].IsSwitchable()

    !module = object ModuleBarData()
    !module.name = !modules[!i].Name().upcase()
    !module.command = !modules[!i].Name()
    !module.description = !modules[!i].Description()
    !module.dText = !modules[!i].DText()
    !module.restore = !modules[!i].IsRestorable()
    !module.gui = true
    !module.restricted = false
    !module.dbRw = true
    !module.level = 'MAIN'

    if !module.name eq 'MONITOR' then
      -- Monitor
      !module.dbRw        = false
      !module.directory   = 'MON'

    elseif !module.name eq 'DESIGN' then
      -- Design
      !module.directory   = 'DES'

    elseif !module.name eq 'HULLDESIGN' then
      -- Hull Design
      !module.directory   = 'HDES'

    elseif !module.name eq 'MARINEDRAFTING' then
      -- Marine Drafting
      !module.directory   = 'MDRA'

    elseif !module.name eq 'OUTFITTING' then
      -- Outfitting
      !module.directory   = 'DES'

    elseif !module.name eq 'OUTFITTINGDRAFT' then
      -- Outfitting Draft
      !module.directory   = 'DRA'

    elseif !module.name eq 'DIAGRAMS' then
      -- Diagrams
      !module.directory   = 'DIAGRAMS'

    elseif !module.name eq 'SCHEMATICMODELMANAGER' then
      -- Schematic Model Manager
      !module.directory   = 'SMM'

    elseif !module.name eq 'TAGS' then
      -- Tags
      !module.directory   = 'TAGS'

    elseif !module.name eq 'SPOOLER' then
      -- Spooler
      !module.directory   = 'SPL'

    elseif !module.name eq 'DRAFT' then
      -- Draft
      !module.directory   = 'DRA'

    elseif !module.name eq 'ISODRAFT' then
      -- Isodraft
      !module.dbRw        = false
      !module.directory   = 'ISO'

    elseif !module.name eq 'PARAGON' then
      -- Paragon
      !module.directory   = 'CAT'

    elseif !module.name eq 'PROPCON' then
      -- Propcon
      !module.gui         = false
      !module.directory   = ''

    elseif !module.name eq 'SPECON' then
      -- Specon
      !module.gui         = false
      !module.directory   = ''

    elseif !module.name eq 'LEXICON' then
      -- Lexicon
      !module.restricted  = true
      !module.directory   = ''

    elseif !module.name eq 'ADMIN' then
      -- Admin
      !module.restricted  = true
      !module.directory   = 'ADM'

    endif

    !!moduleDataCache.append(!module)

  enddo

  return !!moduleDataCache.modules

endfunction
-- End of function definition for !!moduleData

