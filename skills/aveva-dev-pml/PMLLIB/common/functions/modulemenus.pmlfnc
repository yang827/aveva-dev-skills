-- Created:         Tue Feb 4 11:30:30 GMT 1997
--
--
-- Description:
-- Read colour definition file, and return names and numbers.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM       Colour File
--
------------------------------------------------------------------------

-- Define function
define function !!moduleMenus(!formObj is FORM)

  !sessionData = CURRENT SESSION
  !access      = !sessionData.user().access.upcase()

  !currentModule = !!getModuleData(!sessionData.module())

  if (defined(!formObj.modules)) then
    -- set flag to clear all module menus before creation
    !clearMenu = true
    !clearedMenus = ARRAY()
    !formObj.modules.clear()
    !modulesMenu = !formObj.modules
  else
    !clearMenu = false
    !modulesMenu = !formObj.newMenu('modules')
  endif

  -- get the moduleswitch.pmlfnc macro
  !moduleSwitch = '$m "%PMLLIB%/limbo/functions/moduleswitch.pmlfnc"'

  do !moduleDef values !!moduleData()

    skip if (!currentModule.name.upcase() eq !moduleDef.name.upcase())

    skip if (!moduleDef.restricted and !access ne 'FREE')

    skip if ( not !!moduleAccessible( !moduleDef ) )

    if (!moduleDef.level.upcase() eq 'MAIN') then
        !mainMenu = !modulesMenu

    else

      if (undefined(!formObj.$!<moduleDef.level>Module)) then
        !formObj.newMenu(!moduleDef.level + 'Module')

      elseif (!clearMenu) then
        !check = !clearedMenus.findFirst(!moduleDef.level)
        if (!check.unset()) then
          !formObj.$!<moduleDef.level>Module.clear()
          !clearedMenus.append(!moduleDef.level)
        endif
      endif

      !mainMenu = !formObj.$!<moduleDef.level>Module

    endif
    if (!moduleDef.command.upcase() eq 'SUBMENU') then
      !mainMenu.add('menu', !moduleDef.dText, !moduleDef.name + 'Module')

    elseif (!moduleDef.gui) then

      !sessionData    = CURRENT SESSION
      !userName       = !sessionData.user().name

        if (!moduleDef.restore) then
        !mainMenu.add('menu', !moduleDef.dText, !moduleDef.name + 'Module')

        if (undefined(!formObj.$!<moduleDef.name>Module)) then
          !subMenu = !formObj.newMenu(!moduleDef.name + 'Module')
        else
          !subMenu = !formObj.$!<moduleDef.name>Module
          !subMenu.clear()
        endif

        !project  = current project
        !projCode = !project.code().lowcase()
        !modKey=!!modKey(!moduleDef.name)
        var !mdb mdb
        !mdb = !mdb.after('/')
        !dispFileObj = object FILE('%PDMSUSER%/' + !modKey + '-' + !projCode + '-' + !mdb + '-gphviews.pmldat')
        !subMenu.add('callback', 'Restore Views', !moduleSwitch + ' ' + !moduleDef.command + ' ' + 'TRUE' + ' ' + 'TRUE')
        !subMenu.add('callback', 'Macro Files', !moduleSwitch + ' ' + !moduleDef.command + ' ' + 'FALSE' + ' ' + 'TRUE')
        if (!dispFileObj.exists().not()) then
           !subMenu.setActive('Restore Views',false)
        endif
      else
        !mainMenu.add('callback', !moduleDef.dText + '...', !moduleSwitch + ' ' + !moduleDef.command + ' ' + 'FALSE' + ' ' + 'TRUE')

      endif

    else
      !mainMenu.add('callback', !moduleDef.dText, !moduleSwitch + ' ' + !moduleDef.command + ' $<$> ' + 'TRUE')

    endif

  enddo

endfunction
-- End of function definition for !!moduleMenus
