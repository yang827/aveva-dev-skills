-- Created:         Fri Apr 11 10:44:05 WAT 1997
--
--
-- Description:
-- Checks the data within passed gadget is a valid old/new name.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     GADGET      Gadget name is to be checked in
--    2   R      STRING      New/Old file
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!nameGadget (!gadget is GADGET, !nameType is STRING)

  -- Handle "unset" names
  if(!gadget.val eq 'unset') then
    return
  endif

  -- Get the name
  !name       = !!checkName(!gadget.val, !nameType)

  -- if we have failed the check name, then we will include "unset"
  if(!name.unset()) then
    !gadget.val = 'unset'
    !gadget.setFocus()
  else
    !gadget.val = !name
  endif

endfunction
-- End of function definition for !!nameGadget
