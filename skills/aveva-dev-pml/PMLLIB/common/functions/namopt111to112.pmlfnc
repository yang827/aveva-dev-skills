-- File:            namopt111to112.pmlfnc
--   Type:          Function Definition
--   Group:         Naming
--     Keyword:     NAME
--   Module:        common
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Wed Apr 9 12:20:50 BST 1997
--
--
-- Description:
-- Function to upgrade old format autoname file to the new format
--
------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [1] [R] [STRING] [old format autoname data file]
--
------------------------------------------------------------------------

-- Define function
define function !!namOpt111To112(!oldFile is FILE)

  -- readfile into an array
  !fileData = !oldFile.readFile()

  -- get index of # Keys
  !kInd = !fileData.findFirst('# Keys')
  -- get index of # Descriptions
  !dInd = !fileData.findFirst('# Descriptions')
  -- get index of # gtypes
  !gInd = !fileData.findFirst('# Gtypes')
  -- get index of # Scan Levels
  !sInd = !fileData.findFirst('# Scan Levels')
  -- get index of # Rules
  !rInd = !fileData.findFirst('# Rules')
  -- get index of # Format
  !find = !fileData.findFirst('# Format')
  -- get index of # Indices
  !iInd = !fileData.findFirst('# Indices')

  if (!kInd.unset() or !dInd.unset() or !gInd.unset() or !sInd.unset() or !rInd.unset() or !find.unset() or !iInd.unset()) then
    !!messageFile.error(146, 033, !oldFile.fullName())

  else
    -- get number of autoname rules
    !nRules = !dInd - !kInd - 1

    do !i from 1 to !nRules
      -- for each naming rule create a standard rule
      !ruleName  = !fileData[!kInd + !i].part(2,'\')
      !ruleTypes = !fileData[!gInd + !i].part(2,'\')
      !ruleRule  = !fileData[!rInd + !i].part(2,'\')
      !rule = object RULE()
      !rule.rule(!ruleName, !ruleRule, !ruleTypes, '')
      -- set the rule location
      !rule.location('USER')
      -- include the rule in the list of defined rules
      !!ruleStore.element.include(!rule)

      -- create a naming rule object
      !nameKey  = !fileData[!kInd + !i].part(2,'\')
      !nameDesc = !fileData[!dInd + !i].part(2,'\')
      !nameRule = !fileData[!kInd + !i].part(2,'\')
      !nameScan = !fileData[!sInd + !i].part(2,'\')
      !nameFmt  = !fileData[!find + !i].part(2,'\')
      !nameInd  = !fileData[!iInd + !i].part(2,'\')
      !name = object NAMOPTRULE()
      !name.namOptRule(!nameKey, !nameDesc, !nameRule, !nameScan, !nameFmt, !nameInd)
      -- include the naming rule in the list of defined naming rules local to the edit form
      !!namOptEdit.data.rules.append(!name)

    enddo

    -- save the standard rules
    !!ruleStore.element.save()

  endif

endfunction
-- End of function definition for !!namOpt111To112
