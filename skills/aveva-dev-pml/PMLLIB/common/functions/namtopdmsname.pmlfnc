-- Author:          A.Kirkland
-- Created:         Thu Nov 12 9:02:11 GMT 1998
--
--
-- Description:
-- function to get whatever string is passed into a PDMS name.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!namToPdmsName(!name is STRING) is STRING

  -- Initialise Variables

  !newName = STRING()

  -- do nothing if the value is unset

  if(!name.unset() or !name.upcase().eq('UNSET')) then
    !newName = !name
    return !newName
  endif


  -- check if the slash is already on the name
  if(!name.subString(1,1).eq('/')) then
    !newName = !name
    return !newName
  else
    !newName = '/' & !name
  endif


  return !newName


endfunction
-- End of function definition for !!namToPdmsName
