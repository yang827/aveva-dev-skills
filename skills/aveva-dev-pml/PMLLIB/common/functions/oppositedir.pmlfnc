--
-- Description:
-- return the opposite direction to the one supplied
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!oppositeDir(!dir is DIRECTION) is DIRECTION

  !returnDir        = object DIRECTION()

  !returnDir.origin = !dir.origin
  !returnDir.east   = !dir.east  * -1
  !returnDir.north  = !dir.north * -1
  !returnDir.up     = !dir.up    * -1

  return !returnDir

endfunction
-- End of function definition for !!oppositeDir
