--
--
-- Description:
-- Orientation of element
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to orientate
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!oriElement(!element is DBREF)

  -- Initialise Variables
  -- Check orientation has been loaded
  if(undefined(!!oriElement)) then
    pml reload form !!oriElement
  endif

  -- Setup form
  !!oriElement.setup(!element)

endfunction
-- End of function definition for !!oriElement
