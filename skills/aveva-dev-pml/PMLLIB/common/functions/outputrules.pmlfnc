--
--
-- Description:
-- Display rules from the datalRules function.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!outPutRules(!dbRef is DBREF, !file is STRING)

  -- Initialise Variables

     !dataToDisplay = ARRAY()

  -- open output file for rules

     !token = object FILE()
     !token.file(!file)

  -- get data to display

   !dataToDisplay = !!datalRules(!dbRef,'')

  -- No rules to display

     if(!dataToDisplay.unset()) then
        !dataToDisplay[1] = 'No Rules Defined'
     endif

  -- Display to the output file

  !token.writeFile('WRITE',!dataToDisplay)

  -- close file output

  !token.close()

endfunction
-- End of function definition for !!outPutRules
