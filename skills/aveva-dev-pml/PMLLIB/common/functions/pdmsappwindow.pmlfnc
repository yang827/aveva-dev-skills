--
-- Description:
-- Set up main PDMS window
--
------------------------------------------------------------------------
define function !!pdmsAppWindow()

  if (undefined(!!pdmsMain)) then

    !modData  = !!module()
    !module   = !modData.appName.upcase()

    -- Design window
    if(!module eq 'DESIGN') then
      setup appwin title 'PDMS' size 0.8 1 at xr0.2 yr0
    else
      setup appwin title 'PDMS' size 1 1 at xr0 yr0
    endif
    pml load form !!pdmsMain

  endif

endfunction
-- End of function definition for !!pdmsAppWindow
