-- File:            pmldefinition.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Aug 10 14:00:46 BST 1998
--
--
-- Description:
-- Returns the directory and type of file (to the command/request window) of
-- the passed PML definition.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      PML definition file
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!pmlDefinition(!definition is STRING)

  -- Initialise Variables
  !suffixes[1]    = 'pmlfnc'
  !suffixes[2]    = 'pmlobj'
  !suffixes[3]    = 'pmlfrm'

  !description[1] = 'Function'
  !description[2] = 'Object'
  !description[3] = 'Form'

  !output         = ARRAY()

  -- Lowercase name
  !file = !definition.lowcase()

  !output.append('Definition for "' & !definition & '"')

  -- Loop through the basic definition types
  do !i indices !suffixes
    !filename = !file & '.' & !suffixes[!i]
    !pathname = !!pml.getPathName(!filename)
    handle any
      skip
    endhandle

    !pathname = !pathname.replace('/','\').replace('\\','\')
    -- Compose
    var !dprt COMPOSE SPACE 2 '$!description[$!i] in' WIDTH 12 R SPACE 1 '$!pathname'

    -- Output information
    !output.append(!dprt[1])

  enddo

  -- Display all data
  if(!output.size() eq 1) then
    !output.append('  No definition file found')
  endif

  do !i indices !output
    write '$!output[$!i]'
  enddo

endfunction
-- End of function definition for !!pmlDefinition
