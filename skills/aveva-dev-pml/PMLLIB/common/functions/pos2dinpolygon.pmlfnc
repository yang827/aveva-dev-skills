-- Author:          N.Holmes
-- Created:         Mon Mar 10 14:22:00 WAT 1997
--
--
-- Description:
-- Returns true if the passed 2D position lies within the
-- polygon definition. Polygon is passed as an array of
-- 2D co-ordinates.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position to be check against polygon (only XY used)
--    2   R      ARRAY       Array of position object defining the polygon,
--                           only XY co-ordinates are used.
--    3  RW      REAL        Nearest edge point is to, assume edges for from
--                           x1,x2 - x2,y2 - ........xn-1,yn-1 - xn,yn.
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if Point position lies within the polygon.
--
------------------------------------------------------------------------

-- Define function
define function !!pos2DInPolygon (!point is POSITION, !polygon is ARRAY, !edgeNumber is REAL) is BOOLEAN

  -- Initialise Variables
  !tan    = ARRAY()
  !tang   = 0
  !xPos   = !point.east
  !yPos   = !point.north
  !x      = ARRAY()
  !y      = ARRAY()

  -- Load All X positions into Array
  !block  = object BLOCK('!polygon[!evalIndex].east')
  !xArray = !polygon.evaluate(!block)
  !block  = object BLOCK('!polygon[!evalIndex].north')
  !yArray = !polygon.evaluate(!block)

  -- Calculate all offsets from datum point
  do !xVal values !xArray
    !x.append(!xVal - !xPos)
  enddo

  do !yVal values !yArray
    !y.append(!yVal - !yPos)
  enddo

  -- Get angles of all points
  -- Formula
  --          (x1 * y2) - (x2 * y1)
  -- tan(a) = ---------------------
  --          (x1 * x2) + (y1 * y2)

  -- Loop through all vertices
  do !a from 1 to (!x.size() - 1)
    !b        = !a + 1
    !top      = (!x[!a] * !y[!b]) - (!x[!b] * !y[!a])
    !bottom   = (!x[!a] * !x[!b]) + (!y[!a] * !y[!b])

    !tan[!a]  = ABS(ATANT(!top , !bottom))
    handle (2,780)
      !tang   = 360
      golabel /END
    endhandle
    if(!tan[!a] eq 180) then
      !tang   = 360
      golabel /END
    endif
    !tang = !tang + !tan[!a]

  enddo

  -- Last Edge (from first to last point creating a closed loop)
  !top        = (!x[!x.size()] * !y[1]) - (!x[1] * !y[!x.size()])
  !bottom     = (!x[!x.size()] * !x[1]) + (!y[!x.size()] * !y[1])

  !tan[!x.size()]  = ABS(ATANT(!top , !bottom))
  handle (2,780)
    !tang     = 360
    golabel /END
  endhandle

  if(!tan[!a] eq 180) then
    !tang     = 360
    golabel /END
  endif

  !tang     = !tang + !tan[!x.size()]

  -- End
  label /END

  -- Make all angles an abs value
  if(!tan.set()) then
    !block  = object BLOCK('!tan[!evalIndex].abs().string()')
    !eval   = !tan.evaluate(!block)

    -- Get biggest angle, and use it as the edge number
--    !sorted = !eval.sortedIndices()
--    !eval.invert()
    var !sorted SORT !eval NUMERIC DESCENDING

    !edgeNumber = !sorted[1].real()
  endif

  -- If angle is near 360 degrees then its inside the polygon
  return (abs(!tang) eq 360)

endfunction
-- End of function definition for !!pos2DInPolygon
