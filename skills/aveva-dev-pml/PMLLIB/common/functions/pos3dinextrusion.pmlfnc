--
--
-- Description:
-- Function to check if the passed point lies within the
-- "Straight Edge" boundary of a extrusion/panel.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Position to be check
--    2   R      DBREF       Extrusion/Panel position to be checked against
--    3   R      REAL        Nearest edge point
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if position lies within the extrusion/panel
--
------------------------------------------------------------------------

-- Define function
define function !!pos3DInExtrusion (!pPosition is POSITION, !extrusion is DBREF, !edgeNumber is REAL) is BOOLEAN

  -- Initialise Variables
  -- Transpose passed position into the same frame of reference and the extrusions
  !position = !pPosition.wrt(!extrusion)

  -- Get Loop 1 of Panel (until we get .members of a dbref, we'll use this)
  !members = !!collectMembersOf(!extrusion,'')
  !block   = object BLOCK('!members[!evalIndex].type')
  !types   = !members.evaluate(!block)

  -- Test for a Loop
  !first   = !types.findFirst('LOOP')

  -- If we can't find a loop look for a Ploop
  if(!first.unset()) then
    !first   = !types.findFirst('PLOO')

    -- If we can't find any, return false and an error
    if(!first.unset()) then
      !!alert.error('This is no boundary definition beneath the extrusion (' & !extrusion.name & ').')
      return false
    endif

  endif

  !loop = !members[!first]

  -- Get all Positions for Panel
  !vertices = !!collectAllFor('VERT PAVE','',!loop)

  -- Get all the positions for the Vertices
  !block     = object BLOCK('!vertices[!evalIndex].position')
  !positions = !vertices.evaluate(!block)


  -- Determine if position lies within the extrusion
  return !!pos2DInPolygon(!position, !positions, !edgeNumber)

endfunction
-- End of function definition for !!pos3DInExtrusion
