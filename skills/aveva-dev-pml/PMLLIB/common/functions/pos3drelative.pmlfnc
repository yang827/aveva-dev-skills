-- Define function
define function !!pos3DRelative()

  -- Test if positioning form has been loaded
  if(undefined(!!pos3DRelative)) then
    pml load form !!pos3DRelative
  endif

  !!pos3DRelative.edit(!!ce)

endfunction
-- End of function definition for !!pos3DRelative
