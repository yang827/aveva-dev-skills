------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Pipe piece
--    2   R      DBREF       Proportion along pipe piece
-- Return:
--   [Data Type] [Description]
--    POSITION    Position of proportion along pipe piece
--
------------------------------------------------------------------------

define function !!positionAlongPipePiece(!pipePiece is DBREF, !proportion is REAL) is POSITION

  -- Check Type
  if(!pipePiece.type.neq('PPIECE')) then
    return object POSITION()
  endif

  -- Distance along pipe piece
  !length     = !pipePiece.pparef.mtcl
  !distance   = !length * !proportion

  !tlen       = 0

  -- Elements within pipe piece
  !elements   =!pipePiece.cmprfa

  !max        = !elements.size()
  if(!max.eq(0)) then
    return object POSITION()
  endif

  do !i from 1 to !max
    if(!elements[!i].type.eq('BEND')) then
      !alen   = !elements[!i].fitLength
      !tlen   = !tlen + !alen

      -- If Mid point is less than arc length, then use
      -- mid point of are
      if(!tlen.gt(!distance)) then
        !position = !elements[!i].position
        break
      endif

    endif
    !tlen     = !tlen + !pipePiece.pparef.ltlength
    if(!tlen.gt(!distance) or !i.eq(!max)) then
      !tube   = IL TUBE OF $!<elements[$!<i>]>
      handle ANY
        !position = !elements[!i].itposition
        handle ANY
          return object POSITION()
        endhandle
      elsehandle NONE
        !position = !tube.itposition
      endhandle
      break
    endif
  enddo

  -- Return Position
  return !position

endfunction
-- End of function definition
