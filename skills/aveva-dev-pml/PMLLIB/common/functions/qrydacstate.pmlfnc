--
--
-- Description:
-- Function to query the State of DAC, ie:- ON or OFF
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!qryDacState() is BOOLEAN

  !prev = !!ce
  -- Change to System Db World
  -- ## Is there an easier way!
  !globalProject = !!glbIsGlobal()

  !temp = SESSIONS
  !dbRef = !temp.last().user().refNo.dbRef()
  !user = !dbRef
  !!ce = !user
--  !!ce = /*ACR
  if (!globalProject) then
    var !active LACR of /*GRO
  else
    var !active LACR of /*RO
  endif
  !answer = !active.boolean()
  !!ce = !prev
  return !answer
endfunction
-- End of function definition for !!qryDacState
