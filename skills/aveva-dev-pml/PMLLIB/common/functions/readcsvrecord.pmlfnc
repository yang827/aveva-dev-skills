--
-- Author:          M.Lewis
-- Created:         Tue Dec 16 16:47:44 GMT 1997
--
--
-- Description:
-- Read a string in comma separated value format into an array of strings
-- Strings may be delimited with double quotes in which case a pair of
-- double quotes indicates a literal double quote
-- Delimited strings may contain literal commas
--
-- Test data:
-- !data = !!readCsvRecord(|ab,cd,,ef,gh|)
-- !data = !!readCsvRecord(|"ab","cd","","ef","gh"|)
-- !data = !!readCsvRecord(|"got""quote","got,comma"|)
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [1] [R] [STRING] [Record in csv format]
-- Return:
--   [ARRAY] [Individual strings]
--
------------------------------------------------------------------------

-- Define function
define function !!readCsvRecord(!string is STRING) is ARRAY

  !buffer = !string

  -- These characters may become options at a later date
  !delimiter = |"|
  !separator = |,|

  !values = ARRAY()
  !delimited = FALSE
  !inString = FALSE
  !nullString = ||
  !first = 1
  !scanFrom = 1
  !second = 0

  -- Find next comma separated string
  do
    if (not !inString and !buffer.length() geq !first) then
      !inString = TRUE
      !delimited = FALSE
      if (Substr(!buffer,!first,1) eq !delimiter) then
        !delimited = TRUE
        !first = !first + 1
        !scanFrom = !first
      endif
    endif

    -- Scan ahead for next delimiter or comma
    !delimiterPos = Match(Substr(!buffer,!scanFrom),!delimiter)
    !separatorPos = Match(Substr(!buffer,!scanFrom),!separator)
    if (!delimiterPos eq 0 and !separatorPos eq 0) then
      !second = !buffer.length() + 1

    -- Delimiter may be literal
    elseif (!delimiterPos gt 0 and (!separatorPos gt !delimiterPos or !separatorPos eq 0)) then
      !second = !scanFrom + !delimiterPos - 1
      if (!second lt !buffer.length()) then
        if (!delimited) then
          -- Collapse paired delimiter to literal and continue scan
          if (Substr(!buffer,!second + 1,1) eq !delimiter) then
            !buffer = Substr(!buffer,1,!second - 1) & Substr(!buffer,!second + 1)
            !scanFrom = !second + 1
            skip
          -- Ignore single delimiter with no following separator
          elseif (Substr(!buffer,!second + 1,1) neq !separator) then
            !scanFrom = !second + 1
            skip
          endif
        else
          -- Delimiter is literal character in non-delimited string
          !scanFrom = !second + 1
          skip
        endif
      endif

    -- Separator inside delimited string is literal so continue scan
    elseif (!separatorPos gt 0) then
      !second = !scanFrom + !separatorPos - 1
      if (!delimited) then
        if (!second lt !buffer.length()) then
          !scanFrom = !second + 1
          skip
        endif
      endif
    endif

    -- Add string into array
    if (!second gt !first) then
      !values.append(Substr(!buffer,!first,!second - !first))
    else
      !values.append(!nullString)
    endif

    -- Initialise for next scan
    if (!delimited) then
      !second = !second + 1
    endif
    !first = !second + 1
    !scanFrom = !first
    !inString = FALSE
    break if (!second gt !buffer.length())
  enddo

  return !values

endfunction
-- End of function definition for !!readCsvRecord
