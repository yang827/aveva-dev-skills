--
--
-- Description:
-- Function to update values in forms that are dependent on global settings.
-- If the form is displayed, then the form is updated using the form
-- callback value (if set).
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form requiring refresh operation.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!refreshDependent(!formName is FORM)

  -- Check display state of form
  if (!formName.shown()) then

    -- Form is shown, use callback if set
    if (!formName.callback.set()) then

      -- check for !this used in callback - replace by form name
      !command = !formName.callback.trim().replace('!this.', !formName.fullname() + '.')

      !status = !!command(!command)
      if (!status) then
        return
      else
        !message = 'Update failed for form: ' + !formName.formTitle + '. Dismiss this form and redisplay it to reinitialise the form.'
        return error 1 '$!message'
      endif

    endif

  endif

endfunction
-- End of function definition for !!refreshDependent
