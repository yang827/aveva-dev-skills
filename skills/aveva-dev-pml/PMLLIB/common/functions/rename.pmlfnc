--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!rename()

  -- Hull design elements should not be possible to delete from the explorer
  if (!!ismarineCe()) then
    !!alert.message('Renaming Hull model elements is not allowed')
    return
  endif

  if (undefined(!!cdName)) then
    !!runSynonym('CALLG FNAME')
  endif
  if (!!cdName.shown()) then
    !!runSynonym('CALLG INAME FNAME')
  else
    show !!cdName
  endif

endfunction
-- End of function definition for !!rename()
