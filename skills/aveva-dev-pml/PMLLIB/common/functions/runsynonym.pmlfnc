--
--
-- Description:
-- Passes arguments to runSynonym macro and executes it.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!runSynonym(!action is STRING)

  -- Get macro name
  !macro = !!pml.getPathName('runsynonym.pmlmac')
  $m "$!<macro>" $<$!<action>$>

endfunction
-- End of function definition for !!runSynonym
