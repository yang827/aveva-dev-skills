--
--
-- Description:
-- Search messages for given string.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!searchMsg()

  -- Initialise Variables
  !searchString = !!searchMsg.string.val.trim()
  !!searchMsg.messages.clear()

  -- If there is no search string, don't do anything
  if(!searchString.empty()) then
    return
  endif

  -- Display Messages
  !dText = ARRAY()

  -- Loop through each message list
  do !i indices !!messageList.messages

    -- Collect All Messages for Application/Utility
    !block    = object BLOCK('!!messageList.messages[!i].message[!evalIndex].description')
    !messages = !!messageList.messages[!i].message.evaluate(!block)

    -- Skip if there are no messages
    skip if(!messages.unset())

    -- Replace wildcards
    !block    = object BLOCK('!messages[!evalIndex].replace(|*|,|<star>|)')
    !msgModA  = !messages.evaluate(!block)
    !block    = object BLOCK('!msgModA[!evalIndex].replace(|?|,|<QMark>|)')
    !msgMod   = !msgModA.evaluate(!block)

    -- Loop through each message and see if the string exists in it
    do !j indices !messages

      if(!!searchMsg.case.val) then
        !msgFound = MATCHWILD(!msgMod[!j].upcase(),!searchString.upcase())
      else
        !msgFound = MATCHWILD(!msgMod[!j],!searchString)
      endif

      skip if(!msgFound.not())
      !msgNumber = substring('     ' & !i & substring('000' & !j,-1,-3),-1,-6)

      !dText.append(!msgNumber & ' - ' & !messages[!j])
    enddo

  enddo

  -- If there are any messages found, display them
  if(!dText.set()) then
    !!searchMsg.messages.dText = !dText
  endif

endfunction
-- End of function definition for !!searchMsg
