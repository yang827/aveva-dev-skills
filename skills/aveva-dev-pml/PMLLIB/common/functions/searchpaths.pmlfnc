--
--
-- Description:
-- Returns an array of all the search paths for a passed file. This
-- function will check for existence of the file and only return the
-- paths which contain the file.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Filename to be applied to all search paths
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of all DEFAULTFILE objects.
--
------------------------------------------------------------------------

-- Define function
define function !!searchPaths (!rootFile is STRING) is ARRAY

  -- Initialise Variables
  !returnArray = ARRAY()
  !file = object FILE()

  -- AVEVA File
--   !findFile = !!pml.getPathName(!rootFile)
--   handle none
--     !file.file(!findFile)
--     !defaultFile             = object DEFAULTFILE()
--     !defaultFile.file        = !file
--     !defaultFile.fullName    = !file.fullName()
--     !defaultFile.description = 'AVEVA Defaults'
--     !defaultFile.defaultType = 'CADC'
--     !defaultFile.evar        = !file.pathName()
--     !returnArray.append(!defaultFile)
--   elsehandle (44,33)
--     -- file not found, nothing to do
--   endhandle

  -- PDMS's default area
  var !evar EVAR PDMSDFLTS
  if(!evar.trim().empty().not()) then
    !file.file('%PDMSDFLTS%/' & !rootFile)
    if(!file.exists()) then
      !defaultFile             = object DEFAULTFILE()
      !defaultFile.file        = !file
      !defaultFile.fullName    = !file.fullName()
      !defaultFile.description = 'PDMS Defaults'
      !defaultFile.defaultType = 'PDMS'
      !defaultFile.evar        = '%PDMSDFLTS%'
      !returnArray.append(!defaultFile)
    endif
  endif

  -- Find project's default area
  !project = CURRENT PROJECT
  !projectCode = !project.code()

  !projectEVar   = !projectCode & 'DFLTS'
  var !evar EVAR $!<projectEVar>
  if(!evar.trim().empty().not()) then
    !file.file('%' & !projectCode & 'DFLTS%/' & !rootFile)
    if(!file.exists()) then
      !defaultFile             = object DEFAULTFILE()
      !defaultFile.file        = !file
      !defaultFile.fullName    = !file.fullName()
      !defaultFile.description = 'Project Defaults'
      !defaultFile.defaultType = 'PROJ'
      !defaultFile.evar        = '%' & !projectCode & 'DFLTS%'
      !returnArray.append(!defaultFile)
    endif
  endif

  -- User's default area
  var !evar EVAR PDMSUSER
  if(!evar.trim().empty().not()) then
    !file.file('%PDMSUSER%/' & !rootFile)
    if(!file.exists()) then
      !defaultFile             = object DEFAULTFILE()
      !defaultFile.file        = !file
      !defaultFile.fullName    = !file.fullName()
      !defaultFile.description = 'User Defaults'
      !defaultFile.defaultType = 'USER'
      !defaultFile.evar        = '%PDMSUSER%'
      !returnArray.append(!defaultFile)
    endif
  endif

  return !returnArray

endfunction
-- End of function definition for !!searchPaths
