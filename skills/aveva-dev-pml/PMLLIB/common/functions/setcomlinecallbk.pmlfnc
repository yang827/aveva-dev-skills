--
-- Description:
-- Set command line callback to the function for saving work.
-- function name commandLineSave()
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!setComLineCallbk(!setItOrNot is BOOLEAN)

-- set the callback of the command line to the function, so your work is saved.

   if(!setItOrNot eq true) then
      !!cadcBth.cadcCom.callback = '!!commandLineSave()'
      !!cadcBth.formTitle        = '***************SAVEWORK OPTION ENABLED***************'
   else
      !!cadcBth.cadcCom.callback = ''
      !!cadcBth.formTitle        = 'PDMS Design Command Input & Output'
   endif

endfunction
-- End of function definition for !!setComLineCallbk
