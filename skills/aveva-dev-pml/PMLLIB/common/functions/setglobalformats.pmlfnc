--
--
-- Description:
-- Create the global format variables and set sensible default values
-- These can be modified using the normal units settings form
-- Use these instead of relying on units settings.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!setGlobalFormats()

  -- global formats are created when the !!comFormats global object is created
  if( not defined(!!comFormats) ) then
    !!comDefineGlobal(object COMFORMATS())
  endif

endfunction
-- End of function definition for !!setGlobalFormats
