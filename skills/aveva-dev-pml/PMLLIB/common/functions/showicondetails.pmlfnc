--
--
-- Description:
-- Function to display the details of the icon picked
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!showIconDetails(!icon is STRING, !formIndex is REAL)

-- find the index
 !!showIcons$!formIndex$n.description.val = ''
 !!showIcons$!formIndex$n.size.val        = ''
 !!showIcons$!formIndex$n.iconName.val    = ''
 !iconName  = !icon.part(-1, '\').before('.png')
 !index     = !icon.part(-2, '\')
 !directory = !icon.before('\' & !index)
 !fileName  = !directory & '\INDEX\INDEX' & !index
 !file      = object FILE(!fileName)

if(!file.exists()) then
 !records   = !file.readFile()

  do !i values !records
    if(!i.match(!iconName).neq(0)) then
     !!showIcons$!formIndex$n.description.val = !i.part(3, '\')
     !!showIcons$!formIndex$n.size.val        = !i.part(2, '\')
     !!showIcons$!formIndex$n.iconName.val    = !i.part(1, '\')
     break
    else
     skip
    endif
  enddo

else
  !iSize = !iconName.substring(-1,-2)
  !unusedTest = !iSize.real()
  handle ANY
   !iSize = ''
  endhandle
  !!showIcons$!formIndex$n.description.val = 'No description file available for these icons'
  !!showIcons$!formIndex$n.size.val        = !iSize
  !!showIcons$!formIndex$n.iconName.val    = !iconName
endif
endfunction
-- End of function definition for !!showIconDetails()
