--     Keyword:     DISPLAY
--   Module:        ALL
--   Replaces:
--
-- Author:          andy.kirkland
-- Created:         Wed Mar 03    08:28:39  2004
--
--
-- Description:
-- Function to create a form to show icons
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [ANY]       [A single file name as a string, or an array of strings, or an array of files (a directory)]
--   [2] [R]    [REAL]      [Size of larges icon]
--   [2] [R]    [REAL]      [How many icons on a line]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!showIcons(!icon is ANY, !space is REAL, !howWide is REAL)

-- initialise variables
!iconFile    = ARRAY()

-- if file is passed as a string
if(!icon.objectType().eq('STRING')) then
  !iconFile[1] = !!pml.getPathName(!icon)
  handle ANY
    !iconFile[1] = ''
  elsehandle NONE
    !iconFile[1] = !iconFile[1].replace('/','\')
  endhandle
else
-- if an array of file objects is passed, ie. from a directory
do !i values !icon
   !iconFile.append(!i.fullName())
   handle ANY
    -- in case passed as a string and not a file object
    !iconFile.append(!!pml.getPathName(!i).replace('/','\'))
    handle ANY
      -- for any reason
    endhandle
   endhandle
enddo
endif

-- Having got the list of icons display them in a form. Find out the form index.

  if(defined(!!iconFormIndex)) then
    !iconIndex = !!iconFormIndex
  else
    !!iconFormIndex = 1
    !iconIndex      = 1
  endif

-- Define form
setup form !!showIcons$!iconIndex
-- form setup
   !this.formTitle       = 'Icon Display'
   !this.iconTitle       = 'ICONS'
   !this.formRevision    = ' $Revision: 1.1 $ '
   !pos                  = 'xmax ymin'

   do !i indices !iconFile
    button .icon$!i at  $!pos  pix    width $!space height $!space
    member .icon$!i$ntooltip is STRING
   -- populate button
      !this.icon$!i$n.addpixmap(!iconFile[!i])
      !this.icon$!i$n.callback = '!!showIconDetails(|$!iconFile[$!i]|, $!iconIndex)'
      !this.icon$!i$n.setToolTip(!iconFile[!i])
      !this.icon$!i$ntooltip   = !iconFile[!i]

-- calculate when to put icon on the next line

      !calculation     = !i / $!howWide
      !int             = !calculation.int()
      !test            = !calculation.eq(!int)
      if(!test) then
        !pos = 'xmin_icon1 ymax'
      else
        !pos = 'xmax ymin'
      endif

   enddo
   !width = !howWide * 2
   text .iconName    'Name       ' at x0   ymax+0.5  width 12      STRING
   text .size        'Size'        at xmax ymin      width 9       STRING
   text .description 'Description' at x0   ymax      width $!width STRING

exit
-- End of form definition for !!showIcons

show !!showIcons$!iconIndex

!!iconFormIndex = !!iconFormIndex + 1

endfunction
-- End of function definition for !!showIcons()
