--
-- Author:          N.Holmes
-- Created:         Mon Jun 30 13:09:34 WAT 1997
--
--
-- Description:
-- Add the links to the passed SPECLINK object for a link
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     SPECDATA    Link member of form
--    2   R      STRING      Link type (must tie up with object)
--    3   R      GADGET      Gadget link is to be linked with
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!specAddLink (!specData is SPECDATA, !type is STRING, !gadget is GADGET)

  -- Initialise Variables
  !member = !specData.specLink.specData

  -- Specification gadget (OPTION)
  if(!type eq 'SPECS') then

    -- Check gadget type
    if(!gadget.type() ne 'LIST') then
      !!messageFile.error(146, 024, '1', 'LIST')
      return
    endif

    -- Set link
    !specData.specLink.specifications = !gadget

    -- Set callback to gadget
    !gadget.callback = 'call !!specSelect(!!' & !gadget.owner() & '.' &  !member & ',|SPEC|)'

  -- SELECTED gadget (LIST)
  elseif (!type eq 'SELECTED') then

    -- Check gadget type
    if(!gadget.type() ne 'LIST') then
      !!messageFile.error(146, 024, '1', 'LIST')
      return
    endif

    -- Set link
    !specData.specLink.selected = !gadget

  -- PERMISSIBLE gadget (LIST)
  elseif (!type eq 'PERMISSIBLE') then

    -- Check gadget type
    if(!gadget.type() ne 'LIST') then
      !!messageFile.error(146, 024, '1', 'LIST')
      return
    endif

    -- Set link
    !specData.specLink.permissible = !gadget

  -- QUESTION gadget (PARAGRAPH)
  elseif (!type eq 'QUESTION') then

    -- Check gadget type
    if(!gadget.type() ne 'PARAGRAPH') then
      !!messageFile.error(146, 024, '1', 'PARAGRAPH')
      return
    endif

    -- Set link
    !specData.specLink.question = !gadget

  -- Default gadget (TOGGLE)
  elseif (!type eq 'DEFAULT') then

    -- Check gadget type
    if(!gadget.type() ne 'TOGGLE') then
      !!messageFile.error(146, 024, '1', 'TOGGLE')
      return
    endif

    -- Set link
    !specData.specLink.default = !gadget

    -- Set callback to toggle gadget
    !gadget.callback = 'call !!specDefault(!!' & !gadget.owner() & '.' &  !member & ')'

  -- SPECCOMP gadget (TEXT)
  elseif (!type eq 'SPECCOMP') then

    -- Check gadget type
    if(!gadget.type() ne 'TEXT') then
      !!messageFile.error(146, 024, '1', 'TEXT')
      return
    endif

    -- Set link
    !specData.specLink.specComp = !gadget

    -- Set callback to gadget
    !gadget.callback = 'call !!specSelect(!!' & !gadget.owner() & '.' &  !member & ',|COMP|)'

  endif

endfunction
-- End of function definition for !!specAddLink
