--
--
-- Description:
-- Align relevant attributes within a specification.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!specAlign()

  -- Initialise Variables
  !refNo = !!ce

  -- Set Specification Name
  !spec = SPEC
  handle any
    !!messageFile.error(153, 003, 'from current element')
    return
  endhandle

  -- Collect all member within the SPEC
  !members = !!collectAllFor('SPCO SELE','',!spec)

  -- Collect all Answer > 0 and TAnswer = 0
  !block   = object BLOCK('!members[!evalIndex].answer gt 0 and !members[!evalIndex].maxAnswer eq 0')
  !change  = !members.evaluate(!block)

  -- Loop through all and change the relevant ones
  do !i indices !members
    if(!change[!i]) then
      !!ce = !members[!i]
      MAXANSWER $!!ce.answer
    endif
  enddo

  -- Return to original
  !!ce = !refNo

endfunction
-- End of function definition for !!specAlign
