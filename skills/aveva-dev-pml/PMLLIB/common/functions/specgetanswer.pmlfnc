-- Author:          N.Holmes
-- Created:         Tue Jul 8 08:42:13 WAT 1997
--
--
-- Description:
-- Returns all possible items that conform to the "GetAnswer" data.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Item to get permissibles
--    2   R      DBREF       Reference item to check against
--    3   RW     DBREF       Default item
-- Return:
--   [Data Type] [Description]
--    ARRAY       List of permissible items
--
------------------------------------------------------------------------

-- Define function
define function !!specGetAnswer (!item is DBREF, !reference is DBREF, !defaultItem is DBREF) is ARRAY

  -- Initialise Variables

  -- Can we derive any lower selections automatically
  -- Collect members of selection and try and determine which to use
  !members  = !!collectMembersOf(!item,'TYPE neq |TEXT|')
  if(!members.unset()) then
    return ARRAY()
  endif
   !getAnswer = !item.tQuestion
   if (!getAnswer.unset() or !getAnswer.trim().length() lt 4 ) then
        !getAnswer = !item.attribute(':AKGetAnswer')
        handle any
             !getAnswer = !item.question
        endhandle
   endif

  -- Get Answer Function/Attribute
  if(!getAnswer.empty().not() and !reference.set()) then

    -- Are we looking for an attribute or functions
    -- A function (this must be self contained)
    if(!getAnswer.subString(1,2) eq '!!') then

      -- execute function

    -- Assume an attribute
    else

      if(defined(!result)) then
        !result.delete()
      endif

      -- Check we have some members.

      -- Special Cases first
      if (!getAnswer eq 'TYPE' or !getAnswer eq 'OTYP') then
           !result = !reference.owner.gType
           handle any
           elsehandle none
                !string = !result
           endhandle
      elseif (!getAnswer eq 'ATYP') then
           !result = !reference.cref.gType
           handle any
           elsehandle none
                !string = !result
           endhandle
      else
      -- Get the Answer
          !result = !reference.attribute(!getAnswer)
          handle any
          elsehandle none

      -- What type of answer are we looking for
      -- Reals Answer & Maxanswer
                if(!result.objectType() eq 'REAL') then
                     !real  = !result

      -- Any other must be converted into a string
                elseif(!result.objectType() eq 'STRING') then
                     !string = !result.string()
                else
                     !string = !result
                endif
           endhandle
      endif
    endif
  else
-- No reference but current element
       if (!getAnswer eq 'TYPE' or !getAnswer eq 'OTYP') then
            !result = !!ce.gType
            handle any
            elsehandle none
                 !string = !result
            endhandle
       endif
  endif

  -- Get default answer

  -- If either String or Real are set, we'll get the relevant default
  if(defined(!result)) then

    if(defined(!real) and !item.default ne 0) then
      !realDefault   = !item.default
    elseif (defined(!string) and !item.tDefault.empty().not()) then
      !stringDefault = !item.tDefault
    endif

  -- Neither Real or String set, try and determine the default
  else
    if(!item.tDefault.empty().not()) then
      !stringDefault = !item.tDefault
    elseif (!item.default ne 0) then
      !realDefault   = !item.default
    endif
  endif

  -- Initialise items for suitable selections
  !possible = ARRAY()

  -- Loop through each member and check its suitability
  do !j indices !members

    -- Check for answer and maxanswer
    if(defined(!real)) then

      -- Does answer lie between the range
      if(!real ge !members[!j].answer and !real le !members[!j].maxAnswer) then
        !possible.append(!members[!j])
      endif

    -- Check for text answer
    elseif (defined(!string)) then
      if(!string eq !members[!j].tAnswer) then
        !possible.append(!members[!j])
      endif

    endif

    -- Don't bother getting subsequent items that conform to the default
    skip if(!defaultItem.set())

    -- Check if item conforms to the real default
    if(defined(!realDefault)) then
      if(!realDefault ge !members[!j].answer and !realDefault le !members[!j].maxAnswer) then
        !defaultItem = !members[!j]
      endif

    -- Check if item conforms to the string default
    elseif (defined(!stringDefault)) then
      if(!stringDefault eq !members[!j].tAnswer) then
        !defaultItem = !members[!j]
      endif
    endif

  enddo

  return !possible

endfunction
-- End of function definition for !!specGetAnswer
