--   Group:         Specification handling utilities
--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jun 30 11:11:52 WAT 1997
--
--
-- Description:
-- Links the passed form gadgets to the spec utilities.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      SPECDATA    Link member of form
--    2   R      STRING      Form member containing the SPECDATA (this is
--                           because it is not possible to extract a member/
--                           variable name from the passed variable)
--    3   R      GADGET      List gadget containing currently selections
--    4   R      GADGET      List gadget containing permissible for current
--                           selection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!specLinks (!specData is SPECDATA, !member is STRING, !selected is GADGET, !permissible is GADGET)

  -- "Selected" link
  if(!selected.type() ne 'LIST') then
    !!messageFile.error(146, 024, '1', 'LIST')
    return

  -- Set the "selected" link
  else

    !specData.specLink.selected    = !selected
    !selected.callback             = 'call !!specSelect(!!' & !selected.owner() & '.' &  !member & ', |RESELECT|)'

  endif

  -- "Permissible" link
  if(!permissible.type() ne 'LIST') then
    !!messageFile.error(146, 024, '2', 'LIST')
    return

  -- Set the "permissible" line
  else
    !specData.specLink.permissible = !permissible
    !permissible.callback          = 'call !!specSelect(!!' & !permissible.owner() & '.' &  !member & ', |SELECT|)'
  endif

  -- Set SpecData member name
  !specData.specLink.specData = !member

  -- Initialise All other variables to their default values
  !specData.autoSelection     = false
  !specData.standardSpec      = true
  !specData.partSelection     = false
  !specData.defaultSelection  = false
  !specData.action            = ''
  !specData.actionState       = false

endfunction
-- End of function definition for !!specLinks
