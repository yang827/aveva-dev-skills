-- File:            specload.pmlfnc
--   Type:          Function Definition
--   Group:         Specification handling utilities
--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Mon Jun 30 11:12:24 WAT 1997
--
--
-- Description:
-- Loads the spec form gadgets with the relevant specification data.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     SPECDATA    Spec data object contain all spec data
--    2   R      STRING      Option:
--                          SPEC        - <dbref>   add spec name to data
--                          REF         - <dbref>   Reference/Mod item
--                          SPCO        - <dbref>   specification component
--                          STANDARD    - <boolean> Standard spec type
--                          PART        - <boolean> Part selection allowed
--                          DEFAULT     - <boolean> Use default selection
--                          AUTO        - <boolean> Use ITEM as ref or selection
--                          ACTION      - <string>  Function/Action carried
--                                                  out on selection
--                          ACTIONSTATE - <boolean> action on each selection
--    3   R      ANY         Data to be added
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!specLoad (!specData is SPECDATA, !option is STRING, !data is ANY)

  -- Initialise Variables

  -- Set Specification/Spec selection
  if(!option eq 'SPEC') then
    if(!data.objectType() eq 'DBREF') then

      -- None null dbref
      if(!data.set()) then

        -- Check a Spec has been passed
        if(!data.type ne 'SPEC') then
          !!messageFile.error(153, 007, !data.flnn )
        endif
      endif

      -- Set spec name
      !specData.specName         = !data
      !specData.currentSelection = object DBREF()
    endif

  -- Set Modification/Reference Item
  elseif(!option eq 'REF') then
    if(!data.objectType() eq 'DBREF') then

      -- None null dbref
      if(!data.set()) then

        -- Check item has a SPREF attribute
        !unusedSpref = !data.spref
        handle any
          !!messageFile.error(153, 015, !data.flnn )
        endhandle
      endif

      -- Set reference item
      !specData.reference = !data
    endif

  -- Set Specification Component
  elseif(!option eq 'SPCO') then
    if(!data.objectType() eq 'DBREF') then

      -- None null dbref
      if(!data.set()) then

        -- Check that Spec component has been passed
        if(!data.type ne 'SPCO' and !data.type ne 'SPEC') then
          !!messageFile.error(153, 016, !data.flnn )
        endif
        -- Set SpecName to SPEC of SPCO
        !specData.specName       = SPEC of $!data
      endif

      -- Set current selection
      !specData.currentSelection = !data
    endif

  -- Set Standard spec type
  elseif(!option eq 'STANDARD') then
    if(!data.objectType() eq 'BOOLEAN') then
      !specData.standardSpec = !data
    endif

  -- Set Part selection allowed
  elseif(!option eq 'PART') then
    if(!data.objectType() eq 'BOOLEAN') then
      !specData.partSelection = !data
    endif

  -- Set Default used where applicable
  elseif(!option eq 'DEFAULT') then
    if(!data.objectType() eq 'BOOLEAN') then
      !specData.defaultSelection = !data
    endif

  -- Set Auto selection
  elseif(!option eq 'AUTO') then
    if(!data.objectType() eq 'BOOLEAN') then
      !specData.autoSelection = !data
    endif

  -- Set Action on selection
  elseif(!option eq 'ACTION') then
    if(!data.objectType() eq 'STRING') then
      !specData.action        = !data
    endif

  -- Set Action on selection
  elseif(!option eq 'ACTIONSTATE') then
    if(!data.objectType() eq 'BOOLEAN') then
      !specData.actionState   = !data
    endif

  -- Unknown Option
  else

    !!messageFile.error(146, 025, !option, 'Specification load function')

  endif

endfunction
-- End of function definition for !!specLoad
