-- File:            specsetup.pmlfnc
--   Type:          Function Definition
--   Group:         Specification handling utilities
--     Keyword:     SPECS
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Jul 1 08:31:05 WAT 1997
--
--
-- Description:
-- Set up for specification gadgets and SPECDATA object, rules are:
--
--   autoSelect = true
--        use ".reference" to setup specifications lists.
--   autoSelect = false
--        use ".reference" only as a reference.
--
-- If SpecName is set, this can be replace were autoSelect is true.
-- If there is no SpecName set and there is a reference, then we use ref item
-- spref if possible.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     SPECDATA    Spec data object contain all spec data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!specSetUp (!specData is SPECDATA)

  -- Initialise Variables
  !specData.questions.clear()
  !specData.permissibles.clear()

  -- Is autoSelection set
  if(!specData.autoSelection.unset()) then
    !specData.autoSelection = false
  endif

  -- autoSelection from reference item
  if(!specData.autoSelection) then

    -- Is reference item defined
    if(!specData.reference.set()) then

      -- If there is a spec reference, the we'll set Spec and current selection
      if(!specData.reference.spref.set()) then

        -- Set CurrentSelection, SpecName
        !specData.currentSelection = !specData.reference.spref
        !specData.specName         = SPEC of $!specData.currentSelection

      endif
    endif

  -- No autoSelection
  else

    -- Is reference item defined
    if(!specData.reference.set()) then

      -- Set specification to reference item, if there is no specification set
      if(!specData.reference.spref.set() and !specData.specName.unset()) then

        -- Set CurrentSelection, SpecName
        !specData.currentSelection = !specData.reference.spref
        !specData.specName         = SPEC of $!specData.currentSelection

      endif
    endif
  endif

   -- If there is no CurrentSelection, then we'll assume SpecName
  if(!specData.currentSelection.unset()) then

    -- Lets make sure there is a spec
    if(!specData.specName.unset()) then
      !!messageFile.error(153, 017)
    endif
    !specData.currentSelection = !specData.specName
  endif

  -- If we are not a standard spec (i.e. the SELE is the low selection)
  if(!specData.standardSpec.not()) then
    if(!specData.currentSelection.type eq 'SPCO') then
      !specData.currentSelection = !specData.currentSelection.owner
    endif
  endif

  -- Set Default to no selection (if defined)
  if(!specData.specLink.default.set()) then
    !specData.specLink.default.val = false
    call !!specDefault(!specData)
  endif

  if(!specData.currentSelection eq !specData.specName) then
    call !!specSelect(!specData,'SPEC')
  else
    call !!specSelect(!specData,'CURRENT')
  endif

  -- Display specification data
  call !!specDisplay(!specData)

endfunction
-- End of function definition for !!specSetUp
