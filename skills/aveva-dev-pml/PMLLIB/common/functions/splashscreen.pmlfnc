--
--
-- Description:
-- Opens the splash screen
--
------------------------------------------------------------------------
define function !!splashScreen(!action is STRING) is ARRAY

  !splashExeFile = object FILE('%PDMSEXE%/splashscreen.exe')
  if (!splashExeFile.exists()) then
    !splashCommand = '"' + !splashExeFile.fullName() + '" ' + !action.trim() + '&'

    SYSCOM '$!splashCommand'
    handle any
    endhandle
  endif

endfunction
-- End of function definition for !!splashScreen
