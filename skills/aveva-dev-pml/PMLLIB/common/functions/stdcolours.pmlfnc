--
--
-- Description:
-- Returns standard colour, ie the currently defined colours
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       all colour definitions, array of COLOUR objects
--
------------------------------------------------------------------------

-- Define function
define function !!stdColours() is ARRAY

  -- Initialise Variables
  !colours = ARRAY()

  -- Loop through all system colours
  do !i from 305 to 354
    -- Get Colour
    !colours.append(!i)
  enddo

  return !colours

endfunction
-- End of function definition for !!stdColours
