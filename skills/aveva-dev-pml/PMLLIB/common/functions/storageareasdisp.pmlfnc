--
--
-- Description:
-- Display storage areas on form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget to be updated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!storageAreasDisp()

  -- Initialise Variables
  !dText  = ARRAY()
  !rText  = ARRAY()
  !select = !!storageAreas.area.val

  -- Loop through all the groups
  do !i indices !!storageAreas.stores

    skip if(!!storageAreas.stores[!i].areas.unset())

    -- Include Dtext
    !dText.append(!!storageAreas.stores[!i].title)
    !rText.append(!!storageAreas.stores[!i].name)
    !dTextG = ARRAY()
    !rTextG = ARRAY()

    -- Loop through all group storage areas
    do !j indices !!storageAreas.stores[!i].areas

      -- If there is a storage area defined, then display it
      if(!!storageAreas.stores[!i].areas[!j].store.unset()) then
        !store  = '<unset>'
      elseif(!!storageAreas.stores[!i].areas[!j].store.badref()) then
        !store  = '<unset>'
      else
        !store  = !!storageAreas.stores[!i].areas[!j].store.fullName.string()
      endif

      -- Display
      !display  = substring(!!storageAreas.stores[!i].areas[!j].title & '                    ',1,20)

      -- Group Storage Data
      !dTextG.append(!display & ' ' & !store)
      !rTextG.append(!!storageAreas.stores[!i].name & ' ' & !!storageAreas.stores[!i].areas[!j].name)

      -- Main Storage Data
      !dText.append('   ' &  !display & ' ' & !store)
      !rText.append(!!storageAreas.stores[!i].name & ' ' & !!storageAreas.stores[!i].areas[!j].name)

      -- Loop through any associated area gadgets
      do !l indices !!storageAreas.stores[!i].areas[!j].gadgets
        !!storageAreas.stores[!i].areas[!j].gadgets[!l].val = !store
      enddo

      -- For each callback associated with storage area
      !size = !!storageAreas.stores[!i].areas[!j].callbacks.size()
      if (!size gt 0) then
           do !l from 1 to !size
                 !callback = !!storageAreas.stores[!i].areas[!j].callbacks[!l]
                 call $!callback
           enddo
      endif

    enddo

    -- Loop through any associated group gadgets
    do !k indices !!storageAreas.stores[!i].gadgets
      !selected    = !!storageAreas.stores[!i].gadgets[!k].val
      !!storageAreas.stores[!i].gadgets[!k].dText = !dTextG
      !!storageAreas.stores[!i].gadgets[!k].rText = !rTextG
      skip if(!selected eq 0)
      !!storageAreas.stores[!i].gadgets[!k].val   = !selected
    enddo

  enddo

  -- Load the display
  !!storageAreas.area.dText = !dText
  !!storageAreas.area.rText = !rText

  if(!select gt 0) then
    !!storageAreas.area.val = !select
  endif

endfunction
-- End of function definition for !!storageAreasDisp
