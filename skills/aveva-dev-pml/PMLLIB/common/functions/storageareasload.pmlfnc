--
--
-- Description:
-- Load Storage Areas from File into the form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!storageAreasLoad()

  -- Initialise Variables
  !!storageAreas.stores.clear()

  -- Load Current Module Data
  !module = !!module()

  -- Load all groups in
  !paths = !!searchPaths(!module.appKey.lowcase() & '-storegroups.pmldat')
  if (!paths.empty()) then
    !!comStoreGrpDflt()

  else

    -- Cycle through list and load all files
    do !i indices !paths
      call !!runMacro(!paths[!i].file.fullName(),!paths[!i].defaultType)
      handle any
      endhandle
    enddo
  endif

  -- Search Areas
  !paths = !!searchPaths(!module.appKey.lowcase() & '-stores.pmldat')
  if (!paths.empty()) then
    !!comStoreDflt()

  else

    -- Cycle through list and load all files
    do !i indices !paths
      call !!runMacro(!paths[!i].file.fullName(),!paths[!i].defaultType)
      handle any
      endhandle
    enddo
  endif

  -- Order the entries in each group
  do !i indices !!storageAreas.stores

    !block      = object BLOCK('!!storageAreas.stores[!i].areas[!evalIndex]')
    !groupArray = !!storageAreas.stores[!i].areas.evaluate(!block)

    -- Get
    !block      = object BLOCK('!groupArray[!evalIndex].name.upcase()')
    !entries    = !groupArray.evaluate(!block)

    -- Sort Groups into order
    !sort       = !entries.sortedIndices()

    -- Build a new array of the storage areas
    !block      = object BLOCK('!groupArray[!sort[!evalIndex]]')
    !!storageAreas.stores[!i].areas = !entries.evaluate(!block)

  enddo

  -- Copy current Stores into PrevStores for undo
  !!storageAreas.prevStores = !!storageAreas.stores

  -- Display Entries
  call !!storageAreasDisp()

endfunction
-- End of function definition for !!storageAreasLoad
