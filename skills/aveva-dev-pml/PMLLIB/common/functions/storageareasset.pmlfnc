-- Created:         Tue Apr 29 15:01:08 WAT 1997
--
--
-- Description:
-- Sets storage area, for passed group and storage area. Dependent on
-- what option are supplied will determine how the group and area stores
-- are set:
--        GroupName  AreaName         Action
--         empty      empty    Current selection from !!storageAreas.area
--         set        empty    All areas for passed group will be set
--         set        set      Specified area of group will be set
--         empty      set      ignored
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Group Name
--    2   R      STRING      Area Name
--    3   R      STRING      Option : NOCHECK
--                                    CHECK
--                                    UNSET
-- Return:
--   [Data Type] [Description]
--    ANY         Either an ARRAY of storage areas for a group or a DBREF of a specific storage area
--
------------------------------------------------------------------------

-- Define function
define function !!storageAreasSet (!groupName is STRING, !areaName is STRING, !pOption is STRING) is ANY

  -- Initialise variables
  !item       = !!ce
  !option     = !pOption
  !references = ARRAY()

  -- Copy current Stores into PrevStores for undo
  !!storageAreas.prevStores = !!storageAreas.stores

  -- Get store data
  !store = !!storageData(!groupName,!areaName)
  !group = !store.groupNumber
  !area  = !store.areaNumber

  -- If Area is zero, i.e. the whole group
  if(!area.unset()) then
    !areaStart = 1
    !areaEnd   = !!storageAreas.stores[!group].areas.size()
  else
    !areaStart = !area
    !areaEnd   = !area
  endif

  -- Loop through all the areas
  do !i from !areaStart to !areaEnd

    -- Unname Areas
    if(!option.upcase() eq 'UNSET') then
      !!storageAreas.stores[!group].areas[!i].store = object DBREF()
      !references.append(object DBREF())
      skip

    -- Name Areas
    else

      -- Set check rule flag
      if(!option.upcase() eq 'CHECK') then
        !check = true
      else
        !check = false
      endif

      -- Auto select storage area
      !parent = !!autoSelectStore(!item, !!storageAreas.stores[!group].name, !!storageAreas.stores[!group].areas[!i].name, !check)

      -- Set storage area
      if(!parent.set()) then
        !!storageAreas.stores[!group].areas[!i].store = !parent
        !references.append(!parent)
      else
        return !references
      endif
    endif
  enddo

  -- Redisplay List
  call !!storageAreasDisp()

  -- To display tooltip for the text gadgets
  !!appDesMain.sctns.settooltip(!!appDesMain.sctns.val)
  !!appDesMain.nodes.settooltip(!!appDesMain.nodes.val)

  !!appDesMain.panelStorage.settooltip(!!appDesMain.panelStorage.val)
  !!appDesMain.ljoiStorage.settooltip(!!appDesMain.ljoiStorage.val)

  -- Return
  if(!area.unset()) then
    return !references
  else
    return !references[1]
  endif

endfunction
-- End of function definition for !!storageAreasSet
