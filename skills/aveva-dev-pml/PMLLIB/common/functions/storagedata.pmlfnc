--
--
-- Description:
-- Returns data about the passed storage area and group.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Group Name
--    2   R      STRING      Area of Group
-- Return:
--   [Data Type] [Description]
--    STORE       Storage Data
--
------------------------------------------------------------------------

-- Define function
define function !!storageData (!groupName is STRING, !areaName is STRING) is STORE

  -- Check if !!storageAreas has been defined, if not, load it
  if(undefined(!!storageAreas)) then
    pml reload form !!storageAreas
  endif

  -- Initialise Variables
  !returnStore             = object STORE()

  -- Get Group
  !block                   = object BLOCK('!!storageAreas.stores[!evalIndex].name.upcase()')
  !groups                  = !!storageAreas.stores.evaluate(!block)
  !group                   = !groups.findFirst(!groupName.upcase())

  -- If there is no group, then return an error
  if(!group.unset()) then

    !!messageFile.error(149, 100, !groupName)
    return !returnStore
  endif
  !returnStore.groupNumber = !group

  -- Return with no error for empty area name
  if(!areaName.empty()) then
    return !returnStore
  endif

  -- Get Area
  !block                   = object BLOCK('!!storageAreas.stores[!group].areas[!evalIndex].name.upcase()')
  !areas                   = !!storageAreas.stores[!group].areas.evaluate(!block)
  !area                    = !areas.findFirst(!areaName.upcase())

  -- If there is no Area, then return an error
  if(!area.unset()) then

    !!messageFile.error(149, 101, !areaName, !groupName)
    return !returnStore
  endif

  !returnStore             = !!storageAreas.stores[!group].areas[!area]
  !returnStore.groupNumber = !group
  !returnStore.areaNumber  = !area

  -- Return
  return !returnStore

endfunction
-- End of function definition for !!storageData
