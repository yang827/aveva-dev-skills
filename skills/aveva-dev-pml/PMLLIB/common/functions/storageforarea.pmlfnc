--
--
-- Description:
-- Links the passed button and paragraph/yexyinput gadget to a specific
-- storage area.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Button gadget (used to set storage)
--    2   R      GADGET      Paragraph/Text input gadget to display store
--    3   R      STRING      Group name
--    4   R      STRING      Area name
--    5   R      STRING      Option : NOCHECK
--                                    CHECK
--                                    UNSET
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!storageForArea (!button is GADGET, !display is GADGET, !groupName is STRING, !areaName is STRING, !option is STRING)

  -- Get Group Data
  !store      = !!storageData(!groupName, !areaName)

  -- Set callback on Button
  !button.callback = 'call !!storageAreasSet(|' & !groupName & '|, |' & !areaName & '|, |' & !option & '|)'

  -- Check that the Display gadget is not already used
  !block      = object BLOCK('!!storageAreas.stores[!store.groupNumber].areas[!store.areaNumber].gadgets[!evalIndex].name()')
  !names      = !!storageAreas.stores[!store.groupNumber].areas[!store.areaNumber].gadgets.evaluate(!block)
  !block      = object BLOCK('!!storageAreas.stores[!store.groupNumber].areas[!store.areaNumber].gadgets[!evalIndex].owner().name()')
  !owners     = !!storageAreas.stores[!store.groupNumber].areas[!store.areaNumber].gadgets.evaluate(!block)

  if(!names.set()) then
    !find = !names.findFirst(!display.name())
    if(!find.set()) then
      if(!owners[!find] eq !display.owner().name()) then
        return
      endif
    endif
  endif

  -- Append Gadget to Group Store
  !!storageAreas.stores[!store.groupNumber].areas[!store.areaNumber].gadgets.append(!display)

endfunction
-- End of function definition for !!storageForArea
