--
--
-- Description:
-- Links passed list/option gadget to a storage group.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List/Option gadget linked to group
--    2   R      STRING      Group name
--    3   R      STRING      Option : NOCHECK
--                                    CHECK
--                                    UNSET
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!storageForGroup (!gadget is GADGET, !groupName is STRING, !option is STRING)

  -- Initialise Variables
  !gadgetData = '!!' & !gadget.owner() & '.' &  !gadget.name() & '.selection()'

  -- Get Group Data
  !group      = !!storageGroupData(!groupName)

  -- Set callback on gadget
  !gadget.callback = 'call !!storageAreasSet(' & !gadgetData & '.part(1),' & !gadgetData & '.part(2), |' & !option & '|)'

  -- Append Gadget to Group Store
  !!storageAreas.stores[!group.groupNumber].gadgets.append(!gadget)

endfunction
-- End of function definition for !!storageForGroup
