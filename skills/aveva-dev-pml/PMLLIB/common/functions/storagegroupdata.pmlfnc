--
--
-- Description:
-- Returns a storage group.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Storage Group
-- Return:
--   [Data Type] [Description]
--    STOREGROUP  Storage Group
--
------------------------------------------------------------------------

-- Define function
define function !!storageGroupData (!groupName is STRING) is STOREGROUP

  -- Initialise Variables
  !return = object STOREGROUP()

  -- Get Group
  !block  = object BLOCK('!!storageAreas.stores[!evalIndex].name.upcase()')
  !groups = !!storageAreas.stores.evaluate(!block)
  !group  = !groups.findFirst(!groupName.upcase())

  -- If there is no group, then return an error
  if (!group.unset()) then

    !!messageFile.error(149, 100, !groupName)
    return !return
  endif

  !return             = !!storageAreas.stores[!group]
  !return.groupNumber = !group

  return !return

endfunction
-- End of function definition for !!storageGroupData
