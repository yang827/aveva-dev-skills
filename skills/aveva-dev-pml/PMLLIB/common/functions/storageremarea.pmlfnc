--
--
-- Description:
-- removes the passed gadget from storage area form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Paragraph/Text input gadget to remove
--    2   R      STRING      Group name
--    3   R      STRING      Area name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!storageRemArea (!display is GADGET, !groupName is STRING, !areaName is STRING)

  -- Get Group Data
  !store      = !!storageData(!groupName, !areaName)

  -- Find the Display gadget
  !gadgetIndex = !!storageAreas.stores[!store.groupNumber].areas[!store.areaNumber].gadgets.findFirst(!display)

  -- remove the gadget if found
  if (!gadgetIndex.unset().not()) then
    !!storageAreas.stores[!store.groupNumber].areas[!store.areaNumber].gadgets.remove(!gadgetIndex)
  endif

endfunction
-- End of function definition for !!storageRemArea
