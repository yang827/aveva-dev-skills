--    Module:        Undefined
--  Author:          Undefined
--  Created:         Thu Jan  6 15:55:43 2011
--
--  Description:     Return string of input value rounded up to the number
--                   of decimal places specified in the format object
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     REAL        Value to round up
--    2    R     FORMAT      FORMAT object defining units and precision
-- Return:
--   [Data Type] [Description]
--    STRING      Formatted string for rounded up value
--
------------------------------------------------------------------------

define function !!stringRoundUpValue(!value is REAL, !format is FORMAT) is STRING

  !formattedValue = !value.string(!format)
  handle any
    return ''
  endhandle
  if( !formattedValue.real() geq !value.string().real() ) then
    !result = !formattedValue
  else
    if( !format.dp.set() ) then
      !pow            = !format.dp * -1
      !incrementValue = power(10,!pow)
      !increment      = !incrementValue.string().real(!format)
      !newValue       = !formattedValue.real() + !increment
      !result         = !newValue.string(!format)
    else
      !result = !formattedValue
    endif
  endif

  return !result

endfunction
