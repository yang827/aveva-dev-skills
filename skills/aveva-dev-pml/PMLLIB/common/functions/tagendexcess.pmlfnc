------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Pipe piece
--    2   R      STRING      Tag
--    3   R      STRING      End to be tagged
--    4   R      REAL        End excess (always passes as MM)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!tagEndExcess(!pipePiece is DBREF, !end is STRING, !excess is REAL)

  -- Check Type
  if(!pipePiece.type.neq('PPIECE')) then
    return
  endif

  -- Excess is always metric (so we will force MM on to the value)
  !excessMM     = $!excess$Nmm

  -- Format excess
  !distance     = !excessMM.string(!!distanceFmt)

  -- Get End Position
  if(!end.substring(1,1).upcase().eq('A')) then
    !tagEnd     = 'Arrive'
    !position   = !pipePiece.aPosition
    !direction  = !pipePiece.aDirection
  else
    !tagEnd     = 'Leave'
    !position   = !pipePiece.lPosition
    !direction  = !pipePiece.lDirection
  endif

  -- Offset direction
  !parallel     = !direction.isParallel(U)

  if(!parallel.not()) then
    !offsetDir  = !direction.orthogonal(U)
  else
   !offsetDir   = !direction.orthogonal(N)
  endif

  -- Offset Position
  !offset       = !pipePiece.aOD / 2
  !tagPosition  = !position.offset(!offsetDir, !offset)

  -- Remove previous tags (needs to be registers)
  AID CLEAR ALL 14000

  -- Tag End
  AID TEXT NUMBER 14000 |$!tagEnd Excess $!distance| AT $!<tagPosition>

endfunction
-- End of function definition
