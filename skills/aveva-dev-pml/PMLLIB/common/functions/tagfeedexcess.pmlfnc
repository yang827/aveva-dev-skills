------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Pipe piece
--    2   R      STRING      Tag
--    3   R      REAL        Segment
--    4   R      REAL        End excess (always passes as MM)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!tagFeedExcess(!pipePiece is DBREF, !tag is STRING, !segment is REAL, !excess is REAL)

  -- Check Type
  if(!pipePiece.type.neq('PPIECE')) then
    return
  endif

  -- Excess is always metric (so we will force MM on to the value)
  !excessMM     = $!excess$Nmm

  -- Format excess
  !distance     = !excessMM.string(!!distanceFmt)

  -- Remove previous tags (needs to be registers)
  AID CLEAR ALL 14000

  -- Get components of pipe piece
  !components       = !pipePiece.cmprfa
  !count            = 0
  do !i indices !components
    if(!components[!i].type.eq('BEND')) then
      !count        = !count + 1

      -- Get leg of pipe
      if(!count.eq(!segment)) then
        !offset     = !components[!i].ltLength / 2
        !direction  = !components[!i].lDirection
        !position   = !components[!i].lPosition
        break
      endif
    endif
  enddo

  -- Derive position
  if(defined(!direction)) then
    !tagPosition    = !position.offset(!direction, !offset)

    -- Tag End
    AID TEXT NUMBER 14000 |Feed Excess $!distance| AT $!<tagPosition>

  endif

endfunction
-- End of function definition
