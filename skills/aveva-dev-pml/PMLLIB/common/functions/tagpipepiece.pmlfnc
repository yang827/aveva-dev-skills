------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Pipe piece
--    2   R      STRING      Tag Text
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!tagPipePiece(!pipePiece is DBREF, !tag is STRING)

  -- Check Type
  if(!pipePiece.type.neq('PPIECE')) then
    return
  endif

  -- Return position along the pipe piece
  !tagPosition  = !!positionAlongPipePiece(!pipePiece, 0.5)

  -- No position returned
  if(!tagPosition.unset()) then
    return
  endif

  -- Remove previous tags (needs to be registers)
  AID CLEAR ALL 14000

  -- Tag End
  AID TEXT NUMBER 14000 '$!tag' AT $!<tagPosition>

endfunction
-- End of function definition
