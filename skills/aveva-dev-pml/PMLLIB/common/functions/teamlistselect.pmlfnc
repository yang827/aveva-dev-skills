--
--
-- Description:
-- Function to display the information on the selected team
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget from which team is selected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!teamListSelect(!list is GADGET)

  -- Get the current selected team object
  !teams     = TEAMS
  !tBlock    = object BLOCK(|!teams[!evalIndex].name|)
  !teamName  = !list.selection('RTEXT')
  !tPos      = !teams.evaluate(!tBlock).findFirst(!teamName)

  -- Check to see if team was found
  if (!tPos.unset()) then

    -- Call init macro again
    call !!teamListInit()
    return

  endif

  -- Get a team object
  !team      = !teams[!tPos]

  -- Display the selected TEAM's description if required
  !desc = !team.description
  if (!desc.unset() or !desc.empty()) then
    !!teamList.tDesc.val = |-- No description --|
  else
    if (!desc.length() gt 43) then
      !!teamList.tDesc.val = !desc.subString(1,41) + |>>|
    else
      !!teamList.tDesc.val = !desc
    endif
  endif

  -- Process the selected teams userlist to get the display texts
  !users = !team.userList()

  !!teamList.users.clear()

  do !i indices !users
    if (!!sessionSettings.showAs eq |DESC|) then
      !ulist[!i] = !users[!i].description
      if (!ulist[!i].unset() or !ulist[!i].empty()) then
        !ulist[!i] = !users[!i].name
      else
        !ulist[!i] = !ulist[!i].trim()
      endif
    else
      !ulist[!i] = !users[!i].name
    endif
  enddo

  -- Display the constructed array if it has elements
  if (defined(!ulist)) then
    !ulist.sort()
    !!teamList.users.dText = !ulist
  endif

  -- Process the selected team`s dblist to get display texts
  !dbs = !team.dbList()

  !!teamList.dbs.clear()

  do !i indices !dbs
    if (!!sessionSettings.showAs eq |DESC|) then
      !dbList[!i] = !dbs[!i].description
      if (!dbList[!i].unset() or !dbList[!i].empty()) then
        !dbList[!i] = !dbs[!i].name.after(|/|)
      else
        !dbList[!i] = !dbList[!i].trim()
      endif
    else
      !dbList[!i] = !dbs[!i].name.after(|/|)
    endif
  enddo

  -- Display the constructed array if it has elements
  if (defined(!dbList)) then
    !dbList.sort()
    !!teamList.dbs.dText = !dbList
  endif

endfunction
-- End of function definition for !!teamListSelect
