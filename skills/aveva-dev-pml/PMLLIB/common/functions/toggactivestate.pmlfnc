--
--
-- Description:
-- Function to change the state of a gadget. Turns gadget to
-- opposite state at time of call.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget whose state to change
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!toggActiveState(!gadget is GADGET)

  -- Check gadget state
  if (!gadget.active) then
    !gadget.active = false
  else
    !gadget.active = true
  endif


endfunction
-- End of function definition for !!toggActiveState
