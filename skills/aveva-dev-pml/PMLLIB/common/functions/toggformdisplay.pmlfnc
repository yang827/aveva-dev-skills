--
--
-- Description:
-- Function to display form if hidden, or hide form if displayed.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form whose display state to change
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!toggFormDisplay(!form is FORM)

  -- Check shown status
  if (!form.shown()) then

    !form.hide()

  else

    !form.show()

  endif

endfunction
-- End of function definition for !!toggFormDisplay
