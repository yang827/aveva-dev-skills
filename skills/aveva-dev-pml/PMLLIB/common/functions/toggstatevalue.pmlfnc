--
--
-- Description:
-- Function to return the alternative string value of a toggle gadget
-- depending on the selected stated.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Toggle gadget
-- Return:
--   [Data Type] [Description]
--    STRING      Alternative string of toggle state.
--
------------------------------------------------------------------------

-- Define function
define function !!toggStateValue(!gadget is GADGET) is STRING

  !returnValue = STRING()

  -- Check that we have a toggle gadget
  if (!gadget.type() neq 'TOGGLE') then
    return !returnValue
  endif

  -- Check the state and return the appropriate value
  if (!gadget.val) then
    !returnValue = !gadget.onValue
  elseif (not !gadget.val) then
    !returnValue = !gadget.offValue
  endif

  return !returnValue

endfunction
-- End of function definition for !!toggStateValue
