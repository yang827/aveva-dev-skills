--
-- File:            uniquepath.pmlfnc
--   Type:          Function Definition
--   Group:         File Handling
--     Keyword:     FILE
--   Module:        common
--   Replaces:
--
-- Author:          C.J.Fellows
-- Created:         28 Jan 1998
--
--
-- Description:
-- Returns an array of FILEs which match the File-name specified, found in
-- the specified directories. All duplicate filenames are removed. Where
-- duplicate files are found in different directories, the file in the first
-- directory is selected for preference.
-- The required directories are specified by type:
-- USER - User data, from %PDMSUSER%
-- PROJ - Project data, from %<Proj>DFLTS%
-- PDMS - PDMS sample data, from %PDMSDFLTS%
-- CADC - Essential CADC data, from %PMLLIB/*/data - Avoid if possible
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      File-name, including wild-cards,
--                           eg dra-dxf-*.dat
--    2   R      STRING      List of directory-types to search
--                           eg 'USER PROJ PDMS'
--    3   R      STRING      Application name (only required if CADC is included)
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of FILE objects
--
------------------------------------------------------------------------

-- Define function
define function !!uniquePath (!rootFile is STRING, $
                              !dirlist is STRING,  $
                              !application is STRING) is ARRAY
  -- Initialise Variables
  !returnArray = ARRAY()

  !dirTypes = !dirlist.split()
  !path = ARRAY()
  !evarNames = ARRAY()

  -- Set up Directory names
  !index = !dirTypes.findFirst('USER')
  if( !index.set() ) then
    !evarNames.append( 'PDMSUSER' )
  endif
  !index = !dirTypes.findFirst('PROJ')
  if( !index.set() ) then
    !p = CURRENT PROJECT
    !evarNames.append( !p.code() + 'DFLTS' )
  endif
  !index = !dirTypes.findFirst('PDMS')
  if( !index.set() ) then
    !evarNames.append( 'PDMSDFLTS' )
  endif
  -- This one is slow
  !index = !dirTypes.findFirst('CADC')
  if( !index.set() ) then
    !evarNames.append( 'PMLLIB' )
  endif

  do !evar values !evarNames
   !array = !!evarSplit(!evar)
    if( !evar eq 'PMLLIB' and !application.length() gt 0 ) then
      -- Append data directory for application (what about NT?)
      do !i indices  !array
        !array[!i] = !array[!i] + '/' + !application + '/data'
      enddo
    endif

    -- Make sure that everything we have in ARRAY exists as a directory
    do !i indices !array
      !testFile = object FILE(!array[!i])
      if (!testFile.exists() and !testFile.type().eq('DIRECTORY')) then
      	-- OK
      else
      	-- delete invalid entry
      	!array.deleteFrom(!i, 1)
      endif
    enddo
    !array.compress()

    if( !array.set() ) then
      !path.appendArray( !array )
    endif
  enddo

  if( !path.size().eq(0) ) then
     return !returnArray
  endif
  -- Generate file lists
  !full  = ARRAY()
  !short = ARRAY()

  do !i indices !path
    !full[!i] =  !!findFileWild( !path[!i] , !rootFile )

    -- Strip off the directory names
    !eval = object BLOCK( '!full[!i][!evalIndex].part(-1,|/|)')
    !short[!i] = !full[!i].evaluate(!eval)
  enddo

  -- Insert each array in the Results array, ignoring duplicates
  -- The first array of files is the most important, but gets placed last
  !result = !full.removeFirst()
  !shortResult = !short.removeFirst()

  -- Remove duplicates from the lists
  do !i indices !short
    -- Intersection between the 2 arrays
    !intersect = !shortResult.intersect(!short[!i])

    -- Delete duplicates from 2nd array
    !removeBad = object BLOCK(                           $
       '!full[!i][!short[!i].findFirst(!intersect[!evalIndex])].delete()')
    !full[!i].evaluate(!removeBad)
    handle any
      -- Intersection array is shorter than 2nd array
    endhandle

    -- Insert remainder in Result fullname and cut-down name arrays
    !result.insertArray( 1, !full[!i])
    !eval = object BLOCK( '!result[!evalIndex].part(-1,|/|)')
    !shortResult = !result.evaluate(!eval)
  enddo

  -- Generate the FILE objects
  do !filename values !result
    !file = !!file(!filename)

    if( !file.exists() ) then
      !returnArray.append( !file )
    endif
  enddo

  return !returnArray

endfunction
-- End of function definition for !!uniquePath
