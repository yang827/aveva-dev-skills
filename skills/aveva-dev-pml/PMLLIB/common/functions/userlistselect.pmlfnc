--
--
-- Description:
-- Function to display information about the username selected in
-- the User List form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget from which selection has been made.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!userListSelect(!list is GADGET)

  -- Initialise Variables
  !detail      = ARRAY()

  -- Get the current selected username
  !users     = USERS
  !unBlock   = object BLOCK(|!users[!evalIndex].name|)
  !userName  = !list.selection('RTEXT')
  !uPos      = !users.evaluate(!unBlock).findFirst(!userName)
  !user      = !users[!uPos]

  -- Set the selected usernames description if applicable
  !desc = !user.description
  if (!desc.unset() or !desc.empty()) then
    !detail.append('Description : unset')
  else
    !detail.append('Description : ' & !desc)
  endif

  -- Show the selected users Privilege level
  !uPriv = !user.access
  !detail.append('  Privilege : ' & !uPriv)

  !detail.append('')
  !detail.append('Teams')

  -- Process the selected users teamlist to get display texts
  !teams = !user.teamList()

  !!userList.teams.clear()

  do !i indices !teams
    if (!!sessionSettings.showAs eq |DESC|) then
      !tList[!i] = !teams[!i].description
      if (!tList[!i].unset() or !tList[!i].empty()) then
        !detail.append('  ' & !teams[!i].name)
      else
        !detail.append('  ' & !tList[!i].trim())
      endif
    else
      !detail.append('  ' & !teams[!i].name)
    endif
  enddo

  -- Display the constructed array if it has elements
  if(!detail.empty().not()) then
    !!userList.teams.dText = !detail
  endif

endfunction
-- End of function definition for !!userListSelect
