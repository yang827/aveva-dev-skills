-- Created:         Thu Jan 23 15:31:42 GMT 1997
--
--
-- Description:
-- Function to display the information pertaining to the current
-- selected project user in the Project Users form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!userStatusData()

  -- Get the selected session UNIQUEID
  !pid = !!userStatus.userList.selection('RTEXT')
  !project         = CURRENT PROJECT
  !isGlobalProject = !project.isGlobal()

  -- Get the current project user info
  !sessionList = SESSIONS

  -- Find the selected process ID in the current session list
  !sBlock = object BLOCK(|!sessionList[!evalIndex].uniqueId|)
  !pos    = !sessionList.evaluate(!sBlock).findFirst(!pid)
  if (!pos.unset()) then
    !!messageFile.warning(150, 062)
    call !!userStatusList()
    return
  endif

  -- Get the processes PDMS user
  !user = !sessionList[!pos].user().name
  if (!!sessionSettings.showAs eq |DESC|) then
    !user = !sessionList[!pos].user().description
    if (!user.unset() or !user.empty()) then
      !user = !sessionList[!pos].user().name
    else
      if (!user.length() gt 24) then
        !user = !user.subString(1,22) + |>>|
      endif
    endif
  endif

  -- Get the processes MDB
  !mdb = !sessionList[!pos].mdb().name
  if (!!sessionSettings.showAs eq |DESC| and !mdb.set()) then
    !mdb = !sessionList[!pos].mdb().description
    if (!mdb.unset() or !mdb.empty()) then
      !mdb = !sessionList[!pos].mdb().name
    else
      if (!mdb.length() gt 24) then
        !mdb = !mdb.subString(1,22) + |>>|
      endif
    endif
  endif
  if (!mdb.unset()) then
    !mdb = |unset|
  endif

  -- Set this data along with the other gadgets
  !!userStatus.name.val     = !sessionList[!pos].name
  !!userStatus.user.val     = !user
  !!userStatus.login.val    = !sessionList[!pos].login
  !!userStatus.mdb.val      = !mdb
  !!userStatus.module.val   = !sessionList[!pos].module()
  !!userStatus.uniqueId.val = !sessionList[!pos].uniqueId
  !!userStatus.host.val     = !sessionList[!pos].host
  !!userStatus.entered.val  = !sessionList[!pos].entered

  -- if the users real name could not be obtained then use the login id
  if (!!userStatus.name.val.trim() eq '') then
    !!userStatus.name.val = !!userStatus.login.val
  endif

  -- Gather information pertaining to this processes databases
  -- Process the list of data
  !!userStatus.dbList.clear()

  !dispText = ARRAY()
  if( !sessionList[!pos].mdb().set() ) then
    !current = !sessionList[!pos].current()
    !dBlock  = object BLOCK(|!current[!evalIndex].name|)
    !dbNames = !current.evaluate(!dBlock)
    !dbMode  = !sessionList[!pos].mode()
    !dbStat  = !sessionList[!pos].status()
    !dbStatInfo = !sessionList[!pos].statusInfo()

    -- Sort the array of DB names
--    !sortOrder = !dbNames.sortedIndices()

--    do !i values !sortOrder
    do !i indices !current
      if (!!sessionSettings.showAs eq |DESC|) then
        !dbText = !current[!i].description
        if (!dbText.unset() or !dbText.empty()) then
          !dbText = !dbNames[!i].trim()
        else
          if (!dbText.length() gt 26) then
            !dbText = !dbText.subString(1,24) + |>>|
          endif
        endif
      else
        !dbText = !dbNames[!i].trim()
      endif
      -- find out if DB is secondary at this location
      if(!isGlobalProject) then
        !dbRefNo = !current[!i].refno.dbref()
        if( !dbRefNo.isPrim ) then
          !dbPrim = 'Primary'
        else
          !dbPrim = 'Secondary'
        endif
        var !compose COMPOSE SPACE 0 |$!dbText| WIDTH 26 LEFT SPACE 1 |$!dbMode[$!i]| WIDTH 2 LEFT SPACE 2 |$!dbStat[$!i]| WIDTH 2 LEFT SPACE 2 |$!dbPrim| WIDTH 9 SPACE 2 |$!dbStatInfo[$!i]| WIDTH 50
      else
        var !compose COMPOSE SPACE 0 |$!dbText| WIDTH 26 LEFT SPACE 1 |$!dbMode[$!i]| WIDTH 2 LEFT SPACE 4 |$!dbStat[$!i]| WIDTH 2 LEFT SPACE 4 |$!dbStatInfo[$!i]| WIDTH 50
      endif

      !dispText.append(!compose[1])
    enddo
  endif

  -- If we have an array then we ought to add it really
  if (!dispText.set()) then
    !!userStatus.dbList.dText = !dispText
  endif

endfunction
-- End of function definition for !!userStatusData
