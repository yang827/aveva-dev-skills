--
--
-- Description:
-- Function to display a list of the current project users in the
-- Project Users form. Sort according to the .listBy gadget.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!userStatusList()

  -- Get a list of current project sessions
  !sessionList = SESSIONS

  -- Get the current selection as !mode flag
  !mode = !!userStatus.listBy.selection('RTEXT')

  -- See if we have a selection
  !currSel = !!userStatus.userList.selection('RTEXT')

  -- Loop through current sessions and process according to selection mode
  do !i indices !sessionList
    if (!mode eq |User()|) then
      !dispText[!i] = !sessionList[!i].user().name
      if (!!sessionSettings.showAs eq |DESC|) then
        !dispText[!i] = !sessionList[!i].user().description
        if (!dispText[!i].unset() or !dispText[!i].empty()) then
          !dispText[!i] = !sessionList[!i].user().name
        endif
      endif
    elseif (!mode eq |Mdb()|) then
      !dispText[!i] = !sessionList[!i].mdb().name
      if (!!sessionSettings.showAs eq |DESC|) then
        !dispText[!i] = !sessionList[!i].mdb().description
        if (!dispText[!i].unset() or !dispText[!i].empty()) then
          !dispText[!i] = !sessionList[!i].mdb().name
        endif
      endif
      if (!dispText[!i].unset()) then
        !dispText[!i] = |unset|
      endif
    elseif (!mode eq 'Name') then
      !name = !sessionList[!i].name
      if (!name.trim() eq '') then
        !dispText[!i] = !sessionList[!i].login
      else
        !dispText[!i] = !name
      endif
    else
      !dispText[!i] = !sessionList[!i].$!mode
    endif

    !replText[!i] = !sessionList[!i].uniqueId
    if (!sessionList[!i].isCurrent) then
      !dispText[!i] = |* | + !dispText[!i]
    else
      !dispText[!i] = |  | + !dispText[!i]
    endif
  enddo

  -- Check that the display text has compiled as a list. An expunge and
  -- a finish by the system user can leave a project with no users but
  -- still be inhabited.
  if (undefined(!dispText)) then
    -- No users listed in project
    !!messageFile.error(150, 063)
    return
  endif

  -- Sort the display text list that we received
  !sortOrder = !dispText.sortedIndices()
  !dispText.sort()
  !replText.reIndex(!sortOrder)

  -- Display the values collected
  !!userStatus.userList.dText = !dispText
  !!userStatus.userList.rText = !replText

  -- Reset the selection if one exists
  if (not !currSel.empty()) then
    !!userStatus.userList.select('RTEXT',!currSel)
    handle (61,567)
      !!messageFile.warning(150, 062)
    endhandle
  endif

  -- Call function to display current selection data
  call !!userStatusData()

endfunction
-- End of function definition for !!userStatusList
