--
-- Author:          C.Brown
-- Created:         Mon Mar 9 12:10:00 BST 1998
--
--
-- Description:
--  convert file/path name to platform specific string to be
--  used in SYSCOM command
--
------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [1] [R] [STRING] [String to convert]
-- Return:
--   [STRING] [Platform specific string]
--
------------------------------------------------------------------------

define function !!var2env(!passedString is STRING) is STRING

  -- get operating system type
  !module = !!module()
  !opSys = !module.compileos.subString(1, 2)

  -- set the double $ string, once the 2 $ characters are in a string
  -- variable they can be used without being repeatedly evaluated
  !dollar = '$$$$'

  -- initialise local return variable
  !returnString = ''

  -- get the current operating system type
  if (!opSys eq 'WI') then

    -- replace \ with /
    !returnString = !passedString.replace('/', '\')

  else
    -- replace %*% with $$*

    -- split the string on % character
    !tempArray = !passedString.split('%')

    -- initialise the add dollar flag
    !addDollar = false

    -- loop through array and build up return string,
    -- add '$$' to every other entry starting at 2
    do !partString values !tempArray
      if (!addDollar) then
        !returnString = !returnString + !dollar + !partString
        !addDollar = false
      else
        !returnString = !returnString + !partString
        !addDollar = true
      endif
    enddo

    -- replace \ with /
    !returnString = !returnString.replace('\', '/')

  endif

  return !returnString

endfunction
-- End of function definition for !!var2env
