--
--
-- Description:
-- Returns the maximum volume of all the items passed in the list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Item volume is to be returned from
-- Return:
--   [Data Type] [Description]
--    VOLUME      Volume of items in list (wrt World)
--
------------------------------------------------------------------------

-- Define function
define function !!volumeOfList (!items is ARRAY) is VOLUME

  -- Initialise Variables
  !volumes = ARRAY()
  !volume  = object VOLUME()

  -- Get volume of all items
  !block   = object BLOCK('!!volume(!items[!evalIndex])')
  !volumes = !items.evaluate(!block)

  -- Get each of the component from the volume and find the max/min
  !block     = object BLOCK('!volumes[!evalIndex].from.east')
  !fromEast  = !volumes.evaluate(!block)
  !fromEast.sort()
  !block     = object BLOCK('!volumes[!evalIndex].from.north')
  !fromNorth = !volumes.evaluate(!block)
  !fromNorth.sort()
  !block     = object BLOCK('!volumes[!evalIndex].from.up')
  !fromUp    = !volumes.evaluate(!block)
  !fromUp.sort()
  !block     = object BLOCK('!volumes[!evalIndex].to.east')
  !toEast    = !volumes.evaluate(!block)
  !toEast.sort()
  !toEast.invert()
  !block     = object BLOCK('!volumes[!evalIndex].to.north')
  !toNorth   = !volumes.evaluate(!block)
  !toNorth.sort()
  !toNorth.invert()
  !block     = object BLOCK('!volumes[!evalIndex].to.up')
  !toUp      = !volumes.evaluate(!block)
  !toUp.sort()
  !toUp.invert()

  !volume.from.east   = !fromEast[1]
  !volume.from.north  = !fromNorth[1]
  !volume.from.up     = !fromUp[1]
  !volume.from.origin = World
  !volume.to.east     = !toEast[1]
  !volume.to.north    = !toNorth[1]
  !volume.to.up       = !toUp[1]
  !volume.to.origin   = World

  return !volume

endfunction
-- End of function definition for !!volumeOfList
