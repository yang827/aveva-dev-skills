--
-- Author:          E.conba
-- Created:         Mon Jan 27 12:59:17 GMT 1997
--
--
-- Description:
-- Function to write a session file for the user on exit from PDMS.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!writeSessionFile()

  -- Get the session information
  !sessionData = CURRENT SESSION
  !project     = CURRENT PROJECT
  !login       = !sessionData.login
  !writeArray  = ARRAY()

  -- Session filename
  !sessFile = object FILE()
  !sessFile.file('%PDMSUSER%/session_' + !login)

  -- check that the !!sessionSettings global object instance exists
  if (undefined(!!sessionSettings)) then
    !!sessionSettings = object PDMSSETTINGS()
  endif

  -- Check session project
  if (!!sessionSettings.project.unset()) then
    !!sessionSettings.project  = !project.code()
  endif

 !!sessionSettings.projName  = !project.id()
 !!sessionSettings.projNumb  = !project.Number()

  -- Check project Number
  if (!!sessionSettings.projNumb.unset())  then
    !!sessionSettings.projNumb     = ''
  endif

  -- Check session user
  if (!!sessionSettings.user.unset())  then
    !!sessionSettings.user     = !sessionData.user().name
  endif

  -- Check session Mdb
  if (!!sessionSettings.mdb.unset()) then

    !!sessionSettings.mdb      = !sessionData.mdb().name
    if (!!sessionSettings.mdb.unset()) then
      !!sessionSettings.mdb      = ''
    endif

  endif

  -- Build array to write
  !writeArray.append(|# PDMS Session Information for user: |& !login)
  !writeArray.append(|PROJNAME |    & !!sessionSettings.projName)
  if (!!sessionSettings.project.unset().not()) then
    !writeArray.append(|PROJECT |    & !!sessionSettings.project)
  endif
  !writeArray.append(|PROJNUMB |    & !!sessionSettings.projNumb)
  if (!!sessionSettings.user.unset().not()) then
    !writeArray.append(|USERNAME |   & !!sessionSettings.user)
  endif
  if (!!sessionSettings.mdb.unset().not()) then
    !writeArray.append(|MDB |        & !!sessionSettings.mdb)
  endif
  if (!!sessionSettings.module.unset().not()) then
    !writeArray.append(|MODULE |     & !!sessionSettings.module)
  endif
  if (!!sessionSettings.restore.unset().not()) then
    !writeArray.append(|RESTORE |    & !!sessionSettings.restore)
  endif
  if (!!sessionSettings.readOnly.unset().not()) then
    !writeArray.append(|READONLY | & !!sessionSettings.readOnly)
  endif

  -- Write array of session data
  !sessFile.writeFile('OVERWRITE', !writeArray)
  handle any

    -- Unable to write session file for some reason
    !!alert.error(|Could not write session file due to |& !!error.text)

  endhandle

endfunction
-- End of function definition for !!writeSessionFile
