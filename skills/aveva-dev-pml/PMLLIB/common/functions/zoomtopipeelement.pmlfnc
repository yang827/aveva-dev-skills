--
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to zoom to
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!zoomToPipeElement(!element is DBREF)

  -- Pipe Piece
  if(!element.type.eq('PPIECE')) then
    !from         = !element.aPos
    !to           = !element.lPos

  -- Pipe Spool
  elseif (!element.type.eq('PSPOOL')) then
    if(!element.psarfa[1].type.eq('BRAN')) then
      !from       = !element.psarfa[1].hPosition
    else
      !from       = !element.psarfa[1].position
    endif
    if(!element.pslrfa[1].type.eq('BRAN')) then
      !to         = !element.pslrfa[1].tPosition
    else
      !to         = !element.pslrfa[1].position
    endif

  -- Unhandled element type
  else
    !volume       = object VOLUME(!element)
    handle ANY
      return
    endhandle
    !from         = !volume.from
    !to           = !volume.to
  endif

  -- Through Point
  !throughPoint   = !from.midPoint(!to)
  handle ANY
    return
  endhandle

  -- Set metric format
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'


  -- Set through point
  !through[1]     = !throughPoint.east.string(!format).real()
  !through[2]     = !throughPoint.north.string(!format).real()
  !through[3]     = !throughPoint.up.string(!format).real()
  !!gphViews.views[1].through = !through

  -- Set view radius
  !radius         = !from.distance(!to).string(!format).real() / 2 * 0.05
  !radius         = !radius.max(500mm)
  !!gphViews.views[1].radius  = !radius

endfunction
-- End of function definition
