--     Keyword:     GEN
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Mar 21 14:23:12 "GMT 2000
--
--
-- Description:
-- Object for handling multiple graphical aid elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(REAL)                        BOOLEAN             Add aid graphic to list
--  aidModify()                      -                   Constructor, default
--  clear()                          BOOLEAN             Remove all aid graphic from the aid list
--  isAdded(REAL)                    BOOLEAN             Check is aid is already added to the system
--  mirror()                         -                   Set mirror
--  mirror(ANY)                      ANY                 Mirror passed aids about plane
--  mirrorPlane(PLANE)               -                   Set mirror plane
--  offset()                         -                   Set offset
--  offset(ANY)                      ANY                 Offset passed aids about plane
--  offset(POSITION)                 -                   Set offset by position
--  offset(REAL,DIRECTION)           -                   Set offset by distance and direction
--  remove(REAL)                     BOOLEAN             Remove aid graphic from the aid list
--  rotate(ANY)                      ANY                 Rotate passed aids
--  rotate(REAL)                     -                   Rotate selected aids
--  rotate(REAL,ANY)                 ANY                 Rotate passed aids
--  rotationLine (LINE)              -
--  rotationLine (POINTVECTOR)       -
--

define object AIDMODIFY

  -- Aid graphics that are to be modified (Array of REAL)
  member .aidList         is ARRAY

  -- Graphic aid list (Array of GPH graphical aids)
  member .graphicsList    is ARRAY

  -- Copies
  member .copies          is REAL

  -- Reference Plane
  member .plane           is PLANE

  -- Offset in terms of the reference plane
  member .offsetOrigin    is POSITION
  member .offsetXYZ       is POSITION

  -- Representation of offset as distance and direction
  member .offsetDistance  is REAL
  member .offsetDirection is DIRECTION

  -- Angle of rotation
  member .angle           is REAL

  -- Rotation line
  member .rotationLine    is LINE

  -- Mirror line (must be on the reference plane)
  member .mirrorPlane     is PLANE

  -- Copy flag
  member .copy            is BOOLEAN

  -- Type of graphic modification
  member .rotate          is BOOLEAN
  member .offset          is BOOLEAN
  member .mirror          is BOOLEAN

  -- Default line styles and colours
  member .listColour      is REAL
  member .listStyle       is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      aidModify
--
-- Description: Constructor, default
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Section
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .aidModify()

  -- Initialise Variables
  !this.copies        = 1
  !this.copy          = true
  !this.angle         = 0

  -- Default action
  !this.rotate(0)

  !this.listColour    = 2
  !this.listStyle     = 1

  -- Default settings (NOTE: the last definition is the default)
  --Offset
  !this.offset(0, U)

  -- Mirror
  !pv = object POINTVECTOR(N0, E)
  !this.mirrorPlane(!pv.plane())

  -- Rotation
  !pv = object POINTVECTOR(N0, U)
  !this.rotationLine(!pv)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add aid graphic to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid index number
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if added
--
------------------------------------------------------------------------

define method .add(!index is REAL) is BOOLEAN

  -- Add index to the list
  if(!this.isAdded(!index)) then
    return
  endif

  -- Get aid form graphics system
  !aid   = !!aidNumbers.get(!index)
  !aid.displayStyle(!this.listColour, !this.listStyle)
  handle ANY
  endhandle

  -- Perform change transformation on aid
  -- Rotate aid
  if(!this.rotate) then
    !modified = !this.rotate(!aid)

  -- Mirror aid
  elseif (!this.mirror) then
    !modified = !this.mirror(!aid)

  -- Offset Aid
  elseif (!this.offset) then
    !modified = !this.offset(!aid)

  endif

  -- Add to aid list
  !this.aidList.append(!index)

  -- Add modified aid to graphics list
  !this.graphicsList.append(!modified)

  -- Add back into the aid list
  !!aidNumbers.replace(!index, !aid)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove aid graphic from the aid list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid index number
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if added
--
------------------------------------------------------------------------

define method .remove(!index is REAL) is BOOLEAN

  -- Add index to the list
  if(!this.isAdded(!index).not()) then
    return
  endif

  -- Get index from the aid list
  !listIndex = !this.aidList.findFirst(!index)

  !this.aidList.remove(!listIndex)
  !this.graphicsList.remove(!listIndex)

  -- Get aid form graphics system
  !aid       = !!aidNumbers.get(!index)
  !aid.displayStyle()
  handle ANY
  endhandle

  -- Add back into the aid list
  !!aidNumbers.replace(!index, !aid)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Remove all aid graphic from the aid list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if added
--
------------------------------------------------------------------------

define method .clear() is BOOLEAN

  -- Initialise Variables
  !maximum = !this.aidList.size()

  -- If maximum is zero, then return
  if(!maximum eq 0) then
    !!error.text = 'No aid graphics selected.'
    return false
  endif

  -- Loop through the list
  do !i from !maximum to 1 by -1
    !index = !this.aidList[!i]
    !this.remove(!index)
  enddo

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isAdded
--
-- Description: Check is aid is already added to the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid index number
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if added
--
------------------------------------------------------------------------

define method .isAdded(!index is REAL) is BOOLEAN

  return !this.aidList.findFirst(!index).set()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotate passed aids
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Aid to rotate
-- Return:
--   [Data Type] [Description]
--    ANY         New aid definition
--
------------------------------------------------------------------------

define method .rotate(!aid is ANY) is ANY

  return !this.rotate(!this.angle, !aid)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotate passed aids
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation
--    2   R      ANY         Aid to rotate
-- Return:
--   [Data Type] [Description]
--    ANY         New aid definition
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL, !aid is ANY) is ANY

  -- Initialise Variables
  !return        = !aid

  -- Get core object
  !coreObject    = !aid.coreObject()
  !attributes    = !coreObject.attributes()

  -- Rotate aid graphics with position and orientation
  if(!attributes.findFirst('POSITION').set() or !coreObject.objectType() eq 'POSITION') then
    !direction    = !this.rotationLine.direction()

    -- Get positions
    if(!coreObject.objectType() eq 'POSITION') then
      !position   = !coreObject
    else
      !position     = !coreObject.position
    endif

    !cPosition    = !this.rotationLine.near(!position)

    -- Offset
    !distance     = !cPosition.distance(!position)

    -- If the cPosition is coincident with the position then need
    -- no need to translate the position
    if(!distance gt 0) then

      -- Define reference plane that is through the rotation line and the position
      !xDirection  = !cPosition.direction(!position)
      !plane       = object PLANE(!cPosition, object ORIENTATION('Z is ' & !direction & ' and X is ' & !xDirection))

      !newPosition = !plane.threeDPosition(object XYPOSITION(cos(!angle) * !distance, sin(!angle) * !distance))
      -- Rotate
      if(!coreObject.objectType() eq 'POSITION') then
        !return.position = !newPosition
      else
        !return.position(!newPosition)
      endif

    else
      !pointVector = object POINTVECTOR(!cPosition, !direction)
      !plane       = !pointVector.plane()
    endif

    -- Re-orientate
    if(!attributes.findFirst('ORIENTATION').set()) then

      -- Rotate PLANE about its z axes
      !newXPosition = !plane.threeDPosition(object XYPOSITION(cos(!angle) * 100mm, sin(!angle) * 100mm))

      -- Derive the new orientation
      !xDirection   = !coreObject.orientation.xDir()
      !yDirection   = !coreObject.orientation.yDir()

      -- Get unit vector of X
      !unitX        = !plane.position.offset(!xDirection, 100mm)
      !unitY        = !plane.position.offset(!yDirection, 100mm)

      !xyOffsetX    = !plane.xyOffset(!unitX)
      !zOffsetX     = !unitX.distance(!plane.near(!unitX))

      !xyOffsetY    = !plane.xyOffset(!unitY)
      !zOffsetY     = !unitY.distance(!plane.near(!unitY))

      -- Determine if z offset is +ve or -ve
      if(!this.rotationLine.near(!unitX).distance(!plane.position) gt 0) then
        if(int(!direction.angle(!plane.position.direction(!this.rotationLine.near(!unitX)))) ne 0) then
          !zOffsetX   = !zOffsetX * -1
        endif
      endif

      if(!this.rotationLine.near(!unitY).distance(!plane.position) gt 0) then
        if(int(!plane.direction().angle(!plane.position.direction(!this.rotationLine.near(!unitY)))) ne 0) then
          !zOffsetY   = !zOffsetY * -1
        endif
      endif

      -- Re-orientate the plane
      !plane.orientation  = object ORIENTATION('Z is ' & !direction & ' and X is ' & !plane.position.direction(!newXPosition))

      -- Re-calculate the position of the XY axes
      !unitX        = !plane.threeDPosition(!xyOffsetX).offset(!direction, !zOffsetX)
      !unitY        = !plane.threeDPosition(!xyOffsetY).offset(!direction, !zOffsetY)

      !return.orientation(object ORIENTATION('X is ' & !plane.position.direction(!unitX) & ' and Y is ' & !plane.position.direction(!unitY)))

    endif

  -- Rotate lines
  elseif (!coreObject.objectType() eq 'LINE') then

    -- Get positions
    !start          = !coreObject.startPosition
    !end            = !coreObject.endPosition

    !cPositionA     = !this.rotationLine.near(!start)
    !pPositionA     = !cPositionA
     if(!cPositionA.distance(!start) eq 0) then
      !start        = !coreObject.proportion(0.5)
      !cPositionA   = !this.rotationLine.near(!start)
    endif

    !cPositionB     = !this.rotationLine.near(!end)
    !pPositionB     = !cPositionB
    if(!cPositionB.distance(!end) eq 0) then
      !end          = !coreObject.proportion(0.5)
      !cPositionB   = !this.rotationLine.near(!end)
    endif

    -- Define reference plane that is through the rotation line and the position
    !xDirectionA  = !cPositionA.direction(!start)
    !xDirectionB  = !cPositionB.direction(!end)

    !planeA       = object PLANE(!pPositionA, object ORIENTATION('Z is ' & !this.rotationLine.direction() & ' and X is ' & !xDirectionA))
    !planeB       = object PLANE(!pPositionB, object ORIENTATION('Z is ' & !this.rotationLine.direction() & ' and X is ' & !xDirectionB))

    -- Offset
    !distanceA    = !pPositionA.distance(!coreObject.startPosition)
    !distanceB    = !pPositionB.distance(!coreObject.endPosition)

    -- Rotate
    !newStart     = !planeA.threeDPosition(object XYPOSITION(cos(!angle) * !distanceA, sin(!angle) * !distanceA))
    !newEnd       = !planeB.threeDPosition(object XYPOSITION(cos(!angle) * !distanceB, sin(!angle) * !distanceB))
    !return.line  = !newStart.line(!newEnd)

  -- Unable to handle aid graphics
  else

  endif

  -- Return
  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotate
--
-- Description: Rotate selected aids
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Angle of rotation
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotate(!angle is REAL)

  -- Initialise Variables
  !this.angle  = !angle
  !this.rotate = true
  !this.offset = false
  !this.mirror = false

  -- Rotate defined graphical aids
  do !i indices !this.aidList
    !this.graphicsList[!i] = !this.rotate(!!aidNumbers.get(!this.aidList[!i]))
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotationLine
--
-- Description: Set rotation line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POINTVECTOR Rotation line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotationLine (!pointVector is POINTVECTOR)

  -- Set rotation line
  !this.rotationLine(!pointVector.line(2000mm))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      rotationLine
--
-- Description: Set rotation line
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE        Rotation line
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rotationLine (!line is LINE)

  -- Initialise Variables
  !this.rotationLine = !line

  -- Set reference plane
  !this.plane        = !line.plane()

  -- Update aids
  !this.rotate(!this.angle)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: Set mirror
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirror()

  -- Initialise Variables
  !this.rotate = false
  !this.offset = false
  !this.mirror = true

  -- Mirror defined graphical aids
  do !i indices !this.aidList
    !this.graphicsList[!i] = !this.mirror(!!aidNumbers.get(!this.aidList[!i]))
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirror
--
-- Description: Mirror passed aids about plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Aid to mirror
-- Return:
--   [Data Type] [Description]
--    ANY         New aid definition
--
------------------------------------------------------------------------

define method .mirror(!aid is ANY) is ANY

  -- Initialise Variables
  !return        = !aid

  -- Get core object
  !coreObject    = !aid.coreObject()
  !attributes    = !coreObject.attributes()

  -- Rotate aid graphics with position and orientation
  if(!attributes.findFirst('POSITION').set() or !coreObject.objectType() eq 'POSITION') then

    !direction     = !this.mirrorPlane.direction()

    -- Get positions
    if(!coreObject.objectType() eq 'POSITION') then
      !position    = !coreObject
    else
      !position    = !coreObject.position
    endif
    !newPosition   = !position

    !pPosition     = !this.mirrorPlane.near(!position)

    -- Offset
    !distance      = !pPosition.distance(!position)

    -- If the pPosition is coincident with the position then need
    -- no need to translate the position
    if(!distance gt 0) then

      -- Direction from plane position to position
      !direction   = !pPosition.direction(!position)

      -- Offset position in opposite direction
      !newPosition = !pPosition.offset(!direction.opposite(), !distance)
      !return.position(!newPosition)

    endif

    -- Re-orientate
    if(!attributes.findFirst('ORIENTATION').set()) then

      -- Derive the new orientation
      !xDirection   = !coreObject.orientation.xDir()
      !yDirection   = !coreObject.orientation.yDir()

      -- Get unit vectors
      !unitX        = !position.offset(!xDirection, 100mm)
      !unitY        = !position.offset(!yDirection, 100mm)

      -- Get XY offsets from plane
      !pPositionX   = !this.mirrorPlane.near(!unitX)
      !pPositionY   = !this.mirrorPlane.near(!unitY)

      -- Get distance from plane
      !xDistance    = !pPositionX.distance(!unitX)
      !yDistance    = !pPositionY.distance(!unitY)

      -- Re-calculate X
      if(!xDistance gt 0) then
        !unitX      = !pPositionX.offset(!unitX.direction(!pPositionX), !xDistance)
      endif
      -- Re-calculate Y
      if(!yDistance gt 0) then
        !unitY      = !pPositionY.offset(!unitY.direction(!pPositionY), !yDistance)
      endif

      !orientation  = object ORIENTATION('X is ' & !newPosition.direction(!unitX) & ' and Y is ' & !newPosition.direction(!unitY))

      !return.orientation(!orientation)

    endif

  -- Rotate lines
  elseif (!coreObject.objectType() eq 'LINE') then

    -- Get positions
    !start          = !coreObject.startPosition
    !end            = !coreObject.endPosition
    !pPositionA     = !this.mirrorPlane.near(!start)
    !pPositionB     = !this.mirrorPlane.near(!end)

    -- Offset
    !distanceA      = !pPositionA.distance(!start)
    !distanceB      = !pPositionB.distance(!end)

    -- If distance from start to plane is > 0 then re-position
    if(!distanceA gt 0) then

      -- Get direction
      !xDirectionA  = !pPositionA.direction(!start)

      -- Offset position in opposite direction
      !start        = !pPositionA.offset(!xDirectionA.opposite(), !distanceA)

    endif

    -- If distance from end to plane is > 0 then re-position
    if(!distanceB gt 0) then

      -- Get direction
      !xDirectionB  = !pPositionB.direction(!end)

      -- Offset position in opposite direction
      !end          = !pPositionB.offset(!xDirectionB.opposite(), !distanceB)

    endif

    !return.line  = !start.line(!end)

  -- Unable to handle aid graphics
  else

  endif

  -- Return
  return !return

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mirrorPlane
--
-- Description: Set mirror plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      PLANE       Mirror plane
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mirrorPlane(!plane is PLANE)

  -- Set mirror plane
  !this.mirrorPlane = !plane

  -- Setup form mirror
  !this.mirror()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Set offset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset()

  -- Initialise Variables
  !this.rotate = false
  !this.offset = true
  !this.mirror = false

  -- Offset defined graphical aids
  do !i indices !this.aidList
    !this.graphicsList[!i] = !this.offset(!!aidNumbers.get(!this.aidList[!i]))
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Set offset by position
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    Offset defined as a relative position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!position is POSITION)

  -- Set offset position
  !this.offsetXYZ          = !position

  -- Reference position
  !this.offsetOrigin       = !position
  !this.offsetOrigin.east  = 0
  !this.offsetOrigin.north = 0
  !this.offsetOrigin.up    = 0

  -- Offset distance
  !this.offsetDistance     = !this.offsetOrigin.distance(!position)

  -- If there is no distance between the two points, then use U
  if(!this.offsetDistance eq 0) then
    !this.offsetDirection  = object DIRECTION('U wrt ' & !position.origin)
  else
    !this.offsetDirection  = !this.offsetOrigin.direction(!position).wrt(!position.origin)
  endif

  -- Setup form mirror
  !this.offset()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Set offset by distance and direction
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Offset distance
--    2   R      DIRECTION   Offset direction
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .offset(!distance is REAL, !direction is DIRECTION)

  -- Set offset distance and direction
  !this.offsetDistance      = !distance
  !this.offsetDirection     = !direction

  -- Set position
  !this.offsetOrigin        = N0
  !this.offsetOrigin.origin = !direction.origin
  !this.offsetXYZ           = !this.offsetOrigin.offset(!direction, !distance)

  -- Setup form mirror
  !this.offset()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      offset
--
-- Description: Offset passed aids about plane
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Aid to offset
-- Return:
--   [Data Type] [Description]
--    ANY         New aid definition
--
------------------------------------------------------------------------

define method .offset(!aid is ANY) is ANY

  -- Initialise Variables
  !return        = !aid

  -- Get position
  !position      = !aid.position()

  -- Offset position
  !position      = !position.offset(!this.offsetDirection, !this.offsetDistance)

  -- Define return
  !return.position(!position)

  -- Return
  return !return

endmethod
-- End of method
