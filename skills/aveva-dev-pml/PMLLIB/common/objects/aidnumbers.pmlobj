--
-- File:            aidnumbers.pmlobj
--   Type:          Object Definition
--   Group:         Aid element handlers
--     Keyword:     AID
--   Module:        common
--   Replaces:
--
-- Author:          N.Holmes
-- Created:         Tue Dec 16 17:15:17 WAT 1997
--
--
-- Description:
-- Aid list object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(ANY)                         REAL                Add  data to list (create overloaded methods)
--  addNumber(REAL,ANY)              -                   Add number and data to list
--  aidNumbers()                     -                   Constructor
--  default()                        -                   Populate numbers list with pre-defined aid numbers, i.e. ones used by applications that don't use the new system.
--  draw(REAL)                       -                   Draw an entry
--  get(REAL)                        ANY                 Return entry from list
--  globalInstance()                 -                   Create Global variable of object
--  hide(REAL)                       -                   Remove aid graphics, but not definition
--  isRegistered(REAL)               BOOLEAN             Checks if the passed aid number is registered in the system, if it is not, returns false and error in !!error.text
--  next()                           REAL                Get next free entry
--  registered(REAL)                 -                   Checks if the passed aid number is registered in the system, if it is not, then an error is forced
--  remove(REAL)                     -                   Remove data to list
--  replace(REAL,ANY)                -                   Replace entry with new data
--  replaceNoUpdate(REAL,ANY)        -                   Replace entry with new data, without updating the graphics
--
------------------------------------------------------------------------

-- Define object
define object AIDNUMBERS

  -- Start Number for Aid numbers (constant)
  member .start      is REAL

  -- Aid numbers current used and object associated with
  member .numbers    is ARRAY

endobject
-- End of object definition for AIDNUMBERS

------------------------------------------------------------------------
--
-- Method:      aidNumbers
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .aidNumbers()

  -- Start
  !this.start = 10000

endmethod
-- End of method definition for .aidNumbers()

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create Global variable of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!aidNumbers   = !this

  -- load object
  !!aidNumbers.default()

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      registered
--
-- Description: Checks if the passed aid number is registered in the system, if it is not, then an error is forced
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .registered(!number is REAL)

  -- Check graphic aid has been registered
  if(!this.isRegistered(!number).not()) then
    !!alert.error('Graphic aid is not registered in the system.')
    return error 1 noalert
  endif

endmethod
-- End of method definition for .registered(REAL)

------------------------------------------------------------------------
--
-- Method:      isRegistered
--
-- Description: Checks if the passed aid number is registered in the system, if it is not, returns false and error in !!error.text
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is it exists
--
------------------------------------------------------------------------

-- Define method
define method .isRegistered(!number is REAL) is BOOLEAN

  -- Check graphic aid has been registered
  if(undefined(!this.numbers[!number])) then
    !!error.text = 'Graphic aid is not registered in the system.'
    return false
  else
    return true
  endif

endmethod
-- End of method definition for .isRegistered(REAL) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      default
--
-- Description: Populate numbers list with pre-defined aid numbers, i.e. ones used by applications that don't use the new system.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .default()

  -- Empty Current List
  !this.numbers.clear()

  -- AID Graphic Numbers for Design Applications
