endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method:      addNumber
--
-- Description: Add number and data to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number to be set
--    2   R      ANY         Data to be added
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .addNumber(!number is REAL, !data is ANY)

  -- Assign number
  !this.numbers[!number] = !data

endmethod
-- End of method definition for .addNumber(REAL, ANY)

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description:  Add  data to list (create overloaded methods)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Data to be added
-- Return:
--   [Data Type] [Description]
--    REAL        Aid number to be set
--
------------------------------------------------------------------------

-- Define method
define method .add(!data is ANY) is REAL

  -- Get next free entry
  !newNumber = !this.next()

  -- Add entry to list
  !this.numbers[!newNumber] = !data

  -- Draw only valid items
  if(!data.set()) then
    if !this.numbers[!newnumber].objectType().neq('STRING') then
      !this.numbers[!newNumber].draw(!newNumber)
      handle any
      endhandle
    endif
  endif

  -- Return aid number selected
  return !newNumber

endmethod
-- End of method definition for .add(ANY) REAL

------------------------------------------------------------------------
--
-- Method:      next
--
-- Description: Get next free entry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Aid number to be set
--
------------------------------------------------------------------------

-- Define method
define method .next() is REAL

  -- Get next free number
  do !i from !this.start
    if(undefined(!this.numbers[!i])) then
      return !i
    endif
  enddo

endmethod
-- End of method definition for .next() REAL

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove data to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number to be set
-- Return:
--   [Data Type] [Description]
--    REAL        Aid number to be set
--
------------------------------------------------------------------------

-- Define method
define method .remove(!number is REAL)

  -- Return if no number passed
  if(!number.unset()) then
    return
  endif

  -- Remove entry
  !this.numbers[!number].delete()
  handle any
  endhandle

  -- Remove all aid graphics
  !this.hide(!number)

endmethod
-- End of method definition for .remove(REAL)

------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description: Replace entry with new data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Entry to be replace
--    2   R      ANY         Data to replace
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .replace(!entry is REAL, !data is ANY)

  -- Replace definition
  !this.replaceNoUpdate(!entry, !data)

  -- Draw only valid items
  if(!data.set()) then
    !this.numbers[!entry].draw(!entry)
    handle any
    endhandle
  endif

endmethod
-- End of method definition for .replace(REAL, ANY)

------------------------------------------------------------------------
--
-- Method:      replaceNoUpdate
--
-- Description: Replace entry with new data, without updating the graphics
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Entry to be replace
--    2   R      ANY         Data to replace
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .replaceNoUpdate(!entry is REAL, !data is ANY)

  -- Remove previous definition
  !this.hide(!entry)

  -- Replace entry
  if(!data.objectType() ne !this.numbers[!entry].objectType()) then
    !this.numbers[!entry].delete()
    handle any
    endhandle
  endif
  !this.numbers[!entry] = !data

endmethod
-- End of method definition for .replaceNoUpdate(REAL, ANY)

------------------------------------------------------------------------
--
-- Method:      get
--
-- Description: Return entry from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Entry to be replace
-- Return:
--   [Data Type] [Description]
--    ANY         Data in entry
--
------------------------------------------------------------------------

-- Define method
define method .get(!entry is REAL) is ANY

  -- Return entry
  if(!this.numbers[!entry].set()) then
    return !this.numbers[!entry]
  else
    return STRING()
  endif

endmethod
-- End of method definition for .get(REAL) ANY

------------------------------------------------------------------------
--
-- Method:      draw
--
-- Description: Draw an entry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Entry to be drawn
-- Return:
--
------------------------------------------------------------------------

-- Define method
define method .draw(!entry is REAL)

  -- Initialise Variables
  !this.numbers[!entry].draw(!entry)
  handle any
  endhandle

endmethod
-- End of method definition for .draw(REAL)

------------------------------------------------------------------------
--
-- Method:      hide
--
-- Description: Remove aid graphics, but not definition
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .hide(!number is REAL)

  -- Remove aid items associated with number
  AID CLEAR LINE $!number
  handle any
  endhandle
  AID CLEAR TEXT $!number
  handle any
  endhandle
  AID CLEAR SPHERE $!number
  handle any
  endhandle
  AID CLEAR CYLI $!number
  handle any
  endhandle
  AID CLEAR BOX $!number
  handle any
  endhandle
  AID CLEAR ARROW $!number
  handle any
  endhandle
  AID CLEAR ARC $!number
  handle any
  endhandle

endmethod
-- End of method definition for .hide(REAL)
