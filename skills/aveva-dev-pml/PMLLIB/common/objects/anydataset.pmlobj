--
-- File:            anydataset.pmlobj
--   Type:          Object Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        ALL
--   Replaces:
--
-- Author:          Karel Pleschner
-- Created:         Mon Mar 10 15:58:00 GMT 2008
--
-- Description:     Container of flexible set of attributes of any kind
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  anyDataSet(STRING)               -                   default constructor
--  attrIndex(STRING)                REAL                return attribute internal index
--  attributeExists(STRING)          BOOLEAN             check if attribute of passed name exists
--  copyAttributesTo(ANY)            -                   set members of passed object with values of matching attributes
--  getAttribute(STRING)             ANY                 return attribute value from object
--  qatt()                           -                   print out all attributes with their values
--  remAttribute(STRING)             -                   remove attribute from object
--  setAttribute(ARRAY,ARRAY)        -                   add/modify array of attributes
--  setAttribute(STRING,ANY)         -                   add attribute to the object or modify the existing
--  string()                         STRING              convert object to string (description is used)
--
define object ANYDATASET

  member .description is STRING
  member .name        is ARRAY
  member .value       is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      anyDataSet
--
-- Description: default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
--    1   R      STRING           Object description
--
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------

define method .anyDataSet(!desc is STRING)

  !this.description = !desc
  !this.name.clear()
  !this.value.clear()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      string
--
-- Description: convert object to string (description is used)
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      Object description
--
------------------------------------------------------------------------

define method .string() is STRING

  return !this.description

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      remAttribute
--
-- Description: remove attribute from object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      attribute name
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remAttribute(!name is STRING)

  !index = !this.attrIndex(!name)

  !this.name.remove(!index)
  handle ANY
  endhandle
  !this.value.remove(!index)
  handle ANY
  endhandle

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      setAttribute
--
-- Description: add attribute to the object or modify the existing
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      attribute name
--    2   R      ANY         attribute value
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAttribute(!name is STRING, !value is ANY)

  !index = !this.attrIndex(!name)
  if !index.unset() then
    !this.name.append(!name)
    !this.value.append(!value)
  else
    !this.value[!index] = !value
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setAttribute
--
-- Description: add/modify array of attributes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      attribute name
--    2   R      ANY         attribute value
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAttribute(!name is ARRAY, !value is ARRAY)

  do !c indices !name
    !this.setAttribute(!name[!c],!value[!c])
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getAttribute
--
-- Description: return attribute value from object
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      attribute name
--
-- Return:
--   [Data Type] [Description]
--    ANY         attribute value
--
------------------------------------------------------------------------

define method .getAttribute(!name is STRING) is ANY

  !index = !this.attrIndex(!name)

  return !this.value[!index]

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      attrIndex
--
-- Description: return attribute internal index
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      attribute name
--
-- Return:
--   [Data Type] [Description]
--    REAL        attribute index
--
------------------------------------------------------------------------

define method .attrIndex(!name is STRING) is REAL

  !index = !this.name.findfirst(!name)

  return !index

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      attributeExists
--
-- Description: check if attribute of passed name exists
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      attribute name
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     logical result
--
------------------------------------------------------------------------

define method .attributeExists(!name is STRING) is BOOLEAN

  return !this.attrIndex(!name).set()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      copyAttributesTo
--
-- Description: set members of passed object with values of matching attributes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         passed object
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyAttributesTo(!anyObj is ANY)

  do !c indices !this.name
    !name = !this.name[!c].upcase()
    !anyObj.attribute(!name) = !this.value[!c]
    handle ANY
    endhandle
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      qatt
--
-- Description: print out all attributes with their values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .qatt()

  do !c indices !this.name
    write '$!this.name[$!c] $!this.value[$!c]'
  enddo

endmethod
-- End of method
