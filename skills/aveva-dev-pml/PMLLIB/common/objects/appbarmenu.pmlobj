--
-- File:            appbarmenu.pmlobj
--   Type:          Object Definition
--   Group:         Application Switching
--     Keyword:     APP
--   Module:        common
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Tue Feb 10 18:06:09 2004
--
--
-- Description:     controls visibility of bar menus between applications
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activate(BOOLEAN)                -                   activates bar menus registered in this object
--  add(STRING,STRING)               -                   add menu menuName to bar with text description dtext
--  addMenuName(STRING)              -                   add menu with given name to list
--  appBarMenu()                     -                   Constructor method
--  empty()                          BOOLEAN             returns true if the bar menu has had no items added
--  insertAfter(STRING,STRING,STRING) -                   insert new menu after given item
--  insertBefore(STRING,STRING,STRING) -                   insert new menu before given item
--  remove(STRING)                   -                   removes given menu from the menu bar
--
------------------------------------------------------------------------
define object APPBARMENU
  -- array containing unique menu names
  member .menuNames is ARRAY

  -- array containing names of menus to remove
  member .removeMenuNames is ARRAY

  -- bar menu on main form that this object corresponds to
  member .menu is GADGET

  -- property of menu fields that we want to manipulate
  member .property is STRING
endobject
-- End of object definition for APPBARMENU

------------------------------------------------------------------------
--
-- Method:      .appBarMenu()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appBarMenu()
  !this.menu = !!appCntrl.mainForm.bar

  !this.property = 'VISIBLE'
endmethod
-- End of method definition for .appBarMenu()

------------------------------------------------------------------------
--
-- Method:      .insertBefore()
--
-- Description: insert new menu before given item
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      STRING
--    3   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertBefore(!item is STRING, !dtext is STRING, !menuName is STRING)
  !this.menu.insertBefore(!item, !dtext, !menuName)
  handle (61,566)
    -- menu with that name already exists
  endhandle
  !this.menu.setFieldProperty(!menuName, !this.property, false)
  !this.addMenuName(!menuName)
endmethod
-- End of method definition for .insertBefore(STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .insertAfter()
--
-- Description: insert new menu after given item
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      STRING
--    3   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insertAfter(!item is STRING, !dtext is STRING, !menuName is STRING)
  !this.menu.insertAfter(!item, !dtext, !menuName)
  handle (61,566)
    -- menu with that name already exists
  endhandle
  !this.menu.setFieldProperty(!menuName, !this.property, false)
  !this.addMenuName(!menuName)
endmethod
-- End of method definition for .insertAfter(STRING, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .add()
--
-- Description: add menu menuName to bar with text description dtext
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add(!dtext is STRING, !menuName is STRING)
  -- see if HELP or WINDOW menus exist on bar
  -- if WINDOW exists, insert before that
  -- otherwise if HELP exists, insert before that
  -- otherwise just add to the end
  !this.menu.insertBefore('window', !dtext, !menuName)
  handle (61,566)
    -- (61,566)  F&M: Gadget, Menu, Variable or Property name already exists on form
    -- menu with that name already exists: do nothing
  elsehandle (61,558)
    -- (61,558)  F&M: Cannot find requested field window
    !this.menu.insertBefore('help', !dtext, !menuName)
    handle (61,566)
      -- (61,566)  F&M: Gadget, Menu, Variable or Property name already exists on form
      -- menu with that name already exists: do nothing
    elsehandle (61,558)
      -- (61,558)  F&M: Cannot find requested field help
      !this.menu.add(!dtext, !menuName)
    endhandle
  endhandle
  !this.menu.setFieldProperty(!menuName, !this.property, false)
  !this.addMenuName(!menuName)
endmethod
-- End of method definition for .add(STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      .remove()
--
-- Description: removes given menu from the menu bar
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remove(!menuName is STRING)
  !pos = !this.removeMenuNames.findFirst(!menuName.upcase())
  if (!pos.unset()) then
    !this.removeMenuNames.append(!menuName.upcase())
  endif
endmethod
-- End of method definition for .remove(STRING)

------------------------------------------------------------------------
--
-- Method:      .addMenuName()
--
-- Description: add menu with given name to list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addMenuName(!menuName is STRING)
  -- find out if a menu item with this name already been created
  !pos = !this.menuNames.findFirst(!menuName.upcase())
  if (!pos.unset()) then
    !this.menuNames.append(!menuName.upcase())
  endif
endmethod
-- End of method definition for .addMenuName(STRING)

------------------------------------------------------------------------
--
-- Method:      .activate()
--
-- Description: activates bar menus registered in this object
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .activate(!active is BOOLEAN)
  -- if we're deactivating, activate the fields this object has removed from it
  if (!active.not()) then
    do !menuName values !this.removeMenuNames
      !this.menu.setFieldProperty(!menuName, !this.property, true)
    enddo
  endif

  do !menuName values !this.menuNames
    !this.menu.setFieldProperty(!menuName, !this.property, !active)
  enddo

  -- if we're activating this menu, make sure all entries that should be hidden are hidden
  if (!active) then
    do !menuName values !this.removeMenuNames
      !this.menu.setFieldProperty(!menuName, !this.property, false)
    enddo
  endif
endmethod
-- End of method definition for .activate(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .empty()
--
-- Description: returns true if the bar menu has had no items added
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   BOOLEAN
--
------------------------------------------------------------------------
define method .empty() is BOOLEAN
  return (!this.menuNames.empty() and !this.removeMenuNames.empty())
endmethod
-- End of method definition for .empty() BOOLEAN
