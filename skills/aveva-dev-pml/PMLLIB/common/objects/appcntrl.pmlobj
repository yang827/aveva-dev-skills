-- File:            appcntrl.pmlobj
--   Type:          Object Definition
--   Group:         Application Switching
--     Keyword:     APP
--   Module:        common
--   Replaces:
--
-- Author:          Jamie Brunning
-- Created:         Thu Jan 29 15:28:41 2004
--
--
-- Description:     controls application switching
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addApplic(APPDEFN)               -                   add a new APPDEFINITION object as long as it is not already in list
--  appCntrl()                       -                   Constructor method
--  appLoaded()                      -                   run when new application has been loaded
--  appMenu(MENU,STRING)             -                   construct Applications menu
--  appMenu(MENU,STRING,BOOLEAN)     -                   construct Applications menu
--  assignStartupCalls()             -                   assign functions called when applications start for the first time
--  assignSwitchCalls()              -                   assign functions called when we switch to applications
--  clearLoadedFlags()               -                   sets loaded flag of all applications to false
--  currentApp()                     STRING              get current application
--  currentAppObj()                  APPDEFN             return APPDEFN object for current application
--  executeModuleStartupCalls()      -                   runs all the calls specified for when the module starts up
--  executeStartupCalls(STRING)      -                   execute callbacks when application starts
--  findApplic(STRING)               BOOLEAN             check if given application is present
--  getApplic(STRING)                APPDEFN             get the application object with given name
--  getApplicIndex(STRING)           REAL                get position of given application in array
--  initialiseForm(STRING)           -                   runs form initialisation for given application
--  isAdmin()                        BOOLEAN             is current application administrative?
--  isAdmin(STRING)                  BOOLEAN             return admin status of given application
--  loadApplicationState()           STRING              load application state from file
--  loaded(STRING)                   BOOLEAN             checks if application with name given by appName has been loaded
--  loadingApp()                     -                   get the name of the currently loading application
--  loadingApp(STRING)               -                   set the name of the currently loading application
--  modifyForm()                     -                   modifies the form when everything is being built
--  modifyMenus()                    -                   modifies menus for this application
--  saveApplicationState()           -                   save application state to file on exit
--  setLoadedFlag(STRING,BOOLEAN)    -                   set loaded flag of given application
--  setMainForm()                    -                   assigns the main form to the .mainForm member
--  sortApps(ARRAY)                  -                   sort applications into required order
--  synonyms()                       -                   sets synonyms for applications
--  synonyms(STRING)                 -                   sets synonyms for applications
--
------------------------------------------------------------------------
define object APPCNTRL

  -- array of APPDEFINITION objects
  member .apps          is ARRAY

  -- array of names of applications
  member .names         is ARRAY

  -- name of app currently being loaded
  member .loadingApp    is STRING

  -- name of current application
  member .currentApp    is STRING
  member .currentSpec   is STRING

  -- name of main form for application
  member .mainFormName  is STRING
  -- reference to main form
  member .mainForm      is FORM
  -- name of menu containing entries for applications
  member .menuName      is STRING
  -- title of main form
  member .formTitle     is STRING

  -- name of current module
  member .module        is STRING

  -- Application and Module key
  member .appKey        is STRING
  member .modKey        is STRING

  -- name of current project
  member .project       is STRING

  -- options associated with application switching/serialisation
  member .options       is APPOPTIONS

endobject
-- End of object definition for APPCNTRL


------------------------------------------------------------------------
--
-- Method:      .appCntrl()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appCntrl()
  -- make sure arrays are empty
  !this.apps.clear()
  !this.names.clear()

  -- set current application
  !this.currentApp  = 'GEN'

  -- Project Code
  !project=current project
  !projectCode = !project.code().upcase()
  --!projectId   = !project.id()
  !customId = |'| + !projectCode + |000ID| + |'|
  var !projectId evar $!customId
  if (!projectId.set()) then
    !projectCode = !projectId
  endif

  -- get module
  !module           = !!module()
  !this.modKey      = !module.modKey.upcase()
  !this.appKey      = !module.appKey.upcase()
  !this.module      = !module.appKey

  -- Default form title
  !this.formTitle     = !module.dText & ' - AVEVA ' & !module.productGroup

  -- set name of main form according to module
  if (!this.modKey eq 'DES') then
    !this.mainFormName  = 'appDesMain'
    !this.formTitle     = !module.dText & ' - APPTITLE Application - ' & ' AVEVA ' & !module.productGroup
    !this.menuName      = 'sysDes'
  elseif (!this.modKey eq 'DRA') then
    !this.mainFormName  = 'appDraMain'
    !this.formTitle     = !module.dText & ' - APPTITLE - ' & ' AVEVA ' & !module.productGroup
    !this.menuName      = 'mbDraft'
  elseif (!this.modKey eq 'CAT') then
    !this.mainFormName  = 'appCatMain'
    !this.formTitle     = !module.dText & ' - APPTITLE Application - ' & ' AVEVA ' & !module.productGroup
    !this.menuName      = 'sysCat'
  elseif (!this.modKey eq 'SPL') then
    !this.mainFormName  = 'spooler'
    !this.menuName      = 'spooler'
  elseif (!this.modKey eq 'MON') then
    !this.mainFormName  = 'Monitor'
    !this.menuName      = 'Monitor'
  elseif (!this.modKey eq 'ADM') then
    !this.mainFormName  = 'Admin1'
    !this.menuName      = 'Admin'
  elseif (!this.modKey eq 'LEX') then
    !this.mainFormName  = 'Lexicon'
    !this.menuName      = 'Lexicon'
  elseif (!this.modKey eq 'MARHDES') then
    !this.mainFormName  = 'appMarMain'
    !this.formTitle     = !module.dText & ' - APPTITLE - ' & ' AVEVA ' & !module.productGroup
    !this.menuName      = 'sysDes'
  elseif (!this.modKey eq 'MARDRA') then
    !this.mainFormName  = 'appMDraMain'
	-- Don't change the form title in mardra
    $*!this.formTitle     = !module.dText & ' - APPTITLE - ' & ' AVEVA ' & !module.productGroup
    !this.menuName      = 'mbDraft'
  elseif (!this.modKey eq 'MARODES') then
    !this.mainFormName  = 'appDesMain'
    !this.formTitle     = !module.dText & ' - APPTITLE - ' & ' AVEVA ' & !module.productGroup
    !this.menuName      = 'sysDes'
  elseif (!this.modKey eq 'MARODRA') then
    !this.mainFormName  = 'appDraMain'
    !this.formTitle     = !module.dText & ' - APPTITLE - ' & ' AVEVA ' & !module.productGroup
    !this.menuName      = 'mbDraft'
  elseif (!this.modKey eq 'DIAGRAMS') then
    !this.mainFormName  = 'appDiagMain'
    !this.formTitle     = !module.dText & ' - APPTITLE - ' & ' AVEVA ' & !module.productGroup
    !this.menuName      = 'sysDes'

  endif

  -- Add project
  !this.formTitle       = !this.formTitle & ' (Project - ' & !projectCode & ')'

  -- get current project
  !project = CURRENT PROJECT
  !this.project = !project.code().upcase()

  -- initialise form controlling object
  if (defined(!!appFormCntrl)) then
    -- delete object in case it's already been defined in another module
    !!appFormCntrl.delete()
  endif

  !!appFormCntrl = object APPFORMCNTRL(!this.appKey, !this.project)

  -- initialise toolbar control
  if (defined(!!appTbarCntrl)) then
    -- delete object in case it's been defined in another module
    !!appTbarCntrl.delete()
  endif
  !!appTbarCntrl = object APPTBARCNTRL(!this.appKey, !this.project)

  -- initialise menu control
  if (defined(!!appMenuCntrl)) then
    !!appMenuCntrl.delete()
  endif
  !!appMenuCntrl = object APPMENUCNTRL()

endmethod
-- End of method definition for .appCntrl()

------------------------------------------------------------------------
--
-- Method:      .addApplic()
--
-- Description: add a new APPDEFN object as long as it is not already in list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      APPDEFN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addApplic(!newApp is APPDEFN)
  if (!this.findApplic(!newApp.name).not()) then
    !this.apps.append(!newApp)
    !this.names.append(!newApp.name)
  endif
endmethod
-- End of method definition for .addApplic(APPDEFN)

------------------------------------------------------------------------
--
-- Method:      .findApplic()
--
-- Description: check if given application is present
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--   BOOLEAN
--
------------------------------------------------------------------------
define method .findApplic(!appName is STRING) is BOOLEAN
  if (!this.names.findFirst(!appName.upcase()).set()) then
    return true
  endif
  return false
endmethod
-- End of method definition for .findApplic(STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      .getApplic()
--
-- Description: get the application object with given name
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--   APPDEFN
--
------------------------------------------------------------------------
define method .getApplic(!appName is STRING) is APPDEFN
  !pos = !this.names.findFirst(!appName.upcase())
  if (!pos.set()) then
    return !this.apps[!pos]
  endif
  -- return null application definition if nothing found
  return object APPDEFN()
endmethod
-- End of method definition for .getApplic(STRING) APPDEFN

------------------------------------------------------------------------
--
-- Method:      .getApplicIndex()
--
-- Description: get position of given application in array
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--   REAL
--
------------------------------------------------------------------------
define method .getApplicIndex(!appName is STRING) is REAL
  !pos = !this.names.findFirst(!appName)
  if (!pos.set()) then
    return !pos
  endif
  return 0
endmethod
-- End of method definition for .getApplicIndex(STRING) REAL

------------------------------------------------------------------------
--
-- Method:      .isAdmin()
--
-- Description: return admin status of given application
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--   BOOLEAN
--
------------------------------------------------------------------------
define method .isAdmin(!appName is STRING) is BOOLEAN
  !pos = !this.names.findFirst(!appName.upcase())
  if (!pos.set()) then
    return !this.apps[!pos].admin
  endif
  -- return false if not found
  return false
endmethod
-- End of method definition for .isAdmin(STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      .isAdmin()
--
-- Description: is current application administrative?
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   BOOLEAN
--
------------------------------------------------------------------------
define method .isAdmin() is BOOLEAN
  return !this.isAdmin(!this.currentApp)
endmethod
-- End of method definition for .isAdmin() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      .assignSwitchCalls()
--
-- Description: assign functions called when we switch to applications
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assignSwitchCalls()
  -- first assign the ISYSTEM macro as a switch call if it exists
  do !app values !this.apps
    if (!app.directory.set()) then
      !isystemFilename = '%PDMSUI%\' & !this.appKey & '\' & !app.directory & '\ISYSTEM'
      !isystemFile = object FILE(!isystemFilename)
      if (!isystemFile.exists()) then
        -- adding $!app.directory ISYSTEM file as switchCall
        !app.addSwitchCall('$M "' & !isystemFilename & '"')
      endif
    endif
  enddo

  do !i indices !this.names
    -- get application and the arrays containing other applications it modifies
    !app = !this.apps[!i]
    !modifies = !app.modifiesSwitch
    !modifyCalls = !app.modifySwitchCalls

    -- loop through each and assign the startup callbacks to the target objects
    do !j indices !modifies
      !modAppName = !modifies[!j].upcase()
      !modCall = !modifyCalls[!j]

      -- find index of application we want to modify
      !index = !this.names.findFirst(!modAppName)
      -- only add the callback if the required application is defined
      if (!index.set()) then
        -- add callback to its array
        !this.apps[!index].addSwitchCall(!modCall)
      endif
    enddo
  enddo
endmethod
-- End of method definition for .assignSwitchCalls()

------------------------------------------------------------------------
--
-- Method:      .assignStartupCalls()
--
-- Description: assign functions called when applications start for the first time
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .assignStartupCalls()
  -- first assign the INIT macro as a startup call if it exists
  do !app values !this.apps
    if (!app.directory.set()) then
      !initFilename = '%PDMSUI%\' & !this.appKey & '\' & !app.directory & '\INIT'
      !initFile = object FILE(!initFilename)
      if (!initFile.exists()) then
        -- add $!app.directory INIT file as startupCall
        !app.addStartupCall('$M "' & !initFilename & '"')
      endif
    endif
  enddo

  do !i indices !this.names
    -- get application and the arrays containing other applications it modifies
    !app = !this.apps[!i]
    !modifies = !app.modifiesStartup
    !modifyCalls = !app.modifyStartupCalls

    -- loop through each and assign the startup callbacks to the target objects
    do !j indices !modifies
      !modAppName = !modifies[!j].upcase()
      !modCall = !modifyCalls[!j]

      -- find index of application we want to modify
      !index = !this.names.findFirst(!modAppName)
      -- only add the callback if the required application is defined
      if (!index.set()) then
        -- add callback to its array
        !this.apps[!index].addStartupCall(!modCall)
      endif
    enddo
  enddo
endmethod
-- End of method definition for .assignStartupCalls()

------------------------------------------------------------------------
--
-- Method:      .appMenu()
--
-- Description: construct Applications menu
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        menu to which to add fields
--    2   R      STRING      format of callback
-- Return:
--   [Data Type] [Description]
--   ARRAY
--
------------------------------------------------------------------------
define method .appMenu(!menu is MENU, !callFormat is STRING)
  !this.appMenu(!menu, !callFormat, true)
endmethod
-- End of method definition for .appMenu(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      .appMenu()
--
-- Description: construct Applications menu
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        menu to which to add fields
--    2   R      STRING      format of callback
-- Return:
--   [Data Type] [Description]
--   ARRAY
--
------------------------------------------------------------------------
define method .appMenu(!menu is MENU, !callFormat is STRING, !showAdminApps is BOOLEAN)
  !form = !menu.owner()
  !submenus = ARRAY()
  do !i indices !this.apps
    !appName = !this.names[!i]
    !app = !this.apps[!i]

    -- skip if app is administrative and we're not showing them
    skip if (!app.admin and !showAdminApps.not())

    -- skip if app is not shown on menu
    skip if (!app.showOnMenu.not())

    -- !title = !app.title.replace('&', '&&')
    if (!app.menu.set()) then
      !title = !app.menu
    elseif (!app.title.set()) then
      !title = !app.title
    else
      -- skip if the title and menu entry are unset
      skip
    endif
    !callback = !callFormat.replace('MODULE', !this.appKey).replace('APPNAME', !app.name)

    -- find out if application appears in a group on the menu
    if (!app.groupNumber.set()) then
      !groupNumber = !app.groupNumber
      if (undefined(!submenus[!groupNumber])) then
        -- submenu has not already been created
        -- this is the first item from the group, add item to main menu and create new submenu
        !menu.add('MENU', !app.groupName, 'menu' & !app.groupNumber, 'appGroup' & !groupNumber)
        !submenu = !form.newMenu('menu' & !groupNumber)
        !submenus[!groupNumber] = true
      endif
      !submenu.add('CALLBACK', !title & '...', !callback, !app.name)
    else
      !menu.add('CALLBACK', !title & '...', !callback, !app.name)
    endif
  enddo

endmethod
-- End of method definition for .appMenu(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      .clearLoadedFlags()
--
-- Description: sets loaded flag of all applications to false
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearLoadedFlags()
  do !i indices !this.apps
    !this.apps[!i].loaded = false
  enddo
endmethod
-- End of method definition for .clearLoadedFlags()

------------------------------------------------------------------------
--
-- Method:      .setLoadedFlag()
--
-- Description: set loaded flag of given application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
--    2   R      BOOLEAN
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setLoadedFlag(!appName is STRING, !state is BOOLEAN)
  !pos = !this.getApplicIndex(!appName)
  if (!pos gt 0) then
    !this.apps[!pos].loaded = !state
  endif
endmethod
-- End of method definition for .setLoadedFlag(STRING, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .executeStartupCalls()
--
-- Description: execute callbacks when application starts
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .executeStartupCalls(!appName is STRING)
  !app = !this.getApplic('GEN')
  do !call values !app.startupCalls
    $!call
  enddo
endmethod
-- End of method definition for .executeStartupCalls(STRING)

------------------------------------------------------------------------
--
-- Method:      .sortApps()
--
-- Description: sort applications into required order
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sortApps(!order is ARRAY)
  !sortedIndices = ARRAY()
  !names = !this.names

  -- get the indices of the applications in order array
  do !o values !order
    !pos = !names.findFirst(!o)
    if (!pos.set()) then
      !sortedIndices.append(!pos)
      !names.deleteFrom(!pos, 1)
    endif
  enddo

  -- add the other apps to the end in alphabetical order
  !sortedIndices.appendArray(!names.sortedIndices())

  -- sort the names and applications in this object's members
  !this.names.reindex(!sortedIndices)
  !this.apps.reindex(!sortedIndices)
endmethod
-- End of method definition for .sortApps(ARRAY)

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: modifies the form when everything is being built
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  do !app values !this.apps
    !app.modifyForm()
  enddo
endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: modifies menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  do !app values !this.apps
    !app.modifyMenus()
  enddo
endmethod
-- End of method definition for .modifyMenus()

------------------------------------------------------------------------
--
-- Method:      .appLoaded()
--
-- Description: run when new application has been loaded
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appLoaded()
  --P-12263 Fix
  if !this.module eq ('des') then
    if !this.currentApp eq 'PIPE' then
      !this.currentSpec = !!appdesmain.pipespec.val
    endif
  endif


  -- set property we want to change
  !property = 'ACTIVE'

  !currentApp = !this.getApplic(!this.currentApp)
  !loadingApp = !this.getApplic(!this.loadingApp)

  -- reactivates menu item for outgoing application (if the two have the same .admin state)
  if (!currentApp.admin eq !loadingApp.admin) then
    if !currentApp.groupNumber.set() then
      !this.mainForm.attribute('menu' & !currentApp.groupNumber).setFieldProperty(!currentApp.name, !property, true)
    else
      !this.mainForm.attribute(!this.menuName).setFieldProperty(!currentApp.name, !property, true)
      handle (2,766)
        -- Does not return a result
      endhandle
    endif
  endif

  -- grey out menu item for current application
  if !loadingApp.groupNumber.set() then
    !this.mainForm.attribute('menu' & !loadingApp.groupNumber).setFieldProperty(!loadingApp.name, !property, false)
  else
    !this.mainForm.attribute(!this.menuName).setFieldProperty(!loadingApp.name, !property, false)
    handle (2,766)
      -- Does not return a result
    endhandle
  endif

  -- change title of form
  !title = !loadingApp.title
  if (!loadingApp.admin) then
    !title = !title & ' Administration'
  endif
  if (!this.modKey neq 'MARDRA') then
    !this.mainForm.formTitle = !this.formTitle.replace('APPTITLE', !title)
  endif

  -- set help file alias for new application
  !!fmsys.setHelpFileAlias(!loadingApp.helpAlias)
  handle (61, 702)(2,779)
    -- Invalid help alias
    -- !!error.text
    -- Does not return a result
  endhandle

  !this.currentApp = !this.loadingApp
  !this.loadingApp = STRING()
 --P-12263 Fix: Sets pspe for default spec.
  if !this.module eq ('des') then
    if !this.currentApp eq 'PIPE' then
      if !this.currentSpec.set() then
        !!cdpipe.pspe.val = !this.currentSpec
        !!cdbran.pspe.val = !this.currentSpec
        !!appdesmain.pipespec.val = !this.currentSpec
      else
        !defaultSpec = object specifications()
        !defaultSpec.piping()
        if (!defaultSpec.Names.Set()) then
	        !!cdpipe.pspe.val = !defaultSpec.Names[1]
	        !!cdbran.pspe.val = !defaultSpec.Names[1]
	        !!appdesmain.pipespec.val = !defaultSpec.Names[1]
  			else
          !!cdpipe.pspe.val = |unset|
          !!cdbran.pspe.val = |unset|
          !!appdesmain.pipespec.val = |unset|
        endif
      endif
    endif
  endif
endmethod
-- End of method definition for .appLoaded()

------------------------------------------------------------------------
--
-- Method:      .loaded()
--
-- Description: checks if application with name given by appName has been loaded
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--   BOOLEAN
--
------------------------------------------------------------------------
define method .loaded(!appName is STRING) is BOOLEAN
  !pos = !this.getApplicIndex(!appName.upcase())
  if (!pos gt 0) then
    return !this.apps[!pos].loaded
  else
    return false
  endif
endmethod
-- End of method definition for .loaded(STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      .initialiseForm()
--
-- Description: runs form initialisation for given application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialiseForm(!appName is STRING)
  !app = !this.getApplic(!appName)
  !app.initialiseForm()
endmethod
-- End of method definition for .initialiseForm(STRING)

------------------------------------------------------------------------
--
-- Method:      .currentApp()
--
-- Description: get current application
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   STRING
--
------------------------------------------------------------------------
define method .currentApp() is STRING
  return !this.currentApp
endmethod
-- End of method definition for .currentApp() STRING

------------------------------------------------------------------------
--
-- Method:      .currentAppObj()
--
-- Description: return APPDEFN object for current application
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   APPDEFN
--
------------------------------------------------------------------------
define method .currentAppObj() is APPDEFN
  return !this.getApplic(!this.currentApp)
endmethod
-- End of method definition for .currentAppObj() APPDEFN

------------------------------------------------------------------------
--
-- Method:      .loadingApp()
--
-- Description: set the name of the currently loading application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadingApp(!appName is STRING)
  !this.loadingApp = !appName
endmethod
-- End of method definition for .loadingApp(STRING)

------------------------------------------------------------------------
--
-- Method:      .loadingApp()
--
-- Description: get the name of the currently loading application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadingApp()
  return !this.loadingApp
endmethod
-- End of method definition for .loadingApp()

------------------------------------------------------------------------
--
-- Method:      .saveApplicationState()
--
-- Description: save application state to file on exit
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveApplicationState()

  !file = object FILE('%PDMSUSER%\' & !this.appKey.lowcase() & '-' & !this.project.lowcase() & '-appcntrl.pmldat')
  !out = ARRAY()
  !out.append('currentApp: ' & !this.currentApp)
  --P-12263
  if !this.module eq ('des') then
    if !this.currentApp.eq('PIPE') then
      !this.currentSpec = !!appdesmain.pipespec.val
      !out.append('currentSpec: ' & !this.currentSpec)
    endif
    if (!this.currentSpec.neq('') and !this.currentSpec.set()) then
      !out.append('currentSpec: ' & !this.currentSpec)
    endif
  endif

  !file.writeFile('OVERWRITE', !out)

  !!appFormCntrl.saveFormState()
  if(!this.module.upcase().neq('MONITOR') and !this.module.upcase().part(1).neq('ADMIN')) then
    !!appTbarCntrl.saveToolbarState()
  endif
endmethod
-- End of method definition for .saveApplicationState()

------------------------------------------------------------------------
--
-- Method:      .loadApplicationState()
--
-- Description: load application state from file
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--   STRING
--
------------------------------------------------------------------------
define method .loadApplicationState() is STRING
  -- set name of app to general initially
  !app = 'GEN'

  -- return blank if we're not reloading the previous application
  if (!this.options.reloadApp.not()) then
    return !app
  endif

  !file = object FILE('%PDMSUSER%\' & !this.appKey.lowcase() & '-' & !this.project.lowcase() & '-appcntrl.pmldat')
  -- return blank string if file does not exist
  if (!file.exists().not()) then
    return !app
  endif

  -- look through file for data we want
  !lines = !file.readFile()

  do !l values !lines
    !part1 = ''
    !part1 = !l.part(1, ':').trim().lowcase()
    if (!part1 eq 'currentapp') then
      !app = !l.part(2, ':').trim()
    endif
    if (!part1 eq 'currentspec') then
      !this.currentSpec = !l.part(2, ':').trim()
      break
    endif
  enddo

  return !app
endmethod
-- End of method definition for .loadApplicationState() STRING

------------------------------------------------------------------------
--
-- Method:      .executeModuleStartupCalls()
--
-- Description: runs all the calls specified for when the module starts up
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .executeModuleStartupCalls()
  do !app values !this.apps
    !calls = !app.moduleStartupCalls
    do !call values !calls
      $!call
    enddo
  enddo
endmethod
-- End of method definition for .executeModuleStartupCalls()

------------------------------------------------------------------------
--
-- Method:      .setMainForm()
--
-- Description: assigns the main form to the .mainForm member
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setMainForm()
  !this.mainForm = !!$!this.mainFormName
endmethod
-- End of method definition for .setMainForm()

------------------------------------------------------------------------
--
-- Method:      .synonyms()
--
-- Description: sets synonyms for applications
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      directory in PDMSUI containing files for module
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .synonyms(!moduleDir is STRING)
  do !app values !this.apps
    !synonym = !app.synonym
    !dir = !app.directory

    if (!synonym.set() and !synonym.empty().not() and !dir.set() and !dir.empty().not()) then
      $s $!synonym=$M "%PDMSUI%/$!moduleDir/$!dir/$S1"
      $u $!synonym
    endif
  enddo
endmethod
-- End of method definition for .synonyms()

------------------------------------------------------------------------
--
-- Method:      .synonyms()
--
-- Description: sets synonyms for applications
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .synonyms()
  !this.synonyms(!this.appKey)
endmethod
-- End of method definition for .synonyms()
